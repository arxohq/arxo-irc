// §59A residual (stage 2d): (b)(1)(B) credit offset and (b)(4), (c) modified taxable income,
// base erosion tax benefits and percentage, (d) base erosion payments, (e)(2)-(3) receipts,
// (g) related parties, (h) qualified derivative payments. Module 09 carries (a), (b)(1)
// rate and amount, (e)(1). Percentages are fractions (0.03 = 3 percent), as in module 09.

// --- §59A(b)(1)(B), (b)(2)(B), (b)(4): credits --------------------------------------------------------------------

use self::{
    IRC_S59A_B,
    IRC_S59A_C,
    IRC_S59A_D,
    IRC_S59A_E,
    IRC_S59A_G,
    IRC_S59A_H,
    regular_tax_liability_26b,
    taxpayer_year_begins_after_20251231,
};

pub relation credits_against_regular_tax_59ab1B(taxpayer: us.irc.core::Corporation, y: us.irc.core::TaxableYear, credits: Money, research_credit_portion: Money) kind empirical {
    label en official "the credits allowed under this chapter against the regular tax liability, and the part of the section 38 credit properly allocable to the research credit determined under section 41(a)";
}
pub relation applicable_section_38_credit_components_59ab4(taxpayer: us.irc.core::Corporation, y: us.irc.core::TaxableYear, low_income_housing: Money, renewable_electricity: Money, energy_investment_portion: Money) kind empirical {
    label en official "the section 38 credit properly allocable to the low-income housing credit (section 42(a)), the renewable electricity production credit (section 45(a)) and the investment credit (section 46) to the extent allocable to the energy credit (section 48)";
}
pub relation applicable_section_38_credits_59ab4(taxpayer: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "applicable section 38 credits: the sum of the three components (section 59A(b)(4))";
}
@source(IRC_S59A_B, relation = formalizes, coverage = exact, quote = "For purposes of paragraph (1)(B)(ii)(II), the term \"applicable section 38 credits\" means the credit allowed under section 38 for the taxable year which is properly allocable to—")
rule S59AB4ApplicableSection38Credits defeasible {
    for taxpayer: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for a: Money;
    for b: Money;
    for c: Money;
    when applicable_section_38_credit_components_59ab4(taxpayer, y, a, b, c);
    then applicable_section_38_credits_59ab4(taxpayer, y, a + b + c);
}
pub relation base_erosion_minimum_tax_amount_without_subclause_59ab1Bii_II(taxpayer: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the base erosion minimum tax amount determined without regard to section 59A(b)(1)(B)(ii)(II)";
}
pub relation credit_offset_computed_59ab1B(taxpayer: us.irc.core::Corporation, y: us.irc.core::TaxableYear, offset: Money) kind institutional {
    label en official "the section 59A(b)(1)(B) credit reduction for a taxable year beginning before 2026: the excess of the credits over the sum of the research credit and the applicable section 38 credits up to 80 percent of the lesser of those credits or the base erosion minimum tax amount; for later years the aggregate credits reduce the regular tax (section 59A(b)(2)(B)); not chained into `section_59a_b1b_credit_offset`";
}
@source(IRC_S59A_B, relation = formalizes, coverage = exact, quote = "(II) the portion of the applicable section 38 credits not in excess of 80 percent of the lesser of the amount of such credits or the base erosion minimum tax amount (determined without regard to this")
rule S59AB1BiiCreditOffsetPre2026 defeasible {
    for taxpayer: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for credits: Money;
    for research: Money;
    for applicable: Money;
    for bemta: Money;
    when credits_against_regular_tax_59ab1B(taxpayer, y, credits, research)
     and applicable_section_38_credits_59ab4(taxpayer, y, applicable)
     and base_erosion_minimum_tax_amount_without_subclause_59ab1Bii_II(taxpayer, y, bemta);
    unless taxpayer_year_begins_after_20251231(y)
     and credits_against_regular_tax_59ab1B(taxpayer, y, credits, research)
     and applicable_section_38_credits_59ab4(taxpayer, y, applicable)
     and base_erosion_minimum_tax_amount_without_subclause_59ab1Bii_II(taxpayer, y, bemta);
    then credit_offset_computed_59ab1B(taxpayer, y, max(credits - (research + min(applicable, round(min(applicable, bemta) * 0.80, 2, "HALF_UP"))), 0.00 USD));
}
@source(IRC_S59A_B, relation = formalizes, coverage = exact, quote = "(B) by reducing (but not below zero) the regular tax liability (as defined in section 26(b)) for purposes of subparagraph (B) thereof by the aggregate amount of the credits allowed under this chapter")
rule S59AB2BAggregateCreditsPost2025 defeasible {
    for taxpayer: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for credits: Money;
    for research: Money;
    for regular_tax: Money;
    when credits_against_regular_tax_59ab1B(taxpayer, y, credits, research)
     and regular_tax_liability_26b(taxpayer, y, regular_tax)
     and taxpayer_year_begins_after_20251231(y);
    then credit_offset_computed_59ab1B(taxpayer, y, min(credits, regular_tax));
}

// --- §59A(c): modified taxable income, base erosion tax benefits, percentage ---------------------------------------

pub relation modified_taxable_income_inputs_59ac1(taxpayer: us.irc.core::Corporation, y: us.irc.core::TaxableYear, taxable_income: Money, base_erosion_tax_benefits: Money, nol_deduction: Money, base_erosion_percentage: Decimal) kind empirical {
    label en official "the taxable income computed under this chapter, the base erosion tax benefits, the net operating loss deduction under section 172 and the base erosion percentage";
}
pub relation modified_taxable_income_computed_59ac1(taxpayer: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "taxable income determined without regard to any base erosion tax benefit or the base erosion percentage of any net operating loss deduction (section 59A(c)(1)); not chained into `modified_taxable_income`";
}
@source(IRC_S59A_C, relation = formalizes, coverage = exact, quote = "The term \"modified taxable income\" means the taxable income of the taxpayer computed under this chapter for the taxable year, determined without regard to—")
rule S59AC1ModifiedTaxableIncome defeasible {
    for taxpayer: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for ti: Money;
    for beptb: Money;
    for nol: Money;
    for pct: Decimal;
    when modified_taxable_income_inputs_59ac1(taxpayer, y, ti, beptb, nol, pct);
    then modified_taxable_income_computed_59ac1(taxpayer, y, ti + beptb + round(nol * pct, 2, "HALF_UP"));
}
pub relation base_erosion_benefit_item_59ac2A(taxpayer: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text, amount: Money, clause: Text) kind empirical {
    label en official "an item in respect of a base erosion payment: `i` (a deduction described in subsection (d)(1)), `ii` (depreciation or amortization on property acquired under (d)(2)), `iii_I` (reduction under section 803(a)(1)(B) for indemnity insurance premiums), `iii_II` (deduction under section 832(b)(4)(A) for reinsurance premiums) or `iv` (reduction of gross receipts under (d)(4))";
}
pub relation withheld_and_taxed_payment_59ac2Bi(item_id: Text) kind empirical {
    label en official "tax is imposed on the base erosion payment by section 871 or 881 and has been deducted and withheld under section 1441 or 1442";
}
pub relation base_erosion_tax_benefit_59ac2A(taxpayer: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text, amount: Money) kind institutional {
    label en official "a base erosion tax benefit (section 59A(c)(2)(A)), not taking into account a payment on which tax is imposed and withheld (clause (B)(i)); the reduction under rules similar to section 163(j)(5)(B) is not applied";
}
@source(IRC_S59A_C, relation = formalizes, coverage = exact, quote = "(i) any deduction described in subsection (d)(1) which is allowed under this chapter for the taxable year with respect to any base erosion payment,")
rule S59AC2AiDeductionBenefit defeasible {
    for taxpayer: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for amount: Money;
    when base_erosion_benefit_item_59ac2A(taxpayer, y, item_id, amount, "i");
    unless withheld_and_taxed_payment_59ac2Bi(item_id)
     and base_erosion_benefit_item_59ac2A(taxpayer, y, item_id, amount, "i");
    then base_erosion_tax_benefit_59ac2A(taxpayer, y, item_id, amount);
}
@source(IRC_S59A_C, relation = formalizes, coverage = exact, quote = "(ii) in the case of a base erosion payment described in subsection (d)(2), any deduction allowed under this chapter for the taxable year for depreciation (or amortization in lieu of depreciation)")
rule S59AC2AiiDepreciationBenefit defeasible {
    for taxpayer: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for amount: Money;
    when base_erosion_benefit_item_59ac2A(taxpayer, y, item_id, amount, "ii");
    unless withheld_and_taxed_payment_59ac2Bi(item_id)
     and base_erosion_benefit_item_59ac2A(taxpayer, y, item_id, amount, "ii");
    then base_erosion_tax_benefit_59ac2A(taxpayer, y, item_id, amount);
}
@source(IRC_S59A_C, relation = formalizes, coverage = exact, quote = "(I) any reduction under section 803(a)(1)(B) in the gross amount of premiums and other consideration on insurance and annuity contracts for premiums and other consideration arising out of indemnity")
rule S59AC2AiiiIIndemnityInsuranceBenefit defeasible {
    for taxpayer: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for amount: Money;
    when base_erosion_benefit_item_59ac2A(taxpayer, y, item_id, amount, "iii_I");
    unless withheld_and_taxed_payment_59ac2Bi(item_id)
     and base_erosion_benefit_item_59ac2A(taxpayer, y, item_id, amount, "iii_I");
    then base_erosion_tax_benefit_59ac2A(taxpayer, y, item_id, amount);
}
@source(IRC_S59A_C, relation = formalizes, coverage = exact, quote = "(II) any deduction under section 832(b)(4)(A) from the amount of gross premiums written on insurance contracts during the taxable year for premiums paid for reinsurance, and")
rule S59AC2AiiiIIReinsuranceBenefit defeasible {
    for taxpayer: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for amount: Money;
    when base_erosion_benefit_item_59ac2A(taxpayer, y, item_id, amount, "iii_II");
    unless withheld_and_taxed_payment_59ac2Bi(item_id)
     and base_erosion_benefit_item_59ac2A(taxpayer, y, item_id, amount, "iii_II");
    then base_erosion_tax_benefit_59ac2A(taxpayer, y, item_id, amount);
}
@source(IRC_S59A_C, relation = formalizes, coverage = exact, quote = "(iv) in the case of a base erosion payment described in subsection (d)(4), any reduction in gross receipts with respect to such payment in computing gross income of the taxpayer for the taxable year")
rule S59AC2AivGrossReceiptsReductionBenefit defeasible {
    for taxpayer: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for amount: Money;
    when base_erosion_benefit_item_59ac2A(taxpayer, y, item_id, amount, "iv");
    unless withheld_and_taxed_payment_59ac2Bi(item_id)
     and base_erosion_benefit_item_59ac2A(taxpayer, y, item_id, amount, "iv");
    then base_erosion_tax_benefit_59ac2A(taxpayer, y, item_id, amount);
}
pub relation interest_paid_and_section_163j_reduction_59ac3(taxpayer: us.irc.core::Corporation, y: us.irc.core::TaxableYear, interest_to_unrelated: Money, interest_to_related: Money, reduction_by_163j: Money) kind empirical {
    label en official "interest paid or accrued to persons who are not related parties and to related parties, and the reduction of interest deductions by section 163(j)";
}
pub relation related_party_interest_deduction_59ac3(taxpayer: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the section 163(j) reduction is allocated first to interest paid to unrelated persons and then to related parties (section 59A(c)(3))";
}
@source(IRC_S59A_C, relation = formalizes, coverage = exact, quote = "For purposes of applying paragraph (1), in the case of a taxpayer to which section 163(j) applies for the taxable year, the reduction in the amount of interest for which a deduction is allowed by")
rule S59AC3ReductionAllocatedFirstToUnrelated defeasible {
    for taxpayer: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for unrelated: Money;
    for related: Money;
    for reduction: Money;
    when interest_paid_and_section_163j_reduction_59ac3(taxpayer, y, unrelated, related, reduction);
    then related_party_interest_deduction_59ac3(taxpayer, y, max(related - max(reduction - unrelated, 0.00 USD), 0.00 USD));
}
pub relation base_erosion_percentage_inputs_59ac4(taxpayer: us.irc.core::Corporation, y: us.irc.core::TaxableYear, aggregate_base_erosion_tax_benefits: Money, allowable_deductions: Money, benefits_of_clauses_iii_and_iv: Money) kind empirical {
    label en official "the aggregate base erosion tax benefits, the deductions allowable (including those of paragraph (2)(A)(i)-(ii), not counting sections 172, 245A and 250 deductions, deductions for services excepted under (d)(5), and deductions for qualified derivative payments) and the benefits of clauses (iii) and (iv)";
}
pub relation base_erosion_percentage_computed_59ac4A(taxpayer: us.irc.core::Corporation, y: us.irc.core::TaxableYear, percentage: Decimal) kind institutional {
    label en official "the base erosion percentage: the aggregate base erosion tax benefits divided by the sum of the allowable deductions and the clause (iii) and (iv) benefits (section 59A(c)(4)(A)); not chained into `base_erosion_percentage`";
}
@source(IRC_S59A_C, relation = formalizes, coverage = exact, quote = "The term \"base erosion percentage\" means, for any taxable year, the percentage determined by dividing—")
rule S59AC4ABaseErosionPercentage defeasible {
    for taxpayer: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for beptb: Money;
    for deductions: Money;
    for benefits: Money;
    when base_erosion_percentage_inputs_59ac4(taxpayer, y, beptb, deductions, benefits)
     and deductions + benefits > 0.00 USD;
    then base_erosion_percentage_computed_59ac4A(taxpayer, y, beptb / (deductions + benefits));
}

// --- §59A(g): related parties -------------------------------------------------------------------------------------------

pub relation person_voting_power_and_value_percentages_59ag2(owner_id: Text, corp: us.irc.core::Corporation, voting_power: Decimal, value: Decimal) kind empirical {
    label en official "the percentages of the total voting power and of the total value of all classes of stock of the corporation owned by the person, with section 318 as modified by paragraph (3) taken as a case input";
}
pub relation twenty_five_percent_owner_59ag2(owner_id: Text, corp: us.irc.core::Corporation) kind institutional {
    label en official "a 25-percent owner: a person who owns at least 25 percent of the total voting power or of the total value of the corporation (section 59A(g)(2))";
}
@source(IRC_S59A_G, relation = formalizes, coverage = exact, quote = "(A) the total voting power of all classes of stock of a corporation entitled to vote, or")
rule S59AG2AVotingPower25Percent defeasible {
    for owner_id: Text;
    for corp: us.irc.core::Corporation;
    for voting: Decimal;
    for value: Decimal;
    when person_voting_power_and_value_percentages_59ag2(owner_id, corp, voting, value)
     and voting >= 25.0;
    then twenty_five_percent_owner_59ag2(owner_id, corp);
}
@source(IRC_S59A_G, relation = formalizes, coverage = exact, quote = "(B) the total value of all classes of stock of such corporation.")
rule S59AG2BValue25Percent defeasible {
    for owner_id: Text;
    for corp: us.irc.core::Corporation;
    for voting: Decimal;
    for value: Decimal;
    when person_voting_power_and_value_percentages_59ag2(owner_id, corp, voting, value)
     and value >= 25.0;
    then twenty_five_percent_owner_59ag2(owner_id, corp);
}
pub relation related_within_267b_or_707b1_to_taxpayer_or_owner_59ag1B(person_id: Text, taxpayer: us.irc.core::Corporation) kind empirical {
    label en official "the person is related (within the meaning of section 267(b) or 707(b)(1)) to the taxpayer or to any 25-percent owner of the taxpayer";
}
pub relation related_within_section_482_59ag1C(person_id: Text, taxpayer: us.irc.core::Corporation) kind empirical {
    label en official "the person is related (within the meaning of section 482) to the taxpayer";
}
pub relation related_party_59ag1(person_id: Text, taxpayer: us.irc.core::Corporation) kind institutional {
    label en official "a related party of the applicable taxpayer (section 59A(g)(1))";
}
@source(IRC_S59A_G, relation = formalizes, coverage = exact, quote = "(A) any 25-percent owner of the taxpayer,")
rule S59AG1ATwentyFiveOwner defeasible {
    for person_id: Text;
    for taxpayer: us.irc.core::Corporation;
    when twenty_five_percent_owner_59ag2(person_id, taxpayer);
    then related_party_59ag1(person_id, taxpayer);
}
@source(IRC_S59A_G, relation = formalizes, coverage = exact, quote = "(B) any person who is related (within the meaning of section 267(b) or 707(b)(1)) to the taxpayer or any 25-percent owner of the taxpayer, and")
rule S59AG1BRelatedToTaxpayerOrOwner defeasible {
    for person_id: Text;
    for taxpayer: us.irc.core::Corporation;
    when related_within_267b_or_707b1_to_taxpayer_or_owner_59ag1B(person_id, taxpayer);
    then related_party_59ag1(person_id, taxpayer);
}
@source(IRC_S59A_G, relation = formalizes, coverage = exact, quote = "(C) any other person who is related (within the meaning of section 482) to the taxpayer.")
rule S59AG1CRelatedUnderSection482 defeasible {
    for person_id: Text;
    for taxpayer: us.irc.core::Corporation;
    when related_within_section_482_59ag1C(person_id, taxpayer);
    then related_party_59ag1(person_id, taxpayer);
}

// --- §59A(h): qualified derivative payments ---------------------------------------------------------------------------

pub relation derivative_payment_59ah(taxpayer: us.irc.core::Corporation, y: us.irc.core::TaxableYear, payment_id: Text) kind empirical {
    label en official "a payment made by the taxpayer pursuant to a derivative";
}
pub relation derivative_marked_to_market_59ah2Ai(taxpayer: us.irc.core::Corporation, y: us.irc.core::TaxableYear, payment_id: Text) kind empirical {
    label en official "the taxpayer recognizes gain or loss as if the derivative were sold for its fair market value on the last business day of the taxable year (and at such additional times as required)";
}
pub relation derivative_gain_or_loss_ordinary_59ah2Aii(taxpayer: us.irc.core::Corporation, y: us.irc.core::TaxableYear, payment_id: Text) kind empirical {
    label en official "the taxpayer treats any gain or loss so recognized as ordinary";
}
pub relation derivative_items_ordinary_character_59ah2Aiii(taxpayer: us.irc.core::Corporation, y: us.irc.core::TaxableYear, payment_id: Text) kind empirical {
    label en official "the taxpayer treats the character of all items of income, deduction, gain or loss with respect to a payment pursuant to the derivative as ordinary";
}
pub relation derivative_reporting_included_59ah2B(taxpayer: us.irc.core::Corporation, y: us.irc.core::TaxableYear, payment_id: Text) kind empirical {
    label en official "the taxpayer includes in the information reported under section 6038B(b)(2) the information necessary to identify the payments to be so treated";
}
pub relation payment_would_be_base_erosion_payment_without_derivative_59ah3A(payment_id: Text) kind empirical {
    label en official "the payment would be treated as a base erosion payment if it were not made pursuant to a derivative, including any interest, royalty or service payment";
}
pub relation payment_allocable_to_nonderivative_component_59ah3B(payment_id: Text) kind empirical {
    label en official "in the case of a contract with derivative and nonderivative components, the payment is properly allocable to the nonderivative component";
}
pub relation qualified_derivative_payment_59ah2(taxpayer: us.irc.core::Corporation, y: us.irc.core::TaxableYear, payment_id: Text) kind institutional {
    label en official "a qualified derivative payment: marked to market, ordinary treatment of gain, loss and items, and the reporting requirement met (section 59A(h)(2)), except under paragraph (3)";
}
@source(IRC_S59A_H, relation = formalizes, coverage = exact, quote = "The term \"qualified derivative payment\" means any payment made by a taxpayer pursuant to a derivative with respect to which the taxpayer—")
rule S59AH2QualifiedDerivativePayment defeasible {
    for taxpayer: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for payment_id: Text;
    when derivative_payment_59ah(taxpayer, y, payment_id)
     and derivative_marked_to_market_59ah2Ai(taxpayer, y, payment_id)
     and derivative_gain_or_loss_ordinary_59ah2Aii(taxpayer, y, payment_id)
     and derivative_items_ordinary_character_59ah2Aiii(taxpayer, y, payment_id)
     and derivative_reporting_included_59ah2B(taxpayer, y, payment_id);
    unless payment_would_be_base_erosion_payment_without_derivative_59ah3A(payment_id)
     and derivative_payment_59ah(taxpayer, y, payment_id);
    unless payment_allocable_to_nonderivative_component_59ah3B(payment_id)
     and derivative_payment_59ah(taxpayer, y, payment_id);
    then qualified_derivative_payment_59ah2(taxpayer, y, payment_id);
}

// --- §59A(d): base erosion payments --------------------------------------------------------------------------------------

pub relation payment_or_accrual_to_foreign_related_party_59ad(taxpayer: us.irc.core::Corporation, y: us.irc.core::TaxableYear, payment_id: Text, amount: Money, kind: Text) kind empirical {
    label en official "an amount paid or accrued by the taxpayer to a foreign person which is a related party, of the kind: `deductible` (with respect to which a deduction is allowable), `depreciable_property` (in connection with the acquisition of property subject to depreciation or amortization), `reinsurance` (premiums taken into account under section 803(a)(1)(B) or 832(b)(4)(A)) or `gross_receipts_reduction` (a reduction of gross receipts with respect to a subparagraph (B) person)";
}
pub relation services_cost_method_no_markup_59ad5(payment_id: Text) kind empirical {
    label en official "the payment is for services meeting the requirements for the section 482 services cost method (without regard to the fundamental-risks requirement) and constitutes the total services cost with no markup";
}
pub relation base_erosion_payment_59ad(taxpayer: us.irc.core::Corporation, y: us.irc.core::TaxableYear, payment_id: Text, amount: Money) kind institutional {
    label en official "a base erosion payment (section 59A(d)), not treated as one if a qualified derivative payment (subsection (h)(1)) or, for paragraph (1), a services cost method payment (paragraph (5))";
}
@source(IRC_S59A_D, relation = formalizes, coverage = exact, quote = "The term \"base erosion payment\" means any amount paid or accrued by the taxpayer to a foreign person which is a related party of the taxpayer and with respect to which a deduction is allowable under")
rule S59AD1DeductiblePaymentToForeignRelatedParty defeasible {
    for taxpayer: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for payment_id: Text;
    for amount: Money;
    when payment_or_accrual_to_foreign_related_party_59ad(taxpayer, y, payment_id, amount, "deductible");
    unless services_cost_method_no_markup_59ad5(payment_id)
     and payment_or_accrual_to_foreign_related_party_59ad(taxpayer, y, payment_id, amount, "deductible");
    unless qualified_derivative_payment_59ah2(taxpayer, y, payment_id)
     and payment_or_accrual_to_foreign_related_party_59ad(taxpayer, y, payment_id, amount, "deductible");
    then base_erosion_payment_59ad(taxpayer, y, payment_id, amount);
}
@source(IRC_S59A_D, relation = formalizes, coverage = exact, quote = "Such term shall also include any amount paid or accrued by the taxpayer to a foreign person which is a related party of the taxpayer in connection with the acquisition by the taxpayer from such")
rule S59AD2DepreciablePropertyAcquisition defeasible {
    for taxpayer: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for payment_id: Text;
    for amount: Money;
    when payment_or_accrual_to_foreign_related_party_59ad(taxpayer, y, payment_id, amount, "depreciable_property");
    unless qualified_derivative_payment_59ah2(taxpayer, y, payment_id)
     and payment_or_accrual_to_foreign_related_party_59ad(taxpayer, y, payment_id, amount, "depreciable_property");
    then base_erosion_payment_59ad(taxpayer, y, payment_id, amount);
}
@source(IRC_S59A_D, relation = formalizes, coverage = exact, quote = "Such term shall also include any premium or other consideration paid or accrued by the taxpayer to a foreign person which is a related party of the taxpayer for any reinsurance payments which are")
rule S59AD3ReinsurancePayments defeasible {
    for taxpayer: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for payment_id: Text;
    for amount: Money;
    when payment_or_accrual_to_foreign_related_party_59ad(taxpayer, y, payment_id, amount, "reinsurance");
    unless qualified_derivative_payment_59ah2(taxpayer, y, payment_id)
     and payment_or_accrual_to_foreign_related_party_59ad(taxpayer, y, payment_id, amount, "reinsurance");
    then base_erosion_payment_59ad(taxpayer, y, payment_id, amount);
}
@source(IRC_S59A_D, relation = formalizes, coverage = exact, quote = "Such term shall also include any amount paid or accrued by the taxpayer with respect to a person described in subparagraph (B) which results in a reduction of the gross receipts of the taxpayer.")
rule S59AD4GrossReceiptsReduction defeasible {
    for taxpayer: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for payment_id: Text;
    for amount: Money;
    when payment_or_accrual_to_foreign_related_party_59ad(taxpayer, y, payment_id, amount, "gross_receipts_reduction");
    unless qualified_derivative_payment_59ah2(taxpayer, y, payment_id)
     and payment_or_accrual_to_foreign_related_party_59ad(taxpayer, y, payment_id, amount, "gross_receipts_reduction");
    then base_erosion_payment_59ad(taxpayer, y, payment_id, amount);
}
pub relation surrogate_foreign_corporation_first_became_on_59ad4Bi(person_id: Text, became_on: Date) kind empirical {
    label en official "the person is a surrogate foreign corporation (section 7874(a)(2)(B), not one treated as domestic under section 7874(b)) which is a related party of the taxpayer, and the date it first became a surrogate foreign corporation";
}
pub relation member_of_expanded_affiliated_group_59ad4Bii(person_id: Text) kind empirical {
    label en official "the foreign person is a member of the same expanded affiliated group (section 7874(c)(1)) as the surrogate foreign corporation";
}
pub relation person_described_59ad4B(person_id: Text) kind institutional {
    label en official "a person described in section 59A(d)(4)(B)";
}
@source(IRC_S59A_D, relation = formalizes, coverage = exact, quote = "(i) surrogate foreign corporation which is a related party of the taxpayer, but only if such person first became a surrogate foreign corporation after November 9, 2017, or")
rule S59AD4BiSurrogateAfterNovember92017 defeasible {
    for person_id: Text;
    for on: Date;
    when surrogate_foreign_corporation_first_became_on_59ad4Bi(person_id, on)
     and on > @2017-11-09;
    then person_described_59ad4B(person_id);
}
@source(IRC_S59A_D, relation = formalizes, coverage = exact, quote = "(ii) foreign person which is a member of the same expanded affiliated group as the surrogate foreign corporation.")
rule S59AD4BiiExpandedAffiliatedGroupMember defeasible {
    for person_id: Text;
    when member_of_expanded_affiliated_group_59ad4Bii(person_id);
    then person_described_59ad4B(person_id);
}

// --- §59A(e)(2)-(3): gross receipts ------------------------------------------------------------------------------------------------

pub relation foreign_person_gross_receipts_59ae2A(person_id: Text, total_receipts: Money, effectively_connected_receipts: Money) kind empirical {
    label en official "the gross receipts of a foreign person, and the part taken into account in determining income effectively connected with the conduct of a trade or business within the United States";
}
pub relation gross_receipts_counted_59ae2A(person_id: Text, amount: Money) kind institutional {
    label en official "for a foreign person only effectively connected gross receipts are taken into account (section 59A(e)(2)(A), first sentence); the aggregation exception for United States persons is not modeled";
}
@source(IRC_S59A_E, relation = formalizes, coverage = partial, quote = "In the case of a foreign person the gross receipts of which are taken into account for purposes of paragraph (1)(B), only gross receipts which are taken into account in determining income which is")
rule S59AE2AOnlyEffectivelyConnectedReceipts defeasible {
    for person_id: Text;
    for total: Money;
    for eci: Money;
    when foreign_person_gross_receipts_59ae2A(person_id, total, eci);
    then gross_receipts_counted_59ae2A(person_id, eci);
}
