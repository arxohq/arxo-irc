// §§995-997, 999 (stage 2d): taxation of DISC shareholders, distributions, and the
// international boycott provisions. Pro rata shares are Decimal fractions (0.25 = 25
// percent); percentages are percent numbers. DISC-level amounts are case inputs.

// --- §995(b)(1): deemed distributions -------------------------------------------------------------------------------------------------------

use self::{
    IRC_S995_B,
    IRC_S995_C,
    IRC_S995_D,
    IRC_S995_F,
    IRC_S995_G,
    IRC_S996_A,
    IRC_S996_B,
    IRC_S996_E,
    IRC_S996_F,
    IRC_S996_G,
    IRC_S997,
    IRC_S999_A,
    IRC_S999_B,
    IRC_S999_C,
    IRC_S999_E,
    IRC_S999_F,
};

pub relation disc_deemed_distribution_components_995b1(disc: us.irc.core::Corporation, y: us.irc.core::TaxableYear, producers_loan_interest: Money, nonqualifying_transferred_gain_B: Money, transferred_gain_C: Money, military_property_taxable_income: Money, taxable_income_on_receipts_over_10m: Money, illegal_payments: Money) kind empirical {
    label en official "the DISC-level amounts of subparagraphs (A) gross interest from producer's loans, (B) and (C) gain on previously transferred property, (D) the taxable income attributable to military property, (E) the taxable income attributable to qualified export receipts over $10,000,000, and (F)(iii) illegal bribes, kickbacks or other payments";
}
pub relation disc_taxable_income_and_earnings_995b1(disc: us.irc.core::Corporation, y: us.irc.core::TaxableYear, taxable_income_before_distributions: Money, earnings_and_profits_for_year: Money, accumulated_earnings_and_profits: Money) kind empirical {
    label en official "the taxable income of the DISC for the year before reduction for distributions, its earnings and profits for the year, and its accumulated earnings and profits";
}
pub relation shareholder_pro_rata_and_kind_995b1(shareholder: us.irc.core::Person, disc: us.irc.core::Corporation, pro_rata_share: Decimal, is_c_corporation: Boolean, boycott_factor: Decimal) kind empirical {
    label en official "the shareholder's pro rata share of the DISC, whether the shareholder is a C corporation, and the international boycott factor under section 999";
}
pub relation foreign_investment_attributable_to_producers_loans_995b1G(disc: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the amount of foreign investment attributable to producer's loans of the DISC for the year (subsection (d))";
}
pub relation deemed_distribution_before_f_995b1(disc: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the sum of the amounts of subparagraphs (A) to (E) (the base for subparagraph (F)); military property taxable income is taken at 50 percent (subparagraph (D))";
}
@source(IRC_S995_B, relation = formalizes, coverage = partial, quote = "A shareholder of a DISC shall be treated as having received a distribution taxable as a dividend with respect to his stock in an amount which is equal to his pro rata share of the sum (or, if")
rule S995B1AToEDiscLevelSum defeasible {
    for disc: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for a: Money;
    for b: Money;
    for c: Money;
    for d: Money;
    for e: Money;
    for f3: Money;
    when disc_deemed_distribution_components_995b1(disc, y, a, b, c, d, e, f3);
    then deemed_distribution_before_f_995b1(disc, y, a + b + c + round(d * 0.50, 2, "HALF_UP") + e);
}
pub relation deemed_distribution_f_i_995b1(shareholder: us.irc.core::Person, disc: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "for a C corporation shareholder, one-seventeenth of the excess of the taxable income of the DISC over the amounts deemed distributed under subparagraphs (A) to (E), as the shareholder's pro rata share (section 995(b)(1)(F)(i))";
}
@source(IRC_S995_B, relation = formalizes, coverage = exact, quote = "(i) in the case of a shareholder which is a C corporation, one-seventeenth of the excess of the taxable income of the DISC for the taxable year, before reduction for any distributions during the")
rule S995B1FiOneSeventeenth defeasible {
    for shareholder: us.irc.core::Person;
    for disc: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for share: Decimal;
    for boycott: Decimal;
    for ti: Money;
    for ep: Money;
    for accumulated: Money;
    for base: Money;
    when shareholder_pro_rata_and_kind_995b1(shareholder, disc, share, true, boycott)
     and disc_taxable_income_and_earnings_995b1(disc, y, ti, ep, accumulated)
     and deemed_distribution_before_f_995b1(disc, y, base)
     and ti > base;
    then deemed_distribution_f_i_995b1(shareholder, disc, y, round((ti - base) * (1.0 / 17.0) * share, 2, "HALF_UP"));
}
pub relation deemed_distribution_f_ii_995b1(shareholder: us.irc.core::Person, disc: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "16/17 of the excess referred to in clause (i) multiplied by the international boycott factor, as the shareholder's pro rata share (section 995(b)(1)(F)(ii))";
}
@source(IRC_S995_B, relation = formalizes, coverage = exact, quote = "(ii) an amount equal to 16/17 of the excess referred to in clause (i), multiplied by the international boycott factor determined under section 999, and")
rule S995B1FiiBoycottFactor defeasible {
    for shareholder: us.irc.core::Person;
    for disc: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for share: Decimal;
    for boycott: Decimal;
    for ti: Money;
    for ep: Money;
    for accumulated: Money;
    for base: Money;
    when shareholder_pro_rata_and_kind_995b1(shareholder, disc, share, true, boycott)
     and disc_taxable_income_and_earnings_995b1(disc, y, ti, ep, accumulated)
     and deemed_distribution_before_f_995b1(disc, y, base)
     and ti > base;
    then deemed_distribution_f_ii_995b1(shareholder, disc, y, round((ti - base) * (16.0 / 17.0) * boycott * share, 2, "HALF_UP"));
}
pub relation deemed_distribution_pool_995b1(shareholder: us.irc.core::Person, disc: us.irc.core::Corporation, y: us.irc.core::TaxableYear, pool: Money) kind institutional {
    label en official "the DISC-level sum of subparagraphs (A) to (E), the illegal payments of (F)(iii) and, for a C corporation shareholder, the amounts of (F)(i) and (ii) (before the shareholder's pro rata share and the earnings and profits limit)";
}
@source(IRC_S995_B, relation = formalizes, coverage = exact, quote = "(iii) any illegal bribe, kickback, or other payment (within the meaning of section 162(c)) paid by or on behalf of the DISC directly or indirectly to an official, employee, or agent in fact of a")
rule S995B1PoolCCorporationWithExcess defeasible {
    for shareholder: us.irc.core::Person;
    for disc: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for share: Decimal;
    for boycott: Decimal;
    for ti: Money;
    for ep: Money;
    for accumulated: Money;
    for base: Money;
    for a: Money;
    for b: Money;
    for c: Money;
    for d: Money;
    for e: Money;
    for f3: Money;
    when shareholder_pro_rata_and_kind_995b1(shareholder, disc, share, true, boycott)
     and disc_taxable_income_and_earnings_995b1(disc, y, ti, ep, accumulated)
     and deemed_distribution_before_f_995b1(disc, y, base)
     and disc_deemed_distribution_components_995b1(disc, y, a, b, c, d, e, f3)
     and ti > base;
    then deemed_distribution_pool_995b1(shareholder, disc, y, base + f3 + round((ti - base) * (1.0 / 17.0), 2, "HALF_UP") + round((ti - base) * (16.0 / 17.0) * boycott, 2, "HALF_UP"));
}
rule S995B1PoolWithoutFClauses defeasible {
    for shareholder: us.irc.core::Person;
    for disc: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for share: Decimal;
    for c_corp: Boolean;
    for boycott: Decimal;
    for ti: Money;
    for ep: Money;
    for accumulated: Money;
    for base: Money;
    for a: Money;
    for b: Money;
    for c: Money;
    for d: Money;
    for e: Money;
    for f3: Money;
    when shareholder_pro_rata_and_kind_995b1(shareholder, disc, share, c_corp, boycott)
     and disc_taxable_income_and_earnings_995b1(disc, y, ti, ep, accumulated)
     and deemed_distribution_before_f_995b1(disc, y, base)
     and disc_deemed_distribution_components_995b1(disc, y, a, b, c, d, e, f3)
     and c_corp == false;
    then deemed_distribution_pool_995b1(shareholder, disc, y, base + f3);
}
rule S995B1PoolCCorporationNoExcess defeasible {
    for shareholder: us.irc.core::Person;
    for disc: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for share: Decimal;
    for boycott: Decimal;
    for ti: Money;
    for ep: Money;
    for accumulated: Money;
    for base: Money;
    for a: Money;
    for b: Money;
    for c: Money;
    for d: Money;
    for e: Money;
    for f3: Money;
    when shareholder_pro_rata_and_kind_995b1(shareholder, disc, share, true, boycott)
     and disc_taxable_income_and_earnings_995b1(disc, y, ti, ep, accumulated)
     and deemed_distribution_before_f_995b1(disc, y, base)
     and disc_deemed_distribution_components_995b1(disc, y, a, b, c, d, e, f3)
     and ti <= base;
    then deemed_distribution_pool_995b1(shareholder, disc, y, base + f3);
}
pub relation shareholder_deemed_dividend_995b1(shareholder: us.irc.core::Person, disc: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the distribution taxable as a dividend the shareholder is treated as having received: the pro rata share of the sum of subparagraphs (A) to (F) or, if smaller, the earnings and profits for the year, plus the share of subparagraph (G) limited by accumulated earnings and profits (section 995(b)(1)); the year's earnings and profits are not shared between the two limits";
}
@source(IRC_S995_B, relation = formalizes, coverage = partial, quote = "A shareholder of a DISC shall be treated as having received a distribution taxable as a dividend with respect to his stock in an amount which is equal to his pro rata share of the sum (or, if")
rule S995B1ShareholderDeemedDividend defeasible {
    for shareholder: us.irc.core::Person;
    for disc: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for share: Decimal;
    for c_corp: Boolean;
    for boycott: Decimal;
    for ti: Money;
    for ep: Money;
    for accumulated: Money;
    for pool: Money;
    for g: Money;
    when shareholder_pro_rata_and_kind_995b1(shareholder, disc, share, c_corp, boycott)
     and disc_taxable_income_and_earnings_995b1(disc, y, ti, ep, accumulated)
     and deemed_distribution_pool_995b1(shareholder, disc, y, pool)
     and foreign_investment_attributable_to_producers_loans_995b1G(disc, y, g);
    then shareholder_deemed_dividend_995b1(shareholder, disc, y, round(min(pool, ep) * share, 2, "HALF_UP") + round(min(g, ep + accumulated) * share, 2, "HALF_UP"));
}
pub relation revoked_or_disqualified_disc_income_995b2(shareholder: us.irc.core::Person, disc: us.irc.core::Corporation, accumulated_disc_income_share: Money, preceding_consecutive_disc_years: Integer) kind empirical {
    label en official "a shareholder of a corporation which revoked its DISC election or failed the conditions of section 992(a)(1): the shareholder's pro rata share of DISC income accumulated during the immediately preceding consecutive years for which the corporation was a DISC, and the number of those years";
}
pub relation deemed_distribution_installment_995b2B(shareholder: us.irc.core::Person, disc: us.irc.core::Corporation, installment: Money, installments: Integer) kind institutional {
    label en official "the deemed distribution is received in equal installments on the last day of each of the 10 following taxable years, but over no more than twice the number of preceding consecutive DISC years (section 995(b)(2)(B))";
}
@source(IRC_S995_B, relation = formalizes, coverage = exact, quote = "(B) Distributions described in subparagraph (A) shall be deemed to be received in equal installments on the last day of each of the 10 taxable years of the corporation following the year of the")
rule S995B2BInstallments defeasible {
    for shareholder: us.irc.core::Person;
    for disc: us.irc.core::Corporation;
    for share: Money;
    for years: Integer;
    when revoked_or_disqualified_disc_income_995b2(shareholder, disc, share, years)
     and years > 0;
    then deemed_distribution_installment_995b2B(shareholder, disc, round(share * (1.00 USD / (1.00 USD * min(10, years * 2))), 2, "HALF_UP"), min(10, years * 2));
}
pub relation military_property_income_and_deductions_995b3(disc: us.irc.core::Corporation, y: us.irc.core::TaxableYear, gross_income: Money, deductions: Money) kind empirical {
    label en official "the gross income of the DISC for the year attributable to military property (an arm, ammunition or implement of war on the munitions list) and the deductions properly apportioned or allocated to it";
}
pub relation taxable_income_attributable_to_military_property_995b3(disc: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "taxable income attributable to military property, taking into account only the related gross income and deductions (section 995(b)(3)(A))";
}
@source(IRC_S995_B, relation = formalizes, coverage = exact, quote = "For purposes of paragraph (1)(D), taxable income of a DISC for the taxable year attributable to military property shall be determined by only taking into account—")
rule S995B3ATaxableIncomeOnMilitaryProperty defeasible {
    for disc: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for gross: Money;
    for deductions: Money;
    when military_property_income_and_deductions_995b3(disc, y, gross, deductions);
    then taxable_income_attributable_to_military_property_995b3(disc, y, gross - deductions);
}

// --- §995(c), (d), (f), (g) ---------------------------------------------------------------------------------------------------------------------

pub relation gain_on_disposition_of_disc_stock_995c(shareholder: us.irc.core::Person, disc: us.irc.core::Corporation, gain: Money, accumulated_disc_income_attributable_to_stock_held: Money) kind empirical {
    label en official "the gain recognized on a disposition of stock of a DISC or former DISC, and the accumulated DISC income attributable to the stock disposed of and accumulated during the periods it was held by the shareholder";
}
pub relation gain_included_as_dividend_995c2(shareholder: us.irc.core::Person, disc: us.irc.core::Corporation, amount: Money) kind institutional {
    label en official "the gain is included in gross income as a dividend to the extent of the accumulated DISC income attributable to the stock disposed of (section 995(c)(2))";
}
@source(IRC_S995_C, relation = formalizes, coverage = exact, quote = "The amounts described in paragraph (1) shall be included in gross income as a dividend to the extent of the accumulated DISC income of the DISC or former DISC which is attributable to the stock")
rule S995C2GainAsDividendToExtentOfAccumulatedDiscIncome defeasible {
    for shareholder: us.irc.core::Person;
    for disc: us.irc.core::Corporation;
    for gain: Money;
    for adi: Money;
    when gain_on_disposition_of_disc_stock_995c(shareholder, disc, gain, adi);
    then gain_included_as_dividend_995c2(shareholder, disc, min(gain, adi));
}
pub relation foreign_investment_inputs_995d1(disc: us.irc.core::Corporation, y: us.irc.core::TaxableYear, net_increase_in_foreign_assets: Money, actual_foreign_investment: Money, outstanding_producers_loans_to_group: Money) kind empirical {
    label en official "the net increase in foreign assets by members of the controlled group, the actual foreign investment by domestic members, and the outstanding producer's loans by the DISC to members of the group";
}
pub relation foreign_investment_attributable_to_producers_loans_995d1(disc: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the smallest of the net increase in foreign assets, the actual foreign investment and the outstanding producer's loans to the group (section 995(d)(1)); not chained into the (G) input";
}
@source(IRC_S995_D, relation = formalizes, coverage = exact, quote = "The amount of foreign investment attributable to producer's loans of a DISC for a taxable year shall be the smallest of—")
rule S995D1SmallestOfThree defeasible {
    for disc: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for increase: Money;
    for actual: Money;
    for loans: Money;
    when foreign_investment_inputs_995d1(disc, y, increase, actual, loans);
    then foreign_investment_attributable_to_producers_loans_995d1(disc, y, min(min(increase, actual), loans));
}
pub relation net_increase_in_foreign_assets_inputs_995d2(group_id: Text, y: us.irc.core::TaxableYear, acquisitions: Money, depreciation: Money, stock_and_debt_issued_to_others: Money, half_earnings_and_profits: Money, half_royalties_and_fees: Money, uncommitted_transitional_funds: Money) kind empirical {
    label en official "the amount incurred by the group to acquire foreign assets, and the reductions: depreciation, outstanding stock or debt issued to persons outside the group after 1971, one-half the earnings and profits of foreign members, one-half the royalties and fees paid to domestic members, and the uncommitted transitional funds";
}
pub relation net_increase_in_foreign_assets_995d2(group_id: Text, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the excess of the amount incurred to acquire foreign assets over the sum of the reductions (section 995(d)(2))";
}
@source(IRC_S995_D, relation = formalizes, coverage = exact, quote = "The term \"net increase in foreign assets\" of a controlled group means the excess of—")
rule S995D2NetIncreaseInForeignAssets defeasible {
    for group_id: Text;
    for y: us.irc.core::TaxableYear;
    for acquisitions: Money;
    for dep: Money;
    for stock: Money;
    for ep: Money;
    for roy: Money;
    for funds: Money;
    when net_increase_in_foreign_assets_inputs_995d2(group_id, y, acquisitions, dep, stock, ep, roy, funds)
     and acquisitions > dep + stock + ep + roy + funds;
    then net_increase_in_foreign_assets_995d2(group_id, y, acquisitions - (dep + stock + ep + roy + funds));
}
pub relation actual_foreign_investment_inputs_995d3(group_id: Text, contributions: Money, stock_and_debt_of_foreign_members: Money, transfers_to_foreign_branches: Money, half_earnings_and_profits: Money) kind empirical {
    label en official "contributions to capital of foreign members, stock or debt of foreign members issued to domestic members, amounts transferred to foreign branches, and one-half the earnings and profits of foreign members and foreign branches (each after 1971)";
}
pub relation actual_foreign_investment_995d3(group_id: Text, amount: Money) kind institutional {
    label en official "the sum of the four amounts (section 995(d)(3))";
}
@source(IRC_S995_D, relation = formalizes, coverage = exact, quote = "The term \"actual foreign investment\" by domestic members of a controlled group means the sum of—")
rule S995D3ActualForeignInvestment defeasible {
    for group_id: Text;
    for a: Money;
    for b: Money;
    for c: Money;
    for d: Money;
    when actual_foreign_investment_inputs_995d3(group_id, a, b, c, d);
    then actual_foreign_investment_995d3(group_id, a + b + c + d);
}
pub relation interest_charge_inputs_995f(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, tax_with_deferred_disc_income_as_ordinary: Money, actual_tax_liability: Money, base_period_t_bill_rate: Decimal) kind empirical {
    label en official "the shareholder's tax liability if the deferred DISC income were included as ordinary income, the actual tax liability (after credits other than sections 31, 32 and 34), and the base period T-bill rate";
}
pub relation disc_related_deferred_tax_liability_995f2a(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the excess of the tax liability with the deferred DISC income included as ordinary income over the actual tax liability (section 995(f)(2)(A))";
}
@source(IRC_S995_F, relation = formalizes, coverage = exact, quote = "The term \"shareholder's DISC-related deferred tax liability\" means, with respect to any taxable year of a shareholder of a DISC, the excess of—")
rule S995F2ADeferredTaxLiability defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for with: Money;
    for actual: Money;
    for rate: Decimal;
    when interest_charge_inputs_995f(shareholder, y, with, actual, rate)
     and with > actual;
    then disc_related_deferred_tax_liability_995f2a(shareholder, y, with - actual);
}
pub relation interest_charge_995f1(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, interest: Money) kind institutional {
    label en official "the interest a shareholder of a DISC pays for the year: the DISC-related deferred tax liability multiplied by the base period T-bill rate (section 995(f)(1))";
}
@source(IRC_S995_F, relation = formalizes, coverage = exact, quote = "A shareholder of a DISC shall pay for each taxable year interest in an amount equal to the product of—")
rule S995F1InterestCharge defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for with: Money;
    for actual: Money;
    for rate: Decimal;
    for liability: Money;
    when interest_charge_inputs_995f(shareholder, y, with, actual, rate)
     and disc_related_deferred_tax_liability_995f2a(shareholder, y, liability);
    then interest_charge_995f1(shareholder, y, round(liability * rate, 2, "HALF_UP"));
}
pub relation deferred_disc_income_inputs_995f3(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, share_of_accumulated_disc_income_after_1984: Money, actual_distributions_out_of_accumulated_disc_income: Money, share_of_disc_income_for_following_year: Money) kind empirical {
    label en official "the shareholder's pro rata share of accumulated DISC income (for periods after 1984) at the close of the computation year, the actual distributions out of accumulated DISC income for the DISC's following year, and the shareholder's share of the DISC income for that following year";
}
pub relation distributions_in_excess_of_income_995f3C(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the excess (if any) of the actual distributions out of accumulated DISC income over the shareholder's share of the DISC income for the year (section 995(f)(3)(C))";
}
@source(IRC_S995_F, relation = formalizes, coverage = exact, quote = "For purposes of subparagraph (A), the term \"distributions-in-excess-of-income\" means, with respect to any taxable year of a DISC, the excess (if any) of—")
rule S995F3CDistributionsInExcessOfIncome defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for adi: Money;
    for dist: Money;
    for income: Money;
    when deferred_disc_income_inputs_995f3(shareholder, y, adi, dist, income)
     and dist > income;
    then distributions_in_excess_of_income_995f3C(shareholder, y, dist - income);
}
pub relation deferred_disc_income_995f3A(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "deferred DISC income: the excess of the share of accumulated DISC income over the distributions-in-excess-of-income for the following year (section 995(f)(3)(A))";
}
@source(IRC_S995_F, relation = formalizes, coverage = exact, quote = "The term \"deferred DISC income\" means, with respect to any taxable year of a shareholder, the excess of—")
rule S995F3ADeferredDiscIncome defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for adi: Money;
    for dist: Money;
    for income: Money;
    for excess: Money;
    when deferred_disc_income_inputs_995f3(shareholder, y, adi, dist, income)
     and distributions_in_excess_of_income_995f3C(shareholder, y, excess)
     and adi > excess;
    then deferred_disc_income_995f3A(shareholder, y, adi - excess);
}
rule S995F3ADeferredDiscIncomeNoExcess defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for adi: Money;
    for dist: Money;
    for income: Money;
    when deferred_disc_income_inputs_995f3(shareholder, y, adi, dist, income)
     and dist <= income;
    then deferred_disc_income_995f3A(shareholder, y, adi);
}
pub relation exempt_organization_disc_shareholder_995g(shareholder: us.irc.core::Person) kind empirical {
    label en official "an organization described in section 511(a)(2) or (b)(2) (or any other person otherwise subject to tax under section 511) is a shareholder in a DISC";
}
pub relation disc_amount_995g(shareholder: us.irc.core::Person, amount_id: Text) kind empirical {
    label en official "an amount deemed distributed under subsection (b), an actual distribution treated under section 996 as out of accumulated DISC income, or a gain treated as a dividend under subsection (c)";
}
pub relation treated_as_unrelated_trade_or_business_income_995g(shareholder: us.irc.core::Person, amount_id: Text) kind institutional {
    label en official "the amount is treated as derived from the conduct of an unrelated trade or business (section 995(g))";
}
@source(IRC_S995_G, relation = formalizes, coverage = exact, quote = "If any organization described in subsection (a)(2) or (b)(2) of section 511 (or any other person otherwise subject to tax under section 511) is a shareholder in a DISC—")
rule S995GUnrelatedBusinessIncome defeasible {
    for shareholder: us.irc.core::Person;
    for amount_id: Text;
    when exempt_organization_disc_shareholder_995g(shareholder)
     and disc_amount_995g(shareholder, amount_id);
    then treated_as_unrelated_trade_or_business_income_995g(shareholder, amount_id);
}

// --- §996 --------------------------------------------------------------------------------------------------------------------------------------------

pub relation actual_distribution_and_income_pools_996a(shareholder: us.irc.core::Person, disc: us.irc.core::Corporation, y: us.irc.core::TaxableYear, distribution: Money, previously_taxed_income: Money, accumulated_disc_income: Money, other_earnings_and_profits: Money, qualification_or_g_distribution: Boolean) kind empirical {
    label en official "an actual distribution made out of earnings and profits, the previously taxed income, accumulated DISC income and other earnings and profits available, and whether it is a qualification distribution under section 992(c) or a deemed distribution under section 995(b)(1)(G)";
}
pub relation distribution_source_996a(shareholder: us.irc.core::Person, disc: us.irc.core::Corporation, y: us.irc.core::TaxableYear, from_previously_taxed_income: Money, from_accumulated_disc_income: Money, from_other_earnings_and_profits: Money) kind institutional {
    label en official "how the distribution is treated as made: first out of previously taxed income, second out of accumulated DISC income, finally out of other earnings and profits (section 996(a)(1)); a section 992(c) or 995(b)(1)(G) distribution is made first out of accumulated DISC income, then other earnings and profits, finally previously taxed income (section 996(a)(2)); the 16/17 and 1/17 split for C corporations is not modeled";
}
@source(IRC_S996_A, relation = formalizes, coverage = exact, quote = "Any actual distribution (other than a distribution described in paragraph (2) or to which section 995(c) applies) to a shareholder by a DISC (or former DISC) which is made out of earnings and profits")
rule S996A1OrdinaryDistributionOrdering defeasible {
    for shareholder: us.irc.core::Person;
    for disc: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for dist: Money;
    for pti: Money;
    for adi: Money;
    for other: Money;
    when actual_distribution_and_income_pools_996a(shareholder, disc, y, dist, pti, adi, other, false);
    then distribution_source_996a(shareholder, disc, y, min(dist, pti), min(dist - min(dist, pti), adi), min(dist - min(dist, pti) - min(dist - min(dist, pti), adi), other));
}
@source(IRC_S996_A, relation = formalizes, coverage = exact, quote = "Any actual distribution made pursuant to section 992(c) (relating to distributions to meet qualification requirements), and any deemed distribution pursuant to section 995(b)(1)(G) (relating to")
rule S996A2QualificationDistributionOrdering defeasible {
    for shareholder: us.irc.core::Person;
    for disc: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for dist: Money;
    for pti: Money;
    for adi: Money;
    for other: Money;
    when actual_distribution_and_income_pools_996a(shareholder, disc, y, dist, pti, adi, other, true);
    then distribution_source_996a(shareholder, disc, y, min(dist - min(dist, adi) - min(dist - min(dist, adi), other), pti), min(dist, adi), min(dist - min(dist, adi), other));
}
pub relation pti_distribution_excluded_996a3(shareholder: us.irc.core::Person, disc: us.irc.core::Corporation, y: us.irc.core::TaxableYear, excluded: Money) kind institutional {
    label en official "amounts distributed out of previously taxed income are excluded by the distributee from gross income and reduce the previously taxed income (section 996(a)(3)); gains described in section 995(e)(2) are not modeled";
}
@source(IRC_S996_A, relation = formalizes, coverage = partial, quote = "Amounts distributed out of previously taxed income shall be excluded by the distributee from gross income except for gains described in subsection (e)(2), and shall reduce the amount of the")
rule S996A3PtiDistributionExcluded defeasible {
    for shareholder: us.irc.core::Person;
    for disc: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for pti: Money;
    for adi: Money;
    for other: Money;
    for dist: Money;
    for other_flag: Boolean;
    when distribution_source_996a(shareholder, disc, y, pti, adi, other)
     and pti > 0.00 USD;
    then pti_distribution_excluded_996a3(shareholder, disc, y, pti);
}
pub relation disc_deficit_and_pools_996b(disc: us.irc.core::Corporation, y: us.irc.core::TaxableYear, deficit: Money, other_earnings_and_profits: Money, accumulated_disc_income: Money, previously_taxed_income: Money, adi_deemed_distributed_by_revocation: Money) kind empirical {
    label en official "a deficit in earnings and profits of the DISC for the year, the pools available, and the accumulated DISC income already deemed distributed because of a revocation or disqualification";
}
pub relation deficit_chargeable_996b(disc: us.irc.core::Corporation, y: us.irc.core::TaxableYear, to_other_earnings_and_profits: Money, to_accumulated_disc_income: Money, to_previously_taxed_income: Money) kind institutional {
    label en official "the deficit is charged first to other earnings and profits, second to accumulated DISC income, finally to previously taxed income, but never against accumulated DISC income deemed distributed on revocation or disqualification (section 996(b))";
}
@source(IRC_S996_B, relation = formalizes, coverage = exact, quote = "If for any taxable year a DISC, or a former DISC, incurs a deficit in earnings and profits, such deficit shall be chargeable—")
rule S996BDeficitChargeOrder defeasible {
    for disc: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for deficit: Money;
    for other: Money;
    for adi: Money;
    for pti: Money;
    for deemed: Money;
    when disc_deficit_and_pools_996b(disc, y, deficit, other, adi, pti, deemed);
    then deficit_chargeable_996b(disc, y, min(deficit, other), min(deficit - min(deficit, other), max(adi - deemed, 0.00 USD)), min(deficit - min(deficit, other) - min(deficit - min(deficit, other), max(adi - deemed, 0.00 USD)), pti));
}
pub relation stock_basis_and_distributions_996e(shareholder: us.irc.core::Person, disc: us.irc.core::Corporation, adjusted_basis: Money, deemed_distributions_995b: Money, pti_distribution: Money) kind empirical {
    label en official "the shareholder's adjusted basis in the DISC stock, the deemed distributions under section 995(b) for the year, and the portion of an actual distribution made out of previously taxed income";
}
pub relation basis_after_deemed_distributions_996e1(shareholder: us.irc.core::Person, disc: us.irc.core::Corporation, basis: Money) kind institutional {
    label en official "deemed distributions under section 995(b) increase the basis of the stock (section 996(e)(1))";
}
@source(IRC_S996_E, relation = formalizes, coverage = exact, quote = "Amounts representing deemed distributions as provided in section 995(b) shall increase the basis of the stock with respect to which the distribution is made.")
rule S996E1DeemedDistributionsIncreaseBasis defeasible {
    for shareholder: us.irc.core::Person;
    for disc: us.irc.core::Corporation;
    for basis: Money;
    for deemed: Money;
    for pti: Money;
    when stock_basis_and_distributions_996e(shareholder, disc, basis, deemed, pti);
    then basis_after_deemed_distributions_996e1(shareholder, disc, basis + deemed);
}
pub relation basis_after_pti_distribution_996e2(shareholder: us.irc.core::Person, disc: us.irc.core::Corporation, basis: Money, gain: Money) kind institutional {
    label en official "the portion of an actual distribution out of previously taxed income reduces the basis, and the excess over the adjusted basis is treated as gain from the sale or exchange of property (section 996(e)(2))";
}
@source(IRC_S996_E, relation = formalizes, coverage = partial, quote = "The portion of an actual distribution made out of previously taxed income shall reduce the basis of the stock with respect to which it is made, and to the extent that it exceeds the adjusted basis of")
rule S996E2PtiDistributionReducesBasis defeasible {
    for shareholder: us.irc.core::Person;
    for disc: us.irc.core::Corporation;
    for basis: Money;
    for deemed: Money;
    for pti: Money;
    when stock_basis_and_distributions_996e(shareholder, disc, basis, deemed, pti);
    then basis_after_pti_distribution_996e2(shareholder, disc, max(basis - pti, 0.00 USD), max(pti - basis, 0.00 USD));
}
pub relation disc_earnings_and_deemed_distributions_996f(disc: us.irc.core::Corporation, y: us.irc.core::TaxableYear, earnings_and_profits_before_distributions: Money, deemed_distributions_995b1: Money) kind empirical {
    label en official "the earnings and profits derived while the corporation is a DISC before reduction for distributions (including section 951(a) amounts), and the amounts deemed distributed under section 995(b)(1)";
}
pub relation disc_income_996f1(disc: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "DISC income for the year: the earnings and profits before distributions reduced by the amounts deemed distributed under section 995(b)(1) (section 996(f)(1))";
}
@source(IRC_S996_F, relation = formalizes, coverage = partial, quote = "The earnings and profits derived by a corporation during a taxable year in which such corporation is a DISC, before reduction for any distributions during the year, but reduced by amounts deemed")
rule S996F1DiscIncome defeasible {
    for disc: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for ep: Money;
    for deemed: Money;
    when disc_earnings_and_deemed_distributions_996f(disc, y, ep, deemed);
    then disc_income_996f1(disc, y, ep - deemed);
}
pub relation previously_taxed_income_996f2(disc: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "earnings and profits deemed distributed under section 995(b) for the year constitute previously taxed income for the year (section 996(f)(2))";
}
@source(IRC_S996_F, relation = formalizes, coverage = exact, quote = "Earnings and profits deemed distributed under section 995(b) for a taxable year shall constitute previously taxed income for such year.")
rule S996F2PreviouslyTaxedIncome defeasible {
    for disc: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for ep: Money;
    for deemed: Money;
    when disc_earnings_and_deemed_distributions_996f(disc, y, ep, deemed);
    then previously_taxed_income_996f2(disc, y, deemed);
}
pub relation nonresident_shareholder_gains_and_distributions_996g(shareholder: us.irc.core::Person) kind empirical {
    label en official "the shareholder is a nonresident alien individual or a foreign corporation, trust or estate, with gains referred to in section 995(c) or distributions out of accumulated DISC income (including deemed distributions)";
}
pub relation treated_as_effectively_connected_us_source_996g(shareholder: us.irc.core::Person) kind institutional {
    label en official "the gains and distributions are treated as effectively connected with a trade or business conducted through a permanent establishment in the United States and derived from sources within the United States (section 996(g))";
}
@source(IRC_S996_G, relation = formalizes, coverage = exact, quote = "In the case of a shareholder who is a nonresident alien individual or a foreign corporation, trust, or estate, gains referred to in section 995(c) and all distributions out of accumulated DISC income")
rule S996GNonresidentShareholderEci defeasible {
    for shareholder: us.irc.core::Person;
    when nonresident_shareholder_gains_and_distributions_996g(shareholder);
    then treated_as_effectively_connected_us_source_996g(shareholder);
}

// --- §997 ---------------------------------------------------------------------------------------------------------------------------------------------

pub relation property_distribution_to_corporation_by_disc_997(recipient: us.irc.core::Corporation, amount: Money) kind empirical {
    label en official "a distribution in property to a corporation by a DISC or former DISC out of previously taxed income or accumulated DISC income, and its amount";
}
pub relation distribution_amount_and_basis_treated_as_to_individual_997(recipient: us.irc.core::Corporation, amount: Money, basis: Money) kind institutional {
    label en official "for subchapter C the distribution is treated in the same amount as if made to an individual, and the recipient's basis equals that amount (section 997)";
}
@source(IRC_S997, relation = formalizes, coverage = exact, quote = "(1) be treated as a distribution in the same amount as if such distribution of property were made to an individual, and")
rule S997PropertyDistributionAsToIndividual defeasible {
    for recipient: us.irc.core::Corporation;
    for amount: Money;
    when property_distribution_to_corporation_by_disc_997(recipient, amount);
    then distribution_amount_and_basis_treated_as_to_individual_997(recipient, amount, amount);
}

// --- §999: international boycott -------------------------------------------------------------------------------------------------------------------

pub relation person_has_operations_in_listed_or_boycott_country_999a1(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the person, or a member of its controlled group, has operations in or related to a country on the Secretary's list, or another country in which it knows or has reason to know participation in an international boycott is required as a condition of doing business";
}
pub relation boycott_operations_reported_999a(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the person reported the operations to the Secretary at the time and in the manner prescribed";
}
@source(IRC_S999_A, relation = formalizes, coverage = exact, quote = "that person or shareholder (within the meaning of section 951(b)) shall report such operations to the Secretary at such time and in such manner as the Secretary prescribes, except that in the case of")
rule S999A1DutyToReportOperations defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when person_has_operations_in_listed_or_boycott_country_999a1(p, y);
    then duty S999AReportOperationsDuty {
        bearer p;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition boycott_operations_reported_999a(p, y);
            window [-infinity, infinity];
        }
    };
}
pub relation agreement_kind_999b3(p: us.irc.core::Person, kind: Text) kind empirical {
    label en official "the person agrees, as a condition of doing business, to: `refrain_from_country` (refrain from doing business with or in a country which is the object of the boycott), `refrain_from_us_persons` (with any United States person engaged in trade in that country), `refrain_from_by_nationality` (with a company whose ownership or management is of a particular nationality, race or religion, or remove such directors), `refrain_from_employing` (individuals of a particular nationality, race or religion), or `refrain_from_shipping_on_carriers` (as a condition of a sale, not shipping or insuring the product on a carrier of a person who does not participate in the boycott)";
}
pub relation agreement_within_exception_999b4(p: us.irc.core::Person, kind: Text) kind empirical {
    label en official "the agreement is one to: `meet_sanctioned_requirements` (requirements imposed by a foreign country where United States law or an Executive Order sanctions the boycott), `comply_with_import_prohibition` or `comply_with_export_prohibition`";
}
pub relation participates_in_international_boycott_999b3(p: us.irc.core::Person) kind institutional {
    label en official "the person participates in or cooperates with an international boycott (section 999(b)(3))";
}
@source(IRC_S999_B, relation = formalizes, coverage = exact, quote = "(i) to refrain from doing business with or in a country which is the object of the boycott or with the government, companies, or nationals of that country;")
rule S999B3AiRefrainFromCountry defeasible {
    for p: us.irc.core::Person;
    when agreement_kind_999b3(p, "refrain_from_country");
    unless agreement_within_exception_999b4(p, _)
     and agreement_kind_999b3(p, "refrain_from_country");
    then participates_in_international_boycott_999b3(p);
}
@source(IRC_S999_B, relation = formalizes, coverage = exact, quote = "(ii) to refrain from doing business with any United States person engaged in trade in a country which is the object of the boycott or with the government, companies, or nationals of that country;")
rule S999B3AiiRefrainFromUsPersons defeasible {
    for p: us.irc.core::Person;
    when agreement_kind_999b3(p, "refrain_from_us_persons");
    unless agreement_within_exception_999b4(p, _)
     and agreement_kind_999b3(p, "refrain_from_us_persons");
    then participates_in_international_boycott_999b3(p);
}
@source(IRC_S999_B, relation = formalizes, coverage = exact, quote = "(iii) to refrain from doing business with any company whose ownership or management is made up, all or in part, of individuals of a particular nationality, race, or religion, or to remove (or refrain")
rule S999B3AiiiRefrainByNationality defeasible {
    for p: us.irc.core::Person;
    when agreement_kind_999b3(p, "refrain_from_by_nationality");
    unless agreement_within_exception_999b4(p, _)
     and agreement_kind_999b3(p, "refrain_from_by_nationality");
    then participates_in_international_boycott_999b3(p);
}
@source(IRC_S999_B, relation = formalizes, coverage = exact, quote = "(iv) to refrain from employing individuals of a particular nationality, race, or religion; or")
rule S999B3AivRefrainFromEmploying defeasible {
    for p: us.irc.core::Person;
    when agreement_kind_999b3(p, "refrain_from_employing");
    unless agreement_within_exception_999b4(p, _)
     and agreement_kind_999b3(p, "refrain_from_employing");
    then participates_in_international_boycott_999b3(p);
}
@source(IRC_S999_B, relation = formalizes, coverage = exact, quote = "(B) as a condition of the sale of a product to the government, a company, or a national of a country, to refrain from shipping or insuring that product on a carrier owned, leased, or operated by a")
rule S999B3BRefrainFromShippingOnCarriers defeasible {
    for p: us.irc.core::Person;
    when agreement_kind_999b3(p, "refrain_from_shipping_on_carriers");
    unless agreement_within_exception_999b4(p, _)
     and agreement_kind_999b3(p, "refrain_from_shipping_on_carriers");
    then participates_in_international_boycott_999b3(p);
}
pub relation boycott_and_worldwide_operations_999c1(p: us.irc.core::Person, y: us.irc.core::TaxableYear, boycott_operations: Money, worldwide_operations: Money) kind empirical {
    label en official "the measure of the person's (or controlled group's) operations in or related to the group of countries associated in carrying out an international boycott in or with which it participated or cooperated, and of its world-wide operations (operations in or related to countries other than the United States)";
}
pub relation international_boycott_factor_999c1(p: us.irc.core::Person, y: us.irc.core::TaxableYear, factor: Decimal) kind institutional {
    label en official "the international boycott factor: the fraction of boycott operations to world-wide operations (section 999(c)(1)); the regulatory measurement of the operations is a case input";
}
@source(IRC_S999_C, relation = formalizes, coverage = partial, quote = "For purposes of sections 908(a), 952(a)(3), and 995(b)(1)(F)(ii), the international boycott factor is a fraction, determined under regulations prescribed by the Secretary, the numerator of which")
rule S999C1BoycottFactorFraction defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for boycott: Money;
    for worldwide: Money;
    when boycott_and_worldwide_operations_999c1(p, y, boycott, worldwide)
     and worldwide > 0.00 USD;
    then international_boycott_factor_999c1(p, y, boycott / worldwide);
}
pub relation person_controls_corporation_999e(p: us.irc.core::Person, corp: us.irc.core::Corporation) kind empirical {
    label en official "the person controls (within the meaning of section 304(c)) the corporation";
}
pub relation corporation_participated_in_boycott_999e(corp: us.irc.core::Corporation) kind empirical {
    label en official "the corporation participated in or cooperated with an international boycott";
}
pub relation presumed_to_participate_via_controlled_corporation_999e1(p: us.irc.core::Person) kind institutional {
    label en official "participation by a controlled corporation is presumed to be participation by the person (section 999(e)(1))";
}
@source(IRC_S999_E, relation = formalizes, coverage = exact, quote = "(1) participation in or cooperation with an international boycott by such corporation shall be presumed to be such participation or cooperation by such person, and")
rule S999E1PresumedParticipationOfController defeasible {
    for p: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    when person_controls_corporation_999e(p, corp)
     and corporation_participated_in_boycott_999e(corp);
    then presumed_to_participate_via_controlled_corporation_999e1(p);
}
pub relation person_participated_in_boycott_999e(p: us.irc.core::Person) kind empirical {
    label en official "the person participated in or cooperated with an international boycott";
}
pub relation controlled_corporation_presumed_to_participate_999e2(corp: us.irc.core::Corporation) kind institutional {
    label en official "participation by the controlling person is presumed to be participation by the controlled corporation (section 999(e)(2))";
}
@source(IRC_S999_E, relation = formalizes, coverage = exact, quote = "(2) participation in or cooperation with such a boycott by such person shall be presumed to be such participation or cooperation by such corporation.")
rule S999E2PresumedParticipationOfControlledCorporation defeasible {
    for p: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    when person_controls_corporation_999e(p, corp)
     and person_participated_in_boycott_999e(p);
    then controlled_corporation_presumed_to_participate_999e2(corp);
}
pub relation willful_failure_to_report_999f(p: us.irc.core::Person) kind empirical {
    label en official "a person required to report under this section willfully fails to make the report";
}
pub relation maximum_criminal_fine_999f(p: us.irc.core::Person, amount: Money) kind institutional {
    label en official "the person shall be fined not more than $25,000, imprisoned for not more than one year, or both, in addition to other penalties (section 999(f)); the fine ceiling is modeled, the sentencing is a judicial act";
}
@source(IRC_S999_F, relation = formalizes, coverage = partial, quote = "Any person (within the meaning of section 6671(b)) required to report under this section who willfully fails to make such report shall, in addition to other penalties provided by law, be fined not")
rule S999FFineCeilingForWillfulFailure defeasible {
    for p: us.irc.core::Person;
    when willful_failure_to_report_999f(p);
    then maximum_criminal_fine_999f(p, 25000.00 USD);
}
