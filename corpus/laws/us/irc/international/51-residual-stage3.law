// Stage 3 (TECH_GAP reduction), module 51: residual groups: section 904(d)(2)-(4); 911(c)(3)-(4), (e)(1); 877(d)(3)-(4), (e)(3);
// 877A(b), (g), (h); 865(c), (d)(4), (i); 992(b), (e); 993(c)(2), (d)(4); 994(c); 995(b), (d); 996(a)(2); 964(d), (e); 985/986
// election continuity. Status implemented_unverified: not a legal review; scenarios in tests/residual-stage3.lawtest are written,
// NOT executed.
//
// Modeling notes.
//  * Several rows are markers of an ordering or a treatment ("applied before", "treated as"); the relation carries the treatment
//    tag for consumers, the arithmetic they act on is not derived here.
//  * Continuing elections ("applies to the year made and all subsequent years unless revoked with consent") use a carried-in case
//    fact of the earlier year: no cross-year ledger.

// --- §904(d)(2)-(4) --------------------------------------------------------------------------------------------------------------

use self::{
    ForeignTaxCreditBasket,
    IRC_S865_C,
    IRC_S865_D,
    IRC_S865_I,
    IRC_S877A_B,
    IRC_S877A_G,
    IRC_S877A_H,
    IRC_S877_D,
    IRC_S877_E,
    IRC_S904_D,
    IRC_S911_C,
    IRC_S911_E,
    IRC_S964_D,
    IRC_S964_E,
    IRC_S985_B,
    IRC_S986_A,
    IRC_S992_B,
    IRC_S992_E,
    IRC_S993_C,
    IRC_S993_D,
    IRC_S994_C,
    IRC_S995_D,
    IRC_S996_A,
    de_minimis_954b3_applies,
    election_effective_992b,
    property_excluded_kind_993c2,
};

pub relation income_of_controlled_foreign_corporation_904d2Biv(income_id: Text) kind empirical {
    label en official "the income is income of a controlled foreign corporation";
}
pub relation rules_of_864d6_apply_to_fphci_kind_904d2Biv(income_id: Text) kind institutional {
    label en official "in determining whether income is of a kind which would be foreign personal holding company income, the rules of section 864(d)(6) apply only to income of a controlled foreign corporation";
}
@source(IRC_S904_D, relation = formalizes, coverage = exact, quote = "In determining whether any income is of a kind which would be foreign personal holding company income, the")
rule S904D2BivSection864d6OnlyForCfcIncome defeasible {
    for income_id: Text;
    when income_of_controlled_foreign_corporation_904d2Biv(income_id);
    then rules_of_864d6_apply_to_fphci_kind_904d2Biv(income_id);
}
pub relation section_1293_inclusion_from_noncontrolled_10_percent_corporation_904d2Eii(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "an inclusion under section 1293 with respect to a foreign corporation that is a noncontrolled 10-percent owned foreign corporation with respect to the taxpayer";
}
pub relation section_1293_inclusion_treated_as_dividend_904d2Eii(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the section 1293 inclusion is treated as a dividend from the corporation (for the category rules)";
}
@source(IRC_S904_D, relation = formalizes, coverage = exact, quote = "If any foreign corporation is a noncontrolled 10-percent owned foreign corporation with respect to the")
rule S904D2EiiInclusionTreatedAsDividend defeasible {
    for p: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when section_1293_inclusion_from_noncontrolled_10_percent_corporation_904d2Eii(p, corp, y, amount);
    then section_1293_inclusion_treated_as_dividend_904d2Eii(p, corp, y, amount);
}
pub relation tax_on_non_income_amount_904d2Hi(p: us.irc.core::Person, tax_id: Text, y: us.irc.core::TaxableYear, tax: Money) kind empirical {
    label en official "tax imposed under the law of a foreign country or possession of the United States on an amount which does not constitute income under United States tax principles";
}
pub relation tax_on_non_income_amount_treated_as_foreign_branch_category_904d2Hi(p: us.irc.core::Person, tax_id: Text, y: us.irc.core::TaxableYear, tax: Money) kind institutional {
    label en official "for taxable years beginning after December 31, 2006 the tax is treated as imposed on income described in paragraph (1)(B) (the foreign branch category)";
}
@source(IRC_S904_D, relation = formalizes, coverage = exact, quote = "In the case of taxable years beginning after December 31, 2006, tax imposed under the law of a foreign")
rule S904D2HiNonIncomeTaxForeignBranchCategory defeasible {
    for p: us.irc.core::Person;
    for tax_id: Text;
    for y: us.irc.core::TaxableYear;
    for tax: Money;
    for begins_on: Date;
    when tax_on_non_income_amount_904d2Hi(p, tax_id, y, tax)
     and us.irc.core::begins(y, begins_on)
     and begins_on > @2006-12-31;
    then tax_on_non_income_amount_treated_as_foreign_branch_category_904d2Hi(p, tax_id, y, tax);
}
pub relation taxpayer_is_us_shareholder_of_cfc_904d3(p: us.irc.core::Person, cfc: us.irc.core::Corporation) kind empirical {
    label en official "the taxpayer is a United States shareholder in the controlled foreign corporation";
}
pub relation cfc_payment_to_taxpayer_904d3(p: us.irc.core::Person, cfc: us.irc.core::Corporation, item_id: Text, kind: Text, amount: Money) kind empirical {
    label en official "a dividend, interest, rent or royalty ('dividend', 'interest', 'rent', 'royalty') received or accrued by the taxpayer from the controlled foreign corporation";
}
pub relation payment_not_passive_category_by_default_904d3A(p: us.irc.core::Person, cfc: us.irc.core::Corporation, item_id: Text) kind institutional {
    label en official "dividends, interest, rents and royalties from a controlled foreign corporation in which the taxpayer is a United States shareholder are not passive category income, except as this paragraph provides";
}
@source(IRC_S904_D, relation = formalizes, coverage = exact, quote = "Except as otherwise provided in this paragraph, dividends, interest, rents, and royalties received or accrued")
rule S904D3ANotPassiveByDefault defeasible {
    for p: us.irc.core::Person;
    for cfc: us.irc.core::Corporation;
    for item_id: Text;
    for kind: Text;
    for amount: Money;
    when taxpayer_is_us_shareholder_of_cfc_904d3(p, cfc)
     and cfc_payment_to_taxpayer_904d3(p, cfc, item_id, kind, amount);
    unless payment_allocable_to_cfc_passive_category_income_904d3C(p, cfc, item_id, _)
     and cfc_payment_to_taxpayer_904d3(p, cfc, item_id, kind, amount);
    then payment_not_passive_category_by_default_904d3A(p, cfc, item_id);
}
pub relation payment_allocable_to_cfc_passive_category_income_904d3C(p: us.irc.core::Person, cfc: us.irc.core::Corporation, item_id: Text, allocable: Money) kind empirical {
    label en official "the part of the interest, rent or royalty properly allocable (under regulations) to passive category income of the controlled foreign corporation";
}
pub relation payment_passive_category_amount_904d3C(p: us.irc.core::Person, cfc: us.irc.core::Corporation, item_id: Text, amount: Money) kind institutional {
    label en official "interest, rent or royalty from a controlled foreign corporation is passive category income to the extent properly allocable to the corporation's passive category income";
}
@source(IRC_S904_D, relation = formalizes, coverage = exact, quote = "Any interest, rent, or royalty which is received or accrued from a controlled foreign corporation in which")
rule S904D3CPassiveToExtentAllocable defeasible {
    for p: us.irc.core::Person;
    for cfc: us.irc.core::Corporation;
    for item_id: Text;
    for kind: Text;
    for amount: Money;
    for allocable: Money;
    when taxpayer_is_us_shareholder_of_cfc_904d3(p, cfc)
     and cfc_payment_to_taxpayer_904d3(p, cfc, item_id, kind, amount)
     and payment_allocable_to_cfc_passive_category_income_904d3C(p, cfc, item_id, allocable);
    then payment_passive_category_amount_904d3C(p, cfc, item_id, min(amount, allocable));
}
pub relation cfc_fbc_and_insurance_income_not_passive_904d3E(cfc: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "if the corporation meets the de minimis rule of section 954(b)(3)(A), none of its foreign base company income and none of its gross insurance income is treated as passive category income under this paragraph";
}
@source(IRC_S904_D, relation = formalizes, coverage = exact, quote = "If a controlled foreign corporation meets the requirements of section 954(b)(3)(A) (relating to de minimis")
rule S904D3EDeMinimisCorporation defeasible {
    for cfc: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when de_minimis_954b3_applies(cfc, y);
    then cfc_fbc_and_insurance_income_not_passive_904d3E(cfc, y);
}
pub relation cfc_income_category_determination_904d3F(cfc: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the question whether income of a controlled foreign corporation (or income of the taxpayer treated as passive by this paragraph) is passive category income";
}
pub relation high_taxed_exception_clause_II_not_applied_904d3Fi(cfc: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "in determining whether income of a controlled foreign corporation is passive category income, subclause (II) of paragraph (2)(B)(iii) (the high-taxed income exception) does not apply";
}
@source(IRC_S904_D, relation = formalizes, coverage = exact, quote = "(i) In determining whether any income of a controlled foreign corporation is passive category income,")
rule S904D3FiHighTaxedNotApplied defeasible {
    for cfc: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when cfc_income_category_determination_904d3F(cfc, y);
    then high_taxed_exception_clause_II_not_applied_904d3Fi(cfc, y);
}
pub relation passive_treatment_overrides_paragraph_2_904d3Fii(cfc: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "income treated as passive category income under this paragraph is so treated notwithstanding any provision of paragraph (2); the high-taxed income determination is made after this paragraph is applied";
}
@source(IRC_S904_D, relation = formalizes, coverage = exact, quote = "(ii) Any income of the taxpayer which is treated as passive category income under this paragraph shall be so")
rule S904D3FiiOverridesParagraphTwo defeasible {
    for cfc: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when cfc_income_category_determination_904d3F(cfc, y);
    then passive_treatment_overrides_paragraph_2_904d3Fii(cfc, y);
}
pub relation inclusion_under_951a1B_904d3G(p: us.irc.core::Person, cfc: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "an amount included in gross income under section 951(a)(1)(B)";
}
pub relation dividend_includes_951a1B_amount_904d3G(p: us.irc.core::Person, cfc: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "for this paragraph the term dividend includes any amount included in gross income under section 951(a)(1)(B)";
}
@source(IRC_S904_D, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the term \"dividend\" includes any amount included in gross income in section")
rule S904D3GDividendIncludes951a1B defeasible {
    for p: us.irc.core::Person;
    for cfc: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when inclusion_under_951a1B_904d3G(p, cfc, y, amount);
    then dividend_includes_951a1B_amount_904d3G(p, cfc, y, amount);
}
pub relation section_78_amount_attributable_to_951a1A_904d3G(p: us.irc.core::Person, cfc: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "an amount included in gross income under section 78 to the extent attributable to amounts included under section 951(a)(1)(A)";
}
pub relation section_78_amount_treated_as_951a1A_inclusion_not_dividend_904d3G(p: us.irc.core::Person, cfc: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the section 78 amount attributable to section 951(a)(1)(A) inclusions is not a dividend for this paragraph but is treated as included under section 951(a)(1)(A)";
}
@source(IRC_S904_D, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the term \"dividend\" includes any amount included in gross income in section")
rule S904D3GSection78AmountNotDividend defeasible {
    for p: us.irc.core::Person;
    for cfc: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when section_78_amount_attributable_to_951a1A_904d3G(p, cfc, y, amount);
    then section_78_amount_treated_as_951a1A_inclusion_not_dividend_904d3G(p, cfc, y, amount);
}
pub relation pfic_is_cfc_and_taxpayer_us_shareholder_904d3H(p: us.irc.core::Person, pfic: us.irc.core::Corporation) kind empirical {
    label en official "a passive foreign investment company is a controlled foreign corporation and the taxpayer is a United States shareholder in it";
}
pub relation section_1293_amount_attributable_to_category_904d3H(p: us.irc.core::Person, pfic: us.irc.core::Corporation, y: us.irc.core::TaxableYear, basket: ForeignTaxCreditBasket, amount: Money) kind empirical {
    label en official "the part of an amount included in gross income under section 1293 attributable to income in the category";
}
pub relation section_1293_amount_in_separate_category_904d3H(p: us.irc.core::Person, pfic: us.irc.core::Corporation, y: us.irc.core::TaxableYear, basket: ForeignTaxCreditBasket, amount: Money) kind institutional {
    label en official "a section 1293 amount of a passive foreign investment company that is a controlled foreign corporation is income in a separate category to the extent attributable to income in that category";
}
@source(IRC_S904_D, relation = formalizes, coverage = exact, quote = "any amount included in gross income under section 1293 shall be treated as income in a separate category to")
rule S904D3HSection1293AmountTakesCategory defeasible {
    for p: us.irc.core::Person;
    for pfic: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for basket: ForeignTaxCreditBasket;
    for amount: Money;
    when pfic_is_cfc_and_taxpayer_us_shareholder_904d3H(p, pfic)
     and section_1293_amount_attributable_to_category_904d3H(p, pfic, y, basket, amount);
    then section_1293_amount_in_separate_category_904d3H(p, pfic, y, basket, amount);
}

// --- §911(c)(3)(B), (c)(4)(C), (c)(4)(E), (e)(1) ---------------------------------------------------------------------------------------

pub relation abode_housing_expenses_911c3B(individual: us.irc.core::Individual, y: us.irc.core::TaxableYear, abode_id: Text, closeness_rank: Integer, expenses: Money) kind empirical {
    label en official "an abode of the individual: its closeness to the tax home (1 is the closest) and the housing expenses incurred with respect to it";
}
pub relation closest_abode_rank_candidate_911c3Bi(individual: us.irc.core::Individual, y: us.irc.core::TaxableYear, rank: Integer) kind institutional {
    label en official "a candidate rank of abodes of the individual";
}
@source(IRC_S911_C, relation = formalizes, coverage = exact, quote = "Except as provided in clause (ii), only housing expenses incurred with respect to that abode which bears the")
rule S911C3BiRankCandidate defeasible {
    for individual: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for abode_id: Text;
    for rank: Integer;
    for expenses: Money;
    when abode_housing_expenses_911c3B(individual, y, abode_id, rank, expenses);
    then closest_abode_rank_candidate_911c3Bi(individual, y, rank);
}
pub relation housing_expenses_of_closest_abode_taken_into_account_911c3Bi(individual: us.irc.core::Individual, y: us.irc.core::TaxableYear, abode_id: Text, expenses: Money) kind institutional {
    label en official "only the housing expenses incurred with respect to the abode which bears the closest relationship to the tax home are taken into account under paragraph (1) (a lower rank is a closer relationship)";
}
@source(IRC_S911_C, relation = formalizes, coverage = exact, quote = "Except as provided in clause (ii), only housing expenses incurred with respect to that abode which bears the")
rule S911C3BiClosestAbodeOnly defeasible {
    for individual: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for abode_id: Text;
    for rank: Integer;
    for expenses: Money;
    for closer: Integer;
    when abode_housing_expenses_911c3B(individual, y, abode_id, rank, expenses);
    unless closest_abode_rank_candidate_911c3Bi(individual, y, closer)
     and closer < rank
     and abode_housing_expenses_911c3B(individual, y, abode_id, rank, expenses);
    then housing_expenses_of_closest_abode_taken_into_account_911c3Bi(individual, y, abode_id, expenses);
}
pub relation separate_abode_for_spouse_and_dependents_in_adverse_conditions_911c3Bii(individual: us.irc.core::Individual, y: us.irc.core::TaxableYear, abode_id: Text) kind empirical {
    label en official "the individual maintains a separate abode outside the United States for the spouse and dependents, who do not reside with him because of living conditions which are dangerous, unhealthful or otherwise adverse";
}
pub relation housing_expenses_of_adverse_conditions_abode_taken_into_account_911c3Bii(individual: us.irc.core::Individual, y: us.irc.core::TaxableYear, abode_id: Text, expenses: Money) kind institutional {
    label en official "the words 'if they reside with him' of subparagraph (A) are disregarded and the housing expenses incurred with respect to that abode are also taken into account";
}
@source(IRC_S911_C, relation = formalizes, coverage = exact, quote = "(II) the housing expenses incurred with respect to such abode shall be taken into account under paragraph (1).")
rule S911C3BiiAdverseConditionsAbode defeasible {
    for individual: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for abode_id: Text;
    for rank: Integer;
    for expenses: Money;
    when separate_abode_for_spouse_and_dependents_in_adverse_conditions_911c3Bii(individual, y, abode_id)
     and abode_housing_expenses_911c3B(individual, y, abode_id, rank, expenses);
    then housing_expenses_of_adverse_conditions_abode_taken_into_account_911c3Bii(individual, y, abode_id, expenses);
}
pub relation housing_deduction_disallowed_by_limitation_911c4C(individual: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the amount not allowable as a deduction for the taxable year under subparagraph (A) by reason of the limitation of subparagraph (B)";
}
pub relation housing_limitation_911c4B_for_year(individual: us.irc.core::Individual, y: us.irc.core::TaxableYear, limit: Money) kind empirical {
    label en official "the limitation of subparagraph (B) for the taxable year";
}
pub relation housing_deduction_allowed_under_911c4A_for_year(individual: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the amounts treated as a deduction under subparagraph (A) for the taxable year";
}
pub relation carryover_limitation_for_succeeding_year_911c4Cii(individual: us.irc.core::Individual, y: us.irc.core::TaxableYear, limit: Money) kind institutional {
    label en official "the limitation of clause (ii): the subparagraph (B) limitation for the taxable year over the amounts treated as a deduction under subparagraph (A), floored at zero";
}
@source(IRC_S911_C, relation = formalizes, coverage = exact, quote = "For purposes of clause (i), the limitation of this clause for any taxable year is the excess of—")
rule S911C4CiiCarryoverLimitation defeasible {
    for individual: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for limit: Money;
    for allowed: Money;
    when housing_limitation_911c4B_for_year(individual, y, limit)
     and housing_deduction_allowed_under_911c4A_for_year(individual, y, allowed);
    then carryover_limitation_for_succeeding_year_911c4Cii(individual, y, max(limit - allowed, 0.00 USD));
}
pub relation succeeding_year_of_911c4C(individual: us.irc.core::Individual, prior_year: us.irc.core::TaxableYear, succeeding_year: us.irc.core::TaxableYear) kind empirical {
    label en official "the taxable year is the succeeding taxable year of the prior year (only the succeeding year, no later one)";
}
pub relation carryover_deduction_allowed_in_succeeding_year_911c4Ci(individual: us.irc.core::Individual, succeeding_year: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the disallowed amount is treated as a deduction allowable in computing adjusted gross income for the succeeding taxable year (and only that year), to the extent of the succeeding year's clause (ii) limitation";
}
@source(IRC_S911_C, relation = formalizes, coverage = exact, quote = "The amount not allowable as a deduction for any taxable year under subparagraph (A) by reason of the")
rule S911C4CiCarryoverToSucceedingYear defeasible {
    for individual: us.irc.core::Individual;
    for prior_year: us.irc.core::TaxableYear;
    for succeeding_year: us.irc.core::TaxableYear;
    for disallowed: Money;
    for limit: Money;
    when housing_deduction_disallowed_by_limitation_911c4C(individual, prior_year, disallowed)
     and succeeding_year_of_911c4C(individual, prior_year, succeeding_year)
     and carryover_limitation_for_succeeding_year_911c4Cii(individual, succeeding_year, limit);
    then carryover_deduction_allowed_in_succeeding_year_911c4Ci(individual, succeeding_year, min(disallowed, limit));
}
pub relation foreign_earned_income_before_limitation_911b2A(individual: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the individual's foreign earned income for the taxable year before the limitation of subsection (b)(2)(A)";
}
pub relation foreign_earned_income_for_housing_deduction_911c4E(individual: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "for the housing deduction the foreign earned income is determined without regard to the limitation of subsection (b)(2)(A)";
}
@source(IRC_S911_C, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, an individual's foreign earned income for any taxable year shall be")
rule S911C4EIncomeWithoutRegardToLimitation defeasible {
    for individual: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when foreign_earned_income_before_limitation_911b2A(individual, y, amount);
    then foreign_earned_income_for_housing_deduction_911c4E(individual, y, amount);
}
pub relation election_911a_made_for_year_911e1(individual: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind empirical {
    label en official "an election under subsection (a) is made for the taxable year";
}
pub relation election_911a_made_for_earlier_year_911e1(individual: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind empirical {
    label en official "an election under subsection (a) made for an earlier taxable year has not been revoked under paragraph (2)";
}
pub relation election_911a_applies_to_year_911e1(individual: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the election applies to the taxable year for which made and to all subsequent taxable years unless revoked";
}
@source(IRC_S911_E, relation = formalizes, coverage = exact, quote = "An election under subsection (a) shall apply to the taxable year for which made and to all subsequent taxable")
rule S911E1ElectionYearMade defeasible {
    for individual: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    when election_911a_made_for_year_911e1(individual, y);
    then election_911a_applies_to_year_911e1(individual, y);
}
@source(IRC_S911_E, relation = formalizes, coverage = exact, quote = "An election under subsection (a) shall apply to the taxable year for which made and to all subsequent taxable")
rule S911E1ElectionSubsequentYears defeasible {
    for individual: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    when election_911a_made_for_earlier_year_911e1(individual, y);
    then election_911a_applies_to_year_911e1(individual, y);
}

// --- §877(d)(3), (d)(4)(C), (e)(3)(A); §877A(b), (g), (h) --------------------------------------------------------------------------

pub relation risk_of_loss_substantially_diminished_days_877d3(individual: us.irc.core::Individual, property_id: Text, days: Integer, by_kind: Text) kind empirical {
    label en official "the number of days in which the individual's risk of loss with respect to the property is substantially diminished by the holding of a put ('put'), the holding by another person of a right to acquire the property ('right_to_acquire') or a short sale or any other transaction ('short_sale_or_other')";
}
pub relation ten_year_period_suspended_days_877d3(individual: us.irc.core::Individual, property_id: Text, suspended_days: Integer) kind institutional {
    label en official "the running of the 10-year period of subsection (a) and of the period under paragraph (2) is suspended for the days of diminished risk of loss";
}
@source(IRC_S877_D, relation = formalizes, coverage = exact, quote = "For purposes of determining whether this section applies to any gain on the sale or exchange of any property,")
rule S877D3SuspensionByDiminishedRisk defeasible {
    for individual: us.irc.core::Individual;
    for property_id: Text;
    for days: Integer;
    for by_kind: Text;
    when risk_of_loss_substantially_diminished_days_877d3(individual, property_id, days, by_kind)
     and days > 0;
    then ten_year_period_suspended_days_877d3(individual, property_id, days);
}
pub relation corporation_holds_877d4A_property_877d4C(corp: us.irc.core::Corporation, property_id: Text) kind empirical {
    label en official "the corporation holds the property referred to in subparagraph (A)";
}
pub relation stock_disposed_of_within_ten_years_877d4C(individual: us.irc.core::Individual, corp: us.irc.core::Corporation, stock_value: Money, total_stock_value: Money) kind empirical {
    label en official "stock in the corporation (or stock with a basis determined by reference to it) is disposed of during the 10-year period while the property is held: the value of the stock disposed of and the value of all the stock";
}
pub relation pro_rata_share_of_property_treated_as_sold_877d4C(individual: us.irc.core::Individual, corp: us.irc.core::Corporation, property_id: Text, share_percent: Decimal) kind institutional {
    label en official "a pro rata share of the property (by the value of the stock) is treated as sold by the corporation immediately before the disposition";
}
@source(IRC_S877_D, relation = formalizes, coverage = exact, quote = "If stock in the corporation referred to in subparagraph (A) (or any other stock which has a basis determined")
rule S877D4CProRataShareSold defeasible {
    for individual: us.irc.core::Individual;
    for corp: us.irc.core::Corporation;
    for property_id: Text;
    for part: Money;
    for total: Money;
    when corporation_holds_877d4A_property_877d4C(corp, property_id)
     and stock_disposed_of_within_ten_years_877d4C(individual, corp, part, total)
     and total > 0.00 USD;
    then pro_rata_share_of_property_treated_as_sold_877d4C(individual, corp, property_id, 100.0 * (part / total));
}
pub relation individual_treated_as_us_citizen_or_resident_877e3(individual: us.irc.core::Individual) kind empirical {
    label en official "the individual is treated as provided in paragraph (1) of subsection (e)";
}
pub relation subsection_c_not_applicable_877e3A(individual: us.irc.core::Individual) kind institutional {
    label en official "subsection (c) does not apply to an individual who is treated as provided in paragraph (1)";
}
@source(IRC_S877_E, relation = formalizes, coverage = exact, quote = "Subsection (c) shall not apply to an individual who is treated as provided in paragraph (1).")
rule S877E3ASubsectionCNotApplicable defeasible {
    for individual: us.irc.core::Individual;
    when individual_treated_as_us_citizen_or_resident_877e3(individual);
    then subsection_c_not_applicable_877e3A(individual);
}
pub relation date_of_death_return_due_877Ab3(individual: us.irc.core::Individual, due: Date) kind empirical {
    label en official "the due date for the return of tax for the taxable year which includes the date of death of the expatriate";
}
pub relation security_failure_date_877Ab3(individual: us.irc.core::Individual, failed_on: Date) kind empirical {
    label en official "the time the security provided with respect to the property fails to meet the requirements of paragraph (4), unless the taxpayer corrects the failure within the time specified by the Secretary";
}
pub relation extension_limit_candidate_877Ab3(individual: us.irc.core::Individual, on: Date) kind institutional {
    label en official "a candidate latest date for the extended payment: the return due date for the year of death or the date the security fails";
}
@source(IRC_S877A_B, relation = formalizes, coverage = exact, quote = "The due date for payment of tax may not be extended under this subsection later than the due date for the")
rule S877AB3DeathReturnDueCandidate defeasible {
    for individual: us.irc.core::Individual;
    for due: Date;
    when date_of_death_return_due_877Ab3(individual, due);
    then extension_limit_candidate_877Ab3(individual, due);
}
@source(IRC_S877A_B, relation = formalizes, coverage = exact, quote = "The due date for payment of tax may not be extended under this subsection later than the due date for the")
rule S877AB3SecurityFailureCandidate defeasible {
    for individual: us.irc.core::Individual;
    for failed_on: Date;
    when security_failure_date_877Ab3(individual, failed_on);
    then extension_limit_candidate_877Ab3(individual, failed_on);
}
pub relation latest_extended_due_date_877Ab3(individual: us.irc.core::Individual, latest: Date) kind institutional {
    label en official "the due date for payment may not be extended later than the earlier of the candidates";
}
@source(IRC_S877A_B, relation = formalizes, coverage = exact, quote = "The due date for payment of tax may not be extended under this subsection later than the due date for the")
rule S877AB3EarlierOfTwoDates defeasible {
    for individual: us.irc.core::Individual;
    for on: Date;
    for earlier: Date;
    when extension_limit_candidate_877Ab3(individual, on);
    unless extension_limit_candidate_877Ab3(individual, earlier)
     and earlier < on
     and extension_limit_candidate_877Ab3(individual, on);
    then latest_extended_due_date_877Ab3(individual, on);
}
pub relation deferral_election_property_877Ab6(individual: us.irc.core::Individual, property_id: Text) kind empirical {
    label en official "the property described in the election under paragraph (1)";
}
pub relation deferral_election_covers_property_only_877Ab6(individual: us.irc.core::Individual, property_id: Text) kind institutional {
    label en official "an election under paragraph (1) applies only to property described in the election and, once made, is irrevocable";
}
@source(IRC_S877A_B, relation = formalizes, coverage = exact, quote = "An election under paragraph (1) shall only apply to property described in the election and, once made, is")
rule S877AB6ElectionOnlyForDescribedProperty defeasible {
    for individual: us.irc.core::Individual;
    for property_id: Text;
    when deferral_election_property_877Ab6(individual, property_id);
    then deferral_election_covers_property_only_877Ab6(individual, property_id);
}
pub relation deferred_tax_payment_date_877Ab7(individual: us.irc.core::Individual, extended_to: Date, ordinary_last_date: Date) kind empirical {
    label en official "the extended payment date under the election, and the last date for payment without the election";
}
pub relation last_date_for_payment_for_section_6601_877Ab7(individual: us.irc.core::Individual, last_date: Date) kind institutional {
    label en official "for section 6601 the last date for payment is determined without regard to the election";
}
@source(IRC_S877A_B, relation = formalizes, coverage = exact, quote = "For purposes of section 6601, the last date for the payment of tax shall be determined without regard to the")
rule S877AB7LastDateWithoutElection defeasible {
    for individual: us.irc.core::Individual;
    for extended_to: Date;
    for ordinary: Date;
    when deferred_tax_payment_date_877Ab7(individual, extended_to, ordinary);
    then last_date_for_payment_for_section_6601_877Ab7(individual, ordinary);
}
pub relation subject_to_tax_as_citizen_or_resident_after_expatriation_877Ag1C(individual: us.irc.core::Individual) kind empirical {
    label en official "the covered expatriate is subject to tax as a citizen or resident of the United States for a period beginning after the expatriation date";
}
pub relation not_covered_expatriate_for_877Ad1_877Af_2801_877Ag1C(individual: us.irc.core::Individual) kind institutional {
    label en official "during that period the individual is not treated as a covered expatriate for subsections (d)(1) and (f) and section 2801";
}
@source(IRC_S877A_G, relation = formalizes, coverage = exact, quote = "In the case of any covered expatriate who is subject to tax as a citizen or resident of the United States for")
rule S877AG1CNotCoveredExpatriateWhileTaxedAsCitizen defeasible {
    for individual: us.irc.core::Individual;
    when subject_to_tax_as_citizen_or_resident_after_expatriation_877Ag1C(individual);
    then not_covered_expatriate_for_877Ad1_877Af_2801_877Ag1C(individual);
}
pub relation acquisition_period_reducing_gain_ends_877Ah1A(individual: us.irc.core::Individual, expatriation_date: Date) kind institutional {
    label en official "any time period for acquiring property which would reduce the gain recognized terminates on the day before the expatriation date";
}
pub relation expatriation_date_877Ah1(individual: us.irc.core::Individual, expatriation_date: Date) kind empirical {
    label en official "the expatriation date";
}
@source(IRC_S877A_H, relation = formalizes, coverage = exact, quote = "(A) any time period for acquiring property which would result in the reduction in the amount of gain")
rule S877AH1AAcquisitionPeriodEndsDayBefore defeasible {
    for individual: us.irc.core::Individual;
    for expatriation_date: Date;
    for calendar_before_1: Date;
    when expatriation_date_877Ah1(individual, expatriation_date)
        and us.irc.core::civil_calendar_boundary_before(expatriation_date, 1, us.irc.core::CalendarDay, calendar_before_1);
    then acquisition_period_reducing_gain_ends_877Ah1A(individual, calendar_before_1);
}
pub relation extension_of_time_for_payment_ceases_877Ah1B(individual: us.irc.core::Individual, ceases_on: Date) kind institutional {
    label en official "any extension of time for payment of tax ceases to apply on the day before the expatriation date, and the unpaid portion is due at the time and in the manner the Secretary prescribes";
}
@source(IRC_S877A_H, relation = formalizes, coverage = exact, quote = "(B) any extension of time for payment of tax shall cease to apply on the day before the expatriation date and")
rule S877AH1BExtensionCeasesDayBefore defeasible {
    for individual: us.irc.core::Individual;
    for expatriation_date: Date;
    for calendar_before_1: Date;
    when expatriation_date_877Ah1(individual, expatriation_date)
        and us.irc.core::civil_calendar_boundary_before(expatriation_date, 1, us.irc.core::CalendarDay, calendar_before_1);
    then extension_of_time_for_payment_ceases_877Ah1B(individual, calendar_before_1);
}
pub relation expatriation_would_result_in_684_gain_877Ah3(individual: us.irc.core::Individual) kind empirical {
    label en official "the expatriation would result in the recognition of gain under section 684";
}
pub relation section_877A_applied_after_684_877Ah3(individual: us.irc.core::Individual) kind institutional {
    label en official "this section is applied after the application of section 684";
}
@source(IRC_S877A_H, relation = formalizes, coverage = exact, quote = "If the expatriation of any individual would result in the recognition of gain under section 684, this section")
rule S877AH3AfterSection684 defeasible {
    for individual: us.irc.core::Individual;
    when expatriation_would_result_in_684_gain_877Ah3(individual);
    then section_877A_applied_after_684_877Ah3(individual);
}

// --- §865(c)(2), (c)(3)(B), (d)(4), (i)(3), (i)(5) ------------------------------------------------------------------------------------

pub relation depreciable_personal_property_sale_865c2(item_id: Text, gain: Money, depreciation_adjustments: Money) kind empirical {
    label en official "gain from the sale of depreciable personal property and the depreciation adjustments";
}
pub relation gain_in_excess_of_depreciation_sourced_as_inventory_865c2(item_id: Text, amount: Money) kind institutional {
    label en official "the gain in excess of the depreciation adjustments is sourced as if the property were inventory property";
}
@source(IRC_S865_C, relation = formalizes, coverage = exact, quote = "Gain (in excess of the depreciation adjustments) from the sale of depreciable personal property shall be")
rule S865C2ExcessGainAsInventory defeasible {
    for item_id: Text;
    for gain: Money;
    for adjustments: Money;
    when depreciable_personal_property_sale_865c2(item_id, gain, adjustments)
     and gain > adjustments;
    then gain_in_excess_of_depreciation_sourced_as_inventory_865c2(item_id, gain - adjustments);
}
pub relation property_used_predominantly_865c3B(property_id: Text, y: us.irc.core::TaxableYear, where_used: Text) kind empirical {
    label en official "the property is used predominantly in the United States ('united_states') or outside the United States ('foreign') for the taxable year";
}
pub relation property_of_kind_168g4_865c3B(property_id: Text) kind empirical {
    label en official "the property is of a kind described in section 168(g)(4)";
}
pub relation depreciation_deductions_allocated_to_source_865c3B(property_id: Text, y: us.irc.core::TaxableYear, source_country: Text) kind institutional {
    label en official "all of the depreciation deductions allowable for the year are allocated to income from sources in the United States (or, if used predominantly outside, from sources outside the United States)";
}
@source(IRC_S865_C, relation = formalizes, coverage = exact, quote = "(i) such property is used predominantly in the United States, or")
rule S865C3BiPredominantlyUnitedStates defeasible {
    for property_id: Text;
    for y: us.irc.core::TaxableYear;
    when property_used_predominantly_865c3B(property_id, y, "united_states");
    unless property_of_kind_168g4_865c3B(property_id)
     and property_used_predominantly_865c3B(property_id, y, "united_states");
    then depreciation_deductions_allocated_to_source_865c3B(property_id, y, "united_states");
}
@source(IRC_S865_C, relation = formalizes, coverage = exact, quote = "(ii) such property is used predominantly outside the United States,")
rule S865C3BiiPredominantlyOutside defeasible {
    for property_id: Text;
    for y: us.irc.core::TaxableYear;
    when property_used_predominantly_865c3B(property_id, y, "foreign");
    unless property_of_kind_168g4_865c3B(property_id)
     and property_used_predominantly_865c3B(property_id, y, "foreign");
    then depreciation_deductions_allocated_to_source_865c3B(property_id, y, "foreign");
}
pub relation intangible_sale_865d4(item_id: Text, gain: Money, depreciation_adjustments: Money) kind empirical {
    label en official "gain from the sale of an intangible and the depreciation adjustments with respect to it";
}
pub relation intangible_gain_sourced_under_865c_865d4A(item_id: Text, amount: Money) kind institutional {
    label en official "gain from the sale of an intangible is sourced under subsection (c) to the extent it does not exceed the depreciation adjustments";
}
@source(IRC_S865_D, relation = formalizes, coverage = exact, quote = "Notwithstanding paragraph (1), any gain from the sale of an intangible shall be sourced under subsection (c)")
rule S865D4AGainUpToDepreciationSourcedByC defeasible {
    for item_id: Text;
    for gain: Money;
    for adjustments: Money;
    when intangible_sale_865d4(item_id, gain, adjustments);
    then intangible_gain_sourced_under_865c_865d4A(item_id, min(gain, adjustments));
}
pub relation paragraph_c2_not_applicable_to_intangible_gain_865d4B(item_id: Text) kind institutional {
    label en official "paragraph (2) of subsection (c) (excess gain sourced as inventory) does not apply to gain from the sale of an intangible";
}
@source(IRC_S865_D, relation = formalizes, coverage = exact, quote = "Paragraph (2) of subsection (c) shall not apply to any gain from the sale of an intangible.")
rule S865D4BNoInventoryTreatmentOfIntangibleGain defeasible {
    for item_id: Text;
    for gain: Money;
    for adjustments: Money;
    when intangible_sale_865d4(item_id, gain, adjustments);
    then paragraph_c2_not_applicable_to_intangible_gain_865d4B(item_id);
}
pub relation possession_of_united_states_865i3(place_id: Text) kind empirical {
    label en official "the place is a possession of the United States";
}
pub relation treated_as_foreign_country_865i3(place_id: Text) kind institutional {
    label en official "any possession of the United States is treated as a foreign country for this section";
}
@source(IRC_S865_I, relation = formalizes, coverage = exact, quote = "Any possession of the United States shall be treated as a foreign country.")
rule S865I3PossessionAsForeignCountry defeasible {
    for place_id: Text;
    when possession_of_united_states_865i3(place_id);
    then treated_as_foreign_country_865i3(place_id);
}
pub relation partner_of_partnership_865i5(partner: us.irc.core::Person, partnership: us.irc.core::Person) kind empirical {
    label en official "the person is a partner of the partnership";
}
pub relation regulations_provide_partnership_level_865i5(partnership: us.irc.core::Person) kind empirical {
    label en official "regulations provide that section 865 applies at the partnership level";
}
pub relation section_865_applied_at_partner_level_865i5(partner: us.irc.core::Person, partnership: us.irc.core::Person) kind institutional {
    label en official "in the case of a partnership, except as provided in regulations, this section is applied at the partner level";
}
@source(IRC_S865_I, relation = formalizes, coverage = exact, quote = "In the case of a partnership, except as provided in regulations, this section shall be applied at the partner")
rule S865I5PartnerLevel defeasible {
    for partner: us.irc.core::Person;
    for partnership: us.irc.core::Person;
    when partner_of_partnership_865i5(partner, partnership);
    unless regulations_provide_partnership_level_865i5(partnership)
     and partner_of_partnership_865i5(partner, partnership);
    then section_865_applied_at_partner_level_865i5(partner, partnership);
}

// --- §992(b)(2), (b)(3)(A), (e); §993(c)(2); §993(d)(4); §994(c); §995(d)(4); §996(a)(2) ------------------------------------------------

pub relation shareholder_of_disc_in_year_992b2(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the person is a shareholder of the corporation at some time in the taxable year";
}
pub relation disc_part_applies_to_corporation_and_shareholder_992b2(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "if the election is effective, the provisions of this part apply to the corporation for the taxable year and all succeeding taxable years, and to each shareholder for all periods on or after the first day of the first year for which the election is effective";
}
@source(IRC_S992_B, relation = formalizes, coverage = exact, quote = "If a corporation makes an election under paragraph (1), then the provisions of this part shall apply to such")
rule S992B2PartAppliesToCorporationAndShareholders defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when election_effective_992b(corp, y)
     and shareholder_of_disc_in_year_992b2(shareholder, corp, y);
    then disc_part_applies_to_corporation_and_shareholder_992b2(shareholder, corp, y);
}
pub relation revocation_made_on_992b3A(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, made_on: Date) kind empirical {
    label en official "the corporation revokes its election in the taxable year, on this date; the year is after the first taxable year for which the election is effective";
}
pub relation revocation_effective_for_992b3A(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, effective_from: Text) kind institutional {
    label en official "the revocation is effective for the taxable year in which made ('same_year') if made during the first 90 days of it, or for the following taxable year ('following_year') if made after those 90 days, and for all succeeding years";
}
@source(IRC_S992_B, relation = formalizes, coverage = exact, quote = "(i) for the taxable year in which made, if made at any time during the first 90 days of such taxable year, or")
rule S992B3AiRevocationInFirstNinetyDays defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for made_on: Date;
    for begins_on: Date;
    when revocation_made_on_992b3A(corp, y, made_on)
     and us.irc.core::begins(y, begins_on)
     and days_between(begins_on, made_on) < 90;
    then revocation_effective_for_992b3A(corp, y, "same_year");
}
@source(IRC_S992_B, relation = formalizes, coverage = exact, quote = "(ii) for the taxable year following the taxable year in which made, if made after the close of such 90 days,")
rule S992B3AiiRevocationAfterNinetyDays defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for made_on: Date;
    for begins_on: Date;
    when revocation_made_on_992b3A(corp, y, made_on)
     and us.irc.core::begins(y, begins_on)
     and days_between(begins_on, made_on) >= 90;
    then revocation_effective_for_992b3A(corp, y, "following_year");
}
pub relation subsidiary_established_for_disc_992e(subsidiary: us.irc.core::Corporation) kind empirical {
    label en official "the corporation was established to take advantage of the provisions of this part";
}
pub relation parent_direct_ownership_percent_throughout_year_992e(parent: us.irc.core::Corporation, subsidiary: us.irc.core::Corporation, percent: Decimal) kind empirical {
    label en official "the percentage of the stock of the subsidiary the second corporation owns directly throughout the taxable year";
}
pub relation film_interest_acquired_by_parent_and_transferred_992e(parent: us.irc.core::Corporation, subsidiary: us.irc.core::Corporation, film_id: Text, acquired_on: Date) kind empirical {
    label en official "an interest in a film acquired by the parent and transferred to the subsidiary, and the date the parent acquired it";
}
pub relation film_interest_treated_as_acquired_by_subsidiary_at_parent_time_992e(parent: us.irc.core::Corporation, subsidiary: us.irc.core::Corporation, film_id: Text, treated_on: Date) kind institutional {
    label en official "for section 992(d)(2) and section 541, the film interest is taken into account under section 543(a)(5) as if acquired by the subsidiary at the time the parent acquired it";
}
@source(IRC_S992_E, relation = formalizes, coverage = exact, quote = "then, for purposes of applying subsection (d)(2) and section 541 (relating to personal holding company tax)")
rule S992EFilmInterestOfParentAttributedToSubsidiary defeasible {
    for parent: us.irc.core::Corporation;
    for subsidiary: us.irc.core::Corporation;
    for film_id: Text;
    for acquired_on: Date;
    for percent: Decimal;
    when subsidiary_established_for_disc_992e(subsidiary)
     and parent_direct_ownership_percent_throughout_year_992e(parent, subsidiary, percent)
     and percent >= 80.0
     and film_interest_acquired_by_parent_and_transferred_992e(parent, subsidiary, film_id, acquired_on);
    then film_interest_treated_as_acquired_by_subsidiary_at_parent_time_992e(parent, subsidiary, film_id, acquired_on);
}
pub relation share_of_fair_market_value_from_manufacturing_or_processing_993c2(property_id: Text, percent: Decimal) kind empirical {
    label en official "the percentage of the fair market value of the commodity or product attributable to manufacturing or processing (processing does not include extracting, handling, packing, packaging, grading, storing or transporting)";
}
pub relation primary_product_of_oil_gas_coal_or_uranium_993c2(property_id: Text) kind empirical {
    label en official "the property is a primary product from oil, gas, coal or uranium";
}
pub relation depletable_product_excluded_993c2C(property_id: Text) kind institutional {
    label en official "a product of a character with respect to which a depletion deduction is allowable is excluded from export property, unless at least 50 percent of its fair market value is attributable to manufacturing or processing, except that primary products from oil, gas, coal or uranium remain excluded";
}
@source(IRC_S993_C, relation = formalizes, coverage = exact, quote = "Subparagraph (C) shall not apply to any commodity or product at least 50 percent of the fair market value of")
rule S993C2CDepletableProductExcluded defeasible {
    for property_id: Text;
    when property_excluded_kind_993c2(property_id, "depletable_product");
    unless share_of_fair_market_value_from_manufacturing_or_processing_993c2(property_id, 50.0)
     and property_excluded_kind_993c2(property_id, "depletable_product");
    then depletable_product_excluded_993c2C(property_id);
}
@source(IRC_S993_C, relation = formalizes, coverage = exact, quote = "Subparagraph (C) shall not apply to any commodity or product at least 50 percent of the fair market value of")
rule S993C2CProcessedProductExcludedNever defeasible {
    for property_id: Text;
    when property_excluded_kind_993c2(property_id, "depletable_product")
     and primary_product_of_oil_gas_coal_or_uranium_993c2(property_id);
    then depletable_product_excluded_993c2C(property_id);
}
pub relation borrower_is_us_person_993d4Bi(borrower: us.irc.core::Person) kind empirical {
    label en official "the borrower is a United States person (section 7701(a)(30)); for a partnership all the partners must be United States persons, and for a corporation all its officers and at least a majority of its directors";
}
pub relation borrower_engaged_in_making_the_film_993d4Bii(borrower: us.irc.core::Person, film_id: Text) kind empirical {
    label en official "the borrower is engaged in the trade or business of making the film with respect to which the loan is made";
}
pub relation studio_located_in_united_states_993d4Biii(film_id: Text) kind empirical {
    label en official "the studio (if any) used or to be used for photographing and recording the film is located in the United States";
}
pub relation playing_time_photographed_outside_us_percent_993d4Biv(film_id: Text, percent: Decimal) kind empirical {
    label en official "the percentage of the aggregate playing time of the film photographed outside the United States";
}
pub relation payments_to_us_persons_or_fully_taxable_percent_993d4Bv(film_id: Text, percent: Decimal) kind empirical {
    label en official "the percentage of the total amount paid or to be paid for services in making the film paid to persons who are United States persons at the time (or consisting of amounts fully taxable by the United States)";
}
pub relation domestic_film_maker_993d4B(borrower: us.irc.core::Person, film_id: Text) kind institutional {
    label en official "a domestic film maker: a United States person engaged in making the film, with a United States studio, at most 20 percent of the playing time photographed abroad, and at least 80 percent of the service payments to United States persons or fully taxable amounts";
}
@source(IRC_S993_D, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, a borrower is a domestic film maker with respect to a film if—")
rule S993D4BDomesticFilmMaker defeasible {
    for borrower: us.irc.core::Person;
    for film_id: Text;
    for outside: Decimal;
    for us_paid: Decimal;
    when borrower_is_us_person_993d4Bi(borrower)
     and borrower_engaged_in_making_the_film_993d4Bii(borrower, film_id)
     and studio_located_in_united_states_993d4Biii(film_id)
     and playing_time_photographed_outside_us_percent_993d4Biv(film_id, outside)
     and payments_to_us_persons_or_fully_taxable_percent_993d4Bv(film_id, us_paid)
     and outside <= 20.0
     and us_paid >= 80.0;
    then domestic_film_maker_993d4B(borrower, film_id);
}
pub relation freight_cost_on_us_carrier_not_required_994c(item_id: Text, cost: Money) kind empirical {
    label en official "freight expenses to ship export property aboard airplanes owned and operated by United States persons or ships documented under United States law where law or regulations do not require shipment aboard them";
}
pub relation freight_expenses_included_in_export_promotion_994c(item_id: Text, amount: Money) kind institutional {
    label en official "export promotion expenses also include freight expenses to the extent of 50 percent of the cost of shipping";
}
@source(IRC_S994_C, relation = formalizes, coverage = exact, quote = "For purposes of this section, the term \"export promotion expenses\" means those expenses incurred to advance")
rule S994CFreightFiftyPercent defeasible {
    for item_id: Text;
    for cost: Money;
    when freight_cost_on_us_carrier_not_required_994c(item_id, cost);
    then freight_expenses_included_in_export_promotion_994c(item_id, round(cost * 0.50, 2, "HALF_UP"));
}
pub relation stock_or_debt_outstanding_dec_31_1971_995d4A(group_id: Text, amount: Money) kind empirical {
    label en official "the amount of stock or debt obligations of domestic members of the group outstanding on December 31, 1971, issued on or after January 1, 1968 to persons other than United States persons or members of the group, to the extent it is a long-term borrowing for the foreign direct investment program (established by the taxpayer)";
}
pub relation net_actual_foreign_investment_995d4Aii(group_id: Text, amount: Money) kind empirical {
    label en official "the net amount of actual foreign investment by domestic members of the group while the stock or debt obligations have been outstanding";
}
pub relation liquid_assets_held_oct_31_1971_995d4B(group_id: Text, amount: Money) kind empirical {
    label en official "the liquid assets (money, bank deposits other than time deposits, and indebtedness of 2 years or less to maturity at acquisition) held by foreign members of the group and foreign branches of domestic members on October 31, 1971, to the extent not in subparagraph (A)";
}
pub relation reasonable_working_capital_needs_oct_31_1971_995d4B(group_id: Text, amount: Money) kind empirical {
    label en official "the reasonable working capital needs of those members and branches on that date";
}
pub relation uncommitted_transitional_funds_995d4(group_id: Text, amount: Money) kind institutional {
    label en official "the uncommitted transitional funds of the group: the excess (subparagraph (A)) of the 1971 long-term borrowing over net actual foreign investment, plus the excess (subparagraph (B)) of liquid assets over working capital needs; each excess floored at zero";
}
@source(IRC_S995_D, relation = formalizes, coverage = exact, quote = "The uncommitted transitional funds of the group shall be an amount equal to the sum of—")
rule S995D4UncommittedTransitionalFunds defeasible {
    for group_id: Text;
    for borrowing: Money;
    for investment: Money;
    for liquid: Money;
    for working: Money;
    when stock_or_debt_outstanding_dec_31_1971_995d4A(group_id, borrowing)
     and net_actual_foreign_investment_995d4Aii(group_id, investment)
     and liquid_assets_held_oct_31_1971_995d4B(group_id, liquid)
     and reasonable_working_capital_needs_oct_31_1971_995d4B(group_id, working);
    then uncommitted_transitional_funds_995d4(group_id, max(borrowing - investment, 0.00 USD) + max(liquid - working, 0.00 USD));
}
pub relation actual_distribution_to_c_corporation_under_992c_995(shareholder: us.irc.core::Person, amount: Money) kind empirical {
    label en official "an actual distribution to a C corporation made pursuant to section 992(c) which is required to satisfy the condition of section 992(a)(1)(A)";
}
pub relation distribution_ordering_amount_996a2(shareholder: us.irc.core::Person, amount: Money) kind institutional {
    label en official "16/17ths of the amount is treated as made in the paragraph (2) order (accumulated DISC income, then earnings and profits described in paragraph (1)(C), then previously taxed income)";
}
@source(IRC_S996_A, relation = formalizes, coverage = exact, quote = "In the case of any amount of any actual distribution to a C corporation made pursuant to section 992(c) which")
rule S996A2SixteenSeventeenths defeasible {
    for shareholder: us.irc.core::Person;
    for amount: Money;
    when actual_distribution_to_c_corporation_under_992c_995(shareholder, amount);
    then distribution_ordering_amount_996a2(shareholder, div_round(amount * 16.00, 17.00, 2, "HALF_UP"));
}
pub relation remaining_one_seventeenth_under_996a1_996a2(shareholder: us.irc.core::Person, amount: Money) kind institutional {
    label en official "paragraph (1) applies to the remaining 1/17th of the amount";
}
@source(IRC_S996_A, relation = formalizes, coverage = exact, quote = "In the case of any amount of any actual distribution to a C corporation made pursuant to section 992(c) which")
rule S996A2OneSeventeenth defeasible {
    for shareholder: us.irc.core::Person;
    for amount: Money;
    when actual_distribution_to_c_corporation_under_992c_995(shareholder, amount);
    then remaining_one_seventeenth_under_996a1_996a2(shareholder, div_round(amount * 1.00, 17.00, 2, "HALF_UP"));
}

// --- §964(d), (e); §985(b)(3), §986(a)(1)(D) continuity ----------------------------------------------------------------------------------

pub relation cfc_treated_as_having_sold_stock_964e3(cfc: us.irc.core::Corporation, stock_id: Text) kind empirical {
    label en official "under a provision of this subtitle the controlled foreign corporation is treated as having gain from the sale or exchange of the stock";
}
pub relation cfc_treated_as_having_sold_or_exchanged_stock_964e3(cfc: us.irc.core::Corporation, stock_id: Text) kind institutional {
    label en official "for this subsection the controlled foreign corporation is treated as having sold or exchanged the stock";
}
@source(IRC_S964_E, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, a controlled foreign corporation shall be treated as having sold or")
rule S964E3TreatedAsSold defeasible {
    for cfc: us.irc.core::Corporation;
    for stock_id: Text;
    when cfc_treated_as_having_sold_stock_964e3(cfc, stock_id);
    then cfc_treated_as_having_sold_or_exchanged_stock_964e3(cfc, stock_id);
}
pub relation amount_treated_as_subpart_f_income_of_selling_cfc_964e4Aii(cfc: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the amount treated as subpart F income of the selling controlled foreign corporation under clause (i)";
}
pub relation shareholder_pro_rata_share_951a2_964e4Aii(shareholder: us.irc.core::Person, cfc: us.irc.core::Corporation, y: us.irc.core::TaxableYear, percent: Decimal) kind empirical {
    label en official "the shareholder's pro rata share (percent), determined as under section 951(a)(2)";
}
pub relation us_shareholder_inclusion_of_selling_cfc_subpart_f_964e4Aii(shareholder: us.irc.core::Person, cfc: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "a United States shareholder includes in gross income its pro rata share of the amount treated as subpart F income of the selling controlled foreign corporation";
}
@source(IRC_S964_E, relation = formalizes, coverage = exact, quote = "(ii) a United States shareholder with respect to the selling controlled foreign corporation shall include in")
rule S964E4AiiShareholderInclusion defeasible {
    for shareholder: us.irc.core::Person;
    for cfc: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    for percent: Decimal;
    when amount_treated_as_subpart_f_income_of_selling_cfc_964e4Aii(cfc, y, amount)
     and shareholder_pro_rata_share_951a2_964e4Aii(shareholder, cfc, y, percent);
    then us_shareholder_inclusion_of_selling_cfc_subpart_f_964e4Aii(shareholder, cfc, y, round(amount * (percent / 100.0), 2, "HALF_UP"));
}
pub relation deduction_245a_for_selling_cfc_subpart_f_964e4Aiii(shareholder: us.irc.core::Person, cfc: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the section 245A(a) deduction is allowable to the United States shareholder for the included subpart F income as if it were a dividend from the selling controlled foreign corporation";
}
@source(IRC_S964_E, relation = formalizes, coverage = exact, quote = "(iii) the deduction under section 245A(a) shall be allowable to the United States shareholder with respect to")
rule S964E4AiiiDeductionAsIfDividend defeasible {
    for shareholder: us.irc.core::Person;
    for cfc: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when us_shareholder_inclusion_of_selling_cfc_subpart_f_964e4Aii(shareholder, cfc, y, amount);
    then deduction_245a_for_selling_cfc_subpart_f_964e4Aiii(shareholder, cfc, y, amount);
}
pub relation election_964d2_made_for_earlier_year_964d2(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "an election under paragraph (2) was made for an earlier taxable year and has not been revoked with the consent of the Secretary";
}
pub relation election_964d2_made_for_year_964d2(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "an election under paragraph (2) is made for the taxable year";
}
pub relation election_964d2_applies_to_year_964d2(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the election applies to the taxable year for which made and all subsequent taxable years unless revoked with the consent of the Secretary";
}
@source(IRC_S964_D, relation = formalizes, coverage = exact, quote = "An election under this paragraph shall apply to the taxable year for which made and all subsequent taxable")
rule S964D2ElectionYearMade defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when election_964d2_made_for_year_964d2(corp, y);
    then election_964d2_applies_to_year_964d2(corp, y);
}
@source(IRC_S964_D, relation = formalizes, coverage = exact, quote = "An election under this paragraph shall apply to the taxable year for which made and all subsequent taxable")
rule S964D2ElectionSubsequentYears defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when election_964d2_made_for_earlier_year_964d2(corp, y);
    then election_964d2_applies_to_year_964d2(corp, y);
}
pub relation election_985b3_made_for_earlier_year_985b3(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "an election under subsection (b)(3) was made for an earlier taxable year and has not been revoked with the consent of the Secretary";
}
pub relation election_985b3_made_for_year_985b3(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "an election under subsection (b)(3) is made for the taxable year";
}
pub relation election_985b3_applies_to_year_985b3(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the election applies to the taxable year for which made and all subsequent taxable years unless revoked with the consent of the Secretary";
}
@source(IRC_S985_B, relation = formalizes, coverage = exact, quote = "Any such election shall apply to the taxable year for which made and all subsequent taxable years unless")
rule S985B3ElectionYearMade defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when election_985b3_made_for_year_985b3(p, y);
    then election_985b3_applies_to_year_985b3(p, y);
}
@source(IRC_S985_B, relation = formalizes, coverage = exact, quote = "Any such election shall apply to the taxable year for which made and all subsequent taxable years unless")
rule S985B3ElectionSubsequentYears defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when election_985b3_made_for_earlier_year_985b3(p, y);
    then election_985b3_applies_to_year_985b3(p, y);
}
pub relation election_986a1D_made_for_year_986a1D(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "an election under subparagraph (D) is made for the taxable year";
}
pub relation election_986a1D_made_for_earlier_year_986a1D(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "an election under subparagraph (D) made for an earlier taxable year has not been revoked with the consent of the Secretary";
}
pub relation election_986a1D_applies_to_year_986a1D(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the election applies to the taxable year for which made and all subsequent taxable years unless revoked";
}
@source(IRC_S986_A, relation = formalizes, coverage = exact, quote = "Any such election shall apply to the taxable year for which made and all subsequent taxable years unless")
rule S986A1DElectionYearMade defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when election_986a1D_made_for_year_986a1D(p, y);
    then election_986a1D_applies_to_year_986a1D(p, y);
}
@source(IRC_S986_A, relation = formalizes, coverage = exact, quote = "Any such election shall apply to the taxable year for which made and all subsequent taxable years unless")
rule S986A1DElectionSubsequentYears defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when election_986a1D_made_for_earlier_year_986a1D(p, y);
    then election_986a1D_applies_to_year_986a1D(p, y);
}
