// §871 residual (stage 2d): (a)(1)(B)-(D), (a)(3), (b)(2), (f), (g), (h)(3)-(6),
// (i)(2)-(3), (j), (k), (l), (m); §881(b)-(f) is in module 31. Module 03 carries
// (a), (b), (c), (d), (h)(2), (i)(2)(A). Amounts are case inputs; nothing here
// derives a source, a rate table or a §318 attribution chain.

// --- §871(a)(1)(B), (C), (D) ---------------------------------------------------

use self::{
    IRC_S871_A,
    IRC_S871_B,
    IRC_S871_F,
    IRC_S871_G,
    IRC_S871_H,
    IRC_S871_I,
    IRC_S871_J,
    IRC_S871_K,
    IRC_S871_L,
    IRC_S871_M,
    Secretary,
    effectively_connected,
    exempt_from_871a_tax,
    fdap_tax,
    post_december_special_rule_applies_871k1Ciii,
};

pub relation timber_gain_631_871a1B(recipient: us.irc.core::Individual, amount: Money, item_id: Text) kind empirical {
    label en official "gains described in subsection (b) or (c) of section 631 received from sources within the United States";
}
@source(IRC_S871_A, relation = formalizes, coverage = exact, quote = "(B) gains described in subsection (b) or (c) of section 631,")
rule S871A1BTimberGainsThirtyPercent defeasible {
    for recipient: us.irc.core::Individual;
    for amount: Money;
    for item_id: Text;
    when timber_gain_631_871a1B(recipient, amount, item_id);
    unless effectively_connected(recipient, item_id)
     and timber_gain_631_871a1B(recipient, amount, item_id);
    unless exempt_from_871a_tax(recipient, item_id)
     and timber_gain_631_871a1B(recipient, amount, item_id);
    then fdap_tax(recipient, amount, round(amount * 0.30, 2, "HALF_UP"));
}
pub relation oid_payment_871a1C(recipient: us.irc.core::Individual, item_id: Text, payment: Money, accrued_oid_not_yet_taken_into_account: Money, tax_under_871a1A_on_payment: Money) kind empirical {
    label en official "a payment on an original issue discount obligation held by a nonresident alien individual: the payment, the original issue discount accrued while held and not previously taken into account, and the tax imposed on the payment by paragraph (1)(A)";
}
pub relation oid_payment_tax_871a1Cii(recipient: us.irc.core::Individual, item_id: Text, tax: Money) kind institutional {
    label en official "the 30 percent tax on the accrued original issue discount, limited to the payment less the tax imposed by subparagraph (A) on it (section 871(a)(1)(C)(ii))";
}
@source(IRC_S871_A, relation = formalizes, coverage = exact, quote = "(ii) a payment on an original issue discount obligation, an amount equal to the original issue discount accruing while such obligation was held by the nonresident alien individual (except that such")
rule S871A1CiiOidPaymentTax defeasible {
    for recipient: us.irc.core::Individual;
    for item_id: Text;
    for payment: Money;
    for accrued: Money;
    for tax_a: Money;
    when oid_payment_871a1C(recipient, item_id, payment, accrued, tax_a);
    unless effectively_connected(recipient, item_id)
     and oid_payment_871a1C(recipient, item_id, payment, accrued, tax_a);
    then oid_payment_tax_871a1Cii(recipient, item_id, max(min(round(accrued * 0.30, 2, "HALF_UP"), payment - tax_a), 0.00 USD));
}
pub relation oid_obligation_sale_871a1Ci(recipient: us.irc.core::Individual, item_id: Text, accrued_oid_while_held: Money) kind empirical {
    label en official "a sale or exchange of an original issue discount obligation and the original issue discount accruing while held by the nonresident alien individual, to the extent not previously taken into account under clause (ii)";
}
pub relation oid_sale_tax_871a1Ci(recipient: us.irc.core::Individual, item_id: Text, tax: Money) kind institutional {
    label en official "the 30 percent tax on the original issue discount accrued while the obligation was held, on a sale or exchange (section 871(a)(1)(C)(i))";
}
@source(IRC_S871_A, relation = formalizes, coverage = exact, quote = "(i) a sale or exchange of an original issue discount obligation, the amount of the original issue discount accruing while such obligation was held by the nonresident alien individual (to the extent")
rule S871A1CiOidSaleTax defeasible {
    for recipient: us.irc.core::Individual;
    for item_id: Text;
    for accrued: Money;
    when oid_obligation_sale_871a1Ci(recipient, item_id, accrued);
    unless effectively_connected(recipient, item_id)
     and oid_obligation_sale_871a1Ci(recipient, item_id, accrued);
    then oid_sale_tax_871a1Ci(recipient, item_id, round(accrued * 0.30, 2, "HALF_UP"));
}
pub relation contingent_intangible_sale_gain_871a1D(recipient: us.irc.core::Individual, item_id: Text, gain: Money, sold_on: Date) kind empirical {
    label en official "gain from the sale or exchange of patents, copyrights, secret processes and formulas, good will, trademarks, trade brands, franchises or like property, to the extent from payments contingent on the productivity, use or disposition of the property, and the date of the sale";
}
@source(IRC_S871_A, relation = formalizes, coverage = exact, quote = "(D) gains from the sale or exchange after October 4, 1966, of patents, copyrights, secret processes and formulas, good will, trademarks, trade brands, franchises, and other like property, or of any")
rule S871A1DContingentIntangibleGainThirtyPercent defeasible {
    for recipient: us.irc.core::Individual;
    for item_id: Text;
    for gain: Money;
    for sold_on: Date;
    when contingent_intangible_sale_gain_871a1D(recipient, item_id, gain, sold_on)
     and sold_on > @1966-10-04;
    unless effectively_connected(recipient, item_id)
     and contingent_intangible_sale_gain_871a1D(recipient, item_id, gain, sold_on);
    then fdap_tax(recipient, gain, round(gain * 0.30, 2, "HALF_UP"));
}

// --- §871(a)(3): social security benefits ----------------------------------------

pub relation social_security_benefit_871a3(recipient: us.irc.core::Individual, item_id: Text, benefit: Money) kind empirical {
    label en official "a social security benefit (section 86(d)) received by a nonresident alien individual";
}
pub relation social_security_gross_income_871a3(recipient: us.irc.core::Individual, item_id: Text, included: Money) kind institutional {
    label en official "for purposes of section 871 and section 1441, 85 percent of any social security benefit is included in gross income and section 86 does not apply (section 871(a)(3))";
}
@source(IRC_S871_A, relation = formalizes, coverage = exact, quote = "(A) 85 percent of any social security benefit (as defined in section 86(d)) shall be included in gross income (notwithstanding section 207 of the Social Security Act), and")
rule S871A3SocialSecurityEightyFivePercent defeasible {
    for recipient: us.irc.core::Individual;
    for item_id: Text;
    for benefit: Money;
    when social_security_benefit_871a3(recipient, item_id, benefit);
    then social_security_gross_income_871a3(recipient, item_id, round(benefit * 0.85, 2, "HALF_UP"));
}

// --- §871(b)(2) -------------------------------------------------------------------

pub relation gross_income_item_871b2(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, item_id: Text, amount: Money) kind empirical {
    label en official "an item of gross income of the nonresident alien individual for the year";
}
pub relation gross_income_included_871b2(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, item_id: Text, amount: Money) kind institutional {
    label en official "in determining taxable income under section 871(b)(1), gross income includes only gross income effectively connected with the conduct of a trade or business within the United States (section 871(b)(2))";
}
@source(IRC_S871_B, relation = formalizes, coverage = exact, quote = "In determining taxable income for purposes of paragraph (1), gross income includes only gross income which is effectively connected with the conduct of a trade or business within the United States.")
rule S871B2OnlyEffectivelyConnectedGrossIncome defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for amount: Money;
    when gross_income_item_871b2(p, y, item_id, amount)
     and effectively_connected(p, item_id);
    then gross_income_included_871b2(p, y, item_id, amount);
}

// --- §871(f): certain annuities ---------------------------------------------------

pub relation annuity_from_qualified_plan_871f1(p: us.irc.core::Individual, item_id: Text) kind empirical {
    label en official "an amount received as an annuity under a qualified annuity plan described in section 403(a)(1), or from a qualified trust described in section 401(a) exempt under section 501(a)";
}
pub relation annuity_services_performed_outside_us_as_nonresident_alien_871f1Ai(item_id: Text) kind empirical {
    label en official "all the personal services by reason of which the annuity is payable were performed outside the United States by an individual who was a nonresident alien at the time";
}
pub relation annuity_services_described_864b1_in_us_871f1Aii(item_id: Text) kind empirical {
    label en official "the personal services by reason of which the annuity is payable were services described in section 864(b)(1) performed within the United States by that individual";
}
pub relation annuity_plan_us_employee_percentage_871f1B(item_id: Text, percentage: Decimal) kind empirical {
    label en official "the percentage of employees for whom contributions or benefits are provided, at the time the first annuity amount is paid, who are citizens or residents of the United States";
}
pub relation country_of_residence_grants_equivalent_exclusion_871f2A(p: us.irc.core::Individual) kind empirical {
    label en official "the recipient's country of residence grants a substantially equivalent exclusion to residents and citizens of the United States";
}
pub relation country_of_residence_beneficiary_developing_country_871f2B(p: us.irc.core::Individual) kind empirical {
    label en official "the recipient's country of residence is a beneficiary developing country under title V of the Trade Act of 1974";
}
pub relation annuity_excluded_from_gross_income_871f(p: us.irc.core::Individual, item_id: Text) kind institutional {
    label en official "the annuity is not included in gross income for purposes of section 871 (section 871(f))";
}
@source(IRC_S871_F, relation = formalizes, coverage = partial, quote = "For purposes of this section, gross income does not include any amount received as an annuity under a qualified annuity plan described in section 403(a)(1), or from a qualified trust described in")
rule S871F1AnnuityExcludedOutsideServices defeasible {
    for p: us.irc.core::Individual;
    for item_id: Text;
    for pct: Decimal;
    when annuity_from_qualified_plan_871f1(p, item_id)
     and annuity_services_performed_outside_us_as_nonresident_alien_871f1Ai(item_id)
     and annuity_plan_us_employee_percentage_871f1B(item_id, pct)
     and pct >= 90.0;
    then annuity_excluded_from_gross_income_871f(p, item_id);
}
@source(IRC_S871_F, relation = formalizes, coverage = partial, quote = "(ii) personal services described in section 864(b)(1) performed within the United States by such individual, and")
rule S871F1AnnuityExcludedSection864b1Services defeasible {
    for p: us.irc.core::Individual;
    for item_id: Text;
    for pct: Decimal;
    when annuity_from_qualified_plan_871f1(p, item_id)
     and annuity_services_described_864b1_in_us_871f1Aii(item_id)
     and annuity_plan_us_employee_percentage_871f1B(item_id, pct)
     and pct >= 90.0;
    then annuity_excluded_from_gross_income_871f(p, item_id);
}
@source(IRC_S871_F, relation = formalizes, coverage = partial, quote = "Income received during the taxable year which would be excluded from gross income under this subsection but for the requirement of paragraph (1)(B) shall not be included in gross income if—")
rule S871F2AnnuityExcludedEquivalentExclusion defeasible {
    for p: us.irc.core::Individual;
    for item_id: Text;
    for pct: Decimal;
    when annuity_from_qualified_plan_871f1(p, item_id)
     and annuity_services_performed_outside_us_as_nonresident_alien_871f1Ai(item_id)
     and annuity_plan_us_employee_percentage_871f1B(item_id, pct)
     and pct < 90.0
     and country_of_residence_grants_equivalent_exclusion_871f2A(p);
    then annuity_excluded_from_gross_income_871f(p, item_id);
}
@source(IRC_S871_F, relation = formalizes, coverage = partial, quote = "(B) the recipient's country of residence is a beneficiary developing country under title V of the Trade Act of 1974 (19 U.S.C. 2461 et seq.).")
rule S871F2AnnuityExcludedDevelopingCountry defeasible {
    for p: us.irc.core::Individual;
    for item_id: Text;
    for pct: Decimal;
    when annuity_from_qualified_plan_871f1(p, item_id)
     and annuity_services_performed_outside_us_as_nonresident_alien_871f1Ai(item_id)
     and annuity_plan_us_employee_percentage_871f1B(item_id, pct)
     and pct < 90.0
     and country_of_residence_beneficiary_developing_country_871f2B(p);
    then annuity_excluded_from_gross_income_871f(p, item_id);
}
rule S871FAnnuityExemptFromThirtyPercent defeasible {
    for p: us.irc.core::Individual;
    for item_id: Text;
    when annuity_excluded_from_gross_income_871f(p, item_id);
    then exempt_from_871a_tax(p, item_id);
}

// --- §871(g): original issue discount obligations ---------------------------------

pub relation bond_has_original_issue_discount_871g1A(item_id: Text) kind empirical {
    label en official "a bond or other evidence of indebtedness having original issue discount within the meaning of section 1273";
}
pub relation obligation_payable_days_from_issue_871g1Bi(item_id: Text, days: Integer) kind empirical {
    label en official "the number of days from the date of original issue within which the obligation is payable, without regard to the period held";
}
pub relation obligation_interest_exempt_regardless_of_holder_871g1Bii(item_id: Text) kind empirical {
    label en official "the interest on the obligation is exempt from tax under section 103 or any other provision of law without regard to the identity of the holder";
}
pub relation stripped_bond_or_coupon_871g4(item_id: Text) kind empirical {
    label en official "a stripped bond or stripped coupon to which section 1286 applies";
}
pub relation oid_obligation_871g1(item_id: Text) kind institutional {
    label en official "an original issue discount obligation for purposes of sections 871 and 881";
}
@source(IRC_S871_G, relation = formalizes, coverage = exact, quote = "Except as provided in subparagraph (B), the term \"original issue discount obligation\" means any bond or other evidence of indebtedness having original issue discount (within the meaning of section")
rule S871G1AOriginalIssueDiscountObligation defeasible {
    for item_id: Text;
    when bond_has_original_issue_discount_871g1A(item_id);
    unless obligation_payable_days_from_issue_871g1Bi(item_id, _)
     and short_term_obligation_871g1Bi(item_id);
    unless obligation_interest_exempt_regardless_of_holder_871g1Bii(item_id)
     and bond_has_original_issue_discount_871g1A(item_id);
    then oid_obligation_871g1(item_id);
}
pub relation short_term_obligation_871g1Bi(item_id: Text) kind institutional {
    label en official "an obligation payable 183 days or less from the date of original issue (section 871(g)(1)(B)(i))";
}
@source(IRC_S871_G, relation = formalizes, coverage = exact, quote = "Any obligation payable 183 days or less from the date of original issue (without regard to the period held by the taxpayer).")
rule S871G1BiShortTermObligation defeasible {
    for item_id: Text;
    for days: Integer;
    when obligation_payable_days_from_issue_871g1Bi(item_id, days)
     and days <= 183;
    then short_term_obligation_871g1Bi(item_id);
}
@source(IRC_S871_G, relation = formalizes, coverage = exact, quote = "The provisions of section 1286 (relating to the treatment of stripped bonds and stripped coupons as obligations with original issue discount) shall apply for purposes of this section.")
rule S871G4StrippedBondsAreOidObligations defeasible {
    for item_id: Text;
    when stripped_bond_or_coupon_871g4(item_id);
    then oid_obligation_871g1(item_id);
}
pub relation oid_payment_or_sale_event_871g3(item_id: Text) kind empirical {
    label en official "a payment (or sale or exchange) described in subsection (a)(1)(C) on an original issue discount obligation";
}
pub relation oid_amount_sourced_as_interest_871g3(item_id: Text) kind institutional {
    label en official "except to the extent regulations provide, the source of an amount described in subsection (a)(1)(C) is determined at the time of the payment (or sale or exchange) as if it involved the payment of interest (section 871(g)(3))";
}
@source(IRC_S871_G, relation = formalizes, coverage = partial, quote = "Except to the extent provided in regulations prescribed by the Secretary, the determination of whether any amount described in subsection (a)(1)(C) is from sources within the United States shall be")
rule S871G3SourceAsIfInterest defeasible {
    for item_id: Text;
    when oid_payment_or_sale_event_871g3(item_id)
     and oid_obligation_871g1(item_id);
    then oid_amount_sourced_as_interest_871g3(item_id);
}

// --- §871(h)(3): 10-percent shareholder ------------------------------------------

pub relation voting_power_percentage_of_corporate_issuer_871h3Bi(recipient: us.irc.core::Individual, item_id: Text, percentage: Decimal) kind empirical {
    label en official "the percentage of the total combined voting power of all classes of stock entitled to vote of the issuing corporation owned by the recipient (with section 318(a) attribution as modified by section 871(h)(3)(C), taken as a case input)";
}
pub relation capital_or_profits_percentage_of_partnership_issuer_871h3Bii(recipient: us.irc.core::Individual, item_id: Text, percentage: Decimal) kind empirical {
    label en official "the percentage of the capital or profits interest of the issuing partnership owned by the recipient";
}
pub relation ten_percent_shareholder_871h3B(recipient: us.irc.core::Individual, item_id: Text) kind institutional {
    label en official "the recipient is a 10-percent shareholder of the issuer (section 871(h)(3)(B))";
}
@source(IRC_S871_H, relation = formalizes, coverage = exact, quote = "(i) in the case of an obligation issued by a corporation, any person who owns 10 percent or more of the total combined voting power of all classes of stock of such corporation entitled to vote, or")
rule S871H3BiCorporateIssuerTenPercent defeasible {
    for recipient: us.irc.core::Individual;
    for item_id: Text;
    for pct: Decimal;
    when voting_power_percentage_of_corporate_issuer_871h3Bi(recipient, item_id, pct)
     and pct >= 10.0;
    then ten_percent_shareholder_871h3B(recipient, item_id);
}
@source(IRC_S871_H, relation = formalizes, coverage = exact, quote = "(ii) in the case of an obligation issued by a partnership, any person who owns 10 percent or more of the capital or profits interest in such partnership.")
rule S871H3BiiPartnershipIssuerTenPercent defeasible {
    for recipient: us.irc.core::Individual;
    for item_id: Text;
    for pct: Decimal;
    when capital_or_profits_percentage_of_partnership_issuer_871h3Bii(recipient, item_id, pct)
     and pct >= 10.0;
    then ten_percent_shareholder_871h3B(recipient, item_id);
}

// --- §871(h)(4): contingent interest ----------------------------------------------

pub relation interest_determined_by_reference_871h4Ai(item_id: Text, basis: Text) kind empirical {
    label en official "the amount of the interest is determined by reference to: `receipts_or_cash_flow`, `income_or_profits`, `change_in_property_value` or `dividends_or_distributions` of the debtor or a related person";
}
pub relation contingent_interest_identified_by_regulation_871h4Aii(item_id: Text) kind empirical {
    label en official "any other type of contingent interest identified by the Secretary by regulation, where denial is necessary or appropriate to prevent avoidance";
}
pub relation contingent_interest_exception_871h4C(item_id: Text, exception: Text) kind empirical {
    label en official "an exception of subparagraph (C) applies: `timing_contingency`, `nonrecourse`, `derived_from_other_interest`, `hedging_transaction`, `actively_traded_property` or `regulatory`";
}
pub relation fixed_term_debt_issue_871h4D(item_id: Text, issued_on: Date, binding_contract_in_effect_on_1993_04_07: Boolean) kind empirical {
    label en official "the date a fixed-term indebtedness was issued and whether it was issued under a written binding contract in effect on April 7, 1993 and at all times thereafter before issuance";
}
pub relation contingent_interest_denied_871h4A(item_id: Text) kind institutional {
    label en official "the interest is contingent interest excluded from portfolio interest (section 871(h)(4)(A)), subject to the exceptions of subparagraphs (C) and (D)";
}
@source(IRC_S871_H, relation = formalizes, coverage = exact, quote = "(i) any interest if the amount of such interest is determined by reference to—")
rule S871H4AiContingentByReference defeasible {
    for item_id: Text;
    for basis: Text;
    when interest_determined_by_reference_871h4Ai(item_id, basis);
    unless contingent_interest_exception_871h4C(item_id, _)
     and interest_determined_by_reference_871h4Ai(item_id, basis);
    unless fixed_term_debt_issue_871h4D(item_id, _, _)
     and interest_determined_by_reference_871h4Ai(item_id, basis)
     and grandfathered_fixed_term_debt_871h4D(item_id);
    then contingent_interest_denied_871h4A(item_id);
}
pub relation grandfathered_fixed_term_debt_871h4D(item_id: Text) kind institutional {
    label en official "indebtedness with a fixed term issued on or before April 7, 1993, or after that date under a written binding contract in effect on that date (section 871(h)(4)(D))";
}
@source(IRC_S871_H, relation = formalizes, coverage = exact, quote = "(i) which was issued on or before April 7, 1993, or")
rule S871H4DiIssuedOnOrBefore19930407 defeasible {
    for item_id: Text;
    for issued_on: Date;
    for contract: Boolean;
    when fixed_term_debt_issue_871h4D(item_id, issued_on, contract)
     and issued_on <= @1993-04-07;
    then grandfathered_fixed_term_debt_871h4D(item_id);
}
@source(IRC_S871_H, relation = formalizes, coverage = exact, quote = "(ii) which was issued after such date pursuant to a written binding contract in effect on such date and at all times thereafter before such indebtedness was issued.")
rule S871H4DiiIssuedUnderBindingContract defeasible {
    for item_id: Text;
    for issued_on: Date;
    for contract: Boolean;
    when fixed_term_debt_issue_871h4D(item_id, issued_on, contract)
     and issued_on > @1993-04-07
     and contract == true;
    then grandfathered_fixed_term_debt_871h4D(item_id);
}
@source(IRC_S871_H, relation = formalizes, coverage = exact, quote = "(ii) any other type of contingent interest that is identified by the Secretary by regulation, where a denial of the portfolio interest exemption is necessary or appropriate to prevent avoidance of")
rule S871H4AiiRegulatoryContingentInterest defeasible {
    for item_id: Text;
    when contingent_interest_identified_by_regulation_871h4Aii(item_id);
    then contingent_interest_denied_871h4A(item_id);
}

// --- §871(h)(5): the statement -----------------------------------------------------

pub relation statement_made_by_871h5(item_id: Text, maker: Text) kind empirical {
    label en official "who made the beneficial-owner statement: `beneficial_owner` or `clearing_organization_or_financial_institution` (a securities clearing organization, bank or other institution holding customers' securities in the ordinary course)";
}
pub relation secretary_published_disqualifying_determination_871h5(item_id: Text, published_on: Date) kind empirical {
    label en official "the Secretary published a determination that statements from the person (or class) do not meet the requirements, on this date";
}
pub relation interest_payment_date_871h5(item_id: Text, paid_on: Date) kind empirical {
    label en official "the date the interest was paid";
}
pub relation statement_meets_requirements_871h5(item_id: Text) kind institutional {
    label en official "the statement meets the requirements of paragraph (5): made by the beneficial owner or by a clearing organization, bank or other financial institution, and not disqualified by a determination published at least one month before payment";
}
@source(IRC_S871_H, relation = formalizes, coverage = exact, quote = "(A) the beneficial owner of such obligation, or")
rule S871H5BeneficialOwnerStatement defeasible {
    for item_id: Text;
    when statement_made_by_871h5(item_id, "beneficial_owner");
    unless statement_disqualified_871h5(item_id);
    then statement_meets_requirements_871h5(item_id);
}
@source(IRC_S871_H, relation = formalizes, coverage = exact, quote = "(B) a securities clearing organization, a bank, or other financial institution that holds customers' securities in the ordinary course of its trade or business.")
rule S871H5InstitutionStatement defeasible {
    for item_id: Text;
    when statement_made_by_871h5(item_id, "clearing_organization_or_financial_institution");
    unless statement_disqualified_871h5(item_id);
    then statement_meets_requirements_871h5(item_id);
}
pub relation statement_disqualified_871h5(item_id: Text) kind institutional {
    label en official "the Secretary published, at least one month before the payment, a determination that the statement does not meet the requirements (section 871(h)(5), last sentence)";
}
@source(IRC_S871_H, relation = formalizes, coverage = exact, quote = "The preceding sentence shall not apply to any statement with respect to payment of interest on any obligation by any person if, at least one month before such payment, the Secretary has published a")
rule S871H5DisqualifiedByPublishedDetermination defeasible {
    for item_id: Text;
    for published: Date;
    for paid: Date;
    when secretary_published_disqualifying_determination_871h5(item_id, published)
     and interest_payment_date_871h5(item_id, paid)
     and add_calendar_period(published, 1 calendar_month) <= paid;
    then statement_disqualified_871h5(item_id);
}

// --- §871(h)(6): inadequate exchange of information ---------------------------------

pub relation secretary_determines_inadequate_exchange_871h6(country: Text, begins_on: Date) kind empirical {
    label en official "the Secretary determines, in writing with a published statement, that the exchange of information between the United States and the country is inadequate to prevent evasion by United States persons, from the date specified";
}
pub relation portfolio_interest_unavailable_for_country_871h6(country: Text, begins_on: Date) kind institutional {
    label en official "the portfolio interest exemption does not apply to payments of interest to persons within the country from the specified date until the Secretary determines that exchange is adequate (section 871(h)(6)(A))";
}
@source(IRC_S871_H, relation = formalizes, coverage = exact, quote = "If the Secretary determines that the exchange of information between the United States and a foreign country is inadequate to prevent evasion of the United States income tax by United States persons,")
rule S871H6AInadequateExchangeDetermination defeasible {
    for country: Text;
    for begins_on: Date;
    when secretary_determines_inadequate_exchange_871h6(country, begins_on);
    then power S871H6DeterminationPower {
        holder us.irc.international::Secretary;
        over us.irc.international::Secretary;
        exercise secretary_determines_inadequate_exchange_871h6(country, begins_on);
        valid_when exchange_of_information_inadequate_871h6(country);
        effect create(portfolio_interest_unavailable_for_country_871h6(country, begins_on));
    };
}
pub relation exchange_of_information_inadequate_871h6(country: Text) kind empirical {
    label en official "the exchange of information between the United States and the foreign country is inadequate to prevent evasion of United States income tax by United States persons";
}
pub relation interest_paid_within_country_871h6(item_id: Text, country: Text, paid_on: Date, obligation_issued_on: Date) kind empirical {
    label en official "interest paid to a person within the foreign country (or addressed to persons within it), the payment date and the obligation's issue date";
}
pub relation exchange_of_information_adequate_from_871h6(country: Text, ended_on: Date) kind empirical {
    label en official "the date the Secretary determines that the exchange of information is adequate (the end of the period)";
}
pub relation determination_published_on_871h6(country: Text, published_on: Date) kind empirical {
    label en official "the date the Secretary's determination was published";
}
pub relation portfolio_interest_denied_by_871h6(item_id: Text) kind institutional {
    label en official "the interest is paid within the period of an inadequate-exchange determination and on an obligation issued after the determination's publication: portfolio interest is denied (section 871(h)(6))";
}
@source(IRC_S871_H, relation = formalizes, coverage = exact, quote = "Subparagraph (A) shall not apply to the payment of interest on any obligation which is issued on or before the date of the publication of the Secretary's determination under such subparagraph.")
rule S871H6DeniedWithinPeriod defeasible {
    for item_id: Text;
    for country: Text;
    for begins_on: Date;
    for paid_on: Date;
    for issued_on: Date;
    for published_on: Date;
    when portfolio_interest_unavailable_for_country_871h6(country, begins_on)
     and interest_paid_within_country_871h6(item_id, country, paid_on, issued_on)
     and determination_published_on_871h6(country, published_on)
     and paid_on >= begins_on
     and issued_on > published_on;
    unless exchange_of_information_adequate_from_871h6(country, _)
     and interest_paid_within_country_871h6(item_id, country, paid_on, issued_on)
     and adequacy_ended_before_871h6(item_id);
    then portfolio_interest_denied_by_871h6(item_id);
}
pub relation adequacy_ended_before_871h6(item_id: Text) kind institutional {
    label en official "the payment date is after the date the Secretary determined that exchange of information was adequate";
}
rule S871H6AdequacyEnded defeasible {
    for item_id: Text;
    for country: Text;
    for paid_on: Date;
    for issued_on: Date;
    for ended_on: Date;
    when interest_paid_within_country_871h6(item_id, country, paid_on, issued_on)
     and exchange_of_information_adequate_from_871h6(country, ended_on)
     and paid_on > ended_on;
    then adequacy_ended_before_871h6(item_id);
}

// --- §871(i)(2)(B)-(D), (i)(3) --------------------------------------------------------

pub relation payment_by_existing_80_20_company_871i2B(recipient: us.irc.core::Individual, item_id: Text, company: us.irc.core::Corporation, amount: Money) kind empirical {
    label en official "a dividend or interest paid by an existing 80/20 company to the recipient";
}
pub relation exempt_amount_871i2B(recipient: us.irc.core::Individual, item_id: Text, exempt: Money) kind institutional {
    label en official "the active foreign business percentage of the dividend or interest paid by an existing 80/20 company is exempt from the tax under paragraph (1)(A) or (1)(C) of subsection (a) (section 871(i)(2)(B))";
}
@source(IRC_S871_I, relation = formalizes, coverage = exact, quote = "(B) The active foreign business percentage of—")
rule S871I2BActiveForeignBusinessPercentageExempt defeasible {
    for recipient: us.irc.core::Individual;
    for item_id: Text;
    for company: us.irc.core::Corporation;
    for amount: Money;
    for pct: Decimal;
    when payment_by_existing_80_20_company_871i2B(recipient, item_id, company, amount)
     and active_foreign_business_percentage_871l2(company, pct);
    then exempt_amount_871i2B(recipient, item_id, round(amount * pct, 2, "HALF_UP"));
}
pub relation income_of_foreign_central_bank_from_bankers_acceptances_871i2C(recipient: us.irc.core::Individual, item_id: Text) kind empirical {
    label en official "income derived by a foreign central bank of issue from bankers' acceptances";
}
@source(IRC_S871_I, relation = formalizes, coverage = exact, quote = "(C) Income derived by a foreign central bank of issue from bankers' acceptances.")
rule S871I2CCentralBankAcceptancesExempt defeasible {
    for recipient: us.irc.core::Individual;
    for item_id: Text;
    when income_of_foreign_central_bank_from_bankers_acceptances_871i2C(recipient, item_id);
    then exempt_from_871a_tax(recipient, item_id);
}
pub relation dividend_of_foreign_corporation_us_source_861a2B_871i2D(recipient: us.irc.core::Individual, item_id: Text) kind empirical {
    label en official "a dividend paid by a foreign corporation which is treated under section 861(a)(2)(B) as income from sources within the United States";
}
@source(IRC_S871_I, relation = formalizes, coverage = exact, quote = "(D) Dividends paid by a foreign corporation which are treated under section 861(a)(2)(B) as income from sources within the United States.")
rule S871I2DForeignCorporationUsSourceDividendExempt defeasible {
    for recipient: us.irc.core::Individual;
    for item_id: Text;
    when dividend_of_foreign_corporation_us_source_861a2B_871i2D(recipient, item_id);
    then exempt_from_871a_tax(recipient, item_id);
}
pub relation amount_deposit_with_banking_business_871i3A(item_id: Text) kind empirical {
    label en official "deposits with persons carrying on the banking business";
}
pub relation amount_savings_institution_account_deductible_591_871i3B(item_id: Text) kind empirical {
    label en official "deposits or withdrawable accounts with a chartered and supervised savings institution, to the extent the amounts paid or credited are deductible under section 591 (without regard to sections 265 and 291)";
}
pub relation amount_held_by_insurance_company_under_interest_agreement_871i3C(item_id: Text) kind empirical {
    label en official "amounts held by an insurance company under an agreement to pay interest thereon";
}
pub relation deposits_871i3(item_id: Text) kind institutional {
    label en official "deposits for purposes of section 871(i)(2): banking-business deposits, savings-institution accounts and insurance company interest-agreement amounts (section 871(i)(3))";
}
@source(IRC_S871_I, relation = formalizes, coverage = exact, quote = "(A) deposits with persons carrying on the banking business,")
rule S871I3ABankDeposits defeasible {
    for item_id: Text;
    when amount_deposit_with_banking_business_871i3A(item_id);
    then deposits_871i3(item_id);
}
@source(IRC_S871_I, relation = formalizes, coverage = exact, quote = "(B) deposits or withdrawable accounts with savings institutions chartered and supervised as savings and loan or similar associations under Federal or State law, but only to the extent that amounts")
rule S871I3BSavingsInstitutionAccounts defeasible {
    for item_id: Text;
    when amount_savings_institution_account_deductible_591_871i3B(item_id);
    then deposits_871i3(item_id);
}
@source(IRC_S871_I, relation = formalizes, coverage = exact, quote = "(C) amounts held by an insurance company under an agreement to pay interest thereon.")
rule S871I3CInsuranceInterestAgreement defeasible {
    for item_id: Text;
    when amount_held_by_insurance_company_under_interest_agreement_871i3C(item_id);
    then deposits_871i3(item_id);
}

// --- §871(j): gambling winnings -------------------------------------------------------

pub relation wager_proceeds_in_named_game_871j(recipient: us.irc.core::Individual, item_id: Text) kind empirical {
    label en official "the proceeds from a wager placed in blackjack, baccarat, craps, roulette or big-6 wheel";
}
pub relation collection_administratively_feasible_by_regulation_871j(item_id: Text) kind empirical {
    label en official "the Secretary determines by regulation that collection of the tax is administratively feasible";
}
@source(IRC_S871_J, relation = formalizes, coverage = exact, quote = "No tax shall be imposed under paragraph (1)(A) of subsection (a) on the proceeds from a wager placed in any of the following games: blackjack, baccarat, craps, roulette, or big-6 wheel. The preceding")
rule S871JNamedGamesWagerProceedsExempt defeasible {
    for recipient: us.irc.core::Individual;
    for item_id: Text;
    when wager_proceeds_in_named_game_871j(recipient, item_id);
    unless collection_administratively_feasible_by_regulation_871j(item_id)
     and wager_proceeds_in_named_game_871j(recipient, item_id);
    then exempt_from_871a_tax(recipient, item_id);
}

// --- §871(k)(1): interest-related dividends ------------------------------------------

pub relation ric_dividend_reported_as_interest_related_871k1(recipient: us.irc.core::Individual, item_id: Text, ric: us.irc.core::Corporation) kind empirical {
    label en official "an interest-related dividend received from a regulated investment company which meets the requirements of section 852(a) for the year";
}
pub relation dividend_attributable_to_interest_of_ten_percent_issuer_871k1Bi(recipient: us.irc.core::Individual, item_id: Text) kind empirical {
    label en official "the dividend is attributable to interest received by the company on indebtedness issued by the recipient or by a corporation or partnership of which the recipient is a 10-percent shareholder";
}
pub relation shareholder_statement_non_us_871k1Bii(item_id: Text) kind empirical {
    label en official "the withholding agent received a statement, meeting requirements similar to subsection (h)(5), that the beneficial owner of the stock is not a United States person";
}
pub relation dividend_paid_in_871h6_country_871k1Biii(item_id: Text) kind empirical {
    label en official "the dividend was paid to a person within a foreign country during a period described in subsection (h)(6), on stock not acquired before the publication of the determination";
}
@source(IRC_S871_K, relation = formalizes, coverage = exact, quote = "Except as provided in subparagraph (B), no tax shall be imposed under paragraph (1)(A) of subsection (a) on any interest-related dividend received from a regulated investment company which meets the")
rule S871K1AInterestRelatedDividendExempt defeasible {
    for recipient: us.irc.core::Individual;
    for item_id: Text;
    for ric: us.irc.core::Corporation;
    when ric_dividend_reported_as_interest_related_871k1(recipient, item_id, ric)
     and shareholder_statement_non_us_871k1Bii(item_id);
    unless dividend_attributable_to_interest_of_ten_percent_issuer_871k1Bi(recipient, item_id)
     and ric_dividend_reported_as_interest_related_871k1(recipient, item_id, ric);
    unless dividend_paid_in_871h6_country_871k1Biii(item_id)
     and ric_dividend_reported_as_interest_related_871k1(recipient, item_id, ric);
    then exempt_from_871a_tax(recipient, item_id);
}
pub relation ric_qualified_interest_income_components_871k1E(ric: us.irc.core::Corporation, y: us.irc.core::TaxableYear, short_term_oid: Money, registered_form_interest: Money, deposit_interest: Money, interest_related_dividends_from_other_ric: Money) kind empirical {
    label en official "the four kinds of qualified interest income of the company from sources within the United States: short-term original issue discount, registered-form interest (net of interest on debt of a 10-percent shareholder and non-portfolio interest), deposit interest and interest-related dividends of another regulated investment company";
}
pub relation ric_qualified_interest_income_871k1E(ric: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the qualified interest income of the regulated investment company: the sum of the amounts of clauses (i) to (iv) (section 871(k)(1)(E))";
}
@source(IRC_S871_K, relation = formalizes, coverage = exact, quote = "For purposes of subparagraph (D), the term \"qualified interest income\" means the sum of the following amounts derived by the regulated investment company from sources within the United States:")
rule S871K1EQualifiedInterestIncome defeasible {
    for ric: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for a: Money;
    for b: Money;
    for c: Money;
    for d: Money;
    when ric_qualified_interest_income_components_871k1E(ric, y, a, b, c, d);
    then ric_qualified_interest_income_871k1E(ric, y, a + b + c + d);
}
pub relation ric_deductions_allocable_to_qualified_interest_871k1D(ric: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the deductions properly allocable to the qualified interest income";
}
pub relation ric_qualified_net_interest_income_871k1D(ric: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "qualified net interest income: qualified interest income reduced by the deductions properly allocable to it (section 871(k)(1)(D))";
}
@source(IRC_S871_K, relation = formalizes, coverage = exact, quote = "For purposes of subparagraph (C), the term \"qualified net interest income\" means the qualified interest income of the regulated investment company reduced by the deductions properly allocable to such")
rule S871K1DQualifiedNetInterestIncome defeasible {
    for ric: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for income: Money;
    for deductions: Money;
    when ric_qualified_interest_income_871k1E(ric, y, income)
     and ric_deductions_allocable_to_qualified_interest_871k1D(ric, y, deductions);
    then ric_qualified_net_interest_income_871k1D(ric, y, income - deductions);
}
pub relation ric_reported_interest_related_dividend_871k1Civ(ric: us.irc.core::Corporation, y: us.irc.core::TaxableYear, dividend_id: Text, reported_amount: Money, aggregate_reported_amount: Money) kind empirical {
    label en official "the reported interest related dividend amount of a dividend and the aggregate reported amount of interest related dividends for the year";
}
pub relation interest_related_dividend_amount_871k1C(ric: us.irc.core::Corporation, y: us.irc.core::TaxableYear, dividend_id: Text, amount: Money) kind institutional {
    label en official "the interest related dividend: the reported amount, or (if the aggregate reported amount exceeds qualified net interest income) the reported amount reduced by its ratable part of the excess reported amount (section 871(k)(1)(C))";
}
@source(IRC_S871_K, relation = formalizes, coverage = exact, quote = "Except as provided in clause (ii), an interest related dividend is any dividend, or part thereof, which is reported by the company as an interest related dividend in written statements furnished to")
rule S871K1CiReportedAmountWithinQualifiedIncome defeasible {
    for ric: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for dividend_id: Text;
    for reported: Money;
    for aggregate: Money;
    for qni: Money;
    when ric_reported_interest_related_dividend_871k1Civ(ric, y, dividend_id, reported, aggregate)
     and ric_qualified_net_interest_income_871k1D(ric, y, qni)
     and aggregate <= qni;
    then interest_related_dividend_amount_871k1C(ric, y, dividend_id, reported);
}
@source(IRC_S871_K, relation = formalizes, coverage = exact, quote = "If the aggregate reported amount with respect to the company for any taxable year exceeds the qualified net interest income of the company for such taxable year, an interest related dividend is the")
rule S871K1CiiReportedAmountExceedsQualifiedIncome defeasible {
    for ric: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for dividend_id: Text;
    for reported: Money;
    for aggregate: Money;
    for qni: Money;
    when ric_reported_interest_related_dividend_871k1Civ(ric, y, dividend_id, reported, aggregate)
     and ric_qualified_net_interest_income_871k1D(ric, y, qni)
     and aggregate > qni
     and aggregate > 0.00 USD;
    unless post_december_special_rule_applies_871k1Ciii(ric, y)
     and ric_reported_interest_related_dividend_871k1Civ(ric, y, dividend_id, reported, aggregate)
     and ric_qualified_net_interest_income_871k1D(ric, y, qni);
    then interest_related_dividend_amount_871k1C(ric, y, dividend_id, round(reported - reported * ((aggregate - qni) / aggregate), 2, "HALF_UP"));
}

// --- §871(k)(2): short-term capital gain dividends -------------------------------------

pub relation ric_short_term_capital_gain_dividend_reported_871k2(recipient: us.irc.core::Individual, item_id: Text, ric: us.irc.core::Corporation) kind empirical {
    label en official "a short-term capital gain dividend received from a regulated investment company which meets the requirements of section 852(a) for the year";
}
pub relation recipient_subject_to_tax_under_871a2_871k2B(recipient: us.irc.core::Individual) kind empirical {
    label en official "the recipient is a nonresident alien individual subject to tax under subsection (a)(2)";
}
@source(IRC_S871_K, relation = formalizes, coverage = exact, quote = "Except as provided in subparagraph (B), no tax shall be imposed under paragraph (1)(A) of subsection (a) on any short-term capital gain dividend received from a regulated investment company which")
rule S871K2AShortTermCapitalGainDividendExempt defeasible {
    for recipient: us.irc.core::Individual;
    for item_id: Text;
    for ric: us.irc.core::Corporation;
    when ric_short_term_capital_gain_dividend_reported_871k2(recipient, item_id, ric);
    unless recipient_subject_to_tax_under_871a2_871k2B(recipient)
     and ric_short_term_capital_gain_dividend_reported_871k2(recipient, item_id, ric);
    then exempt_from_871a_tax(recipient, item_id);
}
pub relation ric_net_short_term_gain_and_long_term_loss_871k2D(ric: us.irc.core::Corporation, y: us.irc.core::TaxableYear, net_short_term_gain: Money, net_long_term_loss: Money) kind empirical {
    label en official "the net short-term capital gain of the company (counting short-term capital gain dividends from another regulated investment company as short-term gain) and its net long-term capital loss";
}
pub relation ric_qualified_short_term_gain_871k2D(ric: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the qualified short-term gain: the excess of the net short-term capital gain over the net long-term capital loss (section 871(k)(2)(D))";
}
@source(IRC_S871_K, relation = formalizes, coverage = exact, quote = "For purposes of subparagraph (C), the term \"qualified short-term gain\" means the excess of the net short-term capital gain of the regulated investment company for the taxable year over the net")
rule S871K2DQualifiedShortTermGain defeasible {
    for ric: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for gain: Money;
    for loss: Money;
    when ric_net_short_term_gain_and_long_term_loss_871k2D(ric, y, gain, loss)
     and gain > loss;
    then ric_qualified_short_term_gain_871k2D(ric, y, gain - loss);
}
rule S871K2DQualifiedShortTermGainZero defeasible {
    for ric: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for gain: Money;
    for loss: Money;
    when ric_net_short_term_gain_and_long_term_loss_871k2D(ric, y, gain, loss)
     and gain <= loss;
    then ric_qualified_short_term_gain_871k2D(ric, y, 0.00 USD);
}
pub relation ric_reported_short_term_capital_gain_dividend_871k2civ(ric: us.irc.core::Corporation, y: us.irc.core::TaxableYear, dividend_id: Text, reported_amount: Money, aggregate_reported_amount: Money) kind empirical {
    label en official "the reported short-term capital gain dividend amount of a dividend and the aggregate reported amount for the year";
}
pub relation short_term_capital_gain_dividend_amount_871k2C(ric: us.irc.core::Corporation, y: us.irc.core::TaxableYear, dividend_id: Text, amount: Money) kind institutional {
    label en official "the short-term capital gain dividend: the reported amount, or (if the aggregate reported amount exceeds the qualified short-term gain) the reported amount reduced by its ratable part of the excess (section 871(k)(2)(C))";
}
@source(IRC_S871_K, relation = formalizes, coverage = exact, quote = "Except as provided in clause (ii), the term \"short-term capital gain dividend\" means any dividend, or part thereof, which is reported by the company as a short-term capital gain dividend in written")
rule S871K2CiReportedAmountWithinQualifiedGain defeasible {
    for ric: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for dividend_id: Text;
    for reported: Money;
    for aggregate: Money;
    for qsg: Money;
    when ric_reported_short_term_capital_gain_dividend_871k2civ(ric, y, dividend_id, reported, aggregate)
     and ric_qualified_short_term_gain_871k2D(ric, y, qsg)
     and aggregate <= qsg;
    then short_term_capital_gain_dividend_amount_871k2C(ric, y, dividend_id, reported);
}
@source(IRC_S871_K, relation = formalizes, coverage = exact, quote = "If the aggregate reported amount with respect to the company for any taxable year exceeds the qualified short-term gain of the company for such taxable year, the term \"short-term capital gain")
rule S871K2CiiReportedAmountExceedsQualifiedGain defeasible {
    for ric: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for dividend_id: Text;
    for reported: Money;
    for aggregate: Money;
    for qsg: Money;
    when ric_reported_short_term_capital_gain_dividend_871k2civ(ric, y, dividend_id, reported, aggregate)
     and ric_qualified_short_term_gain_871k2D(ric, y, qsg)
     and aggregate > qsg
     and aggregate > 0.00 USD;
    then short_term_capital_gain_dividend_amount_871k2C(ric, y, dividend_id, round(reported - reported * ((aggregate - qsg) / aggregate), 2, "HALF_UP"));
}
pub relation distribution_outside_897_by_897h1_second_sentence_871k2E(recipient: us.irc.core::Individual, item_id: Text, amount: Money) kind empirical {
    label en official "a distribution to which section 897 does not apply by reason of the second sentence of section 897(h)(1), the amount of which would otherwise be a short-term capital gain dividend";
}
pub relation included_as_dividend_from_ric_871k2E(recipient: us.irc.core::Individual, item_id: Text, amount: Money) kind institutional {
    label en official "the amount is not a short-term capital gain dividend and is included in the shareholder's gross income as a dividend from the regulated investment company (section 871(k)(2)(E))";
}
@source(IRC_S871_K, relation = formalizes, coverage = exact, quote = "In the case of a distribution to which section 897 does not apply by reason of the second sentence of section 897(h)(1), the amount which would be treated as a short-term capital gain dividend to the")
rule S871K2EIncludedAsDividend defeasible {
    for recipient: us.irc.core::Individual;
    for item_id: Text;
    for amount: Money;
    when distribution_outside_897_by_897h1_second_sentence_871k2E(recipient, item_id, amount);
    then included_as_dividend_from_ric_871k2E(recipient, item_id, amount);
}

// --- §871(l): existing 80/20 company ----------------------------------------------------

pub relation company_met_861c1_requirements_pre2011_871l1Ai(company: us.irc.core::Corporation) kind empirical {
    label en official "the corporation met the 80-percent foreign business requirements of section 861(c)(1) (as in effect before the enactment) for its last taxable year beginning before January 1, 2011";
}
pub relation testing_period_income_871l1B(company: us.irc.core::Corporation, active_foreign_business_income: Money, gross_income_all_sources: Money) kind empirical {
    label en official "the active foreign business income (gross income from sources outside the United States attributable to the active conduct of a trade or business in a foreign country or possession) and gross income from all sources of the company for the testing period";
}
pub relation substantial_line_of_business_added_871l1Aiii(company: us.irc.core::Corporation) kind empirical {
    label en official "there has been an addition of a substantial line of business with respect to the corporation after the date of the enactment";
}
pub relation company_meets_80_percent_foreign_business_requirements_871l1B(company: us.irc.core::Corporation) kind institutional {
    label en official "at least 80 percent of the gross income from all sources of the corporation for the testing period is active foreign business income (section 871(l)(1)(B)(i))";
}
@source(IRC_S871_L, relation = formalizes, coverage = exact, quote = "Except as provided in clause (iv), a corporation meets the 80-percent foreign business requirements of this subparagraph if it is shown to the satisfaction of the Secretary that at least 80 percent")
rule S871L1BiEightyPercentRequirement defeasible {
    for company: us.irc.core::Corporation;
    for afbi: Money;
    for gross: Money;
    when testing_period_income_871l1B(company, afbi, gross)
     and gross > 0.00 USD
     and afbi >= gross * 0.80;
    then company_meets_80_percent_foreign_business_requirements_871l1B(company);
}
pub relation existing_80_20_company_871l1A(company: us.irc.core::Corporation) kind institutional {
    label en official "an existing 80/20 company (section 871(l)(1)(A))";
}
@source(IRC_S871_L, relation = formalizes, coverage = exact, quote = "The term \"existing 80/20 company\" means any corporation if—")
rule S871L1AExisting8020Company defeasible {
    for company: us.irc.core::Corporation;
    when company_met_861c1_requirements_pre2011_871l1Ai(company)
     and company_meets_80_percent_foreign_business_requirements_871l1B(company);
    unless substantial_line_of_business_added_871l1Aiii(company)
     and company_met_861c1_requirements_pre2011_871l1Ai(company);
    then existing_80_20_company_871l1A(company);
}
pub relation active_foreign_business_percentage_871l2(company: us.irc.core::Corporation, percentage: Decimal) kind institutional {
    label en official "the percentage which the active foreign business income of the existing 80/20 company for the testing period is of its gross income from all sources for the period (section 871(l)(2))";
}
@source(IRC_S871_L, relation = formalizes, coverage = exact, quote = "Except as provided in paragraph (1)(B)(iv), the term \"active foreign business percentage\" means, with respect to any existing 80/20 company, the percentage which—")
rule S871L2ActiveForeignBusinessPercentage defeasible {
    for company: us.irc.core::Corporation;
    for afbi: Money;
    for gross: Money;
    when existing_80_20_company_871l1A(company)
     and testing_period_income_871l1B(company, afbi, gross)
     and gross > 0.00 USD;
    then active_foreign_business_percentage_871l2(company, afbi / gross);
}

// --- §871(m): dividend equivalents -------------------------------------------------------

pub relation substitute_dividend_contingent_on_us_dividend_871m2A(payment_id: Text) kind empirical {
    label en official "a substitute dividend made pursuant to a securities lending or sale-repurchase transaction that is (directly or indirectly) contingent upon or determined by reference to the payment of a dividend from sources within the United States";
}
pub relation specified_npc_payment_contingent_on_us_dividend_871m2B(payment_id: Text, contract_id: Text) kind empirical {
    label en official "a payment under a specified notional principal contract that is (directly or indirectly) contingent upon or determined by reference to the payment of a dividend from sources within the United States";
}
pub relation secretary_determines_substantially_similar_871m2C(payment_id: Text) kind empirical {
    label en official "the Secretary determines that the payment is substantially similar to a payment described in subparagraph (A) or (B)";
}
pub relation dividend_equivalent_871m2(payment_id: Text) kind institutional {
    label en official "a dividend equivalent (section 871(m)(2))";
}
@source(IRC_S871_M, relation = formalizes, coverage = exact, quote = "(A) any substitute dividend made pursuant to a securities lending or a sale-repurchase transaction that (directly or indirectly) is contingent upon, or determined by reference to, the payment of a")
rule S871M2ASubstituteDividend defeasible {
    for payment_id: Text;
    when substitute_dividend_contingent_on_us_dividend_871m2A(payment_id);
    then dividend_equivalent_871m2(payment_id);
}
@source(IRC_S871_M, relation = formalizes, coverage = exact, quote = "(B) any payment made pursuant to a specified notional principal contract that (directly or indirectly) is contingent upon, or determined by reference to, the payment of a dividend from sources within")
rule S871M2BSpecifiedNpcPayment defeasible {
    for payment_id: Text;
    for contract_id: Text;
    when specified_npc_payment_contingent_on_us_dividend_871m2B(payment_id, contract_id)
     and specified_notional_principal_contract_871m3(contract_id);
    then dividend_equivalent_871m2(payment_id);
}
@source(IRC_S871_M, relation = formalizes, coverage = exact, quote = "(C) any other payment determined by the Secretary to be substantially similar to a payment described in subparagraph (A) or (B).")
rule S871M2CSecretaryDeterminedSimilar defeasible {
    for payment_id: Text;
    when secretary_determines_substantially_similar_871m2C(payment_id);
    then dividend_equivalent_871m2(payment_id);
}
pub relation dividend_equivalent_us_source_dividend_871m1(payment_id: Text) kind institutional {
    label en official "a dividend equivalent is treated as a dividend from sources within the United States for subsection (a), sections 881 and 4948(a), and chapters 3 and 4 (section 871(m)(1))";
}
@source(IRC_S871_M, relation = formalizes, coverage = exact, quote = "For purposes of subsection (a), sections 881 and 4948(a), and chapters 3 and 4, a dividend equivalent shall be treated as a dividend from sources within the United States.")
rule S871M1DividendEquivalentIsUsSourceDividend defeasible {
    for payment_id: Text;
    when dividend_equivalent_871m2(payment_id);
    then dividend_equivalent_us_source_dividend_871m1(payment_id);
}
pub relation notional_principal_contract_871m3(contract_id: Text) kind empirical {
    label en official "a notional principal contract";
}
pub relation npc_long_party_transfers_underlying_on_entry_871m3Ai(contract_id: Text) kind empirical {
    label en official "in connection with entering into the contract, a long party transfers the underlying security to a short party";
}
pub relation npc_short_party_transfers_underlying_on_termination_871m3Aii(contract_id: Text) kind empirical {
    label en official "in connection with the termination of the contract, a short party transfers the underlying security to a long party";
}
pub relation npc_underlying_security_not_readily_tradable_871m3Aiii(contract_id: Text) kind empirical {
    label en official "the underlying security is not readily tradable on an established securities market";
}
pub relation npc_underlying_security_posted_as_collateral_871m3Aiv(contract_id: Text) kind empirical {
    label en official "in connection with entering into the contract, the underlying security is posted as collateral by a short party with a long party";
}
pub relation npc_identified_by_secretary_871m3Av(contract_id: Text) kind empirical {
    label en official "the contract is identified by the Secretary as a specified notional principal contract";
}
pub relation npc_payment_made_on(contract_id: Text, paid_on: Date) kind empirical {
    label en unofficial "the date a payment is made under the notional principal contract (a domain anchor for section 871(m)(3)(B))";
}
pub relation secretary_determines_no_avoidance_potential_871m3B(contract_id: Text) kind empirical {
    label en official "the Secretary determines that the contract is of a type which does not have the potential for tax avoidance";
}
pub relation specified_notional_principal_contract_871m3(contract_id: Text) kind institutional {
    label en official "a specified notional principal contract (section 871(m)(3))";
}
@source(IRC_S871_M, relation = formalizes, coverage = exact, quote = "(i) in connection with entering into such contract, any long party to the contract transfers the underlying security to any short party to the contract,")
rule S871M3AiLongPartyTransfersUnderlying defeasible {
    for contract_id: Text;
    when notional_principal_contract_871m3(contract_id)
     and npc_long_party_transfers_underlying_on_entry_871m3Ai(contract_id);
    then specified_notional_principal_contract_871m3(contract_id);
}
@source(IRC_S871_M, relation = formalizes, coverage = exact, quote = "(ii) in connection with the termination of such contract, any short party to the contract transfers the underlying security to any long party to the contract,")
rule S871M3AiiShortPartyTransfersUnderlying defeasible {
    for contract_id: Text;
    when notional_principal_contract_871m3(contract_id)
     and npc_short_party_transfers_underlying_on_termination_871m3Aii(contract_id);
    then specified_notional_principal_contract_871m3(contract_id);
}
@source(IRC_S871_M, relation = formalizes, coverage = exact, quote = "(iii) the underlying security is not readily tradable on an established securities market,")
rule S871M3AiiiUnderlyingNotReadilyTradable defeasible {
    for contract_id: Text;
    when notional_principal_contract_871m3(contract_id)
     and npc_underlying_security_not_readily_tradable_871m3Aiii(contract_id);
    then specified_notional_principal_contract_871m3(contract_id);
}
@source(IRC_S871_M, relation = formalizes, coverage = exact, quote = "(iv) in connection with entering into such contract, the underlying security is posted as collateral by any short party to the contract with any long party to the contract, or")
rule S871M3AivUnderlyingPostedAsCollateral defeasible {
    for contract_id: Text;
    when notional_principal_contract_871m3(contract_id)
     and npc_underlying_security_posted_as_collateral_871m3Aiv(contract_id);
    then specified_notional_principal_contract_871m3(contract_id);
}
@source(IRC_S871_M, relation = formalizes, coverage = exact, quote = "(v) such contract is identified by the Secretary as a specified notional principal contract,")
rule S871M3AvIdentifiedBySecretary defeasible {
    for contract_id: Text;
    when notional_principal_contract_871m3(contract_id)
     and npc_identified_by_secretary_871m3Av(contract_id);
    then specified_notional_principal_contract_871m3(contract_id);
}
@source(IRC_S871_M, relation = formalizes, coverage = exact, quote = "(B) in the case of payments made after the date which is 2 years after the date of the enactment of this subsection, any notional principal contract unless the Secretary determines that such contract")
rule S871M3BAnyContractAfterTwoYears defeasible {
    for contract_id: Text;
    for paid_on: Date;
    when notional_principal_contract_871m3(contract_id)
     and npc_payment_made_on(contract_id, paid_on)
     and paid_on > add_calendar_period(@2010-03-18, 2 calendar_year);
    unless secretary_determines_no_avoidance_potential_871m3B(contract_id)
     and notional_principal_contract_871m3(contract_id)
     and npc_payment_made_on(contract_id, paid_on);
    then specified_notional_principal_contract_871m3(contract_id);
}
pub relation party_entitled_to_payment_contingent_on_us_dividend_871m4A(party: Text, contract_id: Text) kind empirical {
    label en official "the party is entitled to receive a payment under the contract that is contingent upon or determined by reference to the payment of a dividend from sources within the United States on the underlying security";
}
pub relation party_to_notional_principal_contract_871m4(party: Text, contract_id: Text) kind empirical {
    label en official "the party is a party to the notional principal contract";
}
pub relation long_party_871m4A(party: Text, contract_id: Text) kind institutional {
    label en official "a long party with respect to the underlying security (section 871(m)(4)(A))";
}
@source(IRC_S871_M, relation = formalizes, coverage = exact, quote = "The term \"long party\" means, with respect to any underlying security of any notional principal contract, any party to the contract which is entitled to receive any payment pursuant to such contract")
rule S871M4ALongParty defeasible {
    for party: Text;
    for contract_id: Text;
    when party_to_notional_principal_contract_871m4(party, contract_id)
     and party_entitled_to_payment_contingent_on_us_dividend_871m4A(party, contract_id);
    then long_party_871m4A(party, contract_id);
}
pub relation short_party_871m4B(party: Text, contract_id: Text) kind institutional {
    label en official "a short party: a party to the contract which is not a long party (section 871(m)(4)(B))";
}
@source(IRC_S871_M, relation = formalizes, coverage = exact, quote = "The term \"short party\" means, with respect to any underlying security of any notional principal contract, any party to the contract which is not a long party with respect to such underlying security.")
rule S871M4BShortParty defeasible {
    for party: Text;
    for contract_id: Text;
    when party_to_notional_principal_contract_871m4(party, contract_id);
    unless long_party_871m4A(party, contract_id)
     and party_to_notional_principal_contract_871m4(party, contract_id);
    then short_party_871m4B(party, contract_id);
}
pub relation chain_of_dividend_equivalents_tax_paid_or_not_due_871m6(chain_id: Text) kind empirical {
    label en official "the taxpayer establishes that the tax has been paid with respect to another dividend equivalent in the chain, or is not otherwise due";
}
pub relation dividend_equivalent_tax_reduced_871m6(chain_id: Text) kind institutional {
    label en official "the Secretary reduced the tax on a chain of dividend equivalents (section 871(m)(6))";
}
pub relation secretary_reduces_chain_tax_871m6(chain_id: Text) kind empirical {
    label en official "the Secretary reduces the tax on a chain of dividend equivalents one or more of which is subject to tax";
}
@source(IRC_S871_M, relation = formalizes, coverage = partial, quote = "In the case of any chain of dividend equivalents one or more of which is subject to tax under subsection (a) or section 881, the Secretary may reduce such tax, but only to the extent that the")
rule S871M6ChainReductionPower defeasible {
    for chain_id: Text;
    when secretary_reduces_chain_tax_871m6(chain_id);
    then power S871M6ChainTaxReductionPower {
        holder us.irc.international::Secretary;
        over us.irc.international::Secretary;
        exercise secretary_reduces_chain_tax_871m6(chain_id);
        valid_when chain_of_dividend_equivalents_tax_paid_or_not_due_871m6(chain_id);
        effect create(dividend_equivalent_tax_reduced_871m6(chain_id));
    };
}
pub relation party_to_arrangement_providing_dividend_equivalent_871m7(party: Text, contract_id: Text) kind empirical {
    label en official "the person is a party to a contract or other arrangement that provides for the payment of a dividend equivalent";
}
pub relation treated_as_having_control_of_payment_871m7(party: Text, contract_id: Text) kind institutional {
    label en official "for chapters 3 and 4, each party to a contract providing for the payment of a dividend equivalent is treated as having control of the payment (section 871(m)(7))";
}
@source(IRC_S871_M, relation = formalizes, coverage = exact, quote = "For purposes of chapters 3 and 4, each person that is a party to any contract or other arrangement that provides for the payment of a dividend equivalent shall be treated as having control of such")
rule S871M7PartyHasControl defeasible {
    for party: Text;
    for contract_id: Text;
    when party_to_arrangement_providing_dividend_equivalent_871m7(party, contract_id);
    then treated_as_having_control_of_payment_871m7(party, contract_id);
}
