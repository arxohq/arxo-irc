// §965 — treatment of deferred foreign income upon transition to
// participation exemption (the 2017 transition tax). The section applies to
// the last taxable year of a deferred foreign income corporation beginning
// before January 1, 2018, so it operates on the taxable years 2017-2018 and
// on the installment payments up to 2025 and later liability events; the
// pinned edition still carries it in full. Stage 2c (IRC-10 stage 2c, A13).
//
// Modeled: (a) the increase of subpart F income; (b)(1)-(3) the reduction for
// E&P deficits and its allocation ratio; (c) the participation-exemption
// deduction with the rate-equivalent percentages and the aggregate foreign
// cash position; (d)-(e) definitions; (g) the foreign tax credit disallowance
// percentage and the section 78 proportion; (h) the installment election,
// schedule, acceleration and net tax liability; (i) S corporation deferral,
// reporting and its addition to tax; (j) S corporation reporting; (k) the
// assessment period; (l) recapture for expatriated entities; (m) REIT
// schedule; (n) the net-operating-loss election.
// Not modeled (TECH-GAPS G1744): (b)(5) netting inside an affiliated group,
// (b)(4) the future-year E&P treatment, (c)(3)(D)-(F) anti-double-counting and
// anti-abuse, (f)(2) partnership and S corporation basis effects, (m)(2)
// allocation of the deduction over the REIT inclusion years.

// --- (a): the increase of subpart F income ---------------------------------

use self::{
    IRC_S965_A,
    IRC_S965_B,
    IRC_S965_C,
    IRC_S965_D,
    IRC_S965_E,
    IRC_S965_G,
    IRC_S965_H,
    IRC_S965_I,
    IRC_S965_J,
    IRC_S965_K,
    IRC_S965_L,
    IRC_S965_M,
    IRC_S965_N,
};

pub relation deferred_foreign_income_corp_year_965a(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the taxable year y is the last taxable year of the deferred foreign income corporation that begins before January 1, 2018";
}
pub relation accumulated_post_1986_deferred_foreign_income_at_nov_2_2017(corp: us.irc.core::Corporation, amount: Money) kind empirical {
    label en official "the accumulated post-1986 deferred foreign income of the corporation determined as of November 2, 2017 (section 965(a)(1))";
}
pub relation accumulated_post_1986_deferred_foreign_income_at_dec_31_2017(corp: us.irc.core::Corporation, amount: Money) kind empirical {
    label en official "the accumulated post-1986 deferred foreign income of the corporation determined as of December 31, 2017 (section 965(a)(2))";
}
pub relation subpart_f_increase_965a(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the increase of the subpart F income of the deferred foreign income corporation for its last taxable year beginning before January 1, 2018: the greater of the accumulated post-1986 deferred foreign income at November 2, 2017 and at December 31, 2017 (section 965(a))";
}
@source(IRC_S965_A, relation = formalizes, coverage = exact, quote = "the subpart F income of such foreign corporation (as otherwise determined for such taxable year under section 952) shall be increased by the greater of—")
rule S965AIncreaseOfSubpartFIncome defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for nov: Money;
    for dec: Money;
    when deferred_foreign_income_corp_year_965a(corp, y)
     and accumulated_post_1986_deferred_foreign_income_at_nov_2_2017(corp, nov)
     and accumulated_post_1986_deferred_foreign_income_at_dec_31_2017(corp, dec);
    then subpart_f_increase_965a(corp, y, max(nov, dec));
}

// --- (b): reduction for E&P deficit corporations ----------------------------

pub relation shareholder_pro_rata_accumulated_deferred_income_965b2(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, amount: Money) kind empirical {
    label en official "the United States shareholder's pro rata share of the accumulated post-1986 deferred foreign income of the deferred foreign income corporation";
}
pub relation shareholder_aggregate_pro_rata_accumulated_deferred_income_965b2B(shareholder: us.irc.core::Person, amount: Money) kind empirical {
    label en official "the aggregate of the shareholder's pro rata share of the accumulated post-1986 deferred foreign income of all of the shareholder's deferred foreign income corporations (section 965(b)(2)(B))";
}
pub relation shareholder_pro_rata_specified_ep_deficits_965b3Ai(shareholder: us.irc.core::Person, amount: Money) kind empirical {
    label en official "the aggregate of the shareholder's pro rata shares of the specified E&P deficits of its E&P deficit foreign corporations (section 965(b)(3)(A)(i)(I)); a corporation qualifies only if at November 2, 2017 it had a deficit in post-1986 earnings and profits, was a specified foreign corporation, and the taxpayer was its United States shareholder (section 965(b)(3)(B))";
}
pub relation aggregate_foreign_ep_deficit_965b3A(shareholder: us.irc.core::Person, amount: Money) kind institutional {
    label en official "the aggregate foreign E&P deficit: the lesser of the aggregate pro rata specified E&P deficits and the aggregate pro rata accumulated deferred foreign income of the shareholder's deferred foreign income corporations (section 965(b)(3)(A)(i))";
}
@source(IRC_S965_B, relation = formalizes, coverage = exact, quote = "The term \"aggregate foreign E&P deficit\" means, with respect to any United States shareholder, the lesser of—")
rule S965B3AAggregateForeignEpDeficit defeasible {
    for shareholder: us.irc.core::Person;
    for deficits: Money;
    for deferred: Money;
    when shareholder_pro_rata_specified_ep_deficits_965b3Ai(shareholder, deficits)
     and shareholder_aggregate_pro_rata_accumulated_deferred_income_965b2B(shareholder, deferred);
    then aggregate_foreign_ep_deficit_965b3A(shareholder, min(deficits, deferred));
}
pub relation aggregate_foreign_ep_deficit_allocated_to_corp_965b2(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, amount: Money) kind institutional {
    label en official "the part of the aggregate foreign E&P deficit allocated to the deferred foreign income corporation: in proportion to the shareholder's pro rata share of its accumulated post-1986 deferred foreign income over the aggregate of all (section 965(b)(2))";
}
@source(IRC_S965_B, relation = formalizes, coverage = exact, quote = "The aggregate foreign E&P deficit of any United States shareholder shall be allocated among the deferred foreign income corporations of such United States shareholder in an amount which bears the same proportion to such aggregate as—")
rule S965B2AllocationOfAggregateDeficit defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for deficit: Money;
    for pro_rata: Money;
    for aggregate: Money;
    when aggregate_foreign_ep_deficit_965b3A(shareholder, deficit)
     and shareholder_pro_rata_accumulated_deferred_income_965b2(shareholder, corp, pro_rata)
     and shareholder_aggregate_pro_rata_accumulated_deferred_income_965b2B(shareholder, aggregate)
     and aggregate > 0.00 USD;
    then aggregate_foreign_ep_deficit_allocated_to_corp_965b2(shareholder, corp, round(deficit * (pro_rata / aggregate), 2, "HALF_UP"));
}
pub relation shareholder_pro_rata_share_of_subpart_f_increase_965b1(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, amount: Money) kind empirical {
    label en official "the amount which would (but for section 965(b)) be taken into account under section 951(a)(1) by reason of subsection (a) as the shareholder's pro rata share of the subpart F income increase";
}
pub relation inclusion_after_deficit_reduction_965b1(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, amount: Money) kind institutional {
    label en official "the section 951(a)(1) inclusion by reason of subsection (a) after the reduction by the allocated aggregate foreign E&P deficit, floored at zero (section 965(b)(1))";
}
@source(IRC_S965_B, relation = formalizes, coverage = exact, quote = "the amount which would (but for this subsection) be taken into account under section 951(a)(1) by reason of subsection (a) as such United States shareholder's pro rata share of the subpart F income of each deferred foreign income corporation shall be reduced by the amount of such United States shareholder's aggregate foreign E&P deficit which is allocated under paragraph (2) to such deferred foreign income corporation.")
rule S965B1InclusionReducedByAllocatedDeficit defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for pro_rata_increase: Money;
    for allocated: Money;
    when shareholder_pro_rata_share_of_subpart_f_increase_965b1(shareholder, corp, pro_rata_increase)
     and aggregate_foreign_ep_deficit_allocated_to_corp_965b2(shareholder, corp, allocated);
    then inclusion_after_deficit_reduction_965b1(shareholder, corp, max(0.00 USD, pro_rata_increase - allocated));
}
@source(IRC_S965_B, relation = formalizes, coverage = exact, quote = "the amount which would (but for this subsection) be taken into account under section 951(a)(1) by reason of subsection (a) as such United States shareholder's pro rata share of the subpart F income of each deferred foreign income corporation shall be reduced by the amount of such United States shareholder's aggregate foreign E&P deficit which is allocated under paragraph (2) to such deferred foreign income corporation.")
rule S965B1InclusionNoDeficit defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for pro_rata_increase: Money;
    when shareholder_pro_rata_share_of_subpart_f_increase_965b1(shareholder, corp, pro_rata_increase);
    unless aggregate_foreign_ep_deficit_allocated_to_corp_965b2(shareholder, corp, _)
     and shareholder_pro_rata_share_of_subpart_f_increase_965b1(shareholder, corp, pro_rata_increase);
    then inclusion_after_deficit_reduction_965b1(shareholder, corp, pro_rata_increase);
}

// --- (c): participation exemption deduction ----------------------------------

pub relation highest_section_11_rate_for_year_965c2(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, rate: Decimal) kind empirical {
    label en official "the highest rate of tax specified in section 11 for the taxable year (for a year to which section 15 applies, the rates before and after the change, combined by the section 15 proration)";
}
pub relation rate_equivalent_percentage_8_965c2A(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, pct: Decimal) kind institutional {
    label en official "the 8 percent rate equivalent percentage: the percentage of an amount deducted so that the remainder taxed at the highest section 11 rate bears an 8 percent rate of tax (section 965(c)(2)(A)): (highest rate - 8) / highest rate, rates as fractions";
}
@source(IRC_S965_C, relation = formalizes, coverage = partial, quote = "The term \"8 percent rate equivalent percentage\" means, with respect to any United States shareholder for any taxable year, the percentage which would result in the amount to which such percentage applies being subject to a 8 percent rate of tax determined by only taking into account a deduction equal to such percentage of such amount and the highest rate of tax specified in section 11 for such taxable year.")
rule S965C2AEightPercentRateEquivalent defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for top: Decimal;
    when highest_section_11_rate_for_year_965c2(shareholder, y, top)
     and top > 0.0;
    then rate_equivalent_percentage_8_965c2A(shareholder, y, (top - 0.08) / top);
}
pub relation rate_equivalent_percentage_15_5_965c2B(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, pct: Decimal) kind institutional {
    label en official "the 15.5 percent rate equivalent percentage: the same computation with a 15.5 percent rate of tax (section 965(c)(2)(B))";
}
@source(IRC_S965_C, relation = formalizes, coverage = exact, quote = "The term \"15.5 percent rate equivalent percentage\" means, with respect to any United States shareholder for any taxable year, the percentage determined under subparagraph (A) applied by substituting \"15.5 percent rate of tax\" for \"8 percent rate of tax\".")
rule S965C2BFifteenPointFivePercentRateEquivalent defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for top: Decimal;
    when highest_section_11_rate_for_year_965c2(shareholder, y, top)
     and top > 0.0;
    then rate_equivalent_percentage_15_5_965c2B(shareholder, y, (top - 0.155) / top);
}
pub relation sfc_cash_position_at_last_year_965c3Ai(shareholder: us.irc.core::Person, amount: Money) kind empirical {
    label en official "the aggregate of the shareholder's pro rata share of the cash position of each specified foreign corporation determined as of the close of its last taxable year beginning before January 1, 2018";
}
pub relation sfc_cash_position_at_earlier_years_sum_965c3Aii(shareholder: us.irc.core::Person, amount: Money) kind empirical {
    label en official "the sum of (I) the aggregate cash position as of the close of the last taxable year of each specified foreign corporation ending before November 2, 2017 and (II) the aggregate as of the close of the year preceding it (section 965(c)(3)(A)(ii))";
}
pub relation aggregate_foreign_cash_position_965c3A(shareholder: us.irc.core::Person, amount: Money) kind institutional {
    label en official "the aggregate foreign cash position: the greater of the aggregate cash position at the close of the last taxable year beginning before 2018 and one half of the sum of the two earlier-date aggregates (section 965(c)(3)(A))";
}
@source(IRC_S965_C, relation = formalizes, coverage = exact, quote = "The term \"aggregate foreign cash position\" means, with respect to any United States shareholder, the greater of—")
rule S965C3AAggregateForeignCashPosition defeasible {
    for shareholder: us.irc.core::Person;
    for last_year: Money;
    for earlier: Money;
    when sfc_cash_position_at_last_year_965c3Ai(shareholder, last_year)
     and sfc_cash_position_at_earlier_years_sum_965c3Aii(shareholder, earlier);
    then aggregate_foreign_cash_position_965c3A(shareholder, max(last_year, earlier * 0.50));
}
pub relation sfc_cash_held_965c3Bi(corp: us.irc.core::Corporation, amount: Money) kind empirical {
    label en official "cash held by the specified foreign corporation";
}
pub relation sfc_accounts_receivable_965c3Ci(corp: us.irc.core::Corporation, amount: Money) kind empirical {
    label en official "the corporation's accounts receivable";
}
pub relation sfc_accounts_payable_965c3Cii(corp: us.irc.core::Corporation, amount: Money) kind empirical {
    label en official "the corporation's accounts payable (determined consistent with the rules of section 461)";
}
pub relation sfc_liquid_assets_fmv_965c3Biii(corp: us.irc.core::Corporation, amount: Money) kind empirical {
    label en official "the fair market value of the actively traded personal property, commercial paper, certificates of deposit, government securities, foreign currency, obligations with a term under one year, and assets the Secretary identifies as economically equivalent (section 965(c)(3)(B)(iii)(I)-(V))";
}
pub relation net_accounts_receivable_965c3C(corp: us.irc.core::Corporation, amount: Money) kind institutional {
    label en official "net accounts receivable: the excess (if any) of accounts receivable over accounts payable (section 965(c)(3)(C))";
}
@source(IRC_S965_C, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the term \"net accounts receivable\" means, with respect to any specified foreign corporation, the excess (if any) of—")
rule S965C3CNetAccountsReceivable defeasible {
    for corp: us.irc.core::Corporation;
    for receivable: Money;
    for payable: Money;
    when sfc_accounts_receivable_965c3Ci(corp, receivable)
     and sfc_accounts_payable_965c3Cii(corp, payable)
     and receivable > payable;
    then net_accounts_receivable_965c3C(corp, receivable - payable);
}
pub relation cash_position_965c3B(corp: us.irc.core::Corporation, amount: Money) kind institutional {
    label en official "the cash position of the specified foreign corporation: cash, plus net accounts receivable, plus the fair market value of the listed liquid assets (section 965(c)(3)(B))";
}
@source(IRC_S965_C, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the cash position of any specified foreign corporation is the sum of—")
rule S965C3BCashPosition defeasible {
    for corp: us.irc.core::Corporation;
    for cash: Money;
    for net_ar: Money;
    for liquid: Money;
    when sfc_cash_held_965c3Bi(corp, cash)
     and net_accounts_receivable_965c3C(corp, net_ar)
     and sfc_liquid_assets_fmv_965c3Biii(corp, liquid);
    then cash_position_965c3B(corp, cash + net_ar + liquid);
}
pub relation amount_included_under_951a1_by_965(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the amount included in gross income of the shareholder under section 951(a)(1) by reason of section 965 for the taxable year (after subsection (b))";
}
pub relation participation_exemption_deduction_965c1(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the deduction: the 8 percent rate equivalent percentage of the excess of the included amount over the aggregate foreign cash position, plus the 15.5 percent rate equivalent percentage of the lesser of the included amount and the aggregate foreign cash position (section 965(c)(1)(A)-(B))";
}
@source(IRC_S965_C, relation = formalizes, coverage = exact, quote = "there shall be allowed as a deduction for the taxable year in which an amount is included in the gross income of such United States shareholder under section 951(a)(1) by reason of this section an amount equal to the sum of—")
rule S965C1Deduction defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for included: Money;
    for cash: Money;
    for eight: Decimal;
    for fifteen: Decimal;
    when amount_included_under_951a1_by_965(shareholder, y, included)
     and aggregate_foreign_cash_position_965c3A(shareholder, cash)
     and rate_equivalent_percentage_8_965c2A(shareholder, y, eight)
     and rate_equivalent_percentage_15_5_965c2B(shareholder, y, fifteen);
    then participation_exemption_deduction_965c1(shareholder, y, round((eight * max(0.00 USD, included - cash)) + (fifteen * min(cash, included)), 2, "HALF_UP"));
}

// --- (d), (e): definitions ---------------------------------------------------

pub relation post_1986_earnings_and_profits_965d3(corp: us.irc.core::Corporation, as_of: Date, amount: Money) kind empirical {
    label en official "the earnings and profits accumulated in taxable years beginning after December 31, 1986, computed under sections 964(a) and 986 and only for periods in which the corporation was a specified foreign corporation, determined as of the date, without diminution by dividends distributed in the year (other than to another specified foreign corporation) (section 965(d)(3))";
}
pub relation earnings_attributable_to_eci_or_959_excluded_965d2(corp: us.irc.core::Corporation, as_of: Date, amount: Money) kind empirical {
    label en official "the part of post-1986 earnings and profits attributable to income effectively connected with a US trade or business and subject to US tax, or that would if distributed be excluded from a United States shareholder's gross income under section 959 (section 965(d)(2)(A)-(B))";
}
pub relation accumulated_post_1986_deferred_foreign_income_965d2(corp: us.irc.core::Corporation, as_of: Date, amount: Money) kind institutional {
    label en official "the accumulated post-1986 deferred foreign income: post-1986 earnings and profits except the part attributable to ECI or section 959-excluded amounts (section 965(d)(2)), floored at zero";
}
@source(IRC_S965_D, relation = formalizes, coverage = exact, quote = "The term \"accumulated post-1986 deferred foreign income\" means the post-1986 earnings and profits except to the extent such earnings—")
rule S965D2AccumulatedPost1986DeferredForeignIncome defeasible {
    for corp: us.irc.core::Corporation;
    for as_of: Date;
    for ep: Money;
    for excluded: Money;
    when post_1986_earnings_and_profits_965d3(corp, as_of, ep)
     and earnings_attributable_to_eci_or_959_excluded_965d2(corp, as_of, excluded);
    then accumulated_post_1986_deferred_foreign_income_965d2(corp, as_of, max(0.00 USD, ep - excluded));
}
pub relation deferred_foreign_income_corporation_965d1(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, as_of: Date) kind institutional {
    label en official "a deferred foreign income corporation: a specified foreign corporation of the shareholder with accumulated post-1986 deferred foreign income greater than zero as of the date referred to in section 965(a)(1) or (2) (section 965(d)(1))";
}
pub relation specified_foreign_corporation_of_shareholder_965e(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation) kind institutional {
    label en official "a specified foreign corporation of the shareholder: a controlled foreign corporation, or a foreign corporation of which one or more domestic corporations is a United States shareholder, other than a passive foreign investment company that is not a controlled foreign corporation (section 965(e)(1), (3))";
}
pub relation foreign_corp_cfc_or_domestic_corp_shareholder_965e1(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation) kind empirical {
    label en official "the corporation is a controlled foreign corporation, or a foreign corporation with respect to which one or more domestic corporations is a United States shareholder (section 965(e)(1)(A)-(B))";
}
pub relation corp_is_pfic_with_respect_to_shareholder_and_not_cfc_965e3(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation) kind empirical {
    label en official "the corporation is a passive foreign investment company (section 1297) with respect to the shareholder and is not a controlled foreign corporation";
}
@source(IRC_S965_E, relation = formalizes, coverage = exact, quote = "Such term shall not include any corporation which is a passive foreign investment company (as defined in section 1297) with respect to the shareholder and which is not a controlled foreign corporation.")
rule S965E1SpecifiedForeignCorporation defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    when foreign_corp_cfc_or_domestic_corp_shareholder_965e1(shareholder, corp);
    unless corp_is_pfic_with_respect_to_shareholder_and_not_cfc_965e3(shareholder, corp)
     and foreign_corp_cfc_or_domestic_corp_shareholder_965e1(shareholder, corp);
    then specified_foreign_corporation_of_shareholder_965e(shareholder, corp);
}
pub relation shareholder_of_corp_with_dates_965d1(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, as_of: Date) kind empirical {
    label en unofficial "the pair and the date for which deferred-foreign-income-corporation status is tested (a domain anchor)";
}
rule S965D1DeferredForeignIncomeCorporation defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for as_of: Date;
    for amount: Money;
    when shareholder_of_corp_with_dates_965d1(shareholder, corp, as_of)
     and specified_foreign_corporation_of_shareholder_965e(shareholder, corp)
     and accumulated_post_1986_deferred_foreign_income_965d2(corp, as_of, amount)
     and amount > 0.00 USD;
    then deferred_foreign_income_corporation_965d1(shareholder, corp, as_of);
}

// --- (g): foreign tax credit disallowance ------------------------------------

pub relation cash_excess_amount_965c1A(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the excess to which subsection (c)(1)(A) applies: the included amount over the aggregate foreign cash position, floored at zero";
}
rule S965CCashExcess defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for included: Money;
    for cash: Money;
    when amount_included_under_951a1_by_965(shareholder, y, included)
     and aggregate_foreign_cash_position_965c3A(shareholder, cash);
    then cash_excess_amount_965c1A(shareholder, y, max(0.00 USD, included - cash));
}
pub relation cash_portion_amount_965c1B(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the amount to which subsection (c)(1)(B) applies: the lesser of the included amount and the aggregate foreign cash position";
}
rule S965CCashPortion defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for included: Money;
    for cash: Money;
    when amount_included_under_951a1_by_965(shareholder, y, included)
     and aggregate_foreign_cash_position_965c3A(shareholder, cash);
    then cash_portion_amount_965c1B(shareholder, y, min(cash, included));
}
pub relation applicable_percentage_965g2(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, pct: Decimal) kind institutional {
    label en official "the applicable percentage for the foreign tax credit disallowance: 0.771 times the ratio of the (c)(1)(A) excess to the sum of both amounts, plus 0.557 times the ratio of the (c)(1)(B) amount to that sum (section 965(g)(2))";
}
@source(IRC_S965_G, relation = formalizes, coverage = exact, quote = "(A) 0.771 multiplied by the ratio of—")
rule S965G2ApplicablePercentage defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for excess: Money;
    for cash: Money;
    when cash_excess_amount_965c1A(shareholder, y, excess)
     and cash_portion_amount_965c1B(shareholder, y, cash)
     and (excess + cash) > 0.00 USD;
    then applicable_percentage_965g2(shareholder, y, (0.771 * (excess / (excess + cash))) + (0.557 * (cash / (excess + cash))));
}
pub relation foreign_taxes_on_deducted_amount_965g1(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, tax: Money) kind empirical {
    label en official "the taxes paid or accrued (or treated as paid or accrued) with respect to any amount for which a deduction is allowed under section 965";
}
pub relation credit_disallowed_965g1(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "no credit is allowed under section 901 for the applicable percentage of the taxes with respect to the deducted amount (section 965(g)(1)); no deduction is allowed for the same tax (section 965(g)(3))";
}
@source(IRC_S965_G, relation = formalizes, coverage = exact, quote = "No credit shall be allowed under section 901 for the applicable percentage of any taxes paid or accrued (or treated as paid or accrued) with respect to any amount for which a deduction is allowed under this section.")
rule S965G1CreditDisallowed defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for tax: Money;
    for pct: Decimal;
    when foreign_taxes_on_deducted_amount_965g1(shareholder, y, tax)
     and applicable_percentage_965g2(shareholder, y, pct);
    then credit_disallowed_965g1(shareholder, y, round(tax * pct, 2, "HALF_UP"));
}
pub relation section_78_gross_up_taxes_965g4(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the taxes to which section 78 applies: the taxes multiplied by the ratio of (the included amounts minus the section 965(c) deduction) to the included amounts (section 965(g)(4))";
}
@source(IRC_S965_G, relation = formalizes, coverage = exact, quote = "With respect to the taxes treated as paid or accrued by a domestic corporation with respect to amounts which are includible in gross income of such domestic corporation by reason of this section, section 78 shall apply only to so much of such taxes as bears the same proportion to the amount of such taxes as—")
rule S965G4Section78Proportion defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for tax: Money;
    for included: Money;
    for deduction: Money;
    when foreign_taxes_on_deducted_amount_965g1(shareholder, y, tax)
     and amount_included_under_951a1_by_965(shareholder, y, included)
     and participation_exemption_deduction_965c1(shareholder, y, deduction)
     and included > 0.00 USD;
    then section_78_gross_up_taxes_965g4(shareholder, y, round(tax * ((included - deduction) / included), 2, "HALF_UP"));
}

// --- (h): installment election, schedule, acceleration ----------------------

pub relation net_income_tax_with_965_h6Ai(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the taxpayer's net income tax (regular tax liability reduced by the credits allowed under subparts A, B and D of part IV of subchapter A) for the taxable year in which the section 965 amount is included";
}
pub relation net_income_tax_without_965_h6Aii(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the taxpayer's net income tax for the year determined without regard to section 965 and without regard to any income or deduction properly attributable to a dividend from a deferred foreign income corporation";
}
pub relation net_tax_liability_965h6(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the net tax liability under section 965: the excess (if any) of the net income tax with section 965 over the net income tax without it (section 965(h)(6)(A))";
}
@source(IRC_S965_H, relation = formalizes, coverage = exact, quote = "The net tax liability under this section with respect to any United States shareholder is the excess (if any) of—")
rule S965H6NetTaxLiability defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for with: Money;
    for without: Money;
    when net_income_tax_with_965_h6Ai(shareholder, y, with)
     and net_income_tax_without_965_h6Aii(shareholder, y, without)
     and with > without;
    then net_tax_liability_965h6(shareholder, y, with - without);
}
pub relation elects_installments_965h1(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the United States shareholder of a deferred foreign income corporation elects to pay the net tax liability under section 965 in 8 installments";
}
pub relation return_due_date_without_extension_965h2(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, due: Date) kind empirical {
    label en official "the due date (determined without regard to any extension of time for filing) for the return of tax for the taxable year";
}
pub relation election_made_on_965h5(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, made_on: Date) kind empirical {
    label en official "the date the section 965(h)(1) election is made";
}
pub relation election_timely_965h5(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the election is made not later than the due date for the return of tax for the taxable year described in subsection (a) (section 965(h)(5))";
}
@source(IRC_S965_H, relation = formalizes, coverage = exact, quote = "Any election under paragraph (1) shall be made not later than the due date for the return of tax for the taxable year described in subsection (a) and shall be made in such manner as the Secretary shall provide.")
rule S965H5ElectionTimely defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for made: Date;
    for due: Date;
    when election_made_on_965h5(shareholder, y, made)
     and return_due_date_without_extension_965h2(shareholder, y, due)
     and made <= due;
    then election_timely_965h5(shareholder, y);
}
pub relation installment_regime_elected_965h1(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the installment regime of section 965(h) is in effect for the shareholder's net tax liability";
}
@source(IRC_S965_H, relation = formalizes, coverage = exact, quote = "such United States shareholder may elect to pay the net tax liability under this section in 8 installments of the following amounts:")
rule S965H1InstallmentElectionPower strict {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when elects_installments_965h1(shareholder, y);
    then power S965H1InstallmentElection {
        holder shareholder;
        over shareholder;
        exercise elects_installments_965h1(shareholder, y);
        valid_when election_timely_965h5(shareholder, y);
        effect create(installment_regime_elected_965h1(shareholder, y));
    };
}
pub relation installment_percentage_965h1(index: Integer, pct: Decimal) kind institutional {
    label en official "the share of the net tax liability payable in installment number index: 8 percent for each of the first 5, 15 percent for the 6th, 20 percent for the 7th, 25 percent for the 8th (section 965(h)(1)(A)-(D))";
}
rule S965H1AFirstFiveInstallments defeasible {
    for k: Integer;
    when installment_index_965h1(k)
     and k >= 1
     and k <= 5;
    then installment_percentage_965h1(k, 0.08);
}
pub relation installment_index_965h1(index: Integer) kind empirical {
    label en unofficial "an installment number between 1 and 8 (a domain anchor for the schedule)";
}
@source(IRC_S965_H, relation = formalizes, coverage = exact, quote = "(B) 15 percent of the net tax liability in the case of the 6th such installment,")
rule S965H1BSixthInstallment defeasible {
    for k: Integer;
    when installment_index_965h1(k)
     and k == 6;
    then installment_percentage_965h1(k, 0.15);
}
@source(IRC_S965_H, relation = formalizes, coverage = exact, quote = "(C) 20 percent of the net tax liability in the case of the 7th such installment, and")
rule S965H1CSeventhInstallment defeasible {
    for k: Integer;
    when installment_index_965h1(k)
     and k == 7;
    then installment_percentage_965h1(k, 0.20);
}
@source(IRC_S965_H, relation = formalizes, coverage = exact, quote = "(D) 25 percent of the net tax liability in the case of the 8th such installment.")
rule S965H1DEighthInstallment defeasible {
    for k: Integer;
    when installment_index_965h1(k)
     and k == 8;
    then installment_percentage_965h1(k, 0.25);
}
pub relation installment_amount_965h1(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, index: Integer, amount: Money) kind institutional {
    label en official "the amount of installment number index of the net tax liability under section 965";
}
@source(IRC_S965_H, relation = formalizes, coverage = exact, quote = "(A) 8 percent of the net tax liability in the case of each of the first 5 of such installments,")
rule S965H1InstallmentAmount defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for k: Integer;
    for pct: Decimal;
    for liability: Money;
    when installment_regime_elected_965h1(shareholder, y)
     and net_tax_liability_965h6(shareholder, y, liability)
     and installment_percentage_965h1(k, pct);
    then installment_amount_965h1(shareholder, y, k, round(liability * pct, 2, "HALF_UP"));
}
pub relation installment_due_date_965h2(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, index: Integer, due: Date) kind institutional {
    label en official "the due date of an installment: the first on the due date (without regard to extension) of the return for the taxable year described in subsection (a), each succeeding one on the due date of the return for the following year (section 965(h)(2)); the return due date of the k-th following year is the input";
}
pub relation return_due_date_of_kth_year_965h2(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, index: Integer, due: Date) kind empirical {
    label en official "the due date (without regard to any extension) of the return for the taxable year that is index-1 years after the taxable year described in section 965(a)";
}
@source(IRC_S965_H, relation = formalizes, coverage = exact, quote = "the first installment shall be paid on the due date (determined without regard to any extension of time for filing the return) for the return of tax for the taxable year described in subsection (a)")
rule S965H2InstallmentDueDate defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for k: Integer;
    for due: Date;
    when installment_regime_elected_965h1(shareholder, y)
     and return_due_date_of_kth_year_965h2(shareholder, y, k, due);
    then installment_due_date_965h2(shareholder, y, k, due);
}
pub relation installment_paid_965h(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, index: Integer) kind empirical {
    label en official "the installment was paid";
}
@source(IRC_S965_H, relation = formalizes, coverage = exact, quote = "each succeeding installment shall be paid on the due date (as so determined) for the return of tax for the taxable year following the taxable year with respect to which the preceding installment was made.")
rule S965H2DutyToPayInstallment defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for k: Integer;
    for amount: Money;
    for due: Date;
    when installment_amount_965h1(shareholder, y, k, amount)
     and installment_due_date_965h2(shareholder, y, k, due);
    then duty S965H2PayInstallmentDuty {
        bearer shareholder;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition installment_paid_965h(shareholder, y, k);
            window [-infinity, due];
        }
    };
}
pub relation acceleration_event_965h3(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, event_on: Date) kind empirical {
    label en official "an addition to tax for failure to timely pay an installment, a liquidation or sale of substantially all the assets (including in a title 11 or similar case), a cessation of business, or a similar circumstance, on this date (the day before the petition in a title 11 case)";
}
pub relation buyer_agreement_with_secretary_965h3(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the sale of substantially all the assets is to a buyer who enters into an agreement with the Secretary under which the buyer is liable for the remaining installments";
}
pub relation remaining_installments_due_965h3(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, due_on: Date) kind institutional {
    label en official "the unpaid portion of all remaining installments is due on the date of the acceleration event (section 965(h)(3))";
}
@source(IRC_S965_H, relation = formalizes, coverage = partial, quote = "then the unpaid portion of all remaining installments shall be due on the date of such event")
rule S965H3AccelerationOfRemainingInstallments defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for event_on: Date;
    when installment_regime_elected_965h1(shareholder, y)
     and acceleration_event_965h3(shareholder, y, event_on);
    unless buyer_agreement_with_secretary_965h3(shareholder, y)
     and acceleration_event_965h3(shareholder, y, event_on);
    then remaining_installments_due_965h3(shareholder, y, event_on);
}

// --- (i): S corporation shareholders ----------------------------------------

pub relation s_corp_shareholder_net_tax_liability_965i3(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the shareholder's net tax liability with respect to the S corporation: the amount that would be determined under subsection (h)(6) if the only subpart F income taken into account were allocations from the S corporation";
}
pub relation elects_deferral_965i1(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the S corporation shareholder elects to defer payment of the net tax liability until the taxable year that includes the triggering event";
}
pub relation deferral_election_made_on_965i8(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, made_on: Date) kind empirical {
    label en official "the date the section 965(i)(1) deferral election is made";
}
pub relation shareholder_return_due_date_965i8A(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, due: Date) kind empirical {
    label en official "the due date of the shareholder's return of tax for the taxable year which includes the close of the S corporation's taxable year in which the section 965(a) amount is taken into account";
}
pub relation deferral_election_timely_965i8(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the deferral election is made not later than the due date of the shareholder's return for the taxable year which includes the close of the S corporation's year of the section 965(a) inclusion (section 965(i)(8)(A))";
}
@source(IRC_S965_I, relation = formalizes, coverage = exact, quote = "(A) shall be made by the shareholder of the S corporation not later than the due date for such shareholder's return of tax for the taxable year which includes the close of the taxable year of such S corporation in which the amount described in subsection (a) is taken into account, and")
rule S965I8ADeferralElectionTimely defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for made: Date;
    for due: Date;
    when deferral_election_made_on_965i8(shareholder, y, made)
     and shareholder_return_due_date_965i8A(shareholder, y, due)
     and made <= due;
    then deferral_election_timely_965i8(shareholder, y);
}
pub relation deferral_regime_elected_965i1(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the S corporation shareholder's net tax liability payment is deferred until the triggering event";
}
@source(IRC_S965_I, relation = formalizes, coverage = exact, quote = "each shareholder of such S corporation may elect to defer payment of such shareholder's net tax liability under this section with respect to such S corporation until the shareholder's taxable year which includes the triggering event with respect to such liability.")
rule S965I1DeferralElectionPower strict {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when elects_deferral_965i1(shareholder, y);
    then power S965I1DeferralElection {
        holder shareholder;
        over shareholder;
        exercise elects_deferral_965i1(shareholder, y);
        valid_when deferral_election_timely_965i8(shareholder, y);
        effect create(deferral_regime_elected_965i1(shareholder, y));
    };
}
pub relation s_corp_ceases_to_be_s_corp_965i2Ai(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, on: Date) kind empirical {
    label en official "the corporation ceases to be an S corporation (determined as of the first day of the first taxable year that it is not an S corporation)";
}
pub relation s_corp_liquidation_or_cessation_965i2Aii(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, on: Date) kind empirical {
    label en official "a liquidation or sale of substantially all the assets of the S corporation (including in a title 11 or similar case), a cessation of business, the S corporation ceases to exist, or a similar circumstance";
}
pub relation shareholder_transfers_share_965i2Aiii(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, on: Date) kind empirical {
    label en official "a transfer of any share of stock in the S corporation by the taxpayer (including by death or otherwise)";
}
pub relation transferee_agreement_with_secretary_965i2C(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the transferee enters into an agreement with the Secretary under which it is liable for the net tax liability with respect to the stock as if it were the taxpayer";
}
pub relation triggering_event_965i2(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, on: Date) kind institutional {
    label en official "a triggering event with respect to the deferred liability on this date (section 965(i)(2)(A)); the first occurring one governs";
}
@source(IRC_S965_I, relation = formalizes, coverage = exact, quote = "(i) Such corporation ceases to be an S corporation (determined as of the first day of the first taxable year that such corporation is not an S corporation).")
rule S965I2AiSCorporationStatusEnds defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for on: Date;
    when deferral_regime_elected_965i1(shareholder, y)
     and s_corp_ceases_to_be_s_corp_965i2Ai(shareholder, y, on);
    then triggering_event_965i2(shareholder, y, on);
}
@source(IRC_S965_I, relation = formalizes, coverage = exact, quote = "(ii) A liquidation or sale of substantially all the assets of such S corporation (including in a title 11 or similar case), a cessation of business by such S corporation, such S corporation ceases to exist, or any similar circumstance.")
rule S965I2AiiLiquidationOrCessation defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for on: Date;
    when deferral_regime_elected_965i1(shareholder, y)
     and s_corp_liquidation_or_cessation_965i2Aii(shareholder, y, on);
    then triggering_event_965i2(shareholder, y, on);
}
@source(IRC_S965_I, relation = formalizes, coverage = exact, quote = "(iii) A transfer of any share of stock in such S corporation by the taxpayer (including by reason of death, or otherwise).")
rule S965I2AiiiTransferOfShare defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for on: Date;
    when deferral_regime_elected_965i1(shareholder, y)
     and shareholder_transfers_share_965i2Aiii(shareholder, y, on);
    unless transferee_agreement_with_secretary_965i2C(shareholder, y)
     and shareholder_transfers_share_965i2Aiii(shareholder, y, on);
    then triggering_event_965i2(shareholder, y, on);
}
pub relation deferred_net_tax_liability_965i7B(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the amount of net tax liability payment of which has been deferred under paragraph (1) and not yet assessed on a return of a prior taxable year";
}
pub relation deferred_liability_reported_on_return_965i7A(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the shareholder reported the deferred net tax liability on the return of tax for the taxable year, before the return's due date";
}
@source(IRC_S965_I, relation = formalizes, coverage = exact, quote = "Any shareholder of an S corporation which makes an election under paragraph (1) shall report the amount of such shareholder's deferred net tax liability on such shareholder's return of tax for the taxable year for which such election is made and on the return of tax for each taxable year thereafter until such amount has been fully assessed on such returns.")
rule S965I7ADutyToReportDeferredLiability defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when deferral_regime_elected_965i1(shareholder, y)
     and deferred_net_tax_liability_965i7B(shareholder, y, amount)
     and amount > 0.00 USD;
    then duty S965I7AReportDeferredLiabilityDuty {
        bearer shareholder;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition deferred_liability_reported_on_return_965i7A(shareholder, y);
            window [-infinity, infinity];
        }
    };
}
pub relation addition_to_tax_for_failure_to_report_965i7C(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the addition to tax for failure to report the deferred amount by the return due date: 5 percent of the amount (section 965(i)(7)(C))";
}
pub relation failed_to_report_before_due_date_965i7C(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the shareholder failed to report the required amount before the due date for the return of tax for the taxable year";
}
@source(IRC_S965_I, relation = formalizes, coverage = exact, quote = "there shall be assessed on such return as an addition to tax 5 percent of such amount.")
rule S965I7CFivePercentAddition defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when failed_to_report_before_due_date_965i7C(shareholder, y)
     and deferred_net_tax_liability_965i7B(shareholder, y, amount);
    then addition_to_tax_for_failure_to_report_965i7C(shareholder, y, round(amount * 0.05, 2, "HALF_UP"));
}
pub relation s_corp_reported_965_amount_and_deduction_965j(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the S corporation reported, in its return under section 6037(a), the amount includible in its gross income by reason of section 965 and the deduction allowable under subsection (c), with each shareholder's pro rata share in the copy provided under section 6037(b)";
}
pub relation s_corp_united_states_shareholder_of_sfc_965j(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the S corporation is a United States shareholder of a specified foreign corporation";
}
@source(IRC_S965_J, relation = formalizes, coverage = exact, quote = "Each S corporation which is a United States shareholder of a specified foreign corporation shall report in its return of tax under section 6037(a) the amount includible in its gross income for such taxable year by reason of this section and the amount of the deduction allowable by subsection (c).")
rule S965JDutyOfSCorporationToReport defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when s_corp_united_states_shareholder_of_sfc_965j(corp, y);
    then duty S965JReportDuty {
        bearer corp;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition s_corp_reported_965_amount_and_deduction_965j(corp, y);
            window [-infinity, infinity];
        }
    };
}

// --- (k), (l), (m), (n) ------------------------------------------------------

pub relation return_filed_on_965k(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, filed_on: Date) kind empirical {
    label en official "the date the return of tax for the taxable year described in subsection (h)(6) was filed";
}
pub relation assessment_of_965_net_tax_liability_not_expired_before_965k(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, date: Date) kind institutional {
    label en official "notwithstanding section 6501, the limitation period for assessment of the net tax liability under section 965 does not expire before the date 6 years after the return was filed (section 965(k))";
}
@source(IRC_S965_K, relation = formalizes, coverage = exact, quote = "Notwithstanding section 6501, the limitation on the time period for the assessment of the net tax liability under this section (as defined in subsection (h)(6)) shall not expire before the date that is 6 years after the return for the taxable year described in such subsection was filed.")
rule S965KAssessmentPeriodNotBeforeSixYears defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for filed: Date;
    when return_filed_on_965k(shareholder, y, filed);
    then assessment_of_965_net_tax_liability_not_expired_before_965k(shareholder, y, add_calendar_period(filed, 6 calendar_year));
}
pub relation deduction_allowed_under_965c_to_shareholder_965l(shareholder: us.irc.core::Person, deduction: Money) kind empirical {
    label en official "a deduction is allowed under section 965(c) to the United States shareholder, in this amount";
}
pub relation shareholder_first_becomes_expatriated_entity_965l1(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, becomes_on: Date) kind empirical {
    label en official "the shareholder first becomes an expatriated entity (section 7874(a)(2), not counting an entity whose surrogate foreign corporation is treated as domestic under section 7874(b)) during the 10-year period beginning December 22, 2017, with respect to a surrogate foreign corporation that first becomes such during that period";
}
pub relation recapture_tax_increase_965l1A(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the increase in the tax imposed by this chapter for the first taxable year in which the taxpayer becomes an expatriated entity: 35 percent of the section 965(c) deduction allowed (section 965(l)(1)(A)); no credits are allowed against the increase (section 965(l)(1)(B))";
}
@source(IRC_S965_L, relation = formalizes, coverage = exact, quote = "(A) the tax imposed by this chapter shall be increased for the first taxable year in which such taxpayer becomes an expatriated entity by an amount equal to 35 percent of the amount of the deduction allowed under subsection (c), and")
rule S965L1ARecaptureTaxIncrease defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for deduction: Money;
    for becomes_on: Date;
    when deduction_allowed_under_965c_to_shareholder_965l(shareholder, deduction)
     and shareholder_first_becomes_expatriated_entity_965l1(shareholder, y, becomes_on)
     and becomes_on >= @2017-12-22
     and becomes_on <= add_calendar_period(@2017-12-22, 10 calendar_year);
    then recapture_tax_increase_965l1A(shareholder, y, round(deduction * 0.35, 2, "HALF_UP"));
}
pub relation reit_us_shareholder_election_965m1B(shareholder: us.irc.core::Person) kind empirical {
    label en official "the real estate investment trust elects the application of section 965(m)(1)(B), so the section 951(a)(1) amount is included in the REIT's gross income over the 8-year schedule";
}
pub relation reit_inclusion_amount_965m1(shareholder: us.irc.core::Person, amount: Money) kind empirical {
    label en official "the amount required to be taken into account under section 951(a)(1) by reason of section 965 by the real estate investment trust";
}
pub relation reit_inclusion_share_965m1B(shareholder: us.irc.core::Person, year_index: Integer, amount: Money) kind institutional {
    label en official "the part of the amount included in the REIT's gross income in taxable year number year_index of the 8-year schedule: 8 percent for each of the 5 years starting with the year it would otherwise be included, then 15, 20 and 25 percent for the following three years (section 965(m)(1)(B)(i)-(iv))";
}
@source(IRC_S965_M, relation = formalizes, coverage = exact, quote = "(i) 8 percent of such amount in the case of each of the taxable years in the 5-taxable year period beginning with the taxable year in which such amount would otherwise be included.")
rule S965M1BREITSchedule defeasible {
    for shareholder: us.irc.core::Person;
    for k: Integer;
    for pct: Decimal;
    for amount: Money;
    when reit_us_shareholder_election_965m1B(shareholder)
     and reit_inclusion_amount_965m1(shareholder, amount)
     and installment_index_965h1(k)
     and installment_percentage_965h1(k, pct);
    then reit_inclusion_share_965m1B(shareholder, k, round(amount * pct, 2, "HALF_UP"));
}
pub relation elects_no_nol_965n(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the United States shareholder elects the application of section 965(n) for the taxable year";
}
pub relation section_960_deemed_paid_taxes_treated_as_dividend_under_78_965n2B(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "for a domestic corporation that chooses the credit benefits, the taxes deemed paid under section 960(a) and (b) with respect to the (n)(2)(A) amount that are treated as dividends under section 78";
}
pub relation amount_excluded_from_nol_computation_965n2(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the amount that is not taken into account in determining the net operating loss deduction under section 172 or the taxable income that may be reduced by carryovers or carrybacks: the section 951(a)(1) amount after subsection (c), plus the section 78 dividend from deemed-paid taxes (section 965(n)(1)-(2))";
}
@source(IRC_S965_N, relation = formalizes, coverage = exact, quote = "If a United States shareholder of a deferred foreign income corporation elects the application of this subsection for the taxable year described in subsection (a), then the amount described in paragraph (2) shall not be taken into account—")
rule S965N2AmountExcludedFromNol defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for included: Money;
    for deduction: Money;
    for dividend78: Money;
    when elects_no_nol_965n(shareholder, y)
     and amount_included_under_951a1_by_965(shareholder, y, included)
     and participation_exemption_deduction_965c1(shareholder, y, deduction)
     and section_960_deemed_paid_taxes_treated_as_dividend_under_78_965n2B(shareholder, y, dividend78);
    then amount_excluded_from_nol_computation_965n2(shareholder, y, (included - deduction) + dividend78);
}
