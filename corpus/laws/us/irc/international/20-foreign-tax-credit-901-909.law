// §901(b)(2)-(5),(c)-(g),(i)-(m); §903; §905; §906; §908; §909 — the
// foreign tax credit outside the §904 limitation formula (module 04) and the
// §907 oil-and-gas rules (module 21). Stage 2c (IRC-10 stage 2c, A13).
//
// Conventions: a creditable tax amount reaches the module-04 pipeline through
// `foreign_tax_credit_amount_allowed_before_limitation`; the disallowance
// rules of this module are stated as separate "disallowed"/"reduction"
// relations over case-supplied tax amounts rather than as edits of the
// module-04 input, because §901 (e)-(m) reduce the tax by fact patterns
// (holding periods, subsidies, boycotts) that the base rule cannot see
// (TECH-GAPS G1736 records that the reductions are not yet chained into the
// (b)(1) amount).

// --- §901(b)(2)-(5): who is allowed which taxes -----------------------------

use self::{
    IRC_S901_B,
    IRC_S901_C,
    IRC_S901_D,
    IRC_S901_E,
    IRC_S901_F,
    IRC_S901_G,
    IRC_S901_I,
    IRC_S901_J,
    IRC_S901_K,
    IRC_S901_L,
    IRC_S901_M,
    IRC_S903,
    IRC_S905_A,
    IRC_S905_B,
    IRC_S905_C,
    IRC_S906_A,
    IRC_S906_B,
    IRC_S908_A,
    IRC_S909_A,
    IRC_S909_D,
    Secretary,
    foreign_tax_credit_amount_allowed_before_limitation,
};

pub relation resident_of_us_or_bona_fide_puerto_rico_resident_901b(p: us.irc.core::Person) kind empirical {
    label en official "a resident of the United States, or an individual who is a bona fide resident of Puerto Rico during the entire taxable year, for section 901(b)(2)-(3)";
}
pub relation alien_resident_of_us_or_puerto_rico_901b3(p: us.irc.core::Person) kind empirical {
    label en official "an alien resident of the United States, or an alien individual who is a bona fide resident of Puerto Rico during the entire taxable year, for section 901(b)(3)";
}
pub relation possession_tax_paid_or_accrued_901b2(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "income, war profits and excess profits taxes paid or accrued during the taxable year to any possession of the United States, for section 901(b)(2)";
}
pub relation foreign_country_tax_paid_or_accrued_901b3(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "income, war profits and excess profits taxes paid or accrued during the taxable year to any foreign country, for section 901(b)(3)";
}
pub relation nonresident_alien_not_described_in_876_or_foreign_corp_901b4(p: us.irc.core::Person) kind empirical {
    label en official "a nonresident alien individual not described in section 876, or a foreign corporation, for section 901(b)(4)";
}
pub relation partner_or_beneficiary_share_of_taxes_901b5(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the amount of the person's proportionate share of the taxes paid or accrued by a partnership, estate or trust to a foreign country or possession, for a person described in (b)(1)-(4) who is a partner or beneficiary (section 901(b)(5))";
}
@source(IRC_S901_B, relation = formalizes, coverage = exact, quote = "In the case of a resident of the United States and in the case of an individual who is a bona fide resident of Puerto Rico during the entire taxable year, the amount of any such taxes paid or accrued during the taxable year to any possession of the United States; and")
rule S901B2ResidentPossessionTaxes strict {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when possession_tax_paid_or_accrued_901b2(p, y, amount)
     and resident_of_us_or_bona_fide_puerto_rico_resident_901b(p);
    then foreign_tax_credit_amount_allowed_before_limitation(p, y, amount);
}
@source(IRC_S901_B, relation = formalizes, coverage = exact, quote = "In the case of an alien resident of the United States and in the case of an alien individual who is a bona fide resident of Puerto Rico during the entire taxable year, the amount of any such taxes paid or accrued during the taxable year to any foreign country; and")
rule S901B3AlienResidentForeignCountryTaxes strict {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when foreign_country_tax_paid_or_accrued_901b3(p, y, amount)
     and alien_resident_of_us_or_puerto_rico_901b3(p);
    then foreign_tax_credit_amount_allowed_before_limitation(p, y, amount);
}
@source(IRC_S901_B, relation = formalizes, coverage = partial, quote = "In the case of any person described in paragraph (1), (2), (3), or (4), who is a member of a partnership or a beneficiary of an estate or trust, the amount of his proportionate share of the taxes (described in such paragraph) of the partnership or the estate or trust paid or accrued during the taxable year to a foreign country or to any possession of the United States, as the case may be.")
rule S901B5PartnerOrBeneficiaryProportionateShare strict {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when partner_or_beneficiary_share_of_taxes_901b5(p, y, amount);
    then foreign_tax_credit_amount_allowed_before_limitation(p, y, amount);
}

@source(IRC_S901_B, relation = formalizes, coverage = exact, quote = "In the case of any nonresident alien individual not described in section 876 and in the case of any foreign corporation, the amount determined pursuant to section 906; and")
rule S901B4NonresidentAlienAndForeignCorporationSection906Amount defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when nonresident_alien_not_described_in_876_or_foreign_corp_901b4(p)
     and credit_base_under_906a(p, y, amount);
    then foreign_tax_credit_amount_allowed_before_limitation(p, y, amount);
}

// --- §901(c): presidential proclamation (reciprocity) ------------------------

pub relation president_proclamation_in_effect_901c(country: Text, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the President has proclaimed, for taxable years beginning while the proclamation remains in effect, that the section 901(b)(3) credit is allowed to citizens or subjects of the country only if it allows a similar credit to United States citizens residing there (section 901(c))";
}
pub relation citizen_or_subject_of_country_901c(p: us.irc.core::Person, country: Text) kind empirical {
    label en unofficial "the person is a citizen or subject of the named foreign country";
}
pub relation country_allows_similar_credit_901c(country: Text) kind empirical {
    label en official "the foreign country, in imposing income, war profits and excess profits taxes, allows to citizens of the United States residing in it a credit for such taxes paid or accrued to the United States or any foreign country similar to the credit allowed under section 901(b)(3)";
}
pub relation credit_b3_conditioned_by_proclamation_901c(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the section 901(b)(3) credit is allowed to the person only if the country allows a similar credit (a proclamation is in effect for the year)";
}
pub relation credit_b3_denied_by_proclamation_901c(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the section 901(b)(3) credit is not allowed to the citizen or subject: a proclamation is in effect and the foreign country does not allow the similar credit";
}
@source(IRC_S901_C, relation = formalizes, coverage = partial, quote = "the President shall proclaim that, for taxable years beginning while the proclamation remains in effect, the credit under subsection (b)(3) shall be allowed to citizens or subjects of such foreign country only if such foreign country, in imposing income, war profits, and excess profits taxes, allows to citizens of the United Sta")
rule S901CProclamationConditionsB3Credit defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for country: Text;
    when citizen_or_subject_of_country_901c(p, country)
     and president_proclamation_in_effect_901c(country, y);
    then credit_b3_conditioned_by_proclamation_901c(p, y);
}
rule S901CProclamationDeniesWhereNoSimilarCredit defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for country: Text;
    when citizen_or_subject_of_country_901c(p, country)
     and president_proclamation_in_effect_901c(country, y)
     and not_known(country_allows_similar_credit_901c(country));
    then credit_b3_denied_by_proclamation_901c(p, y);
}
// The President's findings under (c)(1)-(3), including the public-interest
// finding, are committed to the President by the text (DECISION-0194
// external judgment, authority named in the label).
external judgment relation president_finds_901c_conditions(country: Text) {
    authority President;
    label en unofficial "the President finds that the foreign country does not allow a similar credit, has not acted on request to provide one, and that conditioning the credit is in the public interest (section 901(c)(1)-(3)); the finding belongs to the President, not to a court — the President is an organ constant declared by this package (TECH-GAPS G1737: core has no President organ)";
}

// --- §901(d): DISC dividends -------------------------------------------------

pub relation dividend_from_disc_or_former_disc_901d(item_id: Text) kind empirical {
    label en official "the item is a dividend from a DISC or former DISC (section 992(a))";
}
pub relation dividend_treated_as_foreign_source_under_part_i_901d(item_id: Text) kind empirical {
    label en official "the DISC dividend is treated under part I as income from sources without the United States";
}
pub relation disc_dividend_is_foreign_corporation_dividend_901d(item_id: Text) kind institutional {
    label en official "for purposes of the foreign tax credit subpart, dividends from a DISC or former DISC are treated as dividends from a foreign corporation to the extent treated under part I as foreign source income (section 901(d))";
}
@source(IRC_S901_D, relation = formalizes, coverage = exact, quote = "For purposes of this subpart, dividends from a DISC or former DISC (as defined in section 992(a)) shall be treated as dividends from a foreign corporation to the extent such dividends are treated under part I as income from sources without the United States.")
rule S901DDiscDividendIsForeignCorporationDividend defeasible {
    for item_id: Text;
    when dividend_from_disc_or_former_disc_901d(item_id)
     and dividend_treated_as_foreign_source_under_part_i_901d(item_id);
    then disc_dividend_is_foreign_corporation_dividend_901d(item_id);
}

// --- §901(e): foreign mineral income ----------------------------------------

pub relation foreign_mineral_income_taxes_901e(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "income, war profits and excess profits taxes paid or accrued to a foreign country or possession with respect to foreign mineral income from sources within it, which would (but for section 901(e)) be allowed under (b)";
}
pub relation us_tax_on_mineral_income_without_613_deduction_901e(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the tax which would be computed under this chapter with respect to the foreign mineral income determined without the deduction allowed under section 613 (percentage depletion), for section 901(e)(1)(A)";
}
pub relation us_tax_on_mineral_income_901e(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the amount of the tax computed under this chapter with respect to the foreign mineral income, for section 901(e)(1)(B)";
}
pub relation mineral_income_tax_reduction_901e(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the reduction of the creditable foreign mineral income taxes: the excess of the smaller of the foreign taxes and the US tax computed without the section 613 deduction over the US tax computed with it, floored at zero (section 901(e)(1))";
}
@source(IRC_S901_E, relation = formalizes, coverage = exact, quote = "(A) the amount of such taxes (or, if smaller, the amount of the tax which would be computed under this chapter with respect to such income determined without the deduction allowed under section 613), exceeds")
rule S901E1ReductionForMineralIncomeTaxes defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for foreign: Money;
    for wo613: Money;
    for with613: Money;
    when foreign_mineral_income_taxes_901e(p, y, foreign)
     and us_tax_on_mineral_income_without_613_deduction_901e(p, y, wo613)
     and us_tax_on_mineral_income_901e(p, y, with613);
    then mineral_income_tax_reduction_901e(p, y, max(0.00 USD, min(foreign, wo613) - with613));
}
pub relation mineral_income_taxes_allowed_after_reduction_901e(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the foreign mineral income taxes allowed under (b) after the section 901(e)(1) reduction";
}
rule S901E1AllowedAfterReduction defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for foreign: Money;
    for reduction: Money;
    when foreign_mineral_income_taxes_901e(p, y, foreign)
     and mineral_income_tax_reduction_901e(p, y, reduction);
    then mineral_income_taxes_allowed_after_reduction_901e(p, y, foreign - reduction);
}

// --- §901(f): oil or gas purchase and sale ----------------------------------

pub relation oil_or_gas_purchase_sale_tax_901f(p: us.irc.core::Person, tax_id: Text) kind empirical {
    label en official "income, profits and excess profits tax paid or accrued to a foreign country in connection with the purchase and sale of oil or gas extracted in that country";
}
pub relation taxpayer_has_economic_interest_611a_in_oil_or_gas_901f(p: us.irc.core::Person, tax_id: Text) kind empirical {
    label en official "the taxpayer has an economic interest in the oil or gas to which section 611(a) applies, for section 901(f)(1)";
}
pub relation price_differs_from_fair_market_value_901f(tax_id: Text) kind empirical {
    label en official "either the purchase or the sale is at a price which differs from the fair market value of the oil or gas at the time, for section 901(f)(2)";
}
pub relation oil_gas_tax_not_creditable_tax_901f(p: us.irc.core::Person, tax_id: Text) kind institutional {
    label en official "the tax is not considered tax for purposes of section 275(a) and the foreign tax credit subpart: the taxpayer has no economic interest in the oil or gas and the price differs from fair market value (section 901(f))";
}
@source(IRC_S901_F, relation = formalizes, coverage = exact, quote = "(1) the taxpayer has no economic interest in the oil or gas to which section 611(a) applies, and")
rule S901FNoEconomicInterestAndPriceDiffers defeasible {
    for p: us.irc.core::Person;
    for tax_id: Text;
    when oil_or_gas_purchase_sale_tax_901f(p, tax_id)
     and not_known(taxpayer_has_economic_interest_611a_in_oil_or_gas_901f(p, tax_id))
     and price_differs_from_fair_market_value_901f(tax_id);
    then oil_gas_tax_not_creditable_tax_901f(p, tax_id);
}

// --- §901(g): possessions-corporation distributions --------------------------

pub relation foreign_or_possession_tax_on_corporate_distribution_901g(p: us.irc.core::Person, tax_id: Text, amount: Money) kind empirical {
    label en official "tax of a foreign country or possession paid or accrued with respect to a distribution from a corporation, for section 901(g)(1)";
}
pub relation distribution_attributable_to_possessions_corporation_periods_901g1A(tax_id: Text) kind empirical {
    label en official "the distribution is attributable to periods during which the corporation is a possessions corporation (an election under former section 936 or section 931 status, section 901(g)(2)), to the extent so attributable";
}
pub relation distribution_qualifies_for_dividends_received_deduction_901g1Bi(tax_id: Text) kind empirical {
    label en official "a dividends received deduction is allowable with respect to the distribution under part VIII of subchapter B, section 901(g)(1)(B)(i)";
}
pub relation distribution_in_nonrecognition_liquidation_901g1Bii(tax_id: Text) kind empirical {
    label en official "the distribution is received in connection with a liquidation or other transaction with respect to which gain or loss is not recognized, to that extent, section 901(g)(1)(B)(ii)";
}
pub relation possessions_distribution_tax_not_creditable_and_not_deductible_901g(p: us.irc.core::Person, tax_id: Text) kind institutional {
    label en official "the tax is not treated as an income, war profits or excess profits tax paid or accrued to a foreign country or possession, and no deduction is allowed under this title for it (section 901(g)(1))";
}
@source(IRC_S901_G, relation = formalizes, coverage = exact, quote = "shall not be treated as income, war profits, or excess profits taxes paid or accrued to a foreign country or possession of the United States, and no deduction shall be allowed under this title with respect to any amount so paid or accrued.")
rule S901G1PossessionsCorporationDistributionByDrd defeasible {
    for p: us.irc.core::Person;
    for tax_id: Text;
    for amount: Money;
    when foreign_or_possession_tax_on_corporate_distribution_901g(p, tax_id, amount)
     and distribution_attributable_to_possessions_corporation_periods_901g1A(tax_id)
     and distribution_qualifies_for_dividends_received_deduction_901g1Bi(tax_id);
    then possessions_distribution_tax_not_creditable_and_not_deductible_901g(p, tax_id);
}
@source(IRC_S901_G, relation = formalizes, coverage = exact, quote = "shall not be treated as income, war profits, or excess profits taxes paid or accrued to a foreign country or possession of the United States, and no deduction shall be allowed under this title with respect to any amount so paid or accrued.")
rule S901G1PossessionsCorporationDistributionByNonrecognition defeasible {
    for p: us.irc.core::Person;
    for tax_id: Text;
    for amount: Money;
    when foreign_or_possession_tax_on_corporate_distribution_901g(p, tax_id, amount)
     and distribution_attributable_to_possessions_corporation_periods_901g1A(tax_id)
     and distribution_in_nonrecognition_liquidation_901g1Bii(tax_id);
    then possessions_distribution_tax_not_creditable_and_not_deductible_901g(p, tax_id);
}

// --- §901(i): subsidized taxes -----------------------------------------------

pub relation foreign_income_tax_amount_901i(p: us.irc.core::Person, tax_id: Text, amount: Money) kind empirical {
    label en official "the amount of income, war profits or excess profits tax paid or accrued";
}
pub relation tax_used_to_provide_subsidy_901i1(tax_id: Text, subsidy: Money) kind empirical {
    label en official "the amount of such tax used (directly or indirectly) by the imposing country to provide a subsidy by any means to the taxpayer, a related person (section 482) or any party to the transaction or a related transaction, section 901(i)(1)";
}
pub relation subsidy_determined_by_reference_to_tax_901i2(tax_id: Text) kind empirical {
    label en official "the subsidy is determined (directly or indirectly) by reference to the amount of the tax or the base used to compute it, section 901(i)(2)";
}
pub relation subsidized_tax_not_treated_as_tax_901i(p: us.irc.core::Person, tax_id: Text, amount: Money) kind institutional {
    label en official "the amount of the tax that is not treated as a tax for purposes of this title, to the extent of the subsidy (the lesser of the tax and the subsidy), section 901(i)";
}
@source(IRC_S901_I, relation = formalizes, coverage = exact, quote = "Any income, war profits, or excess profits tax shall not be treated as a tax for purposes of this title to the extent—")
rule S901ISubsidizedTaxToTheExtentOfSubsidy defeasible {
    for p: us.irc.core::Person;
    for tax_id: Text;
    for tax: Money;
    for subsidy: Money;
    when foreign_income_tax_amount_901i(p, tax_id, tax)
     and tax_used_to_provide_subsidy_901i1(tax_id, subsidy)
     and subsidy_determined_by_reference_to_tax_901i2(tax_id);
    then subsidized_tax_not_treated_as_tax_901i(p, tax_id, min(tax, subsidy));
}

// --- §901(j): certain foreign countries --------------------------------------

pub relation country_described_in_901j2A_since(country: Text, became_described_on: Date) kind empirical {
    label en official "the foreign country is one the United States does not recognize (unless eligible to purchase defense articles), has severed or does not conduct diplomatic relations with, or that is designated as repeatedly supporting terrorism (section 901(j)(2)(A)); the date on which it became such a country";
}
pub relation secretary_of_state_certifies_no_longer_described_on(country: Text, certified_on: Date) kind empirical {
    label en official "the Secretary of State certifies to the Secretary of the Treasury on this date that the country is no longer described in section 901(j)(2)(A) (section 901(j)(2)(B)(ii))";
}
pub relation secretary_of_state_certification_exists_901j(country: Text) kind institutional {
    label en official "the Secretary of State has certified that the country is no longer described in section 901(j)(2)(A) (existence of a certification, whatever its date)";
}
rule S901J2BiiCertificationExists defeasible {
    for country: Text;
    for certified: Date;
    when secretary_of_state_certifies_no_longer_described_on(country, certified);
    then secretary_of_state_certification_exists_901j(country);
}
pub relation president_waiver_901j5(country: Text) kind empirical {
    label en official "the President determines that a waiver is in the national interest and will expand trade and investment opportunities for US companies in the country, and reports the waiver to Congress not less than 30 days before it is granted (section 901(j)(5)(A)-(B))";
}
pub relation section_901j_period_begins_on(country: Text, begins: Date) kind institutional {
    label en official "the first day of the period during which section 901(j) applies to the country: the later of January 1, 1987 and 6 months after the country becomes a country described in (j)(2)(A) (section 901(j)(2)(B)(i))";
}
rule S901J2BiPeriodBeginsOnJanuary1987 defeasible {
    for country: Text;
    for became: Date;
    when country_described_in_901j2A_since(country, became)
     and add_calendar_period(became, 6 calendar_month) <= @1987-01-01;
    then section_901j_period_begins_on(country, @1987-01-01);
}
@source(IRC_S901_J, relation = formalizes, coverage = exact, quote = "(II) 6 months after such country becomes a country described in subparagraph (A), and")
rule S901J2BiPeriodBeginsSixMonthsAfter defeasible {
    for country: Text;
    for became: Date;
    when country_described_in_901j2A_since(country, became)
     and add_calendar_period(became, 6 calendar_month) > @1987-01-01;
    then section_901j_period_begins_on(country, add_calendar_period(became, 6 calendar_month));
}
pub relation income_attributable_to_901j_period_taxes(p: us.irc.core::Person, country: Text, y: us.irc.core::TaxableYear, tax: Money, income_period_start: Date) kind empirical {
    label en official "taxes paid or accrued (or deemed paid under section 960) to the country, with respect to income attributable to a period beginning on the given date";
}
pub relation section_901j_covers_income_period(country: Text, on: Date) kind institutional {
    label en official "the date falls within the period during which section 901(j) applies to the country: on or after the (j)(2)(B)(i) start and, if the Secretary of State has certified, before the certification date";
}
rule S901J2BPeriodCoversDateNoCertification defeasible {
    for country: Text;
    for start: Date;
    for on: Date;
    when section_901j_period_begins_on(country, start)
     and income_attributable_to_901j_period_dates(country, on)
     and on >= start
     and not_known(secretary_of_state_certification_exists_901j(country));
    then section_901j_covers_income_period(country, on);
}
pub relation income_attributable_to_901j_period_dates(country: Text, on: Date) kind empirical {
    label en unofficial "a date within the income period being tested for the section 901(j) period";
}
rule S901J2BPeriodCoversDateBeforeCertification defeasible {
    for country: Text;
    for start: Date;
    for certified: Date;
    for on: Date;
    when section_901j_period_begins_on(country, start)
     and income_attributable_to_901j_period_dates(country, on)
     and secretary_of_state_certifies_no_longer_described_on(country, certified)
     and on >= start
     and on < certified;
    then section_901j_covers_income_period(country, on);
}
pub relation tax_disallowed_as_credit_901j1A(p: us.irc.core::Person, country: Text, y: us.irc.core::TaxableYear, tax: Money) kind institutional {
    label en official "no credit is allowed under section 901(a) for the taxes paid or accrued (or deemed paid under section 960) to the country with respect to income attributable to a period during which section 901(j) applies (section 901(j)(1)(A))";
}
@source(IRC_S901_J, relation = formalizes, coverage = exact, quote = "(A) no credit shall be allowed under subsection (a) for any income, war profits, or excess profits taxes paid or accrued (or deemed paid under section 960) to any country if such taxes are with respect to income attributable to a period during which this subsection applies to such country, and")
rule S901J1ANoCreditForPeriodTaxes defeasible {
    for p: us.irc.core::Person;
    for country: Text;
    for y: us.irc.core::TaxableYear;
    for tax: Money;
    for period_start: Date;
    when income_attributable_to_901j_period_taxes(p, country, y, tax, period_start)
     and section_901j_covers_income_period(country, period_start);
    unless president_waiver_901j5(country)
     and income_attributable_to_901j_period_taxes(p, country, y, tax, period_start);
    then tax_disallowed_as_credit_901j1A(p, country, y, tax);
}

// --- §901(k): holding period for withholding taxes on dividends -------------

pub relation dividend_withholding_tax_901k(p: us.irc.core::Person, dividend_id: Text, tax: Money) kind empirical {
    label en official "a withholding tax (any tax determined on a gross basis, other than a prepayment of a net-basis tax) on a dividend with respect to stock in a corporation, section 901(k)(1)(B)";
}
pub relation days_stock_held_in_31_day_window_901k(p: us.irc.core::Person, dividend_id: Text, days: Integer) kind empirical {
    label en official "the number of days the recipient held the stock during the 31-day period beginning 15 days before the ex-dividend date (91-day period beginning 45 days before for long-period preference stock)";
}
pub relation preference_stock_dividend_for_period_over_366_days_901k3(dividend_id: Text) kind empirical {
    label en official "the stock has preference in dividends and the dividends are attributable to a period or periods aggregating more than 366 days, section 901(k)(3)";
}
pub relation obligation_to_make_related_payments_901k1Aii(p: us.irc.core::Person, dividend_id: Text) kind empirical {
    label en official "the recipient is under an obligation (pursuant to a short sale or otherwise) to make related payments with respect to positions in substantially similar or related property, section 901(k)(1)(A)(ii)";
}
pub relation securities_dealer_qualified_tax_exception_901k4(p: us.irc.core::Person, dividend_id: Text) kind empirical {
    label en official "the tax is a qualified tax with respect to a security held in the active conduct in a foreign country of a business as a securities dealer registered under the 1934 Act or licensed and regulated in that country, the dividend being taxed on a net basis there with a full credit for the tax (section 901(k)(4))";
}
pub relation holding_period_threshold_days_901k(dividend_id: Text, days: Integer) kind institutional {
    label en official "the holding-period threshold: 15 days generally, 45 days for preference stock with dividends attributable to more than 366 days (section 901(k)(1)(A)(i), (3))";
}
@source(IRC_S901_K, relation = formalizes, coverage = exact, quote = "(A) by substituting \"45 days\" for \"15 days\" each place it appears, and")
rule S901K3PreferenceStockThreshold45 defeasible {
    for d: Text;
    when preference_stock_dividend_for_period_over_366_days_901k3(d);
    then holding_period_threshold_days_901k(d, 45);
}
@source(IRC_S901_K, relation = formalizes, coverage = exact, quote = "(i) such stock is held by the recipient of the dividend for 15 days or less during the 31-day period beginning on the date which is 15 days before the date on which such share becomes ex-dividend with respect to such dividend, or")
rule S901K1GeneralThreshold15 defeasible {
    for p: us.irc.core::Person;
    for d: Text;
    for tax: Money;
    when dividend_withholding_tax_901k(p, d, tax);
    unless preference_stock_dividend_for_period_over_366_days_901k3(d)
     and dividend_withholding_tax_901k(p, d, tax);
    then holding_period_threshold_days_901k(d, 15);
}
pub relation withholding_tax_credit_denied_901k(p: us.irc.core::Person, dividend_id: Text, tax: Money) kind institutional {
    label en official "no credit is allowed under section 901(a) for the withholding tax on the dividend: the stock was held for the threshold number of days or less in the window, or the recipient is under an obligation to make related payments (section 901(k)(1)(A))";
}
@source(IRC_S901_K, relation = formalizes, coverage = exact, quote = "(i) such stock is held by the recipient of the dividend for 15 days or less during the 31-day period beginning on the date which is 15 days before the date on which such share becomes ex-dividend with respect to such dividend, or")
rule S901K1AiHoldingPeriodTooShort defeasible {
    for p: us.irc.core::Person;
    for d: Text;
    for tax: Money;
    for days: Integer;
    for threshold: Integer;
    when dividend_withholding_tax_901k(p, d, tax)
     and days_stock_held_in_31_day_window_901k(p, d, days)
     and holding_period_threshold_days_901k(d, threshold)
     and days <= threshold;
    unless securities_dealer_qualified_tax_exception_901k4(p, d)
     and dividend_withholding_tax_901k(p, d, tax);
    then withholding_tax_credit_denied_901k(p, d, tax);
}
@source(IRC_S901_K, relation = formalizes, coverage = exact, quote = "(ii) to the extent that the recipient of the dividend is under an obligation (whether pursuant to a short sale or otherwise) to make related payments with respect to positions in substantially similar or related property.")
rule S901K1AiiRelatedPaymentsObligation defeasible {
    for p: us.irc.core::Person;
    for d: Text;
    for tax: Money;
    when dividend_withholding_tax_901k(p, d, tax)
     and obligation_to_make_related_payments_901k1Aii(p, d);
    unless securities_dealer_qualified_tax_exception_901k4(p, d)
     and dividend_withholding_tax_901k(p, d, tax);
    then withholding_tax_credit_denied_901k(p, d, tax);
}
// §901(l): the same disallowance for any other property (15 days in a 31-day
// window starting 15 days before the date the right to payment arises), with
// the dealer exception of (l)(2).
pub relation property_item_withholding_tax_901l(p: us.irc.core::Person, item_id: Text, tax: Money) kind empirical {
    label en official "a withholding tax (section 901(k)) on an item of income or gain with respect to property other than a dividend to which section 901(k) applies, for section 901(l)(1)";
}
pub relation days_property_held_in_31_day_window_901l(p: us.irc.core::Person, item_id: Text, days: Integer) kind empirical {
    label en official "the number of days the recipient held the property during the 31-day period beginning 15 days before the date the right to receive payment of the item arises";
}
pub relation obligation_to_make_related_payments_901l1B(p: us.irc.core::Person, item_id: Text) kind empirical {
    label en official "the recipient is under an obligation (short sale or otherwise) to make related payments with respect to positions in substantially similar or related property, section 901(l)(1)(B)";
}
pub relation dealer_qualified_tax_exception_901l2(p: us.irc.core::Person, item_id: Text) kind empirical {
    label en official "the tax is a qualified tax with respect to property held in the active conduct in a foreign country of a business as a dealer in such property, the item taxed on a net basis there with a full credit for the tax (section 901(l)(2))";
}
pub relation property_withholding_tax_credit_denied_901l(p: us.irc.core::Person, item_id: Text, tax: Money) kind institutional {
    label en official "no credit is allowed under section 901(a) for the withholding tax on the item: the property was held for 15 days or less in the 31-day window, or the recipient is under a related-payments obligation (section 901(l)(1))";
}
@source(IRC_S901_L, relation = formalizes, coverage = exact, quote = "(A) such property is held by the recipient of the item for 15 days or less during the 31-day period beginning on the date which is 15 days before the date on which the right to receive payment of such item arises, or")
rule S901L1AHoldingPeriodTooShort defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    for tax: Money;
    for days: Integer;
    when property_item_withholding_tax_901l(p, item_id, tax)
     and days_property_held_in_31_day_window_901l(p, item_id, days)
     and days <= 15;
    unless dealer_qualified_tax_exception_901l2(p, item_id)
     and property_item_withholding_tax_901l(p, item_id, tax);
    then property_withholding_tax_credit_denied_901l(p, item_id, tax);
}
@source(IRC_S901_L, relation = formalizes, coverage = exact, quote = "(B) to the extent that the recipient of the item is under an obligation (whether pursuant to a short sale or otherwise) to make related payments with respect to positions in substantially similar or related property.")
rule S901L1BRelatedPaymentsObligation defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    for tax: Money;
    when property_item_withholding_tax_901l(p, item_id, tax)
     and obligation_to_make_related_payments_901l1B(p, item_id);
    unless dealer_qualified_tax_exception_901l2(p, item_id)
     and property_item_withholding_tax_901l(p, item_id, tax);
    then property_withholding_tax_credit_denied_901l(p, item_id, tax);
}

// --- §901(m): covered asset acquisitions ------------------------------------

pub relation foreign_income_tax_on_relevant_foreign_assets_901m(p: us.irc.core::Person, y: us.irc.core::TaxableYear, tax: Money) kind empirical {
    label en official "the foreign income tax determined with respect to the income or gain attributable to the relevant foreign assets of a covered asset acquisition";
}
pub relation aggregate_basis_differences_allocated_to_year_901m(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate basis differences (adjusted basis of each relevant foreign asset immediately after the acquisition minus immediately before, allocated to the taxable year by the applicable cost recovery method, with the disposition rule of (b)(ii)) — the allocation across years is asserted directly (TECH-GAPS G1738)";
}
pub relation income_on_which_foreign_tax_determined_901m(p: us.irc.core::Person, y: us.irc.core::TaxableYear, income: Money) kind empirical {
    label en official "the income on which the foreign income tax referred to in section 901(m)(1) is determined, as substantiated to the Secretary";
}
pub relation covered_asset_acquisition_901m2(p: us.irc.core::Person, acquisition_id: Text) kind empirical {
    label en official "a covered asset acquisition: a qualified stock purchase to which section 338(a) applies, a transaction treated as an asset acquisition for this chapter and a stock acquisition (or disregarded) for the foreign tax, a section 754 partnership-interest acquisition, or a similar transaction the Secretary provides (section 901(m)(2))";
}
pub relation disqualified_portion_901m3A(p: us.irc.core::Person, y: us.irc.core::TaxableYear, ratio: Decimal) kind institutional {
    label en official "the disqualified portion for the year: aggregate basis differences (but not below zero) divided by the income on which the foreign income tax is determined (section 901(m)(3)(A))";
}
@source(IRC_S901_M, relation = formalizes, coverage = exact, quote = "(i) the aggregate basis differences (but not below zero) allocable to such taxable year under subparagraph (B) with respect to all relevant foreign assets, divided by")
rule S901M3ADisqualifiedPortion defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for diff: Money;
    for income: Money;
    when aggregate_basis_differences_allocated_to_year_901m(p, y, diff)
     and income_on_which_foreign_tax_determined_901m(p, y, income)
     and income > 0.00 USD;
    then disqualified_portion_901m3A(p, y, max(0.00 USD, diff) / income);
}
pub relation disqualified_foreign_income_tax_901m1(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the disqualified portion of the foreign income tax: not taken into account in determining the credit allowed under subsection (a), nor, for a foreign corporation's tax, for section 960 (section 901(m)(1))";
}
@source(IRC_S901_M, relation = formalizes, coverage = exact, quote = "(A) shall not be taken into account in determining the credit allowed under subsection (a), and")
rule S901M1DisqualifiedPortionOfTax defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for acquisition_id: Text;
    for tax: Money;
    for ratio: Decimal;
    when covered_asset_acquisition_901m2(p, acquisition_id)
     and foreign_income_tax_on_relevant_foreign_assets_901m(p, y, tax)
     and disqualified_portion_901m3A(p, y, ratio);
    then disqualified_foreign_income_tax_901m1(p, y, round(tax * ratio, 2, "HALF_UP"));
}
// §901(m)(3)(A)(ii) parenthetical: when the taxpayer fails to substantiate
// the income, it is the tax divided by the highest marginal rate applicable
// to the income in the relevant jurisdiction.
pub relation highest_marginal_foreign_rate_901m(p: us.irc.core::Person, y: us.irc.core::TaxableYear, rate: Decimal) kind empirical {
    label en official "the highest marginal tax rate applicable to the income in the relevant jurisdiction, for the unsubstantiated-income fallback of section 901(m)(3)(A)(ii)";
}
pub relation income_not_substantiated_901m(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the taxpayer fails to substantiate the income to the satisfaction of the Secretary, section 901(m)(3)(A)(ii)";
}
pub relation deemed_income_when_unsubstantiated_901m(p: us.irc.core::Person, y: us.irc.core::TaxableYear, income: Money) kind institutional {
    label en official "the income deemed for the denominator when unsubstantiated: the foreign income tax divided by the highest marginal rate (section 901(m)(3)(A)(ii))";
}
@source(IRC_S901_M, relation = formalizes, coverage = partial, quote = "(ii) the income on which the foreign income tax referred to in paragraph (1) is determined (or, if the taxpayer fails to substantiate such income to the satisfaction of the Secretary, such income shall be determined by dividing the amount of such foreign income tax by the highest marginal tax rate applicable to such income in th")
rule S901M3AiiUnsubstantiatedIncomeFallback defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for tax: Money;
    for rate: Decimal;
    when income_not_substantiated_901m(p, y)
     and foreign_income_tax_on_relevant_foreign_assets_901m(p, y, tax)
     and highest_marginal_foreign_rate_901m(p, y, rate)
     and rate > 0.0;
    then deemed_income_when_unsubstantiated_901m(p, y, tax / rate);
}

// --- §903: taxes in lieu of income taxes ------------------------------------

pub relation tax_paid_in_lieu_of_generally_imposed_income_tax_903(p: us.irc.core::Person, tax_id: Text) kind empirical {
    label en official "a tax paid in lieu of a tax on income, war profits or excess profits otherwise generally imposed by a foreign country or possession (section 903)";
}
pub relation creditable_tax_class_income_war_profits_or_excess_profits_903(tax_id: Text) kind institutional {
    label en official "the tax is within the term `income, war profits, and excess profits taxes` for the foreign tax credit part and sections 164(a) and 275(a), by section 903";
}
@source(IRC_S903, relation = formalizes, coverage = exact, quote = "the term \"income, war profits, and excess profits taxes\" shall include a tax paid in lieu of a tax on income, war profits, or excess profits otherwise generally imposed by any foreign country or by any possession of the United States.")
rule S903InLieuTaxIsIncomeTax defeasible {
    for p: us.irc.core::Person;
    for tax_id: Text;
    when tax_paid_in_lieu_of_generally_imposed_income_tax_903(p, tax_id);
    then creditable_tax_class_income_war_profits_or_excess_profits_903(tax_id);
}

// --- §905: applicable rules --------------------------------------------------

pub relation elects_accrual_year_credit_905a(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the taxpayer elects, irrespective of the method of accounting employed in keeping the books, to take the credits in the year in which the foreign taxes accrued (section 905(a))";
}
pub relation credit_taken_in_year_of_accrual_905a(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the credit is taken in the year in which the tax of the foreign country or possession accrued (section 905(a))";
}
@source(IRC_S905_A, relation = formalizes, coverage = partial, quote = "The credits provided in this subpart may, at the option of the taxpayer and irrespective of the method of accounting employed in keeping his books, be taken in the year in which the taxes of the foreign country or the possession of the United States accrued")
rule S905AElectionAccrualYearCredit strict {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when elects_accrual_year_credit_905a(p, y);
    then power S905AAccrualYearElection {
        holder p;
        over p;
        exercise elects_accrual_year_credit_905a(p, y);
        valid_when elects_accrual_year_credit_905a(p, y);
        effect create(credit_taken_in_year_of_accrual_905a(p, y));
    };
}
pub relation taxpayer_establishes_total_foreign_source_income_905b1(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the taxpayer establishes to the satisfaction of the Secretary the total amount of income derived from sources without the United States, determined as provided in part I (section 905(b)(1))";
}
pub relation taxpayer_establishes_income_by_country_905b2(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the taxpayer establishes the amount of income derived from each country whose tax is claimed as a credit, determined under regulations (section 905(b)(2))";
}
pub relation taxpayer_furnishes_information_for_verification_905b3(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the taxpayer establishes all other information necessary for the verification and computation of the credits (section 905(b)(3))";
}
pub relation credit_allowed_proof_established_905b(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the credits are allowed only if the taxpayer establishes the section 905(b)(1)-(3) facts to the satisfaction of the Secretary";
}
@source(IRC_S905_B, relation = formalizes, coverage = exact, quote = "The credits provided in this subpart shall be allowed only if the taxpayer establishes to the satisfaction of the Secretary—")
rule S905BProofConditionMet defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when taxpayer_establishes_total_foreign_source_income_905b1(p, y)
     and taxpayer_establishes_income_by_country_905b2(p, y)
     and taxpayer_furnishes_information_for_verification_905b3(p, y);
    then credit_allowed_proof_established_905b(p, y);
}

// §905(c): redetermination events, notice, and no credit for unpaid taxes.
pub relation accrued_tax_when_paid_differs_from_claimed_905c1A(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "accrued taxes when paid differ from the amounts claimed as credits, section 905(c)(1)(A)";
}
pub relation accrued_tax_not_paid_within_two_years_905c1B(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "accrued taxes are not paid before the date 2 years after the close of the taxable year to which they relate, section 905(c)(1)(B)";
}
pub relation tax_paid_is_refunded_in_whole_or_part_905c1C(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "a tax paid is refunded in whole or in part, section 905(c)(1)(C)";
}
pub relation foreign_tax_redetermination_event_905c1(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "an event under section 905(c)(1)(A), (B) or (C) requires the taxpayer to notify the Secretary, who redetermines the tax for the year or years affected";
}
@source(IRC_S905_C, relation = formalizes, coverage = exact, quote = "(A) accrued taxes when paid differ from the amounts claimed as credits by the taxpayer,")
rule S905C1ARedeterminationEventPaidDiffers defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when accrued_tax_when_paid_differs_from_claimed_905c1A(p, y);
    then foreign_tax_redetermination_event_905c1(p, y);
}
@source(IRC_S905_C, relation = formalizes, coverage = exact, quote = "(B) accrued taxes are not paid before the date 2 years after the close of the taxable year to which such taxes relate, or")
rule S905C1BRedeterminationEventUnpaidTwoYears defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when accrued_tax_not_paid_within_two_years_905c1B(p, y);
    then foreign_tax_redetermination_event_905c1(p, y);
}
@source(IRC_S905_C, relation = formalizes, coverage = exact, quote = "(C) any tax paid is refunded in whole or in part,")
rule S905C1CRedeterminationEventRefund defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when tax_paid_is_refunded_in_whole_or_part_905c1C(p, y);
    then foreign_tax_redetermination_event_905c1(p, y);
}
pub relation secretary_notified_of_redetermination_event_905c1(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the taxpayer has notified the Secretary of the section 905(c)(1) event";
}
// The statute names no deadline for the notice ("the taxpayer shall notify"),
// so the goal window is unbounded; the periodic aspect is not modeled.
@source(IRC_S905_C, relation = formalizes, coverage = exact, quote = "the taxpayer shall notify the Secretary, who shall redetermine the amount of the tax for the year or years affected.")
rule S905C1DutyToNotifySecretary defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when foreign_tax_redetermination_event_905c1(p, y);
    then duty S905C1NotifySecretaryDuty {
        bearer p;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition secretary_notified_of_redetermination_event_905c1(p, y);
            window [-infinity, infinity];
        }
    };
}
pub relation credit_disallowed_for_unpaid_accrued_taxes_905c2A(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "in the redetermination, no credit is allowed for accrued taxes not paid before the date 2 years after the close of the taxable year (section 905(c)(2)(A))";
}
pub relation unpaid_tax_subsequently_paid_905c2B(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the accrued taxes are subsequently paid, section 905(c)(2)(B)";
}
pub relation late_paid_tax_taken_into_account_for_related_year_905c2B(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "taxes subsequently paid are taken into account for the taxable year to which they relate, translated as provided in section 986(a)(2)(A) (section 905(c)(2)(B))";
}
@source(IRC_S905_C, relation = formalizes, coverage = exact, quote = "Except as provided in subparagraph (B), in making the redetermination under paragraph (1), no credit shall be allowed for accrued taxes not paid before the date referred to in subparagraph (B) of paragraph (1).")
rule S905C2ANoCreditForUnpaidAccruedTaxes defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when accrued_tax_not_paid_within_two_years_905c1B(p, y);
    unless unpaid_tax_subsequently_paid_905c2B(p, y)
     and accrued_tax_not_paid_within_two_years_905c1B(p, y);
    then credit_disallowed_for_unpaid_accrued_taxes_905c2A(p, y);
}
@source(IRC_S905_C, relation = formalizes, coverage = exact, quote = "(i) shall be taken into account for the taxable year to which such taxes relate, and")
rule S905C2BSubsequentPaymentRelatesBack defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when accrued_tax_not_paid_within_two_years_905c1B(p, y)
     and unpaid_tax_subsequently_paid_905c2B(p, y);
    then late_paid_tax_taken_into_account_for_related_year_905c2B(p, y);
}
pub relation redetermined_tax_due_905c3(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the amount of tax due on redetermination under section 905(c)(1)";
}
pub relation payment_on_notice_and_demand_905c3(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the taxpayer has paid the redetermined amount on the Secretary's notice and demand";
}
@source(IRC_S905_C, relation = formalizes, coverage = exact, quote = "The amount of tax (if any) due on any redetermination under paragraph (1) shall be paid by the taxpayer on notice and demand by the Secretary")
rule S905C3DutyToPayRedeterminedTax defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when redetermined_tax_due_905c3(p, y, amount)
     and amount > 0.00 USD;
    then duty S905C3PayRedeterminedTaxDuty {
        bearer p;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition payment_on_notice_and_demand_905c3(p, y);
            window [-infinity, infinity];
        }
    };
}
pub relation secretary_requires_bond_905c4(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the Secretary requires the taxpayer, for a tax accrued but not paid, to give a bond with satisfactory sureties as a condition precedent to allowance of the credit (section 905(c)(4))";
}
pub relation bond_condition_imposed_905c4(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the bond condition is imposed on allowance of the credit for the accrued-but-unpaid tax";
}
@source(IRC_S905_C, relation = formalizes, coverage = partial, quote = "In the case of any tax accrued but not paid, the Secretary, as a condition precedent to the allowance of the credit provided in this subpart, may require the taxpayer to give a bond")
rule S905C4SecretaryMayRequireBond strict {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when secretary_requires_bond_905c4(p, y);
    then power S905C4RequireBondPower {
        holder Secretary;
        over p;
        exercise secretary_requires_bond_905c4(p, y);
        valid_when accrued_tax_not_paid_within_two_years_905c1B(p, y);
        effect create(bond_condition_imposed_905c4(p, y));
    };
}
pub relation refunded_foreign_tax_credited_905c5(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the amount of the refunded foreign taxes for which credit has been allowed";
}
pub relation foreign_tax_imposed_on_the_refund_905c5(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the tax described in section 901 imposed by the foreign country or possession with respect to the refund";
}
pub relation refunded_taxes_net_of_tax_on_refund_905c5(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "in a redetermination for a refund year, the amount of the taxes refunded for which credit was allowed is reduced by the tax imposed by the foreign country with respect to the refund (section 905(c)(5)), floored at zero";
}
@source(IRC_S905_C, relation = formalizes, coverage = partial, quote = "the amount of the taxes refunded for which credit has been allowed under this section shall be reduced by the amount of any tax described in section 901 imposed by the foreign country or possession of the United States with respect to such refund")
rule S905C5RefundReducedByTaxOnRefund defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for refunded: Money;
    for tax_on_refund: Money;
    when refunded_foreign_tax_credited_905c5(p, y, refunded)
     and foreign_tax_imposed_on_the_refund_905c5(p, y, tax_on_refund);
    then refunded_taxes_net_of_tax_on_refund_905c5(p, y, max(0.00 USD, refunded - tax_on_refund));
}

// --- §906: nonresident alien individuals and foreign corporations -----------

pub relation nonresident_alien_or_foreign_corp_engaged_in_us_business_906a(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "a nonresident alien individual or a foreign corporation engaged in trade or business within the United States during the taxable year, section 906(a)";
}
pub relation foreign_tax_on_effectively_connected_income_906a(p: us.irc.core::Person, y: us.irc.core::TaxableYear, tax: Money) kind empirical {
    label en official "income, war profits and excess profits taxes paid or accrued during the taxable year to any foreign country or possession with respect to income effectively connected with the conduct of a trade or business within the United States (section 906(a))";
}
pub relation foreign_tax_on_us_source_income_not_taxed_by_home_country_906b1(p: us.irc.core::Person, y: us.irc.core::TaxableYear, tax: Money) kind empirical {
    label en official "tax paid or accrued imposed with respect to income from sources within the United States which would not be taxed by the foreign country or possession if the taxpayer were a corporation created there / an individual citizen or resident of there (section 906(b)(1))";
}
pub relation credit_base_under_906a(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the credit base under section 906: foreign tax on effectively connected income, less any tax imposed on US-source income the country would not tax under section 906(b)(1)";
}
@source(IRC_S906_A, relation = formalizes, coverage = partial, quote = "A nonresident alien individual or a foreign corporation engaged in trade or business within the United States during the taxable year shall be allowed a credit under section 901 for the amount of any income, war profits, and excess profits taxes paid or accrued during the taxable year to any foreign country or possession of the United States with respect to income effectively connected with the conduct of a trade or")
rule S906ACreditBase defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for tax: Money;
    for excluded: Money;
    when nonresident_alien_or_foreign_corp_engaged_in_us_business_906a(p, y)
     and foreign_tax_on_effectively_connected_income_906a(p, y, tax)
     and foreign_tax_on_us_source_income_not_taxed_by_home_country_906b1(p, y, excluded);
    then credit_base_under_906a(p, y, max(0.00 USD, tax - excluded));
}
@source(IRC_S906_A, relation = formalizes, coverage = partial, quote = "A nonresident alien individual or a foreign corporation engaged in trade or business within the United States during the taxable year shall be allowed a credit under section 901 for the amount of any income, war profits, and excess profits taxes paid or accrued during the taxable year to any foreign country or possession of the United States with respect to income effectively connected with the conduct of a trade or")
rule S906ACreditBaseNoExcludedTax defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for tax: Money;
    when nonresident_alien_or_foreign_corp_engaged_in_us_business_906a(p, y)
     and foreign_tax_on_effectively_connected_income_906a(p, y, tax);
    unless foreign_tax_on_us_source_income_not_taxed_by_home_country_906b1(p, y, _)
     and nonresident_alien_or_foreign_corp_engaged_in_us_business_906a(p, y)
     and foreign_tax_on_effectively_connected_income_906a(p, y, tax);
    then credit_base_under_906a(p, y, tax);
}
pub relation section_906b2_taxable_income_effectively_connected_only(p: us.irc.core::Person, y: us.irc.core::TaxableYear, eci_taxable_income: Money) kind empirical {
    label en official "for the section 904 limitation, the taxpayer's taxable income is treated as consisting only of the taxable income effectively connected with the US trade or business (section 906(b)(2))";
}
pub relation tax_against_which_906_credit_not_allowed(p: us.irc.core::Person, y: us.irc.core::TaxableYear, kind: Text) kind institutional {
    label en official "the section 906 credit is not allowed against the named tax: section 871(a), section 881, or section 884 (section 906(b)(3), (b)(6))";
}
@source(IRC_S906_B, relation = formalizes, coverage = exact, quote = "(3) The credit allowed pursuant to subsection (a) shall not be allowed against any tax imposed by section 871(a) (relating to income of nonresident alien individual not connected with United States business) or 881 (relating to income of foreign corporations not connected with United States business).")
rule S906B3NoCreditAgainstFdapTax defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for tax: Money;
    when credit_base_under_906a(p, y, tax);
    then tax_against_which_906_credit_not_allowed(p, y, "871(a)/881");
}
@source(IRC_S906_B, relation = formalizes, coverage = exact, quote = "(6) No credit shall be allowed under this section against the tax imposed by section 884.")
rule S906B6NoCreditAgainstBranchProfitsTax defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for tax: Money;
    when credit_base_under_906a(p, y, tax);
    then tax_against_which_906_credit_not_allowed(p, y, "884");
}

// --- §908: reduction of credit for participation in or cooperation with an
// international boycott ------------------------------------------------------

pub relation participates_in_or_cooperates_with_international_boycott_908a(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the person, or a member of its controlled group (section 993(a)(3)), participates in or cooperates with an international boycott during the taxable year (within the meaning of section 999(b))";
}
pub relation credit_before_boycott_reduction_908a1(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the amount of the credit which, but for section 908, would be allowed under section 901 for the taxable year (or under section 960 to the shareholders)";
}
pub relation international_boycott_factor_908a2(p: us.irc.core::Person, y: us.irc.core::TaxableYear, factor: Decimal) kind empirical {
    label en official "the international boycott factor determined under section 999";
}
pub relation boycott_reduction_of_credit_908a(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the credit is reduced by the credit which would otherwise be allowed multiplied by the international boycott factor (section 908(a))";
}
@source(IRC_S908_A, relation = formalizes, coverage = exact, quote = "(1) the amount of the credit which, but for this section, would be allowed under section 901 for the taxable year, multiplied by")
rule S908AReductionByBoycottFactor defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for credit: Money;
    for factor: Decimal;
    when participates_in_or_cooperates_with_international_boycott_908a(p, y)
     and credit_before_boycott_reduction_908a1(p, y, credit)
     and international_boycott_factor_908a2(p, y, factor);
    then boycott_reduction_of_credit_908a(p, y, round(credit * factor, 2, "HALF_UP"));
}
pub relation credit_allowed_after_boycott_reduction_908a(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the credit allowable after the section 908(a) reduction";
}
rule S908ACreditAfterReduction defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for credit: Money;
    for reduction: Money;
    when credit_before_boycott_reduction_908a1(p, y, credit)
     and boycott_reduction_of_credit_908a(p, y, reduction);
    then credit_allowed_after_boycott_reduction_908a(p, y, credit - reduction);
}

// --- §909: foreign tax credit splitting events ------------------------------

pub relation foreign_income_tax_909(payor: us.irc.core::Person, tax_id: Text, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "income, war profits or excess profits tax paid or accrued to a foreign country or possession, for section 909";
}
pub relation related_income_taken_into_account_by_covered_person_909d1(tax_id: Text, covered_person: us.irc.core::Person) kind empirical {
    label en official "the related income (or earnings and profits) to which the tax relates is (or will be) taken into account under this chapter by a covered person";
}
pub relation covered_person_of_909d4(payor: us.irc.core::Person, other: us.irc.core::Person) kind institutional {
    label en official "a covered person of the payor: an entity in which the payor holds at least 10 percent (vote or value), a person holding at least 10 percent in the payor, a person related under section 267(b) or 707(b), or another person the Secretary specifies (section 909(d)(4))";
}
pub relation ownership_percent_909d4(holder: us.irc.core::Person, held: us.irc.core::Person, percent: Decimal) kind empirical {
    label en official "the percentage ownership interest (determined by vote or value, direct or indirect) that the holder has in the held person";
}
pub relation related_under_267b_or_707b_909d4C(a: us.irc.core::Person, b: us.irc.core::Person) kind empirical {
    label en official "a bears a relationship to b described in section 267(b) or 707(b)";
}
pub relation secretary_specifies_covered_person_909d4D(payor: us.irc.core::Person, other: us.irc.core::Person) kind empirical {
    label en official "the Secretary specifies the person as a covered person for purposes of section 909(d)(4)(D)";
}
@source(IRC_S909_D, relation = formalizes, coverage = exact, quote = "(A) any entity in which the payor holds, directly or indirectly, at least a 10 percent ownership interest (determined by vote or value),")
rule S909D4AEntityOwnedAtLeastTenPercentByPayor defeasible {
    for payor: us.irc.core::Person;
    for other: us.irc.core::Person;
    for pct: Decimal;
    when ownership_percent_909d4(payor, other, pct)
     and pct >= 10.0;
    then covered_person_of_909d4(payor, other);
}
@source(IRC_S909_D, relation = formalizes, coverage = exact, quote = "(B) any person which holds, directly or indirectly, at least a 10 percent ownership interest (determined by vote or value) in the payor,")
rule S909D4BPersonHoldingAtLeastTenPercentInPayor defeasible {
    for payor: us.irc.core::Person;
    for other: us.irc.core::Person;
    for pct: Decimal;
    when ownership_percent_909d4(other, payor, pct)
     and pct >= 10.0;
    then covered_person_of_909d4(payor, other);
}
@source(IRC_S909_D, relation = formalizes, coverage = exact, quote = "(C) any person which bears a relationship to the payor described in section 267(b) or 707(b), and")
rule S909D4CRelatedPerson defeasible {
    for payor: us.irc.core::Person;
    for other: us.irc.core::Person;
    when related_under_267b_or_707b_909d4C(payor, other);
    then covered_person_of_909d4(payor, other);
}
@source(IRC_S909_D, relation = formalizes, coverage = exact, quote = "(D) any other person specified by the Secretary for purposes of this paragraph.")
rule S909D4DSecretarySpecified defeasible {
    for payor: us.irc.core::Person;
    for other: us.irc.core::Person;
    when secretary_specifies_covered_person_909d4D(payor, other);
    then covered_person_of_909d4(payor, other);
}
pub relation foreign_tax_credit_splitting_event_909d1(payor: us.irc.core::Person, tax_id: Text) kind institutional {
    label en official "there is a foreign tax credit splitting event with respect to the tax: the related income is (or will be) taken into account by a covered person (section 909(d)(1))";
}
@source(IRC_S909_D, relation = formalizes, coverage = exact, quote = "There is a foreign tax credit splitting event with respect to a foreign income tax if the related income is (or will be) taken into account under this chapter by a covered person.")
rule S909D1SplittingEvent defeasible {
    for payor: us.irc.core::Person;
    for covered: us.irc.core::Person;
    for tax_id: Text;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when foreign_income_tax_909(payor, tax_id, y, amount)
     and related_income_taken_into_account_by_covered_person_909d1(tax_id, covered)
     and covered_person_of_909d4(payor, covered);
    then foreign_tax_credit_splitting_event_909d1(payor, tax_id);
}
pub relation year_related_income_taken_into_account_909(tax_id: Text, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the taxable year in which the related income is taken into account under this chapter by the taxpayer (or by the specified 10-percent owned foreign corporation or its United States shareholder, subsection (b))";
}
pub relation foreign_income_tax_taken_into_account_in_year_909(payor: us.irc.core::Person, tax_id: Text, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the tax is taken into account for purposes of this title only in the taxable year in which the related income is taken into account: not before that year (section 909(a)); section 909(c)(2): then treated as paid or accrued in that year";
}
@source(IRC_S909_A, relation = formalizes, coverage = exact, quote = "such tax shall not be taken into account for purposes of this title before the taxable year in which the related income is taken into account under this chapter by the taxpayer.")
rule S909ATaxSuspendedUntilRelatedIncomeYear defeasible {
    for payor: us.irc.core::Person;
    for tax_id: Text;
    for y_paid: us.irc.core::TaxableYear;
    for amount: Money;
    for y_income: us.irc.core::TaxableYear;
    when foreign_income_tax_909(payor, tax_id, y_paid, amount)
     and foreign_tax_credit_splitting_event_909d1(payor, tax_id)
     and year_related_income_taken_into_account_909(tax_id, y_income);
    then foreign_income_tax_taken_into_account_in_year_909(payor, tax_id, y_income);
}
pub relation splitting_tax_not_taken_into_account_before_related_year_909(payor: us.irc.core::Person, tax_id: Text, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the tax is not taken into account for the given earlier taxable year because a splitting event exists and the related income has not yet been taken into account (section 909(a))";
}
rule S909ANotTakenIntoAccountBeforeRelatedYear defeasible {
    for payor: us.irc.core::Person;
    for tax_id: Text;
    for y_paid: us.irc.core::TaxableYear;
    for amount: Money;
    when foreign_income_tax_909(payor, tax_id, y_paid, amount)
     and foreign_tax_credit_splitting_event_909d1(payor, tax_id);
    then splitting_tax_not_taken_into_account_before_related_year_909(payor, tax_id, y_paid);
}
