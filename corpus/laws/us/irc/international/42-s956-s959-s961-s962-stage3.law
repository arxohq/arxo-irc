// Stage 3 (TECH_GAP reduction), module 42: section 956(b), (c)(2), (c)(3); section 959(b), (c), (e), (f);
// section 961(c), (d); section 962(a)(2), (c), (d). Status implemented_unverified: not a legal review;
// scenarios in tests/s956-s962-stage3.lawtest are written, NOT executed.
//
// Modeling notes.
//  * The twelve section 956(c)(2)(A)-(L) exceptions are derived one by one from case facts about the
//    asset; the earlier case-asserted flag `us_property_956_excepted` (module 14) stays as an
//    override input, and the four (c)(1) rules read both (`unless` on each).
//  * The section 316(a) sub-order inside section 959(c) (current earnings before accumulated) is
//    not modeled: the three (c)(1)-(3) buckets are case inputs, already split by that order.
//  * Exact shares: `div_round`; the statute names no rounding, cents HALF_UP (JUDGMENT CALL).

// --- §956(b)(1): applicable earnings ---------------------------------------------------------------

use self::{
    IRC_S956_A,
    IRC_S956_B,
    IRC_S956_C,
    IRC_S959_B,
    IRC_S959_C,
    IRC_S959_E,
    IRC_S959_F,
    IRC_S961_C,
    IRC_S961_D,
    IRC_S962_A,
    IRC_S962_C,
    IRC_S962_D,
    section_962_election_effective,
    shareholder_pro_rata_applicable_earnings_956,
    shareholder_stock_ownership_share_958a_956,
    us_property_956,
};

pub relation accumulated_earnings_prior_years_316a1_956b1A(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the amount referred to in section 316(a)(1) (earnings and profits accumulated after February 28, 1913) to the extent accumulated in prior taxable years (a deficit is not included: enter the amount as reported, the rule takes the positive part)";
}
pub relation current_year_earnings_316a2_956b1B(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the amount referred to in section 316(a)(2): the earnings and profits of the taxable year";
}
pub relation distributions_made_during_year_956b1(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "distributions made by the controlled foreign corporation during the taxable year";
}
pub relation earnings_described_in_959c1_956b1(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "earnings and profits described in section 959(c)(1)";
}
pub relation applicable_earnings_derived_956b1(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "applicable earnings: the sum of the positive accumulated prior-year earnings and the current-year earnings, reduced by distributions made during the year and by section 959(c)(1) earnings; floored at zero (JUDGMENT CALL: the statute does not say what a negative result means)";
}
@source(IRC_S956_B, relation = formalizes, coverage = exact, quote = "but reduced by distributions made during the taxable year and by earnings and profits described in section")
rule S956B1ApplicableEarningsDerived defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for accumulated: Money;
    for current: Money;
    for distributions: Money;
    for ptep: Money;
    when accumulated_earnings_prior_years_316a1_956b1A(corp, y, accumulated)
     and current_year_earnings_316a2_956b1B(corp, y, current)
     and distributions_made_during_year_956b1(corp, y, distributions)
     and earnings_described_in_959c1_956b1(corp, y, ptep);
    then applicable_earnings_derived_956b1(corp, y, max(max(accumulated, 0.00 USD) + current - distributions - ptep, 0.00 USD));
}
// The section 956(a)(2) alternative read from the derived applicable earnings (module 14 reads the asserted figure).
@source(IRC_S956_A, relation = formalizes, coverage = exact, quote = "such shareholder's pro rata share of the applicable earnings of such controlled foreign corporation")
rule S956A2ProRataDerivedApplicableEarnings defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for earnings: Money;
    for share: Decimal;
    when applicable_earnings_derived_956b1(corp, y, earnings)
     and shareholder_stock_ownership_share_958a_956(shareholder, corp, y, share);
    then shareholder_pro_rata_applicable_earnings_956(shareholder, corp, y, earnings * share);
}

// --- §956(b)(2): property acquired before the corporation was a controlled foreign corporation ----

pub relation aggregate_us_property_acquired_before_cfc_status_956b2(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate amount of the items of United States property acquired by the corporation before the first day on which it was treated as a controlled foreign corporation (asserted directly: a sum over items)";
}
pub relation applicable_earnings_accumulated_before_cfc_status_956b2(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the portion of the applicable earnings of the corporation accumulated during periods before the first day it was treated as a controlled foreign corporation";
}
pub relation us_property_disregarded_amount_956b2(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the amount of pre-controlled-foreign-corporation United States property disregarded in applying subsection (a): not more than the applicable earnings accumulated before that first day";
}
@source(IRC_S956_B, relation = formalizes, coverage = exact, quote = "In applying subsection (a) to any taxable year, there shall be disregarded any item of United States property")
rule S956B2DisregardedPreCfcProperty defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for property_amount: Money;
    for earnings: Money;
    when aggregate_us_property_acquired_before_cfc_status_956b2(corp, y, property_amount)
     and applicable_earnings_accumulated_before_cfc_status_956b2(corp, y, earnings);
    then us_property_disregarded_amount_956b2(corp, y, min(property_amount, earnings));
}

// --- §956(b)(3): a foreign corporation that ceases to be a controlled foreign corporation ---------

pub relation corporation_ceases_to_be_cfc_in_year_956b3(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, last_cfc_day: Date) kind empirical {
    label en official "the foreign corporation ceases to be a controlled foreign corporation during the taxable year; the date is the last day during the year on which it is a controlled foreign corporation";
}
pub relation pro_rata_share_determination_date_956b3A(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, on: Date) kind institutional {
    label en official "the date on which a United States shareholder's pro rata share is determined: the stock owned (section 958(a)) on the last day of the year on which the corporation is a controlled foreign corporation";
}
@source(IRC_S956_B, relation = formalizes, coverage = exact, quote = "(A) the determination of any United States shareholder's pro rata share shall be made on the basis of stock")
rule S956B3APRoRataShareDate defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for last_day: Date;
    when corporation_ceases_to_be_cfc_in_year_956b3(corp, y, last_day);
    then pro_rata_share_determination_date_956b3A(corp, y, last_day);
}
pub relation quarter_end_of_year_956a1A(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, quarter_end: Date) kind empirical {
    label en official "the close of a quarter of the taxable year, for the section 956(a)(1)(A) average";
}
pub relation quarter_end_counted_in_average_956b3B(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, quarter_end: Date) kind institutional {
    label en official "a quarter ending on or before the last day the corporation is a controlled foreign corporation is taken into account in the average; later quarters are not";
}
@source(IRC_S956_B, relation = formalizes, coverage = exact, quote = "(B) the average referred to in subsection (a)(1)(A) for such taxable year shall be determined by only taking")
rule S956B3BQuartersEndingOnOrBeforeLastCfcDay defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for quarter_end: Date;
    for last_day: Date;
    when corporation_ceases_to_be_cfc_in_year_956b3(corp, y, last_day)
     and quarter_end_of_year_956a1A(corp, y, quarter_end)
     and quarter_end <= last_day;
    then quarter_end_counted_in_average_956b3B(corp, y, quarter_end);
}
pub relation days_as_cfc_in_year_956b3C(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, cfc_days: Integer, year_days: Integer) kind empirical {
    label en official "the number of days of the taxable year during which the corporation is a controlled foreign corporation, and the number of days in the year";
}
pub relation current_year_earnings_allocable_to_cfc_period_956b3C(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the portion of the section 316(a)(2) amount allocable, pro rata by days, to the part of the year during which the corporation is a controlled foreign corporation";
}
@source(IRC_S956_B, relation = formalizes, coverage = exact, quote = "(C) in determining applicable earnings, the amount taken into account by reason of being described in")
rule S956B3CCurrentEarningsProRataByDays defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for last_day: Date;
    for current: Money;
    for cfc_days: Integer;
    for year_days: Integer;
    when corporation_ceases_to_be_cfc_in_year_956b3(corp, y, last_day)
     and current_year_earnings_316a2_956b1B(corp, y, current)
     and days_as_cfc_in_year_956b3C(corp, y, cfc_days, year_days)
     and year_days > 0;
    then current_year_earnings_allocable_to_cfc_period_956b3C(corp, y, div_round(current * (cfc_days * 1.00), year_days * 1.00, 2, "HALF_UP"));
}

// --- §956(c)(2): the twelve exceptions ------------------------------------------------------------------

pub relation asset_is_us_obligation_or_money_956c2A(asset: Text) kind empirical {
    label en official "the asset is an obligation of the United States or money";
}
pub relation deposit_with_bank_956c2Ai(asset: Text) kind empirical {
    label en official "the asset is a deposit with a bank (as defined by section 2(c) of the Bank Holding Company Act of 1956, without regard to subparagraphs (C) and (G) of paragraph (2))";
}
pub relation deposit_with_corporation_owned_by_bank_holding_company_956c2Aii(asset: Text, vote_percent: Decimal, value_percent: Decimal) kind empirical {
    label en official "the asset is a deposit with a corporation not a bank with respect to which a bank holding company or financial holding company owns directly or indirectly the given percentages by vote and by value of the stock";
}
pub relation asset_purchased_in_us_for_export_or_foreign_use_956c2B(asset: Text) kind empirical {
    label en official "property located in the United States which is purchased in the United States for export to, or use in, foreign countries";
}
pub relation sale_or_processing_obligation_956c2C(asset: Text, maximum_outstanding: Money, ordinary_and_necessary_amount: Money) kind empirical {
    label en official "an obligation of a United States person arising in connection with the sale or processing of property: the largest amount outstanding during the year, and the amount that would be ordinary and necessary to carry on the trade or business of both parties had the transaction been between unrelated persons (a necessary-judgment amount supplied by the case, DECISION-0194 channel: the Secretary or court)";
}
pub relation asset_is_transport_equipment_956c2D(asset: Text) kind empirical {
    label en official "the asset is an aircraft, railroad rolling stock, vessel, motor vehicle, or container";
}
pub relation used_in_transportation_in_foreign_commerce_956c2D(asset: Text) kind empirical {
    label en official "the asset is used in the transportation of persons or property in foreign commerce";
}
pub relation used_predominantly_outside_us_956c2D(asset: Text) kind empirical {
    label en official "the asset is used predominantly outside the United States";
}
pub relation insurance_company_assets_for_953e2_contracts_956c2E(asset: Text) kind empirical {
    label en official "an amount of assets of an insurance company equivalent to the unearned premiums or reserves ordinary and necessary for the proper conduct of its insurance business attributable to contracts described in section 953(e)(2)";
}
pub relation stock_or_obligation_of_domestic_corporation_956c2F(asset: Text, us_shareholders_percent: Decimal) kind empirical {
    label en official "stock or an obligation of a domestic corporation that is not a United States shareholder (section 951(b)) of the controlled foreign corporation; the percentage of its total combined voting power owned or considered owned by such United States shareholders in the aggregate immediately after the acquisition";
}
pub relation movable_property_for_ocean_resources_956c2G(asset: Text) kind empirical {
    label en official "movable property used to explore for, develop, remove or transport resources from ocean waters or under them, when used on the Continental Shelf of the United States";
}
pub relation asset_is_vessel_or_aircraft_956c2G(asset: Text) kind empirical {
    label en official "the asset is a vessel or aircraft";
}
pub relation asset_equal_to_952b_excluded_earnings_956c2H(asset: Text) kind empirical {
    label en official "an amount of assets of the controlled foreign corporation equal to the earnings and profits accumulated after December 31, 1962, and excluded from subpart F income under section 952(b)";
}
pub relation dealer_deposit_on_commercial_terms_956c2I(asset: Text) kind empirical {
    label en official "a deposit of cash or securities made or received on commercial terms in the ordinary course of a United States or foreign person's business as a dealer in securities or commodities (section 475(c)(1), (e); a futures commission merchant is included)";
}
pub relation deposit_as_collateral_for_listed_contract_956c2Ii(asset: Text) kind empirical {
    label en official "the deposit is made or received as collateral or margin for a securities loan, notional principal contract, options contract, forward contract or futures contract";
}
pub relation deposit_as_collateral_for_customary_transaction_956c2Iii(asset: Text) kind empirical {
    label en official "the deposit is collateral or margin for another financial transaction in which the Secretary determines that it is customary to post collateral or margin";
}
pub relation dealer_obligation_backed_by_securities_956c2J(asset: Text, principal: Money, securities_fair_market_value: Money) kind empirical {
    label en official "an obligation of a United States person of a dealer: its principal amount, and the fair market value of readily marketable securities sold or purchased under a repurchase agreement or otherwise posted or received as collateral for it in the ordinary course of business";
}
pub relation dealer_securities_held_in_ordinary_course_956c2K(asset: Text) kind empirical {
    label en official "securities acquired and held by the controlled foreign corporation in the ordinary course of its business as a dealer in securities";
}
pub relation dealer_accounts_securities_as_held_for_sale_to_customers_956c2Ki(asset: Text) kind empirical {
    label en official "the dealer accounts for the securities as securities held primarily for sale to customers in the ordinary course of business";
}
pub relation dealer_disposes_within_customer_sale_period_956c2Kii(asset: Text) kind empirical {
    label en official "the dealer disposes of the securities (or they mature while held) within a period consistent with the holding of securities for sale to customers in the ordinary course of business";
}
pub relation obligation_of_noncorporate_us_person_956c2L(asset: Text) kind empirical {
    label en official "an obligation of a United States person that is not a domestic corporation";
}
pub relation obligor_is_us_shareholder_956c2Lii_I(asset: Text) kind empirical {
    label en official "the obligor is a United States shareholder (section 951(b)) of the controlled foreign corporation";
}
pub relation obligor_is_pass_through_with_cfc_or_related_person_956c2Lii_II(asset: Text) kind empirical {
    label en official "the obligor is a partnership, estate or trust in which the controlled foreign corporation, or a related person (section 954(d)(3)), is a partner, beneficiary or trustee immediately after the acquisition of any of its obligations by the controlled foreign corporation";
}
pub relation us_property_956_exception_applies(asset: Text) kind institutional {
    label en official "the asset falls within one of the section 956(c)(2)(A)-(L) exceptions, so it is not United States property";
}
@source(IRC_S956_C, relation = formalizes, coverage = exact, quote = "(A) obligations of the United States, money, or deposits with—")
rule S956C2AObligationOfUnitedStatesOrMoney defeasible {
    for asset: Text;
    when asset_is_us_obligation_or_money_956c2A(asset);
    then us_property_956_exception_applies(asset);
}
@source(IRC_S956_C, relation = formalizes, coverage = exact, quote = "(i) any bank (as defined by section 2(c) of the Bank Holding Company Act of 1956 (12 U.S.C. 1841(c)), without")
rule S956C2AiDepositWithBank defeasible {
    for asset: Text;
    when deposit_with_bank_956c2Ai(asset);
    then us_property_956_exception_applies(asset);
}
@source(IRC_S956_C, relation = formalizes, coverage = exact, quote = "(ii) any corporation not described in clause (i) with respect to which a bank holding company (as defined by")
rule S956C2AiiDepositWithBankHoldingCompanyAffiliateByVote defeasible {
    for asset: Text;
    for vote: Decimal;
    for value: Decimal;
    when deposit_with_corporation_owned_by_bank_holding_company_956c2Aii(asset, vote, value)
     and vote > 80.0;
    then us_property_956_exception_applies(asset);
}
@source(IRC_S956_C, relation = formalizes, coverage = exact, quote = "(ii) any corporation not described in clause (i) with respect to which a bank holding company (as defined by")
rule S956C2AiiDepositWithBankHoldingCompanyAffiliateByValue defeasible {
    for asset: Text;
    for vote: Decimal;
    for value: Decimal;
    when deposit_with_corporation_owned_by_bank_holding_company_956c2Aii(asset, vote, value)
     and value > 80.0;
    then us_property_956_exception_applies(asset);
}
@source(IRC_S956_C, relation = formalizes, coverage = exact, quote = "(B) property located in the United States which is purchased in the United States for export to, or use in,")
rule S956C2BPurchasedInUsForExportOrForeignUse defeasible {
    for asset: Text;
    when asset_purchased_in_us_for_export_or_foreign_use_956c2B(asset);
    then us_property_956_exception_applies(asset);
}
@source(IRC_S956_C, relation = formalizes, coverage = exact, quote = "(C) any obligation of a United States person arising in connection with the sale or processing of property if")
rule S956C2CSaleOrProcessingObligationWithinOrdinaryAndNecessary defeasible {
    for asset: Text;
    for maximum: Money;
    for ordinary: Money;
    when sale_or_processing_obligation_956c2C(asset, maximum, ordinary)
     and maximum <= ordinary;
    then us_property_956_exception_applies(asset);
}
@source(IRC_S956_C, relation = formalizes, coverage = exact, quote = "(D) any aircraft, railroad rolling stock, vessel, motor vehicle, or container used in the transportation of")
rule S956C2DTransportEquipmentInForeignCommerce defeasible {
    for asset: Text;
    when asset_is_transport_equipment_956c2D(asset)
     and used_in_transportation_in_foreign_commerce_956c2D(asset)
     and used_predominantly_outside_us_956c2D(asset);
    then us_property_956_exception_applies(asset);
}
@source(IRC_S956_C, relation = formalizes, coverage = exact, quote = "(E) an amount of assets of an insurance company equivalent to the unearned premiums or reserves ordinary and")
rule S956C2EInsuranceAssetsForReserves defeasible {
    for asset: Text;
    when insurance_company_assets_for_953e2_contracts_956c2E(asset);
    then us_property_956_exception_applies(asset);
}
@source(IRC_S956_C, relation = formalizes, coverage = exact, quote = "(F) the stock or obligations of a domestic corporation which is neither a United States shareholder (as")
rule S956C2FDomesticCorporationNotUsShareholderNorTwentyFivePercentOwned defeasible {
    for asset: Text;
    for percent: Decimal;
    when stock_or_obligation_of_domestic_corporation_956c2F(asset, percent)
     and percent < 25.0;
    then us_property_956_exception_applies(asset);
}
@source(IRC_S956_C, relation = formalizes, coverage = exact, quote = "(G) any movable property (other than a vessel or aircraft) which is used for the purpose of exploring for,")
rule S956C2GOceanResourceEquipment defeasible {
    for asset: Text;
    when movable_property_for_ocean_resources_956c2G(asset);
    unless asset_is_vessel_or_aircraft_956c2G(asset)
     and movable_property_for_ocean_resources_956c2G(asset);
    then us_property_956_exception_applies(asset);
}
@source(IRC_S956_C, relation = formalizes, coverage = exact, quote = "(H) an amount of assets of the controlled foreign corporation equal to the earnings and profits accumulated")
rule S956C2HAssetsEqualTo952bExcludedEarnings defeasible {
    for asset: Text;
    when asset_equal_to_952b_excluded_earnings_956c2H(asset);
    then us_property_956_exception_applies(asset);
}
@source(IRC_S956_C, relation = formalizes, coverage = exact, quote = "(I) deposits of cash or securities made or received on commercial terms in the ordinary course of a United")
rule S956C2IDealerCollateralForListedContract defeasible {
    for asset: Text;
    when dealer_deposit_on_commercial_terms_956c2I(asset)
     and deposit_as_collateral_for_listed_contract_956c2Ii(asset);
    then us_property_956_exception_applies(asset);
}
@source(IRC_S956_C, relation = formalizes, coverage = exact, quote = "(I) deposits of cash or securities made or received on commercial terms in the ordinary course of a United")
rule S956C2IDealerCollateralForCustomaryTransaction defeasible {
    for asset: Text;
    when dealer_deposit_on_commercial_terms_956c2I(asset)
     and deposit_as_collateral_for_customary_transaction_956c2Iii(asset);
    then us_property_956_exception_applies(asset);
}
@source(IRC_S956_C, relation = formalizes, coverage = partial, quote = "(J) an obligation of a United States person to the extent the principal amount of the obligation does not")
rule S956C2JDealerObligationWithinSecurities defeasible {
    for asset: Text;
    for principal: Money;
    for securities: Money;
    when dealer_obligation_backed_by_securities_956c2J(asset, principal, securities)
     and principal <= securities;
    then us_property_956_exception_applies(asset);
}
pub relation obligation_excepted_amount_956c2J(asset: Text, amount: Money) kind institutional {
    label en official "the part of the dealer's obligation excepted: the principal amount to the extent it does not exceed the fair market value of the securities (the asset-level exception applies only when the whole principal is covered)";
}
@source(IRC_S956_C, relation = formalizes, coverage = exact, quote = "(J) an obligation of a United States person to the extent the principal amount of the obligation does not")
rule S956C2JExceptedAmount defeasible {
    for asset: Text;
    for principal: Money;
    for securities: Money;
    when dealer_obligation_backed_by_securities_956c2J(asset, principal, securities);
    then obligation_excepted_amount_956c2J(asset, min(principal, securities));
}
@source(IRC_S956_C, relation = formalizes, coverage = exact, quote = "(K) securities acquired and held by a controlled foreign corporation in the ordinary course of its business")
rule S956C2KDealerSecurities defeasible {
    for asset: Text;
    when dealer_securities_held_in_ordinary_course_956c2K(asset)
     and dealer_accounts_securities_as_held_for_sale_to_customers_956c2Ki(asset)
     and dealer_disposes_within_customer_sale_period_956c2Kii(asset);
    then us_property_956_exception_applies(asset);
}
@source(IRC_S956_C, relation = formalizes, coverage = exact, quote = "(L) an obligation of a United States person which—")
rule S956C2LObligationOfNoncorporateUsPerson defeasible {
    for asset: Text;
    when obligation_of_noncorporate_us_person_956c2L(asset);
    unless obligor_is_us_shareholder_956c2Lii_I(asset)
     and obligation_of_noncorporate_us_person_956c2L(asset);
    unless obligor_is_pass_through_with_cfc_or_related_person_956c2Lii_II(asset)
     and obligation_of_noncorporate_us_person_956c2L(asset);
    then us_property_956_exception_applies(asset);
}

// --- §956(c)(3): trade or service receivables acquired from related United States persons -----------

pub relation trade_or_service_receivable_acquired_from_related_us_person_956c3Ai(asset: Text) kind empirical {
    label en official "the asset is a trade or service receivable (section 864(d)) acquired, directly or indirectly, from a related person (section 864(d)) who is a United States person";
}
pub relation obligor_of_receivable_is_us_person_956c3Aii(asset: Text) kind empirical {
    label en official "the obligor under the receivable is a United States person";
}
@source(IRC_S956_C, relation = formalizes, coverage = exact, quote = "Notwithstanding paragraph (2) (other than subparagraph (H) thereof), the term \"United States property\"")
rule S956C3TradeOrServiceReceivableIsUsProperty defeasible {
    for asset: Text;
    when trade_or_service_receivable_acquired_from_related_us_person_956c3Ai(asset)
     and obligor_of_receivable_is_us_person_956c3Aii(asset);
    unless asset_equal_to_952b_excluded_earnings_956c2H(asset)
     and trade_or_service_receivable_acquired_from_related_us_person_956c3Ai(asset)
     and obligor_of_receivable_is_us_person_956c3Aii(asset);
    then us_property_956(asset);
}

// --- §959(b): chain of controlled foreign corporations ------------------------------------------------

pub relation ptep_distributed_through_958a_chain_959b(shareholder: us.irc.core::Person, upper_corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "earnings and profits of a controlled foreign corporation attributable to amounts included (now or earlier) in the gross income of the United States shareholder under section 951(a), distributed through a chain of ownership described in section 958(a) to another controlled foreign corporation in the chain";
}
pub relation ptep_excluded_from_upper_cfc_951a_959b(shareholder: us.irc.core::Person, upper_corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the amount not also included in the gross income of the other controlled foreign corporation in the chain for purposes of section 951(a) with respect to that United States shareholder (or a successor acquiring part of its interest, to the extent of that part)";
}
@source(IRC_S959_B, relation = formalizes, coverage = exact, quote = "For purposes of section 951(a), the earnings and profits of a controlled foreign corporation attributable to")
rule S959BChainExclusion defeasible {
    for shareholder: us.irc.core::Person;
    for upper_corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when ptep_distributed_through_958a_chain_959b(shareholder, upper_corp, y, amount)
     and amount > 0.00 USD;
    then ptep_excluded_from_upper_cfc_951a_959b(shareholder, upper_corp, y, amount);
}

// --- §959(c), (f): ordering of distributions and of hypothetical inclusions ---------------------------

pub relation distribution_in_959c(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "a distribution by the controlled foreign corporation to allocate under section 959(c)";
}
pub relation ptep_bucket_959c1A(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "earnings and profits attributable to amounts included in gross income under section 951(a)(1)(B) (or which would have been included except for subsection (a)(2))";
}
pub relation ptep_bucket_959c1B(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "earnings and profits attributable to amounts included in gross income under section 951(a)(1)(C) as in effect before the Small Business Job Protection Act of 1996 (or which would have been included except for subsection (a)(3))";
}
pub relation ptep_bucket_959c2(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "earnings and profits attributable to amounts included in gross income under section 951(a)(1)(A), reduced by the amounts not included under (B) or (C) of section 951(a)(1) because of the exclusions in paragraphs (2) and (3) of subsection (a)";
}
pub relation other_earnings_bucket_959c3(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "other earnings and profits";
}
pub relation distribution_allocated_to_959c1_group(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the part of the distribution allocated first to the aggregate of the (c)(1)(A) and (c)(1)(B) earnings";
}
@source(IRC_S959_C, relation = formalizes, coverage = exact, quote = "(1) first to the aggregate of—")
rule S959C1FirstToAggregate defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for distribution: Money;
    for a: Money;
    for b: Money;
    when distribution_in_959c(shareholder, corp, y, distribution)
     and ptep_bucket_959c1A(shareholder, corp, y, a)
     and ptep_bucket_959c1B(shareholder, corp, y, b);
    then distribution_allocated_to_959c1_group(shareholder, corp, y, min(distribution, a + b));
}
pub relation distribution_allocated_to_959c1A(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the part of the (c)(1) allocation charged to the (A) earnings, proportionately on the basis of the respective amounts of (A) and (B) earnings";
}
@source(IRC_S959_C, relation = formalizes, coverage = exact, quote = "with any distribution being allocated between earnings and profits described in subparagraph (A) and earnings")
rule S959C1AProportionateShare defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for group: Money;
    for a: Money;
    for b: Money;
    when distribution_allocated_to_959c1_group(shareholder, corp, y, group)
     and ptep_bucket_959c1A(shareholder, corp, y, a)
     and ptep_bucket_959c1B(shareholder, corp, y, b)
     and (a + b) > 0.00 USD;
    then distribution_allocated_to_959c1A(shareholder, corp, y, div_round(group * (a / 1.00 USD), (a + b) / 1.00 USD, 2, "HALF_UP"));
}
pub relation distribution_allocated_to_959c1B(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the part of the (c)(1) allocation charged to the (B) earnings: the rest of the group allocation";
}
@source(IRC_S959_C, relation = formalizes, coverage = exact, quote = "with any distribution being allocated between earnings and profits described in subparagraph (A) and earnings")
rule S959C1BRemainderShare defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for group: Money;
    for to_a: Money;
    when distribution_allocated_to_959c1_group(shareholder, corp, y, group)
     and distribution_allocated_to_959c1A(shareholder, corp, y, to_a);
    then distribution_allocated_to_959c1B(shareholder, corp, y, group - to_a);
}
pub relation distribution_allocated_to_959c2(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the part of the distribution allocated second to the (c)(2) earnings";
}
@source(IRC_S959_C, relation = formalizes, coverage = exact, quote = "(2) then to earnings and profits attributable to amounts included in gross income under section 951(a)(1)(A)")
rule S959C2SecondToSection951a1AEarnings defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for distribution: Money;
    for group: Money;
    for bucket2: Money;
    when distribution_in_959c(shareholder, corp, y, distribution)
     and distribution_allocated_to_959c1_group(shareholder, corp, y, group)
     and ptep_bucket_959c2(shareholder, corp, y, bucket2);
    then distribution_allocated_to_959c2(shareholder, corp, y, min(distribution - group, bucket2));
}
pub relation distribution_allocated_to_959c3(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the part of the distribution allocated last to other earnings and profits";
}
@source(IRC_S959_C, relation = formalizes, coverage = exact, quote = "(3) then to other earnings and profits.")
rule S959C3ThirdToOtherEarnings defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for distribution: Money;
    for group: Money;
    for to2: Money;
    for other: Money;
    when distribution_in_959c(shareholder, corp, y, distribution)
     and distribution_allocated_to_959c1_group(shareholder, corp, y, group)
     and distribution_allocated_to_959c2(shareholder, corp, y, to2)
     and other_earnings_bucket_959c3(shareholder, corp, y, other);
    then distribution_allocated_to_959c3(shareholder, corp, y, min(distribution - group - to2, other));
}
pub relation amount_that_would_be_included_951a1B_959f(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "amounts that would be included under section 951(a)(1)(B), determined without regard to section 959";
}
pub relation inclusion_attributed_to_959c2_earnings_959f1(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the part of the would-be section 951(a)(1)(B) inclusion attributed first to the (c)(2) earnings remaining after actual distributions (subsection (f)(2): actual distributions are taken into account first)";
}
@source(IRC_S959_F, relation = formalizes, coverage = exact, quote = "For purposes of this section, amounts that would be included under subparagraph (B) of section 951(a)(1)")
rule S959F1InclusionAttributedFirstToC2 defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for inclusion: Money;
    for bucket2: Money;
    for to2: Money;
    when amount_that_would_be_included_951a1B_959f(shareholder, corp, y, inclusion)
     and ptep_bucket_959c2(shareholder, corp, y, bucket2)
     and distribution_allocated_to_959c2(shareholder, corp, y, to2);
    then inclusion_attributed_to_959c2_earnings_959f1(shareholder, corp, y, min(inclusion, max(bucket2 - to2, 0.00 USD)));
}
pub relation inclusion_attributed_to_other_earnings_959f1(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the rest of the would-be section 951(a)(1)(B) inclusion, attributed then to the (c)(3) earnings";
}
@source(IRC_S959_F, relation = formalizes, coverage = exact, quote = "For purposes of this section, amounts that would be included under subparagraph (B) of section 951(a)(1)")
rule S959F1InclusionRestToC3 defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for inclusion: Money;
    for to2: Money;
    when amount_that_would_be_included_951a1B_959f(shareholder, corp, y, inclusion)
     and inclusion_attributed_to_959c2_earnings_959f1(shareholder, corp, y, to2);
    then inclusion_attributed_to_other_earnings_959f1(shareholder, corp, y, inclusion - to2);
}

// --- §959(e): section 1248 amounts ------------------------------------------------------------------------

pub relation section_1248_dividend_included_959e(person: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "an amount included in the gross income of the person as a dividend by reason of section 1248(a) or (f)";
}
pub relation section_1248e_domestic_corporation_959e(person: us.irc.core::Person, domestic_corp: us.irc.core::Person) kind empirical {
    label en official "the case is one to which section 1248(e) applies, and the domestic corporation referred to in section 1248(e)(2) is named";
}
pub relation amount_treated_as_951a1A_inclusion_959e(person: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the section 1248 dividend is treated, for section 959 and section 960(c), as an amount included in gross income under section 951(a)(1)(A) (of the person, or of the section 1248(e)(2) domestic corporation)";
}
@source(IRC_S959_E, relation = formalizes, coverage = exact, quote = "For purposes of this section and section 960(c), any amount included in the gross income of any person as a")
rule S959E1248DividendAsInclusion defeasible {
    for person: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when section_1248_dividend_included_959e(person, corp, y, amount);
    unless section_1248e_domestic_corporation_959e(person, _)
     and section_1248_dividend_included_959e(person, corp, y, amount);
    then amount_treated_as_951a1A_inclusion_959e(person, corp, y, amount);
}
@source(IRC_S959_E, relation = formalizes, coverage = exact, quote = "For purposes of this section and section 960(c), any amount included in the gross income of any person as a")
rule S959E1248eDomesticCorporationInclusion defeasible {
    for person: us.irc.core::Person;
    for domestic_corp: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when section_1248_dividend_included_959e(person, corp, y, amount)
     and section_1248e_domestic_corporation_959e(person, domestic_corp);
    then amount_treated_as_951a1A_inclusion_959e(domestic_corp, corp, y, amount);
}

// --- §961(c), (d): basis adjustments through chains; loss basis of 245A stock ----------------------------

pub relation inclusion_by_reason_of_958a2_chain_961c(shareholder: us.irc.core::Person, owned_cfc: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "an amount included in the gross income of the United States shareholder under section 951 by reason of stock the shareholder is treated under section 958(a)(2) as owning in a controlled foreign corporation owned by another controlled foreign corporation";
}
pub relation cfc_in_958a2_chain_961c(shareholder: us.irc.core::Person, owned_cfc: us.irc.core::Corporation, chain_cfc: us.irc.core::Corporation) kind empirical {
    label en official "the chain corporation is the owned controlled foreign corporation itself or another controlled foreign corporation by reason of which the United States shareholder is considered under section 958(a)(2) as owning its stock";
}
pub relation stock_basis_adjusted_under_961a_or_b_961c(shareholder: us.irc.core::Person, chain_cfc: us.irc.core::Corporation) kind empirical {
    label en official "a basis adjustment applies to the stock under subsection (a) or (b)";
}
pub relation chain_stock_basis_adjustment_961c(shareholder: us.irc.core::Person, chain_cfc: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the adjustment similar to subsection (a) to the basis of the stock (of the owned corporation, and of each other corporation in the chain), only for determining the amount included under section 951; it does not apply to stock to which subsection (a) or (b) applies";
}
@source(IRC_S961_C, relation = formalizes, coverage = partial, quote = "Under regulations prescribed by the Secretary, if a United States shareholder is treated under section")
rule S961CChainStockBasisAdjustment defeasible {
    for shareholder: us.irc.core::Person;
    for owned_cfc: us.irc.core::Corporation;
    for chain_cfc: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when inclusion_by_reason_of_958a2_chain_961c(shareholder, owned_cfc, y, amount)
     and cfc_in_958a2_chain_961c(shareholder, owned_cfc, chain_cfc);
    unless stock_basis_adjusted_under_961a_or_b_961c(shareholder, chain_cfc)
     and inclusion_by_reason_of_958a2_chain_961c(shareholder, owned_cfc, y, amount)
     and cfc_in_958a2_chain_961c(shareholder, owned_cfc, chain_cfc);
    then chain_stock_basis_adjustment_961c(shareholder, chain_cfc, y, amount);
}
pub relation basis_in_specified_10_percent_owned_stock_961d(domestic_corp: us.irc.core::Person, foreign_corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, basis: Money) kind empirical {
    label en official "the domestic corporation's basis in the stock of the specified 10-percent owned foreign corporation (section 245A) before the reduction";
}
pub relation section_245a_deduction_on_stock_961d(domestic_corp: us.irc.core::Person, foreign_corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, deduction: Money) kind empirical {
    label en official "the deduction allowable to the domestic corporation under section 245A with respect to the stock";
}
pub relation basis_reduction_under_1059_for_245a_dividend_961d(domestic_corp: us.irc.core::Person, foreign_corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the reduction of basis under section 1059 by reason of a dividend for which a section 245A deduction was allowable";
}
pub relation basis_for_determining_loss_961d(domestic_corp: us.irc.core::Person, foreign_corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, basis: Money) kind institutional {
    label en official "solely for determining loss on a disposition of the stock in that or a later year, the basis reduced (not below zero) by the section 245A deduction except to the extent basis was reduced under section 1059";
}
@source(IRC_S961_D, relation = formalizes, coverage = exact, quote = "If a domestic corporation received a dividend from a specified 10-percent owned foreign corporation (as")
rule S961DLossBasisReducedBy245aDeduction defeasible {
    for domestic_corp: us.irc.core::Person;
    for foreign_corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for basis: Money;
    for deduction: Money;
    for reduced_1059: Money;
    when basis_in_specified_10_percent_owned_stock_961d(domestic_corp, foreign_corp, y, basis)
     and section_245a_deduction_on_stock_961d(domestic_corp, foreign_corp, y, deduction)
     and basis_reduction_under_1059_for_245a_dividend_961d(domestic_corp, foreign_corp, y, reduced_1059);
    then basis_for_determining_loss_961d(domestic_corp, foreign_corp, y, max(basis - max(deduction - reduced_1059, 0.00 USD), 0.00 USD));
}

// --- §962(a)(2), (c), (d) -------------------------------------------------------------------------------------

pub relation section_960_applies_as_if_domestic_corporation_962a2(shareholder: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind institutional {
    label en official "for section 960 (foreign tax credit) the section 951(a) amounts are treated as if received by a domestic corporation, for an individual whose section 962 election is effective";
}
@source(IRC_S962_A, relation = formalizes, coverage = exact, quote = "(2) for purposes of applying the provisions of section 960 [1] (relating to foreign tax credit) such amounts")
rule S962A2SectionNineSixtyAsDomesticCorporation defeasible {
    for shareholder: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    when section_962_election_effective(shareholder, y);
    then section_960_applies_as_if_domestic_corporation_962a2(shareholder, y);
}
pub relation section_11b_bracket_amount_962c(bracket_id: Text, amount: Money) kind empirical {
    label en official "the amount in a taxable income bracket in the tax table in section 11(b) (the pinned text has one flat rate and no bracket table; the brackets are supplied by the case)";
}
pub relation section_951a_inclusion_962c(shareholder: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the amount included in the gross income of the United States shareholder under section 951(a) for the taxable year";
}
pub relation pro_rata_share_of_earnings_of_included_cfcs_962c(shareholder: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the shareholder's pro rata share of the earnings and profits for the taxable year of all controlled foreign corporations with respect to which the shareholder includes any amount under section 951(a)";
}
pub relation prorated_bracket_amount_cap_962c(shareholder: us.irc.core::Individual, y: us.irc.core::TaxableYear, bracket_id: Text, cap: Money) kind institutional {
    label en official "the cap on the amount in a section 11(b) bracket: the bracket amount times the ratio of the section 951(a) inclusion to the pro rata share of the earnings and profits";
}
@source(IRC_S962_C, relation = formalizes, coverage = exact, quote = "For purposes of applying subsection (a)(1), the amount in each taxable income bracket in the tax table in")
rule S962CProrationOfBracketAmounts defeasible {
    for shareholder: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for bracket_id: Text;
    for bracket: Money;
    for inclusion: Money;
    for earnings: Money;
    when section_11b_bracket_amount_962c(bracket_id, bracket)
     and section_951a_inclusion_962c(shareholder, y, inclusion)
     and pro_rata_share_of_earnings_of_included_cfcs_962c(shareholder, y, earnings)
     and earnings > 0.00 USD;
    then prorated_bracket_amount_cap_962c(shareholder, y, bracket_id, div_round(bracket * (inclusion / 1.00 USD), earnings / 1.00 USD, 2, "HALF_UP"));
}
pub relation distributed_962_earnings_and_profits_962d(shareholder: us.irc.core::Individual, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "earnings and profits attributable to amounts included under section 951(a) to which a section 962 election applied, when distributed";
}
pub relation tax_paid_on_962_election_amounts_962d(shareholder: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the amount of tax paid under chapter 1 on the amounts to which the section 962 election applied";
}
pub relation distribution_included_in_gross_income_962d(shareholder: us.irc.core::Individual, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "notwithstanding section 959(a)(1), the distributed earnings and profits are included in gross income to the extent they exceed the tax paid on the amounts to which the election applied";
}
@source(IRC_S962_D, relation = formalizes, coverage = exact, quote = "The earnings and profits of a foreign corporation attributable to amounts which were included in the gross")
rule S962DDistributionExceedingTaxPaidIncluded defeasible {
    for shareholder: us.irc.core::Individual;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for distributed: Money;
    for tax_paid: Money;
    when distributed_962_earnings_and_profits_962d(shareholder, corp, y, distributed)
     and tax_paid_on_962_election_amounts_962d(shareholder, y, tax_paid)
     and distributed > tax_paid;
    then distribution_included_in_gross_income_962d(shareholder, corp, y, distributed - tax_paid);
}
