// Stage 3 (TECH_GAP reduction), module 46: section 953(b), (c)(3)(D), (c)(4), (d)(2), (d)(4)-(5), (e)(3)-(5), (e)(7);
// section 954(c)(2)(C), (d)(3)-(4), (e)(2), (h)(3)(B)-(E), (i)(1), (i)(3), (i)(4)(B)-(C). Status implemented_unverified: not a
// legal review; scenarios in tests/s953-s954-stage3.lawtest are written, NOT executed.
//
// Modeling notes.
//  * The subchapter L computations (reserves under the foreign interest rate, foreign loss payment patterns,
//    mortality tables) are NOT modeled: section 954(i)(4)(A) and (i)(5) stay technical gaps; the reserve amounts
//    they produce are case inputs of the derivations below.
//  * `S954H3AQualifiedBankingOrFinancingIncome` (module 27) now also reads the (h)(3)(B) non-banking limitation.

// --- §953(b): modifications of subchapter L ----------------------------------------------------------------------------

use self::{
    IRC_S953_B,
    IRC_S953_C,
    IRC_S953_D,
    IRC_S953_E,
    IRC_S954_C,
    IRC_S954_D,
    IRC_S954_E,
    IRC_S954_H,
    IRC_S954_I,
    election_ceases_after_later_disqualification_953c3D,
    elects_domestic_treatment_and_waives_treaty_953d1D,
    elects_eci_treatment_and_waives_treaty_953c3C,
    eligible_controlled_foreign_corporation_954h2A,
    exempt_insurance_income_item_953e1,
    foreign_base_company_sales_income_item,
    fphci_excepted_item_954,
    income_derived_in_active_conduct_of_banking_by_cfc_or_qbu_954h3Ai,
    item_excluded_from_fphci_954h1,
    licensed_us_bank_954h2Bii,
    qualified_insurance_income_954i2,
    qualifying_insurance_company_953e3,
    registered_securities_dealer_954h2Biii,
    related_person_954d3,
};

pub relation subchapter_l_provision_in_953a_computation_953b(item_id: Text, provision: Text) kind empirical {
    label en official "the provision of subchapter L that the computation of the item would use if the corporation were domestic: '805a8_172' (so much of section 805(a)(8) as relates to section 172) or '832c5' (section 832(c)(5), certain capital losses)";
}
pub relation subchapter_l_provision_not_applied_953b1(item_id: Text, provision: Text) kind institutional {
    label en official "the provision of subchapter L does not apply for purposes of subsection (a): so much of section 805(a)(8) relating to section 172 and section 832(c)(5)";
}
@source(IRC_S953_B, relation = formalizes, coverage = exact, quote = "(A) So much of section 805(a)(8) as relates to the deduction allowed under section 172.")
rule S953B1ANoSection172Deduction defeasible {
    for item_id: Text;
    when subchapter_l_provision_in_953a_computation_953b(item_id, "805a8_172");
    then subchapter_l_provision_not_applied_953b1(item_id, "805a8_172");
}
@source(IRC_S953_B, relation = formalizes, coverage = exact, quote = "(B) Section 832(c)(5) (relating to certain capital losses).")
rule S953B1BNoSection832c5CapitalLosses defeasible {
    for item_id: Text;
    when subchapter_l_provision_in_953a_computation_953b(item_id, "832c5");
    then subchapter_l_provision_not_applied_953b1(item_id, "832c5");
}
pub relation subchapter_l_item_amounts_953b2(item_id: Text, provision: Text, total_amount: Money, amount_in_respect_of_953a1_contracts: Money) kind empirical {
    label en official "the item referred to in section 803(a)(1), 803(a)(2), 805(a)(2) or 832(b)(4) (provision '803a1', '803a2', '805a2', '832b4'), the total amount, and the amount in respect of reinsurance or the issuing of an insurance or annuity contract described in subsection (a)(1)";
}
pub relation amount_taken_into_account_953b2(item_id: Text, provision: Text, amount: Money) kind institutional {
    label en official "the amount of the item taken into account: only to the extent it is in respect of reinsurance or the issuing of a contract described in subsection (a)(1)";
}
@source(IRC_S953_B, relation = formalizes, coverage = exact, quote = "shall be taken into account only to the extent they are in respect of any reinsurance or the issuing of any")
rule S953B2OnlyToTheExtentInRespectOfInsuranceContracts defeasible {
    for item_id: Text;
    for provision: Text;
    for total: Money;
    for in_respect: Money;
    when subchapter_l_item_amounts_953b2(item_id, provision, total, in_respect);
    then amount_taken_into_account_953b2(item_id, provision, min(total, in_respect));
}

// --- §953(c)(3)(D)(i)(I), (c)(4): election continuation; mutual companies ----------------------------------------------

pub relation election_953c3C_made_for_earlier_year_953c3Di(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "an election under subparagraph (C) was made for an earlier taxable year and has not been revoked with the consent of the Secretary";
}
pub relation election_953c3C_applies_to_year_953c3Di(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the election under subparagraph (C) applies to the taxable year for which made and all subsequent taxable years unless revoked with the consent of the Secretary (the exception of subclause (II) is the later-disqualification rule, election_ceases_after_later_disqualification_953c3D)";
}
@source(IRC_S953_C, relation = formalizes, coverage = exact, quote = "Except as provided in subclause (II), any election under subparagraph (C) shall apply to the taxable year for")
rule S953C3DiIElectionYearOfElection defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when elects_eci_treatment_and_waives_treaty_953c3C(corp, y);
    unless election_ceases_after_later_disqualification_953c3D(corp, y)
     and elects_eci_treatment_and_waives_treaty_953c3C(corp, y);
    then election_953c3C_applies_to_year_953c3Di(corp, y);
}
@source(IRC_S953_C, relation = formalizes, coverage = exact, quote = "Except as provided in subclause (II), any election under subparagraph (C) shall apply to the taxable year for")
rule S953C3DiISubsequentYears defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when election_953c3C_made_for_earlier_year_953c3Di(corp, y);
    unless election_ceases_after_later_disqualification_953c3D(corp, y)
     and election_953c3C_made_for_earlier_year_953c3Di(corp, y);
    then election_953c3C_applies_to_year_953c3Di(corp, y);
}
pub relation mutual_insurance_company_953c4(corp: us.irc.core::Corporation) kind empirical {
    label en official "the company is a mutual insurance company";
}
pub relation policyholder_of_953c4(policyholder: us.irc.core::Person, corp: us.irc.core::Corporation) kind empirical {
    label en official "the person is a policyholder of the company";
}
pub relation policyholder_treated_as_shareholder_953c4B(policyholder: us.irc.core::Person, corp: us.irc.core::Corporation) kind institutional {
    label en official "in the case of a mutual insurance company, the policyholders are treated as shareholders";
}
@source(IRC_S953_C, relation = formalizes, coverage = exact, quote = "(B) policyholders of such company shall be treated as shareholders, and")
rule S953C4BPolicyholdersAsShareholders defeasible {
    for policyholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    when mutual_insurance_company_953c4(corp)
     and policyholder_of_953c4(policyholder, corp);
    then policyholder_treated_as_shareholder_953c4B(policyholder, corp);
}

// --- §953(d)(2), (d)(4), (d)(5): election to be treated as domestic ------------------------------------------------------

pub relation election_953d1_made_for_earlier_year_953d2A(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "an election under paragraph (1) was made for an earlier taxable year and has not been revoked with the consent of the Secretary";
}
pub relation failed_953d1_requirements_in_earlier_year_953d2B(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "in a taxable year before this one (and after the election year) the corporation failed to meet the requirements of subparagraphs (A), (B) and (C) of paragraph (1)";
}
pub relation election_953d1_in_effect_for_year_953d2(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the election applies to the taxable year for which made and all subsequent taxable years, unless revoked with consent, and does not apply to any year beginning after a subsequent year in which the requirements were not met";
}
@source(IRC_S953_D, relation = formalizes, coverage = exact, quote = "Except as provided in subparagraph (B), an election under paragraph (1) shall apply to the taxable year for")
rule S953D2AElectionYearOfElection defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when elects_domestic_treatment_and_waives_treaty_953d1D(corp, y);
    unless failed_953d1_requirements_in_earlier_year_953d2B(corp, y)
     and elects_domestic_treatment_and_waives_treaty_953d1D(corp, y);
    then election_953d1_in_effect_for_year_953d2(corp, y);
}
@source(IRC_S953_D, relation = formalizes, coverage = exact, quote = "If a corporation which made an election under paragraph (1) for any taxable year fails to meet the")
rule S953D2BSubsequentYears defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when election_953d1_made_for_earlier_year_953d2A(corp, y);
    unless failed_953d1_requirements_in_earlier_year_953d2B(corp, y)
     and election_953d1_made_for_earlier_year_953d2A(corp, y);
    then election_953d1_in_effect_for_year_953d2(corp, y);
}
pub relation first_taxable_year_of_election_953d4A(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the taxable year is the first taxable year to which the election under paragraph (1) applies";
}
pub relation deemed_section_354_transfer_of_assets_to_domestic_corporation_953d4A(corp: us.irc.core::Corporation, on: Date) kind institutional {
    label en official "for purposes of section 367, the foreign corporation is treated as transferring (as of the 1st day of the 1st taxable year to which the election applies) all its assets to a domestic corporation in an exchange to which section 354 applies";
}
@source(IRC_S953_D, relation = formalizes, coverage = exact, quote = "For purposes of section 367, any foreign corporation making an election under paragraph (1) shall be treated")
rule S953D4ADeemedTransferOnElection defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for first_day: Date;
    when first_taxable_year_of_election_953d4A(corp, y)
     and election_953d1_in_effect_for_year_953d2(corp, y)
     and us.irc.core::begins(y, first_day);
    then deemed_section_354_transfer_of_assets_to_domestic_corporation_953d4A(corp, first_day);
}
pub relation earnings_accumulated_before_1988_953d4B(corp: us.irc.core::Corporation, amount: Money) kind empirical {
    label en official "the earnings and profits of the foreign corporation accumulated in taxable years beginning before January 1, 1988";
}
pub relation pre_1988_earnings_not_included_in_gross_income_953d4Bi(corp: us.irc.core::Corporation, amount: Money) kind institutional {
    label en official "earnings and profits accumulated in taxable years beginning before January 1, 1988 are not included in the gross income of the stockholders by reason of subparagraph (A)";
}
@source(IRC_S953_D, relation = formalizes, coverage = exact, quote = "Earnings and profits of the foreign corporation accumulated in taxable years beginning before January 1,")
rule S953D4BiPre1988EarningsNotIncluded defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when election_953d1_in_effect_for_year_953d2(corp, y)
     and earnings_accumulated_before_1988_953d4B(corp, amount);
    then pre_1988_earnings_not_included_in_gross_income_953d4Bi(corp, amount);
}
pub relation distribution_out_of_pre_1988_earnings_953d4Bii(corp: us.irc.core::Corporation, distribution_id: Text, amount: Money) kind empirical {
    label en official "a distribution made by the corporation out of earnings and profits accumulated in taxable years beginning before January 1, 1988";
}
pub relation distribution_treated_as_by_foreign_corporation_953d4Bii(corp: us.irc.core::Corporation, distribution_id: Text, amount: Money) kind institutional {
    label en official "for purposes of this title the distribution is treated as made by a foreign corporation";
}
@source(IRC_S953_D, relation = formalizes, coverage = exact, quote = "For purposes of this title, any distribution made by a corporation to which an election under paragraph (1)")
rule S953D4BiiDistributionTreatedAsForeign defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for distribution_id: Text;
    for amount: Money;
    when election_953d1_in_effect_for_year_953d2(corp, y)
     and distribution_out_of_pre_1988_earnings_953d4Bii(corp, distribution_id, amount);
    then distribution_treated_as_by_foreign_corporation_953d4Bii(corp, distribution_id, amount);
}
pub relation provision_specified_953d4Biv(provision: Text) kind institutional {
    label en official "a provision specified in clause (iv): 'section_1248', 'subpart_f_us_property_earnings' or 'section_884_reinvested_1987_earnings'";
}
@source(IRC_S953_D, relation = formalizes, coverage = exact, quote = "(I) Section 1248 (relating to gain from certain sales or exchanges of stock in certain foreign corporations).")
rule S953D4BivISection1248 defeasible {
    for provision: Text;
    when provision_asked_for_953d4Biii(provision)
     and provision == "section_1248";
    then provision_specified_953d4Biv(provision);
}
@source(IRC_S953_D, relation = formalizes, coverage = exact, quote = "(II) Subpart F of part III of subchapter N to the extent such subpart relates to earnings invested in United")
rule S953D4BivIISubpartFUsProperty defeasible {
    for provision: Text;
    when provision_asked_for_953d4Biii(provision)
     and provision == "subpart_f_us_property_earnings";
    then provision_specified_953d4Biv(provision);
}
@source(IRC_S953_D, relation = formalizes, coverage = exact, quote = "(III) Section 884 to the extent the foreign corporation reinvested 1987 earnings and profits in United States")
rule S953D4BivIIISection884 defeasible {
    for provision: Text;
    when provision_asked_for_953d4Biii(provision)
     and provision == "section_884_reinvested_1987_earnings";
    then provision_specified_953d4Biv(provision);
}
pub relation specified_provision_applied_without_regard_to_election_953d4Biii(corp: us.irc.core::Corporation, provision: Text, earnings_taken_into_account: Money) kind institutional {
    label en official "the specified provision applies without regard to paragraph (1); for a corporation with an election, only earnings and profits accumulated in years beginning before January 1, 1988 are taken into account";
}
pub relation provision_asked_for_953d4Biii(provision: Text) kind empirical {
    label en official "the provision of clause (iv) whose application to the electing corporation is tested";
}
@source(IRC_S953_D, relation = formalizes, coverage = exact, quote = "The provisions specified in clause (iv) shall be applied without regard to paragraph (1), except that, in the")
rule S953D4BiiiSpecifiedProvisionsOnPre1988Earnings defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for provision: Text;
    for earnings: Money;
    when election_953d1_in_effect_for_year_953d2(corp, y)
     and provision_asked_for_953d4Biii(provision)
     and provision_specified_953d4Biv(provision)
     and earnings_accumulated_before_1988_953d4B(corp, earnings);
    then specified_provision_applied_without_regard_to_election_953d4Biii(corp, provision, earnings);
}
pub relation election_ceases_for_year_953d5B(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "an election made for an earlier year ceases to apply for this subsequent taxable year (a failure of the requirements in an earlier year, or revocation)";
}
@source(IRC_S953_D, relation = formalizes, coverage = exact, quote = "(B) such election ceases to apply for any subsequent taxable year,")
rule S953D5BElectionCeases defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when election_953d1_made_for_earlier_year_953d2A(corp, y)
     and failed_953d1_requirements_in_earlier_year_953d2B(corp, y);
    then election_ceases_for_year_953d5B(corp, y);
}
pub relation deemed_transfer_of_property_to_foreign_corporation_953d5(corp: us.irc.core::Corporation, on: Date) kind institutional {
    label en official "for purposes of section 367, when the election ceases to apply the corporation is treated as a domestic corporation transferring (as of the 1st day of that subsequent year) all its property to a foreign corporation in an exchange to which section 354 applies";
}
@source(IRC_S953_D, relation = formalizes, coverage = exact, quote = "such corporation shall be treated as a domestic corporation transferring (as of the 1st day of such")
rule S953D5DeemedTransferOnCessation defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for first_day: Date;
    when election_ceases_for_year_953d5B(corp, y)
     and us.irc.core::begins(y, first_day);
    then deemed_transfer_of_property_to_foreign_corporation_953d5(corp, first_day);
}

// --- §953(e)(3)(B), (e)(5), (e)(7) -----------------------------------------------------------------------------------------

pub relation branch_premium_953e3B(unit_id: Text, y: us.irc.core::TaxableYear, premium: Money) kind empirical {
    label en official "net written premiums of the branch from contracts covering applicable home country risks with no related-person policyholder or beneficiary";
}
pub relation branch_premium_treated_as_earned_in_home_country_953e3B(unit_id: Text, y: us.irc.core::TaxableYear, earned: Money) kind empirical {
    label en official "the part of those premiums treated as earned by the branch in its home country for purposes of that country's tax laws";
}
pub relation branch_premium_counted_953e3B(unit_id: Text, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "in the case of a branch, the premiums are taken into account only to the extent they are treated as earned by the branch in its home country for that country's tax purposes";
}
@source(IRC_S953_E, relation = formalizes, coverage = exact, quote = "except that in the case of a branch, such premiums shall only be taken into account to the extent such")
rule S953E3BBranchPremiumsOnlyToExtentEarnedInHomeCountry defeasible {
    for unit_id: Text;
    for y: us.irc.core::TaxableYear;
    for premium: Money;
    for earned: Money;
    when branch_premium_953e3B(unit_id, y, premium)
     and branch_premium_treated_as_earned_in_home_country_953e3B(unit_id, y, earned);
    then branch_premium_counted_953e3B(unit_id, y, min(premium, earned));
}
pub relation contract_regulated_as_life_or_annuity_by_home_country_953e5A(contract_id: Text) kind empirical {
    label en official "the contract is regulated as a life insurance or annuity contract by the corporation's or unit's home country";
}
pub relation contract_has_us_person_party_953e5B(contract_id: Text) kind empirical {
    label en official "a policyholder, insured, annuitant or beneficiary with respect to the contract is a United States person";
}
pub relation contract_status_determined_without_regard_to_us_definitions_953e5(contract_id: Text) kind institutional {
    label en official "the determination whether the contract is a life insurance or annuity contract is made without regard to sections 72(s), 101(f), 817(h) and 7702";
}
@source(IRC_S953_E, relation = formalizes, coverage = exact, quote = "(A) such contract is regulated as a life insurance or annuity contract by the corporation's or unit's home")
rule S953E5WithoutRegardToSections72s101f817h7702 defeasible {
    for contract_id: Text;
    when contract_regulated_as_life_or_annuity_by_home_country_953e5A(contract_id);
    unless contract_has_us_person_party_953e5B(contract_id)
     and contract_regulated_as_life_or_annuity_by_home_country_953e5A(contract_id);
    then contract_status_determined_without_regard_to_us_definitions_953e5(contract_id);
}
pub relation entity_not_engaged_in_regular_continuous_unrelated_transactions_953e7B(item_id: Text) kind empirical {
    label en official "the item is of, or derived from, an entity which is not engaged in regular and continuous transactions with persons which are not related persons";
}
pub relation item_disregarded_953e7B(item_id: Text) kind institutional {
    label en official "the item of income, gain, loss or deduction is disregarded for purposes of the qualifying-insurance-company rules and section 954(i)";
}
@source(IRC_S953_E, relation = formalizes, coverage = exact, quote = "(B) there shall be disregarded any item of income, gain, loss, or deduction of, or derived from, an entity")
rule S953E7BEntityWithoutRegularUnrelatedTransactions defeasible {
    for item_id: Text;
    when entity_not_engaged_in_regular_continuous_unrelated_transactions_953e7B(item_id);
    then item_disregarded_953e7B(item_id);
}
pub relation reserve_method_change_with_principal_purpose_953e7C(change_id: Text) kind empirical {
    label en official "a change in the method of computing reserves a principal purpose of which is the acceleration or deferral of an item to claim the benefits of this subsection or section 954(i) (a purpose finding: DECISION-0194 adjudicated-fact channel)";
}
pub relation reserve_method_change_disregarded_953e7C(change_id: Text) kind institutional {
    label en official "the change in the method of computing reserves is disregarded";
}
@source(IRC_S953_E, relation = formalizes, coverage = exact, quote = "(C) there shall be disregarded any change in the method of computing reserves a principal purpose of which is")
rule S953E7CChangeInReserveMethodDisregarded defeasible {
    for change_id: Text;
    when reserve_method_change_with_principal_purpose_953e7C(change_id);
    then reserve_method_change_disregarded_953e7C(change_id);
}

// --- §954(c)(2)(C): regular dealers --------------------------------------------------------------------------------------------

pub relation regular_dealer_in_property_954c2C(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the corporation is a regular dealer in property described in paragraph (1)(B), forward contracts, option contracts or similar financial instruments (including notional principal contracts and instruments referenced to commodities)";
}
pub relation dealer_transaction_in_ordinary_course_954c2C(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text) kind empirical {
    label en official "the item comes from a transaction (including a hedging transaction or one involving physical settlement) entered into in the ordinary course of the dealer's trade or business as such a dealer";
}
pub relation item_described_in_954c1A_E_or_G(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text) kind empirical {
    label en official "the item is described in subparagraph (A) (dividends, interest, royalties, rents, annuities), (E) (income equivalent to interest) or (G) (payments in lieu of dividends) of paragraph (1)";
}
pub relation dealer_in_securities_475_954c2Cii(corp: us.irc.core::Corporation) kind empirical {
    label en official "the dealer is a dealer in securities within the meaning of section 475";
}
pub relation dealer_income_attributable_to_home_activities_954c2Cii(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text) kind empirical {
    label en official "the income from the transaction is attributable to activities of the dealer in the country under whose laws it is created or organized (for a qualified business unit, in the country where it maintains its principal office and conducts substantial business activity)";
}
pub relation item_excluded_by_954c2Cii(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text) kind institutional {
    label en official "the interest or dividend or equivalent amount of a dealer in securities is not taken into account in computing foreign personal holding company income under subparagraph (C)(ii)";
}
@source(IRC_S954_C, relation = formalizes, coverage = exact, quote = "(i) any item of income, gain, deduction, or loss (other than any item described in subparagraph (A), (E), or")
rule S954C2CiRegularDealerOrdinaryCourseItems defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    when regular_dealer_in_property_954c2C(corp, y)
     and dealer_transaction_in_ordinary_course_954c2C(corp, y, item_id);
    unless item_described_in_954c1A_E_or_G(corp, y, item_id)
     and dealer_transaction_in_ordinary_course_954c2C(corp, y, item_id);
    then fphci_excepted_item_954(corp, y, item_id);
}
@source(IRC_S954_C, relation = formalizes, coverage = exact, quote = "(ii) if such dealer is a dealer in securities (within the meaning of section 475), any interest or dividend")
rule S954C2CiiDealerInSecuritiesInterestAndDividends defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    when regular_dealer_in_property_954c2C(corp, y)
     and dealer_in_securities_475_954c2Cii(corp)
     and dealer_transaction_in_ordinary_course_954c2C(corp, y, item_id)
     and item_described_in_954c1A_E_or_G(corp, y, item_id)
     and dealer_income_attributable_to_home_activities_954c2Cii(corp, y, item_id);
    then item_excluded_by_954c2Cii(corp, y, item_id);
}
@source(IRC_S954_C, relation = formalizes, coverage = exact, quote = "(ii) if such dealer is a dealer in securities (within the meaning of section 475), any interest or dividend")
rule S954C2CiiItemExceptedFromFphci defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    when item_excluded_by_954c2Cii(corp, y, item_id);
    then fphci_excepted_item_954(corp, y, item_id);
}

// --- §954(c)(3)(C): dividends out of earnings accumulated before the recipient held the stock ---------------------------

pub relation dividend_out_of_earnings_accumulated_before_holding_954c3C(item_id: Text) kind empirical {
    label en official "the dividend is attributable to earnings and profits of the distributing corporation accumulated during a period in which the recipient did not hold the stock, either directly or indirectly through a chain of one or more subsidiaries each meeting the requirements of subparagraph (A)(i); the same-country exception of (A)(i) then does not apply (module 10 rule S954C3ASameCountryRelatedPersonException reads it)";
}

// --- §954(d)(3), (d)(4), (e)(2) --------------------------------------------------------------------------------------------------

pub relation control_of_corporation_by_voting_power_or_value_954d3(person: us.irc.core::Person, corp: us.irc.core::Corporation, voting_power: Decimal, value: Decimal) kind empirical {
    label en official "the person's ownership, directly or indirectly (rules similar to section 958), of the stock's total voting power and of the total value of the stock of the corporation (fractions)";
}
@source(IRC_S954_D, relation = formalizes, coverage = exact, quote = "For purposes of the preceding sentence, control means, with respect to a corporation, the ownership, directly")
rule S954D3ControlByVotingPower defeasible {
    for person: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for vote: Decimal;
    for value: Decimal;
    when control_of_corporation_by_voting_power_or_value_954d3(person, corp, vote, value)
     and vote > 0.50;
    then related_person_954d3(person, corp);
}
@source(IRC_S954_D, relation = formalizes, coverage = exact, quote = "For purposes of the preceding sentence, control means, with respect to a corporation, the ownership, directly")
rule S954D3ControlByValue defeasible {
    for person: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for vote: Decimal;
    for value: Decimal;
    when control_of_corporation_by_voting_power_or_value_954d3(person, corp, vote, value)
     and value > 0.50;
    then related_person_954d3(person, corp);
}
pub relation timber_sale_income_954d4A(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text) kind empirical {
    label en official "income derived in connection with the sale of unprocessed timber referred to in section 865(b) (in the form of profits, commissions, fees or otherwise)";
}
pub relation timber_milling_income_outside_us_954d4B(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text) kind empirical {
    label en official "income derived in connection with the milling of such timber outside the United States";
}
@source(IRC_S954_D, relation = formalizes, coverage = exact, quote = "(A) the sale of any unprocessed timber referred to in section 865(b), or")
rule S954D4ATimberSaleIsSalesIncome defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    when timber_sale_income_954d4A(corp, y, item_id);
    then foreign_base_company_sales_income_item(corp, y, item_id);
}
@source(IRC_S954_D, relation = formalizes, coverage = exact, quote = "(B) the milling of any such timber outside the United States.")
rule S954D4BTimberMillingIsSalesIncome defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    when timber_milling_income_outside_us_954d4B(corp, y, item_id);
    then foreign_base_company_sales_income_item(corp, y, item_id);
}
pub relation subpart_g_not_applicable_to_timber_income_954d4(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text) kind institutional {
    label en official "subpart G does not apply to an amount treated as subpart F income by reason of paragraph (4)";
}
@source(IRC_S954_D, relation = formalizes, coverage = exact, quote = "Subpart G shall not apply to any amount treated as subpart F income by reason of this paragraph.")
rule S954D4SubpartGNotApplicableToTimber defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    when foreign_base_company_sales_income_item(corp, y, item_id)
     and timber_sale_income_954d4A(corp, y, item_id);
    then subpart_g_not_applicable_to_timber_income_954d4(corp, y, item_id);
}
@source(IRC_S954_D, relation = formalizes, coverage = exact, quote = "Subpart G shall not apply to any amount treated as subpart F income by reason of this paragraph.")
rule S954D4SubpartGNotApplicableToMilling defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    when foreign_base_company_sales_income_item(corp, y, item_id)
     and timber_milling_income_outside_us_954d4B(corp, y, item_id);
    then subpart_g_not_applicable_to_timber_income_954d4(corp, y, item_id);
}
pub relation services_income_excluded_by_954e2(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text) kind institutional {
    label en official "paragraph (1) does not apply to income that is exempt insurance income (section 953(e)) or not treated as foreign personal holding company income by reason of subsection (c)(2)(C)(ii), (h) or (i)";
}
pub relation item_excluded_from_fphci_by_954i1(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text) kind empirical {
    label en official "the item is qualified insurance income of a qualifying insurance company excluded from foreign personal holding company income by subsection (i)";
}
@source(IRC_S954_E, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall also not apply to income which is exempt insurance income (as defined in section 953(e))")
rule S954E2ExemptInsuranceIncome defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for amount: Money;
    when exempt_insurance_income_item_953e1(corp, y, item_id, amount);
    then services_income_excluded_by_954e2(corp, y, item_id);
}
@source(IRC_S954_E, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall also not apply to income which is exempt insurance income (as defined in section 953(e))")
rule S954E2DealerExclusion defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    when item_excluded_by_954c2Cii(corp, y, item_id);
    then services_income_excluded_by_954e2(corp, y, item_id);
}
@source(IRC_S954_E, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall also not apply to income which is exempt insurance income (as defined in section 953(e))")
rule S954E2BankingFinancingExclusion defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    when item_excluded_from_fphci_954h1(corp, y, item_id);
    then services_income_excluded_by_954e2(corp, y, item_id);
}
@source(IRC_S954_E, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall also not apply to income which is exempt insurance income (as defined in section 953(e))")
rule S954E2InsuranceExclusion defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    when item_excluded_from_fphci_by_954i1(corp, y, item_id);
    then services_income_excluded_by_954e2(corp, y, item_id);
}

// --- §954(h)(3)(B)-(E): limits on qualified banking or financing income ------------------------------------------------------

pub relation direct_lending_finance_percent_from_unrelated_home_customers_954h3B(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, percent: Decimal) kind empirical {
    label en official "the percentage of the corporation's (or unit's) gross income derived directly from the active and regular conduct of a lending or finance business from transactions with customers which are not related persons and which are located within the corporation's or unit's home country";
}
pub relation nonbanking_limitation_met_954h3B(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the limitation of subparagraph (B) is met: the corporation is a licensed bank or registered securities dealer (clause (ii) or (iii) of paragraph (2)(B)), or more than 30 percent of its gross income comes directly from lending or finance with unrelated home-country customers";
}
@source(IRC_S954_H, relation = formalizes, coverage = exact, quote = "No income of an eligible controlled foreign corporation not described in clause (ii) or (iii) of paragraph")
rule S954H3BLicensedBankExempt defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when licensed_us_bank_954h2Bii(corp)
     and eligible_controlled_foreign_corporation_954h2A(corp, y);
    then nonbanking_limitation_met_954h3B(corp, y);
}
@source(IRC_S954_H, relation = formalizes, coverage = exact, quote = "No income of an eligible controlled foreign corporation not described in clause (ii) or (iii) of paragraph")
rule S954H3BRegisteredDealerExempt defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when registered_securities_dealer_954h2Biii(corp)
     and eligible_controlled_foreign_corporation_954h2A(corp, y);
    then nonbanking_limitation_met_954h3B(corp, y);
}
@source(IRC_S954_H, relation = formalizes, coverage = exact, quote = "No income of an eligible controlled foreign corporation not described in clause (ii) or (iii) of paragraph")
rule S954H3BMoreThanThirtyPercent defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for percent: Decimal;
    when direct_lending_finance_percent_from_unrelated_home_customers_954h3B(corp, y, percent)
     and percent > 30.0;
    then nonbanking_limitation_met_954h3B(corp, y);
}
pub relation transaction_with_customers_outside_home_country_954h3C(item_id: Text) kind empirical {
    label en official "the income is derived from transactions with customers located in a country other than the home country of the eligible controlled foreign corporation or unit";
}
pub relation substantial_home_country_activity_954h3C(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the corporation or unit conducts substantial activity with respect to a banking, financing or similar business in its home country";
}
pub relation qualified_income_home_country_customer_limit_met_954h3C(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text) kind institutional {
    label en official "income from transactions with customers in a country other than the home country is qualified only if the corporation or unit conducts substantial banking, financing or similar activity in its home country";
}
@source(IRC_S954_H, relation = formalizes, coverage = exact, quote = "The term \"qualified banking or financing income\" shall not include income derived from 1 or more transactions")
rule S954H3CForeignCustomersWithHomeActivity defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    when transaction_with_customers_outside_home_country_954h3C(item_id)
     and substantial_home_country_activity_954h3C(corp, y);
    then qualified_income_home_country_customer_limit_met_954h3C(corp, y, item_id);
}
@source(IRC_S954_H, relation = formalizes, coverage = exact, quote = "The term \"qualified banking or financing income\" shall not include income derived from 1 or more transactions")
rule S954H3CHomeCountryCustomersUnrestricted defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for amount: Money;
    when income_derived_in_active_conduct_of_banking_by_cfc_or_qbu_954h3Ai(corp, y, item_id, amount);
    unless transaction_with_customers_outside_home_country_954h3C(item_id)
     and income_derived_in_active_conduct_of_banking_by_cfc_or_qbu_954h3Ai(corp, y, item_id, amount);
    then qualified_income_home_country_customer_limit_met_954h3C(corp, y, item_id);
}
pub relation qbu_or_cfc_item_attributable_954h3D(unit_id: Text, item_id: Text, attributable_amount: Money) kind empirical {
    label en official "an item of income, deduction, gain or loss, or an activity, properly allocable or attributable to the qualified business unit (for the eligible controlled foreign corporation itself: not allocable to any unit)";
}
pub relation qualified_income_determined_separately_for_unit_954h3D(unit_id: Text, item_id: Text, amount: Money) kind institutional {
    label en official "the qualified banking or financing income of the corporation and each qualified business unit is determined separately, taking into account only the items and activities properly allocable or attributable to each";
}
@source(IRC_S954_H, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the qualified banking or financing income of an eligible controlled foreign")
rule S954H3DSeparateDeterminationPerUnit defeasible {
    for unit_id: Text;
    for item_id: Text;
    for amount: Money;
    when qbu_or_cfc_item_attributable_954h3D(unit_id, item_id, amount);
    then qualified_income_determined_separately_for_unit_954h3D(unit_id, item_id, amount);
}
pub relation related_eligible_cfc_activity_954h3E(activity_id: Text, related_home_country: Text, unit_home_country: Text) kind empirical {
    label en official "an activity performed by employees of a related person that is an eligible controlled foreign corporation, and the home country of that related person and of the corporation or unit to which subparagraph (A)(ii)(II) is applied";
}
pub relation related_person_activity_performed_in_its_home_country_954h3Eii(activity_id: Text) kind empirical {
    label en official "the activity is performed in the home country of the related person";
}
pub relation related_person_compensated_arm_length_and_earned_at_home_954h3Eiii(activity_id: Text) kind empirical {
    label en official "the related person is compensated on an arm's-length basis for the activity of its employees and the compensation is treated as earned in its home country for that country's tax laws";
}
pub relation activity_treated_as_conducted_directly_in_home_country_954h3E(activity_id: Text) kind institutional {
    label en official "the activity is treated as conducted directly by the eligible controlled foreign corporation or unit in its home country";
}
@source(IRC_S954_H, relation = formalizes, coverage = exact, quote = "For purposes of subparagraph (A)(ii)(II), an activity shall be treated as conducted directly by an eligible")
rule S954H3EActivityByRelatedEligibleCfcTreatedAsDirect defeasible {
    for activity_id: Text;
    for related_country: Text;
    for unit_country: Text;
    when related_eligible_cfc_activity_954h3E(activity_id, related_country, unit_country)
     and related_country == unit_country
     and related_person_activity_performed_in_its_home_country_954h3Eii(activity_id)
     and related_person_compensated_arm_length_and_earned_at_home_954h3Eiii(activity_id);
    then activity_treated_as_conducted_directly_in_home_country_954h3E(activity_id);
}

// --- §954(i)(1), (i)(3), (i)(4)(B)-(C): qualified insurance income ----------------------------------------------------------

pub relation qualified_insurance_income_excluded_from_fphci_954i1(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "for subsection (c)(1), foreign personal holding company income does not include qualified insurance income of a qualifying insurance company";
}
@source(IRC_S954_I, relation = formalizes, coverage = exact, quote = "For purposes of subsection (c)(1), foreign personal holding company income shall not include qualified")
rule S954I1QualifiedInsuranceIncomeExcluded defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when qualifying_insurance_company_953e3(corp, y)
     and qualified_insurance_income_954i2(corp, y, amount);
    then qualified_insurance_income_excluded_from_fphci_954i1(corp, y, amount);
}
pub relation separate_account_contract_income_credited_954i3A(contract_id: Text, amount: Money) kind empirical {
    label en official "income credited under a separate account-type contract (including a variable contract not meeting section 817)";
}
pub relation income_allocable_only_to_separate_account_contract_954i3A(contract_id: Text, amount: Money) kind institutional {
    label en official "income credited under a separate account-type contract is allocable only to that contract";
}
@source(IRC_S954_I, relation = formalizes, coverage = exact, quote = "(A) in the case of any contract which is a separate account-type contract (including any variable contract")
rule S954I3ASeparateAccountIncomeOnlyToContract defeasible {
    for contract_id: Text;
    for amount: Money;
    when separate_account_contract_income_credited_954i3A(contract_id, amount);
    then income_allocable_only_to_separate_account_contract_954i3A(contract_id, amount);
}
pub relation income_not_allocated_under_954i3A(amount: Money) kind empirical {
    label en official "income not allocable under subparagraph (A), to be allocated ratably among the contracts not described in subparagraph (A)";
}
pub relation other_contract_weight_954i3B(contract_id: Text, weight: Money) kind empirical {
    label en official "the weight (its reserve) of a contract not described in subparagraph (A), for the ratable allocation";
}
pub relation total_other_contract_weight_954i3B(total: Money) kind empirical {
    label en unofficial "the sum of the weights of the contracts not described in subparagraph (A) (asserted directly, section 111)";
}
pub relation income_allocated_ratably_to_contract_954i3B(contract_id: Text, amount: Money) kind institutional {
    label en official "the income not allocable under subparagraph (A) is allocated ratably among the other contracts";
}
@source(IRC_S954_I, relation = formalizes, coverage = exact, quote = "(B) income not allocable under subparagraph (A) shall be allocated ratably among contracts not described in")
rule S954I3BRatableAllocation defeasible {
    for contract_id: Text;
    for income: Money;
    for weight: Money;
    for total: Money;
    when income_not_allocated_under_954i3A(income)
     and other_contract_weight_954i3B(contract_id, weight)
     and total_other_contract_weight_954i3B(total)
     and total > 0.00 USD;
    then income_allocated_ratably_to_contract_954i3B(contract_id, div_round(income * (weight / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}
pub relation net_surrender_value_954i4Bi(contract_id: Text, amount: Money) kind empirical {
    label en official "the net surrender value of the life insurance or annuity contract (section 807(e)(1)(A))";
}
pub relation reserve_under_paragraph_5_954i4BiII(contract_id: Text, amount: Money) kind empirical {
    label en official "the reserve determined under paragraph (5) for the contract (the subchapter L computation with the foreign rate and tables is a case input, technical gap G1752)";
}
pub relation life_reserve_greater_of_surrender_value_and_paragraph_5_954i4Bi(contract_id: Text, amount: Money) kind institutional {
    label en official "the reserve for a life insurance or annuity contract: the greater of the net surrender value and the paragraph (5) reserve";
}
@source(IRC_S954_I, relation = formalizes, coverage = exact, quote = "Except as provided in clause (ii), the amount of the reserve of a qualifying insurance company or qualifying")
rule S954I4BiGreaterOfSurrenderValueAndParagraphFive defeasible {
    for contract_id: Text;
    for surrender: Money;
    for reserve5: Money;
    when net_surrender_value_954i4Bi(contract_id, surrender)
     and reserve_under_paragraph_5_954i4BiII(contract_id, reserve5);
    then life_reserve_greater_of_surrender_value_and_paragraph_5_954i4Bi(contract_id, max(surrender, reserve5));
}
pub relation foreign_statement_reserve_net_of_catastrophe_and_similar_954i4Bii(contract_id: Text, amount: Money) kind empirical {
    label en official "the foreign statement reserve for the contract, less any catastrophe, deficiency, equalization or similar reserves";
}
external judgment relation secretary_determines_foreign_statement_reserve_appropriate_954i4Bii(contract_id: Text) {
    authority Secretary;
    label en official "pursuant to a ruling request submitted by the taxpayer or published guidance, the Secretary determines that the factors taken into account in determining the foreign statement reserve provide an appropriate means of measuring income (section 954(i)(4)(B)(ii)) — committed to the Secretary (DECISION-0194)";
}
pub relation life_reserve_by_foreign_statement_954i4Bii(contract_id: Text, amount: Money) kind institutional {
    label en official "the reserve is the foreign statement reserve (less catastrophe and similar reserves) where the Secretary has determined it an appropriate measure";
}
@source(IRC_S954_I, relation = formalizes, coverage = exact, quote = "The amount of the reserve under clause (i) shall be the foreign statement reserve for the contract (less any")
rule S954I4BiiForeignStatementReserveWhereSecretaryDetermines defeasible {
    for contract_id: Text;
    for amount: Money;
    when foreign_statement_reserve_net_of_catastrophe_and_similar_954i4Bii(contract_id, amount)
     and secretary_determines_foreign_statement_reserve_appropriate_954i4Bii(contract_id);
    then life_reserve_by_foreign_statement_954i4Bii(contract_id, amount);
}
pub relation reserve_limited_to_foreign_statement_reserve_954i4C(contract_id: Text, amount: Money) kind institutional {
    label en official "in no event may the reserve determined under this paragraph exceed the amount taken into account in determining foreign statement reserves (less catastrophe, deficiency, equalization or similar reserves)";
}
@source(IRC_S954_I, relation = formalizes, coverage = exact, quote = "In no event shall the reserve determined under this paragraph for any contract as of any time exceed the")
rule S954I4CReserveCap defeasible {
    for contract_id: Text;
    for surrender: Money;
    for reserve5: Money;
    for foreign: Money;
    when net_surrender_value_954i4Bi(contract_id, surrender)
     and reserve_under_paragraph_5_954i4BiII(contract_id, reserve5)
     and foreign_statement_reserve_net_of_catastrophe_and_similar_954i4Bii(contract_id, foreign);
    then reserve_limited_to_foreign_statement_reserve_954i4C(contract_id, min(max(surrender, reserve5), foreign));
}
