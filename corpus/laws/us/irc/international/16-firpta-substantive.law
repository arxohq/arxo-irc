// §897(a),(c)(1)-(2),(h) core — FIRPTA substantive rules. Stage 2b (IRC-10
// stage 2b, A13). Modeled: (a)(1) treatment of USRPI disposition gain/loss
// as ECI (nonresident alien individual under section 871(b)(1), foreign
// corporation under section 882(a)(1)); (c)(1)(A)-(B) the USRPI general
// definition (real property interest, or a domestic-corporation interest
// unless the taxpayer shows it was never a USRPHC); (c)(2) the USRPHC 50%
// fair-market-value test at its exact boundary; (h)(1) the REIT/RIC look-
// through of distributions to gain from a USRPI sale, with the 5%-publicly-
// traded-stock carve-out; (h)(2) the domestically-controlled-qie
// exclusion; (h)(4)(A)-(B) the qualified-investment-qie and
// domestically-controlled definitions.
//
// NOT modeled this stage: (a)(2) the alternative minimum tax floor
// (EXTERNAL_DEPENDENCY on `other-income-taxes`' section 55 AMT schedule,
// same pending dependency other packages already carry); (b) the
// individual loss limitation; (c)(1)(B) exclusion for certain corporations,
// (c)(3) the 5%-publicly-traded-stock USRPI carve-out itself (only its use
// inside (h)(1) is modeled), (c)(4)-(6) (foreign-corporation/partnership
// look-through, controlling-interest rules, and the 5%-for-50% section
// 318(a) modification) — TECH_GAP, same class as this package's other
// bounded-hop attribution limitations (G95/G103); (d)-(g) (distribution
// gain recognition, nonrecognition coordination, the repealed (f), and the
// partnership/trust/estate interest-sale rule) — NOT modeled; (h)(3) and
// (h)(4)(C)-(E) (foreign-ownership-percentage mechanics, testing period,
// special ownership rules) and (h)(5) (wash-sale rules) — NOT modeled,
// TECH_GAP; (i)-(l) (domestic-corporation election, REIT-specific rules,
// interests not treated as USRPI, cross-references) — NOT modeled.

// --- (a)(1): treatment as effectively connected -----------------------

use self::{
    IRC_S897_A,
    IRC_S897_C,
    IRC_S897_H,
};

pub relation usrpi_disposition_gain_or_loss_individual(p: us.irc.core::Individual, amount: Money) kind empirical {
    label en unofficial "gain or loss of a nonresident alien individual from the disposition of a United States real property interest, for section 897(a)(1)(A)";
}
pub relation usrpi_disposition_gain_or_loss_corp(corp: us.irc.core::Corporation, amount: Money) kind empirical {
    label en unofficial "gain or loss of a foreign corporation from the disposition of a United States real property interest, for section 897(a)(1)(B)";
}
@source(IRC_S897_A, relation = formalizes, coverage = partial, quote = "gain or loss of a nonresident alien individual or a foreign corporation from the disposition of a United States real property interest shall be taken into account—\n(A) in the case of a nonresident alien individual, under section 871(b)(1), or\n(B) in the case of a foreign corporation, under section 882(a)(1),\nas if the taxpayer were engaged in a trade or business within the United States during the taxable year and as if such gain or loss were effectively connected with such trade or business")
pub relation usrpi_gain_treated_as_eci(p: us.irc.core::Person, amount: Money) kind institutional {
    label en official "gain or loss from the disposition of a United States real property interest is taken into account as if the taxpayer were engaged in a US trade or business and as if the gain or loss were effectively connected with it (section 897(a)(1))";
}
rule S897A1AIndividualUsrpiGainIsEci strict {
    for p: us.irc.core::Individual;
    for amount: Money;
    when usrpi_disposition_gain_or_loss_individual(p, amount);
    then usrpi_gain_treated_as_eci(p, amount);
}
rule S897A1BCorporateUsrpiGainIsEci strict {
    for corp: us.irc.core::Corporation;
    for amount: Money;
    when usrpi_disposition_gain_or_loss_corp(corp, amount);
    then usrpi_gain_treated_as_eci(corp, amount);
}

// --- (c)(2): United States real property holding corporation, 50% test --

pub relation fmv_us_real_property_interests(corp: us.irc.core::Corporation, amount: Money) kind empirical {
    label en unofficial "the fair market value of the corporation's United States real property interests, for section 897(c)(2)(A)";
}
pub relation fmv_foreign_real_property_interests(corp: us.irc.core::Corporation, amount: Money) kind empirical {
    label en unofficial "the fair market value of the corporation's interests in real property located outside the United States, for section 897(c)(2)(B)(ii)";
}
pub relation fmv_other_trade_or_business_assets(corp: us.irc.core::Corporation, amount: Money) kind empirical {
    label en unofficial "the fair market value of the corporation's other assets used or held for use in a trade or business, for section 897(c)(2)(B)(iii)";
}
@source(IRC_S897_C, relation = formalizes, coverage = exact, quote = "the fair market value of its United States real property interests equals or exceeds 50 percent of\n(B) the fair market value of—\n(i) its United States real property interests,\n(ii) its interests in real property located outside the United States, plus\n(iii) any other of its assets which are used or held for use in a trade or business")
pub relation united_states_real_property_holding_corporation(corp: us.irc.core::Corporation) kind institutional {
    label en official "the corporation is a United States real property holding corporation (section 897(c)(2)): the fair market value of its USRPIs equals or exceeds 50 percent of the sum of its USRPIs, its foreign real property interests, and its other trade-or-business assets";
}
rule S897C2UsrphcFiftyPercentTest defeasible {
    for corp: us.irc.core::Corporation;
    for us_rpi: Money;
    for foreign_rpi: Money;
    for other_assets: Money;
    when fmv_us_real_property_interests(corp, us_rpi)
     and fmv_foreign_real_property_interests(corp, foreign_rpi)
     and fmv_other_trade_or_business_assets(corp, other_assets)
     and (us_rpi + foreign_rpi + other_assets) > 0.00 USD
     and (us_rpi * 2.00) >= (us_rpi + foreign_rpi + other_assets);
    then united_states_real_property_holding_corporation(corp);
}

// --- (c)(1): United States real property interest ------------------------

pub relation real_property_interest_located_in_us_or_vi(item_id: Text) kind empirical {
    label en official "an interest in real property (including an interest in a mine, well, or other natural deposit) located in the United States or the Virgin Islands, for section 897(c)(1)(A)(i)";
}
pub relation interest_in_domestic_corporation_897(holder: us.irc.core::Person, corp: us.irc.core::Corporation) kind empirical {
    label en unofficial "the taxpayer holds an interest (other than solely as a creditor) in a domestic corporation, for section 897(c)(1)(A)(ii)";
}
pub relation taxpayer_established_never_usrphc(holder: us.irc.core::Person, corp: us.irc.core::Corporation) kind empirical {
    label en unofficial "the taxpayer has established to the Secretary's satisfaction that the domestic corporation was at no time a United States real property holding corporation during the applicable testing period, for the section 897(c)(1)(A)(ii) exception";
}
@source(IRC_S897_C, relation = formalizes, coverage = partial, quote = "any interest (other than an interest solely as a creditor) in any domestic corporation unless the taxpayer establishes (at such time and in such manner as the Secretary by regulations prescribes) that such corporation was at no time a United States real property holding corporation")
pub relation united_states_real_property_interest(holder: us.irc.core::Person, item_id: Text) kind institutional {
    label en official "the interest is a United States real property interest under section 897(c)(1): real property located in the US/Virgin Islands, or an interest in a domestic corporation that the taxpayer has not shown was never a USRPHC during the applicable period";
}
pub relation holds_interest_in_item_897(holder: us.irc.core::Person, item_id: Text) kind empirical {
    label en unofficial "the taxpayer holds the given interest, for wiring a holder-agnostic classification (like the (c)(1)(A)(i) real-property test) to a specific taxpayer's disposition — a domain-anchor fact, §190";
}
rule S897C1AiRealPropertyInterest defeasible {
    for holder: us.irc.core::Person;
    for item_id: Text;
    when holds_interest_in_item_897(holder, item_id)
     and real_property_interest_located_in_us_or_vi(item_id);
    then united_states_real_property_interest(holder, item_id);
}

// --- (h): special rules for certain investment entities (REIT/RIC) -------

pub relation qualified_investment_entity(qie: us.irc.core::Corporation) kind empirical {
    label en unofficial "the qie is a qualified investment qie: a real estate investment trust, or a regulated investment company that is (or would be, absent the (c)(3)/(h)(2) exceptions) a United States real property holding corporation, for section 897(h)(4)(A) — the REIT/RIC classification itself is asserted directly rather than re-derived from a REIT/RIC-owning package";
}
pub relation foreign_ownership_percentage_below_fifty(qie: us.irc.core::Corporation) kind empirical {
    label en unofficial "at all times during the testing period, less than 50 percent in value of the qie's stock was held directly or indirectly by foreign persons, for the section 897(h)(4)(B) domestically-controlled test";
}
@source(IRC_S897_H, relation = formalizes, coverage = exact, quote = "The term \"domestically controlled qualified investment entity\" means any qualified investment entity in which at all times during the testing period less than 50 percent in value of the stock was held directly or indirectly by foreign persons.")
pub relation domestically_controlled_qualified_investment_entity(qie: us.irc.core::Corporation) kind institutional {
    label en official "the qualified investment qie is domestically controlled under section 897(h)(4)(B): less than 50% in value of its stock was held by foreign persons throughout the testing period";
}
rule S897H4BDomesticallyControlled defeasible {
    for qie: us.irc.core::Corporation;
    when qualified_investment_entity(qie)
     and foreign_ownership_percentage_below_fifty(qie);
    then domestically_controlled_qualified_investment_entity(qie);
}
@source(IRC_S897_H, relation = formalizes, coverage = exact, quote = "The term \"United States real property interest\" does not include any interest in a domestically controlled qualified investment entity.")
rule S897H2DomesticallyControlledNotUsrpi defeasible {
    for holder: us.irc.core::Person;
    for qie: us.irc.core::Corporation;
    for item_id: Text;
    when interest_in_qualified_investment_entity(holder, qie, item_id)
     and domestically_controlled_qualified_investment_entity(qie);
    then usrpi_excluded_897h2(holder, item_id);
}
pub relation interest_in_qualified_investment_entity(holder: us.irc.core::Person, qie: us.irc.core::Corporation, item_id: Text) kind empirical {
    label en unofficial "the taxpayer's interest (item_id) is an interest in the given qualified investment qie, for wiring the (h)(2) exclusion to a specific USRPI classification instance";
}
pub relation usrpi_excluded_897h2(holder: us.irc.core::Person, item_id: Text) kind institutional {
    label en official "the interest in a domestically controlled qualified investment qie is excluded from United States real property interest treatment (section 897(h)(2))";
}

pub relation qie_distribution_attributable_to_usrpi_gain(qie: us.irc.core::Corporation, recipient: us.irc.core::Person, amount: Money) kind empirical {
    label en unofficial "the portion of a distribution by the qualified investment qie to the recipient that is attributable to the qie's gain from sales or exchanges of United States real property interests, for section 897(h)(1)";
}
pub relation distribution_stock_regularly_traded_in_us(qie: us.irc.core::Corporation, recipient: us.irc.core::Person) kind empirical {
    label en official "the distribution is with respect to a class of stock of the qualified investment qie regularly traded on an established securities market in the United States, for the section 897(h)(1) 5%-shareholder carve-out";
}
pub relation recipient_owned_five_percent_or_less_stock_class(qie: us.irc.core::Corporation, recipient: us.irc.core::Person) kind empirical {
    label en official "the recipient did not own more than 5 percent of the traded class of stock at any time during the 1-year period ending on the distribution date, for the section 897(h)(1) carve-out";
}
@source(IRC_S897_H, relation = formalizes, coverage = partial, quote = "Any distribution by a qualified investment entity to a nonresident alien individual, a foreign corporation, or other qualified investment entity shall, to the extent attributable to gain from sales or exchanges by the qualified investment entity of United States real property interests, be treated as gain recognized by such nonresident alien individual, foreign corporation, or other qualified investment entity from the sale or exchange of a United States real property interest")
pub relation qie_distribution_treated_as_usrpi_gain(qie: us.irc.core::Corporation, recipient: us.irc.core::Person, amount: Money) kind institutional {
    label en official "the QIE distribution (to the extent attributable to the qie's USRPI sale gain) is treated as gain recognized by the recipient from the sale or exchange of a United States real property interest (section 897(h)(1)), unless the 5%-publicly-traded-stock carve-out applies";
}
rule S897H1LookThroughDistribution defeasible {
    for qie: us.irc.core::Corporation;
    for recipient: us.irc.core::Person;
    for amount: Money;
    when qie_distribution_attributable_to_usrpi_gain(qie, recipient, amount);
    unless distribution_stock_regularly_traded_in_us(qie, recipient)
     and recipient_owned_five_percent_or_less_stock_class(qie, recipient)
     and qie_distribution_attributable_to_usrpi_gain(qie, recipient, amount);
    then qie_distribution_treated_as_usrpi_gain(qie, recipient, amount);
}
