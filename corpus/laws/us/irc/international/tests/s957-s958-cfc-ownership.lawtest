// §957(a); §958(a) scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.international version "0.1.1";
namespace "urn:us:irc:international:clir";

test "S957-01-CFC-AT-50-POINT-1-PERCENT-VOTE" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": foreign_corporation_957(entity_ref("urn:test:s957:c1#corp")) { origin case_input; }
        assert "f1": aggregate_us_shareholder_vote_share_on_day(entity_ref("urn:test:s957:c1#corp"), entity_ref("urn:test:s957:c1#y"), @2024-06-01, 0.501) { origin case_input; }
    }
    evaluate truth(controlled_foreign_corporation(entity_ref("urn:test:s957:c1#corp"), entity_ref("urn:test:s957:c1#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S957-02-EXACTLY-50-PERCENT-IS-NOT-A-CFC" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": foreign_corporation_957(entity_ref("urn:test:s957:c2#corp")) { origin case_input; }
        assert "f1": aggregate_us_shareholder_vote_share_on_day(entity_ref("urn:test:s957:c2#corp"), entity_ref("urn:test:s957:c2#y"), @2024-06-01, 0.50) { origin case_input; }
    }
    evaluate truth(controlled_foreign_corporation(entity_ref("urn:test:s957:c2#corp"), entity_ref("urn:test:s957:c2#y")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

test "S958-01-DIRECT-OWNERSHIP" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": stock_owned_directly(entity_ref("urn:test:s958:d1#holder"), entity_ref("urn:test:s958:d1#corp"), 0.60, 0.60) { origin case_input; }
    }
    evaluate truth(stock_owned_under_958a(entity_ref("urn:test:s958:d1#holder"), entity_ref("urn:test:s958:d1#corp"), 0.60, 0.60));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S958-02-PROPORTIONATE-LOOK-THROUGH-FOREIGN-PARTNERSHIP" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": foreign_entity_holds_stock(entity_ref("urn:test:s958:p1#pship"), entity_ref("urn:test:s958:p1#corp"), 0.80, 0.80) { origin case_input; }
        assert "f1": proportionate_interest_in_foreign_entity(entity_ref("urn:test:s958:p1#partner"), entity_ref("urn:test:s958:p1#pship"), 0.50) { origin case_input; }
    }
    evaluate truth(stock_owned_under_958a(entity_ref("urn:test:s958:p1#partner"), entity_ref("urn:test:s958:p1#corp"), 0.40, 0.40));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
