// §861(a) source-rule scenarios. NOT EXECUTED (implemented_unverified per
// AGENT-BRIEF NO-HEAVY-CHECKS restriction).

language "law.core" version "0.2";
package us.irc.international version "0.1.1";
namespace "urn:us:irc:international:clir";

test "S861-01-INTEREST-FROM-DOMESTIC-CORPORATION-IS-US-SOURCE" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": us.irc.definitions::domestic(entity_ref("urn:test:s861:i1#payer")) { origin case_input; }
        assert "f1": interest_payment(entity_ref("urn:test:s861:i1#payer"), entity_ref("urn:test:s861:i1#payee"), 1000 USD) { origin case_input; }
    }
    evaluate truth(us_source_interest(entity_ref("urn:test:s861:i1#payer"), entity_ref("urn:test:s861:i1#payee"), 1000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S861-02-FOREIGN-BRANCH-BANKING-DEPOSIT-INTEREST-EXCLUDED" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": us.irc.definitions::domestic(entity_ref("urn:test:s861:i2#payer")) { origin case_input; }
        assert "f1": interest_payment(entity_ref("urn:test:s861:i2#payer"), entity_ref("urn:test:s861:i2#payee"), 500 USD) { origin case_input; }
        assert "f2": foreign_branch_commercial_banking_deposit_interest(entity_ref("urn:test:s861:i2#payer"), entity_ref("urn:test:s861:i2#payee")) { origin case_input; }
    }
    evaluate truth(us_source_interest(entity_ref("urn:test:s861:i2#payer"), entity_ref("urn:test:s861:i2#payee"), 500 USD));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

test "S861-03-DIVIDEND-LOOK-THROUGH-AT-25-PERCENT-QUALIFIES" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": us.irc.definitions::foreign(entity_ref("urn:test:s861:d1#payer")) { origin case_input; }
        assert "f1": foreign_corp_eci_gross_income_ratio(entity_ref("urn:test:s861:d1#payer"), 0.25) { origin case_input; }
    }
    evaluate truth(foreign_dividend_us_source_ratio(entity_ref("urn:test:s861:d1#payer"), 0.25));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S861-04-DIVIDEND-LOOK-THROUGH-BELOW-25-PERCENT-IS-ZERO" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": us.irc.definitions::foreign(entity_ref("urn:test:s861:d2#payer")) { origin case_input; }
        assert "f1": foreign_corp_eci_gross_income_ratio(entity_ref("urn:test:s861:d2#payer"), 0.249) { origin case_input; }
    }
    evaluate truth(foreign_dividend_us_source_ratio(entity_ref("urn:test:s861:d2#payer"), 0.00));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S861-05-PERSONAL-SERVICES-COMMERCIAL-TRAVELER-EXCEPTION-AT-90-DAYS-3000" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": nonresident_alien(entity_ref("urn:test:s861:p1#worker")) { origin case_input; }
        assert "f1": personal_services_performed_in_us(entity_ref("urn:test:s861:p1#worker"), 3000 USD) { origin case_input; }
        assert "f2": days_present_performing_services_in_us(entity_ref("urn:test:s861:p1#worker"), entity_ref("urn:test:s861:p1#y2024"), 90) { origin case_input; }
        assert "f3": employer_or_contracting_party_of(entity_ref("urn:test:s861:p1#worker"), entity_ref("urn:test:s861:p1#employer")) { origin case_input; }
        assert "f4": employer_not_engaged_in_us_trade_or_business(entity_ref("urn:test:s861:p1#employer")) { origin case_input; }
    }
    // at the boundary (90 days, $3,000) the exception applies: NOT US-source.
    evaluate truth(us_source_personal_services_income(entity_ref("urn:test:s861:p1#worker"), 3000 USD));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

