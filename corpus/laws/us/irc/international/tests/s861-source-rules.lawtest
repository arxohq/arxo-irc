        assert "f2": days_present_performing_services_in_us(entity_ref("urn:test:s861:p2#worker"), entity_ref("urn:test:s861:p2#y2024"), 91) { origin case_input; }
        assert "f3": employer_or_contracting_party_of(entity_ref("urn:test:s861:p2#worker"), entity_ref("urn:test:s861:p2#employer")) { origin case_input; }
        assert "f4": employer_not_engaged_in_us_trade_or_business(entity_ref("urn:test:s861:p2#employer")) { origin case_input; }
    }
    evaluate truth(us_source_personal_services_income(entity_ref("urn:test:s861:p2#worker"), 3000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
