        context { legal_time @2025-06-01; decision_time @2025-06-01T09:00:00-05:00; knowledge_time @2025-06-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": transportation_income_863c(entity_ref("urn:test:s863c2b03vesselpersonals153#a"), "t1", 1000 USD) { origin case_input; }
        assert "f1": transportation_begins_or_ends_in_us("t1") { origin case_input; }
        assert "f2": transportation_income_is_personal_services_income("t1") { origin case_input; }
        assert "f3": transportation_income_relates_to_vessel("t1") { origin case_input; }
        assert "f4": taxpayer_citizen_or_resident_alien_863c(entity_ref("urn:test:s863c2b03vesselpersonals153#a")) { origin case_input; }
    }
    evaluate truth(section_863c2b_applies(entity_ref("urn:test:s863c2b03vesselpersonals153#a"), "t1"));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

