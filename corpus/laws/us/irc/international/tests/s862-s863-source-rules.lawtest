        assert "f1": item_is_interest_862("i1") { origin case_input; }
    }
    evaluate truth(foreign_source_item_862(entity_ref("urn:test:s862a101interestnotussou304#a"), "i1", 1000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

