test "S1297C-01-LOOK-THROUGH-TWENTY-FIVE-PERCENT-OWNED" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": owns_at_least_25_percent_by_value(entity_ref("urn:test:s1297c:parent1"), entity_ref("urn:test:s1297c:sub1"), 0.25) { origin case_input; }
        assert "f1": subsidiary_assets_amount(entity_ref("urn:test:s1297c:sub1"), entity_ref("urn:test:s1297c:y1"), 400000 USD) { origin case_input; }
        assert "f2": subsidiary_passive_income_amount(entity_ref("urn:test:s1297c:sub1"), entity_ref("urn:test:s1297c:y1"), 80000 USD) { origin case_input; }
    }
    evaluate truth(look_through_proportionate_share_1297c(entity_ref("urn:test:s1297c:parent1"), entity_ref("urn:test:s1297c:sub1"), entity_ref("urn:test:s1297c:y1"), 100000 USD, 20000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

