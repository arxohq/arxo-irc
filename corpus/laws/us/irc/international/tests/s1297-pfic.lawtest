// §1297(a) scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.international version "0.1.1";
namespace "urn:us:irc:international:clir";

test "S1297-01-INCOME-TEST-AT-75-PERCENT-QUALIFIES" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": foreign_corporation_1297(entity_ref("urn:test:s1297:i1#corp")) { origin case_input; }
        assert "f1": gross_income_passive_ratio(entity_ref("urn:test:s1297:i1#corp"), entity_ref("urn:test:s1297:i1#y"), 0.75) { origin case_input; }
    }
    evaluate truth(passive_foreign_investment_company(entity_ref("urn:test:s1297:i1#corp"), entity_ref("urn:test:s1297:i1#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

