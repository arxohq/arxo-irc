        assert "f1": elects_qef_1295(entity_ref("urn:test:s1295:p1"), entity_ref("urn:test:s1295:corp1")) { origin case_input; }
    }
    evaluate positions();
    expect position(S1295QefElection, VALIDLY_EXERCISED);
}

test "S1296-01-MARK-TO-MARKET-INCLUSION-FMV-EXCEEDS-BASIS" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": marketable_stock_1296(entity_ref("urn:test:s1296:corp1")) { origin case_input; }
        assert "f1": elects_mark_to_market_1296(entity_ref("urn:test:s1296:p1"), entity_ref("urn:test:s1296:corp1")) { origin case_input; }
        assert "f2": pfic_stock_fair_market_value(entity_ref("urn:test:s1296:p1"), entity_ref("urn:test:s1296:corp1"), entity_ref("urn:test:s1296:y1"), 15000 USD) { origin case_input; }
        assert "f3": pfic_stock_adjusted_basis(entity_ref("urn:test:s1296:p1"), entity_ref("urn:test:s1296:corp1"), entity_ref("urn:test:s1296:y1"), 10000 USD) { origin case_input; }
    }
    evaluate truth(mtm_inclusion_1296a1(entity_ref("urn:test:s1296:p1"), entity_ref("urn:test:s1296:corp1"), entity_ref("urn:test:s1296:y1"), 5000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1296-02-MARK-TO-MARKET-DEDUCTION-CAPPED-AT-UNREVERSED-INCLUSIONS" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": marketable_stock_1296(entity_ref("urn:test:s1296:corp2")) { origin case_input; }
        assert "f1": elects_mark_to_market_1296(entity_ref("urn:test:s1296:p2"), entity_ref("urn:test:s1296:corp2")) { origin case_input; }
        assert "f2": pfic_stock_fair_market_value(entity_ref("urn:test:s1296:p2"), entity_ref("urn:test:s1296:corp2"), entity_ref("urn:test:s1296:y2"), 4000 USD) { origin case_input; }
        assert "f3": pfic_stock_adjusted_basis(entity_ref("urn:test:s1296:p2"), entity_ref("urn:test:s1296:corp2"), entity_ref("urn:test:s1296:y2"), 10000 USD) { origin case_input; }
        assert "f4": unreversed_inclusions_1296d(entity_ref("urn:test:s1296:p2"), entity_ref("urn:test:s1296:corp2"), entity_ref("urn:test:s1296:y2"), 3000 USD) { origin case_input; }
    }
    // excess = 6000, but capped at unreversed inclusions 3000.
    evaluate truth(mtm_deduction_1296a2(entity_ref("urn:test:s1296:p2"), entity_ref("urn:test:s1296:corp2"), entity_ref("urn:test:s1296:y2"), 3000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
