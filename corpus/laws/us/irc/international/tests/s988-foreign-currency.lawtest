// §988(a),(c)(1),(e) scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.international version "0.1.1";
namespace "urn:us:irc:international:clir";

test "S988C1-01-DEBT-INSTRUMENT-IN-NONFUNCTIONAL-CURRENCY-IS-988-TRANSACTION" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": debt_instrument_acquired_or_issued("bond1") { origin case_input; }
        assert "f1": amount_denominated_in_nonfunctional_currency("bond1") { origin case_input; }
    }
    evaluate truth(section_988_transaction("bond1"));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S988A1A-01-ORDINARY-CHARACTER-DEFAULT" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": debt_instrument_acquired_or_issued("bond2") { origin case_input; }
        assert "f1": amount_denominated_in_nonfunctional_currency("bond2") { origin case_input; }
        assert "f2": section_988_gain_or_loss("bond2", 500 USD) { origin case_input; }
    }
    evaluate truth(section_988_ordinary_character("bond2", 500 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S988A1B-01-CAPITAL-CHARACTER-ELECTION-VALID" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": contract_eligible_for_988a1b_election(entity_ref("urn:test:s988a1b:p1"), "fwd1") { origin case_input; }
        assert "f1": elects_capital_character_988a1b(entity_ref("urn:test:s988a1b:p1"), "fwd1") { origin case_input; }
    }
    evaluate positions();
    expect position(S988A1BCapitalCharacterElectionPower, VALIDLY_EXERCISED);
}

test "S988E2-01-TWO-HUNDRED-DOLLAR-EXCLUSION-AT-BOUNDARY" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": forward_futures_option_entered_into("fx1") { origin case_input; }
        assert "f1": amount_denominated_in_nonfunctional_currency("fx1") { origin case_input; }
        assert "f2": nonfunctional_currency_disposition_gain(entity_ref("urn:test:s988e2:p1"), "fx1", 200 USD) { origin case_input; }
        assert "f3": individual_party_to_988_transaction(entity_ref("urn:test:s988e2:p1"), "fx1") { origin case_input; }
    }
    evaluate truth(personal_currency_gain_excluded_988e2(entity_ref("urn:test:s988e2:p1"), "fx1"));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S988E2-02-ABOVE-TWO-HUNDRED-DOLLARS-NOT-EXCLUDED" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": forward_futures_option_entered_into("fx2") { origin case_input; }
        assert "f1": amount_denominated_in_nonfunctional_currency("fx2") { origin case_input; }
        assert "f2": nonfunctional_currency_disposition_gain(entity_ref("urn:test:s988e2:p2"), "fx2", 201 USD) { origin case_input; }
        assert "f3": individual_party_to_988_transaction(entity_ref("urn:test:s988e2:p2"), "fx2") { origin case_input; }
    }
    evaluate truth(personal_currency_gain_excluded_988e2(entity_ref("urn:test:s988e2:p2"), "fx2"));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
