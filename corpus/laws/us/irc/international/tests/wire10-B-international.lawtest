// International WIRE-10 group B scenarios. NOT EXECUTED (implemented_unverified); no legal review.

language "law.core" version "0.2";
package us.irc.international version "0.1.1";
namespace "urn:us:irc:international:clir";

test "W10B-INT-01-SECTION-59A-TAX-DERIVES-THE-SECTION-55-STUB" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": applicable_taxpayer_59a(entity_ref("urn:test:w10b:i1#c"), entity_ref("urn:test:w10b:i1#y")) { origin case_input; }
        assert "f1": base_erosion_minimum_tax_amount(entity_ref("urn:test:w10b:i1#c"), entity_ref("urn:test:w10b:i1#y"), 700.00 USD) { origin case_input; }
    }
    evaluate truth(us.irc.income_individual::section_59a_tax(entity_ref("urn:test:w10b:i1#c"), entity_ref("urn:test:w10b:i1#y"), 700.00 USD));
    expect truth_status == TRUE_ONLY;
}
