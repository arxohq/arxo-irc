language "law.core" version "0.2";
package us.irc.international version "0.1.1";
namespace "urn:us:irc:international:clir";

test "S951-01-PRO-RATA-SHARE-FULL-YEAR-NO-OTHER-DIVIDENDS" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": subpart_f_income_of_cfc(entity_ref("urn:test:s951:c1#corp"), entity_ref("urn:test:s951:c1#y"), 100000 USD) { origin case_input; }
        assert "f1": cfc_status_fraction_of_year(entity_ref("urn:test:s951:c1#corp"), entity_ref("urn:test:s951:c1#y"), 1.0) { origin case_input; }
        assert "f2": controlled_foreign_corporation(entity_ref("urn:test:s951:c1#corp"), entity_ref("urn:test:s951:c1#y")) { origin case_input; }
        assert "f3": us_shareholder_owns_stock_on_last_cfc_day(entity_ref("urn:test:s951:c1#shareholder"), entity_ref("urn:test:s951:c1#corp"), entity_ref("urn:test:s951:c1#y")) { origin case_input; }
        assert "f4": shareholder_stock_ownership_share_958a(entity_ref("urn:test:s951:c1#shareholder"), entity_ref("urn:test:s951:c1#corp"), entity_ref("urn:test:s951:c1#y"), 1.0) { origin case_input; }
    }
    evaluate truth(subpart_f_inclusion(entity_ref("urn:test:s951:c1#shareholder"), entity_ref("urn:test:s951:c1#corp"), entity_ref("urn:test:s951:c1#y"), 100000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

