        assert "f0": premiums_earned_on_property_casualty_health_contracts_954i2B(entity_ref("urn:test:s954i2b01assetlimitoneth272#c"), entity_ref("urn:test:s954i2b01assetlimitoneth272#y"), 900 USD) { origin case_input; }
        assert "f1": reserves_on_life_insurance_or_annuity_contracts_954i2A(entity_ref("urn:test:s954i2b01assetlimitoneth272#c"), entity_ref("urn:test:s954i2b01assetlimitoneth272#y"), 1000 USD) { origin case_input; }
    }
    evaluate truth(asset_amount_limit_954i2B(entity_ref("urn:test:s954i2b01assetlimitoneth272#c"), entity_ref("urn:test:s954i2b01assetlimitoneth272#y"), 400.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

