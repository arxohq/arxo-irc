// §884(a)-(d),(f) scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.international version "0.1.1";
namespace "urn:us:irc:international:clir";

test "S884A-01-THIRTY-PERCENT-TAX-ON-DIVIDEND-EQUIVALENT-AMOUNT" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": ecep_before_exceptions(entity_ref("urn:test:s884:corp1"), entity_ref("urn:test:s884:y1"), 100000 USD) { origin case_input; }
        assert "f1": ecep_884d2_excepted_income(entity_ref("urn:test:s884:corp1"), entity_ref("urn:test:s884:y1"), 0 USD) { origin case_input; }
        assert "f2": us_net_equity_preceding_year(entity_ref("urn:test:s884:corp1"), entity_ref("urn:test:s884:y1"), 20000 USD) { origin case_input; }
        assert "f3": us_assets(entity_ref("urn:test:s884:corp1"), entity_ref("urn:test:s884:y1"), 20000 USD) { origin case_input; }
        assert "f4": us_liabilities(entity_ref("urn:test:s884:corp1"), entity_ref("urn:test:s884:y1"), 0 USD) { origin case_input; }
    }
    // ECEP = 100000; net equity now = 20000 = prior 20000 -> no change ->
    // dividend equivalent amount = ECEP = 100000; tax = 30% = 30000.
    evaluate truth(branch_profits_tax(entity_ref("urn:test:s884:corp1"), entity_ref("urn:test:s884:y1"), 30000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S884B-01-REDUCTION-FOR-INCREASE-IN-NET-EQUITY-FLOORED-AT-ZERO" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": ecep_before_exceptions(entity_ref("urn:test:s884b:corp1"), entity_ref("urn:test:s884b:y1"), 10000 USD) { origin case_input; }
        assert "f1": ecep_884d2_excepted_income(entity_ref("urn:test:s884b:corp1"), entity_ref("urn:test:s884b:y1"), 0 USD) { origin case_input; }
        assert "f2": us_assets(entity_ref("urn:test:s884b:corp1"), entity_ref("urn:test:s884b:y1"), 50000 USD) { origin case_input; }
        assert "f3": us_liabilities(entity_ref("urn:test:s884b:corp1"), entity_ref("urn:test:s884b:y1"), 0 USD) { origin case_input; }
        assert "f4": us_net_equity_preceding_year(entity_ref("urn:test:s884b:corp1"), entity_ref("urn:test:s884b:y1"), 20000 USD) { origin case_input; }
    }
    // net equity now = 50000, prior = 20000, increase = 30000 > ECEP 10000
    // -> reduced ECEP floored at 0.
    evaluate truth(dividend_equivalent_amount(entity_ref("urn:test:s884b:corp1"), entity_ref("urn:test:s884b:y1"), 0.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S884B-02-INCREASE-FOR-DECREASE-IN-NET-EQUITY-CAPPED-AT-ACCUMULATED" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": ecep_before_exceptions(entity_ref("urn:test:s884b:corp2"), entity_ref("urn:test:s884b:y2"), 10000 USD) { origin case_input; }
        assert "f1": ecep_884d2_excepted_income(entity_ref("urn:test:s884b:corp2"), entity_ref("urn:test:s884b:y2"), 0 USD) { origin case_input; }
        assert "f2": us_assets(entity_ref("urn:test:s884b:corp2"), entity_ref("urn:test:s884b:y2"), 10000 USD) { origin case_input; }
        assert "f3": us_liabilities(entity_ref("urn:test:s884b:corp2"), entity_ref("urn:test:s884b:y2"), 0 USD) { origin case_input; }
        assert "f4": us_net_equity_preceding_year(entity_ref("urn:test:s884b:corp2"), entity_ref("urn:test:s884b:y2"), 45000 USD) { origin case_input; }
        assert "f5": accumulated_ecep_preceding_year(entity_ref("urn:test:s884b:corp2"), entity_ref("urn:test:s884b:y2"), 8000 USD) { origin case_input; }
    }
    // net equity now = 10000, prior = 45000, decrease = 35000, capped at
    // accumulated ECEP 8000 -> dividend equivalent amount = 10000 + 8000 = 18000.
    evaluate truth(dividend_equivalent_amount(entity_ref("urn:test:s884b:corp2"), entity_ref("urn:test:s884b:y2"), 18000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S884F-01-EXCESS-ALLOCABLE-INTEREST-SUBJECT-TO-881A-TAX" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": allocable_interest_884f(entity_ref("urn:test:s884f:corp1"), entity_ref("urn:test:s884f:y1"), 5000 USD) { origin case_input; }
        assert "f1": interest_paid_by_us_trade_or_business(entity_ref("urn:test:s884f:corp1"), entity_ref("urn:test:s884f:y1"), 3000 USD) { origin case_input; }
    }
    evaluate truth(excess_allocable_interest_884f1b(entity_ref("urn:test:s884f:corp1"), entity_ref("urn:test:s884f:y1"), 2000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
