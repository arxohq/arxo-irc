// §59A(a),(e) scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.international version "0.1.1";
namespace "urn:us:irc:international:clir";

test "S59A-01-APPLICABLE-TAXPAYER-AT-3-PERCENT" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": is_corporation_not_ric_reit_or_s_corp(entity_ref("urn:test:s59a:t1#corp")) { origin case_input; }
        assert "f1": average_annual_gross_receipts_3yr(entity_ref("urn:test:s59a:t1#corp"), entity_ref("urn:test:s59a:t1#y"), 500000000 USD) { origin case_input; }
        assert "f2": base_erosion_percentage(entity_ref("urn:test:s59a:t1#corp"), entity_ref("urn:test:s59a:t1#y"), 0.03) { origin case_input; }
    }
    evaluate truth(applicable_taxpayer_59a(entity_ref("urn:test:s59a:t1#corp"), entity_ref("urn:test:s59a:t1#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S59A-02-BELOW-2-POINT-9-PERCENT-NOT-APPLICABLE" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": is_corporation_not_ric_reit_or_s_corp(entity_ref("urn:test:s59a:t2#corp")) { origin case_input; }
        assert "f1": average_annual_gross_receipts_3yr(entity_ref("urn:test:s59a:t2#corp"), entity_ref("urn:test:s59a:t2#y"), 500000000 USD) { origin case_input; }
        assert "f2": base_erosion_percentage(entity_ref("urn:test:s59a:t2#corp"), entity_ref("urn:test:s59a:t2#y"), 0.029) { origin case_input; }
    }
    evaluate truth(applicable_taxpayer_59a(entity_ref("urn:test:s59a:t2#corp"), entity_ref("urn:test:s59a:t2#y")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

test "S59A-03-BELOW-GROSS-RECEIPTS-THRESHOLD-NOT-APPLICABLE" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": is_corporation_not_ric_reit_or_s_corp(entity_ref("urn:test:s59a:t3#corp")) { origin case_input; }
        assert "f1": average_annual_gross_receipts_3yr(entity_ref("urn:test:s59a:t3#corp"), entity_ref("urn:test:s59a:t3#y"), 499999999 USD) { origin case_input; }
        assert "f2": base_erosion_percentage(entity_ref("urn:test:s59a:t3#corp"), entity_ref("urn:test:s59a:t3#y"), 0.05) { origin case_input; }
    }
    evaluate truth(applicable_taxpayer_59a(entity_ref("urn:test:s59a:t3#corp"), entity_ref("urn:test:s59a:t3#y")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
