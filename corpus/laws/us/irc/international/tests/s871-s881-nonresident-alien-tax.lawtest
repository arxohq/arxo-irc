// §871(a),(h); §881(a) scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.international version "0.1.1";
namespace "urn:us:irc:international:clir";

test "S871-01-FDAP-THIRTY-PERCENT-TAX" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": fdap_item_received(entity_ref("urn:test:s871:f1#r"), 1000 USD, "item1") { origin case_input; }
    }
    evaluate truth(fdap_tax(entity_ref("urn:test:s871:f1#r"), 1000 USD, 300 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S871-02-PORTFOLIO-INTEREST-EXEMPTS-FROM-FDAP-TAX" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": fdap_item_received(entity_ref("urn:test:s871:f2#r"), 1000 USD, "item2") { origin case_input; }
        assert "f1": interest_would_be_taxed_under_871a(entity_ref("urn:test:s871:f2#r"), "item2") { origin case_input; }
        assert "f2": obligation_in_registered_form("item2") { origin case_input; }
        assert "f3": beneficial_owner_non_us_statement_received("item2") { origin case_input; }
    }
    evaluate truth(portfolio_interest(entity_ref("urn:test:s871:f2#r"), "item2"));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(fdap_tax(entity_ref("urn:test:s871:f2#r"), 1000 USD, 300 USD));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

test "S871-03-PORTFOLIO-INTEREST-LOST-FOR-10-PERCENT-SHAREHOLDER" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": interest_would_be_taxed_under_871a(entity_ref("urn:test:s871:f3#r"), "item3") { origin case_input; }
        assert "f1": obligation_in_registered_form("item3") { origin case_input; }
        assert "f2": beneficial_owner_non_us_statement_received("item3") { origin case_input; }
        assert "f3": recipient_is_ten_percent_shareholder(entity_ref("urn:test:s871:f3#r"), "item3") { origin case_input; }
    }
    evaluate truth(portfolio_interest(entity_ref("urn:test:s871:f3#r"), "item3"));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

test "S881-01-FOREIGN-CORP-THIRTY-PERCENT-TAX" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
