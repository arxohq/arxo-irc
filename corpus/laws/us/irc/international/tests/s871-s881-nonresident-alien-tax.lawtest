        assert "f2": us_source_capital_losses(entity_ref("urn:test:s871a2:p2"), entity_ref("urn:test:s871a2:y2"), 4000 USD) { origin case_input; }
    }
    evaluate truth(section_871a2_capital_gains_tax(entity_ref("urn:test:s871a2:p2"), entity_ref("urn:test:s871a2:y2"), 1800 USD));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

