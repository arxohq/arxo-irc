test "S871A2-01-CAPITAL-GAINS-TAX-183-DAYS-QUALIFIES" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": days_present_in_us_during_year(entity_ref("urn:test:s871a2:p1"), entity_ref("urn:test:s871a2:y1"), 183) { origin case_input; }
        assert "f1": us_source_capital_gains(entity_ref("urn:test:s871a2:p1"), entity_ref("urn:test:s871a2:y1"), 10000 USD) { origin case_input; }
        assert "f2": us_source_capital_losses(entity_ref("urn:test:s871a2:p1"), entity_ref("urn:test:s871a2:y1"), 4000 USD) { origin case_input; }
    }
    evaluate truth(section_871a2_capital_gains_tax(entity_ref("urn:test:s871a2:p1"), entity_ref("urn:test:s871a2:y1"), 1800 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

