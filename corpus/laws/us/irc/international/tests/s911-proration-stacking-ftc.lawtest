// §911(b)(2)(B) proration, §911(f) stacking from tables, §911(d)(6) FTC
// allocation, §911(c)(4)(C) carryover — stage 4 (module 54).
// Expected values are hand-computed from the pinned 2025/2026 parameters
// and the pinned TCJA base tables; the engine must derive them.

language "law.core" version "0.2";
package us.irc.international version "0.1.1";
namespace "urn:us:irc:international:clir";

test "S911P-01-PRONATED-EXCLUSION-FULL-YEAR-2025" {
    given {
        context { legal_time @2025-06-01; decision_time @2025-06-01T09:00:00-05:00; knowledge_time @2025-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": citizen_or_resident_of_us(entity_ref("urn:test:s911p:a#ind")) { origin case_input; }
        assert "f0t": tax_home_for_162a2_in_foreign_country_911d3(entity_ref("urn:test:s911p:a#ind"), entity_ref("urn:test:s911p:a#y2025")) { origin case_input; }
        assert "f1": qualified_individual_by_bona_fide_residence(entity_ref("urn:test:s911p:a#ind"), entity_ref("urn:test:s911p:a#y2025")) { origin case_input; }
        assert "f2": foreign_earned_income_amount(entity_ref("urn:test:s911p:a#ind"), entity_ref("urn:test:s911p:a#y2025"), 200000 USD) { origin case_input; }
        assert "f3": qualifying_days_in_taxable_year_911(entity_ref("urn:test:s911p:a#ind"), entity_ref("urn:test:s911p:a#y2025"), 365) { origin case_input; }
        assert "f4": days_in_taxable_year_911(entity_ref("urn:test:s911p:a#y2025"), 365) { origin case_input; }
    }
    // cap = 130000 * 365 / 365 = 130000; exclusion = min(200000, 130000).
    evaluate truth(foreign_earned_income_exclusion_prorated_911(entity_ref("urn:test:s911p:a#ind"), entity_ref("urn:test:s911p:a#y2025"), 130000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S911P-02-PRONATED-EXCLUSION-PARTIAL-YEAR-2025" {
    given {
        context { legal_time @2025-06-01; decision_time @2025-06-01T09:00:00-05:00; knowledge_time @2025-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": citizen_or_resident_of_us(entity_ref("urn:test:s911p:b#ind")) { origin case_input; }
        assert "f0t": tax_home_for_162a2_in_foreign_country_911d3(entity_ref("urn:test:s911p:b#ind"), entity_ref("urn:test:s911p:b#y2025")) { origin case_input; }
        assert "f1": qualified_individual_by_bona_fide_residence(entity_ref("urn:test:s911p:b#ind"), entity_ref("urn:test:s911p:b#y2025")) { origin case_input; }
        assert "f2": foreign_earned_income_amount(entity_ref("urn:test:s911p:b#ind"), entity_ref("urn:test:s911p:b#y2025"), 200000 USD) { origin case_input; }
        assert "f3": qualifying_days_in_taxable_year_911(entity_ref("urn:test:s911p:b#ind"), entity_ref("urn:test:s911p:b#y2025"), 183) { origin case_input; }
        assert "f4": days_in_taxable_year_911(entity_ref("urn:test:s911p:b#y2025"), 365) { origin case_input; }
    }
    // cap = 130000 * 183 / 365 = 65178.08; exclusion = min(200000, 65178.08).
    evaluate truth(foreign_earned_income_exclusion_prorated_911(entity_ref("urn:test:s911p:b#ind"), entity_ref("urn:test:s911p:b#y2025"), 65178.08 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

