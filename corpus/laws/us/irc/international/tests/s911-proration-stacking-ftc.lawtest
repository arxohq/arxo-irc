        assert "f0t": tax_home_for_162a2_in_foreign_country_911d3(entity_ref("urn:test:s911p:h#ind"), entity_ref("urn:test:s911p:h#y2025")) { origin case_input; }
        assert "f1": qualified_individual_by_bona_fide_residence(entity_ref("urn:test:s911p:h#ind"), entity_ref("urn:test:s911p:h#y2025")) { origin case_input; }
        assert "f2": foreign_earned_income_amount(entity_ref("urn:test:s911p:h#ind"), entity_ref("urn:test:s911p:h#y2025"), 200000 USD) { origin case_input; }
        assert "f3": qualifying_days_in_taxable_year_911(entity_ref("urn:test:s911p:h#ind"), entity_ref("urn:test:s911p:h#y2025"), 365) { origin case_input; }
        assert "f4": days_in_taxable_year_911(entity_ref("urn:test:s911p:h#y2025"), 365) { origin case_input; }
        assert "f6": foreign_source_gross_income_911(entity_ref("urn:test:s911p:h#ind"), entity_ref("urn:test:s911p:h#y2025"), 200000 USD) { origin case_input; }
        assert "f7": deductions_allocable_to_foreign_source_911(entity_ref("urn:test:s911p:h#ind"), entity_ref("urn:test:s911p:h#y2025"), 10000 USD) { origin case_input; }
