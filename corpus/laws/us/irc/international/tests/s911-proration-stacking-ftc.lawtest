test "S911P-04-NO-TAX-HOME-NO-EXCLUSION" {
    given {
        context { legal_time @2025-06-01; decision_time @2025-06-01T09:00:00-05:00; knowledge_time @2025-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": citizen_or_resident_of_us(entity_ref("urn:test:s911p:d#ind")) { origin case_input; }
        assert "f1": qualified_individual_by_bona_fide_residence(entity_ref("urn:test:s911p:d#ind"), entity_ref("urn:test:s911p:d#y2025")) { origin case_input; }
        assert "f2": foreign_earned_income_amount(entity_ref("urn:test:s911p:d#ind"), entity_ref("urn:test:s911p:d#y2025"), 200000 USD) { origin case_input; }
    }
    // No tax home: qualified_individual fails, so no exclusion amount follows.
    // Absence of the home fact is incompleteness, not a zero exclusion.
    evaluate truth(foreign_earned_income_exclusion_amount(entity_ref("urn:test:s911p:d#ind"), entity_ref("urn:test:s911p:d#y2025"), 130000 USD));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

test "S911P-05-STACKING-JOINT-FROM-TABLES" {
    given {
        context { legal_time @2025-06-01; decision_time @2025-06-01T09:00:00-05:00; knowledge_time @2025-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": citizen_or_resident_of_us(entity_ref("urn:test:s911p:e#ind")) { origin case_input; }
        assert "f0t": tax_home_for_162a2_in_foreign_country_911d3(entity_ref("urn:test:s911p:e#ind"), entity_ref("urn:test:s911p:e#y2025")) { origin case_input; }
        assert "f1": qualified_individual_by_bona_fide_residence(entity_ref("urn:test:s911p:e#ind"), entity_ref("urn:test:s911p:e#y2025")) { origin case_input; }
        assert "fs": us.irc.income_individual::filing_status(entity_ref("urn:test:s911p:e#ind"), entity_ref("urn:test:s911p:e#y2025"), us.irc.income_individual::Joint) { origin case_input; }
        assert "f2": foreign_earned_income_amount(entity_ref("urn:test:s911p:e#ind"), entity_ref("urn:test:s911p:e#y2025"), 200000 USD) { origin case_input; }
        assert "f3": qualifying_days_in_taxable_year_911(entity_ref("urn:test:s911p:e#ind"), entity_ref("urn:test:s911p:e#y2025"), 365) { origin case_input; }
        assert "f4": days_in_taxable_year_911(entity_ref("urn:test:s911p:e#y2025"), 365) { origin case_input; }
        assert "f5": stacking_taxable_income_including_excluded_911f(entity_ref("urn:test:s911p:e#ind"), entity_ref("urn:test:s911p:e#y2025"), 200000 USD) { origin case_input; }
        assert "f6": excluded_and_disallowed_amounts_911f1(entity_ref("urn:test:s911p:e#ind"), entity_ref("urn:test:s911p:e#y2025"), 130000 USD, 0 USD) { origin case_input; }
        // Applicable TCJA rows read by the case from the pinned sidecar
        // (rate-schedule-tcja-joint, rows bracket-4/bracket-3, anchor
        // IRC_S1_J_2_A_TABLE_1): mode:rules sidecars are not expanded by
        // lower, so the row is a case fact; both taxes stay computed.
        assert "b1": us.irc.income_individual::bracket_tcja_joint(200000 USD, 165000 USD, 28179 USD, 0.24) { origin case_input; }
        assert "b2": us.irc.income_individual::bracket_tcja_joint(130000 USD, 77400 USD, 8907 USD, 0.22) { origin case_input; }
    }
    // tax on 200000 (joint bracket-4): 28179 + 0.24 * 35000 = 36579.
    evaluate truth(stacking_table_tax_including_excluded_911f(entity_ref("urn:test:s911p:e#ind"), entity_ref("urn:test:s911p:e#y2025"), 36579 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S911P-06-STACKING-DIFFERENCE-JOINT" {
    given {
        context { legal_time @2025-06-01; decision_time @2025-06-01T09:00:00-05:00; knowledge_time @2025-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": citizen_or_resident_of_us(entity_ref("urn:test:s911p:f#ind")) { origin case_input; }
        assert "f0t": tax_home_for_162a2_in_foreign_country_911d3(entity_ref("urn:test:s911p:f#ind"), entity_ref("urn:test:s911p:f#y2025")) { origin case_input; }
        assert "f1": qualified_individual_by_bona_fide_residence(entity_ref("urn:test:s911p:f#ind"), entity_ref("urn:test:s911p:f#y2025")) { origin case_input; }
        assert "fs": us.irc.income_individual::filing_status(entity_ref("urn:test:s911p:f#ind"), entity_ref("urn:test:s911p:f#y2025"), us.irc.income_individual::Joint) { origin case_input; }
        assert "f2": foreign_earned_income_amount(entity_ref("urn:test:s911p:f#ind"), entity_ref("urn:test:s911p:f#y2025"), 200000 USD) { origin case_input; }
        assert "f3": qualifying_days_in_taxable_year_911(entity_ref("urn:test:s911p:f#ind"), entity_ref("urn:test:s911p:f#y2025"), 365) { origin case_input; }
        assert "f4": days_in_taxable_year_911(entity_ref("urn:test:s911p:f#y2025"), 365) { origin case_input; }
        assert "f5": stacking_taxable_income_including_excluded_911f(entity_ref("urn:test:s911p:f#ind"), entity_ref("urn:test:s911p:f#y2025"), 200000 USD) { origin case_input; }
        assert "f6": excluded_and_disallowed_amounts_911f1(entity_ref("urn:test:s911p:f#ind"), entity_ref("urn:test:s911p:f#y2025"), 130000 USD, 0 USD) { origin case_input; }
        // Same pinned rows as S911P-05 (bracket-4 at 200000, bracket-3 at 130000).
        assert "b1": us.irc.income_individual::bracket_tcja_joint(200000 USD, 165000 USD, 28179 USD, 0.24) { origin case_input; }
        assert "b2": us.irc.income_individual::bracket_tcja_joint(130000 USD, 77400 USD, 8907 USD, 0.22) { origin case_input; }
    }
    // tax on 130000 alone (joint bracket-3): 8907 + 0.22 * 52600 = 20479.
    // stacking: 36579 - 20479 = 16100. Both table amounts computed, none asserted.
    evaluate truth(section_1_tax_with_exclusion_from_tables_911f(entity_ref("urn:test:s911p:f#ind"), entity_ref("urn:test:s911p:f#y2025"), 16100 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S911P-07-FTC-ALLOCATION-AFTER-EXCLUSION" {
    given {
        context { legal_time @2025-06-01; decision_time @2025-06-01T09:00:00-05:00; knowledge_time @2025-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": citizen_or_resident_of_us(entity_ref("urn:test:s911p:g#ind")) { origin case_input; }
        assert "f0t": tax_home_for_162a2_in_foreign_country_911d3(entity_ref("urn:test:s911p:g#ind"), entity_ref("urn:test:s911p:g#y2025")) { origin case_input; }
        assert "f1": qualified_individual_by_bona_fide_residence(entity_ref("urn:test:s911p:g#ind"), entity_ref("urn:test:s911p:g#y2025")) { origin case_input; }
        assert "f2": foreign_earned_income_amount(entity_ref("urn:test:s911p:g#ind"), entity_ref("urn:test:s911p:g#y2025"), 200000 USD) { origin case_input; }
        assert "f3": qualifying_days_in_taxable_year_911(entity_ref("urn:test:s911p:g#ind"), entity_ref("urn:test:s911p:g#y2025"), 365) { origin case_input; }
        assert "f4": days_in_taxable_year_911(entity_ref("urn:test:s911p:g#y2025"), 365) { origin case_input; }
        assert "f5": foreign_tax_paid_total_911(entity_ref("urn:test:s911p:g#ind"), entity_ref("urn:test:s911p:g#y2025"), 28000 USD) { origin case_input; }
        assert "f6": foreign_source_gross_income_911(entity_ref("urn:test:s911p:g#ind"), entity_ref("urn:test:s911p:g#y2025"), 200000 USD) { origin case_input; }
        assert "f7": deductions_allocable_to_foreign_source_911(entity_ref("urn:test:s911p:g#ind"), entity_ref("urn:test:s911p:g#y2025"), 10000 USD) { origin case_input; }
    }
    // allocable = 28000 * 130000 / 200000 = 18200; creditable = 9800.
    evaluate truth(creditable_foreign_tax_after_911_exclusion(entity_ref("urn:test:s911p:g#ind"), entity_ref("urn:test:s911p:g#y2025"), 9800 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S911P-08-FOREIGN-SOURCE-TAXABLE-NET-OF-EXCLUSION" {
    given {
        context { legal_time @2025-06-01; decision_time @2025-06-01T09:00:00-05:00; knowledge_time @2025-06-01T09:00:00-05:00; timezone "America/New_York"; }
