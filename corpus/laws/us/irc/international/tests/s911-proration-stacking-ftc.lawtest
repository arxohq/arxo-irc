}

test "S911P-09-HOUSING-CARRYOVER-TO-SUCCEEDING-YEAR" {
    given {
        context { legal_time @2025-06-01; decision_time @2025-06-01T09:00:00-05:00; knowledge_time @2025-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": citizen_or_resident_of_us(entity_ref("urn:test:s911p:i#ind")) { origin case_input; }
        assert "f0t": tax_home_for_162a2_in_foreign_country_911d3(entity_ref("urn:test:s911p:i#ind"), entity_ref("urn:test:s911p:i#y2025")) { origin case_input; }
        assert "f1": qualified_individual_by_bona_fide_residence(entity_ref("urn:test:s911p:i#ind"), entity_ref("urn:test:s911p:i#y2025")) { origin case_input; }
        assert "f2": foreign_earned_income_amount(entity_ref("urn:test:s911p:i#ind"), entity_ref("urn:test:s911p:i#y2025"), 200000 USD) { origin case_input; }
        assert "f3": housing_cost_amount_not_employer_provided(entity_ref("urn:test:s911p:i#ind"), entity_ref("urn:test:s911p:i#y2025"), 90000 USD) { origin case_input; }
    }
    // limitation = 200000 - 130000 = 70000; disallowed carry = 90000 - 70000 = 20000.
    evaluate truth(housing_carryover_disallowed_911c4(entity_ref("urn:test:s911p:i#ind"), entity_ref("urn:test:s911p:i#y2025"), 20000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S911P-10-NO-DAYS-NO-PRORATED-CAP" {
    given {
        context { legal_time @2025-06-01; decision_time @2025-06-01T09:00:00-05:00; knowledge_time @2025-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": citizen_or_resident_of_us(entity_ref("urn:test:s911p:j#ind")) { origin case_input; }
        assert "f0t": tax_home_for_162a2_in_foreign_country_911d3(entity_ref("urn:test:s911p:j#ind"), entity_ref("urn:test:s911p:j#y2025")) { origin case_input; }
        assert "f1": qualified_individual_by_bona_fide_residence(entity_ref("urn:test:s911p:j#ind"), entity_ref("urn:test:s911p:j#y2025")) { origin case_input; }
        assert "f2": foreign_earned_income_amount(entity_ref("urn:test:s911p:j#ind"), entity_ref("urn:test:s911p:j#y2025"), 200000 USD) { origin case_input; }
        assert "f4": days_in_taxable_year_911(entity_ref("urn:test:s911p:j#y2025"), 365) { origin case_input; }
    }
    // Missing qualifying-day count: no prorated cap follows — incompleteness,
    // not a zero cap.
    evaluate truth(prorated_annual_exclusion_cap_911(entity_ref("urn:test:s911p:j#ind"), entity_ref("urn:test:s911p:j#y2025"), 0 USD));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
