        assert "f1": quash_proceeding_begun_982c2(entity_ref("urn:test:s982c2a03proceedingbeg70#t"),"req1",@2025-04-02) { origin case_input; }
    }
    evaluate positions();
    expect position(S982C2AProceedingToQuash, INVALIDLY_EXERCISED);
}

