}

test "S956A-01-AMOUNT-IS-LESSER-OF-EXCESS-AND-APPLICABLE-EARNINGS" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": shareholder_pro_rata_avg_us_property_956(entity_ref("urn:test:s956a:sh1"), entity_ref("urn:test:s956a:corp1"), entity_ref("urn:test:s956a:y1"), 100000 USD) { origin case_input; }
        assert "f1": shareholder_959c1a_earnings_and_profits(entity_ref("urn:test:s956a:sh1"), entity_ref("urn:test:s956a:corp1"), entity_ref("urn:test:s956a:y1"), 20000 USD) { origin case_input; }
        assert "f2": applicable_earnings_956(entity_ref("urn:test:s956a:corp1"), entity_ref("urn:test:s956a:y1"), 50000 USD) { origin case_input; }
        assert "f3": shareholder_stock_ownership_share_958a_956(entity_ref("urn:test:s956a:sh1"), entity_ref("urn:test:s956a:corp1"), entity_ref("urn:test:s956a:y1"), 1.00) { origin case_input; }
    }
    // excess = 100000 - 20000 = 80000; applicable earnings share = 50000 * 1.00 = 50000;
    // amount = min(80000, 50000) = 50000.
    evaluate truth(section_956_amount(entity_ref("urn:test:s956a:sh1"), entity_ref("urn:test:s956a:corp1"), entity_ref("urn:test:s956a:y1"), 50000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S956A-02-EXCESS-FLOORED-AT-ZERO-WHEN-PTEP-EXCEEDS-PROPERTY" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": shareholder_pro_rata_avg_us_property_956(entity_ref("urn:test:s956a:sh2"), entity_ref("urn:test:s956a:corp2"), entity_ref("urn:test:s956a:y2"), 10000 USD) { origin case_input; }
        assert "f1": shareholder_959c1a_earnings_and_profits(entity_ref("urn:test:s956a:sh2"), entity_ref("urn:test:s956a:corp2"), entity_ref("urn:test:s956a:y2"), 30000 USD) { origin case_input; }
    }
    evaluate truth(section_956a1_excess(entity_ref("urn:test:s956a:sh2"), entity_ref("urn:test:s956a:corp2"), entity_ref("urn:test:s956a:y2"), 0.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

