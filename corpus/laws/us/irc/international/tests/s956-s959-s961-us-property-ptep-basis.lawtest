test "S961A-01-BASIS-INCREASE-EQUALS-INCLUSION-NO-962-ELECTION" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": controlled_foreign_corporation(entity_ref("urn:test:s961a:corp1"), entity_ref("urn:test:s961a:y1")) { origin case_input; }
        assert "f1": us_shareholder_owns_stock_on_last_cfc_day(entity_ref("urn:test:s961a:sh1"), entity_ref("urn:test:s961a:corp1"), entity_ref("urn:test:s961a:y1")) { origin case_input; }
        assert "f2": pro_rata_share_of_subpart_f_income(entity_ref("urn:test:s961a:sh1"), entity_ref("urn:test:s961a:corp1"), entity_ref("urn:test:s961a:y1"), 25000 USD) { origin case_input; }
    }
    evaluate truth(basis_increase_961a(entity_ref("urn:test:s961a:sh1"), entity_ref("urn:test:s961a:corp1"), entity_ref("urn:test:s961a:y1"), 25000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S961A-02-BASIS-INCREASE-CAPPED-AT-TAX-PAID-WITH-962-ELECTION" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": controlled_foreign_corporation(entity_ref("urn:test:s961a:corp2"), entity_ref("urn:test:s961a:y2")) { origin case_input; }
        assert "f1": us_shareholder_owns_stock_on_last_cfc_day(entity_ref("urn:test:s961a:sh2"), entity_ref("urn:test:s961a:corp2"), entity_ref("urn:test:s961a:y2")) { origin case_input; }
        assert "f2": pro_rata_share_of_subpart_f_income(entity_ref("urn:test:s961a:sh2"), entity_ref("urn:test:s961a:corp2"), entity_ref("urn:test:s961a:y2"), 25000 USD) { origin case_input; }
        assert "f3": elects_962(entity_ref("urn:test:s961a:sh2"), entity_ref("urn:test:s961a:y2")) { origin case_input; }
        assert "f4": tax_paid_on_951a_inclusion_962(entity_ref("urn:test:s961a:sh2"), entity_ref("urn:test:s961a:y2"), 5250 USD) { origin case_input; }
    }
    evaluate truth(basis_increase_961a(entity_ref("urn:test:s961a:sh2"), entity_ref("urn:test:s961a:corp2"), entity_ref("urn:test:s961a:y2"), 5250 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S961B-01-EXCESS-OVER-BASIS-TREATED-AS-GAIN" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": distribution_received_from_cfc(entity_ref("urn:test:s961b:sh1"), entity_ref("urn:test:s961b:corp1"), entity_ref("urn:test:s961b:y1"), 12000 USD) { origin case_input; }
        assert "f1": ptep_balance_959c1a(entity_ref("urn:test:s961b:sh1"), entity_ref("urn:test:s961b:corp1"), entity_ref("urn:test:s961b:y1"), 12000 USD) { origin case_input; }
        assert "f2": stock_basis_before_961b_reduction(entity_ref("urn:test:s961b:sh1"), entity_ref("urn:test:s961b:corp1"), entity_ref("urn:test:s961b:y1"), 9000 USD) { origin case_input; }
    }
    // excluded = min(12000, 12000) = 12000; excluded (12000) > basis (9000);
    // excess treated as gain = 12000 - 9000 = 3000.
    evaluate truth(excess_961b2_treated_as_gain(entity_ref("urn:test:s961b:sh1"), entity_ref("urn:test:s961b:corp1"), entity_ref("urn:test:s961b:y1"), 3000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
