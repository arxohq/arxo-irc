// §956(a),(c),(d); §959(a),(d); §961(a),(b) scenarios. NOT EXECUTED
// (implemented_unverified).

language "law.core" version "0.2";
package us.irc.international version "0.1.1";
namespace "urn:us:irc:international:clir";

test "S956C-01-TANGIBLE-PROPERTY-IN-US-IS-US-PROPERTY" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": tangible_property_located_in_us_956("plant-1") { origin case_input; }
    }
    evaluate truth(us_property_956("plant-1"));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S956C-02-EXCEPTED-PROPERTY-IS-NOT-US-PROPERTY" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": obligation_of_united_states_person_956("bank-deposit-1") { origin case_input; }
        assert "f1": us_property_956_excepted("bank-deposit-1") { origin case_input; }
    }
    evaluate truth(us_property_956("bank-deposit-1"));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

test "S956D-01-PLEDGE-TREATED-AS-HOLDING-OBLIGATION" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
