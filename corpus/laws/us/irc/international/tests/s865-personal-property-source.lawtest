    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": us.irc.definitions::citizen_of_united_states(entity_ref("urn:test:s865g:p1#seller")) { origin case_input; }
        assert "f1": tax_home_in_foreign_country_865(entity_ref("urn:test:s865g:p1#seller")) { origin case_input; }
