// §865(a)-(g) scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.international version "0.1.1";
namespace "urn:us:irc:international:clir";

test "S865-01-US-RESIDENT-GENERAL-RULE-US-SOURCE" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": us.irc.definitions::citizen_of_united_states(entity_ref("urn:test:s865:p1#seller")) { origin case_input; }
        assert "f2": personal_property_sale_gain(entity_ref("urn:test:s865:p1#seller"), entity_ref("urn:test:s865:p1#buyer"), "widget", 1000 USD) { origin case_input; }
    }
    evaluate truth(us_source_personal_property_gain(entity_ref("urn:test:s865:p1#seller"), entity_ref("urn:test:s865:p1#buyer"), "widget", 1000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S865-02-DOMESTIC-CORPORATION-IS-A-US-RESIDENT-865G1AII" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": us.irc.definitions::united_states_person(entity_ref("urn:test:s865:p2#seller")) { origin case_input; }
    }
    evaluate truth(us_resident_865(entity_ref("urn:test:s865:p2#seller")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S865B-01-INVENTORY-EXCLUDED-FROM-GENERAL-RULE" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": us.irc.definitions::citizen_of_united_states(entity_ref("urn:test:s865b:p1#seller")) { origin case_input; }
        assert "f2": personal_property_sale_gain(entity_ref("urn:test:s865b:p1#seller"), entity_ref("urn:test:s865b:p1#buyer"), "inv-widget", 1000 USD) { origin case_input; }
        assert "f3": inventory_property_865("inv-widget") { origin case_input; }
    }
    // (a) does not fire because the property is inventory (unless clause) —
    // the general rule is silent; the actual source rule is the PENDING
    // 861(a)(6)/862(a)(6)/863 chain, not modeled.
    evaluate truth(us_source_personal_property_gain(entity_ref("urn:test:s865b:p1#seller"), entity_ref("urn:test:s865b:p1#buyer"), "inv-widget", 1000 USD));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

test "S865B-02-UNPROCESSED-SOFTWOOD-TIMBER-ALWAYS-US-SOURCE" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": personal_property_sale_gain(entity_ref("urn:test:s865b:p2#seller"), entity_ref("urn:test:s865b:p2#buyer"), "timber-log", 500 USD) { origin case_input; }
        assert "f1": inventory_property_865("timber-log") { origin case_input; }
        assert "f2": unprocessed_softwood_timber_cut_in_us("timber-log") { origin case_input; }
    }
    evaluate truth(us_source_personal_property_gain(entity_ref("urn:test:s865b:p2#seller"), entity_ref("urn:test:s865b:p2#buyer"), "timber-log", 500 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S865C-01-DEPRECIABLE-PROPERTY-APPORTIONED" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": personal_property_sale_gain(entity_ref("urn:test:s865c:p1#seller"), entity_ref("urn:test:s865c:p1#buyer"), "machine", 1000 USD) { origin case_input; }
        assert "f1": depreciable_personal_property_865("machine") { origin case_input; }
        assert "f2": us_depreciation_adjustments("machine", 600 USD) { origin case_input; }
        assert "f3": total_depreciation_adjustments("machine", 1000 USD) { origin case_input; }
    }
    // ratio 600/1000 = 0.6; gain (1000) <= total depreciation (1000);
    // US-source portion = min(1000, 1000 * 0.6) = 600.
    evaluate truth(us_source_depreciable_property_gain(entity_ref("urn:test:s865c:p1#seller"), entity_ref("urn:test:s865c:p1#buyer"), "machine", 600 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S865D-01-CONTINGENT-INTANGIBLE-PAYMENT-SOURCED-AS-ROYALTY" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": personal_property_sale_gain(entity_ref("urn:test:s865d:p1#seller"), entity_ref("urn:test:s865d:p1#buyer"), "patent-x", 2000 USD) { origin case_input; }
        assert "f1": intangible_property_865("patent-x") { origin case_input; }
        assert "f2": intangible_payment_contingent_on_productivity_or_use(entity_ref("urn:test:s865d:p1#seller"), entity_ref("urn:test:s865d:p1#buyer"), "patent-x", 2000 USD) { origin case_input; }
    }
    evaluate truth(us_source_rental_or_royalty(entity_ref("urn:test:s865d:p1#buyer"), entity_ref("urn:test:s865d:p1#seller"), 2000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S865E-01-US-RESIDENT-FOREIGN-OFFICE-OVERRIDE-WITH-TEN-PERCENT-TAX" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": us.irc.definitions::citizen_of_united_states(entity_ref("urn:test:s865e:p1#seller")) { origin case_input; }
        assert "f2": personal_property_sale_gain(entity_ref("urn:test:s865e:p1#seller"), entity_ref("urn:test:s865e:p1#buyer"), "gadget", 3000 USD) { origin case_input; }
        assert "f3": sale_attributable_to_foreign_office_865(entity_ref("urn:test:s865e:p1#seller"), entity_ref("urn:test:s865e:p1#buyer"), "gadget", 3000 USD) { origin case_input; }
        assert "f4": foreign_tax_paid_on_sale_at_least_ten_percent(entity_ref("urn:test:s865e:p1#seller"), "gadget") { origin case_input; }
    }
    evaluate truth(foreign_source_personal_property_gain(entity_ref("urn:test:s865e:p1#seller"), entity_ref("urn:test:s865e:p1#buyer"), "gadget", 3000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S865F-01-STOCK-OF-AFFILIATES-EXCEPTION-ABOVE-FIFTY-PERCENT" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": us.irc.definitions::citizen_of_united_states(entity_ref("urn:test:s865f:p1#seller")) { origin case_input; }
        assert "f2": personal_property_sale_gain(entity_ref("urn:test:s865f:p1#seller"), entity_ref("urn:test:s865f:p1#buyer"), "affiliate-stock", 5000 USD) { origin case_input; }
        assert "f3": stock_of_affiliate_sale_865(entity_ref("urn:test:s865f:p1#seller"), "affiliate-stock") { origin case_input; }
        assert "f4": affiliate_active_trade_or_business_country_matches_sale(entity_ref("urn:test:s865f:p1#seller"), "affiliate-stock") { origin case_input; }
        assert "f5": affiliate_active_business_gross_income_ratio("affiliate-stock", 0.60) { origin case_input; }
    }
    evaluate truth(foreign_source_personal_property_gain(entity_ref("urn:test:s865f:p1#seller"), entity_ref("urn:test:s865f:p1#buyer"), "affiliate-stock", 5000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S865F-02-STOCK-OF-AFFILIATES-EXACTLY-FIFTY-PERCENT-FAILS" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": us.irc.definitions::citizen_of_united_states(entity_ref("urn:test:s865f:p2#seller")) { origin case_input; }
        assert "f2": personal_property_sale_gain(entity_ref("urn:test:s865f:p2#seller"), entity_ref("urn:test:s865f:p2#buyer"), "affiliate-stock-2", 5000 USD) { origin case_input; }
        assert "f3": stock_of_affiliate_sale_865(entity_ref("urn:test:s865f:p2#seller"), "affiliate-stock-2") { origin case_input; }
        assert "f4": affiliate_active_trade_or_business_country_matches_sale(entity_ref("urn:test:s865f:p2#seller"), "affiliate-stock-2") { origin case_input; }
        assert "f5": affiliate_active_business_gross_income_ratio("affiliate-stock-2", 0.50) { origin case_input; }
    }
    // exactly 50% does NOT satisfy "more than 50 percent" — falls back to
    // the (a) general rule, US resident -> US source.
    evaluate truth(us_source_personal_property_gain(entity_ref("urn:test:s865f:p2#seller"), entity_ref("urn:test:s865f:p2#buyer"), "affiliate-stock-2", 5000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

