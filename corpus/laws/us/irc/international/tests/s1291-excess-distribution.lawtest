// §1291(a),(c) scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.international version "0.1.1";
namespace "urn:us:irc:international:clir";

test "S1291-01-TOTAL-EXCESS-DISTRIBUTION-OVER-125-PERCENT-AVERAGE" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": distributions_received_this_year(entity_ref("urn:test:s1291:t1#taxpayer"), entity_ref("urn:test:s1291:t1#pfic"), entity_ref("urn:test:s1291:t1#y"), 200000 USD) { origin case_input; }
        assert "f1": average_distributions_3_preceding_years(entity_ref("urn:test:s1291:t1#taxpayer"), entity_ref("urn:test:s1291:t1#pfic"), entity_ref("urn:test:s1291:t1#y"), 100000 USD) { origin case_input; }
    }
    // total excess = 200,000 - (125% * 100,000) = 75,000.
    evaluate truth(total_excess_distribution(entity_ref("urn:test:s1291:t1#taxpayer"), entity_ref("urn:test:s1291:t1#pfic"), entity_ref("urn:test:s1291:t1#y"), 75000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1291-02-FIRST-YEAR-OF-HOLDING-PERIOD-IS-ZERO" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": distributions_received_this_year(entity_ref("urn:test:s1291:t2#taxpayer"), entity_ref("urn:test:s1291:t2#pfic"), entity_ref("urn:test:s1291:t2#y"), 200000 USD) { origin case_input; }
        assert "f1": first_year_of_holding_period(entity_ref("urn:test:s1291:t2#taxpayer"), entity_ref("urn:test:s1291:t2#pfic"), entity_ref("urn:test:s1291:t2#y")) { origin case_input; }
    }
    evaluate truth(total_excess_distribution(entity_ref("urn:test:s1291:t2#taxpayer"), entity_ref("urn:test:s1291:t2#pfic"), entity_ref("urn:test:s1291:t2#y"), 0.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1291-03-DEFERRED-TAX-AMOUNT-AND-TAX-INCREASE" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": receives_excess_distribution(entity_ref("urn:test:s1291:t3#taxpayer"), entity_ref("urn:test:s1291:t3#pfic"), entity_ref("urn:test:s1291:t3#y"), 75000 USD) { origin case_input; }
        assert "f1": aggregate_increases_in_taxes(entity_ref("urn:test:s1291:t3#taxpayer"), entity_ref("urn:test:s1291:t3#pfic"), entity_ref("urn:test:s1291:t3#y"), 15000 USD) { origin case_input; }
        assert "f2": aggregate_interest_on_increases(entity_ref("urn:test:s1291:t3#taxpayer"), entity_ref("urn:test:s1291:t3#pfic"), entity_ref("urn:test:s1291:t3#y"), 3000 USD) { origin case_input; }
    }
    evaluate truth(deferred_tax_amount(entity_ref("urn:test:s1291:t3#taxpayer"), entity_ref("urn:test:s1291:t3#pfic"), entity_ref("urn:test:s1291:t3#y"), 18000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(section_1291_tax_increase(entity_ref("urn:test:s1291:t3#taxpayer"), entity_ref("urn:test:s1291:t3#pfic"), entity_ref("urn:test:s1291:t3#y"), 18000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1291-04-UNKNOWN-DISTRIBUTION-AMOUNT-IS-UNDETERMINED" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
    }
    evaluate truth(total_excess_distribution(entity_ref("urn:test:s1291:t4#taxpayer"), entity_ref("urn:test:s1291:t4#pfic"), entity_ref("urn:test:s1291:t4#y"), 0.00 USD));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
