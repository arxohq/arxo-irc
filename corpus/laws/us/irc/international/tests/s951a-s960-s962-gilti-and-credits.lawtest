// §951A(a)-(c); §960(a),(d); §962 scenarios. NOT EXECUTED
// (implemented_unverified).

language "law.core" version "0.2";
package us.irc.international version "0.1.1";
namespace "urn:us:irc:international:clir";

test "S951A-01-GILTI-INCLUSION-EDITION-2025-WITH-NDTIR" {
    given {
        context { legal_time @2025-06-01; decision_time @2025-06-01T09:00:00-05:00; knowledge_time @2025-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": us.irc.core::year_of(entity_ref("urn:test:s951a:g1#corp"), entity_ref("urn:test:s951a:g1#y")) { origin case_input; }
        assert "f1": us.irc.core::begins(entity_ref("urn:test:s951a:g1#y"), @2025-01-01) { origin case_input; }
        assert "f2": shareholder_pro_rata_share_of_tested_income(entity_ref("urn:test:s951a:g1#sh"), entity_ref("urn:test:s951a:g1#corp"), entity_ref("urn:test:s951a:g1#y"), 500000 USD) { origin case_input; }
        assert "f3": shareholder_pro_rata_share_of_qbai(entity_ref("urn:test:s951a:g1#sh"), entity_ref("urn:test:s951a:g1#corp"), entity_ref("urn:test:s951a:g1#y"), 1000000 USD) { origin case_input; }
        assert "f4": ndtir_interest_expense(entity_ref("urn:test:s951a:g1#sh"), entity_ref("urn:test:s951a:g1#y"), 0 USD) { origin case_input; }
    }
    // net_cfc_tested_income = 500,000; NDTIR = 10% * 1,000,000 - 0 = 100,000; GILTI = 400,000.
    evaluate truth(gilti_inclusion(entity_ref("urn:test:s951a:g1#sh"), entity_ref("urn:test:s951a:g1#y"), 400000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S951A-02-GILTI-INCLUSION-EDITION-2026-NO-NDTIR" {
    given {
        context { legal_time @2026-06-01; decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": us.irc.core::year_of(entity_ref("urn:test:s951a:g2#corp"), entity_ref("urn:test:s951a:g2#y")) { origin case_input; }
        assert "f1": us.irc.core::begins(entity_ref("urn:test:s951a:g2#y"), @2026-01-01) { origin case_input; }
        assert "f2": shareholder_pro_rata_share_of_tested_income(entity_ref("urn:test:s951a:g2#sh"), entity_ref("urn:test:s951a:g2#corp"), entity_ref("urn:test:s951a:g2#y"), 500000 USD) { origin case_input; }
    }
    // post-PL119-21 edition: no NDTIR subtraction; inclusion == net CFC tested income.
    evaluate truth(gilti_inclusion(entity_ref("urn:test:s951a:g2#sh"), entity_ref("urn:test:s951a:g2#y"), 500000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S960D-01-DEEMED-PAID-CREDIT-80-PERCENT-PRE-2026" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": us.irc.core::year_of(entity_ref("urn:test:s960d:c1#corp"), entity_ref("urn:test:s960d:c1#y")) { origin case_input; }
        assert "f1": us.irc.core::begins(entity_ref("urn:test:s960d:c1#y"), @2024-01-01) { origin case_input; }
        assert "f2": inclusion_percentage_960d(entity_ref("urn:test:s960d:c1#domestic"), entity_ref("urn:test:s960d:c1#y"), 1.0) { origin case_input; }
        assert "f3": aggregate_tested_foreign_income_taxes(entity_ref("urn:test:s960d:c1#domestic"), entity_ref("urn:test:s960d:c1#y"), 1000 USD) { origin case_input; }
    }
    evaluate truth(deemed_paid_credit_960d(entity_ref("urn:test:s960d:c1#domestic"), entity_ref("urn:test:s960d:c1#y"), 800 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S960D-02-DEEMED-PAID-CREDIT-90-PERCENT-POST-2026" {
    given {
        context { legal_time @2026-06-01; decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": us.irc.core::year_of(entity_ref("urn:test:s960d:c2#corp"), entity_ref("urn:test:s960d:c2#y")) { origin case_input; }
