    expect evaluation_status == COMPUTED;
}

test "S962-01-ELECTION-VALID" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": elects_962(entity_ref("urn:test:s962:e1#ind"), entity_ref("urn:test:s962:e1#y")) { origin case_input; }
    }
    evaluate truth(section_962_election_effective(entity_ref("urn:test:s962:e1#ind"), entity_ref("urn:test:s962:e1#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S962-02-ELECTION-INVALID-UNILATERAL-REVOCATION" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": elects_962(entity_ref("urn:test:s962:e2#ind"), entity_ref("urn:test:s962:e2#y")) { origin case_input; }
        assert "f1": revoked_962_without_secretary_consent(entity_ref("urn:test:s962:e2#ind"), entity_ref("urn:test:s962:e2#y")) { origin case_input; }
    }
    evaluate truth(section_962_election_effective(entity_ref("urn:test:s962:e2#ind"), entity_ref("urn:test:s962:e2#y")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
