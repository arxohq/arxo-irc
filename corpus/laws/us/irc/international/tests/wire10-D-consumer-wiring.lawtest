// International WIRE-10 group D consumer-wiring scenarios. NOT EXECUTED (implemented_unverified); no legal review.

language "law.core" version "0.2";
package us.irc.international version "0.1.1";
namespace "urn:us:irc:international:clir";

test "W10-D-INT-01-HIGHEST-INDIVIDUAL-RATE-FROM-INCOME-INDIVIDUAL" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.core::begins(entity_ref("urn:test:w10dint:i1#y"), @2024-01-01) { origin case_input; }
    }
    evaluate truth(highest_individual_rate(entity_ref("urn:test:w10dint:i1#y"), 0.37));
    expect truth_status == TRUE_ONLY;
}

test "W10-D-INT-02-SECTION-1446B-WITHHOLDING-USES-THE-DERIVED-RATE" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": partnership_has_eci_allocable_to_foreign_partner(entity_ref("urn:test:w10dint:i2#ps"), entity_ref("urn:test:w10dint:i2#fp"), entity_ref("urn:test:w10dint:i2#y")) { origin case_input; }
        assert "f1": eci_taxable_income_allocable_to_foreign_partner(entity_ref("urn:test:w10dint:i2#ps"), entity_ref("urn:test:w10dint:i2#fp"), entity_ref("urn:test:w10dint:i2#y"), 50000 USD) { origin case_input; }
        assert "f2": us.irc.core::begins(entity_ref("urn:test:w10dint:i2#y"), @2024-01-01) { origin case_input; }
    }
    evaluate truth(section_1446_withholding_tax(entity_ref("urn:test:w10dint:i2#ps"), entity_ref("urn:test:w10dint:i2#fp"), entity_ref("urn:test:w10dint:i2#y"), 18500 USD));
    expect truth_status == TRUE_ONLY;
}

test "W10-D-INT-03-NO-DERIVED-RATE-FOR-A-YEAR-BEFORE-2018" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.core::begins(entity_ref("urn:test:w10dint:i3#y"), @2016-01-01) { origin case_input; }
    }
    evaluate truth(highest_individual_rate(entity_ref("urn:test:w10dint:i3#y"), 0.37));
    expect truth_status == FALSE_ONLY;
}
