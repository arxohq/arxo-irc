        context { legal_time @2025-06-01; decision_time @2025-06-01T09:00:00-05:00; knowledge_time @2025-06-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": property_held_on_first_residence_877ah2(entity_ref("urn:test:s877ah201basisnotlesstha987#a"), "pr1", 300 USD, 1000 USD) { origin case_input; }
    }
    evaluate truth(basis_for_877a_tax_877ah2(entity_ref("urn:test:s877ah201basisnotlesstha987#a"), "pr1", 1000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S877AH2-02-ELECTION-KEEPS-ADJUSTED-BASIS" {
    given {
        context { legal_time @2025-06-01; decision_time @2025-06-01T09:00:00-05:00; knowledge_time @2025-06-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": property_held_on_first_residence_877ah2(entity_ref("urn:test:s877ah202electionkeepsad221#a"), "pr1", 300 USD, 1000 USD) { origin case_input; }
        assert "f1": elects_not_to_apply_basis_step_up_877ah2(entity_ref("urn:test:s877ah202electionkeepsad221#a")) { origin case_input; }
    }
    evaluate truth(basis_for_877a_tax_877ah2(entity_ref("urn:test:s877ah202electionkeepsad221#a"), "pr1", 300 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
