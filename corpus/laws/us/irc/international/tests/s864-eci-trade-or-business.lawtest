// §864(b)-(c) scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.international version "0.1.1";
namespace "urn:us:irc:international:clir";

test "S864-01-TRADING-SAFE-HARBOR-NO-US-OFFICE" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": trading_through_independent_agent(entity_ref("urn:test:s864:t1#p"), "securities") { origin case_input; }
    }
    evaluate truth(trading_safe_harbor_applies(entity_ref("urn:test:s864:t1#p"), "securities"));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S864-02-TRADING-SAFE-HARBOR-LOST-WITH-US-DIRECTING-OFFICE" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": trading_through_independent_agent(entity_ref("urn:test:s864:t2#p"), "securities") { origin case_input; }
        assert "f1": has_us_office_directing_trading(entity_ref("urn:test:s864:t2#p")) { origin case_input; }
    }
    evaluate truth(trading_safe_harbor_applies(entity_ref("urn:test:s864:t2#p"), "securities"));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

test "S864-03-ECI-CATCH-ALL-WHEN-ENGAGED-IN-US-BUSINESS" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": nonresident_alien_or_foreign_corp(entity_ref("urn:test:s864:e1#p")) { origin case_input; }
        assert "f1": performs_personal_services_in_us(entity_ref("urn:test:s864:e1#p")) { origin case_input; }
        assert "f2": income_gain_or_loss_from_us_sources(entity_ref("urn:test:s864:e1#p"), "item1") { origin case_input; }
    }
    evaluate truth(effectively_connected(entity_ref("urn:test:s864:e1#p"), "item1"));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S864-04-NO-ECI-WHEN-NOT-ENGAGED-IN-US-BUSINESS" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": nonresident_alien_or_foreign_corp(entity_ref("urn:test:s864:e2#p")) { origin case_input; }
    }
    evaluate truth(no_effectively_connected_income(entity_ref("urn:test:s864:e2#p")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
