// §897(a),(c)(1)-(2),(h) scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.international version "0.1.1";
namespace "urn:us:irc:international:clir";

test "S897A-01-INDIVIDUAL-USRPI-GAIN-TREATED-AS-ECI" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": usrpi_disposition_gain_or_loss_individual(entity_ref("urn:test:s897a:ind1"), 50000 USD) { origin case_input; }
    }
    evaluate truth(usrpi_gain_treated_as_eci(entity_ref("urn:test:s897a:ind1"), 50000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S897C2-01-USRPHC-FIFTY-PERCENT-BOUNDARY-QUALIFIES" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": fmv_us_real_property_interests(entity_ref("urn:test:s897c:corp1"), 50 USD) { origin case_input; }
        assert "f1": fmv_foreign_real_property_interests(entity_ref("urn:test:s897c:corp1"), 30 USD) { origin case_input; }
        assert "f2": fmv_other_trade_or_business_assets(entity_ref("urn:test:s897c:corp1"), 20 USD) { origin case_input; }
    }
    // total = 100; us_rpi = 50 = exactly 50% -> "equals or exceeds" qualifies.
    evaluate truth(united_states_real_property_holding_corporation(entity_ref("urn:test:s897c:corp1")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S897C2-02-BELOW-FIFTY-PERCENT-FAILS" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": fmv_us_real_property_interests(entity_ref("urn:test:s897c:corp2"), 49 USD) { origin case_input; }
        assert "f1": fmv_foreign_real_property_interests(entity_ref("urn:test:s897c:corp2"), 30 USD) { origin case_input; }
        assert "f2": fmv_other_trade_or_business_assets(entity_ref("urn:test:s897c:corp2"), 21 USD) { origin case_input; }
    }
    evaluate truth(united_states_real_property_holding_corporation(entity_ref("urn:test:s897c:corp2")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

test "S897H-01-QIE-DISTRIBUTION-LOOK-THROUGH-TO-USRPI-GAIN" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": qie_distribution_attributable_to_usrpi_gain(entity_ref("urn:test:s897h:reit1"), entity_ref("urn:test:s897h:fc1"), 8000 USD) { origin case_input; }
    }
    evaluate truth(qie_distribution_treated_as_usrpi_gain(entity_ref("urn:test:s897h:reit1"), entity_ref("urn:test:s897h:fc1"), 8000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S897H-02-FIVE-PERCENT-PUBLICLY-TRADED-CARVE-OUT-BLOCKS-LOOK-THROUGH" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": qie_distribution_attributable_to_usrpi_gain(entity_ref("urn:test:s897h:reit2"), entity_ref("urn:test:s897h:fc2"), 8000 USD) { origin case_input; }
        assert "f1": distribution_stock_regularly_traded_in_us(entity_ref("urn:test:s897h:reit2"), entity_ref("urn:test:s897h:fc2")) { origin case_input; }
        assert "f2": recipient_owned_five_percent_or_less_stock_class(entity_ref("urn:test:s897h:reit2"), entity_ref("urn:test:s897h:fc2")) { origin case_input; }
    }
    evaluate truth(qie_distribution_treated_as_usrpi_gain(entity_ref("urn:test:s897h:reit2"), entity_ref("urn:test:s897h:fc2"), 8000 USD));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
