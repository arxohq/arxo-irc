// §1441(a)-(c); §1445(a)-(b); §1471(a)-(b) scenarios. NOT EXECUTED
// (implemented_unverified).

language "law.core" version "0.2";
package us.irc.international version "0.1.1";
namespace "urn:us:irc:international:clir";

test "S1441-01-WITHHOLDING-30-PERCENT-GENERAL" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": withholding_agent_pays_income_item(entity_ref("urn:test:s1441:w1#agent"), entity_ref("urn:test:s1441:w1#recipient"), 1000 USD, "item1") { origin case_input; }
        assert "f1": recipient_is_nonresident_alien_or_foreign_partnership(entity_ref("urn:test:s1441:w1#recipient")) { origin case_input; }
    }
    evaluate truth(withholding_1441_amount(entity_ref("urn:test:s1441:w1#agent"), entity_ref("urn:test:s1441:w1#recipient"), 1000 USD, 300 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1441-02-NO-WITHHOLDING-WHEN-PORTFOLIO-INTEREST-EXEMPT" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": withholding_agent_pays_income_item(entity_ref("urn:test:s1441:w2#agent"), entity_ref("urn:test:s1441:w2#recipient"), 1000 USD, "item2") { origin case_input; }
        assert "f1": recipient_is_nonresident_alien_or_foreign_partnership(entity_ref("urn:test:s1441:w2#recipient")) { origin case_input; }
        assert "f2": interest_would_be_taxed_under_871a(entity_ref("urn:test:s1441:w2#recipient"), "item2") { origin case_input; }
        assert "f3": obligation_in_registered_form("item2") { origin case_input; }
        assert "f4": beneficial_owner_non_us_statement_received("item2") { origin case_input; }
    }
    evaluate truth(withholding_1441_amount(entity_ref("urn:test:s1441:w2#agent"), entity_ref("urn:test:s1441:w2#recipient"), 1000 USD, 300 USD));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

test "S1445-01-FIRPTA-15-PERCENT-WITHHOLDING" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": usrpi_disposition(entity_ref("urn:test:s1445:r1#transferee"), entity_ref("urn:test:s1445:r1#transferor"), 500000 USD) { origin case_input; }
        assert "f1": transferor_is_foreign_person(entity_ref("urn:test:s1445:r1#transferor")) { origin case_input; }
    }
    evaluate truth(firpta_withholding_amount(entity_ref("urn:test:s1445:r1#transferee"), entity_ref("urn:test:s1445:r1#transferor"), 500000 USD, 75000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

