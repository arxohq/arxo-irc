        assert "f2": acquired_for_use_as_residence(entity_ref("urn:test:s1445:r2#transferee"), entity_ref("urn:test:s1445:r2#transferor")) { origin case_input; }
    }
    evaluate truth(firpta_withholding_amount(entity_ref("urn:test:s1445:r2#transferee"), entity_ref("urn:test:s1445:r2#transferor"), 300000 USD, 45000 USD));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

