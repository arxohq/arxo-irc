test "S1445C1-01-WITHHOLDING-CAPPED-AT-MAXIMUM-TAX-LIABILITY" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": usrpi_disposition(entity_ref("urn:test:s1445c1:transferee"), entity_ref("urn:test:s1445c1:transferor"), 500000 USD) { origin case_input; }
        assert "f1": transferor_is_foreign_person(entity_ref("urn:test:s1445c1:transferor")) { origin case_input; }
        assert "f2": transferor_maximum_tax_liability(entity_ref("urn:test:s1445c1:transferor"), 500000 USD, 40000 USD) { origin case_input; }
    }
    // uncapped 15% of 500000 = 75000, capped at 40000.
    evaluate truth(firpta_withholding_amount_capped(entity_ref("urn:test:s1445c1:transferee"), entity_ref("urn:test:s1445c1:transferor"), 500000 USD, 40000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

