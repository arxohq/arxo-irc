// §901(a)-(b); §904(a),(c),(d) scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.international version "0.1.1";
namespace "urn:us:irc:international:clir";

test "S904-01-LIMITATION-BINDS-CREDIT-CAPPED" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": foreign_tax_credit_election(entity_ref("urn:test:s904:l1#p"), entity_ref("urn:test:s904:l1#y")) { origin case_input; }
        assert "f1": citizen_of_us_or_domestic_corporation(entity_ref("urn:test:s904:l1#p")) { origin case_input; }
        assert "f2": foreign_tax_paid_or_accrued(entity_ref("urn:test:s904:l1#p"), entity_ref("urn:test:s904:l1#y"), 400 USD) { origin case_input; }
        assert "f3": us_tax_before_credit_input(entity_ref("urn:test:s904:l1#p"), entity_ref("urn:test:s904:l1#y"), 1000 USD) { origin case_input; }
        assert "f4": foreign_source_taxable_income_input(entity_ref("urn:test:s904:l1#p"), entity_ref("urn:test:s904:l1#y"), 2000 USD) { origin case_input; }
        assert "f5": worldwide_taxable_income_input(entity_ref("urn:test:s904:l1#p"), entity_ref("urn:test:s904:l1#y"), 10000 USD) { origin case_input; }
    }
    // limitation = 1000 * min(2000,10000)/10000 = 200; pre-limitation 400 > 200 -> allowed 200.
    evaluate truth(foreign_tax_credit_allowed(entity_ref("urn:test:s904:l1#p"), entity_ref("urn:test:s904:l1#y"), 200 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S904-02-LIMITATION-NOT-BINDING-FULL-CREDIT-ALLOWED" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": foreign_tax_credit_election(entity_ref("urn:test:s904:l2#p"), entity_ref("urn:test:s904:l2#y")) { origin case_input; }
        assert "f1": citizen_of_us_or_domestic_corporation(entity_ref("urn:test:s904:l2#p")) { origin case_input; }
        assert "f2": foreign_tax_paid_or_accrued(entity_ref("urn:test:s904:l2#p"), entity_ref("urn:test:s904:l2#y"), 100 USD) { origin case_input; }
        assert "f3": us_tax_before_credit_input(entity_ref("urn:test:s904:l2#p"), entity_ref("urn:test:s904:l2#y"), 1000 USD) { origin case_input; }
        assert "f4": foreign_source_taxable_income_input(entity_ref("urn:test:s904:l2#p"), entity_ref("urn:test:s904:l2#y"), 2000 USD) { origin case_input; }
        assert "f5": worldwide_taxable_income_input(entity_ref("urn:test:s904:l2#p"), entity_ref("urn:test:s904:l2#y"), 10000 USD) { origin case_input; }
    }
    evaluate truth(foreign_tax_credit_allowed(entity_ref("urn:test:s904:l2#p"), entity_ref("urn:test:s904:l2#y"), 100 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S904-03-EXCESS-CARRIES-OVER" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": foreign_tax_credit_election(entity_ref("urn:test:s904:l1#p"), entity_ref("urn:test:s904:l1#y")) { origin case_input; }
        assert "f1": citizen_of_us_or_domestic_corporation(entity_ref("urn:test:s904:l1#p")) { origin case_input; }
        assert "f2": foreign_tax_paid_or_accrued(entity_ref("urn:test:s904:l1#p"), entity_ref("urn:test:s904:l1#y"), 400 USD) { origin case_input; }
        assert "f3": us_tax_before_credit_input(entity_ref("urn:test:s904:l1#p"), entity_ref("urn:test:s904:l1#y"), 1000 USD) { origin case_input; }
        assert "f4": foreign_source_taxable_income_input(entity_ref("urn:test:s904:l1#p"), entity_ref("urn:test:s904:l1#y"), 2000 USD) { origin case_input; }
        assert "f5": worldwide_taxable_income_input(entity_ref("urn:test:s904:l1#p"), entity_ref("urn:test:s904:l1#y"), 10000 USD) { origin case_input; }
    }
    evaluate truth(ftc_excess_over_limitation(entity_ref("urn:test:s904:l1#p"), entity_ref("urn:test:s904:l1#y"), 200 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S904F-01-OFL-RECAPTURE-LIMITED-TO-FIFTY-PERCENT" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": unused_overall_foreign_loss_balance(entity_ref("urn:test:s904f:p1"), entity_ref("urn:test:s904f:y1"), 100000 USD) { origin case_input; }
        assert "f1": foreign_source_taxable_income_input(entity_ref("urn:test:s904f:p1"), entity_ref("urn:test:s904f:y1"), 60000 USD) { origin case_input; }
    }
    // 50% of 60000 = 30000, less than the 100000 balance -> recapture = 30000.
    evaluate truth(overall_foreign_loss_recapture_amount(entity_ref("urn:test:s904f:p1"), entity_ref("urn:test:s904f:y1"), 30000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S904F-02-OFL-RECAPTURE-LIMITED-BY-REMAINING-BALANCE" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": unused_overall_foreign_loss_balance(entity_ref("urn:test:s904f:p2"), entity_ref("urn:test:s904f:y2"), 10000 USD) { origin case_input; }
        assert "f1": foreign_source_taxable_income_input(entity_ref("urn:test:s904f:p2"), entity_ref("urn:test:s904f:y2"), 60000 USD) { origin case_input; }
    }
    // 50% of 60000 = 30000, but the remaining balance (10000) is smaller.
    evaluate truth(overall_foreign_loss_recapture_amount(entity_ref("urn:test:s904f:p2"), entity_ref("urn:test:s904f:y2"), 10000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S904G-01-ODL-RECHARACTERIZATION-FIFTY-PERCENT" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": unused_overall_domestic_loss_balance(entity_ref("urn:test:s904g:p1"), entity_ref("urn:test:s904g:y1"), 100000 USD) { origin case_input; }
        assert "f1": us_source_taxable_income_input(entity_ref("urn:test:s904g:p1"), entity_ref("urn:test:s904g:y1"), 40000 USD) { origin case_input; }
    }
    evaluate truth(overall_domestic_loss_recharacterized_amount(entity_ref("urn:test:s904g:p1"), entity_ref("urn:test:s904g:y1"), 20000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
