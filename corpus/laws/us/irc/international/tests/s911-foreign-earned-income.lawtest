// §911(a)-(d) scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.international version "0.1.1";
namespace "urn:us:irc:international:clir";

test "S911-01-PHYSICAL-PRESENCE-330-DAYS-QUALIFIES" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": citizen_or_resident_of_us(entity_ref("urn:test:s911:p1#ind")) { origin case_input; }
        assert "f1": days_present_in_foreign_country_in_12_month_period(entity_ref("urn:test:s911:p1#ind"), @2023-01-01, 330) { origin case_input; }
        assert "f2": us.irc.core::year_of(entity_ref("urn:test:s911:p1#ind"), entity_ref("urn:test:s911:p1#y2023")) { origin case_input; }
    }
    evaluate truth(qualified_individual_by_physical_presence(entity_ref("urn:test:s911:p1#ind"), @2023-01-01));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S911-02-PHYSICAL-PRESENCE-329-DAYS-FAILS" {
    given {
        context { legal_time @2024-01-01; decision_time @2024-01-01T09:00:00-05:00; knowledge_time @2024-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": citizen_or_resident_of_us(entity_ref("urn:test:s911:p2#ind")) { origin case_input; }
        assert "f1": days_present_in_foreign_country_in_12_month_period(entity_ref("urn:test:s911:p2#ind"), @2023-01-01, 329) { origin case_input; }
    }
    evaluate truth(qualified_individual_by_physical_presence(entity_ref("urn:test:s911:p2#ind"), @2023-01-01));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

test "S911-03-EXCLUSION-CAPPED-AT-STATUTORY-AMOUNT-2005" {
    given {
        context { legal_time @2005-06-01; decision_time @2005-06-01T09:00:00-05:00; knowledge_time @2005-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": citizen_or_resident_of_us(entity_ref("urn:test:s911:e1#ind")) { origin case_input; }
        assert "f0t": tax_home_for_162a2_in_foreign_country_911d3(entity_ref("urn:test:s911:e1#ind"), entity_ref("urn:test:s911:e1#y2005")) { origin case_input; }
        assert "f1": qualified_individual_by_bona_fide_residence(entity_ref("urn:test:s911:e1#ind"), entity_ref("urn:test:s911:e1#y2005")) { origin case_input; }
        assert "f2": foreign_earned_income_amount(entity_ref("urn:test:s911:e1#ind"), entity_ref("urn:test:s911:e1#y2005"), 100000 USD) { origin case_input; }
    }
    evaluate truth(foreign_earned_income_exclusion_amount(entity_ref("urn:test:s911:e1#ind"), entity_ref("urn:test:s911:e1#y2005"), 80000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S911C-01-HOUSING-COST-AMOUNT-COMPUTED" {
    given {
        context { legal_time @2005-06-01; decision_time @2005-06-01T09:00:00-05:00; knowledge_time @2005-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": citizen_or_resident_of_us(entity_ref("urn:test:s911c:h1#ind")) { origin case_input; }
        assert "f0t": tax_home_for_162a2_in_foreign_country_911d3(entity_ref("urn:test:s911c:h1#ind"), entity_ref("urn:test:s911c:h1#y2005")) { origin case_input; }
        assert "f1": qualified_individual_by_bona_fide_residence(entity_ref("urn:test:s911c:h1#ind"), entity_ref("urn:test:s911c:h1#y2005")) { origin case_input; }
        assert "f2": housing_expenses(entity_ref("urn:test:s911c:h1#ind"), entity_ref("urn:test:s911c:h1#y2005"), 20000 USD) { origin case_input; }
    }
    // base = 16% * 80000 = 12800; limitation = 30% * 80000 = 24000;
    // housing expenses (20000) < limitation (24000), so capped amount = 20000;
    // housing cost amount = 20000 - 12800 = 7200.
    evaluate truth(housing_cost_amount(entity_ref("urn:test:s911c:h1#ind"), entity_ref("urn:test:s911c:h1#y2005"), 7200 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S911C-02-HOUSING-EXPENSES-ABOVE-LIMITATION-CAPPED" {
    given {
        context { legal_time @2005-06-01; decision_time @2005-06-01T09:00:00-05:00; knowledge_time @2005-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": citizen_or_resident_of_us(entity_ref("urn:test:s911c:h2#ind")) { origin case_input; }
        assert "f0t": tax_home_for_162a2_in_foreign_country_911d3(entity_ref("urn:test:s911c:h2#ind"), entity_ref("urn:test:s911c:h2#y2005")) { origin case_input; }
        assert "f1": qualified_individual_by_bona_fide_residence(entity_ref("urn:test:s911c:h2#ind"), entity_ref("urn:test:s911c:h2#y2005")) { origin case_input; }
        assert "f2": housing_expenses(entity_ref("urn:test:s911c:h2#ind"), entity_ref("urn:test:s911c:h2#y2005"), 50000 USD) { origin case_input; }
    }
    // capped amount = min(50000, 24000) = 24000; housing cost amount = 24000 - 12800 = 11200.
    evaluate truth(housing_cost_amount(entity_ref("urn:test:s911c:h2#ind"), entity_ref("urn:test:s911c:h2#y2005"), 11200 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S911C-03-DEDUCTION-LIMITED-BY-EXCESS-OF-INCOME-OVER-EXCLUSION" {
    given {
        context { legal_time @2005-06-01; decision_time @2005-06-01T09:00:00-05:00; knowledge_time @2005-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": citizen_or_resident_of_us(entity_ref("urn:test:s911c:h3#ind")) { origin case_input; }
        assert "f0t": tax_home_for_162a2_in_foreign_country_911d3(entity_ref("urn:test:s911c:h3#ind"), entity_ref("urn:test:s911c:h3#y2005")) { origin case_input; }
        assert "f1": qualified_individual_by_bona_fide_residence(entity_ref("urn:test:s911c:h3#ind"), entity_ref("urn:test:s911c:h3#y2005")) { origin case_input; }
        assert "f2": foreign_earned_income_amount(entity_ref("urn:test:s911c:h3#ind"), entity_ref("urn:test:s911c:h3#y2005"), 100000 USD) { origin case_input; }
        assert "f3": housing_cost_amount_not_employer_provided(entity_ref("urn:test:s911c:h3#ind"), entity_ref("urn:test:s911c:h3#y2005"), 15000 USD) { origin case_input; }
    }
    // exclusion = min(100000, 80000) = 80000; deduction limitation = 100000 - 80000 = 20000;
    // deduction = min(15000, 20000) = 15000.
    evaluate truth(housing_cost_amount_deduction(entity_ref("urn:test:s911c:h3#ind"), entity_ref("urn:test:s911c:h3#y2005"), 15000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
