// §901(a)-(b) — foreign tax credit allowance and who may claim it;
// §904(a),(c),(d) — the limitation formula, carryback/carryforward, and the
// separate-basket structure (basket tagging only, not a full per-basket
// replay). Stage 1 (IRC-10 stage 1, A13). §901(c)-(n), §903, §904(b),(e)-(k)
// are NOT modeled this stage (stage 2).

// --- §901(a): election and allowance --------------------------------------

use self::{
    IRC_S901_A,
    IRC_S901_B,
    IRC_S904_A,
    IRC_S904_C,
    IRC_S904_D,
    IRC_S904_F,
    IRC_S904_G,
};

pub relation foreign_tax_paid_or_accrued(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "income, war profits, and excess profits taxes paid or accrued during the taxable year to a foreign country or US possession, for section 901(b) classification";
}
pub relation citizen_of_us_or_domestic_corporation(p: us.irc.core::Person) kind empirical {
    label en official "the person is a citizen of the United States or a domestic corporation, for section 901(b)(1)";
}

// The section 901(a) "choose to have the benefits of this subpart" is a
// `power`: exercising it changes the legal relation (the tax otherwise
// imposed is credited); it may be made or changed until the credit-or-
// refund claim period under section 6511 expires (not modeled here — TECH_GAP,
// the deadline computation belongs to `payment-refunds-interest`).
@source(IRC_S901_A, relation = formalizes, coverage = partial, quote = "If the taxpayer chooses to have the benefits of this subpart, the tax imposed by this chapter shall, subject to the limitation of section 904, be credited with the amounts provided in the applicable paragraph of subsection (b)")
pub relation foreign_tax_credit_election(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en unofficial "the taxpayer elected to have the benefits of the foreign tax credit subpart for this taxable year, for section 901(a)";
}
pub relation foreign_tax_credit_regime_elected(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the taxpayer's choice under section 901(a) is in effect for this taxable year — the gate that makes the section 901(b)/904 credit machinery apply at all";
}
rule S901AElectionPower strict {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when foreign_tax_credit_election(p, y);
    then power S901ForeignTaxCreditElection {
        holder p;
        over p;
        exercise foreign_tax_credit_election(p, y);
        valid_when foreign_tax_credit_election(p, y);
        effect create(foreign_tax_credit_regime_elected(p, y));
    };
}

@source(IRC_S901_B, relation = formalizes, coverage = partial, quote = "In the case of a citizen of the United States and of a domestic corporation, the amount of any income, war profits, and excess profits taxes paid or accrued during the taxable year to any foreign country or to any possession of the United States")
pub relation foreign_tax_credit_amount_allowed_before_limitation(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the amount of foreign tax under section 901(b) before the section 904 limitation is applied — for a citizen or domestic corporation, the taxes paid or accrued to a foreign country or US possession (section 901(b)(1))";
}
rule S901B1CitizenOrDomesticCorporationAmount strict {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when foreign_tax_paid_or_accrued(p, y, amount)
     and citizen_of_us_or_domestic_corporation(p);
    then foreign_tax_credit_amount_allowed_before_limitation(p, y, amount);
}

pub relation foreign_tax_credit_allowed(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the foreign tax credit finally allowed for the year, after the section 904 limitation caps the pre-limitation amount of section 901(b)";
}
@source(IRC_S904_A, relation = formalizes, coverage = exact, quote = "The total amount of the credit taken under section 901(a) shall not exceed the same proportion of the tax against which such credit is taken which the taxpayer's taxable income from sources without the United States (but not in excess of the taxpayer's entire taxable income) bears to his entire taxable income for the same taxable year.")
pub relation section_904_limitation(p: us.irc.core::Person, y: us.irc.core::TaxableYear, us_tax_before_credit: Money, foreign_source_taxable_income: Money, worldwide_taxable_income: Money, limitation: Money) kind institutional {
    label en official "section 904(a) limitation = US tax before credit * (foreign-source taxable income, capped at entire taxable income) / worldwide taxable income — an intermediate value, not the final credit";
}
rule S904ALimitationFormula strict {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for us_tax_before_credit: Money;
    for foreign_source_taxable_income: Money;
    for worldwide_taxable_income: Money;
    when us_tax_before_credit_input(p, y, us_tax_before_credit)
     and foreign_source_taxable_income_input(p, y, foreign_source_taxable_income)
     and worldwide_taxable_income_input(p, y, worldwide_taxable_income);
    then section_904_limitation(p, y, us_tax_before_credit, foreign_source_taxable_income, worldwide_taxable_income, us_tax_before_credit * (min(foreign_source_taxable_income, worldwide_taxable_income) / worldwide_taxable_income));
}
pub relation us_tax_before_credit_input(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the tax against which the foreign tax credit is taken (before the credit), an input to the section 904(a) formula";
}
pub relation foreign_source_taxable_income_input(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the taxpayer's taxable income from sources without the United States for the year, an input to the section 904(a) formula (before the entire-taxable-income cap the formula itself applies)";
}
pub relation worldwide_taxable_income_input(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the taxpayer's entire taxable income for the year, an input to the section 904(a) formula";
}
rule S904FinalCreditIsLesserOfPreLimitationOrLimitation defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for pre: Money;
    for limitation: Money;
    when foreign_tax_credit_regime_elected(p, y)
     and foreign_tax_credit_amount_allowed_before_limitation(p, y, pre)
     and section_904_limitation(p, y, _, _, _, limitation);
    then foreign_tax_credit_allowed(p, y, min(pre, limitation));
}

// --- §904(d): separate basket structure (tagging only) --------------------

pub enum ForeignTaxCreditBasket {
    Gilti;          // (d)(1)(A)
    ForeignBranch;  // (d)(1)(B)
    Passive;        // (d)(1)(C)
    General;        // (d)(1)(D)
    label en official "the four section 904(d)(1) separate limitation categories; a section 904(a) limitation is computed separately for each basket (this stage tags income by basket but does not replay the (a) formula once per basket — TECH_GAP)";
}
@source(IRC_S904_D, relation = formalizes, coverage = partial, quote = "The provisions of subsections (a), (b), and (c) and sections 902,[1] 907, and 960 shall be applied separately with respect to—")
pub relation income_in_basket(p: us.irc.core::Person, y: us.irc.core::TaxableYear, item_id: Text, basket: ForeignTaxCreditBasket) kind empirical {
    label en unofficial "an item of foreign-source gross income (or an associated foreign tax) is classified into one of the section 904(d)(1) baskets";
}

// --- §904(c): carryback 1 / carryforward 10 --------------------------------

@source(IRC_S904_C, relation = formalizes, coverage = partial, quote = "shall be deemed taxes paid or accrued to foreign countries or possessions of the United States in the first preceding taxable year and in any of the first 10 succeeding taxable years")
pub relation ftc_excess_over_limitation(p: us.irc.core::Person, y: us.irc.core::TaxableYear, excess: Money) kind institutional {
    label en official "the excess of the pre-limitation section 901(b) amount over the section 904(a) limitation for the year — the carryover base of section 904(c)";
}
rule S904CExcessOverLimitation defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for pre: Money;
    for limitation: Money;
    when foreign_tax_credit_amount_allowed_before_limitation(p, y, pre)
     and section_904_limitation(p, y, _, _, _, limitation)
     and pre > limitation;
    then ftc_excess_over_limitation(p, y, pre - limitation);
}
// carryback 1 year / carryforward 10 years: modeled as the core Carryover
// shape's window, not a self-recursive ledger (compiler trap: self-
// recursive arithmetic is LDC-E4102). A two-year replay (this year's excess
// usable against NEXT year's unused limitation) is a scenario, not a rule,
// per AGENT-BRIEF.md's "carryback 1 / carryforward 10 years — two-year
// scenario" instruction.
pub relation ftc_carryover_window(from_year: us.irc.core::TaxableYear, to_year: us.irc.core::TaxableYear, direction: Text) kind institutional {
    label en official "section 904(c): a foreign tax credit carryover from from_year reaches to_year when to_year is the one preceding year (direction 'back') or one of the ten succeeding years (direction 'forward') of from_year";
}

// --- §904(f)(1)-(2): recapture of overall foreign loss --------------------
//
// Stage 2b. The (f)(1) 50%-recapture formula is modeled at the per-year
// arithmetic level; the (f)(2) "overall foreign loss" balance itself —
// which nets against and decrements over an UNBOUNDED prior-year history —
// is asserted directly as a case fact (`unused_overall_foreign_loss_balance`)
// rather than derived from a running ledger, the same self-referential-
// accumulation class as TECH-GAPS G1/G10/G38/G97 (recorded as G330). The
// (f)(3) disposition rules, (f)(4) foreign-trust accumulation distributions,
// and (f)(5) separate-limitation-loss allocation are NOT modeled this
// stage.

pub relation unused_overall_foreign_loss_balance(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the portion of the taxpayer's overall foreign loss (section 904(f)(2)) not yet used under section 904(f)(1) as of the start of the taxable year — asserted directly as a case fact; TECH-GAPS G330 (self-referential balance, not derived from a running ledger)";
}
@source(IRC_S904_F, relation = formalizes, coverage = partial, quote = "50 percent (or such larger percent as the taxpayer may choose) of the taxpayer's taxable income from sources without the United States for such succeeding taxable year")
pub relation overall_foreign_loss_recapture_amount(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the section 904(f)(1) recapture amount: the lesser of the taxpayer's remaining unused overall foreign loss balance or 50 percent of the taxpayer's foreign-source taxable income for the succeeding taxable year, treated as United States-source income (not foreign-source)";
}
rule S904F1OverallForeignLossRecapture defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for balance: Money;
    for foreign_source: Money;
    when unused_overall_foreign_loss_balance(p, y, balance)
     and foreign_source_taxable_income_input(p, y, foreign_source);
    then overall_foreign_loss_recapture_amount(p, y, min(balance, round(0.50 * foreign_source, 2, "HALF_UP")));
}

// --- §904(g)(1)-(2): recharacterization of overall domestic loss ----------
//
// Same modeling shape as (f) above, mirrored: the "overall domestic loss"
// balance is asserted directly (TECH-GAPS G330), the per-year 50% formula
// is executable. (g)(3)-(5) (subsequent-income characterization, the
// coordination regulations, and the pre-2018 percentage-increase election)
// are NOT modeled this stage.

pub relation unused_overall_domestic_loss_balance(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the portion of the taxpayer's overall domestic loss (section 904(g)(2)) not yet used under section 904(g)(1) as of the start of the taxable year — asserted directly as a case fact; TECH-GAPS G330";
}
pub relation us_source_taxable_income_input(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the taxpayer's taxable income from sources within the United States for the taxable year, for the section 904(g)(1)(B) 50% base";
}
@source(IRC_S904_G, relation = formalizes, coverage = partial, quote = "50 percent of the taxpayer's taxable income from sources within the United States for such succeeding taxable year")
pub relation overall_domestic_loss_recharacterized_amount(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the section 904(g)(1) recharacterization amount: the lesser of the taxpayer's remaining unused overall domestic loss balance or 50 percent of the taxpayer's US-source taxable income for the succeeding taxable year, treated as foreign-source income (not United States-source)";
}
rule S904G1OverallDomesticLossRecharacterization defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for balance: Money;
    for us_source: Money;
    when unused_overall_domestic_loss_balance(p, y, balance)
     and us_source_taxable_income_input(p, y, us_source);
    then overall_domestic_loss_recharacterized_amount(p, y, min(balance, round(0.50 * us_source, 2, "HALF_UP")));
}
