// Chapter 3 and chapter 4 residual: §1441(b)-(e); §1442; §1443; §1444;
// §1445(b)(3)-(9),(d),(f); §1461-§1464; §1471(b)-(f); §1472; §1473; §1474.
// Stage 2c (IRC-10 stage 2c, A13). Module 07 carries §1441(a)-(c) rate,
// §1445(a)-(c),(e), §1446 and §1471(a).
//
// Deontics: the FFI agreement of §1471(b)(1) is a set of duties of the
// financial institution towards the Secretary (obtain information, comply with
// verification, report annually, withhold on passthru payments to recalcitrant
// holders, answer requests, seek waivers or close the account); the agent's
// notice duty and fallback withholding duty of §1445(d); the withholding
// agent's indemnity of §1461/§1474(a) is an immunity.

// --- §1441(b): the items of income; (e) Puerto Rico residents ---------------

use self::{
    IRC_S1441_B,
    IRC_S1441_C,
    IRC_S1441_D,
    IRC_S1441_E,
    IRC_S1442_A,
    IRC_S1442_C,
    IRC_S1443_B,
    IRC_S1445_B,
    IRC_S1445_D,
    IRC_S1445_F,
    IRC_S1461,
    IRC_S1462,
    IRC_S1463,
    IRC_S1464,
    IRC_S1471_B,
    IRC_S1471_D,
    IRC_S1471_E,
    IRC_S1471_F,
    IRC_S1472_A,
    IRC_S1472_B,
    IRC_S1472_D,
    IRC_S1473,
    IRC_S1474_B,
    IRC_S1474_C,
    IRC_S1474_E,
    Secretary,
    ffi_agreement_in_effect,
    firpta_1445b_exemption_applies,
    firpta_withholding_amount,
    nonresident_alien,
    usrpi_disposition,
    withholding_1441c_exception_applies,
};

pub relation item_of_listed_kind_1441b(item_id: Text) kind empirical {
    label en official "the item is interest, dividends, rent, salaries, wages, premiums, annuities, compensations, remunerations, emoluments or other fixed or determinable annual or periodical gains, profits and income; a gain described in section 631(b) or (c); an amount subject to tax under section 871(a)(1)(C); or a gain subject to tax under section 871(a)(1)(D)";
}
pub relation item_is_original_issue_discount_1273(item_id: Text) kind empirical {
    label en official "the item is original issue discount as defined in section 1273 (excluded from the interest of the first sentence of section 1441(b))";
}
pub relation item_is_qualified_scholarship_1441b1(item_id: Text) kind empirical {
    label en official "the item is incident to a qualified scholarship to which section 117(a) applies, to the extent includible in gross income (section 1441(b)(1))";
}
pub relation item_is_nondegree_scholarship_1441b2(item_id: Text) kind empirical {
    label en official "the item is granted to an individual who is not a candidate for a degree at an educational organization, by a section 501(c)(3) organization, a foreign government, an international organization or a binational educational commission, or the United States, a State, a possession or a political subdivision, as a scholarship or fellowship for study, training or research in the United States (section 1441(b)(2))";
}
pub relation item_within_1441b(item_id: Text) kind institutional {
    label en official "the item of income is one referred to in section 1441(a) by section 1441(b)";
}
@source(IRC_S1441_B, relation = formalizes, coverage = partial, quote = "The items of income referred to in subsection (a) are interest (other than original issue discount as defined in section 1273), dividends, rent, salaries, wages, premiums, annuities, compensations, remunerations, emoluments, or other fixed or determinable annual or periodical gains, profits, and income")
rule S1441BListedItems defeasible {
    for item_id: Text;
    when item_of_listed_kind_1441b(item_id);
    unless item_is_original_issue_discount_1273(item_id)
     and item_of_listed_kind_1441b(item_id);
    then item_within_1441b(item_id);
}
@source(IRC_S1441_B, relation = formalizes, coverage = partial, quote = "(1) incident to a qualified scholarship to which section 117(a) applies, but only to the extent includible in gross income; or")
rule S1441B1QualifiedScholarshipItem defeasible {
    for item_id: Text;
    when item_is_qualified_scholarship_1441b1(item_id);
    then item_within_1441b(item_id);
}
@source(IRC_S1441_B, relation = formalizes, coverage = partial, quote = "(2) in the case of an individual who is not a candidate for a degree at an educational organization described in section 170(b)(1)(A)(ii), granted by—")
rule S1441B2NondegreeScholarshipItem defeasible {
    for item_id: Text;
    when item_is_nondegree_scholarship_1441b2(item_id);
    then item_within_1441b(item_id);
}
pub relation alien_resident_of_puerto_rico_1441e(p: us.irc.core::Person) kind empirical {
    label en official "the alien is a resident of the Commonwealth of Puerto Rico";
}
pub relation nonresident_alien_individual_for_1441(p: us.irc.core::Person) kind institutional {
    label en official "the person is a nonresident alien individual for section 1441 purposes: the term includes an alien resident of Puerto Rico (section 1441(e))";
}
@source(IRC_S1441_E, relation = formalizes, coverage = exact, quote = "For purposes of this section, the term \"nonresident alien individual\" includes an alien resident of Puerto Rico.")
rule S1441EAlienResidentOfPuertoRico defeasible {
    for p: us.irc.core::Person;
    when alien_resident_of_puerto_rico_1441e(p);
    then nonresident_alien_individual_for_1441(p);
}
rule S1441ENonresidentAlienIncluded defeasible {
    for w: us.irc.core::Individual;
    when nonresident_alien(w);
    then nonresident_alien_individual_for_1441(w);
}

// --- §1441(c): further exceptions and special rules -------------------------

pub relation per_diem_subsistence_paid_by_us_government_to_trainee_1441c6(recipient: us.irc.core::Person, item_id: Text) kind empirical {
    label en official "amounts of per diem for subsistence paid by the United States Government (directly or by contract) to a nonresident alien individual engaged in a training program in the United States under the Mutual Security Act of 1954";
}
@source(IRC_S1441_C, relation = formalizes, coverage = exact, quote = "No deduction or withholding under subsection (a) shall be required in the case of amounts of per diem for subsistence paid by the United States Government (directly or by contract) to any nonresident alien individual who is engaged in any program of training in the United States under the Mutual Security Act of 1954, as amended.")
rule S1441C6PerDiemSubsistenceException defeasible {
    for recipient: us.irc.core::Person;
    for item_id: Text;
    when per_diem_subsistence_paid_by_us_government_to_trainee_1441c6(recipient, item_id);
    then withholding_1441c_exception_applies(recipient, item_id);
}
pub relation annuity_exempt_under_871f_1441c7(recipient: us.irc.core::Person, item_id: Text) kind empirical {
    label en official "the amount is received as an annuity that is, under section 871(f), exempt from the tax imposed by section 871(a)";
}
@source(IRC_S1441_C, relation = formalizes, coverage = exact, quote = "No deduction or withholding under subsection (a) shall be required in the case of any amount received as an annuity if such amount is, under section 871(f), exempt from the tax imposed by section 871(a).")
rule S1441C7AnnuityExemptUnder871fException defeasible {
    for recipient: us.irc.core::Person;
    for item_id: Text;
    when annuity_exempt_under_871f_1441c7(recipient, item_id);
    then withholding_1441c_exception_applies(recipient, item_id);
}
pub relation amount_described_in_871i2_1441c10(recipient: us.irc.core::Person, item_id: Text) kind empirical {
    label en official "the amount is described in section 871(i)(2) (e.g. interest on bank deposits not effectively connected)";
}
@source(IRC_S1441_C, relation = formalizes, coverage = exact, quote = "No tax shall be required to be deducted and withheld under subsection (a) from any amount described in section 871(i)(2).")
rule S1441C10Amount871i2Exception defeasible {
    for recipient: us.irc.core::Person;
    for item_id: Text;
    when amount_described_in_871i2_1441c10(recipient, item_id);
    then withholding_1441c_exception_applies(recipient, item_id);
}
pub relation amount_exempt_under_871j_1441c11(recipient: us.irc.core::Person, item_id: Text) kind empirical {
    label en official "the amount is exempt from the tax imposed by section 871(a)(1)(A) by reason of section 871(j)";
}
@source(IRC_S1441_C, relation = formalizes, coverage = exact, quote = "No tax shall be required to be deducted and withheld under subsection (a) from any amount exempt from the tax imposed by section 871(a)(1)(A) by reason of section 871(j).")
rule S1441C11Amount871jException defeasible {
    for recipient: us.irc.core::Person;
    for item_id: Text;
    when amount_exempt_under_871j_1441c11(recipient, item_id);
    then withholding_1441c_exception_applies(recipient, item_id);
}
pub relation amount_exempt_under_871k_1441c12(recipient: us.irc.core::Person, item_id: Text) kind empirical {
    label en official "the amount is exempt from the tax imposed by section 871(a)(1)(A) by reason of section 871(k) (interest-related and short-term capital gain dividends of a regulated investment company)";
}
pub relation ric_knows_dividend_is_excluded_kind_1441c12B(item_id: Text) kind empirical {
    label en official "the regulated investment company knows that the dividend is a dividend referred to in section 871(k)(1)(B)(i) (or the corresponding exception in 871(k)(2)(B)) — without that knowledge the clause does not apply";
}
pub relation dividend_relies_on_871k_exception_clause_1441c12B(item_id: Text) kind empirical {
    label en official "the exemption of the dividend rests on clause (i) of section 871(k)(1)(B) or the exception in section 871(k)(2)(B)";
}
@source(IRC_S1441_C, relation = formalizes, coverage = partial, quote = "No tax shall be required to be deducted and withheld under subsection (a) from any amount exempt from the tax imposed by section 871(a)(1)(A) by reason of section 871(k).")
rule S1441C12Amount871kException defeasible {
    for recipient: us.irc.core::Person;
    for item_id: Text;
    when amount_exempt_under_871k_1441c12(recipient, item_id);
    unless dividend_relies_on_871k_exception_clause_1441c12B(item_id)
     and amount_exempt_under_871k_1441c12(recipient, item_id)
     and not_known(ric_knows_dividend_is_excluded_kind_1441c12B(item_id));
    then withholding_1441c_exception_applies(recipient, item_id);
}
pub relation secretary_authorizes_withholding_on_unknown_owner_interest_1441c2(item_id: Text) kind empirical {
    label en official "the Secretary authorizes the tax under subsection (a) to be deducted and withheld from interest upon securities the owners of which are not known to the withholding agent";
}
pub relation unknown_owner_securities_interest_1441c2(item_id: Text, interest: Money) kind empirical {
    label en official "interest upon securities the owners of which are not known to the withholding agent";
}
pub relation unknown_owner_interest_withheld_at_30_percent_1441c2(item_id: Text, tax: Money) kind institutional {
    label en official "the tax under subsection (a) is deducted and withheld from the interest on securities with unknown owners once the Secretary has authorized it (30 percent)";
}
@source(IRC_S1441_C, relation = formalizes, coverage = partial, quote = "The Secretary may authorize the tax under subsection (a) to be deducted and withheld from the interest upon any securities the owners of which are not known to the withholding agent.")
rule S1441C2AuthorizedWithholdingOnUnknownOwnerInterest strict {
    for item_id: Text;
    for interest: Money;
    when secretary_authorizes_withholding_on_unknown_owner_interest_1441c2(item_id)
     and unknown_owner_securities_interest_1441c2(item_id, interest);
    then power S1441C2AuthorizeUnknownOwnerWithholdingPower {
        holder Secretary;
        over us.irc.core::IRS;
        exercise secretary_authorizes_withholding_on_unknown_owner_interest_1441c2(item_id);
        valid_when unknown_owner_securities_interest_1441c2(item_id, interest);
        effect create(unknown_owner_interest_withheld_at_30_percent_1441c2(item_id, round(interest * 0.30, 2, "HALF_UP")));
    };
}
pub relation gain_631_or_871a1D_amount_unknown_1441c5(item_id: Text, payable: Money) kind empirical {
    label en official "gain described in section 631(b) or (c), or gain subject to tax under section 871(a)(1)(D), of which the amount is not known to the withholding agent; the amount payable";
}
pub relation withholding_cap_unknown_gain_1441c5(item_id: Text, cap: Money) kind institutional {
    label en official "the ceiling on the amount deducted and withheld where the gain is unknown: not exceeding 30 percent of the amount payable (section 1441(c)(5)); the exact amount within the ceiling is the amount necessary to assure the tax withheld is not less than 30 percent of the gain";
}
@source(IRC_S1441_C, relation = formalizes, coverage = partial, quote = "be such amount, not exceeding 30 percent of the amount payable, as may be necessary to assure that the tax deducted and withheld shall not be less than 30 percent of such gain.")
rule S1441C5UnknownGainWithholdingCeiling defeasible {
    for item_id: Text;
    for payable: Money;
    when gain_631_or_871a1D_amount_unknown_1441c5(item_id, payable);
    then withholding_cap_unknown_gain_1441c5(item_id, round(payable * 0.30, 2, "HALF_UP"));
}
external judgment relation secretary_finds_undue_burden_and_no_jeopardy_1441d(p: us.irc.core::Person) {
    authority Secretary;
    label en official "the Secretary determines that the requirements of subsection (a) impose an undue administrative burden on the foreign partnership engaged in trade or business within the United States and that collection of the section 871(a) tax on its nonresident-alien members will not be jeopardized by the exemption (section 1441(d)) — committed to the Secretary's determination (DECISION-0194)";
}
pub relation foreign_partnership_engaged_in_us_business_1441d(p: us.irc.core::Person) kind empirical {
    label en official "a foreign partnership engaged in trade or business within the United States";
}
pub relation foreign_partnership_withholding_exemption_1441d(p: us.irc.core::Person) kind institutional {
    label en official "section 1441(a) does not apply to the foreign partnership, subject to regulations, on the Secretary's determination";
}
@source(IRC_S1441_D, relation = formalizes, coverage = partial, quote = "Subject to such terms and conditions as may be provided by regulations prescribed by the Secretary, subsection (a) shall not apply in the case of a foreign partnership engaged in trade or business within the United States")
rule S1441DUndueBurdenExemptionForForeignPartnership defeasible {
    for p: us.irc.core::Person;
    when foreign_partnership_engaged_in_us_business_1441d(p)
     and secretary_finds_undue_burden_and_no_jeopardy_1441d(p);
    then foreign_partnership_withholding_exemption_1441d(p);
}

// --- §1442: withholding on foreign corporations ------------------------------

pub relation withholding_agent_pays_item_to_foreign_corp_1442(agent: us.irc.core::Person, corp: us.irc.core::Corporation, amount: Money, item_id: Text) kind empirical {
    label en official "the withholding agent pays an item of income (of the section 1441(b) kinds, with the section 1442(a) substituted references) to a foreign corporation subject to taxation under this subtitle";
}
pub relation corporation_created_in_guam_or_possession_1442c1(corp: us.irc.core::Corporation) kind empirical {
    label en official "the corporation is created or organized in Guam, American Samoa, the Northern Mariana Islands or the Virgin Islands, or under the law of any such possession";
}
pub relation requirements_881b1ABC_met_1442c(corp: us.irc.core::Corporation) kind empirical {
    label en official "the requirements of subparagraphs (A), (B) and (C) of section 881(b)(1) are met with respect to the corporation (for the taxable year, in the case of the Puerto Rico rule)";
}
pub relation corporation_organized_in_puerto_rico_1442c2(corp: us.irc.core::Corporation) kind empirical {
    label en official "the corporation is created or organized in, or under the law of, the Commonwealth of Puerto Rico";
}
pub relation foreign_corporation_for_1442(corp: us.irc.core::Corporation) kind institutional {
    label en official "the corporation is a `foreign corporation` for section 1442: not a Guam/American Samoa/Northern Mariana/Virgin Islands corporation meeting the section 881(b)(1)(A)-(C) requirements (section 1442(c)(1))";
}
pub relation foreign_corporation_status_1442_candidate(corp: us.irc.core::Corporation) kind empirical {
    label en unofficial "the corporation is a foreign corporation before the section 1442(c)(1) carve-out is applied (a domain anchor)";
}
@source(IRC_S1442_C, relation = formalizes, coverage = exact, quote = "For purposes of this section, the term \"foreign corporation\" does not include a corporation created or organized in Guam, American Samoa, the Northern Mariana Islands, or the Virgin Islands or under the law of any such possession if the requirements of subparagraphs (A), (B), and (C) of section 881(b)(1) are met with respect to")
rule S1442C1ForeignCorporationDefinition defeasible {
    for corp: us.irc.core::Corporation;
    when foreign_corporation_status_1442_candidate(corp);
    unless corporation_created_in_guam_or_possession_1442c1(corp)
     and requirements_881b1ABC_met_1442c(corp)
     and foreign_corporation_status_1442_candidate(corp);
    then foreign_corporation_for_1442(corp);
}
pub relation pr_withholding_rate_over_10_percent_since_1442c2B(on: Date) kind empirical {
    label en official "an increase in the rate of the Commonwealth of Puerto Rico's withholding tax generally applicable to dividends paid to United States corporations not engaged in a trade or business there, to a rate greater than 10 percent, took effect on this date (section 1442(c)(2)(B))";
}
pub relation dividend_received_by_pr_corporation_1442c2(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, received_on: Date, amount: Money) kind empirical {
    label en official "a dividend received during the taxable year by a Puerto Rico corporation, on this date";
}
pub relation pr_dividend_rate_increase_in_effect_1442c2B(received_on: Date) kind institutional {
    label en official "the Puerto Rico rate increase took effect on or before the date the dividend is received, so the 10 percent paragraph does not apply (section 1442(c)(2)(B))";
}
rule S1442C2BRateIncreaseTookEffect defeasible {
    for received_on: Date;
    for effective_on: Date;
    when pr_withholding_rate_over_10_percent_since_1442c2B(effective_on)
     and dividend_received_by_pr_corporation_1442c2(_, _, received_on, _)
     and received_on >= effective_on;
    then pr_dividend_rate_increase_in_effect_1442c2B(received_on);
}
pub relation withholding_1442_amount(agent: us.irc.core::Person, corp: us.irc.core::Corporation, amount: Money, tax: Money) kind institutional {
    label en official "the amount to be deducted and withheld from an item of income of a foreign corporation: 30 percent in the same manner and on the same items as section 1441, or 10 percent of a dividend received by a Puerto Rico corporation meeting the section 881(b)(1) requirements (section 1442(a), (c)(2)(A))";
}
pub relation pr_dividend_ten_percent_rate_applies_1442c2A(agent: us.irc.core::Person, corp: us.irc.core::Corporation, item_id: Text, amount: Money) kind institutional {
    label en official "the 10 percent rate of section 1442(c)(2)(A) applies to the dividend received by a Puerto Rico corporation meeting the section 881(b)(1)(A)-(C) requirements, the rate increase of (c)(2)(B) not having taken effect on or before the date of receipt";
}
pub relation item_is_dividend_for_1442c2(item_id: Text) kind empirical {
    label en unofficial "the item is a dividend, for section 1442(c)(2)";
}
@source(IRC_S1442_C, relation = formalizes, coverage = exact, quote = "subsection (a) shall be applied for such taxable year by substituting \"10 percent\" for \"30 percent\".")
rule S1442C2ARateTenPercentForPuertoRicoCorporationDividend defeasible {
    for agent: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for amount: Money;
    for item_id: Text;
    for y: us.irc.core::TaxableYear;
    for received_on: Date;
    when withholding_agent_pays_item_to_foreign_corp_1442(agent, corp, amount, item_id)
     and foreign_corporation_for_1442(corp)
     and corporation_organized_in_puerto_rico_1442c2(corp)
     and requirements_881b1ABC_met_1442c(corp)
     and item_is_dividend_for_1442c2(item_id)
     and dividend_received_by_pr_corporation_1442c2(corp, y, received_on, amount);
    unless pr_dividend_rate_increase_in_effect_1442c2B(received_on)
     and dividend_received_by_pr_corporation_1442c2(corp, y, received_on, amount)
     and withholding_agent_pays_item_to_foreign_corp_1442(agent, corp, amount, item_id);
    then pr_dividend_ten_percent_rate_applies_1442c2A(agent, corp, item_id, amount);
}
rule S1442C2AWithholdingAtTenPercent defeasible {
    for agent: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for amount: Money;
    for item_id: Text;
    when pr_dividend_ten_percent_rate_applies_1442c2A(agent, corp, item_id, amount);
    then withholding_1442_amount(agent, corp, amount, round(amount * 0.10, 2, "HALF_UP"));
}
@source(IRC_S1442_A, relation = formalizes, coverage = exact, quote = "there shall be deducted and withheld at the source in the same manner and on the same items of income as is provided in section 1441 a tax equal to 30 percent thereof.")
rule S1442AThirtyPercentWithholding defeasible {
    for agent: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for amount: Money;
    for item_id: Text;
    when withholding_agent_pays_item_to_foreign_corp_1442(agent, corp, amount, item_id)
     and foreign_corporation_for_1442(corp);
    unless withholding_1441c_exception_applies(corp, item_id)
     and withholding_agent_pays_item_to_foreign_corp_1442(agent, corp, amount, item_id);
    unless pr_dividend_ten_percent_rate_applies_1442c2A(agent, corp, item_id, amount)
     and withholding_agent_pays_item_to_foreign_corp_1442(agent, corp, amount, item_id);
    then withholding_1442_amount(agent, corp, amount, round(amount * 0.30, 2, "HALF_UP"));
}
rule S1442ADutyToWithhold defeasible {
    for agent: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for amount: Money;
    for tax: Money;
    when withholding_1442_amount(agent, corp, amount, tax);
    then duty S1442WithholdingDuty {
        bearer agent;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition us.irc.core::payment(_, agent, tax, _);
            window [-infinity, infinity];
        }
    };
}
external judgment relation secretary_finds_undue_burden_and_no_jeopardy_1442b(corp: us.irc.core::Corporation) {
    authority Secretary;
    label en official "the Secretary determines that the requirements of subsection (a) impose an undue administrative burden on the foreign corporation engaged in trade or business within the United States and that collection of the section 881 tax will not be jeopardized (section 1442(b)) — committed to the Secretary's determination (DECISION-0194)";
}
pub relation foreign_corporation_withholding_exemption_1442b(corp: us.irc.core::Corporation) kind institutional {
    label en official "section 1442(a) does not apply to the foreign corporation, subject to regulations, on the Secretary's determination";
}
pub relation foreign_corporation_engaged_in_us_business_1442b(corp: us.irc.core::Corporation) kind empirical {
    label en official "a foreign corporation engaged in trade or business within the United States";
}
rule S1442BUndueBurdenExemption defeasible {
    for corp: us.irc.core::Corporation;
    when foreign_corporation_engaged_in_us_business_1442b(corp)
     and secretary_finds_undue_burden_and_no_jeopardy_1442b(corp);
    then foreign_corporation_withholding_exemption_1442b(corp);
}

// --- §1443: foreign tax-exempt organizations --------------------------------

pub relation income_of_foreign_organization_subject_to_511_1443a(org: us.irc.core::Person, item_id: Text, amount: Money) kind empirical {
    label en official "income of a foreign organization subject to the tax imposed by section 511 that is includible under section 512 in computing its unrelated business taxable income";
}
pub relation income_of_foreign_private_foundation_4948a_1443b(org: us.irc.core::Person, item_id: Text, amount: Money) kind empirical {
    label en official "income of a foreign organization subject to the tax imposed by section 4948(a)";
}
pub relation withholding_1443b_amount(agent: us.irc.core::Person, org: us.irc.core::Person, amount: Money, tax: Money) kind institutional {
    label en official "the amount to be deducted and withheld from the income of a foreign organization subject to the section 4948(a) tax: 4 percent, subject to conditions under regulations (section 1443(b))";
}
pub relation withholding_agent_for_1443(agent: us.irc.core::Person, org: us.irc.core::Person, item_id: Text) kind empirical {
    label en unofficial "the person has control, receipt, custody, disposal or payment of the item, for section 1443";
}
@source(IRC_S1443_B, relation = formalizes, coverage = exact, quote = "this chapter shall apply, except that the deduction and withholding shall be at the rate of 4 percent and shall be subject to such conditions as may be provided under regulations prescribed by the Secretary.")
rule S1443BFourPercentWithholding defeasible {
    for agent: us.irc.core::Person;
    for org: us.irc.core::Person;
    for item_id: Text;
    for amount: Money;
    when income_of_foreign_private_foundation_4948a_1443b(org, item_id, amount)
     and withholding_agent_for_1443(agent, org, item_id);
    then withholding_1443b_amount(agent, org, amount, round(amount * 0.04, 2, "HALF_UP"));
}
rule S1443BDutyToWithhold defeasible {
    for agent: us.irc.core::Person;
    for org: us.irc.core::Person;
    for amount: Money;
    for tax: Money;
    when withholding_1443b_amount(agent, org, amount, tax);
    then duty S1443BWithholdingDuty {
        bearer agent;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition us.irc.core::payment(_, agent, tax, _);
            window [-infinity, infinity];
        }
    };
}

// --- §1445(b)(3)-(9): further exemptions from FIRPTA withholding -----------

pub relation domestic_corp_furnishes_affidavit_1445b3(corp: us.irc.core::Corporation) kind empirical {
    label en official "the domestic corporation furnishes the transferee an affidavit, under penalty of perjury, that it is not and has not been a United States real property holding corporation during the applicable period, or that interests in it are not United States real property interests by reason of section 897(c)(1)(B)";
}
pub relation disposition_of_interest_in_domestic_corporation_1445b3(transferee: us.irc.core::Person, transferor: us.irc.core::Person, corp: us.irc.core::Corporation) kind empirical {
    label en official "the disposition is of an interest in the domestic corporation";
}
pub relation transferee_has_actual_knowledge_affidavit_false_1445b7A(transferee: us.irc.core::Person, transferor: us.irc.core::Person) kind empirical {
    label en official "the transferee or qualified substitute has actual knowledge that the affidavit (or the statement referred to in paragraph (9)(A)(ii)) is false";
}
pub relation transferee_received_false_affidavit_notice_1445b7A(transferee: us.irc.core::Person, transferor: us.irc.core::Person) kind empirical {
    label en official "the transferee or qualified substitute receives a notice from a transferor's agent, transferee's agent or qualified substitute that the affidavit or statement is false";
}
pub relation transferee_failed_to_furnish_affidavit_copy_1445b7B(transferee: us.irc.core::Person, transferor: us.irc.core::Person) kind empirical {
    label en official "the Secretary by regulation requires the transferee or qualified substitute to furnish a copy of the affidavit or statement, and it fails to do so at the time and in the manner required";
}
pub relation firpta_affidavit_exemption_defeated_1445b7(transferee: us.irc.core::Person, transferor: us.irc.core::Person) kind institutional {
    label en official "paragraph (2), (3) or (9) does not apply to the disposition: actual knowledge of falsity, notice of falsity, or failure to furnish a required copy (section 1445(b)(7))";
}
@source(IRC_S1445_B, relation = formalizes, coverage = exact, quote = "(i) the transferee or qualified substitute has actual knowledge that the affidavit referred to in such paragraph, or the statement referred to in paragraph (9)(A)(ii), is false, or")
rule S1445B7ActualKnowledgeOfFalsity defeasible {
    for transferee: us.irc.core::Person;
    for transferor: us.irc.core::Person;
    when transferee_has_actual_knowledge_affidavit_false_1445b7A(transferee, transferor);
    then firpta_affidavit_exemption_defeated_1445b7(transferee, transferor);
}
@source(IRC_S1445_B, relation = formalizes, coverage = exact, quote = "(ii) the transferee or qualified substitute receives a notice (as described in subsection (d)) from a transferor's agent, transferee's agent, or qualified substitute that such affidavit or statement is false, or")
rule S1445B7NoticeOfFalsity defeasible {
    for transferee: us.irc.core::Person;
    for transferor: us.irc.core::Person;
    when transferee_received_false_affidavit_notice_1445b7A(transferee, transferor);
    then firpta_affidavit_exemption_defeated_1445b7(transferee, transferor);
}
@source(IRC_S1445_B, relation = formalizes, coverage = partial, quote = "(B) if the Secretary by regulations requires the transferee or qualified substitute to furnish a copy of such affidavit or statement to the Secretary and the transferee or qualified substitute fails to furnish a copy of such affidavit or statement to the Secretary at such time and in such manner as")
rule S1445B7FailureToFurnishCopy defeasible {
    for transferee: us.irc.core::Person;
    for transferor: us.irc.core::Person;
    when transferee_failed_to_furnish_affidavit_copy_1445b7B(transferee, transferor);
    then firpta_affidavit_exemption_defeated_1445b7(transferee, transferor);
}
@source(IRC_S1445_B, relation = formalizes, coverage = partial, quote = "Except as provided in paragraph (7), this paragraph applies in the case of a disposition of any interest in any domestic corporation if the domestic corporation furnishes to the transferee an affidavit by the domestic corporation stating, under penalty of perjury, that—")
rule S1445B3DomesticCorporationAffidavitExemption defeasible {
    for transferee: us.irc.core::Person;
    for transferor: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for amount_realized: Money;
    when usrpi_disposition(transferee, transferor, amount_realized)
     and disposition_of_interest_in_domestic_corporation_1445b3(transferee, transferor, corp)
     and domestic_corp_furnishes_affidavit_1445b3(corp);
    unless firpta_affidavit_exemption_defeated_1445b7(transferee, transferor)
     and usrpi_disposition(transferee, transferor, amount_realized);
    then firpta_1445b_exemption_applies(transferee, transferor, amount_realized);
}
pub relation transferee_receives_qualifying_statement_1445b4(transferee: us.irc.core::Person, transferor: us.irc.core::Person) kind empirical {
    label en official "the transferee receives a qualifying statement from the Secretary (agreement for payment of the tax or exemption of the transferor, and the transferor's unsatisfied withholding liability satisfied or secured), at the time and in the manner the Secretary prescribes";
}
@source(IRC_S1445_B, relation = formalizes, coverage = partial, quote = "This paragraph applies to the disposition if the transferee receives a qualifying statement at such time, in such manner, and subject to such terms and conditions as the Secretary may by regulations prescribe.")
rule S1445B4QualifyingStatementExemption defeasible {
    for transferee: us.irc.core::Person;
    for transferor: us.irc.core::Person;
    for amount_realized: Money;
    when usrpi_disposition(transferee, transferor, amount_realized)
     and transferee_receives_qualifying_statement_1445b4(transferee, transferor);
    then firpta_1445b_exemption_applies(transferee, transferor, amount_realized);
}
pub relation disposition_of_regularly_traded_stock_share_1445b6(transferee: us.irc.core::Person, transferor: us.irc.core::Person) kind empirical {
    label en official "the disposition is of a share of a class of stock that is regularly traded on an established securities market";
}
@source(IRC_S1445_B, relation = formalizes, coverage = exact, quote = "This paragraph applies if the disposition is of a share of a class of stock that is regularly traded on an established securities market.")
rule S1445B6RegularlyTradedStockExemption defeasible {
    for transferee: us.irc.core::Person;
    for transferor: us.irc.core::Person;
    for amount_realized: Money;
    when usrpi_disposition(transferee, transferor, amount_realized)
     and disposition_of_regularly_traded_stock_share_1445b6(transferee, transferor);
    then firpta_1445b_exemption_applies(transferee, transferor, amount_realized);
}
pub relation disposition_treated_as_usrpi_solely_by_897h5_1445b8(transferee: us.irc.core::Person, transferor: us.irc.core::Person) kind empirical {
    label en official "the disposition is treated as a disposition of a United States real property interest solely by reason of section 897(h)(5)";
}
@source(IRC_S1445_B, relation = formalizes, coverage = exact, quote = "No person shall be required to deduct and withhold any amount under subsection (a) with respect to a disposition which is treated as a disposition of a United States real property interest solely by reason of section 897(h)(5).")
rule S1445B8Section897h5Exemption defeasible {
    for transferee: us.irc.core::Person;
    for transferor: us.irc.core::Person;
    for amount_realized: Money;
    when usrpi_disposition(transferee, transferor, amount_realized)
     and disposition_treated_as_usrpi_solely_by_897h5_1445b8(transferee, transferor);
    then firpta_1445b_exemption_applies(transferee, transferor, amount_realized);
}
pub relation affidavit_furnished_to_qualified_substitute_1445b9(transferor: us.irc.core::Person, transferee: us.irc.core::Person) kind empirical {
    label en official "the section 1445(b)(2) affidavit is furnished to a qualified substitute, who furnishes the transferee a statement, under penalty of perjury, that the substitute has the affidavit in his possession";
}
@source(IRC_S1445_B, relation = formalizes, coverage = exact, quote = "Paragraph (2) shall be treated as applying to a transaction if, in connection with a disposition of a United States real property interest—")
rule S1445B9QualifiedSubstituteAffidavit defeasible {
    for transferee: us.irc.core::Person;
    for transferor: us.irc.core::Person;
    for amount_realized: Money;
    when usrpi_disposition(transferee, transferor, amount_realized)
     and affidavit_furnished_to_qualified_substitute_1445b9(transferor, transferee);
    unless firpta_affidavit_exemption_defeated_1445b7(transferee, transferor)
     and usrpi_disposition(transferee, transferor, amount_realized);
    then firpta_1445b_exemption_applies(transferee, transferor, amount_realized);
}

// --- §1445(d): notice by agents; agent's fallback withholding duty -----------

pub relation agent_of_transaction_1445d(agent: us.irc.core::Person, transferee: us.irc.core::Person, transferor: us.irc.core::Person, kind: Text) kind empirical {
    label en official "the person is a transferor's agent (represents the transferor in negotiation with the transferee or in settling) or a transferee's agent or qualified substitute (section 1445(f)(6), (d)(3)-(4)); kind is `transferor_agent`, `transferee_agent` or `qualified_substitute`; a person who merely receives and disburses consideration or records a document is not an agent (section 1445(d)(5))";
}
pub relation agent_has_actual_knowledge_affidavit_false_1445d1B(agent: us.irc.core::Person, transferee: us.irc.core::Person, transferor: us.irc.core::Person) kind empirical {
    label en official "the agent has actual knowledge that the affidavit furnished is false (section 1445(d)(1)(B)(i)(I), (ii))";
}
pub relation affidavit_by_foreign_corporation_1445d1BiII(agent: us.irc.core::Person, transferee: us.irc.core::Person, transferor: us.irc.core::Person) kind empirical {
    label en official "in the case of a transferor's agent, the section 1445(b)(2) affidavit was furnished by a corporation that is a foreign corporation (section 1445(d)(1)(B)(i)(II))";
}
pub relation affidavit_of_1445b_furnished_1445d1A(transferor: us.irc.core::Person, transferee: us.irc.core::Person) kind empirical {
    label en official "the transferor furnished the transferee or qualified substitute an affidavit described in section 1445(b)(2), or a domestic corporation furnished the transferee an affidavit described in (b)(3)";
}
pub relation agent_required_to_notify_transferee_1445d1(agent: us.irc.core::Person, transferee: us.irc.core::Person, transferor: us.irc.core::Person) kind institutional {
    label en official "the agent or qualified substitute is required to notify the transferee at the time and in the manner the Secretary requires by regulation (section 1445(d)(1))";
}
@source(IRC_S1445_D, relation = formalizes, coverage = exact, quote = "such agent or qualified substitute shall so notify the transferee at such time and in such manner as the Secretary shall require by regulations.")
rule S1445D1NoticeRequiredOnActualKnowledge defeasible {
    for agent: us.irc.core::Person;
    for transferee: us.irc.core::Person;
    for transferor: us.irc.core::Person;
    when affidavit_of_1445b_furnished_1445d1A(transferor, transferee)
     and agent_has_actual_knowledge_affidavit_false_1445d1B(agent, transferee, transferor);
    then agent_required_to_notify_transferee_1445d1(agent, transferee, transferor);
}
@source(IRC_S1445_D, relation = formalizes, coverage = partial, quote = "(I) such agent has actual knowledge that such affidavit is false, or")
rule S1445D1TransferorAgentForeignCorporationAffidavit defeasible {
    for agent: us.irc.core::Person;
    for transferee: us.irc.core::Person;
    for transferor: us.irc.core::Person;
    when affidavit_of_1445b_furnished_1445d1A(transferor, transferee)
     and agent_of_transaction_1445d(agent, transferee, transferor, "transferor_agent")
     and affidavit_by_foreign_corporation_1445d1BiII(agent, transferee, transferor);
    then agent_required_to_notify_transferee_1445d1(agent, transferee, transferor);
}
pub relation agent_notified_transferee_1445d1(agent: us.irc.core::Person, transferee: us.irc.core::Person, transferor: us.irc.core::Person) kind empirical {
    label en official "the agent notified the transferee at the time and in the manner required by regulation";
}
@source(IRC_S1445_D, relation = formalizes, coverage = exact, quote = "such agent or qualified substitute shall so notify the transferee at such time and in such manner as the Secretary shall require by regulations.")
rule S1445D1DutyToNotifyTransferee defeasible {
    for agent: us.irc.core::Person;
    for transferee: us.irc.core::Person;
    for transferor: us.irc.core::Person;
    when agent_required_to_notify_transferee_1445d1(agent, transferee, transferor);
    then duty S1445D1NotifyTransfereeDuty {
        bearer agent;
        beneficiary transferee;
        goal achievement {
            condition agent_notified_transferee_1445d1(agent, transferee, transferor);
            window [-infinity, infinity];
        }
    };
}
pub relation agent_failed_to_notify_1445d2A(agent: us.irc.core::Person, transferee: us.irc.core::Person, transferor: us.irc.core::Person) kind empirical {
    label en official "the agent or substitute is required by paragraph (1) to furnish notice but fails to do so at the time and in the manner required";
}
pub relation agent_compensation_from_transaction_1445d2B(agent: us.irc.core::Person, transferee: us.irc.core::Person, transferor: us.irc.core::Person, amount: Money) kind empirical {
    label en official "the compensation the agent or substitute derives from the transaction";
}
pub relation agent_withholding_liability_1445d2(agent: us.irc.core::Person, transferee: us.irc.core::Person, transferor: us.irc.core::Person, amount: Money) kind institutional {
    label en official "the agent's liability for the amount of withholding the transferee should have made, limited to the compensation the agent derives from the transaction (section 1445(d)(2)(A)-(B))";
}
@source(IRC_S1445_D, relation = formalizes, coverage = exact, quote = "An agent's or substitute's liability under subparagraph (A) shall be limited to the amount of compensation the agent or substitute derives from the transaction.")
rule S1445D2AgentWithholdingLiabilityLimitedToCompensation defeasible {
    for agent: us.irc.core::Person;
    for transferee: us.irc.core::Person;
    for transferor: us.irc.core::Person;
    for amount_realized: Money;
    for tax: Money;
    for compensation: Money;
    when agent_failed_to_notify_1445d2A(agent, transferee, transferor)
     and usrpi_disposition(transferee, transferor, amount_realized)
     and firpta_withholding_amount(transferee, transferor, amount_realized, tax)
     and agent_compensation_from_transaction_1445d2B(agent, transferee, transferor, compensation);
    then agent_withholding_liability_1445d2(agent, transferee, transferor, min(tax, compensation));
}
rule S1445D2DutyToWithholdSameAsTransferee defeasible {
    for agent: us.irc.core::Person;
    for transferee: us.irc.core::Person;
    for transferor: us.irc.core::Person;
    for amount: Money;
    when agent_withholding_liability_1445d2(agent, transferee, transferor, amount);
    then duty S1445D2AgentWithholdingDuty {
        bearer agent;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition us.irc.core::payment(_, agent, amount, _);
            window [-infinity, infinity];
        }
    };
}

// --- §1445(f): definitions ---------------------------------------------------

pub relation transferor_1445f1(p: us.irc.core::Person, usrpi: Text) kind empirical {
    label en official "the person disposing of the United States real property interest";
}
pub relation transferee_1445f2(p: us.irc.core::Person, usrpi: Text) kind empirical {
    label en official "the person acquiring the United States real property interest";
}
pub relation entity_not_subject_to_897_by_897l_1445f3B(p: us.irc.core::Person) kind empirical {
    label en official "an entity with respect to which section 897 does not apply by reason of subsection (l) thereof (and the Secretary has not otherwise provided)";
}
pub relation foreign_person_1445f3(p: us.irc.core::Person) kind institutional {
    label en official "any person other than a United States person and, except as the Secretary provides, an entity to which section 897 does not apply by reason of section 897(l) (section 1445(f)(3))";
}
pub relation person_considered_for_1445f3(p: us.irc.core::Person) kind empirical {
    label en unofficial "the person whose foreign-person status is tested (a domain anchor)";
}
@source(IRC_S1445_F, relation = formalizes, coverage = exact, quote = "The term \"foreign person\" means any person other than—")
rule S1445F3ForeignPerson defeasible {
    for p: us.irc.core::Person;
    when person_considered_for_1445f3(p)
     and not_known(us.irc.definitions::united_states_person(p));
    unless entity_not_subject_to_897_by_897l_1445f3B(p)
     and person_considered_for_1445f3(p);
    then foreign_person_1445f3(p);
}
pub relation max_tax_under_871b1_or_882a1_1445f4A(transferor: us.irc.core::Person, amount_realized: Money, amount: Money) kind empirical {
    label en official "the maximum amount the Secretary determines could be imposed as tax under section 871(b)(1) or 882(a)(1) by reason of the disposition";
}
pub relation unsatisfied_withholding_liability_1445f4B(transferor: us.irc.core::Person, amount: Money) kind empirical {
    label en official "the withholding obligation imposed by section 1445 on the transferor's acquisition of the interest (or a predecessor interest), to the extent not satisfied (section 1445(f)(5)), as the Secretary determines";
}
pub relation transferor_maximum_tax_liability_computed_1445f4(transferor: us.irc.core::Person, amount_realized: Money, amount: Money) kind institutional {
    label en official "the transferor's maximum tax liability: the sum of the maximum section 871(b)(1)/882(a)(1) tax and the unsatisfied withholding liability (section 1445(f)(4)); module 07 reads the corresponding case fact directly";
}
@source(IRC_S1445_F, relation = formalizes, coverage = exact, quote = "The term \"transferor's maximum tax liability\" means, with respect to the disposition of any interest, the sum of—")
rule S1445F4MaximumTaxLiabilitySum defeasible {
    for transferor: us.irc.core::Person;
    for amount_realized: Money;
    for max_tax: Money;
    for unsatisfied: Money;
    when max_tax_under_871b1_or_882a1_1445f4A(transferor, amount_realized, max_tax)
     and unsatisfied_withholding_liability_1445f4B(transferor, unsatisfied);
    then transferor_maximum_tax_liability_computed_1445f4(transferor, amount_realized, max_tax + unsatisfied);
}
pub relation person_responsible_for_closing_1445f6A(p: us.irc.core::Person, transferee: us.irc.core::Person, transferor: us.irc.core::Person) kind empirical {
    label en official "the person (including any attorney or title company) responsible for closing the transaction, other than the transferor's agent";
}
pub relation qualified_substitute_1445f6(p: us.irc.core::Person, transferee: us.irc.core::Person, transferor: us.irc.core::Person) kind institutional {
    label en official "a qualified substitute: the person responsible for closing the transaction other than the transferor's agent, or the transferee's agent (section 1445(f)(6))";
}
@source(IRC_S1445_F, relation = formalizes, coverage = exact, quote = "(A) the person (including any attorney or title company) responsible for closing the transaction, other than the transferor's agent, and")
rule S1445F6AResponsibleForClosing defeasible {
    for p: us.irc.core::Person;
    for transferee: us.irc.core::Person;
    for transferor: us.irc.core::Person;
    when person_responsible_for_closing_1445f6A(p, transferee, transferor);
    unless agent_of_transaction_1445d(p, transferee, transferor, "transferor_agent")
     and person_responsible_for_closing_1445f6A(p, transferee, transferor);
    then qualified_substitute_1445f6(p, transferee, transferor);
}
@source(IRC_S1445_F, relation = formalizes, coverage = exact, quote = "(B) the transferee's agent.")
rule S1445F6BTransfereeAgent defeasible {
    for p: us.irc.core::Person;
    for transferee: us.irc.core::Person;
    for transferor: us.irc.core::Person;
    when agent_of_transaction_1445d(p, transferee, transferor, "transferee_agent");
    then qualified_substitute_1445f6(p, transferee, transferor);
}

// --- §1461-§1464: liability, return inclusion, failure to withhold, refunds --

pub relation withholding_agent_required_to_withhold_1461(agent: us.irc.core::Person, payee: us.irc.core::Person, tax: Money) kind empirical {
    label en official "the person is required to deduct and withhold tax under chapter 3 (or chapter 4, section 1474(a)) from a payment to the payee";
}
pub relation agent_liable_for_withheld_tax_1461(agent: us.irc.core::Person, tax: Money) kind institutional {
    label en official "every person required to deduct and withhold any tax under this chapter is made liable for such tax (section 1461)";
}
@source(IRC_S1461, relation = formalizes, coverage = exact, quote = "Every person required to deduct and withhold any tax under this chapter is hereby made liable for such tax")
rule S1461LiabilityOfWithholdingAgent defeasible {
    for agent: us.irc.core::Person;
    for payee: us.irc.core::Person;
    for tax: Money;
    when withholding_agent_required_to_withhold_1461(agent, payee, tax);
    then agent_liable_for_withheld_tax_1461(agent, tax);
}
pub relation payee_claim_against_agent_for_payment_withheld_1461(payee: us.irc.core::Person, agent: us.irc.core::Person, amount: Money) kind institutional {
    label en official "a claim or demand of a person against the withholding agent for the amount of a payment made in accordance with chapter 3 (protected against by the indemnity of section 1461)";
}
pub relation payment_made_in_accordance_with_chapter_3_1461(agent: us.irc.core::Person, payee: us.irc.core::Person, amount: Money) kind empirical {
    label en official "the withholding agent has made the payment in accordance with the provisions of chapter 3";
}
@source(IRC_S1461, relation = formalizes, coverage = exact, quote = "and is hereby indemnified against the claims and demands of any person for the amount of any payments made in accordance with the provisions of this chapter.")
rule S1461IndemnityImmunity strict {
    for agent: us.irc.core::Person;
    for payee: us.irc.core::Person;
    for amount: Money;
    when payment_made_in_accordance_with_chapter_3_1461(agent, payee, amount);
    then immunity S1461AgentIndemnityImmunity {
        holder agent;
        protected_effect payee_claim_against_agent_for_payment_withheld_1461(payee, agent, amount);
        window [-infinity, infinity];
    };
}
pub relation withheld_tax_income_of_recipient_1462(recipient: us.irc.core::Person, y: us.irc.core::TaxableYear, income: Money, tax_withheld: Money) kind empirical {
    label en official "income on which tax is required to be withheld at the source under chapter 3, and the amount so withheld";
}
pub relation income_included_in_recipient_return_1462(recipient: us.irc.core::Person, y: us.irc.core::TaxableYear, income: Money) kind institutional {
    label en official "income on which tax was required to be withheld is included in the return of the recipient (section 1462)";
}
pub relation withholding_credited_against_income_tax_1462(recipient: us.irc.core::Person, y: us.irc.core::TaxableYear, credit: Money) kind institutional {
    label en official "the amount of tax withheld is credited against the amount of income tax as computed in the return (section 1462)";
}
@source(IRC_S1462, relation = formalizes, coverage = exact, quote = "Income on which any tax is required to be withheld at the source under this chapter shall be included in the return of the recipient of such income, but any amount of tax so withheld shall be credited against the amount of income tax as computed in such return.")
rule S1462IncludeIncomeAndCreditWithheldTax defeasible {
    for recipient: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for income: Money;
    for tax: Money;
    when withheld_tax_income_of_recipient_1462(recipient, y, income, tax);
    then income_included_in_recipient_return_1462(recipient, y, income);
}
@source(IRC_S1462, relation = formalizes, coverage = exact, quote = "Income on which any tax is required to be withheld at the source under this chapter shall be included in the return of the recipient of such income, but any amount of tax so withheld shall be credited against the amount of income tax as computed in such return.")
rule S1462CreditForWithheldTax defeasible {
    for recipient: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for income: Money;
    for tax: Money;
    when withheld_tax_income_of_recipient_1462(recipient, y, income, tax);
    then withholding_credited_against_income_tax_1462(recipient, y, tax);
}
pub relation agent_failed_to_withhold_in_violation_1463(agent: us.irc.core::Person, payee: us.irc.core::Person, tax: Money) kind empirical {
    label en official "the person, in violation of chapter 3, fails to deduct and withhold tax";
}
pub relation credit_tax_thereafter_paid_1463(payee: us.irc.core::Person, tax: Money) kind empirical {
    label en official "the tax against which the withheld tax may be credited is thereafter paid";
}
pub relation withholding_not_collected_from_agent_1463(agent: us.irc.core::Person, payee: us.irc.core::Person, tax: Money) kind institutional {
    label en official "the tax required to be withheld is not collected from the person who failed to withhold; interest and penalties for the failure remain (section 1463)";
}
@source(IRC_S1463, relation = formalizes, coverage = exact, quote = "the tax so required to be deducted and withheld shall not be collected from such person; but this section shall in no case relieve such person from liability for interest or any penalties or additions to the tax otherwise applicable in respect of such failure to deduct and withhold.")
rule S1463TaxNotCollectedIfCreditTaxPaid defeasible {
    for agent: us.irc.core::Person;
    for payee: us.irc.core::Person;
    for tax: Money;
    when agent_failed_to_withhold_in_violation_1463(agent, payee, tax)
     and credit_tax_thereafter_paid_1463(payee, tax);
    then withholding_not_collected_from_agent_1463(agent, payee, tax);
}
pub relation overpayment_of_withholding_tax_1464(payee: us.irc.core::Person, agent: us.irc.core::Person, amount: Money) kind empirical {
    label en official "an overpayment of tax under chapter 3, refundable or creditable under chapter 65";
}
pub relation amount_actually_withheld_by_agent_1464(agent: us.irc.core::Person, payee: us.irc.core::Person, amount: Money) kind empirical {
    label en official "the amount of the tax actually withheld by the withholding agent";
}
pub relation refund_payable_to_1464(agent: us.irc.core::Person, payee: us.irc.core::Person, amount: Money) kind institutional {
    label en official "the refund or credit is made to the withholding agent unless the amount of the tax was actually withheld by the agent (section 1464): here the refund payable to the agent for the overpaid tax the agent did not actually withhold";
}
@source(IRC_S1464, relation = formalizes, coverage = exact, quote = "any refund or credit made under chapter 65 shall be made to the withholding agent unless the amount of such tax was actually withheld by the withholding agent.")
rule S1464RefundToAgentWhereNotActuallyWithheld defeasible {
    for agent: us.irc.core::Person;
    for payee: us.irc.core::Person;
    for amount: Money;
    when overpayment_of_withholding_tax_1464(payee, agent, amount);
    unless amount_actually_withheld_by_agent_1464(agent, payee, _)
     and overpayment_of_withholding_tax_1464(payee, agent, amount);
    then refund_payable_to_1464(agent, payee, amount);
}
pub relation refund_payable_to_payee_1464(payee: us.irc.core::Person, agent: us.irc.core::Person, amount: Money) kind institutional {
    label en official "the refund or credit is made to the payee: the overpaid tax was actually withheld by the withholding agent (section 1464, converse)";
}
rule S1464RefundToPayeeWhereActuallyWithheld defeasible {
    for agent: us.irc.core::Person;
    for payee: us.irc.core::Person;
    for amount: Money;
    when overpayment_of_withholding_tax_1464(payee, agent, amount)
     and amount_actually_withheld_by_agent_1464(agent, payee, _);
    then refund_payable_to_payee_1464(payee, agent, amount);
}

// --- §1471(b)-(f): the FFI agreement, reporting, definitions ----------------

pub relation ffi_agreement_terms_1471b1(ffi: us.irc.core::Person) kind institutional {
    label en official "an agreement is in effect between the foreign financial institution and the Secretary under which the institution takes on the section 1471(b)(1)(A)-(F) obligations";
}
rule S1471B1AgreementTermsFromAgreementInEffect defeasible {
    for ffi: us.irc.core::Person;
    when ffi_agreement_in_effect(ffi);
    then ffi_agreement_terms_1471b1(ffi);
}
pub relation ffi_obtained_account_holder_information_1471b1A(ffi: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the institution obtained the information regarding each account holder necessary to determine which accounts are United States accounts";
}
pub relation ffi_complied_with_verification_procedures_1471b1B(ffi: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the institution complied with the verification and due diligence procedures the Secretary requires to identify United States accounts";
}
pub relation ffi_reported_us_account_information_1471b1C(ffi: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the institution reported on an annual basis the section 1471(c) information for each United States account";
}
pub relation ffi_complied_with_secretary_requests_1471b1E(ffi: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the institution complied with the Secretary's requests for additional information regarding any United States account";
}
pub relation taxable_year_of_ffi_agreement(ffi: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en unofficial "the year of the agreement's operation for which the duty is tested (a domain anchor)";
}
@source(IRC_S1471_B, relation = formalizes, coverage = exact, quote = "(A) to obtain such information regarding each holder of each account maintained by such institution as is necessary to determine which (if any) of such accounts are United States accounts,")
rule S1471B1ADutyObtainAccountHolderInformation defeasible {
    for ffi: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when ffi_agreement_terms_1471b1(ffi)
     and taxable_year_of_ffi_agreement(ffi, y);
    then duty S1471B1AObtainInformationDuty {
        bearer ffi;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition ffi_obtained_account_holder_information_1471b1A(ffi, y);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S1471_B, relation = formalizes, coverage = exact, quote = "(B) to comply with such verification and due diligence procedures as the Secretary may require with respect to the identification of United States accounts,")
rule S1471B1BDutyComplyWithVerificationProcedures defeasible {
    for ffi: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when ffi_agreement_terms_1471b1(ffi)
     and taxable_year_of_ffi_agreement(ffi, y);
    then duty S1471B1BVerificationDuty {
        bearer ffi;
        beneficiary us.irc.core::IRS;
        goal maintenance {
            condition ffi_complied_with_verification_procedures_1471b1B(ffi, y);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S1471_B, relation = formalizes, coverage = exact, quote = "(C) in the case of any United States account maintained by such institution, to report on an annual basis the information described in subsection (c) with respect to such account,")
rule S1471B1CDutyReportAnnually defeasible {
    for ffi: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when ffi_agreement_terms_1471b1(ffi)
     and taxable_year_of_ffi_agreement(ffi, y);
    then duty S1471B1CAnnualReportDuty {
        bearer ffi;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition ffi_reported_us_account_information_1471b1C(ffi, y);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S1471_B, relation = formalizes, coverage = exact, quote = "(E) to comply with requests by the Secretary for additional information with respect to any United States account maintained by such institution, and")
rule S1471B1EDutyComplyWithSecretaryRequests defeasible {
    for ffi: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when ffi_agreement_terms_1471b1(ffi)
     and taxable_year_of_ffi_agreement(ffi, y);
    then duty S1471B1ERequestsDuty {
        bearer ffi;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition ffi_complied_with_secretary_requests_1471b1E(ffi, y);
            window [-infinity, infinity];
        }
    };
}
// (D): withhold 30 percent of any passthru payment made to a recalcitrant
// account holder or to a non-participating foreign financial institution.
pub relation passthru_payment_by_ffi_1471b1D(ffi: us.irc.core::Person, recipient: us.irc.core::Person, amount: Money) kind empirical {
    label en official "a passthru payment made by the institution to a recalcitrant account holder or to another foreign financial institution that does not meet the section 1471(b) requirements";
}
pub relation recipient_recalcitrant_or_nonparticipating_1471b1D(recipient: us.irc.core::Person) kind empirical {
    label en official "the recipient is a recalcitrant account holder (section 1471(d)(6)) or a foreign financial institution that does not meet the requirements of section 1471(b)";
}
pub relation ffi_has_election_1471b3(ffi: us.irc.core::Person) kind empirical {
    label en official "the institution elected the application of section 1471(b)(3), so that the (b)(1)(D) withholding requirement does not apply to it";
}
pub relation ffi_passthru_withholding_amount_1471b1D(ffi: us.irc.core::Person, recipient: us.irc.core::Person, amount: Money, tax: Money) kind institutional {
    label en official "the tax the institution must deduct and withhold under its agreement: 30 percent of the passthru payment (section 1471(b)(1)(D))";
}
@source(IRC_S1471_B, relation = formalizes, coverage = partial, quote = "(D) to deduct and withhold a tax equal to 30 percent of—")
rule S1471B1DPassthruWithholdingAmount defeasible {
    for ffi: us.irc.core::Person;
    for recipient: us.irc.core::Person;
    for amount: Money;
    when ffi_agreement_terms_1471b1(ffi)
     and passthru_payment_by_ffi_1471b1D(ffi, recipient, amount)
     and recipient_recalcitrant_or_nonparticipating_1471b1D(recipient);
    unless ffi_has_election_1471b3(ffi)
     and ffi_agreement_terms_1471b1(ffi)
     and passthru_payment_by_ffi_1471b1D(ffi, recipient, amount);
    then ffi_passthru_withholding_amount_1471b1D(ffi, recipient, amount, round(amount * 0.30, 2, "HALF_UP"));
}
rule S1471B1DDutyToWithholdOnPassthru defeasible {
    for ffi: us.irc.core::Person;
    for recipient: us.irc.core::Person;
    for amount: Money;
    for tax: Money;
    when ffi_passthru_withholding_amount_1471b1D(ffi, recipient, amount, tax);
    then duty S1471B1DPassthruWithholdingDuty {
        bearer ffi;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition us.irc.core::payment(_, ffi, tax, _);
            window [-infinity, infinity];
        }
    };
}
// (F): where foreign law would prevent reporting, seek a waiver from each
// holder; if not obtained within a reasonable period, close the account.
pub relation foreign_law_prevents_reporting_1471b1F(ffi: us.irc.core::Person, account: Text) kind empirical {
    label en official "a foreign law would (but for a waiver) prevent the reporting of information regarding the United States account";
}
pub relation waiver_not_obtained_within_reasonable_period_1471b1F(ffi: us.irc.core::Person, account: Text) kind empirical {
    label en official "a valid and effective waiver of the foreign law is not obtained from each holder of the account within a reasonable period of time";
}
pub relation ffi_closed_account_1471b1F(ffi: us.irc.core::Person, account: Text) kind empirical {
    label en official "the institution closed the account";
}
pub relation ffi_attempted_to_obtain_waiver_1471b1Fi(ffi: us.irc.core::Person, account: Text) kind empirical {
    label en official "the institution attempted to obtain a valid and effective waiver from each holder of the account";
}
@source(IRC_S1471_B, relation = formalizes, coverage = exact, quote = "(i) to attempt to obtain a valid and effective waiver of such law from each holder of such account, and")
rule S1471B1FiDutyAttemptToObtainWaiver defeasible {
    for ffi: us.irc.core::Person;
    for account: Text;
    when ffi_agreement_terms_1471b1(ffi)
     and foreign_law_prevents_reporting_1471b1F(ffi, account);
    then duty S1471B1FiWaiverDuty {
        bearer ffi;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition ffi_attempted_to_obtain_waiver_1471b1Fi(ffi, account);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S1471_B, relation = formalizes, coverage = exact, quote = "(ii) if a waiver described in clause (i) is not obtained from each such holder within a reasonable period of time, to close such account.")
rule S1471B1FiiDutyCloseAccount defeasible {
    for ffi: us.irc.core::Person;
    for account: Text;
    when ffi_agreement_terms_1471b1(ffi)
     and foreign_law_prevents_reporting_1471b1F(ffi, account)
     and waiver_not_obtained_within_reasonable_period_1471b1F(ffi, account);
    then duty S1471B1FiiCloseAccountDuty {
        bearer ffi;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition ffi_closed_account_1471b1F(ffi, account);
            window [-infinity, infinity];
        }
    };
}
// (b)(1) last sentence: termination of the agreement by the Secretary.
pub relation ffi_out_of_compliance_determined_1471b1(ffi: us.irc.core::Person) kind empirical {
    label en official "the Secretary determines that the foreign financial institution is out of compliance with the agreement";
}
pub relation ffi_agreement_terminated_1471b1(ffi: us.irc.core::Person) kind institutional {
    label en official "the agreement is terminated by the Secretary";
}
@source(IRC_S1471_B, relation = formalizes, coverage = exact, quote = "Any agreement entered into under this subsection may be terminated by the Secretary upon a determination by the Secretary that the foreign financial institution is out of compliance with such agreement.")
rule S1471B1TerminationPower strict {
    for ffi: us.irc.core::Person;
    when ffi_out_of_compliance_determined_1471b1(ffi);
    then power S1471B1TerminateAgreementPower {
        holder Secretary;
        over ffi;
        exercise ffi_out_of_compliance_determined_1471b1(ffi);
        valid_when ffi_agreement_in_effect(ffi);
        effect create(ffi_agreement_terminated_1471b1(ffi));
    };
}
// (b)(2): deemed-compliance.
pub relation ffi_complies_with_no_us_accounts_procedures_1471b2A(ffi: us.irc.core::Person) kind empirical {
    label en official "the institution complies with procedures the Secretary prescribes to ensure that it does not maintain United States accounts, and meets other requirements prescribed for accounts of other foreign financial institutions";
}
pub relation ffi_member_of_class_exempt_1471b2B(ffi: us.irc.core::Person) kind empirical {
    label en official "the institution is a member of a class of institutions for which the Secretary has determined that the application of section 1471 is not necessary";
}
pub relation secretary_treats_ffi_as_meeting_1471b(ffi: us.irc.core::Person) kind institutional {
    label en official "the foreign financial institution may be treated by the Secretary as meeting the requirements of section 1471(b) (deemed-compliant) (section 1471(b)(2))";
}
@source(IRC_S1471_B, relation = formalizes, coverage = partial, quote = "A foreign financial institution may be treated by the Secretary as meeting the requirements of this subsection if—")
rule S1471B2ADeemedCompliantNoUsAccounts defeasible {
    for ffi: us.irc.core::Person;
    when ffi_complies_with_no_us_accounts_procedures_1471b2A(ffi);
    then secretary_treats_ffi_as_meeting_1471b(ffi);
}
@source(IRC_S1471_B, relation = formalizes, coverage = partial, quote = "(B) such institution is a member of a class of institutions with respect to which the Secretary has determined that the application of this section is not necessary to carry out the purposes of this section.")
rule S1471B2BDeemedCompliantClass defeasible {
    for ffi: us.irc.core::Person;
    when ffi_member_of_class_exempt_1471b2B(ffi);
    then secretary_treats_ffi_as_meeting_1471b(ffi);
}
// (d): definitions — United States account, depository-account exception,
// financial institution.
pub relation financial_account_held_by_specified_us_person_or_us_owned_entity_1471d1A(account: Text) kind empirical {
    label en official "the financial account is held by one or more specified United States persons or United States owned foreign entities";
}
pub relation depository_account_all_holders_natural_persons_1471d1B(account: Text) kind empirical {
    label en official "the account is a depository account each holder of which is a natural person";
}
pub relation holder_aggregate_depository_value_1471d1B(account: Text, aggregate: Money) kind empirical {
    label en official "the maximum, over the holders, of the aggregate value of all depository accounts held (in whole or part) by the holder and maintained by the same financial institution (expanded affiliated group members counted as one, to the extent the Secretary provides)";
}
pub relation ffi_elects_not_to_apply_depository_exception_1471d1B(account: Text) kind empirical {
    label en official "the foreign financial institution elects not to have the small depository account exclusion apply";
}
pub relation account_held_by_participating_ffi_or_duplicatively_reported_1471d1C(account: Text) kind empirical {
    label en official "the account is held by another financial institution that meets the requirements of subsection (b), or the holder is otherwise subject to information reporting the Secretary determines would make the reporting duplicative";
}
pub relation united_states_account_1471d1(account: Text) kind institutional {
    label en official "a `United States account`: a financial account held by one or more specified United States persons or United States owned foreign entities, excluding small natural-person depository accounts ($50,000 or less in aggregate, unless the institution elects otherwise) and accounts of participating institutions or duplicatively reported holders (section 1471(d)(1))";
}
@source(IRC_S1471_D, relation = formalizes, coverage = exact, quote = "The term \"United States account\" means any financial account which is held by one or more specified United States persons or United States owned foreign entities.")
rule S1471D1AUnitedStatesAccount defeasible {
    for account: Text;
    when financial_account_held_by_specified_us_person_or_us_owned_entity_1471d1A(account);
    unless small_natural_person_depository_account_1471d1B(account)
     and financial_account_held_by_specified_us_person_or_us_owned_entity_1471d1A(account);
    unless account_held_by_participating_ffi_or_duplicatively_reported_1471d1C(account)
     and financial_account_held_by_specified_us_person_or_us_owned_entity_1471d1A(account);
    then united_states_account_1471d1(account);
}
pub relation small_natural_person_depository_account_1471d1B(account: Text) kind institutional {
    label en official "the depository account of natural persons whose aggregate value of all depository accounts at the same institution does not exceed $50,000, unless the institution elects otherwise (section 1471(d)(1)(B))";
}
@source(IRC_S1471_D, relation = formalizes, coverage = exact, quote = "(ii) with respect to each holder of such account, the aggregate value of all depository accounts held (in whole or in part) by such holder and maintained by the same financial institution which maintains such account does not exceed $50,000.")
rule S1471D1BSmallDepositoryAccountExcluded defeasible {
    for account: Text;
    for aggregate: Money;
    when depository_account_all_holders_natural_persons_1471d1B(account)
     and holder_aggregate_depository_value_1471d1B(account, aggregate)
     and aggregate <= 50000.00 USD;
    unless ffi_elects_not_to_apply_depository_exception_1471d1B(account)
     and depository_account_all_holders_natural_persons_1471d1B(account)
     and holder_aggregate_depository_value_1471d1B(account, aggregate);
    then small_natural_person_depository_account_1471d1B(account);
}
pub relation entity_accepts_deposits_in_banking_business_1471d5A(ent: us.irc.core::Person) kind empirical {
    label en official "the entity accepts deposits in the ordinary course of a banking or similar business";
}
pub relation entity_holds_financial_assets_for_others_substantially_1471d5B(ent: us.irc.core::Person) kind empirical {
    label en official "as a substantial portion of its business, the entity holds financial assets for the account of others";
}
pub relation entity_primarily_investing_or_trading_1471d5C(ent: us.irc.core::Person) kind empirical {
    label en official "the entity is engaged (or holds itself out as engaged) primarily in investing, reinvesting or trading in securities, partnership interests, commodities or any interest in them";
}
pub relation financial_institution_1471d5(ent: us.irc.core::Person) kind institutional {
    label en official "a `financial institution`: an entity that accepts deposits in a banking business, holds financial assets for others as a substantial portion of its business, or is primarily engaged in investing or trading in securities (section 1471(d)(5))";
}
@source(IRC_S1471_D, relation = formalizes, coverage = partial, quote = "(A) accepts deposits in the ordinary course of a banking or similar business,")
rule S1471D5AFinancialInstitutionDeposits defeasible {
    for e: us.irc.core::Person;
    when entity_accepts_deposits_in_banking_business_1471d5A(e);
    then financial_institution_1471d5(e);
}
@source(IRC_S1471_D, relation = formalizes, coverage = partial, quote = "(B) as a substantial portion of its business, holds financial assets for the account of others, or")
rule S1471D5BFinancialInstitutionCustody defeasible {
    for e: us.irc.core::Person;
    when entity_holds_financial_assets_for_others_substantially_1471d5B(e);
    then financial_institution_1471d5(e);
}
rule S1471D5CFinancialInstitutionInvesting defeasible {
    for e: us.irc.core::Person;
    when entity_primarily_investing_or_trading_1471d5C(e);
    then financial_institution_1471d5(e);
}
pub relation foreign_entity_1473_5(ent: us.irc.core::Person) kind institutional {
    label en official "a foreign entity: any entity which is not a United States person (section 1473(5))";
}
pub relation entity_considered_1473_5(ent: us.irc.core::Person) kind empirical {
    label en unofficial "the entity whose foreign-entity status is tested (a domain anchor)";
}
@source(IRC_S1473, relation = formalizes, coverage = exact, quote = "The term \"foreign entity\" means any entity which is not a United States person.")
rule S1473N5ForeignEntity defeasible {
    for e: us.irc.core::Person;
    when entity_considered_1473_5(e)
     and not_known(us.irc.definitions::united_states_person(e));
    then foreign_entity_1473_5(e);
}
pub relation foreign_financial_institution_1471d4(ent: us.irc.core::Person) kind institutional {
    label en official "a foreign financial institution: a financial institution which is a foreign entity, other than (unless the Secretary provides otherwise) one organized under the laws of a possession of the United States (section 1471(d)(4))";
}
pub relation organized_under_possession_law_1471d4(ent: us.irc.core::Person) kind empirical {
    label en official "the institution is organized under the laws of a possession of the United States";
}
@source(IRC_S1471_D, relation = formalizes, coverage = exact, quote = "The term \"foreign financial institution\" means any financial institution which is a foreign entity.")
rule S1471D4ForeignFinancialInstitution defeasible {
    for e: us.irc.core::Person;
    when financial_institution_1471d5(e)
     and foreign_entity_1473_5(e);
    unless organized_under_possession_law_1471d4(e)
     and financial_institution_1471d5(e)
     and foreign_entity_1473_5(e);
    then foreign_financial_institution_1471d4(e);
}
pub relation account_holder_fails_information_request_1471d6A(holder: us.irc.core::Person) kind empirical {
    label en official "the account holder fails to comply with reasonable requests for the information referred to in section 1471(b)(1)(A) or (c)(1)(A)";
}
pub relation account_holder_fails_to_provide_waiver_1471d6B(holder: us.irc.core::Person) kind empirical {
    label en official "the account holder fails to provide a waiver described in section 1471(b)(1)(F) upon request";
}
pub relation recalcitrant_account_holder_1471d6(holder: us.irc.core::Person) kind institutional {
    label en official "a recalcitrant account holder: one that fails to comply with reasonable information requests or fails to provide a waiver upon request (section 1471(d)(6))";
}
@source(IRC_S1471_D, relation = formalizes, coverage = exact, quote = "(A) fails to comply with reasonable requests for the information referred to in subsection (b)(1)(A) or (c)(1)(A), or")
rule S1471D6ARecalcitrantByInformation defeasible {
    for h: us.irc.core::Person;
    when account_holder_fails_information_request_1471d6A(h);
    then recalcitrant_account_holder_1471d6(h);
}
@source(IRC_S1471_D, relation = formalizes, coverage = exact, quote = "(B) fails to provide a waiver described in subsection (b)(1)(F) upon request.")
rule S1471D6BRecalcitrantByWaiver defeasible {
    for h: us.irc.core::Person;
    when account_holder_fails_to_provide_waiver_1471d6B(h);
    then recalcitrant_account_holder_1471d6(h);
}
// (f): exceptions for payments beneficially owned by governments and others.
pub relation beneficial_owner_of_payment_1471f(payment_id: Text, owner: us.irc.core::Person) kind empirical {
    label en official "the beneficial owner of the payment";
}
pub relation owner_is_foreign_government_or_low_risk_class_1471f(owner: us.irc.core::Person) kind empirical {
    label en official "the beneficial owner is a foreign government, a political subdivision, or a wholly owned agency or instrumentality of them; an international organization or its wholly owned agency; a foreign central bank of issue; or another class identified by the Secretary as posing a low risk of tax evasion (section 1471(f)(1)-(4))";
}
pub relation payment_excepted_from_1471a_1471f(payment_id: Text) kind institutional {
    label en official "subsection (a) does not apply to the payment to the extent the beneficial owner is one of the section 1471(f) classes";
}
@source(IRC_S1471_F, relation = formalizes, coverage = exact, quote = "Subsection (a) shall not apply to any payment to the extent that the beneficial owner of such payment is—")
rule S1471FExceptionForGovernmentsAndLowRiskOwners defeasible {
    for payment_id: Text;
    for owner: us.irc.core::Person;
    when beneficial_owner_of_payment_1471f(payment_id, owner)
     and owner_is_foreign_government_or_low_risk_class_1471f(owner);
    then payment_excepted_from_1471a_1471f(payment_id);
}
// (e)(2): expanded affiliated group — more than 50 percent for 80 percent.
pub relation ownership_percent_1471e2(parent: us.irc.core::Person, member: us.irc.core::Person, percent: Decimal) kind empirical {
    label en official "the percentage of stock (section 1504(a) measure, vote and value) of the member owned by the parent, for the expanded affiliated group";
}
pub relation expanded_affiliated_group_link_1471e2(parent: us.irc.core::Person, member: us.irc.core::Person) kind institutional {
    label en official "the member is linked to the parent in an expanded affiliated group: the section 1504(a) tests applied by substituting `more than 50 percent` for `at least 80 percent`, without regard to section 1504(b)(2)-(3) (section 1471(e)(2)); the full group closure is a chain of these links";
}
@source(IRC_S1471_E, relation = formalizes, coverage = partial, quote = "(A) by substituting \"more than 50 percent\" for \"at least 80 percent\" each place it appears, and")
rule S1471E2ExpandedAffiliatedGroupLink defeasible {
    for parent: us.irc.core::Person;
    for member: us.irc.core::Person;
    for pct: Decimal;
    when ownership_percent_1471e2(parent, member, pct)
     and pct > 50.0;
    then expanded_affiliated_group_link_1471e2(parent, member);
}

// --- §1472: non-financial foreign entities ----------------------------------

pub relation withholdable_payment_to_nffe_1472a(agent: us.irc.core::Person, ent: us.irc.core::Person, beneficial_owner: us.irc.core::Person, amount: Money) kind empirical {
    label en official "a withholdable payment to a non-financial foreign entity, the beneficial owner of the payment being that entity or another non-financial foreign entity";
}
pub relation nffe_certification_no_substantial_us_owners_1472b1A(beneficial_owner: us.irc.core::Person) kind empirical {
    label en official "the beneficial owner or payee provides the withholding agent a certification that the beneficial owner has no substantial United States owners";
}
pub relation nffe_names_substantial_us_owners_1472b1B(beneficial_owner: us.irc.core::Person) kind empirical {
    label en official "the beneficial owner or payee provides the name, address and TIN of each substantial United States owner";
}
pub relation agent_knows_information_incorrect_1472b2(agent: us.irc.core::Person, beneficial_owner: us.irc.core::Person) kind empirical {
    label en official "the withholding agent knows, or has reason to know, that information provided under paragraph (1) is incorrect";
}
pub relation agent_reports_owner_information_1472b3(agent: us.irc.core::Person, beneficial_owner: us.irc.core::Person) kind empirical {
    label en official "the withholding agent reports the information provided under paragraph (1)(B) to the Secretary in the manner the Secretary provides";
}
pub relation nffe_requirements_met_1472b(agent: us.irc.core::Person, beneficial_owner: us.irc.core::Person) kind institutional {
    label en official "the requirements of section 1472(b) are met with respect to the beneficial owner of the payment: a certification or the owners' identities furnished, and the agent has no knowledge that the information is incorrect, and (where owners are named) reports the information";
}
@source(IRC_S1472_B, relation = formalizes, coverage = exact, quote = "(A) a certification that such beneficial owner does not have any substantial United States owners, or")
rule S1472BRequirementsMetByCertification defeasible {
    for agent: us.irc.core::Person;
    for owner: us.irc.core::Person;
    when nffe_certification_no_substantial_us_owners_1472b1A(owner)
     and withholdable_payment_to_nffe_1472a(agent, _, owner, _);
    unless agent_knows_information_incorrect_1472b2(agent, owner)
     and nffe_certification_no_substantial_us_owners_1472b1A(owner);
    then nffe_requirements_met_1472b(agent, owner);
}
@source(IRC_S1472_B, relation = formalizes, coverage = exact, quote = "(B) the name, address, and TIN of each substantial United States owner of such beneficial owner,")
rule S1472BRequirementsMetByNamingOwners defeasible {
    for agent: us.irc.core::Person;
    for owner: us.irc.core::Person;
    when nffe_names_substantial_us_owners_1472b1B(owner)
     and agent_reports_owner_information_1472b3(agent, owner)
     and withholdable_payment_to_nffe_1472a(agent, _, owner, _);
    unless agent_knows_information_incorrect_1472b2(agent, owner)
     and nffe_names_substantial_us_owners_1472b1B(owner)
     and agent_reports_owner_information_1472b3(agent, owner);
    then nffe_requirements_met_1472b(agent, owner);
}
pub relation payment_beneficially_owned_by_excepted_class_1472c(owner: us.irc.core::Person) kind empirical {
    label en official "the payment is beneficially owned by a regularly traded corporation or its expanded-affiliated-group member, a possession entity wholly owned by bona fide residents (section 937(a)), a foreign government or wholly owned agency, an international organization, a foreign central bank of issue, another class the Secretary identifies, or the payment is in a class the Secretary identifies as low risk (section 1472(c))";
}
pub relation nffe_withholding_amount_1472a(agent: us.irc.core::Person, ent: us.irc.core::Person, amount: Money, tax: Money) kind institutional {
    label en official "the tax the withholding agent must deduct and withhold: 30 percent of a withholdable payment to a non-financial foreign entity whose beneficial owner has not satisfied section 1472(b) (section 1472(a))";
}
@source(IRC_S1472_A, relation = formalizes, coverage = exact, quote = "then the withholding agent with respect to such payment shall deduct and withhold from such payment a tax equal to 30 percent of the amount of such payment.")
rule S1472AWithholdingOnNffePayment defeasible {
    for agent: us.irc.core::Person;
    for ent: us.irc.core::Person;
    for owner: us.irc.core::Person;
    for amount: Money;
    when withholdable_payment_to_nffe_1472a(agent, ent, owner, amount);
    unless nffe_requirements_met_1472b(agent, owner)
     and withholdable_payment_to_nffe_1472a(agent, ent, owner, amount);
    unless payment_beneficially_owned_by_excepted_class_1472c(owner)
     and withholdable_payment_to_nffe_1472a(agent, ent, owner, amount);
    then nffe_withholding_amount_1472a(agent, ent, amount, round(amount * 0.30, 2, "HALF_UP"));
}
rule S1472ADutyToWithhold defeasible {
    for agent: us.irc.core::Person;
    for ent: us.irc.core::Person;
    for amount: Money;
    for tax: Money;
    when nffe_withholding_amount_1472a(agent, ent, amount, tax);
    then duty S1472WithholdingDuty {
        bearer agent;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition us.irc.core::payment(_, agent, tax, _);
            window [-infinity, infinity];
        }
    };
}
pub relation non_financial_foreign_entity_1472d(ent: us.irc.core::Person) kind institutional {
    label en official "a non-financial foreign entity: any foreign entity which is not a financial institution (section 1472(d))";
}
@source(IRC_S1472_D, relation = formalizes, coverage = exact, quote = "For purposes of this section, the term \"non-financial foreign entity\" means any foreign entity which is not a financial institution (as defined in section 1471(d)(5)).")
rule S1472DNonFinancialForeignEntity defeasible {
    for e: us.irc.core::Person;
    when foreign_entity_1473_5(e);
    unless financial_institution_1471d5(e)
     and foreign_entity_1473_5(e);
    then non_financial_foreign_entity_1472d(e);
}

// --- §1473: definitions ------------------------------------------------------

pub relation payment_of_us_source_fdap_1473_1Aii(payment_id: Text) kind empirical {
    label en official "the payment is of interest (including original issue discount), dividends, rents, salaries, wages, premiums, annuities, compensations, remunerations, emoluments, and other fixed or determinable annual or periodical gains, profits and income, from sources within the United States (section 1473(1)(A)(i))";
}
pub relation gross_proceeds_from_property_producing_us_interest_or_dividends_1473_1Aii(payment_id: Text) kind empirical {
    label en official "the payment is gross proceeds from the sale or other disposition of property of a type which can produce interest or dividends from sources within the United States (section 1473(1)(A)(ii))";
}
pub relation item_taken_into_account_under_871b1_or_882a1_1473_1B(payment_id: Text) kind empirical {
    label en official "the item of income is taken into account under section 871(b)(1) or 882(a)(1) for the taxable year";
}
pub relation withholdable_payment_1473_1(payment_id: Text) kind institutional {
    label en official "a withholdable payment: a payment of US-source fixed or determinable annual or periodical income, or gross proceeds of property producing US interest or dividends, other than an item taken into account as effectively connected income (section 1473(1)(A)-(B))";
}
@source(IRC_S1473, relation = formalizes, coverage = partial, quote = "(i) any payment of interest (including any original issue discount), dividends, rents, salaries, wages, premiums, annuities, compensations, remunerations, emoluments, and other fixed or determinable annual or periodical gains, profits, and income, if such payment is from sources within the United St")
rule S1473N1AiWithholdablePaymentFdap defeasible {
    for pid: Text;
    when payment_of_us_source_fdap_1473_1Aii(pid);
    unless item_taken_into_account_under_871b1_or_882a1_1473_1B(pid)
     and payment_of_us_source_fdap_1473_1Aii(pid);
    then withholdable_payment_1473_1(pid);
}
@source(IRC_S1473, relation = formalizes, coverage = partial, quote = "(ii) any gross proceeds from the sale or other disposition of any property of a type which can produce interest or dividends from sources within the United States.")
rule S1473N1AiiWithholdablePaymentProceeds defeasible {
    for pid: Text;
    when gross_proceeds_from_property_producing_us_interest_or_dividends_1473_1Aii(pid);
    unless item_taken_into_account_under_871b1_or_882a1_1473_1B(pid)
     and gross_proceeds_from_property_producing_us_interest_or_dividends_1473_1Aii(pid);
    then withholdable_payment_1473_1(pid);
}
pub relation owner_percent_of_entity_1473_2(owner: us.irc.core::Person, ent: us.irc.core::Person, percent: Decimal) kind empirical {
    label en official "the percentage of the stock (by vote or value), or of the profits or capital interests, that the specified United States person owns directly or indirectly in the entity";
}
pub relation entity_is_financial_institution_1471d5C_type_1473_2b(ent: us.irc.core::Person) kind empirical {
    label en official "the entity is a financial institution described in section 1471(d)(5)(C), for which `0 percent` is substituted for `10 percent` (section 1473(2)(B))";
}
pub relation specified_us_person_1473_3(p: us.irc.core::Person) kind empirical {
    label en official "the United States person is a specified United States person: not a regularly traded corporation or member of its expanded affiliated group, an exempt organization or individual retirement plan, the United States, a State or possession or their agencies, a bank, REIT, RIC, common trust fund, or a section 664(c)/4947(a)(1) trust (section 1473(3)); the exclusions are a characterization asserted by the case";
}
pub relation substantial_united_states_owner_1473_2(owner: us.irc.core::Person, ent: us.irc.core::Person) kind institutional {
    label en official "a substantial United States owner of a corporation or partnership: a specified United States person owning, directly or indirectly, more than 10 percent (0 percent for a section 1471(d)(5)(C) financial institution) of the stock by vote or value, or of the profits or capital interests (section 1473(2))";
}
@source(IRC_S1473, relation = formalizes, coverage = partial, quote = "(i) with respect to any corporation, any specified United States person which owns, directly or indirectly, more than 10 percent of the stock of such corporation (by vote or value),")
rule S1473N2AOwnerMoreThanTenPercent defeasible {
    for owner: us.irc.core::Person;
    for ent: us.irc.core::Person;
    for pct: Decimal;
    when specified_us_person_1473_3(owner)
     and owner_percent_of_entity_1473_2(owner, ent, pct)
     and pct > 10.0;
    unless entity_is_financial_institution_1471d5C_type_1473_2b(ent)
     and specified_us_person_1473_3(owner);
    then substantial_united_states_owner_1473_2(owner, ent);
}
@source(IRC_S1473, relation = formalizes, coverage = partial, quote = "In the case of any financial institution described in section 1471(d)(5)(C), clauses (i), (ii), and (iii) of subparagraph (A) shall be applied by substituting \"0 percent\" for \"10 percent\".")
rule S1473N2BFinancialInstitutionZeroPercent defeasible {
    for owner: us.irc.core::Person;
    for ent: us.irc.core::Person;
    for pct: Decimal;
    when specified_us_person_1473_3(owner)
     and owner_percent_of_entity_1473_2(owner, ent, pct)
     and entity_is_financial_institution_1471d5C_type_1473_2b(ent)
     and pct > 0.0;
    then substantial_united_states_owner_1473_2(owner, ent);
}
pub relation united_states_owned_foreign_entity_1471d3(ent: us.irc.core::Person) kind institutional {
    label en official "a United States owned foreign entity: any foreign entity which has one or more substantial United States owners (section 1471(d)(3))";
}
@source(IRC_S1471_D, relation = formalizes, coverage = exact, quote = "The term \"United States owned foreign entity\" means any foreign entity which has one or more substantial United States owners.")
rule S1471D3UnitedStatesOwnedForeignEntity defeasible {
    for ent: us.irc.core::Person;
    for owner: us.irc.core::Person;
    when foreign_entity_1473_5(ent)
     and substantial_united_states_owner_1473_2(owner, ent);
    then united_states_owned_foreign_entity_1471d3(ent);
}

// --- §1474: special rules ----------------------------------------------------

pub relation tax_withheld_under_chapter_4_beneficial_owner_overpayment_1474b(beneficial_owner: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the amount of tax deducted and withheld under chapter 4 that results in an overpayment by the beneficial owner";
}
pub relation payment_beneficially_owned_by_ffi_1474b2B(payment_id: Text, ffi: us.irc.core::Person) kind empirical {
    label en official "a specified financial institution payment: a payment whose beneficial owner is a foreign financial institution";
}
pub relation ffi_entitled_to_treaty_reduced_rate_1474b2Ai(ffi: us.irc.core::Person, payment_id: Text) kind empirical {
    label en official "the foreign financial institution is entitled to a reduced rate of tax with respect to the payment by reason of a treaty obligation of the United States";
}
pub relation credit_or_refund_attributable_to_treaty_reduction_1474b2Ai(ffi: us.irc.core::Person, payment_id: Text, amount: Money) kind empirical {
    label en official "the credit or refund attributable to the treaty rate reduction";
}
pub relation credit_or_refund_ceiling_1474b2A(ffi: us.irc.core::Person, payment_id: Text, ceiling: Money) kind institutional {
    label en official "for tax properly withheld under section 1471 from a specified financial institution payment to an institution entitled to a treaty-reduced rate: the credit or refund may not exceed the amount attributable to the rate reduction, and no interest is allowed (section 1474(b)(2)(A)(i)); for an institution not so entitled, none is allowed (clause (ii))";
}
@source(IRC_S1474_B, relation = formalizes, coverage = exact, quote = "(I) the amount of any credit or refund with respect to such tax shall not exceed the amount of credit or refund attributable to such reduction in rate, and")
rule S1474B2AiCreditCappedAtTreatyReduction defeasible {
    for ffi: us.irc.core::Person;
    for pid: Text;
    for attributable: Money;
    when payment_beneficially_owned_by_ffi_1474b2B(pid, ffi)
     and ffi_entitled_to_treaty_reduced_rate_1474b2Ai(ffi, pid)
     and credit_or_refund_attributable_to_treaty_reduction_1474b2Ai(ffi, pid, attributable);
    then credit_or_refund_ceiling_1474b2A(ffi, pid, attributable);
}
@source(IRC_S1474_B, relation = formalizes, coverage = exact, quote = "(ii) if such foreign financial institution is not so entitled, no credit or refund shall be allowed or paid with respect to such tax.")
rule S1474B2AiiNoCreditIfNotEntitled defeasible {
    for ffi: us.irc.core::Person;
    for pid: Text;
    when payment_beneficially_owned_by_ffi_1474b2B(pid, ffi);
    unless ffi_entitled_to_treaty_reduced_rate_1474b2Ai(ffi, pid)
     and payment_beneficially_owned_by_ffi_1474b2B(pid, ffi);
    then credit_or_refund_ceiling_1474b2A(ffi, pid, 0.00 USD);
}
pub relation beneficial_owner_furnished_information_1474b3(beneficial_owner: us.irc.core::Person) kind empirical {
    label en official "the beneficial owner provides the Secretary the information required to determine whether it is a United States owned foreign entity or the like";
}
pub relation chapter_4_credit_or_refund_allowed_1474b3(beneficial_owner: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "a credit or refund with respect to tax properly withheld under chapter 4 is allowed only where the beneficial owner provides the required information (section 1474(b)(3))";
}
@source(IRC_S1474_B, relation = formalizes, coverage = partial, quote = "No credit or refund shall be allowed or paid with respect to any tax properly deducted and withheld under this chapter unless the beneficial owner of the payment provides the Secretary such information as the Secretary may require to determine whether such beneficial owner is a United States owned")
rule S1474B3CreditOnlyIfInformationProvided defeasible {
    for owner: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when tax_withheld_under_chapter_4_beneficial_owner_overpayment_1474b(owner, y, amount)
     and beneficial_owner_furnished_information_1474b3(owner);
    then chapter_4_credit_or_refund_allowed_1474b3(owner, y);
}
pub relation agreement_withholding_treated_as_1471a_withholding_1474e(agent: us.irc.core::Person, amount: Money) kind institutional {
    label en official "tax deducted and withheld pursuant to an agreement described in section 1471(b) is treated for purposes of this title as tax deducted and withheld by a withholding agent under section 1471(a) (section 1474(e))";
}
pub relation tax_withheld_pursuant_to_1471b_agreement_1474e(ffi: us.irc.core::Person, amount: Money) kind empirical {
    label en official "tax deducted and withheld by the institution pursuant to its section 1471(b) agreement";
}
@source(IRC_S1474_E, relation = formalizes, coverage = exact, quote = "Any tax deducted and withheld pursuant to an agreement described in section 1471(b) shall be treated for purposes of this title as a tax deducted and withheld by a withholding agent under section 1471(a).")
rule S1474ETreatedAsWithholdingAgentUnder1471a defeasible {
    for ffi: us.irc.core::Person;
    for amount: Money;
    when tax_withheld_pursuant_to_1471b_agreement_1474e(ffi, amount);
    then agreement_withholding_treated_as_1471a_withholding_1474e(ffi, amount);
}
pub relation ffi_identity_meets_1471b_not_return_information_1474c2(ffi: us.irc.core::Person) kind institutional {
    label en official "the identity of a foreign financial institution which meets the requirements of section 1471(b) is not treated as return information for purposes of section 6103 (section 1474(c)(2))";
}
@source(IRC_S1474_C, relation = formalizes, coverage = exact, quote = "The identity of a foreign financial institution which meets the requirements of section 1471(b) shall not be treated as return information for purposes of section 6103.")
rule S1474C2IdentityNotReturnInformation defeasible {
    for ffi: us.irc.core::Person;
    when ffi_agreement_in_effect(ffi);
    then ffi_identity_meets_1471b_not_return_information_1474c2(ffi);
}

// --- §1471 effective-date note (Pub. L. 111-147 §501(d)) --------------------
//
// The statutory note to §1471 makes the chapter 4 amendments apply to payments
// made after December 31, 2012, and exempts payments under obligations
// outstanding on the date 2 years after March 18, 2010 (that is, March 18,
// 2012) and the gross proceeds from a disposition of such an obligation. A
// payment whose date is not supplied is not treated as pre-2013 (the case must
// give the date to obtain the transition relief).

pub relation withholdable_payment_made_on_1471(agent: us.irc.core::Person, ffi: us.irc.core::Person, amount: Money, made_on: Date) kind empirical {
    label en official "the date on which the withholdable payment is made";
}
pub relation payment_under_obligation_outstanding_march_18_2012_1471note(agent: us.irc.core::Person, ffi: us.irc.core::Person, amount: Money) kind empirical {
    label en official "the payment is made under an obligation outstanding on March 18, 2012 (2 years after the enactment of Pub. L. 111-147, March 18, 2010), or is gross proceeds from a disposition of such an obligation";
}
pub relation fatca_transition_exempt_payment_1471note(agent: us.irc.core::Person, ffi: us.irc.core::Person, amount: Money) kind institutional {
    label en official "the payment is outside chapter 4 by the effective-date note: made on or before December 31, 2012, or made under a grandfathered obligation (Pub. L. 111-147 §501(d)(1)-(2))";
}
rule S1471NoteEffectiveDateAfterDec312012 defeasible {
    for agent: us.irc.core::Person;
    for ffi: us.irc.core::Person;
    for amount: Money;
    for made_on: Date;
    when withholdable_payment_made_on_1471(agent, ffi, amount, made_on)
     and made_on <= @2012-12-31;
    then fatca_transition_exempt_payment_1471note(agent, ffi, amount);
}
rule S1471NoteGrandfatheredObligation defeasible {
    for agent: us.irc.core::Person;
    for ffi: us.irc.core::Person;
    for amount: Money;
    when payment_under_obligation_outstanding_march_18_2012_1471note(agent, ffi, amount);
    then fatca_transition_exempt_payment_1471note(agent, ffi, amount);
}
