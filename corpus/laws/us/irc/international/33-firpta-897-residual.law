// §897 residual (stage 2d): (b), (c)(3)-(6), (d), (e), (g), (i), (j), (k), (l).
// Module 16 carries (a), (c)(1)-(2), (h). The section 318 attribution rules with 5
// percent substituted (paragraph (c)(6)(C)) are not modeled: percentages are case inputs.

// --- §897(b) -----------------------------------------------------------------------------------------

use self::{
    IRC_S897_B,
    IRC_S897_C,
    IRC_S897_D,
    IRC_S897_E,
    IRC_S897_I,
    IRC_S897_J,
    IRC_S897_K,
    IRC_S897_L,
};

pub relation usrpi_loss_of_individual_897b(p: us.irc.core::Individual, loss: Money, loss_allowed_under_165c: Money) kind empirical {
    label en official "a loss on the disposition of a United States real property interest, and the amount that would be taken into account under section 165(c) determined without regard to subsection (a)";
}
pub relation usrpi_loss_taken_into_account_897b(p: us.irc.core::Individual, amount: Money) kind institutional {
    label en official "in the case of an individual, a loss is taken into account under subsection (a) only to the extent it would be taken into account under section 165(c) (section 897(b))";
}
@source(IRC_S897_B, relation = formalizes, coverage = exact, quote = "In the case of an individual, a loss shall be taken into account under subsection (a) only to the extent such loss would be taken into account under section 165(c) (determined without regard to")
rule S897BLossLimitedToSection165c defeasible {
    for p: us.irc.core::Individual;
    for loss: Money;
    for allowed: Money;
    when usrpi_loss_of_individual_897b(p, loss, allowed);
    then usrpi_loss_taken_into_account_897b(p, min(loss, allowed));
}

// --- §897(c)(3): regularly traded stock ------------------------------------------------------------------

pub relation stock_class_regularly_traded_on_established_market_897c3(corp: us.irc.core::Corporation) kind empirical {
    label en official "a class of stock of the corporation is regularly traded on an established securities market";
}
pub relation holder_percentage_of_class_during_shorter_period_897c3(holder: us.irc.core::Person, corp: us.irc.core::Corporation, percentage: Decimal) kind empirical {
    label en official "the percentage of the class of stock held by the person at some time during the shorter of the periods described in paragraph (1)(A)(ii), with the section 318(a) attribution (5 percent substituted for 50 percent) taken as a case input";
}
pub relation corporation_is_real_estate_investment_trust_897k(corp: us.irc.core::Corporation) kind empirical {
    label en official "the corporation is a real estate investment trust";
}
pub relation regularly_traded_stock_is_usrpi_for_holder_897c3(holder: us.irc.core::Person, corp: us.irc.core::Corporation) kind institutional {
    label en official "stock of a regularly traded class is treated as a United States real property interest only for a person who held more than 5 percent of the class (more than 10 percent for a real estate investment trust) (section 897(c)(3), (k)(1)(A))";
}
@source(IRC_S897_C, relation = formalizes, coverage = exact, quote = "If any class of stock of a corporation is regularly traded on an established securities market, stock of such class shall be treated as a United States real property interest only in the case of a")
rule S897C3RegularlyTradedMoreThanFivePercent defeasible {
    for holder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for pct: Decimal;
    when stock_class_regularly_traded_on_established_market_897c3(corp)
     and holder_percentage_of_class_during_shorter_period_897c3(holder, corp, pct)
     and pct > 5.0;
    unless corporation_is_real_estate_investment_trust_897k(corp)
     and stock_class_regularly_traded_on_established_market_897c3(corp)
     and holder_percentage_of_class_during_shorter_period_897c3(holder, corp, pct);
    then regularly_traded_stock_is_usrpi_for_holder_897c3(holder, corp);
}
@source(IRC_S897_K, relation = formalizes, coverage = exact, quote = "In the case of any disposition of stock in a real estate investment trust, paragraphs (3) and (6)(C) of subsection (c) shall each be applied by substituting \"more than 10 percent\" for \"more than 5")
rule S897K1AReitMoreThanTenPercent defeasible {
    for holder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for pct: Decimal;
    when stock_class_regularly_traded_on_established_market_897c3(corp)
     and corporation_is_real_estate_investment_trust_897k(corp)
     and holder_percentage_of_class_during_shorter_period_897c3(holder, corp, pct)
     and pct > 10.0;
    then regularly_traded_stock_is_usrpi_for_holder_897c3(holder, corp);
}

// --- §897(c)(5): chains of corporations --------------------------------------------------------------------

pub relation first_corporation_stock_percentage_of_second_fmv_897c5(first: us.irc.core::Corporation, second: us.irc.core::Corporation, percentage: Decimal) kind empirical {
    label en official "the percentage of the fair market value of all classes of stock of the second corporation held by the first corporation";
}
pub relation second_corporation_asset_897c5(second: us.irc.core::Corporation, asset_id: Text, fair_market_value: Money) kind empirical {
    label en official "an asset of the second corporation and its fair market value";
}
pub relation holds_controlling_interest_897c5B(first: us.irc.core::Corporation, second: us.irc.core::Corporation) kind institutional {
    label en official "a controlling interest: 50 percent or more of the fair market value of all classes of stock of the corporation (section 897(c)(5)(B))";
}
@source(IRC_S897_C, relation = formalizes, coverage = exact, quote = "For purposes of subparagraph (A), the term \"controlling interest\" means 50 percent or more of the fair market value of all classes of stock of a corporation.")
rule S897C5BControllingInterestFiftyPercent defeasible {
    for first: us.irc.core::Corporation;
    for second: us.irc.core::Corporation;
    for pct: Decimal;
    when first_corporation_stock_percentage_of_second_fmv_897c5(first, second, pct)
     and pct >= 50.0;
    then holds_controlling_interest_897c5B(first, second);
}
pub relation asset_treated_as_held_by_first_corporation_897c5A(first: us.irc.core::Corporation, second: us.irc.core::Corporation, asset_id: Text, portion: Money) kind institutional {
    label en official "the first corporation is treated as holding a portion of each asset of the second corporation equal to the percentage of the fair market value of the second corporation's stock that it holds (section 897(c)(5)(A)(ii))";
}
@source(IRC_S897_C, relation = formalizes, coverage = exact, quote = "(ii) the first corporation shall be treated as holding a portion of each asset of the second corporation equal to the percentage of the fair market value of the stock of the second corporation")
rule S897C5AiiPortionOfSecondCorporationAssets defeasible {
    for first: us.irc.core::Corporation;
    for second: us.irc.core::Corporation;
    for asset_id: Text;
    for fmv: Money;
    for pct: Decimal;
    when holds_controlling_interest_897c5B(first, second)
     and first_corporation_stock_percentage_of_second_fmv_897c5(first, second, pct)
     and second_corporation_asset_897c5(second, asset_id, fmv);
    then asset_treated_as_held_by_first_corporation_897c5A(first, second, asset_id, round(fmv * (pct / 100.0), 2, "HALF_UP"));
}

// --- §897(d), (e): foreign corporation distributions and nonrecognition ---------------------------------

pub relation usrpi_distribution_by_foreign_corporation_897d1(corp: us.irc.core::Corporation, distribution_id: Text, fair_market_value: Money, adjusted_basis: Money) kind empirical {
    label en official "a distribution (including in liquidation or redemption) by a foreign corporation of a United States real property interest, its fair market value at the time of distribution and its adjusted basis";
}
pub relation distributee_taxable_on_subsequent_disposition_897d2Ai(distribution_id: Text) kind empirical {
    label en official "at the time of receipt, the distributee would be subject to taxation under this chapter on a subsequent disposition of the distributed property";
}
pub relation distributee_basis_test_897d2Aii(distribution_id: Text, basis_in_distributee_hands: Money, adjusted_basis_before: Money, gain_recognized_by_distributing_corporation: Money) kind empirical {
    label en official "the basis of the distributed property in the hands of the distributee, the adjusted basis before the distribution and the gain (if any) recognized by the distributing corporation";
}
pub relation nonrecognition_by_regulation_897d2B(distribution_id: Text) kind empirical {
    label en official "nonrecognition is provided in regulations prescribed under subsection (e)(2)";
}
pub relation distributee_basis_condition_met_897d2Aii(distribution_id: Text) kind institutional {
    label en official "the basis in the distributee's hands is no greater than the adjusted basis before the distribution, increased by the gain recognized by the distributing corporation";
}
@source(IRC_S897_D, relation = formalizes, coverage = exact, quote = "(ii) the basis of the distributed property in the hands of the distributee is no greater than the adjusted basis of such property before the distribution, increased by the amount of gain (if any)")
rule S897D2AiiBasisCondition defeasible {
    for distribution_id: Text;
    for basis_after: Money;
    for basis_before: Money;
    for gain: Money;
    when distributee_basis_test_897d2Aii(distribution_id, basis_after, basis_before, gain)
     and basis_after <= basis_before + gain;
    then distributee_basis_condition_met_897d2Aii(distribution_id);
}
pub relation gain_recognized_on_distribution_897d1(corp: us.irc.core::Corporation, distribution_id: Text, gain: Money) kind institutional {
    label en official "gain is recognized by a foreign corporation on the distribution of a United States real property interest, equal to the excess of fair market value over adjusted basis (section 897(d)(1)), unless paragraph (2) applies";
}
@source(IRC_S897_D, relation = formalizes, coverage = exact, quote = "Except to the extent otherwise provided in regulations, notwithstanding any other provision of this chapter, gain shall be recognized by a foreign corporation on the distribution (including a")
rule S897D1GainOnDistribution defeasible {
    for corp: us.irc.core::Corporation;
    for distribution_id: Text;
    for fmv: Money;
    for basis: Money;
    when usrpi_distribution_by_foreign_corporation_897d1(corp, distribution_id, fmv, basis)
     and fmv > basis;
    unless distributee_taxable_on_subsequent_disposition_897d2Ai(distribution_id)
     and distributee_basis_condition_met_897d2Aii(distribution_id)
     and usrpi_distribution_by_foreign_corporation_897d1(corp, distribution_id, fmv, basis);
    unless nonrecognition_by_regulation_897d2B(distribution_id)
     and usrpi_distribution_by_foreign_corporation_897d1(corp, distribution_id, fmv, basis);
    then gain_recognized_on_distribution_897d1(corp, distribution_id, fmv - basis);
}
pub relation transaction_exchange_of_usrpi_897e1(tx_id: Text) kind empirical {
    label en official "a transaction in which a nonrecognition provision is claimed";
}
pub relation exchanged_for_interest_taxable_on_sale_897e1(tx_id: Text) kind empirical {
    label en official "the transaction is an exchange of a United States real property interest for an interest the sale of which would be subject to taxation under this chapter";
}
pub relation nonrecognition_provision_applies_897e1(tx_id: Text) kind institutional {
    label en official "a nonrecognition provision applies for purposes of this section only to an exchange of a United States real property interest for an interest the sale of which would be taxable under this chapter (section 897(e)(1))";
}
@source(IRC_S897_E, relation = formalizes, coverage = partial, quote = "Except to the extent otherwise provided in subsection (d) and paragraph (2) of this subsection, any nonrecognition provision shall apply for purposes of this section to a transaction only in the case")
rule S897E1NonrecognitionOnlyForTaxableExchange defeasible {
    for tx_id: Text;
    when transaction_exchange_of_usrpi_897e1(tx_id)
     and exchanged_for_interest_taxable_on_sale_897e1(tx_id);
    then nonrecognition_provision_applies_897e1(tx_id);
}

// --- §897(i): election to be treated as a domestic corporation -----------------------------------------------

pub relation foreign_corporation_holds_usrpi_897i1A(corp: us.irc.core::Corporation) kind empirical {
    label en official "a foreign corporation holds a United States real property interest";
}
pub relation entitled_to_nondiscriminatory_treatment_under_treaty_897i1B(corp: us.irc.core::Corporation) kind empirical {
    label en official "under a treaty obligation of the United States the foreign corporation is entitled to nondiscriminatory treatment with respect to that interest";
}
pub relation all_owners_consent_and_agree_to_tax_897i3A(corp: us.irc.core::Corporation) kind empirical {
    label en official "all owners of all classes of interests (other than solely as a creditor) at the time of the election consent and agree that gain from the disposition of the interest after June 18, 1980 is taxable notwithstanding any treaty";
}
pub relation regularly_traded_class_more_than_five_percent_holders_consent_897i3(corp: us.irc.core::Corporation) kind empirical {
    label en official "for a class of interest regularly traded on an established securities market, every person who held more than 5 percent of the class during the shorter of the periods described in subsection (c)(1)(A)(ii) consents and agrees";
}
pub relation election_897i_conditions_met(corp: us.irc.core::Corporation) kind institutional {
    label en official "the foreign corporation holds a United States real property interest, is entitled to nondiscriminatory treatment under a treaty, and the required owners consent (section 897(i)(1), (3)(A))";
}
@source(IRC_S897_I, relation = formalizes, coverage = partial, quote = "(A) if all of the owners of all classes of interests (other than interests solely as a creditor) in the foreign corporation at the time of the election consent to the making of the election and agree")
rule S897I3AAllOwnersConsent defeasible {
    for corp: us.irc.core::Corporation;
    when foreign_corporation_holds_usrpi_897i1A(corp)
     and entitled_to_nondiscriminatory_treatment_under_treaty_897i1B(corp)
     and all_owners_consent_and_agree_to_tax_897i3A(corp);
    then election_897i_conditions_met(corp);
}
@source(IRC_S897_I, relation = formalizes, coverage = partial, quote = "In the case of a class of interest (other than an interest solely as a creditor) which is regularly traded on an established securities market, the consent described in subparagraph (A) need only be")
rule S897I3RegularlyTradedClassConsent defeasible {
    for corp: us.irc.core::Corporation;
    when foreign_corporation_holds_usrpi_897i1A(corp)
     and entitled_to_nondiscriminatory_treatment_under_treaty_897i1B(corp)
     and regularly_traded_class_more_than_five_percent_holders_consent_897i3(corp);
    then election_897i_conditions_met(corp);
}
pub relation elects_treatment_as_domestic_corporation_897i1(corp: us.irc.core::Corporation) kind empirical {
    label en official "the foreign corporation makes the election to be treated as a domestic corporation for purposes of this section, section 1445 and section 6039C";
}
pub relation treated_as_domestic_corporation_897i1(corp: us.irc.core::Corporation) kind institutional {
    label en official "the foreign corporation is treated as a domestic corporation for purposes of section 897, section 1445 and section 6039C (section 897(i)(1))";
}
@source(IRC_S897_I, relation = formalizes, coverage = exact, quote = "then such foreign corporation may make an election to be treated as a domestic corporation for purposes of this section, section 1445, and section 6039C.")
rule S897I1DomesticCorporationElectionPower defeasible {
    for corp: us.irc.core::Corporation;
    when elects_treatment_as_domestic_corporation_897i1(corp);
    then power S897I1DomesticCorporationElection {
        holder corp;
        over corp;
        exercise elects_treatment_as_domestic_corporation_897i1(corp);
        valid_when election_897i_conditions_met(corp);
        effect create(treated_as_domestic_corporation_897i1(corp));
    };
}
pub relation secretary_consents_to_revocation_897i2(corp: us.irc.core::Corporation) kind empirical {
    label en official "the Secretary consents to the revocation of the election";
}
pub relation revokes_domestic_corporation_election_897i2(corp: us.irc.core::Corporation) kind empirical {
    label en official "the corporation revokes the election under paragraph (1)";
}
pub relation election_897i_revoked(corp: us.irc.core::Corporation) kind institutional {
    label en official "an election under paragraph (1), once made, may be revoked only with the consent of the Secretary (section 897(i)(2))";
}
@source(IRC_S897_I, relation = formalizes, coverage = exact, quote = "Any election under paragraph (1), once made, may be revoked only with the consent of the Secretary.")
rule S897I2RevocationOnlyWithConsent defeasible {
    for corp: us.irc.core::Corporation;
    when revokes_domestic_corporation_election_897i2(corp)
     and secretary_consents_to_revocation_897i2(corp);
    then election_897i_revoked(corp);
}

// --- §897(j): transfers to foreign corporations ------------------------------------------------------------------

pub relation usrpi_transfer_to_foreign_corporation_897j(p: us.irc.core::Person, transfer_id: Text, fair_market_value: Money, adjusted_basis: Money, other_gain_recognized: Money) kind empirical {
    label en official "a transfer by a nonresident alien individual or foreign corporation of a United States real property interest to a foreign corporation as paid in surplus or as a contribution to capital: the fair market value, the transferor's adjusted basis and the gain recognized under any other provision at the time of the transfer";
}
pub relation gain_recognized_on_transfer_to_foreign_corporation_897j(p: us.irc.core::Person, transfer_id: Text, gain: Money) kind institutional {
    label en official "gain is recognized in the amount of the excess of the fair market value over the sum of the adjusted basis and the other gain recognized (section 897(j))";
}
@source(IRC_S897_J, relation = formalizes, coverage = exact, quote = "Except to the extent otherwise provided in regulations, gain shall be recognized by a nonresident alien individual or foreign corporation on the transfer of a United States real property interest to")
rule S897JGainOnTransferToForeignCorporation defeasible {
    for p: us.irc.core::Person;
    for transfer_id: Text;
    for fmv: Money;
    for basis: Money;
    for other: Money;
    when usrpi_transfer_to_foreign_corporation_897j(p, transfer_id, fmv, basis, other)
     and fmv > basis + other;
    then gain_recognized_on_transfer_to_foreign_corporation_897j(p, transfer_id, fmv - (basis + other));
}

// --- §897(k): real estate investment trusts ------------------------------------------------------------------------

pub relation reit_distribution_on_regularly_traded_class_897k1B(reit: us.irc.core::Corporation, recipient: us.irc.core::Person, amount: Money) kind empirical {
    label en official "a distribution from a real estate investment trust attributable to gain on United States real property interests, on a class of stock regularly traded on an established securities market in the United States";
}
pub relation recipient_held_ten_percent_or_less_of_reit_class_897k1B(reit: us.irc.core::Corporation, recipient: us.irc.core::Person) kind empirical {
    label en official "the recipient did not hold more than 10 percent of the class of stock during the one-year period ending on the date of the distribution";
}
pub relation reit_distribution_not_usrpi_gain_897k1B(reit: us.irc.core::Corporation, recipient: us.irc.core::Person, amount: Money) kind institutional {
    label en official "with 10 percent substituted for 5 percent in subsection (h)(1), the distribution to a holder of 10 percent or less of a regularly traded class is not treated as gain from the sale or exchange of a United States real property interest (section 897(k)(1)(B))";
}
@source(IRC_S897_K, relation = formalizes, coverage = exact, quote = "In the case of any distribution from a real estate investment trust, subsection (h)(1) shall be applied by substituting \"10 percent\" for \"5 percent\".")
rule S897K1BReitDistributionTenPercentOrLess defeasible {
    for reit: us.irc.core::Corporation;
    for recipient: us.irc.core::Person;
    for amount: Money;
    when reit_distribution_on_regularly_traded_class_897k1B(reit, recipient, amount)
     and recipient_held_ten_percent_or_less_of_reit_class_897k1B(reit, recipient);
    then reit_distribution_not_usrpi_gain_897k1B(reit, recipient, amount);
}
pub relation treaty_eligible_and_listed_897k3Ai(fp: us.irc.core::Person) kind empirical {
    label en official "the foreign person is eligible for benefits of a comprehensive income tax treaty with an exchange of information program and its principal class of interests is listed and regularly traded on a recognized stock exchange of the treaty";
}
pub relation foreign_limited_partnership_listed_on_nyse_or_nasdaq_897k3Aii(fp: us.irc.core::Person) kind empirical {
    label en official "a foreign partnership organized under foreign law as a limited partnership in a jurisdiction with a tax information exchange agreement, with a class of units regularly traded on the New York Stock Exchange or Nasdaq whose value exceeds 50 percent of the value of all the partnership units";
}
pub relation qcivehicle_treaty_dividend_conditions_897k3Bi(fp: us.irc.core::Person) kind empirical {
    label en official "eligible for benefits under the comprehensive income tax treaty, the dividends article of which conditions benefits on real estate investment trust dividends, and eligible for the reduced withholding rate on ordinary REIT dividends even when holding more than 10 percent";
}
pub relation qcivehicle_publicly_traded_withholding_partnership_897k3Bii(fp: us.irc.core::Person) kind empirical {
    label en official "a publicly traded partnership to which section 7704(a) does not apply, a withholding foreign partnership, and one that would be a United States real property holding corporation if it were a domestic corporation at any time during the 5-year period";
}
pub relation designated_qcivehicle_by_secretary_897k3Biii(fp: us.irc.core::Person) kind empirical {
    label en official "designated as a qualified collective investment vehicle by the Secretary and either fiscally transparent (section 894) or entitled to a deduction for distributions to interest holders";
}
pub relation maintains_records_of_five_percent_holders_897k3Aiii(fp: us.irc.core::Person) kind empirical {
    label en official "the foreign person maintains records on the identity of each person who at any time during the taxable year holds directly 5 percent or more of the class of interest";
}
pub relation qualified_collective_investment_vehicle_897k3B(fp: us.irc.core::Person) kind institutional {
    label en official "a qualified collective investment vehicle (section 897(k)(3)(B))";
}
@source(IRC_S897_K, relation = formalizes, coverage = partial, quote = "(I) is eligible for benefits under the comprehensive income tax treaty described in subparagraph (A)(i)(I), but only if the dividends article of such treaty imposes conditions on the benefits")
rule S897K3BiTreatyQualifiedVehicle defeasible {
    for fp: us.irc.core::Person;
    when qcivehicle_treaty_dividend_conditions_897k3Bi(fp);
    then qualified_collective_investment_vehicle_897k3B(fp);
}
@source(IRC_S897_K, relation = formalizes, coverage = partial, quote = "(I) is a publicly traded partnership (as defined in section 7704(b)) to which subsection (a) of section 7704 does not apply,")
rule S897K3BiiPublicPartnershipVehicle defeasible {
    for fp: us.irc.core::Person;
    when qcivehicle_publicly_traded_withholding_partnership_897k3Bii(fp);
    then qualified_collective_investment_vehicle_897k3B(fp);
}
@source(IRC_S897_K, relation = formalizes, coverage = partial, quote = "(iii) which is designated as a qualified collective investment vehicle by the Secretary and is either—")
rule S897K3BiiiDesignatedVehicle defeasible {
    for fp: us.irc.core::Person;
    when designated_qcivehicle_by_secretary_897k3Biii(fp);
    then qualified_collective_investment_vehicle_897k3B(fp);
}
pub relation qualified_shareholder_897k3A(fp: us.irc.core::Person) kind institutional {
    label en official "a qualified shareholder: a listed treaty-eligible foreign person or a listed foreign limited partnership that is a qualified collective investment vehicle and keeps records of 5 percent holders (section 897(k)(3)(A))";
}
@source(IRC_S897_K, relation = formalizes, coverage = exact, quote = "(i)(I) is eligible for benefits of a comprehensive income tax treaty with the United States which includes an exchange of information program and the principal class of interests of which is listed")
rule S897K3AiTreatyListedQualifiedShareholder defeasible {
    for fp: us.irc.core::Person;
    when treaty_eligible_and_listed_897k3Ai(fp)
     and qualified_collective_investment_vehicle_897k3B(fp)
     and maintains_records_of_five_percent_holders_897k3Aiii(fp);
    then qualified_shareholder_897k3A(fp);
}
@source(IRC_S897_K, relation = formalizes, coverage = exact, quote = "(II) is a foreign partnership that is created or organized under foreign law as a limited partnership in a jurisdiction that has an agreement for the exchange of information with respect to taxes")
rule S897K3AiiForeignPartnershipQualifiedShareholder defeasible {
    for fp: us.irc.core::Person;
    when foreign_limited_partnership_listed_on_nyse_or_nasdaq_897k3Aii(fp)
     and qualified_collective_investment_vehicle_897k3B(fp)
     and maintains_records_of_five_percent_holders_897k3Aiii(fp);
    then qualified_shareholder_897k3A(fp);
}
pub relation reit_stock_held_by_shareholder_897k2(holder: us.irc.core::Person, reit: us.irc.core::Corporation, applicable_percentage: Decimal) kind empirical {
    label en official "REIT stock held directly (or indirectly through partnerships) by the holder, and the applicable percentage: the percentage of the value of the interests (other than solely as a creditor) in the qualified shareholder held by applicable investors";
}
pub relation reit_stock_usrpi_percentage_897k2(holder: us.irc.core::Person, reit: us.irc.core::Corporation, percentage: Decimal) kind institutional {
    label en official "the percentage of the REIT stock held by a qualified shareholder that is treated as a United States real property interest: zero, or the applicable percentage where the qualified shareholder has applicable investors (section 897(k)(2)(A)(i), (B)(i))";
}
@source(IRC_S897_K, relation = formalizes, coverage = exact, quote = "(i) stock of a real estate investment trust which is held directly (or indirectly through 1 or more partnerships) by a qualified shareholder shall not be treated as a United States real property")
rule S897K2AQualifiedShareholderStockNotUsrpi defeasible {
    for holder: us.irc.core::Person;
    for reit: us.irc.core::Corporation;
    when qualified_shareholder_897k3A(holder)
     and reit_stock_held_by_shareholder_897k2(holder, reit, 0.0);
    then reit_stock_usrpi_percentage_897k2(holder, reit, 0.0);
}
@source(IRC_S897_K, relation = formalizes, coverage = exact, quote = "(i) subparagraph (A)(i) shall not apply to the applicable percentage of the stock of the real estate investment trust held by the qualified shareholder, and")
rule S897K2BApplicablePercentageIsUsrpi defeasible {
    for holder: us.irc.core::Person;
    for reit: us.irc.core::Corporation;
    for pct: Decimal;
    when qualified_shareholder_897k3A(holder)
     and reit_stock_held_by_shareholder_897k2(holder, reit, pct)
     and pct > 0.0;
    then reit_stock_usrpi_percentage_897k2(holder, reit, pct);
}
pub relation holds_interest_in_qualified_shareholder_897k2Dii(investor: us.irc.core::Person, qs: us.irc.core::Person) kind empirical {
    label en official "the person holds an interest (other than solely as a creditor) in the qualified shareholder";
}
pub relation investor_reit_stock_percentage_897k2Diii(investor: us.irc.core::Person, reit: us.irc.core::Corporation, percentage: Decimal) kind empirical {
    label en official "the percentage of the REIT stock the person holds (whether or not by reason of the ownership interest in the qualified shareholder)";
}
pub relation applicable_investor_897k2D(investor: us.irc.core::Person, qs: us.irc.core::Person, reit: us.irc.core::Corporation) kind institutional {
    label en official "an applicable investor: a person (other than a qualified shareholder) holding an interest in the qualified shareholder and more than 10 percent of the REIT stock (section 897(k)(2)(D))";
}
@source(IRC_S897_K, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, the term \"applicable investor\" means, with respect to any qualified shareholder holding stock in a real estate investment trust, a person (other than a qualified")
rule S897K2DApplicableInvestor defeasible {
    for investor: us.irc.core::Person;
    for qs: us.irc.core::Person;
    for reit: us.irc.core::Corporation;
    for pct: Decimal;
    when holds_interest_in_qualified_shareholder_897k2Dii(investor, qs)
     and investor_reit_stock_percentage_897k2Diii(investor, reit, pct)
     and pct > 10.0
     and qualified_shareholder_897k3A(qs);
    unless qualified_shareholder_897k3A(investor)
     and holds_interest_in_qualified_shareholder_897k2Dii(investor, qs)
     and investor_reit_stock_percentage_897k2Diii(investor, reit, pct);
    then applicable_investor_897k2D(investor, qs, reit);
}
pub relation reit_distribution_treated_as_sale_of_stock_897k2C(reit: us.irc.core::Corporation, qs: us.irc.core::Person, recipient: us.irc.core::Person, amount: Money) kind empirical {
    label en official "a distribution by a real estate investment trust treated as a sale or exchange of stock under section 301(c)(3), 302 or 331 with respect to a qualified shareholder, and the person to whom it is attributed";
}
pub relation distribution_treated_as_reit_dividend_897k2Cii(reit: us.irc.core::Corporation, recipient: us.irc.core::Person, amount: Money) kind institutional {
    label en official "a distribution treated as a sale or exchange of stock, in the case of a person other than an applicable investor, is treated under section 857(b)(3)(F) as a dividend from the real estate investment trust (section 897(k)(2)(C)(ii))";
}
@source(IRC_S897_K, relation = formalizes, coverage = exact, quote = "(ii) in the case of any other person, such distribution shall be treated under section 857(b)(3)(F) [1] as a dividend from a real estate investment trust notwithstanding any other provision of this")
rule S897K2CiiDistributionIsDividend defeasible {
    for reit: us.irc.core::Corporation;
    for qs: us.irc.core::Person;
    for recipient: us.irc.core::Person;
    for amount: Money;
    when reit_distribution_treated_as_sale_of_stock_897k2C(reit, qs, recipient, amount);
    unless applicable_investor_897k2D(recipient, qs, reit)
     and reit_distribution_treated_as_sale_of_stock_897k2C(reit, qs, recipient, amount);
    then distribution_treated_as_reit_dividend_897k2Cii(reit, recipient, amount);
}
pub relation applicable_investor_usrpi_gain_shares_897k4(partner: us.irc.core::Person, y: us.irc.core::TaxableYear, proportionate_share: Money, distributive_share: Money) kind empirical {
    label en official "an applicable investor who is a nonresident alien individual or foreign corporation and a partner in a partnership that is a qualified shareholder: the partner's proportionate share of USRPI gain and distributive share of USRPI gain for the year";
}
pub relation usrpi_gain_increase_897k4a(partner: us.irc.core::Person, y: us.irc.core::TaxableYear, excess: Money) kind institutional {
    label en official "the partner's distributive share of gain taken into account under subsection (a)(1) is increased by the excess of the proportionate share over the distributive share (section 897(k)(4)(A)(i))";
}
@source(IRC_S897_K, relation = formalizes, coverage = exact, quote = "(i) such partner's distributive share of the amount of gain taken into account under subsection (a)(1) by the partner for the taxable year (determined without regard to this paragraph) shall be")
rule S897K4AiIncreaseByExcess defeasible {
    for partner: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for proportionate: Money;
    for distributive: Money;
    when applicable_investor_usrpi_gain_shares_897k4(partner, y, proportionate, distributive)
     and proportionate > distributive;
    then usrpi_gain_increase_897k4a(partner, y, proportionate - distributive);
}
pub relation usrpi_gain_components_897k4b(partner: us.irc.core::Person, y: us.irc.core::TaxableYear, disposition_gain: Money, reit_distribution_gain: Money, loss: Money) kind empirical {
    label en official "gain recognized from the disposition of a United States real property interest, any REIT distribution treated as such gain, and any loss recognized from the disposition";
}
pub relation usrpi_gain_897k4b(partner: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "USRPI gain: the excess (if any) of the sum of the gain and the REIT distribution gain over the loss (section 897(k)(4)(B))";
}
@source(IRC_S897_K, relation = formalizes, coverage = exact, quote = "For the purposes of this paragraph, the term \"USRPI gain\" means the excess (if any) of—")
rule S897K4BUsrpiGain defeasible {
    for partner: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for gain: Money;
    for distribution: Money;
    for loss: Money;
    when usrpi_gain_components_897k4b(partner, y, gain, distribution, loss);
    then usrpi_gain_897k4b(partner, y, max(gain + distribution - loss, 0.00 USD));
}

// --- §897(l): qualified foreign pension funds ------------------------------------------------------------------------

pub relation fund_organized_under_foreign_law_897l2A(fund: us.irc.core::Person) kind empirical {
    label en official "the trust, corporation or other organization or arrangement is created or organized under the law of a country other than the United States";
}
pub relation fund_established_by_country_for_pension_benefits_897l2Bi(fund: us.irc.core::Person) kind empirical {
    label en official "established by the country (or its political subdivisions) to provide retirement or pension benefits to current or former employees (including self-employed individuals) or their designees as a result of services rendered";
}
pub relation fund_established_by_employers_for_pension_benefits_897l2Bii(fund: us.irc.core::Person) kind empirical {
    label en official "established by one or more employers to provide retirement or pension benefits to current or former employees or their designees in consideration for services rendered";
}
pub relation largest_participant_share_percentage_897l2C(fund: us.irc.core::Person, percentage: Decimal) kind empirical {
    label en official "the largest share of the assets or income of the fund to which a single participant or beneficiary has a right";
}
pub relation fund_regulated_with_annual_beneficiary_information_897l2D(fund: us.irc.core::Person) kind empirical {
    label en official "the fund is subject to government regulation and annual information about its beneficiaries is provided, or otherwise available, to the relevant tax authorities";
}
pub relation fund_contributions_deductible_or_reduced_tax_897l2Ei(fund: us.irc.core::Person) kind empirical {
    label en official "under the laws of the country contributions which would otherwise be taxed are deductible or excluded from the gross income of the fund or taxed at a reduced rate";
}
pub relation fund_investment_income_deferred_or_reduced_tax_897l2Eii(fund: us.irc.core::Person) kind empirical {
    label en official "taxation of investment income of the fund is deferred, or the income is excluded from the gross income of the fund or taxed at a reduced rate";
}
pub relation qualified_foreign_pension_fund_897l2(fund: us.irc.core::Person) kind institutional {
    label en official "a qualified foreign pension fund (section 897(l)(2))";
}
@source(IRC_S897_L, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, the term \"qualified foreign pension fund\" means any trust, corporation, or other organization or arrangement—")
rule S897L2QualifiedForeignPensionFundCountry defeasible {
    for fund: us.irc.core::Person;
    for pct: Decimal;
    when fund_organized_under_foreign_law_897l2A(fund)
     and fund_established_by_country_for_pension_benefits_897l2Bi(fund)
     and largest_participant_share_percentage_897l2C(fund, pct)
     and pct <= 5.0
     and fund_regulated_with_annual_beneficiary_information_897l2D(fund)
     and fund_contributions_deductible_or_reduced_tax_897l2Ei(fund);
    then qualified_foreign_pension_fund_897l2(fund);
}
rule S897L2QualifiedForeignPensionFundIncome defeasible {
    for fund: us.irc.core::Person;
    for pct: Decimal;
    when fund_organized_under_foreign_law_897l2A(fund)
     and fund_established_by_country_for_pension_benefits_897l2Bi(fund)
     and largest_participant_share_percentage_897l2C(fund, pct)
     and pct <= 5.0
     and fund_regulated_with_annual_beneficiary_information_897l2D(fund)
     and fund_investment_income_deferred_or_reduced_tax_897l2Eii(fund);
    then qualified_foreign_pension_fund_897l2(fund);
}
rule S897L2QualifiedForeignPensionFundEmployerCountryContrib defeasible {
    for fund: us.irc.core::Person;
    for pct: Decimal;
    when fund_organized_under_foreign_law_897l2A(fund)
     and fund_established_by_employers_for_pension_benefits_897l2Bii(fund)
     and largest_participant_share_percentage_897l2C(fund, pct)
     and pct <= 5.0
     and fund_regulated_with_annual_beneficiary_information_897l2D(fund)
     and fund_contributions_deductible_or_reduced_tax_897l2Ei(fund);
    then qualified_foreign_pension_fund_897l2(fund);
}
rule S897L2QualifiedForeignPensionFundEmployerIncome defeasible {
    for fund: us.irc.core::Person;
    for pct: Decimal;
    when fund_organized_under_foreign_law_897l2A(fund)
     and fund_established_by_employers_for_pension_benefits_897l2Bii(fund)
     and largest_participant_share_percentage_897l2C(fund, pct)
     and pct <= 5.0
     and fund_regulated_with_annual_beneficiary_information_897l2D(fund)
     and fund_investment_income_deferred_or_reduced_tax_897l2Eii(fund);
    then qualified_foreign_pension_fund_897l2(fund);
}
pub relation entity_all_interests_held_by_qualified_foreign_pension_fund_897l1(ent: us.irc.core::Person) kind empirical {
    label en official "all the interests of the entity are held by a qualified foreign pension fund";
}
pub relation not_treated_as_nonresident_alien_or_foreign_corporation_897l1(ent: us.irc.core::Person) kind institutional {
    label en official "for this section a qualified foreign pension fund, and an entity all the interests of which are held by one, is not treated as a nonresident alien individual or a foreign corporation (section 897(l)(1))";
}
@source(IRC_S897_L, relation = formalizes, coverage = exact, quote = "For purposes of this section, a qualified foreign pension fund shall not be treated as a nonresident alien individual or a foreign corporation. For purposes of the preceding sentence, an entity all")
rule S897L1QualifiedForeignPensionFundNotForeign defeasible {
    for fund: us.irc.core::Person;
    when qualified_foreign_pension_fund_897l2(fund);
    then not_treated_as_nonresident_alien_or_foreign_corporation_897l1(fund);
}
rule S897L1WhollyOwnedEntityNotForeign defeasible {
    for ent: us.irc.core::Person;
    when entity_all_interests_held_by_qualified_foreign_pension_fund_897l1(ent);
    then not_treated_as_nonresident_alien_or_foreign_corporation_897l1(ent);
}
