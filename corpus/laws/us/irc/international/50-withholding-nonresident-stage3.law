// Stage 3 (TECH_GAP reduction), module 50: section 861(a)(2); 871(k) noncalendar years, (l)(1)(B)(iv), (l)(3); 881(e)(1)(C);
// 883(c)(3)(B), (c)(4); 1441(b), (c)(3); 1444; 1445(e); 1446(c), (d)(2), (f)(2); 1471(b)(3), (d)(7), (e); 1473; 1474.
// Status implemented_unverified: not a legal review; scenarios in tests/withholding-nonresident-stage3.lawtest are written,
// NOT executed.
//
// Modeling notes.
//  * Highest section 11(b) rate for the withholding amounts is read from `us.irc.corporations::maximum_section_11b_rate`.
//  * The dollar and percentage constants of the statute are exact fractions or decimals; no rounding is named, cents HALF_UP is
//    the corpus convention (JUDGMENT CALL).

// --- §861(a)(2)(B) last sentence: the 20-percent owned corporation --------------------------------------------------------

use self::{
    IRC_S1441_B,
    IRC_S1441_C,
    IRC_S1444,
    IRC_S1445_E,
    IRC_S1446_C,
    IRC_S1446_D,
    IRC_S1446_F,
    IRC_S1471_B,
    IRC_S1471_C,
    IRC_S1471_D,
    IRC_S1471_E,
    IRC_S1473,
    IRC_S1474_B,
    IRC_S1474_C,
    IRC_S861_A,
    IRC_S871_K,
    IRC_S871_L,
    IRC_S881_E,
    IRC_S883_C,
    dividend_payment,
    ric_qualified_net_interest_income_871k1D,
    ric_qualified_short_term_gain_871k2D,
    ric_reported_interest_related_dividend_871k1Civ,
    ric_reported_short_term_capital_gain_dividend_871k2civ,
};

pub relation twenty_percent_owned_corporation_243c2_861a2(payer: us.irc.core::Corporation) kind empirical {
    label en official "the dividend is from a 20-percent owned corporation (section 243(c)(2))";
}
pub relation dividend_gross_up_fraction_861a2B(payer: us.irc.core::Corporation, numerator: Integer, denominator: Integer) kind institutional {
    label en official "the fraction by which the deductible part of a dividend is grossed up in subparagraph (B): 100/50 generally, 100/65 for a dividend from a 20-percent owned corporation";
}
@source(IRC_S861_A, relation = formalizes, coverage = exact, quote = "In the case of any dividend from a 20-percent owned corporation (as defined in section 243(c)(2)),")
rule S861A2BTwentyPercentOwnedHundredOverSixtyFive defeasible {
    for payer: us.irc.core::Corporation;
    when twenty_percent_owned_corporation_243c2_861a2(payer);
    then dividend_gross_up_fraction_861a2B(payer, 100, 65);
}
@source(IRC_S861_A, relation = formalizes, coverage = exact, quote = "(C) from a foreign corporation to the extent that such amount is required by section 243(e) (relating to")
rule S861A2BOtherwiseHundredOverFifty defeasible {
    for payer: us.irc.core::Corporation;
    when dividend_payment(payer, _, _);
    unless twenty_percent_owned_corporation_243c2_861a2(payer)
     and dividend_payment(payer, _, _);
    then dividend_gross_up_fraction_861a2B(payer, 100, 50);
}

// --- §871(k)(1)(C)(iii)(II), (iv)(IV): noncalendar taxable years ------------------------------------------------------------

pub relation ric_year_not_calendar_year_871k1Ciii(ric: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the taxable year of the company does not begin and end in the same calendar year";
}
pub relation post_december_reported_amount_871k1Civ(ric: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate reported amount determined by taking into account only dividends paid after December 31 of the taxable year (a sum, asserted directly)";
}
pub relation dividend_paid_on_or_before_december_31_871k1(ric: us.irc.core::Corporation, y: us.irc.core::TaxableYear, dividend_id: Text) kind empirical {
    label en official "the dividend was paid on or before December 31 of the taxable year";
}
pub relation post_december_special_rule_applies_871k1Ciii(ric: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "in a noncalendar taxable year the post-December reported amount equals or exceeds the excess reported amount, so subclause (I) is applied with the post-December reported amount";
}
@source(IRC_S871_K, relation = formalizes, coverage = exact, quote = "In the case of any taxable year which does not begin and end in the same calendar year, if the post-December")
rule S871K1CiiiIIWhenPostDecemberCoversExcess defeasible {
    for ric: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for aggregate: Money;
    for qni: Money;
    for post: Money;
    for dividend_id: Text;
    for reported: Money;
    when ric_year_not_calendar_year_871k1Ciii(ric, y)
     and ric_reported_interest_related_dividend_871k1Civ(ric, y, dividend_id, reported, aggregate)
     and ric_qualified_net_interest_income_871k1D(ric, y, qni)
     and post_december_reported_amount_871k1Civ(ric, y, post)
     and aggregate > qni
     and post >= (aggregate - qni);
    then post_december_special_rule_applies_871k1Ciii(ric, y);
}
@source(IRC_S871_K, relation = formalizes, coverage = exact, quote = "In the case of any taxable year which does not begin and end in the same calendar year, if the post-December")
rule S871K1CiiiIIPostDecemberDividendShare defeasible {
    for ric: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for dividend_id: Text;
    for reported: Money;
    for aggregate: Money;
    for qni: Money;
    for post: Money;
    when post_december_special_rule_applies_871k1Ciii(ric, y)
     and ric_reported_interest_related_dividend_871k1Civ(ric, y, dividend_id, reported, aggregate)
     and ric_qualified_net_interest_income_871k1D(ric, y, qni)
     and post_december_reported_amount_871k1Civ(ric, y, post)
     and post > 0.00 USD;
    unless dividend_paid_on_or_before_december_31_871k1(ric, y, dividend_id)
     and post_december_special_rule_applies_871k1Ciii(ric, y)
     and ric_reported_interest_related_dividend_871k1Civ(ric, y, dividend_id, reported, aggregate)
     and ric_qualified_net_interest_income_871k1D(ric, y, qni)
     and post_december_reported_amount_871k1Civ(ric, y, post);
    then interest_related_dividend_amount_871k1C_post_december(ric, y, dividend_id, round(reported - reported * ((aggregate - qni) / post), 2, "HALF_UP"));
}
pub relation interest_related_dividend_amount_871k1C_post_december(ric: us.irc.core::Corporation, y: us.irc.core::TaxableYear, dividend_id: Text, amount: Money) kind institutional {
    label en official "under the noncalendar-year special rule: for a dividend paid after December 31 the excess reported amount is allocated by the post-December reported amount; for a dividend paid on or before December 31 no excess is allocated, so the reported amount stands";
}
@source(IRC_S871_K, relation = formalizes, coverage = exact, quote = "In the case of any taxable year which does not begin and end in the same calendar year, if the post-December")
rule S871K1CiiiIINoExcessOnOrBeforeDecember31 defeasible {
    for ric: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for dividend_id: Text;
    for reported: Money;
    for aggregate: Money;
    when post_december_special_rule_applies_871k1Ciii(ric, y)
     and dividend_paid_on_or_before_december_31_871k1(ric, y, dividend_id)
     and ric_reported_interest_related_dividend_871k1Civ(ric, y, dividend_id, reported, aggregate);
    then interest_related_dividend_amount_871k1C_post_december(ric, y, dividend_id, reported);
}
pub relation post_december_reported_amount_defined_871k1Civ_IV(ric: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the post-December reported amount: the aggregate reported amount taking into account only dividends paid after December 31 of the taxable year";
}
@source(IRC_S871_K, relation = formalizes, coverage = exact, quote = "The term \"post-December reported amount\" means the aggregate reported amount determined by taking into")
rule S871K1CivIVPostDecemberReportedAmount defeasible {
    for ric: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for post: Money;
    when post_december_reported_amount_871k1Civ(ric, y, post);
    then post_december_reported_amount_defined_871k1Civ_IV(ric, y, post);
}
pub relation ric_year_not_calendar_year_871k2Ciii(ric: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the taxable year of the company does not begin and end in the same calendar year (short-term capital gain dividends)";
}
pub relation post_december_reported_short_term_amount_871k2Civ(ric: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate reported amount of short-term capital gain dividends determined by taking into account only dividends paid after December 31 of the taxable year (a sum, asserted directly)";
}
pub relation post_december_short_term_rule_applies_871k2Ciii(ric: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "in a noncalendar taxable year the post-December reported amount equals or exceeds the excess reported amount, so subclause (I) uses the post-December amount";
}
@source(IRC_S871_K, relation = formalizes, coverage = exact, quote = "In the case of any taxable year which does not begin and end in the same calendar year, if the post-December")
rule S871K2CiiiIIWhenPostDecemberCoversExcess defeasible {
    for ric: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for dividend_id: Text;
    for reported: Money;
    for aggregate: Money;
    for qsg: Money;
    for post: Money;
    when ric_year_not_calendar_year_871k2Ciii(ric, y)
     and ric_reported_short_term_capital_gain_dividend_871k2civ(ric, y, dividend_id, reported, aggregate)
     and ric_qualified_short_term_gain_871k2D(ric, y, qsg)
     and post_december_reported_short_term_amount_871k2Civ(ric, y, post)
     and aggregate > qsg
     and post >= (aggregate - qsg);
    then post_december_short_term_rule_applies_871k2Ciii(ric, y);
}
pub relation post_december_reported_amount_defined_871k2Civ_IV(ric: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the post-December reported amount for short-term capital gain dividends";
}
@source(IRC_S871_K, relation = formalizes, coverage = exact, quote = "The term \"post-December reported amount\" means the aggregate reported amount determined by taking into")
rule S871K2CivIVPostDecemberReportedAmount defeasible {
    for ric: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for post: Money;
    when post_december_reported_short_term_amount_871k2Civ(ric, y, post);
    then post_december_reported_amount_defined_871k2Civ_IV(ric, y, post);
}

// --- §871(l)(1)(B)(iv), (l)(3) ------------------------------------------------------------------------------------------------

pub relation active_foreign_business_percent_of_period_871l1Biv(corp: us.irc.core::Corporation, period: Text, percent: Decimal, weight_days: Integer) kind empirical {
    label en official "the percentage of the corporation's gross income from all sources that is active foreign business income for a part of the testing period ('pre2011' for taxable years beginning before January 1, 2011, measured under section 861(c)(1)(B) as it stood before; 'post2010' from 2011 on, measured under clause (ii)), and the length in days of that part";
}
pub relation active_foreign_business_weighted_average_871l1Biv(corp: us.irc.core::Corporation, average: Decimal) kind institutional {
    label en official "the weighted average of the pre-2011 and post-2010 percentages, weighted by the length of the periods (JUDGMENT CALL: the statute says weighted average without naming the weights)";
}
@source(IRC_S871_L, relation = formalizes, coverage = exact, quote = "(I) a corporation meets the 80-percent foreign business requirements of this subparagraph if and only if the")
rule S871L1BivIWeightedAverage defeasible {
    for corp: us.irc.core::Corporation;
    for pre: Decimal;
    for pre_days: Integer;
    for post: Decimal;
    for post_days: Integer;
    when active_foreign_business_percent_of_period_871l1Biv(corp, "pre2011", pre, pre_days)
     and active_foreign_business_percent_of_period_871l1Biv(corp, "post2010", post, post_days)
     and (pre_days + post_days) > 0;
    then active_foreign_business_weighted_average_871l1Biv(corp, ((pre * pre_days) + (post * post_days)) * (1.00 USD / (1.00 USD * (pre_days + post_days))));
}
pub relation meets_80_percent_foreign_business_requirements_871l1Biv(corp: us.irc.core::Corporation) kind institutional {
    label en official "the corporation meets the 80-percent foreign business requirements if and only if the weighted average is at least 80 percent";
}
@source(IRC_S871_L, relation = formalizes, coverage = exact, quote = "is at least 80 percent, and")
rule S871L1BivEightyPercent defeasible {
    for corp: us.irc.core::Corporation;
    for average: Decimal;
    when active_foreign_business_weighted_average_871l1Biv(corp, average)
     and average >= 80.0;
    then meets_80_percent_foreign_business_requirements_871l1Biv(corp);
}
pub relation active_foreign_business_percentage_for_year_871l1BivII(corp: us.irc.core::Corporation, percentage: Decimal) kind institutional {
    label en official "the active foreign business percentage for the taxable year equals the weighted average percentage";
}
@source(IRC_S871_L, relation = formalizes, coverage = exact, quote = "(II) the active foreign business percentage for such taxable year shall equal the weighted average percentage")
rule S871L1BivIIPercentageIsWeightedAverage defeasible {
    for corp: us.irc.core::Corporation;
    for average: Decimal;
    when active_foreign_business_weighted_average_871l1Biv(corp, average);
    then active_foreign_business_percentage_for_year_871l1BivII(corp, average);
}
pub relation corporation_owns_stock_percent_of_subsidiary_871l3B(corp: us.irc.core::Corporation, subsidiary: us.irc.core::Corporation, percent: Decimal) kind empirical {
    label en official "the percentage of the stock of the subsidiary the corporation owns directly or indirectly, for the section 1504(a)(2) test with 50 percent for 80 percent and without regard to section 1504(b)(3)";
}
pub relation subsidiary_of_corporation_871l3B(corp: us.irc.core::Corporation, subsidiary: us.irc.core::Corporation) kind institutional {
    label en official "a subsidiary: a corporation in which the corporation owns stock meeting the section 1504(a)(2) requirements, 50 percent substituted for 80 percent";
}
@source(IRC_S871_L, relation = formalizes, coverage = exact, quote = "For purposes of subparagraph (A), the term \"subsidiary\" means any corporation in which the corporation")
rule S871L3BSubsidiaryAtFiftyPercent defeasible {
    for corp: us.irc.core::Corporation;
    for subsidiary: us.irc.core::Corporation;
    for percent: Decimal;
    when corporation_owns_stock_percent_of_subsidiary_871l3B(corp, subsidiary, percent)
     and percent >= 50.0;
    then subsidiary_of_corporation_871l3B(corp, subsidiary);
}
pub relation treated_as_one_corporation_871l3A(corp: us.irc.core::Corporation, subsidiary: us.irc.core::Corporation) kind institutional {
    label en official "the corporation and all its subsidiaries are treated as one corporation";
}
@source(IRC_S871_L, relation = formalizes, coverage = exact, quote = "The corporation referred to in paragraph (1)(A) and all of such corporation's subsidiaries shall be treated")
rule S871L3ASingleCorporation defeasible {
    for corp: us.irc.core::Corporation;
    for subsidiary: us.irc.core::Corporation;
    when subsidiary_of_corporation_871l3B(corp, subsidiary);
    then treated_as_one_corporation_871l3A(corp, subsidiary);
}

// --- §881(e)(1)(C); §883(c)(3)(B), (c)(4) --------------------------------------------------------------------------------------

pub relation interest_related_dividend_received_by_cfc_881e1C(cfc: us.irc.core::Corporation, dividend_id: Text, amount: Money) kind empirical {
    label en official "an interest-related dividend received by a controlled foreign corporation (section 957(a)), to the extent attributable to interest received by the regulated investment company described in clause (ii) of section 871(k)(1)(E) (and not in clause (i) or (iii))";
}
pub relation cfc_dividend_treated_under_881c5A_881e1C(cfc: us.irc.core::Corporation, dividend_id: Text, amount: Money) kind institutional {
    label en official "the rules of subsection (c)(5)(A) apply to the interest-related dividend received by the controlled foreign corporation";
}
@source(IRC_S881_E, relation = formalizes, coverage = exact, quote = "The rules of subsection (c)(5)(A) shall apply to any interest-related dividend received by a controlled")
rule S881E1CRulesOfC5AApply defeasible {
    for cfc: us.irc.core::Corporation;
    for dividend_id: Text;
    for amount: Money;
    when interest_related_dividend_received_by_cfc_881e1C(cfc, dividend_id, amount);
    then cfc_dividend_treated_under_881c5A_881e1C(cfc, dividend_id, amount);
}
pub relation corporation_meeting_883c3A_requirements_organized_in_country_883c3B(owner_corp: us.irc.core::Corporation, country: Text) kind empirical {
    label en official "the corporation meeting the requirements of subparagraph (A) and the foreign country in which it is organized";
}
pub relation stock_of_another_corporation_owned_by_883c3A_corporation_883c3B(owner_corp: us.irc.core::Corporation, other: us.irc.core::Corporation) kind empirical {
    label en official "stock in another corporation is owned (directly or indirectly) by the corporation";
}
pub relation stock_treated_as_owned_by_residents_of_country_883c3B(other: us.irc.core::Corporation, country: Text) kind institutional {
    label en official "the stock is treated as owned by individuals who are residents of the foreign country in which the owning corporation is organized";
}
@source(IRC_S883_C, relation = formalizes, coverage = exact, quote = "Any stock in another corporation which is owned (directly or indirectly) by a corporation meeting the")
rule S883C3BStockAsOwnedByResidents defeasible {
    for owner_corp: us.irc.core::Corporation;
    for other: us.irc.core::Corporation;
    for country: Text;
    when corporation_meeting_883c3A_requirements_organized_in_country_883c3B(owner_corp, country)
     and stock_of_another_corporation_owned_by_883c3A_corporation_883c3B(owner_corp, other);
    then stock_treated_as_owned_by_residents_of_country_883c3B(other, country);
}
pub relation stock_owned_by_entity_percent_883c4(entity_holder: us.irc.core::Person, corp: us.irc.core::Corporation, percent: Decimal) kind empirical {
    label en official "the percentage of the corporation's stock owned (directly or indirectly) by or for a corporation, partnership, trust or estate";
}
pub relation holder_interest_in_entity_percent_883c4(holder: us.irc.core::Person, entity_holder: us.irc.core::Person, percent: Decimal) kind empirical {
    label en official "the percentage interest of the shareholder, partner or beneficiary in the corporation, partnership, trust or estate";
}
pub relation stock_owned_proportionately_883c4(holder: us.irc.core::Person, corp: us.irc.core::Corporation, percent: Decimal) kind institutional {
    label en official "stock owned by an entity is treated as owned proportionately by its shareholders, partners or beneficiaries (one step derived; the successive application needs recursion, LDC-E4102)";
}
@source(IRC_S883_C, relation = formalizes, coverage = partial, quote = "For purposes of paragraph (1), stock owned (directly or indirectly) by or for a corporation, partnership,")
rule S883C4ProportionateOneStep defeasible {
    for holder: us.irc.core::Person;
    for entity_holder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for entity_percent: Decimal;
    for interest: Decimal;
    when stock_owned_by_entity_percent_883c4(entity_holder, corp, entity_percent)
     and holder_interest_in_entity_percent_883c4(holder, entity_holder, interest);
    then stock_owned_proportionately_883c4(holder, corp, entity_percent * (interest / 100.0));
}

// --- §1441(b), (c)(3); §1444 ---------------------------------------------------------------------------------------------------

pub relation distributive_share_item_of_domestic_partnership_1441b(nra: us.irc.core::Person, partnership: us.irc.core::Person, item_id: Text, amount: Money) kind empirical {
    label en official "an item specified in subsection (b) included in the distributive share of a nonresident alien individual who is a member of a domestic partnership";
}
pub relation item_referred_to_in_1441a_for_partner_1441b(nra: us.irc.core::Person, item_id: Text, amount: Money) kind institutional {
    label en official "for the nonresident alien member of a domestic partnership the items of income referred to in subsection (a) are the items specified in subsection (b) included in the distributive share";
}
@source(IRC_S1441_B, relation = formalizes, coverage = exact, quote = "as a scholarship or fellowship for study, training, or research in the United States. In the case of a")
rule S1441BDistributiveShareItemsOfPartner defeasible {
    for nra: us.irc.core::Person;
    for partnership: us.irc.core::Person;
    for item_id: Text;
    for amount: Money;
    when distributive_share_item_of_domestic_partnership_1441b(nra, partnership, item_id, amount);
    then item_referred_to_in_1441a_for_partner_1441b(nra, item_id, amount);
}
pub relation interest_on_pre_1934_extended_obligation_1441c3(item_id: Text, interest: Money) kind empirical {
    label en official "interest on bonds, mortgages or deeds of trust of a corporation within section 1451(a)-(c) as in effect before its repeal, the maturity date having been extended on or after January 1, 1934, and the liability assumed by the debtor exceeding 27.5 percent of the interest";
}
pub relation withholding_cap_pre_1934_obligation_1441c3(item_id: Text, cap: Money) kind institutional {
    label en official "the deduction and withholding shall not exceed the rate of 27.5 percent per annum (annualized interest is the case amount)";
}
@source(IRC_S1441_C, relation = formalizes, coverage = exact, quote = "The deduction and withholding in the case of interest on bonds, mortgages, or deeds of trust or other similar")
rule S1441C3CapAtTwentySevenAndOneHalfPercent defeasible {
    for item_id: Text;
    for interest: Money;
    when interest_on_pre_1934_extended_obligation_1441c3(item_id, interest);
    then withholding_cap_pre_1934_obligation_1441c3(item_id, round(interest * 0.275, 2, "HALF_UP"));
}
pub relation virgin_islands_source_amount_1444(item_id: Text, recipient_kind: Text) kind empirical {
    label en official "an amount received from sources within the Virgin Islands by a United States citizen or resident alien individual ('individual') or a corporation organized in the United States ('corporation')";
}
pub relation virgin_islands_withholding_rate_and_tax_rate_1444(item_id: Text, withholding_rate: Decimal, tax_rate_871a1_or_881: Decimal) kind empirical {
    label en official "the rate of withholding under sections 1441 and 1442 and the rate of tax on the income under section 871(a)(1) or 881 (fractions)";
}
pub relation virgin_islands_withholding_rate_1444(item_id: Text, rate: Decimal) kind institutional {
    label en official "for withholding tax liability incurred in the Virgin Islands the rate of withholding shall not exceed the rate of tax on the income under section 871(a)(1) or 881";
}
@source(IRC_S1444, relation = formalizes, coverage = exact, quote = "For purposes of determining the withholding tax liability incurred in the Virgin Islands pursuant to this")
rule S1444RateNotAboveTaxRate defeasible {
    for item_id: Text;
    for recipient_kind: Text;
    for withholding: Decimal;
    for tax_rate: Decimal;
    when virgin_islands_source_amount_1444(item_id, recipient_kind)
     and virgin_islands_withholding_rate_and_tax_rate_1444(item_id, withholding, tax_rate);
    then virgin_islands_withholding_rate_1444(item_id, min(withholding, tax_rate));
}

// --- §1445(e)(2), (4), (5), (6) -----------------------------------------------------------------------------------------------

pub relation distribution_gain_recognized_897d_or_e_1445e2(corp: us.irc.core::Corporation, distribution_id: Text, y: us.irc.core::TaxableYear, gain: Money) kind empirical {
    label en official "gain recognized by a foreign corporation on a distribution under section 897(d) or (e)";
}
pub relation foreign_corporation_withholding_1445e2(corp: us.irc.core::Corporation, distribution_id: Text, tax: Money) kind institutional {
    label en official "the foreign corporation deducts and withholds a tax equal to the highest rate under section 11(b) for the taxable year times the gain recognized";
}
@source(IRC_S1445_E, relation = formalizes, coverage = exact, quote = "In the case of any distribution by a foreign corporation on which gain is recognized under subsection (d) or")
rule S1445E2WithholdingAmount defeasible {
    for corp: us.irc.core::Corporation;
    for distribution_id: Text;
    for y: us.irc.core::TaxableYear;
    for gain: Money;
    for rate: Decimal;
    when distribution_gain_recognized_897d_or_e_1445e2(corp, distribution_id, y, gain)
     and us.irc.corporations::maximum_section_11b_rate(y, rate)
     and gain > 0.00 USD;
    then foreign_corporation_withholding_1445e2(corp, distribution_id, round(gain * rate, 2, "HALF_UP"));
}
@source(IRC_S1445_E, relation = formalizes, coverage = exact, quote = "In the case of any distribution by a foreign corporation on which gain is recognized under subsection (d) or")
rule S1445E2DutyToWithhold defeasible {
    for corp: us.irc.core::Corporation;
    for distribution_id: Text;
    for tax: Money;
    when foreign_corporation_withholding_1445e2(corp, distribution_id, tax);
    then duty S1445E2WithholdingDuty {
        bearer corp;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition us.irc.core::payment(_, corp, tax, _);
            window [-infinity, infinity];
        }
    };
}
pub relation usrpi_distributed_to_foreign_partner_1445e4(withholder: us.irc.core::Person, distribution_id: Text, fair_market_value: Money) kind empirical {
    label en official "a United States real property interest distributed by a partnership, trust or estate to a partner or beneficiary who is a foreign person in a transaction which would constitute a taxable distribution (the fair market value at the time of the distribution)";
}
pub relation pass_through_withholding_1445e4(withholder: us.irc.core::Person, distribution_id: Text, tax: Money) kind institutional {
    label en official "the partnership, trustee or executor withholds 15 percent of the fair market value of the interest distributed";
}
@source(IRC_S1445_E, relation = formalizes, coverage = exact, quote = "A domestic or foreign partnership, the trustee of a domestic or foreign trust, or the executor of a domestic")
rule S1445E4WithholdingFifteenPercent defeasible {
    for withholder: us.irc.core::Person;
    for distribution_id: Text;
    for fmv: Money;
    when usrpi_distributed_to_foreign_partner_1445e4(withholder, distribution_id, fmv);
    then pass_through_withholding_1445e4(withholder, distribution_id, round(fmv * 0.15, 2, "HALF_UP"));
}
@source(IRC_S1445_E, relation = formalizes, coverage = exact, quote = "A domestic or foreign partnership, the trustee of a domestic or foreign trust, or the executor of a domestic")
rule S1445E4DutyToWithhold defeasible {
    for withholder: us.irc.core::Person;
    for distribution_id: Text;
    for tax: Money;
    when pass_through_withholding_1445e4(withholder, distribution_id, tax);
    then duty S1445E4WithholdingDuty {
        bearer withholder;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition us.irc.core::payment(_, withholder, tax, _);
            window [-infinity, infinity];
        }
    };
}
pub relation transfer_of_pass_through_interest_1445e5(transferee: us.irc.core::Person, transfer_id: Text, amount_realized: Money) kind empirical {
    label en official "the transfer (disposition) of a partnership interest or of a beneficial interest in a trust or estate, and the amount realized";
}
pub relation regulations_require_transferee_withholding_1445e5(transfer_id: Text) kind empirical {
    label en official "regulations require the transferee to deduct and withhold";
}
pub relation transferee_withholding_1445e5(transferee: us.irc.core::Person, transfer_id: Text, tax: Money) kind institutional {
    label en official "to the extent provided in regulations, the transferee withholds 15 percent of the amount realized";
}
@source(IRC_S1445_E, relation = formalizes, coverage = exact, quote = "To the extent provided in regulations, the transferee of a partnership interest or of a beneficial interest")
rule S1445E5TransfereeWithholding defeasible {
    for transferee: us.irc.core::Person;
    for transfer_id: Text;
    for amount: Money;
    when transfer_of_pass_through_interest_1445e5(transferee, transfer_id, amount)
     and regulations_require_transferee_withholding_1445e5(transfer_id);
    then transferee_withholding_1445e5(transferee, transfer_id, round(amount * 0.15, 2, "HALF_UP"));
}
pub relation qie_distribution_treated_as_usrpi_gain_1445e6(qie: us.irc.core::Corporation, distribution_id: Text, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "a portion of a distribution from a qualified investment entity to a nonresident alien individual or a foreign corporation treated under section 897(h)(1) as gain from a United States real property interest";
}
pub relation regulations_provide_twenty_percent_rate_1445e6(distribution_id: Text) kind empirical {
    label en official "regulations provide the rate of 20 percent";
}
pub relation qie_withholding_1445e6(qie: us.irc.core::Corporation, distribution_id: Text, tax: Money) kind institutional {
    label en official "the qualified investment entity withholds the highest section 11(b) rate (or, to the extent provided in regulations, 20 percent) times the amount so treated";
}
@source(IRC_S1445_E, relation = formalizes, coverage = exact, quote = "If any portion of a distribution from a qualified investment entity (as defined in section 897(h)(4)) to a")
rule S1445E6WithholdingAtHighestRate defeasible {
    for qie: us.irc.core::Corporation;
    for distribution_id: Text;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    for rate: Decimal;
    when qie_distribution_treated_as_usrpi_gain_1445e6(qie, distribution_id, y, amount)
     and us.irc.corporations::maximum_section_11b_rate(y, rate);
    unless regulations_provide_twenty_percent_rate_1445e6(distribution_id)
     and qie_distribution_treated_as_usrpi_gain_1445e6(qie, distribution_id, y, amount)
     and us.irc.corporations::maximum_section_11b_rate(y, rate);
    then qie_withholding_1445e6(qie, distribution_id, round(amount * rate, 2, "HALF_UP"));
}
@source(IRC_S1445_E, relation = formalizes, coverage = exact, quote = "If any portion of a distribution from a qualified investment entity (as defined in section 897(h)(4)) to a")
rule S1445E6WithholdingAtTwentyPercentByRegulation defeasible {
    for qie: us.irc.core::Corporation;
    for distribution_id: Text;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when qie_distribution_treated_as_usrpi_gain_1445e6(qie, distribution_id, y, amount)
     and regulations_provide_twenty_percent_rate_1445e6(distribution_id);
    then qie_withholding_1445e6(qie, distribution_id, round(amount * 0.20, 2, "HALF_UP"));
}

// --- §1446(c), (d)(2), (f)(2)(B)-(C) -----------------------------------------------------------------------------------------

pub relation partnership_eci_income_before_1446c_adjustments(partnership: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the taxable income of the partnership effectively connected (or treated as effectively connected) with the conduct of a trade or business in the United States, before the adjustments of subsection (c)";
}
pub relation depletion_deduction_with_sections_613_613A_1446c2(partnership: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the oil and gas depletion deduction included in the income as computed under sections 613 and 613A";
}
pub relation depletion_deduction_without_613_613A_1446c2(partnership: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the deduction for depletion with respect to oil and gas wells determined without regard to sections 613 and 613A";
}
pub relation net_items_allocable_to_non_foreign_partners_1446c3(partnership: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the net income (a loss is negative) of items allocable under section 704 to a partner who is not a foreign partner";
}
pub relation effectively_connected_taxable_income_1446c(partnership: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "effectively connected taxable income: the effectively connected taxable income with the depletion recomputed without regard to sections 613 and 613A, and without any item allocable to a partner who is not a foreign partner (paragraph (1), section 703(a)(1), is a case input: the exemption-type deduction is not taken)";
}
@source(IRC_S1446_C, relation = formalizes, coverage = exact, quote = "For purposes of this section, the term \"effectively connected taxable income\" means the taxable income of the")
rule S1446CEffectivelyConnectedTaxableIncome defeasible {
    for partnership: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for base: Money;
    for with_613: Money;
    for without_613: Money;
    for non_foreign: Money;
    when partnership_eci_income_before_1446c_adjustments(partnership, y, base)
     and depletion_deduction_with_sections_613_613A_1446c2(partnership, y, with_613)
     and depletion_deduction_without_613_613A_1446c2(partnership, y, without_613)
     and net_items_allocable_to_non_foreign_partners_1446c3(partnership, y, non_foreign);
    then effectively_connected_taxable_income_1446c(partnership, y, base + with_613 - without_613 - non_foreign);
}
pub relation section_703a1_deduction_disallowed_1446c1(partnership: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "paragraph (1) of section 703(a) does not apply in computing the effectively connected taxable income";
}
@source(IRC_S1446_C, relation = formalizes, coverage = exact, quote = "(1) Paragraph (1) of section 703(a) shall not apply.")
rule S1446C1MarkerSection703a1NotApplied defeasible {
    for partnership: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when effectively_connected_taxable_income_1446c(partnership, y, amount);
    then section_703a1_deduction_disallowed_1446c1(partnership, y);
}
pub relation withholding_tax_paid_on_date_1446d2A(partnership: us.irc.core::Person, y: us.irc.core::TaxableYear, paid_on: Date) kind empirical {
    label en official "the day on which the withholding tax was paid by the partnership";
}
pub relation partnership_year_end_1446d2B(partnership: us.irc.core::Person, y: us.irc.core::TaxableYear, last_day: Date) kind empirical {
    label en official "the last day of the partnership's taxable year for which the tax was paid";
}
pub relation deemed_distribution_date_candidate_1446d2(partnership: us.irc.core::Person, y: us.irc.core::TaxableYear, on: Date) kind institutional {
    label en official "a candidate date for the deemed distribution of the foreign partner's share of the tax: the payment day or the last day of the partnership's taxable year";
}
@source(IRC_S1446_D, relation = formalizes, coverage = exact, quote = "(A) the day on which such tax was paid by the partnership, or")
rule S1446D2ACandidatePaymentDay defeasible {
    for partnership: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for paid_on: Date;
    when withholding_tax_paid_on_date_1446d2A(partnership, y, paid_on);
    then deemed_distribution_date_candidate_1446d2(partnership, y, paid_on);
}
@source(IRC_S1446_D, relation = formalizes, coverage = exact, quote = "(B) the last day of the partnership's taxable year for which such tax was paid.")
rule S1446D2BCandidateLastDayOfYear defeasible {
    for partnership: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for last_day: Date;
    when partnership_year_end_1446d2B(partnership, y, last_day);
    then deemed_distribution_date_candidate_1446d2(partnership, y, last_day);
}
pub relation deemed_distribution_date_1446d2(partnership: us.irc.core::Person, y: us.irc.core::TaxableYear, on: Date) kind institutional {
    label en official "the foreign partner's share of the withholding tax is treated as distributed on the earlier of the payment day and the last day of the partnership's taxable year (except as provided in regulations)";
}
@source(IRC_S1446_D, relation = formalizes, coverage = exact, quote = "Except as provided in regulations, a foreign partner's share of any withholding tax paid by the partnership")
rule S1446D2EarlierOfTwoDates defeasible {
    for partnership: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for on: Date;
    for earlier: Date;
    when deemed_distribution_date_candidate_1446d2(partnership, y, on);
    unless deemed_distribution_date_candidate_1446d2(partnership, y, earlier)
     and earlier < on
     and deemed_distribution_date_candidate_1446d2(partnership, y, on);
    then deemed_distribution_date_1446d2(partnership, y, on);
}
pub relation transferee_knows_or_is_notified_affidavit_false_1446f2Bi(transferee: us.irc.core::Person) kind empirical {
    label en official "the transferee has actual knowledge that the affidavit is false, or receives a notice (section 1445(d)) from a transferor's or transferee's agent that it is false";
}
pub relation regulations_require_copy_of_affidavit_1446f2Bii(transferee: us.irc.core::Person) kind empirical {
    label en official "the Secretary by regulations requires the transferee to furnish a copy of the affidavit or statement to the Secretary";
}
pub relation transferee_failed_to_furnish_copy_1446f2Bii(transferee: us.irc.core::Person) kind empirical {
    label en official "the transferee fails to furnish the copy at the time and in the manner required";
}
pub relation affidavit_exception_1446f2A_not_applicable_1446f2B(transferee: us.irc.core::Person) kind institutional {
    label en official "subparagraph (A) (the nonforeign affidavit exception) does not apply to the disposition";
}
@source(IRC_S1446_F, relation = formalizes, coverage = exact, quote = "(i) the transferee has actual knowledge that the affidavit is false, or the transferee receives a notice (as")
rule S1446F2BiKnowledgeOrNotice defeasible {
    for transferee: us.irc.core::Person;
    when transferee_knows_or_is_notified_affidavit_false_1446f2Bi(transferee);
    then affidavit_exception_1446f2A_not_applicable_1446f2B(transferee);
}
@source(IRC_S1446_F, relation = formalizes, coverage = exact, quote = "(ii) the Secretary by regulations requires the transferee to furnish a copy of such affidavit or statement to")
rule S1446F2BiiFailureToFurnishCopy defeasible {
    for transferee: us.irc.core::Person;
    when regulations_require_copy_of_affidavit_1446f2Bii(transferee)
     and transferee_failed_to_furnish_copy_1446f2Bii(transferee);
    then affidavit_exception_1446f2A_not_applicable_1446f2B(transferee);
}
pub relation agent_of_1446f_transaction_1446f2C(agent: us.irc.core::Person, transferee: us.irc.core::Person) kind empirical {
    label en official "the person is a transferor's agent or transferee's agent with respect to the affidavit";
}
pub relation section_1445d_rules_apply_to_agent_1446f2C(agent: us.irc.core::Person, transferee: us.irc.core::Person) kind institutional {
    label en official "the rules of section 1445(d) apply to the agent with respect to the affidavit as they apply to the disposition of a United States real property interest";
}
@source(IRC_S1446_F, relation = formalizes, coverage = exact, quote = "The rules of section 1445(d) shall apply to a transferor's agent or transferee's agent with respect to any")
rule S1446F2CAgentRulesOfSection1445d defeasible {
    for agent: us.irc.core::Person;
    for transferee: us.irc.core::Person;
    when agent_of_1446f_transaction_1446f2C(agent, transferee);
    then section_1445d_rules_apply_to_agent_1446f2C(agent, transferee);
}

// --- §1471(b)(3), (d)(7), (e); §1473; §1474 ------------------------------------------------------------------------------------

pub relation ffi_meets_1471b_requirements_and_elects_1471b3(ffi: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the foreign financial institution meets the requirements of the subsection and elects the application of paragraph (3) (to be withheld upon rather than withhold on payments to recalcitrant account holders and nonparticipating institutions)";
}
pub relation payment_allocable_to_recalcitrant_or_nonparticipating_1471b3B(agent: us.irc.core::Person, ffi: us.irc.core::Person, amount: Money, allocable: Money) kind empirical {
    label en official "a withholdable payment to the institution, and the part allocable to accounts held by recalcitrant account holders or foreign financial institutions which do not meet the requirements";
}
pub relation election_notified_to_withholding_agent_1471b3Ci(ffi: us.irc.core::Person, agent: us.irc.core::Person) kind empirical {
    label en official "the institution notified the withholding agent of the election with each payment, with the information necessary to determine the amount to withhold";
}
pub relation election_waives_treaty_rights_1471b3Cii(ffi: us.irc.core::Person) kind empirical {
    label en official "the agreement includes a waiver of any treaty right with respect to amounts deducted and withheld under the election";
}
pub relation election_requirements_met_1471b3(ffi: us.irc.core::Person, agent: us.irc.core::Person) kind institutional {
    label en official "the election under paragraph (3) has the required content: notification of each payment and a treaty waiver";
}
@source(IRC_S1471_B, relation = formalizes, coverage = exact, quote = "(C) the agreement described in paragraph (1) shall—")
rule S1471B3CElectionContent defeasible {
    for ffi: us.irc.core::Person;
    for agent: us.irc.core::Person;
    when election_notified_to_withholding_agent_1471b3Ci(ffi, agent)
     and election_waives_treaty_rights_1471b3Cii(ffi);
    then election_requirements_met_1471b3(ffi, agent);
}
pub relation withholding_on_allocable_part_1471b3B(agent: us.irc.core::Person, ffi: us.irc.core::Person, tax: Money) kind institutional {
    label en official "under the election, tax applies to a withholdable payment to the institution to the extent allocable to recalcitrant account holders or nonparticipating institutions (30 percent of the allocable part)";
}
@source(IRC_S1471_B, relation = formalizes, coverage = exact, quote = "(B) the withholding tax imposed under subsection (a) shall apply with respect to any withholdable payment to")
rule S1471B3BWithholdingOnAllocablePart defeasible {
    for agent: us.irc.core::Person;
    for ffi: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    for allocable: Money;
    when ffi_meets_1471b_requirements_and_elects_1471b3(ffi, y)
     and election_requirements_met_1471b3(ffi, agent)
     and payment_allocable_to_recalcitrant_or_nonparticipating_1471b3B(agent, ffi, amount, allocable);
    then withholding_on_allocable_part_1471b3B(agent, ffi, round(allocable * 0.30, 2, "HALF_UP"));
}
pub relation paragraph_1D_not_applicable_under_election_1471b3A(ffi: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the requirements of paragraph (1)(D) do not apply to an institution that made the election";
}
@source(IRC_S1471_B, relation = formalizes, coverage = exact, quote = "(B) the withholding tax imposed under subsection (a) shall apply with respect to any withholdable payment to")
rule S1471B3AParagraph1DNotApplicable defeasible {
    for ffi: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when ffi_meets_1471b_requirements_and_elects_1471b3(ffi, y);
    then paragraph_1D_not_applicable_under_election_1471b3A(ffi, y);
}
pub relation passthru_payment_to_electing_institution_1471b1Dii(agent: us.irc.core::Person, ffi: us.irc.core::Person, payment_id: Text, payment: Money, allocable: Money) kind empirical {
    label en official "a passthru payment made by the institution to a foreign financial institution which has an election under paragraph (3) in effect with respect to the payment, and the part allocable to accounts held by recalcitrant account holders or institutions that do not meet the requirements";
}
pub relation amount_subject_to_withholding_under_1471b1Dii(agent: us.irc.core::Person, ffi: us.irc.core::Person, payment_id: Text, amount: Money) kind institutional {
    label en official "so much of the passthru payment as is allocable to accounts held by recalcitrant account holders or nonparticipating institutions is subject to withholding by the institution";
}
@source(IRC_S1471_B, relation = formalizes, coverage = exact, quote = "(ii) in the case of any passthru payment which is made by such institution to a foreign financial institution")
rule S1471B1DiiAllocablePartOfPassthruPayment defeasible {
    for agent: us.irc.core::Person;
    for ffi: us.irc.core::Person;
    for payment_id: Text;
    for payment: Money;
    for allocable: Money;
    when passthru_payment_to_electing_institution_1471b1Dii(agent, ffi, payment_id, payment, allocable);
    then amount_subject_to_withholding_under_1471b1Dii(agent, ffi, payment_id, min(payment, allocable));
}
pub relation withholdable_payment_1471d7(payment_id: Text) kind empirical {
    label en official "the payment is a withholdable payment";
}
pub relation payment_attributable_to_withholdable_payment_1471d7(payment_id: Text, source_payment_id: Text, attributable: Money) kind empirical {
    label en official "another payment to the extent attributable to a withholdable payment, and the attributable part";
}
pub relation passthru_payment_1471d7(payment_id: Text, amount: Money) kind institutional {
    label en official "a passthru payment: a withholdable payment, or another payment to the extent attributable to a withholdable payment";
}
pub relation withholdable_payment_amount_1471d7(payment_id: Text, amount: Money) kind empirical {
    label en official "the amount of the withholdable payment";
}
@source(IRC_S1471_D, relation = formalizes, coverage = exact, quote = "The term \"passthru payment\" means any withholdable payment or other payment to the extent attributable to a")
rule S1471D7WithholdablePaymentIsPassthru defeasible {
    for payment_id: Text;
    for amount: Money;
    when withholdable_payment_1471d7(payment_id)
     and withholdable_payment_amount_1471d7(payment_id, amount);
    then passthru_payment_1471d7(payment_id, amount);
}
@source(IRC_S1471_D, relation = formalizes, coverage = exact, quote = "The term \"passthru payment\" means any withholdable payment or other payment to the extent attributable to a")
rule S1471D7AttributedPaymentIsPassthruToExtent defeasible {
    for payment_id: Text;
    for source_payment_id: Text;
    for attributable: Money;
    when payment_attributable_to_withholdable_payment_1471d7(payment_id, source_payment_id, attributable);
    then passthru_payment_1471d7(payment_id, attributable);
}
pub relation ffi_member_of_expanded_affiliated_group_1471e(ffi: us.irc.core::Person, other: us.irc.core::Person) kind empirical {
    label en official "the other foreign financial institution is a member of the same expanded affiliated group (and does not meet the requirements of subsection (b))";
}
pub relation us_accounts_maintained_by_1471e1(ffi: us.irc.core::Person, count: Integer) kind empirical {
    label en official "the number of United States accounts maintained by the foreign financial institution";
}
pub relation requirements_apply_to_us_accounts_of_group_member_1471e1B(ffi: us.irc.core::Person, other: us.irc.core::Person) kind institutional {
    label en official "the requirements of subsections (b) and (c)(1) apply with respect to the United States accounts maintained by each other foreign financial institution of the same expanded affiliated group that does not meet the requirements of subsection (b) (except as the Secretary provides)";
}
@source(IRC_S1471_E, relation = formalizes, coverage = exact, quote = "(B) except as otherwise provided by the Secretary, with respect to United States accounts maintained by each")
rule S1471E1BGroupMembersUsAccounts defeasible {
    for ffi: us.irc.core::Person;
    for other: us.irc.core::Person;
    when ffi_member_of_expanded_affiliated_group_1471e(ffi, other);
    then requirements_apply_to_us_accounts_of_group_member_1471e1B(ffi, other);
}
pub relation entity_controlled_by_group_members_954d3_1471e2(non_corporate: us.irc.core::Person, group_member: us.irc.core::Person) kind empirical {
    label en official "a partnership or other non-corporate entity is controlled (section 954(d)(3)) by members of the group (including an entity treated as a member by this sentence; one step derived)";
}
pub relation entity_treated_as_member_of_expanded_group_1471e2(non_corporate: us.irc.core::Person, group_member: us.irc.core::Person) kind institutional {
    label en official "the non-corporate entity is treated as a member of the expanded affiliated group";
}
@source(IRC_S1471_E, relation = formalizes, coverage = partial, quote = "A partnership or any other entity (other than a corporation) shall be treated as a member of an expanded")
rule S1471E2NonCorporateEntityControlled defeasible {
    for non_corporate: us.irc.core::Person;
    for group_member: us.irc.core::Person;
    when entity_controlled_by_group_members_954d3_1471e2(non_corporate, group_member);
    then entity_treated_as_member_of_expanded_group_1471e2(non_corporate, group_member);
}
pub relation ffi_is_qualified_intermediary_for_1441_1471c3(ffi: us.irc.core::Person) kind empirical {
    label en official "the foreign financial institution is treated as a qualified intermediary by the Secretary for purposes of section 1441";
}
pub relation section_1471_requirements_in_addition_to_qi_requirements_1471c3(ffi: us.irc.core::Person) kind institutional {
    label en official "the requirements of this section are in addition to any reporting or other requirements imposed for the qualified-intermediary treatment";
}
@source(IRC_S1471_C, relation = formalizes, coverage = exact, quote = "In the case of a foreign financial institution which is treated as a qualified intermediary by the Secretary")
rule S1471C3InAdditionToQiRequirements defeasible {
    for ffi: us.irc.core::Person;
    when ffi_is_qualified_intermediary_for_1441_1471c3(ffi);
    then section_1471_requirements_in_addition_to_qi_requirements_1471c3(ffi);
}
pub relation interest_from_foreign_branch_deposit_1473(item_id: Text) kind empirical {
    label en official "interest on deposits with a foreign branch of a domestic corporation or partnership engaged in the commercial banking business";
}
pub relation section_861a1B_disapplied_for_chapter_4_1473(item_id: Text) kind institutional {
    label en official "for chapter 4 subparagraph (B) of section 861(a)(1) does not apply: the foreign branch deposit interest is not excepted from United States source";
}
@source(IRC_S1473, relation = formalizes, coverage = exact, quote = "Subparagraph (B) of section 861(a)(1) shall not apply.")
rule S1473SubparagraphBNotApplied defeasible {
    for item_id: Text;
    when interest_from_foreign_branch_deposit_1473(item_id);
    then section_861a1B_disapplied_for_chapter_4_1473(item_id);
}
pub relation tax_withheld_under_chapter_4_1474b1(item_id: Text, tax: Money) kind empirical {
    label en official "tax deducted and withheld under chapter 4";
}
pub relation overpayment_determined_as_if_chapter_3_1474b1(item_id: Text, tax: Money) kind institutional {
    label en official "whether the tax withheld under chapter 4 results in an overpayment by the beneficial owner is determined as if it had been withheld under subchapter A of chapter 3";
}
@source(IRC_S1474_B, relation = formalizes, coverage = exact, quote = "Except as provided in paragraph (2), the determination of whether any tax deducted and withheld under this")
rule S1474B1AsIfChapterThree defeasible {
    for item_id: Text;
    for tax: Money;
    when tax_withheld_under_chapter_4_1474b1(item_id, tax);
    then overpayment_determined_as_if_chapter_3_1474b1(item_id, tax);
}
pub relation chapter_4_withholding_rules_similar_to_3406f_1474c1(item_id: Text) kind institutional {
    label en official "for this chapter, rules similar to the rules of section 3406(f) apply (the reference is to the rules on repayment of amounts erroneously withheld; their content is section 3406, outside this package)";
}
@source(IRC_S1474_C, relation = formalizes, coverage = partial, quote = "For purposes of this chapter, rules similar to the rules of section 3406(f) shall apply.")
rule S1474C1RulesSimilarToSection3406f defeasible {
    for item_id: Text;
    for tax: Money;
    when tax_withheld_under_chapter_4_1474b1(item_id, tax);
    then chapter_4_withholding_rules_similar_to_3406f_1474c1(item_id);
}
