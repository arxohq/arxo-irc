// §§872-876, 879, 881-883, 887, 891-896 (stage 2d): gross income and deductions of
// nonresident aliens and foreign corporations, exemptions of transportation income,
// governments and international organizations, treaties and retaliatory taxes.
// Amounts and classifications are case inputs; `effectively_connected`, `fdap_tax`
// and `foreign_corp_fdap_tax` come from modules 02 and 03.

// --- §872(a), (b): gross income of nonresident aliens -------------------------------

use self::{
    IRC_S872_A,
    IRC_S872_B,
    IRC_S873_A,
    IRC_S873_B,
    IRC_S874_A,
    IRC_S874_C,
    IRC_S875,
    IRC_S876_A,
    IRC_S879_A,
    IRC_S881_A,
    IRC_S881_B,
    IRC_S881_C,
    IRC_S881_D,
    IRC_S881_E,
    IRC_S882_A,
    IRC_S882_B,
    IRC_S882_C,
    IRC_S882_D,
    IRC_S882_E,
    IRC_S882_F,
    IRC_S883_A,
    IRC_S883_B,
    IRC_S883_C,
    IRC_S887_A,
    IRC_S887_B,
    IRC_S891,
    IRC_S892_A,
    IRC_S892_B,
    IRC_S893_A,
    IRC_S894_B,
    IRC_S894_C,
    IRC_S895,
    IRC_S896_A,
    IRC_S896_B,
    IRC_S896_C,
    IRC_S896_D,
    President,
    beneficial_owner_non_us_statement_received,
    contingent_interest_denied_871h4A,
    effectively_connected,
    foreign_corp_fdap_tax,
    obligation_in_registered_form,
    portfolio_interest_denied_by_871h6,
    secretary_determined_statement_not_required,
    statement_disqualified_871h5,
};

pub relation gross_income_item_872a(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, item_id: Text, amount: Money) kind empirical {
    label en official "an item of gross income of a nonresident alien individual for the year";
}
pub relation derived_from_us_sources_872a(item_id: Text) kind empirical {
    label en official "the gross income is derived from sources within the United States";
}
pub relation gross_income_included_872a(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, item_id: Text, amount: Money) kind institutional {
    label en official "the item is included in the gross income of the nonresident alien individual (section 872(a): US-source income not effectively connected, and effectively connected income)";
}
@source(IRC_S872_A, relation = formalizes, coverage = exact, quote = "(1) gross income which is derived from sources within the United States and which is not effectively connected with the conduct of a trade or business within the United States, and")
rule S872A1UsSourceNotEffectivelyConnected defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for amount: Money;
    when gross_income_item_872a(p, y, item_id, amount)
     and derived_from_us_sources_872a(item_id);
    unless effectively_connected(p, item_id)
     and gross_income_item_872a(p, y, item_id, amount);
    then gross_income_included_872a(p, y, item_id, amount);
}
@source(IRC_S872_A, relation = formalizes, coverage = exact, quote = "(2) gross income which is effectively connected with the conduct of a trade or business within the United States.")
rule S872A2EffectivelyConnected defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for amount: Money;
    when gross_income_item_872a(p, y, item_id, amount)
     and effectively_connected(p, item_id);
    then gross_income_included_872a(p, y, item_id, amount);
}
pub relation income_from_international_operation_of_ship_872b1(p: us.irc.core::Individual, item_id: Text, country: Text) kind empirical {
    label en official "gross income derived by an individual resident of the foreign country from the international operation of a ship or ships";
}
pub relation income_from_international_operation_of_aircraft_872b2(p: us.irc.core::Individual, item_id: Text, country: Text) kind empirical {
    label en official "gross income derived by an individual resident of the foreign country from the international operation of aircraft";
}
pub relation rental_of_ship_full_or_bareboat_872b6(p: us.irc.core::Individual, item_id: Text, country: Text) kind empirical {
    label en official "income derived from the rental on a full or bareboat basis of a ship or ships";
}
pub relation rental_of_aircraft_full_or_bareboat_872b6(p: us.irc.core::Individual, item_id: Text, country: Text) kind empirical {
    label en official "income derived from the rental on a full or bareboat basis of aircraft";
}
pub relation country_grants_equivalent_exemption_to_us_individuals_872b(country: Text, transport: Text) kind empirical {
    label en official "the foreign country grants an equivalent exemption to individual residents of the United States for `ship` or `aircraft` income";
}
pub relation compensation_from_foreign_employer_to_fjq_visitor_872b3(p: us.irc.core::Individual, item_id: Text) kind empirical {
    label en official "compensation paid by a foreign employer to a nonresident alien individual for the period temporarily present in the United States as a nonimmigrant under subparagraph (F), (J) or (Q) of section 101(a)(15)";
}
pub relation employer_is_nonresident_alien_or_foreign_entity_872b3A(item_id: Text) kind empirical {
    label en official "the employer is a nonresident alien individual, foreign partnership or foreign corporation";
}
pub relation employer_is_foreign_office_of_domestic_person_872b3B(item_id: Text) kind empirical {
    label en official "the employer is an office or place of business maintained in a foreign country or possession by a domestic corporation, domestic partnership or a citizen or resident individual";
}
pub relation foreign_employer_872b3(item_id: Text) kind institutional {
    label en official "a foreign employer (section 872(b)(3))";
}
@source(IRC_S872_B, relation = formalizes, coverage = exact, quote = "(A) a nonresident alien individual, foreign partnership, or foreign corporation, or")
rule S872B3AForeignEmployerAlienOrForeignEntity defeasible {
    for item_id: Text;
    when employer_is_nonresident_alien_or_foreign_entity_872b3A(item_id);
    then foreign_employer_872b3(item_id);
}
@source(IRC_S872_B, relation = formalizes, coverage = exact, quote = "(B) an office or place of business maintained in a foreign country or in a possession of the United States by a domestic corporation, a domestic partnership, or an individual who is a citizen or")
rule S872B3BForeignEmployerForeignOffice defeasible {
    for item_id: Text;
    when employer_is_foreign_office_of_domestic_person_872b3B(item_id);
    then foreign_employer_872b3(item_id);
}
pub relation series_e_or_h_bond_income_872b4(p: us.irc.core::Individual, item_id: Text) kind empirical {
    label en official "income derived from a series E or series H United States savings bond";
}
pub relation bond_acquired_while_resident_of_ryukyu_or_trust_territory_872b4(item_id: Text) kind empirical {
    label en official "the individual acquired the bond while a resident of the Ryukyu Islands or the Trust Territory of the Pacific Islands";
}
pub relation legal_parimutuel_wager_abroad_on_us_live_race_872b5(p: us.irc.core::Individual, item_id: Text) kind empirical {
    label en official "gross income from a legal wagering transaction initiated outside the United States in a parimutuel pool on a live horse race or dog race in the United States";
}
pub relation income_excluded_and_exempt_872b(p: us.irc.core::Individual, item_id: Text) kind institutional {
    label en official "the item is not included in the gross income of the nonresident alien individual and is exempt from taxation under this subtitle (section 872(b))";
}
@source(IRC_S872_B, relation = formalizes, coverage = exact, quote = "Gross income derived by an individual resident of a foreign country from the international operation of a ship or ships if such foreign country grants an equivalent exemption to individual residents")
rule S872B1ShipIncomeExempt defeasible {
    for p: us.irc.core::Individual;
    for item_id: Text;
    for country: Text;
    when income_from_international_operation_of_ship_872b1(p, item_id, country)
     and country_grants_equivalent_exemption_to_us_individuals_872b(country, "ship");
    then income_excluded_and_exempt_872b(p, item_id);
}
@source(IRC_S872_B, relation = formalizes, coverage = exact, quote = "Gross income derived by an individual resident of a foreign country from the international operation of aircraft if such foreign country grants an equivalent exemption to individual residents of the")
rule S872B2AircraftIncomeExempt defeasible {
    for p: us.irc.core::Individual;
    for item_id: Text;
    for country: Text;
    when income_from_international_operation_of_aircraft_872b2(p, item_id, country)
     and country_grants_equivalent_exemption_to_us_individuals_872b(country, "aircraft");
    then income_excluded_and_exempt_872b(p, item_id);
}
@source(IRC_S872_B, relation = formalizes, coverage = exact, quote = "Income to which paragraphs (1) and (2) apply shall include income which is derived from the rental on a full or bareboat basis of a ship or ships or aircraft, as the case may be.")
rule S872B6ShipRentalIncomeExempt defeasible {
    for p: us.irc.core::Individual;
    for item_id: Text;
    for country: Text;
    when rental_of_ship_full_or_bareboat_872b6(p, item_id, country)
     and country_grants_equivalent_exemption_to_us_individuals_872b(country, "ship");
    then income_excluded_and_exempt_872b(p, item_id);
}
rule S872B6AircraftRentalIncomeExempt defeasible {
    for p: us.irc.core::Individual;
    for item_id: Text;
    for country: Text;
    when rental_of_aircraft_full_or_bareboat_872b6(p, item_id, country)
     and country_grants_equivalent_exemption_to_us_individuals_872b(country, "aircraft");
    then income_excluded_and_exempt_872b(p, item_id);
}
@source(IRC_S872_B, relation = formalizes, coverage = exact, quote = "Compensation paid by a foreign employer to a nonresident alien individual for the period he is temporarily present in the United States as a nonimmigrant under subparagraph (F), (J), or (Q) of")
rule S872B3ForeignEmployerCompensationExempt defeasible {
    for p: us.irc.core::Individual;
    for item_id: Text;
    when compensation_from_foreign_employer_to_fjq_visitor_872b3(p, item_id)
     and foreign_employer_872b3(item_id);
    then income_excluded_and_exempt_872b(p, item_id);
}
@source(IRC_S872_B, relation = formalizes, coverage = exact, quote = "Income derived by a nonresident alien individual from a series E or series H United States savings bond, if such individual acquired such bond while a resident of the Ryukyu Islands or the Trust")
rule S872B4SavingsBondIncomeExempt defeasible {
    for p: us.irc.core::Individual;
    for item_id: Text;
    when series_e_or_h_bond_income_872b4(p, item_id)
     and bond_acquired_while_resident_of_ryukyu_or_trust_territory_872b4(item_id);
    then income_excluded_and_exempt_872b(p, item_id);
}
@source(IRC_S872_B, relation = formalizes, coverage = exact, quote = "Gross income derived by a nonresident alien individual from a legal wagering transaction initiated outside the United States in a parimutuel pool with respect to a live horse race or dog race in the")
rule S872B5ParimutuelWagerIncomeExempt defeasible {
    for p: us.irc.core::Individual;
    for item_id: Text;
    when legal_parimutuel_wager_abroad_on_us_live_race_872b5(p, item_id);
    then income_excluded_and_exempt_872b(p, item_id);
}

// --- §873 -------------------------------------------------------------------------------

pub relation deduction_item_873(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, ded_id: Text, amount: Money) kind empirical {
    label en official "a deduction claimed by a nonresident alien individual for the year";
}
pub relation deduction_connected_with_eci_873a(ded_id: Text) kind empirical {
    label en official "the deduction is connected with income which is effectively connected with the conduct of a trade or business within the United States (proper apportionment and allocation by regulations)";
}
pub relation casualty_or_theft_loss_of_us_property_873b1(ded_id: Text) kind empirical {
    label en official "a casualty or theft loss described in section 165(c)(2) or (3) of property located within the United States";
}
pub relation charitable_contribution_deduction_873b2(ded_id: Text) kind empirical {
    label en official "the deduction for charitable contributions and gifts allowed by section 170";
}
pub relation deduction_allowed_873(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, ded_id: Text, amount: Money) kind institutional {
    label en official "the deduction is allowed to the nonresident alien individual (section 873)";
}
@source(IRC_S873_A, relation = formalizes, coverage = partial, quote = "In the case of a nonresident alien individual, the deductions shall be allowed only for purposes of section 871(b) and (except as provided by subsection (b)) only if and to the extent that they are")
rule S873ADeductionConnectedWithEci defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for ded_id: Text;
    for amount: Money;
    when deduction_item_873(p, y, ded_id, amount)
     and deduction_connected_with_eci_873a(ded_id);
    then deduction_allowed_873(p, y, ded_id, amount);
}
@source(IRC_S873_B, relation = formalizes, coverage = exact, quote = "The deduction allowed by section 165 for casualty or theft losses described in paragraph (2) or (3) of section 165(c), but only if the loss is of property located within the United States.")
rule S873B1CasualtyLossOfUsProperty defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for ded_id: Text;
    for amount: Money;
    when deduction_item_873(p, y, ded_id, amount)
     and casualty_or_theft_loss_of_us_property_873b1(ded_id);
    then deduction_allowed_873(p, y, ded_id, amount);
}
@source(IRC_S873_B, relation = formalizes, coverage = exact, quote = "The deduction for charitable contributions and gifts allowed by section 170.")
rule S873B2CharitableContributions defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for ded_id: Text;
    for amount: Money;
    when deduction_item_873(p, y, ded_id, amount)
     and charitable_contribution_deduction_873b2(ded_id);
    then deduction_allowed_873(p, y, ded_id, amount);
}
pub relation personal_exemptions_claimed_873b3(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, count: Integer) kind empirical {
    label en official "the number of section 151 personal exemptions the nonresident alien individual claims";
}
pub relation resident_of_contiguous_country_or_us_national_873b3(p: us.irc.core::Individual) kind empirical {
    label en official "the taxpayer is a resident of a contiguous country or is a national of the United States";
}
pub relation personal_exemptions_allowed_873b3(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, count: Integer) kind institutional {
    label en official "the number of personal exemptions allowed: only one unless the taxpayer is a resident of a contiguous country or a national of the United States (section 873(b)(3))";
}
@source(IRC_S873_B, relation = formalizes, coverage = exact, quote = "The deduction for personal exemptions allowed by section 151, except that only one exemption shall be allowed under section 151 unless the taxpayer is a resident of a contiguous country or is a")
rule S873B3ExemptionsContiguousOrNational defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for n: Integer;
    when personal_exemptions_claimed_873b3(p, y, n)
     and resident_of_contiguous_country_or_us_national_873b3(p);
    then personal_exemptions_allowed_873b3(p, y, n);
}
rule S873B3ExemptionsOtherwiseOne defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for n: Integer;
    when personal_exemptions_claimed_873b3(p, y, n);
    unless resident_of_contiguous_country_or_us_national_873b3(p)
     and personal_exemptions_claimed_873b3(p, y, n);
    then personal_exemptions_allowed_873b3(p, y, min(n, 1));
}

// --- §874 ---------------------------------------------------------------------------------

pub relation nonresident_alien_taxable_year_874(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind empirical {
    label en unofficial "the taxable year of a nonresident alien individual (a domain anchor for section 874)";
}
pub relation true_and_accurate_return_filed_874a(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the nonresident alien individual files, or causes to be filed, a true and accurate return with all the information the Secretary may deem necessary for the calculation of deductions and credits";
}
pub relation benefit_of_deductions_and_credits_874a(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the nonresident alien individual receives the benefit of the deductions and credits allowed only by filing the return (section 874(a))";
}
@source(IRC_S874_A, relation = formalizes, coverage = partial, quote = "A nonresident alien individual shall receive the benefit of the deductions and credits allowed to him in this subtitle only by filing or causing to be filed with the Secretary a true and accurate")
rule S874AReturnConditionsBenefit defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    when nonresident_alien_taxable_year_874(p, y)
     and true_and_accurate_return_filed_874a(p, y);
    then benefit_of_deductions_and_credits_874a(p, y);
}
pub relation credit_allowed_by_section_906_874c(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the credit for foreign taxes is allowed by section 906";
}
pub relation foreign_tax_credit_denied_874c(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind institutional {
    label en official "a nonresident alien individual is not allowed the section 901 credit for taxes of foreign countries and possessions (section 874(c))";
}
@source(IRC_S874_C, relation = formalizes, coverage = exact, quote = "Except as provided in section 906, a nonresident alien individual shall not be allowed the credits against the tax for taxes of foreign countries and possessions of the United States allowed by")
rule S874CNoForeignTaxCreditExceptSection906 defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    when nonresident_alien_taxable_year_874(p, y);
    unless credit_allowed_by_section_906_874c(p, y)
     and nonresident_alien_taxable_year_874(p, y);
    then foreign_tax_credit_denied_874c(p, y);
}

// --- §875 ---------------------------------------------------------------------------------

pub relation nonresident_alien_or_foreign_corporation_875(p: us.irc.core::Person) kind empirical {
    label en official "the person is a nonresident alien individual or a foreign corporation";
}
pub relation member_of_partnership_875_1(p: us.irc.core::Person, partnership_id: Text) kind empirical {
    label en official "the person is a member of the partnership";
}
pub relation partnership_engaged_in_us_trade_or_business_875(partnership_id: Text) kind empirical {
    label en official "the partnership is engaged in a trade or business within the United States";
}
pub relation beneficiary_of_estate_or_trust_875_2(p: us.irc.core::Person, trust_id: Text) kind empirical {
    label en official "the person is a beneficiary of the estate or trust";
}
pub relation estate_or_trust_engaged_in_us_trade_or_business_875(trust_id: Text) kind empirical {
    label en official "the estate or trust is engaged in a trade or business within the United States";
}
pub relation treated_as_engaged_in_us_trade_or_business_875(p: us.irc.core::Person) kind institutional {
    label en official "the nonresident alien individual or foreign corporation is considered as engaged in a trade or business within the United States through the partnership or the estate or trust (section 875)";
}
@source(IRC_S875, relation = formalizes, coverage = exact, quote = "(1) a nonresident alien individual or foreign corporation shall be considered as being engaged in a trade or business within the United States if the partnership of which such individual or")
rule S8751PartnershipMember defeasible {
    for p: us.irc.core::Person;
    for partnership_id: Text;
    when nonresident_alien_or_foreign_corporation_875(p)
     and member_of_partnership_875_1(p, partnership_id)
     and partnership_engaged_in_us_trade_or_business_875(partnership_id);
    then treated_as_engaged_in_us_trade_or_business_875(p);
}
@source(IRC_S875, relation = formalizes, coverage = exact, quote = "(2) a nonresident alien individual or foreign corporation which is a beneficiary of an estate or trust which is engaged in any trade or business within the United States shall be treated as being")
rule S8752EstateOrTrustBeneficiary defeasible {
    for p: us.irc.core::Person;
    for trust_id: Text;
    when nonresident_alien_or_foreign_corporation_875(p)
     and beneficiary_of_estate_or_trust_875_2(p, trust_id)
     and estate_or_trust_engaged_in_us_trade_or_business_875(trust_id);
    then treated_as_engaged_in_us_trade_or_business_875(p);
}

// --- §876 ---------------------------------------------------------------------------------

pub relation bona_fide_resident_of_named_possession_876a(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind empirical {
    label en official "an alien individual who is a bona fide resident of Puerto Rico, Guam, American Samoa or the Northern Mariana Islands during the entire taxable year";
}
pub relation subpart_inapplicable_taxed_under_section_1_876a(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the subpart on nonresident aliens does not apply to the alien individual, who is subject to the tax imposed by section 1 (section 876(a))";
}
@source(IRC_S876_A, relation = formalizes, coverage = exact, quote = "This subpart shall not apply to any alien individual who is a bona fide resident of Puerto Rico, Guam, American Samoa, or the Northern Mariana Islands during the entire taxable year and such alien")
rule S876ABonaFideResidentOfPossession defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    when bona_fide_resident_of_named_possession_876a(p, y);
    then subpart_inapplicable_taxed_under_section_1_876a(p, y);
}

// --- §879 ---------------------------------------------------------------------------------

pub relation community_income_item_879a(item_id: Text, kind: Text, amount: Money) kind empirical {
    label en official "community income of a married couple one or both of whom are nonresident alien individuals, of the kind `earned_income`, `trade_or_business_or_partnership`, `separate_property` or `other`";
}
pub relation spouse_who_rendered_services_879a1(item_id: Text, spouse: Text) kind empirical {
    label en official "the spouse who rendered the personal services from which the earned income arises";
}
pub relation spouse_treatment_under_1402a5_879a2(item_id: Text, spouse: Text) kind empirical {
    label en official "the spouse to whom section 1402(a)(5) attributes the trade or business income or partner's distributive share";
}
pub relation separate_property_owner_spouse_879a3(item_id: Text, spouse: Text) kind empirical {
    label en official "the spouse who owns the separate property (under the applicable community property law) from which the income is derived";
}
pub relation applicable_community_property_law_treatment_879a4(item_id: Text, spouse: Text) kind empirical {
    label en official "the spouse to whom the applicable community property law attributes the income";
}
pub relation section_6013_election_in_effect_879b(item_id: Text) kind empirical {
    label en official "an election under subsection (g) or (h) of section 6013 (to treat a nonresident alien individual as a resident) is in effect for the taxable year";
}
pub relation community_income_treated_as_income_of_879a(item_id: Text, spouse: Text) kind institutional {
    label en official "the community income is treated as the income of the spouse (section 879(a))";
}
@source(IRC_S879_A, relation = formalizes, coverage = exact, quote = "(1) Earned income (within the meaning of section 911(d)(2)), other than trade or business income and a partner's distributive share of partnership income, shall be treated as the income of the spouse")
rule S879A1EarnedIncomeToServiceSpouse defeasible {
    for item_id: Text;
    for amount: Money;
    for spouse: Text;
    when community_income_item_879a(item_id, "earned_income", amount)
     and spouse_who_rendered_services_879a1(item_id, spouse);
    unless section_6013_election_in_effect_879b(item_id)
     and community_income_item_879a(item_id, "earned_income", amount)
     and spouse_who_rendered_services_879a1(item_id, spouse);
    then community_income_treated_as_income_of_879a(item_id, spouse);
}
@source(IRC_S879_A, relation = formalizes, coverage = exact, quote = "(2) Trade or business income, and a partner's distributive share of partnership income, shall be treated as provided in section 1402(a)(5),")
rule S879A2TradeOrBusinessBySection1402 defeasible {
    for item_id: Text;
    for amount: Money;
    for spouse: Text;
    when community_income_item_879a(item_id, "trade_or_business_or_partnership", amount)
     and spouse_treatment_under_1402a5_879a2(item_id, spouse);
    unless section_6013_election_in_effect_879b(item_id)
     and community_income_item_879a(item_id, "trade_or_business_or_partnership", amount)
     and spouse_treatment_under_1402a5_879a2(item_id, spouse);
    then community_income_treated_as_income_of_879a(item_id, spouse);
}
@source(IRC_S879_A, relation = formalizes, coverage = exact, quote = "(3) Community income not described in paragraph (1) or (2) which is derived from the separate property (as determined under the applicable community property law) of one spouse shall be treated as")
rule S879A3SeparatePropertyIncomeToOwner defeasible {
    for item_id: Text;
    for amount: Money;
    for spouse: Text;
    when community_income_item_879a(item_id, "separate_property", amount)
     and separate_property_owner_spouse_879a3(item_id, spouse);
    unless section_6013_election_in_effect_879b(item_id)
     and community_income_item_879a(item_id, "separate_property", amount)
     and separate_property_owner_spouse_879a3(item_id, spouse);
    then community_income_treated_as_income_of_879a(item_id, spouse);
}
@source(IRC_S879_A, relation = formalizes, coverage = exact, quote = "(4) All other such community income shall be treated as provided in the applicable community property law.")
rule S879A4OtherByCommunityPropertyLaw defeasible {
    for item_id: Text;
    for amount: Money;
    for spouse: Text;
    when community_income_item_879a(item_id, "other", amount)
     and applicable_community_property_law_treatment_879a4(item_id, spouse);
    unless section_6013_election_in_effect_879b(item_id)
     and community_income_item_879a(item_id, "other", amount)
     and applicable_community_property_law_treatment_879a4(item_id, spouse);
    then community_income_treated_as_income_of_879a(item_id, spouse);
}

// --- §881(a)(2)-(4) -----------------------------------------------------------------------

pub relation timber_gain_631_881a2(recipient: us.irc.core::Corporation, amount: Money, item_id: Text) kind empirical {
    label en official "gains described in section 631(b) or (c) received by a foreign corporation from sources within the United States";
}
@source(IRC_S881_A, relation = formalizes, coverage = exact, quote = "(2) gains described in section 631(b) or (c),")
rule S881A2TimberGainsThirtyPercent defeasible {
    for recipient: us.irc.core::Corporation;
    for amount: Money;
    for item_id: Text;
    when timber_gain_631_881a2(recipient, amount, item_id);
    unless effectively_connected(recipient, item_id)
     and timber_gain_631_881a2(recipient, amount, item_id);
    unless exempt_from_881a_tax(recipient, item_id)
     and timber_gain_631_881a2(recipient, amount, item_id);
    then foreign_corp_fdap_tax(recipient, amount, round(amount * 0.30, 2, "HALF_UP"));
}
pub relation oid_obligation_sale_881a3A(recipient: us.irc.core::Corporation, item_id: Text, accrued_oid_while_held: Money) kind empirical {
    label en official "a sale or exchange of an original issue discount obligation by a foreign corporation and the discount accruing while held";
}
pub relation oid_sale_tax_881a3A(recipient: us.irc.core::Corporation, item_id: Text, tax: Money) kind institutional {
    label en official "the 30 percent tax on the original issue discount accrued while the obligation was held by the foreign corporation (section 881(a)(3)(A))";
}
@source(IRC_S881_A, relation = formalizes, coverage = exact, quote = "(A) a sale or exchange of an original issue discount obligation, the amount of the original issue discount accruing while such obligation was held by the foreign corporation (to the extent such")
rule S881A3AOidSaleTax defeasible {
    for recipient: us.irc.core::Corporation;
    for item_id: Text;
    for accrued: Money;
    when oid_obligation_sale_881a3A(recipient, item_id, accrued);
    unless effectively_connected(recipient, item_id)
     and oid_obligation_sale_881a3A(recipient, item_id, accrued);
    then oid_sale_tax_881a3A(recipient, item_id, round(accrued * 0.30, 2, "HALF_UP"));
}
pub relation oid_payment_881a3B(recipient: us.irc.core::Corporation, item_id: Text, payment: Money, accrued_oid_not_yet_taken_into_account: Money, tax_under_881a1_on_payment: Money) kind empirical {
    label en official "a payment on an original issue discount obligation held by a foreign corporation: the payment, the discount accrued while held and not previously taken into account, and the tax imposed on the payment by paragraph (1)";
}
pub relation oid_payment_tax_881a3B(recipient: us.irc.core::Corporation, item_id: Text, tax: Money) kind institutional {
    label en official "the 30 percent tax on the accrued original issue discount, limited to the payment less the tax imposed by paragraph (1) on it (section 881(a)(3)(B))";
}
@source(IRC_S881_A, relation = formalizes, coverage = exact, quote = "(B) a payment on an original issue discount obligation, an amount equal to the original issue discount accruing while such obligation was held by the foreign corporation (except that such original")
rule S881A3BOidPaymentTax defeasible {
    for recipient: us.irc.core::Corporation;
    for item_id: Text;
    for payment: Money;
    for accrued: Money;
    for tax_1: Money;
    when oid_payment_881a3B(recipient, item_id, payment, accrued, tax_1);
    unless effectively_connected(recipient, item_id)
     and oid_payment_881a3B(recipient, item_id, payment, accrued, tax_1);
    then oid_payment_tax_881a3B(recipient, item_id, max(min(round(accrued * 0.30, 2, "HALF_UP"), payment - tax_1), 0.00 USD));
}
pub relation contingent_intangible_sale_gain_881a4(recipient: us.irc.core::Corporation, item_id: Text, gain: Money, sold_on: Date) kind empirical {
    label en official "gain from the sale or exchange of patents, copyrights, secret processes and formulas, good will, trademarks, trade brands, franchises or like property, to the extent from payments contingent on productivity, use or disposition, and the date of the sale";
}
@source(IRC_S881_A, relation = formalizes, coverage = exact, quote = "(4) gains from the sale or exchange after October 4, 1966, of patents, copyrights, secret processes and formulas, good will, trademarks, trade brands, franchises, and other like property, or of any")
rule S881A4ContingentIntangibleGainThirtyPercent defeasible {
    for recipient: us.irc.core::Corporation;
    for item_id: Text;
    for gain: Money;
    for sold_on: Date;
    when contingent_intangible_sale_gain_881a4(recipient, item_id, gain, sold_on)
     and sold_on > @1966-10-04;
    unless effectively_connected(recipient, item_id)
     and contingent_intangible_sale_gain_881a4(recipient, item_id, gain, sold_on);
    then foreign_corp_fdap_tax(recipient, gain, round(gain * 0.30, 2, "HALF_UP"));
}

// --- §881(b): possession corporations ----------------------------------------------------

pub relation corporation_organized_in_named_possession_881b1(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "a corporation created or organized in Guam, American Samoa, the Northern Mariana Islands or the Virgin Islands, or under the law of any such possession";
}
pub relation maximum_foreign_ownership_percentage_881b1A(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, percentage: Decimal) kind empirical {
    label en official "the highest percentage in value of the stock of the corporation beneficially owned (directly or indirectly) by foreign persons at any time during the year";
}
pub relation effectively_connected_gross_income_percentage_881b1B(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, percentage: Decimal) kind empirical {
    label en official "the percentage of the gross income of the corporation, for the 3-year period, shown to the Secretary's satisfaction to be effectively connected with a trade or business in the possession or the United States";
}
pub relation substantial_part_of_income_used_for_nonresident_obligations_881b1C(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "a substantial part of the income of the corporation is used (directly or indirectly) to satisfy obligations to persons who are not bona fide residents of the possession or the United States";
}
pub relation not_treated_as_foreign_corporation_881b1(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "for this section and section 884 the possession corporation is not treated as a foreign corporation for the year (section 881(b)(1))";
}
@source(IRC_S881_B, relation = formalizes, coverage = exact, quote = "For purposes of this section and section 884, a corporation created or organized in Guam, American Samoa, the Northern Mariana Islands, or the Virgin Islands or under the law of any such possession")
rule S881B1PossessionCorporationNotForeign defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for foreign_pct: Decimal;
    for eci_pct: Decimal;
    when corporation_organized_in_named_possession_881b1(corp, y)
     and maximum_foreign_ownership_percentage_881b1A(corp, y, foreign_pct)
     and foreign_pct < 25.0
     and effectively_connected_gross_income_percentage_881b1B(corp, y, eci_pct)
     and eci_pct >= 65.0;
    unless substantial_part_of_income_used_for_nonresident_obligations_881b1C(corp, y)
     and corporation_organized_in_named_possession_881b1(corp, y);
    then not_treated_as_foreign_corporation_881b1(corp, y);
}
pub relation dividend_received_by_puerto_rico_corporation_881b2(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "dividends received during the year by a corporation created or organized in or under the law of the Commonwealth of Puerto Rico";
}
pub relation puerto_rico_withholding_rate_raised_above_ten_percent_881b2b(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "an increase in the Puerto Rico withholding tax rate generally applicable to dividends paid to United States corporations not engaged in trade or business in the Commonwealth, to a rate greater than 10 percent, has taken effect on or before the dividend was received";
}
pub relation puerto_rico_dividend_tax_881b2(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, tax: Money) kind institutional {
    label en official "10 percent is substituted for 30 percent for dividends received by a Puerto Rico corporation meeting requirements (A), (B) and (C) of paragraph (1) (section 881(b)(2))";
}
@source(IRC_S881_B, relation = formalizes, coverage = exact, quote = "subsection (a) shall be applied for such taxable year by substituting \"10 percent\" for \"30 percent\".")
rule S881B2PuertoRicoDividendTenPercent defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when dividend_received_by_puerto_rico_corporation_881b2(corp, y, amount)
     and not_treated_as_foreign_corporation_881b1(corp, y);
    unless puerto_rico_withholding_rate_raised_above_ten_percent_881b2b(corp, y)
     and dividend_received_by_puerto_rico_corporation_881b2(corp, y, amount);
    then puerto_rico_dividend_tax_881b2(corp, y, round(amount * 0.10, 2, "HALF_UP"));
}

// --- §881(c): portfolio interest of foreign corporations ---------------------------------

pub relation corporation_interest_would_be_taxed_under_881a(recipient: us.irc.core::Corporation, item_id: Text) kind empirical {
    label en unofficial "the interest (including original issue discount) would be subject to tax under subsection (a) but for subsection (c)";
}
pub relation interest_received_by_bank_on_ordinary_course_loan_881c3A(item_id: Text) kind empirical {
    label en official "the interest (other than on an obligation of the United States) is received by a bank on an extension of credit under a loan agreement entered into in the ordinary course of its trade or business";
}
pub relation voting_power_percentage_of_issuer_881c3B(recipient: us.irc.core::Corporation, item_id: Text, percentage: Decimal) kind empirical {
    label en official "the percentage of the total combined voting power (or, for a partnership issuer, of the capital or profits interest) of the issuer owned by the recipient, under the section 871(h)(3)(B)-(C) rules";
}
pub relation received_by_cfc_from_related_person_881c3C(recipient: us.irc.core::Corporation, item_id: Text) kind empirical {
    label en official "the interest is received by a controlled foreign corporation from a related person within the meaning of section 864(d)(4)";
}
pub relation ten_percent_shareholder_881c3B(recipient: us.irc.core::Corporation, item_id: Text) kind institutional {
    label en official "the recipient is a 10-percent shareholder within the meaning of section 871(h)(3)(B)";
}
@source(IRC_S881_C, relation = formalizes, coverage = exact, quote = "(B) is received by a 10-percent shareholder (within the meaning of section 871(h)(3)(B)), or")
rule S881C3BTenPercentShareholder defeasible {
    for recipient: us.irc.core::Corporation;
    for item_id: Text;
    for pct: Decimal;
    when voting_power_percentage_of_issuer_881c3B(recipient, item_id, pct)
     and pct >= 10.0;
    then ten_percent_shareholder_881c3B(recipient, item_id);
}
pub relation portfolio_interest_881c(recipient: us.irc.core::Corporation, item_id: Text) kind institutional {
    label en official "the interest is portfolio interest of the foreign corporation (section 881(c)(2)-(4), (6)): registered form and the non-US-beneficial-owner statement (or a Secretary waiver), not excluded by paragraph (3), contingent interest, or an inadequate-exchange country";
}
@source(IRC_S881_C, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, the term \"portfolio interest\" means any interest (including original issue discount) which—")
rule S881C2PortfolioInterestWithStatement defeasible {
    for recipient: us.irc.core::Corporation;
    for item_id: Text;
    when corporation_interest_would_be_taxed_under_881a(recipient, item_id)
     and obligation_in_registered_form(item_id)
     and beneficial_owner_non_us_statement_received(item_id);
    unless interest_received_by_bank_on_ordinary_course_loan_881c3A(item_id)
     and corporation_interest_would_be_taxed_under_881a(recipient, item_id);
    unless ten_percent_shareholder_881c3B(recipient, item_id);
    unless received_by_cfc_from_related_person_881c3C(recipient, item_id)
     and corporation_interest_would_be_taxed_under_881a(recipient, item_id);
    unless contingent_interest_denied_871h4A(item_id)
     and corporation_interest_would_be_taxed_under_881a(recipient, item_id);
    unless portfolio_interest_denied_by_871h6(item_id)
     and corporation_interest_would_be_taxed_under_881a(recipient, item_id);
    unless statement_disqualified_871h5(item_id)
     and corporation_interest_would_be_taxed_under_881a(recipient, item_id);
    then portfolio_interest_881c(recipient, item_id);
}
@source(IRC_S881_C, relation = formalizes, coverage = exact, quote = "(II) the Secretary has determined that such a statement is not required in order to carry out the purposes of this subsection.")
rule S881C2PortfolioInterestSecretaryWaiver defeasible {
    for recipient: us.irc.core::Corporation;
    for item_id: Text;
    when corporation_interest_would_be_taxed_under_881a(recipient, item_id)
     and obligation_in_registered_form(item_id)
     and secretary_determined_statement_not_required(item_id);
    unless interest_received_by_bank_on_ordinary_course_loan_881c3A(item_id)
     and corporation_interest_would_be_taxed_under_881a(recipient, item_id);
    unless ten_percent_shareholder_881c3B(recipient, item_id);
    unless received_by_cfc_from_related_person_881c3C(recipient, item_id)
     and corporation_interest_would_be_taxed_under_881a(recipient, item_id);
    unless contingent_interest_denied_871h4A(item_id)
     and corporation_interest_would_be_taxed_under_881a(recipient, item_id);
    unless portfolio_interest_denied_by_871h6(item_id)
     and corporation_interest_would_be_taxed_under_881a(recipient, item_id);
    then portfolio_interest_881c(recipient, item_id);
}
pub relation exempt_from_881a_tax(recipient: us.irc.core::Corporation, item_id: Text) kind institutional {
    label en official "no tax is imposed under section 881(a) on the item (portfolio interest, section 871(i)(2) amounts, interest-related and short-term capital gain dividends)";
}
@source(IRC_S881_C, relation = formalizes, coverage = exact, quote = "In the case of any portfolio interest received by a foreign corporation from sources within the United States, no tax shall be imposed under paragraph (1) or (3) of subsection (a).")
rule S881C1PortfolioInterestExempt defeasible {
    for recipient: us.irc.core::Corporation;
    for item_id: Text;
    when portfolio_interest_881c(recipient, item_id);
    then exempt_from_881a_tax(recipient, item_id);
}
pub relation controlled_foreign_corporation_881c5(recipient: us.irc.core::Corporation) kind empirical {
    label en official "the recipient is a controlled foreign corporation (section 957(a))";
}
pub relation subpart_f_exceptions_unavailable_881c5(recipient: us.irc.core::Corporation, item_id: Text) kind institutional {
    label en official "sections 954(b)(3)(A) and (b)(4) and 954(c)(3)(A)(i) do not apply to portfolio interest received by a controlled foreign corporation (section 881(c)(5)(A)); the exceptions in modules 10 and 27 are not chained to this relation";
}
@source(IRC_S881_C, relation = formalizes, coverage = exact, quote = "In the case of any portfolio interest received by a controlled foreign corporation, the following provisions shall not apply:")
rule S881C5ACfcPortfolioInterestLosesSubpartFExceptions defeasible {
    for recipient: us.irc.core::Corporation;
    for item_id: Text;
    when portfolio_interest_881c(recipient, item_id)
     and controlled_foreign_corporation_881c5(recipient);
    then subpart_f_exceptions_unavailable_881c5(recipient, item_id);
}

// --- §881(d), (e) ---------------------------------------------------------------------------

pub relation amount_described_in_871i2_881d(recipient: us.irc.core::Corporation, item_id: Text) kind empirical {
    label en official "an amount described in section 871(i)(2) received by the foreign corporation";
}
@source(IRC_S881_D, relation = formalizes, coverage = exact, quote = "No tax shall be imposed under paragraph (1) or (3) of subsection (a) on any amount described in section 871(i)(2).")
rule S881DSection871i2AmountsExempt defeasible {
    for recipient: us.irc.core::Corporation;
    for item_id: Text;
    when amount_described_in_871i2_881d(recipient, item_id);
    then exempt_from_881a_tax(recipient, item_id);
}
pub relation interest_related_dividend_received_881e1(recipient: us.irc.core::Corporation, item_id: Text) kind empirical {
    label en official "an interest-related dividend (as defined in section 871(k)(1)) received from a regulated investment company";
}
pub relation dividend_referred_to_in_871k1B_881e1Bi(recipient: us.irc.core::Corporation, item_id: Text) kind empirical {
    label en official "the dividend is one referred to in section 871(k)(1)(B) (attributable to debt of a 10-percent shareholder, without the statement, or in an inadequate-exchange country)";
}
pub relation dividend_by_cfc_attributable_to_related_person_interest_881e1Bii(recipient: us.irc.core::Corporation, item_id: Text) kind empirical {
    label en official "the dividend is received by a controlled foreign corporation to the extent attributable to interest received by the regulated investment company from a related person (section 864(d)(4)) of the corporation";
}
@source(IRC_S881_E, relation = formalizes, coverage = exact, quote = "Except as provided in subparagraph (B), no tax shall be imposed under paragraph (1) of subsection (a) on any interest-related dividend (as defined in section 871(k)(1)) received from a regulated")
rule S881E1AInterestRelatedDividendExempt defeasible {
    for recipient: us.irc.core::Corporation;
    for item_id: Text;
    when interest_related_dividend_received_881e1(recipient, item_id);
    unless dividend_referred_to_in_871k1B_881e1Bi(recipient, item_id)
     and interest_related_dividend_received_881e1(recipient, item_id);
    unless dividend_by_cfc_attributable_to_related_person_interest_881e1Bii(recipient, item_id)
     and interest_related_dividend_received_881e1(recipient, item_id);
    then exempt_from_881a_tax(recipient, item_id);
}
pub relation short_term_capital_gain_dividend_received_881e2(recipient: us.irc.core::Corporation, item_id: Text) kind empirical {
    label en official "a short-term capital gain dividend (as defined in section 871(k)(2)) received from a regulated investment company";
}
@source(IRC_S881_E, relation = formalizes, coverage = exact, quote = "No tax shall be imposed under paragraph (1) of subsection (a) on any short-term capital gain dividend (as defined in section 871(k)(2)) received from a regulated investment company.")
rule S881E2ShortTermCapitalGainDividendExempt defeasible {
    for recipient: us.irc.core::Corporation;
    for item_id: Text;
    when short_term_capital_gain_dividend_received_881e2(recipient, item_id);
    then exempt_from_881a_tax(recipient, item_id);
}

// --- §882 ---------------------------------------------------------------------------------

pub relation foreign_corporation_engaged_in_us_trade_or_business_882(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "a foreign corporation engaged in trade or business within the United States during the year";
}
pub relation foreign_corp_taxed_on_eci_under_11_55_59A_882a1(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the foreign corporation is taxable as provided in section 11, 55 or 59A on its taxable income effectively connected with the conduct of a trade or business within the United States (section 882(a)(1))";
}
@source(IRC_S882_A, relation = formalizes, coverage = exact, quote = "A foreign corporation engaged in trade or business within the United States during the taxable year shall be taxable as provided in section 11, 55, or 59A,[1] on its taxable income which is")
rule S882A1TaxedOnEffectivelyConnectedIncome defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when foreign_corporation_engaged_in_us_trade_or_business_882(corp, y);
    then foreign_corp_taxed_on_eci_under_11_55_59A_882a1(corp, y);
}
pub relation gross_income_item_882(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text, amount: Money) kind empirical {
    label en official "an item of gross income of a foreign corporation for the year";
}
pub relation gross_income_included_882a2(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text, amount: Money) kind institutional {
    label en official "in determining taxable income under section 882(a)(1), gross income includes only gross income effectively connected with the conduct of a trade or business within the United States (section 882(a)(2))";
}
@source(IRC_S882_A, relation = formalizes, coverage = exact, quote = "In determining taxable income for purposes of paragraph (1), gross income includes only gross income which is effectively connected with the conduct of a trade or business within the United States.")
rule S882A2OnlyEffectivelyConnectedGrossIncome defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for amount: Money;
    when gross_income_item_882(corp, y, item_id, amount)
     and effectively_connected(corp, item_id);
    then gross_income_included_882a2(corp, y, item_id, amount);
}
pub relation derived_from_us_sources_882b(item_id: Text) kind empirical {
    label en official "the gross income is derived from sources within the United States";
}
pub relation gross_income_included_882b(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text, amount: Money) kind institutional {
    label en official "the item is included in the gross income of the foreign corporation (section 882(b): US-source income not effectively connected, and effectively connected income)";
}
@source(IRC_S882_B, relation = formalizes, coverage = exact, quote = "(1) gross income which is derived from sources within the United States and which is not effectively connected with the conduct of a trade or business within the United States, and")
rule S882B1UsSourceNotEffectivelyConnected defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for amount: Money;
    when gross_income_item_882(corp, y, item_id, amount)
     and derived_from_us_sources_882b(item_id);
    unless effectively_connected(corp, item_id)
     and gross_income_item_882(corp, y, item_id, amount);
    then gross_income_included_882b(corp, y, item_id, amount);
}
@source(IRC_S882_B, relation = formalizes, coverage = exact, quote = "(2) gross income which is effectively connected with the conduct of a trade or business within the United States.")
rule S882B2EffectivelyConnected defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for amount: Money;
    when gross_income_item_882(corp, y, item_id, amount)
     and effectively_connected(corp, item_id);
    then gross_income_included_882b(corp, y, item_id, amount);
}
pub relation deduction_item_882(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, ded_id: Text, amount: Money) kind empirical {
    label en official "a deduction claimed by a foreign corporation for the year";
}
pub relation deduction_connected_with_eci_882c1A(ded_id: Text) kind empirical {
    label en official "the deduction is connected with income effectively connected with the conduct of a trade or business within the United States";
}
pub relation charitable_contribution_deduction_882c1B(ded_id: Text) kind empirical {
    label en official "the deduction for charitable contributions and gifts provided by section 170";
}
pub relation deduction_allowed_882c1(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, ded_id: Text, amount: Money) kind institutional {
    label en official "the deduction is allowed to the foreign corporation (section 882(c)(1))";
}
@source(IRC_S882_C, relation = formalizes, coverage = partial, quote = "In the case of a foreign corporation, the deductions shall be allowed only for purposes of subsection (a) and (except as provided by subparagraph (B)) only if and to the extent that they are")
rule S882C1ADeductionConnectedWithEci defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for ded_id: Text;
    for amount: Money;
    when deduction_item_882(corp, y, ded_id, amount)
     and deduction_connected_with_eci_882c1A(ded_id);
    then deduction_allowed_882c1(corp, y, ded_id, amount);
}
@source(IRC_S882_C, relation = formalizes, coverage = exact, quote = "The deduction for charitable contributions and gifts provided by section 170 shall be allowed whether or not connected with income which is effectively connected with the conduct of a trade or")
rule S882C1BCharitableContributions defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for ded_id: Text;
    for amount: Money;
    when deduction_item_882(corp, y, ded_id, amount)
     and charitable_contribution_deduction_882c1B(ded_id);
    then deduction_allowed_882c1(corp, y, ded_id, amount);
}
pub relation true_and_accurate_return_filed_882c2(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the foreign corporation files, or causes to be filed, a true and accurate return with all the information the Secretary may deem necessary";
}
pub relation benefit_of_deductions_and_credits_882c2(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the foreign corporation receives the benefit of the deductions and credits allowed only by filing the return (section 882(c)(2)); the exception for section 541 is not modeled";
}
@source(IRC_S882_C, relation = formalizes, coverage = partial, quote = "A foreign corporation shall receive the benefit of the deductions and credits allowed to it in this subtitle only by filing or causing to be filed with the Secretary a true and accurate return, in")
rule S882C2ReturnConditionsBenefit defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when foreign_corporation_engaged_in_us_trade_or_business_882(corp, y)
     and true_and_accurate_return_filed_882c2(corp, y);
    then benefit_of_deductions_and_credits_882c2(corp, y);
}
pub relation foreign_corporation_taxable_year_882c3(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en unofficial "the taxable year of a foreign corporation (a domain anchor for section 882(c)(3))";
}
pub relation credit_allowed_by_section_906_882c3(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the credit for foreign taxes is allowed by section 906";
}
pub relation foreign_tax_credit_denied_882c3(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "a foreign corporation is not allowed the section 901 credit for taxes of foreign countries and possessions (section 882(c)(3))";
}
@source(IRC_S882_C, relation = formalizes, coverage = exact, quote = "Except as provided by section 906, foreign corporations shall not be allowed the credit against the tax for taxes of foreign countries and possessions of the United States allowed by section 901.")
rule S882C3NoForeignTaxCreditExceptSection906 defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when foreign_corporation_taxable_year_882c3(corp, y);
    unless credit_allowed_by_section_906_882c3(corp, y)
     and foreign_corporation_taxable_year_882c3(corp, y);
    then foreign_tax_credit_denied_882c3(corp, y);
}
pub relation elects_882d_real_property_income_as_eci(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en unofficial "the foreign corporation makes the section 882(d)(1) election to treat US real property income as effectively connected, for the taxable year";
}
pub relation election_882d_effective(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the section 882(d)(1) election is in effect for the year; paragraphs (2) and (3) of section 871(d) (revocation and re-election, manner and time) apply to it";
}
@source(IRC_S882_D, relation = formalizes, coverage = exact, quote = "may elect for such taxable year to treat all such income as income which is effectively connected with the conduct of a trade or business within the United States. In such case, such income shall be")
rule S882DElectionPower defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when elects_882d_real_property_income_as_eci(corp, y);
    then power S882DElectionOfRealPropertyEci {
        holder corp;
        over corp;
        exercise elects_882d_real_property_income_as_eci(corp, y);
        valid_when elects_882d_real_property_income_as_eci(corp, y);
        effect create(election_882d_effective(corp, y));
    };
}
pub relation bank_corporation_of_possession_interest_on_us_obligations_882e(corp: us.irc.core::Corporation, item_id: Text) kind empirical {
    label en official "interest on obligations of the United States received by a corporation created or organized in or under the law of a possession, carrying on the banking business in a possession, which is not portfolio interest (section 881(c)(2))";
}
pub relation treated_as_effectively_connected_882e(corp: us.irc.core::Corporation, item_id: Text) kind institutional {
    label en official "the interest is treated as effectively connected with a trade or business within the United States and is taxable as in subsection (a)(1) whether or not the corporation is engaged in business (section 882(e)); not chained into `effectively_connected`";
}
@source(IRC_S882_E, relation = formalizes, coverage = exact, quote = "In the case of a corporation created or organized in, or under the law of, a possession of the United States which is carrying on the banking business in a possession of the United States, interest")
rule S882EPossessionBankInterestIsEci defeasible {
    for corp: us.irc.core::Corporation;
    for item_id: Text;
    when bank_corporation_of_possession_interest_on_us_obligations_882e(corp, item_id);
    unless portfolio_interest_881c(corp, item_id)
     and bank_corporation_of_possession_interest_on_us_obligations_882e(corp, item_id);
    then treated_as_effectively_connected_882e(corp, item_id);
}
pub relation foreign_corporation_without_us_office_with_agent_882f(agent: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the foreign corporation has no office or place of business in the United States but has an agent in the United States, and must file the return required under section 6012";
}
pub relation return_filed_by_agent_882f(agent: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the agent filed the return of the foreign corporation under section 6012";
}
@source(IRC_S882_F, relation = formalizes, coverage = exact, quote = "If any foreign corporation has no office or place of business in the United States but has an agent in the United States, the return required under section 6012 shall be made by the agent.")
rule S882FAgentMustFileReturn defeasible {
    for agent: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when foreign_corporation_without_us_office_with_agent_882f(agent, corp, y);
    then duty S882FAgentReturnDuty {
        bearer agent;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition return_filed_by_agent_882f(agent, corp, y);
            window [-infinity, infinity];
        }
    };
}

// --- §883 ---------------------------------------------------------------------------------

pub relation income_of_foreign_corporation_from_international_ship_883a1(corp: us.irc.core::Corporation, item_id: Text, country: Text) kind empirical {
    label en official "gross income derived by a corporation organized in a foreign country from the international operation of a ship or ships";
}
pub relation income_of_foreign_corporation_from_international_aircraft_883a2(corp: us.irc.core::Corporation, item_id: Text, country: Text) kind empirical {
    label en official "gross income derived by a corporation organized in a foreign country from the international operation of aircraft";
}
pub relation rolling_stock_earnings_883a3(corp: us.irc.core::Corporation, item_id: Text, country: Text, days_use_expected: Integer) kind empirical {
    label en official "earnings derived from payments by a common carrier for the use on a temporary basis of railroad rolling stock owned by a corporation of the foreign country, and the number of days of use expected in the taxable year";
}
pub relation country_grants_equivalent_exemption_to_us_corporations_883a(country: Text, kind: Text) kind empirical {
    label en official "the foreign country grants an equivalent exemption to corporations organized in the United States, for `ship`, `aircraft` or `rolling_stock` income";
}
pub relation foreign_country_taxes_us_corporation_on_residence_basis_883a5(country: Text) kind empirical {
    label en official "the foreign country subjects the United States corporation to tax on a residence basis under provisions meeting the standards the Secretary may prescribe";
}
pub relation satellite_system_earnings_883b(corp: us.irc.core::Corporation, item_id: Text) kind empirical {
    label en official "earnings derived from the ownership or operation of a communications satellite system by a foreign entity designated by a foreign government to participate, the United States participating through its designated entity under the Communications Satellite Act of 1962";
}
pub relation stock_percentage_owned_by_nonresident_individuals_883c1(corp: us.irc.core::Corporation, item_id: Text, percentage: Decimal) kind empirical {
    label en official "the percentage of the value of the stock of the corporation owned by individuals who are not residents of the foreign country or another qualifying country (with the proportional attribution of paragraph (4))";
}
pub relation corporation_is_cfc_883c2(corp: us.irc.core::Corporation) kind empirical {
    label en official "the foreign corporation is a controlled foreign corporation (section 957(a))";
}
pub relation stock_primarily_and_regularly_traded_883c3A(corp: us.irc.core::Corporation) kind empirical {
    label en official "the stock of the corporation is primarily and regularly traded on an established securities market in the foreign country, another qualifying country, or the United States";
}
pub relation exemption_denied_883c1(corp: us.irc.core::Corporation, item_id: Text) kind institutional {
    label en official "the exemption of paragraph (1) or (2) of subsection (a) does not apply: 50 percent or more of the stock is owned by individuals not resident in a qualifying country, unless the corporation is a controlled foreign corporation or its stock is publicly traded (section 883(c))";
}
@source(IRC_S883_C, relation = formalizes, coverage = exact, quote = "Paragraph (1) or (2) of subsection (a) (as the case may be) shall not apply to any foreign corporation if 50 percent or more of the value of the stock of such corporation is owned by individuals who")
rule S883C1FiftyPercentNonresidentOwnership defeasible {
    for corp: us.irc.core::Corporation;
    for item_id: Text;
    for pct: Decimal;
    when stock_percentage_owned_by_nonresident_individuals_883c1(corp, item_id, pct)
     and pct >= 50.0;
    unless corporation_is_cfc_883c2(corp)
     and stock_percentage_owned_by_nonresident_individuals_883c1(corp, item_id, pct);
    unless stock_primarily_and_regularly_traded_883c3A(corp)
     and stock_percentage_owned_by_nonresident_individuals_883c1(corp, item_id, pct);
    then exemption_denied_883c1(corp, item_id);
}
pub relation income_excluded_and_exempt_883(corp: us.irc.core::Corporation, item_id: Text) kind institutional {
    label en official "the item is not included in the gross income of the foreign corporation and is exempt from taxation under this subtitle (section 883(a), (b))";
}
@source(IRC_S883_A, relation = formalizes, coverage = exact, quote = "Gross income derived by a corporation organized in a foreign country from the international operation of a ship or ships if such foreign country grants an equivalent exemption to corporations")
rule S883A1ShipIncomeExempt defeasible {
    for corp: us.irc.core::Corporation;
    for item_id: Text;
    for country: Text;
    when income_of_foreign_corporation_from_international_ship_883a1(corp, item_id, country)
     and country_grants_equivalent_exemption_to_us_corporations_883a(country, "ship");
    unless exemption_denied_883c1(corp, item_id)
     and income_of_foreign_corporation_from_international_ship_883a1(corp, item_id, country);
    then income_excluded_and_exempt_883(corp, item_id);
}
@source(IRC_S883_A, relation = formalizes, coverage = exact, quote = "Gross income derived by a corporation organized in a foreign country from the international operation of aircraft if such foreign country grants an equivalent exemption to corporations organized in")
rule S883A2AircraftIncomeExempt defeasible {
    for corp: us.irc.core::Corporation;
    for item_id: Text;
    for country: Text;
    when income_of_foreign_corporation_from_international_aircraft_883a2(corp, item_id, country)
     and country_grants_equivalent_exemption_to_us_corporations_883a(country, "aircraft");
    unless exemption_denied_883c1(corp, item_id)
     and income_of_foreign_corporation_from_international_aircraft_883a2(corp, item_id, country);
    then income_excluded_and_exempt_883(corp, item_id);
}
@source(IRC_S883_A, relation = formalizes, coverage = partial, quote = "For purposes of this subsection, there shall not be taken into account any failure of a foreign country to grant an exemption to a corporation organized in the United States if such corporation is")
rule S883A5ShipResidenceBasisTaxation defeasible {
    for corp: us.irc.core::Corporation;
    for item_id: Text;
    for country: Text;
    when income_of_foreign_corporation_from_international_ship_883a1(corp, item_id, country)
     and foreign_country_taxes_us_corporation_on_residence_basis_883a5(country);
    unless exemption_denied_883c1(corp, item_id)
     and income_of_foreign_corporation_from_international_ship_883a1(corp, item_id, country);
    then income_excluded_and_exempt_883(corp, item_id);
}
rule S883A5AircraftResidenceBasisTaxation defeasible {
    for corp: us.irc.core::Corporation;
    for item_id: Text;
    for country: Text;
    when income_of_foreign_corporation_from_international_aircraft_883a2(corp, item_id, country)
     and foreign_country_taxes_us_corporation_on_residence_basis_883a5(country);
    unless exemption_denied_883c1(corp, item_id)
     and income_of_foreign_corporation_from_international_aircraft_883a2(corp, item_id, country);
    then income_excluded_and_exempt_883(corp, item_id);
}
@source(IRC_S883_A, relation = formalizes, coverage = exact, quote = "Earnings derived from payments by a common carrier for the use on a temporary basis (not expected to exceed a total of 90 days in any taxable year) of railroad rolling stock owned by a corporation of")
rule S883A3RollingStockEarningsExempt defeasible {
    for corp: us.irc.core::Corporation;
    for item_id: Text;
    for country: Text;
    for days: Integer;
    when rolling_stock_earnings_883a3(corp, item_id, country, days)
     and days <= 90
     and country_grants_equivalent_exemption_to_us_corporations_883a(country, "rolling_stock");
    then income_excluded_and_exempt_883(corp, item_id);
}
@source(IRC_S883_B, relation = formalizes, coverage = exact, quote = "The earnings derived from the ownership or operation of a communications satellite system by a foreign entity designated by a foreign government to participate in such ownership or operation shall be")
rule S883BSatelliteSystemEarningsExempt defeasible {
    for corp: us.irc.core::Corporation;
    for item_id: Text;
    when satellite_system_earnings_883b(corp, item_id);
    then income_excluded_and_exempt_883(corp, item_id);
}

// --- §887 ---------------------------------------------------------------------------------

pub relation us_source_gross_transportation_income_887b1(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "gross income which is transportation income (section 863(c)(3)) to the extent treated as from sources in the United States under section 863(c)(2), of a nonresident alien individual or foreign corporation";
}
pub relation income_taxable_under_871b_or_882_887b2(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the income is taxable under section 871(b) or 882";
}
pub relation income_taxable_in_possession_887b3(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the income is taxable in a possession of the United States under the provisions of this title as made applicable in such possession";
}
pub relation transportation_tax_887a(p: us.irc.core::Person, y: us.irc.core::TaxableYear, tax: Money) kind institutional {
    label en official "the tax equal to 4 percent of the United States source gross transportation income (section 887(a)); income taxable under section 871(b) or 882 or in a possession is excluded (subsection (b)(2)-(3))";
}
@source(IRC_S887_A, relation = formalizes, coverage = exact, quote = "In the case of any nonresident alien individual or foreign corporation, there is hereby imposed for each taxable year a tax equal to 4 percent of such individual's or corporation's United States")
rule S887AFourPercentTax defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when us_source_gross_transportation_income_887b1(p, y, amount);
    unless income_taxable_under_871b_or_882_887b2(p, y)
     and us_source_gross_transportation_income_887b1(p, y, amount);
    unless income_taxable_in_possession_887b3(p, y)
     and us_source_gross_transportation_income_887b1(p, y, amount);
    then transportation_tax_887a(p, y, round(amount * 0.04, 2, "HALF_UP"));
}
pub relation fixed_place_of_business_in_us_887b4A(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the taxpayer has a fixed place of business in the United States involved in the earning of United States source gross transportation income";
}
pub relation substantially_all_income_from_regularly_scheduled_transportation_887b4B(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "substantially all of the United States source gross transportation income is attributable to regularly scheduled transportation (or, for leasing of a vessel or aircraft, to a fixed place of business in the United States)";
}
pub relation transportation_income_treated_as_effectively_connected_887b4(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "United States source gross transportation income is treated as effectively connected with a trade or business in the United States only if a fixed place of business and regularly scheduled transportation (section 887(b)(4)); not chained into `effectively_connected`";
}
@source(IRC_S887_B, relation = formalizes, coverage = exact, quote = "For purposes of this chapter, United States source gross transportation income of any taxpayer shall not be treated as effectively connected with the conduct of a trade or business in the United")
rule S887B4TreatedAsEffectivelyConnectedOnlyIfBoth defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when fixed_place_of_business_in_us_887b4A(p, y)
     and substantially_all_income_from_regularly_scheduled_transportation_887b4B(p, y);
    then transportation_income_treated_as_effectively_connected_887b4(p, y);
}

// --- §891: doubling of taxes on citizens of certain foreign countries ---------------------

pub relation president_finds_discriminatory_or_extraterritorial_taxes_891(country: Text) kind empirical {
    label en official "under the laws of a foreign country, citizens or corporations of the United States are subjected to discriminatory or extraterritorial taxes";
}
pub relation president_proclaims_doubling_891(country: Text) kind empirical {
    label en official "the President proclaims the doubling of rates for the citizens and corporations of the foreign country";
}
pub relation rates_doubled_for_country_891(country: Text) kind institutional {
    label en official "the rates of tax imposed by sections 1, 3, 11, 801, 831, 852, 871 and 881 are doubled for each citizen and corporation of the foreign country for the taxable year of the proclamation and each later year (section 891)";
}
@source(IRC_S891, relation = formalizes, coverage = partial, quote = "Whenever the President finds that, under the laws of any foreign country, citizens or corporations of the United States are being subjected to discriminatory or extraterritorial taxes, the President")
rule S891DoublingProclamationPower defeasible {
    for country: Text;
    when president_proclaims_doubling_891(country);
    then power S891DoublingProclamation {
        holder us.irc.international::President;
        over us.irc.international::President;
        exercise president_proclaims_doubling_891(country);
        valid_when president_finds_discriminatory_or_extraterritorial_taxes_891(country);
        effect create(rates_doubled_for_country_891(country));
    };
}
pub relation tax_and_taxable_income_of_national_891(p: us.irc.core::Person, y: us.irc.core::TaxableYear, country: Text, tax: Money, taxable_income: Money) kind empirical {
    label en official "the tax computed without regard to section 891 of a citizen or corporation of the foreign country, and the taxable income (computed without regard to the deductions allowable under section 151 and under part VIII of subchapter B)";
}
pub relation doubled_tax_891(p: us.irc.core::Person, y: us.irc.core::TaxableYear, tax: Money) kind institutional {
    label en official "the doubled tax, not exceeding 80 percent of the taxable income of the taxpayer (section 891)";
}
@source(IRC_S891, relation = formalizes, coverage = partial, quote = "Whenever the President finds that, under the laws of any foreign country, citizens or corporations of the United States are being subjected to discriminatory or extraterritorial taxes, the President")
rule S891DoubledTaxCappedAtEightyPercent defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for country: Text;
    for tax: Money;
    for income: Money;
    when tax_and_taxable_income_of_national_891(p, y, country, tax, income)
     and rates_doubled_for_country_891(country);
    then doubled_tax_891(p, y, min(tax * 2, round(income * 0.80, 2, "HALF_UP")));
}

// --- §892: foreign governments and international organizations ---------------------------

pub relation income_of_foreign_government_892a1(gov_id: Text, item_id: Text, source_kind: Text) kind empirical {
    label en official "income of a foreign government received from: `domestic_securities` (stocks, bonds or other domestic securities owned), `monetary_policy_instruments` (financial instruments held in the execution of governmental financial or monetary policy) or `bank_deposit_interest` (interest on deposits in banks in the United States)";
}
pub relation income_from_commercial_activity_892a2Ai(item_id: Text) kind empirical {
    label en official "the income is derived from the conduct of any commercial activity (within or outside the United States)";
}
pub relation income_received_by_or_from_controlled_commercial_entity_892a2Aii(item_id: Text) kind empirical {
    label en official "the income is received by a controlled commercial entity or received (directly or indirectly) from a controlled commercial entity";
}
pub relation income_from_disposition_of_interest_in_controlled_commercial_entity_892a2Aiii(item_id: Text) kind empirical {
    label en official "the income is derived from the disposition of any interest in a controlled commercial entity";
}
pub relation government_interest_in_entity_892a2B(entity_id: Text, interest_percentage: Decimal, effective_control: Boolean, engaged_in_commercial_activities: Boolean) kind empirical {
    label en official "the interest (by value or voting interest) held directly or indirectly by the government in an entity engaged in commercial activities, and whether the government has effective control";
}
pub relation entity_is_central_bank_of_issue_892a2B(entity_id: Text) kind empirical {
    label en official "the entity is a central bank of issue";
}
pub relation central_bank_engaged_in_commercial_activities_in_us_892a2B(entity_id: Text) kind empirical {
    label en official "the central bank of issue is engaged in commercial activities within the United States";
}
pub relation controlled_commercial_entity_892a2B(entity_id: Text) kind institutional {
    label en official "a controlled commercial entity: an entity engaged in commercial activities in which the government holds 50 percent or more of the interests or has effective control (section 892(a)(2)(B)); a central bank of issue only if engaged in commercial activities within the United States";
}
@source(IRC_S892_A, relation = formalizes, coverage = exact, quote = "(i) holds (directly or indirectly) any interest in such entity which (by value or voting interest) is 50 percent or more of the total of such interests in such entity, or")
rule S892A2BiFiftyPercentInterest defeasible {
    for entity_id: Text;
    for pct: Decimal;
    for control: Boolean;
    for commercial: Boolean;
    when government_interest_in_entity_892a2B(entity_id, pct, control, commercial)
     and commercial == true
     and pct >= 50.0;
    unless entity_is_central_bank_of_issue_892a2B(entity_id)
     and government_interest_in_entity_892a2B(entity_id, pct, control, commercial)
     and not_known(central_bank_engaged_in_commercial_activities_in_us_892a2B(entity_id));
    then controlled_commercial_entity_892a2B(entity_id);
}
@source(IRC_S892_A, relation = formalizes, coverage = exact, quote = "(ii) holds (directly or indirectly) any other interest in such entity which provides the foreign government with effective control of such entity.")
rule S892A2BiiEffectiveControl defeasible {
    for entity_id: Text;
    for pct: Decimal;
    for control: Boolean;
    for commercial: Boolean;
    when government_interest_in_entity_892a2B(entity_id, pct, control, commercial)
     and commercial == true
     and control == true;
    unless entity_is_central_bank_of_issue_892a2B(entity_id)
     and government_interest_in_entity_892a2B(entity_id, pct, control, commercial)
     and not_known(central_bank_engaged_in_commercial_activities_in_us_892a2B(entity_id));
    then controlled_commercial_entity_892a2B(entity_id);
}
pub relation income_of_foreign_government_exempt_892a(gov_id: Text, item_id: Text) kind institutional {
    label en official "the income of the foreign government is not included in gross income and is exempt from taxation under this subtitle (section 892(a)(1)), except income of the kinds in paragraph (2)(A)";
}
@source(IRC_S892_A, relation = formalizes, coverage = exact, quote = "The income of foreign governments received from—")
rule S892A1ForeignGovernmentIncomeExempt defeasible {
    for gov_id: Text;
    for item_id: Text;
    for kind: Text;
    when income_of_foreign_government_892a1(gov_id, item_id, kind);
    unless income_from_commercial_activity_892a2Ai(item_id)
     and income_of_foreign_government_892a1(gov_id, item_id, kind);
    unless income_received_by_or_from_controlled_commercial_entity_892a2Aii(item_id)
     and income_of_foreign_government_892a1(gov_id, item_id, kind);
    unless income_from_disposition_of_interest_in_controlled_commercial_entity_892a2Aiii(item_id)
     and income_of_foreign_government_892a1(gov_id, item_id, kind);
    then income_of_foreign_government_exempt_892a(gov_id, item_id);
}
pub relation income_of_international_organization_892b(org_id: Text, item_id: Text) kind empirical {
    label en official "income of an international organization received from investments in the United States in stocks, bonds or other domestic securities owned by it, from interest on deposits in banks in the United States, or from any other source within the United States";
}
pub relation income_of_international_organization_exempt_892b(org_id: Text, item_id: Text) kind institutional {
    label en official "the income of the international organization is not included in gross income and is exempt from taxation under this subtitle (section 892(b))";
}
@source(IRC_S892_B, relation = formalizes, coverage = exact, quote = "The income of international organizations received from investments in the United States in stocks, bonds, or other domestic securities owned by such international organizations, or from interest on")
rule S892BInternationalOrganizationIncomeExempt defeasible {
    for org_id: Text;
    for item_id: Text;
    when income_of_international_organization_892b(org_id, item_id);
    then income_of_international_organization_exempt_892b(org_id, item_id);
}
pub relation foreign_government_treated_as_corporate_resident_892a3(gov_id: Text) kind institutional {
    label en official "a foreign government is treated as a corporate resident of its country for purposes of this title, and for income tax treaty purposes if it grants equivalent treatment to the Government of the United States (section 892(a)(3))";
}
pub relation foreign_government_892a3(gov_id: Text) kind empirical {
    label en official "the entity is a foreign government";
}
@source(IRC_S892_A, relation = formalizes, coverage = partial, quote = "For purposes of this title, a foreign government shall be treated as a corporate resident of its country. A foreign government shall be so treated for purposes of any income tax treaty obligation of")
rule S892A3GovernmentIsCorporateResident defeasible {
    for gov_id: Text;
    when foreign_government_892a3(gov_id);
    then foreign_government_treated_as_corporate_resident_892a3(gov_id);
}

// --- §893 ---------------------------------------------------------------------------------

pub relation compensation_of_government_or_international_organization_employee_893(p: us.irc.core::Individual, item_id: Text, employer_kind: Text) kind empirical {
    label en official "wages, fees or salary of an employee of a foreign government (`foreign_government`) or of an international organization (`international_organization`) received as compensation for official services";
}
pub relation employee_not_us_citizen_or_philippines_citizen_893a1(p: us.irc.core::Individual) kind empirical {
    label en official "the employee is not a citizen of the United States, or is a citizen of the Republic of the Philippines (whether or not a citizen of the United States)";
}
pub relation services_similar_to_us_government_employees_abroad_893a2(item_id: Text) kind empirical {
    label en official "the services are of a character similar to those performed by employees of the Government of the United States in foreign countries";
}
pub relation foreign_government_grants_equivalent_exemption_893a3(item_id: Text) kind empirical {
    label en official "the foreign government grants an equivalent exemption to employees of the Government of the United States performing similar services";
}
pub relation employee_of_controlled_commercial_entity_893c1(p: us.irc.core::Individual) kind empirical {
    label en official "the employee is an employee of a controlled commercial entity (section 892(a)(2)(B))";
}
pub relation services_primarily_in_connection_with_commercial_activity_893c2(item_id: Text) kind empirical {
    label en official "the services of an employee of a foreign government are primarily in connection with a commercial activity of the government";
}
pub relation compensation_exempt_893(p: us.irc.core::Individual, item_id: Text) kind institutional {
    label en official "the compensation is not included in gross income and is exempt from taxation under this subtitle (section 893)";
}
@source(IRC_S893_A, relation = formalizes, coverage = exact, quote = "(2) in the case of an employee of a foreign government, the services are of a character similar to those performed by employees of the Government of the United States in foreign countries; and")
rule S893ForeignGovernmentEmployeeExempt defeasible {
    for p: us.irc.core::Individual;
    for item_id: Text;
    when compensation_of_government_or_international_organization_employee_893(p, item_id, "foreign_government")
     and employee_not_us_citizen_or_philippines_citizen_893a1(p)
     and services_similar_to_us_government_employees_abroad_893a2(item_id)
     and foreign_government_grants_equivalent_exemption_893a3(item_id);
    unless employee_of_controlled_commercial_entity_893c1(p)
     and compensation_of_government_or_international_organization_employee_893(p, item_id, "foreign_government");
    unless services_primarily_in_connection_with_commercial_activity_893c2(item_id)
     and compensation_of_government_or_international_organization_employee_893(p, item_id, "foreign_government");
    then compensation_exempt_893(p, item_id);
}
@source(IRC_S893_A, relation = formalizes, coverage = exact, quote = "(1) such employee is not a citizen of the United States, or is a citizen of the Republic of the Philippines (whether or not a citizen of the United States); and")
rule S893InternationalOrganizationEmployeeExempt defeasible {
    for p: us.irc.core::Individual;
    for item_id: Text;
    when compensation_of_government_or_international_organization_employee_893(p, item_id, "international_organization")
     and employee_not_us_citizen_or_philippines_citizen_893a1(p);
    then compensation_exempt_893(p, item_id);
}

// --- §894(b), (c) ---------------------------------------------------------------------------

pub relation treaty_benefit_claim_on_non_eci_income_894b(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "a nonresident alien individual or foreign corporation applies a treaty exemption or reduction to income not effectively connected with a US trade or business";
}
pub relation tax_computed_under_877b_894b(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the tax in question is the tax computed under section 877(b)";
}
pub relation deemed_no_permanent_establishment_in_us_894b(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "for treaty exemptions and reductions on income not effectively connected, the person is deemed not to have a permanent establishment in the United States at any time during the year, except for the tax computed under section 877(b) (section 894(b))";
}
@source(IRC_S894_B, relation = formalizes, coverage = exact, quote = "For purposes of applying any exemption from, or reduction of, any tax provided by any treaty to which the United States is a party with respect to income which is not effectively connected with the")
rule S894BDeemedNoPermanentEstablishment defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when treaty_benefit_claim_on_non_eci_income_894b(p, y);
    unless tax_computed_under_877b_894b(p, y)
     and treaty_benefit_claim_on_non_eci_income_894b(p, y);
    then deemed_no_permanent_establishment_in_us_894b(p, y);
}
pub relation item_derived_through_fiscally_transparent_entity_894c1(p: us.irc.core::Person, item_id: Text) kind empirical {
    label en official "an item of income derived by a foreign person through an entity treated as a partnership (or otherwise fiscally transparent) for purposes of this title";
}
pub relation item_not_income_of_person_under_foreign_law_894c1A(item_id: Text) kind empirical {
    label en official "the item is not treated for purposes of the taxation laws of the foreign country as an item of income of the person";
}
pub relation treaty_silent_on_partnership_items_894c1B(item_id: Text) kind empirical {
    label en official "the treaty does not contain a provision addressing the applicability of the treaty to items derived through a partnership";
}
pub relation foreign_country_does_not_tax_distribution_894c1C(item_id: Text) kind empirical {
    label en official "the foreign country does not impose tax on a distribution of such item of income from the entity to the person";
}
pub relation reduced_treaty_rate_denied_894c1(p: us.irc.core::Person, item_id: Text) kind institutional {
    label en official "the foreign person is not entitled under an income tax treaty to a reduced rate of withholding tax on the item (section 894(c)(1))";
}
@source(IRC_S894_C, relation = formalizes, coverage = exact, quote = "A foreign person shall not be entitled under any income tax treaty of the United States with a foreign country to any reduced rate of any withholding tax imposed by this title on an item of income")
rule S894C1ReducedRateDenied defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    when item_derived_through_fiscally_transparent_entity_894c1(p, item_id)
     and item_not_income_of_person_under_foreign_law_894c1A(item_id)
     and treaty_silent_on_partnership_items_894c1B(item_id)
     and foreign_country_does_not_tax_distribution_894c1C(item_id);
    then reduced_treaty_rate_denied_894c1(p, item_id);
}

// --- §895 ---------------------------------------------------------------------------------

pub relation income_of_foreign_central_bank_of_issue_895(bank_id: Text, item_id: Text, source_kind: Text) kind empirical {
    label en official "income derived by a foreign central bank of issue from obligations of the United States or its agencies or instrumentalities owned by it (`us_obligations`), or from interest on deposits with persons carrying on the banking business (`bank_deposit_interest`)";
}
pub relation central_bank_income_exempt_895(bank_id: Text, item_id: Text) kind institutional {
    label en official "the income of the foreign central bank of issue is not included in gross income and is exempt from taxation under this subtitle, unless from commercial activities or received from a controlled commercial entity (section 895)";
}
@source(IRC_S895, relation = formalizes, coverage = partial, quote = "Income derived by a foreign central bank of issue from obligations of the United States or of any agency or instrumentality thereof (including beneficial interests, participations, and other")
rule S895CentralBankIncomeExempt defeasible {
    for bank_id: Text;
    for item_id: Text;
    for kind: Text;
    when income_of_foreign_central_bank_of_issue_895(bank_id, item_id, kind);
    unless income_from_commercial_activity_892a2Ai(item_id)
     and income_of_foreign_central_bank_of_issue_895(bank_id, item_id, kind);
    then central_bank_income_exempt_895(bank_id, item_id);
}

// --- §896: retaliatory proclamations ----------------------------------------------------

pub relation president_finds_more_burdensome_taxes_896a1(country: Text) kind empirical {
    label en official "under the laws of a foreign country, considering its tax system, citizens of the United States not resident there or domestic corporations are subjected to more burdensome taxes on an item of income from sources in that country than this subtitle imposes on similar income of its residents or corporations";
}
pub relation foreign_country_did_not_revise_taxes_896a2(country: Text) kind empirical {
    label en official "the foreign country, when requested by the United States, has not acted to revise or reduce such taxes";
}
pub relation public_interest_in_pre_1967_provisions_896a3(country: Text) kind empirical {
    label en official "it is in the public interest to apply pre-1967 tax provisions to residents or corporations of the foreign country";
}
pub relation president_finds_higher_effective_rate_896b1(country: Text) kind empirical {
    label en official "under the laws of a foreign country, citizens or corporations of the United States (or any class) are subjected to a higher effective rate of tax on an item of income than the country's nationals, residents or corporations under similar circumstances";
}
pub relation foreign_country_did_not_eliminate_higher_rate_896b2(country: Text) kind empirical {
    label en official "the foreign country, when requested, has not acted to eliminate the higher effective rate";
}
pub relation public_interest_in_adjusting_effective_rate_896b3(country: Text) kind empirical {
    label en official "it is in the public interest to adjust the effective rate of tax imposed by this subtitle on similar income of the country's nationals, residents or corporations";
}
pub relation president_finds_laws_modified_896c(country: Text) kind empirical {
    label en official "the laws of a foreign country with respect to which a proclamation was made under subsection (a) or (b) have been modified so that United States citizens and domestic corporations are no longer subjected to the burden";
}
pub relation congress_notified_on_896d(country: Text, notified_on: Date) kind empirical {
    label en official "the date the President notified the Senate and the House of Representatives of the intention to issue the proclamation";
}
pub relation proclamation_issued_on_896(country: Text, issued_on: Date) kind empirical {
    label en official "the date of the proclamation";
}
pub relation notification_at_least_30_days_before_proclamation_896d(country: Text) kind institutional {
    label en official "at least 30 days before the proclamation the President notified the Senate and the House of Representatives (section 896(d))";
}
@source(IRC_S896_D, relation = formalizes, coverage = exact, quote = "No proclamation shall be issued by the President pursuant to this section unless, at least 30 days prior to such proclamation, he has notified the Senate and the House of Representatives of his")
rule S896DThirtyDayNotification defeasible {
    for country: Text;
    for notified: Date;
    for issued: Date;
    when congress_notified_on_896d(country, notified)
     and proclamation_issued_on_896(country, issued)
     and add_calendar_period(notified, 30 calendar_day) <= issued;
    then notification_at_least_30_days_before_proclamation_896d(country);
}
pub relation proclamation_conditions_met_896a(country: Text) kind institutional {
    label en official "the findings of section 896(a)(1)-(3) and the notification of subsection (d)";
}
@source(IRC_S896_A, relation = formalizes, coverage = partial, quote = "the President shall proclaim that the tax on such similar income derived from sources within the United States by residents or corporations of such foreign country shall, for taxable years beginning")
rule S896AConditionsMet defeasible {
    for country: Text;
    when president_finds_more_burdensome_taxes_896a1(country)
     and foreign_country_did_not_revise_taxes_896a2(country)
     and public_interest_in_pre_1967_provisions_896a3(country)
     and notification_at_least_30_days_before_proclamation_896d(country);
    then proclamation_conditions_met_896a(country);
}
pub relation proclamation_conditions_met_896b(country: Text) kind institutional {
    label en official "the findings of section 896(b)(1)-(3) and the notification of subsection (d)";
}
@source(IRC_S896_B, relation = formalizes, coverage = partial, quote = "the President shall proclaim that the tax on similar income of nationals, residents, or corporations of such foreign country (or such similar class of such nationals, residents, or corporations)")
rule S896BConditionsMet defeasible {
    for country: Text;
    when president_finds_higher_effective_rate_896b1(country)
     and foreign_country_did_not_eliminate_higher_rate_896b2(country)
     and public_interest_in_adjusting_effective_rate_896b3(country)
     and notification_at_least_30_days_before_proclamation_896d(country);
    then proclamation_conditions_met_896b(country);
}
pub relation president_proclaims_pre_1967_provisions_896a(country: Text) kind empirical {
    label en official "the President proclaims that the tax on similar income of residents or corporations of the foreign country is determined without regard to amendments made on or after the enactment";
}
pub relation president_proclaims_effective_rate_adjustment_896b(country: Text) kind empirical {
    label en official "the President proclaims that the tax on similar income of nationals, residents or corporations of the foreign country is adjusted to equal the effective rate imposed by that country on United States citizens";
}
pub relation president_proclaims_relief_896c(country: Text) kind empirical {
    label en official "the President proclaims that the tax on similar income of the country's nationals, residents or corporations is determined without regard to the earlier proclamation";
}
pub relation pre_1967_provisions_apply_to_country_896a(country: Text) kind institutional {
    label en official "the tax on similar income derived from United States sources by residents or corporations of the foreign country is determined without regard to amendments made on or after the enactment, for taxable years beginning after the proclamation (section 896(a))";
}
pub relation effective_rate_adjusted_for_country_896b(country: Text) kind institutional {
    label en official "the tax on similar income of the country's nationals, residents or corporations is adjusted to equal the effective rate imposed by the country on such income of United States citizens (section 896(b))";
}
pub relation retaliation_relieved_for_country_896c(country: Text) kind institutional {
    label en official "the tax on similar income of the country's nationals, residents or corporations is determined without regard to the earlier proclamation (section 896(c))";
}
@source(IRC_S896_A, relation = formalizes, coverage = exact, quote = "Whenever the President finds that—")
rule S896APreSixtySevenProclamationPower defeasible {
    for country: Text;
    when president_proclaims_pre_1967_provisions_896a(country);
    then power S896APreSixtySevenProclamation {
        holder us.irc.international::President;
        over us.irc.international::President;
        exercise president_proclaims_pre_1967_provisions_896a(country);
        valid_when proclamation_conditions_met_896a(country);
        effect create(pre_1967_provisions_apply_to_country_896a(country));
    };
}
@source(IRC_S896_B, relation = formalizes, coverage = exact, quote = "Whenever the President finds that—")
rule S896BEffectiveRateAdjustmentPower defeasible {
    for country: Text;
    when president_proclaims_effective_rate_adjustment_896b(country);
    then power S896BEffectiveRateAdjustmentProclamation {
        holder us.irc.international::President;
        over us.irc.international::President;
        exercise president_proclaims_effective_rate_adjustment_896b(country);
        valid_when proclamation_conditions_met_896b(country);
        effect create(effective_rate_adjusted_for_country_896b(country));
    };
}
@source(IRC_S896_C, relation = formalizes, coverage = exact, quote = "Whenever the President finds that—")
rule S896CReliefProclamationPower defeasible {
    for country: Text;
    when president_proclaims_relief_896c(country);
    then power S896CReliefProclamation {
        holder us.irc.international::President;
        over us.irc.international::President;
        exercise president_proclaims_relief_896c(country);
        valid_when president_finds_laws_modified_896c(country);
        effect create(retaliation_relieved_for_country_896c(country));
    };
}
