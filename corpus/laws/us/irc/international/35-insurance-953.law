// §953 (stage 2d): insurance income, related person insurance income, the section 953(d)
// election, and exempt insurance income. Module 10 reads `insurance_income_953` as a case
// input; the relations here derive an item-level classification that is not chained into it.

// --- §953(a) ---------------------------------------------------------------------------------------------------------------

use self::{
    IRC_S953_A,
    IRC_S953_C,
    IRC_S953_D,
    IRC_S953_E,
};

pub relation income_item_953a(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text, amount: Money) kind empirical {
    label en official "an item of income of the foreign corporation for the year";
}
pub relation attributable_to_issuing_or_reinsuring_contract_953a1A(item_id: Text) kind empirical {
    label en official "the income is attributable to the issuing (or reinsuring) of an insurance or annuity contract";
}
pub relation taxed_under_subchapter_l_if_domestic_953a1B(item_id: Text) kind empirical {
    label en official "the income would (subject to the modifications of subsection (b)) be taxed under subchapter L if it were the income of a domestic insurance company";
}
pub relation insurance_income_item_953a(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text, amount: Money) kind institutional {
    label en official "the item is insurance income for purposes of section 952(a)(1), not including exempt insurance income (section 953(a))";
}
@source(IRC_S953_A, relation = formalizes, coverage = exact, quote = "For purposes of section 952(a)(1), the term \"insurance income\" means any income which—")
rule S953A1InsuranceIncome defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for amount: Money;
    when income_item_953a(corp, y, item_id, amount)
     and attributable_to_issuing_or_reinsuring_contract_953a1A(item_id)
     and taxed_under_subchapter_l_if_domestic_953a1B(item_id);
    unless exempt_insurance_income_item_953e1(corp, y, item_id, amount)
     and income_item_953a(corp, y, item_id, amount);
    then insurance_income_item_953a(corp, y, item_id, amount);
}

// --- §953(c): related person insurance income ------------------------------------------------------------------------------

pub relation us_person_owning_stock_953c1A(p: us.irc.core::Person, corp: us.irc.core::Corporation) kind empirical {
    label en official "a United States person (section 957(c)) who owns (within the meaning of section 958(a)) any stock of the foreign corporation";
}
pub relation united_states_shareholder_for_rpii_953c1A(p: us.irc.core::Person, corp: us.irc.core::Corporation) kind institutional {
    label en official "for purposes only of taking into account related person insurance income, a United States shareholder is a United States person owning any stock of the foreign corporation (section 953(c)(1)(A))";
}
@source(IRC_S953_C, relation = formalizes, coverage = exact, quote = "(A) the term \"United States shareholder\" means, with respect to any foreign corporation, a United States person (as defined in section 957(c)) who owns (within the meaning of section 958(a)) any")
rule S953C1AUnitedStatesShareholderAnyStock defeasible {
    for p: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    when us_person_owning_stock_953c1A(p, corp);
    then united_states_shareholder_for_rpii_953c1A(p, corp);
}
pub relation us_shareholders_ownership_percentage_953c1B(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, percentage: Decimal) kind empirical {
    label en official "the greater of the total combined voting power or the value percentage of the foreign corporation owned by United States shareholders (section 953(c)(1)(A)), on any day of the year";
}
pub relation controlled_foreign_corporation_for_rpii_953c1B(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "for purposes only of related person insurance income, a controlled foreign corporation with `25 percent or more` substituted for `more than 50 percent` (section 953(c)(1)(B))";
}
@source(IRC_S953_C, relation = formalizes, coverage = exact, quote = "(B) the term \"controlled foreign corporation\" has the meaning given to such term by section 957(a) determined by substituting \"25 percent or more\" for \"more than 50 percent\", and")
rule S953C1BControlledForeignCorporation25Percent defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for pct: Decimal;
    when us_shareholders_ownership_percentage_953c1B(corp, y, pct)
     and pct >= 25.0;
    then controlled_foreign_corporation_for_rpii_953c1B(corp, y);
}
pub relation insured_person_is_us_shareholder_or_related_953c2(item_id: Text) kind empirical {
    label en official "the person (directly or indirectly) insured under the policy of insurance or reinsurance is a United States shareholder in the foreign corporation or a related person to such a shareholder";
}
pub relation related_person_insurance_income_953c2(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text, amount: Money) kind institutional {
    label en official "related person insurance income: insurance income attributable to a policy of insurance or reinsurance where the insured is a United States shareholder or a related person (section 953(c)(2))";
}
@source(IRC_S953_C, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, the term \"related person insurance income\" means any insurance income (within the meaning of subsection (a)) attributable to a policy of insurance or reinsurance with")
rule S953C2RelatedPersonInsuranceIncome defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for amount: Money;
    when insurance_income_item_953a(corp, y, item_id, amount)
     and insured_person_is_us_shareholder_or_related_953c2(item_id);
    then related_person_insurance_income_953c2(corp, y, item_id, amount);
}
pub relation insureds_voting_power_and_value_percentages_953c3A(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, maximum_voting_power: Decimal, maximum_value: Decimal) kind empirical {
    label en official "the highest percentages, at any time during the year, of the total combined voting power and of the total value of the corporation owned (directly or indirectly under section 883(c)(4)) by insured persons or their related persons";
}
pub relation rpii_and_insurance_income_gross_953c3B(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, rpii_gross: Money, insurance_income_gross: Money) kind empirical {
    label en official "related person insurance income and insurance income (both on a gross basis, insurance income without regard to the country limits of subsection (a)(1)) for the year";
}
pub relation elects_eci_treatment_and_waives_treaty_953c3C(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the corporation elects to treat its related person insurance income as effectively connected with a United States trade or business and to waive treaty benefits (other than with respect to section 884)";
}
pub relation meets_secretary_requirements_tax_paid_953c3Cii(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the corporation meets the requirements the Secretary prescribes to ensure that the tax imposed on the income is paid";
}
pub relation cfc_uninterrupted_30_days_and_us_shareholder_owned_stock_953c3E(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the foreign corporation is a controlled foreign corporation (without regard to this subsection) for an uninterrupted period of 30 days or more during the year and a United States shareholder owns stock in it at some time during the year";
}
pub relation disqualified_corporation_953c3E(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "a disqualified corporation for the taxable year (section 953(c)(3)(E))";
}
@source(IRC_S953_C, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph the term \"disqualified corporation\" means, with respect to any taxable year, any foreign corporation which is a controlled foreign corporation for an uninterrupted")
rule S953C3EDisqualifiedCorporation defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when cfc_uninterrupted_30_days_and_us_shareholder_owned_stock_953c3E(corp, y);
    then disqualified_corporation_953c3E(corp, y);
}
pub relation election_requirements_met_953c3C(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the election's requirements are met: it is not effective if the corporation (or a predecessor) was a disqualified corporation for the year or a prior year beginning after 1986 (section 953(c)(3)(C), last sentence); the prior-year test is asserted through the year fact";
}
@source(IRC_S953_C, relation = formalizes, coverage = partial, quote = "(ii) such corporation meets such requirements as the Secretary shall prescribe to ensure that the tax imposed by this chapter on such income is paid.")
rule S953C3CElectionRequirementsMet defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when meets_secretary_requirements_tax_paid_953c3Cii(corp, y);
    unless disqualified_corporation_953c3E(corp, y)
     and meets_secretary_requirements_tax_paid_953c3Cii(corp, y);
    then election_requirements_met_953c3C(corp, y);
}
pub relation rpii_treated_as_effectively_connected_953c3C(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the related person insurance income for the year is treated as effectively connected with a trade or business in the United States, and section 4371 does not apply to it (section 953(c)(3)(C), (D)(ii))";
}
@source(IRC_S953_C, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall not apply to any foreign corporation for any taxable year if—")
rule S953C3CElectionPower defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when elects_eci_treatment_and_waives_treaty_953c3C(corp, y);
    then power S953C3CEciElection {
        holder corp;
        over corp;
        exercise elects_eci_treatment_and_waives_treaty_953c3C(corp, y);
        valid_when election_requirements_met_953c3C(corp, y);
        effect create(rpii_treated_as_effectively_connected_953c3C(corp, y));
    };
}
pub relation paragraph_1_not_applicable_953c3(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "paragraph (1) does not apply to the corporation for the year: the 20 percent ownership exception, the 20 percent related person insurance income exception, or the election (section 953(c)(3))";
}
@source(IRC_S953_C, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall not apply to any foreign corporation if at all times during the taxable year of such foreign corporation—")
rule S953C3AOwnershipUnderTwentyPercent defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for voting: Decimal;
    for value: Decimal;
    when insureds_voting_power_and_value_percentages_953c3A(corp, y, voting, value)
     and voting < 20.0
     and value < 20.0;
    then paragraph_1_not_applicable_953c3(corp, y);
}
@source(IRC_S953_C, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall not apply to any foreign corporation for a taxable year of such corporation if the related person insurance income (determined on a gross basis) of such corporation for such")
rule S953C3BRpiiUnderTwentyPercentOfInsuranceIncome defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for rpii: Money;
    for insurance: Money;
    when rpii_and_insurance_income_gross_953c3B(corp, y, rpii, insurance)
     and rpii < insurance * 0.20;
    then paragraph_1_not_applicable_953c3(corp, y);
}
@source(IRC_S953_C, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall not apply to any foreign corporation for any taxable year if—")
rule S953C3CElectionMakesParagraph1Inapplicable defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when rpii_treated_as_effectively_connected_953c3C(corp, y);
    then paragraph_1_not_applicable_953c3(corp, y);
}
pub relation rpii_rules_apply_953c(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the foreign corporation is a controlled foreign corporation for related person insurance income and no exception of paragraph (3) applies (section 953(c)(1), (3))";
}
@source(IRC_S953_C, relation = formalizes, coverage = exact, quote = "For purposes only of taking into account related person insurance income—")
rule S953C1RpiiRulesApply defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when controlled_foreign_corporation_for_rpii_953c1B(corp, y);
    unless paragraph_1_not_applicable_953c3(corp, y)
     and controlled_foreign_corporation_for_rpii_953c1B(corp, y);
    then rpii_rules_apply_953c(corp, y);
}
pub relation election_ceases_after_later_disqualification_953c3D(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the corporation which made an election under subparagraph (C) is a disqualified corporation for a subsequent taxable year: the election does not apply to years beginning after that year";
}
pub relation pro_rata_share_alternatives_953c5A(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, rpii_only_share: Money, entire_earnings_share: Money) kind empirical {
    label en official "the amount under section 951(a)(2) if only related person insurance income, only stock owned by United States shareholders on the last day of the year and only their distributions were taken into account (clause (i)), and the amount if the entire earnings and profits were subpart F income (clause (ii))";
}
pub relation rpii_pro_rata_share_953c5A(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the pro rata share for a United States shareholder is the lesser of the two amounts (section 953(c)(5)(A))";
}
@source(IRC_S953_C, relation = formalizes, coverage = exact, quote = "The pro rata share determined under this paragraph for any United States shareholder is the lesser of—")
rule S953C5ALesserOfTwoAmounts defeasible {
    for p: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for a: Money;
    for b: Money;
    when pro_rata_share_alternatives_953c5A(p, corp, y, a, b);
    then rpii_pro_rata_share_953c5A(p, corp, y, min(a, b));
}
pub relation person_performs_services_as_director_officer_employee_or_partner_953c6B(person: Text, entity_id: Text) kind empirical {
    label en official "a person performing services as a director, officer or employee of a corporation or as a partner or employee of a partnership, for the entity, under a policy covering liability arising from those services";
}
pub relation related_persons_953c6B(person: Text, entity_id: Text) kind institutional {
    label en official "the person performing the services and the entity for which they are performed are related persons for a liability policy (section 953(c)(6)(B))";
}
@source(IRC_S953_C, relation = formalizes, coverage = exact, quote = "In the case of any policy of insurance covering liability arising from services performed as a director, officer, or employee of a corporation or as a partner or employee of a partnership, the person")
rule S953C6BLiabilityPolicyRelatedPersons defeasible {
    for person: Text;
    for entity_id: Text;
    when person_performs_services_as_director_officer_employee_or_partner_953c6B(person, entity_id);
    then related_persons_953c6B(person, entity_id);
}
pub relation shareholder_and_controlled_foreign_corporation_would_be_but_for_953c3_953c7(p: us.irc.core::Person, corp: us.irc.core::Corporation) kind empirical {
    label en official "the person is (or would be but for paragraph (3)) treated under paragraph (1) as a United States shareholder of a foreign corporation that would be taxed under subchapter L if it were domestic and that is (or would be but for paragraph (3)) a controlled foreign corporation";
}
pub relation meets_1248a2_ownership_and_corp_is_cfc_953c7(p: us.irc.core::Person, corp: us.irc.core::Corporation) kind institutional {
    label en official "for purposes of section 1248 the person is treated as meeting the stock ownership requirements of section 1248(a)(2) and the foreign corporation is treated as a controlled foreign corporation (section 953(c)(7))";
}
@source(IRC_S953_C, relation = formalizes, coverage = exact, quote = "For purposes of section 1248, if any person is (or would be but for paragraph (3)) treated under paragraph (1) as a United States shareholder with respect to any foreign corporation which would be")
rule S953C7Section1248Treatment defeasible {
    for p: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    when shareholder_and_controlled_foreign_corporation_would_be_but_for_953c3_953c7(p, corp);
    then meets_1248a2_ownership_and_corp_is_cfc_953c7(p, corp);
}

// --- §953(d): election to be treated as a domestic corporation ------------------------------------------------------------------

pub relation controlled_foreign_corporation_25_percent_953d1A(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the foreign corporation is a controlled foreign corporation (section 957(a) with 25 percent or more substituted, using the United States shareholder definition of subsection (c)(1)(A))";
}
pub relation would_qualify_under_part_i_or_ii_subchapter_l_953d1B(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the foreign corporation would qualify under part I or II of subchapter L for the year if it were a domestic corporation";
}
pub relation meets_secretary_requirements_taxes_paid_953d1C(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the foreign corporation meets the requirements the Secretary prescribes to ensure that the taxes imposed by this chapter on it are paid";
}
pub relation elects_domestic_treatment_and_waives_treaty_953d1D(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the foreign corporation makes an election to have paragraph (1) apply and waives all treaty benefits";
}
pub relation election_953d1_conditions_met(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "conditions (A) to (C) of section 953(d)(1) are met";
}
@source(IRC_S953_D, relation = formalizes, coverage = exact, quote = "(A) a foreign corporation is a controlled foreign corporation (as defined in section 957(a) by substituting \"25 percent or more\" for \"more than 50 percent\" and by using the definition of United")
rule S953D1ConditionsAToC defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when controlled_foreign_corporation_25_percent_953d1A(corp, y)
     and would_qualify_under_part_i_or_ii_subchapter_l_953d1B(corp, y)
     and meets_secretary_requirements_taxes_paid_953d1C(corp, y);
    then election_953d1_conditions_met(corp, y);
}
pub relation treated_as_domestic_corporation_953d1(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "for purposes of this title the corporation is treated as a domestic corporation (section 953(d)(1))";
}
@source(IRC_S953_D, relation = formalizes, coverage = exact, quote = "(D) such foreign corporation makes an election to have this paragraph apply and waives all benefits to such corporation granted by the United States under any treaty,")
rule S953D1DomesticElectionPower defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when elects_domestic_treatment_and_waives_treaty_953d1D(corp, y);
    then power S953D1DomesticTreatmentElection {
        holder corp;
        over corp;
        exercise elects_domestic_treatment_and_waives_treaty_953d1D(corp, y);
        valid_when election_953d1_conditions_met(corp, y);
        effect create(treated_as_domestic_corporation_953d1(corp, y));
    };
}
pub relation capital_and_accumulated_surplus_at_1987_12_31_953d6(corp: us.irc.core::Corporation, amount: Money) kind empirical {
    label en official "the aggregate amount of capital and accumulated surplus of the corporation as of December 31, 1987";
}
pub relation first_year_tax_increase_953d6(corp: us.irc.core::Corporation, amount: Money) kind institutional {
    label en official "the tax for the first taxable year to which the election applies is increased by the lesser of 3/4 of 1 percent of capital and accumulated surplus as of December 31, 1987 or $1,500,000 (section 953(d)(6))";
}
@source(IRC_S953_D, relation = formalizes, coverage = exact, quote = "The amount of tax determined under this paragraph shall be equal to the lesser of—")
rule S953D6IncreaseLesserOfCapitalPercentAndCap defeasible {
    for corp: us.irc.core::Corporation;
    for capital: Money;
    when capital_and_accumulated_surplus_at_1987_12_31_953d6(corp, capital);
    then first_year_tax_increase_953d6(corp, min(round(capital * 0.0075, 2, "HALF_UP"), 1500000.00 USD));
}

// --- §953(e): exempt insurance income ----------------------------------------------------------------------------------------------

pub relation controlled_foreign_corporation_953e3(corp: us.irc.core::Corporation) kind empirical {
    label en official "the corporation is a controlled foreign corporation";
}
pub relation regulated_and_licensed_to_sell_to_unrelated_persons_in_home_country_953e3A(corp: us.irc.core::Corporation) kind empirical {
    label en official "the corporation is subject to regulation as an insurance (or reinsurance) company by its home country and is licensed, authorized or regulated to sell insurance, reinsurance or annuity contracts to persons other than related persons in the home country";
}
pub relation home_country_risk_unrelated_premium_percentage_953e3B(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, percentage: Decimal) kind empirical {
    label en official "the percentage of aggregate net written premiums of the corporation and its qualifying insurance company branches from contracts covering applicable home country risks with no related policyholder, insured, annuitant or beneficiary (branch premiums only to the extent treated as earned in the home country)";
}
pub relation engaged_in_insurance_business_taxable_under_subchapter_l_if_domestic_953e3C(corp: us.irc.core::Corporation) kind empirical {
    label en official "the corporation is engaged in the insurance business and would be subject to tax under subchapter L if it were a domestic corporation";
}
pub relation qualifying_insurance_company_953e3(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "a qualifying insurance company (section 953(e)(3))";
}
@source(IRC_S953_E, relation = formalizes, coverage = exact, quote = "The term \"qualifying insurance company\" means any controlled foreign corporation which—")
rule S953E3QualifyingInsuranceCompany defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for pct: Decimal;
    when controlled_foreign_corporation_953e3(corp)
     and regulated_and_licensed_to_sell_to_unrelated_persons_in_home_country_953e3A(corp)
     and home_country_risk_unrelated_premium_percentage_953e3B(corp, y, pct)
     and pct > 50.0
     and engaged_in_insurance_business_taxable_under_subchapter_l_if_domestic_953e3C(corp);
    then qualifying_insurance_company_953e3(corp, y);
}
pub relation qbu_licensed_to_sell_to_unrelated_persons_in_home_country_953e4A(branch_id: Text) kind empirical {
    label en official "the qualified business unit is licensed, authorized or regulated by the applicable insurance regulatory body for its home country to sell insurance, reinsurance or annuity contracts to persons other than related persons in that country";
}
pub relation branch_owner_953e4(branch_id: Text, corp: us.irc.core::Corporation) kind empirical {
    label en official "the qualified business unit is a unit of the controlled foreign corporation";
}
pub relation branch_treated_as_qualifying_branch_owner_qualifies_953e4B(branch_id: Text, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the controlled foreign corporation is a qualifying insurance company determined under paragraph (3) as if the unit were a qualifying insurance company branch";
}
pub relation qualifying_insurance_company_branch_953e4(branch_id: Text, y: us.irc.core::TaxableYear) kind institutional {
    label en official "a qualifying insurance company branch (section 953(e)(4))";
}
@source(IRC_S953_E, relation = formalizes, coverage = exact, quote = "The term \"qualifying insurance company branch\" means a qualified business unit (within the meaning of section 989(a)) of a controlled foreign corporation if—")
rule S953E4QualifyingInsuranceCompanyBranch defeasible {
    for branch_id: Text;
    for y: us.irc.core::TaxableYear;
    for corp: us.irc.core::Corporation;
    when branch_owner_953e4(branch_id, corp)
     and controlled_foreign_corporation_953e3(corp)
     and qbu_licensed_to_sell_to_unrelated_persons_in_home_country_953e4A(branch_id)
     and branch_treated_as_qualifying_branch_owner_qualifies_953e4B(branch_id, y);
    then qualifying_insurance_company_branch_953e4(branch_id, y);
}
pub relation contract_covers_non_us_property_liability_or_residents_953e2A(contract_id: Text) kind empirical {
    label en official "the insurance or annuity contract is in connection with property in, liability arising out of activity in, or the lives or health of residents of, a country other than the United States";
}
pub relation contract_issued_or_reinsured_by_953e2A(contract_id: Text, issuer_id: Text) kind empirical {
    label en official "the contract is issued or reinsured by the qualifying insurance company or qualifying insurance company branch";
}
pub relation issuer_is_qualifying_company_or_branch_953e(issuer_id: Text, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the issuer is a qualifying insurance company or a qualifying insurance company branch for the year (a domain anchor tying the issuer id to the derived relations)";
}
pub relation issuer_net_written_premium_share_from_home_risks_953e2Bi(issuer_id: Text, percentage: Decimal) kind empirical {
    label en official "the percentage of net written premiums the company or branch derives from contracts covering applicable home country risks and with no related policyholder, insured, annuitant or beneficiary (determined without regard to subparagraph (B))";
}
pub relation contract_covers_applicable_home_country_risks_953e2Bii(contract_id: Text) kind empirical {
    label en official "the contract covers risks in connection with property in, liability arising out of activity in, or the lives or health of residents of, the home country of the company or branch issuing or reinsuring it";
}
pub relation issuer_conducts_substantial_home_country_activity_953e2Ci(issuer_id: Text) kind empirical {
    label en official "the company or branch conducts substantial activity with respect to an insurance business in its home country";
}
pub relation issuer_performs_substantially_all_income_activities_in_home_country_953e2Cii(issuer_id: Text) kind empirical {
    label en official "the company or branch performs in its home country substantially all of the activities necessary to give rise to the income generated by the contract";
}
pub relation contract_marketed_to_us_resident_covering_risk_abroad_953e7Di(contract_id: Text) kind empirical {
    label en official "a policyholder, insured, annuitant or beneficiary is a resident of the United States and the contract was marketed to such resident and written to cover a risk outside the United States";
}
pub relation mixed_risk_contract_without_required_records_953e7Dii(contract_id: Text) kind empirical {
    label en official "the contract covers risks located within and without the United States and the company or branch does not maintain the contemporaneous records and file the reports the Secretary requires";
}
pub relation contract_reinsures_related_person_contract_953e7F(contract_id: Text) kind empirical {
    label en official "the contract reinsures a contract issued or reinsured by a related person (section 954(d)(3))";
}
pub relation exempt_contract_953e2(contract_id: Text) kind institutional {
    label en official "an exempt contract (section 953(e)(2)), subject to the exclusions of paragraph (7)(D) and (F)";
}
@source(IRC_S953_E, relation = formalizes, coverage = partial, quote = "No contract of a qualifying insurance company or of a qualifying insurance company branch shall be treated as an exempt contract unless such company or branch derives more than 30 percent of its net")
rule S953E2BiHomeCountryRiskContractIsExempt defeasible {
    for contract_id: Text;
    for issuer_id: Text;
    for y: us.irc.core::TaxableYear;
    for pct: Decimal;
    when contract_covers_non_us_property_liability_or_residents_953e2A(contract_id)
     and contract_issued_or_reinsured_by_953e2A(contract_id, issuer_id)
     and issuer_is_qualifying_company_or_branch_953e(issuer_id, y)
     and issuer_net_written_premium_share_from_home_risks_953e2Bi(issuer_id, pct)
     and pct > 30.0
     and contract_covers_applicable_home_country_risks_953e2Bii(contract_id);
    unless contract_marketed_to_us_resident_covering_risk_abroad_953e7Di(contract_id)
     and contract_covers_non_us_property_liability_or_residents_953e2A(contract_id);
    unless mixed_risk_contract_without_required_records_953e7Dii(contract_id)
     and contract_covers_non_us_property_liability_or_residents_953e2A(contract_id);
    unless contract_reinsures_related_person_contract_953e7F(contract_id)
     and contract_covers_non_us_property_liability_or_residents_953e2A(contract_id);
    then exempt_contract_953e2(contract_id);
}
@source(IRC_S953_E, relation = formalizes, coverage = exact, quote = "A contract issued by a qualifying insurance company or qualifying insurance company branch which covers risks other than applicable home country risks (as defined in subparagraph (B)(ii)) shall not")
rule S953E2COtherRiskContractIsExemptWithHomeActivity defeasible {
    for contract_id: Text;
    for issuer_id: Text;
    for y: us.irc.core::TaxableYear;
    for pct: Decimal;
    when contract_covers_non_us_property_liability_or_residents_953e2A(contract_id)
     and contract_issued_or_reinsured_by_953e2A(contract_id, issuer_id)
     and issuer_is_qualifying_company_or_branch_953e(issuer_id, y)
     and issuer_net_written_premium_share_from_home_risks_953e2Bi(issuer_id, pct)
     and pct > 30.0
     and issuer_conducts_substantial_home_country_activity_953e2Ci(issuer_id)
     and issuer_performs_substantially_all_income_activities_in_home_country_953e2Cii(issuer_id);
    unless contract_covers_applicable_home_country_risks_953e2Bii(contract_id)
     and contract_covers_non_us_property_liability_or_residents_953e2A(contract_id);
    unless contract_marketed_to_us_resident_covering_risk_abroad_953e7Di(contract_id)
     and contract_covers_non_us_property_liability_or_residents_953e2A(contract_id);
    unless mixed_risk_contract_without_required_records_953e7Dii(contract_id)
     and contract_covers_non_us_property_liability_or_residents_953e2A(contract_id);
    unless contract_reinsures_related_person_contract_953e7F(contract_id)
     and contract_covers_non_us_property_liability_or_residents_953e2A(contract_id);
    then exempt_contract_953e2(contract_id);
}
pub relation income_of_qualifying_insurance_company_from_contract_953e1(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text, contract_id: Text, amount: Money, earned_in_home_country: Boolean) kind empirical {
    label en official "income derived by a qualifying insurance company attributable to issuing or reinsuring a contract by the company or a qualifying branch, and whether it is treated as earned in the home country for that country's tax laws";
}
pub relation arrangement_substantially_equal_premiums_to_other_corporation_953e1B(contract_id: Text) kind empirical {
    label en official "under an arrangement another corporation receives a substantially equal amount of premiums or other consideration for issuing or reinsuring a contract which is not an exempt contract";
}
pub relation exempt_insurance_income_item_953e1(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text, amount: Money) kind institutional {
    label en official "exempt insurance income of a qualifying insurance company (section 953(e)(1))";
}
@source(IRC_S953_E, relation = formalizes, coverage = exact, quote = "The term \"exempt insurance income\" means income derived by a qualifying insurance company which—")
rule S953E1AExemptInsuranceIncome defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for contract_id: Text;
    for amount: Money;
    for earned: Boolean;
    when income_of_qualifying_insurance_company_from_contract_953e1(corp, y, item_id, contract_id, amount, earned)
     and qualifying_insurance_company_953e3(corp, y)
     and exempt_contract_953e2(contract_id)
     and earned == true;
    unless arrangement_substantially_equal_premiums_to_other_corporation_953e1B(contract_id)
     and income_of_qualifying_insurance_company_from_contract_953e1(corp, y, item_id, contract_id, amount, earned);
    then exempt_insurance_income_item_953e1(corp, y, item_id, amount);
}
pub relation exempt_insurance_income_for_subsection_c_953e8(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text, amount: Money) kind institutional {
    label en official "in determining insurance income for subsection (c), exempt insurance income does not include income derived from exempt contracts covering risks other than applicable home country risks (section 953(e)(8))";
}
@source(IRC_S953_E, relation = formalizes, coverage = exact, quote = "In determining insurance income for purposes of subsection (c), exempt insurance income shall not include income derived from exempt contracts which cover risks other than applicable home country")
rule S953E8ExemptIncomeForSubsectionC defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for contract_id: Text;
    for amount: Money;
    for earned: Boolean;
    when income_of_qualifying_insurance_company_from_contract_953e1(corp, y, item_id, contract_id, amount, earned)
     and exempt_insurance_income_item_953e1(corp, y, item_id, amount)
     and contract_covers_applicable_home_country_risks_953e2Bii(contract_id);
    then exempt_insurance_income_for_subsection_c_953e8(corp, y, item_id, amount);
}
pub relation country_of_creation_or_organization_953e6A(corp: us.irc.core::Corporation, country: Text) kind empirical {
    label en official "the country in which the corporation is created or organized";
}
pub relation home_country_of_cfc_953e6A(corp: us.irc.core::Corporation, country: Text) kind institutional {
    label en official "the home country of a controlled foreign corporation is the country in which it is created or organized (section 953(e)(6)(A))";
}
@source(IRC_S953_E, relation = formalizes, coverage = exact, quote = "The term \"home country\" means, with respect to a controlled foreign corporation, the country in which such corporation is created or organized.")
rule S953E6AHomeCountryOfCorporation defeasible {
    for corp: us.irc.core::Corporation;
    for country: Text;
    when country_of_creation_or_organization_953e6A(corp, country);
    then home_country_of_cfc_953e6A(corp, country);
}
pub relation qbu_principal_office_and_licensed_country_953e6B(branch_id: Text, country: Text) kind empirical {
    label en official "the country in which the principal office of the qualified business unit is located and in which it is licensed, authorized or regulated to sell insurance, reinsurance or annuity contracts to persons other than related persons";
}
pub relation home_country_of_branch_953e6B(branch_id: Text, country: Text) kind institutional {
    label en official "the home country of a qualified business unit (section 953(e)(6)(B))";
}
@source(IRC_S953_E, relation = formalizes, coverage = exact, quote = "The term \"home country\" means, with respect to a qualified business unit (as defined in section 989(a)), the country in which the principal office of such unit is located and in which such unit is")
rule S953E6BHomeCountryOfBranch defeasible {
    for branch_id: Text;
    for country: Text;
    when qbu_principal_office_and_licensed_country_953e6B(branch_id, country);
    then home_country_of_branch_953e6B(branch_id, country);
}
