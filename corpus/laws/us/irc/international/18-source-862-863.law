// §862 — income from sources without the United States; §863 — allocation
// under regulations, income partly within and partly without, transportation
// income (c), space and ocean activities (d), international communications
// income (e). Stage 2c (IRC-10 stage 2c, A13).
//
// Conventions of this module: an item of gross income is identified by a
// case-supplied `item_id: Text` with the class facts the statute keys on. The
// residual phrase of §862(a)(1)/(2)/(7)/(9) ("other than that derived from
// sources within the United States as provided in section 861(a)(n)") is read
// as absence of the US-source conclusion for the same item: this package's own
// section 861(a) rules are keyed by payer/payee rather than by item, so the
// bridge is the case fact `item_us_source_under_861a` (asserted from the
// module-01 result; TECH-GAPS G1726).

// --- §862(a): items of gross income treated as foreign source ---------------

use self::{
    IRC_S862_A,
    IRC_S862_B,
    IRC_S863_A,
    IRC_S863_B,
    IRC_S863_C,
    IRC_S863_D,
    IRC_S863_E,
};

pub relation gross_income_item_862(p: us.irc.core::Person, item_id: Text, amount: Money) kind empirical {
    label en unofficial "an item of gross income of the person, identified by item_id, classified for sections 861-863";
}
pub relation item_us_source_under_861a(item_id: Text) kind empirical {
    label en official "the item is derived from sources within the United States as provided in section 861(a) (the module-01 conclusion, asserted per item)";
}
pub relation item_is_interest_862(item_id: Text) kind empirical {
    label en unofficial "the item is interest, for section 862(a)(1)";
}
pub relation item_is_dividend_862(item_id: Text) kind empirical {
    label en unofficial "the item is a dividend, for section 862(a)(2)";
}
pub relation item_is_compensation_for_services_862(item_id: Text) kind empirical {
    label en unofficial "the item is compensation for labor or personal services, for section 862(a)(3)";
}
pub relation services_performed_without_us_862(item_id: Text) kind empirical {
    label en official "the labor or personal services were performed without the United States, for section 862(a)(3)";
}
pub relation item_is_rental_or_royalty_862(item_id: Text) kind empirical {
    label en unofficial "the item is a rental or royalty (including for patents, copyrights, secret processes and formulas, good will, trade-marks, trade brands, franchises and like properties), for section 862(a)(4)";
}
pub relation rental_property_located_without_us_862(item_id: Text) kind empirical {
    label en official "the property (or the interest in it) that yields the rental or royalty is located without the United States, or is the intangible used without the United States, for section 862(a)(4)";
}
pub relation item_is_real_property_sale_income_862(item_id: Text) kind empirical {
    label en unofficial "the item is gain, profit or income from the sale or exchange of real property, for section 862(a)(5)";
}
pub relation real_property_sold_located_without_us_862(item_id: Text) kind empirical {
    label en official "the real property sold or exchanged is located without the United States, for section 862(a)(5)";
}
pub relation inventory_purchased_in_us_sold_without_us_862(item_id: Text) kind empirical {
    label en official "the item is gain, profit or income derived from the purchase of inventory property (section 865(i)(1)) within the United States and its sale or exchange without the United States, for section 862(a)(6)";
}
pub relation item_is_underwriting_income_862(item_id: Text) kind empirical {
    label en unofficial "the item is underwriting income, for section 862(a)(7)";
}
pub relation item_is_usrpi_disposition_in_virgin_islands_862(item_id: Text) kind empirical {
    label en official "the item is gain, profit or income from the disposition of a United States real property interest (section 897(c)) when the real property is located in the Virgin Islands, for section 862(a)(8)";
}
pub relation item_is_guarantee_fee_from_foreign_person_862(item_id: Text) kind empirical {
    label en official "the item is an amount received, directly or indirectly, from a foreign person for the provision of a guarantee of indebtedness of that person, for section 862(a)(9)";
}

pub relation foreign_source_item_862(p: us.irc.core::Person, item_id: Text, amount: Money) kind institutional {
    label en official "the item of gross income is treated as income from sources without the United States (section 862(a))";
}
@source(IRC_S862_A, relation = formalizes, coverage = partial, quote = "(1) interest other than that derived from sources within the United States as provided in section 861(a)(1);")
rule S862A1ForeignSourceInterest defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    for amount: Money;
    when gross_income_item_862(p, item_id, amount)
     and item_is_interest_862(item_id)
     and not_known(item_us_source_under_861a(item_id));
    then foreign_source_item_862(p, item_id, amount);
}
@source(IRC_S862_A, relation = formalizes, coverage = partial, quote = "(2) dividends other than those derived from sources within the United States as provided in section 861(a)(2);")
rule S862A2ForeignSourceDividends defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    for amount: Money;
    when gross_income_item_862(p, item_id, amount)
     and item_is_dividend_862(item_id)
     and not_known(item_us_source_under_861a(item_id));
    then foreign_source_item_862(p, item_id, amount);
}
@source(IRC_S862_A, relation = formalizes, coverage = exact, quote = "(3) compensation for labor or personal services performed without the United States;")
rule S862A3ForeignSourceServicesCompensation defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    for amount: Money;
    when gross_income_item_862(p, item_id, amount)
     and item_is_compensation_for_services_862(item_id)
     and services_performed_without_us_862(item_id);
    then foreign_source_item_862(p, item_id, amount);
}
@source(IRC_S862_A, relation = formalizes, coverage = partial, quote = "(4) rentals or royalties from property located without the United States or from any interest in such property")
rule S862A4ForeignSourceRentalsRoyalties defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    for amount: Money;
    when gross_income_item_862(p, item_id, amount)
     and item_is_rental_or_royalty_862(item_id)
     and rental_property_located_without_us_862(item_id);
    then foreign_source_item_862(p, item_id, amount);
}
@source(IRC_S862_A, relation = formalizes, coverage = exact, quote = "(5) gains, profits, and income from the sale or exchange of real property located without the United States;")
rule S862A5ForeignSourceRealPropertySale defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    for amount: Money;
    when gross_income_item_862(p, item_id, amount)
     and item_is_real_property_sale_income_862(item_id)
     and real_property_sold_located_without_us_862(item_id);
    then foreign_source_item_862(p, item_id, amount);
}
@source(IRC_S862_A, relation = formalizes, coverage = partial, quote = "(6) gains, profits, and income derived from the purchase of inventory property (within the meaning of section 865(i)(1)) within the United States and its sale or exchange without the United States;")
rule S862A6ForeignSourceInventoryPurchasedUsSoldAbroad defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    for amount: Money;
    when gross_income_item_862(p, item_id, amount)
     and inventory_purchased_in_us_sold_without_us_862(item_id);
    then foreign_source_item_862(p, item_id, amount);
}
@source(IRC_S862_A, relation = formalizes, coverage = partial, quote = "(7) underwriting income other than that derived from sources within the United States as provided in section 861(a)(7);")
rule S862A7ForeignSourceUnderwritingIncome defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    for amount: Money;
    when gross_income_item_862(p, item_id, amount)
     and item_is_underwriting_income_862(item_id)
     and not_known(item_us_source_under_861a(item_id));
    then foreign_source_item_862(p, item_id, amount);
}
@source(IRC_S862_A, relation = formalizes, coverage = exact, quote = "(8) gains, profits, and income from the disposition of a United States real property interest (as defined in section 897(c)) when the real property is located in the Virgin Islands; and")
rule S862A8ForeignSourceVirginIslandsUsrpi defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    for amount: Money;
    when gross_income_item_862(p, item_id, amount)
     and item_is_usrpi_disposition_in_virgin_islands_862(item_id);
    then foreign_source_item_862(p, item_id, amount);
}
@source(IRC_S862_A, relation = formalizes, coverage = partial, quote = "(9) amounts received, directly or indirectly, from a foreign person for the provision of a guarantee of indebtedness of such person other than amounts which are derived from sources within the United States as provided in section 861(a)(9).")
rule S862A9ForeignSourceGuaranteeFee defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    for amount: Money;
    when gross_income_item_862(p, item_id, amount)
     and item_is_guarantee_fee_from_foreign_person_862(item_id)
     and not_known(item_us_source_under_861a(item_id));
    then foreign_source_item_862(p, item_id, amount);
}

// --- §862(b) / §863(a) second and third sentences: taxable income -----------
//
// "A ratable part" of the deductions that cannot definitely be allocated is
// the regulatory apportionment (Treas. Reg. 1.861-8); this module takes the
// ratable part as a case-supplied amount and applies the statutory
// subtraction and the "remainder, if any" floor (TECH-GAPS G1727 for the
// derivation of the ratable part itself).

pub relation foreign_source_gross_income_total(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the sum of the person's section 862(a) items of gross income for the taxable year (an aggregate asserted directly: a `sum all` over a derived relation is a runtime-subset limit, section 111)";
}
pub relation deductions_allocated_to_foreign_source_items(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the expenses, losses and other deductions properly apportioned or allocated to the section 862(a) items";
}
pub relation ratable_part_of_unallocable_deductions_foreign(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the ratable part, attributable to the section 862(a) items, of expenses, losses or other deductions which cannot definitely be allocated to some item or class of gross income";
}
pub relation standard_deduction_of_nonitemizer_862b(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the standard deduction of an individual who does not itemize deductions, considered a deduction which cannot definitely be allocated (section 862(b) last sentence)";
}
pub relation ratable_part_of_standard_deduction_foreign(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the ratable part of the non-itemizer's standard deduction attributed to the section 862(a) items — computed by the same ratable-part method as any other unallocable deduction";
}
pub relation itemizes_deductions_862b(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en unofficial "the individual itemizes deductions for the taxable year";
}

pub relation foreign_source_taxable_income_862b(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the taxable income from sources without the United States: section 862(a) gross income minus the deductions allocated or apportioned to it and the ratable part of the unallocable deductions, the remainder, if any, treated in full as foreign-source taxable income (section 862(b))";
}
@source(IRC_S862_B, relation = formalizes, coverage = partial, quote = "The remainder, if any, shall be treated in full as taxable income from sources without the United States.")
rule S862BForeignSourceTaxableIncomeItemizer defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for gross: Money;
    for allocated: Money;
    for ratable: Money;
    when foreign_source_gross_income_total(p, y, gross)
     and deductions_allocated_to_foreign_source_items(p, y, allocated)
     and ratable_part_of_unallocable_deductions_foreign(p, y, ratable)
     and itemizes_deductions_862b(p, y);
    then foreign_source_taxable_income_862b(p, y, max(0.00 USD, gross - allocated - ratable));
}
@source(IRC_S862_B, relation = formalizes, coverage = partial, quote = "In the case of an individual who does not itemize deductions, an amount equal to the standard deduction shall be considered a deduction which cannot definitely be allocated to some item or class of gross income.")
rule S862BForeignSourceTaxableIncomeNonItemizer defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for gross: Money;
    for allocated: Money;
    for ratable: Money;
    for std_part: Money;
    when foreign_source_gross_income_total(p, y, gross)
     and deductions_allocated_to_foreign_source_items(p, y, allocated)
     and ratable_part_of_unallocable_deductions_foreign(p, y, ratable)
     and standard_deduction_of_nonitemizer_862b(p, y, _)
     and ratable_part_of_standard_deduction_foreign(p, y, std_part);
    unless itemizes_deductions_862b(p, y)
     and foreign_source_gross_income_total(p, y, gross)
     and deductions_allocated_to_foreign_source_items(p, y, allocated)
     and ratable_part_of_unallocable_deductions_foreign(p, y, ratable)
     and ratable_part_of_standard_deduction_foreign(p, y, std_part);
    then foreign_source_taxable_income_862b(p, y, max(0.00 USD, gross - allocated - ratable - std_part));
}

// §863(a) sentences 2-3: the same subtraction for the items separately
// allocated to sources within the United States.
pub relation us_source_gross_income_separately_allocated_863a(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "items of gross income separately allocated to sources within the United States under section 863(a)";
}
pub relation deductions_allocated_to_us_source_items_863a(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the expenses, losses and other deductions properly apportioned or allocated to the separately allocated United States items";
}
pub relation ratable_part_of_unallocable_deductions_us_863a(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the ratable part of other expenses, losses or other deductions which cannot definitely be allocated to some item or class of gross income, attributable to the separately allocated United States items";
}
pub relation us_source_taxable_income_863a(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the taxable income from sources within the United States for items separately allocated to United States sources: gross income minus allocated deductions minus the ratable part, the remainder, if any, included in full (section 863(a))";
}
@source(IRC_S863_A, relation = formalizes, coverage = partial, quote = "The remainder, if any, shall be included in full as taxable income from sources within the United States.")
rule S863ASeparatelyAllocatedUsTaxableIncome defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for gross: Money;
    for allocated: Money;
    for ratable: Money;
    when us_source_gross_income_separately_allocated_863a(p, y, gross)
     and deductions_allocated_to_us_source_items_863a(p, y, allocated)
     and ratable_part_of_unallocable_deductions_us_863a(p, y, ratable);
    then us_source_taxable_income_863a(p, y, max(0.00 USD, gross - allocated - ratable));
}

// --- §863(b): income partly within and partly without ----------------------

pub relation item_is_services_rendered_partly_within_and_without_us(item_id: Text) kind empirical {
    label en official "the item is gain, profit or income from services rendered partly within and partly without the United States, for section 863(b)(1)";
}
pub relation item_is_inventory_produced_in_one_and_sold_in_other_863b2(item_id: Text) kind empirical {
    label en official "the item is income from the sale or exchange of inventory property (section 865(i)(1)) produced (in whole or in part) by the taxpayer within and sold without the United States, or produced without and sold within it, for section 863(b)(2)";
}
pub relation item_is_possession_purchased_inventory_sold_in_us_863b3(item_id: Text) kind empirical {
    label en official "the item is derived from the purchase of inventory property within a possession of the United States and its sale or exchange within the United States, for section 863(b)(3)";
}
pub relation partly_us_partly_foreign_source_863b(p: us.irc.core::Person, item_id: Text, amount: Money) kind institutional {
    label en official "the item is treated as derived partly from sources within and partly from sources without the United States (section 863(b))";
}
@source(IRC_S863_B, relation = formalizes, coverage = exact, quote = "shall be treated as derived partly from sources within and partly from sources without the United States.")
rule S863BServicesPartlyWithinPartlyWithout defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    for amount: Money;
    when gross_income_item_862(p, item_id, amount)
     and item_is_services_rendered_partly_within_and_without_us(item_id);
    then partly_us_partly_foreign_source_863b(p, item_id, amount);
}
@source(IRC_S863_B, relation = formalizes, coverage = exact, quote = "shall be treated as derived partly from sources within and partly from sources without the United States.")
rule S863BInventoryProducedOneSideSoldOtherSide defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    for amount: Money;
    when gross_income_item_862(p, item_id, amount)
     and item_is_inventory_produced_in_one_and_sold_in_other_863b2(item_id);
    then partly_us_partly_foreign_source_863b(p, item_id, amount);
}
@source(IRC_S863_B, relation = formalizes, coverage = exact, quote = "shall be treated as derived partly from sources within and partly from sources without the United States.")
rule S863BPossessionPurchasedInventorySoldInUs defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    for amount: Money;
    when gross_income_item_862(p, item_id, amount)
     and item_is_possession_purchased_inventory_sold_in_us_863b3(item_id);
    then partly_us_partly_foreign_source_863b(p, item_id, amount);
}

// (b)(2) last sentence: apportioned "solely on the basis of the production
// activities". The measure of production activities is left to regulations;
// the fraction of production activities located in the United States is a
// case-supplied Decimal (TECH-GAPS G1728), the statute's contribution being
// that no other factor (such as sales location) enters the split.
pub relation us_production_activity_fraction_863b2(item_id: Text, fraction: Decimal) kind empirical {
    label en official "the fraction of the production activities with respect to the inventory property that is conducted in the United States (0 to 1) — the only apportionment basis section 863(b) allows for section 863(b)(2) inventory";
}
pub relation us_source_part_of_inventory_income_863b2(p: us.irc.core::Person, item_id: Text, amount: Money) kind institutional {
    label en official "the portion of section 863(b)(2) inventory income allocated to sources within the United States, solely on the basis of production activities";
}
@source(IRC_S863_B, relation = formalizes, coverage = partial, quote = "Gains, profits, and income from the sale or exchange of inventory property described in paragraph (2) shall be allocated and apportioned between sources within and without the United States solely on the basis of the production activities with respect to the property.")
rule S863B2UsPartByProductionActivities defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    for amount: Money;
    for f: Decimal;
    when partly_us_partly_foreign_source_863b(p, item_id, amount)
     and item_is_inventory_produced_in_one_and_sold_in_other_863b2(item_id)
     and us_production_activity_fraction_863b2(item_id, f);
    then us_source_part_of_inventory_income_863b2(p, item_id, round(amount * f, 2, "HALF_UP"));
}
pub relation foreign_source_part_of_inventory_income_863b2(p: us.irc.core::Person, item_id: Text, amount: Money) kind institutional {
    label en official "the portion of section 863(b)(2) inventory income allocated to sources without the United States: the remainder after the production-activity share";
}
@source(IRC_S863_B, relation = formalizes, coverage = partial, quote = "Gains, profits, and income from the sale or exchange of inventory property described in paragraph (2) shall be allocated and apportioned between sources within and without the United States solely on the basis of the production activities with respect to the property.")
rule S863B2ForeignPartByProductionActivities defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    for amount: Money;
    for f: Decimal;
    when partly_us_partly_foreign_source_863b(p, item_id, amount)
     and item_is_inventory_produced_in_one_and_sold_in_other_863b2(item_id)
     and us_production_activity_fraction_863b2(item_id, f);
    then foreign_source_part_of_inventory_income_863b2(p, item_id, amount - round(amount * f, 2, "HALF_UP"));
}

// --- §863(c): transportation income ----------------------------------------

pub relation transportation_income_863c(p: us.irc.core::Person, item_id: Text, amount: Money) kind empirical {
    label en official "income derived from, or in connection with, the use (or hiring or leasing for use) of a vessel or aircraft, or services directly related to that use — including any container used in connection with a vessel or aircraft (section 863(c)(3))";
}
pub relation transportation_begins_and_ends_in_us(item_id: Text) kind empirical {
    label en official "the transportation to which the income is attributable begins and ends in the United States, for section 863(c)(1)";
}
pub relation transportation_begins_or_ends_in_us(item_id: Text) kind empirical {
    label en official "the transportation to which the income is attributable begins or ends in the United States, for section 863(c)(2)(A)(ii)";
}
pub relation transportation_between_us_and_possession(item_id: Text) kind empirical {
    label en official "the transportation begins in the United States and ends in a possession of the United States, or begins in a possession and ends in the United States, for section 863(c)(2)(B)(i)-(ii)";
}
pub relation transportation_income_is_personal_services_income(item_id: Text) kind empirical {
    label en official "the transportation income is income derived from personal services performed by the taxpayer, for section 863(c)(2)(B)";
}
pub relation transportation_income_relates_to_vessel(item_id: Text) kind empirical {
    label en unofficial "the transportation income is derived from, or in connection with, a vessel, for the last sentence of section 863(c)(2)(B)";
}
pub relation taxpayer_citizen_or_resident_alien_863c(p: us.irc.core::Person) kind empirical {
    label en unofficial "the taxpayer is a citizen or resident alien of the United States, for the vessel sentence of section 863(c)(2)(B)";
}

pub relation us_source_transportation_income_863c(p: us.irc.core::Person, item_id: Text, amount: Money) kind institutional {
    label en official "the portion of transportation income treated as from sources within the United States under section 863(c)";
}
pub relation section_863c2b_applies(p: us.irc.core::Person, item_id: Text) kind institutional {
    label en official "the section 863(c)(2)(B) special rule for personal services income operates: subparagraph (A) does not apply to the income unless it is attributable to transportation between the United States and a possession; for vessel-related income the special rule operates only where the taxpayer is a citizen or resident alien (literal reading of the last sentence of (B), TECH-GAPS G1729)";
}
@source(IRC_S863_C, relation = formalizes, coverage = exact, quote = "All transportation income attributable to transportation which begins and ends in the United States shall be treated as derived from sources within the United States.")
rule S863C1BeginsAndEndsInUsFullyUsSource defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    for amount: Money;
    when transportation_income_863c(p, item_id, amount)
     and transportation_begins_and_ends_in_us(item_id);
    then us_source_transportation_income_863c(p, item_id, amount);
}
@source(IRC_S863_C, relation = formalizes, coverage = partial, quote = "Subparagraph (A) shall not apply to any transportation income which is income derived from personal services performed by the taxpayer, unless such income is attributable to transportation which—")
rule S863C2BPersonalServicesSpecialRuleAppliesNonVessel defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    for amount: Money;
    when transportation_income_863c(p, item_id, amount)
     and transportation_income_is_personal_services_income(item_id);
    unless transportation_income_relates_to_vessel(item_id)
     and transportation_income_863c(p, item_id, amount);
    then section_863c2b_applies(p, item_id);
}
@source(IRC_S863_C, relation = formalizes, coverage = partial, quote = "In the case of transportation income derived from, or in connection with, a vessel, this subparagraph shall only apply if the taxpayer is a citizen or resident alien.")
rule S863C2BPersonalServicesSpecialRuleAppliesVessel defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    for amount: Money;
    when transportation_income_863c(p, item_id, amount)
     and transportation_income_is_personal_services_income(item_id)
     and transportation_income_relates_to_vessel(item_id)
     and taxpayer_citizen_or_resident_alien_863c(p);
    then section_863c2b_applies(p, item_id);
}
@source(IRC_S863_C, relation = formalizes, coverage = exact, quote = "50 percent of all transportation income attributable to transportation which—")
rule S863C2AFiftyPercentUsSource defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    for amount: Money;
    when transportation_income_863c(p, item_id, amount)
     and transportation_begins_or_ends_in_us(item_id);
    unless transportation_begins_and_ends_in_us(item_id)
     and transportation_income_863c(p, item_id, amount);
    unless section_863c2b_applies(p, item_id)
     and transportation_income_863c(p, item_id, amount)
     and not_known(transportation_between_us_and_possession(item_id));
    then us_source_transportation_income_863c(p, item_id, round(amount * 0.50, 2, "HALF_UP"));
}

// --- §863(d): space and ocean activities -----------------------------------

pub relation income_from_space_or_ocean_activity_863d(p: us.irc.core::Person, item_id: Text, amount: Money) kind empirical {
    label en official "income derived from a space or ocean activity: an activity conducted in space or in Antarctica, or on or under water not within the jurisdiction (as recognized by the United States) of a foreign country, possession or the United States — excluding transportation income, international communications income, and mineral/natural-deposit activity (section 863(d)(2))";
}
pub relation space_ocean_activity_regulation_exception_863d1(item_id: Text) kind empirical {
    label en official "regulations provide otherwise for the item (section 863(d)(1) lead-in, `except as provided in regulations`)";
}
pub relation us_source_space_ocean_income_863d(p: us.irc.core::Person, item_id: Text, amount: Money) kind institutional {
    label en official "space or ocean activity income derived by a United States person, sourced in the United States (section 863(d)(1)(A))";
}
pub relation foreign_source_space_ocean_income_863d(p: us.irc.core::Person, item_id: Text, amount: Money) kind institutional {
    label en official "space or ocean activity income derived by a person other than a United States person, sourced outside the United States (section 863(d)(1)(B))";
}
@source(IRC_S863_D, relation = formalizes, coverage = exact, quote = "(A) if derived by a United States person, shall be sourced in the United States, and")
rule S863D1AUsPersonSpaceOceanIncomeUsSource defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    for amount: Money;
    when income_from_space_or_ocean_activity_863d(p, item_id, amount)
     and us.irc.definitions::united_states_person(p);
    unless space_ocean_activity_regulation_exception_863d1(item_id)
     and income_from_space_or_ocean_activity_863d(p, item_id, amount);
    then us_source_space_ocean_income_863d(p, item_id, amount);
}
@source(IRC_S863_D, relation = formalizes, coverage = exact, quote = "(B) if derived by a person other than a United States person, shall be sourced outside the United States.")
rule S863D1BForeignPersonSpaceOceanIncomeForeignSource defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    for amount: Money;
    when income_from_space_or_ocean_activity_863d(p, item_id, amount)
     and not_known(us.irc.definitions::united_states_person(p));
    unless space_ocean_activity_regulation_exception_863d1(item_id)
     and income_from_space_or_ocean_activity_863d(p, item_id, amount);
    then foreign_source_space_ocean_income_863d(p, item_id, amount);
}

// --- §863(e): international communications income --------------------------

pub relation international_communications_income_863e(p: us.irc.core::Person, item_id: Text, amount: Money) kind empirical {
    label en official "income derived from the transmission of communications or data from the United States to any foreign country (or possession) or from any foreign country (or possession) to the United States (section 863(e)(2))";
}
pub relation icc_income_attributable_to_us_office_863e(item_id: Text) kind empirical {
    label en official "the international communications income is attributable to an office or other fixed place of business in the United States maintained by the (foreign) person, for section 863(e)(1)(B)(ii)";
}
pub relation icc_regulation_exception_863e(item_id: Text) kind empirical {
    label en official "regulations provide otherwise for the item (section 863(e)(1)(B)(i) `except as provided in regulations`)";
}
pub relation us_source_icc_income_863e(p: us.irc.core::Person, item_id: Text, amount: Money) kind institutional {
    label en official "the portion of international communications income sourced in the United States (section 863(e)(1))";
}
pub relation foreign_source_icc_income_863e(p: us.irc.core::Person, item_id: Text, amount: Money) kind institutional {
    label en official "the portion of international communications income sourced outside the United States (section 863(e)(1))";
}
@source(IRC_S863_E, relation = formalizes, coverage = exact, quote = "In the case of any United States person, 50 percent of any international communications income shall be sourced in the United States and 50 percent of such income shall be sourced outside the United States.")
rule S863E1AUsPersonUsPart defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    for amount: Money;
    when international_communications_income_863e(p, item_id, amount)
     and us.irc.definitions::united_states_person(p);
    then us_source_icc_income_863e(p, item_id, round(amount * 0.50, 2, "HALF_UP"));
}
@source(IRC_S863_E, relation = formalizes, coverage = exact, quote = "In the case of any United States person, 50 percent of any international communications income shall be sourced in the United States and 50 percent of such income shall be sourced outside the United States.")
rule S863E1AUsPersonForeignPart defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    for amount: Money;
    when international_communications_income_863e(p, item_id, amount)
     and us.irc.definitions::united_states_person(p);
    then foreign_source_icc_income_863e(p, item_id, amount - round(amount * 0.50, 2, "HALF_UP"));
}
@source(IRC_S863_E, relation = formalizes, coverage = partial, quote = "Except as provided in regulations or clause (ii), in the case of any person other than a United States person, any international communications income shall be sourced outside the United States.")
rule S863E1BiForeignPersonForeignSource defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    for amount: Money;
    when international_communications_income_863e(p, item_id, amount)
     and not_known(us.irc.definitions::united_states_person(p));
    unless icc_income_attributable_to_us_office_863e(item_id)
     and international_communications_income_863e(p, item_id, amount);
    unless icc_regulation_exception_863e(item_id)
     and international_communications_income_863e(p, item_id, amount);
    then foreign_source_icc_income_863e(p, item_id, amount);
}
@source(IRC_S863_E, relation = formalizes, coverage = exact, quote = "In the case of any person (other than a United States person) who maintains an office or other fixed place of business in the United States, any international communications income attributable to such office or other fixed place of business shall be sourced in the United States.")
rule S863E1BiiForeignPersonUsOfficeUsSource defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    for amount: Money;
    when international_communications_income_863e(p, item_id, amount)
     and not_known(us.irc.definitions::united_states_person(p))
     and icc_income_attributable_to_us_office_863e(item_id);
    then us_source_icc_income_863e(p, item_id, amount);
}
