// §957(a) — controlled foreign corporation definition; §958(a) — direct and
// indirect stock ownership (proportionate look-through of foreign entities).
// Stage 1 (IRC-10 stage 1, A13). §957(b)-(c), §958(b) (constructive
// ownership via section 318(a), imported from `us.irc.corporations`) are
// NOT modeled this stage (stage 2) beyond the reference noted below.
// §951(a) (subpart F inclusion), §951A (GILTI), §954(b)-(c) (FBC income
// tests) are NOT modeled this stage: TECH_GAP, see HANDOFF.md — the pro
// rata/day-counted inclusion and the GILTI/high-tax/de-minimis computations
// were judged too deep to model correctly in the time remaining for this
// stage and are left `unreviewed` rather than modeled half-right.

use self::{
    IRC_S957_A,
    IRC_S958_A,
};

pub relation united_states_shareholder_vote_or_value_owned(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, day: Date, vote_share: Decimal, value_share: Decimal) kind empirical {
    label en unofficial "on this day of the foreign corporation's taxable year, this United States shareholder owns (within the meaning of section 958(a), or is considered as owning under section 958(b)) this share of voting power and this share of value — the per-day, per-shareholder input section 957(a) aggregates over";
}
pub relation us_shareholder_status(shareholder: us.irc.core::Person) kind empirical {
    label en unofficial "the person is a United States shareholder within the meaning of section 951(b) (10% vote-or-value threshold, not itself modeled this stage — TECH_GAP; asserted directly as a case fact)";
}
pub relation aggregate_us_shareholder_vote_share_on_day(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, day: Date, total_vote_share: Decimal) kind empirical {
    label en official "the SUM, over all United States shareholders, of voting power owned or considered owned in the foreign corporation on this day — an aggregate input asserted directly by the case, because a `sum all ... where` over an empirical relation is a compiler trap this stage avoids (AGENT-BRIEF.md compiler traps) rather than deriving the sum with a rule";
}
pub relation aggregate_us_shareholder_value_share_on_day(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, day: Date, total_value_share: Decimal) kind empirical {
    label en official "the SUM, over all United States shareholders, of stock value owned or considered owned in the foreign corporation on this day — see the note on `aggregate_us_shareholder_vote_share_on_day`";
}
pub relation foreign_corporation_957(corp: us.irc.core::Corporation) kind empirical {
    label en unofficial "the corporation is a foreign corporation, for section 957(a)";
}

@source(IRC_S957_A, relation = formalizes, coverage = exact, quote = "the term \"controlled foreign corporation\" means any foreign corporation if more than 50 percent of—")
pub relation controlled_foreign_corporation(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the foreign corporation is a controlled foreign corporation for the taxable year: on some day during that year, United States shareholders own or are considered as owning (sections 958(a)/(b)) more than 50 percent of its voting power or more than 50 percent of the value of its stock (section 957(a))";
}
rule S957AControlledForeignCorporationByVote defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for day: Date;
    for total_vote_share: Decimal;
    when foreign_corporation_957(corp)
     and aggregate_us_shareholder_vote_share_on_day(corp, y, day, total_vote_share)
     and total_vote_share > 0.50;
    then controlled_foreign_corporation(corp, y);
}
rule S957AControlledForeignCorporationByValue defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for day: Date;
    for total_value_share: Decimal;
    when foreign_corporation_957(corp)
     and aggregate_us_shareholder_value_share_on_day(corp, y, day, total_value_share)
     and total_value_share > 0.50;
    then controlled_foreign_corporation(corp, y);
}
// boundary scenario named by the owner's task: exactly 50% is NOT a CFC
// ("more than 50 percent" is a strict inequality); 50.1% is. No separate
// rule is needed for the non-CFC boundary — the defeasible rules above
// simply do not fire at `total_vote_share == 0.50`, and their absence is
// the correct NEITHER/UNDETERMINED (not a false negative), per
// AGENT-BRIEF.md's "unknown is not negative" for the case where no other
// evidence establishes CFC status either.

// --- §958(a): direct and indirect ownership --------------------------------

pub relation stock_owned_directly(holder: us.irc.core::Person, corp: us.irc.core::Corporation, vote_share: Decimal, value_share: Decimal) kind empirical {
    label en official "stock owned directly by the holder in the corporation, for section 958(a)(1)(A)";
}
pub relation foreign_entity_holds_stock(holder_entity: us.irc.core::Person, corp: us.irc.core::Corporation, vote_share: Decimal, value_share: Decimal) kind empirical {
    label en official "a foreign corporation, foreign partnership, foreign trust, or foreign estate (section 7701(a)(31)) holds this stock, directly or indirectly, in the target corporation — for the section 958(a)(2) proportionate look-through";
}
pub relation proportionate_interest_in_foreign_entity(holder: us.irc.core::Person, holder_entity: us.irc.core::Person, proportion: Decimal) kind empirical {
    label en unofficial "the holder's proportionate interest (as shareholder, partner, or beneficiary) in the foreign entity, for the section 958(a)(2) look-through multiplier";
}

pub relation stock_owned_under_958a(holder: us.irc.core::Person, corp: us.irc.core::Corporation, vote_share: Decimal, value_share: Decimal) kind institutional {
    label en official "stock owned within the meaning of section 958(a): owned directly (958(a)(1)(A)), or owned indirectly through a foreign corporation/partnership/trust/estate and considered as owned proportionately by the holder (958(a)(1)(B), (a)(2))";
}
@source(IRC_S958_A, relation = formalizes, coverage = exact, quote = "stock owned means—")
rule S958A1ADirectOwnership strict {
    for holder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for vote_share: Decimal;
    for value_share: Decimal;
    when stock_owned_directly(holder, corp, vote_share, value_share);
    then stock_owned_under_958a(holder, corp, vote_share, value_share);
}
@source(IRC_S958_A, relation = formalizes, coverage = exact, quote = "stock owned, directly or indirectly, by or for a foreign corporation, foreign partnership, or foreign trust or foreign estate (within the meaning of section 7701(a)(31)) shall be considered as being owned proportionately by its shareholders, partners, or beneficiaries.")
rule S958A2ProportionateLookThrough defeasible {
    for holder: us.irc.core::Person;
    for holder_entity: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for entity_vote: Decimal;
    for entity_value: Decimal;
    for proportion: Decimal;
    when foreign_entity_holds_stock(holder_entity, corp, entity_vote, entity_value)
     and proportionate_interest_in_foreign_entity(holder, holder_entity, proportion);
    then stock_owned_under_958a(holder, corp, entity_vote * proportion, entity_value * proportion);
}
// §958(b) constructive ownership (section 318(a) modified attribution) is a
// TYPED DEPENDENCY on `us.irc.corporations::constructive_ownership`
// (already `pub`), not re-derived here: the section 958(b) modifications to
// section 318(a) (dropping the 50%-limitation of (a)(2)(C)/(a)(3)(C) for
// this purpose, etc.) are NOT modeled this stage — a consumer that needs
// "owned or considered as owned" under 957(a)/958(b) combined must supply
// that combination as a case fact until this gap closes (TECH_GAP, see
// TECH-GAPS.md G9x; also inherits the corporations package's own G37/G61/G63
// bounded-hop limitation on attribution chains, per HANDOFF.md).
