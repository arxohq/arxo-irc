// 26 U.S.C. Subchapter N, Part VII of Subchapter A of Chapter 1 and Chapters 3, 4 — International: package skeleton. The text is pinned whole
// (`sources.law`, generated by
// `corpus/tools/sources/sync/sync_us_irc_fragments.py --package international` from
// the shared Title 26 snapshot, docs/foundations/us-irc/SOURCE-MANIFEST.json).
// Formalization modules are added stage by stage; see
// docs/foundations/us-irc/TASKS.json and DECISION-0379.

language "law.core" version "0.2";
package us.irc.international version "0.1.1";
namespace "urn:us:irc:international:clir";

import us.irc.core version "0.1.1";
import us.irc.definitions version "0.1.1";
import us.irc.corporations version "0.1.1";
import us.irc.income_individual version "0.1.1";
import us.irc.temporal version "0.1.1";
import us.irc.inflation_adjustments version "0.1.1";
import us.irs.rev_rul_afr version "0.1.1";

const Secretary: us.irc.core::Organ = us.irc.core::Secretary;
const IRS: us.irc.core::Organ = us.irc.core::IRS;
// The President, named by section 901(c) (proclamation, findings) and
// 901(j)(5) (waiver); core declares no President organ (TECH-GAPS G1737).
// The government of the Virgin Islands, to which section 934(a) addresses its
// limitation (no reduction or remission of liability by Virgin Islands law).
const VirginIslandsGovernment: us.irc.core::Organ = entity_ref("urn:us:irc:international#virgin-islands-government") {
    label en unofficial "the government (legislature) of the Virgin Islands, for the limitation of section 934(a)";
}
const President: us.irc.core::Organ = entity_ref("urn:us:irc:international#president") {
    label en unofficial "the President of the United States, for the findings, proclamations and waivers the Code commits to the President";
}

