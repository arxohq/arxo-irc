// PFIC remainder: §1291(a)(3),(b),(d)-(g); §1293; §1294; §1296(e)-(l);
// §1297(d)-(f); §1298. Stage 2c (IRC-10 stage 2c, A13). Modules 08 and 12 carry
// §1297(a)-(c), §1295, §1296(a)-(d) and §1291(a),(c).
//
// Conventions: the multi-year holding-period history of a share (each
// taxable year of the company's PFIC status and QEF election) is a
// year-by-year property of the taxpayer's whole holding period; the module
// reads its aggregate facts (`qef_for_every_pfic_year_of_holding_period`) as
// case inputs rather than chaining a per-year ledger (TECH-GAPS G1754, same
// class as the section 39 and section 904(c) chains).

// --- §1291(a)(3): holding period, current year -------------------------------

use self::{
    IRC_S1291_A,
    IRC_S1291_B,
    IRC_S1291_D,
    IRC_S1291_E,
    IRC_S1291_F,
    IRC_S1291_G,
    IRC_S1293_A,
    IRC_S1293_C,
    IRC_S1293_D,
    IRC_S1293_E,
    IRC_S1293_G,
    IRC_S1294_A,
    IRC_S1294_B,
    IRC_S1294_C,
    IRC_S1294_D,
    IRC_S1294_F,
    IRC_S1296_E,
    IRC_S1296_F,
    IRC_S1296_J,
    IRC_S1296_K,
    IRC_S1297_D,
    IRC_S1297_E,
    IRC_S1297_F,
    IRC_S1298_A,
    IRC_S1298_B,
    IRC_S1298_D,
    IRC_S1298_E,
    IRC_S1298_F,
    Secretary,
    foreign_corporation_1297,
};

pub relation holding_period_begin_pfic_share_1291a3(p: us.irc.core::Person, share_id: Text, begins_on: Date) kind empirical {
    label en official "the first day of the taxpayer's holding period in the share, determined under section 1223";
}
pub relation section_1296_applied_to_share_prior_year_ended_on_1291a3aii(p: us.irc.core::Person, share_id: Text, last_year_ended_on: Date) kind empirical {
    label en official "section 1296 applied to the stock for a prior taxable year of the taxpayer, the last such year ending on this date";
}
pub relation excess_distribution_or_disposition_on_1291a3(p: us.irc.core::Person, share_id: Text, on: Date) kind empirical {
    label en official "an excess distribution is received or a disposition occurs on this date";
}
pub relation holding_period_for_1291_1291a3a(p: us.irc.core::Person, share_id: Text, begins: Date, ends: Date) kind institutional {
    label en official "the holding period for section 1291: determined under section 1223, treated as ending on the date of the distribution (for an excess distribution), and, if section 1296 applied to the stock for a prior year, as beginning on the first day of the first taxable year beginning after the last such year (section 1291(a)(3)(A))";
}
@source(IRC_S1291_A, relation = formalizes, coverage = partial, quote = "(i) for purposes of applying this section to an excess distribution, such holding period shall be treated as ending on the date of such distribution, and")
rule S1291A3AHoldingPeriodNoMarkToMarket defeasible {
    for p: us.irc.core::Person;
    for share_id: Text;
    for begins: Date;
    for on: Date;
    when holding_period_begin_pfic_share_1291a3(p, share_id, begins)
     and excess_distribution_or_disposition_on_1291a3(p, share_id, on);
    unless section_1296_applied_to_share_prior_year_ended_on_1291a3aii(p, share_id, _)
     and holding_period_begin_pfic_share_1291a3(p, share_id, begins)
     and excess_distribution_or_disposition_on_1291a3(p, share_id, on);
    then holding_period_for_1291_1291a3a(p, share_id, begins, on);
}
@source(IRC_S1291_A, relation = formalizes, coverage = partial, quote = "(ii) if section 1296 applied to such stock with respect to the taxpayer for any prior taxable year, such holding period shall be treated as beginning on the first day of the first taxable year beginning after the last taxable year for which section 1296 so applied.")
rule S1291A3AiiHoldingPeriodAfterMarkToMarket defeasible {
    for p: us.irc.core::Person;
    for share_id: Text;
    for begins: Date;
    for on: Date;
    for last_ended: Date;
    when holding_period_begin_pfic_share_1291a3(p, share_id, begins)
     and excess_distribution_or_disposition_on_1291a3(p, share_id, on)
     and section_1296_applied_to_share_prior_year_ended_on_1291a3aii(p, share_id, last_ended);
    then holding_period_for_1291_1291a3a(p, share_id, add_calendar_period(last_ended, 1 calendar_day), on);
}

// --- §1291(b): excess distribution ------------------------------------------

pub relation total_excess_distribution_for_year_1291b2(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the total excess distribution for the taxable year (module 12 `total_excess_distribution`: distributions over 125 percent of the 3-year average)";
}
pub relation distribution_received_in_year_1291b1(p: us.irc.core::Person, y: us.irc.core::TaxableYear, dist_id: Text, amount: Money) kind empirical {
    label en official "a distribution in respect of stock received during the taxable year";
}
pub relation total_distributions_in_year_1291b1(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the amount of the distributions in respect of the stock received by the taxpayer during the year";
}
pub relation excess_distribution_1291b1(p: us.irc.core::Person, y: us.irc.core::TaxableYear, dist_id: Text, amount: Money) kind institutional {
    label en official "an excess distribution: a distribution received during the year to the extent it does not exceed its ratable portion of the total excess distribution for the year (section 1291(b)(1))";
}
@source(IRC_S1291_B, relation = formalizes, coverage = exact, quote = "For purposes of this section, the term \"excess distribution\" means any distribution in respect of stock received during any taxable year to the extent such distribution does not exceed its ratable portion of the total excess distribution (if any) for such taxable year.")
rule S1291B1ExcessDistribution defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for dist_id: Text;
    for amount: Money;
    for total_dist: Money;
    for total_excess: Money;
    when distribution_received_in_year_1291b1(p, y, dist_id, amount)
     and total_distributions_in_year_1291b1(p, y, total_dist)
     and total_excess_distribution_for_year_1291b2(p, y, total_excess)
     and total_dist > 0.00 USD
     and total_excess > 0.00 USD;
    then excess_distribution_1291b1(p, y, dist_id, min(amount, round(total_excess * (amount / total_dist), 2, "HALF_UP")));
}
pub relation first_year_of_holding_period_1291b2b(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the taxable year in which the taxpayer's holding period in the stock begins";
}
pub relation total_excess_distribution_zero_first_year_1291b2b(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the total excess distribution with respect to any stock is zero for the taxable year in which the holding period begins (section 1291(b)(2)(B))";
}
@source(IRC_S1291_B, relation = formalizes, coverage = exact, quote = "The total excess distributions with respect to any stock shall be zero for the taxable year in which the taxpayer's holding period in such stock begins.")
rule S1291B2BFirstYearZero defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when first_year_of_holding_period_1291b2b(p, y);
    then total_excess_distribution_zero_first_year_1291b2b(p, y, 0.00 USD);
}

// --- §1291(d): exceptions and elections --------------------------------------

pub relation qef_for_every_pfic_year_of_holding_period(p: us.irc.core::Person, share_id: Text) kind empirical {
    label en official "the company is a qualified electing fund with respect to the taxpayer for each of its taxable years that begins after December 31, 1986, in which it is a PFIC, and that includes any portion of the holding period (section 1291(d)(1)(A)-(B)); the year-by-year check is asserted (TECH-GAPS G1754)";
}
pub relation section_1296k_election_in_effect_for_year(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "an election under section 1296(k) is in effect for the taxpayer's taxable year";
}
pub relation stock_marked_to_market_under_475_or_other_provision(p: us.irc.core::Person, share_id: Text) kind empirical {
    label en official "the stock is marked to market under section 475 or another provision of this chapter";
}
pub relation section_1291_applies_to_distribution_or_disposition(p: us.irc.core::Person, share_id: Text, y: us.irc.core::TaxableYear) kind institutional {
    label en official "section 1291 applies to a distribution or disposition of the PFIC stock: not for a qualified electing fund for every relevant year, not when a section 1296(k) election is in effect, and not for stock marked to market (section 1291(d)(1))";
}
pub relation pfic_distribution_or_disposition_1291d(p: us.irc.core::Person, share_id: Text, y: us.irc.core::TaxableYear) kind empirical {
    label en official "a distribution paid by a passive foreign investment company, or a disposition of stock in it, in the taxable year";
}
@source(IRC_S1291_D, relation = formalizes, coverage = exact, quote = "This section shall not apply with respect to any distribution paid by a passive foreign investment company, or any disposition of stock in a passive foreign investment company, if such company is a qualified electing fund with respect to the taxpayer for each of its taxable years—")
rule S1291D1SectionAppliesUnlessException defeasible {
    for p: us.irc.core::Person;
    for share_id: Text;
    for y: us.irc.core::TaxableYear;
    when pfic_distribution_or_disposition_1291d(p, share_id, y);
    unless qef_for_every_pfic_year_of_holding_period(p, share_id)
     and pfic_distribution_or_disposition_1291d(p, share_id, y);
    unless section_1296k_election_in_effect_for_year(p, y)
     and pfic_distribution_or_disposition_1291d(p, share_id, y);
    unless stock_marked_to_market_under_475_or_other_provision(p, share_id)
     and pfic_distribution_or_disposition_1291d(p, share_id, y);
    then section_1291_applies_to_distribution_or_disposition(p, share_id, y);
}
pub relation elects_deemed_sale_on_becoming_qef_1291d2A(p: us.irc.core::Person, share_id: Text) kind empirical {
    label en official "the taxpayer elects to recognize gain as if the stock were sold on the first day of the first QEF year for its fair market value";
}
pub relation pfic_becomes_qef_holds_stock_first_day_1291d2A(p: us.irc.core::Person, share_id: Text) kind empirical {
    label en official "a PFIC becomes a QEF with respect to the taxpayer for a taxable year beginning after December 31, 1986, and the taxpayer holds stock on the first day of that year";
}
pub relation taxpayer_establishes_fmv_on_first_day_1291d2A(p: us.irc.core::Person, share_id: Text) kind empirical {
    label en official "the taxpayer establishes to the satisfaction of the Secretary the fair market value of the stock on the first day";
}
pub relation stock_fair_market_value_first_day_1291d2A(p: us.irc.core::Person, share_id: Text, fmv: Money) kind empirical {
    label en official "the fair market value of the stock on the first day of the QEF year";
}
pub relation stock_adjusted_basis_first_day_1291d2A(p: us.irc.core::Person, share_id: Text, basis: Money) kind empirical {
    label en official "the adjusted basis of the stock on that day";
}
pub relation deemed_sale_election_effective_1291d2A(p: us.irc.core::Person, share_id: Text) kind institutional {
    label en official "the section 1291(d)(2)(A) election to recognize gain on the first day is in effect";
}
@source(IRC_S1291_D, relation = formalizes, coverage = exact, quote = "the taxpayer may elect to recognize gain as if he sold such stock on such first day for such fair market value.")
rule S1291D2AElectionPower strict {
    for p: us.irc.core::Person;
    for share_id: Text;
    when elects_deemed_sale_on_becoming_qef_1291d2A(p, share_id);
    then power S1291D2ADeemedSaleElection {
        holder p;
        over p;
        exercise elects_deemed_sale_on_becoming_qef_1291d2A(p, share_id);
        valid_when taxpayer_establishes_fmv_on_first_day_1291d2A(p, share_id);
        effect create(deemed_sale_election_effective_1291d2A(p, share_id));
    };
}
pub relation deemed_sale_gain_1291d2A(p: us.irc.core::Person, share_id: Text, gain: Money) kind institutional {
    label en official "the gain recognized on the deemed sale on the first day: fair market value over adjusted basis";
}
rule S1291D2ADeemedSaleGain defeasible {
    for p: us.irc.core::Person;
    for share_id: Text;
    for fmv: Money;
    for basis: Money;
    when deemed_sale_election_effective_1291d2A(p, share_id)
     and stock_fair_market_value_first_day_1291d2A(p, share_id, fmv)
     and stock_adjusted_basis_first_day_1291d2A(p, share_id, basis)
     and fmv > basis;
    then deemed_sale_gain_1291d2A(p, share_id, fmv - basis);
}
pub relation basis_after_deemed_sale_1291d2C(p: us.irc.core::Person, share_id: Text, basis: Money) kind institutional {
    label en official "the adjusted basis increased by the gain recognized under the deemed sale election (section 1291(d)(2)(C)(i))";
}
rule S1291D2CBasisIncreasedByGain defeasible {
    for p: us.irc.core::Person;
    for share_id: Text;
    for gain: Money;
    for basis: Money;
    when deemed_sale_gain_1291d2A(p, share_id, gain)
     and stock_adjusted_basis_first_day_1291d2A(p, share_id, basis);
    then basis_after_deemed_sale_1291d2C(p, share_id, basis + gain);
}
pub relation elects_cfc_dividend_election_1291d2B(p: us.irc.core::Person, share_id: Text) kind empirical {
    label en official "the taxpayer elects to include as a dividend on the first QEF day the post-1986 earnings and profits attributable to the stock (the company being a controlled foreign corporation)";
}
pub relation post_1986_earnings_and_profits_attributable_1291d2Bii(p: us.irc.core::Person, share_id: Text, amount: Money) kind empirical {
    label en official "the post-1986 earnings and profits accumulated in taxable years beginning after December 31, 1986, during the periods the stock was held by the taxpayer while the company was a PFIC, attributable to the stock (under regulations)";
}
pub relation pfic_is_cfc_on_first_day_1291d2Biii(p: us.irc.core::Person, share_id: Text) kind empirical {
    label en official "the passive foreign investment company is a controlled foreign corporation (section 957(a))";
}
pub relation cfc_dividend_election_effective_1291d2B(p: us.irc.core::Person, share_id: Text) kind institutional {
    label en official "the section 1291(d)(2)(B) dividend election is in effect";
}
@source(IRC_S1291_D, relation = formalizes, coverage = exact, quote = "the taxpayer may elect to include in gross income as a dividend received on such first day an amount equal to the portion of the post-1986 earnings and profits of such company attributable (under regulations prescribed by the Secretary) to the stock in such company held by the taxpayer on such first day.")
rule S1291D2BDividendElectionPower strict {
    for p: us.irc.core::Person;
    for share_id: Text;
    when elects_cfc_dividend_election_1291d2B(p, share_id);
    then power S1291D2BDividendElection {
        holder p;
        over p;
        exercise elects_cfc_dividend_election_1291d2B(p, share_id);
        valid_when pfic_is_cfc_on_first_day_1291d2Biii(p, share_id);
        effect create(cfc_dividend_election_effective_1291d2B(p, share_id));
    };
}
pub relation deemed_dividend_1291d2B(p: us.irc.core::Person, share_id: Text, amount: Money) kind institutional {
    label en official "the amount treated as a dividend on the first day, treated as an excess distribution";
}
rule S1291D2BDeemedDividendAmount defeasible {
    for p: us.irc.core::Person;
    for share_id: Text;
    for amount: Money;
    when cfc_dividend_election_effective_1291d2B(p, share_id)
     and post_1986_earnings_and_profits_attributable_1291d2Bii(p, share_id, amount);
    then deemed_dividend_1291d2B(p, share_id, amount);
}
pub relation basis_after_dividend_election_1291d2C(p: us.irc.core::Person, share_id: Text, basis: Money) kind institutional {
    label en official "the adjusted basis increased by the amount treated as a dividend (section 1291(d)(2)(C)(i))";
}
rule S1291D2CBasisIncreasedByDividend defeasible {
    for p: us.irc.core::Person;
    for share_id: Text;
    for amount: Money;
    for basis: Money;
    when deemed_dividend_1291d2B(p, share_id, amount)
     and stock_adjusted_basis_first_day_1291d2A(p, share_id, basis);
    then basis_after_dividend_election_1291d2C(p, share_id, basis + amount);
}

// --- §1291(e): basis at death -------------------------------------------------

pub relation basis_1014_and_adjusted_basis_before_death_1291e(p: us.irc.core::Person, share_id: Text, basis_1014: Money, adjusted_basis: Money) kind empirical {
    label en official "the basis determined under section 1014 and the adjusted basis of the stock immediately before the decedent's death";
}
pub relation decedent_nonresident_alien_throughout_holding_1291e2(p: us.irc.core::Person, share_id: Text) kind empirical {
    label en official "the decedent was a nonresident alien at all times during the holding period in the stock";
}
pub relation basis_reduction_at_death_1291e(p: us.irc.core::Person, share_id: Text, amount: Money) kind institutional {
    label en official "the reduction of the section 1014 basis: the excess of the section 1014 basis over the adjusted basis immediately before death, not for a decedent who was a nonresident alien throughout the holding period (section 1291(e)(1)-(2), rules similar to section 1246(e))";
}
@source(IRC_S1291_E, relation = formalizes, coverage = partial, quote = "(1) the reduction under subsection (e) of such section shall be the excess of the basis determined under section 1014 over the adjusted basis of the stock immediately before the decedent's death, and")
rule S1291E1BasisReduction defeasible {
    for p: us.irc.core::Person;
    for share_id: Text;
    for basis_1014: Money;
    for adjusted: Money;
    when basis_1014_and_adjusted_basis_before_death_1291e(p, share_id, basis_1014, adjusted)
     and basis_1014 > adjusted;
    unless decedent_nonresident_alien_throughout_holding_1291e2(p, share_id)
     and basis_1014_and_adjusted_basis_before_death_1291e(p, share_id, basis_1014, adjusted);
    then basis_reduction_at_death_1291e(p, share_id, basis_1014 - adjusted);
}

// --- §1291(f): transfers with non-recognition (regulations) -------------------

pub relation transfer_without_full_recognition_1291f(p: us.irc.core::Person, share_id: Text, fmv: Money, adjusted_basis: Money) kind empirical {
    label en official "a transfer of stock in a PFIC where there is not full recognition of gain, to the extent provided in regulations";
}
pub relation regulations_provide_recognition_1291f(share_id: Text) kind empirical {
    label en official "regulations provide for recognition of the gain on this kind of transfer";
}
pub relation gain_recognized_on_transfer_1291f(p: us.irc.core::Person, share_id: Text, gain: Money) kind institutional {
    label en official "the excess of fair market value over adjusted basis treated as gain from the sale of the stock and recognized notwithstanding any other provision (section 1291(f)), to the extent provided in regulations";
}
@source(IRC_S1291_F, relation = formalizes, coverage = partial, quote = "shall be treated as gain from the sale or exchange of such stock and shall be recognized notwithstanding any provision of law.")
rule S1291FGainOnTransfer defeasible {
    for p: us.irc.core::Person;
    for share_id: Text;
    for fmv: Money;
    for basis: Money;
    when transfer_without_full_recognition_1291f(p, share_id, fmv, basis)
     and regulations_provide_recognition_1291f(share_id)
     and fmv > basis;
    then gain_recognized_on_transfer_1291f(p, share_id, fmv - basis);
}

// --- §1291(g): creditable foreign taxes ---------------------------------------

pub relation withholding_tax_on_distribution_1291g2A(p: us.irc.core::Person, dist_id: Text, tax: Money) kind empirical {
    label en official "withholding tax imposed with respect to the distribution, creditable under section 901 if the taxpayer chooses its benefits (creditable foreign taxes)";
}
pub relation distribution_amount_and_excess_portion_1291g2B(p: us.irc.core::Person, dist_id: Text, distribution: Money, excess_part: Money) kind empirical {
    label en official "the amount of the distribution and the portion of it that is an excess distribution";
}
pub relation excess_distribution_taxes_1291g2B(p: us.irc.core::Person, dist_id: Text, amount: Money) kind institutional {
    label en official "the excess distribution taxes: the portion of the creditable foreign taxes attributable, pro rata, to the portion of the distribution that is an excess distribution (section 1291(g)(2)(B))";
}
@source(IRC_S1291_G, relation = formalizes, coverage = exact, quote = "The term \"excess distribution taxes\" means, with respect to any distribution, the portion of the creditable foreign taxes with respect to such distribution which is attributable (on a pro rata basis) to the portion of such distribution which is an excess distribution.")
rule S1291G2BExcessDistributionTaxes defeasible {
    for p: us.irc.core::Person;
    for dist_id: Text;
    for tax: Money;
    for distribution: Money;
    for excess_part: Money;
    when withholding_tax_on_distribution_1291g2A(p, dist_id, tax)
     and distribution_amount_and_excess_portion_1291g2B(p, dist_id, distribution, excess_part)
     and distribution > 0.00 USD;
    then excess_distribution_taxes_1291g2B(p, dist_id, round(tax * (excess_part / distribution), 2, "HALF_UP"));
}
pub relation holding_period_days_1291g1B(p: us.irc.core::Person, dist_id: Text, days_total: Integer, days_in_pre_pfic_years: Integer) kind empirical {
    label en official "the number of days in the taxpayer's holding period, and the number falling in taxable years referred to in section 1291(a)(1)(B) (the current year and pre-1987 years)";
}
pub relation excess_distribution_taxes_taken_into_account_under_901_1291g1Ci(p: us.irc.core::Person, dist_id: Text, amount: Money) kind institutional {
    label en official "the excess distribution taxes allocated ratably to each day of the holding period, to the extent allocated to a section 1291(a)(1)(B) year, are taken into account under section 901 for the current year (section 1291(g)(1)(B), (C)(i))";
}
@source(IRC_S1291_G, relation = formalizes, coverage = exact, quote = "(B) the excess distribution taxes shall be allocated ratably to each day in the taxpayer's holding period for the stock, and")
rule S1291G1CiTaxesInCurrentYearCreditable defeasible {
    for p: us.irc.core::Person;
    for dist_id: Text;
    for taxes: Money;
    for total_days: Integer;
    for pre_days: Integer;
    when excess_distribution_taxes_1291g2B(p, dist_id, taxes)
     and holding_period_days_1291g1B(p, dist_id, total_days, pre_days)
     and total_days > 0;
    then excess_distribution_taxes_taken_into_account_under_901_1291g1Ci(p, dist_id, round(taxes * (pre_days / total_days), 2, "HALF_UP"));
}

// --- §1293: current taxation of income from qualified funds -------------------

pub relation qef_earnings_and_profits_1293e(fund: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the earnings and profits of the qualified electing fund for the year, determined without regard to section 312(n)(4)-(6)";
}
pub relation qef_net_capital_gain_1293e2(fund: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the qualified electing fund's net capital gain for the year (before the cap at earnings and profits)";
}
pub relation qef_net_capital_gain_capped_1293e2(fund: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the net capital gain of a qualified electing fund for any taxable year does not exceed its earnings and profits for the year (section 1293(e)(2))";
}
@source(IRC_S1293_E, relation = formalizes, coverage = exact, quote = "A qualified electing fund's net capital gain for any taxable year shall not exceed its earnings and profits for such taxable year.")
rule S1293E2NetCapitalGainCapped defeasible {
    for fund: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for ep: Money;
    for gain: Money;
    when qef_earnings_and_profits_1293e(fund, y, ep)
     and qef_net_capital_gain_1293e2(fund, y, gain);
    then qef_net_capital_gain_capped_1293e2(fund, y, min(ep, gain));
}
pub relation qef_ordinary_earnings_1293e1(fund: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "ordinary earnings: the excess of the earnings and profits over the net capital gain (section 1293(e)(1)), floored at zero";
}
@source(IRC_S1293_E, relation = formalizes, coverage = exact, quote = "The term \"ordinary earnings\" means the excess of the earnings and profits of the qualified electing fund for the taxable year over its net capital gain for such taxable year.")
rule S1293E1OrdinaryEarnings defeasible {
    for fund: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for ep: Money;
    for gain: Money;
    when qef_earnings_and_profits_1293e(fund, y, ep)
     and qef_net_capital_gain_capped_1293e2(fund, y, gain);
    then qef_ordinary_earnings_1293e1(fund, y, max(0.00 USD, ep - gain));
}
pub relation shareholder_pro_rata_fraction_1293b(shareholder: us.irc.core::Person, fund: us.irc.core::Corporation, y: us.irc.core::TaxableYear, fraction: Decimal) kind empirical {
    label en official "the shareholder's pro rata fraction: the daily ratable share of the fund's ordinary earnings and net capital gain, summed over the days of the fund's year, as if distributed each day to each shareholder (section 1293(b)); asserted as one Decimal";
}
pub relation shareholder_owns_or_treated_as_owning_qef_stock_1293a(shareholder: us.irc.core::Person, fund: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "a United States person who owns (or is treated under section 1298(a) as owning) stock of a qualified electing fund at any time during the fund's taxable year";
}
pub relation qef_ordinary_income_inclusion_1293a1A(shareholder: us.irc.core::Person, fund: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the amount included in gross income as ordinary income: the shareholder's pro rata share of the ordinary earnings of the fund for the year (section 1293(a)(1)(A))";
}
@source(IRC_S1293_A, relation = formalizes, coverage = exact, quote = "(A) as ordinary income, such shareholder's pro rata share of the ordinary earnings of such fund for such year, and")
rule S1293A1AOrdinaryInclusion defeasible {
    for shareholder: us.irc.core::Person;
    for fund: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for fraction: Decimal;
    for ordinary: Money;
    when shareholder_owns_or_treated_as_owning_qef_stock_1293a(shareholder, fund, y)
     and shareholder_pro_rata_fraction_1293b(shareholder, fund, y, fraction)
     and qef_ordinary_earnings_1293e1(fund, y, ordinary);
    then qef_ordinary_income_inclusion_1293a1A(shareholder, fund, y, round(ordinary * fraction, 2, "HALF_UP"));
}
pub relation qef_long_term_capital_gain_inclusion_1293a1B(shareholder: us.irc.core::Person, fund: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the amount included as long-term capital gain: the shareholder's pro rata share of the net capital gain of the fund for the year (section 1293(a)(1)(B))";
}
@source(IRC_S1293_A, relation = formalizes, coverage = exact, quote = "(B) as long-term capital gain, such shareholder's pro rata share of the net capital gain of such fund for such year.")
rule S1293A1BCapitalGainInclusion defeasible {
    for shareholder: us.irc.core::Person;
    for fund: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for fraction: Decimal;
    for gain: Money;
    when shareholder_owns_or_treated_as_owning_qef_stock_1293a(shareholder, fund, y)
     and shareholder_pro_rata_fraction_1293b(shareholder, fund, y, fraction)
     and qef_net_capital_gain_capped_1293e2(fund, y, gain);
    then qef_long_term_capital_gain_inclusion_1293a1B(shareholder, fund, y, round(gain * fraction, 2, "HALF_UP"));
}
pub relation shareholder_taxable_year_of_inclusion_1293a2(shareholder: us.irc.core::Person, fund: us.irc.core::Corporation, fund_year: us.irc.core::TaxableYear, shareholder_year: us.irc.core::TaxableYear) kind institutional {
    label en official "the inclusion is for the taxable year of the shareholder in which or with which the fund's taxable year ends (section 1293(a)(2))";
}
pub relation fund_year_ends_1293a2(fund_year: us.irc.core::TaxableYear, ends_on: Date) kind empirical {
    label en unofficial "the date the fund's taxable year ends (asserted, as year ends are not derived from the year entity here)";
}
@source(IRC_S1293_A, relation = formalizes, coverage = exact, quote = "The inclusion under paragraph (1) shall be for the taxable year of the shareholder in which or with which the taxable year of the fund ends.")
rule S1293A2InclusionYearIsYearContainingFundYearEnd defeasible {
    for shareholder: us.irc.core::Person;
    for fund: us.irc.core::Corporation;
    for fund_year: us.irc.core::TaxableYear;
    for shareholder_year: us.irc.core::TaxableYear;
    for ends_on: Date;
    for b: Date;
    for e: Date;
    when shareholder_owns_or_treated_as_owning_qef_stock_1293a(shareholder, fund, fund_year)
     and fund_year_ends_1293a2(fund_year, ends_on)
     and us.irc.core::year_of(shareholder, shareholder_year)
     and us.irc.core::begins(shareholder_year, b)
     and us.irc.core::ends(shareholder_year, e)
     and b <= ends_on
     and ends_on <= e;
    then shareholder_taxable_year_of_inclusion_1293a2(shareholder, fund, fund_year, shareholder_year);
}
pub relation distribution_paid_out_of_previously_included_earnings_1293c(shareholder: us.irc.core::Person, fund: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the taxpayer establishes to the satisfaction of the Secretary that an amount distributed by the PFIC is paid out of earnings and profits included under subsection (a) in the income of a United States person";
}
pub relation distribution_not_a_dividend_1293c(shareholder: us.irc.core::Person, fund: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the distribution is treated as a distribution which is not a dividend for purposes of this chapter (section 1293(c)); the exceptions of the rest of the sentence for section 1291 purposes are not modeled";
}
@source(IRC_S1293_C, relation = formalizes, coverage = partial, quote = "such amount shall be treated, for purposes of this chapter, as a distribution which is not a dividend; except that such distribution")
rule S1293CDistributionNotDividend defeasible {
    for shareholder: us.irc.core::Person;
    for fund: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when distribution_paid_out_of_previously_included_earnings_1293c(shareholder, fund, y, amount);
    then distribution_not_a_dividend_1293c(shareholder, fund, y, amount);
}
pub relation stock_basis_before_1293d(shareholder: us.irc.core::Person, fund: us.irc.core::Corporation, y: us.irc.core::TaxableYear, basis: Money) kind empirical {
    label en official "the taxpayer's basis in the PFIC stock before the section 1293(d) adjustments";
}
pub relation amount_distributed_not_includible_by_1293c(shareholder: us.irc.core::Person, fund: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the amount distributed with respect to the stock that is not includible in income by reason of section 1293(c)";
}
pub relation stock_basis_after_1293d(shareholder: us.irc.core::Person, fund: us.irc.core::Corporation, y: us.irc.core::TaxableYear, basis: Money) kind institutional {
    label en official "the basis of the stock: increased by the amount included under subsection (a), decreased by the amounts distributed that are not includible by reason of subsection (c) (section 1293(d)); floored at zero";
}
@source(IRC_S1293_D, relation = formalizes, coverage = exact, quote = "(1) increased by any amount which is included in the income of the taxpayer under subsection (a) with respect to such stock, and")
rule S1293DBasisAdjustments defeasible {
    for shareholder: us.irc.core::Person;
    for fund: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for basis: Money;
    for ordinary: Money;
    for gain: Money;
    for distributed: Money;
    when stock_basis_before_1293d(shareholder, fund, y, basis)
     and qef_ordinary_income_inclusion_1293a1A(shareholder, fund, y, ordinary)
     and qef_long_term_capital_gain_inclusion_1293a1B(shareholder, fund, y, gain)
     and amount_distributed_not_includible_by_1293c(shareholder, fund, y, distributed);
    then stock_basis_after_1293d(shareholder, fund, y, max(0.00 USD, basis + ordinary + gain - distributed));
}
pub relation section_960_treatment_1293f(shareholder: us.irc.core::Person, fund: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "for section 960: a section 1293(a) inclusion is treated as included under section 951(a), amounts excluded under (c) as amounts excluded under section 959, and a domestic corporation owning QEF stock meeting the ownership requirement is treated as a United States shareholder of a CFC (section 1293(f)); the ownership-requirement condition of the last clause is not modeled";
}
rule S1293FTreatedAsSection951Inclusion defeasible {
    for shareholder: us.irc.core::Person;
    for fund: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for ordinary: Money;
    when qef_ordinary_income_inclusion_1293a1A(shareholder, fund, y, ordinary);
    then section_960_treatment_1293f(shareholder, fund, y);
}
pub relation fund_is_cfc_and_person_is_us_shareholder_1293g1A(shareholder: us.irc.core::Person, fund: us.irc.core::Corporation) kind empirical {
    label en official "the qualified electing fund is a controlled foreign corporation and the person is a United States shareholder in it";
}
pub relation fund_income_item_high_taxed_or_us_eci_1293g1B(item_id: Text) kind empirical {
    label en official "the person establishes to the satisfaction of the Secretary that the item of income was subject to an effective foreign rate greater than 90 percent of the maximum section 11 rate, or is US-source, effectively connected with a US business of the fund and not treaty-exempt";
}
pub relation fund_income_item_excluded_1293g1(shareholder: us.irc.core::Person, fund: us.irc.core::Corporation, item_id: Text) kind institutional {
    label en official "the item of income is not included in the fund's ordinary earnings and net capital gain for determining the shareholder's inclusion (section 1293(g)(1))";
}
@source(IRC_S1293_G, relation = formalizes, coverage = partial, quote = "For purposes of determining the amount included in the gross income of any person under this section, the ordinary earnings and net capital gain of a qualified electing fund shall not include any item of income received by such fund if—")
rule S1293G1ItemExcluded defeasible {
    for shareholder: us.irc.core::Person;
    for fund: us.irc.core::Corporation;
    for item_id: Text;
    when fund_is_cfc_and_person_is_us_shareholder_1293g1A(shareholder, fund)
     and fund_income_item_high_taxed_or_us_eci_1293g1B(item_id);
    then fund_income_item_excluded_1293g1(shareholder, fund, item_id);
}

// --- §1294: election to extend the time for payment of tax --------------------

pub relation elects_extension_of_time_1294a(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the taxpayer elects to extend the time for payment of the undistributed PFIC earnings tax liability for the taxable year";
}
pub relation section_951_inclusion_for_same_fund_and_year_1294a2(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "an amount is includible in the taxpayer's gross income under section 951 with respect to the qualified electing fund for the year";
}
pub relation election_made_on_1294d(p: us.irc.core::Person, y: us.irc.core::TaxableYear, made_on: Date) kind empirical {
    label en official "the date the section 1294(a) election is made";
}
pub relation return_due_date_with_extensions_1294d(p: us.irc.core::Person, y: us.irc.core::TaxableYear, due: Date) kind empirical {
    label en official "the time prescribed by law (including extensions) for filing the return of tax for the taxable year";
}
pub relation election_timely_1294d(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the election is made not later than the time prescribed for filing the return, including extensions (section 1294(d))";
}
@source(IRC_S1294_D, relation = formalizes, coverage = exact, quote = "The election under subsection (a) shall be made not later than the time prescribed by law (including extensions) for filing the return of tax imposed by this chapter for the taxable year.")
rule S1294DElectionTimely defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for made: Date;
    for due: Date;
    when election_made_on_1294d(p, y, made)
     and return_due_date_with_extensions_1294d(p, y, due)
     and made <= due;
    then election_timely_1294d(p, y);
}
pub relation extension_of_time_in_effect_1294a(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the time for payment of the undistributed PFIC earnings tax liability for the year is extended";
}
pub relation election_valid_1294a(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the election is available: made timely and not barred by an inclusion under section 951 with respect to the fund for the year (section 1294(a)(2), (d))";
}
rule S1294ElectionValid defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when election_timely_1294d(p, y);
    unless section_951_inclusion_for_same_fund_and_year_1294a2(p, y)
     and election_timely_1294d(p, y);
    then election_valid_1294a(p, y);
}
@source(IRC_S1294_A, relation = formalizes, coverage = exact, quote = "At the election of the taxpayer, the time for payment of any undistributed PFIC earnings tax liability of the taxpayer for the taxable year shall be extended to the extent and subject to the limitations provided in this section.")
rule S1294A1ExtensionElectionPower strict {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when elects_extension_of_time_1294a(p, y);
    then power S1294A1ExtensionElection {
        holder p;
        over p;
        exercise elects_extension_of_time_1294a(p, y);
        valid_when election_valid_1294a(p, y);
        effect create(extension_of_time_in_effect_1294a(p, y));
    };
}
pub relation tax_for_year_with_qef_inclusion_1294b1A(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the tax imposed by this chapter for the taxable year";
}
pub relation tax_for_year_without_qef_inclusion_1294b1B(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the tax which would be imposed for the year without regard to the section 1293 inclusion of undistributed earnings of a qualified electing fund";
}
pub relation undistributed_pfic_earnings_tax_liability_1294b1(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the undistributed PFIC earnings tax liability: the excess of the tax with the QEF inclusion over the tax without it (section 1294(b)(1))";
}
@source(IRC_S1294_B, relation = formalizes, coverage = exact, quote = "The term \"undistributed PFIC earnings tax liability\" means, in the case of any taxpayer, the excess of—")
rule S1294B1UndistributedPficEarningsTaxLiability defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for with: Money;
    for without: Money;
    when tax_for_year_with_qef_inclusion_1294b1A(p, y, with)
     and tax_for_year_without_qef_inclusion_1294b1B(p, y, without)
     and with > without;
    then undistributed_pfic_earnings_tax_liability_1294b1(p, y, with - without);
}
pub relation qef_inclusion_amount_1294b2A(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the amount includible in gross income by reason of section 1293(a) for the year";
}
pub relation qef_amount_not_includible_1293c_1294b2B(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the amount not includible in gross income by reason of section 1293(c) for the year";
}
pub relation undistributed_earnings_1294b2(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "undistributed earnings: the excess of the section 1293(a) inclusion over the amount not includible under section 1293(c) (section 1294(b)(2))";
}
@source(IRC_S1294_B, relation = formalizes, coverage = exact, quote = "The term \"undistributed earnings\" means, with respect to any qualified electing fund, the excess (if any) of—")
rule S1294B2UndistributedEarnings defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for inclusion: Money;
    for excluded: Money;
    when qef_inclusion_amount_1294b2A(p, y, inclusion)
     and qef_amount_not_includible_1293c_1294b2B(p, y, excluded)
     and inclusion > excluded;
    then undistributed_earnings_1294b2(p, y, inclusion - excluded);
}
pub relation extension_expires_on_1294c(p: us.irc.core::Person, y: us.irc.core::TaxableYear, expires_on: Date) kind institutional {
    label en official "an extension expires on the last date prescribed by law (without regard to extensions) for filing the return for the taxable year in which the event occurs (section 1294(c)(1)-(2))";
}
pub relation distribution_not_includible_1293c_year_1294c1(p: us.irc.core::Person, y: us.irc.core::TaxableYear, return_due_without_extensions: Date) kind empirical {
    label en official "a distribution is not includible in gross income for the taxable year by reason of section 1293(c); the due date (without extensions) of the return for that year";
}
pub relation stock_transferred_or_fund_ceases_qef_1294c2(p: us.irc.core::Person, y: us.irc.core::TaxableYear, return_due_without_extensions: Date) kind empirical {
    label en official "stock in the PFIC is transferred during the taxable year, or the PFIC ceases to be a QEF; the due date (without extensions) of the return for that year";
}
@source(IRC_S1294_C, relation = formalizes, coverage = partial, quote = "all extensions under subsection (a) for payment of undistributed PFIC earnings tax liability attributable to such stock (or, in the case of such a cessation, attributable to any stock in such company) which had not expired before the date of such transfer or cessation shall expire")
rule S1294C2ExtensionExpiresOnTransferOrCessation defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for due: Date;
    when extension_of_time_in_effect_1294a(p, y)
     and stock_transferred_or_fund_ceases_qef_1294c2(p, y, due);
    then extension_expires_on_1294c(p, y, due);
}
@source(IRC_S1294_C, relation = formalizes, coverage = partial, quote = "then the extension under subsection (a) for payment of the undistributed PFIC earnings tax liability with respect to the earnings to which such distribution is attributable shall expire")
rule S1294C1ExtensionExpiresOnDistribution defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for due: Date;
    when extension_of_time_in_effect_1294a(p, y)
     and distribution_not_includible_1293c_year_1294c1(p, y, due);
    then extension_expires_on_1294c(p, y, due);
}
pub relation secretary_believes_collection_in_jeopardy_1294c3(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the Secretary believes that collection of an amount to which an extension relates is in jeopardy";
}
pub relation extension_terminated_for_jeopardy_1294c3(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the extension is terminated immediately and notice and demand made (section 1294(c)(3))";
}
@source(IRC_S1294_C, relation = formalizes, coverage = exact, quote = "If the Secretary believes that collection of an amount to which an extension under this section relates is in jeopardy, the Secretary shall immediately terminate such extension with respect to such amount, and notice and demand shall be made by him for payment of such amount.")
rule S1294C3JeopardyTerminationPower strict {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when secretary_believes_collection_in_jeopardy_1294c3(p, y);
    then power S1294C3TerminateExtensionPower {
        holder Secretary;
        over p;
        exercise secretary_believes_collection_in_jeopardy_1294c3(p, y);
        valid_when extension_of_time_in_effect_1294a(p, y);
        effect create(extension_terminated_for_jeopardy_1294c3(p, y));
    };
}
pub relation qef_loan_to_shareholder_1294f(fund: us.irc.core::Corporation, shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "a loan by a qualified electing fund (directly or indirectly) to a shareholder of the fund";
}
pub relation loan_treated_as_distribution_1294f(fund: us.irc.core::Corporation, shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "a loan by a QEF to a shareholder is treated as a distribution to the shareholder for sections 1293 and 1294 (section 1294(f))";
}
@source(IRC_S1294_F, relation = formalizes, coverage = exact, quote = "any loan by a qualified electing fund (directly or indirectly) to a shareholder of such fund shall be treated as a distribution to such shareholder.")
rule S1294FLoanIsDistribution defeasible {
    for fund: us.irc.core::Corporation;
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when qef_loan_to_shareholder_1294f(fund, shareholder, y, amount);
    then loan_treated_as_distribution_1294f(fund, shareholder, y, amount);
}

// --- §1296(e)-(l) --------------------------------------------------------------

pub relation stock_regularly_traded_on_qualifying_market_1296e1A(share_id: Text) kind empirical {
    label en official "the stock is regularly traded on a national securities exchange registered with the SEC or the national market system, or on another exchange or market the Secretary determines has adequate rules";
}
pub relation stock_of_comparable_regulated_fund_1296e1B(share_id: Text) kind empirical {
    label en official "stock in a foreign corporation comparable to a regulated investment company, redeemable at its net asset value (to the extent provided in regulations)";
}
pub relation option_on_marketable_stock_1296e1C(share_id: Text) kind empirical {
    label en official "an option on stock described in (A) or (B) (to the extent provided in regulations)";
}
pub relation marketable_stock_1296e(share_id: Text) kind institutional {
    label en official "marketable stock: regularly traded stock, stock of a comparable regulated fund, or options on them (section 1296(e)(1)); module 08 reads `marketable_stock_1296` as a case fact";
}
@source(IRC_S1296_E, relation = formalizes, coverage = exact, quote = "(A) any stock which is regularly traded on—")
rule S1296E1ARegularlyTraded defeasible {
    for share_id: Text;
    when stock_regularly_traded_on_qualifying_market_1296e1A(share_id);
    then marketable_stock_1296e(share_id);
}
rule S1296E1BComparableFund defeasible {
    for share_id: Text;
    when stock_of_comparable_regulated_fund_1296e1B(share_id);
    then marketable_stock_1296e(share_id);
}
rule S1296E1COption defeasible {
    for share_id: Text;
    when option_on_marketable_stock_1296e1C(share_id);
    then marketable_stock_1296e(share_id);
}
pub relation ric_offering_redeemable_stock_1296e2(share_id: Text) kind empirical {
    label en official "the stock is held (directly or indirectly) by a regulated investment company that is offering for sale or has outstanding redeemable stock of which it is the issuer, and is stock in a passive foreign investment company";
}
rule S1296E2RicHeldStockMarketable defeasible {
    for share_id: Text;
    when ric_offering_redeemable_stock_1296e2(share_id);
    then marketable_stock_1296e(share_id);
}
pub relation cfc_owns_pfic_stock_1296f(cfc: us.irc.core::Corporation, share_id: Text) kind empirical {
    label en official "a foreign corporation that is a controlled foreign corporation owns (or is treated under subsection (g) as owning) stock in a passive foreign investment company";
}
pub relation cfc_treated_as_us_person_for_1296_1296f1(cfc: us.irc.core::Corporation, share_id: Text) kind institutional {
    label en official "section 1296 (other than subsection (c)(2)) applies to the CFC as if it were a United States person (section 1296(f)(1))";
}
@source(IRC_S1296_F, relation = formalizes, coverage = exact, quote = "(1) this section (other than subsection (c)(2)) shall apply to such foreign corporation in the same manner as if such corporation were a United States person, and")
rule S1296F1CfcAsUsPerson defeasible {
    for cfc: us.irc.core::Corporation;
    for share_id: Text;
    when cfc_owns_pfic_stock_1296f(cfc, share_id);
    then cfc_treated_as_us_person_for_1296_1296f1(cfc, share_id);
}
pub relation mtm_inclusion_of_cfc_1296f2A(cfc: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the amount included in the CFC's gross income under section 1296(a)(1)";
}
pub relation section_1296_inclusion_is_fphci_1296f2A(cfc: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "for subpart F, a section 1296(a)(1) inclusion is foreign personal holding company income described in section 954(c)(1)(A) (section 1296(f)(2)(A))";
}
rule S1296F2AInclusionIsFphci defeasible {
    for cfc: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when mtm_inclusion_of_cfc_1296f2A(cfc, y, amount);
    then section_1296_inclusion_is_fphci_1296f2A(cfc, y, amount);
}
pub relation marked_stock_owned_through_foreign_pass_through_1296g(p: us.irc.core::Person, share_id: Text, pass_through: us.irc.core::Person) kind empirical {
    label en official "stock owned, directly or indirectly, by or for a foreign partnership, foreign trust or foreign estate, considered owned proportionately by its partners or beneficiaries";
}
pub relation considered_owner_of_pfic_stock_1296g1(p: us.irc.core::Person, share_id: Text) kind institutional {
    label en official "the partner or beneficiary is considered as owning the stock of the foreign pass-through entity proportionately (section 1296(g)(1))";
}
rule S1296G1ProportionateOwnership defeasible {
    for p: us.irc.core::Person;
    for share_id: Text;
    for pt: us.irc.core::Person;
    when marked_stock_owned_through_foreign_pass_through_1296g(p, share_id, pt);
    then considered_owner_of_pfic_stock_1296g1(p, share_id);
}
pub relation elects_1296_after_holding_period_begins_1296j1(p: us.irc.core::Person, share_id: Text) kind empirical {
    label en official "the taxpayer elects the application of section 1296 for marketable stock after the beginning of the holding period";
}
pub relation qef_requirements_met_for_all_pfic_years_1296j1B(p: us.irc.core::Person, share_id: Text) kind empirical {
    label en official "for each PFIC year beginning after 1986 that includes any portion of the holding period, the corporation was treated as a QEF with respect to the taxpayer";
}
pub relation section_1291_applies_in_election_year_1296j1(p: us.irc.core::Person, share_id: Text) kind institutional {
    label en official "section 1291 applies to distributions with respect to, or dispositions of, the stock in the first election year, and to the section 1296(a) amount as if it were gain on disposition, unless the QEF requirements are met (section 1296(j)(1))";
}
@source(IRC_S1296_J, relation = formalizes, coverage = exact, quote = "If the taxpayer elects the application of this section with respect to any marketable stock in a corporation after the beginning of the taxpayer's holding period in such stock, and if the requirements of subparagraph (B) are not satisfied, section 1291 shall apply to—")
rule S1296J1Section1291AppliesToFirstElectionYear defeasible {
    for p: us.irc.core::Person;
    for share_id: Text;
    when elects_1296_after_holding_period_begins_1296j1(p, share_id);
    unless qef_requirements_met_for_all_pfic_years_1296j1B(p, share_id)
     and elects_1296_after_holding_period_begins_1296j1(p, share_id);
    then section_1291_applies_in_election_year_1296j1(p, share_id);
}
pub relation elects_1296k_marketable_stock_1296k(p: us.irc.core::Person, share_id: Text, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the United States person elects to apply section 1296 to the marketable PFIC stock";
}
pub relation stock_ceased_marketable_or_secretary_consents_1296k(p: us.irc.core::Person, share_id: Text, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the stock ceases to be marketable stock, or the Secretary consents to revoke the election";
}
pub relation section_1296_applies_to_stock_1296k(p: us.irc.core::Person, share_id: Text, y: us.irc.core::TaxableYear) kind institutional {
    label en official "section 1296 applies to the marketable stock only if the taxpayer elects, for the year made and all subsequent years, unless the stock ceases to be marketable or the Secretary consents to revocation (section 1296(k))";
}
@source(IRC_S1296_K, relation = formalizes, coverage = exact, quote = "This section shall apply to marketable stock in a passive foreign investment company which is held by a United States person only if such person elects to apply this section with respect to such stock.")
rule S1296KElectionPower strict {
    for p: us.irc.core::Person;
    for share_id: Text;
    for y: us.irc.core::TaxableYear;
    when elects_1296k_marketable_stock_1296k(p, share_id, y);
    then power S1296KMarkToMarketElectionScope {
        holder p;
        over p;
        exercise elects_1296k_marketable_stock_1296k(p, share_id, y);
        valid_when marketable_stock_1296e(share_id);
        effect create(section_1296_applies_to_stock_1296k(p, share_id, y));
    };
}
pub relation individual_becomes_us_person_first_day_1296l(p: us.irc.core::Individual, share_id: Text, fmv_first_day: Money, adjusted_basis: Money) kind empirical {
    label en official "an individual becomes a United States person in a taxable year beginning after December 31, 1997; the fair market value of the marketable PFIC stock on the first day of that year and its adjusted basis";
}
pub relation basis_reset_to_fmv_1296l(p: us.irc.core::Individual, share_id: Text, basis: Money) kind institutional {
    label en official "the adjusted basis (before section 1296(b) adjustments) of marketable PFIC stock owned by an individual becoming a United States person is its fair market value on the first day (section 1296(l))";
}
rule S1296LBasisEqualsFairMarketValue defeasible {
    for p: us.irc.core::Individual;
    for share_id: Text;
    for fmv: Money;
    for basis: Money;
    when individual_becomes_us_person_first_day_1296l(p, share_id, fmv, basis);
    then basis_reset_to_fmv_1296l(p, share_id, fmv);
}

// --- §1297(d)-(f) ---------------------------------------------------------------

pub relation holding_period_portion_is_us_shareholder_of_cfc_1297d2(p: us.irc.core::Person, corp: us.irc.core::Corporation, on: Date) kind empirical {
    label en official "on this day the shareholder is a United States shareholder of the corporation and the corporation is a controlled foreign corporation";
}
pub relation qualified_portion_of_holding_period_1297d2(p: us.irc.core::Person, corp: us.irc.core::Corporation, on: Date) kind institutional {
    label en official "the day is in the qualified portion of the holding period: after December 31, 1997, while the shareholder is a United States shareholder of a CFC (section 1297(d)(2))";
}
@source(IRC_S1297_D, relation = formalizes, coverage = exact, quote = "(A) which is after December 31, 1997, and")
rule S1297D2QualifiedPortion defeasible {
    for p: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for on: Date;
    when holding_period_portion_is_us_shareholder_of_cfc_1297d2(p, corp, on)
     and on > @1997-12-31;
    then qualified_portion_of_holding_period_1297d2(p, corp, on);
}
pub relation pfic_status_suspended_1297d1(p: us.irc.core::Person, corp: us.irc.core::Corporation, on: Date) kind institutional {
    label en official "the corporation is not treated as a PFIC with respect to the shareholder during the qualified portion of the holding period (section 1297(d)(1))";
}
rule S1297D1NotPficDuringQualifiedPortion defeasible {
    for p: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for on: Date;
    when qualified_portion_of_holding_period_1297d2(p, corp, on);
    then pfic_status_suspended_1297d1(p, corp, on);
}
pub relation asset_test_year_1297e(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en unofficial "the taxable year for which the passive asset test basis is determined (a domain anchor)";
}
pub relation publicly_traded_corporation_1297e3(corp: us.irc.core::Corporation) kind empirical {
    label en official "the foreign corporation's stock is regularly traded on a national securities exchange registered with the SEC, the national market system, or another market the Secretary determines has adequate rules";
}
pub relation corporation_is_cfc_or_elects_basis_1297e2(corp: us.irc.core::Corporation) kind empirical {
    label en official "the foreign corporation is not publicly traded and is a controlled foreign corporation, or elects the adjusted-basis paragraph (revocable only with the Secretary's consent)";
}
pub relation asset_test_uses_value_1297e1(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the passive asset test of section 1297(a)(2) is made on the basis of the value of the corporation's assets: for a publicly traded corporation, or when paragraph (2) does not apply (section 1297(e)(1))";
}
@source(IRC_S1297_E, relation = formalizes, coverage = exact, quote = "(A) such corporation is a publicly traded corporation for the taxable year, or")
rule S1297E1ValueBasisForPubliclyTraded defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when publicly_traded_corporation_1297e3(corp)
     and foreign_corporation_1297(corp)
     and asset_test_year_1297e(corp, y);
    then asset_test_uses_value_1297e1(corp, y);
}
pub relation asset_test_uses_adjusted_basis_1297e2(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the passive asset test is made on the adjusted bases (for earnings and profits) of the assets: for a non-publicly-traded corporation that is a CFC or elects (section 1297(e)(2))";
}
@source(IRC_S1297_E, relation = formalizes, coverage = exact, quote = "The determination under subsection (a)(2) shall be based on the adjusted bases (as determined for the purposes of computing earnings and profits) of the assets of a foreign corporation if such corporation is not described in paragraph (1)(A) and such corporation—")
rule S1297E2AdjustedBasisForCfcOrElecting defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when corporation_is_cfc_or_elects_basis_1297e2(corp)
     and foreign_corporation_1297(corp)
     and asset_test_year_1297e(corp, y);
    unless publicly_traded_corporation_1297e3(corp)
     and foreign_corporation_1297(corp)
     and asset_test_year_1297e(corp, y);
    then asset_test_uses_adjusted_basis_1297e2(corp, y);
}
rule S1297E1ValueBasisWhenParagraph2DoesNotApply defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when foreign_corporation_1297(corp)
     and asset_test_year_1297e(corp, y);
    unless corporation_is_cfc_or_elects_basis_1297e2(corp)
     and foreign_corporation_1297(corp)
     and asset_test_year_1297e(corp, y);
    then asset_test_uses_value_1297e1(corp, y);
}
pub relation insurance_liabilities_percent_of_total_assets_1297f1B(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, percent: Decimal) kind empirical {
    label en official "the applicable insurance liabilities as a percentage of total assets on the applicable financial statement for the last year ending with or within the taxable year";
}
pub relation would_be_taxed_under_subchapter_l_1297f1A(corp: us.irc.core::Corporation) kind empirical {
    label en official "the foreign corporation would be subject to tax under subchapter L if it were a domestic corporation";
}
pub relation qualifying_insurance_corporation_1297f1(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "a qualifying insurance corporation: a foreign corporation that would be taxed under subchapter L if domestic and whose applicable insurance liabilities are more than 25 percent of its total assets (section 1297(f)(1))";
}
@source(IRC_S1297_F, relation = formalizes, coverage = exact, quote = "(B) the applicable insurance liabilities of which constitute more than 25 percent of its total assets, determined on the basis of such liabilities and assets as reported on the corporation's applicable financial statement for the last year ending with or within the taxable year.")
rule S1297F1QualifyingInsuranceCorporation defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for pct: Decimal;
    when would_be_taxed_under_subchapter_l_1297f1A(corp)
     and insurance_liabilities_percent_of_total_assets_1297f1B(corp, y, pct)
     and pct > 25.0;
    then qualifying_insurance_corporation_1297f1(corp, y);
}
pub relation us_owner_elects_qualifying_insurance_treatment_1297f2(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "a United States person owning the stock elects to treat it as stock of a qualifying insurance corporation";
}
pub relation predominantly_insurance_and_runoff_or_rating_only_1297f2B(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "under regulations, based on the facts and circumstances, the corporation is predominantly engaged in an insurance business and the failure of the 25-percent test is due solely to runoff-related or rating-related circumstances";
}
pub relation election_treats_stock_as_qualifying_insurance_1297f2(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the owner's election to treat the stock as stock of a qualifying insurance corporation is available: the percentage is at least 10 (though 25 percent or less) and the runoff/rating and predominance conditions hold (section 1297(f)(2))";
}
@source(IRC_S1297_F, relation = formalizes, coverage = exact, quote = "(A) the percentage so determined for the corporation is at least 10 percent, and")
rule S1297F2ElectionAvailable defeasible {
    for p: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for pct: Decimal;
    when us_owner_elects_qualifying_insurance_treatment_1297f2(p, corp, y)
     and would_be_taxed_under_subchapter_l_1297f1A(corp)
     and insurance_liabilities_percent_of_total_assets_1297f1B(corp, y, pct)
     and pct >= 10.0
     and pct <= 25.0
     and predominantly_insurance_and_runoff_or_rating_only_1297f2B(corp, y);
    then election_treats_stock_as_qualifying_insurance_1297f2(p, corp, y);
}

// --- §1298 ----------------------------------------------------------------------

pub relation owner_holds_value_percent_of_corporation_1298a2A(owner: us.irc.core::Person, corp: us.irc.core::Corporation, percent: Decimal) kind empirical {
    label en official "the percentage of the value of the corporation's stock owned, directly or indirectly, by or for the person";
}
pub relation corporation_holds_pfic_stock_1298a2A(corp: us.irc.core::Corporation, pfic: us.irc.core::Corporation, held_percent: Decimal) kind empirical {
    label en official "the percentage of the PFIC's stock owned directly or indirectly by or for the corporation";
}
pub relation constructive_pfic_stock_owned_via_corporation_1298a2(owner: us.irc.core::Person, pfic: us.irc.core::Corporation, percent: Decimal) kind institutional {
    label en official "a person owning 50 percent or more in value of a corporation is considered as owning the stock owned by that corporation in the proportion that the value of the stock the person owns bears to all stock (section 1298(a)(2)(A)); for testing whether a shareholder of a PFIC is treated as owning stock owned by the PFIC the 50-percent limit is disregarded ((a)(2)(B))";
}
@source(IRC_S1298_A, relation = formalizes, coverage = partial, quote = "If 50 percent or more in value of the stock of a corporation is owned, directly or indirectly, by or for any person, such person shall be considered as owning the stock owned directly or indirectly by or for such corporation in that proportion which the value of the stock which such person so owns bears to the value of all stock")
rule S1298A2AFiftyPercentOwnerAttribution defeasible {
    for owner: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for pfic: us.irc.core::Corporation;
    for owner_pct: Decimal;
    for held_pct: Decimal;
    when owner_holds_value_percent_of_corporation_1298a2A(owner, corp, owner_pct)
     and corporation_holds_pfic_stock_1298a2A(corp, pfic, held_pct)
     and owner_pct >= 50.0;
    then constructive_pfic_stock_owned_via_corporation_1298a2(owner, pfic, (owner_pct * held_pct) / 100.0);
}
pub relation partner_share_percent_1298a3(partner: us.irc.core::Person, pass_through: us.irc.core::Person, percent: Decimal) kind empirical {
    label en official "the partner's or beneficiary's proportionate interest in a partnership, estate or trust";
}
pub relation pass_through_holds_pfic_stock_1298a3(pass_through: us.irc.core::Person, pfic: us.irc.core::Corporation, held_percent: Decimal) kind empirical {
    label en official "the percentage of the PFIC's stock owned directly or indirectly by or for the partnership, estate or trust";
}
pub relation constructive_pfic_stock_owned_via_pass_through_1298a3(partner: us.irc.core::Person, pfic: us.irc.core::Corporation, percent: Decimal) kind institutional {
    label en official "stock owned by a partnership, estate or trust is considered owned proportionately by its partners or beneficiaries (section 1298(a)(3))";
}
@source(IRC_S1298_A, relation = formalizes, coverage = exact, quote = "Stock owned, directly or indirectly, by or for a partnership, estate, or trust shall be considered as being owned proportionately by its partners or beneficiaries.")
rule S1298A3PassThroughAttribution defeasible {
    for partner: us.irc.core::Person;
    for pass_through: us.irc.core::Person;
    for pfic: us.irc.core::Corporation;
    for share_pct: Decimal;
    for held_pct: Decimal;
    when partner_share_percent_1298a3(partner, pass_through, share_pct)
     and pass_through_holds_pfic_stock_1298a3(pass_through, pfic, held_pct);
    then constructive_pfic_stock_owned_via_pass_through_1298a3(partner, pfic, (share_pct * held_pct) / 100.0);
}
pub relation person_has_option_to_acquire_stock_1298a4(p: us.irc.core::Person, pfic: us.irc.core::Corporation) kind empirical {
    label en official "the person has an option (or an option on an option, or one of a series of options) to acquire stock, to the extent provided in regulations";
}
pub relation regulations_treat_option_holder_as_owner_1298a4(pfic: us.irc.core::Corporation) kind empirical {
    label en official "regulations provide that option holders are treated as owners of the stock";
}
pub relation option_holder_considered_owner_1298a4(p: us.irc.core::Person, pfic: us.irc.core::Corporation) kind institutional {
    label en official "stock is considered owned by the holder of an option to acquire it, to the extent provided in regulations (section 1298(a)(4))";
}
@source(IRC_S1298_A, relation = formalizes, coverage = partial, quote = "To the extent provided in regulations, if any person has an option to acquire stock, such stock shall be considered as owned by such person.")
rule S1298A4OptionHolder defeasible {
    for p: us.irc.core::Person;
    for pfic: us.irc.core::Corporation;
    when person_has_option_to_acquire_stock_1298a4(p, pfic)
     and regulations_treat_option_holder_as_owner_1298a4(pfic);
    then option_holder_considered_owner_1298a4(p, pfic);
}
pub relation corporation_pfic_history_1298b1(corp: us.irc.core::Corporation, holding_day: Date) kind empirical {
    label en official "at this day of the taxpayer's holding period the corporation (or a predecessor) was a passive foreign investment company that was not a qualified electing fund";
}
pub relation stock_treated_as_pfic_stock_1298b1(p: us.irc.core::Person, corp: us.irc.core::Corporation) kind institutional {
    label en official "stock held by the taxpayer is treated as stock in a PFIC if at any time during the holding period the corporation (or a predecessor) was a PFIC that was not a QEF (section 1298(b)(1)); the exception in the last sentence of the paragraph is not modeled";
}
@source(IRC_S1298_B, relation = formalizes, coverage = partial, quote = "Stock held by a taxpayer shall be treated as stock in a passive foreign investment company if, at any time during the holding period of the taxpayer with respect to such stock, such corporation (or any predecessor) was a passive foreign investment company which was not a qualified electing fund.")
rule S1298B1TaintedStock defeasible {
    for p: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for day: Date;
    when corporation_pfic_history_1298b1(corp, day)
     and stock_owned_by_1298b1(p, corp);
    then stock_treated_as_pfic_stock_1298b1(p, corp);
}
pub relation stock_owned_by_1298b1(p: us.irc.core::Person, corp: us.irc.core::Corporation) kind empirical {
    label en unofficial "the person holds stock in the corporation (a domain anchor)";
}
pub relation start_up_year_1298b2(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the first taxable year in which the corporation has gross income (the start-up year)";
}
pub relation no_predecessor_was_pfic_1298b2A(corp: us.irc.core::Corporation) kind empirical {
    label en official "no predecessor of the corporation was a passive foreign investment company";
}
pub relation established_not_pfic_next_two_years_1298b2B(corp: us.irc.core::Corporation) kind empirical {
    label en official "it is established to the satisfaction of the Secretary that the corporation will not be a PFIC for either of the first 2 taxable years following the start-up year";
}
pub relation not_pfic_in_next_two_years_1298b2C(corp: us.irc.core::Corporation) kind empirical {
    label en official "the corporation is not a PFIC for either of the first 2 taxable years following the start-up year";
}
pub relation not_pfic_start_up_year_exception_1298b2(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the corporation is not treated as a PFIC for its start-up year (section 1298(b)(2))";
}
@source(IRC_S1298_B, relation = formalizes, coverage = exact, quote = "A corporation shall not be treated as a passive foreign investment company for the first taxable year such corporation has gross income (hereinafter in this paragraph referred to as the \"start-up year\") if—")
rule S1298B2StartUpYearException defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when start_up_year_1298b2(corp, y)
     and no_predecessor_was_pfic_1298b2A(corp)
     and established_not_pfic_next_two_years_1298b2B(corp)
     and not_pfic_in_next_two_years_1298b2C(corp);
    then not_pfic_start_up_year_exception_1298b2(corp, y);
}
pub relation substantially_all_passive_income_from_active_business_disposition_1298b3B(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "substantially all of the corporation's passive income for the year is attributable to proceeds from the disposition of one or more active trades or businesses, established to the Secretary's satisfaction";
}
pub relation not_pfic_disposition_proceeds_exception_1298b3(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the corporation is not treated as a PFIC for the year: no prior PFIC year, substantially all passive income from the disposition of active businesses, and not a PFIC in either of the next 2 years (section 1298(b)(3))";
}
@source(IRC_S1298_B, relation = formalizes, coverage = exact, quote = "A corporation shall not be treated as a passive foreign investment company for any taxable year if—")
rule S1298B3DispositionOfActiveBusinessException defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when no_predecessor_was_pfic_1298b2A(corp)
     and substantially_all_passive_income_from_active_business_disposition_1298b3B(corp, y)
     and not_pfic_in_next_two_years_1298b2C(corp);
    then not_pfic_disposition_proceeds_exception_1298b3(corp, y);
}
pub relation taxpayer_uses_pfic_stock_as_loan_security_1298b6(p: us.irc.core::Person, share_id: Text) kind empirical {
    label en official "the taxpayer uses stock in a passive foreign investment company as security for a loan";
}
pub relation regulations_except_loan_security_1298b6(share_id: Text) kind empirical {
    label en official "regulations provide otherwise for the loan-security use";
}
pub relation stock_treated_as_disposed_by_loan_security_1298b6(p: us.irc.core::Person, share_id: Text) kind institutional {
    label en official "the taxpayer is treated as having disposed of the stock (section 1298(b)(6))";
}
@source(IRC_S1298_B, relation = formalizes, coverage = exact, quote = "Except as provided in regulations, if a taxpayer uses any stock in a passive foreign investment company as security for a loan, the taxpayer shall be treated as having disposed of such stock.")
rule S1298B6LoanSecurityIsDisposition defeasible {
    for p: us.irc.core::Person;
    for share_id: Text;
    when taxpayer_uses_pfic_stock_as_loan_security_1298b6(p, share_id);
    unless regulations_except_loan_security_1298b6(share_id)
     and taxpayer_uses_pfic_stock_as_loan_security_1298b6(p, share_id);
    then stock_treated_as_disposed_by_loan_security_1298b6(p, share_id);
}
pub relation amount_included_under_951a1B_1298b8(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "an amount included in gross income under section 951(a)(1)(B) (the section 956 inclusion)";
}
pub relation treated_as_distribution_received_on_stock_1298b8(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "an amount included under section 951(a)(1)(B) is treated as a distribution received with respect to the stock (section 1298(b)(8))";
}
@source(IRC_S1298_B, relation = formalizes, coverage = exact, quote = "Any amount included in gross income under section 951(a)(1)(B) shall be treated as a distribution received with respect to the stock.")
rule S1298B8SectionPlus956InclusionIsDistribution defeasible {
    for p: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when amount_included_under_951a1B_1298b8(p, corp, y, amount);
    then treated_as_distribution_received_on_stock_1298b8(p, corp, y, amount);
}
pub relation pooled_income_fund_holds_pfic_stock_1298c(fund: us.irc.core::Person, share_id: Text) kind empirical {
    label en official "stock in a PFIC is owned (or treated as owned) by a pooled income fund (section 642(c)(5)) and no portion of any gain from its disposition may be allocated to income under the governing instrument";
}
pub relation section_1291_not_applied_to_pooled_income_fund_gain_1298c1(fund: us.irc.core::Person, share_id: Text) kind institutional {
    label en official "section 1291 does not apply to gain on a disposition by the pooled income fund if a section 642(c)(3) deduction would be allowable, and section 1293 does not apply to the stock; section 1291(d) is disregarded for distributions (section 1298(c)(1)-(3)); the section 642(c)(3) condition is not modeled separately";
}
rule S1298CPooledIncomeFund defeasible {
    for fund: us.irc.core::Person;
    for share_id: Text;
    when pooled_income_fund_holds_pfic_stock_1298c(fund, share_id);
    then section_1291_not_applied_to_pooled_income_fund_gain_1298c1(fund, share_id);
}
pub relation lease_of_tangible_personal_property_1298d1(corp: us.irc.core::Corporation, asset: Text, lease_months: Integer) kind empirical {
    label en official "tangible personal property of which the foreign corporation is the lessee under a lease with a term of at least 12 months";
}
pub relation lessor_related_or_avoidance_purpose_1298d3(asset: Text) kind empirical {
    label en official "the lessor is a related person (section 954(d)(3)) or a principal purpose of the lease was to avoid the PFIC provisions";
}
pub relation leased_property_treated_as_held_asset_1298d1(corp: us.irc.core::Corporation, asset: Text) kind institutional {
    label en official "leased tangible personal property (lease term at least 12 months) is treated as an asset actually held by the lessee corporation (section 1298(d)(1)), unless the lessor is related or a principal purpose was avoidance ((d)(3))";
}
@source(IRC_S1298_D, relation = formalizes, coverage = exact, quote = "Any tangible personal property with respect to which a foreign corporation is the lessee under a lease with a term of at least 12 months shall be treated as an asset actually held by such corporation.")
rule S1298D1LeasedPropertyAsset defeasible {
    for corp: us.irc.core::Corporation;
    for asset: Text;
    for months: Integer;
    when lease_of_tangible_personal_property_1298d1(corp, asset, months)
     and months >= 12;
    unless lessor_related_or_avoidance_purpose_1298d3(asset)
     and lease_of_tangible_personal_property_1298d1(corp, asset, months);
    then leased_property_treated_as_held_asset_1298d1(corp, asset);
}
pub relation unamortized_present_value_of_lease_payments_1298d2A(asset: Text, amount: Money) kind empirical {
    label en official "the unamortized portion (under regulations) of the present value of the lease payments, discounted from the beginning of the lease term at the applicable Federal rate for the lease term";
}
pub relation asset_amount_for_1297a2_leased_1298d2A(corp: us.irc.core::Corporation, asset: Text, amount: Money) kind institutional {
    label en official "the amount taken into account under section 1297(a)(2) for a leased asset (section 1298(d)(2)(A))";
}
rule S1298D2AmountOfLeasedAsset defeasible {
    for corp: us.irc.core::Corporation;
    for asset: Text;
    for amount: Money;
    when leased_property_treated_as_held_asset_1298d1(corp, asset)
     and unamortized_present_value_of_lease_payments_1298d2A(asset, amount);
    then asset_amount_for_1297a2_leased_1298d2A(corp, asset, amount);
}

// --- §1298(d)(2)(B): lease discount rate from the pinned Table 1 -------------------------------------------
// The discount rate for the present value of the lease payments is the applicable Federal rate determined
// under section 1274(d) with the lease term substituted for the debt-instrument term, without regard to
// paragraphs (2) and (3) thereof. The us.irs.rev_rul_afr package pins the Table 1 issues structurally
// (sources/tables/afr-2026-*.lawtable.json under the month-index policy in month-index.json) but exports
// no rate relation — rates enter cases as case facts (see that package's README). So the rate below is a
// case fact too: the case reads the Table 1 base-tier semiannual AFR for the substituted lease term from
// the pinned issue and asserts it. The rate rule still fires only for a pinned month ("2026-08" via
// Rev. Rul. 2026-13, "2026-10" via Rev. Rul. 2026-19); the present value itself stays a case fact as well
// (its regulations manner is unpinned).
// Single-issue evaluation worlds are assumed (both pinned issues emit the same predicate; world composition
// is the merge step's). The 1274(d)(1) lease-term category (short/mid/long) is applied by the case — the
// 1274(d)(1) year boundaries are not pinned in this package. Every rate number comes from the tables —
// no rate is written here. Table 1 base-tier rows are the section 1274(d) rates proper, hence "without
// regard to paragraph (2) or (3)" needs no separate adjustment on the Table 1 path.
relation afr_table_month_1298(m: Text) kind institutional {
    label en unofficial "the calendar month (YYYY-MM) whose Revenue Ruling issue governs a Table 1 lookup: a month pinned in the AFR month-index (the freshest ruling of that month)";
}
rule S1298AfrMonth202608 strict {
    label en unofficial "August 2026 is a pinned AFR month (Rev. Rul. 2026-13, month-index selection policy)";
    when true;
    then afr_table_month_1298("2026-08");
}
rule S1298AfrMonth202610 strict {
    label en unofficial "October 2026 is a pinned AFR month (Rev. Rul. 2026-19, month-index selection policy)";
    when true;
    then afr_table_month_1298("2026-10");
}
relation lease_afr_horizon_1298d2(asset: Text, h: Text) kind empirical {
    label en unofficial "the section 1274(d)(1) term category (short, mid, or long) of the lease term substituted for the debt-instrument term, applied by the case (section 1298(d)(2)(B)(ii)(I))";
}
relation lease_afr_month_1298d2(asset: Text, m: Text) kind empirical {
    label en unofficial "the calendar month (YYYY-MM) whose Revenue Ruling issue supplies the discount rate for the leased asset (case-selected: the statute names no month)";
}
relation lease_afr_table1_base_semiannual_rate_case_1298d2(asset: Text, m: Text, h: Text, r: Decimal) kind empirical {
    label en unofficial "the Table 1 base-tier semiannual applicable Federal rate for the substituted lease term and ruling month, read by the case from the pinned Revenue Ruling issue (section 1298(d)(2)(B)(ii))";
}
pub relation lease_discount_rate_from_table_1298d2B(asset: Text, m: Text, r: Decimal) kind institutional {
    label en official "the discount rate for the leased asset from the pinned Table 1: the applicable Federal rate under section 1274(d) for the substituted lease term, compounded semiannually (section 1298(d)(2)(B)(ii))";
}
@source(IRC_S1298_D, relation = formalizes, coverage = partial, quote = "(ii) except as provided in such regulations, by using a discount rate equal to the applicable Federal rate determined under section 1274(d)—")
rule S1298D2BDiscountRateFromTable defeasible {
    for corp: us.irc.core::Corporation;
    for asset: Text;
    for m: Text;
    for h: Text;
    for r: Decimal;
    when leased_property_treated_as_held_asset_1298d1(corp, asset)
     and lease_afr_horizon_1298d2(asset, h)
     and lease_afr_month_1298d2(asset, m)
     and afr_table_month_1298(m)
     and lease_afr_table1_base_semiannual_rate_case_1298d2(asset, m, h, r);
    then lease_discount_rate_from_table_1298d2B(asset, m, r);
}
pub relation cfc_total_assets_adjusted_basis_1298e(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the adjusted basis of the total assets of the controlled foreign corporation";
}
pub relation rd_expenditures_year_and_two_preceding_1298e1(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the research or experimental expenditures (section 174) paid or incurred by the CFC during the taxable year and the preceding 2 taxable years";
}
pub relation cfc_total_assets_adjusted_for_rd_1298e1(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the adjusted basis of the total assets of a CFC is increased by the research or experimental expenditures paid or incurred in the year and the preceding 2 years (section 1298(e)(1)); the exclusion of expenditures already taken into account is left to the case";
}
@source(IRC_S1298_E, relation = formalizes, coverage = partial, quote = "The adjusted basis of the total assets of a controlled foreign corporation shall be increased by the research or experimental expenditures (within the meaning of section 174) paid or incurred by such foreign corporation during the taxable year and the preceding 2 taxable years.")
rule S1298E1AssetsIncreasedByResearch defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for basis: Money;
    for rd: Money;
    when cfc_total_assets_adjusted_basis_1298e(corp, y, basis)
     and rd_expenditures_year_and_two_preceding_1298e1(corp, y, rd);
    then cfc_total_assets_adjusted_for_rd_1298e1(corp, y, basis + rd);
}
pub relation shareholder_of_pfic_1298f(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "a United States person that is a shareholder of a passive foreign investment company for the year";
}
pub relation annual_pfic_report_filed_1298f(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the shareholder has filed the annual report containing the information the Secretary requires";
}
@source(IRC_S1298_F, relation = formalizes, coverage = exact, quote = "Except as otherwise provided by the Secretary, each United States person who is a shareholder of a passive foreign investment company shall file an annual report containing such information as the Secretary may require.")
rule S1298FDutyToFileAnnualReport defeasible {
    for p: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when shareholder_of_pfic_1298f(p, corp, y);
    then duty S1298FAnnualReportDuty {
        bearer p;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition annual_pfic_report_filed_1298f(p, corp, y);
            window [-infinity, infinity];
        }
    };
}
