// §861 residual (stage 2d): (a)(1)(B), (a)(2)(C)-(D), (a)(3) crew rule, (a)(5), (a)(7)-(9),
// (b), (c), (d). Module 01 carries (a)(1)-(4) core and (a)(6); module 13 carries §865.

use self::{
    IRC_S861_A,
    IRC_S861_B,
    IRC_S861_C,
    IRC_S861_D,
};

pub relation interest_paid_by_foreign_partnership_861a1B(payer: us.irc.core::Person, payee: us.irc.core::Person, amount: Money) kind empirical {
    label en official "interest paid by a foreign partnership";
}
pub relation partnership_predominantly_engaged_in_active_business_outside_us_861a1B(payer: us.irc.core::Person) kind empirical {
    label en official "the foreign partnership is predominantly engaged in the active conduct of a trade or business outside the United States";
}
pub relation interest_paid_by_us_business_or_allocable_to_eci_861a1B(payer: us.irc.core::Person, payee: us.irc.core::Person) kind empirical {
    label en official "the interest is paid by a trade or business engaged in by the partnership in the United States, or is allocable to income effectively connected with a trade or business in the United States";
}
pub relation interest_not_us_source_foreign_partnership_861a1B(payer: us.irc.core::Person, payee: us.irc.core::Person, amount: Money) kind institutional {
    label en official "interest of a foreign partnership predominantly engaged in an active business outside the United States is not treated as United States source unless paid by its United States business or allocable to effectively connected income (section 861(a)(1)(B)); not chained into module 01";
}
@source(IRC_S861_A, relation = formalizes, coverage = exact, quote = "(B) in the case of a foreign partnership, which is predominantly engaged in the active conduct of a trade or business outside the United States, any interest not paid by a trade or business engaged")
rule S861A1BForeignPartnershipInterestNotUsSource defeasible {
    for payer: us.irc.core::Person;
    for payee: us.irc.core::Person;
    for amount: Money;
    when interest_paid_by_foreign_partnership_861a1B(payer, payee, amount)
     and partnership_predominantly_engaged_in_active_business_outside_us_861a1B(payer);
    unless interest_paid_by_us_business_or_allocable_to_eci_861a1B(payer, payee)
     and interest_paid_by_foreign_partnership_861a1B(payer, payee, amount);
    then interest_not_us_source_foreign_partnership_861a1B(payer, payee, amount);
}
pub relation dividend_treated_as_domestic_by_243e_861a2C(payer: us.irc.core::Corporation, payee: us.irc.core::Person, amount: Money) kind empirical {
    label en official "a dividend from a foreign corporation to the extent required by section 243(e) to be treated as a dividend from a domestic corporation subject to tax under this chapter";
}
pub relation us_source_dividend_243e_861a2C(payer: us.irc.core::Corporation, payee: us.irc.core::Person, amount: Money) kind institutional {
    label en official "the dividend is income from sources within the United States, and subparagraph (B) does not apply to it (section 861(a)(2)(C))";
}
@source(IRC_S861_A, relation = formalizes, coverage = exact, quote = "(C) from a foreign corporation to the extent that such amount is required by section 243(e) (relating to certain dividends from foreign corporations) to be treated as dividends from a domestic")
rule S861A2CDividendTreatedAsDomestic defeasible {
    for payer: us.irc.core::Corporation;
    for payee: us.irc.core::Person;
    for amount: Money;
    when dividend_treated_as_domestic_by_243e_861a2C(payer, payee, amount);
    then us_source_dividend_243e_861a2C(payer, payee, amount);
}
pub relation dividend_from_disc_or_former_disc_861a2D(payer: us.irc.core::Corporation, payee: us.irc.core::Person, amount: Money, attributable_to_qualified_export_receipts: Money) kind empirical {
    label en official "a dividend from a DISC or former DISC (section 992(a)), and the part attributable to qualified export receipts described in section 993(a)(1) (other than interest and gains described in section 995(b)(1))";
}
pub relation us_source_dividend_disc_861a2D(payer: us.irc.core::Corporation, payee: us.irc.core::Person, amount: Money) kind institutional {
    label en official "the dividend is United States source except to the extent attributable to qualified export receipts (section 861(a)(2)(D))";
}
@source(IRC_S861_A, relation = formalizes, coverage = exact, quote = "(D) from a DISC or former DISC (as defined in section 992(a)) except to the extent attributable (as determined under regulations prescribed by the Secretary) to qualified export receipts described in")
rule S861A2DDiscDividendUsSourceExceptExportReceipts defeasible {
    for payer: us.irc.core::Corporation;
    for payee: us.irc.core::Person;
    for amount: Money;
    for qer: Money;
    when dividend_from_disc_or_former_disc_861a2D(payer, payee, amount, qer);
    then us_source_dividend_disc_861a2D(payer, payee, max(amount - qer, 0.00 USD));
}
pub relation compensation_of_regular_crew_member_of_foreign_vessel_861a3(worker: us.irc.core::Individual, amount: Money) kind empirical {
    label en official "compensation for labor or services performed in the United States by a nonresident alien individual in connection with the individual's temporary presence as a regular member of the crew of a foreign vessel engaged in transportation between the United States and a foreign country or a possession";
}
pub relation crew_compensation_not_us_source_861a3(worker: us.irc.core::Individual, amount: Money) kind institutional {
    label en official "the crew compensation is not deemed income from sources within the United States (section 861(a)(3), last sentence)";
}
@source(IRC_S861_A, relation = formalizes, coverage = exact, quote = "In addition, compensation for labor or services performed in the United States shall not be deemed to be income from sources within the United States if the labor or services are performed by a")
rule S861A3CrewMemberCompensationNotUsSource defeasible {
    for worker: us.irc.core::Individual;
    for amount: Money;
    when compensation_of_regular_crew_member_of_foreign_vessel_861a3(worker, amount);
    then crew_compensation_not_us_source_861a3(worker, amount);
}
pub relation gain_from_disposition_of_usrpi_861a5(p: us.irc.core::Person, amount: Money) kind empirical {
    label en official "gains, profits and income from the disposition of a United States real property interest (section 897(c))";
}
pub relation us_source_usrpi_disposition_income_861a5(p: us.irc.core::Person, amount: Money) kind institutional {
    label en official "the income is from sources within the United States (section 861(a)(5))";
}
@source(IRC_S861_A, relation = formalizes, coverage = exact, quote = "Gains, profits, and income from the disposition of a United States real property interest (as defined in section 897(c)).")
rule S861A5UsrpiDispositionIsUsSource defeasible {
    for p: us.irc.core::Person;
    for amount: Money;
    when gain_from_disposition_of_usrpi_861a5(p, amount);
    then us_source_usrpi_disposition_income_861a5(p, amount);
}
pub relation underwriting_income_861a7(corp: us.irc.core::Corporation, item_id: Text, amount: Money) kind empirical {
    label en official "amounts received as underwriting income (section 832(b)(3)) derived from the issuing (or reinsuring) of an insurance or annuity contract";
}
pub relation contract_covers_us_property_liability_or_residents_861a7A(item_id: Text) kind empirical {
    label en official "the contract is in connection with property in, liability arising out of an activity in, or the lives or health of residents of, the United States";
}
pub relation substantially_equal_premium_arrangement_for_us_risks_861a7B(item_id: Text) kind empirical {
    label en official "the risk is not described in subparagraph (A) but under an arrangement another corporation receives a substantially equal amount of premiums for issuing or reinsuring a contract in connection with United States risks";
}
pub relation us_source_underwriting_income_861a7(corp: us.irc.core::Corporation, item_id: Text, amount: Money) kind institutional {
    label en official "the underwriting income is from sources within the United States (section 861(a)(7))";
}
@source(IRC_S861_A, relation = formalizes, coverage = exact, quote = "(A) in connection with property in, liability arising out of an activity in, or in connection with the lives or health of residents of, the United States, or")
rule S861A7AUnderwritingIncomeFromUsRisks defeasible {
    for corp: us.irc.core::Corporation;
    for item_id: Text;
    for amount: Money;
    when underwriting_income_861a7(corp, item_id, amount)
     and contract_covers_us_property_liability_or_residents_861a7A(item_id);
    then us_source_underwriting_income_861a7(corp, item_id, amount);
}
@source(IRC_S861_A, relation = formalizes, coverage = exact, quote = "(B) in connection with risks not described in subparagraph (A) as a result of any arrangement whereby another corporation receives a substantially equal amount of premiums or other consideration in")
rule S861A7BUnderwritingIncomeUnderArrangement defeasible {
    for corp: us.irc.core::Corporation;
    for item_id: Text;
    for amount: Money;
    when underwriting_income_861a7(corp, item_id, amount)
     and substantially_equal_premium_arrangement_for_us_risks_861a7B(item_id);
    then us_source_underwriting_income_861a7(corp, item_id, amount);
}
pub relation social_security_benefit_861a8(p: us.irc.core::Person, amount: Money) kind empirical {
    label en official "a social security benefit (section 86(d))";
}
pub relation us_source_social_security_benefit_861a8(p: us.irc.core::Person, amount: Money) kind institutional {
    label en official "the benefit is from sources within the United States (section 861(a)(8))";
}
@source(IRC_S861_A, relation = formalizes, coverage = exact, quote = "Any social security benefit (as defined in section 86(d)).")
rule S861A8SocialSecurityIsUsSource defeasible {
    for p: us.irc.core::Person;
    for amount: Money;
    when social_security_benefit_861a8(p, amount);
    then us_source_social_security_benefit_861a8(p, amount);
}
pub relation guarantee_amount_received_861a9(payee: us.irc.core::Person, item_id: Text, amount: Money, guaranteed_party: Text) kind empirical {
    label en official "an amount received, directly or indirectly, for the provision of a guarantee of indebtedness, where the guaranteed party is `noncorporate_resident_or_domestic_corporation` or `foreign_person`";
}
pub relation guarantee_amount_connected_with_eci_861a9B(item_id: Text) kind empirical {
    label en official "the amount is connected with income which is effectively connected (or treated as effectively connected) with the conduct of a trade or business in the United States";
}
pub relation us_source_guarantee_fee_861a9(payee: us.irc.core::Person, item_id: Text, amount: Money) kind institutional {
    label en official "the guarantee fee is income from sources within the United States (section 861(a)(9))";
}
@source(IRC_S861_A, relation = formalizes, coverage = exact, quote = "(A) a noncorporate resident or domestic corporation for the provision of a guarantee of any indebtedness of such resident or corporation, or")
rule S861A9ADomesticGuaranteedIndebtedness defeasible {
    for payee: us.irc.core::Person;
    for item_id: Text;
    for amount: Money;
    when guarantee_amount_received_861a9(payee, item_id, amount, "noncorporate_resident_or_domestic_corporation");
    then us_source_guarantee_fee_861a9(payee, item_id, amount);
}
@source(IRC_S861_A, relation = formalizes, coverage = exact, quote = "(B) any foreign person for the provision of a guarantee of any indebtedness of such person, if such amount is connected with income which is effectively connected (or treated as effectively")
rule S861A9BForeignPersonGuaranteeConnectedWithEci defeasible {
    for payee: us.irc.core::Person;
    for item_id: Text;
    for amount: Money;
    when guarantee_amount_received_861a9(payee, item_id, amount, "foreign_person")
     and guarantee_amount_connected_with_eci_861a9B(item_id);
    then us_source_guarantee_fee_861a9(payee, item_id, amount);
}
pub relation us_source_gross_income_and_deductions_861b(p: us.irc.core::Person, y: us.irc.core::TaxableYear, gross_income: Money, allocated_deductions: Money, ratable_part_of_unallocable_deductions: Money) kind empirical {
    label en official "the items of gross income specified in subsection (a) as United States source, the expenses, losses and other deductions properly apportioned or allocated to them, and a ratable part of the deductions which cannot definitely be allocated to some item or class of gross income";
}
pub relation taxable_income_from_us_sources_861b(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the remainder, if any, is included in full as taxable income from sources within the United States (section 861(b))";
}
@source(IRC_S861_B, relation = formalizes, coverage = partial, quote = "From the items of gross income specified in subsection (a) as being income from sources within the United States there shall be deducted the expenses, losses, and other deductions properly")
rule S861BTaxableIncomeFromUsSources defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for gross: Money;
    for allocated: Money;
    for ratable: Money;
    when us_source_gross_income_and_deductions_861b(p, y, gross, allocated, ratable);
    then taxable_income_from_us_sources_861b(p, y, max(gross - allocated - ratable, 0.00 USD));
}
pub relation foreign_corporation_has_no_gross_income_for_three_year_period_861c(corp: us.irc.core::Corporation) kind empirical {
    label en official "the foreign corporation has no gross income from any source for the 3-year period (or part thereof) specified in subsection (a)(2)(B)";
}
pub relation testing_year_is_year_of_dividend_payment_861c(corp: us.irc.core::Corporation) kind institutional {
    label en official "the requirements of subsection (a)(2)(B) are applied with respect to the taxable year of the corporation in which the dividend is paid (section 861(c))";
}
@source(IRC_S861_C, relation = formalizes, coverage = exact, quote = "For purposes of subsection (a)(2)(B), if the foreign corporation has no gross income from any source for the 3-year period (or part thereof) specified, the requirements of such subsection shall be")
rule S861CNoGrossIncomeTestingYearIsPaymentYear defeasible {
    for corp: us.irc.core::Corporation;
    when foreign_corporation_has_no_gross_income_for_three_year_period_861c(corp);
    then testing_year_is_year_of_dividend_payment_861c(corp);
}
pub relation lease_of_railroad_rolling_stock_861d1(lessor: us.irc.core::Person, lease_id: Text, amount_includible: Money) kind empirical {
    label en official "a taxpayer leases railroad rolling stock which is section 1245 property to a domestic common carrier by railroad (or a corporation controlled by such carriers), and all amounts includible in gross income with respect to it (including gain on disposition)";
}
pub relation lease_use_expected_within_us_861d1B(lease_id: Text) kind empirical {
    label en official "the use under the lease is expected to be use within the United States (satisfied if the only expected use outside the United States is temporary use in Canada or Mexico)";
}
pub relation lease_between_members_of_controlled_group_with_carrier_861d2(lease_id: Text) kind empirical {
    label en official "the lease is between two members of the same controlled group of corporations (section 1563) and a member of the group is a domestic common carrier by railroad or a switching or terminal company all of whose stock is owned by such carriers";
}
pub relation us_source_rolling_stock_income_861d1(lessor: us.irc.core::Person, lease_id: Text, amount: Money) kind institutional {
    label en official "all amounts includible in gross income with respect to the rolling stock are income from sources within the United States, for subsection (a) and section 862(a) (section 861(d)(1))";
}
@source(IRC_S861_D, relation = formalizes, coverage = exact, quote = "For purposes of subsection (a) and section 862(a), if—")
rule S861D1RollingStockLeaseIncomeUsSource defeasible {
    for lessor: us.irc.core::Person;
    for lease_id: Text;
    for amount: Money;
    when lease_of_railroad_rolling_stock_861d1(lessor, lease_id, amount)
     and lease_use_expected_within_us_861d1B(lease_id);
    unless lease_between_members_of_controlled_group_with_carrier_861d2(lease_id)
     and lease_of_railroad_rolling_stock_861d1(lessor, lease_id, amount);
    then us_source_rolling_stock_income_861d1(lessor, lease_id, amount);
}
pub relation foreign_tax_credit_denied_on_rolling_stock_861d3(lessor: us.irc.core::Person, lease_id: Text) kind institutional {
    label en official "no credit is allowed under section 901 for payments to foreign countries with respect to amounts received for rolling stock subject to paragraph (1) (section 861(d)(3))";
}
@source(IRC_S861_D, relation = formalizes, coverage = exact, quote = "No credit shall be allowed under section 901 for any payments to foreign countries with respect to any amount received by the taxpayer with respect to railroad rolling stock which is subject to")
rule S861D3NoForeignTaxCreditOnRollingStock defeasible {
    for lessor: us.irc.core::Person;
    for lease_id: Text;
    for amount: Money;
    when us_source_rolling_stock_income_861d1(lessor, lease_id, amount);
    then foreign_tax_credit_denied_on_rolling_stock_861d3(lessor, lease_id);
}
