// Stage 3 (TECH_GAP reduction), module 44: section 988(a)(3) residence-based source, (c)(1)(C)-(E), (c)(5).
// Status implemented_unverified: not a legal review; scenarios in tests/s988-stage3.lawtest are written, NOT executed.
//
// Modeling notes.
//  * `section_988_transaction` (module 17) now has one more limb: the disposition of nonfunctional currency
//    (c)(1)(C); and the forward/futures/option limb is cut back by `excluded_from_988c1Biii`.
//  * The 20-partner / 20-percent test of the qualified fund is derived per partner; the count of partners
//    failing it is asserted (a `forall` over a derived relation is a runtime-subset limit, section 111).
//  * Elections continue to later years "unless revoked with the consent of the Secretary": the carried-in
//    election is a case fact of the earlier year (no cross-year ledger).

// --- §988(c)(1)(C): disposition of nonfunctional currency ----------------------------------------------------

use self::{
    IRC_S988_A,
    IRC_S988_C,
    debt_instrument_acquired_or_issued,
    forward_futures_option_entered_into,
    section_988_gain_or_loss,
    section_988_transaction,
};

pub relation coin_or_currency_988c1Cii(item_id: Text) kind empirical {
    label en official "the item is coin or currency (nonfunctional currency)";
}
pub relation nonfunctional_deposit_or_similar_instrument_988c1Cii(item_id: Text) kind empirical {
    label en official "the item is a nonfunctional currency denominated demand or time deposit or similar instrument issued by a bank or other financial institution";
}
pub relation nonfunctional_currency_988c1Cii(item_id: Text) kind institutional {
    label en official "nonfunctional currency: coin or currency, and nonfunctional currency denominated demand or time deposits or similar instruments issued by a bank or other financial institution";
}
@source(IRC_S988_C, relation = formalizes, coverage = exact, quote = "For purposes of this section, the term \"nonfunctional currency\" includes coin or currency, and nonfunctional")
rule S988C1CiiNonfunctionalCoinOrCurrency defeasible {
    for item_id: Text;
    when coin_or_currency_988c1Cii(item_id);
    then nonfunctional_currency_988c1Cii(item_id);
}
@source(IRC_S988_C, relation = formalizes, coverage = exact, quote = "For purposes of this section, the term \"nonfunctional currency\" includes coin or currency, and nonfunctional")
rule S988C1CiiNonfunctionalDeposit defeasible {
    for item_id: Text;
    when nonfunctional_deposit_or_similar_instrument_988c1Cii(item_id);
    then nonfunctional_currency_988c1Cii(item_id);
}
pub relation disposition_of_nonfunctional_currency_988c1Ci(item_id: Text) kind empirical {
    label en official "a disposition of nonfunctional currency (the item is disposed of)";
}
@source(IRC_S988_C, relation = formalizes, coverage = exact, quote = "(I) such disposition shall be treated as a section 988 transaction, and")
rule S988C1CiDispositionIsSection988Transaction defeasible {
    for item_id: Text;
    when disposition_of_nonfunctional_currency_988c1Ci(item_id)
     and nonfunctional_currency_988c1Cii(item_id);
    then section_988_transaction(item_id);
}
pub relation gain_or_loss_from_nonfunctional_currency_disposition_988c1Ci(item_id: Text, amount: Money) kind empirical {
    label en official "the gain or loss from the disposition of the nonfunctional currency";
}
pub relation treated_as_foreign_currency_gain_or_loss_988c1CiII(item_id: Text, amount: Money) kind institutional {
    label en official "the gain or loss from the disposition of nonfunctional currency is treated as foreign currency gain or loss";
}
@source(IRC_S988_C, relation = formalizes, coverage = exact, quote = "(II) any gain or loss from such transaction shall be treated as foreign currency gain or loss (as the case")
rule S988C1CiiiGainOrLossIsForeignCurrencyGainOrLoss defeasible {
    for item_id: Text;
    for amount: Money;
    when disposition_of_nonfunctional_currency_988c1Ci(item_id)
     and nonfunctional_currency_988c1Cii(item_id)
     and gain_or_loss_from_nonfunctional_currency_disposition_988c1Ci(item_id, amount);
    then treated_as_foreign_currency_gain_or_loss_988c1CiII(item_id, amount);
}

// --- §988(c)(1)(D): section 1256 contracts; election out --------------------------------------------------------

pub relation contract_marked_to_market_under_1256_if_held_988c1Di(p: us.irc.core::Person, item_id: Text, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the regulated futures contract or nonequity option would be marked to market under section 1256 if held on the last day of the taxable year";
}
pub relation elects_out_of_988c1Di_on(p: us.irc.core::Person, y: us.irc.core::TaxableYear, made_on: Date) kind empirical {
    label en official "the taxpayer elects that clause (i) not apply to it, on this date";
}
pub relation election_deadline_988c1DiiII(p: us.irc.core::Person, y: us.irc.core::TaxableYear, deadline: Date) kind empirical {
    label en official "the 1st day of the taxable year (or, if later, the 1st day during the year on which the taxpayer holds a contract described in clause (i)); regulations may provide otherwise";
}
pub relation election_out_timely_988c1DiiII(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the election is made on or before the 1st day of the taxable year (or the later 1st day of holding a contract described in clause (i))";
}
@source(IRC_S988_C, relation = formalizes, coverage = exact, quote = "Except as provided in regulations, an election under subclause (I) for any taxable year shall be made on or")
rule S988C1DiiIITimelyElection defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for made_on: Date;
    for deadline: Date;
    when elects_out_of_988c1Di_on(p, y, made_on)
     and election_deadline_988c1DiiII(p, y, deadline)
     and made_on <= deadline;
    then election_out_timely_988c1DiiII(p, y);
}
pub relation election_out_in_effect_988c1Dii(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the election out of clause (i) made for the taxable year is in effect (it applies to contracts held at any time during that year and any succeeding year unless revoked with the consent of the Secretary)";
}
@source(IRC_S988_C, relation = formalizes, coverage = exact, quote = "The taxpayer may elect to have clause (i) not apply to such taxpayer. Such an election shall apply to")
rule S988C1DiElectionOutPower defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for made_on: Date;
    when elects_out_of_988c1Di_on(p, y, made_on);
    then power S988C1DiiElectionOutOfSection1256Exception {
        holder p;
        over p;
        exercise elects_out_of_988c1Di_on(p, y, made_on);
        valid_when election_out_timely_988c1DiiII(p, y);
        effect create(election_out_in_effect_988c1Dii(p, y));
    };
}
pub relation election_out_carried_from_earlier_year_988c1DiiI(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "an election out of clause (i) made for an earlier taxable year applies to this year and has not been revoked with the consent of the Secretary";
}
pub relation election_out_applies_988c1Dii(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the election out of clause (i) applies to the taxable year (made for it, or carried from an earlier year); for a partnership or an S corporation each partner or shareholder elects separately, so p is the partner or shareholder";
}
@source(IRC_S988_C, relation = formalizes, coverage = exact, quote = "In the case of a partnership, an election under subclause (I) shall be made by each partner separately. A")
rule S988C1DiiElectionAppliesThisYear defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when election_out_in_effect_988c1Dii(p, y);
    then election_out_applies_988c1Dii(p, y);
}
@source(IRC_S988_C, relation = formalizes, coverage = exact, quote = "The taxpayer may elect to have clause (i) not apply to such taxpayer. Such an election shall apply to")
rule S988C1DiiElectionAppliesCarried defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when election_out_carried_from_earlier_year_988c1DiiI(p, y);
    then election_out_applies_988c1Dii(p, y);
}
pub relation partnership_election_under_988c1EiiiV_applies(partnership: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the partnership made the qualified-fund election under clause (iii)(V) for the year or a preceding year";
}
pub relation exception_988c1Di_applies(p: us.irc.core::Person, item_id: Text, y: us.irc.core::TaxableYear) kind institutional {
    label en official "clause (iii) of subparagraph (B) does not apply to a regulated futures contract or nonequity option that would be marked to market under section 1256: unless the taxpayer elected out, and not for a partnership with an (E)(iii)(V) election";
}
@source(IRC_S988_C, relation = formalizes, coverage = exact, quote = "Clause (iii) of subparagraph (B) shall not apply to any regulated futures contract or nonequity option which")
rule S988C1DiSection1256ContractsExcluded defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    for y: us.irc.core::TaxableYear;
    when contract_marked_to_market_under_1256_if_held_988c1Di(p, item_id, y);
    unless election_out_applies_988c1Dii(p, y)
     and contract_marked_to_market_under_1256_if_held_988c1Di(p, item_id, y);
    unless partnership_election_under_988c1EiiiV_applies(p, y)
     and contract_marked_to_market_under_1256_if_held_988c1Di(p, item_id, y);
    then exception_988c1Di_applies(p, item_id, y);
}

// --- §988(c)(1)(E): qualified funds ---------------------------------------------------------------------------------------

pub relation partnership_elects_qualified_fund_treatment_988c1EiiiV(partnership: us.irc.core::Person, y: us.irc.core::TaxableYear, made_on: Date) kind empirical {
    label en official "the partnership elects under subclause (V) that clauses (i) and (iv) apply, on this date";
}
pub relation qualified_fund_election_deadline_988c1EiiiV(partnership: us.irc.core::Person, y: us.irc.core::TaxableYear, deadline: Date) kind empirical {
    label en official "the 1st day of the taxable year (or, if later, the 1st day during the year on which the partnership holds an instrument referred to in clause (i))";
}
pub relation qualified_fund_election_timely_988c1EiiiV(partnership: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the election is made on or before the 1st day of the taxable year (or the later 1st day of holding an instrument referred to in clause (i))";
}
@source(IRC_S988_C, relation = formalizes, coverage = exact, quote = "An election under subclause (V) for any taxable year shall be made on or before the 1st day of such taxable")
rule S988C1EiiiVTimelyElection defeasible {
    for partnership: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for made_on: Date;
    for deadline: Date;
    when partnership_elects_qualified_fund_treatment_988c1EiiiV(partnership, y, made_on)
     and qualified_fund_election_deadline_988c1EiiiV(partnership, y, deadline)
     and made_on <= deadline;
    then qualified_fund_election_timely_988c1EiiiV(partnership, y);
}
pub relation qualified_fund_election_in_effect_988c1EiiiV(partnership: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the election under subclause (V) applies to the taxable year for which made and all succeeding taxable years unless revoked with the consent of the Secretary";
}
@source(IRC_S988_C, relation = formalizes, coverage = exact, quote = "(V) an election under this subclause applies to the taxable year.")
rule S988C1EiiiVElectionPower defeasible {
    for partnership: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for made_on: Date;
    when partnership_elects_qualified_fund_treatment_988c1EiiiV(partnership, y, made_on);
    then power S988C1EiiiVQualifiedFundElection {
        holder partnership;
        over partnership;
        exercise partnership_elects_qualified_fund_treatment_988c1EiiiV(partnership, y, made_on);
        valid_when qualified_fund_election_timely_988c1EiiiV(partnership, y);
        effect create(qualified_fund_election_in_effect_988c1EiiiV(partnership, y));
    };
}
pub relation qualified_fund_election_from_earlier_year_988c1EiiiV(partnership: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "a subclause (V) election for an earlier taxable year applies to this year and has not been revoked with the consent of the Secretary";
}
@source(IRC_S988_C, relation = formalizes, coverage = exact, quote = "This subparagraph shall not apply to any income or loss of a partnership for any taxable year if such")
rule S988C1DiiiPartnershipElectionThisYear defeasible {
    for partnership: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when qualified_fund_election_in_effect_988c1EiiiV(partnership, y);
    then partnership_election_under_988c1EiiiV_applies(partnership, y);
}
@source(IRC_S988_C, relation = formalizes, coverage = exact, quote = "This subparagraph shall not apply to any income or loss of a partnership for any taxable year if such")
rule S988C1DiiiPartnershipElectionEarlierYear defeasible {
    for partnership: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when qualified_fund_election_from_earlier_year_988c1EiiiV(partnership, y);
    then partnership_election_under_988c1EiiiV_applies(partnership, y);
}
pub relation partner_interest_percent_988c1EiiiI(partnership: us.irc.core::Person, partner: us.irc.core::Person, y: us.irc.core::TaxableYear, percent: Decimal) kind empirical {
    label en official "the partner's interest in the capital or profits of the partnership, after the look-through of interests held by another partnership (clause (v)(IV)), the treatment of related persons as one (clause (vi)(I)) and the exclusion of incentive compensation (clause (v)(II)); the percentage is the larger of capital and profits";
}
pub relation general_partner_without_988_ordinary_income_or_loss_988c1EvI(partnership: us.irc.core::Person, partner: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the general partner (and each corporation filing a consolidated return with it) had no ordinary income or loss from a section 988 transaction which is foreign currency gain or loss for its taxable year in which the partnership year ends";
}
pub relation partner_income_from_partnership_not_taxed_988c1EvIII(partnership: us.irc.core::Person, partner: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "none of the partner's income from the partnership is subject to tax under this chapter (directly or through pass-through entities)";
}
pub relation partner_within_twenty_percent_requirement_988c1EiiiI(partnership: us.irc.core::Person, partner: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the partner's interest does not exceed 20 percent, or is treated as not failing the requirement (general partner without section 988 ordinary income or loss, clause (v)(I); partner whose income is not taxed under this chapter, clause (v)(III))";
}
@source(IRC_S988_C, relation = formalizes, coverage = exact, quote = "(I) at all times during the taxable year (and during each preceding taxable year to which an election under")
rule S988C1EiiiIPartnerAtMostTwentyPercent defeasible {
    for partnership: us.irc.core::Person;
    for partner: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for percent: Decimal;
    when partner_interest_percent_988c1EiiiI(partnership, partner, y, percent)
     and percent <= 20.0;
    then partner_within_twenty_percent_requirement_988c1EiiiI(partnership, partner, y);
}
@source(IRC_S988_C, relation = formalizes, coverage = exact, quote = "The interest of a general partner in the partnership shall not be treated as failing to meet the 20-percent")
rule S988C1EvIGeneralPartnerWithoutOrdinaryIncome defeasible {
    for partnership: us.irc.core::Person;
    for partner: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when general_partner_without_988_ordinary_income_or_loss_988c1EvI(partnership, partner, y);
    then partner_within_twenty_percent_requirement_988c1EiiiI(partnership, partner, y);
}
@source(IRC_S988_C, relation = formalizes, coverage = exact, quote = "Except as provided in regulations, the interest of a partner in the partnership shall not be treated as")
rule S988C1EvIIIPartnerIncomeNotTaxed defeasible {
    for partnership: us.irc.core::Person;
    for partner: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when partner_income_from_partnership_not_taxed_988c1EvIII(partnership, partner, y);
    then partner_within_twenty_percent_requirement_988c1EiiiI(partnership, partner, y);
}
pub relation partnership_partner_count_and_failures_988c1EiiiI(partnership: us.irc.core::Person, y: us.irc.core::TaxableYear, partners: Integer, partners_failing_20_percent: Integer) kind empirical {
    label en unofficial "the number of partners and the number of them that fail the 20-percent requirement after the adjustments (asserted directly: an aggregate over a derived relation, section 111)";
}
pub relation partnership_meets_partner_requirements_988c1EiiiI(partnership: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "at all times during the year the partnership has at least 20 partners and no single partner owns more than 20 percent of the interests in capital or profits";
}
@source(IRC_S988_C, relation = formalizes, coverage = exact, quote = "(I) at all times during the taxable year (and during each preceding taxable year to which an election under")
rule S988C1EiiiIPartnerRequirements defeasible {
    for partnership: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for partners: Integer;
    for failing: Integer;
    when partnership_partner_count_and_failures_988c1EiiiI(partnership, y, partners, failing)
     and partners >= 20
     and failing == 0;
    then partnership_meets_partner_requirements_988c1EiiiI(partnership, y);
}
pub relation principal_activity_commodity_options_futures_forwards_988c1EiiiII(partnership: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the principal activity of the partnership for the year (and each preceding year) consists of buying and selling options, futures or forwards with respect to commodities";
}
pub relation gross_income_percent_7704d1_or_capital_gain_988c1EiiiIII(partnership: us.irc.core::Person, y: us.irc.core::TaxableYear, percent: Decimal) kind empirical {
    label en official "the percentage of the partnership's gross income for the year (and each preceding year) that consisted of income or gains described in section 7704(d)(1)(A), (B) or (G) or gain from the sale of capital assets held for the production of interest or dividends";
}
pub relation commodity_trading_income_de_minimis_988c1EiiiIV(partnership: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "no more than a de minimis amount of the gross income of the partnership for the year (and each preceding year) was derived from buying and selling commodities (a section 988 debt instrument counts as a commodity, clause (vi)(IV)); de minimis is a necessary judgment supplied by the case";
}
pub relation qualified_fund_988c1Eiii(partnership: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "a qualified fund: a partnership with the required partners, principal activity, gross income mix, de minimis commodity income, and a subclause (V) election applying to the year";
}
@source(IRC_S988_C, relation = formalizes, coverage = exact, quote = "For purposes of this subparagraph, the term \"qualified fund\" means any partnership if—")
rule S988C1EiiiQualifiedFund defeasible {
    for partnership: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for income_percent: Decimal;
    when partnership_meets_partner_requirements_988c1EiiiI(partnership, y)
     and principal_activity_commodity_options_futures_forwards_988c1EiiiII(partnership, y)
     and gross_income_percent_7704d1_or_capital_gain_988c1EiiiIII(partnership, y, income_percent)
     and income_percent >= 90.0
     and commodity_trading_income_de_minimis_988c1EiiiIV(partnership, y)
     and partnership_election_under_988c1EiiiV_applies(partnership, y);
    then qualified_fund_988c1Eiii(partnership, y);
}
pub relation instrument_would_be_marked_to_market_under_1256_988c1Ei(partnership: us.irc.core::Person, item_id: Text, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the instrument would be marked to market under section 1256 if held on the last day of the taxable year (determined after the application of clause (iv))";
}
pub relation instrument_excluded_for_qualified_fund_988c1Ei(partnership: us.irc.core::Person, item_id: Text, y: us.irc.core::TaxableYear) kind institutional {
    label en official "for a qualified fund, clause (iii) of subparagraph (B) does not apply to an instrument that would be marked to market under section 1256";
}
@source(IRC_S988_C, relation = formalizes, coverage = exact, quote = "In the case of a qualified fund, clause (iii) of subparagraph (B) shall not apply to any instrument which")
rule S988C1EiQualifiedFundInstrumentsExcluded defeasible {
    for partnership: us.irc.core::Person;
    for item_id: Text;
    for y: us.irc.core::TaxableYear;
    when qualified_fund_988c1Eiii(partnership, y)
     and instrument_would_be_marked_to_market_under_1256_988c1Ei(partnership, item_id, y);
    then instrument_excluded_for_qualified_fund_988c1Ei(partnership, item_id, y);
}
pub relation net_loss_from_instruments_referred_in_988c1Ei(partnership: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the partnership has a net loss for the year from instruments referred to in clause (i)";
}
pub relation qualified_fund_rules_apply_to_loss_year_988c1Eii(partnership: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "where a partnership made a subclause (V) election for a year and has a net loss for that or a succeeding year from the instruments, clauses (i) and (iv) apply to the loss year whether or not it is a qualified fund for that year";
}
@source(IRC_S988_C, relation = formalizes, coverage = exact, quote = "If any partnership made an election under clause (iii)(V) for any taxable year and such partnership has a net")
rule S988C1EiiLossYearWhetherOrNotQualifiedFund defeasible {
    for partnership: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when partnership_election_under_988c1EiiiV_applies(partnership, y)
     and net_loss_from_instruments_referred_in_988c1Ei(partnership, y);
    then qualified_fund_rules_apply_to_loss_year_988c1Eii(partnership, y);
}
pub relation bank_forward_or_foreign_exchange_currency_future_988c1Eiv(partnership: us.irc.core::Person, item_id: Text) kind empirical {
    label en official "the instrument is a bank forward contract, a foreign currency futures contract traded on a foreign exchange, or (to the extent regulations provide) a similar instrument, not otherwise a section 1256 contract";
}
pub relation treated_as_1256_contract_for_qualified_fund_988c1Eiv(partnership: us.irc.core::Person, item_id: Text, y: us.irc.core::TaxableYear) kind institutional {
    label en official "for a qualified fund (or a loss year under clause (ii)) the instrument is treated as a section 1256 contract for purposes of section 1256; regulations may provide otherwise";
}
@source(IRC_S988_C, relation = formalizes, coverage = exact, quote = "Except as provided in regulations, in the case of a qualified fund, any bank forward contract, any foreign")
rule S988C1EivIQualifiedFundInstrumentAsSection1256 defeasible {
    for partnership: us.irc.core::Person;
    for item_id: Text;
    for y: us.irc.core::TaxableYear;
    when qualified_fund_988c1Eiii(partnership, y)
     and bank_forward_or_foreign_exchange_currency_future_988c1Eiv(partnership, item_id);
    then treated_as_1256_contract_for_qualified_fund_988c1Eiv(partnership, item_id, y);
}
@source(IRC_S988_C, relation = formalizes, coverage = exact, quote = "Except as provided in regulations, in the case of a qualified fund, any bank forward contract, any foreign")
rule S988C1EivILossYearInstrumentAsSection1256 defeasible {
    for partnership: us.irc.core::Person;
    for item_id: Text;
    for y: us.irc.core::TaxableYear;
    when qualified_fund_rules_apply_to_loss_year_988c1Eii(partnership, y)
     and bank_forward_or_foreign_exchange_currency_future_988c1Eiv(partnership, item_id);
    then treated_as_1256_contract_for_qualified_fund_988c1Eiv(partnership, item_id, y);
}
pub relation section_1256a3_hundred_percent_substitution_988c1EivII(partnership: us.irc.core::Person, item_id: Text, y: us.irc.core::TaxableYear) kind institutional {
    label en official "for an instrument treated as a section 1256 contract under subclause (I), 100 percent is substituted for 40 percent in section 1256(a)(3)(A) and section 1256(a)(3)(B) does not apply";
}
@source(IRC_S988_C, relation = formalizes, coverage = exact, quote = "In the case of any instrument treated as a section 1256 contract under subclause (I), subparagraph (A) of")
rule S988C1EivIISubstitutionOfHundredPercent defeasible {
    for partnership: us.irc.core::Person;
    for item_id: Text;
    for y: us.irc.core::TaxableYear;
    when treated_as_1256_contract_for_qualified_fund_988c1Eiv(partnership, item_id, y);
    then section_1256a3_hundred_percent_substitution_988c1EivII(partnership, item_id, y);
}
pub relation section_988_debt_instrument_treated_as_commodity_988c1EviIV(item_id: Text) kind institutional {
    label en official "for clause (iii)(IV) a debt instrument which is a section 988 transaction is treated as a commodity";
}
@source(IRC_S988_C, relation = formalizes, coverage = exact, quote = "For purposes of clause (iii)(IV), any debt instrument which is a section 988 transaction shall be treated as")
rule S988C1EviIVDebtInstrumentIsCommodity defeasible {
    for item_id: Text;
    when debt_instrument_acquired_or_issued(item_id)
     and section_988_transaction(item_id);
    then section_988_debt_instrument_treated_as_commodity_988c1EviIV(item_id);
}

// --- the cut-back of the forward/futures/option limb of (c)(1)(B)(iii) --------------------------------------------------

pub relation excluded_from_988c1Biii(item_id: Text) kind institutional {
    label en official "the forward, futures or option instrument is excluded from clause (iii) of subparagraph (B) by subparagraph (D)(i) (section 1256 contract, no election out) or subparagraph (E)(i) (qualified fund)";
}
rule S988C1BiiiExcludedByD defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    for y: us.irc.core::TaxableYear;
    when exception_988c1Di_applies(p, item_id, y);
    then excluded_from_988c1Biii(item_id);
}
rule S988C1BiiiExcludedByE defeasible {
    for partnership: us.irc.core::Person;
    for item_id: Text;
    for y: us.irc.core::TaxableYear;
    when instrument_excluded_for_qualified_fund_988c1Ei(partnership, item_id, y);
    then excluded_from_988c1Biii(item_id);
}

// --- §988(c)(5): delivery ------------------------------------------------------------------------------------------------------

pub relation delivery_taken_or_made_988c5(item_id: Text) kind empirical {
    label en official "the taxpayer takes or makes delivery in connection with a section 988 transaction described in paragraph (1)(B)(iii)";
}
pub relation fair_market_value_on_delivery_date_988c5(item_id: Text, amount: Money) kind empirical {
    label en official "the fair market value of the contract, option or instrument on the date delivery is taken or made";
}
pub relation adjusted_basis_on_delivery_date_988c5(item_id: Text, amount: Money) kind empirical {
    label en official "the taxpayer's adjusted basis in the contract, option or instrument";
}
pub relation gain_or_loss_recognized_on_delivery_988c5(item_id: Text, amount: Money) kind institutional {
    label en official "gain (positive) or loss (negative) determined as if the taxpayer sold the contract, option or instrument for its fair market value on the delivery date, recognized as if it were so sold";
}
@source(IRC_S988_C, relation = formalizes, coverage = exact, quote = "If the taxpayer takes or makes delivery in connection with any section 988 transaction described in paragraph")
rule S988C5DeliveryTreatedAsSale defeasible {
    for item_id: Text;
    for fmv: Money;
    for basis: Money;
    when delivery_taken_or_made_988c5(item_id)
     and forward_futures_option_entered_into(item_id)
     and section_988_transaction(item_id)
     and fair_market_value_on_delivery_date_988c5(item_id, fmv)
     and adjusted_basis_on_delivery_date_988c5(item_id, basis);
    then gain_or_loss_recognized_on_delivery_988c5(item_id, fmv - basis);
}

// --- §988(a)(3): residence-based source --------------------------------------------------------------------------------------

pub relation individual_tax_home_country_is_united_states_988a3BiI(p: us.irc.core::Individual) kind empirical {
    label en official "the country in which the individual's tax home (section 911(d)(3)) is located is the United States";
}
pub relation individual_tax_home_country_is_foreign_988a3BiI(p: us.irc.core::Individual) kind empirical {
    label en official "the country in which the individual's tax home (section 911(d)(3)) is located is a country other than the United States";
}
pub relation individual_has_no_tax_home_988a3Bi(p: us.irc.core::Individual) kind empirical {
    label en official "the individual does not have a tax home (section 911(d)(3))";
}
pub relation individual_is_us_citizen_or_resident_alien_988a3Bi(p: us.irc.core::Individual) kind empirical {
    label en official "the individual is a United States citizen or a resident alien";
}
pub relation entity_is_united_states_person_988a3BiII(p: us.irc.core::Person) kind empirical {
    label en official "the corporation, partnership, trust or estate is a United States person (section 7701(a)(30))";
}
pub relation entity_is_not_united_states_person_988a3BiIII(p: us.irc.core::Person) kind empirical {
    label en official "the corporation, partnership, trust or estate is not a United States person";
}
pub relation qbu_principal_place_of_business_in_united_states_988a3Bii(qbu: us.irc.core::Person) kind empirical {
    label en official "the principal place of business of the qualified business unit is in the United States";
}
pub relation qbu_principal_place_of_business_outside_united_states_988a3Bii(qbu: us.irc.core::Person) kind empirical {
    label en official "the principal place of business of the qualified business unit is in a country other than the United States";
}
pub relation residence_of_person_988a3B(p: us.irc.core::Person, residence: Text) kind institutional {
    label en official "the residence of the person for this subpart: 'united_states' or 'foreign' (a country other than the United States); the residence of a qualified business unit is the country of its principal place of business";
}
@source(IRC_S988_A, relation = formalizes, coverage = exact, quote = "(I) in the case of an individual, the country in which such individual's tax home (as defined in section")
rule S988A3BiIndividualTaxHomeUnitedStates defeasible {
    for p: us.irc.core::Individual;
    when individual_tax_home_country_is_united_states_988a3BiI(p);
    then residence_of_person_988a3B(p, "united_states");
}
@source(IRC_S988_A, relation = formalizes, coverage = exact, quote = "(I) in the case of an individual, the country in which such individual's tax home (as defined in section")
rule S988A3BiIndividualTaxHomeForeign defeasible {
    for p: us.irc.core::Individual;
    when individual_tax_home_country_is_foreign_988a3BiI(p);
    then residence_of_person_988a3B(p, "foreign");
}
@source(IRC_S988_A, relation = formalizes, coverage = exact, quote = "If an individual does not have a tax home (as so defined), the residence of such individual shall be the")
rule S988A3BiNoTaxHomeCitizenOrResidentAlien defeasible {
    for p: us.irc.core::Individual;
    when individual_has_no_tax_home_988a3Bi(p)
     and individual_is_us_citizen_or_resident_alien_988a3Bi(p);
    then residence_of_person_988a3B(p, "united_states");
}
@source(IRC_S988_A, relation = formalizes, coverage = exact, quote = "If an individual does not have a tax home (as so defined), the residence of such individual shall be the")
rule S988A3BiNoTaxHomeNonresidentAlien defeasible {
    for p: us.irc.core::Individual;
    when individual_has_no_tax_home_988a3Bi(p);
    unless individual_is_us_citizen_or_resident_alien_988a3Bi(p)
     and individual_has_no_tax_home_988a3Bi(p);
    then residence_of_person_988a3B(p, "foreign");
}
@source(IRC_S988_A, relation = formalizes, coverage = exact, quote = "(II) in the case of any corporation, partnership, trust, or estate which is a United States person (as")
rule S988A3BiIIUnitedStatesPersonEntity defeasible {
    for p: us.irc.core::Person;
    when entity_is_united_states_person_988a3BiII(p);
    then residence_of_person_988a3B(p, "united_states");
}
@source(IRC_S988_A, relation = formalizes, coverage = exact, quote = "(III) in the case of any corporation, partnership, trust, or estate which is not a United States person, a")
rule S988A3BiIIIForeignPersonEntity defeasible {
    for p: us.irc.core::Person;
    when entity_is_not_united_states_person_988a3BiIII(p);
    then residence_of_person_988a3B(p, "foreign");
}
@source(IRC_S988_A, relation = formalizes, coverage = exact, quote = "In the case of a qualified business unit of any taxpayer (including an individual), the residence of such")
rule S988A3BiiQbuPrincipalPlaceUnitedStates defeasible {
    for qbu: us.irc.core::Person;
    when qbu_principal_place_of_business_in_united_states_988a3Bii(qbu);
    then residence_of_person_988a3B(qbu, "united_states");
}
@source(IRC_S988_A, relation = formalizes, coverage = exact, quote = "In the case of a qualified business unit of any taxpayer (including an individual), the residence of such")
rule S988A3BiiQbuPrincipalPlaceForeign defeasible {
    for qbu: us.irc.core::Person;
    when qbu_principal_place_of_business_outside_united_states_988a3Bii(qbu);
    then residence_of_person_988a3B(qbu, "foreign");
}
pub relation books_on_which_988_item_is_reflected_988a3A(item_id: Text, holder: us.irc.core::Person) kind empirical {
    label en official "the taxpayer or the qualified business unit of the taxpayer on whose books the asset, liability, or item of income or expense is properly reflected";
}
pub relation regulations_determine_988_source_otherwise_988a3A(item_id: Text) kind empirical {
    label en official "regulations provide a different source rule for the item";
}
pub relation source_of_section_988_amount_988a3A(item_id: Text, source_country: Text) kind institutional {
    label en official "the source of the amount treated as ordinary income or loss under paragraph (1) (without regard to (1)(B)): the residence of the taxpayer or qualified business unit on whose books the item is reflected; 'united_states' or 'foreign'";
}
@source(IRC_S988_A, relation = formalizes, coverage = exact, quote = "Except as otherwise provided in regulations, in the case of any amount treated as ordinary income or loss")
rule S988A3ASourceByResidenceUnitedStates defeasible {
    for item_id: Text;
    for holder: us.irc.core::Person;
    for amount: Money;
    when section_988_transaction(item_id)
     and section_988_gain_or_loss(item_id, amount)
     and books_on_which_988_item_is_reflected_988a3A(item_id, holder)
     and residence_of_person_988a3B(holder, "united_states");
    unless regulations_determine_988_source_otherwise_988a3A(item_id)
     and section_988_transaction(item_id);
    then source_of_section_988_amount_988a3A(item_id, "united_states");
}
@source(IRC_S988_A, relation = formalizes, coverage = exact, quote = "Except as otherwise provided in regulations, in the case of any amount treated as ordinary income or loss")
rule S988A3ASourceByResidenceForeign defeasible {
    for item_id: Text;
    for holder: us.irc.core::Person;
    for amount: Money;
    when section_988_transaction(item_id)
     and section_988_gain_or_loss(item_id, amount)
     and books_on_which_988_item_is_reflected_988a3A(item_id, holder)
     and residence_of_person_988a3B(holder, "foreign");
    unless regulations_determine_988_source_otherwise_988a3A(item_id)
     and section_988_transaction(item_id);
    then source_of_section_988_amount_988a3A(item_id, "foreign");
}
pub relation us_person_voting_percent_of_foreign_corporation_988a3D(us_person: us.irc.core::Person, corp: us.irc.core::Corporation, percent: Decimal) kind empirical {
    label en official "the percentage of the voting stock of the foreign corporation the United States person owns directly or indirectly";
}
pub relation ten_percent_owned_foreign_corporation_988a3D(us_person: us.irc.core::Person, corp: us.irc.core::Corporation) kind institutional {
    label en official "a foreign corporation in which the United States person owns directly or indirectly at least 10 percent of the voting stock";
}
@source(IRC_S988_A, relation = formalizes, coverage = exact, quote = "The term \"10-percent owned foreign corporation\" means any foreign corporation in which the United States")
rule S988A3DTenPercentOwnedForeignCorporation defeasible {
    for us_person: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for percent: Decimal;
    when us_person_voting_percent_of_foreign_corporation_988a3D(us_person, corp, percent)
     and percent >= 10.0;
    then ten_percent_owned_foreign_corporation_988a3D(us_person, corp);
}
pub relation loan_to_foreign_corporation_988a3C(loan_id: Text, lender: us.irc.core::Person, corp: us.irc.core::Corporation) kind empirical {
    label en official "a loan by a United States person, or a related person (section 954(d)(3) with United States person substituted for controlled foreign corporation), to the foreign corporation";
}
pub relation loan_denominated_in_nonfunctional_currency_988a3C(loan_id: Text) kind empirical {
    label en official "the loan is denominated in a currency other than the dollar";
}
pub relation loan_interest_rate_988a3C(loan_id: Text, rate: Decimal) kind empirical {
    label en official "the interest rate of the loan (a fraction: 0.12 is 12 percent)";
}
pub relation federal_mid_term_rate_at_loan_date_988a3C(loan_id: Text, rate: Decimal) kind empirical {
    label en official "the Federal mid-term rate under section 1274(d) at the time the loan is entered into (a fraction)";
}
pub relation regulations_except_loan_from_988a3C(loan_id: Text) kind empirical {
    label en official "regulations except the loan from the special rule";
}
pub relation loan_subject_to_988a3C(loan_id: Text) kind institutional {
    label en official "the loan is within the related-party loan rule: to a 10-percent owned foreign corporation, nondollar, bearing interest at least 10 percentage points above the Federal mid-term rate at origination";
}
@source(IRC_S988_A, relation = formalizes, coverage = exact, quote = "Except to the extent provided in regulations, in the case of a loan by a United States person or a related")
rule S988A3CLoanWithinSpecialRule defeasible {
    for loan_id: Text;
    for lender: us.irc.core::Person;
    for us_person: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for rate: Decimal;
    for mid: Decimal;
    when loan_to_foreign_corporation_988a3C(loan_id, lender, corp)
     and ten_percent_owned_foreign_corporation_988a3D(us_person, corp)
     and loan_denominated_in_nonfunctional_currency_988a3C(loan_id)
     and loan_interest_rate_988a3C(loan_id, rate)
     and federal_mid_term_rate_at_loan_date_988a3C(loan_id, mid)
     and (rate - mid) >= 0.10;
    unless regulations_except_loan_from_988a3C(loan_id)
     and loan_to_foreign_corporation_988a3C(loan_id, lender, corp)
     and ten_percent_owned_foreign_corporation_988a3D(us_person, corp)
     and loan_denominated_in_nonfunctional_currency_988a3C(loan_id)
     and loan_interest_rate_988a3C(loan_id, rate)
     and federal_mid_term_rate_at_loan_date_988a3C(loan_id, mid);
    then loan_subject_to_988a3C(loan_id);
}
pub relation loan_marked_to_market_for_section_904_988a3Ci(loan_id: Text) kind institutional {
    label en official "for purposes of section 904 only, the loan is marked to market on an annual basis";
}
@source(IRC_S988_A, relation = formalizes, coverage = exact, quote = "(i) For purposes of section 904 only, such loan shall be marked to market on an annual basis.")
rule S988A3CiMarkedToMarketForSection904 defeasible {
    for loan_id: Text;
    when loan_subject_to_988a3C(loan_id);
    then loan_marked_to_market_for_section_904_988a3Ci(loan_id);
}
pub relation interest_income_on_loan_for_year_988a3Cii(loan_id: Text, amount: Money) kind empirical {
    label en official "the interest income earned with respect to the loan for the taxable year";
}
pub relation loss_attributable_to_annual_mark_to_market_988a3Cii(loan_id: Text, loss: Money) kind empirical {
    label en official "the loss attributable to the annual mark to market of clause (i), as a positive amount";
}
pub relation interest_income_treated_as_us_source_988a3Cii(loan_id: Text, amount: Money) kind institutional {
    label en official "the interest income is treated as income from sources within the United States to the extent of the loss attributable to clause (i)";
}
@source(IRC_S988_A, relation = formalizes, coverage = exact, quote = "(ii) Any interest income earned with respect to such loan for the taxable year shall be treated as income")
rule S988A3CiiInterestUsSourceToExtentOfLoss defeasible {
    for loan_id: Text;
    for interest: Money;
    for loss: Money;
    when loan_subject_to_988a3C(loan_id)
     and interest_income_on_loan_for_year_988a3Cii(loan_id, interest)
     and loss_attributable_to_annual_mark_to_market_988a3Cii(loan_id, loss)
     and loss > 0.00 USD;
    then interest_income_treated_as_us_source_988a3Cii(loan_id, min(interest, loss));
}
