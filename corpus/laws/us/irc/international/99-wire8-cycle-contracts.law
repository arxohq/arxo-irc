// International -- WIRE-8 (26.09.2026, DECISION-0379 Д-22 item (б), implemented_unverified).
//
// The lower package `corporations` (section 532(b)(3)) declares a local contract for "the corporation is a passive foreign investment
// company as defined in section 1297" and cannot import this package (this package imports `corporations`; a direct import back would
// be an import cycle). The owner of section 1297 DERIVES the lower package's `pub` relation from its own classification with a
// qualified rule head (Д-13 item 5). The case-fact channel stays valid: scenarios of `corporations` never load this package.

language "law.core" version "0.2";
package us.irc.international version "0.1.1";
namespace "urn:us:irc:international:clir";

use self::{
    foreign_tax_credit_allowed,
    passive_foreign_investment_company,
    relinquishment_date_877ag4,
};

rule W8PassiveForeignInvestmentCompanyForSection532(c: us.irc.core::Corporation, y: us.irc.core::TaxableYear) strict {
    label en official "section 532(b)(3): a corporation that is a passive foreign investment company as defined in section 1297 is this package's section 1297(a) passive foreign investment company";
    when passive_foreign_investment_company(c, y);
    then us.irc.corporations::passive_foreign_investment_company_1297(c, y);
}

// --- section 27(a) / section 877A(g)(4): contracts of the lower packages `income_individual` and `definitions` -----------------------
// This package gains a direct import of `income_individual` (acyclic: `income_individual` reaches only `core`, `inflation_adjustments`,
// `temporal`). `definitions` was already imported.

rule W8ForeignTaxCreditAllowableForAmt(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) strict {
    label en official "section 55(c)(1): the foreign tax credit allowable under section 27(a) is this package's foreign tax credit finally allowed under sections 901 and 904";
    when foreign_tax_credit_allowed(p, y, amount);
    then us.irc.income_individual::foreign_tax_credit_allowable_27a(p, y, amount);
}

rule W8CitizenshipRelinquishedDateForSection7701(p: us.irc.core::Individual, on: Date) strict {
    label en official "section 7701(a)(50)(A): the date on which citizenship is treated as relinquished under section 877A(g)(4) is this package's relinquishment date";
    when relinquishment_date_877ag4(p, on);
    then us.irc.definitions::citizenship_treated_as_relinquished_under_877a_g4_on(p, on);
}
