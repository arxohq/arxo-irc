// §884(a)-(d),(f) — branch profits tax. Stage 2b (IRC-10 stage 2b, A13).
// Modeled: (a) imposition (30% of the dividend equivalent amount, in
// addition to the section 882 tax); (b) the full dividend equivalent
// amount computation with BOTH directions — (1) reduction for an increase
// in US net equity (floored at zero) and (2)(A)-(B) increase for a
// decrease in net equity (capped at accumulated ECEP); (c)(1) US net
// equity as US assets minus US liabilities (US assets and liabilities
// themselves are case-asserted, since their own derivation is a Secretary-
// regulation apportionment, EXTERNAL_DEPENDENCY, per (c)(2)); (d)(1) the
// "effectively connected earnings and profits" definition, with the (d)(2)
// exclusions folded into one case-asserted flag; (f)(1)-(2) the interest-
// reallocation rule (interest paid by the US trade or business treated as
// paid by a domestic corporation, and excess allocable interest taxed
// under section 881(a)).
//
// NOT modeled this stage: (e) treaty coordination (qualified-resident
// test, rate substitution, withholding coordination) — EXTERNAL_DEPENDENCY,
// treaty text this package never invents, per AGENT-BRIEF.md; (f)(3)
// treaty-coordination for allocable interest — same EXTERNAL_DEPENDENCY;
// (g) regulations — NON_NORMATIVE delegated rulemaking.

// --- (d)(1)-(2): effectively connected earnings and profits ---------------

use self::{
    IRC_S884_A,
    IRC_S884_B,
    IRC_S884_C,
    IRC_S884_D,
    IRC_S884_F,
    foreign_corp_fdap_tax,
};

pub relation ecep_before_exceptions(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the foreign corporation's earnings and profits (without diminution for distributions) attributable to income effectively connected (or treated as effectively connected) with a US trade or business, before the section 884(d)(2) exceptions — for section 884(d)(1)";
}
pub relation ecep_884d2_excepted_income(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "earnings and profits attributable to the five section 884(d)(2)(A)-(E) excepted income categories (section 883(a) exempt shipping/aircraft income, the repealed FSC/ETI sections 921(d)/926(b), section 897(c)(1)(A)(ii) USRPI gain, section 953(c)(3)(C), and section 882(e)) — folded into one case-asserted amount rather than five independently derived exceptions";
}
@source(IRC_S884_D, relation = formalizes, coverage = partial, quote = "means earnings and profits (without diminution by reason of any distributions made during the taxable year) which are attributable to income which is effectively connected (or treated as effectively connected) with the conduct of a trade or business within the United States")
pub relation effectively_connected_earnings_and_profits(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the foreign corporation's effectively connected earnings and profits for the taxable year (section 884(d)): ECEP before exceptions, less the amount attributable to the five section 884(d)(2) excepted income categories";
}
rule S884D1EcepNetOfExceptions defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for before: Money;
    for excepted: Money;
    when ecep_before_exceptions(corp, y, before)
     and ecep_884d2_excepted_income(corp, y, excepted);
    then effectively_connected_earnings_and_profits(corp, y, before - excepted);
}

// --- (c)(1): U.S. net equity ------------------------------------------------

pub relation us_assets(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the money and aggregate adjusted bases of property of the foreign corporation treated as connected with a US trade or business under Secretary regulations, for section 884(c)(2)(A) — EXTERNAL_DEPENDENCY (the regulatory connection test is asserted directly, not derived)";
}
pub relation us_liabilities(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the liabilities of the foreign corporation treated as connected with a US trade or business under Secretary regulations, for section 884(c)(2)(B) — EXTERNAL_DEPENDENCY";
}
@source(IRC_S884_C, relation = formalizes, coverage = exact, quote = "U.S. assets, reduced (including below zero) by\n(B) U.S. liabilities.")
pub relation us_net_equity(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the foreign corporation's U.S. net equity for the taxable year (section 884(c)(1)): U.S. assets reduced by U.S. liabilities — the reduction is expressly allowed to go below zero";
}
rule S884C1UsNetEquity strict {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for assets: Money;
    for liabilities: Money;
    when us_assets(corp, y, assets)
     and us_liabilities(corp, y, liabilities);
    then us_net_equity(corp, y, assets - liabilities);
}

// --- (b): dividend equivalent amount ---------------------------------------

pub relation us_net_equity_preceding_year(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the foreign corporation's U.S. net equity as of the close of the taxable year preceding y, for section 884(b)(1)/(2) — a separate empirical input from `us_net_equity(corp, prior_y, ...)` to avoid a self-referential year-over-year recursion (TECH-GAPS G330 class avoided per AGENT-BRIEF.md's carryover-window convention)";
}
pub relation accumulated_ecep_preceding_year(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the section 884(b)(2)(B)(ii) accumulated effectively connected earnings and profits as of the close of the taxable year preceding y (aggregate ECEP for post-1986 preceding years minus aggregate prior dividend equivalent amounts) — asserted directly as a case fact rather than an unbounded running total (TECH-GAPS G330)";
}
@source(IRC_S884_B, relation = formalizes, coverage = partial, quote = "the effectively connected earnings and profits for the taxable year shall be reduced (but not below zero) by the amount of such excess")
pub relation dividend_equivalent_amount(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the section 884(b) dividend equivalent amount: effectively connected earnings and profits for the taxable year, reduced (not below zero) by an increase in U.S. net equity during the year, or increased (capped at accumulated ECEP) by a decrease in U.S. net equity during the year";
}
rule S884B1ReductionForIncreaseInNetEquity defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for ecep: Money;
    for equity_now: Money;
    for equity_prior: Money;
    when effectively_connected_earnings_and_profits(corp, y, ecep)
     and us_net_equity(corp, y, equity_now)
     and us_net_equity_preceding_year(corp, y, equity_prior)
     and equity_now > equity_prior;
    then dividend_equivalent_amount(corp, y, max(0.00 USD, ecep - (equity_now - equity_prior)));
}
rule S884B2IncreaseForDecreaseInNetEquity defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for ecep: Money;
    for equity_now: Money;
    for equity_prior: Money;
    for accumulated: Money;
    when effectively_connected_earnings_and_profits(corp, y, ecep)
     and us_net_equity(corp, y, equity_now)
     and us_net_equity_preceding_year(corp, y, equity_prior)
     and accumulated_ecep_preceding_year(corp, y, accumulated)
     and equity_prior > equity_now;
    then dividend_equivalent_amount(corp, y, ecep + min(equity_prior - equity_now, accumulated));
}
rule S884B0NoChangeInNetEquity defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for ecep: Money;
    for equity_now: Money;
    for equity_prior: Money;
    when effectively_connected_earnings_and_profits(corp, y, ecep)
     and us_net_equity(corp, y, equity_now)
     and us_net_equity_preceding_year(corp, y, equity_prior)
     and equity_now == equity_prior;
    then dividend_equivalent_amount(corp, y, ecep);
}

// --- (a): imposition of tax -------------------------------------------------

@source(IRC_S884_A, relation = formalizes, coverage = exact, quote = "there is hereby imposed on any foreign corporation a tax equal to 30 percent of the dividend equivalent amount for the taxable year")
pub relation branch_profits_tax(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, tax: Money) kind institutional {
    label en official "the section 884(a) branch profits tax: 30 percent of the dividend equivalent amount for the taxable year, in addition to the section 882 tax on the foreign corporation's effectively connected income";
}
rule S884ABranchProfitsTax defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for dea: Money;
    when dividend_equivalent_amount(corp, y, dea)
     and dea > 0.00 USD;
    then branch_profits_tax(corp, y, round(dea * 0.30, 2, "HALF_UP"));
}

// --- (f)(1)-(2): treatment of interest allocable to ECI --------------------

pub relation allocable_interest_884f(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "interest allocable to income effectively connected (or treated as effectively connected) with a US trade or business, per section 884(f)(2)";
}
pub relation interest_paid_by_us_trade_or_business(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "interest actually paid by the foreign corporation's US trade or business during the taxable year, for section 884(f)(1)(A)";
}
@source(IRC_S884_F, relation = formalizes, coverage = exact, quote = "any interest paid by such trade or business in the United States shall be treated as if it were paid by a domestic corporation")
pub relation interest_treated_as_paid_by_domestic_corporation(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "interest paid by the foreign corporation's US trade or business is treated, for subtitle A purposes, as if paid by a domestic corporation (section 884(f)(1)(A))";
}
rule S884F1ATreatedAsDomesticCorporationInterest strict {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for paid: Money;
    when interest_paid_by_us_trade_or_business(corp, y, paid);
    then interest_treated_as_paid_by_domestic_corporation(corp, y, paid);
}
@source(IRC_S884_F, relation = formalizes, coverage = partial, quote = "to the extent that the allocable interest exceeds the interest described in subparagraph (A), such foreign corporation shall be liable for tax under section 881(a) in the same manner as if such excess were interest paid to such foreign corporation by a wholly owned domestic corporation on the last day of such foreign corporation's taxable year")
pub relation excess_allocable_interest_884f1b(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the section 884(f)(1)(B) excess of allocable interest over the interest actually paid by the US trade or business, deemed paid to the foreign corporation by a wholly owned domestic corporation for section 881(a) purposes";
}
rule S884F1BExcessAllocableInterest defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for allocable: Money;
    for paid: Money;
    when allocable_interest_884f(corp, y, allocable)
     and interest_paid_by_us_trade_or_business(corp, y, paid)
     and allocable > paid;
    then excess_allocable_interest_884f1b(corp, y, allocable - paid);
}
rule S884F1BExcessSubjectToEightyOnePercentTax defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for excess: Money;
    when excess_allocable_interest_884f1b(corp, y, excess);
    then foreign_corp_fdap_tax(corp, excess, round(excess * 0.30, 2, "HALF_UP"));
}
