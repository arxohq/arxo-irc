}
@source(IRC_S1296_F, relation = formalizes, coverage = exact, quote = "(B) any amount allowed as a deduction under subsection (a)(2) shall be treated as a deduction allocable to")
rule S1296F2BDeductionAllocableToFphci defeasible {
    for cfc: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when mtm_deduction_of_cfc_1296f2B(cfc, y, amount);
    then deduction_allocable_to_fphci_1296f2B(cfc, y, amount);
}
pub relation disposition_resulting_in_no_longer_owning_1296g2A(p: us.irc.core::Person, share_id: Text) kind empirical {
    label en official "a disposition by the United States person or any other person which results in the United States person being treated as no longer owning the stock";
}
pub relation disposition_by_person_owning_stock_1296g2B(p: us.irc.core::Person, share_id: Text) kind empirical {
    label en official "a disposition by the person owning the stock";
}
pub relation treated_as_disposition_by_united_states_person_1296g2(p: us.irc.core::Person, share_id: Text) kind institutional {
    label en official "the disposition is treated as a disposition by the United States person of the stock in the passive foreign investment company";
}
@source(IRC_S1296_G, relation = formalizes, coverage = exact, quote = "(A) any disposition by the United States person or by any other person which results in the United States")
rule S1296G2ADispositionResultingInNoLongerOwning defeasible {
    for p: us.irc.core::Person;
    for share_id: Text;
    when considered_owner_of_pfic_stock_1296g1(p, share_id)
     and disposition_resulting_in_no_longer_owning_1296g2A(p, share_id);
    then treated_as_disposition_by_united_states_person_1296g2(p, share_id);
}
@source(IRC_S1296_G, relation = formalizes, coverage = exact, quote = "(B) any disposition by the person owning such stock,")
rule S1296G2BDispositionByOwner defeasible {
    for p: us.irc.core::Person;
    for share_id: Text;
    when considered_owner_of_pfic_stock_1296g1(p, share_id)
     and disposition_by_person_owning_stock_1296g2B(p, share_id);
    then treated_as_disposition_by_united_states_person_1296g2(p, share_id);
}
pub relation section_1296_inclusion_treated_as_dividend_for_851b2_1296h(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
