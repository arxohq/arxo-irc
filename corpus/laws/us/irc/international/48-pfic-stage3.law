}
@source(IRC_S1296_B, relation = formalizes, coverage = exact, quote = "(B) similar adjustments shall be made to the adjusted basis of the property by reason of which the United")
rule S1296B2BSimilarAdjustmentToProperty defeasible {
    for p: us.irc.core::Person;
    for share_id: Text;
    for holder: us.irc.core::Person;
    for inclusion: Money;
    when basis_adjustment_of_constructively_owned_stock_1296b2(p, share_id, holder, inclusion);
    then property_basis_adjusted_by_reason_of_constructive_ownership_1296b2B(p, share_id, inclusion);
}
pub relation loss_on_disposition_of_marketable_pfic_stock_1296c1Bii(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, loss: Money) kind empirical {
    label en official "the loss on the sale or other disposition of marketable stock in the company, with respect to which a section 1296 election is in effect";
}
pub relation ordinary_loss_under_1296c1B(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the deduction allowed under subsection (a)(2) and the disposition loss (not above the unreversed inclusions) are treated as an ordinary loss, a deduction allowable in computing adjusted gross income";
}
@source(IRC_S1296_C, relation = formalizes, coverage = exact, quote = "shall be treated as an ordinary loss. The amount so treated shall be treated as a deduction allowable in")
rule S1296C1BOrdinaryLoss defeasible {
    for p: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for deduction: Money;
    for loss: Money;
    for unreversed: Money;
    when mtm_deduction_1296a2(p, corp, y, deduction)
     and loss_on_disposition_of_marketable_pfic_stock_1296c1Bii(p, corp, y, loss)
     and unreversed_inclusions_1296d(p, corp, y, unreversed);
    then ordinary_loss_under_1296c1B(p, corp, y, deduction + min(loss, unreversed));
}
pub relation source_of_gain_or_loss_from_sale_of_pfic_stock_1296c2(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, source_country: Text) kind empirical {
    label en official "the source ('united_states' or 'foreign') the gain or loss from a sale of stock in the company would have (sections 861-865)";
}
pub relation source_of_section_1296_amount_1296c2(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, source_country: Text) kind institutional {
    label en official "the source of an amount included under subsection (a)(1) (or allowed under (a)(2)) is determined as if the amount were gain or loss from the sale of the stock";
}
@source(IRC_S1296_C, relation = formalizes, coverage = exact, quote = "The source of any amount included in gross income under subsection (a)(1) (or allowed as a deduction under")
rule S1296C2SourceAsIfStockSale defeasible {
    for p: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for source_country: Text;
    when mtm_inclusion_1296a1(p, corp, y, _)
     and source_of_gain_or_loss_from_sale_of_pfic_stock_1296c2(p, corp, y, source_country);
    then source_of_section_1296_amount_1296c2(p, corp, y, source_country);
}
pub relation mtm_deduction_of_cfc_1296f2B(cfc: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "an amount allowed as a deduction to the controlled foreign corporation under subsection (a)(2)";
}
pub relation deduction_allocable_to_fphci_1296f2B(cfc: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
