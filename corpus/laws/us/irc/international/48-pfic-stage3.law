// Stage 3 (TECH_GAP reduction), module 48: PFIC remainder: section 1291(a)(1), (b)(2), (c), (d)(2), (g); 1293(d), (f); 1294(c), (e);
// 1295(b)(2); 1296(b)(2), (c), (f), (g), (h), (i), (j)(2); 1297(b)(2), (d), (e)(2), (f)(3); 1298(a), (b), (d), (e).
// Status implemented_unverified: not a legal review; scenarios in tests/pfic-stage3.lawtest are written, NOT executed.
//
// Modeling notes.
//  * The section 1291(a)(1)(A) day allocation is derived from per-year day counts (case facts) and the total holding days,
//    not from a day-by-day ledger; the interest under section 6621 (rates by quarter) stays an external input.
//  * "Stock considered as actually owned" (1298(a)(5)) would need recursion; one attribution step is derived in module 28.

// --- §1291(a)(1)(A)-(B): ratable allocation over the holding period ------------------------------------------------------

use self::{
    IRC_S1291_A,
    IRC_S1291_B,
    IRC_S1291_C,
    IRC_S1291_D,
    IRC_S1291_G,
    IRC_S1293_D,
    IRC_S1293_F,
    IRC_S1294_C,
    IRC_S1294_E,
    IRC_S1295_B,
    IRC_S1296_B,
    IRC_S1296_C,
    IRC_S1296_F,
    IRC_S1296_G,
    IRC_S1296_H,
    IRC_S1296_I,
    IRC_S1296_J,
    IRC_S1297_B,
    IRC_S1297_D,
    IRC_S1297_E,
    IRC_S1297_F,
    IRC_S1298_A,
    IRC_S1298_B,
    IRC_S1298_D,
    IRC_S1298_E,
    aggregate_interest_on_increases,
    amount_distributed_not_includible_by_1293c,
    cfc_dividend_election_effective_1291d2B,
    considered_owner_of_pfic_stock_1296g1,
    constructive_pfic_stock_owned_via_corporation_1298a2,
    deemed_sale_election_effective_1291d2A,
    extension_of_time_in_effect_1294a,
    mtm_deduction_1296a2,
    mtm_inclusion_1296a1,
    passive_income_1297,
    receives_excess_distribution,
    unreversed_inclusions_1296d,
};

pub relation holding_days_in_year_1291a1A(p: us.irc.core::Person, pfic: us.irc.core::Corporation, distribution_year: us.irc.core::TaxableYear, allocation_year: us.irc.core::TaxableYear, days: Integer) kind empirical {
    label en official "the number of days of the taxpayer's holding period for the stock falling in the allocation year";
}
pub relation total_holding_days_1291a1A(p: us.irc.core::Person, pfic: us.irc.core::Corporation, distribution_year: us.irc.core::TaxableYear, total_days: Integer) kind empirical {
    label en official "the number of days in the taxpayer's holding period for the stock (a sum over the years, asserted directly)";
}
pub relation amount_allocated_to_year_1291a1A(p: us.irc.core::Person, pfic: us.irc.core::Corporation, distribution_year: us.irc.core::TaxableYear, allocation_year: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the part of the excess distribution allocated ratably (by day) to the allocation year";
}
@source(IRC_S1291_A, relation = formalizes, coverage = exact, quote = "(A) the amount of the excess distribution shall be allocated ratably to each day in the taxpayer's holding")
rule S1291A1ARatableAllocationByDay defeasible {
    for p: us.irc.core::Person;
    for pfic: us.irc.core::Corporation;
    for distribution_year: us.irc.core::TaxableYear;
    for allocation_year: us.irc.core::TaxableYear;
    for excess: Money;
    for days: Integer;
    for total: Integer;
    when receives_excess_distribution(p, pfic, distribution_year, excess)
     and holding_days_in_year_1291a1A(p, pfic, distribution_year, allocation_year, days)
     and total_holding_days_1291a1A(p, pfic, distribution_year, total)
     and total > 0;
    then amount_allocated_to_year_1291a1A(p, pfic, distribution_year, allocation_year, div_round(excess * (days * 1.00), total * 1.00, 2, "HALF_UP"));
}
pub relation allocation_year_is_pre_pfic_year_1291a1B(p: us.irc.core::Person, pfic: us.irc.core::Corporation, allocation_year: us.irc.core::TaxableYear) kind empirical {
    label en official "the allocation year is a taxable year (or the portion of one) of the taxpayer's holding period for which the company was not a passive foreign investment company (the pre-PFIC years of section 1291(a)(1)(B)(ii))";
}
pub relation allocated_amount_included_in_current_year_1291a1B(p: us.irc.core::Person, pfic: us.irc.core::Corporation, distribution_year: us.irc.core::TaxableYear, allocation_year: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the gross income for the current year includes (as ordinary income) only the amounts allocated to the current taxable year and to the years before the company was a passive foreign investment company";
}
@source(IRC_S1291_A, relation = formalizes, coverage = exact, quote = "(B) with respect to such excess distribution, the taxpayer's gross income for the current year shall include")
rule S1291A1BCurrentYearAllocation defeasible {
    for p: us.irc.core::Person;
    for pfic: us.irc.core::Corporation;
    for distribution_year: us.irc.core::TaxableYear;
    for allocation_year: us.irc.core::TaxableYear;
    for amount: Money;
    when amount_allocated_to_year_1291a1A(p, pfic, distribution_year, allocation_year, amount)
     and distribution_year == allocation_year;
    then allocated_amount_included_in_current_year_1291a1B(p, pfic, distribution_year, allocation_year, amount);
}
@source(IRC_S1291_A, relation = formalizes, coverage = exact, quote = "(B) with respect to such excess distribution, the taxpayer's gross income for the current year shall include")
rule S1291A1BPrePficYearAllocation defeasible {
    for p: us.irc.core::Person;
    for pfic: us.irc.core::Corporation;
    for distribution_year: us.irc.core::TaxableYear;
    for allocation_year: us.irc.core::TaxableYear;
    for amount: Money;
    when amount_allocated_to_year_1291a1A(p, pfic, distribution_year, allocation_year, amount)
     and allocation_year_is_pre_pfic_year_1291a1B(p, pfic, allocation_year);
    then allocated_amount_included_in_current_year_1291a1B(p, pfic, distribution_year, allocation_year, amount);
}
pub relation highest_rate_of_tax_for_year_1291c2(allocation_year: us.irc.core::TaxableYear, rate: Decimal) kind empirical {
    label en official "the highest rate of tax in effect for the taxable year under section 1 or 11, whichever applies (a fraction)";
}
pub relation increase_in_tax_for_allocation_year_1291c2(p: us.irc.core::Person, pfic: us.irc.core::Corporation, distribution_year: us.irc.core::TaxableYear, allocation_year: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "each amount allocated to a taxable year (other than a year referred to in subsection (a)(1)(B)) multiplied by the highest rate of tax in effect for that year";
}
@source(IRC_S1291_C, relation = formalizes, coverage = exact, quote = "For purposes of paragraph (1)(A), the aggregate increases in taxes shall be determined by multiplying each")
rule S1291C2HighestRateOnAllocatedAmount defeasible {
    for p: us.irc.core::Person;
    for pfic: us.irc.core::Corporation;
    for distribution_year: us.irc.core::TaxableYear;
    for allocation_year: us.irc.core::TaxableYear;
    for amount: Money;
    for rate: Decimal;
    when amount_allocated_to_year_1291a1A(p, pfic, distribution_year, allocation_year, amount)
     and highest_rate_of_tax_for_year_1291c2(allocation_year, rate);
    unless allocated_amount_included_in_current_year_1291a1B(p, pfic, distribution_year, allocation_year, amount)
     and highest_rate_of_tax_for_year_1291c2(allocation_year, rate)
     and amount_allocated_to_year_1291a1A(p, pfic, distribution_year, allocation_year, amount);
    then increase_in_tax_for_allocation_year_1291c2(p, pfic, distribution_year, allocation_year, round(amount * rate, 2, "HALF_UP"));
}
pub relation interest_charge_treated_as_6601_interest_1291c1(p: us.irc.core::Person, pfic: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the increase in tax attributable to the interest amount of paragraph (1)(B) is treated as interest paid under section 6601 on the due date for the current year";
}
@source(IRC_S1291_C, relation = formalizes, coverage = exact, quote = "Any increase in the tax imposed by this chapter for the current year under subsection (a) to the extent")
rule S1291C1InterestChargeAsSection6601Interest defeasible {
    for p: us.irc.core::Person;
    for pfic: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for interest: Money;
    when aggregate_interest_on_increases(p, pfic, y, interest);
    then interest_charge_treated_as_6601_interest_1291c1(p, pfic, y, interest);
}
pub relation return_due_date_for_year_1291c3(y: us.irc.core::TaxableYear, due: Date) kind empirical {
    label en official "the due date for the return of tax for the taxable year";
}
pub relation interest_period_1291c3A(p: us.irc.core::Person, pfic: us.irc.core::Corporation, distribution_year: us.irc.core::TaxableYear, allocation_year: us.irc.core::TaxableYear, starts_on: Date, ends_on: Date) kind institutional {
    label en official "the period of the interest on the increase for the allocation year: from the due date for that year to the due date for the year with or within which the distribution or disposition occurs; the section 6621 underpayment rates and method are external";
}
@source(IRC_S1291_C, relation = formalizes, coverage = exact, quote = "(i) beginning on the due date for such taxable year, and")
rule S1291C3AInterestPeriod defeasible {
    for p: us.irc.core::Person;
    for pfic: us.irc.core::Corporation;
    for distribution_year: us.irc.core::TaxableYear;
    for allocation_year: us.irc.core::TaxableYear;
    for start: Date;
    for finish: Date;
    for amount: Money;
    when increase_in_tax_for_allocation_year_1291c2(p, pfic, distribution_year, allocation_year, amount)
     and return_due_date_for_year_1291c3(allocation_year, start)
     and return_due_date_for_year_1291c3(distribution_year, finish);
    then interest_period_1291c3A(p, pfic, distribution_year, allocation_year, start, finish);
}
pub relation prior_excess_distribution_in_three_year_period_1291b2Aii(p: us.irc.core::Person, pfic: us.irc.core::Corporation, prior_year: us.irc.core::TaxableYear, amount: Money, included_under_1291a1B: Money) kind empirical {
    label en official "an excess distribution received during the 3-year period and the part of it included in gross income under subsection (a)(1)(B)";
}
pub relation prior_excess_distribution_counted_1291b2Aii(p: us.irc.core::Person, pfic: us.irc.core::Corporation, prior_year: us.irc.core::TaxableYear, counted: Money) kind institutional {
    label en official "an excess distribution of the 3-year period is taken into account only to the extent it was included in gross income under subsection (a)(1)(B)";
}
@source(IRC_S1291_B, relation = formalizes, coverage = exact, quote = "For purposes of clause (ii), any excess distribution received during such 3-year period shall be taken into")
rule S1291B2AiiOnlyToExtentIncludedInGrossIncome defeasible {
    for p: us.irc.core::Person;
    for pfic: us.irc.core::Corporation;
    for prior_year: us.irc.core::TaxableYear;
    for amount: Money;
    for included: Money;
    when prior_excess_distribution_in_three_year_period_1291b2Aii(p, pfic, prior_year, amount, included);
    then prior_excess_distribution_counted_1291b2Aii(p, pfic, prior_year, min(amount, included));
}
pub relation amount_included_under_1291d2B_ii_1291d2Biii(p: us.irc.core::Person, share_id: Text, amount: Money) kind empirical {
    label en official "an amount included in gross income under section 1291(d)(2)(B)";
}
pub relation amount_treated_as_included_under_1248a_for_959e_1291d2Biii(p: us.irc.core::Person, share_id: Text, amount: Money) kind institutional {
    label en official "for purposes of section 959(e), the amount is treated as included in gross income under section 1248(a)";
}
@source(IRC_S1291_D, relation = formalizes, coverage = exact, quote = "For purposes of section 959(e), any amount included in gross income under this subparagraph shall be treated")
rule S1291D2BiiiTreatedAs1248a defeasible {
    for p: us.irc.core::Person;
    for share_id: Text;
    for amount: Money;
    when amount_included_under_1291d2B_ii_1291d2Biii(p, share_id, amount);
    then amount_treated_as_included_under_1248a_for_959e_1291d2Biii(p, share_id, amount);
}
pub relation first_day_referred_to_in_1291d2C(p: us.irc.core::Person, share_id: Text, first_day: Date) kind empirical {
    label en official "the first day of the first taxable year of the company to which the election of subparagraph (A) or (B) applies";
}
pub relation holding_period_start_after_election_1291d2Cii(p: us.irc.core::Person, share_id: Text, starts_on: Date) kind institutional {
    label en official "the taxpayer's holding period in the stock is treated as beginning on the first day referred to in the subparagraph";
}
@source(IRC_S1291_D, relation = formalizes, coverage = exact, quote = "(ii) the taxpayer's holding period in such stock shall be treated as beginning on the first day referred to")
rule S1291D2CiiHoldingPeriodBeginsOnFirstDay defeasible {
    for p: us.irc.core::Person;
    for share_id: Text;
    for first_day: Date;
    when first_day_referred_to_in_1291d2C(p, share_id, first_day)
     and (deemed_sale_election_effective_1291d2A(p, share_id) or cfc_dividend_election_effective_1291d2B(p, share_id));
    then holding_period_start_after_election_1291d2Cii(p, share_id, first_day);
}
pub relation distribution_amount_before_78_1291g1A(p: us.irc.core::Person, dist_id: Text, amount: Money) kind empirical {
    label en official "the amount of the distribution before the section 78 gross-up";
}
pub relation section_78_amount_on_distribution_1291g1A(p: us.irc.core::Person, dist_id: Text, amount: Money) kind empirical {
    label en official "the amount included in gross income under section 78 with respect to the taxes deemed paid on the distribution";
}
pub relation distribution_amount_with_regard_to_78_1291g1A(p: us.irc.core::Person, dist_id: Text, amount: Money) kind institutional {
    label en official "for purposes of section 1291 the amount of the distribution is determined with regard to section 78";
}
@source(IRC_S1291_G, relation = formalizes, coverage = exact, quote = "(A) the amount of such distribution shall be determined for purposes of this section with regard to section")
rule S1291G1ADistributionWithRegardTo78 defeasible {
    for p: us.irc.core::Person;
    for dist_id: Text;
    for base: Money;
    for gross_up: Money;
    when distribution_amount_before_78_1291g1A(p, dist_id, base)
     and section_78_amount_on_distribution_1291g1A(p, dist_id, gross_up);
    then distribution_amount_with_regard_to_78_1291g1A(p, dist_id, base + gross_up);
}
pub relation increase_in_tax_by_distribution_for_year_1291g1Cii(p: us.irc.core::Person, dist_id: Text, allocation_year: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the increase in tax determined under subsection (c)(2) for the allocation year by reason of the distribution";
}
pub relation excess_distribution_taxes_allocated_to_year_1291g1Cii(p: us.irc.core::Person, dist_id: Text, allocation_year: us.irc.core::TaxableYear, taxes: Money) kind empirical {
    label en official "the excess distribution taxes allocated to the allocation year (applying the principles of section 904(d))";
}
pub relation increase_after_excess_distribution_taxes_1291g1Cii(p: us.irc.core::Person, dist_id: Text, allocation_year: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the taxes reduce the increase in tax for the other taxable year, not below zero (and are not taken into account under section 901)";
}
@source(IRC_S1291_G, relation = formalizes, coverage = exact, quote = "(ii) that such excess distribution taxes are allocated to any other taxable year, such taxes shall reduce")
rule S1291G1CiiTaxesReduceIncrease defeasible {
    for p: us.irc.core::Person;
    for dist_id: Text;
    for allocation_year: us.irc.core::TaxableYear;
    for increase: Money;
    for taxes: Money;
    when increase_in_tax_by_distribution_for_year_1291g1Cii(p, dist_id, allocation_year, increase)
     and excess_distribution_taxes_allocated_to_year_1291g1Cii(p, dist_id, allocation_year, taxes);
    then increase_after_excess_distribution_taxes_1291g1Cii(p, dist_id, allocation_year, max(increase - taxes, 0.00 USD));
}
pub relation gain_that_would_be_dividend_under_1248_1291g2C(p: us.irc.core::Person, share_id: Text, amount: Money) kind empirical {
    label en official "any gain which but for section 1291 would be includible in gross income as a dividend under section 1248";
}
pub relation section_1291g_rules_apply_to_1248_gain_1291g2C(p: us.irc.core::Person, share_id: Text, amount: Money) kind institutional {
    label en official "the rules of subsection (g) also apply to gain that would otherwise be a section 1248 dividend";
}
@source(IRC_S1291_G, relation = formalizes, coverage = exact, quote = "The rules of this subsection also shall apply in the case of any gain which but for this section would be")
rule S1291G2CRulesApplyTo1248Gain defeasible {
    for p: us.irc.core::Person;
    for share_id: Text;
    for amount: Money;
    when gain_that_would_be_dividend_under_1248_1291g2C(p, share_id, amount);
    then section_1291g_rules_apply_to_1248_gain_1291g2C(p, share_id, amount);
}

// --- §1293(d), (f); §1294(c)(1)(B), (e); §1295(b)(2) -------------------------------------------------------------------------------

pub relation property_by_reason_of_which_1298a_owner_of_qef_stock_1293d(p: us.irc.core::Person, fund: us.irc.core::Corporation, property_id: Text) kind empirical {
    label en official "the taxpayer is treated under section 1298(a) as owning stock in a qualified electing fund by reason of holding the property";
}
pub relation property_basis_adjusted_like_stock_1293d(p: us.irc.core::Person, fund: us.irc.core::Corporation, property_id: Text) kind institutional {
    label en official "a similar rule (the basis adjustments of subsection (d)) applies to the property by reason of which the taxpayer is treated as owning the stock";
}
@source(IRC_S1293_D, relation = formalizes, coverage = exact, quote = "A similar rule shall apply also in the case of any property if by reason of holding such property the")
rule S1293DSimilarRuleForPropertyUnder1298a defeasible {
    for p: us.irc.core::Person;
    for fund: us.irc.core::Corporation;
    for property_id: Text;
    when property_by_reason_of_which_1298a_owner_of_qef_stock_1293d(p, fund, property_id);
    then property_basis_adjusted_like_stock_1293d(p, fund, property_id);
}
pub relation amount_excluded_under_1293c_1293f2(shareholder: us.irc.core::Person, fund: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "any amount excluded from gross income under subsection (c) is treated in the same manner as amounts excluded under section 959";
}
@source(IRC_S1293_F, relation = formalizes, coverage = exact, quote = "(2) any amount excluded from gross income under subsection (c) shall be treated in the same manner as amounts")
rule S1293F2ExcludedAmountLikeSection959 defeasible {
    for shareholder: us.irc.core::Person;
    for fund: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when amount_distributed_not_includible_by_1293c(shareholder, fund, y, amount);
    then amount_excluded_under_1293c_1293f2(shareholder, fund, y, amount);
}
pub relation domestic_corporation_owns_or_is_treated_as_owning_qef_stock_1293f3(domestic: us.irc.core::Person, fund: us.irc.core::Corporation) kind empirical {
    label en official "a domestic corporation owns (or is treated under section 1298(a) as owning) stock of a qualified electing fund";
}
pub relation domestic_corporation_meets_902_ownership_1293f3(domestic: us.irc.core::Person, fund: us.irc.core::Corporation, voting_percent: Decimal) kind empirical {
    label en official "the percentage of voting stock the domestic corporation owns, for the stock ownership requirements of subsection (a) or (b) of section 902 as in effect before its repeal (10 percent of voting stock)";
}
pub relation domestic_corporation_treated_as_us_shareholder_of_cfc_1293f3(domestic: us.irc.core::Person, fund: us.irc.core::Corporation) kind institutional {
    label en official "the domestic corporation is treated in the same manner as a United States shareholder of a controlled foreign corporation (and the fund as that controlled foreign corporation) if it meets the section 902 ownership requirements";
}
@source(IRC_S1293_F, relation = formalizes, coverage = exact, quote = "(3) a domestic corporation which owns (or is treated under section 1298(a) as owning) stock of a qualified")
rule S1293F3DomesticCorporationAsUsShareholder defeasible {
    for domestic: us.irc.core::Person;
    for fund: us.irc.core::Corporation;
    for percent: Decimal;
    when domestic_corporation_owns_or_is_treated_as_owning_qef_stock_1293f3(domestic, fund)
     and domestic_corporation_meets_902_ownership_1293f3(domestic, fund, percent)
     and percent >= 10.0;
    then domestic_corporation_treated_as_us_shareholder_of_cfc_1293f3(domestic, fund);
}
pub relation earnings_accumulated_in_period_1294c1B(source_id: Text, accumulated_on: Date) kind empirical {
    label en official "earnings and profits accumulated on this date (a period end) that a distribution could be made from";
}
pub relation distribution_from_earnings_1294c1B(dist_id: Text, source_id: Text) kind empirical {
    label en official "the distribution is made from the earnings and profits of the source";
}
pub relation most_recent_accumulation_1294c1B(source_id: Text, accumulated_on: Date) kind institutional {
    label en official "a distribution is treated as made from the most recently accumulated earnings and profits";
}
@source(IRC_S1294_C, relation = formalizes, coverage = exact, quote = "For purposes of subparagraph (A), a distribution shall be treated as made from the most recently accumulated")
rule S1294C1BMostRecentlyAccumulated defeasible {
    for source_id: Text;
    for accumulated_on: Date;
    for dist_id: Text;
    for later: Date;
    when distribution_from_earnings_1294c1B(dist_id, source_id)
     and earnings_accumulated_in_period_1294c1B(source_id, accumulated_on);
    unless earnings_accumulated_in_period_1294c1B(source_id, later)
     and later > accumulated_on
     and distribution_from_earnings_1294c1B(dist_id, source_id)
     and earnings_accumulated_in_period_1294c1B(source_id, accumulated_on);
    then most_recent_accumulation_1294c1B(source_id, accumulated_on);
}
pub relation section_6165_applies_to_1294_extension(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "section 6165 (bonds where time to pay tax or deficiency has been extended) applies to any extension under this section as though the Secretary were extending the time for payment";
}
@source(IRC_S1294_E, relation = formalizes, coverage = exact, quote = "Section 6165 shall apply to any extension under this section as though the Secretary were extending the time")
rule S1294ESection6165AppliesToExtension defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when extension_of_time_in_effect_1294a(p, y);
    then section_6165_applies_to_1294_extension(p, y);
}
pub relation qef_election_made_on_1295b2(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, made_on: Date) kind empirical {
    label en official "the date on which the shareholder made the section 1295 election for the taxable year";
}
pub relation return_due_date_with_extensions_1295b2(p: us.irc.core::Person, y: us.irc.core::TaxableYear, due: Date) kind empirical {
    label en official "the due date (determined with regard to extensions) for filing the return of the tax imposed by this chapter for the taxable year";
}
pub relation qef_election_timely_1295b2(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the election may be made for a taxable year at any time on or before the due date (with extensions) for the return; a later election under regulations (reasonable belief that the company was not a passive foreign investment company) is external";
}
@source(IRC_S1295_B, relation = formalizes, coverage = exact, quote = "An election under this subsection may be made for any taxable year at any time on or before the due date")
rule S1295B2ElectionOnOrBeforeDueDate defeasible {
    for p: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for made_on: Date;
    for due: Date;
    when qef_election_made_on_1295b2(p, corp, y, made_on)
     and return_due_date_with_extensions_1295b2(p, y, due)
     and made_on <= due;
    then qef_election_timely_1295b2(p, corp, y);
}

// --- §1296(b)(2), (c), (f), (g)(2), (h), (i), (j)(2) --------------------------------------------------------------------------------

pub relation basis_adjustment_of_constructively_owned_stock_1296b2(p: us.irc.core::Person, share_id: Text, holder: us.irc.core::Person, inclusion: Money) kind empirical {
    label en official "the stock the United States person is treated as owning under subsection (g), the person actually holding it, and the amount included under subsection (a)(1) with respect to it";
}
pub relation actual_holder_basis_adjusted_for_subsequent_treatment_1296b2A(p: us.irc.core::Person, share_id: Text, holder: us.irc.core::Person, adjustment: Money) kind institutional {
    label en official "the adjustments apply to the stock in the hands of the person actually holding it, only for determining the subsequent treatment of the United States person";
}
@source(IRC_S1296_B, relation = formalizes, coverage = exact, quote = "(A) the adjustments under paragraph (1) shall apply to such stock in the hands of the person actually holding")
rule S1296B2AAdjustmentInHandsOfActualHolder defeasible {
    for p: us.irc.core::Person;
    for share_id: Text;
    for holder: us.irc.core::Person;
    for inclusion: Money;
    when basis_adjustment_of_constructively_owned_stock_1296b2(p, share_id, holder, inclusion);
    then actual_holder_basis_adjusted_for_subsequent_treatment_1296b2A(p, share_id, holder, inclusion);
}
pub relation property_basis_adjusted_by_reason_of_constructive_ownership_1296b2B(p: us.irc.core::Person, share_id: Text, adjustment: Money) kind institutional {
