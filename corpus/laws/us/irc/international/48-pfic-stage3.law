rule S1296HInclusionAsDividendFor851b2 defeasible {
    for p: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when mtm_inclusion_1296a1(p, corp, y, amount);
    then section_1296_inclusion_treated_as_dividend_for_851b2_1296h(p, corp, y, amount);
}
pub relation basis_of_inherited_stock_decedent_and_section_1014_1296i(heir: us.irc.core::Person, share_id: Text, decedent_adjusted_basis: Money, section_1014_basis: Money) kind empirical {
    label en official "stock acquired by bequest, devise or inheritance (or by the decedent's estate) with respect to which a section 1296 election was in effect at death: the decedent's adjusted basis immediately before death, and the basis that would be determined under section 1014 without regard to this subsection";
}
pub relation basis_of_inherited_stock_1296i(heir: us.irc.core::Person, share_id: Text, basis: Money) kind institutional {
    label en official "notwithstanding section 1014, the basis is the decedent's adjusted basis immediately before death or, if lesser, the section 1014 basis";
}
@source(IRC_S1296_I, relation = formalizes, coverage = exact, quote = "In the case of stock of a passive foreign investment company which is acquired by bequest, devise, or")
rule S1296IBasisOfInheritedStock defeasible {
    for heir: us.irc.core::Person;
    for share_id: Text;
    for decedent_basis: Money;
    for basis_1014: Money;
    when basis_of_inherited_stock_decedent_and_section_1014_1296i(heir, share_id, decedent_basis, basis_1014);
    then basis_of_inherited_stock_1296i(heir, share_id, min(decedent_basis, basis_1014));
}
pub relation ric_first_year_of_election_1296j2A(ric: us.irc.core::Person, share_id: Text, y: us.irc.core::TaxableYear) kind empirical {
    label en official "a regulated investment company elects the application of section 1296 for marketable stock after the beginning of its holding period; this is the company's first taxable year for which the election applies to the stock";
}
pub relation ric_marked_to_market_in_preceding_year_1296j2Aiii(ric: us.irc.core::Person, share_id: Text, y: us.irc.core::TaxableYear) kind empirical {
    label en official "for the preceding taxable year the company elected to mark to market the stock held as of the last day of that year";
}
pub relation interest_that_would_be_determined_under_1291c3_1296j2Aii(ric: us.irc.core::Person, share_id: Text, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate amount of interest that would have been determined under section 1291(c)(3) if section 1291 were applied without regard to this subparagraph";
}
pub relation section_1291_not_applied_to_ric_first_election_year_1296j2Ai(ric: us.irc.core::Person, share_id: Text, y: us.irc.core::TaxableYear) kind institutional {
    label en official "section 1291 does not apply to the stock with respect to a distribution or disposition during, or an amount included in gross income under this section for, the first taxable year of the election";
}
@source(IRC_S1296_J, relation = formalizes, coverage = exact, quote = "(i) section 1291 shall not apply to such stock with respect to any distribution or disposition during, or")
rule S1296J2AiSection1291NotApplied defeasible {
    for ric: us.irc.core::Person;
    for share_id: Text;
    for y: us.irc.core::TaxableYear;
    when ric_first_year_of_election_1296j2A(ric, share_id, y);
    then section_1291_not_applied_to_ric_first_election_year_1296j2Ai(ric, share_id, y);
}
pub relation ric_tax_increase_1296j2Aii(ric: us.irc.core::Person, share_id: Text, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the company's tax for the first election year is increased by the interest that would have been determined under section 1291(c)(3), unless it elected mark to market for the preceding year";
}
@source(IRC_S1296_J, relation = formalizes, coverage = exact, quote = "(ii) such regulated investment company's tax under this chapter for such first taxable year shall be")
rule S1296J2AiiTaxIncreaseByInterest defeasible {
    for ric: us.irc.core::Person;
    for share_id: Text;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when ric_first_year_of_election_1296j2A(ric, share_id, y)
     and interest_that_would_be_determined_under_1291c3_1296j2Aii(ric, share_id, y, amount);
    unless ric_marked_to_market_in_preceding_year_1296j2Aiii(ric, share_id, y)
     and ric_first_year_of_election_1296j2A(ric, share_id, y)
     and interest_that_would_be_determined_under_1291c3_1296j2Aii(ric, share_id, y, amount);
    then ric_tax_increase_1296j2Aii(ric, share_id, y, amount);
}
pub relation deduction_disallowed_for_ric_tax_increase_1296j2B(ric: us.irc.core::Person, share_id: Text, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "no deduction is allowed to the regulated investment company for the increase in tax under subparagraph (A)(ii)";
}
@source(IRC_S1296_J, relation = formalizes, coverage = exact, quote = "No deduction shall be allowed to any regulated investment company for the increase in tax under subparagraph")
rule S1296J2BNoDeductionForTaxIncrease defeasible {
    for ric: us.irc.core::Person;
    for share_id: Text;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when ric_tax_increase_1296j2Aii(ric, share_id, y, amount);
    then deduction_disallowed_for_ric_tax_increase_1296j2B(ric, share_id, y, amount);
}

// --- §1297(b)(2), (d)(3)-(4), (e)(2), (f)(3)(B) -------------------------------------------------------------------------------------

pub relation income_derived_in_active_banking_by_us_licensed_bank_1297b2A(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text) kind empirical {
    label en official "the income is derived in the active conduct of a banking business by an institution licensed to do business as a bank in the United States (or, to the extent provided in regulations, by another corporation)";
}
pub relation income_derived_in_active_insurance_by_qualifying_corporation_1297b2B(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text) kind empirical {
    label en official "the income is derived in the active conduct of an insurance business by a qualifying insurance corporation (subsection (f))";
}
pub relation export_trade_income_of_export_trade_corporation_1297b2D(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text) kind empirical {
    label en official "the income is export trade income of an export trade corporation (section 971)";
}
pub relation income_excluded_from_passive_by_1297b2(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text) kind institutional {
    label en official "the income is excluded from passive income by an exception of paragraph (2)(A), (B) or (D)";
}
@source(IRC_S1297_B, relation = formalizes, coverage = exact, quote = "(A) derived in the active conduct of a banking business by an institution licensed to do business as a bank")
rule S1297B2ABankingIncomeExcluded defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    when income_derived_in_active_banking_by_us_licensed_bank_1297b2A(corp, y, item_id);
    then income_excluded_from_passive_by_1297b2(corp, y, item_id);
}
@source(IRC_S1297_B, relation = formalizes, coverage = exact, quote = "(B) derived in the active conduct of an insurance business by a qualifying insurance corporation (as defined")
rule S1297B2BInsuranceIncomeExcluded defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    when income_derived_in_active_insurance_by_qualifying_corporation_1297b2B(corp, y, item_id);
    then income_excluded_from_passive_by_1297b2(corp, y, item_id);
}
@source(IRC_S1297_B, relation = formalizes, coverage = exact, quote = "(D) which is export trade income of an export trade corporation (as defined in section 971).")
rule S1297B2DExportTradeIncomeExcluded defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    when export_trade_income_of_export_trade_corporation_1297b2D(corp, y, item_id);
    then income_excluded_from_passive_by_1297b2(corp, y, item_id);
}
pub relation passive_income_after_1297b2_exceptions(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text) kind institutional {
    label en official "the item is passive income: of a kind that would be foreign personal holding company income, and not within the paragraph (2) exceptions (banking, insurance, related-person allocation, export trade)";
}
@source(IRC_S1297_B, relation = formalizes, coverage = exact, quote = "Except as provided in regulations, the term \"passive income\" does not include any income—")
rule S1297B1WithExceptionsOfParagraphTwo defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    when passive_income_1297(corp, y, item_id);
    unless income_excluded_from_passive_by_1297b2(corp, y, item_id)
     and passive_income_1297(corp, y, item_id);
    then passive_income_after_1297b2_exceptions(corp, y, item_id);
}
pub relation shareholder_holding_period_end_of_qualified_portion_1297d3(p: us.irc.core::Person, corp: us.irc.core::Corporation, ends_on: Date) kind empirical {
    label en official "the date on which the qualified portion of the shareholder's holding period with respect to the stock ends";
}
pub relation stock_was_pfic_stock_before_qualified_portion_and_no_1298b1_election_1297d3B(p: us.irc.core::Person, corp: us.irc.core::Corporation) kind empirical {
    label en official "the stock was, with respect to the shareholder, stock in a passive foreign investment company at any time before the qualified portion, and no election under section 1298(b)(1) is made";
}
pub relation holding_period_begins_after_qualified_portion_1297d3A(p: us.irc.core::Person, corp: us.irc.core::Corporation, begins_on: Date) kind institutional {
    label en official "if the qualified portion of the holding period ends after December 31, 1997, the holding period for this part is treated as beginning on the first day following that portion (unless subparagraph (B) applies)";
}
@source(IRC_S1297_D, relation = formalizes, coverage = exact, quote = "Except as provided in subparagraph (B), if the qualified portion of a shareholder's holding period with")
rule S1297D3AHoldingPeriodRestartsAfterQualifiedPortion defeasible {
    for p: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for ends_on: Date;
    when shareholder_holding_period_end_of_qualified_portion_1297d3(p, corp, ends_on)
     and ends_on > @1997-12-31;
    unless stock_was_pfic_stock_before_qualified_portion_and_no_1298b1_election_1297d3B(p, corp)
     and shareholder_holding_period_end_of_qualified_portion_1297d3(p, corp, ends_on);
    then holding_period_begins_after_qualified_portion_1297d3A(p, corp, add_calendar_period(ends_on, 1 calendar_day));
}
pub relation stock_treated_as_owned_by_option_1298a4_1297d4(p: us.irc.core::Person, corp: us.irc.core::Corporation) kind empirical {
    label en official "the stock is treated as owned by the person by reason of section 1298(a)(4) (an option to acquire stock)";
}
pub relation option_stock_owned_by_us_shareholder_not_exempt_1297d4(p: us.irc.core::Person, corp: us.irc.core::Corporation) kind empirical {
    label en official "the person establishes that the stock is owned (section 958(a)) by a United States shareholder (section 951(b)) not exempt from tax under this chapter";
}
pub relation paragraph_1_applies_to_option_holder_stock_1297d4(p: us.irc.core::Person, corp: us.irc.core::Corporation) kind institutional {
    label en official "paragraph (1) (suspension of PFIC status for the CFC period) applies to stock treated as owned through an option only if the person establishes ownership by a United States shareholder not exempt from tax";
}
@source(IRC_S1297_D, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall not apply to stock treated as owned by a person by reason of section 1298(a)(4) (relating")
rule S1297D4OptionHolderStockNeedsShowing defeasible {
    for p: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    when stock_treated_as_owned_by_option_1298a4_1297d4(p, corp)
     and option_stock_owned_by_us_shareholder_not_exempt_1297d4(p, corp);
    then paragraph_1_applies_to_option_holder_stock_1297d4(p, corp);
}
pub relation qualifying_insurance_election_revoked_with_secretary_consent_1297e2B(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the Secretary consented to the revocation of the election under subparagraph (B)";
}
pub relation attempted_revocation_of_1297e2B_election(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the person tries to revoke the election under subparagraph (B)";
}
pub relation revocation_of_election_effective_1297e2B(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "an election under subparagraph (B), once made, may be revoked only with the consent of the Secretary";
}
@source(IRC_S1297_E, relation = formalizes, coverage = exact, quote = "An election under subparagraph (B), once made, may be revoked only with the consent of the Secretary.")
rule S1297E2BRevocationOnlyWithConsent defeasible {
    for p: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when attempted_revocation_of_1297e2B_election(p, corp, y)
     and qualifying_insurance_election_revoked_with_secretary_consent_1297e2B(p, corp, y);
    then revocation_of_election_effective_1297e2B(p, corp, y);
}
pub relation applicable_insurance_liabilities_amount_1297f3A(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, computed: Money, reported_to_regulator: Money, required_by_law: Money) kind empirical {
    label en official "the applicable insurance liabilities (clause (i) or (ii) of subparagraph (A)), the amount reported to the applicable insurance regulatory body in the applicable financial statement, and the amount required by applicable law or regulation";
}
pub relation applicable_insurance_liabilities_limited_1297f3B(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the amount shall not exceed the lesser of the computed amount and the amount reported to the regulator (or, if less, the amount required by applicable law or regulation); the regulatory cap of clause (ii) is external";
}
@source(IRC_S1297_F, relation = formalizes, coverage = partial, quote = "(i) as reported to the applicable insurance regulatory body in the applicable financial statement described")
rule S1297F3BLimitationByReportedAmount defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for computed: Money;
    for reported: Money;
    for required: Money;
    when applicable_insurance_liabilities_amount_1297f3A(corp, y, computed, reported, required);
    then applicable_insurance_liabilities_limited_1297f3B(corp, y, min(computed, min(reported, required)));
}

// --- §1298(a), (b), (d), (e) ---------------------------------------------------------------------------------------------------------------

pub relation attribution_to_united_states_person_only_1298a1(p: us.irc.core::Person, pfic: us.irc.core::Corporation, percent: Decimal) kind empirical {
    label en official "stock of the company treated as owned by the United States person under subsection (a)";
}
pub relation attribution_not_reattributed_to_other_person_1298a1B(p: us.irc.core::Person, other: us.irc.core::Person, pfic: us.irc.core::Corporation) kind institutional {
    label en official "except to the extent provided in regulations, stock owned (or treated as owned) by a United States person is not treated as owned by any other person by this subsection";
}
pub relation regulations_provide_reattribution_1298a1B(pfic: us.irc.core::Corporation) kind empirical {
    label en official "regulations provide for the re-attribution";
}
pub relation attribution_asked_for_1298a1B(p: us.irc.core::Person, other: us.irc.core::Person, pfic: us.irc.core::Corporation) kind empirical {
    label en official "the question whether stock owned or treated as owned by the United States person is treated as owned by the other person";
}
@source(IRC_S1298_A, relation = formalizes, coverage = exact, quote = "(B) except to the extent provided in regulations, shall not apply to treat stock owned (or treated as owned")
rule S1298A1BNoReattribution defeasible {
    for p: us.irc.core::Person;
    for other: us.irc.core::Person;
    for pfic: us.irc.core::Corporation;
    when attribution_asked_for_1298a1B(p, other, pfic);
    unless regulations_provide_reattribution_1298a1B(pfic)
     and attribution_asked_for_1298a1B(p, other, pfic);
    then attribution_not_reattributed_to_other_person_1298a1B(p, other, pfic);
}
pub relation corporation_owned_by_owner_1298a2B(owner: us.irc.core::Person, corp: us.irc.core::Corporation, percent: Decimal) kind empirical {
    label en official "the percentage in value of the corporation's stock owned by the person, for the look-through of subparagraph (B): any percentage, without the 50-percent limitation (section 1297(d) not applied)";
}
pub relation shareholder_treated_as_owning_stock_of_corporation_owned_by_pfic_1298a2B(owner: us.irc.core::Person, pfic: us.irc.core::Corporation, corp: us.irc.core::Corporation, percent: Decimal, held_percent: Decimal) kind institutional {
    label en official "for determining whether a shareholder of a passive foreign investment company is treated as owning stock owned by the company, the attribution applies without the 50-percent limitation";
}
pub relation pfic_owned_stock_percent_1298a2B(pfic: us.irc.core::Corporation, corp: us.irc.core::Corporation, held_percent: Decimal) kind empirical {
    label en official "the percentage in value of the stock of the other corporation owned by the passive foreign investment company";
}
@source(IRC_S1298_A, relation = formalizes, coverage = exact, quote = "For purposes of determining whether a shareholder of a passive foreign investment company is treated as")
rule S1298A2BAttributionWithoutFiftyPercentLimit defeasible {
    for owner: us.irc.core::Person;
    for pfic: us.irc.core::Corporation;
    for corp: us.irc.core::Corporation;
    for percent: Decimal;
    for held: Decimal;
    when corporation_owned_by_owner_1298a2B(owner, pfic, percent)
     and pfic_owned_stock_percent_1298a2B(pfic, corp, held)
     and percent > 0.0;
    then shareholder_treated_as_owning_stock_of_corporation_owned_by_pfic_1298a2B(owner, pfic, corp, percent, held);
}
pub relation attributed_stock_treated_as_actually_owned_1298a5(p: us.irc.core::Person, pfic: us.irc.core::Corporation) kind institutional {
    label en official "stock considered owned by reason of paragraph (2), (3) or (4) is considered actually owned for applying those paragraphs (one step is derived; the successive application needs recursion, LDC-E4102)";
}
@source(IRC_S1298_A, relation = formalizes, coverage = partial, quote = "Stock considered to be owned by a person by reason of the application of paragraph (2), (3), or (4) shall,")
rule S1298A5ConstructiveAsActual defeasible {
    for p: us.irc.core::Person;
    for pfic: us.irc.core::Corporation;
    for percent: Decimal;
    when constructive_pfic_stock_owned_via_corporation_1298a2(p, pfic, percent);
    then attributed_stock_treated_as_actually_owned_1298a5(p, pfic);
}
pub relation disposition_or_distribution_treated_as_by_us_person_1298b5A(p: us.irc.core::Person, pfic: us.irc.core::Corporation) kind institutional {
    label en official "under regulations, a disposition resulting in no longer owning, or a distribution in respect of the stock to the holder, is treated as a disposition by, or distribution to, the United States person";
}
pub relation disposition_making_us_person_no_longer_owner_1298b5Ai(p: us.irc.core::Person, pfic: us.irc.core::Corporation) kind empirical {
    label en official "a disposition by the United States person or the person owning the stock which results in the United States person being treated as no longer owning the stock";
}
pub relation distribution_to_person_holding_stock_1298b5Aii(p: us.irc.core::Person, pfic: us.irc.core::Corporation) kind empirical {
    label en official "a distribution of property in respect of the stock to the person holding it";
}
@source(IRC_S1298_B, relation = formalizes, coverage = partial, quote = "(i) any disposition by the United States person or the person owning such stock which results in the United")
rule S1298B5AiDispositionAsByUsPerson defeasible {
    for p: us.irc.core::Person;
    for pfic: us.irc.core::Corporation;
    when disposition_making_us_person_no_longer_owner_1298b5Ai(p, pfic);
    then disposition_or_distribution_treated_as_by_us_person_1298b5A(p, pfic);
}
@source(IRC_S1298_B, relation = formalizes, coverage = partial, quote = "(ii) any distribution of property in respect of such stock to the person holding such stock,")
rule S1298B5AiiDistributionAsToUsPerson defeasible {
    for p: us.irc.core::Person;
    for pfic: us.irc.core::Corporation;
    when distribution_to_person_holding_stock_1298b5Aii(p, pfic);
    then disposition_or_distribution_treated_as_by_us_person_1298b5A(p, pfic);
}
pub relation amount_described_in_1298b5A_or_1293a_1298b5B(p: us.irc.core::Person, pfic: us.irc.core::Corporation, amount: Money) kind empirical {
    label en official "an amount described in subparagraph (A), or included in gross income under section 1293(a) (or that would have been but for section 951(c)) in respect of stock the taxpayer is treated as owning";
}
pub relation rules_similar_to_959b_apply_1298b5B(p: us.irc.core::Person, pfic: us.irc.core::Corporation, amount: Money) kind institutional {
    label en official "rules similar to section 959(b) apply to the amount (no second inclusion through the chain)";
}
@source(IRC_S1298_B, relation = formalizes, coverage = exact, quote = "Rules similar to the rules of section 959(b) shall apply to any amount described in subparagraph (A) and to")
rule S1298B5BRulesSimilarTo959b defeasible {
    for p: us.irc.core::Person;
    for pfic: us.irc.core::Corporation;
    for amount: Money;
    when amount_described_in_1298b5A_or_1293a_1298b5B(p, pfic, amount);
    then rules_similar_to_959b_apply_1298b5B(p, pfic, amount);
}
pub relation foreign_corporation_subject_to_531_or_treaty_waiver_1298b7Ai(foreign: us.irc.core::Corporation) kind empirical {
    label en official "the foreign corporation is subject to the tax imposed by section 531 (or waives any treaty benefit that would prevent it)";
}
pub relation foreign_corporation_owns_domestic_stock_percent_by_value_1298b7Aii(foreign: us.irc.core::Corporation, domestic: us.irc.core::Corporation, percent: Decimal) kind empirical {
    label en official "the foreign corporation owns this percentage (by value) of the stock of the domestic corporation";
}
pub relation domestic_corporation_holds_qualified_stock_1298b7B(domestic: us.irc.core::Corporation, stock_id: Text) kind empirical {
    label en official "the stock is qualified stock: stock in a C corporation which is a domestic corporation and is not a regulated investment company or real estate investment trust";
}
pub relation qualified_stock_not_passive_asset_1298b7A(foreign: us.irc.core::Corporation, domestic: us.irc.core::Corporation, stock_id: Text) kind institutional {
    label en official "for determining whether the foreign corporation is a passive foreign investment company, qualified stock held by the domestic corporation is an asset which does not produce passive income (and is not held for its production), and amounts included with respect to it are not passive income";
}
@source(IRC_S1298_B, relation = formalizes, coverage = exact, quote = "for purposes of determining whether such foreign corporation is a passive foreign investment company, any")
rule S1298B7AQualifiedStockOf25PercentOwnedDomesticCorporation defeasible {
    for foreign: us.irc.core::Corporation;
    for domestic: us.irc.core::Corporation;
    for stock_id: Text;
    for percent: Decimal;
    when foreign_corporation_subject_to_531_or_treaty_waiver_1298b7Ai(foreign)
     and foreign_corporation_owns_domestic_stock_percent_by_value_1298b7Aii(foreign, domestic, percent)
     and percent >= 25.0
     and domestic_corporation_holds_qualified_stock_1298b7B(domestic, stock_id);
    then qualified_stock_not_passive_asset_1298b7A(foreign, domestic, stock_id);
}
pub relation lease_payments_present_value_inputs_1298d2B(asset: Text, payment_stream_id: Text, rate: Decimal, present_value: Money) kind empirical {
    label en official "the present value of the lease payments as of the beginning of the lease term, discounted at the applicable Federal rate under section 1274(d) with the lease term substituted for the debt term and without regard to paragraphs (2) and (3) (the rate table is external; the present value enters as a case amount)";
}
pub relation lease_present_value_determined_1298d2B(asset: Text, amount: Money) kind institutional {
    label en official "the present value of the payments is determined in the manner provided in regulations, as of the beginning of the lease term, using the applicable Federal rate (mid-term rate substituting the lease term)";
}
@source(IRC_S1298_D, relation = formalizes, coverage = partial, quote = "(i) as of the beginning of the lease term, and")
rule S1298D2BPresentValueAtLeaseStart defeasible {
    for asset: Text;
    for stream_id: Text;
    for rate: Decimal;
    for value: Money;
    when lease_payments_present_value_inputs_1298d2B(asset, stream_id, rate, value);
    then lease_present_value_determined_1298d2B(asset, value);
}
pub relation licensee_cfc_intangible_payments_1298e2A(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, payment_id: Text, amount: Money) kind empirical {
    label en official "payments made during the year by the controlled foreign corporation licensee for the use of intangible property (section 367(d)(4)) used in the active conduct of its trade or business";
}
pub relation payment_to_related_person_1298e2Bi(payment_id: Text) kind empirical {
    label en official "the payment is to a foreign person that is a related person (section 954(d)(3)) with respect to the controlled foreign corporation";
}
pub relation license_entered_to_avoid_this_part_1298e2Bii(payment_id: Text) kind empirical {
    label en official "a principal purpose of entering into the license was to avoid the provisions of this part (a purpose finding: DECISION-0194 adjudicated-fact channel)";
}
pub relation cfc_asset_basis_increase_for_licensed_intangibles_1298e2A(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, payment_id: Text, increase: Money) kind institutional {
    label en official "the adjusted basis of the total assets is increased by 300 percent of the payments for the use of the intangible property, except payments to a related foreign person and payments under a license with an avoidance purpose";
}
@source(IRC_S1298_E, relation = formalizes, coverage = exact, quote = "In the case of any intangible property (as defined in section 367(d)(4)) with respect to which a controlled")
rule S1298E2AThreeHundredPercentOfPayments defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for payment_id: Text;
    for amount: Money;
    when licensee_cfc_intangible_payments_1298e2A(corp, y, payment_id, amount);
    unless payment_to_related_person_1298e2Bi(payment_id)
     and licensee_cfc_intangible_payments_1298e2A(corp, y, payment_id, amount);
    unless license_entered_to_avoid_this_part_1298e2Bii(payment_id)
     and licensee_cfc_intangible_payments_1298e2A(corp, y, payment_id, amount);
    then cfc_asset_basis_increase_for_licensed_intangibles_1298e2A(corp, y, payment_id, amount * 3);
}
