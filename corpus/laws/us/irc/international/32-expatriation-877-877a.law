// §877 (expatriation to avoid tax) and §877A (tax responsibilities of expatriation),
// stage 2d. Dollar thresholds indexed by section 1(f)(3) and net worth, average tax and
// present-value amounts are case inputs. The `sum` over properties is asserted as a case
// total (a `sum all` over a derived relation is a runtime-subset limit, section 111).

// --- §877(a): who is taxed ------------------------------------------------------------------

use self::{
    IRC_S877A_A,
    IRC_S877A_B,
    IRC_S877A_D,
    IRC_S877A_E,
    IRC_S877A_F,
    IRC_S877A_G,
    IRC_S877A_H,
    IRC_S877_A,
    IRC_S877_B,
    IRC_S877_C,
    IRC_S877_D,
    IRC_S877_E,
    IRC_S877_F,
    IRC_S877_G,
    IRC_S877_H,
};

pub relation lost_us_citizenship_877a1(p: us.irc.core::Individual, lost_on: Date) kind empirical {
    label en official "the nonresident alien individual lost United States citizenship on this date";
}
pub relation taxable_year_end_877a1(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, ends_on: Date) kind empirical {
    label en unofficial "the close of the taxable year (a domain anchor for the 10-year period of section 877(a)(1))";
}
pub relation tax_under_877b_after_reduction_877a1(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, tax: Money) kind empirical {
    label en official "the tax imposed pursuant to subsection (b) after any reduction under its last sentence";
}
pub relation tax_under_section_871_without_877_877a1(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, tax: Money) kind empirical {
    label en official "the tax which, without regard to this section, is imposed pursuant to section 871";
}
pub relation average_annual_net_income_tax_877a2A(p: us.irc.core::Individual, average: Money, indexed_threshold: Money) kind empirical {
    label en official "the average annual net income tax (section 38(c)(1)) for the 5 taxable years ending before the loss of citizenship, and the $124,000 amount as increased by the cost-of-living adjustment (section 877(a)(2), last sentence; a case input)";
}
pub relation net_worth_at_loss_of_citizenship_877a2B(p: us.irc.core::Individual, net_worth: Money) kind empirical {
    label en official "the net worth of the individual on the date of the loss of United States citizenship";
}
pub relation fails_to_certify_compliance_877a2C(p: us.irc.core::Individual) kind empirical {
    label en official "the individual fails to certify under penalty of perjury compliance with this title for the 5 preceding taxable years, or fails to submit the evidence the Secretary requires";
}
pub relation section_877_covers_individual_877a2(p: us.irc.core::Individual, prong: Text) kind institutional {
    label en official "section 877 applies to the individual by `A` (average annual net income tax), `B` (net worth) or `C` (failure to certify) (section 877(a)(2))";
}
pub relation exempt_from_877a2AB_877c1(p: us.irc.core::Individual) kind institutional {
    label en official "subparagraphs (A) and (B) of subsection (a)(2) do not apply to an individual described in paragraph (2) or (3) of subsection (c)";
}
@source(IRC_S877_A, relation = formalizes, coverage = exact, quote = "(A) the average annual net income tax (as defined in section 38(c)(1)) of such individual for the period of 5 taxable years ending before the date of the loss of United States citizenship is greater")
rule S877A2AAverageAnnualNetIncomeTax defeasible {
    for p: us.irc.core::Individual;
    for avg: Money;
    for threshold: Money;
    when average_annual_net_income_tax_877a2A(p, avg, threshold)
     and avg > threshold;
    unless exempt_from_877a2AB_877c1(p);
    then section_877_covers_individual_877a2(p, "A");
}
@source(IRC_S877_A, relation = formalizes, coverage = exact, quote = "(B) the net worth of the individual as of such date is $2,000,000 or more, or")
rule S877A2BNetWorth defeasible {
    for p: us.irc.core::Individual;
    for worth: Money;
    when net_worth_at_loss_of_citizenship_877a2B(p, worth)
     and worth >= 2000000.00 USD;
    unless exempt_from_877a2AB_877c1(p);
    then section_877_covers_individual_877a2(p, "B");
}
@source(IRC_S877_A, relation = formalizes, coverage = exact, quote = "(C) such individual fails to certify under penalty of perjury that he has met the requirements of this title for the 5 preceding taxable years or fails to submit such evidence of such compliance as")
rule S877A2CFailureToCertify defeasible {
    for p: us.irc.core::Individual;
    when fails_to_certify_compliance_877a2C(p);
    then section_877_covers_individual_877a2(p, "C");
}
pub relation section_877_taxes_expatriate_877a1(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the nonresident alien individual is taxable for the year in the manner provided in subsection (b): the loss of citizenship was within the 10-year period before the close of the year and the subsection (b) tax exceeds the section 871 tax (section 877(a)(1))";
}
@source(IRC_S877_A, relation = formalizes, coverage = exact, quote = "Every nonresident alien individual to whom this section applies and who, within the 10-year period immediately preceding the close of the taxable year, lost United States citizenship shall be taxable")
rule S877A1TaxedUnderSubsectionB defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for lost: Date;
    for ends: Date;
    for tax_b: Money;
    for tax_871: Money;
    for prong: Text;
    when lost_us_citizenship_877a1(p, lost)
     and taxable_year_end_877a1(p, y, ends)
     and lost <= ends
     and ends <= add_calendar_period(lost, 10 calendar_year)
     and section_877_covers_individual_877a2(p, prong)
     and tax_under_877b_after_reduction_877a1(p, y, tax_b)
     and tax_under_section_871_without_877_877a1(p, y, tax_871)
     and tax_b > tax_871;
    unless section_877_inapplicable_877g1(p, y)
     and lost_us_citizenship_877a1(p, lost);
    then section_877_taxes_expatriate_877a1(p, y);
}

// --- §877(c): exceptions --------------------------------------------------------------------

pub relation citizen_at_birth_of_us_and_another_country_continues_877c2Ai(p: us.irc.core::Individual) kind empirical {
    label en official "the individual became at birth a citizen of the United States and a citizen of another country and continues to be a citizen of the other country";
}
pub relation never_resident_of_united_states_877c2Bi(p: us.irc.core::Individual) kind empirical {
    label en official "the individual was never a resident of the United States (section 7701(b))";
}
pub relation never_held_us_passport_877c2Bii(p: us.irc.core::Individual) kind empirical {
    label en official "the individual has never held a United States passport";
}
pub relation maximum_days_present_in_us_in_10_calendar_years_877c(p: us.irc.core::Individual, days: Integer) kind empirical {
    label en official "the largest number of days the individual was present in the United States in any of the 10 calendar years preceding the loss of citizenship";
}
pub relation born_us_citizen_neither_parent_citizen_877c3AB(p: us.irc.core::Individual) kind empirical {
    label en official "the individual became at birth a citizen of the United States and neither parent was a citizen at the time of the birth";
}
pub relation age_at_loss_of_citizenship_877c3C(p: us.irc.core::Individual, age: Decimal) kind empirical {
    label en official "the age at which the individual lost United States citizenship, in years";
}
pub relation dual_citizen_no_substantial_contacts_877c2(p: us.irc.core::Individual) kind institutional {
    label en official "an individual described in paragraph (2): a dual citizen from birth with no substantial contacts with the United States";
}
@source(IRC_S877_C, relation = formalizes, coverage = exact, quote = "(i) the individual became at birth a citizen of the United States and a citizen of another country and continues to be a citizen of such other country, and")
rule S877C2DualCitizenNoSubstantialContacts defeasible {
    for p: us.irc.core::Individual;
    for days: Integer;
    when citizen_at_birth_of_us_and_another_country_continues_877c2Ai(p)
     and never_resident_of_united_states_877c2Bi(p)
     and never_held_us_passport_877c2Bii(p)
     and maximum_days_present_in_us_in_10_calendar_years_877c(p, days)
     and days <= 30;
    then dual_citizen_no_substantial_contacts_877c2(p);
}
pub relation young_expatriate_born_to_foreign_parents_877c3(p: us.irc.core::Individual) kind institutional {
    label en official "an individual described in paragraph (3): a citizen from birth whose parents were not citizens, who loses citizenship before age 18 1/2 and was not present for more than 30 days in any of the 10 preceding calendar years";
}
@source(IRC_S877_C, relation = formalizes, coverage = exact, quote = "(A) the individual became at birth a citizen of the United States,")
rule S877C3YoungExpatriateNoCitizenParents defeasible {
    for p: us.irc.core::Individual;
    for age: Decimal;
    for days: Integer;
    when born_us_citizen_neither_parent_citizen_877c3AB(p)
     and age_at_loss_of_citizenship_877c3C(p, age)
     and age < 18.5
     and maximum_days_present_in_us_in_10_calendar_years_877c(p, days)
     and days <= 30;
    then young_expatriate_born_to_foreign_parents_877c3(p);
}
@source(IRC_S877_C, relation = formalizes, coverage = exact, quote = "Subparagraphs (A) and (B) of subsection (a)(2) shall not apply to an individual described in paragraph (2) or (3).")
rule S877C1DualCitizenExemptFromAB defeasible {
    for p: us.irc.core::Individual;
    when dual_citizen_no_substantial_contacts_877c2(p);
    then exempt_from_877a2AB_877c1(p);
}
rule S877C1YoungExpatriateExemptFromAB defeasible {
    for p: us.irc.core::Individual;
    when young_expatriate_born_to_foreign_parents_877c3(p);
    then exempt_from_877a2AB_877c1(p);
}

// --- §877(b): the tax --------------------------------------------------------------------------

pub relation tax_under_section_1_or_55_on_877_income_877b(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, tax: Money) kind empirical {
    label en official "the tax computed as provided in section 1 or 55 on the gross income described in section 872(a) as modified by subsection (d), with the connected deductions";
}
pub relation foreign_income_taxes_paid_on_877_income_877b(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, taxes: Money) kind empirical {
    label en official "income, war profits and excess profits taxes (section 903) paid to a foreign country or possession on income of the taxpayer on which tax is imposed solely by reason of this section";
}
pub relation tax_imposed_solely_by_reason_of_877_877b(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, tax: Money) kind institutional {
    label en official "the tax imposed solely by reason of this section, reduced (but not below zero) by the foreign income taxes paid on the income (section 877(b), last sentence)";
}
@source(IRC_S877_B, relation = formalizes, coverage = partial, quote = "For purposes of paragraph (2), the deductions allowed by section 873(b) shall be allowed; and the deduction (for losses not connected with the trade or business if incurred in transactions entered")
rule S877BTaxReducedByForeignTaxes defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for tax: Money;
    for foreign: Money;
    when section_877_taxes_expatriate_877a1(p, y)
     and tax_under_section_1_or_55_on_877_income_877b(p, y, tax)
     and foreign_income_taxes_paid_on_877_income_877b(p, y, foreign);
    then tax_imposed_solely_by_reason_of_877_877b(p, y, max(tax - foreign, 0.00 USD));
}
pub relation capital_loss_carryover_1212b_877b(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, ded_id: Text) kind empirical {
    label en official "the deduction is the capital loss carryover provided by section 1212(b)";
}
pub relation deduction_connected_with_877_gross_income_877b2(ded_id: Text) kind empirical {
    label en official "the deduction is connected with the gross income included under this section";
}
pub relation deduction_item_877b(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, ded_id: Text, amount: Money) kind empirical {
    label en official "a deduction claimed against the income taxed under this section";
}
pub relation deduction_allowed_877b2(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, ded_id: Text, amount: Money) kind institutional {
    label en official "the deduction is allowed if and to the extent connected with the gross income included under this section, except the capital loss carryover of section 1212(b) (section 877(b)(2))";
}
@source(IRC_S877_B, relation = formalizes, coverage = exact, quote = "(2) the deductions shall be allowed if and to the extent that they are connected with the gross income included under this section, except that the capital loss carryover provided by section 1212(b)")
rule S877B2DeductionConnectedWithIncome defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for ded_id: Text;
    for amount: Money;
    when deduction_item_877b(p, y, ded_id, amount)
     and deduction_connected_with_877_gross_income_877b2(ded_id);
    unless capital_loss_carryover_1212b_877b(p, y, ded_id)
     and deduction_item_877b(p, y, ded_id, amount);
    then deduction_allowed_877b2(p, y, ded_id, amount);
}

// --- §877(d): source rules -----------------------------------------------------------------------

pub relation expatriate_gain_or_income_item_877d1(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, item_id: Text, kind: Text, amount: Money) kind empirical {
    label en official "an item of the expatriate's gross income of the kind: `property_in_us` (gain on property other than stock or debt located in the United States), `domestic_stock_or_us_debt` (gain on stock of a domestic corporation or debt obligations of United States persons, the United States, a State or the District of Columbia) or `foreign_corporation_stock` (income or gain from stock in a foreign corporation)";
}
pub relation ownership_percentage_of_foreign_corporation_2_year_877d1Ci(p: us.irc.core::Individual, item_id: Text, percentage: Decimal) kind empirical {
    label en official "the greater of the voting power or value percentage of the foreign corporation owned (section 958(a)) or considered owned (section 958(b)) at any time during the 2-year period ending on the date of the loss of citizenship";
}
pub relation earnings_and_profits_before_loss_during_ownership_877d1Cii(p: us.irc.core::Individual, item_id: Text, earnings: Money) kind empirical {
    label en official "the earnings and profits attributable to the stock earned or accumulated before the loss of citizenship and during periods the ownership requirement is met";
}
pub relation us_source_income_877d1(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, item_id: Text, amount: Money) kind institutional {
    label en official "the item is treated as income from sources within the United States for purposes of subsection (b) (section 877(d)(1))";
}
@source(IRC_S877_D, relation = formalizes, coverage = exact, quote = "Gains on the sale or exchange of property (other than stock or debt obligations) located in the United States.")
rule S877D1APropertyInUsGains defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for amount: Money;
    when expatriate_gain_or_income_item_877d1(p, y, item_id, "property_in_us", amount);
    then us_source_income_877d1(p, y, item_id, amount);
}
@source(IRC_S877_D, relation = formalizes, coverage = exact, quote = "Gains on the sale or exchange of stock issued by a domestic corporation or debt obligations of United States persons or of the United States, a State or political subdivision thereof, or the District")
rule S877D1BDomesticStockAndUsDebtGains defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for amount: Money;
    when expatriate_gain_or_income_item_877d1(p, y, item_id, "domestic_stock_or_us_debt", amount);
    then us_source_income_877d1(p, y, item_id, amount);
}
@source(IRC_S877_D, relation = formalizes, coverage = exact, quote = "Any income or gain derived from stock in a foreign corporation but only—")
rule S877D1CForeignCorporationStockIncome defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for amount: Money;
    for pct: Decimal;
    for earnings: Money;
    when expatriate_gain_or_income_item_877d1(p, y, item_id, "foreign_corporation_stock", amount)
     and ownership_percentage_of_foreign_corporation_2_year_877d1Ci(p, item_id, pct)
     and pct > 50.0
     and earnings_and_profits_before_loss_during_ownership_877d1Cii(p, item_id, earnings);
    then us_source_income_877d1(p, y, item_id, min(amount, earnings));
}
pub relation exchange_of_property_after_loss_of_citizenship_877d2(p: us.irc.core::Individual, item_id: Text, exchanged_on: Date, unrecognized_gain: Money) kind empirical {
    label en official "an exchange of property, and the gain that would not (but for paragraph (2)) be recognized on the exchange";
}
pub relation exchange_income_source_before_us_after_foreign_877d2B(item_id: Text) kind empirical {
    label en official "income derived from the property was from sources within the United States (or, if none, would have been), and income derived from the property acquired in the exchange would be from sources outside the United States";
}
pub relation agreement_with_secretary_us_source_treatment_877d2C(p: us.irc.core::Individual, item_id: Text) kind empirical {
    label en official "the individual enters into an agreement with the Secretary that income or gain from the property acquired in the exchange during the 10-year period is treated as from sources within the United States";
}
pub relation gain_recognized_on_source_changing_exchange_877d2A(p: us.irc.core::Individual, item_id: Text, gain: Money) kind institutional {
    label en official "notwithstanding any other provision, the property is treated as sold for its fair market value on the date of the exchange and the gain is recognized for the taxable year including that date (section 877(d)(2)(A))";
}
@source(IRC_S877_D, relation = formalizes, coverage = exact, quote = "This paragraph shall apply to any exchange during the 10-year period beginning on the date the individual loses United States citizenship if—")
rule S877D2ExchangeGainRecognized defeasible {
    for p: us.irc.core::Individual;
    for item_id: Text;
    for exchanged_on: Date;
    for gain: Money;
    for lost: Date;
    when exchange_of_property_after_loss_of_citizenship_877d2(p, item_id, exchanged_on, gain)
     and lost_us_citizenship_877a1(p, lost)
     and exchanged_on >= lost
     and exchanged_on <= add_calendar_period(lost, 10 calendar_year)
     and exchange_income_source_before_us_after_foreign_877d2B(item_id);
    unless agreement_with_secretary_us_source_treatment_877d2C(p, item_id)
     and exchange_of_property_after_loss_of_citizenship_877d2(p, item_id, exchanged_on, gain);
    then gain_recognized_on_source_changing_exchange_877d2A(p, item_id, gain);
}
pub relation contribution_to_described_corporation_877d4A(p: us.irc.core::Individual, corp: us.irc.core::Corporation, property_id: Text, contributed_on: Date) kind empirical {
    label en official "the individual contributes property to a corporation, and income from the property immediately before the contribution was from sources within the United States (or would have been)";
}
pub relation corporation_would_be_cfc_with_individual_us_shareholder_877d4B(p: us.irc.core::Individual, corp: us.irc.core::Corporation) kind empirical {
    label en official "were the individual a United States citizen, the corporation would be a controlled foreign corporation (section 957) and the individual a United States shareholder (section 951(b)) with respect to it";
}
pub relation corporation_income_on_contributed_property_attributed_to_individual_877d4A(p: us.irc.core::Individual, corp: us.irc.core::Corporation, property_id: Text) kind institutional {
    label en official "income or gain on the contributed property received or accrued by the corporation is treated as received or accrued directly by the individual (section 877(d)(4)(A))";
}
@source(IRC_S877_D, relation = formalizes, coverage = exact, quote = "any income or gain on such property (or any other property which has a basis determined in whole or part by reference to such property) received or accrued by the corporation shall be treated as")
rule S877D4ContributedPropertyIncomeAttributed defeasible {
    for p: us.irc.core::Individual;
    for corp: us.irc.core::Corporation;
    for property_id: Text;
    for contributed_on: Date;
    for lost: Date;
    when contribution_to_described_corporation_877d4A(p, corp, property_id, contributed_on)
     and corporation_would_be_cfc_with_individual_us_shareholder_877d4B(p, corp)
     and lost_us_citizenship_877a1(p, lost)
     and contributed_on >= lost
     and contributed_on <= add_calendar_period(lost, 10 calendar_year);
    then corporation_income_on_contributed_property_attributed_to_individual_877d4A(p, corp, property_id);
}

// --- §877(e): long-term residents --------------------------------------------------------------------

pub relation lawful_permanent_resident_taxable_years_in_15_877e2(p: us.irc.core::Individual, years: Integer) kind empirical {
    label en official "the number of taxable years in the 15 taxable years ending with the year of the event in which the individual is a lawful permanent resident, not counting years in which the individual is treated as a resident of a foreign country under a treaty and does not waive its benefits";
}
pub relation long_term_resident_877e2(p: us.irc.core::Individual) kind institutional {
    label en official "a long-term resident: a lawful permanent resident in at least 8 of the 15 taxable years (section 877(e)(2))";
}
@source(IRC_S877_E, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, the term \"long-term resident\" means any individual (other than a citizen of the United States) who is a lawful permanent resident of the United States in at least 8")
rule S877E2LongTermResident defeasible {
    for p: us.irc.core::Individual;
    for years: Integer;
    when lawful_permanent_resident_taxable_years_in_15_877e2(p, years)
     and years >= 8;
    then long_term_resident_877e2(p);
}
pub relation ceased_to_be_lawful_permanent_resident_on_877e1(p: us.irc.core::Individual, ceased_on: Date) kind empirical {
    label en official "the individual ceases to be a lawful permanent resident of the United States (section 7701(b)(6)) on this date";
}
pub relation treated_as_citizen_who_lost_citizenship_on_877e1(p: us.irc.core::Individual, on: Date) kind institutional {
    label en official "a long-term resident who ceases to be a lawful permanent resident is treated for this section and sections 2107, 2501 and 6039G as a citizen who lost citizenship on that date (section 877(e)(1))";
}
@source(IRC_S877_E, relation = formalizes, coverage = exact, quote = "Any long-term resident of the United States who ceases to be a lawful permanent resident of the United States (within the meaning of section 7701(b)(6)) shall be treated for purposes of this section")
rule S877E1LongTermResidentTreatedAsCitizenWhoExpatriated defeasible {
    for p: us.irc.core::Individual;
    for on: Date;
    when ceased_to_be_lawful_permanent_resident_on_877e1(p, on)
     and long_term_resident_877e2(p);
    then treated_as_citizen_who_lost_citizenship_on_877e1(p, on);
}
pub relation property_held_on_first_residence_877e3B(p: us.irc.core::Individual, property_id: Text, adjusted_basis: Money, fair_market_value: Money) kind empirical {
    label en official "property held by the long-term resident on the date the individual first became a resident of the United States, with its adjusted basis and fair market value on that date";
}
pub relation elects_not_to_apply_basis_step_up_877e3B(p: us.irc.core::Individual) kind empirical {
    label en official "the individual elects not to have the basis rule apply (irrevocable)";
}
pub relation basis_for_877_tax_877e3B(p: us.irc.core::Individual, property_id: Text, basis: Money) kind institutional {
    label en official "solely for determining the tax by reason of this subsection, the property has a basis on the date the individual first became a resident of not less than its fair market value on that date (section 877(e)(3)(B))";
}
@source(IRC_S877_E, relation = formalizes, coverage = exact, quote = "Solely for purposes of determining any tax imposed by reason of this subsection, property which was held by the long-term resident on the date the individual first became a resident of the United")
rule S877E3BBasisNotLessThanFairMarketValue defeasible {
    for p: us.irc.core::Individual;
    for property_id: Text;
    for basis: Money;
    for fmv: Money;
    when property_held_on_first_residence_877e3B(p, property_id, basis, fmv);
    unless elects_not_to_apply_basis_step_up_877e3B(p)
     and property_held_on_first_residence_877e3B(p, property_id, basis, fmv);
    then basis_for_877_tax_877e3B(p, property_id, max(basis, fmv));
}
rule S877E3BBasisElectionKeepsBasis defeasible {
    for p: us.irc.core::Individual;
    for property_id: Text;
    for basis: Money;
    for fmv: Money;
    when property_held_on_first_residence_877e3B(p, property_id, basis, fmv)
     and elects_not_to_apply_basis_step_up_877e3B(p);
    then basis_for_877_tax_877e3B(p, property_id, basis);
}

// --- §877(f), (g), (h) ----------------------------------------------------------------------------------

pub relation secretary_establishes_reasonable_belief_of_substantial_reduction_877f(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the Secretary establishes that it is reasonable to believe the loss of citizenship would, but for this section, result in a substantial reduction for the year in the taxes on the probable income";
}
pub relation burden_on_individual_to_prove_no_tax_avoidance_purpose_877f(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the burden of proving that the loss of citizenship did not have as one of its principal purposes the avoidance of taxes is on the individual (section 877(f))";
}
@source(IRC_S877_F, relation = formalizes, coverage = exact, quote = "If the Secretary establishes that it is reasonable to believe that an individual's loss of United States citizenship would, but for this section, result in a substantial reduction for the taxable")
rule S877FBurdenOnIndividual defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    when secretary_establishes_reasonable_belief_of_substantial_reduction_877f(p, y);
    then burden_on_individual_to_prove_no_tax_avoidance_purpose_877f(p, y);
}
pub relation days_present_in_us_in_calendar_year_877g(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, days: Integer) kind empirical {
    label en official "the number of days of physical presence in the United States in the calendar year ending in the taxable year";
}
pub relation days_performing_services_for_employer_877g2A(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, days: Integer) kind empirical {
    label en official "the number of days of presence on which the individual performs services in the United States for an employer";
}
pub relation employer_related_or_fails_regulatory_requirements_877g2A(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the employer is related (sections 267 and 707) to the individual, or fails to meet the requirements the Secretary prescribes";
}
pub relation becomes_citizen_or_resident_of_birth_country_and_fully_taxed_877g2B(p: us.irc.core::Individual) kind empirical {
    label en official "the individual becomes, within a reasonable period, a citizen or resident of the country of the individual's, spouse's or a parent's birth, and becomes fully liable for income tax there";
}
pub relation present_30_days_or_less_each_year_of_10_877g2C(p: us.irc.core::Individual) kind empirical {
    label en official "for each year in the 10-year period ending on the date of loss of citizenship or termination of residency, the individual was physically present in the United States for 30 days or less";
}
pub relation effective_days_present_877g(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, days: Integer) kind institutional {
    label en official "days of presence after disregarding, for an individual described in subparagraph (B) or (C), up to 30 days of services for an unrelated employer (section 877(g)(2))";
}
pub relation service_day_disregard_applies_877g2(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the individual is described in subparagraph (B) or (C) of section 877(g)(2) and the employer is neither related nor failing the Secretary's requirements";
}
@source(IRC_S877_G, relation = formalizes, coverage = exact, quote = "In the case of an individual described in any of the following subparagraphs of this paragraph, a day of physical presence in the United States shall be disregarded if the individual is performing")
rule S877G2BDescribedIndividualDisregard defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    when becomes_citizen_or_resident_of_birth_country_and_fully_taxed_877g2B(p)
     and days_present_in_us_in_calendar_year_877g(p, y, _);
    unless employer_related_or_fails_regulatory_requirements_877g2A(p, y)
     and days_present_in_us_in_calendar_year_877g(p, y, _);
    then service_day_disregard_applies_877g2(p, y);
}
rule S877G2CDescribedIndividualDisregard defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    when present_30_days_or_less_each_year_of_10_877g2C(p)
     and days_present_in_us_in_calendar_year_877g(p, y, _);
    unless employer_related_or_fails_regulatory_requirements_877g2A(p, y)
     and days_present_in_us_in_calendar_year_877g(p, y, _);
    then service_day_disregard_applies_877g2(p, y);
}
@source(IRC_S877_G, relation = formalizes, coverage = exact, quote = "Not more than 30 days during any calendar year may be disregarded under this subparagraph.")
rule S877G2AServiceDaysDisregarded defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for days: Integer;
    for service_days: Integer;
    when days_present_in_us_in_calendar_year_877g(p, y, days)
     and days_performing_services_for_employer_877g2A(p, y, service_days)
     and service_day_disregard_applies_877g2(p, y);
    then effective_days_present_877g(p, y, days - min(service_days, 30));
}
rule S877G2NoDisregardOtherwise defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for days: Integer;
    when days_present_in_us_in_calendar_year_877g(p, y, days);
    unless service_day_disregard_applies_877g2(p, y)
     and days_present_in_us_in_calendar_year_877g(p, y, days);
    then effective_days_present_877g(p, y, days);
}
pub relation section_877_inapplicable_877g1(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind institutional {
    label en official "section 877 does not apply for a taxable year in the 10-year period in which the individual is physically present in the United States on more than 30 days in the calendar year ending in the year, and the individual is treated as a citizen or resident for the year (section 877(g)(1))";
}
@source(IRC_S877_G, relation = formalizes, coverage = exact, quote = "This section shall not apply to any individual to whom this section would otherwise apply for any taxable year during the 10-year period referred to in subsection (a) in which such individual is")
rule S877G1PresentMoreThanThirtyDays defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for days: Integer;
    when effective_days_present_877g(p, y, days)
     and days > 30;
    then section_877_inapplicable_877g1(p, y);
}
pub relation expatriation_date_877h(p: us.irc.core::Individual, on: Date) kind empirical {
    label en official "the expatriation date (section 877A(g)(3)) of the individual";
}
pub relation section_877_not_applicable_after_expatriation_877h(p: us.irc.core::Individual) kind institutional {
    label en official "section 877 does not apply to an individual whose expatriation date is on or after the date of the enactment of subsection (h) (June 17, 2008, Pub. L. 110-245, section 301(g)(1)) (section 877(h))";
}
@source(IRC_S877_H, relation = formalizes, coverage = exact, quote = "This section shall not apply to any individual whose expatriation date (as defined in section 877A(g)(3)) is on or after the date of the enactment of this subsection.")
rule S877HNotApplicableAfterJune172008 defeasible {
    for p: us.irc.core::Individual;
    for on: Date;
    when expatriation_date_877h(p, on)
     and on >= @2008-06-17;
    then section_877_not_applicable_after_expatriation_877h(p);
}

// --- §877A(a)-(c): mark-to-market -------------------------------------------------------------------------

pub relation expatriate_877ag2(p: us.irc.core::Individual, kind: Text) kind empirical {
    label en official "an expatriate: `citizen` (a United States citizen who relinquishes citizenship) or `long_term_resident` (a long-term resident who ceases to be a lawful permanent resident)";
}
pub relation relinquishment_event_877ag4(p: us.irc.core::Individual, on: Date, kind: Text) kind empirical {
    label en official "an event of relinquishment of citizenship on this date: `renunciation` (before a diplomatic or consular officer), `voluntary_statement` (signed statement to the Department of State), `certificate_of_loss` (certificate of loss of nationality issued) or `naturalization_cancelled` (a court cancels a naturalized citizen's certificate)";
}
pub relation certificate_of_loss_of_nationality_issued_877ag4(p: us.irc.core::Individual) kind empirical {
    label en official "the renunciation or voluntary relinquishment is subsequently approved by the issuance of a certificate of loss of nationality";
}
pub relation valid_relinquishment_event_877ag4(p: us.irc.core::Individual, on: Date) kind institutional {
    label en official "a relinquishment event that counts: subparagraphs (A) and (B) only if approved by a certificate of loss of nationality (section 877A(g)(4), last sentence)";
}
@source(IRC_S877A_G, relation = formalizes, coverage = exact, quote = "(A) the date the individual renounces his United States nationality before a diplomatic or consular officer of the United States pursuant to paragraph (5) of section 349(a) of the Immigration and")
rule S877AG4ARenunciationCounts defeasible {
    for p: us.irc.core::Individual;
    for on: Date;
    when relinquishment_event_877ag4(p, on, "renunciation")
     and certificate_of_loss_of_nationality_issued_877ag4(p);
    then valid_relinquishment_event_877ag4(p, on);
}
@source(IRC_S877A_G, relation = formalizes, coverage = exact, quote = "(B) the date the individual furnishes to the United States Department of State a signed statement of voluntary relinquishment of United States nationality confirming the performance of an act of")
rule S877AG4BVoluntaryStatementCounts defeasible {
    for p: us.irc.core::Individual;
    for on: Date;
    when relinquishment_event_877ag4(p, on, "voluntary_statement")
     and certificate_of_loss_of_nationality_issued_877ag4(p);
    then valid_relinquishment_event_877ag4(p, on);
}
@source(IRC_S877A_G, relation = formalizes, coverage = exact, quote = "(C) the date the United States Department of State issues to the individual a certificate of loss of nationality, or")
rule S877AG4CCertificateOfLossCounts defeasible {
    for p: us.irc.core::Individual;
    for on: Date;
    when relinquishment_event_877ag4(p, on, "certificate_of_loss");
    then valid_relinquishment_event_877ag4(p, on);
}
@source(IRC_S877A_G, relation = formalizes, coverage = exact, quote = "(D) the date a court of the United States cancels a naturalized citizen's certificate of naturalization.")
rule S877AG4DNaturalizationCancelledCounts defeasible {
    for p: us.irc.core::Individual;
    for on: Date;
    when relinquishment_event_877ag4(p, on, "naturalization_cancelled");
    then valid_relinquishment_event_877ag4(p, on);
}
pub relation relinquishment_date_877ag4(p: us.irc.core::Individual, on: Date) kind institutional {
    label en official "a citizen is treated as relinquishing citizenship on the earliest of the dates in subparagraphs (A) to (D) (section 877A(g)(4))";
}
@source(IRC_S877A_G, relation = formalizes, coverage = exact, quote = "A citizen shall be treated as relinquishing his United States citizenship on the earliest of—")
rule S877AG4EarliestRelinquishmentDate defeasible {
    for p: us.irc.core::Individual;
    for on: Date;
    for earlier: Date;
    when valid_relinquishment_event_877ag4(p, on);
    unless valid_relinquishment_event_877ag4(p, earlier)
     and earlier < on
     and valid_relinquishment_event_877ag4(p, on);
    then relinquishment_date_877ag4(p, on);
}
pub relation ceased_lawful_permanent_resident_on_877ag3B(p: us.irc.core::Individual, on: Date) kind empirical {
    label en official "a long-term resident ceases to be a lawful permanent resident of the United States (section 7701(b)(6)) on this date";
}
pub relation expatriation_date_877ag3(p: us.irc.core::Individual, on: Date) kind institutional {
    label en official "the expatriation date: the date a citizen relinquishes citizenship, or the date a long-term resident ceases to be a lawful permanent resident (section 877A(g)(3))";
}
@source(IRC_S877A_G, relation = formalizes, coverage = exact, quote = "(A) the date an individual relinquishes United States citizenship, or")
rule S877AG3ACitizenRelinquishmentDate defeasible {
    for p: us.irc.core::Individual;
    for on: Date;
    when expatriate_877ag2(p, "citizen")
     and relinquishment_date_877ag4(p, on);
    then expatriation_date_877ag3(p, on);
}
@source(IRC_S877A_G, relation = formalizes, coverage = exact, quote = "(B) in the case of a long-term resident of the United States, the date on which the individual ceases to be a lawful permanent resident of the United States (within the meaning of section 7701(b)(6)).")
rule S877AG3BLongTermResidentCessationDate defeasible {
    for p: us.irc.core::Individual;
    for on: Date;
    when expatriate_877ag2(p, "long_term_resident")
     and long_term_resident_877e2(p)
     and ceased_lawful_permanent_resident_on_877ag3B(p, on);
    then expatriation_date_877ag3(p, on);
}
pub relation dual_citizen_at_birth_taxed_as_resident_of_other_country_877ag1Bi(p: us.irc.core::Individual) kind empirical {
    label en official "the individual became at birth a citizen of the United States and of another country and, on the expatriation date, continues to be a citizen of and is taxed as a resident of that country";
}
pub relation taxable_years_resident_in_15_year_period_877ag1B(p: us.irc.core::Individual, years: Integer) kind empirical {
    label en official "the number of taxable years in the 15-taxable year period ending with the year of the expatriation date in which the individual was a resident of the United States (section 7701(b)(1)(A)(ii)), or before the date of relinquishment";
}
pub relation relinquished_before_age_18_and_a_half_877ag1Bii(p: us.irc.core::Individual) kind empirical {
    label en official "the individual's relinquishment of United States citizenship occurs before the individual attains age 18 1/2";
}
pub relation excluded_from_prongs_A_and_B_877ag1B(p: us.irc.core::Individual) kind institutional {
    label en official "the individual is not treated as meeting subparagraph (A) or (B) of section 877(a)(2): a dual citizen from birth resident for not more than 10 taxable years of the 15, or a person who relinquishes before age 18 1/2 and was resident for not more than 10 taxable years (section 877A(g)(1)(B))";
}
@source(IRC_S877A_G, relation = formalizes, coverage = exact, quote = "(i) the individual—")
rule S877AG1BiDualCitizenFewResidentYears defeasible {
    for p: us.irc.core::Individual;
    for years: Integer;
    when dual_citizen_at_birth_taxed_as_resident_of_other_country_877ag1Bi(p)
     and taxable_years_resident_in_15_year_period_877ag1B(p, years)
     and years <= 10;
    then excluded_from_prongs_A_and_B_877ag1B(p);
}
@source(IRC_S877A_G, relation = formalizes, coverage = exact, quote = "(ii)(I) the individual's relinquishment of United States citizenship occurs before such individual attains age 18½, and")
rule S877AG1BiiRelinquishedBefore18AndAHalf defeasible {
    for p: us.irc.core::Individual;
    for years: Integer;
    when relinquished_before_age_18_and_a_half_877ag1Bii(p)
     and taxable_years_resident_in_15_year_period_877ag1B(p, years)
     and years <= 10;
    then excluded_from_prongs_A_and_B_877ag1B(p);
}
pub relation covered_expatriate_877ag1(p: us.irc.core::Individual) kind institutional {
    label en official "a covered expatriate: an expatriate who meets the requirements of subparagraph (A), (B) or (C) of section 877(a)(2), subject to the exclusion of paragraph (1)(B) (section 877A(g)(1)(A))";
}
@source(IRC_S877A_G, relation = formalizes, coverage = exact, quote = "The term \"covered expatriate\" means an expatriate who meets the requirements of subparagraph (A), (B), or (C) of section 877(a)(2).")
rule S877AG1ACoveredByAverageTaxOrNetWorth defeasible {
    for p: us.irc.core::Individual;
    for kind: Text;
    for prong: Text;
    when expatriate_877ag2(p, kind)
     and section_877_covers_individual_877a2(p, prong);
    unless excluded_from_prongs_A_and_B_877ag1B(p)
     and expatriate_877ag2(p, kind)
     and section_877_covers_individual_877a2(p, prong)
     and prong_is_A_or_B_877ag1B(p, prong);
    then covered_expatriate_877ag1(p);
}
pub relation prong_is_A_or_B_877ag1B(p: us.irc.core::Individual, prong: Text) kind institutional {
    label en official "the prong of section 877(a)(2) met is (A) or (B)";
}
rule S877AG1BProngA defeasible {
    for p: us.irc.core::Individual;
    when section_877_covers_individual_877a2(p, "A");
    then prong_is_A_or_B_877ag1B(p, "A");
}
rule S877AG1BProngB defeasible {
    for p: us.irc.core::Individual;
    when section_877_covers_individual_877a2(p, "B");
    then prong_is_A_or_B_877ag1B(p, "B");
}
pub relation property_of_covered_expatriate_877a1(p: us.irc.core::Individual, property_id: Text, fair_market_value: Money, adjusted_basis: Money) kind empirical {
    label en official "property of a covered expatriate on the day before the expatriation date, its fair market value and its adjusted basis";
}
pub relation property_excluded_by_877ac(p: us.irc.core::Individual, property_id: Text) kind empirical {
    label en official "the property is a deferred compensation item, a specified tax deferred account or an interest in a nongrantor trust (section 877A(c)(1)-(3))";
}
pub relation deemed_sale_gain_or_loss_877a1(p: us.irc.core::Individual, property_id: Text, gain: Money) kind institutional {
    label en official "the gain (positive) or loss (negative) on the treatment of the property as sold on the day before the expatriation date for its fair market value (section 877A(a)(1))";
}
@source(IRC_S877A_A, relation = formalizes, coverage = exact, quote = "All property of a covered expatriate shall be treated as sold on the day before the expatriation date for its fair market value.")
rule S877AA1DeemedSaleGainOrLoss defeasible {
    for p: us.irc.core::Individual;
    for property_id: Text;
    for fmv: Money;
    for basis: Money;
    when property_of_covered_expatriate_877a1(p, property_id, fmv, basis)
     and covered_expatriate_877ag1(p);
    unless property_excluded_by_877ac(p, property_id)
     and property_of_covered_expatriate_877a1(p, property_id, fmv, basis);
    then deemed_sale_gain_or_loss_877a1(p, property_id, fmv - basis);
}
pub relation total_gain_from_deemed_sales_877a3(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, total: Money, exclusion_amount: Money) kind empirical {
    label en official "the total gain that would (but for paragraph (3)) be includible by reason of paragraph (1), and the $600,000 exclusion amount as adjusted for the calendar year (a case input)";
}
pub relation gain_includible_after_exclusion_877a3(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, includible: Money) kind institutional {
    label en official "the amount includible in gross income by reason of paragraph (1), reduced (but not below zero) by the exclusion amount (section 877A(a)(3)(A))";
}
@source(IRC_S877A_A, relation = formalizes, coverage = exact, quote = "The amount which would (but for this paragraph) be includible in the gross income of any individual by reason of paragraph (1) shall be reduced (but not below zero) by $600,000.")
rule S877AA3ExclusionAmount defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for total: Money;
    for exclusion: Money;
    when total_gain_from_deemed_sales_877a3(p, y, total, exclusion);
    then gain_includible_after_exclusion_877a3(p, y, max(total - exclusion, 0.00 USD));
}
pub relation section_1091_not_applicable_877a2B(p: us.irc.core::Individual, property_id: Text) kind institutional {
    label en official "section 1091 (wash sales) does not apply to any loss arising from the deemed sale (section 877A(a)(2)(B)); the loss is taken into account for the taxable year of the sale to the extent otherwise provided";
}
@source(IRC_S877A_A, relation = formalizes, coverage = exact, quote = "(B) any loss arising from such sale shall be taken into account for the taxable year of the sale to the extent otherwise provided by this title, except that section 1091 shall not apply to any such")
rule S877AA2BLossWithoutWashSaleRule defeasible {
    for p: us.irc.core::Individual;
    for property_id: Text;
    for gain: Money;
    when deemed_sale_gain_or_loss_877a1(p, property_id, gain)
     and gain < 0.00 USD;
    then section_1091_not_applicable_877a2B(p, property_id);
}

// --- §877A(b): deferral election --------------------------------------------------------------------------------

pub relation elects_deferral_of_payment_877ab1(p: us.irc.core::Individual, property_id: Text) kind empirical {
    label en official "the taxpayer elects the application of subsection (b) with respect to property treated as sold by reason of subsection (a)";
}
pub relation adequate_security_bond_877ab4Bi(property_id: Text) kind empirical {
    label en official "a bond furnished to and accepted by the Secretary, conditioned on payment of tax and interest, meeting the requirements of section 6325";
}
pub relation adequate_security_other_877ab4Bii(property_id: Text) kind empirical {
    label en official "another form of security for payment (including letters of credit) meeting the Secretary's requirements";
}
pub relation adequate_security_877ab4(property_id: Text) kind institutional {
    label en official "adequate security for the deferred payment (section 877A(b)(4))";
}
@source(IRC_S877A_B, relation = formalizes, coverage = exact, quote = "(i) it is a bond which is furnished to, and accepted by, the Secretary, which is conditioned on the payment of tax (and interest thereon), and which meets the requirements of section 6325, or")
rule S877AB4BiBondIsAdequateSecurity defeasible {
    for property_id: Text;
    when adequate_security_bond_877ab4Bi(property_id);
    then adequate_security_877ab4(property_id);
}
@source(IRC_S877A_B, relation = formalizes, coverage = exact, quote = "(ii) it is another form of security for such payment (including letters of credit) that meets such requirements as the Secretary may prescribe.")
rule S877AB4BiiOtherSecurityIsAdequate defeasible {
    for property_id: Text;
    when adequate_security_other_877ab4Bii(property_id);
    then adequate_security_877ab4(property_id);
}
pub relation irrevocable_treaty_waiver_877ab5(p: us.irc.core::Individual) kind empirical {
    label en official "the taxpayer makes an irrevocable waiver of any treaty right that would preclude assessment or collection of tax imposed by reason of this section";
}
pub relation deferral_election_requirements_met_877ab(p: us.irc.core::Individual, property_id: Text) kind institutional {
    label en official "the election may be made only with adequate security (paragraph (4)) and an irrevocable treaty waiver (paragraph (5))";
}
@source(IRC_S877A_B, relation = formalizes, coverage = exact, quote = "No election may be made under paragraph (1) unless the taxpayer makes an irrevocable waiver of any right under any treaty of the United States which would preclude assessment or collection of any tax")
rule S877AB45DeferralRequirementsMet defeasible {
    for p: us.irc.core::Individual;
    for property_id: Text;
    when adequate_security_877ab4(property_id)
     and irrevocable_treaty_waiver_877ab5(p)
     and property_of_covered_expatriate_877a1(p, property_id, _, _);
    then deferral_election_requirements_met_877ab(p, property_id);
}
pub relation payment_time_extended_877ab1(p: us.irc.core::Individual, property_id: Text) kind institutional {
    label en official "the time for payment of the additional tax attributable to the property is extended until the due date of the return for the taxable year in which the property is disposed of (section 877A(b)(1))";
}
@source(IRC_S877A_B, relation = formalizes, coverage = exact, quote = "If the taxpayer elects the application of this subsection with respect to any property treated as sold by reason of subsection (a), the time for payment of the additional tax attributable to such")
rule S877AB1DeferralElectionPower defeasible {
    for p: us.irc.core::Individual;
    for property_id: Text;
    when elects_deferral_of_payment_877ab1(p, property_id);
    then power S877AB1DeferralElection {
        holder p;
        over p;
        exercise elects_deferral_of_payment_877ab1(p, property_id);
        valid_when deferral_election_requirements_met_877ab(p, property_id);
        effect create(payment_time_extended_877ab1(p, property_id));
    };
}
pub relation additional_tax_and_gains_877ab2(p: us.irc.core::Individual, property_id: Text, additional_tax: Money, gain_on_property: Money, total_gain: Money) kind empirical {
    label en official "the additional tax imposed for the year solely by reason of subsection (a), the gain taken into account with respect to the property and the total gain with respect to all property";
}
pub relation additional_tax_attributable_to_property_877ab2(p: us.irc.core::Individual, property_id: Text, tax: Money) kind institutional {
    label en official "the additional tax attributable to any property bears the same ratio to the additional tax as the gain on the property bears to the total gain (section 877A(b)(2))";
}
@source(IRC_S877A_B, relation = formalizes, coverage = exact, quote = "For purposes of paragraph (1), the additional tax attributable to any property is an amount which bears the same ratio to the additional tax imposed by this chapter for the taxable year solely by")
rule S877AB2TaxAttributableToProperty defeasible {
    for p: us.irc.core::Individual;
    for property_id: Text;
    for additional: Money;
    for gain: Money;
    for total: Money;
    when additional_tax_and_gains_877ab2(p, property_id, additional, gain, total)
     and total > 0.00 USD;
    then additional_tax_attributable_to_property_877ab2(p, property_id, round(additional * (gain / total), 2, "HALF_UP"));
}

// --- §877A(d): deferred compensation ------------------------------------------------------------------------------

pub relation deferred_compensation_item_kind_877ad4(item_id: Text, kind: Text) kind empirical {
    label en official "the kind of the item: `plan_219g5` (an interest in a plan described in section 219(g)(5)), `foreign_pension` (an interest in a foreign pension plan or similar arrangement), `deferred_compensation` or `property_for_services` (property or a right to property received in connection with services, to the extent not previously taken into account under section 83)";
}
pub relation deferred_compensation_item_877ad4(item_id: Text) kind institutional {
    label en official "a deferred compensation item (section 877A(d)(4))";
}
@source(IRC_S877A_D, relation = formalizes, coverage = exact, quote = "(A) any interest in a plan or arrangement described in section 219(g)(5),")
rule S877AD4AInterestInPlan219g5 defeasible {
    for item_id: Text;
    when deferred_compensation_item_kind_877ad4(item_id, "plan_219g5");
    then deferred_compensation_item_877ad4(item_id);
}
@source(IRC_S877A_D, relation = formalizes, coverage = exact, quote = "(B) any interest in a foreign pension plan or similar retirement arrangement or program,")
rule S877AD4BForeignPension defeasible {
    for item_id: Text;
    when deferred_compensation_item_kind_877ad4(item_id, "foreign_pension");
    then deferred_compensation_item_877ad4(item_id);
}
@source(IRC_S877A_D, relation = formalizes, coverage = exact, quote = "(C) any item of deferred compensation, and")
rule S877AD4CDeferredCompensation defeasible {
    for item_id: Text;
    when deferred_compensation_item_kind_877ad4(item_id, "deferred_compensation");
    then deferred_compensation_item_877ad4(item_id);
}
@source(IRC_S877A_D, relation = formalizes, coverage = exact, quote = "(D) any property, or right to property, which the individual is entitled to receive in connection with the performance of services to the extent not previously taken into account under section 83 or")
rule S877AD4DPropertyForServices defeasible {
    for item_id: Text;
    when deferred_compensation_item_kind_877ad4(item_id, "property_for_services");
    then deferred_compensation_item_877ad4(item_id);
}
pub relation payor_is_united_states_person_877ad3Ai(item_id: Text) kind empirical {
    label en official "the payor of the item is a United States person";
}
pub relation foreign_payor_elects_and_meets_requirements_877ad3Aii(item_id: Text) kind empirical {
    label en official "the payor is not a United States person but elects to be treated as one for paragraph (1) and meets the Secretary's requirements";
}
pub relation expatriate_notifies_payor_of_status_877ad3Bi(item_id: Text) kind empirical {
    label en official "the covered expatriate notifies the payor of the status as a covered expatriate";
}
pub relation expatriate_waives_treaty_withholding_reduction_877ad3Bii(item_id: Text) kind empirical {
    label en official "the covered expatriate makes an irrevocable waiver of any right to claim a treaty reduction in withholding on the item";
}
pub relation eligible_deferred_compensation_item_877ad3(item_id: Text) kind institutional {
    label en official "an eligible deferred compensation item (section 877A(d)(3))";
}
@source(IRC_S877A_D, relation = formalizes, coverage = exact, quote = "(i) a United States person, or")
rule S877AD3UsPayorEligible defeasible {
    for item_id: Text;
    when deferred_compensation_item_877ad4(item_id)
     and payor_is_united_states_person_877ad3Ai(item_id)
     and expatriate_notifies_payor_of_status_877ad3Bi(item_id)
     and expatriate_waives_treaty_withholding_reduction_877ad3Bii(item_id);
    then eligible_deferred_compensation_item_877ad3(item_id);
}
@source(IRC_S877A_D, relation = formalizes, coverage = exact, quote = "(ii) a person who is not a United States person but who elects to be treated as a United States person for purposes of paragraph (1) and meets such requirements as the Secretary may provide to ensure")
rule S877AD3ForeignPayorElectingEligible defeasible {
    for item_id: Text;
    when deferred_compensation_item_877ad4(item_id)
     and foreign_payor_elects_and_meets_requirements_877ad3Aii(item_id)
     and expatriate_notifies_payor_of_status_877ad3Bi(item_id)
     and expatriate_waives_treaty_withholding_reduction_877ad3Bii(item_id);
    then eligible_deferred_compensation_item_877ad3(item_id);
}
pub relation taxable_payment_877ad1B(payor: us.irc.core::Person, expatriate: us.irc.core::Individual, item_id: Text, amount: Money) kind empirical {
    label en official "a payment to a covered expatriate with respect to a deferred compensation item, to the extent it would be includible in gross income if the expatriate continued to be subject to tax as a citizen or resident";
}
pub relation item_attributable_to_services_outside_us_while_nonresident_877ad5(item_id: Text) kind empirical {
    label en official "the item is attributable to services performed outside the United States while the covered expatriate was not a citizen or resident of the United States";
}
pub relation withholding_877ad1A(payor: us.irc.core::Person, expatriate: us.irc.core::Individual, item_id: Text, tax: Money) kind institutional {
    label en official "the payor deducts and withholds from a taxable payment to a covered expatriate on an eligible deferred compensation item a tax of 30 percent (section 877A(d)(1)(A))";
}
@source(IRC_S877A_D, relation = formalizes, coverage = exact, quote = "In the case of any eligible deferred compensation item, the payor shall deduct and withhold from any taxable payment to a covered expatriate with respect to such item a tax equal to 30 percent")
rule S877AD1AWithholdThirtyPercent defeasible {
    for payor: us.irc.core::Person;
    for expatriate: us.irc.core::Individual;
    for item_id: Text;
    for amount: Money;
    when taxable_payment_877ad1B(payor, expatriate, item_id, amount)
     and eligible_deferred_compensation_item_877ad3(item_id)
     and covered_expatriate_877ag1(expatriate);
    unless item_attributable_to_services_outside_us_while_nonresident_877ad5(item_id)
     and taxable_payment_877ad1B(payor, expatriate, item_id, amount);
    then withholding_877ad1A(payor, expatriate, item_id, round(amount * 0.30, 2, "HALF_UP"));
}
rule S877AD1ADutyToWithhold defeasible {
    for payor: us.irc.core::Person;
    for expatriate: us.irc.core::Individual;
    for item_id: Text;
    for tax: Money;
    when withholding_877ad1A(payor, expatriate, item_id, tax);
    then duty S877AD1WithholdingDuty {
        bearer payor;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition us.irc.core::payment(_, payor, tax, _);
            window [-infinity, infinity];
        }
    };
}
pub relation deferred_compensation_present_value_of_accrued_benefit_877ad2(p: us.irc.core::Individual, item_id: Text, present_value: Money) kind empirical {
    label en official "the present value of the covered expatriate's accrued benefit on the day before the expatriation date";
}
pub relation item_referred_to_in_877ad4D_877ad2Aii(item_id: Text) kind empirical {
    label en official "the item is a property or right to property received in connection with the performance of services (paragraph (4)(D))";
}
pub relation deemed_distribution_of_accrued_benefit_877ad2Ai(p: us.irc.core::Individual, item_id: Text, amount: Money) kind institutional {
    label en official "for a deferred compensation item that is not an eligible item, the present value of the accrued benefit is treated as received on the day before the expatriation date as a distribution under the plan (section 877A(d)(2)(A)(i))";
}
@source(IRC_S877A_D, relation = formalizes, coverage = partial, quote = "(A)(i) with respect to any deferred compensation item to which clause (ii) does not apply, an amount equal to the present value of the covered expatriate's accrued benefit shall be treated as having")
rule S877AD2AiDeemedDistribution defeasible {
    for p: us.irc.core::Individual;
    for item_id: Text;
    for pv: Money;
    when deferred_compensation_present_value_of_accrued_benefit_877ad2(p, item_id, pv)
     and deferred_compensation_item_877ad4(item_id)
     and covered_expatriate_877ag1(p);
    unless eligible_deferred_compensation_item_877ad3(item_id)
     and deferred_compensation_present_value_of_accrued_benefit_877ad2(p, item_id, pv);
    unless item_referred_to_in_877ad4D_877ad2Aii(item_id)
     and deferred_compensation_present_value_of_accrued_benefit_877ad2(p, item_id, pv);
    unless item_attributable_to_services_outside_us_while_nonresident_877ad5(item_id)
     and deferred_compensation_present_value_of_accrued_benefit_877ad2(p, item_id, pv);
    then deemed_distribution_of_accrued_benefit_877ad2Ai(p, item_id, pv);
}
pub relation rights_treated_as_transferable_and_vested_877ad2Aii(p: us.irc.core::Individual, item_id: Text) kind institutional {
    label en official "the rights to the item become transferable and not subject to a substantial risk of forfeiture on the day before the expatriation date (section 877A(d)(2)(A)(ii))";
}
@source(IRC_S877A_D, relation = formalizes, coverage = partial, quote = "(ii) with respect to any deferred compensation item referred to in paragraph (4)(D), the rights of the covered expatriate to such item shall be treated as becoming transferable and not subject to a")
rule S877AD2AiiRightsVest defeasible {
    for p: us.irc.core::Individual;
    for item_id: Text;
    when deferred_compensation_item_877ad4(item_id)
     and item_referred_to_in_877ad4D_877ad2Aii(item_id)
     and covered_expatriate_877ag1(p)
     and deferred_compensation_present_value_of_accrued_benefit_877ad2(p, item_id, _);
    unless eligible_deferred_compensation_item_877ad3(item_id)
     and item_referred_to_in_877ad4D_877ad2Aii(item_id)
     and covered_expatriate_877ag1(p);
    unless item_attributable_to_services_outside_us_while_nonresident_877ad5(item_id)
     and item_referred_to_in_877ad4D_877ad2Aii(item_id)
     and covered_expatriate_877ag1(p);
    then rights_treated_as_transferable_and_vested_877ad2Aii(p, item_id);
}
pub relation not_subject_to_section_1441_withholding_877ad6C(item_id: Text) kind institutional {
    label en official "an item subject to withholding under paragraph (1) is not subject to withholding under section 1441 or chapter 24 (section 877A(d)(6)(C))";
}
@source(IRC_S877A_D, relation = formalizes, coverage = exact, quote = "Any item subject to withholding under paragraph (1) shall not be subject to withholding under section 1441 or chapter 24.")
rule S877AD6CNotSubjectToSection1441 defeasible {
    for payor: us.irc.core::Person;
    for expatriate: us.irc.core::Individual;
    for item_id: Text;
    for tax: Money;
    when withholding_877ad1A(payor, expatriate, item_id, tax);
    then not_subject_to_section_1441_withholding_877ad6C(item_id);
}

// --- §877A(e), (f) ----------------------------------------------------------------------------------------------------

pub relation interest_in_specified_tax_deferred_account_877ae1(p: us.irc.core::Individual, account_id: Text, value: Money) kind empirical {
    label en official "an interest in a specified tax deferred account (an individual retirement plan other than an arrangement described in section 408(k) or (p), a section 529 qualified tuition program, a section 529A ABLE program, a Coverdell education savings account, a health savings account or an Archer MSA) held by a covered expatriate on the day before the expatriation date";
}
pub relation deemed_distribution_of_entire_interest_877ae1A(p: us.irc.core::Individual, account_id: Text, amount: Money) kind institutional {
    label en official "the covered expatriate is treated as receiving a distribution of the entire interest in the account on the day before the expatriation date (section 877A(e)(1)(A))";
}
@source(IRC_S877A_E, relation = formalizes, coverage = exact, quote = "(A) the covered expatriate shall be treated as receiving a distribution of his entire interest in such account on the day before the expatriation date,")
rule S877AE1ADeemedDistributionOfAccount defeasible {
    for p: us.irc.core::Individual;
    for account_id: Text;
    for value: Money;
    when interest_in_specified_tax_deferred_account_877ae1(p, account_id, value)
     and covered_expatriate_877ag1(p);
    then deemed_distribution_of_entire_interest_877ae1A(p, account_id, value);
}
pub relation early_distribution_tax_not_applicable_877ae1B(p: us.irc.core::Individual, account_id: Text) kind institutional {
    label en official "no early distribution tax applies by reason of the deemed distribution (section 877A(e)(1)(B))";
}
@source(IRC_S877A_E, relation = formalizes, coverage = exact, quote = "(B) no early distribution tax shall apply by reason of such treatment, and")
rule S877AE1BNoEarlyDistributionTax defeasible {
    for p: us.irc.core::Individual;
    for account_id: Text;
    for amount: Money;
    when deemed_distribution_of_entire_interest_877ae1A(p, account_id, amount);
    then early_distribution_tax_not_applicable_877ae1B(p, account_id);
}
pub relation distribution_from_nongrantor_trust_to_covered_expatriate_877af1(trustee: us.irc.core::Person, expatriate: us.irc.core::Individual, distribution_id: Text, taxable_portion: Money, property_fmv: Money, property_basis_in_trust: Money) kind empirical {
    label en official "a distribution of property from a nongrantor trust to a covered expatriate: the taxable portion, and the property's fair market value and adjusted basis in the hands of the trust";
}
pub relation expatriate_was_beneficiary_day_before_expatriation_877af5(expatriate: us.irc.core::Individual, trustee: us.irc.core::Person) kind empirical {
    label en official "the covered expatriate was a beneficiary of the trust on the day before the expatriation date";
}
pub relation trust_withholding_877af1A(trustee: us.irc.core::Person, expatriate: us.irc.core::Individual, distribution_id: Text, tax: Money) kind institutional {
    label en official "the trustee deducts and withholds 30 percent of the taxable portion of the distribution (section 877A(f)(1)(A))";
}
@source(IRC_S877A_F, relation = formalizes, coverage = exact, quote = "(A) the trustee shall deduct and withhold from such distribution an amount equal to 30 percent of the taxable portion of the distribution, and")
rule S877AF1AWithholdThirtyPercentOfTaxablePortion defeasible {
    for trustee: us.irc.core::Person;
    for expatriate: us.irc.core::Individual;
    for distribution_id: Text;
    for taxable: Money;
    for fmv: Money;
    for basis: Money;
    when distribution_from_nongrantor_trust_to_covered_expatriate_877af1(trustee, expatriate, distribution_id, taxable, fmv, basis)
     and covered_expatriate_877ag1(expatriate)
     and expatriate_was_beneficiary_day_before_expatriation_877af5(expatriate, trustee);
    then trust_withholding_877af1A(trustee, expatriate, distribution_id, round(taxable * 0.30, 2, "HALF_UP"));
}
rule S877AF1ADutyToWithhold defeasible {
    for trustee: us.irc.core::Person;
    for expatriate: us.irc.core::Individual;
    for distribution_id: Text;
    for tax: Money;
    when trust_withholding_877af1A(trustee, expatriate, distribution_id, tax);
    then duty S877AF1TrusteeWithholdingDuty {
        bearer trustee;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition us.irc.core::payment(_, trustee, tax, _);
            window [-infinity, infinity];
        }
    };
}
pub relation trust_gain_on_distribution_877af1B(trustee: us.irc.core::Person, distribution_id: Text, gain: Money) kind institutional {
    label en official "if the fair market value of the distributed property exceeds its adjusted basis in the trust, gain is recognized to the trust as if the property were sold to the expatriate at fair market value (section 877A(f)(1)(B))";
}
@source(IRC_S877A_F, relation = formalizes, coverage = exact, quote = "(B) if the fair market value of such property exceeds its adjusted basis in the hands of the trust, gain shall be recognized to the trust as if such property were sold to the expatriate at its fair")
rule S877AF1BTrustGainOnDistribution defeasible {
    for trustee: us.irc.core::Person;
    for expatriate: us.irc.core::Individual;
    for distribution_id: Text;
    for taxable: Money;
    for fmv: Money;
    for basis: Money;
    when distribution_from_nongrantor_trust_to_covered_expatriate_877af1(trustee, expatriate, distribution_id, taxable, fmv, basis)
     and covered_expatriate_877ag1(expatriate)
     and expatriate_was_beneficiary_day_before_expatriation_877af5(expatriate, trustee)
     and fmv > basis;
    then trust_gain_on_distribution_877af1B(trustee, distribution_id, fmv - basis);
}

// --- §877A(h) ---------------------------------------------------------------------------------------------------------

pub relation property_held_on_first_residence_877ah2(p: us.irc.core::Individual, property_id: Text, adjusted_basis: Money, fair_market_value: Money) kind empirical {
    label en official "property held on the date the individual first became a resident of the United States, with its adjusted basis and fair market value on that date";
}
pub relation elects_not_to_apply_basis_step_up_877ah2(p: us.irc.core::Individual) kind empirical {
    label en official "the individual elects not to have the basis rule apply (irrevocable)";
}
pub relation basis_for_877a_tax_877ah2(p: us.irc.core::Individual, property_id: Text, basis: Money) kind institutional {
    label en official "solely for determining the tax imposed by reason of subsection (a), the property has a basis on the date of first residence of not less than its fair market value on that date (section 877A(h)(2))";
}
@source(IRC_S877A_H, relation = formalizes, coverage = exact, quote = "Solely for purposes of determining any tax imposed by reason of subsection (a), property which was held by an individual on the date the individual first became a resident of the United States")
rule S877AH2BasisNotLessThanFairMarketValue defeasible {
    for p: us.irc.core::Individual;
    for property_id: Text;
    for basis: Money;
    for fmv: Money;
    when property_held_on_first_residence_877ah2(p, property_id, basis, fmv);
    unless elects_not_to_apply_basis_step_up_877ah2(p)
     and property_held_on_first_residence_877ah2(p, property_id, basis, fmv);
    then basis_for_877a_tax_877ah2(p, property_id, max(basis, fmv));
}
rule S877AH2BasisElectionKeepsBasis defeasible {
    for p: us.irc.core::Individual;
    for property_id: Text;
    for basis: Money;
    for fmv: Money;
    when property_held_on_first_residence_877ah2(p, property_id, basis, fmv)
     and elects_not_to_apply_basis_step_up_877ah2(p);
    then basis_for_877a_tax_877ah2(p, property_id, basis);
}
