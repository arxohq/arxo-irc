// §59A(a) — imposition of the base erosion and anti-abuse tax; §59A(e) —
// applicable taxpayer ($500,000,000 average gross receipts and 3%/2% base
// erosion percentage tests); §59A(a)-(d) amount (stage 1b, IRC-10 stage 1b,
// A13): the section 59A(b)(1) formula — rate * modified taxable income,
// minus the regular-tax-liability offset — with the PL 119-21 rate edition
// (`us.irc.temporal::PL119_21_S70331`: 10% -> 10.5%, taxable years beginning
// after December 31, 2025; the 2018 5% transitional rate of (b)(1)(A)'s own
// parenthetical is not separately modeled, since it applied only to
// taxable years beginning in calendar year 2018, long closed). §59A(c)'s
// own base-erosion-tax-benefit/base-erosion-percentage computation and
// §59A(d)'s base-erosion-payment definition are NOT modeled this stage
// (TECH_GAP G97: the add-back chain reads `deductions`-owned items this
// package does not implement) — `modified_taxable_income` and
// `base_erosion_percentage` are asserted as case inputs. §59A(g)-(i) are
// NOT modeled this stage either.

use self::{
    IRC_S59A_A,
    IRC_S59A_B,
    IRC_S59A_E,
};

pub relation is_corporation_not_ric_reit_or_s_corp(taxpayer: us.irc.core::Corporation) kind empirical {
    label en official "the taxpayer is a corporation other than a regulated investment company, a real estate investment trust, or an S corporation — section 59A(e)(1)(A)";
}
pub relation average_annual_gross_receipts_3yr(taxpayer: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the average annual gross receipts of the taxpayer for the 3-taxable-year period ending with the preceding taxable year, for section 59A(e)(1)(B)";
}
pub relation base_erosion_percentage(taxpayer: us.irc.core::Corporation, y: us.irc.core::TaxableYear, percentage: Decimal) kind empirical {
    label en unofficial "the taxpayer's base erosion percentage for the taxable year, as determined under section 59A(c)(4) — asserted directly this stage because (c)(4)'s own computation is not modeled (TECH_GAP)";
}
pub relation described_in_59a_b3_bank_or_dealer_group(taxpayer: us.irc.core::Corporation) kind empirical {
    label en official "the taxpayer is a member of an affiliated group including a bank or registered securities dealer, per section 59A(b)(3)(B) — lowers the base-erosion-percentage threshold to 2 percent under section 59A(e)(1)(C)";
}

@source(IRC_S59A_E, relation = formalizes, coverage = partial, quote = "The term \"applicable taxpayer\" means, with respect to any taxable year, a taxpayer—")
pub relation applicable_taxpayer_59a(taxpayer: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the taxpayer is an applicable taxpayer under section 59A(e): a corporation (not RIC/REIT/S corp) with $500,000,000+ average 3-year gross receipts and a base erosion percentage of 3% (2% for a bank/dealer-group member) or higher";
}
// boundary named by the owner's task: 3% qualifies, 2.9% does not (for a
// taxpayer NOT in the bank/dealer group).
rule S59AE1ApplicableTaxpayerGeneral defeasible {
    for taxpayer: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for receipts: Money;
    for percentage: Decimal;
    when is_corporation_not_ric_reit_or_s_corp(taxpayer)
     and average_annual_gross_receipts_3yr(taxpayer, y, receipts)
     and receipts >= 500000000 USD
     and base_erosion_percentage(taxpayer, y, percentage)
     and percentage >= 0.03;
    unless described_in_59a_b3_bank_or_dealer_group(taxpayer)
     and base_erosion_percentage(taxpayer, y, percentage);
    then applicable_taxpayer_59a(taxpayer, y);
}
rule S59AE1ApplicableTaxpayerBankOrDealerGroup defeasible {
    for taxpayer: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for receipts: Money;
    for percentage: Decimal;
    when is_corporation_not_ric_reit_or_s_corp(taxpayer)
     and average_annual_gross_receipts_3yr(taxpayer, y, receipts)
     and receipts >= 500000000 USD
     and base_erosion_percentage(taxpayer, y, percentage)
     and percentage >= 0.02
     and described_in_59a_b3_bank_or_dealer_group(taxpayer);
    then applicable_taxpayer_59a(taxpayer, y);
}

// §59A(a): imposition. The tax equals the "base erosion minimum tax amount"
// (section 59A(b)).
@source(IRC_S59A_A, relation = formalizes, coverage = exact, quote = "There is hereby imposed on each applicable taxpayer for any taxable year a tax equal to the base erosion minimum tax amount for the taxable year. Such tax shall be in addition to any other tax imposed by this subtitle.")
pub relation beat_applicable_taxpayer(taxpayer: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "an applicable taxpayer under section 59A(e) is subject to the section 59A(a) base erosion and anti-abuse tax, in addition to any other subtitle A tax, for the taxable year, equal to the base_erosion_minimum_tax_amount";
}
rule S59AAImpositionClassification defeasible {
    for taxpayer: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when applicable_taxpayer_59a(taxpayer, y);
    then beat_applicable_taxpayer(taxpayer, y);
}

// --- §59A(b)(1): base erosion minimum tax amount ---------------------------

pub relation modified_taxable_income(taxpayer: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the taxpayer's modified taxable income for the year (section 59A(c)(1)): taxable income without regard to base erosion tax benefits or the base-erosion share of an NOL deduction — asserted directly, the (c)(2)-(4) add-back computation is not modeled this stage (TECH_GAP G97)";
}
pub relation regular_tax_liability_26b(taxpayer: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the taxpayer's regular tax liability as defined in section 26(b), for section 59A(b)(1)(B)";
}
pub relation section_59a_b1b_credit_offset(taxpayer: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the section 59A(b)(1)(B) reduction to regular tax liability: the excess of credits allowed against regular tax liability over the section 38 research-credit and 80%-of-applicable-credits carve-outs (pre-2026), or the aggregate credits allowed (PL 119-21, post-2026) — asserted as the already-computed offset amount, the (b)(1)(B)(i)-(ii)/(2)(B) itemization is not modeled this stage (TECH_GAP)";
}

@source(us.irc.temporal::PL119_21_S70331, relation = derives_from, quote = "by striking “10 percent” in paragraph (1) and inserting “10.5 percent”")
pub relation beat_rate_for_year(taxpayer: us.irc.core::Corporation, y: us.irc.core::TaxableYear, rate: Decimal) kind institutional {
    label en official "the section 59A(b)(1)(A) rate applicable to the taxpayer's taxable year: 10% (pre-2026) or 10.5% (PL 119-21, taxable years beginning after December 31, 2025), each increased by one percentage point for a section 59A(b)(3)(B) bank/dealer-group member (section 59A(b)(3)(A))";
}
pub relation taxpayer_year_begins_after_20251231(y: us.irc.core::TaxableYear) kind institutional {
    label en official "the taxable year y begins after December 31, 2025 — the PL 119-21 section 70331 edition boundary for section 59A(b)'s rate (distinct from module 11's boundary for sections 951A/960(d) only in name; both read the same underlying TaxableYear-begins-date test)";
}
rule TaxpayerYearBeginsAfterPl11921Boundary strict {
    for y: us.irc.core::TaxableYear;
    for d: Date;
    when us.irc.core::begins(y, d)
     and d > @2025-12-31;
    then taxpayer_year_begins_after_20251231(y);
}
rule S59ABRatePre2026General defeasible {
    for taxpayer: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when applicable_taxpayer_59a(taxpayer, y);
    unless taxpayer_year_begins_after_20251231(y)
     and applicable_taxpayer_59a(taxpayer, y);
    unless described_in_59a_b3_bank_or_dealer_group(taxpayer)
     and applicable_taxpayer_59a(taxpayer, y);
    then beat_rate_for_year(taxpayer, y, 0.10);
}
rule S59ABRatePre2026BankOrDealer defeasible {
    for taxpayer: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when applicable_taxpayer_59a(taxpayer, y)
     and described_in_59a_b3_bank_or_dealer_group(taxpayer);
    unless taxpayer_year_begins_after_20251231(y)
     and applicable_taxpayer_59a(taxpayer, y)
     and described_in_59a_b3_bank_or_dealer_group(taxpayer);
    then beat_rate_for_year(taxpayer, y, 0.11);
}
rule S59ABRatePost2026General defeasible {
    for taxpayer: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when applicable_taxpayer_59a(taxpayer, y)
     and taxpayer_year_begins_after_20251231(y);
    unless described_in_59a_b3_bank_or_dealer_group(taxpayer)
     and applicable_taxpayer_59a(taxpayer, y);
    then beat_rate_for_year(taxpayer, y, 0.105);
}
rule S59ABRatePost2026BankOrDealer defeasible {
    for taxpayer: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when applicable_taxpayer_59a(taxpayer, y)
     and taxpayer_year_begins_after_20251231(y)
     and described_in_59a_b3_bank_or_dealer_group(taxpayer);
    then beat_rate_for_year(taxpayer, y, 0.115);
}

@source(IRC_S59A_B, relation = formalizes, coverage = partial, quote = "the excess (if any) of—")
pub relation base_erosion_minimum_tax_amount(taxpayer: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the section 59A(b)(1) base erosion minimum tax amount: the excess (if any) of rate * modified taxable income over (regular tax liability reduced by the section 59A(b)(1)(B) credit offset)";
}
rule S59AB1BaseErosionMinimumTaxAmount defeasible {
    for taxpayer: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for rate: Decimal;
    for mti: Money;
    for regular_tax: Money;
    for offset: Money;
    when beat_rate_for_year(taxpayer, y, rate)
     and modified_taxable_income(taxpayer, y, mti)
     and regular_tax_liability_26b(taxpayer, y, regular_tax)
     and section_59a_b1b_credit_offset(taxpayer, y, offset);
    then base_erosion_minimum_tax_amount(taxpayer, y, max(0.00 USD, (mti * rate) - (regular_tax - offset)));
}
// NOTE: `us.irc.core::TaxKind` has no BEAT-specific value (the enum is
// additive, added by the coordinator "in the same change that first needs
// it" per CONTRACT.md — outside this agent's own paths). `base_erosion_
// minimum_tax_amount` is therefore NOT wired into `us.irc.core::liability`
// this stage; a consumer needing a `TaxKind`-tagged liability record must
// wait for that enum addition (flagged in international.deps.json).
