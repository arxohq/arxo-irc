// §864(b) — trade or business within the United States (with the personal-
// services-for-foreign-employer and trading-in-securities/commodities safe
// harbors); §864(c)(1)-(3) — effectively connected income, the asset-use/
// business-activities factors as EVALUATIVE (DECISION-0194). Stage 1
// (IRC-10 stage 1, A13). §864(c)(4)-(8), (d), (e), (f), (g) are NOT modeled
// this stage (stage 2: foreign-source ECI special cases, interest
// allocation, research allocation, partnership-interest sale ECI).

// --- §864(b): trade or business within the United States ----------------

use self::{
    IRC_S864_B,
    IRC_S864_C,
    trading_kind_condition_met_864b2,
};

pub relation performs_personal_services_in_us(p: us.irc.core::Person) kind empirical {
    label en unofficial "the person performs personal services within the United States at some time within the taxable year, for section 864(b)";
}
pub relation nonresident_alien_temporarily_present_90_days_or_fewer(worker: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind empirical {
    label en official "a nonresident alien individual temporarily present in the United States for a period or periods not exceeding a total of 90 days during the taxable year, for section 864(b)(1)";
}
pub relation compensation_for_services_3000_or_less(worker: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the worker's compensation for the services does not exceed $3,000 in the aggregate, for section 864(b)(1)";
}
relation services_for_foreign_employer_not_engaged_in_us_trade_or_business(worker: us.irc.core::Individual) kind empirical {
    label en official "the personal services are performed for a nonresident alien, foreign partnership, or foreign corporation not engaged in trade or business within the United States — section 864(b)(1)(A)";
}
relation services_for_us_person_foreign_office(worker: us.irc.core::Individual) kind empirical {
    label en official "the personal services are performed for an office or place of business maintained in a foreign country or US possession by a US citizen/resident, domestic partnership, or domestic corporation — section 864(b)(1)(B)";
}

pub relation trading_through_independent_agent(p: us.irc.core::Person, kind: Text) kind empirical {
    label en official "trading in stocks/securities or commodities through a resident broker, commission agent, custodian, or other independent agent (section 864(b)(2)(A)(i)/(B)(i)); kind is 'securities' or 'commodities'";
}
pub relation trading_for_own_account(p: us.irc.core::Person, kind: Text) kind empirical {
    label en official "trading in stocks/securities or commodities for the taxpayer's own account, whether directly, by employees, or through an agent (section 864(b)(2)(A)(ii)/(B)(ii)); kind is 'securities' or 'commodities'";
}
pub relation is_dealer_in(p: us.irc.core::Person, kind: Text) kind empirical {
    label en official "the taxpayer is a dealer in stocks/securities or commodities — the own-account safe harbor of section 864(b)(2)(A)(ii)/(B)(ii) does not apply to a dealer";
}
pub relation has_us_office_directing_trading(p: us.irc.core::Person) kind empirical {
    label en official "the taxpayer has an office or other fixed place of business in the United States through which, or by the direction of which, the trading transactions are effected — section 864(b)(2)(C) limitation on the independent-agent/own-account safe harbors";
}

@source(IRC_S864_B, relation = formalizes, coverage = partial, quote = "the term \"trade or business within the United States\" includes the performance of personal services within the United States at any time within the taxable year, but does not include—")
pub relation engaged_in_trade_or_business_within_us(p: us.irc.core::Person) kind institutional {
    label en official "the person is engaged in a trade or business within the United States, for purposes of this part, part II, and chapter 3 (section 864(b))";
}
rule S864BGeneralRulePersonalServices defeasible {
    for p: us.irc.core::Person;
    when performs_personal_services_in_us(p);
    unless personal_services_foreign_employer_exception(p);
    then engaged_in_trade_or_business_within_us(p);
}
pub relation personal_services_foreign_employer_exception(worker: us.irc.core::Individual) kind institutional {
    label en official "section 864(b)(1) exception: personal services performed by a nonresident alien temporarily present 90 days or fewer, compensation $3,000 or less, for a qualifying foreign employer or a US person's foreign office";
}
rule S864B1ForeignEmployerException defeasible {
    for worker: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    when nonresident_alien_temporarily_present_90_days_or_fewer(worker, y)
     and compensation_for_services_3000_or_less(worker, y)
     and services_for_foreign_employer_not_engaged_in_us_trade_or_business(worker);
    then personal_services_foreign_employer_exception(worker);
}
rule S864B1UsPersonForeignOfficeException defeasible {
    for worker: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    when nonresident_alien_temporarily_present_90_days_or_fewer(worker, y)
     and compensation_for_services_3000_or_less(worker, y)
     and services_for_us_person_foreign_office(worker);
    then personal_services_foreign_employer_exception(worker);
}

// (b)(2) trading-in-securities-or-commodities safe harbor: trading through
// an independent agent, OR for the taxpayer's own account (unless a
// dealer), is NOT a US trade or business by itself — but ONLY while the
// taxpayer has no US office directing the trading (the (C) limitation).
// Modeled as an exception a consumer subtracts from `engaged_in_trade_or_business_within_us`
// derived on OTHER grounds; trading itself never affirmatively triggers the
// relation, so no separate `unless` wiring is needed for this safe harbor
// beyond keeping it out of the personal-services rule above (a trading-only
// taxpayer has no personal-services fact to trigger the general rule at all).
pub relation trading_safe_harbor_applies(p: us.irc.core::Person, kind: Text) kind institutional {
    label en official "section 864(b)(2) safe harbor: trading in stocks/securities or commodities through an independent agent or for the taxpayer's own account (non-dealer) is not, by itself, a trade or business within the United States, because the taxpayer has no directing US office (section 864(b)(2)(C))";
}
rule S864B2IndependentAgentSafeHarbor defeasible {
    for p: us.irc.core::Person;
    for kind: Text;
    when trading_through_independent_agent(p, kind)
     and trading_kind_condition_met_864b2(p, kind);
    unless has_us_office_directing_trading(p)
     and trading_through_independent_agent(p, kind);
    then trading_safe_harbor_applies(p, kind);
}
rule S864B2OwnAccountSafeHarbor defeasible {
    for p: us.irc.core::Person;
    for kind: Text;
    when trading_for_own_account(p, kind)
     and trading_kind_condition_met_864b2(p, kind);
    unless has_us_office_directing_trading(p)
     and trading_for_own_account(p, kind);
    unless is_dealer_in(p, kind);
    then trading_safe_harbor_applies(p, kind);
}

// --- §864(c)(1)-(3): effectively connected income ------------------------

pub relation nonresident_alien_or_foreign_corp(p: us.irc.core::Person) kind empirical {
    label en unofficial "the person is a nonresident alien individual or a foreign corporation, the class section 864(c) addresses";
}
pub relation income_gain_or_loss_from_us_sources(p: us.irc.core::Person, item_id: Text) kind empirical {
    label en unofficial "an item of income, gain, or loss from sources within the United States realized by the person, for section 864(c) classification; item_id names the item";
}
pub relation item_is_fdap_capital_gain_type(item_id: Text) kind empirical {
    label en official "the item is of the type described in section 871(a)(1), section 871(h), section 881(a), or section 881(c), or is capital-asset gain/loss — the class subject to the section 864(c)(2) factors test rather than the (c)(3) catch-all";
}

// (c)(2) factors — DECISION-0194 evaluative channel: whether income is
// derived from assets used in / held for use in the trade or business, or
// whether the business's activities were a material factor, is committed by
// the statute to a multi-factor judgment ("the factors taken into account
// shall include whether..."), not a bright-line test this package can
// compute from asserted facts alone.
external judgment relation asset_use_or_business_activities_test_met(p: us.irc.core::Person, item_id: Text) {
    authority Secretary;
    label en unofficial "the section 864(c)(2) asset-use/business-activities factors, on the whole record, support treating this item as effectively connected with the person's US trade or business — an evaluative judgment (DECISION-0194), not an arithmetic guard";
}

@source(IRC_S864_C, relation = formalizes, coverage = partial, quote = "In the case of a nonresident alien individual or a foreign corporation engaged in trade or business within the United States during the taxable year, the rules set forth in paragraphs (2), (3), (4), (6), (7), and (8) shall apply in determining the income, gain, or loss which shall be treated as effectively connected with the conduct of a trade or business within the United States.")
pub relation effectively_connected(p: us.irc.core::Person, item_id: Text) kind institutional {
    label en official "an item of US-source income, gain, or loss is treated as effectively connected with the conduct of a trade or business within the United States (section 864(c))";
}
// (c)(3): catch-all — other US-source income (not of the (c)(2) FDAP/
// capital-gain types) is ECI whenever the person is engaged in a US trade
// or business, without a separate factors test.
rule S864C3OtherUsSourceIncomeCatchAll defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    when nonresident_alien_or_foreign_corp(p)
     and engaged_in_trade_or_business_within_us(p)
     and income_gain_or_loss_from_us_sources(p, item_id);
    unless item_is_fdap_capital_gain_type(item_id)
     and income_gain_or_loss_from_us_sources(p, item_id);
    then effectively_connected(p, item_id);
}
// (c)(2): the FDAP/capital-gain classes go through the evaluative factors
// judgment instead of the catch-all.
rule S864C2FdapCapitalGainFactorsTest defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    when nonresident_alien_or_foreign_corp(p)
     and engaged_in_trade_or_business_within_us(p)
     and income_gain_or_loss_from_us_sources(p, item_id)
     and item_is_fdap_capital_gain_type(item_id)
     and asset_use_or_business_activities_test_met(p, item_id);
    then effectively_connected(p, item_id);
}
// (c)(1)(B): a person NOT engaged in a US trade or business during the
// taxable year has NO effectively connected income (subject to the named
// exceptions this stage does not model: (c)(6)-(8), section 871(d),
// sections 882(d)-(e) — noted as a TECH_GAP/partial boundary, not silently
// dropped). Restated as the negative existential a consumer can read
// directly rather than relying on absence-as-negative.
pub relation not_engaged_no_eci_by_871d_882de_exception(p: us.irc.core::Person) kind empirical {
    label en unofficial "one of the section 864(c)(1)(B) named exceptions (paragraph (6)/(7)/(8), section 871(d) real-property election, or section 882(d)/(e)) applies to this person, so the (c)(1)(B) 'no ECI' default does not hold — asserted directly because those exceptions are not modeled this stage (TECH_GAP)";
}
@source(IRC_S864_C, relation = formalizes, coverage = partial, quote = "in the case of a nonresident alien individual or a foreign corporation not engaged in trade or business within the United States during the taxable year, no income, gain, or loss shall be treated as effectively connected with the conduct of a trade or business within the United States")
pub relation no_effectively_connected_income(p: us.irc.core::Person) kind institutional {
    label en official "a nonresident alien individual or foreign corporation not engaged in a US trade or business during the taxable year has no effectively connected income for the year (section 864(c)(1)(B)), absent the named exceptions";
}
rule S864C1BNoTradeOrBusinessNoEci defeasible {
    for p: us.irc.core::Person;
    when nonresident_alien_or_foreign_corp(p);
    unless engaged_in_trade_or_business_within_us(p);
    unless not_engaged_no_eci_by_871d_882de_exception(p);
    then no_effectively_connected_income(p);
}
