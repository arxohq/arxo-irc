// §911(a)-(d) — foreign earned income exclusion: the two qualification
// tests (bona fide residence, physical presence with exact 330-day
// counting over a consecutive 12-month period), the exclusion amount as an
// A3 parameter with a SOURCE_GAP for post-statutory indexed years, and the
// election as a `power` with the section 911(e)(2) 5-year revocation bar.
// Stage 1 (IRC-10 stage 1, A13). §911(c) housing-cost-amount computation and
// §911(f)-(g) are NOT modeled this stage (stage 2) beyond the classification
// they presuppose.

use self::{
    IRC_S911_B,
    IRC_S911_C,
    IRC_S911_D,
    IRC_S911_E,
    not_bona_fide_resident_by_statement_911d5,
    tax_home_in_foreign_country_911d3,
};

pub relation qualified_individual_by_bona_fide_residence(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the individual is a US citizen who is a bona fide resident of a foreign country (or countries) for an uninterrupted period including the entire taxable year — section 911(d)(1)(A)";
}
pub relation days_present_in_foreign_country_in_12_month_period(p: us.irc.core::Individual, period_start: Date, days: Integer) kind empirical {
    label en official "the number of full days, out of the 12 consecutive months beginning at period_start, during which the individual was present in a foreign country or countries — section 911(d)(1)(B)/(d)(4)";
}
pub relation citizen_or_resident_of_us(p: us.irc.core::Individual) kind empirical {
    label en unofficial "the individual is a citizen or resident of the United States, for section 911(d)(1)";
}

@source(IRC_S911_D, relation = formalizes, coverage = partial, quote = "means an individual whose tax home is in a foreign country and who is—")
pub relation qualified_individual(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the individual is a qualified individual under section 911(d)(1): a US citizen or resident with a foreign tax home who is either a bona fide resident of a foreign country for the full year, or present abroad at least 330 full days in a 12-month period";
}
rule S911D1ABonaFideResidenceTest defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    when citizen_or_resident_of_us(p)
     and tax_home_in_foreign_country_911d3(p, y)
     and qualified_individual_by_bona_fide_residence(p, y);
    unless not_bona_fide_resident_by_statement_911d5(p, y)
     and qualified_individual_by_bona_fide_residence(p, y);
    then qualified_individual(p, y);
}
// 330-day test: "at least 330 full days" — boundary is inclusive at 330,
// fails at 329 (AGENT-BRIEF.md's named boundary scenario).
@source(IRC_S911_D, relation = formalizes, coverage = partial, quote = "who, during any period of 12 consecutive months, is present in a foreign country or countries during at least 330 full days in such period")
pub relation qualified_individual_by_physical_presence(p: us.irc.core::Individual, period_start: Date) kind institutional {
    label en official "the individual meets the section 911(d)(1)(B) 330-full-day physical-presence test for a 12-consecutive-month period beginning at period_start";
}
rule S911D1BPhysicalPresenceTest defeasible {
    for p: us.irc.core::Individual;
    for period_start: Date;
    for days: Integer;
    when days_present_in_foreign_country_in_12_month_period(p, period_start, days)
     and days >= 330;
    then qualified_individual_by_physical_presence(p, period_start);
}
rule S911D1BPhysicalPresenceQualifiesForYear defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for period_start: Date;
    when citizen_or_resident_of_us(p)
     and tax_home_in_foreign_country_911d3(p, y)
     and qualified_individual_by_physical_presence(p, period_start)
     and us.irc.core::year_of(p, y);
    then qualified_individual(p, y);
}

// --- Exclusion amount (statutory base $80,000; later years indexed) ------
//
// The statutory text fixes $80,000 (section 911(b)(2)(A), (D)(i)); years
// after the base year are indexed for inflation under (b)(2)(D)(ii)-(iii),
// whose published dollar amount is a Rev. Proc. figure this package does not
// invent — recorded as a SOURCE_GAP row for any taxable year after the
// statutory base year until the Rev. Proc. amount is pinned.
pub relation foreign_earned_income_amount(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the individual's foreign earned income for the taxable year, for section 911(a)(1) and (b)(2)(A)'s cap";
}
@source(IRC_S911_B, relation = formalizes, coverage = partial, quote = "shall not exceed the amount of foreign earned income computed on a daily basis at an annual rate equal to the exclusion amount for the calendar year in which such taxable year begins")
pub relation foreign_earned_income_exclusion_amount(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, excluded: Money) kind institutional {
    label en official "the amount of foreign earned income excludable under section 911(a)(1), capped at the lesser of the individual's foreign earned income or the section 911(b)(2) exclusion amount for the year (pro-rated for a year that is not a full qualifying year under (d)(6), not modeled this stage — TECH_GAP)";
}
// `ForeignEarnedIncomeExclusionAmount` is the A3 parameter symbol declared
// by `exclusion-amount-911b.lawparam.json` (time-varying over `legal_time`,
// resolved automatically at evaluation — not a relation this file
// re-declares, per the convention `us.irc.core`/`nz.rates-rebate` use for
// `.lawparam.json`-backed constants). Its dataset carries ONE value row
// (the 2005 statutory base, $80,000): any taxable year after 2005 reads a
// SOURCE_GAP until the Rev. Proc. indexed figure for that year is pinned.
rule S911ExclusionCappedAtStatutoryAmount defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for income: Money;
    when qualified_individual(p, y)
     and foreign_earned_income_amount(p, y, income);
    then foreign_earned_income_exclusion_amount(p, y, min(income, ForeignEarnedIncomeExclusionAmount));
}

// --- Election as a power, with the 5-year revocation bar ------------------

pub relation elects_911_exclusion(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind empirical {
    label en unofficial "the individual makes the section 911(e) election to have this section apply, for the taxable year";
}
pub relation revoked_911_election_in_year(p: us.irc.core::Individual, revoked_year: us.irc.core::TaxableYear) kind empirical {
    label en unofficial "the individual revoked a prior section 911(e) election effective for revoked_year, for the section 911(e)(2) 5-year bar";
}
relation within_five_years_of_revocation(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind empirical {
    label en unofficial "the taxable year y falls within the 5 taxable years after a year for which the individual revoked a section 911(e) election, without IRS consent to re-elect earlier (section 911(e)(2)) — asserted directly because exact year-distance arithmetic over TaxableYear identity is not built this stage (TECH_GAP)";
}
@source(IRC_S911_E, relation = formalizes, coverage = partial, quote = "may not make another election under this section for any subsequent taxable year before the 6th taxable year after the taxable year for which such revocation was made")
pub relation election_911_effective(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the section 911(e) election is in effect for the year: the individual elected it and is not within the 5-year post-revocation bar";
}
rule S911EElectionPower defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    when elects_911_exclusion(p, y);
    unless within_five_years_of_revocation(p, y);
    then power S911ElectionOfExclusion {
        holder p;
        over p;
        exercise elects_911_exclusion(p, y);
        valid_when elects_911_exclusion(p, y);
        effect create(election_911_effective(p, y));
    };
}

// --- (c) Housing cost amount — stage 2 (IRC-10 stage 2, A13) --------------
//
// Modeled: the (1) housing-cost-amount formula and the (2)(A) limitation,
// both computed at the ANNUAL rate (16%/30% of the section 911(b)(2)
// exclusion amount) rather than the statute's "computed on a daily basis...
// multiplied by the number of days" construction — the same simplification
// stage 1's own S911ExclusionCappedAtStatutoryAmount rule already makes for
// the (b)(2) exclusion itself ("pro-rated for a year that is not a full
// qualifying year... not modeled this stage — TECH_GAP"); a qualifying
// period shorter than the full taxable year needs the SAME day-proration
// TECH_GAP, so this stage's housing rules inherit it rather than half-fix
// it here alone. (2)(B)'s geographic adjustment of the 30% figure is
// EXTERNAL_DEPENDENCY (Secretary regulations/guidance not yet issued into
// this pinned edition) — the bare 30% is used. (4) the self-employed
// deduction and its (B) limitation are modeled; the (C) 1-year carryover is
// a TECH_GAP (self-referential year-to-year ledger, same class as
// TECH-GAPS G97).

pub relation housing_expenses(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the reasonable housing expenses paid or incurred by or on behalf of the individual (and spouse/dependents residing with him) for housing in a foreign country during the taxable year, net of the section 911(c)(3)(A)(ii) interest/tax/section-216(a) exclusions and the second-foreign-household restriction of (c)(3)(B) — asserted directly as the already-net amount (INTERPRETATION: the (3)(A)(ii) exclusions and the (3)(B) single-abode restriction are not independently derived this stage)";
}
@source(IRC_S911_C, relation = formalizes, coverage = partial, quote = "16 percent of the amount (computed on a daily basis) in effect under subsection (b)(2)(D) for the calendar year in which such taxable year begins")
pub relation housing_cost_amount_base(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the section 911(c)(1)(B) base amount subtracted from housing expenses: 16 percent of the section 911(b)(2) exclusion amount in effect for the calendar year the taxable year begins (annual rate, not day-prorated this stage — see module note)";
}
rule S911C1BBaseHousingAmount defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    when qualified_individual(p, y);
    then housing_cost_amount_base(p, y, round(0.16 * ForeignEarnedIncomeExclusionAmount, 2, "HALF_UP"));
}
@source(IRC_S911_C, relation = formalizes, coverage = partial, quote = "30 percent (adjusted as may be provided under subparagraph (B)) of the amount (computed on a daily basis) in effect under subsection (b)(2)(D) for the calendar year in which the taxable year of the individual begins")
pub relation housing_cost_amount_limitation(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the section 911(c)(2)(A) limitation on housing expenses taken into account: 30 percent of the section 911(b)(2) exclusion amount for the year (the (2)(B) geographic-adjustment regulations are EXTERNAL_DEPENDENCY and not applied — the bare 30 percent is used)";
}
rule S911C2ALimitation defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    when qualified_individual(p, y);
    then housing_cost_amount_limitation(p, y, round(0.30 * ForeignEarnedIncomeExclusionAmount, 2, "HALF_UP"));
}
@source(IRC_S911_C, relation = formalizes, coverage = exact, quote = "means an amount equal to the excess of—\n(A) the housing expenses of an individual for the taxable year to the extent such expenses do not exceed the amount determined under paragraph (2), over\n(B) an amount equal to the product of—")
pub relation housing_cost_amount(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the section 911(c)(1) housing cost amount: the excess of housing expenses (capped at the (2)(A) limitation) over the (1)(B) base amount";
}
rule S911C1HousingCostAmount defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for expenses: Money;
    for base: Money;
    for cap: Money;
    when housing_expenses(p, y, expenses)
     and housing_cost_amount_base(p, y, base)
     and housing_cost_amount_limitation(p, y, cap);
    then housing_cost_amount(p, y, min(expenses, cap) - base);
}

// (4) Special rule where housing expenses not provided by employer: to the
// extent NOT attributable to employer-provided amounts, the housing cost
// amount is an above-the-line deduction, limited to foreign earned income
// less the amount excluded under (a).
pub relation housing_cost_amount_not_employer_provided(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the portion of the individual's section 911(c) housing cost amount for the year that is NOT attributable to employer-provided amounts (section 911(c)(4)(D)), for the (c)(4)(A) deduction — asserted directly rather than computed as housing_cost_amount minus an employer-provided-amounts relation (INTERPRETATION)";
}
@source(IRC_S911_C, relation = formalizes, coverage = partial, quote = "the limitation of this subparagraph is the excess of—\n(i) the foreign earned income of the individual for the taxable year, over\n(ii) the amount of such income excluded from gross income under subsection (a) for the taxable year")
pub relation housing_cost_deduction_limitation(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the section 911(c)(4)(B) limitation on the housing-cost deduction: foreign earned income for the year less the amount excluded under section 911(a) for the year";
}
rule S911C4BDeductionLimitation defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for income: Money;
    for excluded: Money;
    when foreign_earned_income_amount(p, y, income)
     and foreign_earned_income_exclusion_amount(p, y, excluded);
    then housing_cost_deduction_limitation(p, y, income - excluded);
}
@source(IRC_S911_C, relation = formalizes, coverage = partial, quote = "such amount shall be treated as a deduction allowable in computing adjusted gross income to the extent of the limitation of subparagraph (B)")
pub relation housing_cost_amount_deduction(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the section 911(c)(4)(A) deduction allowable in computing adjusted gross income for the non-employer-provided housing cost amount, capped at the (4)(B) limitation";
}
rule S911C4ADeduction defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for not_employer_provided: Money;
    for limitation: Money;
    when housing_cost_amount_not_employer_provided(p, y, not_employer_provided)
     and housing_cost_deduction_limitation(p, y, limitation);
    then housing_cost_amount_deduction(p, y, min(not_employer_provided, limitation));
}
// (4)(C) 1-year carryover of the amount disallowed by the (4)(B) limitation
// into the SUCCEEDING year only: declared but not computed — a genuine
// year-to-year running ledger (TECH-GAPS G97 class), not attempted this
// stage.
relation housing_cost_amount_carryover_to_succeeding_year(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "PENDING: the section 911(c)(4)(C) 1-year carryover of housing cost amounts disallowed under (4)(B) into the succeeding taxable year's own (4)(B)-style limitation — not modeled this stage (TECH_GAP, self-referential year-to-year ledger, same class as TECH-GAPS G97)";
}
