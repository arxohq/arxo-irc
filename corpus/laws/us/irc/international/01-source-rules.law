// §861(a) — income from sources within the United States: the source-rule
// classification for interest, dividends, personal services, and rentals or
// royalties. Stage 1 (IRC-10 stage 1, A13). §861(b) (allocation of
// deductions) is EXTERNAL_DEPENDENCY on Secretary regulations (Treasury
// Reg. 1.861-8 apportionment methodology) — not modeled here beyond the
// classification it presupposes. §861(a)(5),(7),(8),(9) (USRPI disposition,
// insurance underwriting, social security, guarantees) are NOT modeled in
// this stage (stage 2), except that the inventory-sale rule (a)(6) is stated
// as a typed dependency on §865 (owned by this same package but not modeled
// this stage) so a consumer sees the gap rather than silence. `::` import
// selection is RESERVED in language 0.2 (LDC-E0206) — every symbol below is
// fully qualified instead of a `use`/selective import.

// --- (a)(1) Interest ---------------------------------------------------

use self::{
    IRC_S861_A,
};

pub relation interest_payment(payer: us.irc.core::Person, payee: us.irc.core::Person, amount: Money) kind empirical {
    label en unofficial "an interest payment made by payer to payee, for section 861(a)(1) classification";
}
pub relation payer_is_noncorporate_resident(payer: us.irc.core::Person) kind empirical {
    label en unofficial "the payer is a noncorporate resident of the United States, for section 861(a)(1)";
}
relation foreign_branch_commercial_banking_deposit_interest(payer: us.irc.core::Person, payee: us.irc.core::Person) kind empirical {
    label en official "interest on deposits with a foreign branch of a domestic corporation or domestic partnership engaged in the commercial banking business — section 861(a)(1)(A)(i) exclusion";
}

@source(IRC_S861_A, relation = formalizes, coverage = partial, quote = "Interest from the United States or the District of Columbia, and interest on bonds, notes, or other interest-bearing obligations of noncorporate residents or domestic corporations")
pub relation us_source_interest(payer: us.irc.core::Person, payee: us.irc.core::Person, amount: Money) kind institutional {
    label en official "interest is treated as income from sources within the United States because the payer is the United States, the District of Columbia, a noncorporate resident, or a domestic corporation (section 861(a)(1))";
}
rule S861Para1InterestFromDomesticCorporation defeasible {
    for payer: us.irc.core::Corporation;
    for payee: us.irc.core::Person;
    for amount: Money;
    when interest_payment(payer, payee, amount)
     and us.irc.definitions::domestic(payer);
    unless foreign_branch_commercial_banking_deposit_interest(payer, payee)
     and interest_payment(payer, payee, amount);
    then us_source_interest(payer, payee, amount);
}
rule S861Para1InterestFromNoncorporateResident defeasible {
    for payer: us.irc.core::Person;
    for payee: us.irc.core::Person;
    for amount: Money;
    when interest_payment(payer, payee, amount)
     and payer_is_noncorporate_resident(payer);
    unless foreign_branch_commercial_banking_deposit_interest(payer, payee)
     and interest_payment(payer, payee, amount);
    then us_source_interest(payer, payee, amount);
}

// --- (a)(2) Dividends, with the (a)(2)(B) 25% look-through --------------

pub relation dividend_payment(payer: us.irc.core::Corporation, payee: us.irc.core::Person, amount: Money) kind empirical {
    label en unofficial "a dividend payment by a corporation, for section 861(a)(2) classification";
}
pub relation foreign_corp_eci_gross_income_ratio(payer: us.irc.core::Corporation, ratio: Decimal) kind empirical {
    label en official "the payer foreign corporation's ratio of gross income effectively connected (or treated as effectively connected) with the conduct of a US trade or business to its gross income from all sources, for the 3-year testing period ending with the close of its taxable year preceding the dividend declaration (section 861(a)(2)(B))";
}

@source(IRC_S861_A, relation = formalizes, coverage = partial, quote = "The amount received as dividends")
pub relation us_source_dividend(payer: us.irc.core::Corporation, payee: us.irc.core::Person, amount: Money) kind institutional {
    label en official "a dividend is treated as income from sources within the United States (section 861(a)(2))";
}
rule S861Para2ADividendFromDomesticCorporation strict {
    for payer: us.irc.core::Corporation;
    for payee: us.irc.core::Person;
    for amount: Money;
    when dividend_payment(payer, payee, amount)
     and us.irc.definitions::domestic(payer);
    then us_source_dividend(payer, payee, amount);
}
// (a)(2)(B): a foreign corporation's dividend is US-source ONLY to the
// extent (ratio) its gross income was ECI with a US trade or business
// during the 25%-look-through testing period; below 25% ECI ratio, none of
// the dividend is US-source under this look-through paragraph (the 25%
// threshold appears as "unless less than 25 percent ... was effectively
// connected" in the statute — restated positively as the ratio test below).
@source(IRC_S861_A, relation = formalizes, coverage = partial, quote = "unless less than 25 percent of the gross income from all sources of such foreign corporation for the 3-year period ending with the close of its taxable year preceding the declaration of such dividends")
pub relation foreign_dividend_us_source_ratio(payer: us.irc.core::Corporation, ratio: Decimal) kind institutional {
    label en official "the fraction of a foreign corporation's dividend treated as US-source under the section 861(a)(2)(B) 25%-look-through, equal to the corporation's ECI gross-income ratio for the testing period once that ratio is 25% or more, and zero below that threshold";
}
rule S861Para2BForeignDividendLookThroughApplies defeasible {
    for payer: us.irc.core::Corporation;
    for ratio: Decimal;
    when foreign_corp_eci_gross_income_ratio(payer, ratio)
     and us.irc.definitions::foreign(payer)
     and ratio >= 0.25;
    then foreign_dividend_us_source_ratio(payer, ratio);
}
rule S861Para2BForeignDividendBelowThreshold defeasible {
    for payer: us.irc.core::Corporation;
    for ratio: Decimal;
    when foreign_corp_eci_gross_income_ratio(payer, ratio)
     and us.irc.definitions::foreign(payer)
     and ratio < 0.25;
    then foreign_dividend_us_source_ratio(payer, 0.00);
}
// TECH_GAP (TECH-GAPS.md G90): the statute's US-source AMOUNT for an
// (a)(2)(B) dividend is `amount * ratio`; this stage stops at classifying
// the ratio itself and does not compute the apportioned Money amount — the
// exact rounding rule (a)(2)(B) intends is not stated in the text and was
// not confirmed against a worked example before this stage's time ran out.

// --- (a)(3) Personal services, with the $3,000/90-day commercial-traveler
// exception -----------------------------------------------------------------

pub relation personal_services_performed_in_us(worker: us.irc.core::Individual, amount: Money) kind empirical {
    label en unofficial "compensation for labor or personal services performed within the United States, for section 861(a)(3) classification";
}
pub relation days_present_performing_services_in_us(worker: us.irc.core::Individual, y: us.irc.core::TaxableYear, days: Integer) kind empirical {
    label en official "the total number of days during the taxable year the nonresident alien individual is present performing the services in the United States, for the section 861(a)(3)(A) 90-day test";
}
pub relation nonresident_alien(worker: us.irc.core::Individual) kind empirical {
    label en unofficial "the worker is a nonresident alien individual, for section 861(a)(3)";
}
pub relation employer_or_contracting_party_of(worker: us.irc.core::Individual, employer: us.irc.core::Person) kind empirical {
    label en unofficial "the worker performs the services as an employee of, or under a contract with, this person, for section 861(a)(3)(C)";
}
relation employer_not_engaged_in_us_trade_or_business(employer: us.irc.core::Person) kind empirical {
    label en official "the employer is a nonresident alien, foreign partnership, or foreign corporation not engaged in trade or business within the United States — section 861(a)(3)(C)(i)";
}
relation employer_us_person_services_for_foreign_office(employer: us.irc.core::Person, worker: us.irc.core::Individual) kind empirical {
    label en official "the employer is a US citizen or resident, domestic partnership, or domestic corporation, and the services are performed for an office or place of business the employer maintains in a foreign country or US possession — section 861(a)(3)(C)(ii)";
}

@source(IRC_S861_A, relation = formalizes, coverage = partial, quote = "Compensation for labor or personal services performed in the United States")
pub relation us_source_personal_services_income(worker: us.irc.core::Individual, amount: Money) kind institutional {
    label en official "compensation for personal services is treated as income from sources within the United States because it is performed here, unless the commercial-traveler exception of section 861(a)(3)(A)-(C) applies";
}
@source(IRC_S861_A, relation = formalizes, coverage = partial, quote = "the labor or services are performed by a nonresident alien individual temporarily present in the United States for a period or periods not exceeding a total of 90 days during the taxable year")
pub relation qualifies_for_commercial_traveler_exception(worker: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the section 861(a)(3)(A)-(C) commercial-traveler exception applies: 90 days or fewer present performing services, $3,000 or less aggregate compensation, and the employer condition of (C)(i) or (C)(ii) is met — so the compensation is NOT US-source under section 861(a)(3)";
}
rule S861Para3PersonalServicesGeneralRule defeasible {
    for worker: us.irc.core::Individual;
    for amount: Money;
    for y: us.irc.core::TaxableYear;
    when personal_services_performed_in_us(worker, amount);
    unless qualifies_for_commercial_traveler_exception(worker, y, amount);
    then us_source_personal_services_income(worker, amount);
}
// boundaries are inclusive at 90 days ("not exceeding a total of 90 days")
// and $3,000 ("does not exceed $3,000 in the aggregate") — both `<=`.
rule S861Para3CommercialTravelerExceptionForeignEmployer defeasible {
    for worker: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    for employer: us.irc.core::Person;
    for days: Integer;
    when nonresident_alien(worker)
     and personal_services_performed_in_us(worker, amount)
     and days_present_performing_services_in_us(worker, y, days)
     and days <= 90
     and amount <= 3000 USD
     and employer_or_contracting_party_of(worker, employer)
     and employer_not_engaged_in_us_trade_or_business(employer);
    then qualifies_for_commercial_traveler_exception(worker, y, amount);
}
rule S861Para3CommercialTravelerExceptionUsEmployerForeignOffice defeasible {
    for worker: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    for employer: us.irc.core::Person;
    for days: Integer;
    when nonresident_alien(worker)
     and personal_services_performed_in_us(worker, amount)
     and days_present_performing_services_in_us(worker, y, days)
     and days <= 90
     and amount <= 3000 USD
     and employer_or_contracting_party_of(worker, employer)
     and employer_us_person_services_for_foreign_office(employer, worker);
    then qualifies_for_commercial_traveler_exception(worker, y, amount);
}

// --- (a)(4) Rentals and royalties ---------------------------------------

pub relation rental_or_royalty_property(payer: us.irc.core::Person, payee: us.irc.core::Person, amount: Money, property_id: Text) kind empirical {
    label en unofficial "a rental or royalty payment linked to the property or intangible it is paid for, for section 861(a)(4) classification";
}
pub relation property_located_in_us(property_id: Text) kind empirical {
    label en unofficial "the property (or the intangible used or the privilege exercised) is located in, or used in, the United States, for section 861(a)(4)";
}

@source(IRC_S861_A, relation = formalizes, coverage = partial, quote = "Rentals or royalties from property located in the United States or from any interest in such property, including rentals or royalties for the use of or for the privilege of using in the United States patents, copyrights, secret processes and formulas, good will, trade-marks, trade brands, franchises, and other like property.")
pub relation us_source_rental_or_royalty(payer: us.irc.core::Person, payee: us.irc.core::Person, amount: Money) kind institutional {
    label en official "a rental or royalty is treated as income from sources within the United States because the property is located in, or the right is used in, the United States (section 861(a)(4))";
}
rule S861Para4RentalsAndRoyalties strict {
    for payer: us.irc.core::Person;
    for payee: us.irc.core::Person;
    for amount: Money;
    for property_id: Text;
    when rental_or_royalty_property(payer, payee, amount, property_id)
     and property_located_in_us(property_id);
    then us_source_rental_or_royalty(payer, payee, amount);
}

// --- (a)(6) Inventory sale — typed dependency on section 865 -------------
//
// EXTERNAL_DEPENDENCY (this package's own §865, not yet modeled this
// stage): section 865(b)'s title-passage rule, referenced by section
// 861(a)(6), determines whether a purchase-outside/sale-inside inventory
// transaction is US-source. Declared as a typed pending dependency (per
// AGENT-BRIEF.md: "a reference to a section not yet implemented is a typed
// dependency contract ... not an invented result") — see
// coverage/international.deps.json.
relation inventory_purchased_outside_us_sold_within_us(seller: us.irc.core::Person, amount: Money) kind empirical {
    label en unofficial "inventory property (section 865(i)(1)) purchased outside the United States and sold or exchanged within the United States, for section 861(a)(6)";
}
relation us_source_inventory_sale_income(seller: us.irc.core::Person, amount: Money) kind institutional {
    label en official "PENDING: gains from the section 861(a)(6) purchase-outside/sale-inside inventory pattern are US-source under the section 865(b) title-passage rule (external_norm_unresolved: section 865 title-passage contract, owned by this same package, not yet modeled this stage)";
}
