// Stage 3 (TECH_GAP reduction), module 45: section 897(c)(1)(A)(ii), (c)(1)(B), (c)(5), (c)(6)(C), (h)(3)-(5), (k)(2)(B)-(E),
// (k)(4). Status implemented_unverified: not a legal review; scenarios in tests/s897-stage3.lawtest are written, NOT executed.
//
// Modeling notes.
//  * The testing periods are derived by the latest-start rule: the shortest of several periods ending on the same
//    date is the one that starts last (candidate starts plus "no strictly later candidate", TECH-GAPS G136).
//  * The greatest foreign holding in the testing period (h)(4)(C) is the maximum of the dated holdings given as
//    case facts (same candidate rule); holdings are case facts because a running ownership ledger is not derived.
//  * Percentages are numbers on a 0-100 scale.

// --- §897(c)(1)(A)(ii): the shorter testing period -----------------------------------------------------------------

use self::{
    IRC_S897_C,
    IRC_S897_H,
    IRC_S897_K,
    asset_treated_as_held_by_first_corporation_897c5A,
    domestically_controlled_qualified_investment_entity,
    holds_controlling_interest_897c5B,
    interest_in_domestic_corporation_897,
    qualified_shareholder_897k3A,
    reit_stock_held_by_shareholder_897k2,
    taxpayer_established_never_usrphc,
    united_states_real_property_interest,
    usrpi_gain_897k4b,
    usrpi_gain_increase_897k4a,
};

pub relation holding_start_897c1AiiI(holder: us.irc.core::Person, item_id: Text, started_on: Date) kind empirical {
    label en official "the date the taxpayer began to hold the interest";
}
pub relation disposition_date_897c1Aii(holder: us.irc.core::Person, item_id: Text, on: Date) kind empirical {
    label en official "the date of the disposition of the interest";
}
pub relation period_start_candidate_897c1Aii(holder: us.irc.core::Person, item_id: Text, start: Date) kind institutional {
    label en official "a candidate start of the testing period: the day after June 18, 1980 or the day the taxpayer began to hold the interest, if later (subclause (I)); or the start of the 5-year period ending on the disposition (subclause (II))";
}
@source(IRC_S897_C, relation = formalizes, coverage = exact, quote = "(I) the period after June 18, 1980, during which the taxpayer held such interest, or")
rule S897C1AiiIHoldingPeriodAfter1980Later defeasible {
    for holder: us.irc.core::Person;
    for item_id: Text;
    for started_on: Date;
    when holding_start_897c1AiiI(holder, item_id, started_on)
     and started_on >= @1980-06-19;
    then period_start_candidate_897c1Aii(holder, item_id, started_on);
}
@source(IRC_S897_C, relation = formalizes, coverage = exact, quote = "(I) the period after June 18, 1980, during which the taxpayer held such interest, or")
rule S897C1AiiIHoldingPeriodAfter1980Earlier defeasible {
    for holder: us.irc.core::Person;
    for item_id: Text;
    for started_on: Date;
    when holding_start_897c1AiiI(holder, item_id, started_on)
     and started_on < @1980-06-19;
    then period_start_candidate_897c1Aii(holder, item_id, @1980-06-19);
}
@source(IRC_S897_C, relation = formalizes, coverage = exact, quote = "(II) the 5-year period ending on the date of the disposition of such interest.")
rule S897C1AiiIIFiveYearPeriod defeasible {
    for holder: us.irc.core::Person;
    for item_id: Text;
    for disposed_on: Date;
    for calendar_before_1: Date;
    when disposition_date_897c1Aii(holder, item_id, disposed_on)
        and us.irc.core::civil_calendar_boundary_before(disposed_on, 5, us.irc.core::CalendarYear, calendar_before_1);
    then period_start_candidate_897c1Aii(holder, item_id, calendar_before_1);
}
pub relation testing_period_start_897c1Aii(holder: us.irc.core::Person, item_id: Text, start: Date) kind institutional {
    label en official "the start of the shorter of the two periods (both end on the date of the disposition): the later of the candidate starts";
}
@source(IRC_S897_C, relation = formalizes, coverage = exact, quote = "(ii) any interest (other than an interest solely as a creditor) in any domestic corporation unless the")
rule S897C1AiiShorterPeriodStart defeasible {
    for holder: us.irc.core::Person;
    for item_id: Text;
    for start: Date;
    for later: Date;
    when period_start_candidate_897c1Aii(holder, item_id, start);
    unless period_start_candidate_897c1Aii(holder, item_id, later)
     and later > start
     and period_start_candidate_897c1Aii(holder, item_id, start);
    then testing_period_start_897c1Aii(holder, item_id, start);
}

// --- §897(c)(1)(A)(ii), (B): interests in corporations ---------------------------------------------------------------

pub relation interest_item_in_corporation_897c1Aii(holder: us.irc.core::Person, item_id: Text, corp: us.irc.core::Corporation) kind empirical {
    label en official "the interest (other than solely as a creditor) is an interest in the corporation";
}
pub relation corporation_held_no_usrpi_at_disposition_897c1Bi(corp: us.irc.core::Corporation) kind empirical {
    label en official "as of the date of the disposition the corporation did not hold any United States real property interests";
}
pub relation all_usrpis_disposed_with_full_gain_recognized_897c1BiiI(corp: us.irc.core::Corporation) kind empirical {
    label en official "all of the United States real property interests the corporation held at any time during the shorter period were disposed of in transactions in which the full amount of the gain (if any) was recognized";
}
pub relation all_usrpis_ceased_by_operation_of_897c1B_897c1BiiII(corp: us.irc.core::Corporation) kind empirical {
    label en official "all of those interests ceased to be United States real property interests by reason of the application of this subparagraph to one or more other corporations";
}
pub relation corporation_or_predecessor_was_ric_or_reit_in_period_897c1Biii(corp: us.irc.core::Corporation) kind empirical {
    label en official "the corporation or a predecessor was a regulated investment company or a real estate investment trust at some time during the shorter period";
}
pub relation corporation_interest_excluded_897c1B(corp: us.irc.core::Corporation) kind institutional {
    label en official "an interest in the corporation is not a United States real property interest under subparagraph (B): no USRPIs held at disposition, all earlier USRPIs disposed of with full gain recognized (or ceased by this subparagraph), and no RIC or REIT status in the period";
}
@source(IRC_S897_C, relation = formalizes, coverage = exact, quote = "(I) were disposed of in transactions in which the full amount of the gain (if any) was recognized, or")
rule S897C1BExclusionWhereGainFullyRecognized defeasible {
    for corp: us.irc.core::Corporation;
    when corporation_held_no_usrpi_at_disposition_897c1Bi(corp)
     and all_usrpis_disposed_with_full_gain_recognized_897c1BiiI(corp);
    unless corporation_or_predecessor_was_ric_or_reit_in_period_897c1Biii(corp)
     and corporation_held_no_usrpi_at_disposition_897c1Bi(corp);
    then corporation_interest_excluded_897c1B(corp);
}
@source(IRC_S897_C, relation = formalizes, coverage = exact, quote = "(II) ceased to be United States real property interests by reason of the application of this subparagraph to")
rule S897C1BExclusionWhereInterestsCeasedByExclusion defeasible {
    for corp: us.irc.core::Corporation;
    when corporation_held_no_usrpi_at_disposition_897c1Bi(corp)
     and all_usrpis_ceased_by_operation_of_897c1B_897c1BiiII(corp);
    unless corporation_or_predecessor_was_ric_or_reit_in_period_897c1Biii(corp)
     and corporation_held_no_usrpi_at_disposition_897c1Bi(corp);
    then corporation_interest_excluded_897c1B(corp);
}
@source(IRC_S897_C, relation = formalizes, coverage = exact, quote = "(ii) any interest (other than an interest solely as a creditor) in any domestic corporation unless the")
rule S897C1AiiInterestInDomesticCorporationIsUsrpi defeasible {
    for holder: us.irc.core::Person;
    for item_id: Text;
    for corp: us.irc.core::Corporation;
    when interest_item_in_corporation_897c1Aii(holder, item_id, corp)
     and interest_in_domestic_corporation_897(holder, corp);
    unless taxpayer_established_never_usrphc(holder, corp)
     and interest_item_in_corporation_897c1Aii(holder, item_id, corp)
     and interest_in_domestic_corporation_897(holder, corp);
    unless corporation_interest_excluded_897c1B(corp)
     and interest_item_in_corporation_897c1Aii(holder, item_id, corp)
     and interest_in_domestic_corporation_897(holder, corp);
    then united_states_real_property_interest(holder, item_id);
}

// --- §897(c)(5)(A): chains of corporations ---------------------------------------------------------------------------------

pub relation second_corporation_stock_disregarded_897c5Ai(first: us.irc.core::Corporation, second: us.irc.core::Corporation) kind institutional {
    label en official "the stock the first corporation holds in the second corporation is not taken into account in determining whether the first corporation is a United States real property holding corporation (the fair market value sums of section 897(c)(2) are case inputs already net of it)";
}
@source(IRC_S897_C, relation = formalizes, coverage = partial, quote = "(i) the stock which the first corporation holds in the second corporation shall not be taken into account,")
rule S897C5AiSecondCorporationStockDisregarded defeasible {
    for first: us.irc.core::Corporation;
    for second: us.irc.core::Corporation;
    when holds_controlling_interest_897c5B(first, second);
    then second_corporation_stock_disregarded_897c5Ai(first, second);
}
pub relation second_corporation_asset_used_in_trade_or_business_897c5(second: us.irc.core::Corporation, asset_id: Text) kind empirical {
    label en official "the asset is used or held for use by the second corporation in a trade or business";
}
pub relation asset_treated_as_used_in_trade_or_business_by_first_897c5Aiii(first: us.irc.core::Corporation, second: us.irc.core::Corporation, asset_id: Text) kind institutional {
    label en official "an asset treated as held by the first corporation that is used or held for use by the second corporation in a trade or business is treated as so used or held by the first corporation";
}
@source(IRC_S897_C, relation = formalizes, coverage = exact, quote = "(iii) any asset treated as held by the first corporation by reason of clause (ii) which is used or held for")
rule S897C5AiiiAssetUseAttributedToFirst defeasible {
    for first: us.irc.core::Corporation;
    for second: us.irc.core::Corporation;
    for asset_id: Text;
    for portion: Money;
    when asset_treated_as_held_by_first_corporation_897c5A(first, second, asset_id, portion)
     and second_corporation_asset_used_in_trade_or_business_897c5(second, asset_id);
    then asset_treated_as_used_in_trade_or_business_by_first_897c5Aiii(first, second, asset_id);
}
pub relation upper_corporation_stock_percentage_of_first_fmv_897c5(upper: us.irc.core::Corporation, first: us.irc.core::Corporation, percentage: Decimal) kind empirical {
    label en official "the percentage of the fair market value of all classes of stock of the first corporation held by the corporation above it in the chain";
}
pub relation asset_treated_as_held_by_upper_corporation_897c5A(upper: us.irc.core::Corporation, first: us.irc.core::Corporation, second: us.irc.core::Corporation, asset_id: Text, portion: Money) kind institutional {
    label en official "applying the preceding sentence successively: the corporation above the first corporation in a chain holds a portion of the asset in proportion to its percentage of the first corporation; one step is derived, longer chains would need a recursion the runtime subset rejects (LDC-E4102)";
}
@source(IRC_S897_C, relation = formalizes, coverage = partial, quote = "Any asset treated as held by the first corporation by reason of the preceding sentence shall be so treated")
rule S897C5ASuccessiveOneStep defeasible {
    for upper: us.irc.core::Corporation;
    for first: us.irc.core::Corporation;
    for second: us.irc.core::Corporation;
    for asset_id: Text;
    for portion: Money;
    for pct: Decimal;
    when asset_treated_as_held_by_first_corporation_897c5A(first, second, asset_id, portion)
     and upper_corporation_stock_percentage_of_first_fmv_897c5(upper, first, pct)
     and pct >= 50.0;
    then asset_treated_as_held_by_upper_corporation_897c5A(upper, first, second, asset_id, round(portion * (pct / 100.0), 2, "HALF_UP"));
}

// --- §897(h)(4): definitions for qualified investment entities ---------------------------------------------------------

pub relation entity_is_reit_897h4Ai(qie: us.irc.core::Corporation) kind empirical {
    label en official "the entity is a real estate investment trust";
}
pub relation entity_is_ric_897h4Aii(qie: us.irc.core::Corporation) kind empirical {
    label en official "the entity is a regulated investment company";
}
pub relation ric_is_or_would_be_usrphc_without_exceptions_897h4Aii(qie: us.irc.core::Corporation) kind empirical {
    label en official "the regulated investment company is a United States real property holding corporation, or would be if the exceptions of subsections (c)(3) and (h)(2) did not apply to interests in any REIT or RIC";
}
pub relation qualified_investment_entity_by_definition_897h4A(qie: us.irc.core::Corporation) kind institutional {
    label en official "a qualified investment entity by definition: a real estate investment trust, or a regulated investment company that is (or would be without the (c)(3) and (h)(2) exceptions) a United States real property holding corporation";
}
@source(IRC_S897_H, relation = formalizes, coverage = exact, quote = "The term \"qualified investment entity\" means—")
rule S897H4AiReit defeasible {
    for qie: us.irc.core::Corporation;
    when entity_is_reit_897h4Ai(qie);
    then qualified_investment_entity_by_definition_897h4A(qie);
}
@source(IRC_S897_H, relation = formalizes, coverage = exact, quote = "The term \"qualified investment entity\" means—")
rule S897H4AiiRic defeasible {
    for qie: us.irc.core::Corporation;
    when entity_is_ric_897h4Aii(qie)
     and ric_is_or_would_be_usrphc_without_exceptions_897h4Aii(qie);
    then qualified_investment_entity_by_definition_897h4A(qie);
}
pub relation qie_existence_start_897h4Diii(qie: us.irc.core::Corporation, start: Date) kind empirical {
    label en official "the date the qualified investment entity came into existence";
}
pub relation qie_event_date_897h4D(qie: us.irc.core::Corporation, on: Date) kind empirical {
    label en official "the date of the disposition or of the distribution, as the case may be";
}
pub relation testing_period_start_candidate_897h4D(qie: us.irc.core::Corporation, start: Date) kind institutional {
    label en official "a candidate start: June 19, 1980 (clause (i)), the start of the 5-year period ending on the event date (clause (ii)), or the date the entity came into existence (clause (iii))";
}
@source(IRC_S897_H, relation = formalizes, coverage = exact, quote = "(i) the period beginning on June 19, 1980, and ending on the date of the disposition or of the distribution,")
rule S897H4DiPeriodFrom1980 defeasible {
    for qie: us.irc.core::Corporation;
    for event_on: Date;
    when qie_event_date_897h4D(qie, event_on);
    then testing_period_start_candidate_897h4D(qie, @1980-06-19);
}
@source(IRC_S897_H, relation = formalizes, coverage = exact, quote = "(ii) the 5-year period ending on the date of the disposition or of the distribution, as the case may be, or")
rule S897H4DiiFiveYearPeriod defeasible {
    for qie: us.irc.core::Corporation;
    for event_on: Date;
    for calendar_before_1: Date;
    when qie_event_date_897h4D(qie, event_on)
        and us.irc.core::civil_calendar_boundary_before(event_on, 5, us.irc.core::CalendarYear, calendar_before_1);
    then testing_period_start_candidate_897h4D(qie, calendar_before_1);
}
@source(IRC_S897_H, relation = formalizes, coverage = exact, quote = "(iii) the period during which the qualified investment entity was in existence.")
rule S897H4DiiiExistencePeriod defeasible {
    for qie: us.irc.core::Corporation;
    for start: Date;
    when qie_existence_start_897h4Diii(qie, start);
    then testing_period_start_candidate_897h4D(qie, start);
}
pub relation testing_period_start_897h4D(qie: us.irc.core::Corporation, start: Date) kind institutional {
    label en official "the testing period is whichever of the three periods is the shortest: all end on the event date, so it begins on the latest candidate start";
}
@source(IRC_S897_H, relation = formalizes, coverage = exact, quote = "The term \"testing period\" means whichever of the following periods is the shortest:")
rule S897H4DShortestPeriodStartsLast defeasible {
    for qie: us.irc.core::Corporation;
    for start: Date;
    for later: Date;
    when testing_period_start_candidate_897h4D(qie, start);
    unless testing_period_start_candidate_897h4D(qie, later)
     and later > start
     and testing_period_start_candidate_897h4D(qie, start);
    then testing_period_start_897h4D(qie, start);
}
pub relation foreign_holding_percent_at_time_897h4C(qie: us.irc.core::Corporation, at: Date, percent: Decimal) kind empirical {
    label en official "the percentage of the stock of the qualified investment entity held directly or indirectly by foreign persons on the date, after the special ownership rules of subparagraph (E)";
}
pub relation foreign_ownership_percentage_897h4C(qie: us.irc.core::Corporation, percent: Decimal) kind institutional {
    label en official "the foreign ownership percentage: the percentage held by foreign persons at the time during the testing period when the foreign ownership was greatest";
}
@source(IRC_S897_H, relation = formalizes, coverage = exact, quote = "The term \"foreign ownership percentage\" means that percentage of the stock of the qualified investment entity")
rule S897H4CGreatestForeignHoldingInTestingPeriod defeasible {
    for qie: us.irc.core::Corporation;
    for at: Date;
    for percent: Decimal;
    for start: Date;
    for event_on: Date;
    for other_at: Date;
    for other_percent: Decimal;
    when foreign_holding_percent_at_time_897h4C(qie, at, percent)
     and testing_period_start_897h4D(qie, start)
     and qie_event_date_897h4D(qie, event_on)
     and at >= start
     and at <= event_on;
    unless foreign_holding_percent_at_time_897h4C(qie, other_at, other_percent)
     and other_percent > percent
     and other_at >= start
     and other_at <= event_on
     and foreign_holding_percent_at_time_897h4C(qie, at, percent)
     and testing_period_start_897h4D(qie, start)
     and qie_event_date_897h4D(qie, event_on);
    then foreign_ownership_percentage_897h4C(qie, percent);
}
@source(IRC_S897_H, relation = formalizes, coverage = exact, quote = "The term \"domestically controlled qualified investment entity\" means any qualified investment entity in which at all times during the testing period less than")
rule S897H4BDomesticallyControlledByGreatestHolding defeasible {
    for qie: us.irc.core::Corporation;
    for percent: Decimal;
    when qualified_investment_entity_by_definition_897h4A(qie)
     and foreign_ownership_percentage_897h4C(qie, percent)
     and percent < 50.0;
    then domestically_controlled_qualified_investment_entity(qie);
}

// --- §897(h)(4)(E): special ownership rules -------------------------------------------------------------------------------

pub relation holder_percent_of_regularly_traded_class_during_testing_period_897h4Ei(qie: us.irc.core::Corporation, holder: us.irc.core::Person, greatest_percent: Decimal) kind empirical {
    label en official "the greatest percentage of the regularly traded (United States established securities market) class of stock the person held at any time during the testing period";
}
pub relation qie_has_actual_knowledge_holder_not_us_person_897h4Ei(qie: us.irc.core::Corporation, holder: us.irc.core::Person) kind empirical {
    label en official "the qualified investment entity has actual knowledge that the person is not a United States person";
}
pub relation holder_treated_as_united_states_person_897h4Ei(qie: us.irc.core::Corporation, holder: us.irc.core::Person) kind institutional {
    label en official "a person holding less than 5 percent of a regularly traded class at all times during the testing period is treated as a United States person unless the entity has actual knowledge otherwise";
}
@source(IRC_S897_H, relation = formalizes, coverage = exact, quote = "(i) in the case of any class of stock of the qualified investment entity which is regularly traded on an")
rule S897H4EiSmallHolderTreatedAsUsPerson defeasible {
    for qie: us.irc.core::Corporation;
    for holder: us.irc.core::Person;
    for percent: Decimal;
    when holder_percent_of_regularly_traded_class_during_testing_period_897h4Ei(qie, holder, percent)
     and percent < 5.0;
    unless qie_has_actual_knowledge_holder_not_us_person_897h4Ei(qie, holder)
     and holder_percent_of_regularly_traded_class_during_testing_period_897h4Ei(qie, holder, percent);
    then holder_treated_as_united_states_person_897h4Ei(qie, holder);
}
pub relation other_qie_holding_stock_of_qie_897h4Eii(qie: us.irc.core::Corporation, other: us.irc.core::Corporation) kind empirical {
    label en official "the stock in the qualified investment entity is held by another qualified investment entity";
}
pub relation other_qie_class_regularly_traded_897h4EiiI(other: us.irc.core::Corporation) kind empirical {
    label en official "a class of stock of the other qualified investment entity is regularly traded on an established securities market";
}
pub relation other_qie_is_ric_with_redeemable_securities_897h4EiiII(other: us.irc.core::Corporation) kind empirical {
    label en official "the other qualified investment entity is a regulated investment company which issues redeemable securities (section 2 of the Investment Company Act of 1940)";
}
pub relation stock_held_by_other_qie_treated_as_held_by_foreign_person_897h4Eii(qie: us.irc.core::Corporation, other: us.irc.core::Corporation) kind institutional {
    label en official "stock held by another qualified investment entity described in subclause (I) or (II) is treated as held by a foreign person, unless that entity is domestically controlled";
}
@source(IRC_S897_H, relation = formalizes, coverage = exact, quote = "shall be treated as held by a foreign person, except that if such other qualified investment entity is")
rule S897H4EiiForeignByRegularlyTradedClass defeasible {
    for qie: us.irc.core::Corporation;
    for other: us.irc.core::Corporation;
    when other_qie_holding_stock_of_qie_897h4Eii(qie, other)
     and other_qie_class_regularly_traded_897h4EiiI(other);
    unless domestically_controlled_qualified_investment_entity(other)
     and other_qie_holding_stock_of_qie_897h4Eii(qie, other);
    then stock_held_by_other_qie_treated_as_held_by_foreign_person_897h4Eii(qie, other);
}
@source(IRC_S897_H, relation = formalizes, coverage = exact, quote = "shall be treated as held by a foreign person, except that if such other qualified investment entity is")
rule S897H4EiiForeignByRedeemableRic defeasible {
    for qie: us.irc.core::Corporation;
    for other: us.irc.core::Corporation;
    when other_qie_holding_stock_of_qie_897h4Eii(qie, other)
     and other_qie_is_ric_with_redeemable_securities_897h4EiiII(other);
    unless domestically_controlled_qualified_investment_entity(other)
     and other_qie_holding_stock_of_qie_897h4Eii(qie, other);
    then stock_held_by_other_qie_treated_as_held_by_foreign_person_897h4Eii(qie, other);
}
pub relation stock_held_by_other_qie_treated_as_held_by_us_person_897h4Eii(qie: us.irc.core::Corporation, other: us.irc.core::Corporation) kind institutional {
    label en official "if the other qualified investment entity is domestically controlled (determined after application of this subparagraph), its stock in the entity is treated as held by a United States person";
}
@source(IRC_S897_H, relation = formalizes, coverage = exact, quote = "shall be treated as held by a foreign person, except that if such other qualified investment entity is")
rule S897H4EiiUsIfDomesticallyControlledByClass defeasible {
    for qie: us.irc.core::Corporation;
    for other: us.irc.core::Corporation;
    when other_qie_holding_stock_of_qie_897h4Eii(qie, other)
     and other_qie_class_regularly_traded_897h4EiiI(other)
     and domestically_controlled_qualified_investment_entity(other);
    then stock_held_by_other_qie_treated_as_held_by_us_person_897h4Eii(qie, other);
}
@source(IRC_S897_H, relation = formalizes, coverage = exact, quote = "shall be treated as held by a foreign person, except that if such other qualified investment entity is")
rule S897H4EiiUsIfDomesticallyControlledByRic defeasible {
    for qie: us.irc.core::Corporation;
    for other: us.irc.core::Corporation;
    when other_qie_holding_stock_of_qie_897h4Eii(qie, other)
     and other_qie_is_ric_with_redeemable_securities_897h4EiiII(other)
     and domestically_controlled_qualified_investment_entity(other);
    then stock_held_by_other_qie_treated_as_held_by_us_person_897h4Eii(qie, other);
}
pub relation other_qie_us_held_percent_897h4Eiii(other: us.irc.core::Corporation, us_percent: Decimal) kind empirical {
    label en official "the percentage of the stock of the other qualified investment entity which is (or is treated under clause (ii) or (iii) as) held by a United States person";
}
pub relation other_qie_stock_percent_of_qie_897h4Eiii(qie: us.irc.core::Corporation, other: us.irc.core::Corporation, percent: Decimal) kind empirical {
    label en official "the percentage of the stock of the qualified investment entity held by the other qualified investment entity";
}
pub relation stock_treated_as_held_by_us_person_in_proportion_897h4Eiii(qie: us.irc.core::Corporation, other: us.irc.core::Corporation, us_held_percent: Decimal) kind institutional {
    label en official "stock held by another qualified investment entity not described in clause (ii)(I) or (II) is treated as held by a United States person only in proportion to the stock of that entity held by a United States person";
}
@source(IRC_S897_H, relation = formalizes, coverage = exact, quote = "(iii) any stock in the qualified investment entity held by any other qualified investment entity not")
rule S897H4EiiiProportionalUsHolding defeasible {
    for qie: us.irc.core::Corporation;
    for other: us.irc.core::Corporation;
    for held: Decimal;
    for us_percent: Decimal;
    when other_qie_stock_percent_of_qie_897h4Eiii(qie, other, held)
     and other_qie_us_held_percent_897h4Eiii(other, us_percent);
    unless other_qie_class_regularly_traded_897h4EiiI(other)
     and other_qie_stock_percent_of_qie_897h4Eiii(qie, other, held)
     and other_qie_us_held_percent_897h4Eiii(other, us_percent);
    unless other_qie_is_ric_with_redeemable_securities_897h4EiiII(other)
     and other_qie_stock_percent_of_qie_897h4Eiii(qie, other, held)
     and other_qie_us_held_percent_897h4Eiii(other, us_percent);
    then stock_treated_as_held_by_us_person_in_proportion_897h4Eiii(qie, other, held * (us_percent / 100.0));
}

// --- §897(h)(3): distributions by domestically controlled qualified investment entities ----------------------------------

pub relation usrpi_distribution_by_qie_897h3(qie: us.irc.core::Corporation, distribution_id: Text, fair_market_value: Money, adjusted_basis: Money) kind empirical {
    label en official "a distribution by the qualified investment entity of a United States real property interest, its fair market value and the entity's adjusted basis in it";
}
pub relation gain_recognized_on_qie_distribution_897h3(qie: us.irc.core::Corporation, distribution_id: Text, gain: Money) kind institutional {
    label en official "rules similar to subsection (d): the domestically controlled qualified investment entity recognizes gain on the distribution to the extent of the foreign ownership percentage of the gain (fair market value over adjusted basis)";
}
@source(IRC_S897_H, relation = formalizes, coverage = partial, quote = "In the case of a domestically controlled qualified investment entity, rules similar to the rules of")
rule S897H3ForeignOwnershipPercentageOfGain defeasible {
    for qie: us.irc.core::Corporation;
    for distribution_id: Text;
    for fmv: Money;
    for basis: Money;
    for percent: Decimal;
    when domestically_controlled_qualified_investment_entity(qie)
     and usrpi_distribution_by_qie_897h3(qie, distribution_id, fmv, basis)
     and foreign_ownership_percentage_897h4C(qie, percent)
     and fmv > basis;
    then gain_recognized_on_qie_distribution_897h3(qie, distribution_id, round((fmv - basis) * (percent / 100.0), 2, "HALF_UP"));
}

// --- §897(h)(5): wash sale transactions ----------------------------------------------------------------------------------------

pub relation wash_sale_disposition_date_897h5(p: us.irc.core::Person, interest_id: Text, qie: us.irc.core::Corporation, disposed_on: Date) kind empirical {
    label en official "the person disposes of an interest in a domestically controlled qualified investment entity on this date";
}
pub relation distribution_ex_dividend_date_897h5(qie: us.irc.core::Corporation, ex_dividend_on: Date) kind empirical {
    label en official "the ex-dividend date of a distribution which is to be made with respect to the interest, any portion of which would (but for the disposition) have been treated as gain from a United States real property interest under paragraph (1)";
}
pub relation substantially_identical_interest_acquired_897h5(p: us.irc.core::Person, qie: us.irc.core::Corporation, acquired_on: Date) kind empirical {
    label en official "the person acquires, or enters into a contract or option to acquire, a substantially identical interest in the entity on this date";
}
pub relation substantially_identical_interest_acquired_by_related_person_897h5(p: us.irc.core::Person, qie: us.irc.core::Corporation, acquired_on: Date) kind empirical {
    label en official "a person related (section 267(b) or 707(b)(1)) to the person acquires, or has entered into a contract or option to acquire, a substantially identical interest, on this date (treated as an acquisition by the person)";
}
pub relation wash_sale_disposition_in_window_897h5Bi_I(p: us.irc.core::Person, interest_id: Text, qie: us.irc.core::Corporation) kind institutional {
    label en official "the disposition falls within the 30-day period preceding the ex-dividend date";
}
@source(IRC_S897_H, relation = formalizes, coverage = exact, quote = "(I) disposes of an interest in a domestically controlled qualified investment entity during the 30-day period")
rule S897H5BiIDispositionInThirtyDayWindow defeasible {
    for p: us.irc.core::Person;
    for interest_id: Text;
    for qie: us.irc.core::Corporation;
    for disposed_on: Date;
    for ex_on: Date;
    for calendar_before_1: Date;
    when wash_sale_disposition_date_897h5(p, interest_id, qie, disposed_on)
     and distribution_ex_dividend_date_897h5(qie, ex_on)
     and disposed_on >= calendar_before_1
     and disposed_on < ex_on
        and us.irc.core::civil_calendar_boundary_before(ex_on, 30, us.irc.core::CalendarDay, calendar_before_1);
    then wash_sale_disposition_in_window_897h5Bi_I(p, interest_id, qie);
}
pub relation wash_sale_reacquisition_in_window_897h5Bi_II(p: us.irc.core::Person, qie: us.irc.core::Corporation) kind institutional {
    label en official "a substantially identical interest is acquired (or a contract or option to acquire it is entered into) during the 61-day period beginning with the first day of the 30-day period";
}
@source(IRC_S897_H, relation = formalizes, coverage = exact, quote = "(II) acquires, or enters into a contract or option to acquire, a substantially identical interest in such")
rule S897H5BiIIReacquisitionByPerson defeasible {
    for p: us.irc.core::Person;
    for qie: us.irc.core::Corporation;
    for acquired_on: Date;
    for ex_on: Date;
    for calendar_before_1: Date;
    when substantially_identical_interest_acquired_897h5(p, qie, acquired_on)
     and distribution_ex_dividend_date_897h5(qie, ex_on)
     and acquired_on >= calendar_before_1
     and acquired_on <= add_calendar_period(ex_on, 30 calendar_day)
        and us.irc.core::civil_calendar_boundary_before(ex_on, 30, us.irc.core::CalendarDay, calendar_before_1);
    then wash_sale_reacquisition_in_window_897h5Bi_II(p, qie);
}
@source(IRC_S897_H, relation = formalizes, coverage = exact, quote = "For purposes of subclause (II), a nonresident alien individual, foreign corporation, or qualified investment")
rule S897H5BiIIReacquisitionByRelatedPerson defeasible {
    for p: us.irc.core::Person;
    for qie: us.irc.core::Corporation;
    for acquired_on: Date;
    for ex_on: Date;
    for calendar_before_1: Date;
    when substantially_identical_interest_acquired_by_related_person_897h5(p, qie, acquired_on)
     and distribution_ex_dividend_date_897h5(qie, ex_on)
     and acquired_on >= calendar_before_1
     and acquired_on <= add_calendar_period(ex_on, 30 calendar_day)
        and us.irc.core::civil_calendar_boundary_before(ex_on, 30, us.irc.core::CalendarDay, calendar_before_1);
    then wash_sale_reacquisition_in_window_897h5Bi_II(p, qie);
}
pub relation distribution_actually_received_on_either_interest_897h5Biii(p: us.irc.core::Person, interest_id: Text) kind empirical {
    label en official "the person receives the distribution with respect to either the interest disposed of, or the interest acquired, in the transaction";
}
pub relation regularly_traded_us_class_and_not_over_five_percent_897h5Biv(p: us.irc.core::Person, interest_id: Text) kind empirical {
    label en official "the disposition involves a class of stock regularly traded on an established securities market within the United States and the person did not own more than 5 percent of the class at any time during the 1-year period ending on the date of the distribution";
}
pub relation applicable_wash_sales_transaction_897h5Bi(p: us.irc.core::Person, interest_id: Text, qie: us.irc.core::Corporation) kind institutional {
    label en official "an applicable wash sales transaction: a disposition in the 30-day window and a reacquisition in the 61-day window, other than where the distribution is actually received or the interest is a small holding of regularly traded stock";
}
@source(IRC_S897_H, relation = formalizes, coverage = exact, quote = "The term \"applicable wash sales transaction\" means any transaction (or series of transactions) under which a")
rule S897H5BiApplicableWashSale defeasible {
    for p: us.irc.core::Person;
    for interest_id: Text;
    for qie: us.irc.core::Corporation;
    when wash_sale_disposition_in_window_897h5Bi_I(p, interest_id, qie)
     and wash_sale_reacquisition_in_window_897h5Bi_II(p, qie)
     and domestically_controlled_qualified_investment_entity(qie);
    unless distribution_actually_received_on_either_interest_897h5Biii(p, interest_id)
     and wash_sale_disposition_in_window_897h5Bi_I(p, interest_id, qie)
     and wash_sale_reacquisition_in_window_897h5Bi_II(p, qie);
    unless regularly_traded_us_class_and_not_over_five_percent_897h5Biv(p, interest_id)
     and wash_sale_disposition_in_window_897h5Bi_I(p, interest_id, qie)
     and wash_sale_reacquisition_in_window_897h5Bi_II(p, qie);
    then applicable_wash_sales_transaction_897h5Bi(p, interest_id, qie);
}
pub relation distribution_portion_that_would_be_usrpi_gain_897h5A(p: us.irc.core::Person, interest_id: Text, amount: Money) kind empirical {
    label en official "the portion of the distribution with respect to the interest which, but for the disposition, would have been treated by the taxpayer as gain from the sale or exchange of a United States real property interest under paragraph (1)";
}
pub relation wash_sale_usrpi_gain_897h5A(p: us.irc.core::Person, interest_id: Text, amount: Money) kind institutional {
    label en official "the taxpayer is treated as having gain from the sale or exchange of a United States real property interest in an amount equal to that portion of the distribution";
}
@source(IRC_S897_H, relation = formalizes, coverage = exact, quote = "If an interest in a domestically controlled qualified investment entity is disposed of in an applicable wash")
rule S897H5AWashSaleGain defeasible {
    for p: us.irc.core::Person;
    for interest_id: Text;
    for qie: us.irc.core::Corporation;
    for amount: Money;
    when applicable_wash_sales_transaction_897h5Bi(p, interest_id, qie)
     and distribution_portion_that_would_be_usrpi_gain_897h5A(p, interest_id, amount);
    then wash_sale_usrpi_gain_897h5A(p, interest_id, amount);
}
pub relation substitute_dividend_payment_in_lieu_portion_897h5Bii(p: us.irc.core::Person, interest_id: Text, portion_of_distribution_in_lieu: Money) kind empirical {
    label en official "a substitute dividend payment (section 861) or similar payment specified in regulations, and the portion of the distribution it is in lieu of which would have been treated as gain from a United States real property interest but for the transaction";
}
pub relation wash_sale_usrpi_gain_by_substitute_payment_897h5Bii(p: us.irc.core::Person, interest_id: Text, amount: Money) kind institutional {
    label en official "the portion of the substitute payment treated by the taxpayer as gain under subparagraph (A) is the portion of the distribution the payment is in lieu of";
}
@source(IRC_S897_H, relation = formalizes, coverage = exact, quote = "The portion of any such payment treated by the taxpayer as gain from the sale or exchange of a United States")
rule S897H5BiiSubstitutePaymentPortion defeasible {
    for p: us.irc.core::Person;
    for interest_id: Text;
    for qie: us.irc.core::Corporation;
    for portion: Money;
    when applicable_wash_sales_transaction_897h5Bi(p, interest_id, qie)
     and substitute_dividend_payment_in_lieu_portion_897h5Bii(p, interest_id, portion);
    then wash_sale_usrpi_gain_by_substitute_payment_897h5Bii(p, interest_id, portion);
}

// --- §897(k)(2)(B), (k)(4)(A)(ii), (k)(4)(C) ----------------------------------------------------------------------------------

pub relation amounts_realized_by_qualified_shareholder_897k2Bii(qs: us.irc.core::Person, reit: us.irc.core::Corporation, amount: Money) kind empirical {
    label en official "the amounts realized by the qualified shareholder on a disposition of stock of the real estate investment trust, or on a distribution from it attributable to gain from sales or exchanges of a United States real property interest";
}
pub relation amounts_realized_treated_as_usrpi_disposition_897k2Bii(qs: us.irc.core::Person, reit: us.irc.core::Corporation, amount: Money) kind institutional {
    label en official "the applicable percentage of those amounts realized is treated as amounts realized from the disposition of United States real property interests";
}
@source(IRC_S897_K, relation = formalizes, coverage = exact, quote = "(ii) the applicable percentage of the amounts realized by the qualified shareholder with respect to any")
rule S897K2BiiApplicablePercentageOfAmountsRealized defeasible {
    for qs: us.irc.core::Person;
    for reit: us.irc.core::Corporation;
    for amount: Money;
    for percent: Decimal;
    when qualified_shareholder_897k3A(qs)
     and amounts_realized_by_qualified_shareholder_897k2Bii(qs, reit, amount)
     and reit_stock_held_by_shareholder_897k2(qs, reit, percent)
     and percent > 0.0;
    then amounts_realized_treated_as_usrpi_disposition_897k2Bii(qs, reit, round(amount * (percent / 100.0), 2, "HALF_UP"));
}
pub relation partner_other_items_distributive_share_897k4Aii(partner: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the partner's distributive share of items of income or gain for the year that are not treated as gain taken into account under subsection (a)(1) (determined without regard to this paragraph)";
}
pub relation partner_other_items_decreased_897k4Aii(partner: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the partner's distributive share of those other items, decreased (but not below zero) by the excess of the proportionate share over the distributive share of USRPI gain";
}
@source(IRC_S897_K, relation = formalizes, coverage = exact, quote = "(ii) such partner's distributive share of items of income or gain for the taxable year that are not treated")
rule S897K4AiiOtherItemsDecreased defeasible {
    for partner: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for other: Money;
    for excess: Money;
    when partner_other_items_distributive_share_897k4Aii(partner, y, other)
     and usrpi_gain_increase_897k4a(partner, y, excess);
    then partner_other_items_decreased_897k4Aii(partner, y, max(other - excess, 0.00 USD));
}
pub relation investor_share_of_partnership_item_897k4C(partner: us.irc.core::Person, y: us.irc.core::TaxableYear, item_kind: Text, percent: Decimal) kind empirical {
    label en official "the investor's share of a partnership item of income or gain (excluding gain allocated under section 704(c)); where a share may vary while the investor is a partner, the highest share it may receive is entered";
}
pub relation proportionate_share_percentage_897k4C(partner: us.irc.core::Person, y: us.irc.core::TaxableYear, percent: Decimal) kind institutional {
    label en official "the proportionate share percentage: whichever item share results in the largest proportionate share";
}
@source(IRC_S897_K, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, an applicable investor's proportionate share of USRPI gain shall be")
rule S897K4CLargestItemShare defeasible {
    for partner: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for item_kind: Text;
    for percent: Decimal;
    for other_kind: Text;
    for other_percent: Decimal;
    when investor_share_of_partnership_item_897k4C(partner, y, item_kind, percent);
    unless investor_share_of_partnership_item_897k4C(partner, y, other_kind, other_percent)
     and other_percent > percent
     and investor_share_of_partnership_item_897k4C(partner, y, item_kind, percent);
    then proportionate_share_percentage_897k4C(partner, y, percent);
}
pub relation proportionate_share_of_usrpi_gain_897k4C(partner: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the applicable investor's proportionate share of USRPI gain: the USRPI gain times the proportionate share percentage";
}
@source(IRC_S897_K, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, an applicable investor's proportionate share of USRPI gain shall be")
rule S897K4CProportionateShareOfGain defeasible {
    for partner: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for gain: Money;
    for percent: Decimal;
    when usrpi_gain_897k4b(partner, y, gain)
     and proportionate_share_percentage_897k4C(partner, y, percent);
    then proportionate_share_of_usrpi_gain_897k4C(partner, y, round(gain * (percent / 100.0), 2, "HALF_UP"));
}
