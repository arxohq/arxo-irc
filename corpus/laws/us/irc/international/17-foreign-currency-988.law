// §988(a),(c)(1),(e) — foreign currency transactions. Stage 2b (IRC-10
// stage 2b, A13). Modeled: (a)(1)(A) the default ordinary-income/loss
// character of section 988 gain or loss; (a)(1)(B) the capital-character
// election for forward/futures/option contracts, as a `power`; (c)(1)(A)-
// (B) the "section 988 transaction" classification (nonfunctional-currency
// denomination or value reference, over the three described transaction
// types); (e)(1)-(3) the personal-transaction carve-out for individuals,
// with the $200 de minimis exception and the personal-transaction
// definition's own section 162/212 business-expense carve-back.
//
// NOT modeled this stage: (a)(1)(B)'s own identification-timing condition
// (before the close of the day the transaction is entered into) is folded
// into the election fact rather than independently timed; (a)(2) interest
// recharacterization, (a)(3) source rules (residence-based sourcing,
// TECH_GAP — would reuse this package's own residence concepts from module
// 13/03 but is not wired), (a)(3)(C)-(D) related-party loan mark-to-market;
// (b) foreign currency gain/loss definitions (booking-date/payment-date
// exchange-rate mechanics) — TECH_GAP, self-referential to a mark-to-market
// computation this package does not build; (c)(1)(C)-(E) (nonfunctional-
// currency disposition, the mark-to-market exceptions, and the qualified-
// fund special rules) — NOT modeled, substantial additional depth; (c)(2)-
// (5) (booking/payment date, debt instrument definition, delivery rules);
// (d) (regulations).

// --- (c)(1): section 988 transaction ---------------------------------------

use self::{
    IRC_S988_A,
    IRC_S988_C,
    IRC_S988_E,
    excluded_from_988c1Biii,
};

pub relation debt_instrument_acquired_or_issued(item_id: Text) kind empirical {
    label en official "acquisition of a debt instrument, or becoming the obligor under one, for section 988(c)(1)(B)(i)";
}
pub relation expense_or_income_item_accrued_for_later_payment(item_id: Text) kind empirical {
    label en official "an item of expense or gross income accrued (or otherwise taken into account) to be paid or received after the date so accrued, for section 988(c)(1)(B)(ii)";
}
pub relation forward_futures_option_entered_into(item_id: Text) kind empirical {
    label en official "entering into or acquiring a forward contract, futures contract, option, or similar financial instrument, for section 988(c)(1)(B)(iii)";
}
pub relation amount_denominated_in_nonfunctional_currency(item_id: Text) kind empirical {
    label en official "the amount the taxpayer is entitled to receive or required to pay is denominated in a nonfunctional currency, for section 988(c)(1)(A)(i)";
}
pub relation amount_determined_by_reference_to_nonfunctional_currency_value(item_id: Text) kind empirical {
    label en official "the amount is determined by reference to the value of one or more nonfunctional currencies, for section 988(c)(1)(A)(ii)";
}
@source(IRC_S988_C, relation = formalizes, coverage = partial, quote = "The term \"section 988 transaction\" means any transaction described in subparagraph (B) if the amount which the taxpayer is entitled to receive (or is required to pay) by reason of such transaction—\n(i) is denominated in terms of a nonfunctional currency, or\n(ii) is determined by reference to the value of 1 or more nonfunctional currencies")
pub relation section_988_transaction(item_id: Text) kind institutional {
    label en official "the item is a section 988 transaction (section 988(c)(1)): a debt-instrument acquisition/issuance, an accrued expense/income item to be paid or received later, or a forward/futures/option contract, denominated in or valued by reference to a nonfunctional currency";
}
rule S988C1DebtInstrumentTransaction defeasible {
    for item_id: Text;
    when debt_instrument_acquired_or_issued(item_id)
     and (amount_denominated_in_nonfunctional_currency(item_id) or amount_determined_by_reference_to_nonfunctional_currency_value(item_id));
    then section_988_transaction(item_id);
}
rule S988C1AccruedItemTransaction defeasible {
    for item_id: Text;
    when expense_or_income_item_accrued_for_later_payment(item_id)
     and (amount_denominated_in_nonfunctional_currency(item_id) or amount_determined_by_reference_to_nonfunctional_currency_value(item_id));
    then section_988_transaction(item_id);
}
rule S988C1ForwardFuturesOptionTransaction defeasible {
    for item_id: Text;
    when forward_futures_option_entered_into(item_id)
     and (amount_denominated_in_nonfunctional_currency(item_id) or amount_determined_by_reference_to_nonfunctional_currency_value(item_id));
    unless excluded_from_988c1Biii(item_id);
    then section_988_transaction(item_id);
}

// --- (e): application to individuals ----------------------------------------

pub relation section_162_or_212_business_expense_allocable(item_id: Text) kind empirical {
    label en unofficial "expenses properly allocable to the transaction meet the requirements of section 162 (other than travel expenses) or section 212 (other than tax-related expenses), for the section 988(e)(3) carve-back from 'personal transaction'";
}
@source(IRC_S988_E, relation = formalizes, coverage = partial, quote = "the term \"personal transaction\" means any transaction entered into by an individual, except that such term shall not include any transaction to the extent that expenses properly allocable to such transaction meet the requirements of—\n(A) section 162 (other than traveling expenses described in subsection (a)(2) thereof), or\n(B) section 212 (other than that part of section 212 dealing with expenses incurred in connection with taxes)")
pub relation personal_transaction_988e(p: us.irc.core::Individual, item_id: Text) kind institutional {
    label en official "the individual's section 988 transaction is a personal transaction under section 988(e)(3): not to the extent its expenses are allocable business/investment expenses under section 162 or 212";
}
pub relation individual_party_to_988_transaction(p: us.irc.core::Individual, item_id: Text) kind empirical {
    label en unofficial "the individual is a party to the section 988 transaction, for the section 988(e) 'entered into by an individual' domain (a domain-anchor fact, §190)";
}
rule S988E3PersonalTransactionByDefault defeasible {
    for p: us.irc.core::Individual;
    for item_id: Text;
    when individual_party_to_988_transaction(p, item_id)
     and section_988_transaction(item_id)
     and not_known(section_162_or_212_business_expense_allocable(item_id));
    then personal_transaction_988e(p, item_id);
}
pub relation nonfunctional_currency_disposition_gain(p: us.irc.core::Individual, item_id: Text, amount: Money) kind empirical {
    label en unofficial "the gain that would otherwise be recognized by the individual on the disposition of nonfunctional currency in a personal transaction, by reason of exchange-rate changes, for section 988(e)(2)";
}
@source(IRC_S988_E, relation = formalizes, coverage = partial, quote = "no gain shall be recognized for purposes of this subtitle by reason of changes in exchange rates after such currency was acquired by such individual and before such disposition. The preceding sentence shall not apply if the gain which would otherwise be recognized on the transaction exceeds $200.")
pub relation personal_currency_gain_excluded_988e2(p: us.irc.core::Individual, item_id: Text) kind institutional {
    label en official "the section 988(e)(2) $200 de minimis exclusion applies: no gain is recognized on the individual's personal-transaction disposition of nonfunctional currency because the exchange-rate gain does not exceed $200";
}
rule S988E2TwoHundredDollarExclusion defeasible {
    for p: us.irc.core::Individual;
    for item_id: Text;
    for gain: Money;
    when personal_transaction_988e(p, item_id)
     and nonfunctional_currency_disposition_gain(p, item_id, gain)
     and gain <= 200.00 USD;
    then personal_currency_gain_excluded_988e2(p, item_id);
}

// --- (a)(1): character of gain or loss --------------------------------------

pub relation section_988_gain_or_loss(item_id: Text, amount: Money) kind empirical {
    label en unofficial "the foreign currency gain or loss (computed separately) attributable to a section 988 transaction, for section 988(a)(1)";
}
@source(IRC_S988_A, relation = formalizes, coverage = exact, quote = "any foreign currency gain or loss attributable to a section 988 transaction shall be computed separately and treated as ordinary income or loss (as the case may be)")
pub relation section_988_ordinary_character(item_id: Text, amount: Money) kind institutional {
    label en official "the section 988 gain or loss is treated as ordinary income or loss (section 988(a)(1)(A)), unless the taxpayer has made and identified the (a)(1)(B) capital-character election for this transaction";
}
pub relation any_person_elects_capital_character_988a1b(item_id: Text) kind institutional {
    label en unofficial "some taxpayer has made the section 988(a)(1)(B) capital-character election for this transaction — a person-erasing helper so the (a)(1)(A) default rule's `unless` can range-restrict on `item_id` alone";
}
rule S988AnyPersonElectsHelper strict {
    for p: us.irc.core::Person;
    for item_id: Text;
    when elects_capital_character_988a1b(p, item_id);
    then any_person_elects_capital_character_988a1b(item_id);
}
rule S988A1AOrdinaryCharacterDefault defeasible {
    for item_id: Text;
    for amount: Money;
    when section_988_gain_or_loss(item_id, amount)
     and section_988_transaction(item_id);
    unless any_person_elects_capital_character_988a1b(item_id)
     and section_988_gain_or_loss(item_id, amount);
    then section_988_ordinary_character(item_id, amount);
}

// --- (a)(1)(B): capital-character election, as a power ---------------------

pub relation elects_capital_character_988a1b(p: us.irc.core::Person, item_id: Text) kind empirical {
    label en unofficial "the taxpayer elects, and identifies before the close of the day the transaction is entered into, to treat the forward/futures/option contract's foreign currency gain or loss as capital gain or loss under section 988(a)(1)(B) — the transaction must be a capital asset not part of a straddle";
}
pub relation contract_eligible_for_988a1b_election(p: us.irc.core::Person, item_id: Text) kind empirical {
    label en official "the forward contract, futures contract, or option described in section 988(c)(1)(B)(iii) is a capital asset in the taxpayer's hands and is not part of a straddle within the meaning of section 1092(c), for section 988(a)(1)(B)'s eligibility condition";
}
@source(IRC_S988_A, relation = formalizes, coverage = partial, quote = "a taxpayer may elect to treat any foreign currency gain or loss attributable to a forward contract, a futures contract, or option described in subsection (c)(1)(B)(iii) which is a capital asset in the hands of the taxpayer and which is not a part of a straddle (within the meaning of section 1092(c), without regard to paragraph (4) thereof) as capital gain or loss (as the case may be) if the taxpayer makes such election and identifies such transaction before the close of the day on which such transaction is entered into")
pub relation section_988a1b_capital_character(item_id: Text, amount: Money) kind institutional {
    label en official "the foreign currency gain or loss is treated as capital gain or loss under the section 988(a)(1)(B) election";
}
rule S988A1BCapitalCharacterElection defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    when contract_eligible_for_988a1b_election(p, item_id);
    then power S988A1BCapitalCharacterElectionPower {
        holder p;
        over item_id;
        exercise elects_capital_character_988a1b(p, item_id);
        valid_when contract_eligible_for_988a1b_election(p, item_id);
        effect create(section_988a1b_capital_character_effective(p, item_id));
    };
}
pub relation section_988a1b_capital_character_effective(p: us.irc.core::Person, item_id: Text) kind institutional {
    label en official "the section 988(a)(1)(B) capital-character election is in effect for this transaction's foreign currency gain or loss";
}
rule S988A1BEffectSetsCapitalCharacter defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    for amount: Money;
    when section_988a1b_capital_character_effective(p, item_id)
     and section_988_gain_or_loss(item_id, amount);
    then section_988a1b_capital_character(item_id, amount);
}
