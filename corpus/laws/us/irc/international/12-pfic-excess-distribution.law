// §1291(a) — treatment of excess distributions and stock dispositions from
// a PFIC; §1291(c) — the deferred tax amount (the interest charge). Stage 1b
// (IRC-10 stage 1b, A13). The day-by-day RATABLE ALLOCATION of an excess
// distribution across the taxpayer's holding period (a)(1)(A), and the
// per-prior-year rate lookup plus section 6621 interest computation over
// each such year's period ((c)(2)-(3)), are a running ledger over an
// UNBOUNDED prior-year history — the same self-referential-accumulation
// class as TECH-GAPS G1/G10/G38, flagged by the coordinator's own framing
// ("interest charge -> G1-class gap") and NOT modeled this stage (TECH_GAP
// G97). This module models the STRUCTURE section 1291 defines (excess
// distribution as a threshold test, the deferred tax amount as a sum) over
// case-asserted aggregate inputs for the allocation/interest pieces, rather
// than deriving them from a day-by-day ledger.

use self::{
    IRC_S1291_A,
    IRC_S1291_B,
    IRC_S1291_C,
};

pub relation distributions_received_this_year(taxpayer: us.irc.core::Person, pfic: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "distributions in respect of PFIC stock received by the taxpayer during the taxable year, for section 1291(b)(2)(A)(i)";
}
pub relation average_distributions_3_preceding_years(taxpayer: us.irc.core::Person, pfic: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the average amount received in respect of the PFIC stock during the 3 preceding taxable years (or, if shorter, the portion of the holding period before the taxable year), counting only amounts previously included in gross income as an excess distribution — section 1291(b)(2)(A)(ii)";
}
pub relation first_year_of_holding_period(taxpayer: us.irc.core::Person, pfic: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the taxable year is the one in which the taxpayer's holding period in the PFIC stock begins — section 1291(b)(2)(B) makes total excess distributions zero for this year";
}

@source(IRC_S1291_B, relation = formalizes, coverage = partial, quote = "The term \"total excess distribution\" means the excess (if any) of—")
pub relation total_excess_distribution(taxpayer: us.irc.core::Person, pfic: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the section 1291(b)(2) total excess distribution for the year: distributions received this year minus 125% of the 3-preceding-year average, floored at zero, and zero outright for the first year of the holding period (b)(2)(B)";
}
rule S1291B2ATotalExcessDistribution defeasible {
    for taxpayer: us.irc.core::Person;
    for pfic: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for received: Money;
    for average: Money;
    when distributions_received_this_year(taxpayer, pfic, y, received)
     and average_distributions_3_preceding_years(taxpayer, pfic, y, average);
    unless first_year_of_holding_period(taxpayer, pfic, y)
     and distributions_received_this_year(taxpayer, pfic, y, received)
     and average_distributions_3_preceding_years(taxpayer, pfic, y, average);
    then total_excess_distribution(taxpayer, pfic, y, max(0.00 USD, received - (average * 1.25)));
}
rule S1291B2BFirstYearIsZero strict {
    for taxpayer: us.irc.core::Person;
    for pfic: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when first_year_of_holding_period(taxpayer, pfic, y);
    then total_excess_distribution(taxpayer, pfic, y, 0.00 USD);
}

// --- §1291(a): the (a)(1)/(a)(2) trigger and the deferred tax amount ------

pub relation receives_excess_distribution(taxpayer: us.irc.core::Person, pfic: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the taxpayer receives (or is treated as receiving, on a stock disposition under (a)(2)) an excess distribution in respect of PFIC stock this year — the empirical trigger for section 1291(a); the exact amount treated as received under (a)(1)(B) in the CURRENT year (after the day-by-day allocation of (a)(1)(A) sorts out how much of the total excess distribution falls in the current year versus a pre-1987 PFIC year) is a case input, since the ratable-per-day allocation itself is TECH_GAP G97";
}
pub relation aggregate_increases_in_taxes(taxpayer: us.irc.core::Person, pfic: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the section 1291(c)(1)(A)/(c)(2) aggregate increases in tax attributable to the excess distribution/disposition — asserted directly, the per-prior-year highest-rate multiplication over the day-allocated amounts is TECH_GAP G97";
}
pub relation aggregate_interest_on_increases(taxpayer: us.irc.core::Person, pfic: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the section 1291(c)(1)(B)/(c)(3) aggregate section 6621 interest on the increases in tax, from each prior year's due date to the current year's due date — asserted directly, the per-year date-range interest computation is TECH_GAP G97 (the coordinator's own framing: 'interest charge -> G1-class gap')";
}

@source(IRC_S1291_C, relation = formalizes, coverage = partial, quote = "The term \"deferred tax amount\" means, with respect to any distribution or disposition to which subsection (a) applies, an amount equal to the sum of—")
pub relation deferred_tax_amount(taxpayer: us.irc.core::Person, pfic: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the section 1291(c) deferred tax amount: aggregate increases in tax plus aggregate interest on those increases";
}
rule S1291CDeferredTaxAmount strict {
    for taxpayer: us.irc.core::Person;
    for pfic: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for increases: Money;
    for interest: Money;
    when aggregate_increases_in_taxes(taxpayer, pfic, y, increases)
     and aggregate_interest_on_increases(taxpayer, pfic, y, interest);
    then deferred_tax_amount(taxpayer, pfic, y, increases + interest);
}

@source(IRC_S1291_A, relation = formalizes, coverage = partial, quote = "the tax imposed by this chapter for the current year shall be increased by the deferred tax amount (determined under subsection (c))")
pub relation section_1291_tax_increase(taxpayer: us.irc.core::Person, pfic: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the section 1291(a)(1)(C) tax increase for the current year: equal to the deferred tax amount, when the taxpayer receives an excess distribution (or, under (a)(2), disposes of PFIC stock with gain treated the same way)";
}
rule S1291A1CTaxIncreaseFromDistribution strict {
    for taxpayer: us.irc.core::Person;
    for pfic: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when receives_excess_distribution(taxpayer, pfic, y, _)
     and deferred_tax_amount(taxpayer, pfic, y, amount);
    then section_1291_tax_increase(taxpayer, pfic, y, amount);
}
// (a)(2): a disposition's gain is treated the same as an excess
// distribution — modeled as an alternative trigger for the SAME
// `receives_excess_distribution` empirical fact (the case asserts gain on
// disposition through that same relation), so no separate rule is needed
// for the (a)(2) pathway beyond documenting the equivalence here.
