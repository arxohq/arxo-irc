// §911 residual and §912 (stage 2d). Module 05 carries (a), (b)(2)(A), (c), (d)(1) tests
// and the (e) election. Amounts, the indexed exclusion figure and the section 1 and 55
// tax computations are case inputs or the parameter dataset of module 05.

// --- §911(b)(1): foreign earned income items ----------------------------------------------------------------------

use self::{
    IRC_S911_B,
    IRC_S911_D,
    IRC_S911_F,
    IRC_S912,
};

pub relation foreign_source_amount_received_911b1A(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, item_id: Text, amount: Money) kind empirical {
    label en official "an amount received by the individual from sources within a foreign country or countries";
}
pub relation earned_income_attributable_to_services_in_qualifying_period_911b1A(item_id: Text) kind empirical {
    label en official "the amount constitutes earned income attributable to services performed by the individual during the period of bona fide residence or physical presence";
}
pub relation received_as_pension_or_annuity_911b1Bi(item_id: Text) kind empirical {
    label en official "the amount is received as a pension or annuity";
}
pub relation paid_by_united_states_to_its_employee_911b1Bii(item_id: Text) kind empirical {
    label en official "the amount is paid by the United States or an agency to an employee of the United States or an agency";
}
pub relation included_by_reason_of_section_402b_or_403c_911b1Biii(item_id: Text) kind empirical {
    label en official "the amount is included in gross income by reason of section 402(b) or 403(c)";
}
pub relation received_after_close_of_following_taxable_year_911b1Biv(item_id: Text) kind empirical {
    label en official "the amount is received after the close of the taxable year following the taxable year in which the services were performed";
}
pub relation foreign_earned_income_item_911b1(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, item_id: Text, amount: Money) kind institutional {
    label en official "the amount is foreign earned income of the individual (section 911(b)(1)); the total is asserted in foreign_earned_income_amount, not summed from these items";
}
@source(IRC_S911_B, relation = formalizes, coverage = exact, quote = "The term \"foreign earned income\" with respect to any individual means the amount received by such individual from sources within a foreign country or countries which constitute earned income")
rule S911B1AForeignEarnedIncomeItem defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for amount: Money;
    when foreign_source_amount_received_911b1A(p, y, item_id, amount)
     and earned_income_attributable_to_services_in_qualifying_period_911b1A(item_id);
    unless received_as_pension_or_annuity_911b1Bi(item_id)
     and foreign_source_amount_received_911b1A(p, y, item_id, amount);
    unless paid_by_united_states_to_its_employee_911b1Bii(item_id)
     and foreign_source_amount_received_911b1A(p, y, item_id, amount);
    unless included_by_reason_of_section_402b_or_403c_911b1Biii(item_id)
     and foreign_source_amount_received_911b1A(p, y, item_id, amount);
    unless received_after_close_of_following_taxable_year_911b1Biv(item_id)
     and foreign_source_amount_received_911b1A(p, y, item_id, amount);
    then foreign_earned_income_item_911b1(p, y, item_id, amount);
}

// --- §911(d)(2): earned income ---------------------------------------------------------------------------------------------

pub relation compensation_for_personal_services_911d2A(p: us.irc.core::Individual, item_id: Text, amount: Money) kind empirical {
    label en official "wages, salaries, professional fees and other amounts received as compensation for personal services actually rendered";
}
pub relation services_rendered_to_corporation_reasonable_allowance_911d2A(item_id: Text, allowance: Money) kind empirical {
    label en official "the personal services were rendered to a corporation, and the reasonable allowance as compensation for them (the excess represents a distribution of earnings or profits)";
}
pub relation earned_income_amount_911d2A(p: us.irc.core::Individual, item_id: Text, amount: Money) kind institutional {
    label en official "earned income: compensation for personal services actually rendered, not including the part paid to the taxpayer by a corporation that represents a distribution of earnings or profits rather than a reasonable allowance (section 911(d)(2)(A))";
}
@source(IRC_S911_D, relation = formalizes, coverage = exact, quote = "The term \"earned income\" means wages, salaries, or professional fees, and other amounts received as compensation for personal services actually rendered, but does not include that part of the")
rule S911D2AEarnedIncomeFromCorporation defeasible {
    for p: us.irc.core::Individual;
    for item_id: Text;
    for amount: Money;
    for allowance: Money;
    when compensation_for_personal_services_911d2A(p, item_id, amount)
     and services_rendered_to_corporation_reasonable_allowance_911d2A(item_id, allowance);
    then earned_income_amount_911d2A(p, item_id, min(amount, allowance));
}
rule S911D2AEarnedIncomeOtherwise defeasible {
    for p: us.irc.core::Individual;
    for item_id: Text;
    for amount: Money;
    when compensation_for_personal_services_911d2A(p, item_id, amount);
    unless services_rendered_to_corporation_reasonable_allowance_911d2A(item_id, _)
     and compensation_for_personal_services_911d2A(p, item_id, amount);
    then earned_income_amount_911d2A(p, item_id, amount);
}
pub relation business_share_of_net_profits_and_reasonable_allowance_911d2B(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, share_of_net_profits: Money, reasonable_allowance: Money) kind empirical {
    label en official "the taxpayer's share of the net profits of a trade or business in which both personal services and capital are material income-producing factors, and a reasonable allowance as compensation for the personal services rendered";
}
pub relation earned_income_from_business_with_capital_911d2B(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the reasonable allowance as compensation, not in excess of 30 percent of the taxpayer's share of the net profits, is considered earned income (section 911(d)(2)(B))";
}
@source(IRC_S911_D, relation = formalizes, coverage = exact, quote = "In the case of a taxpayer engaged in a trade or business in which both personal services and capital are material income-producing factors, under regulations prescribed by the Secretary, a reasonable")
rule S911D2BThirtyPercentOfNetProfits defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for share: Money;
    for allowance: Money;
    when business_share_of_net_profits_and_reasonable_allowance_911d2B(p, y, share, allowance);
    then earned_income_from_business_with_capital_911d2B(p, y, min(allowance, round(share * 0.30, 2, "HALF_UP")));
}

// --- §911(d)(3)-(5) ---------------------------------------------------------------------------------------------------------

pub relation tax_home_for_162a2_in_foreign_country_911d3(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the individual's home for purposes of section 162(a)(2) is in a foreign country";
}
pub relation abode_within_united_states_911d3(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the individual's abode is within the United States for the period";
}
pub relation serving_in_combat_zone_designated_by_executive_order_911d3(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the individual is serving in an area designated by the President by Executive order as a combat zone for purposes of section 112";
}
pub relation tax_home_in_foreign_country_911d3(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the individual has a tax home in a foreign country: not for a period for which the abode is within the United States, unless serving in a combat zone (section 911(d)(3)); required by module 05's qualified-individual rules";
}
@source(IRC_S911_D, relation = formalizes, coverage = partial, quote = "The term \"tax home\" means, with respect to any individual, such individual's home for purposes of section 162(a)(2) (relating to traveling expenses while away from home). An individual shall not be")
rule S911D3TaxHomeInForeignCountry defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    when tax_home_for_162a2_in_foreign_country_911d3(p, y);
    unless abode_within_united_states_911d3(p, y)
     and tax_home_for_162a2_in_foreign_country_911d3(p, y);
    then tax_home_in_foreign_country_911d3(p, y);
}
rule S911D3CombatZoneKeepsForeignTaxHome defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    when tax_home_for_162a2_in_foreign_country_911d3(p, y)
     and abode_within_united_states_911d3(p, y)
     and serving_in_combat_zone_designated_by_executive_order_911d3(p, y);
    then tax_home_in_foreign_country_911d3(p, y);
}
pub relation left_country_after_1978_08_31_911d4B(p: us.irc.core::Individual, left_on: Date) kind empirical {
    label en official "the individual, a bona fide resident of or present in a foreign country, leaves the country after August 31, 1978";
}
pub relation secretary_determined_adverse_conditions_required_leaving_911d4Bi(p: us.irc.core::Individual) kind empirical {
    label en official "during a period in which the Secretary, after consultation with the Secretary of State, determines that individuals were required to leave because of war, civil unrest or similar adverse conditions precluding the normal conduct of business";
}
pub relation left_before_meeting_paragraph_1_requirements_911d4Bii(p: us.irc.core::Individual) kind empirical {
    label en official "the individual left before meeting the requirements of paragraph (1)";
}
pub relation established_could_reasonably_have_met_requirements_911d4C(p: us.irc.core::Individual) kind empirical {
    label en official "the individual establishes to the Secretary's satisfaction that the requirements could reasonably have been expected to be met but for the conditions";
}
pub relation treated_as_qualified_individual_911d4(p: us.irc.core::Individual) kind institutional {
    label en official "the individual is treated as a qualified individual for the period of bona fide residence or presence in the foreign country, counting only the days within that period (section 911(d)(4))";
}
@source(IRC_S911_D, relation = formalizes, coverage = partial, quote = "shall be treated as a qualified individual with respect to the period described in subparagraph (A) during which he was a bona fide resident of, or was present in, the foreign country, and in")
rule S911D4WarOrCivilUnrestDeparture defeasible {
    for p: us.irc.core::Individual;
    for left_on: Date;
    when left_country_after_1978_08_31_911d4B(p, left_on)
     and left_on > @1978-08-31
     and secretary_determined_adverse_conditions_required_leaving_911d4Bi(p)
     and left_before_meeting_paragraph_1_requirements_911d4Bii(p)
     and established_could_reasonably_have_met_requirements_911d4C(p);
    then treated_as_qualified_individual_911d4(p);
}
pub relation submitted_statement_not_resident_to_foreign_authorities_911d5A(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind empirical {
    label en official "an individual who has earned income from sources within a foreign country submits a statement to that country's authorities that he is not a resident of that country";
}
pub relation held_not_subject_as_resident_to_foreign_income_tax_911d5B(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the individual is held not subject as a resident of that country to its income tax with respect to those earnings";
}
pub relation not_bona_fide_resident_by_statement_911d5(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the individual is not considered a bona fide resident of the country for purposes of paragraph (1)(A) (section 911(d)(5))";
}
@source(IRC_S911_D, relation = formalizes, coverage = exact, quote = "then such individual shall not be considered a bona fide resident of that country for purposes of paragraph (1)(A).")
rule S911D5StatementDeniesBonaFideResidence defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    when submitted_statement_not_resident_to_foreign_authorities_911d5A(p, y)
     and held_not_subject_as_resident_to_foreign_income_tax_911d5B(p, y);
    then not_bona_fide_resident_by_statement_911d5(p, y);
}

// --- §911(d)(6), (7) ---------------------------------------------------------------------------------------------------------

pub relation item_allocable_to_excluded_amount_911d6(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, item_id: Text, allocable_amount: Money) kind empirical {
    label en official "a deduction, exclusion or credit (including the foreign tax credit or deduction) and the part of it properly allocable to or chargeable against amounts excluded under subsection (a)";
}
pub relation disallowed_as_allocable_to_excluded_amount_911d6(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, item_id: Text, amount: Money) kind institutional {
    label en official "no deduction, exclusion or credit is allowed to the extent properly allocable to or chargeable against amounts excluded under subsection (a) (section 911(d)(6))";
}
@source(IRC_S911_D, relation = formalizes, coverage = exact, quote = "No deduction or exclusion from gross income under this subtitle or credit against the tax imposed by this chapter (including any credit or deduction for the amount of taxes paid or accrued to a")
rule S911D6DisallowanceOfDoubleBenefit defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for amount: Money;
    when item_allocable_to_excluded_amount_911d6(p, y, item_id, amount);
    then disallowed_as_allocable_to_excluded_amount_911d6(p, y, item_id, amount);
}
pub relation exclusion_and_deduction_amounts_911d7(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, excluded: Money, deducted: Money, foreign_earned_income: Money) kind empirical {
    label en official "the amount excluded under subsection (a), the amount deducted under subsection (c)(4)(A) and the individual's foreign earned income for the year";
}
pub relation allowed_exclusion_and_deduction_911d7(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the sum of the exclusion and the deduction may not exceed the individual's foreign earned income for the year (section 911(d)(7))";
}
@source(IRC_S911_D, relation = formalizes, coverage = exact, quote = "The sum of the amount excluded under subsection (a) and the amount deducted under subsection (c)(4)(A) for the taxable year shall not exceed the individual's foreign earned income for such year.")
rule S911D7SumNotAboveForeignEarnedIncome defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for excluded: Money;
    for deducted: Money;
    for fei: Money;
    when exclusion_and_deduction_amounts_911d7(p, y, excluded, deducted, fei);
    then allowed_exclusion_and_deduction_911d7(p, y, min(excluded + deducted, fei));
}

// --- §911(d)(8): embargoed countries ---------------------------------------------------------------------------------------

pub relation travel_to_country_subject_to_embargo_regulations_911d8B(p: us.irc.core::Individual, country: Text) kind empirical {
    label en official "travel (or a transaction connected with it) with respect to the foreign country is subject to regulations adopted under the Trading With the Enemy Act or the International Emergency Economic Powers Act that generally prohibit citizens and residents from transactions related to travel to, from or within the country";
}
pub relation activities_not_in_violation_of_embargo_regulations_911d8C(p: us.irc.core::Individual, country: Text) kind empirical {
    label en official "the individual's activities are not in violation of the regulations during the period";
}
pub relation embargo_rule_applies_911d8A(p: us.irc.core::Individual, country: Text) kind institutional {
    label en official "the embargo rule of section 911(d)(8)(A) applies to the individual for the country";
}
@source(IRC_S911_D, relation = formalizes, coverage = exact, quote = "If travel (or any transaction in connection with such travel) with respect to any foreign country is subject to the regulations described in subparagraph (B) during any period—")
rule S911D8AEmbargoRuleApplies defeasible {
    for p: us.irc.core::Individual;
    for country: Text;
    when travel_to_country_subject_to_embargo_regulations_911d8B(p, country);
    unless activities_not_in_violation_of_embargo_regulations_911d8C(p, country)
     and travel_to_country_subject_to_embargo_regulations_911d8B(p, country);
    then embargo_rule_applies_911d8A(p, country);
}
pub relation foreign_income_attributable_to_services_in_embargo_period_911d8Ai(p: us.irc.core::Individual, item_id: Text, country: Text) kind empirical {
    label en official "income from sources within the country attributable to services performed during the period";
}
pub relation income_excluded_from_foreign_earned_income_911d8Ai(p: us.irc.core::Individual, item_id: Text) kind institutional {
    label en official "the income is not foreign earned income (section 911(d)(8)(A)(i))";
}
@source(IRC_S911_D, relation = formalizes, coverage = exact, quote = "(i) the term \"foreign earned income\" shall not include any income from sources within such country attributable to services performed during such period,")
rule S911D8AiIncomeExcluded defeasible {
    for p: us.irc.core::Individual;
    for item_id: Text;
    for country: Text;
    when foreign_income_attributable_to_services_in_embargo_period_911d8Ai(p, item_id, country)
     and embargo_rule_applies_911d8A(p, country);
    then income_excluded_from_foreign_earned_income_911d8Ai(p, item_id);
}
pub relation housing_expense_allocable_to_embargo_period_911d8Aii(p: us.irc.core::Individual, expense_id: Text, country: Text) kind empirical {
    label en official "expenses allocable to the period for housing in the country, or for housing of the spouse or dependents in another country while the taxpayer is present in the country";
}
pub relation housing_expense_excluded_911d8Aii(p: us.irc.core::Individual, expense_id: Text) kind institutional {
    label en official "the expense is not a housing expense (section 911(d)(8)(A)(ii))";
}
@source(IRC_S911_D, relation = formalizes, coverage = exact, quote = "(ii) the term \"housing expenses\" shall not include any expenses allocable to such period for housing in such country or for housing of the spouse or dependents of the taxpayer in another country")
rule S911D8AiiHousingExpenseExcluded defeasible {
    for p: us.irc.core::Individual;
    for expense_id: Text;
    for country: Text;
    when housing_expense_allocable_to_embargo_period_911d8Aii(p, expense_id, country)
     and embargo_rule_applies_911d8A(p, country);
    then housing_expense_excluded_911d8Aii(p, expense_id);
}
pub relation day_present_in_country_during_embargo_period_911d8Aiii(p: us.irc.core::Individual, country: Text, day: Date) kind empirical {
    label en official "a day on which the individual was present in the country during the period";
}
pub relation day_not_counted_for_residence_or_presence_911d8Aiii(p: us.irc.core::Individual, country: Text, day: Date) kind institutional {
    label en official "the day is not counted for bona fide residence or physical presence in the country (section 911(d)(8)(A)(iii))";
}
@source(IRC_S911_D, relation = formalizes, coverage = exact, quote = "(iii) an individual shall not be treated as a bona fide resident of, or as present in, a foreign country for any day during which such individual was present in such country during such period.")
rule S911D8AiiiDayNotCounted defeasible {
    for p: us.irc.core::Individual;
    for country: Text;
    for day: Date;
    when day_present_in_country_during_embargo_period_911d8Aiii(p, country, day)
     and embargo_rule_applies_911d8A(p, country);
    then day_not_counted_for_residence_or_presence_911d8Aiii(p, country, day);
}

// --- §911(f): stacking of tax rates --------------------------------------------------------------------------------------------

pub relation tax_on_income_with_and_without_exclusion_911f1A(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, tax_with_excluded_added: Money, tax_on_excluded_alone: Money) kind empirical {
    label en official "the section 1 tax if taxable income were increased by the excluded amount, and the section 1 tax if taxable income were equal to the excluded amount";
}
pub relation section_1_tax_with_exclusion_911f1A(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, tax: Money) kind institutional {
    label en official "the section 1 tax is the excess (if any) of the tax on taxable income increased by the excluded amount over the tax on the excluded amount alone (section 911(f)(1)(A))";
}
@source(IRC_S911_F, relation = formalizes, coverage = exact, quote = "(A) if such taxpayer has taxable income for such taxable year, the tax imposed by section 1 for such taxable year shall be equal to the excess (if any) of—")
rule S911F1ASection1TaxOnStackedIncome defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for tax_with: Money;
    for tax_alone: Money;
    when tax_on_income_with_and_without_exclusion_911f1A(p, y, tax_with, tax_alone);
    then section_1_tax_with_exclusion_911f1A(p, y, max(tax_with - tax_alone, 0.00 USD));
}
pub relation amount_determined_under_55b1A_with_and_without_exclusion_911f1B(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount_with_excluded_added: Money, amount_on_excluded_alone: Money) kind empirical {
    label en official "the first-sentence amount of section 55(b)(1)(A) if the taxable excess were increased by the excluded amount (subject to section 55(b)(3)), and if it were equal to the excluded amount";
}
pub relation section_55_amount_with_exclusion_911f1B(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the section 55(b)(1)(A) amount is the excess (if any) of the amount on the taxable excess increased by the excluded amount over the amount on the excluded amount alone (section 911(f)(1)(B))";
}
@source(IRC_S911_F, relation = formalizes, coverage = exact, quote = "(B) if such taxpayer has a taxable excess (as defined in section 55(b)(1)(B)) for such taxable year, the amount determined under the first sentence of section 55(b)(1)(A) for such taxable year shall")
rule S911F1BSection55AmountOnStackedIncome defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for amount_with: Money;
    for amount_alone: Money;
    when amount_determined_under_55b1A_with_and_without_exclusion_911f1B(p, y, amount_with, amount_alone);
    then section_55_amount_with_exclusion_911f1B(p, y, max(amount_with - amount_alone, 0.00 USD));
}
pub relation excluded_and_disallowed_amounts_911f1(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, excluded: Money, disallowed_under_d6: Money) kind empirical {
    label en official "the amount excluded under subsection (a) and the aggregate of deductions or exclusions disallowed under subsection (d)(6) with respect to it";
}
pub relation excluded_amount_for_stacking_911f1(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "for paragraph (1) the amount excluded under subsection (a) is reduced by the deductions or exclusions disallowed under subsection (d)(6) (section 911(f)(1), last sentence)";
}
@source(IRC_S911_F, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the amount excluded under subsection (a) shall be reduced by the aggregate amount of any deductions or exclusions disallowed under subsection (d)(6) with respect to")
rule S911F1ExcludedAmountReducedByDisallowed defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for excluded: Money;
    for disallowed: Money;
    when excluded_and_disallowed_amounts_911f1(p, y, excluded, disallowed);
    then excluded_amount_for_stacking_911f1(p, y, excluded - disallowed);
}
pub relation net_capital_gain_taxable_income_and_qualified_dividends_911f2A(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, net_capital_gain: Money, taxable_income: Money, qualified_dividend_income: Money) kind empirical {
    label en official "the net capital gain (determined without regard to section 1(h)(11)), the taxable income (without regard to subsection (f)) and the qualified dividend income";
}
pub relation capital_gain_excess_911f2A(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, excess: Money) kind institutional {
    label en official "the capital gain excess: the excess of the net capital gain over taxable income, without regard to this subsection (section 911(f)(2)(A))";
}
@source(IRC_S911_F, relation = formalizes, coverage = exact, quote = "In applying section 1(h) for purposes of determining the tax under paragraph (1)(A)(i) for any taxable year in which, without regard to this subsection, the taxpayer's net capital gain exceeds")
rule S911F2ACapitalGainExcess defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for ncg: Money;
    for ti: Money;
    for qdi: Money;
    when net_capital_gain_taxable_income_and_qualified_dividends_911f2A(p, y, ncg, ti, qdi)
     and ncg > ti;
    then capital_gain_excess_911f2A(p, y, ncg - ti);
}
pub relation net_capital_gain_reduced_by_excess_911f2Ai(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the net capital gain is reduced (but not below zero) by the capital gain excess (section 911(f)(2)(A)(i))";
}
@source(IRC_S911_F, relation = formalizes, coverage = exact, quote = "(i) the taxpayer's net capital gain (determined without regard to section 1(h)(11)) shall be reduced (but not below zero) by such capital gain excess,")
rule S911F2AiNetCapitalGainReduced defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for ncg: Money;
    for ti: Money;
    for qdi: Money;
    for excess: Money;
    when net_capital_gain_taxable_income_and_qualified_dividends_911f2A(p, y, ncg, ti, qdi)
     and capital_gain_excess_911f2A(p, y, excess);
    then net_capital_gain_reduced_by_excess_911f2Ai(p, y, max(ncg - excess, 0.00 USD));
}
pub relation qualified_dividend_income_reduced_911f2Aii(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the qualified dividend income is reduced by so much of the capital gain excess as exceeds the net capital gain (section 911(f)(2)(A)(ii))";
}
@source(IRC_S911_F, relation = formalizes, coverage = exact, quote = "(ii) the taxpayer's qualified dividend income shall be reduced by so much of such capital gain excess as exceeds the taxpayer's net capital gain (determined without regard to section 1(h)(11) and the")
rule S911F2AiiQualifiedDividendsReduced defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for ncg: Money;
    for ti: Money;
    for qdi: Money;
    for excess: Money;
    when net_capital_gain_taxable_income_and_qualified_dividends_911f2A(p, y, ncg, ti, qdi)
     and capital_gain_excess_911f2A(p, y, excess)
     and excess > ncg;
    then qualified_dividend_income_reduced_911f2Aii(p, y, max(qdi - (excess - ncg), 0.00 USD));
}

// --- §912: exclusions of allowances -------------------------------------------------------------------------------------------------

pub relation civilian_employee_allowance_under_listed_act_912_1(p: us.irc.core::Individual, item_id: Text) kind empirical {
    label en official "amounts received by a civilian officer or employee of the Government of the United States as allowances or otherwise under chapter 9 of title I of the Foreign Service Act of 1980, section 4 of the Central Intelligence Agency Act of 1949, title II of the Overseas Differentials and Allowances Act, or subsection (e) or (f) of the first section of the Administrative Expenses Act of 1946 or section 22 of that Act";
}
pub relation amount_is_post_differential_912_1(item_id: Text) kind empirical {
    label en official "the amount is a post differential";
}
pub relation cost_of_living_allowance_912_2(p: us.irc.core::Individual, item_id: Text) kind empirical {
    label en official "a cost-of-living allowance received in accordance with regulations approved by the President (or similar rules for judicial employees) by a civilian officer or employee of the Government of the United States";
}
pub relation stationed_outside_continental_us_other_than_alaska_912_2(p: us.irc.core::Individual) kind empirical {
    label en official "the officer or employee is stationed outside the continental United States (other than Alaska)";
}
pub relation received_under_title_II_overseas_differentials_912_2(item_id: Text) kind empirical {
    label en official "the amount is received under title II of the Overseas Differentials and Allowances Act";
}
pub relation peace_corps_allowance_912_3(p: us.irc.core::Individual, item_id: Text) kind empirical {
    label en official "amounts received by a volunteer or volunteer leader within the meaning of the Peace Corps Act, or a member of the family, as allowances under section 5 or 6 of the Peace Corps Act";
}
pub relation peace_corps_termination_payment_912_3A(item_id: Text) kind empirical {
    label en official "the amount is a termination payment under section 5(c) or 6(1) of the Peace Corps Act";
}
pub relation peace_corps_leave_allowance_912_3B(item_id: Text) kind empirical {
    label en official "the amount is a leave allowance";
}
pub relation peace_corps_family_allowance_of_volunteer_leader_training_in_us_912_3C(item_id: Text) kind empirical {
    label en official "the amount is an allowance to members of the family of a volunteer leader training in the United States";
}
pub relation peace_corps_basic_compensation_portion_912_3D(item_id: Text) kind empirical {
    label en official "the amount is the portion of living allowances the President determines to constitute basic compensation";
}
pub relation exempt_from_gross_income_912(p: us.irc.core::Individual, item_id: Text) kind institutional {
    label en official "the amount is not included in gross income and is exempt from taxation under this subtitle (section 912)";
}
@source(IRC_S912, relation = formalizes, coverage = exact, quote = "In the case of civilian officers and employees of the Government of the United States, amounts received as allowances or otherwise (but not amounts received as post differentials) under—")
rule S9121ForeignAreaAllowancesExempt defeasible {
    for p: us.irc.core::Individual;
    for item_id: Text;
    when civilian_employee_allowance_under_listed_act_912_1(p, item_id);
    unless amount_is_post_differential_912_1(item_id)
     and civilian_employee_allowance_under_listed_act_912_1(p, item_id);
    then exempt_from_gross_income_912(p, item_id);
}
@source(IRC_S912, relation = formalizes, coverage = exact, quote = "In the case of civilian officers or employees of the Government of the United States stationed outside the continental United States (other than Alaska), amounts (other than amounts received under")
rule S9122CostOfLivingAllowanceExempt defeasible {
    for p: us.irc.core::Individual;
    for item_id: Text;
    when cost_of_living_allowance_912_2(p, item_id)
     and stationed_outside_continental_us_other_than_alaska_912_2(p);
    unless received_under_title_II_overseas_differentials_912_2(item_id)
     and cost_of_living_allowance_912_2(p, item_id);
    then exempt_from_gross_income_912(p, item_id);
}
@source(IRC_S912, relation = formalizes, coverage = exact, quote = "In the case of an individual who is a volunteer or volunteer leader within the meaning of the Peace Corps Act and members of his family, amounts received as allowances under section 5 or 6 of the")
rule S9123PeaceCorpsAllowancesExempt defeasible {
    for p: us.irc.core::Individual;
    for item_id: Text;
    when peace_corps_allowance_912_3(p, item_id);
    unless peace_corps_termination_payment_912_3A(item_id)
     and peace_corps_allowance_912_3(p, item_id);
    unless peace_corps_leave_allowance_912_3B(item_id)
     and peace_corps_allowance_912_3(p, item_id);
    unless peace_corps_family_allowance_of_volunteer_leader_training_in_us_912_3C(item_id)
     and peace_corps_allowance_912_3(p, item_id);
    unless peace_corps_basic_compensation_portion_912_3D(item_id)
     and peace_corps_allowance_912_3(p, item_id);
    then exempt_from_gross_income_912(p, item_id);
}
