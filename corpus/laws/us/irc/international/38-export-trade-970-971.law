// §§970-971 (stage 2d): export trade corporations. Subsection 970(b) was repealed by
// Pub. L. 115-97 section 14212(b)(5); the pinned text of subsection (a) and section 971 is
// modeled as printed. The regime is largely obsolete after 2017 (the export trade income
// reduction of subpart F income), but the text stays in the pinned edition.

// --- §971(a): export trade corporation -----------------------------------------------------------------------------------

use self::{
    IRC_S970_A,
    IRC_S970_C,
    IRC_S971_A,
    IRC_S971_B,
    IRC_S971_C,
    IRC_S971_D,
    IRC_S971_E,
    IRC_S971_F,
};

pub relation controlled_foreign_corporation_971a(corp: us.irc.core::Corporation) kind empirical {
    label en official "the corporation is a controlled foreign corporation (section 957)";
}
pub relation three_year_gross_income_shares_971a(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, foreign_source_percentage: Decimal, export_trade_income_percentage: Decimal, agricultural_export_trade_income_percentage: Decimal) kind empirical {
    label en official "for the 3-year period immediately preceding the close of the taxable year: the percentage of gross income derived from sources without the United States, the percentage in respect of which the corporation derived export trade income, and the percentage in respect of which it derived export trade income in respect of agricultural products grown in the United States";
}
pub relation not_qualified_for_any_year_before_1971_11_01_971a3(corp: us.irc.core::Corporation) kind empirical {
    label en official "the corporation did not qualify as an export trade corporation for any taxable year beginning before November 1, 1971";
}
pub relation failed_to_qualify_three_consecutive_years_971a3(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the corporation failed to qualify for a period of 3 consecutive taxable years beginning after October 31, 1971, ending before the taxable year";
}
pub relation meets_gross_income_conditions_971a(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the gross income conditions of subsection (a)(1) (90 percent foreign source and 75 percent export trade income) or the agricultural alternative of subsection (a)(2) (50 percent) are met";
}
@source(IRC_S971_A, relation = formalizes, coverage = exact, quote = "(B) 75 percent or more of the gross income of such corporation for such period constituted gross income in respect of which such corporation derived export trade income.")
rule S971A1GrossIncomeConditions defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for foreign: Decimal;
    for export: Decimal;
    for agricultural: Decimal;
    when controlled_foreign_corporation_971a(corp)
     and three_year_gross_income_shares_971a(corp, y, foreign, export, agricultural)
     and foreign >= 90.0
     and export >= 75.0;
    then meets_gross_income_conditions_971a(corp, y);
}
@source(IRC_S971_A, relation = formalizes, coverage = exact, quote = "If 50 percent or more of the gross income of a controlled foreign corporation in the period specified in subsection (a)(1)(A) is gross income in respect of which such corporation derived export trade")
rule S971A2AgriculturalAlternative defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for foreign: Decimal;
    for export: Decimal;
    for agricultural: Decimal;
    when controlled_foreign_corporation_971a(corp)
     and three_year_gross_income_shares_971a(corp, y, foreign, export, agricultural)
     and foreign >= 90.0
     and agricultural >= 50.0;
    then meets_gross_income_conditions_971a(corp, y);
}
pub relation export_trade_corporation_971a(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "an export trade corporation for the year (section 971(a)), subject to the qualification-history limits of paragraph (3)";
}
@source(IRC_S971_A, relation = formalizes, coverage = exact, quote = "No controlled foreign corporation may qualify as an export trade corporation for any taxable year beginning after October 31, 1971, unless it qualified as an export trade corporation for any taxable")
rule S971AExportTradeCorporation defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for d: Date;
    when meets_gross_income_conditions_971a(corp, y)
     and us.irc.core::begins(y, d);
    unless not_qualified_for_any_year_before_1971_11_01_971a3(corp)
     and us.irc.core::begins(y, d)
     and d > @1971-10-31
     and meets_gross_income_conditions_971a(corp, y);
    unless failed_to_qualify_three_consecutive_years_971a3(corp, y)
     and meets_gross_income_conditions_971a(corp, y);
    then export_trade_corporation_971a(corp, y);
}

// --- §971(b)-(f): definitions ---------------------------------------------------------------------------------------------------

pub relation net_income_item_971b(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text, amount: Money, kind: Text) kind empirical {
    label en official "net income of the kind: `export_sale_or_services` (sale to an unrelated person for use outside the United States of export property, or services in respect of such sales or installation or maintenance), `intangible_services` (services in connection with the use by an unrelated person outside the United States of intangible property owned by the manufacturer, producer, grower or extractor of export property), `export_property_use` (rentals or compensation attributable to the use of export property by an unrelated person, or in technical services) or `export_trade_asset_interest` (interest from export trade assets described in subsection (c)(4))";
}
pub relation export_trade_income_item_971b(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text, amount: Money) kind institutional {
    label en official "the item is export trade income (section 971(b))";
}
@source(IRC_S971_B, relation = formalizes, coverage = partial, quote = "(1) the sale to an unrelated person for use, consumption, or disposition outside the United States of export property (as defined in subsection (e)), or from commissions, fees, compensation, or other")
rule S971B1ExportSaleOrServices defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for amount: Money;
    when net_income_item_971b(corp, y, item_id, amount, "export_sale_or_services");
    then export_trade_income_item_971b(corp, y, item_id, amount);
}
@source(IRC_S971_B, relation = formalizes, coverage = partial, quote = "(2) commissions, fees, compensation, or other income from commercial, industrial, financial, technical, scientific, managerial, engineering, architectural, skilled, or other services performed in")
rule S971B2IntangibleServices defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for amount: Money;
    when net_income_item_971b(corp, y, item_id, amount, "intangible_services");
    then export_trade_income_item_971b(corp, y, item_id, amount);
}
@source(IRC_S971_B, relation = formalizes, coverage = exact, quote = "(3) commissions, fees, rentals, or other compensation or income attributable to the use of export property by an unrelated person or attributable to the use of export property in the rendition of")
rule S971B3ExportPropertyUse defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for amount: Money;
    when net_income_item_971b(corp, y, item_id, amount, "export_property_use");
    then export_trade_income_item_971b(corp, y, item_id, amount);
}
@source(IRC_S971_B, relation = formalizes, coverage = exact, quote = "(4) interest from export trade assets described in subsection (c)(4).")
rule S971B4InterestOnExportTradeAssets defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for amount: Money;
    when net_income_item_971b(corp, y, item_id, amount, "export_trade_asset_interest");
    then export_trade_income_item_971b(corp, y, item_id, amount);
}
pub relation asset_kind_971c(asset_id: Text, kind: Text) kind empirical {
    label en official "the asset is: `working_capital` (reasonably necessary for the production of export trade income), `inventory` (of export property held for use outside the United States), `facility` (located outside the United States for storage, handling, transportation, packaging or servicing of export property) or `indebtedness` (evidence of indebtedness of unrelated persons in connection with payment for export purchases or described services)";
}
pub relation export_trade_asset_971c(asset_id: Text) kind institutional {
    label en official "an export trade asset (section 971(c))";
}
@source(IRC_S971_C, relation = formalizes, coverage = exact, quote = "(1) working capital reasonably necessary for the production of export trade income,")
rule S971C1WorkingCapital defeasible {
    for asset_id: Text;
    when asset_kind_971c(asset_id, "working_capital");
    then export_trade_asset_971c(asset_id);
}
@source(IRC_S971_C, relation = formalizes, coverage = exact, quote = "(2) inventory of export property held for use, consumption, or disposition outside the United States,")
rule S971C2Inventory defeasible {
    for asset_id: Text;
    when asset_kind_971c(asset_id, "inventory");
    then export_trade_asset_971c(asset_id);
}
@source(IRC_S971_C, relation = formalizes, coverage = exact, quote = "(3) facilities located outside the United States for the storage, handling, transportation, packaging, or servicing of export property, and")
rule S971C3Facilities defeasible {
    for asset_id: Text;
    when asset_kind_971c(asset_id, "facility");
    then export_trade_asset_971c(asset_id);
}
@source(IRC_S971_C, relation = formalizes, coverage = exact, quote = "(4) evidences of indebtedness executed by persons, other than related persons, in connection with payment for purchases of export property for use, consumption, or disposition outside the United")
rule S971C4Indebtedness defeasible {
    for asset_id: Text;
    when asset_kind_971c(asset_id, "indebtedness");
    then export_trade_asset_971c(asset_id);
}
pub relation expense_paid_in_production_of_export_trade_income_971d(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, expense_id: Text, amount: Money, category: Text, incurred_within_us: Boolean) kind empirical {
    label en official "an expense paid or incurred in the receipt or production of export trade income, its category (`compensation`, `rentals`, `depreciation` or `other`) and whether it is incurred within the United States";
}
pub relation category_percentage_incurred_outside_us_971d(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, category: Text, percentage: Decimal) kind empirical {
    label en official "the percentage of the expenses of the category that is incurred outside the United States";
}
pub relation export_promotion_expense_971d(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, expense_id: Text, amount: Money) kind institutional {
    label en official "an export promotion expense (section 971(d)): compensation, rentals, depreciation or other ordinary and necessary expenses allocable to export trade income; an expense incurred within the United States counts only if at least 90 percent of each category is incurred outside the United States";
}
@source(IRC_S971_D, relation = formalizes, coverage = exact, quote = "For purposes of this subpart, the term \"export promotion expenses\" means the following expenses paid or incurred in the receipt or production of export trade income—")
rule S971DExpenseIncurredOutsideUs defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for expense_id: Text;
    for amount: Money;
    for category: Text;
    when expense_paid_in_production_of_export_trade_income_971d(corp, y, expense_id, amount, category, false);
    then export_promotion_expense_971d(corp, y, expense_id, amount);
}
@source(IRC_S971_D, relation = formalizes, coverage = exact, quote = "No expense incurred within the United States shall be treated as an export promotion expense within the meaning of the preceding sentence, unless at least 90 percent of each category of expenses")
rule S971DExpenseIncurredInUsWithNinetyPercentOutside defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for expense_id: Text;
    for amount: Money;
    for category: Text;
    for pct: Decimal;
    when expense_paid_in_production_of_export_trade_income_971d(corp, y, expense_id, amount, category, true)
     and category_percentage_incurred_outside_us_971d(corp, y, category, pct)
     and pct >= 90.0;
    then export_promotion_expense_971d(corp, y, expense_id, amount);
}
pub relation property_manufactured_produced_grown_or_extracted_in_us_971e(property_id: Text) kind empirical {
    label en official "the property or interest in property was manufactured, produced, grown or extracted in the United States";
}
pub relation export_property_971e(property_id: Text) kind institutional {
    label en official "export property (section 971(e))";
}
@source(IRC_S971_E, relation = formalizes, coverage = exact, quote = "For purposes of this subpart, the term \"export property\" means any property or any interest in property manufactured, produced, grown, or extracted in the United States.")
rule S971EExportProperty defeasible {
    for property_id: Text;
    when property_manufactured_produced_grown_or_extracted_in_us_971e(property_id);
    then export_property_971e(property_id);
}
pub relation related_person_954d3_971f(person_id: Text) kind empirical {
    label en official "the person is a related person as defined in section 954(d)(3)";
}
pub relation person_971f(person_id: Text) kind empirical {
    label en unofficial "a person (a domain anchor for section 971(f))";
}
pub relation unrelated_person_971f(person_id: Text) kind institutional {
    label en official "an unrelated person: a person other than a related person (section 971(f))";
}
@source(IRC_S971_F, relation = formalizes, coverage = exact, quote = "For purposes of this subpart, the term \"unrelated person\" means a person other than a related person as defined in section 954(d)(3).")
rule S971FUnrelatedPerson defeasible {
    for person_id: Text;
    when person_971f(person_id);
    unless related_person_954d3_971f(person_id)
     and person_971f(person_id);
    then unrelated_person_971f(person_id);
}

// --- §970(a), (c) ----------------------------------------------------------------------------------------------------------------------

pub relation export_trade_amounts_970a1(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, subpart_f_income: Money, export_trade_income_that_is_foreign_base_company_income: Money, export_promotion_expenses_allocable: Money, gross_receipts_allocable_base: Money) kind empirical {
    label en official "the subpart F income of the corporation, the export trade income which is foreign base company income, the export promotion expenses properly allocable to that income and the gross receipts (or gross amount of commissions or fees) allocable to it";
}
pub relation increase_in_investments_and_export_trade_income_shares_970a2(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, increase_in_investments: Money, foreign_base_company_export_trade_income: Money, entire_export_trade_income: Money) kind empirical {
    label en official "the increase in investments in export trade assets, the export trade income which is foreign base company income, and the entire export trade income";
}
pub relation export_trade_income_reduction_970a(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, reduction: Money) kind institutional {
    label en official "the reduction of subpart F income by export trade income that is foreign base company income, limited by the export promotion expense or gross receipts alternative and by the investment limit of paragraph (2) (section 970(a)); the two alternatives of paragraph (1)(A) and (B) are read as the greater of the two (the pinned edition prints `or`)";
}
@source(IRC_S970_A, relation = formalizes, coverage = partial, quote = "In the case of a controlled foreign corporation (as defined in section 957) which for the taxable year is an export trade corporation, the subpart F income (determined without regard to this subpart)")
rule S970AExportTradeIncomeReduction defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for sfi: Money;
    for eti_fbci: Money;
    for expenses: Money;
    for receipts: Money;
    for increase: Money;
    for fbci_eti: Money;
    for entire_eti: Money;
    when export_trade_corporation_971a(corp, y)
     and export_trade_amounts_970a1(corp, y, sfi, eti_fbci, expenses, receipts)
     and increase_in_investments_and_export_trade_income_shares_970a2(corp, y, increase, fbci_eti, entire_eti)
     and entire_eti > 0.00 USD;
    then export_trade_income_reduction_970a(corp, y, min(min(eti_fbci, max(round(expenses * 1.5, 2, "HALF_UP"), round(receipts * 0.10, 2, "HALF_UP"))), round(increase * (fbci_eti / entire_eti), 2, "HALF_UP")));
}
pub relation export_trade_asset_amounts_970c1(asset_id: Text, adjusted_basis: Money, liabilities: Money) kind empirical {
    label en official "the adjusted basis of an export trade asset and any liability to which the asset is subject";
}
pub relation export_trade_asset_amount_970c1(asset_id: Text, amount: Money) kind institutional {
    label en official "the amount taken into account with respect to an export trade asset is its adjusted basis reduced by any liability to which it is subject (section 970(c)(1))";
}
@source(IRC_S970_C, relation = formalizes, coverage = exact, quote = "For purposes of this section, the amount taken into account with respect to any export trade asset shall be its adjusted basis, reduced by any liability to which the asset is subject.")
rule S970C1AssetAmount defeasible {
    for asset_id: Text;
    for basis: Money;
    for liabilities: Money;
    when export_trade_asset_amounts_970c1(asset_id, basis, liabilities);
    then export_trade_asset_amount_970c1(asset_id, basis - liabilities);
}
pub relation investments_in_export_trade_assets_970c2(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, at_close_of_year: Money, at_close_of_preceding_year: Money) kind empirical {
    label en official "the amount of investments in export trade assets at the close of the taxable year and at the close of the preceding taxable year";
}
pub relation increase_in_investments_in_export_trade_assets_970c2(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, increase: Money) kind institutional {
    label en official "the amount by which the investments at the close of the year exceed those at the close of the preceding year (section 970(c)(2))";
}
@source(IRC_S970_C, relation = formalizes, coverage = exact, quote = "For purposes of subsection (a), the amount of increase in investments in export trade assets of any controlled foreign corporation for any taxable year is the amount by which—")
rule S970C2IncreaseInInvestments defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for current: Money;
    for prior: Money;
    when investments_in_export_trade_assets_970c2(corp, y, current, prior)
     and current > prior;
    then increase_in_investments_in_export_trade_assets_970c2(corp, y, current - prior);
}
