// §§991-994 (stage 2d): domestic international sales corporations (DISC). The DISC regime
// is largely historical (repealed for taxable years after 2000 for most purposes but the
// interest-charge DISC of section 995(f) survives); the pinned text is modeled as printed.
// Percentages are percent numbers (95.0 = 95 percent); amounts are case inputs.

// --- §992(a): DISC ---------------------------------------------------------------------------------------------------------------------

use self::{
    IRC_S991,
    IRC_S992_A,
    IRC_S992_B,
    IRC_S992_C,
    IRC_S992_D,
    IRC_S993_A,
    IRC_S993_B,
    IRC_S993_C,
    IRC_S993_D,
    IRC_S993_E,
    IRC_S994_A,
    President,
    depletable_product_excluded_993c2C,
};

pub relation incorporated_under_state_law_992a1(corp: us.irc.core::Corporation) kind empirical {
    label en official "the corporation is incorporated under the laws of a State";
}
pub relation qualified_export_receipts_percentage_992a1A(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, percentage: Decimal) kind empirical {
    label en official "the percentage of the gross receipts (section 993(f)) of the corporation that consists of qualified export receipts (section 993(a))";
}
pub relation qualified_export_assets_basis_percentage_992a1B(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, percentage: Decimal) kind empirical {
    label en official "the adjusted basis of qualified export assets at the close of the year as a percentage of the adjusted basis of all assets";
}
pub relation stock_classes_and_minimum_par_992a1C(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, classes: Integer, minimum_par_or_stated_value: Money) kind empirical {
    label en official "the number of classes of stock and the lowest par or stated value of the outstanding stock on any day of the taxable year";
}
pub relation disc_election_in_effect_992a1D(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the corporation has made an election under subsection (b) to be treated as a DISC and the election is in effect for the year";
}
pub relation corporation_ineligible_kind_992d(corp: us.irc.core::Corporation, kind: Text) kind empirical {
    label en official "the corporation is: `tax_exempt_501`, `personal_holding_company`, `financial_institution_581`, `insurance_company_subchapter_l`, `regulated_investment_company` or `s_corporation`";
}
pub relation disc_ineligible_992d(corp: us.irc.core::Corporation) kind institutional {
    label en official "the corporation is not eligible to be treated as a DISC (section 992(d))";
}
@source(IRC_S992_D, relation = formalizes, coverage = exact, quote = "(1) a corporation exempt from tax by reason of section 501,")
rule S992D1TaxExemptIneligible defeasible {
    for corp: us.irc.core::Corporation;
    when corporation_ineligible_kind_992d(corp, "tax_exempt_501");
    then disc_ineligible_992d(corp);
}
@source(IRC_S992_D, relation = formalizes, coverage = exact, quote = "(2) a personal holding company (as defined in section 542),")
rule S992D2PersonalHoldingCompanyIneligible defeasible {
    for corp: us.irc.core::Corporation;
    when corporation_ineligible_kind_992d(corp, "personal_holding_company");
    then disc_ineligible_992d(corp);
}
@source(IRC_S992_D, relation = formalizes, coverage = exact, quote = "(3) a financial institution to which section 581 applies,")
rule S992D3FinancialInstitutionIneligible defeasible {
    for corp: us.irc.core::Corporation;
    when corporation_ineligible_kind_992d(corp, "financial_institution_581");
    then disc_ineligible_992d(corp);
}
@source(IRC_S992_D, relation = formalizes, coverage = exact, quote = "(4) an insurance company subject to the tax imposed by subchapter L,")
rule S992D4InsuranceCompanyIneligible defeasible {
    for corp: us.irc.core::Corporation;
    when corporation_ineligible_kind_992d(corp, "insurance_company_subchapter_l");
    then disc_ineligible_992d(corp);
}
@source(IRC_S992_D, relation = formalizes, coverage = exact, quote = "(5) a regulated investment company (as defined in section 851(a)), or")
rule S992D5RegulatedInvestmentCompanyIneligible defeasible {
    for corp: us.irc.core::Corporation;
    when corporation_ineligible_kind_992d(corp, "regulated_investment_company");
    then disc_ineligible_992d(corp);
}
@source(IRC_S992_D, relation = formalizes, coverage = exact, quote = "(6) an S corporation.")
rule S992D6SCorporationIneligible defeasible {
    for corp: us.irc.core::Corporation;
    when corporation_ineligible_kind_992d(corp, "s_corporation");
    then disc_ineligible_992d(corp);
}
pub relation disc_992a1(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "a DISC for the taxable year (section 992(a)(1)), not an ineligible corporation (subsection (d))";
}
@source(IRC_S992_A, relation = formalizes, coverage = exact, quote = "For purposes of this title, the term \"DISC\" means, with respect to any taxable year, a corporation which is incorporated under the laws of any State and satisfies the following conditions for the")
rule S992A1Disc defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for receipts: Decimal;
    for assets: Decimal;
    for classes: Integer;
    for par: Money;
    when incorporated_under_state_law_992a1(corp)
     and qualified_export_receipts_percentage_992a1A(corp, y, receipts)
     and receipts >= 95.0
     and qualified_export_assets_basis_percentage_992a1B(corp, y, assets)
     and assets >= 95.0
     and stock_classes_and_minimum_par_992a1C(corp, y, classes, par)
     and classes <= 1
     and par >= 2500.00 USD
     and disc_election_in_effect_992a1D(corp, y);
    unless disc_ineligible_992d(corp)
     and disc_election_in_effect_992a1D(corp, y);
    then disc_992a1(corp, y);
}
pub relation not_disc_for_year_had_undistributed_income_at_start_992a3(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the corporation is not a DISC for the year but was a DISC in a preceding taxable year and at the beginning of the year has undistributed previously taxed income or accumulated DISC income";
}
pub relation former_disc_992a3(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "a former DISC for the taxable year (section 992(a)(3))";
}
@source(IRC_S992_A, relation = formalizes, coverage = exact, quote = "For purposes of this title, the term \"former DISC\" means, with respect to any taxable year, a corporation which is not a DISC for such year but was a DISC in a preceding taxable year and at the")
rule S992A3FormerDisc defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when not_disc_for_year_had_undistributed_income_at_start_992a3(corp, y);
    unless disc_992a1(corp, y);
    then former_disc_992a3(corp, y);
}
pub relation disc_not_subject_to_tax_991(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "a DISC is not subject to the taxes imposed by this subtitle (section 991)";
}
@source(IRC_S991, relation = formalizes, coverage = exact, quote = "For purposes of the taxes imposed by this subtitle upon a DISC (as defined in section 992(a)), a DISC shall not be subject to the taxes imposed by this subtitle.")
rule S991DiscNotSubjectToTax defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when disc_992a1(corp, y);
    then disc_not_subject_to_tax_991(corp, y);
}

// --- §992(b): election ----------------------------------------------------------------------------------------------------------

pub relation disc_election_made_on_992b1A(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, made_on: Date) kind empirical {
    label en official "the date the corporation made the election for the taxable year";
}
pub relation all_shareholders_consent_on_first_day_992b1B(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "all persons who are shareholders on the first day of the first taxable year for which the election is effective consent to the election";
}
pub relation secretary_consents_to_other_time_992b1A(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the Secretary consents to the making of the election at another time";
}
pub relation election_timely_992b1A(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the election is made at any time during the 90-day period immediately preceding the beginning of the taxable year, or at another time with the Secretary's consent";
}
@source(IRC_S992_B, relation = formalizes, coverage = exact, quote = "(A) An election by a corporation to be treated as a DISC shall be made by such corporation for a taxable year at any time during the 90–day period immediately preceding the beginning of the taxable")
rule S992B1ATimelyElection defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for made_on: Date;
    for begins_on: Date;
    when disc_election_made_on_992b1A(corp, y, made_on)
     and us.irc.core::begins(y, begins_on)
     and made_on <= begins_on
     and add_calendar_period(made_on, 90 calendar_day) >= begins_on;
    then election_timely_992b1A(corp, y);
}
rule S992B1ASecretaryConsentTimely defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when secretary_consents_to_other_time_992b1A(corp, y);
    then election_timely_992b1A(corp, y);
}
pub relation election_requirements_met_992b1(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the election is timely and valid only if all shareholders on the first day consent (section 992(b)(1))";
}
@source(IRC_S992_B, relation = formalizes, coverage = exact, quote = "(B) Such election shall be made in such manner as the Secretary shall prescribe and shall be valid only if all persons who are shareholders in such corporation on the first day of the first taxable")
rule S992B1ElectionRequirementsMet defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when election_timely_992b1A(corp, y)
     and all_shareholders_consent_on_first_day_992b1B(corp, y);
    then election_requirements_met_992b1(corp, y);
}
pub relation elects_to_be_treated_as_disc_992b1(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the corporation makes the election to be treated as a DISC for the taxable year";
}
pub relation election_effective_992b(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the election to be treated as a DISC is effective for the year (section 992(b))";
}
@source(IRC_S992_B, relation = formalizes, coverage = exact, quote = "(A) An election by a corporation to be treated as a DISC shall be made by such corporation for a taxable year at any time during the 90–day period immediately preceding the beginning of the taxable")
rule S992B1DiscElectionPower defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when elects_to_be_treated_as_disc_992b1(corp, y);
    then power S992B1DiscElection {
        holder corp;
        over corp;
        exercise elects_to_be_treated_as_disc_992b1(corp, y);
        valid_when election_requirements_met_992b1(corp, y);
        effect create(election_effective_992b(corp, y));
    };
}
pub relation consecutive_taxable_years_not_disc_with_election_effective_992b3B(corp: us.irc.core::Corporation, years: Integer) kind empirical {
    label en official "the number of consecutive taxable years for which the election was effective but the corporation was not a DISC";
}
pub relation election_terminated_992b3B(corp: us.irc.core::Corporation) kind institutional {
    label en official "if the corporation is not a DISC for each of 5 consecutive taxable years for which the election is effective, the election is terminated after the 5th year (section 992(b)(3)(B))";
}
@source(IRC_S992_B, relation = formalizes, coverage = exact, quote = "If a corporation is not a DISC for each of any 5 consecutive taxable years of the corporation for which an election under this subsection is effective, the election shall be terminated and not be in")
rule S992B3BFiveYearsWithoutDiscStatus defeasible {
    for corp: us.irc.core::Corporation;
    for years: Integer;
    when consecutive_taxable_years_not_disc_with_election_effective_992b3B(corp, years)
     and years >= 5;
    then election_terminated_992b3B(corp);
}

// --- §992(c): distributions to meet qualification requirements -----------------------------------------------------------------

pub relation qualification_failures_and_amounts_992c1(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, receipts_condition_failed: Boolean, assets_condition_failed: Boolean, taxable_income_on_non_qualified_receipts: Money, fmv_of_non_qualified_assets: Money) kind empirical {
    label en official "whether the gross receipts condition and the asset condition of subsection (a)(1) are failed, the portion of taxable income attributable to non-qualified receipts, and the fair market value of non-qualified export assets on the last day of the year";
}
pub relation required_qualification_distribution_992c1(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the pro rata distribution required to be deemed to satisfy a failed condition (section 992(c)(1)(A)-(C))";
}
@source(IRC_S992_C, relation = formalizes, coverage = exact, quote = "(A) if the condition of subsection (a)(1)(A) is not satisfied, the portion of such corporation's taxable income attributable to its gross receipts which are not qualified export receipts for such")
rule S992C1AReceiptsConditionOnly defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for ti: Money;
    for fmv: Money;
    when qualification_failures_and_amounts_992c1(corp, y, true, false, ti, fmv);
    then required_qualification_distribution_992c1(corp, y, ti);
}
@source(IRC_S992_C, relation = formalizes, coverage = exact, quote = "(B) if the condition of subsection (a)(1)(B) is not satisfied, the fair market value of those assets which are not qualified export assets on the last day of such taxable year, or")
rule S992C1BAssetsConditionOnly defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for ti: Money;
    for fmv: Money;
    when qualification_failures_and_amounts_992c1(corp, y, false, true, ti, fmv);
    then required_qualification_distribution_992c1(corp, y, fmv);
}
@source(IRC_S992_C, relation = formalizes, coverage = exact, quote = "(C) if neither of such conditions is satisfied, the sum of the amounts required by subparagraphs (A) and (B).")
rule S992C1CBothConditions defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for ti: Money;
    for fmv: Money;
    when qualification_failures_and_amounts_992c1(corp, y, true, true, ti, fmv);
    then required_qualification_distribution_992c1(corp, y, ti + fmv);
}
pub relation late_distribution_992c2B(corp: us.irc.core::Corporation, distribution_amount: Money, taxable_years_between: Integer) kind empirical {
    label en official "a distribution made after the 15th day of the 9th month after the close of the taxable year, and the number of its taxable years which begin after the year with respect to which it is made and before it is made";
}
pub relation late_distribution_payment_992c2B(corp: us.irc.core::Corporation, amount: Money) kind institutional {
    label en official "the amount payable to the Secretary within 30 days: 4 1/2 percent of the distribution multiplied by the number of intervening taxable years (section 992(c)(2)(B))";
}
@source(IRC_S992_C, relation = formalizes, coverage = partial, quote = "(B) the corporation pays, within the 30–day period beginning with the day on which such distribution is made, to the Secretary, if such corporation makes such distribution after the 15th day of the")
rule S992C2BLatePaymentAmount defeasible {
    for corp: us.irc.core::Corporation;
    for amount: Money;
    for years: Integer;
    when late_distribution_992c2B(corp, amount, years);
    then late_distribution_payment_992c2B(corp, round(amount * 0.045 * years, 2, "HALF_UP"));
}
pub relation seventy_percent_receipts_and_monthly_assets_992c3(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, receipts_percentage: Decimal, lowest_monthly_assets_percentage: Decimal) kind empirical {
    label en official "the percentage of gross receipts consisting of qualified export receipts, and the lowest month-end percentage of the adjusted basis of qualified export assets to all assets during the year";
}
pub relation timely_distribution_reasonable_cause_992c3(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "a distribution made on or before the 15th day of the 9th month after the close of the year is deemed for reasonable cause if at least 70 percent of gross receipts are qualified export receipts and the qualified export assets are at least 70 percent of all assets at the end of each month (section 992(c)(3))";
}
@source(IRC_S992_C, relation = formalizes, coverage = exact, quote = "A distribution made on or before the 15th day of the 9th month after the close of the taxable year shall be deemed for reasonable cause for purposes of paragraph (2)(A) if—")
rule S992C3SeventyPercentReasonableCause defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for receipts: Decimal;
    for assets: Decimal;
    when seventy_percent_receipts_and_monthly_assets_992c3(corp, y, receipts, assets)
     and receipts >= 70.0
     and assets >= 70.0;
    then timely_distribution_reasonable_cause_992c3(corp, y);
}

// --- §993(a): qualified export receipts -------------------------------------------------------------------------------------------

pub relation gross_receipt_993a1(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text, amount: Money, kind: Text) kind empirical {
    label en official "a receipt of the corporation of the kind: `A` (sale or disposition of export property), `B` (lease or rental of export property used outside the United States), `C` (services related and subsidiary to a qualified sale or lease), `D` (disposition of qualified export assets other than export property), `E` (dividends or section 951 amounts of a related foreign export corporation), `F` (interest on a qualified export asset obligation), `G` (engineering or architectural services for projects outside the United States) or `H` (managerial services in furtherance of other qualified export receipts)";
}
pub relation receipt_from_disc_in_same_controlled_group_993a2(item_id: Text) kind empirical {
    label en official "the receipt is from a corporation which is a DISC for its taxable year in which the receipts arise and which is a member of a controlled group which includes the recipient corporation";
}
pub relation designated_by_regulation_not_qualified_993a2(item_id: Text) kind empirical {
    label en official "the Secretary designated the receipt by regulation as not being a qualified export receipt (ultimate use in the United States, a United States subsidy, or use by the United States required by law)";
}
pub relation qualified_export_receipt_993a1(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text, amount: Money) kind institutional {
    label en official "a qualified export receipt (section 993(a)(1)), subject to the exclusions of paragraph (2)";
}
@source(IRC_S993_A, relation = formalizes, coverage = exact, quote = "(A) gross receipts from the sale, exchange, or other disposition of export property,")
rule S993A1AExportPropertySale defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for amount: Money;
    when gross_receipt_993a1(corp, y, item_id, amount, "A");
    unless receipt_from_disc_in_same_controlled_group_993a2(item_id)
     and gross_receipt_993a1(corp, y, item_id, amount, "A");
    unless designated_by_regulation_not_qualified_993a2(item_id)
     and gross_receipt_993a1(corp, y, item_id, amount, "A");
    then qualified_export_receipt_993a1(corp, y, item_id, amount);
}
@source(IRC_S993_A, relation = formalizes, coverage = exact, quote = "(B) gross receipts from the lease or rental of export property, which is used by the lessee of such property outside the United States,")
rule S993A1BExportPropertyLease defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for amount: Money;
    when gross_receipt_993a1(corp, y, item_id, amount, "B");
    unless receipt_from_disc_in_same_controlled_group_993a2(item_id)
     and gross_receipt_993a1(corp, y, item_id, amount, "B");
    unless designated_by_regulation_not_qualified_993a2(item_id)
     and gross_receipt_993a1(corp, y, item_id, amount, "B");
    then qualified_export_receipt_993a1(corp, y, item_id, amount);
}
@source(IRC_S993_A, relation = formalizes, coverage = exact, quote = "(C) gross receipts for services which are related and subsidiary to any qualified sale, exchange, lease, rental, or other disposition of export property by such corporation,")
rule S993A1CRelatedServices defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for amount: Money;
    when gross_receipt_993a1(corp, y, item_id, amount, "C");
    unless receipt_from_disc_in_same_controlled_group_993a2(item_id)
     and gross_receipt_993a1(corp, y, item_id, amount, "C");
    unless designated_by_regulation_not_qualified_993a2(item_id)
     and gross_receipt_993a1(corp, y, item_id, amount, "C");
    then qualified_export_receipt_993a1(corp, y, item_id, amount);
}
@source(IRC_S993_A, relation = formalizes, coverage = exact, quote = "(D) gross receipts from the sale, exchange, or other disposition of qualified export assets (other than export property),")
rule S993A1DQualifiedExportAssetDisposition defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for amount: Money;
    when gross_receipt_993a1(corp, y, item_id, amount, "D");
    unless receipt_from_disc_in_same_controlled_group_993a2(item_id)
     and gross_receipt_993a1(corp, y, item_id, amount, "D");
    then qualified_export_receipt_993a1(corp, y, item_id, amount);
}
@source(IRC_S993_A, relation = formalizes, coverage = exact, quote = "(E) dividends (or amounts includible in gross income under section 951) with respect to stock of a related foreign export corporation (as defined in subsection (e)),")
rule S993A1ERelatedForeignExportCorporationDividends defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for amount: Money;
    when gross_receipt_993a1(corp, y, item_id, amount, "E");
    then qualified_export_receipt_993a1(corp, y, item_id, amount);
}
@source(IRC_S993_A, relation = formalizes, coverage = exact, quote = "(F) interest on any obligation which is a qualified export asset,")
rule S993A1FInterestOnQualifiedExportAsset defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for amount: Money;
    when gross_receipt_993a1(corp, y, item_id, amount, "F");
    then qualified_export_receipt_993a1(corp, y, item_id, amount);
}
@source(IRC_S993_A, relation = formalizes, coverage = exact, quote = "(G) gross receipts for engineering or architectural services for construction projects located (or proposed for location) outside the United States, and")
rule S993A1GEngineeringOrArchitecturalServices defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for amount: Money;
    when gross_receipt_993a1(corp, y, item_id, amount, "G");
    then qualified_export_receipt_993a1(corp, y, item_id, amount);
}
@source(IRC_S993_A, relation = formalizes, coverage = exact, quote = "(H) gross receipts for the performance of managerial services in furtherance of the production of other qualified export receipts of a DISC.")
rule S993A1HManagerialServices defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for amount: Money;
    when gross_receipt_993a1(corp, y, item_id, amount, "H");
    then qualified_export_receipt_993a1(corp, y, item_id, amount);
}

// --- §993(b): qualified export assets ------------------------------------------------------------------------------------------------

pub relation asset_kind_993b(asset_id: Text, kind: Text) kind empirical {
    label en official "the asset is: `export_property`, `used_in_export_activities` (assets used primarily in connection with the sale, lease, rental, storage, handling, transportation, packaging, assembly or servicing of export property, or engineering, architectural or managerial services), `receivables` (accounts receivable and evidences of indebtedness arising from qualified transactions), `working_capital` (money, bank deposits and similar temporary investments reasonably necessary for working capital), `producers_loan`, `related_foreign_export_corporation_securities`, `export_import_bank_obligations`, `export_financing_corporation_obligations` or `us_deposits_for_asset_acquisition`";
}
pub relation qualified_export_asset_993b(asset_id: Text) kind institutional {
    label en official "a qualified export asset (section 993(b))";
}
@source(IRC_S993_B, relation = formalizes, coverage = exact, quote = "(1) export property (as defined in subsection (c));")
rule S993B1ExportProperty defeasible {
    for asset_id: Text;
    when asset_kind_993b(asset_id, "export_property");
    then qualified_export_asset_993b(asset_id);
}
@source(IRC_S993_B, relation = formalizes, coverage = exact, quote = "(2) assets used primarily in connection with the sale, lease, rental, storage, handling, transportation, packaging, assembly, or servicing of export property, or the performance of engineering or")
rule S993B2UsedInExportActivities defeasible {
    for asset_id: Text;
    when asset_kind_993b(asset_id, "used_in_export_activities");
    then qualified_export_asset_993b(asset_id);
}
@source(IRC_S993_B, relation = formalizes, coverage = exact, quote = "(3) accounts receivable and evidences of indebtedness which arise by reason of transactions of such corporation or of another corporation which is a DISC and which is a member of a controlled group")
rule S993B3Receivables defeasible {
    for asset_id: Text;
    when asset_kind_993b(asset_id, "receivables");
    then qualified_export_asset_993b(asset_id);
}
@source(IRC_S993_B, relation = formalizes, coverage = exact, quote = "(4) money, bank deposits, and other similar temporary investments, which are reasonably necessary to meet the working capital requirements of such corporation;")
rule S993B4WorkingCapital defeasible {
    for asset_id: Text;
    when asset_kind_993b(asset_id, "working_capital");
    then qualified_export_asset_993b(asset_id);
}
@source(IRC_S993_B, relation = formalizes, coverage = exact, quote = "(5) obligations arising in connection with a producer's loan (as defined in subsection (d));")
rule S993B5ProducersLoan defeasible {
    for asset_id: Text;
    when asset_kind_993b(asset_id, "producers_loan");
    then qualified_export_asset_993b(asset_id);
}
@source(IRC_S993_B, relation = formalizes, coverage = exact, quote = "(6) stock or securities of a related foreign export corporation (as defined in subsection (e));")
rule S993B6RelatedForeignExportCorporationSecurities defeasible {
    for asset_id: Text;
    when asset_kind_993b(asset_id, "related_foreign_export_corporation_securities");
    then qualified_export_asset_993b(asset_id);
}
@source(IRC_S993_B, relation = formalizes, coverage = exact, quote = "(7) obligations issued, guaranteed, or insured, in whole or in part, by the Export-Import Bank of the United States or the Foreign Credit Insurance Association in those cases where such obligations")
rule S993B7ExportImportBankObligations defeasible {
    for asset_id: Text;
    when asset_kind_993b(asset_id, "export_import_bank_obligations");
    then qualified_export_asset_993b(asset_id);
}
@source(IRC_S993_B, relation = formalizes, coverage = exact, quote = "(8) obligations issued by a domestic corporation organized solely for the purpose of financing sales of export property pursuant to an agreement with the Export-Import Bank of the United States under")
rule S993B8ExportFinancingCorporationObligations defeasible {
    for asset_id: Text;
    when asset_kind_993b(asset_id, "export_financing_corporation_obligations");
    then qualified_export_asset_993b(asset_id);
}
@source(IRC_S993_B, relation = formalizes, coverage = exact, quote = "(9) amounts (other than reasonable working capital) on deposit in the United States that are utilized during the period provided for in, and otherwise in accordance with, regulations prescribed by")
rule S993B9DepositsForAssetAcquisition defeasible {
    for asset_id: Text;
    when asset_kind_993b(asset_id, "us_deposits_for_asset_acquisition");
    then qualified_export_asset_993b(asset_id);
}

// --- §993(c): export property --------------------------------------------------------------------------------------------------------

pub relation property_manufactured_produced_grown_or_extracted_in_us_by_non_disc_993c1A(property_id: Text) kind empirical {
    label en official "the property was manufactured, produced, grown or extracted in the United States by a person other than a DISC";
}
pub relation property_held_primarily_for_sale_or_lease_for_use_outside_us_993c1B(property_id: Text) kind empirical {
    label en official "the property is held primarily for sale, lease or rental, in the ordinary course of trade or business, by or to a DISC, for direct use, consumption or disposition outside the United States";
}
pub relation imported_articles_percentage_of_fair_market_value_993c1C(property_id: Text, percentage: Decimal) kind empirical {
    label en official "the percentage of the fair market value of the property attributable to articles imported into the United States (at appraised value under section 402 of the Tariff Act of 1930)";
}
pub relation property_excluded_kind_993c2(property_id: Text, kind: Text) kind empirical {
    label en official "the property is: `leased_to_controlled_group_member`, `intangible_property`, `depletable_product`, `export_restricted_product` or `unprocessed_softwood_timber`";
}
pub relation designated_in_short_supply_by_executive_order_993c3(property_id: Text) kind empirical {
    label en official "the President designated the property as in short supply by Executive order, within the period the order specifies";
}
pub relation export_property_993c(property_id: Text) kind institutional {
    label en official "export property for purposes of the DISC provisions (section 993(c))";
}
@source(IRC_S993_C, relation = formalizes, coverage = exact, quote = "For purposes of this part, the term \"export property\" means property—")
rule S993C1ExportProperty defeasible {
    for property_id: Text;
    for imported: Decimal;
    when property_manufactured_produced_grown_or_extracted_in_us_by_non_disc_993c1A(property_id)
     and property_held_primarily_for_sale_or_lease_for_use_outside_us_993c1B(property_id)
     and imported_articles_percentage_of_fair_market_value_993c1C(property_id, imported)
     and imported <= 50.0;
    unless property_excluded_kind_993c2(property_id, "leased_to_controlled_group_member")
     and property_held_primarily_for_sale_or_lease_for_use_outside_us_993c1B(property_id);
    unless property_excluded_kind_993c2(property_id, "intangible_property")
     and property_held_primarily_for_sale_or_lease_for_use_outside_us_993c1B(property_id);
    unless depletable_product_excluded_993c2C(property_id)
     and property_held_primarily_for_sale_or_lease_for_use_outside_us_993c1B(property_id);
    unless property_excluded_kind_993c2(property_id, "export_restricted_product")
     and property_held_primarily_for_sale_or_lease_for_use_outside_us_993c1B(property_id);
    unless property_excluded_kind_993c2(property_id, "unprocessed_softwood_timber")
     and property_held_primarily_for_sale_or_lease_for_use_outside_us_993c1B(property_id);
    unless designated_in_short_supply_by_executive_order_993c3(property_id)
     and property_held_primarily_for_sale_or_lease_for_use_outside_us_993c1B(property_id);
    then export_property_993c(property_id);
}
pub relation president_designates_short_supply_993c3(property_id: Text) kind empirical {
    label en official "the President designates the property as in short supply by Executive order";
}
pub relation supply_insufficient_for_domestic_economy_993c3(property_id: Text) kind empirical {
    label en official "the President determines that the supply of the property is insufficient to meet the requirements of the domestic economy";
}
pub relation property_designated_in_short_supply_993c3(property_id: Text) kind institutional {
    label en official "the property is designated as in short supply and treated as property not described in paragraph (1) for the period the Executive order specifies (section 993(c)(3))";
}
@source(IRC_S993_C, relation = formalizes, coverage = partial, quote = "If the President determines that the supply of any property described in paragraph (1) is insufficient to meet the requirements of the domestic economy, he may by Executive order designate the")
rule S993C3ShortSupplyDesignationPower defeasible {
    for property_id: Text;
    when president_designates_short_supply_993c3(property_id);
    then power S993C3ShortSupplyDesignation {
        holder us.irc.international::President;
        over us.irc.international::President;
        exercise president_designates_short_supply_993c3(property_id);
        valid_when supply_insufficient_for_domestic_economy_993c3(property_id);
        effect create(property_designated_in_short_supply_993c3(property_id));
    };
}

// --- §993(d): producer's loans -----------------------------------------------------------------------------------------------------------

pub relation producers_loan_terms_993d1(loan_id: Text, amount: Money, unpaid_other_producers_loans: Money, accumulated_disc_income_at_start_of_month: Money, maturity_years: Integer, designated_at_time_of_loan: Boolean, borrower_manufactures_in_us: Boolean) kind empirical {
    label en official "the loan, the unpaid balance of the DISC's other producer's loans, the accumulated DISC income at the beginning of the month, the stated maturity in years, whether it is designated as a producer's loan at the time of the loan, and whether the borrower is engaged in the United States in the manufacturing, production, growing or extraction of export property";
}
pub relation producers_loan_993d1(loan_id: Text) kind institutional {
    label en official "an obligation treated as arising out of a producer's loan, subject to the limits of paragraphs (2) and (3) (section 993(d)(1))";
}
@source(IRC_S993_D, relation = formalizes, coverage = exact, quote = "An obligation, subject to the rules provided in paragraphs (2) and (3), shall be treated as arising out of a producer's loan if—")
rule S993D1ProducersLoanConditions defeasible {
    for loan_id: Text;
    for amount: Money;
    for unpaid: Money;
    for adi: Money;
    for maturity: Integer;
    when producers_loan_terms_993d1(loan_id, amount, unpaid, adi, maturity, true, true)
     and amount + unpaid <= adi
     and maturity <= 5;
    then producers_loan_993d1(loan_id);
}
pub relation borrower_base_amounts_993d2(borrower_id: Text, plant_and_equipment_basis: Money, held_for_sale_property: Money, prior_research_expenditures: Money, foreign_receipts_percentage: Decimal) kind empirical {
    label en official "the borrower's adjusted basis in plant, machinery, equipment and supporting facilities at the beginning of the year, its property held for sale or lease, its research and experimental expenditures in prior years after 1971, and the percentage of its 3-year receipts from sales outside the United States";
}
pub relation producers_loan_limit_993d2(borrower_id: Text, limit: Money) kind institutional {
    label en official "the sum of the borrower's plant basis, inventory and prior research expenditures multiplied by the foreign receipts percentage (section 993(d)(2))";
}
@source(IRC_S993_D, relation = formalizes, coverage = exact, quote = "An obligation shall be treated as arising out of a producer's loan only to the extent that such loan, when added to the unpaid balance of all other producer's loans to the borrower outstanding at the")
rule S993D2LimitBySumTimesPercentage defeasible {
    for borrower_id: Text;
    for plant: Money;
    for inventory: Money;
    for research: Money;
    for pct: Decimal;
    when borrower_base_amounts_993d2(borrower_id, plant, inventory, research, pct);
    then producers_loan_limit_993d2(borrower_id, round((plant + inventory + research) * (pct / 100.0), 2, "HALF_UP"));
}
pub relation borrower_annual_limit_inputs_993d3(borrower_id: Text, asset_basis_at_year_end: Money, asset_basis_at_year_start: Money, research_expenditures_in_year: Money) kind empirical {
    label en official "the adjusted basis of the paragraph (2)(A) and (B) assets on the last and first day of the year, and the research and experimental expenditures during the year";
}
pub relation producers_loan_annual_limit_993d3(borrower_id: Text, limit: Money) kind institutional {
    label en official "the annual limit: the increase in the basis of the assets during the year plus the research expenditures of the year (section 993(d)(3))";
}
@source(IRC_S993_D, relation = formalizes, coverage = exact, quote = "An obligation shall be treated as arising out of a producer's loan in a taxable year only to the extent that such loan, when added to the unpaid balance of all other producer's loans to the borrower")
rule S993D3AnnualLimit defeasible {
    for borrower_id: Text;
    for end_basis: Money;
    for start_basis: Money;
    for research: Money;
    when borrower_annual_limit_inputs_993d3(borrower_id, end_basis, start_basis, research);
    then producers_loan_annual_limit_993d3(borrower_id, max(end_basis - start_basis, 0.00 USD) + research);
}

// --- §993(e): related foreign export corporation ----------------------------------------------------------------------------------------

pub relation foreign_corporation_ownership_and_receipts_993e1(foreign_corp: us.irc.core::Corporation, voting_power_owned_by_domestic: Decimal, qualified_receipts_percentage: Decimal, qualified_assets_basis_percentage: Decimal) kind empirical {
    label en official "the percentage of voting power owned directly by the domestic corporation, the percentage of the foreign corporation's gross receipts that are qualified export receipts of the listed kinds, and the percentage of the adjusted basis of its qualified export assets";
}
pub relation foreign_corporation_holds_real_property_for_domestic_use_993e2B(foreign_corp: us.irc.core::Corporation) kind empirical {
    label en official "the exclusive function of the foreign corporation is to hold real property for the exclusive use of the domestic corporation";
}
pub relation domestic_and_group_voting_power_owned_993e3A(foreign_corp: us.irc.core::Corporation, percentage: Decimal) kind empirical {
    label en official "the percentage of the total combined voting power owned (within the meaning of section 1563(d) and (e)) by the domestic corporation or its controlled group";
}
pub relation ownership_reasonably_in_furtherance_of_qualified_receipts_993e3B(foreign_corp: us.irc.core::Corporation) kind empirical {
    label en official "the ownership of stock or securities is determined by regulations to be reasonably in furtherance of transactions giving rise to qualified export receipts of the domestic corporation";
}
pub relation related_foreign_export_corporation_993e(foreign_corp: us.irc.core::Corporation) kind institutional {
    label en official "a related foreign export corporation (section 993(e))";
}
@source(IRC_S993_E, relation = formalizes, coverage = exact, quote = "A foreign corporation is a related foreign export corporation if—")
rule S993E1OperatingCorporation defeasible {
    for foreign_corp: us.irc.core::Corporation;
    for vote: Decimal;
    for receipts: Decimal;
    for assets: Decimal;
    when foreign_corporation_ownership_and_receipts_993e1(foreign_corp, vote, receipts, assets)
     and vote > 50.0
     and receipts >= 95.0
     and assets >= 95.0;
    then related_foreign_export_corporation_993e(foreign_corp);
}
@source(IRC_S993_E, relation = formalizes, coverage = exact, quote = "A foreign corporation is a related foreign export corporation if—")
rule S993E2RealPropertyHoldingCorporation defeasible {
    for foreign_corp: us.irc.core::Corporation;
    for vote: Decimal;
    for receipts: Decimal;
    for assets: Decimal;
    when foreign_corporation_ownership_and_receipts_993e1(foreign_corp, vote, receipts, assets)
     and vote > 50.0
     and foreign_corporation_holds_real_property_for_domestic_use_993e2B(foreign_corp);
    then related_foreign_export_corporation_993e(foreign_corp);
}
@source(IRC_S993_E, relation = formalizes, coverage = exact, quote = "A foreign corporation is a related foreign export corporation if—")
rule S993E3MinorityCorporation defeasible {
    for foreign_corp: us.irc.core::Corporation;
    for pct: Decimal;
    when domestic_and_group_voting_power_owned_993e3A(foreign_corp, pct)
     and pct < 10.0
     and ownership_reasonably_in_furtherance_of_qualified_receipts_993e3B(foreign_corp);
    then related_foreign_export_corporation_993e(foreign_corp);
}

// --- §994: transfer pricing --------------------------------------------------------------------------------------------------------------

pub relation sale_of_export_property_to_disc_994a(corp: us.irc.core::Corporation, sale_id: Text, qualified_export_receipts: Money, export_promotion_expenses: Money, disc_share_of_combined_taxable_income: Money, taxable_income_at_actual_price: Money) kind empirical {
    label en official "a sale of export property to a DISC by a person described in section 482: the qualified export receipts on the DISC's resale, the DISC's export promotion expenses attributable to them, 50 percent basis: the DISC's share of combined taxable income (the combined taxable income of the DISC and the person attributable to the receipts), and the taxable income at the price actually charged";
}
pub relation combined_taxable_income_994a2(sale_id: Text, combined_taxable_income: Money) kind empirical {
    label en official "the combined taxable income of the DISC and the related supplier attributable to the qualified export receipts on the property";
}
pub relation maximum_disc_taxable_income_994a(corp: us.irc.core::Corporation, sale_id: Text, amount: Money) kind institutional {
    label en official "the transfer price allows the DISC taxable income not exceeding the greatest of: 4 percent of qualified export receipts plus 10 percent of export promotion expenses; 50 percent of combined taxable income plus 10 percent of export promotion expenses; or income at the actual price (section 994(a))";
}
@source(IRC_S994_A, relation = formalizes, coverage = exact, quote = "In the case of a sale of export property to a DISC by a person described in section 482, the taxable income of such DISC and such person shall be based upon a transfer price which would allow such")
rule S994AGreatestOfThreeMethods defeasible {
    for corp: us.irc.core::Corporation;
    for sale_id: Text;
    for qer: Money;
    for epe: Money;
    for share: Money;
    for actual: Money;
    for combined: Money;
    when sale_of_export_property_to_disc_994a(corp, sale_id, qer, epe, share, actual)
     and combined_taxable_income_994a2(sale_id, combined);
    then maximum_disc_taxable_income_994a(corp, sale_id, max(max(round(qer * 0.04, 2, "HALF_UP") + round(epe * 0.10, 2, "HALF_UP"), round(combined * 0.50, 2, "HALF_UP") + round(epe * 0.10, 2, "HALF_UP")), actual));
}
