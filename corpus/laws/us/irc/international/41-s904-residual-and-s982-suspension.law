// Stage 3 (TECH_GAP reduction), module 41: section 904(f)(3)-(5), (g)(3), (g)(5),
// (h)(2), (h)(8)-(10), (j)(1)(B)-(C), (b)(2)(B)(iii) and the section 982(c)(2)(C)
// suspension of the 90-day period. Status implemented_unverified: not a legal
// review; the scenarios of tests/s904-s982-stage3.lawtest are written, NOT executed.
//
// Modeling notes.
//  * The overall foreign / domestic loss balances stay case inputs (module 04, G330);
//    this module reads `unused_overall_foreign_loss_balance` and
//    `overall_foreign_loss_recapture_amount` and never builds a running ledger.
//  * Per-basket allocations use the four section 904(d)(1) baskets of module 04
//    (`ForeignTaxCreditBasket`). The aggregates (`sum` over baskets) are asserted
//    directly: a `sum all` over a derived relation is a runtime-subset limit (section 111).
//  * Shares are exact: `div_round(base * (a / 1.00 USD), b / 1.00 USD, 2, "HALF_UP")`;
//    the statute names no rounding of an allocated amount, the corpus convention
//    (cents, HALF_UP) is a JUDGMENT CALL recorded on the coverage rows.

// --- §904(f)(3): deemed recognition on disposition of predominantly foreign-use property ------------

use self::{
    ForeignTaxCreditBasket,
    IRC_S904_B,
    IRC_S904_F,
    IRC_S904_G,
    IRC_S904_H,
    IRC_S904_J,
    IRC_S982_C,
    IRC_S982_E,
    alternative_rate_1h_904b3E,
    capital_gain_rate_differential_year_904b3D,
    compliance_test_date_982,
    failure_to_comply_982a,
    foreign_source_taxable_income_input,
    formal_document_request_mailed_982c1,
    highest_section_1_rate_904b3E,
    net_capital_gain_904b3,
    overall_domestic_loss_recharacterized_amount,
    overall_foreign_loss_recapture_amount,
    quash_proceeding_begun_982c2,
    quash_proceeding_pending_days_982c2C,
    reasonable_cause_for_failure_982b1,
    section_904j_applies_to_individual,
    taxpayer_substantially_complied_with_request_982a,
    united_states_owned_foreign_corporation_904h6,
    unused_overall_foreign_loss_balance,
    us_source_taxable_income_input,
};

pub relation use_in_lookback_period_904f3A(p: us.irc.core::Person, y: us.irc.core::TaxableYear, prop_id: Text, days_without_us: Integer, days_in_period: Integer) kind empirical {
    label en official "the number of days of use without the United States in the 3-year period ending on the date of the disposition (or, if shorter, the period during which the property has been used in the trade or business), and the number of days of that period";
}
pub relation property_used_predominantly_without_us_904f3A(p: us.irc.core::Person, y: us.irc.core::TaxableYear, prop_id: Text) kind institutional {
    label en official "property which has been used predominantly without the United States in a trade or business, the use taken into account over the 3-year period ending on the date of the disposition (or the shorter period of use in the trade or business)";
}
// JUDGMENT CALL (INTERPRETATION): the statute does not define "predominantly";
// it is read as more than half of the days of the look-back period.
@source(IRC_S904_F, relation = formalizes, coverage = partial, quote = "In determining for purposes of this subparagraph whether the predominant use of any property has been without")
rule S904F3AUsePredominantlyWithoutUnitedStates defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for prop_id: Text;
    for without_us: Integer;
    for total: Integer;
    when use_in_lookback_period_904f3A(p, y, prop_id, without_us, total)
     and total > 0
     and (without_us * 2) > total;
    then property_used_predominantly_without_us_904f3A(p, y, prop_id);
}
pub relation property_disposed_by_sale_exchange_distribution_or_gift_904f3Bi(p: us.irc.core::Person, y: us.irc.core::TaxableYear, prop_id: Text) kind empirical {
    label en official "the property is disposed of by a sale, exchange, distribution, or gift, whether or not gain or loss is recognized on the transfer";
}
pub relation property_not_material_factor_in_income_904f3Ci(p: us.irc.core::Person, y: us.irc.core::TaxableYear, prop_id: Text) kind empirical {
    label en official "the property is not a material factor in the realization of income by the taxpayer";
}
pub relation disposition_to_domestic_corporation_in_381a_transfer_904f3Cii(p: us.irc.core::Person, y: us.irc.core::TaxableYear, prop_id: Text) kind empirical {
    label en official "the disposition is a disposition of property to a domestic corporation in a distribution or transfer described in section 381(a)";
}
pub relation disposition_904f3(p: us.irc.core::Person, y: us.irc.core::TaxableYear, prop_id: Text) kind institutional {
    label en official "a disposition for section 904(f)(3): a sale, exchange, distribution or gift, whether or not gain or loss is recognized, other than a disposition of property that is not a material factor in the realization of income or a disposition to a domestic corporation in a section 381(a) distribution or transfer";
}
@source(IRC_S904_F, relation = formalizes, coverage = exact, quote = "(i) For purposes of this subsection, the term \"disposition\" includes a sale, exchange, distribution, or gift")
rule S904F3BiDispositionIncludesSaleExchangeDistributionOrGift defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for prop_id: Text;
    when property_disposed_by_sale_exchange_distribution_or_gift_904f3Bi(p, y, prop_id);
    unless property_not_material_factor_in_income_904f3Ci(p, y, prop_id)
     and property_disposed_by_sale_exchange_distribution_or_gift_904f3Bi(p, y, prop_id);
    unless disposition_to_domestic_corporation_in_381a_transfer_904f3Cii(p, y, prop_id)
     and property_disposed_by_sale_exchange_distribution_or_gift_904f3Bi(p, y, prop_id);
    then disposition_904f3(p, y, prop_id);
}
pub relation property_disposition_value_904f3(p: us.irc.core::Person, y: us.irc.core::TaxableYear, prop_id: Text, fair_market_value: Money, adjusted_basis: Money) kind empirical {
    label en official "the fair market value of the property and the taxpayer's adjusted basis in it on the disposition";
}
pub relation remaining_overall_foreign_loss_904f3A(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the remaining amount of the overall foreign losses not used under paragraph (1) for the taxable year or any prior taxable year: the balance at the start of the year less the amount recaptured under paragraph (1) for the year";
}
// JUDGMENT CALL: one disposition per year; the remaining loss is not shared out
// among several dispositions of the same year (an aggregate over a derived
// relation is a runtime-subset limit, section 111).
@source(IRC_S904_F, relation = formalizes, coverage = partial, quote = "(i) the taxpayer, notwithstanding any other provision of this chapter (other than paragraph (1)), shall be")
rule S904F3ARemainingOverallForeignLoss defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for balance: Money;
    for used: Money;
    when unused_overall_foreign_loss_balance(p, y, balance)
     and overall_foreign_loss_recapture_amount(p, y, used);
    then remaining_overall_foreign_loss_904f3A(p, y, balance - used);
}
pub relation deemed_foreign_source_income_on_disposition_904f3Ai(p: us.irc.core::Person, y: us.irc.core::TaxableYear, prop_id: Text, amount: Money) kind institutional {
    label en official "the taxpayer is deemed to have received and recognized taxable income from sources without the United States in the year of the disposition, in an amount equal to the lesser of the excess of fair market value over adjusted basis or the remaining overall foreign losses";
}
@source(IRC_S904_F, relation = formalizes, coverage = exact, quote = "(i) the taxpayer, notwithstanding any other provision of this chapter (other than paragraph (1)), shall be")
rule S904F3AiDeemedIncomePredominantlyForeignProperty defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for prop_id: Text;
    for fmv: Money;
    for basis: Money;
    for remaining: Money;
    when disposition_904f3(p, y, prop_id)
     and property_used_predominantly_without_us_904f3A(p, y, prop_id)
     and property_disposition_value_904f3(p, y, prop_id, fmv, basis)
     and remaining_overall_foreign_loss_904f3A(p, y, remaining)
     and fmv > basis;
    then deemed_foreign_source_income_on_disposition_904f3Ai(p, y, prop_id, min(fmv - basis, remaining));
}
pub relation overall_foreign_loss_recapture_on_disposition_904f3Aii(p: us.irc.core::Person, y: us.irc.core::TaxableYear, prop_id: Text, amount: Money) kind institutional {
    label en official "paragraph (1) applied to the deemed income with 100 percent substituted for 50 percent: the deemed income is recaptured as income from sources within the United States to the extent of the remaining loss";
}
@source(IRC_S904_F, relation = formalizes, coverage = exact, quote = "(ii) paragraph (1) shall be applied with respect to such income by substituting \"100 percent\" for \"50")
rule S904F3AiiRecaptureOfDeemedIncomeAtHundredPercent defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for prop_id: Text;
    for deemed: Money;
    for remaining: Money;
    when deemed_foreign_source_income_on_disposition_904f3Ai(p, y, prop_id, deemed)
     and remaining_overall_foreign_loss_904f3A(p, y, remaining);
    then overall_foreign_loss_recapture_on_disposition_904f3Aii(p, y, prop_id, min(deemed, remaining));
}
pub relation deemed_income_has_character_of_sale_904f3Bii(p: us.irc.core::Person, y: us.irc.core::TaxableYear, prop_id: Text) kind institutional {
    label en official "the taxable income recognized solely by reason of subparagraph (A) has the characterization it would have had if the taxpayer had sold or exchanged the property";
}
@source(IRC_S904_F, relation = formalizes, coverage = exact, quote = "(ii) Any taxable income recognized solely by reason of subparagraph (A) shall have the same characterization")
rule S904F3BiiDeemedIncomeCharacterAsIfSold defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for prop_id: Text;
    for deemed: Money;
    when deemed_foreign_source_income_on_disposition_904f3Ai(p, y, prop_id, deemed);
    then deemed_income_has_character_of_sale_904f3Bii(p, y, prop_id);
}

// (D): applicable dispositions of stock in a controlled foreign corporation.
pub relation cfc_stock_disposed_of_904f3Dii(p: us.irc.core::Person, y: us.irc.core::TaxableYear, prop_id: Text) kind empirical {
    label en official "any share of stock in a controlled foreign corporation (section 957) is disposed of in a transaction or series of transactions";
}
pub relation taxpayer_ownership_percent_of_cfc_before_904f3Dii(p: us.irc.core::Person, y: us.irc.core::TaxableYear, prop_id: Text, vote_percent: Decimal, value_percent: Decimal) kind empirical {
    label en official "the percentage (by vote, by value) of the stock of the controlled foreign corporation the taxpayer owned immediately before the transaction or series of transactions, determined under section 958(a) and (b)";
}
pub relation exchange_under_351_721_or_exchanged_basis_stock_904f3DiiiI(p: us.irc.core::Person, y: us.irc.core::TaxableYear, prop_id: Text) kind empirical {
    label en official "the transaction is one to which section 351 or 721 applies, or the transferor receives stock in a foreign corporation for the controlled foreign corporation stock and it is exchanged basis property (section 7701(a)(44))";
}
pub relation transferor_owns_at_least_same_percentage_after_904f3DiiiII(p: us.irc.core::Person, y: us.irc.core::TaxableYear, prop_id: Text) kind empirical {
    label en official "immediately after the transaction the transferor owns (by vote or value) at least the same percentage of stock in the controlled foreign corporation (or of the foreign corporation received in exchange) as it owned immediately before";
}
pub relation asset_acquisition_in_332_or_368a1_exchange_904f3Div(p: us.irc.core::Person, y: us.irc.core::TaxableYear, prop_id: Text) kind empirical {
    label en official "the taxpayer (or a member of its consolidated affiliated group) acquires the assets of the controlled foreign corporation in exchange for its shares in a liquidation described in section 332 or a reorganization described in section 368(a)(1)";
}
pub relation disposition_excepted_from_applicable_904f3Diii_iv(p: us.irc.core::Person, y: us.irc.core::TaxableYear, prop_id: Text) kind institutional {
    label en official "the disposition is part of a transaction excepted from applicable dispositions by clause (iii) (ownership percentage retained) or clause (iv) (asset acquisition)";
}
@source(IRC_S904_F, relation = formalizes, coverage = exact, quote = "(I) to which section 351 or 721 applies, or under which the transferor receives stock in a foreign")
rule S904F3DiiiExchangeRetainingOwnership defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for prop_id: Text;
    when exchange_under_351_721_or_exchanged_basis_stock_904f3DiiiI(p, y, prop_id)
     and transferor_owns_at_least_same_percentage_after_904f3DiiiII(p, y, prop_id);
    then disposition_excepted_from_applicable_904f3Diii_iv(p, y, prop_id);
}
@source(IRC_S904_F, relation = formalizes, coverage = exact, quote = "A disposition shall not be treated as an applicable disposition under clause (ii) if it is part of a")
rule S904F3DivAssetAcquisition defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for prop_id: Text;
    when asset_acquisition_in_332_or_368a1_exchange_904f3Div(p, y, prop_id);
    then disposition_excepted_from_applicable_904f3Diii_iv(p, y, prop_id);
}
pub relation applicable_disposition_904f3Dii(p: us.irc.core::Person, y: us.irc.core::TaxableYear, prop_id: Text) kind institutional {
    label en official "an applicable disposition: a disposition of stock in a controlled foreign corporation when, immediately before, the taxpayer owned more than 50 percent (by vote or value) of it, other than a disposition excepted by clause (iii) or (iv)";
}
@source(IRC_S904_F, relation = formalizes, coverage = exact, quote = "For purposes of clause (i), the term \"applicable disposition\" means any disposition of any share of stock in")
rule S904F3DiiApplicableDispositionByVote defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for prop_id: Text;
    for vote: Decimal;
    for value: Decimal;
    when cfc_stock_disposed_of_904f3Dii(p, y, prop_id)
     and taxpayer_ownership_percent_of_cfc_before_904f3Dii(p, y, prop_id, vote, value)
     and vote > 50.0;
    unless disposition_excepted_from_applicable_904f3Diii_iv(p, y, prop_id)
     and cfc_stock_disposed_of_904f3Dii(p, y, prop_id);
    then applicable_disposition_904f3Dii(p, y, prop_id);
}
@source(IRC_S904_F, relation = formalizes, coverage = exact, quote = "For purposes of clause (i), the term \"applicable disposition\" means any disposition of any share of stock in")
rule S904F3DiiApplicableDispositionByValue defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for prop_id: Text;
    for vote: Decimal;
    for value: Decimal;
    when cfc_stock_disposed_of_904f3Dii(p, y, prop_id)
     and taxpayer_ownership_percent_of_cfc_before_904f3Dii(p, y, prop_id, vote, value)
     and value > 50.0;
    unless disposition_excepted_from_applicable_904f3Diii_iv(p, y, prop_id)
     and cfc_stock_disposed_of_904f3Dii(p, y, prop_id);
    then applicable_disposition_904f3Dii(p, y, prop_id);
}
@source(IRC_S904_F, relation = formalizes, coverage = exact, quote = "This paragraph shall apply to an applicable disposition in the same manner as if it were a disposition of")
rule S904F3DiApplicableDispositionIsDisposition defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for prop_id: Text;
    when applicable_disposition_904f3Dii(p, y, prop_id);
    unless disposition_to_domestic_corporation_in_381a_transfer_904f3Cii(p, y, prop_id)
     and applicable_disposition_904f3Dii(p, y, prop_id);
    then disposition_904f3(p, y, prop_id);
}
@source(IRC_S904_F, relation = formalizes, coverage = exact, quote = "This paragraph shall apply to an applicable disposition in the same manner as if it were a disposition of")
rule S904F3DiDeemedIncomeOnApplicableDisposition defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for prop_id: Text;
    for fmv: Money;
    for basis: Money;
    for remaining: Money;
    when applicable_disposition_904f3Dii(p, y, prop_id)
     and property_disposition_value_904f3(p, y, prop_id, fmv, basis)
     and remaining_overall_foreign_loss_904f3A(p, y, remaining)
     and fmv > basis;
    unless disposition_to_domestic_corporation_in_381a_transfer_904f3Cii(p, y, prop_id)
     and applicable_disposition_904f3Dii(p, y, prop_id)
     and property_disposition_value_904f3(p, y, prop_id, fmv, basis)
     and remaining_overall_foreign_loss_904f3A(p, y, remaining);
    then deemed_foreign_source_income_on_disposition_904f3Ai(p, y, prop_id, min(fmv - basis, remaining));
}
// JUDGMENT CALL (INTERPRETATION): for an excepted disposition clause (i) applies
// "to any gain recognized"; the deemed income is the lesser of the recognized
// gain and the remaining loss.
pub relation recognized_gain_on_excepted_disposition_904f3Dii(p: us.irc.core::Person, y: us.irc.core::TaxableYear, prop_id: Text, gain: Money) kind empirical {
    label en official "the gain recognized on a disposition excepted from applicable dispositions by clause (iii) or (iv)";
}
@source(IRC_S904_F, relation = formalizes, coverage = partial, quote = "For purposes of clause (i), the term \"applicable disposition\" means any disposition of any share of stock in")
rule S904F3DiiDeemedIncomeOnRecognizedGainOfExceptedDisposition defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for prop_id: Text;
    for gain: Money;
    for remaining: Money;
    when disposition_excepted_from_applicable_904f3Diii_iv(p, y, prop_id)
     and cfc_stock_disposed_of_904f3Dii(p, y, prop_id)
     and recognized_gain_on_excepted_disposition_904f3Dii(p, y, prop_id, gain)
     and remaining_overall_foreign_loss_904f3A(p, y, remaining)
     and gain > 0.00 USD;
    then deemed_foreign_source_income_on_disposition_904f3Ai(p, y, prop_id, min(gain, remaining));
}

// --- §904(f)(4): accumulation distributions of a foreign trust ---------------------------------------

pub relation trust_accumulation_distribution_foreign_source_amount_904f4(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the amounts of income from sources without the United States treated under section 666 (without regard to (b) and (c) where a deduction was taken under section 667(d)(1)(B)) as distributed by a foreign trust in a preceding taxable year, received in this taxable year";
}
pub relation accumulation_distribution_recharacterized_as_us_source_904f4(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the portion of the accumulation distribution equal to the beneficiary's overall foreign loss of a prior year, to the extent not used under this subsection in prior years or in the current year against other income, treated as income from sources within the United States";
}
@source(IRC_S904_F, relation = formalizes, coverage = exact, quote = "For purposes of this chapter, in the case of amounts of income from sources without the United States which")
rule S904F4AccumulationDistributionRecharacterization defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for distribution: Money;
    for remaining: Money;
    when trust_accumulation_distribution_foreign_source_amount_904f4(p, y, distribution)
     and remaining_overall_foreign_loss_904f3A(p, y, remaining);
    then accumulation_distribution_recharacterized_as_us_source_904f4(p, y, min(distribution, remaining));
}

// --- §904(f)(5): separate limitation losses ---------------------------------------------------------

pub relation separate_limitation_income_904f5E(p: us.irc.core::Person, y: us.irc.core::TaxableYear, basket: ForeignTaxCreditBasket, amount: Money) kind empirical {
    label en official "the separate limitation income of the income category: the taxable income from sources outside the United States separately computed for the category (the category is one of the section 904(d)(1) categories)";
}
pub relation separate_limitation_loss_904f5E(p: us.irc.core::Person, y: us.irc.core::TaxableYear, basket: ForeignTaxCreditBasket, amount: Money) kind empirical {
    label en official "the separate limitation loss of the income category: the loss from the category determined under the principles of section 907(c)(4)(B)";
}
pub relation aggregate_separate_limitation_incomes_904f5(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the aggregate of the separate limitation incomes for the taxable year (asserted directly: a sum over baskets)";
}
pub relation aggregate_separate_limitation_losses_904f5(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the aggregate of the separate limitation losses for the taxable year (asserted directly: a sum over baskets)";
}
pub relation us_income_reduction_by_separate_limitation_losses_904f5A(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the separate limitation losses reduce income from sources within the United States only to the extent the aggregate of the losses exceeds the aggregate of the separate limitation incomes";
}
@source(IRC_S904_F, relation = formalizes, coverage = exact, quote = "The amount of the separate limitation losses for any taxable year shall reduce income from sources within the")
rule S904F5AExcessLossesReduceUsIncome defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for losses: Money;
    for incomes: Money;
    when aggregate_separate_limitation_losses_904f5(p, y, losses)
     and aggregate_separate_limitation_incomes_904f5(p, y, incomes)
     and losses > incomes;
    then us_income_reduction_by_separate_limitation_losses_904f5A(p, y, losses - incomes);
}
pub relation separate_limitation_loss_allocated_to_basket_904f5B(p: us.irc.core::Person, y: us.irc.core::TaxableYear, basket: ForeignTaxCreditBasket, amount: Money) kind institutional {
    label en official "the part of the separate limitation losses, up to the aggregate separate limitation incomes, allocated to (and reducing) the income of the category on a proportionate basis";
}
@source(IRC_S904_F, relation = formalizes, coverage = exact, quote = "The separate limitation losses for any taxable year (to the extent such losses do not exceed the separate")
rule S904F5BProportionateAllocationOfLosses defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for basket: ForeignTaxCreditBasket;
    for income: Money;
    for losses: Money;
    for incomes: Money;
    when separate_limitation_income_904f5E(p, y, basket, income)
     and aggregate_separate_limitation_losses_904f5(p, y, losses)
     and aggregate_separate_limitation_incomes_904f5(p, y, incomes)
     and incomes > 0.00 USD
     and losses > 0.00 USD;
    then separate_limitation_loss_allocated_to_basket_904f5B(p, y, basket, div_round(min(losses, incomes) * (income / 1.00 USD), incomes / 1.00 USD, 2, "HALF_UP"));
}
pub relation loss_category_income_in_subsequent_year_904f5C(p: us.irc.core::Person, y: us.irc.core::TaxableYear, loss_basket: ForeignTaxCreditBasket, amount: Money) kind empirical {
    label en official "the loss category has income for the subsequent taxable year";
}
pub relation loss_category_losses_not_previously_recharacterized_904f5C(p: us.irc.core::Person, y: us.irc.core::TaxableYear, loss_basket: ForeignTaxCreditBasket, amount: Money) kind empirical {
    label en official "the aggregate separate limitation losses from the loss category not previously recharacterized under subparagraph (C)";
}
pub relation prior_reduction_in_other_category_904f5C(p: us.irc.core::Person, y: us.irc.core::TaxableYear, loss_basket: ForeignTaxCreditBasket, other_basket: ForeignTaxCreditBasket, amount: Money) kind empirical {
    label en official "the prior reductions under subparagraph (B) of the other category by losses of the loss category not previously taken into account under subparagraph (C)";
}
pub relation total_prior_reductions_by_loss_category_904f5C(p: us.irc.core::Person, y: us.irc.core::TaxableYear, loss_basket: ForeignTaxCreditBasket, amount: Money) kind empirical {
    label en unofficial "the sum of the prior reductions of all other categories by the loss category (asserted directly)";
}
pub relation income_recharacterized_to_other_category_904f5C(p: us.irc.core::Person, y: us.irc.core::TaxableYear, loss_basket: ForeignTaxCreditBasket, other_basket: ForeignTaxCreditBasket, amount: Money) kind institutional {
    label en official "the income of the loss category for the subsequent year, to the extent it does not exceed the unrecharacterized losses of that category, recharacterized as income of the other category in proportion to the prior reductions of that category; no tax is recharacterized";
}
@source(IRC_S904_F, relation = formalizes, coverage = exact, quote = "such income (to the extent it does not exceed the aggregate separate limitation losses from the loss category")
rule S904F5CRecharacterizationOfSubsequentIncome defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for loss_basket: ForeignTaxCreditBasket;
    for other_basket: ForeignTaxCreditBasket;
    for income: Money;
    for unrecharacterized: Money;
    for reduction: Money;
    for total: Money;
    when loss_category_income_in_subsequent_year_904f5C(p, y, loss_basket, income)
     and loss_category_losses_not_previously_recharacterized_904f5C(p, y, loss_basket, unrecharacterized)
     and prior_reduction_in_other_category_904f5C(p, y, loss_basket, other_basket, reduction)
     and total_prior_reductions_by_loss_category_904f5C(p, y, loss_basket, total)
     and total > 0.00 USD;
    then income_recharacterized_to_other_category_904f5C(p, y, loss_basket, other_basket, div_round(min(income, unrecharacterized) * (reduction / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}
pub relation us_source_loss_904f5D(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the loss from sources in the United States for the taxable year";
}
pub relation separate_limitation_incomes_after_904f5B_904f5D(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the aggregate separate limitation incomes remaining after the allocation of separate limitation losses under subparagraph (B)";
}
@source(IRC_S904_F, relation = formalizes, coverage = exact, quote = "Any loss from sources in the United States for any taxable year (to the extent such loss does not exceed the")
rule S904F5DIncomesRemainingAfterB defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for losses: Money;
    for incomes: Money;
    when aggregate_separate_limitation_losses_904f5(p, y, losses)
     and aggregate_separate_limitation_incomes_904f5(p, y, incomes);
    then separate_limitation_incomes_after_904f5B_904f5D(p, y, max(incomes - losses, 0.00 USD));
}
pub relation us_loss_allocated_to_basket_904f5D(p: us.irc.core::Person, y: us.irc.core::TaxableYear, basket: ForeignTaxCreditBasket, amount: Money) kind institutional {
    label en official "the part of the loss from sources in the United States (to the extent it does not exceed the separate limitation incomes) allocated to, and reducing, the income of the category on a proportionate basis, applied after subparagraph (B)";
}
@source(IRC_S904_F, relation = formalizes, coverage = exact, quote = "Any loss from sources in the United States for any taxable year (to the extent such loss does not exceed the")
rule S904F5DUsLossAllocatedAfterB defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for basket: ForeignTaxCreditBasket;
    for income: Money;
    for allocated_b: Money;
    for loss: Money;
    for remaining: Money;
    when separate_limitation_income_904f5E(p, y, basket, income)
     and separate_limitation_loss_allocated_to_basket_904f5B(p, y, basket, allocated_b)
     and us_source_loss_904f5D(p, y, loss)
     and separate_limitation_incomes_after_904f5B_904f5D(p, y, remaining)
     and remaining > 0.00 USD;
    then us_loss_allocated_to_basket_904f5D(p, y, basket, div_round(min(loss, remaining) * ((income - allocated_b) / 1.00 USD), remaining / 1.00 USD, 2, "HALF_UP"));
}
pub relation gain_on_disposition_in_category_904f5F(p: us.irc.core::Person, y: us.irc.core::TaxableYear, prop_id: Text, basket: ForeignTaxCreditBasket) kind empirical {
    label en official "gain from the disposition of property would be in the income category with respect to which there was a separate limitation loss";
}
pub relation regulations_except_disposition_from_904f5F(p: us.irc.core::Person, y: us.irc.core::TaxableYear, prop_id: Text) kind empirical {
    label en official "regulations except the disposition from the application of the rules similar to paragraph (3)";
}
pub relation rules_similar_to_904f3_apply_to_disposition_904f5F(p: us.irc.core::Person, y: us.irc.core::TaxableYear, prop_id: Text) kind institutional {
    label en official "rules similar to paragraph (3) apply to a disposition of property if gain from it would be in the income category of a separate limitation loss allocated against separate limitation income of the year; the amount is not recomputed by category (the paragraph (3) amount reads the overall foreign loss balance)";
}
@source(IRC_S904_F, relation = formalizes, coverage = partial, quote = "If any separate limitation loss for any taxable year is allocated against any separate limitation income for")
rule S904F5FRulesSimilarToParagraphThree defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for prop_id: Text;
    for basket: ForeignTaxCreditBasket;
    for allocated: Money;
    when gain_on_disposition_in_category_904f5F(p, y, prop_id, basket)
     and separate_limitation_loss_allocated_to_basket_904f5B(p, y, basket, allocated)
     and allocated > 0.00 USD;
    unless regulations_except_disposition_from_904f5F(p, y, prop_id)
     and gain_on_disposition_in_category_904f5F(p, y, prop_id, basket)
     and separate_limitation_loss_allocated_to_basket_904f5B(p, y, basket, allocated);
    then rules_similar_to_904f3_apply_to_disposition_904f5F(p, y, prop_id);
}

// --- §904(g)(3), (g)(5): overall domestic loss ------------------------------------------------------

pub relation us_loss_previously_allocated_to_basket_904g3(p: us.irc.core::Person, y: us.irc.core::TaxableYear, basket: ForeignTaxCreditBasket, amount: Money) kind empirical {
    label en official "the loss from sources within the United States previously allocated to the income category";
}
pub relation total_us_loss_previously_allocated_904g3(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the sum over categories of the loss from sources within the United States previously allocated (asserted directly)";
}
pub relation us_income_treated_as_foreign_allocated_to_basket_904g3A(p: us.irc.core::Person, y: us.irc.core::TaxableYear, basket: ForeignTaxCreditBasket, amount: Money) kind institutional {
    label en official "income from sources within the United States treated as income from sources without the United States under paragraph (1) is allocated among and increases the income categories in proportion to the loss from sources within the United States previously allocated to them";
}
@source(IRC_S904_G, relation = formalizes, coverage = exact, quote = "Any income from sources within the United States that is treated as income from sources without the United")
rule S904G3AAllocationOfRecharacterizedIncomeToCategories defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for basket: ForeignTaxCreditBasket;
    for recharacterized: Money;
    for previous: Money;
    for total: Money;
    when overall_domestic_loss_recharacterized_amount(p, y, recharacterized)
     and us_loss_previously_allocated_to_basket_904g3(p, y, basket, previous)
     and total_us_loss_previously_allocated_904g3(p, y, total)
     and total > 0.00 USD;
    then us_income_treated_as_foreign_allocated_to_basket_904g3A(p, y, basket, div_round(recharacterized * (previous / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}
pub relation overall_domestic_loss_from_qualified_year_before_2018_904g5Bi(p: us.irc.core::Person, amount: Money) kind empirical {
    label en official "an overall domestic loss that arises in a qualified taxable year beginning before January 1, 2018";
}
pub relation overall_domestic_loss_used_before_2018_904g5Bii(p: us.irc.core::Person, used: Money) kind empirical {
    label en official "the part of that loss used under paragraph (1) for any taxable year beginning before January 1, 2018";
}
pub relation pre_2018_unused_overall_domestic_loss_904g5B(p: us.irc.core::Person, amount: Money) kind institutional {
    label en official "the pre-2018 unused overall domestic loss: the overall domestic loss arising in a qualified taxable year beginning before 2018 that was not used under paragraph (1) for a year beginning before that date";
}
@source(IRC_S904_G, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the term \"pre-2018 unused overall domestic loss\" means any overall domestic")
rule S904G5BPre2018UnusedOverallDomesticLoss defeasible {
    for p: us.irc.core::Person;
    for loss: Money;
    for used: Money;
    when overall_domestic_loss_from_qualified_year_before_2018_904g5Bi(p, loss)
     and overall_domestic_loss_used_before_2018_904g5Bii(p, used)
     and loss > used;
    then pre_2018_unused_overall_domestic_loss_904g5B(p, loss - used);
}
pub relation applicable_taxable_year_904g5C(y: us.irc.core::TaxableYear) kind institutional {
    label en official "a taxable year of the taxpayer beginning after December 31, 2017, and before January 1, 2028";
}
@source(IRC_S904_G, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the term \"applicable taxable year\" means any taxable year of the taxpayer")
rule S904G5CApplicableTaxableYear defeasible {
    for y: us.irc.core::TaxableYear;
    for begins_on: Date;
    when us.irc.core::begins(y, begins_on)
     and begins_on > @2017-12-31
     and begins_on < @2028-01-01;
    then applicable_taxable_year_904g5C(y);
}
pub relation elects_percentage_for_pre_2018_overall_domestic_loss_904g5A(p: us.irc.core::Person, y: us.irc.core::TaxableYear, percent: Decimal) kind empirical {
    label en official "the taxpayer elects to apply paragraph (1) to the pre-2018 unused overall domestic loss by substituting a percentage greater than 50 percent (but not greater than 100 percent) for 50 percent in subparagraph (B)";
}
pub relation pre_2018_election_conditions_met_904g5A(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the pre-2018 unused overall domestic loss is taken into account under paragraph (1) in an applicable taxable year, and the elected percentage is above 50 and not above 100";
}
@source(IRC_S904_G, relation = formalizes, coverage = exact, quote = "If any pre-2018 unused overall domestic loss is taken into account under paragraph (1) for any applicable")
rule S904G5AElectionConditions defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for percent: Decimal;
    for balance: Money;
    when elects_percentage_for_pre_2018_overall_domestic_loss_904g5A(p, y, percent)
     and pre_2018_unused_overall_domestic_loss_904g5B(p, balance)
     and applicable_taxable_year_904g5C(y)
     and percent > 50.0
     and percent <= 100.0;
    then pre_2018_election_conditions_met_904g5A(p, y);
}
pub relation overall_domestic_loss_percentage_substituted_904g5A(p: us.irc.core::Person, y: us.irc.core::TaxableYear, percent: Decimal) kind institutional {
    label en official "the substituted percentage applies in place of 50 percent in paragraph (1)(B) to the pre-2018 unused overall domestic loss for the year";
}
@source(IRC_S904_G, relation = formalizes, coverage = exact, quote = "If any pre-2018 unused overall domestic loss is taken into account under paragraph (1) for any applicable")
rule S904G5APercentageElectionPower defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for percent: Decimal;
    when elects_percentage_for_pre_2018_overall_domestic_loss_904g5A(p, y, percent);
    then power S904G5ElectionOfHigherPercentage {
        holder p;
        over p;
        exercise elects_percentage_for_pre_2018_overall_domestic_loss_904g5A(p, y, percent);
        valid_when pre_2018_election_conditions_met_904g5A(p, y);
        effect create(overall_domestic_loss_percentage_substituted_904g5A(p, y, percent));
    };
}
pub relation pre_2018_loss_recharacterized_amount_904g5(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the amount of the pre-2018 unused overall domestic loss recharacterized as foreign-source income for the year at the elected percentage of the taxpayer's United States source taxable income";
}
@source(IRC_S904_G, relation = formalizes, coverage = partial, quote = "If any pre-2018 unused overall domestic loss is taken into account under paragraph (1) for any applicable")
rule S904G5RecharacterizationAtElectedPercentage defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for percent: Decimal;
    for balance: Money;
    for us_source: Money;
    when overall_domestic_loss_percentage_substituted_904g5A(p, y, percent)
     and pre_2018_unused_overall_domestic_loss_904g5B(p, balance)
     and us_source_taxable_income_input(p, y, us_source);
    then pre_2018_loss_recharacterized_amount_904g5(p, y, min(balance, round(us_source * percent, 2, "HALF_UP")));
}

// --- §904(h)(2), (8), (9), (10): United States-owned foreign corporations -----------------------------

pub relation inclusion_from_us_owned_foreign_corporation_904h1A(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, inclusion_id: Text, amount: Money) kind empirical {
    label en official "an amount included in gross income under section 951(a) or section 1293 that is derived from a United States-owned foreign corporation and would otherwise be treated as from sources outside the United States";
}
pub relation inclusion_attributable_to_us_source_income_904h2(p: us.irc.core::Person, inclusion_id: Text, amount: Money) kind empirical {
    label en official "the part of the inclusion attributable to income of the United States-owned foreign corporation from sources within the United States";
}
pub relation us_source_part_of_inclusion_904h2(p: us.irc.core::Person, inclusion_id: Text, amount: Money) kind institutional {
    label en official "the part of a section 951(a) or 1293 inclusion treated as derived from sources within the United States: the amount attributable to United States source income of the corporation";
}
@source(IRC_S904_H, relation = formalizes, coverage = exact, quote = "Any amount described in subparagraph (A) of paragraph (1) shall be treated as derived from sources within the")
rule S904H2InclusionUsSourceToExtentAttributable defeasible {
    for p: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for inclusion_id: Text;
    for amount: Money;
    for attributable: Money;
    when united_states_owned_foreign_corporation_904h6(corp)
     and inclusion_from_us_owned_foreign_corporation_904h1A(p, corp, y, inclusion_id, amount)
     and inclusion_attributable_to_us_source_income_904h2(p, inclusion_id, attributable);
    then us_source_part_of_inclusion_904h2(p, inclusion_id, min(amount, attributable));
}
pub relation dividend_treated_as_not_us_source_under_861a2A_904h9(corp: us.irc.core::Corporation) kind empirical {
    label en official "a dividend paid by the corporation is treated as not from sources within the United States under section 861(a)(2)(A)";
}
@source(IRC_S904_H, relation = formalizes, coverage = exact, quote = "In the case of any dividend treated as not from sources within the United States under section 861(a)(2)(A),")
rule S904H9DomesticPayerTreatedAsUsOwnedForeignCorporation defeasible {
    for corp: us.irc.core::Corporation;
    when dividend_treated_as_not_us_source_under_861a2A_904h9(corp);
    then united_states_owned_foreign_corporation_904h6(corp);
}
pub relation amount_resourced_to_us_by_904h(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the total of the amounts re-sourced to the United States under section 904(h) for the year (asserted directly)";
}
pub relation foreign_source_taxable_income_after_904h_904h8(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the taxable income from sources without the United States after subsection (h) has been applied, which comes before subsection (f)";
}
@source(IRC_S904_H, relation = formalizes, coverage = exact, quote = "This subsection shall be applied before subsection (f).")
rule S904H8ForeignSourceIncomeAfterResourcing defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for foreign: Money;
    for resourced: Money;
    when foreign_source_taxable_income_input(p, y, foreign)
     and amount_resourced_to_us_by_904h(p, y, resourced);
    then foreign_source_taxable_income_after_904h_904h8(p, y, max(foreign - resourced, 0.00 USD));
}
pub relation overall_foreign_loss_recapture_amount_after_904h_904h8(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the section 904(f)(1) recapture computed on the foreign-source taxable income remaining after subsection (h) has been applied";
}
@source(IRC_S904_H, relation = formalizes, coverage = exact, quote = "This subsection shall be applied before subsection (f).")
rule S904H8RecaptureOnIncomeAfterResourcing defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for balance: Money;
    for after: Money;
    when unused_overall_foreign_loss_balance(p, y, balance)
     and foreign_source_taxable_income_after_904h_904h8(p, y, after);
    then overall_foreign_loss_recapture_amount_after_904h_904h8(p, y, min(balance, round(0.50 * after, 2, "HALF_UP")));
}
pub relation item_resourced_to_us_by_904h_904h10Ai(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text) kind empirical {
    label en official "an amount derived from the United States-owned foreign corporation would be treated as derived from sources within the United States under subsection (h) by reason of an item of income of the corporation";
}
pub relation treaty_treats_item_as_foreign_source_904h10Aii(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text) kind empirical {
    label en official "under a treaty obligation of the United States (without regard to subsection (h), treating a section 951(a)(1) amount as a dividend) the amount would be treated as arising from sources outside the United States";
}
pub relation each_tiered_corporation_dividend_treaty_foreign_source_904h10B(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "dividends paid by each corporation whose stock is taken into account in determining United States shareholder status in the United States-owned foreign corporation, if paid to the United States shareholder, would be treated under a treaty as arising from sources outside the United States (without regard to subsection (h))";
}
pub relation inclusion_951a1_treated_as_dividend_for_treaty_test_904h10B(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "amounts included under section 951(a)(1) are treated as a dividend under subparagraph (A)(ii) only if the tiered-corporation dividend condition of subparagraph (B) is met";
}
@source(IRC_S904_H, relation = formalizes, coverage = exact, quote = "Amounts included in gross income under section 951(a)(1) shall be treated as a dividend under subparagraph")
rule S904H10BSpecialRuleForSection951Inclusions defeasible {
    for p: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when each_tiered_corporation_dividend_treaty_foreign_source_904h10B(p, corp, y);
    then inclusion_951a1_treated_as_dividend_for_treaty_test_904h10B(p, corp, y);
}
pub relation taxpayer_chooses_904h10A_benefits(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text) kind empirical {
    label en official "the taxpayer chooses the benefits of paragraph (10)";
}
pub relation treaty_coordination_conditions_met_904h10A(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text) kind institutional {
    label en official "conditions (i) and (ii) of subparagraph (A) are met for the item";
}
@source(IRC_S904_H, relation = formalizes, coverage = exact, quote = "(ii) under a treaty obligation of the United States (applied without regard to this subsection and by")
rule S904H10AConditionsIAndII defeasible {
    for p: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    when item_resourced_to_us_by_904h_904h10Ai(p, corp, y, item_id)
     and treaty_treats_item_as_foreign_source_904h10Aii(p, corp, y, item_id);
    then treaty_coordination_conditions_met_904h10A(p, corp, y, item_id);
}
pub relation subsection_904h_disapplied_to_item_904h10A(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text) kind institutional {
    label en official "subsection (h) does not apply to the amount to the extent attributable to the item of income";
}
pub relation separate_application_904_907_960_to_item_904h10A(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text) kind institutional {
    label en official "subsections (a), (b) and (c) of section 904 and sections 907 and 960 are applied separately with respect to the amount to the extent attributable to the item";
}
@source(IRC_S904_H, relation = formalizes, coverage = exact, quote = "(iii) the taxpayer chooses the benefits of this paragraph,")
rule S904H10ATreatyElectionPower defeasible {
    for p: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    when taxpayer_chooses_904h10A_benefits(p, corp, y, item_id);
    then power S904H10ATreatyBenefitsChoice {
        holder p;
        over p;
        exercise taxpayer_chooses_904h10A_benefits(p, corp, y, item_id);
        valid_when treaty_coordination_conditions_met_904h10A(p, corp, y, item_id);
        effect create(subsection_904h_disapplied_to_item_904h10A(p, corp, y, item_id));
    };
}
@source(IRC_S904_H, relation = formalizes, coverage = exact, quote = "this subsection shall not apply to such amount to the extent attributable to such item of income (but")
rule S904H10ASeparateApplication defeasible {
    for p: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    when subsection_904h_disapplied_to_item_904h10A(p, corp, y, item_id);
    then separate_application_904_907_960_to_item_904h10A(p, corp, y, item_id);
}

// --- §904(j)(1)(B)-(C): no carryover for the de minimis individual --------------------------------

pub relation no_credit_carryover_to_or_from_year_904j1BC(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind institutional {
    label en official "no taxes paid or accrued during the year may be deemed paid in another year under subsection (c), and no taxes of another year may be deemed paid in this year";
}
@source(IRC_S904_J, relation = formalizes, coverage = exact, quote = "(B) no taxes paid or accrued by the individual during such taxable year may be deemed paid or accrued under")
rule S904J1BCNoCarryoverForDeMinimisIndividual defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    when section_904j_applies_to_individual(p, y);
    then no_credit_carryover_to_or_from_year_904j1BC(p, y);
}

// --- §904(b)(2)(B)(iii): foreign net capital loss in a rate differential year -----------------------

pub relation net_capital_gain_from_within_us_904b3(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "net capital gain from sources within the United States";
}
pub relation foreign_net_capital_loss_taken_into_account_904b2Biii(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "any net capital loss (and any short-term capital loss under section 1212(a)) from sources outside the United States to the extent taken into account in determining capital gain net income for the year";
}
pub relation rate_differential_portion_of_us_excess_net_capital_gain_904b3E(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the rate differential portion of the excess of net capital gain from sources within the United States over net capital gain (section 904(b)(3)(E))";
}
@source(IRC_S904_B, relation = formalizes, coverage = partial, quote = "The rate differential portion of foreign source net capital gain, net capital gain, or the excess of net capital gain from sources within the United States over net capital gain, as the case may be, is the same proportion of such amount as—")
rule S904B3ERateDifferentialPortionUsExcess defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for us_gain: Money;
    for total: Money;
    for top: Decimal;
    for alt: Decimal;
    when capital_gain_rate_differential_year_904b3D(p, y)
     and net_capital_gain_from_within_us_904b3(p, y, us_gain)
     and net_capital_gain_904b3(p, y, total)
     and highest_section_1_rate_904b3E(p, y, top)
     and alternative_rate_1h_904b3E(p, y, alt)
     and us_gain > total
     and top > 0.0;
    then rate_differential_portion_of_us_excess_net_capital_gain_904b3E(p, y, round((us_gain - total) * ((top - alt) / top), 2, "HALF_UP"));
}
pub relation foreign_net_capital_loss_reduced_904b2Biii(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the foreign source net capital loss for determining taxable income from sources outside the United States, reduced by the rate differential portion of the excess of United States source net capital gain over net capital gain";
}
@source(IRC_S904_B, relation = formalizes, coverage = exact, quote = "(iii) for purposes of determining taxable income from sources outside the United States, any net capital loss")
rule S904B2BiiiForeignNetCapitalLossReduced defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for loss: Money;
    for portion: Money;
    when foreign_net_capital_loss_taken_into_account_904b2Biii(p, y, loss)
     and rate_differential_portion_of_us_excess_net_capital_gain_904b3E(p, y, portion);
    then foreign_net_capital_loss_reduced_904b2Biii(p, y, max(loss - portion, 0.00 USD));
}

// --- §982(c)(2)(C): the 90-day period suspended while a quash proceeding is pending -----------------------
//
// The end DATE of the extended period needs `add_calendar_period` with a variable
// day count (the count must be a literal), so it stays a technical gap (G1757, the
// date part). The consequence needs no end date: the period has run when the days
// elapsed since the mailing, less the days a quash proceeding was pending, exceed 90.

@source(IRC_S982_C, relation = formalizes, coverage = partial, quote = "The running of the 90-day period referred to in subsection (a) shall be suspended during any period during which a proceeding brought under subparagraph (A) is pending.")
rule S982C2CFailureToComplyAfterSuspendedPeriod defeasible {
    for taxpayer: us.irc.core::Person;
    for request_id: Text;
    for on: Date;
    for mailed_on: Date;
    for pending: Integer;
    when formal_document_request_mailed_982c1(taxpayer, request_id, mailed_on)
     and compliance_test_date_982(taxpayer, request_id, on)
     and quash_proceeding_pending_days_982c2C(taxpayer, request_id, pending)
     and (days_between(mailed_on, on) - pending) > 90;
    unless taxpayer_substantially_complied_with_request_982a(taxpayer, request_id)
     and compliance_test_date_982(taxpayer, request_id, on)
     and formal_document_request_mailed_982c1(taxpayer, request_id, mailed_on)
     and quash_proceeding_pending_days_982c2C(taxpayer, request_id, pending);
    unless reasonable_cause_for_failure_982b1(taxpayer, request_id)
     and compliance_test_date_982(taxpayer, request_id, on)
     and formal_document_request_mailed_982c1(taxpayer, request_id, mailed_on)
     and quash_proceeding_pending_days_982c2C(taxpayer, request_id, pending);
    then failure_to_comply_982a(taxpayer, request_id, on);
}

// --- §982(c)(2)(A), (e): the right to quash and the suspension of the limitation periods -----------------

pub relation quash_proceeding_brought_982c2A(taxpayer: us.irc.core::Person, request_id: Text) kind institutional {
    label en official "the person to whom a formal document request was mailed has begun a proceeding to quash the request (the Secretary may seek to compel compliance in it)";
}
pub relation quash_begun_within_90_days_982c2A(taxpayer: us.irc.core::Person, request_id: Text) kind institutional {
    label en official "the proceeding to quash was begun not later than the 90th day after the day the request was mailed";
}
@source(IRC_S982_C, relation = formalizes, coverage = exact, quote = "Notwithstanding any other law or rule of law, any person to whom a formal document request is mailed shall")
rule S982C2AQuashBegunWithinNinetyDays defeasible {
    for taxpayer: us.irc.core::Person;
    for request_id: Text;
    for mailed_on: Date;
    for begun_on: Date;
    when formal_document_request_mailed_982c1(taxpayer, request_id, mailed_on)
     and quash_proceeding_begun_982c2(taxpayer, request_id, begun_on)
     and days_between(mailed_on, begun_on) <= 90;
    then quash_begun_within_90_days_982c2A(taxpayer, request_id);
}
@source(IRC_S982_C, relation = formalizes, coverage = exact, quote = "Notwithstanding any other law or rule of law, any person to whom a formal document request is mailed shall")
rule S982C2ARightToBeginProceedingToQuash defeasible {
    for taxpayer: us.irc.core::Person;
    for request_id: Text;
    for begun_on: Date;
    when quash_proceeding_begun_982c2(taxpayer, request_id, begun_on);
    then power S982C2AProceedingToQuash {
        holder taxpayer;
        over taxpayer;
        exercise quash_proceeding_begun_982c2(taxpayer, request_id, begun_on);
        valid_when quash_begun_within_90_days_982c2A(taxpayer, request_id);
        effect create(quash_proceeding_brought_982c2A(taxpayer, request_id));
    };
}
pub relation quash_proceeding_and_appeals_pending_days_982e(taxpayer: us.irc.core::Person, request_id: Text, days: Integer) kind empirical {
    label en official "the number of days during which the proceeding to quash, and appeals in it, are pending";
}
pub relation limitation_periods_6501_6531_suspended_982e(taxpayer: us.irc.core::Person, request_id: Text, days: Integer) kind institutional {
    label en official "the running of any period of limitations under section 6501 (assessment and collection) or 6531 (criminal prosecution) with respect to the person is suspended for the period during which the proceeding and appeals in it are pending";
}
@source(IRC_S982_E, relation = formalizes, coverage = exact, quote = "If any person takes any action as provided in subsection (c)(2), the running of any period of limitations")
rule S982ELimitationPeriodsSuspendedWhilePending defeasible {
    for taxpayer: us.irc.core::Person;
    for request_id: Text;
    for days: Integer;
    when quash_proceeding_brought_982c2A(taxpayer, request_id)
     and quash_proceeding_and_appeals_pending_days_982e(taxpayer, request_id, days)
     and days > 0;
    then limitation_periods_6501_6531_suspended_982e(taxpayer, request_id, days);
}
