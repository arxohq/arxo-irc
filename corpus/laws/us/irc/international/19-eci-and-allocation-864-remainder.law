// §864 remainder — (a) the term "produced"; (b)(2)(B)(iii) the commodity
// exchange condition; (c)(4)-(8) foreign-source ECI, attribution to an
// office, timing rules and the partnership-interest sale rule; (d) related-
// person factoring income; (e) interest allocation for an affiliated group
// (adjusted-basis method, tax-exempt assets, stock-basis E&P adjustment,
// the affiliated-group definition); (g) research and experimental
// expenditures. Stage 2c (IRC-10 stage 2c, A13).
//
// Not modeled here (TECH-GAPS G1730-G1735): the regulatory allocation of
// interest by the fair-market-value alternative (the statute fixes the basis
// method; the direct-allocation exceptions of (e)(7) are Secretary
// regulations), the (g)(4) possession-corporation adjustments, the (c)(8)
// deemed-sale distributive-share computation.

// --- §864(a): "produced" ---------------------------------------------------

use self::{
    IRC_S864_A,
    IRC_S864_B,
    IRC_S864_C,
    IRC_S864_D,
    IRC_S864_E,
    IRC_S864_G,
    effectively_connected,
    nonresident_alien_or_foreign_corp,
    trading_for_own_account,
    trading_through_independent_agent,
};

pub relation activity_kind_864a(activity_id: Text, kind: Text) kind empirical {
    label en official "the activity with respect to property is of the named kind: created, fabricated, manufactured, extracted, processed, cured or aged (section 864(a))";
}
pub relation activity_is_production_864a(activity_id: Text) kind institutional {
    label en official "the activity is `production` for purposes of part I: for purposes of this part, the term `produced` includes created, fabricated, manufactured, extracted, processed, cured, or aged (section 864(a))";
}
@source(IRC_S864_A, relation = formalizes, coverage = exact, quote = "For purposes of this part, the term \"produced\" includes created, fabricated, manufactured, extracted, processed, cured, or aged.")
rule S864AProducedCreated defeasible {
    for a: Text;
    when activity_kind_864a(a, "created");
    then activity_is_production_864a(a);
}
@source(IRC_S864_A, relation = formalizes, coverage = exact, quote = "For purposes of this part, the term \"produced\" includes created, fabricated, manufactured, extracted, processed, cured, or aged.")
rule S864AProducedFabricated defeasible {
    for a: Text;
    when activity_kind_864a(a, "fabricated");
    then activity_is_production_864a(a);
}
@source(IRC_S864_A, relation = formalizes, coverage = exact, quote = "For purposes of this part, the term \"produced\" includes created, fabricated, manufactured, extracted, processed, cured, or aged.")
rule S864AProducedManufactured defeasible {
    for a: Text;
    when activity_kind_864a(a, "manufactured");
    then activity_is_production_864a(a);
}
@source(IRC_S864_A, relation = formalizes, coverage = exact, quote = "For purposes of this part, the term \"produced\" includes created, fabricated, manufactured, extracted, processed, cured, or aged.")
rule S864AProducedExtracted defeasible {
    for a: Text;
    when activity_kind_864a(a, "extracted");
    then activity_is_production_864a(a);
}
@source(IRC_S864_A, relation = formalizes, coverage = exact, quote = "For purposes of this part, the term \"produced\" includes created, fabricated, manufactured, extracted, processed, cured, or aged.")
rule S864AProducedProcessed defeasible {
    for a: Text;
    when activity_kind_864a(a, "processed");
    then activity_is_production_864a(a);
}
@source(IRC_S864_A, relation = formalizes, coverage = exact, quote = "For purposes of this part, the term \"produced\" includes created, fabricated, manufactured, extracted, processed, cured, or aged.")
rule S864AProducedCured defeasible {
    for a: Text;
    when activity_kind_864a(a, "cured");
    then activity_is_production_864a(a);
}
@source(IRC_S864_A, relation = formalizes, coverage = exact, quote = "For purposes of this part, the term \"produced\" includes created, fabricated, manufactured, extracted, processed, cured, or aged.")
rule S864AProducedAged defeasible {
    for a: Text;
    when activity_kind_864a(a, "aged");
    then activity_is_production_864a(a);
}

// --- §864(b)(2)(B)(iii): the commodity-exchange condition --------------------
//
// Clauses (i) and (ii) of (B) "apply only if" the commodities are of a kind
// customarily dealt in on an organized commodity exchange AND the
// transaction is of a kind customarily consummated at such place. The
// securities safe harbor of (A) has no such condition, so the condition
// helper below is satisfied automatically for the kind "securities" and
// needs the two positive facts for "commodities". Module 02's two safe-
// harbor rules read this helper.

pub relation commodity_of_kind_customarily_dealt_in_on_exchange_864b2(p: us.irc.core::Person) kind empirical {
    label en official "the commodities are of a kind customarily dealt in on an organized commodity exchange, for section 864(b)(2)(B)(iii)";
}
pub relation transaction_of_kind_customarily_consummated_on_exchange_864b2(p: us.irc.core::Person) kind empirical {
    label en official "the transaction is of a kind customarily consummated at such place (an organized commodity exchange), for section 864(b)(2)(B)(iii)";
}
pub relation trading_kind_condition_met_864b2(p: us.irc.core::Person, kind: Text) kind institutional {
    label en official "the kind-specific condition of the section 864(b)(2) safe harbor is met: none for stocks or securities; for commodities, the customary-exchange condition of (B)(iii)";
}
@source(IRC_S864_B, relation = formalizes, coverage = exact, quote = "Clauses (i) and (ii) shall apply only if the commodities are of a kind customarily dealt in on an organized commodity exchange and if the transaction is of a kind customarily consummated at such place.")
rule S864B2BiiiCommoditiesCustomaryCondition defeasible {
    for p: us.irc.core::Person;
    when commodity_of_kind_customarily_dealt_in_on_exchange_864b2(p)
     and transaction_of_kind_customarily_consummated_on_exchange_864b2(p);
    then trading_kind_condition_met_864b2(p, "commodities");
}
@source(IRC_S864_B, relation = formalizes, coverage = partial, quote = "the term \"trade or business within the United States\" includes the performance of personal services within the United States at any time within the taxable year, but does not include—")
rule S864B2ASecuritiesNoCustomaryCondition defeasible {
    for p: us.irc.core::Person;
    when trading_through_independent_agent(p, "securities");
    then trading_kind_condition_met_864b2(p, "securities");
}
@source(IRC_S864_B, relation = formalizes, coverage = partial, quote = "the term \"trade or business within the United States\" includes the performance of personal services within the United States at any time within the taxable year, but does not include—")
rule S864B2ASecuritiesOwnAccountNoCustomaryCondition defeasible {
    for p: us.irc.core::Person;
    when trading_for_own_account(p, "securities");
    then trading_kind_condition_met_864b2(p, "securities");
}

// --- §864(c)(4): income from sources without the United States -------------

pub relation person_has_us_office_to_which_attributable_864c4(p: us.irc.core::Person, item_id: Text) kind empirical {
    label en official "the nonresident alien individual or foreign corporation has an office or other fixed place of business within the United States to which the item is attributable, for section 864(c)(4)(B)";
}
pub relation foreign_source_item_864c(p: us.irc.core::Person, item_id: Text) kind empirical {
    label en unofficial "the item of income, gain or loss is from sources without the United States, for section 864(c)(4)";
}
pub relation item_is_intangible_rent_or_royalty_active_864c4Bi(item_id: Text) kind empirical {
    label en official "the item consists of rents or royalties for the use of intangible property described in section 862(a)(4), derived in the active conduct of the trade or business — section 864(c)(4)(B)(i)";
}
pub relation item_is_banking_financing_income_864c4Bii(item_id: Text) kind empirical {
    label en official "the item consists of dividends, interest or guarantee amounts and is derived in the active conduct of a banking, financing or similar business within the United States, or is received by a corporation whose principal business is trading in stocks or securities for its own account — section 864(c)(4)(B)(ii)";
}
pub relation item_is_inventory_sale_through_us_office_864c4Biii(item_id: Text) kind empirical {
    label en official "the item is derived from the sale or exchange (outside the United States) through the US office of personal property described in section 1221(a)(1) — section 864(c)(4)(B)(iii)";
}
pub relation inventory_sold_for_foreign_use_with_foreign_office_participation_864c4Biii(item_id: Text) kind empirical {
    label en official "the inventory is sold or exchanged for use, consumption or disposition outside the United States and a foreign office of the taxpayer participated materially in the sale — the exception in section 864(c)(4)(B)(iii)";
}
pub relation item_equivalent_to_864c4B_item(item_id: Text) kind empirical {
    label en official "the income or gain is equivalent to an item of income or gain described in section 864(c)(4)(B)(i), (ii) or (iii) and is treated in the same manner (last sentence of subparagraph (B)); the equivalence is a characterization of the item asserted by the case";
}
pub relation foreign_corp_taxable_under_subchapter_l_864c4C(p: us.irc.core::Person) kind empirical {
    label en official "the foreign corporation is taxable under part I or part II of subchapter L (insurance company), for section 864(c)(4)(C)";
}
pub relation item_attributable_to_us_business_of_insurer_864c4C(item_id: Text) kind empirical {
    label en official "the foreign-source income is attributable to the foreign insurance corporation's United States business, for section 864(c)(4)(C)";
}
pub relation dividend_interest_royalty_from_more_than_50_percent_owned_foreign_corp_864c4Di(item_id: Text) kind empirical {
    label en official "the item consists of dividends, interest or royalties paid by a foreign corporation in which the taxpayer owns (section 958(a)) or is considered as owning (section 958(b)) more than 50 percent of the total combined voting power, for section 864(c)(4)(D)(i)";
}
pub relation item_is_subpart_f_income_864c4Dii(item_id: Text) kind empirical {
    label en official "the item is subpart F income within the meaning of section 952(a), for section 864(c)(4)(D)(ii)";
}

pub relation foreign_source_item_not_eci_864c4A(p: us.irc.core::Person, item_id: Text) kind institutional {
    label en official "no income, gain or loss from sources without the United States is treated as effectively connected with a United States trade or business (section 864(c)(4)(A) general rule, before the (B) and (C) exceptions)";
}
pub relation foreign_source_eci_864c4(p: us.irc.core::Person, item_id: Text) kind institutional {
    label en official "foreign-source income, gain or loss treated as effectively connected with the conduct of a trade or business within the United States under section 864(c)(4)(B) or (C), and not excluded by (D)";
}
pub relation foreign_source_eci_candidate_864c4B(p: us.irc.core::Person, item_id: Text) kind institutional {
    label en official "an item satisfying section 864(c)(4)(B): a US office to which it is attributable and one of clauses (i)-(iii), or equivalent income";
}
pub relation foreign_source_eci_candidate_864c4C(p: us.irc.core::Person, item_id: Text) kind institutional {
    label en official "an item satisfying section 864(c)(4)(C): foreign-source income attributable to the US business of a foreign insurer taxable under subchapter L";
}
pub relation section_864c4D_excludes(item_id: Text) kind institutional {
    label en official "section 864(c)(4)(D) excludes the item: a dividend, interest or royalty from a more-than-50-percent controlled foreign corporation, or subpart F income";
}
rule S864C4DControlledCorporationPayments defeasible {
    for item_id: Text;
    when dividend_interest_royalty_from_more_than_50_percent_owned_foreign_corp_864c4Di(item_id);
    then section_864c4D_excludes(item_id);
}
rule S864C4DSubpartFIncome defeasible {
    for item_id: Text;
    when item_is_subpart_f_income_864c4Dii(item_id);
    then section_864c4D_excludes(item_id);
}
@source(IRC_S864_C, relation = formalizes, coverage = partial, quote = "(B) Income, gain, or loss from sources without the United States shall be treated as effectively connected with the conduct of a trade or business within the United States by a nonresident alien individual or a foreign corporation if such person has an office or other fixed place of business within the United States to which such income, gain, or loss is attributable and such income, gain, or loss—")
rule S864C4BiIntangibleRentsRoyalties defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    when nonresident_alien_or_foreign_corp(p)
     and foreign_source_item_864c(p, item_id)
     and person_has_us_office_to_which_attributable_864c4(p, item_id)
     and item_is_intangible_rent_or_royalty_active_864c4Bi(item_id);
    then foreign_source_eci_candidate_864c4B(p, item_id);
}
@source(IRC_S864_C, relation = formalizes, coverage = partial, quote = "(ii) consists of dividends, interest, or amounts received for the provision of guarantees of indebtedness, and either is derived in the active conduct of a banking, financing, or similar business within the United States or is received by a corporation the principal business of which is trading in stocks or securities for its own account; or")
rule S864C4BiiBankingFinancingIncome defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    when nonresident_alien_or_foreign_corp(p)
     and foreign_source_item_864c(p, item_id)
     and person_has_us_office_to_which_attributable_864c4(p, item_id)
     and item_is_banking_financing_income_864c4Bii(item_id);
    then foreign_source_eci_candidate_864c4B(p, item_id);
}
@source(IRC_S864_C, relation = formalizes, coverage = exact, quote = "(iii) is derived from the sale or exchange (outside the United States) through such office or other fixed place of business of personal property described in section 1221(a)(1), except that this clause shall not apply if the property is sold or exchanged for use, consumption, or disposition outside the United States and an office or other fixed place of business of the taxpayer in a foreign country participated materially in such sale.")
rule S864C4BiiiInventorySaleThroughUsOffice defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    when nonresident_alien_or_foreign_corp(p)
     and foreign_source_item_864c(p, item_id)
     and person_has_us_office_to_which_attributable_864c4(p, item_id)
     and item_is_inventory_sale_through_us_office_864c4Biii(item_id);
    unless inventory_sold_for_foreign_use_with_foreign_office_participation_864c4Biii(item_id)
     and item_is_inventory_sale_through_us_office_864c4Biii(item_id)
     and person_has_us_office_to_which_attributable_864c4(p, item_id);
    then foreign_source_eci_candidate_864c4B(p, item_id);
}
@source(IRC_S864_C, relation = formalizes, coverage = partial, quote = "Any income or gain which is equivalent to any item of income or gain described in clause (i), (ii), or (iii) shall be treated in the same manner as such item for purposes of this subparagraph.")
rule S864C4BEquivalentIncome defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    when nonresident_alien_or_foreign_corp(p)
     and foreign_source_item_864c(p, item_id)
     and person_has_us_office_to_which_attributable_864c4(p, item_id)
     and item_equivalent_to_864c4B_item(item_id);
    then foreign_source_eci_candidate_864c4B(p, item_id);
}
@source(IRC_S864_C, relation = formalizes, coverage = exact, quote = "(C) In the case of a foreign corporation taxable under part I or part II of subchapter L, any income from sources without the United States which is attributable to its United States business shall be treated as effectively connected with the conduct of a trade or business within the United States.")
rule S864C4CForeignInsurerUsBusiness defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    when foreign_corp_taxable_under_subchapter_l_864c4C(p)
     and foreign_source_item_864c(p, item_id)
     and item_attributable_to_us_business_of_insurer_864c4C(item_id);
    then foreign_source_eci_candidate_864c4C(p, item_id);
}
@source(IRC_S864_C, relation = formalizes, coverage = exact, quote = "(D) No income from sources without the United States shall be treated as effectively connected with the conduct of a trade or business within the United States if it either—")
rule S864C4BExceptionUnlessDExcludes defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    when foreign_source_eci_candidate_864c4B(p, item_id);
    unless section_864c4D_excludes(item_id)
     and foreign_source_eci_candidate_864c4B(p, item_id);
    then foreign_source_eci_864c4(p, item_id);
}
rule S864C4CExceptionUnlessDExcludes defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    when foreign_source_eci_candidate_864c4C(p, item_id);
    unless section_864c4D_excludes(item_id)
     and foreign_source_eci_candidate_864c4C(p, item_id);
    then foreign_source_eci_864c4(p, item_id);
}
@source(IRC_S864_C, relation = formalizes, coverage = exact, quote = "(A) Except as provided in subparagraphs (B) and (C), no income, gain, or loss from sources without the United States shall be treated as effectively connected with the conduct of a trade or business within the United States.")
rule S864C4AGeneralNoForeignSourceEci defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    when foreign_source_item_864c(p, item_id)
     and nonresident_alien_or_foreign_corp(p);
    unless foreign_source_eci_candidate_864c4B(p, item_id)
     and foreign_source_item_864c(p, item_id);
    unless foreign_source_eci_candidate_864c4C(p, item_id)
     and foreign_source_item_864c(p, item_id);
    then foreign_source_item_not_eci_864c4A(p, item_id);
}
rule S864C4ForeignSourceEciIsEffectivelyConnected defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    when foreign_source_eci_864c4(p, item_id);
    then effectively_connected(p, item_id);
}

// --- §864(c)(5): office or other fixed place of business --------------------

pub relation agent_office_of_person_864c5(p: us.irc.core::Person, agent: us.irc.core::Person) kind empirical {
    label en unofficial "the agent maintains an office or other fixed place of business for the principal, for section 864(c)(5)(A)";
}
pub relation agent_has_and_regularly_exercises_contract_authority_864c5A(agent: us.irc.core::Person) kind empirical {
    label en official "the agent has authority to negotiate and conclude contracts in the name of the principal and regularly exercises that authority, for section 864(c)(5)(A)(i)";
}
pub relation agent_regularly_fills_orders_from_stock_864c5A(agent: us.irc.core::Person) kind empirical {
    label en official "the agent has a stock of merchandise from which the agent regularly fills orders on behalf of the principal, for section 864(c)(5)(A)(i)";
}
pub relation agent_is_independent_broker_or_agent_864c5A(agent: us.irc.core::Person) kind empirical {
    label en unofficial "the agent is a broker or general commission agent of independent status acting in the ordinary course (the disregard exception in the last words of section 864(c)(5)(A)); the agent's independent status is a case characterization";
}
pub relation agent_office_counts_as_principal_office_864c5A(p: us.irc.core::Person, agent: us.irc.core::Person) kind institutional {
    label en official "the agent's office or other fixed place of business is taken into account as the principal's office for section 864(c)(4)(B) (not disregarded under section 864(c)(5)(A))";
}
@source(IRC_S864_C, relation = formalizes, coverage = partial, quote = "(A) in determining whether a nonresident alien individual or a foreign corporation has an office or other fixed place of business, an office or other fixed place of business of an agent shall be disregarded unless such agent (i) has the authority to negotiate and conclude contracts in the name of the nonresident alien individual or foreign corporation and regularly exercises that authority or has a stock of merchandise from which he regularly fills orders on behalf of such individual or foreign")
rule S864C5AAgentOfficeContractAuthority defeasible {
    for p: us.irc.core::Person;
    for agent: us.irc.core::Person;
    when agent_office_of_person_864c5(p, agent)
     and agent_has_and_regularly_exercises_contract_authority_864c5A(agent);
    unless agent_is_independent_broker_or_agent_864c5A(agent)
     and agent_office_of_person_864c5(p, agent);
    then agent_office_counts_as_principal_office_864c5A(p, agent);
}
@source(IRC_S864_C, relation = formalizes, coverage = partial, quote = "(A) in determining whether a nonresident alien individual or a foreign corporation has an office or other fixed place of business, an office or other fixed place of business of an agent shall be disregarded unless such agent (i) has the authority to negotiate and conclude contracts in the name of the nonresident alien individual or foreign corporation and regularly exercises that authority or has a stock of merchandise from which he regularly fills orders on behalf of such individual or foreign")
rule S864C5AAgentOfficeStockOfMerchandise defeasible {
    for p: us.irc.core::Person;
    for agent: us.irc.core::Person;
    when agent_office_of_person_864c5(p, agent)
     and agent_regularly_fills_orders_from_stock_864c5A(agent);
    unless agent_is_independent_broker_or_agent_864c5A(agent)
     and agent_office_of_person_864c5(p, agent);
    then agent_office_counts_as_principal_office_864c5A(p, agent);
}

pub relation office_is_material_factor_in_production_864c5B(p: us.irc.core::Person, item_id: Text) kind empirical {
    label en official "the US office or fixed place of business is a material factor in the production of the income, gain or loss, for section 864(c)(5)(B) (a characterization of the record; the statute prescribes no arithmetic test)";
}
pub relation office_regularly_carries_on_activities_of_that_type_864c5B(p: us.irc.core::Person, item_id: Text) kind empirical {
    label en official "the US office or fixed place of business regularly carries on activities of the type from which the income, gain or loss is derived, for section 864(c)(5)(B)";
}
pub relation item_attributable_to_us_office_864c5B(p: us.irc.core::Person, item_id: Text) kind institutional {
    label en official "the income, gain or loss is considered attributable to an office or other fixed place of business within the United States (section 864(c)(5)(B): the office is a material factor and regularly carries on activities of the type)";
}
@source(IRC_S864_C, relation = formalizes, coverage = partial, quote = "(B) income, gain, or loss shall not be considered as attributable to an office or other fixed place of business within the United States unless such office or fixed place of business is a material factor in the production of such income, gain, or loss and such office or fixed place of business regularly carries on activities of the type from which such income, gain, or loss is derived, and")
rule S864C5BAttributableOnlyIfMaterialFactorAndRegularActivities defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    when office_is_material_factor_in_production_864c5B(p, item_id)
     and office_regularly_carries_on_activities_of_that_type_864c5B(p, item_id);
    then item_attributable_to_us_office_864c5B(p, item_id);
}
// (C) last clause: for a clause-(iii) inventory sale the income treated as
// attributable to the US office cannot exceed the income which would be
// derived from sources within the United States if the sale were treated as
// made in the United States.
pub relation income_allocable_to_us_office_864c5C(p: us.irc.core::Person, item_id: Text, amount: Money) kind empirical {
    label en official "the income allocable to the US office or fixed place of business, for section 864(c)(5)(C)";
}
pub relation income_if_sale_treated_as_us_source_864c5C(p: us.irc.core::Person, item_id: Text, amount: Money) kind empirical {
    label en official "the income which would be derived from sources within the United States if the clause (iii) sale were treated as having been made in the United States — the ceiling of the last clause of section 864(c)(5)(C)";
}
pub relation income_attributed_to_us_office_864c5C(p: us.irc.core::Person, item_id: Text, amount: Money) kind institutional {
    label en official "the income, gain or loss attributed to the US office under section 864(c)(5)(C): the amount allocable to it, capped for a clause (iii) sale at the income that would be US-source if the sale had been made in the United States";
}
@source(IRC_S864_C, relation = formalizes, coverage = partial, quote = "(C) the income, gain, or loss which shall be attributable to an office or other fixed place of business within the United States shall be the income, gain, or loss property allocable thereto")
rule S864C5CAttributedIncomeGeneral defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    for allocable: Money;
    when income_allocable_to_us_office_864c5C(p, item_id, allocable);
    unless item_is_inventory_sale_through_us_office_864c4Biii(item_id)
     and income_allocable_to_us_office_864c5C(p, item_id, allocable);
    then income_attributed_to_us_office_864c5C(p, item_id, allocable);
}
@source(IRC_S864_C, relation = formalizes, coverage = partial, quote = "(C) the income, gain, or loss which shall be attributable to an office or other fixed place of business within the United States shall be the income, gain, or loss property allocable thereto")
rule S864C5CAttributedIncomeCappedForInventorySale defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    for allocable: Money;
    for ceiling: Money;
    when income_allocable_to_us_office_864c5C(p, item_id, allocable)
     and item_is_inventory_sale_through_us_office_864c4Biii(item_id)
     and income_if_sale_treated_as_us_source_864c5C(p, item_id, ceiling);
    then income_attributed_to_us_office_864c5C(p, item_id, min(allocable, ceiling));
}

// --- §864(c)(6): income attributable to another taxable year ---------------

pub relation income_taken_into_account_in_year_but_attributable_to_other_year_864c6(p: us.irc.core::Person, item_id: Text, taken_year: us.irc.core::TaxableYear, other_year: us.irc.core::TaxableYear) kind empirical {
    label en official "income or gain of a nonresident alien individual or foreign corporation taken into account for one taxable year but attributable to a sale, exchange, services or other transaction in another taxable year (section 864(c)(6)(A)-(B))";
}
pub relation engaged_in_us_trade_or_business_in_year_864c(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the person was engaged in a trade or business within the United States during the given taxable year";
}
pub relation deferred_item_would_be_eci_in_other_year_864c6(p: us.irc.core::Person, item_id: Text) kind empirical {
    label en official "the item, other than the trade-or-business requirement, would be effectively connected income taxable under section 871(b) or 882 if taken into account in the other taxable year — the substantive ECI characterization asserted for the attribution year";
}
pub relation eci_by_attribution_to_other_year_864c6(p: us.irc.core::Person, item_id: Text) kind institutional {
    label en official "the item is taxable under section 871(b) or 882 by attribution to the other taxable year, without regard to whether the taxpayer is engaged in a US trade or business in the year taken into account (section 864(c)(6))";
}
@source(IRC_S864_C, relation = formalizes, coverage = partial, quote = "the determination of whether such income or gain is taxable under section 871(b) or 882 (as the case may be) shall be made as if such income or gain were taken into account in such other taxable year and without regard to the requirement that the taxpayer be engaged in a trade or business within the United States during the taxable year referred to in subparagraph (A).")
rule S864C6DeferredIncomeTestedInAttributionYear defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    for taken: us.irc.core::TaxableYear;
    for other: us.irc.core::TaxableYear;
    when nonresident_alien_or_foreign_corp(p)
     and income_taken_into_account_in_year_but_attributable_to_other_year_864c6(p, item_id, taken, other)
     and engaged_in_us_trade_or_business_in_year_864c(p, other)
     and deferred_item_would_be_eci_in_other_year_864c6(p, item_id);
    then eci_by_attribution_to_other_year_864c6(p, item_id);
}

// --- §864(c)(7): property ceasing to be used in the US business -------------

pub relation property_ceased_to_be_used_in_us_business_864c7(p: us.irc.core::Person, asset: Text, ceased_on: Date) kind empirical {
    label en official "the property ceases to be used or held for use in connection with the conduct of a trade or business within the United States on this date (section 864(c)(7)(A))";
}
pub relation property_disposed_of_864c7(p: us.irc.core::Person, asset: Text, disposed_on: Date) kind empirical {
    label en official "the property is disposed of on this date (section 864(c)(7)(B))";
}
pub relation disposition_within_ten_years_of_cessation_864c7(p: us.irc.core::Person, asset: Text) kind institutional {
    label en official "the property is disposed of within 10 years after the cessation of its use in the US trade or business (section 864(c)(7)(B))";
}
@source(IRC_S864_C, relation = formalizes, coverage = exact, quote = "(B) such property is disposed of within 10 years after such cessation,")
rule S864C7DisposedWithinTenYears defeasible {
    for p: us.irc.core::Person;
    for asset: Text;
    for ceased: Date;
    for disposed: Date;
    when property_ceased_to_be_used_in_us_business_864c7(p, asset, ceased)
     and property_disposed_of_864c7(p, asset, disposed)
     and disposed >= ceased
     and disposed <= add_calendar_period(ceased, 10 calendar_year);
    then disposition_within_ten_years_of_cessation_864c7(p, asset);
}
pub relation cessation_year_engaged_and_gain_would_be_eci_864c7(p: us.irc.core::Person, asset: Text) kind empirical {
    label en official "if the sale had occurred immediately before the cessation, the gain would have been effectively connected income taxable under section 871(b) or 882";
}
pub relation eci_by_deemed_sale_before_cessation_864c7(p: us.irc.core::Person, asset: Text) kind institutional {
    label en official "income or gain attributable to the disposition is tested as if the sale occurred immediately before the cessation, without regard to the trade-or-business requirement in the year of disposition (section 864(c)(7))";
}
@source(IRC_S864_C, relation = formalizes, coverage = partial, quote = "the determination of whether any income or gain attributable to such disposition is taxable under section 871(b) or 882 (as the case may be) shall be made as if such sale or exchange occurred immediately before such cessation and without regard to the requirement that the taxpayer be engaged in a trade or business within the United States during the taxable year for which such income or gain is taken into account.")
rule S864C7DeemedSaleBeforeCessation defeasible {
    for p: us.irc.core::Person;
    for asset: Text;
    when nonresident_alien_or_foreign_corp(p)
     and disposition_within_ten_years_of_cessation_864c7(p, asset)
     and cessation_year_engaged_and_gain_would_be_eci_864c7(p, asset);
    then eci_by_deemed_sale_before_cessation_864c7(p, asset);
}

// --- §864(c)(8): sale of an interest in a partnership -----------------------

pub relation owns_interest_in_partnership_engaged_in_us_business_864c8(p: us.irc.core::Person, partnership: us.irc.core::Person) kind empirical {
    label en official "a nonresident alien individual or foreign corporation owns, directly or indirectly, an interest in a partnership engaged in a trade or business within the United States (section 864(c)(8)(A))";
}
pub relation partnership_interest_sale_gain(p: us.irc.core::Person, partnership: us.irc.core::Person, gain: Money) kind empirical {
    label en official "the gain (positive) on the sale, exchange or other disposition of all or part of the partnership interest";
}
pub relation partnership_interest_sale_loss(p: us.irc.core::Person, partnership: us.irc.core::Person, loss: Money) kind empirical {
    label en official "the loss (positive magnitude) on the sale, exchange or other disposition of all or part of the partnership interest";
}
pub relation deemed_sale_eci_gain_share_864c8B(p: us.irc.core::Person, partnership: us.irc.core::Person, amount: Money) kind empirical {
    label en official "the portion of the partner's distributive share of the gain on a deemed sale of all partnership assets at fair market value that would have been effectively connected — the section 864(c)(8)(B)(i)(I) amount, zero if no gain would have been effectively connected; the distributive share follows the non-separately-stated-income rule of (B), last sentence";
}
pub relation deemed_sale_eci_loss_share_864c8B(p: us.irc.core::Person, partnership: us.irc.core::Person, amount: Money) kind empirical {
    label en official "the portion of the partner's distributive share of the loss on the deemed sale that would have been effectively connected — the section 864(c)(8)(B)(ii)(I) amount (positive magnitude), zero if none";
}
pub relation uspri_gain_treated_as_eci_under_897_864c8C(p: us.irc.core::Person, partnership: us.irc.core::Person, amount: Money) kind empirical {
    label en official "the amount treated as effectively connected with respect to United States real property interests held by the partnership under section 897, which reduces the (c)(8)(A) amount (section 864(c)(8)(C))";
}
pub relation partnership_interest_gain_eci_864c8(p: us.irc.core::Person, partnership: us.irc.core::Person, amount: Money) kind institutional {
    label en official "gain on the sale of a partnership interest treated as effectively connected: the lesser of the gain and the (B) deemed-sale amount, reduced by the section 897 amount (section 864(c)(8)(A), (B)(i), (C))";
}
pub relation partnership_interest_loss_eci_864c8(p: us.irc.core::Person, partnership: us.irc.core::Person, amount: Money) kind institutional {
    label en official "loss on the sale of a partnership interest treated as effectively connected: the lesser of the loss and the (B)(ii) deemed-sale loss amount, reduced by the section 897 amount (section 864(c)(8)(A), (B)(ii), (C))";
}
@source(IRC_S864_C, relation = formalizes, coverage = partial, quote = "gain or loss on the sale or exchange of all (or any portion of) such interest shall be treated as effectively connected with the conduct of such trade or business to the extent such gain or loss does not exceed the amount determined under subparagraph (B).")
rule S864C8AGainTreatedAsEciToExtentOfDeemedSaleAmount defeasible {
    for p: us.irc.core::Person;
    for partnership: us.irc.core::Person;
    for gain: Money;
    for deemed: Money;
    for uspri: Money;
    when nonresident_alien_or_foreign_corp(p)
     and owns_interest_in_partnership_engaged_in_us_business_864c8(p, partnership)
     and partnership_interest_sale_gain(p, partnership, gain)
     and deemed_sale_eci_gain_share_864c8B(p, partnership, deemed)
     and uspri_gain_treated_as_eci_under_897_864c8C(p, partnership, uspri);
    then partnership_interest_gain_eci_864c8(p, partnership, max(0.00 USD, min(gain, deemed) - uspri));
}
@source(IRC_S864_C, relation = formalizes, coverage = partial, quote = "gain or loss on the sale or exchange of all (or any portion of) such interest shall be treated as effectively connected with the conduct of such trade or business to the extent such gain or loss does not exceed the amount determined under subparagraph (B).")
rule S864C8ALossTreatedAsEciToExtentOfDeemedSaleAmount defeasible {
    for p: us.irc.core::Person;
    for partnership: us.irc.core::Person;
    for loss: Money;
    for deemed: Money;
    for uspri: Money;
    when nonresident_alien_or_foreign_corp(p)
     and owns_interest_in_partnership_engaged_in_us_business_864c8(p, partnership)
     and partnership_interest_sale_loss(p, partnership, loss)
     and deemed_sale_eci_loss_share_864c8B(p, partnership, deemed)
     and uspri_gain_treated_as_eci_under_897_864c8C(p, partnership, uspri);
    then partnership_interest_loss_eci_864c8(p, partnership, max(0.00 USD, min(loss, deemed) - uspri));
}

// --- §864(d): related-person factoring income -------------------------------

pub relation related_person_864d4(a: us.irc.core::Person, b: us.irc.core::Person) kind empirical {
    label en official "a is a related person of b within the meaning of section 267(b), or a is a United States shareholder (section 951(b)) of b (or related under 267(b) to such a shareholder) — section 864(d)(4)(A)-(B); the section 267(b) and 951(b) relationship is an input";
}
pub relation trade_or_service_receivable_864d3(receivable_id: Text, originator: us.irc.core::Person) kind empirical {
    label en official "an account receivable or evidence of indebtedness arising out of the disposition by the originator of property described in section 1221(a)(1) or the performance of services by the originator (section 864(d)(3))";
}
pub relation receivable_acquired_864d1(acquirer: us.irc.core::Person, receivable_id: Text, income: Money) kind empirical {
    label en official "the person acquires (directly or indirectly) the receivable and derives this income from it, for section 864(d)(1)";
}
pub relation same_foreign_country_substantial_assets_864d7A(acquirer: us.irc.core::Person, originator: us.irc.core::Person) kind empirical {
    label en official "the acquirer and the originator are created or organized under the laws of the same foreign country and the originator has a substantial part of its trade-or-business assets located there, section 864(d)(7)(A)";
}
pub relation originator_would_have_no_fbci_or_eci_from_receivable_864d7B(receivable_id: Text) kind empirical {
    label en official "the originator would not have derived foreign base company income (section 954(a) disregarding 954(b)(3)(A)) or effectively connected income from the receivable had it collected it, section 864(d)(7)(B)";
}
pub relation factoring_exception_864d7_applies(acquirer: us.irc.core::Person, receivable_id: Text) kind institutional {
    label en official "the section 864(d)(7) same-country exception applies to the receivable";
}
@source(IRC_S864_D, relation = formalizes, coverage = exact, quote = "(B) such related person would not have derived any foreign base company income (as defined in section 954(a), determined without regard to section 954(b)(3)(A)), or any income effectively connected with the conduct of a trade or business within the United States, from such receivable if it had been collected by such related person.")
rule S864D7SameCountryException defeasible {
    for acquirer: us.irc.core::Person;
    for originator: us.irc.core::Person;
    for rid: Text;
    when trade_or_service_receivable_864d3(rid, originator)
     and same_foreign_country_substantial_assets_864d7A(acquirer, originator)
     and originator_would_have_no_fbci_or_eci_from_receivable_864d7B(rid);
    then factoring_exception_864d7_applies(acquirer, rid);
}
pub relation income_treated_as_interest_864d1(acquirer: us.irc.core::Person, receivable_id: Text, income: Money) kind institutional {
    label en official "income from an acquired trade or service receivable treated as interest on a loan to the obligor, for purposes of section 904 and subpart F (section 864(d)(1)-(2))";
}
@source(IRC_S864_D, relation = formalizes, coverage = exact, quote = "if any person acquires (directly or indirectly) a trade or service receivable from a related person, any income of such person from the trade or service receivable so acquired shall be treated as if it were interest on a loan to the obligor under the receivable.")
rule S864D1FactoringIncomeIsInterest defeasible {
    for acquirer: us.irc.core::Person;
    for originator: us.irc.core::Person;
    for rid: Text;
    for income: Money;
    when receivable_acquired_864d1(acquirer, rid, income)
     and trade_or_service_receivable_864d3(rid, originator)
     and related_person_864d4(originator, acquirer);
    unless factoring_exception_864d7_applies(acquirer, rid)
     and receivable_acquired_864d1(acquirer, rid, income);
    then income_treated_as_interest_864d1(acquirer, rid, income);
}
pub relation cfc_loan_income_864d6(cfc: us.irc.core::Corporation, loan_id: Text, income: Money) kind empirical {
    label en official "income of a controlled foreign corporation (section 957(a)) from a loan to a person for the purpose of financing the purchase of section 1221(a)(1) property of a related person, or payment for services performed by a related person (section 864(d)(6))";
}
pub relation loan_finances_related_person_sales_or_services_864d6(loan_id: Text) kind empirical {
    label en official "the loan finances the purchase of section 1221(a)(1) property of a related person or payment for services performed by a related person, section 864(d)(6)(A)-(B)";
}
pub relation cfc_loan_income_treated_as_interest_864d6(cfc: us.irc.core::Corporation, loan_id: Text, income: Money) kind institutional {
    label en official "the CFC's income from a related-person-financing loan is treated as interest described in section 864(d)(1)";
}
@source(IRC_S864_D, relation = formalizes, coverage = exact, quote = "shall be treated as interest described in paragraph (1).")
rule S864D6CfcFinancingLoanIncomeIsInterest defeasible {
    for cfc: us.irc.core::Corporation;
    for loan_id: Text;
    for income: Money;
    when cfc_loan_income_864d6(cfc, loan_id, income)
     and loan_finances_related_person_sales_or_services_864d6(loan_id);
    then cfc_loan_income_treated_as_interest_864d6(cfc, loan_id, income);
}
// (d)(5): four provisions do not apply to an amount treated as interest
// under (1) or (6). One marker per provision, keyed by the receivable.
pub relation provision_inapplicable_to_factoring_interest_864d5(acquirer: us.irc.core::Person, receivable_id: Text, provision: Text) kind institutional {
    label en official "the named provision does not apply to an amount treated as interest under section 864(d)(1): section 904(d)(2)(B)(iii)(I), section 954(b)(3)(A), section 954(c)(2)(B), or section 954(c)(3)(A)(i)";
}
@source(IRC_S864_D, relation = formalizes, coverage = exact, quote = "(A) Section 904(d)(2)(B)(iii)(I) (relating to exceptions for export financing interest).")
rule S864D5AExportFinancingInterestExceptionOff defeasible {
    for a: us.irc.core::Person;
    for rid: Text;
    for income: Money;
    when income_treated_as_interest_864d1(a, rid, income);
    then provision_inapplicable_to_factoring_interest_864d5(a, rid, "904(d)(2)(B)(iii)(I)");
}
@source(IRC_S864_D, relation = formalizes, coverage = exact, quote = "(B) Subparagraph (A) of section 954(b)(3) (relating to exception where foreign base company income is less than 5 percent or $1,000,000).")
rule S864D5BDeMinimisFbciExceptionOff defeasible {
    for a: us.irc.core::Person;
    for rid: Text;
    for income: Money;
    when income_treated_as_interest_864d1(a, rid, income);
    then provision_inapplicable_to_factoring_interest_864d5(a, rid, "954(b)(3)(A)");
}
@source(IRC_S864_D, relation = formalizes, coverage = exact, quote = "(C) Subparagraph (B) of section 954(c)(2) (relating to certain export financing).")
rule S864D5CExportFinancingFphciExceptionOff defeasible {
    for a: us.irc.core::Person;
    for rid: Text;
    for income: Money;
    when income_treated_as_interest_864d1(a, rid, income);
    then provision_inapplicable_to_factoring_interest_864d5(a, rid, "954(c)(2)(B)");
}
@source(IRC_S864_D, relation = formalizes, coverage = exact, quote = "(D) Clause (i) of section 954(c)(3)(A) (relating to certain income received from related persons).")
rule S864D5DSameCountryRelatedExceptionOff defeasible {
    for a: us.irc.core::Person;
    for rid: Text;
    for income: Money;
    when income_treated_as_interest_864d1(a, rid, income);
    then provision_inapplicable_to_factoring_interest_864d5(a, rid, "954(c)(3)(A)(i)");
}

// --- §864(e): allocation and apportionment of interest ---------------------

pub relation group_interest_expense_864e(group_id: Text, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the interest expense of all members of the affiliated group for the taxable year, treated as the expense of a single corporation (section 864(e)(1))";
}
pub relation group_asset_adjusted_basis_foreign_864e2(group_id: Text, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the adjusted basis of assets of the group that generate foreign-source income, after excluding tax-exempt assets (section 864(e)(2)-(3))";
}
pub relation group_asset_adjusted_basis_total_864e2(group_id: Text, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the adjusted basis of all assets of the group, after excluding tax-exempt assets (section 864(e)(2)-(3))";
}
pub relation interest_expense_apportioned_to_foreign_source_864e(group_id: Text, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the portion of the group's interest expense apportioned to foreign-source income by the ratio of foreign-generating adjusted asset basis to total adjusted asset basis (section 864(e)(1)-(2))";
}
@source(IRC_S864_E, relation = formalizes, coverage = partial, quote = "All allocations and apportionments of interest expense shall be determined using the adjusted bases of assets rather than on the basis of the fair market value of the assets or gross income.")
rule S864E12InterestApportionedByAdjustedBasis defeasible {
    for g: Text;
    for y: us.irc.core::TaxableYear;
    for interest: Money;
    for foreign_basis: Money;
    for total_basis: Money;
    when group_interest_expense_864e(g, y, interest)
     and group_asset_adjusted_basis_foreign_864e2(g, y, foreign_basis)
     and group_asset_adjusted_basis_total_864e2(g, y, total_basis)
     and total_basis > 0.00 USD;
    then interest_expense_apportioned_to_foreign_source_864e(g, y, round(interest * (foreign_basis / total_basis), 2, "HALF_UP"));
}

pub relation asset_is_tax_exempt_864e3(asset: Text) kind empirical {
    label en official "the asset is a tax-exempt asset (or the portion of stock whose dividends would be deductible under section 243 or 245(a) and would not be qualifying dividends), for section 864(e)(3)";
}
pub relation asset_adjusted_basis_864e(asset: Text, basis: Money) kind empirical {
    label en unofficial "the adjusted basis of the asset";
}
pub relation asset_basis_taken_into_account_864e3(asset: Text, basis: Money) kind institutional {
    label en official "the adjusted basis taken into account in allocating and apportioning a deductible expense: nothing for a tax-exempt asset (section 864(e)(3))";
}
@source(IRC_S864_E, relation = formalizes, coverage = partial, quote = "For purposes of allocating and apportioning any deductible expense, any tax-exempt asset (and any income from such an asset) shall not be taken into account.")
rule S864E3TaxExemptAssetIgnored defeasible {
    for asset: Text;
    for basis: Money;
    when asset_adjusted_basis_864e(asset, basis)
     and asset_is_tax_exempt_864e3(asset);
    then asset_basis_taken_into_account_864e3(asset, 0.00 USD);
}
@source(IRC_S864_E, relation = formalizes, coverage = partial, quote = "For purposes of allocating and apportioning any deductible expense, any tax-exempt asset (and any income from such an asset) shall not be taken into account.")
rule S864E3OtherAssetTakenIntoAccount defeasible {
    for asset: Text;
    for basis: Money;
    when asset_adjusted_basis_864e(asset, basis);
    unless asset_is_tax_exempt_864e3(asset)
     and asset_adjusted_basis_864e(asset, basis);
    then asset_basis_taken_into_account_864e3(asset, basis);
}

// (e)(4): stock of a nonaffiliated 10-percent owned corporation — adjusted
// basis increased by the E&P attributable to the stock and accumulated
// during the holding period, or reduced (not below zero) by the deficit.
pub relation stock_adjusted_basis_864e4(stock: Text, basis: Money) kind empirical {
    label en unofficial "the adjusted basis of stock in a nonaffiliated 10-percent owned corporation before the section 864(e)(4)(A) adjustment";
}
pub relation stock_of_nonaffiliated_10_percent_owned_corporation_864e4B(stock: Text) kind institutional {
    label en official "the stock is stock in a nonaffiliated 10-percent owned corporation: not in the taxpayer's affiliated group, and members of the group own 10 percent or more of its total combined voting power (section 864(e)(4)(B))";
}
pub relation corporation_not_in_affiliated_group_864e4B(stock: Text) kind empirical {
    label en official "the corporation is not included in the taxpayer's affiliated group, for section 864(e)(4)(B)(i)";
}
pub relation group_voting_power_percent_864e4B(stock: Text, percent: Decimal) kind empirical {
    label en official "the percentage of the total combined voting power of all classes of voting stock owned by members of the affiliated group (directly or under (e)(4)(C)(iii) proportionate attribution), for section 864(e)(4)(B)(ii)";
}
@source(IRC_S864_E, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the term \"nonaffiliated 10-percent owned corporation\" means any corporation if—")
rule S864E4BNonaffiliatedTenPercentOwned defeasible {
    for stock: Text;
    for pct: Decimal;
    when corporation_not_in_affiliated_group_864e4B(stock)
     and group_voting_power_percent_864e4B(stock, pct)
     and pct >= 10.0;
    then stock_of_nonaffiliated_10_percent_owned_corporation_864e4B(stock);
}
pub relation earnings_and_profits_attributable_to_stock_864e4(stock: Text, amount: Money) kind empirical {
    label en official "the earnings and profits of the corporation attributable to the stock and accumulated during the holding period — positive for earnings, negative for a deficit; adjusted under (e)(4)(D) for amounts included under section 951 and reflected in basis";
}
pub relation stock_basis_for_asset_apportionment_864e4(stock: Text, basis: Money) kind institutional {
    label en official "the adjusted basis of the stock for expense allocation on the basis of assets: increased by accumulated attributable earnings and profits, or reduced (but not below zero) by the deficit (section 864(e)(4)(A))";
}
@source(IRC_S864_E, relation = formalizes, coverage = exact, quote = "(i) increased by the amount of the earnings and profits of such corporation attributable to such stock and accumulated during the period the taxpayer held such stock, or")
rule S864E4AStockBasisIncreasedByEarnings defeasible {
    for stock: Text;
    for basis: Money;
    for ep: Money;
    when stock_of_nonaffiliated_10_percent_owned_corporation_864e4B(stock)
     and stock_adjusted_basis_864e4(stock, basis)
     and earnings_and_profits_attributable_to_stock_864e4(stock, ep)
     and ep >= 0.00 USD;
    then stock_basis_for_asset_apportionment_864e4(stock, basis + ep);
}
@source(IRC_S864_E, relation = formalizes, coverage = exact, quote = "(ii) reduced (but not below zero) by any deficit in earnings and profits of such corporation attributable to such stock for such period.")
rule S864E4AStockBasisReducedByDeficit defeasible {
    for stock: Text;
    for basis: Money;
    for ep: Money;
    when stock_of_nonaffiliated_10_percent_owned_corporation_864e4B(stock)
     and stock_adjusted_basis_864e4(stock, basis)
     and earnings_and_profits_attributable_to_stock_864e4(stock, ep)
     and ep < 0.00 USD;
    then stock_basis_for_asset_apportionment_864e4(stock, max(0.00 USD, basis + ep));
}

// (e)(5): affiliated group — section 1504, plus a foreign corporation that
// is >50% ECI-gross-income and at least 80% owned by group members.
pub relation foreign_corp_eci_gross_income_percent_864e5(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, percent: Decimal) kind empirical {
    label en official "the percentage of the foreign corporation's gross income for the taxable year that is effectively connected with a United States trade or business, for section 864(e)(5)(A)(i)";
}
pub relation group_ownership_percent_864e5(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, vote_percent: Decimal, value_percent: Decimal) kind empirical {
    label en official "the percentage of the vote and of the value of all outstanding stock of the foreign corporation owned directly or indirectly by members of the affiliated group (determined with regard to the sentence), for section 864(e)(5)(A)(ii)";
}
pub relation foreign_corp_member_of_affiliated_group_864e5A(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the foreign corporation is treated as a member of the affiliated group (section 864(e)(5)(A)): more than 50 percent of its gross income is ECI and at least 80 percent of either its vote or its value is owned by group members";
}
@source(IRC_S864_E, relation = formalizes, coverage = partial, quote = "(i) more than 50 percent of the gross income of such foreign corporation for the taxable year is effectively connected with the conduct of a trade or business within the United States, and")
rule S864E5AForeignCorporationMemberOfAffiliatedGroupByVote defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for eci_pct: Decimal;
    for vote_pct: Decimal;
    for value_pct: Decimal;
    when foreign_corp_eci_gross_income_percent_864e5(corp, y, eci_pct)
     and group_ownership_percent_864e5(corp, y, vote_pct, value_pct)
     and eci_pct > 50.0
     and vote_pct >= 80.0;
    then foreign_corp_member_of_affiliated_group_864e5A(corp, y);
}
@source(IRC_S864_E, relation = formalizes, coverage = partial, quote = "(ii) at least 80 percent of either the vote or value of all outstanding stock of such foreign corporation is owned directly or indirectly by members of the affiliated group (determined with regard to this sentence).")
rule S864E5AForeignCorporationMemberOfAffiliatedGroupByValue defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for eci_pct: Decimal;
    for vote_pct: Decimal;
    for value_pct: Decimal;
    when foreign_corp_eci_gross_income_percent_864e5(corp, y, eci_pct)
     and group_ownership_percent_864e5(corp, y, vote_pct, value_pct)
     and eci_pct > 50.0
     and value_pct >= 80.0;
    then foreign_corp_member_of_affiliated_group_864e5A(corp, y);
}
pub relation financial_institution_581_or_591_864e5C(corp: us.irc.core::Corporation) kind empirical {
    label en official "the corporation is a financial institution described in section 581 or 591, for section 864(e)(5)(C)(i)";
}
pub relation business_predominantly_with_unrelated_persons_864e5C(corp: us.irc.core::Corporation) kind empirical {
    label en official "the institution's business is predominantly with persons other than related persons (section 864(d)(4)) or their customers, for section 864(e)(5)(C)(ii)";
}
pub relation required_by_law_to_operate_separately_864e5C(corp: us.irc.core::Corporation) kind empirical {
    label en official "the institution is required by State or Federal law to be operated separately from any other entity which is not such an institution, for section 864(e)(5)(C)(iii)";
}
pub relation corporation_described_in_864e5C(corp: us.irc.core::Corporation) kind institutional {
    label en official "the corporation is described in section 864(e)(5)(C): a financial institution (581/591) doing predominantly unrelated business and legally required to operate separately";
}
@source(IRC_S864_E, relation = formalizes, coverage = exact, quote = "A corporation is described in this subparagraph if—")
rule S864E5CDescribedFinancialInstitution defeasible {
    for corp: us.irc.core::Corporation;
    when financial_institution_581_or_591_864e5C(corp)
     and business_predominantly_with_unrelated_persons_864e5C(corp)
     and required_by_law_to_operate_separately_864e5C(corp);
    then corporation_described_in_864e5C(corp);
}

// --- §864(g): research and experimental expenditures ------------------------

pub relation qualified_rd_expenditures_864g(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "qualified research and experimental expenditures: amounts which are research and experimental expenditures within the meaning of section 174 (as amended: foreign research or experimental expenditures under 174, domestic under 174A), section 864(g)(2)";
}
pub relation rd_expended_solely_for_legal_requirements_864g1A(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the part of the expenditures expended solely to meet legal requirements imposed by a political entity for the improvement or marketing of specific products or processes for purposes not reasonably expected to generate more than de minimis gross income outside that entity's jurisdiction (section 864(g)(1)(A))";
}
pub relation rd_attributable_to_us_activities_864g1Bi(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the part of the expenditures (not under (A)) attributable to activities conducted in the United States; activities in space, on or under international waters, or in Antarctica are treated as US activities for a United States person and as foreign activities for another person (section 864(g)(3))";
}
pub relation rd_attributable_to_foreign_activities_864g1Bii(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the part of the expenditures (not under (A)) attributable to activities conducted outside the United States (section 864(g)(1)(B)(ii))";
}
pub relation rd_allocated_to_us_source_864g1Bi(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "50 percent of the expenditures attributable to US activities are allocated and apportioned to income from sources within the United States (section 864(g)(1)(B)(i))";
}
@source(IRC_S864_G, relation = formalizes, coverage = exact, quote = "(i) that such expenditures are attributable to activities conducted in the United States, 50 percent of such expenditures shall be allocated and apportioned to income from sources within the United States and deducted from such income in determining the amount of taxable income from sources within the United States, and")
rule S864G1BiFiftyPercentToUsSource defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when rd_attributable_to_us_activities_864g1Bi(p, y, amount);
    then rd_allocated_to_us_source_864g1Bi(p, y, round(amount * 0.50, 2, "HALF_UP"));
}
pub relation rd_allocated_to_foreign_source_864g1Bii(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "50 percent of the expenditures attributable to foreign activities are allocated and apportioned to income from sources outside the United States (section 864(g)(1)(B)(ii))";
}
@source(IRC_S864_G, relation = formalizes, coverage = exact, quote = "(ii) that such expenditures are attributable to activities conducted outside the United States, 50 percent of such expenditures shall be allocated and apportioned to income from sources outside the United States and deducted from such income in determining the amount of taxable income from sources outside the United States.")
rule S864G1BiiFiftyPercentToForeignSource defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when rd_attributable_to_foreign_activities_864g1Bii(p, y, amount);
    then rd_allocated_to_foreign_source_864g1Bii(p, y, round(amount * 0.50, 2, "HALF_UP"));
}
pub relation rd_remaining_portion_864g1C(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the remaining portion of the expenditures not allocated under (A) and (B), apportioned under (C)";
}
pub relation rd_election_gross_income_basis_864g1C(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the taxpayer elects for the taxable year to apportion the remaining portion on the basis of gross income rather than gross sales (section 864(g)(1)(C), annual election)";
}
pub relation foreign_gross_sales_ratio_864g(p: us.irc.core::Person, y: us.irc.core::TaxableYear, ratio: Decimal) kind empirical {
    label en official "foreign gross sales divided by total gross sales (0 to 1) — the ratio on the basis of gross sales, determined as if all members of the affiliated group were a single corporation (section 864(g)(4)(A))";
}
pub relation foreign_gross_income_ratio_864g(p: us.irc.core::Person, y: us.irc.core::TaxableYear, ratio: Decimal) kind empirical {
    label en official "foreign gross income divided by total gross income (0 to 1), determined as if all members of the affiliated group were a single corporation";
}
pub relation rd_remaining_apportioned_to_foreign_864g1C(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the amount of the remaining portion apportioned to income from sources outside the United States: by gross sales, or, on the gross-income election, not less than 30 percent of the gross-sales amount (section 864(g)(1)(C))";
}
@source(IRC_S864_G, relation = formalizes, coverage = partial, quote = "(C) The remaining portion of qualified research and experimental expenditures (not allocated under subparagraphs (A) and (B)) shall be apportioned, at the annual election of the taxpayer, on the basis of gross sales or gross income, except that, if the taxpayer elects to apportion on the basis of gross income, the amount apportioned to income from sources outside the United States shall at least be 30 percent of the amount which would be so apportioned on the basis of gross sales.")
rule S864G1CApportionedByGrossSales defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for remaining: Money;
    for sales_ratio: Decimal;
    when rd_remaining_portion_864g1C(p, y, remaining)
     and foreign_gross_sales_ratio_864g(p, y, sales_ratio);
    unless rd_election_gross_income_basis_864g1C(p, y)
     and rd_remaining_portion_864g1C(p, y, remaining)
     and foreign_gross_sales_ratio_864g(p, y, sales_ratio);
    then rd_remaining_apportioned_to_foreign_864g1C(p, y, round(remaining * sales_ratio, 2, "HALF_UP"));
}
@source(IRC_S864_G, relation = formalizes, coverage = partial, quote = "(C) The remaining portion of qualified research and experimental expenditures (not allocated under subparagraphs (A) and (B)) shall be apportioned, at the annual election of the taxpayer, on the basis of gross sales or gross income, except that, if the taxpayer elects to apportion on the basis of gross income, the amount apportioned to income from sources outside the United States shall at least be 30 percent of the amount which would be so apportioned on the basis of gross sales.")
rule S864G1CApportionedByGrossIncomeWithThirtyPercentFloor defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for remaining: Money;
    for sales_ratio: Decimal;
    for income_ratio: Decimal;
    when rd_remaining_portion_864g1C(p, y, remaining)
     and rd_election_gross_income_basis_864g1C(p, y)
     and foreign_gross_sales_ratio_864g(p, y, sales_ratio)
     and foreign_gross_income_ratio_864g(p, y, income_ratio);
    then rd_remaining_apportioned_to_foreign_864g1C(p, y, max(round(remaining * income_ratio, 2, "HALF_UP"), round(remaining * sales_ratio * 0.30, 2, "HALF_UP")));
}
