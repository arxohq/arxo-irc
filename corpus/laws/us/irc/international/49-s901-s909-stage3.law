// Stage 3 (TECH_GAP reduction), module 49: sections 901(j)(1)(B), (j)(3), (j)(5)(B), (k)(2), (k)(5)-(7), (l)(4), (m)(3), (m)(6);
// 906(b)(2); 907(c)(3), (c)(4)(D), (f); 908(b); 909(b), (c)(1). Status implemented_unverified: not a legal review; scenarios in
// tests/s901-s909-stage3.lawtest are written, NOT executed.
//
// Modeling notes.
//  * The marker relations "sections 275 and 78 do not apply to a tax denied credit" are one relation keyed by the subsection.
//  * The carryover chain of section 907(f) is bounded (1 back, 10 forward) by an offset fact between years; there is no ledger.

use self::{
    IRC_S901_J,
    IRC_S901_K,
    IRC_S901_L,
    IRC_S901_M,
    IRC_S906_B,
    IRC_S907_C,
    IRC_S907_F,
    IRC_S908_B,
    IRC_S909_B,
    IRC_S909_C,
    President,
    boycott_reduction_of_credit_908a,
    disqualified_foreign_income_tax_901m1,
    dividend_withholding_tax_901k,
    foreign_income_tax_909,
    foreign_tax_credit_splitting_event_909d1,
    ftc_excess_over_limitation,
    holding_period_threshold_days_901k,
    nonresident_alien_or_foreign_corp_engaged_in_us_business_906a,
    property_withholding_tax_credit_denied_901l,
    section_906b2_taxable_income_effectively_connected_only,
    section_907a_limitation,
    securities_dealer_qualified_tax_exception_901k4,
    tax_disallowed_as_credit_901j1A,
    withholding_tax_credit_denied_901k,
};

const Congress: us.irc.core::Organ = entity_ref("urn:us:irc:international#congress") {
    label en unofficial "the Congress of the United States, to which section 901(j)(5)(B) directs the President's report";
}

// --- §901(j)(1)(B), (j)(3), (j)(5)(B) ----------------------------------------------------------------------------------------

pub relation sections_904_960_applied_separately_to_901j_income_901j1B(p: us.irc.core::Person, country: Text, y: us.irc.core::TaxableYear) kind institutional {
    label en official "subsections (a), (b) and (c) of section 904 and section 960 are applied separately with respect to income attributable to such a period from sources within the country";
}
@source(IRC_S901_J, relation = formalizes, coverage = exact, quote = "(B) subsections (a), (b), and (c) of section 904 and section 960 shall be applied separately with respect to")
rule S901J1BSeparateApplicationOf904And960 defeasible {
    for p: us.irc.core::Person;
    for country: Text;
    for y: us.irc.core::TaxableYear;
    for tax: Money;
    when tax_disallowed_as_credit_901j1A(p, country, y, tax);
    then sections_904_960_applied_separately_to_901j_income_901j1B(p, country, y);
}
pub relation sections_275_78_not_applicable_to_denied_tax_901(subsection: Text, p: us.irc.core::Person, y: us.irc.core::TaxableYear, tax: Money) kind institutional {
    label en official "sections 275 and 78 do not apply to a tax not allowable as a credit by reason of the subsection ('901j', '901k', '901m', '908a')";
}
@source(IRC_S901_J, relation = formalizes, coverage = exact, quote = "Sections 275 and 78 shall not apply to any tax which is not allowable as a credit under subsection (a) by")
rule S901J3Sections275And78NotApplicable defeasible {
    for p: us.irc.core::Person;
    for country: Text;
    for y: us.irc.core::TaxableYear;
    for tax: Money;
    when tax_disallowed_as_credit_901j1A(p, country, y, tax);
    then sections_275_78_not_applicable_to_denied_tax_901("901j", p, y, tax);
}
pub relation president_waiver_planned_on_901j5(country: Text, waived_on: Date) kind empirical {
    label en official "the President grants a waiver under this paragraph on this date";
}
pub relation president_report_to_congress_dated_901j5B(country: Text, reported_on: Date) kind empirical {
    label en official "the date on which the President reports to Congress the intention to grant the waiver (subparagraph (B)(i)) and the reason for the determination under subparagraph (A)(i) (subparagraph (B)(ii))";
}
pub relation president_report_made_thirty_days_before_waiver_901j5B(country: Text) kind institutional {
    label en official "the report to Congress was made not less than 30 days before the waiver was granted";
}
@source(IRC_S901_J, relation = formalizes, coverage = exact, quote = "Not less than 30 days before the date on which a waiver is granted under this paragraph, the President shall")
rule S901J5BReportThirtyDaysBeforeWaiver defeasible {
    for country: Text;
    for waived_on: Date;
    for reported_on: Date;
    when president_waiver_planned_on_901j5(country, waived_on)
     and president_report_to_congress_dated_901j5B(country, reported_on)
     and days_between(reported_on, waived_on) >= 30;
    then president_report_made_thirty_days_before_waiver_901j5B(country);
}
@source(IRC_S901_J, relation = formalizes, coverage = exact, quote = "Not less than 30 days before the date on which a waiver is granted under this paragraph, the President shall")
rule S901J5BDutyOfPresidentToReport defeasible {
    for country: Text;
    for waived_on: Date;
    when president_waiver_planned_on_901j5(country, waived_on);
    then duty S901J5BPresidentReportDuty {
        bearer President;
        beneficiary Congress;
        goal achievement {
            condition president_report_made_thirty_days_before_waiver_901j5B(country);
            window [-infinity, infinity];
        }
    };
}

// --- §901(k)(2), (5)-(7); §901(l)(4) ----------------------------------------------------------------------------------------------

pub relation deemed_paid_tax_through_chain_853_or_960_901k2(p: us.irc.core::Person, tax_id: Text, amount: Money) kind empirical {
    label en official "income, war profits or excess profits taxes deemed paid under section 853 or 960 through a chain of ownership of stock in one or more corporations";
}
pub relation chain_stock_held_less_than_required_period_901k2A(p: us.irc.core::Person, tax_id: Text) kind empirical {
    label en official "stock of a corporation in the chain (the ownership of which is required to obtain the credit) is held for less than the period described in paragraph (1)(A)(i)";
}
pub relation chain_corporation_under_related_payments_obligation_901k2B(p: us.irc.core::Person, tax_id: Text) kind empirical {
    label en official "the corporation holding the stock is under an obligation referred to in paragraph (1)(A)(ii)";
}
pub relation deemed_paid_tax_credit_denied_through_chain_901k2(p: us.irc.core::Person, tax_id: Text, amount: Money) kind institutional {
    label en official "no credit is allowed under subsection (a) for taxes deemed paid through a chain of ownership if a chain stock was held too briefly or the holding corporation is under a related-payments obligation";
}
@source(IRC_S901_K, relation = formalizes, coverage = exact, quote = "(A) any stock of any corporation in such chain (the ownership of which is required to obtain credit under")
rule S901K2AChainStockHeldTooShort defeasible {
    for p: us.irc.core::Person;
    for tax_id: Text;
    for amount: Money;
    when deemed_paid_tax_through_chain_853_or_960_901k2(p, tax_id, amount)
     and chain_stock_held_less_than_required_period_901k2A(p, tax_id);
    then deemed_paid_tax_credit_denied_through_chain_901k2(p, tax_id, amount);
}
@source(IRC_S901_K, relation = formalizes, coverage = exact, quote = "(B) the corporation holding the stock is under an obligation referred to in paragraph (1)(A)(ii).")
rule S901K2BChainCorporationUnderObligation defeasible {
    for p: us.irc.core::Person;
    for tax_id: Text;
    for amount: Money;
    when deemed_paid_tax_through_chain_853_or_960_901k2(p, tax_id, amount)
     and chain_corporation_under_related_payments_obligation_901k2B(p, tax_id);
    then deemed_paid_tax_credit_denied_through_chain_901k2(p, tax_id, amount);
}
pub relation days_held_before_246c_reduction_901k5(p: us.irc.core::Person, dividend_id: Text, days: Integer) kind empirical {
    label en official "the number of days the stock was held in the 31-day window before the reductions of section 246(c)(3) and (4)";
}
pub relation days_of_diminished_risk_or_tolling_246c_901k5(p: us.irc.core::Person, dividend_id: Text, days: Integer) kind empirical {
    label en official "the number of days in the window in which the risk of loss was diminished or the holding period is tolled (section 246(c)(3), (4)); the days are not counted";
}
pub relation days_held_after_246c_reduction_901k5(p: us.irc.core::Person, dividend_id: Text, days: Integer) kind institutional {
    label en official "the days of holding after the rules of section 246(c)(3) and (4) apply (the holding period is reduced by the days of diminished risk of loss), floored at zero";
}
@source(IRC_S901_K, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, the rules of paragraphs (3) and (4) of section 246(c) shall apply.")
rule S901K5DaysHeldAfterSection246cReduction defeasible {
    for p: us.irc.core::Person;
    for dividend_id: Text;
    for held: Integer;
    for diminished: Integer;
    when days_held_before_246c_reduction_901k5(p, dividend_id, held)
     and days_of_diminished_risk_or_tolling_246c_901k5(p, dividend_id, diminished);
    then days_held_after_246c_reduction_901k5(p, dividend_id, max(held - diminished, 0));
}
@source(IRC_S901_K, relation = formalizes, coverage = partial, quote = "For purposes of this subsection, the rules of paragraphs (3) and (4) of section 246(c) shall apply.")
rule S901K5DenialOnReducedHoldingDays defeasible {
    for p: us.irc.core::Person;
    for d: Text;
    for tax: Money;
    for days: Integer;
    for threshold: Integer;
    when dividend_withholding_tax_901k(p, d, tax)
     and days_held_after_246c_reduction_901k5(p, d, days)
     and holding_period_threshold_days_901k(d, threshold)
     and days <= threshold;
    unless securities_dealer_qualified_tax_exception_901k4(p, d)
     and dividend_withholding_tax_901k(p, d, tax);
    then withholding_tax_credit_denied_901k(p, d, tax);
}
pub relation contract_for_bona_fide_sale_of_stock_entered_on_901k6(p: us.irc.core::Person, share_id: Text, entered_on: Date) kind empirical {
    label en official "a contract for the bona fide sale of stock entered into on this date, by which the person's holding period is reduced under section 246(c)(4)";
}
pub relation holding_period_test_date_960_taxes_901k6(p: us.irc.core::Person, share_id: Text, tested_on: Date) kind institutional {
    label en official "whether the holding period meets the requirements of paragraph (2) for taxes deemed paid under section 960 is determined as of the date the contract is entered into";
}
@source(IRC_S901_K, relation = formalizes, coverage = exact, quote = "If a person's holding period is reduced by reason of the application of the rules of section 246(c)(4) to any")
rule S901K6TestedAsOfContractDate defeasible {
    for p: us.irc.core::Person;
    for share_id: Text;
    for entered_on: Date;
    when contract_for_bona_fide_sale_of_stock_entered_on_901k6(p, share_id, entered_on);
    then holding_period_test_date_960_taxes_901k6(p, share_id, entered_on);
}
@source(IRC_S901_K, relation = formalizes, coverage = exact, quote = "Sections 275 and 78 shall not apply to any tax which is not allowable as a credit under subsection (a) by")
rule S901K7Sections275And78NotApplicable defeasible {
    for p: us.irc.core::Person;
    for d: Text;
    for y: us.irc.core::TaxableYear;
    for tax: Money;
    when withholding_tax_credit_denied_901k(p, d, tax)
     and dividend_tax_year_901k7(p, d, y);
    then sections_275_78_not_applicable_to_denied_tax_901("901k", p, y, tax);
}
pub relation dividend_tax_year_901k7(p: us.irc.core::Person, dividend_id: Text, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the taxable year in which the withholding tax on the dividend is paid or accrued";
}
pub relation rules_of_901k5_to_901k7_apply_to_901l_901l4(p: us.irc.core::Person, item_id: Text) kind institutional {
    label en official "rules similar to the rules of subsection (k)(5), (6) and (7) apply for purposes of subsection (l): the denied property withholding tax, the 246(c) holding-day reductions and the section 275/78 marker are read as for dividends (case inputs for the reduced days)";
}
@source(IRC_S901_L, relation = formalizes, coverage = partial, quote = "Rules similar to the rules of paragraphs (5), (6), and (7) of subsection (k) shall apply for purposes of this")
rule S901L4RulesSimilarToKFiveSixSeven defeasible {
    for p: us.irc.core::Person;
    for item_id: Text;
    for tax: Money;
    when property_withholding_tax_credit_denied_901l(p, item_id, tax);
    then rules_of_901k5_to_901k7_apply_to_901l_901l4(p, item_id);
}

// --- §901(m)(3)(B), (C); (m)(6) ---------------------------------------------------------------------------------------------------

pub relation basis_after_covered_asset_acquisition_901m3Ci_I(p: us.irc.core::Person, asset_id: Text, basis: Money) kind empirical {
    label en official "the adjusted basis of the relevant foreign asset immediately after the covered asset acquisition";
}
pub relation basis_before_covered_asset_acquisition_901m3Ci_II(p: us.irc.core::Person, asset_id: Text, basis: Money) kind empirical {
    label en official "the adjusted basis of the relevant foreign asset immediately before the covered asset acquisition";
}
pub relation basis_difference_901m3Ci(p: us.irc.core::Person, asset_id: Text, amount: Money) kind institutional {
    label en official "the basis difference: the excess of the adjusted basis immediately after over that immediately before the acquisition; where the before amount exceeds the after amount, the excess is a basis difference of a negative amount (clause (ii))";
}
@source(IRC_S901_M, relation = formalizes, coverage = exact, quote = "The term \"basis difference\" means, with respect to any relevant foreign asset, the excess of—")
rule S901M3CiPositiveBasisDifference defeasible {
    for p: us.irc.core::Person;
    for asset_id: Text;
    for after: Money;
    for before: Money;
    when basis_after_covered_asset_acquisition_901m3Ci_I(p, asset_id, after)
     and basis_before_covered_asset_acquisition_901m3Ci_II(p, asset_id, before)
     and after > before;
    then basis_difference_901m3Ci(p, asset_id, after - before);
}
@source(IRC_S901_M, relation = formalizes, coverage = exact, quote = "In the case of a relevant foreign asset with respect to which the amount described in clause (i)(II) exceeds")
rule S901M3CiiNegativeBasisDifference defeasible {
    for p: us.irc.core::Person;
    for asset_id: Text;
    for after: Money;
    for before: Money;
    when basis_after_covered_asset_acquisition_901m3Ci_I(p, asset_id, after)
     and basis_before_covered_asset_acquisition_901m3Ci_II(p, asset_id, before)
     and before > after;
    then basis_difference_901m3Ci(p, asset_id, after - before);
}
pub relation section_338_acquisition_date_901m3Ciii(acquisition_id: Text, acquisition_date: Date) kind empirical {
    label en official "the acquisition date (section 338(h)(2)) of a covered asset acquisition described in paragraph (2)(A)";
}
pub relation covered_asset_acquisition_occurs_at_close_of_date_901m3Ciii(acquisition_id: Text, on: Date) kind institutional {
    label en official "the covered asset acquisition is treated as occurring at the close of the acquisition date (the timing point is the end of that day)";
}
@source(IRC_S901_M, relation = formalizes, coverage = exact, quote = "In the case of a covered asset acquisition described in paragraph (2)(A), the covered asset acquisition shall")
rule S901M3CiiiCloseOfAcquisitionDate defeasible {
    for acquisition_id: Text;
    for acquisition_date: Date;
    when section_338_acquisition_date_901m3Ciii(acquisition_id, acquisition_date);
    then covered_asset_acquisition_occurs_at_close_of_date_901m3Ciii(acquisition_id, acquisition_date);
}
pub relation cost_recovery_share_of_asset_in_year_901m3Bi(p: us.irc.core::Person, asset_id: Text, y: us.irc.core::TaxableYear, percent: Decimal) kind empirical {
    label en official "the share (percent) of the asset's basis recovered in the taxable year under the applicable cost recovery method under this chapter";
}
pub relation basis_difference_allocated_to_year_901m3Bi(p: us.irc.core::Person, asset_id: Text, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the basis difference allocated to the taxable year using the applicable cost recovery method";
}
@source(IRC_S901_M, relation = formalizes, coverage = exact, quote = "The basis difference with respect to any relevant foreign asset shall be allocated to taxable years using the")
rule S901M3BiAllocationByCostRecovery defeasible {
    for p: us.irc.core::Person;
    for asset_id: Text;
    for y: us.irc.core::TaxableYear;
    for difference: Money;
    for percent: Decimal;
    when basis_difference_901m3Ci(p, asset_id, difference)
     and cost_recovery_share_of_asset_in_year_901m3Bi(p, asset_id, y, percent);
    unless asset_disposed_in_year_901m3Bii(p, asset_id, y)
     and basis_difference_901m3Ci(p, asset_id, difference)
     and cost_recovery_share_of_asset_in_year_901m3Bi(p, asset_id, y, percent);
    then basis_difference_allocated_to_year_901m3Bi(p, asset_id, y, round(difference * (percent / 100.0), 2, "HALF_UP"));
}
pub relation asset_disposed_in_year_901m3Bii(p: us.irc.core::Person, asset_id: Text, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the relevant foreign asset is disposed of in this taxable year";
}
pub relation aggregate_prior_allocations_901m3Bii(p: us.irc.core::Person, asset_id: Text, amount: Money) kind empirical {
    label en official "the aggregate basis difference with respect to the asset allocated under clause (i) to all prior taxable years (a sum, asserted directly)";
}
@source(IRC_S901_M, relation = formalizes, coverage = exact, quote = "(I) the basis difference allocated to the taxable year which includes the date of such disposition shall be")
rule S901M3BiiDispositionYearAllocation defeasible {
    for p: us.irc.core::Person;
    for asset_id: Text;
    for y: us.irc.core::TaxableYear;
    for difference: Money;
    for prior: Money;
    when asset_disposed_in_year_901m3Bii(p, asset_id, y)
     and basis_difference_901m3Ci(p, asset_id, difference)
     and aggregate_prior_allocations_901m3Bii(p, asset_id, prior);
    then basis_difference_allocated_to_year_901m3Bi(p, asset_id, y, difference - prior);
}
pub relation year_after_disposition_901m3BiiII(p: us.irc.core::Person, asset_id: Text, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the taxable year is after the taxable year that includes the disposition of the asset";
}
pub relation no_basis_difference_allocated_after_disposition_901m3BiiII(p: us.irc.core::Person, asset_id: Text, y: us.irc.core::TaxableYear) kind institutional {
    label en official "no basis difference with respect to the asset is allocated under clause (i) to any taxable year after the disposition";
}
@source(IRC_S901_M, relation = formalizes, coverage = exact, quote = "(II) no basis difference with respect to such asset shall be allocated under clause (i) to any taxable year")
rule S901M3BiiIINoAllocationAfterDisposition defeasible {
    for p: us.irc.core::Person;
    for asset_id: Text;
    for y: us.irc.core::TaxableYear;
    when year_after_disposition_901m3BiiII(p, asset_id, y);
    then no_basis_difference_allocated_after_disposition_901m3BiiII(p, asset_id, y);
}
@source(IRC_S901_M, relation = formalizes, coverage = exact, quote = "Sections 275 and 78 shall not apply to any tax which is not allowable as a credit under subsection (a) by")
rule S901M6Sections275And78NotApplicable defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when disqualified_foreign_income_tax_901m1(p, y, amount);
    then sections_275_78_not_applicable_to_denied_tax_901("901m", p, y, amount);
}

// --- §906(b)(2), §908(b) ---------------------------------------------------------------------------------------------------------------

pub relation taxable_income_for_section_904_under_906b2(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "in applying section 904 for section 906(a), the taxable income is only the taxable income effectively connected with the conduct of a trade or business within the United States";
}
@source(IRC_S906_B, relation = formalizes, coverage = exact, quote = "(2) For purposes of subsection (a), in applying section 904 the taxpayer's taxable income shall be treated as")
rule S906B2TaxableIncomeOnlyEffectivelyConnected defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for eci: Money;
    when nonresident_alien_or_foreign_corp_engaged_in_us_business_906a(p, y)
     and section_906b2_taxable_income_effectively_connected_only(p, y, eci);
    then taxable_income_for_section_904_under_906b2(p, y, eci);
}
@source(IRC_S908_B, relation = formalizes, coverage = exact, quote = "Section 275(a)(4) and section 78 shall not apply to any amount of taxes denied credit under subsection (a).")
rule S908BSections275And78NotApplicable defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when boycott_reduction_of_credit_908a(p, y, amount);
    then sections_275_78_not_applicable_to_denied_tax_901("908a", p, y, amount);
}

// --- §907(c)(3), (c)(4)(D), (f) ----------------------------------------------------------------------------------------------------------

pub relation included_item_907c3(p: us.irc.core::Person, y: us.irc.core::TaxableYear, item_id: Text, kind: Text, attributable_to_extraction: Money, attributable_to_oil_related: Money) kind empirical {
    label en official "an item included by paragraph (3): 'interest' (the category determined under section 904(d)(3)), 'section_960' (amounts with respect to which taxes are deemed paid under section 960) or 'partnership' (the distributive share of partnership income), and the parts attributable to foreign oil and gas extraction income and to foreign oil related income";
}
pub relation added_to_foreign_oil_and_gas_extraction_income_907c3(p: us.irc.core::Person, y: us.irc.core::TaxableYear, item_id: Text, amount: Money) kind institutional {
    label en official "the amount included in foreign oil and gas extraction income; interest is not taken into account in computing it";
}
@source(IRC_S907_C, relation = formalizes, coverage = exact, quote = "(B) amounts with respect to which taxes are deemed paid under section 960, and")
rule S907C3BSection960AddedToExtractionIncome defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for extraction: Money;
    for related: Money;
    when included_item_907c3(p, y, item_id, "section_960", extraction, related);
    then added_to_foreign_oil_and_gas_extraction_income_907c3(p, y, item_id, extraction);
}
@source(IRC_S907_C, relation = formalizes, coverage = exact, quote = "(C) the taxpayer's distributive share of the income of partnerships,")
rule S907C3CPartnershipShareAddedToExtractionIncome defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for extraction: Money;
    for related: Money;
    when included_item_907c3(p, y, item_id, "partnership", extraction, related);
    then added_to_foreign_oil_and_gas_extraction_income_907c3(p, y, item_id, extraction);
}
pub relation added_to_foreign_oil_related_income_907c3(p: us.irc.core::Person, y: us.irc.core::TaxableYear, item_id: Text, amount: Money) kind institutional {
    label en official "the amount included in foreign oil related income; interest is taken into account in computing it";
}
@source(IRC_S907_C, relation = formalizes, coverage = exact, quote = "(A) interest, to the extent the category of income of such interest is determined under section 904(d)(3),")
rule S907C3AInterestAddedToOilRelatedIncomeOnly defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for extraction: Money;
    for related: Money;
    when included_item_907c3(p, y, item_id, "interest", extraction, related);
    then added_to_foreign_oil_related_income_907c3(p, y, item_id, related);
}
@source(IRC_S907_C, relation = formalizes, coverage = exact, quote = "(B) amounts with respect to which taxes are deemed paid under section 960, and")
rule S907C3BSection960AddedToOilRelatedIncome defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for extraction: Money;
    for related: Money;
    when included_item_907c3(p, y, item_id, "section_960", extraction, related);
    then added_to_foreign_oil_related_income_907c3(p, y, item_id, related);
}
@source(IRC_S907_C, relation = formalizes, coverage = exact, quote = "(C) the taxpayer's distributive share of the income of partnerships,")
rule S907C3CPartnershipShareAddedToOilRelatedIncome defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for extraction: Money;
    for related: Money;
    when included_item_907c3(p, y, item_id, "partnership", extraction, related);
    then added_to_foreign_oil_related_income_907c3(p, y, item_id, related);
}
pub relation gross_income_foreign_sources_for_combined_907c4Di(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the gross income for the taxable year from sources without the United States and its possessions (whether or not the taxpayer chooses the benefits of this subpart) taken into account in determining the combined foreign oil and gas income";
}
pub relation deductions_apportioned_or_allocated_907c4Di(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the sum of the deductions properly apportioned or allocated to that gross income (including any net operating loss deduction, expropriation loss and casualty or theft loss included in it)";
}
pub relation net_operating_loss_deduction_included_907c4Dii(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the net operating loss deduction allowable under section 172(a) included in the deductions (not taken into account)";
}
pub relation foreign_expropriation_loss_907c4DiiiI(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "any foreign expropriation loss (section 172(h) as in effect before the Revenue Reconciliation Act of 1990) not compensated for by insurance or otherwise, included in the deductions";
}
pub relation casualty_or_theft_loss_uncompensated_907c4DiiiII(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "any loss arising from fire, storm, shipwreck or other casualty, or theft, to the extent not compensated for by insurance or otherwise, included in the deductions";
}
pub relation deductions_taken_into_account_for_oil_gas_loss_907c4Dii_iii(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the deductions for the loss after excluding the net operating loss deduction, foreign expropriation losses and uncompensated casualty or theft losses (floored at zero)";
}
@source(IRC_S907_C, relation = formalizes, coverage = exact, quote = "For purposes of clause (i), the net operating loss deduction allowable for the taxable year under section")
rule S907C4DiiiDeductionsAfterExclusions defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for deductions: Money;
    for nol: Money;
    for expropriation: Money;
    for casualty: Money;
    when deductions_apportioned_or_allocated_907c4Di(p, y, deductions)
     and net_operating_loss_deduction_included_907c4Dii(p, y, nol)
     and foreign_expropriation_loss_907c4DiiiI(p, y, expropriation)
     and casualty_or_theft_loss_uncompensated_907c4DiiiII(p, y, casualty);
    then deductions_taken_into_account_for_oil_gas_loss_907c4Dii_iii(p, y, max(deductions - nol - expropriation - casualty, 0.00 USD));
}
pub relation foreign_oil_and_gas_loss_for_year_907c4Di(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the foreign oil and gas loss: the amount by which the deductions taken into account exceed the gross income from foreign sources taken into account in determining the combined foreign oil and gas income";
}
@source(IRC_S907_C, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the term \"foreign oil and gas loss\" means the amount by which—")
rule S907C4DiForeignOilAndGasLoss defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for gross: Money;
    for deductions: Money;
    when gross_income_foreign_sources_for_combined_907c4Di(p, y, gross)
     and deductions_taken_into_account_for_oil_gas_loss_907c4Dii_iii(p, y, deductions)
     and deductions > gross;
    then foreign_oil_and_gas_loss_for_year_907c4Di(p, y, deductions - gross);
}
pub relation year_offset_907f1(from_year: us.irc.core::TaxableYear, to_year: us.irc.core::TaxableYear, offset: Integer) kind empirical {
    label en official "the number of taxable years from the unused credit year to the other year (negative before, positive after)";
}
pub relation oil_gas_tax_carryover_window_907f1(from_year: us.irc.core::TaxableYear, to_year: us.irc.core::TaxableYear, direction: Text) kind institutional {
    label en official "the excess is deemed paid or accrued in the first preceding taxable year ('back') and in any of the first 10 succeeding taxable years ('forward'), in that order";
}
@source(IRC_S907_F, relation = formalizes, coverage = exact, quote = "If the amount of the foreign oil and gas taxes paid or accrued during any taxable year exceeds the limitation")
rule S907F1CarrybackOneYear defeasible {
    for from_year: us.irc.core::TaxableYear;
    for to_year: us.irc.core::TaxableYear;
    for offset: Integer;
    when year_offset_907f1(from_year, to_year, offset)
     and offset == -1;
    then oil_gas_tax_carryover_window_907f1(from_year, to_year, "back");
}
@source(IRC_S907_F, relation = formalizes, coverage = exact, quote = "If the amount of the foreign oil and gas taxes paid or accrued during any taxable year exceeds the limitation")
rule S907F1CarryforwardTenYears defeasible {
    for from_year: us.irc.core::TaxableYear;
    for to_year: us.irc.core::TaxableYear;
    for offset: Integer;
    when year_offset_907f1(from_year, to_year, offset)
     and offset >= 1
     and offset <= 10;
    then oil_gas_tax_carryover_window_907f1(from_year, to_year, "forward");
}
pub relation unused_oil_gas_credit_year_907f1(p: us.irc.core::Person, y: us.irc.core::TaxableYear, excess: Money) kind institutional {
    label en official "an unused credit year: the foreign oil and gas taxes paid or accrued exceed the section 907(a) limitation; the excess is the carryover amount";
}
pub relation foreign_oil_and_gas_taxes_paid_or_accrued_907f1(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the foreign oil and gas taxes paid or accrued during the taxable year";
}
@source(IRC_S907_F, relation = formalizes, coverage = exact, quote = "If the amount of the foreign oil and gas taxes paid or accrued during any taxable year exceeds the limitation")
rule S907F1UnusedCreditYear defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for taxes: Money;
    for limitation: Money;
    when foreign_oil_and_gas_taxes_paid_or_accrued_907f1(p, y, taxes)
     and section_907a_limitation(p, y, limitation)
     and taxes > limitation;
    then unused_oil_gas_credit_year_907f1(p, y, taxes - limitation);
}
pub relation section_907f_applied_before_904c_907f3A(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "for a year that is an unused credit year under both this subsection and section 904(c), this subsection is applied before section 904(c)";
}
@source(IRC_S907_F, relation = formalizes, coverage = exact, quote = "(A) In the case of any taxable year which is an unused credit year under this subsection and which is an")
rule S907F3AOrderingBefore904c defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for oil_excess: Money;
    for ftc_excess: Money;
    when unused_oil_gas_credit_year_907f1(p, y, oil_excess)
     and ftc_excess_over_limitation(p, y, ftc_excess);
    then section_907f_applied_before_904c_907f3A(p, y);
}
pub relation year_is_unused_credit_year_under_904c_907f3A(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the taxable year is an unused credit year under section 904(c) (the section 904 excess is a case input where the module-04 derivation is not supplied)";
}
@source(IRC_S907_F, relation = formalizes, coverage = exact, quote = "(A) In the case of any taxable year which is an unused credit year under this subsection and which is an")
rule S907F3AOrderingBefore904cByCaseFlag defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for oil_excess: Money;
    when unused_oil_gas_credit_year_907f1(p, y, oil_excess)
     and year_is_unused_credit_year_under_904c_907f3A(p, y);
    then section_907f_applied_before_904c_907f3A(p, y);
}
pub relation tax_deemed_paid_under_907f_in_year_907f3B(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "tax deemed paid or accrued in a preceding or succeeding taxable year under this subsection";
}
pub relation tax_considered_paid_for_904c_907f3B(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "for the amount of taxes paid or accrued in a year that may be deemed paid in another year under section 904(c), tax deemed paid in that year under this subsection is considered tax paid or accrued in that year";
}
@source(IRC_S907_F, relation = formalizes, coverage = exact, quote = "(B) For purposes of determining the amount of taxes paid or accrued in any taxable year which may be deemed")
rule S907F3BDeemedPaidConsideredPaidFor904c defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when tax_deemed_paid_under_907f_in_year_907f3B(p, y, amount);
    then tax_considered_paid_for_904c_907f3B(p, y, amount);
}

// --- §909(b), (c)(1) ----------------------------------------------------------------------------------------------------------------------

pub relation payor_is_specified_10_percent_owned_foreign_corporation_909b(payor: us.irc.core::Person) kind empirical {
    label en official "the payor is a specified 10-percent owned foreign corporation (section 245A(b), without regard to paragraph (2) thereof)";
}
pub relation tax_not_taken_into_account_for_960_and_964a_909b(payor: us.irc.core::Person, tax_id: Text, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the tax is not taken into account for purposes of section 960 or for earnings and profits under section 964(a) for the taxable year, before the year in which the related income is taken into account by the corporation or a domestic United States shareholder";
}
@source(IRC_S909_B, relation = formalizes, coverage = exact, quote = "If there is a foreign tax credit splitting event with respect to a foreign income tax paid or accrued by a")
rule S909BSpecifiedCorporationTaxSuspended defeasible {
    for payor: us.irc.core::Person;
    for tax_id: Text;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when payor_is_specified_10_percent_owned_foreign_corporation_909b(payor)
     and foreign_income_tax_909(payor, tax_id, y, amount)
     and foreign_tax_credit_splitting_event_909d1(payor, tax_id);
    then tax_not_taken_into_account_for_960_and_964a_909b(payor, tax_id, y);
}
pub relation entity_kind_909c1(passthrough: us.irc.core::Person, kind: Text) kind empirical {
    label en official "the kind of the entity: 'partnership', 's_corporation' or 'trust'";
}
pub relation partner_of_entity_909c1(passthrough: us.irc.core::Person, partner: us.irc.core::Person) kind empirical {
    label en official "the person is a partner (or shareholder or beneficiary) of the entity";
}
pub relation secretary_provides_similar_rule_909c1(kind: Text) kind empirical {
    label en official "the Secretary provides that a rule similar to the partner-level rule applies to an S corporation or trust";
}
pub relation subsections_909a_909b_applied_at_partner_level_909c1(passthrough: us.irc.core::Person, partner: us.irc.core::Person) kind institutional {
    label en official "in the case of a partnership, subsections (a) and (b) are applied at the partner level (and, as the Secretary provides, for an S corporation or trust)";
}
@source(IRC_S909_C, relation = formalizes, coverage = exact, quote = "In the case of a partnership, subsections (a) and (b) shall be applied at the partner level. Except as")
rule S909C1PartnershipPartnerLevel defeasible {
    for passthrough: us.irc.core::Person;
    for partner: us.irc.core::Person;
    when entity_kind_909c1(passthrough, "partnership")
     and partner_of_entity_909c1(passthrough, partner);
    then subsections_909a_909b_applied_at_partner_level_909c1(passthrough, partner);
}
@source(IRC_S909_C, relation = formalizes, coverage = exact, quote = "In the case of a partnership, subsections (a) and (b) shall be applied at the partner level. Except as")
rule S909C1SimilarRuleWhereSecretaryProvidesForSCorporation defeasible {
    for passthrough: us.irc.core::Person;
    for partner: us.irc.core::Person;
    when entity_kind_909c1(passthrough, "s_corporation")
     and partner_of_entity_909c1(passthrough, partner)
     and secretary_provides_similar_rule_909c1("s_corporation");
    then subsections_909a_909b_applied_at_partner_level_909c1(passthrough, partner);
}
@source(IRC_S909_C, relation = formalizes, coverage = exact, quote = "In the case of a partnership, subsections (a) and (b) shall be applied at the partner level. Except as")
rule S909C1SimilarRuleWhereSecretaryProvidesForTrust defeasible {
    for passthrough: us.irc.core::Person;
    for partner: us.irc.core::Person;
    when entity_kind_909c1(passthrough, "trust")
     and partner_of_entity_909c1(passthrough, partner)
     and secretary_provides_similar_rule_909c1("trust");
    then subsections_909a_909b_applied_at_partner_level_909c1(passthrough, partner);
}
