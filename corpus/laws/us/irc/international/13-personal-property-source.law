// §865 — source rules for sales of personal asset. Stage 2 (IRC-10
// stage 2, A13), resolving this package's own stage-1 pending dependency
// (`01-source-rules.law`'s `us_source_inventory_sale_income` referred to
// "section 865(b)'s title-passage rule" — see the note there: (b) does NOT
// itself state a title-passage test, it EXCLUDES inventory asset from
// this section and defers to sections 861(a)(6)/862(a)(6)/863, which remain
// this package's own separate title-passage chain, still not modeled).
//
// Modeled this stage: (a) general residence-based sourcing rule; (b) the
// inventory-asset exclusion (classification only) plus the executable
// unprocessed-softwood-timber special rule; (c) the depreciable-asset
// apportionment ratio (gain not exceeding depreciation adjustments) with
// the excess-over-depreciation gain deferred to (b)'s inventory treatment;
// (d) the intangibles contingent/noncontingent split (contingent payments
// wired to this package's OWN section 861(a)(4) royalty-source rule) and
// the goodwill-generated-where rule; (e) the office-or-fixed-place-of-
// business overrides for both residents and nonresidents, including the
// (e)(2)(B) export-inventory exception; (f) the stock-of-affiliates
// exception; (g) the "United States resident"/"nonresident" definitions,
// the (g)(2) 10%-foreign-tax anti-abuse rule for citizens/resident aliens,
// and the (g)(3) Puerto Rico stock-sale carve-out.
//
// NOT modeled this stage: (h) the treaty-sourcing election (EXTERNAL_
// DEPENDENCY — treaty text this package never invents, per AGENT-BRIEF.md;
// declared as an `external judgment relation` only); (i)(3)-(5) (possession-
// as-foreign-country, affiliate-group membership via section 1504(a), and
// the partnership-level look-through) are asserted as case facts rather
// than derived from `us.irc.corporations`/a partnerships package (TECH_GAP,
// see TECH-GAPS.md); (j) regulations and (k) cross-references are
// NON_NORMATIVE (delegated rulemaking / pointer to sections 1248 and 988,
// the latter also not modeled this stage — see coverage row for §988).

// --- (g) Definitions: United States resident / nonresident --------------

use self::{
    IRC_S865_A,
    IRC_S865_B,
    IRC_S865_C,
    IRC_S865_D,
    IRC_S865_E,
    IRC_S865_F,
    IRC_S865_G,
    us_source_rental_or_royalty,
};

pub relation tax_home_in_foreign_country_865(p: us.irc.core::Person) kind empirical {
    label en unofficial "the person's tax home (section 911(d)(3)) is in a foreign country, for section 865(g)(1)(A) — asserted directly rather than derived through the section 911(d)(3) chain (INTERPRETATION: case-level fact, not a re-derivation of module 05's tax-home concept)";
}
pub relation tax_home_in_united_states_865(p: us.irc.core::Person) kind empirical {
    label en unofficial "the person's tax home (section 911(d)(3)) is within the United States, for section 865(g)(1)(A)(ii)";
}
pub relation gain_foreign_tax_paid_ratio(seller: us.irc.core::Person, asset: Text, ratio: Decimal) kind empirical {
    label en unofficial "the fraction of the gain from the sale of asset by seller on which an income tax has actually been paid to a foreign country, for the section 865(g)(2) 10-percent anti-abuse test";
}

@source(IRC_S865_G, relation = formalizes, coverage = partial, quote = "is a United States citizen or a resident alien and does not have a tax home (as defined in section 911(d)(3)) in a foreign country, or")
pub relation us_resident_865(p: us.irc.core::Person) kind institutional {
    label en official "the person is a United States resident for section 865 purposes: a citizen or resident alien without a foreign tax home, a nonresident alien with a US tax home, or a domestic corporation/trust/estate (section 865(g)(1)(A))";
}
rule S865G1AICitizenOrResidentAlienWithoutForeignTaxHome defeasible {
    for p: us.irc.core::Individual;
    when (us.irc.definitions::citizen_of_united_states(p) or resident_alien_for_year_holds(p))
     and not_known(tax_home_in_foreign_country_865(p));
    then us_resident_865(p);
}
relation resident_alien_for_year_holds(p: us.irc.core::Individual) kind empirical {
    label en unofficial "the individual is a resident alien for the taxable year at issue, for section 865(g)(1)(A)(i)(I) — asserted directly rather than re-deriving definitions'/residency.law's year-indexed relation, since section 865 does not itself carry a taxable-year parameter";
}
rule S865G1AIiNonresidentAlienWithUsTaxHome defeasible {
    for p: us.irc.core::Individual;
    when nonresident_alien_for_year_holds(p)
     and tax_home_in_united_states_865(p);
    then us_resident_865(p);
}
relation nonresident_alien_for_year_holds(p: us.irc.core::Individual) kind empirical {
    label en unofficial "the individual is a nonresident alien for the taxable year at issue, for section 865(g)(1)(A)(i)(II) — same case-level convention as resident_alien_for_year_holds above";
}
rule S865G1AIiCorporateTrustEstateUsPerson strict {
    for p: us.irc.core::Person;
    when us.irc.definitions::united_states_person(p)
     and not_known(us.irc.definitions::citizen_of_united_states(p));
    then us_resident_865(p);
}

pub relation seller_or_buyer_considered_for_865(p: us.irc.core::Person) kind empirical {
    label en unofficial "the person is a party to a section 865 sale whose United States resident/nonresident status is at issue — a domain-anchor fact so the section 865(g)(1)(B) 'any person other than a United States resident' default has a positive established conjunct to range-restrict on (§190), rather than negating an unbound variable";
}
@source(IRC_S865_G, relation = formalizes, coverage = exact, quote = "The term \"nonresident\" means any person other than a United States resident.")
pub relation nonresident_865(p: us.irc.core::Person) kind institutional {
    label en official "the person is a nonresident for section 865 purposes: any person other than a section 865(g)(1)(A) United States resident, subject to the (g)(2) anti-abuse override below";
}
rule S865G1BNonresidentByDefault defeasible {
    for p: us.irc.core::Person;
    when seller_or_buyer_considered_for_865(p)
     and not_known(us_resident_865(p));
    then nonresident_865(p);
}
// (g)(2): a citizen/resident alien claiming nonresident status under (a)(2)
// is NOT treated as a nonresident for a sale unless at least 10% of the
// gain's tax was actually paid to a foreign country — this is a per-SALE
// override, layered on top of (g)(1) status, not a redefinition of it.
@source(IRC_S865_G, relation = formalizes, coverage = partial, quote = "a United States citizen or resident alien shall not be treated as a nonresident with respect to any sale of personal property unless an income tax equal to at least 10 percent of the gain derived from such sale is actually paid to a foreign country with respect to that gain")
pub relation treated_as_nonresident_for_sale_865(p: us.irc.core::Person, asset: Text) kind institutional {
    label en official "for this specific sale, a US citizen or resident alien with a foreign tax home is treated as a nonresident under section 865(g)(2) because at least 10% of the gain's tax was actually paid to a foreign country";
}
rule S865G2TenPercentForeignTaxAntiAbuse defeasible {
    for p: us.irc.core::Individual;
    for asset: Text;
    for ratio: Decimal;
    when (us.irc.definitions::citizen_of_united_states(p) or resident_alien_for_year_holds(p))
     and nonresident_865(p)
     and gain_foreign_tax_paid_ratio(p, asset, ratio)
     and ratio >= 0.10;
    then treated_as_nonresident_for_sale_865(p, asset);
}

// --- (a) General rule -----------------------------------------------------

pub relation personal_property_sale_gain(seller: us.irc.core::Person, buyer: us.irc.core::Person, asset: Text, amount: Money) kind empirical {
    label en unofficial "the amount of gain from the sale (or exchange, per section 865(i)(2)) of personal asset by seller to buyer, for section 865 sourcing";
}
pub relation inventory_property_865(asset: Text) kind empirical {
    label en unofficial "the asset sold is inventory asset within the meaning of section 1221(a)(1), for the section 865(b)/(i)(1) exclusion — asserted directly (TECH_GAP: not derived from a gross-income/asset-transactions package's own section 1221(a)(1) classification)";
}
pub relation depreciable_personal_property_865(asset: Text) kind empirical {
    label en unofficial "the asset sold is depreciable personal asset whose adjusted basis includes depreciation adjustments, for section 865(c)(4)(A)";
}
pub relation intangible_property_865(asset: Text) kind empirical {
    label en unofficial "the asset sold is an intangible within the meaning of section 865(d)(2) (patent, copyright, secret process or formula, goodwill, trademark, trade brand, franchise, or other like asset)";
}
pub relation stock_of_affiliate_sale_865(seller: us.irc.core::Person, asset: Text) kind empirical {
    label en unofficial "the asset sold is stock in a foreign corporation that is an affiliate of the seller, for section 865(f)";
}

@source(IRC_S865_A, relation = formalizes, coverage = exact, quote = "by a United States resident shall be sourced in the United States, or")
pub relation us_source_personal_property_gain(seller: us.irc.core::Person, buyer: us.irc.core::Person, asset: Text, amount: Money) kind institutional {
    label en official "gain from the sale of personal asset is sourced in the United States because the seller is a section 865(g) United States resident and none of the section 865(b)-(h) exceptions this stage models applies";
}
rule S865AGeneralRuleUsResident defeasible {
    for seller: us.irc.core::Person;
    for buyer: us.irc.core::Person;
    for asset: Text;
    for amount: Money;
    when personal_property_sale_gain(seller, buyer, asset, amount)
     and us_resident_865(seller);
    unless inventory_property_865(asset)
     and personal_property_sale_gain(seller, buyer, asset, amount);
    unless depreciable_personal_property_865(asset)
     and personal_property_sale_gain(seller, buyer, asset, amount);
    unless intangible_property_865(asset)
     and personal_property_sale_gain(seller, buyer, asset, amount);
    unless stock_of_affiliate_sale_865(seller, asset)
     and personal_property_sale_gain(seller, buyer, asset, amount);
    unless sale_attributable_to_foreign_office_865(seller, buyer, asset, amount)
     and personal_property_sale_gain(seller, buyer, asset, amount);
    then us_source_personal_property_gain(seller, buyer, asset, amount);
}
@source(IRC_S865_A, relation = formalizes, coverage = exact, quote = "by a nonresident shall be sourced outside the United States.")
pub relation foreign_source_personal_property_gain(seller: us.irc.core::Person, buyer: us.irc.core::Person, asset: Text, amount: Money) kind institutional {
    label en official "gain from the sale of personal asset is sourced outside the United States because the seller is a section 865(g) nonresident and none of the section 865(b)-(h) exceptions this stage models applies";
}
rule S865AGeneralRuleNonresident defeasible {
    for seller: us.irc.core::Person;
    for buyer: us.irc.core::Person;
    for asset: Text;
    for amount: Money;
    when personal_property_sale_gain(seller, buyer, asset, amount)
     and nonresident_865(seller);
    unless inventory_property_865(asset)
     and personal_property_sale_gain(seller, buyer, asset, amount);
    unless depreciable_personal_property_865(asset)
     and personal_property_sale_gain(seller, buyer, asset, amount);
    unless intangible_property_865(asset)
     and personal_property_sale_gain(seller, buyer, asset, amount);
    unless sale_attributable_to_us_office_865(seller, buyer, asset, amount)
     and personal_property_sale_gain(seller, buyer, asset, amount);
    then foreign_source_personal_property_gain(seller, buyer, asset, amount);
}

// --- (b) Inventory exception: unprocessed softwood timber ----------------

pub relation unprocessed_softwood_timber_cut_in_us(asset: Text) kind empirical {
    label en unofficial "the asset is unprocessed timber (log, cant, or similar form) which is a softwood and was cut from an area in the United States, for section 865(b)'s second sentence";
}
@source(IRC_S865_B, relation = formalizes, coverage = exact, quote = "any income from the sale of any unprocessed timber which is a softwood and was cut from an area in the United States shall be sourced in the United States")
rule S865BUnprocessedSoftwoodTimberAlwaysUsSource defeasible {
    for seller: us.irc.core::Person;
    for buyer: us.irc.core::Person;
    for asset: Text;
    for amount: Money;
    when personal_property_sale_gain(seller, buyer, asset, amount)
     and inventory_property_865(asset)
     and unprocessed_softwood_timber_cut_in_us(asset);
    then us_source_personal_property_gain(seller, buyer, asset, amount);
}

// --- (c) Depreciable personal asset apportionment ----------------------

pub relation us_depreciation_adjustments(asset: Text, amount: Money) kind empirical {
    label en unofficial "the United States depreciation adjustments to the asset's adjusted basis, per section 865(c)(3)(A)";
}
pub relation total_depreciation_adjustments(asset: Text, amount: Money) kind empirical {
    label en unofficial "the total depreciation adjustments to the asset's adjusted basis, per section 865(c)(1)";
}
@source(IRC_S865_C, relation = formalizes, coverage = partial, quote = "by treating the same proportion of such gain as sourced in the United States as the United States depreciation adjustments with respect to such property bear to the total depreciation adjustments")
pub relation us_source_depreciable_property_gain(seller: us.irc.core::Person, buyer: us.irc.core::Person, asset: Text, amount: Money) kind institutional {
    label en official "the United States-source portion of gain (not exceeding the total depreciation adjustments) from the sale of depreciable personal asset, apportioned by the ratio of United States depreciation adjustments to total depreciation adjustments (section 865(c)(1)(A))";
}
rule S865C1DepreciablePropertyUsPortion defeasible {
    for seller: us.irc.core::Person;
    for buyer: us.irc.core::Person;
    for asset: Text;
    for amount: Money;
    for us_dep: Money;
    for total_dep: Money;
    when personal_property_sale_gain(seller, buyer, asset, amount)
     and depreciable_personal_property_865(asset)
     and us_depreciation_adjustments(asset, us_dep)
     and total_depreciation_adjustments(asset, total_dep)
     and total_dep > 0.00 USD
     and amount <= total_dep;
    then us_source_depreciable_property_gain(seller, buyer, asset, min(amount, round(amount * (us_dep / total_dep), 2, "HALF_UP")));
}
// (c)(2): gain IN EXCESS of the total depreciation adjustments is sourced
// as if the asset were inventory asset — deferred to the (b)
// pending dependency chain (section 861(a)(6)/862(a)(6)/863 title-passage,
// not modeled this stage), so declared but not computed here.
relation depreciable_property_excess_gain_sourced_as_inventory(seller: us.irc.core::Person, buyer: us.irc.core::Person, asset: Text, amount: Money) kind institutional {
    label en official "PENDING: gain from a depreciable-asset sale in excess of the total depreciation adjustments is sourced as inventory asset under section 865(c)(2), which routes to the still-unmodeled section 861(a)(6)/862(a)(6)/863 title-passage chain (external_norm_unresolved, same pending dependency as 01-source-rules.law's us_source_inventory_sale_income)";
}

// --- (d) Intangibles --------------------------------------------------

pub relation intangible_payment_contingent_on_productivity_or_use(seller: us.irc.core::Person, buyer: us.irc.core::Person, asset: Text, amount: Money) kind empirical {
    label en unofficial "the payment in consideration of the sale of the intangible is contingent on the productivity, use, or disposition of the intangible, for section 865(d)(1)(B)";
}
pub relation goodwill_generated_in_united_states(asset: Text) kind empirical {
    label en unofficial "the goodwill sold was generated in the United States, for section 865(d)(3)'s generated-in-the-country sourcing rule";
}
@source(IRC_S865_D, relation = formalizes, coverage = partial, quote = "to the extent such payments are so contingent, the source of such payments shall be determined under this part in the same manner as if such payments were royalties")
rule S865D1BContingentIntangiblePaymentSourcedAsRoyalty defeasible {
    for seller: us.irc.core::Person;
    for buyer: us.irc.core::Person;
    for asset: Text;
    for amount: Money;
    when personal_property_sale_gain(seller, buyer, asset, amount)
     and intangible_property_865(asset)
     and intangible_payment_contingent_on_productivity_or_use(seller, buyer, asset, amount);
    then us_source_rental_or_royalty(buyer, seller, amount);
}
@source(IRC_S865_D, relation = formalizes, coverage = exact, quote = "To the extent this section applies to the sale of goodwill, payments in consideration of such sale shall be treated as from sources in the country in which such goodwill was generated.")
rule S865D3GoodwillSourcedWhereGenerated defeasible {
    for seller: us.irc.core::Person;
    for buyer: us.irc.core::Person;
    for asset: Text;
    for amount: Money;
    when personal_property_sale_gain(seller, buyer, asset, amount)
     and intangible_property_865(asset)
     and goodwill_generated_in_united_states(asset);
    unless intangible_payment_contingent_on_productivity_or_use(seller, buyer, asset, amount)
     and personal_property_sale_gain(seller, buyer, asset, amount);
    then us_source_personal_property_gain(seller, buyer, asset, amount);
}

// --- (e) Office-or-fixed-place-of-business overrides -----------------------

pub relation sale_attributable_to_foreign_office_865(seller: us.irc.core::Person, buyer: us.irc.core::Person, asset: Text, amount: Money) kind empirical {
    label en unofficial "the United States resident seller maintains an office or other fixed place of business in a foreign country, and the section 865 sale is attributable to it, applying section 864(c)(5)'s principles per section 865(e)(3) — the attribution test itself is asserted directly (TECH_GAP: section 864(c)(5)'s own attribution rule is modeled in `02-eci-trade-or-business.law` for a different purpose and is not re-wired here)";
}
pub relation foreign_tax_paid_on_sale_at_least_ten_percent(seller: us.irc.core::Person, asset: Text) kind empirical {
    label en unofficial "an income tax equal to at least 10 percent of the income from the sale is actually paid to a foreign country with respect to that income, for section 865(e)(1)(B)";
}
@source(IRC_S865_E, relation = formalizes, coverage = partial, quote = "income from sales of personal property attributable to such office or other fixed place of business shall be sourced outside the United States")
rule S865E1AForeignOfficeOverride defeasible {
    for seller: us.irc.core::Person;
    for buyer: us.irc.core::Person;
    for asset: Text;
    for amount: Money;
    when personal_property_sale_gain(seller, buyer, asset, amount)
     and us_resident_865(seller)
     and sale_attributable_to_foreign_office_865(seller, buyer, asset, amount)
     and foreign_tax_paid_on_sale_at_least_ten_percent(seller, asset);
    unless inventory_property_865(asset)
     and personal_property_sale_gain(seller, buyer, asset, amount);
    unless depreciable_personal_property_865(asset)
     and personal_property_sale_gain(seller, buyer, asset, amount);
    unless intangible_property_865(asset)
     and personal_property_sale_gain(seller, buyer, asset, amount);
    then foreign_source_personal_property_gain(seller, buyer, asset, amount);
}

pub relation sale_attributable_to_us_office_865(seller: us.irc.core::Person, buyer: us.irc.core::Person, asset: Text, amount: Money) kind empirical {
    label en unofficial "the nonresident seller maintains an office or other fixed place of business in the United States, and the section 865 sale (including of inventory asset) is attributable to it, per section 865(e)(2)(A)/(3)";
}
pub relation export_inventory_foreign_office_material_participation(seller: us.irc.core::Person, buyer: us.irc.core::Person, asset: Text, amount: Money) kind empirical {
    label en unofficial "the asset is inventory asset sold for use, disposition, or consumption outside the United States, and an office or other fixed place of business of the seller in a foreign country materially participated in the sale, for the section 865(e)(2)(B) exception";
}
@source(IRC_S865_E, relation = formalizes, coverage = partial, quote = "income from any sale of personal property (including inventory property) attributable to such office or other fixed place of business shall be sourced in the United States")
rule S865E2AUsOfficeOverride defeasible {
    for seller: us.irc.core::Person;
    for buyer: us.irc.core::Person;
    for asset: Text;
    for amount: Money;
    when personal_property_sale_gain(seller, buyer, asset, amount)
     and nonresident_865(seller)
     and sale_attributable_to_us_office_865(seller, buyer, asset, amount);
    unless export_inventory_foreign_office_material_participation(seller, buyer, asset, amount)
     and personal_property_sale_gain(seller, buyer, asset, amount);
    then us_source_personal_property_gain(seller, buyer, asset, amount);
}

// --- (f) Stock of affiliates -----------------------------------------------

pub relation affiliate_active_trade_or_business_country_matches_sale(seller: us.irc.core::Person, asset: Text) kind empirical {
    label en unofficial "the sale of the affiliate stock occurs in a foreign country in which the affiliate is engaged in the active conduct of a trade or business, for section 865(f)(2)";
}
pub relation affiliate_active_business_gross_income_ratio(asset: Text, ratio: Decimal) kind empirical {
    label en unofficial "the fraction of the foreign affiliate's gross income for the section 865(f)(3) 3-year testing period derived from the active conduct of a trade or business in the sale country";
}
@source(IRC_S865_F, relation = formalizes, coverage = partial, quote = "any gain from such sale shall be sourced outside the United States")
rule S865FStockOfAffiliatesException defeasible {
    for seller: us.irc.core::Person;
    for buyer: us.irc.core::Person;
    for asset: Text;
    for amount: Money;
    for ratio: Decimal;
    when personal_property_sale_gain(seller, buyer, asset, amount)
     and stock_of_affiliate_sale_865(seller, asset)
     and us_resident_865(seller)
     and affiliate_active_trade_or_business_country_matches_sale(seller, asset)
     and affiliate_active_business_gross_income_ratio(asset, ratio)
     and ratio > 0.50;
    then foreign_source_personal_property_gain(seller, buyer, asset, amount);
}

// --- (g)(3) Puerto Rico stock-sale carve-out (not further modeled) --------
//
// The (g)(3) carve-out disapplies the (g)(2) 10%-foreign-tax anti-abuse
// rule for a bona-fide Puerto Rico resident's stock sale meeting its own
// >50%-active-business test; declared as a typed pending case rather than
// wired, since it duplicates the (f)-style ratio test on a Puerto Rico
// fact pattern this stage does not exercise in a scenario (TECH_GAP, same
// class as the (f) test above but not independently scenario-tested).
relation puerto_rico_bona_fide_resident_stock_sale_865(p: us.irc.core::Individual, asset: Text) kind empirical {
    label en unofficial "the individual was a bona fide resident of Puerto Rico during the entire taxable year and sells stock meeting the section 865(g)(3) active-business test — asserted directly, not independently scenario-tested this stage (TECH_GAP)";
}
rule S865G3PuertoRicoCarveOutDisappliesAntiAbuse defeasible {
    for p: us.irc.core::Individual;
    for asset: Text;
    when puerto_rico_bona_fide_resident_stock_sale_865(p, asset);
    then treated_as_nonresident_for_sale_865(p, asset);
}
