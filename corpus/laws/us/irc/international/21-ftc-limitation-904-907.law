// §904(b)-(d),(h),(j) — the limitation's inputs and categories; §907 —
// reduction of foreign oil and gas taxes. Stage 2c (IRC-10 stage 2c, A13).
// §904(a),(c),(f),(g) live in module 04; the PL 119-21 additions to §904(b)
// live in module 22.
//
// The §904(d)(1) basket tagging of module 04 (`income_in_basket`, a case
// fact) is left in place; this module derives the basket from the statutory
// definitions where their inputs are countable (passive income, high-taxed
// income, export financing interest, the look-through of CFC dividends), and
// leaves the CFC look-through allocations of §904(d)(3)(A),(C),(H)-style
// regulatory apportionment to TECH-GAPS G1739.

// --- §904(b)(1)-(3): the taxable-income inputs ------------------------------

use self::{
    IRC_S904_B,
    IRC_S904_D,
    IRC_S904_H,
    IRC_S904_J,
    IRC_S907_A,
    IRC_S907_B,
    IRC_S907_C,
    IRC_S907_D,
    IRC_S907_F,
};

pub relation individual_estate_or_trust_taxable_income_before_exemption_904b1(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the taxable income of an individual, estate or trust before the deduction for personal exemptions under section 151 or 642(b)";
}
pub relation personal_exemption_deduction_904b1(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the deduction for personal exemptions under section 151 or 642(b) that section 904(b)(1) disregards";
}
pub relation taxable_income_for_904a_without_exemption(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the taxable income of an individual, estate or trust for purposes of the section 904(a) limitation, computed without any deduction for personal exemptions (section 904(b)(1)): the taxable income after exemption plus the exemption deduction";
}
pub relation taxable_income_after_exemption_904b1(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the taxable income of the person after the personal-exemption deduction, as reported";
}
@source(IRC_S904_B, relation = formalizes, coverage = exact, quote = "For purposes of subsection (a), the taxable income in the case of an individual, estate, or trust shall be computed without any deduction for personal exemptions under section 151 or 642(b).")
rule S904B1TaxableIncomeWithoutPersonalExemptions defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for after: Money;
    for exemption: Money;
    when taxable_income_after_exemption_904b1(p, y, after)
     and personal_exemption_deduction_904b1(p, y, exemption);
    then taxable_income_for_904a_without_exemption(p, y, after + exemption);
}

pub relation capital_gain_net_income_from_without_us_904b3(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "capital gain net income from sources without the United States";
}
pub relation capital_gain_net_income_904b3(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "capital gain net income (including gain treated as capital under section 1231, section 904(b)(3)(C))";
}
pub relation foreign_source_capital_gain_net_income_904b3A(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the term foreign source capital gain net income: the lesser of capital gain net income from sources without the United States and capital gain net income (section 904(b)(3)(A))";
}
@source(IRC_S904_B, relation = formalizes, coverage = exact, quote = "The term \"foreign source capital gain net income\" means the lesser of—")
rule S904B3AForeignSourceCapitalGainNetIncome defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for foreign: Money;
    for total: Money;
    when capital_gain_net_income_from_without_us_904b3(p, y, foreign)
     and capital_gain_net_income_904b3(p, y, total);
    then foreign_source_capital_gain_net_income_904b3A(p, y, min(foreign, total));
}
pub relation net_capital_gain_from_without_us_904b3(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "net capital gain from sources without the United States";
}
pub relation net_capital_gain_904b3(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "net capital gain";
}
pub relation foreign_source_net_capital_gain_904b3B(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the term foreign source net capital gain: the lesser of net capital gain from sources without the United States and net capital gain (section 904(b)(3)(B))";
}
@source(IRC_S904_B, relation = formalizes, coverage = exact, quote = "The term \"foreign source net capital gain\" means the lesser of—")
rule S904B3BForeignSourceNetCapitalGain defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for foreign: Money;
    for total: Money;
    when net_capital_gain_from_without_us_904b3(p, y, foreign)
     and net_capital_gain_904b3(p, y, total);
    then foreign_source_net_capital_gain_904b3B(p, y, min(foreign, total));
}
pub relation capital_gain_rate_differential_year_904b3D(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "section 1(h) applies to the taxable year, so there is a capital gain rate differential (section 904(b)(3)(D))";
}
pub relation highest_section_1_rate_904b3E(p: us.irc.core::Person, y: us.irc.core::TaxableYear, rate: Decimal) kind empirical {
    label en official "the highest rate of tax set forth in subsection (a), (b), (c), (d) or (e) of section 1 (whichever applies)";
}
pub relation alternative_rate_1h_904b3E(p: us.irc.core::Person, y: us.irc.core::TaxableYear, rate: Decimal) kind empirical {
    label en official "the alternative rate of tax determined under section 1(h)";
}
pub relation rate_differential_portion_of_foreign_source_net_capital_gain(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the rate differential portion of foreign source net capital gain: the same proportion of it as the excess of the highest section 1 rate over the section 1(h) alternative rate bears to the highest rate (section 904(b)(3)(E))";
}
@source(IRC_S904_B, relation = formalizes, coverage = partial, quote = "The rate differential portion of foreign source net capital gain, net capital gain, or the excess of net capital gain from sources within the United States over net capital gain, as the case may be, is the same proportion of such amount as—")
rule S904B3ERateDifferentialPortionForeignSource defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    for top: Decimal;
    for alt: Decimal;
    when capital_gain_rate_differential_year_904b3D(p, y)
     and foreign_source_net_capital_gain_904b3B(p, y, amount)
     and highest_section_1_rate_904b3E(p, y, top)
     and alternative_rate_1h_904b3E(p, y, alt)
     and top > 0.0;
    then rate_differential_portion_of_foreign_source_net_capital_gain(p, y, round(amount * ((top - alt) / top), 2, "HALF_UP"));
}
pub relation rate_differential_portion_of_net_capital_gain(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the rate differential portion of net capital gain (section 904(b)(3)(E))";
}
@source(IRC_S904_B, relation = formalizes, coverage = partial, quote = "The rate differential portion of foreign source net capital gain, net capital gain, or the excess of net capital gain from sources within the United States over net capital gain, as the case may be, is the same proportion of such amount as—")
rule S904B3ERateDifferentialPortionNetCapitalGain defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    for top: Decimal;
    for alt: Decimal;
    when capital_gain_rate_differential_year_904b3D(p, y)
     and net_capital_gain_904b3(p, y, amount)
     and highest_section_1_rate_904b3E(p, y, top)
     and alternative_rate_1h_904b3E(p, y, alt)
     and top > 0.0;
    then rate_differential_portion_of_net_capital_gain(p, y, round(amount * ((top - alt) / top), 2, "HALF_UP"));
}
pub relation foreign_source_capital_gain_included_in_taxable_income_904b2(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the gain from the sale or exchange of capital assets included in taxable income from sources outside the United States for the section 904 limitation: foreign source capital gain net income, or in a rate differential year that amount reduced by the rate differential portion of foreign source net capital gain (section 904(b)(2)(A)-(B)(i))";
}
@source(IRC_S904_B, relation = formalizes, coverage = exact, quote = "Taxable income from sources outside the United States shall include gain from the sale or exchange of capital assets only to the extent of foreign source capital gain net income.")
rule S904B2AForeignCapitalGainIncluded defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for fsncgi: Money;
    when foreign_source_capital_gain_net_income_904b3A(p, y, fsncgi);
    unless capital_gain_rate_differential_year_904b3D(p, y)
     and foreign_source_capital_gain_net_income_904b3A(p, y, fsncgi);
    then foreign_source_capital_gain_included_in_taxable_income_904b2(p, y, fsncgi);
}
@source(IRC_S904_B, relation = formalizes, coverage = partial, quote = "(i) in lieu of applying subparagraph (A), the taxable income from sources outside the United States shall include gain from the sale or exchange of capital assets only in an amount equal to foreign source capital gain net income reduced by the rate differential portion of foreign source net capital gain,")
rule S904B2BiForeignCapitalGainIncludedRateDifferential defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for fsncgi: Money;
    for portion: Money;
    when capital_gain_rate_differential_year_904b3D(p, y)
     and foreign_source_capital_gain_net_income_904b3A(p, y, fsncgi)
     and rate_differential_portion_of_foreign_source_net_capital_gain(p, y, portion);
    then foreign_source_capital_gain_included_in_taxable_income_904b2(p, y, max(0.00 USD, fsncgi - portion));
}
pub relation entire_taxable_income_capital_gain_included_904b2Bii(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "in a rate differential year, the entire taxable income includes gain from the sale or exchange of capital assets only in an amount equal to capital gain net income reduced by the rate differential portion of net capital gain (section 904(b)(2)(B)(ii))";
}
@source(IRC_S904_B, relation = formalizes, coverage = partial, quote = "(ii) the entire taxable income shall include gain from the sale or exchange of capital assets only in an amount equal to capital gain net income reduced by the rate differential portion of net capital gain,")
rule S904B2BiiEntireCapitalGainIncluded defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for cgni: Money;
    for portion: Money;
    when capital_gain_rate_differential_year_904b3D(p, y)
     and capital_gain_net_income_904b3(p, y, cgni)
     and rate_differential_portion_of_net_capital_gain(p, y, portion);
    then entire_taxable_income_capital_gain_included_904b2Bii(p, y, max(0.00 USD, cgni - portion));
}

// --- §904(b)(4): specified 10-percent owned foreign corporation -------------

pub relation domestic_corp_us_shareholder_of_specified_10_percent_owned_foreign_corp_904b4(corp: us.irc.core::Corporation, foreign_corp: us.irc.core::Corporation) kind empirical {
    label en official "the domestic corporation is a United States shareholder with respect to a specified 10-percent owned foreign corporation (section 245A(b))";
}
pub relation foreign_source_portion_of_dividend_904b4A(corp: us.irc.core::Corporation, foreign_corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the foreign-source portion of a dividend received from the specified 10-percent owned foreign corporation";
}
pub relation deductions_allocable_to_stock_income_904b4B(corp: us.irc.core::Corporation, foreign_corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "deductions properly allocable or apportioned to income (other than section 951(a)(1) or 951A(a) amounts) with respect to the stock, or to the stock to the extent income is other than such amounts";
}
pub relation foreign_source_taxable_income_before_904b4(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the shareholder's taxable income from sources without the United States before the section 904(b)(4) adjustment";
}
pub relation foreign_source_taxable_income_after_904b4(corp: us.irc.core::Corporation, foreign_corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "taxable income from sources without the United States after excluding the foreign-source portion of the dividend and the deductions allocable to the stock (section 904(b)(4)); the entire taxable income is adjusted alike";
}
@source(IRC_S904_B, relation = formalizes, coverage = partial, quote = "(A) the foreign-source portion of any dividend received from such foreign corporation, and")
rule S904B4ExclusionsFromForeignSourceTaxableIncome defeasible {
    for corp: us.irc.core::Corporation;
    for foreign_corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for base: Money;
    for dividend: Money;
    for deductions: Money;
    when domestic_corp_us_shareholder_of_specified_10_percent_owned_foreign_corp_904b4(corp, foreign_corp)
     and foreign_source_taxable_income_before_904b4(corp, y, base)
     and foreign_source_portion_of_dividend_904b4A(corp, foreign_corp, y, dividend)
     and deductions_allocable_to_stock_income_904b4B(corp, foreign_corp, y, deductions);
    then foreign_source_taxable_income_after_904b4(corp, foreign_corp, y, base - dividend + deductions);
}

// --- §904(d): separate categories ------------------------------------------

pub relation item_of_income_904d(item_id: Text, amount: Money) kind empirical {
    label en unofficial "an item of income for the section 904(d) category determination";
}
pub relation item_of_kind_foreign_personal_holding_company_income_904d2Bi(item_id: Text) kind empirical {
    label en official "the item is of a kind which would be foreign personal holding company income (section 954(c)) — the section 954(c) kind determination is an input (module 10 classifies items by its own relations, TECH-GAPS G1739)";
}
pub relation item_is_section_1293_inclusion_904d2Bii(item_id: Text) kind empirical {
    label en official "the item is an amount includible in gross income under section 1293 (a PFIC inclusion), for section 904(d)(2)(B)(ii)";
}
pub relation item_is_export_financing_interest_904d2G(item_id: Text) kind institutional {
    label en official "the item is export financing interest: interest derived from financing the sale for use or consumption outside the United States of property manufactured, produced, grown or extracted in the United States by the taxpayer or a related person, of which not more than 50 percent of the fair market value is attributable to imported products (section 904(d)(2)(G))";
}
pub relation financed_sale_property_us_produced_for_use_outside_us_904d2G(item_id: Text) kind empirical {
    label en official "the financed sale is of property manufactured, produced, grown or extracted in the United States by the taxpayer or a related person and sold for use or consumption outside the United States";
}
pub relation financed_property_fair_market_value_904d2G(item_id: Text, fmv: Money) kind empirical {
    label en official "the fair market value of the financed property";
}
pub relation financed_property_imported_content_value_904d2G(item_id: Text, imported: Money) kind empirical {
    label en official "the fair market value of the imported products attributable to the financed property, at appraised value under section 402 of the Tariff Act of 1930";
}
pub relation interest_item_financing_904d2G(item_id: Text) kind empirical {
    label en unofficial "the item is interest derived from financing the sale of the property";
}
@source(IRC_S904_D, relation = formalizes, coverage = exact, quote = "(ii) not more than 50 percent of the fair market value of which is attributable to products imported into the United States.")
rule S904D2GExportFinancingInterest defeasible {
    for item_id: Text;
    for fmv: Money;
    for imported: Money;
    when interest_item_financing_904d2G(item_id)
     and financed_sale_property_us_produced_for_use_outside_us_904d2G(item_id)
     and financed_property_fair_market_value_904d2G(item_id, fmv)
     and financed_property_imported_content_value_904d2G(item_id, imported)
     and imported * 2 <= fmv;
    then item_is_export_financing_interest_904d2G(item_id);
}
pub relation income_amount_for_high_tax_test_904d2F(item_id: Text, income: Money) kind empirical {
    label en official "the amount of the item of income, determined with regard to section 78";
}
pub relation foreign_income_taxes_paid_or_accrued_on_item_904d2F(item_id: Text, tax: Money) kind empirical {
    label en official "the foreign income taxes paid or accrued by the taxpayer with respect to the item";
}
pub relation foreign_income_taxes_deemed_paid_on_item_904d2F(item_id: Text, tax: Money) kind empirical {
    label en official "the foreign income taxes deemed paid by the taxpayer with respect to the item under section 960";
}
pub relation highest_rate_section_1_or_11_904d2F(item_id: Text, rate: Decimal) kind empirical {
    label en official "the highest rate of tax specified in section 1 or 11 (whichever applies) to the taxpayer";
}
pub relation item_is_high_taxed_income_904d2F(item_id: Text) kind institutional {
    label en official "the item, which would otherwise be passive income, is high-taxed income: foreign income taxes paid plus deemed paid exceed the highest section 1 or 11 rate times the amount of the income (section 904(d)(2)(F))";
}
@source(IRC_S904_D, relation = formalizes, coverage = exact, quote = "The term \"high-taxed income\" means any income which (but for this subparagraph) would be passive income if the sum of—")
rule S904D2FHighTaxedIncome defeasible {
    for item_id: Text;
    for income: Money;
    for paid: Money;
    for deemed: Money;
    for rate: Decimal;
    when item_of_kind_foreign_personal_holding_company_income_904d2Bi(item_id)
     and income_amount_for_high_tax_test_904d2F(item_id, income)
     and foreign_income_taxes_paid_or_accrued_on_item_904d2F(item_id, paid)
     and foreign_income_taxes_deemed_paid_on_item_904d2F(item_id, deemed)
     and highest_rate_section_1_or_11_904d2F(item_id, rate)
     and (paid + deemed) > (income * rate);
    then item_is_high_taxed_income_904d2F(item_id);
}
pub relation item_is_passive_income_904d2B(item_id: Text) kind institutional {
    label en official "the item is passive income: of a kind which would be foreign personal holding company income, or a section 1293 inclusion, but not export financing interest and not high-taxed income (section 904(d)(2)(B)(i)-(iii))";
}
@source(IRC_S904_D, relation = formalizes, coverage = partial, quote = "Except as otherwise provided in this subparagraph, the term \"passive income\" means any income received or accrued by any person which is of a kind which would be foreign personal holding company income (as defined in section 954(c)).")
rule S904D2BiPassiveIncomeFphciKind defeasible {
    for item_id: Text;
    when item_of_kind_foreign_personal_holding_company_income_904d2Bi(item_id);
    unless item_is_export_financing_interest_904d2G(item_id)
     and item_of_kind_foreign_personal_holding_company_income_904d2Bi(item_id);
    unless item_is_high_taxed_income_904d2F(item_id)
     and item_of_kind_foreign_personal_holding_company_income_904d2Bi(item_id);
    then item_is_passive_income_904d2B(item_id);
}
@source(IRC_S904_D, relation = formalizes, coverage = partial, quote = "Except as provided in clause (iii), subparagraph (E)(ii), or paragraph (3)(H), the term \"passive income\" includes any amount includible in gross income under section 1293 (relating to certain passive foreign investment companies).")
rule S904D2BiiPassiveIncomePficInclusion defeasible {
    for item_id: Text;
    when item_is_section_1293_inclusion_904d2Bii(item_id);
    unless item_is_export_financing_interest_904d2G(item_id)
     and item_is_section_1293_inclusion_904d2Bii(item_id);
    unless item_is_high_taxed_income_904d2F(item_id)
     and item_is_section_1293_inclusion_904d2Bii(item_id);
    then item_is_passive_income_904d2B(item_id);
}
pub relation item_is_specified_passive_category_income_904d2Bv(item_id: Text) kind empirical {
    label en official "the item is a dividend from a DISC or former DISC treated as foreign source income, or a former-FSC distribution of foreign trade income or interest or carrying charges (section 904(d)(2)(B)(v))";
}
pub relation item_is_passive_category_income_904d2A(item_id: Text) kind institutional {
    label en official "the item is passive category income: passive income and specified passive category income (section 904(d)(2)(A)(i))";
}
@source(IRC_S904_D, relation = formalizes, coverage = exact, quote = "The term \"passive category income\" means passive income and specified passive category income.")
rule S904D2AiPassiveCategoryFromPassive defeasible {
    for item_id: Text;
    when item_is_passive_income_904d2B(item_id);
    then item_is_passive_category_income_904d2A(item_id);
}
@source(IRC_S904_D, relation = formalizes, coverage = exact, quote = "The term \"passive category income\" means passive income and specified passive category income.")
rule S904D2AiPassiveCategoryFromSpecified defeasible {
    for item_id: Text;
    when item_is_specified_passive_category_income_904d2Bv(item_id);
    then item_is_passive_category_income_904d2A(item_id);
}
pub relation item_includible_under_951A_904d1A(item_id: Text) kind empirical {
    label en official "the item is an amount includible in gross income under section 951A";
}
pub relation item_is_foreign_branch_income_904d2J(item_id: Text) kind empirical {
    label en official "the item is foreign branch income: business profits attributable to one or more qualified business units (section 989(a)) in one or more foreign countries, not passive category income (section 904(d)(2)(J)); the QBU attribution is an input";
}
pub relation item_is_general_category_income_904d2Aii(item_id: Text) kind institutional {
    label en official "the item is general category income: income other than section 951A amounts, foreign branch income and passive category income (section 904(d)(2)(A)(ii))";
}
@source(IRC_S904_D, relation = formalizes, coverage = exact, quote = "The term \"general category income\" means income other than income described in paragraph (1)(A), foreign branch income, and passive category income.")
rule S904D2AiiGeneralCategoryIncome defeasible {
    for item_id: Text;
    when item_of_income_904d(item_id, _);
    unless item_includible_under_951A_904d1A(item_id)
     and item_of_income_904d(item_id, _);
    unless item_is_foreign_branch_income_904d2J(item_id)
     and item_of_income_904d(item_id, _);
    unless item_is_passive_category_income_904d2A(item_id)
     and item_of_income_904d(item_id, _);
    then item_is_general_category_income_904d2Aii(item_id);
}

// §904(d)(2)(C): financial services income is general category income for a
// member of a financial services group or a person predominantly engaged in
// a banking, insurance, financing or similar business.
pub relation item_is_financial_services_income_904d2D(item_id: Text) kind empirical {
    label en official "the item is financial services income (income of a person predominantly engaged in an active banking, insurance, financing or similar business that is derived in that business, from unearned premiums or reserves, or insurance income, or is passive income determined without regard to (B)(iii)(II)) — a characterization asserted by the case";
}
pub relation recipient_member_of_financial_services_group_or_predominantly_financial_904d2C(item_id: Text) kind empirical {
    label en official "the recipient is a member of a financial services group, or another person predominantly engaged in the active conduct of a banking, insurance, financing or similar business";
}
pub relation financial_services_income_is_general_category_904d2C(item_id: Text) kind institutional {
    label en official "financial services income is treated as general category income for the recipient described in section 904(d)(2)(C)(i)";
}
@source(IRC_S904_D, relation = formalizes, coverage = exact, quote = "Financial services income shall be treated as general category income in the case of—")
rule S904D2CFinancialServicesIncomeGeneralCategory defeasible {
    for item_id: Text;
    when item_is_financial_services_income_904d2D(item_id)
     and recipient_member_of_financial_services_group_or_predominantly_financial_904d2C(item_id);
    then financial_services_income_is_general_category_904d2C(item_id);
}

// §904(d)(3)(D), (d)(4)(A): CFC dividends and noncontrolled 10-percent owned
// foreign corporation dividends by proportion of earnings and profits.
pub relation dividend_from_cfc_904d3D(item_id: Text, amount: Money) kind empirical {
    label en official "a dividend paid out of the earnings and profits of a controlled foreign corporation in which the taxpayer is a United States shareholder";
}
pub relation cfc_earnings_and_profits_passive_portion_904d3D(item_id: Text, passive_ep: Money, total_ep: Money) kind empirical {
    label en official "the portion of the earnings and profits attributable to passive category income, and the total earnings and profits, for the section 904(d)(3)(D) ratio";
}
pub relation dividend_passive_category_portion_904d3D(item_id: Text, amount: Money) kind institutional {
    label en official "the dividend treated as passive category income in proportion to the ratio of passive-category earnings and profits to total earnings and profits (section 904(d)(3)(D))";
}
@source(IRC_S904_D, relation = formalizes, coverage = exact, quote = "Any dividend paid out of the earnings and profits of any controlled foreign corporation in which the taxpayer is a United States shareholder shall be treated as passive category income in proportion to the ratio of—")
rule S904D3DCfcDividendPassiveByEpRatio defeasible {
    for item_id: Text;
    for dividend: Money;
    for passive_ep: Money;
    for total_ep: Money;
    when dividend_from_cfc_904d3D(item_id, dividend)
     and cfc_earnings_and_profits_passive_portion_904d3D(item_id, passive_ep, total_ep)
     and total_ep > 0.00 USD;
    then dividend_passive_category_portion_904d3D(item_id, round(dividend * (passive_ep / total_ep), 2, "HALF_UP"));
}
pub relation dividend_from_noncontrolled_10_percent_owned_904d4A(item_id: Text, amount: Money) kind empirical {
    label en official "a dividend from a noncontrolled 10-percent owned foreign corporation with respect to the taxpayer";
}
pub relation noncontrolled_corp_earnings_and_profits_of_subparagraph_904d4A(item_id: Text, subparagraph_ep: Money, total_ep: Money) kind empirical {
    label en official "the portion of earnings and profits attributable to income described in the tested subparagraph of paragraph (1), and the total earnings and profits";
}
pub relation dividend_portion_in_subparagraph_904d4A(item_id: Text, amount: Money) kind institutional {
    label en official "the portion of the dividend treated as income described in a subparagraph of paragraph (1), in proportion to the earnings-and-profits ratio (section 904(d)(4)(A))";
}
@source(IRC_S904_D, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, any dividend from a noncontrolled 10-percent owned foreign corporation with respect to the taxpayer shall be treated as income described in a subparagraph of paragraph (1) in proportion to the ratio of—")
rule S904D4ANoncontrolledDividendByEpRatio defeasible {
    for item_id: Text;
    for dividend: Money;
    for sub_ep: Money;
    for total_ep: Money;
    when dividend_from_noncontrolled_10_percent_owned_904d4A(item_id, dividend)
     and noncontrolled_corp_earnings_and_profits_of_subparagraph_904d4A(item_id, sub_ep, total_ep)
     and total_ep > 0.00 USD;
    then dividend_portion_in_subparagraph_904d4A(item_id, round(dividend * (sub_ep / total_ep), 2, "HALF_UP"));
}
pub relation dividend_substantiation_failed_904d4Cii(item_id: Text) kind empirical {
    label en official "the Secretary determines that the proper subparagraph in which the dividend is described has not been substantiated";
}
pub relation dividend_treated_as_951A_basket_income_904d4Cii(item_id: Text) kind institutional {
    label en official "the unsubstantiated dividend is treated as income described in paragraph (1)(A) (section 904(d)(4)(C)(ii))";
}
@source(IRC_S904_D, relation = formalizes, coverage = exact, quote = "If the Secretary determines that the proper subparagraph of paragraph (1) in which a dividend is described has not been substantiated, such dividend shall be treated as income described in paragraph (1)(A).")
rule S904D4CiiUnsubstantiatedDividendIsParagraph1A defeasible {
    for item_id: Text;
    when dividend_substantiation_failed_904d4Cii(item_id);
    then dividend_treated_as_951A_basket_income_904d4Cii(item_id);
}
pub relation section_951a1A_inclusion_attributable_passive_904d3B(item_id: Text, passive_part: Money) kind empirical {
    label en official "the portion of an amount included under section 951(a)(1)(A) attributable to passive category income";
}
pub relation inclusion_951a1A_passive_category_904d3B(item_id: Text, amount: Money) kind institutional {
    label en official "an amount included under section 951(a)(1)(A) is treated as passive category income to the extent attributable to passive category income (section 904(d)(3)(B))";
}
@source(IRC_S904_D, relation = formalizes, coverage = exact, quote = "Any amount included in gross income under section 951(a)(1)(A) shall be treated as passive category income to the extent the amount so included is attributable to passive category income.")
rule S904D3BSubpartFInclusionPassiveToExtentAttributable defeasible {
    for item_id: Text;
    for part: Money;
    when section_951a1A_inclusion_attributable_passive_904d3B(item_id, part);
    then inclusion_951a1A_passive_category_904d3B(item_id, part);
}
pub relation treaty_resourced_item_separate_limitation_904d6(item_id: Text) kind institutional {
    label en official "the section 904(a), (b), (c) limitation and sections 907 and 960 apply separately to the item: without regard to any treaty it would be US-source income, under a treaty obligation it would arise outside the United States, and the taxpayer chooses the treaty benefits (section 904(d)(6)(A))";
}
pub relation item_us_source_without_treaty_904d6(item_id: Text) kind empirical {
    label en official "without regard to any treaty obligation of the United States the item would be treated as derived from sources within the United States";
}
pub relation item_foreign_source_under_treaty_904d6(item_id: Text) kind empirical {
    label en official "under a treaty obligation of the United States the item would be treated as arising from sources outside the United States";
}
pub relation taxpayer_chooses_treaty_benefits_904d6(item_id: Text) kind empirical {
    label en official "the taxpayer chooses the benefits of the treaty obligation";
}
pub relation item_subject_to_904h10_or_865h_904d6B(item_id: Text) kind empirical {
    label en official "subsection (h)(10) or section 865(h) applies to the item, so paragraph (6) does not";
}
@source(IRC_S904_D, relation = formalizes, coverage = exact, quote = "subsections (a), (b), and (c) of this section and sections 907 and 960 shall be applied separately with respect to each such item.")
rule S904D6TreatyResourcedItemSeparately defeasible {
    for item_id: Text;
    when item_us_source_without_treaty_904d6(item_id)
     and item_foreign_source_under_treaty_904d6(item_id)
     and taxpayer_chooses_treaty_benefits_904d6(item_id);
    unless item_subject_to_904h10_or_865h_904d6B(item_id)
     and item_us_source_without_treaty_904d6(item_id);
    then treaty_resourced_item_separate_limitation_904d6(item_id);
}

// --- §904(h): source rules for US-owned foreign corporations -----------------

pub relation foreign_corp_us_ownership_percent_904h6(corp: us.irc.core::Corporation, vote_percent: Decimal, value_percent: Decimal) kind empirical {
    label en official "the percentage of the total combined voting power, and of the total value of the stock, held directly or indirectly (sections 958(a)(2)-(3) and 318(a)(4)) by United States persons";
}
pub relation united_states_owned_foreign_corporation_904h6(corp: us.irc.core::Corporation) kind institutional {
    label en official "a foreign corporation of which 50 percent or more of the voting power or of the value is held directly or indirectly by United States persons (section 904(h)(6))";
}
@source(IRC_S904_H, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, the term \"United States-owned foreign corporation\" means any foreign corporation if 50 percent or more of—")
rule S904H6UsOwnedByVote defeasible {
    for corp: us.irc.core::Corporation;
    for vote: Decimal;
    for value: Decimal;
    when foreign_corp_us_ownership_percent_904h6(corp, vote, value)
     and vote >= 50.0;
    then united_states_owned_foreign_corporation_904h6(corp);
}
@source(IRC_S904_H, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, the term \"United States-owned foreign corporation\" means any foreign corporation if 50 percent or more of—")
rule S904H6UsOwnedByValue defeasible {
    for corp: us.irc.core::Corporation;
    for vote: Decimal;
    for value: Decimal;
    when foreign_corp_us_ownership_percent_904h6(corp, vote, value)
     and value >= 50.0;
    then united_states_owned_foreign_corporation_904h6(corp);
}
pub relation corp_earnings_and_profits_for_year_904h(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, us_source_ep: Money, total_ep: Money) kind empirical {
    label en official "the earnings and profits of the corporation for the taxable year attributable to sources within the United States, and the total (determined without reduction for the (h)(3) interest)";
}
pub relation section_904h5_exception_applies(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "paragraphs (3) and (4) do not apply for the year: the corporation has earnings and profits and less than 10 percent of them is attributable to sources within the United States (section 904(h)(5))";
}
@source(IRC_S904_H, relation = formalizes, coverage = exact, quote = "(B) less than 10 percent of such earnings and profits is attributable to sources within the United States.")
rule S904H5LessThanTenPercentUsEarnings defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for us_ep: Money;
    for total_ep: Money;
    when corp_earnings_and_profits_for_year_904h(corp, y, us_ep, total_ep)
     and total_ep > 0.00 USD
     and (us_ep * 10) < total_ep;
    then section_904h5_exception_applies(corp, y);
}
pub relation dividend_paid_by_us_owned_foreign_corp_904h4(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, dividend_id: Text, amount: Money) kind empirical {
    label en official "a dividend paid or accrued by a United States-owned foreign corporation out of the earnings and profits of the taxable year (including a section 1248 gain treated as a dividend, (h)(7))";
}
pub relation us_source_part_of_dividend_904h4(corp: us.irc.core::Corporation, dividend_id: Text, amount: Money) kind institutional {
    label en official "the United States source ratio of the dividend — earnings and profits from United States sources over total earnings and profits — treated as derived from sources within the United States (section 904(h)(4))";
}
@source(IRC_S904_H, relation = formalizes, coverage = exact, quote = "The United States source ratio of any dividend paid or accrued by a United States-owned foreign corporation shall be treated as derived from sources within the United States.")
rule S904H4DividendUsSourceRatio defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for dividend_id: Text;
    for amount: Money;
    for us_ep: Money;
    for total_ep: Money;
    when united_states_owned_foreign_corporation_904h6(corp)
     and dividend_paid_by_us_owned_foreign_corp_904h4(corp, y, dividend_id, amount)
     and corp_earnings_and_profits_for_year_904h(corp, y, us_ep, total_ep)
     and total_ep > 0.00 USD;
    unless section_904h5_exception_applies(corp, y)
     and dividend_paid_by_us_owned_foreign_corp_904h4(corp, y, dividend_id, amount)
     and corp_earnings_and_profits_for_year_904h(corp, y, us_ep, total_ep);
    then us_source_part_of_dividend_904h4(corp, dividend_id, round(amount * (us_ep / total_ep), 2, "HALF_UP"));
}
pub relation interest_paid_by_us_owned_foreign_corp_to_us_shareholder_904h3(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, interest_id: Text, amount: Money) kind empirical {
    label en official "interest paid or accrued by a United States-owned foreign corporation to a United States shareholder (section 951(b)) or a related person under section 267(b), properly allocable (regulations) to the corporation's income from sources within the United States";
}
pub relation us_source_interest_of_us_owned_foreign_corp_904h3(corp: us.irc.core::Corporation, interest_id: Text, amount: Money) kind institutional {
    label en official "the interest is treated as derived from sources within the United States (section 904(h)(3))";
}
@source(IRC_S904_H, relation = formalizes, coverage = partial, quote = "shall be treated as derived from sources within the United States.")
rule S904H3InterestFromUsOwnedForeignCorpIsUsSource defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for interest_id: Text;
    for amount: Money;
    when united_states_owned_foreign_corporation_904h6(corp)
     and interest_paid_by_us_owned_foreign_corp_to_us_shareholder_904h3(corp, y, interest_id, amount);
    unless section_904h5_exception_applies(corp, y)
     and interest_paid_by_us_owned_foreign_corp_to_us_shareholder_904h3(corp, y, interest_id, amount);
    then us_source_interest_of_us_owned_foreign_corp_904h3(corp, interest_id, amount);
}

// --- §904(j): de minimis exception for individuals -------------------------

pub relation individual_gross_foreign_income_all_qualified_passive_904j2A(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the entire amount of the individual's gross income for the year from sources without the United States consists of qualified passive income — passive income (section 904(d)(2)(B) without (iii)) shown on a payee statement (section 6724(d)(2))";
}
pub relation creditable_foreign_taxes_904j2B(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the creditable foreign taxes (taxes creditable under section 901, only if shown on a payee statement) paid or accrued during the taxable year";
}
pub relation joint_return_904j2B(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind empirical {
    label en unofficial "the individual files a joint return for the taxable year";
}
pub relation elects_904j_exception(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the individual elects to have section 904(j) apply for the taxable year";
}
pub relation section_904j_applies_to_individual(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind institutional {
    label en official "section 904(j) applies to the individual for the year: qualified passive income only, creditable foreign taxes not over $300 ($600 on a joint return), and an election";
}
@source(IRC_S904_J, relation = formalizes, coverage = exact, quote = "(B) the amount of the creditable foreign taxes paid or accrued by the individual during the taxable year does not exceed $300 ($600 in the case of a joint return), and")
rule S904J2ApplicableSingle defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for taxes: Money;
    when individual_gross_foreign_income_all_qualified_passive_904j2A(p, y)
     and creditable_foreign_taxes_904j2B(p, y, taxes)
     and elects_904j_exception(p, y)
     and taxes <= 300.00 USD;
    unless joint_return_904j2B(p, y)
     and creditable_foreign_taxes_904j2B(p, y, taxes);
    then section_904j_applies_to_individual(p, y);
}
@source(IRC_S904_J, relation = formalizes, coverage = exact, quote = "(B) the amount of the creditable foreign taxes paid or accrued by the individual during the taxable year does not exceed $300 ($600 in the case of a joint return), and")
rule S904J2ApplicableJoint defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for taxes: Money;
    when individual_gross_foreign_income_all_qualified_passive_904j2A(p, y)
     and creditable_foreign_taxes_904j2B(p, y, taxes)
     and elects_904j_exception(p, y)
     and joint_return_904j2B(p, y)
     and taxes <= 600.00 USD;
    then section_904j_applies_to_individual(p, y);
}
pub relation section_904a_limitation_not_applied_904j1A(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the limitation of subsection (a) does not apply to the individual, and taxes are not carried to or from other years under subsection (c) (section 904(j)(1)(A)-(C))";
}
@source(IRC_S904_J, relation = formalizes, coverage = exact, quote = "(A) the limitation of subsection (a) shall not apply,")
rule S904J1NoLimitationNoCarryover defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    when section_904j_applies_to_individual(p, y);
    then section_904a_limitation_not_applied_904j1A(p, y);
}

// --- §907: reduction in amount allowed of foreign oil and gas taxes ---------

pub relation foreign_oil_and_gas_extraction_income_907c1(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "taxable income derived from sources without the United States and its possessions from the extraction of minerals from oil or gas wells or the sale of assets used in that business, excluding passive dividend and interest income, determined without regard to paragraph (4)";
}
pub relation foreign_oil_related_income_907c2(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "taxable income derived from sources outside the United States and its possessions from processing, transportation, distribution or sale of oil or gas minerals or primary products, disposition of assets used in those businesses, or other related services, excluding passive dividend and interest income, determined without regard to paragraph (4)";
}
pub relation combined_foreign_oil_and_gas_income_907b1(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the combined foreign oil and gas income for the year: the sum of foreign oil and gas extraction income and foreign oil related income (section 907(b)(1)), after the section 907(c)(4) reductions";
}
pub relation combined_income_before_907c4(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the combined foreign oil and gas income determined without regard to section 907(c)(4)";
}
@source(IRC_S907_B, relation = formalizes, coverage = exact, quote = "The term \"combined foreign oil and gas income\" means, with respect to any taxable year, the sum of—")
rule S907B1CombinedIncomeBeforeReductions defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for extraction: Money;
    for related: Money;
    when foreign_oil_and_gas_extraction_income_907c1(p, y, extraction)
     and foreign_oil_related_income_907c2(p, y, related);
    then combined_income_before_907c4(p, y, extraction + related);
}
// (c)(4)(B): recharacterization of foreign oil extraction losses (pre-2009
// losses); (c)(4)(C): recharacterization of foreign oil and gas losses
// (post-2008); both are capped at the income and at the unrecharacterized
// balance of prior losses (the balances are asserted, TECH-GAPS G1740).
pub relation foreign_oil_extraction_losses_prior_904_907c4B(p: us.irc.core::Person, y: us.irc.core::TaxableYear, aggregate: Money, already_recharacterized: Money) kind empirical {
    label en official "the aggregate foreign oil extraction losses for preceding taxable years beginning after December 31, 1982 and before January 1, 2009, and the amount already recharacterized (section 907(c)(4)(B)(ii))";
}
pub relation foreign_oil_and_gas_losses_prior_907c4C(p: us.irc.core::Person, y: us.irc.core::TaxableYear, aggregate: Money, already_recharacterized: Money) kind empirical {
    label en official "the aggregate foreign oil and gas losses for preceding taxable years beginning after December 31, 2008, and the amount already recharacterized (section 907(c)(4)(C)(ii))";
}
pub relation extraction_loss_recharacterization_907c4B(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the reduction under section 907(c)(4)(B): the lesser of foreign oil and gas extraction income (without regard to (4)) and the excess of aggregate pre-2009 foreign oil extraction losses over the amount already recharacterized";
}
@source(IRC_S907_C, relation = formalizes, coverage = exact, quote = "(i) the foreign oil and gas extraction income of the taxpayer for the taxable year (determined without regard to this paragraph), or")
rule S907C4BExtractionLossRecharacterization defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for extraction: Money;
    for aggregate: Money;
    for recharacterized: Money;
    when foreign_oil_and_gas_extraction_income_907c1(p, y, extraction)
     and foreign_oil_extraction_losses_prior_904_907c4B(p, y, aggregate, recharacterized);
    then extraction_loss_recharacterization_907c4B(p, y, max(0.00 USD, min(extraction, aggregate - recharacterized)));
}
pub relation oil_and_gas_loss_recharacterization_907c4C(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the reduction under section 907(c)(4)(C): the lesser of the combined foreign oil and gas income (without regard to (4)) reduced by the (B) reduction, and the excess of aggregate post-2008 foreign oil and gas losses over the amount already recharacterized";
}
@source(IRC_S907_C, relation = formalizes, coverage = exact, quote = "(i) the combined foreign oil and gas income of the taxpayer for the taxable year (determined without regard to this paragraph), reduced by an amount equal to the reduction under subparagraph (A) for the taxable year, or")
rule S907C4COilAndGasLossRecharacterization defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for combined: Money;
    for b_reduction: Money;
    for aggregate: Money;
    for recharacterized: Money;
    when combined_income_before_907c4(p, y, combined)
     and extraction_loss_recharacterization_907c4B(p, y, b_reduction)
     and foreign_oil_and_gas_losses_prior_907c4C(p, y, aggregate, recharacterized);
    then oil_and_gas_loss_recharacterization_907c4C(p, y, max(0.00 USD, min(combined - b_reduction, aggregate - recharacterized)));
}
pub relation combined_foreign_oil_and_gas_income_after_907c4(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the combined foreign oil and gas income after the section 907(c)(4)(A) reductions (first (B), then (C)), the reductions being treated as foreign-source income that is not combined foreign oil and gas income";
}
@source(IRC_S907_C, relation = formalizes, coverage = exact, quote = "The combined foreign oil and gas income of a taxpayer for a taxable year (determined without regard to this paragraph) shall be reduced—")
rule S907C4AReducedCombinedIncome defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for combined: Money;
    for b_reduction: Money;
    for c_reduction: Money;
    when combined_income_before_907c4(p, y, combined)
     and extraction_loss_recharacterization_907c4B(p, y, b_reduction)
     and oil_and_gas_loss_recharacterization_907c4C(p, y, c_reduction);
    then combined_foreign_oil_and_gas_income_after_907c4(p, y, combined - b_reduction - c_reduction);
}
pub relation oil_and_gas_extraction_taxes_907c5(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "income, war profits and excess profits taxes paid or accrued (or deemed paid under section 960) during the taxable year with respect to foreign oil and gas extraction income (without regard to paragraph (4)) or loss which would be taken into account for section 901";
}
pub relation oil_related_taxes_907b2B(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "income, war profits and excess profits taxes paid or accrued (or deemed paid under section 960) with respect to foreign oil related income (without regard to (c)(4)) or loss";
}
pub relation foreign_oil_and_gas_taxes_907b2(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the foreign oil and gas taxes for the year: oil and gas extraction taxes plus taxes on foreign oil related income (section 907(b)(2))";
}
@source(IRC_S907_B, relation = formalizes, coverage = exact, quote = "The term \"foreign oil and gas taxes\" means, with respect to any taxable year, the sum of—")
rule S907B2ForeignOilAndGasTaxes defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for extraction_taxes: Money;
    for related_taxes: Money;
    when oil_and_gas_extraction_taxes_907c5(p, y, extraction_taxes)
     and oil_related_taxes_907b2B(p, y, related_taxes);
    then foreign_oil_and_gas_taxes_907b2(p, y, extraction_taxes + related_taxes);
}
pub relation corporation_907a(p: us.irc.core::Person) kind empirical {
    label en unofficial "the taxpayer is a corporation, for section 907(a)(2)(A)";
}
pub relation credit_tax_and_entire_taxable_income_907a2B(p: us.irc.core::Person, y: us.irc.core::TaxableYear, credit_tax: Money, entire_taxable_income: Money) kind empirical {
    label en official "for an individual, the tax against which the credit under section 901(a) is taken, and the taxpayer's entire taxable income (section 907(a)(2)(B))";
}
pub relation section_907a_limitation(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the section 907(a) ceiling: combined foreign oil and gas income times the highest section 11(b) rate (a corporation), or times the fraction credit-tax over entire taxable income (an individual)";
}
@source(IRC_S907_A, relation = formalizes, coverage = exact, quote = "(A) in the case of a corporation, the percentage which is equal to the highest rate of tax specified under section 11(b), or")
rule S907A2ACorporationCeiling defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for combined: Money;
    for rate: Decimal;
    when corporation_907a(p)
     and combined_foreign_oil_and_gas_income_after_907c4(p, y, combined)
     and us.irc.corporations::maximum_section_11b_rate(y, rate);
    then section_907a_limitation(p, y, round(combined * rate, 2, "HALF_UP"));
}
@source(IRC_S907_A, relation = formalizes, coverage = exact, quote = "(B) in the case of an individual, a fraction the numerator of which is the tax against which the credit under section 901(a) is taken and the denominator of which is the taxpayer's entire taxable income.")
rule S907A2BIndividualCeiling defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for combined: Money;
    for credit_tax: Money;
    for entire: Money;
    when combined_foreign_oil_and_gas_income_after_907c4(p, y, combined)
     and credit_tax_and_entire_taxable_income_907a2B(p, y, credit_tax, entire)
     and entire > 0.00 USD;
    unless corporation_907a(p)
     and combined_foreign_oil_and_gas_income_after_907c4(p, y, combined)
     and credit_tax_and_entire_taxable_income_907a2B(p, y, credit_tax, entire);
    then section_907a_limitation(p, y, round(combined * (credit_tax / entire), 2, "HALF_UP"));
}
pub relation foreign_oil_and_gas_tax_reduction_907a(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the reduction in the foreign oil and gas taxes taken into account for section 901: the excess of the taxes over the section 907(a) ceiling, if any";
}
@source(IRC_S907_A, relation = formalizes, coverage = exact, quote = "In applying section 901, the amount of any foreign oil and gas taxes paid or accrued (or deemed to have been paid) during the taxable year which would (but for this subsection) be taken into account for purposes of section 901 shall be reduced by the amount (if any) by which the amount of such taxes exceeds the product of—")
rule S907AReduction defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for taxes: Money;
    for ceiling: Money;
    when foreign_oil_and_gas_taxes_907b2(p, y, taxes)
     and section_907a_limitation(p, y, ceiling);
    then foreign_oil_and_gas_tax_reduction_907a(p, y, max(0.00 USD, taxes - ceiling));
}
// §907(d): fair market value in place of a posted price.
pub relation oil_or_gas_disposed_or_acquired_at_posted_price_907d(item_id: Text, posted_price: Money, fair_market_value: Money) kind empirical {
    label en official "oil or gas is disposed of, or acquired other than from the government of a foreign country, at a posted price (or other pricing arrangement) that differs from fair market value";
}
pub relation price_used_for_taxable_income_907d(item_id: Text, price: Money) kind institutional {
    label en official "the price used in determining taxable income from foreign oil and gas extraction income: fair market value in place of a differing posted price (section 907(d))";
}
@source(IRC_S907_D, relation = formalizes, coverage = exact, quote = "such fair market value shall be used in lieu of such posted price (or other pricing arrangement).")
rule S907DFairMarketValueInLieuOfPostedPrice defeasible {
    for item_id: Text;
    for posted: Money;
    for fmv: Money;
    when oil_or_gas_disposed_or_acquired_at_posted_price_907d(item_id, posted, fmv)
     and posted != fmv;
    then price_used_for_taxable_income_907d(item_id, fmv);
}
// §907(f): unused foreign oil and gas taxes carried back 1 year and forward
// 10 years, capped year by year at the lesser of two headrooms; only the cap
// for one target year is computed, the year-to-year chain is a scenario
// (G1/G10/G38-class ledger, TECH-GAPS G1740).
pub relation section_907a_limitation_for_target_year(p: us.irc.core::Person, target: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the limitation provided by subsection (a) for the target taxable year";
}
pub relation foreign_oil_and_gas_taxes_target_year_907f2A(p: us.irc.core::Person, target: us.irc.core::TaxableYear, paid: Money, deemed_from_earlier: Money) kind empirical {
    label en official "the foreign oil and gas taxes paid or accrued during the target year, plus amounts deemed paid in it that are attributable to years before the unused credit year (section 907(f)(2)(A)(i)-(ii))";
}
pub relation section_904_limitation_target_year_907f2B(p: us.irc.core::Person, target: us.irc.core::TaxableYear, limitation: Money, taxes_all_countries: Money, carried_904c: Money, carried_907f: Money) kind empirical {
    label en official "the section 904 limitation for the target year and the sum items (i)-(iii) of section 907(f)(2)(B): all foreign taxes paid, amounts deemed paid under section 904(c) from earlier years, and oil and gas taxes deemed paid under section 907(f) from earlier years";
}
pub relation unused_foreign_oil_and_gas_taxes_deemable_in_year_907f2(p: us.irc.core::Person, target: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the amount of unused foreign oil and gas taxes that may be deemed paid or accrued in the target year: not more than the lesser of the section 907(a) headroom (A) and the section 904 headroom (B), floored at zero (section 907(f)(2))";
}
@source(IRC_S907_F, relation = formalizes, coverage = exact, quote = "The amount of the unused foreign oil and gas taxes which under paragraph (1) may be deemed paid or accrued in any preceding or succeeding taxable year shall not exceed the lesser of—")
rule S907F2CapForTargetYear defeasible {
    for p: us.irc.core::Person;
    for target: us.irc.core::TaxableYear;
    for limit907: Money;
    for paid: Money;
    for deemed_earlier: Money;
    for limit904: Money;
    for all_taxes: Money;
    for c904: Money;
    for c907: Money;
    when section_907a_limitation_for_target_year(p, target, limit907)
     and foreign_oil_and_gas_taxes_target_year_907f2A(p, target, paid, deemed_earlier)
     and section_904_limitation_target_year_907f2B(p, target, limit904, all_taxes, c904, c907);
    then unused_foreign_oil_and_gas_taxes_deemable_in_year_907f2(p, target, max(0.00 USD, min(limit907 - (paid + deemed_earlier), limit904 - (all_taxes + c904 + c907))));
}
