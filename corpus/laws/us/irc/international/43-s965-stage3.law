// Stage 3 (TECH_GAP reduction), module 43: section 965(b)(3)(A)(ii), (b)(4), (b)(5), (c)(3)(D)-(E), (e)(2), (f)(2),
// (g)(3), (h)(4), (i)(2)(B), (i)(4)-(6), (l)(1)(B), (m)(1)(A), (m)(2). Status implemented_unverified: not a legal review;
// scenarios in tests/s965-stage3.lawtest are written, NOT executed.
//
// Modeling notes.
//  * Sums over the members of an affiliated group are asserted directly (a `sum all` over a derived
//    relation is a runtime-subset limit, section 111); the per-member amounts they add up are derived.
//  * Percentages are numbers on a 0-100 scale (60.0 = 60 percent), as elsewhere in the package.
//  * Exact shares: `div_round`; cents HALF_UP is the corpus convention (JUDGMENT CALL).

// --- §965(b)(3)(A)(ii): designation of the deficit --------------------------------------------------------

use self::{
    IRC_S965_B,
    IRC_S965_C,
    IRC_S965_E,
    IRC_S965_F,
    IRC_S965_G,
    IRC_S965_H,
    IRC_S965_I,
    IRC_S965_L,
    IRC_S965_M,
    aggregate_foreign_ep_deficit_allocated_to_corp_965b2,
    amount_included_under_951a1_by_965,
    cash_position_965c3B,
    credit_disallowed_965g1,
    deferral_regime_elected_965i1,
    installment_amount_965h1,
    installment_due_date_965h2,
    installment_regime_elected_965h1,
    net_tax_liability_965h6,
    participation_exemption_deduction_965c1,
    recapture_tax_increase_965l1A,
    reit_inclusion_amount_965m1,
    reit_inclusion_share_965m1B,
    reit_us_shareholder_election_965m1B,
    s_corp_liquidation_or_cessation_965i2Aii,
    s_corp_shareholder_net_tax_liability_965i3,
    shareholder_aggregate_pro_rata_accumulated_deferred_income_965b2B,
    shareholder_pro_rata_share_of_subpart_f_increase_965b1,
    shareholder_pro_rata_specified_ep_deficits_965b3Ai,
    triggering_event_965i2,
};

pub relation deficit_designation_required_965b3Aii(shareholder: us.irc.core::Person) kind institutional {
    label en official "the aggregate of the shareholder's pro rata specified E&P deficits (clause (i)(I)) exceeds the aggregate pro rata accumulated post-1986 deferred foreign income (clause (i)(II)), so the shareholder designates the deficit to be taken into account";
}
@source(IRC_S965_B, relation = formalizes, coverage = exact, quote = "If the amount described in clause (i)(II) is less than the amount described in clause (i)(I), then the")
rule S965B3AiiDesignationRequired defeasible {
    for shareholder: us.irc.core::Person;
    for deficits: Money;
    for deferred: Money;
    when shareholder_pro_rata_specified_ep_deficits_965b3Ai(shareholder, deficits)
     and shareholder_aggregate_pro_rata_accumulated_deferred_income_965b2B(shareholder, deferred)
     and deferred < deficits;
    then deficit_designation_required_965b3Aii(shareholder);
}
pub relation deficit_designation_made_965b3Aii(shareholder: us.irc.core::Person) kind empirical {
    label en official "the shareholder has designated, in the form and manner the Secretary determines, the specified E&P deficit taken into account for each E&P deficit corporation and the qualified-deficit portion with the qualified activities to which it is attributable";
}
pub relation designated_deficit_for_corporation_965b3AiiI(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, amount: Money) kind empirical {
    label en official "the amount of the specified E&P deficit designated to be taken into account for the E&P deficit corporation";
}
pub relation designated_qualified_deficit_portion_965b3AiiII(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, amount: Money, activity: Text) kind empirical {
    label en official "the portion of the designated deficit attributable to a qualified deficit (section 952), and the qualified activity to which it is attributable";
}
@source(IRC_S965_B, relation = formalizes, coverage = exact, quote = "If the amount described in clause (i)(II) is less than the amount described in clause (i)(I), then the")
rule S965B3AiiDutyToDesignate defeasible {
    for shareholder: us.irc.core::Person;
    when deficit_designation_required_965b3Aii(shareholder);
    then duty S965B3AiiDesignationDuty {
        bearer shareholder;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition deficit_designation_made_965b3Aii(shareholder);
            window [-infinity, infinity];
        }
    };
}

// --- §965(b)(4): future-year treatment of the reduction and of the deficits ----------------------------------

pub relation reduction_treated_as_previously_taxed_965b4A(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, amount: Money) kind institutional {
    label en official "the reduction under paragraph (1) allocated to the deferred foreign income corporation is treated, for section 959 in years beginning with the year of subsection (a), as an amount included in the shareholder's gross income under section 951(a)";
}
@source(IRC_S965_B, relation = formalizes, coverage = exact, quote = "For purposes of applying section 959 in any taxable year beginning with the taxable year described in")
rule S965B4AReductionTreatedAsPreviouslyTaxed defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for increase: Money;
    for allocated: Money;
    when shareholder_pro_rata_share_of_subpart_f_increase_965b1(shareholder, corp, increase)
     and aggregate_foreign_ep_deficit_allocated_to_corp_965b2(shareholder, corp, allocated);
    then reduction_treated_as_previously_taxed_965b4A(shareholder, corp, min(increase, allocated));
}
pub relation specified_deficit_taken_into_account_965b4B(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, amount: Money, activity: Text) kind empirical {
    label en official "the specified E&P deficit of the E&P deficit corporation taken into account by the shareholder under paragraph (1), and the activity to which the deficit was attributable";
}
pub relation pro_rata_earnings_increase_965b4B(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, amount: Money, activity: Text) kind institutional {
    label en official "for years beginning with the year of subsection (a), the shareholder's pro rata share of the earnings and profits of the E&P deficit corporation is increased by the deficit taken into account, and for section 952 the increase is attributable to the same activity";
}
@source(IRC_S965_B, relation = formalizes, coverage = exact, quote = "For purposes of this title, with respect to any taxable year beginning with the taxable year described in")
rule S965B4BEarningsIncreaseByDeficitTakenIntoAccount defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for amount: Money;
    for activity: Text;
    when specified_deficit_taken_into_account_965b4B(shareholder, corp, amount, activity);
    then pro_rata_earnings_increase_965b4B(shareholder, corp, amount, activity);
}

// --- §965(b)(5): netting among United States shareholders of the same affiliated group -----------------------

pub relation affiliated_group_member_965b5(group: us.irc.core::Person, shareholder: us.irc.core::Person) kind empirical {
    label en official "the United States shareholder is a member of the affiliated group (section 1504)";
}
pub relation shareholder_amount_before_netting_965b5(group: us.irc.core::Person, shareholder: us.irc.core::Person, amount: Money) kind empirical {
    label en official "the amount which would (but for paragraph (5)) be taken into account by the shareholder under section 951(a)(1) by reason of subsection (a)";
}
pub relation shareholder_aggregate_foreign_ep_deficit_without_3Ai_II_965b5C(group: us.irc.core::Person, shareholder: us.irc.core::Person, amount: Money) kind empirical {
    label en official "the shareholder's aggregate foreign E&P deficit as defined in paragraph (3)(A) without regard to clause (i)(II)";
}
pub relation is_common_parent_of_affiliated_group_965b5F(group: us.irc.core::Person, shareholder: us.irc.core::Person) kind empirical {
    label en official "the shareholder is the common parent of the affiliated group";
}
pub relation group_ownership_percent_held_by_other_includible_corporations_965b5F(group: us.irc.core::Person, shareholder: us.irc.core::Person, percent: Decimal) kind empirical {
    label en official "the percentage of the value of the stock of the shareholder held by other includible corporations in the affiliated group (terms as in section 1504)";
}
pub relation group_ownership_percentage_965b5F(group: us.irc.core::Person, shareholder: us.irc.core::Person, percent: Decimal) kind institutional {
    label en official "the group ownership percentage: the percentage of the value of the shareholder's stock held by other includible corporations in the group; 100 percent for the common parent";
}
@source(IRC_S965_B, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the term \"group ownership percentage\" means, with respect to any United")
rule S965B5FCommonParentHundredPercent defeasible {
    for group: us.irc.core::Person;
    for shareholder: us.irc.core::Person;
    when is_common_parent_of_affiliated_group_965b5F(group, shareholder);
    then group_ownership_percentage_965b5F(group, shareholder, 100.0);
}
@source(IRC_S965_B, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the term \"group ownership percentage\" means, with respect to any United")
rule S965B5FGroupOwnershipByHeldValue defeasible {
    for group: us.irc.core::Person;
    for shareholder: us.irc.core::Person;
    for percent: Decimal;
    when group_ownership_percent_held_by_other_includible_corporations_965b5F(group, shareholder, percent);
    unless is_common_parent_of_affiliated_group_965b5F(group, shareholder)
     and group_ownership_percent_held_by_other_includible_corporations_965b5F(group, shareholder, percent);
    then group_ownership_percentage_965b5F(group, shareholder, percent);
}
pub relation ep_net_surplus_shareholder_965b5B(group: us.irc.core::Person, shareholder: us.irc.core::Person) kind institutional {
    label en official "an E&P net surplus shareholder: a United States shareholder that would (without regard to paragraph (5)) take into account an amount greater than zero under section 951(a)(1) by reason of subsection (a)";
}
@source(IRC_S965_B, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the term \"E&P net surplus shareholder\" means any United States shareholder")
rule S965B5BNetSurplusShareholder defeasible {
    for group: us.irc.core::Person;
    for shareholder: us.irc.core::Person;
    for amount: Money;
    when affiliated_group_member_965b5(group, shareholder)
     and shareholder_amount_before_netting_965b5(group, shareholder, amount)
     and amount > 0.00 USD;
    then ep_net_surplus_shareholder_965b5B(group, shareholder);
}
pub relation ep_net_deficit_shareholder_965b5C(group: us.irc.core::Person, shareholder: us.irc.core::Person) kind institutional {
    label en official "an E&P net deficit shareholder: the aggregate foreign E&P deficit (paragraph (3)(A) without clause (i)(II)) exceeds the amount that would be taken into account under section 951(a)(1) by reason of subsection (a)";
}
pub relation net_deficit_excess_965b5C(group: us.irc.core::Person, shareholder: us.irc.core::Person, excess: Money) kind institutional {
    label en official "the excess described in subparagraph (C): the aggregate foreign E&P deficit over the amount that would be taken into account";
}
@source(IRC_S965_B, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the term \"E&P net deficit shareholder\" means any United States shareholder if—")
rule S965B5CNetDeficitShareholder defeasible {
    for group: us.irc.core::Person;
    for shareholder: us.irc.core::Person;
    for deficit: Money;
    for amount: Money;
    when affiliated_group_member_965b5(group, shareholder)
     and shareholder_aggregate_foreign_ep_deficit_without_3Ai_II_965b5C(group, shareholder, deficit)
     and shareholder_amount_before_netting_965b5(group, shareholder, amount)
     and deficit > amount;
    then ep_net_deficit_shareholder_965b5C(group, shareholder);
}
@source(IRC_S965_B, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the term \"E&P net deficit shareholder\" means any United States shareholder if—")
rule S965B5CNetDeficitExcess defeasible {
    for group: us.irc.core::Person;
    for shareholder: us.irc.core::Person;
    for deficit: Money;
    for amount: Money;
    when affiliated_group_member_965b5(group, shareholder)
     and shareholder_aggregate_foreign_ep_deficit_without_3Ai_II_965b5C(group, shareholder, deficit)
     and shareholder_amount_before_netting_965b5(group, shareholder, amount)
     and deficit > amount;
    then net_deficit_excess_965b5C(group, shareholder, deficit - amount);
}
pub relation net_deficit_excess_taken_into_account_965b5Dii(group: us.irc.core::Person, shareholder: us.irc.core::Person, amount: Money) kind institutional {
    label en official "the excess taken into account under clause (i)(I) for a net deficit shareholder: the excess, or the group ownership percentage of it where that percentage is less than 100 percent";
}
@source(IRC_S965_B, relation = formalizes, coverage = exact, quote = "If the group ownership percentage of any E&P net deficit shareholder is less than 100 percent, the amount of")
rule S965B5DiiExcessByGroupOwnershipPercentage defeasible {
    for group: us.irc.core::Person;
    for shareholder: us.irc.core::Person;
    for excess: Money;
    for percent: Decimal;
    when net_deficit_excess_965b5C(group, shareholder, excess)
     and group_ownership_percentage_965b5F(group, shareholder, percent);
    then net_deficit_excess_taken_into_account_965b5Dii(group, shareholder, round(excess * (min(percent, 100.0) / 100.0), 2, "HALF_UP"));
}
pub relation sum_of_net_deficit_excesses_taken_into_account_965b5Di_I(group: us.irc.core::Person, amount: Money) kind empirical {
    label en unofficial "the sum, over the E&P net deficit shareholders of the group, of the amounts taken into account under clause (ii) (asserted directly: a sum over a derived relation, section 111)";
}
pub relation sum_of_surplus_shareholder_products_965b5E(group: us.irc.core::Person, amount: Money) kind empirical {
    label en unofficial "the aggregate, over all E&P net surplus shareholders of the group, of the product of group ownership percentage and the amount that would be taken into account (subparagraph (E)(i); asserted directly: a sum, section 111)";
}
pub relation aggregate_unused_ep_deficit_965b5D(group: us.irc.core::Person, amount: Money) kind institutional {
    label en official "the aggregate unused E&P deficit of the affiliated group: the lesser of the sum of the net deficit excesses (clause (i)(I)) and the aggregate amount determined under subparagraph (E)(ii)";
}
@source(IRC_S965_B, relation = formalizes, coverage = exact, quote = "The term \"aggregate unused E&P deficit\" means, with respect to any affiliated group, the lesser of—")
rule S965B5DiAggregateUnusedDeficit defeasible {
    for group: us.irc.core::Person;
    for excesses: Money;
    for products: Money;
    when sum_of_net_deficit_excesses_taken_into_account_965b5Di_I(group, excesses)
     and sum_of_surplus_shareholder_products_965b5E(group, products);
    then aggregate_unused_ep_deficit_965b5D(group, min(excesses, products));
}
pub relation surplus_shareholder_product_965b5E(group: us.irc.core::Person, shareholder: us.irc.core::Person, amount: Money) kind institutional {
    label en official "the product of the shareholder's group ownership percentage and the amount that would be taken into account under section 951(a)(1) by reason of subsection (a)";
}
@source(IRC_S965_B, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the term \"applicable share\" means, with respect to any E&P net surplus")
rule S965B5EProductForSurplusShareholder defeasible {
    for group: us.irc.core::Person;
    for shareholder: us.irc.core::Person;
    for amount: Money;
    for percent: Decimal;
    when ep_net_surplus_shareholder_965b5B(group, shareholder)
     and shareholder_amount_before_netting_965b5(group, shareholder, amount)
     and group_ownership_percentage_965b5F(group, shareholder, percent);
    then surplus_shareholder_product_965b5E(group, shareholder, round(amount * (percent / 100.0), 2, "HALF_UP"));
}
pub relation applicable_share_965b5E(group: us.irc.core::Person, shareholder: us.irc.core::Person, amount: Money) kind institutional {
    label en official "the applicable share of the group's aggregate unused E&P deficit of an E&P net surplus shareholder: in the proportion its product bears to the aggregate of the products";
}
@source(IRC_S965_B, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the term \"applicable share\" means, with respect to any E&P net surplus")
rule S965B5EApplicableShare defeasible {
    for group: us.irc.core::Person;
    for shareholder: us.irc.core::Person;
    for unused: Money;
    for product: Money;
    for products: Money;
    when aggregate_unused_ep_deficit_965b5D(group, unused)
     and surplus_shareholder_product_965b5E(group, shareholder, product)
     and sum_of_surplus_shareholder_products_965b5E(group, products)
     and products > 0.00 USD;
    then applicable_share_965b5E(group, shareholder, div_round(unused * (product / 1.00 USD), products / 1.00 USD, 2, "HALF_UP"));
}
pub relation amount_after_netting_965b5A(group: us.irc.core::Person, shareholder: us.irc.core::Person, amount: Money) kind institutional {
    label en official "the amount taken into account under section 951(a)(1) by reason of subsection (a) after the reduction by the applicable share, but not below zero (the group must include at least one net surplus and one net deficit shareholder: the applicable share exists only then)";
}
@source(IRC_S965_B, relation = formalizes, coverage = exact, quote = "In the case of any affiliated group which includes at least one E&P net surplus shareholder and one E&P net")
rule S965B5AReductionByApplicableShare defeasible {
    for group: us.irc.core::Person;
    for shareholder: us.irc.core::Person;
    for before: Money;
    for share: Money;
    when shareholder_amount_before_netting_965b5(group, shareholder, before)
     and applicable_share_965b5E(group, shareholder, share);
    then amount_after_netting_965b5A(group, shareholder, max(before - share, 0.00 USD));
}

// --- §965(c)(3)(D)-(E): cash positions -------------------------------------------------------------------------

pub relation cash_position_of_class_ii_iiiI_iiiIV_965c3D(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation) kind empirical {
    label en official "the cash position of the specified foreign corporation is described in clause (ii), (iii)(I) or (iii)(IV) of subparagraph (B)";
}
pub relation cash_position_counted_for_another_sfc_965c3D(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, amount: Money) kind empirical {
    label en official "the amount of the cash position that the shareholder takes into account with respect to another specified foreign corporation";
}
external judgment relation secretary_satisfied_no_double_count_965c3D(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation) {
    authority Secretary;
    label en official "the shareholder demonstrates to the satisfaction of the Secretary that the cash position is taken into account with respect to another specified foreign corporation (section 965(c)(3)(D)) — committed to the Secretary's satisfaction (DECISION-0194)";
}
pub relation cash_position_excluded_as_double_count_965c3D(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, amount: Money) kind institutional {
    label en official "the cash position not taken into account under subparagraph (A), to the extent it is taken into account with respect to another specified foreign corporation";
}
@source(IRC_S965_C, relation = formalizes, coverage = exact, quote = "Cash positions of a specified foreign corporation described in clause (ii), (iii)(I), or (iii)(IV) of")
rule S965C3DPreventionOfDoubleCounting defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for counted: Money;
    for position: Money;
    when cash_position_of_class_ii_iiiI_iiiIV_965c3D(shareholder, corp)
     and cash_position_counted_for_another_sfc_965c3D(shareholder, corp, counted)
     and cash_position_965c3B(corp, position)
     and secretary_satisfied_no_double_count_965c3D(shareholder, corp);
    then cash_position_excluded_as_double_count_965c3D(shareholder, corp, min(counted, position));
}
pub relation entity_interest_held_by_sfc_965c3E(shareholder: us.irc.core::Person, holding: us.irc.core::Person) kind empirical {
    label en official "an interest in the entity (other than a corporation) is held by a specified foreign corporation of the shareholder (determined after application of this subparagraph)";
}
pub relation entity_would_be_sfc_if_corporation_965c3E(shareholder: us.irc.core::Person, holding: us.irc.core::Person) kind empirical {
    label en official "the entity would be a specified foreign corporation of the shareholder if it were a foreign corporation";
}
pub relation noncorporate_entity_treated_as_sfc_965c3E(shareholder: us.irc.core::Person, holding: us.irc.core::Person) kind institutional {
    label en official "the entity is treated as a specified foreign corporation of the shareholder for the aggregate foreign cash position (the chain through specified foreign corporations of the shareholder is a case input, not a recursion)";
}
@source(IRC_S965_C, relation = formalizes, coverage = exact, quote = "An entity (other than a corporation) shall be treated as a specified foreign corporation of a United States")
rule S965C3ENoncorporateEntityTreatedAsSfc defeasible {
    for shareholder: us.irc.core::Person;
    for holding: us.irc.core::Person;
    when entity_interest_held_by_sfc_965c3E(shareholder, holding)
     and entity_would_be_sfc_if_corporation_965c3E(shareholder, holding);
    then noncorporate_entity_treated_as_sfc_965c3E(shareholder, holding);
}

// --- §965(e)(2): treated as a controlled foreign corporation for subpart F inclusion only ----------------------

pub relation foreign_corp_with_domestic_corporate_shareholder_965e1B(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation) kind empirical {
    label en official "the foreign corporation is described in paragraph (1)(B): a foreign corporation with a domestic corporation as a United States shareholder that is not itself a controlled foreign corporation";
}
pub relation treated_as_cfc_solely_for_965_inclusion_965e2(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation) kind institutional {
    label en official "for sections 951 and 961 the corporation is treated as a controlled foreign corporation solely to take into account its subpart F income under subsection (a) (and to apply subsection (f))";
}
@source(IRC_S965_E, relation = formalizes, coverage = exact, quote = "For purposes of sections 951 and 961, a foreign corporation described in paragraph (1)(B) shall be treated as")
rule S965E2TreatedAsCfcSolelyForInclusion defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    when foreign_corp_with_domestic_corporate_shareholder_965e1B(shareholder, corp);
    then treated_as_cfc_solely_for_965_inclusion_965e2(shareholder, corp);
}

// --- §965(f)(2): S corporation shareholders ----------------------------------------------------------------------------

pub relation deducted_portion_is_exempt_income_for_705_1367_965f2A(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the portion included under section 951(a)(1) by reason of subsection (a) that equals the deduction allowed under subsection (c) is treated as income exempt from tax for sections 705(a)(1)(B) and 1367(a)(1)(A)";
}
@source(IRC_S965_F, relation = formalizes, coverage = exact, quote = "(A) shall be treated as income exempt from tax for purposes of sections 705(a)(1)(B) and 1367(a)(1)(A), and")
rule S965F2ADeductedPortionExemptForBasis defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for deduction: Money;
    when participation_exemption_deduction_965c1(shareholder, y, deduction)
     and deduction > 0.00 USD;
    then deducted_portion_is_exempt_income_for_705_1367_965f2A(shareholder, y, deduction);
}
pub relation deducted_portion_not_exempt_income_for_accumulated_adjustments_account_965f2B(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the same portion is not treated as income exempt from tax for the adjustment to the accumulated adjustment account under section 1368(e)(1)(A)";
}
@source(IRC_S965_F, relation = formalizes, coverage = exact, quote = "(B) shall not be treated as income exempt from tax for purposes of determining whether an adjustment shall be")
rule S965F2BDeductedPortionNotExemptForAaa defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for deduction: Money;
    when participation_exemption_deduction_965c1(shareholder, y, deduction)
     and deduction > 0.00 USD;
    then deducted_portion_not_exempt_income_for_accumulated_adjustments_account_965f2B(shareholder, y, deduction);
}

// --- §965(g)(3): no deduction for the disallowed-credit tax --------------------------------------------------------

pub relation deduction_disallowed_for_tax_denied_credit_965g3(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "no deduction is allowed under chapter 1 for a tax for which credit is not allowable under section 901 by reason of paragraph (1), the taxpayer being treated as having elected the credit";
}
@source(IRC_S965_G, relation = formalizes, coverage = exact, quote = "No deduction shall be allowed under this chapter for any tax for which credit is not allowable under section")
rule S965G3NoDeductionForDisallowedCredit defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for disallowed: Money;
    when credit_disallowed_965g1(shareholder, y, disallowed)
     and disallowed > 0.00 USD;
    then deduction_disallowed_for_tax_denied_credit_965g3(shareholder, y, disallowed);
}

// --- §965(h)(4): proration of a deficiency to the installments ------------------------------------------------------

pub relation deficiency_assessed_965h4(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "a deficiency assessed with respect to the net tax liability under section 965 for which the installment election was made";
}
pub relation deficiency_due_to_negligence_disregard_or_fraud_965h4(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the deficiency is due to negligence, intentional disregard of rules and regulations, or fraud with intent to evade tax";
}
pub relation deficiency_prorated_to_installment_965h4(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, index: Integer, amount: Money) kind institutional {
    label en official "the part of the deficiency prorated to the installment, in proportion to the installment amounts payable under paragraph (1)";
}
@source(IRC_S965_H, relation = formalizes, coverage = exact, quote = "If an election is made under paragraph (1) to pay the net tax liability under this section in installments")
rule S965H4DeficiencyProratedToInstallments defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for k: Integer;
    for deficiency: Money;
    for installment: Money;
    for liability: Money;
    when installment_regime_elected_965h1(shareholder, y)
     and deficiency_assessed_965h4(shareholder, y, deficiency)
     and installment_amount_965h1(shareholder, y, k, installment)
     and net_tax_liability_965h6(shareholder, y, liability)
     and liability > 0.00 USD;
    unless deficiency_due_to_negligence_disregard_or_fraud_965h4(shareholder, y)
     and deficiency_assessed_965h4(shareholder, y, deficiency)
     and installment_amount_965h1(shareholder, y, k, installment)
     and net_tax_liability_965h6(shareholder, y, liability);
    then deficiency_prorated_to_installment_965h4(shareholder, y, k, div_round(deficiency * (installment / 1.00 USD), liability / 1.00 USD, 2, "HALF_UP"));
}
pub relation installment_date_arrived_965h4(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, index: Integer, as_of: Date) kind institutional {
    label en official "the date for payment of the installment has arrived on the date tested";
}
@source(IRC_S965_H, relation = formalizes, coverage = exact, quote = "If an election is made under paragraph (1) to pay the net tax liability under this section in installments")
rule S965H4InstallmentDateArrived defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for k: Integer;
    for as_of: Date;
    for due: Date;
    when installment_due_date_965h2(shareholder, y, k, due)
     and deficiency_test_date_965h4(shareholder, y, as_of)
     and as_of >= due;
    then installment_date_arrived_965h4(shareholder, y, k, as_of);
}
pub relation deficiency_test_date_965h4(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, as_of: Date) kind empirical {
    label en unofficial "the date on which it is tested whether an installment date has arrived (a domain anchor)";
}
pub relation deficiency_part_collected_with_installment_965h4(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, index: Integer, amount: Money) kind institutional {
    label en official "the part of the deficiency prorated to an installment whose date has not arrived is collected at the same time as, and as part of, that installment";
}
@source(IRC_S965_H, relation = formalizes, coverage = exact, quote = "If an election is made under paragraph (1) to pay the net tax liability under this section in installments")
rule S965H4PartCollectedWithFutureInstallment defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for k: Integer;
    for as_of: Date;
    for due: Date;
    for part: Money;
    when deficiency_prorated_to_installment_965h4(shareholder, y, k, part)
     and installment_due_date_965h2(shareholder, y, k, due)
     and deficiency_test_date_965h4(shareholder, y, as_of)
     and as_of < due;
    then deficiency_part_collected_with_installment_965h4(shareholder, y, k, part);
}
pub relation deficiency_part_payable_on_notice_and_demand_965h4(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, index: Integer, amount: Money) kind institutional {
    label en official "the part of the deficiency prorated to an installment whose date has arrived is paid upon notice and demand from the Secretary";
}
@source(IRC_S965_H, relation = formalizes, coverage = exact, quote = "If an election is made under paragraph (1) to pay the net tax liability under this section in installments")
rule S965H4PartPayableOnNoticeAndDemand defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for k: Integer;
    for as_of: Date;
    for due: Date;
    for part: Money;
    when deficiency_prorated_to_installment_965h4(shareholder, y, k, part)
     and installment_due_date_965h2(shareholder, y, k, due)
     and deficiency_test_date_965h4(shareholder, y, as_of)
     and as_of >= due;
    then deficiency_part_payable_on_notice_and_demand_965h4(shareholder, y, k, part);
}

// --- §965(i)(2)(B), (4), (5), (6): S corporation deferral ------------------------------------------------------------

pub relation s_corp_shares_transferred_and_total_965i2B(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, transferred: Integer, total: Integer) kind empirical {
    label en official "the number of the taxpayer's shares of stock in the S corporation transferred, and the number the taxpayer held";
}
pub relation triggering_liability_of_partial_transfer_965i2B(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "a transfer of less than all the shares is a triggering event only for the part of the net tax liability properly allocable to the transferred stock (allocated pro rata by shares; JUDGMENT CALL: the statute says properly allocable)";
}
@source(IRC_S965_I, relation = formalizes, coverage = exact, quote = "In the case of a transfer of less than all of the taxpayer's shares of stock in the S corporation, such")
rule S965I2BPartialTransferTriggersProportionately defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for transferred: Integer;
    for total: Integer;
    for liability: Money;
    when s_corp_shares_transferred_and_total_965i2B(shareholder, y, transferred, total)
     and s_corp_shareholder_net_tax_liability_965i3(shareholder, y, liability)
     and total > 0
     and transferred < total;
    then triggering_liability_of_partial_transfer_965i2B(shareholder, y, div_round(liability * (transferred * 1.00), total * 1.00, 2, "HALF_UP"));
}
pub relation installment_election_made_on_965i4B(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, made_on: Date) kind empirical {
    label en official "the date on which the taxpayer made the election under subsection (h) for the deferred liability";
}
pub relation triggering_year_return_due_date_965i4(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, due: Date) kind empirical {
    label en official "the due date (without regard to any extension) of the return of tax for the taxable year in which the triggering event occurs";
}
pub relation deferred_liability_installments_separate_965i4A(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "subsection (h) is applied separately with respect to the deferred liability to which the election applies";
}
@source(IRC_S965_I, relation = formalizes, coverage = exact, quote = "(A) subsection (h) shall be applied separately with respect to the liability to which such election applies,")
rule S965I4AHApplicableSeparately defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for made_on: Date;
    when deferral_regime_elected_965i1(shareholder, y)
     and installment_election_made_on_965i4B(shareholder, y, made_on);
    then deferred_liability_installments_separate_965i4A(shareholder, y);
}
pub relation deferred_liability_installment_election_timely_965i4B(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the election under subsection (h) for the deferred liability is timely if made not later than the due date for the return for the year of the triggering event";
}
@source(IRC_S965_I, relation = formalizes, coverage = exact, quote = "(B) an election under subsection (h) with respect to such liability shall be treated as timely made if made")
rule S965I4BElectionTimelyByTriggeringYearReturnDate defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for made_on: Date;
    for due: Date;
    when deferral_regime_elected_965i1(shareholder, y)
     and installment_election_made_on_965i4B(shareholder, y, made_on)
     and triggering_year_return_due_date_965i4(shareholder, y, due)
     and made_on <= due;
    then deferred_liability_installment_election_timely_965i4B(shareholder, y);
}
pub relation deferred_liability_first_installment_due_965i4C(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, due: Date) kind institutional {
    label en official "the first installment for the deferred liability is paid not later than the due date for the triggering-year return, determined without regard to any extension of time for filing";
}
@source(IRC_S965_I, relation = formalizes, coverage = exact, quote = "(C) the first installment under subsection (h) with respect to such liability shall be paid not later than")
rule S965I4CFirstInstallmentDueDate defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for due: Date;
    when deferral_regime_elected_965i1(shareholder, y)
     and triggering_year_return_due_date_965i4(shareholder, y, due);
    then deferred_liability_first_installment_due_965i4C(shareholder, y, due);
}
pub relation secretary_consents_to_installment_election_965i4D(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the Secretary consents to the election under subsection (h) for the liability";
}
pub relation installment_election_permitted_965i4D(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the election under subsection (h) for the deferred liability may be made: where the triggering event is a liquidation, sale of substantially all assets, cessation of business or similar circumstance (paragraph (2)(A)(ii)) only with the Secretary's consent";
}
@source(IRC_S965_I, relation = formalizes, coverage = exact, quote = "(D) if the triggering event with respect to any net tax liability is described in paragraph (2)(A)(ii), an")
rule S965I4DConsentWhereLiquidationOrCessation defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for on: Date;
    when s_corp_liquidation_or_cessation_965i2Aii(shareholder, y, on)
     and secretary_consents_to_installment_election_965i4D(shareholder, y);
    then installment_election_permitted_965i4D(shareholder, y);
}
@source(IRC_S965_I, relation = formalizes, coverage = exact, quote = "(D) if the triggering event with respect to any net tax liability is described in paragraph (2)(A)(ii), an")
rule S965I4DOtherTriggeringEventsNoConsent defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for on: Date;
    when triggering_event_965i2(shareholder, y, on);
    unless s_corp_liquidation_or_cessation_965i2Aii(shareholder, y, on)
     and triggering_event_965i2(shareholder, y, on);
    then installment_election_permitted_965i4D(shareholder, y);
}
pub relation s_corporation_of_deferring_shareholder_965i5(s_corp: us.irc.core::Person, shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the S corporation whose shareholder elects to defer payment under paragraph (1)";
}
pub relation s_corporation_jointly_and_severally_liable_965i5(s_corp: us.irc.core::Person, shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the S corporation is jointly and severally liable for the deferred payment and any penalty, addition to tax or additional amount attributable to it";
}
@source(IRC_S965_I, relation = formalizes, coverage = exact, quote = "If any shareholder of an S corporation elects to defer payment under paragraph (1), such S corporation shall")
rule S965I5JointAndSeveralLiabilityOfSCorporation defeasible {
    for s_corp: us.irc.core::Person;
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when s_corporation_of_deferring_shareholder_965i5(s_corp, shareholder, y)
     and deferral_regime_elected_965i1(shareholder, y);
    then s_corporation_jointly_and_severally_liable_965i5(s_corp, shareholder, y);
}
pub relation collection_period_start_bound_965i6(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, not_before: Date) kind institutional {
    label en official "a limitation on the time for collecting the deferred liability is not treated as beginning before the date of the triggering event";
}
@source(IRC_S965_I, relation = formalizes, coverage = exact, quote = "Any limitation on the time period for the collection of a liability deferred under this subsection shall not")
rule S965I6CollectionLimitationNotBeforeTriggeringEvent defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for on: Date;
    when triggering_event_965i2(shareholder, y, on);
    then collection_period_start_bound_965i6(shareholder, y, on);
}

// --- §965(l)(1)(B), (m) ---------------------------------------------------------------------------------------------------

pub relation credits_not_allowed_against_recapture_increase_965l1B(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, increase: Money) kind institutional {
    label en official "no credits are allowed against the increase in tax under subparagraph (A)";
}
@source(IRC_S965_L, relation = formalizes, coverage = exact, quote = "(B) no credits shall be allowed against the increase in tax under subparagraph (A).")
rule S965L1BNoCreditsAgainstIncrease defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for increase: Money;
    when recapture_tax_increase_965l1A(shareholder, y, increase);
    then credits_not_allowed_against_recapture_increase_965l1B(shareholder, y, increase);
}
pub relation reit_is_united_states_shareholder_of_dfic_965m1(shareholder: us.irc.core::Person) kind empirical {
    label en official "the real estate investment trust is a United States shareholder in one or more deferred foreign income corporations";
}
pub relation amount_not_gross_income_for_856c2_856c3_965m1A(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the amount required to be taken into account under section 951(a)(1) by reason of section 965 is not gross income of the real estate investment trust for the section 856(c)(2) and (3) tests for the year it is taken into account";
}
@source(IRC_S965_M, relation = formalizes, coverage = exact, quote = "(A) any amount required to be taken into account under section 951(a)(1) by reason of this section shall not")
rule S965M1AReitInclusionNotGrossIncomeFor856c defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when reit_is_united_states_shareholder_of_dfic_965m1(shareholder)
     and amount_included_under_951a1_by_965(shareholder, y, amount);
    then amount_not_gross_income_for_856c2_856c3_965m1A(shareholder, y, amount);
}
pub relation reit_election_made_on_965m2A(shareholder: us.irc.core::Person, made_on: Date) kind empirical {
    label en official "the date on which the real estate investment trust made the election under paragraph (1)(B)";
}
pub relation due_date_of_first_year_of_reit_period_965m2A(shareholder: us.irc.core::Person, due: Date) kind empirical {
    label en official "the due date for the first taxable year in the 5-taxable year period described in paragraph (1)(B)(i)";
}
pub relation reit_election_timely_965m2A(shareholder: us.irc.core::Person) kind institutional {
    label en official "the election under paragraph (1)(B) is made not later than the due date for the first taxable year in the 5-taxable year period";
}
@source(IRC_S965_M, relation = formalizes, coverage = exact, quote = "Any election under paragraph (1)(B) shall be made not later than the due date for the first taxable year in")
rule S965M2AReitElectionTimely defeasible {
    for shareholder: us.irc.core::Person;
    for made_on: Date;
    for due: Date;
    when reit_election_made_on_965m2A(shareholder, made_on)
     and due_date_of_first_year_of_reit_period_965m2A(shareholder, due)
     and made_on <= due;
    then reit_election_timely_965m2A(shareholder);
}
pub relation section_965c1_aggregate_amount_965m2Bi(shareholder: us.irc.core::Person, amount: Money) kind empirical {
    label en official "the aggregate amount to which subparagraph (A) or (B) of subsection (c)(1) applies, determined without regard to the election";
}
pub relation aggregate_amount_allocated_to_reit_year_965m2BiII(shareholder: us.irc.core::Person, year_index: Integer, amount: Money) kind institutional {
    label en official "the aggregate amount allocated to each taxable year of the schedule in the same proportion as the section 951(a)(1) amount is allocated to that year";
}
@source(IRC_S965_M, relation = formalizes, coverage = exact, quote = "(II) each such aggregate amount shall be allocated to each taxable year described in paragraph (1)(B) in the")
rule S965M2BiIIAllocationLikeInclusion defeasible {
    for shareholder: us.irc.core::Person;
    for k: Integer;
    for aggregate: Money;
    for share: Money;
    for total: Money;
    when reit_election_timely_965m2A(shareholder)
     and section_965c1_aggregate_amount_965m2Bi(shareholder, aggregate)
     and reit_inclusion_share_965m1B(shareholder, k, share)
     and reit_inclusion_amount_965m1(shareholder, total)
     and total > 0.00 USD;
    then aggregate_amount_allocated_to_reit_year_965m2BiII(shareholder, k, div_round(aggregate * (share / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}
pub relation reit_makes_installment_election_965m2BiIII(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the real estate investment trust makes an election under the installment subsection for a taxable year described in paragraph (1)(B)";
}
@source(IRC_S965_M, relation = formalizes, coverage = exact, quote = "(III) No installment payments.—The real estate investment trust may not make an election under subsection (g)")
rule S965M2BiIIINoInstallmentElection defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when reit_us_shareholder_election_965m1B(shareholder)
     and reit_makes_installment_election_965m2BiIII(shareholder, y);
    then prohibition S965M2BiIIINoInstallmentElectionBar {
        bearer shareholder;
        action reit_makes_installment_election_965m2BiIII(shareholder, y);
        window [-infinity, infinity];
    };
}
pub relation reit_liquidation_sale_or_cessation_965m2Bii(shareholder: us.irc.core::Person, event_on: Date) kind empirical {
    label en official "a liquidation or sale of substantially all the assets of the real estate investment trust (including in a title 11 or similar case), a cessation of business, or a similar circumstance, on this date (the day before the petition in a title 11 case)";
}
pub relation reit_amount_not_yet_included_965m2Bii(shareholder: us.irc.core::Person, amount: Money) kind empirical {
    label en official "the amount not yet included in gross income under paragraph (1)(B)";
}
pub relation reit_accelerated_inclusion_date_965m2Bii(shareholder: us.irc.core::Person, included_on: Date, amount: Money) kind institutional {
    label en official "the amount not yet included is included in gross income as of the day before the date of the event, and the unpaid tax on it is due on the date of the event";
}
@source(IRC_S965_M, relation = formalizes, coverage = exact, quote = "If there is a liquidation or sale of substantially all the assets of the real estate investment trust")
rule S965M2BiiAccelerationOfInclusion defeasible {
    for shareholder: us.irc.core::Person;
    for event_on: Date;
    for amount: Money;
    for calendar_before_1: Date;
    when reit_us_shareholder_election_965m1B(shareholder)
     and reit_liquidation_sale_or_cessation_965m2Bii(shareholder, event_on)
     and reit_amount_not_yet_included_965m2Bii(shareholder, amount)
     and amount > 0.00 USD
        and us.irc.core::civil_calendar_boundary_before(event_on, 1, us.irc.core::CalendarDay, calendar_before_1);
    then reit_accelerated_inclusion_date_965m2Bii(shareholder, calendar_before_1, amount);
}
pub relation reit_unpaid_tax_due_on_event_965m2Bii(shareholder: us.irc.core::Person, due_on: Date) kind institutional {
    label en official "the unpaid portion of the tax liability on the accelerated inclusion is due on the date of the event";
}
@source(IRC_S965_M, relation = formalizes, coverage = exact, quote = "If there is a liquidation or sale of substantially all the assets of the real estate investment trust")
rule S965M2BiiUnpaidTaxDueOnEventDate defeasible {
    for shareholder: us.irc.core::Person;
    for event_on: Date;
    for amount: Money;
    when reit_us_shareholder_election_965m1B(shareholder)
     and reit_liquidation_sale_or_cessation_965m2Bii(shareholder, event_on)
     and reit_amount_not_yet_included_965m2Bii(shareholder, amount)
     and amount > 0.00 USD;
    then reit_unpaid_tax_due_on_event_965m2Bii(shareholder, event_on);
}
