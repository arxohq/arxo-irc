// §871(a) — 30% FDAP tax on nonresident aliens not effectively connected;
// §871(b) — graduated-rate tax on ECI (cross-reference to section 1/55,
// EXTERNAL_DEPENDENCY on `income-individual`'s rate schedule, not modeled
// this stage beyond the classification); §871(h) — portfolio interest
// exemption; §881(a) — the parallel 30% tax on foreign corporations. Stage 1
// (IRC-10 stage 1, A13). §871(c)-(g),(i)-(n) and §881(b)-(f) are NOT modeled
// this stage (stage 2).

// --- §871(a)(1): 30% tax on FDAP income ----------------------------------

use self::{
    IRC_S871_A,
    IRC_S871_B,
    IRC_S871_C,
    IRC_S871_D,
    IRC_S871_H,
    IRC_S871_I,
    IRC_S881_A,
    contingent_interest_denied_871h4A,
    effectively_connected,
    engaged_in_trade_or_business_within_us,
    exempt_from_881a_tax,
    portfolio_interest_denied_by_871h6,
    statement_disqualified_871h5,
    ten_percent_shareholder_871h3B,
};

pub relation fdap_item_received(recipient: us.irc.core::Individual, amount: Money, item_id: Text) kind empirical {
    label en official "an amount received from US sources by a nonresident alien individual as interest, dividends, rents, salaries, wages, premiums, annuities, compensations, remunerations, emoluments, or other fixed or determinable annual or periodical gains, profits, and income (section 871(a)(1)(A))";
}

@source(IRC_S871_A, relation = formalizes, coverage = partial, quote = "there is hereby imposed for each taxable year a tax of 30 percent of the amount received from sources within the United States by a nonresident alien individual")
pub relation fdap_tax(recipient: us.irc.core::Individual, amount: Money, tax: Money) kind institutional {
    label en official "the 30 percent tax on a nonresident alien individual's US-source FDAP item under section 871(a)(1), computed only if the item is not effectively connected with a US trade or business and not exempted under subsection (h) (portfolio interest) or another named exemption";
}
rule S871A1FdapThirtyPercentTax defeasible {
    for recipient: us.irc.core::Individual;
    for amount: Money;
    for item_id: Text;
    when fdap_item_received(recipient, amount, item_id);
    unless effectively_connected(recipient, item_id)
     and fdap_item_received(recipient, amount, item_id);
    unless exempt_from_871a_tax(recipient, item_id)
     and fdap_item_received(recipient, amount, item_id);
    then fdap_tax(recipient, amount, amount * 0.30);
}
pub relation exempt_from_871a_tax(recipient: us.irc.core::Individual, item_id: Text) kind institutional {
    label en official "a named exemption from the section 871(a) 30% tax applies to this item (portfolio interest under subsection (h), or another named exemption not modeled this stage)";
}

// --- §871(b): graduated-rate tax on effectively connected income ---------
//
// EXTERNAL_DEPENDENCY: the ACTUAL rate schedule of section 1 (individual
// brackets) or section 55 (AMT) is owned by `income-individual`
// (DEPENDENCIES.json row, status pending) — this stage classifies which
// income is taxed under (b) and leaves the rate computation to that owner's
// relation, imported once it exists, rather than duplicating a bracket
// table here.
pub relation eci_taxable_income(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "gross income effectively connected with the conduct of a US trade or business, less allowable deductions properly connected with that gross income — the taxable-income base section 871(b)(1) directs to section 1/55 (section 871(b)(2))";
}
@source(IRC_S871_B, relation = formalizes, coverage = exact, quote = "A nonresident alien individual engaged in trade or business within the United States during the taxable year shall be taxable as provided in section 1 or 55 on his taxable income which is effectively connected with the conduct of a trade or business within the United States.")
pub relation eci_taxable_under_graduated_rates(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind institutional {
    label en official "a nonresident alien individual engaged in a US trade or business during the taxable year is taxable, on ECI taxable income, under section 1 or 55's graduated rates (section 871(b)(1)) — PENDING: the rate computation itself is `income-individual`'s section 1/55 relation, not yet imported (external_norm_unresolved)";
}
rule S871BEciGraduatedRateClassification defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    when engaged_in_trade_or_business_within_us(p)
     and us.irc.core::year_of(p, y);
    then eci_taxable_under_graduated_rates(p, y);
}

// --- §871(h): portfolio interest exemption --------------------------------

pub relation interest_would_be_taxed_under_871a(recipient: us.irc.core::Individual, item_id: Text) kind empirical {
    label en unofficial "the interest item would be subject to tax under section 871(a) but for the portfolio-interest exemption, for section 871(h)(2)(A)";
}
pub relation obligation_in_registered_form(item_id: Text) kind empirical {
    label en official "the obligation on which the interest is paid is in registered form (section 871(h)(2)(B)(i))";
}
pub relation beneficial_owner_non_us_statement_received(item_id: Text) kind empirical {
    label en official "the withholding agent has received a statement (meeting section 871(h)(5)) that the beneficial owner of the obligation is not a United States person (section 871(h)(2)(B)(ii)(I))";
}
pub relation secretary_determined_statement_not_required(item_id: Text) kind empirical {
    label en official "the Secretary has determined a beneficial-owner statement is not required to carry out the purposes of section 871(h) (section 871(h)(2)(B)(ii)(II))";
}
pub relation recipient_is_ten_percent_shareholder(recipient: us.irc.core::Individual, item_id: Text) kind empirical {
    label en official "the recipient is a 10-percent shareholder of the issuer under section 871(h)(3)(B), applying the section 318(a) attribution modifications of section 871(h)(3)(C) — excludes the interest from portfolio interest";
}
pub relation interest_is_contingent_interest_871h4(item_id: Text) kind empirical {
    label en official "the interest is contingent interest described in section 871(h)(4)(A), not within an exception of section 871(h)(4)(C)-(D) — excludes the interest from portfolio interest (this stage does not model the (C)/(D) exceptions in detail: TECH_GAP)";
}

@source(IRC_S871_H, relation = formalizes, coverage = partial, quote = "In the case of any portfolio interest received by a nonresident individual from sources within the United States, no tax shall be imposed under paragraph (1)(A) or (1)(C) of subsection (a).")
pub relation portfolio_interest(recipient: us.irc.core::Individual, item_id: Text) kind institutional {
    label en official "the interest item is portfolio interest under section 871(h): it would otherwise be taxed under section 871(a), is paid on a registered obligation with the required non-US-beneficial-owner statement (or a Secretary waiver), and is not excluded by the 10-percent-shareholder or contingent-interest rules";
}
rule S871H2PortfolioInterestQualifies defeasible {
    for recipient: us.irc.core::Individual;
    for item_id: Text;
    when interest_would_be_taxed_under_871a(recipient, item_id)
     and obligation_in_registered_form(item_id)
     and beneficial_owner_non_us_statement_received(item_id);
    unless recipient_is_ten_percent_shareholder(recipient, item_id);
    unless ten_percent_shareholder_871h3B(recipient, item_id);
    unless interest_is_contingent_interest_871h4(item_id)
     and interest_would_be_taxed_under_871a(recipient, item_id);
    unless contingent_interest_denied_871h4A(item_id)
     and interest_would_be_taxed_under_871a(recipient, item_id);
    unless portfolio_interest_denied_by_871h6(item_id)
     and interest_would_be_taxed_under_871a(recipient, item_id);
    unless statement_disqualified_871h5(item_id)
     and interest_would_be_taxed_under_871a(recipient, item_id);
    then portfolio_interest(recipient, item_id);
}
rule S871H2PortfolioInterestQualifiesSecretaryWaiver defeasible {
    for recipient: us.irc.core::Individual;
    for item_id: Text;
    when interest_would_be_taxed_under_871a(recipient, item_id)
     and obligation_in_registered_form(item_id)
     and secretary_determined_statement_not_required(item_id);
    unless recipient_is_ten_percent_shareholder(recipient, item_id);
    unless ten_percent_shareholder_871h3B(recipient, item_id);
    unless interest_is_contingent_interest_871h4(item_id)
     and interest_would_be_taxed_under_871a(recipient, item_id);
    unless contingent_interest_denied_871h4A(item_id)
     and interest_would_be_taxed_under_871a(recipient, item_id);
    unless portfolio_interest_denied_by_871h6(item_id)
     and interest_would_be_taxed_under_871a(recipient, item_id);
    then portfolio_interest(recipient, item_id);
}
rule S871H1PortfolioInterestExemptFromTax defeasible {
    for recipient: us.irc.core::Individual;
    for item_id: Text;
    when portfolio_interest(recipient, item_id);
    then exempt_from_871a_tax(recipient, item_id);
}

// --- §871(a)(2): 183-day capital gains tax --------------------------------
//
// Stage 2b. Boundary named by the owner's task: 183 days qualifies ("183
// days or more"), 182 days does not.

pub relation days_present_in_us_during_year(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, days: Integer) kind empirical {
    label en unofficial "the number of days during the taxable year the nonresident alien individual was present in the United States, for the section 871(a)(2) 183-day test";
}
pub relation us_source_capital_gains(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the individual's aggregate gains from sources within the United States from the sale or exchange of capital assets during the taxable year, for section 871(a)(2)";
}
pub relation us_source_capital_losses(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the individual's aggregate losses allocable to sources within the United States from the sale or exchange of capital assets during the taxable year, for section 871(a)(2) (determined without the section 1212 carryover benefit, per the statute's own text)";
}
@source(IRC_S871_A, relation = formalizes, coverage = partial, quote = "In the case of a nonresident alien individual present in the United States for a period or periods aggregating 183 days or more during the taxable year, there is hereby imposed for such year a tax of 30 percent of the amount by which his gains, derived from sources within the United States, from the sale or exchange at any time during such year of capital assets exceed his losses, allocable to sources within the United States, from the sale or exchange at any time during such year of capital assets")
pub relation section_871a2_capital_gains_tax(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, tax: Money) kind institutional {
    label en official "the section 871(a)(2) 30% tax on a 183-day-or-more-present nonresident alien individual's excess of US-source capital gains over US-source capital losses for the taxable year";
}
rule S871A2CapitalGainsTax183Days defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for days: Integer;
    for gains: Money;
    for losses: Money;
    when days_present_in_us_during_year(p, y, days)
     and days >= 183
     and us_source_capital_gains(p, y, gains)
     and us_source_capital_losses(p, y, losses)
     and gains > losses;
    then section_871a2_capital_gains_tax(p, y, round((gains - losses) * 0.30, 2, "HALF_UP"));
}

// --- §871(c): participants in exchange or training programs --------------

pub relation nonimmigrant_exchange_visitor_fjmq(p: us.irc.core::Individual) kind empirical {
    label en official "the individual is temporarily present in the United States as a nonimmigrant under subparagraph (F), (J), (M), or (Q) of section 101(a)(15) of the Immigration and Nationality Act, for section 871(c)";
}
@source(IRC_S871_C, relation = formalizes, coverage = partial, quote = "a nonresident alien individual who (without regard to this subsection) is not engaged in trade or business within the United States and who is temporarily present in the United States as a nonimmigrant under subparagraph (F), (J), (M), or (Q) of section 101(a)(15) of the Immigration and Nationality Act")
pub relation treated_as_engaged_in_us_trade_or_business_871c(p: us.irc.core::Individual) kind institutional {
    label en official "the F/J/M/Q exchange-or-training-program nonimmigrant is treated as a nonresident alien individual engaged in trade or business within the United States for section 871 purposes, even though not otherwise so engaged (section 871(c))";
}
rule S871CExchangeVisitorTreatedAsEngagedInBusiness defeasible {
    for p: us.irc.core::Individual;
    when nonimmigrant_exchange_visitor_fjmq(p)
     and not_known(engaged_in_trade_or_business_within_us(p));
    then treated_as_engaged_in_us_trade_or_business_871c(p);
}

// --- §871(d): election to treat real property income as ECI --------------

pub relation elects_871d_real_property_income_as_eci(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind empirical {
    label en unofficial "the nonresident alien individual makes the section 871(d)(1) election to treat US real property income as effectively connected, for the taxable year";
}
pub relation revoked_871d_election_in_year(p: us.irc.core::Individual, revoked_year: us.irc.core::TaxableYear) kind empirical {
    label en unofficial "the individual revoked a prior section 871(d) election effective for revoked_year, for the section 871(d)(2) 5-year re-election bar";
}
relation within_five_years_of_871d_revocation(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind empirical {
    label en unofficial "the taxable year y falls within the 5 taxable years after a year for which the individual revoked a section 871(d) election, without Secretary consent to re-elect earlier (section 871(d)(2)) — asserted directly, same year-distance TECH_GAP as module 05's section 911(e)(2) bar (TECH-GAPS G92)";
}
@source(IRC_S871_D, relation = formalizes, coverage = partial, quote = "may elect for such taxable year to treat all such income as income which is effectively connected with the conduct of a trade or business within the United States")
pub relation election_871d_effective(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the section 871(d)(1) election is in effect for the year: the individual elected it and is not within the 5-year post-revocation bar of (d)(2)";
}
rule S871DElectionPower defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    when elects_871d_real_property_income_as_eci(p, y);
    unless within_five_years_of_871d_revocation(p, y);
    then power S871DElectionOfRealPropertyEci {
        holder p;
        over p;
        exercise elects_871d_real_property_income_as_eci(p, y);
        valid_when elects_871d_real_property_income_as_eci(p, y);
        effect create(election_871d_effective(p, y));
    };
}

// --- §871(i): tax not to apply to certain interest and dividends ----------

pub relation deposit_interest_871i(recipient: us.irc.core::Individual, item_id: Text) kind empirical {
    label en official "the amount is interest on deposits within the meaning of section 871(i)(3) (deposits with a banking business, savings-institution accounts deductible under section 591, or amounts held by an insurance company under an interest agreement)";
}
@source(IRC_S871_I, relation = formalizes, coverage = partial, quote = "Interest on deposits, if such interest is not effectively connected with the conduct of a trade or business within the United States.")
rule S871I2ADepositInterestExempt defeasible {
    for recipient: us.irc.core::Individual;
    for item_id: Text;
    when deposit_interest_871i(recipient, item_id);
    unless effectively_connected(recipient, item_id)
     and deposit_interest_871i(recipient, item_id);
    then exempt_from_871a_tax(recipient, item_id);
}

// --- §881(a): 30% tax on foreign corporations' non-ECI income -------------

pub relation fdap_item_received_by_foreign_corp(recipient: us.irc.core::Corporation, amount: Money, item_id: Text) kind empirical {
    label en official "an amount received from US sources by a foreign corporation as interest, dividends, rents, salaries, wages, premiums, annuities, compensations, remunerations, emoluments, or other fixed or determinable annual or periodical gains, profits, and income (section 881(a)(1))";
}

@source(IRC_S881_A, relation = formalizes, coverage = partial, quote = "Except as provided in subsection (c), there is hereby imposed for each taxable year a tax of 30 percent of the amount received from sources within the United States by a foreign corporation")
pub relation foreign_corp_fdap_tax(recipient: us.irc.core::Corporation, amount: Money, tax: Money) kind institutional {
    label en official "the 30 percent tax on a foreign corporation's US-source FDAP item under section 881(a), computed only if the item is not effectively connected with a US trade or business and not exempted under section 881(c) (portfolio interest, not modeled this stage beyond the section 871(h)-style structure)";
}
rule S881AThirtyPercentTax defeasible {
    for recipient: us.irc.core::Corporation;
    for amount: Money;
    for item_id: Text;
    when fdap_item_received_by_foreign_corp(recipient, amount, item_id);
    unless effectively_connected(recipient, item_id)
     and fdap_item_received_by_foreign_corp(recipient, amount, item_id);
    unless exempt_from_881a_tax(recipient, item_id)
     and fdap_item_received_by_foreign_corp(recipient, amount, item_id);
    then foreign_corp_fdap_tax(recipient, amount, amount * 0.30);
}
