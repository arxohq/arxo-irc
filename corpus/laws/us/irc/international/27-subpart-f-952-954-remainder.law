// §952(a)(3)-(5), (b), (c)(1)(B)-(C), (c)(2)-(3) and §954(a), (c)(1)(B)-(H),
// (c)(4)-(5), (h), (i) — subpart F income and foreign base company income,
// remainder after modules 10 (stage 1b/2b). Stage 2c (IRC-10 stage 2c, A13).
//
// Conventions: gains and losses of a category are case-supplied aggregates
// (a `sum all` over a derived relation is a runtime-subset limit, section 111),
// so each net-gain rule takes the aggregate gains and the aggregate losses of
// the category and applies the statutory "excess of gains over losses"; the
// classification of an individual transaction into an excluded class (hedging,
// active business, section 988) is carried by the case when it builds the
// aggregates. The pinned text of §954(c)(6) is handled by module 22.

// --- §952(a)(3)-(5): boycott, bribes, section 901(j) income ------------------

use self::{
    IRC_S952_A,
    IRC_S952_B,
    IRC_S952_C,
    IRC_S954_A,
    IRC_S954_C,
    IRC_S954_H,
    IRC_S954_I,
    nonbanking_limitation_met_954h3B,
    qualified_income_home_country_customer_limit_met_954h3C,
};

pub relation income_of_cfc_for_boycott_952a3A(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the income of the corporation other than income attributable to earnings and profits included in the gross income of a United States person under section 951 (other than by reason of this paragraph) and other than income described in subsection (b)";
}
pub relation international_boycott_factor_952a3B(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, factor: Decimal) kind empirical {
    label en official "the international boycott factor determined under section 999";
}
pub relation boycott_amount_952a3(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the section 952(a)(3) amount: the qualifying income times the international boycott factor; module 10 reads the corresponding amount as `boycott_adjusted_income_and_factor`";
}
@source(IRC_S952_A, relation = formalizes, coverage = exact, quote = "(3) an amount equal to the product of—")
rule S952A3BoycottProduct defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for income: Money;
    for factor: Decimal;
    when income_of_cfc_for_boycott_952a3A(corp, y, income)
     and international_boycott_factor_952a3B(corp, y, factor);
    then boycott_amount_952a3(corp, y, round(income * factor, 2, "HALF_UP"));
}
pub relation payment_unlawful_under_fcpa_if_payor_were_us_person_952a4(payment_id: Text) kind empirical {
    label en official "the payment (illegal bribe, kickback or other payment within section 162(c)) to an official, employee or agent in fact of a government would be unlawful under the Foreign Corrupt Practices Act of 1977 if the payor were a United States person";
}
pub relation payment_by_or_on_behalf_of_cfc_952a4(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, payment_id: Text, amount: Money) kind empirical {
    label en official "a payment made by or on behalf of the corporation during its taxable year directly or indirectly to a government official, employee or agent in fact";
}
pub relation bribe_amount_952a4(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, payment_id: Text, amount: Money) kind institutional {
    label en official "the part of subpart F income under section 952(a)(4): a payment that would be unlawful under the FCPA if the payor were a United States person (the sum over payments is the module 10 input `illegal_bribes_kickbacks_sum`)";
}
@source(IRC_S952_A, relation = formalizes, coverage = exact, quote = "(4) the sum of the amounts of any illegal bribes, kickbacks, or other payments (within the meaning of section 162(c)) paid by or on behalf of the corporation during the taxable year of the corporation directly or indirectly to an official, employee, or agent in fact of a government, and")
rule S952A4IllegalPayment defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for pid: Text;
    for amount: Money;
    when payment_by_or_on_behalf_of_cfc_952a4(corp, y, pid, amount)
     and payment_unlawful_under_fcpa_if_payor_were_us_person_952a4(pid);
    then bribe_amount_952a4(corp, y, pid, amount);
}
pub relation gross_income_from_901j_country_952a5(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the income of the corporation derived from any foreign country during a period in which section 901(j) applies to it";
}
pub relation deductions_allocable_to_901j_income_952a5(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the deductions (including taxes) properly allocable to the section 901(j) country income, under regulations";
}
pub relation income_from_901j_country_net_952a5(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the section 952(a)(5) income reduced, under regulations, by the deductions (including taxes) properly allocable to it";
}
@source(IRC_S952_A, relation = formalizes, coverage = exact, quote = "(5) the income of such corporation derived from any foreign country during any period during which section 901(j) applies to such foreign country.")
rule S952A5NetIncomeFromSection901jCountry defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for gross: Money;
    for deductions: Money;
    when gross_income_from_901j_country_952a5(corp, y, gross)
     and deductions_allocable_to_901j_income_952a5(corp, y, deductions);
    then income_from_901j_country_net_952a5(corp, y, max(0.00 USD, gross - deductions));
}

// --- §952(b): exclusion of United States income -----------------------------

pub relation item_us_source_eci_of_cfc_952b(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text) kind empirical {
    label en official "an item of income from sources within the United States which is effectively connected with the conduct by the corporation of a trade or business within the United States";
}
pub relation item_exempt_or_reduced_by_treaty_952b(item_id: Text) kind empirical {
    label en official "the item is exempt from taxation (or subject to a reduced rate) pursuant to a treaty obligation of the United States, disregarding any exemption or reduction of the section 884 tax (section 952(b) last sentence)";
}
pub relation item_excluded_from_subpart_f_income_952b(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text) kind institutional {
    label en official "subpart F income does not include the item: United States source effectively connected income, unless treaty-exempt or reduced-rate (section 952(b))";
}
@source(IRC_S952_B, relation = formalizes, coverage = exact, quote = "In the case of a controlled foreign corporation, subpart F income does not include any item of income from sources within the United States which is effectively connected with the conduct by such corporation of a trade or business within the United States unless such item is exempt from taxation (or is subject to a reduced rate of tax) pursuant to a treaty obligation of the United States.")
rule S952BExclusionOfUsEci defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    when item_us_source_eci_of_cfc_952b(corp, y, item_id);
    unless item_exempt_or_reduced_by_treaty_952b(item_id)
     and item_us_source_eci_of_cfc_952b(corp, y, item_id);
    then item_excluded_from_subpart_f_income_952b(corp, y, item_id);
}

// --- §952(c)(1)(B): qualified deficits; (c)(1)(C): chain members ------------

pub relation shareholder_inclusion_attributable_to_qualified_activity_952c1B(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, activity: Text, amount: Money) kind empirical {
    label en official "the amount included in the shareholder's gross income under section 951(a)(1)(A) for the year that is attributable to a qualified activity (foreign base company sales income, foreign base company services income, and for a qualified insurance company or qualified financial institution, insurance or foreign personal holding company income)";
}
pub relation shareholder_qualified_deficit_share_at_close_of_year_952c1Biv(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, activity: Text, amount: Money) kind empirical {
    label en official "the shareholder's pro rata share of the qualified deficit determined (rules similar to section 951(a)(2)) as of the close of the taxable year";
}
pub relation shareholder_qualified_deficit_share_at_close_of_deficit_year_952c1Biv(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, activity: Text, amount: Money) kind empirical {
    label en official "the shareholder's pro rata share of the qualified deficit determined as of the close of the taxable year in which the deficit arose";
}
pub relation qualified_deficit_pro_rata_share_952c1Biv(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, activity: Text, amount: Money) kind institutional {
    label en official "the shareholder's pro rata share of the qualified deficit: whichever of the two determinations yields the smaller share (section 952(c)(1)(B)(iv))";
}
@source(IRC_S952_C, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the shareholder's pro rata share of any deficit for any prior taxable year shall be determined under rules similar to rules under section 951(a)(2) for whichever of the following yields the smaller share:")
rule S952C1BivSmallerOfTwoShares defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for activity: Text;
    for at_close: Money;
    for at_deficit_year: Money;
    when shareholder_qualified_deficit_share_at_close_of_year_952c1Biv(shareholder, corp, y, activity, at_close)
     and shareholder_qualified_deficit_share_at_close_of_deficit_year_952c1Biv(shareholder, corp, y, activity, at_deficit_year);
    then qualified_deficit_pro_rata_share_952c1Biv(shareholder, corp, y, activity, min(at_close, at_deficit_year));
}
pub relation qualified_deficit_not_previously_taken_into_account_952c1Bii(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, activity: Text, amount: Money) kind empirical {
    label en official "the part of the pro rata qualified deficit attributable to the same qualified activity that has not previously been taken into account under the subparagraph (section 952(c)(1)(B)(ii)(I)-(II))";
}
pub relation inclusion_reduction_for_qualified_deficit_952c1Bi(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, activity: Text, amount: Money) kind institutional {
    label en official "the reduction of the section 951(a)(1)(A) inclusion attributable to a qualified activity by the shareholder's pro rata qualified deficit, limited to the inclusion (section 952(c)(1)(B)(i))";
}
@source(IRC_S952_C, relation = formalizes, coverage = exact, quote = "The amount included in the gross income of any United States shareholder under section 951(a)(1)(A) for any taxable year and attributable to a qualified activity shall be reduced by the amount of such shareholder's pro rata share of any qualified deficit.")
rule S952C1BiInclusionReducedByQualifiedDeficit defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for activity: Text;
    for inclusion: Money;
    for share: Money;
    for unused: Money;
    when shareholder_inclusion_attributable_to_qualified_activity_952c1B(shareholder, corp, y, activity, inclusion)
     and qualified_deficit_pro_rata_share_952c1Biv(shareholder, corp, y, activity, share)
     and qualified_deficit_not_previously_taken_into_account_952c1Bii(shareholder, corp, y, activity, unused);
    then inclusion_reduction_for_qualified_deficit_952c1Bi(shareholder, corp, y, activity, min(inclusion, min(share, unused)));
}
pub relation elects_chain_deficit_offset_952c1C(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the controlled foreign corporation elects to reduce its subpart F income attributable to a qualified activity by the earnings-and-profits deficit of a qualified chain member (section 952(c)(1)(C)(i))";
}
pub relation chain_member_deficit_for_activity_952c1C(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, activity: Text, amount: Money) kind empirical {
    label en official "the deficit in earnings and profits of a qualified chain member (a corporation of the same foreign country wholly owned by, or wholly owning, the CFC) for a taxable year ending with or within the CFC's year, to the extent attributable to the activity";
}
pub relation subpart_f_income_attributable_to_activity_952c1C(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, activity: Text, amount: Money) kind empirical {
    label en official "the subpart F income of the corporation for the year attributable to the qualified activity, after subparagraphs (A) and (B) (subparagraph (C) is applied after them, clause (iii))";
}
pub relation chain_deficit_offset_in_effect_952c1C(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the chain-member deficit election is in effect for the year";
}
@source(IRC_S952_C, relation = formalizes, coverage = exact, quote = "A controlled foreign corporation may elect to reduce the amount of its subpart F income for any taxable year which is attributable to any qualified activity by the amount of any deficit in earnings and profits of a qualified chain member for a taxable year ending with (or within) the taxable year of such controlled foreign corporation to the extent such deficit is attributable to such activity.")
rule S952C1CChainDeficitElectionPower strict {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when elects_chain_deficit_offset_952c1C(corp, y);
    then power S952C1CElection {
        holder corp;
        over corp;
        exercise elects_chain_deficit_offset_952c1C(corp, y);
        valid_when elects_chain_deficit_offset_952c1C(corp, y);
        effect create(chain_deficit_offset_in_effect_952c1C(corp, y));
    };
}
pub relation subpart_f_income_after_chain_offset_952c1C(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, activity: Text, amount: Money) kind institutional {
    label en official "the subpart F income attributable to the activity after the chain-member deficit offset: reduced by the lesser of the income and the deficit (section 952(c)(1)(C)(i))";
}
rule S952C1CReducedIncome defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for activity: Text;
    for income: Money;
    for deficit: Money;
    when chain_deficit_offset_in_effect_952c1C(corp, y)
     and subpart_f_income_attributable_to_activity_952c1C(corp, y, activity, income)
     and chain_member_deficit_for_activity_952c1C(corp, y, activity, deficit);
    then subpart_f_income_after_chain_offset_952c1C(corp, y, activity, income - min(income, deficit));
}

// --- §952(c)(2): recharacterization -----------------------------------------

pub relation earnings_and_profits_of_subsequent_year_952c2(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the earnings and profits of the corporation for a subsequent taxable year";
}
pub relation subpart_f_income_of_subsequent_year_952c2(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the subpart F income of the corporation for that subsequent taxable year";
}
pub relation prior_reduction_under_952c1A_not_yet_recharacterized(corp: us.irc.core::Corporation, amount: Money) kind empirical {
    label en official "the amount by which subpart F income was reduced under section 952(c)(1)(A) in earlier years and not yet recharacterized (a running balance asserted directly, TECH-GAPS G1751)";
}
pub relation recharacterized_as_subpart_f_income_952c2(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the excess of earnings and profits over subpart F income for the subsequent year, recharacterized as subpart F income up to the amount of the earlier reduction (section 952(c)(2), rules similar to section 904(f)(5))";
}
@source(IRC_S952_C, relation = formalizes, coverage = partial, quote = "any excess of the earnings and profits of such corporation for any subsequent taxable year over the subpart F income of such foreign corporation for such taxable year shall be recharacterized as subpart F income under rules similar to the rules applicable under section 904(f)(5).")
rule S952C2Recharacterization defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for ep: Money;
    for sfi: Money;
    for balance: Money;
    when earnings_and_profits_of_subsequent_year_952c2(corp, y, ep)
     and subpart_f_income_of_subsequent_year_952c2(corp, y, sfi)
     and prior_reduction_under_952c1A_not_yet_recharacterized(corp, balance)
     and ep > sfi;
    then recharacterized_as_subpart_f_income_952c2(corp, y, min(ep - sfi, balance));
}

// --- §954(a): foreign base company income -----------------------------------

pub relation fphci_category_gross_954a1(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, gross: Money, allocable_deductions: Money) kind empirical {
    label en official "the foreign personal holding company income for the year (subsection (c)) and the deductions properly allocable to it (subsection (b)(5), under regulations)";
}
pub relation fbc_sales_category_gross_954a2(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, gross: Money, allocable_deductions: Money) kind empirical {
    label en official "the foreign base company sales income for the year (subsection (d)) and the deductions properly allocable to it";
}
pub relation fbc_services_category_gross_954a3(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, gross: Money, allocable_deductions: Money) kind empirical {
    label en official "the foreign base company services income for the year (subsection (e)) and the deductions properly allocable to it";
}
pub relation foreign_base_company_income_computed_954a(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "foreign base company income: the sum of the three categories, each reduced by its properly allocable deductions and floored at zero (section 954(a)(1)-(3), (b)(5)); module 10 reads `foreign_base_company_income_954` as a case amount";
}
@source(IRC_S954_A, relation = formalizes, coverage = exact, quote = "For purposes of section 952(a)(2), the term \"foreign base company income\" means for any taxable year the sum of—")
rule S954AForeignBaseCompanyIncomeSum defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for g1: Money;
    for d1: Money;
    for g2: Money;
    for d2: Money;
    for g3: Money;
    for d3: Money;
    when fphci_category_gross_954a1(corp, y, g1, d1)
     and fbc_sales_category_gross_954a2(corp, y, g2, d2)
     and fbc_services_category_gross_954a3(corp, y, g3, d3);
    then foreign_base_company_income_computed_954a(corp, y, max(0.00 USD, g1 - d1) + max(0.00 USD, g2 - d2) + max(0.00 USD, g3 - d3));
}

// --- §954(c)(1)(B)-(H): net-gain and other FPHCI categories ------------------

pub relation property_gains_and_losses_954c1B(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, gains: Money, losses: Money) kind empirical {
    label en official "the aggregate gains and aggregate losses (positive magnitude) from the sale or exchange of property that gives rise to subparagraph (A) income (other than income excepted by subsection (h) or (i)), that is an interest in a trust, partnership or REMIC, or that gives rise to no income; gains and losses on section 1221(a)(1) property are left out";
}
pub relation fphci_property_gain_954c1B(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "foreign personal holding company income from certain property transactions: the excess of gains over losses (section 954(c)(1)(B))";
}
@source(IRC_S954_C, relation = formalizes, coverage = exact, quote = "The excess of gains over losses from the sale or exchange of property—")
rule S954C1BExcessOfGainsOverLosses defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for gains: Money;
    for losses: Money;
    when property_gains_and_losses_954c1B(corp, y, gains, losses)
     and gains > losses;
    then fphci_property_gain_954c1B(corp, y, gains - losses);
}
pub relation commodity_gains_and_losses_954c1C(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, gains: Money, losses: Money) kind empirical {
    label en official "the aggregate gains and losses from transactions (including futures, forwards and similar transactions) in any commodities, excluding gains and losses that arise out of commodity hedging transactions, are active business gains or losses (when substantially all the commodities are section 1221(a)(1), (2) or (8) property), or are section 988 foreign currency gains or losses";
}
pub relation fphci_commodity_gain_954c1C(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "foreign personal holding company income from commodities transactions: the excess of gains over losses (section 954(c)(1)(C))";
}
@source(IRC_S954_C, relation = formalizes, coverage = exact, quote = "The excess of gains over losses from transactions (including futures, forward, and similar transactions) in any commodities.")
rule S954C1CCommoditiesExcess defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for gains: Money;
    for losses: Money;
    when commodity_gains_and_losses_954c1C(corp, y, gains, losses)
     and gains > losses;
    then fphci_commodity_gain_954c1C(corp, y, gains - losses);
}
pub relation foreign_currency_gains_and_losses_954c1D(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, gains: Money, losses: Money) kind empirical {
    label en official "the aggregate foreign currency gains and losses (section 988(b)) attributable to section 988 transactions";
}
pub relation transaction_directly_related_to_business_needs_954c1D(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the section 988 transaction is directly related to the business needs of the controlled foreign corporation";
}
pub relation fphci_currency_gain_954c1D(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "foreign personal holding company income from foreign currency: the excess of foreign currency gains over losses, other than for a transaction directly related to the business needs of the CFC (section 954(c)(1)(D))";
}
@source(IRC_S954_C, relation = formalizes, coverage = exact, quote = "This subparagraph shall not apply in the case of any transaction directly related to the business needs of the controlled foreign corporation.")
rule S954C1DCurrencyExcess defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for gains: Money;
    for losses: Money;
    when foreign_currency_gains_and_losses_954c1D(corp, y, gains, losses)
     and gains > losses;
    unless transaction_directly_related_to_business_needs_954c1D(corp, y)
     and foreign_currency_gains_and_losses_954c1D(corp, y, gains, losses);
    then fphci_currency_gain_954c1D(corp, y, gains - losses);
}
pub relation income_equivalent_to_interest_954c1E(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "income equivalent to interest, including income from commitment fees (or similar amounts) for loans actually made";
}
pub relation fphci_interest_equivalent_954c1E(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "foreign personal holding company income under section 954(c)(1)(E)";
}
@source(IRC_S954_C, relation = formalizes, coverage = exact, quote = "Any income equivalent to interest, including income from commitment fees (or similar amounts) for loans actually made.")
rule S954C1EInterestEquivalent defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when income_equivalent_to_interest_954c1E(corp, y, amount);
    then fphci_interest_equivalent_954c1E(corp, y, amount);
}
pub relation notional_principal_contract_income_and_losses_954c1F(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, income: Money, losses: Money) kind empirical {
    label en official "the aggregate income and the aggregate losses and deductions from notional principal contracts, excluding contracts entered into to hedge an item described in a preceding subparagraph (those items are taken into account under that subparagraph)";
}
pub relation fphci_notional_principal_contract_954c1F(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "net income from notional principal contracts (section 954(c)(1)(F)(i)), floored at zero";
}
@source(IRC_S954_C, relation = formalizes, coverage = exact, quote = "Net income from notional principal contracts.")
rule S954C1FNetNotionalPrincipalContractIncome defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for income: Money;
    for losses: Money;
    when notional_principal_contract_income_and_losses_954c1F(corp, y, income, losses)
     and income > losses;
    then fphci_notional_principal_contract_954c1F(corp, y, income - losses);
}
pub relation payments_in_lieu_of_dividends_under_1058_agreement_954c1G(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "payments in lieu of dividends made pursuant to an agreement to which section 1058 applies";
}
pub relation fphci_payments_in_lieu_954c1G(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "foreign personal holding company income under section 954(c)(1)(G)";
}
@source(IRC_S954_C, relation = formalizes, coverage = exact, quote = "Payments in lieu of dividends which are made pursuant to an agreement to which section 1058 applies.")
rule S954C1GPaymentsInLieuOfDividends defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when payments_in_lieu_of_dividends_under_1058_agreement_954c1G(corp, y, amount);
    then fphci_payments_in_lieu_954c1G(corp, y, amount);
}
pub relation personal_service_contract_receipts_954c1H(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, contract_id: Text, amount: Money) kind empirical {
    label en official "amounts received under a contract under which the corporation is to furnish personal services where another person may designate the individual or the individual is designated in the contract, and amounts received from the sale or disposition of such a contract";
}
pub relation individual_owns_value_percent_of_cfc_954c1H(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, contract_id: Text, percent: Decimal) kind empirical {
    label en official "the highest percentage of the value of the corporation's outstanding stock owned, directly or indirectly, by or for the individual who has performed, is to perform, or may be designated to perform the services, at some time during the taxable year";
}
pub relation fphci_personal_service_contract_954c1H(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, contract_id: Text, amount: Money) kind institutional {
    label en official "foreign personal holding company income from a personal service contract: only if at some time during the year 25 percent or more in value of the stock is owned by or for the individual who performs or may be designated to perform the services (section 954(c)(1)(H))";
}
@source(IRC_S954_C, relation = formalizes, coverage = exact, quote = "This subparagraph shall apply with respect to amounts received for services under a particular contract only if at some time during the taxable year 25 percent or more in value of the outstanding stock of the corporation is owned, directly or indirectly, by or for the individual who has performed, is to perform, or may be designated (by name or by description) as the one to perform, such services.")
rule S954C1HPersonalServiceContract defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for cid: Text;
    for amount: Money;
    for pct: Decimal;
    when personal_service_contract_receipts_954c1H(corp, y, cid, amount)
     and individual_owns_value_percent_of_cfc_954c1H(corp, y, cid, pct)
     and pct >= 25.0;
    then fphci_personal_service_contract_954c1H(corp, y, cid, amount);
}

// --- §954(c)(4): partnership look-through -------------------------------------

pub relation cfc_capital_or_profits_interest_percent_954c4b(corp: us.irc.core::Corporation, partnership: us.irc.core::Person, percent: Decimal) kind empirical {
    label en official "the percentage of the capital or profits interest in the partnership that the controlled foreign corporation owns directly (the indirect ownership rule of the second sentence is a case-supplied percentage)";
}
pub relation cfc_is_25_percent_owner_954c4b(corp: us.irc.core::Corporation, partnership: us.irc.core::Person) kind institutional {
    label en official "a 25-percent owner: a controlled foreign corporation that owns directly 25 percent or more of the capital or profits interest in a partnership (section 954(c)(4)(B))";
}
@source(IRC_S954_C, relation = formalizes, coverage = partial, quote = "For purposes of this paragraph, the term \"25-percent owner\" means a controlled foreign corporation which owns directly 25 percent or more of the capital or profits interest in a partnership.")
rule S954C4BTwentyFivePercentOwner defeasible {
    for corp: us.irc.core::Corporation;
    for partnership: us.irc.core::Person;
    for pct: Decimal;
    when cfc_capital_or_profits_interest_percent_954c4b(corp, partnership, pct)
     and pct >= 25.0;
    then cfc_is_25_percent_owner_954c4b(corp, partnership);
}
pub relation partnership_interest_sale_gain_954c4(corp: us.irc.core::Corporation, partnership: us.irc.core::Person, y: us.irc.core::TaxableYear, deemed_asset_sale_gain: Money) kind empirical {
    label en official "the gain on the deemed sale of the proportionate share of the partnership's assets attributable to the interest sold (character determined asset by asset)";
}
pub relation cfc_treated_as_selling_proportionate_share_of_assets_954c4A(corp: us.irc.core::Corporation, partnership: us.irc.core::Person, y: us.irc.core::TaxableYear, gain: Money) kind institutional {
    label en official "on a sale of an interest in a partnership of which the CFC is a 25-percent owner, the CFC is treated as selling the proportionate share of the partnership assets attributable to the interest, so character follows the assets (section 954(c)(4)(A))";
}
@source(IRC_S954_C, relation = formalizes, coverage = partial, quote = "In the case of any sale by a controlled foreign corporation of an interest in a partnership with respect to which such corporation is a 25-percent owner, such corporation shall be treated for purposes of this subsection as selling the proportionate share of the assets of the partnership attributable to such interest.")
rule S954C4ADeemedAssetSale defeasible {
    for corp: us.irc.core::Corporation;
    for partnership: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for gain: Money;
    when cfc_is_25_percent_owner_954c4b(corp, partnership)
     and partnership_interest_sale_gain_954c4(corp, partnership, y, gain);
    then cfc_treated_as_selling_proportionate_share_of_assets_954c4A(corp, partnership, y, gain);
}

// --- §954(h): active banking or financing income -----------------------------

pub relation lending_finance_gross_income_percent_954h2Bi(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, percent: Decimal) kind empirical {
    label en official "the percentage of the corporation's gross income derived directly from the active and regular conduct of a lending or finance business from transactions with customers which are not related persons";
}
pub relation licensed_us_bank_954h2Bii(corp: us.irc.core::Corporation) kind empirical {
    label en official "the corporation is engaged in the active conduct of a banking business and is an institution licensed to do business as a bank in the United States (or another corporation the Secretary specifies)";
}
pub relation registered_securities_dealer_954h2Biii(corp: us.irc.core::Corporation) kind empirical {
    label en official "the corporation is engaged in the active conduct of a securities business and is registered as a securities broker or dealer under section 15(a) of the Securities Exchange Act of 1934 or as a Government securities broker or dealer under section 15C(a)";
}
pub relation conducts_substantial_activity_954h2Aii(corp: us.irc.core::Corporation) kind empirical {
    label en official "the corporation conducts substantial activity with respect to its banking, financing or similar business";
}
pub relation predominantly_engaged_in_banking_or_financing_954h2B(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the corporation is treated as predominantly engaged in the active conduct of a banking, financing or similar business: more than 70 percent of gross income from an active lending or finance business with unrelated customers, or a licensed bank, or a registered securities dealer (section 954(h)(2)(B))";
}
@source(IRC_S954_H, relation = formalizes, coverage = exact, quote = "(i) more than 70 percent of the gross income of the controlled foreign corporation is derived directly from the active and regular conduct of a lending or finance business from transactions with customers which are not related persons,")
rule S954H2BiMoreThanSeventyPercent defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for pct: Decimal;
    when lending_finance_gross_income_percent_954h2Bi(corp, y, pct)
     and pct > 70.0;
    then predominantly_engaged_in_banking_or_financing_954h2B(corp, y);
}
@source(IRC_S954_H, relation = formalizes, coverage = exact, quote = "(ii) it is engaged in the active conduct of a banking business and is an institution licensed to do business as a bank in the United States (or is any other corporation not so licensed which is specified by the Secretary in regulations), or")
rule S954H2BiiLicensedBank defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when licensed_us_bank_954h2Bii(corp)
     and lending_finance_gross_income_percent_954h2Bi(corp, y, _);
    then predominantly_engaged_in_banking_or_financing_954h2B(corp, y);
}
@source(IRC_S954_H, relation = formalizes, coverage = exact, quote = "(iii) it is engaged in the active conduct of a securities business and is registered as a securities broker or dealer under section 15(a) of the Securities Exchange Act of 1934 or is registered as a Government securities broker or dealer under sectio")
rule S954H2BiiiRegisteredSecuritiesDealer defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when registered_securities_dealer_954h2Biii(corp)
     and lending_finance_gross_income_percent_954h2Bi(corp, y, _);
    then predominantly_engaged_in_banking_or_financing_954h2B(corp, y);
}
pub relation eligible_controlled_foreign_corporation_954h2A(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "an eligible controlled foreign corporation: predominantly engaged in the active conduct of a banking, financing or similar business and conducting substantial activity with respect to it (section 954(h)(2)(A))";
}
@source(IRC_S954_H, relation = formalizes, coverage = exact, quote = "The term \"eligible controlled foreign corporation\" means a controlled foreign corporation which—")
rule S954H2AEligibleCfc defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when predominantly_engaged_in_banking_or_financing_954h2B(corp, y)
     and conducts_substantial_activity_954h2Aii(corp);
    then eligible_controlled_foreign_corporation_954h2A(corp, y);
}
pub relation income_derived_in_active_conduct_of_banking_by_cfc_or_qbu_954h3Ai(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text, amount: Money) kind empirical {
    label en official "income derived in the active conduct of a banking, financing or similar business by the eligible controlled foreign corporation or a qualified business unit of it";
}
pub relation income_from_customers_outside_us_with_home_country_activity_954h3Aii(item_id: Text) kind empirical {
    label en official "the income is derived from transactions with customers located in a country other than the United States, substantially all of the activities in connection with which are conducted directly by the corporation or unit in its home country";
}
pub relation income_treated_as_earned_in_home_country_954h3Aiii(item_id: Text) kind empirical {
    label en official "the income is treated as earned by the corporation or unit in its home country for the purposes of that country's tax laws";
}
pub relation qualified_banking_or_financing_income_954h3A(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text, amount: Money) kind institutional {
    label en official "qualified banking or financing income of an eligible controlled foreign corporation (section 954(h)(3)(A)(i)-(iii))";
}
@source(IRC_S954_H, relation = formalizes, coverage = exact, quote = "The term \"qualified banking or financing income\" means income of an eligible controlled foreign corporation which—")
rule S954H3AQualifiedBankingOrFinancingIncome defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for amount: Money;
    when eligible_controlled_foreign_corporation_954h2A(corp, y)
     and income_derived_in_active_conduct_of_banking_by_cfc_or_qbu_954h3Ai(corp, y, item_id, amount)
     and income_from_customers_outside_us_with_home_country_activity_954h3Aii(item_id)
     and income_treated_as_earned_in_home_country_954h3Aiii(item_id)
     and nonbanking_limitation_met_954h3B(corp, y)
     and qualified_income_home_country_customer_limit_met_954h3C(corp, y, item_id);
    then qualified_banking_or_financing_income_954h3A(corp, y, item_id, amount);
}
pub relation item_excluded_from_fphci_954h1(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text) kind institutional {
    label en official "foreign personal holding company income does not include qualified banking or financing income of an eligible controlled foreign corporation (section 954(h)(1))";
}
@source(IRC_S954_H, relation = formalizes, coverage = exact, quote = "For purposes of subsection (c)(1), foreign personal holding company income shall not include qualified banking or financing income of an eligible controlled foreign corporation.")
rule S954H1QualifiedIncomeNotFphci defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for amount: Money;
    when qualified_banking_or_financing_income_954h3A(corp, y, item_id, amount);
    then item_excluded_from_fphci_954h1(corp, y, item_id);
}
pub relation cfc_is_dealer_in_securities_475_954h6(corp: us.irc.core::Corporation) kind empirical {
    label en official "the corporation is a dealer in securities (section 475) which is an eligible controlled foreign corporation described in paragraph (2)(B)(iii)";
}
pub relation section_954h1_not_applicable_to_dealer_income_954h6(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "paragraph (1) does not apply to income described in subsection (c)(2)(C)(ii) of a securities dealer that is an eligible CFC registered under (2)(B)(iii) (section 954(h)(6))";
}
@source(IRC_S954_H, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall not apply to income described in subsection (c)(2)(C)(ii) of a dealer in securities (within the meaning of section 475) which is an eligible controlled foreign corporation described in paragraph (2)(B)(iii).")
rule S954H6DealerCarveBack defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when cfc_is_dealer_in_securities_475_954h6(corp)
     and eligible_controlled_foreign_corporation_954h2A(corp, y)
     and registered_securities_dealer_954h2Biii(corp);
    then section_954h1_not_applicable_to_dealer_income_954h6(corp, y);
}

// --- §954(i): qualified insurance income --------------------------------------

pub relation reserves_income_from_unrelated_investments_954i2A(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "income received from a person other than a related person (section 954(d)(3)) derived from investments made by the qualifying insurance company (or branch) of its reserves allocable to exempt contracts";
}
pub relation other_assets_income_from_unrelated_investments_954i2B(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "income received from a person other than a related person derived from investments of an amount of its assets allocable to exempt contracts (other than reserves), before the asset-amount limit";
}
pub relation premiums_earned_on_property_casualty_health_contracts_954i2B(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "premiums earned on property, casualty or health insurance contracts during the taxable year (section 832(b)(4))";
}
pub relation reserves_on_life_insurance_or_annuity_contracts_954i2A(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the reserves described in subparagraph (A) for life insurance or annuity contracts";
}
pub relation asset_amount_limit_954i2B(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, limit: Money) kind institutional {
    label en official "the amount of assets whose investment income may count under (B): for property, casualty or health contracts one-third of premiums earned, plus for life insurance or annuity contracts 10 percent of the reserves (section 954(i)(2)(B)(i)-(ii))";
}
@source(IRC_S954_I, relation = formalizes, coverage = exact, quote = "(i) in the case of property, casualty, or health insurance contracts, one-third of its premiums earned on such insurance contracts during the taxable year (as defined in section 832(b)(4)), and")
rule S954I2BAssetLimit defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for premiums: Money;
    for reserves: Money;
    when premiums_earned_on_property_casualty_health_contracts_954i2B(corp, y, premiums)
     and reserves_on_life_insurance_or_annuity_contracts_954i2A(corp, y, reserves);
    then asset_amount_limit_954i2B(corp, y, round((premiums / 3.0) + (reserves * 0.10), 2, "HALF_UP"));
}
pub relation qualified_insurance_income_954i2(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "qualified insurance income of a qualifying insurance company: unrelated-person investment income of reserves allocable to exempt contracts, plus that of the allowed amount of other assets (section 954(i)(2)(A)-(B)); the allocation of income to the limited assets is not modeled (TECH-GAPS G1752), so the (B) income is the case-supplied amount within the limit";
}
@source(IRC_S954_I, relation = formalizes, coverage = partial, quote = "The term \"qualified insurance income\" means income of a qualifying insurance company which is—")
rule S954I2QualifiedInsuranceIncome defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for reserves_income: Money;
    for other_income: Money;
    when reserves_income_from_unrelated_investments_954i2A(corp, y, reserves_income)
     and other_assets_income_from_unrelated_investments_954i2B(corp, y, other_income);
    then qualified_insurance_income_954i2(corp, y, reserves_income + other_income);
}
