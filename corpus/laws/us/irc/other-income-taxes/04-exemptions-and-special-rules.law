// Chapter 2, section 1402(e) — minister/Christian Science practitioner
// exemption election, section 1402(f) — partner's year of death, section
// 1402(g) — religious sect exemption, section 1402(h) — "regular basis",
// section 1402(j) — church employee income, section 1402(l) — optional
// method lower/upper limits. Stage IRC-10 (A14), DECISION-0379.





// =============================================================================
// section 1402(e): minister / Christian Science practitioner exemption
// =============================================================================

use self::{
    IRC_S1402_E,
    IRC_S1402_F,
    IRC_S1402_G,
    IRC_S1402_J,
    Individual,
    Partnership,
    Person,
    TaxableYear,
    minister_exemption_election_valid,
    section_1402g_year_barred,
};

pub entity MinisterExemptionElection;

pub relation minister_exemption_conscientious_or_religious_opposition(e: MinisterExemptionElection) kind empirical {
    label en unofficial "the applicant states conscientious opposition, based on religious considerations, to the acceptance (with respect to services in the ministry or as a practitioner) of any public insurance benefit described in section 1402(e)(1) (or, for a member of a religious order not under a vow of poverty, an equivalent statement) — the exact statutory ground; the case asserts which";
}
pub relation minister_exemption_filed_by(e: MinisterExemptionElection, p: Individual) kind empirical;
pub relation minister_exemption_filed_on(e: MinisterExemptionElection, on: Date) kind empirical;
pub relation minister_exemption_return_due_date_second_year(e: MinisterExemptionElection, due: Date) kind empirical {
    label en unofficial "the due date (including extensions) of the return for the second taxable year for which the individual has net earnings from self-employment (computed without regard to (c)(4)/(c)(5)) of $400 or more, any part from ministerial/practitioner service — section 1402(e)(3) filing deadline";
}
pub relation minister_exemption_nese_400_second_year(p: Individual) kind empirical {
    label en unofficial "condition: the individual has had at least two taxable years with $400 or more of such net earnings, any part from section (c)(4)/(c)(5) service — a precondition to a valid section 1402(e) election, asserted by the case (TECH_GAP: no year-by-year ledger is built here to derive this automatically; see docs/foundations/us-irc/TECH-GAPS.md)";
}

pub relation section_1402e_exemption_effective(p: Individual, y: TaxableYear) kind institutional {
    label en official "an exemption under section 1402(e) is effective with respect to this individual for this taxable year";
}

@source(IRC_S1402_E, relation = formalizes, coverage = partial, quote = "Any individual who desires to file an application pursuant to paragraph (1) must file such application on or before the due date of the return (including any extension thereof) for the second taxable year for which he has net earnings from self-employment")
rule Section1402EExemptionElection(e: MinisterExemptionElection, p: Individual, on: Date, due: Date) strict {
    label en official "section 1402(e): a timely, verified exemption application filed by a minister/religious-order member/Christian Science practitioner is a power to opt out of self-employment tax on the described service";
    when minister_exemption_filed_by(e, p)
        and minister_exemption_filed_on(e, on)
        and minister_exemption_return_due_date_second_year(e, due)
        and minister_exemption_nese_400_second_year(p)
        and minister_exemption_conscientious_or_religious_opposition(e);
    then power Section1402EExemption {
        holder p;
        over e;
        exercise minister_exemption_filed_by(e, p);
        valid_when minister_exemption_election_valid(e);
        effect create(section_1402e_election_effective_from(p, on));
        window [on, infinity);
    };
}

pub relation section_1402e_election_effective_from(p: Individual, from: Date) kind institutional {
    label en official "section 1402(e)(4): the exemption is effective for the first qualifying taxable year and all succeeding taxable years, dated from the effective (election) date";
}

@source(IRC_S1402_E, relation = formalizes, coverage = partial, quote = "An exemption received by an individual pursuant to this subsection shall be effective for the first taxable year for which he has net earnings from self-employment (computed without regard to subsections (c)(4) and (c)(5)) of $400 or more, any part of which was derived from the performance of service described in subsection (c)(4) or (c)(5), and for all succeeding taxable years")
rule Section1402EExemptionAppliesToYear(p: Individual, y: TaxableYear, from: Date, start: Date) strict {
    when section_1402e_election_effective_from(p, from)
        and us.irc.core::begins(y, start)
        and start >= from;
    then section_1402e_exemption_effective(p, y);
}

pub relation minister_exemption_election_timely(e: MinisterExemptionElection) kind institutional {
    label en official "the election was filed on or before the section 1402(e)(3) deadline (the due date, with extensions, of the second-year return)";
}
rule MinisterExemptionElectionTimely(e: MinisterExemptionElection, on: Date, due: Date) strict {
    when minister_exemption_filed_on(e, on)
        and minister_exemption_return_due_date_second_year(e, due)
        and on <= due;
    then minister_exemption_election_timely(e);
}
// A late filing does not satisfy `valid_when`: the power is not validly
// exercised → POWER_INVALID_EXERCISE, no exemption effect (E-0239).

// `is_vow_of_poverty_religious_order_member` is declared in
// `03-self-employment-income.law`, next to the section 1402(c) exclusion
// rule that reads it.

// The section 1402(e) exemption is irrevocable — no revocation relation is
// declared; `us.irc.core::Election`/`revoked_on` is not wired for this
// election because the statute (unlike (g)) never authorizes revocation.

// =============================================================================
// section 1402(g): religious sect exemption
// =============================================================================

pub entity ReligiousSectExemptionApplication;

pub relation sect_exemption_filed_by(a: ReligiousSectExemptionApplication, p: Individual) kind empirical;
pub relation sect_exemption_filed_on(a: ReligiousSectExemptionApplication, on: Date) kind empirical;
pub relation sect_exemption_conscientious_opposition_and_membership(a: ReligiousSectExemptionApplication) kind empirical {
    label en unofficial "the applicant is a member of, and adherent to the tenets of, a recognized religious sect or division and is conscientiously opposed on that basis to acceptance of private/public insurance death/disability/retirement/medical-care benefits — section 1402(g)(1) first sentence";
}
pub relation sect_exemption_waiver_filed(a: ReligiousSectExemptionApplication) kind empirical {
    label en unofficial "the applicant waived all Social Security Act title II/XVIII benefits on the basis of the applicant's own and any other person's wages/self-employment income — section 1402(g)(1)(B)";
}
pub relation sect_exemption_no_benefit_already_payable(a: ReligiousSectExemptionApplication) kind empirical {
    label en unofficial "no benefit covered by the waiver had already become (or but for sections 203/222(b) of the Social Security Act would have become) payable at or before the filing of the waiver — section 1402(g)(1) final sentence condition";
}
pub relation sect_meets_commissioner_findings(a: ReligiousSectExemptionApplication) kind empirical {
    label en unofficial "the Commissioner of Social Security has found the section 1402(g)(1)(C)/(D) sect-level facts (established tenets/teachings; a substantial practice of providing reasonably for dependent members; existence since December 31, 1950) — an external-authority finding this package treats as a case fact, not re-derived (DECISION-0194 channel: administrative finding, not a Secretary/court adjudicated fact this package models further)";
}

pub relation section_1402g_exemption_effective(p: Individual, y: TaxableYear) kind institutional {
    label en official "an exemption under section 1402(g) is effective with respect to this individual for this taxable year";
}

@source(IRC_S1402_G, relation = formalizes, coverage = partial, quote = "Any individual may file an application (in such form and manner, and with such official, as may be prescribed by regulations under this chapter) for an exemption from the tax imposed by this chapter if he is a member of a recognized religious sect")
rule Section1402GExemptionElection(a: ReligiousSectExemptionApplication, p: Individual, on: Date) strict {
    when sect_exemption_filed_by(a, p)
        and sect_exemption_filed_on(a, on)
        and sect_exemption_conscientious_opposition_and_membership(a)
        and sect_exemption_waiver_filed(a)
        and sect_exemption_no_benefit_already_payable(a)
        and sect_meets_commissioner_findings(a);
    then power Section1402GExemption {
        holder p;
        over a;
        exercise sect_exemption_filed_by(a, p);
        valid_when sect_exemption_no_benefit_already_payable(a);
        effect create(section_1402g_election_effective_from(p, on));
        window [on, infinity);
    };
}

pub relation section_1402g_election_effective_from(p: Individual, from: Date) kind institutional {
    label en official "section 1402(g)(2): the exemption applies with respect to all taxable years beginning after December 31, 1950, subject to the (2)(A)/(B) window restrictions this module does not further compute (TECH_GAP, see the note below the rule)";
}
@source(IRC_S1402_G, relation = formalizes, coverage = partial, quote = "An exemption granted to any individual pursuant to this subsection shall apply with respect to all taxable years beginning after December 31, 1950")
rule Section1402GExemptionAppliesToYear(p: Individual, y: TaxableYear, from: Date, start: Date) strict {
    when section_1402g_election_effective_from(p, from)
        and us.irc.core::begins(y, start)
        and start >= from
        and start > @1950-12-31
        and not_known(section_1402g_year_barred(p, y));
    then section_1402g_exemption_effective(p, y);
}
// section 1402(g)(2): the exemption does not apply for a year beginning
// before the individual/sect first met the requirements, or ending after
// either ceased to meet them. Modelled as a window restriction the case's
// `y` must satisfy is TECH_GAP (no automatic year-window computation from
// `sect_meets_commissioner_findings`' own effective dates is wired here);
// see docs/foundations/us-irc/TECH-GAPS.md.

// =============================================================================
// section 1402(h): "regular basis"
// =============================================================================

pub relation nese_400_or_more_in_year(p: Person, activity: Person, y: Integer) kind empirical {
    label en unofficial "the person (or the partnership, referenced by its own `Person` identity as `activity`) had net earnings from self-employment, first-sentence-of-(a) basis, of not less than $400 in the given prior calendar year — a per-year case fact feeding the section 1402(h) 2-of-3-years test (TECH_GAP: not derived automatically from a running ledger of `net_earnings_from_self_employment` across years)";
}

pub relation self_employed_on_regular_basis(p: Person, activity: Person, y: Integer, count: Integer) kind institutional {
    label en official "section 1402(h): the individual (or partnership member) is deemed self-employed on a regular basis in year y if at least $400 of net earnings from self-employment arose in at least two of the three immediately preceding taxable years — this package states the qualifying-count relation; the ≥2 threshold test itself is TECH_GAP (no `count all where` aggregate over exactly the 3 preceding years is wired — see TECH-GAPS.md)";
}

// =============================================================================
// section 1402(j): church employee income
// =============================================================================

pub relation church_employee_income(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "section 1402(j)(4): gross income for services described in section 3121(b)(8)(B) (and not described in section 3121(b)(8)(A)) — a case-asserted amount because it is drawn from section 3121(b)(8)(B)'s own classification, which `us.irc.employment` does not itself expose as a distinct relation";
}

pub relation church_employee_net_earnings(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1402(j)(1): church employee income is included in net earnings from self-employment WITHOUT reduction by any deduction, and separately from other net earnings from self-employment";
}
@source(IRC_S1402_J, relation = formalizes, coverage = exact, quote = "church employee income shall not be reduced by any deduction")
rule ChurchEmployeeNetEarnings(p: Person, y: TaxableYear, amount: Money) strict {
    when church_employee_income(p, y, amount);
    then church_employee_net_earnings(p, y, amount);
}

pub relation church_employee_self_employment_income(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1402(j)(2): the $400 floor of section 1402(b)(2), applied separately to church employee income with \"$100\" substituted for \"$400\"";
}
@source(IRC_S1402_J, relation = formalizes, coverage = exact, quote = "In applying paragraph (2) of subsection (b) to church employee income, \"$100\" shall be substituted for \"$400\"")
rule ChurchEmployeeSelfEmploymentIncomeAtOrAboveFloor(p: Person, y: TaxableYear, amount: Money) strict {
    when church_employee_net_earnings(p, y, amount)
        and amount >= SeChurchEmployeeIncomeMinimum;
    then church_employee_self_employment_income(p, y, amount);
}
rule ChurchEmployeeSelfEmploymentIncomeBelowFloor(p: Person, y: TaxableYear, amount: Money) strict {
    when church_employee_net_earnings(p, y, amount)
        and amount < SeChurchEmployeeIncomeMinimum;
    then church_employee_self_employment_income(p, y, 0.00 USD);
}
// section 1402(j)(3): the (j)(1) no-deduction rule does not apply to the
// section 1402(a)(12) SE-tax deduction, and (j)(1) is applied first, before
// that deduction is computed — already respected by this module's ordering
// (church employee income enters `church_employee_self_employment_income`
// undiminished; the (a)(12) deduction in `02-net-earnings.law` operates on
// net earnings from self-employment generally, computed after (j)(1)).

// =============================================================================
// section 1402(f): partner's net earnings for the year ending on death
// =============================================================================

pub relation partnership_taxable_year_ends_within_decedents_year(pship: Partnership, decedent: Individual) kind empirical {
    label en unofficial "the partnership's taxable year referenced ends WITHIN (not WITH) the deceased partner's taxable year that ends on death — the section 1402(f) gating condition";
}
pub relation deceased_partner_distributive_share_ordinary_income(pship: Partnership, decedent: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the deceased partner's distributive share of the partnership's ordinary income or loss for the partnership taxable year referenced in section 1402(f)";
}
pub relation deceased_partner_interest_held_fraction_post_calendar_month(pship: Partnership, decedent: Individual, y: TaxableYear, fraction: Decimal) kind empirical {
    label en unofficial "the fraction of the partnership's ratably-realized ordinary income/loss NOT attributable to an interest held during any period beginning on or after the first day of the first calendar month following the decedent's death — section 1402(f) ratable-realization rule (i)";
}

pub relation deceased_partners_net_earnings_for_final_year(pship: Partnership, decedent: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1402(f): the portion of a deceased partner's distributive share includible in net earnings from self-employment for the partner's final (death-year) taxable year";
}
@source(IRC_S1402_F, relation = formalizes, coverage = partial, quote = "there shall be included so much of the deceased partner's distributive share of the partnership's ordinary income or loss for the partnership taxable year as is not attributable to an interest in the partnership during any period beginning on or after the first day of the first calendar month following the month in which such partner died")
rule DeceasedPartnersNetEarningsForFinalYear(pship: Partnership, decedent: Individual, y: TaxableYear, total: Money, fraction: Decimal) strict {
    when partnership_taxable_year_ends_within_decedents_year(pship, decedent)
        and deceased_partner_distributive_share_ordinary_income(pship, decedent, y, total)
        and deceased_partner_interest_held_fraction_post_calendar_month(pship, decedent, y, fraction);
    then deceased_partners_net_earnings_for_final_year(pship, decedent, y, round(total * fraction, 2, "HALF_UP"));
}
// section 1402(f)(2): "deceased partner's distributive share" includes the
// share of the estate/successor — REFERENCE, extends the term to a successor
// `Person`; this package's `decedent` parameter already accepts any `Person`
// through the entity hierarchy, so no separate rule is needed (see coverage
// note: NON_NORMATIVE/definitional extension, folded into the type).

// =============================================================================
// section 1402(l): optional-method lower/upper limits
// =============================================================================

pub relation ss_quarter_of_coverage_amount(y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the sum of the section 213(d) Social Security Act amounts required for a quarter of coverage, for each calendar quarter ending with or within this taxable year — SOURCE_GAP: published by the Commissioner of Social Security, not stated anywhere in the pinned Title 26 text (parallel to `us.irc.employment::contribution_and_benefit_base`); the case must assert it";
}
pub relation optional_method_lower_limit(y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1402(l)(1): the sum, over the calendar quarters ending with or within the taxable year, of the section 213(d) SSA quarter-of-coverage amount";
}
rule OptionalMethodLowerLimit(y: TaxableYear, amount: Money) strict {
    when ss_quarter_of_coverage_amount(y, amount);
    then optional_method_lower_limit(y, amount);
}
pub relation optional_method_upper_limit(y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1402(l)(2): 150 percent of the lower limit for the taxable year";
}
rule OptionalMethodUpperLimit(y: TaxableYear, lower: Money) strict {
    when optional_method_lower_limit(y, lower);
    then optional_method_upper_limit(y, round(lower * 1.5, 2, "HALF_UP"));
}
