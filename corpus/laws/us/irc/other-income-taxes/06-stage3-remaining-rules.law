// Stage 3 (26.09.2026) — reduction of the technical gaps of package
// `us.irc.other_income_taxes` under DECISION-0379 (deontic positions, not only
// elements). Status implemented_unverified: scenarios are written, not executed; no
// legal review.
//
// WHAT THIS MODULE DOES
//  - §1402(a)(5): community income of a trade or business is reallocated between
//    spouses (the carrying spouse, or the shares of a jointly operated business; a
//    partner's community distributive share stays wholly with the partner).
//  - §1402(a), penultimate sentence: a partner's distributive share counts in the year
//    in which the partnership year ends within or with the partner's year.
//  - §1402(a), optional methods (two-thirds of gross income, or the lower limit), as a
//    power of the individual whose validity is the eligibility of the year, for a farm
//    trade or business and, under the last sentence, for a nonfarm trade or business
//    on a regular basis (with the 5-year and combined lower-limit ceilings).
//  - §1402(e)(2): the Secretary's verification as a judgment that gates the exemption
//    election and the Secretary's approval power.
//  - §1402(g)(2): the year windows of a religious-sect exemption.
//  - §1402(h): the regular-basis count over the three preceding years.
//  - §1411(c)(3): income from the investment of working capital is treated as not
//    derived in the ordinary course of a trade or business.
//  - §1411(c)(4): the limit on gain or loss from the disposition of a partnership or
//    S corporation interest by a hypothetical sale of all entity property.
//
// JUDGMENT CALLS AND LIMITS (TECH-GAPS G6304-G6306)
//  - §1402(a)(5): the case attributes the item to the spouse it is recorded for; the
//    rules move the included amount to the spouse the statute names. Which income is
//    community income under state law is a case fact.
//  - Optional method: the statute measures "net earnings from such trade or business";
//    the package has no per-trade net earnings, so the net earnings of each kind of trade
//    or business computed without the optional-method sentence are a case fact
//    (`optional_method_nese_without_election`). Under the one-trade fiction of the flush
//    sentence about several trades, the clauses for an individual and for a partner are
//    applied to the aggregated gross income, and their common deemed amount is used.
//    The individual's and the partner's clauses differ only in the figure they deem;
//    both are the same two-thirds or lower-limit amount.
//  - Gross income for the optional method is per recorded trade: cash method receipts less
//    cost of property purchased and sold, or accrual gross income, adjusted by the
//    net of paragraphs (1)-(7) and (9) (asserted) and reduced by section 707(c)
//    payments (partners).
//  - For the nonfarm sentence the comparison sum is the individual trades' gross income
//    plus the asserted distributive share of income or loss of all partnerships.
//  - The combined ceiling (both a farm and a nonfarm trade elected) limits the SUM of
//    the two deemed amounts to the lower limit.
//  - §1402(e)(2): the Secretary's verification is an external judgment relation with
//    authority Secretary (DECISION-0194), asserted with origin adjudicated.
//  - §1411(c)(4): the amounts of the hypothetical sale are recorded per property (the
//    transferor's share); a property whose gain would not be taken into account is
//    marked so.

// ============================================================================
// §1402(a)(5) — community income
// ============================================================================

use self::{
    IRC_S1402_A,
    IRC_S1402_E,
    IRC_S1402_G,
    IRC_S1402_H,
    IRC_S1411_C,
    Individual,
    MinisterExemptionElection,
    NetInvestmentIncomeItem,
    NiiItemKind,
    Person,
    ReligiousSectExemptionApplication,
    Secretary,
    SelfEmploymentItem,
    SelfEmploymentItemKind,
    TaxableYear,
    derived_in_ordinary_course_of_active_trade_or_business,
    minister_exemption_election_timely,
    minister_exemption_filed_by,
    nese_400_or_more_in_year,
    net_earnings_from_self_employment,
    nii_item,
    nii_item_included,
    optional_method_lower_limit,
    optional_method_upper_limit,
    property_held_in_active_trade_or_business,
    sect_exemption_filed_by,
    self_employed_on_regular_basis,
    self_employment_item,
    self_employment_item_included,
};

relation community_income_item(item: SelfEmploymentItem) kind empirical { label en unofficial "the income derived from the trade or business is community income under the community property laws applicable to it"; }
relation community_item_carrying_spouse(item: SelfEmploymentItem, spouse: Person) kind empirical { label en unofficial "the spouse carrying on the trade or business (not carried on by a partnership)"; }
relation community_item_joint_operation_share(item: SelfEmploymentItem, spouse: Person, percent: Decimal) kind empirical { label en unofficial "the trade or business is jointly operated: the spouse's percentage of the gross income and deductions"; }
relation community_partner_share_owner(item: SelfEmploymentItem, partner: Person) kind empirical { label en unofficial "the item is a portion of the partner's distributive share of the ordinary income or loss of a partnership trade or business that is community income or loss"; }
relation community_income_item_reallocated(item: SelfEmploymentItem) kind institutional { label en unofficial "section 1402(a)(5) reallocates the item between spouses"; }
relation self_employment_item_included_after_community(item: SelfEmploymentItem, p: Person, y: TaxableYear, amount: Money) kind institutional { label en unofficial "the amount of the item included in this person's net earnings after the community-property and partner-year rules"; }
relation has_self_employment_activity(p: Person, y: TaxableYear) kind institutional { label en unofficial "the person has an item of a trade or business for the year, or is allocated one"; }

@source(IRC_S1402_A, relation = formalizes, coverage = exact, quote = "the gross income and deductions attributable to such trade or business shall be treated as the gross income and deductions of the spouse carrying on such trade or business")
rule S1402a5ReallocatedToCarryingSpouse strict {
    for item: SelfEmploymentItem;
    for s: Person;
    when community_income_item(item) and community_item_carrying_spouse(item, s);
    then community_income_item_reallocated(item);
}
@source(IRC_S1402_A, relation = formalizes, coverage = exact, quote = "if such trade or business is jointly operated, treated as the gross income and deductions of each spouse on the basis of their respective distributive share of the gross income and deductions")
rule S1402a5ReallocatedJointOperation strict {
    for item: SelfEmploymentItem;
    for s: Person;
    for pct: Decimal;
    when community_income_item(item) and community_item_joint_operation_share(item, s, pct);
    then community_income_item_reallocated(item);
}
@source(IRC_S1402_A, relation = formalizes, coverage = exact, quote = "all of such distributive share shall be included in computing the net earnings from self-employment of such partner")
rule S1402a5ReallocatedPartnerShare strict {
    for item: SelfEmploymentItem;
    for partner: Person;
    when community_income_item(item) and community_partner_share_owner(item, partner);
    then community_income_item_reallocated(item);
}

@source(IRC_S1402_A, relation = formalizes, coverage = partial, quote = "The term \"net earnings from self-employment\" means the gross income derived by an individual from any trade or business carried on by such individual")
rule S1402aItemIncludedUnlessReallocated defeasible {
    for item: SelfEmploymentItem;
    for p: Person;
    for y: TaxableYear;
    for amount: Money;
    when self_employment_item_included(item, p, y, amount);
    then self_employment_item_included_after_community(item, p, y, amount);
    unless community_income_item_reallocated(item) and self_employment_item_included(item, p, y, amount);
    unless partner_item_outside_partner_year(item, y) and self_employment_item_included(item, p, y, amount);
}
@source(IRC_S1402_A, relation = formalizes, coverage = exact, quote = "the gross income and deductions attributable to such trade or business shall be treated as the gross income and deductions of the spouse carrying on such trade or business")
rule S1402a5CarryingSpouseTakesTheItem defeasible {
    for item: SelfEmploymentItem;
    for q: Person;
    for s: Person;
    for y: TaxableYear;
    for amount: Money;
    when self_employment_item_included(item, q, y, amount) and community_income_item(item) and community_item_carrying_spouse(item, s);
    then self_employment_item_included_after_community(item, s, y, amount);
    unless partner_item_outside_partner_year(item, y) and self_employment_item_included(item, q, y, amount) and community_item_carrying_spouse(item, s);
}
@source(IRC_S1402_A, relation = formalizes, coverage = exact, quote = "treated as the gross income and deductions of each spouse on the basis of their respective distributive share of the gross income and deductions")
rule S1402a5JointOperationShare defeasible {
    for item: SelfEmploymentItem;
    for q: Person;
    for s: Person;
    for y: TaxableYear;
    for amount: Money;
    for pct: Decimal;
    when self_employment_item_included(item, q, y, amount) and community_income_item(item) and community_item_joint_operation_share(item, s, pct);
    then self_employment_item_included_after_community(item, s, y, round(amount * pct / 100.0, 2, "HALF_UP"));
    unless partner_item_outside_partner_year(item, y) and self_employment_item_included(item, q, y, amount) and community_item_joint_operation_share(item, s, pct);
}
@source(IRC_S1402_A, relation = formalizes, coverage = exact, quote = "no part of such share shall be taken into account in computing the net earnings from self-employment of the spouse of such partner")
rule S1402a5PartnerTakesWholeShare defeasible {
    for item: SelfEmploymentItem;
    for q: Person;
    for partner: Person;
    for y: TaxableYear;
    for amount: Money;
    when self_employment_item_included(item, q, y, amount) and community_income_item(item) and community_partner_share_owner(item, partner);
    then self_employment_item_included_after_community(item, partner, y, amount);
    unless partner_item_outside_partner_year(item, y) and self_employment_item_included(item, q, y, amount) and community_partner_share_owner(item, partner);
}

rule S1402aActivityFromItem strict { for item: SelfEmploymentItem; for p: Person; for y: TaxableYear; for k: SelfEmploymentItemKind; for a: Money; when self_employment_item(item, p, y, k, a); then has_self_employment_activity(p, y); }
rule S1402aActivityFromAllocation defeasible { for item: SelfEmploymentItem; for p: Person; for y: TaxableYear; for a: Money; when self_employment_item_included_after_community(item, p, y, a); then has_self_employment_activity(p, y); }

// ============================================================================
// §1402(a), penultimate sentence — partner's year differs from the partnership's
// ============================================================================

relation self_employment_item_from_partnership_year(item: SelfEmploymentItem, py: TaxableYear) kind empirical { label en unofficial "the item is the partner's distributive share of the ordinary income or loss of the partnership for this partnership taxable year"; }
relation partner_item_outside_partner_year(item: SelfEmploymentItem, y: TaxableYear) kind institutional { label en unofficial "the partnership year of the item does not end within or with the partner's taxable year"; }
@source(IRC_S1402_A, relation = formalizes, coverage = exact, quote = "the distributive share which he is required to include in computing his net earnings from self-employment shall be based on the ordinary income or loss of the partnership for any taxable year of the partnership ending within or with his taxable year.")
rule S1402aPartnerYearEndsBefore strict {
    for item: SelfEmploymentItem;
    for py: TaxableYear;
    for y: TaxableYear;
    for e: Date;
    for s: Date;
    when self_employment_item_from_partnership_year(item, py) and us.irc.core::ends(py, e) and us.irc.core::begins(y, s);
    when e < s;
    then partner_item_outside_partner_year(item, y);
}
@source(IRC_S1402_A, relation = formalizes, coverage = exact, quote = "the distributive share which he is required to include in computing his net earnings from self-employment shall be based on the ordinary income or loss of the partnership for any taxable year of the partnership ending within or with his taxable year.")
rule S1402aPartnerYearEndsAfter strict {
    for item: SelfEmploymentItem;
    for py: TaxableYear;
    for y: TaxableYear;
    for e: Date;
    for f: Date;
    when self_employment_item_from_partnership_year(item, py) and us.irc.core::ends(py, e) and us.irc.core::ends(y, f);
    when e > f;
    then partner_item_outside_partner_year(item, y);
}

// ============================================================================
// §1402(h) — regular basis
// ============================================================================

relation regular_basis_1402h(p: Person, activity: Person, y: Integer) kind institutional { label en unofficial "the individual is self-employed, or a partner, on a regular basis in the year: net earnings of at least $400 in at least two of the three preceding years"; }
@source(IRC_S1402_H, relation = formalizes, coverage = exact, quote = "he had net earnings from self-employment, as defined in the first sentence of subsection (a), of not less than $400 in at least two of the three consecutive taxable years immediately preceding such taxable year")
rule S1402hCountOfQualifyingYearsPlus1 defeasible {
    for p: Person;
    for activity: Person;
    for yy: Integer;
    when nese_400_or_more_in_year(p, activity, yy);
    then self_employed_on_regular_basis(p, activity, yy + 1, count(collect y2: Integer where nese_400_or_more_in_year(p, activity, y2) and y2 >= yy + 1 - 3 and y2 <= yy + 1 - 1));
}
@source(IRC_S1402_H, relation = formalizes, coverage = exact, quote = "he had net earnings from self-employment, as defined in the first sentence of subsection (a), of not less than $400 in at least two of the three consecutive taxable years immediately preceding such taxable year")
rule S1402hCountOfQualifyingYearsPlus2 defeasible {
    for p: Person;
    for activity: Person;
    for yy: Integer;
    when nese_400_or_more_in_year(p, activity, yy);
    then self_employed_on_regular_basis(p, activity, yy + 2, count(collect y2: Integer where nese_400_or_more_in_year(p, activity, y2) and y2 >= yy + 2 - 3 and y2 <= yy + 2 - 1));
}
@source(IRC_S1402_H, relation = formalizes, coverage = exact, quote = "he had net earnings from self-employment, as defined in the first sentence of subsection (a), of not less than $400 in at least two of the three consecutive taxable years immediately preceding such taxable year")
rule S1402hCountOfQualifyingYearsPlus3 defeasible {
    for p: Person;
    for activity: Person;
    for yy: Integer;
    when nese_400_or_more_in_year(p, activity, yy);
    then self_employed_on_regular_basis(p, activity, yy + 3, count(collect y2: Integer where nese_400_or_more_in_year(p, activity, y2) and y2 >= yy + 3 - 3 and y2 <= yy + 3 - 1));
}
@source(IRC_S1402_H, relation = formalizes, coverage = exact, quote = "An individual shall be deemed to be self-employed on a regular basis in a taxable year, or to be a member of a partnership on a regular basis in such year, if he had net earnings")
rule S1402hRegularBasisAtTwoOfThree defeasible {
    for p: Person;
    for activity: Person;
    for y: Integer;
    for n: Integer;
    when self_employed_on_regular_basis(p, activity, y, n) and n >= 2;
    then regular_basis_1402h(p, activity, y);
}

// ============================================================================
// §1402(a), optional methods
// ============================================================================

enum OptionalMethodKind {
    FarmOptionalMethod;
    NonFarmOptionalMethod;
}
enum OptionalMethodCapacity {
    IndividualTrade;
    PartnershipMember;
}
enum OptionalMethodAccounting {
    CashReceiptsMethod;
    AccrualMethod;
}

relation optional_method_trade_record(p: Person, y: TaxableYear, kind: OptionalMethodKind, capacity: OptionalMethodCapacity, trade: Person, accounting: OptionalMethodAccounting, gross: Money, cost_of_property_purchased_and_sold: Money, adjustments_1_to_7_and_9: Money, section_707c_payments: Money) kind empirical { label en unofficial "one trade or business of the year: gross receipts (cash method) or gross income (accrual method), cost or other basis of property purchased and sold (cash method), the net adjustment of section 1402(a)(1)-(7) and (9), and section 707(c) payments (a partner's distributive share of gross income)"; }
relation optional_method_nese_without_election(p: Person, y: TaxableYear, kind: OptionalMethodKind, amount: Money) kind empirical { label en unofficial "the net earnings from self-employment derived from the trades or businesses of this kind, computed without the optional-method sentence"; }
relation distributive_share_income_or_loss_all_partnerships(p: Person, y: TaxableYear, amount: Money) kind empirical { label en unofficial "the individual's distributive share of the income or loss from all trades or businesses carried on by all the partnerships of which he is a member"; }
relation optional_method_nonfarm_year_used(p: Person, y: TaxableYear) kind empirical { label en unofficial "the nonfarm optional method was applied to this earlier taxable year"; }
relation elects_optional_method(p: Person, y: TaxableYear, kind: OptionalMethodKind) kind empirical { label en unofficial "the individual elects to have the net earnings from the trade or business deemed under the optional method"; }

relation optional_method_trade_gross_income(p: Person, y: TaxableYear, kind: OptionalMethodKind, capacity: OptionalMethodCapacity, trade: Person, amount: Money) kind institutional { label en unofficial "gross income of the trade or business for the optional method (clauses (v) and (vi))"; }
@source(IRC_S1402_A, relation = formalizes, coverage = exact, quote = "the gross receipts from such trade or business reduced by the cost or other basis of property which was purchased and sold in carrying on such trade or business, adjusted (after such reduction) in accordance with the provisions of paragraphs (1) through (7) and paragraph (9) of this subsection")
rule S1402aOptionalGrossIncomeCash strict {
    for p: Person;
    for y: TaxableYear;
    for kind: OptionalMethodKind;
    for cap: OptionalMethodCapacity;
    for trade: Person;
    for g: Money;
    for c: Money;
    for a: Money;
    for x: Money;
    when optional_method_trade_record(p, y, kind, cap, trade, CashReceiptsMethod, g, c, a, x);
    then optional_method_trade_gross_income(p, y, kind, cap, trade, g - c + a - x);
}
@source(IRC_S1402_A, relation = formalizes, coverage = exact, quote = "the gross income from such trade or business, adjusted in accordance with the provisions of paragraphs (1) through (7) and paragraph (9) of this subsection")
rule S1402aOptionalGrossIncomeAccrual strict {
    for p: Person;
    for y: TaxableYear;
    for kind: OptionalMethodKind;
    for cap: OptionalMethodCapacity;
    for trade: Person;
    for g: Money;
    for c: Money;
    for a: Money;
    for x: Money;
    when optional_method_trade_record(p, y, kind, cap, trade, AccrualMethod, g, c, a, x);
    then optional_method_trade_gross_income(p, y, kind, cap, trade, g + a - x);
}
relation optional_method_gross_income_all(p: Person, y: TaxableYear, kind: OptionalMethodKind, amount: Money) kind institutional { label en unofficial "gross income of all the trades or businesses of this kind, deemed derived from one trade or business"; }
@source(IRC_S1402_A, relation = formalizes, coverage = exact, quote = "such gross income (including his distributive share of the gross income of any partnership derived from any such trade or business) shall be deemed to have been derived from one trade or business.")
rule S1402aOptionalOneTradeFiction strict {
    for p: Person;
    for y: TaxableYear;
    for kind: OptionalMethodKind;
    for cap: OptionalMethodCapacity;
    for trade: Person;
    for g: Money;
    when optional_method_trade_gross_income(p, y, kind, cap, trade, g);
    then optional_method_gross_income_all(p, y, kind, sum(collect all g2: Money, cap2: OptionalMethodCapacity, t2: Person where optional_method_trade_gross_income(p, y, kind, cap2, t2, g2), empty: 0.00 USD));
}

relation optional_method_deemed_amount(p: Person, y: TaxableYear, kind: OptionalMethodKind, amount: Money) kind institutional { label en unofficial "the amount deemed to be the net earnings from the trade or business under clauses (i)-(iv)"; }
@source(IRC_S1402_A, relation = formalizes, coverage = exact, quote = "the net earnings from self-employment derived by him from such trade or business may, at his option, be deemed to be 662/3 percent of such gross income")
rule S1402aOptionalTwoThirdsOfGrossIncome strict {
    for p: Person;
    for y: TaxableYear;
    for kind: OptionalMethodKind;
    for g: Money;
    for ul: Money;
    when optional_method_gross_income_all(p, y, kind, g) and optional_method_upper_limit(y, ul);
    when g <= ul;
    then optional_method_deemed_amount(p, y, kind, div_round(g * 2.0, 3.0, 2, "HALF_UP"));
}
@source(IRC_S1402_A, relation = formalizes, coverage = exact, quote = "the net earnings from self-employment derived by him from such trade or business may, at his option, be deemed to be the lower limit")
rule S1402aOptionalLowerLimit strict {
    for p: Person;
    for y: TaxableYear;
    for kind: OptionalMethodKind;
    for g: Money;
    for n: Money;
    for ul: Money;
    for ll: Money;
    when optional_method_gross_income_all(p, y, kind, g) and optional_method_nese_without_election(p, y, kind, n) and optional_method_upper_limit(y, ul) and optional_method_lower_limit(y, ll);
    when g > ul and n < ll;
    then optional_method_deemed_amount(p, y, kind, ll);
}

relation individual_regular_basis_for_year(p: Person, y: TaxableYear) kind institutional { label en unofficial "the individual is self-employed, or a partner, on a regular basis (section 1402(h)) in the calendar year of the taxable year"; }
rule S1402aRegularBasisForTaxableYear defeasible {
    for p: Person;
    for y: TaxableYear;
    for n: Integer;
    for activity: Person;
    when us.irc.core::calendar_year_of(y, n) and regular_basis_1402h(p, activity, n);
    then individual_regular_basis_for_year(p, y);
}
relation nonfarm_optional_method_conditions_met(p: Person, y: TaxableYear) kind institutional { label en unofficial "the conditions of the last optional-method sentence hold: regular basis, net earnings below the lower limit and below two-thirds of gross income and partnership shares, fewer than 5 earlier years"; }
@source(IRC_S1402_A, relation = formalizes, coverage = exact, quote = "but only if such individual's net earnings from self-employment as determined without regard to this sentence in the taxable year are less than the lower limit and less than 662/3 percent of the sum (in such taxable year) of such individual's gross income derived from all trades or businesses carried on by him and his distributive share of the income or loss from all trades or businesses carried on by all the partnerships of which he is a member")
rule S1402aNonFarmConditions defeasible {
    for p: Person;
    for y: TaxableYear;
    for n: Money;
    for ll: Money;
    for share: Money;
    when individual_regular_basis_for_year(p, y) and net_earnings_from_self_employment(p, y, n) and optional_method_lower_limit(y, ll) and distributive_share_income_or_loss_all_partnerships(p, y, share);
    when n < ll and count(collect y2: TaxableYear where optional_method_nonfarm_year_used(p, y2)) < 5;
    when n < div_round((sum(collect all g: Money, cap: OptionalMethodCapacity, k: OptionalMethodKind, t: Person where optional_method_trade_gross_income(p, y, k, cap, t, g) and cap == IndividualTrade, empty: 0.00 USD) + share) * 2.0, 3.0, 2, "HALF_UP");
    then nonfarm_optional_method_conditions_met(p, y);
}

relation optional_method_eligible(p: Person, y: TaxableYear, kind: OptionalMethodKind) kind institutional { label en unofficial "the optional method may be applied to the trades or businesses of this kind in the year"; }
@source(IRC_S1402_A, relation = formalizes, coverage = exact, quote = "in which, if such trade or business were carried on exclusively by employees, the major portion of the services would constitute agricultural labor as defined in section 3121(g)")
rule S1402aFarmEligible strict {
    for p: Person;
    for y: TaxableYear;
    for a: Money;
    when optional_method_deemed_amount(p, y, FarmOptionalMethod, a);
    then optional_method_eligible(p, y, FarmOptionalMethod);
}
@source(IRC_S1402_A, relation = formalizes, coverage = exact, quote = "The preceding sentence and clauses (i) through (iv) of the second preceding sentence shall also apply in the case of any trade or business (other than a trade or business specified in such second preceding sentence)")
rule S1402aNonFarmEligible defeasible {
    for p: Person;
    for y: TaxableYear;
    for a: Money;
    when optional_method_deemed_amount(p, y, NonFarmOptionalMethod, a) and nonfarm_optional_method_conditions_met(p, y);
    then optional_method_eligible(p, y, NonFarmOptionalMethod);
}

relation optional_method_election_effective(p: Person, y: TaxableYear, kind: OptionalMethodKind, amount: Money) kind institutional { label en unofficial "the election is effective: the net earnings from the trades or businesses of this kind are deemed to be this amount"; }
@source(IRC_S1402_A, relation = formalizes, coverage = exact, quote = "may, at his option, be deemed to be")
rule S1402aOptionalMethodElectionPower strict {
    for p: Person;
    for y: TaxableYear;
    for kind: OptionalMethodKind;
    for a: Money;
    when optional_method_deemed_amount(p, y, kind, a);
    then power Section1402AOptionalMethodElection {
        holder p;
        over y;
        exercise elects_optional_method(p, y, kind);
        valid_when optional_method_eligible(p, y, kind);
        effect create(optional_method_election_effective(p, y, kind, a));
        window [-infinity, infinity];
    };
}

relation net_earnings_effective(p: Person, y: TaxableYear, amount: Money) kind institutional { label en unofficial "net earnings from self-employment after the optional method, if elected: the amount section 1402(b) starts from"; }
relation optional_method_elected_any(p: Person, y: TaxableYear) kind institutional { label en unofficial "some optional-method election is effective for the year"; }
rule S1402aElectedAnyFarm defeasible { for p: Person; for y: TaxableYear; for a: Money; when optional_method_election_effective(p, y, FarmOptionalMethod, a); then optional_method_elected_any(p, y); }
rule S1402aElectedAnyNonFarm defeasible { for p: Person; for y: TaxableYear; for a: Money; when optional_method_election_effective(p, y, NonFarmOptionalMethod, a); then optional_method_elected_any(p, y); }
@source(IRC_S1402_A, relation = formalizes, coverage = partial, quote = "the net earnings from self-employment derived by him from such trade or business may, at his option, be deemed")
rule S1402aNetEarningsNoElection defeasible {
    for p: Person;
    for y: TaxableYear;
    for n: Money;
    when net_earnings_from_self_employment(p, y, n);
    then net_earnings_effective(p, y, n);
    unless optional_method_elected_any(p, y) and net_earnings_from_self_employment(p, y, n);
}
rule S1402aNetEarningsFarmOnly defeasible {
    for p: Person;
    for y: TaxableYear;
    for n: Money;
    for nf: Money;
    for d: Money;
    when net_earnings_from_self_employment(p, y, n) and optional_method_nese_without_election(p, y, FarmOptionalMethod, nf) and optional_method_election_effective(p, y, FarmOptionalMethod, d);
    then net_earnings_effective(p, y, n - nf + d);
    unless optional_method_elected_nonfarm(p, y) and net_earnings_from_self_employment(p, y, n) and optional_method_nese_without_election(p, y, FarmOptionalMethod, nf) and optional_method_election_effective(p, y, FarmOptionalMethod, d);
}
rule S1402aNetEarningsNonFarmOnly defeasible {
    for p: Person;
    for y: TaxableYear;
    for n: Money;
    for nn: Money;
    for d: Money;
    when net_earnings_from_self_employment(p, y, n) and optional_method_nese_without_election(p, y, NonFarmOptionalMethod, nn) and optional_method_election_effective(p, y, NonFarmOptionalMethod, d);
    then net_earnings_effective(p, y, n - nn + d);
    unless optional_method_elected_farm(p, y) and net_earnings_from_self_employment(p, y, n) and optional_method_nese_without_election(p, y, NonFarmOptionalMethod, nn) and optional_method_election_effective(p, y, NonFarmOptionalMethod, d);
}
relation optional_method_elected_farm(p: Person, y: TaxableYear) kind institutional { label en unofficial "the farm optional method is effective for the year"; }
relation optional_method_elected_nonfarm(p: Person, y: TaxableYear) kind institutional { label en unofficial "the nonfarm optional method is effective for the year"; }
rule S1402aElectedFarmMarker defeasible { for p: Person; for y: TaxableYear; for a: Money; when optional_method_election_effective(p, y, FarmOptionalMethod, a); then optional_method_elected_farm(p, y); }
rule S1402aElectedNonFarmMarker defeasible { for p: Person; for y: TaxableYear; for a: Money; when optional_method_election_effective(p, y, NonFarmOptionalMethod, a); then optional_method_elected_nonfarm(p, y); }
@source(IRC_S1402_A, relation = formalizes, coverage = exact, quote = "in no case in which an individual elects to determine the amount of his net earnings from self-employment for a taxable year under the provisions of the two preceding sentences with respect to a trade or business to which the second preceding sentence applies and with respect to a trade or business to which this sentence applies shall such net earnings for such year exceed the lower limit.")
rule S1402aNetEarningsBothCappedAtLowerLimit defeasible {
    for p: Person;
    for y: TaxableYear;
    for n: Money;
    for nf: Money;
    for nn: Money;
    for df: Money;
    for dn: Money;
    for ll: Money;
    when net_earnings_from_self_employment(p, y, n) and optional_method_nese_without_election(p, y, FarmOptionalMethod, nf) and optional_method_nese_without_election(p, y, NonFarmOptionalMethod, nn) and optional_method_election_effective(p, y, FarmOptionalMethod, df) and optional_method_election_effective(p, y, NonFarmOptionalMethod, dn) and optional_method_lower_limit(y, ll);
    then net_earnings_effective(p, y, n - nf - nn + (if df + dn > ll then ll else df + dn));
}

// ============================================================================
// §1402(e)(2) — Secretary's verification of the exemption application
// ============================================================================

external judgment relation secretary_verified_applicant_aware_of_grounds(e: MinisterExemptionElection) {
    authority Secretary;
    label en unofficial "the Secretary (or the Commissioner of Social Security under an agreement) has verified that the applicant is aware of the grounds on which an exemption may be received and seeks it on those grounds (a judgment of the Secretary)";
}
relation minister_exemption_election_valid(e: MinisterExemptionElection) kind institutional { label en unofficial "the application is timely and the Secretary has verified the applicant's awareness of the grounds"; }
@source(IRC_S1402_E, relation = formalizes, coverage = exact, quote = "The Secretary may approve an application for an exemption filed pursuant to paragraph (1) only if the Secretary has verified that the individual applying for the exemption is aware of the grounds on which the individual may receive an exemption pursuant to this subsection and that the individual seeks exemption on such grounds.")
rule S1402e2ElectionValidWhenTimelyAndVerified defeasible {
    for e: MinisterExemptionElection;
    when minister_exemption_election_timely(e) and secretary_verified_applicant_aware_of_grounds(e);
    then minister_exemption_election_valid(e);
}
relation secretary_approval_of_minister_application(e: MinisterExemptionElection) kind empirical { label en unofficial "the Secretary approves the application"; }
relation minister_exemption_application_approved(e: MinisterExemptionElection) kind institutional { label en unofficial "the Secretary has approved the exemption application"; }
@source(IRC_S1402_E, relation = formalizes, coverage = exact, quote = "The Secretary may approve an application for an exemption filed pursuant to paragraph (1) only if the Secretary has verified")
rule S1402e2SecretaryApprovalPower strict {
    for e: MinisterExemptionElection;
    for p: Individual;
    when minister_exemption_filed_by(e, p);
    then power SecretaryApprovesMinisterExemptionApplication {
        holder Secretary;
        over e;
        exercise secretary_approval_of_minister_application(e);
        valid_when secretary_verified_applicant_aware_of_grounds(e);
        effect create(minister_exemption_application_approved(e));
        window [-infinity, infinity];
    };
}

// ============================================================================
// §1402(g)(2) — period for which the sect exemption is effective
// ============================================================================

relation individual_first_met_sect_requirements_in_year(p: Individual, fy: TaxableYear) kind empirical { label en unofficial "the taxable year in which the individual first met the requirements of the first sentence of paragraph (1)"; }
relation commissioner_finds_sect_met_requirements_from(a: ReligiousSectExemptionApplication, d: Date) kind empirical { label en unofficial "the Commissioner of Social Security finds that the sect met the requirements of subparagraphs (C) and (D) as of this time"; }
relation individual_ceases_to_meet_sect_requirements_on(p: Individual, d: Date) kind empirical { label en unofficial "the individual ceases to meet the requirements of the first sentence of paragraph (1) at this time"; }
relation commissioner_finds_sect_ceased_requirements_on(a: ReligiousSectExemptionApplication, d: Date) kind empirical { label en unofficial "the Commissioner finds that the sect ceases to meet the requirements of subparagraph (C) or (D) as of this time"; }
relation section_1402g_year_barred(p: Individual, y: TaxableYear) kind institutional { label en unofficial "the exemption does not apply for the taxable year under section 1402(g)(2)(A) or (B)"; }

@source(IRC_S1402_G, relation = formalizes, coverage = exact, quote = "(A) beginning (i) before the taxable year in which such individual first met the requirements of the first sentence of paragraph (1)")
rule S1402g2AiBeforeIndividualMetRequirements strict {
    for p: Individual;
    for y: TaxableYear;
    for fy: TaxableYear;
    for s: Date;
    for fs: Date;
    when individual_first_met_sect_requirements_in_year(p, fy) and us.irc.core::begins(y, s) and us.irc.core::begins(fy, fs);
    when s < fs;
    then section_1402g_year_barred(p, y);
}
@source(IRC_S1402_G, relation = formalizes, coverage = exact, quote = "or (ii) before the time as of which the Commissioner of Social Security finds that the sect or division thereof of which such individual is a member met the requirements of subparagraphs (C) and (D)")
rule S1402g2AiiBeforeSectMetRequirements strict {
    for p: Individual;
    for a: ReligiousSectExemptionApplication;
    for y: TaxableYear;
    for s: Date;
    for d: Date;
    when sect_exemption_filed_by(a, p) and commissioner_finds_sect_met_requirements_from(a, d) and us.irc.core::begins(y, s);
    when s < d;
    then section_1402g_year_barred(p, y);
}
@source(IRC_S1402_G, relation = formalizes, coverage = exact, quote = "(B) ending (i) after the time such individual ceases to meet the requirements of the first sentence of paragraph (1)")
rule S1402g2BiAfterIndividualCeases strict {
    for p: Individual;
    for y: TaxableYear;
    for e: Date;
    for d: Date;
    when individual_ceases_to_meet_sect_requirements_on(p, d) and us.irc.core::ends(y, e);
    when e > d;
    then section_1402g_year_barred(p, y);
}
@source(IRC_S1402_G, relation = formalizes, coverage = exact, quote = "or (ii) after the time as of which the Commissioner of Social Security finds that the sect or division thereof of which he is a member ceases to meet the requirements of subparagraph (C) or (D)")
rule S1402g2BiiAfterSectCeases strict {
    for p: Individual;
    for a: ReligiousSectExemptionApplication;
    for y: TaxableYear;
    for e: Date;
    for d: Date;
    when sect_exemption_filed_by(a, p) and commissioner_finds_sect_ceased_requirements_on(a, d) and us.irc.core::ends(y, e);
    when e > d;
    then section_1402g_year_barred(p, y);
}

// ============================================================================
// §1411(c)(3) — income on the investment of working capital
// ============================================================================

relation attributable_to_investment_of_working_capital(item: NetInvestmentIncomeItem, p: Person, y: TaxableYear) kind empirical { label en unofficial "the income, gain or loss is attributable to the investment of working capital (a rule similar to section 469(e)(1)(B))"; }
relation ordinary_course_of_active_business_after_working_capital(item: NetInvestmentIncomeItem, p: Person, y: TaxableYear) kind institutional { label en unofficial "the item is derived in the ordinary course of an active trade or business, not counting income from the investment of working capital, which is treated as not so derived"; }
@source(IRC_S1411_C, relation = formalizes, coverage = exact, quote = "A rule similar to the rule of section 469(e)(1)(B) shall apply for purposes of this subsection.")
rule S1411c3OrdinaryCourseExceptWorkingCapital strict {
    for item: NetInvestmentIncomeItem;
    for p: Person;
    for y: TaxableYear;
    when derived_in_ordinary_course_of_active_trade_or_business(item, p, y) and not_known(attributable_to_investment_of_working_capital(item, p, y));
    then ordinary_course_of_active_business_after_working_capital(item, p, y);
}
relation property_held_in_active_business_after_working_capital(item: NetInvestmentIncomeItem, p: Person, y: TaxableYear) kind institutional { label en unofficial "the disposed property was held in an active trade or business, not counting the investment of working capital"; }
@source(IRC_S1411_C, relation = formalizes, coverage = exact, quote = "A rule similar to the rule of section 469(e)(1)(B) shall apply for purposes of this subsection.")
rule S1411c3PropertyHeldExceptWorkingCapital strict {
    for item: NetInvestmentIncomeItem;
    for p: Person;
    for y: TaxableYear;
    when property_held_in_active_trade_or_business(item, p, y) and not_known(attributable_to_investment_of_working_capital(item, p, y));
    then property_held_in_active_business_after_working_capital(item, p, y);
}

// ============================================================================
// §1411(c)(4) — dispositions of partnership and S corporation interests
// ============================================================================

relation disposition_of_partnership_or_s_corporation_interest(item: NetInvestmentIncomeItem) kind empirical { label en unofficial "the net gain item is the gain or loss from the disposition of an interest in a partnership or S corporation"; }
relation hypothetical_sale_property_share(item: NetInvestmentIncomeItem, prop: us.irc.core::Asset, amount: Money) kind empirical { label en unofficial "the transferor's share of the gain (positive) or loss (negative) on this property if all property of the entity were sold for fair market value immediately before the disposition"; }
relation hypothetical_sale_property_not_taken_into_account(item: NetInvestmentIncomeItem, prop: us.irc.core::Asset) kind empirical { label en unofficial "the gain or loss on this property would not be taken into account under clause (iii) (property held in a trade or business not described in paragraph (2))"; }
relation hypothetical_sale_net_gain(item: NetInvestmentIncomeItem, amount: Money) kind institutional { label en unofficial "the net gain or loss the transferor would take into account if all property of the entity were sold"; }
relation limited_interest_disposition_amount(item: NetInvestmentIncomeItem, amount: Money) kind institutional { label en unofficial "the gain or loss from the disposition taken into account under section 1411(c)(1)(A)(iii) after the (c)(4) limit"; }

@source(IRC_S1411_C, relation = formalizes, coverage = exact, quote = "only to the extent of the net gain which would be so taken into account by the transferor if all property of the partnership or S corporation were sold for fair market value immediately before the disposition of such interest")
rule S1411c4HypotheticalSaleNetGain strict {
    for item: NetInvestmentIncomeItem;
    for prop: us.irc.core::Asset;
    for a: Money;
    when disposition_of_partnership_or_s_corporation_interest(item) and hypothetical_sale_property_share(item, prop, a);
    then hypothetical_sale_net_gain(item, sum(collect all a2: Money, p2: us.irc.core::Asset where hypothetical_sale_property_share(item, p2, a2) and not hypothetical_sale_property_not_taken_into_account(item, p2), empty: 0.00 USD));
}
@source(IRC_S1411_C, relation = formalizes, coverage = exact, quote = "(A) gain from such disposition shall be taken into account under clause (iii) of paragraph (1)(A) only to the extent of the net gain")
rule S1411c4GainWithinHypotheticalGain defeasible {
    for item: NetInvestmentIncomeItem;
    for p: Person;
    for y: TaxableYear;
    for g: Money;
    for h: Money;
    when nii_item(item, p, y, NetGainOnDisposition, g) and disposition_of_partnership_or_s_corporation_interest(item) and hypothetical_sale_net_gain(item, h);
    when g >= 0.00 USD and h >= g;
    then limited_interest_disposition_amount(item, g);
}
rule S1411c4GainAboveHypotheticalGain defeasible {
    for item: NetInvestmentIncomeItem;
    for p: Person;
    for y: TaxableYear;
    for g: Money;
    for h: Money;
    when nii_item(item, p, y, NetGainOnDisposition, g) and disposition_of_partnership_or_s_corporation_interest(item) and hypothetical_sale_net_gain(item, h);
    when g >= 0.00 USD and h < g and h >= 0.00 USD;
    then limited_interest_disposition_amount(item, h);
}
rule S1411c4GainWithHypotheticalLoss defeasible {
    for item: NetInvestmentIncomeItem;
    for p: Person;
    for y: TaxableYear;
    for g: Money;
    for h: Money;
    when nii_item(item, p, y, NetGainOnDisposition, g) and disposition_of_partnership_or_s_corporation_interest(item) and hypothetical_sale_net_gain(item, h);
    when g >= 0.00 USD and h < 0.00 USD;
    then limited_interest_disposition_amount(item, 0.00 USD);
}
@source(IRC_S1411_C, relation = formalizes, coverage = exact, quote = "(B) a rule similar to the rule of subparagraph (A) shall apply to a loss from such disposition.")
rule S1411c4LossWithinHypotheticalLoss defeasible {
    for item: NetInvestmentIncomeItem;
    for p: Person;
    for y: TaxableYear;
    for g: Money;
    for h: Money;
    when nii_item(item, p, y, NetGainOnDisposition, g) and disposition_of_partnership_or_s_corporation_interest(item) and hypothetical_sale_net_gain(item, h);
    when g < 0.00 USD and h <= g;
    then limited_interest_disposition_amount(item, g);
}
rule S1411c4LossAboveHypotheticalLoss defeasible {
    for item: NetInvestmentIncomeItem;
    for p: Person;
    for y: TaxableYear;
    for g: Money;
    for h: Money;
    when nii_item(item, p, y, NetGainOnDisposition, g) and disposition_of_partnership_or_s_corporation_interest(item) and hypothetical_sale_net_gain(item, h);
    when g < 0.00 USD and h > g and h <= 0.00 USD;
    then limited_interest_disposition_amount(item, h);
}
rule S1411c4LossWithHypotheticalGain defeasible {
    for item: NetInvestmentIncomeItem;
    for p: Person;
    for y: TaxableYear;
    for g: Money;
    for h: Money;
    when nii_item(item, p, y, NetGainOnDisposition, g) and disposition_of_partnership_or_s_corporation_interest(item) and hypothetical_sale_net_gain(item, h);
    when g < 0.00 USD and h > 0.00 USD;
    then limited_interest_disposition_amount(item, 0.00 USD);
}
@source(IRC_S1411_C, relation = formalizes, coverage = exact, quote = "(iii) net gain (to the extent taken into account in computing taxable income) attributable to the disposition of property other than property held in a trade or business not described in paragraph (2)")
rule S1411c4LimitedAmountIncluded defeasible {
    for item: NetInvestmentIncomeItem;
    for p: Person;
    for y: TaxableYear;
    for amount: Money;
    for g: Money;
    when nii_item(item, p, y, NetGainOnDisposition, g) and limited_interest_disposition_amount(item, amount);
    then nii_item_included(item, p, y, amount);
}
