// Chapter 2, section 1402(a) — "net earnings from self-employment". Stage
// IRC-10 (A14), DECISION-0379.
//
// Method: net earnings from self-employment are computed from CASE-ASSERTED
// income items of a taxable activity (`SelfEmploymentItem`, an item of gross
// income or loss the case attributes to a trade or business the individual
// or a partnership carries on) classified by `SelfEmploymentItemKind`. Each
// paragraph of (a) is either (i) a classification rule that INCLUDES or
// EXCLUDES an item's amount from the net-earnings sum, or (ii) an adjustment
// applied to the sum itself (the (a)(12) SE-tax deduction, the (a)(13)
// limited-partner exclusion, the community-income and joint-venture
// allocation rules). This mirrors the case-asserted-item pattern
// `us.irc.employment::wages_3121` uses for section 3121(a) exclusions,
// rather than re-deriving gross income and every subtitle-A deduction from
// scratch (out of this package's scope; `us.irc.gross_income` and
// `us.irc.deductions` are the owners of those computations generally).




// --- Case-asserted income items ---------------------------------------------

use self::{
    HiSeRate,
    IRC_S1402_A,
    IRC_S1402_I,
    IRC_S1402_K,
    OasdiSeRate,
    Partnership,
    Person,
    TaxableYear,
    has_self_employment_activity,
    self_employment_item_included_after_community,
};

pub entity SelfEmploymentItem;

pub enum SelfEmploymentItemKind {
    OrdinaryTradeOrBusiness;       // baseline (a) gross income/deductions of the trade or business
    RentalRealEstate;              // (a)(1)
    DividendOrInterest;            // (a)(2)
    CapitalAssetGainOrLoss;        // (a)(3)(A)
    TimberCoalIronOreSection631;   // (a)(3)(B)
    NonInventoryPropertyDisposition; // (a)(3)(C)
    PartnerRetirementPayment;      // (a)(10)
    Section1256ContractGainOrLoss; // read with (i) for dealers
    InsuranceSalesmanTerminationPayment; // (k)
}

pub relation self_employment_item(item: SelfEmploymentItem, activity_of: Person, y: TaxableYear, kind: SelfEmploymentItemKind, amount: Money) kind empirical {
    label en unofficial "an item of gross income or loss (net of the deductions attributable to it) the case attributes to a trade or business of this person for this taxable year, classified for section 1402(a)";
}

// --- (a)(1) rentals from real estate: excluded unless received by a real estate dealer in the course of that trade or business

pub relation is_real_estate_dealer(p: Person, y: TaxableYear) kind empirical {
    label en unofficial "the individual receives the rentals in the course of a trade or business as a real estate dealer (section 1402(a)(1) proviso)";
}

// --- (a)(2) dividends/interest: excluded unless received by a dealer in stocks or securities

pub relation is_securities_dealer(p: Person, y: TaxableYear) kind empirical {
    label en unofficial "the individual receives the dividends or interest in the course of a trade or business as a dealer in stocks or securities (section 1402(a)(2) proviso)";
}

// --- (a)(13) limited partner exclusion --------------------------------------

pub relation is_limited_partner(partner: Person, pship: Partnership, y: TaxableYear) kind empirical {
    label en unofficial "the partner holds the interest as a limited partner, as such, for this taxable year (section 1402(a)(13))";
}

pub relation is_guaranteed_payment_for_services(item: SelfEmploymentItem) kind empirical {
    label en unofficial "the distributive share item is a section 707(c) guaranteed payment for services actually rendered to or on behalf of the partnership (section 1402(a)(13) proviso — NOT excluded even for a limited partner)";
}

// --- Per-item inclusion classification --------------------------------------

pub relation self_employment_item_included(item: SelfEmploymentItem, activity_of: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the item's amount is included in computing net earnings from self-employment under section 1402(a)";
}

@source(IRC_S1402_A, relation = formalizes, coverage = exact, quote = "The term \"net earnings from self-employment\" means the gross income derived by an individual from any trade or business carried on by such individual, less the deductions allowed by this subtitle which are attributable to such trade or business")
rule OrdinaryItemIncluded(item: SelfEmploymentItem, p: Person, y: TaxableYear, amount: Money) strict {
    when self_employment_item(item, p, y, OrdinaryTradeOrBusiness, amount);
    then self_employment_item_included(item, p, y, amount);
}

@source(IRC_S1402_A, relation = formalizes, coverage = partial, quote = "there shall be excluded rentals from real estate and from personal property leased with the real estate")
rule RentalIncludedForDealer(item: SelfEmploymentItem, p: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 1402(a)(1): rental real estate income IS included when the individual is a real estate dealer receiving the rentals in the course of that trade or business";
    when self_employment_item(item, p, y, RentalRealEstate, amount)
        and is_real_estate_dealer(p, y);
    then self_employment_item_included(item, p, y, amount);
}
// Absence of `is_real_estate_dealer`: no rule fires — the rental item is
// excluded by default, matching "there shall be excluded ... unless".

@source(IRC_S1402_A, relation = formalizes, coverage = partial, quote = "there shall be excluded dividends on any share of stock, and interest on any bond, debenture, note, or certificate, or other evidence of indebtedness")
rule DividendOrInterestIncludedForDealer(item: SelfEmploymentItem, p: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 1402(a)(2): dividend/interest income IS included when the individual is a dealer in stocks or securities receiving it in that trade or business";
    when self_employment_item(item, p, y, DividendOrInterest, amount)
        and is_securities_dealer(p, y);
    then self_employment_item_included(item, p, y, amount);
}

// (a)(3): capital-asset gain/loss, section 631 timber/coal/iron-ore gain or
// loss, and gain/loss from property that is neither inventory nor held
// primarily for sale to customers, are ALWAYS excluded (no dealer proviso —
// contrast (a)(1)/(a)(2)). No inclusion rule is written for these three
// kinds: absence of an inclusion rule is the correct EXCLUDED reading.

@source(IRC_S1402_I, relation = formalizes, coverage = exact, quote = "Notwithstanding subsection (a)(3)(A), in determining the net earnings from self-employment of any options dealer or commodities dealer, there shall not be excluded any gain or loss (in the normal course of the taxpayer's activity of dealing in or trading section 1256 contracts) from section 1256 contracts or property related to such contracts.")
rule Section1256ContractGainIncludedForDealer(item: SelfEmploymentItem, p: Person, y: TaxableYear, amount: Money) strict {
    label en official "section 1402(i): an options dealer's or commodities dealer's section 1256 contract gain or loss, in the normal course of dealing or trading, is included notwithstanding the (a)(3)(A) capital-asset exclusion";
    when self_employment_item(item, p, y, Section1256ContractGainOrLoss, amount)
        and is_options_or_commodities_dealer(p, y);
    then self_employment_item_included(item, p, y, amount);
}

pub relation is_options_or_commodities_dealer(p: Person, y: TaxableYear) kind empirical {
    label en unofficial "the person is an options dealer (section 1256(g)(8)) or a commodities dealer (registered, actively trading section 1256 contracts on a designated contract market) for this taxable year — section 1402(i)(2)";
}

// --- (a)(10) partner retirement payments: excluded if the three conditions hold

pub relation partner_rendered_no_services_in_year(partner: Person, pship: Partnership, y: TaxableYear) kind empirical {
    label en unofficial "condition (A): the partner rendered no services with respect to any trade or business carried on by the partnership during the partnership's taxable year ending within or with the partner's taxable year in which the payment was received";
}
pub relation no_obligation_beyond_retirement_plan(partner: Person, pship: Partnership, y: TaxableYear) kind empirical {
    label en unofficial "condition (B): no obligation exists from the other partners to this partner except retirement payments under the plan";
}
pub relation partner_capital_share_paid_in_full(partner: Person, pship: Partnership, y: TaxableYear) kind empirical {
    label en unofficial "condition (C): the partner's share of partnership capital, if any, has been paid in full before the close of the partnership's referenced taxable year";
}
pub relation partner_retirement_plan_meets_secretary_requirements(pship: Partnership, y: TaxableYear) kind empirical {
    label en unofficial "the retirement payments are made pursuant to a written partnership plan meeting the Secretary's prescribed requirements (section 1402(a)(10) opening clause)";
}

rule PartnerRetirementPaymentExcludedConditionsMet(partner: Person, pship: Partnership, y: TaxableYear) strict {
    label en official "the three section 1402(a)(10) conditions for excluding a partner's retirement payment from net earnings from self-employment";
    when partner_rendered_no_services_in_year(partner, pship, y)
        and no_obligation_beyond_retirement_plan(partner, pship, y)
        and partner_capital_share_paid_in_full(partner, pship, y)
        and partner_retirement_plan_meets_secretary_requirements(pship, y);
    then partner_retirement_payment_exclusion_conditions_met(partner, pship, y);
}

pub relation partner_retirement_payment_exclusion_conditions_met(partner: Person, pship: Partnership, y: TaxableYear) kind institutional {
    label en official "section 1402(a)(10) is satisfied for this partner and taxable year: the retirement payment is EXCLUDED from net earnings from self-employment (no inclusion rule fires)";
}
// A `PartnerRetirementPayment` item is included only through the ordinary
// rule below when the conditions are NOT met.
@source(IRC_S1402_A, relation = formalizes, coverage = partial, quote = "there shall be excluded amounts received by a partner pursuant to a written plan of the partnership")
rule PartnerRetirementPaymentIncludedWhenConditionsFail(item: SelfEmploymentItem, partner: Person, pship: Partnership, y: TaxableYear, amount: Money) defeasible {
    when self_employment_item(item, partner, y, PartnerRetirementPayment, amount);
    then self_employment_item_included(item, partner, y, amount);
    unless partner_retirement_payment_exclusion_conditions_met(partner, pship, y) and self_employment_item(item, partner, y, PartnerRetirementPayment, amount);
}

// --- (k) insurance salesman termination payments ----------------------------

pub relation insurance_salesman_termination_conditions_met(item: SelfEmploymentItem) kind empirical {
    label en unofficial "the four section 1402(k) conditions (payment after termination of the agency agreement, no further services performed, a covenant not to compete for at least one year, and a payment formula depending on policies sold/in force rather than length of service or overall earnings) are all met for this payment, asserted by the case as a single fact because all four conditions test the same payment instrument";
}

@source(IRC_S1402_K, relation = formalizes, coverage = exact, quote = "Nothing in subsection (a) shall be construed as including in the net earnings from self-employment of an individual any amount received during the taxable year from an insurance company on account of services performed by such individual as an insurance salesman for such company if")
rule InsuranceSalesmanTerminationPaymentExcluded(item: SelfEmploymentItem, p: Person, y: TaxableYear, amount: Money) defeasible {
    when self_employment_item(item, p, y, InsuranceSalesmanTerminationPayment, amount)
        and insurance_salesman_termination_conditions_met(item);
    then self_employment_item_excluded_1402k(item);
}
pub relation self_employment_item_excluded_1402k(item: SelfEmploymentItem) kind institutional;
// When the section 1402(k) conditions are NOT met, the payment falls back to
// ordinary inclusion as `OrdinaryTradeOrBusiness` — the case classifies it
// accordingly; this module does not force a fallback kind switch.

// --- Net earnings from self-employment: the sum, before the (a)(12)/(a)(17) adjustments

pub relation gross_net_earnings_from_self_employment(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the sum of included section 1402(a) items for this person and taxable year, before the (a)(12) deduction, the (a)(13) limited-partner exclusion and the (a)(17) qualified-joint-venture split";
}

rule GrossNetEarningsAggregate(p0: Person, y0: TaxableYear) defeasible {
    when has_self_employment_activity(p0, y0);
    then gross_net_earnings_from_self_employment(p0, y0,
        sum all amount: Money for item: SelfEmploymentItem
            where self_employment_item_included_after_community(item, p0, y0, amount));
}
// Stage 3: the sum reads the amounts after the section 1402(a)(5) community-property
// reallocation and the partner-year rule (module 06); without either, every included
// item passes through unchanged.

// --- (a)(13) limited partner exclusion --------------------------------------

pub relation net_earnings_after_limited_partner_exclusion(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "net earnings from self-employment after excluding a limited partner's distributive share other than section 707(c) guaranteed payments for services (section 1402(a)(13))";
}

@source(IRC_S1402_A, relation = formalizes, coverage = exact, quote = "there shall be excluded the distributive share of any item of income or loss of a limited partner, as such, other than guaranteed payments described in section 707(c) to that partner for services actually rendered to or on behalf of the partnership")
rule NetEarningsLimitedPartnerNotApplicable(p: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "no section 1402(a)(13) exclusion applies: the person's gross net earnings pass through unchanged";
    when gross_net_earnings_from_self_employment(p, y, amount);
    then net_earnings_after_limited_partner_exclusion(p, y, amount);
    unless is_limited_partner_with_excludable_share(p, y) and gross_net_earnings_from_self_employment(p, y, amount);
}

pub relation is_limited_partner_with_excludable_share(p: Person, y: TaxableYear) kind institutional {
    label en unofficial "the person is a limited partner (as such) of some partnership for this year with a distributive-share item that is not a section 707(c) guaranteed payment for services (drives the (a)(13) exclusion; the excludable amount itself is read off `self_employment_item` for that partnership, not summed again here — TECH_GAP: no general per-partnership-net exclusion is computed when the person is a limited partner in some partnerships and a general partner in others; the case should assert `self_employment_item`s only for the includable partnerships in that scenario)";
}

rule IsLimitedPartnerWithExcludableShare(partner: Person, pship: Partnership, y: TaxableYear, item: SelfEmploymentItem) strict {
    when is_limited_partner(partner, pship, y)
        and self_employment_item(item, partner, y, OrdinaryTradeOrBusiness, _)
        and not is_guaranteed_payment_for_services(item);
    then is_limited_partner_with_excludable_share(partner, y);
}

// --- (a)(12): in lieu of the section 164(f) deduction, one-half of the sum
// of the section 1401 rates (determined without regard to the additional
// Medicare tax rate) applied to net earnings from self-employment (before
// this very deduction).

pub relation section_1402a12_deduction(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 1402(a)(12) deduction: net earnings from self-employment (determined without regard to this paragraph) times one-half the sum of the section 1401(a)/(b)(1) rates — NOT the additional Medicare rate under section 1401(b)(2), which the text excludes by its own terms (\"determined without regard to the rate imposed under paragraph (2) of section 1401(b)\")";
}

@source(IRC_S1402_A, relation = formalizes, coverage = exact, quote = "in lieu of the deduction provided by section 164(f) (relating to deduction for one-half of self-employment taxes), there shall be allowed a deduction equal to the product of")
rule Section1402A12Deduction(p: Person, y: TaxableYear, before: Money) defeasible {
    when net_earnings_after_limited_partner_exclusion(p, y, before);
    then section_1402a12_deduction(p, y, round(before * ((OasdiSeRate + HiSeRate) / 2.0), 2, "HALF_UP"));
}

// --- (a)(17) qualified joint venture: each spouse's share is taken into
// account separately per section 761(f), rather than allocated to only one
// spouse. Modelled as a direct case-asserted per-spouse share of the item
// (the case supplies EACH spouse's own `self_employment_item`s for the
// venture); no additional splitting rule is needed once the case follows
// that convention — flagged in the coverage note as an INTERPRETATION of how
// the item-level case-fact model absorbs (a)(17) (see coverage row for
// section 1402(a)(17)).

// --- Net earnings from self-employment: the final relation this package exposes

pub relation net_earnings_from_self_employment(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "net earnings from self-employment, section 1402(a), after every subsection (a) adjustment this module implements";
}

rule NetEarningsFromSelfEmployment(p: Person, y: TaxableYear, before: Money, deduction: Money) defeasible {
    when net_earnings_after_limited_partner_exclusion(p, y, before)
        and section_1402a12_deduction(p, y, deduction);
    then net_earnings_from_self_employment(p, y, before - deduction);
}
