language "law.core" version "0.2";
package us.irc.other_income_taxes version "0.1.1";
namespace "urn:us:irc:other_income_taxes:clir";

test "S1402A5-01-CARRYING-SPOUSE-TAKES-THE-COMMUNITY-ITEM" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": self_employment_item(entity_ref("urn:test:s1402a5c1#i1"), entity_ref("urn:test:s1402a5c1#B"), entity_ref("urn:test:s1402a5c1#y"), OrdinaryTradeOrBusiness, 40000 USD) { origin case_input; }
        assert "f1": community_income_item(entity_ref("urn:test:s1402a5c1#i1")) { origin case_input; }
        assert "f2": community_item_carrying_spouse(entity_ref("urn:test:s1402a5c1#i1"), entity_ref("urn:test:s1402a5c1#A")) { origin case_input; }
    }
    evaluate truth(gross_net_earnings_from_self_employment(entity_ref("urn:test:s1402a5c1#A"), entity_ref("urn:test:s1402a5c1#y"), 40000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

