// Section 1402(a) scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.other_income_taxes version "0.1.1";
namespace "urn:us:irc:other_income_taxes:clir";

test "S1402A-01-ORDINARY-TRADE-OR-BUSINESS-INCLUDED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": self_employment_item(entity_ref("urn:test:s1402a:t1#i1"), entity_ref("urn:test:s1402a:t1#p"), entity_ref("urn:test:s1402a:t1#y"), OrdinaryTradeOrBusiness, 40000 USD) { origin case_input; }
    }
    evaluate truth(gross_net_earnings_from_self_employment(entity_ref("urn:test:s1402a:t1#p"), entity_ref("urn:test:s1402a:t1#y"), 40000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1402A-02-RENTAL-EXCLUDED-NOT-A-DEALER" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": self_employment_item(entity_ref("urn:test:s1402a:t2#i1"), entity_ref("urn:test:s1402a:t2#p"), entity_ref("urn:test:s1402a:t2#y"), RentalRealEstate, 10000 USD) { origin case_input; }
    }
    // no `is_real_estate_dealer` asserted -> rental excluded -> gross net earnings stays at 0, no rule fires for this item's inclusion.
    evaluate truth(self_employment_item_included(entity_ref("urn:test:s1402a:t2#i1"), entity_ref("urn:test:s1402a:t2#p"), entity_ref("urn:test:s1402a:t2#y"), 10000 USD));
    expect truth_status == NEITHER;
}

test "S1402A-03-RENTAL-INCLUDED-FOR-REAL-ESTATE-DEALER" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": self_employment_item(entity_ref("urn:test:s1402a:t3#i1"), entity_ref("urn:test:s1402a:t3#p"), entity_ref("urn:test:s1402a:t3#y"), RentalRealEstate, 10000 USD) { origin case_input; }
        assert "f1": is_real_estate_dealer(entity_ref("urn:test:s1402a:t3#p"), entity_ref("urn:test:s1402a:t3#y")) { origin case_input; }
    }
    evaluate truth(self_employment_item_included(entity_ref("urn:test:s1402a:t3#i1"), entity_ref("urn:test:s1402a:t3#p"), entity_ref("urn:test:s1402a:t3#y"), 10000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1402A-04-LIMITED-PARTNER-DISTRIBUTIVE-SHARE-EXCLUDED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": self_employment_item(entity_ref("urn:test:s1402a:t4#i1"), entity_ref("urn:test:s1402a:t4#p"), entity_ref("urn:test:s1402a:t4#y"), OrdinaryTradeOrBusiness, 20000 USD) { origin case_input; }
        assert "f1": is_limited_partner(entity_ref("urn:test:s1402a:t4#p"), entity_ref("urn:test:s1402a:t4#pship"), entity_ref("urn:test:s1402a:t4#y")) { origin case_input; }
    }
    // not a guaranteed payment -> excludable share -> net earnings after (a)(13) exclusion is 0.00, not 20000.
    evaluate truth(net_earnings_after_limited_partner_exclusion(entity_ref("urn:test:s1402a:t4#p"), entity_ref("urn:test:s1402a:t4#y"), 20000 USD));
    expect truth_status == FALSE_ONLY;
}

test "S1402A-05-SECTION-1402A12-DEDUCTION-FACTOR" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": self_employment_item(entity_ref("urn:test:s1402a:t5#i1"), entity_ref("urn:test:s1402a:t5#p"), entity_ref("urn:test:s1402a:t5#y"), OrdinaryTradeOrBusiness, 100000 USD) { origin case_input; }
    }
    // factor = (0.124 + 0.029) / 2 = 0.0765; deduction = 100000 * 0.0765 = 7650.00; net earnings = 92350.00
    evaluate truth(net_earnings_from_self_employment(entity_ref("urn:test:s1402a:t5#p"), entity_ref("urn:test:s1402a:t5#y"), 92350.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1402I-01-COMMODITIES-DEALER-SECTION-1256-GAIN-INCLUDED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": self_employment_item(entity_ref("urn:test:s1402i:t1#i1"), entity_ref("urn:test:s1402i:t1#p"), entity_ref("urn:test:s1402i:t1#y"), Section1256ContractGainOrLoss, 5000 USD) { origin case_input; }
        assert "f1": is_options_or_commodities_dealer(entity_ref("urn:test:s1402i:t1#p"), entity_ref("urn:test:s1402i:t1#y")) { origin case_input; }
    }
    evaluate truth(self_employment_item_included(entity_ref("urn:test:s1402i:t1#i1"), entity_ref("urn:test:s1402i:t1#p"), entity_ref("urn:test:s1402i:t1#y"), 5000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
