// Section 1411 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.other_income_taxes version "0.1.1";
namespace "urn:us:irc:other_income_taxes:clir";

test "S1411-01-NII-LESSER-THAN-EXCESS-MAGI" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": nii_item(entity_ref("urn:test:s1411:t1#i1"), entity_ref("urn:test:s1411:t1#p"), entity_ref("urn:test:s1411:t1#y"), InterestDividendAnnuityRoyaltyRent, 20000 USD) { origin case_input; }
        assert "f1": nii_allocable_deductions(entity_ref("urn:test:s1411:t1#p"), entity_ref("urn:test:s1411:t1#y"), 0 USD) { origin case_input; }
        assert "f2": us.irc.gross_income::adjusted_gross_income(entity_ref("urn:test:s1411:t1#p"), entity_ref("urn:test:s1411:t1#y"), 300000 USD) { origin case_input; }
        assert "f3": section_911_exclusion_amount(entity_ref("urn:test:s1411:t1#p"), entity_ref("urn:test:s1411:t1#y"), 0 USD) { origin case_input; }
        assert "f4": section_911d6_disallowed_amount(entity_ref("urn:test:s1411:t1#p"), entity_ref("urn:test:s1411:t1#y"), 0 USD) { origin case_input; }
        assert "f5": us.irc.income_individual::filing_status(entity_ref("urn:test:s1411:t1#p"), entity_ref("urn:test:s1411:t1#y"), us.irc.income_individual::Unmarried) { origin case_input; }
    }
    // MAGI 300000, threshold (Other) 200000, excess = 100000; NII = 20000 < 100000 -> tax on NII: 20000 * 3.8% = 760.00
    evaluate truth(net_investment_income_tax(entity_ref("urn:test:s1411:t1#p"), entity_ref("urn:test:s1411:t1#y"), 760.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1411-02-EXCESS-MAGI-LESSER-THAN-NII" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": nii_item(entity_ref("urn:test:s1411:t2#i1"), entity_ref("urn:test:s1411:t2#p"), entity_ref("urn:test:s1411:t2#y"), InterestDividendAnnuityRoyaltyRent, 150000 USD) { origin case_input; }
        assert "f1": nii_allocable_deductions(entity_ref("urn:test:s1411:t2#p"), entity_ref("urn:test:s1411:t2#y"), 0 USD) { origin case_input; }
        assert "f2": us.irc.gross_income::adjusted_gross_income(entity_ref("urn:test:s1411:t2#p"), entity_ref("urn:test:s1411:t2#y"), 220000 USD) { origin case_input; }
        assert "f3": section_911_exclusion_amount(entity_ref("urn:test:s1411:t2#p"), entity_ref("urn:test:s1411:t2#y"), 0 USD) { origin case_input; }
        assert "f4": section_911d6_disallowed_amount(entity_ref("urn:test:s1411:t2#p"), entity_ref("urn:test:s1411:t2#y"), 0 USD) { origin case_input; }
        assert "f5": us.irc.income_individual::filing_status(entity_ref("urn:test:s1411:t2#p"), entity_ref("urn:test:s1411:t2#y"), us.irc.income_individual::Unmarried) { origin case_input; }
    }
    // MAGI 220000, threshold 200000, excess = 20000; NII 150000 > 20000 -> tax on excess: 20000 * 3.8% = 760.00
    evaluate truth(net_investment_income_tax(entity_ref("urn:test:s1411:t2#p"), entity_ref("urn:test:s1411:t2#y"), 760.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

