        assert "f1": is_retirement_plan_distribution(entity_ref("urn:test:s1411:t5#i1"), entity_ref("urn:test:s1411:t5#p"), entity_ref("urn:test:s1411:t5#y")) { origin case_input; }
    }
    evaluate truth(nii_item_excluded_retirement_plan(entity_ref("urn:test:s1411:t5#i1")));
