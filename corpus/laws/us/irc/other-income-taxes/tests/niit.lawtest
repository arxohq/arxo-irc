test "S1411-04-NONRESIDENT-ALIEN-EXCLUDED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": nii_item(entity_ref("urn:test:s1411:t4#i1"), entity_ref("urn:test:s1411:t4#p"), entity_ref("urn:test:s1411:t4#y"), InterestDividendAnnuityRoyaltyRent, 500000 USD) { origin case_input; }
        assert "f1": nii_allocable_deductions(entity_ref("urn:test:s1411:t4#p"), entity_ref("urn:test:s1411:t4#y"), 0 USD) { origin case_input; }
        assert "f2": us.irc.gross_income::adjusted_gross_income(entity_ref("urn:test:s1411:t4#p"), entity_ref("urn:test:s1411:t4#y"), 500000 USD) { origin case_input; }
        assert "f3": section_911_exclusion_amount(entity_ref("urn:test:s1411:t4#p"), entity_ref("urn:test:s1411:t4#y"), 0 USD) { origin case_input; }
        assert "f4": section_911d6_disallowed_amount(entity_ref("urn:test:s1411:t4#p"), entity_ref("urn:test:s1411:t4#y"), 0 USD) { origin case_input; }
        assert "f5": us.irc.income_individual::filing_status(entity_ref("urn:test:s1411:t4#p"), entity_ref("urn:test:s1411:t4#y"), us.irc.income_individual::Unmarried) { origin case_input; }
        assert "f6": us.irc.core::calendar_year_of(entity_ref("urn:test:s1411:t4#y"), 2024) { origin case_input; }
        assert "f7": us.irc.definitions::nonresident_alien_for_year(entity_ref("urn:test:s1411:t4#p"), 2024) { origin case_input; }
    }
    // is_niit_exempt_nonresident_alien is TRUE -> not_known(...) is FALSE -> no rule fires -> NEITHER.
    evaluate truth(net_investment_income_tax(entity_ref("urn:test:s1411:t4#p"), entity_ref("urn:test:s1411:t4#y"), 19000.00 USD));
    expect truth_status == NEITHER;
}

