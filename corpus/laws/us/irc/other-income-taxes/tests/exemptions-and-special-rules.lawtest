// Section 1402(e)/(f)/(g)/(j)/(l) scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.other_income_taxes version "0.1.1";
namespace "urn:us:irc:other_income_taxes:clir";

test "S1402E-01-TIMELY-MINISTER-EXEMPTION-VALID" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": minister_exemption_filed_by(entity_ref("urn:test:s1402e:t1#e"), entity_ref("urn:test:s1402e:t1#p")) { origin case_input; }
        assert "f1": minister_exemption_filed_on(entity_ref("urn:test:s1402e:t1#e"), @2024-04-01) { origin case_input; }
        assert "f2": minister_exemption_return_due_date_second_year(entity_ref("urn:test:s1402e:t1#e"), @2024-04-15) { origin case_input; }
        assert "f3": minister_exemption_nese_400_second_year(entity_ref("urn:test:s1402e:t1#p")) { origin case_input; }
        assert "f4": minister_exemption_conscientious_or_religious_opposition(entity_ref("urn:test:s1402e:t1#e")) { origin case_input; }
        assert "f5": secretary_verified_applicant_aware_of_grounds(entity_ref("urn:test:s1402e:t1#e")) { origin adjudicated; }
    }
    evaluate positions();
    expect position(Section1402EExemption, VALIDLY_EXERCISED);
}

test "S1402E-02-LATE-FILING-POWER-INVALID-EXERCISE" {
    given {
        context {
            legal_time @2024-05-01;
            decision_time @2024-05-01T09:00:00-05:00;
            knowledge_time @2024-05-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": minister_exemption_filed_by(entity_ref("urn:test:s1402e:t2#e"), entity_ref("urn:test:s1402e:t2#p")) { origin case_input; }
        assert "f1": minister_exemption_filed_on(entity_ref("urn:test:s1402e:t2#e"), @2024-04-30) { origin case_input; }
        assert "f2": minister_exemption_return_due_date_second_year(entity_ref("urn:test:s1402e:t2#e"), @2024-04-15) { origin case_input; }
        assert "f3": minister_exemption_nese_400_second_year(entity_ref("urn:test:s1402e:t2#p")) { origin case_input; }
        assert "f4": minister_exemption_conscientious_or_religious_opposition(entity_ref("urn:test:s1402e:t2#e")) { origin case_input; }
    }
    // filed after the due date -> valid_when fails -> INVALIDLY_EXERCISED, no exemption effect.
    evaluate positions();
    expect position(Section1402EExemption, INVALIDLY_EXERCISED);
}

test "S1402G-01-RELIGIOUS-SECT-EXEMPTION-VALID" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": sect_exemption_filed_by(entity_ref("urn:test:s1402g:t1#a"), entity_ref("urn:test:s1402g:t1#p")) { origin case_input; }
        assert "f1": sect_exemption_filed_on(entity_ref("urn:test:s1402g:t1#a"), @2024-04-01) { origin case_input; }
        assert "f2": sect_exemption_conscientious_opposition_and_membership(entity_ref("urn:test:s1402g:t1#a")) { origin case_input; }
        assert "f3": sect_exemption_waiver_filed(entity_ref("urn:test:s1402g:t1#a")) { origin case_input; }
        assert "f4": sect_exemption_no_benefit_already_payable(entity_ref("urn:test:s1402g:t1#a")) { origin case_input; }
        assert "f5": sect_meets_commissioner_findings(entity_ref("urn:test:s1402g:t1#a")) { origin case_input; }
    }
    evaluate positions();
    expect position(Section1402GExemption, VALIDLY_EXERCISED);
}

test "S1402J-01-CHURCH-EMPLOYEE-INCOME-AT-100-FLOOR" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": church_employee_income(entity_ref("urn:test:s1402j:t1#p"), entity_ref("urn:test:s1402j:t1#y"), 100 USD) { origin case_input; }
    }
    evaluate truth(church_employee_self_employment_income(entity_ref("urn:test:s1402j:t1#p"), entity_ref("urn:test:s1402j:t1#y"), 100 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

