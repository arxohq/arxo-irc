    expect evaluation_status == COMPUTED;
}

test "S1401-03-ADDITIONAL-MEDICARE-OVER-UNMARRIED-THRESHOLD" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": self_employment_income(entity_ref("urn:test:s1401:t3#p"), entity_ref("urn:test:s1401:t3#y"), 220000 USD) { origin case_input; }
        assert "f1": us.irc.income_individual::filing_status(entity_ref("urn:test:s1401:t3#p"), entity_ref("urn:test:s1401:t3#y"), us.irc.income_individual::Unmarried) { origin case_input; }
        assert "f2": wages_taken_into_account_3121b2(entity_ref("urn:test:s1401:t3#p"), entity_ref("urn:test:s1401:t3#y"), 0 USD) { origin case_input; }
    }
    // threshold 200000 (Other); excess = 20000; 20000 * 0.9% = 180.00
    evaluate truth(additional_medicare_tax_se(entity_ref("urn:test:s1401:t3#p"), entity_ref("urn:test:s1401:t3#y"), 180.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1401-04-ADDITIONAL-MEDICARE-AT-THRESHOLD-JOINT-NO-TAX" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": self_employment_income(entity_ref("urn:test:s1401:t4#p"), entity_ref("urn:test:s1401:t4#y"), 250000 USD) { origin case_input; }
        assert "f1": us.irc.income_individual::filing_status(entity_ref("urn:test:s1401:t4#p"), entity_ref("urn:test:s1401:t4#y"), us.irc.income_individual::Joint) { origin case_input; }
        assert "f2": wages_taken_into_account_3121b2(entity_ref("urn:test:s1401:t4#p"), entity_ref("urn:test:s1401:t4#y"), 0 USD) { origin case_input; }
    }
    // SE income exactly equals the joint threshold (250000): "in excess of" -> zero
    evaluate truth(additional_medicare_tax_se(entity_ref("urn:test:s1401:t4#p"), entity_ref("urn:test:s1401:t4#y"), 0.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1401-05-ADDITIONAL-MEDICARE-THRESHOLD-REDUCED-BY-WAGES" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": self_employment_income(entity_ref("urn:test:s1401:t5#p"), entity_ref("urn:test:s1401:t5#y"), 100000 USD) { origin case_input; }
        assert "f1": us.irc.income_individual::filing_status(entity_ref("urn:test:s1401:t5#p"), entity_ref("urn:test:s1401:t5#y"), us.irc.income_individual::Unmarried) { origin case_input; }
        assert "f2": wages_taken_into_account_3121b2(entity_ref("urn:test:s1401:t5#p"), entity_ref("urn:test:s1401:t5#y"), 150000 USD) { origin case_input; }
    }
    // threshold 200000 reduced by 150000 wages = 50000; SE income 100000 - 50000 = 50000 excess; 50000*0.9% = 450.00
    evaluate truth(additional_medicare_tax_se(entity_ref("urn:test:s1401:t5#p"), entity_ref("urn:test:s1401:t5#y"), 450.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1401-06-TOTALIZATION-AGREEMENT-IMMUNITY" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": totalization_agreement_covers(entity_ref("urn:test:s1401:t6#p"), entity_ref("urn:test:s1401:t6#y")) { origin case_input; }
        assert "f1": us.irc.core::begins(entity_ref("urn:test:s1401:t6#y"), @2024-01-01) { origin case_input; }
        assert "f2": us.irc.core::ends(entity_ref("urn:test:s1401:t6#y"), @2024-12-31) { origin case_input; }
    }
    evaluate truth(self_employment_tax_immunity_totalization(entity_ref("urn:test:s1401:t6#p"), entity_ref("urn:test:s1401:t6#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
