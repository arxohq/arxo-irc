// Section 1401 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.other_income_taxes version "0.1.1";
namespace "urn:us:irc:other_income_taxes:clir";

test "S1401-01-OASDI-AND-HI-ON-SE-INCOME" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": self_employment_income(entity_ref("urn:test:s1401:t1#p"), entity_ref("urn:test:s1401:t1#y"), 50000 USD) { origin case_input; }
    }
    // 50000 * 12.4% = 6200.00; 50000 * 2.9% = 1450.00
    evaluate truth(self_employment_oasdi_tax(entity_ref("urn:test:s1401:t1#p"), entity_ref("urn:test:s1401:t1#y"), 6200.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

