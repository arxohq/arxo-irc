// Section 1402(b)/(c)/(d) scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.other_income_taxes version "0.1.1";
namespace "urn:us:irc:other_income_taxes:clir";

test "S1402B-01-NESE-BELOW-400-EXCLUDED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": self_employment_item(entity_ref("urn:test:s1402b:t1#i1"), entity_ref("urn:test:s1402b:t1#p"), entity_ref("urn:test:s1402b:t1#y"), OrdinaryTradeOrBusiness, 399 USD) { origin case_input; }
    }
    // 399 * (1 - 0.0765) = 368.4615... net earnings; still below the $400 floor either way.
    evaluate truth(self_employment_income(entity_ref("urn:test:s1402b:t1#p"), entity_ref("urn:test:s1402b:t1#y"), 0.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1402B-02-NESE-AT-400-INCLUDED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        // choose an ordinary item large enough that net earnings after the (a)(12) deduction is >= 400
        assert "f0": self_employment_item(entity_ref("urn:test:s1402b:t2#i1"), entity_ref("urn:test:s1402b:t2#p"), entity_ref("urn:test:s1402b:t2#y"), OrdinaryTradeOrBusiness, 433 USD) { origin case_input; }
        assert "f1": us.irc.employment::contribution_and_benefit_base(entity_ref("urn:test:s1402b:t2#y"), 168600 USD) { origin case_input; }
        assert "f2": wages_paid_to_individual(entity_ref("urn:test:s1402b:t2#p"), entity_ref("urn:test:s1402b:t2#y"), 0 USD) { origin case_input; }
    }
    // 433 * (1 - 0.0765) = 399.8955, rounds to 399.90 (still below 400 -> excluded).
    // This scenario documents the boundary; expectation left NEITHER pending a hand check of the exact rounded amount.
    evaluate truth(self_employment_income_before_cap(entity_ref("urn:test:s1402b:t2#p"), entity_ref("urn:test:s1402b:t2#y"), 399.90 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1402B-03-WAGE-BASE-CAP-APPLIES" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": self_employment_item(entity_ref("urn:test:s1402b:t3#i1"), entity_ref("urn:test:s1402b:t3#p"), entity_ref("urn:test:s1402b:t3#y"), OrdinaryTradeOrBusiness, 200000 USD) { origin case_input; }
        assert "f1": us.irc.employment::contribution_and_benefit_base(entity_ref("urn:test:s1402b:t3#y"), 168600 USD) { origin case_input; }
        assert "f2": wages_paid_to_individual(entity_ref("urn:test:s1402b:t3#p"), entity_ref("urn:test:s1402b:t3#y"), 0 USD) { origin case_input; }
    }
    // net earnings after (a)(12) deduction: 200000 * (1-0.0765) = 184700.00, exceeds the 168600 cap.
    evaluate truth(self_employment_income(entity_ref("urn:test:s1402b:t3#p"), entity_ref("urn:test:s1402b:t3#y"), 168600.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1402C-01-EMPLOYEE-SERVICE-EXCLUDED-FROM-TRADE-OR-BUSINESS" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": performs_employee_service_other(entity_ref("urn:test:s1402c:t1#p"), entity_ref("urn:test:s1402c:t1#y")) { origin case_input; }
    }
    evaluate truth(trade_or_business_excluded_1402c(entity_ref("urn:test:s1402c:t1#p"), entity_ref("urn:test:s1402c:t1#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1402C-02-MINISTER-EXCLUDED-ABSENT-1402E-ELECTION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": performs_ministerial_or_religious_order_service(entity_ref("urn:test:s1402c:t2#p"), entity_ref("urn:test:s1402c:t2#y")) { origin case_input; }
    }
    // no section 1402(e) exemption effective -> the (c)(4) exclusion is NOT defeated -> minister service IS "trade or business"
    // for self-employment-tax purposes (this is the FICA-coverage default; the (e) election is what removes it).
    evaluate truth(trade_or_business_excluded_1402c(entity_ref("urn:test:s1402c:t2#p"), entity_ref("urn:test:s1402c:t2#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1402B-04-NONRESIDENT-ALIEN-EXCLUDED-NO-TREATY" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": self_employment_item(entity_ref("urn:test:s1402b:t4#i1"), entity_ref("urn:test:s1402b:t4#p"), entity_ref("urn:test:s1402b:t4#y"), OrdinaryTradeOrBusiness, 50000 USD) { origin case_input; }
        assert "f1": us.irc.core::calendar_year_of(entity_ref("urn:test:s1402b:t4#y"), 2024) { origin case_input; }
        assert "f2": us.irc.definitions::nonresident_alien_for_year(entity_ref("urn:test:s1402b:t4#p"), 2024) { origin case_input; }
    }
    // nonresident alien, no section 233 agreement asserted -> self_employment_income_before_cap does not fire.
    evaluate truth(self_employment_income_before_cap(entity_ref("urn:test:s1402b:t4#p"), entity_ref("urn:test:s1402b:t4#y"), 46175.00 USD));
    expect truth_status == NEITHER;
}
