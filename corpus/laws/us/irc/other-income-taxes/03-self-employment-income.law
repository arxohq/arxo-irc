// Chapter 2, section 1402(b) — "self-employment income" (net earnings from
// self-employment capped at the wage base and subject to the $400 floor),
// section 1402(c) — "trade or business" exclusions, section 1402(d) —
// "employee"/"wages" cross-reference to chapter 21. Stage IRC-10 (A14),
// DECISION-0379.



// --- section 1402(c): trade or business exclusions --------------------------
//
// Each excluded category is a case-asserted classification of the SERVICE an
// individual performs; an item the case attributes to such a service is not
// a `self_employment_item` of a "trade or business" at all (section 1402(c)
// carves the service itself out of "trade or business" for this chapter).
// Modelled as boolean-shaped empirical facts about the PERSON/YEAR rather
// than re-deriving the section 3121(b) FICA "employment" categories the text
// cross-references, because `us.irc.employment` does not itself expose a
// classification for every named subparagraph ((b)(11),(12),(14)(B),(15),
// (16),(20)) — EXTERNAL_DEPENDENCY, see coverage notes on section
// 1402(c)(2)(A)-(C),(F),(G).

use self::{
    IRC_S1402_B,
    IRC_S1402_C,
    Individual,
    Person,
    TaxableYear,
    net_earnings_effective,
    section_1402e_exemption_effective,
};

pub relation performs_public_office_state_fee_basis_uncovered(p: Person, y: TaxableYear) kind empirical {
    label en unofficial "section 1402(c)(1) proviso: the individual performs the functions of a State or political-subdivision public office, compensated solely on a fee basis, not covered under a section 218 Social Security Act agreement — this is EXCLUDED FROM the (c)(1) exclusion, i.e. it IS a trade or business";
}
pub relation performs_public_office_other(p: Person, y: TaxableYear) kind empirical {
    label en unofficial "the individual performs the functions of a public office other than the state-fee-basis-uncovered case above — section 1402(c)(1) EXCLUDES this from trade or business";
}
pub relation performs_employee_service_excepted(p: Person, y: TaxableYear) kind empirical {
    label en unofficial "the individual performs service as an employee that is one of the six section 1402(c)(2)(A)-(F) exceptions (age-18-plus certain domestic/agricultural service, service under 3121(b)(16), certain 3121(b)(11)/(12)/(15) service by a U.S. citizen, ministerial/Christian-Science service under (c)(4), state fee-basis service uncovered by a 218 agreement, or 3121(b)(20) service) — these ARE treated as trade or business notwithstanding being performed as an employee";
}
pub relation performs_employee_service_other(p: Person, y: TaxableYear) kind empirical {
    label en unofficial "the individual performs service as an employee that is not one of the section 1402(c)(2)(A)-(F) exceptions — section 1402(c)(2) EXCLUDES this from trade or business";
}
pub relation performs_railroad_employee_service(p: Person, y: TaxableYear) kind empirical {
    label en unofficial "section 1402(c)(3): the individual performs service as an employee or employee representative as defined in section 3231";
}
pub relation performs_ministerial_or_religious_order_service(p: Person, y: TaxableYear) kind empirical {
    label en unofficial "section 1402(c)(4): a duly ordained, commissioned, or licensed minister of a church in the exercise of the ministry, or a member of a religious order in the exercise of duties required by the order";
}
pub relation performs_christian_science_practitioner_service(p: Person, y: TaxableYear) kind empirical {
    label en unofficial "section 1402(c)(5): the individual's profession as a Christian Science practitioner";
}
pub relation performs_service_during_g_exemption(p: Person, y: TaxableYear) kind empirical {
    label en unofficial "section 1402(c)(6): the service is performed during a period for which a subsection (g) exemption is effective with respect to the individual";
}

pub relation trade_or_business_excluded_1402c(p: Person, y: TaxableYear) kind institutional {
    label en official "the individual's service this year falls within a section 1402(c) exclusion from \"trade or business\" for self-employment-tax purposes";
}

@source(IRC_S1402_C, relation = formalizes, coverage = partial, quote = "the performance of the functions of a public office, other than the functions of a public office of a State or a political subdivision thereof with respect to fees received in any period in which the functions are performed in a position compensated solely on a fee basis and in which such functions are not covered under an agreement")
rule TradeOrBusinessExcludedPublicOffice(p: Person, y: TaxableYear) strict {
    when performs_public_office_other(p, y);
    then trade_or_business_excluded_1402c(p, y);
}

@source(IRC_S1402_C, relation = formalizes, coverage = partial, quote = "the performance of service by an individual as an employee, other than")
rule TradeOrBusinessExcludedEmployee(p: Person, y: TaxableYear) strict {
    when performs_employee_service_other(p, y);
    then trade_or_business_excluded_1402c(p, y);
}

@source(IRC_S1402_C, relation = formalizes, coverage = exact, quote = "the performance of service by an individual as an employee or employee representative as defined in section 3231")
rule TradeOrBusinessExcludedRailroadEmployee(p: Person, y: TaxableYear) strict {
    when performs_railroad_employee_service(p, y);
    then trade_or_business_excluded_1402c(p, y);
}

@source(IRC_S1402_C, relation = formalizes, coverage = partial, quote = "the performance of service by a duly ordained, commissioned, or licensed minister of a church in the exercise of his ministry or by a member of a religious order in the exercise of duties required by such order")
rule TradeOrBusinessExcludedMinister(p: Person, y: TaxableYear) defeasible {
    label en official "section 1402(c)(4), read with (c)'s final sentence: excluded UNLESS a section 1402(e) exemption election is effective (a member of a religious order under a vow of poverty is excluded regardless of (e))";
    when performs_ministerial_or_religious_order_service(p, y);
    then trade_or_business_excluded_1402c(p, y);
    unless section_1402e_exemption_effective(p, y) and performs_ministerial_or_religious_order_service(p, y) and not is_vow_of_poverty_religious_order_member(p, y);
}

@source(IRC_S1402_C, relation = formalizes, coverage = partial, quote = "the performance of service by an individual in the exercise of his profession as a Christian Science practitioner")
rule TradeOrBusinessExcludedChristianScience(p: Person, y: TaxableYear) defeasible {
    label en official "section 1402(c)(5), read with (c)'s final sentence: excluded UNLESS a section 1402(e) exemption election is effective";
    when performs_christian_science_practitioner_service(p, y);
    then trade_or_business_excluded_1402c(p, y);
    unless section_1402e_exemption_effective(p, y) and performs_christian_science_practitioner_service(p, y);
}

pub relation is_vow_of_poverty_religious_order_member(p: Person, y: TaxableYear) kind empirical {
    label en unofficial "the minister is a member of a religious order who has taken a vow of poverty as a member of that order (section 1402(c) final sentence carve-out: the (e) exemption requirement does not apply to this person)";
}

@source(IRC_S1402_C, relation = formalizes, coverage = exact, quote = "the performance of service by an individual during the period for which an exemption under subsection (g) is effective with respect to him")
rule TradeOrBusinessExcludedGExemption(p: Person, y: TaxableYear) strict {
    when performs_service_during_g_exemption(p, y);
    then trade_or_business_excluded_1402c(p, y);
}

// --- section 1402(d): "employee"/"wages" cross-reference to chapter 21 ------
// A pure cross-reference (no new norm): "the same meaning as when used in
// chapter 21". This package does not redefine `wages`/`employee`; it reuses
// `us.irc.employment::wages_3121`'s underlying section 3121 concepts by
// reference wherever this package's own rules need them (see section
// 1401(b)(2)(B) above and `wages_taken_into_account_3121b2`). No separate
// relation is declared for (d) itself — REFERENCE classification, not a
// distinct computable norm (see coverage row).

// --- section 1402(b): self-employment income --------------------------------

pub relation is_nonresident_alien_this_year(p: Individual, y: TaxableYear) kind institutional {
    label en official "section 7701(b) nonresident alien classification for the calendar year in which this taxable year begins, imported from us.irc.definitions::nonresident_alien_for_year via us.irc.core::calendar_year_of";
}
rule IsNonresidentAlienThisYear(p: Individual, y: TaxableYear, n: Integer) strict {
    when us.irc.core::calendar_year_of(y, n)
        and us.irc.definitions::nonresident_alien_for_year(p, n);
    then is_nonresident_alien_this_year(p, y);
}

@source(IRC_S1402_B, relation = formalizes, coverage = partial, quote = "the net earnings from self-employment derived by an individual (other than a nonresident alien individual, except as provided by an agreement under section 233 of the Social Security Act) during any taxable year")
rule SelfEmploymentIncomeBeforeCapResidentOrCitizen(p: Individual, y: TaxableYear, amount: Money) defeasible {
    when net_earnings_effective(p, y, amount)
        and not_known(is_nonresident_alien_this_year(p, y));
    then self_employment_income_before_cap(p, y, amount);
}
rule SelfEmploymentIncomeBeforeCapTreatyCoveredNra(p: Individual, y: TaxableYear, amount: Money) defeasible {
    when net_earnings_effective(p, y, amount)
        and is_nonresident_alien_this_year(p, y)
        and totalization_agreement_covers_nra_exception(p, y);
    then self_employment_income_before_cap(p, y, amount);
}
pub relation self_employment_income_before_cap(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "net earnings from self-employment, before the section 1402(b)(1) wage-base cap and the section 1402(b)(2) $400 floor — zero (no rule fires) for a nonresident alien not covered by a section 233 agreement";
}
pub relation totalization_agreement_covers_nra_exception(p: Individual, y: TaxableYear) kind empirical {
    label en unofficial "a section 233 Social Security Act agreement provides that this nonresident alien's self-employment income IS included (section 1402(b) opening clause proviso: nonresident aliens are excluded \"except as provided by an agreement\")";
}

// section 1402(b)(1): wage-base cap. Reuses `us.irc.employment`'s
// `contribution_and_benefit_base` (the section 230 Social Security Act
// figure, itself a SOURCE_GAP empirical fact in that package — no value is
// invented here either) rather than redeclaring an equivalent relation.
pub relation self_employment_income_wage_base_reduced(y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 230 Social Security Act contribution and benefit base for this year, less the wages paid to the individual during the taxable year (section 1402(b)(1))";
}
rule SelfEmploymentIncomeWageBaseReduced(p: Individual, y: TaxableYear, base: Money, wages: Money) strict {
    when us.irc.employment::contribution_and_benefit_base(y, base)
        and wages_paid_to_individual(p, y, wages)
        and base > wages;
    then self_employment_income_wage_base_reduced(y, base - wages);
}
rule SelfEmploymentIncomeWageBaseReducedFloor(p: Individual, y: TaxableYear, base: Money, wages: Money) strict {
    when us.irc.employment::contribution_and_benefit_base(y, base)
        and wages_paid_to_individual(p, y, wages)
        and wages >= base;
    then self_employment_income_wage_base_reduced(y, 0.00 USD);
}
pub relation wages_paid_to_individual(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "section 1402(b)(1) \"wages\" (section 1402(b) last sentence: includes section 3121(l) foreign-affiliate coverage remuneration and section 3121(a) RRTA-equivalent compensation) paid to this individual during the taxable year — asserted as an annual total by the case (TECH_GAP G111: not derived from `us.irc.employment::wage_payment`)";
}

pub relation self_employment_income(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "self-employment income, section 1402(b): net earnings from self-employment after the wage-base cap and the $400 floor";
}

@source(IRC_S1402_B, relation = formalizes, coverage = partial, quote = "that part of the net earnings from self-employment which is in excess of (i) an amount equal to the contribution and benefit base")
rule SelfEmploymentIncomeBelowCapAndAtOrAboveFloor(p: Individual, y: TaxableYear, nese: Money, cap: Money) defeasible {
    when self_employment_income_before_cap(p, y, nese)
        and self_employment_income_wage_base_reduced(y, cap)
        and nese <= cap
        and nese >= SeNetEarningsMinimum;
    then self_employment_income(p, y, nese);
}
rule SelfEmploymentIncomeAboveCap(p: Individual, y: TaxableYear, nese: Money, cap: Money) defeasible {
    when self_employment_income_before_cap(p, y, nese)
        and self_employment_income_wage_base_reduced(y, cap)
        and nese > cap
        and nese >= SeNetEarningsMinimum;
    then self_employment_income(p, y, cap);
}
@source(IRC_S1402_B, relation = formalizes, coverage = exact, quote = "the net earnings from self-employment, if such net earnings for the taxable year are less than $400")
rule SelfEmploymentIncomeBelowFloor(p: Individual, y: TaxableYear, nese: Money) defeasible {
    when self_employment_income_before_cap(p, y, nese)
        and nese < SeNetEarningsMinimum;
    then self_employment_income(p, y, 0.00 USD);
}
