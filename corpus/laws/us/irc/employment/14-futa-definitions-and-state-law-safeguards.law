// 26 U.S.C. §§3303(d)-(f), 3305(c),(g)-(j), 3306(d),(n),(o),(r),(s), 3309(b)-(d).
// Stage 3 (26.09.2026, TECH_GAP reduction, DECISION-0379). Status:
// implemented_unverified — scenarios are written, not executed.
//
// SCOPE. FUTA rules the earlier stages folded into case facts or left as
// TECH_GAP although the language can express them:
//  - §3306(d): the pay-period majority test (one-half or more of a pay period of
//    at most 31 days in employment: all of it is employment; more than one-half
//    not in employment: none of it), derived from day counts of a
//    `PayPeriodOfService`; the (c)(9) carve-out.
//  - §3306(n): crew of an American vessel owned by (or bareboat chartered to) the
//    United States whose business is conducted by a general agent of the
//    Secretary of Transportation — not excluded by (c)(6); the agent is the
//    service recipient and an employer.
//  - §3306(o): crew leaders — (3) the definition, (1) treated as the employee of the
//    crew leader, (2) otherwise the other person is the employer and is treated
//    as having paid the crew leader's cash remuneration.
//  - §3306(r): certain employer contributions are wages; nonqualified deferred
//    compensation is taken into account at the later of two dates, and only once.
//  - §3306(s): tips are wages.
//  - §3303(d)-(f): safe harbors for State law (immunities of the State law from
//    being deemed to violate §3303(a)); the noncharging requirement.
//  - §3305(c),(g),(h),(i),(j): national banks, general agents, denial of credits.
//  - §3309(b),(c),(d): services outside §3309(a), the four-employee test, Indian tribes.
// Approvals of State law and certifications are acts of the Secretary of Labor
// (DECISION-0194: the authority named by the text); here they stay case facts.
//
// The `Section3309CoveredEmployerKind` case fact of 08-futa.law is left in place:
// `Section3309Employment` keeps its meaning; the exceptions (b) and the size test (c)
// are derived here as `section_3309_service_outside_subsection_a` and
// `nonprofit_meets_four_employee_test`, and the general rule gets a defeater.

use self::{
    IRC_S3303_D,
    IRC_S3303_E,
    IRC_S3303_F,
    IRC_S3305_C,
    IRC_S3305_G,
    IRC_S3305_H,
    IRC_S3305_I,
    IRC_S3305_J,
    IRC_S3306_D,
    IRC_S3306_N,
    IRC_S3306_O,
    IRC_S3306_R,
    IRC_S3306_S,
    IRC_S3309_B,
    IRC_S3309_C,
    IRC_S3309_D,
    Organ,
    Person,
    TaxableYear,
    VesselOrAircraftKind,
    WagePayment,
    american_vessel_or_aircraft,
    deferred_amount,
    designated_employee_by_written_agreement,
    furnishes_agricultural_laborers_and_pays_them,
    futa_employer,
    futa_employment,
    preceding_taxable_year,
    state_law_approved_3304,
    tip_reported,
    wage_payment,
};

pub const SecretaryOfLabor: Organ = entity_ref("urn:us:irc:employment:clir#secretary-of-labor") {
    label en unofficial "the Secretary of Labor";
}
pub const ComptrollerOfTheCurrency: Organ = entity_ref("urn:us:irc:employment:clir#comptroller-of-the-currency") {
    label en unofficial "the Comptroller of the Currency";
}

// ============================================================================
// §3306(d) — included and excluded service (pay-period majority test)
// ============================================================================

pub entity PayPeriodOfService {
    label en unofficial "a pay period of an employee with the person employing him, over which the included/excluded service majority test is applied";
}
pub relation pay_period_of(pp: PayPeriodOfService, employer: Person, employee: Person) kind empirical {
    label en unofficial "the pay period is the employee's pay period with this employer";
}
pub relation pay_period_length_in_days(pp: PayPeriodOfService, days: Integer) kind empirical {
    label en official "the number of consecutive days of the period for which a payment of remuneration is ordinarily made to the employee by the person employing him";
}
pub relation pay_period_days_of_employment_service(pp: PayPeriodOfService, days: Integer) kind empirical {
    label en official "the number of days of the pay period during which the services performed by the employee constitute employment (FUTA)";
}
pub relation pay_period_includes_service_excepted_by_3306c9(pp: PayPeriodOfService) kind empirical {
    label en official "any of the service in the pay period is excepted by section 3306(c)(9) (railroad service)";
}
pub relation futa_pay_period(pp: PayPeriodOfService) kind institutional {
    label en official "a pay period within section 3306(d): a period of not more than 31 consecutive days";
}
@source(IRC_S3306_D, relation = formalizes, coverage = exact, quote = "the term \"pay period\" means a period (of not more than 31 consecutive days) for which a payment of remuneration is ordinarily made to the employee by the person employing him")
rule S3306dPayPeriodDefinition defeasible {
    label en official "a pay period of at most 31 consecutive days";
    for pp: PayPeriodOfService;
    for days: Integer;
    when pay_period_length_in_days(pp, days)
        and days <= 31;
    then futa_pay_period(pp);
}
pub relation futa_pay_period_all_service_deemed_employment(pp: PayPeriodOfService) kind institutional {
    label en official "all the services of the employee for the pay period are deemed to be employment";
}
@source(IRC_S3306_D, relation = formalizes, coverage = exact, quote = "if the services performed during one-half or more of any pay period by an employee for the person employing him constitute employment, all the services of such employee for such period shall be deemed to be employment")
rule S3306dOneHalfOrMoreIsEmployment defeasible {
    label en official "one-half or more of the pay period in employment: all of it is employment";
    for pp: PayPeriodOfService;
    for days: Integer;
    for employmentDays: Integer;
    when futa_pay_period(pp)
        and pay_period_length_in_days(pp, days)
        and pay_period_days_of_employment_service(pp, employmentDays)
        and employmentDays * 2 >= days;
    then futa_pay_period_all_service_deemed_employment(pp);
    unless pay_period_includes_service_excepted_by_3306c9(pp) and futa_pay_period(pp) and pay_period_length_in_days(pp, days) and pay_period_days_of_employment_service(pp, employmentDays);
}
pub relation futa_pay_period_no_service_deemed_employment(pp: PayPeriodOfService) kind institutional {
    label en official "none of the services of the employee for the pay period is deemed to be employment";
}
@source(IRC_S3306_D, relation = formalizes, coverage = exact, quote = "but if the services performed during more than one-half of any such pay period by an employee for the person employing him do not constitute employment, then none of the services of such employee for such period shall be deemed to be employment")
rule S3306dMoreThanHalfNotEmployment defeasible {
    label en official "more than one-half of the pay period outside employment: none of it is employment";
    for pp: PayPeriodOfService;
    for days: Integer;
    for employmentDays: Integer;
    when futa_pay_period(pp)
        and pay_period_length_in_days(pp, days)
        and pay_period_days_of_employment_service(pp, employmentDays)
        and employmentDays * 2 < days;
    then futa_pay_period_no_service_deemed_employment(pp);
    unless pay_period_includes_service_excepted_by_3306c9(pp) and futa_pay_period(pp) and pay_period_length_in_days(pp, days) and pay_period_days_of_employment_service(pp, employmentDays);
}

// ============================================================================
// §3306(n) — vessels operated by general agents of the United States
// ============================================================================

pub relation vessel_owned_by_or_bareboat_chartered_to_united_states(v: Person) kind empirical {
    label en official "the vessel is owned by or bareboat chartered to the United States";
}
pub relation vessel_business_conducted_by_general_agent(v: Person, agent: Person) kind empirical {
    label en official "the business of the vessel is conducted by a general agent of the Secretary of Transportation";
}
pub relation crew_service_on_vessel(service: WagePayment, crew: Person, v: Person) kind empirical {
    label en official "the service is performed by an officer or member of the crew on or in connection with the vessel";
}
pub relation futa_general_agent_vessel(v: Person, agent: Person) kind institutional {
    label en unofficial "the vessel is an American vessel owned by or bareboat chartered to the United States whose business is conducted by the general agent";
}
rule FutaGeneralAgentVessel defeasible {
    label en unofficial "the two conditions of subsection (n)(1) and (2) on an American vessel";
    for v: Person;
    for agent: Person;
    when american_vessel_or_aircraft(v, Vessel)
        and vessel_owned_by_or_bareboat_chartered_to_united_states(v)
        and vessel_business_conducted_by_general_agent(v, agent);
    then futa_general_agent_vessel(v, agent);
}
pub relation futa_service_not_excluded_by_3306c6_vessel_rule(service: WagePayment) kind institutional {
    label en official "the service of an officer or member of the crew is not excluded from employment by reason of section 3306(c)(6) (service for the United States) because it is performed on or in connection with such an American vessel";
}
@source(IRC_S3306_N, relation = formalizes, coverage = exact, quote = "service performed by officers and members of the crew of a vessel which would otherwise be included as employment under subsection (c) shall not be excluded by reason of the fact that it is performed on or in connection with an American vessel")
rule S3306nCrewServiceNotExcluded defeasible {
    label en official "crew service on a general-agent vessel is not excluded by (c)(6)";
    for service: WagePayment;
    for crew: Person;
    for v: Person;
    for agent: Person;
    when crew_service_on_vessel(service, crew, v)
        and futa_general_agent_vessel(v, agent);
    then futa_service_not_excluded_by_3306c6_vessel_rule(service);
}
pub relation futa_crew_service_for_general_agent(crew: Person, agent: Person) kind institutional {
    label en official "the officers and members of the crew are deemed to be performing services for the general agent rather than the United States";
}
@source(IRC_S3306_N, relation = formalizes, coverage = exact, quote = "the officers and members of the crew of such an American vessel whose business is conducted by a general agent of the Secretary of Transportation shall be deemed to be performing services for such general agent rather than the United States")
rule S3306nCrewServesTheGeneralAgent defeasible {
    label en official "crew of a general-agent vessel serves the general agent";
    for service: WagePayment;
    for crew: Person;
    for v: Person;
    for agent: Person;
    when crew_service_on_vessel(service, crew, v)
        and futa_general_agent_vessel(v, agent);
    then futa_crew_service_for_general_agent(crew, agent);
}
pub relation futa_general_agent_separate_legal_entity(agent: Person) kind institutional {
    label en official "each such general agent is considered a legal entity in his capacity as such general agent, separate and distinct from his identity as a person employing individuals on his own account";
}
@source(IRC_S3306_N, relation = formalizes, coverage = exact, quote = "each such general agent shall be considered a legal entity in his capacity as such general agent, separate and distinct from his identity as a person employing individuals on his own account")
rule S3306nGeneralAgentSeparateEntity defeasible {
    label en official "the general agent is a separate legal entity in that capacity";
    for v: Person;
    for agent: Person;
    when futa_general_agent_vessel(v, agent);
    then futa_general_agent_separate_legal_entity(agent);
}
pub relation futa_general_agent_subject_to_employer_requirements(agent: Person, v: Person) kind institutional {
    label en official "the general agent who is an employer within the meaning of subsection (a) is subject to all the requirements imposed upon an employer under this chapter with respect to service that is employment by reason of this subsection";
}
@source(IRC_S3306_N, relation = formalizes, coverage = exact, quote = "Each such general agent who in his capacity as such is an employer within the meaning of subsection (a) shall be subject to all the requirements imposed upon an employer under this chapter")
rule S3306nGeneralAgentIsSubjectToEmployerRequirements defeasible {
    label en official "an agent that is an employer under (a) carries the employer requirements";
    for v: Person;
    for agent: Person;
    for y: TaxableYear;
    when futa_general_agent_vessel(v, agent)
        and futa_employer(agent, y);
    then futa_general_agent_subject_to_employer_requirements(agent, v);
}

// ============================================================================
// §3306(o) — crew leaders
// ============================================================================

pub relation crew_furnished_by_leader(worker: Person, leader: Person, forWhom: Person) kind empirical {
    label en official "the individual is a member of a crew furnished by the crew leader to perform agricultural labor for the other person";
}
pub relation crew_leader_holds_valid_mspa_registration(leader: Person) kind empirical {
    label en official "the crew leader holds a valid certificate of registration under the Migrant and Seasonal Agricultural Worker Protection Act";
}
pub relation substantially_all_crew_operate_leader_provided_equipment(leader: Person, forWhom: Person) kind empirical {
    label en official "substantially all the members of the crew operate or maintain tractors, mechanized harvesting or crop-dusting equipment, or any other mechanized equipment, which is provided by the crew leader (an evaluative finding of the case: DECISION-0194)";
}
pub relation worker_is_employee_of_other_person_3306i(worker: Person, forWhom: Person) kind empirical {
    label en official "the individual is an employee of the other person within the meaning of subsection (i) (section 3121(d) without paragraph (4) and subparagraphs (B) and (C) of paragraph (3))";
}
pub relation crew_leader_cash_remuneration_paid(worker: Person, leader: Person, forWhom: Person, amount: Money) kind empirical {
    label en official "the cash remuneration paid to the individual by the crew leader (on his behalf or on behalf of the other person) for the agricultural labor performed for the other person";
}
pub relation futa_crew_leader(leader: Person, forWhom: Person) kind institutional {
    label en official "the individual is a crew leader for the other person under subsection (o)(3)";
}
@source(IRC_S3306_O, relation = formalizes, coverage = exact, quote = "(C) has not entered into a written agreement with such other person under which such individual is designated as an employee of such other person.")
rule S3306o3CrewLeader defeasible {
    label en official "furnishes individuals for agricultural labor, pays them, and has no written agreement designating him an employee of the other person";
    for leader: Person;
    for forWhom: Person;
    when furnishes_agricultural_laborers_and_pays_them(leader, forWhom)
        and not_known(designated_employee_by_written_agreement(leader, forWhom));
    then futa_crew_leader(leader, forWhom);
}
pub relation futa_crew_member_employee_of_crew_leader(worker: Person, leader: Person) kind institutional {
    label en official "the crew member is treated as an employee of the crew leader for purposes of this chapter";
}
@source(IRC_S3306_O, relation = formalizes, coverage = exact, quote = "(i) such crew leader holds a valid certificate of registration under the Migrant and Seasonal Agricultural Worker Protection Act; or")
rule S3306o1ARegisteredCrewLeader defeasible {
    label en official "a member of the crew of a registered crew leader is the leader's employee unless the worker is an employee of the other person";
    for worker: Person;
    for leader: Person;
    for forWhom: Person;
    when crew_furnished_by_leader(worker, leader, forWhom)
        and futa_crew_leader(leader, forWhom)
        and crew_leader_holds_valid_mspa_registration(leader)
        and not_known(worker_is_employee_of_other_person_3306i(worker, forWhom));
    then futa_crew_member_employee_of_crew_leader(worker, leader);
}
@source(IRC_S3306_O, relation = formalizes, coverage = exact, quote = "(ii) substantially all the members of such crew operate or maintain tractors, mechanized harvesting or crop-dusting equipment, or any other mechanized equipment, which is provided by such crew leader; and")
rule S3306o1AMechanizedCrew defeasible {
    label en official "a member of a mechanized crew is the leader's employee unless the worker is an employee of the other person";
    for worker: Person;
    for leader: Person;
    for forWhom: Person;
    when crew_furnished_by_leader(worker, leader, forWhom)
        and futa_crew_leader(leader, forWhom)
        and substantially_all_crew_operate_leader_provided_equipment(leader, forWhom)
        and not_known(worker_is_employee_of_other_person_3306i(worker, forWhom));
    then futa_crew_member_employee_of_crew_leader(worker, leader);
}
pub relation futa_other_person_treated_as_employer_of_crew_member(forWhom: Person, worker: Person) kind institutional {
    label en official "the other person and not the crew leader is treated as the employer of the individual";
}
@source(IRC_S3306_O, relation = formalizes, coverage = exact, quote = "(A) such other person and not the crew leader shall be treated as the employer of such individual; and")
rule S3306o2AOtherPersonIsEmployer defeasible {
    label en official "a crew member not treated as the leader's employee is the other person's";
    for worker: Person;
    for leader: Person;
    for forWhom: Person;
    when crew_furnished_by_leader(worker, leader, forWhom)
        and futa_crew_leader(leader, forWhom)
        and not_known(futa_crew_member_employee_of_crew_leader(worker, leader));
    then futa_other_person_treated_as_employer_of_crew_member(forWhom, worker);
}
pub relation futa_cash_remuneration_treated_as_paid_by_other_person(forWhom: Person, worker: Person, amount: Money) kind institutional {
    label en official "the other person is treated as having paid cash remuneration to the individual equal to the cash remuneration paid by the crew leader";
}
@source(IRC_S3306_O, relation = formalizes, coverage = exact, quote = "(B) such other person shall be treated as having paid cash remuneration to such individual in an amount equal to the amount of cash remuneration paid to such individual by the crew leader")
rule S3306o2BRemunerationTreatedAsPaid defeasible {
    label en official "the crew leader's cash remuneration is attributed to the other person";
    for worker: Person;
    for leader: Person;
    for forWhom: Person;
    for amount: Money;
    when futa_other_person_treated_as_employer_of_crew_member(forWhom, worker)
        and crew_leader_cash_remuneration_paid(worker, leader, forWhom, amount);
    then futa_cash_remuneration_treated_as_paid_by_other_person(forWhom, worker, amount);
}

// ============================================================================
// §3306(r) — deferred compensation and salary reduction arrangements
// ============================================================================

pub relation employer_contribution_under_401k_cash_or_deferred_not_in_gross_income(pay: WagePayment, amount: Money) kind empirical {
    label en official "an employer contribution under a qualified cash or deferred arrangement (section 401(k)), to the extent not included in gross income by reason of section 402(e)(3)";
}
pub relation employer_contribution_under_414h2_pickup_by_salary_reduction(pay: WagePayment, amount: Money) kind empirical {
    label en official "an amount treated as an employer contribution under section 414(h)(2) where the pickup is pursuant to a salary reduction agreement (written or not)";
}
pub relation futa_contribution_included_in_wages(pay: WagePayment, amount: Money) kind institutional {
    label en official "no paragraph of subsection (b) other than (b)(1) excludes the amount from the term wages";
}
@source(IRC_S3306_R, relation = formalizes, coverage = exact, quote = "(A) any employer contribution under a qualified cash or deferred arrangement (as defined in section 401(k)) to the extent not included in gross income by reason of section 402(e)(3), or")
rule S3306r1AContributionIsWages defeasible {
    label en official "an employer contribution to a qualified cash or deferred arrangement is not excluded from wages";
    for pay: WagePayment;
    for amount: Money;
    when employer_contribution_under_401k_cash_or_deferred_not_in_gross_income(pay, amount);
    then futa_contribution_included_in_wages(pay, amount);
}
@source(IRC_S3306_R, relation = formalizes, coverage = exact, quote = "(B) any amount treated as an employer contribution under section 414(h)(2) where the pickup referred to in such section is pursuant to a salary reduction agreement (whether evidenced by a written instrument or otherwise).")
rule S3306r1BPickupIsWages defeasible {
    label en official "a section 414(h)(2) pickup under a salary reduction agreement is not excluded from wages";
    for pay: WagePayment;
    for amount: Money;
    when employer_contribution_under_414h2_pickup_by_salary_reduction(pay, amount);
    then futa_contribution_included_in_wages(pay, amount);
}
pub relation deferral_arrangement(plan: Person) kind empirical {
    label en unofficial "the plan or other arrangement is an arrangement for deferral of compensation (a case fact: this package has no Plan entity)";
}
pub relation plan_described_in_3306b5(plan: Person) kind empirical {
    label en official "the plan is a plan described in subsection (b)(5) (qualified and similar plans)";
}
pub relation futa_nonqualified_deferred_compensation_plan(plan: Person) kind institutional {
    label en official "any plan or other arrangement for deferral of compensation other than a plan described in subsection (b)(5)";
}
@source(IRC_S3306_R, relation = formalizes, coverage = exact, quote = "the term \"nonqualified deferred compensation plan\" means any plan or other arrangement for deferral of compensation other than a plan described in subsection (b)(5).")
rule S3306r2CNonqualifiedPlan defeasible {
    label en official "a deferral arrangement not described in (b)(5)";
    for plan: Person;
    when deferral_arrangement(plan)
        and not_known(plan_described_in_3306b5(plan));
    then futa_nonqualified_deferred_compensation_plan(plan);
}
pub relation futa_deferred_compensation_taken_into_account_on(pay: WagePayment, amount: Money, on: Date) kind institutional {
    label en official "the date the amount deferred under a nonqualified deferred compensation plan is taken into account for purposes of this chapter (the later of the performance of the services and the lapse of the substantial risk of forfeiture)";
}
@source(IRC_S3306_R, relation = formalizes, coverage = exact, quote = "Any amount deferred under a nonqualified deferred compensation plan shall be taken into account for purposes of this chapter as of the later of—")
rule S3306r2AServicesNotBefore defeasible {
    label en official "services performed on or after the lapse of the risk: the services date";
    for pay: WagePayment;
    for amount: Money;
    for servicesOn: Date;
    for forfeitureOn: Date;
    when deferred_amount(pay, amount, servicesOn, forfeitureOn)
        and servicesOn >= forfeitureOn;
    then futa_deferred_compensation_taken_into_account_on(pay, amount, servicesOn);
}
rule S3306r2ARiskLapsesLater defeasible {
    label en official "the risk lapses after the services: the lapse date";
    for pay: WagePayment;
    for amount: Money;
    for servicesOn: Date;
    for forfeitureOn: Date;
    when deferred_amount(pay, amount, servicesOn, forfeitureOn)
        and forfeitureOn > servicesOn;
    then futa_deferred_compensation_taken_into_account_on(pay, amount, forfeitureOn);
}
pub relation deferred_compensation_payout_on(pay: WagePayment, paidOn: Date) kind empirical {
    label en official "the amount taken into account (and the income attributable to it) is later paid out on this date";
}
pub relation futa_payout_treated_as_wages_again(employer: Person, pay: WagePayment) kind institutional {
    label en unofficial "the protected effect: treating the later payout of an amount already taken into account as wages again";
}
@source(IRC_S3306_R, relation = formalizes, coverage = exact, quote = "Any amount taken into account as wages by reason of subparagraph (A) (and the income attributable thereto) shall not thereafter be treated as wages for purposes of this chapter.")
rule S3306r2BTaxedOnlyOnce defeasible {
    label en official "a payout after the amount was taken into account is not wages again";
    for pay: WagePayment;
    for employer: Person;
    for amount: Money;
    for takenOn: Date;
    for paidOn: Date;
    when futa_deferred_compensation_taken_into_account_on(pay, amount, takenOn)
        and deferred_compensation_payout_on(pay, paidOn)
        and wage_payment(pay, employer, _, _, _, _)
        and paidOn > takenOn;
    then immunity S3306r2BTaxedOnlyOnceImmunity {
        holder employer;
        protected_effect futa_payout_treated_as_wages_again(employer, pay);
        window [takenOn, infinity];
    };
}

// ============================================================================
// §3306(s) — tips treated as wages
// ============================================================================

pub relation futa_tip_wages(pay: WagePayment, amount: Money) kind institutional {
    label en official "the tips are wages within the meaning of this chapter";
}
pub relation tips_received_while_performing_employment(pay: WagePayment) kind empirical {
    label en official "the tips are received while performing services which constitute employment";
}
@source(IRC_S3306_S, relation = formalizes, coverage = exact, quote = "For purposes of this chapter, the term \"wages\" includes tips which are—")
rule S3306sTipsAreWages defeasible {
    label en official "tips received while performing employment and included in a written statement furnished under section 6053(a) are wages";
    for pay: WagePayment;
    for amount: Money;
    for on: Date;
    when tip_reported(pay, amount, on)
        and tips_received_while_performing_employment(pay)
        and futa_employment(pay);
    then futa_tip_wages(pay, amount);
}

// ============================================================================
// §3303(d)-(f) — safe harbors and the noncharging requirement
// ============================================================================

pub relation state_law_permits_voluntary_contributions_in_rate_computation(state: Person, y: TaxableYear) kind empirical {
    label en official "the State law permits voluntary contributions to be used in the computation of reduced rates";
}
pub relation voluntary_contribution_paid_on(state: Person, y: TaxableYear, paidOn: Date) kind empirical {
    label en official "the voluntary contribution used in the computation of the reduced rates effective for the year is paid on this date";
}
pub relation state_law_deemed_to_violate_3303a_standards(state: Person, y: TaxableYear) kind institutional {
    label en official "the State law is deemed to violate the standards set forth in section 3303(a) (the effect the safe harbors of subsections (d) and (e) protect against)";
}
@source(IRC_S3303_D, relation = formalizes, coverage = exact, quote = "if such contributions are paid prior to the expiration of 120 days after the beginning of the year for which such rates are effective")
rule S3303dVoluntaryContributionsSafeHarbor defeasible {
    label en official "a State law permitting voluntary contributions paid within 120 days after the beginning of the year is not deemed to violate section 3303(a) (INTERPRETATION: paid within the first 120 days, the day count from the first day of the year)";
    for state: Person;
    for y: TaxableYear;
    for yearBegins: Date;
    for paidOn: Date;
    when state_law_permits_voluntary_contributions_in_rate_computation(state, y)
        and voluntary_contribution_paid_on(state, y, paidOn)
        and us.irc.core::begins(y, yearBegins)
        and days_between(yearBegins, paidOn) < 120;
    then immunity S3303dVoluntaryContributionsImmunity {
        holder state;
        protected_effect state_law_deemed_to_violate_3303a_standards(state, y);
        window [yearBegins, add_calendar_period(yearBegins, 120 calendar_day)];
    };
}
pub relation state_permits_501c3_organization_to_elect_payments_in_lieu(state: Person, org: Person) kind empirical {
    label en official "the State permits an organization (or group) described in section 501(c)(3) which is exempt from income tax under section 501(a) to elect to pay into the State unemployment fund amounts equal to the compensation attributable to service in its employ, in lieu of contributions";
}
pub relation organization_described_in_501c3_and_exempt(org: Person) kind empirical {
    label en official "the organization is described in section 501(c)(3) and exempt from income tax under section 501(a)";
}
@source(IRC_S3303_E, relation = formalizes, coverage = exact, quote = "A State may, without being deemed to violate the standards set forth in subsection (a), permit an organization (or a group of organizations) described in section 501(c)(3) which is exempt from income tax under section 501(a) to elect")
rule S3303eNonprofitPaymentsInLieuSafeHarbor defeasible {
    label en official "permitting a 501(c)(3) organization to elect payments in lieu of contributions is not a violation of section 3303(a)";
    for state: Person;
    for org: Person;
    for y: TaxableYear;
    when state_permits_501c3_organization_to_elect_payments_in_lieu(state, org)
        and organization_described_in_501c3_and_exempt(org)
        and futa_year_of_state_law(state, y);
    then immunity S3303eNonprofitPaymentsInLieuImmunity {
        holder state;
        protected_effect state_law_deemed_to_violate_3303a_standards(state, y);
        window [-infinity, infinity];
    };
}
pub relation futa_year_of_state_law(state: Person, y: TaxableYear) kind empirical {
    label en unofficial "the year for which the State law is examined (binds the year of the safe harbor)";
}
pub relation state_law_relieves_account_of_charges_despite_fault_and_pattern(state: Person, y: TaxableYear) kind empirical {
    label en official "the State law relieves an employer's account of charges relating to a payment although the State agency determines that the payment was made because the employer or its agent was at fault for failing to respond timely or adequately to the agency's request for information and has established a pattern of such failures";
}
pub relation state_law_provides_no_relief_for_fault_and_pattern(state: Person, y: TaxableYear) kind empirical {
    label en official "the State law provides that an employer's account is not relieved of charges in the case of fault (A) and pattern (B)";
}
pub relation state_law_meets_3303f1_requirement(state: Person, y: TaxableYear) kind institutional {
    label en official "the State law has the noncharging provision that subsection (f)(1) requires";
}
@source(IRC_S3303_F, relation = formalizes, coverage = exact, quote = "A State law shall be treated as meeting the requirements of subsection (a)(1) only if such law provides that an employer's account shall not be relieved of charges relating to a payment from the State unemployment fund")
rule S3303f1ProvisionPresent defeasible {
    label en official "a State law that provides for charging in the fault-and-pattern case has the required provision";
    for state: Person;
    for y: TaxableYear;
    when state_law_provides_no_relief_for_fault_and_pattern(state, y);
    then state_law_meets_3303f1_requirement(state, y);
}
pub relation state_law_not_treated_as_meeting_3303a1(state: Person, y: TaxableYear) kind institutional {
    label en official "the State law is not treated as meeting the requirements of subsection (a)(1): it relieves the account of charges in the fault-and-pattern case";
}
rule S3303f1ProvisionAbsent defeasible {
    label en official "relief from charges despite fault and pattern: the requirement of (a)(1) is not treated as met";
    for state: Person;
    for y: TaxableYear;
    when state_law_relieves_account_of_charges_despite_fault_and_pattern(state, y);
    then state_law_not_treated_as_meeting_3303a1(state, y);
}

// ============================================================================
// §3305(c), (g)-(j)
// ============================================================================

pub relation national_banking_association(bank: Person) kind empirical {
    label en official "the person is a national banking association";
}
pub relation state_unemployment_law_requires_returns_from_persons(state: Person) kind empirical {
    label en official "the State has a law requiring contributions to an unemployment fund under which other persons are required to render returns and reports relative to their employees, remuneration and services";
}
pub relation state_requires_returns_from_national_bank(state: Person, bank: Person) kind empirical {
    label en official "the State requires the national banking association to render returns and reports relative to its employees, their remuneration and services";
}
@source(IRC_S3305_C, relation = formalizes, coverage = exact, quote = "Nothing contained in section 5240 of the Revised Statutes, as amended (12 U.S.C. 484), shall prevent any State from requiring any national banking association to render returns and reports")
rule S3305cStateMayRequireReturns defeasible {
    label en official "a State may require a national bank to render returns and reports to the same extent as other persons";
    for state: Person;
    for bank: Person;
    when national_banking_association(bank)
        and state_unemployment_law_requires_returns_from_persons(state);
    then liberty S3305cStateRequiresReturnsLiberty {
        holder state;
        against bank;
        action state_requires_returns_from_national_bank(state, bank);
        window [-infinity, infinity];
    };
}
pub relation state_official_sends_return_copy_and_requests_examination(state: Person, bank: Person, requestedOn: Date) kind empirical {
    label en official "a duly authorized official, body or commission of a State sends the Comptroller of the Currency a copy of a return or report of the national banking association and requests an examination";
}
pub relation next_succeeding_examination_of_bank_on(bank: Person, on: Date) kind empirical {
    label en official "the date of the next succeeding examination of the association";
}
pub relation comptroller_examined_correctness_of_return(bank: Person, state: Person) kind empirical {
    label en official "the Comptroller caused an examination of the correctness of the return or report to be made at the next succeeding examination";
}
pub relation comptroller_examined_return_on(bank: Person, state: Person, on: Date) kind empirical {
    label en official "the examination of the correctness of the return or report was made on this date";
}
pub relation comptroller_transmitted_findings_to_state(bank: Person, state: Person) kind empirical {
    label en official "the Comptroller transmitted to the State official a complete statement of his findings respecting the accuracy of the return or report";
}
@source(IRC_S3305_C, relation = formalizes, coverage = exact, quote = "cause an examination of the correctness of such return or report to be made at the time of the next succeeding examination of such association")
pub rule S3305cComptrollerExaminesReturn defeasible {
    label en official "on a State's request the Comptroller shall cause the return to be examined at the association's next examination";
    for state: Person;
    for bank: Person;
    for requestedOn: Date;
    for examinationOn: Date;
    when state_official_sends_return_copy_and_requests_examination(state, bank, requestedOn)
        and next_succeeding_examination_of_bank_on(bank, examinationOn);
    then duty S3305cExaminationDuty {
        bearer ComptrollerOfTheCurrency;
        beneficiary state;
        goal achievement {
            condition comptroller_examined_correctness_of_return(bank, state);
            window [requestedOn, examinationOn];
        }
    };
}
@source(IRC_S3305_C, relation = formalizes, coverage = exact, quote = "and shall thereupon transmit to such official, body, or commission a complete statement of his findings respecting the accuracy of such returns or reports")
pub rule S3305cComptrollerTransmitsFindings defeasible {
    label en official "after the examination the Comptroller shall transmit a complete statement of his findings (no deadline is stated: the window is open from the examination)";
    for state: Person;
    for bank: Person;
    for examinedOn: Date;
    when comptroller_examined_return_on(bank, state, examinedOn);
    then duty S3305cTransmitFindingsDuty {
        bearer ComptrollerOfTheCurrency;
        beneficiary state;
        goal achievement {
            condition comptroller_transmitted_findings_to_state(bank, state);
            window [examinedOn, infinity];
        }
    };
}
// (g): general agents of the Secretary of Transportation
pub relation state_agent_would_contribute_to(agent: Person, state: Person) kind empirical {
    label en official "the State to which the general agent would make contributions if the vessel were operated for his own account";
}
pub relation state_may_require_general_agent_contributions(state: Person, agent: Person, v: Person) kind institutional {
    label en official "the permission of subsection (f) applies to the general agent with respect to service of the crew on the vessel: the State may require contributions on account of that service";
}
pub relation state_exercises_general_agent_permission(state: Person, agent: Person, v: Person) kind empirical {
    label en official "the State requires the general agent's contributions on account of the crew's service on the vessel";
}
@source(IRC_S3305_G, relation = formalizes, coverage = exact, quote = "The permission granted by subsection (f) shall apply in the same manner and under the same conditions (including the obligation to comply with all requirements of State unemployment compensation laws) to general agents of the Secretary of Transportation")
pub rule S3305gGeneralAgentPermission defeasible {
    label en official "the State to which the agent would contribute may require contributions for the crew of a general-agent vessel, when its law is approved under section 3304";
    for state: Person;
    for agent: Person;
    for v: Person;
    for y: TaxableYear;
    when futa_general_agent_vessel(v, agent)
        and state_agent_would_contribute_to(agent, state)
        and state_exercises_general_agent_permission(state, agent, v)
        and state_law_approved_3304(state, y);
    then power S3305gGeneralAgentContributionPower {
        holder state;
        over agent;
        exercise state_exercises_general_agent_permission(state, agent, v);
        valid_when state_law_approved_3304(state, y);
        effect create(general_agent_permission_exercise_created(state, agent, v));
    };
}
pub relation general_agent_permission_exercise_created(state: Person, agent: Person, v: Person) kind institutional {
    label en unofficial "the effect of the State's exercise of the section 3305(g) permission";
}
rule S3305gStateMayRequire defeasible {
    label en unofficial "the ordinary-rule counterpart of the power: the State to which the agent would contribute may require contributions when its law is approved (consumed by subsection (h))";
    for state: Person;
    for agent: Person;
    for v: Person;
    for y: TaxableYear;
    when futa_general_agent_vessel(v, agent)
        and state_agent_would_contribute_to(agent, state)
        and state_law_approved_3304(state, y);
    then state_may_require_general_agent_contributions(state, agent, v);
}
pub relation futa_general_agent_not_exempt_from_3301(agent: Person) kind institutional {
    label en official "the general agent is designated an instrumentality of the United States neither wholly nor partially owned by it and is not exempt from the tax imposed by section 3301";
}
@source(IRC_S3305_G, relation = formalizes, coverage = exact, quote = "Such general agents are designated, for this purpose, instrumentalities of the United States neither wholly nor partially owned by it and shall not be exempt from the tax imposed by section 3301.")
rule S3305gGeneralAgentNotExempt defeasible {
    label en official "a general agent of the Secretary of Transportation for such a vessel is not exempt from the section 3301 tax";
    for v: Person;
    for agent: Person;
    when futa_general_agent_vessel(v, agent);
    then futa_general_agent_not_exempt_from_3301(agent);
}
// (h): what the State may require
pub relation state_requires_contributions_from_persons_performing_service(state: Person, agent: Person) kind empirical {
    label en official "the State requires contributions from persons performing the service under its unemployment compensation law or the temporary disability insurance law administered in connection with it";
}
pub relation state_requires_agent_disability_contributions_and_deductions(state: Person, agent: Person) kind empirical {
    label en official "the State requires the general agents to make contributions under the temporary disability insurance law and to make the deductions from wages or remuneration required by the unemployment compensation or disability insurance law";
}
@source(IRC_S3305_H, relation = formalizes, coverage = exact, quote = "require contributions from persons performing such service under its unemployment compensation law or temporary disability insurance law administered in connection therewith")
rule S3305h1StateMayRequireContributionsFromPersons defeasible {
    label en official "a State may require contributions from persons performing service on account of which the agent contributes under (g)";
    for state: Person;
    for agent: Person;
    for v: Person;
    when state_may_require_general_agent_contributions(state, agent, v);
    then liberty S3305h1RequireContributionsLiberty {
        holder state;
        against agent;
        action state_requires_contributions_from_persons_performing_service(state, agent);
        window [-infinity, infinity];
    };
}
@source(IRC_S3305_H, relation = formalizes, coverage = exact, quote = "require general agents of the Secretary of Transportation to make contributions under such temporary disability insurance law and to make such deductions from wages or remuneration")
rule S3305h2StateMayRequireAgentContributionsAndDeductions defeasible {
    label en official "a State may require the general agents to contribute under the disability insurance law and make the required deductions";
    for state: Person;
    for agent: Person;
    for v: Person;
    when state_may_require_general_agent_contributions(state, agent, v);
    then liberty S3305h2RequireAgentDeductionsLiberty {
        holder state;
        against agent;
        action state_requires_agent_disability_contributions_and_deductions(state, agent);
        window [-infinity, infinity];
    };
}
// (i)
pub relation general_agent_contributes_under_3305g_or_h(agent: Person) kind empirical {
    label en official "the general agent makes contributions pursuant to subsection (g) or (h)";
}
pub relation general_agent_legal_entity_as_instrumentality(agent: Person) kind institutional {
    label en official "for purposes of subsections (g) and (h) the general agent is a legal entity in his capacity as an instrumentality of the United States, separate and distinct from his identity as a person employing individuals on his own account";
}
@source(IRC_S3305_I, relation = formalizes, coverage = exact, quote = "shall, for purposes of such subsections, be considered a legal entity in his capacity as an instrumentality of the United States, separate and distinct from his identity as a person employing individuals on his own account")
rule S3305iGeneralAgentLegalEntity defeasible {
    label en official "a contributing general agent is a separate legal entity in his capacity as an instrumentality";
    for agent: Person;
    when general_agent_contributes_under_3305g_or_h(agent);
    then general_agent_legal_entity_as_instrumentality(agent);
}
// (j)
pub relation person_required_to_contribute_under_3305_permission(person: Person, state: Person) kind empirical {
    label en official "the person is required, pursuant to the permission granted by section 3305, to make contributions to the unemployment fund under the State's law";
}
pub relation secretary_of_labor_certifies_inconsistency_on(state: Person, certifiedOn: Date) kind empirical {
    label en official "the Secretary of Labor certifies to the Secretary of the Treasury, after reasonable notice and opportunity for hearing to the State agency, that the State law is inconsistent with a condition of the permission or that in its application in the 12-month period ending on October 31 there was a substantial failure to comply with a condition";
}
pub relation credits_of_3302_denied_under_3305j(person: Person, y: TaxableYear) kind institutional {
    label en official "the person is not entitled to the credits permitted by section 3302(a) and (b) against the tax imposed by section 3301 for the taxable year";
}
@source(IRC_S3305_J, relation = formalizes, coverage = exact, quote = "shall not be entitled to the credits permitted, with respect to the unemployment compensation law of a State, by subsections (a) and (b) of section 3302 against the tax imposed by section 3301 for any taxable year if, on October 31 of such taxable year, the Secretary of Labor certifies")
rule S3305jCreditsDenied defeasible {
    label en official "credits are denied for the year when the Secretary of Labor certifies on October 31 of the year (the day before the tenth month after the year's first day ends)";
    for person: Person;
    for state: Person;
    for y: TaxableYear;
    for yearBegins: Date;
    for certifiedOn: Date;
    when person_required_to_contribute_under_3305_permission(person, state)
        and state_law_approved_3304(state, y)
        and secretary_of_labor_certifies_inconsistency_on(state, certifiedOn)
        and us.irc.core::begins(y, yearBegins)
        and days_between(certifiedOn, add_calendar_period(yearBegins, 10 calendar_month)) == 1;
    then credits_of_3302_denied_under_3305j(person, y);
}

// ============================================================================
// §3309(b), (c), (d)
// ============================================================================

pub enum Section3309bExclusion {
    ChurchOrReligiousOrganizationOrSchool;   // (1)
    MinisterOrReligiousOrderMember;           // (2)
    GovernmentalElectedOfficial;              // (3)(A)
    GovernmentalLegislativeOrJudicial;        // (3)(B)
    GovernmentalNationalGuard;                // (3)(C)
    GovernmentalTemporaryEmergencyEmployee;   // (3)(D)
    GovernmentalPolicymakingOrAdvisoryPosition; // (3)(E)
    GovernmentalElectionWorker;               // (3)(F), remuneration under $1,000
    RehabilitationFacilityService;            // (4)
    WorkReliefOrWorkTrainingProgram;          // (5)
    InmateOfCustodialOrPenalInstitution;      // (6)
    label en unofficial "the services to which section 3309 does not apply by subsection (b)";
}
pub relation section_3309b_service_kind(service: WagePayment, kind: Section3309bExclusion) kind empirical {
    label en official "the service is of one of the kinds listed in section 3309(b) (paragraphs (3)(A)-(F) are governmental service within section 3306(c)(7))";
}
pub relation election_worker_remuneration_in_calendar_year(service: WagePayment, amount: Money) kind empirical {
    label en official "the remuneration received by the individual during the calendar year for services as an election official or election worker";
}
pub relation section_3309_service_outside_subsection_a(service: WagePayment) kind institutional {
    label en official "section 3309 does not apply to the service (subsection (b))";
}
@source(IRC_S3309_B, relation = formalizes, coverage = exact, quote = "This section shall not apply to service performed—")
rule S3309bListedServiceIsOutside defeasible {
    label en official "service of a kind listed in (b) (other than election workers, which have their own threshold)";
    for service: WagePayment;
    for kind: Section3309bExclusion;
    when section_3309b_service_kind(service, kind)
        and kind != GovernmentalElectionWorker;
    then section_3309_service_outside_subsection_a(service);
}
@source(IRC_S3309_B, relation = formalizes, coverage = exact, quote = "as an election official or election worker if the amount of remuneration received by the individual during the calendar year for services as an election official or election worker is less than $1,000")
rule S3309b3FElectionWorkerBelowThreshold defeasible {
    label en official "election workers are outside section 3309 only if the calendar year's remuneration is less than $1,000";
    for service: WagePayment;
    for amount: Money;
    when section_3309b_service_kind(service, GovernmentalElectionWorker)
        and election_worker_remuneration_in_calendar_year(service, amount)
        and amount < 1000.00 USD;
    then section_3309_service_outside_subsection_a(service);
}
pub relation nonprofit_headcount_on_day(org: Person, day: Date, calendarWeek: Integer, headcount: Integer) kind empirical {
    label en official "the total number of individuals employed by the organization in employment (determined without regard to section 3306(c)(8) and excluding service outside section 3309 by reason of subsection (b)) for some portion of the day, with the number of the calendar week of the day";
}
pub relation nonprofit_four_employee_weeks_in_year(org: Person, y: TaxableYear, weeks: Integer) kind institutional {
    label en unofficial "the number of different calendar weeks of the year with a day on which the headcount was 4 or more";
}
rule NonprofitFourEmployeeWeeksInYear defeasible {
    label en unofficial "count the distinct calendar weeks of the year that contain a day with four or more employees";
    for org: Person;
    for y: TaxableYear;
    for yearBegins: Date;
    for yearEnds: Date;
    when nonprofit_headcount_records_complete(org, y)
        and us.irc.core::begins(y, yearBegins)
        and us.irc.core::ends(y, yearEnds);
    then nonprofit_four_employee_weeks_in_year(org, y,
        count distinct w: Integer for d: Date, n: Integer
            where nonprofit_headcount_on_day(org, d, w, n) and n >= 4 and d >= yearBegins and d <= yearEnds);
}
pub relation nonprofit_meets_four_employee_test(org: Person, y: TaxableYear) kind institutional {
    label en official "on each of some 20 days during the calendar year or the preceding calendar year, each in a different calendar week, the organization employed 4 or more individuals";
}
@source(IRC_S3309_C, relation = formalizes, coverage = exact, quote = "unless on each of some 20 days during such calendar year or the preceding calendar year, each day being in a different calendar week")
rule S3309cTestMetInTheYear defeasible {
    label en official "20 or more different calendar weeks of the year with a day of four or more employees";
    for org: Person;
    for y: TaxableYear;
    for weeks: Integer;
    when nonprofit_four_employee_weeks_in_year(org, y, weeks)
        and weeks >= 20;
    then nonprofit_meets_four_employee_test(org, y);
}
rule S3309cTestMetInThePrecedingYear defeasible {
    label en official "the same test met in the preceding calendar year";
    for org: Person;
    for y: TaxableYear;
    for prior: TaxableYear;
    for weeks: Integer;
    when preceding_taxable_year(y, prior)
        and nonprofit_four_employee_weeks_in_year(org, prior, weeks)
        and weeks >= 20;
    then nonprofit_meets_four_employee_test(org, y);
}
pub relation nonprofit_headcount_records_complete(org: Person, y: TaxableYear) kind empirical {
    label en unofficial "the case declares its headcount records for the year and the preceding year complete (without it a missing record is not read as a day below four)";
}
@source(IRC_S3309_C, relation = formalizes, coverage = exact, quote = "This section shall not apply to service performed during any calendar year in the employ of any organization unless")
rule S3309cServiceOutsideWhenTestNotMet defeasible {
    label en official "service for an organization that does not meet the four-employee test is outside section 3309";
    for service: WagePayment;
    for org: Person;
    for y: TaxableYear;
    when wage_payment(service, org, _, y, _, _)
        and nonprofit_headcount_records_complete(org, y)
        and not_known(nonprofit_meets_four_employee_test(org, y));
    then section_3309_service_outside_subsection_a(service);
}
// (d): Indian tribes
pub relation state_law_provides_tribe_election(state: Person, y: TaxableYear) kind empirical {
    label en official "the State law provides that an Indian tribe may make contributions for employment as if it were within section 3306 or make payments in lieu of contributions, with separate elections for itself and each wholly owned subdivision, subsidiary or business enterprise";
}
pub relation tribe_delinquency_notice_received_on(tribe: Person, on: Date) kind empirical {
    label en official "the tribe received a notice of delinquency";
}
pub relation tribe_made_required_payment_on(tribe: Person, on: Date) kind empirical {
    label en official "the tribe made the contributions, payments in lieu of contributions, or payment of penalties or interest assessed with respect to the failure";
}
pub relation tribe_failed_to_post_required_bond(tribe: Person) kind empirical {
    label en official "the tribe failed to post a required payment bond";
}
pub relation tribe_payment_made_within_90_days_of_notice(tribe: Person, noticeOn: Date) kind institutional {
    label en unofficial "the tribe made the required payment within 90 days of receiving the notice";
}
rule TribePaymentMadeWithin90Days defeasible {
    for tribe: Person;
    for noticeOn: Date;
    for paidOn: Date;
    when tribe_delinquency_notice_received_on(tribe, noticeOn)
        and tribe_made_required_payment_on(tribe, paidOn)
        and paidOn >= noticeOn
        and days_between(noticeOn, paidOn) <= 90;
    then tribe_payment_made_within_90_days_of_notice(tribe, noticeOn);
}
pub relation tribe_service_not_excepted_from_employment_from(tribe: Person, from: Date) kind institutional {
    label en official "service for the tribe is not excepted from employment under section 3306(c)(7) from this date until the failure is corrected";
}
@source(IRC_S3309_D, relation = formalizes, coverage = exact, quote = "if, within 90 days of having received a notice of delinquency, a tribe fails to make contributions, payments in lieu of contributions, or payment of penalties or interest")
rule S3309dTribeFailureToPay defeasible {
    label en official "a tribe that has not paid within 90 days of the notice: its service is not excepted from employment from the day after the 90th day";
    for tribe: Person;
    for noticeOn: Date;
    when tribe_delinquency_notice_received_on(tribe, noticeOn)
        and not_known(tribe_payment_made_within_90_days_of_notice(tribe, noticeOn));
    then tribe_service_not_excepted_from_employment_from(tribe, add_calendar_period(noticeOn, 91 calendar_day));
}
@source(IRC_S3309_D, relation = formalizes, coverage = exact, quote = "or if the tribe fails to post a required payment bond, then service for the tribe shall not be excepted from employment under section 3306(c)(7) until any such failure is corrected")
rule S3309dTribeFailureToPostBond defeasible {
    label en official "a tribe that fails to post a required bond: its service is not excepted from employment (from the date the case records the failure)";
    for tribe: Person;
    for noticeOn: Date;
    when tribe_failed_to_post_required_bond(tribe)
        and tribe_delinquency_notice_received_on(tribe, noticeOn);
    then tribe_service_not_excepted_from_employment_from(tribe, noticeOn);
}
pub relation tribe_failure_corrected_on(tribe: Person, on: Date) kind empirical {
    label en official "the failure (unpaid amounts or unposted bond) is corrected on this date";
}
pub relation tribe_service_treated_as_employment(service: WagePayment) kind institutional {
    label en official "the service for the tribe is not excepted from employment under section 3306(c)(7) on the date it is performed (between the failure and its correction)";
}
rule S3309dServiceTreatedAsEmploymentUncorrected defeasible {
    label en official "service after the failure date when the failure is uncorrected";
    for service: WagePayment;
    for tribe: Person;
    for from: Date;
    for on: Date;
    when wage_payment(service, tribe, _, _, _, on)
        and tribe_service_not_excepted_from_employment_from(tribe, from)
        and on >= from
        and not_known(tribe_failure_corrected_on_exists(tribe));
    then tribe_service_treated_as_employment(service);
}
rule S3309dServiceTreatedAsEmploymentBeforeCorrection defeasible {
    label en official "service after the failure date and before the correction";
    for service: WagePayment;
    for tribe: Person;
    for from: Date;
    for on: Date;
    for correctedOn: Date;
    when wage_payment(service, tribe, _, _, _, on)
        and tribe_service_not_excepted_from_employment_from(tribe, from)
        and tribe_failure_corrected_on(tribe, correctedOn)
        and on >= from
        and on < correctedOn;
    then tribe_service_treated_as_employment(service);
}
relation tribe_failure_corrected_on_exists(tribe: Person) kind institutional;
rule TribeFailureCorrectedOnExists defeasible {
    for tribe: Person;
    for on: Date;
    when tribe_failure_corrected_on(tribe, on);
    then tribe_failure_corrected_on_exists(tribe);
}
