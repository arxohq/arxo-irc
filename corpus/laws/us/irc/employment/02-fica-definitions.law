// Chapter 21 (FICA), section 3121 — definitions. Stage 1 scope (task
// instruction): subsections (a) wages, (b) employment, (d) employee, (q)
// tips, (v) nonqualified deferred compensation, (x) applicable dollar
// threshold. Subsections (c),(e)-(p),(r),(s),(t)-(z) are NOT named in this
// stage's scope and stay `unreviewed` (stage 2) even though they sit inside
// section 3121 — see coverage notes.
//
// CORRECTION TO THE TASK'S OWN DESCRIPTION: the task text describes
// "(x) contribution and benefit base" — the actual pinned 2024-Edition text
// of section 3121(x) is "Applicable dollar threshold" (the $1,000 domestic-
// service-computed-to-the-nearest-dollar threshold of section 3121(i)(1)/
// (a)(7)(B), SSA-indexed after 1995). The "contribution and benefit base" is
// itself only a CROSS-REFERENCE inside section 3121(a)(1) to section 230 of
// the Social Security Act; it is not its own lettered subsection of section
// 3121 in current law. Both are modelled: the actual (x) below, and the
// contribution-and-benefit-base SOURCE_GAP relation in `01-fica-tax.law`
// (declared where it is used, i.e. inside the wage-base cap rule).


use self::{
    IRC_S3121_A,
    IRC_S3121_B,
    IRC_S3121_C,
    IRC_S3121_D,
    IRC_S3121_E,
    IRC_S3121_F,
    IRC_S3121_H,
    IRC_S3121_I,
    IRC_S3121_J,
    IRC_S3121_L,
    IRC_S3121_M,
    IRC_S3121_O,
    IRC_S3121_P,
    IRC_S3121_Q,
    IRC_S3121_R,
    IRC_S3121_S,
    IRC_S3121_U,
    IRC_S3121_V,
    IRC_S3121_W,
    IRC_S3121_Y,
    IRC_S3121_Z,
    Person,
    TaxableYear,
    WagePayment,
    section_3121u2_exception_any,
    wage_payment,
    wages_computed_specially_3121i,
};

// --- Section 3121(a): wages, and its 24-item exclusion list -----------------
//
// Method (mirrors `us.irc.gross_income::GrossIncomeItemKind`, s61): the 24
// exclusion paragraphs are themselves the classification — a case fact that a
// `WagePayment` falls under one of these kinds IS the section 3121(a)
// exclusion; no further per-paragraph rule is needed (a rule whose head and
// body would be the same predicate is a dependency cycle the engine rejects,
// LDC-E4102). Item (3) and a clause of (9)/(17) were repealed by Pub. L.
// 98-21 and are omitted (REPEALED_OR_RESERVED, non_normative in coverage).
// Each item's own internal sub-tests (e.g. item (5)'s six sub-clauses on the
// nature of the disability payment, item (13) domestic-service $150
// thresholds) are NOT separately re-derived: the classification is asserted
// at the paragraph level, as section 61 does for its fourteen items. Detailed
// sub-clause conditions are TECH_GAP where a scenario needs to distinguish
// them (recorded per-row in coverage, not silently collapsed).
pub enum WageExclusionKind {
    Section3121A1SuccessorEmployerAggregation; // (1) — handled separately (wage-base cap, 01-fica-tax.law); listed for completeness, not asserted as an exclusion ITEM
    Section3121A2PlanSicknessOrDeathPayment;   // (2) employer plan/system payment on sickness, accident disability, medical/hospitalization, or death
    Section3121A4SicknessDisabilityAfter6Months; // (4) sickness/accident disability payment after 6 calendar months following last month worked
    Section3121A5RetirementOrDisabilityTrustPayment; // (5) qualified trust/annuity/SEP/403(b)/govt deferred comp/supplemental pension payment
    Section3121A6EmployerPaidEmployeeTax;      // (6) employer pays employee's share of tax without deduction (certain domestic/agricultural service)
    Section3121A7NoncashRemuneration;          // (7)(A) noncash remuneration for service not in employer's trade/business or domestic service
    Section3121A8NoncashAgriculturalLabor;     // (8)(A) noncash remuneration for agricultural labor
    Section3121A10HomeWorkerUnder100;          // (10) home worker (3121(d)(3)(C)) paid cash under $100 in the year
    Section3121A11Section217MovingExpense;     // (11) reimbursement reasonably believed deductible under section 217
    Section3121A12NoncashTips;                 // (12)(A) tips paid in a medium other than cash
    Section3121A13SeriesOfPaymentsOnTermination; // (13) series of payments on account of retirement for disability, or under a plan on termination
    Section3121A14PostDeathPaymentToSurvivor;  // (14) payment to a survivor or estate after the calendar year of the employee's death
    Section3121A15DisabilityInsuranceBeneficiary; // (15) payment to an employee already entitled to SSA disability benefits, no services performed
    Section3121A16ExemptOrganizationUnder100;  // (16) section 501(a)/521 exempt organization pays under $100 in the year for the service
    Section3121A18DependentCareEtcExclusion;   // (18) reasonably believed excludable under section 127, 129, 134(b)(4), or 134(b)(5)
    Section3121A19MealsOrLodging;              // (19) reasonably believed excludable under section 119
    Section3121A20FringeBenefitExclusion;      // (20) reasonably believed excludable under section 74(c), 108(f)(4), 117, or 132
    Section3121A21IndianFishingRightsIncome;   // (21) member of an Indian tribe, income from exercise of fishing rights (section 7873)
    Section3121A23Section139BExclusion;        // (23) benefit or payment excludable under section 139B(a)
}

pub relation wage_exclusion_item_3121a(pay: WagePayment, kind: WageExclusionKind, amount: Money) kind empirical {
    label en official "an item excluded from wages under one of the paragraphs of section 3121(a), asserted by the case with the excluded amount";
}

relation wage_partly_excluded_3121a(pay: WagePayment) kind institutional {
    label en unofficial "at least one section 3121(a) exclusion item is asserted for this wage payment";
}
rule WagePartlyExcluded3121a(pay: WagePayment, kind: WageExclusionKind, amount: Money) strict {
    when wage_exclusion_item_3121a(pay, kind, amount);
    then wage_partly_excluded_3121a(pay);
}

pub relation wage_exclusion_total_3121a(pay: WagePayment, amount: Money) kind institutional {
    label en unofficial "sum of all section 3121(a) excluded amounts asserted for this wage payment";
}
rule WageExclusionTotal3121a(pay0: WagePayment, kind0: WageExclusionKind, amount0: Money) strict {
    when wage_exclusion_item_3121a(pay0, kind0, amount0);
    then wage_exclusion_total_3121a(pay0,
        sum all amount: Money for kind: WageExclusionKind where wage_exclusion_item_3121a(pay0, kind, amount));
}

@source(IRC_S3121_A, relation = formalizes, coverage = partial, quote = "the term \"wages\" means all remuneration for employment, including the cash value of all remuneration (including benefits) paid in any medium other than cash; except that such term shall not include")
pub relation wages_3121(pay: WagePayment, amount: Money) kind institutional {
    label en official "the amount of a wage payment that is \"wages\" within the meaning of section 3121(a)";
}
rule Wages3121NoExclusion(pay: WagePayment, employer: Person, employee: Person, y: TaxableYear, amount: Money) strict {
    when wage_payment(pay, employer, employee, y, amount, _) and not_known(wage_partly_excluded_3121a(pay)) and not_known(wages_computed_specially_3121i(pay));
    then wages_3121(pay, amount);
}
rule Wages3121WithExclusion(pay: WagePayment, employer: Person, employee: Person, y: TaxableYear, gross: Money, excluded: Money) strict {
    when wage_payment(pay, employer, employee, y, gross, _) and wage_exclusion_total_3121a(pay, excluded) and gross > excluded and not_known(wages_computed_specially_3121i(pay));
    then wages_3121(pay, gross - excluded);
}
// gross <= excluded: zero wages remain under section 3121(a); no rule fires
// (mirrors the OASDI-cap "absence is zero" reading in `01-fica-tax.law`).

// --- Section 3121(b): employment, and its exclusion list --------------------
//
// "Employment" classifies SERVICE (not a wage payment); a `WagePayment`'s
// underlying service is asserted separately because a single payment can
// cover a period during which the section 3121(c) included/excluded-service
// pay-period test would matter (section 3121(c) is NOT in this stage's
// scope: TECH_GAP/stage 2 — this package treats each `WagePayment` as either
// wholly for "employment" or not, without the pay-period aggregation rule).
pub enum EmploymentExclusionKind {
    Section3121B1ForeignAgriculturalWorker;     // (1) H-2A-predecessor foreign agricultural workers from the Bahamas/Jamaica/BWI or elsewhere
    Section3121B2CollegeClubDomesticStudent;    // (2) domestic service in a local college club/fraternity/sorority by an enrolled student
    Section3121B3ChildUnder18ForParent;         // (3)(A) child under 18 in the employ of a parent
    Section3121B4NonAmericanVesselOrAircraft;   // (4) service on/in connection with a non-American vessel/aircraft outside the US by a non-citizen or non-American employer
    Section3121B5FederalServiceCategoryOne;     // (5) US/instrumentality service meeting the (5) tests
    Section3121B6FederalServiceCategoryTwo;     // (6) US/instrumentality service meeting the (6) tests
    Section3121B7StateOrPoliticalSubdivision;   // (7) State/political-subdivision service (subject to its own exceptions)
    Section3121B8MinisterOrReligiousOrder;      // (8)(A) minister/religious-order duties (unless a section 3121(r) election is in effect)
    Section3121B9RailroadEmployeeOrRepresentative; // (9) RRTA employee/employee representative under section 3231
    Section3121B10FederalInstrumentalityCategory; // (10) service in the employ of the enumerated federal instrumentalities
    Section3121B11ForeignGovernment;            // (11) foreign government employ
    Section3121B12ForeignGovernmentInstrumentality; // (12) instrumentality wholly owned by a foreign government
    Section3121B13StudentNurse;                 // (13) student nurse in a hospital/nurses' training school
    Section3121B14NewspaperDeliveryUnder18;     // (14)(A) individual under 18 delivering newspapers/shopping news
    Section3121B15InternationalOrganization;    // (15) international organization employ (except section 3121(y) transferred service)
    Section3121B16LandTenantArrangement;        // (16) crop-share arrangement with the owner/tenant of land
    Section3121B18GuamPhilippineResident;       // (18) Guam service by a Republic of the Philippines resident (nonimmigrant H-2 predecessor)
    Section3121B19NonresidentAlienFJMQVisa;     // (19) nonresident alien on an F/J/M/Q visa performing the purpose of that visa
    Section3121B20FishingBoatCrew;              // (20) fishing-boat crew arrangement (other than the (3)(A) child exception)
    Section3121B21DomesticServicePrivateHome;   // (21) domestic service in a private home meeting the (21) conditions
    Section3121B22IndianTribalCouncilMember;    // (22) Indian tribal council member service (unless covered by a section 218A agreement)
}

pub relation employment_exclusion_item_3121b(service: WagePayment, kind: EmploymentExclusionKind) kind empirical {
    label en official "service excluded from \"employment\" under one of the paragraphs of section 3121(b), asserted by the case (keyed to the WagePayment compensating the service, for lack of a separate Service entity in this stage)";
}

@source(IRC_S3121_B, relation = formalizes, coverage = partial, quote = "the term \"employment\" means any service, of whatever nature, performed")
pub relation employment_3121(service: WagePayment) kind institutional {
    label en official "the underlying service of this wage payment is \"employment\" within the meaning of section 3121(b)";
}
rule Employment3121(service: WagePayment) strict {
    when wage_payment(service, _, _, _, _, _) and not_known(employment_exclusion_item_3121b_exists(service));
    then employment_3121(service);
}
relation employment_exclusion_item_3121b_exists(service: WagePayment) kind institutional {
    label en unofficial "existence flag for `employment_exclusion_item_3121b`, so its absence can be tested with `not_known` (§67) rather than `not` over a wildcard-argument fact (LDC-E0207)";
}
rule EmploymentExclusionItem3121bExists(service: WagePayment, kind: EmploymentExclusionKind) strict {
    when employment_exclusion_item_3121b(service, kind);
    then employment_exclusion_item_3121b_exists(service);
}
// An asserted `employment_exclusion_item_3121b` makes `employment_3121` not
// derivable for that payment (NEITHER on a query, not a negative fact) —
// consistent with "absence of a record is not_known(X), not not X": here the
// EXCLUSION is the positive case fact, and non-employment is its absence-of-
// derivation, which is the correct reading for a closed exclusion list.

// --- Section 3121(d): employee -----------------------------------------------
//
// Three tests: (1) corporate officer (classification), (2) common-law
// employee (DECISION-0194 evaluative channel — "usual common law rules" is
// exactly the kind of standard the decision assigns to an external-judgment
// or adjudicated-fact channel, never a flat case fact), (3) four named
// statutory-employee categories subject to the "substantially all personally"
// and "no substantial investment"/"not a single transaction" provisos, (4)
// section 218/218A Social Security Act agreement coverage.
pub enum EmployeeKind {
    CorporateOfficer;               // (1)
    CommonLawEmployee;              // (2)
    StatutoryAgentOrCommissionDriver; // (3)(A)
    StatutoryFullTimeLifeInsuranceSalesman; // (3)(B)
    StatutoryHomeWorker;             // (3)(C)
    StatutoryTravelingOrCitySalesman; // (3)(D)
    Section218AgreementCoveredIndividual; // (4)
}

@source(IRC_S3121_D, relation = formalizes, coverage = partial, quote = "any officer of a corporation")
pub relation employee_3121(p: Person, kind: EmployeeKind) kind institutional {
    label en official "this person is an \"employee\" within the meaning of section 3121(d), and under which paragraph";
}
rule Employee3121CorporateOfficer(p: Person) strict {
    when corporate_officer(p);
    then employee_3121(p, CorporateOfficer);
}
relation corporate_officer(p: Person) kind empirical {
    label en unofficial "this person holds an office of a corporation (case fact)";
}

// (2) common-law employee: DECISION-0194 evaluative channel. "Usual common
// law rules applicable in determining the employer-employee relationship" is
// a multi-factor standard (right to control, etc.) this package does not
// re-derive from primitive facts; it is an external-judgment relation (the
// Secretary/a court applying the common-law test) or an adjudicated fact.
relation common_law_employee_determination(p: Person, by: us.irc.core::Organ, result: Boolean) kind empirical {
    label en unofficial "DECISION-0194 channel: an external judgment (Secretary or court) applying the common-law control test to this person, asserted by the case with its result — never a flat case fact substituting for the multi-factor test itself";
}
rule Employee3121CommonLaw(p: Person, by: us.irc.core::Organ) strict {
    when common_law_employee_determination(p, by, true);
    then employee_3121(p, CommonLawEmployee);
}

// (3) statutory employees: each category requires, IN ADDITION to the
// enumerated occupation, that "the contract of service contemplates that
// substantially all of such services are to be performed personally by such
// individual" and the individual lacks a substantial investment in
// facilities (other than transportation) and the services are not a single
// transaction outside a continuing relationship. Modelled as a compound
// classification: the occupation test (case fact per category) AND the two
// provisos (case facts), consistent with the "no substantial investment /
// not a single transaction" EXCEPTION being a positive predicate + `unless`.
relation statutory_employee_occupation(p: Person, kind: EmployeeKind) kind empirical {
    label en unofficial "this person performs services in one of the four section 3121(d)(3) occupational categories (case fact)";
}
relation statutory_employee_personal_service_contract(p: Person) kind empirical {
    label en unofficial "the contract of service contemplates substantially all services performed personally by this individual (section 3121(d)(3) chapeau, case fact)";
}
relation statutory_employee_substantial_investment(p: Person) kind empirical {
    label en unofficial "this individual has a substantial investment in facilities used in the services (other than transportation facilities) — section 3121(d)(3) exception, case fact";
}
relation statutory_employee_single_transaction(p: Person) kind empirical {
    label en unofficial "the services are in the nature of a single transaction not part of a continuing relationship — section 3121(d)(3) exception, case fact";
}
rule Employee3121Statutory(p: Person, kind: EmployeeKind) defeasible {
    when statutory_employee_occupation(p, kind) and statutory_employee_personal_service_contract(p);
    then employee_3121(p, kind);
    unless statutory_employee_substantial_investment(p) and statutory_employee_occupation(p, kind);
    unless statutory_employee_single_transaction(p) and statutory_employee_occupation(p, kind);
}

// (4) section 218/218A agreement coverage.
relation section_218_agreement_covers(p: Person) kind empirical {
    label en unofficial "this individual's services are included under a section 218 or 218A Social Security Act agreement (case fact; EXTERNAL_DEPENDENCY — agreement terms are a Social Security Administration/State record, not IRC text)";
}
rule Employee3121Section218(p: Person) strict {
    when section_218_agreement_covers(p);
    then employee_3121(p, Section218AgreementCoveredIndividual);
}

// --- Section 3121(q): tips included for both employee and employer taxes ---

pub relation tip_reported(pay: WagePayment, amount: Money, on: Date) kind empirical {
    label en official "tips reported by the employee to the employer under section 6053(a) with respect to a wage payment period (case fact)";
}
@source(IRC_S3121_Q, relation = formalizes, coverage = partial, quote = "tips received by an employee in the course of his employment shall be considered remuneration for such employment (and deemed to have been paid by the employer for purposes of subsections (a) and (b) of section 3111)")
rule TipsAreWages3121(pay: WagePayment, amount: Money, on: Date) strict {
    when tip_reported(pay, amount, on);
    then wage_exclusion_item_3121a(pay, Section3121A12NoncashTips, 0.00 USD);
    // NOTE: this rule does not itself add the tip amount into `wages_3121`;
    // it documents that reported CASH tips are wages (the exclusion item
    // above covers only NONCASH tips). TECH_GAP: a full model would assert
    // `wage_payment` for the tip amount directly (deemed paid at the section
    // 6053(a) statement date) rather than reusing the wage-exclusion
    // relation as a no-op; recorded as a modelling shortcut in coverage.
}

// --- Section 3121(v): nonqualified deferred compensation --------------------

pub relation nonqualified_deferred_compensation_plan(plan: us.irc.core::Person) kind empirical {
    label en unofficial "placeholder key for a deferred compensation arrangement (this package has no separate Plan entity yet; case facts key by the employer/plan sponsor Person) — TECH_GAP: a real `Plan` entity belongs in a shared package, not invented here";
}
pub relation deferred_amount(pay: WagePayment, amount: Money, services_performed_on: Date, no_substantial_risk_of_forfeiture_on: Date) kind empirical {
    label en official "an amount deferred under a nonqualified deferred compensation plan, with the two section 3121(v)(2)(A) trigger dates (case fact)";
}
@source(IRC_S3121_V, relation = formalizes, coverage = partial, quote = "Any amount deferred under a nonqualified deferred compensation plan shall be taken into account for purposes of this chapter as of the later of")
rule NonqualifiedDeferredCompensationTakenIntoAccount(pay: WagePayment, amount: Money, servicesOn: Date, forfeitureOn: Date) strict {
    when deferred_amount(pay, amount, servicesOn, forfeitureOn) and servicesOn >= forfeitureOn;
    then deferred_compensation_taken_into_account_on(pay, amount, servicesOn);
}
rule NonqualifiedDeferredCompensationTakenIntoAccountLater(pay: WagePayment, amount: Money, servicesOn: Date, forfeitureOn: Date) strict {
    when deferred_amount(pay, amount, servicesOn, forfeitureOn) and forfeitureOn > servicesOn;
    then deferred_compensation_taken_into_account_on(pay, amount, forfeitureOn);
}
pub relation deferred_compensation_taken_into_account_on(pay: WagePayment, amount: Money, on: Date) kind institutional {
    label en official "the date section 3121(v)(2)(A) treats deferred compensation as wages (the later of when services are performed or when there is no substantial risk of forfeiture)";
}
// "taxed only once" (v)(2)(B): an immunity of the amount already taken into
// account against being taken into account again — TECH_GAP: requires a
// running "already counted" ledger across payments, the self-referential
// pattern flagged as LDC-E4102-adjacent in AGENT-BRIEF; not modelled, noted
// in coverage on section 3121(v)(2)(B).

// --- Section 3121(x): applicable dollar threshold ---------------------------
//
// See file header: this is the ACTUAL text of (x) (not the contribution and
// benefit base). $1,000 statutory base for the section 3121(a)(7)(B)/(i)(1)
// domestic-service computed-to-the-nearest-dollar exception; SSA-indexed
// after 1995 by the same mechanism as the FICA wage base, so the INDEXED
// value for any year after 1995 is a SOURCE_GAP (no Rev. Proc./SSA
// determination pinned in this package's text).
pub relation applicable_dollar_threshold_3121x(y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the section 3121(x) applicable dollar threshold for this calendar year — $1,000 is the statutory 1994 base (case fact for 1994; SOURCE_GAP for any later year's SSA-indexed amount, never invented here)";
}

// --- Alias matching the task's own pub-interface name -----------------------

pub relation statutory_employee(p: Person, kind: EmployeeKind) kind institutional {
    label en unofficial "this person is one of the four section 3121(d)(3) statutory-employee categories — alias of `employee_3121` restricted to the (d)(3) kinds, named to match the task's own pub-interface list literally";
}
rule StatutoryEmployeeAliasAgentDriver(p: Person) defeasible {
    when employee_3121(p, StatutoryAgentOrCommissionDriver);
    then statutory_employee(p, StatutoryAgentOrCommissionDriver);
}
rule StatutoryEmployeeAliasLifeInsurance(p: Person) defeasible {
    when employee_3121(p, StatutoryFullTimeLifeInsuranceSalesman);
    then statutory_employee(p, StatutoryFullTimeLifeInsuranceSalesman);
}
rule StatutoryEmployeeAliasHomeWorker(p: Person) defeasible {
    when employee_3121(p, StatutoryHomeWorker);
    then statutory_employee(p, StatutoryHomeWorker);
}
rule StatutoryEmployeeAliasTravelingSalesman(p: Person) defeasible {
    when employee_3121(p, StatutoryTravelingOrCitySalesman);
    then statutory_employee(p, StatutoryTravelingOrCitySalesman);
}

// =============================================================================
// Stage 2b: remaining section 3121 subsections (c),(e),(f),(h),(i),(j),(k),
// (l),(m),(n),(o),(p),(r),(s),(t),(u),(w),(y),(z). Method per each subsection
// below; TECH_GAP noted inline where a sub-clause is a compound historical/
// bureaucratic test this package folds into a case fact rather than
// re-deriving.
// =============================================================================

// --- Section 3121(c): included and excluded service (majority-of-pay-period
// rule) --------------------------------------------------------------------
//
// This is a MODIFIER of the section 3121(b) employment classification: if a
// majority of the pay period's service is employment, ALL of it is deemed
// employment; if a majority is not employment, NONE of it is. The majority
// determination itself (comparing employment vs. non-employment portions of
// a pay period) is a case fact — deriving it would need a finer Service/
// pay-period entity this package does not have (TECH_GAP, noted below); the
// RULE APPLYING a case-asserted majority is executable.
pub relation pay_period_majority_is_employment(service: WagePayment, majorityIsEmployment: Boolean) kind empirical {
    label en unofficial "case fact: whether a majority of the section 3121(c) pay period covering this wage payment's underlying service constitutes \"employment\" (the majority computation itself, over the period's individual portions of service, is TECH_GAP — this package has no finer Service/pay-period entity to derive it from)";
}
pub relation employment_3121_pay_period_deemed(service: WagePayment) kind institutional {
    label en official "section 3121(c): because a majority of the pay period is employment, ALL the service in that pay period is deemed employment (overrides the ordinary section 3121(b) per-service classification for the whole period)";
}
@source(IRC_S3121_C, relation = formalizes, coverage = partial, quote = "if the services performed during one-half or more of any pay period by an employee for the person employing him constitute employment, all the services of such employee for such period shall be deemed to be employment")
rule Section3121CMajorityEmployment(service: WagePayment) strict {
    when pay_period_majority_is_employment(service, true) and not_known(pay_period_excepted_by_3121b9(service));
    then employment_3121_pay_period_deemed(service);
}
relation pay_period_excepted_by_3121b9(service: WagePayment) kind empirical {
    label en unofficial "section 3121(c)'s own carve-out: this pay period includes RRTA service excepted by section 3121(b)(9), so the majority rule does not apply at all (case fact)";
}
// The minority branch ("none of the services...shall be deemed to be
// employment") is the absence of a rule producing `employment_3121_pay_period_deemed`
// for that service — consistent with this package's closed-exclusion-list
// convention (absence of derivation, not an asserted negative).

// --- Section 3121(e): State, United States, and citizen --------------------
//
// Pure geographic/citizenship VOCABULARY: the five named jurisdictions (DC,
// Puerto Rico, Virgin Islands, Guam, American Samoa) are declared for
// documentation, but this package has no separate `State`/`UnitedStates`
// type whose membership a rule elsewhere tests — every other rule in this
// package already treats "United States" service/residency as a bare case
// fact (e.g. `american_employer`, below). NON_NORMATIVE: no independent
// computable test beyond the vocabulary itself.
pub enum Section3121EJurisdiction { DistrictOfColumbia; PuertoRico; VirginIslands; Guam; AmericanSamoa; }
relation citizen_of_puerto_rico(p: Person) kind empirical {
    label en unofficial "this person is a citizen of the Commonwealth of Puerto Rico but not otherwise a citizen of the United States (case fact)";
}
pub relation treated_as_citizen_of_united_states_3121e(p: Person) kind institutional {
    label en official "section 3121(e)(2) second sentence: a citizen of Puerto Rico (only) is considered a citizen of the United States for purposes of this section";
}
@source(IRC_S3121_E, relation = formalizes, coverage = exact, quote = "An individual who is a citizen of the Commonwealth of Puerto Rico (but not otherwise a citizen of the United States) shall be considered, for purposes of this section, as a citizen of the United States.")
rule Section3121ECitizenOfPuertoRicoTreatedAsUsCitizen(p: Person) strict {
    when citizen_of_puerto_rico(p);
    then treated_as_citizen_of_united_states_3121e(p);
}

// --- Section 3121(f): American vessel and aircraft --------------------------

pub enum VesselOrAircraftKind { Vessel; Aircraft; }
relation documented_or_numbered_under_us_law(v: Person) kind empirical {
    label en unofficial "this vessel is documented or numbered under the laws of the United States (case fact; keyed by `Person` for lack of a separate Vessel entity in this package)";
}
relation documented_under_foreign_law(v: Person) kind empirical {
    label en unofficial "this vessel is documented under the laws of a foreign country (case fact)";
}
relation crew_employed_solely_by_us_persons(v: Person) kind empirical {
    label en unofficial "this vessel's crew is employed solely by one or more US citizens/residents or US-or-State-organized corporations (case fact)";
}
relation registered_under_us_law(a: Person) kind empirical {
    label en unofficial "this aircraft is registered under the laws of the United States (case fact)";
}
pub relation american_vessel_or_aircraft(v: Person, kind: VesselOrAircraftKind) kind institutional {
    label en official "this vessel or aircraft is \"American\" within the meaning of section 3121(f)";
}
@source(IRC_S3121_F, relation = formalizes, coverage = partial, quote = "the term \"American vessel\" means any vessel documented or numbered under the laws of the United States")
rule Section3121FVesselDocumented(v: Person) strict {
    when documented_or_numbered_under_us_law(v);
    then american_vessel_or_aircraft(v, Vessel);
}
@source(IRC_S3121_F, relation = formalizes, coverage = partial, quote = "includes any vessel which is neither documented or numbered under the laws of the United States nor documented under the laws of any foreign country, if its crew is employed solely by one or more citizens or residents of the United States or corporations organized under the laws of the United States or of any State")
rule Section3121FVesselUndocumentedUsCrewed(v: Person) strict {
    when not_known(documented_or_numbered_under_us_law_exists(v))
        and not_known(documented_under_foreign_law_exists(v))
        and crew_employed_solely_by_us_persons(v);
    then american_vessel_or_aircraft(v, Vessel);
}
relation documented_or_numbered_under_us_law_exists(v: Person) kind institutional;
rule DocumentedOrNumberedUnderUsLawExists(v: Person) strict {
    when documented_or_numbered_under_us_law(v);
    then documented_or_numbered_under_us_law_exists(v);
}
relation documented_under_foreign_law_exists(v: Person) kind institutional;
rule DocumentedUnderForeignLawExists(v: Person) strict {
    when documented_under_foreign_law(v);
    then documented_under_foreign_law_exists(v);
}
@source(IRC_S3121_F, relation = formalizes, coverage = exact, quote = "the term \"American aircraft\" means an aircraft registered under the laws of the United States")
rule Section3121FAircraft(a: Person) strict {
    when registered_under_us_law(a);
    then american_vessel_or_aircraft(a, Aircraft);
}

// --- Section 3121(h): American employer -------------------------------------

pub enum AmericanEmployerBasis { UnitedStatesOrInstrumentality; ResidentIndividual; MajorityResidentPartnership; AllResidentTrustees; UsOrStateCorporation; }
relation united_states_or_instrumentality(p: Person) kind empirical;
relation resident_individual_us(p: Person) kind empirical;
relation partnership_majority_us_resident_partners(p: Person) kind empirical;
relation trust_all_trustees_us_resident(p: Person) kind empirical;
relation corporation_organized_under_us_or_state_law(p: Person) kind empirical;
pub relation american_employer(p: Person, basis: AmericanEmployerBasis) kind institutional {
    label en official "this person is an \"American employer\" within the meaning of section 3121(h), and under which basis";
}
@source(IRC_S3121_H, relation = formalizes, coverage = exact, quote = "the term \"American employer\" means an employer which is")
rule AmericanEmployerUS(p: Person) strict { when united_states_or_instrumentality(p); then american_employer(p, UnitedStatesOrInstrumentality); }
rule AmericanEmployerResidentIndividual(p: Person) strict { when resident_individual_us(p); then american_employer(p, ResidentIndividual); }
rule AmericanEmployerPartnership(p: Person) strict { when partnership_majority_us_resident_partners(p); then american_employer(p, MajorityResidentPartnership); }
rule AmericanEmployerTrust(p: Person) strict { when trust_all_trustees_us_resident(p); then american_employer(p, AllResidentTrustees); }
rule AmericanEmployerCorporation(p: Person) strict { when corporation_organized_under_us_or_state_law(p); then american_employer(p, UsOrStateCorporation); }

// --- Section 3121(i): computation of wages in certain cases -----------------
//
// (1) Domestic service: the section 3121(a)(7)(B)/(i)(1) nearest-dollar
// rounding rule — a REAL computation (round-half-up to the nearest dollar).
pub relation domestic_service_cash_remuneration(pay: WagePayment, amount: Money) kind empirical {
    label en official "cash remuneration for domestic service described in section 3121(a)(7)(B), before the section 3121(i)(1) nearest-dollar rounding (case fact)";
}
pub relation domestic_service_wages_rounded_3121i1(pay: WagePayment, amount: Money) kind institutional {
    label en official "the section 3121(i)(1) nearest-whole-dollar amount deemed to be cash remuneration for section 3121(a)(7)(B) purposes";
}
@source(IRC_S3121_I, relation = formalizes, coverage = exact, quote = "the payment of a fractional part of a dollar shall be disregarded unless it amounts to one-half dollar or more, in which case it shall be increased to $1")
rule Section3121I1Rounding(pay: WagePayment, amount: Money) strict {
    when domestic_service_cash_remuneration(pay, amount);
    then domestic_service_wages_rounded_3121i1(pay, round(amount, 0, "HALF_UP"));
}
// (2) Service in the uniformed services, (3) Peace Corps volunteer service:
// each is its own remuneration-computation rule for a case-restricted class
// of individuals; modelled as a direct case-fact pass-through (this package
// has no `us.irc.core` Title-37/Peace-Corps-Act pay-component breakdown to
// compute FROM) — TECH_GAP for deriving the amount itself, but the SCOPING
// rule (only these components count) is recorded.
pub relation uniformed_service_basic_pay_or_206a_compensation(pay: WagePayment, amount: Money) kind empirical {
    label en unofficial "case fact: the individual's basic pay (37 U.S.C. ch. 3/1009) or section 206(a) compensation for uniformed-service duty under section 3121(m)(1) — the ONLY component of remuneration counted as wages for this service (section 3121(i)(2)); other components (e.g. allowances) are excluded by omission, not by a separate exclusion rule";
}
pub relation peace_corps_5c_or_61_payment(pay: WagePayment, amount: Money) kind empirical {
    label en unofficial "case fact: amounts paid to a Peace Corps volunteer/leader pursuant to section 5(c) or 6(1) of the Peace Corps Act — the ONLY component counted as wages for section 3121(p) service (section 3121(i)(3))";
}
// (4) Members of religious orders (subsection (r) election in effect): the
// fair market value of board/lodging/clothing/perquisites, floored at $100/
// month — a real computation, reusing the section 3121(r) election below.
pub relation religious_order_perquisites_fmv(pay: WagePayment, member: Person, amount: Money) kind empirical {
    label en official "case fact: the fair market value of board, lodging, clothing, and other perquisites furnished to this religious-order member for the month";
}
pub relation religious_order_member_wages_3121i4(pay: WagePayment, member: Person, amount: Money) kind institutional {
    label en official "section 3121(i)(4): remuneration for a religious-order member's duties, when a section 3121(r) election is in effect for the order — the fair market value of perquisites, but never less than $100/month";
}
@source(IRC_S3121_I, relation = formalizes, coverage = partial, quote = "the amount included as such individual's remuneration under this paragraph shall not be less than $100 a month")
rule Section3121I4AtLeastStatutoryFloor(pay: WagePayment, member: Person, order: Person, amount: Money) strict {
    when religious_order_perquisites_fmv(pay, member, amount)
        and religious_order_election_in_effect(order, _)
        and religious_order_member_of(member, order)
        and amount >= 100.00 USD;
    then religious_order_member_wages_3121i4(pay, member, amount);
}
rule Section3121I4BelowStatutoryFloor(pay: WagePayment, member: Person, order: Person, amount: Money) strict {
    when religious_order_perquisites_fmv(pay, member, amount)
        and religious_order_election_in_effect(order, _)
        and religious_order_member_of(member, order)
        and amount < 100.00 USD;
    then religious_order_member_wages_3121i4(pay, member, 100.00 USD);
}
// (5) Retired justices/judges: an EXCLUSION (section 371(b) title 28
// payments received during the section 294 service period are not wages).
relation title28_section294_service(pay: WagePayment) kind empirical {
    label en unofficial "case fact: this payment is to an individual performing service under 28 U.S.C. 294 (assignment of retired justices/judges to active duty)";
}
relation title28_section371b_payment(pay: WagePayment) kind empirical {
    label en unofficial "case fact: this payment is a 28 U.S.C. 371(b) retirement payment received during the section 294 service period";
}
// TECH_GAP: section 3121(i)(5) has no dedicated `WageExclusionKind` member
// in this package's stage-1 enum, and a rule whose head restated
// `wage_exclusion_item_3121a` itself would be a self-consuming predicate
// cycle the engine rejects (LDC-E4102). Recorded as case facts
// (`title28_section294_service`, `title28_section371b_payment`) for
// completeness; NOT wired into the section 3121(a) exclusion classification
// this pass — a real fix needs its own enum member added to
// `WageExclusionKind` (a closed, already-published enum this pass avoids
// touching) rather than reusing an unrelated item.

// --- Section 3121(j): covered transportation service -----------------------
//
// A historical (pre-1951 transit-system-acquisition) test with a multi-
// branch general-retirement-system/mileage-formula structure. The (1)
// general rule and (2)/(3) branch conditions are modelled as case facts
// directly (TECH_GAP for deriving the acquisition-date/retirement-system
// sub-tests from primitive facts) — this subsection has essentially no
// remaining live fact pattern in 2024 (all triggering acquisitions predate
// 1951), so this package records the classification without re-deriving the
// historical test.
relation covered_transportation_service_case_fact(service: WagePayment) kind empirical {
    label en unofficial "case fact standing in for the whole section 3121(j) covered-transportation-service determination (TECH_GAP: the (1)-(4) acquisition-date/retirement-system/mileage sub-tests are not derived; this 1951-boundary provision has no live fact pattern for post-2024 wage payments in practice)";
}
pub relation covered_transportation_service(service: WagePayment) kind institutional {
    label en official "this service is \"covered transportation service\" within the meaning of section 3121(j)";
}
@source(IRC_S3121_J, relation = formalizes, coverage = contextual, quote = "all service performed in the employ of a State or political subdivision in connection with its operation of a public transportation system shall constitute covered transportation service")
rule Section3121JCoveredTransportationService(service: WagePayment) strict {
    when covered_transportation_service_case_fact(service);
    then covered_transportation_service(service);
}

// --- Section 3121(k): REPEALED (Pub. L. 98-21, 1983) -------------------------
// classification = NON_NORMATIVE / repealed_or_reserved.

// --- Section 3121(l): agreements with respect to foreign affiliates --------
//
// A POWER of the American employer (over the Secretary's agreement, per the
// original task instruction: "foreign affiliates agreement as a power"):
// the Secretary SHALL enter into the agreement at the employer's request,
// meeting the conditions of (1); the effect is that specified foreign-
// affiliate service becomes covered and the employer incurs the (1)(A)
// equivalent-tax payment obligation. (2)-(8) (effective period, no-
// termination-after-1989, overpayment adjustment, foreign-affiliate 10-
// percent-interest definition, separate-entity treatment, regulations) are
// TECH_GAP/NON_NORMATIVE detail this package does not separately re-derive.
pub relation foreign_affiliate_10_percent_interest(employer: Person, affiliate: Person) kind empirical {
    label en unofficial "case fact: this American employer has at least a 10-percent interest (voting stock or profits) in this foreign entity — section 3121(l)(6) (not separately derived from ownership-chain facts)";
}
pub relation section_3121l_agreement_requested(employer: Person, affiliate: Person, on: Date) kind empirical {
    label en unofficial "case fact: the American employer requested a section 3121(l) agreement covering this foreign affiliate";
}
pub relation section_3121l_agreement_in_effect(employer: Person, affiliate: Person) kind institutional {
    label en official "a section 3121(l) agreement covering this foreign affiliate is in effect (the power's effect)";
}
@source(IRC_S3121_L, relation = formalizes, coverage = partial, quote = "The Secretary shall, at the American employer's request, enter into an agreement")
rule Section3121LAgreementPower(employer: Person, affiliate: Person, on: Date) strict {
    when section_3121l_agreement_requested(employer, affiliate, on) and foreign_affiliate_10_percent_interest(employer, affiliate) and american_employer(employer, _);
    then power Section3121LForeignAffiliateAgreement {
        holder employer;
        over section_3121l_agreement_in_effect(employer, affiliate);
        exercise section_3121l_agreement_requested(employer, affiliate, on);
        valid_when foreign_affiliate_10_percent_interest(employer, affiliate);
        effect create(section_3121l_agreement_in_effect(employer, affiliate));
        window [on, infinity);
    };
}

// --- Section 3121(m): service in the uniformed services (inclusion) --------

pub enum UniformedServiceDutyKind { ActiveDuty; InactiveDutyTraining; }
relation uniformed_service_active_duty_not_leave_without_pay(p: Person) kind empirical;
relation uniformed_service_inactive_duty_training(p: Person) kind empirical;
pub relation uniformed_service_employment_3121m(p: Person, kind: UniformedServiceDutyKind) kind institutional {
    label en official "notwithstanding section 3121(b), this uniformed-service duty is \"employment\" under section 3121(m)";
}
@source(IRC_S3121_M, relation = formalizes, coverage = partial, quote = "service performed by an individual as a member of a uniformed service on active duty, but such term shall not include any such service which is performed while on leave without pay")
rule Section3121MActiveDuty(p: Person) strict { when uniformed_service_active_duty_not_leave_without_pay(p); then uniformed_service_employment_3121m(p, ActiveDuty); }
@source(IRC_S3121_M, relation = formalizes, coverage = exact, quote = "service performed by an individual as a member of a uniformed service on inactive duty training")
rule Section3121MInactiveDutyTraining(p: Person) strict { when uniformed_service_inactive_duty_training(p); then uniformed_service_employment_3121m(p, InactiveDutyTraining); }

// --- Section 3121(n): "member of a uniformed service" ----------------------
//
// A pure enumeration of who counts (active-duty branches, cadets, ROTC
// trainees, pre-induction candidates), with one carve-out (temporary Coast
// Guard Reserve). classification = NON_NORMATIVE (definitional vocabulary,
// not itself a rule of conduct); used as the eligibility class for section
// 3121(m) above, which IS executable.

// --- Section 3121(o): crew leader --------------------------------------------

relation furnishes_agricultural_laborers_and_pays_them(crewLeader: Person, forWhom: Person) kind empirical {
    label en unofficial "this individual furnishes individuals to perform agricultural labor for another person and pays them (case fact)";
}
relation designated_employee_by_written_agreement(crewLeader: Person, forWhom: Person) kind empirical {
    label en unofficial "this individual has entered into a written agreement designating them as an employee of the other person (section 3121(o) exception, case fact)";
}
pub relation crew_leader_3121o(crewLeader: Person, forWhom: Person) kind institutional {
    label en official "this individual is a \"crew leader\" within the meaning of section 3121(o), and is deemed NOT an employee of the other person with respect to this furnishing service";
}
@source(IRC_S3121_O, relation = formalizes, coverage = partial, quote = "such individual has not entered into a written agreement with such person whereby such individual has been designated as an employee of such person")
rule Section3121OCrewLeader(crewLeader: Person, forWhom: Person) strict {
    when furnishes_agricultural_laborers_and_pays_them(crewLeader, forWhom) and not designated_employee_by_written_agreement(crewLeader, forWhom);
    then crew_leader_3121o(crewLeader, forWhom);
}
pub relation crew_member_employee_of_crew_leader(worker: Person, crewLeader: Person) kind institutional {
    label en official "section 3121(o): an individual furnished by a crew leader to perform agricultural labor is deemed an employee of the crew leader (not of the person for whom the labor is performed)";
}
relation furnished_by_crew_leader(worker: Person, crewLeader: Person, forWhom: Person) kind empirical;
rule Section3121OCrewMemberIsEmployeeOfCrewLeader(worker: Person, crewLeader: Person, forWhom: Person) strict {
    when furnished_by_crew_leader(worker, crewLeader, forWhom) and crew_leader_3121o(crewLeader, forWhom);
    then crew_member_employee_of_crew_leader(worker, crewLeader);
}

// --- Section 3121(p): Peace Corps volunteer service (inclusion) ------------

relation peace_corps_volunteer_or_leader_service(p: Person) kind empirical;
pub relation peace_corps_employment_3121p(p: Person) kind institutional {
    label en official "notwithstanding section 3121(b), Peace Corps volunteer/leader service is \"employment\" under section 3121(p)";
}
@source(IRC_S3121_P, relation = formalizes, coverage = exact, quote = "the term \"employment\" shall, notwithstanding the provisions of subsection (b) of this section, include service performed by an individual as a volunteer or volunteer leader within the meaning of the Peace Corps Act")
rule Section3121PPeaceCorpsEmployment(p: Person) strict {
    when peace_corps_volunteer_or_leader_service(p);
    then peace_corps_employment_3121p(p);
}

// --- Section 3121(r): election of coverage by religious orders (power) -----

pub relation religious_order_vow_of_poverty(order: Person) kind empirical {
    label en unofficial "case fact: this religious order (or autonomous subdivision) requires its members to take a vow of poverty — section 3121(r)(1) eligibility gate";
}
pub relation religious_order_election_filed(order: Person, on: Date) kind empirical {
    label en official "case fact: this order (or subdivision) filed a section 3121(r) certificate of election";
}
pub relation religious_order_election_in_effect(order: Person, effectiveFrom: Date) kind institutional {
    label en official "a section 3121(r) election of coverage is in effect for this religious order (the power's effect); irrevocable per (1)(A)";
}
relation religious_order_member_of(member: Person, order: Person) kind empirical {
    label en unofficial "case fact: this individual is a member of this religious order (or subdivision), subject to a vow of poverty and performing usual member duties — section 3121(r)(2)";
}
@source(IRC_S3121_R, relation = formalizes, coverage = partial, quote = "may file a certificate (in such form and manner, and with such official, as may be prescribed by regulations under this chapter) electing to have the insurance system established by title II of the Social Security Act extended to services performed by its members")
rule Section3121RElectionPower(order: Person, on: Date) strict {
    when religious_order_election_filed(order, on) and religious_order_vow_of_poverty(order);
    then power Section3121RCoverageElection {
        holder order;
        over religious_order_election_in_effect(order, on);
        exercise religious_order_election_filed(order, on);
        valid_when religious_order_vow_of_poverty(order);
        effect create(religious_order_election_in_effect(order, on));
        window [on, infinity);
    };
}
// (3) effective-date quarter-boundary computation (current/succeeding/up-to-
// 20-quarters-preceding quarter) and (b) retroactive-filing due-date/
// limitations-period consequences: TECH_GAP, this package takes the
// effective date directly as the case-asserted `on` rather than deriving it
// from the filing date and the order's own designated boundary choice.

// --- Section 3121(s): concurrent employment by two or more employers,
//     common paymaster (FICA) ------------------------------------------------
//
// Shared with section 3231(i)'s RRTA counterpart in spirit, but each
// section names its OWN list of taxes affected (3102, 3111, 3121(a)(1) here;
// 3201, 3211, 3221 there) — kept as separate relations rather than a single
// cross-chapter one, per this package's convention of not silently
// conflating FICA and RRTA classifications on the same underlying fact.
relation related_corporations(a: Person, b: Person) kind empirical {
    label en unofficial "case fact: these two corporations are \"related\" for section 3121(s) purposes (the statute does not itself define \"related\" beyond the common-paymaster-designation act, so this package takes the relationship as a case fact rather than inventing a control test)";
}
pub relation common_paymaster_3121s(paymaster: Person, employers: Person, employee: Person) kind empirical {
    label en official "case fact: these related corporations (one of which, `paymaster`, is `employers`' common paymaster) compensate this individual through the common paymaster — section 3121(s)";
}
pub relation remuneration_disbursed_by(disburser: Person, employee: Person, amount: Money, on: Date) kind empirical {
    label en official "case fact: this corporation actually disbursed this amount to this individual on this date (section 3121(s) counts only what each corporation ACTUALLY disbursed, not the common paymaster's total)";
}
pub relation corporation_deemed_remuneration_3121s(corporation: Person, employee: Person, amount: Money, on: Date) kind institutional {
    label en official "section 3121(s): for sections 3102/3111/3121(a)(1) purposes, this related corporation is considered to have paid as remuneration to this individual ONLY the amount it actually disbursed";
}
@source(IRC_S3121_S, relation = formalizes, coverage = exact, quote = "each such corporation shall be considered to have paid as remuneration to such individual only the amounts actually disbursed by it to such individual")
rule Section3121SCommonPaymasterAttribution(paymaster: Person, employers: Person, employee: Person, disburser: Person, amount: Money, on: Date) strict {
    when common_paymaster_3121s(paymaster, employers, employee) and remuneration_disbursed_by(disburser, employee, amount, on);
    then corporation_deemed_remuneration_3121s(disburser, employee, amount, on);
}
// TECH_GAP: this rule records the ATTRIBUTION section 3121(s) requires, but
// this package's wage-base-cap (`prior_remuneration_paid`) and tax rules in
// `01-fica-tax.law` still aggregate by the single `employer` field of
// `wage_payment` — a case wanting the common-paymaster attribution to feed
// the wage-base cap itself would need `prior_remuneration_paid` rewritten to
// aggregate `corporation_deemed_remuneration_3121s` instead, not done here.

// --- Section 3121(t): REPEALED (Pub. L. 100-203, 1987) ----------------------
// classification = NON_NORMATIVE / repealed_or_reserved.

// --- Section 3121(u): application of hospital insurance tax to Federal,
//     State, and local employment ------------------------------------------
//
// (1) Federal employment: HI tax applies without regard to the section
// 3121(b)(5) federal-service exclusion — an override rule.
pub relation medicare_qualified_government_employment(service: WagePayment) kind institutional {
    label en official "section 3121(u)(3): this service is \"medicare qualified government employment\" — employment only because paragraphs (1)/(2) of section 3121(u) disregard the section 3121(b)(5)/(7) exclusions";
}
relation federal_service_excluded_only_by_3121b5(service: WagePayment) kind empirical {
    label en unofficial "case fact: this service would be excluded from employment ONLY by section 3121(b)(5) (federal service), and would otherwise qualify (section 3121(u)(1) override input)";
}
@source(IRC_S3121_U, relation = formalizes, coverage = partial, quote = "subsection (b) shall be applied without regard to paragraph (5) thereof")
rule Section3121U1FederalHiOverride(service: WagePayment) strict {
    when federal_service_excluded_only_by_3121b5(service);
    then medicare_qualified_government_employment(service);
}
// (2) State/local employment: same override for section 3121(b)(7), subject
// to the (B) enumerated-exceptions and (C) grandfather-clause carve-outs —
// each carve-out is its own case-fact guard rather than a re-derived test.
relation state_local_service_excluded_only_by_3121b7(service: WagePayment) kind empirical {
    label en unofficial "case fact: this service would be excluded from employment ONLY by section 3121(b)(7) (State/local service), and would otherwise qualify (section 3121(u)(2)(A) override input)";
}
relation section_3121u2b_exception_applies(service: WagePayment) kind empirical {
    label en unofficial "case fact: one of the section 3121(u)(2)(B) enumerated exceptions applies (section 218 agreement coverage, unemployment-relief work, patient/inmate service, temporary emergency service, certain DC hospital interns, section 1402(c)(2)(E) positions, or a sub-threshold election worker) — TECH_GAP, folded into one case fact rather than six separately classified sub-exceptions";
}
relation section_3121u2c_grandfather_applies(service: WagePayment) kind empirical {
    label en unofficial "case fact: the section 3121(u)(2)(C) pre-April-1986 continuing-employment grandfather clause applies to this service";
}
@source(IRC_S3121_U, relation = formalizes, coverage = partial, quote = "Except as provided in subparagraphs (B) and (C), subsection (b) shall be applied without regard to paragraph (7) thereof")
rule Section3121U2StateLocalHiOverride(service: WagePayment) strict {
    when state_local_service_excluded_only_by_3121b7(service)
        and not_known(section_3121u2_exception_any(service));
    then medicare_qualified_government_employment(service);
}

// --- Section 3121(w): exemption of churches and qualified church-controlled
//     organizations (power) --------------------------------------------------

pub relation church_or_qualified_church_controlled_org(church: Person) kind empirical {
    label en unofficial "case fact: this organization is a church, convention/association of churches, church-controlled school, or a qualified church-controlled organization within the meaning of section 3121(w)(3)";
}
pub relation church_opposed_to_3111_for_religious_reasons(church: Person) kind empirical {
    label en unofficial "case fact: this church/organization states it is opposed for religious reasons to the payment of the section 3111 tax — section 3121(w)(1) condition";
}
pub relation church_exemption_election_filed(church: Person, on: Date) kind empirical {
    label en official "case fact: this church/organization filed a section 3121(w) exemption election";
}
pub relation church_exemption_in_effect(church: Person) kind institutional {
    label en official "a section 3121(w) exemption election is in effect: services performed in the employ of this church/organization are excluded from employment (the power's effect)";
}
@source(IRC_S3121_W, relation = formalizes, coverage = partial, quote = "may make an election within the time period described in paragraph (2)")
rule Section3121WExemptionElectionPower(church: Person, on: Date) strict {
    when church_exemption_election_filed(church, on) and church_or_qualified_church_controlled_org(church) and church_opposed_to_3111_for_religious_reasons(church);
    then power Section3121WChurchExemption {
        holder church;
        over church_exemption_in_effect(church);
        exercise church_exemption_election_filed(church, on);
        valid_when church_opposed_to_3111_for_religious_reasons(church);
        effect create(church_exemption_in_effect(church));
        window [on, infinity);
    };
}
// (2) 90-day timing window, revocation, and Secretary-initiated revocation
// for 2-year §6051 non-compliance: TECH_GAP, this package takes the election
// as effective from the case-asserted filing date without deriving the
// deadline or the revocation trigger.

// --- Section 3121(y): service in the employ of international organizations
//     by certain transferred Federal employees -------------------------------

pub relation federal_agency_service_before_transfer(p: Person) kind empirical {
    label en unofficial "case fact: immediately before the section 3582 transfer, this individual performed service with a Federal agency that was \"employment\" under section 3121(b) for section 3101(a)/3111(a) purposes";
}
pub relation entitled_to_reemployment_under_3582(p: Person) kind empirical {
    label en unofficial "case fact: this individual would be entitled, upon separation from the international organization and proper application, to reemployment with the Federal agency under 5 U.S.C. 3582";
}
pub relation international_organization_service_3121y(p: Person) kind institutional {
    label en official "section 3121(y): this transferred employee's service in the employ of an international organization constitutes \"employment\"";
}
@source(IRC_S3121_Y, relation = formalizes, coverage = exact, quote = "service performed in the employ of an international organization by an individual pursuant to a transfer of such individual to such international organization pursuant to section 3582 of title 5, United States Code, shall constitute \"employment\" if")
rule Section3121YTransferredEmployeeEmployment(p: Person) strict {
    when federal_agency_service_before_transfer(p) and entitled_to_reemployment_under_3582(p);
    then international_organization_service_3121y(p);
}

// --- Section 3121(z): treatment of certain foreign persons as American
//     employers ------------------------------------------------------------

pub relation foreign_person_us_government_contract_service(foreignPerson: Person, employee: Person) kind empirical {
    label en unofficial "case fact: an employee of this foreign person is performing services in connection with a contract between the US Government (or an instrumentality) and a member of a domestically controlled group of entities that includes this foreign person";
}
pub relation domestically_controlled_group_member(foreignPerson: Person, commonParent: Person) kind empirical {
    label en unofficial "case fact: this foreign person is a member of a domestically controlled group of entities (>50 percent common control, section 1563(a)(1)-style test with the (z)(2) substitutions) whose common parent is this domestic corporation — the >50-percent aggregation test itself is not re-derived (TECH_GAP), this relation is the case-asserted RESULT of that test";
}
pub relation foreign_person_treated_as_american_employer_3121z(foreignPerson: Person, employee: Person) kind institutional {
    label en official "section 3121(z)(1): this foreign person is treated as an American employer with respect to the employee's US-government-contract services";
}
relation foreign_person_within_3121l_agreement(foreignPerson: Person, employee: Person) kind empirical {
    label en unofficial "case fact: these services are covered by a section 3121(l) agreement — section 3121(z)(4)(A) blocks (z)(1) from applying";
}
relation foreign_person_subject_to_equivalent_foreign_tax(foreignPerson: Person, employee: Person) kind empirical {
    label en unofficial "case fact: the Secretary is satisfied the remuneration is subject to a substantially equivalent foreign tax — section 3121(z)(4)(B) blocks (z)(1) from applying";
}
@source(IRC_S3121_Z, relation = formalizes, coverage = partial, quote = "such foreign person shall be treated for purposes of this chapter as an American employer with respect to such services performed by such employee")
rule Section3121ZForeignPersonTreatedAsAmericanEmployer(foreignPerson: Person, employee: Person, commonParent: Person) strict {
    when foreign_person_us_government_contract_service(foreignPerson, employee)
        and domestically_controlled_group_member(foreignPerson, commonParent)
        and not foreign_person_within_3121l_agreement(foreignPerson, employee)
        and not foreign_person_subject_to_equivalent_foreign_tax(foreignPerson, employee);
    then foreign_person_treated_as_american_employer_3121z(foreignPerson, employee);
}
pub relation common_parent_jointly_severally_liable_3121z(commonParent: Person, foreignPerson: Person) kind institutional {
    label en official "section 3121(z)(3): the common parent of the domestically controlled group is jointly and severally liable for any chapter 21 tax the foreign person owes by reason of section 3121(z)";
}
rule Section3121ZCommonParentLiability(foreignPerson: Person, employee: Person, commonParent: Person) strict {
    when foreign_person_treated_as_american_employer_3121z(foreignPerson, employee) and domestically_controlled_group_member(foreignPerson, commonParent);
    then common_parent_jointly_severally_liable_3121z(commonParent, foreignPerson);
}
