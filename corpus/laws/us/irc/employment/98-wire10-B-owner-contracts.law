// Employment -- WIRE-10 group B (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// Placeholder relations of this package that name a norm owned by a lower package are derived from the owner's `pub` relation. The
// case-fact channel stays valid: a case may still assert the placeholder directly (the WIRE-7/8/9 technique).

language "law.core" version "0.2";
package us.irc.employment version "0.1.1";
namespace "urn:us:irc:employment:clir";

use self::{
    IRC_S3402_Q,
    IRC_S3406_A,
    IRC_S3511_A,
    Person,
    TaxableYear,
    certified_cpeo,
    fourth_lowest_section_1c_rate,
    third_lowest_section_1c_rate,
};

// --- section 7705: certified professional employer organization (owner: definitions) -------------------------------------------

@source(IRC_S3511_A, relation = formalizes, coverage = partial, quote = "a certified professional employer organization shall be treated as the employer")
rule W10CertifiedCpeoFromOwner(o: us.irc.definitions::ProfessionalEmployerOrganization) strict {
    label en official "a person the definitions package records as a certified professional employer organization under section 7705 holds that certification here";
    when us.irc.definitions::certified_professional_employer_organization(o);
    then certified_cpeo(o);
}

// --- section 1(c): the third and the fourth lowest rate (owner: income_individual) ---------------------------------------------

@source(IRC_S3402_Q, relation = formalizes, coverage = partial, quote = "the third lowest rate of tax applicable under section 1(c)")
rule W10ThirdLowestSection1cRateFromOwner(y: TaxableYear, rate: Decimal) strict {
    label en official "the third lowest rate of tax applicable under section 1(c) is the rate the income-individual package derives from the section 1(c) and 1(j) tables";
    when us.irc.income_individual::section_1c_third_lowest_rate(y, rate);
    then third_lowest_section_1c_rate(y, rate);
}
@source(IRC_S3406_A, relation = formalizes, coverage = partial, quote = "the fourth lowest rate of tax applicable under section 1(c)")
rule W10FourthLowestSection1cRateFromOwner(y: TaxableYear, rate: Decimal) strict {
    label en official "the fourth lowest rate of tax applicable under section 1(c) is the rate the income-individual package derives from the section 1(c) and 1(j) tables";
    when us.irc.income_individual::section_1c_fourth_lowest_rate(y, rate);
    then fourth_lowest_section_1c_rate(y, rate);
}
