// 26 U.S.C. §3302(c)/(d)/(f)/(g) — credit-reduction-state readers for the
// pinned 2025 slice (IRC-G/G6, steps 1–4).
//
// WHAT. Sixty-five coverage rows (employment.json, EXTERNAL_DEPENDENCY):
// (c) u1–u15 (reduction formula, (c)(2)(A)/(B)/(C) scale, (c)(3) Trade Act),
// (d) 13 (6% deemed rate, attribution, Nov-10 repayment, contribution-rate
// and benefit-cost definitions, rounding, DOL determination/certification),
// (f) 26 (limitation: 0.6% floor, solvency/benefit-cost tests, reimbursing
// employer, reports, partial limitation), (g) 11 (repayment exception,
// potential additional taxes, SSA §901(d)(1) classifier, reports). Nine
// rules below (5 policy + 4 operative), each with a вывод / нет-факта
// scenario pair in `tests/futa-credit-reduction-pin.lawtest` (NOT EXECUTED,
// implemented_unverified — execution waits on CLIR snapshots, as with G4/G5).
//
// HOW (AFR wire pattern: administration/21-below-market-loans.law).
// Case-selected relations carry the operative facts (employer → year key +
// State, in the notice's own spelling); policy rules derive which year and
// which States the pinned slice covers (in `.law` only the notice's key
// literals — no rates); from-pin rules read the pinned
// `us.dol.futa_credit_reduction_2025` table (dependency + world in law.toml;
// registry publication of the source package and the consumer lock --write
// are the owner gate, step 6 — same as G4/G5). The (g) repayment exception
// and the (c)(3) Trade Act reduction read case-selected facts against the
// statute's own tests (the notice determines no 2025 case for either, so no
// pin leg exists); Title XII and SSA §901(d)(1) enter only as quoted
// reference classifiers, with no pins of their own.
//
// NOT TOUCHED. The case-fact paths (`futa_credit_reduction_state`,
// `futa_state_contributions_credit`, `futa_additional_credit`) are intact:
// these rules ADD pin/policy derivations, they do not replace a single case
// assertion.

language "law.core" version "0.2";
package us.irc.employment version "0.1.1";
namespace "urn:us:irc:employment:clir";

import us.dol.futa_credit_reduction_2025 version "0.1.1";

use self::{
    IRC_S3302_C,
    IRC_S3302_D,
    IRC_S3302_G,
    Person,
};

// --- Case-selected keys ------------------------------------------------------
// The statute attributes wages to a State (§3302(d)(2)); the notice names
// reduction States in its own spelling. The case selects both, plus the
// calendar-year key (Text, AFR-month pattern: TaxableYear is an entity and
// cannot be matched against a year literal).

relation futa_employer_tax_state_key(employer: Person, yearKey: Text, state: Text) kind empirical {
    label en unofficial "the State (notice spelling) whose unemployment compensation law governs this employer's wages for the calendar year (case-selected: section 3302(d)(2) attribution, notice naming)";
}

// --- Pinned slice policy: year 2025 ------------------------------------------

relation futa_reduction_pinned_year(yearKey: Text) kind institutional {
    label en unofficial "a calendar year (YYYY) whose FUTA credit-reduction slice is pinned (2025: FR Doc. 2026-00342)";
}
rule FutaReductionPinnedYear2025 strict {
    label en unofficial "2025 is a pinned FUTA credit-reduction year (FR Doc. 2026-00342, Applicable for 2025)";
    when true;
    then futa_reduction_pinned_year("2025");
}

// --- Pinned slice policy: reduction States ------------------------------------

relation futa_reduction_pinned_state_2025(state: Text) kind institutional {
    label en unofficial "a State the pinned 2025 notice names as subject to a FUTA credit reduction for 2025 (notice restatement, not a rate)";
}
rule FutaPinnedReductionStateCalifornia2025 strict {
    label en unofficial "California is a pinned 2025 reduction State (FR Doc. 2026-00342: 1.2 percent)";
    when true;
    then futa_reduction_pinned_state_2025("California");
}
rule FutaPinnedReductionStateVirginIslands2025 strict {
    label en unofficial "the U.S. Virgin Islands are a pinned 2025 reduction State (FR Doc. 2026-00342: 4.5 percent)";
    when true;
    then futa_reduction_pinned_state_2025("U.S. Virgin Islands");
}

// --- Pinned slice policy: repaid States (no reduction) ------------------------
// Section 3302(d)(3): paragraph (c)(2) does not apply for the year if no
// advance balance remains as of November 10. The notice finds Connecticut
// and New York repaid before November 10, 2025.

pub relation futa_no_credit_reduction_2025(state: Text) kind institutional {
    label en official "a State the pinned 2025 notice names as NOT subject to a FUTA credit reduction for 2025 (repaid all outstanding advances before November 10, 2025 — section 3302(d)(3))";
}
@source(IRC_S3302_D, relation = formalizes, coverage = partial, quote = "Paragraph (2) of subsection (c) shall not apply with respect to any State for the taxable year if (as of the beginning of November 10 of such year) there is no balance of advances referred to in such paragraph.")
rule FutaNoReductionConnecticut2025 strict {
    label en official "Connecticut: repaid before November 10, 2025 — no 2025 reduction (FR Doc. 2026-00342 under section 3302(d)(3))";
    when true;
    then futa_no_credit_reduction_2025("Connecticut");
}
@source(IRC_S3302_D, relation = formalizes, coverage = partial, quote = "Paragraph (2) of subsection (c) shall not apply with respect to any State for the taxable year if (as of the beginning of November 10 of such year) there is no balance of advances referred to in such paragraph.")
rule FutaNoReductionNewYork2025 strict {
    label en official "New York: repaid before November 10, 2025 — no 2025 reduction (FR Doc. 2026-00342 under section 3302(d)(3))";
    when true;
    then futa_no_credit_reduction_2025("New York");
}

// --- From-pin leg: the noticed reduction rate (section 3302(c)(2)) ------------
// Title XII of the Social Security Act enters only as the quoted reference
// classifier below; its advance balances are no pin of this package.

pub relation futa_credit_reduction_from_pin(employer: Person, yearKey: Text, state: Text, rate: Decimal) kind institutional {
    label en official "the FUTA credit-reduction rate for this employer's wages attributable to this State for this year, from the pinned DOL determination (section 3302(c)(2), year slice 2025)";
}
@source(IRC_S3302_C, relation = formalizes, coverage = partial, quote = "If an advance or advances have been made to the unemployment account of a State under title XII of the Social Security Act, then the total credits (after applying subsections (a) and (b) and paragraph (1) of this subsection) otherwise allowable under this section for the taxable year in the case of a taxpayer subject to the unemployment compensation law of such State shall be reduced—")
rule FutaCreditReductionRateFromPin2025 strict {
    label en official "the 2025 reduction rate for the employer's State is the pinned Table rate for a pinned reduction State (section 3302(c)(2) via FR Doc. 2026-00342)";
    for employer: Person;
    for state: Text;
    for rate: Decimal;
    when futa_employer_tax_state_key(employer, "2025", state)
        and futa_reduction_pinned_year("2025")
        and futa_reduction_pinned_state_2025(state)
        and us.dol.futa_credit_reduction_2025::futa_credit_reduction_rate(state, rate);
    then futa_credit_reduction_from_pin(employer, "2025", state, rate);
}

// --- From-pin leg: no (c)(2)(C) add-on (waiver per section 3302(f)(2)(B)) ------
// Both reduction States applied; ETA found the waiver conditions satisfied.
// The (f) limitation machinery (0.6% floor, solvency/benefit-cost tests,
// reimbursing-employer carve-outs, partial limitation) is the cited
// determination procedure, not a second computation: the noticed final
// percentages already reflect it.

pub relation futa_addon_reduction_waived_2025(employer: Person, state: Text) kind institutional {
    label en official "no additional section 3302(c)(2)(C) add-on applies to this employer's 2025 wages for this State: the State applied and ETA found the section 3302(f)(2)(B) waiver conditions satisfied (FR Doc. 2026-00342)";
}
@source(IRC_S3302_C, relation = formalizes, coverage = partial, quote = "Subparagraph (C) shall not apply with respect to any taxable year to which it would otherwise apply (but subparagraph (B) shall apply to such taxable year) if the Secretary of Labor determines (on or before November 10 of such taxable year) that the State meets the requirements of subsection (f)(2)(B) for such taxable year.")
rule FutaAddonWaiverFromPin2025 strict {
    label en official "the (c)(2)(C) add-on is waived for the employer's pinned 2025 reduction State (FR Doc. 2026-00342 under section 3302(f)(2)(B))";
    for employer: Person;
    for state: Text;
    when futa_employer_tax_state_key(employer, "2025", state)
        and futa_reduction_pinned_year("2025")
        and futa_reduction_pinned_state_2025(state);
    then futa_addon_reduction_waived_2025(employer, state);
}

// --- Case-fact leg: the (g) repayment exception --------------------------------
// The notice determines no 2025 case under (g), so this leg reads the
// statute's own three tests as case facts. SSA §901(d)(1) ((g)(3)(B)) enters
// only as a quoted reference classifier: a 901(d)(1) balance reduction is
// never a repayment, so a case asserting the (g)(2)(A) fact already excludes
// it — no pin, no second relation.

relation futa_state_repayments_cover_potential_taxes(state: Text, yearKey: Text) kind empirical {
    label en unofficial "case fact: the State's Title XII repayments in the 1-year period ending November 9 cover the potential additional taxes plus advances in that period, excluding any section 901(d)(1) balance reduction (section 3302(g)(2)(A) with (g)(3))";
}
relation futa_state_fund_sufficient_without_advances(state: Text, yearKey: Text) kind empirical {
    label en unofficial "case fact: the State fund can pay all compensation for the 3 months from November 1 without a Title XII advance (section 3302(g)(2)(B))";
}
relation futa_state_solvency_increase_covers(state: Text, yearKey: Text) kind empirical {
    label en unofficial "case fact: the post-first-advance State-law net solvency increase equals or exceeds the potential additional taxes (section 3302(g)(2)(C))";
}
pub relation futa_repayment_exception_applies(employer: Person, yearKey: Text, state: Text) kind institutional {
    label en official "section 3302(c)(2) does not apply to this employer's State for this year under the (g) repayment exception";
}
@source(IRC_S3302_G, relation = formalizes, coverage = partial, quote = "In the case of any State which meets requirements of paragraph (2) with respect to any taxable year, subsection (c)(2) shall not apply to such taxable year; except that such taxable year (and January 1 of such taxable year) shall (except as provided in subsection (f)(3)) be taken into account for purposes of applying subsection (c)(2) to succeeding taxable years.")
rule FutaRepaymentExceptionApplies strict {
    label en official "the (g) repayment exception applies when the State meets all three (g)(2) tests (section 3302(g)(1)–(2))";
    for employer: Person;
    for yearKey: Text;
    for state: Text;
    when futa_employer_tax_state_key(employer, yearKey, state)
        and futa_state_repayments_cover_potential_taxes(state, yearKey)
        and futa_state_fund_sufficient_without_advances(state, yearKey)
        and futa_state_solvency_increase_covers(state, yearKey);
    then futa_repayment_exception_applies(employer, yearKey, state);
}

// --- Case-fact leg: the (c)(3) Trade Act reduction -----------------------------
// A State that never entered/fulfilled the section 239 Trade Act agreement
// triggers a further 7½% reduction. Entered-and-fulfilled is one case fact;
// its absence fires the reduction.

relation futa_state_trade_act_ok(state: Text, yearKey: Text) kind empirical {
    label en unofficial "case fact: the State entered the Trade Act section 239 agreement before July 15, 1975 and fulfilled its commitments (section 3302(c)(3)(A)–(B))";
}
pub relation futa_trade_act_reduction_applies(employer: Person, yearKey: Text, state: Text) kind institutional {
    label en official "the further section 3302(c)(3) Trade Act reduction applies to this employer's State for this year";
}
@source(IRC_S3302_C, relation = formalizes, coverage = partial, quote = "If the Secretary of Labor determines that a State, or State agency, has not—")
rule FutaTradeActReductionApplies strict {
    label en official "the (c)(3) reduction applies when the State is not Trade-Act-qualifying (section 3302(c)(3))";
    for employer: Person;
    for yearKey: Text;
    for state: Text;
    when futa_employer_tax_state_key(employer, yearKey, state)
        and not_known(futa_state_trade_act_ok(state, yearKey));
    then futa_trade_act_reduction_applies(employer, yearKey, state);
}
