// Chapter 25, sections 3501-3505, 3509-3512 — collection and payment of
// employment taxes; third-party liability; the section 6672-adjacent
// employer-liability-determination special rates; household employment
// taxes; certified professional employer organizations; motion picture
// project employers. Stage 1 scope (task instruction). Sections 3506-3508
// (companion sitters; real estate agents/direct sellers) are NOT named in
// this stage's scope and stay `unreviewed` (stage 2).



use self::{
    IRC_S3501_B,
    IRC_S3502,
    IRC_S3503,
    IRC_S3504,
    IRC_S3505_A,
    IRC_S3505_B,
    IRC_S3505_C,
    IRC_S3506_A,
    IRC_S3508_A,
    IRC_S3508_B,
    IRC_S3509_A,
    IRC_S3509_B,
    IRC_S3509_C,
    IRC_S3509_D,
    IRC_S3510_A,
    IRC_S3511_A,
    IRC_S3511_B,
    IRC_S3512_A,
    Person,
    TaxableYear,
    individual_not_work_site_employee_3511f,
    section_3510_not_applicable,
    section_3511_inapplicable_to_customer,
};

// --- Section 3501: collection and payment of taxes --------------------------
//
// (a) is an institutional-effect statement (the Secretary collects Subtitle C
// taxes into the Treasury) with no separate case-observable conduct beyond
// the payment duties already modelled in this package's other modules:
// classification = NON_NORMATIVE for (a).
@source(IRC_S3501_B, relation = formalizes, coverage = exact, quote = "The taxes imposed by this subtitle with respect to non-cash fringe benefits shall be collected (or paid) by the employer at the time and in the manner prescribed by the Secretary by regulations.")
relation noncash_fringe_benefit_tax_collection_timing(employer: Person, on: Date) kind empirical {
    label en unofficial "EXTERNAL_DEPENDENCY: the time and manner is prescribed by Secretary regulations, not IRC text (case fact standing in for the regulatory rule)";
}
// (b) itself imposes no separate rate/base — it only times collection of
// taxes this package already computes elsewhere; classification =
// NON_NORMATIVE / EXTERNAL_DEPENDENCY (the timing regulation), not a new
// duty distinct from `Section3102DeductDuty`/`Section3402WithholdingDuty`.

// --- Section 3502: nondeductibility of certain taxes ------------------------

pub relation nondeductible_employment_tax_3502(k: us.irc.core::TaxKind) kind institutional {
    label en official "section 3502: this tax kind is NOT allowed as a deduction in computing taxable income under Subtitle A (a categorical classification over `TaxKind`, independent of the taxpayer; avoids both an unbound `Person` head variable and negating a further relation)";
}
@source(IRC_S3502, relation = formalizes, coverage = exact, quote = "The taxes imposed by section 3101 of chapter 21")
rule Section3502NoDeductionEmployeeFica strict {
    when true;
    then nondeductible_employment_tax_3502(us.irc.core::FicaCh21);
}
@source(IRC_S3502, relation = formalizes, coverage = exact, quote = "The tax deducted and withheld under chapter 24 shall not be allowed as a deduction either to the employer or to the recipient of the income in computing taxable income under subtitle A.")
rule Section3502NoDeductionWithheldIncomeTax strict {
    when true;
    then nondeductible_employment_tax_3502(us.irc.core::WithholdingWagesCh24);
}

// --- Section 3503: erroneous payments ---------------------------------------

pub relation erroneous_chapter_payment_credited(p: Person, from: us.irc.core::TaxKind, to: us.irc.core::TaxKind, amount: Money) kind institutional {
    label en official "an erroneous chapter 21/22 payment credited against the other chapter's tax, with any balance refunded (section 3503)";
}
@source(IRC_S3503, relation = formalizes, coverage = exact, quote = "Any tax paid under chapter 21 or 22 by a taxpayer with respect to any period with respect to which he is not liable to tax under such chapter shall be credited against the tax, if any, imposed by such other chapter upon the taxpayer, and the balance, if any, shall be refunded.")
rule Section3503ErroneousPaymentCredited(p: Person, paidUnder: us.irc.core::TaxKind, owedUnder: us.irc.core::TaxKind, amount: Money) strict {
    when erroneous_chapter_21_or_22_payment(p, paidUnder, amount) and not_liable_under(p, paidUnder) and liable_under(p, owedUnder, amount);
    then erroneous_chapter_payment_credited(p, paidUnder, owedUnder, amount);
}
relation erroneous_chapter_21_or_22_payment(p: Person, k: us.irc.core::TaxKind, amount: Money) kind empirical;
relation not_liable_under(p: Person, k: us.irc.core::TaxKind) kind empirical;
relation liable_under(p: Person, k: us.irc.core::TaxKind, amount: Money) kind empirical;

// --- Section 3504: acts to be performed by agents ---------------------------
//
// A POWER of the Secretary to designate a fiduciary/agent as the one who
// performs the employer's statutory acts, with the effect that ordinary law
// (including penalties) applicable to employers extends to that designee
// while the employer itself remains subject to it too (joint capacity, not a
// substitution). Modelled as an institutional-effect classification rather
// than a power/effect pair: the Secretary's designation does not change a
// LEGAL RELATION between two parties so much as extend a set of statutory
// roles to a third party, which section 3505 (below) and section 3511
// already model as institutional-effect "treated as the employer" facts —
// the same shape is reused here.
pub relation designated_agent_treated_as_employer(agent: Person, employer: Person) kind institutional {
    label en official "the Secretary designated this fiduciary/agent to perform the acts required of employers, per section 3504; both the agent and the underlying employer remain subject to the applicable law";
}
relation secretary_designated_agent(agent: Person, employer: Person, employee_or_group: Person) kind empirical {
    label en unofficial "case fact: the Secretary designated this agent under section 3504 (the agent's own control/receipt/custody/disposal-of-wages qualifying condition is TECH_GAP, folded into the case fact)";
}
@source(IRC_S3504, relation = formalizes, coverage = partial, quote = "the Secretary")
rule Section3504AgentDesignation(agent: Person, employer: Person, ee: Person) strict {
    when secretary_designated_agent(agent, employer, ee);
    then designated_agent_treated_as_employer(agent, employer);
}

// --- Section 3505: liability of third parties paying or providing wages ----

pub relation third_party_direct_payment_liability(thirdParty: Person, employer: Person, amount: Money) kind institutional {
    label en official "section 3505(a): a lender/surety/other person who pays wages directly is personally liable to the United States for the taxes (with interest) required to be withheld";
}
relation third_party_paid_wages_directly(thirdParty: Person, employer: Person, employee: Person, amount: Money, on: Date) kind empirical {
    label en official "case fact: a lender, surety, or other person (not itself an employer under sections 3102/3202/3402/3403) paid wages directly to an employee or group";
}
@source(IRC_S3505_A, relation = formalizes, coverage = exact, quote = "such lender, surety, or other person shall be liable in his own person and estate to the United States in a sum equal to the taxes (together with interest) required to be deducted and withheld from such wages by such employer")
rule Section3505DirectPaymentLiability(thirdParty: Person, employer: Person, employee: Person, amount: Money, on: Date) strict {
    when third_party_paid_wages_directly(thirdParty, employer, employee, amount, on);
    then third_party_direct_payment_liability(thirdParty, employer, amount);
}

pub relation third_party_funds_supplied_liability(thirdParty: Person, employer: Person, amount: Money) kind institutional {
    label en official "section 3505(b): a lender/surety/other person who supplies funds for the specific purpose of paying wages, with actual notice or knowledge the employer will not timely pay or deposit the withheld tax, is liable up to 25 percent of the funds supplied";
}
relation third_party_supplied_wage_funds_with_notice(thirdParty: Person, employer: Person, amount: Money, on: Date) kind empirical {
    label en official "case fact: a lender/surety/other person supplied funds to or for the employer's account specifically to pay wages, with actual notice or knowledge (section 6323(i)(1)) that the employer would not timely pay/deposit the withheld tax";
}
@source(IRC_S3505_B, relation = formalizes, coverage = partial, quote = "such lender, surety, or other person shall be liable")
rule Section3505FundsSuppliedLiability(thirdParty: Person, employer: Person, amount: Money, on: Date) strict {
    when third_party_supplied_wage_funds_with_notice(thirdParty, employer, amount, on);
    then third_party_funds_supplied_liability(thirdParty, employer, round(amount * ThirdPartyFundsSuppliedLiabilityCapRate, 2, "HALF_UP"));
}

@source(IRC_S3505_C, relation = formalizes, coverage = exact, quote = "Any amounts paid to the United States pursuant to this section shall be credited against the liability of the employer.")
rule Section3505PaymentCreditedToEmployer(thirdParty: Person, employer: Person, amount: Money) strict {
    when third_party_direct_payment_liability(thirdParty, employer, amount) and paid_to_united_states(thirdParty, amount);
    then employer_liability_reduced_by(employer, amount);
}
relation paid_to_united_states(thirdParty: Person, amount: Money) kind empirical;
pub relation employer_liability_reduced_by(employer: Person, amount: Money) kind institutional;

// --- Section 3509: determination of employer's liability for certain
//     employment taxes when it fails to withhold by misclassifying an
//     employee as not an employee ------------------------------------------

pub relation section_3509_special_liability(employer: Person, y: TaxableYear, employee: Person, withholdingTaxLiability: Money, employeeSocialSecurityTaxLiability: Money) kind institutional {
    label en official "the employer's special (reduced) liability under section 3509 for a misclassified employee, computed at the applicable rate pair";
}
relation misclassified_as_not_employee(employer: Person, employee: Person, y: TaxableYear, wagesUnder3401: Money, taxesUnder3121a: Money) kind empirical {
    label en official "case fact: the employer failed to deduct and withhold chapter 24/chapter 21(A) tax for this employee by treating the employee as not being an employee, with the section 3401 wages and the (uncollected) section 3121(a) subchapter A tax amount that would otherwise apply";
}
@source(IRC_S3509_A, relation = formalizes, coverage = exact, quote = "Tax under chapter 24 for such year with respect to such employee shall be determined as if the amount required to be deducted and withheld were equal to 1.5 percent of the wages")
@source(IRC_S3509_A, relation = formalizes, coverage = exact, quote = "Taxes under subchapter A of chapter 21 with respect to such employee shall be determined as if the taxes imposed under such subchapter were 20 percent of the amount imposed under such subchapter")
rule Section3509BaseRateLiability(employer: Person, employee: Person, y: TaxableYear, wages: Money, fullFicaTax: Money) strict {
    when misclassified_as_not_employee(employer, employee, y, wages, fullFicaTax)
        and not section_3509_disregards_reporting(employer, employee, y)
        and not section_3509_intentional_disregard(employer, employee, y)
        and not section_3509_excluded_case(employer, employee, y);
    then section_3509_special_liability(employer, y, employee,
        round(wages * Section3509BaseWithholdingRate, 2, "HALF_UP"),
        round(fullFicaTax * Section3509BaseFicaRate, 2, "HALF_UP"));
}
@source(IRC_S3509_B, relation = formalizes, coverage = exact, quote = "by substituting \"3 percent\" for \"1.5 percent\"")
rule Section3509IncreasedRateLiability(employer: Person, employee: Person, y: TaxableYear, wages: Money, fullFicaTax: Money) strict {
    when misclassified_as_not_employee(employer, employee, y, wages, fullFicaTax)
        and section_3509_disregards_reporting(employer, employee, y)
        and not section_3509_reasonable_cause(employer, employee, y)
        and not section_3509_intentional_disregard(employer, employee, y)
        and not section_3509_excluded_case(employer, employee, y);
    then section_3509_special_liability(employer, y, employee,
        round(wages * Section3509IncreasedWithholdingRate, 2, "HALF_UP"),
        round(fullFicaTax * Section3509IncreasedFicaRate, 2, "HALF_UP"));
}
relation section_3509_disregards_reporting(employer: Person, employee: Person, y: TaxableYear) kind empirical {
    label en official "case fact: the employer failed to meet the section 6041(a)/6041A/6051 information-return requirements consistent with treating the employee as not an employee";
}
// (b)(1) reasonable-cause proviso: DECISION-0194 evaluative channel.
relation section_3509_reasonable_cause(employer: Person, employee: Person, y: TaxableYear) kind empirical {
    label en unofficial "DECISION-0194 channel: an external judgment (Secretary/court) or adjudicated fact that the reporting failure was due to reasonable cause and not willful neglect — never a flat case fact substituting for the standard";
}
@source(IRC_S3509_C, relation = formalizes, coverage = exact, quote = "This section shall not apply to the determination of the employer's liability for tax under chapter 24 or subchapter A of chapter 21 if such liability is due to the employer's intentional disregard of the requirement to deduct and withhold such tax.")
relation section_3509_intentional_disregard(employer: Person, employee: Person, y: TaxableYear) kind empirical {
    label en official "case fact: the misclassification was the employer's intentional disregard of the withholding requirement — section 3509 does not apply at all (ordinary full liability governs instead, outside this relation)";
}
@source(IRC_S3509_D, relation = formalizes, coverage = partial, quote = "This section shall not apply to any employer with respect to any wages if")
relation section_3509_excluded_case(employer: Person, employee: Person, y: TaxableYear) kind empirical {
    label en official "case fact: one of the section 3509(d) exclusions applies (partial withholding already performed on the income-tax side only, or the employee is a (d)(3)-statutory employee) — section 3509 special rates do not apply";
}

// --- Section 3510: household employment taxes ------------------------------

pub relation domestic_service_employment_tax_return_due(employer: Person, y: TaxableYear, dueOn: Date) kind institutional {
    label en official "the section 3510(a) calendar-year return due date for domestic service employment taxes: the 15th day of the fourth month following the close of the employer's taxable year beginning in that calendar year";
}
relation employer_taxable_year_begins_in(employer: Person, y: TaxableYear, beginsOn: Date) kind empirical {
    label en unofficial "case fact: the employer's own taxable year that begins within this calendar year, and its start date (needed to compute the 4-months-later due date)";
}
@source(IRC_S3510_A, relation = formalizes, coverage = partial, quote = "any such return for any calendar year shall be filed on or before the 15th day of the fourth month following the close of the employer's taxable year which begins in such calendar year")
rule Section3510ReturnDueDate(employer: Person, y: TaxableYear, beginsOn: Date) defeasible {
    when employer_taxable_year_begins_in(employer, y, beginsOn);
    then domestic_service_employment_tax_return_due(employer, y, add_calendar_period(beginsOn, 16 calendar_month));
    // stage 3: section 3510(d) regulatory exception (16-income-tax-withholding-remainder.law)
    unless section_3510_not_applicable(employer, y) and employer_taxable_year_begins_in(employer, y, beginsOn);
}
// TECH_GAP: "close of the taxable year" + "4 months" from that close, for a
// taxable year of unknown length (calendar or fiscal), is not simply
// `beginsOn + 16 months` for a non-calendar year — this rule assumes a
// calendar taxable year (12 months + 4 months = 16 months from the start).
// A fiscal-year employer's due date needs the year's actual END date
// (`us.irc.core::ends`), not its start; recorded as a TECH_GAP rather than
// silently wrong for fiscal-year employers.

@source(IRC_S3510_A, relation = formalizes, coverage = exact, quote = "no requirement to make deposits (or to pay installments under section 6157) shall apply with respect to such taxes")
rule Section3510NoDepositDutyImmunityRule(employer: Person, y: TaxableYear, beginsOn: Date) defeasible {
    when employer_taxable_year_begins_in(employer, y, beginsOn);
    unless section_3510_not_applicable(employer, y) and employer_taxable_year_begins_in(employer, y, beginsOn);
    then immunity Section3510NoDepositDutyImmunity {
        holder employer;
        protected_effect domestic_service_employment_deposit_duty(employer, y);
        window [-infinity, infinity];
    };
}
relation domestic_service_employment_deposit_duty(employer: Person, y: TaxableYear) kind institutional {
    label en unofficial "the protected effect: an ordinary deposit/installment duty for domestic service employment taxes (never itself asserted true here; the general deposit regime is owned by `payment-refunds-interest`, a pending contract)";
}

// (b) estimated-tax coordination, (c) definition of domestic service
// employment taxes (used above as a case-fact category), (e) regulatory
// authority, (f) State-agreement collection authority: classification =
// NON_NORMATIVE ((c) restates a definition already folded into the case
// facts above; (e) is a rulemaking directive) or EXTERNAL_DEPENDENCY ((b)'s
// section 6654 estimated-tax coordination and (f)'s State-agreement terms
// are owned by other packages/administrative facts).

// --- Section 3511: certified professional employer organizations -----------

pub relation cpeo_treated_as_employer(cpeo: Person, workSiteEmployee: Person, customer: Person) kind institutional {
    label en official "a certified professional employer organization is treated as the employer (and no other person is) of a work site employee, with respect to remuneration the CPEO itself remits — section 3511(a)";
}
relation certified_cpeo(cpeo: Person) kind institutional {
    label en unofficial "case fact: this person holds section 7705 certification as a CPEO (EXTERNAL_DEPENDENCY on `us.irc.definitions`'s section 7705 test, which this package does not own)";
}
relation work_site_employee_of(employee: Person, cpeo: Person, customer: Person) kind empirical {
    label en unofficial "case fact: this individual is a work site employee performing services for the customer under the CPEO's service contract (section 7705(e)(2) contract test not re-derived — TECH_GAP)";
}
@source(IRC_S3511_A, relation = formalizes, coverage = partial, quote = "a certified professional employer organization shall be treated as the employer (and no other person shall be treated as the employer) of any work site employee performing services for any customer of such organization, but only with respect to remuneration remitted by such organization to such work site employee")
rule Section3511CpeoTreatedAsEmployer(cpeo: Person, employee: Person, customer: Person) defeasible {
    when certified_cpeo(cpeo) and us.irc.employment::work_site_employee_of(employee, cpeo, customer) and cpeo_remits_remuneration_to(cpeo, employee);
    then cpeo_treated_as_employer(cpeo, employee, customer);
    // stage 3: section 3511(e) related-party customer and section 3511(f) self-employed individual (16-income-tax-withholding-remainder.law)
    unless section_3511_inapplicable_to_customer(customer, cpeo) and certified_cpeo(cpeo) and us.irc.employment::work_site_employee_of(employee, cpeo, customer) and cpeo_remits_remuneration_to(cpeo, employee);
    unless individual_not_work_site_employee_3511f(employee, customer) and certified_cpeo(cpeo) and us.irc.employment::work_site_employee_of(employee, cpeo, customer) and cpeo_remits_remuneration_to(cpeo, employee);
}
relation cpeo_remits_remuneration_to(cpeo: Person, employee: Person) kind empirical;

pub relation cpeo_successor_employer(cpeo: Person, customer: Person) kind institutional {
    label en official "section 3511(b): on contracting, the CPEO is a successor employer and the customer a predecessor (relevant to the section 3121(a)(1)/3306(b)(1) wage-base successor rule); on termination, the roles reverse";
}
relation cpeo_service_contract_begins(cpeo: Person, customer: Person, on: Date) kind empirical;
relation cpeo_service_contract_ends(cpeo: Person, customer: Person, on: Date) kind empirical;
@source(IRC_S3511_B, relation = formalizes, coverage = partial, quote = "a certified professional employer organization entering into a service contract with a customer with respect to a work site employee shall be treated as a successor employer and the customer shall be treated as a predecessor employer during the term of such service contract")
rule Section3511SuccessorOnContracting(cpeo: Person, customer: Person, on: Date) strict {
    when cpeo_service_contract_begins(cpeo, customer, on);
    then cpeo_successor_employer(cpeo, customer);
}

// (c) liability for non-work-site individuals, (d) treatment of credits
// (customer, not CPEO, claims the enumerated credits), (e) related-party
// exclusion, (f) self-employed individuals excluded, (g) reporting
// requirements: TECH_GAP/EXTERNAL_DEPENDENCY (each depends on section 7705
// definitions this package does not own, or on credit computations owned by
// `credits`).

// --- Section 3512: motion picture project employers -------------------------

pub relation motion_picture_project_employer(mppe: Person) kind empirical {
    label en official "case fact: this person meets the section 3512(b)(1) definition of a motion picture project employer (the five (A) conditions and the 80-percent test are TECH_GAP, folded into the case fact)";
}
pub relation motion_picture_worker_remuneration_treated_as_employment(mppe: Person, worker: Person) kind institutional {
    label en official "section 3512(a): remuneration paid to a motion picture project worker by a motion picture project employer is treated as remuneration paid with respect to employment of that worker by that employer, for sections 3121(a)(1) and 3306(b)(1) purposes, without regard to the common-law employee test";
}
relation motion_picture_worker_of(worker: Person, mppe: Person) kind empirical {
    label en unofficial "case fact: this individual is a motion picture project worker under contract to this motion picture project employer";
}
@source(IRC_S3512_A, relation = formalizes, coverage = exact, quote = "remuneration paid to a motion picture project worker by a motion picture project employer during a calendar year shall be treated as remuneration paid with respect to employment of such worker by such employer during the calendar year")
rule Section3512TreatedAsEmployment(mppe: Person, worker: Person) strict {
    when motion_picture_project_employer(mppe) and motion_picture_worker_of(worker, mppe);
    then motion_picture_worker_remuneration_treated_as_employment(mppe, worker);
}

// --- Section 3506: sitter placement services ---------------------------------
//
// Two-sided immunity: the placement service is not the sitters' employer,
// and the sitters are not its employees, conditioned on the placement
// service (i) not paying/receiving the sitters' salary or wages and (ii)
// being compensated on a fee basis by the sitter or the person who employs
// the sitter. The conditions are positive case facts, not folded into a
// single opaque "qualifies" predicate, so a case that asserts the fee
// arrangement but NOT the no-pay-or-receive condition gets NEITHER, not a
// silent grant of the immunity.
pub relation sitter_placement_service(placer: Person) kind empirical {
    label en official "this person is engaged in the trade or business of putting sitters in touch with individuals who wish to employ them (section 3506(a) chapeau, case fact)";
}
pub relation sitter(individual: Person) kind empirical {
    label en official "this individual furnishes personal attendance, companionship, or household care services to children or to individuals who are elderly or disabled (section 3506(b) definition, case fact)";
}
relation sitter_placement_no_pay_or_receive_wages(placer: Person, sitter: Person) kind empirical {
    label en unofficial "the placement service does not pay or receive the salary or wages of this sitter (section 3506(a) condition, case fact)";
}
relation sitter_placement_compensated_on_fee_basis(placer: Person, sitter: Person) kind empirical {
    label en unofficial "the placement service is compensated by the sitter or by the persons who employ the sitter on a fee basis (section 3506(a) condition, case fact)";
}
pub relation sitter_placement_service_not_employer(placer: Person, sitter: Person) kind institutional {
    label en official "section 3506(a): the placement service is not treated as the sitter's employer, and the sitter is not treated as its employee";
}
@source(IRC_S3506_A, relation = formalizes, coverage = exact, quote = "a person engaged in the trade or business of putting sitters in touch with individuals who wish to employ them shall not be treated as the employer of such sitters (and such sitters shall not be treated as employees of such person) if such person does not pay or receive the salary or wages of the sitters and is compensated by the sitters or the persons who employ them on a fee basis")
rule Section3506NotEmployerDerived(placer: Person, sitterIndividual: Person) strict {
    when sitter_placement_service(placer)
        and sitter(sitterIndividual)
        and sitter_placement_no_pay_or_receive_wages(placer, sitterIndividual)
        and sitter_placement_compensated_on_fee_basis(placer, sitterIndividual);
    then sitter_placement_service_not_employer(placer, sitterIndividual);
}
// (c) regulations: NON_NORMATIVE (institutional grant of rulemaking authority).

// --- Section 3508: qualified real estate agents and direct sellers ---------
//
// Two-sided immunity again, this time gated on a compound occupational
// test the statute itself states as three named conjuncts per category
// (licensed agent / substantially-all-output-based pay / written non-
// employee contract for real estate agents; one of three trade-or-business
// descriptions / substantially-all-output-based pay / written non-employee
// contract for direct sellers). Each conjunct is its own case fact so a
// case missing the written-contract fact, for example, does not silently
// get the classification.
pub enum StatutoryNonemployeeKind { QualifiedRealEstateAgent; DirectSeller; }

relation licensed_real_estate_sales_person(p: Person) kind empirical {
    label en unofficial "this individual is a licensed real estate agent acting as a sales person (section 3508(b)(1)(A), case fact)";
}
relation direct_seller_trade_or_business(p: Person) kind empirical {
    label en unofficial "this person is engaged in one of the three section 3508(b)(2)(A) trade-or-business descriptions (buy-sell/deposit-commission consumer-product resale, home/non-retail consumer-product sales, or newspaper/shopping-news delivery), case fact";
}
relation output_based_remuneration(p: Person, kind: StatutoryNonemployeeKind) kind empirical {
    label en unofficial "substantially all the remuneration for the services is directly related to sales or other output rather than to hours worked (section 3508(b)(1)(B)/(2)(B), case fact)";
}
relation written_nonemployee_contract(p: Person, kind: StatutoryNonemployeeKind) kind empirical {
    label en unofficial "a written contract between the individual and the service recipient provides that the individual will not be treated as an employee for federal tax purposes (section 3508(b)(1)(C)/(2)(C), case fact)";
}
relation section_401c_self_employed_treatment(p: Person) kind empirical {
    label en unofficial "section 3508(b)(3): this individual is treated as an employee under section 401(c)(1) for retirement-plan purposes — blocks section 3508 from applying for subtitle A purposes (case fact)";
}

pub relation qualified_real_estate_agent(p: Person) kind institutional {
    label en official "this individual is a \"qualified real estate agent\" within the meaning of section 3508(b)(1)";
}
@source(IRC_S3508_B, relation = formalizes, coverage = partial, quote = "The term \"qualified real estate agent\" means any individual who is a sales person if")
rule QualifiedRealEstateAgentRule(p: Person) strict {
    when licensed_real_estate_sales_person(p)
        and output_based_remuneration(p, QualifiedRealEstateAgent)
        and written_nonemployee_contract(p, QualifiedRealEstateAgent);
    then qualified_real_estate_agent(p);
}

pub relation direct_seller(p: Person) kind institutional {
    label en official "this person is a \"direct seller\" within the meaning of section 3508(b)(2)";
}
@source(IRC_S3508_B, relation = formalizes, coverage = partial, quote = "The term \"direct seller\" means any person if")
rule DirectSellerRule(p: Person) strict {
    when direct_seller_trade_or_business(p)
        and output_based_remuneration(p, DirectSeller)
        and written_nonemployee_contract(p, DirectSeller);
    then direct_seller(p);
}

pub relation statutory_nonemployee_not_employee(p: Person, forWhom: Person) kind institutional {
    label en official "section 3508(a): this individual, performing services as a qualified real estate agent or direct seller, is not treated as an employee, and the person for whom the services are performed is not treated as an employer";
}
relation performs_services_for(p: Person, forWhom: Person) kind empirical {
    label en unofficial "case fact: this individual performs the qualified-real-estate-agent or direct-seller services for this person";
}
@source(IRC_S3508_A, relation = formalizes, coverage = partial, quote = "the individual performing such services shall not be treated as an employee, and")
rule Section3508RealEstateAgentNotEmployee(p: Person, forWhom: Person) strict {
    when qualified_real_estate_agent(p) and performs_services_for(p, forWhom) and not section_401c_self_employed_treatment(p);
    then statutory_nonemployee_not_employee(p, forWhom);
}
@source(IRC_S3508_A, relation = formalizes, coverage = partial, quote = "the individual performing such services shall not be treated as an employee, and")
rule Section3508DirectSellerNotEmployee(p: Person, forWhom: Person) strict {
    when direct_seller(p) and performs_services_for(p, forWhom) and not section_401c_self_employed_treatment(p);
    then statutory_nonemployee_not_employee(p, forWhom);
}
// (b)(3) coordination with section 401(c)(1): modelled as the `not
// section_401c_self_employed_treatment(p)` guard above (subtitle A only;
// this package does not separately track "for purposes of subtitle A" vs
// other subtitles — TECH_GAP, a narrower reading than the statute's own
// subtitle-specific scope).

// Section 3507 (advance earned income credit): REPEALED (Pub. L. 111-226,
// §219(a)(1), 2010) — REPEALED_OR_RESERVED, non_normative.
