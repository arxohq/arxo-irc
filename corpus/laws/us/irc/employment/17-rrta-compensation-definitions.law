// 26 U.S.C. §3231(d), (e)(2), (e)(4)-(6), (e)(8)-(12), (h), (i) — RRTA "service" and
// "compensation". Stage 3 (26.09.2026, TECH_GAP reduction, DECISION-0379).
// Status: implemented_unverified — scenarios are written, not executed.
//
// SCOPE.
//  - §3231(d): the test of being "in the service of an employer" (control,
//    professional/technical integration, integrated personal services; for
//    compensation) with its territorial limits, the local-lodge and
//    general-committee rules and the foreign-employer proviso. The derived
//    `in_service_of_employer_3231d` feeds `rrta_employee` (09-rrta.law).
//  - §3231(e)(2): the applicable base is applied to COMPENSATION only ((A)(ii):
//    remuneration that is not compensation is not counted), the hospital
//    insurance part of the tax is not capped ((A)(iii)), and the successor
//    employer rule of §3121(a)(1) applies with the (C) substitutions. The
//    tier 1 tax rules of 09-rrta.law are LEFT AS THEY WERE (one combined rate
//    on the capped compensation); this module adds PARALLEL relations
//    (`rrta_tier1_counted_compensation`, `rrta_hi_tax_uncapped`,
//    `rrta_oasdi_tax_capped`, `rrta_tier1_tax_split`) that apply (A)(ii) and
//    (A)(iii) correctly: OASDI on the capped compensation, HI on all of it.
//  - §3231(e)(4)(A),(C),(D), (5), (6), (8), (9)-(12): the exclusions that
//    stage 2 folded into the case items of `RrtaCompensationExclusionKind`.
//    Each paragraph is derived from its own conditions; the "reasonable to
//    believe" element is an evaluative finding of the case (DECISION-0194).
//    The derived `rrta_compensation_excluded_by_paragraph` is ALTERNATIVE to the
//    case item route and is not summed into `rrta_compensation_exclusion_total`
//    (an aggregate over a derived predicate is a runtime-subset limitation, §111).
//  - §3231(h), (i): rules already in 09-rrta.law; the scenarios are new.

// ============================================================================
// §3231(d) — in the service of an employer
// ============================================================================

use self::{
    IRC_S3231_B,
    IRC_S3231_D,
    IRC_S3231_E,
    Person,
    RrtaCompensationExclusionKind,
    RrtaEmployerBasis,
    TaxableYear,
    WagePayment,
    coal_mine_physical_operations_only,
    contribution_and_benefit_base,
    deferred_amount,
    deferred_compensation_payout_on,
    employer_contribution_under_401k_cash_or_deferred_not_in_gross_income,
    employer_contribution_under_414h2_pickup_by_salary_reduction,
    rrta_compensation,
    rrta_employee,
    rrta_employee_representative,
    rrta_employer,
    rrta_tier2_compensation_base,
    wage_payment,
};

pub enum ServiceEmployerKind3231d {
    OrdinaryEmployer;
    LocalLodgeOrDivision;
    GeneralCommittee;
    label en unofficial "the kinds of employer to which the territorial rules of section 3231(d) distinguish";
}
pub relation service_employer_kind_3231d(employer: Person, kind: ServiceEmployerKind3231d) kind empirical {
    label en official "the kind of employer: ordinary, a local lodge or division, or a general committee of a railway-labor-organization employer";
}
pub relation subject_to_continuing_authority_to_supervise(p: Person, employer: Person) kind empirical {
    label en official "he is subject to the continuing authority of the employer to supervise and direct the manner of rendition of his service";
}
pub relation professional_or_technical_and_integrated_into_staff(p: Person, employer: Person) kind empirical {
    label en official "he is rendering professional or technical services and is integrated into the staff of the employer";
}
pub relation personal_services_integrated_into_operations_on_employer_property(p: Person, employer: Person) kind empirical {
    label en official "he is rendering, on the property used in the employer's operations, other personal services the rendition of which is integrated into the employer's operations";
}
pub relation renders_service_for_compensation(p: Person, employer: Person) kind empirical {
    label en official "he renders such service for compensation";
}
pub relation service_test_3231d_met(p: Person, employer: Person) kind institutional {
    label en official "paragraphs (1) and (2) of section 3231(d): a control or integration test and service for compensation";
}
@source(IRC_S3231_D, relation = formalizes, coverage = exact, quote = "(1) he is subject to the continuing authority of the employer to supervise and direct the manner of rendition of his service")
rule S3231d1ControlTest defeasible {
    label en official "continuing authority to supervise and direct, and service for compensation";
    for p: Person;
    for employer: Person;
    when subject_to_continuing_authority_to_supervise(p, employer)
        and renders_service_for_compensation(p, employer);
    then service_test_3231d_met(p, employer);
}
@source(IRC_S3231_D, relation = formalizes, coverage = exact, quote = "or he is rendering professional or technical services and is integrated into the staff of the employer")
rule S3231d1ProfessionalTest defeasible {
    label en official "professional or technical services integrated into the staff, and service for compensation";
    for p: Person;
    for employer: Person;
    when professional_or_technical_and_integrated_into_staff(p, employer)
        and renders_service_for_compensation(p, employer);
    then service_test_3231d_met(p, employer);
}
@source(IRC_S3231_D, relation = formalizes, coverage = exact, quote = "or he is rendering, on the property used in the employer's operations, other personal services the rendition of which is integrated into the employer's operations")
rule S3231d1IntegratedServicesTest defeasible {
    label en official "personal services integrated into the operations on the employer's property, and service for compensation";
    for p: Person;
    for employer: Person;
    when personal_services_integrated_into_operations_on_employer_property(p, employer)
        and renders_service_for_compensation(p, employer);
    then service_test_3231d_met(p, employer);
}
pub relation employer_conducts_principal_part_of_business_in_united_states(employer: Person) kind empirical {
    label en official "the employer conducts the principal part of its business in the United States";
}
pub relation service_rendered_in_united_states(p: Person, employer: Person) kind empirical {
    label en official "he is rendering service to the employer in the United States";
}
pub relation local_lodge_membership_substantially_all_employees_of_us_employers(lodge: Person) kind empirical {
    label en official "all, or substantially all, the individuals constituting the membership are employees of an employer conducting the principal part of its business in the United States (an evaluative finding: DECISION-0194)";
}
pub relation local_lodge_headquarters_in_united_states(lodge: Person) kind empirical {
    label en official "the headquarters of the local lodge or division is located in the United States";
}
pub relation representing_local_lodge_of_paragraph_3_or_4(p: Person, committee: Person) kind empirical {
    label en official "he is representing a local lodge or division described in paragraph (3) or (4)";
}
pub relation committee_represented_substantially_all_employees_of_us_employers(committee: Person) kind empirical {
    label en official "all, or substantially all, the individuals represented by the committee are employees of an employer conducting the principal part of its business in the United States";
}
pub relation acts_as_general_chairman_of_committee_representing_service_in_united_states(p: Person, committee: Person) kind empirical {
    label en official "he acts in the capacity of a general chairman or an assistant general chairman of a general committee which represents individuals rendering service in the United States to an employer";
}
pub relation foreign_employer_required_to_employ_local_citizens_where_service_rendered(employer: Person) kind empirical {
    label en official "the employer is required under the laws applicable in the place where the service is rendered (or, for earlier times, the laws applicable on August 29, 1935) to employ therein, in whole or in part, citizens or residents thereof";
}
pub relation individual_citizen_or_resident_of_united_states(p: Person) kind empirical {
    label en official "the individual is a citizen or resident of the United States";
}
pub relation service_rendered_outside_united_states(p: Person, employer: Person) kind empirical {
    label en official "the individual renders the service outside the United States";
}
pub relation in_service_of_employer_3231d(p: Person, employer: Person) kind institutional {
    label en official "the individual is in the service of the employer within the meaning of section 3231(d)";
}
@source(IRC_S3231_D, relation = formalizes, coverage = exact, quote = "except that an individual shall be deemed to be in the service of an employer, other than a local lodge or division or a general committee of a railway-labor-organization employer, not conducting the principal part of its business in the United States, only when he is rendering service to it in the United States")
rule S3231dOrdinaryEmployerInUnitedStates defeasible {
    label en official "an ordinary employer conducting the principal part of its business in the United States";
    for p: Person;
    for employer: Person;
    when service_test_3231d_met(p, employer)
        and service_employer_kind_3231d(employer, OrdinaryEmployer)
        and employer_conducts_principal_part_of_business_in_united_states(employer);
    then in_service_of_employer_3231d(p, employer);
}
rule S3231dOrdinaryEmployerServiceInUnitedStates defeasible {
    label en official "an ordinary employer not conducting the principal part of its business in the United States: only for service rendered in the United States";
    for p: Person;
    for employer: Person;
    when service_test_3231d_met(p, employer)
        and service_employer_kind_3231d(employer, OrdinaryEmployer)
        and service_rendered_in_united_states(p, employer);
    then in_service_of_employer_3231d(p, employer);
}
@source(IRC_S3231_D, relation = formalizes, coverage = exact, quote = "(3) all, or substantially all, the individuals constituting its membership are employees of an employer conducting the principal part of its business in the United States; or")
rule S3231d3LocalLodgeMembership defeasible {
    label en official "a local lodge or division whose membership is substantially all employees of US-principal employers";
    for p: Person;
    for lodge: Person;
    when service_test_3231d_met(p, lodge)
        and service_employer_kind_3231d(lodge, LocalLodgeOrDivision)
        and local_lodge_membership_substantially_all_employees_of_us_employers(lodge);
    then in_service_of_employer_3231d(p, lodge);
}
@source(IRC_S3231_D, relation = formalizes, coverage = exact, quote = "(4) the headquarters of such local lodge or division is located in the United States;")
rule S3231d4LocalLodgeHeadquarters defeasible {
    label en official "a local lodge or division headquartered in the United States";
    for p: Person;
    for lodge: Person;
    when service_test_3231d_met(p, lodge)
        and service_employer_kind_3231d(lodge, LocalLodgeOrDivision)
        and local_lodge_headquarters_in_united_states(lodge);
    then in_service_of_employer_3231d(p, lodge);
}
@source(IRC_S3231_D, relation = formalizes, coverage = exact, quote = "(5) he is representing a local lodge or division described in paragraph (3) or (4) immediately above; or")
rule S3231d5CommitteeRepresentingLodge defeasible {
    label en official "a general committee: representing a local lodge of paragraph (3) or (4)";
    for p: Person;
    for committee: Person;
    when service_test_3231d_met(p, committee)
        and service_employer_kind_3231d(committee, GeneralCommittee)
        and representing_local_lodge_of_paragraph_3_or_4(p, committee);
    then in_service_of_employer_3231d(p, committee);
}
@source(IRC_S3231_D, relation = formalizes, coverage = exact, quote = "(6) all, or substantially all, the individuals represented by it are employees of an employer conducting the principal part of its business in the United States; or")
rule S3231d6CommitteeRepresentedEmployees defeasible {
    label en official "a general committee whose represented individuals are substantially all employees of US-principal employers";
    for p: Person;
    for committee: Person;
    when service_test_3231d_met(p, committee)
        and service_employer_kind_3231d(committee, GeneralCommittee)
        and committee_represented_substantially_all_employees_of_us_employers(committee);
    then in_service_of_employer_3231d(p, committee);
}
@source(IRC_S3231_D, relation = formalizes, coverage = partial, quote = "(7) he acts in the capacity of a general chairman or an assistant general chairman of a general committee which represents individuals rendering service in the United States to an employer")
rule S3231d7GeneralChairman defeasible {
    label en official "a general chairman of a committee representing individuals rendering service in the United States (the mileage proportion and the 10 percent floor of the remainder of clause (7) are not computed: the remuneration share is not modelled)";
    for p: Person;
    for committee: Person;
    when service_test_3231d_met(p, committee)
        and service_employer_kind_3231d(committee, GeneralCommittee)
        and acts_as_general_chairman_of_committee_representing_service_in_united_states(p, committee);
    then in_service_of_employer_3231d(p, committee);
}
pub relation section_3231d_mileage_share_of_remuneration_is_compensation(p: Person, committee: Person, share: Rational) kind institutional {
    label en official "clause (7): only the proportion of the remuneration equal to the proportion of the mileage in the United States under the committee's jurisdiction is compensation; if that share is below 10 percent, no part of the remuneration is compensation";
}
pub relation committee_mileage_in_united_states(committee: Person, miles: Integer) kind empirical {
    label en official "the mileage in the United States under the jurisdiction of the general committee";
}
pub relation committee_total_mileage(committee: Person, miles: Integer) kind empirical {
    label en official "the total mileage under the jurisdiction of the general committee";
}
pub relation chairman_office_outside_united_states_and_represented_employers_not_us_principal(p: Person, committee: Person) kind empirical {
    label en official "the general chairman's office or headquarters is not located in the United States and the individuals represented are employees of an employer not conducting the principal part of its business in the United States";
}
@source(IRC_S3231_D, relation = formalizes, coverage = exact, quote = "only such proportion of the remuneration for such service shall be regarded as compensation as the proportion which the mileage in the United States under the jurisdiction of such general committee bears to the total mileage under its jurisdiction")
rule S3231d7MileageShare defeasible {
    label en official "the share is the mileage in the United States over the total mileage (the Board's alternative formula, where the mileage formula is inapplicable, is external and not modelled)";
    for p: Person;
    for committee: Person;
    for usMiles: Integer;
    for total: Integer;
    when acts_as_general_chairman_of_committee_representing_service_in_united_states(p, committee)
        and chairman_office_outside_united_states_and_represented_employers_not_us_principal(p, committee)
        and committee_mileage_in_united_states(committee, usMiles)
        and committee_total_mileage(committee, total)
        and usMiles * 10 >= total;
    then section_3231d_mileage_share_of_remuneration_is_compensation(p, committee, usMiles / total);
}
pub relation section_3231d_no_part_of_remuneration_is_compensation(p: Person, committee: Person) kind institutional {
    label en official "the share is less than 10 percent of the remuneration: no part of it is compensation";
}
rule S3231d7BelowTenPercent defeasible {
    label en official "below 10 percent: none";
    for p: Person;
    for committee: Person;
    for usMiles: Integer;
    for total: Integer;
    when acts_as_general_chairman_of_committee_representing_service_in_united_states(p, committee)
        and chairman_office_outside_united_states_and_represented_employers_not_us_principal(p, committee)
        and committee_mileage_in_united_states(committee, usMiles)
        and committee_total_mileage(committee, total)
        and usMiles * 10 < total;
    then section_3231d_no_part_of_remuneration_is_compensation(p, committee);
}
pub relation section_3231d_proviso_not_in_service(p: Person, employer: Person) kind institutional {
    label en official "a non-citizen non-resident rendering service outside the United States to an employer that must employ local citizens or residents is not in the service of the employer";
}
@source(IRC_S3231_D, relation = formalizes, coverage = exact, quote = "Provided however, That an individual not a citizen or resident of the United States shall not be deemed to be in the service of an employer when rendering service outside the United States to an employer who is required under the laws applicable in the place where the service is rendered to employ therein, in whole or in part, citizens or residents thereof")
rule S3231dProviso defeasible {
    label en official "the foreign-employer proviso";
    for p: Person;
    for employer: Person;
    when service_rendered_outside_united_states(p, employer)
        and foreign_employer_required_to_employ_local_citizens_where_service_rendered(employer)
        and not_known(individual_citizen_or_resident_of_united_states(p));
    then section_3231d_proviso_not_in_service(p, employer);
}
@source(IRC_S3231_B, relation = formalizes, coverage = partial, quote = "the term \"employee\" means any individual in the service of one or more employers for compensation")
rule RrtaEmployeeFromServiceTest defeasible {
    label en official "an individual in the service of an employer within section 3231(d) is an employee (unless the coal-mining exception or the proviso applies)";
    for p: Person;
    for employer: Person;
    when in_service_of_employer_3231d(p, employer);
    then rrta_employee(p, employer);
    unless coal_mine_physical_operations_only(p) and in_service_of_employer_3231d(p, employer);
    unless section_3231d_proviso_not_in_service(p, employer) and in_service_of_employer_3231d(p, employer);
}

// ============================================================================
// §3231(e)(2) — the applicable base applies to compensation
// ============================================================================

pub relation rrta_own_prior_compensation(pay: WagePayment, employer: Person, employee: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the compensation this employer paid the employee earlier in the calendar year (only what is treated as compensation is counted: clause (A)(ii))";
}
rule S3231e2AiiOwnPriorCompensation defeasible {
    label en official "sum of the earlier compensation, empty sum read as zero";
    for pay0: WagePayment;
    for employer0: Person;
    for employee0: Person;
    for y0: TaxableYear;
    for on0: Date;
    when wage_payment(pay0, employer0, employee0, y0, _, on0);
    then rrta_own_prior_compensation(pay0, employer0, employee0, y0,
        sum(collect all a: Money, pay: WagePayment, d: Date
            where wage_payment(pay, employer0, employee0, y0, _, d) and rrta_compensation(pay, a) and d < on0,
            empty: 0.00 USD));
}
pub relation successor_employer_3231e2C(successor: Person, predecessor: Person, acquiredOn: Date) kind empirical {
    label en official "the successor employer acquired during the calendar year substantially all the property used in a trade or business (or a separate unit) of the predecessor, and immediately after employs an individual who was employed in it immediately before";
}
pub relation individual_continued_from_predecessor(individual: Person, successor: Person, predecessor: Person) kind empirical {
    label en official "the individual was employed in the predecessor's business immediately before the acquisition and is employed in the successor's business immediately after it";
}
pub relation rrta_predecessor_compensation(pay: WagePayment, amount: Money) kind institutional {
    label en official "the compensation paid (or considered paid) to the individual by the predecessor during the calendar year and prior to the acquisition, considered as paid by the successor";
}
@source(IRC_S3231_E, relation = formalizes, coverage = exact, quote = "the second sentence of section 3121(a)(1) (relating to successor employers) shall apply, except that—")
rule S3231e2CSuccessorPredecessorCompensation defeasible {
    label en official "the predecessor's earlier compensation of the year counts toward the successor's base (with 'services' for 'employment' and 'compensation' for 'remuneration')";
    for pay0: WagePayment;
    for successor: Person;
    for predecessor: Person;
    for employee0: Person;
    for y0: TaxableYear;
    for acquiredOn: Date;
    when wage_payment(pay0, successor, employee0, y0, _, _)
        and successor_employer_3231e2C(successor, predecessor, acquiredOn)
        and individual_continued_from_predecessor(employee0, successor, predecessor);
    then rrta_predecessor_compensation(pay0,
        sum(collect all a: Money, pay: WagePayment, d: Date
            where wage_payment(pay, predecessor, employee0, y0, _, d) and rrta_compensation(pay, a) and d < acquiredOn,
            empty: 0.00 USD));
}
pub relation rrta_prior_compensation_for_base(pay: WagePayment, employer: Person, employee: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the compensation counted against the applicable base before this payment: the employer's own earlier compensation plus the predecessor's when clause (C) applies";
}
rule S3231e2PriorForBaseOwn defeasible {
    label en official "no successor rule: the employer's own earlier compensation";
    for pay: WagePayment;
    for employer: Person;
    for employee: Person;
    for y: TaxableYear;
    for own: Money;
    when rrta_own_prior_compensation(pay, employer, employee, y, own)
        and not_known(rrta_predecessor_compensation_exists(pay));
    then rrta_prior_compensation_for_base(pay, employer, employee, y, own);
}
relation rrta_predecessor_compensation_exists(pay: WagePayment) kind institutional;
rule RrtaPredecessorCompensationExists defeasible {
    for pay: WagePayment;
    for amount: Money;
    when rrta_predecessor_compensation(pay, amount);
    then rrta_predecessor_compensation_exists(pay);
}
rule S3231e2PriorForBaseWithPredecessor defeasible {
    label en official "successor rule: own plus predecessor";
    for pay: WagePayment;
    for employer: Person;
    for employee: Person;
    for y: TaxableYear;
    for own: Money;
    for pred: Money;
    when rrta_own_prior_compensation(pay, employer, employee, y, own)
        and rrta_predecessor_compensation(pay, pred);
    then rrta_prior_compensation_for_base(pay, employer, employee, y, own + pred);
}
// The tier caps of 09-rrta.law (rules RrtaTier1TaxableBelowBase, ...CrossingBase, RrtaTier2...)
// keep `prior_remuneration_paid` (all payments, no exclusions, no predecessor). The rules
// below apply the same caps to the counted compensation; they conclude the SAME relations,
// so a case that asserts both routes gets two values only if the two priors differ.
@source(IRC_S3231_E, relation = formalizes, coverage = exact, quote = "The term \"compensation\" does not include that part of remuneration paid during any calendar year to an individual by an employer after remuneration equal to the applicable base has been paid during such calendar year")
rule S3231e2AiTier1BelowBaseCounted defeasible {
    label en official "tier 1: the whole payment when the counted prior compensation plus the payment does not exceed the base";
    for pay: WagePayment;
    for employer: Person;
    for employee: Person;
    for y: TaxableYear;
    for amount: Money;
    for prior: Money;
    for base: Money;
    when rrta_compensation(pay, amount)
        and rrta_prior_compensation_for_base(pay, employer, employee, y, prior)
        and contribution_and_benefit_base(y, base)
        and prior + amount <= base;
    then rrta_tier1_counted_compensation(pay, amount);
}
pub relation rrta_tier1_counted_compensation(pay: WagePayment, amount: Money) kind institutional {
    label en official "tier 1 compensation after the applicable base, counting only compensation (and the predecessor's) against the base";
}
rule S3231e2AiTier1CrossingBaseCounted defeasible {
    label en official "tier 1: the part up to the base";
    for pay: WagePayment;
    for employer: Person;
    for employee: Person;
    for y: TaxableYear;
    for amount: Money;
    for prior: Money;
    for base: Money;
    when rrta_compensation(pay, amount)
        and rrta_prior_compensation_for_base(pay, employer, employee, y, prior)
        and contribution_and_benefit_base(y, base)
        and prior < base
        and prior + amount > base;
    then rrta_tier1_counted_compensation(pay, base - prior);
}
pub relation rrta_tier2_counted_compensation(pay: WagePayment, amount: Money) kind institutional {
    label en official "tier 2 compensation after the applicable base of (B)(ii), counting only compensation against the base";
}
@source(IRC_S3231_E, relation = formalizes, coverage = exact, quote = "(ii) Tier 2 taxes, etc")
rule S3231e2AiTier2BelowBaseCounted defeasible {
    label en official "tier 2: the whole payment below the tier 2 base";
    for pay: WagePayment;
    for employer: Person;
    for employee: Person;
    for y: TaxableYear;
    for amount: Money;
    for prior: Money;
    for base: Money;
    when rrta_compensation(pay, amount)
        and rrta_prior_compensation_for_base(pay, employer, employee, y, prior)
        and rrta_tier2_compensation_base(y, base)
        and prior + amount <= base;
    then rrta_tier2_counted_compensation(pay, amount);
}
rule S3231e2AiTier2CrossingBaseCounted defeasible {
    label en official "tier 2: the part up to the base";
    for pay: WagePayment;
    for employer: Person;
    for employee: Person;
    for y: TaxableYear;
    for amount: Money;
    for prior: Money;
    for base: Money;
    when rrta_compensation(pay, amount)
        and rrta_prior_compensation_for_base(pay, employer, employee, y, prior)
        and rrta_tier2_compensation_base(y, base)
        and prior < base
        and prior + amount > base;
    then rrta_tier2_counted_compensation(pay, base - prior);
}
// (A)(iii): the hospital insurance part of the tax is not subject to the base.
pub relation rrta_hi_tax_uncapped(payer: Person, pay: WagePayment, amount: Money) kind institutional {
    label en official "the part of the tax at the rate that does not exceed the section 3101(b) rate (sections 3201(a), 3221(a)) or the section 1401(b) rate (section 3211(a)), computed on all compensation without the base";
}
@source(IRC_S3231_E, relation = formalizes, coverage = exact, quote = "(I) so much of the rate applicable under section 3201(a) or 3221(a) as does not exceed the rate of tax in effect under section 3101(b), and")
rule S3231e2AiiiEmployeeHiUncapped defeasible {
    label en official "section 3201(a): the HI rate on all compensation";
    for employee: Person;
    for pay: WagePayment;
    for amount: Money;
    when rrta_compensation(pay, amount)
        and rrta_employee(employee, _)
        and wage_payment(pay, _, employee, _, _, _);
    then rrta_hi_tax_uncapped(employee, pay, round(amount * HiEmployeeRate, 2, "HALF_UP"));
}
rule S3231e2AiiiEmployerHiUncapped defeasible {
    label en official "section 3221(a): the HI rate on all compensation";
    for employer: Person;
    for pay: WagePayment;
    for amount: Money;
    when rrta_compensation(pay, amount)
        and rrta_employer(employer, _)
        and wage_payment(pay, employer, _, _, _, _);
    then rrta_hi_tax_uncapped(employer, pay, round(amount * HiEmployerRate, 2, "HALF_UP"));
}
@source(IRC_S3231_E, relation = formalizes, coverage = exact, quote = "(II) so much of the rate applicable under section 3211(a) as does not exceed the rate of tax in effect under section 1401(b).")
rule S3231e2AiiiRepresentativeHiUncapped defeasible {
    label en official "section 3211(a): the section 1401(b) rate (employee and employer HI rates) on all compensation";
    for rep: Person;
    for org: Person;
    for pay: WagePayment;
    for amount: Money;
    when rrta_compensation(pay, amount)
        and rrta_employee_representative(rep, org)
        and wage_payment(pay, _, rep, _, _, _);
    then rrta_hi_tax_uncapped(rep, pay, round(amount * (HiEmployeeRate + HiEmployerRate), 2, "HALF_UP"));
}
pub relation rrta_oasdi_tax_capped(payer: Person, pay: WagePayment, amount: Money) kind institutional {
    label en official "the old-age, survivors and disability part of the tier 1 tax, computed on the compensation after the base";
}
rule S3231e2AiEmployeeOasdiCapped defeasible {
    label en official "section 3201(a) OASDI part on the capped compensation";
    for employee: Person;
    for pay: WagePayment;
    for amount: Money;
    when rrta_tier1_counted_compensation(pay, amount)
        and rrta_employee(employee, _)
        and wage_payment(pay, _, employee, _, _, _);
    then rrta_oasdi_tax_capped(employee, pay, round(amount * OasdiEmployeeRate, 2, "HALF_UP"));
}
rule S3231e2AiEmployerOasdiCapped defeasible {
    label en official "section 3221(a) OASDI part on the capped compensation";
    for employer: Person;
    for pay: WagePayment;
    for amount: Money;
    when rrta_tier1_counted_compensation(pay, amount)
        and rrta_employer(employer, _)
        and wage_payment(pay, employer, _, _, _, _);
    then rrta_oasdi_tax_capped(employer, pay, round(amount * OasdiEmployerRate, 2, "HALF_UP"));
}
rule S3231e2AiRepresentativeOasdiCapped defeasible {
    label en official "section 3211(a) OASDI part (both rates) on the capped compensation";
    for rep: Person;
    for org: Person;
    for pay: WagePayment;
    for amount: Money;
    when rrta_tier1_counted_compensation(pay, amount)
        and rrta_employee_representative(rep, org)
        and wage_payment(pay, _, rep, _, _, _);
    then rrta_oasdi_tax_capped(rep, pay, round(amount * (OasdiEmployeeRate + OasdiEmployerRate), 2, "HALF_UP"));
}
pub relation rrta_tier1_tax_split(payer: Person, pay: WagePayment, amount: Money) kind institutional {
    label en official "the tier 1 tax with the OASDI part capped and the HI part uncapped (the sum of the two parts)";
}
rule S3231e2Tier1TaxSplit defeasible {
    label en official "OASDI capped plus HI uncapped";
    for payer: Person;
    for pay: WagePayment;
    for oasdi: Money;
    for hi: Money;
    when rrta_oasdi_tax_capped(payer, pay, oasdi)
        and rrta_hi_tax_uncapped(payer, pay, hi);
    then rrta_tier1_tax_split(payer, pay, oasdi + hi);
}

// ============================================================================
// §3231(e)(4), (5), (6), (8)-(12) — exclusions and inclusions
// ============================================================================

pub enum DisabilityPaymentKind3231e4 {
    WorkmensCompensation;
    RailroadRetirementAct1974Benefit;
    OtherPlanPayment;
    label en unofficial "the payments made to an employee or his dependents on account of sickness or accident disability";
}
pub relation disability_payment_kind(pay: WagePayment, kind: DisabilityPaymentKind3231e4, amount: Money) kind empirical {
    label en official "the payment made to an employee or his dependents on account of sickness or accident disability, and its kind";
}
pub relation rrta_compensation_excluded_by_paragraph(pay: WagePayment, paragraph: Text, amount: Money) kind institutional {
    label en official "the amount excluded from compensation by the named paragraph of section 3231(e) (alternative to the case items of RrtaCompensationExclusionKind)";
}
@source(IRC_S3231_E, relation = formalizes, coverage = exact, quote = "(i) payments which are received under a workmen's compensation law, and")
rule S3231e4AiWorkmensCompensation defeasible {
    label en official "for sections 3201(a), 3211(a), 3221(a): only workmen's compensation payments are excluded";
    for pay: WagePayment;
    for amount: Money;
    when disability_payment_kind(pay, WorkmensCompensation, amount);
    then rrta_compensation_excluded_by_paragraph(pay, "3231(e)(4)(A)(i)", amount);
}
@source(IRC_S3231_E, relation = formalizes, coverage = exact, quote = "(ii) benefits received under the Railroad Retirement Act of 1974.")
rule S3231e4AiiRailroadRetirementBenefits defeasible {
    label en official "benefits under the Railroad Retirement Act of 1974 are excluded";
    for pay: WagePayment;
    for amount: Money;
    when disability_payment_kind(pay, RailroadRetirementAct1974Benefit, amount);
    then rrta_compensation_excluded_by_paragraph(pay, "3231(e)(4)(A)(ii)", amount);
}
pub relation other_plan_disability_payment_included_for_tier1_taxes(pay: WagePayment, amount: Money) kind institutional {
    label en official "for the taxes of sections 3201(a), 3211(a), 3221(a) other plan payments on account of sickness or accident disability are not excluded by clause (i) of paragraph (1)";
}
@source(IRC_S3231_E, relation = formalizes, coverage = exact, quote = "clause (i) of the second sentence of paragraph (1) shall exclude from the term \"compensation\" only—")
rule S3231e4AOtherPaymentsIncluded defeasible {
    label en official "only the two listed kinds are excluded: other plan payments remain compensation for these taxes";
    for pay: WagePayment;
    for amount: Money;
    when disability_payment_kind(pay, OtherPlanPayment, amount);
    then other_plan_disability_payment_included_for_tier1_taxes(pay, amount);
}
pub relation sickness_payment_period_last_month_worked_begins(pay: WagePayment, monthBegins: Date) kind empirical {
    label en official "the first day of the last calendar month in which the employee worked for the employer";
}
pub relation regulations_apply_six_month_cutoff_3231e4C(y: TaxableYear) kind empirical {
    label en official "regulations prescribed by the Secretary make subparagraphs (A) and (B) inapplicable after the six-month period";
}
pub relation sickness_rules_4A_4B_inapplicable(pay: WagePayment) kind institutional {
    label en official "the payment is made after the expiration of a 6-month period comparable to that of section 3121(a)(4), so subparagraphs (A) and (B) do not apply";
}
@source(IRC_S3231_E, relation = formalizes, coverage = exact, quote = "Under regulations prescribed by the Secretary, subparagraphs (A) and (B) shall not apply to payments made after the expiration of a 6-month period comparable to the 6-month period described in section 3121(a)(4).")
rule S3231e4CSixMonthCutoff defeasible {
    label en official "a payment on or after the first day of the seventh calendar month after the last month worked (last month begins + 7 calendar months)";
    for pay: WagePayment;
    for y: TaxableYear;
    for paidOn: Date;
    for monthBegins: Date;
    when wage_payment(pay, _, _, y, _, paidOn)
        and regulations_apply_six_month_cutoff_3231e4C(y)
        and sickness_payment_period_last_month_worked_begins(pay, monthBegins)
        and paidOn >= add_calendar_period(monthBegins, 7 calendar_month);
    then sickness_rules_4A_4B_inapplicable(pay);
}
pub relation regulations_provide_otherwise_for_third_party_employer(thirdParty: Person) kind empirical {
    label en official "the Secretary's regulations otherwise provide as to the treatment of the third party as the employer";
}
pub enum IncomeExclusionSection {
    S74c; S108f4; S117; S132; S127; S119; S106b; S106d;
    label en unofficial "the income-exclusion sections named in section 3231(e)(5), (6), (9), (10), (11)";
}
pub relation reasonable_to_believe_employee_can_exclude(pay: WagePayment, section: IncomeExclusionSection, amount: Money) kind empirical {
    label en official "at the time the payment or benefit is provided it is reasonable to believe that the employee will be able to exclude it from income under the section (an evaluative finding of the case: DECISION-0194)";
}
@source(IRC_S3231_E, relation = formalizes, coverage = exact, quote = "if at the time such benefit is provided it is reasonable to believe that the employee will be able to exclude such benefit from income under section 74(c), 108(f)(4), 117, or 132")
rule S3231e5FringeBenefit74c defeasible {
    label en official "section 74(c)";
    for pay: WagePayment;
    for amount: Money;
    when reasonable_to_believe_employee_can_exclude(pay, S74c, amount);
    then rrta_compensation_excluded_by_paragraph(pay, "3231(e)(5)", amount);
}
rule S3231e5FringeBenefit108f4 defeasible {
    label en official "section 108(f)(4)";
    for pay: WagePayment;
    for amount: Money;
    when reasonable_to_believe_employee_can_exclude(pay, S108f4, amount);
    then rrta_compensation_excluded_by_paragraph(pay, "3231(e)(5)", amount);
}
rule S3231e5FringeBenefit117 defeasible {
    label en official "section 117";
    for pay: WagePayment;
    for amount: Money;
    when reasonable_to_believe_employee_can_exclude(pay, S117, amount);
    then rrta_compensation_excluded_by_paragraph(pay, "3231(e)(5)", amount);
}
rule S3231e5FringeBenefit132 defeasible {
    label en official "section 132";
    for pay: WagePayment;
    for amount: Money;
    when reasonable_to_believe_employee_can_exclude(pay, S132, amount);
    then rrta_compensation_excluded_by_paragraph(pay, "3231(e)(5)", amount);
}
@source(IRC_S3231_E, relation = formalizes, coverage = exact, quote = "if at the time of such payment or such furnishing it is reasonable to believe that the employee will be able to exclude such payment or benefit from income under section 127")
rule S3231e6CafeteriaSection127 defeasible {
    label en official "section 127";
    for pay: WagePayment;
    for amount: Money;
    when reasonable_to_believe_employee_can_exclude(pay, S127, amount);
    then rrta_compensation_excluded_by_paragraph(pay, "3231(e)(6)", amount);
}
@source(IRC_S3231_E, relation = formalizes, coverage = exact, quote = "if at the time of such furnishing it is reasonable to believe that the employee will be able to exclude such items from income under section 119")
rule S3231e9MealsOrLodging defeasible {
    label en official "meals or lodging excludable under section 119";
    for pay: WagePayment;
    for amount: Money;
    when reasonable_to_believe_employee_can_exclude(pay, S119, amount);
    then rrta_compensation_excluded_by_paragraph(pay, "3231(e)(9)", amount);
}
@source(IRC_S3231_E, relation = formalizes, coverage = exact, quote = "if at the time of such payment it is reasonable to believe that the employee will be able to exclude such payment from income under section 106(b)")
rule S3231e10ArcherMsa defeasible {
    label en official "section 106(b)";
    for pay: WagePayment;
    for amount: Money;
    when reasonable_to_believe_employee_can_exclude(pay, S106b, amount);
    then rrta_compensation_excluded_by_paragraph(pay, "3231(e)(10)", amount);
}
@source(IRC_S3231_E, relation = formalizes, coverage = exact, quote = "if at the time of such payment it is reasonable to believe that the employee will be able to exclude such payment from income under section 106(d)")
rule S3231e11Hsa defeasible {
    label en official "section 106(d)";
    for pay: WagePayment;
    for amount: Money;
    when reasonable_to_believe_employee_can_exclude(pay, S106d, amount);
    then rrta_compensation_excluded_by_paragraph(pay, "3231(e)(11)", amount);
}
pub relation stock_transfer_under_iso_or_espp(pay: WagePayment, amount: Money) kind empirical {
    label en official "remuneration on account of a transfer of a share of stock pursuant to an exercise of an incentive stock option (section 422(b)) or under an employee stock purchase plan (section 423(b))";
}
pub relation disposition_of_iso_or_espp_stock(pay: WagePayment, amount: Money) kind empirical {
    label en official "remuneration on account of any disposition by the individual of such stock";
}
@source(IRC_S3231_E, relation = formalizes, coverage = exact, quote = "(A) a transfer of a share of stock to any individual pursuant to an exercise of an incentive stock option (as defined in section 422(b)) or under an employee stock purchase plan (as defined in section 423(b)), or")
rule S3231e12ATransfer defeasible {
    label en official "stock transfer under an ISO or ESPP";
    for pay: WagePayment;
    for amount: Money;
    when stock_transfer_under_iso_or_espp(pay, amount);
    then rrta_compensation_excluded_by_paragraph(pay, "3231(e)(12)(A)", amount);
}
@source(IRC_S3231_E, relation = formalizes, coverage = exact, quote = "(B) any disposition by the individual of such stock.")
rule S3231e12BDisposition defeasible {
    label en official "disposition of the stock";
    for pay: WagePayment;
    for amount: Money;
    when disposition_of_iso_or_espp_stock(pay, amount);
    then rrta_compensation_excluded_by_paragraph(pay, "3231(e)(12)(B)", amount);
}
// (8): inclusions and timing of deferred compensation
pub relation rrta_contribution_included_in_compensation(pay: WagePayment, amount: Money) kind institutional {
    label en official "nothing in a paragraph of subsection (e) other than (2) excludes the amount from compensation";
}
@source(IRC_S3231_E, relation = formalizes, coverage = exact, quote = "Nothing in any paragraph of this subsection (other than paragraph (2)) shall exclude from the term \"compensation\" any amount described in subparagraph (A) or (B) of section 3121(v)(1).")
rule S3231e8AContribution401k defeasible {
    label en official "a section 3121(v)(1)(A) amount (employer contribution to a section 401(k) arrangement) is compensation";
    for pay: WagePayment;
    for amount: Money;
    when employer_contribution_under_401k_cash_or_deferred_not_in_gross_income(pay, amount);
    then rrta_contribution_included_in_compensation(pay, amount);
}
rule S3231e8AContribution414h2 defeasible {
    label en official "a section 3121(v)(1)(B) amount (414(h)(2) pickup under salary reduction) is compensation";
    for pay: WagePayment;
    for amount: Money;
    when employer_contribution_under_414h2_pickup_by_salary_reduction(pay, amount);
    then rrta_contribution_included_in_compensation(pay, amount);
}
pub relation rrta_deferred_compensation_taken_into_account_on(pay: WagePayment, amount: Money, on: Date) kind institutional {
    label en official "the date an amount deferred under a nonqualified deferred compensation plan is taken into account for this chapter (the rules of section 3121(v)(2))";
}
@source(IRC_S3231_E, relation = formalizes, coverage = exact, quote = "The rules of section 3121(v)(2) which apply for purposes of chapter 21 shall also apply for purposes of this chapter.")
rule S3231e8BServicesNotBefore defeasible {
    label en official "later of services and lapse of risk: services date";
    for pay: WagePayment;
    for amount: Money;
    for servicesOn: Date;
    for forfeitureOn: Date;
    when deferred_amount(pay, amount, servicesOn, forfeitureOn)
        and servicesOn >= forfeitureOn;
    then rrta_deferred_compensation_taken_into_account_on(pay, amount, servicesOn);
}
rule S3231e8BRiskLapsesLater defeasible {
    label en official "later of services and lapse of risk: lapse date";
    for pay: WagePayment;
    for amount: Money;
    for servicesOn: Date;
    for forfeitureOn: Date;
    when deferred_amount(pay, amount, servicesOn, forfeitureOn)
        and forfeitureOn > servicesOn;
    then rrta_deferred_compensation_taken_into_account_on(pay, amount, forfeitureOn);
}
pub relation rrta_payout_treated_as_compensation_again(employer: Person, pay: WagePayment) kind institutional {
    label en unofficial "the protected effect of the taxed-only-once rule (section 3121(v)(2)(B) as applied here)";
}
rule S3231e8BTaxedOnlyOnce defeasible {
    label en official "a payout after the amount was taken into account is not compensation again";
    for pay: WagePayment;
    for employer: Person;
    for amount: Money;
    for takenOn: Date;
    for paidOn: Date;
    when rrta_deferred_compensation_taken_into_account_on(pay, amount, takenOn)
        and deferred_compensation_payout_on(pay, paidOn)
        and wage_payment(pay, employer, _, _, _, _)
        and paidOn > takenOn;
    then immunity S3231e8BTaxedOnlyOnceImmunity {
        holder employer;
        protected_effect rrta_payout_treated_as_compensation_again(employer, pay);
        window [takenOn, infinity];
    };
}
