// Chapter 24, sections 3401-3404 — income tax withholding at source:
// definitions, the employer's duty to withhold, liability, governmental
// employers. Stage 1 scope (task instruction).



use self::{
    IRC_S3401_A,
    IRC_S3401_B,
    IRC_S3401_C,
    IRC_S3401_D,
    IRC_S3401_F,
    IRC_S3401_H,
    IRC_S3402_A,
    IRC_S3402_D,
    IRC_S3402_F,
    IRC_S3402_N,
    IRC_S3402_P,
    IRC_S3402_Q,
    IRC_S3402_R,
    IRC_S3403,
    Person,
    Secretary,
    TaxableYear,
    WagePayment,
    corporate_officer,
    tip_payment,
    tip_reported,
    wage_payment,
    wage_payment_period_kind,
};

// --- Section 3401(a): wages, with its 23-item exclusion list ----------------
//
// Same method as section 3121(a) in `02-fica-definitions.law`: the exclusion
// paragraphs ARE the classification (repealed paragraph (7) omitted). This is
// a SEPARATE wage concept from section 3121(a) — chapter 24 "wages" differs
// (e.g. combat-zone pay, foreign-government service, group-term life
// insurance are excluded here but not identically there) — so a separate
// enum and relation, not a re-export of `WageExclusionKind`.
pub enum IncomeTaxWageExclusionKind {
    Section3401A1CombatZoneCompensation;        // (1) section 112 excludable combat-zone pay
    Section3401A2AgriculturalLaborNonFicaWages;  // (2) agricultural labor unless it is section 3121(a) wages
    Section3401A3DomesticServicePrivateHome;     // (3) domestic service in a private home/local college club/fraternity/sorority
    Section3401A4CasualLaborUnder50;             // (4) casual labor not in the employer's trade/business, under $50/quarter or not regularly employed
    Section3401A5CitizenForForeignGovernment;    // (5) US citizen/resident service for a foreign government or international organization
    Section3401A6NonresidentAlienDesignated;     // (6) nonresident alien service designated by regulation
    Section3401A8ForeignEarnedIncomeExclusion;   // (8) foreign earned income / possession service (four sub-tests)
    Section3401A9MinisterOrReligiousOrder;       // (9) minister/religious order duties
    Section3401A10NewspaperDeliveryOrSale;       // (10) newspaper delivery under 18, or newspaper/magazine resale arrangement
    Section3401A11NoncashCasualLabor;            // (11) noncash remuneration for service not in the employer's trade or business
    Section3401A12QualifiedPlanOrAnnuityPayment; // (12) qualified trust/annuity/SEP/SIMPLE/eligible deferred comp payment
    Section3401A13PeaceCorpsVolunteer;           // (13) Peace Corps volunteer service payment (other than under the Peace Corps Act itself)
    Section3401A14GroupTermLifeInsurance;        // (14) group-term life insurance
    Section3401A15Section217MovingExpense;       // (15) reasonably believed deductible under section 217
    Section3401A16Tips;                          // (16)(A) noncash tips, (B) cash tips under $20/month
    Section3401A17Section3121B20Service;         // (17) service described in section 3121(b)(20) (fishing boat)
    Section3401A18DependentCareEtcExclusion;     // (18) reasonably believed excludable under section 127, 129, 134(b)(4), or 134(b)(5)
    Section3401A19FringeBenefitExclusion;        // (19) reasonably believed excludable under section 74(c), 108(f)(4), 117, or 132
    Section3401A20SelfInsuredMedicalReimbursement; // (20) self-insured medical reimbursement plan payment
    Section3401A21Section106bExclusion;          // (21) reasonably believed excludable under section 106(b)
    Section3401A22Section106dExclusion;          // (22) reasonably believed excludable under section 106(d)
    Section3401A23Section139BExclusion;          // (23) benefit or payment excludable under section 139B(b)
}

pub relation income_tax_wage_exclusion_item(pay: WagePayment, kind: IncomeTaxWageExclusionKind, amount: Money) kind empirical {
    label en official "an item excluded from wages under one of the paragraphs of section 3401(a), asserted by the case with the excluded amount";
}
relation income_tax_wage_partly_excluded(pay: WagePayment) kind institutional;
rule IncomeTaxWagePartlyExcluded(pay: WagePayment, kind: IncomeTaxWageExclusionKind, amount: Money) strict {
    when income_tax_wage_exclusion_item(pay, kind, amount);
    then income_tax_wage_partly_excluded(pay);
}
pub relation income_tax_wage_exclusion_total(pay: WagePayment, amount: Money) kind institutional;
rule IncomeTaxWageExclusionTotal(pay0: WagePayment, kind0: IncomeTaxWageExclusionKind, amount0: Money) strict {
    when income_tax_wage_exclusion_item(pay0, kind0, amount0);
    then income_tax_wage_exclusion_total(pay0,
        sum all amount: Money for kind: IncomeTaxWageExclusionKind where income_tax_wage_exclusion_item(pay0, kind, amount));
}
@source(IRC_S3401_A, relation = formalizes, coverage = partial, quote = "the term \"wages\" means all remuneration (other than fees paid to a public official) for services performed by an employee for his employer, including the cash value of all remuneration (including benefits) paid in any medium other than cash; except that such term shall not include remuneration paid")
pub relation wages_3401(pay: WagePayment, amount: Money) kind institutional {
    label en official "the amount of a wage payment that is \"wages\" within the meaning of section 3401(a)";
}
rule Wages3401NoExclusion(pay: WagePayment, amount: Money) strict {
    when wage_payment(pay, _, _, _, amount, _)
        and not_known(income_tax_wage_partly_excluded(pay))
        and not_known(fee_paid_to_public_official(pay));
    then wages_3401(pay, amount);
}
rule Wages3401WithExclusion(pay: WagePayment, gross: Money, excluded: Money) strict {
    when wage_payment(pay, _, _, _, gross, _)
        and income_tax_wage_exclusion_total(pay, excluded)
        and gross > excluded
        and not_known(fee_paid_to_public_official(pay));
    then wages_3401(pay, gross - excluded);
}
relation fee_paid_to_public_official(pay: WagePayment) kind empirical {
    label en unofficial "this payment is a fee paid to a public official, categorically excluded by section 3401(a)'s own chapeau (case fact)";
}
// section 409A inclusion (the final sentence of (a)) and differential wage
// payments ((h)), qualified stock under section 83(i) ((i)): TECH_GAP —
// each is its own cross-referenced computation this package does not own
// (chapter 1 deferred-compensation/equity-compensation timing rules).

// --- Section 3401(b): payroll period; (f) tips; (g) crew leader rule -------
@source(IRC_S3401_B, relation = formalizes, coverage = exact, quote = "the term \"payroll period\" means a period for which a payment of wages is ordinarily made to the employee by his employer")
pub relation payroll_period_3401b(pay: WagePayment, k: us.irc.core::PeriodKind) kind institutional {
    label en official "the payroll period of a wage payment under section 3401(b)";
}
rule PayrollPeriod3401b(pay: WagePayment, k: us.irc.core::PeriodKind) strict {
    when wage_payment_period_kind(pay, k);
    then payroll_period_3401b(pay, k);
}

@source(IRC_S3401_F, relation = formalizes, coverage = exact, quote = "the term \"wages\" includes tips received by an employee in the course of his employment")
rule TipsAreWages3401(pay: WagePayment, amount: Money, on: Date) strict {
    when tip_reported(pay, amount, on);
    then income_tax_wage_exclusion_item(pay, Section3401A16Tips, 0.00 USD);
    // Same modelling shortcut as `TipsAreWages3121` in `02-fica-definitions.law`.
}

// section 3401(g) "rules similar to the rules of section 3121(o) [crew
// leader] shall apply": a cross-reference incorporation, not a separate
// rule; the classification IS section 3121(o) (out of this stage's scope,
// stage 2). classification = NON_NORMATIVE for THIS module (incorporation by
// reference), TECH_GAP for the underlying test.

// --- Section 3401(c): employee; (d) employer --------------------------------

@source(IRC_S3401_C, relation = formalizes, coverage = exact, quote = "the term \"employee\" includes an officer, employee, or elected official of the United States, a State, or any political subdivision thereof, or the District of Columbia")
pub relation employee_3401(p: Person) kind institutional {
    label en official "this person is an \"employee\" within the meaning of section 3401(c)";
}
rule Employee3401GovernmentOfficial(p: Person) strict {
    when government_officer_employee_or_elected_official(p);
    then employee_3401(p);
}
rule Employee3401CorporateOfficer(p: Person) strict {
    when corporate_officer(p);
    then employee_3401(p);
}
relation government_officer_employee_or_elected_official(p: Person) kind empirical {
    label en unofficial "case fact: officer, employee, or elected official of the United States, a State, a political subdivision, or the District of Columbia";
}

@source(IRC_S3401_D, relation = formalizes, coverage = partial, quote = "the term \"employer\" means the person for whom an individual performs or performed any service, of whatever nature, as the employee of such person")
pub relation employer_3401(p: Person, employee: Person) kind institutional {
    label en official "this person is the \"employer\" of this employee within the meaning of section 3401(d)";
}
rule Employer3401General(p: Person, employee: Person) defeasible {
    when service_performed_for(employee, p);
    then employer_3401(p, employee);
    unless person_lacking_control_of_wage_payment(p, employee);
}
relation service_performed_for(employee: Person, p: Person) kind empirical {
    label en unofficial "this individual performs or performed services for this person as its employee (case fact)";
}
@source(IRC_S3401_D, relation = formalizes, coverage = partial, quote = "if the person for whom the individual performs or performed the services does not have control of the payment of the wages for such services, the term \"employer\"")
rule Employer3401ControlOfPayment(controller: Person, nominal: Person, employee: Person) strict {
    when service_performed_for(employee, nominal) and person_lacking_control_of_wage_payment(nominal, employee) and controls_wage_payment(controller, employee);
    then employer_3401(controller, employee);
}
relation person_lacking_control_of_wage_payment(nominal: Person, employee: Person) kind empirical {
    label en unofficial "the nominal service-recipient does not control payment of the employee's wages (case fact)";
}
relation controls_wage_payment(controller: Person, employee: Person) kind empirical {
    label en unofficial "this person controls payment of the employee's wages (case fact)";
}
// (d)(2) foreign-principal paying agent: TECH_GAP/NON_NORMATIVE (narrow
// cross-border paying-agent substitution, not reached without a
// nonresident-alien/foreign-entity classification this package does not own).

// --- Section 3401(h): differential wage payments to uniformed-service members
@source(IRC_S3401_H, relation = formalizes, coverage = exact, quote = "any differential wage payment shall be treated as a payment of wages by the employer to the employee")
pub relation differential_wage_payment(pay: WagePayment) kind empirical {
    label en official "this wage payment is a differential wage payment under section 3401(h)(2) (case fact: employer payment to an individual on active uniformed-service duty exceeding 30 days, representing all or part of the civilian wages)";
}
rule DifferentialWageIsWages3401(pay: WagePayment, amount: Money) strict {
    when differential_wage_payment(pay) and wage_payment(pay, _, _, _, amount, _);
    then wages_3401(pay, amount);
}

// --- Section 3402(a): requirement of withholding (the core duty) -----------
//
// EXTERNAL_DEPENDENCY: the AMOUNT withheld is "determined in accordance with
// tables or computational procedures prescribed by the Secretary" (Pub.
// 15-T) — a contract on Treasury/IRS publications, not IRC text. This
// package does not invent a withholding formula; the duty's PERFORMANCE
// condition takes the Secretary's table result as a case-asserted fact with
// its origin named, per the task instruction.
pub relation secretary_prescribed_withholding_amount(pay: WagePayment, amount: Money, origin: SourceRef) kind empirical {
    label en official "the amount of income tax withholding for this wage payment as determined under the Secretary's tables or computational procedures (Pub. 15-T) — EXTERNAL_DEPENDENCY, asserted by the case with the origin of the table result, never computed by this package";
}
pub entity SourceRef;
pub relation income_tax_withheld(pay: WagePayment, amount: Money) kind institutional {
    label en official "the amount of income tax withheld from a wage payment under section 3402";
}
rule Section3402IncomeTaxWithheld(pay: WagePayment, amount: Money, origin: SourceRef) strict {
    when secretary_prescribed_withholding_amount(pay, amount, origin) and wages_3401(pay, _);
    then income_tax_withheld(pay, amount);
}
@source(IRC_S3402_A, relation = formalizes, coverage = exact, quote = "every employer making payment of wages shall deduct and withhold upon such wages a tax determined in accordance with tables or computational procedures prescribed by the Secretary")
rule Section3402DutyToWithhold(pay: WagePayment, employer: Person, employee: Person, on: Date, amount: Money) defeasible {
    when wage_payment(pay, employer, employee, _, _, on) and wages_3401(pay, _) and secretary_prescribed_withholding_amount(pay, amount, _);
    then duty Section3402WithholdingDuty {
        bearer employer;
        beneficiary Secretary;
        goal achievement {
            condition income_tax_withheld(pay, amount);
            window [on, on];
        }
    };
    // stage 3: section 3402(k) (tips: statement only, collectible amount) has its own duty in 13-fica-rrta-special-rules.law
    unless tip_payment(pay) and wage_payment(pay, employer, employee, _, _, on) and wages_3401(pay, _) and secretary_prescribed_withholding_amount(pay, amount, _);
}
// (b) percentage method, (c) wage-bracket method, (g) overlapping periods,
// (h) alternative computation methods, (i) increases on employee request,
// (j) noncash retail-commission-salesman exception, (l) marital-status
// determination for the tables, (m) additional allowance factors, (s)
// vehicle-fringe-benefit election: all are PROCEDURAL DETAIL of how the
// Secretary's own tables/allowances are computed or applied — every one of
// them is itself downstream of the same EXTERNAL_DEPENDENCY as (a) (the
// tables are Pub. 15-T, not IRC text) and several add multi-step
// self-referential arithmetic over running annual/quarterly totals (h)(2)-
// (3)) that would need the day-by-day-ledger pattern flagged as an
// LDC-E4102 trap in AGENT-BRIEF. classification = EXTERNAL_DEPENDENCY,
// documented per-row in coverage rather than modelled.

// (d) tax paid by recipient: an IMMUNITY of the employer against collection
// of the SAME tax once it has been collected from the employee via the
// employee's own return, once already assessed the underlying income tax.
relation underlying_income_tax_paid_by_employee(pay: WagePayment) kind empirical {
    label en unofficial "the tax against which the withheld amount would have been credited has itself been paid by the employee (case fact, section 3402(d))";
}
@source(IRC_S3402_D, relation = formalizes, coverage = exact, quote = "the tax so required to be deducted and withheld shall not be collected from the employer; but this subsection shall in no case relieve the employer from liability for any penalties or additions to the tax otherwise applicable")
rule Section3402TaxPaidByRecipientImmunityRule(pay: WagePayment, employer: Person, employee: Person, on: Date) strict {
    when wage_payment(pay, employer, employee, _, _, on) and underlying_income_tax_paid_by_employee(pay);
    then immunity Section3402TaxPaidByRecipientImmunity {
        holder employer;
        protected_effect income_tax_withholding_collectible_from_employer(employer, pay);
        window [on, infinity);
    };
}
relation income_tax_withholding_collectible_from_employer(employer: Person, pay: WagePayment) kind institutional {
    label en unofficial "the protected effect: collection of the section 3402 tax from the employer (penalties/additions to tax are expressly NOT protected — the immunity's scope stops at the primary tax collection, per the quoted proviso)";
}

// (e) included and excluded wages (pay-period aggregation test): the same
// shape as section 3121(c)/3306(d) (majority-of-the-period rule) but for
// income tax withholding. Not in this stage's named scope (task lists (a),
// (b)-(f) as "allowances/exemptions/certificates", which (e) is not);
// classification = TECH_GAP (same self-contained majority test as 3121(c),
// deferred alongside it).

// (f) withholding allowance: the EMPLOYEE'S POWER to determine, by furnishing
// a certificate, the withholding allowance the employer's table computation
// uses. Modelled at the certificate level (the allowance's own multi-factor
// COMPUTATION — dependents, credits, standard deduction split — is
// EXTERNAL_DEPENDENCY/TECH_GAP; the power is furnishing/superseding the
// certificate itself).
pub relation withholding_allowance_certificate_furnished(employee: Person, employer: Person, allowance: Decimal, on: Date) kind empirical {
    label en official "the employee furnished the employer a signed withholding allowance certificate claiming this allowance, effective from this date (case fact; section 3402(f)(2)-(3) timing rules apply to WHEN it takes effect, not modelled here — TECH_GAP)";
}
@source(IRC_S3402_F, relation = formalizes, coverage = partial, quote = "an employee receiving wages shall on any day be entitled to a withholding allowance")
rule Section3402WithholdingAllowancePower(employee: Person, employer: Person, allowance: Decimal, on: Date) strict {
    when withholding_allowance_certificate_furnished(employee, employer, allowance, on);
    then power Section3402WithholdingAllowanceCertificate {
        holder employee;
        over withholding_allowance_in_effect(employee, employer);
        exercise withholding_allowance_certificate_furnished(employee, employer, allowance, on);
        valid_when withholding_allowance_certificate_furnished(employee, employer, allowance, on);
        effect create(withholding_allowance_in_effect(employee, employer));
        window [on, infinity);
    };
}
relation withholding_allowance_in_effect(employee: Person, employer: Person) kind institutional {
    label en unofficial "the effect of exercising the section 3402(f) power: an allowance certificate in effect with this employer";
}

// (n) exemption certificate for no liability: a POWER of the employee to
// suspend the employer's section 3402(a) duty entirely by certifying no
// income tax liability for the preceding and current taxable year.
pub relation exemption_certificate_furnished(employee: Person, employer: Person, on: Date) kind empirical {
    label en official "the employee furnished the employer a section 3402(n) exemption certificate (case fact)";
}
@source(IRC_S3402_N, relation = formalizes, coverage = exact, quote = "an employer shall not be required to deduct and withhold any tax under this chapter upon a payment of wages to an employee if there is in effect")
rule Section3402ExemptionCertificatePower(pay: WagePayment, employee: Person, employer: Person, on: Date) strict {
    when wage_payment(pay, employer, employee, _, _, on);
    then power Section3402ExemptionCertificate {
        holder employee;
        over employer_no_duty_to_withhold(employer, pay);
        exercise exemption_certificate_furnished(employee, employer, on);
        valid_when exemption_certificate_furnished(employee, employer, on);
        effect create(employer_no_duty_to_withhold(employer, pay));
        window [on, infinity);
    };
}
relation employer_no_duty_to_withhold(employer: Person, pay: WagePayment) kind institutional {
    label en unofficial "the effect of exercising the section 3402(n) power: the employer's section 3402(a) duty does not apply to this payment";
}

// (o) extension to supplemental payments (supplemental unemployment
// compensation benefits, requested annuity/sick-pay withholding): a
// CLASSIFICATION (treated as wages paid by an employer to an employee for a
// payroll period), conditioned on the payee's own request for annuity/sick
// pay (itself a POWER, folded into the classification's `when` clause since
// the statute frames it as "if...a request...is in effect").
pub enum SupplementalPaymentKind { SupplementalUnemploymentCompensation; RequestedAnnuityWithholding; RequestedSickPayWithholding; }
pub relation supplemental_payment(pay: WagePayment, kind: SupplementalPaymentKind) kind empirical {
    label en official "this payment is one of the section 3402(o) categories treated as wages for withholding purposes (case fact, including — for the two request-based categories — that the payee's withholding request is in effect)";
}
rule SupplementalPaymentIsWages3401(pay: WagePayment, kind: SupplementalPaymentKind, amount: Money) strict {
    when supplemental_payment(pay, kind) and wage_payment(pay, _, _, _, amount, _);
    then wages_3401(pay, amount);
}
// (5) special collective-bargaining sick-pay rule, (6) coordination with
// section 3405: TECH_GAP (bargaining-agreement lookup / cross-reference not
// modelled).

// (p) voluntary withholding agreements: a POWER of the payee (for specified
// Federal payments, unemployment compensation, or any other remuneration by
// agreement) to elect withholding.
pub enum VoluntaryWithholdingKind { SpecifiedFederalPayment; UnemploymentCompensation; OtherByAgreement; }
pub relation voluntary_withholding_request(pay: WagePayment, kind: VoluntaryWithholdingKind, percentage: Decimal, on: Date) kind empirical {
    label en official "the payee's (or, for (3), both parties') request that this payment be subject to withholding under section 3402(p), with the elected percentage (case fact)";
}
@source(IRC_S3402_P, relation = formalizes, coverage = partial, quote = "if")
rule Section3402VoluntaryWithholdingPower(pay: WagePayment, kind: VoluntaryWithholdingKind, percentage: Decimal, on: Date, amount: Money, payee: Person) strict {
    when voluntary_withholding_request(pay, kind, percentage, on) and wage_payment(pay, _, payee, _, amount, on);
    then power Section3402VoluntaryWithholding {
        holder payee;
        over voluntary_withholding_treated_as_wages(pay);
        exercise voluntary_withholding_request(pay, kind, percentage, on);
        valid_when voluntary_withholding_request(pay, kind, percentage, on);
        effect create(voluntary_withholding_treated_as_wages(pay));
        window [on, infinity);
    };
}
relation voluntary_withholding_treated_as_wages(pay: WagePayment) kind institutional {
    label en unofficial "the effect of exercising the section 3402(p) power: this payment is treated as if it were wages paid by an employer to an employee, for withholding purposes only";
}
rule VoluntaryWithholdingIsWages3401(pay: WagePayment, amount: Money) strict {
    when voluntary_withholding_treated_as_wages(pay) and wage_payment(pay, _, _, _, amount, _);
    then wages_3401(pay, amount);
}
// (q) gambling winnings; (r) Indian casino profits: both DUTIES to withhold,
// each at a rate defined by a FORMULA over section 1(c)'s rate brackets
// ("third lowest rate" / "fourth lowest rate") rather than a flat percentage
// stated in this package's own text. EXTERNAL_DEPENDENCY: the section 1(c)
// bracket ordering is owned by `us.irc.income_individual`'s rate tables,
// which this package does not import for a per-bracket lookup (importing
// FilingStatus alone, as done in `01-fica-tax.law`, does not give an ordered
// list of bracket rates). The duty's PERFORMANCE condition therefore takes
// the applicable rate as a case-asserted fact with its statutory formula
// named, exactly as `secretary_prescribed_withholding_amount` does for (a).
pub relation gambling_winnings_payment(pay: WagePayment, proceeds: Money, wagered: Money) kind empirical {
    label en official "a payment of winnings subject to withholding under section 3402(q), with the proceeds and amount wagered (case fact; the section 3402(q)(3) $5,000/300-times thresholds by wager type are TECH_GAP — asserted as already-qualifying by the case)";
}
pub relation third_lowest_section_1c_rate(y: TaxableYear, rate: Decimal) kind institutional {
    label en unofficial "the third lowest rate of tax applicable under section 1(c) for this taxable year — EXTERNAL_DEPENDENCY on `us.irc.income_individual`'s rate brackets, asserted here as a case fact pending that lookup";
}
@source(IRC_S3402_Q, relation = formalizes, coverage = partial, quote = "shall deduct and withhold from such payment a tax in an amount equal to the product of the third lowest rate of tax applicable under section 1(c)")
rule Section3402GamblingWithholdingDutyRule(pay: WagePayment, payer: Person, payee: Person, on: Date, proceeds: Money, wagered: Money, rate: Decimal, y: TaxableYear) strict {
    when wage_payment(pay, payer, payee, y, _, on) and gambling_winnings_payment(pay, proceeds, wagered) and third_lowest_section_1c_rate(y, rate);
    then duty Section3402GamblingWithholdingDuty {
        bearer payer;
        beneficiary Secretary;
        goal achievement {
            condition income_tax_withheld(pay, round((proceeds - wagered) * rate, 2, "HALF_UP"));
            window [on, on];
        }
    };
}

pub relation indian_casino_payment(pay: WagePayment, annualized_share: Money) kind empirical {
    label en official "a payment to a tribal member from class II/III gaming net revenues subject to section 3402(r) withholding, with its proportionate share of the annualized tax (case fact; the section 3402(r)(2)-(3) exemption threshold and annualization are TECH_GAP)";
}
pub relation fourth_lowest_section_1c_rate(y: TaxableYear, rate: Decimal) kind institutional {
    label en unofficial "the fourth lowest rate of tax applicable under section 1(c) — EXTERNAL_DEPENDENCY, same as `third_lowest_section_1c_rate`";
}
@source(IRC_S3402_R, relation = formalizes, coverage = partial, quote = "shall deduct and withhold from such payment a tax in an amount equal to such payment's proportionate share of the annualized tax")
rule Section3402IndianCasinoWithholdingDutyRule(pay: WagePayment, payer: Person, payee: Person, on: Date, amount: Money) strict {
    when wage_payment(pay, payer, payee, _, _, on) and indian_casino_payment(pay, amount);
    then duty Section3402IndianCasinoWithholdingDuty {
        bearer payer;
        beneficiary Secretary;
        goal achievement {
            condition income_tax_withheld(pay, amount);
            window [on, on];
        }
    };
}

// (t) rate of withholding for qualified stock under section 83(i): the rate
// floor ("not less than the maximum rate of tax in effect under section 1")
// is again an EXTERNAL_DEPENDENCY on `income_individual`'s top bracket;
// classification = EXTERNAL_DEPENDENCY, not modelled as a rule.

// --- Section 3403: liability for tax ----------------------------------------

pub relation employer_liable_for_withheld_tax(employer: Person, pay: WagePayment) kind institutional {
    label en official "the employer's liability for the section 3402 tax on this payment";
}
@source(IRC_S3403, relation = formalizes, coverage = exact, quote = "The employer shall be liable for the payment of the tax required to be deducted and withheld under this chapter")
rule Section3403Liability(pay: WagePayment, employer: Person, on: Date, amount: Money) strict {
    when wage_payment(pay, employer, _, _, _, on) and income_tax_withheld(pay, amount);
    then employer_liable_for_withheld_tax(employer, pay);
}
@source(IRC_S3403, relation = formalizes, coverage = exact, quote = "and shall not be liable to any person for the amount of any such payment")
rule Section3403IndemnificationImmunity(pay: WagePayment, employer: Person, employee: Person, on: Date, amount: Money) strict {
    when wage_payment(pay, employer, employee, _, _, on) and income_tax_withheld(pay, amount);
    then immunity Section3403EmployerIndemnifiedImmunity {
        holder employer;
        protected_effect owes_employee_withheld_amount(employer, employee, pay);
        window [on, infinity);
    };
}
relation owes_employee_withheld_amount(employer: Person, employee: Person, pay: WagePayment) kind institutional {
    label en unofficial "would-be claim of the employee against the employer for the amount lawfully withheld under section 3402 — the immunity's protected effect, never itself asserted true";
}

// --- Section 3404: return and payment by governmental employer -------------
//
// Same administrative-designation shape as section 3126 in
// `03-fica-administrative.law`: WHO among the government's officers/employees
// may file, not a separate substantive tax rule. classification =
// NON_NORMATIVE.
