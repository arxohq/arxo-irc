// 26 U.S.C. §3304(a)(1)-(19) — requirements for the approval of a State law.
// Stage 3 (26.09.2026, TECH_GAP reduction, DECISION-0379). Status:
// implemented_unverified — scenarios are written, not executed.
//
// METHOD. Stage 2b (08-futa.law) kept one case fact per numbered condition
// (`state_law_meets_3304_condition`) and the Secretary of Labor's approval as
// an external institutional act (DECISION-0194). This module opens the
// conditions:
//  (a) the content a State law must provide, clause by clause, as the enum
//      `Section3304aProvision` and the empirical `state_law_provides` (the
//      Secretary's finding about the law's text is a fact of the case); each
//      numbered condition is DERIVED from its provisions
//      (`state_law_satisfies_3304a_paragraph`), and all nineteen give
//      `state_law_provides_all_3304a_requirements`;
//  (b) the Secretary of Labor's duty to approve within 30 days a law he finds
//      provides them (a duty with a computed window);
//  (c) what the conditions mean for CONDUCT under the law, as case-level
//      positions and derivations: the two-year waiting period, the immediate
//      deposit, the permitted uses of withdrawals (A)-(G), the prohibitions of
//      denial (refusal of work, training, interstate claims, pregnancy,
//      cancellation of wage credits, rollover pensions), the required denials
//      (between academic terms and vacation periods, sports seasons, alien
//      status), the retroactive payment entitlement, the pension reduction
//      test, the duties of information, interest and withholding.
// "Substantially less favorable", "reasonable assurance" and the like are
// evaluative findings of the State agency and stay case facts (DECISION-0194).
// The permissions ("may be denied", "may provide") are liberties of the State.
//
// The approval itself (`state_law_approved_by_secretary_of_labor`) and the
// paragraph facts of 08-futa.law are unchanged.

use self::{
    IRC_S3304_A,
    Person,
    Secretary,
    SecretaryOfLabor,
    Section3304ApprovalCondition,
    TaxableYear,
    state_law_approved_by_secretary_of_labor,
};

pub enum Section3304aProvision {
    P01PublicEmploymentOffices;
    P02TwoYearWaitingPeriod;
    P03ImmediateDepositToTrustFund;
    P04WithdrawalsSolelyForCompensationAndRefunds;
    P05aNoDenialForStrikeVacancy;
    P05bNoDenialForLessFavorableWork;
    P05cNoDenialForUnionCondition;
    P06aSameTermsForSection3309Service;
    P06aiDenialBetweenTermsInstructionalStaff;
    P06aiiIIRetroactivePayment;
    P06aiiiDenialInVacationOrHolidayRecess;
    P06aivEducationalServiceAgencyEmployees;
    P07WorkRequiredBeforeNextBenefitYear;
    P08NoDenialForApprovedTraining;
    P09aNoDenialForClaimOrResidenceInAnotherState;
    P09bParticipationInCombinedWageArrangements;
    P10NoCancellationOfWageCreditsExceptForMisconductFraudOrDisqualifyingIncome;
    P11ExtendedCompensation;
    P12NoDenialForPregnancy;
    P13SportsSeasonDenial;
    P14aAlienStatusRestriction;
    P14bUniformAlienStatusInformation;
    P14cPreponderanceOfEvidenceForAlienStatus;
    P15aPensionReduction;
    P15bNoReductionForRolloverDistributions;
    P16aWageInformationToStateProgram;
    P16bWageInformationToNationalDirectoryOfNewHires;
    P16cSafeguardsForInformation;
    P17TimelyInterestPaymentOnFederalAdvances;
    P18VoluntaryFederalIncomeTaxWithholding;
    P19LegislativePowerToAmendOrRepeal;
    label en unofficial "the clauses of section 3304(a)(1)-(19) that the State law must provide (one member per required clause; the permissive clauses are liberties)";
}
pub relation state_law_provides(state: Person, y: TaxableYear, provision: Section3304aProvision) kind empirical {
    label en official "the State law provides the clause (a finding about the text of the State law, made by the Secretary of Labor)";
}
pub relation state_law_satisfies_3304a_paragraph(state: Person, y: TaxableYear, condition: Section3304ApprovalCondition) kind institutional {
    label en official "the State law provides everything the numbered paragraph of section 3304(a) requires";
}
rule S3304a1Paragraph defeasible {
    label en official "(1) all compensation is to be paid through public employment offices or agencies the Secretary of Labor approves";
    for state: Person;
    for y: TaxableYear;
    when state_law_provides(state, y, P01PublicEmploymentOffices);
    then state_law_satisfies_3304a_paragraph(state, y, PublicEmploymentOfficePayment);
}
rule S3304a2Paragraph defeasible {
    label en official "(2) no compensation is payable for any day of unemployment within 2 years after the first day of the first period for which contributions are required";
    for state: Person;
    for y: TaxableYear;
    when state_law_provides(state, y, P02TwoYearWaitingPeriod);
    then state_law_satisfies_3304a_paragraph(state, y, TwoYearWaitingPeriod);
}
rule S3304a3Paragraph defeasible {
    label en official "(3) all money received in the unemployment fund is immediately paid over to the Secretary of the Treasury for the Unemployment Trust Fund";
    for state: Person;
    for y: TaxableYear;
    when state_law_provides(state, y, P03ImmediateDepositToTrustFund);
    then state_law_satisfies_3304a_paragraph(state, y, ImmediateDepositToUnemploymentTrustFund);
}
rule S3304a4Paragraph defeasible {
    label en official "(4) all money withdrawn is used solely for compensation and the listed refunds (with the exceptions of (A)-(G))";
    for state: Person;
    for y: TaxableYear;
    when state_law_provides(state, y, P04WithdrawalsSolelyForCompensationAndRefunds);
    then state_law_satisfies_3304a_paragraph(state, y, RestrictedWithdrawalUse);
}
rule S3304a5Paragraph defeasible {
    label en official "(5) compensation is not denied for refusing new work under the three listed conditions";
    for state: Person;
    for y: TaxableYear;
    when state_law_provides(state, y, P05aNoDenialForStrikeVacancy)
        and state_law_provides(state, y, P05bNoDenialForLessFavorableWork)
        and state_law_provides(state, y, P05cNoDenialForUnionCondition);
    then state_law_satisfies_3304a_paragraph(state, y, NoDenialForRefusingSubstandardWork);
}
rule S3304a6Paragraph defeasible {
    label en official "(6) compensation on section 3309(a)(1) service is payable on the same terms, with the mandatory denials of (A)(i), (iii), (iv) and the retroactive payment of (A)(ii)(II)";
    for state: Person;
    for y: TaxableYear;
    when state_law_provides(state, y, P06aSameTermsForSection3309Service)
        and state_law_provides(state, y, P06aiDenialBetweenTermsInstructionalStaff)
        and state_law_provides(state, y, P06aiiIIRetroactivePayment)
        and state_law_provides(state, y, P06aiiiDenialInVacationOrHolidayRecess)
        and state_law_provides(state, y, P06aivEducationalServiceAgencyEmployees);
    then state_law_satisfies_3304a_paragraph(state, y, Section3309aParityAndAcademicYearRules);
}
rule S3304a7Paragraph defeasible {
    label en official "(7) work since the beginning of the benefit year is required to qualify in the next";
    for state: Person;
    for y: TaxableYear;
    when state_law_provides(state, y, P07WorkRequiredBeforeNextBenefitYear);
    then state_law_satisfies_3304a_paragraph(state, y, RequalificationAfterBenefitYear);
}
rule S3304a8Paragraph defeasible {
    label en official "(8) compensation is not denied for a week in approved training";
    for state: Person;
    for y: TaxableYear;
    when state_law_provides(state, y, P08NoDenialForApprovedTraining);
    then state_law_satisfies_3304a_paragraph(state, y, NoDenialForApprovedTraining);
}
rule S3304a9Paragraph defeasible {
    label en official "(9) no denial or reduction for a claim or residence in another State; participation in combined-wage arrangements";
    for state: Person;
    for y: TaxableYear;
    when state_law_provides(state, y, P09aNoDenialForClaimOrResidenceInAnotherState)
        and state_law_provides(state, y, P09bParticipationInCombinedWageArrangements);
    then state_law_satisfies_3304a_paragraph(state, y, InterstateClaimNonDiscrimination);
}
rule S3304a10Paragraph defeasible {
    label en official "(10) no cancellation of wage credits or total reduction of benefit rights except for misconduct, fraud or disqualifying income";
    for state: Person;
    for y: TaxableYear;
    when state_law_provides(state, y, P10NoCancellationOfWageCreditsExceptForMisconductFraudOrDisqualifyingIncome);
    then state_law_satisfies_3304a_paragraph(state, y, NoDenialExceptMisconductFraudOrDisqualifyingIncome);
}
rule S3304a11Paragraph defeasible {
    label en official "(11) extended compensation is payable as provided by the Federal-State Extended Unemployment Compensation Act of 1970";
    for state: Person;
    for y: TaxableYear;
    when state_law_provides(state, y, P11ExtendedCompensation);
    then state_law_satisfies_3304a_paragraph(state, y, ExtendedCompensationPayable);
}
rule S3304a12Paragraph defeasible {
    label en official "(12) no denial solely on the basis of pregnancy or its termination";
    for state: Person;
    for y: TaxableYear;
    when state_law_provides(state, y, P12NoDenialForPregnancy);
    then state_law_satisfies_3304a_paragraph(state, y, NoPregnancyDiscrimination);
}
rule S3304a13Paragraph defeasible {
    label en official "(13) no compensation on the basis of professional sports services between seasons";
    for state: Person;
    for y: TaxableYear;
    when state_law_provides(state, y, P13SportsSeasonDenial);
    then state_law_satisfies_3304a_paragraph(state, y, ProfessionalAthleteOffSeasonDenial);
}
rule S3304a14Paragraph defeasible {
    label en official "(14) alien status: the restriction, uniform information, preponderance of the evidence";
    for state: Person;
    for y: TaxableYear;
    when state_law_provides(state, y, P14aAlienStatusRestriction)
        and state_law_provides(state, y, P14bUniformAlienStatusInformation)
        and state_law_provides(state, y, P14cPreponderanceOfEvidenceForAlienStatus);
    then state_law_satisfies_3304a_paragraph(state, y, AlienStatusVerification);
}
rule S3304a15Paragraph defeasible {
    label en official "(15) reduction for pensions, with no reduction for rollover distributions";
    for state: Person;
    for y: TaxableYear;
    when state_law_provides(state, y, P15aPensionReduction)
        and state_law_provides(state, y, P15bNoReductionForRolloverDistributions);
    then state_law_satisfies_3304a_paragraph(state, y, PensionOffset);
}
rule S3304a16Paragraph defeasible {
    label en official "(16) wage information to the State program and to the National Directory of New Hires, with safeguards";
    for state: Person;
    for y: TaxableYear;
    when state_law_provides(state, y, P16aWageInformationToStateProgram)
        and state_law_provides(state, y, P16bWageInformationToNationalDirectoryOfNewHires)
        and state_law_provides(state, y, P16cSafeguardsForInformation);
    then state_law_satisfies_3304a_paragraph(state, y, WageInformationDisclosure);
}
rule S3304a17Paragraph defeasible {
    label en official "(17) interest on title XII advances paid timely and not from the State's unemployment fund";
    for state: Person;
    for y: TaxableYear;
    when state_law_provides(state, y, P17TimelyInterestPaymentOnFederalAdvances);
    then state_law_satisfies_3304a_paragraph(state, y, TimelyInterestPaymentOnAdvances);
}
rule S3304a18Paragraph defeasible {
    label en official "(18) Federal income tax is withheld from compensation on the individual's voluntary request";
    for state: Person;
    for y: TaxableYear;
    when state_law_provides(state, y, P18VoluntaryFederalIncomeTaxWithholding);
    then state_law_satisfies_3304a_paragraph(state, y, VoluntaryFederalIncomeTaxWithholding);
}
rule S3304a19Paragraph defeasible {
    label en official "(19) rights, privileges and immunities are subject to the legislature's power to amend or repeal";
    for state: Person;
    for y: TaxableYear;
    when state_law_provides(state, y, P19LegislativePowerToAmendOrRepeal);
    then state_law_satisfies_3304a_paragraph(state, y, LegislativeAmendmentReservation);
}
pub relation state_law_provides_all_3304a_requirements(state: Person, y: TaxableYear) kind institutional {
    label en official "the State law provides everything the nineteen paragraphs of section 3304(a) require";
}
@source(IRC_S3304_A, relation = formalizes, coverage = partial, quote = "which he finds provides that—")
rule S3304aAllNineteenParagraphs defeasible {
    label en official "all nineteen numbered paragraphs are satisfied";
    for state: Person;
    for y: TaxableYear;
    when state_law_satisfies_3304a_paragraph(state, y, PublicEmploymentOfficePayment)
        and state_law_satisfies_3304a_paragraph(state, y, TwoYearWaitingPeriod)
        and state_law_satisfies_3304a_paragraph(state, y, ImmediateDepositToUnemploymentTrustFund)
        and state_law_satisfies_3304a_paragraph(state, y, RestrictedWithdrawalUse)
        and state_law_satisfies_3304a_paragraph(state, y, NoDenialForRefusingSubstandardWork)
        and state_law_satisfies_3304a_paragraph(state, y, Section3309aParityAndAcademicYearRules)
        and state_law_satisfies_3304a_paragraph(state, y, RequalificationAfterBenefitYear)
        and state_law_satisfies_3304a_paragraph(state, y, NoDenialForApprovedTraining)
        and state_law_satisfies_3304a_paragraph(state, y, InterstateClaimNonDiscrimination)
        and state_law_satisfies_3304a_paragraph(state, y, NoDenialExceptMisconductFraudOrDisqualifyingIncome)
        and state_law_satisfies_3304a_paragraph(state, y, ExtendedCompensationPayable)
        and state_law_satisfies_3304a_paragraph(state, y, NoPregnancyDiscrimination)
        and state_law_satisfies_3304a_paragraph(state, y, ProfessionalAthleteOffSeasonDenial)
        and state_law_satisfies_3304a_paragraph(state, y, AlienStatusVerification)
        and state_law_satisfies_3304a_paragraph(state, y, PensionOffset)
        and state_law_satisfies_3304a_paragraph(state, y, WageInformationDisclosure)
        and state_law_satisfies_3304a_paragraph(state, y, TimelyInterestPaymentOnAdvances)
        and state_law_satisfies_3304a_paragraph(state, y, VoluntaryFederalIncomeTaxWithholding)
        and state_law_satisfies_3304a_paragraph(state, y, LegislativeAmendmentReservation);
    then state_law_provides_all_3304a_requirements(state, y);
}

// ---- (b) the Secretary of Labor's duty to approve within 30 days ------------

pub relation state_law_submitted_for_approval_on(state: Person, y: TaxableYear, submittedOn: Date) kind empirical {
    label en official "the State law is submitted to the Secretary of Labor on this date";
}
pub relation secretary_of_labor_finds_state_law_provides_3304a_requirements(state: Person, y: TaxableYear) kind empirical {
    label en official "the Secretary of Labor finds that the State law provides the requirements of subsection (a) (the finding is his own act: DECISION-0194, the authority the text names)";
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "The Secretary of Labor shall approve any State law submitted to him, within 30 days of such submission")
pub rule S3304aApprovalDutyRule defeasible {
    label en official "the Secretary of Labor shall approve within 30 days of submission a State law he finds provides the requirements";
    for state: Person;
    for y: TaxableYear;
    for submittedOn: Date;
    when state_law_submitted_for_approval_on(state, y, submittedOn)
        and secretary_of_labor_finds_state_law_provides_3304a_requirements(state, y);
    then duty S3304aApprovalDuty {
        bearer SecretaryOfLabor;
        beneficiary state;
        goal achievement {
            condition state_law_approved_by_secretary_of_labor(state, y);
            window [submittedOn, add_calendar_period(submittedOn, 30 calendar_day)];
        }
    };
}

// ---- (2) waiting period -----------------------------------------------------

pub relation first_period_with_required_contributions_begins(state: Person, start: Date) kind empirical {
    label en official "the first day of the first period with respect to which contributions are required";
}
pub relation state_pays_compensation_for_day(state: Person, individual: Person, day: Date) kind empirical {
    label en official "the State pays compensation with respect to a day of unemployment";
}
pub relation day_within_two_year_waiting_period(state: Person, day: Date) kind institutional {
    label en official "the day of unemployment occurs within 2 years after the first day of the first period with respect to which contributions are required";
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "(2) no compensation shall be payable with respect to any day of unemployment occurring within 2 years after the first day of the first period with respect to which contributions are required")
rule S3304a2DayWithinWaitingPeriod defeasible {
    label en official "a day on or after the start and before two calendar years after it";
    for state: Person;
    for day: Date;
    for start: Date;
    when first_period_with_required_contributions_begins(state, start)
        and state_pays_compensation_for_day(state, _, day)
        and day >= start
        and day < add_calendar_period(start, 2 calendar_year);
    then day_within_two_year_waiting_period(state, day);
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "no compensation shall be payable with respect to any day of unemployment occurring within 2 years")
pub rule S3304a2NoCompensationInWaitingPeriod defeasible {
    label en official "no compensation may be paid for a day within the waiting period";
    for state: Person;
    for individual: Person;
    for day: Date;
    when day_within_two_year_waiting_period(state, day)
        and state_pays_compensation_for_day(state, individual, day);
    then prohibition S3304a2NoPaymentInWaitingPeriodProhibition {
        bearer state;
        action state_pays_compensation_for_day(state, individual, day);
        window [day, day];
    };
}

// ---- (3) immediate deposit ---------------------------------------------------

pub relation money_received_in_unemployment_fund(state: Person, receipt: Person, amount: Money, on: Date) kind empirical {
    label en official "money is received in the unemployment fund of the State (receipt identifies the payment)";
}
pub relation money_received_is_refund_of_erroneous_payment_or_3305b_refund(state: Person, receipt: Person) kind empirical {
    label en official "the sum is a refund of sums erroneously paid into the fund or a refund paid in accordance with section 3305(b)";
}
pub relation money_paid_over_to_unemployment_trust_fund(state: Person, receipt: Person) kind empirical {
    label en official "the money is paid over to the Secretary of the Treasury to the credit of the Unemployment Trust Fund established by section 904 of the Social Security Act";
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "immediately upon such receipt be paid over to the Secretary of the Treasury to the credit of the Unemployment Trust Fund")
pub rule S3304a3PayOverImmediately defeasible {
    label en official "money received in the fund is paid over immediately (the day of receipt), except refunds of erroneous sums and section 3305(b) refunds";
    for state: Person;
    for receipt: Person;
    for amount: Money;
    for on: Date;
    when money_received_in_unemployment_fund(state, receipt, amount, on);
    then duty S3304a3PayOverDuty {
        bearer state;
        beneficiary Secretary;
        goal achievement {
            condition money_paid_over_to_unemployment_trust_fund(state, receipt);
            window [on, on];
        }
    };
    unless money_received_is_refund_of_erroneous_payment_or_3305b_refund(state, receipt) and money_received_in_unemployment_fund(state, receipt, amount, on);
}

// ---- (4) permitted uses of withdrawals ---------------------------------------

pub enum FundWithdrawalUse {
    PaymentOfCompensation;
    RefundOfSumsErroneouslyPaid;
    RefundUnderSection3305b;
    DisabilityBenefitsFromEmployeePayments;          // (A)
    AdministrationExpensesUnderSSA903;                // (B)
    ElectedHealthInsuranceOrTaxWithholdingDeduction;  // (C)
    RepaymentOfOverpaymentsUnderSSA303g;              // (D)
    ShortTimeCompensation;                            // (E)
    SelfEmploymentAssistanceAllowances;               // (F)
    FeesOnCoveredUnemploymentCompensationDebt;        // (G)(i)
    TransferOfPenaltiesAndInterestOnCoveredDebt;      // (G)(ii)
    AnyOtherUse;
    label en unofficial "the uses of money withdrawn from a State unemployment fund";
}
pub relation state_fund_withdrawal(state: Person, y: TaxableYear, use: FundWithdrawalUse, amount: Money) kind empirical {
    label en official "money is withdrawn from the unemployment fund of the State for the use";
}
pub relation employee_payments_into_fund(state: Person, y: TaxableYear, total: Money) kind empirical {
    label en official "the amount of employee payments into the unemployment fund of the State";
}
pub relation withdrawal_use_conditions_met(state: Person, y: TaxableYear, use: FundWithdrawalUse) kind empirical {
    label en official "the conditions the clause attaches to the use are met: for (B) the conditions of section 903(c)(2) or (d)(4) of the Social Security Act; for (C) the individual elected the deduction and it was made under a program approved by the Secretary of Labor; for (D) the deduction is as provided in section 303(g); for (E) and (F) the program is one defined in section 3306(v) or (t); for (G) the debt is covered unemployment compensation debt collected under section 6402(f)";
}
pub relation withdrawal_use_permitted_3304a4(state: Person, y: TaxableYear, use: FundWithdrawalUse) kind institutional {
    label en official "the use of withdrawn money is one section 3304(a)(4) allows (the main clause or one of the exceptions (A)-(G))";
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "all money withdrawn from the unemployment fund of the State shall be used solely in the payment of unemployment compensation, exclusive of expenses of administration, and for refunds of sums erroneously paid into such fund and refunds paid in accordance with the provisions of section 3305(b)")
rule S3304a4MainClause defeasible {
    label en official "payment of compensation and refunds are permitted";
    for state: Person;
    for y: TaxableYear;
    for use: FundWithdrawalUse;
    for amount: Money;
    when state_fund_withdrawal(state, y, use, amount)
        and (use == PaymentOfCompensation or use == RefundOfSumsErroneouslyPaid);
    then withdrawal_use_permitted_3304a4(state, y, use);
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "refunds paid in accordance with the provisions of section 3305(b)")
rule S3304a4Section3305bRefund defeasible {
    label en official "refunds under section 3305(b) are permitted";
    for state: Person;
    for y: TaxableYear;
    for amount: Money;
    when state_fund_withdrawal(state, y, RefundUnderSection3305b, amount);
    then withdrawal_use_permitted_3304a4(state, y, RefundUnderSection3305b);
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "(A) an amount equal to the amount of employee payments into the unemployment fund of a State may be used in the payment of cash benefits to individuals with respect to their disability, exclusive of expenses of administration;")
rule S3304a4ADisabilityBenefits defeasible {
    label en official "(A) disability benefits up to the amount of employee payments into the fund";
    for state: Person;
    for y: TaxableYear;
    for amount: Money;
    for total: Money;
    when state_fund_withdrawal(state, y, DisabilityBenefitsFromEmployeePayments, amount)
        and employee_payments_into_fund(state, y, total)
        and amount <= total;
    then withdrawal_use_permitted_3304a4(state, y, DisabilityBenefitsFromEmployeePayments);
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "(B) the amounts specified by section 903 (c)(2) or 903(d)(4) of the Social Security Act may, subject to the conditions prescribed in such section")
rule S3304a4BAdministrationExpenses defeasible {
    label en official "(B) administration expenses within the conditions of SSA section 903";
    for state: Person;
    for y: TaxableYear;
    for amount: Money;
    when state_fund_withdrawal(state, y, AdministrationExpensesUnderSSA903, amount)
        and withdrawal_use_conditions_met(state, y, AdministrationExpensesUnderSSA903);
    then withdrawal_use_permitted_3304a4(state, y, AdministrationExpensesUnderSSA903);
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "if the individual elected to have such deduction made and such deduction was made under a program approved by the Secretary of Labor")
rule S3304a4CElectedDeduction defeasible {
    label en official "(C) elected health insurance or tax withholding deduction under an approved program";
    for state: Person;
    for y: TaxableYear;
    for amount: Money;
    when state_fund_withdrawal(state, y, ElectedHealthInsuranceOrTaxWithholdingDeduction, amount)
        and withdrawal_use_conditions_met(state, y, ElectedHealthInsuranceOrTaxWithholdingDeduction);
    then withdrawal_use_permitted_3304a4(state, y, ElectedHealthInsuranceOrTaxWithholdingDeduction);
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "(D) amounts shall be deducted from unemployment benefits and used to repay overpayments as provided in section 303(g) of the Social Security Act;")
rule S3304a4DOverpayments defeasible {
    label en official "(D) repayment of overpayments as provided in SSA section 303(g)";
    for state: Person;
    for y: TaxableYear;
    for amount: Money;
    when state_fund_withdrawal(state, y, RepaymentOfOverpaymentsUnderSSA303g, amount)
        and withdrawal_use_conditions_met(state, y, RepaymentOfOverpaymentsUnderSSA303g);
    then withdrawal_use_permitted_3304a4(state, y, RepaymentOfOverpaymentsUnderSSA303g);
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "(E) amounts may be withdrawn for the payment of short-time compensation under a short-time compensation program (as defined under section 3306(v));")
rule S3304a4EShortTime defeasible {
    label en official "(E) short-time compensation";
    for state: Person;
    for y: TaxableYear;
    for amount: Money;
    when state_fund_withdrawal(state, y, ShortTimeCompensation, amount)
        and withdrawal_use_conditions_met(state, y, ShortTimeCompensation);
    then withdrawal_use_permitted_3304a4(state, y, ShortTimeCompensation);
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "(F) amounts may be withdrawn for the payment of allowances under a self-employment assistance program (as defined in section 3306(t)); and")
rule S3304a4FSelfEmployment defeasible {
    label en official "(F) self-employment assistance allowances";
    for state: Person;
    for y: TaxableYear;
    for amount: Money;
    when state_fund_withdrawal(state, y, SelfEmploymentAssistanceAllowances, amount)
        and withdrawal_use_conditions_met(state, y, SelfEmploymentAssistanceAllowances);
    then withdrawal_use_permitted_3304a4(state, y, SelfEmploymentAssistanceAllowances);
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "(i) amounts may be deducted to pay any fees authorized under such section; and")
rule S3304a4GiFees defeasible {
    label en official "(G)(i) fees on covered unemployment compensation debt";
    for state: Person;
    for y: TaxableYear;
    for amount: Money;
    when state_fund_withdrawal(state, y, FeesOnCoveredUnemploymentCompensationDebt, amount)
        and withdrawal_use_conditions_met(state, y, FeesOnCoveredUnemploymentCompensationDebt);
    then withdrawal_use_permitted_3304a4(state, y, FeesOnCoveredUnemploymentCompensationDebt);
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "(ii) the penalties and interest described in section 6402(f)(4)(C) may be transferred to the appropriate State fund")
rule S3304a4GiiTransfer defeasible {
    label en official "(G)(ii) transfer of penalties and interest on covered debt";
    for state: Person;
    for y: TaxableYear;
    for amount: Money;
    when state_fund_withdrawal(state, y, TransferOfPenaltiesAndInterestOnCoveredDebt, amount)
        and withdrawal_use_conditions_met(state, y, TransferOfPenaltiesAndInterestOnCoveredDebt);
    then withdrawal_use_permitted_3304a4(state, y, TransferOfPenaltiesAndInterestOnCoveredDebt);
}
pub relation state_fund_withdrawal_outside_3304a4(state: Person, y: TaxableYear, use: FundWithdrawalUse) kind institutional {
    label en official "money withdrawn for a use that section 3304(a)(4) does not allow";
}
rule S3304a4WithdrawalOutside defeasible {
    label en official "a withdrawal whose use is not permitted";
    for state: Person;
    for y: TaxableYear;
    for use: FundWithdrawalUse;
    for amount: Money;
    when state_fund_withdrawal(state, y, use, amount)
        and not_known(withdrawal_use_permitted_3304a4(state, y, use));
    then state_fund_withdrawal_outside_3304a4(state, y, use);
}

// ---- (5) refusal of new work -------------------------------------------------

pub enum RefusedWorkGround {
    PositionVacantDueToLaborDispute;      // (A)
    ConditionsSubstantiallyLessFavorable; // (B), an evaluative finding of the agency
    RequiredToJoinCompanyUnionOrLeaveLaborOrganization; // (C)
    label en unofficial "the grounds of section 3304(a)(5) on which refusing new work cannot ground a denial";
}
pub relation refusal_of_new_work_ground(state: Person, individual: Person, offer: Person, ground: RefusedWorkGround) kind empirical {
    label en official "the otherwise eligible individual refused new work and the ground holds (the finding of the State agency)";
}
pub relation state_denies_compensation_for_refusal(state: Person, individual: Person, offer: Person) kind empirical {
    label en official "the State denies compensation to the otherwise eligible individual for refusing the offered work";
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "compensation shall not be denied in such State to any otherwise eligible individual for refusing to accept new work under any of the following conditions")
pub rule S3304a5NoDenialForRefusal defeasible {
    label en official "no denial for refusing work on any of the three grounds";
    for state: Person;
    for individual: Person;
    for offer: Person;
    for ground: RefusedWorkGround;
    when refusal_of_new_work_ground(state, individual, offer, ground)
        and state_denies_compensation_for_refusal(state, individual, offer);
    then prohibition S3304a5NoDenialForRefusalProhibition {
        bearer state;
        beneficiary individual;
        action state_denies_compensation_for_refusal(state, individual, offer);
        window [-infinity, infinity];
    };
}

// ---- (6) section 3309(a)(1) service --------------------------------------------

pub enum EducationalCapacity {
    InstructionalResearchOrPrincipalAdministrative;
    OtherCapacity;
    label en unofficial "the capacity in which services are performed for an educational institution";
}
pub relation educational_week(state: Person, individual: Person, week: Date, capacity: EducationalCapacity) kind empirical {
    label en official "the week (identified by its first day) for which compensation based on section 3309(a)(1) services for an educational institution is claimed";
}
pub relation week_between_two_successive_academic_years_or_terms(individual: Person, week: Date) kind empirical {
    label en official "the week commences in the period between two successive academic years or terms (or a similar period between two regular terms)";
}
pub relation performed_services_in_first_term(individual: Person) kind empirical {
    label en official "the individual performs the services in the first of the academic years or terms";
}
pub relation contract_or_reasonable_assurance_for_second_term(individual: Person) kind empirical {
    label en official "there is a contract or reasonable assurance (an evaluative finding of the agency) that the individual will perform services in any such capacity for any educational institution in the second term";
}
pub relation compensation_not_payable_between_terms(state: Person, individual: Person, week: Date) kind institutional {
    label en official "compensation shall not be payable for the week (clause (i))";
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "compensation shall not be payable based on such services for any week commencing during the period between two successive academic years or terms")
rule S3304a6AiNotPayableBetweenTerms defeasible {
    label en official "instructional, research or principal administrative services: not payable between successive terms when services were performed and assurance exists";
    for state: Person;
    for individual: Person;
    for week: Date;
    when educational_week(state, individual, week, InstructionalResearchOrPrincipalAdministrative)
        and week_between_two_successive_academic_years_or_terms(individual, week)
        and performed_services_in_first_term(individual)
        and contract_or_reasonable_assurance_for_second_term(individual);
    then compensation_not_payable_between_terms(state, individual, week);
}
pub relation reasonable_assurance_for_second_term(individual: Person) kind empirical {
    label en official "there is a reasonable assurance (an evaluative finding of the agency) that the individual will perform such services in the second term";
}
pub relation compensation_may_be_denied_between_terms(state: Person, individual: Person, week: Date) kind institutional {
    label en official "compensation on the basis of other services may be denied for the week (clause (ii)(I))";
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "compensation payable on the basis of such services may be denied to any individual for any week which commences during a period between 2 successive academic years or terms")
rule S3304a6AiiIMayDeny defeasible {
    label en official "other capacities: the State may deny between terms with performance and reasonable assurance";
    for state: Person;
    for individual: Person;
    for week: Date;
    when educational_week(state, individual, week, OtherCapacity)
        and week_between_two_successive_academic_years_or_terms(individual, week)
        and performed_services_in_first_term(individual)
        and reasonable_assurance_for_second_term(individual);
    then compensation_may_be_denied_between_terms(state, individual, week);
}
pub relation denied_under_6A_ii_I(state: Person, individual: Person, week: Date) kind empirical {
    label en official "compensation was denied for the week under subclause (I)";
}
pub relation individual_not_offered_second_term_opportunity(individual: Person) kind empirical {
    label en official "the individual was not offered an opportunity to perform the services for the educational institution for the second term";
}
pub relation timely_claim_filed_for_week(individual: Person, week: Date) kind empirical {
    label en official "the individual filed a timely claim for compensation for the week";
}
pub relation retroactive_payment_made(state: Person, individual: Person, week: Date) kind empirical {
    label en official "the retroactive payment of the compensation for the week was made";
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "such individual shall be entitled to a retroactive payment of the compensation for each week for which the individual filed a timely claim for compensation and for which compensation was denied solely by reason of subclause (I)")
pub rule S3304a6AiiIIRetroactivePayment defeasible {
    label en official "a denial under (I) without an offer of the second-term work entitles the individual to retroactive payment of the weeks claimed in time";
    for state: Person;
    for individual: Person;
    for week: Date;
    when denied_under_6A_ii_I(state, individual, week)
        and individual_not_offered_second_term_opportunity(individual)
        and timely_claim_filed_for_week(individual, week);
    then duty S3304a6AiiIIRetroactivePaymentDuty {
        bearer state;
        beneficiary individual;
        goal achievement {
            condition retroactive_payment_made(state, individual, week);
            window [week, infinity];
        }
    };
}
pub relation week_in_vacation_period_or_holiday_recess(individual: Person, week: Date) kind empirical {
    label en official "the week commences during an established and customary vacation period or holiday recess";
}
pub relation performed_services_before_recess(individual: Person) kind empirical {
    label en official "the individual performs the services in the period immediately before the vacation period or holiday recess";
}
pub relation reasonable_assurance_after_recess(individual: Person) kind empirical {
    label en official "there is a reasonable assurance (an evaluative finding) that the individual will perform the services in the period immediately following the recess";
}
pub relation compensation_not_payable_in_recess(state: Person, individual: Person, week: Date) kind institutional {
    label en official "compensation shall be denied for the week in the vacation period or holiday recess (clause (iii)); may be denied for services described in clause (ii) (clause (vi))";
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "compensation payable on the basis of such services shall be denied to any individual for any week which commences during an established and customary vacation period or holiday recess")
rule S3304a6AiiiNotPayableInRecess defeasible {
    label en official "vacation or recess week with services before and assurance after";
    for state: Person;
    for individual: Person;
    for week: Date;
    for capacity: EducationalCapacity;
    when educational_week(state, individual, week, capacity)
        and week_in_vacation_period_or_holiday_recess(individual, week)
        and performed_services_before_recess(individual)
        and reasonable_assurance_after_recess(individual)
        and capacity == InstructionalResearchOrPrincipalAdministrative;
    then compensation_not_payable_in_recess(state, individual, week);
}
pub relation compensation_may_be_denied_in_recess(state: Person, individual: Person, week: Date) kind institutional {
    label en official "for services described in clause (ii) clauses (iii) and (iv) apply with \"may be denied\" (clause (vi))";
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "with respect to services described in clause (ii), clauses (iii) and (iv) shall be applied by substituting \"may be denied\" for \"shall be denied\"")
rule S3304a6AviMayDenyInRecessOtherCapacity defeasible {
    label en official "other capacities: permission instead of obligation";
    for state: Person;
    for individual: Person;
    for week: Date;
    when educational_week(state, individual, week, OtherCapacity)
        and week_in_vacation_period_or_holiday_recess(individual, week)
        and performed_services_before_recess(individual)
        and reasonable_assurance_after_recess(individual);
    then compensation_may_be_denied_in_recess(state, individual, week);
}
pub relation employed_by_educational_service_agency(individual: Person) kind empirical {
    label en official "the individual performed the services in an educational institution while in the employ of an educational service agency (a governmental agency or entity established and operated exclusively to provide such services to educational institutions)";
}
pub relation compensation_denial_extended_to_service_agency_employee(state: Person, individual: Person, week: Date) kind institutional {
    label en official "clause (iv): the denials of (i), (ii) and (iii) apply to the employee of an educational service agency";
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "to any individual who performed such services in an educational institution while in the employ of an educational service agency")
rule S3304a6AivServiceAgencyEmployees defeasible {
    label en official "the denial of clause (i) reaches the employee of an educational service agency";
    for state: Person;
    for individual: Person;
    for week: Date;
    when employed_by_educational_service_agency(individual)
        and compensation_not_payable_between_terms(state, individual, week);
    then compensation_denial_extended_to_service_agency_employee(state, individual, week);
}
pub relation compensation_may_be_denied_on_behalf_of_institution(state: Person, individual: Person, week: Date) kind institutional {
    label en official "clause (v): services provided to or on behalf of an educational institution: compensation may be denied under the same circumstances";
}
pub relation services_provided_on_behalf_of_educational_institution(individual: Person) kind empirical {
    label en official "the services are provided to or on behalf of an educational institution";
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "if such services are provided to or on behalf of an educational institution, compensation may be denied under the same circumstances as described in clauses (i) through (iv)")
rule S3304a6AvOnBehalf defeasible {
    label en official "services on behalf of an educational institution: permission to deny";
    for state: Person;
    for individual: Person;
    for week: Date;
    when services_provided_on_behalf_of_educational_institution(individual)
        and compensation_not_payable_between_terms(state, individual, week);
    then compensation_may_be_denied_on_behalf_of_institution(state, individual, week);
}
pub relation state_law_accepts_payments_in_lieu_of_contributions(state: Person, y: TaxableYear) kind empirical {
    label en official "the State law allows payments in lieu of contributions into the State unemployment fund on the basis set forth in section 3309(a)(2)";
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "(B) payments (in lieu of contributions) with respect to service to which section 3309(a)(1) applies may be made into the State unemployment fund on the basis set forth in section 3309(a)(2)")
rule S3304a6BPaymentsInLieu defeasible {
    label en official "a State law submitted for approval may allow payments in lieu of contributions";
    for state: Person;
    for y: TaxableYear;
    for submittedOn: Date;
    when state_law_submitted_for_approval_on(state, y, submittedOn);
    then liberty S3304a6BPaymentsInLieuLiberty {
        holder state;
        against SecretaryOfLabor;
        action state_law_accepts_payments_in_lieu_of_contributions(state, y);
        window [submittedOn, infinity];
    };
}

// ---- (7) requalification, (8) training, (9), (10), (12) ------------------------

pub relation received_compensation_in_benefit_year(state: Person, individual: Person) kind empirical {
    label en official "the individual has received compensation during his benefit year";
}
pub relation had_work_since_beginning_of_benefit_year(individual: Person) kind empirical {
    label en official "the individual has had work since the beginning of the benefit year";
}
pub relation no_work_since_beginning_of_benefit_year(individual: Person) kind empirical {
    label en official "the individual has had no work since the beginning of the benefit year";
}
pub relation qualifies_for_next_benefit_year(state: Person, individual: Person) kind institutional {
    label en official "the individual meets the work requirement for qualifying in the next benefit year";
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "an individual who has received compensation during his benefit year is required to have had work since the beginning of such year in order to qualify for compensation in his next benefit year")
rule S3304a7WorkRequirementMet defeasible {
    label en official "received compensation and had work: qualifies";
    for state: Person;
    for individual: Person;
    when received_compensation_in_benefit_year(state, individual)
        and had_work_since_beginning_of_benefit_year(individual);
    then qualifies_for_next_benefit_year(state, individual);
}
pub relation does_not_qualify_for_next_benefit_year(state: Person, individual: Person) kind institutional {
    label en official "the individual received compensation and had no work since the beginning of the benefit year: does not qualify";
}
rule S3304a7WorkRequirementFailed defeasible {
    label en official "received compensation and no work: does not qualify";
    for state: Person;
    for individual: Person;
    when received_compensation_in_benefit_year(state, individual)
        and no_work_since_beginning_of_benefit_year(individual);
    then does_not_qualify_for_next_benefit_year(state, individual);
}
pub relation individual_in_state_approved_training_for_week(individual: Person, week: Date) kind empirical {
    label en official "the individual is in training with the approval of the State agency for the week";
}
pub relation state_denies_compensation_for_week(state: Person, individual: Person, week: Date) kind empirical {
    label en official "the State denies compensation for the week (including by applying availability, active search or refusal-of-work provisions to the week in training)";
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "compensation shall not be denied to an individual for any week because he is in training with the approval of the State agency")
pub rule S3304a8NoDenialForApprovedTraining defeasible {
    label en official "no denial for a week in approved training";
    for state: Person;
    for individual: Person;
    for week: Date;
    when individual_in_state_approved_training_for_week(individual, week)
        and state_denies_compensation_for_week(state, individual, week);
    then prohibition S3304a8NoDenialForTrainingProhibition {
        bearer state;
        beneficiary individual;
        action state_denies_compensation_for_week(state, individual, week);
        window [-infinity, infinity];
    };
}
pub relation claim_filed_in_or_resides_in_another_state(individual: Person) kind empirical {
    label en official "the individual files a claim in another State (or a contiguous country with an agreement) or resides in another State (such a country) when he files";
}
pub relation state_denies_or_reduces_compensation_solely_for_interstate_claim(state: Person, individual: Person) kind empirical {
    label en official "the State denies or reduces compensation solely because of the claim or residence";
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "compensation shall not be denied or reduced to an individual solely because he files a claim in another State")
pub rule S3304a9ANoDenialForInterstateClaim defeasible {
    label en official "no denial or reduction solely for an out-of-State claim or residence";
    for state: Person;
    for individual: Person;
    when claim_filed_in_or_resides_in_another_state(individual)
        and state_denies_or_reduces_compensation_solely_for_interstate_claim(state, individual);
    then prohibition S3304a9ANoDenialForInterstateClaimProhibition {
        bearer state;
        beneficiary individual;
        action state_denies_or_reduces_compensation_solely_for_interstate_claim(state, individual);
        window [-infinity, infinity];
    };
}
pub relation combined_wage_arrangement_approved(state: Person, y: TaxableYear) kind empirical {
    label en official "an arrangement for paying compensation by combining wages and employment covered under several State laws is approved by the Secretary of Labor";
}
pub relation state_participates_in_combined_wage_arrangement(state: Person, y: TaxableYear) kind empirical {
    label en official "the State participates in the approved arrangement (with a single base period and no duplicate use of wages)";
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "the State shall participate in any arrangements for the payment of compensation on the basis of combining an individual's wages and employment covered under the State law")
pub rule S3304a9BParticipate defeasible {
    label en official "the State shall participate in an approved combined-wage arrangement";
    for state: Person;
    for y: TaxableYear;
    when combined_wage_arrangement_approved(state, y);
    then duty S3304a9BParticipateDuty {
        bearer state;
        beneficiary SecretaryOfLabor;
        goal maintenance {
            condition state_participates_in_combined_wage_arrangement(state, y);
            window [-infinity, infinity];
        }
    };
}
pub enum WageCreditCancellationCause {
    MisconductConnectedWithWork;
    FraudInConnectionWithClaim;
    ReceiptOfDisqualifyingIncome;
    AnyOtherCause;
    label en unofficial "the causes of cancellation of wage credits or total reduction of benefit rights";
}
pub relation state_cancels_wage_credits_for(state: Person, individual: Person, cause: WageCreditCancellationCause) kind empirical {
    label en official "the State cancels wage credits or totally reduces benefit rights of the individual for the cause";
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "compensation shall not be denied to any individual by reason of cancellation of wage credits or total reduction of his benefit rights for any cause other than discharge for misconduct connected with his work, fraud in connection with a claim for compensation, or receipt of disqualifying income")
pub rule S3304a10NoCancellationForOtherCauses defeasible {
    label en official "cancellation of wage credits for a cause other than misconduct, fraud or disqualifying income is not allowed";
    for state: Person;
    for individual: Person;
    when state_cancels_wage_credits_for(state, individual, AnyOtherCause);
    then prohibition S3304a10NoCancellationProhibition {
        bearer state;
        beneficiary individual;
        action state_cancels_wage_credits_for(state, individual, AnyOtherCause);
        window [-infinity, infinity];
    };
}
pub relation state_denies_compensation_solely_for_pregnancy(state: Person, individual: Person) kind empirical {
    label en official "the State denies compensation solely on the basis of pregnancy or termination of pregnancy";
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "no person shall be denied compensation under such State law solely on the basis of pregnancy or termination of pregnancy")
pub rule S3304a12NoDenialForPregnancy defeasible {
    label en official "no denial solely for pregnancy";
    for state: Person;
    for individual: Person;
    when state_denies_compensation_solely_for_pregnancy(state, individual);
    then prohibition S3304a12NoDenialForPregnancyProhibition {
        bearer state;
        beneficiary individual;
        action state_denies_compensation_solely_for_pregnancy(state, individual);
        window [-infinity, infinity];
    };
}

// ---- (13) professional sports between seasons ----------------------------------

pub relation sports_services_week(state: Person, individual: Person, week: Date) kind empirical {
    label en official "compensation is claimed on the basis of services substantially all of which consist of participating in sports or athletic events or training or preparing to so participate, for the week (substantially all: an evaluative finding of the case)";
}
pub relation week_between_sport_seasons(individual: Person, week: Date) kind empirical {
    label en official "the week commences during the period between two successive sport seasons (or similar periods)";
}
pub relation performed_sports_services_in_first_season(individual: Person) kind empirical {
    label en official "the individual performed such services in the first of the seasons";
}
pub relation reasonable_assurance_of_sports_services_in_later_season(individual: Person) kind empirical {
    label en official "there is a reasonable assurance that the individual will perform such services in the later season";
}
pub relation compensation_not_payable_between_sport_seasons(state: Person, individual: Person, week: Date) kind institutional {
    label en official "compensation shall not be payable for the week";
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "compensation shall not be payable to any individual on the basis of any services, substantially all of which consist of participating in sports or athletic events")
rule S3304a13NotPayableBetweenSeasons defeasible {
    label en official "sports services between seasons with performance and assurance";
    for state: Person;
    for individual: Person;
    for week: Date;
    when sports_services_week(state, individual, week)
        and week_between_sport_seasons(individual, week)
        and performed_sports_services_in_first_season(individual)
        and reasonable_assurance_of_sports_services_in_later_season(individual);
    then compensation_not_payable_between_sport_seasons(state, individual, week);
}

// ---- (14) alien status -------------------------------------------------------------

pub enum AlienStatusAtTimeOfServices {
    LawfullyAdmittedForPermanentResidence;
    LawfullyPresentForPurposeOfPerformingServices;
    PermanentlyResidingUnderColorOfLaw;
    OtherStatus;
    label en unofficial "the status of an alien at the time the services were performed (section 3304(a)(14)(A); an alien lawfully present by reason of section 212(d)(5) of the Immigration and Nationality Act is lawfully present)";
}
pub relation services_performed_by_alien(state: Person, individual: Person, status: AlienStatusAtTimeOfServices) kind empirical {
    label en official "compensation is claimed on the basis of services performed by an alien who had the status when the services were performed";
}
pub relation compensation_not_payable_for_alien_services(state: Person, individual: Person) kind institutional {
    label en official "compensation shall not be payable on the basis of services performed by an alien without one of the three statuses";
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "compensation shall not be payable on the basis of services performed by an alien unless such alien is an individual who was lawfully admitted for permanent residence at the time such services were performed")
rule S3304a14AOtherStatusNotPayable defeasible {
    label en official "an alien with none of the three statuses";
    for state: Person;
    for individual: Person;
    when services_performed_by_alien(state, individual, OtherStatus);
    then compensation_not_payable_for_alien_services(state, individual);
}
pub relation alien_status_information_required_of(state: Person, applicant: Person) kind empirical {
    label en official "the State requires the data or information for the alien-status determination from the applicant";
}
pub relation alien_status_information_required_of_all_applicants(state: Person) kind empirical {
    label en official "the State requires that information uniformly from all applicants for compensation";
}
pub relation alien_status_information_requirement_non_uniform(state: Person, applicant: Person) kind institutional {
    label en official "the information is required of the applicant but not uniformly of all applicants";
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "shall be uniformly required from all applicants for compensation")
rule S3304a14BNonUniform defeasible {
    label en official "required of an applicant, without uniform requirement of all applicants: contrary to (B)";
    for state: Person;
    for applicant: Person;
    when alien_status_information_required_of(state, applicant)
        and not_known(alien_status_information_required_of_all_applicants(state));
    then alien_status_information_requirement_non_uniform(state, applicant);
}
pub relation alien_status_determination_made(state: Person, individual: Person) kind empirical {
    label en official "the State agency determines that compensation is not payable because of alien status for an individual whose application would otherwise be approved";
}
pub relation determination_on_preponderance_of_evidence(state: Person, individual: Person) kind empirical {
    label en official "the determination is made upon a preponderance of the evidence";
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "no determination by the State agency that compensation to such individual is not payable because of his alien status shall be made except upon a preponderance of the evidence")
pub rule S3304a14CPreponderance defeasible {
    label en official "an alien-status determination requires a preponderance of the evidence (an unsupported determination is prohibited)";
    for state: Person;
    for individual: Person;
    when alien_status_determination_made(state, individual)
        and not_known(determination_on_preponderance_of_evidence(state, individual));
    then prohibition S3304a14CDeterminationWithoutPreponderanceProhibition {
        bearer state;
        beneficiary individual;
        action alien_status_determination_made(state, individual);
        window [-infinity, infinity];
    };
}

// ---- (15) pensions -----------------------------------------------------------------

pub relation pension_payment(state: Person, individual: Person, payment: Person) kind empirical {
    label en official "the individual receives a governmental or other pension, retirement or retired pay, annuity, or similar periodic payment based on previous work";
}
pub relation pension_under_plan_of_base_period_or_chargeable_employer(payment: Person) kind empirical {
    label en official "clause (i)(I): the payment is under a plan maintained (or contributed to) by a base period employer or chargeable employer";
}
pub relation pension_under_social_security_or_railroad_retirement_act(payment: Person) kind empirical {
    label en official "the payment is made under the Social Security Act or the Railroad Retirement Act of 1974 (or corresponding provisions of prior law)";
}
pub relation services_after_base_period_start_affect_pension(payment: Person) kind empirical {
    label en official "clause (i)(II): services performed for the employer after the beginning of the base period (or the remuneration) affect eligibility for, or increase the amount of, the payment";
}
pub relation pension_is_rollover_distribution_not_includible(payment: Person) kind empirical {
    label en official "the payment is not includible in gross income for the year paid because it is part of a rollover distribution";
}
pub relation pension_reduction_requirement_applies(payment: Person) kind institutional {
    label en official "the reduction requirement applies to the payment (clause (i)(I) and (II))";
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "the requirements of this paragraph shall apply to any pension, retirement or retired pay, annuity, or other similar periodic payment only if—")
rule S3304a15AiApplicability defeasible {
    label en official "a plan of a base period or chargeable employer, and (unless under the Social Security or Railroad Retirement Act) services affect the payment";
    for payment: Person;
    when pension_under_plan_of_base_period_or_chargeable_employer(payment)
        and services_after_base_period_start_affect_pension(payment);
    then pension_reduction_requirement_applies(payment);
}
rule S3304a15AiSocialSecurityOrRailroad defeasible {
    label en official "payments under the Social Security Act or Railroad Retirement Act need only (I)";
    for payment: Person;
    when pension_under_plan_of_base_period_or_chargeable_employer(payment)
        and pension_under_social_security_or_railroad_retirement_act(payment);
    then pension_reduction_requirement_applies(payment);
}
pub relation weekly_compensation_reduction_by_pension(state: Person, individual: Person, payment: Person, week: Date, reasonablyAttributable: Money, weeklyAmount: Money) kind empirical {
    label en official "the week's compensation before the reduction and the part of the pension reasonably attributable to the week";
}
pub relation reduced_weekly_compensation(state: Person, individual: Person, week: Date, amount: Money) kind institutional {
    label en official "the week's compensation reduced (but not below zero) by the amount of the pension reasonably attributable to the week";
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "shall be reduced (but not below zero) by an amount equal to the amount of such pension, retirement or retired pay, annuity, or other payment, which is reasonably attributable to such week")
rule S3304a15AReducedCompensation defeasible {
    label en official "reduce by the attributable amount, not below zero; weeks beginning after March 31, 1980";
    for state: Person;
    for individual: Person;
    for payment: Person;
    for week: Date;
    for attributable: Money;
    for weekly: Money;
    when weekly_compensation_reduction_by_pension(state, individual, payment, week, attributable, weekly)
        and pension_payment(state, individual, payment)
        and pension_reduction_requirement_applies(payment)
        and not_known(pension_is_rollover_distribution_not_includible_exists(payment))
        and week > @1980-03-31
        and weekly > attributable;
    then reduced_weekly_compensation(state, individual, week, weekly - attributable);
}
relation pension_is_rollover_distribution_not_includible_exists(payment: Person) kind institutional;
rule PensionRolloverExists defeasible {
    for payment: Person;
    when pension_is_rollover_distribution_not_includible(payment);
    then pension_is_rollover_distribution_not_includible_exists(payment);
}
rule S3304a15AReducedToZero defeasible {
    label en official "a pension at least equal to the weekly amount reduces it to zero";
    for state: Person;
    for individual: Person;
    for payment: Person;
    for week: Date;
    for attributable: Money;
    for weekly: Money;
    when weekly_compensation_reduction_by_pension(state, individual, payment, week, attributable, weekly)
        and pension_payment(state, individual, payment)
        and pension_reduction_requirement_applies(payment)
        and not_known(pension_is_rollover_distribution_not_includible_exists(payment))
        and week > @1980-03-31
        and weekly <= attributable;
    then reduced_weekly_compensation(state, individual, week, 0.00 USD);
}
pub relation state_law_limits_reduction_for_individual_contributions(state: Person, y: TaxableYear) kind empirical {
    label en official "the State law provides limitations on the amount of the reduction to take into account contributions made by the individual for the pension";
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "the State law may provide for limitations on the amount of any such a reduction to take into account contributions made by the individual")
rule S3304a15AiiMayLimitReduction defeasible {
    label en official "a State law submitted for approval may limit the reduction for the individual's own contributions";
    for state: Person;
    for y: TaxableYear;
    for submittedOn: Date;
    when state_law_submitted_for_approval_on(state, y, submittedOn);
    then liberty S3304a15AiiLimitReductionLiberty {
        holder state;
        against SecretaryOfLabor;
        action state_law_limits_reduction_for_individual_contributions(state, y);
        window [submittedOn, infinity];
    };
}
pub relation state_reduces_compensation_for_rollover_pension(state: Person, individual: Person, payment: Person) kind empirical {
    label en official "the State reduces compensation on account of a pension payment that is part of a rollover distribution";
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "the amount of compensation shall not be reduced on account of any payments of governmental or other pensions, retirement or retired pay, annuity, or other similar payments which are not includible in the gross income of the individual for the taxable year in which it was paid because it was part of a rollover distribution")
pub rule S3304a15BNoReductionForRollover defeasible {
    label en official "no reduction for a rollover distribution";
    for state: Person;
    for individual: Person;
    for payment: Person;
    when pension_is_rollover_distribution_not_includible(payment)
        and state_reduces_compensation_for_rollover_pension(state, individual, payment);
    then prohibition S3304a15BNoReductionForRolloverProhibition {
        bearer state;
        beneficiary individual;
        action state_reduces_compensation_for_rollover_pension(state, individual, payment);
        window [-infinity, infinity];
    };
}

// ---- (16) information, (17) interest, (18) withholding ----------------------------------

pub relation state_or_subdivision_requests_wage_information(state: Person, requester: Person, requestedOn: Date) kind empirical {
    label en official "a State or political subdivision specifically requests wage information necessary (as the Secretary of Health and Human Services determines in regulations) for eligibility for assistance under a title IV part A program";
}
pub relation wage_information_made_available_to_requester(state: Person, requester: Person) kind empirical {
    label en official "the wage information was made available";
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "shall be made available to a State or political subdivision thereof when such information is specifically requested by such State or political subdivision for such purposes")
pub rule S3304a16AWageInformationDutyRule defeasible {
    label en official "wage information is made available on a specific request (no deadline stated: open window)";
    for state: Person;
    for requester: Person;
    for requestedOn: Date;
    when state_or_subdivision_requests_wage_information(state, requester, requestedOn);
    then duty S3304a16AWageInformationDuty {
        bearer state;
        beneficiary requester;
        goal achievement {
            condition wage_information_made_available_to_requester(state, requester);
            window [requestedOn, infinity];
        }
    };
}
pub relation state_agency_records_needed_for_national_directory(state: Person, y: TaxableYear) kind empirical {
    label en official "wage and unemployment compensation information in the records is necessary for the purposes of the National Directory of New Hires under section 453(i) of the Social Security Act";
}
pub relation information_furnished_to_secretary_of_health_and_human_services(state: Person, y: TaxableYear) kind empirical {
    label en official "the information was furnished to the Secretary of Health and Human Services in accordance with his regulations";
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "wage and unemployment compensation information contained in the records of such agency shall be furnished to the Secretary of Health and Human Services")
pub rule S3304a16BNationalDirectoryDutyRule defeasible {
    label en official "information necessary for the National Directory of New Hires is furnished to the Secretary of Health and Human Services";
    for state: Person;
    for y: TaxableYear;
    when state_agency_records_needed_for_national_directory(state, y);
    then duty S3304a16BNationalDirectoryDuty {
        bearer state;
        goal maintenance {
            condition information_furnished_to_secretary_of_health_and_human_services(state, y);
            window [-infinity, infinity];
        }
    };
}
pub relation state_establishes_safeguards_for_furnished_information(state: Person, y: TaxableYear) kind empirical {
    label en official "such safeguards are established as are necessary (as determined by the Secretary of Health and Human Services in regulations) to insure that the information is used only for the authorized purposes";
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "such safeguards are established as are necessary (as determined by the Secretary of Health and Human Services in regulations) to insure that information furnished under subparagraph (A) or (B) is used only for the purposes authorized under such subparagraph")
pub rule S3304a16CSafeguardsDutyRule defeasible {
    label en official "safeguards are maintained while information is furnished";
    for state: Person;
    for y: TaxableYear;
    when information_furnished_to_secretary_of_health_and_human_services(state, y);
    then duty S3304a16CSafeguardsDuty {
        bearer state;
        goal maintenance {
            condition state_establishes_safeguards_for_furnished_information(state, y);
            window [-infinity, infinity];
        }
    };
}
pub relation title_xii_advance_interest_due(state: Person, y: TaxableYear, dueOn: Date) kind empirical {
    label en official "interest on advances under title XII of the Social Security Act is required to be paid, due on this date";
}
pub relation title_xii_interest_paid_on(state: Person, y: TaxableYear, paidOn: Date) kind empirical {
    label en official "the interest was paid on this date";
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "any interest required to be paid on advances under title XII of the Social Security Act shall be paid in a timely manner")
pub rule S3304a17TimelyInterest defeasible {
    label en official "interest on advances is paid by its due date";
    for state: Person;
    for y: TaxableYear;
    for dueOn: Date;
    when title_xii_advance_interest_due(state, y, dueOn);
    then duty S3304a17TimelyInterestDuty {
        bearer state;
        goal achievement {
            condition title_xii_interest_paid_by_deadline(state, y);
            window [-infinity, dueOn];
        }
    };
}
pub relation title_xii_interest_paid_by_deadline(state: Person, y: TaxableYear) kind empirical {
    label en official "the interest was paid in time";
}
pub relation title_xii_interest_paid_from_state_fund(state: Person, y: TaxableYear) kind empirical {
    label en official "the interest is paid, directly or indirectly (by an equivalent reduction in State unemployment taxes or otherwise), from amounts in the State's unemployment fund";
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "shall not be paid, directly or indirectly (by an equivalent reduction in State unemployment taxes or otherwise) by such State from amounts in such State's unemployment fund")
pub rule S3304a17NotFromFund defeasible {
    label en official "no payment of the interest from the State's unemployment fund";
    for state: Person;
    for y: TaxableYear;
    when title_xii_interest_paid_from_state_fund(state, y);
    then prohibition S3304a17InterestFromFundProhibition {
        bearer state;
        action title_xii_interest_paid_from_state_fund(state, y);
        window [-infinity, infinity];
    };
}
pub relation individual_voluntarily_requests_withholding(state: Person, individual: Person, requestedOn: Date) kind empirical {
    label en official "an individual receiving compensation voluntarily requests the deduction and withholding of Federal individual income tax";
}
pub relation federal_income_tax_withheld_from_compensation(state: Person, individual: Person) kind empirical {
    label en official "the tax is deducted and withheld from the compensation";
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "Federal individual income tax from unemployment compensation is to be deducted and withheld if an individual receiving such compensation voluntarily requests such deduction and withholding")
pub rule S3304a18WithholdOnRequest defeasible {
    label en official "tax is withheld from compensation on the individual's request (no time stated: open window)";
    for state: Person;
    for individual: Person;
    for requestedOn: Date;
    when individual_voluntarily_requests_withholding(state, individual, requestedOn);
    then duty S3304a18WithholdOnRequestDuty {
        bearer state;
        beneficiary individual;
        goal achievement {
            condition federal_income_tax_withheld_from_compensation(state, individual);
            window [requestedOn, infinity];
        }
    };
}

// ---- (19) legislature's power over the law ------------------------------------------------

pub relation legislature_amends_or_repeals_state_law_on(state: Person, on: Date) kind empirical {
    label en official "the State legislature amends or repeals the law";
}
@source(IRC_S3304_A, relation = formalizes, coverage = exact, quote = "all the rights, privileges, or immunities conferred by such law or by acts done pursuant thereto shall exist subject to the power of the legislature to amend or repeal such law at any time")
pub rule S3304a19LegislaturePower defeasible {
    label en official "the legislature may amend or repeal the law at any time";
    for state: Person;
    for on: Date;
    when legislature_amends_or_repeals_state_law_on(state, on);
    then power S3304a19AmendOrRepealPower {
        holder state;
        over state;
        exercise legislature_amends_or_repeals_state_law_on(state, on);
        valid_when state_legislature_holds_reserved_power(state);
        effect create(state_law_amended_or_repealed(state, on));
    };
}
pub relation state_legislature_holds_reserved_power(state: Person) kind empirical {
    label en official "the State law reserves the legislature's power to amend or repeal it at any time";
}
pub relation state_law_amended_or_repealed(state: Person, on: Date) kind institutional {
    label en unofficial "the effect of the legislature's amendment or repeal";
}
