// Chapter 23A (RUIA), sections 3321-3323 scenarios. NOT EXECUTED
// (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.employment version "0.1.1";
namespace "urn:us:irc:employment:clir";

test "S3321-01-EMPLOYER-TAX-FOUR-PERCENT-OF-RAIL-WAGES" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": rail_employer_ruia(entity_ref("urn:test:s3321:t1#er")) { origin case_input; }
        assert "f1": rail_wages_paid_in_month(entity_ref("urn:test:s3321:t1#er"), entity_ref("urn:test:s3321:t1#ee"), @2024-06-01, 5000.00 USD) { origin case_input; }
    }
    // 5000 * 0.04 = 200.00.
    evaluate truth(ruia_employer_tax(entity_ref("urn:test:s3321:t1#er"), @2024-06-01, 200.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S3321-02-TAX-TERMINATED-WHEN-LOANS-REPAID" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": railroad_unemployment_account_loan_balance(@2024-06-01, 0.00 USD, 0.00 USD) { origin case_input; }
    }
    evaluate truth(ruia_tax_terminated_for_month(@2024-06-01));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S3321-02B-TERMINATED-MONTH-BLOCKS-EMPLOYER-TAX" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": rail_employer_ruia(entity_ref("urn:test:s3321:t2#er")) { origin case_input; }
        assert "f1": rail_wages_paid_in_month(entity_ref("urn:test:s3321:t2#er"), entity_ref("urn:test:s3321:t2#ee"), @2024-06-01, 5000.00 USD) { origin case_input; }
        assert "f2": railroad_unemployment_account_loan_balance(@2024-06-01, 0.00 USD, 0.00 USD) { origin case_input; }
    }
    evaluate truth(ruia_employer_tax(entity_ref("urn:test:s3321:t2#er"), @2024-06-01, 200.00 USD));
    expect truth_status == NEITHER;
}

test "S3321-03-EMPLOYEE-REPRESENTATIVE-TAX" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": employee_representative_ruia(entity_ref("urn:test:s3321:t3#rep"), entity_ref("urn:test:s3321:t3#org")) { origin case_input; }
        assert "f1": employee_organization_rail_wages_in_month(entity_ref("urn:test:s3321:t3#org"), entity_ref("urn:test:s3321:t3#rep"), @2024-06-01, 3000.00 USD) { origin case_input; }
    }
    evaluate truth(ruia_representative_tax(entity_ref("urn:test:s3321:t3#rep"), entity_ref("urn:test:s3321:t3#org"), @2024-06-01, 120.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

