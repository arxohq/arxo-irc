// Section 3405 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.employment version "0.1.1";
namespace "urn:us:irc:employment:clir";

test "S3405-01-NONPERIODIC-DISTRIBUTION-10-PERCENT" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": designated_distribution(entity_ref("urn:test:s3405:d1#dist"), entity_ref("urn:test:s3405:d1#payor"), entity_ref("urn:test:s3405:d1#payee"), entity_ref("urn:test:s3405:d1#y2024"), 10000 USD, @2024-06-01, Nonperiodic) { origin case_input; }
    }
    evaluate positions();
    expect position(Section3405NonperiodicWithholdingDuty, ACTIVE);
}

test "S3405-02-ELIGIBLE-ROLLOVER-DIRECT-ROLLOVER-BLOCKS-WITHHOLDING" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": designated_distribution(entity_ref("urn:test:s3405:d2#dist"), entity_ref("urn:test:s3405:d2#payor"), entity_ref("urn:test:s3405:d2#payee"), entity_ref("urn:test:s3405:d2#y2024"), 50000 USD, @2024-06-01, EligibleRollover) { origin case_input; }
        assert "f1": direct_rollover_elected(entity_ref("urn:test:s3405:d2#dist")) { origin case_input; }
    }
    evaluate positions();
    expect not position(Section3405EligibleRolloverWithholdingDuty, ACTIVE);
}
