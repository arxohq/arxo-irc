// Section 3101/3102/3111 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.employment version "0.1.1";
namespace "urn:us:irc:employment:clir";

test "S3101-01-WAGES-BELOW-BASE-FULL-OASDI-AND-HI" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": wage_payment(entity_ref("urn:test:s3101:pay1#pay"), entity_ref("urn:test:s3101:pay1#er"), entity_ref("urn:test:s3101:pay1#ee"), entity_ref("urn:test:s3101:pay1#y2024"), 5000 USD, @2024-03-15) { origin case_input; }
        assert "f1": contribution_and_benefit_base(entity_ref("urn:test:s3101:pay1#y2024"), 168600 USD) { origin case_input; }
    }
    // no exclusion items asserted -> full 5000 is wages_3121; below the base.
    evaluate truth(fica_employee_oasdi_tax(entity_ref("urn:test:s3101:pay1#pay"), 310.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S3101-02-ADDITIONAL-MEDICARE-OVER-THRESHOLD-UNMARRIED" {
    given {
        context {
            legal_time @2024-12-15;
            decision_time @2024-12-15T09:00:00-05:00;
            knowledge_time @2024-12-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": wage_payment(entity_ref("urn:test:s3101:pay2#pay"), entity_ref("urn:test:s3101:pay2#er"), entity_ref("urn:test:s3101:pay2#ee"), entity_ref("urn:test:s3101:pay2#y2024"), 30000 USD, @2024-12-15) { origin case_input; }
        assert "f1": wage_payment(entity_ref("urn:test:s3101:pay2#prior"), entity_ref("urn:test:s3101:pay2#er"), entity_ref("urn:test:s3101:pay2#ee"), entity_ref("urn:test:s3101:pay2#y2024"), 190000 USD, @2024-01-15) { origin case_input; }
        assert "f2": us.irc.income_individual::filing_status(entity_ref("urn:test:s3101:pay2#ee"), entity_ref("urn:test:s3101:pay2#y2024"), us.irc.income_individual::Unmarried) { origin case_input; }
    }
    // prior 190000 + 30000 = 220000, threshold 200000, excess = 20000 * 0.9% = 180.00
    evaluate truth(fica_employee_additional_medicare_tax(entity_ref("urn:test:s3101:pay2#pay"), 180.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S3102-01-EMPLOYER-DUTY-SATISFIED-BY-DEDUCTION" {
    given {
        context {
            legal_time @2024-03-15;
            decision_time @2024-03-15T09:00:00-05:00;
            knowledge_time @2024-03-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": wage_payment(entity_ref("urn:test:s3102:pay1#pay"), entity_ref("urn:test:s3102:pay1#er"), entity_ref("urn:test:s3102:pay1#ee"), entity_ref("urn:test:s3102:pay1#y2024"), 5000 USD, @2024-03-15) { origin case_input; }
        assert "f1": employee_tax_deducted(entity_ref("urn:test:s3102:pay1#pay"), 382.50 USD) { origin case_input; }
    }
    evaluate positions();
    expect position(Section3102DeductDuty, SATISFIED);
}

test "S3111-01-EMPLOYER-TAX-EQUALS-EMPLOYEE-RATE-SCHEDULE" {
    given {
        context {
            legal_time @2024-03-15;
            decision_time @2024-03-15T09:00:00-05:00;
            knowledge_time @2024-03-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": wage_payment(entity_ref("urn:test:s3111:pay1#pay"), entity_ref("urn:test:s3111:pay1#er"), entity_ref("urn:test:s3111:pay1#ee"), entity_ref("urn:test:s3111:pay1#y2024"), 5000 USD, @2024-03-15) { origin case_input; }
        assert "f1": contribution_and_benefit_base(entity_ref("urn:test:s3111:pay1#y2024"), 168600 USD) { origin case_input; }
    }
    evaluate truth(fica_employer_tax(entity_ref("urn:test:s3111:pay1#pay"), 382.50 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
