// Sections 3122-3128 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.employment version "0.1.1";
namespace "urn:us:irc:employment:clir";

test "S3123-01-DEDUCTED-AMOUNT-CONSTRUCTIVELY-PAID" {
    given {
        context {
            legal_time @2024-03-15;
            decision_time @2024-03-15T09:00:00-05:00;
            knowledge_time @2024-03-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": deducted_and_remitted_by_employer(entity_ref("urn:test:s3123:p1#er"), entity_ref("urn:test:s3123:p1#ee"), 100 USD, @2024-03-15) { origin case_input; }
    }
    evaluate truth(constructively_paid_to_employee_3123(entity_ref("urn:test:s3123:p1#ee"), 100 USD, @2024-03-15));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S3127-01-RELIGIOUS-EXEMPTION-BOTH-APPROVED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": wage_payment(entity_ref("urn:test:s3127:pay1#pay"), entity_ref("urn:test:s3127:pay1#er"), entity_ref("urn:test:s3127:pay1#ee"), entity_ref("urn:test:s3127:pay1#y2024"), 3000 USD, @2024-04-15) { origin case_input; }
        assert "f1": religious_sect_member_meeting_1402g1(entity_ref("urn:test:s3127:pay1#er")) { origin case_input; }
        assert "f2": religious_sect_member_meeting_1402g1(entity_ref("urn:test:s3127:pay1#ee")) { origin case_input; }
        assert "f3": religious_exemption_application_approved(entity_ref("urn:test:s3127:pay1#er"), @2024-01-01) { origin case_input; }
        assert "f4": religious_exemption_application_approved(entity_ref("urn:test:s3127:pay1#ee"), @2024-01-01) { origin case_input; }
    }
    evaluate positions();
    expect position(Section3127EmployerExemption, ACTIVE);
}
