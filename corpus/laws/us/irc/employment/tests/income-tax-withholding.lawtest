// Sections 3401-3404 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.employment version "0.1.1";
namespace "urn:us:irc:employment:clir";

test "S3402-01-WITHHOLDING-DUTY-SATISFIED" {
    given {
        context {
            legal_time @2024-03-15;
            decision_time @2024-03-15T09:00:00-05:00;
            knowledge_time @2024-03-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": wage_payment(entity_ref("urn:test:s3402:pay1#pay"), entity_ref("urn:test:s3402:pay1#er"), entity_ref("urn:test:s3402:pay1#ee"), entity_ref("urn:test:s3402:pay1#y2024"), 3000 USD, @2024-03-15) { origin case_input; }
        assert "f1": secretary_prescribed_withholding_amount(entity_ref("urn:test:s3402:pay1#pay"), 450 USD, entity_ref("urn:test:s3402:pay1#pub15t")) { origin case_input; }
        assert "f2": income_tax_withheld(entity_ref("urn:test:s3402:pay1#pay"), 450 USD) { origin case_input; }
    }
    evaluate positions();
    expect position(Section3402WithholdingDuty, SATISFIED);
}

test "S3402-02-EXEMPTION-CERTIFICATE-SUSPENDS-DUTY" {
    given {
        context {
            legal_time @2024-03-15;
            decision_time @2024-03-15T09:00:00-05:00;
            knowledge_time @2024-03-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": wage_payment(entity_ref("urn:test:s3402:pay2#pay"), entity_ref("urn:test:s3402:pay2#er"), entity_ref("urn:test:s3402:pay2#ee"), entity_ref("urn:test:s3402:pay2#y2024"), 500 USD, @2024-03-15) { origin case_input; }
        assert "f1": exemption_certificate_furnished(entity_ref("urn:test:s3402:pay2#ee"), entity_ref("urn:test:s3402:pay2#er"), @2024-01-01) { origin case_input; }
    }
    evaluate truth(employer_no_duty_to_withhold(entity_ref("urn:test:s3402:pay2#er"), entity_ref("urn:test:s3402:pay2#pay")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S3403-01-EMPLOYER-INDEMNIFIED-AGAINST-EMPLOYEE-CLAIM" {
    given {
        context {
            legal_time @2024-03-15;
            decision_time @2024-03-15T09:00:00-05:00;
            knowledge_time @2024-03-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": wage_payment(entity_ref("urn:test:s3403:pay1#pay"), entity_ref("urn:test:s3403:pay1#er"), entity_ref("urn:test:s3403:pay1#ee"), entity_ref("urn:test:s3403:pay1#y2024"), 3000 USD, @2024-03-15) { origin case_input; }
        assert "f1": income_tax_withheld(entity_ref("urn:test:s3403:pay1#pay"), 450 USD) { origin case_input; }
    }
    evaluate positions();
    expect position(Section3403EmployerIndemnifiedImmunity, ACTIVE);
}
