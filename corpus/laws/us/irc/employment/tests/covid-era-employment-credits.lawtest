test "S3134-01-SEVENTY-PERCENT-CREDIT-BELOW-PER-EMPLOYEE-CAP" {
    given {
        context {
            legal_time @2021-08-01;
            decision_time @2021-08-01T09:00:00-05:00;
            knowledge_time @2021-08-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": eligible_employer_3134(entity_ref("urn:test:s3134:t1#er"), @2021-07-01) { origin case_input; }
        assert "f1": qualified_wages_3134_per_employee_quarter(entity_ref("urn:test:s3134:t1#er"), entity_ref("urn:test:s3134:t1#ee"), @2021-07-01, 8000.00 USD, false) { origin case_input; }
    }
    // stage 3: quarter moved into the section 3134(n) window (wages paid after June 30, 2021).
    // capped at 8000 (below $10,000), 70% credit = 5600.00.
    evaluate truth(section_3134_gross_credit(entity_ref("urn:test:s3134:t1#er"), @2021-07-01, 5600.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

