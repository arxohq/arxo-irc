// Sections 3131-3134 (temporary COVID-era credits) scenarios. NOT EXECUTED
// (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.employment version "0.1.1";
namespace "urn:us:irc:employment:clir";

test "S3131-01-DAILY-CAP-EXTENDED-ABOVE-511" {
    given {
        context {
            legal_time @2021-05-01;
            decision_time @2021-05-01T09:00:00-05:00;
            knowledge_time @2021-05-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": qualified_sick_leave_wages_per_day(entity_ref("urn:test:s3131:t1#pay"), entity_ref("urn:test:s3131:t1#er"), entity_ref("urn:test:s3131:t1#ee"), @2021-04-01, @2021-04-15, 600.00 USD, true) { origin case_input; }
    }
    evaluate truth(qualified_sick_leave_wages_capped(entity_ref("urn:test:s3131:t1#pay"), 511.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

