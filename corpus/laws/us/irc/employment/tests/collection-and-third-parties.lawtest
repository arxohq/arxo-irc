// Sections 3501-3512 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.employment version "0.1.1";
namespace "urn:us:irc:employment:clir";

test "S3505-01-THIRD-PARTY-DIRECT-PAYMENT-LIABILITY" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": third_party_paid_wages_directly(entity_ref("urn:test:s3505:t1#lender"), entity_ref("urn:test:s3505:t1#er"), entity_ref("urn:test:s3505:t1#ee"), 5000 USD, @2024-06-01) { origin case_input; }
    }
    evaluate truth(third_party_direct_payment_liability(entity_ref("urn:test:s3505:t1#lender"), entity_ref("urn:test:s3505:t1#er"), 5000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S3509-01-BASE-RATE-LIABILITY-NO-AGGRAVATION" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": misclassified_as_not_employee(entity_ref("urn:test:s3509:m1#er"), entity_ref("urn:test:s3509:m1#ee"), entity_ref("urn:test:s3509:m1#y2024"), 10000 USD, 1530 USD) { origin case_input; }
    }
    evaluate truth(section_3509_special_liability(entity_ref("urn:test:s3509:m1#er"), entity_ref("urn:test:s3509:m1#y2024"), entity_ref("urn:test:s3509:m1#ee"), 150.00 USD, 306.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S3509-02-INTENTIONAL-DISREGARD-BLOCKS-SPECIAL-RATES" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": misclassified_as_not_employee(entity_ref("urn:test:s3509:m2#er"), entity_ref("urn:test:s3509:m2#ee"), entity_ref("urn:test:s3509:m2#y2024"), 10000 USD, 1530 USD) { origin case_input; }
        assert "f1": section_3509_intentional_disregard(entity_ref("urn:test:s3509:m2#er"), entity_ref("urn:test:s3509:m2#ee"), entity_ref("urn:test:s3509:m2#y2024")) { origin case_input; }
