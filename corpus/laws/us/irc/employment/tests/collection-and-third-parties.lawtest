}

test "S3506-01-SITTER-PLACEMENT-FEE-BASIS-NOT-EMPLOYER" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": sitter_placement_service(entity_ref("urn:test:s3506:t1#placer")) { origin case_input; }
        assert "f1": sitter(entity_ref("urn:test:s3506:t1#sitter")) { origin case_input; }
        assert "f2": sitter_placement_no_pay_or_receive_wages(entity_ref("urn:test:s3506:t1#placer"), entity_ref("urn:test:s3506:t1#sitter")) { origin case_input; }
        assert "f3": sitter_placement_compensated_on_fee_basis(entity_ref("urn:test:s3506:t1#placer"), entity_ref("urn:test:s3506:t1#sitter")) { origin case_input; }
    }
    evaluate truth(sitter_placement_service_not_employer(entity_ref("urn:test:s3506:t1#placer"), entity_ref("urn:test:s3506:t1#sitter")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S3506-02-SITTER-PLACEMENT-PAYS-WAGES-NO-EXEMPTION" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": sitter_placement_service(entity_ref("urn:test:s3506:t2#placer")) { origin case_input; }
        assert "f1": sitter(entity_ref("urn:test:s3506:t2#sitter")) { origin case_input; }
        assert "f2": sitter_placement_compensated_on_fee_basis(entity_ref("urn:test:s3506:t2#placer"), entity_ref("urn:test:s3506:t2#sitter")) { origin case_input; }
        // f3 (no-pay-or-receive-wages) NOT asserted: the placer itself pays the sitter's wages.
    }
    evaluate truth(sitter_placement_service_not_employer(entity_ref("urn:test:s3506:t2#placer"), entity_ref("urn:test:s3506:t2#sitter")));
    expect truth_status == NEITHER;
}

test "S3508-01-QUALIFIED-REAL-ESTATE-AGENT-NOT-EMPLOYEE" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": licensed_real_estate_sales_person(entity_ref("urn:test:s3508:t1#agent")) { origin case_input; }
        assert "f1": output_based_remuneration(entity_ref("urn:test:s3508:t1#agent"), QualifiedRealEstateAgent) { origin case_input; }
        assert "f2": written_nonemployee_contract(entity_ref("urn:test:s3508:t1#agent"), QualifiedRealEstateAgent) { origin case_input; }
        assert "f3": performs_services_for(entity_ref("urn:test:s3508:t1#agent"), entity_ref("urn:test:s3508:t1#brokerage")) { origin case_input; }
    }
    evaluate truth(statutory_nonemployee_not_employee(entity_ref("urn:test:s3508:t1#agent"), entity_ref("urn:test:s3508:t1#brokerage")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

