    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": direct_seller_trade_or_business(entity_ref("urn:test:s3508:t3#seller")) { origin case_input; }
        assert "f1": output_based_remuneration(entity_ref("urn:test:s3508:t3#seller"), DirectSeller) { origin case_input; }
        assert "f2": written_nonemployee_contract(entity_ref("urn:test:s3508:t3#seller"), DirectSeller) { origin case_input; }
        assert "f3": performs_services_for(entity_ref("urn:test:s3508:t3#seller"), entity_ref("urn:test:s3508:t3#company")) { origin case_input; }
