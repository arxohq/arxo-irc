test "S70605B4-01-SHORT-YEAR-READ-AS-THE-CALENDAR-YEAR-IT-BEGINS-IN" {
    given {
        context { decision_time @2025-12-01T09:00:00-05:00; knowledge_time @2025-12-01T09:00:00-05:00; legal_time @2025-12-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert us.irc.core::short_year(entity_ref("urn:us:irc:employment:clir#Ys")) { id "f0"; origin case_input; }
        assert us.irc.core::begins(entity_ref("urn:us:irc:employment:clir#Ys"), @2025-03-01) { id "f1"; origin case_input; }
        assert us.irc.core::ends(entity_ref("urn:us:irc:employment:clir#Ys"), @2025-06-30) { id "f2"; origin case_input; }
        assert us.irc.core::calendar_year_of(entity_ref("urn:us:irc:employment:clir#Y2025"), 2025) { id "f3"; origin case_input; }
        assert us.irc.core::begins(entity_ref("urn:us:irc:employment:clir#Y2025"), @2025-01-01) { id "f4"; origin case_input; }
        assert us.irc.core::ends(entity_ref("urn:us:irc:employment:clir#Y2025"), @2025-12-31) { id "f5"; origin case_input; }
    }
    evaluate truth(short_year_read_as_calendar_year(entity_ref("urn:us:irc:employment:clir#Ys"), entity_ref("urn:us:irc:employment:clir#Y2025")));
    expect truth_status == TRUE_ONLY;
}

