            timezone "America/New_York";
        }
        assert "f0": certified_cpeo(entity_ref("urn:test:w10b:c2#o")) { origin case_input; }
    }
    evaluate truth(certified_cpeo(entity_ref("urn:test:w10b:c2#o")));
    expect truth_status == TRUE_ONLY;
}

