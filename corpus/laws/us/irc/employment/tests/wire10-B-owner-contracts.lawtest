// Employment WIRE-10 group B owner-contract scenarios. NOT EXECUTED (implemented_unverified); no legal review.

language "law.core" version "0.2";
package us.irc.employment version "0.1.1";
namespace "urn:us:irc:employment:clir";

test "W10B-EMP-01-CERTIFIED-CPEO-FROM-THE-DEFINITIONS-OWNER" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.definitions::certified_professional_employer_organization(entity_ref("urn:test:w10b:c1#o")) { origin case_input; }
    }
    evaluate truth(certified_cpeo(entity_ref("urn:test:w10b:c1#o")));
    expect truth_status == TRUE_ONLY;
}

test "W10B-EMP-02-CERTIFIED-CPEO-PLACEHOLDER-STILL-ACCEPTS-THE-CASE-FACT" {
    given {
        context {
            legal_time @2024-12-31;
