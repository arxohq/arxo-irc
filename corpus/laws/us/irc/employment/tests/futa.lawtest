test "S3301-01-FUTA-GROSS-TAX-6-PERCENT" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": futa_wages_paid_in_quarter(entity_ref("urn:test:s3301:er1#er"), General, entity_ref("urn:test:s3301:er1#y2024"), 1500 USD) { origin case_input; }
        assert "f1": wage_payment(entity_ref("urn:test:s3301:er1#pay"), entity_ref("urn:test:s3301:er1#er"), entity_ref("urn:test:s3301:er1#ee"), entity_ref("urn:test:s3301:er1#y2024"), 6000 USD, @2024-02-01) { origin case_input; }
    }
    // 6000 wages, below the $7,000 base and no exclusion -> futa_wages = 6000; tax = 6000 * 6% = 360.00
    evaluate truth(futa_gross_tax(entity_ref("urn:test:s3301:er1#er"), entity_ref("urn:test:s3301:er1#y2024"), 360.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

