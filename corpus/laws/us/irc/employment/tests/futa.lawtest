// Sections 3301, 3302, 3306 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.employment version "0.1.1";
namespace "urn:us:irc:employment:clir";

test "S3306A-01-GENERAL-EMPLOYER-THRESHOLD-MET" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": futa_wages_paid_in_quarter(entity_ref("urn:test:s3306a:er1#er"), General, entity_ref("urn:test:s3306a:er1#y2024"), 1500 USD) { origin case_input; }
    }
    evaluate truth(futa_employer(entity_ref("urn:test:s3306a:er1#er"), entity_ref("urn:test:s3306a:er1#y2024")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

