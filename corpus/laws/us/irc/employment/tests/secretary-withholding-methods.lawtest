// Secretary-prescribed withholding computation readers (IRC-G/G5, step 4).
// Each rule gets a вывод / нет-факта-источника pair: with the case-selected
// source fact the statutory consequence derives (TRUE_ONLY); without it
// nothing derives (NEITHER, not a proven negative). Table values in the
// from-table scenarios are the pinned Pub. 15-T (2026) cells (phase 1).
// Expectations come from the statutory text, not from engine output.
// NOT EXECUTED (implemented_unverified): execution waits on CLIR snapshots
// for the new source packages (owner gate, step 6 — as with G4).

language "law.core" version "0.2";
package us.irc.employment version "0.1.1";
namespace "urn:us:irc:employment:clir";

test "S3402B1-01-NON-PAYROLL-PERIOD-DERIVES" {
    given {
        context { legal_time @2026-03-15; decision_time @2026-03-15T09:00:00-05:00; knowledge_time @2026-03-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": non_payroll_period_wages_3402(entity_ref("urn:test:g5w:1#pay")) { origin case_input; }
    }
    evaluate truth(misc_table_period_3402(entity_ref("urn:test:g5w:1#pay"), "daily"));
    expect truth_status == TRUE_ONLY;
}

test "S3402B1-02-WITHOUT-PERIOD-FACT-NEITHER" {
    given {
        context { legal_time @2026-03-15; decision_time @2026-03-15T09:00:00-05:00; knowledge_time @2026-03-15T09:00:00-05:00; timezone "America/New_York"; }
    }
    // no non-payroll-period fact asserted — the (b)(1) mapping is absent.
    evaluate truth(misc_table_period_3402(entity_ref("urn:test:g5w:2#pay"), "daily"));
    expect truth_status == NEITHER;
}

