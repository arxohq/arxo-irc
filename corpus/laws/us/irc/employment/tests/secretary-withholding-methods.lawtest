        assert "f2": other_method_matches_pct_3402h4(entity_ref("urn:test:g5w:61#pay")) { origin case_input; }
        assert "f3": tolerance_lookup_case_3402h4(entity_ref("urn:test:g5w:61#pay"), 50) { origin case_input; }
    }
    // Pub. 15-T (2026) tolerance row r2: required 10–100 → cap = 10 + 10% over 10.
    evaluate truth(other_method_tolerance_3402h4(entity_ref("urn:test:g5w:61#pay"), 10, 0.1, 10));
    expect truth_status == TRUE_ONLY;
}

