test "S3402T-FLOOR-01-DERIVES" {
    given {
        context { legal_time @2026-03-15; decision_time @2026-03-15T09:00:00-05:00; knowledge_time @2026-03-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": wage_payment(entity_ref("urn:test:g5w:73#pay"), entity_ref("urn:test:g5w:73#er"), entity_ref("urn:test:g5w:73#ee"), entity_ref("urn:test:g5w:73#y2026"), 50000.00 USD, @2026-03-15) { origin case_input; }
        assert "f1": qualified_stock_83i_election_3402t(entity_ref("urn:test:g5w:73#pay")) { origin case_input; }
        assert "f2": us.irc.core::begins(entity_ref("urn:test:g5w:73#y2026"), @2026-01-01) { origin case_input; }
        assert "f3": us.irc.income_individual::tcja_bracket_statutory(Joint, 7, 1000000.00 USD, 0.37) { origin case_input; }
        assert "f4": us.irc.income_individual::tcja_bracket_statutory(HeadOfHousehold, 7, 1000000.00 USD, 0.37) { origin case_input; }
        assert "f5": us.irc.income_individual::tcja_bracket_statutory(Unmarried, 7, 1000000.00 USD, 0.37) { origin case_input; }
        assert "f6": us.irc.income_individual::tcja_bracket_statutory(MarriedSeparate, 7, 1000000.00 USD, 0.37) { origin case_input; }
        assert "f7": us.irc.income_individual::tcja_bracket_statutory(EstateOrTrust, 4, 1000000.00 USD, 0.37) { origin case_input; }
    }
    // the (t)(1) floor is the section 1 maximum the income_individual chain derives (0.37 for 2026).
    evaluate truth(qualified_stock_rate_floor_3402t(entity_ref("urn:test:g5w:73#pay"), 0.37));
    expect truth_status == TRUE_ONLY;
}

