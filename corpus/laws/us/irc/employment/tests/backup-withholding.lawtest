// Section 3406 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.employment version "0.1.1";
namespace "urn:us:irc:employment:clir";

test "S3406-01-NO-TIN-TRIGGERS-BACKUP-WITHHOLDING" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": reportable_payment(entity_ref("urn:test:s3406:r1#rp"), entity_ref("urn:test:s3406:r1#payor"), entity_ref("urn:test:s3406:r1#payee"), entity_ref("urn:test:s3406:r1#y2024"), 1000 USD, @2024-06-01, InterestOrDividend) { origin case_input; }
        assert "f1": backup_withholding_trigger(entity_ref("urn:test:s3406:r1#rp"), NoTinFurnished, @2024-06-01) { origin case_input; }
        assert "f2": fourth_lowest_section_1c_rate(entity_ref("urn:test:s3406:r1#y2024"), 0.24) { origin case_input; }
    }
    evaluate positions();
    expect position(Section3406BackupWithholdingDuty, ACTIVE);
}

test "S3406-02-EXCEPTION-BLOCKS-BACKUP-WITHHOLDING" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": reportable_payment(entity_ref("urn:test:s3406:r2#rp"), entity_ref("urn:test:s3406:r2#payor"), entity_ref("urn:test:s3406:r2#payee"), entity_ref("urn:test:s3406:r2#y2024"), 1000 USD, @2024-06-01, InterestOrDividend) { origin case_input; }
        assert "f1": backup_withholding_trigger(entity_ref("urn:test:s3406:r2#rp"), NoTinFurnished, @2024-06-01) { origin case_input; }
        assert "f2": fourth_lowest_section_1c_rate(entity_ref("urn:test:s3406:r2#y2024"), 0.24) { origin case_input; }
        assert "f3": backup_withholding_exception(entity_ref("urn:test:s3406:r2#rp")) { origin case_input; }
    }
    evaluate positions();
    expect not position(Section3406BackupWithholdingDuty, ACTIVE);
}
