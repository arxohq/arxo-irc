// Scenarios for the §3302(c)/(d)/(f)/(g) 2025-slice wiring (IRC-G, step 4/G6):
// the from-pin path of 22-futa-credit-reduction-from-pin.law reading
// us.dol.futa_credit_reduction_2025::futa_credit_reduction_rate under the
// pinned-year/state policy. Each rule has a вывод / нет-факта pair. NOT
// EXECUTED (implemented_unverified — execution waits on CLIR snapshots,
// as with G4/G5). The pre-pin case-fact paths are untouched.

language "law.core" version "0.2";
package us.irc.employment version "0.1.1";
namespace "urn:us:irc:employment:clir";

// --- pinned State reads the table value ---------------------------------------

test "S3302PIN-01-PINNED-STATE-GIVES-TABLE-REDUCTION-RATE" {
    given {
        context { decision_time @2026-02-01T09:00:00-05:00; knowledge_time @2026-02-01T09:00:00-05:00; legal_time @2026-02-01; timezone "America/New_York"; }
        assert "f0": futa_employer_tax_state_key(entity_ref("urn:test:s3302pin:t1#er"), "2025", "California") { origin case_input; }
    }
    evaluate truth(futa_credit_reduction_from_pin(entity_ref("urn:test:s3302pin:t1#er"), "2025", "California", 0.012));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S3302PIN-02-UNPINNED-STATE-GIVES-NO-TABLE-RATE" {
    given {
        context { decision_time @2026-02-01T09:00:00-05:00; knowledge_time @2026-02-01T09:00:00-05:00; legal_time @2026-02-01; timezone "America/New_York"; }
        assert "f0": futa_employer_tax_state_key(entity_ref("urn:test:s3302pin:t2#er"), "2025", "Texas") { origin case_input; }
    }
    evaluate truth(futa_credit_reduction_from_pin(entity_ref("urn:test:s3302pin:t2#er"), "2025", "Texas", 0.012));
    expect truth_status == NEITHER;
}

// --- pinned State carries the (c)(2)(C) waiver ----------------------------------

test "S3302PIN-03-PINNED-STATE-ADDON-WAIVED" {
    given {
        context { decision_time @2026-02-01T09:00:00-05:00; knowledge_time @2026-02-01T09:00:00-05:00; legal_time @2026-02-01; timezone "America/New_York"; }
        assert "f0": futa_employer_tax_state_key(entity_ref("urn:test:s3302pin:t3#er"), "2025", "U.S. Virgin Islands") { origin case_input; }
    }
    evaluate truth(futa_addon_reduction_waived_2025(entity_ref("urn:test:s3302pin:t3#er"), "U.S. Virgin Islands"));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S3302PIN-04-UNPINNED-STATE-ADDON-NOT-WAIVED" {
    given {
        context { decision_time @2026-02-01T09:00:00-05:00; knowledge_time @2026-02-01T09:00:00-05:00; legal_time @2026-02-01; timezone "America/New_York"; }
        assert "f0": futa_employer_tax_state_key(entity_ref("urn:test:s3302pin:t4#er"), "2025", "Texas") { origin case_input; }
    }
    evaluate truth(futa_addon_reduction_waived_2025(entity_ref("urn:test:s3302pin:t4#er"), "Texas"));
    expect truth_status == NEITHER;
}

// --- repaid State is not subject (section 3302(d)(3)) ----------------------------

test "S3302PIN-05-REPAID-STATE-NOT-SUBJECT" {
    given {
        context { decision_time @2026-02-01T09:00:00-05:00; knowledge_time @2026-02-01T09:00:00-05:00; legal_time @2026-02-01; timezone "America/New_York"; }
    }
    evaluate truth(futa_no_credit_reduction_2025("Connecticut"));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S3302PIN-06-OTHER-STATE-NOT-EXCUSED" {
    given {
        context { decision_time @2026-02-01T09:00:00-05:00; knowledge_time @2026-02-01T09:00:00-05:00; legal_time @2026-02-01; timezone "America/New_York"; }
    }
    evaluate truth(futa_no_credit_reduction_2025("Texas"));
    expect truth_status == NEITHER;
}

// --- (g) repayment exception on the statute's own tests ----------------------------

test "S3302PIN-07-REPAYMENT-EXCEPTION-APPLIES" {
    given {
        context { decision_time @2026-02-01T09:00:00-05:00; knowledge_time @2026-02-01T09:00:00-05:00; legal_time @2026-02-01; timezone "America/New_York"; }
        assert "f0": futa_employer_tax_state_key(entity_ref("urn:test:s3302pin:t7#er"), "2025", "Ohio") { origin case_input; }
        assert "f1": futa_state_repayments_cover_potential_taxes("Ohio", "2025") { origin case_input; }
        assert "f2": futa_state_fund_sufficient_without_advances("Ohio", "2025") { origin case_input; }
        assert "f3": futa_state_solvency_increase_covers("Ohio", "2025") { origin case_input; }
    }
    evaluate truth(futa_repayment_exception_applies(entity_ref("urn:test:s3302pin:t7#er"), "2025", "Ohio"));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S3302PIN-08-REPAYMENT-EXCEPTION-MISSING-TEST" {
    given {
        context { decision_time @2026-02-01T09:00:00-05:00; knowledge_time @2026-02-01T09:00:00-05:00; legal_time @2026-02-01; timezone "America/New_York"; }
        assert "f0": futa_employer_tax_state_key(entity_ref("urn:test:s3302pin:t8#er"), "2025", "Ohio") { origin case_input; }
        assert "f1": futa_state_repayments_cover_potential_taxes("Ohio", "2025") { origin case_input; }
        assert "f2": futa_state_fund_sufficient_without_advances("Ohio", "2025") { origin case_input; }
    }
    evaluate truth(futa_repayment_exception_applies(entity_ref("urn:test:s3302pin:t8#er"), "2025", "Ohio"));
    expect truth_status == NEITHER;
}

