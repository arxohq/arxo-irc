test "S3302PIN-09-TRADE-ACT-REDUCTION-APPLIES" {
    given {
        context { decision_time @2026-02-01T09:00:00-05:00; knowledge_time @2026-02-01T09:00:00-05:00; legal_time @2026-02-01; timezone "America/New_York"; }
        assert "f0": futa_employer_tax_state_key(entity_ref("urn:test:s3302pin:t9#er"), "2025", "Ohio") { origin case_input; }
    }
    evaluate truth(futa_trade_act_reduction_applies(entity_ref("urn:test:s3302pin:t9#er"), "2025", "Ohio"));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S3302PIN-10-TRADE-ACT-QUALIFYING-STATE-EXCUSED" {
    given {
        context { decision_time @2026-02-01T09:00:00-05:00; knowledge_time @2026-02-01T09:00:00-05:00; legal_time @2026-02-01; timezone "America/New_York"; }
        assert "f0": futa_employer_tax_state_key(entity_ref("urn:test:s3302pin:t10#er"), "2025", "Ohio") { origin case_input; }
        assert "f1": futa_state_trade_act_ok("Ohio", "2025") { origin case_input; }
    }
    evaluate truth(futa_trade_act_reduction_applies(entity_ref("urn:test:s3302pin:t10#er"), "2025", "Ohio"));
    expect truth_status == NEITHER;
}
