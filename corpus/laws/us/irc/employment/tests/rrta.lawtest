// Chapter 22 (RRTA) scenarios: sections 3201, 3202, 3211, 3221, 3231, 3241.
// NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.employment version "0.1.1";
namespace "urn:us:irc:employment:clir";

test "S3231-01-EMPLOYER-IS-CARRIER" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": carrier_3231g(entity_ref("urn:test:s3231:t1#er")) { origin case_input; }
    }
    evaluate truth(rrta_employer(entity_ref("urn:test:s3231:t1#er"), Carrier));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S3231-02-ELECTRIC-RAILWAY-EXCEPTION-BLOCKS-CARRIER-STATUS" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": carrier_3231g(entity_ref("urn:test:s3231:t2#er")) { origin case_input; }
        assert "f1": electric_railway_not_general_system(entity_ref("urn:test:s3231:t2#er")) { origin case_input; }
    }
    evaluate truth(rrta_employer(entity_ref("urn:test:s3231:t2#er"), Carrier));
    expect truth_status == NEITHER;
}

