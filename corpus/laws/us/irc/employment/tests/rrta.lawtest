test "S3241C-01-TEN-YEAR-AVERAGE-ROUNDED-UP" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f1": account_benefits_ratio_fiscal_year(entity_ref("urn:test:s3241c:t1#y2024"), 1, 5.0) { origin case_input; }
        assert "f2": account_benefits_ratio_fiscal_year(entity_ref("urn:test:s3241c:t1#y2024"), 2, 5.0) { origin case_input; }
        assert "f3": account_benefits_ratio_fiscal_year(entity_ref("urn:test:s3241c:t1#y2024"), 3, 5.0) { origin case_input; }
        assert "f4": account_benefits_ratio_fiscal_year(entity_ref("urn:test:s3241c:t1#y2024"), 4, 5.0) { origin case_input; }
        assert "f5": account_benefits_ratio_fiscal_year(entity_ref("urn:test:s3241c:t1#y2024"), 5, 5.0) { origin case_input; }
        assert "f6": account_benefits_ratio_fiscal_year(entity_ref("urn:test:s3241c:t1#y2024"), 6, 5.0) { origin case_input; }
        assert "f7": account_benefits_ratio_fiscal_year(entity_ref("urn:test:s3241c:t1#y2024"), 7, 5.0) { origin case_input; }
        assert "f8": account_benefits_ratio_fiscal_year(entity_ref("urn:test:s3241c:t1#y2024"), 8, 5.0) { origin case_input; }
        assert "f9": account_benefits_ratio_fiscal_year(entity_ref("urn:test:s3241c:t1#y2024"), 9, 5.05) { origin case_input; }
        assert "f10": account_benefits_ratio_fiscal_year(entity_ref("urn:test:s3241c:t1#y2024"), 10, 5.0) { origin case_input; }
    }
    // average = 50.05 / 10 = 5.005, not a multiple of 0.1 -> rounded UP to 5.1.
    evaluate truth(rrta_average_account_benefits_ratio_derived(entity_ref("urn:test:s3241c:t1#y2024"), 5.1));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

