test "S3201-01-TIER1-EMPLOYEE-TAX-BELOW-BASE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": wage_payment(entity_ref("urn:test:s3201:t1#pay"), entity_ref("urn:test:s3201:t1#er"), entity_ref("urn:test:s3201:t1#ee"), entity_ref("urn:test:s3201:t1#y2024"), 5000 USD, @2024-03-15) { origin case_input; }
        assert "f1": individual_in_service_of_employer_for_compensation(entity_ref("urn:test:s3201:t1#ee"), entity_ref("urn:test:s3201:t1#er")) { origin case_input; }
        assert "f2": contribution_and_benefit_base(entity_ref("urn:test:s3201:t1#y2024"), 168600 USD) { origin case_input; }
    }
    // no section 3231(e)(1) exclusion item asserted -> full 5000 is compensation;
    // tier 1 rate = OASDI(6.2%) + HI(1.45%) = 7.65% * 5000 = 382.50.
    evaluate truth(rrta_tier1_tax(entity_ref("urn:test:s3201:t1#ee"), entity_ref("urn:test:s3201:t1#pay"), 382.50 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S3201-02-TIER2-EMPLOYEE-TAX-BY-RATIO-TABLE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": wage_payment(entity_ref("urn:test:s3201:t2#pay"), entity_ref("urn:test:s3201:t2#er"), entity_ref("urn:test:s3201:t2#ee"), entity_ref("urn:test:s3201:t2#y2024"), 5000 USD, @2024-03-15) { origin case_input; }
        assert "f1": individual_in_service_of_employer_for_compensation(entity_ref("urn:test:s3201:t2#ee"), entity_ref("urn:test:s3201:t2#er")) { origin case_input; }
        assert "f2": rrta_tier2_compensation_base(entity_ref("urn:test:s3201:t2#y2024"), 116100 USD) { origin case_input; }
        assert "f3": rrta_average_account_benefits_ratio(entity_ref("urn:test:s3201:t2#y2024"), 5.5) { origin case_input; }
    }
    // ratio 5.5 falls in the [4.0, 6.1) band -> section 3201(b) rate 4.9%;
    // 5000 * 0.049 = 245.00.
    evaluate truth(rrta_tier2_tax(entity_ref("urn:test:s3201:t2#ee"), entity_ref("urn:test:s3201:t2#pay"), 245.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

