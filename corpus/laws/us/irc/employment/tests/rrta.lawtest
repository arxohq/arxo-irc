test "S3231I-01-COMMON-PAYMASTER-ATTRIBUTION" {
    given {
        context { legal_time @2024-06-01; decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": rrta_common_paymaster(entity_ref("urn:test:s3231i:t1#paymaster"), entity_ref("urn:test:s3231i:t1#employers"), entity_ref("urn:test:s3231i:t1#ee")) { origin case_input; }
        assert "f1": remuneration_disbursed_by(entity_ref("urn:test:s3231i:t1#paymaster"), entity_ref("urn:test:s3231i:t1#ee"), 4000.00 USD, @2024-05-15) { origin case_input; }
    }
    evaluate truth(rrta_corporation_deemed_remuneration(entity_ref("urn:test:s3231i:t1#paymaster"), entity_ref("urn:test:s3231i:t1#ee"), 4000.00 USD, @2024-05-15));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
