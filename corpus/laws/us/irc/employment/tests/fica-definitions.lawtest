test "S3121A-01-SICKNESS-PAYMENT-EXCLUDED-FROM-WAGES" {
    given {
        context {
            legal_time @2024-03-15;
            decision_time @2024-03-15T09:00:00-05:00;
            knowledge_time @2024-03-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": wage_payment(entity_ref("urn:test:s3121a:pay1#pay"), entity_ref("urn:test:s3121a:pay1#er"), entity_ref("urn:test:s3121a:pay1#ee"), entity_ref("urn:test:s3121a:pay1#y2024"), 1000 USD, @2024-03-15) { origin case_input; }
        assert "f1": wage_exclusion_item_3121a(entity_ref("urn:test:s3121a:pay1#pay"), Section3121A2PlanSicknessOrDeathPayment, 1000 USD) { origin case_input; }
    }
    evaluate truth(wages_3121(entity_ref("urn:test:s3121a:pay1#pay"), 0.00 USD));
    expect truth_status == NEITHER;
}

