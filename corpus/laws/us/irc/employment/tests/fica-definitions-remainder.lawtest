        assert secretary_revokes_church_election_on(entity_ref("urn:us:irc:employment:clir#Church1"), @2026-05-01) { id "f2"; origin case_input; }
    }
    evaluate truth(church_election_revocation_retroactive_to(entity_ref("urn:us:irc:employment:clir#Church1"), @2020-01-01));
    expect truth_status == TRUE_ONLY;
}

