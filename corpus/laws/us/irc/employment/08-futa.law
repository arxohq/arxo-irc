// Chapter 23 (FUTA), sections 3301, 3302, 3306. Stage 1 scope (task
// instruction). Sections 3303-3305, 3307-3311, 3321-3322 are NOT named in
// this stage's scope and stay `unreviewed` (stage 2).


// --- Section 3306(a): employer thresholds -----------------------------------

use self::{
    EmploymentExclusionKind,
    IRC_S3301,
    IRC_S3302_A,
    IRC_S3302_B,
    IRC_S3303_A,
    IRC_S3304_A,
    IRC_S3305_A,
    IRC_S3305_B,
    IRC_S3305_D,
    IRC_S3305_F,
    IRC_S3306_A,
    IRC_S3306_B,
    IRC_S3306_C,
    IRC_S3307,
    IRC_S3308,
    IRC_S3309_A,
    Person,
    TaxableYear,
    WagePayment,
    employment_exclusion_item_3121b_exists,
    prior_remuneration_paid,
    section_3309_service_outside_subsection_a,
    wage_payment,
    wages_3121,
};

pub enum FutaEmployerTestKind { General; Agricultural; Domestic; }

pub relation futa_wages_paid_in_quarter(employer: Person, kind: FutaEmployerTestKind, y: TaxableYear, quarterAmount: Money) kind empirical {
    label en official "wages of the stated kind an employer paid in a calendar quarter of this year or the preceding year (case fact, feeding the section 3306(a) quarterly-wage test)";
}
pub relation futa_employed_on_days(employer: Person, kind: FutaEmployerTestKind, y: TaxableYear, daysCount: Integer, minIndividuals: Integer) kind empirical {
    label en official "case fact: the employer employed at least `minIndividuals` individuals in the stated kind of employment for some portion of the day, on `daysCount` days (each in a different calendar week) during this year or the preceding year — feeds the section 3306(a) day-count test";
}

pub relation futa_employer(p: Person, y: TaxableYear) kind institutional {
    label en official "this person is an \"employer\" for FUTA purposes for this calendar year under section 3306(a)";
}

@source(IRC_S3306_A, relation = formalizes, coverage = partial, quote = "during any calendar quarter in the calendar year or the preceding calendar year paid wages of $1,500 or more")
rule FutaEmployerGeneralByWages(p: Person, y: TaxableYear, amount: Money) strict {
    when futa_wages_paid_in_quarter(p, General, y, amount) and amount >= FutaEmployerGeneralWageThreshold;
    then futa_employer(p, y);
}
@source(IRC_S3306_A, relation = formalizes, coverage = partial, quote = "on each of some 20 days during the calendar year or during the preceding calendar year, each day being in a different calendar week, employed at least one individual in employment for some portion of the day")
rule FutaEmployerGeneralByDays(p: Person, y: TaxableYear, days: Integer, minIndividuals: Integer) strict {
    when futa_employed_on_days(p, General, y, days, minIndividuals) and days >= 20 and minIndividuals >= 1;
    then futa_employer(p, y);
}
@source(IRC_S3306_A, relation = formalizes, coverage = partial, quote = "during any calendar quarter in the calendar year or the preceding calendar year paid wages of $20,000 or more for agricultural labor")
rule FutaEmployerAgriculturalByWages(p: Person, y: TaxableYear, amount: Money) strict {
    when futa_wages_paid_in_quarter(p, Agricultural, y, amount) and amount >= FutaEmployerAgriculturalWageThreshold;
    then futa_employer(p, y);
}
@source(IRC_S3306_A, relation = formalizes, coverage = partial, quote = "on each of some 20 days during the calendar year or during the preceding calendar year, each day being in a different calendar week, employed at least 10 individuals in employment in agricultural labor for some portion of the day")
rule FutaEmployerAgriculturalByDays(p: Person, y: TaxableYear, days: Integer, minIndividuals: Integer) strict {
    when futa_employed_on_days(p, Agricultural, y, days, minIndividuals) and days >= 20 and minIndividuals >= 10;
    then futa_employer(p, y);
}
@source(IRC_S3306_A, relation = formalizes, coverage = partial, quote = "any person who during any calendar quarter in the calendar year or the preceding calendar year paid wages in cash of $1,000 or more for such service")
rule FutaEmployerDomesticByWages(p: Person, y: TaxableYear, amount: Money) strict {
    when futa_wages_paid_in_quarter(p, Domestic, y, amount) and amount >= FutaEmployerDomesticWageThreshold;
    then futa_employer(p, y);
}
// (a)(4) special rule (a domestic-only employer under (3) is not an employer
// for OTHER service unless independently qualifying under (1)/(2)): the rule
// forms above already key by `FutaEmployerTestKind`, so a domestic-only
// qualification does not by itself make `FutaEmployerGeneralByWages`/
// `FutaEmployerAgriculturalByDays` etc. derivable — the separation is
// structural, not a further rule needed.

// --- Section 3306(b): wages, the $7,000 FUTA wage base ----------------------
//
// Same cap SHAPE as the section 3121(a)(1) OASDI cap in `01-fica-tax.law`,
// but the FUTA base is a flat $7,000 (never SSA-indexed) and paragraphs
// (2)-(21) of section 3306(b) exclude items that substantially overlap
// section 3121(a)'s list (many by direct cross-reference, e.g. (b)(1)
// exclusion for section 3121(a) items already excluded there). This package
// does NOT re-declare a parallel 21-item enum: instead, section 3306(b)'s
// exclusions are read as "the same section 3121(a) exclusion classification
// applies for FUTA wages" wherever the FUTA text tracks the FICA text
// (paragraphs 2-20 of 3306(b) are, subsection by subsection, textually
// identical or near-identical to 3121(a)(2)-(23) as pinned) — a cross-
// reference relation, not a duplicated ontology. Paragraphs unique to FUTA
// (e.g. (b)(1)'s $7,000 cap itself; (r) deferred compensation; (s) tips) are
// modelled directly.
@source(IRC_S3306_B, relation = formalizes, coverage = partial, quote = "the term \"wages\" means all remuneration for employment, including the cash value of all remuneration (including benefits) paid in any medium other than cash; except that such term shall not include")
pub relation futa_wages(pay: WagePayment, amount: Money) kind institutional {
    label en official "the amount of a wage payment that is \"wages\" within the meaning of section 3306(b), after both the $7,000 annual cap and any section 3121(a)-tracking exclusion";
}
rule FutaWagesBelowCap(pay: WagePayment, employer: Person, employee: Person, y: TaxableYear, amount: Money, on: Date, prior: Money) strict {
    when wages_3121(pay, amount)
        and wage_payment(pay, employer, employee, y, amount, on)
        and prior_remuneration_paid(pay, employer, employee, y, prior)
        and prior + amount <= FutaWageBase;
    then futa_wages(pay, amount);
}
rule FutaWagesCrossingCap(pay: WagePayment, employer: Person, employee: Person, y: TaxableYear, amount: Money, on: Date, prior: Money) strict {
    when wages_3121(pay, amount)
        and wage_payment(pay, employer, employee, y, amount, on)
        and prior_remuneration_paid(pay, employer, employee, y, prior)
        and prior < FutaWageBase and prior + amount > FutaWageBase;
    then futa_wages(pay, FutaWageBase - prior);
}
// Reuses `wages_3121` (the section 3121(a) exclusion classification) as the
// proxy for "not excluded by a paragraph of section 3306(b) that tracks
// section 3121(a)": TECH_GAP where a paragraph of section 3306(b) does NOT
// track section 3121(a) (e.g. section 3306(c)(1)'s own agricultural-labor
// cross-reference to a MODIFIED version of section 3121(g)) — recorded per
// coverage row, not silently assumed identical.

// --- Section 3306(c): employment, and its exclusion list -------------------
//
// Same shape as section 3121(b) in `02-fica-definitions.law`. Several of
// section 3306(c)'s paragraphs are, by their own text, IDENTICAL cross-
// references to section 3121(b) categories (e.g. (c)(7) minister/religious
// order tracks 3121(b)(8); (c)(9) RRTA tracks 3121(b)(9)); this package
// reuses `EmploymentExclusionKind` from `02-fica-definitions.law` for those,
// and adds FUTA-only categories separately below.
pub relation futa_employment_exclusion_item(service: WagePayment, kind: EmploymentExclusionKind) kind empirical {
    label en official "service excluded from FUTA \"employment\" under a paragraph of section 3306(c) that tracks the corresponding section 3121(b) paragraph (case fact)";
}
@source(IRC_S3306_C, relation = formalizes, coverage = partial, quote = "the term \"employment\" means any service")
pub relation futa_employment(service: WagePayment) kind institutional {
    label en official "the underlying service of this wage payment is \"employment\" within the meaning of section 3306(c)";
}
rule FutaEmployment(service: WagePayment) strict {
    when wage_payment(service, _, _, _, _, _)
        and not_known(employment_exclusion_item_3121b_exists(service))
        and not_known(futa_employment_exclusion_item_exists(service));
    then futa_employment(service);
}
relation futa_employment_exclusion_item_exists(service: WagePayment) kind institutional;
rule FutaEmploymentExclusionItemExists(service: WagePayment, kind: EmploymentExclusionKind) strict {
    when futa_employment_exclusion_item(service, kind);
    then futa_employment_exclusion_item_exists(service);
}
// TECH_GAP: section 3306(c)(1)'s agricultural-labor exclusion applies "unless
// [the section 3306(a)(2) agricultural employer test is met]" — a proviso
// this rule does not encode (it treats agricultural-labor exclusion as
// unconditional like section 3121(b)); a full model would gate the
// agricultural exclusion on `not futa_employer(employer, y, Agricultural)`.

// --- Section 3301: rate of tax -----------------------------------------------

pub relation futa_gross_tax(employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 3301 excise tax before section 3302 credits: 6.0 percent of total FUTA wages paid by the employer during the calendar year";
}
pub relation futa_wages_paid_in_year(employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "aggregate FUTA wages (section 3306(b)) an employer paid an employee during the calendar year, summed over case-asserted wage payments — the section 111 aggregate-over-case-asserted-fact pattern via `wage_payment`/`futa_wages`, not an aggregate over a further-derived predicate";
}
rule FutaWagesPaidInYearAggregate(pay0: WagePayment, employer0: Person, y0: TaxableYear) strict {
    when wage_payment(pay0, employer0, _, y0, _, _) and futa_wages(pay0, _);
    then futa_wages_paid_in_year(employer0, y0,
        sum all amount: Money for pay: WagePayment where wage_payment(pay, employer0, _, y0, _, _) and futa_wages(pay, amount));
}
@source(IRC_S3301, relation = formalizes, coverage = exact, quote = "There is hereby imposed on every employer")
rule Section3301FutaGrossTax(employer: Person, y: TaxableYear, totalWages: Money) strict {
    when futa_employer(employer, y) and futa_wages_paid_in_year(employer, y, totalWages);
    then futa_gross_tax(employer, y, round(totalWages * FutaRate, 2, "HALF_UP"));
}

// --- Section 3302: credits against tax --------------------------------------

pub relation futa_state_contributions_paid(employer: Person, y: TaxableYear, amount: Money, timely: Boolean) kind empirical {
    label en official "contributions the employer paid into a certified State unemployment fund for the 12-month period ending October 31 of the taxable year, and whether paid by the section 6071 return due date (case fact; section 3302(a)(4)-(5) special successor/bankruptcy-trustee timing rules are TECH_GAP)";
}
pub relation futa_state_contributions_credit(employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 3302(a) credit for State unemployment contributions actually paid (90 percent of the credit that would otherwise apply, for contributions paid after the return due date)";
}
@source(IRC_S3302_A, relation = formalizes, coverage = partial, quote = "The taxpayer may")
rule Section3302TimelyContributionsCredit(employer: Person, y: TaxableYear, amount: Money) strict {
    when futa_state_contributions_paid(employer, y, amount, true);
    then futa_state_contributions_credit(employer, y, amount);
}
@source(IRC_S3302_A, relation = formalizes, coverage = partial, quote = "credit shall be permitted for contributions paid after such last day, but such credit shall not exceed 90 percent of the amount which would have been allowable as credit on account of such contributions had they been paid on or before such last day")
rule Section3302LateContributionsCredit(employer: Person, y: TaxableYear, amount: Money) strict {
    when futa_state_contributions_paid(employer, y, amount, false);
    then futa_state_contributions_credit(employer, y, round(amount * FutaLateContributionCreditRate, 2, "HALF_UP"));
}

pub relation futa_additional_credit(employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 3302(b) additional credit for a State's experience-rating discount, capped at 5.4 percent of taxable wages";
}
relation futa_actual_state_contributions_required(employer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "case fact: the contributions actually required of this employer for the year under the State's experience-rated law";
}
relation futa_hypothetical_highest_rate_contributions(employer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "case fact: the contributions that would have been required had the highest rate applied to any employer in the 12-month period ending October 31 applied throughout the year, capped by the statute at a 5.4 percent equivalent — the comparison the statute itself asks for (case fact rather than re-deriving the State's own rate schedule)";
}
@source(IRC_S3302_B, relation = formalizes, coverage = partial, quote = "an amount, with respect to the unemployment compensation law of each State")
rule Section3302AdditionalCredit(employer: Person, y: TaxableYear, actual: Money, hypothetical: Money) strict {
    when futa_actual_state_contributions_required(employer, y, actual)
        and futa_hypothetical_highest_rate_contributions(employer, y, hypothetical)
        and hypothetical > actual;
    then futa_additional_credit(employer, y, hypothetical - actual);
}

pub relation futa_total_credit(employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the sum of the section 3302(a) and (b) credits, before any section 3302(c) credit-reduction-state reduction";
}
rule FutaTotalCreditBothPresent(employer: Person, y: TaxableYear, a: Money, b: Money) strict {
    when futa_state_contributions_credit(employer, y, a) and futa_additional_credit(employer, y, b);
    then futa_total_credit(employer, y, a + b);
}
rule FutaTotalCreditContributionsOnly(employer: Person, y: TaxableYear, a: Money) strict {
    when futa_state_contributions_credit(employer, y, a) and not_known(futa_additional_credit_exists(employer, y));
    then futa_total_credit(employer, y, a);
}
relation futa_additional_credit_exists(employer: Person, y: TaxableYear) kind institutional;
rule FutaAdditionalCreditExists(employer: Person, y: TaxableYear, b: Money) strict {
    when futa_additional_credit(employer, y, b);
    then futa_additional_credit_exists(employer, y);
}

pub relation futa_net_tax(employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 3301 tax after the section 3302(a)/(b) credits (before any (c) credit-reduction-state reduction, which is a TECH_GAP/EXTERNAL_DEPENDENCY parameter contract, see below)";
}
pub relation futa_tax(employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "alias of `futa_net_tax`, named to match the task's own pub-interface list (`futa_tax`) literally; consumers should prefer this name";
}
rule FutaTaxAlias(employer: Person, y: TaxableYear, amount: Money) strict {
    when futa_net_tax(employer, y, amount);
    then futa_tax(employer, y, amount);
}
rule FutaNetTax(employer: Person, y: TaxableYear, gross: Money, credit: Money) strict {
    when futa_gross_tax(employer, y, gross) and futa_total_credit(employer, y, credit) and gross > credit;
    then futa_net_tax(employer, y, gross - credit);
}
rule FutaNetTaxNoCredit(employer: Person, y: TaxableYear, gross: Money) strict {
    when futa_gross_tax(employer, y, gross) and not_known(futa_total_credit_exists(employer, y));
    then futa_net_tax(employer, y, gross);
}
relation futa_total_credit_exists(employer: Person, y: TaxableYear) kind institutional;
rule FutaTotalCreditExists(employer: Person, y: TaxableYear, credit: Money) strict {
    when futa_total_credit(employer, y, credit);
    then futa_total_credit_exists(employer, y);
}

// (c) credit-reduction states, (f) limitation on credit reduction, (g)
// repayment exception: an EXTERNAL_DEPENDENCY/parameter contract (task
// instruction: "5.4 percent normal credit and the reductions for credit-
// reduction states as a parameter contract"). The reduction percentage for a
// given State and year is a Department of Labor determination (certified to
// the Secretary of the Treasury before June 1), not IRC text; it is a
// `.lawparam.json`-shaped fact this package does not populate absent a
// pinned DOL/IRS publication (SOURCE_GAP if asserted for a real State/year).
pub relation futa_credit_reduction_state(y: TaxableYear, stateName: Text, reductionRate: Decimal) kind empirical {
    label en unofficial "EXTERNAL_DEPENDENCY/SOURCE_GAP: the section 3302(c)(2)/(f) credit-reduction percentage for a State and year, as determined by the Secretary of Labor and certified to the Secretary of the Treasury — never invented here, asserted only from a pinned DOL/IRS publication";
}

// (e) successor employer credit, (h) CPEO credit eligibility: TECH_GAP
// (successor-employer credit inherits the acquired employer's OWN credit
// computation, a further aggregate this package does not chain) /
// EXTERNAL_DEPENDENCY (CPEO certification, section 3511's own domain, above).

// --- Section 3306: remaining subsections referenced but not separately
//     re-derived: (d) included/excluded service pay-period test (same shape
//     as section 3121(c), stage 2), (e)-(h) State-agency/fund/contributions/
//     compensation definitions (NON_NORMATIVE, feed State-law facts this
//     package takes as case facts), (i) employee (cross-references section
//     3121(d), already formalized above, with two named carve-outs —
//     TECH_GAP for the carve-outs), (j) State/US/American-employer
//     definitions (mirrors 3121(e)/(h), stage 2), (k) agricultural labor
//     (mirrors 3121(g) with one substituted subparagraph, stage 2), (p)
//     common paymaster (mirrors 3121(s), stage 2), (r) deferred compensation
//     (mirrors 3121(v), stage 2), (s) tips (mirrors 3121(q), stage 2): all
//     recorded in coverage as TECH_GAP or NON_NORMATIVE per the pattern of
//     their section 3121 counterpart, not reimplemented a second time in
//     this file given the stage-1 time budget.

// --- Alias matching the task's own pub-interface name -----------------------

pub relation futa_credit(employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "alias of `futa_total_credit`, named to match the task's own pub-interface list literally";
}
rule FutaCreditAlias(employer: Person, y: TaxableYear, amount: Money) strict {
    when futa_total_credit(employer, y, amount);
    then futa_credit(employer, y, amount);
}

// =============================================================================
// Stage 2b: sections 3303-3311 remainder.
// =============================================================================

// --- Section 3303: conditions of additional credit allowance ---------------
//
// Method: the section 3302(b) additional credit already modelled in
// `Section3302AdditionalCredit` above is conditioned on the Secretary of
// Labor's OWN institutional finding that the State's reduced-rate law meets
// the (a)(1)-(4) fund-type standards — an EXTERNAL institutional act
// (DECISION-0194 channel), not re-derived from the fund-balance/waiting-
// period arithmetic the paragraphs describe. Each paragraph is named for
// classification completeness; the actual certification is a case fact.
pub enum Section3303StandardKind { PooledOrPartiallyPooledFundExperience; GuaranteedEmploymentAccount; ReserveAccount; CertifiedProfessionalEmployerOrganization; }
pub relation state_law_meets_3303_standard(state: Person, y: TaxableYear, kind: Section3303StandardKind) kind empirical {
    label en unofficial "case fact: the State's reduced-rate law meets this section 3303(a) fund-type standard for this year (the fund-balance/waiting-period/5x-largest-payout arithmetic within each standard is TECH_GAP, folded into one case fact per fund type)";
}
pub relation secretary_of_labor_certifies_3303_standards(state: Person, y: TaxableYear) kind empirical {
    label en official "the Secretary of Labor's own section 3303(b) certification to the Secretary of the Treasury that the State's reduced rates were allowable only in accordance with section 3303(a) — an EXTERNAL institutional act (DECISION-0194 channel), asserted directly by the case, not re-derived from the (a)(1)-(4) standards above";
}
@source(IRC_S3303_A, relation = formalizes, coverage = partial, quote = "A taxpayer shall be allowed an additional credit under section 3302(b) with respect to any reduced rate of contributions permitted by a State law, only if the Secretary of Labor finds that under such law")
rule Section3303AdditionalCreditConditionSatisfied(state: Person, y: TaxableYear) strict {
    when secretary_of_labor_certifies_3303_standards(state, y);
    then futa_state_3303_standards_satisfied(state, y);
}
pub relation futa_state_3303_standards_satisfied(state: Person, y: TaxableYear) kind institutional {
    label en official "section 3303's condition on the section 3302(b) additional credit is satisfied for this State and year";
}
// (b) certification mechanics, (c) definitions (reserve/pooled/partially-
// pooled/guaranteed-employment account, year, balance, computation date,
// reduced/standard rate), (d) voluntary contributions, (e) nonprofit
// payments-in-lieu election, (f) noncharging-due-to-employer-fault
// prohibition: NON_NORMATIVE/TECH_GAP, institutional State-law-content
// detail this package does not separately re-derive.

// --- Section 3304: approval of State laws (institutional requirements) -----
//
// Same method as section 3303: the Secretary of Labor's OWN approval is the
// external institutional act (DECISION-0194 channel); the (a)(1)-(19)
// conditions are named as an enum for classification completeness, each
// asserted as its own case fact where a scenario needs to test a specific
// condition, but the actual APPROVAL is never re-derived by ANDing all 19
// — only the Secretary of Labor's own certification counts.
pub enum Section3304ApprovalCondition {
    PublicEmploymentOfficePayment;           // (1)
    TwoYearWaitingPeriod;                    // (2)
    ImmediateDepositToUnemploymentTrustFund; // (3)
    RestrictedWithdrawalUse;                 // (4)
    NoDenialForRefusingSubstandardWork;      // (5)
    Section3309aParityAndAcademicYearRules;  // (6)
    RequalificationAfterBenefitYear;         // (7)
    NoDenialForApprovedTraining;             // (8)
    InterstateClaimNonDiscrimination;        // (9)
    NoDenialExceptMisconductFraudOrDisqualifyingIncome; // (10)
    ExtendedCompensationPayable;             // (11)
    NoPregnancyDiscrimination;               // (12)
    ProfessionalAthleteOffSeasonDenial;      // (13)
    AlienStatusVerification;                 // (14)
    PensionOffset;                           // (15)
    WageInformationDisclosure;               // (16)
    TimelyInterestPaymentOnAdvances;         // (17)
    VoluntaryFederalIncomeTaxWithholding;    // (18)
    LegislativeAmendmentReservation;         // (19)
}
pub relation state_law_meets_3304_condition(state: Person, y: TaxableYear, condition: Section3304ApprovalCondition) kind empirical {
    label en official "case fact: the State's unemployment compensation law meets this section 3304(a) condition for this year (each condition's own internal sub-tests, e.g. (6)'s academic-year rules or (15)'s pension-offset formula, are TECH_GAP, folded into one case fact per condition)";
}
pub relation state_law_approved_by_secretary_of_labor(state: Person, y: TaxableYear) kind empirical {
    label en official "the Secretary of Labor's own section 3304(a) approval of the State law — an EXTERNAL institutional act (DECISION-0194 channel: the authority the text itself names), asserted directly by the case, never re-derived by ANDing the 19 conditions above (a real re-derivation would incorrectly claim to have independently performed the Secretary's own certification)";
}
@source(IRC_S3304_A, relation = formalizes, coverage = partial, quote = "The Secretary of Labor shall approve any State law submitted to him, within 30 days of such submission, which he finds provides that")
rule Section3304ApprovalRecognized(state: Person, y: TaxableYear) strict {
    when state_law_approved_by_secretary_of_labor(state, y);
    then state_law_approved_3304(state, y);
}
pub relation state_law_approved_3304(state: Person, y: TaxableYear) kind institutional {
    label en official "the State's unemployment compensation law is approved under section 3304 for this year (feeds the section 3302(a)/(b) credit conditions and section 3305/3309's own cross-references to section 3304 approval)";
}
// (b)-(g) (certification timing, effect of the finding, other rules of the
// section referenced by later provisions): NON_NORMATIVE/TECH_GAP.

// --- Section 3305: applicability of State law -------------------------------

// (a) Interstate/foreign commerce: a straightforward DENIAL of a specific
// jurisdictional defense — modelled as blocking a would-be immunity claim.
pub relation interstate_commerce_defense_asserted(person: Person) kind empirical {
    label en unofficial "case fact: this person, required under State law to make unemployment-fund payments, asserts engagement in interstate/foreign commerce (or the State law's non-distinction between interstate and intrastate employees) as a ground for relief from compliance";
}
pub relation interstate_commerce_defense_denied_3305a(person: Person) kind institutional {
    label en official "section 3305(a): the interstate/foreign-commerce ground for relief from State unemployment-fund compliance is denied";
}
@source(IRC_S3305_A, relation = formalizes, coverage = exact, quote = "No person required under a State law to make payments to an unemployment fund shall be relieved from compliance therewith on the ground that he is engaged in interstate or foreign commerce")
rule Section3305ADenyInterstateCommerceDefense(person: Person) strict {
    when interstate_commerce_defense_asserted(person);
    then interstate_commerce_defense_denied_3305a(person);
}

// (b) Federal instrumentalities: a POWER of the State legislature (over
// requiring the instrumentality's contributions), valid only when the
// non-discrimination conditions (A)-(C) hold.
pub relation federal_instrumentality_3305b(instrumentality: Person) kind empirical {
    label en unofficial "case fact: this is an instrumentality of the United States other than one to which section 3306(c)(6) applies";
}
pub relation state_contribution_rate_non_discriminatory_3305b(state: Person, instrumentality: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the State's contribution rate for this instrumentality/its employees is not greater than the rate for other persons/employees, and (if rates are determined separately) is based solely on unemployment-risk factors — section 3305(b)(A)";
}
pub relation state_law_provides_refund_if_not_certified_3305b(state: Person) kind empirical {
    label en unofficial "case fact: the State law provides for refund of instrumentality contributions if the State is not certified under section 3304 for that year — section 3305(b)(B)";
}
pub relation state_law_equal_benefit_terms_3305b(state: Person) kind empirical {
    label en unofficial "case fact: the State law pays unemployment compensation to the instrumentality's employees on the same terms as other employees — section 3305(b)(C)";
}
pub relation state_may_require_instrumentality_contributions(state: Person, instrumentality: Person, y: TaxableYear) kind institutional {
    label en official "section 3305(b): the State legislature may require this federal instrumentality (and its employees) to contribute to its unemployment fund";
}
@source(IRC_S3305_B, relation = formalizes, coverage = partial, quote = "The legislature of any State may require any instrumentality of the United States")
rule Section3305BFederalInstrumentalityPower(state: Person, instrumentality: Person, y: TaxableYear) strict {
    when federal_instrumentality_3305b(instrumentality)
        and state_law_approved_3304(state, y)
        and state_contribution_rate_non_discriminatory_3305b(state, instrumentality, y)
        and state_law_provides_refund_if_not_certified_3305b(state)
        and state_law_equal_benefit_terms_3305b(state);
    then power Section3305FederalInstrumentalityContributionPower {
        holder state;
        over state_may_require_instrumentality_contributions(state, instrumentality, y);
        exercise federal_instrumentality_3305b(instrumentality);
        valid_when state_contribution_rate_non_discriminatory_3305b(state, instrumentality, y);
        effect create(state_may_require_instrumentality_contributions(state, instrumentality, y));
    };
}

// (d) Federal property: same denial shape as (a).
pub relation federal_property_defense_asserted(person: Person) kind empirical {
    label en unofficial "case fact: this person asserts that services were performed on federally owned/held/possessed land or premises as a ground for relief from State unemployment-compensation-law compliance";
}
pub relation federal_property_defense_denied_3305d(person: Person) kind institutional {
    label en official "section 3305(d): the federal-property ground for relief from State unemployment-compensation-law compliance is denied; the State has full jurisdiction to enforce its law regardless";
}
@source(IRC_S3305_D, relation = formalizes, coverage = exact, quote = "No person shall be relieved from compliance with a State unemployment compensation law on the ground that services were performed on land or premises owned, held, or possessed by the United States")
rule Section3305DDenyFederalPropertyDefense(person: Person) strict {
    when federal_property_defense_asserted(person);
    then federal_property_defense_denied_3305d(person);
}

// (f) American vessels: a POWER of the State where the vessel's operating
// office is located, over requiring contributions from the operator and
// crew, treating the service as performed entirely within that State.
pub relation american_vessel_operating_office_in_state(state: Person, operator: Person, vessel: Person) kind empirical {
    label en unofficial "case fact: this person maintains, in this State, the operating office from which an American vessel's operations are ordinarily and regularly supervised/managed/directed/controlled — section 3305(f)";
}
pub relation state_may_require_vessel_operator_contributions(state: Person, operator: Person, vessel: Person) kind institutional {
    label en official "section 3305(f): this State may require the vessel operator and its crew to contribute to its unemployment fund with respect to service on the vessel, treated as performed entirely within the State";
}
@source(IRC_S3305_F, relation = formalizes, coverage = partial, quote = "may require such person and the officers and members of the crew of such vessel to make contributions to its unemployment fund under its State unemployment compensation law approved by the Secretary of Labor under section 3304")
rule Section3305FAmericanVesselPower(state: Person, operator: Person, vessel: Person, y: TaxableYear) strict {
    when american_vessel_operating_office_in_state(state, operator, vessel) and state_law_approved_3304(state, y);
    then power Section3305VesselContributionPower {
        holder state;
        over state_may_require_vessel_operator_contributions(state, operator, vessel);
        exercise american_vessel_operating_office_in_state(state, operator, vessel);
        valid_when state_law_approved_3304(state, y);
        effect create(state_may_require_vessel_operator_contributions(state, operator, vessel));
    };
}
// (c) national banks, (e) repealed, (g)-(i) general agents of the Secretary
// of Transportation (a narrow historical maritime-agency class), (j) denial
// of section 3302 credits for inconsistent State law: TECH_GAP/NON_NORMATIVE,
// each its own bounded rule the task's "classify" instruction does not ask
// this pass to reach beyond the core (a)/(b)/(d)/(f) points above.

// --- Section 3307: deductions as constructive payments ----------------------
//
// Identical shape to section 3123 (FICA) in `03-fica-administrative.law`;
// modelled directly rather than cross-referenced, per this package's
// convention of one classification per taxing chapter (FUTA's constructive-
// payment rule is its own norm, textually parallel to but legally distinct
// from section 3123's).
pub relation futa_deducted_and_remitted_by_employer(employer: Person, employee: Person, amount: Money, on: Date) kind empirical {
    label en official "an amount an employer deducted from an employee's remuneration and paid over under a legal requirement or permission other than this chapter (case fact, section 3307)";
}
pub relation futa_constructively_paid_to_employee(employee: Person, amount: Money, on: Date) kind institutional {
    label en official "section 3307: an amount deemed paid to the employee, for FUTA purposes, at the time of the deduction";
}
@source(IRC_S3307, relation = formalizes, coverage = exact, quote = "the amount so deducted shall be considered to have been paid to the employee at the time of such deduction")
rule Section3307ConstructivePayment(employer: Person, employee: Person, amount: Money, on: Date) strict {
    when futa_deducted_and_remitted_by_employer(employer, employee, amount, on);
    then futa_constructively_paid_to_employee(employee, amount, on);
}

// --- Section 3308: instrumentalities of the United States -------------------

pub relation federal_instrumentality_3308(instrumentality: Person) kind empirical;
pub relation specific_exemption_from_3301(instrumentality: Person) kind empirical {
    label en unofficial "case fact: another provision of law grants this instrumentality a specific exemption from the section 3301 tax by reference to section 3301 (or its prior-law equivalent)";
}
pub relation futa_federal_instrumentality_not_exempt(instrumentality: Person) kind institutional {
    label en official "section 3308: a federal instrumentality is not exempt from the section 3301 tax unless another provision of law grants it a specific exemption by reference to section 3301";
}
@source(IRC_S3308, relation = formalizes, coverage = exact, quote = "such instrumentality shall not be exempt from the tax imposed by section 3301 unless such other provision of law grants a specific exemption, by reference to section 3301 (or the corresponding section of prior law), from the tax imposed by such section")
rule Section3308InstrumentalityNotExempt(instrumentality: Person) strict {
    when federal_instrumentality_3308(instrumentality) and not specific_exemption_from_3301(instrumentality);
    then futa_federal_instrumentality_not_exempt(instrumentality);
}

// --- Section 3309: state law coverage of nonprofits/government --------------
//
// Already classified in stage 1 as part of the section 3306(a)/(i)
// cross-reference sweep (`coverage/employment.json` section 3309 rows —
// none written yet this pass; see coverage additions below): (a)(1)
// extends State-law "employment" to section 501(c)(3) nonprofits (other
// than churches) and to State/local government instrumentalities meeting
// the (b) size/coverage tests, with a REIMBURSEMENT-IN-LIEU-OF-CONTRIBUTIONS
// election under (a)(2).
pub enum Section3309CoveredEmployerKind { NonprofitOrganization; StateOrLocalGovernmentInstrumentality; IndianTribe; }
pub relation section_3309_covered_employer(employer: Person, kind: Section3309CoveredEmployerKind) kind empirical {
    label en unofficial "case fact: this employer is within one of the section 3309(a)(1) classes whose service a State's unemployment compensation law must cover as \"employment\" (nonprofit under section 3306(c)(8), State/local government instrumentality, or Indian tribe under section 3309(d))";
}
pub relation section_3309_employment(service: WagePayment) kind institutional {
    label en official "section 3304(a)(6)(A)/3309(a)(1): this service, excluded from FUTA \"employment\" solely by section 3306(c)(7) or (c)(8) (government or nonprofit service), is nonetheless \"employment\" for STATE unemployment-compensation-law purposes, on the same terms and conditions as other covered service";
}
@source(IRC_S3304_A, relation = formalizes, coverage = partial, quote = "compensation is payable on the basis of service to which section 3309(a)(1) applies, in the same amount, on the same terms, and subject to the same conditions as compensation payable on the basis of other service subject to such law")
rule Section3309Employment(service: WagePayment, employer: Person, kind: Section3309CoveredEmployerKind) defeasible {
    when wage_payment(service, employer, _, _, _, _) and section_3309_covered_employer(employer, kind);
    then section_3309_employment(service);
    // stage 3: the exceptions of section 3309(b) and the four-employee test of (c) (14-futa-definitions-and-state-law-safeguards.law)
    unless section_3309_service_outside_subsection_a(service) and wage_payment(service, employer, _, _, _, _) and section_3309_covered_employer(employer, kind);
}
pub relation section_3309_reimbursement_election(employer: Person, y: TaxableYear) kind empirical {
    label en official "case fact: this covered nonprofit/government employer elected to make payments in lieu of contributions (reimbursement) rather than pay ordinary FUTA-equivalent State contributions — section 3309(a)(2)";
}
@source(IRC_S3309_A, relation = formalizes, coverage = partial, quote = "may elect, for such minimum period and at such time as may be provided by State law, to pay (in lieu of such contributions) into the State unemployment fund amounts equal to the amounts of compensation attributable under the State law to such service")
relation section_3309_reimbursement_election_documented(employer: Person, y: TaxableYear) kind institutional {
    label en unofficial "documents the section 3309(a)(2) election text; the election itself is recorded directly as the case fact `section_3309_reimbursement_election` above rather than re-derived through this relation";
}
rule Section3309AElectionDocumented(employer: Person, y: TaxableYear) strict {
    when section_3309_reimbursement_election(employer, y);
    then section_3309_reimbursement_election_documented(employer, y);
}
// (b) size/coverage tests for government instrumentalities, (c) definitions,
// (d) Indian tribes (the (d) reimbursement-delinquency consequences): TECH_GAP,
// folded into the `Section3309CoveredEmployerKind` case fact above rather
// than separately re-derived.

// --- Section 3310: judicial review -------------------------------------------
// Institutional procedural provision (petition for review of a Secretary of
// Labor withholding-of-certification finding, in a US court of appeals):
// classification = NON_NORMATIVE (court procedure, not a rule of conduct
// this package's Person/WagePayment-shaped facts can test).

// --- Section 3311: short title -----------------------------------------------
// "This chapter may be cited as the 'Federal Unemployment Tax Act.'"
// classification = NON_NORMATIVE (naming provision).
