// Section 3405 — withholding on pensions, annuities, and certain other
// deferred income. Stage 1 scope (task instruction).



use self::{
    IRC_S3405_A,
    IRC_S3405_B,
    IRC_S3405_C,
    IRC_S3405_D,
    IRC_S3405_F,
    Person,
    Secretary,
    TaxableYear,
};

pub entity Distribution;

pub enum DistributionKind { Periodic; Nonperiodic; EligibleRollover; }

pub relation designated_distribution(dist: Distribution, payor: Person, payee: Person, y: TaxableYear, amount: Money, on: Date, kind: DistributionKind) kind empirical {
    label en official "a section 3405(e)(1) designated distribution from an employer deferred compensation plan, individual retirement plan, or commercial annuity, classified by kind (case fact — the (e)(1)(B) exceptions, e.g. amounts not includible in gross income, are TECH_GAP: asserted by the case's choice not to declare a payment as a designated distribution in the first place)";
}

// --- (a) periodic payments: withheld as if wages, with an election out -----

pub relation periodic_payment_withheld(dist: Distribution, amount: Money) kind institutional {
    label en official "the amount withheld from a periodic payment under section 3405(a)(1) (as if it were a payment of wages for the appropriate payroll period)";
}
@source(IRC_S3405_A, relation = formalizes, coverage = partial, quote = "The payor of any periodic payment")
rule Section3405PeriodicWithholdingDutyRule(dist: Distribution, payor: Person, payee: Person, y: TaxableYear, amount: Money, on: Date, withheld: Money) strict {
    when designated_distribution(dist, payor, payee, y, amount, on, Periodic)
        and secretary_prescribed_withholding_amount_pension(dist, withheld)
        and not periodic_withholding_election_out(payee, payor, on);
    then duty Section3405PeriodicWithholdingDuty {
        bearer payor;
        beneficiary Secretary;
        goal achievement {
            condition periodic_payment_withheld(dist, withheld);
            window [on, on];
        }
    };
}
relation secretary_prescribed_withholding_amount_pension(dist: Distribution, amount: Money) kind empirical {
    label en unofficial "EXTERNAL_DEPENDENCY, same as `secretary_prescribed_withholding_amount` in `04-income-tax-withholding.law`: 'rules prescribed by the Secretary' where no allowance certificate is in effect (section 3405(a)(4)), asserted by the case";
}

@source(IRC_S3405_A, relation = formalizes, coverage = partial, quote = "An individual may elect to have paragraph (1) not apply with respect to periodic payments made to such individual. Such an election shall remain in effect until revoked by such individual.")
pub relation periodic_withholding_election_out(payee: Person, payor: Person, on: Date) kind empirical {
    label en official "the individual's exercise of the section 3405(a)(2) power to elect out of periodic-payment withholding, in effect on this date (case fact — the power's holder/exercise/effect are this single election fact itself; a separate `power` wrapper would make the relation both the exercise condition and its own effect, which the engine rejects as self-consuming, so the POSITION is recorded directly as the case-asserted election, consistent with how a liberty over the holder's own choice is recorded elsewhere in this corpus). The (a)(3) taking-effect timing under section 3402(f)(3) is TECH_GAP — this relation takes effect immediately from the asserted date.";
}

// --- (b) nonperiodic distribution: flat 10% ---------------------------------

@source(IRC_S3405_B, relation = formalizes, coverage = exact, quote = "The payor of any nonperiodic distribution")
rule Section3405NonperiodicWithholdingDutyRule(dist: Distribution, payor: Person, payee: Person, y: TaxableYear, amount: Money, on: Date) strict {
    when designated_distribution(dist, payor, payee, y, amount, on, Nonperiodic) and not nonperiodic_withholding_election_out(dist);
    then duty Section3405NonperiodicWithholdingDuty {
        bearer payor;
        beneficiary Secretary;
        goal achievement {
            condition periodic_payment_withheld(dist, round(amount * NonperiodicWithholdingRate, 2, "HALF_UP"));
            window [on, on];
        }
    };
}
pub relation nonperiodic_withholding_election_out(dist: Distribution) kind empirical {
    label en official "the individual's section 3405(b)(2) distribution-by-distribution election out (case fact)";
}

// --- (c) eligible rollover distributions: flat 20%, no election out --------

@source(IRC_S3405_C, relation = formalizes, coverage = partial, quote = "the payor of such distribution shall withhold from such distribution an amount equal to 20 percent of such distribution")
rule Section3405EligibleRolloverWithholdingDutyRule(dist: Distribution, payor: Person, payee: Person, y: TaxableYear, amount: Money, on: Date) strict {
    when designated_distribution(dist, payor, payee, y, amount, on, EligibleRollover) and not direct_rollover_elected(dist);
    then duty Section3405EligibleRolloverWithholdingDuty {
        bearer payor;
        beneficiary Secretary;
        goal achievement {
            condition periodic_payment_withheld(dist, round(amount * EligibleRolloverWithholdingRate, 2, "HALF_UP"));
            window [on, on];
        }
    };
}
@source(IRC_S3405_C, relation = formalizes, coverage = exact, quote = "Paragraph (1)(B) shall not apply to any distribution if the distributee elects under section 401(a)(31)(A) to have such distribution paid directly to an eligible retirement plan.")
pub relation direct_rollover_elected(dist: Distribution) kind empirical {
    label en official "the section 401(a)(31)(A) direct-rollover election is in effect for this distribution — blocks the section 3405(c) 20% withholding entirely, not merely reduces it (case fact)";
}

// --- (d) liability for withholding ------------------------------------------

pub relation designated_distribution_payor_liable(payor: Person, dist: Distribution) kind institutional {
    label en official "liability for the section 3405 tax withheld from this distribution (general rule: the payor; a plan administrator may instead be liable under (d)(2) for the enumerated plan types — TECH_GAP: the administrator-substitution test is not separately modelled)";
}
@source(IRC_S3405_D, relation = formalizes, coverage = partial, quote = "the payor of a designated distribution")
rule Section3405PayorLiability(dist: Distribution, payor: Person, payee: Person, y: TaxableYear, amount: Money, on: Date, kind: DistributionKind) strict {
    when designated_distribution(dist, payor, payee, y, amount, on, kind) and not plan_administrator_directed_withholding(dist);
    then designated_distribution_payor_liable(payor, dist);
}
relation plan_administrator_directed_withholding(dist: Distribution) kind empirical {
    label en unofficial "section 3405(d)(2): a plan administrator of an enumerated plan type directed the payor to withhold and supplied the required information, shifting liability to the administrator instead (case fact; not otherwise modelled — TECH_GAP for who then bears it)";
}

// --- (f) treated as section 3402 wage withholding for other purposes -------

@source(IRC_S3405_F, relation = formalizes, coverage = exact, quote = "any designated distribution")
rule DesignatedDistributionIsWages3401(dist: Distribution, amount: Money) strict {
    when designated_distribution(dist, _, _, _, amount, _, _);
    then designated_distribution_treated_as_wages(dist, amount);
}
pub relation designated_distribution_treated_as_wages(dist: Distribution, amount: Money) kind institutional {
    label en unofficial "cross-reference effect only: this package has no shared relation between `Distribution` and `WagePayment` (they are different entities); a consuming package (e.g. `returns`, crediting withheld amounts under section 31) reads THIS relation rather than `wages_3401`/`income_tax_withheld`. TECH_GAP if a scenario needs the two entity shapes unified.";
}

// (e) definitions not already used above (commercial annuity, employer
// deferred compensation plan, plan administrator, maximum amount withheld
// under (e)(8), notice-to-payee timing under (e)(10)): NON_NORMATIVE
// (definitional) or TECH_GAP (the (e)(8) cap needs a running fair-market-
// value computation over the distribution's own components, not modelled).

// --- Alias matching the task's own pub-interface name -----------------------

pub relation pension_withholding(dist: Distribution, amount: Money) kind institutional {
    label en unofficial "alias of `periodic_payment_withheld` (which this file already uses for all three section 3405 withholding kinds — periodic, nonperiodic, and eligible rollover), named to match the task's own pub-interface list literally";
}
rule PensionWithholdingAlias(dist: Distribution, amount: Money) strict {
    when periodic_payment_withheld(dist, amount);
    then pension_withholding(dist, amount);
}
