// 26 U.S.C. §3131(c)-(e),(j), §3132(c)-(e),(j), §3134(c)-(n) — the parts of the temporary
// COVID-era credits that stage 2b left as TECH_GAP. Stage 3 (26.09.2026, DECISION-0379).
// Status: implemented_unverified — scenarios are written, not executed.
//
// SCOPE. 10-covid-era-employment-credits.law computes the core credit (rate times
// qualified wages, caps, limitation, refundable excess) from case facts about the wages.
// This module derives the surrounding definitions and side rules:
//  - §3131(c)/§3132(c): what makes leave wages "qualified" — the required-by-the-Act
//    test as if the Act applied after March 31, 2021, the added reasons (diagnostic test
//    exposure, immunization), non-compliance and the §5104/§105 action, the calendar
//    year limit that ignores the first quarter of 2021, and the $12,000 per-individual
//    cumulative limit of the family leave credit.
//  - §3131(d),(e)/§3132(d),(e): the increases for qualified health plan expenses
//    (excluded under §106(a); default pro rata allocation) and for collectively bargained
//    pension and apprenticeship contributions (rate x hours); the credit total with them.
//  - §3131(j)/§3132(j): the non-discrimination denial (a guard on the gross credit rules).
//  - §3134(c): applicable employment taxes, the eligible employer (suspension, 80 percent
//    receipts test with the 2020 base for new employers, the alternative-quarter election,
//    tax-exempt organizations, recovery startup), qualified wages (the 500 full-time
//    employee split, the not-in-existence rule, severely financially distressed employers,
//    the exclusion of wages used for other credits), wages and health plan wages.
//  - §3134(d),(e),(f): aggregation, related-individual wages and the §280C reduction,
//    governmental employers and their exceptions.
//  - §3134(h),(j),(l),(m),(n): coordination with PPP loans and grants, advance payments,
//    the five-year assessment period, the Secretary's guidance duties, the wage window.
//
// Aggregates over the derived `capped` relations follow the style of stage 2b; if the runtime
// subset refuses an aggregate over a derived predicate (§111) the failing rule is named in the
// coverage note.

use self::{
    IRC_S3131_C,
    IRC_S3131_D,
    IRC_S3131_E,
    IRC_S3131_J,
    IRC_S3132_C,
    IRC_S3132_D,
    IRC_S3132_E,
    IRC_S3134_C,
    IRC_S3134_D,
    IRC_S3134_E,
    IRC_S3134_F,
    IRC_S3134_H,
    IRC_S3134_J,
    IRC_S3134_L,
    IRC_S3134_M,
    IRC_S3134_N,
    Person,
    Secretary,
    TaxableYear,
    WagePayment,
    section_3131_gross_credit,
    section_3132_gross_credit,
    section_3134_credit,
    section_3134_gross_credit,
    wage_payment,
};

pub enum CovidLeaveCredit {
    SickLeave;
    FamilyLeave;
    label en unofficial "the two leave credits with the same side rules: section 3131 (paid sick leave) and section 3132 (paid family leave)";
}

// ============================================================================
// §3131(c), §3132(c) — qualified leave wages
// ============================================================================

pub enum LeaveReasonGround {
    OtherReasonOfTheAct;
    DiagnosticTestOrDiagnosisAfterExposureOrEmployerRequest;
    ImmunizationRelated;
    label en unofficial "the reasons for leave: those of the Act itself, and the two added by section 3131(c)(2)(A)(i) / 3132(c)(2)(A)(i)";
}
pub relation leave_wages_required_by_the_act_as_if_after_march_31_2021(pay: WagePayment, credit: CovidLeaveCredit) kind empirical {
    label en official "the wages paid by the employer would be required to be paid by reason of the Emergency Paid Sick Leave Act (the Emergency Family and Medical Leave Expansion Act, with its amendments) as if the Act applied after March 31, 2021";
}
pub relation leave_reason_ground(pay: WagePayment, ground: LeaveReasonGround) kind empirical {
    label en official "the reason for the leave";
}
pub relation employer_failed_to_comply_with_a_requirement_of_the_act(pay: WagePayment) kind empirical {
    label en official "the employer fails to comply with a requirement of the Act (without regard to section 5109; for the family leave, of the Family and Medical Leave Act or the expansion Act) with respect to the paid leave";
}
pub relation employer_took_action_described_in_5104_or_105(pay: WagePayment) kind empirical {
    label en official "the employer takes an action described in section 5104 of the Emergency Paid Sick Leave Act (section 105 of the Family and Medical Leave Act): treated as failing a requirement";
}
pub relation qualified_leave_wages_by_definition(pay: WagePayment, credit: CovidLeaveCredit, amount: Money) kind institutional {
    label en official "the wages are qualified sick (family) leave wages by the definition of subsection (c)";
}
@source(IRC_S3131_C, relation = formalizes, coverage = exact, quote = "The term \"qualified sick leave wages\" means wages paid by an employer which would be required to be paid by reason of the Emergency Paid Sick Leave Act as if such Act applied after March 31, 2021.")
rule S3131c1QualifiedSickLeaveWages defeasible {
    label en official "wages required by the Act as if it applied after March 31, 2021, paid for a recognised reason, unless the employer failed to comply";
    for pay: WagePayment;
    for amount: Money;
    for ground: LeaveReasonGround;
    for on: Date;
    when wage_payment(pay, _, _, _, amount, on)
        and leave_wages_required_by_the_act_as_if_after_march_31_2021(pay, SickLeave)
        and leave_reason_ground(pay, ground)
        and on >= @2021-04-01;
    then qualified_leave_wages_by_definition(pay, SickLeave, amount);
    unless employer_failed_to_comply_with_a_requirement_of_the_act(pay) and wage_payment(pay, _, _, _, amount, on) and leave_wages_required_by_the_act_as_if_after_march_31_2021(pay, SickLeave) and leave_reason_ground(pay, ground) and on >= @2021-04-01;
    unless employer_took_action_described_in_5104_or_105(pay) and wage_payment(pay, _, _, _, amount, on) and leave_wages_required_by_the_act_as_if_after_march_31_2021(pay, SickLeave) and leave_reason_ground(pay, ground) and on >= @2021-04-01;
}
@source(IRC_S3132_C, relation = formalizes, coverage = exact, quote = "the term \"qualified family leave wages\" means wages paid by an employer which would be required to be paid by reason of the Emergency Family and Medical Leave Expansion Act")
rule S3132c1QualifiedFamilyLeaveWages defeasible {
    label en official "wages required by the Act as if it applied after March 31, 2021, unless the employer failed to comply";
    for pay: WagePayment;
    for amount: Money;
    for ground: LeaveReasonGround;
    for on: Date;
    when wage_payment(pay, _, _, _, amount, on)
        and leave_wages_required_by_the_act_as_if_after_march_31_2021(pay, FamilyLeave)
        and leave_reason_ground(pay, ground)
        and on >= @2021-04-01;
    then qualified_leave_wages_by_definition(pay, FamilyLeave, amount);
    unless employer_failed_to_comply_with_a_requirement_of_the_act(pay) and wage_payment(pay, _, _, _, amount, on) and leave_wages_required_by_the_act_as_if_after_march_31_2021(pay, FamilyLeave) and leave_reason_ground(pay, ground) and on >= @2021-04-01;
    unless employer_took_action_described_in_5104_or_105(pay) and wage_payment(pay, _, _, _, amount, on) and leave_wages_required_by_the_act_as_if_after_march_31_2021(pay, FamilyLeave) and leave_reason_ground(pay, ground) and on >= @2021-04-01;
}
pub relation added_leave_reason_recognized(pay: WagePayment) kind institutional {
    label en official "the reason is one of those inserted by paragraph (2)(A)(i): a diagnostic test or diagnosis after exposure (or on the employer's request), or immunization and recovery from an immunization-related condition";
}
@source(IRC_S3131_C, relation = formalizes, coverage = exact, quote = "the employee is seeking or awaiting the results of a diagnostic test for, or a medical diagnosis of, COVID–19 and such employee has been exposed to COVID–19 or the employee's employer has requested such test or diagnosis")
rule S3131c2AiDiagnosticReason defeasible {
    label en official "the added diagnostic test reason";
    for pay: WagePayment;
    when leave_reason_ground(pay, DiagnosticTestOrDiagnosisAfterExposureOrEmployerRequest);
    then added_leave_reason_recognized(pay);
}
@source(IRC_S3131_C, relation = formalizes, coverage = exact, quote = "or the employee is obtaining immunization related to COVID–19 or recovering from any injury, disability, illness, or condition related to such immunization")
rule S3131c2AiImmunizationReason defeasible {
    label en official "the added immunization reason";
    for pay: WagePayment;
    when leave_reason_ground(pay, ImmunizationRelated);
    then added_leave_reason_recognized(pay);
}
pub relation leave_hours_in_quarter(employee: Person, y: TaxableYear, quarterStart: Date, hours: Decimal) kind empirical {
    label en official "the hours of paid sick leave the employee took in the quarter";
}
pub relation calendar_year_number_of(y: TaxableYear, n: Integer) kind institutional {
    label en unofficial "helper: the calendar year number of the taxable year";
}
rule CalendarYearNumberOf defeasible {
    for y: TaxableYear;
    for n: Integer;
    when us.irc.core::calendar_year_of(y, n);
    then calendar_year_number_of(y, n);
}
pub relation quarter_counted_for_5102b1_limit(y: TaxableYear, quarterStart: Date) kind institutional {
    label en official "the quarter counts toward the section 5102(b)(1) limit of the calendar year (the first quarter of 2021 does not)";
}
@source(IRC_S3131_C, relation = formalizes, coverage = exact, quote = "(ii) by applying section 5102(b)(1) of such Act separately with respect to each calendar year after 2020 (and, in the case of calendar year 2021, without regard to the first quarter thereof).")
rule S3131c2AiiQuartersCounted defeasible {
    label en official "quarters of a calendar year after 2020, without the first quarter of 2021";
    for y: TaxableYear;
    for n: Integer;
    for quarterStart: Date;
    for yearBegins: Date;
    for yearEnds: Date;
    when calendar_year_number_of(y, n)
        and n > 2020
        and us.irc.core::begins(y, yearBegins)
        and us.irc.core::ends(y, yearEnds)
        and quarterStart >= yearBegins
        and quarterStart <= yearEnds
        and leave_hours_recorded_for_quarter(quarterStart);
    then quarter_counted_for_5102b1_limit(y, quarterStart);
    unless n == 2021 and quarterStart == @2021-01-01 and calendar_year_number_of(y, n) and us.irc.core::begins(y, yearBegins) and us.irc.core::ends(y, yearEnds) and quarterStart >= yearBegins and quarterStart <= yearEnds and leave_hours_recorded_for_quarter(quarterStart);
}
pub relation leave_hours_recorded_for_quarter(quarterStart: Date) kind empirical {
    label en unofficial "helper: some leave hours are recorded for the quarter";
}
pub relation leave_hours_counted_for_5102b1_limit(employee: Person, y: TaxableYear, hours: Decimal) kind institutional {
    label en official "the hours counted toward the section 5102(b)(1) limit of the calendar year (separately for each year; the first quarter of 2021 excluded)";
}
rule S3131c2AiiHoursCounted defeasible {
    label en official "sum of the recorded hours of the quarters counted";
    for employee: Person;
    for y: TaxableYear;
    for anyQuarter: Date;
    when leave_hours_in_quarter(employee, y, anyQuarter, _);
    then leave_hours_counted_for_5102b1_limit(employee, y,
        sum(collect all h: Decimal, q: Date
            where leave_hours_in_quarter(employee, y, q, h) and quarter_counted_for_5102b1_limit(y, q),
            empty: 0.0));
}
// §3132(c)(2)(A)(ii)(III): the $12,000 per-individual limit, applied as a cumulative ledger
pub relation family_leave_day_amount(pay: WagePayment, employee: Person, on: Date, amount: Money) kind empirical {
    label en official "the qualified family leave wages paid to the employee for the day, before the $200 daily cap (the same day fact as qualified_family_leave_wages_per_day, keyed by the employee)";
}
pub relation family_leave_day_capped(pay: WagePayment, employee: Person, on: Date, amount: Money) kind institutional {
    label en official "the daily amount after the $200 cap of section 3132(b)(1)(A)";
}
rule S3132bDailyCapAbove defeasible {
    for pay: WagePayment;
    for employee: Person;
    for on: Date;
    for amount: Money;
    when family_leave_day_amount(pay, employee, on, amount)
        and amount > 200.00 USD;
    then family_leave_day_capped(pay, employee, on, 200.00 USD);
}
rule S3132bDailyCapBelow defeasible {
    for pay: WagePayment;
    for employee: Person;
    for on: Date;
    for amount: Money;
    when family_leave_day_amount(pay, employee, on, amount)
        and amount <= 200.00 USD;
    then family_leave_day_capped(pay, employee, on, amount);
}
pub relation family_leave_wages_earlier_total(pay: WagePayment, employee: Person, total: Money) kind institutional {
    label en official "the capped daily amounts paid to the employee on earlier days";
}
rule S3132cFamilyLeaveEarlierTotal defeasible {
    label en official "sum of the capped amounts of strictly earlier days, an empty sum read as zero";
    for pay0: WagePayment;
    for employee0: Person;
    for on0: Date;
    when family_leave_day_amount(pay0, employee0, on0, _);
    then family_leave_wages_earlier_total(pay0, employee0,
        sum(collect all a: Money, p: WagePayment, d: Date
            where family_leave_day_capped(p, employee0, d, a) and d < on0,
            empty: 0.00 USD));
}
pub relation family_leave_wages_within_limit(pay: WagePayment, amount: Money) kind institutional {
    label en official "the amount of the day's capped wages that fits under the $12,000 limit per individual";
}
@source(IRC_S3132_C, relation = formalizes, coverage = exact, quote = "(III) by substituting \"$12,000\" for \"$10,000\" in paragraph (2)(B)(ii) thereof.")
rule S3132cLimitRoomLeft defeasible {
    label en official "the capped amount when the earlier total plus the amount stays within $12,000";
    for pay: WagePayment;
    for employee: Person;
    for on: Date;
    for capped: Money;
    for earlier: Money;
    when family_leave_day_capped(pay, employee, on, capped)
        and family_leave_wages_earlier_total(pay, employee, earlier)
        and earlier + capped <= 12000.00 USD;
    then family_leave_wages_within_limit(pay, capped);
}
rule S3132cLimitPartlyLeft defeasible {
    label en official "the remainder of the $12,000 when the amount crosses it";
    for pay: WagePayment;
    for employee: Person;
    for on: Date;
    for capped: Money;
    for earlier: Money;
    when family_leave_day_capped(pay, employee, on, capped)
        and family_leave_wages_earlier_total(pay, employee, earlier)
        and earlier < 12000.00 USD
        and earlier + capped > 12000.00 USD;
    then family_leave_wages_within_limit(pay, 12000.00 USD - earlier);
}
rule S3132cLimitExhausted defeasible {
    label en official "nothing fits once the limit is reached";
    for pay: WagePayment;
    for employee: Person;
    for on: Date;
    for capped: Money;
    for earlier: Money;
    when family_leave_day_capped(pay, employee, on, capped)
        and family_leave_wages_earlier_total(pay, employee, earlier)
        and earlier >= 12000.00 USD;
    then family_leave_wages_within_limit(pay, 0.00 USD);
}
pub relation family_leave_reason_added(pay: WagePayment) kind institutional {
    label en official "the reason is one added by section 3132(c)(2)(A)(i): a reason of section 5102(a) of the Families First Coronavirus Response Act, a diagnostic test after exposure, or immunization";
}
@source(IRC_S3132_C, relation = formalizes, coverage = exact, quote = "or any reason for leave described in section 5102(a) of the Families First Coronavirus Response Act")
rule S3132c2AiReasonOfTheAct defeasible {
    label en official "a reason described in section 5102(a)";
    for pay: WagePayment;
    when leave_reason_ground(pay, OtherReasonOfTheAct);
    then family_leave_reason_added(pay);
}
rule S3132c2AiDiagnosticReason defeasible {
    label en official "the added diagnostic reason";
    for pay: WagePayment;
    when leave_reason_ground(pay, DiagnosticTestOrDiagnosisAfterExposureOrEmployerRequest);
    then family_leave_reason_added(pay);
}
rule S3132c2AiImmunizationReason defeasible {
    label en official "the added immunization reason";
    for pay: WagePayment;
    when leave_reason_ground(pay, ImmunizationRelated);
    then family_leave_reason_added(pay);
}

// ============================================================================
// §3131(d),(e) and §3132(d),(e) — increases of the credit
// ============================================================================

pub relation health_plan_expenses_paid(employer: Person, quarterStart: Date, amount: Money) kind empirical {
    label en official "amounts paid or incurred by the employer to provide and maintain a group health plan (section 5000(b)(1)) in the quarter";
}
pub relation health_plan_expenses_excluded_under_106a(employer: Person, quarterStart: Date, amount: Money) kind empirical {
    label en official "the part of those amounts that is excluded from the gross income of employees by reason of section 106(a)";
}
pub relation qualified_health_plan_expenses(employer: Person, quarterStart: Date, amount: Money) kind institutional {
    label en official "qualified health plan expenses: the amounts paid, but only to the extent excluded from employees' gross income under section 106(a)";
}
@source(IRC_S3131_D, relation = formalizes, coverage = exact, quote = "but only to the extent that such amounts are excluded from the gross income of employees by reason of section 106(a)")
rule S3131d2QualifiedHealthPlanExpenses defeasible {
    label en official "the lesser of the amounts paid and the excluded part";
    for employer: Person;
    for quarterStart: Date;
    for paid: Money;
    for excluded: Money;
    when health_plan_expenses_paid(employer, quarterStart, paid)
        and health_plan_expenses_excluded_under_106a(employer, quarterStart, excluded);
    then qualified_health_plan_expenses(employer, quarterStart, min(paid, excluded));
}
pub relation covered_employee_days_on_qualified_leave(employer: Person, quarterStart: Date, credit: CovidLeaveCredit, days: Integer) kind empirical {
    label en official "employee-days of coverage falling in the periods of leave to which the qualified wages relate";
}
pub relation covered_employee_days_total(employer: Person, quarterStart: Date, days: Integer) kind empirical {
    label en official "all employee-days of coverage under the group health plan in the quarter";
}
pub relation secretary_prescribed_health_plan_allocation(employer: Person, quarterStart: Date, credit: CovidLeaveCredit, amount: Money) kind empirical {
    label en official "the allocation the Secretary prescribes";
}
pub relation health_plan_expenses_allocated(employer: Person, quarterStart: Date, credit: CovidLeaveCredit, amount: Money) kind institutional {
    label en official "the qualified health plan expenses allocated to the qualified leave wages: as the Secretary prescribes, and otherwise pro rata among covered employees and on the basis of periods of coverage relative to the periods of leave";
}
@source(IRC_S3131_D, relation = formalizes, coverage = exact, quote = "Except as otherwise provided by the Secretary, such allocation shall be treated as properly made if made on the basis of being pro rata among covered employees and pro rata on the basis of periods of coverage")
rule S3131d3DefaultAllocationSick defeasible {
    label en official "expenses x leave days / coverage days, rounded to cents half up (INTERPRETATION of the pro rata rule)";
    for employer: Person;
    for quarterStart: Date;
    for expenses: Money;
    for leaveDays: Integer;
    for totalDays: Integer;
    when qualified_health_plan_expenses(employer, quarterStart, expenses)
        and covered_employee_days_on_qualified_leave(employer, quarterStart, SickLeave, leaveDays)
        and covered_employee_days_total(employer, quarterStart, totalDays)
        and totalDays > 0;
    then health_plan_expenses_allocated(employer, quarterStart, SickLeave, div_round(expenses * leaveDays, totalDays * 1.0, 2, "HALF_UP"));
    unless secretary_prescribed_health_plan_allocation(employer, quarterStart, SickLeave, _) and qualified_health_plan_expenses(employer, quarterStart, expenses) and covered_employee_days_on_qualified_leave(employer, quarterStart, SickLeave, leaveDays) and covered_employee_days_total(employer, quarterStart, totalDays) and totalDays > 0;
}
@source(IRC_S3132_D, relation = formalizes, coverage = exact, quote = "Except as otherwise provided by the Secretary, such allocation shall be treated as properly made if made on the basis of being pro rata among covered employees and pro rata on the basis of periods of coverage")
rule S3132d3DefaultAllocationFamily defeasible {
    label en official "as for the sick leave credit";
    for employer: Person;
    for quarterStart: Date;
    for expenses: Money;
    for leaveDays: Integer;
    for totalDays: Integer;
    when qualified_health_plan_expenses(employer, quarterStart, expenses)
        and covered_employee_days_on_qualified_leave(employer, quarterStart, FamilyLeave, leaveDays)
        and covered_employee_days_total(employer, quarterStart, totalDays)
        and totalDays > 0;
    then health_plan_expenses_allocated(employer, quarterStart, FamilyLeave, div_round(expenses * leaveDays, totalDays * 1.0, 2, "HALF_UP"));
    unless secretary_prescribed_health_plan_allocation(employer, quarterStart, FamilyLeave, _) and qualified_health_plan_expenses(employer, quarterStart, expenses) and covered_employee_days_on_qualified_leave(employer, quarterStart, FamilyLeave, leaveDays) and covered_employee_days_total(employer, quarterStart, totalDays) and totalDays > 0;
}
@source(IRC_S3131_D, relation = formalizes, coverage = exact, quote = "in such manner as the Secretary may prescribe")
rule S3131d3SecretaryAllocation defeasible {
    label en official "the Secretary's allocation prevails";
    for employer: Person;
    for quarterStart: Date;
    for credit: CovidLeaveCredit;
    for amount: Money;
    when secretary_prescribed_health_plan_allocation(employer, quarterStart, credit, amount);
    then health_plan_expenses_allocated(employer, quarterStart, credit, amount);
}
pub relation credit_increase_for_health_plan_expenses(employer: Person, quarterStart: Date, credit: CovidLeaveCredit, amount: Money) kind institutional {
    label en official "the credit is increased by the qualified health plan expenses properly allocable to the qualified leave wages";
}
@source(IRC_S3131_D, relation = formalizes, coverage = exact, quote = "The amount of the credit allowed under subsection (a) shall be increased by so much of the employer's qualified health plan expenses as are properly allocable to the qualified sick leave wages for which such credit is so allowed.")
rule S3131d1IncreaseSick defeasible {
    label en official "increase by the allocated amount (only for a quarter in which the section 3131 credit is allowed)";
    for employer: Person;
    for quarterStart: Date;
    for amount: Money;
    for gross: Money;
    when health_plan_expenses_allocated(employer, quarterStart, SickLeave, amount)
        and section_3131_gross_credit(employer, quarterStart, gross);
    then credit_increase_for_health_plan_expenses(employer, quarterStart, SickLeave, amount);
}
@source(IRC_S3132_D, relation = formalizes, coverage = exact, quote = "The amount of the credit allowed under subsection (a) shall be increased by so much of the employer's qualified health plan expenses as are properly allocable to the qualified family leave wages for which such credit is so allowed.")
rule S3132d1IncreaseFamily defeasible {
    label en official "increase by the allocated amount (only for a quarter in which the section 3132 credit is allowed)";
    for employer: Person;
    for quarterStart: Date;
    for amount: Money;
    for gross: Money;
    when health_plan_expenses_allocated(employer, quarterStart, FamilyLeave, amount)
        and section_3132_gross_credit(employer, quarterStart, gross);
    then credit_increase_for_health_plan_expenses(employer, quarterStart, FamilyLeave, amount);
}
pub entity CbaContribution {
    label en unofficial "a contribution paid or incurred under a collective bargaining agreement to a defined benefit plan or a registered apprenticeship program";
}
pub enum CbaContributionKind {
    DefinedBenefitPension;
    Apprenticeship;
    label en unofficial "the two kinds of collectively bargained contributions of subsection (e)";
}
pub relation cba_contribution(c: CbaContribution, employer: Person, quarterStart: Date, kind: CbaContributionKind) kind empirical {
    label en official "the contribution paid or incurred by the employer on behalf of its employees in the quarter";
}
pub relation contribution_to_qualified_defined_benefit_plan(c: CbaContribution) kind empirical {
    label en official "the contribution is to a defined benefit plan (section 414(j)) which meets the requirements of section 401(a)";
}
pub relation contribution_to_registered_apprenticeship_program(c: CbaContribution) kind empirical {
    label en official "the contribution is to an apprenticeship registered under the National Apprenticeship Act that meets the standards of subpart A of part 29 and part 30 of title 29, Code of Federal Regulations";
}
pub relation contribution_made_based_on_rate(c: CbaContribution) kind empirical {
    label en official "the contribution is made based on a contribution rate applied to contribution base units (ERISA section 4001(a)(11))";
}
pub relation contribution_required_by_cba_in_effect(c: CbaContribution) kind empirical {
    label en official "the contribution is required by the terms of a collective bargaining agreement in effect with respect to the quarter";
}
pub relation cba_contribution_qualifies(c: CbaContribution) kind institutional {
    label en official "the contribution is a collectively bargained defined benefit pension plan contribution (or apprenticeship program contribution)";
}
@source(IRC_S3131_E, relation = formalizes, coverage = exact, quote = "(iii) are required to be made pursuant to the terms of a collective bargaining agreement in effect with respect to such calendar quarter.")
rule S3131e2APensionQualifies defeasible {
    label en official "a defined benefit plan contribution, based on a rate, required by a collective bargaining agreement";
    for c: CbaContribution;
    for employer: Person;
    for quarterStart: Date;
    when cba_contribution(c, employer, quarterStart, DefinedBenefitPension)
        and contribution_to_qualified_defined_benefit_plan(c)
        and contribution_made_based_on_rate(c)
        and contribution_required_by_cba_in_effect(c);
    then cba_contribution_qualifies(c);
}
@source(IRC_S3131_E, relation = formalizes, coverage = exact, quote = "(i) are paid or incurred by an employer on behalf of its employees with respect to the calendar quarter to a registered apprenticeship program,")
rule S3131e3AApprenticeshipQualifies defeasible {
    label en official "a registered apprenticeship program contribution, based on a rate, required by a collective bargaining agreement";
    for c: CbaContribution;
    for employer: Person;
    for quarterStart: Date;
    when cba_contribution(c, employer, quarterStart, Apprenticeship)
        and contribution_to_registered_apprenticeship_program(c)
        and contribution_made_based_on_rate(c)
        and contribution_required_by_cba_in_effect(c);
    then cba_contribution_qualifies(c);
}
pub relation cba_contribution_rate_hourly(c: CbaContribution, rate: Money) kind empirical {
    label en official "the contribution rate the employer is obligated to pay under the agreement, expressed as an hourly rate";
}
pub relation cba_leave_hours(employer: Person, quarterStart: Date, credit: CovidLeaveCredit, hours: Decimal) kind empirical {
    label en official "the number of hours for which qualified leave wages were provided to employees covered under the agreement during the quarter";
}
pub relation cba_contribution_allocated(c: CbaContribution, credit: CovidLeaveCredit, amount: Money) kind institutional {
    label en official "the contribution allocated to the qualified leave wages: the hourly rate times the hours of qualified leave wages of covered employees";
}
@source(IRC_S3131_E, relation = formalizes, coverage = exact, quote = "(i) the pension contribution rate (expressed as an hourly rate), and")
rule S3131e2CPensionAllocationSick defeasible {
    label en official "rate x hours, cents half up";
    for c: CbaContribution;
    for employer: Person;
    for quarterStart: Date;
    for rate: Money;
    for hours: Decimal;
    when cba_contribution(c, employer, quarterStart, DefinedBenefitPension)
        and cba_contribution_qualifies(c)
        and cba_contribution_rate_hourly(c, rate)
        and cba_leave_hours(employer, quarterStart, SickLeave, hours);
    then cba_contribution_allocated(c, SickLeave, round(rate * hours, 2, "HALF_UP"));
}
@source(IRC_S3131_E, relation = formalizes, coverage = exact, quote = "(i) the apprenticeship program contribution rate (expressed as an hourly rate), and")
rule S3131e3DApprenticeshipAllocationSick defeasible {
    label en official "rate x hours, cents half up";
    for c: CbaContribution;
    for employer: Person;
    for quarterStart: Date;
    for rate: Money;
    for hours: Decimal;
    when cba_contribution(c, employer, quarterStart, Apprenticeship)
        and cba_contribution_qualifies(c)
        and cba_contribution_rate_hourly(c, rate)
        and cba_leave_hours(employer, quarterStart, SickLeave, hours);
    then cba_contribution_allocated(c, SickLeave, round(rate * hours, 2, "HALF_UP"));
}
@source(IRC_S3132_E, relation = formalizes, coverage = exact, quote = "the pension contribution rate (as defined in section 3131(e)(2)), expressed as an hourly rate")
rule S3132e2BPensionAllocationFamily defeasible {
    label en official "rate x hours, cents half up";
    for c: CbaContribution;
    for employer: Person;
    for quarterStart: Date;
    for rate: Money;
    for hours: Decimal;
    when cba_contribution(c, employer, quarterStart, DefinedBenefitPension)
        and cba_contribution_qualifies(c)
        and cba_contribution_rate_hourly(c, rate)
        and cba_leave_hours(employer, quarterStart, FamilyLeave, hours);
    then cba_contribution_allocated(c, FamilyLeave, round(rate * hours, 2, "HALF_UP"));
}
@source(IRC_S3132_E, relation = formalizes, coverage = exact, quote = "the apprenticeship contribution rate (as defined in section 3131(e)(3)), expressed as an hourly rate")
rule S3132e3BApprenticeshipAllocationFamily defeasible {
    label en official "rate x hours, cents half up";
    for c: CbaContribution;
    for employer: Person;
    for quarterStart: Date;
    for rate: Money;
    for hours: Decimal;
    when cba_contribution(c, employer, quarterStart, Apprenticeship)
        and cba_contribution_qualifies(c)
        and cba_contribution_rate_hourly(c, rate)
        and cba_leave_hours(employer, quarterStart, FamilyLeave, hours);
    then cba_contribution_allocated(c, FamilyLeave, round(rate * hours, 2, "HALF_UP"));
}
pub relation credit_increase_for_cba_contributions(employer: Person, quarterStart: Date, credit: CovidLeaveCredit, amount: Money) kind institutional {
    label en official "the credit is increased by the sum of the allocated pension and apprenticeship contributions (one contribution of each kind per quarter and credit in this model)";
}
@source(IRC_S3131_E, relation = formalizes, coverage = exact, quote = "(A) so much of the employer's collectively bargained defined benefit pension plan contributions as are properly allocable to the qualified sick leave wages for which such credit is so allowed, plus")
rule S3131e1IncreaseBothSick defeasible {
    label en official "pension plus apprenticeship";
    for employer: Person;
    for quarterStart: Date;
    for pension: CbaContribution;
    for apprenticeship: CbaContribution;
    for a: Money;
    for b: Money;
    when cba_contribution(pension, employer, quarterStart, DefinedBenefitPension)
        and cba_contribution(apprenticeship, employer, quarterStart, Apprenticeship)
        and cba_contribution_allocated(pension, SickLeave, a)
        and cba_contribution_allocated(apprenticeship, SickLeave, b);
    then credit_increase_for_cba_contributions(employer, quarterStart, SickLeave, a + b);
}
rule S3131e1IncreasePensionOnlySick defeasible {
    label en official "only a pension contribution";
    for employer: Person;
    for quarterStart: Date;
    for pension: CbaContribution;
    for a: Money;
    when cba_contribution(pension, employer, quarterStart, DefinedBenefitPension)
        and cba_contribution_allocated(pension, SickLeave, a)
        and not_known(apprenticeship_contribution_allocated_exists(employer, quarterStart, SickLeave));
    then credit_increase_for_cba_contributions(employer, quarterStart, SickLeave, a);
}
rule S3131e1IncreaseApprenticeshipOnlySick defeasible {
    label en official "only an apprenticeship contribution";
    for employer: Person;
    for quarterStart: Date;
    for apprenticeship: CbaContribution;
    for b: Money;
    when cba_contribution(apprenticeship, employer, quarterStart, Apprenticeship)
        and cba_contribution_allocated(apprenticeship, SickLeave, b)
        and not_known(pension_contribution_allocated_exists(employer, quarterStart, SickLeave));
    then credit_increase_for_cba_contributions(employer, quarterStart, SickLeave, b);
}
relation apprenticeship_contribution_allocated_exists(employer: Person, quarterStart: Date, credit: CovidLeaveCredit) kind institutional;
rule ApprenticeshipContributionAllocatedExists defeasible {
    for employer: Person;
    for quarterStart: Date;
    for credit: CovidLeaveCredit;
    for c: CbaContribution;
    for b: Money;
    when cba_contribution(c, employer, quarterStart, Apprenticeship)
        and cba_contribution_allocated(c, credit, b);
    then apprenticeship_contribution_allocated_exists(employer, quarterStart, credit);
}
relation pension_contribution_allocated_exists(employer: Person, quarterStart: Date, credit: CovidLeaveCredit) kind institutional;
rule PensionContributionAllocatedExists defeasible {
    for employer: Person;
    for quarterStart: Date;
    for credit: CovidLeaveCredit;
    for c: CbaContribution;
    for a: Money;
    when cba_contribution(c, employer, quarterStart, DefinedBenefitPension)
        and cba_contribution_allocated(c, credit, a);
    then pension_contribution_allocated_exists(employer, quarterStart, credit);
}
@source(IRC_S3132_E, relation = formalizes, coverage = exact, quote = "The amount of the credit allowed under subsection (a) shall be increased by so much of the sum of—")
rule S3132e1IncreaseBothFamily defeasible {
    label en official "pension plus apprenticeship";
    for employer: Person;
    for quarterStart: Date;
    for pension: CbaContribution;
    for apprenticeship: CbaContribution;
    for a: Money;
    for b: Money;
    when cba_contribution(pension, employer, quarterStart, DefinedBenefitPension)
        and cba_contribution(apprenticeship, employer, quarterStart, Apprenticeship)
        and cba_contribution_allocated(pension, FamilyLeave, a)
        and cba_contribution_allocated(apprenticeship, FamilyLeave, b);
    then credit_increase_for_cba_contributions(employer, quarterStart, FamilyLeave, a + b);
}
rule S3132e1IncreasePensionOnlyFamily defeasible {
    label en official "only a pension contribution";
    for employer: Person;
    for quarterStart: Date;
    for pension: CbaContribution;
    for a: Money;
    when cba_contribution(pension, employer, quarterStart, DefinedBenefitPension)
        and cba_contribution_allocated(pension, FamilyLeave, a)
        and not_known(apprenticeship_contribution_allocated_exists(employer, quarterStart, FamilyLeave));
    then credit_increase_for_cba_contributions(employer, quarterStart, FamilyLeave, a);
}
rule S3132e1IncreaseApprenticeshipOnlyFamily defeasible {
    label en official "only an apprenticeship contribution";
    for employer: Person;
    for quarterStart: Date;
    for apprenticeship: CbaContribution;
    for b: Money;
    when cba_contribution(apprenticeship, employer, quarterStart, Apprenticeship)
        and cba_contribution_allocated(apprenticeship, FamilyLeave, b)
        and not_known(pension_contribution_allocated_exists(employer, quarterStart, FamilyLeave));
    then credit_increase_for_cba_contributions(employer, quarterStart, FamilyLeave, b);
}

// ============================================================================
// §3131(j), §3132(j) — non-discrimination
// ============================================================================

pub relation employer_discriminates_in_favor_of_highly_compensated(employer: Person, quarterStart: Date, credit: CovidLeaveCredit) kind empirical {
    label en official "with respect to the availability of the provision of qualified leave wages the employer discriminates in favor of highly compensated employees (section 414(q)) (an evaluative finding)";
}
pub relation employer_discriminates_in_favor_of_full_time(employer: Person, quarterStart: Date, credit: CovidLeaveCredit) kind empirical {
    label en official "the employer discriminates in favor of full-time employees";
}
pub relation employer_discriminates_on_the_basis_of_tenure(employer: Person, quarterStart: Date, credit: CovidLeaveCredit) kind empirical {
    label en official "the employer discriminates in favor of employees on the basis of employment tenure";
}
pub relation credit_denied_for_discrimination(employer: Person, quarterStart: Date, credit: CovidLeaveCredit) kind institutional {
    label en official "no credit is allowed for the quarter";
}
@source(IRC_S3131_J, relation = formalizes, coverage = exact, quote = "discriminates in favor of highly compensated employees (within the meaning of section 414(q)), full-time employees, or employees on the basis of employment tenure with such employer")
rule S3131jDiscriminationHighlyCompensated strict {
    label en official "discrimination in favor of highly compensated employees";
    for employer: Person;
    for quarterStart: Date;
    for credit: CovidLeaveCredit;
    when employer_discriminates_in_favor_of_highly_compensated(employer, quarterStart, credit);
    then credit_denied_for_discrimination(employer, quarterStart, credit);
}
rule S3131jDiscriminationFullTime strict {
    label en official "discrimination in favor of full-time employees";
    for employer: Person;
    for quarterStart: Date;
    for credit: CovidLeaveCredit;
    when employer_discriminates_in_favor_of_full_time(employer, quarterStart, credit);
    then credit_denied_for_discrimination(employer, quarterStart, credit);
}
rule S3131jDiscriminationTenure strict {
    label en official "discrimination on the basis of tenure";
    for employer: Person;
    for quarterStart: Date;
    for credit: CovidLeaveCredit;
    when employer_discriminates_on_the_basis_of_tenure(employer, quarterStart, credit);
    then credit_denied_for_discrimination(employer, quarterStart, credit);
}

// ============================================================================
// §3134(c) — definitions
// ============================================================================

pub relation hi_employer_tax_for_quarter(employer: Person, quarterStart: Date, amount: Money) kind empirical {
    label en official "the taxes imposed under section 3111(b) for the quarter (an aggregate the employer's return shows)";
}
pub relation rrta_3221a_tax_at_3111b_rate_for_quarter(employer: Person, quarterStart: Date, amount: Money) kind empirical {
    label en official "so much of the taxes imposed under section 3221(a) as are attributable to the rate in effect under section 3111(b), for the quarter";
}
pub relation applicable_employment_taxes_3134c1(employer: Person, quarterStart: Date, amount: Money) kind institutional {
    label en official "applicable employment taxes: the section 3111(b) taxes plus the part of the section 3221(a) taxes attributable to that rate";
}
@source(IRC_S3134_C, relation = formalizes, coverage = exact, quote = "(A) The taxes imposed under section 3111(b).")
rule S3134c1BothTaxes defeasible {
    label en official "sum of the two components";
    for employer: Person;
    for quarterStart: Date;
    for a: Money;
    for b: Money;
    when hi_employer_tax_for_quarter(employer, quarterStart, a)
        and rrta_3221a_tax_at_3111b_rate_for_quarter(employer, quarterStart, b);
    then applicable_employment_taxes_3134c1(employer, quarterStart, a + b);
}
rule S3134c1OnlyHi defeasible {
    label en official "only the section 3111(b) taxes";
    for employer: Person;
    for quarterStart: Date;
    for a: Money;
    when hi_employer_tax_for_quarter(employer, quarterStart, a)
        and not_known(rrta_3221a_component_exists(employer, quarterStart));
    then applicable_employment_taxes_3134c1(employer, quarterStart, a);
}
relation rrta_3221a_component_exists(employer: Person, quarterStart: Date) kind institutional;
rule Rrta3221aComponentExists defeasible {
    for employer: Person;
    for quarterStart: Date;
    for b: Money;
    when rrta_3221a_tax_at_3111b_rate_for_quarter(employer, quarterStart, b);
    then rrta_3221a_component_exists(employer, quarterStart);
}
@source(IRC_S3134_C, relation = formalizes, coverage = exact, quote = "(B) So much of the taxes imposed under section 3221(a) as are attributable to the rate in effect under section 3111(b).")
rule S3134c1OnlyRrta defeasible {
    label en official "only the railroad component";
    for employer: Person;
    for quarterStart: Date;
    for b: Money;
    when rrta_3221a_tax_at_3111b_rate_for_quarter(employer, quarterStart, b)
        and not_known(hi_employer_tax_exists(employer, quarterStart));
    then applicable_employment_taxes_3134c1(employer, quarterStart, b);
}
relation hi_employer_tax_exists(employer: Person, quarterStart: Date) kind institutional;
rule HiEmployerTaxExists defeasible {
    for employer: Person;
    for quarterStart: Date;
    for a: Money;
    when hi_employer_tax_for_quarter(employer, quarterStart, a);
    then hi_employer_tax_exists(employer, quarterStart);
}
// (c)(2) eligible employer
pub relation carrying_on_trade_or_business_in_quarter(employer: Person, quarterStart: Date) kind empirical {
    label en official "the employer was carrying on a trade or business during the calendar quarter";
}
pub relation operation_suspended_by_covid_order(employer: Person, quarterStart: Date) kind empirical {
    label en official "the operation of the trade or business is fully or partially suspended during the quarter due to orders from an appropriate governmental authority limiting commerce, travel or group meetings due to COVID-19";
}
pub relation gross_receipts_in_quarter(employer: Person, quarterStart: Date, amount: Money) kind empirical {
    label en official "the employer's gross receipts (within the meaning of section 448(c); for a tax-exempt organization section 6033) for the quarter";
}
pub relation gross_receipts_same_quarter_2019(employer: Person, quarterStart: Date, amount: Money) kind empirical {
    label en official "the gross receipts for the same calendar quarter in calendar year 2019";
}
pub relation gross_receipts_same_quarter_2020(employer: Person, quarterStart: Date, amount: Money) kind empirical {
    label en official "the gross receipts for the same calendar quarter in calendar year 2020 (employers not in existence in the 2019 quarter)";
}
pub relation employer_in_existence_at_start_of_same_quarter_2019(employer: Person, quarterStart: Date) kind empirical {
    label en official "the employer was in existence as of the beginning of the same calendar quarter in calendar year 2019";
}
pub relation gross_receipts_preceding_quarter(employer: Person, quarterStart: Date, amount: Money) kind empirical {
    label en official "the gross receipts for the immediately preceding calendar quarter";
}
pub relation gross_receipts_quarter_corresponding_to_preceding_in_2019(employer: Person, quarterStart: Date, amount: Money) kind empirical {
    label en official "the gross receipts for the corresponding calendar quarter in calendar year 2019 (corresponding to the preceding quarter)";
}
pub relation employer_elects_alternative_quarter(employer: Person, quarterStart: Date) kind empirical {
    label en official "the employer elects, at the time and in the manner the Secretary prescribes, to use the alternative quarter";
}
pub relation eligible_by_suspension(employer: Person, quarterStart: Date) kind institutional {
    label en official "clause (ii)(I): the operation is suspended by a COVID-19 order";
}
@source(IRC_S3134_C, relation = formalizes, coverage = exact, quote = "(I) the operation of the trade or business described in clause (i) is fully or partially suspended during the calendar quarter due to orders from an appropriate governmental authority")
rule S3134c2AiiISuspension defeasible {
    label en official "a carrying-on employer whose operation is suspended";
    for employer: Person;
    for quarterStart: Date;
    when carrying_on_trade_or_business_in_quarter(employer, quarterStart)
        and operation_suspended_by_covid_order(employer, quarterStart);
    then eligible_by_suspension(employer, quarterStart);
}
pub relation eligible_by_receipts_decline(employer: Person, quarterStart: Date) kind institutional {
    label en official "clause (ii)(II): gross receipts less than 80 percent of the base quarter";
}
@source(IRC_S3134_C, relation = formalizes, coverage = exact, quote = "(II) the gross receipts (within the meaning of section 448(c)) of such employer for such calendar quarter are less than 80 percent of the gross receipts of such employer for the same calendar quarter in calendar year 2019, or")
rule S3134c2AiiIIReceiptsVs2019 defeasible {
    label en official "receipts below 80 percent of the same quarter of 2019 (receipts x 5 < base x 4); no alternative election";
    for employer: Person;
    for quarterStart: Date;
    for receipts: Money;
    for base: Money;
    when carrying_on_trade_or_business_in_quarter(employer, quarterStart)
        and gross_receipts_in_quarter(employer, quarterStart, receipts)
        and gross_receipts_same_quarter_2019(employer, quarterStart, base)
        and employer_in_existence_at_start_of_same_quarter_2019(employer, quarterStart)
        and receipts * 5 < base * 4;
    then eligible_by_receipts_decline(employer, quarterStart);
    unless employer_elects_alternative_quarter(employer, quarterStart) and carrying_on_trade_or_business_in_quarter(employer, quarterStart) and gross_receipts_in_quarter(employer, quarterStart, receipts) and gross_receipts_same_quarter_2019(employer, quarterStart, base) and employer_in_existence_at_start_of_same_quarter_2019(employer, quarterStart);
}
@source(IRC_S3134_C, relation = formalizes, coverage = exact, quote = "if such employer was not in existence as of the beginning of the same calendar quarter in calendar year 2019, clause (ii)(II) shall be applied by substituting \"2020\" for \"2019\"")
rule S3134c2AiiIIReceiptsVs2020 defeasible {
    label en official "an employer not in existence in the 2019 quarter compares with the same quarter of 2020";
    for employer: Person;
    for quarterStart: Date;
    for receipts: Money;
    for base: Money;
    when carrying_on_trade_or_business_in_quarter(employer, quarterStart)
        and gross_receipts_in_quarter(employer, quarterStart, receipts)
        and gross_receipts_same_quarter_2020(employer, quarterStart, base)
        and not_known(employer_in_existence_at_start_of_same_quarter_2019(employer, quarterStart))
        and receipts * 5 < base * 4;
    then eligible_by_receipts_decline(employer, quarterStart);
    unless employer_elects_alternative_quarter(employer, quarterStart) and carrying_on_trade_or_business_in_quarter(employer, quarterStart) and gross_receipts_in_quarter(employer, quarterStart, receipts) and gross_receipts_same_quarter_2020(employer, quarterStart, base) and not_known(employer_in_existence_at_start_of_same_quarter_2019(employer, quarterStart));
}
@source(IRC_S3134_C, relation = formalizes, coverage = exact, quote = "(I) by substituting \"for the immediately preceding calendar quarter\" for \"for such calendar quarter\", and")
rule S3134c2BiAlternativeQuarter defeasible {
    label en official "the election: the preceding quarter's receipts against the corresponding 2019 quarter";
    for employer: Person;
    for quarterStart: Date;
    for receipts: Money;
    for base: Money;
    when carrying_on_trade_or_business_in_quarter(employer, quarterStart)
        and employer_elects_alternative_quarter(employer, quarterStart)
        and gross_receipts_preceding_quarter(employer, quarterStart, receipts)
        and gross_receipts_quarter_corresponding_to_preceding_in_2019(employer, quarterStart, base)
        and receipts * 5 < base * 4;
    then eligible_by_receipts_decline(employer, quarterStart);
}
pub relation gross_receipts_quarter_corresponding_to_preceding_in_2020(employer: Person, quarterStart: Date, amount: Money) kind empirical {
    label en official "the gross receipts for the corresponding calendar quarter in calendar year 2020 (corresponding to the preceding quarter), for an employer not in existence in the 2019 quarter";
}
@source(IRC_S3134_C, relation = formalizes, coverage = exact, quote = "(ii) the last sentence of subparagraph (A) shall be applied by substituting "the corresponding calendar quarter in calendar year 2019" for "the same calendar quarter in calendar year 2019".")
rule S3134c2BiiAlternativeQuarterNewEmployer defeasible {
    label en official "the election with the 2020 base: the preceding quarter against the corresponding quarter of 2020 (INTERPRETATION of the double substitution)";
    for employer: Person;
    for quarterStart: Date;
    for receipts: Money;
    for base: Money;
    when carrying_on_trade_or_business_in_quarter(employer, quarterStart)
        and employer_elects_alternative_quarter(employer, quarterStart)
        and not_known(employer_in_existence_at_start_of_same_quarter_2019(employer, quarterStart))
        and gross_receipts_preceding_quarter(employer, quarterStart, receipts)
        and gross_receipts_quarter_corresponding_to_preceding_in_2020(employer, quarterStart, base)
        and receipts * 5 < base * 4;
    then eligible_by_receipts_decline(employer, quarterStart);
}
pub relation began_carrying_on_trade_or_business_on(employer: Person, on: Date) kind empirical {
    label en official "the date the employer began carrying on any trade or business";
}
pub relation average_annual_gross_receipts_three_prior_years(employer: Person, quarterStart: Date, amount: Money) kind empirical {
    label en official "the average annual gross receipts (rules similar to section 448(c)(3)) for the 3-taxable-year period ending with the taxable year that precedes the quarter";
}
pub relation recovery_startup_business_3134c5(employer: Person, quarterStart: Date) kind institutional {
    label en official "a recovery startup business: began after February 15, 2020 and average annual gross receipts of the last three years not above $1,000,000";
}
@source(IRC_S3134_C, relation = formalizes, coverage = exact, quote = "(A) which began carrying on any trade or business after February 15, 2020, and")
rule S3134c5RecoveryStartup defeasible {
    label en official "began after 2020-02-15 and $1,000,000 or less";
    for employer: Person;
    for quarterStart: Date;
    for began: Date;
    for average: Money;
    when began_carrying_on_trade_or_business_on(employer, began)
        and average_annual_gross_receipts_three_prior_years(employer, quarterStart, average)
        and began > @2020-02-15
        and average <= 1000000.00 USD;
    then recovery_startup_business_3134c5(employer, quarterStart);
}
pub relation eligible_by_recovery_startup(employer: Person, quarterStart: Date) kind institutional {
    label en official "clause (ii)(III): the employer is a recovery startup business";
}
@source(IRC_S3134_C, relation = formalizes, coverage = exact, quote = "(III) the employer is a recovery startup business (as defined in paragraph (5)).")
rule S3134c2AiiIIIRecoveryStartup defeasible {
    label en official "a carrying-on recovery startup business";
    for employer: Person;
    for quarterStart: Date;
    when carrying_on_trade_or_business_in_quarter(employer, quarterStart)
        and recovery_startup_business_3134c5(employer, quarterStart);
    then eligible_by_recovery_startup(employer, quarterStart);
}
pub relation exempt_organization_501c(employer: Person) kind empirical {
    label en official "the organization is described in section 501(c) and exempt from tax under section 501(a)";
}
pub relation exempt_organization_all_operations_test(employer: Person, quarterStart: Date) kind institutional {
    label en official "for a tax-exempt organization clauses (i) and (ii)(I) apply to all its operations (the suspension of any operation counts)";
}
pub relation any_operation_of_organization_suspended(employer: Person, quarterStart: Date) kind empirical {
    label en official "any operation of the organization is fully or partially suspended by a COVID-19 order";
}
@source(IRC_S3134_C, relation = formalizes, coverage = exact, quote = "(i) clauses (i) and (ii)(I) of subparagraph (A) shall apply to all operations of such organization, and")
rule S3134c2CiAllOperations defeasible {
    label en official "an exempt organization is eligible by suspension when any operation is suspended";
    for employer: Person;
    for quarterStart: Date;
    when exempt_organization_501c(employer)
        and any_operation_of_organization_suspended(employer, quarterStart);
    then eligible_by_suspension(employer, quarterStart);
}
pub relation eligible_employer_3134_derived(employer: Person, quarterStart: Date) kind institutional {
    label en official "the employer is an eligible employer for the quarter (alternative to the case fact eligible_employer_3134)";
}
@source(IRC_S3134_C, relation = formalizes, coverage = exact, quote = "The term \"eligible employer\" means any employer—")
rule S3134c2EligibleBySuspension defeasible {
    label en official "eligible by suspension";
    for employer: Person;
    for quarterStart: Date;
    when eligible_by_suspension(employer, quarterStart);
    then eligible_employer_3134_derived(employer, quarterStart);
}
rule S3134c2EligibleByReceipts defeasible {
    label en official "eligible by the receipts decline";
    for employer: Person;
    for quarterStart: Date;
    when eligible_by_receipts_decline(employer, quarterStart);
    then eligible_employer_3134_derived(employer, quarterStart);
}
rule S3134c2EligibleByStartup defeasible {
    label en official "eligible as a recovery startup business";
    for employer: Person;
    for quarterStart: Date;
    when eligible_by_recovery_startup(employer, quarterStart);
    then eligible_employer_3134_derived(employer, quarterStart);
}
pub relation severely_financially_distressed_employer(employer: Person, quarterStart: Date) kind institutional {
    label en official "an eligible employer with the receipts test at less than 10 percent instead of 80 percent";
}
@source(IRC_S3134_C, relation = formalizes, coverage = exact, quote = "The term \"severely financially distressed employer\" means an eligible employer as defined in paragraph (2), determined by substituting \"less than 10 percent\" for \"less than 80 percent\" in subparagraph (A)(ii)(II) thereof.")
rule S3134c3CiiSeverelyDistressed defeasible {
    label en official "receipts below 10 percent of the base quarter (receipts x 10 < base)";
    for employer: Person;
    for quarterStart: Date;
    for receipts: Money;
    for base: Money;
    when carrying_on_trade_or_business_in_quarter(employer, quarterStart)
        and gross_receipts_in_quarter(employer, quarterStart, receipts)
        and gross_receipts_same_quarter_2019(employer, quarterStart, base)
        and employer_in_existence_at_start_of_same_quarter_2019(employer, quarterStart)
        and receipts * 10 < base;
    then severely_financially_distressed_employer(employer, quarterStart);
}
rule S3134c3CiiSeverelyDistressedNew defeasible {
    label en official "an employer not in existence in the 2019 quarter compares with 2020";
    for employer: Person;
    for quarterStart: Date;
    for receipts: Money;
    for base: Money;
    when carrying_on_trade_or_business_in_quarter(employer, quarterStart)
        and gross_receipts_in_quarter(employer, quarterStart, receipts)
        and gross_receipts_same_quarter_2020(employer, quarterStart, base)
        and not_known(employer_in_existence_at_start_of_same_quarter_2019(employer, quarterStart))
        and receipts * 10 < base;
    then severely_financially_distressed_employer(employer, quarterStart);
}
// (c)(3) qualified wages
pub relation average_full_time_employees_2019(employer: Person, count: Integer) kind empirical {
    label en official "the average number of full-time employees (section 4980H) the employer employed during 2019";
}
pub relation average_full_time_employees_2020(employer: Person, count: Integer) kind empirical {
    label en official "the same average during 2020, for an employer not in existence in 2019";
}
pub relation employer_in_existence_in_2019(employer: Person) kind empirical {
    label en official "the employer was in existence in 2019";
}
pub relation base_year_full_time_employees(employer: Person, count: Integer) kind institutional {
    label en official "the full-time employee average of the base year: 2019, or 2020 for an employer not in existence in 2019 (paragraph (3)(B))";
}
rule S3134c3BBaseYear2019 defeasible {
    label en official "in existence in 2019";
    for employer: Person;
    for count: Integer;
    when employer_in_existence_in_2019(employer)
        and average_full_time_employees_2019(employer, count);
    then base_year_full_time_employees(employer, count);
}
@source(IRC_S3134_C, relation = formalizes, coverage = exact, quote = "In the case of any employer that was not in existence in 2019, subparagraph (A) shall be applied by substituting \"2020\" for \"2019\" each place it appears.")
rule S3134c3BBaseYear2020 defeasible {
    label en official "not in existence in 2019";
    for employer: Person;
    for count: Integer;
    when average_full_time_employees_2020(employer, count)
        and not_known(employer_in_existence_in_2019(employer));
    then base_year_full_time_employees(employer, count);
}
pub relation wage_3134_candidate(pay: WagePayment, employer: Person, employee: Person, quarterStart: Date, amount: Money) kind empirical {
    label en official "wages (section 3134(c)(4)) the employer paid the employee, with the quarter";
}
pub relation employee_not_providing_services_due_to_covid_circumstance(pay: WagePayment) kind empirical {
    label en official "the employee is not providing services due to circumstances described in subclause (I) or (II) of paragraph (2)(A)(ii)";
}
pub relation wages_paid_during_suspension_period(pay: WagePayment) kind empirical {
    label en official "the wages are paid with respect to an employee during a period described in clause (ii)(I) (the period of the suspension)";
}
pub relation wages_taken_into_account_under_other_credit(pay: WagePayment) kind empirical {
    label en official "the wages are taken into account under section 41, 45A, 45P, 45S, 51, 1396, 3131 or 3132";
}
pub relation qualified_wages_3134_derived(pay: WagePayment, employer: Person, employee: Person, quarterStart: Date, amount: Money) kind institutional {
    label en official "qualified wages of section 3134(c)(3) (alternative to the case fact qualified_wages_3134_per_employee_quarter)";
}
@source(IRC_S3134_C, relation = formalizes, coverage = exact, quote = "(i) in the case of an eligible employer for which the average number of full-time employees (within the meaning of section 4980H) employed by such eligible employer during 2019 was greater than 500")
rule S3134c3AiLargeEmployer defeasible {
    label en official "more than 500 full-time employees: wages for an employee not providing services due to the circumstances (suspension or receipts decline)";
    for pay: WagePayment;
    for employer: Person;
    for employee: Person;
    for quarterStart: Date;
    for amount: Money;
    for count: Integer;
    when wage_3134_candidate(pay, employer, employee, quarterStart, amount)
        and eligible_employer_3134_derived(employer, quarterStart)
        and base_year_full_time_employees(employer, count)
        and count > 500
        and employee_not_providing_services_due_to_covid_circumstance(pay);
    then qualified_wages_3134_derived(pay, employer, employee, quarterStart, amount);
    unless wages_taken_into_account_under_other_credit(pay) and wage_3134_candidate(pay, employer, employee, quarterStart, amount) and eligible_employer_3134_derived(employer, quarterStart) and base_year_full_time_employees(employer, count) and count > 500 and employee_not_providing_services_due_to_covid_circumstance(pay);
}
@source(IRC_S3134_C, relation = formalizes, coverage = exact, quote = "(I) with respect to an eligible employer described in subclause (I) of paragraph (2)(A)(ii), wages paid by such eligible employer with respect to an employee during any period described in such clause, or")
rule S3134c3AiiISmallSuspended defeasible {
    label en official "500 or fewer and eligible by suspension: wages during the suspension period";
    for pay: WagePayment;
    for employer: Person;
    for employee: Person;
    for quarterStart: Date;
    for amount: Money;
    for count: Integer;
    when wage_3134_candidate(pay, employer, employee, quarterStart, amount)
        and eligible_by_suspension(employer, quarterStart)
        and base_year_full_time_employees(employer, count)
        and count <= 500
        and wages_paid_during_suspension_period(pay);
    then qualified_wages_3134_derived(pay, employer, employee, quarterStart, amount);
    unless wages_taken_into_account_under_other_credit(pay) and wage_3134_candidate(pay, employer, employee, quarterStart, amount) and eligible_by_suspension(employer, quarterStart) and base_year_full_time_employees(employer, count) and count <= 500 and wages_paid_during_suspension_period(pay);
}
@source(IRC_S3134_C, relation = formalizes, coverage = exact, quote = "(II) with respect to an eligible employer described in subclause (II) of such paragraph, wages paid by such eligible employer with respect to an employee during such quarter.")
rule S3134c3AiiIISmallReceipts defeasible {
    label en official "500 or fewer and eligible by the receipts decline: all wages of the quarter";
    for pay: WagePayment;
    for employer: Person;
    for employee: Person;
    for quarterStart: Date;
    for amount: Money;
    for count: Integer;
    when wage_3134_candidate(pay, employer, employee, quarterStart, amount)
        and eligible_by_receipts_decline(employer, quarterStart)
        and base_year_full_time_employees(employer, count)
        and count <= 500;
    then qualified_wages_3134_derived(pay, employer, employee, quarterStart, amount);
    unless wages_taken_into_account_under_other_credit(pay) and wage_3134_candidate(pay, employer, employee, quarterStart, amount) and eligible_by_receipts_decline(employer, quarterStart) and base_year_full_time_employees(employer, count) and count <= 500;
}
@source(IRC_S3134_C, relation = formalizes, coverage = exact, quote = "(i) In general")
rule S3134c3CiSeverelyDistressedWages defeasible {
    label en official "a severely financially distressed employer: all wages paid to an employee during the quarter (notwithstanding (A)(i))";
    for pay: WagePayment;
    for employer: Person;
    for employee: Person;
    for quarterStart: Date;
    for amount: Money;
    when wage_3134_candidate(pay, employer, employee, quarterStart, amount)
        and severely_financially_distressed_employer(employer, quarterStart);
    then qualified_wages_3134_derived(pay, employer, employee, quarterStart, amount);
    unless wages_taken_into_account_under_other_credit(pay) and wage_3134_candidate(pay, employer, employee, quarterStart, amount) and severely_financially_distressed_employer(employer, quarterStart);
}
pub relation wages_for_3134_from_covered_service(pay: WagePayment, amount: Money) kind institutional {
    label en official "wages of an organization described in subsection (f)(2), determined without regard to section 3121(b)(5), (6), (7), (10) and (13) (except inmate service in a penal institution)";
}
pub relation service_excluded_only_by_3121b_paragraph(pay: WagePayment, paragraph: Integer) kind empirical {
    label en official "the service is excluded from employment only by the paragraph of section 3121(b)";
}
pub relation service_performed_in_penal_institution_by_inmate(pay: WagePayment) kind empirical {
    label en official "the service is performed in a penal institution by an inmate thereof";
}
pub relation organization_described_in_3134f2(employer: Person) kind institutional {
    label en official "an organization or entity described in subsection (f)(2)";
}
@source(IRC_S3134_C, relation = formalizes, coverage = exact, quote = "For purposes of the preceding sentence, in the case of any organization or entity described in subsection (f)(2), wages as defined in section 3121(a) shall be determined without regard to paragraphs (5), (6), (7), (10), and (13) of section 3121(b)")
rule S3134c4AWagesOfSubsectionF2Entities defeasible {
    label en official "the five exclusions are disregarded for those entities, except for inmate service";
    for pay: WagePayment;
    for employer: Person;
    for paragraph: Integer;
    for amount: Money;
    when wage_payment(pay, employer, _, _, amount, _)
        and organization_described_in_3134f2(employer)
        and service_excluded_only_by_3121b_paragraph(pay, paragraph)
        and (paragraph == 5 or paragraph == 6 or paragraph == 7 or paragraph == 10 or paragraph == 13);
    then wages_for_3134_from_covered_service(pay, amount);
    unless service_performed_in_penal_institution_by_inmate(pay) and wage_payment(pay, employer, _, _, amount, _) and organization_described_in_3134f2(employer) and service_excluded_only_by_3121b_paragraph(pay, paragraph);
}
pub relation health_plan_wages_3134c4B(employer: Person, quarterStart: Date, amount: Money) kind institutional {
    label en official "amounts paid to provide and maintain a group health plan are wages, to the extent excluded under section 106(a)";
}
@source(IRC_S3134_C, relation = formalizes, coverage = exact, quote = "Such term shall include amounts paid by the eligible employer to provide and maintain a group health plan (as defined in section 5000(b)(1)), but only to the extent that such amounts are excluded from the gross income of employees by reason of section 106(a).")
rule S3134c4BiHealthPlanWages defeasible {
    label en official "qualified health plan expenses of an eligible employer are wages";
    for employer: Person;
    for quarterStart: Date;
    for amount: Money;
    when eligible_employer_3134_derived(employer, quarterStart)
        and qualified_health_plan_expenses(employer, quarterStart, amount);
    then health_plan_wages_3134c4B(employer, quarterStart, amount);
}
pub relation health_plan_wages_coverage_days(employer: Person, quarterStart: Date, periodDays: Integer, coverageDays: Integer) kind empirical {
    label en official "the days of the period to which the health plan wages are attributed, and all days of coverage";
}
pub relation health_plan_wages_allocated_to_period(employer: Person, quarterStart: Date, amount: Money) kind institutional {
    label en official "the health plan wages allocated to the period: pro rata among periods of coverage unless the Secretary prescribes otherwise";
}
@source(IRC_S3134_C, relation = formalizes, coverage = exact, quote = "Except as otherwise provided by the Secretary, such allocation shall be treated as properly made if made on the basis of being pro rata among periods of coverage.")
rule S3134c4BiiProRata defeasible {
    label en official "amount x period days / coverage days, cents half up (INTERPRETATION of the pro rata rule)";
    for employer: Person;
    for quarterStart: Date;
    for amount: Money;
    for periodDays: Integer;
    for coverageDays: Integer;
    when health_plan_wages_3134c4B(employer, quarterStart, amount)
        and health_plan_wages_coverage_days(employer, quarterStart, periodDays, coverageDays)
        and coverageDays > 0;
    then health_plan_wages_allocated_to_period(employer, quarterStart, div_round(amount * periodDays, coverageDays * 1.0, 2, "HALF_UP"));
}

// ============================================================================
// §3134(d), (e), (f)
// ============================================================================

pub relation single_employer_under_52_or_414(a: Person, b: Person) kind empirical {
    label en official "the persons are treated as a single employer under subsection (a) or (b) of section 52 or subsection (m) or (o) of section 414";
}
pub relation treated_as_one_employer_for_3134(a: Person, b: Person) kind institutional {
    label en official "the persons are treated as one employer for purposes of section 3134";
}
@source(IRC_S3134_D, relation = formalizes, coverage = exact, quote = "All persons treated as a single employer under subsection (a) or (b) of section 52, or subsection (m) or (o) of section 414, shall be treated as one employer for purposes of this section.")
rule S3134dAggregation defeasible {
    label en official "aggregated persons are one employer (symmetric)";
    for a: Person;
    for b: Person;
    when single_employer_under_52_or_414(a, b);
    then treated_as_one_employer_for_3134(a, b);
}
rule S3134dAggregationSymmetric defeasible {
    label en official "the relation holds both ways";
    for a: Person;
    for b: Person;
    when single_employer_under_52_or_414(a, b);
    then treated_as_one_employer_for_3134(b, a);
}
pub relation individual_related_to_employer_51i1(pay: WagePayment) kind empirical {
    label en official "the wages are paid to an individual who bears a relationship described in section 152(d)(2)(A)-(H) to the employer (or, for a corporation, to a 5-percent owner: rules similar to section 51(i)(1))";
}
pub relation wages_not_taken_into_account_related_individual(pay: WagePayment) kind institutional {
    label en official "the wages are not taken into account (rules similar to section 51(i)(1))";
}
@source(IRC_S3134_E, relation = formalizes, coverage = partial, quote = "For purposes of this section, rules similar to the rules of sections 51(i)(1) and 280C(a) shall apply.")
rule S3134eRelatedIndividualWages defeasible {
    label en official "related individuals' wages are excluded (the 51(i)(1) rule as far as its content is a case fact)";
    for pay: WagePayment;
    when individual_related_to_employer_51i1(pay);
    then wages_not_taken_into_account_related_individual(pay);
}
pub relation section_3134_credit_for_deduction(employer: Person, quarterStart: Date, credit: Money) kind institutional {
    label en official "the credit whose amount reduces the deduction for the wages (rules similar to section 280C(a))";
}
rule S3134e280CaReduction defeasible {
    label en official "the deduction for wages is reduced by the credit amount";
    for employer: Person;
    for quarterStart: Date;
    for credit: Money;
    when section_3134_credit(employer, quarterStart, credit);
    then section_3134_credit_for_deduction(employer, quarterStart, credit);
}
pub relation governmental_employer_3134f1(employer: Person) kind empirical {
    label en official "the employer is the Government of the United States, the government of a State or political subdivision, or an agency or instrumentality of any of them";
}
pub relation organization_501c1_exempt(employer: Person) kind empirical {
    label en official "the employer is an organization described in section 501(c)(1) and exempt from tax under section 501(a)";
}
pub relation entity_is_college_or_university(employer: Person) kind empirical {
    label en official "the entity is a college or university";
}
pub relation entity_principal_purpose_medical_or_hospital_care(employer: Person) kind empirical {
    label en official "the principal purpose or function of the entity is providing medical or hospital care";
}
@source(IRC_S3134_F, relation = formalizes, coverage = exact, quote = "(A) any organization described in section 501(c)(1) and exempt from tax under section 501(a), or")
rule S3134f2AExempt501c1 strict {
    label en official "a 501(c)(1) organization is within the exception";
    for employer: Person;
    when governmental_employer_3134f1(employer)
        and organization_501c1_exempt(employer);
    then organization_described_in_3134f2(employer);
}
@source(IRC_S3134_F, relation = formalizes, coverage = exact, quote = "(i) such entity is a college or university, or")
rule S3134f2BiCollege strict {
    label en official "a governmental college or university";
    for employer: Person;
    when governmental_employer_3134f1(employer)
        and entity_is_college_or_university(employer);
    then organization_described_in_3134f2(employer);
}
@source(IRC_S3134_F, relation = formalizes, coverage = exact, quote = "(ii) the principal purpose or function of such entity is providing medical or hospital care.")
rule S3134f2BiiMedical strict {
    label en official "a governmental entity whose principal purpose is medical or hospital care";
    for employer: Person;
    when governmental_employer_3134f1(employer)
        and entity_principal_purpose_medical_or_hospital_care(employer);
    then organization_described_in_3134f2(employer);
}
pub relation credit_not_applicable_to_governmental_employer(employer: Person) kind institutional {
    label en official "the credit does not apply to the employer";
}
@source(IRC_S3134_F, relation = formalizes, coverage = exact, quote = "This credit shall not apply to the Government of the United States, the government of any State or political subdivision thereof, or any agency or instrumentality of any of the foregoing.")
rule S3134f1GovernmentalDenial strict {
    label en official "governmental employers, unless within the exception";
    for employer: Person;
    when governmental_employer_3134f1(employer)
        and not_known(organization_described_in_3134f2_exists(employer));
    then credit_not_applicable_to_governmental_employer(employer);
}
relation organization_described_in_3134f2_exists(employer: Person) kind institutional;
rule OrganizationDescribedIn3134f2Exists strict {
    for employer: Person;
    when organization_described_in_3134f2(employer);
    then organization_described_in_3134f2_exists(employer);
}
@source(IRC_S3134_F, relation = formalizes, coverage = exact, quote = "In the case of any entity described in subparagraph (B), such entity shall be treated as satisfying the requirements of subsection (c)(2)(A)(i).")
rule S3134f2CarryingOnDeemed defeasible {
    label en official "a governmental college or medical entity is treated as carrying on a trade or business";
    for employer: Person;
    for quarterStart: Date;
    when entity_is_college_or_university(employer)
        and governmental_employer_3134f1(employer)
        and any_operation_of_organization_suspended(employer, quarterStart);
    then eligible_by_suspension(employer, quarterStart);
}
rule S3134f2CarryingOnDeemedMedical defeasible {
    label en official "the medical or hospital care entity";
    for employer: Person;
    for quarterStart: Date;
    when entity_principal_purpose_medical_or_hospital_care(employer)
        and governmental_employer_3134f1(employer)
        and any_operation_of_organization_suspended(employer, quarterStart);
    then eligible_by_suspension(employer, quarterStart);
}

// ============================================================================
// §3134(h), (j), (l), (m), (n)
// ============================================================================

pub relation payroll_costs_taken_into_account_for_program(pay: WagePayment, amount: Money) kind empirical {
    label en official "the amount of the qualified wages taken into account as payroll costs in connection with a covered loan (Small Business Act 7(a)(37) or 7A), a grant under section 324 of the Economic Aid Act, or a restaurant revitalization grant";
}
pub relation payroll_costs_of_loan_not_forgiven(pay: WagePayment, amount: Money) kind empirical {
    label en official "the part of those payroll costs of a covered loan that is not forgiven by reason of a decision under section 7(a)(37)(J) or 7A(g)";
}
pub relation qualified_wages_excluded_for_program(pay: WagePayment, amount: Money) kind institutional {
    label en official "the part of the qualified wages the section does not apply to";
}
@source(IRC_S3134_H, relation = formalizes, coverage = exact, quote = "This section shall not apply to so much of the qualified wages paid by an eligible employer as are taken into account as payroll costs in connection with—")
rule S3134h1ProgramWages defeasible {
    label en official "the wages used as payroll costs, less what the guidance restores (not forgiven)";
    for pay: WagePayment;
    for taken: Money;
    for notForgiven: Money;
    when payroll_costs_taken_into_account_for_program(pay, taken)
        and payroll_costs_of_loan_not_forgiven(pay, notForgiven)
        and taken > notForgiven;
    then qualified_wages_excluded_for_program(pay, taken - notForgiven);
}
rule S3134h1ProgramWagesNoRestoration defeasible {
    label en official "no restoration for an unforgiven loan";
    for pay: WagePayment;
    for taken: Money;
    when payroll_costs_taken_into_account_for_program(pay, taken)
        and not_known(payroll_costs_not_forgiven_exists(pay));
    then qualified_wages_excluded_for_program(pay, taken);
}
relation payroll_costs_not_forgiven_exists(pay: WagePayment) kind institutional;
rule PayrollCostsNotForgivenExists defeasible {
    for pay: WagePayment;
    for amount: Money;
    when payroll_costs_of_loan_not_forgiven(pay, amount);
    then payroll_costs_not_forgiven_exists(pay);
}
pub relation secretary_issued_ppp_guidance(dummy: Person) kind empirical {
    label en official "the Secretary has issued guidance providing that payroll costs paid during the covered period shall not fail to be treated as qualified wages to the extent a covered loan is not forgiven";
}
pub relation section_3134_administered_employer(employer: Person) kind empirical {
    label en unofficial "an employer to whom the section 3134 guidance duties relate (binds the Secretary's duty to a case)";
}
@source(IRC_S3134_H, relation = formalizes, coverage = exact, quote = "The Secretary shall issue guidance providing that payroll costs paid during the covered period shall not fail to be treated as qualified wages under this section by reason of paragraph (1) to the extent that—")
pub rule S3134h2GuidanceDutyRule defeasible {
    label en official "the Secretary shall issue guidance on unforgiven covered loans (no deadline stated: open window)";
    for employer: Person;
    when section_3134_administered_employer(employer);
    then duty S3134h2GuidanceDuty {
        bearer Secretary;
        goal achievement {
            condition secretary_issued_ppp_guidance(employer);
            window [-infinity, infinity];
        }
    };
}
pub relation advance_payment_of_credit_made(employer: Person, quarterStart: Date, amount: Money) kind empirical {
    label en official "an advance payment of the credit is made for the quarter";
}
pub relation employer_elects_advance_payment(employer: Person, quarterStart: Date) kind empirical {
    label en official "the eligible employer elects, under the Secretary's rules, to receive an advance payment for the quarter";
}
pub relation average_quarterly_wages_2019(employer: Person, amount: Money) kind empirical {
    label en official "the average quarterly wages paid by the employer in calendar year 2019";
}
pub relation average_quarterly_wages_2020(employer: Person, amount: Money) kind empirical {
    label en official "the average quarterly wages in 2020, for an employer not in existence in 2019";
}
pub relation wages_of_corresponding_quarter_2019(employer: Person, quarterStart: Date, amount: Money) kind empirical {
    label en official "the wages for the calendar quarter in 2019 which corresponds to the quarter to which the election relates (seasonal employers)";
}
pub relation wages_of_corresponding_quarter_2020(employer: Person, quarterStart: Date, amount: Money) kind empirical {
    label en official "the same for 2020 (employer not in existence in 2019)";
}
pub relation seasonal_employer_elects_corresponding_quarter(employer: Person, quarterStart: Date) kind empirical {
    label en official "an employer of seasonal workers (section 45R(d)(5)(B)) elects the corresponding-quarter base";
}
pub relation advance_payment_ceiling(employer: Person, quarterStart: Date, amount: Money) kind institutional {
    label en official "70 percent of the base wages: the largest advance payment a small employer may elect";
}
@source(IRC_S3134_J, relation = formalizes, coverage = exact, quote = "in an amount not to exceed 70 percent of the average quarterly wages paid by the employer in calendar year 2019")
rule S3134j2AAverageQuarterlyWages defeasible {
    label en official "70 percent of the 2019 average quarterly wages";
    for employer: Person;
    for quarterStart: Date;
    for wages: Money;
    for count: Integer;
    when eligible_employer_3134_derived(employer, quarterStart)
        and employer_in_existence_in_2019(employer)
        and average_full_time_employees_2019(employer, count)
        and count <= 500
        and average_quarterly_wages_2019(employer, wages)
        and employer_elects_advance_payment(employer, quarterStart)
        and not_known(seasonal_election_exists(employer, quarterStart));
    then advance_payment_ceiling(employer, quarterStart, round(wages * 0.70, 2, "HALF_UP"));
}
relation seasonal_election_exists(employer: Person, quarterStart: Date) kind institutional;
rule SeasonalElectionExists defeasible {
    for employer: Person;
    for quarterStart: Date;
    when seasonal_employer_elects_corresponding_quarter(employer, quarterStart);
    then seasonal_election_exists(employer, quarterStart);
}
@source(IRC_S3134_J, relation = formalizes, coverage = exact, quote = "the wages for the calendar quarter in 2019 which corresponds to the calendar quarter to which the election relates")
rule S3134j2BSeasonal defeasible {
    label en official "seasonal employers: 70 percent of the corresponding 2019 quarter's wages";
    for employer: Person;
    for quarterStart: Date;
    for wages: Money;
    for count: Integer;
    when eligible_employer_3134_derived(employer, quarterStart)
        and employer_in_existence_in_2019(employer)
        and average_full_time_employees_2019(employer, count)
        and count <= 500
        and seasonal_employer_elects_corresponding_quarter(employer, quarterStart)
        and wages_of_corresponding_quarter_2019(employer, quarterStart, wages)
        and employer_elects_advance_payment(employer, quarterStart);
    then advance_payment_ceiling(employer, quarterStart, round(wages * 0.70, 2, "HALF_UP"));
}
@source(IRC_S3134_J, relation = formalizes, coverage = exact, quote = "In the case of any employer that was not in existence in 2019, subparagraphs (A) and (B) shall each be applied by substituting \"2020\" for \"2019\" each place it appears.")
rule S3134j2CNotInExistence2019 defeasible {
    label en official "an employer not in existence in 2019 uses 2020 (average or corresponding quarter)";
    for employer: Person;
    for quarterStart: Date;
    for wages: Money;
    for count: Integer;
    when eligible_employer_3134_derived(employer, quarterStart)
        and not_known(employer_in_existence_in_2019(employer))
        and average_full_time_employees_2020(employer, count)
        and count <= 500
        and average_quarterly_wages_2020(employer, wages)
        and employer_elects_advance_payment(employer, quarterStart)
        and not_known(seasonal_election_exists(employer, quarterStart));
    then advance_payment_ceiling(employer, quarterStart, round(wages * 0.70, 2, "HALF_UP"));
}
@source(IRC_S3134_J, relation = formalizes, coverage = exact, quote = "Except as provided in paragraph (2), no advance payment of the credit under subsection (a) shall be allowed.")
pub rule S3134j1NoAdvancePayment defeasible {
    label en official "an advance payment is prohibited unless the elected small-employer conditions hold and the amount stays within the ceiling";
    for employer: Person;
    for quarterStart: Date;
    for amount: Money;
    when advance_payment_of_credit_made(employer, quarterStart, amount)
        and not_known(advance_payment_ceiling_exists(employer, quarterStart));
    then prohibition S3134j1NoAdvancePaymentProhibition {
        bearer Secretary;
        beneficiary employer;
        action advance_payment_of_credit_made(employer, quarterStart, amount);
        window [-infinity, infinity];
    };
}
relation advance_payment_ceiling_exists(employer: Person, quarterStart: Date) kind institutional;
rule AdvancePaymentCeilingExists defeasible {
    for employer: Person;
    for quarterStart: Date;
    for amount: Money;
    when advance_payment_ceiling(employer, quarterStart, amount);
    then advance_payment_ceiling_exists(employer, quarterStart);
}
pub relation advance_payment_exceeds_ceiling(employer: Person, quarterStart: Date) kind institutional {
    label en official "the advance payment exceeds the ceiling of paragraph (2)";
}
rule AdvancePaymentExceedsCeiling defeasible {
    label en official "the advance payment is above 70 percent of the base wages";
    for employer: Person;
    for quarterStart: Date;
    for paid: Money;
    for ceiling: Money;
    when advance_payment_of_credit_made(employer, quarterStart, paid)
        and advance_payment_ceiling(employer, quarterStart, ceiling)
        and paid > ceiling;
    then advance_payment_exceeds_ceiling(employer, quarterStart);
}
@source(IRC_S3134_J, relation = formalizes, coverage = exact, quote = "The amount of credit which would (but for this subsection) be allowed under this section shall be reduced (but not below zero) by the aggregate payment allowed to the taxpayer under paragraph (2).")
pub relation credit_after_advance_payments(employer: Person, quarterStart: Date, amount: Money) kind institutional {
    label en official "the credit reduced (but not below zero) by the advance payments";
}
rule S3134j3AReducedByAdvance defeasible {
    label en official "credit - advance when the credit exceeds the advance";
    for employer: Person;
    for quarterStart: Date;
    for credit: Money;
    for advance: Money;
    when section_3134_credit(employer, quarterStart, credit)
        and advance_payment_of_credit_made(employer, quarterStart, advance)
        and credit > advance;
    then credit_after_advance_payments(employer, quarterStart, credit - advance);
}
rule S3134j3AReducedToZero defeasible {
    label en official "not below zero";
    for employer: Person;
    for quarterStart: Date;
    for credit: Money;
    for advance: Money;
    when section_3134_credit(employer, quarterStart, credit)
        and advance_payment_of_credit_made(employer, quarterStart, advance)
        and credit <= advance;
    then credit_after_advance_payments(employer, quarterStart, 0.00 USD);
}
pub relation excess_advance_payment_increases_tax(employer: Person, quarterStart: Date, amount: Money) kind institutional {
    label en official "the tax imposed under section 3111(b) (or the part of 3221(a)) for the quarter is increased by the excess of the advance payments over the credit (determined without the reduction)";
}
@source(IRC_S3134_J, relation = formalizes, coverage = exact, quote = "the tax imposed under section 3111(b) or so much of the tax imposed under section 3221(a) as is attributable to the rate in effect under section 3111(b) (whichever is applicable) for the calendar quarter shall be increased by the amount of such excess")
rule S3134j3BExcessAdvance defeasible {
    label en official "advance - credit when the advance exceeds the credit";
    for employer: Person;
    for quarterStart: Date;
    for credit: Money;
    for advance: Money;
    when section_3134_gross_credit(employer, quarterStart, credit)
        and advance_payment_of_credit_made(employer, quarterStart, advance)
        and advance > credit;
    then excess_advance_payment_increases_tax(employer, quarterStart, advance - credit);
}
pub relation credit_original_return_filed_on(employer: Person, quarterStart: Date, filedOn: Date) kind empirical {
    label en official "the original return that includes the quarter is filed";
}
pub relation credit_return_treated_as_filed_on(employer: Person, quarterStart: Date, treatedOn: Date) kind empirical {
    label en official "the return is treated as filed under section 6501(b)(2)";
}
pub relation credit_assessment_candidate_5y(employer: Person, quarterStart: Date, candidate: Date) kind institutional {
    label en unofficial "5 years after one of the two dates";
}
rule S3134lCandidateFiled defeasible {
    label en official "5 years after the original return is filed";
    for employer: Person;
    for quarterStart: Date;
    for filedOn: Date;
    when credit_original_return_filed_on(employer, quarterStart, filedOn);
    then credit_assessment_candidate_5y(employer, quarterStart, add_calendar_period(filedOn, 5 calendar_year));
}
rule S3134lCandidateTreated defeasible {
    label en official "5 years after the return is treated as filed";
    for employer: Person;
    for quarterStart: Date;
    for treatedOn: Date;
    when credit_return_treated_as_filed_on(employer, quarterStart, treatedOn);
    then credit_assessment_candidate_5y(employer, quarterStart, add_calendar_period(treatedOn, 5 calendar_year));
}
pub relation later_credit_assessment_candidate_exists(employer: Person, quarterStart: Date, candidate: Date) kind institutional {
    label en unofficial "a strictly later candidate exists";
}
rule LaterCreditAssessmentCandidateExists defeasible {
    for employer: Person;
    for quarterStart: Date;
    for c1: Date;
    for c2: Date;
    when credit_assessment_candidate_5y(employer, quarterStart, c1)
        and credit_assessment_candidate_5y(employer, quarterStart, c2)
        and c2 > c1;
    then later_credit_assessment_candidate_exists(employer, quarterStart, c1);
}
pub relation credit_assessment_period_lower_bound(employer: Person, quarterStart: Date, bound: Date) kind institutional {
    label en official "the limitation on assessment of any amount attributable to the credit does not expire before this date";
}
@source(IRC_S3134_L, relation = formalizes, coverage = exact, quote = "the limitation on the time period for the assessment of any amount attributable to a credit claimed under this section shall not expire before the date that is 5 years after the later of—")
rule S3134lLatestCandidate defeasible {
    label en official "5 years after the later of the two dates";
    for employer: Person;
    for quarterStart: Date;
    for c: Date;
    when credit_assessment_candidate_5y(employer, quarterStart, c)
        and not_known(later_credit_assessment_candidate_exists(employer, quarterStart, c));
    then credit_assessment_period_lower_bound(employer, quarterStart, c);
}
pub relation secretary_issued_3134m_guidance(kind: Integer) kind empirical {
    label en official "the Secretary has issued the forms, instructions, regulations and other guidance of paragraph (1), (2) or (3)";
}
pub relation section_3134_guidance_period(dummy: Person) kind empirical {
    label en unofficial "binds the Secretary's guidance duties to a case";
}
@source(IRC_S3134_M, relation = formalizes, coverage = exact, quote = "The Secretary shall issue such forms, instructions, regulations, and other guidance as are necessary—")
pub rule S3134m1AdvancePaymentGuidanceRule defeasible {
    label en official "guidance allowing the advance payment of (j)(2)";
    for p: Person;
    when section_3134_guidance_period(p);
    then duty S3134m1AdvancePaymentGuidanceDuty {
        bearer Secretary;
        goal achievement {
            condition secretary_issued_3134m_guidance(1);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S3134_M, relation = formalizes, coverage = exact, quote = "with respect to the application of the credit under subsection (a) to third party payors")
pub rule S3134m2ThirdPartyPayorGuidanceRule defeasible {
    label en official "guidance on third party payors";
    for p: Person;
    when section_3134_guidance_period(p);
    then duty S3134m2ThirdPartyPayorGuidanceDuty {
        bearer Secretary;
        goal achievement {
            condition secretary_issued_3134m_guidance(2);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S3134_M, relation = formalizes, coverage = exact, quote = "to prevent the avoidance of the purposes of the limitations under this section, including through the leaseback of employees.")
pub rule S3134m3AntiAvoidanceGuidanceRule defeasible {
    label en official "guidance to prevent avoidance, including leaseback of employees";
    for p: Person;
    when section_3134_guidance_period(p);
    then duty S3134m3AntiAvoidanceGuidanceDuty {
        bearer Secretary;
        goal achievement {
            condition secretary_issued_3134m_guidance(3);
            window [-infinity, infinity];
        }
    };
}
pub relation guidance_makes_customer_responsible(dummy: Person) kind empirical {
    label en official "the guidance described in paragraph (2) requires the customer to be responsible for the accounting of the credit and for any liability for improperly claimed credits, and requires the CPEO or other third party payor to report the credits accurately";
}
@source(IRC_S3134_M, relation = formalizes, coverage = exact, quote = "shall require the customer to be responsible for the accounting of the credit and for any liability for improperly claimed credits")
pub rule S3134mCustomerResponsibilityRule defeasible {
    label en official "the third party payor guidance shall assign the responsibilities to the customer and the payor";
    for p: Person;
    when section_3134_guidance_period(p);
    then duty S3134mCustomerResponsibilityDuty {
        bearer Secretary;
        goal achievement {
            condition guidance_makes_customer_responsible(p);
            window [-infinity, infinity];
        }
    };
}
pub relation wage_paid_on_for_3134(pay: WagePayment, employer: Person, on: Date) kind institutional {
    label en unofficial "helper: the wage payment and its date";
}
rule WagePaidOnFor3134 defeasible {
    for pay: WagePayment;
    for employer: Person;
    for on: Date;
    when wage_payment(pay, employer, _, _, _, on);
    then wage_paid_on_for_3134(pay, employer, on);
}
pub relation wages_within_3134_application_window(pay: WagePayment) kind institutional {
    label en official "the wages are paid after June 30, 2021 and before October 1, 2021 (January 1, 2022 for a recovery startup business)";
}
@source(IRC_S3134_N, relation = formalizes, coverage = exact, quote = "This section shall only apply to wages paid after June 30, 2021, and before October 1, 2021")
rule S3134nGeneralWindow defeasible {
    label en official "wages paid from 2021-07-01 through 2021-09-30";
    for pay: WagePayment;
    for on: Date;
    when wage_paid_on_for_3134(pay, _, on)
        and on > @2021-06-30
        and on < @2021-10-01;
    then wages_within_3134_application_window(pay);
}
@source(IRC_S3134_N, relation = formalizes, coverage = exact, quote = "(or, in the case of wages paid by an eligible employer which is a recovery startup business, January 1, 2022)")
rule S3134nRecoveryStartupWindow defeasible {
    label en official "a recovery startup business: wages paid before January 1, 2022";
    for pay: WagePayment;
    for employer: Person;
    for on: Date;
    for quarterStart: Date;
    when wage_paid_on_for_3134(pay, employer, on)
        and recovery_startup_business_3134c5(employer, quarterStart)
        and on > @2021-06-30
        and on < @2022-01-01;
    then wages_within_3134_application_window(pay);
}
