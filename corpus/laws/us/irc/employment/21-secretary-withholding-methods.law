// 26 U.S.C. §3402(b)-(c), (h), (m), (t) — Secretary-prescribed withholding
// computation readers (IRC-G/G5, step 4).
//
// WHAT. Thirty-three coverage rows (employment.json, EXTERNAL_DEPENDENCY):
// (b) u1–u4 (percentage method), (c) u1–u6 (wage bracket), (h) ×16
// (alternative methods), (m) ×4 (additional allowance), (t) ×3
// (qualified-stock floor). One rule per row (37 rules: 33 row rules + the
// shared percentage/tolerance from-table legs listed under the rows they
// serve), each with a вывод / нет-факта-источника scenario pair in
// `tests/secretary-withholding-methods.lawtest` (NOT EXECUTED,
// implemented_unverified — execution waits on CLIR snapshots, as with G4).
//
// HOW (AFR/cfr-wire pattern). Case-selected relations carry the row's
// operative facts; policy rules derive which Pub. 15-T table/period applies
// (in `.law` only the source's key literals — no rates); from-table rules
// read the pinned `us.irs.pub_15t_2026` tables (dependency + world in
// law.toml; registry publication of the source package and the consumer
// lock --write are the owner gate, step 6 — same as G4). Regulation
// content (§31.3402(b)-1/(c)-1/(h)/(m)-1, pinned renders in
// `us.cfr.t26_31_3402_b_c_h_m`) enters as case-selected facts with the
// section named in comments — the from-regulation leg waits on the
// registry, exactly as in G4. The (t) floor reads the EXISTING dependency
// `us.irc.income_individual::highest_rate_under_section_1` (no new wiring).
//
// NOT TOUCHED. The case-fact paths (`secretary_prescribed_withholding_amount`,
// `wages_3401`, the (a) duty in `04-income-tax-withholding.law`) are intact:
// these rules ADD table/policy derivations, they do not replace a single
// case assertion. No arithmetic over running ledgers anywhere (the (h)(2)–(3)
// day-by-day accumulation stays case-side per the LDC-E4102 flag in `04`);
// the only builtins are single-step `round` (nearest-dollar elections,
// as in the gambling rule) and one Money `+` for the (h)(3)(A) snapshot
// aggregate. Wage-bracket cell values are case facts: §§2–3 cells are not
// transcribed in phase 1 (recon item 2, edition-index unresolved).

language "law.core" version "0.2";
package us.irc.employment version "0.1.1";
namespace "urn:us:irc:employment:clir";

import us.irs.pub_15t_2026 version "0.1.1";

use self::{
    IRC_S3402_A,
    IRC_S3402_B,
    IRC_S3402_C,
    IRC_S3402_H,
    IRC_S3402_M,
    IRC_S3402_T,
    Person,
    TaxableYear,
    WagePayment,
    wage_payment,
};

// --- §3402(b): percentage method --------------------------------------------
// The (b)(1)–(3) units select the table period; (b)(4) rounds the wages.
// Table values come from the three shared legs below (Pub. 15-T §§1/4/5,
// pinned in us.irs.pub_15t_2026); the regulation bridge is §31.3402(b)-1(a)
// (T.D. 9924: applicable tables «set forth in the applicable forms,
// instructions, publications ... prescribed by the Commissioner»).

relation non_payroll_period_wages_3402(pay: WagePayment) kind empirical {
    label en unofficial "wages paid with respect to a period which is not a payroll period (case fact; section 3402(b)(1), (c)(2))";
}
relation no_period_wages_3402(pay: WagePayment) kind empirical {
    label en unofficial "wages paid without regard to any payroll period or other period (case fact; section 3402(b)(2), (c)(3))";
}
relation short_period_wages_3402(pay: WagePayment) kind empirical {
    label en unofficial "the period (or paragraph (2)/(3) time) for the wages is less than one week (case fact; section 3402(b)(3), (c)(4))";
}
relation nearest_dollar_elected_3402(pay: WagePayment) kind empirical {
    label en unofficial "the employer elected nearest-dollar computation for this payment (case fact; section 3402(b)(4), (c)(5))";
}
pub relation misc_table_period_3402(pay: WagePayment, period: Text) kind institutional {
    label en official "the miscellaneous-payroll-period table for this payment: the Pub. 15-T daily-or-miscellaneous period";
}
@source(IRC_S3402_B, relation = formalizes, coverage = exact, quote = "If wages are paid with respect to a period which is not a payroll period, the withholding allowance allowable with respect to each payment of such wages shall be the allowance allowed for a miscellaneous payroll period containing a number of days (including Sundays and holidays) equal to the number of days in the period with respect to which such wages are paid.")
rule S3402b1NonPayrollPeriodMiscTable(pay: WagePayment) strict {
    when non_payroll_period_wages_3402(pay);
    then misc_table_period_3402(pay, "daily");
}
@source(IRC_S3402_B, relation = formalizes, coverage = exact, quote = "In any case in which wages are paid by an employer without regard to any payroll period or other period, the withholding allowance allowable with respect to each payment of such wages shall be the allowance allowed for a miscellaneous payroll period containing a number of days equal to the number of days (including Sundays and holidays) which have elapsed since the date of the last payment of such wages by such employer during the calendar year, or the date of commencement of employment with such employer during such year, or January 1 of such year, whichever is the later.")
rule S3402b2NoPeriodMiscTable(pay: WagePayment) strict {
    when no_period_wages_3402(pay);
    then misc_table_period_3402(pay, "daily");
}
pub relation weekly_table_authorized_3402(pay: WagePayment) kind institutional {
    label en official "the Secretary-authorized weekly computation for a sub-week period: aggregate calendar-week wages as weekly wages";
}
@source(IRC_S3402_B, relation = formalizes, coverage = exact, quote = "In any case in which the period, or the time described in paragraph (2), in respect of any wages is less than one week, the Secretary, under regulations prescribed by him, may authorize an employer to compute the tax to be deducted and withheld as if the aggregate of the wages paid to the employee during the calendar week were paid for a weekly payroll period.")
rule S3402b3ShortPeriodWeeklyTable(pay: WagePayment) strict {
    when short_period_wages_3402(pay);
    then weekly_table_authorized_3402(pay);
}
pub relation wages_nearest_dollar_3402(pay: WagePayment, amount: Money) kind institutional {
    label en official "the wages for this payment computed to the nearest dollar under the employer's election";
}
@source(IRC_S3402_B, relation = formalizes, coverage = exact, quote = "In determining the amount to be deducted and withheld under this subsection, the wages may, at the election of the employer, be computed to the nearest dollar.")
rule S3402b4NearestDollarWages(pay: WagePayment, employer: Person, employee: Person, year: TaxableYear, amount: Money, on: Date) strict {
    when wage_payment(pay, employer, employee, year, amount, on) and nearest_dollar_elected_3402(pay);
    then wages_nearest_dollar_3402(pay, round(amount, 0, "HALF_UP"));
}

// Shared percentage-method legs: Worksheet results (case facts in dollars)
// against the pinned §1/§4/§5 schedules. In `.law` only the source's key
// literals; every rate, base and excess comes from the tables.
relation pct_lookup_annual_3402(pay: WagePayment, schedule: Text, status: Text, wage: Decimal) kind empirical {
    label en unofficial "Worksheet 1A Adjusted Annual Wage Amount with its schedule/status keys for the annual table (case fact)";
}
relation pct_lookup_manual_2020_3402(pay: WagePayment, period: Text, schedule: Text, status: Text, wage: Decimal) kind empirical {
    label en unofficial "Worksheet 4 Adjusted Wage Amount with its period/schedule/status keys (case fact)";
}
relation pct_lookup_manual_2019_3402(pay: WagePayment, period: Text, marital: Text, wage: Decimal) kind empirical {
    label en unofficial "Worksheet 5 Adjusted Wage Amount with its period/marital keys (case fact)";
}
pub relation pct_bracket_annual_3402(pay: WagePayment, base: Decimal, rate: Decimal, excess_over: Decimal) kind institutional {
    label en official "the annual percentage-schedule row for this payment from Pub. 15-T section 1 (tentative = base + rate × (wage − excess_over))";
}
pub relation pct_bracket_manual_2020_3402(pay: WagePayment, base: Decimal, rate: Decimal, excess_over: Decimal) kind institutional {
    label en official "the manual-2020 percentage-schedule row for this payment from Pub. 15-T section 4";
}
pub relation pct_bracket_manual_2019_3402(pay: WagePayment, base: Decimal, rate: Decimal, excess_over: Decimal) kind institutional {
    label en official "the manual-2019 percentage-table row for this payment from Pub. 15-T section 5";
}
@source(IRC_S3402_A, relation = formalizes, coverage = partial, quote = "a tax determined in accordance with tables or computational procedures prescribed by the Secretary")
rule S3402bAnnualBracketFromTable(pay: WagePayment, schedule: Text, status: Text, wage: Decimal, base: Decimal, rate: Decimal, excess: Decimal) strict {
    when pct_lookup_annual_3402(pay, schedule, status, wage)
        and us.irs.pub_15t_2026::annual_pct_bracket(schedule, status, wage, base, rate, excess);
    then pct_bracket_annual_3402(pay, base, rate, excess);
}
@source(IRC_S3402_A, relation = formalizes, coverage = partial, quote = "a tax determined in accordance with tables or computational procedures prescribed by the Secretary")
rule S3402bManual2020BracketFromTable(pay: WagePayment, period: Text, schedule: Text, status: Text, wage: Decimal, base: Decimal, rate: Decimal, excess: Decimal) strict {
    when pct_lookup_manual_2020_3402(pay, period, schedule, status, wage)
        and us.irs.pub_15t_2026::manual_pct_2020_bracket(period, schedule, status, wage, base, rate, excess);
    then pct_bracket_manual_2020_3402(pay, base, rate, excess);
}
@source(IRC_S3402_A, relation = formalizes, coverage = partial, quote = "a tax determined in accordance with tables or computational procedures prescribed by the Secretary")
rule S3402bManual2019BracketFromTable(pay: WagePayment, period: Text, marital: Text, wage: Decimal, base: Decimal, rate: Decimal, excess: Decimal) strict {
    when pct_lookup_manual_2019_3402(pay, period, marital, wage)
        and us.irs.pub_15t_2026::manual_pct_2019_bracket(period, marital, wage, base, rate, excess);
    then pct_bracket_manual_2019_3402(pay, base, rate, excess);
}

// --- §3402(c): wage-bracket method ------------------------------------------
// Election (u1), period mappings (u2–u4), rounding (u5), post-1969 tables
// (u6). Bracket cell values are case facts: §§2–3 cells are not transcribed
// in phase 1 (recon item 2). The regulation bridge is §31.3402(c)-1(a)(2).

relation wage_bracket_election_case_3402c(employee: Person, employer: Person) kind empirical {
    label en unofficial "the employer elected wage-bracket withholding for this employee (case fact; section 3402(c)(1))";
}
relation above_top_bracket_wages_3402c(pay: WagePayment) kind empirical {
    label en unofficial "the wages exceed the highest wage bracket (case fact; section 3402(c)(5))";
}
relation post_1969_wages_3402c(pay: WagePayment) kind empirical {
    label en unofficial "wages paid after December 31, 1969 (case fact; section 3402(c)(6))";
}
pub relation wage_bracket_elected_3402c(pay: WagePayment) kind institutional {
    label en official "wage-bracket withholding applies to this payment in lieu of subsection (a)";
}
@source(IRC_S3402_C, relation = formalizes, coverage = exact, quote = "At the election of the employer with respect to any employee, the employer shall deduct and withhold upon the wages paid to such employee a tax (in lieu of the tax required to be deducted and withheld under subsection (a)) determined in accordance with tables prescribed by the Secretary in accordance with paragraph (6).")
rule S3402c1WageBracketElection(pay: WagePayment, employer: Person, employee: Person, year: TaxableYear, amount: Money, on: Date) strict {
    when wage_payment(pay, employer, employee, year, amount, on) and wage_bracket_election_case_3402c(employee, employer);
    then wage_bracket_elected_3402c(pay);
}
@source(IRC_S3402_C, relation = formalizes, coverage = exact, quote = "If wages are paid with respect to a period which is not a payroll period, the amount to be deducted and withheld shall be that applicable in the case of a miscellaneous payroll period containing a number of days (including Sundays and holidays) equal to the number of days in the period with respect to which such wages are paid.")
rule S3402c2NonPayrollPeriodMiscTable(pay: WagePayment) strict {
    when non_payroll_period_wages_3402(pay) and wage_bracket_elected_3402c(pay);
    then misc_table_period_3402(pay, "daily");
}
@source(IRC_S3402_C, relation = formalizes, coverage = exact, quote = "In any case in which wages are paid by an employer without regard to any payroll period or other period, the amount to be deducted and withheld shall be that applicable in the case of a miscellaneous payroll period containing a number of days equal to the number of days (including Sundays and holidays) which have elapsed since the date of the last payment of such wages by such employer during the calendar year, or the date of commencement of employment with such employer during such year, or January 1 of such year, whichever is the later.")
rule S3402c3NoPeriodMiscTable(pay: WagePayment) strict {
    when no_period_wages_3402(pay) and wage_bracket_elected_3402c(pay);
    then misc_table_period_3402(pay, "daily");
}
@source(IRC_S3402_C, relation = formalizes, coverage = exact, quote = "In any case in which the period, or the time described in paragraph (3), in respect of any wages is less than one week, the Secretary, under regulations prescribed by him, may authorize an employer to determine the amount to be deducted and withheld under the tables applicable in the case of a weekly payroll period, in which case the aggregate of the wages paid to the employee during the calendar week shall be considered the weekly wages.")
rule S3402c4ShortPeriodWeeklyTable(pay: WagePayment) strict {
    when short_period_wages_3402(pay) and wage_bracket_elected_3402c(pay);
    then weekly_table_authorized_3402(pay);
}
@source(IRC_S3402_C, relation = formalizes, coverage = exact, quote = "If the wages exceed the highest wage bracket, in determining the amount to be deducted and withheld under this subsection, the wages may, at the election of the employer, be computed to the nearest dollar.")
rule S3402c5AboveTopBracketNearestDollar(pay: WagePayment, employer: Person, employee: Person, year: TaxableYear, amount: Money, on: Date) strict {
    when wage_payment(pay, employer, employee, year, amount, on) and above_top_bracket_wages_3402c(pay) and nearest_dollar_elected_3402(pay);
    then wages_nearest_dollar_3402(pay, round(amount, 0, "HALF_UP"));
}
pub relation wage_bracket_secretary_tables_3402c(pay: WagePayment) kind institutional {
    label en official "this wage-bracket payment is governed by the Secretary-prescribed tables (post-1969 wages)";
}
@source(IRC_S3402_C, relation = formalizes, coverage = exact, quote = "In the case of wages paid after December 31, 1969, the amount deducted and withheld under paragraph (1) shall be determined in accordance with tables prescribed by the Secretary.")
rule S3402c6Post1969SecretaryTables(pay: WagePayment) strict {
    when wage_bracket_elected_3402c(pay) and post_1969_wages_3402c(pay);
    then wage_bracket_secretary_tables_3402c(pay);
}

// --- §3402(h): alternative methods ------------------------------------------
// The chapeau authorization (u1) is the Secretary's regulations, pinned as
// renders in us.cfr.t26_31_3402_b_c_h_m (§§31.3402(h)(1)-1–(h)(4)-1): the
// regulation text enters as case-selected facts, exactly as in G4, and the
// from-regulation leg waits on the registry. Method availability chains off
// the chapeau authorization (the requested method passes through as Text,
// matched by literal — no string comparison). (h)(2)(B) and (h)(3)(C) read
// the transcribed percentage tables through method-specific legs; (h)(4)
// reads the tolerance table. Running totals stay case-side (LDC-E4102).

relation alternative_method_requested_3402h(pay: WagePayment, method: Text) kind empirical {
    label en unofficial "the employer uses an alternative computation method for this payment: average, annualized, cumulative or other (case fact; section 3402(h))";
}
pub relation secretary_authorized_alternative_3402h(pay: WagePayment, method: Text) kind institutional {
    label en official "the Secretary authorized this alternative method under regulations (sections 31.3402(h)(1)-1–(h)(4)-1, pinned renders)";
}
@source(IRC_S3402_H, relation = formalizes, coverage = exact, quote = "The Secretary may, under regulations prescribed by him, authorize—")
rule S3402hChapeauSecretaryAuthorization(pay: WagePayment, method: Text) strict {
    when alternative_method_requested_3402h(pay, method);
    then secretary_authorized_alternative_3402h(pay, method);
}

// (h)(1): average wages. The (B) fiction feeds the (a)/(c) tables case-side
// through the shared percentage legs (the average stands in for actual wages).
relation quarterly_wages_estimated_3402h1(employer: Person, employee: Person, quarter: Text, amount: Money) kind empirical {
    label en unofficial "the employer estimated this employee's wages for the calendar quarter (case fact; section 3402(h)(1)(A))";
}
relation average_wages_case_3402h1(pay: WagePayment, average: Money) kind empirical {
    label en unofficial "the appropriate average of the estimated wages for this payment (case fact; section 3402(h)(1)(B))";
}
relation average_withholding_inputs_3402h1(pay: WagePayment, required: Money, withheld: Money) kind empirical {
    label en unofficial "the quarter's required tax and the tax actually withheld so far (case facts; section 3402(h)(1)(C))";
}
pub relation average_method_available_3402h1(pay: WagePayment) kind institutional {
    label en official "withholding on the basis of average wages is available for this payment";
}
pub relation estimated_quarterly_wages_3402h1(employer: Person, employee: Person, quarter: Text, amount: Money) kind institutional {
    label en official "the (h)(1)(A) quarterly estimate of record";
}
pub relation average_constitutes_actual_3402h1(pay: WagePayment, average: Money) kind institutional {
    label en official "the (h)(1)(B) fiction: the average stands in for actual wages for this payment";
}
pub relation average_adjustment_inputs_3402h1(pay: WagePayment, required: Money, withheld: Money) kind institutional {
    label en official "the (h)(1)(C) adjustment inputs of record: required vs actually withheld";
}
@source(IRC_S3402_H, relation = formalizes, coverage = exact, quote = "An employer—")
rule S3402h1AverageMethodAvailable(pay: WagePayment) strict {
    when secretary_authorized_alternative_3402h(pay, "average");
    then average_method_available_3402h1(pay);
}
@source(IRC_S3402_H, relation = formalizes, coverage = exact, quote = "to estimate the wages which will be paid to any employee in any quarter of the calendar year,")
rule S3402h1EstimateQuarterlyWages(employer: Person, employee: Person, quarter: Text, amount: Money) strict {
    when quarterly_wages_estimated_3402h1(employer, employee, quarter, amount);
    then estimated_quarterly_wages_3402h1(employer, employee, quarter, amount);
}
@source(IRC_S3402_H, relation = formalizes, coverage = exact, quote = "to determine the amount to be deducted and withheld upon each payment of wages to such employee during such quarter as if the appropriate average of the wages so estimated constituted the actual wages paid, and")
rule S3402h1AverageAsActualWages(pay: WagePayment, average: Money) strict {
    when average_method_available_3402h1(pay) and average_wages_case_3402h1(pay, average);
    then average_constitutes_actual_3402h1(pay, average);
}
@source(IRC_S3402_H, relation = formalizes, coverage = exact, quote = "to deduct and withhold upon any payment of wages to such employee during such quarter (and, in the case of tips referred to in subsection (k), within 30 days thereafter) such amount as may be necessary to adjust the amount actually deducted and withheld upon the wages of such employee during such quarter to the amount required to be deducted and withheld during such quarter without regard to this subsection.")
rule S3402h1AdjustToRequired(pay: WagePayment, required: Money, withheld: Money) strict {
    when average_constitutes_actual_3402h1(pay, _) and average_withholding_inputs_3402h1(pay, required, withheld);
    then average_adjustment_inputs_3402h1(pay, required, withheld);
}

// (h)(2): annualized wages. (B) reads the pinned annual schedules through
// its own leg (Pub. 15-T section 1 is the annualized-wages table set);
// (A) multiplication and (C) division stay case-side records.
relation annualized_inputs_case_3402h2(pay: WagePayment, period_wages: Money, n_periods: Decimal) kind empirical {
    label en unofficial "the payroll-period wages and the number of such periods in the year (case facts; section 3402(h)(2)(A))";
}
relation annualized_lookup_case_3402h2(pay: WagePayment, schedule: Text, status: Text, annualized: Decimal) kind empirical {
    label en unofficial "the (A) amount with annual-table keys for the (B) lookup (case fact)";
}
relation annualized_tax_computed_case_3402h2(pay: WagePayment, tax: Decimal) kind empirical {
    label en unofficial "the (B) annual tax on the annualized amount, computed case-side from the table row (case fact; section 3402(h)(2)(C) input)";
}
pub relation annualized_method_available_3402h2(pay: WagePayment) kind institutional {
    label en official "withholding on the basis of annualized wages is available for this payment";
}
pub relation annualized_inputs_3402h2(pay: WagePayment, period_wages: Money, n_periods: Decimal) kind institutional {
    label en official "the (h)(2)(A) annualization inputs of record";
}
pub relation annualized_tax_from_table_3402h2(pay: WagePayment, base: Decimal, rate: Decimal, excess_over: Decimal) kind institutional {
    label en official "the (h)(2)(B) annual-table row for the annualized amount from Pub. 15-T section 1";
}
pub relation annualized_apportion_inputs_3402h2(pay: WagePayment, annual_tax: Decimal, n_periods: Decimal) kind institutional {
    label en official "the (h)(2)(C) apportionment inputs of record: annual tax over the year's periods";
}
@source(IRC_S3402_H, relation = formalizes, coverage = exact, quote = "An employer to determine the amount of tax to be deducted and withheld upon a payment of wages to an employee for a payroll period by—")
rule S3402h2AnnualizedMethodAvailable(pay: WagePayment) strict {
    when secretary_authorized_alternative_3402h(pay, "annualized");
    then annualized_method_available_3402h2(pay);
}
@source(IRC_S3402_H, relation = formalizes, coverage = exact, quote = "multiplying the amount of an employee's wages for a payroll period by the number of such payroll periods in the calendar year,")
rule S3402h2AnnualizeInputs(pay: WagePayment, period_wages: Money, n_periods: Decimal) strict {
    when annualized_method_available_3402h2(pay) and annualized_inputs_case_3402h2(pay, period_wages, n_periods);
    then annualized_inputs_3402h2(pay, period_wages, n_periods);
}
@source(IRC_S3402_H, relation = formalizes, coverage = exact, quote = "determining the amount of tax which would be required to be deducted and withheld upon the amount determined under subparagraph (A) if such amount constituted the actual wages for the calendar year and the payroll period of the employee were an annual payroll period, and")
rule S3402h2AnnualTableTax(pay: WagePayment, schedule: Text, status: Text, annualized: Decimal, base: Decimal, rate: Decimal, excess: Decimal) strict {
    when annualized_lookup_case_3402h2(pay, schedule, status, annualized)
        and us.irs.pub_15t_2026::annual_pct_bracket(schedule, status, annualized, base, rate, excess);
    then annualized_tax_from_table_3402h2(pay, base, rate, excess);
}
@source(IRC_S3402_H, relation = formalizes, coverage = exact, quote = "dividing the amount of tax determined under subparagraph (B) by the number of payroll periods (described in subparagraph (A)) in the calendar year.")
rule S3402h2ApportionInputs(pay: WagePayment, tax: Decimal, n_periods: Decimal) strict {
    when annualized_tax_computed_case_3402h2(pay, tax) and annualized_inputs_3402h2(pay, _, n_periods);
    then annualized_apportion_inputs_3402h2(pay, tax, n_periods);
}

// (h)(3): cumulative wages. Only (A) computes in-package (one snapshot
// addition — no ledger); (B) division and (D) excess stay case-side records;
// (C) reads the pinned manual schedules through two vintage legs; (E) is a
// classification off the (D) record.
relation cumulative_request_3402h3(employee: Person, employer: Person) kind empirical {
    label en unofficial "the employee requested cumulative-wages computation (case fact; section 3402(h)(3) chapeau)";
}
relation cumulative_current_and_ytd_3402h3(pay: WagePayment, current: Money, ytd: Money) kind empirical {
    label en unofficial "this period's wages and the calendar-year wages paid so far (case facts; section 3402(h)(3)(A))";
}
relation cumulative_periods_case_3402h3(pay: WagePayment, n_periods: Decimal) kind empirical {
    label en unofficial "the number of payroll periods the aggregate relates to (case fact; section 3402(h)(3)(B))";
}
relation cumulative_lookup_2020_3402h3(pay: WagePayment, period: Text, schedule: Text, status: Text, average: Decimal) kind empirical {
    label en unofficial "the (B) average with manual-2020 keys for the (C) lookup (case fact)";
}
relation cumulative_lookup_2019_3402h3(pay: WagePayment, period: Text, marital: Text, average: Decimal) kind empirical {
    label en unofficial "the (B) average with manual-2019 keys for the (C) lookup (case fact)";
}
relation cumulative_computed_and_withheld_3402h3(pay: WagePayment, computed: Money, withheld: Money) kind empirical {
    label en unofficial "the (C) total and the calendar-year tax withheld so far (case facts; section 3402(h)(3)(D))";
}
relation cumulative_excess_case_3402h3(pay: WagePayment, excess: Money) kind empirical {
    label en unofficial "the (D) excess to withhold on this payment (case fact; section 3402(h)(3)(E))";
}
pub relation cumulative_method_available_3402h3(pay: WagePayment) kind institutional {
    label en official "cumulative-wages computation is available for this payment";
}
pub relation cumulative_aggregate_wages_3402h3(pay: WagePayment, aggregate: Money) kind institutional {
    label en official "the (h)(3)(A) aggregate: this period's wages plus the year's wages so far";
}
pub relation cumulative_average_inputs_3402h3(pay: WagePayment, aggregate: Money, n_periods: Decimal) kind institutional {
    label en official "the (h)(3)(B) averaging inputs of record";
}
pub relation cumulative_tax_from_table_2020_3402h3(pay: WagePayment, base: Decimal, rate: Decimal, excess_over: Decimal) kind institutional {
    label en official "the (h)(3)(C) manual-2020 row for the average amount from Pub. 15-T section 4";
}
pub relation cumulative_tax_from_table_2019_3402h3(pay: WagePayment, base: Decimal, rate: Decimal, excess_over: Decimal) kind institutional {
    label en official "the (h)(3)(C) manual-2019 row for the average amount from Pub. 15-T section 5";
}
pub relation cumulative_excess_inputs_3402h3(pay: WagePayment, computed: Money, withheld: Money) kind institutional {
    label en official "the (h)(3)(D) excess inputs of record";
}
pub relation cumulative_excess_to_withhold_3402h3(pay: WagePayment, excess: Money) kind institutional {
    label en official "the (h)(3)(E) amount to deduct and withhold on this payment";
}
@source(IRC_S3402_H, relation = formalizes, coverage = exact, quote = "An employer, in the case of any employee who requests to have the amount of tax to be withheld from his wages computed on the basis of his cumulative wages, to—")
rule S3402h3CumulativeMethodAvailable(pay: WagePayment, employee: Person, employer: Person) strict {
    when cumulative_request_3402h3(employee, employer) and secretary_authorized_alternative_3402h(pay, "cumulative");
    then cumulative_method_available_3402h3(pay);
}
@source(IRC_S3402_H, relation = formalizes, coverage = exact, quote = "add the amount of the wages to be paid to the employee for the payroll period to the total amount of wages paid by the employer to the employee during the calendar year,")
rule S3402h3AddAggregateWages(pay: WagePayment, current: Money, ytd: Money) strict {
    when cumulative_method_available_3402h3(pay) and cumulative_current_and_ytd_3402h3(pay, current, ytd);
    then cumulative_aggregate_wages_3402h3(pay, current + ytd);
}
@source(IRC_S3402_H, relation = formalizes, coverage = exact, quote = "divide the aggregate amount of wages computed under subparagraph (A) by the number of payroll periods to which such aggregate amount of wages relates,")
rule S3402h3AverageInputs(pay: WagePayment, aggregate: Money, n_periods: Decimal) strict {
    when cumulative_aggregate_wages_3402h3(pay, aggregate) and cumulative_periods_case_3402h3(pay, n_periods);
    then cumulative_average_inputs_3402h3(pay, aggregate, n_periods);
}
@source(IRC_S3402_H, relation = formalizes, coverage = exact, quote = "compute the total amount of tax that would have been required to be deducted and withheld under subsection (a) if the average amount of wages (as computed under subparagraph (B)) had been paid to the employee for the number of payroll periods to which the aggregate amount of wages (computed under subparagraph (A)) relates,")
rule S3402h3TotalTaxManual2020(pay: WagePayment, period: Text, schedule: Text, status: Text, average: Decimal, base: Decimal, rate: Decimal, excess: Decimal) strict {
    when cumulative_lookup_2020_3402h3(pay, period, schedule, status, average)
        and us.irs.pub_15t_2026::manual_pct_2020_bracket(period, schedule, status, average, base, rate, excess);
    then cumulative_tax_from_table_2020_3402h3(pay, base, rate, excess);
}
@source(IRC_S3402_H, relation = formalizes, coverage = exact, quote = "compute the total amount of tax that would have been required to be deducted and withheld under subsection (a) if the average amount of wages (as computed under subparagraph (B)) had been paid to the employee for the number of payroll periods to which the aggregate amount of wages (computed under subparagraph (A)) relates,")
rule S3402h3TotalTaxManual2019(pay: WagePayment, period: Text, marital: Text, average: Decimal, base: Decimal, rate: Decimal, excess: Decimal) strict {
    when cumulative_lookup_2019_3402h3(pay, period, marital, average)
        and us.irs.pub_15t_2026::manual_pct_2019_bracket(period, marital, average, base, rate, excess);
    then cumulative_tax_from_table_2019_3402h3(pay, base, rate, excess);
}
@source(IRC_S3402_H, relation = formalizes, coverage = exact, quote = "determine the excess, if any, of the amount of tax computed under subparagraph (C) over the total amount of tax deducted and withheld by the employer from wages paid to the employee during the calendar year, and")
rule S3402h3ExcessInputs(pay: WagePayment, computed: Money, withheld: Money) strict {
    when cumulative_average_inputs_3402h3(pay, _, _) and cumulative_computed_and_withheld_3402h3(pay, computed, withheld);
    then cumulative_excess_inputs_3402h3(pay, computed, withheld);
}
@source(IRC_S3402_H, relation = formalizes, coverage = exact, quote = "deduct and withhold upon the payment of wages (referred to in subparagraph (A)) to the employee an amount equal to the excess (if any) computed under subparagraph (D).")
rule S3402h3WithholdExcess(pay: WagePayment, excess: Money) strict {
    when cumulative_excess_inputs_3402h3(pay, _, _) and cumulative_excess_case_3402h3(pay, excess);
    then cumulative_excess_to_withhold_3402h3(pay, excess);
}

// (h)(4): other methods. Equivalence is found case-side (the «substantially
// the same amount» comparison against subsection (a)/(c) is a computation,
// not a derivation); the rule records availability. The tolerance leg reads
// the pinned §6 table ((h)(4)-1(a)).
relation other_method_case_3402h4(pay: WagePayment) kind empirical {
    label en unofficial "the employer uses another computation method for this payment (case fact; section 3402(h)(4))";
}
relation other_method_matches_pct_3402h4(pay: WagePayment) kind empirical {
    label en unofficial "the other method withholds substantially the same amount as subsection (a)/(c) (case finding; section 3402(h)(4))";
}
relation tolerance_lookup_case_3402h4(pay: WagePayment, required_tax: Decimal) kind empirical {
    label en unofficial "the annual tax required under the percentage method, in dollars, for the tolerance lookup (case fact; section 3402(h)(4)-1(a))";
}
pub relation other_method_available_3402h4(pay: WagePayment) kind institutional {
    label en official "the other method is available for this payment";
}
pub relation other_method_tolerance_3402h4(pay: WagePayment, base: Decimal, rate: Decimal, cap_over: Decimal) kind institutional {
    label en official "the (h)(4)-1(a) tolerance row for this payment from Pub. 15-T section 6";
}
@source(IRC_S3402_H, relation = formalizes, coverage = exact, quote = "An employer to determine the amount of tax to be deducted and withheld upon the wages paid to an employee by any other method which will require the employer to deduct and withhold upon such wages substantially the same amount as would be required to be deducted and withheld by applying subsection (a) or (c), either with respect to a payroll period or with respect to the entire taxable year.")
rule S3402h4OtherMethodSubstantiallySame(pay: WagePayment) strict {
    when secretary_authorized_alternative_3402h(pay, "other") and other_method_case_3402h4(pay) and other_method_matches_pct_3402h4(pay);
    then other_method_available_3402h4(pay);
}
@source(IRC_S3402_H, relation = formalizes, coverage = partial, quote = "An employer to determine the amount of tax to be deducted and withheld upon the wages paid to an employee by any other method")
rule S3402h4ToleranceFromTable(pay: WagePayment, required_tax: Decimal, base: Decimal, rate: Decimal, cap_over: Decimal) strict {
    when other_method_available_3402h4(pay) and tolerance_lookup_case_3402h4(pay, required_tax)
        and us.irs.pub_15t_2026::other_method_tolerance(required_tax, base, rate, cap_over);
    then other_method_tolerance_3402h4(pay, base, rate, cap_over);
}

// --- §3402(m): additional withholding allowance --------------------------------
// Chapter-1 items (itemized/199A, credits, aged/blind + Secretary items per
// §31.3402(m)-1(b)–(d)) enter as case facts — this package does not own
// chapter-1 computations (coverage note; G4 pattern).
relation additional_allowance_certificate_3402m(employee: Person, employer: Person) kind empirical {
    label en unofficial "the employee's certificate claiming additional allowance under subsection (m) (case fact)";
}
relation estimated_itemized_deductions_3402m(employee: Person, amount: Money) kind empirical {
    label en unofficial "estimated itemized deductions and section 199A deduction (case fact; section 3402(m)(1))";
}
relation estimated_credits_3402m(employee: Person, amount: Money) kind empirical {
    label en unofficial "estimated chapter-1 tax credits (case fact; section 3402(m)(2))";
}
relation estimated_aged_blind_deductions_3402m(employee: Person, amount: Money) kind empirical {
    label en unofficial "additional standard deduction for the aged/blind and Secretary-specified items (case fact; section 3402(m)(3))";
}
pub relation entitled_to_additional_allowance_3402m(employee: Person) kind institutional {
    label en official "the employee is entitled to additional withholding allowance or reductions under subsection (m)";
}
pub relation additional_basis_itemized_199a_3402m(employee: Person, amount: Money) kind institutional {
    label en official "the (m)(1) itemized/199A basis of record for additional withholding";
}
pub relation additional_basis_credits_3402m(employee: Person, amount: Money) kind institutional {
    label en official "the (m)(2) credits basis of record for additional withholding";
}
pub relation additional_basis_aged_blind_3402m(employee: Person, amount: Money) kind institutional {
    label en official "the (m)(3) aged/blind/Secretary-items basis of record for additional withholding";
}
@source(IRC_S3402_M, relation = formalizes, coverage = exact, quote = "Under regulations prescribed by the Secretary, an employee shall be entitled to an additional withholding allowance or additional reductions in withholding under this subsection.")
rule S3402mAdditionalAllowanceEntitled(employee: Person, employer: Person) strict {
    when additional_allowance_certificate_3402m(employee, employer);
    then entitled_to_additional_allowance_3402m(employee);
}
@source(IRC_S3402_M, relation = formalizes, coverage = exact, quote = "estimated itemized deductions allowable under chapter 1 and the estimated deduction allowed under section 199A (other than the deductions referred to in section 151 and other than the deductions required to be taken into account in determining adjusted gross income under section 62(a)),")
rule S3402mItemizedAnd199A(employee: Person, amount: Money) strict {
    when entitled_to_additional_allowance_3402m(employee) and estimated_itemized_deductions_3402m(employee, amount);
    then additional_basis_itemized_199a_3402m(employee, amount);
}
@source(IRC_S3402_M, relation = formalizes, coverage = exact, quote = "estimated tax credits allowable under chapter 1, and")
rule S3402mCredits(employee: Person, amount: Money) strict {
    when entitled_to_additional_allowance_3402m(employee) and estimated_credits_3402m(employee, amount);
    then additional_basis_credits_3402m(employee, amount);
}
@source(IRC_S3402_M, relation = formalizes, coverage = exact, quote = "such additional deductions (including the additional standard deduction under section 63(c)(3) for the aged and blind) and other items as may be specified by the Secretary in regulations.")
rule S3402mAgedBlindAndSecretaryItems(employee: Person, amount: Money) strict {
    when entitled_to_additional_allowance_3402m(employee) and estimated_aged_blind_deductions_3402m(employee, amount);
    then additional_basis_aged_blind_3402m(employee, amount);
}

// --- §3402(t): qualified-stock floor ------------------------------------------
// No regulation exists for (t) (confirmed on the eCFR slice); the rate floor
// reads the existing income_individual dependency — no new carrier.
relation qualified_stock_83i_election_3402t(pay: WagePayment) kind empirical {
    label en unofficial "qualified stock (section 83(i)(2)) with a section 83(i) election, paid as wages (case fact; section 3402(t) chapeau)";
}
pub relation qualified_stock_withholding_3402t(pay: WagePayment) kind institutional {
    label en official "subsection (t) governs the withholding rate for this qualified-stock payment";
}
pub relation qualified_stock_rate_floor_3402t(pay: WagePayment, rate: Decimal) kind institutional {
    label en official "the (t)(1) floor: the subsection (a) rate is not less than the maximum section 1 rate";
}
pub relation qualified_stock_fringe_treatment_3402t(pay: WagePayment) kind institutional {
    label en official "the (t)(2) treatment: as a non-cash fringe benefit for section 3501(b)";
}
@source(IRC_S3402_T, relation = formalizes, coverage = exact, quote = "In the case of any qualified stock (as defined in section 83(i)(2)) with respect to which an election is made under section 83(i)—")
rule S3402tQualifiedStockWithholding(pay: WagePayment) strict {
    when qualified_stock_83i_election_3402t(pay);
    then qualified_stock_withholding_3402t(pay);
}
@source(IRC_S3402_T, relation = formalizes, coverage = exact, quote = "the rate of tax under subsection (a) shall not be less than the maximum rate of tax in effect under section 1, and")
rule S3402tRateFloorFromSection1(pay: WagePayment, employer: Person, employee: Person, year: TaxableYear, amount: Money, on: Date, rate: Decimal) strict {
    when wage_payment(pay, employer, employee, year, amount, on) and qualified_stock_withholding_3402t(pay)
        and us.irc.income_individual::highest_rate_under_section_1(year, rate);
    then qualified_stock_rate_floor_3402t(pay, rate);
}
@source(IRC_S3402_T, relation = formalizes, coverage = exact, quote = "such stock shall be treated for purposes of section 3501(b) in the same manner as a non-cash fringe benefit.")
rule S3402tFringeBenefitTreatment(pay: WagePayment) strict {
    when qualified_stock_withholding_3402t(pay);
    then qualified_stock_fringe_treatment_3402t(pay);
}
