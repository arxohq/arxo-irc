// Pub. L. 119-21 §70605(b)(4) — COVID-ERTC promoters: taxable years of less than 12 months.
// Stage 3 (26.09.2026, TECH_GAP reduction, DECISION-0379; closes G3741). Status:
// implemented_unverified — scenarios are written, not executed.
//
// "In the case of any taxable year of less than 12 months, a person shall be treated as a
// COVID-ERTC promoter if such person is described in paragraph (1) either with respect to such
// taxable year or by treating any reference to such taxable year as a reference to the calendar
// year in which such taxable year begins."
//
// Method: the receipts tests of 12-inventory-remainder-and-pl119-21.law
// (`ertc_promoter_test_met_for_year`) are read a second time over the calendar-year taxable
// year that contains the first day of the short year. The two computations cannot share one head
// (a predicate may not consume and produce itself), so the second result has its own relation,
// `ertc_promoter_test_met_for_short_year`. The case supplies the receipts facts of the calendar
// year as it would for any other taxable year (`ertc_aid_receipts`, `total_gross_receipts`).

use self::{
    ErtcDocument,
    Person,
    TaxableYear,
    certified_professional_employer_organization,
    covid_ertc_promoter,
    ertc_aid_in_taxable_year,
    ertc_promoter_test_met_for_year,
    preceding_taxable_year,
};

pub relation short_year_read_as_calendar_year(y: TaxableYear, cy: TaxableYear) kind institutional {
    label en official "the calendar year in which the short taxable year begins";
}
@source(us.irc.temporal::PL119_21_S70605, relation = derives_from, quote = "by treating any reference to such taxable year as a reference to the calendar year in which such taxable year begins")
rule S70605b4CalendarYearOfTheShortYear defeasible {
    label en official "a calendar year that contains the first day of the short year";
    for y: TaxableYear;
    for cy: TaxableYear;
    for n: Integer;
    for shortBegins: Date;
    for calendarBegins: Date;
    for calendarEnds: Date;
    when us.irc.core::short_year(y)
        and us.irc.core::begins(y, shortBegins)
        and us.irc.core::calendar_year_of(cy, n)
        and us.irc.core::begins(cy, calendarBegins)
        and us.irc.core::ends(cy, calendarEnds)
        and calendarBegins <= shortBegins
        and shortBegins <= calendarEnds;
    then short_year_read_as_calendar_year(y, cy);
}
pub relation ertc_promoter_test_met_for_short_year(person: Person, y: TaxableYear) kind institutional {
    label en official "the person meets a receipts test of paragraph (1) for the calendar year in which the short year begins";
}
rule S70605b4TestOverTheCalendarYear defeasible {
    label en official "the receipts tests read over the calendar year";
    for person: Person;
    for y: TaxableYear;
    for cy: TaxableYear;
    when short_year_read_as_calendar_year(y, cy)
        and ertc_promoter_test_met_for_year(person, cy);
    then ertc_promoter_test_met_for_short_year(person, y);
}
@source(us.irc.temporal::PL119_21_S70605, relation = derives_from, quote = "In the case of any taxable year of less than 12 months, a person shall be treated as a COVID–ERTC promoter if such person is described in paragraph (1) either with respect to such taxable year or by treating any reference to such taxable year as a reference to the calendar year in which such taxable year begins.")
rule S70605b4PromoterByShortYearOfAid defeasible {
    label en official "the aid falls in a short year whose calendar-year reading meets a test";
    for person: Person;
    for doc: ErtcDocument;
    for y: TaxableYear;
    when ertc_aid_in_taxable_year(person, doc, y)
        and us.irc.core::short_year(y)
        and ertc_promoter_test_met_for_short_year(person, y);
    then covid_ertc_promoter(person, doc);
    unless certified_professional_employer_organization(person) and ertc_aid_in_taxable_year(person, doc, y) and us.irc.core::short_year(y) and ertc_promoter_test_met_for_short_year(person, y);
}
@source(us.irc.temporal::PL119_21_S70605, relation = derives_from, quote = "with respect to such person’s taxable year in which such person provided such assistance or the preceding taxable year")
rule S70605b4PromoterByShortPrecedingYear defeasible {
    label en official "the preceding taxable year is a short year whose calendar-year reading meets a test";
    for person: Person;
    for doc: ErtcDocument;
    for y: TaxableYear;
    for prior: TaxableYear;
    when ertc_aid_in_taxable_year(person, doc, y)
        and preceding_taxable_year(y, prior)
        and us.irc.core::short_year(prior)
        and ertc_promoter_test_met_for_short_year(person, prior);
    then covid_ertc_promoter(person, doc);
    unless certified_professional_employer_organization(person) and ertc_aid_in_taxable_year(person, doc, y) and preceding_taxable_year(y, prior) and us.irc.core::short_year(prior) and ertc_promoter_test_met_for_short_year(person, prior);
}
