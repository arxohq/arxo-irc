// 26 U.S.C. §§3112, 3121(g), 3212, 3232 and the Pub. L. 119-21 amendments that
// touch Subtitle C sections owned by `us.irc.employment` (§§3134 note, 3304
// note, 3402 note, 3406(b)(6),(8)). Stage 3 (26.09.2026, DECISION-0379).
// Status: implemented_unverified.
//
// SCOPE.
//  - §3112: instrumentalities of the United States are not exempt from the
//    §3111 tax unless a specific exemption refers to §3111.
//  - §3121(g): the definition of "agricultural labor" as five inclusion cases,
//    the (4)(C) exclusion, the cooperative test for a group of farm operators
//    and the meaning of "farm". Facts about the service are case facts
//    (`ServicePerformed` flags); the classification and its exceptions are
//    executable. "Includes" is read as a sufficient list: a service outside the
//    five cases is simply not derived here (no negative conclusion).
//  - §3212 (RRTA): an employee representative's compensation is determined as if
//    the employee organization were a §3231(a) employer; §3232: the district
//    courts' jurisdiction over an application of the Attorney General.
//  - Pub. L. 119-21: §§70201(i), 70202(f) (withholding procedures, §3402(a)),
//    §70432(b) and §70433(d) (§3406(b)(8) and (b)(6): reportable payments),
//    §70605 (COVID-ERTC promoters: penalty, limitation on credits, the extended
//    assessment period of §3134(l)) and §73001 (no Federal unemployment
//    compensation for base-period wages of $1,000,000 or more).
//    The amendments are carried as rules on the payment date / notice date /
//    taxable year facts, not as edition switches.
//
// Approval date of Pub. L. 119-21: 2025-07-04 (TEMPORAL.json `enactment_date`).

language "law.core" version "0.2";
package us.irc.employment version "0.1.1";
namespace "urn:us:irc:employment:clir";

use self::{
    IRC_S3112,
    IRC_S3121_G,
    IRC_S3212,
    IRC_S3232,
    IRC_S3406_B,
    Organ,
    Person,
    Secretary,
    TaxableYear,
    rrta_employee_representative,
};

// ============================================================================
// §3112 — Instrumentalities of the United States
// ============================================================================

pub relation instrumentality_of_the_united_states(p: Person) kind empirical {
    label en official "the person is an instrumentality of the United States";
}
pub relation other_law_grants_instrumentality_exemption_from_taxation(p: Person) kind empirical {
    label en official "another provision of law (enacted before or after this section) grants the instrumentality an exemption from taxation";
}
pub relation specific_exemption_by_reference_to_section_3111(p: Person) kind empirical {
    label en official "the other provision of law grants a specific exemption, by reference to section 3111 (or the corresponding section of prior law), from the tax imposed by that section";
}
pub relation instrumentality_not_exempt_from_section_3111_tax(p: Person) kind institutional {
    label en official "the instrumentality is not exempt from the tax imposed by section 3111";
}
@source(IRC_S3112, relation = formalizes, coverage = exact, quote = "such instrumentality shall not be exempt from the tax imposed by section 3111")
rule S3112InstrumentalityNotExemptFromSection3111Tax defeasible {
    label en official "notwithstanding another law's exemption, an instrumentality of the United States is not exempt from the section 3111 tax unless that law specifically refers to section 3111";
    for p: Person;
    when instrumentality_of_the_united_states(p)
        and other_law_grants_instrumentality_exemption_from_taxation(p);
    then instrumentality_not_exempt_from_section_3111_tax(p);
    unless specific_exemption_by_reference_to_section_3111(p) and instrumentality_of_the_united_states(p) and other_law_grants_instrumentality_exemption_from_taxation(p);
}

// ============================================================================
// §3121(g) — Agricultural labor
// ============================================================================

pub entity ServicePerformed {
    label en unofficial "a service performed by an individual, classified for the definition of agricultural labor";
}
pub enum FarmKind {
    StockFarm; DairyFarm; PoultryFarm; FruitFarm; FurBearingAnimalFarm; TruckFarm;
    Plantation; Ranch; Nursery; Range; GreenhouseOrSimilarStructure; Orchard;
    label en unofficial "the kinds of place the last sentence of section 3121(g) includes in the term farm (greenhouses and similar structures count when used primarily for raising agricultural or horticultural commodities)";
}
pub relation place_of_kind(f: Person, kind: FarmKind) kind empirical {
    label en official "the place is of the given kind";
}
pub relation farm(f: Person) kind institutional {
    label en official "the term farm includes stock, dairy, poultry, fruit, fur-bearing animal, and truck farms, plantations, ranches, nurseries, ranges, greenhouses or other similar structures used primarily for the raising of agricultural or horticultural commodities, and orchards";
}
@source(IRC_S3121_G, relation = formalizes, coverage = exact, quote = "As used in this subsection, the term \"farm\" includes stock, dairy, poultry, fruit, fur-bearing animal, and truck farms, plantations, ranches, nurseries, ranges, greenhouses or other similar structures used primarily for the raising of agricultural or horticultural commodities, and orchards.")
rule S3121gFarmIncludesTheListedKinds defeasible {
    label en official "a place of one of the listed kinds is a farm";
    for f: Person;
    for kind: FarmKind;
    when place_of_kind(f, kind);
    then farm(f);
}
pub relation service_performed_on_farm(s: ServicePerformed, f: Person) kind empirical {
    label en official "the service is performed on the farm";
}
pub relation service_in_employ_of_person(s: ServicePerformed, employer: Person) kind empirical {
    label en official "the service is performed in the employ of the person";
}
pub relation cultivating_the_soil_or_raising_or_harvesting_commodity(s: ServicePerformed) kind empirical {
    label en official "the service is in connection with cultivating the soil, or with raising or harvesting any agricultural or horticultural commodity, including the raising, shearing, feeding, caring for, training, and management of livestock, bees, poultry, fur-bearing animals and wildlife";
}
pub relation agricultural_labor(s: ServicePerformed) kind institutional {
    label en official "agricultural labor within the meaning of section 3121(g)";
}
@source(IRC_S3121_G, relation = formalizes, coverage = exact, quote = "(1) on a farm, in the employ of any person, in connection with cultivating the soil, or in connection with raising or harvesting any agricultural or horticultural commodity")
rule S3121g1ServiceOnFarmCultivatingOrRaising defeasible {
    label en official "service on a farm in connection with cultivating the soil or raising or harvesting a commodity is agricultural labor";
    for s: ServicePerformed;
    for f: Person;
    for employer: Person;
    when service_performed_on_farm(s, f)
        and farm(f)
        and service_in_employ_of_person(s, employer)
        and cultivating_the_soil_or_raising_or_harvesting_commodity(s);
    then agricultural_labor(s);
}
pub relation employer_is_owner_tenant_or_operator_of_farm(employer: Person) kind empirical {
    label en official "the employer is the owner or tenant or other operator of a farm";
}
pub relation service_in_operation_management_conservation_improvement_or_maintenance(s: ServicePerformed) kind empirical {
    label en official "the service is in connection with the operation, management, conservation, improvement, or maintenance of the farm and its tools and equipment";
}
pub relation service_salvaging_timber_or_clearing_hurricane_debris(s: ServicePerformed) kind empirical {
    label en official "the service is in salvaging timber or clearing land of brush and other debris left by a hurricane";
}
pub relation major_part_of_service_performed_on_farm(s: ServicePerformed) kind empirical {
    label en official "the major part of the service is performed on a farm";
}
@source(IRC_S3121_G, relation = formalizes, coverage = exact, quote = "(2) in the employ of the owner or tenant or other operator of a farm, in connection with the operation, management, conservation, improvement, or maintenance of such farm and its tools and equipment")
rule S3121g2ServiceForFarmOperatorInOperationAndMaintenance defeasible {
    label en official "service for the owner, tenant or operator of a farm in connection with the operation, management, conservation, improvement or maintenance of the farm is agricultural labor";
    for s: ServicePerformed;
    for employer: Person;
    when service_in_employ_of_person(s, employer)
        and employer_is_owner_tenant_or_operator_of_farm(employer)
        and service_in_operation_management_conservation_improvement_or_maintenance(s);
    then agricultural_labor(s);
}
@source(IRC_S3121_G, relation = formalizes, coverage = exact, quote = "or in salvaging timber or clearing land of brush and other debris left by a hurricane, if the major part of such service is performed on a farm")
rule S3121g2ServiceSalvagingHurricaneDebris defeasible {
    label en official "service in salvaging timber or clearing hurricane debris for a farm operator is agricultural labor if the major part is performed on a farm";
    for s: ServicePerformed;
    for employer: Person;
    when service_in_employ_of_person(s, employer)
        and employer_is_owner_tenant_or_operator_of_farm(employer)
        and service_salvaging_timber_or_clearing_hurricane_debris(s)
        and major_part_of_service_performed_on_farm(s);
    then agricultural_labor(s);
}
pub relation service_in_production_or_harvesting_of_agricultural_commodity_15g(s: ServicePerformed) kind empirical {
    label en official "the service is in connection with the production or harvesting of a commodity defined as an agricultural commodity in section 15(g) of the Agricultural Marketing Act (12 U.S.C. 1141j)";
}
pub relation service_in_ginning_of_cotton(s: ServicePerformed) kind empirical {
    label en official "the service is in connection with the ginning of cotton";
}
pub relation service_on_nonprofit_water_facility_for_farming(s: ServicePerformed) kind empirical {
    label en official "the service is in connection with the operation or maintenance of ditches, canals, reservoirs, or waterways, not owned or operated for profit, used exclusively for supplying and storing water for farming purposes";
}
@source(IRC_S3121_G, relation = formalizes, coverage = exact, quote = "(3) in connection with the production or harvesting of any commodity defined as an agricultural commodity in section 15(g) of the Agricultural Marketing Act")
rule S3121g3ProductionOrHarvestingOfAgriculturalCommodity defeasible {
    label en official "service in connection with the production or harvesting of a section 15(g) agricultural commodity is agricultural labor";
    for s: ServicePerformed;
    when service_in_production_or_harvesting_of_agricultural_commodity_15g(s);
    then agricultural_labor(s);
}
@source(IRC_S3121_G, relation = formalizes, coverage = exact, quote = "or in connection with the ginning of cotton")
rule S3121g3GinningOfCotton defeasible {
    label en official "service in connection with the ginning of cotton is agricultural labor";
    for s: ServicePerformed;
    when service_in_ginning_of_cotton(s);
    then agricultural_labor(s);
}
@source(IRC_S3121_G, relation = formalizes, coverage = exact, quote = "or in connection with the operation or maintenance of ditches, canals, reservoirs, or waterways, not owned or operated for profit, used exclusively for supplying and storing water for farming purposes")
rule S3121g3NonprofitFarmWaterFacilities defeasible {
    label en official "service on nonprofit ditches, canals, reservoirs or waterways used exclusively for farm water is agricultural labor";
    for s: ServicePerformed;
    when service_on_nonprofit_water_facility_for_farming(s);
    then agricultural_labor(s);
}
pub relation service_handling_commodity_in_unmanufactured_state(s: ServicePerformed) kind empirical {
    label en official "the service is in handling, planting, drying, packing, packaging, processing, freezing, grading, storing, or delivering to storage or to market or to a carrier for transportation to market, in its unmanufactured state, an agricultural or horticultural commodity";
}
pub relation operator_produced_more_than_half_of_commodity(employer: Person, s: ServicePerformed) kind empirical {
    label en official "the operator produced more than one-half of the commodity with respect to which the service is performed";
}
pub relation service_after_terminal_market_delivery_or_commercial_canning_or_freezing(s: ServicePerformed) kind empirical {
    label en official "the service is in connection with commercial canning or commercial freezing, or with an agricultural or horticultural commodity after its delivery to a terminal market for distribution for consumption";
}
@source(IRC_S3121_G, relation = formalizes, coverage = exact, quote = "(4)(A) in the employ of the operator of a farm in handling, planting, drying, packing, packaging, processing, freezing, grading, storing, or delivering to storage or to market or to a carrier for transportation to market, in its unmanufactured state, any agricultural or horticultural commodity; but only if such operator produced more than one-half of the commodity with respect to which such service is performed")
rule S3121g4AServiceForOperatorHandlingHisCommodity defeasible {
    label en official "service for a farm operator handling, packing, processing etc. in its unmanufactured state a commodity of which the operator produced more than half is agricultural labor";
    for s: ServicePerformed;
    for employer: Person;
    when service_in_employ_of_person(s, employer)
        and employer_is_owner_tenant_or_operator_of_farm(employer)
        and service_handling_commodity_in_unmanufactured_state(s)
        and operator_produced_more_than_half_of_commodity(employer, s);
    then agricultural_labor(s);
    unless service_after_terminal_market_delivery_or_commercial_canning_or_freezing(s) and service_in_employ_of_person(s, employer) and employer_is_owner_tenant_or_operator_of_farm(employer) and service_handling_commodity_in_unmanufactured_state(s) and operator_produced_more_than_half_of_commodity(employer, s);
}
pub relation farm_operator_group_member_count(group: Person, count: Integer) kind empirical {
    label en official "the number of operators comprising the unincorporated group at any time during the calendar year in which the service is performed (the maximum)";
}
pub relation group_is_unincorporated(group: Person) kind empirical {
    label en official "the group of farm operators is unincorporated";
}
pub relation group_is_cooperative_organization(group: Person) kind institutional {
    label en official "the group is (or is deemed to be) a cooperative organization";
}
pub relation group_declared_cooperative_organization(group: Person) kind empirical {
    label en official "the group is a cooperative organization on its own terms";
}
@source(IRC_S3121_G, relation = formalizes, coverage = exact, quote = "any unincorporated group of operators shall be deemed a cooperative organization if the number of operators comprising such group is more than 20 at any time during the calendar year in which such service is performed")
rule S3121g4BGroupOverTwentyOperatorsIsCooperative defeasible {
    label en official "an unincorporated group of more than 20 operators is deemed a cooperative organization";
    for group: Person;
    for count: Integer;
    when group_is_unincorporated(group)
        and farm_operator_group_member_count(group, count)
        and count > 20;
    then group_is_cooperative_organization(group);
}
rule S3121g4BDeclaredCooperativeIsCooperative defeasible {
    label en official "a group that is a cooperative organization on its own terms is a cooperative organization";
    for group: Person;
    when group_declared_cooperative_organization(group);
    then group_is_cooperative_organization(group);
}
pub relation operators_produced_all_of_commodity(group: Person, s: ServicePerformed) kind empirical {
    label en official "the operators of the group produced all of the commodity with respect to which the service is performed";
}
@source(IRC_S3121_G, relation = formalizes, coverage = exact, quote = "(B) in the employ of a group of operators of farms (other than a cooperative organization) in the performance of service described in subparagraph (A), but only if such operators produced all of the commodity with respect to which such service is performed")
rule S3121g4BServiceForGroupOfOperators defeasible {
    label en official "service for a group of farm operators (not a cooperative) handling a commodity they produced entirely is agricultural labor";
    for s: ServicePerformed;
    for group: Person;
    when service_in_employ_of_person(s, group)
        and service_handling_commodity_in_unmanufactured_state(s)
        and operators_produced_all_of_commodity(group, s)
        and not_known(group_is_cooperative_organization(group));
    then agricultural_labor(s);
    unless service_after_terminal_market_delivery_or_commercial_canning_or_freezing(s) and service_in_employ_of_person(s, group) and service_handling_commodity_in_unmanufactured_state(s) and operators_produced_all_of_commodity(group, s);
}
pub relation service_on_farm_operated_for_profit(s: ServicePerformed) kind empirical {
    label en official "the service is performed on a farm operated for profit";
}
pub relation service_in_course_of_employer_trade_or_business(s: ServicePerformed) kind empirical {
    label en official "the service is in the course of the employer's trade or business";
}
@source(IRC_S3121_G, relation = formalizes, coverage = exact, quote = "(5) on a farm operated for profit if such service is not in the course of the employer's trade or business.")
rule S3121g5ServiceOnFarmOperatedForProfitOutsideTradeOrBusiness defeasible {
    label en official "service on a farm operated for profit that is not in the course of the employer's trade or business is agricultural labor";
    for s: ServicePerformed;
    when service_on_farm_operated_for_profit(s)
        and not_known(service_in_course_of_employer_trade_or_business(s));
    then agricultural_labor(s);
}

// ============================================================================
// §3212, §3232 — RRTA
// ============================================================================

pub relation representative_compensation_determined_as_if_organization_were_employer(rep: Person, org: Person) kind institutional {
    label en official "the compensation of the employee representative is determined, for the purpose of ascertaining the tax thereon, in the same manner and with the same effect as if the employee organization were an employer as defined in section 3231(a)";
}
@source(IRC_S3212, relation = formalizes, coverage = exact, quote = "in the same manner and with the same effect as if the employee organization by which such employee representative is employed were an employer as defined in section 3231(a)")
rule S3212RepresentativeCompensationAsIfOrganizationWereEmployer defeasible {
    label en official "an employee representative's compensation is determined as if his organization were a section 3231(a) employer";
    for rep: Person;
    for org: Person;
    when rrta_employee_representative(rep, org);
    then representative_compensation_determined_as_if_organization_were_employer(rep, org);
}
pub relation attorney_general_applies_on_behalf_of_secretary(court: Organ, person: Person) kind empirical {
    label en official "the Attorney General, on behalf of the Secretary, applies to the district court to compel compliance with obligations under chapter 22";
}
pub relation person_resides_or_is_subject_to_service_within_jurisdiction(court: Organ, person: Person) kind empirical {
    label en official "the employee or other person resides within the jurisdiction of the court, or the employer is subject to service of process within it";
}
pub relation court_compels_compliance_with_chapter_22(court: Organ, person: Person, on: Date) kind empirical {
    label en official "the district court compels the person to comply with obligations imposed under chapter 22";
}
pub relation chapter_22_application_within_jurisdiction(court: Organ, person: Person) kind institutional {
    label en unofficial "single-atom valid_when helper: the application of the Attorney General is within the court's territorial jurisdiction";
}
rule S3232ApplicationWithinJurisdiction defeasible {
    label en official "the application is by the Attorney General on behalf of the Secretary and the person resides or is subject to service within the district";
    for court: Organ;
    for person: Person;
    when attorney_general_applies_on_behalf_of_secretary(court, person)
        and person_resides_or_is_subject_to_service_within_jurisdiction(court, person);
    then chapter_22_application_within_jurisdiction(court, person);
}
pub relation chapter_22_compliance_compelled(court: Organ, person: Person) kind institutional {
    label en official "the person is compelled to comply with the obligations imposed under chapter 22";
}
@source(IRC_S3232, relation = formalizes, coverage = exact, quote = "The several district courts of the United States shall have jurisdiction to entertain an application by the Attorney General on behalf of the Secretary to compel an employee or other person residing within the jurisdiction of the court or an employer subject to service of process within its jurisdiction")
pub rule S3232CompelCompliance defeasible {
    label en official "a district court may, on the Attorney General's application on behalf of the Secretary, compel an employee, employer or other person within its jurisdiction to comply with chapter 22";
    for court: Organ;
    for person: Person;
    for on: Date;
    when court_compels_compliance_with_chapter_22(court, person, on);
    then power S3232CompelComplianceCourtPower {
        holder court;
        over person;
        exercise court_compels_compliance_with_chapter_22(court, person, on);
        valid_when chapter_22_application_within_jurisdiction(court, person);
        effect create(chapter_22_compliance_compelled(court, person));
    };
}
pub relation civil_action_in_aid_of_enforcement_of_chapter_22(court: Organ) kind empirical {
    label en official "a civil action, legal or equitable in nature, in aid of the enforcement of rights or obligations under chapter 22";
}
pub relation district_court_jurisdiction_over_civil_action_preserved(court: Organ) kind institutional {
    label en official "the jurisdiction conferred is not exclusive of any jurisdiction otherwise possessed by the court to entertain civil actions in aid of enforcement";
}
@source(IRC_S3232, relation = formalizes, coverage = exact, quote = "shall not be held exclusive of any jurisdiction otherwise possessed by such courts to entertain civil actions")
rule S3232JurisdictionNotExclusive defeasible {
    label en official "the special jurisdiction does not displace the courts' other jurisdiction over civil actions in aid of enforcement";
    for court: Organ;
    when civil_action_in_aid_of_enforcement_of_chapter_22(court);
    then district_court_jurisdiction_over_civil_action_preserved(court);
}

// ============================================================================
// Pub. L. 119-21 §§70201(i), 70202(f) — §3402(a) procedures
// ============================================================================

pub relation withholding_procedures_modified_for_tips_deduction(dummy: Person) kind empirical {
    label en official "the Secretary has modified the procedures prescribed under section 3402(a) to take into account the deduction allowed under section 224 (qualified tips), for taxable years beginning after December 31, 2025";
}
pub relation withholding_procedures_modified_for_overtime_deduction(dummy: Person) kind empirical {
    label en official "the Secretary has modified the procedures prescribed under section 3402(a) to take into account the deduction allowed under section 225 (qualified overtime compensation), for taxable years beginning after December 31, 2025";
}
pub relation employer_subject_to_section_3402_procedures(employer: Person) kind empirical {
    label en unofficial "an employer to whom the section 3402(a) withholding procedures apply (binds the Secretary's duty to a case: the duty is addressed to the Secretary alone)";
}
@source(us.irc.temporal::PL119_21_S70201, relation = derives_from, quote = "shall modify the procedures prescribed under section 3402(a) of the Internal Revenue Code of 1986 for taxable years beginning after December 31, 2025")
pub rule S70201iModifyWithholdingProceduresForTips defeasible {
    label en official "the Secretary shall modify the section 3402(a) withholding procedures for taxable years beginning after 2025 to take into account the section 224 deduction (read: by the first day of the first affected year — INTERPRETATION)";
    for employer: Person;
    when employer_subject_to_section_3402_procedures(employer);
    then duty S70201iWithholdingProceduresTipsDuty {
        bearer Secretary;
        goal achievement {
            condition withholding_procedures_modified_for_tips_deduction(employer);
            window [@2025-07-04, @2026-01-01];
        }
    };
}
@source(us.irc.temporal::PL119_21_S70202, relation = derives_from, quote = "shall modify the procedures prescribed under section 3402(a) of the Internal Revenue Code of 1986 for taxable years beginning after December 31, 2025")
pub rule S70202fModifyWithholdingProceduresForOvertime defeasible {
    label en official "the Secretary shall modify the section 3402(a) withholding procedures for taxable years beginning after 2025 to take into account the section 225 deduction (read: by the first day of the first affected year — INTERPRETATION)";
    for employer: Person;
    when employer_subject_to_section_3402_procedures(employer);
    then duty S70202fWithholdingProceduresOvertimeDuty {
        bearer Secretary;
        goal achievement {
            condition withholding_procedures_modified_for_overtime_deduction(employer);
            window [@2025-07-04, @2026-01-01];
        }
    };
}

// ============================================================================
// Pub. L. 119-21 §§70432(b), 70433(d) — §3406(b)(6), (b)(8)
// ============================================================================

pub relation aggregate_6041_payments_in_calendar_year(payor: Person, payee: Person, y: TaxableYear, aggregate: Money) kind empirical {
    label en official "the aggregate amount of the payment and all previous payments of a kind required to be shown on a return under section 6041(a) or 6041A(a) by the payor to the payee during the calendar year";
}
pub relation payor_required_to_file_6041_return_for_preceding_year(payor: Person, payee: Person, y: TaxableYear) kind empirical {
    label en official "the payor was required under section 6041(a) or 6041A(a) to file a return for the preceding calendar year with respect to payments to the payee";
}
pub relation payor_withheld_on_reportable_payments_in_preceding_year(payor: Person, payee: Person, y: TaxableYear) kind empirical {
    label en official "during the preceding calendar year, the payor made reportable payments to the payee with respect to which amounts were required to be deducted and withheld under subsection (a)";
}
pub relation section_6041_payment_reportable_for_backup_withholding(payor: Person, payee: Person, y: TaxableYear) kind institutional {
    label en official "a payment of a kind required to be shown on a return under section 6041(a) or 6041A(a) is treated as a reportable payment (section 3406(b)(6))";
}
@source(IRC_S3406_B, relation = formalizes, coverage = exact, quote = "equals or exceeds $600,")
rule S3406b6AAggregateReachesSixHundredBefore2026 defeasible {
    label en official "before the amendment (payments through 2025) the aggregate threshold is $600";
    effective (-infinity, @2026-01-01);
    for payor: Person;
    for payee: Person;
    for y: TaxableYear;
    for aggregate: Money;
    when aggregate_6041_payments_in_calendar_year(payor, payee, y, aggregate)
        and aggregate >= 600.00 USD;
    then section_6041_payment_reportable_for_backup_withholding(payor, payee, y);
}
@source(us.irc.temporal::PL119_21_S70433, relation = derives_from, quote = "by striking “$600” in subparagraph (A) and inserting “the dollar amount in effect for such calendar year under section 6041(a)”")
rule S3406b6AAggregateReachesTwoThousandFor2026 defeasible {
    label en official "payments made in calendar year 2026 (Pub. L. 119-21 §70433: section 6041(a) amount $2,000): the aggregate threshold is $2,000";
    effective [@2026-01-01, @2027-01-01);
    for payor: Person;
    for payee: Person;
    for y: TaxableYear;
    for aggregate: Money;
    when aggregate_6041_payments_in_calendar_year(payor, payee, y, aggregate)
        and aggregate >= 2000.00 USD;
    then section_6041_payment_reportable_for_backup_withholding(payor, payee, y);
}
// TECH_GAP G3740: for calendar years after 2026 the section 6041(a) amount is
// indexed (section 6041(h): the $2,000 increased by the section 1(f)(3) cost-of-living
// adjustment with calendar year 2025 as the base year, rounded to a multiple of $100);
// the published adjusted amounts are not pinned, so no rule is written for 2027 and later
// (MISSING_PARAMETER_VALUE, never zero).
@source(IRC_S3406_B, relation = formalizes, coverage = exact, quote = "the payor was required under section 6041(a) or 6041A(a) to file a return for the preceding calendar year with respect to payments to the payee, or")
rule S3406b6BPayorRequiredToFilePrecedingYear defeasible {
    label en official "a payment is reportable if the payor was required to file a section 6041(a)/6041A(a) return for the preceding calendar year for the payee";
    for payor: Person;
    for payee: Person;
    for y: TaxableYear;
    when payor_required_to_file_6041_return_for_preceding_year(payor, payee, y);
    then section_6041_payment_reportable_for_backup_withholding(payor, payee, y);
}
@source(IRC_S3406_B, relation = formalizes, coverage = exact, quote = "during the preceding calendar year, the payor made reportable payments to the payee with respect to which amounts were required to be deducted and withheld under subsection (a)")
rule S3406b6CBackupWithheldInPrecedingYear defeasible {
    label en official "a payment is reportable if in the preceding calendar year the payor made reportable payments to the payee subject to backup withholding";
    for payor: Person;
    for payee: Person;
    for y: TaxableYear;
    when payor_withheld_on_reportable_payments_in_preceding_year(payor, payee, y);
    then section_6041_payment_reportable_for_backup_withholding(payor, payee, y);
}
pub relation third_party_network_transaction_count(payor: Person, payee: Person, y: TaxableYear, count: Integer) kind empirical {
    label en official "the aggregate number of transactions with the participating payee during the calendar year";
}
pub relation third_party_network_transaction_amount(payor: Person, payee: Person, y: TaxableYear, aggregate: Money) kind empirical {
    label en official "the aggregate amount of transactions with the participating payee during the calendar year";
}
pub relation third_party_network_prior_year_payment_was_reportable(payor: Person, payee: Person, y: TaxableYear) kind empirical {
    label en official "one or more payments in settlement of third party network transactions made by the payor to the payee during the preceding calendar year were reportable payments";
}
pub relation third_party_network_payment_reportable(payor: Person, payee: Person, y: TaxableYear) kind institutional {
    label en official "a payment in settlement of a third party network transaction is treated as a reportable payment";
}
@source(us.irc.temporal::PL119_21_S70432, relation = derives_from, quote = "shall be treated as a reportable payment only if—“(i) the aggregate number of transactions with respect to the participating payee during such calendar year exceeds the number of transactions specified in section 6050W(e)(2)")
rule S3406b8AAggregateOverThresholdFrom2025 defeasible {
    label en official "for calendar years beginning after 2024 a third party network payment is reportable only if the number of transactions exceeds 200 and the aggregate amount exceeds $20,000 (section 6050W(e) as restored by Pub. L. 119-21 §70432(a))";
    effective [@2025-01-01, infinity);
    for payor: Person;
    for payee: Person;
    for y: TaxableYear;
    for count: Integer;
    for aggregate: Money;
    when third_party_network_transaction_count(payor, payee, y, count)
        and third_party_network_transaction_amount(payor, payee, y, aggregate)
        and count > 200
        and aggregate > 20000.00 USD;
    then third_party_network_payment_reportable(payor, payee, y);
}
@source(us.irc.temporal::PL119_21_S70432, relation = derives_from, quote = "Subparagraph (A) shall not apply with respect to payments to any participating payee during any calendar year if one or more payments in settlement of third party network transactions made by the payor to the participating payee during the preceding calendar year were reportable payments")
rule S3406b8BPriorYearReportableDisplacesThreshold defeasible {
    label en official "if a payment of the preceding calendar year was reportable, the threshold of (b)(8)(A) does not apply and the payment is reportable";
    effective [@2025-01-01, infinity);
    for payor: Person;
    for payee: Person;
    for y: TaxableYear;
    when third_party_network_prior_year_payment_was_reportable(payor, payee, y);
    then third_party_network_payment_reportable(payor, payee, y);
}
rule S3406b3FThirdPartyNetworkReportableBefore2025 defeasible {
    label en official "before the (b)(8) rule (calendar years through 2024) a third party network payment required to be shown on a return under section 6050W is reportable";
    effective (-infinity, @2025-01-01);
    for payor: Person;
    for payee: Person;
    for y: TaxableYear;
    for aggregate: Money;
    when third_party_network_transaction_amount(payor, payee, y, aggregate);
    then third_party_network_payment_reportable(payor, payee, y);
}

// ============================================================================
// Pub. L. 119-21 §70605 — COVID-ERTC promoters, limitation on credits, §3134(l)
// ============================================================================

pub entity ErtcDocument {
    label en unofficial "a COVID-ERTC document: any return, affidavit, claim or other document related to a credit or advance payment of a credit under section 3134";
}
pub relation ertc_aid_provided(person: Person, doc: ErtcDocument, providedOn: Date) kind empirical {
    label en official "the person provides aid, assistance, or advice with respect to the COVID-ERTC document";
}
pub relation ertc_document_is_return_or_claim(doc: ErtcDocument) kind empirical {
    label en official "the document constitutes, or relates to, a return or claim for refund";
}
pub relation ertc_fee_based_on_refund_or_credit_amount(person: Person, doc: ErtcDocument) kind empirical {
    label en official "the person charges or receives a fee for the aid, assistance or advice which is based on the amount of the refund or credit";
}
pub relation single_employer_group_member(person: Person, member: Person) kind empirical {
    label en official "the member is treated as one person with the person under section 52(a)/(b) or 414(m)/(o) (the case lists the person itself as its own member)";
}
pub relation ertc_aid_receipts(person: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the gross receipts of the person for aid, assistance and advice with respect to all COVID-ERTC documents in the taxable year";
}
pub relation total_gross_receipts(person: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the gross receipts of the person for the taxable year";
}
pub relation ertc_aggregated_receipts(person: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the COVID-ERTC receipts after applying the aggregation rule (all members treated as one person)";
}
pub relation total_aggregated_receipts(person: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the gross receipts after applying the aggregation rule";
}
rule S70605b3AggregatedErtcReceipts defeasible {
    label en official "all persons treated as a single employer are treated as one person: their receipts are added";
    for person: Person;
    for y: TaxableYear;
    for own: Money;
    when ertc_aid_receipts(person, y, own);
    then ertc_aggregated_receipts(person, y,
        sum all a: Money for m: Person where single_employer_group_member(person, m) and ertc_aid_receipts(m, y, a));
}
rule S70605b3AggregatedTotalReceipts defeasible {
    label en official "all persons treated as a single employer are treated as one person: their gross receipts are added";
    for person: Person;
    for y: TaxableYear;
    for own: Money;
    when total_gross_receipts(person, y, own);
    then total_aggregated_receipts(person, y,
        sum all a: Money for m: Person where single_employer_group_member(person, m) and total_gross_receipts(m, y, a));
}
pub relation ertc_promoter_test_met_for_year(person: Person, y: TaxableYear) kind institutional {
    label en official "the person meets one of the receipts tests of section 70605(b)(1) for the taxable year";
}
@source(us.irc.temporal::PL119_21_S70605, relation = derives_from, quote = "exceeds 20 percent of the gross receipts of such person for such taxable year, or")
rule S70605b1AFeeBasedAndOverTwentyPercent defeasible {
    label en official "(A): fee based on the amount of the refund or credit, and ERTC receipts exceed 20 percent of gross receipts";
    for person: Person;
    for y: TaxableYear;
    for doc: ErtcDocument;
    for providedOn: Date;
    for ertc: Money;
    for total: Money;
    when ertc_aid_provided(person, doc, providedOn)
        and ertc_fee_based_on_refund_or_credit_amount(person, doc)
        and ertc_aggregated_receipts(person, y, ertc)
        and total_aggregated_receipts(person, y, total)
        and ertc * 5 > total;
    then ertc_promoter_test_met_for_year(person, y);
}
@source(us.irc.temporal::PL119_21_S70605, relation = derives_from, quote = "exceeds 50 percent of the gross receipts of such person for such taxable year, or")
rule S70605b1BiOverFiftyPercent defeasible {
    label en official "(B)(i): ERTC receipts exceed 50 percent of gross receipts";
    for person: Person;
    for y: TaxableYear;
    for ertc: Money;
    for total: Money;
    when ertc_aggregated_receipts(person, y, ertc)
        and total_aggregated_receipts(person, y, total)
        and ertc * 2 > total;
    then ertc_promoter_test_met_for_year(person, y);
}
@source(us.irc.temporal::PL119_21_S70605, relation = derives_from, quote = "the aggregate of the gross receipts of such person for aid, assistance, and advice with respect to all COVID–ERTC documents (determined after application of paragraph (3)) exceeds $500,000")
rule S70605b1BiiOverTwentyPercentAndFiveHundredThousand defeasible {
    label en official "(B)(ii): ERTC receipts exceed 20 percent of gross receipts and exceed $500,000";
    for person: Person;
    for y: TaxableYear;
    for ertc: Money;
    for total: Money;
    when ertc_aggregated_receipts(person, y, ertc)
        and total_aggregated_receipts(person, y, total)
        and ertc * 5 > total
        and ertc > 500000.00 USD;
    then ertc_promoter_test_met_for_year(person, y);
}
pub relation ertc_aid_in_taxable_year(person: Person, doc: ErtcDocument, y: TaxableYear) kind institutional {
    label en unofficial "the aid was provided in the taxable year";
}
rule S70605b1AidInTaxableYear defeasible {
    label en unofficial "the taxable year that contains the date on which the aid was provided";
    for person: Person;
    for doc: ErtcDocument;
    for providedOn: Date;
    for y: TaxableYear;
    for beginsOn: Date;
    for endsOn: Date;
    when ertc_aid_provided(person, doc, providedOn)
        and us.irc.core::year_of(person, y)
        and us.irc.core::begins(y, beginsOn)
        and us.irc.core::ends(y, endsOn)
        and beginsOn <= providedOn
        and providedOn <= endsOn;
    then ertc_aid_in_taxable_year(person, doc, y);
}
pub relation preceding_taxable_year(y: TaxableYear, prior: TaxableYear) kind empirical {
    label en unofficial "the preceding taxable year of the person (a fact of the case: `us.irc.core` has no predecessor function)";
}
pub relation certified_professional_employer_organization(person: Person) kind empirical {
    label en official "the person is a certified professional employer organization (section 7705)";
}
pub relation covid_ertc_promoter(person: Person, doc: ErtcDocument) kind institutional {
    label en official "the person is a COVID-ERTC promoter with respect to the document";
}
@source(us.irc.temporal::PL119_21_S70605, relation = derives_from, quote = "with respect to such person’s taxable year in which such person provided such assistance or the preceding taxable year")
rule S70605b1PromoterByYearOfAid defeasible {
    label en official "the person is a COVID-ERTC promoter if a receipts test is met for the taxable year in which the aid was provided";
    for person: Person;
    for doc: ErtcDocument;
    for y: TaxableYear;
    when ertc_aid_in_taxable_year(person, doc, y)
        and ertc_promoter_test_met_for_year(person, y);
    then covid_ertc_promoter(person, doc);
    unless certified_professional_employer_organization(person) and ertc_aid_in_taxable_year(person, doc, y) and ertc_promoter_test_met_for_year(person, y);
}
@source(us.irc.temporal::PL119_21_S70605, relation = derives_from, quote = "with respect to such person’s taxable year in which such person provided such assistance or the preceding taxable year")
rule S70605b1PromoterByPrecedingYear defeasible {
    label en official "the person is a COVID-ERTC promoter if a receipts test is met for the taxable year preceding the year of the aid";
    for person: Person;
    for doc: ErtcDocument;
    for y: TaxableYear;
    for prior: TaxableYear;
    when ertc_aid_in_taxable_year(person, doc, y)
        and preceding_taxable_year(y, prior)
        and ertc_promoter_test_met_for_year(person, prior);
    then covid_ertc_promoter(person, doc);
    unless certified_professional_employer_organization(person) and ertc_aid_in_taxable_year(person, doc, y) and preceding_taxable_year(y, prior) and ertc_promoter_test_met_for_year(person, prior);
}
// TECH_GAP G3741: (b)(4) short taxable years — a person is a promoter if described either
// for the short year or by reading the taxable year as the calendar year in which the
// short year begins (a second computation over a different period).
pub relation ertc_due_diligence_complied(person: Person, doc: ErtcDocument) kind empirical {
    label en official "the promoter complied with the due diligence requirements imposed by the Secretary with respect to determining eligibility for, or the amount of, the credit or advance payment";
}
@source(us.irc.temporal::PL119_21_S70605, relation = derives_from, quote = "which fails to comply with due diligence requirements imposed by the Secretary")
pub rule S70605aDueDiligenceRequired defeasible {
    label en official "a COVID-ERTC promoter that provides aid with respect to a document that is or relates to a return or claim, after 2025-07-04, must comply with the due diligence requirements";
    for person: Person;
    for doc: ErtcDocument;
    for providedOn: Date;
    when ertc_aid_provided(person, doc, providedOn)
        and covid_ertc_promoter(person, doc)
        and ertc_document_is_return_or_claim(doc)
        and providedOn > @2025-07-04;
    then duty S70605aDueDiligenceDuty {
        bearer person;
        beneficiary Secretary;
        goal achievement {
            condition ertc_due_diligence_complied(person, doc);
            window [providedOn, providedOn];
        }
    };
}
pub relation ertc_due_diligence_penalty(person: Person, doc: ErtcDocument, amount: Money) kind institutional {
    label en official "the promoter shall pay a penalty of $1,000 for each failure to comply with the due diligence requirements (treated as a section 6695(g) penalty assessed under section 6201)";
}
@source(us.irc.temporal::PL119_21_S70605, relation = derives_from, quote = "shall pay a penalty of $1,000 for each such failure")
rule S70605aPenaltyOneThousandPerFailure defeasible {
    label en official "$1,000 for each failure to comply with the due diligence requirements";
    for person: Person;
    for doc: ErtcDocument;
    for providedOn: Date;
    when ertc_aid_provided(person, doc, providedOn)
        and covid_ertc_promoter(person, doc)
        and ertc_document_is_return_or_claim(doc)
        and providedOn > @2025-07-04
        and not_known(ertc_due_diligence_complied(person, doc));
    then ertc_due_diligence_penalty(person, doc, 1000.00 USD);
}
// EXTERNAL_DEPENDENCY: the content of the due diligence requirements ("similar to
// section 6695(g)") is imposed by the Secretary and not pinned; the assessment
// treatment (a)(4) and the amendment of section 6676(a) ((f)) belong to `penalties`.
pub relation ertc_credit_or_refund_made_on(employer: Person, quarter: Date, on: Date) kind empirical {
    label en official "a credit under section 3134 is allowed, or a refund with respect to such a credit is made";
}
pub relation ertc_claim_filed_on(employer: Person, quarter: Date, filedOn: Date) kind empirical {
    label en official "the taxpayer filed a claim for the credit or refund";
}
pub relation ertc_claim_filed_by_cutoff(employer: Person, quarter: Date) kind institutional {
    label en unofficial "a claim for the credit or refund was filed on or before January 31, 2024";
}
rule S70605dClaimFiledByCutoff strict {
    label en official "a claim was filed on or before January 31, 2024";
    for employer: Person;
    for quarter: Date;
    for filedOn: Date;
    when ertc_claim_filed_on(employer, quarter, filedOn)
        and filedOn <= @2024-01-31;
    then ertc_claim_filed_by_cutoff(employer, quarter);
}
@source(us.irc.temporal::PL119_21_S70605, relation = derives_from, quote = "no credit under section 3134 of the Internal Revenue Code of 1986 shall be allowed, and no refund with respect to any such credit shall be made, after the date of the enactment of this Act, unless a claim for such credit or refund was filed by the taxpayer on or before January 31, 2024")
pub rule S70605dNoCreditOrRefundWithoutClaimByCutoff defeasible {
    label en official "after 2025-07-04 no section 3134 credit is allowed and no refund made unless a claim was filed by January 31, 2024";
    for employer: Person;
    for quarter: Date;
    for on: Date;
    when ertc_credit_or_refund_made_on(employer, quarter, on)
        and on > @2025-07-04;
    then prohibition S70605dNoCreditOrRefundProhibition {
        bearer Secretary;
        beneficiary employer;
        action ertc_credit_or_refund_made_on(employer, quarter, on);
        window [-infinity, infinity];
    };
    unless ertc_claim_filed_by_cutoff(employer, quarter) and ertc_credit_or_refund_made_on(employer, quarter, on);
}
pub relation ertc_original_return_filed_on(employer: Person, quarter: Date, filedOn: Date) kind empirical {
    label en official "the date on which the original return that includes the calendar quarter is filed";
}
pub relation ertc_return_treated_as_filed_on(employer: Person, quarter: Date, treatedOn: Date) kind empirical {
    label en official "the date on which the return is treated as filed under section 6501(b)(2)";
}
pub relation ertc_refund_claim_made_on(employer: Person, quarter: Date, madeOn: Date) kind empirical {
    label en official "the date on which the claim for credit or refund with respect to the credit is made";
}
pub relation ertc_assessment_candidate(employer: Person, quarter: Date, candidate: Date) kind institutional {
    label en unofficial "6 years after one of the three dates of section 3134(l)(1)(A)-(C)";
}
@source(us.irc.temporal::PL119_21_S70605, relation = derives_from, quote = "shall not expire before the date that is 6 years after the latest of—“(A) the date on which the original return")
rule S3134lCandidateFromOriginalReturn defeasible {
    label en official "candidate: 6 years after the original return is filed";
    for employer: Person;
    for quarter: Date;
    for filedOn: Date;
    when ertc_original_return_filed_on(employer, quarter, filedOn);
    then ertc_assessment_candidate(employer, quarter, add_calendar_period(filedOn, 6 calendar_year));
}
@source(us.irc.temporal::PL119_21_S70605, relation = derives_from, quote = "“(B) the date on which such return is treated as filed under section 6501(b)(2), or")
rule S3134lCandidateFromDeemedFiling defeasible {
    label en official "candidate: 6 years after the return is treated as filed under section 6501(b)(2)";
    for employer: Person;
    for quarter: Date;
    for treatedOn: Date;
    when ertc_return_treated_as_filed_on(employer, quarter, treatedOn);
    then ertc_assessment_candidate(employer, quarter, add_calendar_period(treatedOn, 6 calendar_year));
}
@source(us.irc.temporal::PL119_21_S70605, relation = derives_from, quote = "“(C) the date on which the claim for credit or refund with respect to such credit is made.")
rule S3134lCandidateFromClaim defeasible {
    label en official "candidate: 6 years after the claim for credit or refund is made";
    for employer: Person;
    for quarter: Date;
    for madeOn: Date;
    when ertc_refund_claim_made_on(employer, quarter, madeOn);
    then ertc_assessment_candidate(employer, quarter, add_calendar_period(madeOn, 6 calendar_year));
}
pub relation ertc_later_assessment_candidate_exists(employer: Person, quarter: Date, candidate: Date) kind institutional {
    label en unofficial "a strictly later candidate exists (the G136 pattern: latest of several dates)";
}
rule S3134lLaterCandidateExists defeasible {
    label en unofficial "another candidate is strictly later";
    for employer: Person;
    for quarter: Date;
    for c1: Date;
    for c2: Date;
    when ertc_assessment_candidate(employer, quarter, c1)
        and ertc_assessment_candidate(employer, quarter, c2)
        and c2 > c1;
    then ertc_later_assessment_candidate_exists(employer, quarter, c1);
}
pub relation ertc_assessment_period_lower_bound(employer: Person, quarter: Date, d: Date) kind institutional {
    label en official "the limitation on the time period for assessment of any amount attributable to a credit claimed under section 3134 shall not expire before the date that is 6 years after the latest of the three dates";
}
@source(us.irc.temporal::PL119_21_S70605, relation = derives_from, quote = "the limitation on the time period for the assessment of any amount attributable to a credit claimed under this section shall not expire before the date that is 6 years after the latest of")
rule S3134l1LatestCandidateIsTheLowerBound defeasible {
    label en official "the period does not expire before 6 years after the latest of the three dates (assessments made after 2025-07-04)";
    for employer: Person;
    for quarter: Date;
    for c: Date;
    when ertc_assessment_candidate(employer, quarter, c)
        and not_known(ertc_later_assessment_candidate_exists(employer, quarter, c));
    then ertc_assessment_period_lower_bound(employer, quarter, c);
}
pub relation ertc_assessment_made_on(employer: Person, quarter: Date, on: Date) kind empirical {
    label en official "an assessment attributable to the credit is made";
}
pub relation ertc_assessment_within_extended_period(employer: Person, quarter: Date, on: Date) kind institutional {
    label en official "the assessment is made before the limitation period (extended by section 3134(l)) expires";
}
rule S3134lAssessmentWithinExtendedPeriod defeasible {
    label en official "an assessment made after 2025-07-04 on or before the lower-bound date is timely notwithstanding section 6501";
    for employer: Person;
    for quarter: Date;
    for on: Date;
    for bound: Date;
    when ertc_assessment_made_on(employer, quarter, on)
        and ertc_assessment_period_lower_bound(employer, quarter, bound)
        and on > @2025-07-04
        and on <= bound;
    then ertc_assessment_within_extended_period(employer, quarter, on);
}
pub relation ertc_deduction_refund_period_lower_bound(employer: Person, quarter: Date, d: Date) kind institutional {
    label en official "the limitation on credit or refund of an amount attributable to a deduction for improperly claimed ERTC wages shall not expire before the time period for the assessment expires";
}
@source(us.irc.temporal::PL119_21_S70605, relation = derives_from, quote = "the limitation on the time period for credit or refund of any amount attributable to a deduction for improperly claimed ERTC wages shall not expire before the time period for such assessment expires under paragraph (1)")
rule S3134l2DeductionRefundPeriodFollowsAssessmentPeriod defeasible {
    label en official "notwithstanding section 6511, the refund period for the deduction of improperly claimed ERTC wages does not expire before the assessment period";
    for employer: Person;
    for quarter: Date;
    for bound: Date;
    when ertc_assessment_period_lower_bound(employer, quarter, bound);
    then ertc_deduction_refund_period_lower_bound(employer, quarter, bound);
}

// ============================================================================
// Pub. L. 119-21 §73001 — No Federal unemployment compensation for $1,000,000+ base-period wages
// ============================================================================

pub enum UnemploymentProgramOfTheUnitedStates {
    FederalCivilianEmployeesChapter85I;
    ExServicemembersChapter85II;
    ExtendedBenefitsAct1970;
    FederalTemporaryExtension;
    FederalWeeklyAmountIncrease;
    OtherFederalProgramDeterminedByLabor;
    label en unofficial "an unemployment compensation program of the United States (section 73001(b)(1)-(6))";
}
pub relation base_period_wages(individual: Person, amount: Money) kind empirical {
    label en official "the individual's wages during the individual's base period";
}
pub relation federal_funds_used_for_unemployment_payment(agency: Person, individual: Person, program: UnemploymentProgramOfTheUnitedStates, weekBeginsOn: Date) kind empirical {
    label en official "Federal funds are used to make a payment of unemployment compensation benefits under the program for a week of unemployment";
}
pub relation federal_funds_used_for_administrative_costs_of_such_payment(agency: Person, individual: Person, weekBeginsOn: Date) kind empirical {
    label en official "Federal funds are used for administrative costs associated with such payments";
}
@source(us.irc.temporal::PL119_21_S73001, relation = derives_from, quote = "No Federal funds may be used—“(A) to make payments of unemployment compensation benefits under an unemployment compensation program of the United States in a year to an individual whose wages during the individual’s base period are equal to or exceed $1,000,000")
pub rule S73001a1ANoPaymentToMillionaires defeasible {
    label en official "no Federal funds may be used to pay unemployment compensation to an individual whose base-period wages equal or exceed $1,000,000, for weeks beginning on or after 2025-07-04";
    for agency: Person;
    for individual: Person;
    for program: UnemploymentProgramOfTheUnitedStates;
    for weekBeginsOn: Date;
    for wages: Money;
    when federal_funds_used_for_unemployment_payment(agency, individual, program, weekBeginsOn)
        and base_period_wages(individual, wages)
        and wages >= 1000000.00 USD
        and weekBeginsOn >= @2025-07-04;
    then prohibition S73001a1ANoPaymentProhibition {
        bearer agency;
        action federal_funds_used_for_unemployment_payment(agency, individual, program, weekBeginsOn);
        window [-infinity, infinity];
    };
}
@source(us.irc.temporal::PL119_21_S73001, relation = derives_from, quote = "(B) for any administrative costs associated with making payments described in subparagraph (A)")
pub rule S73001a1BNoAdministrativeCostsForSuchPayments defeasible {
    label en official "no Federal funds may be used for administrative costs of such payments";
    for agency: Person;
    for individual: Person;
    for program: UnemploymentProgramOfTheUnitedStates;
    for weekBeginsOn: Date;
    for wages: Money;
    when federal_funds_used_for_unemployment_payment(agency, individual, program, weekBeginsOn)
        and federal_funds_used_for_administrative_costs_of_such_payment(agency, individual, weekBeginsOn)
        and base_period_wages(individual, wages)
        and wages >= 1000000.00 USD
        and weekBeginsOn >= @2025-07-04;
    then prohibition S73001a1BNoAdministrativeCostsProhibition {
        bearer agency;
        action federal_funds_used_for_administrative_costs_of_such_payment(agency, individual, weekBeginsOn);
        window [-infinity, infinity];
    };
}
pub relation application_includes_wage_self_certification(agency: Person) kind empirical {
    label en official "the application for unemployment compensation includes a form or procedure for the applicant to certify that the applicant's base-period wages do not equal or exceed $1,000,000";
}
pub relation administers_unemployment_program_of_the_united_states(agency: Person) kind empirical {
    label en official "the agency is responsible for administering an unemployment compensation program of the United States";
}
@source(us.irc.temporal::PL119_21_S73001, relation = derives_from, quote = "shall include a form or procedure for an individual applicant to certify that such individual’s wages during the individual’s base period do not equal or exceed $1,000,000")
pub rule S73001a2ASelfCertificationProcedure defeasible {
    label en official "an application under a program of the United States shall include a self-certification of base-period wages below $1,000,000";
    for agency: Person;
    when administers_unemployment_program_of_the_united_states(agency);
    then duty S73001a2ASelfCertificationDuty {
        bearer agency;
        goal maintenance {
            condition application_includes_wage_self_certification(agency);
            window [@2025-07-04, infinity];
        }
    };
}
pub relation state_agency_verifies_wage_eligibility_with_available_systems(agency: Person) kind empirical {
    label en official "the State agency utilizes available systems to verify wage eligibility by assessing claimant income to the degree possible";
}
@source(us.irc.temporal::PL119_21_S73001, relation = derives_from, quote = "shall utilize available systems")
pub rule S73001a2BStateAgencyVerification defeasible {
    label en official "each State agency shall use available systems to verify wage eligibility (to the degree possible)";
    for agency: Person;
    when administers_unemployment_program_of_the_united_states(agency);
    then duty S73001a2BVerificationDuty {
        bearer agency;
        goal maintenance {
            condition state_agency_verifies_wage_eligibility_with_available_systems(agency);
            window [@2025-07-04, infinity];
        }
    };
}
pub relation overpayment_of_unemployment_compensation_received(agency: Person, individual: Person, amount: Money) kind empirical {
    label en official "an individual received amounts of unemployment compensation under such a program to which the individual was not entitled";
}
pub relation state_agency_requires_repayment(agency: Person, individual: Person, amount: Money) kind empirical {
    label en official "the State agency requires the individual to repay the amount";
}
@source(us.irc.temporal::PL119_21_S73001, relation = derives_from, quote = "shall require individuals who have received amounts of unemployment compensation under such a program to which they were not entitled to repay such amounts")
pub rule S73001a3RecoveryOfOverpayments defeasible {
    label en official "each State agency shall require repayment of unemployment compensation to which the individual was not entitled";
    for agency: Person;
    for individual: Person;
    for amount: Money;
    when administers_unemployment_program_of_the_united_states(agency)
        and overpayment_of_unemployment_compensation_received(agency, individual, amount);
    then duty S73001a3RepaymentDuty {
        bearer agency;
        goal achievement {
            condition state_agency_requires_repayment(agency, individual, amount);
            window [@2025-07-04, infinity];
        }
    };
}
