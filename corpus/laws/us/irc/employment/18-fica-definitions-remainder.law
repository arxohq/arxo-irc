// 26 U.S.C. §3121(i)(2),(3),(5), (j), (l), (r)(1)(C),(3), (u)(2)(B)-(D), (w)(2), (z)(2).
// Stage 3 (26.09.2026, TECH_GAP reduction, DECISION-0379). Status:
// implemented_unverified — scenarios are written, not executed.
//
// SCOPE. Stage 2 kept several §3121 subsections as one case fact (the covered
// transportation service determination, the exception facts of (u)(2)) or as
// case facts without the derivations the text gives. This module derives:
//  - §3121(i)(2),(3),(5): the special computations of wages (uniformed services:
//    basic pay / §206(a) compensation only; Peace Corps: §5(c)/6(1) amounts only;
//    retired judges: §371(b) payments excluded). They are wired into
//    `wages_3121` through `wages_computed_specially_3121i` (a `not_known` guard
//    added to Wages3121NoExclusion and Wages3121WithExclusion in 02).
//  - §3121(j): covered transportation service from acquisition dates, the
//    retirement-system tests and the third-calendar-quarter start.
//  - §3121(l)(1)-(6): the agreement's payment duty, effective period,
//    prohibition on termination after June 14, 1989, the wages effect,
//    adjustments and two-year overpayment claims, the 10-percent interest.
//  - §3121(r)(1)(C),(3): services deemed those of an employee of the order; the
//    effective date of the certificate (quarter periods, twenty-quarter
//    look-back), the prior-quarter due date and assessment period.
//  - §3121(u)(2)(B)-(D): the enumerated exceptions, the grandfather clause, the
//    single-employer aggregation; the override rule of 02 now uses `not_known`
//    on the derived exceptions.
//  - §3121(w)(2): the timing of the church election, its scope in time, the
//    Secretary's revocation for two years of missing §6051 information.
//  - §3121(z)(2): the domestically controlled group derived from ownership
//    percentages (more than 50 percent instead of 80) and the (954(d)(3))
//    control of non-corporate members.
// Evaluative words ("substantially all", "bona fide", "purposes of meeting the
// requirements") are findings of the case (DECISION-0194).

// ============================================================================
// §3121(i)(2), (3), (5) — special computation of wages
// ============================================================================

use self::{
    IRC_S3121_I,
    IRC_S3121_J,
    IRC_S3121_L,
    IRC_S3121_R,
    IRC_S3121_U,
    IRC_S3121_W,
    IRC_S3121_Z,
    Person,
    Secretary,
    TaxableYear,
    UniformedServiceDutyKind,
    WagePayment,
    church_exemption_election_filed,
    peace_corps_5c_or_61_payment,
    peace_corps_employment_3121p,
    religious_order_election_filed,
    religious_order_member_of,
    religious_order_vow_of_poverty,
    section_3121u2b_exception_applies,
    section_3121u2c_grandfather_applies,
    state_local_service_excluded_only_by_3121b7,
    title28_section294_service,
    title28_section371b_payment,
    uniformed_service_employment_3121m,
    wage_payment,
    wages_3121,
};

pub relation wages_computed_specially_3121i(pay: WagePayment) kind institutional {
    label en unofficial "the wages of the payment are computed by a special rule of section 3121(i)(2), (3) or (5), not as the whole remuneration (guards Wages3121NoExclusion and Wages3121WithExclusion)";
}
pub relation uniformed_service_basic_pay_amount(pay: WagePayment, amount: Money) kind empirical {
    label en official "the individual's basic pay as described in chapter 3 and section 1009 of title 37, United States Code, for the service";
}
pub relation uniformed_service_206a_compensation_amount(pay: WagePayment, amount: Money) kind empirical {
    label en official "the individual's compensation for the service as determined under section 206(a) of title 37, United States Code";
}
@source(IRC_S3121_I, relation = formalizes, coverage = exact, quote = "(A) his basic pay as described in chapter 3 and section 1009 of title 37, United States Code, in the case of an individual performing service to which subparagraph (A) of such subsection (m)(1) applies")
rule S3121i2AActiveDutySpecial strict {
    label en official "uniformed service on active duty: the payment is computed specially";
    for pay: WagePayment;
    for member: Person;
    when wage_payment(pay, _, member, _, _, _)
        and uniformed_service_employment_3121m(member, ActiveDuty);
    then wages_computed_specially_3121i(pay);
}
rule S3121i2AActiveDutyWages strict {
    label en official "the wages are the basic pay (subject to the base of subsection (a)(1), applied by the tax rules)";
    for pay: WagePayment;
    for member: Person;
    for amount: Money;
    when wage_payment(pay, _, member, _, _, _)
        and uniformed_service_employment_3121m(member, ActiveDuty)
        and uniformed_service_basic_pay_amount(pay, amount);
    then wages_3121(pay, amount);
}
@source(IRC_S3121_I, relation = formalizes, coverage = exact, quote = "or (B) his compensation for such service as determined under section 206(a) of title 37, United States Code, in the case of an individual performing service to which subparagraph (B) of such subsection (m)(1) applies")
rule S3121i2BInactiveDutySpecial strict {
    label en official "uniformed service on inactive duty training: the payment is computed specially";
    for pay: WagePayment;
    for member: Person;
    when wage_payment(pay, _, member, _, _, _)
        and uniformed_service_employment_3121m(member, InactiveDutyTraining);
    then wages_computed_specially_3121i(pay);
}
rule S3121i2BInactiveDutyWages strict {
    label en official "the wages are the section 206(a) compensation";
    for pay: WagePayment;
    for member: Person;
    for amount: Money;
    when wage_payment(pay, _, member, _, _, _)
        and uniformed_service_employment_3121m(member, InactiveDutyTraining)
        and uniformed_service_206a_compensation_amount(pay, amount);
    then wages_3121(pay, amount);
}
@source(IRC_S3121_I, relation = formalizes, coverage = exact, quote = "include as such individual's remuneration for such service only amounts paid pursuant to section 5(c) or 6(1) of the Peace Corps Act")
rule S3121i3PeaceCorpsSpecial strict {
    label en official "Peace Corps service: the payment is computed specially";
    for pay: WagePayment;
    for volunteer: Person;
    when wage_payment(pay, _, volunteer, _, _, _)
        and peace_corps_employment_3121p(volunteer);
    then wages_computed_specially_3121i(pay);
}
rule S3121i3PeaceCorpsWages strict {
    label en official "the wages are the section 5(c) or 6(1) amounts";
    for pay: WagePayment;
    for volunteer: Person;
    for amount: Money;
    when wage_payment(pay, _, volunteer, _, _, _)
        and peace_corps_employment_3121p(volunteer)
        and peace_corps_5c_or_61_payment(pay, amount);
    then wages_3121(pay, amount);
}
@source(IRC_S3121_I, relation = formalizes, coverage = exact, quote = "the term \"wages\" shall not include any payment under section 371(b) of such title 28 which is received during the period of such service")
rule S3121i5RetiredJudgePaymentExcluded strict {
    label en official "a section 371(b) payment received during the section 294 service is not wages: the payment is computed specially and produces no wages";
    for pay: WagePayment;
    when title28_section294_service(pay)
        and title28_section371b_payment(pay);
    then wages_computed_specially_3121i(pay);
}

// ============================================================================
// §3121(j) — covered transportation service
// ============================================================================

pub relation transportation_system_of(system: Person, state: Person) kind empirical {
    label en official "the public transportation system is operated by the State or political subdivision";
}
pub relation transportation_part_acquired_from_private_ownership_on(system: Person, on: Date) kind empirical {
    label en official "a part of the system is acquired from private ownership on this date (paragraph (4)(B): prior to the acquisition the employees' service was employment under this chapter or subchapter A of chapter 9 of the 1939 Code, or covered by a section 218 agreement, and some of them became employees of the State or subdivision at the acquisition)";
}
pub relation transportation_system_operated_before_1951(system: Person) kind empirical {
    label en official "the system was operated by the State or political subdivision before 1951";
}
pub relation service_in_operation_of_transportation_system(service: WagePayment, system: Person) kind empirical {
    label en official "the service is performed in the employ of the State or political subdivision in connection with the operation of its public transportation system";
}
pub relation system_part_acquired_between_1937_and_1950(system: Person) kind institutional {
    label en official "any part of the transportation system was acquired from private ownership after 1936 and prior to 1951";
}
@source(IRC_S3121_J, relation = formalizes, coverage = exact, quote = "if any part of the transportation system was acquired from private ownership after 1936 and prior to 1951")
rule S3121j1AcquiredBetween1937And1950 strict {
    label en official "an acquisition dated from 1937-01-01 through 1950-12-31";
    for system: Person;
    for on: Date;
    when transportation_part_acquired_from_private_ownership_on(system, on)
        and on >= @1937-01-01
        and on <= @1950-12-31;
    then system_part_acquired_between_1937_and_1950(system);
}
pub relation general_retirement_system_established_by_state_or_subdivision(fund: Person) kind empirical {
    label en official "the pension, annuity, retirement or similar fund or system is established by a State or political subdivision for employees of the State, subdivision or both";
}
pub relation fund_covers_only_transportation_positions(fund: Person) kind empirical {
    label en official "the fund or system covers only service performed in positions connected with the operation of its public transportation system";
}
pub relation general_retirement_system_3121j4A(fund: Person) kind institutional {
    label en official "a general retirement system within paragraph (4)(A)";
}
@source(IRC_S3121_J, relation = formalizes, coverage = exact, quote = "The term \"general retirement system\" means any pension, annuity, retirement, or similar fund or system established by a State or by a political subdivision thereof for employees of the State, political subdivision, or both")
rule S3121j4AGeneralRetirementSystem strict {
    label en official "an established fund not confined to transportation positions";
    for fund: Person;
    when general_retirement_system_established_by_state_or_subdivision(fund)
        and not_known(fund_covers_only_transportation_positions_exists(fund));
    then general_retirement_system_3121j4A(fund);
}
relation fund_covers_only_transportation_positions_exists(fund: Person) kind institutional;
rule FundCoversOnlyTransportationPositionsExists strict {
    for fund: Person;
    when fund_covers_only_transportation_positions(fund);
    then fund_covers_only_transportation_positions_exists(fund);
}
pub relation instrumentality_of_state_or_subdivision(p: Person) kind empirical {
    label en official "the person is an instrumentality of a State, of one or more political subdivisions of a State, or of a State and one or more of its political subdivisions (paragraph (4)(C)(i)-(iii))";
}
pub relation political_subdivision_3121j4C(p: Person) kind institutional {
    label en official "the term political subdivision includes the instrumentality";
}
@source(IRC_S3121_J, relation = formalizes, coverage = exact, quote = "The term \"political subdivision\" includes an instrumentality of—")
rule S3121j4CPoliticalSubdivision strict {
    label en official "an instrumentality of a State or of political subdivisions is a political subdivision";
    for p: Person;
    when instrumentality_of_state_or_subdivision(p);
    then political_subdivision_3121j4C(p);
}
pub relation system_covered_substantially_all_by_protected_general_retirement_system_on_1950_12_31(system: Person) kind empirical {
    label en official "substantially all service in connection with the operation of the system was, on December 31, 1950, covered under a general retirement system providing benefits which, by a provision of the State constitution dealing specifically with retirement systems, cannot be diminished or impaired (an evaluative finding: DECISION-0194)";
}
pub relation system_no_part_acquired_1937_1950_of_system_operated_on_1950_12_31(system: Person) kind empirical {
    label en official "no part of the transportation system operated on December 31, 1950, was acquired from private ownership after 1936 and prior to 1951";
}
pub relation transportation_service_excepted_by_3121j2(system: Person) kind institutional {
    label en official "paragraph (2)(A) or (B): service in connection with the system is not covered transportation service";
}
@source(IRC_S3121_J, relation = formalizes, coverage = exact, quote = "(A) any part of the transportation system was acquired from private ownership after 1936 and prior to 1951, and substantially all service in connection with the operation of the transportation system was, on December 31, 1950, covered under a general retirement system")
rule S3121j2AProtectedRetirementSystem strict {
    label en official "(A): acquisition between 1937 and 1950 and constitutionally protected retirement coverage of substantially all service";
    for system: Person;
    when system_part_acquired_between_1937_and_1950(system)
        and system_covered_substantially_all_by_protected_general_retirement_system_on_1950_12_31(system);
    then transportation_service_excepted_by_3121j2(system);
}
@source(IRC_S3121_J, relation = formalizes, coverage = exact, quote = "(B) no part of the transportation system operated by the State or political subdivision on December 31, 1950, was acquired from private ownership after 1936 and prior to 1951;")
rule S3121j2BNoAcquisition strict {
    label en official "(B): no part acquired between 1937 and 1950";
    for system: Person;
    when system_no_part_acquired_1937_1950_of_system_operated_on_1950_12_31(system);
    then transportation_service_excepted_by_3121j2(system);
}
pub relation covered_transportation_service_derived(service: WagePayment) kind institutional {
    label en official "the service is covered transportation service by derivation from the acquisition facts (alternative to the case fact covered_transportation_service_case_fact)";
}
@source(IRC_S3121_J, relation = formalizes, coverage = exact, quote = "all service performed in the employ of a State or political subdivision in connection with its operation of a public transportation system shall constitute covered transportation service if any part of the transportation system was acquired from private ownership after 1936 and prior to 1951")
rule S3121j1GeneralRule strict {
    label en official "existing systems acquired 1937-1950: all service is covered unless paragraph (2) applies";
    for service: WagePayment;
    for system: Person;
    when service_in_operation_of_transportation_system(service, system)
        and system_part_acquired_between_1937_and_1950(system)
        and not_known(transportation_service_excepted_by_3121j2_exists(system));
    then covered_transportation_service_derived(service);
}
relation transportation_service_excepted_by_3121j2_exists(system: Person) kind institutional;
rule TransportationServiceExceptedExists strict {
    for system: Person;
    when transportation_service_excepted_by_3121j2(system);
    then transportation_service_excepted_by_3121j2_exists(system);
}
pub relation state_had_general_retirement_system_covering_substantially_all_at_first_acquisition(system: Person) kind empirical {
    label en official "at the time of its first acquisition (after 1950) from private ownership of any part of its transportation system, the State or subdivision had a general retirement system covering substantially all service in connection with the operation of the system";
}
@source(IRC_S3121_J, relation = formalizes, coverage = exact, quote = "All service performed in the employ of a State or political subdivision thereof in connection with its operation of a public transportation system shall constitute covered transportation service if the transportation system was not operated by the State or political subdivision prior to 1951")
rule S3121j3PostAcquisition strict {
    label en official "a system not operated before 1951 whose first acquisition found no general retirement system covering substantially all service";
    for service: WagePayment;
    for system: Person;
    for acquiredOn: Date;
    when service_in_operation_of_transportation_system(service, system)
        and transportation_part_acquired_from_private_ownership_on(system, acquiredOn)
        and acquiredOn > @1950-12-31
        and not_known(transportation_system_operated_before_1951_exists(system))
        and not_known(state_had_general_retirement_system_exists(system));
    then covered_transportation_service_derived(service);
}
relation transportation_system_operated_before_1951_exists(system: Person) kind institutional;
rule TransportationSystemOperatedBefore1951Exists strict {
    for system: Person;
    when transportation_system_operated_before_1951(system);
    then transportation_system_operated_before_1951_exists(system);
}
relation state_had_general_retirement_system_exists(system: Person) kind institutional;
rule StateHadGeneralRetirementSystemExists strict {
    for system: Person;
    when state_had_general_retirement_system_covering_substantially_all_at_first_acquisition(system);
    then state_had_general_retirement_system_exists(system);
}
pub relation employee_became_employee_at_post_1950_acquisition(employee: Person, system: Person, acquiredOn: Date) kind empirical {
    label en official "the employee became an employee of the State or subdivision in connection with and at the time of its acquisition after 1950 of a part of the system";
}
pub relation employee_previously_rendered_employment_service_in_acquired_part(employee: Person, system: Person) kind empirical {
    label en official "before the acquisition the employee rendered service in employment (including service covered by a section 218 agreement) in connection with the operation of the acquired part";
}
pub relation employee_covered_on_first_day_by_general_retirement_system_without_special_provisions(employee: Person, system: Person) kind empirical {
    label en official "on the first day of the third calendar quarter following the acquisition the employee's service is covered by a general retirement system which does not, for him, contain special provisions applicable only to employees described in (C)";
}
pub relation calendar_quarter_period(quarter: us.irc.core::Period) kind institutional {
    label en unofficial "helper: the Period is a calendar quarter";
}
rule CalendarQuarterPeriod strict {
    for quarter: us.irc.core::Period;
    when us.irc.core::period_kind(quarter, us.irc.core::CalendarQuarter);
    then calendar_quarter_period(quarter);
}
pub relation covered_transportation_service_begins(employee: Person, system: Person, startsOn: Date) kind institutional {
    label en official "the employee's service is covered transportation service commencing with the first day of the third calendar quarter following the quarter of the acquisition";
}
@source(IRC_S3121_J, relation = formalizes, coverage = exact, quote = "the service of such employee in connection with the operation of the transportation system shall constitute covered transportation service, commencing with the first day of the third calendar quarter following the calendar quarter in which the acquisition of such part took place")
rule S3121j2CDThirdQuarterStart strict {
    label en official "the start is the first day of the calendar quarter beginning two quarters after the quarter of the acquisition (the quarter that starts 6 months after the first day of the acquisition quarter, plus 3 months: 9 months after its first day)";
    for employee: Person;
    for system: Person;
    for acquiredOn: Date;
    for quarter: us.irc.core::Period;
    for quarterBegins: Date;
    for quarterEnds: Date;
    when employee_became_employee_at_post_1950_acquisition(employee, system, acquiredOn)
        and employee_previously_rendered_employment_service_in_acquired_part(employee, system)
        and us.irc.core::period_kind(quarter, us.irc.core::CalendarQuarter)
        and us.irc.core::begins(quarter, quarterBegins)
        and us.irc.core::ends(quarter, quarterEnds)
        and quarterBegins <= acquiredOn
        and acquiredOn <= quarterEnds
        and not_known(employee_covered_on_first_day_by_general_retirement_system_exists(employee, system));
    then covered_transportation_service_begins(employee, system, add_calendar_period(quarterBegins, 9 calendar_month));
}
relation employee_covered_on_first_day_by_general_retirement_system_exists(employee: Person, system: Person) kind institutional;
rule EmployeeCoveredOnFirstDayExists strict {
    for employee: Person;
    for system: Person;
    when employee_covered_on_first_day_by_general_retirement_system_without_special_provisions(employee, system);
    then employee_covered_on_first_day_by_general_retirement_system_exists(employee, system);
}
pub relation transportation_service_of_employee(service: WagePayment, employee: Person, system: Person) kind empirical {
    label en official "the service is performed by the employee in connection with the operation of the system";
}
rule S3121j2CDCoveredFromStart strict {
    label en official "service on or after the start is covered transportation service";
    for service: WagePayment;
    for employee: Person;
    for system: Person;
    for startsOn: Date;
    for on: Date;
    when transportation_service_of_employee(service, employee, system)
        and covered_transportation_service_begins(employee, system, startsOn)
        and wage_payment(service, _, employee, _, _, on)
        and on >= startsOn;
    then covered_transportation_service_derived(service);
}

// ============================================================================
// §3121(l) — agreements with respect to foreign affiliates
// ============================================================================

pub relation section_3121l_agreement_entered_into_on(employer: Person, affiliate: Person, on: Date) kind empirical {
    label en official "the American employer and the Secretary enter into an agreement covering the foreign affiliate on this date";
}
pub relation section_3121l_amount_equivalent_paid(employer: Person, affiliate: Person) kind empirical {
    label en official "the American employer paid the Secretary the amounts equivalent to the taxes of sections 3101 and 3111 (with interest, additions, additional amounts and penalties) on the remuneration that would be wages";
}
pub relation section_3121l_regulations_complied_with(employer: Person, affiliate: Person) kind empirical {
    label en official "the American employer complies with the regulations relating to payments and reports";
}
@source(IRC_S3121_L, relation = formalizes, coverage = exact, quote = "(A) that the American employer shall pay to the Secretary, at such time or times as the Secretary may by regulations prescribe, amounts equivalent to the sum of the taxes which would be imposed by sections 3101 and 3111")
pub rule S3121l1APaymentDutyRule defeasible {
    label en official "under the agreement the American employer pays amounts equivalent to the sections 3101 and 3111 taxes (times set by regulations: open window)";
    for employer: Person;
    for affiliate: Person;
    for enteredOn: Date;
    when section_3121l_agreement_entered_into_on(employer, affiliate, enteredOn);
    then duty S3121l1APaymentDuty {
        bearer employer;
        beneficiary Secretary;
        goal achievement {
            condition section_3121l_amount_equivalent_paid(employer, affiliate);
            window [enteredOn, infinity];
        }
    };
}
@source(IRC_S3121_L, relation = formalizes, coverage = exact, quote = "(B) that the American employer will comply with such regulations relating to payments and reports as the Secretary may prescribe to carry out the purposes of this subsection.")
pub rule S3121l1BComplianceDutyRule defeasible {
    label en official "the American employer complies with the regulations on payments and reports";
    for employer: Person;
    for affiliate: Person;
    for enteredOn: Date;
    when section_3121l_agreement_entered_into_on(employer, affiliate, enteredOn);
    then duty S3121l1BComplianceDuty {
        bearer employer;
        beneficiary Secretary;
        goal maintenance {
            condition section_3121l_regulations_complied_with(employer, affiliate);
            window [enteredOn, infinity];
        }
    };
}
pub relation section_3121l_election_of_start(employer: Person, affiliate: Person, succeedingQuarter: Boolean) kind empirical {
    label en official "the agreement specifies the first day of the calendar quarter in which it is entered into (false) or of the succeeding quarter (true)";
}
pub relation section_3121l_agreement_in_effect_from(employer: Person, affiliate: Person, startsOn: Date) kind institutional {
    label en official "the first day of the effective period of the agreement";
}
@source(IRC_S3121_L, relation = formalizes, coverage = exact, quote = "shall be in effect for the period beginning with the first day of the calendar quarter in which such agreement is entered into or the first day of the succeeding calendar quarter, as may be specified in the agreement")
rule S3121l2StartInSameQuarter strict {
    label en official "the quarter in which the agreement is entered into";
    for employer: Person;
    for affiliate: Person;
    for enteredOn: Date;
    for quarter: us.irc.core::Period;
    for quarterBegins: Date;
    for quarterEnds: Date;
    when section_3121l_agreement_entered_into_on(employer, affiliate, enteredOn)
        and section_3121l_election_of_start(employer, affiliate, false)
        and us.irc.core::period_kind(quarter, us.irc.core::CalendarQuarter)
        and us.irc.core::begins(quarter, quarterBegins)
        and us.irc.core::ends(quarter, quarterEnds)
        and quarterBegins <= enteredOn
        and enteredOn <= quarterEnds;
    then section_3121l_agreement_in_effect_from(employer, affiliate, quarterBegins);
}
rule S3121l2StartInSucceedingQuarter strict {
    label en official "the succeeding quarter";
    for employer: Person;
    for affiliate: Person;
    for enteredOn: Date;
    for quarter: us.irc.core::Period;
    for quarterBegins: Date;
    for quarterEnds: Date;
    when section_3121l_agreement_entered_into_on(employer, affiliate, enteredOn)
        and section_3121l_election_of_start(employer, affiliate, true)
        and us.irc.core::period_kind(quarter, us.irc.core::CalendarQuarter)
        and us.irc.core::begins(quarter, quarterBegins)
        and us.irc.core::ends(quarter, quarterEnds)
        and quarterBegins <= enteredOn
        and enteredOn <= quarterEnds;
    then section_3121l_agreement_in_effect_from(employer, affiliate, add_calendar_period(quarterBegins, 3 calendar_month));
}
pub relation section_3121l_amendment_executed_on(employer: Person, affiliate: Person, on: Date) kind empirical {
    label en official "the agreement is amended to include the services performed for another affiliate on this date";
}
pub relation section_3121l_first_quarter_ends_on(employer: Person, quarterEnds: Date) kind empirical {
    label en official "the last day of the first calendar quarter for which the agreement is in effect";
}
pub relation section_3121l_amendment_effective_after(employer: Person, affiliate: Person, afterQuarterEnds: Date) kind institutional {
    label en official "an amendment executed after the first month following the first quarter for which the agreement is in effect covers the other affiliate only after the quarter in which it is executed";
}
@source(IRC_S3121_L, relation = formalizes, coverage = exact, quote = "except that in case such agreement is amended to include the services performed for any other affiliate and such amendment is executed after the first month following the first calendar quarter for which the agreement is in effect, the agreement shall be in effect with respect to service performed for such other affiliate only after the calendar quarter in which such amendment is executed")
rule S3121l2LateAmendment strict {
    label en official "late amendment: effective only after the quarter of execution";
    for employer: Person;
    for affiliate: Person;
    for amendedOn: Date;
    for firstQuarterEnds: Date;
    for quarter: us.irc.core::Period;
    for quarterBegins: Date;
    for quarterEnds: Date;
    when section_3121l_amendment_executed_on(employer, affiliate, amendedOn)
        and section_3121l_first_quarter_ends_on(employer, firstQuarterEnds)
        and amendedOn > add_calendar_period(firstQuarterEnds, 1 calendar_month)
        and us.irc.core::period_kind(quarter, us.irc.core::CalendarQuarter)
        and us.irc.core::begins(quarter, quarterBegins)
        and us.irc.core::ends(quarter, quarterEnds)
        and quarterBegins <= amendedOn
        and amendedOn <= quarterEnds;
    then section_3121l_amendment_effective_after(employer, affiliate, quarterEnds);
}
pub relation entity_ceases_to_be_foreign_affiliate_in_quarter(employer: Person, ent: Person, quarterEnds: Date) kind empirical {
    label en official "at some time in the quarter (ending on the date) the foreign entity ceases to be a foreign affiliate";
}
pub relation section_3121l_agreement_terminates_for_entity_at(employer: Person, ent: Person, endsOn: Date) kind institutional {
    label en official "the agreement's effective period for the entity terminates at the end of the quarter in which it ceases to be a foreign affiliate";
}
@source(IRC_S3121_L, relation = formalizes, coverage = exact, quote = "the period for which any such agreement is effective with respect to any foreign entity shall terminate at the end of any calendar quarter in which the foreign entity, at any time in such quarter, ceases to be a foreign affiliate as defined in paragraph (6)")
rule S3121l2CeasesToBeAffiliate strict {
    label en official "termination at the end of the quarter";
    for employer: Person;
    for ent: Person;
    for quarterEnds: Date;
    when entity_ceases_to_be_foreign_affiliate_in_quarter(employer, ent, quarterEnds);
    then section_3121l_agreement_terminates_for_entity_at(employer, ent, quarterEnds);
}
pub relation section_3121l_agreement_terminated_on(employer: Person, affiliate: Person, on: Date) kind empirical {
    label en official "the agreement is terminated, in its entirety or with respect to the affiliate, on this date";
}
@source(IRC_S3121_L, relation = formalizes, coverage = exact, quote = "No agreement under this subsection may be terminated, either in its entirety or with respect to any foreign affiliate, on or after June 15, 1989.")
pub rule S3121l3NoTerminationRule defeasible {
    label en official "termination on or after June 15, 1989 is prohibited (for the American employer and the Secretary)";
    for employer: Person;
    for affiliate: Person;
    for on: Date;
    when section_3121l_agreement_terminated_on(employer, affiliate, on)
        and on >= @1989-06-15;
    then prohibition S3121l3NoTerminationProhibition {
        bearer employer;
        beneficiary Secretary;
        action section_3121l_agreement_terminated_on(employer, affiliate, on);
        window [on, on];
    };
}
pub relation remuneration_paid_for_agreement_services(employer: Person, affiliate: Person, employee: Person, amount: Money) kind empirical {
    label en official "remuneration paid for services covered by the agreement, which would be wages if the services constituted employment";
}
pub relation remuneration_reported_under_agreement(employer: Person, affiliate: Person, employee: Person) kind empirical {
    label en official "the remuneration is reported to the Secretary pursuant to the agreement or the regulations";
}
pub relation section_3121l_remuneration_considered_wages(employer: Person, employee: Person, amount: Money) kind institutional {
    label en official "for the Social Security trust fund appropriations of section 201 the remuneration is considered wages subject to the taxes of this chapter";
}
@source(IRC_S3121_L, relation = formalizes, coverage = exact, quote = "shall be considered wages subject to the taxes imposed by this chapter")
rule S3121l4RemunerationIsWages strict {
    label en official "covered and reported remuneration is wages for section 201";
    for employer: Person;
    for affiliate: Person;
    for employee: Person;
    for amount: Money;
    when remuneration_paid_for_agreement_services(employer, affiliate, employee, amount)
        and remuneration_reported_under_agreement(employer, affiliate, employee);
    then section_3121l_remuneration_considered_wages(employer, employee, amount);
}
pub relation section_3121l_amount_paid_and_correct(employer: Person, affiliate: Person, paid: Money, correct: Money) kind empirical {
    label en official "the amount paid under the agreement with respect to a payment of remuneration and the correct amount due";
}
pub relation section_3121l_adjustment_amount(employer: Person, affiliate: Person, amount: Money) kind institutional {
    label en official "the adjustment (positive: additional payment due; negative: overpayment), without interest";
}
@source(IRC_S3121_L, relation = formalizes, coverage = exact, quote = "If more or less than the correct amount due under an agreement entered into pursuant to this subsection is paid with respect to any payment of remuneration, proper adjustments with respect to the amounts due under such agreement shall be made, without interest")
rule S3121l5AAdjustment strict {
    label en official "the difference between the correct amount and the amount paid";
    for employer: Person;
    for affiliate: Person;
    for paid: Money;
    for correct: Money;
    when section_3121l_amount_paid_and_correct(employer, affiliate, paid, correct);
    then section_3121l_adjustment_amount(employer, affiliate, correct - paid);
}
pub relation overpayment_cannot_be_adjusted(employer: Person, affiliate: Person, amount: Money, madeOn: Date) kind empirical {
    label en official "an overpayment that cannot be adjusted under subparagraph (A), made on this date";
}
pub relation overpayment_claim_filed_on(employer: Person, affiliate: Person, on: Date) kind empirical {
    label en official "a claim for the overpayment is filed with the Secretary";
}
pub relation overpayment_refunded(employer: Person, affiliate: Person) kind empirical {
    label en official "the Secretary paid the overpayment through the Fiscal Service";
}
@source(IRC_S3121_L, relation = formalizes, coverage = exact, quote = "the amount thereof shall be paid by the Secretary, through the Fiscal Service of the Treasury Department, but only if a claim for such overpayment is filed with the Secretary within two years from the time such overpayment was made")
pub rule S3121l5BRefundDutyRule defeasible {
    label en official "the Secretary pays an unadjustable overpayment if the claim is filed within two years of the overpayment (no payment date stated: open window)";
    for employer: Person;
    for affiliate: Person;
    for amount: Money;
    for madeOn: Date;
    for claimedOn: Date;
    when overpayment_cannot_be_adjusted(employer, affiliate, amount, madeOn)
        and overpayment_claim_filed_on(employer, affiliate, claimedOn)
        and claimedOn <= add_calendar_period(madeOn, 2 calendar_year);
    then duty S3121l5BRefundDuty {
        bearer Secretary;
        beneficiary employer;
        goal achievement {
            condition overpayment_refunded(employer, affiliate);
            window [claimedOn, infinity];
        }
    };
}
pub enum InterestBasis3121l6 {
    VotingStockOfCorporation;
    ProfitsOfOtherEntity;
    label en unofficial "the interest tested for the 10-percent rule of paragraph (6)(B)";
}
pub relation american_employer_interest_in_entity(employer: Person, ent: Person, basis: InterestBasis3121l6, percent: Decimal) kind empirical {
    label en official "the percentage interest the American employer has, directly or through one or more entities, in the voting stock of a corporation or the profits of another entity";
}
pub relation ten_percent_interest_3121l6(employer: Person, ent: Person) kind institutional {
    label en official "the American employer has not less than a 10-percent interest in the entity";
}
@source(IRC_S3121_L, relation = formalizes, coverage = exact, quote = "(i) in the case of a corporation, in the voting stock thereof, and")
rule S3121l6BCorporation strict {
    label en official "a corporation: the voting stock";
    for employer: Person;
    for ent: Person;
    for percent: Decimal;
    when american_employer_interest_in_entity(employer, ent, VotingStockOfCorporation, percent)
        and percent >= 10 percent;
    then ten_percent_interest_3121l6(employer, ent);
}
@source(IRC_S3121_L, relation = formalizes, coverage = exact, quote = "(ii) in the case of any other entity, in the profits thereof.")
rule S3121l6BOtherEntity strict {
    label en official "any other entity: the profits";
    for employer: Person;
    for ent: Person;
    for percent: Decimal;
    when american_employer_interest_in_entity(employer, ent, ProfitsOfOtherEntity, percent)
        and percent >= 10 percent;
    then ten_percent_interest_3121l6(employer, ent);
}

// ============================================================================
// §3121(r) — election of coverage by religious orders
// ============================================================================

pub relation member_service_deemed_as_employee_of_order(member: Person, order: Person) kind institutional {
    label en official "all services performed by a member in the exercise of duties required by the order or subdivision are deemed performed as an employee of the order or subdivision";
}
@source(IRC_S3121_R, relation = formalizes, coverage = exact, quote = "(C) all services performed by a member of such an order or subdivision in the exercise of duties required by such order or subdivision shall be deemed to have been performed by such member as an employee of such order or subdivision; and")
rule S3121r1CServiceDeemedEmployeeService strict {
    label en official "a certificate of election filed by an order whose members take a vow of poverty: the members' services are employee services of the order";
    for member: Person;
    for order: Person;
    for on: Date;
    when religious_order_election_filed(order, on)
        and religious_order_vow_of_poverty(order)
        and religious_order_member_of(member, order);
    then member_service_deemed_as_employee_of_order(member, order);
}
pub relation religious_order_certificate_filed_on(order: Person, filedOn: Date) kind empirical {
    label en official "the certificate of election is filed";
}
pub relation religious_order_designates_effective_date(order: Person, designated: Date) kind empirical {
    label en official "the order designates the first day of a calendar quarter as the beginning of the election's effect";
}
pub relation religious_order_certificate_effective_from(order: Person, from: Date) kind institutional {
    label en official "the certificate is in effect for the period beginning with the designated date, when it is a permitted date (clauses (i)-(iii))";
}
@source(IRC_S3121_R, relation = formalizes, coverage = exact, quote = "(i) the first day of the calendar quarter in which the certificate is filed,")
rule S3121r3AiSameQuarter strict {
    label en official "the first day of the quarter of filing";
    for order: Person;
    for filedOn: Date;
    for from: Date;
    for quarter: us.irc.core::Period;
    for quarterEnds: Date;
    when religious_order_certificate_filed_on(order, filedOn)
        and religious_order_designates_effective_date(order, from)
        and us.irc.core::period_kind(quarter, us.irc.core::CalendarQuarter)
        and us.irc.core::begins(quarter, from)
        and us.irc.core::ends(quarter, quarterEnds)
        and from <= filedOn
        and filedOn <= quarterEnds;
    then religious_order_certificate_effective_from(order, from);
}
@source(IRC_S3121_R, relation = formalizes, coverage = exact, quote = "(ii) the first day of the calendar quarter succeeding such quarter, or")
rule S3121r3AiiSucceedingQuarter strict {
    label en official "the first day of the quarter after the quarter of filing";
    for order: Person;
    for filedOn: Date;
    for from: Date;
    for quarter: us.irc.core::Period;
    for quarterBegins: Date;
    for quarterEnds: Date;
    when religious_order_certificate_filed_on(order, filedOn)
        and religious_order_designates_effective_date(order, from)
        and us.irc.core::period_kind(quarter, us.irc.core::CalendarQuarter)
        and us.irc.core::begins(quarter, quarterBegins)
        and us.irc.core::ends(quarter, quarterEnds)
        and quarterBegins <= filedOn
        and filedOn <= quarterEnds
        and from == add_calendar_period(quarterBegins, 3 calendar_month);
    then religious_order_certificate_effective_from(order, from);
}
@source(IRC_S3121_R, relation = formalizes, coverage = exact, quote = "(iii) the first day of any calendar quarter preceding the calendar quarter in which the certificate is filed, except that such date may not be earlier than the first day of the twentieth calendar quarter preceding the quarter in which such certificate is filed.")
rule S3121r3AiiiEarlierQuarter strict {
    label en official "an earlier quarter, but not more than twenty quarters (60 months) before the quarter of filing";
    for order: Person;
    for filedOn: Date;
    for from: Date;
    for designatedQuarter: us.irc.core::Period;
    for filingQuarter: us.irc.core::Period;
    for filingBegins: Date;
    for filingEnds: Date;
    when religious_order_certificate_filed_on(order, filedOn)
        and religious_order_designates_effective_date(order, from)
        and us.irc.core::period_kind(designatedQuarter, us.irc.core::CalendarQuarter)
        and us.irc.core::begins(designatedQuarter, from)
        and us.irc.core::period_kind(filingQuarter, us.irc.core::CalendarQuarter)
        and us.irc.core::begins(filingQuarter, filingBegins)
        and us.irc.core::ends(filingQuarter, filingEnds)
        and filingBegins <= filedOn
        and filedOn <= filingEnds
        and from < filingBegins
        and add_calendar_period(from, 60 calendar_month) >= filingBegins;
    then religious_order_certificate_effective_from(order, from);
}
pub relation member_was_member_when_service_performed(member: Person, order: Person, serviceOn: Date) kind empirical {
    label en official "the member was a member at the time the services were performed";
}
pub relation member_living_on_first_day_of_filing_quarter(member: Person) kind empirical {
    label en official "the member is living on the first day of the quarter in which the certificate is filed";
}
pub relation election_applies_to_prior_service(order: Person, member: Person, serviceOn: Date) kind institutional {
    label en official "a date designated under clause (iii): the election applies to services performed before the filing quarter only if the member was a member at the time and is living on the first day of the filing quarter";
}
@source(IRC_S3121_R, relation = formalizes, coverage = exact, quote = "Whenever a date is designated under clause (iii), the election shall apply to services performed before the quarter in which the certificate is filed only if the member performing such services was a member at the time such services were performed and is living on the first day of the quarter in which such certificate is filed.")
rule S3121r3AiiiPriorServices strict {
    label en official "a clause (iii) designation: services before the filing quarter count for a member who was a member then and is living";
    for order: Person;
    for member: Person;
    for serviceOn: Date;
    for from: Date;
    for filedOn: Date;
    for filingQuarter: us.irc.core::Period;
    for filingBegins: Date;
    for filingEnds: Date;
    when religious_order_certificate_effective_from(order, from)
        and religious_order_certificate_filed_on(order, filedOn)
        and us.irc.core::period_kind(filingQuarter, us.irc.core::CalendarQuarter)
        and us.irc.core::begins(filingQuarter, filingBegins)
        and us.irc.core::ends(filingQuarter, filingEnds)
        and filingBegins <= filedOn
        and filedOn <= filingEnds
        and from < filingBegins
        and member_was_member_when_service_performed(member, order, serviceOn)
        and member_living_on_first_day_of_filing_quarter(member)
        and serviceOn >= from
        and serviceOn < filingBegins;
    then election_applies_to_prior_service(order, member, serviceOn);
}
pub relation religious_order_prior_quarter_return_due(order: Person, dueOn: Date) kind institutional {
    label en official "the due date (for computing interest and the section 6651 addition) of the return and payment for prior quarters: the last day of the calendar month following the quarter in which the certificate is filed";
}
@source(IRC_S3121_R, relation = formalizes, coverage = exact, quote = "the due date for the return and payment of the tax for such prior calendar quarters resulting from the filing of such certificate shall be the last day of the calendar month following the calendar quarter in which the certificate is filed")
rule S3121r3BiDueDate strict {
    label en official "the last day of the month that begins the day after the filing quarter ends";
    for order: Person;
    for filedOn: Date;
    for from: Date;
    for filingQuarter: us.irc.core::Period;
    for filingBegins: Date;
    for filingEnds: Date;
    for month: us.irc.core::Period;
    for monthEnds: Date;
    when religious_order_certificate_filed_on(order, filedOn)
        and religious_order_certificate_effective_from(order, from)
        and us.irc.core::period_kind(filingQuarter, us.irc.core::CalendarQuarter)
        and us.irc.core::begins(filingQuarter, filingBegins)
        and us.irc.core::ends(filingQuarter, filingEnds)
        and filingBegins <= filedOn
        and filedOn <= filingEnds
        and from < filingBegins
        and us.irc.core::period_kind(month, us.irc.core::CalendarMonth)
        and us.irc.core::begins(month, add_calendar_period(filingEnds, 1 calendar_day))
        and us.irc.core::ends(month, monthEnds);
    then religious_order_prior_quarter_return_due(order, monthEnds);
}
pub relation religious_order_assessment_period_lower_bound(order: Person, bound: Date) kind institutional {
    label en official "the statutory period for assessment of the tax does not expire before 3 years from the due date";
}
@source(IRC_S3121_R, relation = formalizes, coverage = exact, quote = "the statutory period for the assessment of such tax shall not expire before the expiration of 3 years from such due date")
rule S3121r3BiiAssessmentPeriod strict {
    label en official "three years after the due date";
    for order: Person;
    for dueOn: Date;
    when religious_order_prior_quarter_return_due(order, dueOn);
    then religious_order_assessment_period_lower_bound(order, add_calendar_period(dueOn, 3 calendar_year));
}

// ============================================================================
// §3121(u)(2)(B)-(D) — State and local employment, hospital insurance tax
// ============================================================================

pub enum Section3121u2bService {
    IncludedUnderSection218Agreement;      // (i)
    UnemploymentReliefEmployee;            // (ii)(I)
    PatientOrInmateInInstitution;          // (ii)(II)
    TemporaryEmergencyEmployee;            // (ii)(III)
    DcHospitalStudentEmployee;             // (ii)(IV)
    ElectionWorker;                        // (ii)(V)
    Section1402c2EPosition;                // (ii)(VI)
    label en unofficial "the services excepted by section 3121(u)(2)(B)";
}
pub relation section_3121u2b_service_kind(service: WagePayment, kind: Section3121u2bService) kind empirical {
    label en official "the service is of one of the kinds of subparagraph (B)";
}
pub relation election_worker_remuneration_in_year(service: WagePayment, amount: Money) kind empirical {
    label en official "the remuneration paid in the calendar year for the service as an election official or election worker";
}
pub relation election_worker_adjusted_amount_218c8B(y: TaxableYear, amount: Money) kind empirical {
    label en official "the adjusted amount determined under section 218(c)(8)(B) of the Social Security Act for the calendar year (indexed after 1999: SOURCE_GAP, never invented)";
}
pub relation section_3121u2b_exception_derived(service: WagePayment) kind institutional {
    label en official "a service exception of subparagraph (B) applies";
}
@source(IRC_S3121_U, relation = formalizes, coverage = exact, quote = "Service shall not be treated as employment by reason of subparagraph (A) if—")
rule S3121u2BListedKinds strict {
    label en official "kinds (i) and (ii)(I)-(IV), (VI)";
    for service: WagePayment;
    for kind: Section3121u2bService;
    when section_3121u2b_service_kind(service, kind)
        and kind != ElectionWorker;
    then section_3121u2b_exception_derived(service);
}
@source(IRC_S3121_U, relation = formalizes, coverage = exact, quote = "by an election official or election worker if the remuneration paid in a calendar year for such service is less than $1,000 with respect to service performed during any calendar year commencing on or after January 1, 1995, ending on or before December 31, 1999")
rule S3121u2BElectionWorker1995To1999 strict {
    label en official "election workers with less than $1,000 in a calendar year from 1995 through 1999";
    for service: WagePayment;
    for y: TaxableYear;
    for n: Integer;
    for amount: Money;
    when section_3121u2b_service_kind(service, ElectionWorker)
        and wage_payment(service, _, _, y, _, _)
        and us.irc.core::calendar_year_of(y, n)
        and n >= 1995
        and n <= 1999
        and election_worker_remuneration_in_year(service, amount)
        and amount < 1000.00 USD;
    then section_3121u2b_exception_derived(service);
}
@source(IRC_S3121_U, relation = formalizes, coverage = exact, quote = "and the adjusted amount determined under section 218(c)(8)(B) of the Social Security Act for any calendar year commencing on or after January 1, 2000, with respect to service performed during such calendar year")
rule S3121u2BElectionWorkerFrom2000 strict {
    label en official "election workers with less than the adjusted amount from 2000 (the amount is a case fact)";
    for service: WagePayment;
    for y: TaxableYear;
    for n: Integer;
    for amount: Money;
    for threshold: Money;
    when section_3121u2b_service_kind(service, ElectionWorker)
        and wage_payment(service, _, _, y, _, _)
        and us.irc.core::calendar_year_of(y, n)
        and n >= 2000
        and election_worker_remuneration_in_year(service, amount)
        and election_worker_adjusted_amount_218c8B(y, threshold)
        and amount < threshold;
    then section_3121u2b_exception_derived(service);
}
pub relation substantial_regular_service_for_employer_before_april_1_1986(individual: Person, employer: Person) kind empirical {
    label en official "the individual was performing substantial and regular service for remuneration for the employer before April 1, 1986";
}
pub relation bona_fide_employee_on_march_31_1986(individual: Person, employer: Person) kind empirical {
    label en official "the individual is a bona fide employee of the employer on March 31, 1986";
}
pub relation employment_relationship_entered_to_meet_requirements(individual: Person, employer: Person) kind empirical {
    label en official "the employment relationship was entered into for purposes of meeting the requirements of subparagraph (C) (an evaluative finding of purpose)";
}
pub relation employment_relationship_terminated_after_march_31_1986(individual: Person, employer: Person) kind empirical {
    label en official "the employment relationship with the employer has been terminated after March 31, 1986";
}
pub relation service_for_grandfather_employer(service: WagePayment, individual: Person, employer: Person) kind empirical {
    label en official "the service is performed for the employer by the individual";
}
pub relation section_3121u2c_grandfather_derived(service: WagePayment) kind institutional {
    label en official "the grandfather clause of subparagraph (C) applies to the service";
}
@source(IRC_S3121_U, relation = formalizes, coverage = exact, quote = "(iii) the employment relationship with that employer has not been terminated after March 31, 1986.")
rule S3121u2CGrandfather strict {
    label en official "would be excluded without (A); substantial and regular service before April 1, 1986; bona fide employee on March 31, 1986; not entered into to meet the requirements; not terminated";
    for service: WagePayment;
    for individual: Person;
    for employer: Person;
    when service_for_grandfather_employer(service, individual, employer)
        and state_local_service_excluded_only_by_3121b7(service)
        and substantial_regular_service_for_employer_before_april_1_1986(individual, employer)
        and bona_fide_employee_on_march_31_1986(individual, employer)
        and not_known(employment_relationship_entered_to_meet_requirements_exists(individual, employer))
        and not_known(employment_relationship_terminated_exists(individual, employer));
    then section_3121u2c_grandfather_derived(service);
}
relation employment_relationship_entered_to_meet_requirements_exists(individual: Person, employer: Person) kind institutional;
rule EmploymentRelationshipEnteredExists strict {
    for individual: Person;
    for employer: Person;
    when employment_relationship_entered_to_meet_requirements(individual, employer);
    then employment_relationship_entered_to_meet_requirements_exists(individual, employer);
}
relation employment_relationship_terminated_exists(individual: Person, employer: Person) kind institutional;
rule EmploymentRelationshipTerminatedExists strict {
    for individual: Person;
    for employer: Person;
    when employment_relationship_terminated_after_march_31_1986(individual, employer);
    then employment_relationship_terminated_exists(individual, employer);
}
pub relation agency_or_instrumentality_of_state_or_dc(agency: Person, state: Person) kind empirical {
    label en official "the agency or instrumentality of a State (as defined in section 218(b) of the Social Security Act) or of the District of Columbia";
}
pub relation agency_or_instrumentality_of_political_subdivision(agency: Person, subdivision: Person) kind empirical {
    label en official "the agency or instrumentality of a political subdivision of a State";
}
pub relation treated_as_single_employer_3121u2D(agency: Person, employer: Person) kind institutional {
    label en official "for subparagraph (C), under regulations, the agency is treated as part of the single employer (the State or DC, or the political subdivision)";
}
@source(IRC_S3121_U, relation = formalizes, coverage = exact, quote = "(i) All agencies and instrumentalities of a State (as defined in section 218(b) of the Social Security Act) or of the District of Columbia shall be treated as a single employer.")
rule S3121u2DiStateAgencies strict {
    label en official "all agencies of a State or DC are one employer";
    for agency: Person;
    for state: Person;
    when agency_or_instrumentality_of_state_or_dc(agency, state);
    then treated_as_single_employer_3121u2D(agency, state);
}
@source(IRC_S3121_U, relation = formalizes, coverage = exact, quote = "(ii) All agencies and instrumentalities of a political subdivision of a State (as so defined) shall be treated as a single employer and shall not be treated as described in clause (i).")
rule S3121u2DiiSubdivisionAgencies strict {
    label en official "all agencies of a political subdivision are one employer, distinct from the State";
    for agency: Person;
    for subdivision: Person;
    when agency_or_instrumentality_of_political_subdivision(agency, subdivision);
    then treated_as_single_employer_3121u2D(agency, subdivision);
}
pub relation section_3121u2_exception_any(service: WagePayment) kind institutional {
    label en unofficial "a section 3121(u)(2)(B) exception or the (C) grandfather clause applies to the service (derived, or the legacy case facts of 02-fica-definitions.law)";
}
rule S3121u2ExceptionFromB strict {
    for service: WagePayment;
    when section_3121u2b_exception_derived(service);
    then section_3121u2_exception_any(service);
}
rule S3121u2ExceptionFromC strict {
    for service: WagePayment;
    when section_3121u2c_grandfather_derived(service);
    then section_3121u2_exception_any(service);
}
rule S3121u2ExceptionFromLegacyB strict {
    for service: WagePayment;
    when section_3121u2b_exception_applies(service);
    then section_3121u2_exception_any(service);
}
rule S3121u2ExceptionFromLegacyC strict {
    for service: WagePayment;
    when section_3121u2c_grandfather_applies(service);
    then section_3121u2_exception_any(service);
}

// ============================================================================
// §3121(w)(2) — timing and duration of the church election
// ============================================================================

pub relation church_quarterly_return_due_on(church: Person, dueOn: Date) kind empirical {
    label en official "a quarterly employment tax return for the section 3111 tax is due (or would be due but for the election) from the church or organization on this date";
}
pub relation church_election_first_deadline(church: Person, deadline: Date) kind institutional {
    label en official "the first date, more than 90 days after July 18, 1984, on which such a return is due: the election must be made before it";
}
pub relation earlier_church_return_due_after_cutoff_exists(church: Person, dueOn: Date) kind institutional {
    label en unofficial "a strictly earlier due date after the cutoff exists";
}
rule EarlierChurchReturnDueAfterCutoffExists strict {
    for church: Person;
    for d1: Date;
    for d2: Date;
    when church_quarterly_return_due_on(church, d1)
        and church_quarterly_return_due_on(church, d2)
        and d1 > add_calendar_period(@1984-07-18, 90 calendar_day)
        and d2 > add_calendar_period(@1984-07-18, 90 calendar_day)
        and d2 < d1;
    then earlier_church_return_due_after_cutoff_exists(church, d1);
}
@source(IRC_S3121_W, relation = formalizes, coverage = exact, quote = "An election under this subsection must be made prior to the first date, more than 90 days after July 18, 1984, on which a quarterly employment tax return for the tax imposed under section 3111 is due, or would be due but for the election, from such church or organization.")
rule S3121w2FirstDeadline strict {
    label en official "the earliest due date more than 90 days after July 18, 1984";
    for church: Person;
    for dueOn: Date;
    when church_quarterly_return_due_on(church, dueOn)
        and dueOn > add_calendar_period(@1984-07-18, 90 calendar_day)
        and not_known(earlier_church_return_due_after_cutoff_exists(church, dueOn));
    then church_election_first_deadline(church, dueOn);
}
pub relation church_election_timely(church: Person) kind institutional {
    label en official "the election was made before the first due date";
}
rule S3121w2ElectionTimely strict {
    label en official "filed before the deadline";
    for church: Person;
    for filedOn: Date;
    for deadline: Date;
    when church_exemption_election_filed(church, filedOn)
        and church_election_first_deadline(church, deadline)
        and filedOn < deadline;
    then church_election_timely(church);
}
pub relation church_election_covers_service_on(church: Person, serviceOn: Date) kind institutional {
    label en official "the election applies to current and future employees and to service performed after December 31, 1983";
}
@source(IRC_S3121_W, relation = formalizes, coverage = exact, quote = "An election under this subsection shall apply to current and future employees, and shall apply to service performed after December 31, 1983.")
rule S3121w2ServiceAfter1983 strict {
    label en official "service performed after December 31, 1983 by employees of a church with a timely election, not revoked before the service";
    for church: Person;
    for serviceOn: Date;
    when church_election_timely(church)
        and church_service_performed_on(church, serviceOn)
        and serviceOn > @1983-12-31
        and not_known(church_election_revoked_exists(church));
    then church_election_covers_service_on(church, serviceOn);
}
pub relation church_service_performed_on(church: Person, serviceOn: Date) kind empirical {
    label en official "service is performed in the employ of the church or organization on this date";
}
pub relation church_revoked_election_on(church: Person, on: Date) kind empirical {
    label en official "the church or organization revokes the election under the Secretary's regulations";
}
relation church_election_revoked_exists(church: Person) kind institutional;
rule ChurchElectionRevokedExists strict {
    for church: Person;
    for on: Date;
    when church_revoked_election_on(church, on);
    then church_election_revoked_exists(church);
}
pub relation church_failed_to_furnish_6051_information_from(church: Person, fromOn: Date, toOn: Date) kind empirical {
    label en official "the church or organization failed to furnish the information required under section 6051 for the period from-to";
}
pub relation church_failed_to_furnish_previously_unfurnished_information_on_request(church: Person) kind empirical {
    label en official "on the Secretary's request the church fails to furnish all such previously unfurnished information for the period covered by the election";
}
pub relation secretary_may_revoke_church_election(church: Person) kind institutional {
    label en official "the conditions for the Secretary's revocation are met: two years or more without the section 6051 information and no response to the request";
}
@source(IRC_S3121_W, relation = formalizes, coverage = exact, quote = "The election shall be revoked by the Secretary if such church or organization fails to furnish the information required under section 6051 to the Secretary for a period of 2 years or more")
rule S3121w2SecretaryRevocationConditions strict {
    label en official "a failure period of two years or more (the end is not before the start plus two calendar years) and no response to the request";
    for church: Person;
    for fromOn: Date;
    for toOn: Date;
    when church_failed_to_furnish_6051_information_from(church, fromOn, toOn)
        and add_calendar_period(fromOn, 2 calendar_year) <= toOn
        and church_failed_to_furnish_previously_unfurnished_information_on_request(church);
    then secretary_may_revoke_church_election(church);
}
pub relation secretary_revokes_church_election_on(church: Person, on: Date) kind empirical {
    label en official "the Secretary revokes the election";
}
pub relation church_election_revoked_by_secretary(church: Person) kind institutional {
    label en official "the effect of the Secretary's revocation";
}
@source(IRC_S3121_W, relation = formalizes, coverage = exact, quote = "The election shall be revoked by the Secretary if such church or organization fails to furnish the information required under section 6051")
pub rule S3121w2SecretaryRevocationPowerRule defeasible {
    label en official "the Secretary's revocation, valid when the conditions are met";
    for church: Person;
    for on: Date;
    when secretary_revokes_church_election_on(church, on);
    then power S3121w2SecretaryRevocationPower {
        holder Secretary;
        over church;
        exercise secretary_revokes_church_election_on(church, on);
        valid_when secretary_may_revoke_church_election(church);
        effect create(church_election_revoked_by_secretary(church));
    };
}
pub relation church_election_revocation_retroactive_to(church: Person, fromOn: Date) kind institutional {
    label en official "the revocation applies retroactively to the beginning of the 2-year period for which the information was not furnished";
}
@source(IRC_S3121_W, relation = formalizes, coverage = exact, quote = "Any revocation under the preceding sentence shall apply retroactively to the beginning of the 2-year period for which the information was not furnished.")
rule S3121w2RetroactiveRevocation strict {
    label en official "the beginning of the failure period";
    for church: Person;
    for on: Date;
    for fromOn: Date;
    for toOn: Date;
    when secretary_revokes_church_election_on(church, on)
        and secretary_may_revoke_church_election(church)
        and church_failed_to_furnish_6051_information_from(church, fromOn, toOn);
    then church_election_revocation_retroactive_to(church, fromOn);
}

// ============================================================================
// §3121(z)(2) — domestically controlled group of entities
// ============================================================================

pub relation group_ownership_percent(ent: Person, parent: Person, percent: Decimal) kind empirical {
    label en official "the percentage of the stock (or interest) of the entity owned, directly or through group members, by the common parent (the section 1563(a)(1) computation is the case's)";
}
pub relation domestic_corporation(p: Person) kind empirical {
    label en official "the person is a domestic corporation";
}
pub relation entity_controlled_within_954d3_by_group_members(ent: Person, parent: Person) kind empirical {
    label en official "a partnership or other non-corporate entity is controlled (within the meaning of section 954(d)(3)) by members of the group (including entities treated as members by this sentence)";
}
pub relation member_of_controlled_group_of_entities(ent: Person, parent: Person) kind institutional {
    label en official "the entity is a member of the controlled group of entities whose common parent is the parent (more than 50 percent replaces at least 80 percent)";
}
@source(IRC_S3121_Z, relation = formalizes, coverage = exact, quote = "(i) \"more than 50 percent\" shall be substituted for \"at least 80 percent\" each place it appears therein")
rule S3121z2BiMoreThanFiftyPercent strict {
    label en official "the common parent owns more than 50 percent";
    for ent: Person;
    for parent: Person;
    for percent: Decimal;
    when group_ownership_percent(ent, parent, percent)
        and percent > 50 percent;
    then member_of_controlled_group_of_entities(ent, parent);
}
@source(IRC_S3121_Z, relation = formalizes, coverage = exact, quote = "A partnership or any other entity (other than a corporation) shall be treated as a member of a controlled group of entities if such entity is controlled (within the meaning of section 954(d)(3)) by members of such group")
rule S3121z2BNonCorporateMember strict {
    label en official "non-corporate entities controlled within the meaning of section 954(d)(3)";
    for ent: Person;
    for parent: Person;
    when entity_controlled_within_954d3_by_group_members(ent, parent);
    then member_of_controlled_group_of_entities(ent, parent);
}
pub relation member_of_domestically_controlled_group(ent: Person, parent: Person) kind institutional {
    label en official "the entity is a member of a controlled group of entities the common parent of which is a domestic corporation";
}
@source(IRC_S3121_Z, relation = formalizes, coverage = exact, quote = "The term \"domestically controlled group of entities\" means a controlled group of entities the common parent of which is a domestic corporation.")
rule S3121z2ADomesticParent strict {
    label en official "the common parent is a domestic corporation";
    for ent: Person;
    for parent: Person;
    when member_of_controlled_group_of_entities(ent, parent)
        and domestic_corporation(parent);
    then member_of_domestically_controlled_group(ent, parent);
}
