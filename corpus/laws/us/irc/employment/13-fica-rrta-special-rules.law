// 26 U.S.C. §§3101(c), 3102(c)-(d), 3202(c)-(d), 3241(d), 3127(b)-(c), 3402(k).
// Stage 3 (26.09.2026, TECH_GAP reduction, DECISION-0379). Status:
// implemented_unverified — scenarios are written, not executed.
//
// SCOPE. Rules the earlier stages left as TECH_GAP although the language can
// express them:
//  - §3101(c): totalization-agreement relief for the EMPLOYEE tax (mirror of
//    §3111(c) in 01-fica-tax.law).
//  - §3102(c)/§3202(c): the special rule for tips — deduction only of tips
//    included in a §6053(a) statement and only to the extent collectible
//    from wages (excluding tips) and funds turned over inside the window
//    (10th day after the calendar month; 30th day after the year — §3202:
//    quarter — when paragraph (3) applies); the employee's liberty to turn
//    funds over; the Secretary's power to authorize estimation and the
//    employer's liberties under it; the employee's duty to pay the excess.
//    The window is COMPUTED from the calendar-month / quarter `Period` and
//    the taxable year of `us.irc.core`, not asserted as a case fact.
//  - §3102(d)/§3202(d): group-term life insurance for coverage after the
//    employment relationship ended — subsection (a) does not apply, separate
//    statement duty, the employee pays the tax.
//  - §3402(k): tips and income tax withholding (statement only, collectible
//    funds net of FICA tax, the $20 monthly clause, the ceiling).
//  - §3127(b)/(c): approval findings and the calendar-quarter effective
//    period of the religious exemption.
//  - §3241(d): the Secretary's Federal Register notice by December 1.
//
// Conventions. A tip payment is a `WagePayment` record whose date is the date
// the tips are deemed paid (§3121(q), §3231(h)); the record is flagged with
// `tip_payment`. Funds the employer can collect the tax from are the empirical
// relation `tip_collection_fund`. Amounts are Money, cents HALF_UP where a
// rate is applied elsewhere; here only comparisons and min/max are used.

// ============================================================================
// §3101(c) — totalization agreements, employee tax
// ============================================================================

use self::{
    IRC_S3101_C,
    IRC_S3102_C,
    IRC_S3102_D,
    IRC_S3127_B,
    IRC_S3127_C,
    IRC_S3202_C,
    IRC_S3202_D,
    IRC_S3241_D,
    IRC_S3402_K,
    Organ,
    Person,
    Secretary,
    SourceRef,
    TaxableYear,
    WagePayment,
    employee_tax_deducted,
    fica_employee_tax,
    fica_employee_tax_owed_3101,
    income_tax_withheld,
    rrta_compensation,
    rrta_group_term_life_insurance_payment,
    rrta_tax_deducted_by_employer,
    rrta_tip_deemed_paid_on,
    rrta_tip_statement_furnished,
    rrta_tip_tax_owed,
    secretary_prescribed_withholding_amount,
    totalization_agreement_covers,
    wage_payment,
    wages_3121,
};

@source(IRC_S3101_C, relation = formalizes, coverage = exact, quote = "wages received by or paid to an individual shall be exempt from the taxes imposed by this section to the extent that such wages are subject under such agreement exclusively to the laws applicable to the social security system of such foreign country")
rule Section3101TotalizationImmunityRule defeasible {
    label en official "during a section 233 Social Security Act agreement the wages subject exclusively to the foreign system are exempt from the section 3101 tax";
    for pay: WagePayment;
    for employer: Person;
    for employee: Person;
    for on: Date;
    when wage_payment(pay, employer, employee, _, _, on)
        and totalization_agreement_covers(employee, on);
    then immunity Section3101TotalizationImmunity {
        holder employee;
        protected_effect fica_employee_tax_owed_3101(employee, pay);
        window [on, on];
    };
}

// ============================================================================
// §3102(d), §3202(d) — group-term life insurance after employment ends
// ============================================================================

pub relation group_term_life_insurance_payment(pay: WagePayment) kind empirical {
    label en official "the payment is a payment for group-term life insurance";
}
pub relation group_term_life_coverage_after_employment_ends(pay: WagePayment) kind empirical {
    label en official "the payment is for coverage for periods during which an employment relationship no longer exists between the employee and the employer";
}
pub relation section_3102d_applies(pay: WagePayment) kind institutional {
    label en official "section 3102(d) applies to the payment: it constitutes wages and is for coverage after the employment relationship ended";
}
@source(IRC_S3102_D, relation = formalizes, coverage = exact, quote = "This subsection shall apply to any payment for group-term life insurance to the extent—")
rule S3102d2SubsectionApplies defeasible {
    label en official "a group-term life insurance payment that constitutes wages and is for coverage after employment ends is a payment to which subsection (d) applies";
    for pay: WagePayment;
    for amount: Money;
    when group_term_life_insurance_payment(pay)
        and wages_3121(pay, amount)
        and group_term_life_coverage_after_employment_ends(pay);
    then section_3102d_applies(pay);
}
@source(IRC_S3102_D, relation = formalizes, coverage = exact, quote = "(A) subsection (a) shall not apply,")
rule S3102d1AExcludesTheDeductionDuty defeasible {
    label en official "for such a payment the section 3102(a) duty to deduct does not arise (a defeater of Section3102DutyToDeduct)";
    for pay: WagePayment;
    for employer: Person;
    for employee: Person;
    for on: Date;
    for tax: Money;
    when section_3102d_applies(pay)
        and wage_payment(pay, employer, employee, _, _, on)
        and fica_employee_tax(pay, tax);
    then group_term_life_deduction_duty_displaced(pay);
}
pub relation group_term_life_deduction_duty_displaced(pay: WagePayment) kind institutional {
    label en unofficial "section 3102(d)(1)(A): subsection (a) does not apply to the payment (helper consumed by the exceptions of the section 3102(a) duty)";
}
pub relation group_term_life_separately_stated_on_6051_statement(pay: WagePayment) kind empirical {
    label en official "the employer separately included on the section 6051 statement both the group-term life insurance portion of the wages and the amount of the section 3101 tax on it";
}
@source(IRC_S3102_D, relation = formalizes, coverage = exact, quote = "(B) the employer shall separately include on the statement required under section 6051—")
pub rule S3102d1BSeparateStatementDutyRule defeasible {
    label en official "the employer shall separately state the group-term life insurance wages and the tax on them on the section 6051 statement (the date of that statement is set by section 6051, owned elsewhere: window from the payment date, unbounded above)";
    for pay: WagePayment;
    for employer: Person;
    for employee: Person;
    for on: Date;
    when section_3102d_applies(pay)
        and wage_payment(pay, employer, employee, _, _, on);
    then duty S3102d1BSeparateStatementDuty {
        bearer employer;
        beneficiary employee;
        goal achievement {
            condition group_term_life_separately_stated_on_6051_statement(pay);
            window [on, infinity];
        }
    };
}
pub relation group_term_life_tax_paid_by_employee(pay: WagePayment) kind empirical {
    label en official "the employee paid the section 3101 tax on the group-term life insurance payment";
}
@source(IRC_S3102_D, relation = formalizes, coverage = exact, quote = "(C) the tax imposed by section 3101 on such payments shall be paid by the employee.")
pub rule S3102d1CEmployeePaysTheTax defeasible {
    label en official "the section 3101 tax on such payments shall be paid by the employee";
    for pay: WagePayment;
    for employer: Person;
    for employee: Person;
    for on: Date;
    for tax: Money;
    when section_3102d_applies(pay)
        and wage_payment(pay, employer, employee, _, _, on)
        and fica_employee_tax(pay, tax);
    then duty S3102d1CEmployeePaysGroupTermLifeTaxDuty {
        bearer employee;
        beneficiary Secretary;
        goal achievement {
            condition group_term_life_tax_paid_by_employee(pay);
            window [on, infinity];
        }
    };
}

// §3202(d): the same for compensation under chapter 22. The (C) rule
// (`Section3202DGroupTermLifeEmployeePaysTax`) and the case fact
// `rrta_group_term_life_insurance_payment(pay, true)` exist in 09-rrta.law.
pub relation rrta_section_3202d_applies(pay: WagePayment) kind institutional {
    label en official "section 3202(d) applies to the payment: it constitutes compensation and is for coverage after the employment relationship ended";
}
@source(IRC_S3202_D, relation = formalizes, coverage = exact, quote = "This subsection shall apply to any payment for group-term life insurance to the extent—")
rule S3202d2SubsectionApplies defeasible {
    label en official "a group-term life insurance payment that constitutes compensation and is for coverage after employment ends is a payment to which subsection (d) applies";
    for pay: WagePayment;
    for amount: Money;
    when rrta_group_term_life_insurance_payment(pay, true)
        and rrta_compensation(pay, amount);
    then rrta_section_3202d_applies(pay);
}
pub relation rrta_group_term_life_deduction_duty_displaced(pay: WagePayment) kind institutional {
    label en unofficial "section 3202(d)(1)(A): subsection (a) does not apply to the payment (helper consumed by the exceptions of the section 3202(a) duty)";
}
@source(IRC_S3202_D, relation = formalizes, coverage = exact, quote = "(A) subsection (a) shall not apply,")
rule S3202d1AExcludesTheDeductionDuty defeasible {
    label en official "for such a payment the section 3202(a) duty to deduct does not arise";
    for pay: WagePayment;
    when rrta_section_3202d_applies(pay);
    then rrta_group_term_life_deduction_duty_displaced(pay);
}
pub relation rrta_group_term_life_separately_stated_on_6051_statement(pay: WagePayment) kind empirical {
    label en official "the employer separately included on the section 6051 statement the group-term life insurance portion of the compensation and the amount of the section 3201 tax on it";
}
@source(IRC_S3202_D, relation = formalizes, coverage = exact, quote = "(B) the employer shall separately include on the statement required under section 6051—")
pub rule S3202d1BSeparateStatementDutyRule defeasible {
    label en official "the employer shall separately state the group-term life insurance compensation and the tax on it on the section 6051 statement";
    for pay: WagePayment;
    for employer: Person;
    for employee: Person;
    for on: Date;
    when rrta_section_3202d_applies(pay)
        and wage_payment(pay, employer, employee, _, _, on);
    then duty S3202d1BSeparateStatementDuty {
        bearer employer;
        beneficiary employee;
        goal achievement {
            condition rrta_group_term_life_separately_stated_on_6051_statement(pay);
            window [on, infinity];
        }
    };
}

// ============================================================================
// §3102(c) — special rule for tips (employee FICA tax)
// ============================================================================

pub relation tip_payment(pay: WagePayment) kind empirical {
    label en unofficial "the wage payment record stands for tips that constitute wages, deemed paid on the record's date (section 3121(q))";
}
pub relation tip_statement_furnished_on(pay: WagePayment, on: Date) kind empirical {
    label en official "a written statement including these tips was furnished to the employer pursuant to section 6053(a) on this date";
}
pub enum TipCollectionFundKind {
    WagesExcludingTips;
    FundsTurnedOverByEmployee;
    label en unofficial "the two sources from which the tax on tips can be collected: wages of the employee excluding tips under the employer's control, and funds the employee turned over to the employer";
}
pub relation tip_collection_fund(pay: WagePayment, kind: TipCollectionFundKind, amount: Money, on: Date) kind empirical {
    label en official "wages of the employee (excluding tips) under the employer's control, or funds turned over by the employee under paragraph (2), from which the tax on the tips of this payment can be collected, with the date they came under the employer's control";
}
pub relation secretary_authorizes_tip_estimation(employer: Person, y: TaxableYear) kind empirical {
    label en official "the Secretary authorizes the employer to estimate tips, deduct as if the estimate were actual, and adjust (paragraph (3)) for the calendar year (the quarter, under section 3202(c)(3), inside the year)";
}
pub relation secretary_regulations_authorize_tip_estimation(y: TaxableYear) kind empirical {
    label en official "regulations prescribed by the Secretary provide for the authorization of paragraph (3) for the year";
}
pub relation tip_estimation_authorization_created(employer: Person, y: TaxableYear) kind institutional {
    label en unofficial "the effect of the Secretary's authorization power (paragraph (3))";
}
pub relation tip_estimation_authorized(employer: Person, y: TaxableYear) kind institutional {
    label en official "paragraph (3) applies to the employer for the year: the Secretary authorized the employer, under regulations, to estimate tips";
}
@source(IRC_S3102_C, relation = formalizes, coverage = exact, quote = "The Secretary may, under regulations prescribed by him, authorize employers—")
pub rule S3102c3SecretaryMayAuthorizeTipEstimation defeasible {
    label en official "the Secretary may, under regulations, authorize an employer to estimate tips";
    for employer: Person;
    for y: TaxableYear;
    when secretary_authorizes_tip_estimation(employer, y);
    then power S3102c3AuthorizeTipEstimationPower {
        holder Secretary;
        over employer;
        exercise secretary_authorizes_tip_estimation(employer, y);
        valid_when secretary_regulations_authorize_tip_estimation(y);
        effect create(tip_estimation_authorization_created(employer, y));
    };
}
rule TipEstimationAuthorizedByRegulation defeasible {
    label en unofficial "paragraph (3) applies when the Secretary's authorization is given under regulations (the ordinary-rule counterpart of the power, consumed by the window rules)";
    for employer: Person;
    for y: TaxableYear;
    when secretary_authorizes_tip_estimation(employer, y)
        and secretary_regulations_authorize_tip_estimation(y);
    then tip_estimation_authorized(employer, y);
}
pub relation employer_of_tipped_employee(employer: Person, employee: Person) kind empirical {
    label en unofficial "the employee receives tips in the course of employment by the employer";
}
pub relation employer_estimates_tips(employer: Person, employee: Person, y: TaxableYear) kind empirical {
    label en official "the employer estimates the amount of tips that will be reported by the employee in the year";
}
pub relation employer_deducts_as_if_estimated_tips_were_actual(employer: Person, employee: Person, y: TaxableYear) kind empirical {
    label en official "the employer determines the amount to be deducted on each payment of wages (exclusive of tips) as if the estimated tips constituted the actual tips reported";
}
pub relation employer_deducts_adjustment_for_tips(employer: Person, employee: Person, y: TaxableYear) kind empirical {
    label en official "the employer deducts, on a payment of wages (other than tips, including funds turned over) during the year and within 30 days thereafter, the amount necessary to adjust the amount actually deducted to the amount required in respect of tips included in statements furnished during the year";
}
@source(IRC_S3102_C, relation = formalizes, coverage = exact, quote = "(A) to estimate the amount of tips that will be reported by the employee pursuant to section 6053(a) in any calendar year,")
rule S3102c3AEmployerMayEstimateTips defeasible {
    label en official "an authorized employer may estimate the tips an employee will report in the year";
    for employer: Person;
    for employee: Person;
    for y: TaxableYear;
    for yearBegins: Date;
    for yearEnds: Date;
    when tip_estimation_authorized(employer, y)
        and employer_of_tipped_employee(employer, employee)
        and us.irc.core::begins(y, yearBegins)
        and us.irc.core::ends(y, yearEnds);
    then liberty S3102c3AEstimateTipsLiberty {
        holder employer;
        against employee;
        action employer_estimates_tips(employer, employee, y);
        window [yearBegins, yearEnds];
    };
}
@source(IRC_S3102_C, relation = formalizes, coverage = exact, quote = "(B) to determine the amount to be deducted upon each payment of wages (exclusive of tips) during such year as if the tips so estimated constituted the actual tips so reported, and")
rule S3102c3BEmployerMayDeductOnEstimate defeasible {
    label en official "an authorized employer may determine the deduction on each payment of wages as if the estimated tips were the actual tips";
    for employer: Person;
    for employee: Person;
    for y: TaxableYear;
    for yearBegins: Date;
    for yearEnds: Date;
    when tip_estimation_authorized(employer, y)
        and employer_of_tipped_employee(employer, employee)
        and us.irc.core::begins(y, yearBegins)
        and us.irc.core::ends(y, yearEnds);
    then liberty S3102c3BDeductOnEstimateLiberty {
        holder employer;
        against employee;
        action employer_deducts_as_if_estimated_tips_were_actual(employer, employee, y);
        window [yearBegins, yearEnds];
    };
}
@source(IRC_S3102_C, relation = formalizes, coverage = exact, quote = "(C) to deduct upon any payment of wages (other than tips, but including funds turned over by the employee to the employer pursuant to paragraph (2)) to such employee during such year (and within 30 days thereafter)")
rule S3102c3CEmployerMayDeductAdjustment defeasible {
    label en official "an authorized employer may deduct an adjustment during the year and within 30 days after it";
    for employer: Person;
    for employee: Person;
    for y: TaxableYear;
    for yearBegins: Date;
    for yearEnds: Date;
    when tip_estimation_authorized(employer, y)
        and employer_of_tipped_employee(employer, employee)
        and us.irc.core::begins(y, yearBegins)
        and us.irc.core::ends(y, yearEnds);
    then liberty S3102c3CDeductAdjustmentLiberty {
        holder employer;
        against employee;
        action employer_deducts_adjustment_for_tips(employer, employee, y);
        window [yearBegins, add_calendar_period(yearEnds, 30 calendar_day)];
    };
}
pub relation tip_deemed_paid_month(pay: WagePayment, month: us.irc.core::Period) kind institutional {
    label en unofficial "the calendar month in which the tips were deemed paid (the month Period containing the date of the tip payment record)";
}
rule TipDeemedPaidMonth defeasible {
    label en unofficial "the calendar month that contains the date on which the tips are deemed paid";
    for pay: WagePayment;
    for on: Date;
    for month: us.irc.core::Period;
    for monthBegins: Date;
    for monthEnds: Date;
    when tip_payment(pay)
        and wage_payment(pay, _, _, _, _, on)
        and us.irc.core::period_kind(month, us.irc.core::CalendarMonth)
        and us.irc.core::begins(month, monthBegins)
        and us.irc.core::ends(month, monthEnds)
        and monthBegins <= on
        and on <= monthEnds;
    then tip_deemed_paid_month(pay, month);
}
pub relation tip_tax_collection_deadline(pay: WagePayment, deadline: Date) kind institutional {
    label en official "the close of the 10th day following the calendar month (or, if paragraph (3) applies, the 30th day following the year) in which the tips were deemed paid — the last day for collection under paragraph (1) and for the employee's funds under paragraph (2)";
}
@source(IRC_S3102_C, relation = formalizes, coverage = exact, quote = "before the close of the 10th day following the calendar month")
rule S3102c1DeadlineMonth defeasible {
    label en official "collection window closes on the 10th day after the end of the calendar month in which the tips were deemed paid";
    for pay: WagePayment;
    for month: us.irc.core::Period;
    for monthEnds: Date;
    when tip_deemed_paid_month(pay, month)
        and us.irc.core::ends(month, monthEnds);
    then tip_tax_collection_deadline(pay, add_calendar_period(monthEnds, 10 calendar_day));
    unless tip_payment(pay) and tip_estimation_applies_to_payment(pay) and tip_deemed_paid_month(pay, month) and us.irc.core::ends(month, monthEnds);
}
pub relation tip_estimation_applies_to_payment(pay: WagePayment) kind institutional {
    label en unofficial "paragraph (3) applies to the employer of this tip payment for the payment's taxable year";
}
rule TipEstimationAppliesToPayment defeasible {
    label en unofficial "the payment's employer is authorized under paragraph (3) for the payment's year";
    for pay: WagePayment;
    for employer: Person;
    for y: TaxableYear;
    when tip_payment(pay)
        and wage_payment(pay, employer, _, y, _, _)
        and tip_estimation_authorized(employer, y);
    then tip_estimation_applies_to_payment(pay);
}
@source(IRC_S3102_C, relation = formalizes, coverage = exact, quote = "(or, if paragraph (3) applies, the 30th day following the year)")
rule S3102c1DeadlineYear defeasible {
    label en official "if paragraph (3) applies the window closes on the 30th day after the end of the year";
    for pay: WagePayment;
    for y: TaxableYear;
    for yearEnds: Date;
    when tip_estimation_applies_to_payment(pay)
        and wage_payment(pay, _, _, y, _, _)
        and us.irc.core::ends(y, yearEnds);
    then tip_tax_collection_deadline(pay, add_calendar_period(yearEnds, 30 calendar_day));
}
pub relation tip_tax_collectible_funds(pay: WagePayment, amount: Money) kind institutional {
    label en official "the wages (excluding tips) and turned-over funds under the employer's control at or after the statement and by the close of the collection window";
}
rule TipTaxCollectibleFunds defeasible {
    label en official "sum of the funds that came under the employer's control from the statement date up to the deadline";
    for pay: WagePayment;
    for statementOn: Date;
    for deadline: Date;
    when tip_payment(pay)
        and tip_statement_furnished_on(pay, statementOn)
        and tip_tax_collection_deadline(pay, deadline);
    then tip_tax_collectible_funds(pay,
        sum(collect all a: Money, k: TipCollectionFundKind, d: Date
            where tip_collection_fund(pay, k, a, d) and d >= statementOn and d <= deadline,
            empty: 0.00 USD));
}
pub relation tip_tax_collectible(pay: WagePayment, amount: Money) kind institutional {
    label en official "the part of the section 3101 tax on the statement tips that can be collected by deduction: the lesser of the tax and the collectible funds";
}
@source(IRC_S3102_C, relation = formalizes, coverage = exact, quote = "and only to the extent that collection can be made by the employer, at or after the time such statement is so furnished")
rule S3102c1CollectibleAmount defeasible {
    label en official "subsection (a) applies to the tips only to the extent collection can be made from the available funds";
    for pay: WagePayment;
    for tax: Money;
    for funds: Money;
    when tip_payment(pay)
        and fica_employee_tax(pay, tax)
        and tip_tax_collectible_funds(pay, funds);
    then tip_tax_collectible(pay, min(tax, funds));
}
@source(IRC_S3102_C, relation = formalizes, coverage = exact, quote = "subsection (a) shall be applicable only to such tips as are included in a written statement furnished to the employer pursuant to section 6053(a)")
pub rule S3102c1TipDeductionDutyRule defeasible {
    label en official "the duty to deduct the tax on tips is limited to statement tips, in the collectible amount, within the collection window";
    for pay: WagePayment;
    for employer: Person;
    for employee: Person;
    for statementOn: Date;
    for deadline: Date;
    for collectible: Money;
    when tip_payment(pay)
        and wage_payment(pay, employer, employee, _, _, _)
        and tip_statement_furnished_on(pay, statementOn)
        and tip_tax_collection_deadline(pay, deadline)
        and tip_tax_collectible(pay, collectible);
    then duty S3102c1TipDeductionDuty {
        bearer employer;
        beneficiary Secretary;
        goal achievement {
            condition employee_tax_deducted(pay, collectible);
            window [statementOn, deadline];
        }
    };
}
pub relation tip_statement_missing_no_deduction_duty(pay: WagePayment) kind institutional {
    label en unofficial "the tip payment is not included in a section 6053(a) statement: subsection (a) does not apply to it";
}
rule S3102c1NoStatementNoDuty defeasible {
    label en official "tips not included in a written statement are outside subsection (a)";
    for pay: WagePayment;
    when tip_payment(pay)
        and not_known(tip_statement_furnished_on_exists(pay));
    then tip_statement_missing_no_deduction_duty(pay);
}
relation tip_statement_furnished_on_exists(pay: WagePayment) kind institutional;
rule TipStatementFurnishedOnExists defeasible {
    for pay: WagePayment;
    for on: Date;
    when tip_statement_furnished_on(pay, on);
    then tip_statement_furnished_on_exists(pay);
}
pub relation tip_wages_excluding_tips_in_window(pay: WagePayment, amount: Money) kind institutional {
    label en unofficial "the wages (excluding tips) under the employer's control inside the window, from which the tax is required to be collected under paragraph (1)";
}
rule TipWagesExcludingTipsInWindow defeasible {
    for pay: WagePayment;
    for statementOn: Date;
    for deadline: Date;
    when tip_payment(pay)
        and tip_statement_furnished_on(pay, statementOn)
        and tip_tax_collection_deadline(pay, deadline);
    then tip_wages_excluding_tips_in_window(pay,
        sum(collect all a: Money, d: Date
            where tip_collection_fund(pay, WagesExcludingTips, a, d) and d >= statementOn and d <= deadline,
            empty: 0.00 USD));
}
pub relation tip_tax_excess_over_wages(pay: WagePayment, excess: Money) kind institutional {
    label en official "the amount by which the tax on the statement tips exceeds the wages (excluding tips) from which the employer is required to collect it";
}
rule S3102c2Excess defeasible {
    label en official "the tax on the tips exceeds the wages of the employee (excluding tips)";
    for pay: WagePayment;
    for tax: Money;
    for wages: Money;
    when tip_payment(pay)
        and fica_employee_tax(pay, tax)
        and tip_wages_excluding_tips_in_window(pay, wages)
        and tax > wages;
    then tip_tax_excess_over_wages(pay, tax - wages);
}
pub relation employee_furnishes_tip_tax_funds(employee: Person, employer: Person, pay: WagePayment, amount: Money) kind empirical {
    label en official "the employee furnishes the employer an amount of money equal to the excess";
}
@source(IRC_S3102_C, relation = formalizes, coverage = exact, quote = "the employee may furnish to the employer on or before the 10th day of the following month (or, if paragraph (3) applies, on or before the 30th day of the following year) an amount of money equal to the amount of the excess")
pub rule S3102c2EmployeeMayFurnishFunds defeasible {
    label en official "when the tax on statement tips exceeds the wages, the employee may furnish the excess by the close of the collection window";
    for pay: WagePayment;
    for employer: Person;
    for employee: Person;
    for statementOn: Date;
    for deadline: Date;
    for excess: Money;
    when tip_payment(pay)
        and wage_payment(pay, employer, employee, _, _, _)
        and tip_statement_furnished_on(pay, statementOn)
        and tip_tax_collection_deadline(pay, deadline)
        and tip_tax_excess_over_wages(pay, excess);
    then liberty S3102c2FurnishFundsLiberty {
        holder employee;
        against employer;
        action employee_furnishes_tip_tax_funds(employee, employer, pay, excess);
        window [statementOn, deadline];
    };
}
pub relation tip_tax_uncollected(pay: WagePayment, excess: Money) kind institutional {
    label en official "the tax on the tips exceeding the portion that can be collected under paragraph (1) or (3)";
}
rule S3102c4Uncollected defeasible {
    label en official "tax exceeding the collectible portion";
    for pay: WagePayment;
    for tax: Money;
    for collectible: Money;
    when tip_payment(pay)
        and fica_employee_tax(pay, tax)
        and tip_tax_collectible(pay, collectible)
        and tax > collectible;
    then tip_tax_uncollected(pay, tax - collectible);
}
pub relation tip_tax_excess_paid_by_employee(pay: WagePayment, amount: Money) kind empirical {
    label en official "the employee paid the uncollected excess of the tax on tips";
}
@source(IRC_S3102_C, relation = formalizes, coverage = exact, quote = "such excess shall be paid by the employee")
pub rule S3102c4EmployeePaysExcess defeasible {
    label en official "the excess of the tax on tips over the collectible portion shall be paid by the employee (no due date is stated: window open after the collection window closes)";
    for pay: WagePayment;
    for employee: Person;
    for excess: Money;
    for deadline: Date;
    when tip_payment(pay)
        and wage_payment(pay, _, employee, _, _, _)
        and tip_tax_uncollected(pay, excess)
        and tip_tax_collection_deadline(pay, deadline);
    then duty S3102c4EmployeePaysExcessDuty {
        bearer employee;
        beneficiary Secretary;
        goal achievement {
            condition tip_tax_excess_paid_by_employee(pay, excess);
            window [deadline, infinity];
        }
    };
}

// ============================================================================
// §3202(c) — special rule for tips (RRTA)
// ============================================================================

pub relation rrta_tip_estimation_authorized(employer: Person, y: TaxableYear) kind institutional {
    label en official "paragraph (3) applies to the carrier for the year (quarter): the Secretary authorized the estimation of tips under regulations";
}
rule RrtaTipEstimationAuthorizedByRegulation defeasible {
    label en unofficial "the ordinary-rule counterpart of the Secretary's authorization, shared with section 3102(c)(3): the authorization facts are the same";
    for employer: Person;
    for y: TaxableYear;
    when secretary_authorizes_tip_estimation(employer, y)
        and secretary_regulations_authorize_tip_estimation(y);
    then rrta_tip_estimation_authorized(employer, y);
}
pub relation rrta_tip_payment(pay: WagePayment) kind empirical {
    label en unofficial "the wage payment record stands for tips that constitute compensation, deemed paid on the record's date (section 3231(h))";
}
pub relation rrta_tip_deemed_paid_period(pay: WagePayment, period: us.irc.core::Period) kind institutional {
    label en unofficial "the calendar month (quarter, when paragraph (3) applies) in which the tips were deemed paid";
}
rule RrtaTipDeemedPaidMonth defeasible {
    label en unofficial "the calendar month containing the date on which the tips are deemed paid";
    for pay: WagePayment;
    for on: Date;
    for period: us.irc.core::Period;
    for periodBegins: Date;
    for periodEnds: Date;
    when rrta_tip_payment(pay)
        and rrta_tip_deemed_paid_on(pay, on)
        and us.irc.core::period_kind(period, us.irc.core::CalendarMonth)
        and us.irc.core::begins(period, periodBegins)
        and us.irc.core::ends(period, periodEnds)
        and periodBegins <= on
        and on <= periodEnds;
    then rrta_tip_deemed_paid_period(pay, period);
    unless rrta_tip_payment(pay) and rrta_tip_estimation_applies_to_payment(pay) and rrta_tip_deemed_paid_on(pay, on) and us.irc.core::period_kind(period, us.irc.core::CalendarMonth);
}
pub relation rrta_tip_estimation_applies_to_payment(pay: WagePayment) kind institutional {
    label en unofficial "paragraph (3) applies to the carrier of this tip payment for the payment's year";
}
rule RrtaTipEstimationAppliesToPayment defeasible {
    for pay: WagePayment;
    for employer: Person;
    for y: TaxableYear;
    when rrta_tip_payment(pay)
        and wage_payment(pay, employer, _, y, _, _)
        and rrta_tip_estimation_authorized(employer, y);
    then rrta_tip_estimation_applies_to_payment(pay);
}
rule RrtaTipDeemedPaidQuarter defeasible {
    label en unofficial "when paragraph (3) applies the relevant period is the calendar quarter containing the date the tips are deemed paid";
    for pay: WagePayment;
    for on: Date;
    for period: us.irc.core::Period;
    for periodBegins: Date;
    for periodEnds: Date;
    when rrta_tip_estimation_applies_to_payment(pay)
        and rrta_tip_deemed_paid_on(pay, on)
        and us.irc.core::period_kind(period, us.irc.core::CalendarQuarter)
        and us.irc.core::begins(period, periodBegins)
        and us.irc.core::ends(period, periodEnds)
        and periodBegins <= on
        and on <= periodEnds;
    then rrta_tip_deemed_paid_period(pay, period);
}
pub relation rrta_tip_tax_collection_deadline(pay: WagePayment, deadline: Date) kind institutional {
    label en official "the close of the 10th day following the calendar month (or, if paragraph (3) applies, the 30th day following the quarter) in which the tips were deemed paid";
}
@source(IRC_S3202_C, relation = formalizes, coverage = exact, quote = "before the close of the 10th day following the calendar month (or, if paragraph (3) applies, the 30th day following the quarter)")
rule S3202c1DeadlineMonth defeasible {
    label en official "collection window closes on the 10th day after the end of the calendar month in which the tips were deemed paid";
    for pay: WagePayment;
    for period: us.irc.core::Period;
    for periodEnds: Date;
    when rrta_tip_deemed_paid_period(pay, period)
        and us.irc.core::period_kind(period, us.irc.core::CalendarMonth)
        and us.irc.core::ends(period, periodEnds);
    then rrta_tip_tax_collection_deadline(pay, add_calendar_period(periodEnds, 10 calendar_day));
}
@source(IRC_S3202_C, relation = formalizes, coverage = exact, quote = "the 30th day following the quarter")
rule S3202c1DeadlineQuarter defeasible {
    label en official "if paragraph (3) applies the window closes on the 30th day after the end of the calendar quarter";
    for pay: WagePayment;
    for period: us.irc.core::Period;
    for periodEnds: Date;
    when rrta_tip_deemed_paid_period(pay, period)
        and us.irc.core::period_kind(period, us.irc.core::CalendarQuarter)
        and us.irc.core::ends(period, periodEnds);
    then rrta_tip_tax_collection_deadline(pay, add_calendar_period(periodEnds, 30 calendar_day));
}
pub relation rrta_tip_tax_collectible_funds(pay: WagePayment, amount: Money) kind institutional {
    label en official "the compensation (excluding tips) and turned-over funds under the carrier's control at or after the statement and by the close of the window";
}
rule RrtaTipTaxCollectibleFunds defeasible {
    for pay: WagePayment;
    for statementOn: Date;
    for deadline: Date;
    when rrta_tip_payment(pay)
        and rrta_tip_statement_furnished(pay, statementOn)
        and rrta_tip_tax_collection_deadline(pay, deadline);
    then rrta_tip_tax_collectible_funds(pay,
        sum(collect all a: Money, k: TipCollectionFundKind, d: Date
            where tip_collection_fund(pay, k, a, d) and d >= statementOn and d <= deadline,
            empty: 0.00 USD));
}
pub relation rrta_tip_tax_collectible(pay: WagePayment, amount: Money) kind institutional {
    label en official "the part of the section 3201 tax on the statement tips that can be collected: the lesser of the tax and the collectible funds";
}
@source(IRC_S3202_C, relation = formalizes, coverage = exact, quote = "and only to the extent that collection can be made by the employer, at or after the time such statement is so furnished")
rule S3202c1CollectibleAmount defeasible {
    for pay: WagePayment;
    for tax: Money;
    for funds: Money;
    when rrta_tip_payment(pay)
        and rrta_tip_tax_owed(pay, tax)
        and rrta_tip_tax_collectible_funds(pay, funds);
    then rrta_tip_tax_collectible(pay, min(tax, funds));
}
@source(IRC_S3202_C, relation = formalizes, coverage = exact, quote = "subsection (a) shall be applicable only to such tips as are included in a written statement furnished to the employer pursuant to section 6053(a)")
pub rule S3202c1TipDeductionDutyRule defeasible {
    label en official "the duty to deduct the tax on tips is limited to statement tips, in the collectible amount, within the window";
    for pay: WagePayment;
    for employer: Person;
    for statementOn: Date;
    for deadline: Date;
    for collectible: Money;
    when rrta_tip_payment(pay)
        and wage_payment(pay, employer, _, _, _, _)
        and rrta_tip_statement_furnished(pay, statementOn)
        and rrta_tip_tax_collection_deadline(pay, deadline)
        and rrta_tip_tax_collectible(pay, collectible);
    then duty S3202c1TipDeductionDuty {
        bearer employer;
        beneficiary Secretary;
        goal achievement {
            condition rrta_tax_deducted_by_employer(employer, pay, collectible);
            window [statementOn, deadline];
        }
    };
}
pub relation rrta_tip_compensation_excluding_tips_in_window(pay: WagePayment, amount: Money) kind institutional {
    label en unofficial "the compensation (excluding tips) under the carrier's control inside the window";
}
rule RrtaTipCompensationExcludingTipsInWindow defeasible {
    for pay: WagePayment;
    for statementOn: Date;
    for deadline: Date;
    when rrta_tip_payment(pay)
        and rrta_tip_statement_furnished(pay, statementOn)
        and rrta_tip_tax_collection_deadline(pay, deadline);
    then rrta_tip_compensation_excluding_tips_in_window(pay,
        sum(collect all a: Money, d: Date
            where tip_collection_fund(pay, WagesExcludingTips, a, d) and d >= statementOn and d <= deadline,
            empty: 0.00 USD));
}
pub relation rrta_tip_tax_excess_over_compensation(pay: WagePayment, excess: Money) kind institutional {
    label en official "the amount by which the tax on the statement tips exceeds the compensation (excluding tips) from which the carrier is required to collect it";
}
rule S3202c2Excess defeasible {
    for pay: WagePayment;
    for tax: Money;
    for wages: Money;
    when rrta_tip_payment(pay)
        and rrta_tip_tax_owed(pay, tax)
        and rrta_tip_compensation_excluding_tips_in_window(pay, wages)
        and tax > wages;
    then rrta_tip_tax_excess_over_compensation(pay, tax - wages);
}
@source(IRC_S3202_C, relation = formalizes, coverage = exact, quote = "the employee may furnish to the employer on or before the 10th day of the following month (or, if paragraph (3) applies, on or before the 30th day of the following quarter) an amount of money equal to the amount of the excess")
pub rule S3202c2EmployeeMayFurnishFunds defeasible {
    label en official "when the tax on statement tips exceeds the compensation, the employee may furnish the excess by the close of the window";
    for pay: WagePayment;
    for employer: Person;
    for employee: Person;
    for statementOn: Date;
    for deadline: Date;
    for excess: Money;
    when rrta_tip_payment(pay)
        and wage_payment(pay, employer, employee, _, _, _)
        and rrta_tip_statement_furnished(pay, statementOn)
        and rrta_tip_tax_collection_deadline(pay, deadline)
        and rrta_tip_tax_excess_over_compensation(pay, excess);
    then liberty S3202c2FurnishFundsLiberty {
        holder employee;
        against employer;
        action employee_furnishes_tip_tax_funds(employee, employer, pay, excess);
        window [statementOn, deadline];
    };
}
pub relation rrta_tip_estimation_authorization_created(employer: Person, y: TaxableYear) kind institutional {
    label en unofficial "the effect of the Secretary's authorization power (section 3202(c)(3))";
}
@source(IRC_S3202_C, relation = formalizes, coverage = exact, quote = "The Secretary may, under regulations prescribed by him, authorize employers—")
pub rule S3202c3SecretaryMayAuthorizeTipEstimation defeasible {
    label en official "the Secretary may, under regulations, authorize a carrier to estimate tips";
    for employer: Person;
    for y: TaxableYear;
    when secretary_authorizes_tip_estimation(employer, y);
    then power S3202c3AuthorizeTipEstimationPower {
        holder Secretary;
        over employer;
        exercise secretary_authorizes_tip_estimation(employer, y);
        valid_when secretary_regulations_authorize_tip_estimation(y);
        effect create(rrta_tip_estimation_authorization_created(employer, y));
    };
}
pub relation rrta_employer_estimates_tips(employer: Person, employee: Person, quarter: us.irc.core::Period) kind empirical {
    label en official "the carrier estimates the amount of tips that will be reported by the employee in the quarter";
}
pub relation rrta_employer_deducts_as_if_estimated_tips_were_actual(employer: Person, employee: Person, quarter: us.irc.core::Period) kind empirical {
    label en official "the carrier determines the deduction on each payment of compensation (exclusive of tips) during the quarter as if the estimated tips were the actual tips";
}
pub relation rrta_employer_deducts_adjustment_for_tips(employer: Person, employee: Person, quarter: us.irc.core::Period) kind empirical {
    label en official "the carrier deducts, on a payment of compensation during the quarter and within 30 days thereafter, the amount necessary to adjust the deduction to the tax required in respect of statement tips";
}
@source(IRC_S3202_C, relation = formalizes, coverage = exact, quote = "(A) to estimate the amount of tips that will be reported by the employee pursuant to section 6053(a) in any quarter of the calendar year,")
rule S3202c3AEmployerMayEstimateTips defeasible {
    label en official "an authorized carrier may estimate the tips an employee will report in a quarter";
    for employer: Person;
    for employee: Person;
    for y: TaxableYear;
    for quarter: us.irc.core::Period;
    for quarterBegins: Date;
    for quarterEnds: Date;
    when rrta_tip_estimation_authorized(employer, y)
        and employer_of_tipped_employee(employer, employee)
        and us.irc.core::period_kind(quarter, us.irc.core::CalendarQuarter)
        and us.irc.core::begins(quarter, quarterBegins)
        and us.irc.core::ends(quarter, quarterEnds)
        and quarter_in_taxable_year(quarter, y);
    then liberty S3202c3AEstimateTipsLiberty {
        holder employer;
        against employee;
        action rrta_employer_estimates_tips(employer, employee, quarter);
        window [quarterBegins, quarterEnds];
    };
}
pub relation quarter_in_taxable_year(quarter: us.irc.core::Period, y: TaxableYear) kind institutional {
    label en unofficial "the calendar quarter lies inside the taxable year (begins on or after the year's first day and ends on or before its last day)";
}
rule QuarterInTaxableYear defeasible {
    for quarter: us.irc.core::Period;
    for y: TaxableYear;
    for quarterBegins: Date;
    for quarterEnds: Date;
    for yearBegins: Date;
    for yearEnds: Date;
    when us.irc.core::begins(quarter, quarterBegins)
        and us.irc.core::ends(quarter, quarterEnds)
        and us.irc.core::begins(y, yearBegins)
        and us.irc.core::ends(y, yearEnds)
        and quarterBegins >= yearBegins
        and quarterEnds <= yearEnds;
    then quarter_in_taxable_year(quarter, y);
}
@source(IRC_S3202_C, relation = formalizes, coverage = exact, quote = "(B) to determine the amount to be deducted upon each payment of compensation (exclusive of tips) during such quarter as if the tips so estimated constituted actual tips so reported, and")
rule S3202c3BEmployerMayDeductOnEstimate defeasible {
    label en official "an authorized carrier may determine the deduction as if the estimated tips were actual";
    for employer: Person;
    for employee: Person;
    for y: TaxableYear;
    for quarter: us.irc.core::Period;
    for quarterBegins: Date;
    for quarterEnds: Date;
    when rrta_tip_estimation_authorized(employer, y)
        and employer_of_tipped_employee(employer, employee)
        and us.irc.core::period_kind(quarter, us.irc.core::CalendarQuarter)
        and us.irc.core::begins(quarter, quarterBegins)
        and us.irc.core::ends(quarter, quarterEnds)
        and quarter_in_taxable_year(quarter, y);
    then liberty S3202c3BDeductOnEstimateLiberty {
        holder employer;
        against employee;
        action rrta_employer_deducts_as_if_estimated_tips_were_actual(employer, employee, quarter);
        window [quarterBegins, quarterEnds];
    };
}
@source(IRC_S3202_C, relation = formalizes, coverage = exact, quote = "during such quarter (and within 30 days thereafter) such amount as may be necessary to adjust the amount actually deducted")
rule S3202c3CEmployerMayDeductAdjustment defeasible {
    label en official "an authorized carrier may deduct an adjustment during the quarter and within 30 days after it";
    for employer: Person;
    for employee: Person;
    for y: TaxableYear;
    for quarter: us.irc.core::Period;
    for quarterBegins: Date;
    for quarterEnds: Date;
    when rrta_tip_estimation_authorized(employer, y)
        and employer_of_tipped_employee(employer, employee)
        and us.irc.core::period_kind(quarter, us.irc.core::CalendarQuarter)
        and us.irc.core::begins(quarter, quarterBegins)
        and us.irc.core::ends(quarter, quarterEnds)
        and quarter_in_taxable_year(quarter, y);
    then liberty S3202c3CDeductAdjustmentLiberty {
        holder employer;
        against employee;
        action rrta_employer_deducts_adjustment_for_tips(employer, employee, quarter);
        window [quarterBegins, add_calendar_period(quarterEnds, 30 calendar_day)];
    };
}
pub relation rrta_tip_tax_uncollected(pay: WagePayment, excess: Money) kind institutional {
    label en official "the tax on the tips exceeding the portion that can be collected under paragraph (1) or (3)";
}
rule S3202c4Uncollected defeasible {
    for pay: WagePayment;
    for tax: Money;
    for collectible: Money;
    when rrta_tip_payment(pay)
        and rrta_tip_tax_owed(pay, tax)
        and rrta_tip_tax_collectible(pay, collectible)
        and tax > collectible;
    then rrta_tip_tax_uncollected(pay, tax - collectible);
}
pub relation rrta_tip_tax_excess_paid_by_employee(pay: WagePayment, amount: Money) kind empirical {
    label en official "the employee paid the uncollected excess of the tax on tips";
}
@source(IRC_S3202_C, relation = formalizes, coverage = exact, quote = "such excess shall be paid by the employee")
pub rule S3202c4EmployeePaysExcess defeasible {
    label en official "the excess of the tax on tips over the collectible portion shall be paid by the employee";
    for pay: WagePayment;
    for employee: Person;
    for excess: Money;
    for deadline: Date;
    when rrta_tip_payment(pay)
        and wage_payment(pay, _, employee, _, _, _)
        and rrta_tip_tax_uncollected(pay, excess)
        and rrta_tip_tax_collection_deadline(pay, deadline);
    then duty S3202c4EmployeePaysExcessDuty {
        bearer employee;
        beneficiary Secretary;
        goal achievement {
            condition rrta_tip_tax_excess_paid_by_employee(pay, excess);
            window [deadline, infinity];
        }
    };
}

// ============================================================================
// §3402(k) — tips and income tax withholding
// ============================================================================

pub relation tip_income_tax_available_funds(pay: WagePayment, funds: Money) kind institutional {
    label en official "the wages (excluding tips) and turned-over funds under the employer's control from the statement date to the close of the calendar year in which the statement is furnished";
}
rule TipIncomeTaxAvailableFunds defeasible {
    label en unofficial "sum of the funds that came under control from the statement date to the end of the year of the statement";
    for pay: WagePayment;
    for y: TaxableYear;
    for statementOn: Date;
    for yearEnds: Date;
    when tip_payment(pay)
        and wage_payment(pay, _, _, y, _, _)
        and tip_statement_furnished_on(pay, statementOn)
        and us.irc.core::ends(y, yearEnds);
    then tip_income_tax_available_funds(pay,
        sum(collect all a: Money, k: TipCollectionFundKind, d: Date
            where tip_collection_fund(pay, k, a, d) and d >= statementOn and d <= yearEnds,
            empty: 0.00 USD));
}
pub relation tax_required_from_tip_funds_under_fica(pay: WagePayment, amount: Money) kind empirical {
    label en official "the tax required by section 3102(a) or 3202(a) to be collected from the wages and funds from which the withholding on tips is to be made";
}
pub relation tip_income_tax_withholding_ceiling(pay: WagePayment, ceiling: Money) kind institutional {
    label en official "the aggregate of the wages and funds minus the tax required by section 3102(a) or 3202(a) to be collected from them (never below zero)";
}
@source(IRC_S3402_K, relation = formalizes, coverage = exact, quote = "Such tax shall not at any time be deducted and withheld in an amount which exceeds the aggregate of such wages and funds")
rule S3402kCeiling defeasible {
    label en official "the withholding on tips cannot exceed the available wages and funds net of the FICA tax to be collected from them";
    for pay: WagePayment;
    for funds: Money;
    for fica: Money;
    when tip_payment(pay)
        and tip_income_tax_available_funds(pay, funds)
        and tax_required_from_tip_funds_under_fica(pay, fica);
    then tip_income_tax_withholding_ceiling(pay, max(0.00 USD, funds - fica));
}
pub relation tip_income_tax_withholding_amount(pay: WagePayment, amount: Money) kind institutional {
    label en official "the income tax to be deducted and withheld on the statement tips: the amount prescribed by the Secretary, limited to the ceiling";
}
@source(IRC_S3402_K, relation = formalizes, coverage = exact, quote = "and only to the extent that the tax can be deducted and withheld by the employer, at or after the time such statement is so furnished and before the close of the calendar year in which such statement is furnished")
rule S3402kAmount defeasible {
    label en official "withholding on tips only to the extent it can be deducted from the available wages and funds";
    for pay: WagePayment;
    for prescribed: Money;
    for ceiling: Money;
    when tip_payment(pay)
        and secretary_prescribed_withholding_amount(pay, prescribed, _)
        and tip_income_tax_withholding_ceiling(pay, ceiling);
    then tip_income_tax_withholding_amount(pay, min(prescribed, ceiling));
}
@source(IRC_S3402_K, relation = formalizes, coverage = exact, quote = "In the case of tips which constitute wages, subsection (a) shall be applicable only to such tips as are included in a written statement furnished to the employer pursuant to section 6053(a)")
pub rule S3402kTipWithholdingDutyRule defeasible {
    label en official "the duty to withhold on tips applies only to statement tips, in the deductible amount, before the close of the year of the statement";
    for pay: WagePayment;
    for employer: Person;
    for y: TaxableYear;
    for statementOn: Date;
    for yearEnds: Date;
    for amount: Money;
    when tip_payment(pay)
        and wage_payment(pay, employer, _, y, _, _)
        and tip_statement_furnished_on(pay, statementOn)
        and us.irc.core::ends(y, yearEnds)
        and tip_income_tax_withholding_amount(pay, amount);
    then duty S3402kTipWithholdingDuty {
        bearer employer;
        beneficiary Secretary;
        goal achievement {
            condition income_tax_withheld(pay, amount);
            window [statementOn, yearEnds];
        }
    };
}
pub relation tip_statement_month_total(pay: WagePayment, total: Money) kind empirical {
    label en official "the total amount of the tips included in the statements furnished to the employer as received in the calendar month in the course of employment by the employer";
}
pub relation employer_withholds_on_tips_below_twenty_dollars(employer: Person, pay: WagePayment) kind empirical {
    label en official "the employer deducts and withholds the tax on tips from wages (excluding tips) under his control although the month's statement total is less than $20";
}
@source(IRC_S3402_K, relation = formalizes, coverage = exact, quote = "may deduct and withhold the tax with respect to such tips from any wages of the employee (excluding tips) under his control, even though at the time such statement is furnished the total amount of the tips included in statements furnished to the employer as having been received by the employee in such calendar month in the course of his employment by such employer is less than $20")
rule S3402kBelowTwentyDollarsLiberty defeasible {
    label en official "the employer may withhold on tips although the monthly statement total is below $20 (tips to which section 3401(a)(16)(B) applies)";
    for pay: WagePayment;
    for employer: Person;
    for employee: Person;
    for y: TaxableYear;
    for statementOn: Date;
    for yearEnds: Date;
    for total: Money;
    when tip_payment(pay)
        and wage_payment(pay, employer, employee, y, _, _)
        and tip_statement_furnished_on(pay, statementOn)
        and tip_statement_month_total(pay, total)
        and total < 20.00 USD
        and us.irc.core::ends(y, yearEnds);
    then liberty S3402kWithholdBelowTwentyLiberty {
        holder employer;
        against employee;
        action employer_withholds_on_tips_below_twenty_dollars(employer, pay);
        window [statementOn, yearEnds];
    };
}
pub relation tip_income_tax_actually_withheld(pay: WagePayment, amount: Money) kind empirical {
    label en official "the income tax the employer in fact deducted and withheld on the tips";
}
pub relation employer_withheld_tip_tax_over_ceiling(employer: Person, pay: WagePayment) kind institutional {
    label en unofficial "the amount withheld on tips exceeds the ceiling (the prohibited act, derived from the amounts)";
}
rule EmployerWithheldTipTaxOverCeiling defeasible {
    for pay: WagePayment;
    for employer: Person;
    for withheld: Money;
    for ceiling: Money;
    when tip_payment(pay)
        and wage_payment(pay, employer, _, _, _, _)
        and tip_income_tax_actually_withheld(pay, withheld)
        and tip_income_tax_withholding_ceiling(pay, ceiling)
        and withheld > ceiling;
    then employer_withheld_tip_tax_over_ceiling(employer, pay);
}
@source(IRC_S3402_K, relation = formalizes, coverage = exact, quote = "Such tax shall not at any time be deducted and withheld in an amount which exceeds the aggregate of such wages and funds")
pub rule S3402kNoWithholdingOverCeiling defeasible {
    label en official "the tax shall not be deducted and withheld in an amount exceeding the wages and funds minus the FICA tax to be collected from them";
    for employer: Person;
    for pay: WagePayment;
    when employer_withheld_tip_tax_over_ceiling(employer, pay);
    then prohibition S3402kOverCeilingProhibition {
        bearer employer;
        action employer_withheld_tip_tax_over_ceiling(employer, pay);
        window [-infinity, infinity];
    };
}

// ============================================================================
// §3241(d) — the Secretary's notice of the section 3241 rates
// ============================================================================

pub relation section_3241_notice_published_on(y: TaxableYear, on: Date) kind empirical {
    label en official "the Secretary published in the Federal Register the notice of the rates of tax determined under section 3241 applicable for the calendar year following the calendar year y, on this date";
}
pub relation section_3241_notice_calendar_year(y: TaxableYear) kind empirical {
    label en unofficial "the calendar year y in which the notice of the rates for the following year is due (by December 1 of y)";
}
pub relation section_3241_notice_timely(y: TaxableYear) kind institutional {
    label en official "the notice of the rates for the following calendar year was published no later than December 1 of the calendar year y";
}
rule S3241dNoticeTimely defeasible {
    label en official "published on or before December 1 (the first day of the calendar year plus 11 months)";
    for y: TaxableYear;
    for yearBegins: Date;
    for publishedOn: Date;
    when section_3241_notice_published_on(y, publishedOn)
        and us.irc.core::begins(y, yearBegins)
        and publishedOn <= add_calendar_period(yearBegins, 11 calendar_month);
    then section_3241_notice_timely(y);
}
@source(IRC_S3241_D, relation = formalizes, coverage = exact, quote = "No later than December 1 of each calendar year, the Secretary shall publish a notice in the Federal Register of the rates of tax determined under this section which are applicable for the following calendar year.")
pub rule S3241dNoticeDuty defeasible {
    label en official "by December 1 of each calendar year the Secretary shall publish the notice of the section 3241 rates applicable for the following calendar year";
    for y: TaxableYear;
    for yearBegins: Date;
    when section_3241_notice_calendar_year(y)
        and us.irc.core::begins(y, yearBegins);
    then duty S3241dFederalRegisterNoticeDuty {
        bearer Secretary;
        goal achievement {
            condition section_3241_notice_timely(y);
            window [yearBegins, add_calendar_period(yearBegins, 11 calendar_month)];
        }
    };
}

// ============================================================================
// §3127(b), (c) — approval of the religious exemption and its effective period
// ============================================================================

pub entity ExemptionApplication3127 {
    label en unofficial "an application for exemption filed under section 3127(a)";
}
pub const CommissionerOfSocialSecurity: Organ = entity_ref("urn:us:irc:employment:clir#commissioner-of-social-security") {
    label en unofficial "the Commissioner of Social Security";
}
pub relation exemption_application_by(app: ExemptionApplication3127, applicant: Person) kind empirical {
    label en official "the application is filed by the employer (a partner) under subsection (a)(1) or by the employee under subsection (a)(2)";
}
pub relation exemption_application_filed_on(app: ExemptionApplication3127, filedOn: Date) kind empirical {
    label en official "the date on which the application is filed";
}
pub relation application_has_1402g1_evidence_and_waiver(app: ExemptionApplication3127) kind empirical {
    label en official "the application contains or is accompanied by the evidence described in section 1402(g)(1)(A) and a waiver described in section 1402(g)(1)(B)";
}
pub relation commissioner_made_1402g1_findings(app: ExemptionApplication3127) kind empirical {
    label en official "the Commissioner of Social Security makes, with respect to the sect or division, the findings described in section 1402(g)(1)(C), (D), and (E)";
}
pub relation benefit_became_payable_before_filing(app: ExemptionApplication3127) kind empirical {
    label en official "a benefit or other payment referred to in section 1402(g)(1)(B) became payable (or, but for section 203 of the Social Security Act, would have become payable) to the individual filing the application at or before the time of filing";
}
pub relation section_3127b_conditions_met(app: ExemptionApplication3127) kind institutional {
    label en official "the three conditions of subsection (b) for approving the application are met";
}
@source(IRC_S3127_B, relation = formalizes, coverage = exact, quote = "An application for exemption filed by an employer (or a partner) under subsection (a)(1) or by an employee under subsection (a)(2) shall be approved only if—")
rule S3127bConditionsMet defeasible {
    label en official "evidence and waiver, Commissioner's findings, and no benefit payable at or before filing";
    for app: ExemptionApplication3127;
    when application_has_1402g1_evidence_and_waiver(app)
        and commissioner_made_1402g1_findings(app)
        and not_known(benefit_became_payable_before_filing(app));
    then section_3127b_conditions_met(app);
}
pub relation exemption_application_approved(app: ExemptionApplication3127) kind empirical {
    label en official "the Commissioner approves the application";
}
pub relation section_3127_approval_created(app: ExemptionApplication3127) kind institutional {
    label en unofficial "the effect of the Commissioner's approval power (subsection (b))";
}
pub relation section_3127_application_approval_effective(app: ExemptionApplication3127) kind institutional {
    label en official "the application is approved under subsection (b): approved by the Commissioner and all three conditions are met";
}
rule S3127bApprovalEffective defeasible {
    label en unofficial "the ordinary-rule counterpart of the approval power, consumed by subsection (c)";
    for app: ExemptionApplication3127;
    when exemption_application_approved(app)
        and section_3127b_conditions_met(app);
    then section_3127_application_approval_effective(app);
}
@source(IRC_S3127_B, relation = formalizes, coverage = exact, quote = "shall be approved only if")
pub rule S3127bApprovalPower defeasible {
    label en official "the application may be approved only if the three conditions of subsection (b) are met (an approval without them is an invalid exercise)";
    for app: ExemptionApplication3127;
    for applicant: Person;
    when exemption_application_by(app, applicant)
        and exemption_application_approved(app);
    then power S3127bApprovalOfApplicationPower {
        holder CommissionerOfSocialSecurity;
        over applicant;
        exercise exemption_application_approved(app);
        valid_when section_3127b_conditions_met(app);
        effect create(section_3127_approval_created(app));
    };
}
// (c): the effective period, computed from calendar-quarter Periods.
pub relation requirements_3127_met_throughout_quarter(applicant: Person, quarter: us.irc.core::Period) kind empirical {
    label en official "the employer (each partner) or employee meets the applicable requirements of subsections (a) and (b) throughout the calendar quarter";
}
pub relation fails_3127a_requirements_in_quarter(applicant: Person, quarter: us.irc.core::Period) kind empirical {
    label en official "the employer (any partner) or the employee does not meet the applicable requirements of subsection (a) in the calendar quarter";
}
pub relation sect_found_to_have_ceased_3127b2_in_quarter(applicant: Person, quarter: us.irc.core::Period) kind empirical {
    label en official "the sect or division is found by the Commissioner to have ceased to meet the requirements of subsection (b)(2) in the calendar quarter";
}
pub relation exemption_start_candidate(app: ExemptionApplication3127, start: Date) kind institutional {
    label en unofficial "the first day of a calendar quarter after the filing throughout which the applicant meets the requirements";
}
@source(IRC_S3127_C, relation = formalizes, coverage = exact, quote = "(1) commencing with the first day of the first calendar quarter, after the quarter in which such application is filed, throughout which such employer (or, if the employer is a partnership, each partner therein) or employee meets the applicable requirements specified in subsections (a) and (b), and")
rule S3127c1StartCandidate defeasible {
    label en official "a candidate start: the first day of a quarter beginning after the filing date and met throughout";
    for app: ExemptionApplication3127;
    for applicant: Person;
    for filedOn: Date;
    for quarter: us.irc.core::Period;
    for quarterBegins: Date;
    when exemption_application_by(app, applicant)
        and exemption_application_filed_on(app, filedOn)
        and section_3127_application_approval_effective(app)
        and us.irc.core::period_kind(quarter, us.irc.core::CalendarQuarter)
        and us.irc.core::begins(quarter, quarterBegins)
        and quarterBegins > filedOn
        and requirements_3127_met_throughout_quarter(applicant, quarter);
    then exemption_start_candidate(app, quarterBegins);
}
pub relation earlier_exemption_start_candidate_exists(app: ExemptionApplication3127, start: Date) kind institutional {
    label en unofficial "a strictly earlier candidate exists (the latest/earliest-of-several pattern, TECH-GAPS G136)";
}
rule EarlierExemptionStartCandidateExists defeasible {
    for app: ExemptionApplication3127;
    for c1: Date;
    for c2: Date;
    when exemption_start_candidate(app, c1)
        and exemption_start_candidate(app, c2)
        and c2 < c1;
    then earlier_exemption_start_candidate_exists(app, c1);
}
pub relation exemption_effective_from(app: ExemptionApplication3127, start: Date) kind institutional {
    label en official "the exemption applies to wages paid from this day: the first day of the first qualifying calendar quarter after the quarter of filing";
}
rule S3127c1EffectiveFrom defeasible {
    label en official "the earliest candidate start";
    for app: ExemptionApplication3127;
    for start: Date;
    when exemption_start_candidate(app, start)
        and not_known(earlier_exemption_start_candidate_exists(app, start));
    then exemption_effective_from(app, start);
}
pub relation exemption_end_candidate(app: ExemptionApplication3127, endsOn: Date) kind institutional {
    label en unofficial "the last day of the quarter preceding a later quarter in which the applicant fails subsection (a) or the sect is found to have ceased to meet (b)(2)";
}
@source(IRC_S3127_C, relation = formalizes, coverage = exact, quote = "(2) ending with the last day of the calendar quarter preceding the first calendar quarter thereafter in which (A) such employer (or, if the employer is a partnership, any partner therein) or the employee involved does not meet the applicable requirements of subsection (a)")
rule S3127c2EndCandidateFailure defeasible {
    label en official "a later quarter in which the applicant does not meet subsection (a): the exemption ends with the previous quarter's last day";
    for app: ExemptionApplication3127;
    for applicant: Person;
    for start: Date;
    for failQuarter: us.irc.core::Period;
    for failBegins: Date;
    for prevQuarter: us.irc.core::Period;
    for prevEnds: Date;
    when exemption_application_by(app, applicant)
        and exemption_effective_from(app, start)
        and fails_3127a_requirements_in_quarter(applicant, failQuarter)
        and us.irc.core::begins(failQuarter, failBegins)
        and failBegins > start
        and us.irc.core::period_kind(prevQuarter, us.irc.core::CalendarQuarter)
        and us.irc.core::ends(prevQuarter, prevEnds)
        and add_calendar_period(prevEnds, 1 calendar_day) == failBegins;
    then exemption_end_candidate(app, prevEnds);
}
@source(IRC_S3127_C, relation = formalizes, coverage = exact, quote = "or (B) the sect or division thereof of which such employer (or, if the employer is a partnership, any partner therein) or employee is a member is found by the Commissioner of Social Security to have ceased to meet the requirements of subsection (b)(2).")
rule S3127c2EndCandidateSectCeased defeasible {
    label en official "a later quarter in which the sect is found to have ceased to meet (b)(2): the exemption ends with the previous quarter's last day";
    for app: ExemptionApplication3127;
    for applicant: Person;
    for start: Date;
    for ceasedQuarter: us.irc.core::Period;
    for ceasedBegins: Date;
    for prevQuarter: us.irc.core::Period;
    for prevEnds: Date;
    when exemption_application_by(app, applicant)
        and exemption_effective_from(app, start)
        and sect_found_to_have_ceased_3127b2_in_quarter(applicant, ceasedQuarter)
        and us.irc.core::begins(ceasedQuarter, ceasedBegins)
        and ceasedBegins > start
        and us.irc.core::period_kind(prevQuarter, us.irc.core::CalendarQuarter)
        and us.irc.core::ends(prevQuarter, prevEnds)
        and add_calendar_period(prevEnds, 1 calendar_day) == ceasedBegins;
    then exemption_end_candidate(app, prevEnds);
}
pub relation earlier_exemption_end_candidate_exists(app: ExemptionApplication3127, endsOn: Date) kind institutional {
    label en unofficial "a strictly earlier end candidate exists";
}
rule EarlierExemptionEndCandidateExists defeasible {
    for app: ExemptionApplication3127;
    for c1: Date;
    for c2: Date;
    when exemption_end_candidate(app, c1)
        and exemption_end_candidate(app, c2)
        and c2 < c1;
    then earlier_exemption_end_candidate_exists(app, c1);
}
pub relation exemption_effective_until(app: ExemptionApplication3127, endsOn: Date) kind institutional {
    label en official "the exemption ends with this day: the last day of the quarter preceding the first later quarter of failure";
}
rule S3127c2EffectiveUntil defeasible {
    label en official "the earliest end candidate";
    for app: ExemptionApplication3127;
    for endsOn: Date;
    when exemption_end_candidate(app, endsOn)
        and not_known(earlier_exemption_end_candidate_exists(app, endsOn));
    then exemption_effective_until(app, endsOn);
}
pub relation section_3127_exemption_covers_wages_paid(app: ExemptionApplication3127, paidOn: Date) kind institutional {
    label en official "wages paid by the employer on this date fall within the period of the exemption";
}
@source(IRC_S3127_C, relation = formalizes, coverage = exact, quote = "shall apply with respect to wages paid by such employer during the period—")
rule S3127cWagesInsidePeriod defeasible {
    label en official "wages paid from the effective day through the end day (or with no end day, from the effective day on) are covered";
    for app: ExemptionApplication3127;
    for pay: WagePayment;
    for applicant: Person;
    for start: Date;
    for endsOn: Date;
    for paidOn: Date;
    when exemption_application_by(app, applicant)
        and wage_payment(pay, applicant, _, _, _, paidOn)
        and exemption_effective_from(app, start)
        and exemption_effective_until(app, endsOn)
        and paidOn >= start
        and paidOn <= endsOn;
    then section_3127_exemption_covers_wages_paid(app, paidOn);
}
rule S3127cWagesAfterStartNoEnd defeasible {
    label en official "with no ending event the exemption covers wages paid from the effective day on";
    for app: ExemptionApplication3127;
    for pay: WagePayment;
    for applicant: Person;
    for start: Date;
    for paidOn: Date;
    when exemption_application_by(app, applicant)
        and wage_payment(pay, applicant, _, _, _, paidOn)
        and exemption_effective_from(app, start)
        and paidOn >= start
        and not_known(exemption_has_end(app));
    then section_3127_exemption_covers_wages_paid(app, paidOn);
}
relation exemption_has_end(app: ExemptionApplication3127) kind institutional;
rule ExemptionHasEnd defeasible {
    for app: ExemptionApplication3127;
    for endsOn: Date;
    when exemption_effective_until(app, endsOn);
    then exemption_has_end(app);
}
