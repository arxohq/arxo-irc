// Chapter 21 (FICA), sections 3122-3128 "as far as executable" (task scope).
//
// Sections 3122 (federal service), 3125 (state/Guam/American Samoa/DC
// governmental returns), 3126 (governmental employer return/payment) are
// ADMINISTRATIVE DESIGNATION provisions: they let the head of an agency (or a
// designated agent) be the one who files the return and pays the tax on
// behalf of the government employer, and relieve that filer from the
// contribution-and-benefit-base bookkeeping burden the ordinary successor-
// employer rule would otherwise impose. None of them changes WHO owes the
// tax or the tax's amount (already modelled in `01-fica-tax.law`) — they
// reassign WHO may perform the government's own filing duty, which is an
// institutional-capacity fact this package does not need to compute to
// answer "was section 3101/3111 satisfied". classification = NON_NORMATIVE
// for the filing-designation mechanics; the one substantive point each makes
// (contribution-and-benefit-base disregarded for administrative convenience)
// is captured below as a narrow immunity.



use self::{
    IRC_S3122,
    IRC_S3123,
    IRC_S3124,
    IRC_S3125_A,
    IRC_S3127_A,
    Person,
    TaxableYear,
    WagePayment,
    fica_employer_tax_owed,
    wage_payment,
};

// --- Section 3122: federal service -------------------------------------------
//
// Substantive point: the government's filer "may...make payments of the tax
// imposed under section 3111...without regard to the contribution and
// benefit base limitation in section 3121(a)(1), and he shall not be
// required to obtain a refund of the tax paid under section 3111 on that
// part of the remuneration not included in wages by reason of section
// 3121(a)(1)." This is a PERMISSION (liberty of the filer's own conduct: pay
// more than strictly owed) plus an immunity from the ordinary refund duty —
// modelled as an immunity of the filer against a hypothetical
// overpayment-refund claim.
relation government_agency_paid_3111_disregarding_wage_base(employer: Person, on: Date) kind empirical {
    label en unofficial "the government agency's filer, under section 3122, paid section 3111 tax without regard to the section 3121(a)(1) wage-base cap for this payment date (case fact)";
}
@source(IRC_S3122, relation = formalizes, coverage = partial, quote = "he shall not be required to obtain a refund of the tax paid under section 3111 on that part of the remuneration not included in wages by reason of section 3121(a)(1)")
rule Section3122RefundImmunity(employer: Person, on: Date) strict {
    when government_agency_paid_3111_disregarding_wage_base(employer, on);
    then immunity Section3122NoRefundDutyImmunity {
        holder employer;
        protected_effect duty_to_seek_3111_overpayment_refund(employer, on);
        window [on, infinity);
    };
}
relation duty_to_seek_3111_overpayment_refund(employer: Person, on: Date) kind institutional {
    label en unofficial "the protected effect: an ordinary duty to seek a refund of tax paid on remuneration excluded from wages by section 3121(a)(1) (never itself asserted true here)";
}
// The remainder of section 3122 (who counts as "head of the Federal agency",
// uniformed-service appropriations funding the payment, Exchange Service/
// Coast Guard Exchange special designations) is administrative-capacity
// detail: NON_NORMATIVE.

// --- Section 3123: deductions as constructive payments -----------------------

pub relation deducted_and_remitted_by_employer(employer: Person, employee: Person, amount: Money, on: Date) kind empirical {
    label en official "an amount an employer deducted from an employee's remuneration and paid over to the United States, a State, or a political subdivision under a legal requirement or permission other than this chapter (case fact)";
}
@source(IRC_S3123, relation = formalizes, coverage = exact, quote = "the amount so deducted shall be considered to have been paid to the employee at the time of such deduction")
pub relation constructively_paid_to_employee_3123(employee: Person, amount: Money, on: Date) kind institutional {
    label en official "an amount deemed paid to the employee, for FICA purposes, at the time of the section 3123 deduction";
}
rule Section3123ConstructivePayment(employer: Person, employee: Person, amount: Money, on: Date) strict {
    when deducted_and_remitted_by_employer(employer, employee, amount, on);
    then constructively_paid_to_employee_3123(employee, amount, on);
}

// --- Section 3124: estimate of revenue reduction ----------------------------
//
// A duty of the Secretary to the Congress (reporting on the revenue effect of
// section 3121(b)(9), the RRTA carve-out) "at intervals of not longer than 3
// years": a periodic reporting duty with no identified beneficiary this
// package can observe compliance against from case facts (the AGENT-BRIEF's
// «recurring» caution: modelled as `maintenance`, not silently dropped).
@source(IRC_S3124, relation = formalizes, coverage = exact, quote = "The Secretary at intervals of not longer than 3 years shall estimate the reduction in the amount of taxes collected under this chapter by reason of the operation of section 3121(b)(9) and shall include such estimate in his annual report.")
relation section_3121b9_revenue_estimate_included(report: us.irc.core::Person, within_3_years_of: Date) kind empirical {
    label en unofficial "case fact standing in for 'the Secretary's report'; this package has no Report entity, so the duty below is recorded for coverage completeness and left TECH_GAP for a real institutional-report shape";
}
// TECH_GAP: modelled as a comment only (no `duty` block): a periodic
// (`recurring`, per AGENT-BRIEF reserved-but-unparsed) obligation without a
// beneficiary this package can name is not expressible as an achievement or
// maintenance goal without inventing a beneficiary or a report entity.

// --- Section 3125: governmental returns (States, Guam, American Samoa, DC) -
//
// Same substantive point as section 3122, restated for State/Guam/American
// Samoa/DC government employers.
@source(IRC_S3125_A, relation = formalizes, coverage = partial, quote = "The person making such return may, for convenience of administration, make payments of the tax imposed under section 3111 with respect to the service of such individuals without regard to the contribution and benefit base limitation in section 3121(a)(1).")
rule Section3125StateRefundImmunity(employer: Person, on: Date) strict {
    when government_agency_paid_3111_disregarding_wage_base(employer, on);
    then immunity Section3125NoRefundDutyImmunity {
        holder employer;
        protected_effect duty_to_seek_3111_overpayment_refund(employer, on);
        window [on, infinity);
    };
}
// (b) Guam, (c) American Samoa, (d) District of Columbia repeat the identical
// substantive point for their own governmental filer; captured by the same
// case fact and the same immunity rule above (one classification, four
// paragraphs) rather than four duplicate rules.

// --- Section 3126: return and payment by governmental employer -------------
//
// Pure filing-designation permission (who among the State/subdivision's
// officers or employees may file): NON_NORMATIVE — no separate substantive
// point beyond section 3125's.

// --- Section 3127: religious exemption --------------------------------------
//
// An employer AND its employee, both members of a recognized religious sect
// opposed to Social Security participation, may each obtain an exemption
// (employer from section 3111, employee from section 3101) by filing and
// having approved an application under the conditions of subsection (b).
// Modelled as a per-payment IMMUNITY (holder's own tax obligation on THIS
// wage payment is the protected effect), the same shape as the section
// 3111(c) totalization-agreement immunity in `01-fica-tax.law`, rather than a
// `power`/`effect` pair: section 3127 does not create or change a legal
// relation on exercise, it blocks one that would otherwise arise — an
// immunity is the correct modality (rights-positions.md: "protection from a
// state act" / here, from the tax itself).
relation religious_sect_member_meeting_1402g1(p: Person) kind empirical {
    label en unofficial "this person is a member of a recognized religious sect described in section 1402(g)(1), adherent to its tenets (case fact; cross-references self-employment tax chapter 2, not owned by this package)";
}
relation religious_exemption_application_approved(p: Person, effective_from: Date) kind empirical {
    label en unofficial "the Commissioner of Social Security approved this person's (or partner's) section 3127 exemption application, effective from the stated calendar-quarter boundary (case fact — the section 3127(b) approval findings are the Commissioner's own institutional act, not re-derived here). The section 3127(c) effective-period computation (quarter boundaries, loss of eligibility) is a TECH_GAP: this relation takes the effective start directly as a case fact rather than deriving it from a filing date.";
}
@source(IRC_S3127_A, relation = formalizes, coverage = partial, quote = "such employer shall be exempt from the taxes imposed by section 3111 with respect to wages paid to each of the employees thereof who meets the requirements of paragraph (2)")
rule Section3127EmployerExemptionImmunity(pay: WagePayment, employer: Person, employee: Person, on: Date, effectiveFrom: Date) strict {
    when wage_payment(pay, employer, employee, _, _, on)
        and religious_sect_member_meeting_1402g1(employer)
        and religious_sect_member_meeting_1402g1(employee)
        and religious_exemption_application_approved(employer, effectiveFrom)
        and religious_exemption_application_approved(employee, effectiveFrom)
        and on >= effectiveFrom;
    then immunity Section3127EmployerExemption {
        holder employer;
        protected_effect fica_employer_tax_owed(employer, pay);
        window [effectiveFrom, infinity);
    };
}
@source(IRC_S3127_A, relation = formalizes, coverage = partial, quote = "each such employee shall be exempt from the taxes imposed by section 3101 with respect to such wages paid to him by such employer")
rule Section3127EmployeeExemptionImmunity(pay: WagePayment, employer: Person, employee: Person, on: Date, effectiveFrom: Date) strict {
    when wage_payment(pay, employer, employee, _, _, on)
        and religious_sect_member_meeting_1402g1(employer)
        and religious_sect_member_meeting_1402g1(employee)
        and religious_exemption_application_approved(employer, effectiveFrom)
        and religious_exemption_application_approved(employee, effectiveFrom)
        and on >= effectiveFrom;
    then immunity Section3127EmployeeExemption {
        holder employee;
        protected_effect fica_employee_tax_owed_3101(employee, pay);
        window [effectiveFrom, infinity);
    };
}
relation fica_employee_tax_owed_3101(employee: Person, pay: WagePayment) kind institutional {
    label en unofficial "the protected effect of the section 3127 employee immunity: liability for the section 3101 tax on this payment (never itself asserted true here, mirroring `fica_employer_tax_owed` in `01-fica-tax.law`)";
}

// --- Section 3128: short title ----------------------------------------------
// "This chapter may be cited as the 'Federal Insurance Contributions Act.'"
// classification = NON_NORMATIVE (naming provision, no rule of conduct).
