        assert outside_basis_decrease_loss_share(entity_ref("urn:test:s4p:d1#p"), entity_ref("urn:test:s4p:d1#ps"), entity_ref("urn:test:s4p:d1#y"), 0 USD) { id "f4"; origin case_input; }
        assert outside_basis_decrease_nondeductible_noncapital_expenditures(entity_ref("urn:test:s4p:d1#p"), entity_ref("urn:test:s4p:d1#ps"), entity_ref("urn:test:s4p:d1#y"), 0 USD) { id "f5"; origin case_input; }
        assert us.irc.core::ownership_interest(entity_ref("urn:test:s4p:d1#oi"), entity_ref("urn:test:s4p:d1#p"), entity_ref("urn:test:s4p:d1#ps"), 0.25) { id "f6"; origin case_input; }
