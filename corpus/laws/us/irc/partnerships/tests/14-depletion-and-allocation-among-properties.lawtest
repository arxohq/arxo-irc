        assert us.irc.core::ownership_interest(entity_ref("urn:test:s4p:d3#oi"), entity_ref("urn:test:s4p:d3#p"), entity_ref("urn:test:s4p:d3#ps"), 0.25) { id "f6"; origin case_input; }
