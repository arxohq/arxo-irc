    }
    // the partner (25 percent) has depletion 12500 over basis 10000: excess 2500; 10000 + 2000 + 2500
    evaluate truth(outside_basis_end(entity_ref("urn:test:s4p:d1#p"), entity_ref("urn:test:s4p:d1#ps"), entity_ref("urn:test:s4p:d1#y"), 14500 USD));
    expect truth_status == TRUE_ONLY;
}

