// Stage 4 (26.09.2026): section 705(a)(1)(C), (a)(3) (depletion, read from us.irc.accounting), section 731(c)(4)(B), section 732(c) over any number of properties, section 732(f)(3)(B), (f)(7), section 755(b) (module 14-depletion-and-allocation-among-properties.law). NOT EXECUTED (implemented_unverified). Expectations come from the statutory text; allocated amounts are rounded to cents.

language "law.core" version "0.2";
package us.irc.partnerships version "0.1.1";
namespace "urn:us:irc:partnerships:clir";

test "S705-DEP-01-NO-DEPLETION-FACTS-BASIS-UNCHANGED-BY-THE-NEW-TERMS" {
    given {
        context { decision_time @2026-12-31T09:00:00-05:00; knowledge_time @2026-12-31T09:00:00-05:00; legal_time @2026-12-31; timezone "America/New_York"; }
        assert outside_basis_start(entity_ref("urn:test:s4p:d0#p"), entity_ref("urn:test:s4p:d0#ps"), entity_ref("urn:test:s4p:d0#y"), 10000 USD) { id "f0"; origin case_input; }
        assert outside_basis_increase_taxable_income_share(entity_ref("urn:test:s4p:d0#p"), entity_ref("urn:test:s4p:d0#ps"), entity_ref("urn:test:s4p:d0#y"), 2000 USD) { id "f1"; origin case_input; }
        assert outside_basis_increase_exempt_income_share(entity_ref("urn:test:s4p:d0#p"), entity_ref("urn:test:s4p:d0#ps"), entity_ref("urn:test:s4p:d0#y"), 0 USD) { id "f2"; origin case_input; }
        assert outside_basis_decrease_distributions(entity_ref("urn:test:s4p:d0#p"), entity_ref("urn:test:s4p:d0#ps"), entity_ref("urn:test:s4p:d0#y"), 0 USD) { id "f3"; origin case_input; }
        assert outside_basis_decrease_loss_share(entity_ref("urn:test:s4p:d0#p"), entity_ref("urn:test:s4p:d0#ps"), entity_ref("urn:test:s4p:d0#y"), 0 USD) { id "f4"; origin case_input; }
        assert outside_basis_decrease_nondeductible_noncapital_expenditures(entity_ref("urn:test:s4p:d0#p"), entity_ref("urn:test:s4p:d0#ps"), entity_ref("urn:test:s4p:d0#y"), 0 USD) { id "f5"; origin case_input; }
        assert us.irc.core::ownership_interest(entity_ref("urn:test:s4p:d0#oi"), entity_ref("urn:test:s4p:d0#p"), entity_ref("urn:test:s4p:d0#ps"), 0.25) { id "f6"; origin case_input; }
    }
    // the depletion terms are zero: 10000 + 2000
    evaluate truth(outside_basis_end(entity_ref("urn:test:s4p:d0#p"), entity_ref("urn:test:s4p:d0#ps"), entity_ref("urn:test:s4p:d0#y"), 12000 USD));
    expect truth_status == TRUE_ONLY;
}

