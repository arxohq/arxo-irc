        assert section_755b_class_adjustment(entity_ref("urn:test:s4p:p6#t"), entity_ref("urn:test:s4p:p6#ps"), OtherPartnershipProperty, 5000 USD) { id "f0"; origin case_input; }
        assert section_755_property_class(entity_ref("urn:test:s4p:p6#K"), OtherPartnershipProperty) { id "f1"; origin case_input; }
        assert section_755_allocated_adjustment(entity_ref("urn:test:s4p:p6#t"), entity_ref("urn:test:s4p:p6#ps"), entity_ref("urn:test:s4p:p6#K"), 2000 USD) { id "f2"; origin case_input; }
    }
    evaluate truth(section_755b_unapplied_adjustment(entity_ref("urn:test:s4p:p6#t"), entity_ref("urn:test:s4p:p6#ps"), OtherPartnershipProperty, 3000 USD));
    expect truth_status == TRUE_ONLY;
}
