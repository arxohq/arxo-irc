    evaluate truth(outside_basis_end(entity_ref("urn:test:s4p:d3#p"), entity_ref("urn:test:s4p:d3#ps"), entity_ref("urn:test:s4p:d3#y"), 2000 USD));
    expect truth_status == TRUE_ONLY;
}

