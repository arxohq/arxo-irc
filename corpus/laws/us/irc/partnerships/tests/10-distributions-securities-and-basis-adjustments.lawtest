// Scenarios for 26 U.S.C. §731(c)(3)-(6), §732(c)-(d),(f), §734(b),(d),
// §735, §755, package us.irc.partnerships, module
// 10-distributions-securities-and-basis-adjustments.law. Written from the
// text; NOT executed in this stage — `implemented_unverified` per
// AGENT-BRIEF.md.

language "law.core" version "0.2";
package us.irc.partnerships version "0.1.1";
namespace "urn:us:irc:partnerships:clir";

// --- §731(c)(3): exceptions and the (c)(3)(B) limitation --------------------

test "S731c3-01-CONTRIBUTED-BY-DISTRIBUTEE-EXCEPTION-BLOCKS-MONEY-TREATMENT" {
    given {
        context { decision_time @2027-06-01T09:00:00-04:00; knowledge_time @2027-06-01T09:00:00-04:00; legal_time @2027-06-01; timezone "America/New_York"; }
        assert marketable_security_distributed(entity_ref("urn:...#T1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#P1"), 20000 USD) { id "f0"; origin case_input; }
        assert marketable_security_distributed_property(entity_ref("urn:...#T1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#P1"), entity_ref("urn:...#SEC1")) { id "f1"; origin case_input; }
        assert section_731c_security_contributed_by_distributee(entity_ref("urn:...#T1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#P1"), entity_ref("urn:...#SEC1")) { id "f2"; origin case_input; }
    }
    evaluate truth(section_731c_exception_applies(entity_ref("urn:...#T1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#P1"), entity_ref("urn:...#SEC1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(section_731c_money_treated_amount(entity_ref("urn:...#T1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#P1"), entity_ref("urn:...#SEC1"), 20000 USD));
    expect truth_status == NEITHER;
}

test "S731c3B-01-LIMITATION-REDUCES-AMOUNT-TAKEN-INTO-ACCOUNT" {
    given {
        context { decision_time @2027-06-01T09:00:00-04:00; knowledge_time @2027-06-01T09:00:00-04:00; legal_time @2027-06-01; timezone "America/New_York"; }
        assert marketable_security_distributed(entity_ref("urn:...#T2"), entity_ref("urn:...#PS2"), entity_ref("urn:...#P2"), 20000 USD) { id "f0"; origin case_input; }
        assert marketable_security_distributed_property(entity_ref("urn:...#T2"), entity_ref("urn:...#PS2"), entity_ref("urn:...#P2"), entity_ref("urn:...#SEC2")) { id "f1"; origin case_input; }
        assert distributee_share_net_gain_if_all_sold_before(entity_ref("urn:...#T2"), entity_ref("urn:...#PS2"), entity_ref("urn:...#P2"), 15000 USD) { id "f2"; origin case_input; }
        assert distributee_share_net_gain_attributable_after(entity_ref("urn:...#T2"), entity_ref("urn:...#PS2"), entity_ref("urn:...#P2"), 6000 USD) { id "f3"; origin case_input; }
    }
    evaluate truth(section_731c3B_reduction(entity_ref("urn:...#T2"), entity_ref("urn:...#PS2"), entity_ref("urn:...#P2"), 9000 USD));
    expect truth_status == TRUE_ONLY;
    evaluate truth(section_731c_money_treated_amount(entity_ref("urn:...#T2"), entity_ref("urn:...#PS2"), entity_ref("urn:...#P2"), entity_ref("urn:...#SEC2"), 11000 USD));
    expect truth_status == TRUE_ONLY;
}

// --- §732(c): two-property allocation ---------------------------------------

test "S732c-01-INCREASE-ALLOCATED-BY-APPRECIATION-THEN-FMV" {
    given {
        context { decision_time @2027-06-01T09:00:00-04:00; knowledge_time @2027-06-01T09:00:00-04:00; legal_time @2027-06-01; timezone "America/New_York"; }
        assert distributed_other_properties_pair(entity_ref("urn:...#T3"), entity_ref("urn:...#PS3"), entity_ref("urn:...#P3"), entity_ref("urn:...#PA"), entity_ref("urn:...#PB")) { id "f0"; origin case_input; }
        assert distributed_property_pre_limitation_basis(entity_ref("urn:...#T3"), entity_ref("urn:...#PS3"), entity_ref("urn:...#PA"), 10000 USD) { id "f1"; origin case_input; }
        assert distributed_property_pre_limitation_basis(entity_ref("urn:...#T3"), entity_ref("urn:...#PS3"), entity_ref("urn:...#PB"), 5000 USD) { id "f2"; origin case_input; }
        assert property_fmv_at_distribution_732(entity_ref("urn:...#T3"), entity_ref("urn:...#PA"), 16000 USD) { id "f3"; origin case_input; }
        assert property_fmv_at_distribution_732(entity_ref("urn:...#T3"), entity_ref("urn:...#PB"), 5000 USD) { id "f4"; origin case_input; }
        assert distributee_outside_basis_before_distribution(entity_ref("urn:...#T3"), entity_ref("urn:...#PS3"), entity_ref("urn:...#P3"), 21000 USD) { id "f5"; origin case_input; }
        assert money_distributed(entity_ref("urn:...#T3"), entity_ref("urn:...#PS3"), entity_ref("urn:...#P3"), 0 USD) { id "f6"; origin case_input; }
    }
    // basis to allocate = 21000; sum of bases = 15000; increase = 6000
    // appreciation A = 6000, B = 0 -> all 6000 to A (capped at its own 6000 appreciation)
    evaluate truth(section_732c_basis_to_allocate(entity_ref("urn:...#T3"), entity_ref("urn:...#PS3"), entity_ref("urn:...#P3"), 21000 USD));
    expect truth_status == TRUE_ONLY;
    evaluate truth(distributed_properties_basis(entity_ref("urn:...#T3"), entity_ref("urn:...#PS3"), entity_ref("urn:...#P3"), entity_ref("urn:...#PA"), 16000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S732c-02-EQUAL-BASIS-TO-ALLOCATE-NO-ADJUSTMENT" {
    given {
        context { decision_time @2027-06-01T09:00:00-04:00; knowledge_time @2027-06-01T09:00:00-04:00; legal_time @2027-06-01; timezone "America/New_York"; }
        assert distributed_other_properties_pair(entity_ref("urn:...#T4"), entity_ref("urn:...#PS4"), entity_ref("urn:...#P4"), entity_ref("urn:...#PC"), entity_ref("urn:...#PD")) { id "f0"; origin case_input; }
        assert distributed_property_pre_limitation_basis(entity_ref("urn:...#T4"), entity_ref("urn:...#PS4"), entity_ref("urn:...#PC"), 4000 USD) { id "f1"; origin case_input; }
        assert distributed_property_pre_limitation_basis(entity_ref("urn:...#T4"), entity_ref("urn:...#PS4"), entity_ref("urn:...#PD"), 6000 USD) { id "f2"; origin case_input; }
        assert distributee_outside_basis_before_distribution(entity_ref("urn:...#T4"), entity_ref("urn:...#PS4"), entity_ref("urn:...#P4"), 10000 USD) { id "f3"; origin case_input; }
        assert money_distributed(entity_ref("urn:...#T4"), entity_ref("urn:...#PS4"), entity_ref("urn:...#P4"), 0 USD) { id "f4"; origin case_input; }
    }
    evaluate truth(distributed_properties_basis(entity_ref("urn:...#T4"), entity_ref("urn:...#PS4"), entity_ref("urn:...#P4"), entity_ref("urn:...#PC"), 4000 USD));
    expect truth_status == TRUE_ONLY;
}

// --- §732(d): transferee special basis election -----------------------------

test "S732d-01-WITHIN-2-YEARS-ELIGIBLE-FOR-ELECTION" {
    given {
        context { decision_time @2028-01-01T09:00:00-05:00; knowledge_time @2028-01-01T09:00:00-05:00; legal_time @2028-01-01; timezone "America/New_York"; }
        assert partner_acquired_interest_by_transfer_no_754(entity_ref("urn:...#TT5"), entity_ref("urn:...#P5"), entity_ref("urn:...#PS5"), @2026-06-01) { id "f0"; origin case_input; }
        assert distribution_of_property_other_than_money_to_transferee(entity_ref("urn:...#TD5"), entity_ref("urn:...#TT5"), entity_ref("urn:...#P5"), entity_ref("urn:...#PS5"), entity_ref("urn:...#PROP5"), @2027-06-01) { id "f1"; origin case_input; }
    }
    evaluate truth(section_732d_within_2_years(entity_ref("urn:...#TD5"), entity_ref("urn:...#TT5"), entity_ref("urn:...#P5"), entity_ref("urn:...#PS5")));
    expect truth_status == TRUE_ONLY;
}

