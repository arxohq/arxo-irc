}

// --- §735: character and holding period -------------------------------------

test "S735a1-01-UNREALIZED-RECEIVABLE-ORDINARY-NO-TIME-LIMIT" {
    given {
        context { decision_time @2030-06-01T09:00:00-04:00; knowledge_time @2030-06-01T09:00:00-04:00; legal_time @2030-06-01; timezone "America/New_York"; }
        assert distributed_property_is_unrealized_receivable(entity_ref("urn:...#T8"), entity_ref("urn:...#PROP8")) { id "f0"; origin case_input; }
        assert distributee_disposition_gain_or_loss(entity_ref("urn:...#T8"), entity_ref("urn:...#TD8"), entity_ref("urn:...#P8"), entity_ref("urn:...#PROP8"), 1500 USD, true) { id "f1"; origin case_input; }
    }
    evaluate truth(section_735a1_ordinary_character(entity_ref("urn:...#T8"), entity_ref("urn:...#TD8"), entity_ref("urn:...#P8"), entity_ref("urn:...#PROP8"), 1500 USD, true));
    expect truth_status == TRUE_ONLY;
}

test "S735a2-01-INVENTORY-ORDINARY-WITHIN-5-YEARS" {
    given {
        context { decision_time @2029-06-01T09:00:00-04:00; knowledge_time @2029-06-01T09:00:00-04:00; legal_time @2029-06-01; timezone "America/New_York"; }
        assert distributed_property_is_inventory_item(entity_ref("urn:...#T9"), entity_ref("urn:...#PROP9")) { id "f0"; origin case_input; }
        assert distributee_disposition_gain_or_loss(entity_ref("urn:...#T9"), entity_ref("urn:...#TD9"), entity_ref("urn:...#P9"), entity_ref("urn:...#PROP9"), 900 USD, true) { id "f1"; origin case_input; }
        assert distribution_date_735(entity_ref("urn:...#T9"), entity_ref("urn:...#PROP9"), @2026-01-01) { id "f2"; origin case_input; }
        assert disposition_date_735(entity_ref("urn:...#TD9"), entity_ref("urn:...#PROP9"), @2029-01-01) { id "f3"; origin case_input; }
    }
    evaluate truth(section_735a2_ordinary_character(entity_ref("urn:...#T9"), entity_ref("urn:...#TD9"), entity_ref("urn:...#P9"), entity_ref("urn:...#PROP9"), 900 USD, true));
    expect truth_status == TRUE_ONLY;
}

// --- §755: allocation among like-character property -------------------------

test "S755-01-INCREASE-ALLOCATED-BY-APPRECIATION" {
    given {
        context { decision_time @2027-06-01T09:00:00-04:00; knowledge_time @2027-06-01T09:00:00-04:00; legal_time @2027-06-01; timezone "America/New_York"; }
        assert section_755_two_properties_same_class(entity_ref("urn:...#T10"), entity_ref("urn:...#PS10"), entity_ref("urn:...#PE"), entity_ref("urn:...#PF"), OtherPartnershipProperty) { id "f0"; origin case_input; }
        assert section_755_allocation_amount(entity_ref("urn:...#T10"), entity_ref("urn:...#PS10"), 4000 USD) { id "f1"; origin case_input; }
        assert distributed_property_pre_limitation_basis(entity_ref("urn:...#T10"), entity_ref("urn:...#PS10"), entity_ref("urn:...#PE"), 10000 USD) { id "f2"; origin case_input; }
        assert distributed_property_pre_limitation_basis(entity_ref("urn:...#T10"), entity_ref("urn:...#PS10"), entity_ref("urn:...#PF"), 8000 USD) { id "f3"; origin case_input; }
        assert property_fmv_at_distribution_732(entity_ref("urn:...#T10"), entity_ref("urn:...#PE"), 14000 USD) { id "f4"; origin case_input; }
        assert property_fmv_at_distribution_732(entity_ref("urn:...#T10"), entity_ref("urn:...#PF"), 8000 USD) { id "f5"; origin case_input; }
    }
    // appreciation E = 4000, F = 0 -> entire 4000 increase to E (capped at its own appreciation)
    evaluate truth(section_755_allocated_adjustment(entity_ref("urn:...#T10"), entity_ref("urn:...#PS10"), entity_ref("urn:...#PE"), 4000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S755c-01-NO-ALLOCATION-TO-CORPORATE-PARTNER-STOCK" {
    given {
        context { decision_time @2027-06-01T09:00:00-04:00; knowledge_time @2027-06-01T09:00:00-04:00; legal_time @2027-06-01; timezone "America/New_York"; }
        assert distributed_property_pre_limitation_basis(entity_ref("urn:...#T11"), entity_ref("urn:...#PS11"), entity_ref("urn:...#STOCK"), 5000 USD) { id "f0"; origin case_input; }
        assert section_755_partner_is_corporation_or_related(entity_ref("urn:...#CORPPARTNER")) { id "f1"; origin case_input; }
        assert us.irc.core::ownership_interest(entity_ref("urn:...#OI11"), entity_ref("urn:...#CORPPARTNER"), entity_ref("urn:...#PS11"), 0.30) { id "f2"; origin case_input; }
    }
    evaluate truth(section_755c_no_allocation_to_corporate_stock(entity_ref("urn:...#T11"), entity_ref("urn:...#PS11"), entity_ref("urn:...#STOCK")));
    expect truth_status == TRUE_ONLY;
}
