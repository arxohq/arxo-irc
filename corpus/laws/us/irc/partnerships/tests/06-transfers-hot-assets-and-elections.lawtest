        assert s754_election_filed(entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2027"), entity_ref("urn:...#E1")) { id "f1"; origin case_input; }
        assert s754_election_manner_conforms_to_regulations(entity_ref("urn:...#E1")) { id "f2"; origin case_input; }
        assert transferee_basis_of_interest(entity_ref("urn:...#T1"), entity_ref("urn:...#P2"), 30000 USD) { id "f3"; origin case_input; }
        assert transferee_proportionate_share_of_partnership_basis(entity_ref("urn:...#T1"), entity_ref("urn:...#P2"), 18000 USD) { id "f4"; origin case_input; }
    }
    evaluate truth(section_743b_amount(entity_ref("urn:...#T1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#P2"), 12000 USD));
    expect truth_status == TRUE_ONLY;
}

