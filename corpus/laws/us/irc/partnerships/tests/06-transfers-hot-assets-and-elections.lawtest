test "S741-01-GAIN-RECOGNIZED-AND-CAPITAL-ABSENT-S751" {
    given {
        context { decision_time @2027-06-01T09:00:00-04:00; knowledge_time @2027-06-01T09:00:00-04:00; legal_time @2027-06-01; timezone "America/New_York"; }
        assert interest_sale_gain_or_loss(entity_ref("urn:...#T1"), entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), 25000 USD) { id "f0"; origin case_input; }
    }
    evaluate truth(interest_sale_gain_or_loss_recognized(entity_ref("urn:...#T1"), entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), 25000 USD));
    expect truth_status == TRUE_ONLY;
    evaluate truth(interest_sale_is_capital_gain_or_loss(entity_ref("urn:...#T1"), entity_ref("urn:...#P1"), entity_ref("urn:...#PS1")));
    expect truth_status == TRUE_ONLY;
}

test "S751a-01-HOT-ASSET-AMOUNT-IS-ORDINARY-INCOME-NOT-CAPITAL" {
    given {
        context { decision_time @2027-06-01T09:00:00-04:00; knowledge_time @2027-06-01T09:00:00-04:00; legal_time @2027-06-01; timezone "America/New_York"; }
        assert interest_sale_gain_or_loss(entity_ref("urn:...#T1"), entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), 25000 USD) { id "f0"; origin case_input; }
        assert amount_realized_attributable_to_hot_assets(entity_ref("urn:...#T1"), entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), 10000 USD) { id "f1"; origin case_input; }
    }
    evaluate truth(section_751_ordinary_income(entity_ref("urn:...#T1"), entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), 10000 USD));
    expect truth_status == TRUE_ONLY;
    evaluate truth(interest_sale_is_capital_gain_or_loss(entity_ref("urn:...#T1"), entity_ref("urn:...#P1"), entity_ref("urn:...#PS1")));
    expect truth_status == NEITHER;
}

