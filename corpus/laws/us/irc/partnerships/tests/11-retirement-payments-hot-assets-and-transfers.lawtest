// --- §736: classification of liquidation payments ---------------------------

test "S736a1-01-PAYMENT-WITH-REGARD-TO-INCOME-IS-DISTRIBUTIVE-SHARE" {
    given {
        context { decision_time @2027-06-01T09:00:00-04:00; knowledge_time @2027-06-01T09:00:00-04:00; legal_time @2027-06-01; timezone "America/New_York"; }
        assert liquidation_payment_to_retiring_or_deceased_partner(entity_ref("urn:...#T1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#P1"), 8000 USD) { id "f0"; origin case_input; }
        assert payment_determined_with_regard_to_income(entity_ref("urn:...#T1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#P1")) { id "f1"; origin case_input; }
    }
    evaluate truth(retiring_partner_payment_class(entity_ref("urn:...#T1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#P1"), 8000 USD, DistributiveShare));
    expect truth_status == TRUE_ONLY;
}

