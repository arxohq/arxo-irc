// --- §737: precontribution gain ---------------------------------------------

test "S737-01-GAIN-IS-LESSER-OF-EXCESS-AND-NET-PRECONTRIBUTION-GAIN" {
    given {
        context { decision_time @2027-06-01T09:00:00-04:00; knowledge_time @2027-06-01T09:00:00-04:00; legal_time @2027-06-01; timezone "America/New_York"; }
        assert distribution_property_fmv_received(entity_ref("urn:...#T5"), entity_ref("urn:...#PS5"), entity_ref("urn:...#P5"), 15000 USD) { id "f0"; origin case_input; }
        assert partner_outside_basis_before_737(entity_ref("urn:...#T5"), entity_ref("urn:...#PS5"), entity_ref("urn:...#P5"), 6000 USD) { id "f1"; origin case_input; }
        assert money_received_in_737_distribution(entity_ref("urn:...#T5"), entity_ref("urn:...#PS5"), entity_ref("urn:...#P5"), 1000 USD) { id "f2"; origin case_input; }
        assert partner_contributed_property_704c1B_gain_component(entity_ref("urn:...#T5"), entity_ref("urn:...#PS5"), entity_ref("urn:...#P5"), entity_ref("urn:...#CONTRIBPROP"), 8000 USD) { id "f3"; origin case_input; }
    }
    // excess = 15000 - max(0, 6000-1000) = 15000 - 5000 = 10000
    // net precontribution gain = 8000
    // lesser of 10000, 8000 = 8000
    evaluate truth(section_737a1_excess(entity_ref("urn:...#T5"), entity_ref("urn:...#PS5"), entity_ref("urn:...#P5"), 10000 USD));
    expect truth_status == TRUE_ONLY;
    evaluate truth(section_737b_net_precontribution_gain(entity_ref("urn:...#T5"), entity_ref("urn:...#PS5"), entity_ref("urn:...#P5"), 8000 USD));
    expect truth_status == TRUE_ONLY;
    evaluate truth(section_737_gain(entity_ref("urn:...#T5"), entity_ref("urn:...#PS5"), entity_ref("urn:...#P5"), 8000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S737d1-01-PREVIOUSLY-CONTRIBUTED-PROPERTY-EXCEPTION" {
    given {
        context { decision_time @2027-06-01T09:00:00-04:00; knowledge_time @2027-06-01T09:00:00-04:00; legal_time @2027-06-01; timezone "America/New_York"; }
        assert distribution_property_fmv_received(entity_ref("urn:...#T6"), entity_ref("urn:...#PS6"), entity_ref("urn:...#P6"), 15000 USD) { id "f0"; origin case_input; }
        assert partner_outside_basis_before_737(entity_ref("urn:...#T6"), entity_ref("urn:...#PS6"), entity_ref("urn:...#P6"), 6000 USD) { id "f1"; origin case_input; }
        assert money_received_in_737_distribution(entity_ref("urn:...#T6"), entity_ref("urn:...#PS6"), entity_ref("urn:...#P6"), 0 USD) { id "f2"; origin case_input; }
        assert partner_contributed_property_704c1B_gain_component(entity_ref("urn:...#T6"), entity_ref("urn:...#PS6"), entity_ref("urn:...#P6"), entity_ref("urn:...#CONTRIBPROP6"), 8000 USD) { id "f3"; origin case_input; }
        assert section_737_previously_contributed_property_exception(entity_ref("urn:...#T6"), entity_ref("urn:...#PS6"), entity_ref("urn:...#P6")) { id "f4"; origin case_input; }
    }
    evaluate truth(section_737_gain(entity_ref("urn:...#T6"), entity_ref("urn:...#PS6"), entity_ref("urn:...#P6"), 8000 USD));
    expect truth_status == NEITHER;
}

