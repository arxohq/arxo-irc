        assert inventory_item_partnership_basis(entity_ref("urn:...#PS11"), entity_ref("urn:...#ITEM11"), 10000 USD) { id "f1"; origin case_input; }
    }
    // 120% of 10000 = 12000 < 13000
    evaluate truth(section_751b3_substantially_appreciated(entity_ref("urn:...#PS11"), entity_ref("urn:...#ITEM11")));
    expect truth_status == TRUE_ONLY;
}

