        assert distributee_outside_basis_before_distribution(entity_ref("urn:...#T1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#P1"), 6000 USD) { id "f1"; origin case_input; }
    }
    evaluate truth(distribution_gain_recognized(entity_ref("urn:...#T1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#P1"), 0 USD));
    expect truth_status == TRUE_ONLY;
}

test "S731a-03-LOSS-ON-LIQUIDATING-MONEY-ONLY-DISTRIBUTION" {
    given {
        context { decision_time @2027-03-01T09:00:00-05:00; knowledge_time @2027-03-01T09:00:00-05:00; legal_time @2027-03-01; timezone "America/New_York"; }
        assert distribution_in_liquidation(entity_ref("urn:...#T1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#P1")) { id "f0"; origin case_input; }
        assert liquidating_distribution_money_receivables_inventory_only(entity_ref("urn:...#T1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#P1")) { id "f1"; origin case_input; }
        assert distributee_outside_basis_before_distribution(entity_ref("urn:...#T1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#P1"), 10000 USD) { id "f2"; origin case_input; }
        assert money_distributed(entity_ref("urn:...#T1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#P1"), 6000 USD) { id "f3"; origin case_input; }
        assert distributee_basis_of_receivables_and_inventory(entity_ref("urn:...#T1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#P1"), 0 USD) { id "f4"; origin case_input; }
    }
    evaluate truth(distribution_loss_recognized(entity_ref("urn:...#T1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#P1"), 4000 USD));
    expect truth_status == TRUE_ONLY;
}

