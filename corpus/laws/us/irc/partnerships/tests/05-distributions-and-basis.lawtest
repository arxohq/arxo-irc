// Scenarios for 26 U.S.C. §§731-733, package us.irc.partnerships,
// module 05-distributions-and-basis.law. Written from the text; NOT
// executed in this stage — `implemented_unverified` per AGENT-BRIEF.md.

language "law.core" version "0.2";
package us.irc.partnerships version "0.1.1";
namespace "urn:us:irc:partnerships:clir";

test "S731a-01-GAIN-ON-MONEY-EXCEEDING-BASIS" {
    given {
        context { decision_time @2027-03-01T09:00:00-05:00; knowledge_time @2027-03-01T09:00:00-05:00; legal_time @2027-03-01; timezone "America/New_York"; }
        assert money_distributed(entity_ref("urn:...#T1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#P1"), 9000 USD) { id "f0"; origin case_input; }
        assert distributee_outside_basis_before_distribution(entity_ref("urn:...#T1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#P1"), 6000 USD) { id "f1"; origin case_input; }
    }
    evaluate truth(distribution_gain_recognized(entity_ref("urn:...#T1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#P1"), 3000 USD));
    expect truth_status == TRUE_ONLY;
}
test "S731a-02-NO-GAIN-WHEN-MONEY-WITHIN-BASIS" {
    given {
        context { decision_time @2027-03-01T09:00:00-05:00; knowledge_time @2027-03-01T09:00:00-05:00; legal_time @2027-03-01; timezone "America/New_York"; }
