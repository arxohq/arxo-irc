language "law.core" version "0.2";
package us.irc.partnerships version "0.1.1";
namespace "urn:us:irc:partnerships:clir";

test "S701-01-PARTNERSHIP-ITSELF-NOT-TAXED" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; }
        assert us.irc.core::ownership_interest(entity_ref("urn:...#OI1"), entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), 0.50) { id "f0"; origin case_input; }
    }
    evaluate truth(partnership_not_subject_to_income_tax(entity_ref("urn:...#PS1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(partner_liable_in_separate_capacity(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1")));
    expect truth_status == TRUE_ONLY;
}

