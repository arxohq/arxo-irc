language "law.core" version "0.2";
package us.irc.partnerships version "0.1.1";
namespace "urn:us:irc:partnerships:clir";

test "S721-01-NO-GAIN-OR-LOSS-ON-ORDINARY-CONTRIBUTION" {
    given {
        context { decision_time @2027-02-01T09:00:00-05:00; knowledge_time @2027-02-01T09:00:00-05:00; legal_time @2027-02-01; timezone "America/New_York"; }
        assert contribution_of_property(entity_ref("urn:...#T1"), entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#ASSET1"), entity_ref("urn:...#OI1")) { id "f0"; origin case_input; }
    }
    evaluate truth(contribution_gain_or_loss_recognized(entity_ref("urn:...#T1"), entity_ref("urn:...#P1"), 0 USD));
    expect truth_status == TRUE_ONLY;
}

test "S721b-01-INVESTMENT-COMPANY-EXCEPTION-RECOGNIZES-GAIN" {
    given {
        context { decision_time @2027-02-01T09:00:00-05:00; knowledge_time @2027-02-01T09:00:00-05:00; legal_time @2027-02-01; timezone "America/New_York"; }
        assert contribution_of_property(entity_ref("urn:...#T1"), entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#ASSET1"), entity_ref("urn:...#OI1")) { id "f0"; origin case_input; }
        assert would_be_investment_company_if_incorporated(entity_ref("urn:...#PS1")) { id "f1"; origin case_input; }
        assert contribution_gain_realized(entity_ref("urn:...#T1"), entity_ref("urn:...#P1"), 15000 USD) { id "f2"; origin case_input; }
    }
    evaluate truth(contribution_gain_or_loss_recognized(entity_ref("urn:...#T1"), entity_ref("urn:...#P1"), 15000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S722-01-BASIS-FROM-MONEY-AND-PROPERTY-COMBINED" {
    given {
        context { decision_time @2027-02-01T09:00:00-05:00; knowledge_time @2027-02-01T09:00:00-05:00; legal_time @2027-02-01; timezone "America/New_York"; }
        assert money_contributed(entity_ref("urn:...#T1"), entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), 5000 USD) { id "f0"; origin case_input; }
        assert basis_of_contributed_property(entity_ref("urn:...#T1"), entity_ref("urn:...#P1"), entity_ref("urn:...#ASSET1"), 8000 USD) { id "f1"; origin case_input; }
    }
    evaluate truth(contribution_basis(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#T1"), 13000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S722-02-BASIS-INCREASED-BY-S721B-GAIN" {
    given {
        context { decision_time @2027-02-01T09:00:00-05:00; knowledge_time @2027-02-01T09:00:00-05:00; legal_time @2027-02-01; timezone "America/New_York"; }
