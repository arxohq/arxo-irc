        assert basis_of_contributed_property(entity_ref("urn:...#T1"), entity_ref("urn:...#P1"), entity_ref("urn:...#ASSET1"), 8000 USD) { id "f1"; origin case_input; }
        assert would_be_investment_company_if_incorporated(entity_ref("urn:...#PS1")) { id "f2"; origin case_input; }
        assert contribution_gain_realized(entity_ref("urn:...#T1"), entity_ref("urn:...#P1"), 2000 USD) { id "f3"; origin case_input; }
    }
    evaluate truth(contribution_basis_after_s721b_gain(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#T1"), 10000 USD));
    expect truth_status == TRUE_ONLY;
}

