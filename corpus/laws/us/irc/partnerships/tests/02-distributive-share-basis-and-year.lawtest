// Scenarios for 26 U.S.C. §§704(a),(d), 707(c), package us.irc.partnerships,
// module 02-distributive-share-basis-and-year.law. Written from the text;
// NOT executed in this stage — `implemented_unverified` per AGENT-BRIEF.md.

language "law.core" version "0.2";
package us.irc.partnerships version "0.1.1";
namespace "urn:us:irc:partnerships:clir";

test "S704a-01-AGREEMENT-SHARE-GOVERNS" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; }
        assert distributive_share_per_agreement(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2026"), LongTermCapitalGainLoss, 0.70) { id "f0"; origin case_input; }
    }
    evaluate truth(partnership_interest_share_for_item(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2026"), LongTermCapitalGainLoss, 0.70));
    expect truth_status == TRUE_ONLY;
}

test "S704b-01-LACKS-SUBSTANTIAL-ECONOMIC-EFFECT-FALLS-BACK-TO-INTEREST" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; }
        assert distributive_share_per_agreement(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2026"), LongTermCapitalGainLoss, 0.90) { id "f0"; origin case_input; }
        assert lacks_substantial_economic_effect(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2026"), LongTermCapitalGainLoss) { id "f1"; origin case_input; }
        assert us.irc.core::ownership_interest(entity_ref("urn:...#OI1"), entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), 0.40) { id "f2"; origin case_input; }
    }
    evaluate truth(partnership_interest_share_for_item(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2026"), LongTermCapitalGainLoss, 0.40));
    expect truth_status == TRUE_ONLY;
}

// Two-year carryforward scenario: year 1 loss exceeds basis, excess
// suspended; year 2 basis (increased by year-2 income) absorbs the
// suspended loss with no double counting.
test "S704d-01-LOSS-LIMITED-TO-BASIS-YEAR-ONE-SUSPENDS-EXCESS" {
    given {
        context { decision_time @2026-12-31T09:00:00-05:00; knowledge_time @2026-12-31T09:00:00-05:00; legal_time @2026-12-31; timezone "America/New_York"; }
        assert partner_distributive_share_loss(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2026"), 12000 USD) { id "f0"; origin case_input; }
        assert partner_outside_basis_before_loss(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2026"), 5000 USD) { id "f1"; origin case_input; }
    }
    evaluate truth(partner_loss_allowed(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2026"), 5000 USD));
    expect truth_status == TRUE_ONLY;
    evaluate truth(suspended_partner_loss_carried_out(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2026"), 7000 USD));
    expect truth_status == TRUE_ONLY;
}
test "S704d-02-YEAR-TWO-BASIS-ABSORBS-SUSPENDED-LOSS" {
    given {
        context { decision_time @2027-12-31T09:00:00-05:00; knowledge_time @2027-12-31T09:00:00-05:00; legal_time @2027-12-31; timezone "America/New_York"; }
        // Year 2: no new loss beyond what basis covers; the $7,000 suspended
        // from year 1 is carried in and fully absorbed by $9,000 of new basis.
        assert partner_distributive_share_loss(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2027"), 0 USD) { id "f0"; origin case_input; }
        assert partner_outside_basis_before_loss(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2027"), 9000 USD) { id "f1"; origin case_input; }
        assert suspended_partner_loss_carried_in(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2027"), 7000 USD) { id "f2"; origin case_input; }
    }
    evaluate truth(partner_loss_basis_ceiling(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2027"), 16000 USD));
    expect truth_status == TRUE_ONLY;
    evaluate truth(partner_loss_allowed(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2027"), 0 USD));
    expect truth_status == TRUE_ONLY;
}

test "S704d-03-UNKNOWN-BASIS-GIVES-NEITHER" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; }
        assert partner_distributive_share_loss(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2026"), 5000 USD) { id "f0"; origin case_input; }
    }
    evaluate truth(partner_loss_allowed(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2026"), 5000 USD));
    expect truth_status == NEITHER;
}

test "S707c-01-GUARANTEED-PAYMENT-IS-GROSS-INCOME-AND-DEDUCTIBLE-EXPENSE" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; }
        assert guaranteed_payment_amount(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2026"), 60000 USD) { id "f0"; origin case_input; }
    }
    evaluate truth(guaranteed_payment_gross_income_to_partner(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2026"), 60000 USD));
    expect truth_status == TRUE_ONLY;
    evaluate truth(guaranteed_payment_deductible_expense_to_partnership(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2026"), 60000 USD));
    expect truth_status == TRUE_ONLY;
}
