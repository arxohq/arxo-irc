// Least aggregate deferral: two candidate years, partner A (60%) has a
// December year-end (0 months deferral if the partnership picks December),
// partner B (40%) has a June year-end (6 months deferral if December is
// picked). If the partnership instead picked June: A defers 6 months
// (weighted 3.6), B defers 0 (weighted 0) — December wins with a lower
// aggregate deferral (2.4 vs 3.6 — this scenario tests June's own weighted
// value in isolation as an intermediate value).
test "S706b4-01-AGGREGATE-DEFERRAL-INTERMEDIATE-VALUE-FOR-ONE-CANDIDATE" {
    given {
        context { decision_time @2027-01-01T09:00:00-05:00; knowledge_time @2027-01-01T09:00:00-05:00; legal_time @2027-01-01; timezone "America/New_York"; }
        assert candidate_taxable_year(entity_ref("urn:...#PS1"), entity_ref("urn:...#Y_DEC")) { id "f0"; origin case_input; }
        assert us.irc.core::ownership_interest(entity_ref("urn:...#OIA"), entity_ref("urn:...#PA"), entity_ref("urn:...#PS1"), 0.60) { id "f1"; origin case_input; }
        assert us.irc.core::ownership_interest(entity_ref("urn:...#OIB"), entity_ref("urn:...#PB"), entity_ref("urn:...#PS1"), 0.40) { id "f2"; origin case_input; }
        assert deferral_months_for_partner_under_candidate(entity_ref("urn:...#PA"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y_DEC"), 0.0) { id "f3"; origin case_input; }
        assert deferral_months_for_partner_under_candidate(entity_ref("urn:...#PB"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y_DEC"), 6.0) { id "f4"; origin case_input; }
    }
    evaluate truth(aggregate_deferral_for_candidate(entity_ref("urn:...#PS1"), entity_ref("urn:...#Y_DEC"), 2.4));
    expect truth_status == TRUE_ONLY;
}
