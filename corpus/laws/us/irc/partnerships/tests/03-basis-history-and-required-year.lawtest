// Scenarios for 26 U.S.C. §705, §706(a)-(b), package us.irc.partnerships,
// module 03-basis-history-and-required-year.law. Written from the text;
// NOT executed in this stage — `implemented_unverified` per AGENT-BRIEF.md.

language "law.core" version "0.2";
package us.irc.partnerships version "0.1.1";
namespace "urn:us:irc:partnerships:clir";

test "S705-01-BASIS-INCREASED-BY-TAXABLE-AND-EXEMPT-INCOME-DECREASED-BY-DISTRIBUTIONS" {
    given {
        context { decision_time @2026-12-31T09:00:00-05:00; knowledge_time @2026-12-31T09:00:00-05:00; legal_time @2026-12-31; timezone "America/New_York"; }
        assert outside_basis_start(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2026"), 10000 USD) { id "f0"; origin case_input; }
        assert outside_basis_increase_taxable_income_share(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2026"), 4000 USD) { id "f1"; origin case_input; }
        assert outside_basis_increase_exempt_income_share(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2026"), 1000 USD) { id "f2"; origin case_input; }
        assert outside_basis_decrease_distributions(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2026"), 3000 USD) { id "f3"; origin case_input; }
        assert outside_basis_decrease_loss_share(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2026"), 0 USD) { id "f4"; origin case_input; }
        assert outside_basis_decrease_nondeductible_noncapital_expenditures(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2026"), 500 USD) { id "f5"; origin case_input; }
    }
    // 10000 + 4000 + 1000 - 3000 - 0 - 500 = 11500
    evaluate truth(outside_basis(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2026"), 11500 USD));
    expect truth_status == TRUE_ONLY;
}

test "S705-02-BASIS-NEVER-BELOW-ZERO" {
    given {
        context { decision_time @2026-12-31T09:00:00-05:00; knowledge_time @2026-12-31T09:00:00-05:00; legal_time @2026-12-31; timezone "America/New_York"; }
        assert outside_basis_start(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2026"), 1000 USD) { id "f0"; origin case_input; }
        assert outside_basis_increase_taxable_income_share(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2026"), 0 USD) { id "f1"; origin case_input; }
        assert outside_basis_increase_exempt_income_share(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2026"), 0 USD) { id "f2"; origin case_input; }
        assert outside_basis_decrease_distributions(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2026"), 5000 USD) { id "f3"; origin case_input; }
        assert outside_basis_decrease_loss_share(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2026"), 0 USD) { id "f4"; origin case_input; }
        assert outside_basis_decrease_nondeductible_noncapital_expenditures(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2026"), 0 USD) { id "f5"; origin case_input; }
    }
    evaluate truth(outside_basis(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2026"), 0 USD));
    expect truth_status == TRUE_ONLY;
}

