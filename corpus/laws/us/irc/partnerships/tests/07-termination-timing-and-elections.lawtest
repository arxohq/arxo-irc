language "law.core" version "0.2";
package us.irc.partnerships version "0.1.1";
namespace "urn:us:irc:partnerships:clir";

// --- §706(d): varying interests --------------------------------------------

test "S706d-01-VARYING-INTEREST-SHARE-TWO-PERIODS" {
    given {
        context { decision_time @2026-12-31T09:00:00-05:00; knowledge_time @2026-12-31T09:00:00-05:00; legal_time @2026-12-31; timezone "America/New_York"; }
        // Partner P1 holds 50% through PER1 (item amount 6000), then after a
        // new partner is admitted holds 25% through PER2 (item amount 4000).
        assert interest_period_of_year(entity_ref("urn:...#PER1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2026")) { id "f0"; origin case_input; }
        assert interest_period_of_year(entity_ref("urn:...#PER2"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2026")) { id "f1"; origin case_input; }
        assert item_amount_for_period(entity_ref("urn:...#PS1"), entity_ref("urn:...#PER1"), ResidualTaxableIncomeOrLoss, 6000 USD) { id "f2"; origin case_input; }
        assert item_amount_for_period(entity_ref("urn:...#PS1"), entity_ref("urn:...#PER2"), ResidualTaxableIncomeOrLoss, 4000 USD) { id "f3"; origin case_input; }
        assert partner_interest_share_during_period(entity_ref("urn:...#P1"), entity_ref("urn:...#PER1"), 0.50) { id "f4"; origin case_input; }
        assert partner_interest_share_during_period(entity_ref("urn:...#P1"), entity_ref("urn:...#PER2"), 0.25) { id "f5"; origin case_input; }
    }
    // 6000*0.50 + 4000*0.25 = 3000 + 1000 = 4000
    evaluate truth(varying_interest_share(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2026"), ResidualTaxableIncomeOrLoss, 4000 USD));
    expect truth_status == TRUE_ONLY;
    evaluate truth(partner_item_share_for_period(entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), entity_ref("urn:...#Y2026"), entity_ref("urn:...#PER1"), ResidualTaxableIncomeOrLoss, 3000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S706d-02-UNKNOWN-PERIOD-SHARE-GIVES-NEITHER" {
    given {
        context { decision_time @2026-12-31T09:00:00-05:00; knowledge_time @2026-12-31T09:00:00-05:00; legal_time @2026-12-31; timezone "America/New_York"; }
        assert interest_period_of_year(entity_ref("urn:...#PER1"), entity_ref("urn:...#PS2"), entity_ref("urn:...#Y2026")) { id "f0"; origin case_input; }
        assert item_amount_for_period(entity_ref("urn:...#PS2"), entity_ref("urn:...#PER1"), ResidualTaxableIncomeOrLoss, 6000 USD) { id "f1"; origin case_input; }
        // no partner_interest_share_during_period asserted
    }
    evaluate truth(varying_interest_share(entity_ref("urn:...#P2"), entity_ref("urn:...#PS2"), entity_ref("urn:...#Y2026"), ResidualTaxableIncomeOrLoss, 4000 USD));
    expect truth_status == NEITHER;
}

test "S706d2B-01-INTEREST-IS-ALLOCABLE-CASH-BASIS-ITEM" {
    given {
        context { decision_time @2026-12-31T09:00:00-05:00; knowledge_time @2026-12-31T09:00:00-05:00; legal_time @2026-12-31; timezone "America/New_York"; }
