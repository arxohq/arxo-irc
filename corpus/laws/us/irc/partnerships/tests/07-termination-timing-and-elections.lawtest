        assert cash_basis_item_occurs(entity_ref("urn:...#PS1"), InterestItem) { id "f1"; origin case_input; }
    }
    evaluate truth(is_allocable_cash_basis_item(entity_ref("urn:...#PS1"), InterestItem));
    expect truth_status == TRUE_ONLY;
    evaluate truth(is_allocable_cash_basis_item(entity_ref("urn:...#PS1"), TaxesItem));
    expect truth_status == NEITHER;
}

