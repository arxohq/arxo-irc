}

// --- §708: continuation, termination, merger, division ---------------------

test "S708-01-CONTINUES-WHEN-BUSINESS-CONTINUES-IN-A-PARTNER" {
    given {
        context { decision_time @2027-01-15T09:00:00-05:00; knowledge_time @2027-01-15T09:00:00-05:00; legal_time @2027-01-15; timezone "America/New_York"; }
        assert us.irc.core::ownership_interest(entity_ref("urn:...#OI1"), entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), 0.60) { id "f0"; origin case_input; }
    }
    evaluate truth(continuing_partnership(entity_ref("urn:...#PS1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(partnership_terminated(entity_ref("urn:...#PS1")));
    expect truth_status == NEITHER;
}

test "S708b1-01-TERMINATED-WHEN-NO-BUSINESS-CONTINUES" {
    given {
        context { decision_time @2027-01-15T09:00:00-05:00; knowledge_time @2027-01-15T09:00:00-05:00; legal_time @2027-01-15; timezone "America/New_York"; }
        assert us.irc.core::ownership_interest(entity_ref("urn:...#OI1"), entity_ref("urn:...#P1"), entity_ref("urn:...#PS1"), 0.60) { id "f0"; origin case_input; }
        assert not partnership_business_continues_in_successor(entity_ref("urn:...#PS1")) { id "f1"; origin case_input; }
    }
    evaluate truth(partnership_terminated(entity_ref("urn:...#PS1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(continuing_partnership(entity_ref("urn:...#PS1")));
    expect truth_status == NEITHER;
}

