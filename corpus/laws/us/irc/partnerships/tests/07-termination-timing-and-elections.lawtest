// --- §761(f): qualified joint venture ---------------------------------------

test "S761f-01-QJV-ELECTED-NOT-TREATED-AS-PARTNERSHIP-ITEMS-DIVIDED" {
    given {
        context { decision_time @2027-04-01T09:00:00-04:00; knowledge_time @2027-04-01T09:00:00-04:00; legal_time @2027-04-01; timezone "America/New_York"; }
        assert qualified_joint_venture_conducted(entity_ref("urn:...#V1"), entity_ref("urn:...#H"), entity_ref("urn:...#W"), entity_ref("urn:...#Y2026")) { id "f0"; origin case_input; }
        assert joint_venture_only_members_husband_and_wife(entity_ref("urn:...#V1"), entity_ref("urn:...#H"), entity_ref("urn:...#W")) { id "f1"; origin case_input; }
        assert spouses_materially_participate_469h(entity_ref("urn:...#V1"), entity_ref("urn:...#H"), entity_ref("urn:...#W"), entity_ref("urn:...#Y2026")) { id "f2"; origin case_input; }
        assert spouses_elect_qjv(entity_ref("urn:...#V1"), entity_ref("urn:...#H"), entity_ref("urn:...#W"), entity_ref("urn:...#Y2026")) { id "f3"; origin case_input; }
        assert partnership_level_item(entity_ref("urn:...#V1"), entity_ref("urn:...#Y2026"), ResidualTaxableIncomeOrLoss, 100000 USD) { id "f4"; origin case_input; }
        assert qjv_spouse_venture_interest_share(entity_ref("urn:...#H"), entity_ref("urn:...#V1"), entity_ref("urn:...#Y2026"), ResidualTaxableIncomeOrLoss, 0.60) { id "f5"; origin case_input; }
    }
    evaluate truth(qualified_joint_venture(entity_ref("urn:...#V1"), entity_ref("urn:...#H"), entity_ref("urn:...#W"), entity_ref("urn:...#Y2026")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(qjv_not_treated_as_partnership(entity_ref("urn:...#V1"), entity_ref("urn:...#Y2026")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(qjv_spouse_item_amount(entity_ref("urn:...#H"), entity_ref("urn:...#V1"), entity_ref("urn:...#Y2026"), ResidualTaxableIncomeOrLoss, 60000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S761f-02-NOT-ONLY-HUSBAND-AND-WIFE-NOT-ELIGIBLE" {
    given {
        context { decision_time @2027-04-01T09:00:00-04:00; knowledge_time @2027-04-01T09:00:00-04:00; legal_time @2027-04-01; timezone "America/New_York"; }
        assert qualified_joint_venture_conducted(entity_ref("urn:...#V2"), entity_ref("urn:...#H2"), entity_ref("urn:...#W2"), entity_ref("urn:...#Y2026")) { id "f0"; origin case_input; }
        assert spouses_materially_participate_469h(entity_ref("urn:...#V2"), entity_ref("urn:...#H2"), entity_ref("urn:...#W2"), entity_ref("urn:...#Y2026")) { id "f1"; origin case_input; }
        assert spouses_elect_qjv(entity_ref("urn:...#V2"), entity_ref("urn:...#H2"), entity_ref("urn:...#W2"), entity_ref("urn:...#Y2026")) { id "f2"; origin case_input; }
        // joint_venture_only_members_husband_and_wife NOT asserted (a third member exists)
    }
    evaluate truth(qjv_eligible(entity_ref("urn:...#V2"), entity_ref("urn:...#H2"), entity_ref("urn:...#W2"), entity_ref("urn:...#Y2026")));
    expect truth_status == NEITHER;
    evaluate truth(qualified_joint_venture(entity_ref("urn:...#V2"), entity_ref("urn:...#H2"), entity_ref("urn:...#W2"), entity_ref("urn:...#Y2026")));
    expect truth_status == NEITHER;
}

test "S761f-03-ELIGIBLE-BUT-NOT-ELECTED-REMAINS-A-PARTNERSHIP" {
    given {
        context { decision_time @2027-04-01T09:00:00-04:00; knowledge_time @2027-04-01T09:00:00-04:00; legal_time @2027-04-01; timezone "America/New_York"; }
        assert qualified_joint_venture_conducted(entity_ref("urn:...#V3"), entity_ref("urn:...#H3"), entity_ref("urn:...#W3"), entity_ref("urn:...#Y2026")) { id "f0"; origin case_input; }
        assert joint_venture_only_members_husband_and_wife(entity_ref("urn:...#V3"), entity_ref("urn:...#H3"), entity_ref("urn:...#W3")) { id "f1"; origin case_input; }
        assert spouses_materially_participate_469h(entity_ref("urn:...#V3"), entity_ref("urn:...#H3"), entity_ref("urn:...#W3"), entity_ref("urn:...#Y2026")) { id "f2"; origin case_input; }
        // spouses_elect_qjv NOT asserted
    }
    evaluate truth(qjv_eligible(entity_ref("urn:...#V3"), entity_ref("urn:...#H3"), entity_ref("urn:...#W3"), entity_ref("urn:...#Y2026")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(qualified_joint_venture(entity_ref("urn:...#V3"), entity_ref("urn:...#H3"), entity_ref("urn:...#W3"), entity_ref("urn:...#Y2026")));
    expect truth_status == NEITHER;
}
