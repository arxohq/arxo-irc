// Distribution + §752(b) relief + sale chain (module 15). Expected values
// are hand-computed; every amount is engine-derived, none asserted whole.

language "law.core" version "0.2";
package us.irc.partnerships version "0.1.1";
namespace "urn:us:irc:partnerships:clir";

test "S15-01-DISTRIBUTION-GAIN-ZERO-BASIS-FORTY-K" {
    given {
        context { decision_time @2025-06-30T09:00:00-05:00; knowledge_time @2025-06-30T09:00:00-05:00; legal_time @2025-06-30; timezone "America/New_York"; }
        assert money_distributed(entity_ref("urn:...#T1"), entity_ref("urn:...#PS"), entity_ref("urn:...#P"), 30000 USD) { id "f0"; origin case_input; }
        assert distributee_outside_basis_before_distribution(entity_ref("urn:...#T1"), entity_ref("urn:...#PS"), entity_ref("urn:...#P"), 120000 USD) { id "f1"; origin case_input; }
        assert distributed_property_pre_limitation_basis(entity_ref("urn:...#T1"), entity_ref("urn:...#PS"), entity_ref("urn:...#PROP"), 50000 USD) { id "f2"; origin case_input; }
    }
    // 30000 <= 120000: no gain. prop: 50000 <= 120000-30000. after: 40000.
    evaluate truth(distribution_gain_recognized(entity_ref("urn:...#T1"), entity_ref("urn:...#PS"), entity_ref("urn:...#P"), 0 USD));
    expect truth_status == TRUE_ONLY;
}

test "S15-02-DISTRIBUTION-BASIS-AFTER-FORTY-K" {
    given {
        context { decision_time @2025-06-30T09:00:00-05:00; knowledge_time @2025-06-30T09:00:00-05:00; legal_time @2025-06-30; timezone "America/New_York"; }
        assert money_distributed(entity_ref("urn:...#T1"), entity_ref("urn:...#PS"), entity_ref("urn:...#P"), 30000 USD) { id "f0"; origin case_input; }
        assert distributee_outside_basis_before_distribution(entity_ref("urn:...#T1"), entity_ref("urn:...#PS"), entity_ref("urn:...#P"), 120000 USD) { id "f1"; origin case_input; }
        assert distributed_property_pre_limitation_basis(entity_ref("urn:...#T1"), entity_ref("urn:...#PS"), entity_ref("urn:...#PROP"), 50000 USD) { id "f2"; origin case_input; }
    }
    evaluate truth(distributee_outside_basis_after_distribution(entity_ref("urn:...#T1"), entity_ref("urn:...#PS"), entity_ref("urn:...#P"), 40000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S15-03-RELIEF-COMBINED-GAIN-ZERO" {
    given {
        context { decision_time @2025-09-30T09:00:00-05:00; knowledge_time @2025-09-30T09:00:00-05:00; legal_time @2025-09-30; timezone "America/New_York"; }
        assert distributee_outside_basis_before_distribution(entity_ref("urn:...#T2"), entity_ref("urn:...#PS"), entity_ref("urn:...#P"), 40000 USD) { id "f0"; origin case_input; }
        assert money_distributed(entity_ref("urn:...#T2"), entity_ref("urn:...#PS"), entity_ref("urn:...#P"), 0 USD) { id "f1"; origin case_input; }
        assert partner_liability_share_decrease_in_transaction(entity_ref("urn:...#T2"), entity_ref("urn:...#P"), entity_ref("urn:...#PS"), 25000 USD) { id "f2"; origin case_input; }
    }
    // deemed 25000 via 752(b); combined 0+25000 <= 40000: no gain.
    evaluate truth(distribution_gain_with_liability_relief(entity_ref("urn:...#T2"), entity_ref("urn:...#PS"), entity_ref("urn:...#P"), 0 USD));
    expect truth_status == TRUE_ONLY;
}

test "S15-04-RELIEF-BASIS-AFTER-FIFTEEN-K" {
    given {
        context { decision_time @2025-09-30T09:00:00-05:00; knowledge_time @2025-09-30T09:00:00-05:00; legal_time @2025-09-30; timezone "America/New_York"; }
        assert distributee_outside_basis_before_distribution(entity_ref("urn:...#T2"), entity_ref("urn:...#PS"), entity_ref("urn:...#P"), 40000 USD) { id "f0"; origin case_input; }
        assert money_distributed(entity_ref("urn:...#T2"), entity_ref("urn:...#PS"), entity_ref("urn:...#P"), 0 USD) { id "f1"; origin case_input; }
        assert partner_liability_share_decrease_in_transaction(entity_ref("urn:...#T2"), entity_ref("urn:...#P"), entity_ref("urn:...#PS"), 25000 USD) { id "f2"; origin case_input; }
    }
    // 40000 - 0 - 25000 = 15000; the flat 05 after-basis must stay silent here.
    evaluate truth(outside_basis_after_distribution_with_relief(entity_ref("urn:...#T2"), entity_ref("urn:...#PS"), entity_ref("urn:...#P"), 15000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S15-05-FLAT-BASIS-SILENT-WITH-DEEMED" {
    given {
        context { decision_time @2025-09-30T09:00:00-05:00; knowledge_time @2025-09-30T09:00:00-05:00; legal_time @2025-09-30; timezone "America/New_York"; }
        assert distributee_outside_basis_before_distribution(entity_ref("urn:...#T2"), entity_ref("urn:...#PS"), entity_ref("urn:...#P"), 40000 USD) { id "f0"; origin case_input; }
        assert money_distributed(entity_ref("urn:...#T2"), entity_ref("urn:...#PS"), entity_ref("urn:...#P"), 0 USD) { id "f1"; origin case_input; }
        assert partner_liability_share_decrease_in_transaction(entity_ref("urn:...#T2"), entity_ref("urn:...#P"), entity_ref("urn:...#PS"), 25000 USD) { id "f2"; origin case_input; }
    }
    // No double path: the flat 05 after-basis (40000) must not derive.
    evaluate truth(distributee_outside_basis_after_distribution(entity_ref("urn:...#T2"), entity_ref("urn:...#PS"), entity_ref("urn:...#P"), 40000 USD));
    expect truth_status == NEITHER;
}

test "S15-06-RELIEF-EXCEEDING-BASIS-GAIN-AND-FLOOR" {
    given {
        context { decision_time @2025-09-30T09:00:00-05:00; knowledge_time @2025-09-30T09:00:00-05:00; legal_time @2025-09-30; timezone "America/New_York"; }
        assert distributee_outside_basis_before_distribution(entity_ref("urn:...#T2B"), entity_ref("urn:...#PS"), entity_ref("urn:...#P"), 10000 USD) { id "f0"; origin case_input; }
        assert money_distributed(entity_ref("urn:...#T2B"), entity_ref("urn:...#PS"), entity_ref("urn:...#P"), 0 USD) { id "f1"; origin case_input; }
        assert partner_liability_share_decrease_in_transaction(entity_ref("urn:...#T2B"), entity_ref("urn:...#P"), entity_ref("urn:...#PS"), 25000 USD) { id "f2"; origin case_input; }
    }
    // combined 25000 - 10000 = 15000 gain; after-basis floored at zero.
    evaluate truth(distribution_gain_with_liability_relief(entity_ref("urn:...#T2B"), entity_ref("urn:...#PS"), entity_ref("urn:...#P"), 15000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S15-07-SALE-TOTAL-GAIN-COMPUTED" {
    given {
        context { decision_time @2025-12-31T09:00:00-05:00; knowledge_time @2025-12-31T09:00:00-05:00; legal_time @2025-12-31; timezone "America/New_York"; }
        assert interest_sale_consideration_received(entity_ref("urn:...#T3"), entity_ref("urn:...#P"), entity_ref("urn:...#PS"), 100000 USD) { id "f0"; origin case_input; }
        assert seller_share_of_liabilities_relieved_on_sale(entity_ref("urn:...#T3"), entity_ref("urn:...#P"), entity_ref("urn:...#PS"), 60000 USD) { id "f1"; origin case_input; }
        assert seller_outside_basis_before_sale(entity_ref("urn:...#T3"), entity_ref("urn:...#P"), entity_ref("urn:...#PS"), 15000 USD) { id "f2"; origin case_input; }
    }
    // realized = 100000 + 60000 = 160000; total = 160000 - 15000 = 145000.
    // Proceeds (160000) are an input; the gain (145000) is derived.
    evaluate truth(interest_sale_total_gain_computed(entity_ref("urn:...#T3"), entity_ref("urn:...#P"), entity_ref("urn:...#PS"), 145000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S15-08-SALE-ORDINARY-AND-CAPITAL-SPLIT" {
    given {
        context { decision_time @2025-12-31T09:00:00-05:00; knowledge_time @2025-12-31T09:00:00-05:00; legal_time @2025-12-31; timezone "America/New_York"; }
        assert interest_sale_consideration_received(entity_ref("urn:...#T3"), entity_ref("urn:...#P"), entity_ref("urn:...#PS"), 100000 USD) { id "f0"; origin case_input; }
        assert seller_share_of_liabilities_relieved_on_sale(entity_ref("urn:...#T3"), entity_ref("urn:...#P"), entity_ref("urn:...#PS"), 60000 USD) { id "f1"; origin case_input; }
        assert seller_outside_basis_before_sale(entity_ref("urn:...#T3"), entity_ref("urn:...#P"), entity_ref("urn:...#PS"), 15000 USD) { id "f2"; origin case_input; }
        assert amount_realized_attributable_to_hot_assets(entity_ref("urn:...#T3"), entity_ref("urn:...#P"), entity_ref("urn:...#PS"), 50000 USD) { id "f3"; origin case_input; }
        assert partner_basis_in_hot_assets_sold(entity_ref("urn:...#T3"), entity_ref("urn:...#P"), entity_ref("urn:...#PS"), 35000 USD) { id "f4"; origin case_input; }
    }
    // ordinary = 50000 - 35000 = 15000; capital = 145000 - 15000 = 130000.
    evaluate truth(interest_sale_capital_component(entity_ref("urn:...#T3"), entity_ref("urn:...#P"), entity_ref("urn:...#PS"), 130000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S15-09-BASIS-CARRIED-TO-SALE" {
    given {
        context { decision_time @2025-12-31T09:00:00-05:00; knowledge_time @2025-12-31T09:00:00-05:00; legal_time @2025-12-31; timezone "America/New_York"; }
        assert distributee_outside_basis_before_distribution(entity_ref("urn:...#T2"), entity_ref("urn:...#PS"), entity_ref("urn:...#P"), 40000 USD) { id "f0"; origin case_input; }
        assert money_distributed(entity_ref("urn:...#T2"), entity_ref("urn:...#PS"), entity_ref("urn:...#P"), 0 USD) { id "f1"; origin case_input; }
        assert partner_liability_share_decrease_in_transaction(entity_ref("urn:...#T2"), entity_ref("urn:...#P"), entity_ref("urn:...#PS"), 25000 USD) { id "f2"; origin case_input; }
        assert sale_basis_source(entity_ref("urn:...#T3"), entity_ref("urn:...#T2")) { id "f3"; origin case_input; }
    }
    // carried = t2's computed after-basis = 15000, by explicit event link.
    evaluate truth(outside_basis_carried_to_sale(entity_ref("urn:...#T3"), entity_ref("urn:...#P"), entity_ref("urn:...#PS"), 15000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S15-10-INCOMPLETE-HOT-BASIS-NO-SPLIT" {
    given {
        context { decision_time @2025-12-31T09:00:00-05:00; knowledge_time @2025-12-31T09:00:00-05:00; legal_time @2025-12-31; timezone "America/New_York"; }
        assert interest_sale_consideration_received(entity_ref("urn:...#T3"), entity_ref("urn:...#P"), entity_ref("urn:...#PS"), 100000 USD) { id "f0"; origin case_input; }
        assert seller_share_of_liabilities_relieved_on_sale(entity_ref("urn:...#T3"), entity_ref("urn:...#P"), entity_ref("urn:...#PS"), 60000 USD) { id "f1"; origin case_input; }
        assert seller_outside_basis_before_sale(entity_ref("urn:...#T3"), entity_ref("urn:...#P"), entity_ref("urn:...#PS"), 15000 USD) { id "f2"; origin case_input; }
        assert amount_realized_attributable_to_hot_assets(entity_ref("urn:...#T3"), entity_ref("urn:...#P"), entity_ref("urn:...#PS"), 50000 USD) { id "f3"; origin case_input; }
    }
    // No hot-asset basis: no ordinary component and no capital remainder —
    // incompleteness, not a zero split.
    evaluate truth(interest_sale_capital_component(entity_ref("urn:...#T3"), entity_ref("urn:...#P"), entity_ref("urn:...#PS"), 145000 USD));
    expect truth_status == NEITHER;
}
