// --- §707(b) ------------------------------------------------------------

test "S707b1-01-LOSS-DISALLOWED-MAJORITY-OWNER" {
    given {
        context { decision_time @2027-06-01T09:00:00-04:00; knowledge_time @2027-06-01T09:00:00-04:00; legal_time @2027-06-01; timezone "America/New_York"; }
        assert sale_or_exchange_of_property_with_controlled_partnership(entity_ref("urn:...#T4"), entity_ref("urn:...#P4"), entity_ref("urn:...#PS4"), false) { id "f0"; origin case_input; }
        assert loss_recognized_on_sale_with_controlled_partnership(entity_ref("urn:...#T4"), entity_ref("urn:...#P4"), entity_ref("urn:...#PS4"), 5000 USD) { id "f1"; origin case_input; }
        assert us.irc.core::ownership_interest(entity_ref("urn:...#OI4"), entity_ref("urn:...#P4"), entity_ref("urn:...#PS4"), 0.60) { id "f2"; origin case_input; }
    }
    evaluate truth(section_707b1_loss_disallowed(entity_ref("urn:...#T4"), entity_ref("urn:...#P4"), entity_ref("urn:...#PS4"), 5000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S707b1-02-NOT-DISALLOWED-AT-OR-BELOW-50-PERCENT" {
    given {
        context { decision_time @2027-06-01T09:00:00-04:00; knowledge_time @2027-06-01T09:00:00-04:00; legal_time @2027-06-01; timezone "America/New_York"; }
        assert sale_or_exchange_of_property_with_controlled_partnership(entity_ref("urn:...#T5"), entity_ref("urn:...#P5"), entity_ref("urn:...#PS5"), false) { id "f0"; origin case_input; }
        assert loss_recognized_on_sale_with_controlled_partnership(entity_ref("urn:...#T5"), entity_ref("urn:...#P5"), entity_ref("urn:...#PS5"), 5000 USD) { id "f1"; origin case_input; }
        assert us.irc.core::ownership_interest(entity_ref("urn:...#OI5"), entity_ref("urn:...#P5"), entity_ref("urn:...#PS5"), 0.50) { id "f2"; origin case_input; }
    }
    evaluate truth(section_707b1_loss_disallowed(entity_ref("urn:...#T5"), entity_ref("urn:...#P5"), entity_ref("urn:...#PS5"), 5000 USD));
    expect truth_status == NEITHER;
}

