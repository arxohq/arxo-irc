test "S709b1A-01-YEAR-ONE-DEDUCTION-UNDER-50000" {
    given {
        context { decision_time @2027-01-15T09:00:00-05:00; knowledge_time @2027-01-15T09:00:00-05:00; legal_time @2027-01-15; timezone "America/New_York"; }
        assert elects_to_deduct_organizational_expenses(entity_ref("urn:...#PS9")) { id "f0"; origin case_input; }
        assert organizational_expense(entity_ref("urn:...#PS9"), 1) { id "f1"; origin case_input; }
        assert amount_paid_or_incurred_to_organize_or_promote(entity_ref("urn:...#PS9"), entity_ref("urn:...#Y2026"), 1, 3000 USD) { id "f2"; origin case_input; }
        assert partnership_begins_business_in_year(entity_ref("urn:...#PS9"), entity_ref("urn:...#Y2026")) { id "f3"; origin case_input; }
    }
    evaluate truth(section_709b_election_in_effect(entity_ref("urn:...#PS9")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(organizational_expenses_aggregate(entity_ref("urn:...#PS9"), 3000 USD));
    expect truth_status == TRUE_ONLY;
    evaluate truth(section_709b1A_deduction(entity_ref("urn:...#PS9"), entity_ref("urn:...#Y2026"), 3000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S709b1A-02-YEAR-ONE-DEDUCTION-PHASED-OUT-ABOVE-50000" {
    given {
        context { decision_time @2027-01-15T09:00:00-05:00; knowledge_time @2027-01-15T09:00:00-05:00; legal_time @2027-01-15; timezone "America/New_York"; }
        assert elects_to_deduct_organizational_expenses(entity_ref("urn:...#PS10")) { id "f0"; origin case_input; }
        assert organizational_expense(entity_ref("urn:...#PS10"), 1) { id "f1"; origin case_input; }
        assert amount_paid_or_incurred_to_organize_or_promote(entity_ref("urn:...#PS10"), entity_ref("urn:...#Y2026"), 1, 53000 USD) { id "f2"; origin case_input; }
        assert partnership_begins_business_in_year(entity_ref("urn:...#PS10"), entity_ref("urn:...#Y2026")) { id "f3"; origin case_input; }
    }
    // $5,000 reduced by (53000-50000)=3000 -> 2000
    evaluate truth(section_709b1A_deduction(entity_ref("urn:...#PS10"), entity_ref("urn:...#Y2026"), 2000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S709b1B-01-REMAINDER-AMORTIZED-RATABLY" {
    given {
        context { decision_time @2027-01-15T09:00:00-05:00; knowledge_time @2027-01-15T09:00:00-05:00; legal_time @2027-01-15; timezone "America/New_York"; }
        assert elects_to_deduct_organizational_expenses(entity_ref("urn:...#PS11")) { id "f0"; origin case_input; }
        assert organizational_expense(entity_ref("urn:...#PS11"), 1) { id "f1"; origin case_input; }
        assert amount_paid_or_incurred_to_organize_or_promote(entity_ref("urn:...#PS11"), entity_ref("urn:...#Y2026"), 1, 23000 USD) { id "f2"; origin case_input; }
        assert partnership_begins_business_in_year(entity_ref("urn:...#PS11"), entity_ref("urn:...#Y2026")) { id "f3"; origin case_input; }
        assert section_709b1B_amortization_month_fraction_for_year(entity_ref("urn:...#PS11"), entity_ref("urn:...#Y2026"), 0.10) { id "f4"; origin case_input; }
    }
    // year-one deduction = 5000; remainder = 18000; 10% of remainder = 1800
    evaluate truth(section_709b1B_deduction(entity_ref("urn:...#PS11"), entity_ref("urn:...#Y2026"), 1800.00 USD));
    expect truth_status == TRUE_ONLY;
}
