test "S724c-01-CAPITAL-LOSS-CHARACTER-CAPPED-AT-PRECONTRIBUTION-EXCESS" {
    given {
        context { decision_time @2028-01-01T09:00:00-05:00; knowledge_time @2028-01-01T09:00:00-05:00; legal_time @2028-01-01; timezone "America/New_York"; }
        assert contribution_of_property(entity_ref("urn:...#TC10"), entity_ref("urn:...#CONTRIB10"), entity_ref("urn:...#PS10"), entity_ref("urn:...#PROP10"), entity_ref("urn:...#OI10")) { id "f0"; origin case_input; }
        assert contributor_pre_contribution_capital_asset(entity_ref("urn:...#TC10"), entity_ref("urn:...#PROP10"), entity_ref("urn:...#CONTRIB10")) { id "f1"; origin case_input; }
        assert contribution_date(entity_ref("urn:...#TC10"), entity_ref("urn:...#PROP10"), @2024-01-01) { id "f2"; origin case_input; }
        assert partnership_disposition_loss(entity_ref("urn:...#PS10"), entity_ref("urn:...#PROP10"), entity_ref("urn:...#TD10"), 9000 USD) { id "f3"; origin case_input; }
        assert disposition_date(entity_ref("urn:...#TD10"), entity_ref("urn:...#PROP10"), @2027-06-01) { id "f4"; origin case_input; }
        assert contributor_basis_exceeded_fmv_at_contribution(entity_ref("urn:...#TC10"), entity_ref("urn:...#PROP10"), entity_ref("urn:...#CONTRIB10"), 5000 USD) { id "f5"; origin case_input; }
    }
    // recognized loss 9000 capped at the pre-contribution excess of 5000
    evaluate truth(section_724c_capital_loss_character(entity_ref("urn:...#PS10"), entity_ref("urn:...#PROP10"), entity_ref("urn:...#TD10"), 5000 USD));
    expect truth_status == TRUE_ONLY;
}
