        assert contribution_date(entity_ref("urn:...#TC4"), entity_ref("urn:...#PROP4"), @2024-01-01) { id "f1"; origin case_input; }
    }
    evaluate truth(section_704c1B_within_7_years(entity_ref("urn:...#TD4"), entity_ref("urn:...#PS4"), entity_ref("urn:...#PROP4"), entity_ref("urn:...#CONTRIB4")));
