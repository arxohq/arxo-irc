}

// --- §704(e): family partnerships -------------------------------------------

test "S704e-01-DONEE-SHARE-INCLUDIBLE" {
    given {
        context { decision_time @2027-06-01T09:00:00-04:00; knowledge_time @2027-06-01T09:00:00-04:00; legal_time @2027-06-01; timezone "America/New_York"; }
        assert partnership_interest_created_by_gift(entity_ref("urn:...#DONEE"), entity_ref("urn:...#PS5")) { id "f0"; origin case_input; }
        assert donee_distributive_share_per_agreement(entity_ref("urn:...#DONEE"), entity_ref("urn:...#PS5"), entity_ref("urn:...#Y2026"), 12000 USD) { id "f1"; origin case_input; }
    }
    evaluate truth(donee_distributive_share_includible(entity_ref("urn:...#DONEE"), entity_ref("urn:...#PS5"), entity_ref("urn:...#Y2026"), 12000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S704e2-01-PURCHASE-FROM-FAMILY-MEMBER-TREATED-AS-GIFT" {
    given {
        context { decision_time @2027-06-01T09:00:00-04:00; knowledge_time @2027-06-01T09:00:00-04:00; legal_time @2027-06-01; timezone "America/New_York"; }
        assert interest_purchased_from_family_member(entity_ref("urn:...#CHILD"), entity_ref("urn:...#PARENT"), entity_ref("urn:...#PS6"), 5000 USD, 20000 USD) { id "f0"; origin case_input; }
    }
    evaluate truth(interest_treated_as_created_by_gift(entity_ref("urn:...#CHILD"), entity_ref("urn:...#PARENT"), entity_ref("urn:...#PS6")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(purchased_interest_donated_capital(entity_ref("urn:...#CHILD"), entity_ref("urn:...#PS6"), 20000 USD));
    expect truth_status == TRUE_ONLY;
    evaluate truth(partnership_interest_created_by_gift(entity_ref("urn:...#CHILD"), entity_ref("urn:...#PS6")));
    expect truth_status == TRUE_ONLY;
}

// --- §724: character of contributed unrealized receivables/inventory/loss --

test "S724a-01-UNREALIZED-RECEIVABLE-ORDINARY-GAIN-NO-TIME-LIMIT" {
    given {
        context { decision_time @2035-01-01T09:00:00-05:00; knowledge_time @2035-01-01T09:00:00-05:00; legal_time @2035-01-01; timezone "America/New_York"; }
        assert contribution_of_property(entity_ref("urn:...#TC7"), entity_ref("urn:...#CONTRIB7"), entity_ref("urn:...#PS7"), entity_ref("urn:...#PROP7"), entity_ref("urn:...#OI7")) { id "f0"; origin case_input; }
        assert contributor_pre_contribution_unrealized_receivable(entity_ref("urn:...#TC7"), entity_ref("urn:...#PROP7"), entity_ref("urn:...#CONTRIB7")) { id "f1"; origin case_input; }
        assert partnership_disposition_gain(entity_ref("urn:...#PS7"), entity_ref("urn:...#PROP7"), entity_ref("urn:...#TD7"), 3000 USD) { id "f2"; origin case_input; }
    }
    evaluate truth(section_724a_ordinary_character(entity_ref("urn:...#PS7"), entity_ref("urn:...#PROP7"), entity_ref("urn:...#TD7"), 3000 USD, true));
    expect truth_status == TRUE_ONLY;
}

