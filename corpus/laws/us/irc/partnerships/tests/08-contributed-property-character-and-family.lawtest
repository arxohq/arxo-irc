language "law.core" version "0.2";
package us.irc.partnerships version "0.1.1";
namespace "urn:us:irc:partnerships:clir";

// --- §704(c)(1)(A)/(C): built-in gain/loss and the ceiling rule -------------

test "S704c1A-01-BUILT-IN-GAIN-ALLOCATED-UP-TO-CEILING" {
    given {
        context { decision_time @2027-06-01T09:00:00-04:00; knowledge_time @2027-06-01T09:00:00-04:00; legal_time @2027-06-01; timezone "America/New_York"; }
        assert contribution_of_property(entity_ref("urn:...#TC"), entity_ref("urn:...#CONTRIB"), entity_ref("urn:...#PS1"), entity_ref("urn:...#PROP"), entity_ref("urn:...#OI1")) { id "f0"; origin case_input; }
        assert partnership_basis_in_contributed_property(entity_ref("urn:...#PS1"), entity_ref("urn:...#PROP"), entity_ref("urn:...#TC"), 10000 USD) { id "f1"; origin case_input; }
        assert fmv_of_contributed_property_at_contribution(entity_ref("urn:...#TC"), entity_ref("urn:...#PROP"), 30000 USD) { id "f2"; origin case_input; }
        assert partnership_recognized_gain_on_disposition(entity_ref("urn:...#PS1"), entity_ref("urn:...#PROP"), entity_ref("urn:...#TD"), 15000 USD) { id "f3"; origin case_input; }
    }
    // built-in gain = 30000 - 10000 = 20000; recognized = 15000; ceiling limits allocation to 15000
    evaluate truth(section_704c_built_in_gain(entity_ref("urn:...#PS1"), entity_ref("urn:...#PROP"), entity_ref("urn:...#TC"), entity_ref("urn:...#CONTRIB"), 20000 USD));
    expect truth_status == TRUE_ONLY;
    evaluate truth(section_704c_allocation(entity_ref("urn:...#CONTRIB"), entity_ref("urn:...#PS1"), entity_ref("urn:...#TD"), entity_ref("urn:...#PROP"), 15000 USD));
    expect truth_status == TRUE_ONLY;
    evaluate truth(section_704c_ceiling_rule_shortfall(entity_ref("urn:...#PS1"), entity_ref("urn:...#PROP"), entity_ref("urn:...#TD"), 5000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S704c1C-01-BUILT-IN-LOSS-CHARGED-ONLY-TO-CONTRIBUTOR" {
    given {
        context { decision_time @2027-06-01T09:00:00-04:00; knowledge_time @2027-06-01T09:00:00-04:00; legal_time @2027-06-01; timezone "America/New_York"; }
        assert contribution_of_property(entity_ref("urn:...#TC2"), entity_ref("urn:...#CONTRIB2"), entity_ref("urn:...#PS2"), entity_ref("urn:...#PROP2"), entity_ref("urn:...#OI2")) { id "f0"; origin case_input; }
        assert partnership_basis_in_contributed_property(entity_ref("urn:...#PS2"), entity_ref("urn:...#PROP2"), entity_ref("urn:...#TC2"), 10000 USD) { id "f1"; origin case_input; }
        assert fmv_of_contributed_property_at_contribution(entity_ref("urn:...#TC2"), entity_ref("urn:...#PROP2"), 6000 USD) { id "f2"; origin case_input; }
    }
    // built-in loss = 10000 - 6000 = 4000
    evaluate truth(section_704c_built_in_loss(entity_ref("urn:...#PS2"), entity_ref("urn:...#PROP2"), entity_ref("urn:...#TC2"), entity_ref("urn:...#CONTRIB2"), 4000 USD));
    expect truth_status == TRUE_ONLY;
    evaluate truth(section_704c1C_loss_charged_only_to_contributor(entity_ref("urn:...#PS2"), entity_ref("urn:...#PROP2"), entity_ref("urn:...#TC2"), entity_ref("urn:...#CONTRIB2"), 4000 USD));
    expect truth_status == TRUE_ONLY;
    evaluate truth(section_704c1C_basis_to_other_partners(entity_ref("urn:...#PS2"), entity_ref("urn:...#PROP2"), entity_ref("urn:...#TC2"), 6000 USD));
    expect truth_status == TRUE_ONLY;
}

// --- §704(c)(1)(B): 7-year deemed sale on distribution to another partner --

test "S704c1B-01-DISTRIBUTION-WITHIN-7-YEARS-DEEMED-GAIN" {
    given {
        context { decision_time @2029-01-01T09:00:00-05:00; knowledge_time @2029-01-01T09:00:00-05:00; legal_time @2029-01-01; timezone "America/New_York"; }
        assert distribution_of_contributed_property_to_other_partner(entity_ref("urn:...#TD3"), entity_ref("urn:...#PS3"), entity_ref("urn:...#PROP3"), entity_ref("urn:...#TC3"), entity_ref("urn:...#CONTRIB3"), entity_ref("urn:...#OTHER3"), @2028-06-01) { id "f0"; origin case_input; }
        assert contribution_date(entity_ref("urn:...#TC3"), entity_ref("urn:...#PROP3"), @2024-01-01) { id "f1"; origin case_input; }
        assert partnership_basis_in_contributed_property(entity_ref("urn:...#PS3"), entity_ref("urn:...#PROP3"), entity_ref("urn:...#TC3"), 10000 USD) { id "f2"; origin case_input; }
        assert fmv_of_property_at_distribution(entity_ref("urn:...#TD3"), entity_ref("urn:...#PROP3"), 18000 USD) { id "f3"; origin case_input; }
    }
    evaluate truth(section_704c1B_within_7_years(entity_ref("urn:...#TD3"), entity_ref("urn:...#PS3"), entity_ref("urn:...#PROP3"), entity_ref("urn:...#CONTRIB3")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(section_704c1B_deemed_gain_or_loss(entity_ref("urn:...#TD3"), entity_ref("urn:...#PS3"), entity_ref("urn:...#PROP3"), entity_ref("urn:...#CONTRIB3"), 8000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S704c1B-02-DISTRIBUTION-AFTER-7-YEARS-NOT-WITHIN-WINDOW" {
    given {
        context { decision_time @2032-01-01T09:00:00-05:00; knowledge_time @2032-01-01T09:00:00-05:00; legal_time @2032-01-01; timezone "America/New_York"; }
