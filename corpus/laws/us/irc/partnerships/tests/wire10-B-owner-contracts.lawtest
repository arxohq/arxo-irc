// Partnerships WIRE-10 group B scenarios. NOT EXECUTED (implemented_unverified); no legal review.

language "law.core" version "0.2";
package us.irc.partnerships version "0.1.1";
namespace "urn:us:irc:partnerships:clir";

test "W10B-PS-01-CORPORATION-ORGANIZATION-FROM-DEFINITIONS" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.definitions::corporation(entity_ref("urn:test:w10b:p1#o")) { origin case_input; }
    }
    evaluate truth(is_corporation_trust_or_estate(entity_ref("urn:test:w10b:p1#o")));
    expect truth_status == TRUE_ONLY;
}

test "W10B-PS-02-CLASSIFICATION-STILL-ACCEPTS-THE-CASE-FACT" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": is_corporation_trust_or_estate(entity_ref("urn:test:w10b:p2#o")) { origin case_input; }
    }
    evaluate truth(is_corporation_trust_or_estate(entity_ref("urn:test:w10b:p2#o")));
    expect truth_status == TRUE_ONLY;
}
