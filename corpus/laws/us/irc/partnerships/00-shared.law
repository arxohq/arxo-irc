// 26 U.S.C. Subchapter K, Part I §701 (partners, not partnership, subject to
// tax) and shared ontology for the whole package: which persons are partners
// of which partnership, and the separately-stated-item vocabulary §702(a)
// classifies income into. Every other module of this stage imports these
// relations; nothing here duplicates `us.irc.core`.
//
// `Partnership` and `OwnershipInterest(holder, held_in, share)` are core's
// (CONTRACT.md); this package adds no new entity for "partner" — a partner
// is simply a `Person` that core's `ownership_interest` links to a
// `Partnership`. `share: Decimal` on `ownership_interest` is read here as
// the partner's percentage interest in partnership profits/capital where a
// section needs a bare percentage (e.g. §706(b)(3)'s "5 percent... interest
// in partnership profits or capital"); where profits and capital interests
// diverge (they can, e.g. after a special allocation) the case asserts two
// separate `ownership_interest` facts is NOT supported by core's single
// `share` field — TECH_GAP, see TECH-GAPS.md row `us.irc.partnerships-01`.

language "law.core" version "0.2";
package us.irc.partnerships version "0.1.1";
namespace "urn:us:irc:partnerships:clir";

import us.irc.core version "0.1.1";
import us.irc.property_transactions version "0.1.1";
import us.irc.corporations version "0.1.1";
import us.irc.deductions version "0.1.1";
import us.irc.accounting version "0.1.1";
import us.irc.definitions version "0.1.1";

use self::{
    IRC_S701,
};

type Person = us.irc.core::Person;
type Partnership = us.irc.core::Partnership;
type TaxableYear = us.irc.core::TaxableYear;
type OwnershipInterest = us.irc.core::OwnershipInterest;
type Asset = us.irc.core::Asset;
type Transaction = us.irc.core::Transaction;

const Secretary: us.irc.core::Organ = us.irc.core::Secretary;

// --- Ownership-derived partner status ---------------------------------------

pub relation is_partner(partner: Person, pship: Partnership) kind institutional {
    label en unofficial "the person holds an ownership_interest in the partnership (core's OwnershipInterest is this package's evidentiary shape for 'partner', §761(b))";
}
rule IsPartnerFromOwnershipInterest(partner: Person, pship: Partnership) strict {
    when us.irc.core::ownership_interest(_, partner, pship, _);
    then is_partner(partner, pship);
}

pub relation partnership_interest_share(partner: Person, pship: Partnership, share: Decimal) kind institutional {
    label en unofficial "the partner's percentage interest in the partnership, read from core's ownership_interest.share (profits/capital not separately tracked — see header note and TECH-GAPS.md)";
}
rule PartnershipInterestShareFromOwnership(partner: Person, pship: Partnership, share: Decimal) strict {
    when us.irc.core::ownership_interest(_, partner, pship, share);
    then partnership_interest_share(partner, pship, share);
}

// --- §701: partners, not the partnership, are subject to income tax --------

@source(IRC_S701, relation = formalizes, coverage = exact, quote = "A partnership as such shall not be subject to the income tax imposed by this chapter. Persons carrying on business as partners shall be liable for income tax only in their separate or individual capacities.")
pub relation partnership_not_subject_to_income_tax(pship: Partnership) kind institutional {
    label en official "A partnership as such shall not be subject to the income tax imposed by this chapter (section 701, sentence 1)";
}
rule S701PartnershipItselfNotTaxed(pship: Partnership) strict {
    when is_partner(_, pship);
    then partnership_not_subject_to_income_tax(pship);
}

@source(IRC_S701, relation = formalizes, coverage = exact, quote = "Persons carrying on business as partners shall be liable for income tax only in their separate or individual capacities.")
pub relation partner_liable_in_separate_capacity(partner: Person, pship: Partnership) kind institutional {
    label en official "persons carrying on business as partners are liable for income tax only in their separate or individual capacities (section 701, sentence 2)";
}
rule S701PartnerLiableIndividually(partner: Person, pship: Partnership) strict {
    when is_partner(partner, pship);
    then partner_liable_in_separate_capacity(partner, pship);
}

// --- §702(a): the eight classes of separately stated items ------------------

enum DistributiveShareItem {
    ShortTermCapitalGainLoss;
    LongTermCapitalGainLoss;
    Section1231GainLoss;
    CharitableContribution;
    Section1h11Dividend;
    ForeignAndPossessionTax;
    OtherSeparatelyStatedItem;
    ResidualTaxableIncomeOrLoss;
}
