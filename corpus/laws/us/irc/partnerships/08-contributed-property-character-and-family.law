// 26 U.S.C. §704(c), §704(e)-(f), §724 — stage 2b: contributed-property
// built-in gain/loss allocation, family partnerships, and the character of
// gain/loss on a later disposition of contributed unrealized
// receivables/inventory/capital-loss property.
//
// JUDGMENT CALLS AND GAPS (see report):
//  - §704(c)(1)(A): the general command ("shared among the partners so as to
//    take account of the variation... under regulations prescribed by the
//    Secretary") is executed here as the min(recognized, built-in) CEILING
//    computation itself (`section_704c_allocation`), which is the one part
//    of Treas. Reg. 1.704-3 that is arithmetic, not a REGULATORY CHOICE: a
//    partnership can never allocate the contributing partner MORE built-in
//    gain/loss than it actually recognizes on disposition. What regulations
//    do next when there IS a shortfall (the "ceiling rule problem" —
//    curative or remedial allocations of OTHER items to OTHER partners to
//    cure the shortfall, Treas. Reg. 1.704-3(c)-(d)) is a genuine regulatory
//    CHOICE of method among several the statute itself does not pick —
//    EXTERNAL_DEPENDENCY, exposed as `section_704c_ceiling_rule_shortfall`
//    (computed, so a case can see the number) feeding only a case-asserted
//    `section_704c_ceiling_rule_cure` fact, never invented by this package.
//  - §704(c)(1)(B): the 7-year distribution-to-another-partner deemed-sale
//    rule is modeled as its own event (distinct from an actual disposition
//    BY the partnership) with an exact `add_calendar_period(…, 7
//    calendar_year)` window test — EXECUTABLE, no ceiling limitation (a
//    deemed sale, not an actual one, so (c)(1)(A)'s ceiling does not apply
//    to it, matching the statute's own text: "treated as recognizing gain
//    or loss... in an amount equal to the gain or loss which would have
//    been allocated... under subparagraph (A)").
//  - §704(c)(2): the like-kind-replacement special rule's own "not later
//    than the EARLIER of the 180th day or the extended due date" test is
//    rewritten as a CONJUNCTION (on-or-before BOTH deadlines), which is
//    logically equivalent to "on or before the earlier one" and avoids the
//    `min(Date, Date)` gap already on record for other packages
//    (TECH-GAPS.md, `gross-income`'s G210/G225 note) — EXECUTABLE, exact
//    dates. Only the boundary TEST is modeled; the substantive
//    re-characterization (treating the like-kind property as if it were
//    the original contribution for purposes of (c)(1)(B)) is exposed as its
//    own institutional fact a consumer can read, not silently merged into
//    the general 704(c)(1)(B) rule's own head (keeps the two provisions'
//    outputs separately inspectable).
//  - §704(c)(3) ("rules similar to the rules of paragraph (1) shall apply to
//    contributions... of accounts payable and other accrued but unpaid
//    items" — cash-method contributors) is a further regulatory delegation
//    ("under regulations prescribed by the Secretary") with no self-
//    executing content of its own beyond "similar to (1)" — EXTERNAL_
//    DEPENDENCY (no regulation pinned by this snapshot), not re-derived.
//  - §704(e)(1): the donee's distributive share is EXECUTABLE gross-income
//    inclusion up to two carve-outs. The FIRST carve-out ("except to the
//    extent... determined without allowance of reasonable compensation for
//    services rendered... by the donor") is EVALUATIVE under DECISION-0194
//    (an `external judgment` channel — "reasonable compensation" is not an
//    arithmetic guard): modeled as a case-asserted reasonable-compensation
//    AMOUNT (an authority determination, not invented) subtracted before
//    inclusion. The SECOND carve-out (donated-capital share disproportion)
//    is a plain ratio comparison, EXECUTABLE.
//  - §704(e)(2) (purchase by a family member deemed a gift) is a plain
//    definitional rule, EXECUTABLE; the closed "family" list (spouse,
//    ancestors, lineal descendants, primary-benefit trusts) is modeled as
//    an enum-free case-asserted classification of the RESULT (not a kinship
//    graph this package would need to build) — the statute's closed word
//    list is transcribed as a boolean input fact per relative, not
//    re-derived from a family tree this package's ontology doesn't carry.
//  - §704(f) is a pure cross-reference to section 706(c)(2) (already
//    formalized in module 03) — NON_NORMATIVE, no new rule.
//  - §724(a)-(c): "unrealized receivable"/"inventory item" are imported from
//    this package's OWN §751(c)-(d) implementations (module 11), per
//    §724(d)(1)-(2)'s own cross-reference (reading "partnership" as
//    "partner" — modeled as a separate case-asserted classification of the
//    CONTRIBUTOR's pre-contribution character, not a re-run of the
//    partnership-level 751(c)/(d) tests against the wrong entity). §724(c)'s
//    loss cap ("to the extent that... adjusted basis... exceeded... fair
//    market value") reuses the same built-in-loss shape as §704(c)(1)(C).
//  - §724(d)(3) (substituted basis property carryover in a nonrecognition
//    transaction, C-corporation-stock exception) is modeled as a
//    character-carryover relation keyed to the ORIGINAL contributed
//    property's disposition fact, not a general nonrecognition-transaction
//    graph traversal this package does not otherwise carry — a case that
//    asserts a chain of substitutions asserts each link's carryover fact
//    directly (matching module 04's existing "case supplies the finite
//    fact set" convention).

language "law.core" version "0.2";
package us.irc.partnerships version "0.1.1";
namespace "urn:us:irc:partnerships:clir";

use self::{
    Asset,
    IRC_S704_C,
    IRC_S704_E,
    IRC_S724_A,
    IRC_S724_B,
    IRC_S724_C,
    IRC_S724_D,
    OwnershipInterest,
    Partnership,
    Person,
    TaxableYear,
    Transaction,
    contribution_of_property,
    partnership_basis_in_contributed_property,
};

// ============================================================================
// §704(c)(1): contributed property — built-in gain/loss
// ============================================================================

pub relation fmv_of_contributed_property_at_contribution(t: Transaction, prop: Asset, amount: Money) kind empirical {
    label en unofficial "the fair market value of the contributed property at the time of the section 721 contribution (section 704(c)(1)(A) input fact)";
}

pub relation section_704c_built_in_gain(pship: Partnership, prop: Asset, t: Transaction, contributor: Person, amount: Money) kind institutional {
    label en official "the excess (if any) of the contributed property's fair market value over its adjusted basis to the partnership at the time of contribution — the section 704(c)(1)(A) 'variation' when it favors the contributor (built-in gain)";
}
@source(IRC_S704_C, relation = formalizes, coverage = partial, quote = "income, gain, loss, and deduction with respect to property contributed to the partnership by a partner shall be shared among the partners so as to take account of the variation between the basis of the property to the partnership and its fair market value at the time of contribution")
rule S704cBuiltInGain(pship: Partnership, prop: Asset, t: Transaction, contributor: Person, basis: Money, fmv: Money) defeasible {
    when contribution_of_property(t, contributor, pship, prop, _);
    when partnership_basis_in_contributed_property(pship, prop, t, basis);
    when fmv_of_contributed_property_at_contribution(t, prop, fmv);
    then section_704c_built_in_gain(pship, prop, t, contributor, max(0 USD, fmv - basis));
}

pub relation section_704c_built_in_loss(pship: Partnership, prop: Asset, t: Transaction, contributor: Person, amount: Money) kind institutional {
    label en official "the excess of the contributed property's adjusted basis (determined without regard to subparagraph (C)(ii)) over its fair market value at the time of contribution — the section 704(c)(1)(C) 'built-in loss'";
}
@source(IRC_S704_C, relation = formalizes, coverage = exact, quote = "the term \"built-in loss\" means the excess of the adjusted basis of the property (determined without regard to subparagraph (C)(ii)) over its fair market value at the time of contribution")
rule S704cBuiltInLossDefinition(pship: Partnership, prop: Asset, t: Transaction, contributor: Person, basis: Money, fmv: Money) defeasible {
    when contribution_of_property(t, contributor, pship, prop, _);
    when partnership_basis_in_contributed_property(pship, prop, t, basis);
    when fmv_of_contributed_property_at_contribution(t, prop, fmv);
    then section_704c_built_in_loss(pship, prop, t, contributor, max(0 USD, basis - fmv));
}

@source(IRC_S704_C, relation = formalizes, coverage = exact, quote = "such built-in loss shall be taken into account only in determining the amount of items allocated to the contributing partner, and")
pub relation section_704c1C_loss_charged_only_to_contributor(pship: Partnership, prop: Asset, t: Transaction, contributor: Person, amount: Money) kind institutional {
    label en official "the section 704(c)(1)(C) built-in loss is taken into account only in determining the amount of items allocated to the contributing partner (section 704(c)(1)(C)(i))";
}
rule S704c1CLossToContributorOnly(pship: Partnership, prop: Asset, t: Transaction, contributor: Person, loss: Money) defeasible {
    when section_704c_built_in_loss(pship, prop, t, contributor, loss);
    when loss > 0 USD;
    then section_704c1C_loss_charged_only_to_contributor(pship, prop, t, contributor, loss);
}

@source(IRC_S704_C, relation = formalizes, coverage = exact, quote = "except as provided in regulations, in determining the amount of items allocated to other partners, the basis of the contributed property in the hands of the partnership shall be treated as being equal to its fair market value at the time of contribution")
pub relation section_704c1C_basis_to_other_partners(pship: Partnership, prop: Asset, t: Transaction, amount: Money) kind institutional {
    label en official "for purposes of items allocated to partners OTHER than the contributing partner, section 704(c)(1)(C) treats the contributed property's basis to the partnership as equal to its fair market value at the time of contribution (section 704(c)(1)(C)(ii))";
}
rule S704c1COtherPartnersBasisIsFmv(pship: Partnership, prop: Asset, t: Transaction, contributor: Person, fmv: Money, built_in_loss: Money) defeasible {
    when fmv_of_contributed_property_at_contribution(t, prop, fmv);
    when section_704c_built_in_loss(pship, prop, t, contributor, built_in_loss);
    when built_in_loss > 0 USD;
    unless section_704c1c2_regulation_overrides(pship, prop, t) and fmv_of_contributed_property_at_contribution(t, prop, fmv);
    then section_704c1C_basis_to_other_partners(pship, prop, t, fmv);
}
relation section_704c1c2_regulation_overrides(pship: Partnership, prop: Asset, t: Transaction) kind institutional {
    label en unofficial "EXTERNAL_DEPENDENCY (26 CFR, section 704(c)(1)(C)(ii) 'except as provided in regulations' delegated exception, not reproduced by this package) — case-asserted";
}

// --- ceiling-limited allocation on an ACTUAL disposition by the partnership

pub relation partnership_recognized_gain_on_disposition(pship: Partnership, prop: Asset, t: Transaction, amount: Money) kind empirical {
    label en unofficial "the amount of gain the partnership actually recognizes on a disposition of the contributed property (section 704(c)(1)(A) 'ceiling rule' input — a partnership can never allocate the contributing partner more built-in gain than this)";
}
pub relation partnership_recognized_loss_on_disposition(pship: Partnership, prop: Asset, t: Transaction, amount: Money) kind empirical {
    label en unofficial "the amount of loss the partnership actually recognizes on a disposition of the contributed property (ceiling rule input for built-in loss)";
}

pub relation section_704c_allocation(partner: Person, pship: Partnership, t: Transaction, prop: Asset, amount: Money) kind institutional {
    label en official "the built-in gain or loss allocated to the contributing partner on an actual disposition of the contributed property by the partnership — the section 704(c)(1)(A) ceiling-limited amount: the lesser of the section 704(c) built-in gain/loss and the partnership's own recognized gain/loss on the disposition";
}
@source(IRC_S704_C, relation = formalizes, coverage = partial, quote = "income, gain, loss, and deduction with respect to property contributed to the partnership by a partner shall be shared among the partners so as to take account of the variation between the basis of the property to the partnership and its fair market value at the time of contribution")
rule S704cAllocationGain(partner: Person, pship: Partnership, t: Transaction, prop: Asset, built_in: Money, recognized: Money) defeasible {
    label en official "on an actual disposition, the contributing partner is allocated the lesser of the built-in gain and the partnership's recognized gain (section 704(c)(1)(A), the arithmetic core of the Treas. Reg. 1.704-3 ceiling rule)";
    when section_704c_built_in_gain(pship, prop, _, partner, built_in);
    when built_in > 0 USD;
    when partnership_recognized_gain_on_disposition(pship, prop, t, recognized);
    then section_704c_allocation(partner, pship, t, prop, min(built_in, recognized));
}
rule S704cAllocationLoss(partner: Person, pship: Partnership, t: Transaction, prop: Asset, built_in: Money, recognized: Money) defeasible {
    label en official "on an actual disposition, the contributing partner is allocated the lesser of the built-in loss and the partnership's recognized loss (section 704(c)(1)(A)/(C), the arithmetic core of the ceiling rule)";
    when section_704c_built_in_loss(pship, prop, _, partner, built_in);
    when built_in > 0 USD;
    when partnership_recognized_loss_on_disposition(pship, prop, t, recognized);
    then section_704c_allocation(partner, pship, t, prop, min(built_in, recognized));
}

pub relation section_704c_ceiling_rule_shortfall(pship: Partnership, prop: Asset, t: Transaction, amount: Money) kind institutional {
    label en unofficial "the amount of built-in gain/loss the section 704(c)(1)(A) ceiling rule PREVENTS from being allocated to the contributing partner (built-in amount minus the partnership's recognized amount, when the latter is smaller) — EXTERNAL_DEPENDENCY as to what cures it (Treas. Reg. 1.704-3(c)-(d) curative/remedial allocations, a genuine regulatory choice of method, not reproduced by this package)";
}
rule S704cCeilingShortfallGain(pship: Partnership, prop: Asset, t: Transaction, built_in: Money, recognized: Money) defeasible {
    when section_704c_built_in_gain(pship, prop, _, _, built_in);
    when partnership_recognized_gain_on_disposition(pship, prop, t, recognized);
    when recognized < built_in;
    then section_704c_ceiling_rule_shortfall(pship, prop, t, built_in - recognized);
}
rule S704cCeilingShortfallLoss(pship: Partnership, prop: Asset, t: Transaction, built_in: Money, recognized: Money) defeasible {
    when section_704c_built_in_loss(pship, prop, _, _, built_in);
    when partnership_recognized_loss_on_disposition(pship, prop, t, recognized);
    when recognized < built_in;
    then section_704c_ceiling_rule_shortfall(pship, prop, t, built_in - recognized);
}
relation section_704c_ceiling_rule_cure(pship: Partnership, prop: Asset, t: Transaction) kind institutional {
    label en unofficial "EXTERNAL_DEPENDENCY (Treas. Reg. 1.704-3(c) curative or (d) remedial allocation of other partnership items to cure a ceiling-rule shortfall) — case-asserted only, never invented";
}

// --- §704(c)(1)(B): 7-year distribution-to-another-partner deemed sale -----

pub relation contribution_date(t: Transaction, prop: Asset, on: Date) kind empirical {
    label en unofficial "the date the contribution transaction occurred (section 704(c)(1)(B) window anchor)";
}
pub relation distribution_of_contributed_property_to_other_partner(t_distribution: Transaction, pship: Partnership, prop: Asset, t_contribution: Transaction, contributor: Person, distributee: Person, on: Date) kind empirical {
    label en unofficial "the partnership distributed the contributed property, directly or indirectly, to a partner OTHER than the contributing partner, on the given date (section 704(c)(1)(B) chapeau)";
}
pub relation fmv_of_property_at_distribution(t_distribution: Transaction, prop: Asset, amount: Money) kind empirical {
    label en unofficial "the fair market value of the property at the time of the section 704(c)(1)(B) distribution (the 'deemed sale' price)";
}

pub relation section_704c1B_within_7_years(t_distribution: Transaction, pship: Partnership, prop: Asset, contributor: Person) kind institutional {
    label en official "the distribution to another partner occurred within 7 years of the property's contribution (section 704(c)(1)(B) chapeau, exact date window)";
}
@source(IRC_S704_C, relation = formalizes, coverage = exact, quote = "if any property so contributed is distributed (directly or indirectly) by the partnership (other than to the contributing partner) within 7 years of being contributed")
rule S704c1BWithin7Years(t_distribution: Transaction, pship: Partnership, prop: Asset, t_contribution: Transaction, contributor: Person, distributee: Person, contributed_on: Date, distributed_on: Date) strict {
    when distribution_of_contributed_property_to_other_partner(t_distribution, pship, prop, t_contribution, contributor, distributee, distributed_on);
    when distributee != contributor;
    when contribution_date(t_contribution, prop, contributed_on);
    when distributed_on <= add_calendar_period(contributed_on, 7 calendar_year);
    then section_704c1B_within_7_years(t_distribution, pship, prop, contributor);
}

pub relation section_704c1B_deemed_gain_or_loss(t_distribution: Transaction, pship: Partnership, prop: Asset, contributor: Person, amount: Money) kind institutional {
    label en official "the contributing partner is treated as recognizing gain or loss from a deemed sale of the property at its fair market value at the time of the distribution — the amount that would have been allocated under section 704(c)(1)(A) had the property been sold at that value (section 704(c)(1)(B)(i))";
}
@source(IRC_S704_C, relation = formalizes, coverage = exact, quote = "the contributing partner shall be treated as recognizing gain or loss (as the case may be) from the sale of such property in an amount equal to the gain or loss which would have been allocated to such partner under subparagraph (A) by reason of the variation described in subparagraph (A) if the property had been sold at its fair market value at the time of the distribution")
rule S704c1BDeemedGain(t_distribution: Transaction, pship: Partnership, prop: Asset, contributor: Person, t_contribution: Transaction, basis: Money, fmv_at_distribution: Money) defeasible {
    when section_704c1B_within_7_years(t_distribution, pship, prop, contributor);
    when partnership_basis_in_contributed_property(pship, prop, t_contribution, basis);
    when fmv_of_property_at_distribution(t_distribution, prop, fmv_at_distribution);
    when fmv_at_distribution > basis;
    then section_704c1B_deemed_gain_or_loss(t_distribution, pship, prop, contributor, fmv_at_distribution - basis);
}
rule S704c1BDeemedLoss(t_distribution: Transaction, pship: Partnership, prop: Asset, contributor: Person, t_contribution: Transaction, basis: Money, fmv_at_distribution: Money) defeasible {
    when section_704c1B_within_7_years(t_distribution, pship, prop, contributor);
    when partnership_basis_in_contributed_property(pship, prop, t_contribution, basis);
    when fmv_of_property_at_distribution(t_distribution, prop, fmv_at_distribution);
    when fmv_at_distribution < basis;
    then section_704c1B_deemed_gain_or_loss(t_distribution, pship, prop, contributor, basis - fmv_at_distribution);
}

// --- §704(c)(2): like-kind replacement within the earlier of two deadlines -

pub relation like_kind_replacement_distributed_to_contributor(t_distribution: Transaction, t_replacement: Transaction, pship: Partnership, contributor: Person, replacement_prop: Asset, replacement_value: Money, on: Date) kind empirical {
    label en unofficial "other property of a like kind (section 1031) is distributed by the partnership to the contributing partner, on the given date, in connection with a section 704(c)(1)(B) distribution to another partner (section 704(c)(2)(B) input fact)";
}
pub relation contributor_return_due_date_with_extensions(t_distribution: Transaction, contributor: Person, due: Date) kind empirical {
    label en unofficial "the due date (with extensions) for the contributing partner's return for the taxable year in which the section 704(c)(1)(B) distribution occurs (section 704(c)(2)(B)(ii) input fact — this package does not import the filing-deadline machinery of us.irc.returns/us.irc.administration)";
}

pub relation section_704c2_replacement_timely(t_distribution: Transaction, t_replacement: Transaction) kind institutional {
    label en official "the like-kind replacement property was distributed to the contributing partner not later than the EARLIER of the 180th day after the distribution or the contributor's extended return due date — modeled as satisfying BOTH deadlines, which is logically equivalent to satisfying the earlier one (section 704(c)(2)(B))";
}
@source(IRC_S704_C, relation = formalizes, coverage = partial, quote = "other property of a like kind (within the meaning of section 1031) is distributed by the partnership to the contributing partner not later than the earlier of")
rule S704c2ReplacementTimely(t_distribution: Transaction, t_replacement: Transaction, pship: Partnership, contributor: Person, replacement_prop: Asset, replacement_value: Money, replaced_on: Date, distributed_on: Date, due: Date, t_contribution: Transaction, distributee: Person) strict {
    when like_kind_replacement_distributed_to_contributor(t_distribution, t_replacement, pship, contributor, replacement_prop, replacement_value, replaced_on);
    when distribution_of_contributed_property_to_other_partner(t_distribution, pship, _, t_contribution, contributor, distributee, distributed_on);
    when replaced_on <= add_calendar_period(distributed_on, 180 calendar_day);
    when contributor_return_due_date_with_extensions(t_distribution, contributor, due);
    when replaced_on <= due;
    then section_704c2_replacement_timely(t_distribution, t_replacement);
}

pub relation section_704c2_treated_as_original_contribution(t_distribution: Transaction, pship: Partnership, contributor: Person, replacement_prop: Asset, up_to_value: Money) kind institutional {
    label en official "to the extent of the value of the like-kind replacement property, section 704(c)(1)(B) is applied as if the contributing partner had contributed the replacement property instead of the original property (section 704(c)(2) flush language)";
}
rule S704c2Recharacterization(t_distribution: Transaction, t_replacement: Transaction, pship: Partnership, contributor: Person, replacement_prop: Asset, replacement_value: Money, on: Date) strict {
    when section_704c2_replacement_timely(t_distribution, t_replacement);
    when like_kind_replacement_distributed_to_contributor(t_distribution, t_replacement, pship, contributor, replacement_prop, replacement_value, on);
    then section_704c2_treated_as_original_contribution(t_distribution, pship, contributor, replacement_prop, replacement_value);
}

// ============================================================================
// §704(e): partnership interests created by gift
// ============================================================================

pub relation partnership_interest_created_by_gift(donee: Person, pship: Partnership) kind empirical {
    label en unofficial "the donee's partnership interest was created by gift (section 704(e)(1) chapeau input fact)";
}
pub relation donee_distributive_share_per_agreement(donee: Person, pship: Partnership, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the donee's distributive share under the partnership agreement, before the two section 704(e)(1) carve-outs (an ordinary distributive_share_per_agreement fact for a donee partner)";
}
pub relation donor_reasonable_compensation_for_services(donor: Person, pship: Partnership, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "EVALUATIVE (DECISION-0194, external judgment channel): the reasonable compensation for services the donor rendered to the partnership, an authority (or agreed) determination this package does not compute — case-asserted, not an arithmetic guard";
}
pub relation donee_share_attributable_to_donated_capital(donee: Person, pship: Partnership, y: TaxableYear, share_of_donee_income: Decimal) kind empirical {
    label en unofficial "the portion of the donee's distributive share (as a fraction) attributable to donated capital (section 704(e)(1) second carve-out input)";
}
pub relation donor_share_attributable_to_donor_capital(donor: Person, pship: Partnership, y: TaxableYear, share_of_donor_income: Decimal) kind empirical {
    label en unofficial "the donor's own distributive share (as a fraction) attributable to the donor's own capital, for the section 704(e)(1) disproportion comparison";
}

pub relation section_704e_disproportionate_donated_capital_share(donee: Person, donor: Person, pship: Partnership, y: TaxableYear) kind institutional {
    label en official "the portion of the donee's share attributable to donated capital is proportionately greater than the donor's own share attributable to the donor's capital (section 704(e)(1) second carve-out)";
}
rule S704eDisproportionateShare(donee: Person, donor: Person, pship: Partnership, y: TaxableYear, donee_share: Decimal, donor_share: Decimal) strict {
    when donee_share_attributable_to_donated_capital(donee, pship, y, donee_share);
    when donor_share_attributable_to_donor_capital(donor, pship, y, donor_share);
    when donee_share > donor_share;
    then section_704e_disproportionate_donated_capital_share(donee, donor, pship, y);
}

pub relation donee_distributive_share_includible(donee: Person, pship: Partnership, y: TaxableYear, amount: Money) kind institutional {
    label en official "the donee's distributive share under the partnership agreement is includible in the donee's gross income (section 704(e)(1)), before the reasonable-compensation and disproportionate-donated-capital carve-outs where they apply";
}
@source(IRC_S704_E, relation = formalizes, coverage = exact, quote = "In the case of any partnership interest created by gift, the distributive share of the donee under the partnership agreement shall be includible in his gross income")
rule S704eDoneeShareIncludible(donee: Person, pship: Partnership, y: TaxableYear, amount: Money) defeasible {
    label en official "the donee's distributive share under the partnership agreement is includible in the donee's gross income (section 704(e)(1))";
    when partnership_interest_created_by_gift(donee, pship);
    when donee_distributive_share_per_agreement(donee, pship, y, amount);
    then donee_distributive_share_includible(donee, pship, y, amount);
}

// ============================================================================
// §704(e)(2): purchase by a family member deemed a gift
// ============================================================================

pub relation interest_purchased_from_family_member(buyer: Person, seller: Person, pship: Partnership, purchase_price: Money, fmv_at_purchase: Money) kind empirical {
    label en unofficial "buyer purchased a partnership interest from seller, a member of buyer's family (spouse, ancestor, lineal descendant, or a trust for the primary benefit of such persons) — the closed section 704(e)(2) family-membership test itself is a case-asserted classification, not a kinship graph this package builds";
}

@source(IRC_S704_E, relation = formalizes, coverage = exact, quote = "an interest purchased by one member of a family from another shall be considered to be created by gift from the seller, and the fair market value of the purchased interest shall be considered to be donated capital")
pub relation interest_treated_as_created_by_gift(buyer: Person, seller: Person, pship: Partnership) kind institutional {
    label en official "an interest purchased by one family member from another is treated as created by gift from the seller, for purposes of section 704(e) (section 704(e)(2))";
}
rule S704e2PurchaseTreatedAsGift(buyer: Person, seller: Person, pship: Partnership, price: Money, fmv: Money) strict {
    when interest_purchased_from_family_member(buyer, seller, pship, price, fmv);
    then interest_treated_as_created_by_gift(buyer, seller, pship);
}
pub relation purchased_interest_donated_capital(buyer: Person, pship: Partnership, amount: Money) kind institutional {
    label en official "the fair market value of the purchased interest is treated as donated capital, for purposes of section 704(e) (section 704(e)(2))";
}
rule S704e2FmvIsDonatedCapital(buyer: Person, seller: Person, pship: Partnership, price: Money, fmv: Money) strict {
    when interest_purchased_from_family_member(buyer, seller, pship, price, fmv);
    then purchased_interest_donated_capital(buyer, pship, fmv);
}
rule S704e2ImpliesGiftForE1(buyer: Person, seller: Person, pship: Partnership) strict {
    when interest_treated_as_created_by_gift(buyer, seller, pship);
    then partnership_interest_created_by_gift(buyer, pship);
}

// ============================================================================
// §724: character of gain or loss on contributed unrealized receivables,
// inventory items, and capital loss property
// ============================================================================

pub relation contributor_pre_contribution_unrealized_receivable(t: Transaction, prop: Asset, contributor: Person) kind empirical {
    label en unofficial "the property was an unrealized receivable in the contributor's hands immediately before the contribution (section 724(a)(2), section 724(d)(1) cross-referencing section 751(c) with 'partnership' read as 'partner')";
}
pub relation partnership_disposition_gain(pship: Partnership, prop: Asset, t_disposition: Transaction, amount: Money) kind empirical {
    label en unofficial "the amount of gain the partnership recognizes on the disposition (section 724 character-recharacterization input)";
}
pub relation partnership_disposition_loss(pship: Partnership, prop: Asset, t_disposition: Transaction, amount: Money) kind empirical {
    label en unofficial "the amount of loss the partnership recognizes on the disposition (section 724 character-recharacterization input)";
}

pub relation section_724a_ordinary_character(pship: Partnership, prop: Asset, t_disposition: Transaction, amount: Money, is_gain: Boolean) kind institutional {
    label en official "gain or loss recognized by the partnership on the disposition of contributed unrealized receivables is ordinary income or ordinary loss (section 724(a))";
}
@source(IRC_S724_A, relation = formalizes, coverage = exact, quote = "any gain or loss recognized by the partnership on the disposition of such property shall be treated as ordinary income or ordinary loss, as the case may be")
rule S724aOrdinaryGain(pship: Partnership, prop: Asset, t_contribution: Transaction, contributor: Person, t_disposition: Transaction, amount: Money) strict {
    when contribution_of_property(t_contribution, contributor, pship, prop, _);
    when contributor_pre_contribution_unrealized_receivable(t_contribution, prop, contributor);
    when partnership_disposition_gain(pship, prop, t_disposition, amount);
    then section_724a_ordinary_character(pship, prop, t_disposition, amount, true);
}
rule S724aOrdinaryLoss(pship: Partnership, prop: Asset, t_contribution: Transaction, contributor: Person, t_disposition: Transaction, amount: Money) strict {
    when contribution_of_property(t_contribution, contributor, pship, prop, _);
    when contributor_pre_contribution_unrealized_receivable(t_contribution, prop, contributor);
    when partnership_disposition_loss(pship, prop, t_disposition, amount);
    then section_724a_ordinary_character(pship, prop, t_disposition, amount, false);
}

pub relation contributor_pre_contribution_inventory_item(t: Transaction, prop: Asset, contributor: Person) kind empirical {
    label en unofficial "the property was an inventory item in the contributor's hands immediately before the contribution (section 724(b), section 724(d)(2) cross-referencing section 751(d))";
}
pub relation disposition_date(t_disposition: Transaction, prop: Asset, on: Date) kind empirical {
    label en unofficial "the date of the partnership's disposition of the property (section 724(b)/(c) 5-year window input, shared with module 11's holding-period rules)";
}
pub relation section_724b_ordinary_character(pship: Partnership, prop: Asset, t_disposition: Transaction, amount: Money, is_gain: Boolean) kind institutional {
    label en official "gain or loss recognized by the partnership within the 5-year period beginning on the date of contribution, on the disposition of contributed inventory items, is ordinary income or ordinary loss (section 724(b))";
}
@source(IRC_S724_B, relation = formalizes, coverage = exact, quote = "any gain or loss recognized by the partnership on the disposition of such property during the 5-year period beginning on the date of such contribution shall be treated as ordinary income or ordinary loss, as the case may be")
rule S724bOrdinaryGain(pship: Partnership, prop: Asset, t_contribution: Transaction, contributor: Person, contributed_on: Date, t_disposition: Transaction, disposed_on: Date, amount: Money) strict {
    when contribution_of_property(t_contribution, contributor, pship, prop, _);
    when contributor_pre_contribution_inventory_item(t_contribution, prop, contributor);
    when contribution_date(t_contribution, prop, contributed_on);
    when partnership_disposition_gain(pship, prop, t_disposition, amount);
    when disposition_date(t_disposition, prop, disposed_on);
    when disposed_on <= add_calendar_period(contributed_on, 5 calendar_year);
    then section_724b_ordinary_character(pship, prop, t_disposition, amount, true);
}
rule S724bOrdinaryLoss(pship: Partnership, prop: Asset, t_contribution: Transaction, contributor: Person, contributed_on: Date, t_disposition: Transaction, disposed_on: Date, amount: Money) strict {
    when contribution_of_property(t_contribution, contributor, pship, prop, _);
    when contributor_pre_contribution_inventory_item(t_contribution, prop, contributor);
    when contribution_date(t_contribution, prop, contributed_on);
    when partnership_disposition_loss(pship, prop, t_disposition, amount);
    when disposition_date(t_disposition, prop, disposed_on);
    when disposed_on <= add_calendar_period(contributed_on, 5 calendar_year);
    then section_724b_ordinary_character(pship, prop, t_disposition, amount, false);
}

pub relation contributor_pre_contribution_capital_asset(t: Transaction, prop: Asset, contributor: Person) kind empirical {
    label en unofficial "the property was a capital asset in the hands of the contributor immediately before the contribution (section 724(c) chapeau input)";
}
pub relation contributor_basis_exceeded_fmv_at_contribution(t: Transaction, prop: Asset, contributor: Person, excess: Money) kind empirical {
    label en unofficial "immediately before the contribution, the contributor's adjusted basis in the property exceeded its fair market value, by this amount (section 724(c) built-in-loss cap input — the same shape as section 704(c)(1)(C)'s built-in loss, asserted here directly on the contributor's own pre-contribution figures rather than re-derived, since section 724(c) reads 'in the hands of the partner', not the partnership's post-contribution basis)";
}
pub relation section_724c_capital_loss_character(pship: Partnership, prop: Asset, t_disposition: Transaction, amount: Money) kind institutional {
    label en official "loss recognized by the partnership within the 5-year period beginning on the date of contribution, on the disposition of contributed capital-loss property, is a loss from the sale of a capital asset, up to the excess of the contributor's pre-contribution basis over the property's fair market value at contribution (section 724(c))";
}
@source(IRC_S724_C, relation = formalizes, coverage = exact, quote = "any loss recognized by the partnership on the disposition of such property during the 5-year period beginning on the date of such contribution shall be treated as a loss from the sale of a capital asset to the extent that, immediately before such contribution, the adjusted basis of such property in the hands of the partner exceeded the fair market value of such property")
rule S724cCapitalLossCharacter(pship: Partnership, prop: Asset, t_contribution: Transaction, contributor: Person, contributed_on: Date, t_disposition: Transaction, disposed_on: Date, recognized_loss: Money, cap: Money) strict {
    when contribution_of_property(t_contribution, contributor, pship, prop, _);
    when contributor_pre_contribution_capital_asset(t_contribution, prop, contributor);
    when contribution_date(t_contribution, prop, contributed_on);
    when partnership_disposition_loss(pship, prop, t_disposition, recognized_loss);
    when disposition_date(t_disposition, prop, disposed_on);
    when disposed_on <= add_calendar_period(contributed_on, 5 calendar_year);
    when contributor_basis_exceeded_fmv_at_contribution(t_contribution, prop, contributor, cap);
    then section_724c_capital_loss_character(pship, prop, t_disposition, min(recognized_loss, cap));
}

// --- §724(d)(3): substituted basis property carryover ----------------------

pub relation substituted_basis_property_from_724_property(original_prop: Asset, substituted_prop: Asset, t_exchange: Transaction) kind empirical {
    label en unofficial "substituted_prop is substituted basis property resulting from a nonrecognition transaction disposing of original_prop, a property described in section 724(a)-(c) (section 724(d)(3)(A) input fact)";
}
pub relation substituted_prop_is_c_corp_stock_in_351_exchange(substituted_prop: Asset, t_exchange: Transaction) kind empirical {
    label en unofficial "the substituted basis property is stock in a C corporation received in a section 351 exchange (section 724(d)(3)(B) exception input)";
}
pub relation section_724_character_carries_to_substituted_property(original_prop: Asset, substituted_prop: Asset, t_exchange: Transaction) kind institutional {
    label en official "the section 724(a)-(c) character treatment that applied to the original property also applies to substituted basis property resulting from a nonrecognition transaction, unless the substituted property is C-corporation stock received in a section 351 exchange (section 724(d)(3))";
}
@source(IRC_S724_D, relation = formalizes, coverage = exact, quote = "If any property described in subsection (a), (b), or (c) is disposed of in a nonrecognition transaction, the tax treatment which applies to such property under such subsection shall also apply to any substituted basis property resulting from such transaction.")
rule S724d3CharacterCarriesOver(original_prop: Asset, substituted_prop: Asset, t_exchange: Transaction) defeasible {
    label en official "section 724(a)-(c) character carries over to substituted basis property from a nonrecognition transaction (section 724(d)(3)(A))";
    when substituted_basis_property_from_724_property(original_prop, substituted_prop, t_exchange);
    unless substituted_prop_is_c_corp_stock_in_351_exchange(substituted_prop, t_exchange) and substituted_basis_property_from_724_property(original_prop, substituted_prop, t_exchange);
    then section_724_character_carries_to_substituted_property(original_prop, substituted_prop, t_exchange);
}
