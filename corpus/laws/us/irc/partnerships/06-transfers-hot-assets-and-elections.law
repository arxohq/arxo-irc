// 26 U.S.C. §§741, 743(a)-(b), 751(a), 752, 754, 761 — Part II subpart C
// (sale of a partnership interest) and subpart D (hot assets), the §752
// liability rules, the §754 election, and Part III's §761 definitions.
//
// JUDGMENT CALLS AND GAPS (see report):
//  - §741: capital-asset characterization on sale of a partnership interest,
//    displaced by §751 to the extent of hot-asset ordinary income. Modeled
//    as a defeasible default defeated by the §751(a) ordinary-income share.
//  - §743(a): the "no adjustment unless §754 election or substantial
//    built-in loss" gate is modeled directly; §743(b)'s adjustment AMOUNT
//    formula is executable (transferee's basis minus proportionate share of
//    partnership's adjusted basis); §743(b)'s own cross-reference to §704(c)
//    for contributed property is NOT reproduced (TECH_GAP — this package's
//    §704(c) is itself out of scope for this pass, see 02's header note).
//  - §751(a): ordinary income on sale to the extent attributable to
//    unrealized receivables/inventory is executable as the statute states
//    it, over a case-supplied "amount attributable to hot assets" fact
//    (the proportionate allocation of total consideration to hot assets is
//    itself a valuation exercise the statute does not reduce to a formula —
//    modeled as a case fact, not invented by this package).
//  - §752(a)-(b): the statutory rule (increase = contribution of money,
//    decrease = distribution of money) is executable directly; the
//    partner's SHARE of a partnership liability (which regulations
//    determine, e.g. 26 CFR 1.752-1 through -3) is EXTERNAL_DEPENDENCY —
//    modeled as a case-asserted `partner_liability_share`, not computed.
//    §752(c) (liability to which property is subject, up to FMV) is
//    executable directly.
//  - §754: modeled as a `power` of the partnership per E-0239 (an election
//    that changes the legal regime — whether §734/§743 adjustments apply
//    going forward). `valid_when` takes exactly one atom (compiler trap):
//    the manner-of-election regulatory conditions are folded into a single
//    derived relation `s754_election_properly_filed`.
//  - §761(a): the "partnership" definition and the election-out power are
//    both modeled; the three qualifying purposes (investment-only, joint
//    production/extraction, securities-dealer underwriting) are modeled as
//    an enum, since the statute itself enumerates exactly three.
//  - §761(b) "partner" gift-derivation irrelevance, §761(c) partnership
//    agreement (including timely modifications), §761(d) liquidation of a
//    partner's interest, and §761(e) distributions of interests treated as
//    exchanges are all modeled as classifications.

language "law.core" version "0.2";
package us.irc.partnerships version "0.1.1";
namespace "urn:us:irc:partnerships:clir";

use self::{
    Asset,
    IRC_S741,
    IRC_S743_A,
    IRC_S743_B,
    IRC_S751_A,
    IRC_S752_A,
    IRC_S752_B,
    IRC_S752_C,
    IRC_S754,
    IRC_S761_A,
    IRC_S761_B,
    IRC_S761_D,
    IRC_S761_E,
    OwnershipInterest,
    Partnership,
    Person,
    TaxableYear,
    Transaction,
    contribution_of_property,
    is_partner,
    money_contributed,
    money_distributed,
    sbil_disregarded_for_special_partnership_743ef,
};

// ============================================================================
// §741: recognition and character of gain or loss on sale or exchange
// ============================================================================

pub relation interest_sale_gain_or_loss(t: Transaction, transferor: Person, pship: Partnership, amount: Money) kind empirical {
    label en unofficial "the amount of gain or loss on a sale or exchange of an interest in the partnership by the transferor partner (section 741)";
}

@source(IRC_S741, relation = formalizes, coverage = exact, quote = "In the case of a sale or exchange of an interest in a partnership, gain or loss shall be recognized to the transferor partner.")
pub relation interest_sale_gain_or_loss_recognized(t: Transaction, transferor: Person, pship: Partnership, amount: Money) kind institutional {
    label en official "gain or loss on a sale or exchange of a partnership interest is recognized to the transferor partner (section 741)";
}
rule S741GainOrLossRecognized(t: Transaction, transferor: Person, pship: Partnership, amount: Money) strict {
    when interest_sale_gain_or_loss(t, transferor, pship, amount);
    then interest_sale_gain_or_loss_recognized(t, transferor, pship, amount);
}

@source(IRC_S741, relation = formalizes, coverage = exact, quote = "Such gain or loss shall be considered as gain or loss from the sale or exchange of a capital asset, except as otherwise provided in section 751 (relating to unrealized receivables and inventory items).")
pub relation interest_sale_is_capital_gain_or_loss(t: Transaction, transferor: Person, pship: Partnership) kind institutional {
    label en official "gain or loss on the sale or exchange of a partnership interest is capital-asset gain or loss, except to the extent section 751 recharacterizes it as ordinary income (section 741)";
}
rule S741CapitalCharacterAbsentS751(t: Transaction, transferor: Person, pship: Partnership) defeasible {
    label en official "absent a section 751(a) hot-asset component, the sale or exchange of a partnership interest is capital gain or loss (section 741)";
    when interest_sale_gain_or_loss(t, transferor, pship, _);
    unless section_751a_ordinary_income(t, transferor, pship, _) and interest_sale_gain_or_loss(t, transferor, pship, _);
    then interest_sale_is_capital_gain_or_loss(t, transferor, pship);
}

// ============================================================================
// §751(a): unrealized receivables and inventory items — sale of interest
// ============================================================================

pub relation amount_realized_attributable_to_hot_assets(t: Transaction, transferor: Person, pship: Partnership, amount: Money) kind empirical {
    label en unofficial "the amount of money, or the fair market value of property, received by the transferor partner in exchange for the part of his interest attributable to unrealized receivables (section 751(c)) or inventory items (section 751(d)) of the partnership (section 751(a)) — the proportionate valuation itself is a case fact, not a formula this package invents";
}

@source(IRC_S751_A, relation = formalizes, coverage = exact, quote = "shall be considered as an amount realized from the sale or exchange of property other than a capital asset")
pub relation section_751a_ordinary_income(t: Transaction, transferor: Person, pship: Partnership, amount: Money) kind institutional {
    label en official "the amount realized attributable to unrealized receivables or inventory items on a sale or exchange of a partnership interest is treated as an amount realized from the sale or exchange of property other than a capital asset — ordinary income (section 751(a))";
}
rule S751aOrdinaryIncomeOnHotAssets(t: Transaction, transferor: Person, pship: Partnership, amount: Money) strict {
    when amount_realized_attributable_to_hot_assets(t, transferor, pship, amount);
    when amount > 0 USD;
    then section_751a_ordinary_income(t, transferor, pship, amount);
}

// This package's pub name for the section 751(a) ordinary-income figure.
pub relation section_751_ordinary_income(t: Transaction, transferor: Person, pship: Partnership, amount: Money) kind institutional {
    label en official "the section 751(a) ordinary-income amount on a sale or exchange of a partnership interest (alias of section_751a_ordinary_income for the package's declared pub interface)";
}
rule Section751OrdinaryIncomeAlias(t: Transaction, transferor: Person, pship: Partnership, amount: Money) strict {
    when section_751a_ordinary_income(t, transferor, pship, amount);
    then section_751_ordinary_income(t, transferor, pship, amount);
}

// ============================================================================
// §752: treatment of certain liabilities
// ============================================================================

pub relation partner_liability_share_increase(partner: Person, pship: Partnership, amount: Money) kind empirical {
    label en unofficial "the increase in a partner's share of partnership liabilities, or in the partner's individual liabilities by reason of assuming partnership liabilities (section 752(a)) — the partner's SHARE of a liability is an EXTERNAL_DEPENDENCY (26 CFR 1.752-1 through -3), asserted here as a case fact, not computed";
}
@source(IRC_S752_A, relation = formalizes, coverage = exact, quote = "Any increase in a partner's share of the liabilities of a partnership, or any increase in a partner's individual liabilities by reason of the assumption by such partner of partnership liabilities, shall be considered as a contribution of money by such partner to the partnership.")
pub relation liability_increase_treated_as_money_contribution(partner: Person, pship: Partnership, amount: Money) kind institutional {
    label en official "an increase in a partner's share of partnership liabilities is treated as a contribution of money by the partner to the partnership (section 752(a))";
}
rule S752aLiabilityIncreaseIsContribution(partner: Person, pship: Partnership, amount: Money) strict {
    when partner_liability_share_increase(partner, pship, amount);
    then liability_increase_treated_as_money_contribution(partner, pship, amount);
}
rule S752aFeedsMoneyContributed(partner: Person, pship: Partnership, t: Transaction, amount: Money) strict {
    label en official "the section 752(a) deemed money contribution feeds into the section 722 basis computation as money contributed in the same transaction, when the transaction is the one giving rise to the liability increase";
    when liability_increase_treated_as_money_contribution(partner, pship, amount);
    when contribution_of_property(t, partner, pship, _, _);
    then money_contributed(t, partner, pship, amount);
}

pub relation partner_liability_share_decrease(partner: Person, pship: Partnership, amount: Money) kind empirical {
    label en unofficial "the decrease in a partner's share of partnership liabilities, or in the partner's individual liabilities by reason of the partnership's assumption of such liabilities (section 752(b))";
}
@source(IRC_S752_B, relation = formalizes, coverage = exact, quote = "Any decrease in a partner's share of the liabilities of a partnership, or any decrease in a partner's individual liabilities by reason of the assumption by the partnership of such individual liabilities, shall be considered as a distribution of money to the partner by the partnership.")
pub relation liability_decrease_treated_as_money_distribution(partner: Person, pship: Partnership, amount: Money) kind institutional {
    label en official "a decrease in a partner's share of partnership liabilities is treated as a distribution of money to the partner by the partnership (section 752(b))";
}
rule S752bLiabilityDecreaseIsDistribution(partner: Person, pship: Partnership, amount: Money) strict {
    when partner_liability_share_decrease(partner, pship, amount);
    then liability_decrease_treated_as_money_distribution(partner, pship, amount);
}
rule S752bFeedsMoneyDistributed(partner: Person, pship: Partnership, t: Transaction, amount: Money) strict {
    label en official "the section 752(b) deemed money distribution feeds into the section 731/733 money-distributed computation for the same distribution transaction";
    when liability_decrease_treated_as_money_distribution(partner, pship, amount);
    when money_distributed(t, pship, partner, _);
    then deemed_money_distributed_from_liability_decrease(t, pship, partner, amount);
}
pub relation deemed_money_distributed_from_liability_decrease(t: Transaction, pship: Partnership, partner: Person, amount: Money) kind institutional {
    label en unofficial "intermediate value: the section 752(b) deemed money distribution amount for a given distribution transaction, to be combined by a case with the actual money distributed";
}

pub relation liability_secured_property_fmv(prop: Asset, amount: Money) kind empirical {
    label en unofficial "the fair market value of property to which a liability is subject (section 752(c))";
}
pub relation liability_amount_subject_to_property(prop: Asset, amount: Money) kind empirical {
    label en unofficial "the face amount of a liability to which property is subject (section 752(c), before the fair-market-value cap)";
}
@source(IRC_S752_C, relation = formalizes, coverage = exact, quote = "a liability to which property is subject shall, to the extent of the fair market value of such property, be considered as a liability of the owner of the property")
pub relation liability_of_property_owner(prop: Asset, amount: Money) kind institutional {
    label en official "a liability to which property is subject is considered a liability of the owner of the property, to the extent of the property's fair market value (section 752(c))";
}
rule S752cLiabilityCappedAtFmvBelow(prop: Asset, fmv: Money, face: Money) strict {
    when liability_secured_property_fmv(prop, fmv);
    when liability_amount_subject_to_property(prop, face);
    when face <= fmv;
    then liability_of_property_owner(prop, face);
}
rule S752cLiabilityCappedAtFmvAbove(prop: Asset, fmv: Money, face: Money) strict {
    when liability_secured_property_fmv(prop, fmv);
    when liability_amount_subject_to_property(prop, face);
    when face > fmv;
    then liability_of_property_owner(prop, fmv);
}

// ============================================================================
// §754: manner of electing optional adjustment to basis of partnership property
// ============================================================================

pub relation s754_election_filed(pship: Partnership, y: TaxableYear, e: us.irc.core::Election) kind empirical {
    label en unofficial "the partnership filed an election under section 754 for the taxable year (a case-asserted filing act)";
}
relation s754_election_manner_conforms_to_regulations(e: us.irc.core::Election) kind institutional {
    label en unofficial "EXTERNAL_DEPENDENCY (26 CFR 1.754-1(b): manner-of-election regulatory conditions, e.g. a signed statement attached to a timely filed return) — case-asserted, not reproduced by this package";
}
pub relation s754_election_properly_filed(pship: Partnership, y: TaxableYear, e: us.irc.core::Election) kind institutional {
    label en unofficial "a single derived condition folding the filing act and its regulatory-manner conformance into one atom, so that valid_when (compiler trap: exactly one atom) can reference it directly";
}
rule S754ElectionProperlyFiled(pship: Partnership, y: TaxableYear, e: us.irc.core::Election) strict {
    when s754_election_filed(pship, y, e);
    when s754_election_manner_conforms_to_regulations(e);
    then s754_election_properly_filed(pship, y, e);
}

pub relation s754_election_in_effect(pship: Partnership, y: TaxableYear) kind institutional {
    label en official "the section 754 election is in effect for the partnership for the taxable year and all subsequent taxable years, applying to all distributions of property and all transfers of interests during that period (section 754, sentences 1-2)";
}
@source(IRC_S754, relation = formalizes, coverage = exact, quote = "If a partnership files an election, in accordance with regulations prescribed by the Secretary, the basis of partnership property shall be adjusted, in the case of a distribution of property, in the manner provided in section 734 and, in the case of a transfer of a partnership interest, in the manner provided in section 743.")
rule S754ElectionPowerRule(pship: Partnership, y: TaxableYear, e: us.irc.core::Election) strict {
    label en official "a partnership may elect, in accordance with regulations, to have partnership-property basis adjusted under section 734 (distributions) and section 743 (transfers) — the section 754 election (section 754)";
    when s754_election_filed(pship, y, e);
    then power S754ElectionPower {
        holder pship;
        over e;
        exercise us.irc.core::election_by(e, pship);
        valid_when s754_election_properly_filed(pship, y, e);
        effect create(s754_election_in_effect(pship, y));
        subject us.irc.core::Election;
        window [-infinity, infinity);
    };
}

pub relation s754_election_revoked(pship: Partnership, y: TaxableYear, e: us.irc.core::Election) kind empirical {
    label en unofficial "the partnership revoked its section 754 election, subject to regulatory limitations (section 754, sentence 3) — a case-asserted revocation act";
}
relation s754_revocation_conforms_to_regulations(e: us.irc.core::Election) kind institutional {
    label en unofficial "EXTERNAL_DEPENDENCY (regulatory limitations on revocation, section 754 sentence 3, not reproduced by this package) — case-asserted";
}
@source(IRC_S754, relation = formalizes, coverage = exact, quote = "Such election may be revoked by the partnership, subject to such limitations as may be provided by regulations prescribed by the Secretary.")
rule S754RevocationPowerRule(pship: Partnership, y: TaxableYear, e: us.irc.core::Election) strict {
    label en official "the section 754 election may be revoked by the partnership, subject to regulatory limitations (section 754, sentence 3)";
    when s754_election_revoked(pship, y, e);
    then power S754RevocationPower {
        holder pship;
        over e;
        exercise s754_election_revoked(pship, y, e);
        valid_when s754_revocation_conforms_to_regulations(e);
        effect remove(s754_election_in_effect(pship, y));
        subject us.irc.core::Election;
        window [-infinity, infinity);
    };
}

// ============================================================================
// §743(a)-(b): basis adjustment to partnership property on transfer
// ============================================================================

pub relation transfer_of_interest_by_sale_or_death(t: Transaction, pship: Partnership, transferee: Person) kind empirical {
    label en unofficial "a transfer of an interest in the partnership by sale or exchange or on the death of a partner (section 743(a))";
}
pub relation substantial_built_in_loss_after_transfer(t: Transaction, pship: Partnership, y: TaxableYear) kind empirical {
    label en unofficial "the partnership has a substantial built-in loss immediately after the transfer, for the stated taxable year (section 743(a)/(d) — the numeric $250,000 threshold this package reads from the pinned text of section 743(a) itself, not invented)";
}

@source(IRC_S743_A, relation = formalizes, coverage = exact, quote = "The basis of partnership property shall not be adjusted as the result of a transfer of an interest in a partnership by sale or exchange or on the death of a partner unless the election provided by section 754 (relating to optional adjustment to basis of partnership property) is in effect with respect to such partnership or unless the partnership has a substantial built-in loss immediately after such transfer.")
pub relation s743_adjustment_applies(t: Transaction, pship: Partnership, y: TaxableYear) kind institutional {
    label en official "partnership property basis is adjusted on a transfer by sale, exchange, or death only when the section 754 election is in effect or the partnership has a substantial built-in loss immediately after the transfer (section 743(a))";
}
rule S743aAdjustmentAppliesElection(t: Transaction, pship: Partnership, y: TaxableYear, transferee: Person) defeasible {
    when transfer_of_interest_by_sale_or_death(t, pship, transferee);
    when s754_election_in_effect(pship, y);
    then s743_adjustment_applies(t, pship, y);
}
rule S743aAdjustmentAppliesBuiltInLoss(t: Transaction, pship: Partnership, y: TaxableYear, transferee: Person) defeasible {
    when transfer_of_interest_by_sale_or_death(t, pship, transferee);
    when substantial_built_in_loss_after_transfer(t, pship, y);
    unless sbil_disregarded_for_special_partnership_743ef(t, pship, y);
    then s743_adjustment_applies(t, pship, y);
}

pub relation transferee_basis_of_interest(t: Transaction, transferee: Person, amount: Money) kind empirical {
    label en unofficial "the basis to the transferee partner of his interest in the partnership (section 743(b) chapeau)";
}
pub relation transferee_proportionate_share_of_partnership_basis(t: Transaction, transferee: Person, amount: Money) kind institutional {
    label en unofficial "the transferee partner's proportionate share of the adjusted basis of partnership property, determined in accordance with his interest in partnership capital (section 743(b), last sentence) — section 704(c) is not applied here for contributed property (TECH_GAP, see header)";
}

pub relation section_743b_adjustment(t: Transaction, pship: Partnership, transferee: Person, amount: Money) kind institutional {
    label en official "the section 743(b) basis adjustment to partnership property with respect to the transferee partner: the excess of the transferee's basis in the interest over his proportionate share of partnership basis (increase), or the reverse (decrease) (section 743(b)(1)-(2))";
}
@source(IRC_S743_B, relation = formalizes, coverage = exact, quote = "increase the adjusted basis of the partnership property by the excess of the basis to the transferee partner of his interest in the partnership over his proportionate share of the adjusted basis of the partnership property")
rule S743bIncrease(t: Transaction, pship: Partnership, y: TaxableYear, transferee: Person, transferee_basis: Money, prop_share: Money) defeasible {
    label en official "the partnership property basis is increased by the excess of the transferee's basis over his proportionate share of partnership basis (section 743(b)(1))";
    when s743_adjustment_applies(t, pship, y);
    when transferee_basis_of_interest(t, transferee, transferee_basis);
    when transferee_proportionate_share_of_partnership_basis(t, transferee, prop_share);
    when transferee_basis > prop_share;
    then section_743b_adjustment(t, pship, transferee, transferee_basis - prop_share);
}
@source(IRC_S743_B, relation = formalizes, coverage = exact, quote = "decrease the adjusted basis of the partnership property by the excess of the transferee partner's proportionate share of the adjusted basis of the partnership property over the basis of his interest in the partnership")
rule S743bDecrease(t: Transaction, pship: Partnership, y: TaxableYear, transferee: Person, transferee_basis: Money, prop_share: Money) defeasible {
    label en official "the partnership property basis is decreased by the excess of the transferee's proportionate share of partnership basis over his own basis (section 743(b)(2))";
    when s743_adjustment_applies(t, pship, y);
    when transferee_basis_of_interest(t, transferee, transferee_basis);
    when transferee_proportionate_share_of_partnership_basis(t, transferee, prop_share);
    when prop_share > transferee_basis;
    then section_743b_adjustment(t, pship, transferee, prop_share - transferee_basis);
}

// This package's pub interface alias for the §743(b) amount (AGENT-BRIEF pub list).
pub relation section_743b_amount(t: Transaction, pship: Partnership, transferee: Person, amount: Money) kind institutional {
    label en unofficial "alias of section_743b_adjustment for the package's declared pub interface";
}
rule Section743bAmountAlias(t: Transaction, pship: Partnership, transferee: Person, amount: Money) defeasible {
    when section_743b_adjustment(t, pship, transferee, amount);
    then section_743b_amount(t, pship, transferee, amount);
}

// ============================================================================
// §761: definitions
// ============================================================================

enum PartnershipElectionOutPurpose {
    InvestmentPurposesOnly;
    JointProductionExtractionOrUseOfProperty;
    SecuritiesDealerShortPeriodUnderwriting;
}

pub relation unincorporated_organization_carries_on_business(org: Partnership) kind empirical {
    label en unofficial "the organization is a syndicate, group, pool, joint venture, or other unincorporated organization through or by means of which business, financial operation, or venture is carried on (section 761(a) chapeau)";
}
pub relation is_corporation_trust_or_estate(org: Partnership) kind institutional {
    label en unofficial "the organization is, within the meaning of this title, a corporation, trust, or estate (section 761(a) chapeau exclusion) — a case-asserted classification (the actual section 7701(a) test belongs to us.irc.definitions, not imported here)";
}

@source(IRC_S761_A, relation = formalizes, coverage = exact, quote = "the term \"partnership\" includes a syndicate, group, pool, joint venture, or other unincorporated organization through or by means of which any business, financial operation, or venture is carried on, and which is not, within the meaning of this title, a corporation or a trust or estate")
pub relation is_partnership_for_subtitle_purposes(org: Partnership) kind institutional {
    label en official "for purposes of this subtitle, \"partnership\" includes any unincorporated organization carrying on a business, financial operation, or venture that is not a corporation, trust, or estate (section 761(a))";
}
rule S761aPartnershipDefinition(org: Partnership) defeasible {
    when unincorporated_organization_carries_on_business(org);
    unless is_corporation_trust_or_estate(org) and unincorporated_organization_carries_on_business(org);
    then is_partnership_for_subtitle_purposes(org);
}

pub relation all_members_elect_out(org: Partnership) kind empirical {
    label en unofficial "all the members of the unincorporated organization elect to exclude it from the application of all or part of Subchapter K (section 761(a) flush language)";
}
pub relation election_out_qualifying_purpose(org: Partnership, purpose: PartnershipElectionOutPurpose) kind empirical {
    label en unofficial "the organization is availed of for one of the three section 761(a)(1)-(3) qualifying purposes";
}
pub relation members_income_determinable_without_partnership_computation(org: Partnership) kind empirical {
    label en unofficial "the income of the members of the organization may be adequately determined without computation of partnership taxable income (section 761(a) closing clause)";
}

pub relation subchapter_k_excluded(org: Partnership) kind institutional {
    label en official "the organization is excluded from the application of all or part of Subchapter K by a valid section 761(a) election (section 761(a) flush language)";
}
@source(IRC_S761_A, relation = formalizes, coverage = exact, quote = "the Secretary may, at the election of all the members of an unincorporated organization, exclude such organization from the application of all or part of this subchapter, if it is availed of")
rule S761ElectionOutPowerRule(org: Partnership, purpose: PartnershipElectionOutPurpose) strict {
    label en official "at the election of all members, the Secretary excludes a qualifying unincorporated organization from all or part of Subchapter K (section 761(a) flush language and paragraphs (1)-(3))";
    when unincorporated_organization_carries_on_business(org);
    when election_out_qualifying_purpose(org, purpose);
    when members_income_determinable_without_partnership_computation(org);
    then power S761ElectionOutPower {
        holder org;
        over org;
        exercise all_members_elect_out(org);
        valid_when election_out_qualifying_purpose(org, purpose);
        effect create(subchapter_k_excluded(org));
        subject Partnership;
        window [-infinity, infinity);
    };
}

@source(IRC_S761_B, relation = formalizes, coverage = exact, quote = "the term \"partner\" means a member of a partnership")
pub relation is_partner_for_subtitle_purposes(person: Person, org: Partnership) kind institutional {
    label en official "for purposes of this subtitle, \"partner\" means a member of a partnership (section 761(b))";
}
rule S761bPartnerDefinition(person: Person, org: Partnership) strict {
    when is_partner(person, org);
    then is_partner_for_subtitle_purposes(person, org);
}

pub relation partnership_interest_derived_by_gift(person: Person, org: Partnership) kind empirical {
    label en unofficial "the partner's capital interest was derived by gift from another person (section 761(b), second sentence)";
}
@source(IRC_S761_B, relation = formalizes, coverage = exact, quote = "whether a person is a partner with respect to such interest shall be determined without regard to whether such interest was derived by gift from any other person")
rule S761bGiftDerivationIrrelevant(person: Person, org: Partnership) strict {
    label en official "whether a person is a partner with respect to a capital interest (where capital is a material income-producing factor) is determined without regard to whether the interest was derived by gift (section 761(b), second sentence)";
    when partnership_interest_derived_by_gift(person, org);
    then is_partner_for_subtitle_purposes(person, org);
}

pub relation liquidation_of_partners_interest(partner: Person, org: Partnership, t: Transaction) kind empirical {
    label en unofficial "a series of distributions terminating a partner's entire interest in the partnership (section 761(d) input fact)";
}
@source(IRC_S761_D, relation = formalizes, coverage = exact, quote = "the term \"liquidation of a partner's interest\" means the termination of a partner's entire interest in a partnership by means of a distribution, or a series of distributions, to the partner by the partnership")
pub relation is_liquidation_of_partners_interest(partner: Person, org: Partnership, t: Transaction) kind institutional {
    label en official "for purposes of Subchapter K, \"liquidation of a partner's interest\" means termination of the partner's entire interest by a distribution or series of distributions to the partner (section 761(d))";
}
rule S761dLiquidationDefinition(partner: Person, org: Partnership, t: Transaction) strict {
    when liquidation_of_partners_interest(partner, org, t);
    then is_liquidation_of_partners_interest(partner, org, t);
}

pub relation distribution_of_interest_not_otherwise_an_exchange(t: Transaction, org: Partnership) kind empirical {
    label en unofficial "a distribution of an interest in a partnership not otherwise treated as an exchange (section 761(e) chapeau)";
}
@source(IRC_S761_E, relation = formalizes, coverage = exact, quote = "any distribution of an interest in a partnership (not otherwise treated as an exchange) shall be treated as an exchange")
pub relation distribution_of_interest_treated_as_exchange(t: Transaction, org: Partnership) kind institutional {
    label en official "for purposes of section 708 (continuation), section 743 (basis adjustment on transfer), and other provisions regulations specify, a distribution of a partnership interest not otherwise an exchange is treated as an exchange (section 761(e))";
}
rule S761eDistributionTreatedAsExchange(t: Transaction, org: Partnership) strict {
    when distribution_of_interest_not_otherwise_an_exchange(t, org);
    then distribution_of_interest_treated_as_exchange(t, org);
}
