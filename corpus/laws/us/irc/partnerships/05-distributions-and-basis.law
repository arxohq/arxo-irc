// 26 U.S.C. §§731-733 — Part II, subpart B: recognition of gain or loss on a
// distribution, basis of distributed property, and basis of the distributee
// partner's interest.
//
// JUDGMENT CALLS AND GAPS (see report):
//  - §731(a)(1): gain on money in excess of basis is executable directly.
//    §731(a)(2): loss recognition on a liquidating distribution of ONLY
//    money/unrealized-receivables/inventory is modeled with the statute's
//    own closed condition (`liquidating_distribution_money_receivables_inventory_only`,
//    a case-asserted classification of the distribution transaction — this
//    package does not re-derive "no other property" from an open-world
//    enumeration of everything NOT distributed).
//  - §731(c) (marketable securities treated as money) is modeled only at
//    the level the statute states for (a)(1) purposes: a distributed
//    marketable security's FMV is added to "money distributed" for the
//    gain test. The seven-paragraph definition of "marketable securities"
//    and the exceptions of (c)(3) are NOT reproduced (TECH_GAP/out of
//    scope for this pass) — `marketable_security_distributed` is a case
//    fact naming the FMV directly, not a derived classification.
//  - §731(d) (cross-reference to §§736/737/751) is NON_NORMATIVE (a pure
//    "this section shall not apply to the extent otherwise provided by")
//    signal; modeled as a defeater flag a scenario can set when a
//    distribution is ALSO within the scope of one of those sections, since
//    this package does not yet import 736/737 rules (§751(a) IS modeled in
//    06 and its own defeater is wired there).
//  - §732(a)-(b): basis of distributed property (non-liquidating capped at
//    outside basis less money; liquidating substituted basis) is executable
//    directly, for a SINGLE distributed property per transaction.
//  - §732(c) (allocation of basis among MULTIPLE distributed properties: hot
//    assets first, then other property, then the (c)(2)/(c)(3) increase/
//    decrease steps by unrealized appreciation/depreciation, then relative
//    FMV/basis), §732(d) (special basis to a transferee partner without a
//    section 754 election), §732(e) (cross-reference to section 751(b)),
//    and §732(f) (corporate-partner stock-basis anti-abuse reduction) are
//    NOT modeled in this pass — TECH_GAP/not done, not silently folded into
//    (a)/(b) (see the report's not-done list).

language "law.core" version "0.2";
package us.irc.partnerships version "0.1.1";
namespace "urn:us:irc:partnerships:clir";

use self::{
    Asset,
    IRC_S731_A,
    IRC_S731_B,
    IRC_S732_A,
    IRC_S732_B,
    IRC_S733,
    Partnership,
    Person,
    Transaction,
    deemed_money_distributed_from_liability_decrease,
};

// ============================================================================
// §731(a): recognition of gain or loss to the distributee partner
// ============================================================================

pub relation money_distributed(t: Transaction, pship: Partnership, partner: Person, amount: Money) kind empirical {
    label en unofficial "the amount of money distributed by the partnership to the partner in this distribution transaction (section 731(a))";
}
pub relation marketable_security_distributed(t: Transaction, pship: Partnership, partner: Person, fmv: Money) kind institutional {
    label en unofficial "the fair market value, as of the date of distribution, of a marketable security distributed in this transaction, taken into account as money for section 731(a)(1)/section 737 (section 731(c)(1)) — the full section 731(c) definition/exceptions are out of scope for this pass";
}
pub relation distributee_outside_basis_before_distribution(t: Transaction, pship: Partnership, partner: Person, amount: Money) kind empirical {
    label en unofficial "the partner's adjusted basis in the partnership interest immediately before the distribution (section 731(a)(1))";
}
pub relation distribution_in_liquidation(t: Transaction, pship: Partnership, partner: Person) kind empirical {
    label en unofficial "the distribution is in liquidation of the partner's entire interest in the partnership (section 731(a)(2), section 761(d))";
}
pub relation liquidating_distribution_money_receivables_inventory_only(t: Transaction, pship: Partnership, partner: Person) kind empirical {
    label en unofficial "no property other than money, unrealized receivables (section 751(c)), and inventory (section 751(d)) is distributed in this liquidating distribution (section 731(a)(2) closed condition)";
}
pub relation distributee_basis_of_receivables_and_inventory(t: Transaction, pship: Partnership, partner: Person, amount: Money) kind empirical {
    label en unofficial "the section 732 basis to the distributee of any unrealized receivables and inventory distributed in this liquidating transaction (section 731(a)(2)(B))";
}
relation section_731_defeated_by_other_section(t: Transaction) kind institutional {
    label en unofficial "the distribution is within the scope of section 736, 737, or 751(b), which displaces section 731 for this transaction (section 731(d)) — case-asserted defeater flag; section 751(a)'s own defeater is separately wired in 06's module";
}

pub relation money_and_securities_distributed(t: Transaction, pship: Partnership, partner: Person, amount: Money) kind institutional {
    label en unofficial "money actually distributed plus the FMV of any marketable securities treated as money under section 731(c)(1), for the section 731(a)(1) gain test";
}
rule S731cMoneyPlusSecurities(t: Transaction, pship: Partnership, partner: Person, money: Money, security_fmv: Money) strict {
    when money_distributed(t, pship, partner, money);
    when marketable_security_distributed(t, pship, partner, security_fmv);
    then money_and_securities_distributed(t, pship, partner, money + security_fmv);
}
rule S731cMoneyOnlyNoSecurities(t: Transaction, pship: Partnership, partner: Person, money: Money) defeasible {
    when money_distributed(t, pship, partner, money);
    unless marketable_security_distributed(t, pship, partner, _) and money_distributed(t, pship, partner, money);
    then money_and_securities_distributed(t, pship, partner, money);
}

pub relation distribution_gain_recognized(t: Transaction, pship: Partnership, partner: Person, amount: Money) kind institutional {
    label en official "gain is recognized to a distributee partner only to the extent money (including section 731(c) marketable securities) distributed exceeds the adjusted basis of the partner's interest immediately before the distribution (section 731(a)(1))";
}
@source(IRC_S731_A, relation = formalizes, coverage = exact, quote = "gain shall not be recognized to such partner, except to the extent that any money distributed exceeds the adjusted basis of such partner's interest in the partnership immediately before the distribution")
rule S731aGainOnExcessMoney(t: Transaction, pship: Partnership, partner: Person, money: Money, basis: Money) defeasible {
    label en official "gain is recognized to the extent money (and treated-as-money marketable securities) distributed exceeds the partner's outside basis immediately before the distribution (section 731(a)(1))";
    when money_and_securities_distributed(t, pship, partner, money);
    when distributee_outside_basis_before_distribution(t, pship, partner, basis);
    when money > basis;
    unless section_731_defeated_by_other_section(t) and money_and_securities_distributed(t, pship, partner, money) and distributee_outside_basis_before_distribution(t, pship, partner, basis);
    unless deemed_money_distributed_from_liability_decrease(t, pship, partner, _) and money_and_securities_distributed(t, pship, partner, money) and distributee_outside_basis_before_distribution(t, pship, partner, basis);
    then distribution_gain_recognized(t, pship, partner, money - basis);
}
rule S731aNoGainMoneyWithinBasis(t: Transaction, pship: Partnership, partner: Person, money: Money, basis: Money) defeasible {
    label en official "no gain is recognized when money (and treated-as-money marketable securities) distributed does not exceed the partner's outside basis (section 731(a)(1))";
    when money_and_securities_distributed(t, pship, partner, money);
    when distributee_outside_basis_before_distribution(t, pship, partner, basis);
    when money <= basis;
    unless section_731_defeated_by_other_section(t) and money_and_securities_distributed(t, pship, partner, money);
    unless deemed_money_distributed_from_liability_decrease(t, pship, partner, _) and money_and_securities_distributed(t, pship, partner, money) and distributee_outside_basis_before_distribution(t, pship, partner, basis);
    then distribution_gain_recognized(t, pship, partner, 0 USD);
}

pub relation distribution_loss_recognized(t: Transaction, pship: Partnership, partner: Person, amount: Money) kind institutional {
    label en official "loss is recognized to a distributee partner only on a liquidating distribution of solely money, unrealized receivables, and inventory, to the extent the partner's outside basis exceeds the money distributed plus the distributee's section 732 basis in the receivables/inventory (section 731(a)(2))";
}
@source(IRC_S731_A, relation = formalizes, coverage = exact, quote = "loss shall be recognized to the extent of the excess of the adjusted basis of such partner's interest in the partnership over the sum of")
rule S731aLossOnLiquidation(t: Transaction, pship: Partnership, partner: Person, basis: Money, money: Money, hot_asset_basis: Money) defeasible {
    label en official "on a liquidating distribution of only money, unrealized receivables, and inventory, loss is recognized to the extent the partner's outside basis exceeds money distributed plus the distributee's section 732 basis in the receivables/inventory (section 731(a)(2))";
    when distribution_in_liquidation(t, pship, partner);
    when liquidating_distribution_money_receivables_inventory_only(t, pship, partner);
    when distributee_outside_basis_before_distribution(t, pship, partner, basis);
    when money_distributed(t, pship, partner, money);
    when distributee_basis_of_receivables_and_inventory(t, pship, partner, hot_asset_basis);
    when basis > (money + hot_asset_basis);
    unless section_731_defeated_by_other_section(t) and distribution_in_liquidation(t, pship, partner) and distributee_outside_basis_before_distribution(t, pship, partner, basis) and money_distributed(t, pship, partner, money) and distributee_basis_of_receivables_and_inventory(t, pship, partner, hot_asset_basis);
    then distribution_loss_recognized(t, pship, partner, basis - (money + hot_asset_basis));
}

// Gain/loss recognized under this section is gain/loss from the sale or
// exchange of the distributee's partnership interest (section 731(a), last
// sentence) — a classification of the character of the amount already computed.
pub relation distribution_gain_or_loss_is_from_partnership_interest_sale(t: Transaction, pship: Partnership, partner: Person) kind institutional {
    label en official "any gain or loss recognized under section 731 is considered gain or loss from the sale or exchange of the partnership interest of the distributee partner (section 731(a), last sentence)";
}
rule S731aCharacterIsInterestSaleFromGain(t: Transaction, pship: Partnership, partner: Person, amount: Money) defeasible {
    when distribution_gain_recognized(t, pship, partner, amount);
    when amount > 0 USD;
    then distribution_gain_or_loss_is_from_partnership_interest_sale(t, pship, partner);
}
rule S731aCharacterIsInterestSaleFromLoss(t: Transaction, pship: Partnership, partner: Person, amount: Money) defeasible {
    when distribution_loss_recognized(t, pship, partner, amount);
    when amount > 0 USD;
    then distribution_gain_or_loss_is_from_partnership_interest_sale(t, pship, partner);
}

@source(IRC_S731_B, relation = formalizes, coverage = exact, quote = "No gain or loss shall be recognized to a partnership on a distribution to a partner of property, including money.")
pub relation partnership_recognizes_no_gain_or_loss_on_distribution(t: Transaction, pship: Partnership) kind institutional {
    label en official "no gain or loss is recognized to a partnership on a distribution to a partner of property, including money (section 731(b))";
}
rule S731bPartnershipNoGainOrLoss(t: Transaction, pship: Partnership, partner: Person) strict {
    when money_distributed(t, pship, partner, _);
    then partnership_recognizes_no_gain_or_loss_on_distribution(t, pship);
}

// ============================================================================
// §732(a)-(b): basis of distributed property
// ============================================================================

pub relation distributed_property_pre_limitation_basis(t: Transaction, pship: Partnership, prop: Asset, amount: Money) kind empirical {
    label en unofficial "the adjusted basis of the distributed property to the partnership immediately before the distribution (section 732(a)(1))";
}
pub relation distribution_is_liquidating(t: Transaction) kind empirical {
    label en unofficial "the distribution transaction liquidates the distributee partner's entire interest (section 732(b); mirrors distribution_in_liquidation, kept as its own relation because section 732 basis rules are read transaction-wide, not per-partner-per-transaction like section 731's own relation)";
}

pub relation distributed_property_basis(t: Transaction, pship: Partnership, partner: Person, prop: Asset, amount: Money) kind institutional {
    label en official "the basis of distributed property (other than money) to the distributee partner: carryover basis capped at outside basis less money distributed for a non-liquidating distribution (section 732(a)), or substituted basis (outside basis less money distributed) for a liquidating distribution (section 732(b))";
}
@source(IRC_S732_A, relation = formalizes, coverage = exact, quote = "The basis of property (other than money) distributed by a partnership to a partner other than in liquidation of the partner's interest shall, except as provided in paragraph (2), be its adjusted basis to the partnership immediately before such distribution.")
rule S732aCarryoverBasisWithinLimit(t: Transaction, pship: Partnership, partner: Person, prop: Asset, pre_basis: Money, outside_basis: Money, money: Money) defeasible {
    label en official "for a non-liquidating distribution, the distributee's basis in distributed property is its partnership basis, capped at outside basis less money distributed (section 732(a)(1)-(2))";
    when distributed_property_pre_limitation_basis(t, pship, prop, pre_basis);
    when distributee_outside_basis_before_distribution(t, pship, partner, outside_basis);
    when money_distributed(t, pship, partner, money);
    when pre_basis <= (outside_basis - money);
    unless distribution_is_liquidating(t) and distributed_property_pre_limitation_basis(t, pship, prop, pre_basis) and distributee_outside_basis_before_distribution(t, pship, partner, outside_basis) and money_distributed(t, pship, partner, money);
    then distributed_property_basis(t, pship, partner, prop, pre_basis);
}
@source(IRC_S732_A, relation = formalizes, coverage = exact, quote = "The basis to the distributee partner of property to which paragraph (1) is applicable shall not exceed the adjusted basis of such partner's interest in the partnership reduced by any money distributed in the same transaction.")
rule S732aBasisLimitedToRemainingOutsideBasis(t: Transaction, pship: Partnership, partner: Person, prop: Asset, pre_basis: Money, outside_basis: Money, money: Money) defeasible {
    label en official "for a non-liquidating distribution, the distributee's basis is limited to outside basis less money distributed when the partnership's own basis in the property would exceed that limit (section 732(a)(2))";
    when distributed_property_pre_limitation_basis(t, pship, prop, pre_basis);
    when distributee_outside_basis_before_distribution(t, pship, partner, outside_basis);
    when money_distributed(t, pship, partner, money);
    when pre_basis > (outside_basis - money);
    unless distribution_is_liquidating(t) and distributed_property_pre_limitation_basis(t, pship, prop, pre_basis) and distributee_outside_basis_before_distribution(t, pship, partner, outside_basis) and money_distributed(t, pship, partner, money);
    then distributed_property_basis(t, pship, partner, prop, max(0 USD, outside_basis - money));
}
@source(IRC_S732_B, relation = formalizes, coverage = exact, quote = "The basis of property (other than money) distributed by a partnership to a partner in liquidation of the partner's interest shall be an amount equal to the adjusted basis of such partner's interest in the partnership reduced by any money distributed in the same transaction.")
rule S732bLiquidatingSubstitutedBasis(t: Transaction, pship: Partnership, partner: Person, prop: Asset, outside_basis: Money, money: Money) defeasible {
    label en official "for a liquidating distribution of a single distributed property, the distributee's basis in the property is outside basis less money distributed in the same transaction (section 732(b))";
    when distribution_is_liquidating(t);
    when distributed_property_pre_limitation_basis(t, pship, prop, _);
    when distributee_outside_basis_before_distribution(t, pship, partner, outside_basis);
    when money_distributed(t, pship, partner, money);
    then distributed_property_basis(t, pship, partner, prop, max(0 USD, outside_basis - money));
}

// ============================================================================
// §733: basis of distributee partner's interest
// ============================================================================

@source(IRC_S733, relation = formalizes, coverage = exact, quote = "the adjusted basis to such partner of his interest in the partnership shall be reduced (but not below zero) by")
pub relation distributee_outside_basis_after_distribution(t: Transaction, pship: Partnership, partner: Person, amount: Money) kind institutional {
    label en official "for a non-liquidating distribution, the distributee partner's outside basis is reduced (but not below zero) by the money distributed and the section 732 basis of distributed property other than money (section 733)";
}
rule S733ReduceOutsideBasisByMoneyAndProperty(t: Transaction, pship: Partnership, partner: Person, before: Money, money: Money, prop: Asset, prop_basis: Money) defeasible {
    label en official "outside basis is reduced by money distributed and the section 732 basis of distributed property (section 733(1)-(2))";
    when distributee_outside_basis_before_distribution(t, pship, partner, before);
    when money_distributed(t, pship, partner, money);
    when distributed_property_basis(t, pship, partner, prop, prop_basis);
    unless distribution_is_liquidating(t) and distributee_outside_basis_before_distribution(t, pship, partner, before) and money_distributed(t, pship, partner, money) and distributed_property_basis(t, pship, partner, prop, prop_basis);
    unless deemed_money_distributed_from_liability_decrease(t, pship, partner, _) and distributee_outside_basis_before_distribution(t, pship, partner, before) and money_distributed(t, pship, partner, money) and distributed_property_basis(t, pship, partner, prop, prop_basis);
    then distributee_outside_basis_after_distribution(t, pship, partner, max(0 USD, before - money - prop_basis));
}
rule S733ReduceOutsideBasisByMoneyOnly(t: Transaction, pship: Partnership, partner: Person, before: Money, money: Money) defeasible {
    label en official "outside basis is reduced by money distributed alone when no other property is distributed in the same non-liquidating transaction (section 733(1))";
    when distributee_outside_basis_before_distribution(t, pship, partner, before);
    when money_distributed(t, pship, partner, money);
    unless distribution_is_liquidating(t) and distributee_outside_basis_before_distribution(t, pship, partner, before) and money_distributed(t, pship, partner, money);
    unless distributed_property_basis(t, pship, partner, _, _) and distributee_outside_basis_before_distribution(t, pship, partner, before) and money_distributed(t, pship, partner, money);
    unless deemed_money_distributed_from_liability_decrease(t, pship, partner, _) and distributee_outside_basis_before_distribution(t, pship, partner, before) and money_distributed(t, pship, partner, money);
    then distributee_outside_basis_after_distribution(t, pship, partner, max(0 USD, before - money));
}
