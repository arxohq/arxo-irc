// 26 U.S.C. §§702-703 — Part I of Subchapter K: a partner's income and
// credits (§702) and the computation of partnership taxable income (§703).
//
// JUDGMENT CALLS AND GAPS (see report):
//  - §702(a)(7) ("other items... to the extent provided by regulations
//    prescribed by the Secretary") is EXTERNAL_DEPENDENCY: which additional
//    items Treasury regulations require to be separately stated is not
//    pinned by this snapshot. Modeled as the open `OtherSeparatelyStatedItem`
//    value of `DistributiveShareItem`, populated only by a case fact — no
//    rule invents the regulatory list.
//  - §702(b) (character determined at the partnership level) is modeled as
//    an institutional_effect classification: this package does not carry a
//    `Character` type of its own (that belongs to `property-transactions`,
//    §1221/§1222 — declared as a contract, not imported, per the task's
//    "do NOT import it yet" instruction). The rule below asserts that the
//    partner's item shares the SAME distributive-share-item CLASS as the
//    partnership's, which is as far as this package's own vocabulary goes;
//    a consumer that needs the actual `capital_asset`/`long_term` boolean
//    from `us.irc.property_transactions` still has to combine this
//    package's `distributive_share_item_class` with that package's own
//    §1222 test once the contract is imported — DEPENDENCIES.json row
//    pending (target: us.irc.property_transactions::long_term /
//    capital_asset).
//  - §703(a)(1) (separate statement) is implemented directly through the
//    `DistributiveShareItem` enum: every partnership-level item this package
//    reifies IS already separately stated by construction.
//  - §703(a)(2) (disallowed partnership-level deductions) is modeled as a
//    single classification relation naming the six disallowed deduction
//    kinds (a local enum, since none of `personal exemption / §164(a)
//    foreign tax / §170 charitable / §172 NOL / part-VII additional
//    itemized / §611 oil-and-gas depletion` has a shared core type to check
//    against) — EXECUTABLE as a closed list; a case that asserts one of
//    these six kinds as a partnership-level deduction claim gets
//    `partnership_deduction_disallowed`.
//  - §703(b) (elections made by the partnership, with the three
//    partner-level exceptions) is EXTERNAL_DEPENDENCY for the three named
//    elections themselves (they belong to §108(b)(5)/(c)(3), §617 and §901
//    — none formalized by this package), but the STATUTORY RULE ("who
//    makes the election") is executable and modeled directly: an election
//    of one of the three excepted kinds is made by each partner separately;
//    every other election affecting partnership taxable income is made by
//    the partnership. Modeled as a `power` of the correct holder rather
//    than a bare classification, since making an election changes the
//    legal relation (which computation method applies) — E-0239's
//    `valid_when`/`effect` shape.

language "law.core" version "0.2";
package us.irc.partnerships version "0.1.1";
namespace "urn:us:irc:partnerships:clir";

use self::{
    DistributiveShareItem,
    IRC_S702_A,
    IRC_S702_B,
    IRC_S702_C,
    IRC_S703_A,
    IRC_S703_B,
    Partnership,
    Person,
    TaxableYear,
    is_partner,
    partnership_interest_share,
};

// --- §702(a): distributive share, separately stated -------------------------

pub relation partnership_level_item(pship: Partnership, y: TaxableYear, item: DistributiveShareItem, amount: Money) kind empirical {
    label en unofficial "the partnership's own amount of a section 702(a) item for the year (partnership-level fact a case asserts, e.g. from its return)";
}

@source(IRC_S702_A, relation = formalizes, coverage = exact, quote = "each partner shall take into account separately his distributive share of the partnership's")
pub relation distributive_share(partner: Person, pship: Partnership, y: TaxableYear, item: DistributiveShareItem, amount: Money) kind institutional {
    label en official "in determining his income tax, each partner takes into account separately his distributive share of the partnership's section 702(a) items (section 702(a))";
}
rule S702DistributiveShareByAgreementInterest(partner: Person, pship: Partnership, y: TaxableYear, item: DistributiveShareItem, total: Money, share: Decimal) strict {
    label en official "a partner's distributive share of a separately stated item is the item's total amount times the partner's interest in the partnership (section 702(a); the allocation itself — agreement share vs. section 704(b) partner's-interest share — is section 704's own rule, imported here as partnership_interest_share)";
    when partnership_level_item(pship, y, item, total);
    when partnership_interest_share(partner, pship, share);
    then distributive_share(partner, pship, y, item, total * share);
}

// --- §702(b): character determined at the partnership level -----------------

@source(IRC_S702_B, relation = formalizes, coverage = partial, quote = "The character of any item of income, gain, loss, deduction, or credit included in a partner's distributive share under paragraphs (1) through (7) of subsection (a) shall be determined as if such item were realized directly from the source from which realized by the partnership, or incurred in the same manner as incurred by the partnership.")
pub relation distributive_share_item_class(partner: Person, pship: Partnership, y: TaxableYear, item: DistributiveShareItem) kind institutional {
    label en official "the character (item class) of a partner's distributive share item is the same class as the partnership's own item (section 702(b)) — the finer section 1221/1222 capital-asset/holding-period test is a us.irc.property_transactions dependency, pending";
}
rule S702CharacterFollowsPartnership(partner: Person, pship: Partnership, y: TaxableYear, item: DistributiveShareItem, amount: Money) strict {
    when distributive_share(partner, pship, y, item, amount);
    then distributive_share_item_class(partner, pship, y, item);
}

// --- §702(c): gross income of a partner includes distributive share of gross income

pub relation partnership_gross_income(pship: Partnership, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the partnership's gross income for the year (a case-asserted amount; computing it from the partnership's own items is us.irc.gross_income's norm, not reproduced here)";
}

@source(IRC_S702_C, relation = formalizes, coverage = exact, quote = "In any case where it is necessary to determine the gross income of a partner for purposes of this title, such amount shall include his distributive share of the gross income of the partnership.")
pub relation partner_gross_income_includes_distributive_share(partner: Person, pship: Partnership, y: TaxableYear, amount: Money) kind institutional {
    label en official "a partner's gross income includes his distributive share of the gross income of the partnership (section 702(c))";
}
rule S702GrossIncomeIncludesDistributiveShare(partner: Person, pship: Partnership, y: TaxableYear, gi: Money, share: Decimal) strict {
    when partnership_gross_income(pship, y, gi);
    when partnership_interest_share(partner, pship, share);
    then partner_gross_income_includes_distributive_share(partner, pship, y, gi * share);
}

// --- §703(a)(1): separate statement — executed by construction (see header) -

// --- §703(a)(2): deductions not allowed to the partnership -------------------

enum PartnershipDisallowedDeductionKind {
    PersonalExemption;
    ForeignAndPossessionTaxDeduction;
    CharitableContributionDeduction;
    NetOperatingLossDeduction;
    AdditionalItemizedDeductionPartVII;
    OilAndGasDepletionDeduction;
}

pub relation partnership_deduction_claimed(pship: Partnership, y: TaxableYear, kind: PartnershipDisallowedDeductionKind) kind empirical {
    label en unofficial "the partnership's return claims a deduction of one of the section 703(a)(2) kinds";
}

@source(IRC_S703_A, relation = formalizes, coverage = exact, quote = "the following deductions shall not be allowed to the partnership")
pub relation partnership_deduction_disallowed(pship: Partnership, y: TaxableYear, kind: PartnershipDisallowedDeductionKind) kind institutional {
    label en official "the six section 703(a)(2)(A)-(F) deductions are not allowed to the partnership (each partner takes its own personal-exemption, foreign-tax, charitable, NOL, part-VII, and depletion deductions separately)";
}
rule S703DeductionDisallowedAtPartnershipLevel(pship: Partnership, y: TaxableYear, kind: PartnershipDisallowedDeductionKind) strict {
    when partnership_deduction_claimed(pship, y, kind);
    then partnership_deduction_disallowed(pship, y, kind);
}

// --- §703(b): elections made by the partnership, with three exceptions ------

enum PartnershipElectionKind {
    DischargeOfIndebtednessS108B5OrC3;
    MiningExplorationExpenditureS617;
    ForeignTaxS901;
    OtherComputationElection;
}

relation election_of_kind(e: us.irc.core::Election, kind: PartnershipElectionKind) kind empirical {
    label en unofficial "which section 703(b) election kind this Election instance is";
}
relation election_over_partnership(e: us.irc.core::Election, pship: Partnership, y: TaxableYear) kind empirical {
    label en unofficial "the election affects computation of taxable income derived from this partnership for this year";
}

pub relation partnership_election_made(pship: Partnership, y: TaxableYear, e: us.irc.core::Election) kind institutional {
    label en unofficial "the partnership validly made a section 703(b) general-rule election";
}
pub relation partner_separate_election_made(partner: Person, pship: Partnership, y: TaxableYear, e: us.irc.core::Election) kind institutional {
    label en unofficial "the partner validly made one of the three section 703(b) partner-level exception elections separately";
}

@source(IRC_S703_B, relation = formalizes, coverage = exact, quote = "Any election affecting the computation of taxable income derived from a partnership shall be made by the partnership, except that any election under")
rule S703ElectionByPartnershipPower(pship: Partnership, y: TaxableYear, e: us.irc.core::Election) strict {
    label en official "an election affecting computation of partnership taxable income, other than the three excepted elections, is made by the partnership (section 703(b) general rule)";
    when election_over_partnership(e, pship, y);
    when election_of_kind(e, OtherComputationElection);
    then power S703PartnershipElectionPower {
        holder pship;
        over e;
        exercise us.irc.core::election_by(e, pship);
        valid_when election_over_partnership(e, pship, y);
        effect create(partnership_election_made(pship, y, e));
        subject us.irc.core::Election;
        window [-infinity, infinity);
    };
}

@source(IRC_S703_B, relation = formalizes, coverage = exact, quote = "shall be made by each partner separately")
rule S703ElectionByPartnerSeparatelyPower(partner: Person, pship: Partnership, y: TaxableYear, e: us.irc.core::Election, kind: PartnershipElectionKind) strict {
    label en official "an election under section 108(b)(5)/(c)(3), section 617, or section 901 is made by each partner separately, not by the partnership (section 703(b) exceptions (1)-(3))";
    when election_over_partnership(e, pship, y);
    when election_of_kind(e, kind);
    when kind != OtherComputationElection;
    when is_partner(partner, pship);
    then power S703PartnerSeparateElectionPower {
        holder partner;
        over e;
        exercise us.irc.core::election_by(e, partner);
        valid_when election_of_kind(e, kind);
        effect create(partner_separate_election_made(partner, pship, y, e));
        subject us.irc.core::Election;
        window [-infinity, infinity);
    };
}
