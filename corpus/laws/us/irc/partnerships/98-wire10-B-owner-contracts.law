// Partnerships -- WIRE-10 group B (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// Placeholder relations of this package that name a norm of `us.irc.definitions` are derived from its `pub` relations. The case-fact
// channel stays valid (WIRE-7/8/9 technique).

language "law.core" version "0.2";
package us.irc.partnerships version "0.1.1";
namespace "urn:us:irc:partnerships:clir";

use self::{
    IRC_S761_A,
    Partnership,
    is_corporation_trust_or_estate,
};

// --- section 761(a) chapeau: an organization that is a corporation is excluded (owner: definitions, section 7701(a)(3)) --------------
// Partial: only the corporation branch is derived; the trust and estate branches stay case facts (definitions publishes no
// classification relation for a trust or an estate that is not keyed by a `Trust`/`Estate` entity).

@source(IRC_S761_A, relation = formalizes, coverage = partial, quote = "which is not, within the meaning of this title, a corporation or a trust or estate")
rule W10OrganizationIsCorporationFromDefinitions(org: us.irc.core::Partnership) strict {
    label en official "an organization the definitions package classifies as a corporation (section 7701(a)(3)) is a corporation within the meaning of this title";
    when us.irc.definitions::corporation(org);
    then is_corporation_trust_or_estate(org);
}
