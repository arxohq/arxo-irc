// 26 U.S.C. §§721-723 — Part II, subpart A: contributions to a partnership
// in exchange for a partnership interest.
//
// JUDGMENT CALLS AND GAPS (see report):
//  - §721(b) (investment-company exception) is modeled as a case-asserted
//    classification (`would_be_investment_company_if_incorporated`, the
//    section 351 test itself is a us.irc.corporate-distributions dependency,
//    not formalized here — DEPENDENCIES.json row pending) that defeats the
//    section 721(a) nonrecognition rule for GAIN only (the statute's own
//    "gain realized" wording — loss is not reached by (b)).
//  - §721(c) (Secretary's regulatory authority to deny nonrecognition to
//    gain includible by a non-U.S.-person) is EXTERNAL_DEPENDENCY: it is a
//    delegation of rulemaking, not a self-executing rule ("The Secretary MAY
//    provide by regulations") — modeled as a defeater flag a case can set
//    once such a regulation in fact applies, not as a standing test this
//    package invents.
//  - §722's basis rule reads "the amount of any money contributed" and "the
//    adjusted basis of such contributed property... at the time of the
//    contribution, increased by the amount (if any) of gain recognized...
//    under section 721(b)" — modeled directly; the further statutory
//    cross-reference to section 752 (liabilities) is picked up by 06's
//    module, not duplicated here (06 adds the section 752(a) increase as a
//    separate rule over the same `contribution_basis_after_s721b_gain`
//    output relation, matching the corpus convention of one head, several
//    contributing rules).
//  - §723's partnership-side basis rule is the mirror of §722 without the
//    money term (a partnership does not have a "basis in money"); modeled
//    directly.
//  - Compiler note: `property` is a hard keyword (LDC-E0203); every variable
//    below uses `prop`. Every rule reading a relation produced by a
//    `defeasible` rule is itself `defeasible` (LDC-E4103); `pship` is bound
//    in every rule through the positive `contribution_of_property` premise,
//    never left to be inferred only from a same-transaction fact that does
//    not itself carry `pship` (LDC-E4101).

language "law.core" version "0.2";
package us.irc.partnerships version "0.1.1";
namespace "urn:us:irc:partnerships:clir";

use self::{
    Asset,
    IRC_S721_A,
    IRC_S722,
    IRC_S723,
    OwnershipInterest,
    Partnership,
    Person,
    Transaction,
};

// ============================================================================
// §721: nonrecognition on contribution
// ============================================================================

pub relation contribution_of_property(t: Transaction, contributor: Person, pship: Partnership, prop: Asset, in_exchange_for: OwnershipInterest) kind empirical {
    label en unofficial "the contributor transferred property to the partnership in exchange for an interest in the partnership (section 721(a))";
}
relation would_be_investment_company_if_incorporated(pship: Partnership) kind institutional {
    label en unofficial "EXTERNAL_DEPENDENCY (us.irc.corporate_distributions, section 351 test, pending): the partnership would be treated as an investment company within the meaning of section 351 if it were incorporated (section 721(b)) — case-asserted";
}
relation contribution_gain_realized(t: Transaction, contributor: Person, amount: Money) kind empirical {
    label en unofficial "the amount of gain realized (before section 721) on the contribution transaction";
}
relation s721c_regulation_denies_nonrecognition(t: Transaction) kind institutional {
    label en unofficial "EXTERNAL_DEPENDENCY (26 CFR, section 721(c) delegated rulemaking, pending): a regulation prescribed under section 721(c) denies nonrecognition to this contribution because the recognized gain would be includible in the gross income of a person other than a United States person — case-asserted, since this package does not invent the regulation";
}

@source(IRC_S721_A, relation = formalizes, coverage = exact, quote = "No gain or loss shall be recognized to a partnership or to any of its partners in the case of a contribution of property to the partnership in exchange for an interest in the partnership.")
pub relation contribution_gain_or_loss_recognized(t: Transaction, who: Person, amount: Money) kind institutional {
    label en official "gain or loss on a contribution of property to a partnership in exchange for a partnership interest is recognized only when section 721(a)'s nonrecognition is defeated by the section 721(b) investment-company exception or a section 721(c) regulation (section 721(a)-(c))";
}
rule S721bInvestmentCompanyGainRecognized(t: Transaction, contributor: Person, pship: Partnership, amount: Money) strict {
    label en official "gain realized on a transfer to a partnership that would be an investment company if incorporated is recognized, notwithstanding section 721(a) (section 721(b))";
    when contribution_of_property(t, contributor, pship, _, _);
    when would_be_investment_company_if_incorporated(pship);
    when contribution_gain_realized(t, contributor, amount);
    then contribution_gain_or_loss_recognized(t, contributor, amount);
}
rule S721cRegulationGainRecognized(t: Transaction, contributor: Person, pship: Partnership, amount: Money) defeasible {
    label en official "gain realized on a transfer to a partnership is recognized when a section 721(c) regulation denies nonrecognition because the gain would be includible in the gross income of a non-United-States person (section 721(c))";
    when contribution_of_property(t, contributor, pship, _, _);
    when s721c_regulation_denies_nonrecognition(t);
    when contribution_gain_realized(t, contributor, amount);
    then contribution_gain_or_loss_recognized(t, contributor, amount);
}
rule S721aNonrecognitionGeneral(t: Transaction, contributor: Person, pship: Partnership) defeasible {
    label en official "no gain or loss is recognized to a partnership or to any of its partners on a contribution of property in exchange for a partnership interest, absent the section 721(b)/(c) exceptions (section 721(a))";
    when contribution_of_property(t, contributor, pship, _, _);
    unless would_be_investment_company_if_incorporated(pship) and contribution_of_property(t, contributor, pship, _, _);
    unless s721c_regulation_denies_nonrecognition(t) and contribution_of_property(t, contributor, pship, _, _);
    then contribution_gain_or_loss_recognized(t, contributor, 0 USD);
}

// ============================================================================
// §722: basis of contributing partner's interest
// ============================================================================

pub relation money_contributed(t: Transaction, contributor: Person, pship: Partnership, amount: Money) kind empirical {
    label en unofficial "the amount of money contributed to the partnership by this partner in this transaction (section 722)";
}
pub relation basis_of_contributed_property(t: Transaction, contributor: Person, prop: Asset, amount: Money) kind empirical {
    label en unofficial "the adjusted basis to the contributing partner of the contributed property at the time of the contribution (section 722)";
}

@source(IRC_S722, relation = formalizes, coverage = exact, quote = "The basis of an interest in a partnership acquired by a contribution of property, including money, to the partnership shall be the amount of such money and the adjusted basis of such property to the contributing partner at the time of the contribution increased by the amount (if any) of gain recognized under section 721(b) to the contributing partner at such time.")
pub relation contribution_basis(partner: Person, pship: Partnership, t: Transaction, amount: Money) kind institutional {
    label en official "the basis of a contributing partner's interest in the partnership is the amount of money contributed plus the adjusted basis to him of the contributed property, before the section 721(b) gain increase (section 722)";
}
rule S722BasisFromMoneyOnly(partner: Person, pship: Partnership, t: Transaction, money: Money) defeasible {
    label en official "the basis of a contributing partner's interest includes the amount of money contributed (section 722)";
    when money_contributed(t, partner, pship, money);
    unless basis_of_contributed_property(t, partner, _, _) and money_contributed(t, partner, pship, money);
    then contribution_basis(partner, pship, t, money);
}
rule S722BasisFromPropertyOnly(partner: Person, pship: Partnership, t: Transaction, prop: Asset, prop_basis: Money) defeasible {
    label en official "the basis of a contributing partner's interest includes the adjusted basis of contributed property (section 722)";
    when contribution_of_property(t, partner, pship, prop, _);
    when basis_of_contributed_property(t, partner, prop, prop_basis);
    unless money_contributed(t, partner, pship, _) and contribution_of_property(t, partner, pship, prop, _) and basis_of_contributed_property(t, partner, prop, prop_basis);
    then contribution_basis(partner, pship, t, prop_basis);
}
rule S722BasisFromMoneyAndProperty(partner: Person, pship: Partnership, t: Transaction, money: Money, prop_basis: Money) strict {
    label en official "when both money and property are contributed in the same transaction, the basis of the contributing partner's interest is their sum (section 722)";
    when money_contributed(t, partner, pship, money);
    when basis_of_contributed_property(t, partner, _, prop_basis);
    then contribution_basis(partner, pship, t, money + prop_basis);
}

pub relation contribution_basis_after_s721b_gain(partner: Person, pship: Partnership, t: Transaction, amount: Money) kind institutional {
    label en unofficial "the section 722 basis after adding any section 721(b)/(c) recognized gain — the final section 722 basis figure before any section 752 liability adjustment (see 06-transfers-hot-assets-and-elections.law)";
}
rule S722BasisIncreasedByRecognizedGain(partner: Person, pship: Partnership, t: Transaction, before: Money, gain: Money) defeasible {
    label en official "the section 722 basis is increased by the amount of any gain recognized to the contributing partner under section 721(b)/(c) (section 722)";
    when contribution_basis(partner, pship, t, before);
    when contribution_gain_or_loss_recognized(t, partner, gain);
    when gain > 0 USD;
    then contribution_basis_after_s721b_gain(partner, pship, t, before + gain);
}
rule S722BasisUnchangedWithoutGain(partner: Person, pship: Partnership, t: Transaction, before: Money) defeasible {
    label en official "absent section 721(b)/(c) recognized gain, the section 722 basis is unchanged";
    when contribution_basis(partner, pship, t, before);
    unless contribution_gain_or_loss_recognized(t, partner, _) and contribution_basis(partner, pship, t, before);
    then contribution_basis_after_s721b_gain(partner, pship, t, before);
}

// ============================================================================
// §723: basis of property to partnership
// ============================================================================

@source(IRC_S723, relation = formalizes, coverage = exact, quote = "The basis of property contributed to a partnership by a partner shall be the adjusted basis of such property to the contributing partner at the time of the contribution increased by the amount (if any) of gain recognized under section 721(b) to the contributing partner at such time.")
pub relation partnership_basis_in_contributed_property(pship: Partnership, prop: Asset, t: Transaction, amount: Money) kind institutional {
    label en official "the basis of property contributed to a partnership by a partner is the adjusted basis of such property to the contributing partner at the time of the contribution, increased by any section 721(b)/(c) gain recognized by the contributing partner (section 723)";
}
rule S723BasisFromContributorsBasis(pship: Partnership, prop: Asset, t: Transaction, contributor: Person, contributor_basis: Money) defeasible {
    label en official "the partnership's basis in contributed property is the contributing partner's adjusted basis in the property at the time of contribution (section 723)";
    when contribution_of_property(t, contributor, pship, prop, _);
    when basis_of_contributed_property(t, contributor, prop, contributor_basis);
    unless contribution_gain_or_loss_recognized(t, contributor, _) and contribution_of_property(t, contributor, pship, prop, _) and basis_of_contributed_property(t, contributor, prop, contributor_basis);
    then partnership_basis_in_contributed_property(pship, prop, t, contributor_basis);
}
rule S723BasisIncreasedByRecognizedGain(pship: Partnership, prop: Asset, t: Transaction, contributor: Person, contributor_basis: Money, gain: Money) defeasible {
    label en official "the partnership's basis in contributed property is increased by any section 721(b)/(c) gain recognized by the contributing partner (section 723)";
    when contribution_of_property(t, contributor, pship, prop, _);
    when basis_of_contributed_property(t, contributor, prop, contributor_basis);
    when contribution_gain_or_loss_recognized(t, contributor, gain);
    when gain > 0 USD;
    then partnership_basis_in_contributed_property(pship, prop, t, contributor_basis + gain);
}
