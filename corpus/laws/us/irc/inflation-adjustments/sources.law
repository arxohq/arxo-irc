    content_hash "sha256:49f465d481f2e181379103125be38354a8bf2fbe1a8fa5860043e1fa83d9c26f";
}

pub fragment RP2024_40_S2_55 in RP2024_40_IRB {
    kind article;
    locator "rev-proc/2024-40/section/2.55";
    text en official """.55 Other Assessable Penalties With Respect to the Preparation of Tax Returns for
Other Persons. In the case of any failure relating to a return or claim for refund filed in
2026, the penalty amounts under § 6695 are:
Scenario
Failure to furnish copy to taxpayer (§ 6695(a))

Per Return or
Claim for Refund
