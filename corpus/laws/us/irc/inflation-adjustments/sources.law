pub fragment RP2024_40_S2_08 in RP2024_40_IRB {
    kind article;
    locator "rev-proc/2024-40/section/2.08";
    text en official """.08 Rehabilitation Expenditures Treated as Separate New Building. For calendar year
2025, the per low-income unit qualified basis amount under § 42(e)(3)(A)(ii)(II) is $8,500.""";
    content_hash "sha256:635e266b662496b7ce1e4a86d02ae7560eb808076d5686c87e03b032eec91e20";
}

pub fragment RP2024_40_S2_09 in RP2024_40_IRB {
    kind article;
    locator "rev-proc/2024-40/section/2.09";
    text en official """.09 Low-Income Housing Credit. For calendar year 2025, the amount used under
§ 42(h)(3)(C)(ii) to calculate the State housing credit ceiling for the low-income housing
credit is the greater of (1) $3.00 multiplied by the State population, or (2) $3,455,000.""";
    content_hash "sha256:c59ad7fb3c1dca7fb632d6dd4810571266dff8c08ad9c839040a24bb315f9255";
}

pub fragment RP2024_40_S2_10 in RP2024_40_IRB {
    kind article;
    locator "rev-proc/2024-40/section/2.10";
    text en official """.10 Employee Health Insurance Expense of Small Employers. For taxable years
beginning in 2025, the dollar amount in effect under § 45R(d)(3)(B) is $33,300. This amount
is used under § 45R(c) for limiting the small employer health insurance credit and under
§ 45R(d)(1)(B) for determining who is an eligible small employer for purposes of the credit.""";
    content_hash "sha256:bb59ebfc746ee80dafce6f0ed805da86f3bcfa6f7733f3bf26932e5e1a0a2689";
}

