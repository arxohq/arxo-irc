    content_hash "sha256:6ecd45ee03fbdbb110f9c3485bc13f5e17791ddd67d57464c2d3e8e95a30e870";
}

pub fragment RP2025_32_S4_54 in RP2025_32_IRB {
    kind article;
    locator "rev-proc/2025-32/section/4.54";
    text en official """.54 Other Assessable Penalties with Respect to the Preparation of Tax Returns for
Other Persons. In the case of any failure relating to a return or claim for refund filed in
2027, the penalty amounts under § 6695 are:

Scenario

Per Return or
Claim for Refund

Maximum
