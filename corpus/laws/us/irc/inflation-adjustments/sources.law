    content_hash "sha256:afc660c3733327c9df984f34741e4e825607ba365d5109ea833a14bc5a9b1835";
}

pub fragment RP2024_40_S2_56 in RP2024_40_IRB {
    kind article;
    locator "rev-proc/2024-40/section/2.56";
    text en official """.56 Failure to File Partnership Return. In the case of any return required to be filed in
2026, the dollar amount used to determine the amount of the penalty under § 6698(b)(1) is
$255.""";
    content_hash "sha256:8490231cd2975178e31f115e6c5d467c378c0bbebb1ecb1427660174bd95c3fc";
}

pub fragment RP2024_40_S2_57 in RP2024_40_IRB {
    kind article;
    locator "rev-proc/2024-40/section/2.57";
    text en official """.57 Failure to File S Corporation Return. In the case of any return required to be filed in
2026, the dollar amount used to determine the amount of the penalty under § 6699(b)(1) is
$255.""";
    content_hash "sha256:0b6b3d25af378f42e6e3527111210c563a468538c9a75bbf1cd84265370ebba0";
}

pub fragment RP2024_40_S2_58 in RP2024_40_IRB {
    kind article;
    locator "rev-proc/2024-40/section/2.58";
