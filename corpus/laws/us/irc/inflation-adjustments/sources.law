    content_hash "sha256:09fa7f7b51897d44a16cd8a02aa3a1d6864b54d44153cfe9c07cdae524357b19";
}

pub fragment RP2025_32_S4_55 in RP2025_32_IRB {
    kind article;
    locator "rev-proc/2025-32/section/4.55";
    text en official """.55 Failure to File Partnership Return. In the case of any return required to be filed
in 2027, the dollar amount used to determine the amount of the penalty under
§ 6698(b)(1) is $260.""";
    content_hash "sha256:8e6150b7f25512949e64c04abadf5a631d804892522956580ee717b3528b1423";
}

pub fragment RP2025_32_S4_56 in RP2025_32_IRB {
    kind article;
    locator "rev-proc/2025-32/section/4.56";
    text en official """.56 Failure to File S Corporation Return. In the case of any return required to be
filed in 2027, the dollar amount used to determine the amount of the penalty under
§ 6699(b)(1) is $260.""";
    content_hash "sha256:d6df45d038f4201642cd5b5cd2435459aa0d79ff59e4782979a1a55c93ae63dc";
}

