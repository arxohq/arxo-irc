// 26 U.S.C. §§6721-6725 — Information return and payee statement penalties.
// STAGE 2b, second of the seven named `pub` targets: `pub
// information_return_penalty_6721`, `pub payee_statement_penalty_6722`.
// Also covers §6723 (other information reporting requirements), §6724(a)
// (reasonable-cause waiver shared by this whole part) and (d) (definitions,
// satisfied by reuse of `us.irc.information_reporting`'s own typed kind
// rather than re-enumerated), and §6725 (section 4101 fuel reports).
//
// SCOPE AND JUDGMENT CALLS (see report):
//  - §6721(a)/(b)/(d)/(e)(2)(A)/(e)(3) and the mirror-image §6722(a)/(b)/(d)/
//    (e)(2)(A)/(e)(3) are modelled AS REAL PER-BUCKET AGGREGATIONS: each
//    failure is classified into exactly one of four buckets (full-rate,
//    30-day-correction, August-1-correction, intentional-disregard), the
//    per-failure amount is computed for its bucket, and the THREE separate
//    statutory annual caps ($3,000,000 / $500,000 / $1,500,000, or the (d)
//    lower substituted caps for small filers) are each applied to their own
//    bucket's sum via `sum all ... where` (an ordinary bounded aggregation
//    over case-asserted failure instances, not the open-ended recursive
//    accumulation pattern 01-shared.law's header flags) — the (e)(3)
//    intentional-disregard bucket is correctly excluded from the $3,000,000
//    cap and from the other buckets' caps, matching the statute's own text.
//  - §6721(e)(2)/(6722(e)(2))'s percentage branches (B)/(C)/(D) (the 5
//    percent broker/6050K/6050L branch, the section 6050I cash-transaction
//    $25,000-or-cash-received branch, the section 6050V 10-percent-of-value
//    branch) are NOT modelled: only the GENERAL (A) 10-percent branch is —
//    TECH_GAP, TECH-GAPS G496.
//  - §6721(c)/§6722(c)'s (3) dollar-safe-harbor (no single error over $100,
//    no withholding error over $25) IS modelled as a guard that removes a
//    failure from "failure" status entirely. The (1)/(2) COUNT-based de
//    minimis exception (the greater of 10, or 0.5% of the person's total
//    information returns for the year) is NOT modelled — it requires
//    counting ALL of a person's information returns for the year (not just
//    the failing ones), a different aggregate this package does not have
//    the total-returns-filed fact for — TECH_GAP, TECH-GAPS G496.
//  - §6721(d)/(6722(d))'s gross-receipts test is a case-asserted fact
//    (`meets_gross_receipts_test_6721d`): computing the "average annual
//    gross receipts for the most recent 3 taxable years" per section 448(c)
//    needs `gross-income`/`accounting` package facts this package does not
//    import — EXTERNAL_DEPENDENCY.
//  - §6721(f)/(6722(f)) inflation adjustment: SOURCE_GAP. The base 2015-Act
//    dollar figures ($250/$50/$100/$500/$3,000,000/$500,000/$1,500,000/
//    $1,000,000/$175,000/$500,000) are pinned exactly from the 2024-edition
//    text (validity start 2016-01-01, the PATH Act 2015 applicability date
//    per `IRC_S6721_NOTE_5`/`Pub. L. 114-27 sec. 806(f)`); the CURRENT,
//    inflation-adjusted dollar amounts actually in effect for recent
//    calendar years are NOT recorded here because no Rev. Proc. is pinned
//    in `us.irc.inflation_adjustments` for section 6721/6722 (grep
//    confirmed no §6721/§6722 row exists there as of this pass) — this is
//    exactly the SOURCE_GAP pattern TECH-GAPS G3 already documents for
//    every indexed-but-unpinned amount in this corpus, not a new gap.
//  - §6723's "specified information reporting requirement" (defined at
//    §6724(d)(3): TIN-furnishing/inclusion requirements under section 6109,
//    and the section 6050K(c)(1) transferor notice) is a case-asserted
//    empirical fact (`specified_information_reporting_requirement_failure`)
//    rather than derived from each named cross-reference — those
//    cross-referenced sections (6109, 6050K(c)(1)) are outside this
//    package's owned sections.
//  - §6724(a)'s "reasonable cause and not [] willful neglect" is textually
//    IDENTICAL to 01-shared.law's `reasonable_cause_and_no_willful_neglect`
//    (used for §6651/6654) — REUSED here (same channel, same standard),
//    not a new one, per the discipline of not multiplying channels for the
//    same wording. §6724(a) governs "this part" (sections 6721-6725), so
//    the same defeater is wired into all three computable sections'
//    per-failure rules here.
//  - §6724(b) (payment mechanics, "paid on notice and demand ... in the
//    same manner as tax") is NON_NORMATIVE for this package: pure collection
//    mechanics, no independent computable rule.
//  - §6724(c) (magnetic-media special rule keyed to the section 6011(e)(5)
//    applicable-number schedule) is a case-asserted guard
//    (`magnetic_media_failure_within_exception`) — deriving the applicable
//    number itself is the TECH-GAPS G8/G9-adjacent aggregate-over-derived
//    class (§111 boundary), not attempted.
//  - §6724(d)(1)/(2) ("information return"/"payee statement" definitions):
//    satisfied by REUSE of `us.irc.information_reporting::InformationReturnKind`
//    and its `information_return_required`/`payee_statement_required`
//    relations, rather than re-enumerating the ~30 cross-referenced sections
//    in this package — the scope of "which return counts" is exactly the
//    imported package's own `InformationReturnKind` enum (currently 18
//    values; §6724(d)(1) lists ~27 cross-references, several of which
//    (e.g. section 6050A, 6050N, 6050Q, 6050R, 6050T, 6050U, 6050Y, 6045A(d),
//    6043A, 6045B, 264(f)(5)(A)(iv), 338(h)(10)(C), 1060(b)/(e), 4101(d),
//    108, 408(i), 6047(d), 6035) are NOT yet in that enum — this package's
//    §6721/§6722 rules therefore only reach failures of the 18 already-
//    modelled kinds; the rest is TECH_GAP inherited from
//    `information-reporting`'s own stage-1 scope, not re-flagged here.
//  - §6724(d)(4) ("required filing date") is satisfied by reuse of
//    `us.irc.information_reporting::information_return_due`/
//    `payee_statement_due`.
//  - §6724(e) (partnership schedules as separate returns), (f) (educational-
//    institution TIN certification exception), (g) (rollover-certification
//    reliance exception) are NOT modelled this pass — narrow special rules,
//    TECH_GAP, TECH-GAPS G496.
//  - §6725(c)'s "due to reasonable cause" (no willful-neglect companion) is
//    a FOURTH, textually distinct DECISION-0194 channel from the three
//    already in this package (`reasonable_cause_and_no_willful_neglect`,
//    `reasonable_cause_and_good_faith`, `reasonable_cause_for_excessive_claim`)
//    — none of those three matches this exact standalone "reasonable cause"
//    wording with a REPORT (not a claim) as the object, so a new one is
//    declared (`reasonable_cause_for_report_failure`).

language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

use self::{
    FailureContext,
    IRC_S6721_A,
    IRC_S6721_B,
    IRC_S6721_C,
    IRC_S6721_E,
    IRC_S6722_A,
    IRC_S6722_B,
    IRC_S6722_C,
    IRC_S6722_E,
    IRC_S6723,
    IRC_S6725_A,
    Person,
    TaxableYear,
    reasonable_cause_and_no_willful_neglect,
};

// =============================================================================
// §6724(a) — shared reasonable-cause waiver for this part (6721-6725)
// =============================================================================
// Reuses `us.irc.penalties::reasonable_cause_and_no_willful_neglect` from
// 01-shared.law (same FailureContext entity) — no new declaration needed.

// =============================================================================
// §6721 — Failure to file correct information returns
// =============================================================================

pub entity InformationReturnFailure {
    label en unofficial "one occurrence of a section 6721(a)(2) failure (late filing, or incorrect/incomplete information) with respect to one information return";
}
pub enum InformationFailureDefectKind {
    LateFiling;
    IncorrectOrMissingInformation;
}
relation information_return_failure_of(f: InformationReturnFailure, payer: Person, y: TaxableYear, kind: us.irc.information_reporting::InformationReturnKind) kind empirical {
    label en unofficial "the failure occurred with respect to this payer's information return of this kind for this year";
}
relation information_return_failure_defect(f: InformationReturnFailure, defect: InformationFailureDefectKind) kind empirical {
    label en unofficial "whether the failure is (A) late filing or (B) incorrect/missing information";
}
relation information_return_failure_corrected_on(f: InformationReturnFailure, d: Date) kind empirical {
    label en unofficial "the date, if any, on which the failure was corrected";
}
relation information_return_failure_intentional_disregard(f: InformationReturnFailure) kind empirical {
    label en official "due to intentional disregard of the filing requirement (or the correct information reporting requirement)";
}
relation information_return_failure_aggregate_amount_required(f: InformationReturnFailure, amount: Money) kind empirical {
    label en unofficial "the aggregate amount of the items required to be reported correctly (needed only for the (e)(2)(A) percentage test)";
}
relation information_return_failure_error_amount(f: InformationReturnFailure, amount: Money) kind empirical {
    label en unofficial "the (c)(3) safe-harbor test: the single dollar amount by which the reported figure differs from the correct amount";
}
relation information_return_failure_withholding_error_amount(f: InformationReturnFailure, amount: Money) kind empirical {
    label en unofficial "the (c)(3) safe-harbor test: the single dollar amount by which a reported tax-withheld figure differs from the correct amount";
}
relation magnetic_media_failure_within_exception(f: InformationReturnFailure) kind empirical {
    label en unofficial "case fact (owner: TECH_GAP, section 6011(e)(5) applicable-number schedule not derived): the (c) magnetic-media special rule exempts this failure";
}
pub relation meets_gross_receipts_test_6721d(payer: Person, y: TaxableYear) kind institutional {
    label en unofficial "PENDING (owner: gross-income/accounting, section 448(c)) — average annual gross receipts for the 3 most recent taxable years do not exceed $5,000,000";
}

// --- (c)(3): dollar safe harbor removes the failure entirely ---------------

pub relation information_return_failure_within_safe_harbor(f: InformationReturnFailure) kind institutional {
    label en official "no single amount in error differs from the correct amount by more than $100 ... no single amount reported for tax withheld ... differs from the correct amount by more than $25 ... such return shall be treated as having been filed with all of the correct required information";
}
@source(IRC_S6721_C, relation = formalizes, coverage = exact, quote = "no single amount in error differs from the correct amount by more than $100")
rule InformationReturnSafeHarbor strict {
    for f: InformationReturnFailure;
    for err: Money;
    for werr: Money;
    when information_return_failure_error_amount(f, err)
        and information_return_failure_withholding_error_amount(f, werr)
        and err <= round(InformationReturnSafeHarborErrorThreshold, 2, "HALF_UP")
        and werr <= round(InformationReturnSafeHarborWithholdingErrorThreshold, 2, "HALF_UP");
    then information_return_failure_within_safe_harbor(f);
}

// --- correction-window classification ---------------------------------------

pub relation information_return_failure_corrected_within_30_days(f: InformationReturnFailure) kind institutional {
    label en official "corrected on or before the day 30 days after the required filing date";
}
@source(IRC_S6721_B, relation = formalizes, coverage = exact, quote = "corrected on or before the day 30 days after the required filing date")
rule InformationReturnCorrectedWithin30Days strict {
    for f: InformationReturnFailure;
    for payer: Person;
    for y: TaxableYear;
    for kind: us.irc.information_reporting::InformationReturnKind;
    for due: Date;
    for corrected: Date;
    when information_return_failure_of(f, payer, y, kind)
        and us.irc.information_reporting::information_return_due(payer, y, kind, due)
        and information_return_failure_corrected_on(f, corrected)
        and corrected <= add_calendar_period(due, 30 calendar_day);
    then information_return_failure_corrected_within_30_days(f);
}
// TECH_GAP (TECH-GAPS G497): the grammar has no "Nth day of the calendar
// year containing this Date" builtin (only `add_calendar_period` stepping
// FROM a date, not constructing "August 1 of year Y" from a TaxableYear
// alone) — `corrected_on_or_before_august_1_of_filing_year` is therefore a
// case-supplied fact (the case states the comparison directly), same
// pattern `us.irc.penalties::return_filed_by_january_31_following` already
// uses in `08-estimated-tax-underpayment-6654.law` for an identical
// fixed-calendar-date test.
relation corrected_on_or_before_august_1_of_filing_year(f: InformationReturnFailure) kind empirical {
    label en official "corrected ... on or before August 1 of the calendar year in which the required filing date occurs";
}
pub relation information_return_failure_corrected_by_august_1(f: InformationReturnFailure) kind institutional {
    label en official "corrected after the 30th day referred to in paragraph (1) but on or before August 1 of the calendar year in which the required filing date occurs";
}
@source(IRC_S6721_B, relation = formalizes, coverage = exact, quote = "corrected after the 30th day referred to in paragraph (1) but on or before August 1 of the calendar year in which the required filing date occurs")
rule InformationReturnCorrectedByAugust1 strict {
    for f: InformationReturnFailure;
    for payer: Person;
    for y: TaxableYear;
    for kind: us.irc.information_reporting::InformationReturnKind;
    for due: Date;
    for corrected: Date;
    when information_return_failure_of(f, payer, y, kind)
        and us.irc.information_reporting::information_return_due(payer, y, kind, due)
        and information_return_failure_corrected_on(f, corrected)
        and corrected > add_calendar_period(due, 30 calendar_day)
        and corrected_on_or_before_august_1_of_filing_year(f);
    then information_return_failure_corrected_by_august_1(f);
}

// --- per-failure amount and bucket membership -------------------------------

// --- per-failure amount and bucket membership -------------------------------

pub relation information_return_penalty_per_failure(f: InformationReturnFailure, amount: Money) kind institutional {
    label en official "such person shall pay a penalty of $250 for each return with respect to which such a failure occurs";
}
pub relation information_return_full_rate_bucket(f: InformationReturnFailure) kind institutional;
pub relation information_return_30day_bucket(f: InformationReturnFailure) kind institutional;
pub relation information_return_aug1_bucket(f: InformationReturnFailure) kind institutional;
pub relation information_return_disregard_bucket(f: InformationReturnFailure) kind institutional;

@source(IRC_S6721_E, relation = formalizes, coverage = exact, quote = "the penalty imposed under subsection (a) shall be $500, or, if greater")
rule InformationReturnPenaltyIntentionalDisregardAmount defeasible {
    for f: InformationReturnFailure;
    for payer: Person;
    for y: TaxableYear;
    for kind: us.irc.information_reporting::InformationReturnKind;
    for agg: Money;
    for fc: FailureContext;
    when information_return_failure_of(f, payer, y, kind)
        and information_return_failure_intentional_disregard(f)
        and information_return_failure_aggregate_amount_required(f, agg)
        and not_known(information_return_failure_within_safe_harbor(f))
        and not magnetic_media_failure_within_exception(f);
    then information_return_penalty_per_failure(f, max(round(InformationReturnIntentionalDisregardMinimum, 2, "HALF_UP"), round(agg * InformationReturnIntentionalDisregardRate, 2, "HALF_UP")));
    unless reasonable_cause_and_no_willful_neglect(payer, fc)
        and information_return_failure_of(f, payer, y, kind)
        and information_return_failure_intentional_disregard(f)
        and information_return_failure_aggregate_amount_required(f, agg)
        and not_known(information_return_failure_within_safe_harbor(f))
        and not magnetic_media_failure_within_exception(f);
}
@source(IRC_S6721_E, relation = formalizes, coverage = exact, quote = "due to intentional disregard of the filing requirement (or the correct information reporting requirement)")
rule InformationReturnPenaltyIntentionalDisregardBucket defeasible {
    for f: InformationReturnFailure;
    for payer: Person;
    for y: TaxableYear;
    for kind: us.irc.information_reporting::InformationReturnKind;
    for agg: Money;
    for fc: FailureContext;
    when information_return_failure_of(f, payer, y, kind)
        and information_return_failure_intentional_disregard(f)
        and information_return_failure_aggregate_amount_required(f, agg)
        and not_known(information_return_failure_within_safe_harbor(f))
        and not magnetic_media_failure_within_exception(f);
    then information_return_disregard_bucket(f);
    unless reasonable_cause_and_no_willful_neglect(payer, fc)
        and information_return_failure_of(f, payer, y, kind)
        and information_return_failure_intentional_disregard(f)
        and information_return_failure_aggregate_amount_required(f, agg)
        and not_known(information_return_failure_within_safe_harbor(f))
        and not magnetic_media_failure_within_exception(f);
}
@source(IRC_S6721_B, relation = formalizes, coverage = exact, quote = "the penalty imposed by subsection (a) shall be $50 in lieu of $250")
rule InformationReturnPenalty30DayAmount defeasible {
    for f: InformationReturnFailure;
    for payer: Person;
    for y: TaxableYear;
    for kind: us.irc.information_reporting::InformationReturnKind;
    for fc: FailureContext;
    when information_return_failure_of(f, payer, y, kind)
        and information_return_failure_corrected_within_30_days(f)
        and not information_return_failure_intentional_disregard(f)
        and not_known(information_return_failure_within_safe_harbor(f))
        and not magnetic_media_failure_within_exception(f);
    then information_return_penalty_per_failure(f, round(InformationReturn30DayCorrectionRate, 2, "HALF_UP"));
    unless reasonable_cause_and_no_willful_neglect(payer, fc)
        and information_return_failure_of(f, payer, y, kind)
        and information_return_failure_corrected_within_30_days(f)
        and not information_return_failure_intentional_disregard(f)
        and not_known(information_return_failure_within_safe_harbor(f))
        and not magnetic_media_failure_within_exception(f);
}
@source(IRC_S6721_B, relation = formalizes, coverage = exact, quote = "corrected on or before the day 30 days after the required filing date")
rule InformationReturnPenalty30DayBucket defeasible {
    for f: InformationReturnFailure;
    for payer: Person;
    for y: TaxableYear;
    for kind: us.irc.information_reporting::InformationReturnKind;
    for fc: FailureContext;
    when information_return_failure_of(f, payer, y, kind)
        and information_return_failure_corrected_within_30_days(f)
        and not information_return_failure_intentional_disregard(f)
        and not_known(information_return_failure_within_safe_harbor(f))
        and not magnetic_media_failure_within_exception(f);
    then information_return_30day_bucket(f);
    unless reasonable_cause_and_no_willful_neglect(payer, fc)
        and information_return_failure_of(f, payer, y, kind)
        and information_return_failure_corrected_within_30_days(f)
        and not information_return_failure_intentional_disregard(f)
        and not_known(information_return_failure_within_safe_harbor(f))
        and not magnetic_media_failure_within_exception(f);
}
@source(IRC_S6721_B, relation = formalizes, coverage = exact, quote = "the penalty imposed by subsection (a) shall be $100 in lieu of $250")
rule InformationReturnPenaltyAug1Amount defeasible {
    for f: InformationReturnFailure;
    for payer: Person;
    for y: TaxableYear;
    for kind: us.irc.information_reporting::InformationReturnKind;
    for fc: FailureContext;
    when information_return_failure_of(f, payer, y, kind)
        and information_return_failure_corrected_by_august_1(f)
        and not information_return_failure_intentional_disregard(f)
        and not_known(information_return_failure_within_safe_harbor(f))
        and not magnetic_media_failure_within_exception(f);
    then information_return_penalty_per_failure(f, round(InformationReturnAug1CorrectionRate, 2, "HALF_UP"));
    unless reasonable_cause_and_no_willful_neglect(payer, fc)
        and information_return_failure_of(f, payer, y, kind)
        and information_return_failure_corrected_by_august_1(f)
        and not information_return_failure_intentional_disregard(f)
        and not_known(information_return_failure_within_safe_harbor(f))
        and not magnetic_media_failure_within_exception(f);
}
@source(IRC_S6721_B, relation = formalizes, coverage = exact, quote = "corrected after the 30th day referred to in paragraph (1) but on or before August 1 of the calendar year in which the required filing date occurs")
rule InformationReturnPenaltyAug1Bucket defeasible {
    for f: InformationReturnFailure;
    for payer: Person;
    for y: TaxableYear;
    for kind: us.irc.information_reporting::InformationReturnKind;
    for fc: FailureContext;
    when information_return_failure_of(f, payer, y, kind)
        and information_return_failure_corrected_by_august_1(f)
        and not information_return_failure_intentional_disregard(f)
        and not_known(information_return_failure_within_safe_harbor(f))
        and not magnetic_media_failure_within_exception(f);
    then information_return_aug1_bucket(f);
    unless reasonable_cause_and_no_willful_neglect(payer, fc)
        and information_return_failure_of(f, payer, y, kind)
        and information_return_failure_corrected_by_august_1(f)
        and not information_return_failure_intentional_disregard(f)
        and not_known(information_return_failure_within_safe_harbor(f))
        and not magnetic_media_failure_within_exception(f);
}
@source(IRC_S6721_A, relation = formalizes, coverage = exact, quote = "such person shall pay a penalty of $250 for each return with respect to which such a failure occurs")
rule InformationReturnPenaltyFullRateAmount defeasible {
    for f: InformationReturnFailure;
    for payer: Person;
    for y: TaxableYear;
    for kind: us.irc.information_reporting::InformationReturnKind;
    for fc: FailureContext;
    when information_return_failure_of(f, payer, y, kind)
        and not_known(information_return_failure_corrected_within_30_days(f))
        and not_known(information_return_failure_corrected_by_august_1(f))
        and not information_return_failure_intentional_disregard(f)
        and not_known(information_return_failure_within_safe_harbor(f))
        and not magnetic_media_failure_within_exception(f);
    then information_return_penalty_per_failure(f, round(InformationReturnBaseRate, 2, "HALF_UP"));
    unless reasonable_cause_and_no_willful_neglect(payer, fc)
        and information_return_failure_of(f, payer, y, kind)
        and not_known(information_return_failure_corrected_within_30_days(f))
        and not_known(information_return_failure_corrected_by_august_1(f))
        and not information_return_failure_intentional_disregard(f)
        and not_known(information_return_failure_within_safe_harbor(f))
        and not magnetic_media_failure_within_exception(f);
}
@source(IRC_S6721_A, relation = formalizes, coverage = partial, quote = "any failure to file an information return with the Secretary on or before the required filing date")
rule InformationReturnPenaltyFullRateBucket defeasible {
    for f: InformationReturnFailure;
    for payer: Person;
    for y: TaxableYear;
    for kind: us.irc.information_reporting::InformationReturnKind;
    for fc: FailureContext;
    when information_return_failure_of(f, payer, y, kind)
        and not_known(information_return_failure_corrected_within_30_days(f))
        and not_known(information_return_failure_corrected_by_august_1(f))
        and not information_return_failure_intentional_disregard(f)
        and not_known(information_return_failure_within_safe_harbor(f))
        and not magnetic_media_failure_within_exception(f);
    then information_return_full_rate_bucket(f);
    unless reasonable_cause_and_no_willful_neglect(payer, fc)
        and information_return_failure_of(f, payer, y, kind)
        and not_known(information_return_failure_corrected_within_30_days(f))
        and not_known(information_return_failure_corrected_by_august_1(f))
        and not information_return_failure_intentional_disregard(f)
        and not_known(information_return_failure_within_safe_harbor(f))
        and not magnetic_media_failure_within_exception(f);
}

pub relation information_return_full_rate_cap(payer: Person, y: TaxableYear, cap: Money) kind institutional;
@source(IRC_S6721_A, relation = formalizes, coverage = exact, quote = "the total amount imposed on such person for all such failures during any calendar year shall not exceed $3,000,000")
rule InformationReturnFullRateCapSmallFiler strict {
    for payer: Person;
    for y: TaxableYear;
    when meets_gross_receipts_test_6721d(payer, y);
    then information_return_full_rate_cap(payer, y, round(InformationReturnLowerAnnualCapFullRate, 2, "HALF_UP"));
}
@source(IRC_S6721_A, relation = formalizes, coverage = exact, quote = "the total amount imposed on such person for all such failures during any calendar year shall not exceed $3,000,000")
rule InformationReturnFullRateCapOrdinary strict {
    for payer: Person;
    for y: TaxableYear;
    for f: InformationReturnFailure;
    for kind: us.irc.information_reporting::InformationReturnKind;
    when information_return_failure_of(f, payer, y, kind)
        and not_known(meets_gross_receipts_test_6721d(payer, y));
    then information_return_full_rate_cap(payer, y, round(InformationReturnAnnualCapFullRate, 2, "HALF_UP"));
}
pub relation information_return_30day_cap(payer: Person, y: TaxableYear, cap: Money) kind institutional;
@source(IRC_S6721_B, relation = formalizes, coverage = exact, quote = "the total amount imposed on the person for all such failures during any calendar year which are so corrected shall not exceed $500,000")
rule Information30DayCapSmallFiler strict {
    for payer: Person;
    for y: TaxableYear;
    when meets_gross_receipts_test_6721d(payer, y);
    then information_return_30day_cap(payer, y, round(InformationReturnLowerAnnualCap30Day, 2, "HALF_UP"));
}
@source(IRC_S6721_B, relation = formalizes, coverage = exact, quote = "the total amount imposed on the person for all such failures during any calendar year which are so corrected shall not exceed $500,000")
rule Information30DayCapOrdinary strict {
    for payer: Person;
    for y: TaxableYear;
    for f: InformationReturnFailure;
    for kind: us.irc.information_reporting::InformationReturnKind;
    when information_return_failure_of(f, payer, y, kind)
        and not_known(meets_gross_receipts_test_6721d(payer, y));
    then information_return_30day_cap(payer, y, round(InformationReturnAnnualCap30Day, 2, "HALF_UP"));
}
pub relation information_return_aug1_cap(payer: Person, y: TaxableYear, cap: Money) kind institutional;
@source(IRC_S6721_B, relation = formalizes, coverage = exact, quote = "the total amount imposed on the person for all such failures during the calendar year which are so corrected shall not exceed $1,500,000")
rule InformationAug1CapSmallFiler strict {
    for payer: Person;
    for y: TaxableYear;
    when meets_gross_receipts_test_6721d(payer, y);
    then information_return_aug1_cap(payer, y, round(InformationReturnLowerAnnualCapAug1, 2, "HALF_UP"));
}
@source(IRC_S6721_B, relation = formalizes, coverage = exact, quote = "the total amount imposed on the person for all such failures during the calendar year which are so corrected shall not exceed $1,500,000")
rule InformationAug1CapOrdinary strict {
    for payer: Person;
    for y: TaxableYear;
    for f: InformationReturnFailure;
    for kind: us.irc.information_reporting::InformationReturnKind;
    when information_return_failure_of(f, payer, y, kind)
        and not_known(meets_gross_receipts_test_6721d(payer, y));
    then information_return_aug1_cap(payer, y, round(InformationReturnAnnualCapAug1, 2, "HALF_UP"));
}

pub relation information_return_penalty_6721(payer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 6721: the person's total annual information-return penalty for the calendar year, after the per-bucket caps of subsections (a), (b) and (d) and the (e)(3) exclusion of intentional-disregard penalties from those caps";
}
@source(IRC_S6721_A, relation = formalizes, coverage = partial, quote = "the total amount imposed on such person for all such failures during any calendar year shall not exceed $3,000,000")
rule Section6721AnnualTotal defeasible {
    for payer: Person;
    for y: TaxableYear;
    for fullCap: Money;
    for cap30: Money;
    for capAug1: Money;
    when information_return_full_rate_cap(payer, y, fullCap)
        and information_return_30day_cap(payer, y, cap30)
        and information_return_aug1_cap(payer, y, capAug1);
    then information_return_penalty_6721(payer, y,
        min(fullCap, sum all amt: Money for f: InformationReturnFailure, k: us.irc.information_reporting::InformationReturnKind where information_return_full_rate_bucket(f) and information_return_failure_of(f, payer, y, k) and information_return_penalty_per_failure(f, amt))
        + min(cap30, sum all amt: Money for f: InformationReturnFailure, k: us.irc.information_reporting::InformationReturnKind where information_return_30day_bucket(f) and information_return_failure_of(f, payer, y, k) and information_return_penalty_per_failure(f, amt))
        + min(capAug1, sum all amt: Money for f: InformationReturnFailure, k: us.irc.information_reporting::InformationReturnKind where information_return_aug1_bucket(f) and information_return_failure_of(f, payer, y, k) and information_return_penalty_per_failure(f, amt))
        + (sum all amt: Money for f: InformationReturnFailure, k: us.irc.information_reporting::InformationReturnKind where information_return_disregard_bucket(f) and information_return_failure_of(f, payer, y, k) and information_return_penalty_per_failure(f, amt)));
}
pub entity PayeeStatementFailure {
    label en unofficial "one occurrence of a section 6722(a)(2) failure (late furnishing, or incorrect/incomplete information) with respect to one payee statement";
}
relation payee_statement_failure_of(f: PayeeStatementFailure, payer: Person, y: TaxableYear, kind: us.irc.information_reporting::InformationReturnKind) kind empirical {
    label en unofficial "the failure occurred with respect to this payer's payee statement of this kind for this year";
}
relation payee_statement_failure_defect(f: PayeeStatementFailure, defect: InformationFailureDefectKind) kind empirical {
    label en unofficial "whether the failure is (A) late furnishing or (B) incorrect/missing information";
}
relation payee_statement_failure_corrected_on(f: PayeeStatementFailure, d: Date) kind empirical {
    label en unofficial "the date, if any, on which the failure was corrected";
}
relation payee_statement_failure_intentional_disregard(f: PayeeStatementFailure) kind empirical {
    label en official "due to intentional disregard of the requirement to furnish a payee statement (or the correct information reporting requirement)";
}
relation payee_statement_failure_aggregate_amount_required(f: PayeeStatementFailure, amount: Money) kind empirical {
    label en unofficial "the aggregate amount of the items required to be reported correctly (needed only for the (e)(2)(A) percentage test)";
}
relation payee_statement_failure_error_amount(f: PayeeStatementFailure, amount: Money) kind empirical {
    label en unofficial "the (c)(3) safe-harbor test: the single dollar amount by which the reported figure differs from the correct amount";
}
relation payee_statement_failure_withholding_error_amount(f: PayeeStatementFailure, amount: Money) kind empirical {
    label en unofficial "the (c)(3) safe-harbor test: the single dollar amount by which a reported tax-withheld figure differs from the correct amount";
}
// (meets_gross_receipts_test_6721d reused from the section 6721 module above — section 6722(d)(2) cross-references "the gross receipts test of section 6721(d)(2)" directly, so this package shares one relation rather than declaring a shadow copy)

// --- (c)(3): dollar safe harbor removes the failure entirely ---------------

pub relation payee_statement_failure_within_safe_harbor(f: PayeeStatementFailure) kind institutional {
    label en official "no single amount in error differs from the correct amount by more than $100 ... no single amount reported for tax withheld ... differs from the correct amount by more than $25 ... such statement shall be treated as having been furnished with all of the correct required information";
}
@source(IRC_S6722_C, relation = formalizes, coverage = exact, quote = "no single amount in error differs from the correct amount by more than $100")
rule PayeeStatementSafeHarbor strict {
    for f: PayeeStatementFailure;
    for err: Money;
    for werr: Money;
    when payee_statement_failure_error_amount(f, err)
        and payee_statement_failure_withholding_error_amount(f, werr)
        and err <= round(InformationReturnSafeHarborErrorThreshold, 2, "HALF_UP")
        and werr <= round(InformationReturnSafeHarborWithholdingErrorThreshold, 2, "HALF_UP");
    then payee_statement_failure_within_safe_harbor(f);
}

// --- correction-window classification ---------------------------------------

pub relation payee_statement_failure_corrected_within_30_days(f: PayeeStatementFailure) kind institutional {
    label en official "corrected on or before the day 30 days after the date prescribed for furnishing such statement";
}
@source(IRC_S6722_B, relation = formalizes, coverage = exact, quote = "corrected on or before the day 30 days after the date prescribed for furnishing such statement")
rule PayeeStatementCorrectedWithin30Days strict {
    for f: PayeeStatementFailure;
    for payer: Person;
    for y: TaxableYear;
    for kind: us.irc.information_reporting::InformationReturnKind;
    for due: Date;
    for corrected: Date;
    when payee_statement_failure_of(f, payer, y, kind)
        and us.irc.information_reporting::payee_statement_due(payer, y, kind, due)
        and payee_statement_failure_corrected_on(f, corrected)
        and corrected <= add_calendar_period(due, 30 calendar_day);
    then payee_statement_failure_corrected_within_30_days(f);
}
// TECH_GAP (TECH-GAPS G497): the grammar has no "Nth day of the calendar
// year containing this Date" builtin (only `add_calendar_period` stepping
// FROM a date, not constructing "August 1 of year Y" from a TaxableYear
// alone) — `payee_statement_corrected_on_or_before_august_1_of_filing_year` is therefore a
// case-supplied fact (the case states the comparison directly), same
// pattern `us.irc.penalties::return_filed_by_january_31_following` already
// uses in `08-estimated-tax-underpayment-6654.law` for an identical
// fixed-calendar-date test.
relation payee_statement_corrected_on_or_before_august_1_of_filing_year(f: PayeeStatementFailure) kind empirical {
    label en official "corrected ... on or before August 1 of the calendar year in which the date prescribed for furnishing such statement occurs";
}
pub relation payee_statement_failure_corrected_by_august_1(f: PayeeStatementFailure) kind institutional {
    label en official "corrected after the 30th day referred to in paragraph (1) but on or before August 1 of the calendar year in which the date prescribed for furnishing such statement occurs";
}
@source(IRC_S6722_B, relation = formalizes, coverage = exact, quote = "corrected after the 30th day referred to in paragraph (1) but on or before August 1 of the calendar year in which the date prescribed for furnishing such statement occurs")
rule PayeeStatementCorrectedByAugust1 strict {
    for f: PayeeStatementFailure;
    for payer: Person;
    for y: TaxableYear;
    for kind: us.irc.information_reporting::InformationReturnKind;
    for due: Date;
    for corrected: Date;
    when payee_statement_failure_of(f, payer, y, kind)
        and us.irc.information_reporting::payee_statement_due(payer, y, kind, due)
        and payee_statement_failure_corrected_on(f, corrected)
        and corrected > add_calendar_period(due, 30 calendar_day)
        and payee_statement_corrected_on_or_before_august_1_of_filing_year(f);
    then payee_statement_failure_corrected_by_august_1(f);
}

// --- per-failure amount and bucket membership -------------------------------

// --- per-failure amount and bucket membership -------------------------------

pub relation payee_statement_penalty_per_failure(f: PayeeStatementFailure, amount: Money) kind institutional {
    label en official "such person shall pay a penalty of $250 for each statement with respect to which such a failure occurs";
}
pub relation payee_statement_full_rate_bucket(f: PayeeStatementFailure) kind institutional;
pub relation payee_statement_30day_bucket(f: PayeeStatementFailure) kind institutional;
pub relation payee_statement_aug1_bucket(f: PayeeStatementFailure) kind institutional;
pub relation payee_statement_disregard_bucket(f: PayeeStatementFailure) kind institutional;

@source(IRC_S6722_E, relation = formalizes, coverage = exact, quote = "the penalty imposed under subsection (a)(1) shall be $500, or, if greater")
rule PayeeStatementPenaltyIntentionalDisregardAmount defeasible {
    for f: PayeeStatementFailure;
    for payer: Person;
    for y: TaxableYear;
    for kind: us.irc.information_reporting::InformationReturnKind;
    for agg: Money;
    for fc: FailureContext;
    when payee_statement_failure_of(f, payer, y, kind)
        and payee_statement_failure_intentional_disregard(f)
        and payee_statement_failure_aggregate_amount_required(f, agg)
        and not_known(payee_statement_failure_within_safe_harbor(f));
    then payee_statement_penalty_per_failure(f, max(round(InformationReturnIntentionalDisregardMinimum, 2, "HALF_UP"), round(agg * InformationReturnIntentionalDisregardRate, 2, "HALF_UP")));
    unless reasonable_cause_and_no_willful_neglect(payer, fc)
        and payee_statement_failure_of(f, payer, y, kind)
        and payee_statement_failure_intentional_disregard(f)
        and payee_statement_failure_aggregate_amount_required(f, agg)
        and not_known(payee_statement_failure_within_safe_harbor(f));
}
@source(IRC_S6722_E, relation = formalizes, coverage = exact, quote = "due to intentional disregard of the requirement to furnish a payee statement (or the correct information reporting requirement)")
rule PayeeStatementPenaltyIntentionalDisregardBucket defeasible {
    for f: PayeeStatementFailure;
    for payer: Person;
    for y: TaxableYear;
    for kind: us.irc.information_reporting::InformationReturnKind;
    for agg: Money;
    for fc: FailureContext;
    when payee_statement_failure_of(f, payer, y, kind)
        and payee_statement_failure_intentional_disregard(f)
        and payee_statement_failure_aggregate_amount_required(f, agg)
        and not_known(payee_statement_failure_within_safe_harbor(f));
    then payee_statement_disregard_bucket(f);
    unless reasonable_cause_and_no_willful_neglect(payer, fc)
        and payee_statement_failure_of(f, payer, y, kind)
        and payee_statement_failure_intentional_disregard(f)
        and payee_statement_failure_aggregate_amount_required(f, agg)
        and not_known(payee_statement_failure_within_safe_harbor(f));
}
@source(IRC_S6722_B, relation = formalizes, coverage = exact, quote = "the penalty imposed by subsection (a) shall be $50 in lieu of $250")
rule PayeeStatementPenalty30DayAmount defeasible {
    for f: PayeeStatementFailure;
    for payer: Person;
    for y: TaxableYear;
    for kind: us.irc.information_reporting::InformationReturnKind;
    for fc: FailureContext;
    when payee_statement_failure_of(f, payer, y, kind)
        and payee_statement_failure_corrected_within_30_days(f)
        and not payee_statement_failure_intentional_disregard(f)
        and not_known(payee_statement_failure_within_safe_harbor(f));
    then payee_statement_penalty_per_failure(f, round(InformationReturn30DayCorrectionRate, 2, "HALF_UP"));
    unless reasonable_cause_and_no_willful_neglect(payer, fc)
        and payee_statement_failure_of(f, payer, y, kind)
        and payee_statement_failure_corrected_within_30_days(f)
        and not payee_statement_failure_intentional_disregard(f)
        and not_known(payee_statement_failure_within_safe_harbor(f));
}
@source(IRC_S6722_B, relation = formalizes, coverage = exact, quote = "corrected on or before the day 30 days after the date prescribed for furnishing such statement")
rule PayeeStatementPenalty30DayBucket defeasible {
    for f: PayeeStatementFailure;
    for payer: Person;
    for y: TaxableYear;
    for kind: us.irc.information_reporting::InformationReturnKind;
    for fc: FailureContext;
    when payee_statement_failure_of(f, payer, y, kind)
        and payee_statement_failure_corrected_within_30_days(f)
        and not payee_statement_failure_intentional_disregard(f)
        and not_known(payee_statement_failure_within_safe_harbor(f));
    then payee_statement_30day_bucket(f);
    unless reasonable_cause_and_no_willful_neglect(payer, fc)
        and payee_statement_failure_of(f, payer, y, kind)
        and payee_statement_failure_corrected_within_30_days(f)
        and not payee_statement_failure_intentional_disregard(f)
        and not_known(payee_statement_failure_within_safe_harbor(f));
}
@source(IRC_S6722_B, relation = formalizes, coverage = exact, quote = "the penalty imposed by subsection (a) shall be $100 in lieu of $250")
rule PayeeStatementPenaltyAug1Amount defeasible {
    for f: PayeeStatementFailure;
    for payer: Person;
    for y: TaxableYear;
    for kind: us.irc.information_reporting::InformationReturnKind;
    for fc: FailureContext;
    when payee_statement_failure_of(f, payer, y, kind)
        and payee_statement_failure_corrected_by_august_1(f)
        and not payee_statement_failure_intentional_disregard(f)
        and not_known(payee_statement_failure_within_safe_harbor(f));
    then payee_statement_penalty_per_failure(f, round(InformationReturnAug1CorrectionRate, 2, "HALF_UP"));
    unless reasonable_cause_and_no_willful_neglect(payer, fc)
        and payee_statement_failure_of(f, payer, y, kind)
        and payee_statement_failure_corrected_by_august_1(f)
        and not payee_statement_failure_intentional_disregard(f)
        and not_known(payee_statement_failure_within_safe_harbor(f));
}
@source(IRC_S6722_B, relation = formalizes, coverage = exact, quote = "corrected after the 30th day referred to in paragraph (1) but on or before August 1 of the calendar year in which the date prescribed for furnishing such statement occurs")
rule PayeeStatementPenaltyAug1Bucket defeasible {
    for f: PayeeStatementFailure;
    for payer: Person;
    for y: TaxableYear;
    for kind: us.irc.information_reporting::InformationReturnKind;
    for fc: FailureContext;
    when payee_statement_failure_of(f, payer, y, kind)
        and payee_statement_failure_corrected_by_august_1(f)
        and not payee_statement_failure_intentional_disregard(f)
        and not_known(payee_statement_failure_within_safe_harbor(f));
    then payee_statement_aug1_bucket(f);
    unless reasonable_cause_and_no_willful_neglect(payer, fc)
        and payee_statement_failure_of(f, payer, y, kind)
        and payee_statement_failure_corrected_by_august_1(f)
        and not payee_statement_failure_intentional_disregard(f)
        and not_known(payee_statement_failure_within_safe_harbor(f));
}
@source(IRC_S6722_A, relation = formalizes, coverage = exact, quote = "such person shall pay a penalty of $250 for each statement with respect to which such a failure occurs")
rule PayeeStatementPenaltyFullRateAmount defeasible {
    for f: PayeeStatementFailure;
    for payer: Person;
    for y: TaxableYear;
    for kind: us.irc.information_reporting::InformationReturnKind;
    for fc: FailureContext;
    when payee_statement_failure_of(f, payer, y, kind)
        and not_known(payee_statement_failure_corrected_within_30_days(f))
        and not_known(payee_statement_failure_corrected_by_august_1(f))
        and not payee_statement_failure_intentional_disregard(f)
        and not_known(payee_statement_failure_within_safe_harbor(f));
    then payee_statement_penalty_per_failure(f, round(InformationReturnBaseRate, 2, "HALF_UP"));
    unless reasonable_cause_and_no_willful_neglect(payer, fc)
        and payee_statement_failure_of(f, payer, y, kind)
        and not_known(payee_statement_failure_corrected_within_30_days(f))
        and not_known(payee_statement_failure_corrected_by_august_1(f))
        and not payee_statement_failure_intentional_disregard(f)
        and not_known(payee_statement_failure_within_safe_harbor(f));
}
@source(IRC_S6722_A, relation = formalizes, coverage = partial, quote = "any failure to furnish a payee statement on or before the date prescribed therefor to the person to whom such statement is required to be furnished")
rule PayeeStatementPenaltyFullRateBucket defeasible {
    for f: PayeeStatementFailure;
    for payer: Person;
    for y: TaxableYear;
    for kind: us.irc.information_reporting::InformationReturnKind;
    for fc: FailureContext;
    when payee_statement_failure_of(f, payer, y, kind)
        and not_known(payee_statement_failure_corrected_within_30_days(f))
        and not_known(payee_statement_failure_corrected_by_august_1(f))
        and not payee_statement_failure_intentional_disregard(f)
        and not_known(payee_statement_failure_within_safe_harbor(f));
    then payee_statement_full_rate_bucket(f);
    unless reasonable_cause_and_no_willful_neglect(payer, fc)
        and payee_statement_failure_of(f, payer, y, kind)
        and not_known(payee_statement_failure_corrected_within_30_days(f))
        and not_known(payee_statement_failure_corrected_by_august_1(f))
        and not payee_statement_failure_intentional_disregard(f)
        and not_known(payee_statement_failure_within_safe_harbor(f));
}

pub relation payee_statement_full_rate_cap(payer: Person, y: TaxableYear, cap: Money) kind institutional;
@source(IRC_S6722_A, relation = formalizes, coverage = exact, quote = "the total amount imposed on such person for all such failures during any calendar year shall not exceed $3,000,000")
rule PayeeStatementFullRateCapSmallFiler strict {
    for payer: Person;
    for y: TaxableYear;
    when meets_gross_receipts_test_6721d(payer, y);
    then payee_statement_full_rate_cap(payer, y, round(InformationReturnLowerAnnualCapFullRate, 2, "HALF_UP"));
}
@source(IRC_S6722_A, relation = formalizes, coverage = exact, quote = "the total amount imposed on such person for all such failures during any calendar year shall not exceed $3,000,000")
rule PayeeStatementFullRateCapOrdinary strict {
    for payer: Person;
    for y: TaxableYear;
    for f: PayeeStatementFailure;
    for kind: us.irc.information_reporting::InformationReturnKind;
    when payee_statement_failure_of(f, payer, y, kind)
        and not_known(meets_gross_receipts_test_6721d(payer, y));
    then payee_statement_full_rate_cap(payer, y, round(InformationReturnAnnualCapFullRate, 2, "HALF_UP"));
}
pub relation payee_statement_30day_cap(payer: Person, y: TaxableYear, cap: Money) kind institutional;
@source(IRC_S6722_B, relation = formalizes, coverage = exact, quote = "the total amount imposed on the person for all such failures during any calendar year which are so corrected shall not exceed $500,000")
rule PayeeStatement30DayCapSmallFiler strict {
    for payer: Person;
    for y: TaxableYear;
    when meets_gross_receipts_test_6721d(payer, y);
    then payee_statement_30day_cap(payer, y, round(InformationReturnLowerAnnualCap30Day, 2, "HALF_UP"));
}
@source(IRC_S6722_B, relation = formalizes, coverage = exact, quote = "the total amount imposed on the person for all such failures during any calendar year which are so corrected shall not exceed $500,000")
rule PayeeStatement30DayCapOrdinary strict {
    for payer: Person;
    for y: TaxableYear;
    for f: PayeeStatementFailure;
    for kind: us.irc.information_reporting::InformationReturnKind;
    when payee_statement_failure_of(f, payer, y, kind)
        and not_known(meets_gross_receipts_test_6721d(payer, y));
    then payee_statement_30day_cap(payer, y, round(InformationReturnAnnualCap30Day, 2, "HALF_UP"));
}
pub relation payee_statement_aug1_cap(payer: Person, y: TaxableYear, cap: Money) kind institutional;
@source(IRC_S6722_B, relation = formalizes, coverage = exact, quote = "the total amount imposed on the person for all such failures during the calendar year which are so corrected shall not exceed $1,500,000")
rule PayeeStatementAug1CapSmallFiler strict {
    for payer: Person;
    for y: TaxableYear;
    when meets_gross_receipts_test_6721d(payer, y);
    then payee_statement_aug1_cap(payer, y, round(InformationReturnLowerAnnualCapAug1, 2, "HALF_UP"));
}
@source(IRC_S6722_B, relation = formalizes, coverage = exact, quote = "the total amount imposed on the person for all such failures during the calendar year which are so corrected shall not exceed $1,500,000")
rule PayeeStatementAug1CapOrdinary strict {
    for payer: Person;
    for y: TaxableYear;
    for f: PayeeStatementFailure;
    for kind: us.irc.information_reporting::InformationReturnKind;
    when payee_statement_failure_of(f, payer, y, kind)
        and not_known(meets_gross_receipts_test_6721d(payer, y));
    then payee_statement_aug1_cap(payer, y, round(InformationReturnAnnualCapAug1, 2, "HALF_UP"));
}

pub relation payee_statement_penalty_6722(payer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 6722: the person's total annual payee-statement penalty for the calendar year, after the per-bucket caps of subsections (a), (b) and (d) and the (e)(3) exclusion of intentional-disregard penalties from those caps";
}
@source(IRC_S6722_A, relation = formalizes, coverage = partial, quote = "the total amount imposed on such person for all such failures during any calendar year shall not exceed $3,000,000")
rule Section6722AnnualTotal defeasible {
    for payer: Person;
    for y: TaxableYear;
    for fullCap: Money;
    for cap30: Money;
    for capAug1: Money;
    when payee_statement_full_rate_cap(payer, y, fullCap)
        and payee_statement_30day_cap(payer, y, cap30)
        and payee_statement_aug1_cap(payer, y, capAug1);
    then payee_statement_penalty_6722(payer, y,
        min(fullCap, sum all amt: Money for f: PayeeStatementFailure, k: us.irc.information_reporting::InformationReturnKind where payee_statement_full_rate_bucket(f) and payee_statement_failure_of(f, payer, y, k) and payee_statement_penalty_per_failure(f, amt))
        + min(cap30, sum all amt: Money for f: PayeeStatementFailure, k: us.irc.information_reporting::InformationReturnKind where payee_statement_30day_bucket(f) and payee_statement_failure_of(f, payer, y, k) and payee_statement_penalty_per_failure(f, amt))
        + min(capAug1, sum all amt: Money for f: PayeeStatementFailure, k: us.irc.information_reporting::InformationReturnKind where payee_statement_aug1_bucket(f) and payee_statement_failure_of(f, payer, y, k) and payee_statement_penalty_per_failure(f, amt))
        + (sum all amt: Money for f: PayeeStatementFailure, k: us.irc.information_reporting::InformationReturnKind where payee_statement_disregard_bucket(f) and payee_statement_failure_of(f, payer, y, k) and payee_statement_penalty_per_failure(f, amt)));
}

// =============================================================================
// §6723 — Failure to comply with other information reporting requirements
// =============================================================================

pub entity SpecifiedInformationReportingRequirementFailure {
    label en unofficial "one occurrence of a failure to comply with a specified information reporting requirement (section 6724(d)(3): TIN-furnishing/inclusion requirements under section 6109, or the section 6050K(c)(1) transferor notice)";
}
relation specified_information_reporting_requirement_failure_of(f: SpecifiedInformationReportingRequirementFailure, p: Person, y: TaxableYear) kind empirical {
    label en unofficial "case fact (owner: the cross-referenced sections 6109/6050K(c)(1), outside this package): the person failed to comply with a specified information reporting requirement, on or before the time prescribed, in this year";
}
pub relation specified_information_reporting_requirement_penalty_per_failure(f: SpecifiedInformationReportingRequirementFailure, amount: Money) kind institutional {
    label en official "such person shall pay a penalty of $50 for each such failure";
}
@source(IRC_S6723, relation = formalizes, coverage = exact, quote = "such person shall pay a penalty of $50 for each such failure")
rule Section6723PenaltyPerFailure defeasible {
    for f: SpecifiedInformationReportingRequirementFailure;
    for p: Person;
    for y: TaxableYear;
    for fc: FailureContext;
    when specified_information_reporting_requirement_failure_of(f, p, y);
    then specified_information_reporting_requirement_penalty_per_failure(f, round(SpecifiedInformationReportingRequirementRate, 2, "HALF_UP"));
    unless reasonable_cause_and_no_willful_neglect(p, fc)
        and specified_information_reporting_requirement_failure_of(f, p, y);
}
pub relation specified_information_reporting_requirement_penalty_6723(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the total amount imposed on such person for all such failures during any calendar year shall not exceed $100,000";
}
@source(IRC_S6723, relation = formalizes, coverage = exact, quote = "the total amount imposed on such person for all such failures during any calendar year shall not exceed $100,000")
rule Section6723AnnualTotal defeasible {
    for p: Person;
    for y: TaxableYear;
    for f0: SpecifiedInformationReportingRequirementFailure;
    when specified_information_reporting_requirement_failure_of(f0, p, y);
    then specified_information_reporting_requirement_penalty_6723(p, y,
        min(round(SpecifiedInformationReportingRequirementCap, 2, "HALF_UP"),
            sum all amt: Money for f: SpecifiedInformationReportingRequirementFailure where specified_information_reporting_requirement_failure_of(f, p, y) and specified_information_reporting_requirement_penalty_per_failure(f, amt)));
}

// =============================================================================
// §6724 — Waiver; definitions and special rules
// =============================================================================
// (a): the shared reasonable-cause waiver is `01-shared.law`'s
// `reasonable_cause_and_no_willful_neglect`, already wired into every
// per-failure rule of §§6721-6723 above via `unless`.
//
// (b): payment mechanics ("paid on notice and demand ... in the same manner
// as tax") — NON_NORMATIVE, no independent computable rule.
//
// (c): magnetic-media special rule — modelled as the case-asserted guard
// `magnetic_media_failure_within_exception` already wired into every §6721
// per-failure rule above (TECH_GAP: deriving the section 6011(e)(5)
// applicable-number schedule itself is not attempted).
//
// (d)(1)/(2): "information return"/"payee statement" definitions — satisfied
// by reuse of `us.irc.information_reporting::InformationReturnKind` and its
// `information_return_required`/`payee_statement_required` relations (see
// module header for the scope gap against the ~30 cross-references the
// statutory text itself enumerates).
//
// (d)(4): "required filing date" — satisfied by reuse of
// `us.irc.information_reporting::information_return_due`/`payee_statement_due`.
//
// (d)(3), (e), (f), (g) are covered below / flagged as TECH_GAP.

// (declared once above already for §6721 — `magnetic_media_failure_within_exception`.)

// (e): partnership schedules on magnetic media treated as separate returns —
// NOT modelled (scope extension of the counting rule this package does not
// need for its current failure-instance modelling) — TECH_GAP G496.

// (f): educational-institution TIN-certification exception, and (g) the
// rollover-certification reliance exception — NOT modelled — TECH_GAP G496.

// =============================================================================
// §6725 — Failure to report information under section 4101
// =============================================================================

pub entity Section4101ReportFailure {
    label en unofficial "one occurrence of a failure with respect to a vessel or facility described in section 6725(b)";
}
relation section_4101_report_failure_of(f: Section4101ReportFailure, p: Person) kind empirical {
    label en unofficial "the person who failed to make (or made incorrectly) the section 4101(d) report";
}
relation section_4101_report_late(f: Section4101ReportFailure) kind empirical {
    label en official "any failure to make a report under section 4101(d) on or before the date prescribed therefor";
}
relation section_4101_report_incorrect(f: Section4101ReportFailure) kind empirical {
    label en official "any failure to include all of the information required to be shown on such report or the inclusion of incorrect information";
}
pub external judgment relation reasonable_cause_for_report_failure(p: Person, fc: FailureContext) {
    authority Secretary;
    label en official "it is shown that such failure is due to reasonable cause";
}
pub relation section_4101_report_failure_penalty(f: Section4101ReportFailure, amount: Money) kind institutional {
    label en official "such person shall pay a penalty of $10,000 in addition to the tax (if any)";
}
@source(IRC_S6725_A, relation = formalizes, coverage = exact, quote = "such person shall pay a penalty of $10,000 in addition to the tax (if any)")
rule Section6725PenaltyLate defeasible {
    for f: Section4101ReportFailure;
    for p: Person;
    for fc: FailureContext;
    when section_4101_report_failure_of(f, p)
        and section_4101_report_late(f);
    then section_4101_report_failure_penalty(f, round(Section4101ReportFailurePenalty, 2, "HALF_UP"));
    unless reasonable_cause_for_report_failure(p, fc)
        and section_4101_report_failure_of(f, p)
        and section_4101_report_late(f);
}
@source(IRC_S6725_A, relation = formalizes, coverage = exact, quote = "such person shall pay a penalty of $10,000 in addition to the tax (if any)")
rule Section6725PenaltyIncorrect defeasible {
    for f: Section4101ReportFailure;
    for p: Person;
    for fc: FailureContext;
    when section_4101_report_failure_of(f, p)
        and section_4101_report_incorrect(f);
    then section_4101_report_failure_penalty(f, round(Section4101ReportFailurePenalty, 2, "HALF_UP"));
    unless reasonable_cause_for_report_failure(p, fc)
        and section_4101_report_failure_of(f, p)
        and section_4101_report_incorrect(f);
}
