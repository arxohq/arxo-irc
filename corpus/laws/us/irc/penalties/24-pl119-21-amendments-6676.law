language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

use self::{
    Claim,
    Person,
    TaxKind,
    TaxableYear,
    erroneous_refund_claim_penalty,
    excessive_amount_attributable_to_economic_substance_transaction,
    excessive_amount_subject_to_part_ii_penalty,
    reasonable_cause_for_excessive_claim,
    refund_claim_excessive_amount,
};

// Pub. L. 119-21 sec. 70605(f) — section 6676(a) reaches employment tax claims
// (IRC-16 stage 2, DECISION-0379).
//
// The pinned 2024 text of section 6676(a) reads "income tax"; module 09 models it
// for `IncomeCh1` claims. Sec. 70605(f) strikes "income tax" and inserts "income or
// employment tax". No effective-date clause is specific to subsection (f) (sec.
// 70605(g)(1) speaks of aid, assistance and advice), so the rule is windowed from
// the enactment date, 2025-07-04, on legal_time (TECH-GAPS G3102: the statute does
// not fix which date of the claim governs).
//
// Pub. L. 119-21 sec. 70525(b)(3) extends section 6675 to claims under section 6435
// (eligible indelibly dyed fuel) for fuel removed 180 days after enactment; module 09's
// `fuel_credit_claim_amount` is section-agnostic, so no rule changes; the 180-day
// applicability boundary is TECH-GAPS G3109 (not enforced).

relation employment_tax_kind_for_6676(kind: TaxKind) kind institutional {
    label en unofficial "the tax kind is an employment tax (subtitle C: chapters 21, 22, 23, 23A, 24) reached by section 6676(a) as amended";
}
@source(us.irc.temporal::PL119_21_S70605, relation = formalizes, coverage = partial, quote = "income or employment tax")
assert "emp-kind-FicaCh21": employment_tax_kind_for_6676(us.irc.core::FicaCh21);
@source(us.irc.temporal::PL119_21_S70605, relation = formalizes, coverage = partial, quote = "income or employment tax")
assert "emp-kind-RrtaCh22": employment_tax_kind_for_6676(us.irc.core::RrtaCh22);
@source(us.irc.temporal::PL119_21_S70605, relation = formalizes, coverage = partial, quote = "income or employment tax")
assert "emp-kind-FutaCh23": employment_tax_kind_for_6676(us.irc.core::FutaCh23);
@source(us.irc.temporal::PL119_21_S70605, relation = formalizes, coverage = partial, quote = "income or employment tax")
assert "emp-kind-RailroadUnemploymentRepaymentCh23A": employment_tax_kind_for_6676(us.irc.core::RailroadUnemploymentRepaymentCh23A);
@source(us.irc.temporal::PL119_21_S70605, relation = formalizes, coverage = partial, quote = "income or employment tax")
assert "emp-kind-WithholdingWagesCh24": employment_tax_kind_for_6676(us.irc.core::WithholdingWagesCh24);
@source(us.irc.temporal::PL119_21_S70605, relation = formalizes, coverage = exact, quote = "Section 6676(a) is amended by striking “income tax” and inserting “income or employment tax”.")
rule Section6676aEmploymentTaxPenalty defeasible {
    effective [@2025-07-04, infinity);
    for c: Claim;
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for camt: Money;
    for excess: Money;
    when us.irc.core::claim_of(c, p, y, kind, camt)
        and employment_tax_kind_for_6676(kind)
        and refund_claim_excessive_amount(c, excess)
        and not excessive_amount_subject_to_part_ii_penalty(c);
    then erroneous_refund_claim_penalty(c, round(excess * ErroneousRefundClaimRate, 2, "HALF_UP"));
    unless reasonable_cause_for_excessive_claim(p, c)
        and not excessive_amount_attributable_to_economic_substance_transaction(c)
        and us.irc.core::claim_of(c, p, y, kind, camt)
        and employment_tax_kind_for_6676(kind)
        and refund_claim_excessive_amount(c, excess)
        and not excessive_amount_subject_to_part_ii_penalty(c);
}
