language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

use self::{
    Deposit,
    IRC_S6656_E,
    Person,
};

// 26 U.S.C. §6656(e) — designation of periods to which deposits apply (IRC-16 stage 2,
// DECISION-0379); the §6664(a) additions (previously assessed amounts and rebates) live
// in module 06 next to the underpayment definition they complete.
//
// MODEL. A deposit is applied to the most recent period(s) within the specified tax
// period unless the person designates a different period; the designation is a power of
// the person, valid only during the 90-day period that begins on the date of the notice
// that a section 6656(a) penalty has been imposed for the specified tax period.
//
// GAPS. The section 6211(b)(4)-like rule that §6664(a)'s last sentence borrows for
// rebates is not modelled (TECH-GAPS G3112: rebate arithmetic needs the deficiency
// machinery of `assessment`).

pub entity DepositPeriod {
    label en unofficial "a period within the specified tax period to which a deposit may be applied";
}
relation deposit_period_within_specified_tax_period(dep: Deposit, per: DepositPeriod) kind empirical {
    label en official "the period is within the specified tax period to which the deposit relates";
}
relation deposit_period_ends_on(per: DepositPeriod, d: Date) kind empirical {
    label en unofficial "the last day of the period";
}
relation later_deposit_period_exists(dep: Deposit, per: DepositPeriod) kind institutional {
    label en unofficial "a period within the specified tax period ends later than this one";
}
@source(IRC_S6656_E, relation = formalizes, coverage = exact, quote = "A deposit made under this section shall be applied to the most recent period or periods within the specified tax period to which the deposit relates")
rule S6656e1LaterPeriod strict {
    for dep: Deposit;
    for per: DepositPeriod;
    for other: DepositPeriod;
    for d: Date;
    for e: Date;
    when deposit_period_within_specified_tax_period(dep, per)
        and deposit_period_within_specified_tax_period(dep, other)
        and deposit_period_ends_on(per, d)
        and deposit_period_ends_on(other, e)
        and e > d;
    then later_deposit_period_exists(dep, per);
}
relation deposit_designation_made(dep: Deposit, per: DepositPeriod) kind empirical {
    label en official "the person designates a different period to which the deposit is to be applied";
}
relation deposit_designation_made_on(dep: Deposit, per: DepositPeriod, d: Date) kind empirical {
    label en unofficial "the date the designation is made";
}
relation penalty_notice_for_specified_tax_period_dated(dep: Deposit, d: Date) kind empirical {
    label en official "the date of the notice that a penalty under subsection (a) has been imposed for the specified tax period to which the deposit relates";
}
relation deposit_designated_any_period(dep: Deposit) kind empirical {
    label en unofficial "the person has designated some period for the deposit";
}
relation deposit_designation_flag(dep: Deposit) kind institutional {
    label en unofficial "some designation has been made for the deposit";
}
@source(IRC_S6656_E, relation = formalizes, coverage = exact, quote = "unless the person making such deposit designates a different period or periods to which such deposit is to be applied")
rule S6656e1DesignationFlag strict {
    for dep: Deposit;
    for per: DepositPeriod;
    when deposit_designation_made(dep, per);
    then deposit_designation_flag(dep);
}
pub relation deposit_applied_to_period(dep: Deposit, per: DepositPeriod) kind institutional {
    label en unofficial "the deposit is applied to the period";
}
@source(IRC_S6656_E, relation = formalizes, coverage = exact, quote = "A deposit made under this section shall be applied to the most recent period or periods within the specified tax period to which the deposit relates")
rule S6656e1DefaultApplication strict {
    for dep: Deposit;
    for per: DepositPeriod;
    when deposit_period_within_specified_tax_period(dep, per)
        and not_known(later_deposit_period_exists(dep, per))
        and not_known(deposit_designation_flag(dep));
    then deposit_applied_to_period(dep, per);
}
relation designation_within_90_day_window(dep: Deposit, per: DepositPeriod) kind institutional {
    label en unofficial "the designation is made during the 90-day period beginning on the date of the penalty notice";
}
@source(IRC_S6656_E, relation = formalizes, coverage = exact, quote = "A person may make a designation under paragraph (1) only during the 90-day period beginning on the date of a notice that a penalty under subsection (a) has been imposed for the specified tax period to which the deposit relates")
rule S6656e2Window strict {
    for dep: Deposit;
    for per: DepositPeriod;
    for n: Date;
    for d: Date;
    when penalty_notice_for_specified_tax_period_dated(dep, n)
        and deposit_designation_made_on(dep, per, d)
        and d >= n
        and d < add_calendar_period(n, 90 calendar_day);
    then designation_within_90_day_window(dep, per);
}
relation depositor_of(dep: Deposit, p: Person) kind empirical {
    label en unofficial "the person who made the deposit";
}
pub relation deposit_applied_by_designation(dep: Deposit, per: DepositPeriod) kind institutional {
    label en unofficial "the deposit is applied to the designated period";
}
@source(IRC_S6656_E, relation = formalizes, coverage = exact, quote = "unless the person making such deposit designates a different period or periods to which such deposit is to be applied")
rule S6656e2DesignationPower strict {
    for dep: Deposit;
    for per: DepositPeriod;
    for p: Person;
    when deposit_designation_made(dep, per)
        and depositor_of(dep, p);
    then power DesignateDepositPeriod {
        holder p;
        over dep;
        exercise deposit_designation_made(dep, per);
        valid_when designation_within_90_day_window(dep, per);
        effect create(deposit_applied_by_designation(dep, per));
        window [-infinity, infinity];
    };
}
