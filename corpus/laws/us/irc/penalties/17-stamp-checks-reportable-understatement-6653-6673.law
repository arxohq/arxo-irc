language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

use self::{
    DistrictCourt,
    FailureContext,
    IRC_S6653,
    IRC_S6657,
    IRC_S6658_A,
    IRC_S6662A_A,
    IRC_S6662A_B,
    IRC_S6662A_C,
    IRC_S6662A_E,
    IRC_S6664_D,
    IRC_S6671_A,
    IRC_S6671_B,
    IRC_S6673_B,
    Person,
    Secretary,
    TaxableYear,
    failure_by,
    penalty_notice_and_demand_made,
};

// 26 U.S.C. §§6653, 6657, 6658, 6659 (Pub. L. 119-21), 6662A (with §6664(d)),
// 6671, 6673(b) (IRC-16 stage 2, DECISION-0379).
//
// JUDGMENT CALLS AND GAPS:
//  - §6653 "willfully" and §6659 "negligence or disregard"/"fraud" are ELEMENTS
//    of liability: empirical relations the case must establish with origin
//    adjudicated (DECISION-0194 second channel), like §6674 in module 09.
//  - §6657's "in good faith and with reasonable cause to believe that it would
//    be duly paid" is a judgment channel of its own, authority Secretary.
//  - §6658 is a defeasible bar on the failure-to-pay additions of §§6651,
//    6654, 6655 (wiring: see the `unless` clauses added to those modules).
//  - §6659 is NOT in the pinned 2024 text (it was reserved: sections
//    6659-6661 repealed); it enters through `us.irc.temporal::PL119_21_S70204`
//    with a rule `effective [@2026-01-01, infinity)` approximating "taxable
//    years beginning after December 31, 2025" (TECH-GAPS G3102).
//  - §6662A is modelled ITEM BY ITEM (`ReportableTransactionItem`): the
//    per-taxpayer sum of item understatements and penalties is an aggregate
//    over a DERIVED relation (§111 runtime subset limitation, TECH-GAPS G3101).
//    §6662A(e)(1) (interaction with §6662(d) substantial understatement)
//    needs that aggregate and is TECH-GAPS G3101 too.
//  - §6664(d)(4) reasonable-belief and opinion rules are modelled at the level
//    the text supports: facts of the belief, the barred-advisor and
//    disqualified-opinion tests as derived relations; that a belief may rest
//    on an independent, non-barred basis in addition to a barred opinion is
//    not separated (one flag per item).

// --- §6653: failure to pay stamp tax --------------------------------------------
relation willfully_fails_to_pay_stamp_tax(f: FailureContext) kind empirical {
    label en official "willfully fails to pay any tax imposed by this title which is payable by stamp, coupons, tickets, books, or other devices or methods prescribed by this title or by regulations under the authority of this title";
}
relation willfully_attempts_to_evade_stamp_tax(f: FailureContext) kind empirical {
    label en official "willfully attempts in any manner to evade or defeat any such tax or the payment thereof";
}
relation stamp_tax_underpayment_amount(f: FailureContext, amount: Money) kind empirical {
    label en unofficial "the total amount of the underpayment of the tax (case fact)";
}
relation stamp_tax_penalty_ground(f: FailureContext) kind institutional {
    label en unofficial "a section 6653 ground is established: willful failure to pay a stamp tax, or willful attempt to evade or defeat it";
}
@source(IRC_S6653, relation = formalizes, coverage = partial, quote = "willfully fails to pay any tax imposed by this title which is payable by stamp")
rule S6653Ground1 strict {
    for f: FailureContext;
    when willfully_fails_to_pay_stamp_tax(f);
    then stamp_tax_penalty_ground(f);
}
@source(IRC_S6653, relation = formalizes, coverage = partial, quote = "willfully attempts in any manner to evade or defeat any such tax or the payment thereof")
rule S6653Ground2 strict {
    for f: FailureContext;
    when willfully_attempts_to_evade_stamp_tax(f);
    then stamp_tax_penalty_ground(f);
}
pub relation stamp_tax_penalty_6653(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "a penalty of 50 percent of the total amount of the underpayment of the tax, in addition to other penalties provided by law";
}
@source(IRC_S6653, relation = formalizes, coverage = exact, quote = "shall, in addition to other penalties provided by law, be liable for a penalty of 50 percent of the total amount of the underpayment of the tax")
rule S6653Penalty defeasible {
    for f: FailureContext;
    for p: Person;
    for u: Money;
    when failure_by(f, p)
        and stamp_tax_penalty_ground(f)
        and stamp_tax_underpayment_amount(f, u);
    then stamp_tax_penalty_6653(f, round(u * StampTaxEvasionPenaltyRate, 2, "HALF_UP"));
}

// --- §6657: bad checks ------------------------------------------------------------
relation instrument_in_payment_not_duly_paid(f: FailureContext) kind empirical {
    label en official "any instrument in payment, by any commercially acceptable means, of any amount receivable under this title is not duly paid";
}
relation instrument_amount(f: FailureContext, amount: Money) kind empirical {
    label en unofficial "the amount of the instrument (case fact)";
}
pub external judgment relation tendered_in_good_faith_with_reasonable_cause_to_believe_paid(p: Person, f: FailureContext) {
    authority Secretary;
    label en official "the person tendered such instrument in good faith and with reasonable cause to believe that it would be duly paid";
}
pub relation bad_check_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "2 percent of the amount of the instrument; for an instrument below $1,250, $25 or the amount of the instrument, whichever is the lesser";
}
@source(IRC_S6657, relation = formalizes, coverage = exact, quote = "an amount equal to 2 percent of the amount of such instrument")
rule S6657GeneralPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for a: Money;
    when failure_by(f, p)
        and instrument_in_payment_not_duly_paid(f)
        and instrument_amount(f, a)
        and a >= round(BadCheckSmallInstrumentThreshold, 2, "HALF_UP");
    then bad_check_penalty(f, round(a * BadCheckPenaltyRate, 2, "HALF_UP"));
    unless tendered_in_good_faith_with_reasonable_cause_to_believe_paid(p, f)
        and failure_by(f, p)
        and instrument_in_payment_not_duly_paid(f)
        and instrument_amount(f, a)
        and a >= round(BadCheckSmallInstrumentThreshold, 2, "HALF_UP");
}
@source(IRC_S6657, relation = formalizes, coverage = exact, quote = "if the amount of such instrument is less than $1,250, the penalty under this section shall be $25 or the amount of such instrument, whichever is the lesser")
rule S6657SmallInstrumentPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for a: Money;
    when failure_by(f, p)
        and instrument_in_payment_not_duly_paid(f)
        and instrument_amount(f, a)
        and a < round(BadCheckSmallInstrumentThreshold, 2, "HALF_UP");
    then bad_check_penalty(f, min(round(BadCheckSmallInstrumentPenalty, 2, "HALF_UP"), a));
    unless tendered_in_good_faith_with_reasonable_cause_to_believe_paid(p, f)
        and failure_by(f, p)
        and instrument_in_payment_not_duly_paid(f)
        and instrument_amount(f, a)
        and a < round(BadCheckSmallInstrumentThreshold, 2, "HALF_UP");
}

// --- §6658: addition to tax in title 11 cases -----------------------------------------
relation title_11_case_pending_during_period(p: Person, y: TaxableYear) kind empirical {
    label en official "a case is pending under title 11 of the United States Code during the period";
}
relation tax_incurred_by_the_estate(p: Person, y: TaxableYear) kind empirical {
    label en official "such tax was incurred by the estate";
}
relation failure_pursuant_to_court_order_finding_probable_insufficiency(p: Person, y: TaxableYear) kind empirical {
    label en official "the failure occurred pursuant to an order of the court finding probable insufficiency of funds of the estate to pay administrative expenses";
}
relation tax_incurred_by_debtor_before_relief_or_trustee(p: Person, y: TaxableYear) kind empirical {
    label en official "such tax was incurred by the debtor before the earlier of the order for relief or (in the involuntary case) the appointment of a trustee";
}
relation title_11_petition_filed_on(p: Person, y: TaxableYear, d: Date) kind empirical {
    label en unofficial "the date on which the petition was filed";
}
relation return_due_date_including_extensions(p: Person, y: TaxableYear, d: Date) kind empirical {
    label en official "the due date prescribed by law (including extensions) for filing a return of such tax";
}
relation addition_to_tax_date(p: Person, y: TaxableYear, d: Date) kind empirical {
    label en official "the date for making the addition to the tax";
}
relation addition_arises_from_failure_to_pay_or_deposit_collected_tax(p: Person, y: TaxableYear) kind empirical {
    label en official "an addition to the tax which arises from the failure to pay or deposit a tax withheld or collected from others and required to be paid to the United States";
}
relation bankruptcy_bar_condition_6658a(p: Person, y: TaxableYear) kind institutional {
    label en unofficial "a section 6658(a)(1) or (a)(2) condition is met";
}
@source(IRC_S6658_A, relation = formalizes, coverage = exact, quote = "if such tax was incurred by the estate and the failure occurred pursuant to an order of the court finding probable insufficiency of funds of the estate to pay administrative expenses")
rule S6658a1EstateTax strict {
    for p: Person;
    for y: TaxableYear;
    when title_11_case_pending_during_period(p, y)
        and tax_incurred_by_the_estate(p, y)
        and failure_pursuant_to_court_order_finding_probable_insufficiency(p, y);
    then bankruptcy_bar_condition_6658a(p, y);
}
@source(IRC_S6658_A, relation = formalizes, coverage = exact, quote = "the petition was filed before the due date prescribed by law (including extensions) for filing a return of such tax")
rule S6658a2PetitionBeforeDueDate strict {
    for p: Person;
    for y: TaxableYear;
    for d: Date;
    for due: Date;
    when title_11_case_pending_during_period(p, y)
        and tax_incurred_by_debtor_before_relief_or_trustee(p, y)
        and title_11_petition_filed_on(p, y, d)
        and return_due_date_including_extensions(p, y, due)
        and d < due;
    then bankruptcy_bar_condition_6658a(p, y);
}
@source(IRC_S6658_A, relation = formalizes, coverage = exact, quote = "the date for making the addition to the tax occurs on or after the day on which the petition was filed")
rule S6658a2AdditionDateAfterPetition strict {
    for p: Person;
    for y: TaxableYear;
    for d: Date;
    for add: Date;
    when title_11_case_pending_during_period(p, y)
        and tax_incurred_by_debtor_before_relief_or_trustee(p, y)
        and title_11_petition_filed_on(p, y, d)
        and addition_to_tax_date(p, y, add)
        and add >= d;
    then bankruptcy_bar_condition_6658a(p, y);
}
pub relation no_payment_addition_under_6658(p: Person, y: TaxableYear) kind institutional {
    label en official "no addition to the tax shall be made under section 6651, 6654, or 6655 for failure to make timely payment of tax with respect to a period during which a title 11 case is pending";
}
@source(IRC_S6658_A, relation = formalizes, coverage = exact, quote = "No addition to the tax shall be made under section 6651, 6654, or 6655 for failure to make timely payment of tax with respect to a period during which a case is pending under title 11 of the United States Code")
rule S6658NoAddition defeasible {
    for p: Person;
    for y: TaxableYear;
    when bankruptcy_bar_condition_6658a(p, y);
    then no_payment_addition_under_6658(p, y);
    unless addition_arises_from_failure_to_pay_or_deposit_collected_tax(p, y)
        and bankruptcy_bar_condition_6658a(p, y);
}

// --- §6659 (added by Pub. L. 119-21 sec. 70204): improper claim for Trump account pilot credit
relation trump_pilot_election_under_6434_for_non_eligible_child(f: FailureContext) kind empirical {
    label en official "an individual makes an election under section 6434 with respect to an individual who is not an eligible child of the taxpayer";
}
relation trump_pilot_election_due_to_negligence_or_disregard(f: FailureContext) kind empirical {
    label en official "the election was made due to negligence or disregard of the rules or regulations (the terms have the same meaning as in section 6662)";
}
relation trump_pilot_election_due_to_fraud(f: FailureContext) kind empirical {
    label en official "the election was made due to fraud";
}
pub relation trump_account_election_penalty_6659(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "a penalty of $500 for negligence or disregard, $1,000 for fraud";
}
@source(us.irc.temporal::PL119_21_S70204, relation = formalizes, coverage = exact, quote = "if such election was made due to negligence or disregard of the rules or regulations, there shall be imposed a penalty of $500")
rule S6659aNegligentElectionPenalty defeasible {
    effective [@2026-01-01, infinity);
    for f: FailureContext;
    for p: Person;
    when failure_by(f, p)
        and trump_pilot_election_under_6434_for_non_eligible_child(f)
        and trump_pilot_election_due_to_negligence_or_disregard(f);
    then trump_account_election_penalty_6659(f, round(TrumpAccountNegligentElectionPenalty, 2, "HALF_UP"));
    unless trump_pilot_election_due_to_fraud(f)
        and failure_by(f, p)
        and trump_pilot_election_under_6434_for_non_eligible_child(f)
        and trump_pilot_election_due_to_negligence_or_disregard(f);
}
@source(us.irc.temporal::PL119_21_S70204, relation = formalizes, coverage = exact, quote = "if such election was made due to fraud, there shall be imposed a penalty of $1,000")
rule S6659aFraudulentElectionPenalty defeasible {
    effective [@2026-01-01, infinity);
    for f: FailureContext;
    for p: Person;
    when failure_by(f, p)
        and trump_pilot_election_under_6434_for_non_eligible_child(f)
        and trump_pilot_election_due_to_fraud(f);
    then trump_account_election_penalty_6659(f, round(TrumpAccountFraudulentElectionPenalty, 2, "HALF_UP"));
}

// --- §6662A: reportable transaction understatements (item-level) -------------------------
pub entity ReportableTransactionItem {
    label en unofficial "a taxpayer's item to which section 6662A may apply: an item attributable to a listed or other reportable transaction, on a return for a taxable year";
}
relation item_of_taxpayer_year(i: ReportableTransactionItem, p: Person, y: TaxableYear) kind empirical {
    label en unofficial "the item is the taxpayer's item for the taxable year";
}
relation item_attributable_to_listed_transaction(i: ReportableTransactionItem) kind empirical {
    label en official "any listed transaction (section 6707A(c)(2))";
}
relation item_attributable_to_reportable_transaction_not_listed(i: ReportableTransactionItem) kind empirical {
    label en official "any reportable transaction (other than a listed transaction)";
}
pub external judgment relation significant_purpose_is_avoidance_or_evasion(i: ReportableTransactionItem) {
    authority TaxCourt;
    label en official "a significant purpose of such transaction is the avoidance or evasion of Federal income tax";
}
pub relation item_covered_by_6662A(i: ReportableTransactionItem) kind institutional {
    label en unofficial "the item is one to which section 6662A applies";
}
@source(IRC_S6662A_B, relation = formalizes, coverage = exact, quote = "any listed transaction")
rule S6662Ab2ListedItem strict {
    for i: ReportableTransactionItem;
    when item_attributable_to_listed_transaction(i);
    then item_covered_by_6662A(i);
}
@source(IRC_S6662A_B, relation = formalizes, coverage = exact, quote = "any reportable transaction (other than a listed transaction) if a significant purpose of such transaction is the avoidance or evasion of Federal income tax")
rule S6662Ab2OtherReportableItem strict {
    for i: ReportableTransactionItem;
    when item_attributable_to_reportable_transaction_not_listed(i)
        and significant_purpose_is_avoidance_or_evasion(i);
    then item_covered_by_6662A(i);
}
relation original_treatment_amounts(i: ReportableTransactionItem, inc: Money, dec: Money) kind empirical {
    label en unofficial "the increase in taxable income and the decrease in credits resulting from the difference between the proper treatment and the treatment shown on the ORIGINAL return (case fact; deemed increases from reduced deductions in excess of gross income and reduced capital losses are included per section 6662A(b)(1) last sentence)";
}
relation current_treatment_amounts(i: ReportableTransactionItem, inc: Money, dec: Money) kind empirical {
    label en unofficial "the same amounts measured against the treatment shown on the return as amended or supplemented";
}
relation amendment_filed_on(i: ReportableTransactionItem, d: Date) kind empirical {
    label en unofficial "the date of the amendment or supplement to the return";
}
relation first_contact_about_examination_on(i: ReportableTransactionItem, d: Date) kind empirical {
    label en official "the date the taxpayer is first contacted by the Secretary regarding the examination of the return";
}
relation secretary_specified_cutoff_date(i: ReportableTransactionItem, d: Date) kind empirical {
    label en official "such other date as is specified by the Secretary";
}
relation amended_treatment_disregarded_6662A(i: ReportableTransactionItem) kind institutional {
    label en unofficial "the tax treatment included with the amendment or supplement is not taken into account (section 6662A(e)(3))";
}
@source(IRC_S6662A_E, relation = formalizes, coverage = partial, quote = "in no event shall any tax treatment included with an amendment or supplement to a return of tax be taken into account in determining the amount of any reportable transaction understatement if the amendment or supplement is filed after the earlier of the date the taxpayer is first contacted by the Secretary regarding the examination of the return or such other date as is specified by the Secretary")
rule S6662Ae3AfterContact strict {
    for i: ReportableTransactionItem;
    for a: Date;
    for c: Date;
    when amendment_filed_on(i, a)
        and first_contact_about_examination_on(i, c)
        and a > c;
    then amended_treatment_disregarded_6662A(i);
}
@source(IRC_S6662A_E, relation = formalizes, coverage = partial, quote = "the earlier of the date the taxpayer is first contacted by the Secretary regarding the examination of the return or such other date as is specified by the Secretary")
rule S6662Ae3AfterSpecifiedDate strict {
    for i: ReportableTransactionItem;
    for a: Date;
    for c: Date;
    when amendment_filed_on(i, a)
        and secretary_specified_cutoff_date(i, c)
        and a > c;
    then amended_treatment_disregarded_6662A(i);
}
relation treatment_amounts_for_6662A(i: ReportableTransactionItem, inc: Money, dec: Money) kind institutional {
    label en unofficial "the increase in taxable income and decrease in credits taken into account for section 6662A";
}
@source(IRC_S6662A_E, relation = formalizes, coverage = partial, quote = "in no event shall any tax treatment included with an amendment or supplement to a return of tax be taken into account")
rule S6662AtreatmentOriginal defeasible {
    for i: ReportableTransactionItem;
    for inc: Money;
    for dec: Money;
    when amended_treatment_disregarded_6662A(i)
        and original_treatment_amounts(i, inc, dec);
    then treatment_amounts_for_6662A(i, inc, dec);
}
@source(IRC_S6662A_B, relation = formalizes, coverage = partial, quote = "the taxpayer's treatment of such item (as shown on the taxpayer's return of tax)")
rule S6662AtreatmentCurrent defeasible {
    for i: ReportableTransactionItem;
    for inc: Money;
    for dec: Money;
    when not_known(amended_treatment_disregarded_6662A(i))
        and current_treatment_amounts(i, inc, dec);
    then treatment_amounts_for_6662A(i, inc, dec);
}
pub relation highest_income_tax_rate_for_taxpayer(p: Person, y: TaxableYear, rate: Decimal) kind institutional {
    label en unofficial "PENDING (owner: income-individual for section 1, corporations for section 11) - the highest rate of tax imposed by section 1 (section 11 in the case of a corporation) for the taxable year";
}
pub relation item_understatement_6662A(i: ReportableTransactionItem, amount: Money) kind institutional {
    label en unofficial "the reportable transaction understatement attributable to the item: the increase in taxable income times the highest rate, plus the decrease in credits";
}
@source(IRC_S6662A_B, relation = formalizes, coverage = partial, quote = "the product of—")
rule S6662Ab1ItemUnderstatement defeasible {
    for i: ReportableTransactionItem;
    for p: Person;
    for y: TaxableYear;
    for inc: Money;
    for dec: Money;
    for rate: Decimal;
    when item_covered_by_6662A(i)
        and item_of_taxpayer_year(i, p, y)
        and treatment_amounts_for_6662A(i, inc, dec)
        and highest_income_tax_rate_for_taxpayer(p, y, rate);
    then item_understatement_6662A(i, round(inc * rate, 2, "HALF_UP") + dec);
}
relation item_attributable_to_economic_substance_transaction(i: ReportableTransactionItem) kind empirical {
    label en official "the portion of the understatement is attributable to one or more transactions described in section 6662(b)(6)";
}
relation relevant_facts_adequately_disclosed(i: ReportableTransactionItem) kind empirical {
    label en official "the relevant facts affecting the tax treatment of the item are adequately disclosed in accordance with the regulations prescribed under section 6011";
}
relation failure_to_disclose_penalty_rescinded_6707Ad(i: ReportableTransactionItem) kind empirical {
    label en official "the penalty for the failure to adequately disclose was rescinded under section 6707A(d)";
}
pub relation disclosure_requirement_met_6664d3A(i: ReportableTransactionItem) kind institutional {
    label en unofficial "the requirement of section 6664(d)(3)(A) is met";
}
@source(IRC_S6664_D, relation = formalizes, coverage = exact, quote = "the relevant facts affecting the tax treatment of the item are adequately disclosed in accordance with the regulations prescribed under section 6011")
rule S6664d3ADisclosed strict {
    for i: ReportableTransactionItem;
    when relevant_facts_adequately_disclosed(i);
    then disclosure_requirement_met_6664d3A(i);
}
@source(IRC_S6664_D, relation = formalizes, coverage = exact, quote = "A taxpayer failing to adequately disclose in accordance with section 6011 shall be treated as meeting the requirements of subparagraph (A) if the penalty for such failure was rescinded under section 6707A(d)")
rule S6664d3ARescinded strict {
    for i: ReportableTransactionItem;
    when failure_to_disclose_penalty_rescinded_6707Ad(i);
    then disclosure_requirement_met_6664d3A(i);
}
pub external judgment relation substantial_authority_for_item_treatment(i: ReportableTransactionItem) {
    authority Secretary;
    label en official "there is or was substantial authority for such treatment";
}
relation believed_more_likely_than_not_proper(i: ReportableTransactionItem) kind empirical {
    label en official "the taxpayer believed that such treatment was more likely than not the proper treatment";
}
relation belief_based_on_facts_and_law_at_filing(i: ReportableTransactionItem) kind empirical {
    label en official "the belief is based on the facts and law that exist at the time the return of tax which includes such tax treatment is filed";
}
relation belief_relates_solely_to_chances_on_merits(i: ReportableTransactionItem) kind empirical {
    label en official "the belief relates solely to the taxpayer's chances of success on the merits of such treatment and does not take into account the possibility that a return will not be audited, such treatment will not be raised on audit, or such treatment will be resolved through settlement if it is raised";
}
entity TaxAdvisorOpinion {
    label en unofficial "an opinion of a tax advisor relied upon to establish the taxpayer's belief";
}
relation belief_rests_on_opinion(i: ReportableTransactionItem, o: TaxAdvisorOpinion) kind empirical {
    label en unofficial "the taxpayer relies on this tax advisor opinion to establish the reasonable belief";
}
relation advisor_is_material_advisor_participating_or_related(o: TaxAdvisorOpinion) kind empirical {
    label en official "the tax advisor is a material advisor (within the meaning of section 6111(b)(1)) and participates in the organization, management, promotion, or sale of the transaction or is related to any person who so participates";
}
relation advisor_compensated_by_material_advisor(o: TaxAdvisorOpinion) kind empirical {
    label en official "the tax advisor is compensated directly or indirectly by a material advisor with respect to the transaction";
}
relation advisor_fee_contingent_on_tax_benefits(o: TaxAdvisorOpinion) kind empirical {
    label en official "the tax advisor has a fee arrangement with respect to the transaction which is contingent on all or part of the intended tax benefits from the transaction being sustained";
}
relation advisor_has_disqualifying_financial_interest(o: TaxAdvisorOpinion) kind empirical {
    label en official "the tax advisor, as determined under regulations prescribed by the Secretary, has a disqualifying financial interest with respect to the transaction";
}
relation opinion_based_on_unreasonable_assumptions(o: TaxAdvisorOpinion) kind empirical {
    label en official "the opinion is based on unreasonable factual or legal assumptions (including assumptions as to future events)";
}
relation opinion_unreasonably_relies_on_representations(o: TaxAdvisorOpinion) kind empirical {
    label en official "the opinion unreasonably relies on representations, statements, findings, or agreements of the taxpayer or any other person";
}
relation opinion_omits_relevant_facts(o: TaxAdvisorOpinion) kind empirical {
    label en official "the opinion does not identify and consider all relevant facts";
}
relation opinion_fails_other_secretary_requirement(o: TaxAdvisorOpinion) kind empirical {
    label en official "the opinion fails to meet any other requirement as the Secretary may prescribe";
}
relation advisor_disqualified_6664d4Bii(o: TaxAdvisorOpinion) kind institutional {
    label en unofficial "the tax advisor is described in section 6664(d)(4)(B)(ii)";
}
relation opinion_disqualified_6664d4Biii(o: TaxAdvisorOpinion) kind institutional {
    label en unofficial "the opinion is disqualified under section 6664(d)(4)(B)(iii)";
}
@source(IRC_S6664_D, relation = formalizes, coverage = exact, quote = "is a material advisor (within the meaning of section 6111(b)(1)) and participates in the organization, management, promotion, or sale of the transaction")
rule S6664d4BiiIAdvisor strict {
    for o: TaxAdvisorOpinion;
    when advisor_is_material_advisor_participating_or_related(o);
    then advisor_disqualified_6664d4Bii(o);
}
@source(IRC_S6664_D, relation = formalizes, coverage = exact, quote = "is compensated directly or indirectly by a material advisor with respect to the transaction")
rule S6664d4BiiIIAdvisor strict {
    for o: TaxAdvisorOpinion;
    when advisor_compensated_by_material_advisor(o);
    then advisor_disqualified_6664d4Bii(o);
}
@source(IRC_S6664_D, relation = formalizes, coverage = exact, quote = "has a fee arrangement with respect to the transaction which is contingent on all or part of the intended tax benefits from the transaction being sustained")
rule S6664d4BiiIIIAdvisor strict {
    for o: TaxAdvisorOpinion;
    when advisor_fee_contingent_on_tax_benefits(o);
    then advisor_disqualified_6664d4Bii(o);
}
@source(IRC_S6664_D, relation = formalizes, coverage = exact, quote = "has a disqualifying financial interest with respect to the transaction")
rule S6664d4BiiIVAdvisor strict {
    for o: TaxAdvisorOpinion;
    when advisor_has_disqualifying_financial_interest(o);
    then advisor_disqualified_6664d4Bii(o);
}
@source(IRC_S6664_D, relation = formalizes, coverage = exact, quote = "is based on unreasonable factual or legal assumptions (including assumptions as to future events)")
rule S6664d4BiiiIOpinion strict {
    for o: TaxAdvisorOpinion;
    when opinion_based_on_unreasonable_assumptions(o);
    then opinion_disqualified_6664d4Biii(o);
}
@source(IRC_S6664_D, relation = formalizes, coverage = exact, quote = "unreasonably relies on representations, statements, findings, or agreements of the taxpayer or any other person")
rule S6664d4BiiiIIOpinion strict {
    for o: TaxAdvisorOpinion;
    when opinion_unreasonably_relies_on_representations(o);
    then opinion_disqualified_6664d4Biii(o);
}
@source(IRC_S6664_D, relation = formalizes, coverage = exact, quote = "does not identify and consider all relevant facts")
rule S6664d4BiiiIIIOpinion strict {
    for o: TaxAdvisorOpinion;
    when opinion_omits_relevant_facts(o);
    then opinion_disqualified_6664d4Biii(o);
}
@source(IRC_S6664_D, relation = formalizes, coverage = exact, quote = "fails to meet any other requirement as the Secretary may prescribe")
rule S6664d4BiiiIVOpinion strict {
    for o: TaxAdvisorOpinion;
    when opinion_fails_other_secretary_requirement(o);
    then opinion_disqualified_6664d4Biii(o);
}
pub relation opinion_may_not_be_relied_upon(o: TaxAdvisorOpinion) kind institutional {
    label en unofficial "an opinion of a tax advisor may not be relied upon to establish the reasonable belief of a taxpayer if the advisor is disqualified or the opinion is disqualified";
}
@source(IRC_S6664_D, relation = formalizes, coverage = exact, quote = "the tax advisor is described in clause (ii), or")
rule S6664d4BiAdvisor strict {
    for o: TaxAdvisorOpinion;
    when advisor_disqualified_6664d4Bii(o);
    then opinion_may_not_be_relied_upon(o);
}
@source(IRC_S6664_D, relation = formalizes, coverage = exact, quote = "the opinion is described in clause (iii).")
rule S6664d4BiOpinion strict {
    for o: TaxAdvisorOpinion;
    when opinion_disqualified_6664d4Biii(o);
    then opinion_may_not_be_relied_upon(o);
}
relation belief_relies_on_barred_opinion(i: ReportableTransactionItem) kind institutional {
    label en unofficial "the taxpayer's belief is established through an opinion that may not be relied upon";
}
@source(IRC_S6664_D, relation = formalizes, coverage = exact, quote = "An opinion of a tax advisor may not be relied upon to establish the reasonable belief of a taxpayer")
rule S6664d4BiBarredReliance strict {
    for i: ReportableTransactionItem;
    for o: TaxAdvisorOpinion;
    when belief_rests_on_opinion(i, o)
        and opinion_may_not_be_relied_upon(o);
    then belief_relies_on_barred_opinion(i);
}
pub relation reasonable_belief_treated_6664d4A(i: ReportableTransactionItem) kind institutional {
    label en unofficial "the taxpayer is treated as having a reasonable belief with respect to the tax treatment of the item";
}
@source(IRC_S6664_D, relation = formalizes, coverage = exact, quote = "A taxpayer shall be treated as having a reasonable belief with respect to the tax treatment of an item only if such belief")
rule S6664d4AReasonableBelief defeasible {
    for i: ReportableTransactionItem;
    when believed_more_likely_than_not_proper(i)
        and belief_based_on_facts_and_law_at_filing(i)
        and belief_relates_solely_to_chances_on_merits(i);
    then reasonable_belief_treated_6664d4A(i);
    unless belief_relies_on_barred_opinion(i)
        and believed_more_likely_than_not_proper(i)
        and belief_based_on_facts_and_law_at_filing(i)
        and belief_relates_solely_to_chances_on_merits(i);
}
pub external judgment relation reasonable_cause_and_good_faith_for_reportable_portion(p: Person, i: ReportableTransactionItem) {
    authority Secretary;
    label en official "it is shown that there was a reasonable cause for such portion and that the taxpayer acted in good faith with respect to such portion";
}
pub relation reportable_understatement_reasonable_cause_defense(i: ReportableTransactionItem) kind institutional {
    label en unofficial "the section 6664(d)(1) reasonable-cause-and-good-faith defense applies to the item";
}
@source(IRC_S6664_D, relation = formalizes, coverage = exact, quote = "No penalty shall be imposed under section 6662A with respect to any portion of a reportable transaction understatement if it is shown that there was a reasonable cause for such portion and that the taxpayer acted in good faith with respect to such portion")
rule S6664dReasonableCauseDefense defeasible {
    for i: ReportableTransactionItem;
    for p: Person;
    for y: TaxableYear;
    when item_of_taxpayer_year(i, p, y)
        and reasonable_cause_and_good_faith_for_reportable_portion(p, i)
        and disclosure_requirement_met_6664d3A(i)
        and substantial_authority_for_item_treatment(i)
        and reasonable_belief_treated_6664d4A(i);
    then reportable_understatement_reasonable_cause_defense(i);
    unless item_attributable_to_economic_substance_transaction(i)
        and item_of_taxpayer_year(i, p, y)
        and reasonable_cause_and_good_faith_for_reportable_portion(p, i)
        and disclosure_requirement_met_6664d3A(i)
        and substantial_authority_for_item_treatment(i)
        and reasonable_belief_treated_6664d4A(i);
}
relation item_portion_subject_to_6663_penalty(i: ReportableTransactionItem) kind empirical {
    label en official "a penalty is imposed under section 6663 on the portion of the understatement";
}
relation item_portion_subject_to_6662_h_or_i_rate(i: ReportableTransactionItem) kind empirical {
    label en official "a penalty is imposed under section 6662 on the portion and its rate is determined under subsection (h) or (i) of section 6662";
}
pub relation reportable_transaction_understatement_penalty(i: ReportableTransactionItem, amount: Money) kind institutional {
    label en unofficial "the section 6662A addition to tax on the item";
}
@source(IRC_S6662A_A, relation = formalizes, coverage = exact, quote = "there shall be added to the tax an amount equal to 20 percent of the amount of such understatement")
rule S6662AaPenaltyDisclosed defeasible {
    for i: ReportableTransactionItem;
    for u: Money;
    when item_covered_by_6662A(i)
        and item_understatement_6662A(i, u)
        and disclosure_requirement_met_6664d3A(i);
    then reportable_transaction_understatement_penalty(i, round(u * ReportableTransactionUnderstatementRate, 2, "HALF_UP"));
    unless reportable_understatement_reasonable_cause_defense(i)
        and item_covered_by_6662A(i)
        and item_understatement_6662A(i, u)
        and disclosure_requirement_met_6664d3A(i);
    unless item_portion_subject_to_6663_penalty(i)
        and item_covered_by_6662A(i)
        and item_understatement_6662A(i, u)
        and disclosure_requirement_met_6664d3A(i);
    unless item_portion_subject_to_6662_h_or_i_rate(i)
        and item_covered_by_6662A(i)
        and item_understatement_6662A(i, u)
        and disclosure_requirement_met_6664d3A(i);
}
@source(IRC_S6662A_C, relation = formalizes, coverage = exact, quote = "Subsection (a) shall be applied by substituting \"30 percent\" for \"20 percent\" with respect to the portion of any reportable transaction understatement with respect to which the requirement of section 6664(d)(3)(A) is not met")
rule S6662AcPenaltyNondisclosed defeasible {
    for i: ReportableTransactionItem;
    for u: Money;
    when item_covered_by_6662A(i)
        and item_understatement_6662A(i, u)
        and not_known(disclosure_requirement_met_6664d3A(i));
    then reportable_transaction_understatement_penalty(i, round(u * NondisclosedReportableTransactionRate, 2, "HALF_UP"));
    unless reportable_understatement_reasonable_cause_defense(i)
        and item_covered_by_6662A(i)
        and item_understatement_6662A(i, u)
        and not_known(disclosure_requirement_met_6664d3A(i));
    unless item_portion_subject_to_6663_penalty(i)
        and item_covered_by_6662A(i)
        and item_understatement_6662A(i, u)
        and not_known(disclosure_requirement_met_6664d3A(i));
    unless item_portion_subject_to_6662_h_or_i_rate(i)
        and item_covered_by_6662A(i)
        and item_understatement_6662A(i, u)
        and not_known(disclosure_requirement_met_6664d3A(i));
}

// --- §6671: rules for application of assessable penalties -------------------------------
relation assessable_penalty_established(f: FailureContext) kind empirical {
    label en official "a penalty or liability provided by subchapter B of chapter 68 has been established with respect to the failure (the upstream section-specific relation)";
}
relation penalty_paid_on_notice_and_demand(f: FailureContext) kind empirical {
    label en unofficial "the penalty has been paid upon notice and demand";
}
@source(IRC_S6671_A, relation = formalizes, coverage = partial, quote = "The penalties and liabilities provided by this subchapter shall be paid upon notice and demand by the Secretary")
rule Section6671aPayOnNoticeAndDemand strict {
    for f: FailureContext;
    for p: Person;
    when failure_by(f, p) and penalty_notice_and_demand_made(f);
    then duty PayAssessablePenaltyOnNoticeAndDemand {
        bearer p;
        beneficiary Secretary;
        goal achievement {
            condition penalty_paid_on_notice_and_demand(f);
            window [-infinity, infinity];
        };
    };
}
relation secretary_moves_to_assess_penalty_as_tax(f: FailureContext) kind empirical {
    label en unofficial "the Secretary has moved to assess the penalty (exercise fact of the section 6671(a) assessment power)";
}
pub relation penalty_assessed_as_tax(f: FailureContext) kind institutional {
    label en unofficial "the penalty has been assessed in the same manner as a tax";
}
@source(IRC_S6671_A, relation = formalizes, coverage = exact, quote = "shall be assessed and collected in the same manner as taxes")
rule S6671aAssessmentPower strict {
    for f: FailureContext;
    when secretary_moves_to_assess_penalty_as_tax(f);
    then power AssessSubchapterBPenaltyAsTax {
        holder Secretary;
        over f;
        exercise secretary_moves_to_assess_penalty_as_tax(f);
        valid_when assessable_penalty_established(f);
        effect create(penalty_assessed_as_tax(f));
        window [-infinity, infinity];
    };
}
pub relation penalty_reference_to_tax_deemed_to_include(f: FailureContext) kind institutional {
    label en unofficial "any reference in this title to \"tax\" imposed by this title is deemed also to refer to this penalty, except as otherwise provided";
}
@source(IRC_S6671_A, relation = formalizes, coverage = exact, quote = "any reference in this title to \"tax\" imposed by this title shall be deemed also to refer to the penalties and liabilities provided by this subchapter")
rule S6671aTaxReference strict {
    for f: FailureContext;
    when assessable_penalty_established(f);
    then penalty_reference_to_tax_deemed_to_include(f);
}
relation officer_or_employee_of_corporation_under_duty(f: FailureContext, q: Person) kind empirical {
    label en official "an officer or employee of a corporation who as such officer or employee is under a duty to perform the act in respect of which the violation occurs";
}
relation member_or_employee_of_partnership_under_duty(f: FailureContext, q: Person) kind empirical {
    label en official "a member or employee of a partnership who as such member or employee is under a duty to perform the act in respect of which the violation occurs";
}
pub relation person_under_6671b(f: FailureContext, q: Person) kind institutional {
    label en official "the term \"person\", as used in subchapter B, includes an officer or employee of a corporation, or a member or employee of a partnership, under a duty to perform the act in respect of which the violation occurs";
}
@source(IRC_S6671_B, relation = formalizes, coverage = exact, quote = "includes an officer or employee of a corporation")
rule S6671bCorporation strict {
    for f: FailureContext;
    for q: Person;
    when officer_or_employee_of_corporation_under_duty(f, q);
    then person_under_6671b(f, q);
}
@source(IRC_S6671_B, relation = formalizes, coverage = exact, quote = "a member or employee of a partnership, who as such officer, employee, or member is under a duty to perform the act in respect of which the violation occurs")
rule S6671bPartnership strict {
    for f: FailureContext;
    for q: Person;
    when member_or_employee_of_partnership_under_duty(f, q);
    then person_under_6671b(f, q);
}

// --- §6673(b): sanctions in other courts --------------------------------------------------
pub entity Section7433Proceeding {
    label en unofficial "a proceeding before a court instituted or maintained by a taxpayer under section 7433";
}
pub entity CourtAward {
    label en unofficial "monetary sanctions, penalties or costs awarded to the United States by a court";
}
relation position_in_7433_proceeding_frivolous_or_groundless(proc: Section7433Proceeding) kind empirical {
    label en official "the taxpayer's position in the proceedings before the court instituted or maintained by such taxpayer under section 7433 is frivolous or groundless";
}
relation court_moves_to_sanction_7433_claim(proc: Section7433Proceeding) kind empirical {
    label en unofficial "the court has moved to require the taxpayer to pay the section 6673(b)(1) penalty (exercise fact of the power)";
}
pub relation sanction_7433_claim_authorized(proc: Section7433Proceeding) kind institutional {
    label en unofficial "the court may require the taxpayer to pay a section 6673(b)(1) penalty (the exact amount is the court's discretionary act, a case fact bounded by the cap)";
}
@source(IRC_S6673_B, relation = formalizes, coverage = exact, quote = "the court may require the taxpayer to pay to the United States a penalty not in excess of $10,000")
rule S6673b1SanctionPower strict {
    for proc: Section7433Proceeding;
    when court_moves_to_sanction_7433_claim(proc);
    then power CourtImposeSection7433FrivolousClaimSanction {
        holder DistrictCourt;
        over proc;
        exercise court_moves_to_sanction_7433_claim(proc);
        valid_when position_in_7433_proceeding_frivolous_or_groundless(proc);
        effect create(sanction_7433_claim_authorized(proc));
        window [-infinity, infinity];
    };
}
relation sanction_7433_claim_amount(proc: Section7433Proceeding, amount: Money) kind empirical {
    label en unofficial "the amount the court actually requires the taxpayer to pay (case fact bounded by the cap)";
}
pub relation sanction_7433_claim_within_cap(proc: Section7433Proceeding) kind institutional {
    label en official "a penalty not in excess of $10,000";
}
@source(IRC_S6673_B, relation = formalizes, coverage = exact, quote = "a penalty not in excess of $10,000")
rule S6673b1WithinCap defeasible {
    for proc: Section7433Proceeding;
    for a: Money;
    when sanction_7433_claim_authorized(proc)
        and sanction_7433_claim_amount(proc, a)
        and a <= round(Section7433FrivolousClaimSanctionCap, 2, "HALF_UP");
    then sanction_7433_claim_within_cap(proc);
}
relation award_in_civil_proceeding_other_than_tax_court_with_united_states(a: CourtAward) kind empirical {
    label en official "a civil proceeding before any court (other than the Tax Court) which is brought by or against the United States in connection with the determination, collection, or refund of any tax, interest, or penalty under this title";
}
relation award_assessable_by_secretary_6673b2(a: CourtAward) kind institutional {
    label en unofficial "the award is one the Secretary may assess under section 6673(b)(2)";
}
@source(IRC_S6673_B, relation = formalizes, coverage = exact, quote = "any monetary sanctions, penalties, or costs awarded by the court to the United States may be assessed by the Secretary")
rule S6673b2Assessable strict {
    for a: CourtAward;
    when award_in_civil_proceeding_other_than_tax_court_with_united_states(a);
    then award_assessable_by_secretary_6673b2(a);
}
relation secretary_moves_to_assess_court_award(a: CourtAward) kind empirical {
    label en unofficial "the Secretary has moved to assess the court award (exercise fact of the power)";
}
pub relation court_award_assessed(a: CourtAward) kind institutional {
    label en unofficial "the court award has been assessed by the Secretary";
}
@source(IRC_S6673_B, relation = formalizes, coverage = exact, quote = "may be assessed by the Secretary")
rule S6673b2AssessmentPower strict {
    for a: CourtAward;
    when secretary_moves_to_assess_court_award(a);
    then power AssessCourtAwardedSanction {
        holder Secretary;
        over a;
        exercise secretary_moves_to_assess_court_award(a);
        valid_when award_assessable_by_secretary_6673b2(a);
        effect create(court_award_assessed(a));
        window [-infinity, infinity];
    };
}
relation notice_and_demand_made_for_award(a: CourtAward) kind empirical {
    label en unofficial "the Secretary has made notice and demand for the awarded amount";
}
pub relation court_award_collectible_as_tax(a: CourtAward) kind institutional {
    label en official "the assessed award may, upon notice and demand, be collected in the same manner as a tax";
}
@source(IRC_S6673_B, relation = formalizes, coverage = exact, quote = "upon notice and demand, may be collected in the same manner as a tax")
rule S6673b2Collectible defeasible {
    for a: CourtAward;
    when court_award_assessed(a)
        and notice_and_demand_made_for_award(a);
    then court_award_collectible_as_tax(a);
}
relation award_by_court_of_appeals_or_supreme_court_on_covered_appeal(a: CourtAward) kind empirical {
    label en official "an order of a United States Court of Appeals or the Supreme Court awarding monetary sanctions, penalties or court costs to the United States in connection with an appeal from a proceeding in the Tax Court or a civil proceeding described in paragraph (2)";
}
relation certified_copy_filed_in_district_court(a: CourtAward) kind empirical {
    label en unofficial "a certified copy of the order has been filed in a district court";
}
pub relation appellate_award_enforceable_as_district_court_judgment(a: CourtAward) kind institutional {
    label en unofficial "the order may be registered in a district court and is enforceable as other district court judgments";
}
@source(IRC_S6673_B, relation = formalizes, coverage = exact, quote = "may be registered in a district court upon filing a certified copy of such order and shall be enforceable as other district court judgments")
rule S6673b3Registration strict {
    for a: CourtAward;
    when award_by_court_of_appeals_or_supreme_court_on_covered_appeal(a)
        and certified_copy_filed_in_district_court(a);
    then appellate_award_enforceable_as_district_court_judgment(a);
}
