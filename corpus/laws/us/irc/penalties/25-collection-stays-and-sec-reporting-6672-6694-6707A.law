language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

use self::{
    FailureContext,
    IRC_S6672_B,
    IRC_S6672_C,
    IRC_S6694_C,
    IRC_S6707A_E,
    Person,
    Secretary,
    WagePayment,
    partial_payment_amount,
    partial_payment_made_on,
    penalty_notice_and_demand_dated,
    refund_claim_for_partial_payment_filed_on,
    stay_cessation_deadline,
    stay_measurement_date,
    suit_begun_within_period,
    trust_fund_recovery_collection_in_jeopardy,
    trust_fund_recovery_notice_and_demand_on,
    trust_fund_recovery_notice_mailed_or_delivered_on,
    trust_fund_recovery_penalty,
};

// 26 U.S.C. §6672(b)(3), (c); §6694(c); §6707A(e) (IRC-16 stage 2, DECISION-0379):
// the collection-stay and limitation provisions that stage 2b left open, and the
// SEC-reporting duty of a person paying a reportable transaction penalty.
//
// The stay of §6672(c) and §6694(c) has the shape of §6703(c) (module 20): a partial
// payment within 30 days of notice and demand plus a refund claim (and for §6672 a
// bond) stays levy and court collection of the remainder; suit must be brought within
// 30 days of denial (for §6694: or, if earlier, 30 days after six months from the
// claim) or the stay ends the next day; an injunction against a levy in breach is
// available; a counterclaim is permitted; the §6502 collection period is suspended.
// §6694(c) reuses the date facts and the earlier-of-two-candidates chain of module 20
// (`stay_cessation_deadline`, `suit_begun_within_period`).
//
// JUDGMENT CALLS AND GAPS:
//  - §6672(c)(1)(A) "the minimum amount required to commence a proceeding in court" is
//    a case fact (the divisible-tax amount for one quarter and employee is not in the
//    text); the bond form and sureties "as the Secretary may by regulations prescribe"
//    is a case fact; only the amount (1½ times the excess) is computed.
//  - §6672(b)(3): the section 6501 period itself belongs to `us.irc.assessment`; the
//    section derives the date before which that period may not expire.
//  - §6707A(e): the deeming sentence ("failure to disclose is treated as a failure to
//    which the (b)(2) penalty applies") is exposed as a relation on the person; it is
//    not wired into the amount rules of module 13, which are keyed by
//    `ReportableTransactionFailure` (TECH-GAPS G3110).

// --- §6672(b)(3): statute of limitations after the preliminary notice ---------------------
relation assessment_period_expiry_date_without_regard_to_6672b3(p: Person, pay: WagePayment, d: Date) kind empirical {
    label en official "the date on which the period provided by section 6501 for the assessment of the penalty would expire, determined without regard to paragraph (3)";
}
relation timely_protest_of_proposed_assessment(p: Person, pay: WagePayment) kind empirical {
    label en official "there is a timely protest of the proposed assessment";
}
relation final_administrative_determination_on_protest_on(p: Person, pay: WagePayment, d: Date) kind empirical {
    label en official "the date on which the Secretary makes a final administrative determination with respect to such protest";
}
relation assessment_period_extension_candidate_6672b3(p: Person, pay: WagePayment, d: Date) kind institutional {
    label en unofficial "a candidate for the date before which the assessment period may not expire: 90 days after the notice, or 30 days after the final determination on a timely protest";
}
@source(IRC_S6672_B, relation = formalizes, coverage = exact, quote = "the date 90 days after the date on which such notice was mailed or delivered in person, or")
rule S6672b3CandidateNotice strict {
    for p: Person;
    for pay: WagePayment;
    for n: Date;
    for x: Date;
    when trust_fund_recovery_notice_mailed_or_delivered_on(p, pay, n)
        and assessment_period_expiry_date_without_regard_to_6672b3(p, pay, x)
        and n <= x;
    then assessment_period_extension_candidate_6672b3(p, pay, add_calendar_period(n, 90 calendar_day));
}
@source(IRC_S6672_B, relation = formalizes, coverage = exact, quote = "if there is a timely protest of the proposed assessment, the date 30 days after the Secretary makes a final administrative determination with respect to such protest")
rule S6672b3CandidateProtest strict {
    for p: Person;
    for pay: WagePayment;
    for n: Date;
    for x: Date;
    for f: Date;
    when trust_fund_recovery_notice_mailed_or_delivered_on(p, pay, n)
        and assessment_period_expiry_date_without_regard_to_6672b3(p, pay, x)
        and n <= x
        and timely_protest_of_proposed_assessment(p, pay)
        and final_administrative_determination_on_protest_on(p, pay, f);
    then assessment_period_extension_candidate_6672b3(p, pay, add_calendar_period(f, 30 calendar_day));
}
relation later_assessment_period_extension_candidate_exists(p: Person, pay: WagePayment, d: Date) kind institutional {
    label en unofficial "a strictly later candidate exists";
}
@source(IRC_S6672_B, relation = formalizes, coverage = exact, quote = "shall not expire before the later of—")
rule S6672b3LaterCandidate strict {
    for p: Person;
    for pay: WagePayment;
    for d: Date;
    for e: Date;
    when assessment_period_extension_candidate_6672b3(p, pay, d)
        and assessment_period_extension_candidate_6672b3(p, pay, e)
        and e > d;
    then later_assessment_period_extension_candidate_exists(p, pay, d);
}
pub relation assessment_period_not_to_expire_before(p: Person, pay: WagePayment, d: Date) kind institutional {
    label en unofficial "the period for assessing the penalty shall not expire before the later of the candidate dates";
}
@source(IRC_S6672_B, relation = formalizes, coverage = exact, quote = "the period provided by such section for the assessment of such penalty shall not expire before the later of—")
rule S6672b3NotExpireBefore strict {
    for p: Person;
    for pay: WagePayment;
    for d: Date;
    when assessment_period_extension_candidate_6672b3(p, pay, d)
        and not_known(later_assessment_period_extension_candidate_exists(p, pay, d));
    then assessment_period_not_to_expire_before(p, pay, d);
}

// --- §6672(c): extension of the period of collection where a bond is filed ----------------------
relation tfrp_payment_made_on(p: Person, pay: WagePayment, d: Date) kind empirical {
    label en unofficial "the day the person pays an amount toward the penalty";
}
relation tfrp_payment_amount(p: Person, pay: WagePayment, amount: Money) kind empirical {
    label en unofficial "the amount paid";
}
relation minimum_amount_required_to_commence_court_proceeding(p: Person, pay: WagePayment, amount: Money) kind empirical {
    label en official "the minimum amount required to commence a proceeding in court with respect to the person's liability for the penalty (case fact)";
}
relation tfrp_refund_claim_filed_on(p: Person, pay: WagePayment, d: Date) kind empirical {
    label en unofficial "the day the person files a claim for refund of the amount so paid";
}
relation tfrp_bond_furnished_on(p: Person, pay: WagePayment, d: Date) kind empirical {
    label en unofficial "the day the person furnishes the bond";
}
relation tfrp_bond_amount(p: Person, pay: WagePayment, amount: Money) kind empirical {
    label en unofficial "the amount of the bond furnished (case fact)";
}
relation tfrp_bond_form_and_sureties_as_prescribed(p: Person, pay: WagePayment) kind empirical {
    label en official "the bond is in such form and with such sureties as the Secretary may by regulations prescribe";
}
relation tfrp_bond_meets_requirements_6672c3(p: Person, pay: WagePayment) kind institutional {
    label en unofficial "the bond meets the requirements of paragraph (3): prescribed form and sureties, and an amount of at least 1½ times the excess of the penalty assessed over the payment";
}
@source(IRC_S6672_C, relation = formalizes, coverage = exact, quote = "shall be in an amount equal to 1½ times the amount of excess of the penalty assessed over the payment described in paragraph (1)")
rule S6672c3BondRequirements defeasible {
    for p: Person;
    for pay: WagePayment;
    for b: Money;
    for a: Money;
    for pen: Money;
    when tfrp_bond_form_and_sureties_as_prescribed(p, pay)
        and tfrp_bond_amount(p, pay, b)
        and tfrp_payment_amount(p, pay, a)
        and trust_fund_recovery_penalty(p, pay, pen)
        and b >= round((pen - a) * TrustFundBondMultiple, 2, "HALF_UP");
    then tfrp_bond_meets_requirements_6672c3(p, pay);
}
relation tfrp_stay_conditions_met(p: Person, pay: WagePayment) kind institutional {
    label en unofficial "within 30 days after notice and demand the person paid at least the minimum amount to commence a court proceeding, filed a refund claim, and furnished a conforming bond";
}
@source(IRC_S6672_C, relation = formalizes, coverage = exact, quote = "If, within 30 days after the day on which notice and demand of any penalty under subsection (a) is made against any person, such person—")
rule S6672c1StayConditions defeasible {
    for p: Person;
    for pay: WagePayment;
    for n: Date;
    for pd: Date;
    for a: Money;
    for m: Money;
    for cd: Date;
    for bd: Date;
    when trust_fund_recovery_notice_and_demand_on(p, pay, n)
        and tfrp_payment_made_on(p, pay, pd)
        and tfrp_payment_amount(p, pay, a)
        and minimum_amount_required_to_commence_court_proceeding(p, pay, m)
        and tfrp_refund_claim_filed_on(p, pay, cd)
        and tfrp_bond_furnished_on(p, pay, bd)
        and tfrp_bond_meets_requirements_6672c3(p, pay)
        and days_between(n, pd) <= 30
        and days_between(n, cd) <= 30
        and days_between(n, bd) <= 30
        and a >= m;
    then tfrp_stay_conditions_met(p, pay);
}
relation tfrp_refund_claim_denied_on(p: Person, pay: WagePayment, d: Date) kind empirical {
    label en unofficial "the day the claim for refund is denied";
}
relation tfrp_suit_begun_on(p: Person, pay: WagePayment, d: Date) kind empirical {
    label en unofficial "the day the person begins a proceeding in the appropriate United States district court (or the Court of Federal Claims) for the determination of his liability";
}
relation tfrp_stay_measurement_date(p: Person, pay: WagePayment, d: Date) kind empirical {
    label en unofficial "the date as of which the collection stay is evaluated (case fact)";
}
relation tfrp_suit_deadline(p: Person, pay: WagePayment, d: Date) kind institutional {
    label en unofficial "the last day on which suit may be begun: 30 days after the denial of the refund claim";
}
@source(IRC_S6672_C, relation = formalizes, coverage = exact, quote = "fails to begin a proceeding in the appropriate United States district court (or in the Court of Federal Claims) for the determination of his liability for such penalty")
rule S6672c2Deadline strict {
    for p: Person;
    for pay: WagePayment;
    for dn: Date;
    when tfrp_refund_claim_denied_on(p, pay, dn);
    then tfrp_suit_deadline(p, pay, add_calendar_period(dn, 30 calendar_day));
}
relation tfrp_suit_begun_within_period(p: Person, pay: WagePayment) kind institutional {
    label en unofficial "the person began the proceeding within the 30-day period";
}
@source(IRC_S6672_C, relation = formalizes, coverage = exact, quote = "If, within 30 days after the day on which his claim for refund with respect to any penalty under subsection (a) is denied")
rule S6672c2SuitTimely strict {
    for p: Person;
    for pay: WagePayment;
    for d: Date;
    for s: Date;
    when tfrp_suit_deadline(p, pay, d)
        and tfrp_suit_begun_on(p, pay, s)
        and s <= d;
    then tfrp_suit_begun_within_period(p, pay);
}
relation tfrp_stay_ceased_6672c2(p: Person, pay: WagePayment) kind institutional {
    label en unofficial "paragraph (1) ceases to apply, effective on the day following the close of the 30-day period";
}
@source(IRC_S6672_C, relation = formalizes, coverage = exact, quote = "paragraph (1) shall cease to apply with respect to such penalty, effective on the day following the close of the 30-day period referred to in this paragraph")
rule S6672c2Cessation strict {
    for p: Person;
    for pay: WagePayment;
    for d: Date;
    for m: Date;
    when tfrp_suit_deadline(p, pay, d)
        and tfrp_stay_measurement_date(p, pay, m)
        and m > d
        and not_known(tfrp_suit_begun_within_period(p, pay));
    then tfrp_stay_ceased_6672c2(p, pay);
}
pub relation tfrp_collection_stay_in_force_6672c1(p: Person, pay: WagePayment) kind institutional {
    label en unofficial "no levy or proceeding in court for the collection of the remainder of the penalty may be made, begun, or prosecuted until a final resolution of the suit";
}
@source(IRC_S6672_C, relation = formalizes, coverage = exact, quote = "no levy or proceeding in court for the collection of the remainder of such penalty shall be made, begun, or prosecuted until a final resolution of a proceeding begun as provided in paragraph (2)")
rule S6672c1StayInForce defeasible {
    for p: Person;
    for pay: WagePayment;
    when tfrp_stay_conditions_met(p, pay);
    then tfrp_collection_stay_in_force_6672c1(p, pay);
    unless tfrp_stay_ceased_6672c2(p, pay)
        and tfrp_stay_conditions_met(p, pay);
    unless trust_fund_recovery_collection_in_jeopardy(p, pay)
        and tfrp_stay_conditions_met(p, pay);
}
relation tfrp_levy_or_collection_proceeding_for_remainder(p: Person, pay: WagePayment) kind empirical {
    label en unofficial "the Secretary makes a levy or begins or prosecutes a proceeding in court for the collection of the remainder of the penalty";
}
@source(IRC_S6672_C, relation = formalizes, coverage = exact, quote = "no levy or proceeding in court for the collection of the remainder of such penalty shall be made, begun, or prosecuted")
rule S6672c1CollectionProhibition defeasible {
    for p: Person;
    for pay: WagePayment;
    when tfrp_collection_stay_in_force_6672c1(p, pay);
    then prohibition SecretaryMayNotCollectTrustFundRemainderDuringStay {
        bearer Secretary;
        action tfrp_levy_or_collection_proceeding_for_remainder(p, pay);
        window [-infinity, infinity];
    };
}
pub relation tfrp_injunction_available(p: Person, pay: WagePayment) kind institutional {
    label en unofficial "notwithstanding section 7421(a), the beginning of a proceeding or levy during the prohibition may be enjoined";
}
@source(IRC_S6672_C, relation = formalizes, coverage = exact, quote = "Notwithstanding the provisions of section 7421(a), the beginning of such proceeding or levy during the time such prohibition is in force may be enjoined by a proceeding in the proper court")
rule S6672c1Injunction defeasible {
    for p: Person;
    for pay: WagePayment;
    when tfrp_collection_stay_in_force_6672c1(p, pay);
    then tfrp_injunction_available(p, pay);
}
pub relation tfrp_counterclaim_permitted(p: Person, pay: WagePayment) kind institutional {
    label en unofficial "a counterclaim for the remainder of the penalty is permitted in the suit";
}
@source(IRC_S6672_C, relation = formalizes, coverage = exact, quote = "Nothing in this paragraph shall be construed to prohibit any counterclaim for the remainder of such penalty in a proceeding begun as provided in paragraph (2)")
rule S6672c1Counterclaim defeasible {
    for p: Person;
    for pay: WagePayment;
    when tfrp_collection_stay_in_force_6672c1(p, pay);
    then tfrp_counterclaim_permitted(p, pay);
}
pub relation tfrp_collection_limitation_suspended_6672c4(p: Person, pay: WagePayment) kind institutional {
    label en unofficial "the running of the section 6502 collection period is suspended while the Secretary is prohibited from collecting (the clock arithmetic belongs to `collection`)";
}
@source(IRC_S6672_C, relation = formalizes, coverage = exact, quote = "The running of the period of limitations provided in section 6502 on the collection by levy or by a proceeding in court in respect of any penalty described in paragraph (1) shall be suspended for the period during which the Secretary is prohibited from collecting by levy or a proceeding in court")
rule S6672c4Suspension defeasible {
    for p: Person;
    for pay: WagePayment;
    when tfrp_collection_stay_in_force_6672c1(p, pay);
    then tfrp_collection_limitation_suspended_6672c4(p, pay);
}

// --- §6694(c): extension of the period of collection where a preparer pays 15 percent -----------
relation preparer_penalty_6694_amount(f: FailureContext, amount: Money) kind empirical {
    label en unofficial "the amount of the section 6694(a) or (b) penalty (case fact)";
}
relation preparer_is_tax_return_preparer(f: FailureContext) kind empirical {
    label en official "the person against whom notice and demand is made is a tax return preparer";
}
relation preparer_partial_payment_stay_conditions_met(f: FailureContext) kind institutional {
    label en unofficial "within 30 days after notice and demand the preparer paid not less than 15 percent of the penalty and filed a claim for refund of the amount paid";
}
@source(IRC_S6694_C, relation = formalizes, coverage = exact, quote = "such person pays an amount which is not less than 15 percent of the amount of such penalty and files a claim for refund of the amount so paid")
rule S6694c1StayConditions defeasible {
    for f: FailureContext;
    for n: Date;
    for pd: Date;
    for cd: Date;
    for a: Money;
    for pen: Money;
    when preparer_is_tax_return_preparer(f)
        and penalty_notice_and_demand_dated(f, n)
        and partial_payment_made_on(f, pd)
        and partial_payment_amount(f, a)
        and refund_claim_for_partial_payment_filed_on(f, cd)
        and preparer_penalty_6694_amount(f, pen)
        and days_between(n, pd) <= 30
        and days_between(n, cd) <= 30
        and a >= round(pen * PreparerPenaltyStayPercent, 2, "HALF_UP");
    then preparer_partial_payment_stay_conditions_met(f);
}
relation preparer_stay_ceased_6694c2(f: FailureContext) kind institutional {
    label en unofficial "paragraph (1) ceases to apply, effective on the day following the close of the applicable 30-day period";
}
@source(IRC_S6694_C, relation = formalizes, coverage = exact, quote = "paragraph (1) shall cease to apply with respect to such penalty, effective on the day following the close of the applicable 30-day period referred to in this paragraph")
rule S6694c2Cessation strict {
    for f: FailureContext;
    for d: Date;
    for m: Date;
    when stay_cessation_deadline(f, d)
        and stay_measurement_date(f, m)
        and m > d
        and not_known(suit_begun_within_period(f));
    then preparer_stay_ceased_6694c2(f);
}
pub relation preparer_collection_stay_in_force_6694c1(f: FailureContext) kind institutional {
    label en unofficial "no levy or proceeding in court for the collection of the remainder of the penalty may be made, begun, or prosecuted until the final resolution of the suit";
}
@source(IRC_S6694_C, relation = formalizes, coverage = exact, quote = "no levy or proceeding in court for the collection of the remainder of such penalty shall be made, begun, or prosecuted until the final resolution of a proceeding begun as provided in paragraph (2)")
rule S6694c1StayInForce defeasible {
    for f: FailureContext;
    when preparer_partial_payment_stay_conditions_met(f);
    then preparer_collection_stay_in_force_6694c1(f);
    unless preparer_stay_ceased_6694c2(f)
        and preparer_partial_payment_stay_conditions_met(f);
}
relation preparer_levy_or_collection_proceeding_for_remainder(f: FailureContext) kind empirical {
    label en unofficial "the Secretary makes a levy or begins or prosecutes a proceeding in court for the collection of the remainder of the penalty";
}
@source(IRC_S6694_C, relation = formalizes, coverage = exact, quote = "no levy or proceeding in court for the collection of the remainder of such penalty shall be made, begun, or prosecuted")
rule S6694c1CollectionProhibition defeasible {
    for f: FailureContext;
    when preparer_collection_stay_in_force_6694c1(f);
    then prohibition SecretaryMayNotCollectPreparerRemainderDuringStay {
        bearer Secretary;
        action preparer_levy_or_collection_proceeding_for_remainder(f);
        window [-infinity, infinity];
    };
}
pub relation preparer_injunction_available(f: FailureContext) kind institutional {
    label en unofficial "notwithstanding section 7421(a), the beginning of a proceeding or levy during the prohibition may be enjoined";
}
@source(IRC_S6694_C, relation = formalizes, coverage = exact, quote = "Notwithstanding the provisions of section 7421(a), the beginning of such proceeding or levy during the time such prohibition is in force may be enjoined by a proceeding in the proper court")
rule S6694c1Injunction defeasible {
    for f: FailureContext;
    when preparer_collection_stay_in_force_6694c1(f);
    then preparer_injunction_available(f);
}
pub relation preparer_counterclaim_permitted(f: FailureContext) kind institutional {
    label en unofficial "a counterclaim for the remainder of the penalty is permitted in the suit";
}
@source(IRC_S6694_C, relation = formalizes, coverage = exact, quote = "Nothing in this paragraph shall be construed to prohibit any counterclaim for the remainder of such penalty in a proceeding begun as provided in paragraph (2)")
rule S6694c1Counterclaim defeasible {
    for f: FailureContext;
    when preparer_collection_stay_in_force_6694c1(f);
    then preparer_counterclaim_permitted(f);
}
pub relation preparer_collection_limitation_suspended_6694c3(f: FailureContext) kind institutional {
    label en unofficial "the running of the section 6502 collection period is suspended while the Secretary is prohibited from collecting";
}
@source(IRC_S6694_C, relation = formalizes, coverage = exact, quote = "The running of the period of limitations provided in section 6502 on the collection by levy or by a proceeding in court in respect of any penalty described in paragraph (1) shall be suspended for the period during which the Secretary is prohibited from collecting by levy or a proceeding in court")
rule S6694c3Suspension defeasible {
    for f: FailureContext;
    when preparer_collection_stay_in_force_6694c1(f);
    then preparer_collection_limitation_suspended_6694c3(f);
}

// --- §6707A(e): penalty reported to the SEC ----------------------------------------------------------
relation required_to_file_periodic_reports_under_exchange_act_13_or_15d(p: Person) kind empirical {
    label en official "the person is required to file periodic reports under section 13 or 15(d) of the Securities Exchange Act of 1934";
}
relation required_to_be_consolidated_for_such_reports(p: Person) kind empirical {
    label en official "the person is required to be consolidated with another person for purposes of such reports";
}
relation required_to_pay_6707A_penalty_on_listed_transaction(p: Person) kind empirical {
    label en official "the person is required to pay a penalty under section 6707A with respect to a listed transaction";
}
relation required_to_pay_6662A_penalty_at_30_percent_rate(p: Person) kind empirical {
    label en official "the person is required to pay a penalty under section 6662A with respect to a reportable transaction at a rate prescribed under section 6662A(c)";
}
relation required_to_pay_6662h_penalty_that_would_have_been_6662A_higher_rate(p: Person) kind empirical {
    label en official "the person is required to pay a penalty under section 6662(h) with respect to a reportable transaction and would (but for section 6662A(e)(2)(B)) have been subject to penalty under section 6662A at a rate prescribed under section 6662A(c)";
}
relation sec_reporter_6707Ae1(p: Person) kind institutional {
    label en unofficial "the person is subject to the SEC-reporting condition of section 6707A(e)(1)";
}
@source(IRC_S6707A_E, relation = formalizes, coverage = exact, quote = "which is required to file periodic reports under section 13 or 15(d) of the Securities Exchange Act of 1934 or is required to be consolidated with another person for purposes of such reports")
rule S6707Ae1Reporter strict {
    for p: Person;
    when required_to_file_periodic_reports_under_exchange_act_13_or_15d(p);
    then sec_reporter_6707Ae1(p);
}
@source(IRC_S6707A_E, relation = formalizes, coverage = exact, quote = "or is required to be consolidated with another person for purposes of such reports")
rule S6707Ae1Consolidated strict {
    for p: Person;
    when required_to_be_consolidated_for_such_reports(p);
    then sec_reporter_6707Ae1(p);
}
relation penalty_disclosure_required_6707Ae2(p: Person) kind institutional {
    label en unofficial "the person is required to pay a section 6707A listed-transaction penalty, a section 6662A penalty at the (c) rate, or a section 6662(h) penalty that would have been at that rate";
}
@source(IRC_S6707A_E, relation = formalizes, coverage = exact, quote = "is required to pay a penalty under this section with respect to a listed transaction")
rule S6707Ae2A strict {
    for p: Person;
    when sec_reporter_6707Ae1(p)
        and required_to_pay_6707A_penalty_on_listed_transaction(p);
    then penalty_disclosure_required_6707Ae2(p);
}
@source(IRC_S6707A_E, relation = formalizes, coverage = exact, quote = "is required to pay a penalty under section 6662A with respect to any reportable transaction at a rate prescribed under section 6662A(c)")
rule S6707Ae2B strict {
    for p: Person;
    when sec_reporter_6707Ae1(p)
        and required_to_pay_6662A_penalty_at_30_percent_rate(p);
    then penalty_disclosure_required_6707Ae2(p);
}
@source(IRC_S6707A_E, relation = formalizes, coverage = exact, quote = "is required to pay a penalty under section 6662(h) with respect to any reportable transaction and would (but for section 6662A(e)(2)(B)) have been subject to penalty under section 6662A at a rate prescribed under section 6662A(c)")
rule S6707Ae2C strict {
    for p: Person;
    when sec_reporter_6707Ae1(p)
        and required_to_pay_6662h_penalty_that_would_have_been_6662A_higher_rate(p);
    then penalty_disclosure_required_6707Ae2(p);
}
relation penalty_disclosed_in_sec_periodic_reports(p: Person) kind empirical {
    label en official "the requirement to pay the penalty has been disclosed in the reports filed for the periods the Secretary specifies";
}
@source(IRC_S6707A_E, relation = formalizes, coverage = exact, quote = "the requirement to pay such penalty shall be disclosed in such reports filed by such person for such periods as the Secretary shall specify")
rule S6707AeDisclosureDuty defeasible {
    for p: Person;
    when penalty_disclosure_required_6707Ae2(p);
    then duty DisclosePenaltyInSecReports {
        bearer p;
        goal achievement {
            condition penalty_disclosed_in_sec_periodic_reports(p);
            window [-infinity, infinity];
        };
    };
}
relation failed_to_disclose_penalty_in_sec_reports(p: Person) kind empirical {
    label en official "the person failed to make the disclosure in accordance with the preceding sentence";
}
pub relation disclosure_failure_treated_as_6707A_b2_failure(p: Person) kind institutional {
    label en unofficial "a failure to make the disclosure is treated as a failure to which the penalty under subsection (b)(2) applies (not wired into the amount rules of module 13, TECH-GAPS G3110)";
}
@source(IRC_S6707A_E, relation = formalizes, coverage = partial, quote = "Failure to make a disclosure in accordance with the preceding sentence shall be treated as a failure to which the penalty under subsection (b)(2) applies")
rule S6707AeFailureTreated strict {
    for p: Person;
    when penalty_disclosure_required_6707Ae2(p)
        and failed_to_disclose_penalty_in_sec_reports(p);
    then disclosure_failure_treated_as_6707A_b2_failure(p);
}
