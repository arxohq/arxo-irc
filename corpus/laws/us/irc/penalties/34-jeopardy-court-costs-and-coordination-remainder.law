language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

use self::{
    FailureContext,
    IRC_S6662A_E,
    IRC_S6664_A,
    IRC_S6673_A,
    IRC_S6677_A,
    IRC_S6701_F,
    IRC_S6707A_E,
    IRC_S6852_B,
    IRC_S6861_C,
    IRC_S6861_D,
    IRC_S6861_E,
    IRC_S6861_F,
    IRC_S6861_G,
    JeopardyAssessment,
    JeopardyAssessmentKind,
    Person,
    PreparerEngagement,
    ReportableTransactionFailure,
    ReportableTransactionItem,
    TaxCourtProceeding,
    TaxKind,
    TaxableYear,
    disclosure_failure_treated_as_6707A_b2_failure,
    failure_by,
    failure_continued_through,
    foreign_trust_notice_penalty_continuation,
    item_of_taxpayer_year,
    item_understatement_6662A,
    jeopardy_assessment_made_on,
    jeopardy_assessment_of,
    reasonable_cause_recognized_6677,
    rebates_made,
    reportable_transaction_failure_of,
    secretary_mailed_notice_of_failure_on,
    section_6048_notice_not_filed_or_incomplete,
    section_6694_penalty_barred_for_document,
    section_6700_penalty_barred_for_document,
    substantial_understatement_of_income_tax,
    understatement_net_of_reduction,
};

// 26 U.S.C. §6861(c)-(g), §6852(b)(2), §6673(a)(2), §6664(a) (rebate), §6677(a) (continuation beyond 12 periods),
// §6701(f)(2)-(3) and §6707A(e) (wiring into the amount rules), §6662A(e)(1) — IRC-16 stage 3 (TECH_GAP reduction,
// 26.09.2026). The stage-2 register named these G3101, G3103, G3104, G3106, G3108, G3110, G3112, G440.
//
// JEOPARDY AFTER A TAX COURT PETITION (§6861(c)-(g)). Dates of the petition, the decision, its finality and a
// petition for review are facts of the case (they are the Tax Court's acts, owner `judicial-proceedings`, not
// imported). (c) is a power of the Secretary to abate an excessive assessment before the decision, a duty to notify
// the Tax Court and the Tax Court's jurisdiction; (d) a ceiling and a prohibition; (e) a prohibition after finality
// or a petition for review; (f) the settlement of the assessment against the determined amount; (g) a power of the
// Secretary to abate when jeopardy does not exist, with its two time limits and the suspension of the limitation
// periods (10 days after the abatement). Section 6852(b)(2) applies (f) and (g) to a political expenditure
// assessment, with the substituted finding: "the requirements of section 6852(a)(1)(B) are not met" in lieu of
// "jeopardy does not exist" (kind Political6852 of module 15).

// --- (c): before the decision of the Tax Court ------------------------------------------------------------------
relation tax_court_petition_filed_for(a: JeopardyAssessment) kind empirical {
    label en official "a petition has been filed with the Tax Court (before the making of the assessment or subsequently)";
}
relation tax_court_decision_rendered_on(a: JeopardyAssessment, d: Date) kind empirical {
    label en official "the decision of the Tax Court is rendered on the date";
}
relation tax_court_decision_final_on(a: JeopardyAssessment, d: Date) kind empirical {
    label en official "the decision of the Tax Court becomes final on the date";
}
relation petition_for_review_filed_on(a: JeopardyAssessment, d: Date) kind empirical {
    label en official "the taxpayer files a petition for review of the decision of the Tax Court on the date";
}
relation secretary_believes_assessment_excessive(a: JeopardyAssessment) kind empirical {
    label en official "the Secretary believes the assessment (or any unpaid portion) to be excessive in amount";
}
relation jeopardy_abatement_on(a: JeopardyAssessment, d: Date) kind empirical {
    label en unofficial "the date on which the Secretary abates the assessment (the exercise date)";
}
relation decision_rendered_on_or_before(a: JeopardyAssessment, d: Date) kind institutional {
    label en unofficial "the decision of the Tax Court has been rendered on or before the date";
}
rule DecisionRenderedOnOrBefore strict {
    for a: JeopardyAssessment;
    for d: Date;
    for r: Date;
    when jeopardy_abatement_on(a, d) and tax_court_decision_rendered_on(a, r) and r <= d;
    then decision_rendered_on_or_before(a, d);
}
pub relation jeopardy_assessment_may_differ_from_notice(a: JeopardyAssessment) kind institutional {
    label en official "the jeopardy assessment may be made in respect of a deficiency greater or less than that notice of which has been mailed, despite section 6212(c), whether or not a petition has been filed (before the decision of the Tax Court is rendered)";
}
@source(IRC_S6861_C, relation = formalizes, coverage = exact, quote = "The jeopardy assessment may be made in respect of a deficiency greater or less than that notice of which has been mailed to the taxpayer, despite the provisions of section 6212(c) prohibiting the determination of additional deficiencies, and whether or not the taxpayer has theretofore filed a petition with the Tax Court.")
rule AssessmentMayDifferFromNotice strict {
    for a: JeopardyAssessment;
    for made: Date;
    when jeopardy_assessment_of(a, _, Deficiency6861) and jeopardy_assessment_made_on(a, made) and not_known(assessment_made_after_decision_6861(a));
    then jeopardy_assessment_may_differ_from_notice(a);
}
relation assessment_made_after_decision_6861(a: JeopardyAssessment) kind institutional {
    label en unofficial "the jeopardy assessment is made after the decision of the Tax Court is rendered";
}
rule AssessmentMadeAfterDecision strict {
    for a: JeopardyAssessment;
    for made: Date;
    for r: Date;
    when jeopardy_assessment_made_on(a, made) and tax_court_decision_rendered_on(a, r) and made >= r;
    then assessment_made_after_decision_6861(a);
}
relation abatement_before_decision_conditions_met(a: JeopardyAssessment) kind institutional {
    label en unofficial "the Secretary believes the assessment excessive and abates it before the decision of the Tax Court is rendered";
}
@source(IRC_S6861_C, relation = formalizes, coverage = exact, quote = "The Secretary may, at any time before the decision of the Tax Court is rendered, abate such assessment, or any unpaid portion thereof, to the extent that he believes the assessment to be excessive in amount.")
rule AbatementBeforeDecisionConditionsMet strict {
    for a: JeopardyAssessment;
    for d: Date;
    when secretary_believes_assessment_excessive(a) and jeopardy_abatement_on(a, d) and not_known(decision_rendered_on_or_before(a, d));
    then abatement_before_decision_conditions_met(a);
}
relation secretary_abates_excessive_assessment(a: JeopardyAssessment) kind empirical {
    label en official "the Secretary abates the assessment, or any unpaid portion, to the extent he believes it to be excessive (the exercise)";
}
pub relation jeopardy_assessment_abated_as_excessive(a: JeopardyAssessment) kind institutional {
    label en official "the assessment is abated to the extent excessive (the effect of the power)";
}
@source(IRC_S6861_C, relation = formalizes, coverage = exact, quote = "The Secretary may, at any time before the decision of the Tax Court is rendered, abate such assessment, or any unpaid portion thereof, to the extent that he believes the assessment to be excessive in amount.")
rule SecretaryMayAbateExcessiveAssessment defeasible {
    label en official "section 6861(c): the Secretary may abate an excessive assessment at any time before the decision of the Tax Court is rendered";
    for a: JeopardyAssessment;
    when jeopardy_assessment_of(a, _, Deficiency6861);
    then power AbateExcessiveJeopardyAssessment {
        holder us.irc.core::Secretary; over a;
        exercise secretary_abates_excessive_assessment(a);
        valid_when abatement_before_decision_conditions_met(a);
        effect create(jeopardy_assessment_abated_as_excessive(a));
        window [-infinity, infinity];
    };
}
relation secretary_notified_tax_court_of_assessment(a: JeopardyAssessment) kind empirical {
    label en official "the Secretary has notified the Tax Court of the amount of such assessment or abatement";
}
@source(IRC_S6861_C, relation = formalizes, coverage = exact, quote = "The Secretary shall notify the Tax Court of the amount of such assessment, or abatement, if the petition is filed with the Tax Court before the making of the assessment or is subsequently filed")
rule SecretaryMustNotifyTaxCourt defeasible {
    label en official "section 6861(c): the Secretary shall notify the Tax Court of the amount of the assessment or abatement when a petition is filed (no time is named: an open window)";
    for a: JeopardyAssessment;
    when jeopardy_assessment_of(a, _, Deficiency6861) and tax_court_petition_filed_for(a);
    then duty NotifyTaxCourtOfJeopardyAssessmentDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition secretary_notified_tax_court_of_assessment(a);
            window [-infinity, infinity];
        }
    };
}
pub relation tax_court_may_redetermine_entire_amount(a: JeopardyAssessment) kind institutional {
    label en official "the Tax Court has jurisdiction to redetermine the entire amount of the deficiency and of all amounts assessed at the same time in connection therewith";
}
@source(IRC_S6861_C, relation = formalizes, coverage = exact, quote = "the Tax Court shall have jurisdiction to redetermine the entire amount of the deficiency and of all amounts assessed at the same time in connection therewith.")
rule TaxCourtMayRedetermineEntireAmount strict {
    for a: JeopardyAssessment;
    when tax_court_petition_filed_for(a) and jeopardy_assessment_of(a, _, Deficiency6861);
    then tax_court_may_redetermine_entire_amount(a);
}

// --- (d): after the decision ------------------------------------------------------------------------------------
relation jeopardy_assessment_amount(a: JeopardyAssessment, amount: Money) kind empirical {
    label en unofficial "the amount of the jeopardy assessment";
}
relation deficiency_determined_by_tax_court(a: JeopardyAssessment, amount: Money) kind empirical {
    label en official "the deficiency determined by the Tax Court in its decision";
}
pub relation jeopardy_assessment_ceiling_after_decision(a: JeopardyAssessment, amount: Money) kind institutional {
    label en official "an assessment made after the decision of the Tax Court is rendered may be made only in respect of the deficiency determined by the Tax Court";
}
@source(IRC_S6861_D, relation = formalizes, coverage = exact, quote = "such assessment may be made only in respect of the deficiency determined by the Tax Court in its decision.")
rule JeopardyAssessmentCeilingAfterDecision strict {
    for a: JeopardyAssessment;
    for c: Money;
    when assessment_made_after_decision_6861(a) and deficiency_determined_by_tax_court(a, c);
    then jeopardy_assessment_ceiling_after_decision(a, c);
}
relation assessment_exceeds_tax_court_determination(a: JeopardyAssessment) kind institutional {
    label en unofficial "an assessment made after the decision exceeds the deficiency determined by the Tax Court (the prohibited act)";
}
rule AssessmentExceedsTaxCourtDetermination strict {
    for a: JeopardyAssessment;
    for m: Money;
    for c: Money;
    when assessment_made_after_decision_6861(a) and jeopardy_assessment_amount(a, m) and deficiency_determined_by_tax_court(a, c) and m > c;
    then assessment_exceeds_tax_court_determination(a);
}
@source(IRC_S6861_D, relation = formalizes, coverage = exact, quote = "such assessment may be made only in respect of the deficiency determined by the Tax Court in its decision.")
rule SecretaryMayNotAssessAboveTaxCourtDetermination defeasible {
    label en official "section 6861(d): after the decision the Secretary may not assess more than the deficiency the Tax Court determined";
    for a: JeopardyAssessment;
    when assessment_made_after_decision_6861(a);
    then prohibition NoJeopardyAssessmentAboveTaxCourtDetermination {
        bearer us.irc.core::Secretary;
        action assessment_exceeds_tax_court_determination(a);
        window [-infinity, infinity];
    };
}

// --- (e): expiration of the right to assess ----------------------------------------------------------------------
relation assessment_made_after_finality_or_review(a: JeopardyAssessment) kind institutional {
    label en unofficial "a jeopardy assessment is made after the decision of the Tax Court has become final or after the taxpayer has filed a petition for review";
}
@source(IRC_S6861_E, relation = formalizes, coverage = exact, quote = "A jeopardy assessment may not be made after the decision of the Tax Court has become final or after the taxpayer has filed a petition for review of the decision of the Tax Court.")
rule AssessmentAfterFinality strict {
    for a: JeopardyAssessment;
    for made: Date;
    for f: Date;
    when jeopardy_assessment_made_on(a, made) and tax_court_decision_final_on(a, f) and made > f;
    then assessment_made_after_finality_or_review(a);
}
@source(IRC_S6861_E, relation = formalizes, coverage = exact, quote = "A jeopardy assessment may not be made after the decision of the Tax Court has become final or after the taxpayer has filed a petition for review of the decision of the Tax Court.")
rule AssessmentAfterPetitionForReview strict {
    for a: JeopardyAssessment;
    for made: Date;
    for r: Date;
    when jeopardy_assessment_made_on(a, made) and petition_for_review_filed_on(a, r) and made > r;
    then assessment_made_after_finality_or_review(a);
}
@source(IRC_S6861_E, relation = formalizes, coverage = exact, quote = "A jeopardy assessment may not be made after the decision of the Tax Court has become final or after the taxpayer has filed a petition for review of the decision of the Tax Court.")
rule SecretaryMayNotAssessAfterFinality defeasible {
    label en official "section 6861(e): the right to make a jeopardy assessment expires when the decision is final or a petition for review is filed";
    for a: JeopardyAssessment;
    when jeopardy_assessment_of(a, _, Deficiency6861);
    then prohibition NoJeopardyAssessmentAfterFinality {
        bearer us.irc.core::Secretary;
        action assessment_made_after_finality_or_review(a);
        window [-infinity, infinity];
    };
}

// --- (f): collection of unpaid amounts after the final decision ------------------------------------------------------
relation amount_which_should_have_been_assessed(a: JeopardyAssessment, amount: Money) kind empirical {
    label en official "the amount which should have been assessed, determined by a decision of the Tax Court which has become final";
}
relation unpaid_portion_stayed_by_bond(a: JeopardyAssessment, amount: Money) kind empirical {
    label en official "the unpaid portion of the assessment the collection of which has been stayed by bond as provided in section 6863(b)";
}
relation amount_already_collected_on_assessment(a: JeopardyAssessment, amount: Money) kind empirical {
    label en official "the amount already collected on the assessment";
}
relation final_decision_determines_amount(a: JeopardyAssessment) kind institutional {
    label en unofficial "the petition has been filed and the amount which should have been assessed has been determined by a final decision";
}
rule FinalDecisionDeterminesAmount strict {
    for a: JeopardyAssessment;
    for m: Money;
    for f: Date;
    when tax_court_petition_filed_for(a) and amount_which_should_have_been_assessed(a, m) and tax_court_decision_final_on(a, f);
    then final_decision_determines_amount(a);
}
pub relation stayed_portion_collectible_on_notice_and_demand(a: JeopardyAssessment, amount: Money) kind institutional {
    label en official "any unpaid portion, the collection of which has been stayed by bond, shall be collected as part of the tax upon notice and demand (up to what remains of the determined amount)";
}
@source(IRC_S6861_F, relation = formalizes, coverage = exact, quote = "then any unpaid portion, the collection of which has been stayed by bond as provided in section 6863(b) shall be collected as part of the tax upon notice and demand from the Secretary")
rule StayedPortionCollectible strict {
    for a: JeopardyAssessment;
    for det: Money;
    for stayed: Money;
    for collected: Money;
    when final_decision_determines_amount(a) and amount_which_should_have_been_assessed(a, det)
        and unpaid_portion_stayed_by_bond(a, stayed) and amount_already_collected_on_assessment(a, collected);
    then stayed_portion_collectible_on_notice_and_demand(a, min(stayed, max(0.00 USD, det - collected)));
}
pub relation remaining_assessment_abated(a: JeopardyAssessment, amount: Money) kind institutional {
    label en official "any remaining portion of the assessment is abated: the part of the assessment above the amount which should have been assessed";
}
@source(IRC_S6861_F, relation = formalizes, coverage = exact, quote = "and any remaining portion of the assessment shall be abated.")
rule RemainingAssessmentAbated strict {
    for a: JeopardyAssessment;
    for det: Money;
    for m: Money;
    when final_decision_determines_amount(a) and amount_which_should_have_been_assessed(a, det) and jeopardy_assessment_amount(a, m) and m > det;
    then remaining_assessment_abated(a, m - det);
}
pub relation excess_collected_refundable_without_claim(a: JeopardyAssessment, amount: Money) kind institutional {
    label en official "if the amount already collected exceeds the amount which should have been assessed, the excess shall be credited or refunded as provided in section 6402, without the filing of a claim";
}
@source(IRC_S6861_F, relation = formalizes, coverage = exact, quote = "If the amount already collected exceeds the amount determined as the amount which should have been assessed, such excess shall be credited or refunded to the taxpayer as provided in section 6402, without the filing of claim therefor.")
rule ExcessCollectedRefundable strict {
    for a: JeopardyAssessment;
    for det: Money;
    for collected: Money;
    when final_decision_determines_amount(a) and amount_which_should_have_been_assessed(a, det) and amount_already_collected_on_assessment(a, collected) and collected > det;
    then excess_collected_refundable_without_claim(a, collected - det);
}
pub relation additional_amount_assessable_on_notice_and_demand(a: JeopardyAssessment, amount: Money) kind institutional {
    label en official "if the amount which should have been assessed is greater than the amount actually assessed, the difference shall be assessed and collected as part of the tax upon notice and demand";
}
@source(IRC_S6861_F, relation = formalizes, coverage = exact, quote = "If the amount determined as the amount which should have been assessed is greater than the amount actually assessed, then the difference shall be assessed and shall be collected as part of the tax upon notice and demand from the Secretary.")
rule AdditionalAmountAssessable strict {
    for a: JeopardyAssessment;
    for det: Money;
    for m: Money;
    when final_decision_determines_amount(a) and amount_which_should_have_been_assessed(a, det) and jeopardy_assessment_amount(a, m) and det > m;
    then additional_amount_assessable_on_notice_and_demand(a, det - m);
}

// --- (g): abatement if jeopardy does not exist; 6852(b)(2) ------------------------------------------------------------
relation secretary_finds_jeopardy_does_not_exist(a: JeopardyAssessment) kind empirical {
    label en official "the Secretary finds that jeopardy does not exist";
}
relation secretary_finds_6852a1B_requirements_not_met(a: JeopardyAssessment) kind empirical {
    label en official "the Secretary finds that the requirements of section 6852(a)(1)(B) are not met";
}
relation petition_period_expires_on(a: JeopardyAssessment, d: Date) kind empirical {
    label en official "the period for filing a petition with the Tax Court expires on the date";
}
relation jeopardy_assessment_is_political_6852(a: JeopardyAssessment) kind institutional {
    label en unofficial "the assessment was made under section 6852";
}
rule JeopardyAssessmentIsPolitical strict {
    for a: JeopardyAssessment;
    for o: Person;
    when jeopardy_assessment_of(a, o, Political6852);
    then jeopardy_assessment_is_political_6852(a);
}
pub relation secretary_finding_supports_abatement_6861g(a: JeopardyAssessment) kind institutional {
    label en official "the finding that jeopardy does not exist (for a section 6852 assessment: that the requirements of section 6852(a)(1)(B) are not met, in lieu of whether jeopardy exists)";
}
@source(IRC_S6861_G, relation = formalizes, coverage = exact, quote = "The Secretary may abate the jeopardy assessment if he finds that jeopardy does not exist.")
rule FindingSupportsAbatementOrdinary strict {
    for a: JeopardyAssessment;
    when secretary_finds_jeopardy_does_not_exist(a) and not_known(jeopardy_assessment_is_political_6852(a));
    then secretary_finding_supports_abatement_6861g(a);
}
@source(IRC_S6852_B, relation = formalizes, coverage = exact, quote = "except that determinations under section 6861(g) shall be made on the basis of whether the requirements of subsection (a)(1)(B) of this section are met in lieu of whether jeopardy exists.")
rule FindingSupportsAbatementPolitical strict {
    for a: JeopardyAssessment;
    when jeopardy_assessment_of(a, _, Political6852) and secretary_finds_6852a1B_requirements_not_met(a);
    then secretary_finding_supports_abatement_6861g(a);
}
relation abatement_barred_6861g(a: JeopardyAssessment) kind institutional {
    label en unofficial "the abatement is made after a decision of the Tax Court has been rendered or, if no petition is filed, after the period for filing a petition has expired";
}
@source(IRC_S6861_G, relation = formalizes, coverage = exact, quote = "Such abatement may not be made after a decision of the Tax Court in respect of the deficiency has been rendered or, if no petition is filed with the Tax Court, after the expiration of the period for filing such petition.")
rule AbatementBarredAfterDecision strict {
    for a: JeopardyAssessment;
    for d: Date;
    when jeopardy_abatement_on(a, d) and decision_rendered_on_or_before(a, d);
    then abatement_barred_6861g(a);
}
@source(IRC_S6861_G, relation = formalizes, coverage = exact, quote = "Such abatement may not be made after a decision of the Tax Court in respect of the deficiency has been rendered or, if no petition is filed with the Tax Court, after the expiration of the period for filing such petition.")
rule AbatementBarredAfterPetitionPeriod strict {
    for a: JeopardyAssessment;
    for d: Date;
    for e: Date;
    when jeopardy_abatement_on(a, d) and petition_period_expires_on(a, e) and d > e and not_known(tax_court_petition_filed_for(a));
    then abatement_barred_6861g(a);
}
relation abatement_6861g_conditions_met(a: JeopardyAssessment) kind institutional {
    label en unofficial "the Secretary's finding supports the abatement and it is not barred";
}
rule AbatementConditionsMet6861g strict {
    for a: JeopardyAssessment;
    when secretary_finding_supports_abatement_6861g(a) and not_known(abatement_barred_6861g(a));
    then abatement_6861g_conditions_met(a);
}
relation secretary_abates_because_jeopardy_absent(a: JeopardyAssessment) kind empirical {
    label en official "the Secretary abates the jeopardy assessment (the exercise)";
}
pub relation jeopardy_assessment_abated_no_jeopardy(a: JeopardyAssessment) kind institutional {
    label en official "the jeopardy assessment is abated because jeopardy does not exist (the effect of the power)";
}
@source(IRC_S6861_G, relation = formalizes, coverage = exact, quote = "The Secretary may abate the jeopardy assessment if he finds that jeopardy does not exist.")
rule SecretaryMayAbateWhenNoJeopardy defeasible {
    label en official "section 6861(g), applied to section 6852 assessments by section 6852(b)(2): the Secretary may abate when jeopardy does not exist, not after the decision or the expiry of the petition period";
    for a: JeopardyAssessment;
    when jeopardy_assessment_of(a, _, Deficiency6861);
    then power AbateJeopardyAssessmentWhenNoJeopardy {
        holder us.irc.core::Secretary; over a;
        exercise secretary_abates_because_jeopardy_absent(a);
        valid_when abatement_6861g_conditions_met(a);
        effect create(jeopardy_assessment_abated_no_jeopardy(a));
        window [-infinity, infinity];
    };
}
@source(IRC_S6852_B, relation = formalizes, coverage = exact, quote = "The provisions of sections 6851(b), 6861(f), and 6861(g) shall apply with respect to any assessment made under subsection (a)")
rule SecretaryMayAbatePoliticalAssessment defeasible {
    label en official "section 6852(b)(2): section 6861(g) applies to a section 6852 assessment (the finding is the substituted one)";
    for a: JeopardyAssessment;
    when jeopardy_assessment_of(a, _, Political6852);
    then power AbatePoliticalExpenditureAssessment {
        holder us.irc.core::Secretary; over a;
        exercise secretary_abates_because_jeopardy_absent(a);
        valid_when abatement_6861g_conditions_met(a);
        effect create(jeopardy_assessment_abated_no_jeopardy(a));
        window [-infinity, infinity];
    };
}
relation jeopardy_assessment_abated_on_no_jeopardy_twin(a: JeopardyAssessment) kind institutional {
    label en unofficial "a valid abatement under section 6861(g) was made (computational twin of the power's effect)";
}
rule AbatementTwin strict {
    for a: JeopardyAssessment;
    when secretary_abates_because_jeopardy_absent(a) and abatement_6861g_conditions_met(a);
    then jeopardy_assessment_abated_on_no_jeopardy_twin(a);
}
pub relation limitation_suspended_for_abated_jeopardy_assessment(a: JeopardyAssessment, from: Date, to: Date) kind institutional {
    label en official "the limitation period on assessments, levy and proceedings for collection is determined as if the abated jeopardy assessment had not been made, but is in any event suspended from the date of the jeopardy assessment until the expiration of the 10th day after the day the assessment is abated";
}
@source(IRC_S6861_G, relation = formalizes, coverage = exact, quote = "except that the running of such period shall in any event be suspended for the period from the date of such jeopardy assessment until the expiration of the 10th day after the day on which such jeopardy assessment is abated.")
rule LimitationSuspendedForAbatedAssessment strict {
    for a: JeopardyAssessment;
    for made: Date;
    for d: Date;
    when jeopardy_assessment_abated_on_no_jeopardy_twin(a) and jeopardy_assessment_made_on(a, made) and jeopardy_abatement_on(a, d);
    then limitation_suspended_for_abated_jeopardy_assessment(a, made, add_calendar_period(d, 10 calendar_day));
}

// --- §6673(a)(2): counsel's liability for excessive costs ---------------------------------------------------------------
relation attorney_admitted_to_practice(att: Person) kind empirical {
    label en unofficial "the attorney or other person is admitted to practice before the Tax Court";
}
relation attorney_of_case(att: Person, c: TaxCourtProceeding) kind empirical {
    label en unofficial "the attorney or other person appears in the case";
}
pub external judgment relation multiplied_proceedings_unreasonably_and_vexatiously(att: Person, c: TaxCourtProceeding) {
    authority TaxCourt;
    label en official "the attorney or other person has multiplied the proceedings in the case unreasonably and vexatiously";
}
relation excess_costs_reasonably_incurred(c: TaxCourtProceeding, att: Person, amount: Money) kind empirical {
    label en official "the excess costs, expenses, and attorneys' fees reasonably incurred because of such conduct";
}
relation attorney_appears_for_commissioner(att: Person, c: TaxCourtProceeding) kind empirical {
    label en official "the attorney is appearing on behalf of the Commissioner of Internal Revenue";
}
relation tax_court_requires_attorney_to_pay(att: Person, c: TaxCourtProceeding) kind empirical {
    label en official "the Tax Court requires the attorney to pay personally the excess costs, expenses, and attorneys' fees (the exercise)";
}
relation tax_court_requires_united_states_to_pay(att: Person, c: TaxCourtProceeding) kind empirical {
    label en official "the Tax Court requires the United States to pay the excess costs, expenses, and attorneys' fees (the exercise)";
}
relation attorney_conduct_conditions_met(att: Person, c: TaxCourtProceeding) kind institutional {
    label en unofficial "the attorney is admitted to practice before the Tax Court and has multiplied the proceedings unreasonably and vexatiously";
}
rule AttorneyConductConditionsMet strict {
    for att: Person;
    for c: TaxCourtProceeding;
    when attorney_of_case(att, c) and attorney_admitted_to_practice(att) and multiplied_proceedings_unreasonably_and_vexatiously(att, c);
    then attorney_conduct_conditions_met(att, c);
}
relation attorney_for_commissioner_conduct_conditions_met(att: Person, c: TaxCourtProceeding) kind institutional {
    label en unofficial "the conditions of the attorney's conduct hold and the attorney appears for the Commissioner";
}
rule AttorneyForCommissionerConductConditionsMet strict {
    for att: Person;
    for c: TaxCourtProceeding;
    when attorney_conduct_conditions_met(att, c) and attorney_appears_for_commissioner(att, c);
    then attorney_for_commissioner_conduct_conditions_met(att, c);
}
pub relation attorney_liable_for_excess_costs(att: Person, c: TaxCourtProceeding, amount: Money) kind institutional {
    label en official "the attorney or other person shall pay personally the excess costs, expenses, and attorneys' fees reasonably incurred because of such conduct";
}
pub relation united_states_liable_for_excess_costs(att: Person, c: TaxCourtProceeding, amount: Money) kind institutional {
    label en official "the United States shall pay such excess costs, expenses, and attorneys' fees in the same manner as an award by a district court";
}
@source(IRC_S6673_A, relation = formalizes, coverage = exact, quote = "(A) that such attorney or other person pay personally the excess costs, expenses, and attorneys' fees reasonably incurred because of such conduct, or")
rule TaxCourtMayRequireAttorneyToPay defeasible {
    label en official "section 6673(a)(2)(A): the Tax Court may require the attorney to pay personally the excess costs";
    for att: Person;
    for c: TaxCourtProceeding;
    when attorney_of_case(att, c);
    then power RequireAttorneyToPayExcessCosts {
        holder us.irc.core::TaxCourt; over att;
        exercise tax_court_requires_attorney_to_pay(att, c);
        valid_when attorney_conduct_conditions_met(att, c);
        effect create(attorney_requirement_in_effect(att, c));
        window [-infinity, infinity];
    };
}
pub relation attorney_requirement_in_effect(att: Person, c: TaxCourtProceeding) kind institutional {
    label en official "the Tax Court's requirement that the attorney pay is in effect (the effect of the power)";
}
@source(IRC_S6673_A, relation = formalizes, coverage = exact, quote = "(B) if such attorney is appearing on behalf of the Commissioner of Internal Revenue, that the United States pay such excess costs, expenses, and attorneys' fees in the same manner as such an award by a district court.")
rule TaxCourtMayRequireUnitedStatesToPay defeasible {
    label en official "section 6673(a)(2)(B): if the attorney appears for the Commissioner, the Tax Court may require the United States to pay";
    for att: Person;
    for c: TaxCourtProceeding;
    when attorney_of_case(att, c) and attorney_appears_for_commissioner(att, c);
    then power RequireUnitedStatesToPayExcessCosts {
        holder us.irc.core::TaxCourt; over att;
        exercise tax_court_requires_united_states_to_pay(att, c);
        valid_when attorney_for_commissioner_conduct_conditions_met(att, c);
        effect create(united_states_requirement_in_effect(att, c));
        window [-infinity, infinity];
    };
}
pub relation united_states_requirement_in_effect(att: Person, c: TaxCourtProceeding) kind institutional {
    label en official "the Tax Court's requirement that the United States pay is in effect (the effect of the power)";
}
relation attorney_requirement_made(att: Person, c: TaxCourtProceeding) kind institutional {
    label en unofficial "a valid requirement that the attorney pay was made (computational twin of the power's effect)";
}
rule AttorneyRequirementMade strict {
    for att: Person;
    for c: TaxCourtProceeding;
    when tax_court_requires_attorney_to_pay(att, c) and attorney_conduct_conditions_met(att, c);
    then attorney_requirement_made(att, c);
}
rule AttorneyLiableForExcessCosts strict {
    for att: Person;
    for c: TaxCourtProceeding;
    for a: Money;
    when attorney_requirement_made(att, c) and excess_costs_reasonably_incurred(c, att, a);
    then attorney_liable_for_excess_costs(att, c, a);
}
relation united_states_requirement_made(att: Person, c: TaxCourtProceeding) kind institutional {
    label en unofficial "a valid requirement that the United States pay was made (computational twin)";
}
rule UnitedStatesRequirementMade strict {
    for att: Person;
    for c: TaxCourtProceeding;
    when tax_court_requires_united_states_to_pay(att, c) and attorney_for_commissioner_conduct_conditions_met(att, c);
    then united_states_requirement_made(att, c);
}
rule UnitedStatesLiableForExcessCosts strict {
    for att: Person;
    for c: TaxCourtProceeding;
    for a: Money;
    when united_states_requirement_made(att, c) and excess_costs_reasonably_incurred(c, att, a);
    then united_states_liable_for_excess_costs(att, c, a);
}

// --- §6664(a): the rebate ------------------------------------------------------------------------------------------------
entity Repayment {
    label en unofficial "an abatement, credit, refund or other repayment of tax";
}
relation repayment_of(r: Repayment, p: Person, y: TaxableYear, kind: TaxKind) kind empirical {
    label en unofficial "the repayment concerns the taxpayer's tax of the kind for the year";
}
relation repayment_portion_on_rebate_ground(r: Repayment, amount: Money) kind empirical {
    label en official "so much of the abatement, credit, refund or other repayment as was made on the ground that the tax imposed was less than the excess of the amount specified in paragraph (1) over the rebates previously made";
}
pub relation rebate_of_repayment(r: Repayment, amount: Money) kind institutional {
    label en official "a rebate: the portion of the repayment made on the stated ground";
}
@source(IRC_S6664_A, relation = formalizes, coverage = partial, quote = "the term \"rebate\" means so much of an abatement, credit, refund, or other repayment, as was made on the ground that the tax imposed was less than the excess of the amount specified in paragraph (1) over the rebates previously made.")
rule RebateOfRepayment strict {
    for r: Repayment;
    for a: Money;
    when repayment_portion_on_rebate_ground(r, a);
    then rebate_of_repayment(r, a);
}
@source(IRC_S6664_A, relation = formalizes, coverage = partial, quote = "the term \"rebate\" means so much of an abatement, credit, refund, or other repayment, as was made on the ground that the tax imposed was less than the excess of the amount specified in paragraph (1) over the rebates previously made.")
rule RebatesMadeFromRepayments strict {
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for r0: Repayment;
    when repayment_of(r0, p, y, kind) and rebate_of_repayment(r0, _);
    then rebates_made(p, y, kind, sum(collect all a: Money, r: Repayment where repayment_of(r, p, y, kind) and rebate_of_repayment(r, a), empty: 0.00 USD));
}

// --- §6677(a): the continuation penalty beyond the twelfth period -----------------------------------------------------
@source(IRC_S6677_A, relation = formalizes, coverage = exact, quote = "such person shall pay a penalty (in addition to the amount determined under the preceding sentence) of $10,000 for each 30-day period (or fraction thereof) during which such failure continues after the expiration of such 90-day period.")
rule S6677aContinuationBeyondTwelvePeriods defeasible {
    for f: FailureContext;
    for p: Person;
    for m: Date;
    for e: Date;
    when failure_by(f, p)
        and section_6048_notice_not_filed_or_incomplete(f)
        and secretary_mailed_notice_of_failure_on(f, m)
        and failure_continued_through(f, e)
        and days_between(m, e) > 450;
    then foreign_trust_notice_penalty_continuation(f, round(ForeignTrustContinuationPenaltyPerPeriod * div_round((days_between(m, e) - 90) * 1.0, 30.0, 0, "CEILING"), 2, "HALF_UP"));
    unless reasonable_cause_recognized_6677(p, f)
        and failure_by(f, p)
        and section_6048_notice_not_filed_or_incomplete(f)
        and secretary_mailed_notice_of_failure_on(f, m)
        and failure_continued_through(f, e)
        and days_between(m, e) > 450;
}

// --- §6701(f)(2)-(3): the bars wired into the section 6694 and 6700 amount rules ----------------------------------------
relation engagement_relates_to_document(e: PreparerEngagement, doc: FailureContext) kind empirical {
    label en unofficial "the return or claim of the preparer engagement is the document for which a section 6701(a) penalty is assessed";
}
pub relation preparer_engagement_barred_by_6701f2(e: PreparerEngagement) kind institutional {
    label en official "no penalty shall be assessed under subsection (a) or (b) of section 6694 on the person with respect to a document for which a penalty is assessed under section 6701(a)";
}
@source(IRC_S6701_F, relation = formalizes, coverage = exact, quote = "No penalty shall be assessed under subsection (a) or (b) of section 6694 on any person with respect to any document for which a penalty is assessed on such person under subsection (a).")
rule PreparerEngagementBarredBy6701f2 defeasible {
    for e: PreparerEngagement;
    for doc: FailureContext;
    when engagement_relates_to_document(e, doc) and section_6694_penalty_barred_for_document(doc);
    then preparer_engagement_barred_by_6701f2(e);
}
relation activity_relates_to_document(act: FailureContext, doc: FailureContext) kind empirical {
    label en unofficial "the section 6700 activity concerns the document for which a section 6701(a) penalty is assessed";
}
pub relation abusive_shelter_activity_barred_by_6701f3(act: FailureContext) kind institutional {
    label en official "no penalty shall be assessed under section 6700 on the person with respect to a document for which a penalty is assessed under section 6701(a)";
}
@source(IRC_S6701_F, relation = formalizes, coverage = exact, quote = "No penalty shall be assessed under section 6700 on any person with respect to any document for which a penalty is assessed on such person under subsection (a).")
rule AbusiveShelterActivityBarredBy6701f3 defeasible {
    for act: FailureContext;
    for doc: FailureContext;
    when activity_relates_to_document(act, doc) and section_6700_penalty_barred_for_document(doc);
    then abusive_shelter_activity_barred_by_6701f3(act);
}

// --- §6707A(e): the failure to disclose treated as a failure to which (b)(2) applies -----------------------------------
relation sec_disclosure_failure_entity(p: Person, f: ReportableTransactionFailure) kind empirical {
    label en unofficial "the entity that stands for the person's failure to disclose the penalty in the reports filed with the Securities and Exchange Commission";
}
@source(IRC_S6707A_E, relation = formalizes, coverage = exact, quote = "Failure to make a disclosure in accordance with the preceding sentence shall be treated as a failure to which the penalty under subsection (b)(2) applies.")
rule DisclosureFailureIsAReportableTransactionFailure strict {
    for p: Person;
    for f: ReportableTransactionFailure;
    when disclosure_failure_treated_as_6707A_b2_failure(p) and sec_disclosure_failure_entity(p, f);
    then reportable_transaction_failure_of(f, p);
}

// --- §6662A(e)(1): coordination with the substantial understatement test -------------------------------------------------
pub relation aggregate_reportable_transaction_understatements(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the aggregate amount of reportable transaction understatements of the taxpayer for the taxable year";
}
relation has_reportable_transaction_item(p: Person, y: TaxableYear) kind institutional {
    label en unofficial "the taxpayer has at least one reportable transaction item for the year";
}
rule HasReportableTransactionItem defeasible {
    for p: Person;
    for y: TaxableYear;
    for i: ReportableTransactionItem;
    when item_of_taxpayer_year(i, p, y) and item_understatement_6662A(i, _);
    then has_reportable_transaction_item(p, y);
}
@source(IRC_S6662A_E, relation = formalizes, coverage = exact, quote = "the aggregate amount of reportable transaction understatements")
rule AggregateReportableTransactionUnderstatements defeasible {
    for p: Person;
    for y: TaxableYear;
    when has_reportable_transaction_item(p, y);
    then aggregate_reportable_transaction_understatements(p, y, sum(collect all a: Money, i: ReportableTransactionItem where item_of_taxpayer_year(i, p, y) and item_understatement_6662A(i, a), empty: 0.00 USD));
}
pub relation understatement_for_substantial_test(p: Person, y: TaxableYear, kind: TaxKind, amount: Money) kind institutional {
    label en official "the amount of the understatement after being increased by the aggregate reportable transaction understatements, for determining whether it is a substantial understatement under section 6662(d)(1)";
}
@source(IRC_S6662A_E, relation = formalizes, coverage = exact, quote = "the amount of such understatement (determined without regard to this paragraph) shall be increased by the aggregate amount of reportable transaction understatements for purposes of determining whether such understatement is a substantial understatement under section 6662(d)(1), and")
rule UnderstatementForSubstantialTestIncreased defeasible {
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for net: Money;
    for agg: Money;
    when understatement_net_of_reduction(p, y, kind, net) and aggregate_reportable_transaction_understatements(p, y, agg);
    then understatement_for_substantial_test(p, y, kind, net + agg);
}
@source(IRC_S6662A_E, relation = formalizes, coverage = exact, quote = "In the case of an understatement (as defined in section 6662(d)(2))—")
rule UnderstatementForSubstantialTestUnchanged defeasible {
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for net: Money;
    when understatement_net_of_reduction(p, y, kind, net) and not_known(has_reportable_transaction_item(p, y));
    then understatement_for_substantial_test(p, y, kind, net);
}
pub relation substantial_understatement_excess_over_reportable(p: Person, y: TaxableYear, kind: TaxKind, amount: Money) kind institutional {
    label en official "the amount of the substantial understatement (if any) after the increase over the aggregate reportable transaction understatements, on which the section 6662(a) addition applies";
}
@source(IRC_S6662A_E, relation = formalizes, coverage = exact, quote = "the addition to tax under section 6662(a) shall apply only to the excess of the amount of the substantial understatement (if any) after the application of subparagraph (A) over the aggregate amount of reportable transaction understatements.")
rule SubstantialUnderstatementExcessOverReportable defeasible {
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for test_amt: Money;
    for agg: Money;
    when substantial_understatement_of_income_tax(p, y, kind) and understatement_for_substantial_test(p, y, kind, test_amt)
        and aggregate_reportable_transaction_understatements(p, y, agg);
    then substantial_understatement_excess_over_reportable(p, y, kind, max(0.00 USD, test_amt - agg));
}
