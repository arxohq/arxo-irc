language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

use self::{
    FailureContext,
    IRC_S6652_A,
    IRC_S6652_B,
    IRC_S6652_C,
    IRC_S6652_D,
    IRC_S6652_E,
    IRC_S6652_F,
    IRC_S6652_H,
    IRC_S6652_I,
    IRC_S6652_J,
    IRC_S6652_K,
    IRC_S6652_L,
    IRC_S6652_N,
    IRC_S6652_O,
    IRC_S6652_P,
    Person,
    Secretary,
    reasonable_cause_and_no_willful_neglect,
};

// 26 U.S.C. §6652 — Failure to file certain information returns, registration
// statements, etc. (IRC-16 stage 2, DECISION-0379). Every subsection (a)-(p).
//
// MODEL. A failure is an occurrence of `FailureContext` (01-shared.law); the
// person who failed is `failure_by`; the day / statement counters the
// statute multiplies are case facts (`failure_days`, `failure_count`) because
// counting days of a continuing failure is the case's own fact, not a norm of
// this section. Each penalty is a defeasible institutional relation with the
// statute's own reasonable-cause defeater (DECISION-0194 channel, authority
// Secretary): the wording differs by subsection, so two textually distinct
// channels are used — `reasonable_cause_and_no_willful_neglect` (01-shared)
// for (a), (b), (f), (h)-(j), (o), (p) and the last sentence of (k), and the
// new `reasonable_cause_shown` for (c)(5), (d), (e), (l). Subsection (n) has
// NO reasonable-cause clause in the pinned text and none is added.
//
// INDEXING. Section 6652(c)(7) indexes the dollar amounts of paragraphs
// (1)-(3) for returns required to be filed after 2014. Rev. Proc. 2024-40
// sec. 2.54 (2026) and Rev. Proc. 2025-32 sec. 4.53 (2027) are pinned in
// `us.irc.inflation_adjustments`; the datasets carry ONLY those two years
// (2015-2025 and 2028+ are a SOURCE_GAP: MISSING_PARAMETER_VALUE, never the
// statutory base). Paragraph (4) ($20 / $5,000) is not indexed.
// The window of the indexed datasets is legal_time; the statute keys the
// figure to the calendar year in which the RETURN is required to be filed —
// the two coincide in the scenarios but this is an approximation flagged in
// TECH-GAPS G3100.
// Windows of non-indexed amounts start at 2024-01-01, the floor of the
// modelled 2024 base edition; they are NOT enactment dates.
//
// GAPS. The (c)(7)(B) rounding is not recomputed: the published Rev. Proc.
// figure is already rounded (G3100). Gross receipts under (c)(1)(A) and
// gross income of a split-interest trust are case facts (owners: exempt-
// organizations / trusts-estates); the tips tax of (b) is an employment
// computation (typed dependency `unreported_tips_employee_tax`).

// ------------------------------------------------------------------------
// shared vocabulary of the new failure-penalty modules (16-23)
// ------------------------------------------------------------------------
pub relation failure_by(f: FailureContext, p: Person) kind empirical {
    label en unofficial "the person who committed the identified failure (case fact)";
}
pub relation failure_days(f: FailureContext, n: Integer) kind empirical {
    label en unofficial "the number of days during which the failure continues (case fact: the day count of a continuing failure)";
}
pub relation failure_count(f: FailureContext, n: Integer) kind empirical {
    label en unofficial "the number of statements, reports or instances of the failure (case fact)";
}
pub relation penalty_notice_and_demand_made(f: FailureContext) kind empirical {
    label en unofficial "the Secretary has made notice and demand for the penalty";
}
pub external judgment relation reasonable_cause_shown(p: Person, f: FailureContext) {
    authority Secretary;
    label en official "it is shown that such failure is due to reasonable cause";
}


// --- (a): statements of payments aggregating less than $10 ---------------
relation failed_to_file_small_payment_statement(f: FailureContext) kind empirical {
    label en official "a failure to file a statement of a payment to another person required under section 6042(a)(2) or 6044(a)(2) on the date prescribed therefor (determined with regard to any extension of time for filing)";
}
pub relation penalty_6652a(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$1 for each statement not so filed, total for the calendar year not to exceed $1,000";
}
@source(IRC_S6652_A, relation = formalizes, coverage = exact, quote = "$1 for each such statement not so filed, but the total amount imposed on the delinquent person for all such failures during the calendar year shall not exceed $1,000")
rule S6652aSmallPaymentStatementPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and failed_to_file_small_payment_statement(f)
        and failure_count(f, n);
    then penalty_6652a(f, min(round(SmallPaymentStatementPenalty * n, 2, "HALF_UP"), round(SmallPaymentStatementAnnualCap, 2, "HALF_UP")));
    unless reasonable_cause_and_no_willful_neglect(p, f)
        and failure_by(f, p)
        and failed_to_file_small_payment_statement(f)
        and failure_count(f, n);
}

// --- (b): failure to report tips ------------------------------------------
relation employee_failed_to_report_tips(f: FailureContext) kind empirical {
    label en official "failure by an employee to report to his employer on the date and in the manner prescribed therefor any amount of tips required to be so reported by section 6053(a) which are wages or compensation";
}
pub relation unreported_tips_employee_tax(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "PENDING (owner: employment) - the tax imposed by section 3101 or 3201 with respect to the amount of tips the employee failed to report";
}
pub relation penalty_6652b(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "an amount equal to 50 percent of the tax on the unreported tips, in addition to that tax";
}
@source(IRC_S6652_B, relation = formalizes, coverage = exact, quote = "an amount equal to 50 percent of such tax")
rule S6652bUnreportedTipsPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for tax: Money;
    when failure_by(f, p)
        and employee_failed_to_report_tips(f)
        and unreported_tips_employee_tax(f, tax);
    then penalty_6652b(f, round(tax * UnreportedTipsPenaltyRate, 2, "HALF_UP"));
    unless reasonable_cause_and_no_willful_neglect(p, f)
        and failure_by(f, p)
        and employee_failed_to_report_tips(f)
        and unreported_tips_employee_tax(f, tax);
}

// --- (c)(1): annual returns of exempt and political organizations ---------
relation failed_to_file_exempt_org_return(f: FailureContext) kind empirical {
    label en official "a failure to file a return required under section 6033(a)(1) or section 6012(a)(6) on the date and in the manner prescribed therefor (determined with regard to any extension of time for filing)";
}
relation failed_to_include_correct_exempt_org_return_information(f: FailureContext) kind empirical {
    label en official "a failure to include any of the information required to be shown on a return filed under section 6033(a)(1) or section 6012(a)(6) or to show the correct information";
}
relation exempt_org_annual_return_failure(f: FailureContext) kind institutional {
    label en unofficial "a section 6652(c)(1)(A)(i) or (ii) failure: the return was not filed, or omits or misstates required information";
}
@source(IRC_S6652_C, relation = formalizes, coverage = partial, quote = "a failure to file a return required under section 6033(a)(1)")
rule S6652c1AFailureToFile strict {
    for f: FailureContext;
    when failed_to_file_exempt_org_return(f);
    then exempt_org_annual_return_failure(f);
}
@source(IRC_S6652_C, relation = formalizes, coverage = partial, quote = "a failure to include any of the information required to be shown on a return filed under section 6033(a)(1) or section 6012(a)(6) or to show the correct information")
rule S6652c1AFailureToShowInformation strict {
    for f: FailureContext;
    when failed_to_include_correct_exempt_org_return_information(f);
    then exempt_org_annual_return_failure(f);
}
relation organization_gross_receipts_for_year(f: FailureContext, amount: Money) kind empirical {
    label en unofficial "the gross receipts of the organization for the year (case fact; owner of exempt-organization receipts: exempt-organizations)";
}
relation notice_required_under_6033i(f: FailureContext) kind empirical {
    label en official "the failure relates to a notice required under section 6033(i)";
}
pub relation penalty_6652c1A(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "there shall be paid by the exempt organization the section 6652(c)(1)(A) daily amount for each day during which the failure continues, subject to the maximum";
}
@source(IRC_S6652_C, relation = formalizes, coverage = exact, quote = "there shall be paid by the exempt organization $20 for each day during which such failure continues. The maximum penalty under this subparagraph on failures with respect to any 1 return shall not exceed the lesser of $10,000 or 5 percent of the gross receipts of the organization for the year")
rule S6652c1AOrdinaryOrganizationPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for days: Integer;
    for gross: Money;
    when failure_by(f, p)
        and exempt_org_annual_return_failure(f)
        and failure_days(f, days)
        and organization_gross_receipts_for_year(f, gross)
        and gross <= round(ExemptOrgLargeReceiptsThreshold, 2, "HALF_UP");
    then penalty_6652c1A(f, min(round(ExemptOrgDailyPenalty * days, 2, "HALF_UP"), min(round(ExemptOrgMaxPenalty, 2, "HALF_UP"), round(gross * ExemptOrgGrossReceiptsCapRate, 2, "HALF_UP"))));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and exempt_org_annual_return_failure(f)
        and failure_days(f, days)
        and organization_gross_receipts_for_year(f, gross)
        and gross <= round(ExemptOrgLargeReceiptsThreshold, 2, "HALF_UP");
    unless notice_required_under_6033i(f)
        and failure_by(f, p)
        and exempt_org_annual_return_failure(f)
        and failure_days(f, days)
        and organization_gross_receipts_for_year(f, gross)
        and gross <= round(ExemptOrgLargeReceiptsThreshold, 2, "HALF_UP");
}
@source(IRC_S6652_C, relation = formalizes, coverage = exact, quote = "In the case of an organization having gross receipts exceeding $1,000,000 for any year, with respect to the return required under section 6033(a)(1) or section 6012(a)(6) for such year, in applying the first sentence of this subparagraph, the amount of the penalty for each day during which a failure continues shall be $100 in lieu of the amount otherwise specified")
rule S6652c1ALargeOrganizationPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for days: Integer;
    for gross: Money;
    when failure_by(f, p)
        and exempt_org_annual_return_failure(f)
        and failure_days(f, days)
        and organization_gross_receipts_for_year(f, gross)
        and gross > round(ExemptOrgLargeReceiptsThreshold, 2, "HALF_UP");
    then penalty_6652c1A(f, min(round(ExemptOrgLargeDailyPenalty * days, 2, "HALF_UP"), round(ExemptOrgLargeMaxPenalty, 2, "HALF_UP")));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and exempt_org_annual_return_failure(f)
        and failure_days(f, days)
        and organization_gross_receipts_for_year(f, gross)
        and gross > round(ExemptOrgLargeReceiptsThreshold, 2, "HALF_UP");
    unless notice_required_under_6033i(f)
        and failure_by(f, p)
        and exempt_org_annual_return_failure(f)
        and failure_days(f, days)
        and organization_gross_receipts_for_year(f, gross)
        and gross > round(ExemptOrgLargeReceiptsThreshold, 2, "HALF_UP");
}
pub relation written_demand_made_6652c1B(f: FailureContext) kind institutional {
    label en unofficial "a written demand under section 6652(c)(1)(B)(i) specifying a reasonable future date by which the return shall be filed (or the information furnished)";
}
relation secretary_moves_to_demand_c1B(f: FailureContext) kind empirical {
    label en unofficial "the Secretary has moved to make the section 6652(c)(1)(B)(i) written demand (exercise fact of the power)";
}
relation subject_to_penalty_c1B(f: FailureContext) kind institutional {
    label en unofficial "the person or organization is subject to the penalty of the preceding subparagraph (single atom for the demand power valid_when)";
}
@source(IRC_S6652_C, relation = formalizes, coverage = partial, quote = "The Secretary may make a written demand on any organization subject to penalty under subparagraph (A) specifying therein a reasonable future date by which the return shall be filed (or the information furnished) for purposes of this subparagraph")
rule S6652c1BSubjectToPenalty defeasible {
    for f: FailureContext;
    for amount: Money;
    when penalty_6652c1A(f, amount);
    then subject_to_penalty_c1B(f);
}
@source(IRC_S6652_C, relation = formalizes, coverage = exact, quote = "The Secretary may make a written demand on any organization subject to penalty under subparagraph (A) specifying therein a reasonable future date by which the return shall be filed (or the information furnished) for purposes of this subparagraph")
rule S6652c1BDemandPower strict {
    for f: FailureContext;
    when secretary_moves_to_demand_c1B(f);
    then power SecretaryDemandFilingc1B {
        holder Secretary;
        over f;
        exercise secretary_moves_to_demand_c1B(f);
        valid_when subject_to_penalty_c1B(f);
        effect create(written_demand_made_6652c1B(f));
        window [-infinity, infinity];
    };
}
relation failure_days_after_demand_date(f: FailureContext, n: Integer) kind empirical {
    label en unofficial "the number of days after the expiration of the time specified in the demand during which the failure continues (case fact)";
}
pub relation penalty_6652c1B(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "there shall be paid by the person failing to so comply the section 6652(c)(1)(B)(ii) daily amount for each day after the specified date, subject to the maximum on all persons";
}
@source(IRC_S6652_C, relation = formalizes, coverage = exact, quote = "there shall be paid by the person failing to so comply $10 for each day after the expiration of the time specified in such demand during which such failure continues. The maximum penalty imposed under this subparagraph on all persons for failures with respect to any 1 return shall not exceed $5,000")
rule S6652c1BManagerPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and written_demand_made_6652c1B(f)
        and failure_days_after_demand_date(f, n);
    then penalty_6652c1B(f, min(round(ExemptOrgManagerDailyPenalty * n, 2, "HALF_UP"), round(ExemptOrgManagerMaxPenalty, 2, "HALF_UP")));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and written_demand_made_6652c1B(f)
        and failure_days_after_demand_date(f, n);
    unless notice_required_under_6033i(f)
        and failure_by(f, p)
        and written_demand_made_6652c1B(f)
        and failure_days_after_demand_date(f, n);
}
relation failed_public_inspection_of_annual_return(f: FailureContext) kind empirical {
    label en official "a failure to comply with the requirements of section 6104(d) with respect to any annual return on the date and in the manner prescribed therefor (determined with regard to any extension of time for filing) or report required under section 527(j)";
}
pub relation penalty_6652c1C(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "there shall be paid by the person failing to meet such requirements the section 6652(c)(1)(C) daily amount for each day during which such failure continues, subject to the maximum";
}
@source(IRC_S6652_C, relation = formalizes, coverage = exact, quote = "there shall be paid by the person failing to meet such requirements $20 for each day during which such failure continues. The maximum penalty imposed under this subparagraph on all persons for failures with respect to any 1 return or report shall not exceed $10,000")
rule S6652c1CPublicInspectionReturnPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and failed_public_inspection_of_annual_return(f)
        and failure_days(f, n);
    then penalty_6652c1C(f, min(round(PublicInspectionReturnDailyPenalty * n, 2, "HALF_UP"), round(PublicInspectionReturnMaxPenalty, 2, "HALF_UP")));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and failed_public_inspection_of_annual_return(f)
        and failure_days(f, n);
    unless notice_required_under_6033i(f)
        and failure_by(f, p)
        and failed_public_inspection_of_annual_return(f)
        and failure_days(f, n);
}
relation failed_public_inspection_of_application_materials(f: FailureContext) kind empirical {
    label en official "a failure to comply with the requirements of section 6104(d) with respect to any exempt status application materials or notice materials on the date and in the manner prescribed therefor";
}
pub relation penalty_6652c1D(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "there shall be paid by the person failing to meet such requirements the section 6652(c)(1)(D) daily amount for each day during which such failure continues (no maximum)";
}
@source(IRC_S6652_C, relation = formalizes, coverage = exact, quote = "there shall be paid by the person failing to meet such requirements $20 for each day during which such failure continues.")
rule S6652c1DPublicInspectionApplicationPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and failed_public_inspection_of_application_materials(f)
        and failure_days(f, n);
    then penalty_6652c1D(f, round(PublicInspectionApplicationDailyPenalty * n, 2, "HALF_UP"));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and failed_public_inspection_of_application_materials(f)
        and failure_days(f, n);
    unless notice_required_under_6033i(f)
        and failure_by(f, p)
        and failed_public_inspection_of_application_materials(f)
        and failure_days(f, n);
}

// --- (c)(2): returns under section 6034 or 6043(b) ------------------------
relation failed_to_file_trust_or_termination_return(f: FailureContext) kind empirical {
    label en official "a failure to file a return required under section 6034 or section 6043(b) on the date and in the manner prescribed therefor (determined with regard to any extension of time for filing)";
}
relation trust_is_split_interest_trust_required_to_file_6034a(f: FailureContext) kind empirical {
    label en official "the trust is required to file a return under section 6034(a) (split-interest trust)";
}
pub relation penalty_6652c2A(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "there shall be paid by the exempt organization or trust failing so to file the section 6652(c)(2)(A) daily amount for each day, subject to the maximum for any 1 return";
}
@source(IRC_S6652_C, relation = formalizes, coverage = exact, quote = "there shall be paid by the exempt organization or trust failing so to file $10 for each day during which such failure continues, but the total amount imposed under this subparagraph on any organization or trust for failure to file any 1 return shall not exceed $5,000")
rule S6652c2AReturnPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and failed_to_file_trust_or_termination_return(f)
        and failure_days(f, n);
    then penalty_6652c2A(f, min(round(TrustReturnDailyPenalty * n, 2, "HALF_UP"), round(TrustReturnMaxPenalty, 2, "HALF_UP")));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and failed_to_file_trust_or_termination_return(f)
        and failure_days(f, n);
    unless trust_is_split_interest_trust_required_to_file_6034a(f)
        and failure_by(f, p)
        and failed_to_file_trust_or_termination_return(f)
        and failure_days(f, n);
}
pub relation written_demand_made_6652c2B(f: FailureContext) kind institutional {
    label en unofficial "a written demand under section 6652(c)(2)(B) specifying a reasonable future date by which the filing shall be made";
}
relation secretary_moves_to_demand_c2B(f: FailureContext) kind empirical {
    label en unofficial "the Secretary has moved to make the section 6652(c)(2)(B) written demand (exercise fact of the power)";
}
relation subject_to_penalty_c2B(f: FailureContext) kind institutional {
    label en unofficial "the person or organization is subject to the penalty of the preceding subparagraph (single atom for the demand power valid_when)";
}
@source(IRC_S6652_C, relation = formalizes, coverage = partial, quote = "The Secretary may make written demand on an organization or trust failing to file under subparagraph (A) specifying therein a reasonable future date by which such filing shall be made for purposes of this subparagraph")
rule S6652c2BSubjectToPenalty defeasible {
    for f: FailureContext;
    for amount: Money;
    when penalty_6652c2A(f, amount);
    then subject_to_penalty_c2B(f);
}
@source(IRC_S6652_C, relation = formalizes, coverage = exact, quote = "The Secretary may make written demand on an organization or trust failing to file under subparagraph (A) specifying therein a reasonable future date by which such filing shall be made for purposes of this subparagraph")
rule S6652c2BDemandPower strict {
    for f: FailureContext;
    when secretary_moves_to_demand_c2B(f);
    then power SecretaryDemandFilingc2B {
        holder Secretary;
        over f;
        exercise secretary_moves_to_demand_c2B(f);
        valid_when subject_to_penalty_c2B(f);
        effect create(written_demand_made_6652c2B(f));
        window [-infinity, infinity];
    };
}
pub relation penalty_6652c2B(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "there shall be paid by the person failing so to file the section 6652(c)(2)(B) daily amount for each day after the specified date, subject to the maximum on all persons";
}
@source(IRC_S6652_C, relation = formalizes, coverage = exact, quote = "If such filing is not made on or before such date, there shall be paid by the person failing so to file $10 for each day after the expiration of the time specified in the written demand during which such failure continues, but the total amount imposed under this subparagraph on all persons for failure to file any 1 return shall not exceed $5,000")
rule S6652c2BManagerPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and written_demand_made_6652c2B(f)
        and failure_days_after_demand_date(f, n);
    then penalty_6652c2B(f, min(round(TrustManagerDailyPenalty * n, 2, "HALF_UP"), round(TrustManagerMaxPenalty, 2, "HALF_UP")));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and written_demand_made_6652c2B(f)
        and failure_days_after_demand_date(f, n);
    unless trust_is_split_interest_trust_required_to_file_6034a(f)
        and failure_by(f, p)
        and written_demand_made_6652c2B(f)
        and failure_days_after_demand_date(f, n);
}
relation trust_gross_income_for_year(f: FailureContext, amount: Money) kind empirical {
    label en unofficial "the gross income of the trust for the year (case fact; owner: trusts-estates)";
}
pub relation penalty_6652c2C(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "for a split-interest trust, the paragraph (1)(A) daily amount applied with the (i)-(iii) modifications";
}
@source(IRC_S6652_C, relation = formalizes, coverage = partial, quote = "In the case of a trust which is required to file a return under section 6034(a), subparagraphs (A) and (B) of this paragraph shall not apply and paragraph (1) shall apply in the same manner as if such return were required under section 6033")
rule S6652c2CSplitInterestTrustPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    for gi: Money;
    when failure_by(f, p)
        and failed_to_file_trust_or_termination_return(f)
        and trust_is_split_interest_trust_required_to_file_6034a(f)
        and failure_days(f, n)
        and trust_gross_income_for_year(f, gi)
        and gi <= round(SplitInterestLargeTrustThreshold, 2, "HALF_UP");
    then penalty_6652c2C(f, min(round(SplitInterestTrustDailyPenalty * n, 2, "HALF_UP"), round(SplitInterestTrustMaxPenalty, 2, "HALF_UP")));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and failed_to_file_trust_or_termination_return(f)
        and trust_is_split_interest_trust_required_to_file_6034a(f)
        and failure_days(f, n)
        and trust_gross_income_for_year(f, gi)
        and gi <= round(SplitInterestLargeTrustThreshold, 2, "HALF_UP");
}
@source(IRC_S6652_C, relation = formalizes, coverage = exact, quote = "in the case of any trust with gross income in excess of $250,000, in applying the first sentence of paragraph (1)(A), the amount of the penalty for each day during which a failure continues shall be $100 in lieu of the amount otherwise specified, and in lieu of applying the second sentence of paragraph (1)(A), the maximum penalty under paragraph (1)(A) shall not exceed $50,000")
rule S6652c2CLargeTrustPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    for gi: Money;
    when failure_by(f, p)
        and failed_to_file_trust_or_termination_return(f)
        and trust_is_split_interest_trust_required_to_file_6034a(f)
        and failure_days(f, n)
        and trust_gross_income_for_year(f, gi)
        and gi > round(SplitInterestLargeTrustThreshold, 2, "HALF_UP");
    then penalty_6652c2C(f, min(round(SplitInterestLargeTrustDailyPenalty * n, 2, "HALF_UP"), round(SplitInterestLargeTrustMaxPenalty, 2, "HALF_UP")));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and failed_to_file_trust_or_termination_return(f)
        and trust_is_split_interest_trust_required_to_file_6034a(f)
        and failure_days(f, n)
        and trust_gross_income_for_year(f, gi)
        and gi > round(SplitInterestLargeTrustThreshold, 2, "HALF_UP");
}
relation person_required_to_file_knowingly_fails_6034a(f: FailureContext, q: Person) kind empirical {
    label en official "the person required to file such return knowingly fails to file the return";
}
pub relation personally_liable_for_split_interest_trust_penalty(f: FailureContext, q: Person) kind institutional {
    label en unofficial "the person required to file the section 6034(a) return who knowingly fails to file is personally liable for the penalty imposed on the trust";
}
@source(IRC_S6652_C, relation = formalizes, coverage = exact, quote = "if the person required to file such return knowingly fails to file the return, such penalty shall also be imposed on such person who shall be personally liable for such penalty")
rule S6652c2CPersonalLiability defeasible {
    for f: FailureContext;
    for q: Person;
    for amount: Money;
    when penalty_6652c2C(f, amount)
        and person_required_to_file_knowingly_fails_6034a(f, q);
    then personally_liable_for_split_interest_trust_penalty(f, q);
}

// --- (c)(3): disclosure under section 6033(a)(2) ---------------------------
relation failed_to_file_6033a2_disclosure(f: FailureContext) kind empirical {
    label en official "a failure to file a disclosure required under section 6033(a)(2)";
}
pub relation penalty_6652c3A(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "there shall be paid by the tax-exempt entity (or entity manager) the section 6652(c)(3)(A) daily amount for each day, subject to the maximum for any 1 disclosure";
}
@source(IRC_S6652_C, relation = formalizes, coverage = exact, quote = "there shall be paid by the tax-exempt entity (the entity manager in the case of a tax-exempt entity described in paragraph (4), (5), (6), or (7) of section 4965(c)) $100 for each day during which such failure continues. The maximum penalty under this subparagraph on failures with respect to any 1 disclosure shall not exceed $50,000")
rule S6652c3ADisclosurePenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and failed_to_file_6033a2_disclosure(f)
        and failure_days(f, n);
    then penalty_6652c3A(f, min(round(DisclosureDailyPenalty * n, 2, "HALF_UP"), round(DisclosureMaxPenalty, 2, "HALF_UP")));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and failed_to_file_6033a2_disclosure(f)
        and failure_days(f, n);
}
pub relation written_demand_made_6652c3B(f: FailureContext) kind institutional {
    label en unofficial "a written demand under section 6652(c)(3)(B)(i) specifying a reasonable future date by which the disclosure shall be filed";
}
relation secretary_moves_to_demand_c3B(f: FailureContext) kind empirical {
    label en unofficial "the Secretary has moved to make the section 6652(c)(3)(B)(i) written demand (exercise fact of the power)";
}
relation subject_to_penalty_c3B(f: FailureContext) kind institutional {
    label en unofficial "the person or organization is subject to the penalty of the preceding subparagraph (single atom for the demand power valid_when)";
}
@source(IRC_S6652_C, relation = formalizes, coverage = partial, quote = "The Secretary may make a written demand on any entity or manager subject to penalty under subparagraph (A) specifying therein a reasonable future date by which the disclosure shall be filed for purposes of this subparagraph")
rule S6652c3BSubjectToPenalty defeasible {
    for f: FailureContext;
    for amount: Money;
    when penalty_6652c3A(f, amount);
    then subject_to_penalty_c3B(f);
}
@source(IRC_S6652_C, relation = formalizes, coverage = exact, quote = "The Secretary may make a written demand on any entity or manager subject to penalty under subparagraph (A) specifying therein a reasonable future date by which the disclosure shall be filed for purposes of this subparagraph")
rule S6652c3BDemandPower strict {
    for f: FailureContext;
    when secretary_moves_to_demand_c3B(f);
    then power SecretaryDemandFilingc3B {
        holder Secretary;
        over f;
        exercise secretary_moves_to_demand_c3B(f);
        valid_when subject_to_penalty_c3B(f);
        effect create(written_demand_made_6652c3B(f));
        window [-infinity, infinity];
    };
}
pub relation penalty_6652c3B(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "there shall be paid by such entity or manager failing to so comply the section 6652(c)(3)(B)(ii) daily amount for each day after the specified date, subject to the maximum on all entities and managers";
}
@source(IRC_S6652_C, relation = formalizes, coverage = exact, quote = "If any entity or manager fails to comply with any demand under clause (i) on or before the date specified in such demand, there shall be paid by such entity or manager failing to so comply $100 for each day after the expiration of the time specified in such demand during which such failure continues. The maximum penalty imposed under this subparagraph on all entities and managers for failures with respect to any 1 disclosure shall not exceed $10,000")
rule S6652c3BDemandPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and written_demand_made_6652c3B(f)
        and failure_days_after_demand_date(f, n);
    then penalty_6652c3B(f, min(round(DisclosureDemandDailyPenalty * n, 2, "HALF_UP"), round(DisclosureDemandMaxPenalty, 2, "HALF_UP")));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and written_demand_made_6652c3B(f)
        and failure_days_after_demand_date(f, n);
}

// --- (c)(4): notices under section 506 -------------------------------------
relation failed_to_submit_section_506_notice(f: FailureContext) kind empirical {
    label en official "a failure to submit a notice required under section 506(a) on the date and in the manner prescribed therefor";
}
pub relation penalty_6652c4A(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "there shall be paid by the organization failing to so submit the section 6652(c)(4)(A) daily amount for each day, subject to the maximum for any one notice";
}
@source(IRC_S6652_C, relation = formalizes, coverage = exact, quote = "there shall be paid by the organization failing to so submit $20 for each day during which such failure continues, but the total amount imposed under this subparagraph on any organization for failure to submit any one notice shall not exceed $5,000")
rule S6652c4ANoticePenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and failed_to_submit_section_506_notice(f)
        and failure_days(f, n);
    then penalty_6652c4A(f, min(round(Notice506DailyPenalty * n, 2, "HALF_UP"), round(Notice506MaxPenalty, 2, "HALF_UP")));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and failed_to_submit_section_506_notice(f)
        and failure_days(f, n);
}
pub relation written_demand_made_6652c4B(f: FailureContext) kind institutional {
    label en unofficial "a written demand under section 6652(c)(4)(B) specifying a reasonable future date by which the notice shall be submitted";
}
relation secretary_moves_to_demand_c4B(f: FailureContext) kind empirical {
    label en unofficial "the Secretary has moved to make the section 6652(c)(4)(B) written demand (exercise fact of the power)";
}
relation subject_to_penalty_c4B(f: FailureContext) kind institutional {
    label en unofficial "the person or organization is subject to the penalty of the preceding subparagraph (single atom for the demand power valid_when)";
}
@source(IRC_S6652_C, relation = formalizes, coverage = partial, quote = "The Secretary may make written demand on an organization subject to penalty under subparagraph (A) specifying in such demand a reasonable future date by which the notice shall be submitted for purposes of this subparagraph")
rule S6652c4BSubjectToPenalty defeasible {
    for f: FailureContext;
    for amount: Money;
    when penalty_6652c4A(f, amount);
    then subject_to_penalty_c4B(f);
}
@source(IRC_S6652_C, relation = formalizes, coverage = exact, quote = "The Secretary may make written demand on an organization subject to penalty under subparagraph (A) specifying in such demand a reasonable future date by which the notice shall be submitted for purposes of this subparagraph")
rule S6652c4BDemandPower strict {
    for f: FailureContext;
    when secretary_moves_to_demand_c4B(f);
    then power SecretaryDemandFilingc4B {
        holder Secretary;
        over f;
        exercise secretary_moves_to_demand_c4B(f);
        valid_when subject_to_penalty_c4B(f);
        effect create(written_demand_made_6652c4B(f));
        window [-infinity, infinity];
    };
}
pub relation penalty_6652c4B(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "there shall be paid by the person failing to so submit the section 6652(c)(4)(B) daily amount for each day after the specified date, subject to the maximum on all persons";
}
@source(IRC_S6652_C, relation = formalizes, coverage = exact, quote = "If such notice is not submitted on or before such date, there shall be paid by the person failing to so submit $20 for each day after the expiration of the time specified in the written demand during which such failure continues, but the total amount imposed under this subparagraph on all persons for failure to submit any one notice shall not exceed $5,000")
rule S6652c4BDemandPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and written_demand_made_6652c4B(f)
        and failure_days_after_demand_date(f, n);
    then penalty_6652c4B(f, min(round(Notice506DemandDailyPenalty * n, 2, "HALF_UP"), round(Notice506DemandMaxPenalty, 2, "HALF_UP")));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and written_demand_made_6652c4B(f)
        and failure_days_after_demand_date(f, n);
}

// --- (c)(6): other special rules -------------------------------------------
relation individual_holds_office_or_employment_of_organization(q: Person) kind empirical {
    label en unofficial "the individual is an officer, director, trustee, employee, or other individual of the organization";
}
relation under_duty_to_perform_act(f: FailureContext, q: Person) kind empirical {
    label en official "the individual is under a duty to perform the act in respect of which the violation occurs";
}
pub relation person_for_section_6652c(f: FailureContext, q: Person) kind institutional {
    label en official "for purposes of subsection (c), the term \"person\" means any officer, director, trustee, employee, or other individual who is under a duty to perform the act in respect of which the violation occurs";
}
@source(IRC_S6652_C, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, the term \"person\" means any officer, director, trustee, employee, or other individual who is under a duty to perform the act in respect of which the violation occurs")
rule S6652c6CPerson strict {
    for f: FailureContext;
    for q: Person;
    when individual_holds_office_or_employment_of_organization(q)
        and under_duty_to_perform_act(f, q);
    then person_for_section_6652c(f, q);
}
relation liable_under_section_6652c(f: FailureContext, q: Person) kind empirical {
    label en unofficial "the person is liable under subsection (c) for the penalty with respect to the failure";
}
pub relation jointly_and_severally_liable_6652c(f: FailureContext, q: Person) kind institutional {
    label en official "all persons liable under subsection (c) with respect to the same failure are jointly and severally liable";
}
@source(IRC_S6652_C, relation = formalizes, coverage = exact, quote = "If more than 1 person is liable under this subsection for any penalty with respect to any failure, all such persons shall be jointly and severally liable with respect to such failure")
rule S6652c6BJointAndSeveral strict {
    for f: FailureContext;
    for q: Person;
    for r: Person;
    when liable_under_section_6652c(f, q)
        and liable_under_section_6652c(f, r)
        and q != r;
    then jointly_and_severally_liable_6652c(f, q);
}

// --- (d): plan registration and notification --------------------------------
relation failed_to_file_plan_registration_statement(f: FailureContext) kind empirical {
    label en official "a failure to file a registration statement required under section 6057(a) which includes all participants required to be included in such statement, on the date prescribed therefor (determined without regard to any extension of time for filing)";
}
relation participants_with_failure_to_file(f: FailureContext, n: Integer) kind empirical {
    label en unofficial "the number of participants with respect to whom there is a failure to file";
}
pub relation penalty_6652d1(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$10 for each participant multiplied by the number of days the failure continues, not to exceed $50,000 for any plan year";
}
@source(IRC_S6652_D, relation = formalizes, coverage = exact, quote = "an amount equal to $10 for each participant with respect to whom there is a failure to file, multiplied by the number of days during which such failure continues, but the total amount imposed under this paragraph on any person for any failure to file with respect to any plan year shall not exceed $50,000")
rule S6652d1RegistrationPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for k: Integer;
    for n: Integer;
    when failure_by(f, p)
        and failed_to_file_plan_registration_statement(f)
        and participants_with_failure_to_file(f, k)
        and failure_days(f, n);
    then penalty_6652d1(f, min(round(PlanRegistrationDailyPenaltyPerParticipant * k * n, 2, "HALF_UP"), round(PlanRegistrationMaxPenalty, 2, "HALF_UP")));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and failed_to_file_plan_registration_statement(f)
        and participants_with_failure_to_file(f, k)
        and failure_days(f, n);
}
relation failed_to_file_plan_status_notification(f: FailureContext) kind empirical {
    label en official "a failure to file a notification required under section 6057(b) on the date prescribed therefor (determined without regard to any extension of time for filing)";
}
pub relation penalty_6652d2(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$10 for each day the failure continues, not to exceed $10,000 for any notification";
}
@source(IRC_S6652_D, relation = formalizes, coverage = exact, quote = "$10 for each day during which such failure continues, but the total amounts imposed under this paragraph on any person for failure to file any notification shall not exceed $10,000")
rule S6652d2NotificationPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and failed_to_file_plan_status_notification(f)
        and failure_days(f, n);
    then penalty_6652d2(f, min(round(PlanStatusNotificationDailyPenalty * n, 2, "HALF_UP"), round(PlanStatusNotificationMaxPenalty, 2, "HALF_UP")));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and failed_to_file_plan_status_notification(f)
        and failure_days(f, n);
}

// --- (e): deferred-compensation and trust returns -----------------------------
relation failed_to_file_deferred_compensation_return(f: FailureContext) kind empirical {
    label en official "failure to file a return or statement required under section 6058, 6047, or 6039D on the date and in the manner prescribed therefor (determined with regard to any extension of time for filing)";
}
relation return_is_information_return_under_6724d1Cii(f: FailureContext) kind empirical {
    label en official "the return or statement is an information return described in section 6724(d)(1)(C)(ii) or a payee statement described in section 6724(d)(2)(AA)";
}
pub relation penalty_6652e(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$250 for each day the failure continues, not to exceed $150,000 for any return";
}
@source(IRC_S6652_E, relation = formalizes, coverage = exact, quote = "$250 for each day during which such failure continues, but the total amount imposed under this subsection on any person for failure to file any return shall not exceed $150,000")
rule S6652eDeferredCompensationPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and failed_to_file_deferred_compensation_return(f)
        and failure_days(f, n);
    then penalty_6652e(f, min(round(DeferredCompReturnDailyPenalty * n, 2, "HALF_UP"), round(DeferredCompReturnMaxPenalty, 2, "HALF_UP")));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and failed_to_file_deferred_compensation_return(f)
        and failure_days(f, n);
    unless return_is_information_return_under_6724d1Cii(f)
        and failure_by(f, p)
        and failed_to_file_deferred_compensation_return(f)
        and failure_days(f, n);
}

// --- (f): returns required under section 6039C --------------------------------
relation failed_to_make_section_6039C_return(f: FailureContext) kind empirical {
    label en official "each failure to make a return required by section 6039C which contains the information required by such section on the date prescribed therefor (determined with regard to any extension of time for filing)";
}
relation us_real_property_interests_fair_market_value(f: FailureContext, amount: Money) kind empirical {
    label en unofficial "the aggregate fair market value of the United States real property interests owned by the person at any time during the year, determined as of the end of the calendar year (or, for property disposed of during the year, as of the date of disposition) (case fact)";
}
pub relation penalty_6652f(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$25 for each day the failure continues, not to exceed the lesser of $25,000 or 5 percent of the aggregate fair market value";
}
@source(IRC_S6652_F, relation = formalizes, coverage = exact, quote = "the amount determined under this paragraph with respect to any failure shall be $25 for each day during which such failure continues.")
rule S6652fSection6039CPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    for fmv: Money;
    when failure_by(f, p)
        and failed_to_make_section_6039C_return(f)
        and failure_days(f, n)
        and us_real_property_interests_fair_market_value(f, fmv);
    then penalty_6652f(f, min(round(Section6039CDailyPenalty * n, 2, "HALF_UP"), min(round(Section6039CAbsoluteCap, 2, "HALF_UP"), round(fmv * Section6039CFairMarketValueCapRate, 2, "HALF_UP"))));
    unless reasonable_cause_and_no_willful_neglect(p, f)
        and failure_by(f, p)
        and failed_to_make_section_6039C_return(f)
        and failure_days(f, n)
        and us_real_property_interests_fair_market_value(f, fmv);
}

// --- (h), (i), (j): notices, explanations and certifications -------------------
relation failed_to_give_pension_distribution_notice(f: FailureContext) kind empirical {
    label en official "each failure to provide notice as required by section 3405(e)(10)(B), at the time prescribed therefor";
}
pub relation penalty_6652h(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$100 for each failure, not to exceed $50,000 for all failures during any calendar year";
}
@source(IRC_S6652_H, relation = formalizes, coverage = exact, quote = "an amount equal to $100 for each such failure, but the total amount imposed on such person for all such failures during any calendar year shall not exceed $50,000")
rule S6652hPensionDistributionNoticePenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and failed_to_give_pension_distribution_notice(f)
        and failure_count(f, n);
    then penalty_6652h(f, min(round(PensionDistributionNoticePenalty * n, 2, "HALF_UP"), round(PensionDistributionNoticeAnnualCap, 2, "HALF_UP")));
    unless reasonable_cause_and_no_willful_neglect(p, f)
        and failure_by(f, p)
        and failed_to_give_pension_distribution_notice(f)
        and failure_count(f, n);
}
relation failed_to_provide_rollover_explanation(f: FailureContext) kind empirical {
    label en official "each failure to provide a written explanation as required by section 402(f), at the time prescribed therefor";
}
pub relation penalty_6652i(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$100 for each failure, not to exceed $50,000 for all failures during any calendar year";
}
@source(IRC_S6652_I, relation = formalizes, coverage = exact, quote = "an amount equal to $100 for each such failure, but the total amount imposed on such person for all such failures during any calendar year shall not exceed $50,000")
rule S6652iRolloverExplanationPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and failed_to_provide_rollover_explanation(f)
        and failure_count(f, n);
    then penalty_6652i(f, min(round(RolloverExplanationPenalty * n, 2, "HALF_UP"), round(RolloverExplanationAnnualCap, 2, "HALF_UP")));
    unless reasonable_cause_and_no_willful_neglect(p, f)
        and failure_by(f, p)
        and failed_to_provide_rollover_explanation(f)
        and failure_count(f, n);
}
relation failed_to_provide_rental_project_certification(f: FailureContext) kind empirical {
    label en official "each failure to provide a certification as required by section 142(d)(7) at the time prescribed therefor";
}
pub relation penalty_6652j(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$100 for each failure";
}
@source(IRC_S6652_J, relation = formalizes, coverage = exact, quote = "an amount equal to $100 for each such failure.")
rule S6652jRentalProjectCertificationPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and failed_to_provide_rental_project_certification(f)
        and failure_count(f, n);
    then penalty_6652j(f, round(RentalProjectCertificationPenalty * n, 2, "HALF_UP"));
    unless reasonable_cause_and_no_willful_neglect(p, f)
        and failure_by(f, p)
        and failed_to_provide_rental_project_certification(f)
        and failure_count(f, n);
}

// --- (k): reports required under section 1202 -----------------------------------
relation failed_to_make_section_1202_report(f: FailureContext) kind empirical {
    label en official "a failure to make a report required under section 1202(d)(1)(C) which contains the information required by such section on the date prescribed therefor (determined with regard to any extension of time for filing)";
}
relation report_covers_number_of_years(f: FailureContext, n: Integer) kind empirical {
    label en unofficial "the number of years covered by the report (case fact)";
}
pub external judgment relation negligence_or_intentional_disregard_of_report(p: Person, f: FailureContext) {
    authority Secretary;
    label en official "any failure due to negligence or intentional disregard";
}
pub relation penalty_6652k(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$50 for each report ($100 in the case of negligence or intentional disregard), multiplied by the number of years covered";
}
@source(IRC_S6652_K, relation = formalizes, coverage = exact, quote = "an amount equal to $50 for each report with respect to which there was such a failure.")
rule S6652kOrdinaryReportPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for yrs: Integer;
    when failure_by(f, p)
        and failed_to_make_section_1202_report(f)
        and report_covers_number_of_years(f, yrs);
    then penalty_6652k(f, round(Section1202ReportPenalty * yrs, 2, "HALF_UP"));
    unless reasonable_cause_and_no_willful_neglect(p, f)
        and failure_by(f, p)
        and failed_to_make_section_1202_report(f)
        and report_covers_number_of_years(f, yrs);
    unless negligence_or_intentional_disregard_of_report(p, f)
        and failure_by(f, p)
        and failed_to_make_section_1202_report(f)
        and report_covers_number_of_years(f, yrs);
}
@source(IRC_S6652_K, relation = formalizes, coverage = exact, quote = "In the case of any failure due to negligence or intentional disregard, the preceding sentence shall be applied by substituting \"$100\" for \"$50\".")
rule S6652kNegligentReportPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for yrs: Integer;
    when failure_by(f, p)
        and failed_to_make_section_1202_report(f)
        and report_covers_number_of_years(f, yrs)
        and negligence_or_intentional_disregard_of_report(p, f);
    then penalty_6652k(f, round(Section1202ReportNegligentPenalty * yrs, 2, "HALF_UP"));
    unless reasonable_cause_and_no_willful_neglect(p, f)
        and failure_by(f, p)
        and failed_to_make_section_1202_report(f)
        and report_covers_number_of_years(f, yrs)
        and negligence_or_intentional_disregard_of_report(p, f);
}

// --- (l): returns for certain corporate transactions -------------------------------
relation failed_to_file_section_6043c_return(f: FailureContext) kind empirical {
    label en official "any failure to make a return required under section 6043(c) containing the information required by such section on the date prescribed therefor (determined with regard to any extension of time for filing)";
}
pub relation penalty_6652l(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$500 for each day the failure continues, not to exceed $100,000 for any return";
}
@source(IRC_S6652_L, relation = formalizes, coverage = exact, quote = "an amount equal to $500 for each day during which such failure continues, but the total amount imposed under this subsection with respect to any return shall not exceed $100,000")
rule S6652lCorporateTransactionReturnPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and failed_to_file_section_6043c_return(f)
        and failure_days(f, n);
    then penalty_6652l(f, min(round(CorporateTransactionReturnDailyPenalty * n, 2, "HALF_UP"), round(CorporateTransactionReturnMaxPenalty, 2, "HALF_UP")));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and failed_to_file_section_6043c_return(f)
        and failure_days(f, n);
}

// --- (n): reports required under sections 3511, 6053(c)(8), 7705 ---------------------
relation failed_to_make_report_under_3511_6053c8_7705(f: FailureContext) kind empirical {
    label en official "a failure to make a report required under section 3511, 6053(c)(8), or 7705 which contains the information required by such section on the date prescribed therefor (determined with regard to any extension of time for filing)";
}
pub relation penalty_6652n(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$50 for each report ($100 in the case of negligence or intentional disregard); the pinned text has no reasonable-cause clause";
}
@source(IRC_S6652_N, relation = formalizes, coverage = exact, quote = "an amount equal to $50 for each report with respect to which there was such a failure.")
rule S6652nOrdinaryReportPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and failed_to_make_report_under_3511_6053c8_7705(f)
        and failure_count(f, n);
    then penalty_6652n(f, round(ReportsUnder3511PenaltyPerReport * n, 2, "HALF_UP"));
    unless negligence_or_intentional_disregard_of_report(p, f)
        and failure_by(f, p)
        and failed_to_make_report_under_3511_6053c8_7705(f)
        and failure_count(f, n);
}
@source(IRC_S6652_N, relation = formalizes, coverage = exact, quote = "In the case of any failure due to negligence or intentional disregard the preceding sentence shall be applied by substituting \"$100\" for \"$50\".")
rule S6652nNegligentReportPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and failed_to_make_report_under_3511_6053c8_7705(f)
        and failure_count(f, n)
        and negligence_or_intentional_disregard_of_report(p, f);
    then penalty_6652n(f, round(ReportsUnder3511NegligentPenalty * n, 2, "HALF_UP"));
}

// --- (o), (p): QSEHRA notices and section 83(i) notices -----------------------------
relation failed_to_provide_qsehra_notice(f: FailureContext) kind empirical {
    label en official "each failure to provide a written notice as required by section 9831(d)(4)";
}
relation qsehra_failure_incident_count(f: FailureContext, n: Integer) kind empirical {
    label en unofficial "the number of employee-incident pairs of failure to provide the notice (case fact: per employee per incident)";
}
pub relation penalty_6652o(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$50 per employee per incident, not to exceed $2,500 for all failures during any calendar year";
}
@source(IRC_S6652_O, relation = formalizes, coverage = exact, quote = "an amount equal to $50 per employee per incident of failure to provide such notice, but the total amount imposed on such person for all such failures during any calendar year shall not exceed $2,500")
rule S6652oQsehraNoticePenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and failed_to_provide_qsehra_notice(f)
        and qsehra_failure_incident_count(f, n);
    then penalty_6652o(f, min(round(QsehraNoticePenaltyPerEmployeeIncident * n, 2, "HALF_UP"), round(QsehraNoticeAnnualCap, 2, "HALF_UP")));
    unless reasonable_cause_and_no_willful_neglect(p, f)
        and failure_by(f, p)
        and failed_to_provide_qsehra_notice(f)
        and qsehra_failure_incident_count(f, n);
}
relation failed_to_provide_section_83i_notice(f: FailureContext) kind empirical {
    label en official "each failure to provide a notice as required by section 83(i)(6), at the time prescribed therefor";
}
pub relation penalty_6652p(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$100 for each failure, not to exceed $50,000 for all failures during any calendar year";
}
@source(IRC_S6652_P, relation = formalizes, coverage = exact, quote = "an amount equal to $100 for each such failure, but the total amount imposed on such person for all such failures during any calendar year shall not exceed $50,000")
rule S6652pSection83iNoticePenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and failed_to_provide_section_83i_notice(f)
        and failure_count(f, n);
    then penalty_6652p(f, min(round(Section83iNoticePenalty * n, 2, "HALF_UP"), round(Section83iNoticeAnnualCap, 2, "HALF_UP")));
    unless reasonable_cause_and_no_willful_neglect(p, f)
        and failure_by(f, p)
        and failed_to_provide_section_83i_notice(f)
        and failure_count(f, n);
}
