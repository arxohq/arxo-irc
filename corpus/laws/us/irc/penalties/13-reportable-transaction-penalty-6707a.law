// 26 U.S.C. §6707A — Penalty for failure to include reportable transaction
// information with return. STAGE 2b, fourth of the seven named `pub`
// targets: `pub reportable_transaction_penalty_6707a`.
//
// JUDGMENT CALLS AND GAPS (see report):
//  - The "natural person" distinction in (b)(2)/(b)(3) is dispatched by
//    Law DSL's own type hierarchy: two rules per bound (one `for p:
//    Individual`, one `for p: Person` with a `not_known(...)` guard that the
//    person is an Individual) rather than a boolean case fact — matching
//    the type system's own subtype machinery instead of inventing a
//    redundant "is_natural_person" predicate.
//  - "the decrease in tax shown on the return as a result of such
//    transaction (or which would have resulted ... if respected)" is a
//    case-asserted `Money` fact (`decrease_in_tax_from_transaction`):
//    computing this decrease would require re-running the ENTIRE tax
//    computation with and without the transaction's claimed treatment —
//    outside this package's scope (EXTERNAL_DEPENDENCY on the substantive
//    computation, whichever chapter the transaction's item belongs to).
//  - (b)(2)/(b)(3)'s cap/floor apply to the SAME transaction regardless of
//    whether it is "listed": the floor always applies; the cap depends on
//    whether the transaction is listed. Modelled as: compute the 75%
//    amount, then clamp it between the applicable floor and the applicable
//    cap (`max(floor, min(cap, seventy_five_percent))`).
//  - (c) definitions ("reportable transaction", "listed transaction") are
//    case-asserted classifications (`is_listed_transaction`); the
//    underlying section 6011 regulatory list-of-transactions determination
//    is an institutional act of the Secretary this package does not derive.
//  - (d) (Commissioner's rescission power, non-listed transactions only) is
//    modelled as a `power`; (d)(2)'s "no judicial appeal" and (d)(3)'s
//    recordkeeping duty are NON_NORMATIVE for this package (no independent
//    computable test).
//  - (e) (SEC-reporting duty for certain issuers, with the cross-reference
//    to sections 6662A(c)/6662(h)) is modelled as a narrow `duty` keyed
//    only to this section's own (b)(2)-rate exposure; the 6662A/6662(h)
//    cross-referenced triggers are NOT modelled (6662A is out of this
//    package's stage-1/2b scope; 6662(h) IS modelled in
//    `07-accuracy-related-penalty-6662.law` but not cross-wired here) —
//    TECH_GAP, TECH-GAPS G496.
//  - (f) (coordination, in addition to any other penalty) is NON_NORMATIVE.

language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

use self::{
    IRC_S6707A_B,
    IRC_S6707A_D,
    IRS,
    Person,
};

pub entity ReportableTransactionFailure {
    label en unofficial "a person's failure to include on a return or statement information with respect to a reportable transaction required under section 6011";
}
relation reportable_transaction_failure_of(f: ReportableTransactionFailure, p: Person) kind institutional {
    label en official "any person who fails to include on any return or statement any information with respect to a reportable transaction which is required under section 6011 to be included with such return or statement";
}
relation is_listed_transaction(f: ReportableTransactionFailure) kind empirical {
    label en official "the term \"listed transaction\" means a reportable transaction which is the same as, or substantially similar to, a transaction specifically identified by the Secretary as a tax avoidance transaction for purposes of section 6011";
}
relation decrease_in_tax_from_transaction(f: ReportableTransactionFailure, amount: Money) kind empirical {
    label en official "75 percent of the decrease in tax shown on the return as a result of such transaction (or which would have resulted from such transaction if such transaction were respected for Federal tax purposes)";
}

pub relation reportable_transaction_penalty_before_bounds(f: ReportableTransactionFailure, amount: Money) kind institutional {
    label en official "the amount of the penalty under subsection (a) with respect to any reportable transaction shall be 75 percent of the decrease in tax shown on the return";
}
@source(IRC_S6707A_B, relation = formalizes, coverage = exact, quote = "the amount of the penalty under subsection (a) with respect to any reportable transaction shall be 75 percent of the decrease in tax shown on the return as a result of such transaction")
rule Section6707aBeforeBounds strict {
    for f: ReportableTransactionFailure;
    for decrease: Money;
    when decrease_in_tax_from_transaction(f, decrease);
    then reportable_transaction_penalty_before_bounds(f, round(decrease * ReportableTransactionPenaltyRate, 2, "HALF_UP"));
}

relation reportable_transaction_person_is_individual(p: Person) kind empirical {
    label en unofficial "the person subject to the section 6707A penalty is a natural person (case-asserted classification, matching the corpus convention of e.g. property-transactions' debtor_is_individual, rather than a runtime Individual-subtype test)";
}
pub relation reportable_transaction_penalty_6707a(f: ReportableTransactionFailure, amount: Money) kind institutional {
    label en unofficial "the section 6707A(a) penalty after the (b)(2) cap and (b)(3) floor (the named `pub` export)";
}
@source(IRC_S6707A_B, relation = formalizes, coverage = exact, quote = "in the case of a listed transaction, $200,000 ($100,000 in the case of a natural person)")
rule Section6707aListedIndividual strict {
    for f: ReportableTransactionFailure;
    for p: Person;
    for before: Money;
    when reportable_transaction_failure_of(f, p)
        and reportable_transaction_person_is_individual(p)
        and is_listed_transaction(f)
        and reportable_transaction_penalty_before_bounds(f, before);
    then reportable_transaction_penalty_6707a(f,
        max(round(ReportableTransactionFloorIndividual, 2, "HALF_UP"), min(round(ReportableTransactionListedCapIndividual, 2, "HALF_UP"), before)));
}
@source(IRC_S6707A_B, relation = formalizes, coverage = exact, quote = "in the case of a listed transaction, $200,000")
rule Section6707aListedNonIndividual strict {
    for f: ReportableTransactionFailure;
    for p: Person;
    for before: Money;
    when reportable_transaction_failure_of(f, p)
        and is_listed_transaction(f)
        and reportable_transaction_penalty_before_bounds(f, before)
        and not_known(reportable_transaction_person_is_individual(p));
    then reportable_transaction_penalty_6707a(f,
        max(round(ReportableTransactionFloor, 2, "HALF_UP"), min(round(ReportableTransactionListedCap, 2, "HALF_UP"), before)));
}
@source(IRC_S6707A_B, relation = formalizes, coverage = exact, quote = "in the case of any other reportable transaction, $50,000 ($10,000 in the case of a natural person)")
rule Section6707aOtherIndividual strict {
    for f: ReportableTransactionFailure;
    for p: Person;
    for before: Money;
    when reportable_transaction_failure_of(f, p)
        and reportable_transaction_person_is_individual(p)
        and not_known(is_listed_transaction(f))
        and reportable_transaction_penalty_before_bounds(f, before);
    then reportable_transaction_penalty_6707a(f,
        max(round(ReportableTransactionFloorIndividual, 2, "HALF_UP"), min(round(ReportableTransactionOtherCapIndividual, 2, "HALF_UP"), before)));
}
@source(IRC_S6707A_B, relation = formalizes, coverage = exact, quote = "in the case of any other reportable transaction, $50,000")
rule Section6707aOtherNonIndividual strict {
    for f: ReportableTransactionFailure;
    for p: Person;
    for before: Money;
    when reportable_transaction_failure_of(f, p)
        and not_known(is_listed_transaction(f))
        and reportable_transaction_penalty_before_bounds(f, before)
        and not_known(reportable_transaction_person_is_individual(p));
    then reportable_transaction_penalty_6707a(f,
        max(round(ReportableTransactionFloor, 2, "HALF_UP"), min(round(ReportableTransactionOtherCap, 2, "HALF_UP"), before)));
}

// --- (d): Commissioner's authority to rescind (non-listed transactions only)

relation rescission_would_promote_compliance(f: ReportableTransactionFailure) kind institutional {
    label en official "rescinding the penalty would promote compliance with the requirements of this title and effective tax administration";
}
pub relation reportable_transaction_rescission_condition_met(f: ReportableTransactionFailure) kind institutional {
    label en unofficial "the section 6707A(d)(1) conditions for rescission are met (single atom for valid_when)";
}
@source(IRC_S6707A_D, relation = formalizes, coverage = exact, quote = "the violation is with respect to a reportable transaction other than a listed transaction")
rule Section6707adRescissionConditionMet strict {
    for f: ReportableTransactionFailure;
    when not_known(is_listed_transaction(f))
        and rescission_would_promote_compliance(f);
    then reportable_transaction_rescission_condition_met(f);
}
relation commissioner_moves_to_rescind(f: ReportableTransactionFailure) kind empirical {
    label en unofficial "the exercise fact of the section 6707A(d) rescission power";
}
pub relation reportable_transaction_penalty_rescinded(f: ReportableTransactionFailure) kind institutional {
    label en unofficial "all or a portion of the section 6707A penalty has been rescinded under section 6707A(d)";
}
@source(IRC_S6707A_D, relation = formalizes, coverage = exact, quote = "The Commissioner of Internal Revenue may rescind all or any portion of any penalty imposed by this section with respect to any violation if")
rule Section6707adRescissionPower strict {
    for f: ReportableTransactionFailure;
    when commissioner_moves_to_rescind(f);
    then power RescindReportableTransactionPenalty {
        holder IRS;
        over f;
        exercise commissioner_moves_to_rescind(f);
        valid_when reportable_transaction_rescission_condition_met(f);
        effect create(reportable_transaction_penalty_rescinded(f));
        window [@2007-01-01, infinity);
    };
}
