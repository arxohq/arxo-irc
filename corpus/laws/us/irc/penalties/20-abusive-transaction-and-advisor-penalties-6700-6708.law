language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

use self::{
    FailureContext,
    IRC_S6700_A,
    IRC_S6700_B,
    IRC_S6700_C,
    IRC_S6701_A,
    IRC_S6701_B,
    IRC_S6701_C,
    IRC_S6701_F,
    IRC_S6703_A,
    IRC_S6703_B,
    IRC_S6703_C,
    IRC_S6704_B,
    IRC_S6705_A,
    IRC_S6705_B,
    IRC_S6706_A,
    IRC_S6706_B,
    IRC_S6706_C,
    IRC_S6707_B,
    IRC_S6707_C,
    IRC_S6708_A,
    IRC_S6708_B,
    IRS,
    Person,
    Return,
    Secretary,
    TaxKind,
    TaxableYear,
    abusive_shelter_activity_barred_by_6701f3,
    days_after_twentieth_business_day_for_penalty,
    deficiency_procedure_would_apply_to_penalty,
    failure_by,
    failure_count,
    frivolous_return_penalty,
    reasonable_cause_and_no_willful_neglect,
    reasonable_cause_shown,
};

// 26 U.S.C. §§6700, 6701, 6703-6708 (IRC-16 stage 2, DECISION-0379).
//
// JUDGMENT CALLS AND GAPS:
//  - §6700(a): "if the person establishes that it is lesser" is a burden-shifting
//    election modelled as an empirical fact (`person_establishes_gross_income_is_lesser`)
//    that the case supplies; the 50-percent branch for (2)(A) statements overrides
//    the $1,000 branch ("Notwithstanding the first sentence"). Each entity or
//    arrangement, and each sale, is a separate activity: an activity is one
//    `FailureContext`.
//  - §6701(b)(3) (one penalty per taxpayer and period) is modelled with an
//    "earlier candidate document" test over an ordering by document date; two
//    documents of the same date are both penalised (TECH-GAPS G3105: the statute
//    leaves the choice of the document open).
//  - §6701(f)(2), (f)(3) coordinate with §6694(a)/(b) and §6700 penalties keyed
//    by other entities (`PreparerEngagement`, activity); the coordination is
//    exposed as relations on the document, not wired into those penalties
//    (TECH-GAPS G3106).
//  - §6703(c): the 15-percent payment stay is a prohibition of the Secretary
//    with the section (c)(2) 30-day cessation computed from the earlier of two
//    candidate dates; (c)(3) suspension of the §6502 period is a relation only
//    (the §6502 clock belongs to `collection`).
//  - §6707: "intentional" is an element (adjudicated empirical relation);
//    §6707(c) incorporates the §6707A(d) rescission power by reference: it is
//    modelled as its own power over this section's penalty with the same
//    conditions (non-listed transaction; promotes compliance).
//  - §6708: the 20th business day is a case fact (`days_after_twentieth_business_day`):
//    counting business days needs the federal holiday calendar of
//    `us.code.federal_holidays`, which exports no `pub` (DECISIONS Д-08,
//    TECH-GAPS G3107). Reasonable cause is applied to the whole failure
//    (the per-day wording is not separated).

// --- §6700: promoting abusive tax shelters, etc. ---------------------------------------------
relation organizes_or_assists_in_organizing_entity_or_arrangement(f: FailureContext) kind empirical {
    label en official "a person organizes (or assists in the organization of) a partnership or other entity, any investment plan or arrangement, or any other plan or arrangement";
}
relation participates_in_sale_of_interest(f: FailureContext) kind empirical {
    label en official "a person participates (directly or indirectly) in the sale of any interest in an entity or plan or arrangement referred to in subparagraph (A)";
}
relation makes_false_or_fraudulent_tax_benefit_statement(f: FailureContext) kind empirical {
    label en official "a person makes or furnishes or causes another person to make or furnish (in connection with such organization or sale) a statement with respect to the allowability of any deduction or credit, the excludability of any income, or the securing of any other tax benefit which the person knows or has reason to know is false or fraudulent as to any material matter";
}
relation makes_gross_valuation_overstatement_as_to_material_matter(f: FailureContext) kind empirical {
    label en official "a person makes or furnishes or causes another person to make or furnish (in connection with such organization or sale) a gross valuation overstatement as to any material matter";
}
relation abusive_shelter_activity(f: FailureContext) kind institutional {
    label en unofficial "an activity described in paragraph (1) (organization or sale participation) accompanied by an (a)(2) statement or gross valuation overstatement";
}
@source(IRC_S6700_A, relation = formalizes, coverage = partial, quote = "organizes (or assists in the organization of)")
rule S6700aActivityOrganizationStatement strict {
    for f: FailureContext;
    when organizes_or_assists_in_organizing_entity_or_arrangement(f)
        and makes_false_or_fraudulent_tax_benefit_statement(f);
    then abusive_shelter_activity(f);
}
@source(IRC_S6700_A, relation = formalizes, coverage = partial, quote = "organizes (or assists in the organization of)")
rule S6700aActivityOrganizationOverstatement strict {
    for f: FailureContext;
    when organizes_or_assists_in_organizing_entity_or_arrangement(f)
        and makes_gross_valuation_overstatement_as_to_material_matter(f);
    then abusive_shelter_activity(f);
}
@source(IRC_S6700_A, relation = formalizes, coverage = partial, quote = "participates (directly or indirectly) in the sale of any interest in an entity or plan or arrangement referred to in subparagraph (A)")
rule S6700aActivitySaleStatement strict {
    for f: FailureContext;
    when participates_in_sale_of_interest(f)
        and makes_false_or_fraudulent_tax_benefit_statement(f);
    then abusive_shelter_activity(f);
}
@source(IRC_S6700_A, relation = formalizes, coverage = partial, quote = "participates (directly or indirectly) in the sale of any interest in an entity or plan or arrangement referred to in subparagraph (A)")
rule S6700aActivitySaleOverstatement strict {
    for f: FailureContext;
    when participates_in_sale_of_interest(f)
        and makes_gross_valuation_overstatement_as_to_material_matter(f);
    then abusive_shelter_activity(f);
}
relation gross_income_derived_from_activity(f: FailureContext, amount: Money) kind empirical {
    label en official "the gross income derived (or to be derived) by such person from such activity (case fact)";
}
relation person_establishes_gross_income_is_lesser(f: FailureContext) kind empirical {
    label en official "the person establishes that the gross income derived is lesser than $1,000";
}
pub relation abusive_shelter_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$1,000 or, if the person establishes it is lesser, 100 percent of the gross income; 50 percent of the gross income for an activity involving a false or fraudulent statement";
}
@source(IRC_S6700_A, relation = formalizes, coverage = partial, quote = "shall pay, with respect to each activity described in paragraph (1), a penalty equal to $1,000")
rule S6700aPenaltyFlat defeasible {
    for f: FailureContext;
    for p: Person;
    when failure_by(f, p)
        and abusive_shelter_activity(f)
        and not_known(makes_false_or_fraudulent_tax_benefit_statement(f))
        and not_known(person_establishes_gross_income_is_lesser(f));
    then abusive_shelter_penalty(f, round(AbusiveShelterPenaltyFlat, 2, "HALF_UP"));
    unless abusive_shelter_activity_barred_by_6701f3(f)
        and failure_by(f, p)
        and abusive_shelter_activity(f)
        and not_known(makes_false_or_fraudulent_tax_benefit_statement(f))
        and not_known(person_establishes_gross_income_is_lesser(f));
}
@source(IRC_S6700_A, relation = formalizes, coverage = partial, quote = "or, if the person establishes that it is lesser, 100 percent of the gross income derived (or to be derived) by such person from such activity")
rule S6700aPenaltyLesserGrossIncome defeasible {
    for f: FailureContext;
    for p: Person;
    for g: Money;
    when failure_by(f, p)
        and abusive_shelter_activity(f)
        and not_known(makes_false_or_fraudulent_tax_benefit_statement(f))
        and person_establishes_gross_income_is_lesser(f)
        and gross_income_derived_from_activity(f, g);
    then abusive_shelter_penalty(f, min(round(AbusiveShelterPenaltyFlat, 2, "HALF_UP"), round(g * AbusiveShelterGrossIncomeRate, 2, "HALF_UP")));
    unless abusive_shelter_activity_barred_by_6701f3(f)
        and failure_by(f, p)
        and abusive_shelter_activity(f)
        and not_known(makes_false_or_fraudulent_tax_benefit_statement(f))
        and person_establishes_gross_income_is_lesser(f)
        and gross_income_derived_from_activity(f, g);
}
@source(IRC_S6700_A, relation = formalizes, coverage = exact, quote = "Notwithstanding the first sentence, if an activity with respect to which a penalty imposed under this subsection involves a statement described in paragraph (2)(A), the amount of the penalty shall be equal to 50 percent of the gross income derived (or to be derived) from such activity by the person on which the penalty is imposed")
rule S6700aPenaltyFalseStatementHalfIncome defeasible {
    for f: FailureContext;
    for p: Person;
    for g: Money;
    when failure_by(f, p)
        and abusive_shelter_activity(f)
        and makes_false_or_fraudulent_tax_benefit_statement(f)
        and gross_income_derived_from_activity(f, g);
    then abusive_shelter_penalty(f, round(g * AbusiveShelterFalseStatementGrossIncomeRate, 2, "HALF_UP"));
    unless abusive_shelter_activity_barred_by_6701f3(f)
        and failure_by(f, p)
        and abusive_shelter_activity(f)
        and makes_false_or_fraudulent_tax_benefit_statement(f)
        and gross_income_derived_from_activity(f, g);
}
relation stated_value_of_property_or_services(f: FailureContext, amount: Money) kind empirical {
    label en unofficial "the value stated for the property or services (case fact)";
}
relation correct_valuation_of_property_or_services(f: FailureContext, amount: Money) kind empirical {
    label en unofficial "the amount determined to be the correct valuation (case fact)";
}
relation value_directly_related_to_participant_deduction_or_credit(f: FailureContext) kind empirical {
    label en official "the value of such property or services is directly related to the amount of any deduction or credit allowable under chapter 1 to any participant";
}
pub relation gross_valuation_overstatement_6700b(f: FailureContext) kind institutional {
    label en official "a statement as to the value of any property or services whose stated value exceeds 200 percent of the correct valuation and is directly related to a participant's deduction or credit";
}
@source(IRC_S6700_B, relation = formalizes, coverage = exact, quote = "the value so stated exceeds 200 percent of the amount determined to be the correct valuation")
rule S6700b1GrossValuationOverstatement strict {
    for f: FailureContext;
    for s: Money;
    for c: Money;
    when stated_value_of_property_or_services(f, s)
        and correct_valuation_of_property_or_services(f, c)
        and s > c * GrossValuationOverstatementRatio
        and value_directly_related_to_participant_deduction_or_credit(f);
    then gross_valuation_overstatement_6700b(f);
}
relation showing_of_reasonable_basis_for_valuation(f: FailureContext) kind empirical {
    label en official "a showing that there was a reasonable basis for the valuation";
}
relation valuation_made_in_good_faith(f: FailureContext) kind empirical {
    label en official "the valuation was made in good faith";
}
relation waiver_conditions_6700b2(f: FailureContext) kind institutional {
    label en unofficial "the section 6700(b)(2) conditions for waiver are met: a reasonable basis for the valuation and good faith (single atom for the power valid_when)";
}
@source(IRC_S6700_B, relation = formalizes, coverage = exact, quote = "on a showing that there was a reasonable basis for the valuation and that such valuation was made in good faith")
rule S6700b2WaiverConditions strict {
    for f: FailureContext;
    when gross_valuation_overstatement_6700b(f)
        and showing_of_reasonable_basis_for_valuation(f)
        and valuation_made_in_good_faith(f);
    then waiver_conditions_6700b2(f);
}
relation secretary_moves_to_waive_6700_penalty(f: FailureContext) kind empirical {
    label en unofficial "the Secretary has moved to waive all or part of the section 6700(a) penalty (exercise fact)";
}
pub relation abusive_shelter_penalty_waived(f: FailureContext) kind institutional {
    label en unofficial "all or part of the section 6700(a) penalty with respect to the gross valuation overstatement has been waived";
}
@source(IRC_S6700_B, relation = formalizes, coverage = exact, quote = "The Secretary may waive all or any part of the penalty provided by subsection (a) with respect to any gross valuation overstatement")
rule S6700b2WaiverPower strict {
    for f: FailureContext;
    when secretary_moves_to_waive_6700_penalty(f);
    then power WaiveAbusiveShelterPenalty {
        holder Secretary;
        over f;
        exercise secretary_moves_to_waive_6700_penalty(f);
        valid_when waiver_conditions_6700b2(f);
        effect create(abusive_shelter_penalty_waived(f));
        window [-infinity, infinity];
    };
}
pub relation section_6700_penalty_in_addition_to_other_penalties(f: FailureContext) kind institutional {
    label en unofficial "the penalty imposed by section 6700 is in addition to any other penalty provided by law";
}
@source(IRC_S6700_C, relation = formalizes, coverage = exact, quote = "The penalty imposed by this section shall be in addition to any other penalty provided by law")
rule S6700cInAddition defeasible {
    for f: FailureContext;
    for a: Money;
    when abusive_shelter_penalty(f, a);
    then section_6700_penalty_in_addition_to_other_penalties(f);
}

// --- §6701: penalties for aiding and abetting understatement of tax liability -------------------
relation aids_or_assists_in_preparation_or_presentation_of_document(f: FailureContext) kind empirical {
    label en official "a person aids or assists in, procures, or advises with respect to, the preparation or presentation of any portion of a return, affidavit, claim, or other document";
}
relation orders_or_causes_subordinate_to_do_act(f: FailureContext) kind empirical {
    label en official "ordering (or otherwise causing) a subordinate to do an act";
}
relation knew_of_and_did_not_attempt_to_prevent_subordinate_participation(f: FailureContext) kind empirical {
    label en official "knowing of, and not attempting to prevent, participation by a subordinate in an act";
}
pub relation person_procures_6701c(f: FailureContext) kind institutional {
    label en unofficial "the person \"procures\": ordering a subordinate to do an act, or knowing of and not attempting to prevent a subordinate's participation in an act";
}
@source(IRC_S6701_C, relation = formalizes, coverage = exact, quote = "ordering (or otherwise causing) a subordinate to do an act")
rule S6701c1AOrdering strict {
    for f: FailureContext;
    when orders_or_causes_subordinate_to_do_act(f);
    then person_procures_6701c(f);
}
@source(IRC_S6701_C, relation = formalizes, coverage = exact, quote = "knowing of, and not attempting to prevent, participation by a subordinate in an act")
rule S6701c1BKnowing strict {
    for f: FailureContext;
    when knew_of_and_did_not_attempt_to_prevent_subordinate_participation(f);
    then person_procures_6701c(f);
}
relation mechanical_assistance_only(f: FailureContext) kind empirical {
    label en official "the person furnishes only typing, reproducing, or other mechanical assistance with respect to the document";
}
relation knows_or_has_reason_to_believe_used_in_material_matter(f: FailureContext) kind empirical {
    label en official "the person knows (or has reason to believe) that such portion will be used in connection with any material matter arising under the internal revenue laws";
}
relation knows_portion_would_understate_liability_of_another(f: FailureContext) kind empirical {
    label en official "the person knows that such portion (if so used) would result in an understatement of the liability for tax of another person";
}
relation aiding_abetting_candidate_document(f: FailureContext) kind institutional {
    label en unofficial "the section 6701(a)(1)-(3) conditions are met for the document";
}
@source(IRC_S6701_A, relation = formalizes, coverage = exact, quote = "who aids or assists in, procures, or advises with respect to, the preparation or presentation of any portion of a return, affidavit, claim, or other document")
rule S6701aConditionsAided strict {
    for f: FailureContext;
    when aids_or_assists_in_preparation_or_presentation_of_document(f)
        and knows_or_has_reason_to_believe_used_in_material_matter(f)
        and knows_portion_would_understate_liability_of_another(f)
        and not_known(mechanical_assistance_only(f));
    then aiding_abetting_candidate_document(f);
}
@source(IRC_S6701_A, relation = formalizes, coverage = exact, quote = "who aids or assists in, procures, or advises with respect to, the preparation or presentation of any portion of a return, affidavit, claim, or other document")
rule S6701aConditionsProcured strict {
    for f: FailureContext;
    when person_procures_6701c(f)
        and knows_or_has_reason_to_believe_used_in_material_matter(f)
        and knows_portion_would_understate_liability_of_another(f)
        and not_known(mechanical_assistance_only(f));
    then aiding_abetting_candidate_document(f);
}
relation document_relates_to_corporation_liability(f: FailureContext) kind empirical {
    label en official "the return, affidavit, claim, or other document relates to the tax liability of a corporation";
}
relation document_relates_to_taxpayer_period(f: FailureContext, t: Person, y: TaxableYear) kind empirical {
    label en official "the document relates to the taxpayer for the taxable period (or taxable event)";
}
relation document_date(f: FailureContext, d: Date) kind empirical {
    label en unofficial "the date of the document";
}
relation earlier_candidate_document_for_same_taxpayer_period(f: FailureContext) kind institutional {
    label en unofficial "another document relating to the same taxpayer for the same period met the section 6701(a) conditions and is dated earlier";
}
@source(IRC_S6701_B, relation = formalizes, coverage = exact, quote = "such person shall not be subject to a penalty under subsection (a) with respect to any other document relating to such taxpayer for such taxable period (or event)")
rule S6701b3EarlierCandidate strict {
    for f: FailureContext;
    for g: FailureContext;
    for t: Person;
    for y: TaxableYear;
    for p: Person;
    for d: Date;
    for e: Date;
    when failure_by(f, p)
        and failure_by(g, p)
        and aiding_abetting_candidate_document(f)
        and aiding_abetting_candidate_document(g)
        and document_relates_to_taxpayer_period(f, t, y)
        and document_relates_to_taxpayer_period(g, t, y)
        and document_date(f, d)
        and document_date(g, e)
        and e < d;
    then earlier_candidate_document_for_same_taxpayer_period(f);
}
pub relation aiding_abetting_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$1,000 per document, $10,000 where the document relates to the tax liability of a corporation; only one document per taxpayer and period";
}
@source(IRC_S6701_B, relation = formalizes, coverage = exact, quote = "Except as provided in paragraph (2), the amount of the penalty imposed by subsection (a) shall be $1,000")
rule S6701bGeneralPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    when failure_by(f, p)
        and aiding_abetting_candidate_document(f)
        and not_known(document_relates_to_corporation_liability(f));
    then aiding_abetting_penalty(f, round(AidingAbettingPenaltyGeneral, 2, "HALF_UP"));
    unless earlier_candidate_document_for_same_taxpayer_period(f)
        and failure_by(f, p)
        and aiding_abetting_candidate_document(f)
        and not_known(document_relates_to_corporation_liability(f));
}
@source(IRC_S6701_B, relation = formalizes, coverage = exact, quote = "If the return, affidavit, claim, or other document relates to the tax liability of a corporation, the amount of the penalty imposed by subsection (a) shall be $10,000")
rule S6701bCorporationPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    when failure_by(f, p)
        and aiding_abetting_candidate_document(f)
        and document_relates_to_corporation_liability(f);
    then aiding_abetting_penalty(f, round(AidingAbettingPenaltyCorporation, 2, "HALF_UP"));
    unless earlier_candidate_document_for_same_taxpayer_period(f)
        and failure_by(f, p)
        and aiding_abetting_candidate_document(f)
        and document_relates_to_corporation_liability(f);
}
pub relation section_6694_penalty_barred_for_document(f: FailureContext) kind institutional {
    label en unofficial "no penalty shall be assessed under subsection (a) or (b) of section 6694 on the person with respect to a document for which a section 6701(a) penalty is assessed";
}
@source(IRC_S6701_F, relation = formalizes, coverage = exact, quote = "No penalty shall be assessed under subsection (a) or (b) of section 6694 on any person with respect to any document for which a penalty is assessed on such person under subsection (a)")
rule S6701f2No6694Penalty defeasible {
    for f: FailureContext;
    for a: Money;
    when aiding_abetting_penalty(f, a);
    then section_6694_penalty_barred_for_document(f);
}
pub relation section_6700_penalty_barred_for_document(f: FailureContext) kind institutional {
    label en unofficial "no penalty shall be assessed under section 6700 on the person with respect to a document for which a section 6701(a) penalty is assessed";
}
@source(IRC_S6701_F, relation = formalizes, coverage = exact, quote = "No penalty shall be assessed under section 6700 on any person with respect to any document for which a penalty is assessed on such person under subsection (a)")
rule S6701f3No6700Penalty defeasible {
    for f: FailureContext;
    for a: Money;
    when aiding_abetting_penalty(f, a);
    then section_6700_penalty_barred_for_document(f);
}
pub relation section_6701_penalty_in_addition_to_other_penalties(f: FailureContext) kind institutional {
    label en unofficial "except as provided in paragraphs (2) and (3), the penalty imposed by section 6701 is in addition to any other penalty provided by law";
}
@source(IRC_S6701_F, relation = formalizes, coverage = exact, quote = "Except as provided by paragraphs (2) and (3), the penalty imposed by this section shall be in addition to any other penalty provided by law")
rule S6701f1InAddition defeasible {
    for f: FailureContext;
    for a: Money;
    when aiding_abetting_penalty(f, a);
    then section_6701_penalty_in_addition_to_other_penalties(f);
}

// --- §6703: rules applicable to penalties under sections 6700, 6701, and 6702 ---------------------
relation proceeding_on_liability_for_6700_6701_or_6702_penalty(f: FailureContext) kind empirical {
    label en official "a proceeding involving the issue of whether or not any person is liable for a penalty under section 6700, 6701, or 6702";
}
pub relation burden_of_proof_on_secretary_6703a(f: FailureContext) kind institutional {
    label en official "the burden of proof with respect to the liability issue is on the Secretary";
}
@source(IRC_S6703_A, relation = formalizes, coverage = exact, quote = "the burden of proof with respect to such issue shall be on the Secretary")
rule S6703aBurdenOfProof strict {
    for f: FailureContext;
    when proceeding_on_liability_for_6700_6701_or_6702_penalty(f);
    then burden_of_proof_on_secretary_6703a(f);
}
relation section_6700_6701_penalty_amount(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "the amount of the penalty under section 6700 or 6701";
}
@source(IRC_S6703_C, relation = formalizes, coverage = partial, quote = "any penalty under section 6700 or 6701")
rule S6703Amount6700 defeasible {
    for f: FailureContext;
    for a: Money;
    when abusive_shelter_penalty(f, a);
    then section_6700_6701_penalty_amount(f, a);
}
@source(IRC_S6703_C, relation = formalizes, coverage = partial, quote = "any penalty under section 6700 or 6701")
rule S6703Amount6701 defeasible {
    for f: FailureContext;
    for a: Money;
    when aiding_abetting_penalty(f, a);
    then section_6700_6701_penalty_amount(f, a);
}
@source(IRC_S6703_B, relation = formalizes, coverage = exact, quote = "Subchapter B of chapter 63 (relating to deficiency procedures) shall not apply with respect to the assessment or collection of the penalties provided by sections 6700, 6701, and 6702")
rule S6703bDeficiencyImmunity6700 defeasible {
    for f: FailureContext;
    for p: Person;
    for amt: Money;
    when abusive_shelter_penalty(f, amt)
        and failure_by(f, p);
    then immunity S6703bDeficiencyImmunity6700Holder {
        holder p;
        protected_effect deficiency_procedure_would_apply_to_penalty(f);
        window [-infinity, infinity];
    };
}
@source(IRC_S6703_B, relation = formalizes, coverage = exact, quote = "Subchapter B of chapter 63 (relating to deficiency procedures) shall not apply with respect to the assessment or collection of the penalties provided by sections 6700, 6701, and 6702")
rule S6703bDeficiencyImmunity6701 defeasible {
    for f: FailureContext;
    for p: Person;
    for amt: Money;
    when aiding_abetting_penalty(f, amt)
        and failure_by(f, p);
    then immunity S6703bDeficiencyImmunity6701Holder {
        holder p;
        protected_effect deficiency_procedure_would_apply_to_penalty(f);
        window [-infinity, infinity];
    };
}
relation deficiency_procedure_would_apply_to_return_penalty(r: Return) kind institutional {
    label en unofficial "PENDING (owner: assessment, F02) - placeholder for the deficiency procedure reaching a section 6702(a) penalty on a return absent the immunity";
}
pub relation return_penalty_not_subject_to_deficiency_procedure(r: Return) kind institutional {
    label en unofficial "the section 6702(a) penalty is not subject to the deficiency procedures of subchapter B of chapter 63";
    protected_effect deficiency_procedure_would_apply_to_return_penalty;
}
@source(IRC_S6703_B, relation = formalizes, coverage = exact, quote = "Subchapter B of chapter 63 (relating to deficiency procedures) shall not apply with respect to the assessment or collection of the penalties provided by sections 6700, 6701, and 6702")
rule S6703bDeficiencyImmunity6702a defeasible {
    for r: Return;
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for amt: Money;
    when frivolous_return_penalty(r, amt)
        and us.irc.core::return_of(r, p, y, kind);
    then immunity S6703bDeficiencyImmunity6702aHolder {
        holder p;
        protected_effect deficiency_procedure_would_apply_to_return_penalty(r);
        window [-infinity, infinity];
    };
}
relation penalty_notice_and_demand_dated(f: FailureContext, d: Date) kind empirical {
    label en unofficial "the day on which notice and demand of the penalty is made against the person";
}
relation partial_payment_made_on(f: FailureContext, d: Date) kind empirical {
    label en unofficial "the day the person pays a partial amount of the penalty";
}
relation partial_payment_amount(f: FailureContext, amount: Money) kind empirical {
    label en unofficial "the amount paid";
}
relation refund_claim_for_partial_payment_filed_on(f: FailureContext, d: Date) kind empirical {
    label en unofficial "the day the person files a claim for refund of the amount so paid";
}
relation partial_payment_stay_conditions_met(f: FailureContext) kind institutional {
    label en unofficial "within 30 days after notice and demand the person paid not less than 15 percent of the penalty and filed a claim for refund of the amount paid";
}
@source(IRC_S6703_C, relation = formalizes, coverage = exact, quote = "If, within 30 days after the day on which notice and demand of any penalty under section 6700 or 6701 is made against any person, such person pays an amount which is not less than 15 percent of the amount of such penalty and files a claim for refund of the amount so paid")
rule S6703c1StayConditions defeasible {
    for f: FailureContext;
    for n: Date;
    for pd: Date;
    for cd: Date;
    for a: Money;
    for pen: Money;
    when penalty_notice_and_demand_dated(f, n)
        and partial_payment_made_on(f, pd)
        and partial_payment_amount(f, a)
        and refund_claim_for_partial_payment_filed_on(f, cd)
        and section_6700_6701_penalty_amount(f, pen)
        and days_between(n, pd) <= 30
        and days_between(n, cd) <= 30
        and a >= round(pen * PartialPaymentStayPercent, 2, "HALF_UP");
    then partial_payment_stay_conditions_met(f);
}
relation refund_claim_denied_on(f: FailureContext, d: Date) kind empirical {
    label en unofficial "the day the claim for refund of the partial payment is denied";
}
relation district_court_suit_begun_on(f: FailureContext, d: Date) kind empirical {
    label en unofficial "the day the person begins a proceeding in the appropriate United States district court for the determination of his liability for the penalty";
}
relation stay_cessation_candidate_date(f: FailureContext, d: Date) kind institutional {
    label en unofficial "a candidate end of the period within which suit must be begun: 30 days after denial of the refund claim, or 30 days after the expiration of 6 months after the claim was filed";
}
@source(IRC_S6703_C, relation = formalizes, coverage = exact, quote = "within 30 days after the day on which his claim for refund of any partial payment of any penalty under section 6700 or 6701 is denied")
rule S6703c2CandidateAfterDenial strict {
    for f: FailureContext;
    for dn: Date;
    when refund_claim_denied_on(f, dn);
    then stay_cessation_candidate_date(f, add_calendar_period(dn, 30 calendar_day));
}
@source(IRC_S6703_C, relation = formalizes, coverage = exact, quote = "or, if earlier, within 30 days after the expiration of 6 months after the day on which he filed the claim for refund")
rule S6703c2CandidateAfterSixMonths strict {
    for f: FailureContext;
    for cd: Date;
    when refund_claim_for_partial_payment_filed_on(f, cd);
    then stay_cessation_candidate_date(f, add_calendar_period(add_calendar_period(cd, 6 calendar_month), 30 calendar_day));
}
relation earlier_stay_cessation_candidate_exists(f: FailureContext, d: Date) kind institutional {
    label en unofficial "a strictly earlier cessation candidate exists";
}
@source(IRC_S6703_C, relation = formalizes, coverage = exact, quote = "or, if earlier, within 30 days after the expiration of 6 months")
rule S6703c2EarlierCandidate strict {
    for f: FailureContext;
    for d: Date;
    for e: Date;
    when stay_cessation_candidate_date(f, d)
        and stay_cessation_candidate_date(f, e)
        and e < d;
    then earlier_stay_cessation_candidate_exists(f, d);
}
relation stay_cessation_deadline(f: FailureContext, d: Date) kind institutional {
    label en unofficial "the last day on which suit may be begun: the earlier of the two candidate dates";
}
@source(IRC_S6703_C, relation = formalizes, coverage = exact, quote = "or, if earlier, within 30 days after the expiration of 6 months")
rule S6703c2Deadline strict {
    for f: FailureContext;
    for d: Date;
    when stay_cessation_candidate_date(f, d)
        and not_known(earlier_stay_cessation_candidate_exists(f, d));
    then stay_cessation_deadline(f, d);
}
relation suit_begun_within_period(f: FailureContext) kind institutional {
    label en unofficial "the person began the district court proceeding within the section 6703(c)(2) period";
}
@source(IRC_S6703_C, relation = formalizes, coverage = exact, quote = "the person fails to begin a proceeding in the appropriate United States district court for the determination of his liability for such penalty")
rule S6703c2SuitTimely strict {
    for f: FailureContext;
    for d: Date;
    for s: Date;
    when stay_cessation_deadline(f, d)
        and district_court_suit_begun_on(f, s)
        and s <= d;
    then suit_begun_within_period(f);
}
relation stay_ceased_6703c2(f: FailureContext) kind institutional {
    label en unofficial "paragraph (1) ceases to apply with respect to the penalty, effective on the day following the close of the applicable 30-day period";
}
relation stay_measurement_date(f: FailureContext, d: Date) kind empirical {
    label en unofficial "the date as of which the collection stay is evaluated (case fact)";
}
@source(IRC_S6703_C, relation = formalizes, coverage = exact, quote = "paragraph (1) shall cease to apply with respect to such penalty, effective on the day following the close of the applicable 30-day period referred to in this paragraph")
rule S6703c2Cessation strict {
    for f: FailureContext;
    for d: Date;
    for m: Date;
    when stay_cessation_deadline(f, d)
        and stay_measurement_date(f, m)
        and m > d
        and not_known(suit_begun_within_period(f));
    then stay_ceased_6703c2(f);
}
pub relation collection_stay_in_force_6703c1(f: FailureContext) kind institutional {
    label en unofficial "no levy or proceeding in court for the collection of the remainder of the penalty may be made, begun, or prosecuted until the final resolution of the district court proceeding";
}
@source(IRC_S6703_C, relation = formalizes, coverage = exact, quote = "no levy or proceeding in court for the collection of the remainder of such penalty shall be made, begun, or prosecuted until the final resolution of a proceeding begun as provided in paragraph (2)")
rule S6703c1StayInForce defeasible {
    for f: FailureContext;
    when partial_payment_stay_conditions_met(f);
    then collection_stay_in_force_6703c1(f);
    unless stay_ceased_6703c2(f)
        and partial_payment_stay_conditions_met(f);
}
relation levy_or_collection_proceeding_for_remainder(f: FailureContext) kind empirical {
    label en unofficial "the Secretary makes a levy or begins or prosecutes a proceeding in court for the collection of the remainder of the penalty";
}
@source(IRC_S6703_C, relation = formalizes, coverage = exact, quote = "no levy or proceeding in court for the collection of the remainder of such penalty shall be made, begun, or prosecuted")
rule S6703c1CollectionProhibition defeasible {
    for f: FailureContext;
    when collection_stay_in_force_6703c1(f);
    then prohibition SecretaryMayNotCollectRemainderDuringStay {
        bearer Secretary;
        action levy_or_collection_proceeding_for_remainder(f);
        window [-infinity, infinity];
    };
}
pub relation injunction_of_levy_or_proceeding_during_stay_available(f: FailureContext) kind institutional {
    label en unofficial "the beginning of the proceeding or levy during the time the prohibition is in force may be enjoined by a proceeding in the proper court, notwithstanding section 7421(a)";
}
@source(IRC_S6703_C, relation = formalizes, coverage = exact, quote = "Notwithstanding the provisions of section 7421(a), the beginning of such proceeding or levy during the time such prohibition is in force may be enjoined by a proceeding in the proper court")
rule S6703c1InjunctionAvailable defeasible {
    for f: FailureContext;
    when collection_stay_in_force_6703c1(f);
    then injunction_of_levy_or_proceeding_during_stay_available(f);
}
pub relation counterclaim_for_remainder_permitted(f: FailureContext) kind institutional {
    label en unofficial "a counterclaim for the remainder of the penalty is permitted in the district court proceeding";
}
@source(IRC_S6703_C, relation = formalizes, coverage = exact, quote = "Nothing in this paragraph shall be construed to prohibit any counterclaim for the remainder of such penalty in a proceeding begun as provided in paragraph (2)")
rule S6703c1CounterclaimPermitted defeasible {
    for f: FailureContext;
    when collection_stay_in_force_6703c1(f);
    then counterclaim_for_remainder_permitted(f);
}
pub relation collection_limitation_suspended_6703c3(f: FailureContext) kind institutional {
    label en unofficial "the running of the section 6502 collection period is suspended for the period during which the Secretary is prohibited from collecting (the clock arithmetic belongs to `collection`)";
}
@source(IRC_S6703_C, relation = formalizes, coverage = exact, quote = "The running of the period of limitations provided in section 6502 on the collection by levy or by a proceeding in court in respect of any penalty described in paragraph (1) shall be suspended for the period during which the Secretary is prohibited from collecting by levy or a proceeding in court")
rule S6703c3Suspension defeasible {
    for f: FailureContext;
    when collection_stay_in_force_6703c1(f);
    then collection_limitation_suspended_6703c3(f);
}

// --- §6704: failure to keep records necessary to meet reporting requirements under section 6047(d) ---
relation duty_to_report_under_6047d_may_exist(f: FailureContext) kind empirical {
    label en official "a person has a duty to report or may have a duty to report any information under section 6047(d)";
}
relation failed_to_keep_records_required_under_6047d(f: FailureContext) kind empirical {
    label en official "the person fails to keep such records as may be required by regulations prescribed under section 6047(d) for the purpose of providing the necessary data base for either current reporting or future reporting";
}
relation individuals_affected_by_recordkeeping_failure(f: FailureContext, n: Integer) kind empirical {
    label en unofficial "the number of individuals with respect to whom such failure occurs in the calendar year (case fact)";
}
relation failure_attributable_to_prior_penalized_failure_with_efforts_to_correct(f: FailureContext) kind empirical {
    label en official "the failure is attributable to a prior failure which has been penalized under this section and the person has made all reasonable efforts to correct the failure";
}
relation failure_before_1983_with_reasonable_efforts_to_correct(f: FailureContext) kind empirical {
    label en official "the failure is attributable to a failure occurring before January 1, 1983, and the person has made all reasonable efforts to correct such pre-1983 failure";
}
pub relation recordkeeping_failure_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$50 multiplied by the number of individuals, not exceeding $50,000 for any calendar year";
}
@source(IRC_S6704_B, relation = formalizes, coverage = exact, quote = "The penalty of any person for any calendar year shall be $50, multiplied by the number of individuals with respect to whom such failure occurs in such year")
rule S6704Penalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and duty_to_report_under_6047d_may_exist(f)
        and failed_to_keep_records_required_under_6047d(f)
        and individuals_affected_by_recordkeeping_failure(f, n);
    then recordkeeping_failure_penalty(f, min(round(RecordkeepingFailurePenaltyPerIndividual * n, 2, "HALF_UP"), round(RecordkeepingFailureAnnualCap, 2, "HALF_UP")));
    unless reasonable_cause_and_no_willful_neglect(p, f)
        and failure_by(f, p)
        and duty_to_report_under_6047d_may_exist(f)
        and failed_to_keep_records_required_under_6047d(f)
        and individuals_affected_by_recordkeeping_failure(f, n);
    unless failure_attributable_to_prior_penalized_failure_with_efforts_to_correct(f)
        and failure_by(f, p)
        and duty_to_report_under_6047d_may_exist(f)
        and failed_to_keep_records_required_under_6047d(f)
        and individuals_affected_by_recordkeeping_failure(f, n);
    unless failure_before_1983_with_reasonable_efforts_to_correct(f)
        and failure_by(f, p)
        and duty_to_report_under_6047d_may_exist(f)
        and failed_to_keep_records_required_under_6047d(f)
        and individuals_affected_by_recordkeeping_failure(f, n);
}

// --- §6705: failure by broker to provide notice of backup withholding -------------------------------
relation willfully_failed_to_provide_backup_withholding_notice(f: FailureContext) kind empirical {
    label en official "a person required under section 3406(d)(2)(B) to provide notice to any payor willfully fails to provide such notice to such payor";
}
pub relation backup_withholding_notice_failure_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "a penalty of $500 for each such failure";
}
@source(IRC_S6705_A, relation = formalizes, coverage = exact, quote = "shall pay a penalty of $500 for each such failure")
rule S6705Penalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and willfully_failed_to_provide_backup_withholding_notice(f)
        and failure_count(f, n);
    then backup_withholding_notice_failure_penalty(f, round(BackupWithholdingNoticeFailurePenalty * n, 2, "HALF_UP"));
}
pub relation section_6705_penalty_in_addition_to_other_penalties(f: FailureContext) kind institutional {
    label en unofficial "any penalty imposed by section 6705 is in addition to any other penalty provided by law";
}
@source(IRC_S6705_B, relation = formalizes, coverage = exact, quote = "Any penalty imposed by this section shall be in addition to any other penalty provided by law")
rule S6705bInAddition defeasible {
    for f: FailureContext;
    for a: Money;
    when backup_withholding_notice_failure_penalty(f, a);
    then section_6705_penalty_in_addition_to_other_penalties(f);
}

// --- §6706: original issue discount information requirements ---------------------------------------
relation failed_to_set_forth_1275c1_information_on_debt_instrument(f: FailureContext) kind empirical {
    label en official "a failure to set forth on a debt instrument the information required to be set forth on such instrument under section 1275(c)(1)";
}
pub relation debt_instrument_information_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "the issuer shall pay a penalty of $50 for each instrument with respect to which such a failure exists";
}
@source(IRC_S6706_A, relation = formalizes, coverage = exact, quote = "the issuer shall pay a penalty of $50 for each instrument with respect to which such a failure exists")
rule S6706aInstrumentPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and failed_to_set_forth_1275c1_information_on_debt_instrument(f)
        and failure_count(f, n);
    then debt_instrument_information_penalty(f, round(DebtInstrumentInformationPenaltyPerInstrument * n, 2, "HALF_UP"));
    unless reasonable_cause_and_no_willful_neglect(p, f)
        and failure_by(f, p)
        and failed_to_set_forth_1275c1_information_on_debt_instrument(f)
        and failure_count(f, n);
}
relation issuer_failed_to_furnish_1275c2_information(f: FailureContext) kind empirical {
    label en official "an issuer fails to furnish information required under section 1275(c)(2) with respect to any issue of debt instruments on the date prescribed therefor (determined with regard to any extension of time for filing)";
}
relation aggregate_issue_price_of_issue(f: FailureContext, amount: Money) kind empirical {
    label en official "the aggregate issue price of such issue (case fact)";
}
pub relation debt_issue_information_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "1 percent of the aggregate issue price of the issue, not to exceed $50,000";
}
@source(IRC_S6706_B, relation = formalizes, coverage = exact, quote = "shall pay a penalty equal to 1 percent of the aggregate issue price of such issue, unless it is shown that such failure is due to reasonable cause and not willful neglect")
rule S6706bIssuePenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for a: Money;
    when failure_by(f, p)
        and issuer_failed_to_furnish_1275c2_information(f)
        and aggregate_issue_price_of_issue(f, a);
    then debt_issue_information_penalty(f, min(round(a * DebtIssueInformationPenaltyRate, 2, "HALF_UP"), round(DebtIssueInformationPenaltyCap, 2, "HALF_UP")));
    unless reasonable_cause_and_no_willful_neglect(p, f)
        and failure_by(f, p)
        and issuer_failed_to_furnish_1275c2_information(f)
        and aggregate_issue_price_of_issue(f, a);
}
@source(IRC_S6706_C, relation = formalizes, coverage = exact, quote = "Subchapter B of chapter 63 (relating to deficiency procedures for income, estate, gift, and certain excise taxes) shall not apply in respect of the assessment or collection of any penalty imposed by this section")
rule S6706cDeficiencyImmunityInstrument defeasible {
    for f: FailureContext;
    for p: Person;
    for amt: Money;
    when debt_instrument_information_penalty(f, amt)
        and failure_by(f, p);
    then immunity S6706cDeficiencyImmunityInstrumentHolder {
        holder p;
        protected_effect deficiency_procedure_would_apply_to_penalty(f);
        window [-infinity, infinity];
    };
}
@source(IRC_S6706_C, relation = formalizes, coverage = exact, quote = "Subchapter B of chapter 63 (relating to deficiency procedures for income, estate, gift, and certain excise taxes) shall not apply in respect of the assessment or collection of any penalty imposed by this section")
rule S6706cDeficiencyImmunityIssue defeasible {
    for f: FailureContext;
    for p: Person;
    for amt: Money;
    when debt_issue_information_penalty(f, amt)
        and failure_by(f, p);
    then immunity S6706cDeficiencyImmunityIssueHolder {
        holder p;
        protected_effect deficiency_procedure_would_apply_to_penalty(f);
        window [-infinity, infinity];
    };
}

// --- §6707: failure to furnish information regarding reportable transactions -----------------------
relation failed_to_file_or_filed_false_6111a_return(f: FailureContext) kind empirical {
    label en official "a person required to file a return under section 6111(a) with respect to any reportable transaction fails to file such return on or before the date prescribed therefor, or files false or incomplete information with the Secretary";
}
relation failure_involves_listed_transaction_6707(f: FailureContext) kind empirical {
    label en official "the failure relates to a listed transaction (section 6707A(c)(2))";
}
relation gross_income_from_aid_assistance_or_advice_before_return(f: FailureContext, amount: Money) kind empirical {
    label en official "the gross income derived by such person with respect to aid, assistance, or advice which is provided with respect to the listed transaction before the date the return is filed under section 6111 (case fact)";
}
relation material_advisor_failure_intentional(f: FailureContext) kind empirical {
    label en official "the failure or act is intentional";
}
pub relation material_advisor_return_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$50,000; for a listed transaction the greater of $200,000 or 50 percent (75 percent if intentional) of the gross income";
}
@source(IRC_S6707_B, relation = formalizes, coverage = exact, quote = "Except as provided in paragraph (2), the penalty imposed under subsection (a) with respect to any failure shall be $50,000")
rule S6707bGeneralPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    when failure_by(f, p)
        and failed_to_file_or_filed_false_6111a_return(f)
        and not_known(failure_involves_listed_transaction_6707(f));
    then material_advisor_return_penalty(f, round(MaterialAdvisorReturnPenaltyGeneral, 2, "HALF_UP"));
}
@source(IRC_S6707_B, relation = formalizes, coverage = exact, quote = "The penalty imposed under subsection (a) with respect to any listed transaction shall be an amount equal to the greater of—")
rule S6707b2ListedPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for g: Money;
    when failure_by(f, p)
        and failed_to_file_or_filed_false_6111a_return(f)
        and failure_involves_listed_transaction_6707(f)
        and gross_income_from_aid_assistance_or_advice_before_return(f, g)
        and not_known(material_advisor_failure_intentional(f));
    then material_advisor_return_penalty(f, max(round(MaterialAdvisorListedTransactionMinimum, 2, "HALF_UP"), round(g * MaterialAdvisorListedTransactionIncomeRate, 2, "HALF_UP")));
}
@source(IRC_S6707_B, relation = formalizes, coverage = exact, quote = "Subparagraph (B) shall be applied by substituting \"75 percent\" for \"50 percent\" in the case of an intentional failure or act described in subsection (a)")
rule S6707b2ListedIntentionalPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for g: Money;
    when failure_by(f, p)
        and failed_to_file_or_filed_false_6111a_return(f)
        and failure_involves_listed_transaction_6707(f)
        and gross_income_from_aid_assistance_or_advice_before_return(f, g)
        and material_advisor_failure_intentional(f);
    then material_advisor_return_penalty(f, max(round(MaterialAdvisorListedTransactionMinimum, 2, "HALF_UP"), round(g * MaterialAdvisorIntentionalIncomeRate, 2, "HALF_UP")));
}
relation rescission_would_promote_compliance_6707(f: FailureContext) kind empirical {
    label en official "rescinding the penalty would promote compliance with the requirements of this title and effective tax administration";
}
relation rescission_conditions_6707c(f: FailureContext) kind institutional {
    label en unofficial "the section 6707A(d) rescission conditions, applied by section 6707(c), are met: not a listed transaction and rescission promotes compliance (single atom for the power valid_when)";
}
@source(IRC_S6707_C, relation = formalizes, coverage = partial, quote = "The provisions of section 6707A(d) (relating to authority of Commissioner to rescind penalty) shall apply to any penalty imposed under this section")
rule S6707cRescissionConditions strict {
    for f: FailureContext;
    when not_known(failure_involves_listed_transaction_6707(f))
        and rescission_would_promote_compliance_6707(f);
    then rescission_conditions_6707c(f);
}
relation commissioner_moves_to_rescind_6707_penalty(f: FailureContext) kind empirical {
    label en unofficial "the Commissioner has moved to rescind the penalty (exercise fact)";
}
pub relation material_advisor_return_penalty_rescinded(f: FailureContext) kind institutional {
    label en unofficial "all or a portion of the section 6707 penalty has been rescinded";
}
@source(IRC_S6707_C, relation = formalizes, coverage = partial, quote = "The provisions of section 6707A(d) (relating to authority of Commissioner to rescind penalty) shall apply to any penalty imposed under this section")
rule S6707cRescissionPower strict {
    for f: FailureContext;
    when commissioner_moves_to_rescind_6707_penalty(f);
    then power RescindMaterialAdvisorReturnPenalty {
        holder IRS;
        over f;
        exercise commissioner_moves_to_rescind_6707_penalty(f);
        valid_when rescission_conditions_6707c(f);
        effect create(material_advisor_return_penalty_rescinded(f));
        window [-infinity, infinity];
    };
}

// --- §6708: failure to maintain lists of advisees with respect to reportable transactions ------------
relation required_to_maintain_list_under_6112a_failed_to_make_available(f: FailureContext) kind empirical {
    label en official "a person required to maintain a list under section 6112(a) fails to make such list available upon written request to the Secretary in accordance with section 6112(b) within 20 business days after the date of such request";
}
relation days_after_twentieth_business_day(f: FailureContext, n: Integer) kind empirical {
    label en unofficial "the number of days of failure after the 20th business day (case fact; counting business days needs the federal holiday calendar)";
}
pub relation list_not_available_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$10,000 for each day of such failure after the 20th day";
}
@source(IRC_S6708_A, relation = formalizes, coverage = exact, quote = "such person shall pay a penalty of $10,000 for each day of such failure after such 20th day")
rule S6708aPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and required_to_maintain_list_under_6112a_failed_to_make_available(f)
        and days_after_twentieth_business_day_for_penalty(f, n);
    then list_not_available_penalty(f, round(ListNotAvailablePenaltyPerDay * n, 2, "HALF_UP"));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and required_to_maintain_list_under_6112a_failed_to_make_available(f)
        and days_after_twentieth_business_day_for_penalty(f, n);
}
pub relation section_6708_penalty_in_addition_to_other_penalties(f: FailureContext) kind institutional {
    label en unofficial "the penalty imposed by section 6708 is in addition to any other penalty provided by law";
}
@source(IRC_S6708_B, relation = formalizes, coverage = exact, quote = "The penalty imposed by this section shall be in addition to any other penalty provided by law")
rule S6708bInAddition defeasible {
    for f: FailureContext;
    for a: Money;
    when list_not_available_penalty(f, a);
    then section_6708_penalty_in_addition_to_other_penalties(f);
}
