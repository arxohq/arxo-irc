// 26 U.S.C. §6665 — Applicable rules: (a) additions/penalties under this
// chapter are ASSESSED, COLLECTED AND PAID as tax and "tax" elsewhere in the
// title is deemed to include them (an institutional effect on every addition
// this package defines); (b) the deficiency-procedure carve-out for §§6651/
// 6654/6655 additions.
//
// JUDGMENT CALLS AND GAPS (see report):
//  - (a) is modelled as a single institutional-effect relation
//    (`treated_as_tax`) asserted for every addition amount this package
//    computes, rather than a generic rule over "any amount this package
//    calls an addition" (the language has no reflection over its own
//    predicate declarations); each addition module asserts its own
//    `treated_as_tax(...)` fact alongside its amount.
//  - (b) is a cross-reference to "deficiency procedures for income, estate,
//    gift, and certain excise taxes" (subchapter B of chapter 63), owned by
//    `assessment` (F02, not yet formalized) — EXTERNAL_DEPENDENCY. This
//    package states only the CLASSIFICATION that (a) does not extend
//    deficiency-procedure treatment to §6651/6654/6655 additions except in
//    the two named circumstances, as a fact the (pending) `assessment`
//    package's own deficiency-procedure rule would need to read; it does not
//    reimplement deficiency procedure itself.

language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

use self::{
    IRC_S6665_B,
    PenaltySectionKind,
    TaxKind,
};

pub relation treated_as_tax(kind: TaxKind, amount: Money) kind institutional {
    label en official "the additions to the tax, additional amounts, and penalties provided by this chapter shall be paid upon notice and demand and shall be assessed, collected, and paid in the same manner as taxes; and any reference in this title to \"tax\" imposed by this title shall be deemed also to refer to the additions to the tax, additional amounts, and penalties provided by this chapter";
}

// (b): whether deficiency procedure applies to a §6651/6654/6655 addition.
relation addition_attributable_to_deficiency_under_6211(kind: PenaltySectionKind) kind institutional {
    label en unofficial "PENDING (owner: assessment, F02) — the portion of a section 6651 addition attributable to a deficiency in tax described in section 6211";
}
relation no_return_filed_for_the_taxable_year(kind: PenaltySectionKind) kind empirical {
    label en unofficial "no return is filed for the taxable year, for purposes of section 6665(b)(2)";
}
pub relation deficiency_procedure_applies_to_addition(kind: PenaltySectionKind) kind institutional {
    label en unofficial "for purposes of the deficiency procedures of subchapter B of chapter 63, section 6665(a) does not bar applying them to this addition (an EXTERNAL_DEPENDENCY fact the assessment package's own deficiency-procedure rule would read)";
}
@source(IRC_S6665_B, relation = formalizes, coverage = partial, quote = "in the case of an addition described in section 6651, to that portion of such addition which is attributable to a deficiency in tax described in section 6211")
rule Section6665bFailureToFileDeficiencyPortion strict {
    when addition_attributable_to_deficiency_under_6211(FailureToFile);
    then deficiency_procedure_applies_to_addition(FailureToFile);
}
@source(IRC_S6665_B, relation = formalizes, coverage = partial, quote = "to an addition described in section 6654 or 6655, if no return is filed for the taxable year")
rule Section6665bEstimatedTaxIndividualNoReturn strict {
    when no_return_filed_for_the_taxable_year(EstimatedTaxIndividual);
    then deficiency_procedure_applies_to_addition(EstimatedTaxIndividual);
}
@source(IRC_S6665_B, relation = formalizes, coverage = partial, quote = "to an addition described in section 6654 or 6655, if no return is filed for the taxable year")
rule Section6665bEstimatedTaxCorporateNoReturn strict {
    when no_return_filed_for_the_taxable_year(EstimatedTaxCorporate);
    then deficiency_procedure_applies_to_addition(EstimatedTaxCorporate);
}
