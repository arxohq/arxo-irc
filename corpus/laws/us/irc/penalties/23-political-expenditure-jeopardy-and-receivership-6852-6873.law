language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

use self::{
    IRC_S6852_A,
    IRC_S6852_B,
    IRC_S6862_A,
    IRC_S6871_A,
    IRC_S6871_B,
    IRC_S6871_C,
    IRC_S6872,
    IRC_S6873_A,
    JeopardyAssessment,
    JeopardyAssessmentKind,
    Person,
    Secretary,
    jeopardy_assessment_made_on,
    jeopardy_assessment_of,
    jeopardy_assessment_valid,
    jeopardy_notice_given_timely,
    jeopardy_notice_mailed_on,
    return_due_date_or_filing_later,
};

// 26 U.S.C. §§6852, 6862, 6864, 6871-6873 — chapter 70 jeopardy, receivership
// and title 11 provisions not covered by module 15 (IRC-16 stage 2, DECISION-0379).
//
// MODEL. §6852 and §6862 join the two authorities of module 15 as new
// `JeopardyAssessmentKind` members (`Political6852`, `NonIncomeTax6862`), so that
// the named `pub jeopardy_assessment_valid` answers for all four.
//
// JUDGMENT CALLS AND GAPS:
//  - §6852(a)(1)(B) "a flagrant violation of the prohibition against making
//    political expenditures" is an evaluative element delegated to the Secretary's
//    finding: an `external judgment relation` (DECISION-0194), unlike the
//    jeopardy findings of §6851/§6861 that module 15 keeps as institutional facts
//    (the text there names no evaluative standard).
//  - §6852(b)(2) applies §6851(b) (60-day notice, modelled here as a rule for the
//    new kind) and §6861(f), (g) with a substituted test; §6861(f)/(g) are NOT
//    modelled in module 15 (TECH-GAPS G3108), so the substituted §6861(g) test is
//    the same gap.
//  - §6862: the jeopardy belief is the Secretary's institutional finding (as in
//    module 15). The excluded taxes are a case fact of the assessment.
//  - §6871(a)/(b): the receivership or title 11 status of the taxpayer are case
//    facts; "res judicata" of §6871(b)(2) is a case fact.
//  - §6872: the earlier of (notice received + 30 days) and (start + 2 years) is
//    chosen with the "no strictly earlier candidate" pattern (TECH-GAPS G136).
//    Whether the period of limitations itself (§6501) is suspended is a
//    `us.irc.assessment` clock; this module derives the suspension interval only.

// --- §6852: termination assessments of income tax in the case of flagrant political expenditures
relation section_501c3_organization_made_political_expenditures(o: Person) kind empirical {
    label en official "a section 501(c)(3) organization has made political expenditures";
}
pub external judgment relation political_expenditures_constitute_flagrant_violation(o: Person) {
    authority Secretary;
    label en official "such expenditures constitute a flagrant violation of the prohibition against making political expenditures";
}
relation secretary_moves_to_assess_political_expenditure_taxes(a: JeopardyAssessment) kind empirical {
    label en unofficial "the Secretary has moved to make the section 6852 determination and assessment (exercise fact)";
}
relation assessment_covers_preceding_taxable_year(a: JeopardyAssessment) kind empirical {
    label en unofficial "the assessment includes tax for the preceding taxable year";
}
relation preceding_year_return_due_date_with_extensions(a: JeopardyAssessment, d: Date) kind empirical {
    label en official "the due date of the organization's return for the preceding taxable year (determined with regard to any extensions)";
}
relation political_expenditure_finding_present(o: Person) kind institutional {
    label en unofficial "the section 6852(a)(1) finding is present: a section 501(c)(3) organization made political expenditures constituting a flagrant violation";
}
@source(IRC_S6852_A, relation = formalizes, coverage = partial, quote = "the Secretary shall immediately make a determination of any income tax payable by such organization for the current or immediately preceding taxable year, or both")
rule S6852a1Finding defeasible {
    for o: Person;
    when section_501c3_organization_made_political_expenditures(o)
        and political_expenditures_constitute_flagrant_violation(o);
    then political_expenditure_finding_present(o);
}
relation political_expenditure_assessment_within_6852a4_limit(a: JeopardyAssessment) kind institutional {
    label en unofficial "the assessment does not reach the preceding taxable year, or is made on or before the due date of the organization's return for that year (section 6852(a)(4))";
}
@source(IRC_S6852_A, relation = formalizes, coverage = exact, quote = "This section shall not authorize any assessment of tax for the preceding taxable year which is made after the due date of the organization's return for such taxable year (determined with regard to any extensions)")
rule S6852a4NotPreceding strict {
    for a: JeopardyAssessment;
    for o: Person;
    when jeopardy_assessment_of(a, o, Political6852)
        and not_known(assessment_covers_preceding_taxable_year(a));
    then political_expenditure_assessment_within_6852a4_limit(a);
}
@source(IRC_S6852_A, relation = formalizes, coverage = exact, quote = "This section shall not authorize any assessment of tax for the preceding taxable year which is made after the due date of the organization's return for such taxable year (determined with regard to any extensions)")
rule S6852a4BeforeDueDate strict {
    for a: JeopardyAssessment;
    for m: Date;
    for d: Date;
    when assessment_covers_preceding_taxable_year(a)
        and jeopardy_assessment_made_on(a, m)
        and preceding_year_return_due_date_with_extensions(a, d)
        and m <= d;
    then political_expenditure_assessment_within_6852a4_limit(a);
}
relation political_expenditure_assessment_authorized_conditions(a: JeopardyAssessment) kind institutional {
    label en unofficial "the section 6852(a) finding is present and the (a)(4) limit is respected (single atom for the power valid_when)";
}
@source(IRC_S6852_A, relation = formalizes, coverage = partial, quote = "The Secretary shall immediately assess the amount of tax so determined")
rule S6852aConditions defeasible {
    for a: JeopardyAssessment;
    for o: Person;
    when jeopardy_assessment_of(a, o, Political6852)
        and political_expenditure_finding_present(o)
        and political_expenditure_assessment_within_6852a4_limit(a);
    then political_expenditure_assessment_authorized_conditions(a);
}
pub relation political_expenditure_assessment_authorized(a: JeopardyAssessment) kind institutional {
    label en unofficial "the section 6852(a) assessment has been validly made";
}
@source(IRC_S6852_A, relation = formalizes, coverage = exact, quote = "The Secretary shall immediately assess the amount of tax so determined (together with all interest, additional amounts, and additions to the tax provided by law)")
rule S6852aAssessmentPower strict {
    for a: JeopardyAssessment;
    when secretary_moves_to_assess_political_expenditure_taxes(a);
    then power AssessPoliticalExpenditureTaxes {
        holder Secretary;
        over a;
        exercise secretary_moves_to_assess_political_expenditure_taxes(a);
        valid_when political_expenditure_assessment_authorized_conditions(a);
        effect create(political_expenditure_assessment_authorized(a));
        window [-infinity, infinity];
    };
}
relation political_expenditure_determination_made(o: Person) kind empirical {
    label en unofficial "the Secretary has immediately made the determination of income tax and section 4955 tax";
}
@source(IRC_S6852_A, relation = formalizes, coverage = exact, quote = "the Secretary shall immediately make a determination of any income tax payable by such organization")
rule S6852a1DeterminationDuty defeasible {
    for o: Person;
    when political_expenditure_finding_present(o);
    then duty SecretaryDetermineTaxesOnFlagrantPoliticalExpenditures {
        bearer Secretary;
        beneficiary o;
        goal achievement {
            condition political_expenditure_determination_made(o);
            window [-infinity, infinity];
        };
    };
}
relation political_expenditure_notice_and_demand_given(o: Person) kind empirical {
    label en official "the Secretary has given notice of the determination and assessment together with a demand for immediate payment";
}
@source(IRC_S6852_A, relation = formalizes, coverage = exact, quote = "shall cause notice of such determination and assessment to be given to the organization or any manager thereof, as the case may be, together with a demand for immediate payment of such tax")
rule S6852a1NoticeAndDemandDuty defeasible {
    for o: Person;
    when political_expenditure_finding_present(o);
    then duty SecretaryGiveNoticeAndDemandForPoliticalExpenditureTaxes {
        bearer Secretary;
        beneficiary o;
        goal achievement {
            condition political_expenditure_notice_and_demand_given(o);
            window [-infinity, infinity];
        };
    };
}
pub relation political_expenditure_tax_immediately_due_and_payable(o: Person) kind institutional {
    label en unofficial "notwithstanding any other provision of law, the tax becomes immediately due and payable";
}
@source(IRC_S6852_A, relation = formalizes, coverage = exact, quote = "Notwithstanding any other provision of law, any such tax shall become immediately due and payable")
rule S6852a1ImmediatelyDue defeasible {
    for o: Person;
    when political_expenditure_finding_present(o);
    then political_expenditure_tax_immediately_due_and_payable(o);
}
relation current_taxable_year_begins_on(o: Person, d: Date) kind empirical {
    label en official "the first day of the organization's current taxable year";
}
relation political_expenditure_determination_date(o: Person, d: Date) kind empirical {
    label en official "the date of the determination under paragraph (1)";
}
pub relation current_year_determination_period(o: Person, from: Date, to: Date) kind institutional {
    label en unofficial "for a current taxable year, the period beginning on the 1st day of the current taxable year and ending on the date of the determination is treated as a taxable year of the organization";
}
@source(IRC_S6852_A, relation = formalizes, coverage = exact, quote = "the Secretary shall determine the taxes for the period beginning on the 1st day of such current taxable year and ending on the date of the determination under paragraph (1) as though such period were a taxable year of the organization")
rule S6852a2Period strict {
    for o: Person;
    for s: Date;
    for e: Date;
    when current_taxable_year_begins_on(o, s)
        and political_expenditure_determination_date(o, e)
        and e >= s;
    then current_year_determination_period(o, s, e);
}
relation tax_computed_for_current_year_period(o: Person, amount: Money) kind empirical {
    label en unofficial "the tax computed for the period as a taxable year (owner: income-individual / exempt-organizations; case fact)";
}
relation prior_determination_for_current_year_amount(o: Person, amount: Money) kind empirical {
    label en official "the amount of any prior determination made under subsection (a) with respect to the current taxable year";
}
pub relation political_expenditure_tax_to_determine_for_current_year(o: Person, amount: Money) kind institutional {
    label en unofficial "the tax to be determined for the period after taking into account any prior determination with respect to the current taxable year";
}
@source(IRC_S6852_A, relation = formalizes, coverage = exact, quote = "and shall take into account any prior determination made under this subsection with respect to such current taxable year")
rule S6852a2NetOfPrior strict {
    for o: Person;
    for t: Money;
    for pr: Money;
    when tax_computed_for_current_year_period(o, t)
        and prior_determination_for_current_year_amount(o, pr);
    then political_expenditure_tax_to_determine_for_current_year(o, max(0.00 USD, t - pr));
}
relation amount_collected_under_6852_assessment(o: Person, amount: Money) kind empirical {
    label en official "the amounts collected as a result of assessments under subsection (a)";
}
pub relation collection_treated_as_payment_of_tax(o: Person, amount: Money) kind institutional {
    label en unofficial "the amounts collected are treated, to the extent thereof, as a payment of income tax for the taxable year or of section 4955 tax with respect to the expenditure";
}
@source(IRC_S6852_A, relation = formalizes, coverage = exact, quote = "Any amounts collected as a result of any assessments under this subsection shall, to the extent thereof, be treated as a payment of income tax for such taxable year, or tax under section 4955 with respect to the expenditure, as the case may be")
rule S6852a3TreatedAsPayment strict {
    for o: Person;
    for c: Money;
    when amount_collected_under_6852_assessment(o, c);
    then collection_treated_as_payment_of_tax(o, c);
}
@source(IRC_S6852_B, relation = formalizes, coverage = partial, quote = "The provisions of sections 6851(b), 6861(f), and 6861(g) shall apply with respect to any assessment made under subsection (a)")
rule S6852bJeopardyNoticeTimely strict {
    for a: JeopardyAssessment;
    for o: Person;
    for baseline: Date;
    for mailed: Date;
    when jeopardy_assessment_of(a, o, Political6852)
        and return_due_date_or_filing_later(a, baseline)
        and jeopardy_notice_mailed_on(a, mailed)
        and mailed <= add_calendar_period(baseline, 60 calendar_day);
    then jeopardy_notice_given_timely(a);
}
@source(IRC_S6852_A, relation = formalizes, coverage = partial, quote = "The Secretary shall immediately assess the amount of tax so determined")
rule S6852ValidAssessment strict {
    for a: JeopardyAssessment;
    when political_expenditure_assessment_authorized(a)
        and jeopardy_notice_given_timely(a);
    then jeopardy_assessment_valid(a);
}

// --- §6862: jeopardy assessment of taxes other than income, estate, gift, and chapters 41-44 -------
relation secretary_believes_collection_jeopardized_by_delay_6862(o: Person) kind empirical {
    label en official "the Secretary believes that the collection of the tax will be jeopardized by delay";
}
relation tax_is_income_estate_gift_or_chapter_41_to_44_tax(a: JeopardyAssessment) kind empirical {
    label en official "the tax is an income tax, estate tax, gift tax, or an excise tax imposed by chapter 41, 42, 43, or 44";
}
relation secretary_moves_to_assess_jeopardy_tax_6862(a: JeopardyAssessment) kind empirical {
    label en unofficial "the Secretary has moved to make the section 6862(a) immediate assessment (exercise fact)";
}
relation jeopardy_condition_6862_met(o: Person) kind institutional {
    label en unofficial "the section 6862(a) jeopardy belief is present (single atom for valid_when)";
}
@source(IRC_S6862_A, relation = formalizes, coverage = exact, quote = "If the Secretary believes that the collection of any tax (other than income tax, estate tax, gift tax, and the excise taxes imposed by chapters 41, 42, 43, and 44) under any provision of the internal revenue laws will be jeopardized by delay")
rule S6862aCondition defeasible {
    for o: Person;
    when secretary_believes_collection_jeopardized_by_delay_6862(o);
    then jeopardy_condition_6862_met(o);
}
relation jeopardy_assessment_tax_not_excluded_6862(a: JeopardyAssessment) kind institutional {
    label en unofficial "the tax is not one of the taxes excluded from section 6862(a)";
}
@source(IRC_S6862_A, relation = formalizes, coverage = exact, quote = "(other than income tax, estate tax, gift tax, and the excise taxes imposed by chapters 41, 42, 43, and 44)")
rule S6862aTaxNotExcluded strict {
    for a: JeopardyAssessment;
    for o: Person;
    when jeopardy_assessment_of(a, o, NonIncomeTax6862)
        and not_known(tax_is_income_estate_gift_or_chapter_41_to_44_tax(a));
    then jeopardy_assessment_tax_not_excluded_6862(a);
}
relation jeopardy_assessment_authorized_conditions_6862(a: JeopardyAssessment) kind institutional {
    label en unofficial "the jeopardy belief is present and the tax is not an excluded tax (single atom for the power valid_when)";
}
@source(IRC_S6862_A, relation = formalizes, coverage = exact, quote = "he shall, whether or not the time otherwise prescribed by law for making return and paying such tax has expired, immediately assess such tax")
rule S6862aConditions defeasible {
    for a: JeopardyAssessment;
    for o: Person;
    when jeopardy_assessment_of(a, o, NonIncomeTax6862)
        and jeopardy_condition_6862_met(o)
        and jeopardy_assessment_tax_not_excluded_6862(a);
    then jeopardy_assessment_authorized_conditions_6862(a);
}
pub relation non_income_jeopardy_assessment_authorized(a: JeopardyAssessment) kind institutional {
    label en unofficial "the section 6862(a) immediate assessment has been validly made";
}
@source(IRC_S6862_A, relation = formalizes, coverage = exact, quote = "he shall, whether or not the time otherwise prescribed by law for making return and paying such tax has expired, immediately assess such tax (together with all interest, additional amounts, and additions to the tax provided for by law)")
rule S6862aAssessmentPower strict {
    for a: JeopardyAssessment;
    when secretary_moves_to_assess_jeopardy_tax_6862(a);
    then power AssessNonIncomeJeopardyTax {
        holder Secretary;
        over a;
        exercise secretary_moves_to_assess_jeopardy_tax_6862(a);
        valid_when jeopardy_assessment_authorized_conditions_6862(a);
        effect create(non_income_jeopardy_assessment_authorized(a));
        window [-infinity, infinity];
    };
}
pub relation jeopardy_tax_immediately_due_and_payable_6862(a: JeopardyAssessment) kind institutional {
    label en unofficial "the tax, additions to the tax, and interest thereupon become immediately due and payable";
}
@source(IRC_S6862_A, relation = formalizes, coverage = exact, quote = "Such tax, additions to the tax, and interest shall thereupon become immediately due and payable")
rule S6862aImmediatelyDue defeasible {
    for a: JeopardyAssessment;
    when non_income_jeopardy_assessment_authorized(a);
    then jeopardy_tax_immediately_due_and_payable_6862(a);
}
relation immediate_notice_and_demand_made_6862(a: JeopardyAssessment) kind empirical {
    label en official "immediate notice and demand has been made by the Secretary for the payment";
}
@source(IRC_S6862_A, relation = formalizes, coverage = exact, quote = "immediate notice and demand shall be made by the Secretary for the payment thereof")
rule S6862aNoticeAndDemandDuty defeasible {
    for a: JeopardyAssessment;
    when non_income_jeopardy_assessment_authorized(a);
    then duty SecretaryMakeImmediateNoticeAndDemand6862 {
        bearer Secretary;
        goal achievement {
            condition immediate_notice_and_demand_made_6862(a);
            window [-infinity, infinity];
        };
    };
}
@source(IRC_S6862_A, relation = formalizes, coverage = partial, quote = "he shall, whether or not the time otherwise prescribed by law for making return and paying such tax has expired, immediately assess such tax")
rule S6862ValidAssessment strict {
    for a: JeopardyAssessment;
    when non_income_jeopardy_assessment_authorized(a);
    then jeopardy_assessment_valid(a);
}

// --- §6871: claims for income, estate, gift, and certain excise taxes in receivership proceedings, etc.
pub entity ReceivershipMatter {
    label en unofficial "a receivership proceeding, or a case under title 11, in which the Secretary has determined a deficiency of a section 6871 tax";
}
relation receiver_appointed_for_taxpayer_in_receivership_proceeding(r: ReceivershipMatter) kind empirical {
    label en official "a receiver has been appointed for the taxpayer in a receivership proceeding before any court of the United States or of any State or of the District of Columbia";
}
relation deficiency_determined_in_respect_of_subtitle_a_b_or_chapter_41_to_44_tax(r: ReceivershipMatter) kind empirical {
    label en official "the Secretary has determined a deficiency (with interest, additional amounts, and additions to the tax) in respect of a tax imposed by subtitle A or B or by chapter 41, 42, 43, or 44";
}
relation deficiency_not_theretofore_assessed_in_accordance_with_law(r: ReceivershipMatter) kind empirical {
    label en official "the deficiency has not theretofore been assessed in accordance with law";
}
relation title_11_case_of_debtors_estate(r: ReceivershipMatter) kind empirical {
    label en official "the deficiency is on the debtor's estate in a case under title 11 of the United States Code";
}
relation title_11_debtor_liability_res_judicata(r: ReceivershipMatter) kind empirical {
    label en official "the deficiency is on the debtor, and liability for such tax has become res judicata pursuant to a determination in a case under title 11 of the United States Code";
}
relation immediate_assessment_conditions_6871(r: ReceivershipMatter) kind institutional {
    label en unofficial "the section 6871(a) or (b) conditions for immediate assessment are met (single atom for the power valid_when)";
}
@source(IRC_S6871_A, relation = formalizes, coverage = exact, quote = "On the appointment of a receiver for the taxpayer in any receivership proceeding before any court of the United States or of any State or of the District of Columbia")
rule S6871aConditions strict {
    for r: ReceivershipMatter;
    when receiver_appointed_for_taxpayer_in_receivership_proceeding(r)
        and deficiency_determined_in_respect_of_subtitle_a_b_or_chapter_41_to_44_tax(r)
        and deficiency_not_theretofore_assessed_in_accordance_with_law(r);
    then immediate_assessment_conditions_6871(r);
}
@source(IRC_S6871_B, relation = formalizes, coverage = exact, quote = "the debtor's estate in a case under title 11 of the United States Code, or")
rule S6871bEstateConditions strict {
    for r: ReceivershipMatter;
    when title_11_case_of_debtors_estate(r)
        and deficiency_determined_in_respect_of_subtitle_a_b_or_chapter_41_to_44_tax(r)
        and deficiency_not_theretofore_assessed_in_accordance_with_law(r);
    then immediate_assessment_conditions_6871(r);
}
@source(IRC_S6871_B, relation = formalizes, coverage = exact, quote = "the debtor, but only if liability for such tax has become res judicata pursuant to a determination in a case under title 11 of the United States Code")
rule S6871bDebtorResJudicataConditions strict {
    for r: ReceivershipMatter;
    when title_11_debtor_liability_res_judicata(r)
        and deficiency_determined_in_respect_of_subtitle_a_b_or_chapter_41_to_44_tax(r)
        and deficiency_not_theretofore_assessed_in_accordance_with_law(r);
    then immediate_assessment_conditions_6871(r);
}
relation secretary_moves_to_assess_immediately_6871(r: ReceivershipMatter) kind empirical {
    label en unofficial "the Secretary has moved to assess the deficiency immediately despite section 6213(a) (exercise fact)";
}
pub relation deficiency_immediately_assessed_despite_6213a(r: ReceivershipMatter) kind institutional {
    label en unofficial "the deficiency (with interest, additional amounts, and additions) has been immediately assessed despite the restrictions imposed by section 6213(a)";
}
@source(IRC_S6871_A, relation = formalizes, coverage = exact, quote = "may, despite the restrictions imposed by section 6213(a) on assessments, be immediately assessed if such deficiency has not theretofore been assessed in accordance with law")
rule S6871aImmediateAssessmentPower strict {
    for r: ReceivershipMatter;
    when secretary_moves_to_assess_immediately_6871(r);
    then power AssessDeficiencyImmediatelyInReceivership {
        holder Secretary;
        over r;
        exercise secretary_moves_to_assess_immediately_6871(r);
        valid_when immediate_assessment_conditions_6871(r);
        effect create(deficiency_immediately_assessed_despite_6213a(r));
        window [-infinity, infinity];
    };
}
relation tax_court_redetermination_proceeding_pending(r: ReceivershipMatter) kind empirical {
    label en official "proceedings for the redetermination of the deficiency pursuant to a petition to the Tax Court are pending";
}
pub relation claim_may_be_presented_to_receivership_or_title_11_court(r: ReceivershipMatter) kind institutional {
    label en unofficial "claims for the deficiency and for interest, additional amounts, and additions to the tax may be presented for adjudication to the court before which the receivership proceeding (or the title 11 case) is pending";
}
@source(IRC_S6871_C, relation = formalizes, coverage = exact, quote = "claims for the deficiency and for interest, additional amounts, and additions to the tax may be presented, for adjudication in accordance with law, to the court before which the receivership proceeding (or the case under title 11 of the United States Code) is pending")
rule S6871c1ClaimMayBePresented strict {
    for r: ReceivershipMatter;
    when deficiency_determined_in_respect_of_subtitle_a_b_or_chapter_41_to_44_tax(r);
    then claim_may_be_presented_to_receivership_or_title_11_court(r);
}
relation taxpayer_files_tax_court_petition_for_redetermination(r: ReceivershipMatter) kind empirical {
    label en unofficial "the taxpayer files a petition for redetermination of the deficiency with the Tax Court";
}
relation taxpayer_of_receivership_matter(r: ReceivershipMatter, t: Person) kind empirical {
    label en unofficial "the taxpayer for whom the receiver was appointed";
}
@source(IRC_S6871_C, relation = formalizes, coverage = exact, quote = "no petition for any such redetermination shall be filed with the Tax Court after the appointment of the receiver")
rule S6871c2NoTaxCourtPetitionAfterReceiver strict {
    for r: ReceivershipMatter;
    for t: Person;
    when receiver_appointed_for_taxpayer_in_receivership_proceeding(r)
        and taxpayer_of_receivership_matter(r, t);
    then prohibition NoTaxCourtPetitionAfterReceiverAppointed {
        bearer t;
        action taxpayer_files_tax_court_petition_for_redetermination(r);
        window [-infinity, infinity];
    };
}

// --- §6872: suspension of period on assessment ---------------------------------------------------------
relation regulations_under_6036_require_notice_of_qualification(p: Person) kind empirical {
    label en official "the regulations issued pursuant to section 6036 require the giving of notice by any fiduciary in a title 11 case, or by a receiver in any other court proceeding, to the Secretary of his qualification as such";
}
relation proceeding_instituted_on(p: Person, d: Date) kind empirical {
    label en official "the date of the institution of the proceeding";
}
relation notice_of_qualification_received_by_secretary_on(p: Person, d: Date) kind empirical {
    label en official "the date upon which the notice from the receiver or other fiduciary is received by the Secretary";
}
relation suspension_end_candidate(p: Person, d: Date) kind institutional {
    label en unofficial "a candidate end of the suspension: 30 days after the notice is received, or 2 years after the institution of the proceeding";
}
@source(IRC_S6872, relation = formalizes, coverage = exact, quote = "to a date 30 days after the date upon which the notice from the receiver or other fiduciary is received by the Secretary")
rule S6872CandidateNotice strict {
    for p: Person;
    for n: Date;
    when regulations_under_6036_require_notice_of_qualification(p)
        and notice_of_qualification_received_by_secretary_on(p, n);
    then suspension_end_candidate(p, add_calendar_period(n, 30 calendar_day));
}
@source(IRC_S6872, relation = formalizes, coverage = exact, quote = "but the suspension under this sentence shall in no case be for a period in excess of 2 years")
rule S6872CandidateTwoYears strict {
    for p: Person;
    for s: Date;
    when regulations_under_6036_require_notice_of_qualification(p)
        and proceeding_instituted_on(p, s);
    then suspension_end_candidate(p, add_calendar_period(s, 24 calendar_month));
}
relation earlier_suspension_end_candidate_exists(p: Person, d: Date) kind institutional {
    label en unofficial "a strictly earlier candidate end exists";
}
@source(IRC_S6872, relation = formalizes, coverage = exact, quote = "but the suspension under this sentence shall in no case be for a period in excess of 2 years")
rule S6872EarlierCandidate strict {
    for p: Person;
    for d: Date;
    for e: Date;
    when suspension_end_candidate(p, d)
        and suspension_end_candidate(p, e)
        and e < d;
    then earlier_suspension_end_candidate_exists(p, d);
}
pub relation assessment_period_suspended(p: Person, from: Date, to: Date) kind institutional {
    label en unofficial "the running of the period of limitations on the making of assessments is suspended from the institution of the proceeding to the earlier candidate end";
}
@source(IRC_S6872, relation = formalizes, coverage = exact, quote = "the running of the period of limitations on the making of assessments shall be suspended for the period from the date of the institution of the proceeding to a date 30 days after the date upon which the notice from the receiver or other fiduciary is received by the Secretary")
rule S6872Suspension strict {
    for p: Person;
    for s: Date;
    for e: Date;
    when proceeding_instituted_on(p, s)
        and suspension_end_candidate(p, e)
        and not_known(earlier_suspension_end_candidate_exists(p, e));
    then assessment_period_suspended(p, s, e);
}

// --- §6873: unpaid claims in receivership proceedings ------------------------------------------------
relation claim_for_taxes_allowed_in_receivership_proceeding_unpaid_portion(p: Person) kind empirical {
    label en official "a portion of a claim for taxes allowed in a receivership proceeding is unpaid";
}
relation receivership_proceeding_terminated(p: Person) kind empirical {
    label en official "the receivership proceeding has terminated";
}
relation notice_and_demand_from_secretary_made(p: Person) kind empirical {
    label en official "the Secretary has made notice and demand";
}
relation unpaid_receivership_claim_portion_paid(p: Person) kind empirical {
    label en unofficial "the unpaid portion of the claim has been paid by the taxpayer";
}
@source(IRC_S6873_A, relation = formalizes, coverage = exact, quote = "shall be paid by the taxpayer upon notice and demand from the Secretary after the termination of such proceeding")
rule S6873aPaymentDuty strict {
    for p: Person;
    when claim_for_taxes_allowed_in_receivership_proceeding_unpaid_portion(p)
        and receivership_proceeding_terminated(p)
        and notice_and_demand_from_secretary_made(p);
    then duty PayUnpaidReceivershipClaimAfterTermination {
        bearer p;
        beneficiary Secretary;
        goal achievement {
            condition unpaid_receivership_claim_portion_paid(p);
            window [-infinity, infinity];
        };
    };
}
