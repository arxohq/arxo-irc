// 26 U.S.C. §6672 — Failure to collect and pay over tax, or attempt to evade
// or defeat tax ("Trust Fund Recovery Penalty"): the underlying liability
// (a), the 60-day preliminary notice validity condition on ASSESSING it (b),
// the bond/refund-suit collection stay (c), the right of contribution among
// multiple liable persons (d), and the volunteer-board-member exemption (e).
// STAGE 2b, first of the seven named `pub` targets (coordinator instruction,
// 25.09.2026): `pub trust_fund_recovery_penalty`.
//
// JUDGMENT CALLS AND GAPS (see report):
//  - The "tax" §6672(a) reaches is any tax a person is "required to collect,
//    truthfully account for, and pay over" — the paradigm case is chapter 24
//    income tax withholding and the EMPLOYEE share of chapter 21 (FICA) tax
//    (both collected by the employer from the employee's wages and held "in
//    trust", hence the name). This module keys the underlying trust fund tax
//    to a single `us.irc.employment::WagePayment` (real imports:
//    `income_tax_withheld`, `fica_employee_tax`) rather than an aggregated
//    period total: the statute's liability is per "such tax", and a single
//    wage payment's withheld income tax and employee FICA share are both
//    "such tax" the responsible person failed to collect/pay over. A real
//    case ordinarily aggregates many wage payments into one quarterly Form
//    941 liability; this module does NOT compute that aggregation (no
//    `sum all ... where` over `WagePayment` — deliberately, per the
//    convention note in 01-shared.law about open-ended accumulation
//    patterns) — TECH_GAP for the quarterly-aggregate case, see TECH-GAPS
//    G496. Excise taxes and other chapter-collected trust fund taxes
//    (e.g. air transportation excise) are NOT modelled — same TECH_GAP.
//  - "willfully fails to collect... or willfully attempts... to evade" is a
//    DECISION-0194 evaluative element (the AGENT-BRIEF's own list names
//    "willful" as a channel item), modelled as an `external judgment
//    relation` with authority Secretary (the Trust Fund Recovery Penalty is
//    determined administratively in the first instance; a person who pays
//    and sues for refund litigates it in district court/Court of Federal
//    Claims per (c)(2), outside this package's scope this pass).
//  - "responsible person" (who is "required to collect, truthfully account
//    for, and pay over" the tax) is likewise a case-asserted fact
//    (`responsible_person_for_trust_fund_tax`): the multi-factor "responsible
//    person" test (control over finances, authority to sign checks, actual
//    knowledge, etc.) is judge-made doctrine, not itself a statutory test
//    this section states — classified EVALUATIVE-adjacent, not itself wired
//    as a DECISION-0194 channel (no textual "it is shown that..." phrase to
//    anchor one), consistent with how `01-assessment-authority-and-method.law`
//    and similar modules treat undefined-in-text multi-factor tests.
//  - §6672(b)'s 60-day preliminary notice is modelled as a `power`
//    (AssessTrustFundRecoveryPenalty) `valid_when` a single derived atom
//    combining the 60-day-precedence test (an exact date comparison via
//    `add_calendar_period`) OR the (b)(4) jeopardy exception — same pattern
//    as `02-procedural-requirements-6751.law`'s `penalty_assessment_condition_met`.
//    (b)(3)'s statute-of-limitations tolling is NOT modelled (needs
//    `us.irc.assessment::` §6501 integration this package does not import) —
//    TECH_GAP, see TECH-GAPS G496.
//  - §6672(c) (bond/refund-suit collection stay) is NOT modelled this pass:
//    it is a THREE-STEP collection-litigation sequence (payment + refund
//    claim + bond => collection stay => suit-or-lose-the-stay) whose proper
//    home is `collection` (F04, levy/proceeding machinery) more than
//    `penalties`; modelled here would require importing `collection` (not a
//    declared dependency) — TECH_GAP, TECH-GAPS G496.
//  - §6672(d) (contribution): modelled as a computable entitlement given a
//    case-asserted `proportionate_share_of` fact (the statute does not
//    itself state the allocation FORMULA among multiple responsible
//    persons — that is left to the paying person's proof in the separate
//    contribution proceeding — so the proportionate share itself is a case
//    fact, not derived; only "the excess over that share is recoverable" is
//    this section's own computable rule).
//  - §6672(e)'s proviso ("shall not apply if it results in no person being
//    liable") is modelled as a guard requiring a case-asserted
//    `other_responsible_person_remains_liable_for` fact before the immunity
//    fires — this package cannot itself enumerate "every other responsible
//    person" (that enumeration lives in the case, not the statute).

language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

use self::{
    IRC_S6672_A,
    IRC_S6672_B,
    IRC_S6672_D,
    IRC_S6672_E,
    Person,
    Secretary,
    WagePayment,
};

// --- §6672(a): the underlying liability -------------------------------------

pub relation trust_fund_tax_amount(pay: WagePayment, amount: Money) kind institutional {
    label en unofficial "the total amount of tax required to be collected, truthfully accounted for, and paid over with respect to this wage payment (withheld income tax plus the employee share of FICA)";
}
@source(IRC_S6672_A, relation = formalizes, coverage = partial, quote = "be liable to a penalty equal to the total amount of the tax evaded, or not collected, or not accounted for and paid over")
rule TrustFundTaxAmountBothWithheld strict {
    for pay: WagePayment;
    for withheld: Money;
    for fica: Money;
    when us.irc.employment::income_tax_withheld(pay, withheld)
        and us.irc.employment::fica_employee_tax(pay, fica);
    then trust_fund_tax_amount(pay, withheld + fica);
}

relation responsible_person_for_trust_fund_tax(p: Person, pay: WagePayment) kind empirical {
    label en official "any person required to collect, truthfully account for, and pay over any tax imposed by this title";
}
pub external judgment relation willfully_failed_to_collect_or_pay_over(p: Person, pay: WagePayment) {
    authority Secretary;
    label en official "willfully fails to collect such tax, or truthfully account for and pay over such tax, or willfully attempts in any manner to evade or defeat any such tax or the payment thereof";
}

pub relation trust_fund_recovery_penalty(p: Person, pay: WagePayment, amount: Money) kind institutional {
    label en official "shall, in addition to other penalties provided by law, be liable to a penalty equal to the total amount of the tax evaded, or not collected, or not accounted for and paid over";
}
@source(IRC_S6672_A, relation = formalizes, coverage = exact, quote = "shall, in addition to other penalties provided by law, be liable to a penalty equal to the total amount of the tax evaded, or not collected, or not accounted for and paid over")
rule Section6672aLiability defeasible {
    for p: Person;
    for org: Person;
    for pay: WagePayment;
    for amount: Money;
    when responsible_person_for_trust_fund_tax(p, pay)
        and willfully_failed_to_collect_or_pay_over(p, pay)
        and trust_fund_tax_amount(pay, amount);
    then trust_fund_recovery_penalty(p, pay, amount);
    unless volunteer_board_member_exemption_conditions_met(p, org, pay)
        and other_responsible_person_remains_liable_for(p, pay)
        and responsible_person_for_trust_fund_tax(p, pay)
        and willfully_failed_to_collect_or_pay_over(p, pay)
        and trust_fund_tax_amount(pay, amount);
}

// --- §6672(b): 60-day preliminary notice — validity condition on assessment

relation trust_fund_recovery_notice_mailed_or_delivered_on(p: Person, pay: WagePayment, d: Date) kind empirical {
    label en official "the Secretary notifies the taxpayer in writing by mail to an address as determined under section 6212(b) or in person that the taxpayer shall be subject to an assessment of such penalty";
}
relation trust_fund_recovery_notice_and_demand_on(p: Person, pay: WagePayment, d: Date) kind empirical {
    label en unofficial "the date of the notice and demand of the section 6672(a) penalty (the assessment-adjacent event the 60-day preliminary notice must precede)";
}
relation trust_fund_recovery_collection_in_jeopardy(p: Person, pay: WagePayment) kind empirical {
    label en official "the Secretary finds that the collection of the penalty is in jeopardy";
}

pub relation trust_fund_recovery_assessment_condition_met(p: Person, pay: WagePayment) kind institutional {
    label en unofficial "the section 6672(b) precondition for assessing this penalty is satisfied (single atom for the power's valid_when)";
}
@source(IRC_S6672_B, relation = formalizes, coverage = exact, quote = "shall precede any notice and demand of any penalty under subsection (a) by at least 60 days")
rule Section6672bConditionMetByNotice strict {
    for p: Person;
    for pay: WagePayment;
    for mailed: Date;
    for demand: Date;
    when trust_fund_recovery_notice_mailed_or_delivered_on(p, pay, mailed)
        and trust_fund_recovery_notice_and_demand_on(p, pay, demand)
        and demand >= add_calendar_period(mailed, 60 calendar_day);
    then trust_fund_recovery_assessment_condition_met(p, pay);
}
@source(IRC_S6672_B, relation = formalizes, coverage = exact, quote = "This subsection shall not apply if the Secretary finds that the collection of the penalty is in jeopardy")
rule Section6672bConditionMetByJeopardy strict {
    for p: Person;
    for pay: WagePayment;
    when trust_fund_recovery_collection_in_jeopardy(p, pay);
    then trust_fund_recovery_assessment_condition_met(p, pay);
}

relation secretary_moves_to_assess_trust_fund_recovery_penalty(p: Person, pay: WagePayment) kind empirical {
    label en unofficial "the exercise fact of the section 6672(b) assessment power";
}
pub relation trust_fund_recovery_penalty_validly_assessable(p: Person, pay: WagePayment) kind institutional {
    label en unofficial "the exercise of the section 6672(b) assessment power over this penalty is valid; an invalid exercise gives POWER_INVALID_EXERCISE and no effect (E-0239)";
}
@source(IRC_S6672_B, relation = formalizes, coverage = exact, quote = "No penalty shall be imposed under subsection (a) unless the Secretary notifies the taxpayer in writing by mail to an address as determined under section 6212(b) or in person that the taxpayer shall be subject to an assessment of such penalty")
rule Section6672bAssessmentPower strict {
    for p: Person;
    for pay: WagePayment;
    when secretary_moves_to_assess_trust_fund_recovery_penalty(p, pay);
    then power AssessTrustFundRecoveryPenalty {
        holder Secretary;
        over pay;
        exercise secretary_moves_to_assess_trust_fund_recovery_penalty(p, pay);
        valid_when trust_fund_recovery_assessment_condition_met(p, pay);
        effect create(trust_fund_recovery_penalty_validly_assessable(p, pay));
        window [@1954-08-16, infinity);
    };
}

// --- §6672(d): right of contribution -----------------------------------------

relation trust_fund_recovery_penalty_paid_by(p: Person, pay: WagePayment, amount: Money) kind empirical {
    label en unofficial "case fact: this person actually paid this amount toward the section 6672(a) penalty for this wage payment";
}
relation proportionate_share_of(p: Person, pay: WagePayment, amount: Money) kind empirical {
    label en unofficial "case fact (proved in the separate contribution proceeding): this person's proportionate share of the total penalty among all persons liable";
}
pub relation trust_fund_recovery_contribution_recoverable(p: Person, pay: WagePayment, amount: Money) kind institutional {
    label en official "each person who paid such penalty shall be entitled to recover from other persons who are liable for such penalty an amount equal to the excess of the amount paid by such person over such person's proportionate share of the penalty";
}
@source(IRC_S6672_D, relation = formalizes, coverage = exact, quote = "each person who paid such penalty shall be entitled to recover from other persons who are liable for such penalty an amount equal to the excess of the amount paid by such person over such person's proportionate share of the penalty")
rule Section6672dContribution strict {
    for p: Person;
    for pay: WagePayment;
    for paid: Money;
    for share: Money;
    when trust_fund_recovery_penalty_paid_by(p, pay, paid)
        and proportionate_share_of(p, pay, share)
        and paid > share;
    then trust_fund_recovery_contribution_recoverable(p, pay, max(0.00 USD, paid - share));
}

// --- §6672(e): exception for volunteer board members of exempt organizations

relation serves_exempt_organization_board(p: Person, org: Person) kind empirical {
    label en unofficial "the person is an unpaid, volunteer member of the board of trustees or directors of an organization exempt from tax under subtitle A";
}
relation solely_honorary_capacity(p: Person, org: Person) kind empirical {
    label en official "is solely serving in an honorary capacity";
}
relation no_day_to_day_or_financial_participation(p: Person, org: Person) kind empirical {
    label en official "does not participate in the day-to-day or financial operations of the organization";
}
relation no_actual_knowledge_of_failure(p: Person, pay: WagePayment) kind empirical {
    label en official "does not have actual knowledge of the failure on which such penalty is imposed";
}
relation other_responsible_person_remains_liable_for(p: Person, pay: WagePayment) kind empirical {
    label en unofficial "case fact needed for the (e) proviso: at least one OTHER person remains liable for this penalty if this person is exempted (the statute's own 'shall not apply if it results in no person being liable' safety valve — this package cannot enumerate all responsible persons itself)";
}

pub relation volunteer_board_member_exemption_conditions_met(p: Person, org: Person, pay: WagePayment) kind institutional {
    label en unofficial "the three section 6672(e)(1)-(3) conditions are all met (single atom)";
}
@source(IRC_S6672_E, relation = formalizes, coverage = exact, quote = "is solely serving in an honorary capacity")
rule Section6672eConditionsMet strict {
    for p: Person;
    for org: Person;
    for pay: WagePayment;
    when serves_exempt_organization_board(p, org)
        and solely_honorary_capacity(p, org)
        and no_day_to_day_or_financial_participation(p, org)
        and no_actual_knowledge_of_failure(p, pay);
    then volunteer_board_member_exemption_conditions_met(p, org, pay);
}
// The (e) exception is wired directly as an `unless` defeater on
// `Section6672aLiability` above (not a separate `immunity` + `priority`
// pair): `priority` may only arbitrate `defeasible` rules or conflicting
// norm_templates on the same head (LDC-E4105), and this section's liability
// is a plain institutional fact, not a norm_template — the same shape
// `06-definitions-and-fraud-6663-6664.law`'s reasonable-cause exceptions
// already use for a "shall not apply if ..." proviso on a calculation rule.
