language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

use self::{
    Claim,
    FailureContext,
    IRC_S6693_A,
    IRC_S6693_B,
    IRC_S6693_C,
    IRC_S6693_D,
    IRC_S6695A_A,
    IRC_S6695A_B,
    IRC_S6696_A,
    IRC_S6696_B,
    IRC_S6696_D,
    IRC_S6696_E,
    IRC_S6698_A,
    IRC_S6698_C,
    IRC_S6698_D,
    IRC_S6699_A,
    IRC_S6699_C,
    IRC_S6699_D,
    Person,
    Return,
    calendar_months_exceeds_tracked_horizon,
    calendar_months_or_fraction,
    deficiency_procedure_would_apply_to_penalty,
    failure_by,
    failure_continued_through,
    failure_count,
    failure_days,
    months_or_fraction_query,
    reasonable_cause_and_no_willful_neglect,
    reasonable_cause_shown,
};

// 26 U.S.C. §§6693, 6695A, 6695B (Pub. L. 119-21), 6696, 6698, 6699 (IRC-16
// stage 2, DECISION-0379).
//
// JUDGMENT CALLS AND GAPS:
//  - §6693(a)(2)(G) (Trump accounts, Pub. L. 119-21 sec. 70204(a)(3)) and the
//    whole of §6695B (sec. 70512(k)) enter through `us.irc.temporal`; both are
//    windowed rules `effective [@2026-01-01, infinity)`. §6695B keys the
//    boundary exactly on the certification date (text: "certifications
//    provided after December 31, 2025"); §6693(a)(2)(G) only approximates the
//    "taxable years beginning after December 31, 2025" boundary by legal_time
//    (TECH-GAPS G3102).
//  - §6698/§6699: months are counted with the shared month-or-fraction
//    machinery (01-shared.law); a failure past its 12-month tracked horizon is
//    exactly the statutory 12-month cap. The per-partner (shareholder) dollar
//    amount is indexed by section (e): only the Rev. Proc. 2024-40 (2026) and
//    2025-32 (2027) figures are pinned (SOURCE_GAP otherwise). (e)(2) rounding
//    is not recomputed: the published figure is already rounded.
//  - §6695A: the substantial-valuation-misstatement, substantial estate or
//    gift valuation understatement and gross valuation misstatement tests of
//    §6662(e)/(g)/(h) are read as appraisal-level facts (the statute asks
//    whether the claimed value BASED ON THE APPRAISAL results in one); the
//    §6664(a) underpayment attributable to the misstatement is a case fact.
//  - §6696(c) (claim for refund "in accordance with regulations") delegates
//    the form of the claim; it sets no rule of its own (NON_NORMATIVE).
//  - §6696(d)(1) periods are computed with literal month counts (36; 72 for
//    §6695B) from the filing date of the return or claim.

// --- §6693: failure to provide reports on certain tax-favored accounts ----------------------
pub enum Report6693Provision {
    Ira408il;
    ArcherMsa220h;
    Hsa223h;
    QualifiedTuition529d;
    Able529Ad;
    Coverdell530h;
    TrumpAccount530Ai;
    label en unofficial "the provision under which the report required by section 6693(a)(2) is filed";
}
relation failed_to_file_report_under_provision(f: FailureContext, k: Report6693Provision) kind empirical {
    label en official "a person required to file a report under the provision fails to file such report at the time and in the manner required by such provision";
}
pub relation report_provision_referred_to_in_6693a2(k: Report6693Provision) kind institutional {
    label en unofficial "the provision is one referred to in paragraph (2) of section 6693(a)";
}
@source(IRC_S6693_A, relation = formalizes, coverage = exact, quote = "subsections (i) and (l) of section 408 (relating to individual retirement plans)")
assert report_provision_referred_to_in_6693a2(Ira408il);
@source(IRC_S6693_A, relation = formalizes, coverage = exact, quote = "section 220(h) (relating to Archer MSAs)")
assert report_provision_referred_to_in_6693a2(ArcherMsa220h);
@source(IRC_S6693_A, relation = formalizes, coverage = exact, quote = "section 223(h) (relating to health savings accounts)")
assert report_provision_referred_to_in_6693a2(Hsa223h);
@source(IRC_S6693_A, relation = formalizes, coverage = exact, quote = "section 529(d) (relating to qualified tuition programs)")
assert report_provision_referred_to_in_6693a2(QualifiedTuition529d);
@source(IRC_S6693_A, relation = formalizes, coverage = exact, quote = "section 529A(d) (relating to qualified ABLE programs)")
assert report_provision_referred_to_in_6693a2(Able529Ad);
@source(IRC_S6693_A, relation = formalizes, coverage = exact, quote = "section 530(h) (relating to Coverdell education savings accounts)")
assert report_provision_referred_to_in_6693a2(Coverdell530h);
relation report_is_information_return_6724d1Ci_or_payee_statement_X(f: FailureContext) kind empirical {
    label en official "the report is an information return described in section 6724(d)(1)(C)(i) or a payee statement described in section 6724(d)(2)(X)";
}
pub relation ira_and_similar_report_failure_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "a penalty of $50 for each failure to file the report";
}
@source(IRC_S6693_A, relation = formalizes, coverage = exact, quote = "such person shall pay a penalty of $50 for each failure unless it is shown that such failure is due to reasonable cause")
rule S6693a1ReportFailurePenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for k: Report6693Provision;
    when failure_by(f, p)
        and failed_to_file_report_under_provision(f, k)
        and report_provision_referred_to_in_6693a2(k);
    then ira_and_similar_report_failure_penalty(f, round(IraReportFailurePenalty, 2, "HALF_UP"));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and failed_to_file_report_under_provision(f, k)
        and report_provision_referred_to_in_6693a2(k);
    unless report_is_information_return_6724d1Ci_or_payee_statement_X(f)
        and failure_by(f, p)
        and failed_to_file_report_under_provision(f, k)
        and report_provision_referred_to_in_6693a2(k);
}
@source(us.irc.temporal::PL119_21_S70204, relation = formalizes, coverage = exact, quote = "section 530A(i) (relating to Trump accounts)")
rule S6693a2GTrumpAccountReportPenalty defeasible {
    effective [@2026-01-01, infinity);
    for f: FailureContext;
    for p: Person;
    when failure_by(f, p)
        and failed_to_file_report_under_provision(f, TrumpAccount530Ai);
    then ira_and_similar_report_failure_penalty(f, round(IraReportFailurePenalty, 2, "HALF_UP"));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and failed_to_file_report_under_provision(f, TrumpAccount530Ai);
    unless report_is_information_return_6724d1Ci_or_payee_statement_X(f)
        and failure_by(f, p)
        and failed_to_file_report_under_provision(f, TrumpAccount530Ai);
}
relation overstated_designated_nondeductible_contributions(f: FailureContext) kind empirical {
    label en official "an individual required to furnish information under section 408(o)(4) as to the amount of designated nondeductible contributions overstates the amount of such contributions made for such taxable year";
}
pub relation nondeductible_contribution_overstatement_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "a penalty of $100 for each such overstatement";
}
@source(IRC_S6693_B, relation = formalizes, coverage = exact, quote = "shall pay a penalty of $100 for each such overstatement unless it is shown that such overstatement is due to reasonable cause")
rule S6693b1OverstatementPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and overstated_designated_nondeductible_contributions(f)
        and failure_count(f, n);
    then nondeductible_contribution_overstatement_penalty(f, round(NondeductibleContributionOverstatementPenalty * n, 2, "HALF_UP"));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and overstated_designated_nondeductible_contributions(f)
        and failure_count(f, n);
}
relation failed_to_file_form_under_408o4(f: FailureContext) kind empirical {
    label en official "an individual fails to file a form required to be filed by the Secretary under section 408(o)(4)";
}
pub relation nondeductible_contribution_form_failure_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "a penalty of $50 for each such failure";
}
@source(IRC_S6693_B, relation = formalizes, coverage = exact, quote = "shall pay a penalty of $50 for each such failure unless it is shown that such failure is due to reasonable cause")
rule S6693b2FormFailurePenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and failed_to_file_form_under_408o4(f)
        and failure_count(f, n);
    then nondeductible_contribution_form_failure_penalty(f, round(NondeductibleContributionFormFailurePenalty * n, 2, "HALF_UP"));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and failed_to_file_form_under_408o4(f)
        and failure_count(f, n);
}
relation employer_failed_to_provide_408l2C_notices(f: FailureContext) kind empirical {
    label en official "an employer fails to provide 1 or more notices required by section 408(l)(2)(C)";
}
relation trustee_or_issuer_failed_to_provide_408i_statements(f: FailureContext) kind empirical {
    label en official "a trustee or issuer fails to provide 1 or more statements required by the last sentence of section 408(i)";
}
relation trustee_or_issuer_failed_to_provide_408l2B_descriptions(f: FailureContext) kind empirical {
    label en official "a trustee or issuer fails to provide 1 or more summary descriptions required by section 408(l)(2)(B)";
}
pub relation simple_retirement_notice_failure_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "a penalty of $50 for each day on which such failures continue";
}
@source(IRC_S6693_C, relation = formalizes, coverage = exact, quote = "An employer who fails to provide 1 or more notices required by section 408(l)(2)(C) shall pay a penalty of $50 for each day on which such failures continue")
rule S6693cEmployerPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and employer_failed_to_provide_408l2C_notices(f)
        and failure_days(f, n);
    then simple_retirement_notice_failure_penalty(f, round(SimpleRetirementNoticePenaltyPerDay * n, 2, "HALF_UP"));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and employer_failed_to_provide_408l2C_notices(f)
        and failure_days(f, n);
}
@source(IRC_S6693_C, relation = formalizes, coverage = exact, quote = "to provide 1 or more statements required by the last sentence of section 408(i) shall pay a penalty of $50 for each day on which such failures continue")
rule S6693cTrusteeStatementsPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and trustee_or_issuer_failed_to_provide_408i_statements(f)
        and failure_days(f, n);
    then simple_retirement_notice_failure_penalty(f, round(SimpleRetirementNoticePenaltyPerDay * n, 2, "HALF_UP"));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and trustee_or_issuer_failed_to_provide_408i_statements(f)
        and failure_days(f, n);
}
@source(IRC_S6693_C, relation = formalizes, coverage = exact, quote = "to provide 1 or more summary descriptions required by section 408(l)(2)(B) shall pay a penalty of $50 for each day on which such failures continue")
rule S6693cTrusteeDescriptionsPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and trustee_or_issuer_failed_to_provide_408l2B_descriptions(f)
        and failure_days(f, n);
    then simple_retirement_notice_failure_penalty(f, round(SimpleRetirementNoticePenaltyPerDay * n, 2, "HALF_UP"));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and trustee_or_issuer_failed_to_provide_408l2B_descriptions(f)
        and failure_days(f, n);
}
@source(IRC_S6693_D, relation = formalizes, coverage = exact, quote = "Subchapter B of chapter 63 (relating to deficiency procedures for income, estate, gift, and certain excise taxes) does not apply to the assessment or collection of any penalty imposed by this section")
rule S6693dDeficiencyProcedureImmunityReports defeasible {
    for f: FailureContext;
    for p: Person;
    for amt: Money;
    when ira_and_similar_report_failure_penalty(f, amt)
        and failure_by(f, p);
    then immunity S6693dDeficiencyProcedureImmunityReportsHolder {
        holder p;
        protected_effect deficiency_procedure_would_apply_to_penalty(f);
        window [-infinity, infinity];
    };
}

// --- §6695A: substantial or gross valuation misstatements attributable to incorrect appraisals ---
relation appraisal_prepared_by_person(f: FailureContext) kind empirical {
    label en official "a person prepares an appraisal of the value of property";
}
relation appraiser_knew_or_should_have_known_appraisal_used_with_return(f: FailureContext) kind empirical {
    label en official "such person knows, or reasonably should have known, that the appraisal would be used in connection with a return or a claim for refund";
}
relation appraisal_based_claimed_value_is_substantial_valuation_misstatement(f: FailureContext) kind empirical {
    label en official "the claimed value of the property on a return or claim for refund which is based on such appraisal results in a substantial valuation misstatement under chapter 1 (within the meaning of section 6662(e))";
}
relation appraisal_based_claimed_value_is_substantial_estate_or_gift_understatement(f: FailureContext) kind empirical {
    label en official "the claimed value results in a substantial estate or gift tax valuation understatement (within the meaning of section 6662(g))";
}
relation appraisal_based_claimed_value_is_gross_valuation_misstatement(f: FailureContext) kind empirical {
    label en official "the claimed value results in a gross valuation misstatement (within the meaning of section 6662(h))";
}
relation appraisal_penalty_condition_6695A(f: FailureContext) kind institutional {
    label en unofficial "the section 6695A(a) conditions are met for the appraisal";
}
@source(IRC_S6695A_A, relation = formalizes, coverage = exact, quote = "a substantial valuation misstatement under chapter 1 (within the meaning of section 6662(e))")
rule S6695AaSubstantialValuation strict {
    for f: FailureContext;
    when appraisal_prepared_by_person(f)
        and appraiser_knew_or_should_have_known_appraisal_used_with_return(f)
        and appraisal_based_claimed_value_is_substantial_valuation_misstatement(f);
    then appraisal_penalty_condition_6695A(f);
}
@source(IRC_S6695A_A, relation = formalizes, coverage = exact, quote = "a substantial estate or gift tax valuation understatement (within the meaning of section 6662(g))")
rule S6695AaEstateOrGift strict {
    for f: FailureContext;
    when appraisal_prepared_by_person(f)
        and appraiser_knew_or_should_have_known_appraisal_used_with_return(f)
        and appraisal_based_claimed_value_is_substantial_estate_or_gift_understatement(f);
    then appraisal_penalty_condition_6695A(f);
}
@source(IRC_S6695A_A, relation = formalizes, coverage = exact, quote = "or a gross valuation misstatement (within the meaning of section 6662(h))")
rule S6695AaGross strict {
    for f: FailureContext;
    when appraisal_prepared_by_person(f)
        and appraiser_knew_or_should_have_known_appraisal_used_with_return(f)
        and appraisal_based_claimed_value_is_gross_valuation_misstatement(f);
    then appraisal_penalty_condition_6695A(f);
}
relation underpayment_attributable_to_appraisal_misstatement(f: FailureContext, amount: Money) kind empirical {
    label en unofficial "the amount of the underpayment (as defined in section 6664(a)) attributable to the misstatement (case fact)";
}
relation gross_income_received_from_appraisal(f: FailureContext, amount: Money) kind empirical {
    label en unofficial "the gross income received by the person from the preparation of the appraisal (case fact)";
}
pub external judgment relation appraised_value_more_likely_than_not_proper(p: Person, f: FailureContext) {
    authority Secretary;
    label en official "the person establishes to the satisfaction of the Secretary that the value established in the appraisal was more likely than not the proper value";
}
pub relation appraisal_penalty_6695A(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "the lesser of the greater of 10 percent of the underpayment or $1,000, and 125 percent of the gross income received from the appraisal";
}
@source(IRC_S6695A_B, relation = formalizes, coverage = exact, quote = "The amount of the penalty imposed under subsection (a) on any person with respect to an appraisal shall be equal to the lesser of—")
rule S6695AbAmount defeasible {
    for f: FailureContext;
    for p: Person;
    for u: Money;
    for g: Money;
    when failure_by(f, p)
        and appraisal_penalty_condition_6695A(f)
        and underpayment_attributable_to_appraisal_misstatement(f, u)
        and gross_income_received_from_appraisal(f, g);
    then appraisal_penalty_6695A(f, min(max(round(u * AppraisalPenaltyRate, 2, "HALF_UP"), round(AppraisalPenaltyMinimum, 2, "HALF_UP")), round(g * AppraisalPenaltyIncomeMultiple, 2, "HALF_UP")));
    unless appraised_value_more_likely_than_not_proper(p, f)
        and failure_by(f, p)
        and appraisal_penalty_condition_6695A(f)
        and underpayment_attributable_to_appraisal_misstatement(f, u)
        and gross_income_received_from_appraisal(f, g);
}

// --- §6695B (added by Pub. L. 119-21 sec. 70512): supplier certification misstatements ---------------
relation supplier_certification_provided_on(f: FailureContext, d: Date) kind empirical {
    label en unofficial "the date on which the certification described in clause (iii)(II)(bb) of section 7701(a)(52)(D) was provided";
}
relation certification_provider_knew_or_should_have_known_used_in_determination(f: FailureContext) kind empirical {
    label en official "the person provides the certification and knows, or reasonably should have known, that the certification would be used in connection with a determination under section 7701(a)(52)";
}
relation certification_provider_knew_or_should_have_known_inaccurate(f: FailureContext) kind empirical {
    label en official "the person knows, or reasonably should have known, that such certification is inaccurate or false with respect to whether the property was produced by a prohibited foreign entity, or the total direct costs or total direct material costs provided";
}
relation inaccuracy_resulted_in_disallowance_of_applicable_energy_credit(f: FailureContext) kind empirical {
    label en official "the inaccuracy or falsity resulted in the disallowance of an applicable energy credit (as defined in section 6662(m)(2))";
}
relation income_tax_understatement_from_certification(f: FailureContext, amount: Money) kind empirical {
    label en unofficial "the understatement of income tax (within the meaning of section 6662(d)(2)) for the taxable year resulting from the inaccuracy (case fact)";
}
relation tax_required_to_be_shown_for_certification_year(f: FailureContext, amount: Money) kind empirical {
    label en unofficial "the tax required to be shown on the return for the taxable year (case fact)";
}
relation underpayment_solely_attributable_to_certification_inaccuracy(f: FailureContext, amount: Money) kind empirical {
    label en unofficial "the amount of the underpayment (as defined in section 6664(a)) solely attributable to the inaccuracy or falsity (case fact)";
}
pub relation supplier_certification_penalty_6695B(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "the greater of 10 percent of the underpayment solely attributable to the inaccuracy or falsity, or $5,000";
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = exact, quote = "then such person shall pay a penalty in the amount determined under subsection (b)")
rule S6695BSupplierCertificationPenalty defeasible {
    effective [@2026-01-01, infinity);
    for f: FailureContext;
    for p: Person;
    for d: Date;
    for u: Money;
    for t: Money;
    for s: Money;
    when failure_by(f, p)
        and supplier_certification_provided_on(f, d)
        and d > @2025-12-31
        and certification_provider_knew_or_should_have_known_used_in_determination(f)
        and certification_provider_knew_or_should_have_known_inaccurate(f)
        and inaccuracy_resulted_in_disallowance_of_applicable_energy_credit(f)
        and income_tax_understatement_from_certification(f, u)
        and tax_required_to_be_shown_for_certification_year(f, t)
        and u > min(round(t * SupplierCertificationUnderstatementPercent, 2, "HALF_UP"), round(SupplierCertificationUnderstatementDollarThreshold, 2, "HALF_UP"))
        and underpayment_solely_attributable_to_certification_inaccuracy(f, s);
    then supplier_certification_penalty_6695B(f, max(round(s * SupplierCertificationPenaltyRate, 2, "HALF_UP"), round(SupplierCertificationPenaltyMinimum, 2, "HALF_UP")));
    unless reasonable_cause_and_no_willful_neglect(p, f)
        and failure_by(f, p)
        and supplier_certification_provided_on(f, d)
        and d > @2025-12-31
        and certification_provider_knew_or_should_have_known_used_in_determination(f)
        and certification_provider_knew_or_should_have_known_inaccurate(f)
        and inaccuracy_resulted_in_disallowance_of_applicable_energy_credit(f)
        and income_tax_understatement_from_certification(f, u)
        and tax_required_to_be_shown_for_certification_year(f, t)
        and u > min(round(t * SupplierCertificationUnderstatementPercent, 2, "HALF_UP"), round(SupplierCertificationUnderstatementDollarThreshold, 2, "HALF_UP"))
        and underpayment_solely_attributable_to_certification_inaccuracy(f, s);
}

// --- §6696: rules applicable with respect to sections 6694, 6695, 6695A (and 6695B) ----------------
pub enum PreparerPenaltySection {
    Section6694a;
    Section6694b;
    Section6695;
    Section6695A;
    Section6695B;
    label en unofficial "the preparer or appraiser penalty section a penalty is assessed under, for the section 6696 rules";
}
relation preparer_penalty_section_of(f: FailureContext, k: PreparerPenaltySection) kind empirical {
    label en unofficial "the penalty is assessed under the named section";
}
relation return_or_claim_filed_on(f: FailureContext, d: Date) kind empirical {
    label en unofficial "the date on which the return or claim for refund with respect to which the penalty is assessed was filed";
}
relation preparer_penalty_assessment_date(f: FailureContext, d: Date) kind empirical {
    label en unofficial "the date on which the penalty is (or is proposed to be) assessed";
}
relation preparer_penalty_paid_on(f: FailureContext, d: Date) kind empirical {
    label en unofficial "the date the penalty was paid";
}
relation preparer_penalty_refund_claim_filed_on(f: FailureContext, d: Date) kind empirical {
    label en unofficial "the date the claim for refund of an overpayment of the penalty was filed";
}
relation refund_claim_governed_by_6694d(f: FailureContext) kind empirical {
    label en official "the claim for refund is one governed by section 6694(d)";
}
pub relation preparer_penalty_assessment_timely_6696d1(f: FailureContext) kind institutional {
    label en unofficial "the penalty is assessed within the period of section 6696(d)(1)";
}
@source(IRC_S6696_D, relation = formalizes, coverage = exact, quote = "shall be assessed within 3 years after the return or claim for refund with respect to which the penalty is assessed was filed")
rule S6696d1Assessment3Years defeasible {
    for f: FailureContext;
    for k: PreparerPenaltySection;
    for r: Date;
    for a: Date;
    when preparer_penalty_section_of(f, k)
        and return_or_claim_filed_on(f, r)
        and preparer_penalty_assessment_date(f, a)
        and a <= add_calendar_period(r, 36 calendar_month)
        and preparer_penalty_three_year_kind(k);
    then preparer_penalty_assessment_timely_6696d1(f);
}
relation preparer_penalty_three_year_kind(k: PreparerPenaltySection) kind institutional {
    label en unofficial "the penalty is under section 6694(a), 6695, or 6695A (three-year assessment period)";
}
@source(IRC_S6696_D, relation = formalizes, coverage = exact, quote = "The amount of any penalty under section 6694(a), 6695, or 6695A shall be assessed within 3 years")
assert preparer_penalty_three_year_kind(Section6694a);
@source(IRC_S6696_D, relation = formalizes, coverage = exact, quote = "The amount of any penalty under section 6694(a), 6695, or 6695A shall be assessed within 3 years")
assert preparer_penalty_three_year_kind(Section6695);
@source(IRC_S6696_D, relation = formalizes, coverage = exact, quote = "The amount of any penalty under section 6694(a), 6695, or 6695A shall be assessed within 3 years")
assert preparer_penalty_three_year_kind(Section6695A);
@source(IRC_S6696_D, relation = formalizes, coverage = exact, quote = "In the case of any penalty under section 6694(b), the penalty may be assessed, or a proceeding in court for the collection of the penalty may be begun without assessment, at any time")
rule S6696d1Assessment6694bAnyTime defeasible {
    for f: FailureContext;
    when preparer_penalty_section_of(f, Section6694b);
    then preparer_penalty_assessment_timely_6696d1(f);
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = exact, quote = "(or, in the case of any penalty under section 6695B, 6 years)")
rule S6696d1Assessment6695B6Years defeasible {
    effective [@2026-01-01, infinity);
    for f: FailureContext;
    for r: Date;
    for a: Date;
    when preparer_penalty_section_of(f, Section6695B)
        and return_or_claim_filed_on(f, r)
        and preparer_penalty_assessment_date(f, a)
        and a <= add_calendar_period(r, 72 calendar_month);
    then preparer_penalty_assessment_timely_6696d1(f);
}
relation preparer_penalty_late_assessment_effect(f: FailureContext) kind institutional {
    label en unofficial "the effect of assessing, or bringing a proceeding to collect, the penalty after the section 6696(d)(1) period has expired";
}
relation preparer_penalty_assessment_period_expired(f: FailureContext) kind institutional {
    label en unofficial "the section 6696(d)(1) period has expired without a timely assessment";
}
@source(IRC_S6696_D, relation = formalizes, coverage = partial, quote = "and no proceeding in court without assessment for the collection of such tax shall be begun after the expiration of such period")
rule S6696d1PeriodExpired defeasible {
    for f: FailureContext;
    for k: PreparerPenaltySection;
    for r: Date;
    for a: Date;
    when preparer_penalty_section_of(f, k)
        and return_or_claim_filed_on(f, r)
        and preparer_penalty_assessment_date(f, a)
        and not_known(preparer_penalty_assessment_timely_6696d1(f));
    then preparer_penalty_assessment_period_expired(f);
}
@source(IRC_S6696_D, relation = formalizes, coverage = exact, quote = "no proceeding in court without assessment for the collection of such tax shall be begun after the expiration of such period")
rule S6696d1LimitationImmunity defeasible {
    for f: FailureContext;
    for p: Person;
    when failure_by(f, p)
        and preparer_penalty_assessment_period_expired(f);
    then immunity PreparerPenaltyLimitationImmunity {
        holder p;
        protected_effect preparer_penalty_late_assessment_effect(f);
        window [-infinity, infinity];
    };
}
pub relation preparer_penalty_refund_claim_timely_6696d2(f: FailureContext) kind institutional {
    label en unofficial "the claim for refund of an overpayment of the penalty is filed within 3 years (6 years for section 6695B) from the time the penalty was paid";
}
@source(IRC_S6696_D, relation = formalizes, coverage = exact, quote = "any claim for refund of an overpayment of any penalty assessed under section 6694, 6695, or 6695A shall be filed within 3 years from the time the penalty was paid")
rule S6696d2Refund3Years defeasible {
    for f: FailureContext;
    for k: PreparerPenaltySection;
    for pd: Date;
    for c: Date;
    when preparer_penalty_section_of(f, k)
        and not_known(preparer_penalty_section_of(f, Section6695B))
        and preparer_penalty_paid_on(f, pd)
        and preparer_penalty_refund_claim_filed_on(f, c)
        and c <= add_calendar_period(pd, 36 calendar_month);
    then preparer_penalty_refund_claim_timely_6696d2(f);
    unless refund_claim_governed_by_6694d(f)
        and preparer_penalty_section_of(f, k)
        and not_known(preparer_penalty_section_of(f, Section6695B))
        and preparer_penalty_paid_on(f, pd)
        and preparer_penalty_refund_claim_filed_on(f, c)
        and c <= add_calendar_period(pd, 36 calendar_month);
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = exact, quote = "(or, in the case of any claim for refund of an overpayment of any penalty assessed under section 6695B, 6 years)")
rule S6696d2Refund6YearsFor6695B defeasible {
    effective [@2026-01-01, infinity);
    for f: FailureContext;
    for pd: Date;
    for c: Date;
    when preparer_penalty_section_of(f, Section6695B)
        and preparer_penalty_paid_on(f, pd)
        and preparer_penalty_refund_claim_filed_on(f, c)
        and c <= add_calendar_period(pd, 72 calendar_month);
    then preparer_penalty_refund_claim_timely_6696d2(f);
    unless refund_claim_governed_by_6694d(f)
        and preparer_penalty_section_of(f, Section6695B)
        and preparer_penalty_paid_on(f, pd)
        and preparer_penalty_refund_claim_filed_on(f, c)
        and c <= add_calendar_period(pd, 72 calendar_month);
}
@source(IRC_S6696_B, relation = formalizes, coverage = exact, quote = "Subchapter B of chapter 63 (relating to deficiency procedures for income, estate, gift, and certain excise taxes) shall not apply with respect to the assessment or collection of the penalties provided by sections 6694, 6695, and 6695A")
rule S6696bDeficiencyImmunity defeasible {
    for f: FailureContext;
    for p: Person;
    for k: PreparerPenaltySection;
    when failure_by(f, p)
        and preparer_penalty_section_of(f, k);
    then immunity PreparerPenaltyDeficiencyProcedureImmunity {
        holder p;
        protected_effect deficiency_procedure_would_apply_to_penalty(f);
        window [-infinity, infinity];
    };
}
pub relation preparer_penalty_in_addition_to_other_penalties(f: FailureContext) kind institutional {
    label en unofficial "the penalties provided by sections 6694, 6695, 6695A (and 6695B) are in addition to any other penalties provided by law";
}
@source(IRC_S6696_A, relation = formalizes, coverage = exact, quote = "The penalties provided by sections 6694, 6695, and 6695A shall be in addition to any other penalties provided by law")
rule S6696aInAddition strict {
    for f: FailureContext;
    for k: PreparerPenaltySection;
    when preparer_penalty_section_of(f, k);
    then preparer_penalty_in_addition_to_other_penalties(f);
}
relation is_return_for_6696e(x: Return) kind empirical {
    label en official "the item is any return of any tax imposed by this title, any administrative adjustment request under section 6227, or any partnership adjustment tracking report under section 6226(b)(4)(A)";
}
pub relation return_for_sections_6694_6695_6695A(x: Return) kind institutional {
    label en official "the term \"return\" for purposes of sections 6694, 6695, and 6695A";
}
@source(IRC_S6696_E, relation = formalizes, coverage = exact, quote = "The term \"return\" means any return of any tax imposed by this title, any administrative adjustment request under section 6227, and any partnership adjustment tracking report under section 6226(b)(4)(A)")
rule S6696e1Return strict {
    for x: Return;
    when is_return_for_6696e(x);
    then return_for_sections_6694_6695_6695A(x);
}
relation is_claim_for_refund_of_or_credit_against_tax(c: Claim) kind empirical {
    label en official "a claim for refund of, or credit against, any tax imposed by this title";
}
pub relation claim_for_refund_for_sections_6694_6695_6695A(c: Claim) kind institutional {
    label en official "the term \"claim for refund\" for purposes of sections 6694, 6695, and 6695A";
}
@source(IRC_S6696_E, relation = formalizes, coverage = exact, quote = "The term \"claim for refund\" means a claim for refund of, or credit against, any tax imposed by this title")
rule S6696e2ClaimForRefund strict {
    for c: Claim;
    when is_claim_for_refund_of_or_credit_against_tax(c);
    then claim_for_refund_for_sections_6694_6695_6695A(c);
}

// --- §6698: failure to file partnership return ------------------------------------------------
relation partnership_failed_to_file_or_incomplete_return(f: FailureContext) kind empirical {
    label en official "a partnership required to file a return under section 6031, or a partnership adjustment tracking report under section 6226(b)(4)(A), fails to file such return or report at the time prescribed (determined with regard to any extension of time for filing) or files one which fails to show the information required";
}
relation partnership_return_due_date_with_extensions(f: FailureContext, d: Date) kind empirical {
    label en official "the time prescribed for filing (determined with regard to any extension of time for filing)";
}
relation partnership_persons_during_taxable_year(f: FailureContext, n: Integer) kind empirical {
    label en official "the number of persons who were partners in the partnership during any part of the taxable year";
}
@source(IRC_S6698_A, relation = formalizes, coverage = partial, quote = "for each month (or fraction thereof) during which such failure continues (but not to exceed 12 months)")
rule S6698MonthsQuery strict {
    for f: FailureContext;
    for due: Date;
    for as_of: Date;
    when partnership_return_due_date_with_extensions(f, due)
        and failure_continued_through(f, as_of);
    then months_or_fraction_query(due, as_of);
}
pub relation partnership_return_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "for each month (or fraction thereof) during which the failure continues (not to exceed 12 months): the per-partner dollar amount multiplied by the number of partners";
}
@source(IRC_S6698_A, relation = formalizes, coverage = exact, quote = "such partnership shall be liable for a penalty determined under subsection (b) for each month (or fraction thereof) during which such failure continues (but not to exceed 12 months), unless it is shown that such failure is due to reasonable cause")
rule S6698PenaltyWithinHorizon defeasible {
    for f: FailureContext;
    for p: Person;
    for due: Date;
    for as_of: Date;
    for m: Integer;
    for n: Integer;
    when failure_by(f, p)
        and partnership_failed_to_file_or_incomplete_return(f)
        and partnership_return_due_date_with_extensions(f, due)
        and failure_continued_through(f, as_of)
        and months_or_fraction_query(due, as_of)
        and calendar_months_or_fraction(due, as_of, m)
        and partnership_persons_during_taxable_year(f, n);
    then partnership_return_penalty(f, round(PartnershipReturnPenaltyPerPartnerMonth * n * m, 2, "HALF_UP"));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and partnership_failed_to_file_or_incomplete_return(f)
        and partnership_return_due_date_with_extensions(f, due)
        and failure_continued_through(f, as_of)
        and months_or_fraction_query(due, as_of)
        and calendar_months_or_fraction(due, as_of, m)
        and partnership_persons_during_taxable_year(f, n);
}
@source(IRC_S6698_A, relation = formalizes, coverage = exact, quote = "(but not to exceed 12 months)")
rule S6698PenaltyAtTwelveMonthCap defeasible {
    for f: FailureContext;
    for p: Person;
    for due: Date;
    for as_of: Date;
    for n: Integer;
    when failure_by(f, p)
        and partnership_failed_to_file_or_incomplete_return(f)
        and partnership_return_due_date_with_extensions(f, due)
        and failure_continued_through(f, as_of)
        and months_or_fraction_query(due, as_of)
        and calendar_months_exceeds_tracked_horizon(due, as_of)
        and partnership_persons_during_taxable_year(f, n);
    then partnership_return_penalty(f, round(PartnershipReturnPenaltyPerPartnerMonth * n * 12, 2, "HALF_UP"));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and partnership_failed_to_file_or_incomplete_return(f)
        and partnership_return_due_date_with_extensions(f, due)
        and failure_continued_through(f, as_of)
        and months_or_fraction_query(due, as_of)
        and calendar_months_exceeds_tracked_horizon(due, as_of)
        and partnership_persons_during_taxable_year(f, n);
}
pub relation partnership_return_penalty_assessed_against(f: FailureContext, q: Person) kind institutional {
    label en unofficial "the penalty imposed by subsection (a) is assessed against the partnership";
}
@source(IRC_S6698_C, relation = formalizes, coverage = exact, quote = "The penalty imposed by subsection (a) shall be assessed against the partnership")
rule S6698cAssessedAgainst defeasible {
    for f: FailureContext;
    for p: Person;
    for a: Money;
    when failure_by(f, p)
        and partnership_return_penalty(f, a);
    then partnership_return_penalty_assessed_against(f, p);
}
@source(IRC_S6698_D, relation = formalizes, coverage = exact, quote = "Subchapter B of chapter 63 (relating to deficiency procedures for income, estate, gift, and certain excise taxes) shall not apply in respect of the assessment or collection of any penalty imposed by subsection (a)")
rule S6698dDeficiencyProcedureImmunity defeasible {
    for f: FailureContext;
    for p: Person;
    for amt: Money;
    when partnership_return_penalty(f, amt)
        and failure_by(f, p);
    then immunity S6698dDeficiencyProcedureImmunityHolder {
        holder p;
        protected_effect deficiency_procedure_would_apply_to_penalty(f);
        window [-infinity, infinity];
    };
}

// --- §6699: failure to file s_corporation return ------------------------------------------------
relation s_corporation_failed_to_file_or_incomplete_return(f: FailureContext) kind empirical {
    label en official "an S corporation required to file a return under section 6037 fails to file such return at the time prescribed (determined with regard to any extension of time for filing) or files a return which fails to show the information required";
}
relation s_corporation_return_due_date_with_extensions(f: FailureContext, d: Date) kind empirical {
    label en official "the time prescribed for filing (determined with regard to any extension of time for filing)";
}
relation s_corporation_persons_during_taxable_year(f: FailureContext, n: Integer) kind empirical {
    label en official "the number of persons who were shareholders in the S corporation during any part of the taxable year";
}
@source(IRC_S6699_A, relation = formalizes, coverage = partial, quote = "for each month (or fraction thereof) during which such failure continues (but not to exceed 12 months)")
rule S6699MonthsQuery strict {
    for f: FailureContext;
    for due: Date;
    for as_of: Date;
    when s_corporation_return_due_date_with_extensions(f, due)
        and failure_continued_through(f, as_of);
    then months_or_fraction_query(due, as_of);
}
pub relation s_corporation_return_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "for each month (or fraction thereof) during which the failure continues (not to exceed 12 months): the per-shareholder dollar amount multiplied by the number of shareholders";
}
@source(IRC_S6699_A, relation = formalizes, coverage = exact, quote = "such S corporation shall be liable for a penalty determined under subsection (b) for each month (or fraction thereof) during which such failure continues (but not to exceed 12 months), unless it is shown that such failure is due to reasonable cause")
rule S6699PenaltyWithinHorizon defeasible {
    for f: FailureContext;
    for p: Person;
    for due: Date;
    for as_of: Date;
    for m: Integer;
    for n: Integer;
    when failure_by(f, p)
        and s_corporation_failed_to_file_or_incomplete_return(f)
        and s_corporation_return_due_date_with_extensions(f, due)
        and failure_continued_through(f, as_of)
        and months_or_fraction_query(due, as_of)
        and calendar_months_or_fraction(due, as_of, m)
        and s_corporation_persons_during_taxable_year(f, n);
    then s_corporation_return_penalty(f, round(SCorporationReturnPenaltyPerShareholderMonth * n * m, 2, "HALF_UP"));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and s_corporation_failed_to_file_or_incomplete_return(f)
        and s_corporation_return_due_date_with_extensions(f, due)
        and failure_continued_through(f, as_of)
        and months_or_fraction_query(due, as_of)
        and calendar_months_or_fraction(due, as_of, m)
        and s_corporation_persons_during_taxable_year(f, n);
}
@source(IRC_S6699_A, relation = formalizes, coverage = exact, quote = "(but not to exceed 12 months)")
rule S6699PenaltyAtTwelveMonthCap defeasible {
    for f: FailureContext;
    for p: Person;
    for due: Date;
    for as_of: Date;
    for n: Integer;
    when failure_by(f, p)
        and s_corporation_failed_to_file_or_incomplete_return(f)
        and s_corporation_return_due_date_with_extensions(f, due)
        and failure_continued_through(f, as_of)
        and months_or_fraction_query(due, as_of)
        and calendar_months_exceeds_tracked_horizon(due, as_of)
        and s_corporation_persons_during_taxable_year(f, n);
    then s_corporation_return_penalty(f, round(SCorporationReturnPenaltyPerShareholderMonth * n * 12, 2, "HALF_UP"));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and s_corporation_failed_to_file_or_incomplete_return(f)
        and s_corporation_return_due_date_with_extensions(f, due)
        and failure_continued_through(f, as_of)
        and months_or_fraction_query(due, as_of)
        and calendar_months_exceeds_tracked_horizon(due, as_of)
        and s_corporation_persons_during_taxable_year(f, n);
}
pub relation s_corporation_return_penalty_assessed_against(f: FailureContext, q: Person) kind institutional {
    label en unofficial "the penalty imposed by subsection (a) is assessed against the S corporation";
}
@source(IRC_S6699_C, relation = formalizes, coverage = exact, quote = "The penalty imposed by subsection (a) shall be assessed against the S corporation")
rule S6699cAssessedAgainst defeasible {
    for f: FailureContext;
    for p: Person;
    for a: Money;
    when failure_by(f, p)
        and s_corporation_return_penalty(f, a);
    then s_corporation_return_penalty_assessed_against(f, p);
}
@source(IRC_S6699_D, relation = formalizes, coverage = exact, quote = "Subchapter B of chapter 63 (relating to deficiency procedures for income, estate, gift, and certain excise taxes) shall not apply in respect of the assessment or collection of any penalty imposed by subsection (a)")
rule S6699dDeficiencyProcedureImmunity defeasible {
    for f: FailureContext;
    for p: Person;
    for amt: Money;
    when s_corporation_return_penalty(f, amt)
        and failure_by(f, p);
    then immunity S6699dDeficiencyProcedureImmunityHolder {
        holder p;
        protected_effect deficiency_procedure_would_apply_to_penalty(f);
        window [-infinity, infinity];
    };
}
