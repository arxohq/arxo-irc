pub relation foreign_trust_notice_penalty_aggregate(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "the aggregate penalty under subsection (a), not exceeding the gross reportable amount";
}
@source(IRC_S6677_A, relation = formalizes, coverage = partial, quote = "the aggregate amount of such penalties do not exceed the gross reportable amount")
rule S6677aAggregateWithContinuation defeasible {
    for f: FailureContext;
    for i: Money;
    for c: Money;
    for g: Money;
    when foreign_trust_notice_penalty_initial(f, i)
        and foreign_trust_notice_penalty_continuation(f, c)
        and gross_reportable_amount(f, g);
    then foreign_trust_notice_penalty_aggregate(f, min(i + c, g));
}
@source(IRC_S6677_A, relation = formalizes, coverage = partial, quote = "the aggregate amount of such penalties do not exceed the gross reportable amount")
rule S6677aAggregateInitialOnly defeasible {
    for f: FailureContext;
    for i: Money;
    for g: Money;
    when foreign_trust_notice_penalty_initial(f, i)
        and gross_reportable_amount(f, g)
        and not_known(foreign_trust_notice_penalty_continuation_exists(f));
    then foreign_trust_notice_penalty_aggregate(f, min(i, g));
}
relation foreign_trust_notice_penalty_continuation_exists(f: FailureContext) kind institutional {
    label en unofficial "a continuation penalty under section 6677(a) exists for the failure";
}
@source(IRC_S6677_A, relation = formalizes, coverage = partial, quote = "If any failure described in the preceding sentence continues for more than 90 days after the day on which the Secretary mails notice of such failure")
rule S6677aContinuationExists defeasible {
    for f: FailureContext;
    for c: Money;
    when foreign_trust_notice_penalty_continuation(f, c);
    then foreign_trust_notice_penalty_continuation_exists(f);
}
pub relation penalty_excess_over_gross_reportable_amount(f: FailureContext, excess: Money) kind institutional {
    label en unofficial "the amount by which the aggregate penalties assessed exceed the gross reportable amount, to be refunded to the taxpayer";
}
@source(IRC_S6677_A, relation = formalizes, coverage = partial, quote = "to the extent that such aggregate amount already exceeds the gross reportable amount the Secretary shall refund such excess to the taxpayer")
rule S6677aExcessOverGross defeasible {
    for f: FailureContext;
    for i: Money;
    for c: Money;
    for g: Money;
    when foreign_trust_notice_penalty_initial(f, i)
        and foreign_trust_notice_penalty_continuation(f, c)
        and gross_reportable_amount(f, g)
        and i + c > g;
    then penalty_excess_over_gross_reportable_amount(f, i + c - g);
}
relation excess_penalty_refunded(f: FailureContext) kind empirical {
    label en unofficial "the excess penalty has been refunded to the taxpayer";
}
@source(IRC_S6677_A, relation = formalizes, coverage = exact, quote = "the Secretary shall refund such excess to the taxpayer")
rule S6677aRefundDuty defeasible {
    for f: FailureContext;
    for p: Person;
    for x: Money;
    when failure_by(f, p)
        and penalty_excess_over_gross_reportable_amount(f, x);
    then duty RefundExcessForeignTrustPenalty {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition excess_penalty_refunded(f);
            window [-infinity, infinity];
        };
    };
}
@source(IRC_S6677_E, relation = formalizes, coverage = exact, quote = "Subchapter B of chapter 63 (relating to deficiency procedures for income, estate, gift, and certain excise taxes) shall not apply in respect of the assessment or collection of any penalty imposed by subsection (a)")
rule S6677eDeficiencyProcedureImmunity defeasible {
    for f: FailureContext;
    for p: Person;
    for amt: Money;
    when foreign_trust_notice_penalty_initial(f, amt)
        and failure_by(f, p);
    then immunity S6677eDeficiencyProcedureImmunityHolder {
        holder p;
        protected_effect deficiency_procedure_would_apply_to_penalty(f);
        window [-infinity, infinity];
    };
}

// --- §6679: failure to file returns as to foreign corporations and partnerships ------------
relation failed_to_file_or_incomplete_return_6046_6046A(f: FailureContext) kind empirical {
    label en official "a person required to file a return under section 6046 or 6046A fails to file such return at the time provided in such section, or files a return which does not show the information required";
}
pub relation foreign_return_penalty_6679a1(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "a penalty of $10,000 unless the failure is due to reasonable cause";
}
@source(IRC_S6679_A, relation = formalizes, coverage = exact, quote = "shall pay a penalty of $10,000, unless it is shown that such failure is due to reasonable cause")
rule S6679a1Penalty defeasible {
    for f: FailureContext;
    for p: Person;
    when failure_by(f, p)
        and failed_to_file_or_incomplete_return_6046_6046A(f);
    then foreign_return_penalty_6679a1(f, round(ForeignPartnershipReturnPenalty, 2, "HALF_UP"));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and failed_to_file_or_incomplete_return_6046_6046A(f);
}
pub relation foreign_return_penalty_6679a2_increase(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$10,000 for each 30-day period (or fraction thereof) after the 90-day period, the increase not exceeding $50,000";
}
@source(IRC_S6679_A, relation = formalizes, coverage = partial, quote = "such person shall pay a penalty (in addition to the amount required under paragraph (1)) of $10,000 for each 30-day period (or fraction thereof) during which such failure continues after the expiration of such 90-day period. The increase in any penalty under this paragraph shall not exceed $50,000")
rule S6679a2IncreasePeriod1 defeasible {
    for f: FailureContext;
    for p: Person;
    for m: Date;
    for e: Date;
    when failure_by(f, p)
        and failed_to_file_or_incomplete_return_6046_6046A(f)
        and secretary_mailed_notice_of_failure_on(f, m)
        and failure_continued_through(f, e)
        and days_between(m, e) > 90
        and days_between(m, e) <= 120;
    then foreign_return_penalty_6679a2_increase(f, min(round(ForeignPartnershipReturnContinuationPerPeriod * 1, 2, "HALF_UP"), round(ForeignPartnershipReturnContinuationCap, 2, "HALF_UP")));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and failed_to_file_or_incomplete_return_6046_6046A(f)
        and secretary_mailed_notice_of_failure_on(f, m)
        and failure_continued_through(f, e)
        and days_between(m, e) > 90
        and days_between(m, e) <= 120;
}
@source(IRC_S6679_A, relation = formalizes, coverage = partial, quote = "such person shall pay a penalty (in addition to the amount required under paragraph (1)) of $10,000 for each 30-day period (or fraction thereof) during which such failure continues after the expiration of such 90-day period. The increase in any penalty under this paragraph shall not exceed $50,000")
rule S6679a2IncreasePeriod2 defeasible {
    for f: FailureContext;
    for p: Person;
    for m: Date;
    for e: Date;
    when failure_by(f, p)
        and failed_to_file_or_incomplete_return_6046_6046A(f)
        and secretary_mailed_notice_of_failure_on(f, m)
        and failure_continued_through(f, e)
        and days_between(m, e) > 120
        and days_between(m, e) <= 150;
    then foreign_return_penalty_6679a2_increase(f, min(round(ForeignPartnershipReturnContinuationPerPeriod * 2, 2, "HALF_UP"), round(ForeignPartnershipReturnContinuationCap, 2, "HALF_UP")));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and failed_to_file_or_incomplete_return_6046_6046A(f)
        and secretary_mailed_notice_of_failure_on(f, m)
        and failure_continued_through(f, e)
        and days_between(m, e) > 120
        and days_between(m, e) <= 150;
}
@source(IRC_S6679_A, relation = formalizes, coverage = partial, quote = "such person shall pay a penalty (in addition to the amount required under paragraph (1)) of $10,000 for each 30-day period (or fraction thereof) during which such failure continues after the expiration of such 90-day period. The increase in any penalty under this paragraph shall not exceed $50,000")
rule S6679a2IncreasePeriod3 defeasible {
    for f: FailureContext;
    for p: Person;
    for m: Date;
    for e: Date;
    when failure_by(f, p)
        and failed_to_file_or_incomplete_return_6046_6046A(f)
