    failure_by,
    failure_count,
    months_or_fraction_query,
    reasonable_cause_and_no_willful_neglect,
    reasonable_cause_shown,
};

// 26 U.S.C. §§6677, 6679, 6684-6692 (IRC-16 stage 2, DECISION-0379).
//
// JUDGMENT CALLS AND GAPS:
//  - §6677/§6679 continuation penalties (each 30-day period or fraction after
//    the 90-day period following the Secretary's notice) are enumerated by
//    day-count buckets over `days_between`; §6679's increase is capped at
//    $50,000 (5 periods); §6677 enumerates 12 periods (450 days) — a failure
//    continuing longer is TECH-GAPS G3104 (the aggregate is still bounded by
//    the gross reportable amount, which the aggregate rule applies).
//  - §6679(a)(2)'s "failure described in paragraph (1)" is read as one not
//    excused by reasonable cause: the reasonable-cause defeater is applied to
//    the increase as well. JUDGMENT CALL (the paragraph has no clause of its
//    own).
//  - §6677(d)'s second sentence (a foreign jurisdiction's penalty for
//    disclosure is NOT reasonable cause) is a constraint on the judgment's
//    content: modelled as a bar on recognising the reasonable-cause showing
//    when the only cause asserted is that foreign penalty.
//  - §6677(a) last sentence (aggregate not to exceed the gross reportable
//    amount, excess to be refunded) is a cap plus a Secretary's refund duty.
//  - §6684 "willful and flagrant", §6685 "willful", §6690 "willfully" are
//    elements of liability: empirical relations the case must establish with
//    origin adjudicated (DECISION-0194 second channel).
//  - The deficiency-procedure carve-outs (§6677(e), §6679(b)) are immunities
//    over the placeholder `deficiency_procedure_would_apply_to_penalty`
//    (owner: assessment) exactly like §6682(c) in module 09.

relation deficiency_procedure_would_apply_to_penalty(f: FailureContext) kind institutional {
    label en unofficial "PENDING (owner: assessment, F02) - placeholder for subchapter B of chapter 63's deficiency procedure reaching the penalty absent an immunity; see coverage/penalties.deps.json";
}
pub relation penalty_not_subject_to_deficiency_procedure(f: FailureContext) kind institutional {
    label en unofficial "the penalty is not subject to the deficiency procedures of subchapter B of chapter 63";
    protected_effect deficiency_procedure_would_apply_to_penalty;
}

// --- §6677: failure to file information returns with respect to certain foreign trusts ---
pub enum Section6048Failure {
    EventNotice6048a;
    OwnerReturn6048b;
    DistributionReturn6048c;
    label en unofficial "the kind of section 6048 notice or return the failure relates to";
}
relation failure_relates_to_section_6048(f: FailureContext, k: Section6048Failure) kind empirical {
    label en unofficial "the failure relates to a notice or return required to be filed by section 6048 (of the named kind)";
}
relation section_6048_notice_not_filed_or_incomplete(f: FailureContext) kind empirical {
    label en official "a notice or return required to be filed by section 6048 is not filed on or before the time provided in such section, or does not include all the information required or includes incorrect information";
}
relation gross_value_of_property_at_event(f: FailureContext, amount: Money) kind empirical {
    label en official "the gross value of the property involved in the event, determined as of the date of the event (section 6048(a))";
}
relation gross_value_of_trust_portion_at_year_end(f: FailureContext, amount: Money) kind empirical {
    label en official "the gross value of the portion of the trust's assets at the close of the year treated as owned by the United States person (section 6048(b)(1))";
}
relation gross_amount_of_distributions(f: FailureContext, amount: Money) kind empirical {
    label en official "the gross amount of the distributions (section 6048(c))";
}
pub relation gross_reportable_amount(f: FailureContext, amount: Money) kind institutional {
    label en official "the term \"gross reportable amount\" for the failure";
}
@source(IRC_S6677_C, relation = formalizes, coverage = exact, quote = "the gross value of the property involved in the event (determined as of the date of the event) in the case of a failure relating to section 6048(a)")
rule S6677cGrossReportableEvent strict {
    for f: FailureContext;
    for amount: Money;
    when failure_relates_to_section_6048(f, EventNotice6048a)
        and gross_value_of_property_at_event(f, amount);
    then gross_reportable_amount(f, amount);
}
@source(IRC_S6677_C, relation = formalizes, coverage = exact, quote = "the gross value of the portion of the trust's assets at the close of the year treated as owned by the United States person in the case of a failure relating to section 6048(b)(1)")
rule S6677cGrossReportableOwnerTrust strict {
    for f: FailureContext;
    for amount: Money;
    when failure_relates_to_section_6048(f, OwnerReturn6048b)
        and gross_value_of_trust_portion_at_year_end(f, amount);
    then gross_reportable_amount(f, amount);
}
@source(IRC_S6677_C, relation = formalizes, coverage = exact, quote = "the gross amount of the distributions in the case of a failure relating to section 6048(c)")
rule S6677cGrossReportableDistributions strict {
    for f: FailureContext;
    for amount: Money;
    when failure_relates_to_section_6048(f, DistributionReturn6048c)
        and gross_amount_of_distributions(f, amount);
    then gross_reportable_amount(f, amount);
}
relation cause_asserted_is_foreign_jurisdiction_penalty(f: FailureContext) kind empirical {
    label en official "the only cause asserted for the failure is that a foreign jurisdiction would impose a civil or criminal penalty for disclosing the required information";
}
relation reasonable_cause_recognized_6677(p: Person, f: FailureContext) kind institutional {
    label en unofficial "the reasonable-cause-and-not-willful-neglect showing is recognised for section 6677 (not when the only cause is a foreign penalty for disclosure)";
}
@source(IRC_S6677_D, relation = formalizes, coverage = exact, quote = "The fact that a foreign jurisdiction would impose a civil or criminal penalty on the taxpayer (or any other person) for disclosing the required information is not reasonable cause")
rule S6677dReasonableCauseRecognized defeasible {
    for f: FailureContext;
    for p: Person;
    when reasonable_cause_and_no_willful_neglect(p, f)
        and failure_by(f, p);
    then reasonable_cause_recognized_6677(p, f);
    unless cause_asserted_is_foreign_jurisdiction_penalty(f)
        and reasonable_cause_and_no_willful_neglect(p, f)
        and failure_by(f, p);
}
pub relation foreign_trust_notice_penalty_initial(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "the greater of $10,000 or 35 percent of the gross reportable amount (5 percent for a return under section 6048(b))";
}
@source(IRC_S6677_A, relation = formalizes, coverage = exact, quote = "the person required to file such notice or return shall pay a penalty equal to the greater of $10,000 or 35 percent of the gross reportable amount")
rule S6677aInitialPenaltyGeneral defeasible {
    for f: FailureContext;
    for p: Person;
    for g: Money;
    when failure_by(f, p)
        and section_6048_notice_not_filed_or_incomplete(f)
        and gross_reportable_amount(f, g)
        and not_known(failure_relates_to_section_6048(f, OwnerReturn6048b));
    then foreign_trust_notice_penalty_initial(f, max(round(ForeignTrustNoticePenaltyMinimum, 2, "HALF_UP"), round(g * ForeignTrustNoticePenaltyRate, 2, "HALF_UP")));
    unless reasonable_cause_recognized_6677(p, f)
        and failure_by(f, p)
        and section_6048_notice_not_filed_or_incomplete(f)
        and gross_reportable_amount(f, g)
        and not_known(failure_relates_to_section_6048(f, OwnerReturn6048b));
}
@source(IRC_S6677_B, relation = formalizes, coverage = exact, quote = "subsection (a) shall be applied by substituting \"5 percent\" for \"35 percent\"")
rule S6677bInitialPenaltyOwnerReturn defeasible {
    for f: FailureContext;
    for p: Person;
    for g: Money;
    when failure_by(f, p)
        and section_6048_notice_not_filed_or_incomplete(f)
        and gross_reportable_amount(f, g)
        and failure_relates_to_section_6048(f, OwnerReturn6048b);
    then foreign_trust_notice_penalty_initial(f, max(round(ForeignTrustNoticePenaltyMinimum, 2, "HALF_UP"), round(g * ForeignTrustOwnerReturnPenaltyRate, 2, "HALF_UP")));
    unless reasonable_cause_recognized_6677(p, f)
        and failure_by(f, p)
        and section_6048_notice_not_filed_or_incomplete(f)
        and gross_reportable_amount(f, g)
        and failure_relates_to_section_6048(f, OwnerReturn6048b);
}
relation united_states_person_referred_to_in_6048b(f: FailureContext, q: Person) kind empirical {
    label en official "the United States person referred to in section 6048(b)";
}
pub relation liable_for_section_6677_penalty(f: FailureContext, q: Person) kind institutional {
    label en unofficial "the person is liable for the penalty imposed by subsection (a); for a return under section 6048(b), the United States person referred to in that section";
}
@source(IRC_S6677_B, relation = formalizes, coverage = exact, quote = "the United States person referred to in such section shall be liable for the penalty imposed by subsection (a)")
rule S6677bOwnerLiable defeasible {
    for f: FailureContext;
    for q: Person;
    for a: Money;
    when failure_relates_to_section_6048(f, OwnerReturn6048b)
        and united_states_person_referred_to_in_6048b(f, q)
        and foreign_trust_notice_penalty_initial(f, a);
    then liable_for_section_6677_penalty(f, q);
}
@source(IRC_S6677_A, relation = formalizes, coverage = partial, quote = "the person required to file such notice or return shall pay a penalty")
rule S6677aFilerLiable defeasible {
    for f: FailureContext;
    for p: Person;
    for a: Money;
    when failure_by(f, p)
        and not_known(failure_relates_to_section_6048(f, OwnerReturn6048b))
        and foreign_trust_notice_penalty_initial(f, a);
    then liable_for_section_6677_penalty(f, p);
}
relation secretary_mailed_notice_of_failure_on(f: FailureContext, d: Date) kind empirical {
    label en official "the day on which the Secretary mails notice of such failure to the person required to pay the penalty";
}
relation failure_continued_through(f: FailureContext, d: Date) kind empirical {
    label en unofficial "the last day through which the failure continues (case fact)";
}
pub relation foreign_trust_notice_penalty_continuation(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$10,000 for each 30-day period (or fraction thereof) during which the failure continues after the expiration of the 90-day period following the Secretary's notice";
}
@source(IRC_S6677_A, relation = formalizes, coverage = partial, quote = "such person shall pay a penalty (in addition to the amount determined under the preceding sentence) of $10,000 for each 30-day period (or fraction thereof) during which such failure continues after the expiration of such 90-day period")
rule S6677aContinuationPeriod01 defeasible {
    for f: FailureContext;
    for p: Person;
    for m: Date;
    for e: Date;
    when failure_by(f, p)
        and section_6048_notice_not_filed_or_incomplete(f)
        and secretary_mailed_notice_of_failure_on(f, m)
        and failure_continued_through(f, e)
        and days_between(m, e) > 90
        and days_between(m, e) <= 120;
    then foreign_trust_notice_penalty_continuation(f, round(ForeignTrustContinuationPenaltyPerPeriod * 1, 2, "HALF_UP"));
    unless reasonable_cause_recognized_6677(p, f)
        and failure_by(f, p)
        and section_6048_notice_not_filed_or_incomplete(f)
        and secretary_mailed_notice_of_failure_on(f, m)
        and failure_continued_through(f, e)
        and days_between(m, e) > 90
        and days_between(m, e) <= 120;
}
@source(IRC_S6677_A, relation = formalizes, coverage = partial, quote = "such person shall pay a penalty (in addition to the amount determined under the preceding sentence) of $10,000 for each 30-day period (or fraction thereof) during which such failure continues after the expiration of such 90-day period")
rule S6677aContinuationPeriod02 defeasible {
    for f: FailureContext;
    for p: Person;
    for m: Date;
    for e: Date;
    when failure_by(f, p)
        and section_6048_notice_not_filed_or_incomplete(f)
        and secretary_mailed_notice_of_failure_on(f, m)
        and failure_continued_through(f, e)
        and days_between(m, e) > 120
        and days_between(m, e) <= 150;
    then foreign_trust_notice_penalty_continuation(f, round(ForeignTrustContinuationPenaltyPerPeriod * 2, 2, "HALF_UP"));
    unless reasonable_cause_recognized_6677(p, f)
        and failure_by(f, p)
        and section_6048_notice_not_filed_or_incomplete(f)
        and secretary_mailed_notice_of_failure_on(f, m)
