    then foreign_return_penalty_6679a2_increase(f, min(round(ForeignPartnershipReturnContinuationPerPeriod * 3, 2, "HALF_UP"), round(ForeignPartnershipReturnContinuationCap, 2, "HALF_UP")));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and failed_to_file_or_incomplete_return_6046_6046A(f)
        and secretary_mailed_notice_of_failure_on(f, m)
        and failure_continued_through(f, e)
        and days_between(m, e) > 150
        and days_between(m, e) <= 180;
}
@source(IRC_S6679_A, relation = formalizes, coverage = partial, quote = "such person shall pay a penalty (in addition to the amount required under paragraph (1)) of $10,000 for each 30-day period (or fraction thereof) during which such failure continues after the expiration of such 90-day period. The increase in any penalty under this paragraph shall not exceed $50,000")
rule S6679a2IncreasePeriod4 defeasible {
    for f: FailureContext;
    for p: Person;
    for m: Date;
    for e: Date;
    when failure_by(f, p)
        and failed_to_file_or_incomplete_return_6046_6046A(f)
        and secretary_mailed_notice_of_failure_on(f, m)
        and failure_continued_through(f, e)
        and days_between(m, e) > 180
        and days_between(m, e) <= 210;
    then foreign_return_penalty_6679a2_increase(f, min(round(ForeignPartnershipReturnContinuationPerPeriod * 4, 2, "HALF_UP"), round(ForeignPartnershipReturnContinuationCap, 2, "HALF_UP")));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and failed_to_file_or_incomplete_return_6046_6046A(f)
        and secretary_mailed_notice_of_failure_on(f, m)
        and failure_continued_through(f, e)
        and days_between(m, e) > 180
        and days_between(m, e) <= 210;
}
@source(IRC_S6679_A, relation = formalizes, coverage = exact, quote = "such person shall pay a penalty (in addition to the amount required under paragraph (1)) of $10,000 for each 30-day period (or fraction thereof) during which such failure continues after the expiration of such 90-day period. The increase in any penalty under this paragraph shall not exceed $50,000")
rule S6679a2IncreasePeriod5 defeasible {
    for f: FailureContext;
    for p: Person;
    for m: Date;
    for e: Date;
    when failure_by(f, p)
        and failed_to_file_or_incomplete_return_6046_6046A(f)
        and secretary_mailed_notice_of_failure_on(f, m)
        and failure_continued_through(f, e)
        and days_between(m, e) > 210;
    then foreign_return_penalty_6679a2_increase(f, min(round(ForeignPartnershipReturnContinuationPerPeriod * 5, 2, "HALF_UP"), round(ForeignPartnershipReturnContinuationCap, 2, "HALF_UP")));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and failed_to_file_or_incomplete_return_6046_6046A(f)
        and secretary_mailed_notice_of_failure_on(f, m)
        and failure_continued_through(f, e)
        and days_between(m, e) > 210;
}
@source(IRC_S6679_B, relation = formalizes, coverage = exact, quote = "Subchapter B of chapter 63 (relating to deficiency procedure for income, estate, gift, and certain excise taxes) shall not apply in respect of the assessment or collection of any penalty imposed by subsection (a)")
rule S6679bDeficiencyProcedureImmunity defeasible {
    for f: FailureContext;
    for p: Person;
    for amt: Money;
    when foreign_return_penalty_6679a1(f, amt)
        and failure_by(f, p);
    then immunity S6679bDeficiencyProcedureImmunityHolder {
        holder p;
        protected_effect deficiency_procedure_would_apply_to_penalty(f);
        window [-infinity, infinity];
    };
}

// --- §6684: chapter 42 repeat or willful and flagrant violations ------------------------------
relation liable_for_chapter_42_tax_by_act_or_failure(f: FailureContext, amount: Money) kind empirical {
    label en official "a person becomes liable for tax under any section of chapter 42 by reason of any act or failure to act";
}
relation previously_liable_for_tax_under_chapter_42(f: FailureContext) kind empirical {
    label en official "such person has theretofore been liable for tax under such chapter";
}
relation chapter_42_act_willful_and_flagrant(f: FailureContext) kind empirical {
    label en official "such act or failure to act is both willful and flagrant";
}
relation chapter_42_penalty_ground(f: FailureContext) kind institutional {
    label en unofficial "a section 6684 ground: the person was previously liable under chapter 42, or the act or failure to act is both willful and flagrant";
}
@source(IRC_S6684, relation = formalizes, coverage = exact, quote = "such person has theretofore been liable for tax under such chapter")
rule S6684Ground1 strict {
    for f: FailureContext;
    when previously_liable_for_tax_under_chapter_42(f);
    then chapter_42_penalty_ground(f);
}
@source(IRC_S6684, relation = formalizes, coverage = exact, quote = "such act or failure to act is both willful and flagrant")
rule S6684Ground2 strict {
    for f: FailureContext;
    when chapter_42_act_willful_and_flagrant(f);
    then chapter_42_penalty_ground(f);
}
pub relation chapter_42_repeat_violation_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "a penalty equal to the amount of the chapter 42 tax";
}
@source(IRC_S6684, relation = formalizes, coverage = exact, quote = "then such person shall be liable for a penalty equal to the amount of such tax")
rule S6684Penalty defeasible {
    for f: FailureContext;
    for p: Person;
    for t: Money;
    when failure_by(f, p)
        and liable_for_chapter_42_tax_by_act_or_failure(f, t)
        and chapter_42_penalty_ground(f);
    then chapter_42_repeat_violation_penalty(f, t);
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and liable_for_chapter_42_tax_by_act_or_failure(f, t)
        and chapter_42_penalty_ground(f);
}

// --- §6685: public inspection requirements ------------------------------------------------
relation willfully_fails_public_inspection_6104d(f: FailureContext) kind empirical {
    label en official "any person who is required to comply with the requirements of subsection (d) of section 6104 and who fails to so comply with respect to any return or application, if such failure is willful";
}
pub relation public_inspection_willful_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$5,000 with respect to each such return or application";
}
@source(IRC_S6685, relation = formalizes, coverage = exact, quote = "shall pay a penalty of $5,000 with respect to each such return or application")
rule S6685Penalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and willfully_fails_public_inspection_6104d(f)
        and failure_count(f, n);
    then public_inspection_willful_penalty(f, round(PublicInspectionWillfulFailurePenalty * n, 2, "HALF_UP"));
}

// --- §6686: DISC / former FSC returns and information ---------------------------------------
relation failed_to_supply_information_under_6011c(f: FailureContext) kind empirical {
    label en official "a person required to supply information under section 6011(c) fails to supply such information at the time prescribed by the Secretary, or files a return which does not show the information required";
}
relation failed_to_file_return_under_6011c(f: FailureContext) kind empirical {
    label en official "a person required to file a return under section 6011(c) fails to file such return at the time prescribed by the Secretary";
}
pub relation disc_information_failure_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$100 for each failure to supply information, total for the calendar year not to exceed $25,000";
}
@source(IRC_S6686, relation = formalizes, coverage = exact, quote = "shall pay a penalty of $100 for each failure to supply information (but the total amount imposed on the delinquent person for all such failures during any calendar year shall not exceed $25,000)")
rule S6686InformationPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and failed_to_supply_information_under_6011c(f)
        and failure_count(f, n);
    then disc_information_failure_penalty(f, min(round(DiscInformationFailurePenalty * n, 2, "HALF_UP"), round(DiscInformationFailureAnnualCap, 2, "HALF_UP")));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and failed_to_supply_information_under_6011c(f)
        and failure_count(f, n);
}
pub relation disc_return_failure_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$1,000 for each failure to file a return";
}
@source(IRC_S6686, relation = formalizes, coverage = exact, quote = "a penalty of $1,000 for each failure to file a return, unless it is shown that such failure is due to reasonable cause")
rule S6686ReturnPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and failed_to_file_return_under_6011c(f)
        and failure_count(f, n);
    then disc_return_failure_penalty(f, round(DiscReturnFailurePenalty * n, 2, "HALF_UP"));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and failed_to_file_return_under_6011c(f)
        and failure_count(f, n);
}

// --- §6688: information required under section 7654 -----------------------------------------
relation failed_to_furnish_section_7654_information(f: FailureContext) kind empirical {
    label en official "a person described in section 7654(a) who is required under section 937(c) or by regulations prescribed under section 7654 to furnish information fails to comply with such requirement at the time prescribed by such regulations";
}
pub relation section_7654_information_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "a penalty of $1,000 for each such failure";
}
@source(IRC_S6688, relation = formalizes, coverage = exact, quote = "a penalty of $1,000 for each such failure")
rule S6688Penalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and failed_to_furnish_section_7654_information(f)
        and failure_count(f, n);
    then section_7654_information_penalty(f, round(Section7654InformationFailurePenalty * n, 2, "HALF_UP"));
    unless reasonable_cause_and_no_willful_neglect(p, f)
        and failure_by(f, p)
        and failed_to_furnish_section_7654_information(f)
        and failure_count(f, n);
}

// --- §6689: failure to file notice of foreign tax redetermination ------------------------------
relation redetermination_requiring_notice_under_905c(f: FailureContext) kind empirical {
    label en official "a redetermination for which a notice is required under subsection (c) of section 905";
}
relation redetermination_requiring_notice_under_404Ag2(f: FailureContext) kind empirical {
    label en official "a redetermination for which a notice is required under paragraph (2) of section 404A(g)";
}
pub relation foreign_tax_redetermination(f: FailureContext) kind institutional {
    label en official "the term \"foreign tax redetermination\" means any redetermination for which a notice is required under section 905(c) or 404A(g)(2)";
}
@source(IRC_S6689_B, relation = formalizes, coverage = exact, quote = "any redetermination for which a notice is required under subsection (c) of section 905")
rule S6689bDefinition905 strict {
    for f: FailureContext;
    when redetermination_requiring_notice_under_905c(f);
    then foreign_tax_redetermination(f);
}
@source(IRC_S6689_B, relation = formalizes, coverage = exact, quote = "paragraph (2) of section 404A(g)")
rule S6689bDefinition404A strict {
    for f: FailureContext;
    when redetermination_requiring_notice_under_404Ag2(f);
    then foreign_tax_redetermination(f);
}
relation deficiency_attributable_to_redetermination(f: FailureContext, amount: Money) kind empirical {
    label en unofficial "the deficiency attributable to the redetermination (case fact; owner: assessment / international)";
}
relation redetermination_notice_due_date(f: FailureContext, d: Date) kind empirical {
    label en unofficial "the date prescribed by regulations for giving the notice";
}
relation redetermination_notice_given_or_measured_on(f: FailureContext, d: Date) kind empirical {
    label en unofficial "the date the taxpayer notified the Secretary, or the date as of which the failure is measured";
}
@source(IRC_S6689_A, relation = formalizes, coverage = partial, quote = "5 percent of the deficiency if the failure is for not more than 1 month")
rule S6689MonthsQuery strict {
    for f: FailureContext;
    for due: Date;
    for as_of: Date;
    when redetermination_notice_due_date(f, due)
        and redetermination_notice_given_or_measured_on(f, as_of);
    then months_or_fraction_query(due, as_of);
}
pub relation foreign_tax_redetermination_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "5 percent of the deficiency for a failure of not more than 1 month, plus 5 percent for each additional month or fraction, not in excess of 25 percent";
}
@source(IRC_S6689_A, relation = formalizes, coverage = exact, quote = "an amount (not in excess of 25 percent of the deficiency) determined as follows")
rule S6689aPenaltyWithinHorizon defeasible {
    for f: FailureContext;
    for p: Person;
    for def: Money;
    for due: Date;
    for as_of: Date;
    for n: Integer;
    when failure_by(f, p)
        and foreign_tax_redetermination(f)
        and deficiency_attributable_to_redetermination(f, def)
        and redetermination_notice_due_date(f, due)
        and redetermination_notice_given_or_measured_on(f, as_of)
        and months_or_fraction_query(due, as_of)
        and calendar_months_or_fraction(due, as_of, n);
    then foreign_tax_redetermination_penalty(f, min(round(def * ForeignTaxRedeterminationMonthlyRate * n, 2, "HALF_UP"), round(def * ForeignTaxRedeterminationCapRate, 2, "HALF_UP")));
    unless reasonable_cause_and_no_willful_neglect(p, f)
        and failure_by(f, p)
        and foreign_tax_redetermination(f)
        and deficiency_attributable_to_redetermination(f, def)
        and redetermination_notice_due_date(f, due)
        and redetermination_notice_given_or_measured_on(f, as_of)
        and months_or_fraction_query(due, as_of)
        and calendar_months_or_fraction(due, as_of, n);
}
@source(IRC_S6689_A, relation = formalizes, coverage = exact, quote = "an amount (not in excess of 25 percent of the deficiency) determined as follows")
rule S6689aPenaltyBeyondHorizonAtCap defeasible {
    for f: FailureContext;
    for p: Person;
    for def: Money;
    for due: Date;
    for as_of: Date;
    when failure_by(f, p)
        and foreign_tax_redetermination(f)
        and deficiency_attributable_to_redetermination(f, def)
        and redetermination_notice_due_date(f, due)
        and redetermination_notice_given_or_measured_on(f, as_of)
        and months_or_fraction_query(due, as_of)
        and calendar_months_exceeds_tracked_horizon(due, as_of);
    then foreign_tax_redetermination_penalty(f, round(def * ForeignTaxRedeterminationCapRate, 2, "HALF_UP"));
    unless reasonable_cause_and_no_willful_neglect(p, f)
        and failure_by(f, p)
        and foreign_tax_redetermination(f)
        and deficiency_attributable_to_redetermination(f, def)
        and redetermination_notice_due_date(f, due)
        and redetermination_notice_given_or_measured_on(f, as_of)
        and months_or_fraction_query(due, as_of)
        and calendar_months_exceeds_tracked_horizon(due, as_of);
}

// --- §6690: statement to plan participant --------------------------------------------------
relation willfully_furnished_false_plan_participant_statement(f: FailureContext) kind empirical {
    label en official "any person required under section 6057(e) to furnish a statement to a participant who willfully furnishes a false or fraudulent statement";
}
relation willfully_failed_to_furnish_plan_participant_statement(f: FailureContext) kind empirical {
    label en official "a person required under section 6057(e) who willfully fails to furnish a statement in the manner, at the time, and showing the information required";
}
pub relation plan_participant_statement_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$50 for each such act or failure, assessed and collected in the same manner as the tax on employers imposed by section 3111";
}
@source(IRC_S6690, relation = formalizes, coverage = exact, quote = "who willfully furnishes a false or fraudulent statement")
rule S6690FalseStatementPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    when failure_by(f, p)
        and willfully_furnished_false_plan_participant_statement(f);
    then plan_participant_statement_penalty(f, round(PlanParticipantStatementPenalty, 2, "HALF_UP"));
}
@source(IRC_S6690, relation = formalizes, coverage = exact, quote = "or who willfully fails to furnish a statement in the manner, at the time, and showing the information required under section 6057(e)")
rule S6690FailureToFurnishPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    when failure_by(f, p)
        and willfully_failed_to_furnish_plan_participant_statement(f);
    then plan_participant_statement_penalty(f, round(PlanParticipantStatementPenalty, 2, "HALF_UP"));
}
pub relation penalty_collected_as_employer_3111_tax(f: FailureContext) kind institutional {
    label en unofficial "the section 6690 penalty is assessed and collected in the same manner as the tax on employers imposed by section 3111";
}
@source(IRC_S6690, relation = formalizes, coverage = exact, quote = "which shall be assessed and collected in the same manner as the tax on employers imposed by section 3111")
rule S6690CollectedLike3111 defeasible {
    for f: FailureContext;
    for a: Money;
    when plan_participant_statement_penalty(f, a);
    then penalty_collected_as_employer_3111_tax(f);
}

// --- §6692: actuarial report ------------------------------------------------------------------
relation plan_administrator_failed_to_file_actuarial_report(f: FailureContext) kind empirical {
    label en official "the plan administrator (as defined in section 414(g)) of each defined benefit plan to which section 412 applies fails to file the report required by section 6059 at the time and in the manner required";
}
pub relation actuarial_report_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "a penalty of $1,000 for each such failure";
}
@source(IRC_S6692, relation = formalizes, coverage = exact, quote = "shall pay a penalty of $1,000 for each such failure unless it is shown that such failure is due to reasonable cause")
rule S6692Penalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and plan_administrator_failed_to_file_actuarial_report(f)
        and failure_count(f, n);
    then actuarial_report_penalty(f, round(ActuarialReportFailurePenalty * n, 2, "HALF_UP"));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and plan_administrator_failed_to_file_actuarial_report(f)
        and failure_count(f, n);
}
