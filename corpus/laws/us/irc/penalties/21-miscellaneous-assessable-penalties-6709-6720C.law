language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

use self::{
    FailureContext,
    IRC_S6709_A,
    IRC_S6709_B,
    IRC_S6709_C,
    IRC_S6710_A,
    IRC_S6710_C,
    IRC_S6710_D,
    IRC_S6711_B,
    IRC_S6711_C,
    IRC_S6712_A,
    IRC_S6712_B,
    IRC_S6712_C,
    IRC_S6713_A,
    IRC_S6713_B,
    IRC_S6713_D,
    IRC_S6714_A,
    IRC_S6715A_B,
    IRC_S6715A_C,
    IRC_S6715_A,
    IRC_S6715_B,
    IRC_S6715_C,
    IRC_S6715_D,
    IRC_S6715_E,
    IRC_S6717_A,
    IRC_S6717_B,
    IRC_S6718_A,
    IRC_S6719_B,
    IRC_S6720,
    IRC_S6720A_A,
    IRC_S6720A_B,
    IRC_S6720B,
    IRC_S6720C_A,
    IRC_S6720C_B,
    Person,
    Secretary,
    deficiency_procedure_would_apply_to_penalty,
    failure_by,
    failure_count,
    failure_days,
    reasonable_cause_and_no_willful_neglect,
    reasonable_cause_shown,
};

// 26 U.S.C. §§6709-6720C (IRC-16 stage 2, DECISION-0379).
//
// JUDGMENT CALLS AND GAPS:
//  - §6709(a)/(b): negligence and fraud are elements of liability (adjudicated
//    empirical relations); the section 6662 definition of negligence is not
//    imported because the text of §6709 does not incorporate it.
//  - §§6710 and 6711 penalise each DAY of failure. A day is an occurrence of
//    `FailureContext`; ordinary failure days of an organization for a calendar
//    year are counted in one batch (`failure_days`), the intentional-disregard
//    days (§6710(c)) are separate occurrences because each carries its own cost.
//    The "day on which the failure occurs" rules of §6710(d)/§6711(c)(2) are
//    modelled by four medium-specific date relations.
//  - §6715(b)(2): the number of prior penalties (on the person, a related
//    person or a predecessor) is a case count; the multiplier is applied to
//    the $1,000 branch only, as the text says ("the amount in paragraph (1)(A)").
//  - §6715(e): the bar on administrative appeal is an institutional relation
//    defeated by the two exception claims.
//  - §6718(b): the aggregate number of penalties imposed for PRIOR months is a
//    case count (`prior_month_penalties_count`).
//  - §6720/§6720(2)(A): the highest §1 rate is a typed dependency
//    (owner: income-individual); "knowingly" is an adjudicated empirical element.
//  - §6720C references a section of the American Rescue Plan Act of 2021
//    (Pub. L. 117-2 sec. 9501); it is read as a fact of the requirement.

// --- §6709: penalties with respect to mortgage credit certificates -------------------------
relation made_material_misstatement_in_verified_statement_for_mcc(f: FailureContext) kind empirical {
    label en official "a person makes a material misstatement in any verified written statement made under penalties of perjury with respect to the issuance of a mortgage credit certificate";
}
relation mcc_misstatement_due_to_negligence(f: FailureContext) kind empirical {
    label en official "such misstatement is due to the negligence of such person";
}
relation mcc_misstatement_due_to_fraud(f: FailureContext) kind empirical {
    label en official "the misstatement is due to fraud on the part of the person making such misstatement";
}
pub relation mcc_negligent_misstatement_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$1,000 for each mortgage credit certificate with respect to which a negligent misstatement was made";
}
@source(IRC_S6709_A, relation = formalizes, coverage = exact, quote = "such person shall pay a penalty of $1,000 for each mortgage credit certificate with respect to which such a misstatement was made")
rule S6709aNegligentPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and made_material_misstatement_in_verified_statement_for_mcc(f)
        and mcc_misstatement_due_to_negligence(f)
        and failure_count(f, n);
    then mcc_negligent_misstatement_penalty(f, round(MortgageCreditCertificateNegligentMisstatementPenalty * n, 2, "HALF_UP"));
    unless mcc_misstatement_due_to_fraud(f)
        and failure_by(f, p)
        and made_material_misstatement_in_verified_statement_for_mcc(f)
        and mcc_misstatement_due_to_negligence(f)
        and failure_count(f, n);
}
pub relation mcc_fraudulent_misstatement_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$10,000 for each mortgage credit certificate with respect to which a fraudulent misstatement is made, in addition to any criminal penalty";
}
@source(IRC_S6709_B, relation = formalizes, coverage = exact, quote = "such person shall pay a penalty of $10,000 for each mortgage credit certificate with respect to which such a misstatement is made")
rule S6709bFraudulentPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and made_material_misstatement_in_verified_statement_for_mcc(f)
        and mcc_misstatement_due_to_fraud(f)
        and failure_count(f, n);
    then mcc_fraudulent_misstatement_penalty(f, round(MortgageCreditCertificateFraudulentMisstatementPenalty * n, 2, "HALF_UP"));
}
relation failed_to_file_25g_report_for_mcc(f: FailureContext) kind empirical {
    label en official "a person required by section 25(g) to file a report with the Secretary fails to file the report with respect to any mortgage credit certificate at the time and in the manner required by the Secretary";
}
relation report_is_under_second_sentence_of_25g(f: FailureContext) kind empirical {
    label en official "the report is one required under the second sentence of section 25(g)";
}
pub relation mcc_report_failure_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$200 for each failure; aggregate for second-sentence reports not to exceed $2,000";
}
@source(IRC_S6709_C, relation = formalizes, coverage = exact, quote = "In the case of any report required under the second sentence of section 25(g), the aggregate amount of the penalty imposed by the preceding sentence shall not exceed $2,000")
rule S6709cReportPenaltyCapped defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and failed_to_file_25g_report_for_mcc(f)
        and report_is_under_second_sentence_of_25g(f)
        and failure_count(f, n);
    then mcc_report_failure_penalty(f, min(round(MortgageCreditCertificateReportFailurePenalty * n, 2, "HALF_UP"), round(MortgageCreditCertificateSecondSentenceReportCap, 2, "HALF_UP")));
    unless reasonable_cause_and_no_willful_neglect(p, f)
        and failure_by(f, p)
        and failed_to_file_25g_report_for_mcc(f)
        and report_is_under_second_sentence_of_25g(f)
        and failure_count(f, n);
}
@source(IRC_S6709_C, relation = formalizes, coverage = exact, quote = "shall pay a penalty of $200 for such failure unless it is shown that such failure is due to reasonable cause and not to willful neglect")
rule S6709cReportPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and failed_to_file_25g_report_for_mcc(f)
        and not_known(report_is_under_second_sentence_of_25g(f))
        and failure_count(f, n);
    then mcc_report_failure_penalty(f, round(MortgageCreditCertificateReportFailurePenalty * n, 2, "HALF_UP"));
    unless reasonable_cause_and_no_willful_neglect(p, f)
        and failure_by(f, p)
        and failed_to_file_25g_report_for_mcc(f)
        and not_known(report_is_under_second_sentence_of_25g(f))
        and failure_count(f, n);
}

// --- §6710: failure to disclose that contributions are nondeductible --------------------------
pub enum SolicitationMedium {
    TelevisionOrRadio;
    Mail;
    WrittenNotByMail;
    Telephone;
    label en unofficial "the medium of a solicitation, for the section 6710(d) rule on when a failure occurs";
}
relation failure_to_meet_section_6113_for_solicitation(f: FailureContext) kind empirical {
    label en official "a failure to meet the requirement of section 6113 with respect to a fundraising solicitation by (or on behalf of) an organization to which section 6113 applies";
}
relation solicitation_medium_of_failure(f: FailureContext, m: SolicitationMedium) kind empirical {
    label en unofficial "the medium of the solicitation";
}
relation solicitation_telecast_or_broadcast_on(f: FailureContext, d: Date) kind empirical {
    label en unofficial "the date the solicitation was telecast or broadcast";
}
relation solicitation_mailed_on(f: FailureContext, d: Date) kind empirical {
    label en unofficial "the date the solicitation was mailed";
}
relation solicitation_distributed_on(f: FailureContext, d: Date) kind empirical {
    label en unofficial "the date the solicitation, not by mail but in written or printed form, was distributed";
}
relation solicitation_made_by_telephone_on(f: FailureContext, d: Date) kind empirical {
    label en unofficial "the date the solicitation was made by telephone";
}
pub relation failure_occurred_on_day(f: FailureContext, d: Date) kind institutional {
    label en unofficial "the day on which the failure to meet the section 6113 requirement is treated as occurring";
}
@source(IRC_S6710_D, relation = formalizes, coverage = exact, quote = "by television or radio, shall be treated as occurring when the solicitation was telecast or broadcast")
rule S6710d1Television strict {
    for f: FailureContext;
    for d: Date;
    when solicitation_medium_of_failure(f, TelevisionOrRadio)
        and solicitation_telecast_or_broadcast_on(f, d);
    then failure_occurred_on_day(f, d);
}
@source(IRC_S6710_D, relation = formalizes, coverage = exact, quote = "by mail, shall be treated as occurring when the solicitation was mailed")
rule S6710d2Mail strict {
    for f: FailureContext;
    for d: Date;
    when solicitation_medium_of_failure(f, Mail)
        and solicitation_mailed_on(f, d);
    then failure_occurred_on_day(f, d);
}
@source(IRC_S6710_D, relation = formalizes, coverage = exact, quote = "not by mail but in written or printed form, shall be treated as occurring when the solicitation was distributed")
rule S6710d3Written strict {
    for f: FailureContext;
    for d: Date;
    when solicitation_medium_of_failure(f, WrittenNotByMail)
        and solicitation_distributed_on(f, d);
    then failure_occurred_on_day(f, d);
}
@source(IRC_S6710_D, relation = formalizes, coverage = exact, quote = "by telephone, shall be treated as occurring when the solicitation was made")
rule S6710d4Telephone strict {
    for f: FailureContext;
    for d: Date;
    when solicitation_medium_of_failure(f, Telephone)
        and solicitation_made_by_telephone_on(f, d);
    then failure_occurred_on_day(f, d);
}
relation failure_due_to_intentional_disregard_of_6113(f: FailureContext) kind empirical {
    label en official "the failure is due to intentional disregard of the requirement of section 6113";
}
relation aggregate_cost_of_failing_solicitations_that_day(f: FailureContext, amount: Money) kind empirical {
    label en official "the aggregate cost of the solicitations which occurred on such day and with respect to which there was such a failure (case fact)";
}
pub relation fundraising_disclosure_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$1,000 for each day of failure, not to exceed $10,000 for the calendar year (ordinary days, counted in one batch)";
}
@source(IRC_S6710_A, relation = formalizes, coverage = exact, quote = "such organization shall pay a penalty of $1,000 for each day on which such a failure occurred. The maximum penalty imposed under this subsection on failures by any organization during any calendar year shall not exceed $10,000")
rule S6710aOrdinaryDaysPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and failure_to_meet_section_6113_for_solicitation(f)
        and failure_days(f, n);
    then fundraising_disclosure_penalty(f, min(round(FundraisingDisclosurePenaltyPerDay * n, 2, "HALF_UP"), round(FundraisingDisclosureAnnualCap, 2, "HALF_UP")));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and failure_to_meet_section_6113_for_solicitation(f)
        and failure_days(f, n);
    unless failure_due_to_intentional_disregard_of_6113(f)
        and failure_by(f, p)
        and failure_to_meet_section_6113_for_solicitation(f)
        and failure_days(f, n);
}
pub relation fundraising_disclosure_intentional_day_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "the greater of $1,000 or 50 percent of the aggregate cost of the solicitations that day; the $10,000 limitation does not apply and the amount is not counted toward it";
}
@source(IRC_S6710_C, relation = formalizes, coverage = exact, quote = "the penalty under subsection (a) for the day on which such failure occurred shall be the greater of—")
rule S6710cIntentionalDayPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for c: Money;
    when failure_by(f, p)
        and failure_to_meet_section_6113_for_solicitation(f)
        and failure_due_to_intentional_disregard_of_6113(f)
        and aggregate_cost_of_failing_solicitations_that_day(f, c);
    then fundraising_disclosure_intentional_day_penalty(f, max(round(FundraisingIntentionalDisregardMinimum, 2, "HALF_UP"), round(c * FundraisingIntentionalDisregardCostRate, 2, "HALF_UP")));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and failure_to_meet_section_6113_for_solicitation(f)
        and failure_due_to_intentional_disregard_of_6113(f)
        and aggregate_cost_of_failing_solicitations_that_day(f, c);
}

// --- §6711: failure by tax-exempt organization to disclose that information or services are available from the Federal Government
relation exempt_organization_offers_info_available_free_from_federal_agency(f: FailureContext) kind empirical {
    label en official "a tax-exempt organization offers to sell (or solicits money for) specific information or a routine service for any individual which could be readily obtained by such individual free of charge (or for a nominal charge) from an agency of the Federal Government";
}
relation offer_lacks_express_conspicuous_statement(f: FailureContext) kind empirical {
    label en official "the tax-exempt organization, when making such offer or solicitation, fails to make an express statement (in a conspicuous and easily recognizable format) that the information or service can be so obtained";
}
relation offer_failure_due_to_intentional_disregard(f: FailureContext) kind empirical {
    label en official "such failure is due to intentional disregard of the requirements of this subsection";
}
relation organization_described_in_501c_or_d_exempt_under_501a(f: FailureContext) kind empirical {
    label en official "the organization is described in subsection (c) or (d) of section 501 and exempt from taxation under section 501(a)";
}
relation organization_is_political_organization_527e(f: FailureContext) kind empirical {
    label en official "the organization is a political organization (as defined in section 527(e))";
}
pub relation tax_exempt_organization_6711c1(f: FailureContext) kind institutional {
    label en official "the term \"tax-exempt organization\" for section 6711";
}
@source(IRC_S6711_C, relation = formalizes, coverage = exact, quote = "is described in subsection (c) or (d) of section 501 and exempt from taxation under section 501(a)")
rule S6711c1A strict {
    for f: FailureContext;
    when organization_described_in_501c_or_d_exempt_under_501a(f);
    then tax_exempt_organization_6711c1(f);
}
@source(IRC_S6711_C, relation = formalizes, coverage = exact, quote = "is a political organization (as defined in section 527(e))")
rule S6711c1B strict {
    for f: FailureContext;
    when organization_is_political_organization_527e(f);
    then tax_exempt_organization_6711c1(f);
}
relation offers_aggregate_cost_that_day(f: FailureContext, amount: Money) kind empirical {
    label en official "the aggregate cost of the offers and solicitations which occurred on such day and with respect to which there was such a failure (case fact)";
}
pub relation federal_information_offer_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "for each day of such a failure, the greater of $1,000 or 50 percent of the aggregate cost of the offers and solicitations that day";
}
@source(IRC_S6711_B, relation = formalizes, coverage = exact, quote = "The penalty under subsection (a) for any day on which a failure referred to in such subsection occurred shall be the greater of—")
rule S6711aPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for c: Money;
    when failure_by(f, p)
        and exempt_organization_offers_info_available_free_from_federal_agency(f)
        and offer_lacks_express_conspicuous_statement(f)
        and offer_failure_due_to_intentional_disregard(f)
        and tax_exempt_organization_6711c1(f)
        and offers_aggregate_cost_that_day(f, c);
    then federal_information_offer_penalty(f, max(round(FederalInformationOfferPenaltyMinimum, 2, "HALF_UP"), round(c * FederalInformationOfferPenaltyCostRate, 2, "HALF_UP")));
}

// --- §6712: failure to disclose treaty-based return positions ----------------------------------
relation taxpayer_failed_to_meet_section_6114_requirements(f: FailureContext) kind empirical {
    label en official "a taxpayer fails to meet the requirements of section 6114";
}
relation taxpayer_is_c_corporation(p: Person) kind empirical {
    label en unofficial "the taxpayer is a C corporation";
}
pub relation treaty_position_disclosure_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$1,000 ($10,000 in the case of a C corporation) on each such failure";
}
@source(IRC_S6712_A, relation = formalizes, coverage = exact, quote = "there is hereby imposed a penalty equal to $1,000")
rule S6712aPenaltyIndividual defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and taxpayer_failed_to_meet_section_6114_requirements(f)
        and not_known(taxpayer_is_c_corporation(p))
        and failure_count(f, n);
    then treaty_position_disclosure_penalty(f, round(TreatyPositionDisclosurePenalty * n, 2, "HALF_UP"));
}
@source(IRC_S6712_A, relation = formalizes, coverage = exact, quote = "($10,000 in the case of a C corporation)")
rule S6712aPenaltyCCorporation defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and taxpayer_failed_to_meet_section_6114_requirements(f)
        and taxpayer_is_c_corporation(p)
        and failure_count(f, n);
    then treaty_position_disclosure_penalty(f, round(TreatyPositionDisclosurePenaltyCCorporation * n, 2, "HALF_UP"));
}
relation showing_of_reasonable_cause_for_treaty_failure(f: FailureContext) kind empirical {
    label en official "a showing by the taxpayer that there was reasonable cause for the failure";
}
relation taxpayer_acted_in_good_faith_on_treaty_disclosure(f: FailureContext) kind empirical {
    label en official "the taxpayer acted in good faith";
}
relation treaty_waiver_conditions_6712b(f: FailureContext) kind institutional {
    label en unofficial "the section 6712(b) conditions for waiver are met: reasonable cause and good faith (single atom for the power valid_when)";
}
@source(IRC_S6712_B, relation = formalizes, coverage = exact, quote = "on a showing by the taxpayer that there was reasonable cause for the failure and that the taxpayer acted in good faith")
rule S6712bWaiverConditions strict {
    for f: FailureContext;
    when showing_of_reasonable_cause_for_treaty_failure(f)
        and taxpayer_acted_in_good_faith_on_treaty_disclosure(f);
    then treaty_waiver_conditions_6712b(f);
}
relation secretary_moves_to_waive_6712_penalty(f: FailureContext) kind empirical {
    label en unofficial "the Secretary has moved to waive all or part of the section 6712 penalty (exercise fact)";
}
pub relation treaty_position_disclosure_penalty_waived(f: FailureContext) kind institutional {
    label en unofficial "all or part of the section 6712 penalty has been waived";
}
@source(IRC_S6712_B, relation = formalizes, coverage = exact, quote = "The Secretary may waive all or any part of the penalty provided by this section")
rule S6712bWaiverPower strict {
    for f: FailureContext;
    when secretary_moves_to_waive_6712_penalty(f);
    then power WaiveTreatyPositionDisclosurePenalty {
        holder Secretary;
        over f;
        exercise secretary_moves_to_waive_6712_penalty(f);
        valid_when treaty_waiver_conditions_6712b(f);
        effect create(treaty_position_disclosure_penalty_waived(f));
        window [-infinity, infinity];
    };
}
pub relation section_6712_penalty_in_addition_to_other_penalties(f: FailureContext) kind institutional {
    label en unofficial "the penalty imposed by section 6712 is in addition to any other penalty imposed by law";
}
@source(IRC_S6712_C, relation = formalizes, coverage = exact, quote = "The penalty imposed by this section shall be in addition to any other penalty imposed by law")
rule S6712cInAddition defeasible {
    for f: FailureContext;
    for a: Money;
    when treaty_position_disclosure_penalty(f, a);
    then section_6712_penalty_in_addition_to_other_penalties(f);
}

// --- §6713: disclosure or use of information by preparers of returns -----------------------------
relation preparer_disclosed_or_used_return_information(f: FailureContext) kind empirical {
    label en official "a person engaged in the business of preparing, or providing services in connection with the preparation of, returns of tax imposed by chapter 1 (or who for compensation prepares any such return) discloses any information furnished to him for, or in connection with, the preparation of any such return, or uses such information for any purpose other than to prepare, or assist in preparing, any such return";
}
relation disclosure_or_use_in_connection_with_identity_theft_crime(f: FailureContext) kind empirical {
    label en official "the disclosure or use is made in connection with a crime relating to the misappropriation of another person's taxpayer identity (as defined in section 6103(b)(6)), whether or not such crime involves any tax filing";
}
relation disclosure_or_use_permitted_under_7216b(f: FailureContext) kind empirical {
    label en official "the disclosure or use is permitted under the rules of section 7216(b)";
}
pub relation preparer_disclosure_or_use_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$250 for each disclosure or use, not exceeding $10,000 for the calendar year";
}
@source(IRC_S6713_A, relation = formalizes, coverage = exact, quote = "shall pay a penalty of $250 for each such disclosure or use, but the total amount imposed under this subsection on such a person for any calendar year shall not exceed $10,000")
rule S6713aOrdinaryPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and preparer_disclosed_or_used_return_information(f)
        and not_known(disclosure_or_use_in_connection_with_identity_theft_crime(f))
        and failure_count(f, n);
    then preparer_disclosure_or_use_penalty(f, min(round(PreparerDisclosureOrUsePenalty * n, 2, "HALF_UP"), round(PreparerDisclosureOrUseAnnualCap, 2, "HALF_UP")));
    unless disclosure_or_use_permitted_under_7216b(f)
        and failure_by(f, p)
        and preparer_disclosed_or_used_return_information(f)
        and not_known(disclosure_or_use_in_connection_with_identity_theft_crime(f))
        and failure_count(f, n);
}
pub relation preparer_identity_theft_disclosure_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$1,000 for each disclosure or use in connection with an identity-theft crime, not exceeding $50,000 for the calendar year; the limit applies separately";
}
@source(IRC_S6713_B, relation = formalizes, coverage = partial, quote = "by substituting \"$1,000\" for \"$250\"")
rule S6713bIdentityTheftPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and preparer_disclosed_or_used_return_information(f)
        and disclosure_or_use_in_connection_with_identity_theft_crime(f)
        and failure_count(f, n);
    then preparer_identity_theft_disclosure_penalty(f, min(round(IdentityTheftDisclosurePenalty * n, 2, "HALF_UP"), round(IdentityTheftDisclosureAnnualCap, 2, "HALF_UP")));
    unless disclosure_or_use_permitted_under_7216b(f)
        and failure_by(f, p)
        and preparer_disclosed_or_used_return_information(f)
        and disclosure_or_use_in_connection_with_identity_theft_crime(f)
        and failure_count(f, n);
}
@source(IRC_S6713_D, relation = formalizes, coverage = exact, quote = "Subchapter B of chapter 63 (relating to deficiency procedures for income, estate, gift, and certain excise taxes) shall not apply in respect of the assessment or collection of any penalty imposed by this section")
rule S6713dDeficiencyImmunityOrdinary defeasible {
    for f: FailureContext;
    for p: Person;
    for amt: Money;
    when preparer_disclosure_or_use_penalty(f, amt)
        and failure_by(f, p);
    then immunity S6713dDeficiencyImmunityOrdinaryHolder {
        holder p;
        protected_effect deficiency_procedure_would_apply_to_penalty(f);
        window [-infinity, infinity];
    };
}
@source(IRC_S6713_D, relation = formalizes, coverage = exact, quote = "Subchapter B of chapter 63 (relating to deficiency procedures for income, estate, gift, and certain excise taxes) shall not apply in respect of the assessment or collection of any penalty imposed by this section")
rule S6713dDeficiencyImmunityIdentityTheft defeasible {
    for f: FailureContext;
    for p: Person;
    for amt: Money;
    when preparer_identity_theft_disclosure_penalty(f, amt)
        and failure_by(f, p);
    then immunity S6713dDeficiencyImmunityIdentityTheftHolder {
        holder p;
        protected_effect deficiency_procedure_would_apply_to_penalty(f);
        window [-infinity, infinity];
    };
}

// --- §6714: failure to meet disclosure requirements applicable to quid pro quo contributions ------
relation organization_failed_quid_pro_quo_disclosure_6115(f: FailureContext) kind empirical {
    label en official "an organization fails to meet the disclosure requirement of section 6115 with respect to a quid pro quo contribution";
}
pub relation quid_pro_quo_disclosure_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$10 for each contribution for which the disclosure is not made, not exceeding $5,000 for a particular fundraising event or mailing";
}
@source(IRC_S6714_A, relation = formalizes, coverage = exact, quote = "such organization shall pay a penalty of $10 for each contribution in respect of which the organization fails to make the required disclosure, except that the total penalty imposed by this subsection with respect to a particular fundraising event or mailing shall not exceed $5,000")
rule S6714aPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and organization_failed_quid_pro_quo_disclosure_6115(f)
        and failure_count(f, n);
    then quid_pro_quo_disclosure_penalty(f, min(round(QuidProQuoDisclosurePenaltyPerContribution * n, 2, "HALF_UP"), round(QuidProQuoDisclosureEventCap, 2, "HALF_UP")));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and organization_failed_quid_pro_quo_disclosure_6115(f)
        and failure_count(f, n);
}

// --- §6715: dyed fuel sold for taxable use, etc. --------------------------------------------
relation dyed_fuel_sold_or_held_for_sale_for_taxable_use_knowingly(f: FailureContext) kind empirical {
    label en official "dyed fuel is sold or held for sale by any person for any use which such person knows or has reason to know is not a nontaxable use of such fuel";
}
relation dyed_fuel_held_or_used_for_taxable_use_knowingly(f: FailureContext) kind empirical {
    label en official "dyed fuel is held for use or used by any person for a use other than a nontaxable use and such person knew, or had reason to know, that such fuel was so dyed";
}
relation willfully_alters_or_attempts_to_alter_dye(f: FailureContext) kind empirical {
    label en official "any person willfully alters, chemically or otherwise, or attempts to so alter, the strength or composition of any dye or marking done pursuant to section 4082 in any dyed fuel";
}
relation sells_altered_dyed_fuel_for_taxable_use_with_knowledge(f: FailureContext) kind empirical {
    label en official "any person who has knowledge that a dyed fuel which has been altered sells or holds for sale such fuel for any use which the person knows or has reason to know is not a nontaxable use of such fuel";
}
relation fuel_is_dyed_diesel_fuel_or_kerosene(f: FailureContext) kind empirical {
    label en official "any dyed diesel fuel or kerosene, whether or not the fuel was dyed pursuant to section 4082";
}
pub relation dyed_fuel_6715c1(f: FailureContext) kind institutional {
    label en official "the term \"dyed fuel\" means any dyed diesel fuel or kerosene, whether or not the fuel was dyed pursuant to section 4082";
}
@source(IRC_S6715_C, relation = formalizes, coverage = exact, quote = "The term \"dyed fuel\" means any dyed diesel fuel or kerosene, whether or not the fuel was dyed pursuant to section 4082")
rule S6715c1DyedFuel strict {
    for f: FailureContext;
    when fuel_is_dyed_diesel_fuel_or_kerosene(f);
    then dyed_fuel_6715c1(f);
}
relation dyed_fuel_penalty_ground(f: FailureContext) kind institutional {
    label en unofficial "a section 6715(a) ground is established for the act";
}
@source(IRC_S6715_A, relation = formalizes, coverage = exact, quote = "any dyed fuel is sold or held for sale by any person for any use which such person knows or has reason to know is not a nontaxable use of such fuel")
rule S6715a1Ground strict {
    for f: FailureContext;
    when dyed_fuel_sold_or_held_for_sale_for_taxable_use_knowingly(f)
        and dyed_fuel_6715c1(f);
    then dyed_fuel_penalty_ground(f);
}
@source(IRC_S6715_A, relation = formalizes, coverage = exact, quote = "any dyed fuel is held for use or used by any person for a use other than a nontaxable use and such person knew, or had reason to know, that such fuel was so dyed")
rule S6715a2Ground strict {
    for f: FailureContext;
    when dyed_fuel_held_or_used_for_taxable_use_knowingly(f)
        and dyed_fuel_6715c1(f);
    then dyed_fuel_penalty_ground(f);
}
@source(IRC_S6715_A, relation = formalizes, coverage = exact, quote = "any person willfully alters, chemically or otherwise, or attempts to so alter, the strength or composition of any dye or marking done pursuant to section 4082 in any dyed fuel")
rule S6715a3Ground strict {
    for f: FailureContext;
    when willfully_alters_or_attempts_to_alter_dye(f)
        and dyed_fuel_6715c1(f);
    then dyed_fuel_penalty_ground(f);
}
@source(IRC_S6715_A, relation = formalizes, coverage = exact, quote = "any person who has knowledge that a dyed fuel which has been altered as described in paragraph (3) sells or holds for sale such fuel")
rule S6715a4Ground strict {
    for f: FailureContext;
    when sells_altered_dyed_fuel_for_taxable_use_with_knowledge(f)
        and dyed_fuel_6715c1(f);
    then dyed_fuel_penalty_ground(f);
}
relation gallons_of_dyed_fuel_involved(f: FailureContext, gallons: Decimal) kind empirical {
    label en unofficial "the number of gallons of the dyed fuel involved in the act (case fact)";
}
relation prior_penalties_under_6715_count(f: FailureContext, k: Integer) kind empirical {
    label en official "the number of prior penalties imposed by this section on such person (or a related person or any predecessor of such person or related person) (case fact)";
}
pub relation dyed_fuel_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "on each act, the greater of $1,000 (increased by $1,000 for each prior penalty) or $10 for each gallon of the dyed fuel involved";
}
@source(IRC_S6715_B, relation = formalizes, coverage = exact, quote = "the amount of the penalty under subsection (a) on each act shall be the greater of—")
rule S6715bPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for g: Decimal;
    for k: Integer;
    when failure_by(f, p)
        and dyed_fuel_penalty_ground(f)
        and gallons_of_dyed_fuel_involved(f, g)
        and prior_penalties_under_6715_count(f, k);
    then dyed_fuel_penalty(f, max(round(DyedFuelPenaltyMinimum * (k + 1), 2, "HALF_UP"), round(DyedFuelPenaltyPerGallon * g, 2, "HALF_UP")));
}
relation willfully_participated_in_act_giving_rise_to_penalty(f: FailureContext, q: Person) kind empirical {
    label en official "the officer, employee, or agent of the business entity willfully participated in any act giving rise to such penalty";
}
pub relation jointly_and_severally_liable_6715d(f: FailureContext, q: Person) kind institutional {
    label en unofficial "each officer, employee, or agent of the business entity who willfully participated in any act giving rise to the penalty is jointly and severally liable with the entity";
}
@source(IRC_S6715_D, relation = formalizes, coverage = exact, quote = "each officer, employee, or agent of such entity who willfully participated in any act giving rise to such penalty shall be jointly and severally liable with such entity for such penalty")
rule S6715dJointAndSeveral defeasible {
    for f: FailureContext;
    for q: Person;
    for a: Money;
    when dyed_fuel_penalty(f, a)
        and willfully_participated_in_act_giving_rise_to_penalty(f, q);
    then jointly_and_severally_liable_6715d(f, q);
}
relation penalized_after_chemical_analysis(f: FailureContext) kind empirical {
    label en official "the person is found to be subject to the penalty under this section after a chemical analysis of such fuel";
}
relation penalized_at_least_twice_after_enactment_of_6715e(f: FailureContext) kind empirical {
    label en official "the person has been penalized under this section at least twice after the date of the enactment of the subsection";
}
relation appeal_claim_concerns_fraud_or_mistake_in_chemical_analysis(f: FailureContext) kind empirical {
    label en official "the claim regards fraud or mistake in the chemical analysis";
}
relation appeal_claim_concerns_mathematical_calculation_of_penalty(f: FailureContext) kind empirical {
    label en official "the claim regards mathematical calculation of the amount of the penalty";
}
pub relation administrative_appeal_or_review_barred_6715e(f: FailureContext) kind institutional {
    label en unofficial "no administrative appeal or review is allowed with respect to the finding";
}
@source(IRC_S6715_E, relation = formalizes, coverage = exact, quote = "no administrative appeal or review shall be allowed with respect to such finding")
rule S6715eNoAdministrativeAppeal defeasible {
    for f: FailureContext;
    when penalized_after_chemical_analysis(f)
        and penalized_at_least_twice_after_enactment_of_6715e(f);
    then administrative_appeal_or_review_barred_6715e(f);
    unless appeal_claim_concerns_fraud_or_mistake_in_chemical_analysis(f)
        and penalized_after_chemical_analysis(f)
        and penalized_at_least_twice_after_enactment_of_6715e(f);
    unless appeal_claim_concerns_mathematical_calculation_of_penalty(f)
        and penalized_after_chemical_analysis(f)
        and penalized_at_least_twice_after_enactment_of_6715e(f);
}

// --- §6715A: tampering with or failing to maintain security requirements for mechanical dye injection systems
relation tampers_with_mechanical_dye_injection_system(f: FailureContext) kind empirical {
    label en official "any person tampers with a mechanical dye injection system used to indelibly dye fuel for purposes of section 4082";
}
relation operator_failed_to_maintain_dye_injection_security_standards(f: FailureContext) kind empirical {
    label en official "any operator of a mechanical dye injection system used to indelibly dye fuel for purposes of section 4082 fails to maintain the security standards for such system as established by the Secretary";
}
relation fuel_gallons_involved_in_tampering(f: FailureContext, gallons: Decimal) kind empirical {
    label en unofficial "the number of gallons of fuel involved in the violation (case fact)";
}
relation days_after_security_violation_discovered_or_reasonably_known(f: FailureContext, n: Integer) kind empirical {
    label en unofficial "the number of days after which such violation was discovered or such person should have reasonably known of such violation (case fact)";
}
pub relation dye_injection_tampering_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "for each violation, the greater of $25,000 or $10 for each gallon of fuel involved";
}
@source(IRC_S6715A_B, relation = formalizes, coverage = exact, quote = "for each violation described in paragraph (1), the greater of—")
rule S6715AbTamperingPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for g: Decimal;
    when failure_by(f, p)
        and tampers_with_mechanical_dye_injection_system(f)
        and fuel_gallons_involved_in_tampering(f, g);
    then dye_injection_tampering_penalty(f, max(round(DyeInjectionTamperingPenaltyMinimum, 2, "HALF_UP"), round(DyeInjectionTamperingPenaltyPerGallon * g, 2, "HALF_UP")));
}
pub relation dye_injection_security_failure_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$1,000 for each failure to maintain security standards";
}
@source(IRC_S6715A_B, relation = formalizes, coverage = exact, quote = "failure to maintain security standards described in paragraph (2), $1,000, and")
rule S6715AbSecurityFailurePenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and operator_failed_to_maintain_dye_injection_security_standards(f)
        and failure_count(f, n);
    then dye_injection_security_failure_penalty(f, round(DyeInjectionSecurityFailurePenalty * n, 2, "HALF_UP"));
}
pub relation dye_injection_uncorrected_violation_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$1,000 per day for each day after which the violation was discovered or should have reasonably been known";
}
@source(IRC_S6715A_B, relation = formalizes, coverage = exact, quote = "failure to correct a violation described in paragraph (2), $1,000 per day for each day after which such violation was discovered or such person should have reasonably known of such violation")
rule S6715AbUncorrectedViolationPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and operator_failed_to_maintain_dye_injection_security_standards(f)
        and days_after_security_violation_discovered_or_reasonably_known(f, n);
    then dye_injection_uncorrected_violation_penalty(f, round(DyeInjectionUncorrectedViolationPenaltyPerDay * n, 2, "HALF_UP"));
}
relation business_entity_or_contracting_party_participant_willful_6715A(f: FailureContext, q: Person) kind empirical {
    label en official "the officer, employee, or agent of the business entity or other contracting party willfully participated in any act giving rise to the penalty";
}
pub relation jointly_and_severally_liable_6715Ac1(f: FailureContext, q: Person) kind institutional {
    label en unofficial "each officer, employee, agent or other contracting party who willfully participated is jointly and severally liable with the business entity for the section 6715A penalty";
}
@source(IRC_S6715A_C, relation = formalizes, coverage = exact, quote = "each officer, employee, or agent of such entity or other contracting party who willfully participated in any act giving rise to such penalty shall be jointly and severally liable with such entity for such penalty")
rule S6715Ac1JointAndSeveral defeasible {
    for f: FailureContext;
    for q: Person;
    for a: Money;
    when dye_injection_tampering_penalty(f, a)
        and business_entity_or_contracting_party_participant_willful_6715A(f, q);
    then jointly_and_severally_liable_6715Ac1(f, q);
}
relation business_entity_is_part_of_affiliated_group_with_parent(f: FailureContext, q: Person) kind empirical {
    label en official "the business entity is part of an affiliated group (as defined in section 1504(a)) whose parent corporation is the given person";
}
pub relation parent_jointly_and_severally_liable_6715Ac2(f: FailureContext, q: Person) kind institutional {
    label en unofficial "the parent corporation of the affiliated group is jointly and severally liable with the entity for the section 6715A penalty";
}
@source(IRC_S6715A_C, relation = formalizes, coverage = exact, quote = "the parent corporation of such entity shall be jointly and severally liable with such entity for the penalty imposed under this section")
rule S6715Ac2ParentLiable defeasible {
    for f: FailureContext;
    for q: Person;
    for a: Money;
    when dye_injection_tampering_penalty(f, a)
        and business_entity_is_part_of_affiliated_group_with_parent(f, q);
    then parent_jointly_and_severally_liable_6715Ac2(f, q);
}

// --- §6717: refusal of entry --------------------------------------------------------------
relation refused_entry_or_action_authorized_by_4083d1(f: FailureContext) kind empirical {
    label en official "any person refuses to admit entry or refuses to permit any other action by the Secretary authorized by section 4083(d)(1)";
}
pub relation refusal_of_entry_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "a penalty of $1,000 for such refusal";
}
@source(IRC_S6717_A, relation = formalizes, coverage = exact, quote = "shall pay a penalty of $1,000 for such refusal")
rule S6717aPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    when failure_by(f, p)
        and refused_entry_or_action_authorized_by_4083d1(f);
    then refusal_of_entry_penalty(f, round(RefusalOfEntryPenalty, 2, "HALF_UP"));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and refused_entry_or_action_authorized_by_4083d1(f);
}
relation willfully_participated_in_refusal(f: FailureContext, q: Person) kind empirical {
    label en official "the officer, employee, agent or other contracting party of the business entity willfully participated in any act giving rise to the penalty";
}
pub relation jointly_and_severally_liable_6717b1(f: FailureContext, q: Person) kind institutional {
    label en unofficial "each officer, employee, agent or other contracting party who willfully participated is jointly and severally liable with the entity for the section 6717 penalty";
}
@source(IRC_S6717_B, relation = formalizes, coverage = exact, quote = "each officer, employee, or agent of such entity or other contracting party who willfully participated in any act giving rise to such penalty shall be jointly and severally liable with such entity for such penalty")
rule S6717b1JointAndSeveral defeasible {
    for f: FailureContext;
    for q: Person;
    for a: Money;
    when refusal_of_entry_penalty(f, a)
        and willfully_participated_in_refusal(f, q);
    then jointly_and_severally_liable_6717b1(f, q);
}
relation refusing_entity_is_part_of_affiliated_group_with_parent(f: FailureContext, q: Person) kind empirical {
    label en official "the business entity is part of an affiliated group (as defined in section 1504(a)) whose parent corporation is the given person";
}
pub relation parent_jointly_and_severally_liable_6717b2(f: FailureContext, q: Person) kind institutional {
    label en unofficial "the parent corporation of the affiliated group is jointly and severally liable with the entity for the section 6717 penalty";
}
@source(IRC_S6717_B, relation = formalizes, coverage = exact, quote = "the parent corporation of such entity shall be jointly and severally liable with such entity for the penalty imposed under this section")
rule S6717b2ParentLiable defeasible {
    for f: FailureContext;
    for q: Person;
    for a: Money;
    when refusal_of_entry_penalty(f, a)
        and refusing_entity_is_part_of_affiliated_group_with_parent(f, q);
    then parent_jointly_and_severally_liable_6717b2(f, q);
}

// --- §6718: failure to display tax registration on vessels ---------------------------------------
relation vessel_operator_failed_to_display_proof_of_registration(f: FailureContext) kind empirical {
    label en official "an operator of a vessel fails to display proof of registration pursuant to section 4101(a)(3) (the occurrence is one vessel in one calendar month: only one penalty per vessel per month)";
}
relation prior_month_penalties_count(f: FailureContext, k: Integer) kind empirical {
    label en official "the aggregate number of penalties imposed with respect to prior months by this section on such person (or a related person or any predecessor) (case fact)";
}
pub relation vessel_registration_display_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$500, increased by $500 for each penalty imposed for prior months";
}
@source(IRC_S6718_A, relation = formalizes, coverage = exact, quote = "shall pay a penalty of $500 for each such failure. With respect to any vessel, only one penalty shall be imposed by this section during any calendar month")
rule S6718aPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for k: Integer;
    when failure_by(f, p)
        and vessel_operator_failed_to_display_proof_of_registration(f)
        and prior_month_penalties_count(f, k);
    then vessel_registration_display_penalty(f, round(VesselRegistrationDisplayPenalty * (k + 1), 2, "HALF_UP"));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and vessel_operator_failed_to_display_proof_of_registration(f)
        and prior_month_penalties_count(f, k);
}

// --- §6719: failure to register or reregister ------------------------------------------------------
relation required_to_register_or_reregister_under_4101_and_failed(f: FailureContext) kind empirical {
    label en official "every person who is required to register or reregister under section 4101 and fails to do so";
}
pub relation registration_failure_initial_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$10,000 for each initial failure to register or reregister";
}
@source(IRC_S6719_B, relation = formalizes, coverage = exact, quote = "$10,000 for each initial failure to register or reregister, and")
rule S6719bInitialPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and required_to_register_or_reregister_under_4101_and_failed(f)
        and failure_count(f, n);
    then registration_failure_initial_penalty(f, round(RegistrationFailureInitialPenalty * n, 2, "HALF_UP"));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and required_to_register_or_reregister_under_4101_and_failed(f)
        and failure_count(f, n);
}
pub relation registration_failure_daily_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$1,000 for each day thereafter such person fails to register or reregister";
}
@source(IRC_S6719_B, relation = formalizes, coverage = exact, quote = "$1,000 for each day thereafter such person fails to register or reregister")
rule S6719bDailyPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and required_to_register_or_reregister_under_4101_and_failed(f)
        and failure_days(f, n);
    then registration_failure_daily_penalty(f, round(RegistrationFailureDailyPenalty * n, 2, "HALF_UP"));
    unless reasonable_cause_shown(p, f)
        and failure_by(f, p)
        and required_to_register_or_reregister_under_4101_and_failed(f)
        and failure_days(f, n);
}

// --- §6720: fraudulent acknowledgments with respect to donations of motor vehicles, boats, and airplanes
relation donee_knowingly_furnished_false_or_fraudulent_acknowledgment(f: FailureContext) kind empirical {
    label en official "a donee organization required under section 170(f)(12)(A) to furnish a contemporaneous written acknowledgment to a donor knowingly furnishes a false or fraudulent acknowledgment";
}
relation donee_knowingly_failed_to_furnish_acknowledgment(f: FailureContext) kind empirical {
    label en official "a donee organization knowingly fails to furnish such acknowledgment in the manner, at the time, and showing the information required under section 170(f)(12), or regulations prescribed thereunder";
}
relation acknowledgment_is_for_qualified_vehicle_sold_under_170f12Aii(f: FailureContext) kind empirical {
    label en official "the acknowledgment is with respect to a qualified vehicle to which section 170(f)(12)(A)(ii) applies";
}
relation sales_price_stated_on_acknowledgment(f: FailureContext, amount: Money) kind empirical {
    label en official "the sales price stated on the acknowledgment (case fact)";
}
relation gross_proceeds_from_sale_of_vehicle(f: FailureContext, amount: Money) kind empirical {
    label en official "the gross proceeds from the sale of such vehicle (case fact)";
}
relation claimed_value_of_vehicle(f: FailureContext, amount: Money) kind empirical {
    label en official "the claimed value of the vehicle (case fact)";
}
pub relation highest_section_1_rate_for_penalty(f: FailureContext, rate: Decimal) kind institutional {
    label en unofficial "PENDING (owner: income-individual) - the highest rate of tax specified in section 1";
}
relation donee_acknowledgment_violation(f: FailureContext) kind institutional {
    label en unofficial "a section 6720 act or failure: a knowingly false or fraudulent acknowledgment, or a knowing failure to furnish it";
}
@source(IRC_S6720, relation = formalizes, coverage = exact, quote = "which knowingly furnishes a false or fraudulent acknowledgment")
rule S6720ViolationFalse strict {
    for f: FailureContext;
    when donee_knowingly_furnished_false_or_fraudulent_acknowledgment(f);
    then donee_acknowledgment_violation(f);
}
@source(IRC_S6720, relation = formalizes, coverage = exact, quote = "or which knowingly fails to furnish such acknowledgment in the manner, at the time, and showing the information required under section 170(f)(12), or regulations prescribed thereunder")
rule S6720ViolationFailure strict {
    for f: FailureContext;
    when donee_knowingly_failed_to_furnish_acknowledgment(f);
    then donee_acknowledgment_violation(f);
}
pub relation donee_acknowledgment_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "for each such act or failure, the greater of the highest section 1 rate times the sales price stated (or claimed value) or the gross proceeds (or $5,000)";
}
@source(IRC_S6720, relation = formalizes, coverage = exact, quote = "in the case of an acknowledgment with respect to a qualified vehicle to which section 170(f)(12)(A)(ii) applies, the greater of—")
rule S6720aSoldVehiclePenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for r: Decimal;
    for s: Money;
    for g: Money;
    when failure_by(f, p)
        and donee_acknowledgment_violation(f)
        and acknowledgment_is_for_qualified_vehicle_sold_under_170f12Aii(f)
        and highest_section_1_rate_for_penalty(f, r)
        and sales_price_stated_on_acknowledgment(f, s)
        and gross_proceeds_from_sale_of_vehicle(f, g);
    then donee_acknowledgment_penalty(f, max(round(s * r, 2, "HALF_UP"), g));
}
@source(IRC_S6720, relation = formalizes, coverage = exact, quote = "in the case of an acknowledgment with respect to any other qualified vehicle to which section 170(f)(12) applies, the greater of—")
rule S6720bOtherVehiclePenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for r: Decimal;
    for v: Money;
    when failure_by(f, p)
        and donee_acknowledgment_violation(f)
        and not_known(acknowledgment_is_for_qualified_vehicle_sold_under_170f12Aii(f))
        and highest_section_1_rate_for_penalty(f, r)
        and claimed_value_of_vehicle(f, v);
    then donee_acknowledgment_penalty(f, max(round(v * r, 2, "HALF_UP"), round(DonationAcknowledgmentOtherVehicleMinimum, 2, "HALF_UP")));
}

// --- §6720A: penalty with respect to certain adulterated fuels ---------------------------------------
relation knowingly_transferred_sold_or_held_out_for_resale_substandard_diesel_liquid(f: FailureContext) kind empirical {
    label en official "a person knowingly transfers for resale, sells for resale, or holds out for resale any liquid for use in a diesel-powered highway vehicle or a diesel-powered train which does not meet applicable EPA regulations";
}
relation knowingly_held_out_for_sale_other_than_resale_substandard_liquid(f: FailureContext) kind empirical {
    label en official "a person knowingly holds out for sale (other than for resale) any liquid described in subsection (a)";
}
pub relation substandard_diesel_resale_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$10,000 for each transfer, sale, or holding out for resale, in addition to the tax on such liquid (if any)";
}
@source(IRC_S6720A_A, relation = formalizes, coverage = exact, quote = "shall pay a penalty of $10,000 for each such transfer, sale, or holding out for resale, in addition to the tax on such liquid (if any)")
rule S6720aPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and knowingly_transferred_sold_or_held_out_for_resale_substandard_diesel_liquid(f)
        and failure_count(f, n);
    then substandard_diesel_resale_penalty(f, round(SubstandardDieselTransferPenalty * n, 2, "HALF_UP"));
}
pub relation substandard_diesel_holding_out_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$10,000 for each such holding out for sale, in addition to the tax on such liquid (if any)";
}
@source(IRC_S6720A_B, relation = formalizes, coverage = exact, quote = "shall pay a penalty of $10,000 for each such holding out for sale, in addition to the tax on such liquid (if any)")
rule S6720bPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and knowingly_held_out_for_sale_other_than_resale_substandard_liquid(f)
        and failure_count(f, n);
    then substandard_diesel_holding_out_penalty(f, round(SubstandardDieselHoldingOutForSalePenalty * n, 2, "HALF_UP"));
}

// --- §6720B: fraudulent identification of exempt use property --------------------------------------------
relation identified_applicable_property_as_related_use_knowing_not_intended(f: FailureContext) kind empirical {
    label en official "a person identifies applicable property (as defined in section 170(e)(7)(C)) as having a use which is related to a purpose or function constituting the basis for the donee's exemption under section 501 and knows that such property is not intended for such a use";
}
pub relation misidentified_property_use_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "a penalty of $10,000, in addition to any criminal penalty";
}
@source(IRC_S6720B, relation = formalizes, coverage = exact, quote = "shall pay a penalty of $10,000")
rule S6720BPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    when failure_by(f, p)
        and identified_applicable_property_as_related_use_knowing_not_intended(f);
    then misidentified_property_use_penalty(f, round(MisidentifiedPropertyUsePenalty, 2, "HALF_UP"));
}

// --- §6720C: penalty for failure to notify health plan of cessation of eligibility for COBRA premium assistance
relation failed_to_notify_group_health_plan_of_ineligibility(f: FailureContext) kind empirical {
    label en official "a person required to notify a group health plan under section 9501(a)(2)(B) of the American Rescue Plan Act of 2021 fails to make such a notification at such time and in such manner as the Secretary of Labor may require";
}
relation notification_failure_is_fraudulent(f: FailureContext) kind empirical {
    label en official "the failure is fraudulent";
}
relation premium_assistance_after_termination_of_eligibility(f: FailureContext, amount: Money) kind empirical {
    label en official "the premium assistance provided under section 9501(a)(1)(A) of the American Rescue Plan Act of 2021 after termination of eligibility under such section (case fact)";
}
pub relation group_health_notification_failure_penalty(f: FailureContext, amount: Money) kind institutional {
    label en unofficial "$250 for each failure; for a fraudulent failure the greater of $250 or 110 percent of the premium assistance after termination of eligibility";
}
@source(IRC_S6720C_A, relation = formalizes, coverage = exact, quote = "shall pay a penalty of $250 for each such failure")
rule S6720CaOrdinaryPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for n: Integer;
    when failure_by(f, p)
        and failed_to_notify_group_health_plan_of_ineligibility(f)
        and not_known(notification_failure_is_fraudulent(f))
        and failure_count(f, n);
    then group_health_notification_failure_penalty(f, round(GroupHealthNotificationFailurePenalty * n, 2, "HALF_UP"));
    unless reasonable_cause_and_no_willful_neglect(p, f)
        and failure_by(f, p)
        and failed_to_notify_group_health_plan_of_ineligibility(f)
        and not_known(notification_failure_is_fraudulent(f))
        and failure_count(f, n);
}
@source(IRC_S6720C_B, relation = formalizes, coverage = exact, quote = "such person shall pay a penalty equal to the greater of—")
rule S6720CbFraudulentPenalty defeasible {
    for f: FailureContext;
    for p: Person;
    for a: Money;
    when failure_by(f, p)
        and failed_to_notify_group_health_plan_of_ineligibility(f)
        and notification_failure_is_fraudulent(f)
        and premium_assistance_after_termination_of_eligibility(f, a);
    then group_health_notification_failure_penalty(f, max(round(GroupHealthFraudulentFailureMinimum, 2, "HALF_UP"), round(a * GroupHealthPremiumAssistanceRate, 2, "HALF_UP")));
    unless reasonable_cause_and_no_willful_neglect(p, f)
        and failure_by(f, p)
        and failed_to_notify_group_health_plan_of_ineligibility(f)
        and notification_failure_is_fraudulent(f)
        and premium_assistance_after_termination_of_eligibility(f, a);
}
