    locator "section/6717/note/2";
    text en official """Effective Date
Section effective Jan. 1, 2005, see section 859(c) of Pub. L. 108–357, set out as an Effective Date of 2004 Amendment note under section 4083 of this title.""";
    content_hash "sha256:1c999946df7da152b6f93134f66685671c5ecb0aa223cfb0dd75c520ee411f37";
}

// 26 U.S.C. 6718(a) — Failure to display tax registration on vessels
fragment IRC_S6718_A in IRC_2024_EDITION {
    kind subsection;
    locator "section/6718/a";
    text en official """(a) Failure to display registration
Every operator of a vessel who fails to display proof of registration pursuant to section 4101(a)(3) shall pay a penalty of $500 for each such failure. With respect to any vessel, only one penalty shall be imposed by this section during any calendar month.""";
    content_hash "sha256:50cdd649d4b6b112154852680dd6224db722b85cb2fa524023b92341f79bc7e8";
}

// 26 U.S.C. 6718(b) — Failure to display tax registration on vessels
fragment IRC_S6718_B in IRC_2024_EDITION {
    kind subsection;
    locator "section/6718/b";
    text en official """(b) Multiple violations
In determining the penalty under subsection (a) on any person, subsection (a) shall be applied by increasing the amount in subsection (a) by the product of such amount and the aggregate number of penalties (if any) imposed with respect to prior months by this section on such person (or a related person or any predecessor of such person or related person).""";
    content_hash "sha256:0c48be6f384c724336788f0cdc5ff1fc1d780922f17376321edd68b906e32d36";
}

// 26 U.S.C. 6718(c) — Failure to display tax registration on vessels
fragment IRC_S6718_C in IRC_2024_EDITION {
