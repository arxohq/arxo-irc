// 26 U.S.C. 6676(a) — Erroneous claim for refund or credit
fragment IRC_S6676_A in IRC_2024_EDITION {
    kind subsection;
    locator "section/6676/a";
    text en official """(a) Civil penalty
If a claim for refund or credit with respect to income tax is made for an excessive amount, unless it is shown that the claim for such excessive amount is due to reasonable cause, the person making such claim shall be liable for a penalty in an amount equal to 20 percent of the excessive amount.""";
    content_hash "sha256:45bfd07268ca0cf830ab91e2a17e457e00c956cce2c3ccc62f5e8a438bfe95fa";
}

// 26 U.S.C. 6676(b) — Erroneous claim for refund or credit
fragment IRC_S6676_B in IRC_2024_EDITION {
    kind subsection;
    locator "section/6676/b";
    text en official """(b) Excessive amount
For purposes of this section, the term "excessive amount" means in the case of any person the amount by which the amount of the claim for refund or credit for any taxable year exceeds the amount of such claim allowable under this title for such taxable year.""";
    content_hash "sha256:812a7b98b68eac8f71066f290005849c21aea813ac7327d1633d9e1a3bd5f55e";
}

// 26 U.S.C. 6676(c) — Erroneous claim for refund or credit
fragment IRC_S6676_C in IRC_2024_EDITION {
    kind subsection;
    locator "section/6676/c";
    text en official """(c) Noneconomic substance transactions treated as lacking reasonable cause
For purposes of this section, any excessive amount which is attributable to any transaction described in section 6662(b)(6) shall not be treated as due to reasonable cause.""";
    content_hash "sha256:c0f1f6a07087ab239df69c60eb4febc20fc67ee06388af348138af2751be56fd";
}

// 26 U.S.C. 6676(d) — Erroneous claim for refund or credit
fragment IRC_S6676_D in IRC_2024_EDITION {
    kind subsection;
    locator "section/6676/d";
    text en official """(d) Coordination with other penalties
This section shall not apply to any portion of the excessive amount of a claim for refund or credit which is subject to a penalty imposed under part II of subchapter A of chapter 68.""";
    content_hash "sha256:55c8021f1f10e12ef11039dda3294188578e9f7484c6ecc1fd76a47071adf79d";
}

// 26 U.S.C. §6676 — statutory note 6 (effectivedate-amendment-note)
