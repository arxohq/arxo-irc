    kind note;
    locator "section/6701/note/4";
    text en official """Effective Date of 1989 Amendment
Pub. L. 101–239, title VII, §7735(c), Dec. 19, 1989, 103 Stat. 2404, provided that: "The amendments made by this section [amending this section] shall take effect on December 31, 1989." """;
    content_hash "sha256:dc7c97bf01eeb5c554070c45d38156f4c01cc0bf35c3555e81c8742914925d00";
