// 26 U.S.C. §6864 — Termination of extended period for payment in case of carryback
fragment IRC_S6864 in IRC_2024_EDITION {
    kind section;
    locator "section/6864";
    text en official """Termination of extended period for payment in case of carryback
For termination of extensions of time for payment of income tax granted to corporations expecting carrybacks in case of jeopardy, see section 6164(h).""";
    content_hash "sha256:dbce6fb9964f5790a6ea86905f2054d017c308865798158660e6edb337ea0e64";
}

