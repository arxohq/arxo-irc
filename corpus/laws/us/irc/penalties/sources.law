// 26 U.S.C. 6719(a) — Failure to register or reregister
fragment IRC_S6719_A in IRC_2024_EDITION {
    kind subsection;
    locator "section/6719/a";
    text en official """(a) Failure to register or reregister
Every person who is required to register or reregister under section 4101 and fails to do so shall pay a penalty in addition to the tax (if any).""";
    content_hash "sha256:24e275d87bfb4897ed01b19b0d2fbd3c14a69b08fafb4822cd70d8a6f011da83";
}

// 26 U.S.C. 6719(b) — Failure to register or reregister
fragment IRC_S6719_B in IRC_2024_EDITION {
    kind subsection;
    locator "section/6719/b";
    text en official """(b) Amount of penalty
The amount of the penalty under subsection (a) shall be—
(1) $10,000 for each initial failure to register or reregister, and
(2) $1,000 for each day thereafter such person fails to register or reregister.""";
    content_hash "sha256:9e20228f7d60cc689c7c5b3207516de7181c747a55d3d9f1d1671d7829bfc87f";
}

// 26 U.S.C. 6719(c) — Failure to register or reregister
fragment IRC_S6719_C in IRC_2024_EDITION {
    kind subsection;
    locator "section/6719/c";
    text en official """(c) Reasonable cause exception
No penalty shall be imposed under this section with respect to any failure if it is shown that such failure is due to reasonable cause.""";
    content_hash "sha256:b0bfe98d099fdf0f619965cc96c0779679e731f313dec7c48e37ebf092866db9";
}

