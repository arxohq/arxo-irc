// Penalties -- WIRE-10, group A (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// Section 6665(a): the additions to the tax, additional amounts and penalties are assessed, collected and paid in the same manner as taxes and a reference
// to "tax" includes them. Chapter 51 applies that rule by reference to two penalties of `us.irc.alcohol`: section 5114(c)(3) (the drawback compliance penalty
// of paragraph (2)) and section 5684(b) (the penalty for failure to pay the alcohol tax): "assessed, collected, and paid in the same manner as taxes, as
// provided in section 6665(a)". The owner of the manner of assessment is this package (`treated_as_tax`, module 03); it reads the two alcohol penalties (this
// package -> alcohol; the reverse import is a cycle through credits, which imports alcohol).
//
// JUDGMENT CALL: `treated_as_tax` is keyed by the taxing chapter and the amount only (module 03); the chapter is AlcoholExciseCh51 (the chapter of the two
// penalties), which is a statement about where the penalty sits, not a claim that chapter 68 itself covers it: section 6665(a) reaches chapter 51 penalties
// only through the two cross-references above.

language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

use self::{
    FailureContext,
    IRC_S6651_B,
    IRC_S6664_A,
    IRC_S6665_A,
    IRC_S6672_C,
    IRC_S6694_C,
    IRC_S6703_C,
    Person,
    Return,
    TaxKind,
    TaxableYear,
    WagePayment,
    amount_paid_on_or_before,
    collection_limitation_suspended_6703c3,
    preparer_collection_limitation_suspended_6694c3,
    tax_shown_on_return,
    tfrp_collection_limitation_suspended_6672c4,
    treated_as_tax,
};

@source(IRC_S6665_A, relation = formalizes, coverage = partial, quote = "shall be assessed, collected, and paid in the same manner as taxes")
rule W10AAlcoholLatePaymentPenaltyTreatedAsTax strict {
    label en official "section 5684(b) with section 6665(a): the penalty for failure to pay the alcohol tax is assessed, collected and paid in the same manner as taxes";
    for l: us.irc.alcohol::LateAlcoholTaxPayment;
    for p: Person;
    for amount: Money;
    when us.irc.alcohol::late_alcohol_tax_penalty(l, p, amount);
    then treated_as_tax(us.irc.core::AlcoholExciseCh51, amount);
}
@source(IRC_S6665_A, relation = formalizes, coverage = partial, quote = "shall be assessed, collected, and paid in the same manner as taxes")
rule W10AAlcoholDrawbackPenaltyTreatedAsTax strict {
    label en official "section 5114(c)(3) with section 6665(a): the drawback compliance penalty is assessed, collected and paid in the same manner as taxes";
    for c: us.irc.alcohol::NonBeverageDrawbackClaim;
    for amount: Money;
    when us.irc.alcohol::drawback_noncompliance_penalty(c, amount);
    then treated_as_tax(us.irc.core::AlcoholExciseCh51, amount);
}

// =====================================================================================================================
// Sections 6672(c)(4), 6694(c)(3), 6703(c)(3): suspension of the section 6502 collection period
// =====================================================================================================================
//
// Each of the three paragraphs says that the running of the section 6502 period on collection of the penalty "shall be suspended for the period during which
// the Secretary is prohibited from collecting by levy or a proceeding in court". This package derives the fact of the stay (`tfrp_collection_limitation_suspended_6672c4`,
// `preparer_collection_limitation_suspended_6694c3`, `collection_limitation_suspended_6703c3`); the clock is `us.irc.assessment::collection_period_ends`, whose
// suspension hook is `collection_period_suspension(a, origin, start, end)`. This package feeds the hook (qualified head; penalties -> assessment is acyclic) with
// three new origins added to `CollectionSuspensionKind` (assessment, module 16), once the case names the assessment of the penalty and the dates of the prohibition.
//
// JUDGMENT CALLS
//  - The statutes name no thirty-day tail: the suspension is exactly the period of the prohibition (unlike section 6503(b), (h)).
//  - The prohibition period and the identity of the penalty assessment are case facts (bridges); the stay itself stays derived by the consumer rules.
//  - The relations feeding the hook are `defeasible` because the stay relations are (LDC-E4103).

pub relation trust_fund_penalty_assessment(p: Person, pay: WagePayment, a: us.irc.core::Assessment) kind empirical {
    label en unofficial "the assessment of the section 6672 penalty of the person for the wage payment";
}
pub relation tfrp_collection_prohibited_during(p: Person, pay: WagePayment, start: Date, end: Date) kind empirical {
    label en official "the period during which the Secretary is prohibited from collecting the section 6672 penalty by levy or a proceeding in court";
}
@source(IRC_S6672_C, relation = formalizes, coverage = exact, quote = "shall be suspended for the period during which the Secretary is prohibited from collecting by levy or a proceeding in court")
rule W10ATfrpSuspensionFeedsCollectionClock defeasible {
    label en official "section 6672(c)(4): the section 6502 collection period is suspended for the period of the prohibition (feeds the assessment clock)";
    for p: Person;
    for pay: WagePayment;
    for a: us.irc.core::Assessment;
    for start: Date;
    for end: Date;
    when tfrp_collection_limitation_suspended_6672c4(p, pay)
        and trust_fund_penalty_assessment(p, pay, a)
        and tfrp_collection_prohibited_during(p, pay, start, end);
    then us.irc.assessment::collection_period_suspension(a, us.irc.assessment::TfrpCollectionStay6672c4, start, end);
}

pub relation preparer_penalty_assessment(f: FailureContext, a: us.irc.core::Assessment) kind empirical {
    label en unofficial "the assessment of the section 6694 penalty";
}
pub relation preparer_collection_prohibited_during(f: FailureContext, start: Date, end: Date) kind empirical {
    label en official "the period during which the Secretary is prohibited from collecting the section 6694 penalty by levy or a proceeding in court";
}
@source(IRC_S6694_C, relation = formalizes, coverage = exact, quote = "shall be suspended for the period during which the Secretary is prohibited from collecting by levy or a proceeding in court")
rule W10APreparerSuspensionFeedsCollectionClock defeasible {
    label en official "section 6694(c)(3): the section 6502 collection period is suspended for the period of the prohibition (feeds the assessment clock)";
    for f: FailureContext;
    for a: us.irc.core::Assessment;
    for start: Date;
    for end: Date;
    when preparer_collection_limitation_suspended_6694c3(f)
        and preparer_penalty_assessment(f, a)
        and preparer_collection_prohibited_during(f, start, end);
    then us.irc.assessment::collection_period_suspension(a, us.irc.assessment::PreparerPenaltyCollectionStay6694c3, start, end);
}

pub relation abusive_penalty_assessment(f: FailureContext, a: us.irc.core::Assessment) kind empirical {
    label en unofficial "the assessment of the section 6700, 6701 or 6702 penalty";
}
pub relation abusive_collection_prohibited_during(f: FailureContext, start: Date, end: Date) kind empirical {
    label en official "the period during which the Secretary is prohibited from collecting the section 6700, 6701 or 6702 penalty by levy or a proceeding in court";
}
@source(IRC_S6703_C, relation = formalizes, coverage = exact, quote = "shall be suspended for the period during which the Secretary is prohibited from collecting by levy or a proceeding in court")
rule W10AAbusiveSuspensionFeedsCollectionClock defeasible {
    label en official "section 6703(c)(3): the section 6502 collection period is suspended for the period of the prohibition (feeds the assessment clock)";
    for f: FailureContext;
    for a: us.irc.core::Assessment;
    for start: Date;
    for end: Date;
    when collection_limitation_suspended_6703c3(f)
        and abusive_penalty_assessment(f, a)
        and abusive_collection_prohibited_during(f, start, end);
    then us.irc.assessment::collection_period_suspension(a, us.irc.assessment::AbusivePenaltyCollectionStay6703c3, start, end);
}

// =====================================================================================================================
// Section 6651(b)(1)-(2): the payments toward the tax of a return applied on or before the due date
// =====================================================================================================================
//
// `amount_paid_on_or_before(r, cutoff, amount)` (module 01, a dependency-contract placeholder "owner: returns / payment-refunds-interest") is the total of the payments
// applied toward the tax of the return on or before the cutoff. The vocabulary already exists in `us.irc.core`: `payment(pay, by, amount, on)` and
// `payment_applied(pay, p, y, kind)`; the return names the same person, year and kind (`return_of`). The rule derives the amount for the cutoff that sections 6651(a)(1)
// and (a)(2) read (the due date of the return); other cutoffs (the beginning of each month of section 6651(b)(2), the date of a notice) stay case facts: a notice
// carries no year or tax kind in core, so its payments cannot be picked out without inventing an identity.
//
// JUDGMENT CALL: the payer is not required to be the taxpayer (a payment by another person applied to the liability counts, section 6151 speaks of the tax paid).

@source(IRC_S6651_B, relation = formalizes, coverage = partial, quote = "the amount of tax required to be shown on the return shall be reduced by the amount of any part of the tax which is paid on or before the date prescribed for payment of the tax")
rule W10AAmountPaidOnOrBeforeDueDateFromPayments strict {
    label en official "section 6651(b)(1): the amount paid on or before the due date is the sum of the payments applied to the tax of the return (its person, year and kind) on or before that date";
    for r: Return;
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for due: Date;
    when us.irc.core::return_of(r, p, y, kind) and us.irc.core::due_date(r, due);
    then amount_paid_on_or_before(r, due,
        sum(collect all a: Money, pay: us.irc.core::Payment, by: Person, payOn: Date where us.irc.core::payment_applied(pay, p, y, kind) and us.irc.core::payment(pay, by, a, payOn) and payOn <= due, empty: 0 USD));
}

// =====================================================================================================================
// Sections 6651(a), 6664(a)(1)(A): the amount shown as the tax on the return
// =====================================================================================================================
//
// `tax_shown_on_return(r, amount)` (module 01, "PENDING (owner: returns)") is the amount shown as the tax by the taxpayer upon the return, the same phrase that
// section 6211(a)(1)(A) uses. `us.irc.assessment` publishes it as `amount_shown_as_tax_by_taxpayer(p, y, kind, amount)`; the return names the same person, year
// and kind (`return_of`), so the placeholder is derived without any new identity. The case-fact channel stays valid.

@source(IRC_S6664_A, relation = formalizes, coverage = partial, quote = "the amount shown as the tax by the taxpayer on his return")
rule W10ATaxShownOnReturnFromAssessment strict {
    label en official "sections 6651(a), 6664(a)(1)(A): the amount shown as the tax by the taxpayer on the return is the amount section 6211(a)(1)(A) reads for the same person, taxable year and tax kind";
    for r: Return;
    for p: Person;
    for y: TaxableYear;
    for kind: TaxKind;
    for shown: Money;
    when us.irc.core::return_of(r, p, y, kind)
        and us.irc.assessment::amount_shown_as_tax_by_taxpayer(p, y, kind, shown);
    then tax_shown_on_return(r, shown);
}
