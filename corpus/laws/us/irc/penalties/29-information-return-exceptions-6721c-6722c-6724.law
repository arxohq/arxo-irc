language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

use self::{
    IRC_S6721_C,
    IRC_S6722_C,
    IRC_S6724_E,
    IRC_S6724_F,
    IRC_S6724_G,
    InformationFailureDefectKind,
    InformationReturnFailure,
    PayeeStatementFailure,
    Person,
    TaxableYear,
    information_return_failure_corrected_on,
    information_return_failure_defect,
    information_return_failure_of,
    information_return_failure_within_safe_harbor,
    payee_statement_failure_corrected_on,
    payee_statement_failure_defect,
    payee_statement_failure_of,
    payee_statement_failure_within_safe_harbor,
};

// 26 U.S.C. §6721(c)(1)-(2), §6722(c)(1)-(2), §6724(e), (f), (g) (IRC-16 stage 2,
// DECISION-0379): exceptions and special rules of the information-return penalties
// that stage 2b left open. The exceptions feed the existing guard relations
// `information_return_failure_within_safe_harbor` / `payee_statement_failure_within_safe_harbor`
// that every module 11 penalty rule already reads through `not_known(...)`.
//
// JUDGMENT CALLS AND GAPS:
//  - §6721(c)(2)/§6722(c)(2): the exception covers at most the greater of 10 or one-half of
//    1 percent of the person's returns (statements). Which failures are excused when more
//    qualify than the limit is left open by the text: the model excuses ALL qualifying
//    failures when their number is within the limit and NONE otherwise; the choice is
//    TECH-GAPS G3115 (a `interpretation` question, not a language limit). The candidate
//    count and the total number of returns are case facts (an aggregate over derived
//    failures would be a §111 runtime-subset limit).
//  - "August 1 of the calendar year in which the required filing date occurs" needs a
//    date-part term the language lacks (TECH-GAPS G9-class): the date is a case fact.
//  - §6724(c) (magnetic media): the applicable number comes from §6011(e)(5)
//    (owner: returns); it stays a case fact (`magnetic_media_failure_within_exception`)
//    and the row is TECH-GAPS G3116.

// --- §6721(c)(1), (c)(2): de minimis failure to include all required information -------------------
relation information_return_filed_with_secretary(f: InformationReturnFailure) kind empirical {
    label en official "an information return is filed with the Secretary";
}
relation august_1_of_calendar_year_of_required_filing_date(f: InformationReturnFailure, d: Date) kind empirical {
    label en unofficial "August 1 of the calendar year in which the required filing date occurs (case fact: no date-part term)";
}
pub relation information_return_failure_qualifies_for_de_minimis_6721c1(f: InformationReturnFailure) kind institutional {
    label en unofficial "the failure is one described in subsection (a)(2)(B) corrected on or before August 1 of the year of the required filing date, on a return that was filed";
}
@source(IRC_S6721_C, relation = formalizes, coverage = exact, quote = "such failure is corrected on or before August 1 of the calendar year in which the required filing date occurs")
rule S6721c1Qualifies strict {
    for f: InformationReturnFailure;
    for d: Date;
    for a: Date;
    when information_return_filed_with_secretary(f)
        and information_return_failure_defect(f, IncorrectOrMissingInformation)
        and information_return_failure_corrected_on(f, d)
        and august_1_of_calendar_year_of_required_filing_date(f, a)
        and d <= a;
    then information_return_failure_qualifies_for_de_minimis_6721c1(f);
}
relation de_minimis_candidate_returns_count(payer: Person, y: TaxableYear, n: Integer) kind empirical {
    label en unofficial "the number of information returns to which paragraph (1) would apply for the calendar year (case fact)";
}
relation total_information_returns_required_count(payer: Person, y: TaxableYear, n: Integer) kind empirical {
    label en official "the total number of information returns required to be filed by the person during the calendar year (case fact)";
}
pub relation de_minimis_count_within_6721c2_limit(payer: Person, y: TaxableYear) kind institutional {
    label en unofficial "the number of returns to which paragraph (1) applies does not exceed the greater of 10 or one-half of 1 percent of the total number of returns required to be filed";
}
@source(IRC_S6721_C, relation = formalizes, coverage = exact, quote = "The number of information returns to which paragraph (1) applies for any calendar year shall not exceed the greater of—")
rule S6721c2LimitTen strict {
    for payer: Person;
    for y: TaxableYear;
    for k: Integer;
    when de_minimis_candidate_returns_count(payer, y, k)
        and k <= 10;
    then de_minimis_count_within_6721c2_limit(payer, y);
}
@source(IRC_S6721_C, relation = formalizes, coverage = exact, quote = "one-half of 1 percent of the total number of information returns required to be filed by the person during the calendar year")
rule S6721c2LimitHalfPercent strict {
    for payer: Person;
    for y: TaxableYear;
    for k: Integer;
    for t: Integer;
    when de_minimis_candidate_returns_count(payer, y, k)
        and total_information_returns_required_count(payer, y, t)
        and k * 200 <= t;
    then de_minimis_count_within_6721c2_limit(payer, y);
}
@source(IRC_S6721_C, relation = formalizes, coverage = exact, quote = "for purposes of this section, such return shall be treated as having been filed with all of the correct required information")
rule S6721c1TreatedAsCorrect strict {
    for f: InformationReturnFailure;
    for payer: Person;
    for y: TaxableYear;
    for k: us.irc.information_reporting::InformationReturnKind;
    when information_return_failure_qualifies_for_de_minimis_6721c1(f)
        and information_return_failure_of(f, payer, y, k)
        and de_minimis_count_within_6721c2_limit(payer, y);
    then information_return_failure_within_safe_harbor(f);
}

// --- §6722(c)(1), (c)(2): de minimis failure on payee statements ----------------------------------------
relation payee_statement_furnished_to_person(f: PayeeStatementFailure) kind empirical {
    label en official "a payee statement is furnished to the person to whom it is required to be furnished";
}
relation august_1_of_calendar_year_of_prescribed_furnishing_date(f: PayeeStatementFailure, d: Date) kind empirical {
    label en unofficial "August 1 of the calendar year in which the date prescribed for furnishing occurs (case fact)";
}
pub relation payee_statement_failure_qualifies_for_de_minimis_6722c1(f: PayeeStatementFailure) kind institutional {
    label en unofficial "the failure is one described in subsection (a)(2)(B) corrected on or before August 1 of the year of the prescribed date, on a statement that was furnished";
}
@source(IRC_S6722_C, relation = formalizes, coverage = exact, quote = "such failure is corrected on or before August 1 of the calendar year in which the date prescribed for furnishing such statement occurs")
rule S6722c1Qualifies strict {
    for f: PayeeStatementFailure;
    for d: Date;
    for a: Date;
    when payee_statement_furnished_to_person(f)
        and payee_statement_failure_defect(f, IncorrectOrMissingInformation)
        and payee_statement_failure_corrected_on(f, d)
        and august_1_of_calendar_year_of_prescribed_furnishing_date(f, a)
        and d <= a;
    then payee_statement_failure_qualifies_for_de_minimis_6722c1(f);
}
relation de_minimis_candidate_statements_count(payer: Person, y: TaxableYear, n: Integer) kind empirical {
    label en unofficial "the number of payee statements to which paragraph (1) would apply for the calendar year (case fact)";
}
relation total_payee_statements_required_count(payer: Person, y: TaxableYear, n: Integer) kind empirical {
    label en official "the total number of payee statements required to be furnished by the person during the calendar year (case fact)";
}
pub relation de_minimis_statement_count_within_6722c2_limit(payer: Person, y: TaxableYear) kind institutional {
    label en unofficial "the number of statements to which paragraph (1) applies does not exceed the greater of 10 or one-half of 1 percent of the total number of payee statements";
}
@source(IRC_S6722_C, relation = formalizes, coverage = exact, quote = "The number of payee statements to which paragraph (1) applies for any calendar year shall not exceed the greater of—")
rule S6722c2LimitTen strict {
    for payer: Person;
    for y: TaxableYear;
    for k: Integer;
    when de_minimis_candidate_statements_count(payer, y, k)
        and k <= 10;
    then de_minimis_statement_count_within_6722c2_limit(payer, y);
}
@source(IRC_S6722_C, relation = formalizes, coverage = exact, quote = "one-half of 1 percent of the total number of payee statements required to be furnished by the person during the calendar year")
rule S6722c2LimitHalfPercent strict {
    for payer: Person;
    for y: TaxableYear;
    for k: Integer;
    for t: Integer;
    when de_minimis_candidate_statements_count(payer, y, k)
        and total_payee_statements_required_count(payer, y, t)
        and k * 200 <= t;
    then de_minimis_statement_count_within_6722c2_limit(payer, y);
}
@source(IRC_S6722_C, relation = formalizes, coverage = exact, quote = "for purposes of this section, such statement shall be treated as having been furnished with all of the correct required information")
rule S6722c1TreatedAsCorrect strict {
    for f: PayeeStatementFailure;
    for payer: Person;
    for y: TaxableYear;
    for k: us.irc.information_reporting::InformationReturnKind;
    when payee_statement_failure_qualifies_for_de_minimis_6722c1(f)
        and payee_statement_failure_of(f, payer, y, k)
        and de_minimis_statement_count_within_6722c2_limit(payer, y);
    then payee_statement_failure_within_safe_harbor(f);
}

// --- §6724(e), (f), (g): special rules ------------------------------------------------------------------
pub entity PartnershipSchedule {
    label en unofficial "a schedule with respect to a partner included in a section 6031(a) partnership return";
}
relation partnership_return_required_on_magnetic_media_under_6011e(s: PartnershipSchedule) kind empirical {
    label en official "a partnership return under section 6031(a) is required under section 6011(e) to be filed on magnetic media or in other machine-readable form";
}
relation schedule_required_with_return_for_partner(s: PartnershipSchedule) kind empirical {
    label en official "the schedule is required to be included with such return with respect to a partner";
}
pub relation schedule_treated_as_separate_information_return(s: PartnershipSchedule) kind institutional {
    label en unofficial "each schedule required to be included with the return with respect to each partner is treated as a separate information return for purposes of this part";
}
@source(IRC_S6724_E, relation = formalizes, coverage = exact, quote = "each schedule required to be included with such return with respect to each partner shall be treated as a separate information return")
rule S6724eSeparateInformationReturn strict {
    for s: PartnershipSchedule;
    when partnership_return_required_on_magnetic_media_under_6011e(s)
        and schedule_required_with_return_for_partner(s);
    then schedule_treated_as_separate_information_return(s);
}
relation failure_solely_by_reason_of_missing_tin_on_6050S_return(f: InformationReturnFailure) kind empirical {
    label en official "the failure is solely a failure to provide the TIN of an individual on a return or statement required by section 6050S(a)(1)";
}
relation educational_institution_certified_tin_standards(f: InformationReturnFailure) kind empirical {
    label en official "the eligible educational institution contemporaneously makes a true and accurate certification under penalty of perjury that it has complied with the Secretary's standards for obtaining the individual's TIN";
}
@source(IRC_S6724_F, relation = formalizes, coverage = exact, quote = "No penalty shall be imposed under section 6721 or 6722 solely by reason of failing to provide the TIN of an individual on a return or statement required by section 6050S(a)(1) if the eligible educational institution required to make such return contemporaneously makes a true and accurate certification under penalty of perjury")
rule S6724fEducationalInstitutionReturn strict {
    for f: InformationReturnFailure;
    when failure_solely_by_reason_of_missing_tin_on_6050S_return(f)
        and educational_institution_certified_tin_standards(f);
    then information_return_failure_within_safe_harbor(f);
}
relation payee_statement_failure_solely_by_reason_of_missing_tin_on_6050S(f: PayeeStatementFailure) kind empirical {
    label en official "the payee statement failure is solely a failure to provide the TIN of an individual on a statement required by section 6050S(a)(1)";
}
relation payee_statement_educational_institution_certified_tin_standards(f: PayeeStatementFailure) kind empirical {
    label en official "the eligible educational institution contemporaneously makes the true and accurate TIN certification";
}
@source(IRC_S6724_F, relation = formalizes, coverage = exact, quote = "No penalty shall be imposed under section 6721 or 6722 solely by reason of failing to provide the TIN of an individual on a return or statement required by section 6050S(a)(1) if the eligible educational institution required to make such return contemporaneously makes a true and accurate certification under penalty of perjury")
rule S6724fEducationalInstitutionStatement strict {
    for f: PayeeStatementFailure;
    when payee_statement_failure_solely_by_reason_of_missing_tin_on_6050S(f)
        and payee_statement_educational_institution_certified_tin_standards(f);
    then payee_statement_failure_within_safe_harbor(f);
}
relation return_or_report_under_6047d_or_408i_for_distribution(f: InformationReturnFailure) kind empirical {
    label en official "a person makes a return or report under section 6047(d) or 408(i) with respect to any distribution";
}
relation distribution_follows_rollover_transfer_or_exchange_72t4C_or_72q3C(f: InformationReturnFailure) kind empirical {
    label en official "the distribution is made following a rollover, transfer, or exchange described in section 72(t)(4)(C) or 72(q)(3)(C)";
}
relation person_relied_on_taxpayer_certification_of_distribution_requirements(f: InformationReturnFailure) kind empirical {
    label en official "in making the return or report the person relies upon a certification provided by the taxpayer that the distributions satisfy the requirements of section 72(t)(4)(C)(iii) or 72(q)(3)(B)(iii)";
}
relation person_has_actual_knowledge_distributions_do_not_satisfy_requirements(f: InformationReturnFailure) kind empirical {
    label en official "the person has actual knowledge that the distributions do not satisfy such requirements";
}
@source(IRC_S6724_G, relation = formalizes, coverage = exact, quote = "No penalty shall be imposed under section 6721 or 6722 if—")
rule S6724gRolloverCertificationReturn strict {
    for f: InformationReturnFailure;
    when return_or_report_under_6047d_or_408i_for_distribution(f)
        and distribution_follows_rollover_transfer_or_exchange_72t4C_or_72q3C(f)
        and person_relied_on_taxpayer_certification_of_distribution_requirements(f)
        and not_known(person_has_actual_knowledge_distributions_do_not_satisfy_requirements(f));
    then information_return_failure_within_safe_harbor(f);
}
relation payee_statement_return_or_report_under_6047d_or_408i(f: PayeeStatementFailure) kind empirical {
    label en official "a person makes a return or report under section 6047(d) or 408(i) with respect to the distribution (payee statement)";
}
relation payee_statement_distribution_follows_rollover(f: PayeeStatementFailure) kind empirical {
    label en official "the distribution follows a rollover, transfer, or exchange described in section 72(t)(4)(C) or 72(q)(3)(C)";
}
relation payee_statement_person_relied_on_certification(f: PayeeStatementFailure) kind empirical {
    label en official "the person relies upon the taxpayer's certification that the distributions satisfy the requirements";
}
relation payee_statement_person_has_actual_knowledge_of_ineligibility(f: PayeeStatementFailure) kind empirical {
    label en official "the person has actual knowledge that the distributions do not satisfy such requirements";
}
@source(IRC_S6724_G, relation = formalizes, coverage = exact, quote = "No penalty shall be imposed under section 6721 or 6722 if—")
rule S6724gRolloverCertificationStatement strict {
    for f: PayeeStatementFailure;
    when payee_statement_return_or_report_under_6047d_or_408i(f)
        and payee_statement_distribution_follows_rollover(f)
        and payee_statement_person_relied_on_certification(f)
        and not_known(payee_statement_person_has_actual_knowledge_of_ineligibility(f));
    then payee_statement_failure_within_safe_harbor(f);
}
