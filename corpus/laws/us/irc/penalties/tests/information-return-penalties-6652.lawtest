        assert "f1": failed_to_file_small_payment_statement(entity_ref("urn:us:irc:penalties:clir#F1")) { origin case_input; }
        assert "f2": failure_count(entity_ref("urn:us:irc:penalties:clir#F1"), 40) { origin case_input; }
        assert "f3": not reasonable_cause_and_no_willful_neglect(entity_ref("urn:us:irc:penalties:clir#P1"), entity_ref("urn:us:irc:penalties:clir#F1")) { origin adjudicated; }
    }
    evaluate truth(penalty_6652a(entity_ref("urn:us:irc:penalties:clir#F1"), 40.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

