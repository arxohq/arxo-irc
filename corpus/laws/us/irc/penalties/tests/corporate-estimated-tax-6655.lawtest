// (d)(2)(B): large-corp 1st-installment election with 2nd-installment recapture

test "S6655D2B-01-RECAPTURE-ADDED-TO-SECOND-INSTALLMENT" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": us.irc.core::liability(entity_ref("urn:us:irc:penalties:clir#C4"), entity_ref("urn:us:irc:penalties:clir#Y2026"), us.irc.core::IncomeCh1, 100000.00 USD) { origin case_input; }
        assert "f1": is_large_corporation(entity_ref("urn:us:irc:penalties:clir#C4"), entity_ref("urn:us:irc:penalties:clir#Y2026")) { origin case_input; }
        assert "f2": large_corp_first_installment_uses_preceding_year(entity_ref("urn:us:irc:penalties:clir#C4"), entity_ref("urn:us:irc:penalties:clir#Y2026")) { origin case_input; }
        assert "f3": preceding_year_tax_shown_corp(entity_ref("urn:us:irc:penalties:clir#C4"), entity_ref("urn:us:irc:penalties:clir#Y2026"), 40000.00 USD) { origin case_input; }
    }
    evaluate truth(required_installment_before_annualization_corp(entity_ref("urn:us:irc:penalties:clir#C4"), entity_ref("urn:us:irc:penalties:clir#Y2026"), First, 10000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S6655D2B-02-SECOND-INSTALLMENT-INCLUDES-RECAPTURE" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": us.irc.core::liability(entity_ref("urn:us:irc:penalties:clir#C5"), entity_ref("urn:us:irc:penalties:clir#Y2026"), us.irc.core::IncomeCh1, 100000.00 USD) { origin case_input; }
        assert "f1": is_large_corporation(entity_ref("urn:us:irc:penalties:clir#C5"), entity_ref("urn:us:irc:penalties:clir#Y2026")) { origin case_input; }
        assert "f2": large_corp_first_installment_uses_preceding_year(entity_ref("urn:us:irc:penalties:clir#C5"), entity_ref("urn:us:irc:penalties:clir#Y2026")) { origin case_input; }
        assert "f3": preceding_year_tax_shown_corp(entity_ref("urn:us:irc:penalties:clir#C5"), entity_ref("urn:us:irc:penalties:clir#Y2026"), 40000.00 USD) { origin case_input; }
    }
    // ordinary 1st = 25000, actual 1st = 10000, reduction = 15000;
    // 2nd = 25000 (ordinary) + 15000 (recapture) = 40000
    evaluate truth(required_installment_before_annualization_corp(entity_ref("urn:us:irc:penalties:clir#C5"), entity_ref("urn:us:irc:penalties:clir#Y2026"), Second, 40000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// (e): annualized income installment lower than the (d) installment

test "S6655E-01-ANNUALIZED-INSTALLMENT-LOWER-APPLIES" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": us.irc.core::liability(entity_ref("urn:us:irc:penalties:clir#C6"), entity_ref("urn:us:irc:penalties:clir#Y2026"), us.irc.core::IncomeCh1, 100000.00 USD) { origin case_input; }
        assert "f1": preceding_year_was_12_months_corp(entity_ref("urn:us:irc:penalties:clir#C6"), entity_ref("urn:us:irc:penalties:clir#Y2026")) { origin case_input; }
        assert "f2": annualized_tax_for_installment(entity_ref("urn:us:irc:penalties:clir#C6"), entity_ref("urn:us:irc:penalties:clir#Y2026"), First, 40000.00 USD) { origin case_input; }
    }
    // (d) 1st installment = 25% * 100000 = 25000; (e) 1st annualized = 25% * 40000 = 10000 (lower)
    evaluate truth(required_installment_corp(entity_ref("urn:us:irc:penalties:clir#C6"), entity_ref("urn:us:irc:penalties:clir#Y2026"), First, 10000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S6655E-02-SECOND-ANNUALIZED-INSTALLMENT-SUBTRACTS-PRIOR" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": annualized_tax_for_installment(entity_ref("urn:us:irc:penalties:clir#C7"), entity_ref("urn:us:irc:penalties:clir#Y2026"), First, 40000.00 USD) { origin case_input; }
        assert "f1": annualized_tax_for_installment(entity_ref("urn:us:irc:penalties:clir#C7"), entity_ref("urn:us:irc:penalties:clir#Y2026"), Second, 80000.00 USD) { origin case_input; }
    }
    // 1st annualized = 25% * 40000 = 10000
    // 2nd annualized = 50% * 80000 - 10000 = 40000 - 10000 = 30000
    evaluate truth(annualized_income_installment(entity_ref("urn:us:irc:penalties:clir#C7"), entity_ref("urn:us:irc:penalties:clir#Y2026"), Second, 30000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

