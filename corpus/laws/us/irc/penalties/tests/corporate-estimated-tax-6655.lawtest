test "S6655F-02-ADDITION-ZERO-WHEN-SMALL-AMOUNT" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": us.irc.core::liability(entity_ref("urn:us:irc:penalties:clir#C10"), entity_ref("urn:us:irc:penalties:clir#Y2026"), us.irc.core::IncomeCh1, 400.00 USD) { origin case_input; }
        assert "f1": corporate_estimated_tax_underpayment(entity_ref("urn:us:irc:penalties:clir#C10"), entity_ref("urn:us:irc:penalties:clir#Y2026"), First, 100.00 USD) { origin case_input; }
        assert "f2": required_installment_due_date_corp(entity_ref("urn:us:irc:penalties:clir#Y2026"), First, @2026-04-15) { origin case_input; }
        assert "f3": underpayment_cured_on_corp(entity_ref("urn:us:irc:penalties:clir#C10"), entity_ref("urn:us:irc:penalties:clir#Y2026"), First, @2026-06-15) { origin case_input; }
        assert "f4": underpayment_rate_under_6621(@2026-04-15, 0.08) { origin case_input; }
    }
    evaluate truth(corporate_estimated_tax_addition(entity_ref("urn:us:irc:penalties:clir#C10"), entity_ref("urn:us:irc:penalties:clir#Y2026"), First, 0.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

