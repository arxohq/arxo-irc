language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

// (d)(1): required annual payment, ordinary corporation with a qualifying prior year

test "S6655D-01-LESSER-OF-CURRENT-OR-PRECEDING" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": us.irc.core::liability(entity_ref("urn:us:irc:penalties:clir#C1"), entity_ref("urn:us:irc:penalties:clir#Y2026"), us.irc.core::IncomeCh1, 100000.00 USD) { origin case_input; }
        assert "f1": preceding_year_tax_shown_corp(entity_ref("urn:us:irc:penalties:clir#C1"), entity_ref("urn:us:irc:penalties:clir#Y2026"), 80000.00 USD) { origin case_input; }
    }
    evaluate truth(required_annual_payment_corp(entity_ref("urn:us:irc:penalties:clir#C1"), entity_ref("urn:us:irc:penalties:clir#Y2026"), 80000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

