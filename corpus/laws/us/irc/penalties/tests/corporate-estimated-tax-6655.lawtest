        assert "f1": preceding_year_tax_shown_corp(entity_ref("urn:us:irc:penalties:clir#C2"), entity_ref("urn:us:irc:penalties:clir#Y2026"), 5000.00 USD) { origin case_input; }
        assert "f2": is_large_corporation(entity_ref("urn:us:irc:penalties:clir#C2"), entity_ref("urn:us:irc:penalties:clir#Y2026")) { origin case_input; }
