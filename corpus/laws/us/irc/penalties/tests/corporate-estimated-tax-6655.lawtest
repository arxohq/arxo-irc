    evaluate truth(required_annual_payment_corp(entity_ref("urn:us:irc:penalties:clir#C2"), entity_ref("urn:us:irc:penalties:clir#Y2026"), 100000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

