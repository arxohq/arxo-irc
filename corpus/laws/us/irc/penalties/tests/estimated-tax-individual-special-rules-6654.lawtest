// Section 6654 individual special rules: due dates, (b)(3) crediting, (d)(2) annualization, (f) tax, (i) farmers, (j) nonresident aliens, (k) fiscal years, (m) (stage 3).
// NOT EXECUTED in this assignment (status implemented_unverified). Expectations are
// computed by hand from the pinned statutory text, not from any engine output.
// Index values (C-CPI-U, CPI) in scenarios are SYNTHETIC round numbers chosen for hand
// arithmetic; they are not Bureau of Labor Statistics data.

language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

test "S6654C-01-FIRST-INSTALLMENT-DUE-APRIL-15-OF-A-CALENDAR-YEAR" {
    given {
        context {
            legal_time @2026-12-31;
            decision_time @2026-12-31T09:00:00-05:00;
            knowledge_time @2026-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.core::year_of(entity_ref("urn:test:s31#p"), entity_ref("urn:test:s31#y")) { origin case_input; }
        assert "f1": us.irc.core::begins(entity_ref("urn:test:s31#y"), @2026-01-01) { origin case_input; }
    }
    // table T1: 1st April 15
    evaluate truth(required_installment_due_date(entity_ref("urn:test:s31#y"), First, @2026-04-15));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

