        assert "f2": us.irc.core::liability(entity_ref("urn:test:s31#p"), entity_ref("urn:test:s31#y"), us.irc.core::SelfEmploymentCh2, 1500 USD) { origin case_input; }
        assert "f3": us.irc.core::liability(entity_ref("urn:test:s31#p"), entity_ref("urn:test:s31#y"), us.irc.core::NiitCh2A, 200 USD) { origin case_input; }
