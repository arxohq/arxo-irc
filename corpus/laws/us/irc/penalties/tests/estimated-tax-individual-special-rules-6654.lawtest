test "S6654B3-01-PAYMENT-ON-THE-SECOND-DUE-DATE-CREDITED-FIRST-TO-THE-FIRST-INSTALLMENT" {
    given {
        context {
            legal_time @2026-12-31;
            decision_time @2026-12-31T09:00:00-05:00;
            knowledge_time @2026-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.core::year_of(entity_ref("urn:test:s31#p"), entity_ref("urn:test:s31#y")) { origin case_input; }
        assert "f1": us.irc.core::begins(entity_ref("urn:test:s31#y"), @2026-01-01) { origin case_input; }
        assert "f2": required_installment_amount(entity_ref("urn:test:s31#p"), entity_ref("urn:test:s31#y"), First, 2500 USD) { origin case_input; }
        assert "f3": required_installment_amount(entity_ref("urn:test:s31#p"), entity_ref("urn:test:s31#y"), Second, 2500 USD) { origin case_input; }
