language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

// Scenarios for 26 U.S.C. §§6677-6692, module 18. NOT executed (owner restriction). implemented_unverified.

test "S6677-01-EVENT-NOTICE-GREATER-OF-10000-OR-35-PERCENT-PERCENT-BRANCH" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": failure_by(entity_ref("urn:us:irc:penalties:clir#F1"), entity_ref("urn:us:irc:penalties:clir#P1")) { origin case_input; }
        assert "f1": section_6048_notice_not_filed_or_incomplete(entity_ref("urn:us:irc:penalties:clir#F1")) { origin case_input; }
        assert "f2": failure_relates_to_section_6048(entity_ref("urn:us:irc:penalties:clir#F1"), EventNotice6048a) { origin case_input; }
        assert "f3": gross_value_of_property_at_event(entity_ref("urn:us:irc:penalties:clir#F1"), 200000.00 USD) { origin case_input; }
        assert "f4": not cause_asserted_is_foreign_jurisdiction_penalty(entity_ref("urn:us:irc:penalties:clir#F1")) { origin adjudicated; }
        assert "f5": not reasonable_cause_and_no_willful_neglect(entity_ref("urn:us:irc:penalties:clir#P1"), entity_ref("urn:us:irc:penalties:clir#F1")) { origin adjudicated; }
    }
    evaluate truth(foreign_trust_notice_penalty_initial(entity_ref("urn:us:irc:penalties:clir#F1"), 70000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

