// Section 6655 special rules: due dates, crediting order, lower installments, annualization months, seasonal, subpart F, REIT, (g)(3), (g)(4), (i) (stage 3).
// NOT EXECUTED in this assignment (status implemented_unverified). Expectations are
// computed by hand from the pinned statutory text, not from any engine output.
// Index values (C-CPI-U, CPI) in scenarios are SYNTHETIC round numbers chosen for hand
// arithmetic; they are not Bureau of Labor Statistics data.

language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

test "S6655C-01-FIRST-INSTALLMENT-DUE-APRIL-15" {
    given {
        context {
            legal_time @2026-12-31;
            decision_time @2026-12-31T09:00:00-05:00;
            knowledge_time @2026-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.core::year_of(entity_ref("urn:test:s32#corp"), entity_ref("urn:test:s32#y")) { origin case_input; }
        assert "f1": us.irc.core::begins(entity_ref("urn:test:s32#y"), @2026-01-01) { origin case_input; }
    }
    // table T1
    evaluate truth(required_installment_due_date_corp(entity_ref("urn:test:s32#y"), First, @2026-04-15));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

