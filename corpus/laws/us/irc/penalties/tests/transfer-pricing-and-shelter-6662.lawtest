// Section 6662(e)(1)(B), (e)(3), (h)(2)(A)(ii)-(iii), (d)(2)(C): transfer pricing and the shelter carve-out (stage 3).
// NOT EXECUTED in this assignment (status implemented_unverified). Expectations are
// computed by hand from the pinned statutory text, not from any engine output.
// Index values (C-CPI-U, CPI) in scenarios are SYNTHETIC round numbers chosen for hand
// arithmetic; they are not Bureau of Labor Statistics data.

language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

test "S6662E1B-01-PRICE-200-PERCENT-IS-SUBSTANTIAL" {
    given {
        context {
            legal_time @2026-12-31;
            decision_time @2026-12-31T09:00:00-05:00;
            knowledge_time @2026-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": price_claimed_on_return(entity_ref("urn:test:s33#t1"), 2000 USD) { origin case_input; }
        assert "f1": correct_price_under_482(entity_ref("urn:test:s33#t1"), 1000 USD) { origin case_input; }
    }
    evaluate truth(transfer_price_substantial_misstatement(entity_ref("urn:test:s33#t1")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

