    }
    // the significant purpose is a judgment of the Tax Court: unanswered
    evaluate truth(tax_shelter(entity_ref("urn:test:s33#shelter")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

test "S6662D2Cii-03-ITEM-ATTRIBUTABLE-TO-A-TAX-SHELTER" {
    given {
        context {
            legal_time @2026-12-31;
            decision_time @2026-12-31T09:00:00-05:00;
            knowledge_time @2026-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": item_attributable_to_arrangement(entity_ref("urn:test:s33#item2"), entity_ref("urn:test:s33#shelter")) { origin case_input; }
        assert "f1": arrangement_is_partnership_entity_plan_or_arrangement(entity_ref("urn:test:s33#shelter")) { origin case_input; }
        assert "f2": significant_purpose_is_tax_avoidance_or_evasion(entity_ref("urn:test:s33#shelter")) { origin adjudicated; }
    }
    evaluate truth(item_attributable_to_tax_shelter(entity_ref("urn:test:s33#item2")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S6662D2C-04-ITEM-OF-AN-ORDINARY-ARRANGEMENT-KEEPS-THE-REDUCTION" {
    given {
        context {
            legal_time @2026-12-31;
            decision_time @2026-12-31T09:00:00-05:00;
            knowledge_time @2026-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": reduction_item_of(entity_ref("urn:test:s33#item1"), entity_ref("urn:test:s33#p"), entity_ref("urn:test:s33#y"), us.irc.core::IncomeCh1) { origin case_input; }
        assert "f1": reduction_item_amount(entity_ref("urn:test:s33#item1"), 10000 USD) { origin case_input; }
        assert "f2": reduction_item_of(entity_ref("urn:test:s33#item2"), entity_ref("urn:test:s33#p"), entity_ref("urn:test:s33#y"), us.irc.core::IncomeCh1) { origin case_input; }
        assert "f3": reduction_item_amount(entity_ref("urn:test:s33#item2"), 5000 USD) { origin case_input; }
        assert "f4": item_attributable_to_arrangement(entity_ref("urn:test:s33#item2"), entity_ref("urn:test:s33#shelter")) { origin case_input; }
        assert "f5": arrangement_is_partnership_entity_plan_or_arrangement(entity_ref("urn:test:s33#shelter")) { origin case_input; }
    }
    // no finding that a significant purpose is tax avoidance: the shelter status is not established, the item keeps the reduction
    evaluate truth(understatement_reduction_amount(entity_ref("urn:test:s33#p"), entity_ref("urn:test:s33#y"), us.irc.core::IncomeCh1, 15000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

