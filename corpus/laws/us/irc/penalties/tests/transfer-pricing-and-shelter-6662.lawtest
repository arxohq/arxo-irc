test "S6662E3A-01-NET-ADJUSTMENT-IS-THE-SUM" {
    given {
        context {
            legal_time @2026-12-31;
            decision_time @2026-12-31T09:00:00-05:00;
            knowledge_time @2026-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": transfer_price_of(entity_ref("urn:test:s33#t1"), entity_ref("urn:test:s33#p"), entity_ref("urn:test:s33#y")) { origin case_input; }
        assert "f1": transfer_price_adjustment_482(entity_ref("urn:test:s33#t1"), 4000000 USD) { origin case_input; }
        assert "f2": transfer_price_of(entity_ref("urn:test:s33#t2"), entity_ref("urn:test:s33#p"), entity_ref("urn:test:s33#y")) { origin case_input; }
        assert "f3": transfer_price_adjustment_482(entity_ref("urn:test:s33#t2"), 3000000 USD) { origin case_input; }
    }
    // 4000000 + 3000000
    evaluate truth(net_482_transfer_price_adjustment(entity_ref("urn:test:s33#p"), entity_ref("urn:test:s33#y"), 7000000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S6662E3A-02-NET-ADJUSTMENT-NETS-DECREASES" {
    given {
        context {
            legal_time @2026-12-31;
            decision_time @2026-12-31T09:00:00-05:00;
            knowledge_time @2026-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": transfer_price_of(entity_ref("urn:test:s33#t1"), entity_ref("urn:test:s33#p"), entity_ref("urn:test:s33#y")) { origin case_input; }
        assert "f1": transfer_price_adjustment_482(entity_ref("urn:test:s33#t1"), 3000000 USD) { origin case_input; }
        assert "f2": transfer_price_of(entity_ref("urn:test:s33#t2"), entity_ref("urn:test:s33#p"), entity_ref("urn:test:s33#y")) { origin case_input; }
        assert "f3": transfer_price_adjustment_482(entity_ref("urn:test:s33#t2"), -1000000 USD) { origin case_input; }
    }
    // the NET increase in taxable income
    evaluate truth(net_482_transfer_price_adjustment(entity_ref("urn:test:s33#p"), entity_ref("urn:test:s33#y"), 2000000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

