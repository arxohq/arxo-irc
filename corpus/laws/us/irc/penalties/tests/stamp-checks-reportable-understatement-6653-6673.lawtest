test "S6653-01-WILLFUL-NONPAYMENT-STAMP-TAX-HALF-OF-UNDERPAYMENT" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": failure_by(entity_ref("urn:us:irc:penalties:clir#F1"), entity_ref("urn:us:irc:penalties:clir#P1")) { origin case_input; }
        assert "f1": willfully_fails_to_pay_stamp_tax(entity_ref("urn:us:irc:penalties:clir#F1")) { origin case_input; }
        assert "f2": stamp_tax_underpayment_amount(entity_ref("urn:us:irc:penalties:clir#F1"), 2000.00 USD) { origin case_input; }
    }
    evaluate truth(stamp_tax_penalty_6653(entity_ref("urn:us:irc:penalties:clir#F1"), 1000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

