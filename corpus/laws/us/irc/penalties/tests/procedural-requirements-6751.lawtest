language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

test "S6751-01-NOTICE-CONTENT-DUTY-PERFORMED" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": notice_is_of_a_penalty(entity_ref("urn:us:irc:penalties:clir#N1")) { origin case_input; }
        assert "f1": notice_states_required_penalty_information(entity_ref("urn:us:irc:penalties:clir#N1")) { origin case_input; }
    }
    evaluate positions();
    expect not position(PenaltyNoticeContentDuty, VIOLATED);
}

test "S6751-02-ACCURACY-PENALTY-EXEMPT-CARVEIN-NO-APPROVAL-NEEDED" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": penalty_kind_of(entity_ref("urn:us:irc:penalties:clir#PD3"), AccuracyRelatedEconomicSubstanceOrForeignAsset) { origin case_input; }
        assert "f1": secretary_moves_to_assess(entity_ref("urn:us:irc:penalties:clir#PD3")) { origin case_input; }
    }
    evaluate truth(penalty_determination_validly_assessable(entity_ref("urn:us:irc:penalties:clir#PD3")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
