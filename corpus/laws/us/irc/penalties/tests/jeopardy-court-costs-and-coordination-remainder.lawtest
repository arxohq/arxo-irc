test "S6861F-01-STAYED-PORTION-COLLECTIBLE-UP-TO-WHAT-REMAINS-OF-THE-DETERMINED-AMOUNT" {
    given {
        context {
            legal_time @2026-12-31;
            decision_time @2026-12-31T09:00:00-05:00;
            knowledge_time @2026-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": jeopardy_assessment_of(entity_ref("urn:test:s34#assess"), entity_ref("urn:test:s34#taxpayer"), Deficiency6861) { origin case_input; }
        assert "f1": tax_court_petition_filed_for(entity_ref("urn:test:s34#assess")) { origin case_input; }
        assert "f2": tax_court_decision_final_on(entity_ref("urn:test:s34#assess"), @2026-09-01) { origin case_input; }
        assert "f3": amount_which_should_have_been_assessed(entity_ref("urn:test:s34#assess"), 40000 USD) { origin case_input; }
        assert "f4": jeopardy_assessment_amount(entity_ref("urn:test:s34#assess"), 55000 USD) { origin case_input; }
        assert "f5": unpaid_portion_stayed_by_bond(entity_ref("urn:test:s34#assess"), 20000 USD) { origin case_input; }
        assert "f6": amount_already_collected_on_assessment(entity_ref("urn:test:s34#assess"), 30000 USD) { origin case_input; }
    }
    // min(20000, 40000 - 30000)
