// Sections 6861(c)-(g), 6852(b)(2), 6673(a)(2), 6664(a) rebate, 6677 continuation, 6701(f) and 6707A(e) wiring, 6662A(e)(1) (stage 3).
// NOT EXECUTED in this assignment (status implemented_unverified). Expectations are
// computed by hand from the pinned statutory text, not from any engine output.
// Index values (C-CPI-U, CPI) in scenarios are SYNTHETIC round numbers chosen for hand
// arithmetic; they are not Bureau of Labor Statistics data.

language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

test "S6861C-01-ASSESSMENT-MAY-DIFFER-FROM-THE-NOTICE-BEFORE-THE-DECISION" {
    given {
        context {
            legal_time @2026-12-31;
            decision_time @2026-12-31T09:00:00-05:00;
            knowledge_time @2026-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": jeopardy_assessment_of(entity_ref("urn:test:s34#assess"), entity_ref("urn:test:s34#taxpayer"), Deficiency6861) { origin case_input; }
        assert "f1": jeopardy_assessment_made_on(entity_ref("urn:test:s34#assess"), @2026-03-01) { origin case_input; }
    }
    // section 6861(c), first sentence
    evaluate truth(jeopardy_assessment_may_differ_from_notice(entity_ref("urn:test:s34#assess")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

