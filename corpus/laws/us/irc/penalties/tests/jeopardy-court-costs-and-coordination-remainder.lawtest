test "S6707AE-03-DISCLOSURE-FAILURE-BEARS-THE-MINIMUM-PENALTY" {
    given {
        context {
            legal_time @2026-12-31;
            decision_time @2026-12-31T09:00:00-05:00;
            knowledge_time @2026-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": penalty_disclosure_required_6707Ae2(entity_ref("urn:test:s34#trustee")) { origin case_input; }
        assert "f1": failed_to_disclose_penalty_in_sec_reports(entity_ref("urn:test:s34#trustee")) { origin case_input; }
        assert "f2": sec_disclosure_failure_entity(entity_ref("urn:test:s34#trustee"), entity_ref("urn:test:s34#secfail")) { origin case_input; }
        assert "f3": decrease_in_tax_from_transaction(entity_ref("urn:test:s34#secfail"), 0 USD) { origin case_input; }
    }
    // 75 percent of a zero decrease is zero: the floor of (b)(3) applies
    evaluate truth(reportable_transaction_penalty_6707a(entity_ref("urn:test:s34#secfail"), 10000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

