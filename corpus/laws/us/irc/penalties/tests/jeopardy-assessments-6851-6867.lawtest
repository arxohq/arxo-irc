        assert "f1": jeopardy_assessment_of(entity_ref("urn:us:irc:penalties:clir#A7"), entity_ref("urn:us:irc:penalties:clir#P7"), Deficiency6861) { origin case_input; }
        assert "f2": secretary_moves_to_assess_jeopardy_deficiency(entity_ref("urn:us:irc:penalties:clir#A7")) { origin case_input; }
        assert "f3": jeopardy_assessment_made_on(entity_ref("urn:us:irc:penalties:clir#A7"), @2026-05-01) { origin case_input; }
        assert "f4": jeopardy_notice_mailed_on(entity_ref("urn:us:irc:penalties:clir#A7"), @2026-05-15) { origin case_input; }
    }
    evaluate truth(jeopardy_assessment_valid(entity_ref("urn:us:irc:penalties:clir#A7")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// §6863(a): bond stays collection

test "S6863A-01-BOND-STAYS-COLLECTION" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
