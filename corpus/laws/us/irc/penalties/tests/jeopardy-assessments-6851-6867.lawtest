        assert "f1": jeopardy_assessment_of(entity_ref("urn:us:irc:penalties:clir#A2"), entity_ref("urn:us:irc:penalties:clir#P2"), Termination6851) { origin case_input; }
        assert "f2": secretary_moves_to_terminate_assessment(entity_ref("urn:us:irc:penalties:clir#A2")) { origin case_input; }
    }
    evaluate truth(termination_assessment_authorized(entity_ref("urn:us:irc:penalties:clir#A2")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

