language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

test "S6851-01-TERMINATION-CONDITION-MET" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": taxpayer_designs_to_depart_or_conceal(entity_ref("urn:us:irc:penalties:clir#P1")) { origin case_input; }
    }
    evaluate truth(termination_assessment_condition_met(entity_ref("urn:us:irc:penalties:clir#P1")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S6851-02-TERMINATION-ASSESSMENT-AUTHORIZED-WHEN-VALID" {
    given {
