        assert "f1": jeopardy_assessment_stay_desired_amount(entity_ref("urn:us:irc:penalties:clir#A8"), 5000.00 USD) { origin case_input; }
        assert "f2": jeopardy_bond_filed(entity_ref("urn:us:irc:penalties:clir#A8"), 5000.00 USD) { origin case_input; }
        assert "f3": taxpayer_files_jeopardy_bond(entity_ref("urn:us:irc:penalties:clir#A8")) { origin case_input; }
    }
    evaluate truth(jeopardy_collection_stayed(entity_ref("urn:us:irc:penalties:clir#A8")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

