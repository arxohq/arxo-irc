// Final TECH_GAP pass (26.09.2026): section 6708(a)(1) (G6888). NOT EXECUTED (implemented_unverified).
// The test family carries the business-day calendar snapshot derived from 5 U.S.C. 6103 (`us.code.clir.federal_calendar`, 2026).

language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

test "S6708A1-01-TWENTIETH-BUSINESS-DAY-SKIPS-THE-JULY-3-HOLIDAY" {
    // request Mon 2026-06-29; 6/30, 7/1, 7/2, 7/6..7/10, 7/13..7/17, 7/20..7/24, 7/27, 7/28 = 20 business days (7/3 is a federal holiday).
    given {
        context {
            legal_time @2026-08-06;
            decision_time @2026-08-06T09:00:00-05:00;
            knowledge_time @2026-08-06T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.penalties::IRC_BUSINESS_DAY_COUNT;
        }
        assert "f0": list_request_date_6708(entity_ref("urn:test:s6708:1#f"), @2026-06-29) { origin case_input; }
    }
    evaluate truth(twentieth_business_day_after_list_request_6708(entity_ref("urn:test:s6708:1#f"), @2026-07-28));
    expect truth_status == TRUE_ONLY;
}

test "S6708A1-02-DAYS-OF-FAILURE-AFTER-THE-TWENTIETH-DAY" {
    // due 2026-07-28, made available 2026-08-05: 8 days.
    given {
        context {
            legal_time @2026-08-06;
            decision_time @2026-08-06T09:00:00-05:00;
            knowledge_time @2026-08-06T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.penalties::IRC_BUSINESS_DAY_COUNT;
        }
        assert "f0": list_request_date_6708(entity_ref("urn:test:s6708:2#f"), @2026-06-29) { origin case_input; }
        assert "f1": list_made_available_on_6708(entity_ref("urn:test:s6708:2#f"), @2026-08-05) { origin case_input; }
    }
    evaluate truth(days_after_twentieth_business_day_computed(entity_ref("urn:test:s6708:2#f"), 8));
    expect truth_status == TRUE_ONLY;
}

test "S6708A1-03-PENALTY-OF-10000-FOR-EACH-DAY" {
    // 8 days x $10,000 = $80,000.
    given {
        context {
            legal_time @2026-08-06;
            decision_time @2026-08-06T09:00:00-05:00;
            knowledge_time @2026-08-06T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.penalties::IRC_BUSINESS_DAY_COUNT;
        }
        assert "f0": list_request_date_6708(entity_ref("urn:test:s6708:3#f"), @2026-06-29) { origin case_input; }
        assert "f1": list_made_available_on_6708(entity_ref("urn:test:s6708:3#f"), @2026-08-05) { origin case_input; }
        assert "f2": failure_by(entity_ref("urn:test:s6708:3#f"), entity_ref("urn:test:s6708:3#p")) { origin case_input; }
        assert "f3": required_to_maintain_list_under_6112a_failed_to_make_available(entity_ref("urn:test:s6708:3#f")) { origin case_input; }
    }
    evaluate truth(list_not_available_penalty(entity_ref("urn:test:s6708:3#f"), 80000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S6708A1-04-LIST-MADE-AVAILABLE-ON-THE-TWENTIETH-DAY-NO-FAILURE-DAYS" {
    // made available 2026-07-28: 0 days.
    given {
        context {
            legal_time @2026-08-06;
            decision_time @2026-08-06T09:00:00-05:00;
            knowledge_time @2026-08-06T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.penalties::IRC_BUSINESS_DAY_COUNT;
        }
        assert "f0": list_request_date_6708(entity_ref("urn:test:s6708:4#f"), @2026-06-29) { origin case_input; }
        assert "f1": list_made_available_on_6708(entity_ref("urn:test:s6708:4#f"), @2026-07-28) { origin case_input; }
    }
    evaluate truth(days_after_twentieth_business_day_computed(entity_ref("urn:test:s6708:4#f"), 0));
    expect truth_status == TRUE_ONLY;
}

test "S6708A1-05-ASSERTED-DAYS-WHEN-NO-DATES" {
    // no request or answer date: the asserted number of days stands.
    given {
        context {
            legal_time @2026-08-06;
            decision_time @2026-08-06T09:00:00-05:00;
            knowledge_time @2026-08-06T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.penalties::IRC_BUSINESS_DAY_COUNT;
        }
        assert "f0": days_after_twentieth_business_day(entity_ref("urn:test:s6708:5#f"), 3) { origin case_input; }
    }
    evaluate truth(days_after_twentieth_business_day_for_penalty(entity_ref("urn:test:s6708:5#f"), 3));
    expect truth_status == TRUE_ONLY;
}
