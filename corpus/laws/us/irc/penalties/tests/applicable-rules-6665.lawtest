language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

test "S6665-01-ADDITION-TREATED-AS-TAX" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": treated_as_tax(us.irc.core::IncomeCh1, 500.00 USD) { origin case_input; }
    }
    evaluate truth(treated_as_tax(us.irc.core::IncomeCh1, 500.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S6665-02-DEFICIENCY-PROCEDURE-APPLIES-TO-FTF-PORTION" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": addition_attributable_to_deficiency_under_6211(FailureToFile) { origin case_input; }
    }
    evaluate truth(deficiency_procedure_applies_to_addition(FailureToFile));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
