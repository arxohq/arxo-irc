        assert "f1": organizes_or_assists_in_organizing_entity_or_arrangement(entity_ref("urn:us:irc:penalties:clir#F1")) { origin case_input; }
        assert "f2": makes_gross_valuation_overstatement_as_to_material_matter(entity_ref("urn:us:irc:penalties:clir#F1")) { origin case_input; }
    }
    evaluate truth(abusive_shelter_penalty(entity_ref("urn:us:irc:penalties:clir#F1"), 1000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

