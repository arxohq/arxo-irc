test "S6662E3D-01-ORDINARY-PORTION-KEEPS-THE-DEFENSE" {
    given {
        context {
            legal_time @2026-12-31;
            decision_time @2026-12-31T09:00:00-05:00;
            knowledge_time @2026-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": underpayment_portion_6664c(entity_ref("urn:us:irc:penalties:clir#P1"), entity_ref("urn:us:irc:penalties:clir#Y1"), us.irc.core::IncomeCh1, 1, 1000 USD) { origin case_input; }
        assert "j0": reasonable_cause_and_good_faith(entity_ref("urn:us:irc:penalties:clir#P1"), entity_ref("urn:us:irc:penalties:clir#FC1")) { origin adjudicated; }
    }
    evaluate truth(reasonable_cause_defense_available_for_portion_6664c(entity_ref("urn:us:irc:penalties:clir#P1"), entity_ref("urn:us:irc:penalties:clir#Y1"), us.irc.core::IncomeCh1, 1, entity_ref("urn:us:irc:penalties:clir#FC1")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

