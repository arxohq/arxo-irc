language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

test "S6672-01-RESPONSIBLE-PERSON-WILLFUL-LIABLE" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; }
        assert "f0": us.irc.employment::income_tax_withheld(entity_ref("urn:us:irc:penalties:clir#PAY1"), 3000.00 USD) { origin case_input; }
        assert "f1": us.irc.employment::fica_employee_tax(entity_ref("urn:us:irc:penalties:clir#PAY1"), 1200.00 USD) { origin case_input; }
        assert "f2": responsible_person_for_trust_fund_tax(entity_ref("urn:us:irc:penalties:clir#OFFICER1"), entity_ref("urn:us:irc:penalties:clir#PAY1")) { origin case_input; }
        assert "f3": willfully_failed_to_collect_or_pay_over(entity_ref("urn:us:irc:penalties:clir#OFFICER1"), entity_ref("urn:us:irc:penalties:clir#PAY1")) { origin adjudicated; }
    }
    evaluate truth(trust_fund_recovery_penalty(entity_ref("urn:us:irc:penalties:clir#OFFICER1"), entity_ref("urn:us:irc:penalties:clir#PAY1"), 4200.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S6672-02-NO-WILLFULNESS-NOT-LIABLE" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; }
        assert "f0": us.irc.employment::income_tax_withheld(entity_ref("urn:us:irc:penalties:clir#PAY2"), 3000.00 USD) { origin case_input; }
        assert "f1": us.irc.employment::fica_employee_tax(entity_ref("urn:us:irc:penalties:clir#PAY2"), 1200.00 USD) { origin case_input; }
        assert "f2": responsible_person_for_trust_fund_tax(entity_ref("urn:us:irc:penalties:clir#OFFICER2"), entity_ref("urn:us:irc:penalties:clir#PAY2")) { origin case_input; }
    }
    evaluate truth(trust_fund_recovery_penalty(entity_ref("urn:us:irc:penalties:clir#OFFICER2"), entity_ref("urn:us:irc:penalties:clir#PAY2"), 1000.00 USD));
    expect truth_status == NEITHER;
}

test "S6672-03-SIXTY-DAY-NOTICE-SATISFIED-VALID-ASSESSMENT" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": trust_fund_recovery_notice_mailed_or_delivered_on(entity_ref("urn:us:irc:penalties:clir#OFFICER3"), entity_ref("urn:us:irc:penalties:clir#PAY3"), @2026-01-01) { origin case_input; }
        assert "f1": trust_fund_recovery_notice_and_demand_on(entity_ref("urn:us:irc:penalties:clir#OFFICER3"), entity_ref("urn:us:irc:penalties:clir#PAY3"), @2026-04-01) { origin case_input; }
        assert "f2": secretary_moves_to_assess_trust_fund_recovery_penalty(entity_ref("urn:us:irc:penalties:clir#OFFICER3"), entity_ref("urn:us:irc:penalties:clir#PAY3")) { origin case_input; }
    }
    evaluate truth(trust_fund_recovery_penalty_validly_assessable(entity_ref("urn:us:irc:penalties:clir#OFFICER3"), entity_ref("urn:us:irc:penalties:clir#PAY3")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S6672-04-LESS-THAN-SIXTY-DAYS-INVALID-EXERCISE" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": trust_fund_recovery_notice_mailed_or_delivered_on(entity_ref("urn:us:irc:penalties:clir#OFFICER4"), entity_ref("urn:us:irc:penalties:clir#PAY4"), @2026-03-01) { origin case_input; }
        assert "f1": trust_fund_recovery_notice_and_demand_on(entity_ref("urn:us:irc:penalties:clir#OFFICER4"), entity_ref("urn:us:irc:penalties:clir#PAY4"), @2026-04-01) { origin case_input; }
        assert "f2": secretary_moves_to_assess_trust_fund_recovery_penalty(entity_ref("urn:us:irc:penalties:clir#OFFICER4"), entity_ref("urn:us:irc:penalties:clir#PAY4")) { origin case_input; }
    }
    evaluate truth(trust_fund_recovery_penalty_validly_assessable(entity_ref("urn:us:irc:penalties:clir#OFFICER4"), entity_ref("urn:us:irc:penalties:clir#PAY4")));
    expect truth_status == NEITHER;
}

test "S6672-05-JEOPARDY-BYPASSES-SIXTY-DAY-CONDITION" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": trust_fund_recovery_collection_in_jeopardy(entity_ref("urn:us:irc:penalties:clir#OFFICER5"), entity_ref("urn:us:irc:penalties:clir#PAY5")) { origin case_input; }
        assert "f1": secretary_moves_to_assess_trust_fund_recovery_penalty(entity_ref("urn:us:irc:penalties:clir#OFFICER5"), entity_ref("urn:us:irc:penalties:clir#PAY5")) { origin case_input; }
    }
    evaluate truth(trust_fund_recovery_penalty_validly_assessable(entity_ref("urn:us:irc:penalties:clir#OFFICER5"), entity_ref("urn:us:irc:penalties:clir#PAY5")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S6672-06-CONTRIBUTION-RECOVERABLE-EXCESS-OVER-SHARE" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": trust_fund_recovery_penalty_paid_by(entity_ref("urn:us:irc:penalties:clir#OFFICER6"), entity_ref("urn:us:irc:penalties:clir#PAY6"), 4200.00 USD) { origin case_input; }
        assert "f1": proportionate_share_of(entity_ref("urn:us:irc:penalties:clir#OFFICER6"), entity_ref("urn:us:irc:penalties:clir#PAY6"), 2100.00 USD) { origin adjudicated; }
    }
    evaluate truth(trust_fund_recovery_contribution_recoverable(entity_ref("urn:us:irc:penalties:clir#OFFICER6"), entity_ref("urn:us:irc:penalties:clir#PAY6"), 2100.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S6672-07-VOLUNTEER-BOARD-MEMBER-EXEMPT-OTHERS-LIABLE" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": us.irc.employment::income_tax_withheld(entity_ref("urn:us:irc:penalties:clir#PAY7"), 3000.00 USD) { origin case_input; }
        assert "f1": us.irc.employment::fica_employee_tax(entity_ref("urn:us:irc:penalties:clir#PAY7"), 1200.00 USD) { origin case_input; }
        assert "f2": responsible_person_for_trust_fund_tax(entity_ref("urn:us:irc:penalties:clir#BOARD1"), entity_ref("urn:us:irc:penalties:clir#PAY7")) { origin case_input; }
        assert "f3": willfully_failed_to_collect_or_pay_over(entity_ref("urn:us:irc:penalties:clir#BOARD1"), entity_ref("urn:us:irc:penalties:clir#PAY7")) { origin adjudicated; }
        assert "f4": serves_exempt_organization_board(entity_ref("urn:us:irc:penalties:clir#BOARD1"), entity_ref("urn:us:irc:penalties:clir#ORG1")) { origin case_input; }
        assert "f5": solely_honorary_capacity(entity_ref("urn:us:irc:penalties:clir#BOARD1"), entity_ref("urn:us:irc:penalties:clir#ORG1")) { origin case_input; }
        assert "f6": no_day_to_day_or_financial_participation(entity_ref("urn:us:irc:penalties:clir#BOARD1"), entity_ref("urn:us:irc:penalties:clir#ORG1")) { origin case_input; }
        assert "f7": no_actual_knowledge_of_failure(entity_ref("urn:us:irc:penalties:clir#BOARD1"), entity_ref("urn:us:irc:penalties:clir#PAY7")) { origin case_input; }
        assert "f8": other_responsible_person_remains_liable_for(entity_ref("urn:us:irc:penalties:clir#BOARD1"), entity_ref("urn:us:irc:penalties:clir#PAY7")) { origin case_input; }
    }
    evaluate truth(trust_fund_recovery_penalty(entity_ref("urn:us:irc:penalties:clir#BOARD1"), entity_ref("urn:us:irc:penalties:clir#PAY7"), 4200.00 USD));
    expect truth_status == FALSE_ONLY;
}

