language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

test "S6663-01-FRAUD-ESTABLISHED-SEVENTY-FIVE-PERCENT" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": us.irc.core::return_of(entity_ref("urn:us:irc:penalties:clir#R6"), entity_ref("urn:us:irc:penalties:clir#P6"), entity_ref("urn:us:irc:penalties:clir#Y2025"), us.irc.core::IncomeCh1) { origin case_input; }
        assert "f1": us.irc.core::liability(entity_ref("urn:us:irc:penalties:clir#P6"), entity_ref("urn:us:irc:penalties:clir#Y2025"), us.irc.core::IncomeCh1, 10000.00 USD) { origin case_input; }
        assert "f2": tax_shown_on_return(entity_ref("urn:us:irc:penalties:clir#R6"), 6000.00 USD) { origin case_input; }
        assert "f3": secretary_establishes_fraud_on_portion(entity_ref("urn:us:irc:penalties:clir#P6"), entity_ref("urn:us:irc:penalties:clir#Y2025"), us.irc.core::IncomeCh1, 4000.00 USD) { origin case_input; }
        assert "f4": us.irc.core::filed_on(entity_ref("urn:us:irc:penalties:clir#R6"), @2026-04-15) { origin case_input; }
        assert "f5": fraud_penalty_applies_to_spouse(entity_ref("urn:us:irc:penalties:clir#P6"), entity_ref("urn:us:irc:penalties:clir#Y2025"), us.irc.core::IncomeCh1) { origin case_input; }
    }
    evaluate truth(fraud_penalty(entity_ref("urn:us:irc:penalties:clir#P6"), entity_ref("urn:us:irc:penalties:clir#Y2025"), us.irc.core::IncomeCh1, 3000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S6663-02-TAXPAYER-REBUTS-PORTION-BY-PREPONDERANCE" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": secretary_establishes_fraud_on_portion(entity_ref("urn:us:irc:penalties:clir#P7"), entity_ref("urn:us:irc:penalties:clir#Y2025"), us.irc.core::IncomeCh1, 4000.00 USD) { origin case_input; }
        assert "f1": taxpayer_establishes_portion_not_fraud_by_preponderance(entity_ref("urn:us:irc:penalties:clir#P7"), entity_ref("urn:us:irc:penalties:clir#Y2025"), us.irc.core::IncomeCh1, 1000.00 USD) { origin case_input; }
    }
    evaluate truth(underpayment_attributable_to_fraud(entity_ref("urn:us:irc:penalties:clir#P7"), entity_ref("urn:us:irc:penalties:clir#Y2025"), us.irc.core::IncomeCh1, 3000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S6664-01-UNDERPAYMENT-DEFINITION" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": us.irc.core::return_of(entity_ref("urn:us:irc:penalties:clir#R8"), entity_ref("urn:us:irc:penalties:clir#P8"), entity_ref("urn:us:irc:penalties:clir#Y2025"), us.irc.core::IncomeCh1) { origin case_input; }
        assert "f1": us.irc.core::liability(entity_ref("urn:us:irc:penalties:clir#P8"), entity_ref("urn:us:irc:penalties:clir#Y2025"), us.irc.core::IncomeCh1, 10000.00 USD) { origin case_input; }
        assert "f2": tax_shown_on_return(entity_ref("urn:us:irc:penalties:clir#R8"), 8000.00 USD) { origin case_input; }
    }
    evaluate truth(underpayment(entity_ref("urn:us:irc:penalties:clir#P8"), entity_ref("urn:us:irc:penalties:clir#Y2025"), us.irc.core::IncomeCh1, 2000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
