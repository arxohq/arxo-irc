language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

test "S6651-01-ONE-MONTH-LATE-FILE-AND-PAY" {
    given {
        context { decision_time @2026-05-20T09:00:00-04:00; knowledge_time @2026-05-20T09:00:00-04:00; legal_time @2026-05-20; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": us.irc.core::return_of(entity_ref("urn:us:irc:penalties:clir#R1"), entity_ref("urn:us:irc:penalties:clir#P1"), entity_ref("urn:us:irc:penalties:clir#Y2025"), us.irc.core::IncomeCh1) { origin case_input; }
        assert "f1": us.irc.core::liability(entity_ref("urn:us:irc:penalties:clir#P1"), entity_ref("urn:us:irc:penalties:clir#Y2025"), us.irc.core::IncomeCh1, 10000.00 USD) { origin case_input; }
        assert "f2": us.irc.core::due_date(entity_ref("urn:us:irc:penalties:clir#R1"), @2026-04-15) { origin case_input; }
        assert "f3": amount_paid_on_or_before(entity_ref("urn:us:irc:penalties:clir#R1"), @2026-04-15, 0.00 USD) { origin case_input; }
        assert "f4": failure_to_file_measurement_date(entity_ref("urn:us:irc:penalties:clir#R1"), @2026-05-10) { origin case_input; }
    }
    evaluate truth(failure_to_file_addition(entity_ref("urn:us:irc:penalties:clir#R1"), 500.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

