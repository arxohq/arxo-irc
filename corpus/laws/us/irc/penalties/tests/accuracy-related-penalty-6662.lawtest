language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

test "S6662-01-NEGLIGENCE-TWENTY-PERCENT" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": us.irc.core::return_of(entity_ref("urn:us:irc:penalties:clir#R9"), entity_ref("urn:us:irc:penalties:clir#P9"), entity_ref("urn:us:irc:penalties:clir#Y2025"), us.irc.core::IncomeCh1) { origin case_input; }
        assert "f1": us.irc.core::filed_on(entity_ref("urn:us:irc:penalties:clir#R9"), @2026-04-15) { origin case_input; }
        assert "f2": underpayment_attributable_to_ground(entity_ref("urn:us:irc:penalties:clir#P9"), entity_ref("urn:us:irc:penalties:clir#Y2025"), us.irc.core::IncomeCh1, Negligence, 1000.00 USD) { origin case_input; }
    }
    evaluate truth(accuracy_related_penalty_on_ground(entity_ref("urn:us:irc:penalties:clir#P9"), entity_ref("urn:us:irc:penalties:clir#Y2025"), us.irc.core::IncomeCh1, Negligence, 200.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S6662-02-SUBSTANTIAL-UNDERSTATEMENT-EXCEEDS-TEN-PERCENT" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": us.irc.core::return_of(entity_ref("urn:us:irc:penalties:clir#R10"), entity_ref("urn:us:irc:penalties:clir#P10"), entity_ref("urn:us:irc:penalties:clir#Y2025"), us.irc.core::IncomeCh1) { origin case_input; }
        assert "f1": us.irc.core::liability(entity_ref("urn:us:irc:penalties:clir#P10"), entity_ref("urn:us:irc:penalties:clir#Y2025"), us.irc.core::IncomeCh1, 100000.00 USD) { origin case_input; }
        assert "f2": tax_shown_on_return(entity_ref("urn:us:irc:penalties:clir#R10"), 85000.00 USD) { origin case_input; }
    }
    evaluate truth(substantial_understatement_of_income_tax(entity_ref("urn:us:irc:penalties:clir#P10"), entity_ref("urn:us:irc:penalties:clir#Y2025"), us.irc.core::IncomeCh1));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S6662-03-UNDERSTATEMENT-AT-EXACTLY-THRESHOLD-NOT-SUBSTANTIAL" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": us.irc.core::return_of(entity_ref("urn:us:irc:penalties:clir#R11"), entity_ref("urn:us:irc:penalties:clir#P11"), entity_ref("urn:us:irc:penalties:clir#Y2025"), us.irc.core::IncomeCh1) { origin case_input; }
        assert "f1": us.irc.core::liability(entity_ref("urn:us:irc:penalties:clir#P11"), entity_ref("urn:us:irc:penalties:clir#Y2025"), us.irc.core::IncomeCh1, 100000.00 USD) { origin case_input; }
        assert "f2": tax_shown_on_return(entity_ref("urn:us:irc:penalties:clir#R11"), 90000.00 USD) { origin case_input; }
    }
    evaluate truth(substantial_understatement_of_income_tax(entity_ref("urn:us:irc:penalties:clir#P11"), entity_ref("urn:us:irc:penalties:clir#Y2025"), us.irc.core::IncomeCh1));
    expect truth_status == NEITHER;
}
