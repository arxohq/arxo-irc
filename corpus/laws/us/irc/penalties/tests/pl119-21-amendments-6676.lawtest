language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

// Scenarios for Pub. L. 119-21 sec. 70605(f) (section 6676(a) employment tax), module 24. NOT executed. implemented_unverified.

test "S6676-EMP-01-FICA-CLAIM-AFTER-ENACTMENT-TWENTY-PERCENT" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": us.irc.core::claim_of(entity_ref("urn:us:irc:penalties:clir#C1"), entity_ref("urn:us:irc:penalties:clir#P1"), entity_ref("urn:us:irc:penalties:clir#Y1"), us.irc.core::FicaCh21, 1000.00 USD) { origin case_input; }
        assert "f1": refund_claim_amount(entity_ref("urn:us:irc:penalties:clir#C1"), 1000.00 USD) { origin case_input; }
        assert "f2": refund_claim_allowable_amount(entity_ref("urn:us:irc:penalties:clir#C1"), 0.00 USD) { origin case_input; }
        assert "f3": not reasonable_cause_for_excessive_claim(entity_ref("urn:us:irc:penalties:clir#P1"), entity_ref("urn:us:irc:penalties:clir#C1")) { origin adjudicated; }
    }
    evaluate truth(erroneous_refund_claim_penalty(entity_ref("urn:us:irc:penalties:clir#C1"), 200.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S6676-EMP-02-FICA-CLAIM-BEFORE-ENACTMENT-NOT-COVERED" {
    given {
        context { decision_time @2025-07-03T09:00:00-05:00; knowledge_time @2025-07-03T09:00:00-05:00; legal_time @2025-07-03; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": us.irc.core::claim_of(entity_ref("urn:us:irc:penalties:clir#C2"), entity_ref("urn:us:irc:penalties:clir#P1"), entity_ref("urn:us:irc:penalties:clir#Y1"), us.irc.core::FicaCh21, 1000.00 USD) { origin case_input; }
        assert "f1": refund_claim_amount(entity_ref("urn:us:irc:penalties:clir#C2"), 1000.00 USD) { origin case_input; }
        assert "f2": refund_claim_allowable_amount(entity_ref("urn:us:irc:penalties:clir#C2"), 0.00 USD) { origin case_input; }
        assert "f3": not reasonable_cause_for_excessive_claim(entity_ref("urn:us:irc:penalties:clir#P1"), entity_ref("urn:us:irc:penalties:clir#C2")) { origin adjudicated; }
    }
    evaluate truth(erroneous_refund_claim_penalty(entity_ref("urn:us:irc:penalties:clir#C2"), 200.00 USD));
    expect truth_status == NEITHER;
}

