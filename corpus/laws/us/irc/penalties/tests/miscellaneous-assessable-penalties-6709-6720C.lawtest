        assert "f1": made_material_misstatement_in_verified_statement_for_mcc(entity_ref("urn:us:irc:penalties:clir#F1")) { origin case_input; }
        assert "f2": mcc_misstatement_due_to_negligence(entity_ref("urn:us:irc:penalties:clir#F1")) { origin case_input; }
        assert "f3": failure_count(entity_ref("urn:us:irc:penalties:clir#F1"), 3) { origin case_input; }
    }
    evaluate truth(mcc_negligent_misstatement_penalty(entity_ref("urn:us:irc:penalties:clir#F1"), 3000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

