language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

// §6721 — per-failure classification

test "S6721-01-UNCORRECTED-FULL-RATE-340" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": information_return_failure_of(entity_ref("urn:us:irc:penalties:clir#F1"), entity_ref("urn:us:irc:penalties:clir#PAYER1"), entity_ref("urn:us:irc:penalties:clir#Y2025"), us.irc.information_reporting::WageAndTaxStatement6051) { origin case_input; }
        assert "f1": us.irc.information_reporting::information_return_due(entity_ref("urn:us:irc:penalties:clir#PAYER1"), entity_ref("urn:us:irc:penalties:clir#Y2025"), us.irc.information_reporting::WageAndTaxStatement6051, @2026-01-31) { origin case_input; }
    }
    evaluate truth(information_return_penalty_per_failure(entity_ref("urn:us:irc:penalties:clir#F1"), 340.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

