// Penalties WIRE-9 owner-contract scenarios. NOT EXECUTED (implemented_unverified); no legal review.

language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

test "W9-PEN-01-OWNER-WITHHOLDING-CREDIT-BRINGS-THE-BALANCE-UNDER-THE-6654E-THRESHOLD" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.core::liability(entity_ref("urn:test:w9pen:a#p"), entity_ref("urn:test:w9pen:a#y"), us.irc.core::IncomeCh1, 3500.00 USD) { origin case_input; }
        assert "f1": us.irc.credits::wage_withholding_credit(entity_ref("urn:test:w9pen:a#p"), entity_ref("urn:test:w9pen:a#y"), 3000.00 USD) { origin case_input; }
    }
    evaluate truth(estimated_tax_small_amount_exception(entity_ref("urn:test:w9pen:a#p"), entity_ref("urn:test:w9pen:a#y")));
    expect truth_status == TRUE_ONLY;
}

test "W9-PEN-02-OWNER-WITHHOLDING-CREDIT-LEAVES-THE-BALANCE-ABOVE-THE-THRESHOLD" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.core::liability(entity_ref("urn:test:w9pen:b#p"), entity_ref("urn:test:w9pen:b#y"), us.irc.core::IncomeCh1, 3500.00 USD) { origin case_input; }
        assert "f1": us.irc.credits::wage_withholding_credit(entity_ref("urn:test:w9pen:b#p"), entity_ref("urn:test:w9pen:b#y"), 1000.00 USD) { origin case_input; }
    }
    evaluate truth(estimated_tax_small_amount_exception(entity_ref("urn:test:w9pen:b#p"), entity_ref("urn:test:w9pen:b#y")));
    expect truth_status == FALSE_ONLY;
}

test "W9-PEN-03-WITHOUT-ANY-SECTION-31-FACT-THE-EXCEPTION-IS-NOT-ESTABLISHED" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.core::liability(entity_ref("urn:test:w9pen:c#p"), entity_ref("urn:test:w9pen:c#y"), us.irc.core::IncomeCh1, 500.00 USD) { origin case_input; }
    }
    evaluate truth(estimated_tax_small_amount_exception(entity_ref("urn:test:w9pen:c#p"), entity_ref("urn:test:w9pen:c#y")));
    expect truth_status == FALSE_ONLY;
}

test "W9-PEN-04-PLACEHOLDER-STILL-ACCEPTS-THE-CASE-FACT" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.core::liability(entity_ref("urn:test:w9pen:d#p"), entity_ref("urn:test:w9pen:d#y"), us.irc.core::IncomeCh1, 900.00 USD) { origin case_input; }
        assert "f1": section31_withholding_credit(entity_ref("urn:test:w9pen:d#p"), entity_ref("urn:test:w9pen:d#y"), 0.00 USD) { origin case_input; }
    }
    evaluate truth(estimated_tax_small_amount_exception(entity_ref("urn:test:w9pen:d#p"), entity_ref("urn:test:w9pen:d#y")));
    expect truth_status == TRUE_ONLY;
}
