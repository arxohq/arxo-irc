}

test "S6707A-05-RESCISSION-POWER-VALID-FOR-NONLISTED" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": rescission_would_promote_compliance(entity_ref("urn:us:irc:penalties:clir#RTF5")) { origin case_input; }
        assert "f1": commissioner_moves_to_rescind(entity_ref("urn:us:irc:penalties:clir#RTF5")) { origin case_input; }
    }
    evaluate truth(reportable_transaction_penalty_rescinded(entity_ref("urn:us:irc:penalties:clir#RTF5")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S6707A-06-RESCISSION-INVALID-FOR-LISTED-TRANSACTION" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": is_listed_transaction(entity_ref("urn:us:irc:penalties:clir#RTF6")) { origin case_input; }
        assert "f1": rescission_would_promote_compliance(entity_ref("urn:us:irc:penalties:clir#RTF6")) { origin case_input; }
        assert "f2": commissioner_moves_to_rescind(entity_ref("urn:us:irc:penalties:clir#RTF6")) { origin case_input; }
    }
    evaluate truth(reportable_transaction_penalty_rescinded(entity_ref("urn:us:irc:penalties:clir#RTF6")));
    expect truth_status == NEITHER;
}
