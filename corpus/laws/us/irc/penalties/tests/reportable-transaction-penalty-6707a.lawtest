language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

test "S6707A-01-LISTED-INDIVIDUAL-CAPPED-AT-100K" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": reportable_transaction_failure_of(entity_ref("urn:us:irc:penalties:clir#RTF1"), entity_ref("urn:us:irc:penalties:clir#P1")) { origin case_input; }
        assert "f1": reportable_transaction_person_is_individual(entity_ref("urn:us:irc:penalties:clir#P1")) { origin case_input; }
        assert "f2": is_listed_transaction(entity_ref("urn:us:irc:penalties:clir#RTF1")) { origin case_input; }
        assert "f3": decrease_in_tax_from_transaction(entity_ref("urn:us:irc:penalties:clir#RTF1"), 500000.00 USD) { origin case_input; }
    }
    evaluate truth(reportable_transaction_penalty_6707a(entity_ref("urn:us:irc:penalties:clir#RTF1"), 100000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S6707A-02-LISTED-CORPORATION-UNCAPPED-BELOW-200K" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": reportable_transaction_failure_of(entity_ref("urn:us:irc:penalties:clir#RTF2"), entity_ref("urn:us:irc:penalties:clir#CORP2")) { origin case_input; }
        assert "f1": is_listed_transaction(entity_ref("urn:us:irc:penalties:clir#RTF2")) { origin case_input; }
        assert "f2": decrease_in_tax_from_transaction(entity_ref("urn:us:irc:penalties:clir#RTF2"), 100000.00 USD) { origin case_input; }
    }
    evaluate truth(reportable_transaction_penalty_6707a(entity_ref("urn:us:irc:penalties:clir#RTF2"), 75000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

