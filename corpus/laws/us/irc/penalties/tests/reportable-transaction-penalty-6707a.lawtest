}

test "S6707A-04-OTHER-TRANSACTION-CORPORATION-CAPPED-50K" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": reportable_transaction_failure_of(entity_ref("urn:us:irc:penalties:clir#RTF4"), entity_ref("urn:us:irc:penalties:clir#CORP4")) { origin case_input; }
        assert "f1": decrease_in_tax_from_transaction(entity_ref("urn:us:irc:penalties:clir#RTF4"), 1000000.00 USD) { origin case_input; }
    }
    evaluate truth(reportable_transaction_penalty_6707a(entity_ref("urn:us:irc:penalties:clir#RTF4"), 50000.00 USD));
    expect truth_status == TRUE_ONLY;
