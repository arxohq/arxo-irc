language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

test "S6654-01-REQUIRED-ANNUAL-PAYMENT-NINETY-PERCENT-CONTROLS" {
    given {
        context { decision_time @2026-04-16T09:00:00-04:00; knowledge_time @2026-04-16T09:00:00-04:00; legal_time @2026-04-16; timezone "America/New_York"; }
        assert "f0": us.irc.core::liability(entity_ref("urn:us:irc:penalties:clir#P12"), entity_ref("urn:us:irc:penalties:clir#Y2025"), us.irc.core::IncomeCh1, 10000.00 USD) { origin case_input; }
        assert "f1": preceding_year_return_filed(entity_ref("urn:us:irc:penalties:clir#P12"), entity_ref("urn:us:irc:penalties:clir#Y2025")) { origin case_input; }
        assert "f2": preceding_year_tax_shown(entity_ref("urn:us:irc:penalties:clir#P12"), entity_ref("urn:us:irc:penalties:clir#Y2025"), 20000.00 USD) { origin case_input; }
    }
    evaluate truth(required_annual_payment(entity_ref("urn:us:irc:penalties:clir#P12"), entity_ref("urn:us:irc:penalties:clir#Y2025"), 9000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S6654-02-HIGH-INCOME-PRECEDING-YEAR-110-PERCENT" {
    given {
        context { decision_time @2026-04-16T09:00:00-04:00; knowledge_time @2026-04-16T09:00:00-04:00; legal_time @2026-04-16; timezone "America/New_York"; }
        assert "f0": us.irc.core::liability(entity_ref("urn:us:irc:penalties:clir#P13"), entity_ref("urn:us:irc:penalties:clir#Y2025"), us.irc.core::IncomeCh1, 10000.00 USD) { origin case_input; }
        assert "f1": preceding_year_return_filed(entity_ref("urn:us:irc:penalties:clir#P13"), entity_ref("urn:us:irc:penalties:clir#Y2025")) { origin case_input; }
        assert "f2": preceding_year_tax_shown(entity_ref("urn:us:irc:penalties:clir#P13"), entity_ref("urn:us:irc:penalties:clir#Y2025"), 5000.00 USD) { origin case_input; }
        assert "f3": preceding_year_agi_exceeds_150000(entity_ref("urn:us:irc:penalties:clir#P13"), entity_ref("urn:us:irc:penalties:clir#Y2025")) { origin case_input; }
    }
    evaluate truth(required_annual_payment(entity_ref("urn:us:irc:penalties:clir#P13"), entity_ref("urn:us:irc:penalties:clir#Y2025"), 5500.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S6654-03-SMALL-AMOUNT-EXCEPTION-UNDER-1000" {
    given {
        context { decision_time @2026-04-16T09:00:00-04:00; knowledge_time @2026-04-16T09:00:00-04:00; legal_time @2026-04-16; timezone "America/New_York"; }
        assert "f0": us.irc.core::liability(entity_ref("urn:us:irc:penalties:clir#P14"), entity_ref("urn:us:irc:penalties:clir#Y2025"), us.irc.core::IncomeCh1, 900.00 USD) { origin case_input; }
        assert "f1": section31_withholding_credit(entity_ref("urn:us:irc:penalties:clir#P14"), entity_ref("urn:us:irc:penalties:clir#Y2025"), 0.00 USD) { origin case_input; }
    }
    evaluate truth(estimated_tax_small_amount_exception(entity_ref("urn:us:irc:penalties:clir#P14"), entity_ref("urn:us:irc:penalties:clir#Y2025")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
