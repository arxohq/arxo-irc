// §6695(a)-(e) — per-failure and annual cap

test "S6695A-01-PER-FAILURE-FIFTY" {
    given {
        context { decision_time @2010-06-01T09:00:00-05:00; knowledge_time @2010-06-01T09:00:00-05:00; legal_time @2010-06-01; timezone "America/New_York"; }
        assert "f0": section_6695_failure_of(entity_ref("urn:us:irc:penalties:clir#SF1"), entity_ref("urn:us:irc:penalties:clir#PREP9"), entity_ref("urn:us:irc:penalties:clir#Y2010"), CopyToTaxpayer) { origin case_input; }
    }
    evaluate truth(section_6695_penalty_per_failure(entity_ref("urn:us:irc:penalties:clir#SF1"), 50.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

