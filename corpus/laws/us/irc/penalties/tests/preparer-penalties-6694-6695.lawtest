        assert "f2": preparer_knew_or_should_have_known(entity_ref("urn:us:irc:penalties:clir#E2")) { origin case_input; }
        assert "f3": income_derived_by_preparer(entity_ref("urn:us:irc:penalties:clir#E2"), 10000.00 USD) { origin case_input; }
    }
    evaluate truth(preparer_penalty_6694a(entity_ref("urn:us:irc:penalties:clir#E2"), 5000.00 USD));
