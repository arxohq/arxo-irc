        assert "f1": preparer_position_category(entity_ref("urn:us:irc:penalties:clir#E4"), General) { origin case_input; }
        assert "f2": preparer_knew_or_should_have_known(entity_ref("urn:us:irc:penalties:clir#E4")) { origin case_input; }
        assert "f3": income_derived_by_preparer(entity_ref("urn:us:irc:penalties:clir#E4"), 1000.00 USD) { origin case_input; }
        assert "f4": reasonable_cause_and_good_faith(entity_ref("urn:us:irc:penalties:clir#PREP4"), entity_ref("urn:us:irc:penalties:clir#FC4")) { origin adjudicated; }
    }
    evaluate truth(preparer_penalty_6694a(entity_ref("urn:us:irc:penalties:clir#E4"), 1000.00 USD));
    expect truth_status == FALSE_ONLY;
}

// §6694(b) — willful/reckless with (b)(3) reduction

test "S6694B-01-WILLFUL-GREATER-OF-5000" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": preparer_engagement_of(entity_ref("urn:us:irc:penalties:clir#E5"), entity_ref("urn:us:irc:penalties:clir#PREP5")) { origin case_input; }
        assert "f1": willful_or_reckless_conduct(entity_ref("urn:us:irc:penalties:clir#E5")) { origin adjudicated; }
        assert "f2": income_derived_by_preparer(entity_ref("urn:us:irc:penalties:clir#E5"), 1000.00 USD) { origin case_input; }
    }
    evaluate truth(preparer_penalty_6694b_before_reduction(entity_ref("urn:us:irc:penalties:clir#E5"), 5000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

