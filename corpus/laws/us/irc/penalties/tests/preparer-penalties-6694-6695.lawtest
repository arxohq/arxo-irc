}

test "S6695A-03-ANNUAL-TOTAL-CAPPED" {
    given {
        context { decision_time @2010-06-01T09:00:00-05:00; knowledge_time @2010-06-01T09:00:00-05:00; legal_time @2010-06-01; timezone "America/New_York"; }
