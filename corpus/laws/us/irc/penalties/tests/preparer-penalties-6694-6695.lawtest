    expect evaluation_status == COMPUTED;
}

test "S6694A-03-SUBSTANTIAL-AUTHORITY-NO-PENALTY" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": preparer_engagement_of(entity_ref("urn:us:irc:penalties:clir#E3"), entity_ref("urn:us:irc:penalties:clir#PREP3")) { origin case_input; }
        assert "f1": preparer_position_category(entity_ref("urn:us:irc:penalties:clir#E3"), General) { origin case_input; }
        assert "f2": substantial_authority_for_position(entity_ref("urn:us:irc:penalties:clir#E3")) { origin adjudicated; }
        assert "f3": preparer_knew_or_should_have_known(entity_ref("urn:us:irc:penalties:clir#E3")) { origin case_input; }
        assert "f4": income_derived_by_preparer(entity_ref("urn:us:irc:penalties:clir#E3"), 10000.00 USD) { origin case_input; }
    }
    evaluate truth(preparer_penalty_6694a(entity_ref("urn:us:irc:penalties:clir#E3"), 1000.00 USD));
    expect truth_status == NEITHER;
}

test "S6694A-04-REASONABLE-CAUSE-AND-GOOD-FAITH-DEFEATS" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; }
