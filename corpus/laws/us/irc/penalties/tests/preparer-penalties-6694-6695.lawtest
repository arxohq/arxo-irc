language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

// §6694(a) — unreasonable position

test "S6694A-01-NO-SUBSTANTIAL-AUTHORITY-GREATER-OF-1000" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": preparer_engagement_of(entity_ref("urn:us:irc:penalties:clir#E1"), entity_ref("urn:us:irc:penalties:clir#PREP1")) { origin case_input; }
        assert "f1": preparer_position_category(entity_ref("urn:us:irc:penalties:clir#E1"), General) { origin case_input; }
        assert "f2": preparer_knew_or_should_have_known(entity_ref("urn:us:irc:penalties:clir#E1")) { origin case_input; }
        assert "f3": income_derived_by_preparer(entity_ref("urn:us:irc:penalties:clir#E1"), 1000.00 USD) { origin case_input; }
    }
    evaluate truth(preparer_penalty_6694a(entity_ref("urn:us:irc:penalties:clir#E1"), 1000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

