    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": preparer_engagement_of(entity_ref("urn:us:irc:penalties:clir#E2"), entity_ref("urn:us:irc:penalties:clir#PREP2")) { origin case_input; }
