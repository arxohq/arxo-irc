language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

test "W7PEN-01-OWNER-CONTRACT-DERIVES-CONSUMER" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert us.irc.exempt_organizations::private_foundation(entity_ref("urn:us:irc:penalties:clir#CORP1"), entity_ref("urn:us:irc:penalties:clir#Y2025")) { id "f0"; origin case_input; }
    }
    evaluate truth(private_foundation_6655(entity_ref("urn:us:irc:penalties:clir#CORP1"), entity_ref("urn:us:irc:penalties:clir#Y2025")));
    expect truth_status == TRUE_ONLY;
}

test "W7PEN-01-NO-OWNER-FACT-NOT-DERIVED" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
