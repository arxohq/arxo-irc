test "W10A-PE-04-TFRP-STAY-SUSPENDS-THE-6502-PERIOD-FOR-THE-PROHIBITION" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": tfrp_collection_limitation_suspended_6672c4(entity_ref("urn:test:w10a:pe4#p"), entity_ref("urn:test:w10a:pe4#pay")) { origin case_input; }
        assert "f1": trust_fund_penalty_assessment(entity_ref("urn:test:w10a:pe4#p"), entity_ref("urn:test:w10a:pe4#pay"), entity_ref("urn:test:w10a:pe4#a")) { origin case_input; }
        assert "f2": tfrp_collection_prohibited_during(entity_ref("urn:test:w10a:pe4#p"), entity_ref("urn:test:w10a:pe4#pay"), @2026-01-10, @2026-03-20) { origin case_input; }
    }
    evaluate truth(us.irc.assessment::collection_period_suspension(entity_ref("urn:test:w10a:pe4#a"), us.irc.assessment::TfrpCollectionStay6672c4, @2026-01-10, @2026-03-20));
    expect truth_status == TRUE_ONLY;
}

