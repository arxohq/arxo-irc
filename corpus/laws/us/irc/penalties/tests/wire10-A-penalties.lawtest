test "W10A-PE-08-PAYMENTS-ON-OR-BEFORE-THE-DUE-DATE-ARE-SUMMED" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.core::return_of(entity_ref("urn:test:w10a:pe8#r"), entity_ref("urn:test:w10a:pe8#p"), entity_ref("urn:test:w10a:pe8#y"), us.irc.core::IncomeCh1) { origin case_input; }
        assert "f1": us.irc.core::due_date(entity_ref("urn:test:w10a:pe8#r"), @2026-04-15) { origin case_input; }
        assert "f2": us.irc.core::payment(entity_ref("urn:test:w10a:pe8#pay1"), entity_ref("urn:test:w10a:pe8#p"), 300.00 USD, @2026-03-01) { origin case_input; }
        assert "f3": us.irc.core::payment_applied(entity_ref("urn:test:w10a:pe8#pay1"), entity_ref("urn:test:w10a:pe8#p"), entity_ref("urn:test:w10a:pe8#y"), us.irc.core::IncomeCh1) { origin case_input; }
        assert "f4": us.irc.core::payment(entity_ref("urn:test:w10a:pe8#pay2"), entity_ref("urn:test:w10a:pe8#p"), 200.00 USD, @2026-04-15) { origin case_input; }
        assert "f5": us.irc.core::payment_applied(entity_ref("urn:test:w10a:pe8#pay2"), entity_ref("urn:test:w10a:pe8#p"), entity_ref("urn:test:w10a:pe8#y"), us.irc.core::IncomeCh1) { origin case_input; }
    }
    evaluate truth(amount_paid_on_or_before(entity_ref("urn:test:w10a:pe8#r"), @2026-04-15, 500.00 USD));
    expect truth_status == TRUE_ONLY;
}

