// WIRE-10 group A scenarios for module 96-wire10-A-penalties.law (section 6665(a) applied to two alcohol penalties). NOT EXECUTED (implemented_unverified); no legal review.

language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

test "W10A-PE-01-LATE-ALCOHOL-TAX-PENALTY-IS-TREATED-AS-TAX" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.alcohol::late_alcohol_tax_penalty(entity_ref("urn:test:w10a:pe1#l"), entity_ref("urn:test:w10a:pe1#p"), 50.00 USD) { origin case_input; }
    }
    evaluate truth(treated_as_tax(us.irc.core::AlcoholExciseCh51, 50.00 USD));
    expect truth_status == TRUE_ONLY;
}

