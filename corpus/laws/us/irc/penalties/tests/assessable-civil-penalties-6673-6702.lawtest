        assert "f1": fuel_credit_claim_amount(entity_ref("urn:us:irc:penalties:clir#FC1"), 500.00 USD) { origin case_input; }
        assert "f2": fuel_credit_allowable_amount(entity_ref("urn:us:irc:penalties:clir#FC1"), 400.00 USD) { origin case_input; }
