        assert "f4": secretary_moves_to_waive_withholding_penalty(entity_ref("urn:us:irc:penalties:clir#WS2")) { origin case_input; }
    }
    evaluate truth(false_withholding_statement_penalty_waived(entity_ref("urn:us:irc:penalties:clir#WS2")));
