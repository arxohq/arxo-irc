language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

// §6673(a)(1) — Tax Court sanction for frivolous proceedings

test "S6673-01-FRIVOLOUS-POSITION-VALID-SANCTION-AUTHORIZED" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; }
        assert "f0": position_frivolous_or_groundless(entity_ref("urn:us:irc:penalties:clir#TC1")) { origin case_input; }
        assert "f1": tax_court_moves_to_sanction(entity_ref("urn:us:irc:penalties:clir#TC1")) { origin case_input; }
    }
    evaluate truth(tax_court_sanction_authorized(entity_ref("urn:us:irc:penalties:clir#TC1")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S6673-02-NO-GROUND-SANCTION-NOT-AUTHORIZED" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; }
        assert "f0": tax_court_moves_to_sanction(entity_ref("urn:us:irc:penalties:clir#TC2")) { origin case_input; }
    }
    evaluate truth(tax_court_sanction_authorized(entity_ref("urn:us:irc:penalties:clir#TC2")));
    expect truth_status == NEITHER;
}

test "S6673-03-SANCTION-AMOUNT-WITHIN-CAP" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; }
