        assert "f1": tax_court_moves_to_sanction(entity_ref("urn:us:irc:penalties:clir#TC3")) { origin case_input; }
        assert "f2": tax_court_sanction_amount(entity_ref("urn:us:irc:penalties:clir#TC3"), 25000.00 USD) { origin case_input; }
    }
    evaluate truth(tax_court_sanction_within_cap(entity_ref("urn:us:irc:penalties:clir#TC3")));
