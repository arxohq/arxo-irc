test "S6664a-01-UNDERPAYMENT-PLAIN-TAX-MINUS-SHOWN" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": us.irc.core::return_of(entity_ref("urn:us:irc:penalties:clir#R1"), entity_ref("urn:us:irc:penalties:clir#P1"), entity_ref("urn:us:irc:penalties:clir#Y1"), us.irc.core::IncomeCh1) { origin case_input; }
        assert "f1": us.irc.core::liability(entity_ref("urn:us:irc:penalties:clir#P1"), entity_ref("urn:us:irc:penalties:clir#Y1"), us.irc.core::IncomeCh1, 10000.00 USD) { origin case_input; }
        assert "f2": tax_shown_on_return(entity_ref("urn:us:irc:penalties:clir#R1"), 6000.00 USD) { origin case_input; }
    }
    evaluate truth(underpayment(entity_ref("urn:us:irc:penalties:clir#P1"), entity_ref("urn:us:irc:penalties:clir#Y1"), us.irc.core::IncomeCh1, 4000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

