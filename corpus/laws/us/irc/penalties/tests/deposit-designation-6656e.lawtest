language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

// Scenarios for 26 U.S.C. §6656(e) and the §6664(a) additions, module 27. NOT executed (owner restriction). implemented_unverified.

test "S6656e-01-DEPOSIT-APPLIED-TO-MOST-RECENT-PERIOD" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": deposit_period_within_specified_tax_period(entity_ref("urn:us:irc:penalties:clir#D1"), entity_ref("urn:us:irc:penalties:clir#PER1")) { origin case_input; }
        assert "f1": deposit_period_within_specified_tax_period(entity_ref("urn:us:irc:penalties:clir#D1"), entity_ref("urn:us:irc:penalties:clir#PER2")) { origin case_input; }
        assert "f2": deposit_period_ends_on(entity_ref("urn:us:irc:penalties:clir#PER1"), @2026-01-31) { origin case_input; }
        assert "f3": deposit_period_ends_on(entity_ref("urn:us:irc:penalties:clir#PER2"), @2026-03-31) { origin case_input; }
    }
    evaluate truth(deposit_applied_to_period(entity_ref("urn:us:irc:penalties:clir#D1"), entity_ref("urn:us:irc:penalties:clir#PER2")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

