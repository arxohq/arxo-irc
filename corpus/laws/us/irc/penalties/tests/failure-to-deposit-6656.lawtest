language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

test "S6656-01-THREE-DAYS-LATE-TWO-PERCENT-TIER" {
    given {
        context { decision_time @2026-02-10T09:00:00-05:00; knowledge_time @2026-02-10T09:00:00-05:00; legal_time @2026-02-10; timezone "America/New_York"; }
        assert "f0": deposit_required_amount(entity_ref("urn:us:irc:penalties:clir#D1"), 1000.00 USD) { origin case_input; }
        assert "f1": deposit_made_amount(entity_ref("urn:us:irc:penalties:clir#D1"), 0.00 USD) { origin case_input; }
        assert "f2": deposit_prescribed_date(entity_ref("urn:us:irc:penalties:clir#D1"), @2026-02-01) { origin case_input; }
        assert "f3": deposit_made_on(entity_ref("urn:us:irc:penalties:clir#D1"), @2026-02-04) { origin case_input; }
    }
    evaluate truth(failure_to_deposit_addition(entity_ref("urn:us:irc:penalties:clir#D1"), 20.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S6656-02-TWENTY-DAYS-LATE-TEN-PERCENT-TIER" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; }
        assert "f0": deposit_required_amount(entity_ref("urn:us:irc:penalties:clir#D2"), 1000.00 USD) { origin case_input; }
        assert "f1": deposit_made_amount(entity_ref("urn:us:irc:penalties:clir#D2"), 0.00 USD) { origin case_input; }
        assert "f2": deposit_prescribed_date(entity_ref("urn:us:irc:penalties:clir#D2"), @2026-02-01) { origin case_input; }
        assert "f3": deposit_made_on(entity_ref("urn:us:irc:penalties:clir#D2"), @2026-02-21) { origin case_input; }
    }
    evaluate truth(failure_to_deposit_addition(entity_ref("urn:us:irc:penalties:clir#D2"), 100.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S6656-03-SPECIAL-RULE-FIFTEEN-PERCENT" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; }
        assert "f0": deposit_required_amount(entity_ref("urn:us:irc:penalties:clir#D3"), 1000.00 USD) { origin case_input; }
        assert "f1": deposit_made_amount(entity_ref("urn:us:irc:penalties:clir#D3"), 0.00 USD) { origin case_input; }
        assert "f2": deposit_special_rule_triggered(entity_ref("urn:us:irc:penalties:clir#D3")) { origin case_input; }
    }
    evaluate truth(failure_to_deposit_addition(entity_ref("urn:us:irc:penalties:clir#D3"), 150.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S6656-04-SUPERVISORY-APPROVAL-MISSING-INVALID-EXERCISE" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; }
        assert "f0": penalty_kind_of(entity_ref("urn:us:irc:penalties:clir#PD1"), FailureToDeposit) { origin case_input; }
        assert "f1": secretary_moves_to_assess(entity_ref("urn:us:irc:penalties:clir#PD1")) { origin case_input; }
    }
    evaluate truth(penalty_determination_validly_assessable(entity_ref("urn:us:irc:penalties:clir#PD1")));
    expect truth_status == NEITHER;
}

test "S6656-05-SUPERVISORY-APPROVAL-OBTAINED-VALID-EXERCISE" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; }
        assert "f0": penalty_kind_of(entity_ref("urn:us:irc:penalties:clir#PD2"), FailureToDeposit) { origin case_input; }
        assert "f1": secretary_moves_to_assess(entity_ref("urn:us:irc:penalties:clir#PD2")) { origin case_input; }
        assert "f2": supervisor_approved_in_writing(entity_ref("urn:us:irc:penalties:clir#PD2")) { origin case_input; }
    }
    evaluate truth(penalty_determination_validly_assessable(entity_ref("urn:us:irc:penalties:clir#PD2")));
    expect truth_status == TRUE_ONLY;
}
