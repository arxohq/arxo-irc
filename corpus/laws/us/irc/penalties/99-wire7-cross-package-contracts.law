// Penalties -- WIRE-7 (26.09.2026, DECISION-0379, implemented_unverified).
//
// Each relation below was a local contract (a fact or an underived institutional placeholder naming its owner). The owner package
// publishes the same concept, so the local relation is now DERIVED from the owner's `pub` relation; the case-fact channel stays valid
// (an institutional relation may still be asserted, DECISIONS Д-15/Д-19), so existing scenarios are unchanged. Nothing is restated.

language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

use self::{
    Corporation,
    TaxableYear,
    private_foundation_6655,
};

rule W7PrivateFoundation6655FromExemptOrganizations strict {
    label en official "section 6655(g)(3): a private foundation is the section 509(a) private foundation of the owner package `exempt_organizations`";
    for c: Corporation;
    for y: TaxableYear;
    when us.irc.exempt_organizations::private_foundation(c, y);
    then private_foundation_6655(c, y);
}

