// 26 U.S.C. Chapters 68-70 — shared vocabulary for the penalties package
// (IRC-16 stage 1, DECISION-0379): the calendar-month-or-fraction counter
// used by every addition-to-tax computation in this package, the
// reasonable-cause judgment channel shared by §§6651/6654/6656/6662-6664,
// and the typed dependency-contract relations this package reads but does
// not itself compute (owned by concurrent/pending packages `returns`,
// `payment-refunds-interest`, `assessment`, `income-individual`).
//
// JUDGMENT CALLS AND GAPS (see report):
//  - No stdlib term computes "N calendar months or fraction thereof elapsed
//    since an anchor date" (§34 of SPEC.ru names only `add_calendar_period`,
//    `days_between`, `add_business_days`; none returns a ceiling month
//    count). This package derives it itself as a MONOTONE STRICT RECURSION
//    (`calendar_months_or_fraction_at_least`/`calendar_months_or_fraction`),
//    the same pattern the KZ social-code service-length aggregation package
//    uses for accumulating credited months (SPEC.ru §65's `monotone(P)`
//    edge). This is exact calendar-month arithmetic (delegates every step to
//    `add_calendar_period`, never a 30-day approximation), but it is a
//    NEW, unreviewed use of that recursion pattern for an open-ended count
//    (bounded only by the fact that the step condition eventually fails,
//    not by a fixed cap) — flagged so a differential run can confirm
//    termination and correctness on realistic elapsed periods before this
//    is relied on outside scenarios (`TECH_GAP`-adjacent; see report).
//  - `tax_shown_on_return`, `notice_and_demand_tax_amount`,
//    `amount_paid_toward_tax_by`, `installment_agreement_in_effect_for` and
//    `underpayment_rate_under_6621` are typed dependency contracts, not this
//    package's own facts: the AMOUNT a return SHOWS (as opposed to the
//    amount actually owed, `us.irc.core::liability`) is `returns`' (F01)
//    concept; the notice-and-demand amount is `assessment`'s (F02); the
//    §6621 underpayment rate is `payment-refunds-interest`'s (F03,
//    DEPENDENCIES.json row target_section 6621). None of these packages
//    exist yet (docs/foundations/us-irc/TASKS.json); see
//    coverage/penalties.deps.json for every row.

language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

use self::{
    IRC_S6651_A,
    Notice,
    Person,
    Return,
};

// --- calendar months (or fraction thereof) elapsed since an anchor date -----
// §6651(a)(1)/(a)(2)/(a)(3)/(d)/(f)/(h): "5 percent ... if the failure is for
// not more than 1 month, with an additional 5 percent for each additional
// month or fraction thereof". TECHNICAL LIMITATION (see report): the
// grammar's `add_calendar_period(date, count)` requires `count` to be a
// QUANTITY LITERAL (`quantity_literal = (integer_literal|decimal_literal),
// unit_symbol` — spec/grammar.ebnf:1372); a bound Integer variable multiplied
// by a unit (`n calendar_month` for a rule variable `n`) is rejected
// (LDC-E0201 "между аргументами ожидается `,`", LDC-E2108 "argument 2 —
// Quantity, получен Integer" — reproduced while drafting this module). A
// dynamically-computed "N calendar months from an anchor" step is therefore
// NOT directly expressible for an arbitrary bound N; only a literal boundary
// count is. This package works around the gap with an EXPLICIT boundary
// enumeration up to 12 months (one full year) — each boundary uses a literal
// count, so every one of these facts is exact calendar-month arithmetic, not
// an approximation. A failure that is still below its own percentage cap
// AFTER 12 full months is `calendar_months_exceeds_tracked_horizon` and this
// package cannot state its exact month count — TECH_GAP, minimal
// reproduction: a §6651(a)(2)/(a)(3)/(d)/(h) case with the failure continuing
// more than 12 months and the addition not yet at its own 25% cap (the
// 5%/month failure-to-file addition itself never needs this: its cap is
// reached at month 5, well inside the tracked horizon). Whether the failure
// has reached ITS OWN cap is a SEPARATE, always-exact literal comparison
// (`as_of >= add_calendar_period(anchor, <cap months literal> calendar_month)`)
// declared next to each rate in its own module, unaffected by this gap.

pub relation calendar_months_or_fraction(anchor: Date, as_of: Date, n: Integer) kind institutional {
    label en unofficial "n is the exact number of calendar months or fractions thereof the failure beginning on the anchor date has continued, measured as of the given date (n between 1 and 12; see the tracked-horizon note above for n > 12)";
}

// Every boundary rule below is range-restricted (§190) through this
// established query fact: a per-addition rule asserts
// `months_or_fraction_query(anchor, as_of)` for the pair it needs counted,
// and the boundary rules key off that positive conjunct rather than leaving
// `anchor`/`as_of` free.
pub relation months_or_fraction_query(anchor: Date, as_of: Date) kind institutional {
    label en unofficial "a request, asserted by an addition-specific rule, to count the calendar months or fraction thereof between anchor and as_of";
}

pub relation calendar_months_exceeds_tracked_horizon(anchor: Date, as_of: Date) kind institutional {
    label en unofficial "the failure has continued more than 12 calendar months as of the given date — this package's month-or-fraction enumeration does not reach that far (TECH_GAP, see report)";
}

@source(IRC_S6651_A, relation = formalizes, coverage = contextual, quote = "if the failure is for not more than 1 month")
rule CalendarMonthsOrFraction01 strict {
    for anchor: Date;
    for as_of: Date;
    when months_or_fraction_query(anchor, as_of)
        and as_of > anchor and as_of <= add_calendar_period(anchor, 1 calendar_month);
    then calendar_months_or_fraction(anchor, as_of, 1);
}

@source(IRC_S6651_A, relation = formalizes, coverage = contextual, quote = "an additional 5 percent for each additional month or fraction thereof")
rule CalendarMonthsOrFraction02 strict {
    for anchor: Date;
    for as_of: Date;
    when months_or_fraction_query(anchor, as_of)
        and as_of > add_calendar_period(anchor, 1 calendar_month) and as_of <= add_calendar_period(anchor, 2 calendar_month);
    then calendar_months_or_fraction(anchor, as_of, 2);
}

@source(IRC_S6651_A, relation = formalizes, coverage = contextual, quote = "an additional 5 percent for each additional month or fraction thereof")
rule CalendarMonthsOrFraction03 strict {
    for anchor: Date;
    for as_of: Date;
    when months_or_fraction_query(anchor, as_of)
        and as_of > add_calendar_period(anchor, 2 calendar_month) and as_of <= add_calendar_period(anchor, 3 calendar_month);
    then calendar_months_or_fraction(anchor, as_of, 3);
}

@source(IRC_S6651_A, relation = formalizes, coverage = contextual, quote = "an additional 5 percent for each additional month or fraction thereof")
rule CalendarMonthsOrFraction04 strict {
    for anchor: Date;
    for as_of: Date;
    when months_or_fraction_query(anchor, as_of)
        and as_of > add_calendar_period(anchor, 3 calendar_month) and as_of <= add_calendar_period(anchor, 4 calendar_month);
    then calendar_months_or_fraction(anchor, as_of, 4);
}

@source(IRC_S6651_A, relation = formalizes, coverage = contextual, quote = "an additional 5 percent for each additional month or fraction thereof")
rule CalendarMonthsOrFraction05 strict {
    for anchor: Date;
    for as_of: Date;
    when months_or_fraction_query(anchor, as_of)
        and as_of > add_calendar_period(anchor, 4 calendar_month) and as_of <= add_calendar_period(anchor, 5 calendar_month);
    then calendar_months_or_fraction(anchor, as_of, 5);
}

@source(IRC_S6651_A, relation = formalizes, coverage = contextual, quote = "an additional 5 percent for each additional month or fraction thereof")
rule CalendarMonthsOrFraction06 strict {
    for anchor: Date;
    for as_of: Date;
    when months_or_fraction_query(anchor, as_of)
        and as_of > add_calendar_period(anchor, 5 calendar_month) and as_of <= add_calendar_period(anchor, 6 calendar_month);
    then calendar_months_or_fraction(anchor, as_of, 6);
}

@source(IRC_S6651_A, relation = formalizes, coverage = contextual, quote = "an additional 5 percent for each additional month or fraction thereof")
rule CalendarMonthsOrFraction07 strict {
    for anchor: Date;
    for as_of: Date;
    when months_or_fraction_query(anchor, as_of)
        and as_of > add_calendar_period(anchor, 6 calendar_month) and as_of <= add_calendar_period(anchor, 7 calendar_month);
    then calendar_months_or_fraction(anchor, as_of, 7);
}

@source(IRC_S6651_A, relation = formalizes, coverage = contextual, quote = "an additional 5 percent for each additional month or fraction thereof")
rule CalendarMonthsOrFraction08 strict {
    for anchor: Date;
