    when months_or_fraction_query(anchor, as_of)
        and as_of > add_calendar_period(anchor, 7 calendar_month) and as_of <= add_calendar_period(anchor, 8 calendar_month);
    then calendar_months_or_fraction(anchor, as_of, 8);
}

@source(IRC_S6651_A, relation = formalizes, coverage = contextual, quote = "an additional 5 percent for each additional month or fraction thereof")
rule CalendarMonthsOrFraction09 strict {
