    then calendar_months_or_fraction(anchor, as_of, 9);
}

@source(IRC_S6651_A, relation = formalizes, coverage = contextual, quote = "an additional 5 percent for each additional month or fraction thereof")
rule CalendarMonthsOrFraction10 strict {
    for anchor: Date;
    for as_of: Date;
    when months_or_fraction_query(anchor, as_of)
        and as_of > add_calendar_period(anchor, 9 calendar_month) and as_of <= add_calendar_period(anchor, 10 calendar_month);
    then calendar_months_or_fraction(anchor, as_of, 10);
}

@source(IRC_S6651_A, relation = formalizes, coverage = contextual, quote = "an additional 5 percent for each additional month or fraction thereof")
rule CalendarMonthsOrFraction11 strict {
    for anchor: Date;
    for as_of: Date;
    when months_or_fraction_query(anchor, as_of)
        and as_of > add_calendar_period(anchor, 10 calendar_month) and as_of <= add_calendar_period(anchor, 11 calendar_month);
    then calendar_months_or_fraction(anchor, as_of, 11);
}

@source(IRC_S6651_A, relation = formalizes, coverage = contextual, quote = "an additional 5 percent for each additional month or fraction thereof")
rule CalendarMonthsOrFraction12 strict {
    for anchor: Date;
    for as_of: Date;
    when months_or_fraction_query(anchor, as_of)
        and as_of > add_calendar_period(anchor, 11 calendar_month) and as_of <= add_calendar_period(anchor, 12 calendar_month);
    then calendar_months_or_fraction(anchor, as_of, 12);
}

rule CalendarMonthsExceedsTrackedHorizon strict {
    for anchor: Date;
    for as_of: Date;
    when months_or_fraction_query(anchor, as_of)
        and as_of > add_calendar_period(anchor, 12 calendar_month);
    then calendar_months_exceeds_tracked_horizon(anchor, as_of);
}

// --- reasonable cause / willful neglect (DECISION-0194 evaluative element) --
// §6651(a)(1),(a)(2),(a)(3): "unless it is shown that such failure is due to
// reasonable cause and not due to willful neglect". §6654(e)(3)(B)(ii) uses
// the same pair of terms. This package states ONE shared judgment channel
// (the standard is identical wherever the pinned text uses this phrase) with
// authority Secretary, since reasonable cause under this part is determined
// administratively in the first instance (Treas. Reg. structure), not by a
// court as the KZ criminal-code exemplar's excess-of-defense finding is; a
// taxpayer disputing an adverse administrative finding proceeds to Tax Court
// (a `Proceeding` under `us.irc.core`), which is outside this package's
// stage-1 scope (deficiency procedure, F02/`assessment`).

pub external judgment relation reasonable_cause_and_no_willful_neglect(p: Person, failure_context: FailureContext) {
    authority Secretary;
    label en official "it is shown that such failure is due to reasonable cause and not due to willful neglect";
}

pub entity FailureContext {
    label en unofficial "the identified failure (to file, to pay, to deposit, or an underpayment) the reasonable-cause showing is made with respect to — reified because the same person can have several concurrent failures under different additions in the same taxable year";
}

// --- typed dependency contracts (owners pending; DEPENDENCIES.json rows) ---

// `returns` (F01), pending: the amount of tax the taxpayer actually SHOWED
// on the return, as distinct from `us.irc.core::liability` (the amount
// actually owed under the applicable edition). §6651(b)(1)/(b)(2)/(c)(2) and
// §6664(a)(1)(A) both key off the SHOWN amount specifically.
pub relation tax_shown_on_return(r: Return, amount: Money) kind institutional {
    label en unofficial "PENDING (owner: returns, F01) — the amount of tax the taxpayer showed as due on the return itself";
}

// `assessment` (F02), pending: the amount of tax stated in a notice and
// demand under §6303, distinct from `us.irc.core::assessment_of`'s amount
// because a notice and demand can restate less than the full assessment
// (partial payments already credited).
pub relation notice_and_demand_tax_amount(n: Notice, amount: Money) kind institutional {
    label en unofficial "PENDING (owner: assessment, F02) — the amount of tax stated in a notice and demand under section 6303";
}

// `payment-refunds-interest` (F03), pending: DEPENDENCIES.json already
// tracks §6621 as pending for this package's §6654 underpayment-rate need.
pub relation underpayment_rate_under_6621(as_of: Date, rate: Decimal) kind institutional {
    label en unofficial "PENDING (owner: payment-refunds-interest, F03) — the section 6621 underpayment rate applicable on the given date";
}

// `collection` (F04), pending: §6159 installment agreements are that
// package's own norm; §6651(h) needs only whether one is in effect for a
// given month.
pub relation installment_agreement_in_effect_for(p: Person, month_start: Date) kind institutional {
    label en unofficial "PENDING (owner: collection, F04) — a section 6159 installment agreement for the payment of the tax is in effect during the month beginning on this date";
}

// `returns`/`payment-refunds-interest`, pending: total payments toward a
// return's tax applied on or before a cutoff date (used by §6651(b)'s
// netting of the addition base against early payments; see the §6651
// module's header note on the due-date-only simplification).
pub relation amount_paid_on_or_before(r: Return, cutoff: Date, amount: Money) kind institutional {
    label en unofficial "PENDING (owner: returns / payment-refunds-interest) — total payments toward this return's tax applied on or before the cutoff date";
}

