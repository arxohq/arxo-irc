// Penalties -- stage 4 (26.09.2026, DECISION-0379, implemented_unverified): section 6662(e)(3)(D), the reasonable-cause
// requirement for the portion of an underpayment attributable to a net section 482 transfer price adjustment (stage 3 had
// left it as TECH-GAPS G5550 because the section 6664(c) defense relation is keyed by taxpayer, year and kind).
//
// METHOD. A portion-keyed defense relation is added beside the (taxpayer, year, kind) one: a portion of an underpayment is
// identified by an id within the taxpayer, year and kind; the portion is linked to the transfer price transaction it
// arises from (so that the per-transaction requirement of module 33 can be read) and to the net section 482 adjustment.
// The existing reasonable_cause_defense_available is unchanged. The judgment of reasonable cause and good faith stays the
// external judgment of module 06 (DECISION-0194).

language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

use self::{
    FailureContext,
    IRC_S6662_E,
    IRC_S6664_C,
    Person,
    TaxKind,
    TaxableYear,
    TransferPriceTransaction,
    charitable_valuation_defense_barred_6664c3,
    reasonable_cause_and_good_faith,
    reasonable_cause_requirement_met_for_482_portion,
    underpayment_attributable_to_economic_substance_or_foreign_asset,
};

pub relation underpayment_portion_6664c(p: Person, y: TaxableYear, kind: TaxKind, portion_id: Integer, amount: Money) kind empirical {
    label en official "section 6664(c)(1): a portion of an underpayment (with the id of the portion within the taxpayer, year and kind)";
}
pub relation portion_attributable_to_net_482_adjustment_6662e3D(p: Person, y: TaxableYear, kind: TaxKind, portion_id: Integer) kind empirical {
    label en official "section 6662(e)(3)(D): the portion of the underpayment is attributable to a net section 482 transfer price adjustment";
}
pub relation portion_arises_from_transfer_price_transaction_6662e3D(p: Person, y: TaxableYear, kind: TaxKind, portion_id: Integer, t: TransferPriceTransaction) kind empirical {
    label en official "section 6662(e)(3)(D): the transfer price transaction to which the portion is attributable";
}
pub relation reasonable_cause_defense_available_for_portion_6664c(p: Person, y: TaxableYear, kind: TaxKind, portion_id: Integer, failure_context: FailureContext) kind institutional {
    label en official "section 6664(c)(1): the reasonable-cause-and-good-faith defense is available for THIS portion of the underpayment: for a portion attributable to a net section 482 adjustment only if the requirements of section 6662(e)(3)(B)(i), (ii) or (iii) are met with respect to the portion";
}
@source(IRC_S6664_C, quote = "No penalty shall be imposed under section 6662 or 6663 with respect to any portion of an underpayment if it is shown that there was a reasonable cause for such portion and that the taxpayer acted in good faith with respect to such portion.")
rule ReasonableCauseDefenseForOrdinaryPortion(p: Person, y: TaxableYear, kind: TaxKind, portion_id: Integer, amount: Money, fc: FailureContext) defeasible {
    label en official "section 6664(c)(1) for a portion not attributable to a net section 482 adjustment (the exceptions of (c)(2), (c)(3) read on the taxpayer, year and kind as in the older rule)";
    when reasonable_cause_and_good_faith(p, fc);
    when underpayment_portion_6664c(p, y, kind, portion_id, amount);
    unless portion_attributable_to_net_482_adjustment_6662e3D(p, y, kind, portion_id) and reasonable_cause_and_good_faith(p, fc) and underpayment_portion_6664c(p, y, kind, portion_id, amount);
    unless underpayment_attributable_to_economic_substance_or_foreign_asset(p, y, kind) and reasonable_cause_and_good_faith(p, fc) and underpayment_portion_6664c(p, y, kind, portion_id, amount);
    unless charitable_valuation_defense_barred_6664c3(p, y, kind) and reasonable_cause_and_good_faith(p, fc) and underpayment_portion_6664c(p, y, kind, portion_id, amount);
    then reasonable_cause_defense_available_for_portion_6664c(p, y, kind, portion_id, fc);
}
@source(IRC_S6662_E, quote = "For purposes of section 6664(c) the taxpayer shall not be treated as having reasonable cause for any portion of an underpayment attributable to a net section 482 transfer price adjustment unless such taxpayer meets the requirements of clause (i), (ii), or (iii) of subparagraph (B) with respect to such portion.")
rule ReasonableCauseDefenseFor482PortionWhenRequirementsMet(p: Person, y: TaxableYear, kind: TaxKind, portion_id: Integer, amount: Money, fc: FailureContext, t: TransferPriceTransaction) defeasible {
    label en official "section 6662(e)(3)(D): a section 482 portion keeps the defense only when the requirement of (B) is met for the transaction of the portion";
    when reasonable_cause_and_good_faith(p, fc);
    when underpayment_portion_6664c(p, y, kind, portion_id, amount);
    when portion_attributable_to_net_482_adjustment_6662e3D(p, y, kind, portion_id);
    when portion_arises_from_transfer_price_transaction_6662e3D(p, y, kind, portion_id, t);
    when reasonable_cause_requirement_met_for_482_portion(t);
    unless underpayment_attributable_to_economic_substance_or_foreign_asset(p, y, kind) and reasonable_cause_and_good_faith(p, fc) and underpayment_portion_6664c(p, y, kind, portion_id, amount) and portion_attributable_to_net_482_adjustment_6662e3D(p, y, kind, portion_id) and portion_arises_from_transfer_price_transaction_6662e3D(p, y, kind, portion_id, t) and reasonable_cause_requirement_met_for_482_portion(t);
    unless charitable_valuation_defense_barred_6664c3(p, y, kind) and reasonable_cause_and_good_faith(p, fc) and underpayment_portion_6664c(p, y, kind, portion_id, amount) and portion_attributable_to_net_482_adjustment_6662e3D(p, y, kind, portion_id) and portion_arises_from_transfer_price_transaction_6662e3D(p, y, kind, portion_id, t) and reasonable_cause_requirement_met_for_482_portion(t);
    then reasonable_cause_defense_available_for_portion_6664c(p, y, kind, portion_id, fc);
}
