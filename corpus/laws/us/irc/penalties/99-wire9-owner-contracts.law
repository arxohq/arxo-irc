// Penalties -- WIRE-9 (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// The local placeholder for the section 31 credit is derived from the credits package, which owns section 31 (the row named the
// payment-refunds-interest package as owner; the credit itself is `us.irc.credits::wage_withholding_credit`). The case-fact channel stays
// valid: a case may still assert the placeholder directly.

language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

use self::{
    Person,
    TaxableYear,
    section31_withholding_credit,
};

rule W9Section31WithholdingCreditFromOwner(p: Person, y: TaxableYear, amount: Money) strict {
    label en official "the credit allowable under section 31 (tax withheld on wages) is the amount the credits package computes";
    when us.irc.credits::wage_withholding_credit(p, y, amount);
    then section31_withholding_credit(p, y, amount);
}
