language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

use self::{
    IRC_S6801_A,
    IRC_S6801_B,
    IRC_S6802,
    IRC_S6803_A,
    IRC_S6803_B,
    IRC_S6804,
    IRC_S6805_A,
    IRC_S6805_B,
    IRC_S6805_C,
    IRC_S6805_D,
    IRC_S6806,
    IRC_S6807,
    Secretary,
};

// 26 U.S.C. §§6801-6808 — Chapter 69, general provisions relating to stamps:
// authority to establish stamps, their supply and distribution, bonds,
// attachment and cancellation, redemption, occupational tax stamps, seized
// goods and cross-references (IRC-16 stage 2, DECISION-0379).
//
// MODEL. A stamp matter is an occurrence of `StampMatter`. The Secretary's "may"
// provisions are powers whose valid_when is the statutory condition; the "shall"
// provisions are duties (achievement goals) of the Secretary or of the special
// taxpayer. Rulemaking authorities (§6803(b), §6804) are powers whose effect is
// the existence of the prescribed manner; the content of the regulations is not
// in the text and is not modelled.
//
// JUDGMENT CALLS AND GAPS:
//  - "satisfactory evidence" / "satisfactory proof" of §6805 are the Secretary's
//    own institutional findings (case facts), like the jeopardy findings of
//    module 15, not DECISION-0194 channels: the text delegates the matter to
//    the Secretary and no court standard is named.
//  - §6805(b)'s percentage "allowed to the purchaser" is a case amount
//    (`purchaser_discount_amount`): the percentage is not stated in the text.
//  - The postal classes of §6802(1) are case facts about the post office.

pub entity StampMatter {
    label en unofficial "a matter concerning stamps, coupons, tickets or other devices denoting payment of internal revenue taxes (a stamp form, a post office, a depositary, a claim for redemption, a special-tax stamp, a seized article)";
}

// --- §6801: authorization ---------------------------------------------------------------------
relation stamp_under_internal_revenue_law(s: StampMatter) kind empirical {
    label en official "a stamp, mark, or label under any provision of the laws relating to internal revenue";
}
relation secretary_moves_to_establish_or_change_stamp_form(s: StampMatter) kind empirical {
    label en unofficial "the Secretary has moved to establish, alter, renew, replace, or change the form, style, character, material, and device of the stamp (exercise fact)";
}
pub relation stamp_form_established_or_changed(s: StampMatter) kind institutional {
    label en unofficial "the form, style, character, material, and device of the stamp has been established or changed by the Secretary";
}
@source(IRC_S6801_A, relation = formalizes, coverage = exact, quote = "The Secretary may establish, and from time to time alter, renew, replace, or change the form, style, character, material, and device of any stamp, mark, or label under any provision of the laws relating to internal revenue")
rule S6801aStampFormPower strict {
    for s: StampMatter;
    when secretary_moves_to_establish_or_change_stamp_form(s);
    then power SecretaryEstablishOrChangeStampForm {
        holder Secretary;
        over s;
        exercise secretary_moves_to_establish_or_change_stamp_form(s);
        valid_when stamp_under_internal_revenue_law(s);
        effect create(stamp_form_established_or_changed(s));
        window [-infinity, infinity];
    };
}
relation instructions_forms_and_stamps_prepared_and_distributed(s: StampMatter) kind empirical {
    label en official "the Secretary has prepared and distributed all the instructions, regulations, directions, forms, blanks, and stamps";
}
relation sufficient_adhesive_stamps_and_dies_provided(s: StampMatter) kind empirical {
    label en official "the Secretary has provided proper and sufficient adhesive stamps and other stamps or dies for expressing and denoting the several stamp taxes";
}
relation stamp_administration_matter(s: StampMatter) kind empirical {
    label en unofficial "the matter is one of the Secretary's stamp administration under section 6801(b)";
}
@source(IRC_S6801_B, relation = formalizes, coverage = exact, quote = "The Secretary shall prepare and distribute all the instructions, regulations, directions, forms, blanks, and stamps")
rule S6801bPrepareAndDistributeDuty strict {
    for s: StampMatter;
    when stamp_administration_matter(s);
    then duty SecretaryPrepareAndDistributeStampInstructions {
        bearer Secretary;
        goal achievement {
            condition instructions_forms_and_stamps_prepared_and_distributed(s);
            window [-infinity, infinity];
        };
    };
}
@source(IRC_S6801_B, relation = formalizes, coverage = exact, quote = "shall provide proper and sufficient adhesive stamps and other stamps or dies for expressing and denoting the several stamp taxes")
rule S6801bProvideStampsDuty strict {
    for s: StampMatter;
    when stamp_administration_matter(s);
    then duty SecretaryProvideSufficientStamps {
        bearer Secretary;
        goal achievement {
            condition sufficient_adhesive_stamps_and_dies_provided(s);
            window [-infinity, infinity];
        };
    };
}

// --- §6802: supply and distribution ------------------------------------------------------------
relation post_office_of_first_or_second_class(s: StampMatter) kind empirical {
    label en official "the post office is of the first or second class";
}
relation post_office_of_third_or_fourth_class_in_county_seat(s: StampMatter) kind empirical {
    label en official "the post office is of the third or fourth class and is located in a county seat";
}
relation post_office_of_third_or_fourth_class_certified_necessary(s: StampMatter) kind empirical {
    label en official "the post office is of the third or fourth class and is certified by the Secretary to the Postmaster General as necessary";
}
pub relation post_office_entitled_to_stamps_on_sale(s: StampMatter) kind institutional {
    label en unofficial "the post office is one at which stamps, coupons, tickets, or other devices are to be distributed to and kept on sale by the postmaster";
}
@source(IRC_S6802, relation = formalizes, coverage = exact, quote = "the various postmasters in the United States in all post offices of the first and second classes")
rule S6802a1FirstSecondClass strict {
    for s: StampMatter;
    when post_office_of_first_or_second_class(s);
    then post_office_entitled_to_stamps_on_sale(s);
}
@source(IRC_S6802, relation = formalizes, coverage = exact, quote = "are located in county seats, or")
rule S6802a1CountySeat strict {
    for s: StampMatter;
    when post_office_of_third_or_fourth_class_in_county_seat(s);
    then post_office_entitled_to_stamps_on_sale(s);
}
@source(IRC_S6802, relation = formalizes, coverage = exact, quote = "are certified by the Secretary to the Postmaster General as necessary;")
rule S6802a1Certified strict {
    for s: StampMatter;
    when post_office_of_third_or_fourth_class_certified_necessary(s);
    then post_office_entitled_to_stamps_on_sale(s);
}
relation suitable_quantity_furnished_without_prepayment(s: StampMatter) kind empirical {
    label en official "a suitable quantity of adhesive stamps, coupons, tickets, or other devices has been furnished without prepayment";
}
@source(IRC_S6802, relation = formalizes, coverage = partial, quote = "The Secretary shall furnish, without prepayment, to—")
rule S6802a1PostmasterGeneralDuty defeasible {
    for s: StampMatter;
    when post_office_entitled_to_stamps_on_sale(s);
    then duty SecretaryFurnishStampsToPostmasterGeneral {
        bearer Secretary;
        goal achievement {
            condition suitable_quantity_furnished_without_prepayment(s);
            window [-infinity, infinity];
        };
    };
}
relation designated_depositary_of_united_states(s: StampMatter) kind empirical {
    label en official "the matter concerns a designated depositary of the United States";
}
@source(IRC_S6802, relation = formalizes, coverage = exact, quote = "Any designated depositary of the United States a suitable quantity of adhesive stamps to be kept on sale by such designated depositary")
rule S6802a2DepositaryDuty strict {
    for s: StampMatter;
    when designated_depositary_of_united_states(s);
    then duty SecretaryFurnishStampsToDepositary {
        bearer Secretary;
        goal achievement {
            condition suitable_quantity_furnished_without_prepayment(s);
            window [-infinity, infinity];
        };
    };
}

// --- §6803: accounting and safeguarding --------------------------------------------------------
relation secretary_moves_to_require_depositary_bond(s: StampMatter) kind empirical {
    label en unofficial "the Secretary has moved to require a bond, with sufficient sureties, in a sum to be fixed by the Secretary";
}
pub relation depositary_bond_required(s: StampMatter) kind institutional {
    label en unofficial "a bond is required of the designated depositary, conditioned for the faithful return of all quantities or amounts undisposed of and for the payment monthly for all quantities or amounts sold or not remaining on hand";
}
@source(IRC_S6803_A, relation = formalizes, coverage = exact, quote = "the Secretary may require a bond, with sufficient sureties, in a sum to be fixed by the Secretary")
rule S6803aBondPower strict {
    for s: StampMatter;
    when secretary_moves_to_require_depositary_bond(s);
    then power SecretaryRequireDepositaryBond {
        holder Secretary;
        over s;
        exercise secretary_moves_to_require_depositary_bond(s);
        valid_when designated_depositary_of_united_states(s);
        effect create(depositary_bond_required(s));
        window [-infinity, infinity];
    };
}
relation secretary_moves_to_prescribe_stamp_safekeeping_regulations(s: StampMatter) kind empirical {
    label en unofficial "the Secretary has moved to make regulations necessary to insure the safekeeping or prevent the illegal use of the adhesive stamps (exercise fact)";
}
pub relation stamp_safekeeping_regulations_prescribed(s: StampMatter) kind institutional {
    label en unofficial "regulations to insure the safekeeping or prevent the illegal use of the adhesive stamps have been prescribed";
}
@source(IRC_S6803_B, relation = formalizes, coverage = exact, quote = "The Secretary may from time to time make such regulations as he may find necessary to insure the safekeeping or prevent the illegal use of all adhesive stamps")
rule S6803bRegulationsPower strict {
    for s: StampMatter;
    when secretary_moves_to_prescribe_stamp_safekeeping_regulations(s);
    then power SecretaryPrescribeStampSafekeepingRegulations {
        holder Secretary;
        over s;
        exercise secretary_moves_to_prescribe_stamp_safekeeping_regulations(s);
        valid_when designated_depositary_of_united_states(s);
        effect create(stamp_safekeeping_regulations_prescribed(s));
        window [-infinity, infinity];
    };
}

// --- §6804: attachment and cancellation -----------------------------------------------------------
relation stamp_referred_to_in_6801(s: StampMatter) kind empirical {
    label en official "the stamp is one referred to in section 6801";
}
relation title_expressly_provides_otherwise_for_stamp(s: StampMatter) kind empirical {
    label en official "this title otherwise expressly provides for the attachment, protection, removal, cancellation, obliteration, or destruction of the stamp";
}
relation secretary_moves_to_prescribe_manner_of_stamp_attachment_and_cancellation(s: StampMatter) kind empirical {
    label en unofficial "the Secretary has moved to prescribe by rules or regulations the manner and instruments (exercise fact)";
}
pub relation manner_of_stamp_attachment_and_cancellation_prescribed(s: StampMatter) kind institutional {
    label en unofficial "the manner and instruments by which the stamps are attached, protected, removed, canceled, obliterated, and destroyed have been prescribed by the Secretary";
}
@source(IRC_S6804, relation = formalizes, coverage = exact, quote = "in such manner and by such instruments or other means as the Secretary may prescribe by rules or regulations")
rule S6804MannerPower strict {
    for s: StampMatter;
    when secretary_moves_to_prescribe_manner_of_stamp_attachment_and_cancellation(s);
    then power SecretaryPrescribeStampAttachmentAndCancellation {
        holder Secretary;
        over s;
        exercise secretary_moves_to_prescribe_manner_of_stamp_attachment_and_cancellation(s);
        valid_when stamp_referred_to_in_6801(s);
        effect create(manner_of_stamp_attachment_and_cancellation_prescribed(s));
        window [-infinity, infinity];
    };
}

// --- §6805: redemption of stamps -------------------------------------------------------------------
relation stamps_spoiled_destroyed_useless_unfit_or_unneeded(s: StampMatter) kind empirical {
    label en official "the stamps issued under authority of an internal revenue law have been spoiled, destroyed, or rendered useless or unfit for the purpose intended, or the owner may have no use for them";
}
relation satisfactory_evidence_of_the_facts_received(s: StampMatter) kind empirical {
    label en official "the Secretary has received satisfactory evidence of the facts";
}
relation redemption_allowance_conditions_6805a(s: StampMatter) kind institutional {
    label en unofficial "the section 6805(a) conditions are met: qualifying stamps and satisfactory evidence of the facts (single atom for the power valid_when)";
}
@source(IRC_S6805_A, relation = formalizes, coverage = exact, quote = "upon receipt of satisfactory evidence of the facts")
rule S6805aConditions strict {
    for s: StampMatter;
    when stamps_spoiled_destroyed_useless_unfit_or_unneeded(s)
        and satisfactory_evidence_of_the_facts_received(s);
    then redemption_allowance_conditions_6805a(s);
}
relation stamps_returned_or_satisfactory_proof_why_not_returned(s: StampMatter) kind empirical {
    label en official "the spoiled or useless stamps have been returned to the Secretary, or satisfactory proof has been made showing the reason why they cannot be returned";
}
relation history_of_stamps_cannot_be_satisfactorily_traced_when_required(s: StampMatter) kind empirical {
    label en official "the Secretary requires it and the person presenting the stamps cannot satisfactorily trace their history from issuance to presentation of the claim";
}
relation claim_presented_on(s: StampMatter, d: Date) kind empirical {
    label en unofficial "the day the claim for redemption or allowance was presented";
}
relation stamps_purchased_from_government_on(s: StampMatter, d: Date) kind empirical {
    label en unofficial "the day the stamps were purchased from the Government";
}
pub relation redemption_claim_presented_within_three_years(s: StampMatter) kind institutional {
    label en unofficial "the claim was presented within 3 years after the purchase of the stamps from the Government";
}
@source(IRC_S6805_C, relation = formalizes, coverage = exact, quote = "No claim for the redemption of, or allowance for, stamps shall be allowed under this section unless presented within 3 years after the purchase of such stamps from the Government")
rule S6805cTimely strict {
    for s: StampMatter;
    for c: Date;
    for b: Date;
    when claim_presented_on(s, c)
        and stamps_purchased_from_government_on(s, b)
        and c <= add_calendar_period(b, 36 calendar_month);
    then redemption_claim_presented_within_three_years(s);
}
relation redemption_returned_or_proved_6805b(s: StampMatter) kind institutional {
    label en unofficial "the stamps have been returned or satisfactory proof shows why they cannot be returned";
}
@source(IRC_S6805_B, relation = formalizes, coverage = exact, quote = "no allowance or redemption shall be made in any case until the stamps so spoiled or rendered useless shall have been returned to the Secretary, or until satisfactory proof has been made showing the reason why the same cannot be returned")
rule S6805bReturnedOrProved strict {
    for s: StampMatter;
    when stamps_returned_or_satisfactory_proof_why_not_returned(s);
    then redemption_returned_or_proved_6805b(s);
}
pub relation redemption_allowable_6805(s: StampMatter) kind institutional {
    label en unofficial "the allowance or redemption may be made: qualifying stamps, satisfactory evidence, claim within 3 years, stamps returned or proof made, and no unsatisfied history-tracing requirement";
}
@source(IRC_S6805_A, relation = formalizes, coverage = exact, quote = "make allowance for or redeem such of the stamps, issued under authority of any internal revenue law")
rule S6805Allowable defeasible {
    for s: StampMatter;
    when redemption_allowance_conditions_6805a(s)
        and redemption_claim_presented_within_three_years(s)
        and redemption_returned_or_proved_6805b(s);
    then redemption_allowable_6805(s);
    unless history_of_stamps_cannot_be_satisfactorily_traced_when_required(s)
        and redemption_allowance_conditions_6805a(s)
        and redemption_claim_presented_within_three_years(s)
        and redemption_returned_or_proved_6805b(s);
}
relation secretary_moves_to_make_allowance_or_redeem(s: StampMatter) kind empirical {
    label en unofficial "the Secretary has moved to make the allowance or redeem the stamps (exercise fact)";
}
pub relation stamps_allowed_for_or_redeemed(s: StampMatter) kind institutional {
    label en unofficial "the stamps have been allowed for or redeemed";
}
@source(IRC_S6805_A, relation = formalizes, coverage = exact, quote = "The Secretary, subject to regulations prescribed by him, may, upon receipt of satisfactory evidence of the facts, make allowance for or redeem such of the stamps")
rule S6805aRedemptionPower strict {
    for s: StampMatter;
    when secretary_moves_to_make_allowance_or_redeem(s);
    then power SecretaryAllowOrRedeemStamps {
        holder Secretary;
        over s;
        exercise secretary_moves_to_make_allowance_or_redeem(s);
        valid_when redemption_allowable_6805(s);
        effect create(stamps_allowed_for_or_redeemed(s));
        window [-infinity, infinity];
    };
}
relation purchaser_discount_amount(s: StampMatter, amount: Money) kind empirical {
    label en official "the percentage, if any, allowed to the purchaser of the stamps, as an amount to be deducted on repayment (case fact: the text names no percentage)";
}
relation stamp_value_to_be_refunded(s: StampMatter, amount: Money) kind empirical {
    label en official "the amount or value of the stamps to be refunded to the owner";
}
pub relation stamp_refund_amount_6805b(s: StampMatter, amount: Money) kind institutional {
    label en unofficial "the refund on redemption: the amount or value of the stamps less the percentage, if any, allowed to the purchaser";
}
@source(IRC_S6805_B, relation = formalizes, coverage = partial, quote = "by refunding the amount or value to the owner thereof, deducting therefrom, in case of repayment, the percentage, if any, allowed to the purchaser thereof")
rule S6805bRefundAmount defeasible {
    for s: StampMatter;
    for v: Money;
    for d: Money;
    when stamps_allowed_for_or_redeemed(s)
        and stamp_value_to_be_refunded(s, v)
        and purchaser_discount_amount(s, d);
    then stamp_refund_amount_6805b(s, max(0.00 USD, v - d));
}
relation allowance_or_redemption_made(s: StampMatter) kind empirical {
    label en unofficial "an allowance or redemption is made";
}
relation stamps_not_returned_and_no_satisfactory_proof(s: StampMatter) kind empirical {
    label en unofficial "the stamps have not been returned to the Secretary and no satisfactory proof has been made of why they cannot be returned";
}
@source(IRC_S6805_B, relation = formalizes, coverage = exact, quote = "no allowance or redemption shall be made in any case until the stamps so spoiled or rendered useless shall have been returned to the Secretary")
rule S6805bNoAllowanceBeforeReturn strict {
    for s: StampMatter;
    when stamps_not_returned_and_no_satisfactory_proof(s);
    then prohibition SecretaryMayNotAllowBeforeReturn {
        bearer Secretary;
        action allowance_or_redemption_made(s);
        window [-infinity, infinity];
    };
}
relation fraud_or_mistake_in_mathematical_calculation(s: StampMatter) kind empirical {
    label en official "there is fraud or mistake in mathematical calculation in the findings or decision";
}
relation secretary_decision_on_merits_of_claim(s: StampMatter) kind empirical {
    label en official "the Secretary has decided the merits of a claim presented under or authorized by section 6805";
}
pub relation secretary_decision_final_and_not_revisable(s: StampMatter) kind institutional {
    label en unofficial "the findings of fact and the decision of the Secretary are final and not subject to revision by any accounting officer";
}
@source(IRC_S6805_D, relation = formalizes, coverage = exact, quote = "shall, in the absence of fraud or mistake in mathematical calculation, be final and not subject to revision by any accounting officer")
rule S6805dFinality defeasible {
    for s: StampMatter;
    when secretary_decision_on_merits_of_claim(s);
    then secretary_decision_final_and_not_revisable(s);
    unless fraud_or_mistake_in_mathematical_calculation(s)
        and secretary_decision_on_merits_of_claim(s);
}

// --- §6806: occupational tax stamps -------------------------------------------------------------------
relation engaged_in_business_avocation_or_employment_liable_to_special_tax(s: StampMatter) kind empirical {
    label en official "a person engaged in any business, avocation, or employment is thereby made liable to a special tax";
}
relation special_tax_is_under_excluded_subchapter_or_subtitle_e(s: StampMatter) kind empirical {
    label en official "the special tax is under subchapter B of chapter 35, under subchapter B of chapter 36, or under subtitle E";
}
relation special_tax_stamps_kept_conspicuously(s: StampMatter) kind empirical {
    label en official "all stamps denoting payment of such special tax are placed and kept conspicuously in the person's establishment or place of business";
}
@source(IRC_S6806, relation = formalizes, coverage = exact, quote = "shall place and keep conspicuously in his establishment or place of business all stamps denoting payment of such special tax")
rule S6806DisplayDuty strict {
    for s: StampMatter;
    when engaged_in_business_avocation_or_employment_liable_to_special_tax(s)
        and not_known(special_tax_is_under_excluded_subchapter_or_subtitle_e(s));
    then duty DisplaySpecialTaxStampsConspicuously {
        bearer s;
        goal maintenance {
            condition special_tax_stamps_kept_conspicuously(s);
            window [-infinity, infinity];
        };
    };
}

// --- §6807: stamping, marking, and branding seized goods ---------------------------------------------
relation article_requiring_marks_sold_on_levy_forfeiture_or_process_unmarked(s: StampMatter) kind empirical {
    label en official "an article of manufacture or produce requiring brands, stamps, or marks of whatever kind to be placed thereon is sold upon levy, forfeiture, or other process provided by law, not having been branded, stamped, or marked as required by law";
}
relation article_is_distilled_spirits_covered_by_5688(s: StampMatter) kind empirical {
    label en official "the article is distilled spirits as to which section 5688 provides otherwise";
}
relation brands_stamps_or_marks_affixed_on_sale(s: StampMatter) kind empirical {
    label en official "the officer selling the article has fixed or caused to be affixed the brands, stamps, or marks so required";
}
@source(IRC_S6807, relation = formalizes, coverage = exact, quote = "the officer selling the same shall, upon sale thereof, fix or cause to be affixed the brands, stamps, or marks so required")
rule S6807SellingOfficerDuty strict {
    for s: StampMatter;
    when article_requiring_marks_sold_on_levy_forfeiture_or_process_unmarked(s)
        and not_known(article_is_distilled_spirits_covered_by_5688(s));
    then duty OfficerAffixRequiredMarksOnSale {
        bearer Secretary;
        goal achievement {
            condition brands_stamps_or_marks_affixed_on_sale(s);
            window [-infinity, infinity];
        };
    };
}
