// Penalties -- final TECH_GAP pass (26.09.2026, DECISION-0379, implemented_unverified): section 6708(a)(1) (G6888), "within 20
// business days after the date of such request".
//
// TECHNIQUE (the pattern of the Fannie Mae package `us.fnma.selling_income`): the deadline is `add_business_days(request, 20
// business_day, "23:59:59")` under a package deadline policy (the count starts the day after the request, the last day is
// included). The business-day calendar of section 85 is NOT carried by the package: a scenario or a consumer world supplies the
// calendar snapshot (`us.code.clir.federal_calendar`, derived from 5 U.S.C. 6103, in the `concat` of the test family), and
// without it the date is not computed (MISSING_CALENDAR), never taken from a default calendar. The days of failure after
// the 20th day are `days_between(20th day, date the list is made available)`.
// JUDGMENT CALL: the day on which the list is made available counts as a day of failure (the list was not available at the
// close of the 20th day); the asserted `days_after_twentieth_business_day` of module 20 stays as the channel used when the
// request and the answer dates are not supplied.

language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

use self::{
    FailureContext,
    IRC_S6708_A,
    days_after_twentieth_business_day,
};

pub deadline policy IRC_BUSINESS_DAY_COUNT {
    start_count next_day;
    include_end true;
    roll next_working_day;
}

pub relation list_request_date_6708(f: FailureContext, on: Date) kind empirical {
    label en official "the date of the written request of the Secretary that the list under section 6112(a) be made available (section 6708(a)(1))";
}
pub relation list_made_available_on_6708(f: FailureContext, on: Date) kind empirical {
    label en official "the date on which the list was made available to the Secretary";
}
pub relation twentieth_business_day_after_list_request_6708(f: FailureContext, due: Date) kind institutional {
    label en official "the 20th business day after the date of the request (section 6708(a)(1)), by the federal business-day calendar of the world";
}
@source(IRC_S6708_A, relation = formalizes, coverage = exact, quote = "within 20 business days after the date of such request")
rule TwentiethBusinessDayAfterListRequest(f: FailureContext, request: Date) defeasible {
    label en official "add_business_days(request, 20 business_day)";
    when list_request_date_6708(f, request);
    then twentieth_business_day_after_list_request_6708(f, add_business_days(request, 20 business_day, "23:59:59"));
}
pub relation days_after_twentieth_business_day_computed(f: FailureContext, n: Integer) kind institutional {
    label en official "the days of failure after the 20th day: the days between the 20th business day and the day the list is made available (JUDGMENT CALL: the day of provision counts)";
}
@source(IRC_S6708_A, relation = formalizes, coverage = exact, quote = "for each day of such failure after such 20th day")
rule DaysAfterTwentiethBusinessDayComputed(f: FailureContext, due: Date, made: Date) defeasible {
    label en official "days_between(20th business day, date made available), when the list is made available after the 20th day";
    when twentieth_business_day_after_list_request_6708(f, due);
    when list_made_available_on_6708(f, made);
    when made > due;
    then days_after_twentieth_business_day_computed(f, days_between(due, made));
}
rule DaysAfterTwentiethBusinessDayNone(f: FailureContext, due: Date, made: Date) defeasible {
    label en official "the list is made available by the 20th day: no day of failure";
    when twentieth_business_day_after_list_request_6708(f, due);
    when list_made_available_on_6708(f, made);
    when made <= due;
    then days_after_twentieth_business_day_computed(f, 0);
}
relation has_computed_days_after_twentieth_6708(f: FailureContext) kind institutional {
    label en official "bridge for the absence test";
}
rule HasComputedDaysAfterTwentieth6708(f: FailureContext, n: Integer) defeasible {
    label en official "bridge for the absence test";
    when days_after_twentieth_business_day_computed(f, n);
    then has_computed_days_after_twentieth_6708(f);
}
pub relation days_after_twentieth_business_day_for_penalty(f: FailureContext, n: Integer) kind institutional {
    label en official "the days of failure after the 20th day that the section 6708 penalty reads: the computed number where the dates are supplied and the calendar is in the world, else the asserted number";
}
rule DaysForPenaltyComputed(f: FailureContext, n: Integer) defeasible {
    label en official "the computed number of days";
    when days_after_twentieth_business_day_computed(f, n);
    then days_after_twentieth_business_day_for_penalty(f, n);
}
rule DaysForPenaltyAsserted(f: FailureContext, n: Integer) defeasible {
    label en official "the asserted number of days (the earlier channel)";
    when days_after_twentieth_business_day(f, n);
    when not_known(has_computed_days_after_twentieth_6708(f));
    then days_after_twentieth_business_day_for_penalty(f, n);
}
