// 26 U.S.C. §6751 — Procedural requirements: the notice-content duty (a) and
// the written-supervisory-approval VALIDITY CONDITION on assessing a penalty
// (b), with its own exceptions (b)(2). Written first among the addition
// modules because §§6656/6662/6663 reference `penalty_assessment_condition_met`
// as the `valid_when` of their own assessment power; §§6651/6654/6655 do NOT
// (they are (b)(2)(A) exceptions) and so never reference this module.
//
// JUDGMENT CALLS AND GAPS (see report):
//  - "the individual making such determination" and "immediate supervisor"
//    are not reified as distinct `Person`/`Organ` instances with a reporting
//    edge between them; `supervisor_approved_in_writing(d)` is a single
//    empirical fact keyed by the determination, matching the scenario need
//    (was written approval obtained, yes/no) without modelling the IRS
//    reporting hierarchy this package has no other use for.
//  - (b)(2)(A)'s "only with respect to an addition to tax by reason of
//    paragraph (9) or (10) of subsection (b) thereof" (i.e. only SOME
//    §6662(b) grounds are exempt) is modelled as a per-kind exemption
//    predicate (`exempt_from_supervisory_approval`) that the §6662 module
//    asserts conditionally per ground, rather than a single boolean on the
//    whole `AccuracyRelated` kind — see 05-accuracy-related-penalty-6662.law.
//  - (a)'s notice-content duty is modelled as an ordinary `duty` of the
//    Secretary with an achievement goal on the `Notice` of the penalty
//    itself; this package does not reify "information with respect to the
//    name of the penalty... and a computation" as separate fields, only as
//    a single `notice_states_required_penalty_information` empirical
//    predicate a case would assert about a given `Notice` — the exact
//    three-part content test is CLASSIFICATION, deferred to a case package
//    (stage-2 candidate if a real dispute over notice adequacy needs it).

language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

use self::{
    IRC_S6751_A,
    IRC_S6751_B,
    Notice,
    Secretary,
};

// --- shared vocabulary for every addition's assessment validity ------------

pub enum PenaltySectionKind {
    FailureToFile;              // §6651(a)(1)
    FailureToPay;                // §6651(a)(2)/(a)(3)
    FailureToDeposit;            // §6656
    AccuracyRelatedOther;        // §6662(b)(1)-(5),(7),(8) grounds
    AccuracyRelatedEconomicSubstanceOrForeignAsset; // §6662(b)(9)/(10) grounds — the (b)(2)(A) carve-IN
    Fraud;                       // §6663
    EstimatedTaxIndividual;      // §6654
    EstimatedTaxCorporate;       // §6655
    label en unofficial "the addition or penalty section a penalty determination is made under, for purposes of the section 6751(b)(2) exceptions";
}

pub entity PenaltyDetermination {
    label en official "the initial determination of an assessment of a penalty under this title";
}
pub relation penalty_kind_of(d: PenaltyDetermination, kind: PenaltySectionKind) kind institutional {
    label en unofficial "the penalty determination is made under the named section";
}
relation supervisor_approved_in_writing(d: PenaltyDetermination) kind empirical {
    label en official "personally approved (in writing) by the immediate supervisor of the individual making such determination or such higher level official as the Secretary may designate";
}
relation automatically_calculated_through_electronic_means(d: PenaltyDetermination) kind empirical {
    label en official "any other penalty automatically calculated through electronic means";
}

// (b)(2)(A): §6651, §6654, §6655 are exempt outright; §6662 is exempt ONLY
// for the two carve-in grounds (economic substance / undisclosed foreign
// financial asset).
relation exempt_from_supervisory_approval(kind: PenaltySectionKind) kind institutional {
    label en official "paragraph (1) shall not apply to any addition to tax under section 6651, 6654, 6655, or 6662 (but only with respect to an addition to tax by reason of paragraph (9) or (10) of subsection (b) thereof)";
}
@source(IRC_S6751_B, relation = formalizes, coverage = partial, quote = "any addition to tax under section 6651, 6654, 6655, or 6662 (but only with respect to an addition to tax by reason of paragraph (9) or (10) of subsection (b) thereof)")
assert exempt_from_supervisory_approval(FailureToFile);
@source(IRC_S6751_B, relation = formalizes, coverage = partial, quote = "any addition to tax under section 6651, 6654, 6655, or 6662 (but only with respect to an addition to tax by reason of paragraph (9) or (10) of subsection (b) thereof)")
assert exempt_from_supervisory_approval(FailureToPay);
@source(IRC_S6751_B, relation = formalizes, coverage = partial, quote = "any addition to tax under section 6651, 6654, 6655, or 6662 (but only with respect to an addition to tax by reason of paragraph (9) or (10) of subsection (b) thereof)")
assert exempt_from_supervisory_approval(EstimatedTaxIndividual);
@source(IRC_S6751_B, relation = formalizes, coverage = partial, quote = "any addition to tax under section 6651, 6654, 6655, or 6662 (but only with respect to an addition to tax by reason of paragraph (9) or (10) of subsection (b) thereof)")
assert exempt_from_supervisory_approval(EstimatedTaxCorporate);
@source(IRC_S6751_B, relation = formalizes, coverage = partial, quote = "any addition to tax under section 6651, 6654, 6655, or 6662 (but only with respect to an addition to tax by reason of paragraph (9) or (10) of subsection (b) thereof)")
assert exempt_from_supervisory_approval(AccuracyRelatedEconomicSubstanceOrForeignAsset);

pub relation penalty_assessment_condition_met(d: PenaltyDetermination) kind institutional {
    label en unofficial "the section 6751(b) precondition for assessing this penalty determination is satisfied (single atom for the assessment power's valid_when, per the pilot's lesson that valid_when takes exactly one atom — LDC-E1305/E0201/E4101)";
}

@source(IRC_S6751_B, relation = formalizes, coverage = exact, quote = "No penalty under this title shall be assessed unless the initial determination of such assessment is personally approved (in writing) by the immediate supervisor of the individual making such determination or such higher level official as the Secretary may designate")
rule PenaltyAssessmentConditionApproved strict {
    for d: PenaltyDetermination;
    when supervisor_approved_in_writing(d);
    then penalty_assessment_condition_met(d);
}
@source(IRC_S6751_B, relation = formalizes, coverage = partial, quote = "any other penalty automatically calculated through electronic means")
rule PenaltyAssessmentConditionAutomatic strict {
    for d: PenaltyDetermination;
    when automatically_calculated_through_electronic_means(d);
    then penalty_assessment_condition_met(d);
}
@source(IRC_S6751_B, relation = formalizes, coverage = partial, quote = "Paragraph (1) shall not apply to")
rule PenaltyAssessmentConditionExempt strict {
    for d: PenaltyDetermination;
    for kind: PenaltySectionKind;
    when penalty_kind_of(d, kind) and exempt_from_supervisory_approval(kind);
    then penalty_assessment_condition_met(d);
}

pub relation penalty_determination_validly_assessable(d: PenaltyDetermination) kind institutional {
    label en unofficial "the exercise of the section 6751(b) assessment power over this determination is valid; an invalid exercise gives POWER_INVALID_EXERCISE and no effect (E-0239)";
}
relation secretary_moves_to_assess(d: PenaltyDetermination) kind empirical {
    label en unofficial "the Secretary has moved to assess the penalty determination (the exercise fact of the section 6751(b) power)";
}
@source(IRC_S6751_B, relation = formalizes, coverage = exact, quote = "No penalty under this title shall be assessed unless the initial determination of such assessment is personally approved (in writing) by the immediate supervisor of the individual making such determination or such higher level official as the Secretary may designate")
rule Section6751AssessmentPower(d: PenaltyDetermination) strict {
    label en official "No penalty under this title shall be assessed unless the initial determination of such assessment is personally approved (in writing) ...";
    when secretary_moves_to_assess(d);
    then power AssessPenaltyDetermination {
        holder Secretary;
        over d;
        exercise secretary_moves_to_assess(d);
        valid_when penalty_assessment_condition_met(d);
        effect create(penalty_determination_validly_assessable(d));
        window [@1954-08-16, infinity);
    };
}

// --- §6751(a): notice content duty ------------------------------------------

relation notice_states_required_penalty_information(n: Notice) kind empirical {
    label en official "information with respect to the name of the penalty, the section of this title under which the penalty is imposed, and a computation of the penalty";
}
relation notice_is_of_a_penalty(n: Notice) kind empirical {
    label en unofficial "the notice is a notice of penalty under this title (section 6751(c): 'penalty' includes any addition to tax or additional amount)";
}
@source(IRC_S6751_A, relation = formalizes, coverage = exact, quote = "The Secretary shall include with each notice of penalty under this title information with respect to the name of the penalty, the section of this title under which the penalty is imposed, and a computation of the penalty")
rule Section6751NoticeContentDuty(n: Notice) strict {
    label en official "The Secretary shall include with each notice of penalty under this title information with respect to the name of the penalty, the section of this title under which the penalty is imposed, and a computation of the penalty.";
    when notice_is_of_a_penalty(n);
    then duty PenaltyNoticeContentDuty {
        bearer Secretary;
        goal achievement {
            condition notice_states_required_penalty_information(n);
            window [@1954-08-16, infinity);
        };
    };
}
