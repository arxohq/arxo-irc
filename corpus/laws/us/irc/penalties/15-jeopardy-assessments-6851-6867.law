// 26 U.S.C. §§6851, 6861, 6863, 6867 — Jeopardy and termination assessments.
// STAGE 2b, seventh and last of the named `pub` targets: `pub
// jeopardy_assessment_valid`.
//
// SCOPE AND JUDGMENT CALLS (see report):
//  - §6851 (termination assessment, pre-return-due-date) and §6861 (jeopardy
//    deficiency assessment, post-return, pre-normal-assessment) are TWO
//    DIFFERENT assessment authorities sharing the same "jeopardy" concept
//    and an IDENTICAL 60-day notice structure — modelled as ONE entity
//    (`JeopardyAssessment`) with a `JeopardyAssessmentKind` discriminator,
//    rather than duplicating the whole shape twice, since the named `pub`
//    export (`jeopardy_assessment_valid`) needs to answer the SAME question
//    ("was this jeopardy/termination assessment validly made and timely
//    noticed?") for either kind.
//  - §6851(a)(1)'s jeopardy FINDING ("designs quickly to depart ... or to
//    conceal ... or to do any other act tending to prejudice ... proceedings
//    to collect") and §6861(a)'s ("believes that the assessment or
//    collection of a deficiency ... will be jeopardized by delay") are each
//    a case-asserted empirical fact (the Secretary's own institutional
//    finding, not a DECISION-0194 open-textured standard the way
//    "reasonable cause" is — matching `05-failure-to-deposit-6656.law`'s
//    treatment of "the Secretary determines" language elsewhere in this
//    package as an institutional finding, not an evaluative channel).
//  - §6851(a)(4) (no assessment for the preceding year after the return due date),
//    (a)(2)-(a)(3), (c) (waiver for departing citizens) and (d) (departure of
//    aliens) are modelled in stage 2, module 26; (a)(4) is a conjunct of
//    `JeopardyAssessmentValidTermination` below. The scope priority between
//    §6851 and §6861 is exactly (a)(4) and needs no separate rule.
//  - §6861(c)/(d)/(e) (the assessable-amount ceiling/floor around a Tax
//    Court petition and decision, and the expiration of the jeopardy-
//    assessment right after the Tax Court decision becomes final) are NOT
//    modelled — each requires the `judicial-proceedings`/`assessment`
//    Tax-Court-finality machinery this package does not import — TECH_GAP.
//  - §6861(f) (collection of the stayed amount after a final Tax Court
//    decision) and (g) (abatement where jeopardy did not exist, with its
//    own limitations-suspension rule) are NOT modelled — TECH_GAP.
//  - §6863(a)'s bond stay is modelled as a `power` HELD BY THE TAXPAYER
//    (an unusual but textually correct reading: filing a conforming bond
//    is the taxpayer's own act that changes the legal relation — the
//    Secretary's collection authority is suspended). The (a) proportionate-
//    reduction-on-waiver/abatement mechanics are NOT modelled — TECH_GAP; (b)'s
//    further Tax-Court bond conditions and the stay of sale (b)(3), (c) are
//    modelled in stage 2, module 26.
//  - §6867(a)-(c) (the unidentified-cash-possessor presumption) is modelled
//    with the language's own `presumption` construct, exactly as the
//    coordinator's brief specifies — `presume` the cash is the possessor's
//    gross income AND `presume` collection is jeopardized by delay, each
//    rebuttable by the possessor's own claim of ownership or a readily-
//    ascertainable, acknowledging true owner. (d) (cash/cash-equivalent
//    definitions) is a case-asserted classification (`is_cash_or_equivalent`)
//    rather than a derivation of "frequently used in illegal activities"
//    regulatory designations — EXTERNAL_DEPENDENCY on the Secretary's own
//    regulations.
//  - §6852, §6862, §6871-§6873 are modelled in stage 2, module 23 (the two
//    authorities of §6852 and §6862 are added to `JeopardyAssessmentKind`);
//    §6864 is a cross-reference; §6861(c)-(g) remain TECH_GAP (stage 2 register).

language "law.core" version "0.2";
package us.irc.penalties version "0.1.1";
namespace "urn:us:irc:penalties:clir";

use self::{
    IRC_S6851_A,
    IRC_S6851_B,
    IRC_S6861_A,
    IRC_S6861_B,
    IRC_S6863_A,
    IRC_S6867_A,
    Individual,
    Person,
    Secretary,
    termination_assessment_within_6851a4_limit,
};

pub enum JeopardyAssessmentKind {
    Termination6851;
    Deficiency6861;
    Political6852;              // §6852 termination assessment of a section 501(c)(3) organization (stage 2, module 23)
    NonIncomeTax6862;           // §6862 jeopardy assessment of taxes other than income, estate, gift and chapters 41-44 (stage 2, module 23)
}
pub entity JeopardyAssessment {
    label en unofficial "a termination assessment under section 6851 or a jeopardy assessment of a deficiency under section 6861";
}
relation jeopardy_assessment_of(a: JeopardyAssessment, p: Person, kind: JeopardyAssessmentKind) kind empirical {
    label en unofficial "the taxpayer and which of the two jeopardy authorities this assessment was made under";
}

// --- §6851(a): termination assessment ---------------------------------------

relation taxpayer_designs_to_depart_or_conceal(p: Person) kind empirical {
    label en official "the Secretary finds that a taxpayer designs quickly to depart from the United States or to remove his property therefrom, or to conceal himself or his property therein, or to do any other act ... tending to prejudice or to render wholly or partially ineffectual proceedings to collect the income tax";
}
relation secretary_moves_to_terminate_assessment(a: JeopardyAssessment) kind empirical {
    label en unofficial "the exercise fact of the section 6851(a) termination-assessment power";
}
pub relation termination_assessment_condition_met(p: Person) kind institutional {
    label en unofficial "the section 6851(a)(1) jeopardy finding is present (single atom for valid_when)";
}
@source(IRC_S6851_A, relation = formalizes, coverage = partial, quote = "the Secretary shall immediately make a determination of tax for the current taxable year or for the preceding taxable year")
rule TerminationAssessmentConditionMet defeasible {
    for p: Person;
    when taxpayer_designs_to_depart_or_conceal(p);
    then termination_assessment_condition_met(p);
}
pub relation termination_assessment_authorized(a: JeopardyAssessment) kind institutional {
    label en unofficial "the section 6851(a) termination assessment has been validly made";
}
@source(IRC_S6851_A, relation = formalizes, coverage = exact, quote = "The Secretary shall immediately assess the amount of the tax so determined")
rule Section6851aPower strict {
    for a: JeopardyAssessment;
    for p: Person;
    when secretary_moves_to_terminate_assessment(a)
        and jeopardy_assessment_of(a, p, Termination6851);
    then power TerminateAssessment {
        holder Secretary;
        over a;
        exercise secretary_moves_to_terminate_assessment(a);
        valid_when termination_assessment_condition_met(p);
        effect create(termination_assessment_authorized(a));
        window [@1954-08-16, infinity);
    };
}

// --- §6851(b) / §6861(b): the 60-day notice duty -----------------------------

relation jeopardy_notice_mailed_on(a: JeopardyAssessment, d: Date) kind empirical {
    label en unofficial "the date the section 6212(a) notice of deficiency was mailed with respect to this jeopardy/termination assessment";
}
relation jeopardy_assessment_made_on(a: JeopardyAssessment, d: Date) kind empirical {
    label en unofficial "the date the jeopardy or termination assessment itself was made";
}
relation return_due_date_or_filing_later(a: JeopardyAssessment, d: Date) kind empirical {
    label en unofficial "section 6851(b): the later of the due date of the taxpayer's return (with extensions) or the date the taxpayer files it";
}
pub relation jeopardy_notice_given_timely(a: JeopardyAssessment) kind institutional {
    label en official "the Secretary shall mail a notice under section 6212(a) ... within 60 days after the later of (i) the due date of the taxpayer's return ... or (ii) the date such taxpayer files such return [section 6851(b)]; or within 60 days after the making of the assessment [section 6861(b)]";
}
@source(IRC_S6851_B, relation = formalizes, coverage = exact, quote = "the Secretary shall mail a notice under section 6212(a) for the taxpayer's full taxable year (determined without regard to any action taken under subsection (a)) with respect to which such assessment was made within 60 days after the later of")
rule JeopardyNoticeTimelyTermination strict {
    for a: JeopardyAssessment;
    for p: Person;
    for baseline: Date;
    for mailed: Date;
    when jeopardy_assessment_of(a, p, Termination6851)
        and return_due_date_or_filing_later(a, baseline)
        and jeopardy_notice_mailed_on(a, mailed)
        and mailed <= add_calendar_period(baseline, 60 calendar_day);
    then jeopardy_notice_given_timely(a);
}
@source(IRC_S6861_B, relation = formalizes, coverage = exact, quote = "the Secretary shall mail a notice under such subsection within 60 days after the making of the assessment")
rule JeopardyNoticeTimelyDeficiency strict {
    for a: JeopardyAssessment;
    for made: Date;
    for mailed: Date;
    when jeopardy_assessment_made_on(a, made)
        and jeopardy_notice_mailed_on(a, mailed)
        and mailed <= add_calendar_period(made, 60 calendar_day);
    then jeopardy_notice_given_timely(a);
}

// --- §6861(a): jeopardy assessment of a deficiency --------------------------

relation secretary_believes_jeopardized_by_delay(p: Person) kind empirical {
    label en official "the Secretary believes that the assessment or collection of a deficiency, as defined in section 6211, will be jeopardized by delay";
}
relation secretary_moves_to_assess_jeopardy_deficiency(a: JeopardyAssessment) kind empirical {
    label en unofficial "the exercise fact of the section 6861(a) jeopardy-assessment power";
}
pub relation jeopardy_deficiency_condition_met(p: Person) kind institutional {
    label en unofficial "the section 6861(a) jeopardy finding is present (single atom for valid_when)";
}
@source(IRC_S6861_A, relation = formalizes, coverage = exact, quote = "the Secretary believes that the assessment or collection of a deficiency, as defined in section 6211, will be jeopardized by delay")
rule JeopardyDeficiencyConditionMet defeasible {
    for p: Person;
    when secretary_believes_jeopardized_by_delay(p);
    then jeopardy_deficiency_condition_met(p);
}
pub relation jeopardy_deficiency_assessment_authorized(a: JeopardyAssessment) kind institutional {
    label en unofficial "the section 6861(a) jeopardy assessment has been validly made";
}
@source(IRC_S6861_A, relation = formalizes, coverage = exact, quote = "he shall, notwithstanding the provisions of section 6213(a), immediately assess such deficiency")
rule Section6861aPower strict {
    for a: JeopardyAssessment;
    for p: Person;
    when secretary_moves_to_assess_jeopardy_deficiency(a)
        and jeopardy_assessment_of(a, p, Deficiency6861);
    then power AssessJeopardyDeficiency {
        holder Secretary;
        over a;
        exercise secretary_moves_to_assess_jeopardy_deficiency(a);
        valid_when jeopardy_deficiency_condition_met(p);
        effect create(jeopardy_deficiency_assessment_authorized(a));
        window [@1954-08-16, infinity);
    };
}

// --- combined named export: pub jeopardy_assessment_valid -------------------

pub relation jeopardy_assessment_valid(a: JeopardyAssessment) kind institutional {
    label en unofficial "the jeopardy or termination assessment was both validly authorized (the jeopardy finding was present) and timely noticed under section 6851(b)/6861(b) (the named `pub` export)";
}
@source(IRC_S6851_B, relation = formalizes, coverage = partial, quote = "If an assessment of tax is made under the authority of subsection (a)")
rule JeopardyAssessmentValidTermination strict {
    for a: JeopardyAssessment;
    when termination_assessment_authorized(a)
        and jeopardy_notice_given_timely(a)
        and termination_assessment_within_6851a4_limit(a);
    then jeopardy_assessment_valid(a);
}
@source(IRC_S6861_B, relation = formalizes, coverage = partial, quote = "If the jeopardy assessment is made before any notice in respect of the tax to which the jeopardy assessment relates has been mailed")
rule JeopardyAssessmentValidDeficiency strict {
    for a: JeopardyAssessment;
    when jeopardy_deficiency_assessment_authorized(a)
        and jeopardy_notice_given_timely(a);
    then jeopardy_assessment_valid(a);
}

// --- §6863(a): bond stays collection -----------------------------------------

relation jeopardy_bond_filed(a: JeopardyAssessment, amount: Money) kind empirical {
    label en official "filing with the Secretary ... a bond in an amount equal to the amount as to which the stay is desired";
}
relation jeopardy_assessment_stay_desired_amount(a: JeopardyAssessment, amount: Money) kind empirical {
    label en unofficial "the amount of the assessment as to which the taxpayer desires collection to be stayed";
}
pub relation jeopardy_bond_condition_met(a: JeopardyAssessment) kind institutional {
    label en unofficial "the section 6863(a) bond conforms to the amount as to which the stay is desired (single atom for valid_when)";
}
@source(IRC_S6863_A, relation = formalizes, coverage = exact, quote = "a bond in an amount equal to the amount as to which the stay is desired")
rule JeopardyBondConditionMet strict {
    for a: JeopardyAssessment;
    for amount: Money;
    when jeopardy_bond_filed(a, amount)
        and jeopardy_assessment_stay_desired_amount(a, amount);
    then jeopardy_bond_condition_met(a);
}
relation taxpayer_files_jeopardy_bond(a: JeopardyAssessment) kind empirical {
    label en unofficial "the exercise fact of the section 6863(a) bond-stay power (the taxpayer's own act)";
}
pub relation jeopardy_collection_stayed(a: JeopardyAssessment) kind institutional {
    label en official "Upon the filing of the bond the collection of so much of the amount assessed as is covered by the bond shall be stayed";
}
@source(IRC_S6863_A, relation = formalizes, coverage = exact, quote = "Upon the filing of the bond the collection of so much of the amount assessed as is covered by the bond shall be stayed")
rule Section6863aBondStayPower strict {
    for a: JeopardyAssessment;
    for p: Person;
    for kind: JeopardyAssessmentKind;
    when taxpayer_files_jeopardy_bond(a)
        and jeopardy_assessment_of(a, p, kind);
    then power StayCollectionByBond {
        holder p;
        over a;
        exercise taxpayer_files_jeopardy_bond(a);
        valid_when jeopardy_bond_condition_met(a);
        effect create(jeopardy_collection_stayed(a));
        window [@1954-08-16, infinity);
    };
}

// --- §6867: presumption for unidentified large cash possessors -------------

pub entity CashPossessionEvent {
    label en unofficial "an individual's physical possession of cash in excess of $10,000 that is not claimed by anyone";
}
relation possesses_cash_over_10000(individual: Individual, possession: CashPossessionEvent, amount: Money) kind empirical {
    label en official "the individual who is in physical possession of cash in excess of $10,000";
}
relation possessor_claims_cash_as_own(individual: Individual, possession: CashPossessionEvent) kind empirical {
    label en official "does not claim such cash as his (negated below)";
}
relation identifiable_acknowledging_owner_exists(possession: CashPossessionEvent) kind empirical {
    label en official "as belonging to another person whose identity the Secretary can readily ascertain and who acknowledges ownership of such cash (negated below)";
}
pub relation cash_ownership_unclaimed(individual: Individual, possession: CashPossessionEvent) kind institutional {
    label en unofficial "the section 6867(a) chapeau condition: the possessor does not claim the cash as his own, and no identifiable acknowledging owner exists (single atom feeding the presumption)";
}
@source(IRC_S6867_A, relation = formalizes, coverage = exact, quote = "does not claim such cash")
rule CashOwnershipUnclaimed strict {
    for individual: Individual;
    for possession: CashPossessionEvent;
    for amount: Money;
    when possesses_cash_over_10000(individual, possession, amount)
        and not_known(possessor_claims_cash_as_own(individual, possession))
        and not_known(identifiable_acknowledging_owner_exists(possession));
    then cash_ownership_unclaimed(individual, possession);
}

pub relation presumed_gross_income_of_possessor(individual: Individual, possession: CashPossessionEvent) kind institutional {
    label en unofficial "the section 6867(a) presumption: the cash represents gross income of a single individual (the possessor) for the taxable year in which possession occurs";
}
pub relation presumed_collection_jeopardized_by_delay(individual: Individual, possession: CashPossessionEvent) kind institutional {
    label en unofficial "the section 6867(a) presumption: the collection of tax will be jeopardized by delay";
}
presumption Section6867CashPresumption(individual: Individual, possession: CashPossessionEvent) {
    label en official "then, for purposes of sections 6851 and 6861, it shall be presumed that such cash represents gross income of a single individual for the taxable year in which the possession occurs, and that the collection of tax will be jeopardized by delay";
    when cash_ownership_unclaimed(individual, possession);
    presume presumed_gross_income_of_possessor(individual, possession);
    presume presumed_collection_jeopardized_by_delay(individual, possession);
}

// The presumption feeds the section 6851/6861 jeopardy findings directly
// (the text says "for purposes of sections 6851 and 6861"):
@source(IRC_S6867_A, relation = formalizes, coverage = partial, quote = "for purposes of sections 6851 and 6861")
rule Section6867FeedsTerminationFinding defeasible {
    for individual: Individual;
    for possession: CashPossessionEvent;
    when presumed_collection_jeopardized_by_delay(individual, possession);
    then taxpayer_designs_to_depart_or_conceal(individual);
}
@source(IRC_S6867_A, relation = formalizes, coverage = partial, quote = "for purposes of sections 6851 and 6861")
rule Section6867FeedsDeficiencyFinding defeasible {
    for individual: Individual;
    for possession: CashPossessionEvent;
    when presumed_collection_jeopardized_by_delay(individual, possession);
    then secretary_believes_jeopardized_by_delay(individual);
}
