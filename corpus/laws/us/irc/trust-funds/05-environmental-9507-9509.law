// 26 U.S.C. §§9507-9509 — Hazardous Substance Superfund, Leaking
// Underground Storage Tank Trust Fund, Oil Spill Liability Trust Fund. All
// three share: creation, tax-plus-recovery funding, a closed expenditure
// list, borrowing authority (advances), and claims-limited-to-fund-balance
// (00-shared.law's `ClaimPayableOnlyFromFund`).
//
// JUDGMENT CALLS:
//  - CERCLA/Clean Water Act/Oil Pollution Act cross-references ((9507(b)(2)-
//    (5), (c)(1)(A)-(iii); 9509(b)(2)-(8), (c)(1)(A)-(F)) are represented as
//    enumerated purpose/source VALUES naming the referenced Act provision —
//    EXECUTABLE at the level of "money credited/spent for purpose named by
//    Act X §Y"; the underlying Act's own substantive conditions are NOT
//    reproduced (EXTERNAL_DEPENDENCY, owner: none, out of Title 26).
//  - §9507(c)(2) (McColl Site exception) and §9509(c)(1)(A)/(D) references
//    to specific Federal Water Pollution Control Act subsections are
//    likewise named, not reproduced.
//  - §9509(c)(2) caps ($1,500,000,000 per incident; $750,000,000 NRD;
//    $30,000,000 minimum balance) are EXECUTABLE exact comparisons — no
//    ledger is needed since the case supplies the relevant amount/balance
//    directly (unlike a running total, a single incident's claimed total or
//    the fund's current balance are simple case facts).
//  - Interest-rate provisions ((9507(d)(3)(C), 9509(d)(3)(C)) are Treasury
//    market-yield external dependencies (see 00-shared.law's advance_interest_rate).

language "law.core" version "0.2";
package us.irc.trust_funds version "0.1.1";
namespace "urn:us:irc:trust_funds:clir";

use self::{
    Expenditure,
    FundedTaxReference,
    HazardousSubstanceSuperfund,
    HighwayTrustFund,
    IRC_S9507_A,
    IRC_S9507_B,
    IRC_S9507_C,
    IRC_S9507_D,
    IRC_S9508_A,
    IRC_S9508_B,
    IRC_S9508_C,
    IRC_S9508_E,
    IRC_S9509_A,
    IRC_S9509_B,
    IRC_S9509_C,
    IRC_S9509_D,
    LeakingUndergroundStorageTankTrustFund,
    OilSpillLiabilityTrustFund,
    TrustFund,
    advance_necessary_to_make_expenditures,
    advance_outstanding,
    advance_requested,
    amount_credited_to_fund,
    appropriated_lump_sum,
    expenditure_authorized,
    expenditure_from_fund,
    fund_established,
    fund_funded_by,
    further_appropriation_barred,
};

// ================= §9507 Hazardous Substance Superfund ========================

@source(IRC_S9507_A, relation = formalizes, coverage = partial, quote = "There is established in the Treasury of the United States a trust fund to be known as the \"Hazardous Substance Superfund\" (hereinafter in this section referred to as the \"Superfund\"), consisting of such amounts as may be")
rule S9507EstablishFund strict { then fund_established(HazardousSubstanceSuperfund); }

@source(IRC_S9507_B, relation = formalizes, coverage = partial, quote = "(1) the taxes received in the Treasury under section 4611, 4661, or 4671 (relating to environmental taxes),")
rule S9507FundedByPetroleumTax strict { then fund_funded_by(HazardousSubstanceSuperfund, Section4611PetroleumSuperfundRate); }
@source(IRC_S9507_B, relation = formalizes, coverage = partial, quote = "(1) the taxes received in the Treasury under section 4611, 4661, or 4671 (relating to environmental taxes),")
rule S9507FundedByChemicalTax strict { then fund_funded_by(HazardousSubstanceSuperfund, Section4661ChemicalTax); }
@source(IRC_S9507_B, relation = formalizes, coverage = partial, quote = "(1) the taxes received in the Treasury under section 4611, 4661, or 4671 (relating to environmental taxes),")
rule S9507FundedByImportedSubstanceTax strict { then fund_funded_by(HazardousSubstanceSuperfund, Section4671ImportedSubstanceTax); }

enum SuperfundNonTaxSource { CerclaRecovery; CleanWaterActS311b6B; CerclaPenalty; CerclaPunitiveDamages107c3; }
relation superfund_non_tax_receipt(origin: SuperfundNonTaxSource, amount: Money) kind empirical {
    label en unofficial "an amount is recovered or collected under the named non-tax source (CERCLA/Clean Water Act) — external dependency as to the underlying recovery condition";
}
@source(IRC_S9507_B, relation = formalizes, coverage = partial, quote = "(2) amounts recovered on behalf of the Superfund under the Comprehensive Environmental Response, Compensation, and Liability Act of 1980 (hereinafter in this section referred to as \"CERCLA\"),")
rule S9507CreditCerclaRecovery strict {
    for amount: Money;
    when superfund_non_tax_receipt(CerclaRecovery, amount);
    then amount_credited_to_fund(HazardousSubstanceSuperfund, amount);
}
@source(IRC_S9507_B, relation = formalizes, coverage = partial, quote = "(3) all moneys recovered or collected under section 311(b)(6)(B) of the Clean Water Act,")
rule S9507CreditCwaRecovery strict {
    for amount: Money;
    when superfund_non_tax_receipt(CleanWaterActS311b6B, amount);
    then amount_credited_to_fund(HazardousSubstanceSuperfund, amount);
}
@source(IRC_S9507_B, relation = formalizes, coverage = partial, quote = "(4) penalties assessed under title I of CERCLA, and")
rule S9507CreditCerclaPenalty strict {
    for amount: Money;
    when superfund_non_tax_receipt(CerclaPenalty, amount);
    then amount_credited_to_fund(HazardousSubstanceSuperfund, amount);
}
@source(IRC_S9507_B, relation = formalizes, coverage = partial, quote = "(5) punitive damages under section 107(c)(3) of CERCLA.")
rule S9507CreditCerclaPunitiveDamages strict {
    for amount: Money;
    when superfund_non_tax_receipt(CerclaPunitiveDamages107c3, amount);
    then amount_credited_to_fund(HazardousSubstanceSuperfund, amount);
}

enum SuperfundExpenditurePurpose { Cercla111a1256; Cercla111cOtherThan12; Cercla111m; OtherLawNotExpandingPurpose; }
relation superfund_expenditure_purpose(e: Expenditure, purpose: SuperfundExpenditurePurpose) kind empirical;
@source(IRC_S9507_C, relation = formalizes, coverage = partial, quote = "paragraphs (1), (2), (5), and (6) of section 111(a) of CERCLA as in effect on the date of the enactment of the Superfund Amendments and Reauthorization Act of 1986,")
rule S9507ExpenditureAuthorizedCercla111a defeasible {
    for e: Expenditure;
    when expenditure_from_fund(e, HazardousSubstanceSuperfund) and superfund_expenditure_purpose(e, Cercla111a1256);
    then expenditure_authorized(e, HazardousSubstanceSuperfund);
    unless mccoll_site_transfer(e);
}
@source(IRC_S9507_C, relation = formalizes, coverage = partial, quote = "section 111(c) of CERCLA (as so in effect), other than paragraphs (1) and (2) thereof, and")
rule S9507ExpenditureAuthorizedCercla111c defeasible {
    for e: Expenditure;
    when expenditure_from_fund(e, HazardousSubstanceSuperfund) and superfund_expenditure_purpose(e, Cercla111cOtherThan12);
    then expenditure_authorized(e, HazardousSubstanceSuperfund);
    unless mccoll_site_transfer(e);
}
@source(IRC_S9507_C, relation = formalizes, coverage = partial, quote = "section 111(m) of CERCLA (as so in effect), or")
rule S9507ExpenditureAuthorizedCercla111m defeasible {
    for e: Expenditure;
    when expenditure_from_fund(e, HazardousSubstanceSuperfund) and superfund_expenditure_purpose(e, Cercla111m);
    then expenditure_authorized(e, HazardousSubstanceSuperfund);
    unless mccoll_site_transfer(e);
}
@source(IRC_S9507_C, relation = formalizes, coverage = partial, quote = "hereafter authorized by a law which does not authorize the expenditure out of the Superfund for a general purpose not covered by subparagraph (A) (as so in effect).")
rule S9507ExpenditureAuthorizedOtherLaw defeasible {
    for e: Expenditure;
    when expenditure_from_fund(e, HazardousSubstanceSuperfund) and superfund_expenditure_purpose(e, OtherLawNotExpandingPurpose);
    then expenditure_authorized(e, HazardousSubstanceSuperfund);
    unless mccoll_site_transfer(e);
}

relation mccoll_site_transfer(e: Expenditure) kind empirical {
    label en unofficial "the expenditure is for the transfer or disposal of hazardous waste from the McColl Site, Fullerton, California, under the (c)(2) exception's fact pattern (non-complying-on-1985-12-13 transfer to a 1983-1984 permitted facility)";
}

@source(IRC_S9507_D, relation = formalizes, coverage = partial, quote = "There are authorized to be appropriated to the Superfund, as repayable advances, such sums as may be necessary to carry out the purposes of the Superfund.")
rule S9507AdvanceAuthorized strict {
    for amount: Money;
    when advance_requested(HazardousSubstanceSuperfund, amount) and advance_necessary_to_make_expenditures(HazardousSubstanceSuperfund, amount);
    then power S9507AdvancePower {
        holder us.irc.core::Secretary;
        over HazardousSubstanceSuperfund;
        exercise advance_requested(HazardousSubstanceSuperfund, amount);
        valid_when advance_necessary_to_make_expenditures(HazardousSubstanceSuperfund, amount);
        effect create(advance_outstanding(HazardousSubstanceSuperfund, amount));
    };
}
relation advance_made_on(f: TrustFund, d: Date) kind empirical;
relation advance_barred_after_final_repayment_date(f: TrustFund, cutoff: Date) kind institutional;
@source(IRC_S9507_D, relation = formalizes, coverage = exact, quote = "No advance shall be made to the Superfund after December 31, 2032, and all advances to such Fund shall be repaid on or before such date.")
rule S9507NoAdvanceAfterFinalDate strict {
    for d: Date;
    when advance_made_on(HazardousSubstanceSuperfund, d) and d > @2032-12-31;
    then advance_barred_after_final_repayment_date(HazardousSubstanceSuperfund, @2032-12-31);
}

// (e) — see 00-shared.law's ClaimPayableOnlyFromFund, instantiated with
// HazardousSubstanceSuperfund by any case that asserts `claim_against_fund`.

// ================= §9508 Leaking Underground Storage Tank =====================

@source(IRC_S9508_A, relation = formalizes, coverage = partial, quote = "There is established in the Treasury of the United States a trust fund to be known as the \"Leaking Underground Storage Tank Trust Fund\", consisting of such amounts as may be appropriated or credited to such Trust Fund as")
rule S9508EstablishFund strict { then fund_established(LeakingUndergroundStorageTankTrustFund); }

relation lust_fuel_tax_rate_share(tax: FundedTaxReference) kind institutional {
    label en unofficial "the LUST-financing-rate SHARE of the named general fuel tax feeds this fund (the (b)(2)/(3) 'to the extent attributable to the LUST financing rate' qualifier) — this package does not split a single receipt figure between the general rate and the LUST rate (TECH_GAP: rate-share apportionment)";
}
@source(IRC_S9508_B, relation = formalizes, coverage = partial, quote = "(1) taxes received in the Treasury under section 4041(d) (relating to additional taxes on motor fuels),")
rule S9508FundedByFuelTaxD strict { then fund_funded_by(LeakingUndergroundStorageTankTrustFund, Section4041FuelTaxGeneral); }
@source(IRC_S9508_B, relation = formalizes, coverage = partial, quote = "(2) taxes received in the Treasury under section 4081 (relating to tax on gasoline, diesel fuel, and kerosene) to the extent attributable to the Leaking Underground Storage Tank Trust Fund financing rate under such secti")
rule S9508FundedByFuelTax4081 strict { then fund_funded_by(LeakingUndergroundStorageTankTrustFund, Section4081FuelTaxGeneral); }
@source(IRC_S9508_B, relation = formalizes, coverage = partial, quote = "(3) taxes received in the Treasury under section 4042 (relating to tax on fuel used in commercial transportation on inland waterways) to the extent attributable to the Leaking Underground Storage Tank Trust Fund financin")
rule S9508FundedByInlandWaterwaysTax strict { then fund_funded_by(LeakingUndergroundStorageTankTrustFund, Section4042InlandWaterwaysFuelTax); }

relation solid_waste_disposal_act_9003h6_receipt(amount: Money) kind empirical {
    label en unofficial "amounts received and collected under §9003(h)(6) of the Solid Waste Disposal Act — external dependency";
}
@source(IRC_S9508_B, relation = formalizes, coverage = partial, quote = "(4) amounts received in the Treasury and collected under section 9003(h)(6) of the Solid Waste Disposal Act.")
rule S9508CreditSwda strict {
    for amount: Money;
    when solid_waste_disposal_act_9003h6_receipt(amount);
    then amount_credited_to_fund(LeakingUndergroundStorageTankTrustFund, amount);
}

relation lust_expenditure_purpose(e: Expenditure) kind empirical {
    label en unofficial "the expenditure carries out the LUST program's purpose (Subtitle I, Solid Waste Disposal Act cross-reference)";
}
@source(IRC_S9508_C, relation = formalizes, coverage = partial, quote = "Except as provided in paragraphs (2), (3), and (4), amounts in the Leaking Underground Storage Tank Trust Fund shall be available, as provided in appropriation Acts, only for purposes of making expenditures to carry out ")
rule S9508ExpenditureAuthorizedProgram defeasible {
    for e: Expenditure;
    when expenditure_from_fund(e, LeakingUndergroundStorageTankTrustFund) and lust_expenditure_purpose(e);
    then expenditure_authorized(e, LeakingUndergroundStorageTankTrustFund);
}
@source(IRC_S9508_C, relation = formalizes, coverage = exact, quote = "Out of amounts in the Leaking Underground Storage Tank Trust Fund there is hereby appropriated $2,400,000,000 to be transferred under section 9503(f)(3) to the Highway Account (as defined in section 9503(e)(5)(B)) in the")
rule S9508TransferToHighwayC2 strict { then appropriated_lump_sum(HighwayTrustFund, "S9508(c)(2)-to-Highway", 2400000000 USD); }
@source(IRC_S9508_C, relation = formalizes, coverage = exact, quote = "Out of amounts in the Leaking Underground Storage Tank Trust Fund there is hereby appropriated $1,000,000,000 to be transferred under section 9503(f)(6) to the Highway Account (as defined in section 9503(e)(5)(B)) in the")
rule S9508TransferToHighwayC3 strict { then appropriated_lump_sum(HighwayTrustFund, "S9508(c)(3)-to-Highway", 1000000000 USD); }
@source(IRC_S9508_C, relation = formalizes, coverage = partial, quote = "(A) on the date of the enactment of the FAST Act, $100,000,000,")
rule S9508TransferToHighwayC4A strict { then appropriated_lump_sum(HighwayTrustFund, "S9508(c)(4)(A)-FastActEnactment", 100000000 USD); }
@source(IRC_S9508_C, relation = formalizes, coverage = partial, quote = "(B) on October 1, 2016, $100,000,000, and")
rule S9508TransferToHighwayC4B strict { then appropriated_lump_sum(HighwayTrustFund, "S9508(c)(4)(B)-2016-10-01", 100000000 USD); }
@source(IRC_S9508_C, relation = formalizes, coverage = partial, quote = "(C) on October 1, 2017, $100,000,000,")
rule S9508TransferToHighwayC4C strict { then appropriated_lump_sum(HighwayTrustFund, "S9508(c)(4)(C)-2017-10-01", 100000000 USD); }

relation lust_liquidates_prior_obligation(e: Expenditure, cutoff: Date) kind empirical;
@source(IRC_S9508_E, relation = formalizes, coverage = partial, quote = "Except as provided in paragraph (2), no amount may be appropriated to the Leaking Underground Storage Tank Trust Fund on and after the date of any expenditure from the Leaking Underground Storage Tank Trust Fund which is")
rule S9508LimitationOnTransfers defeasible {
    for e: Expenditure;
    when expenditure_from_fund(e, LeakingUndergroundStorageTankTrustFund) and not_known(expenditure_authorized(e, LeakingUndergroundStorageTankTrustFund));
    then further_appropriation_barred(LeakingUndergroundStorageTankTrustFund);
    unless lust_liquidates_prior_obligation(e, @2026-10-01);
}

// ================= §9509 Oil Spill Liability ===================================

@source(IRC_S9509_A, relation = formalizes, coverage = partial, quote = "There is established in the Treasury of the United States a trust fund to be known as the \"Oil Spill Liability Trust Fund\", consisting of such amounts as may be appropriated or credited to such Trust Fund as provided in ")
rule S9509EstablishFund strict { then fund_established(OilSpillLiabilityTrustFund); }

@source(IRC_S9509_B, relation = formalizes, coverage = partial, quote = "(1) taxes received in the Treasury under section 4611 (relating to environmental tax on petroleum) to the extent attributable to the Oil Spill Liability Trust Fund financing rate under section 4611(c),")
rule S9509FundedByPetroleumTax strict { then fund_funded_by(OilSpillLiabilityTrustFund, Section4611OilSpillRate); }

enum OilSpillNonTaxSource {
    OilPollutionActNaturalResourceDamages;    // (2)
    OilPollutionActS1015Recovery;             // (3)
    FwpcaS311kRevolvingFundTransfer;          // (4)
    DeepwaterPortLiabilityFundTransfer;       // (5)
    OffshoreOilPollutionCompensationFundTransfer; // (6)
    TransAlaskaPipelineLiabilityFundTransfer; // (7)
    FwpcaOrDeepwaterPortOrPipelinePenalty;    // (8)
}
relation oil_spill_non_tax_receipt(origin: OilSpillNonTaxSource, amount: Money) kind empirical {
    label en unofficial "an amount is recovered/transferred/collected under the named Oil Pollution Act of 1990 / Federal Water Pollution Control Act / Deepwater Port Act / Trans-Alaska Pipeline Authorization Act source — external dependency";
}
@source(IRC_S9509_B, relation = formalizes, coverage = partial, quote = "(2) amounts recovered under the Oil Pollution Act of 1990 for damages to natural resources which are required to be deposited in the Fund under section 1006(f) of such Act,")
rule S9509CreditNrd strict { for amount: Money; when oil_spill_non_tax_receipt(OilPollutionActNaturalResourceDamages, amount); then amount_credited_to_fund(OilSpillLiabilityTrustFund, amount); }
@source(IRC_S9509_B, relation = formalizes, coverage = partial, quote = "(3) amounts recovered by such Trust Fund under section 1015 of such Act,")
rule S9509CreditS1015 strict { for amount: Money; when oil_spill_non_tax_receipt(OilPollutionActS1015Recovery, amount); then amount_credited_to_fund(OilSpillLiabilityTrustFund, amount); }
@source(IRC_S9509_B, relation = formalizes, coverage = partial, quote = "(4) amounts required to be transferred by such Act from the revolving fund established under section 311(k) of the Federal Water Pollution Control Act,")
rule S9509CreditFwpcaRevolving strict { for amount: Money; when oil_spill_non_tax_receipt(FwpcaS311kRevolvingFundTransfer, amount); then amount_credited_to_fund(OilSpillLiabilityTrustFund, amount); }
@source(IRC_S9509_B, relation = formalizes, coverage = partial, quote = "(5) amounts required to be transferred by the Oil Pollution Act of 1990 from the Deepwater Port Liability Fund established under section 18(f) of the Deepwater Port Act of 1974,")
rule S9509CreditDeepwaterPort strict { for amount: Money; when oil_spill_non_tax_receipt(DeepwaterPortLiabilityFundTransfer, amount); then amount_credited_to_fund(OilSpillLiabilityTrustFund, amount); }
@source(IRC_S9509_B, relation = formalizes, coverage = partial, quote = "(6) amounts required to be transferred by the Oil Pollution Act of 1990 from the Offshore Oil Pollution Compensation Fund established under section 302 of the Outer Continental Shelf Lands Act Amendments of 1978,")
rule S9509CreditOffshore strict { for amount: Money; when oil_spill_non_tax_receipt(OffshoreOilPollutionCompensationFundTransfer, amount); then amount_credited_to_fund(OilSpillLiabilityTrustFund, amount); }
@source(IRC_S9509_B, relation = formalizes, coverage = partial, quote = "(7) amounts required to be transferred by the Oil Pollution Act of 1990 from the Trans-Alaska Pipeline Liability Fund established under section 204 of the Trans-Alaska Pipeline Authorization Act, and")
rule S9509CreditPipeline strict { for amount: Money; when oil_spill_non_tax_receipt(TransAlaskaPipelineLiabilityFundTransfer, amount); then amount_credited_to_fund(OilSpillLiabilityTrustFund, amount); }
@source(IRC_S9509_B, relation = formalizes, coverage = partial, quote = "(8) any penalty paid pursuant to section 311 of the Federal Water Pollution Control Act, section 309(c) of such Act (as a result of violations of such section 311), the Deepwater Port Act of 1974, or section 207 of the T")
rule S9509CreditPenalty strict { for amount: Money; when oil_spill_non_tax_receipt(FwpcaOrDeepwaterPortOrPipelinePenalty, amount); then amount_credited_to_fund(OilSpillLiabilityTrustFund, amount); }

enum OilSpillExpenditurePurpose {
    RemovalCostsOpa1012;
    InterventionOnHighSeasS5S7;
    Fwpca311kRevolvingFundLiabilities;
    Fwpca311PreventionRemovalEnforcement;
    DeepwaterPortLiabilities;
    OffshorePollutionCompensationLiabilities;
}
relation oil_spill_expenditure_purpose(e: Expenditure, purpose: OilSpillExpenditurePurpose) kind empirical;
@source(IRC_S9509_C, relation = formalizes, coverage = partial, quote = "(A) for the payment of removal costs and other costs, expenses, claims, and damages referred to in section 1012 of such Act,")
rule S9509ExpenditureAuthorizedRemovalCosts defeasible { for e: Expenditure; when expenditure_from_fund(e, OilSpillLiabilityTrustFund) and oil_spill_expenditure_purpose(e, RemovalCostsOpa1012); then expenditure_authorized(e, OilSpillLiabilityTrustFund); }
@source(IRC_S9509_C, relation = formalizes, coverage = partial, quote = "(B) to carry out sections 5 and 7 of the Intervention on the High Seas Act relating to oil pollution or the substantial threat of oil pollution,")
rule S9509ExpenditureAuthorizedIntervention defeasible { for e: Expenditure; when expenditure_from_fund(e, OilSpillLiabilityTrustFund) and oil_spill_expenditure_purpose(e, InterventionOnHighSeasS5S7); then expenditure_authorized(e, OilSpillLiabilityTrustFund); }
@source(IRC_S9509_C, relation = formalizes, coverage = partial, quote = "(C) for the payment of liabilities incurred by the revolving fund established by section 311(k) of the Federal Water Pollution Control Act,")
rule S9509ExpenditureAuthorizedFwpcaRevolving defeasible { for e: Expenditure; when expenditure_from_fund(e, OilSpillLiabilityTrustFund) and oil_spill_expenditure_purpose(e, Fwpca311kRevolvingFundLiabilities); then expenditure_authorized(e, OilSpillLiabilityTrustFund); }
@source(IRC_S9509_C, relation = formalizes, coverage = partial, quote = "(D) to carry out subsections (b), (c), (d), (j), and (l) of section 311 of the Federal Water Pollution Control Act with respect to prevention, removal, and enforcement related to oil discharges (as defined in such sectio")
rule S9509ExpenditureAuthorizedFwpcaPrevention defeasible { for e: Expenditure; when expenditure_from_fund(e, OilSpillLiabilityTrustFund) and oil_spill_expenditure_purpose(e, Fwpca311PreventionRemovalEnforcement); then expenditure_authorized(e, OilSpillLiabilityTrustFund); }
@source(IRC_S9509_C, relation = formalizes, coverage = partial, quote = "(E) for the payment of liabilities incurred by the Deepwater Port Liability Fund, and")
rule S9509ExpenditureAuthorizedDeepwaterPort defeasible { for e: Expenditure; when expenditure_from_fund(e, OilSpillLiabilityTrustFund) and oil_spill_expenditure_purpose(e, DeepwaterPortLiabilities); then expenditure_authorized(e, OilSpillLiabilityTrustFund); }
@source(IRC_S9509_C, relation = formalizes, coverage = partial, quote = "(F) for the payment of liabilities incurred by the Offshore Oil Pollution Compensation Fund.")
rule S9509ExpenditureAuthorizedOffshore defeasible { for e: Expenditure; when expenditure_from_fund(e, OilSpillLiabilityTrustFund) and oil_spill_expenditure_purpose(e, OffshorePollutionCompensationLiabilities); then expenditure_authorized(e, OilSpillLiabilityTrustFund); }

// --- (c)(2) caps: EXECUTABLE exact comparisons --------------------------------

relation incident_payment_amount(incident: Text, amount: Money) kind empirical;
relation incident_nrd_amount(incident: Text, amount: Money) kind empirical;
relation payment_within_incident_cap(incident: Text) kind institutional {
    label en unofficial "the amount payable with respect to the single incident does not exceed the $1,500,000,000 statutory maximum";
}
@source(IRC_S9509_C, relation = formalizes, coverage = partial, quote = "(i) any single incident shall not exceed $1,500,000,000, and")
rule S9509IncidentCap strict {
    for incident: Text;
    for amount: Money;
    when incident_payment_amount(incident, amount) and amount <= 1500000000 USD;
    then payment_within_incident_cap(incident);
}
relation nrd_within_incident_cap(incident: Text) kind institutional {
    label en unofficial "the natural resource damage assessments and claims for the single incident do not exceed the $750,000,000 statutory maximum";
}
@source(IRC_S9509_C, relation = formalizes, coverage = partial, quote = "(ii) natural resource damage assessments and claims in connection with any single incident shall not exceed $750,000,000.")
rule S9509NrdCap strict {
    for incident: Text;
    for amount: Money;
    when incident_nrd_amount(incident, amount) and amount <= 750000000 USD;
    then nrd_within_incident_cap(incident);
}
relation fund_balance_after_payment(f: TrustFund, amount: Money) kind empirical {
    label en unofficial "the fund's balance IF the payment is made — a case-supplied figure (see 00-shared.law: no ledger is computed by this package)";
}
relation is_removal_cost_payment(e: Expenditure) kind empirical;
relation minimum_balance_payment_allowed(e: Expenditure) kind institutional {
    label en unofficial "a non-removal-cost payment from the Oil Spill Liability Trust Fund is allowed under the $30,000,000 minimum-balance rule";
}
@source(IRC_S9509_C, relation = formalizes, coverage = exact, quote = "Except in the case of payments of removal costs, a payment may be made from such Trust Fund only if the amount in such Trust Fund after such payment will not be less than $30,000,000.")
rule S9509MinimumBalanceRule defeasible {
    for e: Expenditure;
    for after: Money;
    when expenditure_from_fund(e, OilSpillLiabilityTrustFund)
        and fund_balance_after_payment(OilSpillLiabilityTrustFund, after)
        and after >= 30000000 USD;
    then minimum_balance_payment_allowed(e);
    unless is_removal_cost_payment(e);
}

@source(IRC_S9509_D, relation = formalizes, coverage = partial, quote = "There are authorized to be appropriated to the Oil Spill Liability Trust Fund, as repayable advances, such sums as may be necessary to carry out the purposes of such Trust Fund.")
rule S9509AdvanceAuthorized strict {
    for amount: Money;
    when advance_requested(OilSpillLiabilityTrustFund, amount) and advance_necessary_to_make_expenditures(OilSpillLiabilityTrustFund, amount);
    then power S9509AdvancePower {
        holder us.irc.core::Secretary;
        over OilSpillLiabilityTrustFund;
        exercise advance_requested(OilSpillLiabilityTrustFund, amount);
        valid_when advance_necessary_to_make_expenditures(OilSpillLiabilityTrustFund, amount);
        effect create(advance_outstanding(OilSpillLiabilityTrustFund, amount));
    };
}
relation advance_outstanding_aggregate(f: TrustFund, amount: Money) kind institutional {
    label en unofficial "the aggregate outstanding advances to the fund — a case-supplied running total (no ledger computed, see 00-shared.law)";
}
relation advance_aggregate_within_limit(f: TrustFund) kind institutional;
@source(IRC_S9509_D, relation = formalizes, coverage = exact, quote = "The maximum aggregate amount of repayable advances to the Oil Spill Liability Trust Fund which is outstanding at any one time shall not exceed $1,000,000,000.")
rule S9509AdvanceAggregateLimit strict {
    for amount: Money;
    when advance_outstanding_aggregate(OilSpillLiabilityTrustFund, amount) and amount <= 1000000000 USD;
    then advance_aggregate_within_limit(OilSpillLiabilityTrustFund);
}
