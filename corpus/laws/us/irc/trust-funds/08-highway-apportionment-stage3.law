// Stage 3 (TECH_GAP reduction): §9503(d)(3)-(6) adjustment of apportionments, (e)(4)-(5) Mass Transit Account and
// (f)(1) opening balance restatement.
//
// The running "highway-authorization/apportionment ledger" the first stage recorded as a gap is written as
// definitions computed from RECORDED components (empirical relations), not as a self-recursive balance:
//  - unfunded highway authorizations (d)(5)(A) = potential unpaid commitments minus the amount available after the
//    other unpaid commitments, floored at zero ("the excess (if any)");
//  - net highway receipts (d)(5)(B) = receipts (including interest) minus the (c) transfers other than (c)(1);
//  - the (d)(3) percentage, the (d)(3)(B) reduced apportionment and the (d)(4) release are exact arithmetic over the
//    Secretary's estimate values.
// Both computed values feed the existing estimate relations of module 03 (`unfunded_highway_authorizations_estimate`,
// `net_highway_receipts_estimate`), so the module-03 excess rule reads either an asserted estimate or a computed one.
//
// JUDGMENT CALLS
//  - "Net highway receipts" and the available amount are floored at zero: the text says "the excess of", which is not
//    negative.
//  - The (d)(3)(B) reduction is applied as the exact percentage (div_round of the excess over the authorized amount,
//    applied to the authorized amount), capped so that the apportioned amount is not negative (a percentage above
//    100 percent yields zero, the text does not say otherwise).
//  - (e)(4) "rules similar to the rules of subsection (d)" is read as the same definitions, percentage and reduced
//    apportionment over account-level quantities of the Mass Transit Account (`mta_*`), with the same duties.
//  - The (e)(5) shares are exact: the Mass Transit share is the proportional part rounded to cents HALF_UP (no
//    rounding is named), the Highway Account bears the remainder so the two shares add to the transfer.
//  - "Promptly"-type wording is absent here; windows open at the date the text names or stay open.

language "law.core" version "0.2";
package us.irc.trust_funds version "0.1.1";
namespace "urn:us:irc:trust_funds:clir";

use self::{
    FundedTaxReference,
    IRC_S9503_D,
    IRC_S9503_E,
    IRC_S9503_F,
    MassTransitAccount,
    Organ,
    TrustFund,
    net_highway_receipts_estimate,
    unfunded_highway_authorizations_estimate,
};

const SecretaryOfTransportation: Organ = entity_ref("urn:us:irc:trust_funds:clir#SecretaryOfTransportation") {
    label en official "Secretary of Transportation";
}
const HighwayAccount: TrustFund = entity_ref("urn:us:irc:trust_funds:clir#HighwayAccount") {
    label en official "Highway Account (the portion of the Highway Trust Fund which is not the Mass Transit Account, section 9503(e)(5)(B))";
}

// =====================================================================
// (d)(5): definitions
// =====================================================================

relation potential_unpaid_commitments(fy: Text, amount: Money) kind empirical {
    label en unofficial "the total potential unpaid commitments as a result of the apportionment to the States of the amounts authorized to be appropriated from the Highway Trust Fund, at the close of the fiscal year (section 9503(d)(5)(A)(i))";
}
relation highway_fund_balance_at_close(fy: Text, amount: Money) kind empirical {
    label en unofficial "the amount in the Highway Trust Fund at the close of the fiscal year, before defraying unpaid commitments";
}
relation other_unpaid_commitments_payable_from_fund(fy: Text, amount: Money) kind empirical {
    label en unofficial "all other unpaid commitments payable from the Highway Trust Fund at that time (section 9503(d)(5)(A)(ii))";
}
relation amount_available_to_defray_commitments(fy: Text, amount: Money) kind institutional {
    label en unofficial "section 9503(d)(5)(A)(ii): the amount available in the Highway Trust Fund to defray the commitments, after all other unpaid commitments have been defrayed";
}
@source(IRC_S9503_D, relation = formalizes, coverage = exact, quote = "the amount available in the Highway Trust Fund at such time to defray such commitments (after all other unpaid commitments at such time which are payable from the Highway Trust Fund have been defrayed).")
rule S9503d5AAvailable strict {
    for fy: Text;
    for balance: Money;
    for other: Money;
    when highway_fund_balance_at_close(fy, balance) and other_unpaid_commitments_payable_from_fund(fy, other);
    then amount_available_to_defray_commitments(fy, max(0.00 USD, balance - other));
}
@source(IRC_S9503_D, relation = formalizes, coverage = exact, quote = "The term \"unfunded highway authorizations\" means, at any time, the excess (if any) of—")
rule S9503d5AUnfundedAuthorizations strict {
    for fy: Text;
    for potential: Money;
    for available: Money;
    when potential_unpaid_commitments(fy, potential) and amount_available_to_defray_commitments(fy, available);
    then unfunded_highway_authorizations_estimate(fy, max(0.00 USD, potential - available));
}

relation highway_fund_receipts_including_interest(fy: Text, amount: Money) kind empirical {
    label en unofficial "the receipts (including interest) of the Highway Trust Fund during the 48-month period beginning at the close of the fiscal year (section 9503(d)(5)(B)(i))";
}
relation highway_fund_transfers_under_c_other_than_c1(fy: Text, amount: Money) kind empirical {
    label en unofficial "the amounts to be transferred during that period from the Highway Trust Fund under subsection (c), other than paragraph (1) (section 9503(d)(5)(B)(ii))";
}
@source(IRC_S9503_D, relation = formalizes, coverage = exact, quote = "The term \"net highway receipts\" means, with respect to any period, the excess of—")
rule S9503d5BNetReceipts strict {
    for fy: Text;
    for receipts: Money;
    for transfers: Money;
    when highway_fund_receipts_including_interest(fy, receipts) and highway_fund_transfers_under_c_other_than_c1(fy, transfers);
    then net_highway_receipts_estimate(fy, max(0.00 USD, receipts - transfers));
}

// =====================================================================
// (d)(6): assumptions for the estimate
// =====================================================================

relation expiring_provision_of_subsection_b(fy: Text, provision: Text) kind empirical {
    label en unofficial "a provision of subsection (b) related to appropriations or transfers to the Highway Trust Fund that expires before the end of the 48-month period";
}
relation provision_treated_as_extended(fy: Text, provision: Text) kind institutional {
    label en unofficial "section 9503(d)(6)(A): the expiring provision is treated as extended through the end of the 48-month period in making the estimate";
}
@source(IRC_S9503_D, relation = formalizes, coverage = exact, quote = "each expiring provision of subsection (b) which is related to appropriations or transfers to the Highway Trust Fund to have been extended through the end of the 48-month period referred to in paragraph (1)(B), and")
rule S9503d6AExtendedProvision strict {
    for fy: Text;
    for provision: Text;
    when expiring_provision_of_subsection_b(fy, provision);
    then provision_treated_as_extended(fy, provision);
}
relation tax_rate_on_estimate_date(fy: Text, tax: FundedTaxReference, rate: Decimal) kind empirical {
    label en unofficial "the rate of the tax under the sections referred to in subsection (b)(1) as in effect on the date of the estimate";
}
relation assumed_tax_rate_for_48_month_period(fy: Text, tax: FundedTaxReference, rate: Decimal) kind institutional {
    label en unofficial "section 9503(d)(6)(B): the rate of the tax during the 48-month period is treated as the same as on the date of the estimate";
}
@source(IRC_S9503_D, relation = formalizes, coverage = exact, quote = "with respect to each tax imposed under the sections referred to in subsection (b)(1), the rate of such tax during the 48-month period referred to in paragraph (1)(B) to be the same as the rate of such tax as in effect on the date of such estimate.")
rule S9503d6BAssumedRate strict {
    for fy: Text;
    for tax: FundedTaxReference;
    for rate: Decimal;
    when tax_rate_on_estimate_date(fy, tax, rate);
    then assumed_tax_rate_for_48_month_period(fy, tax, rate);
}

// =====================================================================
// (d)(2)-(3): excess amount, percentage, new estimate, reduced apportionment
// =====================================================================

relation excess_amount_of_estimate(fy: Text, amount: Money) kind institutional {
    label en unofficial "section 9503(d)(2)(B): the amount by which the estimated unfunded highway authorizations exceed the estimated net highway receipts";
}
@source(IRC_S9503_D, relation = formalizes, coverage = exact, quote = "he shall further advise the Secretary of Transportation as to the amount of such excess.")
rule S9503d2BExcessAmount strict {
    for fy: Text;
    for unfunded: Money;
    for net: Money;
    when unfunded_highway_authorizations_estimate(fy, unfunded) and net_highway_receipts_estimate(fy, net) and unfunded > net;
    then excess_amount_of_estimate(fy, unfunded - net);
}
relation authorized_for_apportionment_to_states(fy: Text, amount: Money) kind empirical {
    label en unofficial "the amount authorized to be appropriated from the Trust Fund for the fiscal year for apportionment to the States (section 9503(d)(3)(A)(ii))";
}
relation prior_apportionment_to_states_made(fy: Text) kind empirical {
    label en unofficial "an apportionment to the States for the fiscal year has already been made";
}
relation withholding_percentage(fy: Text, percentage: Decimal) kind institutional {
    label en unofficial "section 9503(d)(3)(A): the percentage (fraction of 1) which the excess is of the amount authorized for apportionment to the States";
}
@source(IRC_S9503_D, relation = formalizes, coverage = exact, quote = "the Secretary of Transportation shall determine the percentage which—")
rule S9503d3APercentage strict {
    for fy: Text;
    for excess: Money;
    for authorized: Money;
    when excess_amount_of_estimate(fy, excess) and authorized_for_apportionment_to_states(fy, authorized) and authorized > 0.00 USD and not_known(prior_apportionment_to_states_made(fy));
    then withholding_percentage(fy, div_round(excess / 1.00 USD, authorized / 1.00 USD, 6, "HALF_UP"));
}
relation percentage_determination_made(fy: Text) kind empirical;
@source(IRC_S9503_D, relation = formalizes, coverage = exact, quote = "If, before any apportionment to the States is made, in the most recent estimate made by the Secretary of the Treasury there is an excess referred to in paragraph (2)(B), the Secretary of Transportation shall determine the percentage which—")
rule S9503d3ADeterminationDuty defeasible {
    for fy: Text;
    for excess: Money;
    when excess_amount_of_estimate(fy, excess) and not_known(prior_apportionment_to_states_made(fy));
    then duty S9503d3ADeterminePercentage {
        bearer SecretaryOfTransportation;
        goal achievement {
            condition percentage_determination_made(fy);
            window [-infinity, infinity]; // "before any apportionment": the upper bound is the apportionment date, not modelled as a Date here
        }
    };
}
relation most_recent_estimate_date(fy: Text, d: Date) kind empirical;
relation apportionment_date(fy: Text, d: Date) kind empirical;
relation new_estimate_made(fy: Text) kind empirical;
@source(IRC_S9503_D, relation = formalizes, coverage = exact, quote = "If, but for this sentence, the most recent estimate would be one which was made on a date which will be more than 3 months before the date of the apportionment, the Secretary of the Treasury shall make a new estimate under paragraph (1) for the appropriate fiscal year.")
rule S9503d3AStaleEstimateDuty defeasible {
    for fy: Text;
    for estimated: Date;
    for apportioned: Date;
    when most_recent_estimate_date(fy, estimated) and apportionment_date(fy, apportioned) and apportioned > add_calendar_period(estimated, 3 calendar_month);
    then duty S9503d3ANewEstimate {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition new_estimate_made(fy);
            window [-infinity, apportioned];
        }
    };
}
relation amount_withheld_from_apportionment(fy: Text, amount: Money) kind institutional {
    label en unofficial "the part of the authorized amount withheld from apportionment under (d)(3)(B): the percentage of the authorized amount, at most all of it";
}
relation apportioned_amount_after_reduction(fy: Text, amount: Money) kind institutional {
    label en unofficial "section 9503(d)(3)(B): the amount authorized to be apportioned reduced by the percentage";
}
@source(IRC_S9503_D, relation = formalizes, coverage = exact, quote = "the amount obtained by reducing the amount authorized to be so apportioned by such percentage.")
rule S9503d3BWithheld strict {
    for fy: Text;
    for excess: Money;
    for authorized: Money;
    when withholding_percentage(fy, _) and excess_amount_of_estimate(fy, excess) and authorized_for_apportionment_to_states(fy, authorized) and authorized > 0.00 USD;
    then amount_withheld_from_apportionment(fy, min(authorized, div_round(authorized * (excess / 1.00 USD), authorized / 1.00 USD, 2, "HALF_UP")));
}
@source(IRC_S9503_D, relation = formalizes, coverage = exact, quote = "the Secretary of Transportation shall apportion to the States (in lieu of the amount which, but for the provisions of this subsection, would be so apportioned)")
rule S9503d3BReducedApportionment strict {
    for fy: Text;
    for authorized: Money;
    for withheld: Money;
    when authorized_for_apportionment_to_states(fy, authorized) and amount_withheld_from_apportionment(fy, withheld);
    then apportioned_amount_after_reduction(fy, authorized - withheld);
}
relation reduced_amount_apportioned(fy: Text, amount: Money) kind empirical;
@source(IRC_S9503_D, relation = formalizes, coverage = exact, quote = "If the Secretary of Transportation determines a percentage under subparagraph (A) for purposes of any apportionment, notwithstanding any other provision of law, the Secretary of Transportation shall apportion to the States")
rule S9503d3BApportionDuty defeasible {
    for fy: Text;
    for amount: Money;
    when apportioned_amount_after_reduction(fy, amount);
    then duty S9503d3BApportionReducedAmount {
        bearer SecretaryOfTransportation;
        goal achievement {
            condition reduced_amount_apportioned(fy, amount);
            window [-infinity, infinity];
        }
    };
}

// =====================================================================
// (d)(4): apportionment of amounts previously withheld
// =====================================================================

relation redetermined_excess_amount(fy: Text, amount: Money) kind empirical {
    label en unofficial "the excess described in paragraph (1)(B) as redetermined by the Secretary of the Treasury after funds were withheld (zero when the amount in (1)(A) does not exceed the amount in (1)(B))";
}
relation withheld_amount_releasable(fy: Text, amount: Money) kind institutional {
    label en unofficial "section 9503(d)(4): the part of the withheld funds that may be apportioned without causing the amount in (1)(A) to exceed the amount in (1)(B)";
}
@source(IRC_S9503_D, relation = formalizes, coverage = exact, quote = "The Secretary of Transportation shall apportion to the States such portion of the funds so withheld from apportionment as the Secretary of the Treasury has advised him may be so apportioned without causing the amount described in paragraph (1)(A) to exceed the amount described in paragraph (1)(B).")
rule S9503d4Releasable strict {
    for fy: Text;
    for withheld: Money;
    for previous: Money;
    for redetermined: Money;
    when amount_withheld_from_apportionment(fy, withheld) and excess_amount_of_estimate(fy, previous) and redetermined_excess_amount(fy, redetermined) and redetermined < previous;
    then withheld_amount_releasable(fy, withheld - min(withheld, redetermined));
}
relation redetermination_advised(fy: Text) kind empirical;
@source(IRC_S9503_D, relation = formalizes, coverage = exact, quote = "he shall so advise the Secretary of Transportation.")
rule S9503d4AdviseDuty defeasible {
    for fy: Text;
    for previous: Money;
    for redetermined: Money;
    when excess_amount_of_estimate(fy, previous) and redetermined_excess_amount(fy, redetermined) and redetermined < previous and amount_withheld_from_apportionment(fy, _);
    then duty S9503d4AdviseTransportation {
        bearer us.irc.core::Secretary;
        beneficiary SecretaryOfTransportation;
        goal achievement {
            condition redetermination_advised(fy);
            window [-infinity, infinity];
        }
    };
}
relation released_funds_apportioned(fy: Text, amount: Money) kind empirical;
@source(IRC_S9503_D, relation = formalizes, coverage = exact, quote = "The Secretary of Transportation shall apportion to the States such portion of the funds so withheld from apportionment")
rule S9503d4ApportionDuty defeasible {
    for fy: Text;
    for amount: Money;
    when withheld_amount_releasable(fy, amount) and amount > 0.00 USD;
    then duty S9503d4ApportionReleasedFunds {
        bearer SecretaryOfTransportation;
        goal achievement {
            condition released_funds_apportioned(fy, amount);
            window [-infinity, infinity];
        }
    };
}
relation released_funds_apportioned_in(fy: Text, apportionment_fy: Text) kind empirical;
relation released_funds_available_as_if_apportioned_with(fy: Text, apportionment_fy: Text) kind institutional {
    label en unofficial "section 9503(d)(4), last sentence: the funds remain available for the period for which they would be available if the apportionment took effect with the fiscal year in which they are apportioned";
}
@source(IRC_S9503_D, relation = formalizes, coverage = exact, quote = "Any funds apportioned pursuant to the preceding sentence shall remain available for the period for which they would be available if such apportionment took effect with the fiscal year in which they are apportioned pursuant to the preceding sentence.")
rule S9503d4AvailabilityPeriod strict {
    for fy: Text;
    for apportionment_fy: Text;
    for amount: Money;
    when released_funds_apportioned(fy, amount) and released_funds_apportioned_in(fy, apportionment_fy);
    then released_funds_available_as_if_apportioned_with(fy, apportionment_fy);
}

// =====================================================================
// (e)(4): rules similar to (d) apply to the Mass Transit Account
// =====================================================================

relation mta_potential_unpaid_commitments(fy: Text, amount: Money) kind empirical;
relation mta_balance_at_close(fy: Text, amount: Money) kind empirical;
relation mta_other_unpaid_commitments(fy: Text, amount: Money) kind empirical;
relation mta_receipts_including_interest(fy: Text, amount: Money) kind empirical;
relation mta_transfers_out(fy: Text, amount: Money) kind empirical;
relation mta_unfunded_authorizations(fy: Text, amount: Money) kind institutional {
    label en unofficial "section 9503(e)(4) with (d)(5)(A): the unfunded authorizations of the Mass Transit Account (potential unpaid commitments minus the amount available after other unpaid commitments, floored at zero)";
}
relation mta_net_receipts(fy: Text, amount: Money) kind institutional {
    label en unofficial "section 9503(e)(4) with (d)(5)(B): the net receipts of the Mass Transit Account (receipts including interest minus transfers out, floored at zero)";
}
@source(IRC_S9503_E, relation = formalizes, coverage = partial, quote = "Rules similar to the rules of subsection (d) shall apply to the Mass Transit Account.")
rule S9503e4MtaUnfunded strict {
    for fy: Text;
    for potential: Money;
    for balance: Money;
    for other: Money;
    when mta_potential_unpaid_commitments(fy, potential) and mta_balance_at_close(fy, balance) and mta_other_unpaid_commitments(fy, other);
    then mta_unfunded_authorizations(fy, max(0.00 USD, potential - max(0.00 USD, balance - other)));
}
@source(IRC_S9503_E, relation = formalizes, coverage = partial, quote = "Rules similar to the rules of subsection (d) shall apply to the Mass Transit Account.")
rule S9503e4MtaNetReceipts strict {
    for fy: Text;
    for receipts: Money;
    for transfers: Money;
    when mta_receipts_including_interest(fy, receipts) and mta_transfers_out(fy, transfers);
    then mta_net_receipts(fy, max(0.00 USD, receipts - transfers));
}
relation mta_excess_amount(fy: Text, amount: Money) kind institutional;
@source(IRC_S9503_E, relation = formalizes, coverage = partial, quote = "Rules similar to the rules of subsection (d) shall apply to the Mass Transit Account.")
rule S9503e4MtaExcess strict {
    for fy: Text;
    for unfunded: Money;
    for net: Money;
    when mta_unfunded_authorizations(fy, unfunded) and mta_net_receipts(fy, net) and unfunded > net;
    then mta_excess_amount(fy, unfunded - net);
}
relation mta_authorized_for_apportionment(fy: Text, amount: Money) kind empirical;
relation mta_withholding_percentage(fy: Text, percentage: Decimal) kind institutional;
relation mta_apportioned_amount_after_reduction(fy: Text, amount: Money) kind institutional;
@source(IRC_S9503_E, relation = formalizes, coverage = partial, quote = "Rules similar to the rules of subsection (d) shall apply to the Mass Transit Account.")
rule S9503e4MtaPercentage strict {
    for fy: Text;
    for excess: Money;
    for authorized: Money;
    when mta_excess_amount(fy, excess) and mta_authorized_for_apportionment(fy, authorized) and authorized > 0.00 USD;
    then mta_withholding_percentage(fy, div_round(excess / 1.00 USD, authorized / 1.00 USD, 6, "HALF_UP"));
}
@source(IRC_S9503_E, relation = formalizes, coverage = partial, quote = "Rules similar to the rules of subsection (d) shall apply to the Mass Transit Account.")
rule S9503e4MtaReducedApportionment strict {
    for fy: Text;
    for excess: Money;
    for authorized: Money;
    when mta_withholding_percentage(fy, _) and mta_excess_amount(fy, excess) and mta_authorized_for_apportionment(fy, authorized) and authorized > 0.00 USD;
    then mta_apportioned_amount_after_reduction(fy, authorized - min(authorized, div_round(authorized * (excess / 1.00 USD), authorized / 1.00 USD, 2, "HALF_UP")));
}

// =====================================================================
// (e)(5): pro-rata sharing of (c)(2) and (c)(3) transfers
// =====================================================================

relation highway_account_portion_defined(f: TrustFund) kind institutional {
    label en unofficial "section 9503(e)(5)(B): the Highway Account is the portion of the Highway Trust Fund which is not the Mass Transit Account";
}
@source(IRC_S9503_E, relation = formalizes, coverage = exact, quote = "the term \"Highway Account\" means the portion of the Highway Trust Fund which is not the Mass Transit Account.")
rule S9503e5BHighwayAccount strict { then highway_account_portion_defined(HighwayAccount); }
relation revenue_transferred_to_account_item(account: TrustFund, item: Text, amount: Money) kind empirical {
    label en unofficial "a recorded revenue transferred under section 9503 to the Highway Account (after the application of paragraph (2)) or to the Mass Transit Account";
}
relation transfer_to_be_borne(t: Text, amount: Money) kind empirical {
    label en unofficial "a transfer under paragraph (2) or (3) of subsection (c) to be borne by the two accounts";
}
relation transfer_share_borne_by_mass_transit(t: Text, amount: Money) kind institutional;
relation transfer_share_borne_by_highway_account(t: Text, amount: Money) kind institutional;
@source(IRC_S9503_E, relation = formalizes, coverage = exact, quote = "Transfers under paragraphs (2) and (3) of subsection (c) shall be borne by the Highway Account and the Mass Transit Account in proportion to the respective revenues transferred under this section")
rule S9503e5AMassTransitShare strict {
    for t: Text;
    for amount: Money;
    when transfer_to_be_borne(t, amount)
        and sum(collect all h0: Money, i0: Text where revenue_transferred_to_account_item(HighwayAccount, i0, h0), empty: 0.00 USD) + sum(collect all m0: Money, j0: Text where revenue_transferred_to_account_item(MassTransitAccount, j0, m0), empty: 0.00 USD) > 0.00 USD;
    then transfer_share_borne_by_mass_transit(t, div_round(amount * (sum(collect all m1: Money, j1: Text where revenue_transferred_to_account_item(MassTransitAccount, j1, m1), empty: 0.00 USD) / 1.00 USD),
        (sum(collect all h1: Money, i1: Text where revenue_transferred_to_account_item(HighwayAccount, i1, h1), empty: 0.00 USD) + sum(collect all m2: Money, j2: Text where revenue_transferred_to_account_item(MassTransitAccount, j2, m2), empty: 0.00 USD)) / 1.00 USD, 2, "HALF_UP"));
}
@source(IRC_S9503_E, relation = formalizes, coverage = exact, quote = "shall be borne by the Highway Account and the Mass Transit Account in proportion to the respective revenues transferred under this section to the Highway Account (after the application of paragraph (2)) and the Mass Transit Account.")
rule S9503e5AHighwayShare strict {
    for t: Text;
    for amount: Money;
    for mta_share: Money;
    when transfer_share_borne_by_mass_transit(t, mta_share) and transfer_to_be_borne(t, amount);
    then transfer_share_borne_by_highway_account(t, amount - mta_share);
}

// =====================================================================
// (f)(1): opening balance restatement
// =====================================================================

relation account_opening_balance(account: TrustFund, on: Date, amount: Money) kind institutional {
    label en unofficial "section 9503(f)(1): the opening balance of the Highway Trust Fund (other than the Mass Transit Account) on October 1, 1998";
}
@source(IRC_S9503_F, relation = formalizes, coverage = exact, quote = "the opening balance of the Highway Trust Fund (other than the Mass Transit Account) on October 1, 1998, shall be $8,000,000,000.")
rule S9503f1OpeningBalance strict { then account_opening_balance(HighwayAccount, @1998-10-01, 8000000000 USD); }
relation highway_account_balance_before_restatement(amount: Money) kind empirical {
    label en unofficial "the balance of the Highway Account on October 1, 1998 that would apply but for section 9503(f)(1)";
}
relation opening_balance_reduction(amount: Money) kind institutional {
    label en unofficial "the reduction in the balance under section 9503(f)(1)";
}
@source(IRC_S9503_F, relation = formalizes, coverage = exact, quote = "The Secretary shall cancel obligations held by the Highway Trust Fund to reflect the reduction in the balance under this paragraph.")
rule S9503f1Reduction strict {
    for prior: Money;
    when highway_account_balance_before_restatement(prior) and prior > 8000000000 USD;
    then opening_balance_reduction(prior - 8000000000 USD);
}
relation obligations_cancelled_to_reflect_reduction(amount: Money) kind empirical;
@source(IRC_S9503_F, relation = formalizes, coverage = exact, quote = "The Secretary shall cancel obligations held by the Highway Trust Fund to reflect the reduction in the balance under this paragraph.")
rule S9503f1CancelDuty defeasible {
    for amount: Money;
    when opening_balance_reduction(amount);
    then duty S9503f1CancelObligations {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition obligations_cancelled_to_reflect_reduction(amount);
            window [@1998-10-01, infinity];
        }
    };
}
relation account_credit_item(account: TrustFund, item: Text, on: Date, amount: Money) kind empirical;
relation account_outlay_item(account: TrustFund, item: Text, on: Date, amount: Money) kind empirical;
relation balance_determination_requested(account: TrustFund, on: Date) kind empirical;
relation account_balance_on(account: TrustFund, on: Date, amount: Money) kind institutional {
    label en unofficial "section 9503(f)(1): the balance of the Highway Account after September 30, 1998 = the restated opening balance plus recorded credits minus recorded outlays after that date, up to the date";
}
@source(IRC_S9503_F, relation = formalizes, coverage = exact, quote = "For purposes of determining the balances of the Highway Trust Fund and the Mass Transit Account after September 30, 1998")
rule S9503f1BalanceAfterRestatement strict {
    for d: Date;
    for opening: Money;
    when balance_determination_requested(HighwayAccount, d) and account_opening_balance(HighwayAccount, @1998-10-01, opening) and d >= @1998-10-01;
    then account_balance_on(HighwayAccount, d, opening
        + sum(collect all c: Money, ci: Text, cd: Date where account_credit_item(HighwayAccount, ci, cd, c) and cd > @1998-09-30 and cd <= d, empty: 0.00 USD)
        - sum(collect all o: Money, oi: Text, od: Date where account_outlay_item(HighwayAccount, oi, od, o) and od > @1998-09-30 and od <= d, empty: 0.00 USD));
}
