test "S9501-06-EXPENDITURE-AUTHORIZED-BENEFITS-NO-LIABLE-OPERATOR" {
    given {
        context { decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; legal_time @2026-01-15; timezone "America/New_York"; }
        assert expenditure_from_fund(entity_ref("urn:us:irc:trust_funds:clir#E1"), BlackLungDisabilityTrustFund) { id "f0"; origin case_input; }
        assert black_lung_expenditure_purpose(entity_ref("urn:us:irc:trust_funds:clir#E1"), BenefitsWhereNoLiableOperator) { id "f1"; origin case_input; }
        assert labor_secretary_determines_benefit_payable(BenefitsWhereNoLiableOperator) { id "f2"; origin case_input; }
    }
    evaluate truth(expenditure_authorized(entity_ref("urn:us:irc:trust_funds:clir#E1"), BlackLungDisabilityTrustFund));
    expect truth_status == TRUE_ONLY;
}

