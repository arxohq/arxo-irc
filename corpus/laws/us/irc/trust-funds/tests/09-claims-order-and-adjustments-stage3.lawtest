test "S9507E3-01-LATER-CLAIM-PAID-FIRST-IS-OUT-OF-ORDER" {
    given {
        context {
            legal_time @2024-05-15;
            decision_time @2024-05-15T09:00:00-05:00;
            knowledge_time @2024-05-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": claim_against_fund(entity_ref("urn:test:s9507e301laterclaimpaidfirstisoutoforder#c1"), HazardousSubstanceSuperfund, 1000000 USD) { origin case_input; }
        assert "f1": claim_against_fund(entity_ref("urn:test:s9507e301laterclaimpaidfirstisoutoforder#c2"), HazardousSubstanceSuperfund, 2000000 USD) { origin case_input; }
        assert "f2": claim_finally_determined_on(entity_ref("urn:test:s9507e301laterclaimpaidfirstisoutoforder#c1"), @2024-01-10) { origin case_input; }
        assert "f3": claim_finally_determined_on(entity_ref("urn:test:s9507e301laterclaimpaidfirstisoutoforder#c2"), @2024-02-10) { origin case_input; }
        assert "f4": fund_insufficient_to_pay_all_claims(HazardousSubstanceSuperfund, @2024-05-01) { origin case_input; }
        assert "f5": claim_paid_in_full_on(entity_ref("urn:test:s9507e301laterclaimpaidfirstisoutoforder#c2"), @2024-05-01) { origin case_input; }
    }
    evaluate truth(payment_out_of_order(entity_ref("urn:test:s9507e301laterclaimpaidfirstisoutoforder#c2"), HazardousSubstanceSuperfund, @2024-05-01));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

