// Scenarios for §9601 (monthly transfer duty) and §9602 (report, investment,
// sale powers). NOT executed (NO-HEAVY-CHECKS) — implemented_unverified.

language "law.core" version "0.2";
package us.irc.trust_funds version "0.1.1";
namespace "urn:us:irc:trust_funds:clir";

test "S9601-01-MONTHLY-TRANSFER-DUTY-SATISFIED" {
    given {
        context { decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; legal_time @2026-01-15; timezone "America/New_York"; }
        assert monthly_transfer_cycle_open(BlackLungDisabilityTrustFund, entity_ref("urn:us:irc:trust_funds:clir#Jan2026")) { id "f0"; origin case_input; }
        assert monthly_transfer_made(BlackLungDisabilityTrustFund, entity_ref("urn:us:irc:trust_funds:clir#Jan2026")) { id "f1"; origin case_input; }
    }
    evaluate positions();
    expect position(S9601MonthlyTransfer, SATISFIED);
}

test "S9601-02-MONTHLY-TRANSFER-DUTY-OPEN-WHEN-NOT-YET-MADE" {
    given {
        context { decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; legal_time @2026-01-15; timezone "America/New_York"; }
        assert monthly_transfer_cycle_open(BlackLungDisabilityTrustFund, entity_ref("urn:us:irc:trust_funds:clir#Feb2026")) { id "f0"; origin case_input; }
    }
    evaluate truth(monthly_transfer_made(BlackLungDisabilityTrustFund, entity_ref("urn:us:irc:trust_funds:clir#Feb2026")));
    expect truth_status == NEITHER;
}

test "S9602-01-SECRETARY-HOLDS-ESTABLISHED-FUNDS" {
    given { context { decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; legal_time @2026-01-15; timezone "America/New_York"; } }
    evaluate truth(holds_trust_funds(us.irc.core::Secretary));
    expect truth_status == TRUE_ONLY;
}

test "S9602-02-ANNUAL-REPORT-DUTY-SATISFIED" {
    given {
        context { decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; legal_time @2026-01-15; timezone "America/New_York"; }
        assert fy_holds_for_any_year(entity_ref("urn:us:irc:trust_funds:clir#FY2025")) { id "f0"; origin case_input; }
        assert trust_fund_report_made(entity_ref("urn:us:irc:trust_funds:clir#FY2025")) { id "f1"; origin case_input; }
    }
    evaluate positions();
    expect position(S9602AnnualReport, SATISFIED);
}

test "S9602-03-INVESTMENT-DUTY-ON-JUDGED-SURPLUS" {
    given {
        context { decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; legal_time @2026-01-15; timezone "America/New_York"; }
        assert investable_surplus(BlackLungDisabilityTrustFund, 3000000 USD) { id "f0"; origin case_input; }
        assert invests_at(BlackLungDisabilityTrustFund, 3000000 USD, true) { id "f1"; origin case_input; }
    }
    evaluate positions();
    expect position(S9602Invest, SATISFIED);
}

test "S9602-04-SALE-POWER-VALID-WHEN-OBLIGATION-ACQUIRED" {
    given {
        context { decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; legal_time @2026-01-15; timezone "America/New_York"; }
        assert obligation_acquired(BlackLungDisabilityTrustFund, 1000000 USD) { id "f0"; origin case_input; }
        assert sells_obligation(BlackLungDisabilityTrustFund, 1000000 USD) { id "f1"; origin case_input; }
    }
    evaluate truth(amount_credited_to_fund(BlackLungDisabilityTrustFund, 1000000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S9602-05-SALE-POWER-INVALID-WITHOUT-PRIOR-ACQUISITION" {
    given {
        context { decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; legal_time @2026-01-15; timezone "America/New_York"; }
        assert sells_obligation(BlackLungDisabilityTrustFund, 1000000 USD) { id "f0"; origin case_input; }
    }
    evaluate truth(amount_credited_to_fund(BlackLungDisabilityTrustFund, 1000000 USD));
    expect truth_status == NEITHER;
}

test "S9602-06-INTEREST-AND-SALE-PROCEEDS-CREDITED" {
    given {
        context { decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; legal_time @2026-01-15; timezone "America/New_York"; }
        assert interest_or_sale_proceeds(BlackLungDisabilityTrustFund, 25000 USD) { id "f0"; origin case_input; }
    }
    evaluate truth(amount_credited_to_fund(BlackLungDisabilityTrustFund, 25000 USD));
    expect truth_status == TRUE_ONLY;
}
