language "law.core" version "0.2";
package us.irc.trust_funds version "0.1.1";
namespace "urn:us:irc:trust_funds:clir";


test "S9503D5A-01-AVAILABLE-AMOUNT-IS-BALANCE-MINUS-OTHER-COMMITMENTS" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": highway_fund_balance_at_close("FY2027", 100000000000 USD) { origin case_input; }
        assert "f1": other_unpaid_commitments_payable_from_fund("FY2027", 30000000000 USD) { origin case_input; }
    }
    evaluate truth(amount_available_to_defray_commitments("FY2027", 70000000000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

