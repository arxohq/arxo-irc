        assert "f3": revenue_transferred_to_account_item(MassTransitAccount, "m2", 1000000000 USD) { origin case_input; }
        assert "f4": transfer_to_be_borne("t1", 400000000 USD) { origin case_input; }
    }
    evaluate truth(transfer_share_borne_by_mass_transit("t1", 100000000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

