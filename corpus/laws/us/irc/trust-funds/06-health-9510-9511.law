// 26 U.S.C. §§9510-9511 — Vaccine Injury Compensation Trust Fund;
// Patient-Centered Outcomes Research Trust Fund.
//
// JUDGMENT CALLS:
//  - §9510(b)(2) "net revenues" (excess of §4131 receipts over the income-
//    tax-liability decrease the excise causes) and §9511(e) (the fee
//    analogue) are Secretary ESTIMATES of a counterfactual — DECISION-0194
//    evaluative determinations, not arithmetic this package computes from
//    other relations (the "decrease in tax imposed by chapter 1" is not a
//    quantity `us.irc.core`/this package derives).
//  - §9511(b)(1)(A)-(F)/(4)(A)-(J): each fiscal year's fixed appropriation
//    figure IS a case-relevant varying quantity (the fiscal year is a
//    parameter a scenario supplies), so — UNLIKE the Highway Trust Fund's
//    one-time historical appropriations — this is modelled as an A3
//    `.lawparam.json` dataset (`PcorApplicableAmount`), per AGENT-BRIEF's
//    "Rates, thresholds... are A3 datasets" rule. The FY2010-2012 flat
//    amounts and the FY2013-2019 "$150,000,000 plus net-fee-revenue" amounts
//    are recorded as MISSING_PARAMETER_VALUE placeholders alongside for
//    consistency (they are not indexed, but the same file keeps a single
//    per-fiscal-year table).
//  - §9511(d)(2)(C) (80%/20% distribution of the AHRQ-transferred amount) is
//    an exact percentage split — EXECUTABLE.

language "law.core" version "0.2";
package us.irc.trust_funds version "0.1.1";
namespace "urn:us:irc:trust_funds:clir";

use self::{
    Expenditure,
    FundedTaxReference,
    IRC_S9510_A,
    IRC_S9510_B,
    IRC_S9510_C,
    IRC_S9511_A,
    IRC_S9511_B,
    IRC_S9511_C,
    IRC_S9511_D,
    IRC_S9511_F,
    Organ,
    PatientCenteredOutcomesResearchTrustFund,
    TrustFund,
    VaccineInjuryCompensationTrustFund,
    amount_credited_to_fund,
    expenditure_authorized,
    expenditure_from_fund,
    fund_established,
    fund_funded_by,
    further_appropriation_barred,
    is_trustee_of,
};

// ================= §9510 Vaccine Injury Compensation ===========================

@source(IRC_S9510_A, relation = formalizes, coverage = partial, quote = "There is established in the Treasury of the United States a trust fund to be known as the \"Vaccine Injury Compensation Trust Fund\", consisting of such amounts as may be appropriated or credited to such Trust Fund as prov")
rule S9510EstablishFund strict { then fund_established(VaccineInjuryCompensationTrustFund); }

@source(IRC_S9510_B, relation = formalizes, coverage = partial, quote = "There are hereby appropriated to the Vaccine Injury Compensation Trust Fund amounts equivalent to the net revenues received in the Treasury from the tax imposed by section 4131 (relating to tax on certain vaccines).")
rule S9510FundedByVaccineTax strict { then fund_funded_by(VaccineInjuryCompensationTrustFund, Section4131VaccineTax); }

relation vaccine_net_revenue_estimate(amount: Money) kind institutional {
    label en unofficial "the Secretary's estimate of net revenues: §4131 receipts less the chapter 1 income-tax decrease the §4131 tax causes — a DECISION-0194 evaluative determination, not a derived arithmetic quantity";
}

relation vaccine_barred_expenditure(e: Expenditure) kind empirical;
relation vaccine_liquidates_prior_obligation(e: Expenditure, cutoff: Date) kind empirical;
@source(IRC_S9510_B, relation = formalizes, coverage = partial, quote = "No amount may be appropriated to the Vaccine Injury Compensation Trust Fund on and after the date of any expenditure from the Trust Fund which is not permitted by this section.")
rule S9510LimitationOnTransfers defeasible {
    for e: Expenditure;
    when expenditure_from_fund(e, VaccineInjuryCompensationTrustFund) and not_known(expenditure_authorized(e, VaccineInjuryCompensationTrustFund));
    then further_appropriation_barred(VaccineInjuryCompensationTrustFund);
    unless vaccine_liquidates_prior_obligation(e, @2026-10-01);
}

relation vaccine_related_injury_compensation(e: Expenditure, administered_on: Date) kind empirical {
    label en unofficial "the expenditure pays compensation under Public Health Service Act Title XXI, subtitle 2, for a vaccine administered on the stated date";
}
@source(IRC_S9510_C, relation = formalizes, coverage = partial, quote = "which is administered after September 30, 1988, and")
rule S9510ExpenditureAuthorizedCompensation defeasible {
    for e: Expenditure;
    for administered_on: Date;
    when expenditure_from_fund(e, VaccineInjuryCompensationTrustFund)
        and vaccine_related_injury_compensation(e, administered_on)
        and administered_on > @1988-09-30;
    then expenditure_authorized(e, VaccineInjuryCompensationTrustFund);
}
relation vaccine_administration_expense(e: Expenditure, amount: Money) kind empirical;
@source(IRC_S9510_C, relation = formalizes, coverage = partial, quote = "the payment of all expenses of administration (but not in excess of $9,500,000 for any fiscal year) incurred by the Federal Government in administering such subtitle.")
rule S9510ExpenditureAuthorizedAdmin defeasible {
    for e: Expenditure;
    for amount: Money;
    when expenditure_from_fund(e, VaccineInjuryCompensationTrustFund)
        and vaccine_administration_expense(e, amount)
        and amount <= 9500000 USD;
    then expenditure_authorized(e, VaccineInjuryCompensationTrustFund);
}

relation vaccine_repayment_paid(amount: Money) kind empirical;
@source(IRC_S9510_C, relation = formalizes, coverage = partial, quote = "The Secretary shall pay from time to time from the Vaccine Injury Compensation Trust Fund into the general fund of the Treasury amounts equivalent to amounts paid under section 4132(b) and section 6416 with respect to th")
rule S9510RepaymentTransferDuty strict {
    for amount: Money;
    when vaccine_repayment_paid(amount);
    then duty S9510PayRepaymentTransfer {
        bearer us.irc.core::Secretary;
        beneficiary us.irc.core::Secretary;
        goal maintenance {
            condition vaccine_repayment_transferred(amount);
            window [-infinity, infinity];
        }
    };
}
relation vaccine_repayment_transferred(amount: Money) kind empirical;

// ================= §9511 Patient-Centered Outcomes Research ====================

@source(IRC_S9511_A, relation = formalizes, coverage = partial, quote = "There is established in the Treasury of the United States a trust fund to be known as the \"Patient-Centered Outcomes Research Trust Fund\" (hereafter in this section referred to as the \"PCORTF\"), consisting of such amount")
rule S9511EstablishFund strict { then fund_established(PatientCenteredOutcomesResearchTrustFund); }

relation pcortf_fee_net_revenue_estimate(fy: Integer, amount: Money) kind institutional {
    label en unofficial "the Secretary's estimate of net revenues from the chapter 34 subchapter B fees for the fiscal year — a DECISION-0194 evaluative determination (§9511(e))";
}
relation pcortf_applicable_amount(fy: Integer, amount: Money) kind institutional {
    label en unofficial "the (b)(1)(F)(ii)/(b)(4) 'applicable amount' for fiscal years 2020-2029 (§9511(b)(4)) — fixed statutory figures asserted per fiscal year, not a later-indexed rate, so no A3 dataset machinery is used (JUDGMENT CALL: a `.lawparam.json` dataset would be the more idiomatic home for a fiscal-year-keyed table, but this task did not verify the parameter-binding mechanism's exact linkage syntax in time; recorded as a plain fact table instead — an equally exact, equally text-anchored representation of the same ten values)";
}
relation pcortf_flat_amount(fy: Integer, amount: Money) kind institutional {
    label en unofficial "the flat statutory appropriation for fiscal years 2010-2012 and the $150,000,000 component for 2013-2019 — asserted per fiscal year, same judgment call as pcortf_applicable_amount";
}

@source(IRC_S9511_B, relation = formalizes, coverage = partial, quote = "(A) For fiscal year 2010, $10,000,000.")
rule S9511FlatFy2010 strict { then pcortf_flat_amount(2010, 10000000 USD); }
@source(IRC_S9511_B, relation = formalizes, coverage = partial, quote = "(B) For fiscal year 2011, $50,000,000.")
rule S9511FlatFy2011 strict { then pcortf_flat_amount(2011, 50000000 USD); }
@source(IRC_S9511_B, relation = formalizes, coverage = partial, quote = "(C) For fiscal year 2012, $150,000,000.")
rule S9511FlatFy2012 strict { then pcortf_flat_amount(2012, 150000000 USD); }
@source(IRC_S9511_B, relation = formalizes, coverage = partial, quote = "(ii) $150,000,000.")
rule S9511FlatFy2013to2019 strict { then pcortf_flat_amount(2013, 150000000 USD); }

@source(IRC_S9511_B, relation = formalizes, coverage = partial, quote = "(A) for fiscal year 2020, $275,500,000;")
rule S9511ApplicableFy2020 strict { then pcortf_applicable_amount(2020, 275500000 USD); }
@source(IRC_S9511_B, relation = formalizes, coverage = partial, quote = "(B) for fiscal year 2021, $285,000,000;")
rule S9511ApplicableFy2021 strict { then pcortf_applicable_amount(2021, 285000000 USD); }
@source(IRC_S9511_B, relation = formalizes, coverage = partial, quote = "(C) for fiscal year 2022, $293,500,000;")
rule S9511ApplicableFy2022 strict { then pcortf_applicable_amount(2022, 293500000 USD); }
@source(IRC_S9511_B, relation = formalizes, coverage = partial, quote = "(D) for fiscal year 2023, $311,500,000;")
rule S9511ApplicableFy2023 strict { then pcortf_applicable_amount(2023, 311500000 USD); }
@source(IRC_S9511_B, relation = formalizes, coverage = partial, quote = "(E) for fiscal year 2024, $320,000,000;")
rule S9511ApplicableFy2024 strict { then pcortf_applicable_amount(2024, 320000000 USD); }
@source(IRC_S9511_B, relation = formalizes, coverage = partial, quote = "(F) for fiscal year 2025, $338,000,000;")
rule S9511ApplicableFy2025 strict { then pcortf_applicable_amount(2025, 338000000 USD); }
@source(IRC_S9511_B, relation = formalizes, coverage = partial, quote = "(G) for fiscal year 2026, $355,500,000;")
rule S9511ApplicableFy2026 strict { then pcortf_applicable_amount(2026, 355500000 USD); }
@source(IRC_S9511_B, relation = formalizes, coverage = partial, quote = "(H) for fiscal year 2027, $363,500,000;")
rule S9511ApplicableFy2027 strict { then pcortf_applicable_amount(2027, 363500000 USD); }
@source(IRC_S9511_B, relation = formalizes, coverage = partial, quote = "(I) for fiscal year 2028, $381,000,000; and")
rule S9511ApplicableFy2028 strict { then pcortf_applicable_amount(2028, 381000000 USD); }
@source(IRC_S9511_B, relation = formalizes, coverage = partial, quote = "(J) for fiscal year 2029, $399,000,000.")
rule S9511ApplicableFy2029 strict { then pcortf_applicable_amount(2029, 399000000 USD); }

relation pcortf_appropriated_for_year(fy: Integer, amount: Money) kind institutional {
    label en unofficial "the total amount appropriated to the PCORTF for the fiscal year: the fee-based component (where applicable) plus the flat/applicable-amount component";
}
@source(IRC_S9511_B, relation = formalizes, coverage = partial, quote = "an amount equivalent to the net revenues received in the Treasury from the fees imposed under subchapter B of chapter 34 (relating to fees on health insurance and self-insured plans) for such fiscal year; and")
rule S9511AppropriatedFeeComponent strict {
    for fy: Integer;
    for fee: Money;
    for flat: Money;
    when pcortf_fee_net_revenue_estimate(fy, fee) and pcortf_flat_amount(fy, flat);
    then pcortf_appropriated_for_year(fy, fee + flat);
}
@source(IRC_S9511_B, relation = formalizes, coverage = partial, quote = "the applicable amount (as defined in paragraph (4)) for the fiscal year.")
rule S9511AppropriatedApplicableAmountComponent strict {
    for fy: Integer;
    for fee: Money;
    for applicable: Money;
    when pcortf_fee_net_revenue_estimate(fy, fee) and pcortf_applicable_amount(fy, applicable);
    then pcortf_appropriated_for_year(fy, fee + applicable);
}

relation social_security_act_1183_transfer_credited(amount: Money) kind empirical {
    label en unofficial "amounts transferred under §1183 of the Social Security Act — external dependency";
}
@source(IRC_S9511_B, relation = formalizes, coverage = exact, quote = "In addition to the amounts appropriated under paragraph (1), there shall be credited to the PCORTF the amounts transferred under section 1183 of the Social Security Act.")
rule S9511CreditSsaTransfer strict {
    for amount: Money;
    when social_security_act_1183_transfer_credited(amount);
    then amount_credited_to_fund(PatientCenteredOutcomesResearchTrustFund, amount);
}

relation pcortf_liquidates_prior_obligation(e: Expenditure, cutoff: Date) kind empirical;
@source(IRC_S9511_B, relation = formalizes, coverage = partial, quote = "No amount may be appropriated or transferred to the PCORTF on and after the date of any expenditure from the PCORTF which is not an expenditure permitted under this section.")
rule S9511LimitationOnTransfers defeasible {
    for e: Expenditure;
    when expenditure_from_fund(e, PatientCenteredOutcomesResearchTrustFund) and not_known(expenditure_authorized(e, PatientCenteredOutcomesResearchTrustFund));
    then further_appropriation_barred(PatientCenteredOutcomesResearchTrustFund);
    unless pcortf_liquidates_prior_obligation(e, @2026-10-01);
}

@source(IRC_S9511_C, relation = formalizes, coverage = exact, quote = "The Secretary of the Treasury shall be a trustee of the PCORTF.")
rule S9511Trustee strict { then is_trustee_of(us.irc.core::Secretary, PatientCenteredOutcomesResearchTrustFund); }

relation pcori_carryout_expenditure(e: Expenditure) kind empirical {
    label en unofficial "the expenditure is by the Patient-Centered Outcomes Research Institute (SSA §1181(b)) carrying out its purposes";
}
@source(IRC_S9511_D, relation = formalizes, coverage = partial, quote = "Subject to paragraph (2), amounts in the PCORTF are available, without further appropriation, to the Patient-Centered Outcomes Research Institute established under section 1181(b) of the Social Security Act for carrying ")
rule S9511ExpenditureAuthorizedPcori defeasible {
    for e: Expenditure;
    when expenditure_from_fund(e, PatientCenteredOutcomesResearchTrustFund) and pcori_carryout_expenditure(e);
    then expenditure_authorized(e, PatientCenteredOutcomesResearchTrustFund);
}

relation ahrq_transfer_amount(fy: Integer, appropriated: Money, transferred: Money) kind institutional {
    label en unofficial "20 percent of the amount appropriated or credited to the PCORTF for the fiscal year, transferred to HHS (§9511(d)(2)(A))";
}
@source(IRC_S9511_D, relation = formalizes, coverage = exact, quote = "The trustee of the PCORTF shall provide for the transfer from the PCORTF of 20 percent of the amounts appropriated or credited to the PCORTF for each of fiscal years 2011 through 2029 to the Secretary of Health and Human")
rule S9511AhrqTransferAmount strict {
    for fy: Integer;
    for appropriated: Money;
    when pcortf_appropriated_for_year(fy, appropriated);
    then ahrq_transfer_amount(fy, appropriated, round(appropriated * 0.20, 2, "HALF_UP"));
}
relation ahrq_distribution(fy: Integer, transferred: Money, to_office: Money, to_secretary: Money) kind institutional {
    label en unofficial "the 80%/20% split of the AHRQ-transferred amount between the AHRQ Office of Communication and Knowledge Transfer and the Secretary (§9511(d)(2)(C))";
}
@source(IRC_S9511_D, relation = formalizes, coverage = partial, quote = "(i) 80 percent to the Office of Communication and Knowledge Transfer of the Agency for Healthcare Research and Quality (or any other relevant office designated by Agency for Healthcare Research and Quality) to carry out ")
rule S9511AhrqDistributionSplit strict {
    for fy: Integer;
    for appropriated: Money;
    for transferred: Money;
    when ahrq_transfer_amount(fy, appropriated, transferred);
    then ahrq_distribution(fy, transferred, round(transferred * 0.80, 2, "HALF_UP"), round(transferred * 0.20, 2, "HALF_UP"));
}

@source(IRC_S9511_F, relation = formalizes, coverage = exact, quote = "No amounts shall be available for expenditure from the PCORTF after September 30, 2029, and any amounts in such Trust Fund after such date shall be transferred to the general fund of the Treasury.")
rule S9511Termination strict {
    for e: Expenditure;
    for on: Date;
    when expenditure_from_fund(e, PatientCenteredOutcomesResearchTrustFund) and expenditure_before_date_pcortf(e, on) and on > @2029-09-30;
    then expenditure_barred_after_termination(e);
}
relation expenditure_before_date_pcortf(e: Expenditure, on: Date) kind empirical;
relation expenditure_barred_after_termination(e: Expenditure) kind institutional;
