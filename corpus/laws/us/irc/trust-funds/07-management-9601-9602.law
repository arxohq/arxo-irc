// 26 U.S.C. §9500 (short title, subchapter A heading), §9601 (transfer of
// amounts), §9602 (management of trust funds) — Subchapter B.
//
// JUDGMENT CALLS:
//  - §9500 ("This subtitle may be cited as the 'Trust Fund Code of 1981'")
//    is a NAMING provision with no independent normative content beyond the
//    citation itself — NON_NORMATIVE (short title), consistent with the
//    joint-committee pilot's treatment of similar short-title dispositions.
//  - §9601's "at least monthly... on the basis of estimates... proper
//    adjustments" duty is the AGENT-BRIEF's own worked example of a
//    recurring→maintenance duty: modelled as `maintenance`, flagged here and
//    in the coverage row (never silently reclassified as `achievement`). The
//    adjustment mechanism itself (comparing a later actual to an earlier
//    estimate) is TECH_GAP (no ledger, see 00-shared.law).
//  - §9602(a) (report duty) is `achievement` with an annual recurrence this
//    package represents the same way (a case-relevant year, not an
//    open-ended one-shot).
//  - §9602(b) (investment power) and (b)(2) (sale power) are `power` blocks;
//    (b)(3) (interest/proceeds credited back) is a plain institutional
//    effect.

language "law.core" version "0.2";
package us.irc.trust_funds version "0.1.1";
namespace "urn:us:irc:trust_funds:clir";

use self::{
    IRC_S9500,
    IRC_S9601,
    IRC_S9602_A,
    IRC_S9602_B,
    Organ,
    Period,
    TaxableYear,
    TrustFund,
    amount_credited_to_fund,
    fund_established,
};

// --- §9500 -----------------------------------------------------------------

relation subtitle_cited_as(name: Text) kind institutional {
    label en unofficial "the subtitle's short title — a naming provision, non_normative beyond the citation itself";
}
@source(IRC_S9500, relation = formalizes, coverage = exact, quote = "This subtitle may be cited as the \"Trust Fund Code of 1981\".")
rule S9500ShortTitle strict {
    then subtitle_cited_as("Trust Fund Code of 1981");
}

// --- §9601 Transfer of amounts -----------------------------------------------

relation monthly_transfer_made(f: TrustFund, month: Period) kind empirical {
    label en unofficial "the Secretary has transferred, from the general fund of the Treasury to the trust fund, the amounts appropriated by subchapter A for the given month — on the basis of the Secretary's own estimates";
}
relation monthly_transfer_cycle_open(f: TrustFund, month: Period) kind empirical {
    label en unofficial "a month for which §9601's transfer is due has arrived — a case-supplied fact standing in for the recurring 'at least monthly' cadence (AGENT-BRIEF's own worked example: `recurring` is reserved but not parsed, so this is `maintenance`, flagged here)";
}
@source(IRC_S9601, relation = formalizes, coverage = exact, quote = "The amounts appropriated by any section of subchapter A to any Trust Fund established by such subchapter shall be transferred at least monthly from the general fund of the Treasury to such Trust Fund on the basis of esti")
rule S9601MonthlyTransferDuty defeasible {
    for f: TrustFund;
    for month: Period;
    when fund_established(f) and monthly_transfer_cycle_open(f, month);
    then duty S9601MonthlyTransfer {
        bearer us.irc.core::Secretary;
        beneficiary f;
        goal maintenance {
            condition monthly_transfer_made(f, month);
            window [-infinity, infinity];
        }
    };
}
// The "proper adjustments... to the extent prior estimates were in excess of
// or less than the amounts that should have been transferred" mechanism is
// TECH_GAP: it needs a running estimate/actual ledger this package does not
// model (see 00-shared.law's no-ledger judgment call and TECH-GAPS.md).

// --- §9602(a) Report duty ------------------------------------------------------

relation trust_fund_report_made(fy: TaxableYear) kind empirical {
    label en unofficial "the Secretary's annual report to Congress on the financial condition and operations of the trust funds, made after consultation with any other trustees";
}
@source(IRC_S9602_A, relation = formalizes, coverage = exact, quote = "It shall be the duty of the Secretary of the Treasury to hold each Trust Fund established by subchapter A, and (after consultation with any other trustees of the Trust Fund) to report to the Congress each year on the fin")
rule S9602ReportDuty defeasible {
    for fy: TaxableYear;
    when fy_holds_for_any_year(fy);
    then duty S9602AnnualReport {
        bearer us.irc.core::Secretary;
        beneficiary us.irc.core::Congress;
        goal achievement {
            condition trust_fund_report_made(fy);
            window [-infinity, infinity];
        }
    };
}
relation fy_holds_for_any_year(fy: TaxableYear) kind empirical {
    label en unofficial "a case-supplied fact marking the fiscal year for which the §9602(a) annual report is due";
}

relation holds_trust_funds(o: Organ) kind institutional {
    label en unofficial "the Secretary of the Treasury holds each trust fund established by subchapter A";
}
@source(IRC_S9602_A, relation = formalizes, coverage = partial, quote = "It shall be the duty of the Secretary of the Treasury to hold each Trust Fund established by subchapter A")
rule S9602Holds strict {
    for f: TrustFund;
    when fund_established(f);
    then holds_trust_funds(us.irc.core::Secretary);
}

// --- §9602(b) Investment ------------------------------------------------------

relation investable_surplus(f: TrustFund, amount: Money) kind institutional {
    label en unofficial "the Secretary's judgment of the portion of the fund not required to meet current withdrawals — a DECISION-0194 evaluative determination";
}
relation invests_at(f: TrustFund, amount: Money, issue_price: Boolean) kind empirical {
    label en unofficial "the Secretary invests the amount on original issue at the issue price (issue_price = true) or by purchase of outstanding obligations at the market price (issue_price = false)";
}
@source(IRC_S9602_B, relation = formalizes, coverage = partial, quote = "It shall be the duty of the Secretary of the Treasury to invest such portion of any Trust Fund established by subchapter A as is not, in his judgment, required to meet current withdrawals.")
rule S9602InvestmentDuty defeasible {
    for f: TrustFund;
    for amount: Money;
    when investable_surplus(f, amount);
    then duty S9602Invest {
        bearer us.irc.core::Secretary;
        beneficiary f;
        goal maintenance {
            condition invests_at(f, amount, true);
            window [-infinity, infinity];
        }
    };
}

relation obligation_acquired(f: TrustFund, amount: Money) kind institutional;
relation sells_obligation(f: TrustFund, amount: Money) kind empirical;
@source(IRC_S9602_B, relation = formalizes, coverage = exact, quote = "Any obligation acquired by a Trust Fund established by subchapter A may be sold by the Secretary of the Treasury at the market price.")
rule S9602SalePower strict {
    for f: TrustFund;
    for amount: Money;
    when sells_obligation(f, amount);
    then power S9602SaleOfObligationsPower {
        holder us.irc.core::Secretary;
        over f;
        exercise sells_obligation(f, amount);
        valid_when obligation_acquired(f, amount);
        effect create(amount_credited_to_fund(f, amount));
    };
}

relation interest_or_sale_proceeds(f: TrustFund, amount: Money) kind empirical;
@source(IRC_S9602_B, relation = formalizes, coverage = exact, quote = "The interest on, and the proceeds from the sale or redemption of, any obligations held in a Trust Fund established by subchapter A shall be credited to and form a part of the Trust Fund.")
rule S9602CreditInterestAndProceeds strict {
    for f: TrustFund;
    for amount: Money;
    when interest_or_sale_proceeds(f, amount);
    then amount_credited_to_fund(f, amount);
}
