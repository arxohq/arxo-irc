// 26 U.S.C. §§9504-9506 — Sport Fish Restoration and Boating Trust Fund,
// Harbor Maintenance Trust Fund, Inland Waterways Trust Fund. Small, similar
// funds: creation + funding linkage + closed expenditure-purpose list +
// limitation-on-transfers (9504 only).
//
// JUDGMENT CALLS:
//  - §9504(b)(1)(B) (import duties on fishing tackle/yachts under the
//    Harmonized Tariff Schedule) names a Title 19 receipt this package
//    represents as `NonTaxReceipt`, not a `FundedTaxReference` IRC-section
//    value (it is not an IRC excise tax) — EXTERNAL_DEPENDENCY, Title 19.
//  - §9504(c) (Boat Safety Account) is a sub-account inside the Sport Fish
//    fund holding leftover balances "without further appropriation" —
//    modelled as its own `TrustFund` const receiving credits under §9602(b);
//    the underlying balance ("amounts remaining... on October 1, 2005") is
//    TECH_GAP (ledger, see 00-shared.law).
//  - §9505(a)(2) (Great Lakes Seaway Development Corporation transfer under
//    a 1954 Act) and §9506's construction/rehabilitation category are each
//    EXTERNAL_DEPENDENCY / classification facts, not reproduced statutes.

language "law.core" version "0.2";
package us.irc.trust_funds version "0.1.1";
namespace "urn:us:irc:trust_funds:clir";

use self::{
    BoatSafetyAccount,
    Expenditure,
    FundedTaxReference,
    HarborMaintenanceTrustFund,
    IRC_S9504_A,
    IRC_S9504_B,
    IRC_S9504_C,
    IRC_S9504_D,
    IRC_S9505_A,
    IRC_S9505_B,
    IRC_S9505_C,
    IRC_S9506_A,
    IRC_S9506_B,
    IRC_S9506_C,
    InlandWaterwaysTrustFund,
    SportFishRestorationAndBoatingTrustFund,
    TrustFund,
    amount_credited_to_fund,
    expenditure_authorized,
    expenditure_from_fund,
    fund_established,
    fund_funded_by,
    further_appropriation_barred,
};

// ================= §9504 Sport Fish Restoration and Boating ==================

@source(IRC_S9504_A, relation = formalizes, coverage = partial, quote = "There is hereby established in the Treasury of the United States a trust fund to be known as the \"Sport Fish Restoration and Boating Trust Fund\".")
rule S9504EstablishFund strict { then fund_established(SportFishRestorationAndBoatingTrustFund); }

@source(IRC_S9504_B, relation = formalizes, coverage = partial, quote = "(A) the taxes imposed by section 4161(a) (relating to sport fishing equipment), and")
rule S9504FundedBySportFishingTax strict { then fund_funded_by(SportFishRestorationAndBoatingTrustFund, Section4161SportFishingEquipmentTax); }

relation import_duty_credited(f: TrustFund, amount: Money) kind empirical {
    label en unofficial "import duties on fishing tackle (heading 9507, HTSUS) and on yachts/pleasure craft (chapter 89, HTSUS) credited to the fund — Title 19 dependency";
}
@source(IRC_S9504_B, relation = formalizes, coverage = partial, quote = "the import duties imposed on fishing tackle under heading 9507 of the Harmonized Tariff Schedule of the United States (19 U.S.C. 1202) and on yachts and pleasure craft under chapter 89 of the Harmonized Tariff Schedu")
rule S9504CreditImportDuties strict {
    for amount: Money;
    when import_duty_credited(SportFishRestorationAndBoatingTrustFund, amount);
    then amount_credited_to_fund(SportFishRestorationAndBoatingTrustFund, amount);
}

enum SportFishExpenditurePurpose { DingellJohnsonAct; TransportationEquityAct7404d; CoastalWetlandsAct; }
relation sport_fish_expenditure_purpose(e: Expenditure, purpose: SportFishExpenditurePurpose) kind empirical;
@source(IRC_S9504_B, relation = formalizes, coverage = partial, quote = "to carry out the purposes of the Dingell-Johnson Sport Fish Restoration Act (as in effect on the date of the enactment of the Infrastructure Investment and Jobs Act),")
rule S9504ExpenditureAuthorizedDingellJohnson defeasible {
    for e: Expenditure;
    when expenditure_from_fund(e, SportFishRestorationAndBoatingTrustFund) and sport_fish_expenditure_purpose(e, DingellJohnsonAct);
    then expenditure_authorized(e, SportFishRestorationAndBoatingTrustFund);
}
@source(IRC_S9504_B, relation = formalizes, coverage = partial, quote = "to carry out the purposes of section 7404(d) of the Transportation Equity Act for the 21st Century (as in effect on the date of the enactment of the Infrastructure Investment and Jobs Act), and")
rule S9504ExpenditureAuthorizedTea21 defeasible {
    for e: Expenditure;
    when expenditure_from_fund(e, SportFishRestorationAndBoatingTrustFund) and sport_fish_expenditure_purpose(e, TransportationEquityAct7404d);
    then expenditure_authorized(e, SportFishRestorationAndBoatingTrustFund);
}
relation coastal_wetlands_restricted_source(e: Expenditure) kind empirical {
    label en unofficial "the expenditure draws on amounts transferred from the Highway Trust Fund under §9503(c)(4) (small-engine fuel taxes), restricted by (b)(2)'s last sentence to the Coastal Wetlands purpose only";
}
@source(IRC_S9504_B, relation = formalizes, coverage = partial, quote = "to carry out the purposes of the Coastal Wetlands Planning, Protection and Restoration Act (as in effect on the date of the enactment of the Infrastructure Investment and Jobs Act).")
rule S9504ExpenditureAuthorizedCoastalWetlands defeasible {
    for e: Expenditure;
    when expenditure_from_fund(e, SportFishRestorationAndBoatingTrustFund) and sport_fish_expenditure_purpose(e, CoastalWetlandsAct);
    then expenditure_authorized(e, SportFishRestorationAndBoatingTrustFund);
}
relation small_engine_sourced_expenditure_not_wetlands(e: Expenditure) kind institutional {
    label en unofficial "an expenditure sourced from the §9503(c)(4) small-engine-fuel transfer that is NOT for the Coastal Wetlands purpose — (b)(2)'s last sentence bars it even if it would otherwise fit another (b)(2) purpose";
}
@source(IRC_S9504_B, relation = formalizes, coverage = exact, quote = "Amounts transferred to such account under section 9503(c)(4) may be used only for making expenditures described in subparagraph (C) of this paragraph.")
rule S9504SmallEngineTransferRestrictedToWetlands strict {
    for e: Expenditure;
    when expenditure_from_fund(e, SportFishRestorationAndBoatingTrustFund)
        and coastal_wetlands_restricted_source(e)
        and not_known(sport_fish_expenditure_purpose(e, CoastalWetlandsAct));
    then small_engine_sourced_expenditure_not_wetlands(e);
}

@source(IRC_S9504_C, relation = formalizes, coverage = partial, quote = "Amounts remaining in the Boat Safety Account on October 1, 2005, and amounts thereafter credited to the Account under section 9602(b), shall be available, without further appropriation, for making expenditures before Oct")
rule S9504BoatSafetyAccountAvailable strict { then fund_established(BoatSafetyAccount); }

relation sport_fish_liquidates_prior_obligation(e: Expenditure, cutoff: Date) kind empirical;
@source(IRC_S9504_D, relation = formalizes, coverage = partial, quote = "Except as provided in paragraph (2), no amount may be appropriated or paid to the Sport Fish Restoration and Boating Trust Fund on and after the date of any expenditure from such Trust Fund which is not permitted by this")
rule S9504LimitationOnTransfers defeasible {
    for e: Expenditure;
    when expenditure_from_fund(e, SportFishRestorationAndBoatingTrustFund) and not_known(expenditure_authorized(e, SportFishRestorationAndBoatingTrustFund));
    then further_appropriation_barred(SportFishRestorationAndBoatingTrustFund);
    unless sport_fish_liquidates_prior_obligation(e, @2026-10-01);
}
// (e) is a cross-reference to §9503(c)(3) — non_normative, no separate content.

// ================= §9505 Harbor Maintenance ===================================

@source(IRC_S9505_A, relation = formalizes, coverage = partial, quote = "There is hereby established in the Treasury of the United States a trust fund to be known as the \"Harbor Maintenance Trust Fund\", consisting of such amounts as may be—")
rule S9505EstablishFund strict { then fund_established(HarborMaintenanceTrustFund); }

@source(IRC_S9505_B, relation = formalizes, coverage = exact, quote = "There are hereby appropriated to the Harbor Maintenance Trust Fund amounts equivalent to the taxes received in the Treasury under section 4461 (relating to harbor maintenance tax).")
rule S9505FundedByHarborTax strict { then fund_funded_by(HarborMaintenanceTrustFund, Section4461HarborMaintenanceTax); }

relation great_lakes_seaway_transfer_credited(amount: Money) kind empirical {
    label en unofficial "amounts transferred by the Great Lakes St. Lawrence Seaway Development Corporation under §13(a) of the Act of May 13, 1954 — external dependency";
}
@source(IRC_S9505_A, relation = formalizes, coverage = partial, quote = "transferred to the Harbor Maintenance Trust Fund by the Great Lakes St. Lawrence Seaway Development Corporation pursuant to section 13(a) of the Act of May 13, 1954, or")
rule S9505CreditSeawayTransfer strict {
    for amount: Money;
    when great_lakes_seaway_transfer_credited(amount);
    then amount_credited_to_fund(HarborMaintenanceTrustFund, amount);
}

enum HarborExpenditurePurpose { WrdaSection210; TollRebatePayments; AdminExpensesTreasuryArmyCommerce; }
relation harbor_expenditure_purpose(e: Expenditure, purpose: HarborExpenditurePurpose) kind empirical;
@source(IRC_S9505_C, relation = formalizes, coverage = partial, quote = "to carry out section 210 of the Water Resources Development Act of 1986,")
rule S9505ExpenditureAuthorizedWrda strict {
    for e: Expenditure;
    when expenditure_from_fund(e, HarborMaintenanceTrustFund) and harbor_expenditure_purpose(e, WrdaSection210);
    then expenditure_authorized(e, HarborMaintenanceTrustFund);
}
@source(IRC_S9505_C, relation = formalizes, coverage = partial, quote = "for payments of rebates of tolls or charges pursuant to section 13(b) of the Act of May 13, 1954 (as in effect on April 1, 1987), and")
rule S9505ExpenditureAuthorizedTollRebates strict {
    for e: Expenditure;
    when expenditure_from_fund(e, HarborMaintenanceTrustFund) and harbor_expenditure_purpose(e, TollRebatePayments);
    then expenditure_authorized(e, HarborMaintenanceTrustFund);
}
@source(IRC_S9505_C, relation = formalizes, coverage = partial, quote = "for the payment of all expenses of administration incurred by the Department of the Treasury, the Army Corps of Engineers, and the Department of Commerce related to the administration of subchapter A of chapter 36 (r")
rule S9505ExpenditureAuthorizedAdmin strict {
    for e: Expenditure;
    when expenditure_from_fund(e, HarborMaintenanceTrustFund) and harbor_expenditure_purpose(e, AdminExpensesTreasuryArmyCommerce);
    then expenditure_authorized(e, HarborMaintenanceTrustFund);
}

// ================= §9506 Inland Waterways =====================================

@source(IRC_S9506_A, relation = formalizes, coverage = partial, quote = "There is hereby established in the Treasury of the United States a trust fund to be known as the \"Inland Waterways Trust Fund\", consisting of such amounts as may be appropriated or credited to such Trust Fund as provided")
rule S9506EstablishFund strict { then fund_established(InlandWaterwaysTrustFund); }

@source(IRC_S9506_B, relation = formalizes, coverage = exact, quote = "There are hereby appropriated to the Inland Waterways Trust Fund amounts equivalent to the taxes received in the Treasury under section 4042 (relating to tax on fuel used in commercial transportation on inland waterways)")
rule S9506FundedByInlandWaterwaysTax strict { then fund_funded_by(InlandWaterwaysTrustFund, Section4042InlandWaterwaysFuelTax); }

relation inland_waterways_construction_expenditure(e: Expenditure) kind empirical {
    label en unofficial "the expenditure is a construction or rehabilitation expenditure for navigation on the inland waterways named in §9506(c)(1)'s cross-referenced list";
}
relation wrda_102a_project_share(e: Expenditure, share: Decimal) kind empirical {
    label en unofficial "the fraction of construction cost, for a §102(a) Water Resources Development Act of 1986 project, paid from this fund";
}
@source(IRC_S9506_C, relation = formalizes, coverage = partial, quote = "Except as provided in paragraph (2), amounts in the Inland Waterways Trust Fund shall be available, as provided by appropriation Acts, for making construction and rehabilitation expenditures for navigation on the inland ")
rule S9506ExpenditureAuthorizedConstruction defeasible {
    for e: Expenditure;
    when expenditure_from_fund(e, InlandWaterwaysTrustFund) and inland_waterways_construction_expenditure(e);
    then expenditure_authorized(e, InlandWaterwaysTrustFund);
    unless wrda_share_exceeds_half(e);
}
relation wrda_share_exceeds_half(e: Expenditure) kind institutional {
    label en unofficial "the §102(a) WRDA-1986 project's cost share drawn from this fund exceeds one-half — the (c)(2) cap";
}
@source(IRC_S9506_C, relation = formalizes, coverage = exact, quote = "Not more than ½ of the cost of any construction to which section 102(a) of the Water Resources Development Act of 1986 applies (as in effect on the date of the enactment of this section) may be paid from the Inland Water")
rule S9506WrdaShareCap strict {
    for e: Expenditure;
    for share: Decimal;
    when wrda_102a_project_share(e, share) and share > 0.50;
    then wrda_share_exceeds_half(e);
}
