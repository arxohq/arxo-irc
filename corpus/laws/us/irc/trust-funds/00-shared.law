// 26 U.S.C. Subtitle I (Chapter 98, §§9500-9511) shared shapes — every trust
// fund established by subchapter A follows the SAME three-part pattern the
// prose repeats fund by fund: (1) creation of the fund; (2) appropriation of
// amounts equivalent to named excise taxes (and other named receipts) as
// FUNDING SOURCES; (3) authorization of a closed list of EXPENDITURE
// PURPOSES the fund may be drawn on for. This module gives the three shared
// relations once; per-fund modules assert the fund-specific facts and add
// the fund-specific extras (limitation-on-transfers, borrowing authority,
// claims-limited-to-balance, cross references).
//
// JUDGMENT CALLS (see report for the full list):
//  - A trust fund is modelled as its OWN local entity (`TrustFund`), not a
//    `us.irc.core::Organ`: subchapter A funds are Treasury accounts, not
//    organs that act — they are acted UPON (held, invested, drawn from) by
//    the Secretary (`us.irc.core::Secretary`), consistent with CONTRACT.md's
//    "GovernmentalUnit was intentionally omitted" note (a single owner's
//    local entity, not a core addition).
//  - "Amounts equivalent to the taxes received... are hereby appropriated"
//    is modelled as an INSTITUTIONAL crediting fact keyed to a case-supplied
//    Treasury receipt figure (`tax_receipts_for_period`), not as a
//    recomputation of the tax from `us.irc.excise_goods`' own per-event
//    relations: aggregating every `TaxableFuelEvent`/`CoalSaleEvent`/etc. of
//    a period into "the taxes received in the Treasury" would need a
//    `sum all ... where` over an EMPIRICAL relation, which the compiler-traps
//    list (AGENT-BRIEF) flags as a trap to avoid; Treasury's own receipt
//    total for a taxing section is itself an accounting fact this package
//    takes as a typed input, not a value it re-derives from raw excise
//    events. `fund_funded_by` records WHICH tax finances WHICH fund (the
//    actual normative content of "amounts equivalent to..."); the arithmetic
//    equivalence itself is the trivial `CreditTaxEquivalentToFund` rule.
//  - No running FUND BALANCE is modelled (`credited_to_fund` minus
//    `expenditure_paid`, accumulated over time): a day-by-day or
//    transfer-by-transfer ledger is exactly the self-recursive-arithmetic
//    shape the compiler-traps list calls out as LDC-E4102 territory. Every
//    balance-dependent provision (the Oil Spill $30,000,000 minimum-balance
//    rule §9509(c)(2)(B), the Highway Trust Fund §9503(f) "determination of
//    balances", the claims-paid-in-order-received rules of §§9507(e)(3),
//    9508(d)(3), 9509(e)(3)) is TECH_GAP, recorded per-fund with a minimal
//    reproduction (a fund whose current balance is a case-supplied fact
//    could still be checked against $30,000,000, but the balance itself is
//    not computed by this package — see TECH-GAPS.md rows added for this
//    package).
//  - One-time historical lump-sum appropriations ("there is hereby
//    appropriated $14,700,000,000 to the Highway Account") are modelled as
//    plain institutional facts (`appropriated_lump_sum`), asserted directly
//    with their own `@source` quote — these are executed facts of the
//    pinned text, not case-variable calculations, so no A3 dataset is
//    needed for them (contrast the Patient-Centered Outcomes Research Trust
//    Fund's year-by-year "applicable amount" schedule, which DOES vary by a
//    case-relevant fiscal year and is therefore a `.lawparam.json` dataset
//    in the PCOR module).

language "law.core" version "0.2";
package us.irc.trust_funds version "0.1.1";
namespace "urn:us:irc:trust_funds:clir";

use self::{
    IRC_S9501_B,
    IRC_S9507_E,
};

entity TrustFund { label en unofficial "a trust fund (or a separate account within one) established by 26 U.S.C. Chapter 98, Subchapter A"; }

const BlackLungDisabilityTrustFund: TrustFund = entity_ref("urn:us:irc:trust_funds:clir#BlackLungDisabilityTrustFund") { label en official "Black Lung Disability Trust Fund"; }
const AirportAndAirwayTrustFund: TrustFund = entity_ref("urn:us:irc:trust_funds:clir#AirportAndAirwayTrustFund") { label en official "Airport and Airway Trust Fund"; }
const HighwayTrustFund: TrustFund = entity_ref("urn:us:irc:trust_funds:clir#HighwayTrustFund") { label en official "Highway Trust Fund"; }
const MassTransitAccount: TrustFund = entity_ref("urn:us:irc:trust_funds:clir#MassTransitAccount") { label en official "Mass Transit Account (a separate account within the Highway Trust Fund, §9503(e))"; }
const SportFishRestorationAndBoatingTrustFund: TrustFund = entity_ref("urn:us:irc:trust_funds:clir#SportFishRestorationAndBoatingTrustFund") { label en official "Sport Fish Restoration and Boating Trust Fund"; }
const BoatSafetyAccount: TrustFund = entity_ref("urn:us:irc:trust_funds:clir#BoatSafetyAccount") { label en official "Boat Safety Account (within the Sport Fish Restoration and Boating Trust Fund, §9504(c))"; }
const HarborMaintenanceTrustFund: TrustFund = entity_ref("urn:us:irc:trust_funds:clir#HarborMaintenanceTrustFund") { label en official "Harbor Maintenance Trust Fund"; }
const InlandWaterwaysTrustFund: TrustFund = entity_ref("urn:us:irc:trust_funds:clir#InlandWaterwaysTrustFund") { label en official "Inland Waterways Trust Fund"; }
const HazardousSubstanceSuperfund: TrustFund = entity_ref("urn:us:irc:trust_funds:clir#HazardousSubstanceSuperfund") { label en official "Hazardous Substance Superfund"; }
const LeakingUndergroundStorageTankTrustFund: TrustFund = entity_ref("urn:us:irc:trust_funds:clir#LeakingUndergroundStorageTankTrustFund") { label en official "Leaking Underground Storage Tank Trust Fund"; }
const OilSpillLiabilityTrustFund: TrustFund = entity_ref("urn:us:irc:trust_funds:clir#OilSpillLiabilityTrustFund") { label en official "Oil Spill Liability Trust Fund"; }
const VaccineInjuryCompensationTrustFund: TrustFund = entity_ref("urn:us:irc:trust_funds:clir#VaccineInjuryCompensationTrustFund") { label en official "Vaccine Injury Compensation Trust Fund"; }
const PatientCenteredOutcomesResearchTrustFund: TrustFund = entity_ref("urn:us:irc:trust_funds:clir#PatientCenteredOutcomesResearchTrustFund") { label en official "Patient-Centered Outcomes Research Trust Fund"; }

relation fund_established(f: TrustFund) kind institutional {
    label en unofficial "the trust fund (or account) has been established in the Treasury of the United States";
}

// --- Funding sources ---------------------------------------------------------

// One value per DISTINCT statutory tax/receipt source this subtitle names as
// feeding a trust fund. Values are named after the funding IRC section, not
// after the fund, because several funds share a source list item (e.g. the
// Sport Fish Restoration and Boating Trust Fund is fed both by its own
// §4161 tax and by a share of the Highway Trust Fund's motorboat-fuel
// receipts under §9503(c)(3)). Additive if a fund needs one this task did
// not anchor.
enum FundedTaxReference {
    Section4121BlackLungExciseTax;
    Section4041FuelTaxGeneral;
    Section4041AviationFuel;
    Section4043FractionalOwnershipSurtax;
    Section4051RetailTruckTax;
    Section4071TireTax;
    Section4081FuelTaxGeneral;
    Section4081AviationRate;
    Section4261AirPassengerTax;
    Section4271AirCargoTax;
    Section4481HighwayUseTax;
    Section4161SportFishingEquipmentTax;
    Section4461HarborMaintenanceTax;
    Section4042InlandWaterwaysFuelTax;
    Section4611PetroleumSuperfundRate;
    Section4611OilSpillRate;
    Section4661ChemicalTax;
    Section4671ImportedSubstanceTax;
    Section4131VaccineTax;
    Chapter34HealthInsuranceFee;
    NonTaxReceipt; // court recoveries, penalties, civil-penalty transfers, appropriations "out of money in the Treasury not otherwise appropriated" — named per fund in the note field of the coverage row, not further subtyped here (TECH_GAP: no closed enum of every CERCLA/Oil Pollution Act recovery source).
}

relation fund_funded_by(f: TrustFund, tax: FundedTaxReference) kind institutional {
    label en unofficial "amounts equivalent to the named tax are appropriated to the trust fund (the funding-source linkage this subtitle establishes)";
}

relation tax_receipts_for_period(tax: FundedTaxReference, p: us.irc.core::Period, amount: Money) kind empirical {
    label en unofficial "the Treasury's receipts of the named tax for the period (a case-supplied accounting fact, not recomputed from excise-event data — see module header)";
}

relation credited_to_fund(f: TrustFund, tax: FundedTaxReference, p: us.irc.core::Period, amount: Money) kind institutional {
    label en unofficial "an amount equivalent to the period's receipts of the named tax has been credited (appropriated) to the trust fund";
}

@source(IRC_S9501_B, relation = formalizes, coverage = contextual, quote = "There are hereby appropriated to the Black Lung Disability Trust Fund amounts equivalent to the taxes received in the Treasury")
rule CreditTaxEquivalentToFund strict {
    for f: TrustFund;
    for tax: FundedTaxReference;
    for p: us.irc.core::Period;
    for amount: Money;
    when fund_funded_by(f, tax) and tax_receipts_for_period(tax, p, amount);
    then credited_to_fund(f, tax, p, amount);
}

// One-time, already-executed lump-sum appropriations named in the pinned
// text with a fixed dollar figure ("there is hereby appropriated
// $14,000,000,000..."), keyed by a short label for the fiscal-year/event the
// text itself names (not a case variable — these are historical facts of
// the statute, asserted directly per fund module).
relation amount_credited_to_fund(f: TrustFund, amount: Money) kind institutional {
    label en unofficial "an amount has been credited to the trust fund (a receipt other than the named tax-equivalent transfers, e.g. repayments, recoveries, penalties, or civil-penalty transfers each fund module names)";
}

relation appropriated_lump_sum(f: TrustFund, occasion: Text, amount: Money) kind institutional {
    label en unofficial "a one-time lump-sum appropriation of the named amount to the trust fund, out of money in the Treasury not otherwise appropriated, for the occasion the pinned text names";
}

// --- Expenditures --------------------------------------------------------------

entity Expenditure { label en unofficial "a proposed expenditure from a trust fund, to be tested against that fund's authorized purposes"; }

relation expenditure_from_fund(e: Expenditure, f: TrustFund) kind empirical {
    label en unofficial "the expenditure is made (or proposed) from the named trust fund";
}
relation expenditure_authorized(e: Expenditure, f: TrustFund) kind institutional {
    label en unofficial "the expenditure is for a purpose this subtitle authorizes the fund to be drawn on for (classification, not an appropriations-availability finding: 'as provided by appropriation Acts' is a separate, un-modelled condition every fund's expenditure clause repeats — TECH_GAP, appropriations-Act availability is not itself IRC text this package can check)";
}

// --- Borrowing authority (repayable advances) -----------------------------------

relation advance_requested(f: TrustFund, amount: Money) kind empirical {
    label en unofficial "an advance to the trust fund, as a repayable advance, is requested in the stated amount";
}
relation advance_necessary_to_make_expenditures(f: TrustFund, amount: Money) kind institutional {
    label en unofficial "the advance is necessary to make the fund's authorized expenditures — a DECISION-0194 evaluative judgment of the Secretary (or of Congress in the appropriating act), never an arithmetic guard";
}
relation advance_outstanding(f: TrustFund, amount: Money) kind institutional {
    label en unofficial "a repayable advance in the stated amount is outstanding to the trust fund";
}
relation advance_repaid(f: TrustFund, amount: Money) kind empirical {
    label en unofficial "the trust fund has repaid (with interest) an advance in the stated amount to the general fund of the Treasury, per a Secretary determination that funds are available";
}

// --- Claims limited to fund balance (§§9507(e), 9508(d), 9509(e)) --------------

entity FundClaim { label en unofficial "a claim filed against a trust fund whose liability is limited to amounts in that fund (Superfund, LUST, Oil Spill)"; }
relation claim_against_fund(c: FundClaim, f: TrustFund, amount: Money) kind empirical;
relation claim_payable_only_from_fund(c: FundClaim, f: TrustFund) kind institutional {
    label en unofficial "the United States' liability on the claim is limited to amounts in the named trust fund — no other source may be used to pay it";
}
@source(IRC_S9507_E, relation = formalizes, coverage = exact, quote = "Any claim filed against the Superfund may be paid only out of the Superfund.")
rule ClaimPayableOnlyFromFund strict {
    for c: FundClaim;
    for f: TrustFund;
    for amount: Money;
    when claim_against_fund(c, f, amount);
    then claim_payable_only_from_fund(c, f);
}
