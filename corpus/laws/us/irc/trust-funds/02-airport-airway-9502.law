// 26 U.S.C. §9502 — Airport and Airway Trust Fund.
//
// JUDGMENT CALLS:
//  - (b)(2) (civil penalties collected under 49 U.S.C. §47107(m)) and the
//    (b) flush language excluding the §4081(a)(2)(B) rate are represented as
//    plain facts/exclusions rather than reproducing Title 49's own penalty
//    conditions (EXTERNAL_DEPENDENCY, Title 49, owner: none).
//  - (d)(1) names FOUR different aviation-infrastructure Acts (by their
//    "as in effect on" dates) as the purpose test; each is its own
//    enumerated purpose value rather than a reproduction of those Acts'
//    substantive programs (the purpose test IS "money spent to carry out
//    that Act", not the Act's own conditions) — EXECUTABLE at that level of
//    abstraction, TECH_GAP if a scenario needed to test the Act's own
//    eligibility rules.
//  - (d)(2)/(3)/(5)/(6) (transfers for fuel credits/refunds, based on
//    Secretary estimates with "proper adjustments...to the extent prior
//    estimates were in excess of or less than") are modelled as a single
//    `estimate_based_transfer` institutional fact per transfer kind; the
//    ADJUSTMENT MECHANISM itself (comparing a later actual to an earlier
//    estimate and correcting) is TECH_GAP — no running ledger is modelled
//    (see 00-shared.law header on why).
//  - (e) limitation-on-transfers and the October 1, 2028 expenditure/
//    obligation cutoffs are modelled as plain date facts a case supplies
//    (`before(decision_time_date, ...)`-style comparisons use
//    `us.irc.core::TimeSpan`/`Date` comparisons); the "without regard to"
//    carve-out in (e)(1)(A)-(B) is folded into the SAME rule as an `unless`
//    is unnecessary because it is a rule of DECISION (how the determination
//    is made), not an independent exception fact — represented as a comment
//    only (INTERPRETATION: no separate executable content beyond the
//    limitation itself).
//  - (f) is a one-time $14,000,000,000 lump-sum appropriation — modelled
//    with `appropriated_lump_sum` (00-shared.law).

language "law.core" version "0.2";
package us.irc.trust_funds version "0.1.1";
namespace "urn:us:irc:trust_funds:clir";

use self::{
    AirportAndAirwayTrustFund,
    Expenditure,
    FundedTaxReference,
    IRC_S9502_A,
    IRC_S9502_B,
    IRC_S9502_C,
    IRC_S9502_D,
    IRC_S9502_E,
    IRC_S9502_F,
    TrustFund,
    advance_necessary_to_make_expenditures,
    advance_outstanding,
    advance_requested,
    amount_credited_to_fund,
    appropriated_lump_sum,
    expenditure_authorized,
    expenditure_from_fund,
    fund_established,
    fund_funded_by,
};

// --- (a) Creation --------------------------------------------------------------

@source(IRC_S9502_A, relation = formalizes, coverage = exact, quote = "There is established in the Treasury of the United States a trust fund to be known as the \"Airport and Airway Trust Fund\", consisting of such amounts as may be appropriated, credited, or paid into the Airport and Airway Trust Fund as provided in this section, section 9503(c)(5), or section 9602(b).")
rule S9502EstablishFund strict {
    then fund_established(AirportAndAirwayTrustFund);
}

// --- (b) Transfers -----------------------------------------------------------

@source(IRC_S9502_B, relation = formalizes, coverage = partial, quote = "(A) section 4041(c) (relating to aviation fuels),")
rule S9502FundedByAviationFuel strict { then fund_funded_by(AirportAndAirwayTrustFund, Section4041AviationFuel); }
@source(IRC_S9502_B, relation = formalizes, coverage = partial, quote = "(B) section 4043 (relating to surtax on fuel used in aircraft part of a fractional ownership program),")
rule S9502FundedByFractionalOwnershipSurtax strict { then fund_funded_by(AirportAndAirwayTrustFund, Section4043FractionalOwnershipSurtax); }
@source(IRC_S9502_B, relation = formalizes, coverage = partial, quote = "(C) sections 4261 and 4271 (relating to transportation by air), and")
rule S9502FundedByAirPassengerTax strict { then fund_funded_by(AirportAndAirwayTrustFund, Section4261AirPassengerTax); }
@source(IRC_S9502_B, relation = formalizes, coverage = partial, quote = "(C) sections 4261 and 4271 (relating to transportation by air), and")
rule S9502FundedByAirCargoTax strict { then fund_funded_by(AirportAndAirwayTrustFund, Section4271AirCargoTax); }
@source(IRC_S9502_B, relation = formalizes, coverage = partial, quote = "(D) section 4081 with respect to aviation gasoline and kerosene to the extent attributable to the rate specified in section 4081(a)(2)(C), and")
rule S9502FundedByAviationRate strict { then fund_funded_by(AirportAndAirwayTrustFund, Section4081AviationRate); }

relation civil_penalty_credited_47107m(f: TrustFund, amount: Money) kind empirical {
    label en unofficial "an amount equivalent to civil penalties collected under 49 U.S.C. §47107(m), as determined by the Secretary — Title 49 dependency";
}
@source(IRC_S9502_B, relation = formalizes, coverage = partial, quote = "the amounts determined by the Secretary of the Treasury to be equivalent to the amounts of civil penalties collected under section 47107(m) of title 49, United States Code.")
rule S9502CreditCivilPenalties strict {
    for amount: Money;
    when civil_penalty_credited_47107m(AirportAndAirwayTrustFund, amount);
    then amount_credited_to_fund(AirportAndAirwayTrustFund, amount);
}

// --- (c) Appropriation of additional sums (repayable advances, general) -------

@source(IRC_S9502_C, relation = formalizes, coverage = exact, quote = "There are hereby authorized to be appropriated to the Airport and Airway Trust Fund such additional sums as may be required to make the expenditures referred to in subsection (d) of this section.")
rule S9502AdvanceAuthorized strict {
    for amount: Money;
    when advance_requested(AirportAndAirwayTrustFund, amount)
        and advance_necessary_to_make_expenditures(AirportAndAirwayTrustFund, amount);
    then power S9502AdvancePower {
        holder us.irc.core::Secretary;
        over AirportAndAirwayTrustFund;
        exercise advance_requested(AirportAndAirwayTrustFund, amount);
        valid_when advance_necessary_to_make_expenditures(AirportAndAirwayTrustFund, amount);
        effect create(advance_outstanding(AirportAndAirwayTrustFund, amount));
    };
}

// --- (d) Expenditures ----------------------------------------------------------

enum AirportAirwayExpenditurePurpose {
    AirportAirwayDevelopmentActs;     // (d)(1)(A)
    Title49AirTrafficControlEtc;      // (d)(1)(B)
    DotAdministrativeExpenses;        // (d)(1)(C)
}
relation airport_airway_expenditure_purpose(e: Expenditure, purpose: AirportAirwayExpenditurePurpose) kind empirical;
relation expenditure_before_date(e: Expenditure, cutoff: Date) kind empirical {
    label en unofficial "the date the expenditure would be made, for comparison against the section's expenditure-window cutoff date";
}

@source(IRC_S9502_D, relation = formalizes, coverage = partial, quote = "incurred under title I of the Airport and Airway Development Act of 1970 or of the Airport and Airway Development Act Amendments of 1976 or of the Aviation Safety and Noise Abatement Act of 1979")
rule S9502ExpenditureAuthorizedDevelopmentActs defeasible {
    for e: Expenditure;
    for cutoff: Date;
    when expenditure_from_fund(e, AirportAndAirwayTrustFund)
        and airport_airway_expenditure_purpose(e, AirportAirwayDevelopmentActs)
        and expenditure_before_date(e, cutoff)
        and cutoff < @2028-10-01;
    then expenditure_authorized(e, AirportAndAirwayTrustFund);
}
@source(IRC_S9502_D, relation = formalizes, coverage = partial, quote = "heretofore or hereafter incurred under part A of subtitle VII of title 49, United States Code, which are attributable to planning, research and development, construction, or operation and maintenance of")
rule S9502ExpenditureAuthorizedTitle49 defeasible {
    for e: Expenditure;
    for cutoff: Date;
    when expenditure_from_fund(e, AirportAndAirwayTrustFund)
        and airport_airway_expenditure_purpose(e, Title49AirTrafficControlEtc)
        and expenditure_before_date(e, cutoff)
        and cutoff < @2028-10-01;
    then expenditure_authorized(e, AirportAndAirwayTrustFund);
}
@source(IRC_S9502_D, relation = formalizes, coverage = partial, quote = "for those portions of the administrative expenses of the Department of Transportation which are attributable to activities described in subparagraph (A) or (B).")
rule S9502ExpenditureAuthorizedDotAdmin defeasible {
    for e: Expenditure;
    for cutoff: Date;
    when expenditure_from_fund(e, AirportAndAirwayTrustFund)
        and airport_airway_expenditure_purpose(e, DotAdministrativeExpenses)
        and expenditure_before_date(e, cutoff)
        and cutoff < @2028-10-01;
    then expenditure_authorized(e, AirportAndAirwayTrustFund);
}

// (d)(2)-(6): transfers OUT for fuel-credit/refund reconciliation and
// affected-airport payments — modelled as institutional facts of the
// transfer itself; the Secretary's underlying estimate/adjustment
// computation is TECH_GAP (see module header).
enum AirportAirwayOutTransferKind {
    FarmAndNonhighwayFuelCredits;      // (d)(2)
    Section34Credits;                  // (d)(3)
    Section6402Or6415RefundsCredits;   // (d)(5)
}
relation estimate_based_transfer(f: TrustFund, kind: AirportAirwayOutTransferKind, amount: Money) kind institutional {
    label en unofficial "the Secretary pays from the fund into the general fund an amount equivalent to the named category of credits/refunds, on the basis of the Secretary's own estimate";
}
relation fuel_credit_or_refund_paid(kind: AirportAirwayOutTransferKind, amount: Money) kind empirical {
    label en unofficial "the underlying farm/nonhighway fuel credit (§6420/§6421/§6427) or §34 credit has been paid, in the stated amount — the event that triggers the Secretary's duty to transfer an equivalent amount out of the fund";
}
@source(IRC_S9502_D, relation = formalizes, coverage = partial, quote = "The Secretary of the Treasury shall pay from time to time from the Airport and Airway Trust Fund into the general fund of the Treasury amounts equivalent to the amounts paid after August 31, 1982, in respect of fuel used in aircraft, under section 6420")
rule S9502OutTransferFarmNonhighway strict {
    for amount: Money;
    when fuel_credit_or_refund_paid(FarmAndNonhighwayFuelCredits, amount);
    then duty S9502PayOutFarmNonhighway {
        bearer us.irc.core::Secretary;
        beneficiary us.irc.core::Secretary; // paid to the general fund of the Treasury, which the Secretary also administers
        goal maintenance {
            condition estimate_based_transfer(AirportAndAirwayTrustFund, FarmAndNonhighwayFuelCredits, amount);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S9502_D, relation = formalizes, coverage = partial, quote = "The Secretary of the Treasury shall pay from time to time from the Airport and Airway Trust Fund into the general fund of the Treasury amounts equivalent to the credits allowed under section 34")
rule S9502OutTransferSection34 strict {
    for amount: Money;
    when fuel_credit_or_refund_paid(Section34Credits, amount);
    then duty S9502PayOutSection34 {
        bearer us.irc.core::Secretary;
        beneficiary us.irc.core::Secretary;
        goal maintenance {
            condition estimate_based_transfer(AirportAndAirwayTrustFund, Section34Credits, amount);
            window [-infinity, infinity];
        }
    };
}
relation appropriated_amount_for_fuel_used(kind: AirportAirwayOutTransferKind, amount: Money) kind empirical {
    label en unofficial "the amount required to be appropriated to the fund with respect to the fuel used that gives rise to the (d)(2)/(3) credit or refund — the (d)(4) cap's own comparator";
}
relation out_transfer_capped_by_appropriated(f: TrustFund, kind: AirportAirwayOutTransferKind, amount: Money, appropriated: Money) kind institutional {
    label en unofficial "the (d)(4) cap: amounts payable under (d)(2)/(3) shall not exceed the amounts required to be appropriated to the fund for the fuel so used";
}
@source(IRC_S9502_D, relation = formalizes, coverage = exact, quote = "The amounts payable from the Airport and Airway Trust Fund under paragraph (2) or (3) shall not exceed the amounts required to be appropriated to such Trust Fund with respect to fuel so used.")
rule S9502OutTransferCap strict {
    for kind: AirportAirwayOutTransferKind;
    for amount: Money;
    for appropriated: Money;
    when estimate_based_transfer(AirportAndAirwayTrustFund, kind, amount)
        and appropriated_amount_for_fuel_used(kind, appropriated)
        and amount <= appropriated;
    then out_transfer_capped_by_appropriated(AirportAndAirwayTrustFund, kind, amount, appropriated);
}

relation diversion_affected_airport_payment(amount: Money) kind empirical;
@source(IRC_S9502_D, relation = formalizes, coverage = partial, quote = "The Secretary of the Treasury may transfer from the Airport and Airway Trust Fund to the Secretary of Transportation or the Administrator of the Federal Aviation Administration an amount to make a payment to an airport affected by a diversion")
rule S9502DiversionPayment strict {
    for amount: Money;
    when diversion_affected_airport_payment(amount);
    then power S9502DiversionPaymentPower {
        holder us.irc.core::Secretary;
        over AirportAndAirwayTrustFund;
        exercise diversion_affected_airport_payment(amount);
        valid_when diversion_affected_airport_payment(amount);
        effect create(estimate_based_transfer(AirportAndAirwayTrustFund, Section6402Or6415RefundsCredits, amount));
    };
}

// --- (e) Limitation on transfers ------------------------------------------------

relation expenditure_permitted_by_section(e: Expenditure, f: TrustFund) kind institutional {
    label en unofficial "the expenditure is permitted by this section (i.e., authorized under (d)) — the trigger condition for the (e)(1) limitation on further transfers";
}
relation liquidates_prior_obligation_before_cutoff(e: Expenditure, cutoff: Date) kind empirical {
    label en unofficial "the expenditure liquidates a contract entered into, or an amount otherwise obligated, before the section's obligation cutoff — the (e)(2) exception";
}
// (e)(1)-(2): modelled as a CLASSIFICATION, not a `prohibition` block —
// the statute's own trigger ("on and after the date of an unpermitted
// expenditure") and the object of the bar (a FUTURE appropriation) are the
// same institutional moment described from two sides, not an independent
// addressee action a `prohibition`'s `action` slot could name without
// circularity (the triggering fact and the forbidden fact would coincide).
// `further_appropriation_barred` records the classification directly.
relation further_appropriation_barred(f: TrustFund) kind institutional {
    label en unofficial "no further amount may be appropriated or credited to the fund, because an expenditure not permitted by this section has been made and is not saved by the (e)(2) prior-obligation exception";
}
@source(IRC_S9502_E, relation = formalizes, coverage = partial, quote = "Except as provided in paragraph (2), no amount may be appropriated or credited to the Airport and Airway Trust Fund on and after the date of any expenditure from the Airport and Airway Trust Fund which is not permitted by this section.")
rule S9502LimitationOnTransfers defeasible {
    for e: Expenditure;
    when expenditure_from_fund(e, AirportAndAirwayTrustFund)
        and not_known(expenditure_authorized(e, AirportAndAirwayTrustFund));
    then further_appropriation_barred(AirportAndAirwayTrustFund);
    unless liquidates_prior_obligation_before_cutoff(e, @2028-10-01);
}

// --- (f) Additional transfer --------------------------------------------------

@source(IRC_S9502_F, relation = formalizes, coverage = exact, quote = "Out of money in the Treasury not otherwise appropriated, there is hereby appropriated $14,000,000,000 to the Airport and Airway Trust Fund.")
rule S9502LumpSumAppropriation strict {
    then appropriated_lump_sum(AirportAndAirwayTrustFund, "S9502(f)", 14000000000 USD);
}
