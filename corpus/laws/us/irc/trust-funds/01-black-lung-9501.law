// 26 U.S.C. §9501 — Black Lung Disability Trust Fund.
//
// JUDGMENT CALLS:
//  - (a)(2) (trustees: Secretary of the Treasury, Secretary of Labor,
//    Secretary of Health and Human Services) is a designation of who holds
//    the trusteeship, not a duty with a breach condition; modelled as a
//    plain institutional fact (`is_trustee_of`), classification not duty.
//  - (b)(2)(A)-(C) (credited amounts under the Black Lung Benefits Act) name
//    a Title 30 statute this task does not formalize; each is a typed
//    EXTERNAL_DEPENDENCY (owner: none — Title 30, out of Title 26's scope)
//    represented by a single case-supplied fact per item rather than a
//    reproduction of Black Lung Benefits Act conditions.
//  - (c) repayable advances and (d) expenditure purposes use the shared
//    shapes from 00-shared.law. (d)(1)'s own nested conditions (operator
//    non-payment within 30 days, no liable operator) are Black Lung Benefits
//    Act administrative findings (Secretary of Labor determinations) — this
//    package represents the LABOR SECRETARY'S DETERMINATION as a single
//    case fact (`labor_secretary_determines_benefit_payable`), not a
//    reproduction of the Black Lung Benefits Act's own eligibility rules
//    (EXTERNAL_DEPENDENCY, owner: none — Title 30).
//  - (d)'s introductory "as provided by appropriation Acts" condition on
//    every purpose is the same un-modelled appropriations-Act-availability
//    gate flagged in 00-shared.law — TECH_GAP, not reproduced.

language "law.core" version "0.2";
package us.irc.trust_funds version "0.1.1";
namespace "urn:us:irc:trust_funds:clir";

use self::{
    BlackLungDisabilityTrustFund,
    Expenditure,
    FundedTaxReference,
    IRC_S9501_A,
    IRC_S9501_B,
    IRC_S9501_C,
    IRC_S9501_D,
    Organ,
    TrustFund,
    advance_necessary_to_make_expenditures,
    advance_outstanding,
    advance_repaid,
    advance_requested,
    amount_credited_to_fund,
    expenditure_authorized,
    expenditure_from_fund,
    fund_established,
    fund_funded_by,
};

// --- (a) Creation ------------------------------------------------------------

@source(IRC_S9501_A, relation = formalizes, coverage = partial, quote = "There is established in the Treasury of the United States a trust fund to be known as the \"Black Lung Disability Trust Fund\", consisting of such amounts as may be appropriated or credited to the Black Lung Disability Trust Fund.")
rule S9501EstablishFund strict {
    then fund_established(BlackLungDisabilityTrustFund);
}

relation is_trustee_of(p: Organ, f: TrustFund) kind institutional {
    label en unofficial "the organ is a trustee of the trust fund";
}
@source(IRC_S9501_A, relation = formalizes, coverage = exact, quote = "The trustees of the Black Lung Disability Trust Fund shall be the Secretary of the Treasury, the Secretary of Labor, and the Secretary of Health and Human Services.")
rule S9501Trustees strict {
    then is_trustee_of(us.irc.core::Secretary, BlackLungDisabilityTrustFund);
}

// --- (b) Transfer of certain taxes; other receipts ---------------------------

@source(IRC_S9501_B, relation = formalizes, coverage = partial, quote = "There are hereby appropriated to the Black Lung Disability Trust Fund amounts equivalent to the taxes received in the Treasury under section 4121 or subchapter B of chapter 42.")
rule S9501FundedByExciseTax strict {
    then fund_funded_by(BlackLungDisabilityTrustFund, Section4121BlackLungExciseTax);
}

// (b)(2)(A)-(C): repaid/recovered amounts and penalty amounts under the
// Black Lung Benefits Act (Title 30), and amounts from a §501(c)(21) trust —
// each a case-supplied credited-amount fact (EXTERNAL_DEPENDENCY as to the
// underlying Title 30 conditions; the crediting relation itself is this
// package's own institutional effect).
relation black_lung_act_repayment_credited(f: TrustFund, amount: Money) kind empirical {
    label en unofficial "an amount repaid or recovered under §424(b) of the Black Lung Benefits Act (with interest) has been credited to the fund — the underlying Title 30 repayment condition is an external dependency this package does not reproduce";
}
relation black_lung_act_penalty_credited(f: TrustFund, amount: Money) kind empirical {
    label en unofficial "an amount paid as a fine, penalty, or interest thereon under §423, §431, or §432 of the Black Lung Benefits Act has been credited to the fund — external dependency, Title 30";
}
relation section_501c21_trust_payment_credited(f: TrustFund, amount: Money) kind empirical {
    label en unofficial "an amount paid into the fund by a trust described in §501(c)(21) has been credited";
}
@source(IRC_S9501_B, relation = formalizes, coverage = partial, quote = "(A) Amounts repaid or recovered under subsection (b) of section 424 of the Black Lung Benefits Act (including interest thereon).")
rule S9501CreditRepayment strict {
    for amount: Money;
    when black_lung_act_repayment_credited(BlackLungDisabilityTrustFund, amount);
    then amount_credited_to_fund(BlackLungDisabilityTrustFund, amount);
}
@source(IRC_S9501_B, relation = formalizes, coverage = partial, quote = "(B) Amounts paid as fines or penalties, or interest thereon, under section 423, 431, or 432 of the Black Lung Benefits Act.")
rule S9501CreditPenalty strict {
    for amount: Money;
    when black_lung_act_penalty_credited(BlackLungDisabilityTrustFund, amount);
    then amount_credited_to_fund(BlackLungDisabilityTrustFund, amount);
}
@source(IRC_S9501_B, relation = formalizes, coverage = partial, quote = "(C) Amounts paid into the Black Lung Disability Trust Fund by a trust described in section 501(c)(21).")
rule S9501CreditTrustPayment strict {
    for amount: Money;
    when section_501c21_trust_payment_credited(BlackLungDisabilityTrustFund, amount);
    then amount_credited_to_fund(BlackLungDisabilityTrustFund, amount);
}

// --- (c) Repayable advances ----------------------------------------------------

@source(IRC_S9501_C, relation = formalizes, coverage = partial, quote = "There are authorized to be appropriated to the Black Lung Disability Trust Fund, as repayable advances, such sums as may from time to time be necessary to make the expenditures described in subsection (d).")
rule S9501AdvanceAuthorized strict {
    for amount: Money;
    when advance_requested(BlackLungDisabilityTrustFund, amount)
        and advance_necessary_to_make_expenditures(BlackLungDisabilityTrustFund, amount);
    then power S9501AdvancePower {
        holder us.irc.core::Secretary;
        over BlackLungDisabilityTrustFund;
        exercise advance_requested(BlackLungDisabilityTrustFund, amount);
        valid_when advance_necessary_to_make_expenditures(BlackLungDisabilityTrustFund, amount);
        effect create(advance_outstanding(BlackLungDisabilityTrustFund, amount));
    };
}

@source(IRC_S9501_C, relation = formalizes, coverage = partial, quote = "Repayable advances made to the Black Lung Disability Trust Fund shall be repaid, and interest on such advances shall be paid, to the general fund of the Treasury when the Secretary of the Treasury determines that moneys are available in the Black Lung Disability Trust Fund for such purposes.")
rule S9501RepayAdvanceDuty defeasible {
    for amount: Money;
    when advance_outstanding(BlackLungDisabilityTrustFund, amount);
    then duty S9501RepayAdvance {
        bearer BlackLungDisabilityTrustFund;
        beneficiary us.irc.core::Secretary;
        goal achievement {
            condition advance_repaid(BlackLungDisabilityTrustFund, amount);
            window [-infinity, infinity];
        }
    };
}
relation moneys_available_for_repayment(f: TrustFund) kind institutional {
    label en unofficial "the Secretary of the Treasury has determined that moneys are available in the fund to repay advances — a DECISION-0194 evaluative determination of the Secretary";
}

// (c)(3) interest rate: an institutional VALUE the Secretary determines by a
// named external benchmark ("the current average market yield on
// outstanding marketable obligations..."); not a fixed statutory rate this
// package can pin — EXTERNAL_DEPENDENCY (Treasury market-yield data),
// represented as a case-supplied fact.
relation advance_interest_rate(f: TrustFund, rate: Decimal) kind institutional {
    label en unofficial "the Secretary-determined interest rate on repayable advances to the fund, equal to the current average market yield on comparable outstanding marketable U.S. obligations (external market data, not a statutory constant)";
}

// --- (d) Expenditures from Trust Fund ------------------------------------------

enum BlackLungExpenditurePurpose {
    BenefitsWhereOperatorNonpayment;      // (d)(1)(A)
    BenefitsWhereNoLiableOperator;        // (d)(1)(B)
    PreJan1970MinerClaimObligations;      // (d)(2)
    RepaymentOfPreApril1978Expenditures;  // (d)(3)
    RepaymentAndInterestOnAdvances;       // (d)(4)
    AdministrationExpensesLaborOrHhs;     // (d)(5)(A)
    AdministrationExpensesTreasury;       // (d)(5)(B)
    OperatorReimbursementPreApril1978;    // (d)(6)
    OperatorInsurerReimbursementDeniedClaims; // (d)(7)
}
relation black_lung_expenditure_purpose(e: Expenditure, purpose: BlackLungExpenditurePurpose) kind empirical;

relation labor_secretary_determines_benefit_payable(claim_kind: BlackLungExpenditurePurpose) kind empirical {
    label en unofficial "the Secretary of Labor has determined the (d)(1) condition (operator non-payment within 30 days after an initial eligibility determination, or a payment more than 30 days overdue, or no liable operator) — Black Lung Benefits Act administrative finding, external dependency";
}

@source(IRC_S9501_D, relation = formalizes, coverage = partial, quote = "the payment of benefits under section 422 of the Black Lung Benefits Act in any case in which the Secretary of Labor determines that")
rule S9501ExpenditureAuthorizedBenefits defeasible {
    for e: Expenditure;
    for purpose: BlackLungExpenditurePurpose;
    when expenditure_from_fund(e, BlackLungDisabilityTrustFund)
        and black_lung_expenditure_purpose(e, purpose)
        and (purpose == BenefitsWhereOperatorNonpayment or purpose == BenefitsWhereNoLiableOperator)
        and labor_secretary_determines_benefit_payable(purpose);
    then expenditure_authorized(e, BlackLungDisabilityTrustFund);
}

@source(IRC_S9501_D, relation = formalizes, coverage = partial, quote = "the payment of obligations incurred by the Secretary of Labor with respect to all claims of miners of their survivors in which the miner's last coal mine employment was before January 1, 1970")
rule S9501ExpenditureAuthorizedPreExistingClaims strict {
    for e: Expenditure;
    when expenditure_from_fund(e, BlackLungDisabilityTrustFund)
        and black_lung_expenditure_purpose(e, PreJan1970MinerClaimObligations);
    then expenditure_authorized(e, BlackLungDisabilityTrustFund);
}
@source(IRC_S9501_D, relation = formalizes, coverage = partial, quote = "the repayment into the Treasury of the United States of an amount equal to the sum of the amounts expended by the Secretary of Labor for claims under part C of the Black Lung Benefits Act which were paid before April 1, 1978")
rule S9501ExpenditureAuthorizedRepaymentPre1978 strict {
    for e: Expenditure;
    when expenditure_from_fund(e, BlackLungDisabilityTrustFund)
        and black_lung_expenditure_purpose(e, RepaymentOfPreApril1978Expenditures);
    then expenditure_authorized(e, BlackLungDisabilityTrustFund);
}
@source(IRC_S9501_D, relation = formalizes, coverage = partial, quote = "the repayment of, and the payment of interest on, repayable advances to the Black Lung Disability Trust Fund")
rule S9501ExpenditureAuthorizedRepayAdvance strict {
    for e: Expenditure;
    when expenditure_from_fund(e, BlackLungDisabilityTrustFund)
        and black_lung_expenditure_purpose(e, RepaymentAndInterestOnAdvances);
    then expenditure_authorized(e, BlackLungDisabilityTrustFund);
}
@source(IRC_S9501_D, relation = formalizes, coverage = partial, quote = "incurred by the Department of Labor or the Department of Health and Human Services under part C of the Black Lung Benefits Act (other than under section 427(a) or 433)")
rule S9501ExpenditureAuthorizedAdminLaborHhs strict {
    for e: Expenditure;
    when expenditure_from_fund(e, BlackLungDisabilityTrustFund)
        and black_lung_expenditure_purpose(e, AdministrationExpensesLaborOrHhs);
    then expenditure_authorized(e, BlackLungDisabilityTrustFund);
}
@source(IRC_S9501_D, relation = formalizes, coverage = partial, quote = "incurred by the Department of the Treasury in administering subchapter B of chapter 32 and in carrying out its responsibilities with respect to the Black Lung Disability Trust Fund")
rule S9501ExpenditureAuthorizedAdminTreasury strict {
    for e: Expenditure;
    when expenditure_from_fund(e, BlackLungDisabilityTrustFund)
        and black_lung_expenditure_purpose(e, AdministrationExpensesTreasury);
    then expenditure_authorized(e, BlackLungDisabilityTrustFund);
}
@source(IRC_S9501_D, relation = formalizes, coverage = partial, quote = "the reimbursement of operators for amounts paid by such operators (other than as penalties or interest) before April 1, 1978, in satisfaction (in whole or in part) of claims of miners whose last employment in coal mines was terminated before January 1, 1970")
rule S9501ExpenditureAuthorizedOperatorReimbursement strict {
    for e: Expenditure;
    when expenditure_from_fund(e, BlackLungDisabilityTrustFund)
        and black_lung_expenditure_purpose(e, OperatorReimbursementPreApril1978);
    then expenditure_authorized(e, BlackLungDisabilityTrustFund);
}
@source(IRC_S9501_D, relation = formalizes, coverage = partial, quote = "the reimbursement of operators and insurers for amounts paid by such operators and insurers (other than amounts paid as penalties, interest, or attorney fees) at any time in satisfaction (in whole or in part) of any claim denied")
rule S9501ExpenditureAuthorizedDeniedClaimReimbursement strict {
    for e: Expenditure;
    when expenditure_from_fund(e, BlackLungDisabilityTrustFund)
        and black_lung_expenditure_purpose(e, OperatorInsurerReimbursementDeniedClaims);
    then expenditure_authorized(e, BlackLungDisabilityTrustFund);
}
