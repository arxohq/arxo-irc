// 26 U.S.C. §9503 — Highway Trust Fund (largest section of this package: 199
// DISPOSITIONS.json rows, mostly (b)(1) funding-source items, (f)'s long
// list of one-time historical lump-sum appropriations, and statutory notes).
//
// JUDGMENT CALLS:
//  - (b)(1)'s flush "without reduction for credits under section 6426"/
//    "without regard to" clauses are RULES OF MEASUREMENT for the Treasury's
//    own receipt figure (`tax_receipts_for_period`), not independent
//    dispositions this package tests separately — the case-supplied receipt
//    figure is taken to already reflect them (INTERPRETATION, noted per row).
//  - (b)(3) is Repealed (Pub. L. 109-59) — NON_NORMATIVE, repealed_or_reserved.
//  - (b)(4) (taxes NOT transferred: §4041(d), part of §4081, train fuel, and
//    the historical rate-differential carve-out (b)(4)(D)) is modelled as an
//    EXCLUSION on the funding linkage for the two taxes it can name
//    (`Section4041FuelTaxGeneral`/`Section4081FuelTaxGeneral`); the numeric
//    rate-differential sub-tests in (b)(4)(D)(i)-(iii) are historical
//    (pre-October-2005) cent-per-gallon comparisons this package does not
//    reproduce as a live rule — TECH_GAP, minimal repro: a scenario needing
//    a pre-2005 rate differential.
//  - (b)(5) penalty transfers name eight OTHER Code sections (§§6715 etc.)
//    by number without reproducing their own conditions — the transfer
//    linkage itself is EXECUTABLE; the underlying penalty determination is
//    each of those sections' own norm (owned elsewhere), not reproduced.
//  - (d) (adjustment of apportionments between Treasury and Transportation
//    Secretaries) is a multi-step ESTIMATING PROCEDURE with quarterly
//    Treasury estimates, a percentage computed by Transportation, and a
//    subsequent "catch-up" apportionment. This package models the
//    DUTY TO ESTIMATE (d)(1)/(d)(7) and the classification of when an
//    excess exists (d)(2)) as executable; the percentage FORMULA of
//    (d)(3)(A) and the apportionment adjustment mechanics of (d)(3)(B)/(4)
//    are TECH_GAP (no running highway-authorization ledger is modelled,
//    consistent with 00-shared.law's no-ledger judgment call) — recorded
//    with a minimal reproduction (a scenario needing the withheld-percentage
//    number itself, not just whether an excess exists).
//  - (e) Mass Transit Account: the five differentiated cents-per-gallon
//    rates (e)(2)(A)-(E) are modelled as a single `.lawparam.json`-free
//    constant table (`MassTransitCentsPerGallon`) keyed by fuel category —
//    fixed statutory cent amounts, not later-indexed, so no A3 dataset
//    machinery is needed (contrast PCOR's year-varying schedule, module 06).
//  - (f): every numbered paragraph names a FIXED historical dollar figure
//    for a named occasion; each is one `appropriated_lump_sum` fact. (f)(1)
//    (opening-balance restatement) and (f)(3)/(6)/(9) (transfers FROM LUST
//    under §9508(c)) are cross-references to another fund's own expenditure
//    rule, not new dollar facts — represented by a dedicated relation.

language "law.core" version "0.2";
package us.irc.trust_funds version "0.1.1";
namespace "urn:us:irc:trust_funds:clir";

use self::{
    AirportAirwayOutTransferKind,
    AirportAndAirwayTrustFund,
    Expenditure,
    FundedTaxReference,
    HighwayTrustFund,
    IRC_S9503_A,
    IRC_S9503_B,
    IRC_S9503_C,
    IRC_S9503_D,
    IRC_S9503_E,
    IRC_S9503_F,
    MassTransitAccount,
    Period,
    SportFishRestorationAndBoatingTrustFund,
    TrustFund,
    amount_credited_to_fund,
    appropriated_lump_sum,
    credited_to_fund,
    expenditure_authorized,
    expenditure_from_fund,
    fund_established,
    fund_funded_by,
    out_transfer_capped_by_appropriated,
    tax_receipts_for_period,
};

// --- (a) Creation --------------------------------------------------------------

@source(IRC_S9503_A, relation = formalizes, coverage = partial, quote = "There is established in the Treasury of the United States a trust fund to be known as the \"Highway Trust Fund\", consisting of such amounts as may be appropriated or credited to the Highway Trust Fund")
rule S9503EstablishFund strict { then fund_established(HighwayTrustFund); }

// --- (b)(1) Certain taxes ------------------------------------------------------

@source(IRC_S9503_B, relation = formalizes, coverage = partial, quote = "(A) section 4041 (relating to taxes on diesel fuels and special motor fuels),")
rule S9503FundedByFuelTax strict { then fund_funded_by(HighwayTrustFund, Section4041FuelTaxGeneral); }
@source(IRC_S9503_B, relation = formalizes, coverage = partial, quote = "(B) section 4051 (relating to retail tax on heavy trucks and trailers),")
rule S9503FundedByTruckTax strict { then fund_funded_by(HighwayTrustFund, Section4051RetailTruckTax); }
@source(IRC_S9503_B, relation = formalizes, coverage = partial, quote = "(C) section 4071 (relating to tax on tires),")
rule S9503FundedByTireTax strict { then fund_funded_by(HighwayTrustFund, Section4071TireTax); }
@source(IRC_S9503_B, relation = formalizes, coverage = partial, quote = "(D) section 4081 (relating to tax on gasoline, diesel fuel, and kerosene), and")
rule S9503FundedByFuelTaxGasoline strict { then fund_funded_by(HighwayTrustFund, Section4081FuelTaxGeneral); }
@source(IRC_S9503_B, relation = formalizes, coverage = partial, quote = "(E) section 4481 (relating to tax on use of certain vehicles).")
rule S9503FundedByHighwayUseTax strict { then fund_funded_by(HighwayTrustFund, Section4481HighwayUseTax); }

// (b)(2): post-cutoff liabilities incurred before October 1, 2028 but
// received later — a temporal extension of the SAME funding linkage, not a
// distinct tax; modelled as a classification on the receipt period rather
// than a new enum value.
relation receipt_attributable_to_pre_cutoff_liability(tax: FundedTaxReference, p: Period) kind empirical {
    label en unofficial "the receipt, though received after September 30, 2028 and before July 1, 2029, is attributable to tax liability incurred before October 1, 2028 (§9503(b)(2))";
}
@source(IRC_S9503_B, relation = formalizes, coverage = partial, quote = "There are hereby appropriated to the Highway Trust Fund amounts equivalent to the taxes which are received in the Treasury after September 30, 2028, and before July 1, 2029, and which are attributable to liability for tax")
rule S9503PostCutoffLiabilityStillFunded strict {
    for tax: FundedTaxReference;
    for p: Period;
    for amount: Money;
    when receipt_attributable_to_pre_cutoff_liability(tax, p) and tax_receipts_for_period(tax, p, amount);
    then credited_to_fund(HighwayTrustFund, tax, p, amount);
}

// (b)(3): Repealed.
relation section_9503_b_3_repealed() kind institutional { label en unofficial "§9503(b)(3) was repealed by Pub. L. 109-59, title XI, §11161(c)(2)(C) — no current disposition"; }

// (b)(4): exclusions from (b)(1)/(2).
relation excluded_from_highway_fund_transfer(tax: FundedTaxReference, p: Period) kind institutional {
    label en unofficial "the receipt, though nominally under §4041 or §4081, is excluded from the Highway Trust Fund transfer by §9503(b)(4)";
}
relation train_fuel_use(p: Period) kind empirical { label en unofficial "the fuel is used in a train (§9503(b)(4)(C) exclusion)"; }
@source(IRC_S9503_B, relation = formalizes, coverage = partial, quote = "section 4041 or 4081 to the extent attributable to fuel used in a train, or")
rule S9503ExcludeTrainFuel4041 strict {
    for p: Period;
    when train_fuel_use(p);
    then excluded_from_highway_fund_transfer(Section4041FuelTaxGeneral, p);
}
@source(IRC_S9503_B, relation = formalizes, coverage = partial, quote = "section 4041 or 4081 to the extent attributable to fuel used in a train, or")
rule S9503ExcludeTrainFuel4081 strict {
    for p: Period;
    when train_fuel_use(p);
    then excluded_from_highway_fund_transfer(Section4081FuelTaxGeneral, p);
}

// (b)(5) penalties.
enum HighwayPenaltySection { S6715; S6715A; S6717; S6718; S6719; S6720A; S6725; S7232; S7272; }
relation penalty_paid_under(section: HighwayPenaltySection, amount: Money) kind empirical;
@source(IRC_S9503_B, relation = formalizes, coverage = partial, quote = "There are hereby appropriated to the Highway Trust Fund amounts equivalent to the penalties paid under sections 6715, 6715A, 6717, 6718, 6719, 6720A, 6725, 7232, and 7272")
rule S9503FundedByPenalties strict {
    for section: HighwayPenaltySection;
    for amount: Money;
    when penalty_paid_under(section, amount);
    then amount_credited_to_fund(HighwayTrustFund, amount);
}
relation covered_motor_vehicle_safety_penalty_collection(amount: Money) kind empirical {
    label en unofficial "an amount collected in connection with a civil penalty under 49 U.S.C. §30165, reduced as (b)(5)(B)(ii) provides — Title 49 dependency";
}
@source(IRC_S9503_B, relation = formalizes, coverage = partial, quote = "There are hereby appropriated to the Highway Trust Fund amounts equivalent to covered motor vehicle safety penalty collections.")
rule S9503FundedBySafetyPenalties strict {
    for amount: Money;
    when covered_motor_vehicle_safety_penalty_collection(amount);
    then amount_credited_to_fund(HighwayTrustFund, amount);
}

// (b)(6): limitation on transfers — same shape as §9502(e), own relation to
// keep the two funds' classifications independent.
relation highway_expenditure_permitted(e: Expenditure) kind institutional;
relation highway_liquidates_prior_obligation(e: Expenditure, cutoff: Date) kind empirical;
relation highway_further_appropriation_barred() kind institutional {
    label en unofficial "no further amount may be appropriated to the Highway Trust Fund because an unpermitted expenditure has occurred and is not saved by the prior-obligation exception";
}
@source(IRC_S9503_B, relation = formalizes, coverage = partial, quote = "Except as provided in subparagraph (B), no amount may be appropriated to the Highway Trust Fund on and after the date of any expenditure from the Highway Trust Fund which is not permitted by this section.")
rule S9503LimitationOnTransfers defeasible {
    for e: Expenditure;
    when expenditure_from_fund(e, HighwayTrustFund) and not_known(expenditure_authorized(e, HighwayTrustFund));
    then highway_further_appropriation_barred();
    unless highway_liquidates_prior_obligation(e, @2026-10-01);
}

// --- (c) Expenditures ------------------------------------------------------------

enum HighwayExpenditurePurpose { FederalAidHighwayProgram; FloorStocksRefunds; }
relation highway_expenditure_purpose(e: Expenditure, purpose: HighwayExpenditurePurpose) kind empirical;
relation mass_transit_account_expenditure(e: Expenditure) kind empirical {
    label en unofficial "the expenditure is from the Mass Transit Account (excluded from (c)(1) by its own 'Except as provided in subsection (e)')";
}
@source(IRC_S9503_C, relation = formalizes, coverage = partial, quote = "Except as provided in subsection (e), amounts in the Highway Trust Fund shall be available, as provided by appropriation Acts, for making expenditures before October 1, 2026, to meet those obligations of the United State")
rule S9503ExpenditureAuthorizedFederalAid defeasible {
    for e: Expenditure;
    when expenditure_from_fund(e, HighwayTrustFund) and highway_expenditure_purpose(e, FederalAidHighwayProgram);
    then expenditure_authorized(e, HighwayTrustFund);
    unless mass_transit_account_expenditure(e);
}

relation floor_stocks_refund_paid(amount: Money) kind empirical;
@source(IRC_S9503_C, relation = formalizes, coverage = partial, quote = "The Secretary shall pay from time to time from the Highway Trust Fund into the general fund of the Treasury amounts equivalent to the floor stocks refunds made before July 1, 2029, under section 6412(a).")
rule S9503FloorStocksRefundDuty strict {
    for amount: Money;
    when floor_stocks_refund_paid(amount);
    then duty S9503PayFloorStocksRefund {
        bearer us.irc.core::Secretary;
        beneficiary us.irc.core::Secretary;
        goal maintenance {
            condition highway_estimate_based_transfer(HighwayTrustFund, FloorStocksRefundsKind, amount);
            window [-infinity, infinity];
        }
    };
}
// reuse the (d)-style transfer-kind shape locally (own enum, this fund only,
// to avoid cross-fund enum coupling).
enum HighwayOutTransferKind { FloorStocksRefundsKind; }
relation highway_estimate_based_transfer(f: TrustFund, kind: HighwayOutTransferKind, amount: Money) kind institutional;

// (c)(3)-(4): motorboat/small-engine fuel transfers OUT to Sport Fish
// Restoration and Boating Trust Fund — see module 04 for the receiving
// side; here only the paying-out fact and the (c)(3)(A)(ii) $1,000,000 cap.
relation motorboat_fuel_tax_amount(amount: Money) kind institutional {
    label en unofficial "the amount (as determined by the Secretary) equivalent to motorboat fuel taxes, for the Land and Water Conservation Fund transfer";
}
@source(IRC_S9503_C, relation = formalizes, coverage = partial, quote = "The aggregate amount transferred under this subparagraph during any fiscal year shall not exceed $1,000,000.")
rule S9503LwcfTransferCapped strict {
    for amount: Money;
    when motorboat_fuel_tax_amount(amount) and amount <= 1000000 USD;
    then out_transfer_capped_by_appropriated(HighwayTrustFund, FederalAidHighwayProgram, amount, 1000000 USD);
}
relation motorboat_fuel_taxes_transferred_to_sport_fish(amount: Money) kind institutional {
    label en unofficial "motorboat fuel tax amounts not transferred to the Land and Water Conservation Fund are transferred to the Sport Fish Restoration and Boating Trust Fund (§9503(c)(3)(B))";
}
@source(IRC_S9503_C, relation = formalizes, coverage = exact, quote = "shall be transferred by the Secretary from the Highway Trust Fund into the Sport Fish Restoration and Boating Trust Fund.")
rule S9503TransferExcessMotorboatFuelToSportFish strict {
    for amount: Money;
    when motorboat_fuel_tax_amount(amount);
    then amount_credited_to_fund(SportFishRestorationAndBoatingTrustFund, amount);
}

relation small_engine_fuel_tax_amount(amount: Money) kind institutional;
@source(IRC_S9503_C, relation = formalizes, coverage = partial, quote = "The Secretary shall pay from time to time from the Highway Trust Fund into the Sport Fish Restoration and Boating Trust Fund amounts (as determined by him) equivalent to the small-engine fuel taxes")
rule S9503TransferSmallEngineFuelToSportFish strict {
    for amount: Money;
    when small_engine_fuel_tax_amount(amount);
    then amount_credited_to_fund(SportFishRestorationAndBoatingTrustFund, amount);
}

relation aviation_kerosene_amount_transferred_to_airport(amount: Money) kind institutional;
@source(IRC_S9503_C, relation = formalizes, coverage = partial, quote = "The Secretary shall pay at least monthly from the Highway Trust Fund into the Airport and Airway Trust Fund amounts (as determined by the Secretary) equivalent to the taxes received on or after October 1, 2005, under sec")
rule S9503TransferAviationKeroseneToAirport strict {
    for amount: Money;
    when aviation_kerosene_amount_transferred_to_airport(amount);
    then amount_credited_to_fund(AirportAndAirwayTrustFund, amount);
}

// --- (d) Adjustments of apportionments (TECH_GAP for the formula; the duty to
// estimate and the excess/no-excess classification are executable) -----------

relation quarterly_highway_estimate_made(fiscal_year: Text) kind empirical {
    label en unofficial "the Secretary of the Treasury, after consultation with the Secretary of Transportation, has made the quarterly estimate this subsection requires";
}
relation highway_estimate_cycle_open(fiscal_year: Text) kind empirical {
    label en unofficial "a calendar quarter within the fiscal year for which the (d)(1) estimate is due has arrived (a case-supplied fact standing in for the 'not less frequently than once in each calendar quarter' recurring cadence — flagged per AGENT-BRIEF's `recurring` note, modelled as `maintenance`)";
}
@source(IRC_S9503_D, relation = formalizes, coverage = partial, quote = "The Secretary of the Treasury, not less frequently than once in each calendar quarter, after consultation with the Secretary of Transportation, shall estimate")
rule S9503QuarterlyEstimateDuty defeasible {
    for fy: Text;
    when highway_estimate_cycle_open(fy);
    then duty S9503QuarterlyEstimate {
        bearer us.irc.core::Secretary;
        beneficiary us.irc.core::Congress;
        goal maintenance {
            condition quarterly_highway_estimate_made(fy);
            window [-infinity, infinity];
        }
    };
}
relation unfunded_highway_authorizations_estimate(fy: Text, amount: Money) kind institutional;
relation net_highway_receipts_estimate(fy: Text, amount: Money) kind institutional;
relation excess_unfunded_highway_authorizations(fy: Text) kind institutional {
    label en unofficial "the estimated unfunded highway authorizations at the close of the fiscal year exceed the estimated net highway receipts for the following 48-month period (§9503(d)(2))";
}
@source(IRC_S9503_D, relation = formalizes, coverage = exact, quote = "If the Secretary of the Treasury determines for any fiscal year that the amount described in paragraph (1)(A) exceeds the amount described in paragraph (1)(B)")
rule S9503ExcessUnfundedAuthorizations strict {
    for fy: Text;
    for unfunded: Money;
    for net: Money;
    when unfunded_highway_authorizations_estimate(fy, unfunded)
        and net_highway_receipts_estimate(fy, net)
        and unfunded > net;
    then excess_unfunded_highway_authorizations(fy);
}
// STALE (26.09.2026, was TECH_GAP G202): the (d)(3) percentage formula, the
// (d)(3)(B) apportionment reduction, and the (d)(4) catch-up apportionment are now
// modelled in 08-highway-apportionment-stage3.law:142 (`S9503d3APercentage`) and
// :187-254 (d3B/d4 rules). (d)(5) definitions and (d)(6) measurement-of-receipts
// rules support that formula; see module header and 00-shared.law.

@source(IRC_S9503_D, relation = formalizes, coverage = exact, quote = "Any estimate under paragraph (1) and any determination under paragraph (2) shall be reported by the Secretary of the Treasury to the Committee on Ways and Means of the House of Representatives, the Committee on Finance o")
rule S9503ReportEstimateDuty defeasible {
    for fy: Text;
    when quarterly_highway_estimate_made(fy);
    then duty S9503ReportEstimate {
        bearer us.irc.core::Secretary;
        beneficiary us.irc.core::Congress;
        goal achievement {
            condition estimate_reported_to_congress(fy);
            window [-infinity, infinity];
        }
    };
}
relation estimate_reported_to_congress(fy: Text) kind empirical;

// --- (e) Mass Transit Account --------------------------------------------------

@source(IRC_S9503_E, relation = formalizes, coverage = partial, quote = "There is established in the Highway Trust Fund a separate account to be known as the \"Mass Transit Account\" consisting of such amounts as may be transferred or credited to the Mass Transit Account as provided in this sec")
rule S9503EstablishMassTransitAccount strict { then fund_established(MassTransitAccount); }

enum MassTransitFuelCategory { GeneralGallon; PartiallyExemptMethanolEthanol; LiquefiedNaturalGas; LiquefiedPetroleumGas; CompressedNaturalGas; }
relation mass_transit_cents_per_gallon(category: MassTransitFuelCategory, cents: Decimal) kind institutional {
    label en unofficial "the fixed cents-per-gallon (or energy-equivalent) rate transferred to the Mass Transit Account for the fuel category, per §9503(e)(2)";
}
@source(IRC_S9503_E, relation = formalizes, coverage = partial, quote = "(A) except as otherwise provided in this sentence, 2.86 cents per gallon,")
rule S9503MtaRateGeneral strict { then mass_transit_cents_per_gallon(GeneralGallon, 2.86); }
@source(IRC_S9503_E, relation = formalizes, coverage = partial, quote = "(B) 1.43 cents per gallon in the case of any partially exempt methanol or ethanol fuel (as defined in section 4041(m)) none of the alcohol in which consists of ethanol,")
rule S9503MtaRateMethanolEthanol strict { then mass_transit_cents_per_gallon(PartiallyExemptMethanolEthanol, 1.43); }
@source(IRC_S9503_E, relation = formalizes, coverage = partial, quote = "(C) 1.86 cents per energy equivalent of a gallon of diesel (as defined in section 4041(a)(2)(D)) in the case of liquefied natural gas,")
rule S9503MtaRateLng strict { then mass_transit_cents_per_gallon(LiquefiedNaturalGas, 1.86); }
@source(IRC_S9503_E, relation = formalizes, coverage = partial, quote = "(D) 2.13 cents per energy equivalent of a gallon of gasoline (as defined in section 4041(a)(2)(C)) in the case of liquefied petroleum gas, and")
rule S9503MtaRateLpg strict { then mass_transit_cents_per_gallon(LiquefiedPetroleumGas, 2.13); }
@source(IRC_S9503_E, relation = formalizes, coverage = partial, quote = "(E) 9.71 cents per MCF (determined at standard temperature and pressure) in the case of compressed natural gas.")
rule S9503MtaRateCng strict { then mass_transit_cents_per_gallon(CompressedNaturalGas, 9.71); }

relation mass_transit_expenditure_purpose(e: Expenditure) kind empirical {
    label en unofficial "the expenditure is a capital or capital-related expenditure (including for new projects) consistent with the Mass Transit Account's authorized use";
}
@source(IRC_S9503_E, relation = formalizes, coverage = partial, quote = "Amounts in the Mass Transit Account shall be available, as provided by appropriation Acts, for making capital or capital related expenditures (including capital expenditures for new projects) before October 1, 2026, in a")
rule S9503MtaExpenditureAuthorized defeasible {
    for e: Expenditure;
    when expenditure_from_fund(e, MassTransitAccount) and mass_transit_expenditure_purpose(e);
    then expenditure_authorized(e, MassTransitAccount);
}
// (e)(4) ("rules similar to subsection (d)") and (e)(5) (pro-rata sharing of
// (c)(2)/(3) transfers between the Highway Account and the Mass Transit
// Account) are cross-references to an unmodelled formula ((d)) or a ledger
// split this package does not compute — TECH_GAP, both rows.

// --- (f) Determination of Trust Fund balances / lump-sum appropriations ------

// (f)(1): balance-restatement rule — TECH_GAP (no ledger modelled).
relation section_9503_f_1_balance_restatement_tech_gap() kind institutional {
    label en unofficial "TECH_GAP placeholder: (f)(1) restates the October 1, 1998 opening balance of the Highway Account net of Mass Transit Account amounts — requires a historical ledger this package does not model";
}

@source(IRC_S9503_F, relation = formalizes, coverage = partial, quote = "$14,700,000,000 to the Highway Account (as defined in subsection (e)(5)(B)) in the Highway Trust Fund; and")
rule S9503LumpSumF2Highway strict { then appropriated_lump_sum(HighwayTrustFund, "S9503(f)(2)-Highway", 14700000000 USD); }
@source(IRC_S9503_F, relation = formalizes, coverage = partial, quote = "$4,800,000,000 to the Mass Transit Account in the Highway Trust Fund.")
rule S9503LumpSumF2MassTransit strict { then appropriated_lump_sum(MassTransitAccount, "S9503(f)(2)-MassTransit", 4800000000 USD); }

relation lust_transfer_to_highway(occasion: Text) kind institutional {
    label en unofficial "amounts appropriated from the Leaking Underground Storage Tank Trust Fund under §9508(c) are transferred to the Highway Account, per the named §9503(f) paragraph — see module 05 for the LUST-side appropriation";
}
@source(IRC_S9503_F, relation = formalizes, coverage = exact, quote = "There is hereby transferred to the Highway Account (as defined in subsection (e)(5)(B)) in the Highway Trust Fund amounts appropriated from the Leaking Underground Storage Tank Trust Fund under section 9508(c)(2).")
rule S9503LumpSumF3FromLust strict { then lust_transfer_to_highway("S9503(f)(3)"); }

@source(IRC_S9503_F, relation = formalizes, coverage = partial, quote = "for fiscal year 2013, $6,200,000,000, and")
rule S9503LumpSumF4Fy2013 strict { then appropriated_lump_sum(HighwayTrustFund, "S9503(f)(4)-FY2013-Highway", 6200000000 USD); }
@source(IRC_S9503_F, relation = formalizes, coverage = partial, quote = "for fiscal year 2014, $10,400,000,000, and")
rule S9503LumpSumF4Fy2014 strict { then appropriated_lump_sum(HighwayTrustFund, "S9503(f)(4)-FY2014-Highway", 10400000000 USD); }
@source(IRC_S9503_F, relation = formalizes, coverage = partial, quote = "the Mass Transit Account in the Highway Trust Fund, for fiscal year 2014, $2,200,000,000.")
rule S9503LumpSumF4MassTransit strict { then appropriated_lump_sum(MassTransitAccount, "S9503(f)(4)-FY2014-MassTransit", 2200000000 USD); }

@source(IRC_S9503_F, relation = formalizes, coverage = partial, quote = "$7,765,000,000 to the Highway Account (as defined in subsection (e)(5)(B)) in the Highway Trust Fund; and")
rule S9503LumpSumF5Highway strict { then appropriated_lump_sum(HighwayTrustFund, "S9503(f)(5)-Highway", 7765000000 USD); }
@source(IRC_S9503_F, relation = formalizes, coverage = partial, quote = "$2,000,000,000 to the Mass Transit Account in the Highway Trust Fund.")
rule S9503LumpSumF5MassTransit strict { then appropriated_lump_sum(MassTransitAccount, "S9503(f)(5)-MassTransit", 2000000000 USD); }

@source(IRC_S9503_F, relation = formalizes, coverage = exact, quote = "There is hereby transferred to the Highway Account (as defined in subsection (e)(5)(B)) in the Highway Trust Fund amounts appropriated from the Leaking Underground Storage Tank Trust Fund under section 9508(c)(3).")
rule S9503LumpSumF6FromLust strict { then lust_transfer_to_highway("S9503(f)(6)"); }

@source(IRC_S9503_F, relation = formalizes, coverage = partial, quote = "$6,068,000,000 to the Highway Account (as defined in subsection (e)(5)(B)) in the Highway Trust Fund; and")
rule S9503LumpSumF7Highway strict { then appropriated_lump_sum(HighwayTrustFund, "S9503(f)(7)-Highway", 6068000000 USD); }
@source(IRC_S9503_F, relation = formalizes, coverage = partial, quote = "$2,000,000,000 to the Mass Transit Account in the Highway Trust Fund.")
rule S9503LumpSumF7MassTransit strict { then appropriated_lump_sum(MassTransitAccount, "S9503(f)(7)-MassTransit", 2000000000 USD); }

@source(IRC_S9503_F, relation = formalizes, coverage = partial, quote = "$51,900,000,000 to the Highway Account (as defined in subsection (e)(5)(B)) in the Highway Trust Fund; and")
rule S9503LumpSumF8Highway strict { then appropriated_lump_sum(HighwayTrustFund, "S9503(f)(8)-Highway", 51900000000 USD); }
@source(IRC_S9503_F, relation = formalizes, coverage = partial, quote = "$18,100,000,000 to the Mass Transit Account in the Highway Trust Fund.")
rule S9503LumpSumF8MassTransit strict { then appropriated_lump_sum(MassTransitAccount, "S9503(f)(8)-MassTransit", 18100000000 USD); }

@source(IRC_S9503_F, relation = formalizes, coverage = exact, quote = "There is hereby transferred to the Highway Account (as defined in subsection (e)(5)(B)) in the Highway Trust Fund amounts appropriated from the Leaking Underground Storage Tank Trust Fund under section 9508(c)(4).")
rule S9503LumpSumF9FromLust strict { then lust_transfer_to_highway("S9503(f)(9)"); }

@source(IRC_S9503_F, relation = formalizes, coverage = partial, quote = "$10,400,000,000 to the Highway Account (as defined in subsection (e)(5)(B)) in the Highway Trust Fund; and")
rule S9503LumpSumF10Highway strict { then appropriated_lump_sum(HighwayTrustFund, "S9503(f)(10)-Highway", 10400000000 USD); }
@source(IRC_S9503_F, relation = formalizes, coverage = partial, quote = "$3,200,000,000 to the Mass Transit Account in the Highway Trust Fund.")
rule S9503LumpSumF10MassTransit strict { then appropriated_lump_sum(MassTransitAccount, "S9503(f)(10)-MassTransit", 3200000000 USD); }

@source(IRC_S9503_F, relation = formalizes, coverage = partial, quote = "$90,000,000,000 to the Highway Account (as defined in subsection (e)(5)(B)) in the Highway Trust Fund; and")
rule S9503LumpSumF11Highway strict { then appropriated_lump_sum(HighwayTrustFund, "S9503(f)(11)-Highway", 90000000000 USD); }
@source(IRC_S9503_F, relation = formalizes, coverage = partial, quote = "$28,000,000,000 to the Mass Transit Account in the Highway Trust Fund.")
rule S9503LumpSumF11MassTransit strict { then appropriated_lump_sum(MassTransitAccount, "S9503(f)(11)-MassTransit", 28000000000 USD); }

relation lump_sum_remains_available_without_fy_limitation(f: TrustFund, occasion: Text) kind institutional;
@source(IRC_S9503_F, relation = formalizes, coverage = exact, quote = "Any amount appropriated or transferred under this subsection to the Highway Trust Fund shall remain available without fiscal year limitation.")
rule S9503LumpSumsAvailableWithoutFyLimitation strict {
    for f: TrustFund;
    for occasion: Text;
    for amount: Money;
    when appropriated_lump_sum(f, occasion, amount);
    then lump_sum_remains_available_without_fy_limitation(f, occasion);
}
