// Check-the-box elections (G4-RMD wire, 27.09.2026,
// implemented_unverified; scenarios written, NOT executed; no legal review).
//
// FROM-PACKAGE: `us.cfr.t26_301_7701` (26 CFR 301.7701-1…-3, pinned eCFR
// 2026-09-24). That package is rule-less by design: the regulatory content
// enters here as CASE-SELECTED facts (the case asserts eligibility — the
// entity is not a per-se corporation under 301.7701-2(b) — and the filed
// Form 8832 election), and the rules below apply the election and the
// (b)(1) defaults. Only key literals are modelled (eligible-entity
// election as association; domestic default partnership for two-or-more
// members); the 301.7701-2(b) per-se corporation list is NOT retyped,
// and the 14 non-check-the-box EXT delegations of §7701 are NOT touched.

// --- 301.7701-3(a), (c)(1)(i): eligible-entity election -------------------
// "A business entity that is not classified as a corporation under
// § 301.7701-2(b)(1), (3), (4), (5), (6), (7), or (8) (an eligible entity)
// can elect its classification for federal tax purposes as provided in
// this section." / "an eligible entity may elect to be classified other
// than as provided under paragraph (b) of this section, or to change its
// classification, by filing Form 8832, Entity Classification Election,
// with the service center designated on Form 8832."

use self::{
    Association,
    IRC_S7701,
    Person,
    corporation,
    partnership,
};

pub relation eligible_entity_for_check_box(a: Association) kind empirical {
    label en unofficial "the association is an eligible entity: not classified as a corporation under 301.7701-2(b)(1),(3)-(8) (case-asserted; the per-se list is not retyped)";
}
pub relation check_box_association_election_filed(a: Association) kind empirical {
    label en unofficial "the eligible entity filed Form 8832 electing association (corporation) classification (301.7701-3(c)(1)(i); case-asserted)";
}
@source(IRC_S7701, relation = formalizes, coverage = contextual, quote = "The term \"corporation\" includes associations, joint-stock companies, and insurance companies.")
rule ElectedAssociationIsCorporation strict {
    for a: Association;
    when eligible_entity_for_check_box(a)
        and check_box_association_election_filed(a);
    then corporation(a);
}

// --- 301.7701-3(b)(1)(i): domestic default --------------------------------
// "Unless the entity elects otherwise, a domestic eligible entity is—
// (i) A partnership if it has two or more members".

pub relation domestic_eligible_entity_with_two_or_more_members(a: Association) kind empirical {
    label en unofficial "a domestic eligible entity with two or more members (case-asserted)";
}
pub relation no_check_box_election_filed(a: Association) kind empirical {
    label en unofficial "the eligible entity filed no classification election (case-asserted absence)";
}
@source(IRC_S7701, relation = formalizes, coverage = contextual, quote = "The term \"corporation\" includes associations, joint-stock companies, and insurance companies.")
rule DefaultDomesticEligibleEntityIsPartnership strict {
    for a: Association;
    when domestic_eligible_entity_with_two_or_more_members(a)
        and no_check_box_election_filed(a);
    then partnership(a);
}
