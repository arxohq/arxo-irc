// Stage 3 (26.09.2026) — section 7702 computational rules (e) and the other
// definitions and special rules (f), the parts stage 2 left as "not separately
// derived". The actuarial tables and the general-account values are asserted
// inputs of the case (the package embeds no mortality table); what is derived
// is what the text states as a rule: the deemed maturity date, the deemed
// endowment benefit, the definitions as arithmetic over the components, the
// recapture ceilings of (f)(7), the waiver power of (f)(8), the transitional
// tables of (f)(10) and the insurance interest rate of (f)(11).
//
// JUDGMENT CALLS
//  - (f)(7)(C)-(D): "the 5-year period beginning on the issue date" is
//    [issue, issue + 5 years); "the 15-year period" is [issue, issue + 15 years).
//  - (f)(11)(C): "rounded to the nearest whole percentage point": HALF_UP (the
//    text names no tie rule).
//  - (e)(1)(A) (the death benefit is deemed not to increase) is stated over the
//    whole future path of the benefit; it is applied by the actuary that asserts
//    the net single premium and is not re-derived here.

language "law.core" version "0.2";
package us.irc.definitions version "0.1.1";
namespace "urn:us:irc:definitions:clir";

use self::{
    IRC_S7702_E,
    IRC_S7702_F,
    InsuranceContract,
    Person,
    Secretary,
    contract_initial_death_benefit,
    contract_policyholder,
};

// ============================================================================
// (e)(1) deemed maturity date and endowment benefit; (e)(2) permitted increases
// ============================================================================

pub relation contract_stated_maturity_date(c: InsuranceContract, d: Date) kind empirical { label en official "the maturity date the contract provides"; }
pub relation insured_attains_age_95_on(c: InsuranceContract, d: Date) kind empirical { label en official "the day on which the insured attains age 95"; }
pub relation insured_attains_age_100_on(c: InsuranceContract, d: Date) kind empirical { label en official "the day on which the insured attains age 100"; }
pub relation deemed_maturity_date(c: InsuranceContract, d: Date) kind institutional { label en official "the maturity date, including the date on which any benefit described in (C) is payable, deemed to be no earlier than age 95 and no later than age 100"; }
@source(IRC_S7702_E, coverage = exact, quote = "the maturity date, including the date on which any benefit described in subparagraph (C) is payable, shall be deemed to be no earlier than the day on which the insured attains age 95, and no later than the day on which the insured attains age 100")
rule DeemedMaturityDateWithinAges95To100 strict { for c: InsuranceContract; for d: Date; for a: Date; for b: Date; when contract_stated_maturity_date(c, d) and insured_attains_age_95_on(c, a) and insured_attains_age_100_on(c, b) and d >= a and d <= b; then deemed_maturity_date(c, d); }
rule DeemedMaturityDateNotEarlierThanAge95 strict { for c: InsuranceContract; for d: Date; for a: Date; when contract_stated_maturity_date(c, d) and insured_attains_age_95_on(c, a) and d < a; then deemed_maturity_date(c, a); }
rule DeemedMaturityDateNotLaterThanAge100 strict { for c: InsuranceContract; for d: Date; for b: Date; when contract_stated_maturity_date(c, d) and insured_attains_age_100_on(c, b) and d > b; then deemed_maturity_date(c, b); }
pub relation death_benefits_deemed_provided_until(c: InsuranceContract, d: Date) kind institutional { label en official "the death benefits are deemed to be provided until the maturity date determined under subparagraph (B)"; }
@source(IRC_S7702_E, coverage = exact, quote = "the death benefits shall be deemed to be provided until the maturity date determined by taking into account subparagraph (B)")
rule DeathBenefitsDeemedProvidedUntilDeemedMaturity strict { for c: InsuranceContract; for d: Date; when deemed_maturity_date(c, d); then death_benefits_deemed_provided_until(c, d); }
pub relation endowment_benefit_sum_at_maturity(c: InsuranceContract, amount: Money) kind empirical { label en official "the amount of any endowment benefit (or sum of endowment benefits, including any cash surrender value on the deemed maturity date)"; }
pub relation least_death_benefit_payable_at_any_time(c: InsuranceContract, amount: Money) kind empirical { label en official "the least amount payable as a death benefit at any time under the contract"; }
pub relation deemed_endowment_benefit(c: InsuranceContract, amount: Money) kind institutional { label en official "the endowment benefit deemed not to exceed the least death benefit payable at any time"; }
@source(IRC_S7702_E, coverage = exact, quote = "shall be deemed not to exceed the least amount payable as a death benefit at any time under the contract")
rule EndowmentBenefitCappedAtLeastDeathBenefit strict { for c: InsuranceContract; for e: Money; for l: Money; when endowment_benefit_sum_at_maturity(c, e) and least_death_benefit_payable_at_any_time(c, l); then deemed_endowment_benefit(c, min(e, l)); }
// (e)(2)(A): increase taken into account only to prevent a decrease in the excess.
pub relation contract_death_benefit_increase(c: InsuranceContract, amount: Money) kind empirical { label en official "an increase in the death benefit which is provided in the contract"; }
pub relation excess_decrease_prevented_by_increase(c: InsuranceContract, amount: Money) kind empirical { label en official "the decrease in the excess of the death benefit over the cash surrender value that the increase is necessary to prevent"; }
pub relation permitted_increase_for_guideline_level_premium(c: InsuranceContract, amount: Money) kind institutional { label en official "for computing the guideline level premium, the increase is taken into account only to the extent necessary to prevent a decrease in the excess of the death benefit over the cash surrender value"; }
@source(IRC_S7702_E, coverage = exact, quote = "an increase in the death benefit which is provided in the contract may be taken into account but only to the extent necessary to prevent a decrease in the excess of the death benefit over the cash surrender value of the contract")
rule IncreaseLimitedToPreventingDecreaseInExcess strict { for c: InsuranceContract; for i: Money; for x: Money; when contract_death_benefit_increase(c, i) and excess_decrease_prevented_by_increase(c, x); then permitted_increase_for_guideline_level_premium(c, min(i, x)); }
pub relation meets_cash_value_test_with_net_level_reserve(c: InsuranceContract) kind empirical { label en official "the contract will meet the cash value accumulation test at all times assuming that the net level reserve (level annual premiums over a period not ending before the insured attains age 95) is substituted for the net single premium"; }
pub relation increase_permitted_for_cash_value_accumulation_test_b(c: InsuranceContract) kind institutional { label en official "for the cash value accumulation test, the increase may be taken into account if the contract meets the test at all times with the net level reserve substituted for the net single premium"; }
@source(IRC_S7702_E, coverage = exact, quote = "the increase described in subparagraph (A) may be taken into account if the contract will meet such test at all times assuming that the net level reserve")
rule IncreasePermittedByNetLevelReserveTest strict { for c: InsuranceContract; when meets_cash_value_test_with_net_level_reserve(c); then increase_permitted_for_cash_value_accumulation_test_b(c); }
pub relation contract_maximum_death_benefit(c: InsuranceContract, amount: Money) kind empirical { label en official "the maximum death benefit under the contract"; }
pub relation fixed_predetermined_annual_increase(c: InsuranceContract, amount: Money, prior_year_death_benefit: Money) kind empirical { label en official "the fixed predetermined annual increase, with the death benefit at the end of the preceding year"; }
pub relation purchased_to_cover_burial_or_prearranged_funeral_expenses(c: InsuranceContract) kind empirical { label en official "the contract was purchased to cover payment of burial expenses or in connection with prearranged funeral expenses"; }
pub relation owner_aggregate_initial_death_benefit(c: InsuranceContract, total: Money) kind institutional {
    label en official "the initial death benefit of a contract, determined by treating all contracts issued to the same contract owner as 1 contract";
}
@source(IRC_S7702_E, coverage = exact, quote = "For purposes of subparagraph (C), the initial death benefit of a contract shall be determined by treating all contracts issued to the same contract owner as 1 contract.")
rule OwnerWideInitialDeathBenefit strict {
    for c: InsuranceContract;
    for h: Person;
    for a0: Money;
    when contract_policyholder(c, h) and contract_initial_death_benefit(c, a0);
    then owner_aggregate_initial_death_benefit(c, sum all a: Money for m: InsuranceContract where contract_policyholder(m, h) and contract_initial_death_benefit(m, a));
}
pub relation increases_permitted_for_burial_contract_c(c: InsuranceContract) kind institutional { label en official "for the cash value accumulation test, death benefit increases may be taken into account for a small burial contract: initial death benefit of $5,000 or less and maximum of $25,000 or less, a fixed annual increase not exceeding 10 percent of the initial or 8 percent of the preceding year's death benefit, purchased for burial or funeral expenses; the initial benefit treats all contracts of the same owner as one"; }
@source(IRC_S7702_E, coverage = exact, quote = "was purchased to cover payment of burial expenses or in connection with prearranged funeral expenses")
rule BurialContractIncreasesPermitted strict {
    for c: InsuranceContract; for initial: Money; for maximum: Money; for inc: Money; for prior: Money;
    when owner_aggregate_initial_death_benefit(c, initial) and initial <= 5000 USD and contract_maximum_death_benefit(c, maximum) and maximum <= 25000 USD
        and fixed_predetermined_annual_increase(c, inc, prior) and inc * 100 <= initial * 10 and purchased_to_cover_burial_or_prearranged_funeral_expenses(c);
    then increases_permitted_for_burial_contract_c(c);
}
rule BurialContractIncreasesPermittedByPriorYearPercent strict {
    for c: InsuranceContract; for initial: Money; for maximum: Money; for inc: Money; for prior: Money;
    when owner_aggregate_initial_death_benefit(c, initial) and initial <= 5000 USD and contract_maximum_death_benefit(c, maximum) and maximum <= 25000 USD
        and fixed_predetermined_annual_increase(c, inc, prior) and inc * 100 <= prior * 8 and purchased_to_cover_burial_or_prearranged_funeral_expenses(c);
    then increases_permitted_for_burial_contract_c(c);
}

// ============================================================================
// (f)(1)-(5) definitions
// ============================================================================

pub relation premiums_paid_gross(c: InsuranceContract, amount: Money) kind empirical { label en official "the premiums paid under the contract"; }
pub relation amounts_subject_to_section_72e_not_includible(c: InsuranceContract, amount: Money) kind empirical { label en official "amounts (other than amounts includible in gross income) to which section 72(e) applies"; }
pub relation excess_premiums_distributed_under_7B_or_7E(c: InsuranceContract, amount: Money) kind empirical { label en official "any excess premiums with respect to which there is a distribution described in paragraph (7)(B) or (E)"; }
pub relation other_amounts_received_specified_in_regulations(c: InsuranceContract, amount: Money) kind empirical { label en official "any other amounts received with respect to the contract which are specified in regulations"; }
pub relation premiums_returned_within_60_days_to_comply_with_a2A(c: InsuranceContract, amount: Money) kind empirical { label en official "any portion of a premium paid during a contract year returned (excluding interest) within 60 days after the end of the contract year to comply with subsection (a)(2)(A)"; }
pub relation premiums_paid_7702(c: InsuranceContract, amount: Money) kind institutional { label en official "the premiums paid under the contract less the section 72(e) amounts, the excess premiums distributed, other amounts specified in regulations, and premiums returned within 60 days"; }
@source(IRC_S7702_F, coverage = exact, quote = "The term \"premiums paid\" means the premiums paid under the contract less amounts (other than amounts includible in gross income) to which section 72(e) applies")
rule PremiumsPaidNetOfSubtractions strict {
    for c: InsuranceContract; for p: Money; for a72: Money; for ex: Money; for oth: Money; for ret: Money;
    when premiums_paid_gross(c, p) and amounts_subject_to_section_72e_not_includible(c, a72) and excess_premiums_distributed_under_7B_or_7E(c, ex) and other_amounts_received_specified_in_regulations(c, oth) and premiums_returned_within_60_days_to_comply_with_a2A(c, ret);
    then premiums_paid_7702(c, p - a72 - ex - oth - ret);
}
pub relation interest_returned_with_premium_7702(c: InsuranceContract, amount: Money) kind empirical { label en official "the amount of any interest returned with a premium returned under (1)(B)"; }
pub relation returned_interest_includible_7702f1c(c: InsuranceContract, amount: Money) kind institutional { label en official "notwithstanding section 72(e), the interest returned is includible in the gross income of the recipient"; }
@source(IRC_S7702_F, coverage = exact, quote = "Notwithstanding the provisions of section 72(e), the amount of any interest returned as provided in subparagraph (B) shall be includible in the gross income of the recipient.")
rule ReturnedInterestIncludibleUnder7702f strict { for c: InsuranceContract; for i: Money; for r: Money; when interest_returned_with_premium_7702(c, i) and premiums_returned_within_60_days_to_comply_with_a2A(c, r); then returned_interest_includible_7702f1c(c, i); }
pub relation cash_value_without_surrender_charge_loan_or_dividends(c: InsuranceContract, amount: Money) kind empirical { label en official "the contract's cash value determined without regard to any surrender charge, policy loan, or reasonable termination dividends"; }
pub relation cash_surrender_value_7702f2A(c: InsuranceContract, amount: Money) kind institutional { label en official "the cash surrender value: the cash value determined without regard to any surrender charge, policy loan, or reasonable termination dividends"; }
@source(IRC_S7702_F, coverage = exact, quote = "The cash surrender value of any contract shall be its cash value determined without regard to any surrender charge, policy loan, or reasonable termination dividends.")
rule CashSurrenderValueIsCashValueBeforeChargesAndLoans strict { for c: InsuranceContract; for v: Money; when cash_value_without_surrender_charge_loan_or_dividends(c, v); then cash_surrender_value_7702f2A(c, v); }
pub relation surrender_charge(c: InsuranceContract, amount: Money) kind empirical { label en official "the surrender charge of the contract"; }
pub relation net_surrender_value_7702f2B(c: InsuranceContract, amount: Money) kind institutional { label en official "the net surrender value: determined with regard to surrender charges but without regard to any policy loan"; }
@source(IRC_S7702_F, coverage = exact, quote = "The net surrender value of any contract shall be determined with regard to surrender charges but without regard to any policy loan.")
rule NetSurrenderValueIsCashValueLessSurrenderCharge strict { for c: InsuranceContract; for v: Money; for s: Money; when cash_value_without_surrender_charge_loan_or_dividends(c, v) and surrender_charge(c, s); then net_surrender_value_7702f2B(c, max(0 USD, v - s)); }
pub relation amount_payable_by_reason_of_death(c: InsuranceContract, amount: Money) kind empirical { label en official "the amount payable by reason of the death of the insured"; }
pub relation qualified_additional_benefit_death_component(c: InsuranceContract, amount: Money) kind empirical { label en official "the part of the amount payable by reason of death that is a qualified additional benefit"; }
pub relation death_benefit_7702f3(c: InsuranceContract, amount: Money) kind institutional { label en official "the death benefit: the amount payable by reason of the death of the insured, without regard to qualified additional benefits"; }
@source(IRC_S7702_F, coverage = exact, quote = "The term \"death benefit\" means the amount payable by reason of the death of the insured (determined without regard to any qualified additional benefits).")
rule DeathBenefitExcludesQualifiedAdditionalBenefits strict { for c: InsuranceContract; for d: Money; for q: Money; when amount_payable_by_reason_of_death(c, d) and qualified_additional_benefit_death_component(c, q); then death_benefit_7702f3(c, d - q); }
pub enum ContractBenefitKind { DeathBenefit; EndowmentBenefit; GuaranteedInsurability; AccidentalDeathOrDisabilityBenefit; FamilyTermCoverage; DisabilityWaiverBenefit; OtherBenefitPrescribedByRegulations; OtherAdditionalBenefit; label en official "the kinds of benefit under section 7702(f)(4)-(5)"; }
pub entity ContractBenefit { label en unofficial "a benefit under a life insurance contract"; }
pub relation benefit_of_contract(b: ContractBenefit, c: InsuranceContract) kind empirical;
pub relation benefit_kind(b: ContractBenefit, k: ContractBenefitKind) kind empirical;
pub relation future_benefit_of(b: ContractBenefit, c: InsuranceContract) kind institutional { label en official "future benefits: death benefits and endowment benefits"; }
@source(IRC_S7702_F, coverage = exact, quote = "The term \"future benefits\" means death benefits and endowment benefits.")
rule DeathBenefitIsFutureBenefit strict { for b: ContractBenefit; for c: InsuranceContract; when benefit_of_contract(b, c) and benefit_kind(b, DeathBenefit); then future_benefit_of(b, c); }
rule EndowmentBenefitIsFutureBenefit strict { for b: ContractBenefit; for c: InsuranceContract; when benefit_of_contract(b, c) and benefit_kind(b, EndowmentBenefit); then future_benefit_of(b, c); }
pub relation qualified_additional_benefit(b: ContractBenefit) kind institutional { label en official "a guaranteed insurability, accidental death or disability benefit, family term coverage, disability waiver benefit, or other benefit prescribed under regulations"; }
@source(IRC_S7702_F, coverage = exact, quote = "The term \"qualified additional benefits\" means any—")
rule GuaranteedInsurabilityIsQualifiedAdditionalBenefit strict { for b: ContractBenefit; when benefit_kind(b, GuaranteedInsurability); then qualified_additional_benefit(b); }
rule AccidentalDeathOrDisabilityBenefitIsQualified strict { for b: ContractBenefit; when benefit_kind(b, AccidentalDeathOrDisabilityBenefit); then qualified_additional_benefit(b); }
rule FamilyTermCoverageIsQualified strict { for b: ContractBenefit; when benefit_kind(b, FamilyTermCoverage); then qualified_additional_benefit(b); }
rule DisabilityWaiverBenefitIsQualified strict { for b: ContractBenefit; when benefit_kind(b, DisabilityWaiverBenefit); then qualified_additional_benefit(b); }
rule RegulationBenefitIsQualified strict { for b: ContractBenefit; when benefit_kind(b, OtherBenefitPrescribedByRegulations); then qualified_additional_benefit(b); }
pub relation charge_for_benefit_treated_as_future_benefit(b: ContractBenefit) kind institutional { label en official "qualified additional benefits are not future benefits, but the charges for them are treated as future benefits"; }
@source(IRC_S7702_F, coverage = exact, quote = "qualified additional benefits shall not be treated as future benefits under the contract, but the charges for such benefits shall be treated as future benefits")
rule ChargeForQualifiedAdditionalBenefitIsFutureBenefit strict { for b: ContractBenefit; when qualified_additional_benefit(b); then charge_for_benefit_treated_as_future_benefit(b); }
pub relation other_additional_benefit_not_future_benefit(b: ContractBenefit) kind institutional { label en official "an additional benefit which is not a qualified additional benefit is not treated as a future benefit"; }
@source(IRC_S7702_F, coverage = exact, quote = "such benefit shall not be treated as a future benefit")
rule OtherAdditionalBenefitIsNotFutureBenefit strict { for b: ContractBenefit; when benefit_kind(b, OtherAdditionalBenefit) and not_known(qualified_additional_benefit(b)); then other_additional_benefit_not_future_benefit(b); }
pub relation charge_for_benefit_prefunded(b: ContractBenefit) kind empirical { label en official "the charge for the additional benefit is prefunded"; }
pub relation charge_for_other_benefit_treated_as_premium(b: ContractBenefit) kind institutional { label en official "any charge for a non-qualified additional benefit which is not prefunded is not treated as a premium"; }
rule PrefundedChargeForOtherBenefitCountsAsPremium strict { for b: ContractBenefit; when benefit_kind(b, OtherAdditionalBenefit) and charge_for_benefit_prefunded(b); then charge_for_other_benefit_treated_as_premium(b); }

// ============================================================================
// (f)(6) premium payments not disqualifying the contract
// ============================================================================

pub relation premium_payment_amount(c: InsuranceContract, premium: Money) kind empirical { label en official "a premium payment"; }
pub relation premium_needed_to_prevent_termination_through_contract_year_end(c: InsuranceContract, amount: Money) kind empirical { label en official "the amount necessary to prevent the termination of the contract on or before the end of the contract year"; }
pub relation contract_has_no_cash_surrender_value_at_end_of_extension(c: InsuranceContract) kind empirical { label en official "the contract will have no cash surrender value at the end of such extension period"; }
pub relation premium_payment_over_guideline_limit(c: InsuranceContract, premium: Money) kind empirical { label en official "the premium would result in the sum of premiums paid exceeding the guideline premium limitation"; }
pub relation premium_payment_disregarded_for_a2(c: InsuranceContract, premium: Money) kind institutional { label en official "the payment of a premium exceeding the guideline premium limitation is disregarded for subsection (a)(2) if it does not exceed the amount necessary to prevent termination and the contract will have no cash surrender value at the end of the extension period"; }
@source(IRC_S7702_F, coverage = exact, quote = "The payment of a premium which would result in the sum of the premiums paid exceeding the guideline premium limitation shall be disregarded for purposes of subsection (a)(2)")
rule PremiumPaymentDisregardedWhenNeededToPreventTermination strict {
    for c: InsuranceContract; for p: Money; for need: Money;
    when premium_payment_over_guideline_limit(c, p) and premium_needed_to_prevent_termination_through_contract_year_end(c, need) and p <= need and contract_has_no_cash_surrender_value_at_end_of_extension(c);
    then premium_payment_disregarded_for_a2(c, p);
}

// ============================================================================
// (f)(7) adjustments: recapture ceilings
// ============================================================================

pub relation contract_issue_date_7702(c: InsuranceContract, d: Date) kind empirical { label en official "the issue date of the contract"; }
pub relation benefit_reducing_change_on(c: InsuranceContract, d: Date) kind empirical { label en official "a change in the benefits under (or in other terms of) the contract which reduces benefits"; }
pub relation cash_distribution_from_change(c: InsuranceContract, d: Date, amount: Money) kind empirical { label en official "a cash distribution to the policyholder as a result of the change"; }
pub relation contract_meets_a1_cash_value_test(c: InsuranceContract) kind empirical { label en official "the contract is one to which subsection (a)(1) (cash value accumulation test) applies"; }
pub relation csv_immediately_before_reduction(c: InsuranceContract, amount: Money) kind empirical { label en official "the cash surrender value of the contract immediately before the reduction"; }
pub relation net_single_premium_immediately_after_reduction(c: InsuranceContract, amount: Money) kind empirical { label en official "the net single premium (determined under subsection (b)) immediately after the reduction"; }
pub relation aggregate_premiums_paid_immediately_before_reduction(c: InsuranceContract, amount: Money) kind empirical { label en official "the aggregate premiums paid under the contract immediately before the reduction"; }
pub relation guideline_premium_limitation_with_adjustment(c: InsuranceContract, amount: Money) kind empirical { label en official "the guideline premium limitation for the contract (determined under subsection (c)(2), taking into account the adjustment described in subparagraph (A))"; }
pub relation cash_value_corridor_immediately_after_reduction(c: InsuranceContract, amount: Money) kind empirical { label en official "the cash value corridor of subsection (d), determined immediately after the reduction (whether or not subsection (d) applies to the contract)"; }
pub relation change_within_first_15_years(c: InsuranceContract, d: Date) kind institutional { label en official "the change occurs during the 15-year period beginning on the issue date"; }
rule ChangeWithinFirstFifteenYears strict { for c: InsuranceContract; for d: Date; for issue: Date; when benefit_reducing_change_on(c, d) and contract_issue_date_7702(c, issue) and d >= issue and d < add_calendar_period(issue, 180 calendar_month); then change_within_first_15_years(c, d); }
pub relation change_within_first_5_years(c: InsuranceContract, d: Date) kind institutional { label en official "the change occurs during the 5-year period beginning on the issue date"; }
rule ChangeWithinFirstFiveYears strict { for c: InsuranceContract; for d: Date; for issue: Date; when benefit_reducing_change_on(c, d) and contract_issue_date_7702(c, issue) and d >= issue and d < add_calendar_period(issue, 60 calendar_month); then change_within_first_5_years(c, d); }
pub relation recapture_ceiling(c: InsuranceContract, d: Date, amount: Money) kind institutional { label en official "the recapture ceiling for a benefit reduction: (C) in the first 5 years, (D) after the 5th and before the 16th year"; }
@source(IRC_S7702_F, coverage = exact, quote = "in the case of a contract to which subsection (a)(1) applies, the excess of—")
rule RecaptureCeilingFirstFiveYearsCashValueContract strict {
    for c: InsuranceContract; for d: Date; for csv: Money; for nsp: Money;
    when change_within_first_5_years(c, d) and contract_meets_a1_cash_value_test(c) and csv_immediately_before_reduction(c, csv) and net_single_premium_immediately_after_reduction(c, nsp);
    then recapture_ceiling(c, d, max(0 USD, csv - nsp));
}
@source(IRC_S7702_F, coverage = exact, quote = "the greater of—")
rule RecaptureCeilingFirstFiveYearsGuidelineContract strict {
    for c: InsuranceContract; for d: Date; for paid: Money; for gpl: Money; for csv: Money; for corridor: Money;
    when change_within_first_5_years(c, d) and not_known(contract_meets_a1_cash_value_test(c)) and aggregate_premiums_paid_immediately_before_reduction(c, paid) and guideline_premium_limitation_with_adjustment(c, gpl)
        and csv_immediately_before_reduction(c, csv) and cash_value_corridor_immediately_after_reduction(c, corridor);
    then recapture_ceiling(c, d, max(0 USD, max(paid - gpl, csv - corridor)));
}
@source(IRC_S7702_F, coverage = exact, quote = "the recapture ceiling is the excess of the cash surrender value of the contract, immediately before the reduction, over the cash value corridor of subsection (d)")
rule RecaptureCeilingAfterFifthYear strict {
    for c: InsuranceContract; for d: Date; for issue: Date; for csv: Money; for corridor: Money;
    when change_within_first_15_years(c, d) and not_known(change_within_first_5_years(c, d)) and csv_immediately_before_reduction(c, csv) and cash_value_corridor_immediately_after_reduction(c, corridor);
    then recapture_ceiling(c, d, max(0 USD, csv - corridor));
}
pub relation cash_distribution_subject_to_section_72(c: InsuranceContract, d: Date, amount: Money) kind institutional { label en official "section 72 (other than subsection (e)(5)) applies to the cash distribution to the extent it does not exceed the recapture ceiling"; }
@source(IRC_S7702_F, coverage = exact, quote = "section 72 (other than subsection (e)(5) thereof) shall apply to such cash distribution to the extent it does not exceed the recapture ceiling")
rule CashDistributionSubjectToSection72UpToCeiling strict {
    for c: InsuranceContract; for d: Date; for dist: Money; for ceiling: Money;
    when cash_distribution_from_change(c, d, dist) and recapture_ceiling(c, d, ceiling);
    then cash_distribution_subject_to_section_72(c, d, min(dist, ceiling));
}
pub relation cash_distribution_reducing_csv_on(c: InsuranceContract, d: Date) kind empirical { label en official "a distribution which reduces the cash surrender value of the contract, made on the date"; }
pub relation distribution_treated_as_in_anticipation_of_reduction(c: InsuranceContract, dist_date: Date) kind institutional { label en official "a distribution reducing the cash surrender value made within 2 years before a reduction in benefits is treated as made in anticipation of it"; }
@source(IRC_S7702_F, coverage = exact, quote = "any distribution which reduces the cash surrender value of a contract and which is made within 2 years before a reduction in benefits under the contract shall be treated as made in anticipation of such reduction")
rule DistributionWithinTwoYearsBeforeReductionIsInAnticipation strict {
    for c: InsuranceContract; for dd: Date; for rd: Date;
    for calendar_before_1: Date;
    when cash_distribution_reducing_csv_on(c, dd) and benefit_reducing_change_on(c, rd) and dd <= rd and dd >= calendar_before_1
        and us.irc.core::civil_calendar_boundary_before(rd, 24, us.irc.core::CalendarMonth, calendar_before_1);
    then distribution_treated_as_in_anticipation_of_reduction(c, dd);
}

// ============================================================================
// (f)(8) correction of errors; (f)(9) variable contracts
// ============================================================================

pub external judgment relation taxpayer_establishes_reasonable_error_and_steps_to_remedy(c: InsuranceContract) {
    authority Secretary;
    label en official "the taxpayer establishes to the satisfaction of the Secretary that (A) the requirements of subsection (a) for a contract year were not satisfied due to reasonable error, and (B) reasonable steps are being taken to remedy the error";
}
pub relation secretary_waives_failure_of_7702a_requirements(c: InsuranceContract, y: Integer) kind empirical { label en official "the Secretary waives the failure to satisfy the requirements described in subsection (a)"; }
pub relation failure_to_satisfy_a_waived(c: InsuranceContract, y: Integer) kind institutional { label en official "the failure to satisfy the requirements of subsection (a) for the contract year is waived"; }
@source(IRC_S7702_F, coverage = exact, quote = "the Secretary may waive the failure to satisfy such requirements")
rule SecretaryMayWaiveFailureForReasonableError strict {
    label en official "on the taxpayer's showing of reasonable error and reasonable steps to remedy it, the Secretary may waive the failure (section 7702(f)(8))";
    for c: InsuranceContract; for y: Integer;
    when secretary_waives_failure_of_7702a_requirements(c, y);
    then power S7702f8WaiverPower {
        holder Secretary;
        over c;
        exercise secretary_waives_failure_of_7702a_requirements(c, y);
        valid_when taxpayer_establishes_reasonable_error_and_steps_to_remedy(c);
        effect create(failure_to_satisfy_a_waived(c, y));
        window [@1984-01-01, infinity);
    };
}
pub relation contract_is_variable_contract_section_817(c: InsuranceContract) kind empirical { label en official "the contract is a variable contract (as defined in section 817)"; }
pub relation death_benefit_changes_on(c: InsuranceContract, d: Date) kind empirical { label en official "the death benefits under the contract change on the date"; }
pub relation determination_required_on(c: InsuranceContract, d: Date) kind institutional { label en official "for a variable contract, the determination of whether it meets subsection (a) is made whenever the death benefits change"; }
@source(IRC_S7702_F, coverage = exact, quote = "the determination of whether such contract meets the requirements of subsection (a) shall be made whenever the death benefits under such contract change")
rule DeterminationRequiredWhenDeathBenefitChanges strict { for c: InsuranceContract; for d: Date; when contract_is_variable_contract_section_817(c) and death_benefit_changes_on(c, d); then determination_required_on(c, d); }
pub relation variable_contract_determination_made_on(c: InsuranceContract, d: Date) kind empirical { label en official "a determination of whether the contract meets subsection (a) is made on the date"; }
pub relation determination_due_within_12_months_of(c: InsuranceContract, d: Date, due: Date) kind institutional { label en official "a determination must be made not less frequently than once during each 12-month period: the next one is due within 12 months of the last"; }
@source(IRC_S7702_F, coverage = exact, quote = "but not less frequently than once during each 12-month period")
rule NextDeterminationDueWithin12Months strict { for c: InsuranceContract; for d: Date; when contract_is_variable_contract_section_817(c) and variable_contract_determination_made_on(c, d); then determination_due_within_12_months_of(c, d, add_calendar_period(d, 12 calendar_month)); }

// ============================================================================
// (f)(10) prevailing commissioners' standard tables; (f)(11) insurance interest rate
// ============================================================================

pub relation commissioners_tables_change_year_begins_on(d: Date) kind empirical { label en official "the first day of a year of change: the prevailing commissioners' standard tables as of the beginning of the year differ from those of the preceding year"; }
pub relation contract_issued_on_7702(c: InsuranceContract, d: Date) kind empirical { label en official "the date the contract was issued"; }
pub relation may_use_prior_year_prevailing_tables(c: InsuranceContract) kind institutional { label en official "the issuer may use the prevailing commissioners' standard tables as of the beginning of the preceding calendar year for a contract issued after the change and before the close of the 3-year period beginning on the first day of the year of change"; }
@source(IRC_S7702_F, coverage = exact, quote = "the issuer may use the prevailing commissioners' standard tables as of the beginning of the preceding calendar year with respect to any contract issued after the change and before the close of the 3-year period beginning on the first day of the year of change")
rule PriorYearTablesUsableForThreeYearsAfterChange strict {
    for c: InsuranceContract; for issued: Date; for change: Date;
    when contract_issued_on_7702(c, issued) and commissioners_tables_change_year_begins_on(change) and issued >= change and issued < add_calendar_period(change, 36 calendar_month);
    then may_use_prior_year_prevailing_tables(c);
}
pub relation section_7702_valuation_interest_rate_percent(y: Integer, pct: Decimal) kind empirical { label en official "the section 7702 valuation interest rate for the calendar year (or the most recent adjustment year): the prescribed U.S. valuation interest rate for life insurance with guaranteed durations of more than 20 years as effective in the preceding calendar year"; }
pub relation average_of_mid_term_rates_percent(y: Integer, pct: Decimal) kind empirical { label en official "the average of the applicable Federal mid-term rates (annual compounding) effective at the beginning of each calendar month in the most recent 60-month period ending before the second calendar year prior to the adjustment year, before rounding"; }
pub relation section_7702_applicable_federal_interest_rate_percent(y: Integer, pct: Decimal) kind institutional { label en official "the average of the mid-term rates, rounded to the nearest whole percentage point"; }
@source(IRC_S7702_F, coverage = exact, quote = "the average (rounded to the nearest whole percentage point) of the applicable Federal mid-term rates")
rule ApplicableFederalInterestRateRoundedToWholePoint strict { for y: Integer; for a: Decimal; when average_of_mid_term_rates_percent(y, a); then section_7702_applicable_federal_interest_rate_percent(y, round(a, 0, "HALF_UP")); }
pub relation contract_issued_in_calendar_year_7702(c: InsuranceContract, y: Integer) kind empirical { label en official "the contract is issued in the calendar year"; }
pub relation issued_in_transition_period_2021(c: InsuranceContract) kind empirical { label en official "the contract is issued during the period that begins on January 1, 2021 and ends immediately before the beginning of the first adjustment year that begins after December 31, 2021"; }
pub relation insurance_interest_rate_percent(c: InsuranceContract, pct: Decimal) kind institutional { label en official "the insurance interest rate: the lesser of the valuation interest rate and the applicable Federal interest rate for the year of issue; 2 percent in the 2021 transition period"; }
@source(IRC_S7702_F, coverage = exact, quote = "the insurance interest rate shall be 2 percent in the case of any contract which is issued during the period that—")
rule InsuranceInterestRateTransitionTwoPercent strict { for c: InsuranceContract; when issued_in_transition_period_2021(c); then insurance_interest_rate_percent(c, 2.0); }
@source(IRC_S7702_F, coverage = exact, quote = "The term \"insurance interest rate\" means, with respect to any contract issued in any calendar year, the lesser of—")
rule InsuranceInterestRateIsLesserOfTwoRates strict {
    for c: InsuranceContract; for y: Integer; for v: Decimal; for a: Decimal;
    when contract_issued_in_calendar_year_7702(c, y) and section_7702_valuation_interest_rate_percent(y, v) and section_7702_applicable_federal_interest_rate_percent(y, a) and not_known(issued_in_transition_period_2021(c));
    then insurance_interest_rate_percent(c, min(v, a));
}
