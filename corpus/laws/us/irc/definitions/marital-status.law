// §7703 — determination of marital status, both subsections in full.
// Anchors: `IRC_S7703_A`, `IRC_S7703_B` (each its own fragment — §7703 DOES
// have top-level lettered subsections in the model's structural extraction,
// unlike §7701).

language "law.core" version "0.2";
package us.irc.definitions version "0.1.1";
namespace "urn:us:irc:definitions:clir";

use self::{
    IRC_S7703_A,
    IRC_S7703_B,
    Individual,
    TaxableYear,
};

// --- (a) General rule ------------------------------------------------------
pub relation married_as_of_close_of_taxable_year(p: Individual, y: TaxableYear) kind empirical {
    label en official "the determination of whether an individual is married shall be made as of the close of his taxable year";
}
pub relation spouse_died_during_taxable_year(p: Individual, y: TaxableYear) kind empirical {
    label en official "if his spouse dies during his taxable year such determination shall be made as of the time of such death";
}
pub relation married_at_time_of_spouses_death(p: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the individual was married at the time of the spouse's death (the (a)(1) determination date when the spouse dies during the year)";
}
pub relation legally_separated_under_decree_of_divorce_or_separate_maintenance(p: Individual, y: TaxableYear) kind empirical {
    label en official "an individual legally separated from his spouse under a decree of divorce or of separate maintenance shall not be considered as married";
}
pub relation married_for_this_title(p: Individual, y: TaxableYear) kind institutional {
    label en official "the determination of whether an individual is married shall be made as of the close of his taxable year; except that if his spouse dies during his taxable year such determination shall be made as of the time of such death; and an individual legally separated from his spouse under a decree of divorce or of separate maintenance shall not be considered as married";
}

@source(IRC_S7703_A, relation = formalizes, coverage = partial, quote = "the determination of whether an individual is married shall be made as of the close of his taxable year; except that if his spouse dies during his taxable year such determination shall be made as of the time of such death")
rule MarriedAtCloseOfYearIsMarried strict {
    for p: Individual; for y: TaxableYear;
    when married_as_of_close_of_taxable_year(p, y) and not_known(spouse_died_during_taxable_year(p, y))
        and not_known(legally_separated_under_decree_of_divorce_or_separate_maintenance(p, y));
    then married_for_this_title(p, y);
}
@source(IRC_S7703_A, relation = formalizes, coverage = partial, quote = "except that if his spouse dies during his taxable year such determination shall be made as of the time of such death")
rule MarriedAtSpouseDeathIsMarried strict {
    for p: Individual; for y: TaxableYear;
    when spouse_died_during_taxable_year(p, y) and married_at_time_of_spouses_death(p, y)
        and not_known(legally_separated_under_decree_of_divorce_or_separate_maintenance(p, y));
    then married_for_this_title(p, y);
}
pub relation not_married_for_this_title(p: Individual, y: TaxableYear) kind institutional {
    label en unofficial "the negative of `married_for_this_title` — kept as its own conclusion so a legal separation is a POSITIVE finding, not merely the absence of one";
}
@source(IRC_S7703_A, relation = formalizes, coverage = partial, quote = "an individual legally separated from his spouse under a decree of divorce or of separate maintenance shall not be considered as married")
rule LegallySeparatedIsNotMarried strict {
    for p: Individual; for y: TaxableYear;
    when legally_separated_under_decree_of_divorce_or_separate_maintenance(p, y);
    then not_married_for_this_title(p, y);
}

// --- (b) Certain married individuals living apart ("considered unmarried") -
pub relation married_within_meaning_of_subsection_a(p: Individual, y: TaxableYear) kind empirical {
    label en unofficial "married within the meaning of subsection (a) (for (b), the case asserts this directly rather than re-deriving it, since (b) applies notwithstanding a separate-return filing choice that (a) alone does not determine)";
}
pub relation files_separate_return(p: Individual, y: TaxableYear) kind empirical {
    label en official "who files a separate return";
}
pub entity QualifyingChild { label en unofficial "a child within the meaning of section 152(f)(1), for the (b) household test"; }
pub relation household_is_principal_place_of_abode_of_child_more_than_half_year(p: Individual, y: TaxableYear, c: QualifyingChild) kind empirical {
    label en official "maintains as his home a household which constitutes for more than one-half of the taxable year the principal place of abode of a child (within the meaning of section 152(f)(1))";
}
pub relation entitled_to_151_deduction_for_child_or_would_be_but_for_152e(p: Individual, y: TaxableYear, c: QualifyingChild) kind empirical {
    label en official "a child with respect to whom such individual is entitled to a deduction for the taxable year under section 151 (or would be so entitled but for section 152(e))";
}
pub relation furnishes_over_half_cost_of_maintaining_household(p: Individual, y: TaxableYear) kind empirical {
    label en official "such individual furnishes over one-half of the cost of maintaining such household during the taxable year";
}
pub relation spouse_not_member_of_household_during_last_six_months(p: Individual, y: TaxableYear) kind empirical {
    label en official "during the last 6 months of the taxable year, such individual's spouse is not a member of such household";
}
pub relation considered_unmarried_under_living_apart_rule(p: Individual, y: TaxableYear) kind institutional {
    label en official "such individual shall not be considered as married";
}
@source(IRC_S7703_B, relation = formalizes, coverage = partial, quote = "an individual who is married (within the meaning of subsection (a)) and who files a separate return maintains as his home a household which constitutes for more than one-half of the taxable year the principal place of abode of a child (within the meaning of section 152(f)(1)) with respect to whom such individual is entitled to a deduction for the taxable year under section 151 (or would be so entitled but for section 152(e)),")
rule LivingApartWithDependentChildConsideredUnmarried strict {
    for p: Individual; for y: TaxableYear; for c: QualifyingChild;
    when married_within_meaning_of_subsection_a(p, y) and files_separate_return(p, y)
        and household_is_principal_place_of_abode_of_child_more_than_half_year(p, y, c)
        and entitled_to_151_deduction_for_child_or_would_be_but_for_152e(p, y, c)
        and furnishes_over_half_cost_of_maintaining_household(p, y)
        and spouse_not_member_of_household_during_last_six_months(p, y);
    then considered_unmarried_under_living_apart_rule(p, y);
}
