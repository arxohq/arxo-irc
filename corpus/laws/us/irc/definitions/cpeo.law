// §7705 — certified professional employer organization: definition,
// certification requirements as institutional facts/duties, bond and
// independent financial review, suspension/revocation as a power of the
// Secretary. "Shall" clauses addressed to the Secretary are modeled as the
// Secretary's own duties where the text imposes an obligation to certify
// under stated conditions, and the certification/suspension/revocation
// determinations themselves as powers (their VALIDITY turns on stated
// conditions; an invalid attempt has no effect, E-0239).
//
// Anchors: `IRC_S7705_A` through `IRC_S7705_H` (the (h) subsection —
// coordination with worker classification, per the model's structural
// extraction — is out of this stage's list of named subsections and is left
// `unreviewed`/stage 2, per `coverage/definitions.json`).

language "law.core" version "0.2";
package us.irc.definitions version "0.1.1";
namespace "urn:us:irc:definitions:clir";

use self::{
    IRC_S7705_A,
    IRC_S7705_B,
    IRC_S7705_C,
    IRC_S7705_D,
    Secretary,
};

pub entity ProfessionalEmployerOrganization : Person {
    label en unofficial "a person who applies to be treated as a certified professional employer organization";
}

// --- (b) Certification requirements -----------------------------------------
pub relation demonstrates_secretary_prescribed_requirements(o: ProfessionalEmployerOrganization) kind empirical {
    label en official "demonstrates that such person (and any owner, officer, and other persons as may be specified in regulations) meets such requirements as the Secretary shall establish, including requirements with respect to tax status, background, experience, business location, and annual financial audits";
}
pub relation agrees_to_ongoing_bond_and_review_requirements(o: ProfessionalEmployerOrganization) kind empirical {
    label en official "agrees that it will satisfy the bond and independent financial review requirements of subsection (c) on an ongoing basis";
}
pub relation agrees_to_secretary_reporting_obligations(o: ProfessionalEmployerOrganization) kind empirical {
    label en official "agrees that it will satisfy such reporting obligations as may be imposed by the Secretary";
}
pub relation computes_taxable_income_on_accrual_method_or_approved_alternative(o: ProfessionalEmployerOrganization) kind empirical {
    label en official "computes its taxable income using an accrual method of accounting unless the Secretary approves another method";
}
pub relation agrees_to_periodic_verification_of_continued_compliance(o: ProfessionalEmployerOrganization) kind empirical {
    label en official "agrees to verify on such periodic basis as the Secretary may prescribe that it continues to meet the requirements of this subsection";
}
pub relation agrees_to_notify_secretary_of_material_changes(o: ProfessionalEmployerOrganization) kind empirical {
    label en official "agrees to notify the Secretary in writing within such time as the Secretary may prescribe of any change that materially affects the continuing accuracy of any agreement or information that was previously made or provided under this subsection";
}
pub relation meets_certification_requirements(o: ProfessionalEmployerOrganization) kind institutional {
    label en official "a person meets the requirements of this subsection if such person (1)-(6) [demonstrates Secretary-established requirements; agrees to bond/review; agrees to reporting; computes income on accrual method; agrees to periodic verification; agrees to notify of material changes]";
}
@source(IRC_S7705_B, relation = formalizes, coverage = partial, quote = "A person meets the requirements of this subsection if such person—")
rule AllSixConditionsMeetCertificationRequirements strict {
    for o: ProfessionalEmployerOrganization;
    when demonstrates_secretary_prescribed_requirements(o)
        and agrees_to_ongoing_bond_and_review_requirements(o)
        and agrees_to_secretary_reporting_obligations(o)
        and computes_taxable_income_on_accrual_method_or_approved_alternative(o)
        and agrees_to_periodic_verification_of_continued_compliance(o)
        and agrees_to_notify_secretary_of_material_changes(o);
    then meets_certification_requirements(o);
}

// --- (c) Bond and independent financial review ------------------------------
pub relation posted_bond_amount(o: ProfessionalEmployerOrganization, on: Date, amount: Money) kind empirical {
    label en official "the organization has posted a bond for the payment of taxes under subtitle C (in a form acceptable to the Secretary)";
}
pub relation prior_calendar_year_section_3511_liability(o: ProfessionalEmployerOrganization, amount: Money) kind empirical {
    label en official "the organization's liability under section 3511 for taxes imposed by subtitle C during the preceding calendar year";
}
// Required bond = greater of (5% of prior-year §3511 liability, capped at
// $1,000,000) or $50,000. The two dollar figures are the statute's own
// literal numbers (not an indexed or rate-table amount), so no
// `.lawparam.json` A3 sidecar is used for them (they never change without a
// further Act of Congress amending this subsection).
pub relation required_bond_amount(o: ProfessionalEmployerOrganization, amount: Money) kind institutional {
    label en official "the amount of the bond required is equal to the greater of— (i) 5 percent of the organization's liability under section 3511 for taxes imposed by subtitle C during the preceding calendar year (but not to exceed $1,000,000), or (ii) $50,000";
}
// Three branches on the plain 5%-of-liability figure (`0.05 * liability`,
// `Decimal * Money` — a named multiplicative pair) against the $1,000,000
// cap and the $50,000 floor, instead of a `min`/`max` helper over `Money`
// (not a pair this package invents beyond the named ones above).
@source(IRC_S7705_C, relation = formalizes, coverage = partial, quote = "For the period April 1 of any calendar year through March 31 of the following calendar year, the amount of the bond required is equal to the greater of—")
rule RequiredBondIsFivePercentWhenBetweenFloorAndCap strict {
    for o: ProfessionalEmployerOrganization; for liability: Money;
    when prior_calendar_year_section_3511_liability(o, liability)
        and 0.05 * liability >= 50000 USD and 0.05 * liability <= 1000000 USD;
    then required_bond_amount(o, 0.05 * liability);
}
@source(IRC_S7705_C, relation = formalizes, coverage = partial, quote = "For the period April 1 of any calendar year through March 31 of the following calendar year, the amount of the bond required is equal to the greater of—")
rule RequiredBondCappedAtOneMillion strict {
    for o: ProfessionalEmployerOrganization; for liability: Money;
    when prior_calendar_year_section_3511_liability(o, liability) and 0.05 * liability > 1000000 USD;
    then required_bond_amount(o, 1000000 USD);
}
@source(IRC_S7705_C, relation = formalizes, coverage = partial, quote = "For the period April 1 of any calendar year through March 31 of the following calendar year, the amount of the bond required is equal to the greater of—")
rule RequiredBondFlooredAtFiftyThousand strict {
    for o: ProfessionalEmployerOrganization; for liability: Money;
    when prior_calendar_year_section_3511_liability(o, liability) and 0.05 * liability < 50000 USD;
    then required_bond_amount(o, 50000 USD);
}
pub relation meets_bond_requirement(o: ProfessionalEmployerOrganization, on: Date) kind institutional {
    label en official "a certified professional employer organization meets the requirements of this paragraph if the organization has posted a bond … that is in an amount at least equal to the amount specified in subparagraph (B)";
}
@source(IRC_S7705_C, relation = formalizes, coverage = partial, quote = "A certified professional employer organization meets the requirements of this paragraph if the organization has posted a bond for the payment of taxes under subtitle C (in a form acceptable to the Secretary) that is in an amount at least equal to the amount specified in subparagraph (B).")
rule PostedBondAtLeastRequiredAmountMeetsBondRequirement strict {
    for o: ProfessionalEmployerOrganization; for on: Date; for posted: Money; for required: Money;
    when posted_bond_amount(o, on, posted) and required_bond_amount(o, required) and posted >= required;
    then meets_bond_requirement(o, on);
}

pub relation provided_accountant_opinion_on_financial_statements(o: ProfessionalEmployerOrganization) kind empirical {
    label en official "has, as of the most recent audit date, caused to be prepared and provided to the Secretary … an opinion of an independent certified public accountant as to whether the certified professional employer organization's financial statements are presented fairly in accordance with generally accepted accounting principles";
}
pub relation provided_quarterly_employment_tax_assertion_and_attestation(o: ProfessionalEmployerOrganization, quarter_end: Date) kind empirical {
    label en official "provides to the Secretary an assertion regarding Federal employment tax payments and an examination level attestation on such assertion from an independent certified public accountant not later than the last day of the second month beginning after the end of each calendar quarter";
}
pub relation meets_independent_financial_review_requirement(o: ProfessionalEmployerOrganization, quarter_end: Date) kind institutional {
    label en official "a certified professional employer organization meets the requirements of this paragraph if such organization has caused to be prepared and provided … an opinion of an independent certified public accountant … and provides … an assertion regarding Federal employment tax payments and an examination level attestation";
}
@source(IRC_S7705_C, relation = formalizes, coverage = partial, quote = "A certified professional employer organization meets the requirements of this paragraph if such organization—")
rule OpinionAndQuarterlyAttestationMeetIndependentReviewRequirement strict {
    for o: ProfessionalEmployerOrganization; for quarter_end: Date;
    when provided_accountant_opinion_on_financial_statements(o)
        and provided_quarterly_employment_tax_assertion_and_attestation(o, quarter_end);
    then meets_independent_financial_review_requirement(o, quarter_end);
}
pub relation meets_bond_and_review_requirements(o: ProfessionalEmployerOrganization, on: Date) kind institutional {
    label en official "an organization meets the requirements of this paragraph if such organization (A) meets the bond requirements of paragraph (2), and (B) meets the independent financial review requirements of paragraph (3)";
}
@source(IRC_S7705_C, relation = formalizes, coverage = partial, quote = "An organization meets the requirements of this paragraph if such organization—")
rule BondAndReviewBothMetGivesBondAndReviewRequirements strict {
    for o: ProfessionalEmployerOrganization; for on: Date;
    when meets_bond_requirement(o, on) and meets_independent_financial_review_requirement(o, on);
    then meets_bond_and_review_requirements(o, on);
}

// --- (a) The definition itself; certification as a power of the Secretary ---
pub relation applies_for_cpeo_certification(o: ProfessionalEmployerOrganization) kind empirical {
    label en official "a person who applies to be treated as a certified professional employer organization for purposes of section 3511";
}
pub relation secretary_certifies(o: ProfessionalEmployerOrganization) kind empirical {
    label en unofficial "the Secretary's act of certifying the applicant (the exercise of the (a) certification power)";
}
pub relation certified_professional_employer_organization(o: ProfessionalEmployerOrganization) kind institutional {
    label en official "the term \"certified professional employer organization\" means a person who applies to be treated as a certified professional employer organization for purposes of section 3511 and has been certified by the Secretary as meeting the requirements of subsection (b)";
}
@source(IRC_S7705_A, relation = formalizes, coverage = partial, quote = "For purposes of this title, the term \"certified professional employer organization\" means a person who applies to be treated as a certified professional employer organization for purposes of section 3511 and has been certified by the Secretary as meeting the requirements of subsection (b).")
rule CertificationValidWhenApplicantMeetsRequirements strict {
    label en unofficial "§7705(a). The Secretary's certification of an applicant meeting the (b) requirements makes the applicant a certified professional employer organization";
    for o: ProfessionalEmployerOrganization;
    when applies_for_cpeo_certification(o);
    then power CertifyProfessionalEmployerOrganization {
        holder Secretary; over o;
        exercise secretary_certifies(o);
        valid_when meets_certification_requirements(o);
        effect create(certified_professional_employer_organization(o));
        window [@1986-01-01, infinity);
    };
}

// --- (d) Suspension and revocation authority --------------------------------
pub relation not_satisfying_b_or_c_agreements_or_requirements(o: ProfessionalEmployerOrganization) kind empirical {
    label en official "such person is not satisfying the agreements or requirements of subsections (b) or (c)";
}
pub relation fails_applicable_accounting_reporting_payment_or_deposit_requirements(o: ProfessionalEmployerOrganization) kind empirical {
    label en official "fails to satisfy applicable accounting, reporting, payment, or deposit requirements";
}
pub relation secretary_suspends_or_revokes_certification(o: ProfessionalEmployerOrganization) kind empirical {
    label en unofficial "the Secretary's act of suspending or revoking the certification (the exercise of the (d) power)";
}
pub relation certification_suspended_or_revoked(o: ProfessionalEmployerOrganization) kind institutional {
    label en official "the Secretary may suspend or revoke a certification of any person under subsection (b) for purposes of section 3511";
}
pub relation grounds_for_suspension_or_revocation_exist(o: ProfessionalEmployerOrganization) kind institutional {
    label en unofficial "the Secretary determines that such person is not satisfying the agreements or requirements of subsections (b) or (c), or fails to satisfy applicable accounting, reporting, payment, or deposit requirements";
}
@source(IRC_S7705_D, relation = formalizes, coverage = partial, quote = "The Secretary may suspend or revoke a certification of any person under subsection (b) for purposes of section 3511 if the Secretary determines that such person is not satisfying the agreements or requirements of subsections (b) or (c), or fails to satisfy applicable accounting, reporting, payment, or deposit requirements.")
rule NotSatisfyingAgreementsIsGroundForSuspensionOrRevocation strict {
    for o: ProfessionalEmployerOrganization;
    when not_satisfying_b_or_c_agreements_or_requirements(o);
    then grounds_for_suspension_or_revocation_exist(o);
}
@source(IRC_S7705_D, relation = formalizes, coverage = partial, quote = "The Secretary may suspend or revoke a certification of any person under subsection (b) for purposes of section 3511 if the Secretary determines that such person is not satisfying the agreements or requirements of subsections (b) or (c), or fails to satisfy applicable accounting, reporting, payment, or deposit requirements.")
rule FailingApplicableRequirementsIsGroundForSuspensionOrRevocation strict {
    for o: ProfessionalEmployerOrganization;
    when fails_applicable_accounting_reporting_payment_or_deposit_requirements(o);
    then grounds_for_suspension_or_revocation_exist(o);
}
@source(IRC_S7705_D, relation = formalizes, coverage = partial, quote = "The Secretary may suspend or revoke a certification of any person under subsection (b) for purposes of section 3511 if the Secretary determines that such person is not satisfying the agreements or requirements of subsections (b) or (c), or fails to satisfy applicable accounting, reporting, payment, or deposit requirements.")
rule SecretaryMaySuspendOrRevokeOnGrounds strict {
    label en unofficial "§7705(d). The Secretary may suspend or revoke a CPEO's certification when grounds exist";
    for o: ProfessionalEmployerOrganization;
    when certified_professional_employer_organization(o);
    then power SuspendOrRevokeCpeoCertification {
        holder Secretary; over o;
        exercise secretary_suspends_or_revokes_certification(o);
        valid_when grounds_for_suspension_or_revocation_exist(o);
        effect create(certification_suspended_or_revoked(o));
        window [@1986-01-01, infinity);
    };
}
