// §7701(b) — resident alien / nonresident alien, in full for this stage:
// the substantial presence test (paragraph (3)) with its weighted day count,
// the 31-day threshold, the closer-connection exception and its own
// exception, exempt individuals (paragraph (5)), presence rules
// (paragraph (7)), lawful permanent resident (paragraph (6)), and the
// starting/termination date rules of first-year/last-year residency
// (paragraph (2)). The whole section is ONE fragment (`IRC_S7701`); every
// anchor below is a quote anchor on it (DECISION-0358).
//
// MODELING CHOICE (documented, not a technical gap): the statute's formula
// operates on DAY COUNTS for a calendar year, not on a day-by-day calendar;
// this package asks a case for the three day counts the formula needs
// (current year, 1st preceding year, 2nd preceding year) as `kind empirical`
// Integer facts, rather than deriving them from 365-2190 individual
// `present_in_us_on(p, d)` facts a scenario would have to assert one by one.
// The weighted comparison is done with INTEGER arithmetic scaled by 6 (the
// common denominator of 1, 1/3, 1/6) so that no Decimal division or rounding
// policy is invented for a threshold the statute states as a plain integer
// (183 days): `6*current + 2*prior1 + prior2 >= 1098` is exactly
// `current + prior1/3 + prior2/6 >= 183`. Separately, (b)(7) "Presence in
// the United States" IS modeled per individual day
// (`physically_present_in_us_on`), because that paragraph's own content is a
// definitional test about a SINGLE day (commuter/transit/crew exceptions),
// not a running total; a scenario that wants to show a specific day does not
// count feeds that result into the day-count facts above by hand, which is
// the same reduction a real controversy over a handful of contested days
// would make.

language "law.core" version "0.2";
package us.irc.definitions version "0.1.1";
namespace "urn:us:irc:definitions:clir";

use self::{
    IRC_S7701,
    Individual,
    Person,
    citizen_of_united_states,
};

// --- (b)(7) Presence in the United States (day-level definitional test) ---
pub relation physically_present_in_us_on(p: Individual, d: Date) kind empirical {
    label en official "an individual shall be treated as present in the United States on any day if such individual is physically present in the United States at any time during such day";
}
pub relation commutes_from_canada_or_mexico_on(p: Individual, d: Date) kind empirical {
    label en official "if an individual regularly commutes to employment (or self-employment) in the United States from a place of residence in Canada or Mexico, such individual shall not be treated as present in the United States on any day during which he so commutes";
}
pub relation in_transit_between_two_foreign_points_under_24h_on(p: Individual, d: Date) kind empirical {
    label en official "if an individual, who is in transit between 2 points outside the United States, is physically present in the United States for less than 24 hours, such individual shall not be treated as present in the United States on any day during such transit";
}
pub relation crew_member_of_foreign_vessel_not_otherwise_engaged_on(p: Individual, d: Date) kind empirical {
    label en official "an individual who is temporarily present in the United States on any day as a regular member of the crew of a foreign vessel engaged in transportation between the United States and a foreign country or a possession of the United States shall not be treated as present in the United States on such day unless such individual otherwise engages in any trade or business in the United States on such day";
}
pub relation day_counts_as_present_in_us(p: Individual, d: Date) kind institutional {
    label en official "an individual shall be treated as present in the United States on any day if such individual is physically present in the United States at any time during such day";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "Except as provided in subparagraph (B), (C), or (D), an individual shall be treated as present in the United States on any day if such individual is physically present in the United States at any time during such day.")
rule PhysicalPresenceCountsUnlessExcepted strict {
    for p: Individual; for d: Date;
    when physically_present_in_us_on(p, d)
        and not_known(commutes_from_canada_or_mexico_on(p, d))
        and not_known(in_transit_between_two_foreign_points_under_24h_on(p, d))
        and not_known(crew_member_of_foreign_vessel_not_otherwise_engaged_on(p, d));
    then day_counts_as_present_in_us(p, d);
}

// --- (b)(5) Exempt individual ------------------------------------------
pub relation foreign_government_related_individual(p: Individual) kind empirical {
    label en official "any individual temporarily present in the United States by reason of diplomatic status, or a visa which the Secretary determines represents full-time diplomatic or consular status, or being a full-time employee of an international organization, or a member of the immediate family of such an individual";
}
pub relation teacher_or_trainee(p: Individual) kind empirical {
    label en official "any individual who is temporarily present in the United States under subparagraph (J) or (Q) of section 101(15) of the Immigration and Nationality Act (other than as a student) and who substantially complies with the requirements for being so present";
}
pub relation student(p: Individual) kind empirical {
    label en official "any individual who is temporarily present in the United States under subparagraph (F) or (M), or as a student under subparagraph (J) or (Q), of section 101(15) of the Immigration and Nationality Act, and who substantially complies with the requirements for being so present";
}
pub relation professional_athlete_temporarily_competing_in_charitable_sports_event(p: Individual) kind empirical {
    label en official "a professional athlete who is temporarily in the United States to compete in a sports event organized for the primary purpose of benefiting a section 501(c)(3) organization, all of whose net proceeds are contributed to it, and which utilizes volunteers for substantially all of the work performed in carrying out such event";
}
pub relation exempt_individual_for_year(p: Individual, y: Integer) kind institutional {
    label en official "an individual is an exempt individual for any day if, for such day, such individual is a foreign government-related individual, a teacher or trainee, a student, or a qualifying professional athlete";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "An individual is an exempt individual for any day if, for such day, such individual is—")
rule ForeignGovernmentRelatedIndividualIsExempt strict {
    for p: Individual; for y: Integer; for n: Integer;
    when foreign_government_related_individual(p) and days_present_current_year(p, y, n);
    then exempt_individual_for_year(p, y);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "An individual is an exempt individual for any day if, for such day, such individual is—")
rule TeacherOrTraineeIsExempt strict {
    for p: Individual; for y: Integer; for n: Integer;
    when teacher_or_trainee(p) and days_present_current_year(p, y, n);
    then exempt_individual_for_year(p, y);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "An individual is an exempt individual for any day if, for such day, such individual is—")
rule StudentIsExempt strict {
    for p: Individual; for y: Integer; for n: Integer;
    when student(p) and days_present_current_year(p, y, n);
    then exempt_individual_for_year(p, y);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "(iv) a professional athlete who is temporarily in the United States to compete in a sports event")
rule QualifyingAthleteIsExempt strict {
    for p: Individual; for y: Integer; for n: Integer;
    when professional_athlete_temporarily_competing_in_charitable_sports_event(p) and days_present_current_year(p, y, n);
    then exempt_individual_for_year(p, y);
}
// (b)(5)(E) limitations on repeat teacher/trainee and student years are NOT
// modeled at this stage (they require a running history of prior exempt
// years) — a TECH_GAP, not silently folded into the base rule; see
// `coverage/definitions.json` id `26/7701/19/u...` (n/a) — actually the
// relevant disposition ids are within `section/7701/b/*`; recorded there.

// --- (b)(3) Substantial presence test ------------------------------------
pub relation days_present_current_year(p: Individual, y: Integer, n: Integer) kind empirical {
    label en unofficial "the number of days, net of exempt-individual and medical-condition days under (b)(3)(D), on which the individual was present in the United States (day_counts_as_present_in_us, aggregated) during the current calendar year y";
}
pub relation days_present_first_preceding_year(p: Individual, y: Integer, n: Integer) kind empirical {
    label en unofficial "the number of such days during the calendar year immediately preceding y";
}
pub relation days_present_second_preceding_year(p: Individual, y: Integer, n: Integer) kind empirical {
    label en unofficial "the number of such days during the second calendar year preceding y";
}
pub relation unable_to_leave_due_to_medical_condition_arising_while_present(p: Individual, y: Integer) kind empirical {
    label en official "such individual was unable to leave the United States on such day because of a medical condition which arose while such individual was present in the United States";
}
pub relation meets_31_day_threshold(p: Individual, y: Integer) kind institutional {
    label en official "such individual was present in the United States on at least 31 days during the calendar year";
}
pub relation meets_weighted_183_day_threshold(p: Individual, y: Integer) kind institutional {
    label en official "the sum of the number of days on which such individual was present in the United States during the current year and the 2 preceding calendar years (when multiplied by the applicable multiplier determined under the following table) equals or exceeds 183 days";
}
pub relation tax_home_in_foreign_country(p: Individual, y: Integer) kind empirical {
    label en official "such individual has a tax home (as defined in section 911(d)(3) without regard to the second sentence thereof) in a foreign country";
}
// "Closer connection to a foreign country than to the United States" is a
// multi-factor, fact-intensive conclusion (Treas. Reg. 301.7701(b)-2); the
// statute names no Secretary/court authority for THIS finding the way
// (a)(3)(E)(ii) names the Secretary for the student-year exception, so it is
// modeled as an ordinary case fact rather than a DECISION-0194 evaluative
// channel — a judgment call, noted in the final report.
pub relation closer_connection_to_foreign_country(p: Individual, y: Integer) kind empirical {
    label en official "it is established that for the current year such individual has a tax home in a foreign country and has a closer connection to such foreign country than to the United States";
}
pub relation application_for_adjustment_of_status_pending(p: Individual, y: Integer) kind empirical {
    label en official "such individual had an application for adjustment of status pending";
}
pub relation took_steps_to_apply_for_lawful_permanent_resident_status(p: Individual, y: Integer) kind empirical {
    label en official "such individual took other steps to apply for status as a lawful permanent resident of the United States";
}
pub relation less_than_183_days_and_closer_connection_exception_applies(p: Individual, y: Integer) kind institutional {
    label en official "an individual shall not be treated as meeting the substantial presence test of this paragraph with respect to any current year if such individual is present in the United States on fewer than 183 days during the current year, and it is established that for the current year such individual has a tax home in a foreign country and has a closer connection to such foreign country than to the United States";
}
pub relation substantial_presence_test(p: Individual, y: Integer) kind institutional {
    label en official "an individual meets the substantial presence test of this paragraph with respect to any calendar year if such individual was present in the United States on at least 31 days during the calendar year, and the sum of the number of days on which such individual was present in the United States during the current year and the 2 preceding calendar years (when multiplied by the applicable multiplier) equals or exceeds 183 days";
}

@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "such individual was present in the United States on at least 31 days during the calendar year")
rule ThirtyOneDayThreshold strict {
    for p: Individual; for y: Integer; for n: Integer;
    when days_present_current_year(p, y, n) and n >= 31;
    then meets_31_day_threshold(p, y);
}
// Weighted comparison scaled by 6 (the LCD of 1, 1/3, 1/6) to compare
// against 183*6 = 1098 with plain Integer arithmetic — see the module
// header note.
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "the sum of the number of days on which such individual was present in the United States during the current year and the 2 preceding calendar years (when multiplied by the applicable multiplier determined under the following table) equals or exceeds 183 days")
rule WeightedOneHundredEightyThreeDayThreshold strict {
    for p: Individual; for y: Integer; for c: Integer; for p1: Integer; for p2: Integer;
    when days_present_current_year(p, y, c)
        and days_present_first_preceding_year(p, y, p1)
        and days_present_second_preceding_year(p, y, p2)
        and (6 * c + 2 * p1 + p2) >= 1098;
    then meets_weighted_183_day_threshold(p, y);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "Except as otherwise provided in this paragraph, an individual meets the substantial presence test of this paragraph with respect to any calendar year")
rule GeneralSubstantialPresenceTest strict {
    for p: Individual; for y: Integer;
    when meets_31_day_threshold(p, y) and meets_weighted_183_day_threshold(p, y)
        and not_known(less_than_183_days_and_closer_connection_exception_applies(p, y));
    then substantial_presence_test(p, y);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "An individual shall not be treated as meeting the substantial presence test of this paragraph with respect to any current year if—")
rule CloserConnectionExceptionApplies strict {
    for p: Individual; for y: Integer; for c: Integer;
    when days_present_current_year(p, y, c) and c < 183
        and tax_home_in_foreign_country(p, y) and closer_connection_to_foreign_country(p, y)
        and not_known(application_for_adjustment_of_status_pending(p, y))
        and not_known(took_steps_to_apply_for_lawful_permanent_resident_status(p, y));
    then less_than_183_days_and_closer_connection_exception_applies(p, y);
}
// (b)(3)(C): a pending adjustment-of-status application or other LPR-status
// steps defeat the closer-connection exception EVEN IF the closer-connection
// facts themselves are true — modeled above as `not` conditions inside the
// exception rule itself (an "unless" reading), since (C) is phrased as
// "subparagraph (B) not to apply", not as a competing rule of its own.

// --- (b)(1) Resident alien / nonresident alien -----------------------------
pub relation lawfully_admitted_for_permanent_residence(p: Individual, y: Integer) kind empirical {
    label en official "such individual is a lawful permanent resident of the United States at any time during such calendar year";
}
pub relation makes_first_year_election(p: Individual, y: Integer) kind empirical {
    label en official "such individual makes the election provided in paragraph (4)";
}
pub relation resident_alien_for_year(p: Individual, y: Integer) kind institutional {
    label en official "an alien individual shall be treated as a resident of the United States with respect to any calendar year if (and only if) such individual meets the requirements of clause (i), (ii), or (iii)";
}
pub relation nonresident_alien_for_year(p: Individual, y: Integer) kind institutional {
    label en official "an individual is a nonresident alien if such individual is neither a citizen of the United States nor a resident of the United States";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "Such individual is a lawful permanent resident of the United States at any time during such calendar year.")
rule LawfulPermanentResidentIsResidentAlien strict {
    for p: Individual; for y: Integer;
    when lawfully_admitted_for_permanent_residence(p, y);
    then resident_alien_for_year(p, y);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "Such individual meets the substantial presence test of paragraph (3).")
rule SubstantialPresenceMakesResidentAlien strict {
    for p: Individual; for y: Integer;
    when substantial_presence_test(p, y);
    then resident_alien_for_year(p, y);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "Such individual makes the election provided in paragraph (4).")
rule FirstYearElectionMakesResidentAlien strict {
    for p: Individual; for y: Integer;
    when makes_first_year_election(p, y);
    then resident_alien_for_year(p, y);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "An individual is a nonresident alien if such individual is neither a citizen of the United States nor a resident of the United States (within the meaning of subparagraph (A)).")
rule NeitherCitizenNorResidentIsNonresidentAlien strict {
    for p: Individual; for y: Integer; for n: Integer;
    when days_present_current_year(p, y, n)
        and not_known(citizen_of_united_states(p)) and not_known(resident_alien_for_year(p, y));
    then nonresident_alien_for_year(p, y);
}

// --- (b)(2) First and last year of residency: starting/termination dates ---
// Full detail requested by the task is "at least the starting/termination
// date rules"; the finer first-year-election starting-date branch ((A)(iv))
// and the 10-day nominal-presence disregard ((C)) are left as simplified
// (noted, not silently dropped — see coverage row for `26/7701/b/2/...`).
pub relation resident_in_preceding_calendar_year(p: Individual, y: Integer) kind empirical {
    label en unofficial "the individual was a resident of the United States at any time during the calendar year preceding y (for the first-year-of-residency test)";
}
pub relation first_day_present_while_lawful_permanent_resident(p: Individual, y: Integer, d: Date) kind empirical {
    label en official "the first day in such calendar year on which he was present in the United States while a lawful permanent resident of the United States";
}
pub relation first_day_present_in_calendar_year(p: Individual, y: Integer, d: Date) kind empirical {
    label en official "the first day during such calendar year on which the individual is present in the United States";
}
pub relation residency_starting_date(p: Individual, y: Integer, d: Date) kind institutional {
    label en official "such alien individual shall be treated as a resident of the United States only for the portion of such calendar year which begins on the residency starting date";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "In the case of an individual who is a lawfully permanent resident of the United States at any time during the calendar year, but does not meet the substantial presence test of paragraph (3), the residency starting date shall be the first day in such calendar year on which he was present in the United States while a lawful permanent resident of the United States.")
rule ResidencyStartingDateForLawfulPermanentResident strict {
    for p: Individual; for y: Integer; for d: Date;
    when lawfully_admitted_for_permanent_residence(p, y) and not_known(substantial_presence_test(p, y))
        and not_known(resident_in_preceding_calendar_year(p, y))
        and first_day_present_while_lawful_permanent_resident(p, y, d);
    then residency_starting_date(p, y, d);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "In the case of an individual who meets the substantial presence test of paragraph (3) with respect to any calendar year, the residency starting date shall be the first day during such calendar year on which the individual is present in the United States.")
rule ResidencyStartingDateForSubstantialPresence strict {
    for p: Individual; for y: Integer; for d: Date;
    when substantial_presence_test(p, y) and not_known(resident_in_preceding_calendar_year(p, y))
        and first_day_present_in_calendar_year(p, y, d);
    then residency_starting_date(p, y, d);
}

pub relation last_day_present_in_calendar_year(p: Individual, y: Integer, d: Date) kind empirical {
    label en official "the last day in such calendar year on which the individual was present in the United States";
}
pub relation closer_connection_to_foreign_country_after(p: Individual, y: Integer, portion_after: Date) kind empirical {
    label en official "during such portion the individual has a closer connection to a foreign country than to the United States";
}
pub relation resident_in_following_calendar_year(p: Individual, y: Integer) kind empirical {
    label en official "the individual is not a resident of the United States at any time during the next calendar year (negation gives the (iii) condition)";
}
pub relation not_resident_for_portion_after(p: Individual, y: Integer, d: Date) kind institutional {
    label en official "an alien individual shall not be treated as a resident of the United States during a portion of any calendar year if [the three (B) conditions]";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "An alien individual shall not be treated as a resident of the United States during a portion of any calendar year if—")
rule ResidencyTerminationDate strict {
    for p: Individual; for y: Integer; for d: Date;
    when last_day_present_in_calendar_year(p, y, d)
        and closer_connection_to_foreign_country_after(p, y, d)
        and not_known(resident_in_following_calendar_year(p, y));
    then not_resident_for_portion_after(p, y, d);
}

// --- (b)(6) Lawful permanent resident (identity, not the (b)(1) test) -----
pub relation accorded_privilege_of_permanent_residence_as_immigrant(p: Individual) kind empirical {
    label en official "such individual has the status of having been lawfully accorded the privilege of residing permanently in the United States as an immigrant in accordance with the immigration laws";
}
pub relation status_not_revoked_or_judicially_abandoned(p: Individual) kind empirical {
    label en official "such status has not been revoked (and has not been administratively or judicially determined to have been abandoned)";
}
pub relation treaty_residency_election_made(p: Individual) kind empirical {
    label en official "such individual commences to be treated as a resident of a foreign country under the provisions of a tax treaty between the United States and the foreign country, does not waive the benefits of such treaty applicable to residents of the foreign country, and notifies the Secretary of the commencement of such treatment";
}
pub relation lawful_permanent_resident(p: Individual) kind institutional {
    label en official "for purposes of this subsection, an individual is a lawful permanent resident of the United States at any time if such individual has the status of having been lawfully accorded the privilege of residing permanently in the United States as an immigrant, and such status has not been revoked (and has not been administratively or judicially determined to have been abandoned)";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "an individual is a lawful permanent resident of the United States at any time if—")
rule StatusHeldAndNotRevokedIsLawfulPermanentResident strict {
    for p: Individual;
    when accorded_privilege_of_permanent_residence_as_immigrant(p)
        and status_not_revoked_or_judicially_abandoned(p)
        and not_known(treaty_residency_election_made(p));
    then lawful_permanent_resident(p);
}
