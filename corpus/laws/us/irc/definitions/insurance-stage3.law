// Stage 3 (26.09.2026) — section 7702A: the seven level annual premiums of
// (b)/(c)(1) derived from the two actuarial inputs of the issue-date
// determination, the one-contract aggregation of (c)(4), and the chain of
// exchanges of (a)(2) unrolled to five levels.
//
// JUDGMENT CALLS AND GAPS
//  - The 7 level annual premiums are net level premiums: the net single premium
//    at issue of the future benefits (on the assumptions of section 7702(b)(2)
//    and (e), the death benefit of the 1st contract year deemed provided to the
//    maturity date, (c)(1)(B)) divided by the present value at issue of an annuity
//    due of 1 per year for 7 years on the same assumptions. Both are actuarial
//    outputs asserted by the case: the package does not embed a mortality table.
//    The quotient is rounded to cents (HALF_UP, the text names none).
//  - A premium is treated as due at the start of each contract year, so at a
//    time in contract year j the sum of the net level premiums that would have
//    been paid on or before it is j premiums (j = 1..7).
//  - (c)(3)(A)(ii) ("appropriate adjustments ... to take into account the cash
//    surrender value") names no formula: it is left to the Secretary's
//    regulations (EXTERNAL_DEPENDENCY row, no adjustment invented).
//  - (c)(4): a contract "previously issued" is one whose issue date is earlier
//    than the issue date of the contract tested; the group is read from asserted
//    policyholder, company, issue-date and initial-death-benefit facts.
//  - (a)(2): a predicate cannot depend on itself (LDC-E4102); the chain of
//    exchanges is unrolled to five levels here (levels 1-2 are in
//    modified-endowment.law); a sixth contract of a chain is not derived
//    (TECH-GAPS G6301).

language "law.core" version "0.2";
package us.irc.definitions version "0.1.1";
namespace "urn:us:irc:definitions:clir";

use self::{
    IRC_S7702A_A,
    IRC_S7702A_B,
    IRC_S7702A_C,
    IRC_S7702A_E,
    InsuranceContract,
    Person,
    contract_year_evaluated_on,
    first_month_for_which_contract_is_in_effect_begins_on,
    initial_death_benefit_of_treated_as_one_contract,
    modified_endowment_contract_7702a,
    received_in_exchange_for_contract,
    received_in_exchange_for_first_level_exchange_contract,
    seven_pay_net_level_premium_sum_through,
};

// ============================================================================
// (b), (c)(1): the seven level annual premiums
// ============================================================================

pub relation seven_pay_net_single_premium_at_issue(c: InsuranceContract, amount: Money) kind empirical {
    label en official "the net single premium at issue of the future benefits under the contract, determined as of the time the contract is issued by applying the rules of section 7702(b)(2) and section 7702(e) (other than (e)(2)(C)), the death benefit of the 1st contract year being deemed provided until the maturity date without regard to any scheduled reduction after the 1st 7 contract years (section 7702A(c)(1)); an actuarial output asserted by the case";
}
pub relation seven_pay_annuity_due_factor_at_issue(c: InsuranceContract, factor: Decimal) kind empirical {
    label en official "the present value at issue of an annuity due of 1 per year for 7 years, on the same assumptions as the net single premium (an actuarial output asserted by the case)";
}
pub relation seven_pay_level_annual_premium(c: InsuranceContract, amount: Money) kind institutional {
    label en official "each of the 7 level annual premiums: the net premium which, paid for 7 years, funds the paid-up future benefits (section 7702A(b), (c)(1)); the quotient of the net single premium and the annuity-due factor, in cents";
}
@source(IRC_S7702A_B, coverage = partial, quote = "if the contract provided for paid-up future benefits after the payment of 7 level annual premiums")
rule SevenPayLevelAnnualPremiumIsNspOverAnnuityDue strict {
    for c: InsuranceContract; for nsp: Money; for f: Decimal;
    when seven_pay_net_single_premium_at_issue(c, nsp) and seven_pay_annuity_due_factor_at_issue(c, f) and f > 0.0;
    then seven_pay_level_annual_premium(c, div_round(nsp, f, 2, "HALF_UP"));
}
pub relation seven_pay_premiums_due_through(c: InsuranceContract, on: Date, n: Integer) kind institutional {
    label en official "the number of the 7 level annual premiums that would have been paid on or before the date: one at the start of each contract year begun";
}
@source(IRC_S7702A_E, coverage = partial, quote = "each 12-month period beginning with the corresponding month in subsequent calendar years")
rule SevenPayPremiumsDueInContractYear1 strict { for c: InsuranceContract; for on: Date; for d0: Date; when first_month_for_which_contract_is_in_effect_begins_on(c, d0) and contract_year_evaluated_on(c, on) and on >= d0 and on < add_calendar_period(d0, 12 calendar_month); then seven_pay_premiums_due_through(c, on, 1); }
rule SevenPayPremiumsDueInContractYear2 strict { for c: InsuranceContract; for on: Date; for d0: Date; when first_month_for_which_contract_is_in_effect_begins_on(c, d0) and contract_year_evaluated_on(c, on) and on >= add_calendar_period(d0, 12 calendar_month) and on < add_calendar_period(d0, 24 calendar_month); then seven_pay_premiums_due_through(c, on, 2); }
rule SevenPayPremiumsDueInContractYear3 strict { for c: InsuranceContract; for on: Date; for d0: Date; when first_month_for_which_contract_is_in_effect_begins_on(c, d0) and contract_year_evaluated_on(c, on) and on >= add_calendar_period(d0, 24 calendar_month) and on < add_calendar_period(d0, 36 calendar_month); then seven_pay_premiums_due_through(c, on, 3); }
rule SevenPayPremiumsDueInContractYear4 strict { for c: InsuranceContract; for on: Date; for d0: Date; when first_month_for_which_contract_is_in_effect_begins_on(c, d0) and contract_year_evaluated_on(c, on) and on >= add_calendar_period(d0, 36 calendar_month) and on < add_calendar_period(d0, 48 calendar_month); then seven_pay_premiums_due_through(c, on, 4); }
rule SevenPayPremiumsDueInContractYear5 strict { for c: InsuranceContract; for on: Date; for d0: Date; when first_month_for_which_contract_is_in_effect_begins_on(c, d0) and contract_year_evaluated_on(c, on) and on >= add_calendar_period(d0, 48 calendar_month) and on < add_calendar_period(d0, 60 calendar_month); then seven_pay_premiums_due_through(c, on, 5); }
rule SevenPayPremiumsDueInContractYear6 strict { for c: InsuranceContract; for on: Date; for d0: Date; when first_month_for_which_contract_is_in_effect_begins_on(c, d0) and contract_year_evaluated_on(c, on) and on >= add_calendar_period(d0, 60 calendar_month) and on < add_calendar_period(d0, 72 calendar_month); then seven_pay_premiums_due_through(c, on, 6); }
rule SevenPayPremiumsDueInContractYear7 strict { for c: InsuranceContract; for on: Date; for d0: Date; when first_month_for_which_contract_is_in_effect_begins_on(c, d0) and contract_year_evaluated_on(c, on) and on >= add_calendar_period(d0, 72 calendar_month) and on < add_calendar_period(d0, 84 calendar_month); then seven_pay_premiums_due_through(c, on, 7); }
pub relation seven_pay_net_level_premium_sum_derived(c: InsuranceContract, on: Date, amount: Money) kind institutional {
    label en official "the sum of the net level premiums which would have been paid on or before the date if the contract provided for paid-up future benefits after the payment of 7 level annual premiums, derived from the level premium and the number of premiums due";
}
rule SevenPayNetLevelPremiumSumIsPremiumTimesCount strict {
    for c: InsuranceContract; for on: Date; for p: Money; for n: Integer;
    when seven_pay_level_annual_premium(c, p) and seven_pay_premiums_due_through(c, on, n);
    then seven_pay_net_level_premium_sum_derived(c, on, p * n);
}
pub relation seven_pay_sum_asserted_at(c: InsuranceContract, on: Date) kind institutional {
    label en unofficial "helper: the case asserts the sum of net level premiums for this date";
}
rule SevenPaySumAssertedAt strict { for c: InsuranceContract; for on: Date; for a: Money; when seven_pay_net_level_premium_sum_through(c, on, a); then seven_pay_sum_asserted_at(c, on); }
pub relation seven_pay_limit_through(c: InsuranceContract, on: Date, amount: Money) kind institutional {
    label en official "the sum of the net level premiums which would have been paid on or before such time, from the case's asserted sum or, without one, derived from the actuarial inputs";
}
rule SevenPayLimitFromAssertedSum strict { for c: InsuranceContract; for on: Date; for a: Money; when seven_pay_net_level_premium_sum_through(c, on, a); then seven_pay_limit_through(c, on, a); }
rule SevenPayLimitFromDerivedSum strict { for c: InsuranceContract; for on: Date; for a: Money; when seven_pay_net_level_premium_sum_derived(c, on, a) and not_known(seven_pay_sum_asserted_at(c, on)); then seven_pay_limit_through(c, on, a); }

// ============================================================================
// (c)(4): the contract and all contracts previously issued by the same company
// to the same policyholder are treated as one contract
// ============================================================================

pub relation contract_policyholder(c: InsuranceContract, holder: Person) kind empirical { label en official "the policyholder of the contract"; }
pub relation contract_issuing_company(c: InsuranceContract, company: Person) kind empirical { label en official "the company that issued the contract"; }
pub relation contract_issue_date(c: InsuranceContract, d: Date) kind empirical { label en official "the date the contract was issued"; }
pub relation contract_initial_death_benefit(c: InsuranceContract, amount: Money) kind empirical { label en official "the initial death benefit the contract itself provides"; }
pub relation previously_issued_to_same_policyholder_by_same_company(c: InsuranceContract, prior: InsuranceContract) kind institutional {
    label en official "prior is a contract previously issued to the same policyholder by the same company";
}
@source(IRC_S7702A_C, coverage = partial, quote = "the contract involved and all contracts previously issued to the same policyholder by the same company shall be treated as one contract")
rule PriorContractOfSameHolderAndCompany strict {
    for c: InsuranceContract; for prior: InsuranceContract; for h: Person; for co: Person; for d1: Date; for d0: Date;
    when contract_policyholder(c, h) and contract_policyholder(prior, h) and contract_issuing_company(c, co) and contract_issuing_company(prior, co)
        and contract_issue_date(c, d1) and contract_issue_date(prior, d0) and d0 < d1;
    then previously_issued_to_same_policyholder_by_same_company(c, prior);
}
pub relation treated_as_one_contract_member(c: InsuranceContract, member: InsuranceContract) kind institutional {
    label en official "member is the contract involved or one of the contracts previously issued to the same policyholder by the same company, all treated as one contract";
}
rule ContractInvolvedIsMemberOfItself strict { for c: InsuranceContract; for d: Date; when contract_issue_date(c, d); then treated_as_one_contract_member(c, c); }
rule PriorContractIsMemberOfOneContract strict { for c: InsuranceContract; for prior: InsuranceContract; when previously_issued_to_same_policyholder_by_same_company(c, prior); then treated_as_one_contract_member(c, prior); }
pub relation aggregate_initial_death_benefit_one_contract(c: InsuranceContract, amount: Money) kind institutional {
    label en official "the initial death benefit of the contract treated as one: the sum over the contract involved and the contracts previously issued to the same policyholder by the same company";
}
rule AggregateInitialDeathBenefitOfOneContract strict {
    for c: InsuranceContract; for d: Date;
    when contract_issue_date(c, d);
    then aggregate_initial_death_benefit_one_contract(c, sum all a: Money for m: InsuranceContract where treated_as_one_contract_member(c, m) and contract_initial_death_benefit(m, a));
}
pub relation initial_death_benefit_for_small_contract_test(c: InsuranceContract, amount: Money) kind institutional {
    label en official "the initial death benefit tested against $10,000: the case's asserted aggregate, or the aggregate derived from the group facts";
}
rule SmallContractBenefitFromAssertedAggregate strict { for c: InsuranceContract; for a: Money; when initial_death_benefit_of_treated_as_one_contract(c, a); then initial_death_benefit_for_small_contract_test(c, a); }
pub relation asserted_one_contract_benefit_stated(c: InsuranceContract) kind institutional { label en unofficial "helper: an aggregate initial death benefit is asserted"; }
rule AssertedOneContractBenefitStated strict { for c: InsuranceContract; for a: Money; when initial_death_benefit_of_treated_as_one_contract(c, a); then asserted_one_contract_benefit_stated(c); }
rule SmallContractBenefitFromGroup strict { for c: InsuranceContract; for a: Money; when aggregate_initial_death_benefit_one_contract(c, a) and not_known(asserted_one_contract_benefit_stated(c)); then initial_death_benefit_for_small_contract_test(c, a); }

// ============================================================================
// (a)(2): exchanges, levels 3 to 5
// ============================================================================

pub relation received_in_exchange_third_level(c: InsuranceContract) kind institutional { label en official "a contract received in exchange for a level-2 exchange contract (third link of the chain)"; }
pub relation received_in_exchange_fourth_level(c: InsuranceContract) kind institutional { label en official "a contract received in exchange for a level-3 exchange contract (fourth link of the chain)"; }
pub relation received_in_exchange_fifth_level(c: InsuranceContract) kind institutional { label en official "a contract received in exchange for a level-4 exchange contract (fifth link of the chain)"; }
@source(IRC_S7702A_A, coverage = partial, quote = "(2) which is received in exchange for a contract described in paragraph (1) or this paragraph.")
rule ExchangeForSecondLevelGivesThirdLevel strict { for c: InsuranceContract; for prior: InsuranceContract; when received_in_exchange_for_contract(c, prior) and received_in_exchange_for_first_level_exchange_contract(prior); then received_in_exchange_third_level(c); }
rule ExchangeForThirdLevelGivesFourthLevel strict { for c: InsuranceContract; for prior: InsuranceContract; when received_in_exchange_for_contract(c, prior) and received_in_exchange_third_level(prior); then received_in_exchange_fourth_level(c); }
rule ExchangeForFourthLevelGivesFifthLevel strict { for c: InsuranceContract; for prior: InsuranceContract; when received_in_exchange_for_contract(c, prior) and received_in_exchange_fourth_level(prior); then received_in_exchange_fifth_level(c); }
rule ThirdLevelExchangeContractIsMec strict { for c: InsuranceContract; when received_in_exchange_third_level(c); then modified_endowment_contract_7702a(c); }
rule FourthLevelExchangeContractIsMec strict { for c: InsuranceContract; when received_in_exchange_fourth_level(c); then modified_endowment_contract_7702a(c); }
rule FifthLevelExchangeContractIsMec strict { for c: InsuranceContract; when received_in_exchange_fifth_level(c); then modified_endowment_contract_7702a(c); }
