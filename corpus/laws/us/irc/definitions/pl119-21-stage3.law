// Stage 3 (26.09.2026) — Public Law 119-21 sec. 70512(c) and sec. 70524, the
// parts stage 2 left as tech gaps: effective control (a)(51)(D)(ii), the
// publicly traded entity rules (a)(51)(E)(ii)-(iii), the critical-mineral
// thresholds issued by the Secretary (a)(52)(C)(ii), the netting of excluded
// existing-contract costs from the material assistance cost ratio
// (a)(52)(D)(iv), and the composition of the added qualifying-income items of
// section 7704(d)(1)(E) into the aggregate the 90-percent test reads.
//
// Rules are `effective [@2025-07-04, infinity)` like their stage-2 neighbours.
//
// JUDGMENT CALLS AND GAPS
//  - Effective control. Before the Secretary issues the guidance of
//    (D)(ii)(I)(bb), "effective control" is the unrestricted contractual right of
//    a counterparty to do one of the six things of (D)(ii)(II); once guidance is
//    issued the general rule of (I)(aa) ("similar arrangements ... specific
//    authority over key aspects") is a judgment of the Secretary (external
//    judgment relation), with (II) and (III) still applying. The licensing rights
//    of (III)(aa) are read as: one of the rights (AA)-(FF) and an arrangement
//    entered into or modified on or after enactment ((GG) read as the temporal
//    condition of the whole list, not as a seventh alternative; the text is
//    ambiguous, INTERPRETATION recorded in the coverage row). A bona fide
//    purchase or sale of intellectual property (not one reverting to the
//    counterparty after a time) is outside (III) (bb).
//  - "the previous taxable year" is read as the 12 months ending the day before
//    the year begins.
//  - Critical minerals. The Secretary's issued percentage applies to components
//    sold after the date it is issued, only if it equals or exceeds the
//    percentage that would otherwise apply ((C)(ii)). The wind-component
//    thresholds for years after 2027 are stated nowhere in the text (SOURCE_GAP:
//    the row stays open, a threshold is never invented).
//  - Excluded cost items are read at item level (asserted item costs) and netted
//    from the asserted aggregates of stage 2.

language "law.core" version "0.2";
package us.irc.definitions version "0.1.1";
namespace "urn:us:irc:definitions:clir";

use self::{
    CleanEnergyFacility,
    EligibleComponentProduction,
    ExistingContractCostItem,
    Partnership,
    Person,
    PtpIncomeItem,
    TaxableYear,
    component_sold_on,
    controls_under_subparagraph_g,
    cost_excluded_from_material_assistance_cost_ratio,
    described_in_foreign_controlled_clauses_i_to_iv_on,
    exempt_from_foreign_influenced_clause_d_i_i_as_publicly_traded,
    foreign_controlled_entity_on,
    foreign_influenced_entity_for_year,
    is_applicable_critical_mineral_under_45x_c6,
    material_assistance_threshold_percentage_component,
    pfe_attributed_direct_costs_facility,
    pfe_attributed_direct_material_costs_component,
    ptp_income_item_of_taxable_year,
    qualifying_gross_income_for_year,
    qualifying_income_item_under_7704d1e_as_amended_by_pl119_21,
    regularly_traded_on_qualifying_exchange_or_market,
    sfe_has_direct_authority_to_appoint_covered_officer_during,
    specified_foreign_entity_by_clauses_i_to_iv_on,
    taxable_year_under_prohibited_foreign_entity_test,
    total_direct_costs_of_manufactured_products_incorporated,
    total_direct_material_costs_of_eligible_component,
};

// ============================================================================
// (a)(51)(E)(ii)-(iii): publicly traded entities
// ============================================================================

pub relation required_to_report_beneficial_ownership_under_publicly_traded_rule(x: Person) kind empirical {
    label en official "the entity is required to report its beneficial ownership pursuant to a rule described in clause (iii)(I)(bb) (Rule 13d-3 of the Securities Exchange Act of 1934 or an equivalent rule of an exchange or market described in (E)(i)(I)(cc))";
}
@source(us.irc.temporal::PL119_21_S70512, coverage = partial, quote = "1 or more specified foreign entities (as determined without regard to subparagraph (B)(v)) that are each required to report their beneficial ownership")
rule PubliclyTradedEntityControlledByReportingSfeIsForeignControlled strict {
    effective [@2025-07-04, infinity);
    for e: Person; for x: Person; for d: Date;
    when regularly_traded_on_qualifying_exchange_or_market(e) and controls_under_subparagraph_g(x, e)
        and specified_foreign_entity_by_clauses_i_to_iv_on(x, d) and required_to_report_beneficial_ownership_under_publicly_traded_rule(x);
    then foreign_controlled_entity_on(e, d);
}
@source(us.irc.temporal::PL119_21_S70512, coverage = partial, quote = "1 or more foreign-controlled entities (as determined without regard to subparagraph (C)(v)) that are each required to report their beneficial ownership")
rule PubliclyTradedEntityControlledByReportingForeignControlledEntityIsForeignControlled strict {
    effective [@2025-07-04, infinity);
    for e: Person; for x: Person; for d: Date;
    when regularly_traded_on_qualifying_exchange_or_market(e) and controls_under_subparagraph_g(x, e)
        and described_in_foreign_controlled_clauses_i_to_iv_on(x, d) and required_to_report_beneficial_ownership_under_publicly_traded_rule(x);
    then foreign_controlled_entity_on(e, d);
}
pub relation single_reporting_sfe_owns_percent_during(e: Person, y: TaxableYear, pct: Decimal) kind empirical {
    label en official "a single specified foreign entity required to report its beneficial ownership owns the given percent of the entity";
}
pub relation reporting_sfes_own_in_aggregate_percent_during(e: Person, y: TaxableYear, pct: Decimal) kind empirical {
    label en official "one or more specified foreign entities, each required to report its beneficial ownership, own the given percent in the aggregate";
}
pub relation percent_of_publicly_traded_debt_originally_issued_to_sfes(e: Person, pct: Decimal) kind empirical {
    label en official "the percent of the entity's publicly-traded debt issued, as part of an original issuance, to 1 or more specified foreign entities";
}
@source(us.irc.temporal::PL119_21_S70512, coverage = partial, quote = "(aa) a specified foreign entity has the authority to appoint a covered officer of such entity,")
rule PubliclyTradedEntityWithSfeAppointingCoveredOfficerIsForeignInfluenced strict {
    effective [@2025-07-04, infinity);
    for e: Person; for y: TaxableYear; for b: Date;
    when exempt_from_foreign_influenced_clause_d_i_i_as_publicly_traded(e) and sfe_has_direct_authority_to_appoint_covered_officer_during(e, y) and us.irc.core::begins(y, b) and b > @2025-07-04;
    then foreign_influenced_entity_for_year(e, y);
}
@source(us.irc.temporal::PL119_21_S70512, coverage = partial, quote = "a single specified foreign entity required to report its beneficial ownership under Rule 13d-3 of the Securities and Exchange Act of 1934")
rule PubliclyTradedEntityWithReportingSfeAtLeast25PercentIsForeignInfluenced strict {
    effective [@2025-07-04, infinity);
    for e: Person; for y: TaxableYear; for p: Decimal; for b: Date;
    when exempt_from_foreign_influenced_clause_d_i_i_as_publicly_traded(e) and single_reporting_sfe_owns_percent_during(e, y, p) and p >= 25.0 and us.irc.core::begins(y, b) and b > @2025-07-04;
    then foreign_influenced_entity_for_year(e, y);
}
@source(us.irc.temporal::PL119_21_S70512, coverage = partial, quote = "own, in the aggregate, not less than 40 percent of such entity")
rule PubliclyTradedEntityWithReportingSfesAtLeast40PercentIsForeignInfluenced strict {
    effective [@2025-07-04, infinity);
    for e: Person; for y: TaxableYear; for p: Decimal; for b: Date;
    when exempt_from_foreign_influenced_clause_d_i_i_as_publicly_traded(e) and reporting_sfes_own_in_aggregate_percent_during(e, y, p) and p >= 40.0 and us.irc.core::begins(y, b) and b > @2025-07-04;
    then foreign_influenced_entity_for_year(e, y);
}
@source(us.irc.temporal::PL119_21_S70512, coverage = partial, quote = "such entity has issued debt, as part of an original issuance, in excess of 15 percent of its publicly-traded debt to 1 or more specified foreign entities")
rule PubliclyTradedEntityWithMoreThan15PercentDebtToSfesIsForeignInfluenced strict {
    effective [@2025-07-04, infinity);
    for e: Person; for y: TaxableYear; for p: Decimal; for b: Date;
    when exempt_from_foreign_influenced_clause_d_i_i_as_publicly_traded(e) and percent_of_publicly_traded_debt_originally_issued_to_sfes(e, p) and p > 15.0 and us.irc.core::begins(y, b) and b > @2025-07-04 and taxable_year_under_prohibited_foreign_entity_test(e, y);
    then foreign_influenced_entity_for_year(e, y);
}

// ============================================================================
// (a)(51)(D)(ii): effective control
// ============================================================================

pub entity ControlArrangement { label en unofficial "a contract, agreement or other arrangement between a taxpayer and a contractual counterparty (subparagraph (D)(ii)(V))"; }
pub relation arrangement_taxpayer(a: ControlArrangement, e: Person) kind empirical { label en official "the taxpayer party to the arrangement, or a person related to the taxpayer (subclause (IV))"; }
pub relation arrangement_counterparty(a: ControlArrangement, x: Person) kind empirical { label en official "the contractual counterparty: an entity with which the taxpayer has entered into the arrangement"; }
pub relation arrangement_payment_made_on(a: ControlArrangement, d: Date) kind empirical { label en official "a payment made to the specified foreign entity pursuant to the arrangement on the date"; }
pub relation arrangement_concerns_qualified_facility_or_storage(a: ControlArrangement) kind empirical { label en official "the arrangement concerns a qualified facility or energy storage technology of the taxpayer (or a related person) (clause (i)(II)(aa))"; }
pub relation arrangement_concerns_eligible_component_production(a: ControlArrangement) kind empirical { label en official "the arrangement concerns the extraction, processing or recycling of an applicable critical mineral, or the production of an eligible component (clause (i)(II)(bb))"; }
pub relation guidance_on_effective_control_issued_on(d: Date) kind empirical { label en official "the date the Secretary issues the guidance described in subclause (I)(bb)"; }
pub relation arrangement_grants_unrestricted_right_to_set_quantity_or_timing_of_component_production(a: ControlArrangement) kind empirical { label en official "(II)(aa) the unrestricted contractual right of the counterparty to determine the quantity or timing of production of an eligible component"; }
pub relation arrangement_grants_unrestricted_right_to_set_facility_or_storage_activity(a: ControlArrangement) kind empirical { label en official "(II)(bb) the unrestricted right to determine the amount or timing of electricity production at a qualified facility or of storage in energy storage technology"; }
pub relation arrangement_grants_unrestricted_right_to_choose_component_output_buyer(a: ControlArrangement) kind empirical { label en official "(II)(cc) the unrestricted right to determine which entity may purchase or use the output of a production unit producing eligible components"; }
pub relation arrangement_grants_unrestricted_right_to_choose_facility_output_buyer(a: ControlArrangement) kind empirical { label en official "(II)(dd) the unrestricted right to determine which entity may purchase or use the output of a qualified facility"; }
pub relation arrangement_grants_unrestricted_right_to_restrict_data_or_site_access(a: ControlArrangement) kind empirical { label en official "(II)(ee) the unrestricted right to restrict access to data critical to production or storage of energy, or to the site or any part of a qualified facility or energy storage technology, to the counterparty's personnel or agents"; }
pub relation arrangement_grants_unrestricted_exclusive_maintenance_right(a: ControlArrangement) kind empirical { label en official "(II)(ff) the unrestricted right, on an exclusive basis, to maintain, repair or operate any plant or equipment necessary to production of eligible components or electricity"; }
pub relation effective_control_by_subclause_ii(a: ControlArrangement) kind institutional { label en official "effective control before guidance: the unrestricted contractual right of a counterparty to do one of the things of (II)(aa)-(ff)"; }
@source(us.irc.temporal::PL119_21_S70512, coverage = partial, quote = "the term ‘effective control’ means the unrestricted contractual right of a contractual counterparty to—")
rule EffectiveControlIiAa strict { effective [@2025-07-04, infinity); for a: ControlArrangement; when arrangement_grants_unrestricted_right_to_set_quantity_or_timing_of_component_production(a); then effective_control_by_subclause_ii(a); }
rule EffectiveControlIiBb strict { effective [@2025-07-04, infinity); for a: ControlArrangement; when arrangement_grants_unrestricted_right_to_set_facility_or_storage_activity(a); then effective_control_by_subclause_ii(a); }
rule EffectiveControlIiCc strict { effective [@2025-07-04, infinity); for a: ControlArrangement; when arrangement_grants_unrestricted_right_to_choose_component_output_buyer(a); then effective_control_by_subclause_ii(a); }
rule EffectiveControlIiDd strict { effective [@2025-07-04, infinity); for a: ControlArrangement; when arrangement_grants_unrestricted_right_to_choose_facility_output_buyer(a); then effective_control_by_subclause_ii(a); }
rule EffectiveControlIiEe strict { effective [@2025-07-04, infinity); for a: ControlArrangement; when arrangement_grants_unrestricted_right_to_restrict_data_or_site_access(a); then effective_control_by_subclause_ii(a); }
rule EffectiveControlIiFf strict { effective [@2025-07-04, infinity); for a: ControlArrangement; when arrangement_grants_unrestricted_exclusive_maintenance_right(a); then effective_control_by_subclause_ii(a); }
// (III): licensing of intellectual property.
pub relation arrangement_is_ip_licensing_agreement_or_related(a: ControlArrangement) kind empirical { label en official "a licensing agreement for the provision of intellectual property, or another arrangement with the counterparty related to it, for a qualified facility, energy storage technology or the production of an eligible component"; }
pub relation arrangement_retains_right_to_direct_sources_of_components(a: ControlArrangement) kind empirical { label en official "(III)(aa)(AA) a contractual right retained by the counterparty to specify or direct one or more sources of components, subcomponents or critical minerals"; }
pub relation arrangement_retains_right_to_direct_operation(a: ControlArrangement) kind empirical { label en official "(BB) a right to direct the operation of a qualified facility, energy storage technology or production unit"; }
pub relation arrangement_retains_right_to_limit_use_of_intellectual_property(a: ControlArrangement) kind empirical { label en official "(CC) a right to limit the taxpayer's utilization of intellectual property related to the operation or production"; }
pub relation arrangement_retains_royalties_beyond_tenth_year(a: ControlArrangement) kind empirical { label en official "(DD) a right to receive royalties (or related payments) beyond the 10th year of the agreement, including modifications or extensions"; }
pub relation arrangement_retains_right_to_require_services_over_two_years(a: ControlArrangement) kind empirical { label en official "(EE) a right to require the taxpayer to enter into an agreement for services for a duration longer than 2 years, including modifications or extensions"; }
pub relation arrangement_withholds_technical_data_needed_to_produce(a: ControlArrangement) kind empirical { label en official "(FF) the arrangement does not provide the licensee all the technical data, information and know-how necessary to produce without further involvement of the counterparty or a specified foreign entity"; }
pub relation arrangement_entered_into_or_modified_on(a: ControlArrangement, d: Date) kind empirical { label en official "(GG) the arrangement was entered into (or modified) on the date"; }
pub relation arrangement_is_purchase_or_sale_of_intellectual_property(a: ControlArrangement) kind empirical { label en official "a purchase or sale of intellectual property"; }
pub relation intellectual_property_ownership_reverts_to_counterparty_after_time(a: ControlArrangement) kind empirical { label en official "the agreement provides that ownership of the intellectual property reverts to the contractual counterparty after a period of time"; }
pub relation bona_fide_purchase_or_sale_of_intellectual_property(a: ControlArrangement) kind institutional { label en official "a bona fide purchase or sale of intellectual property: a purchase or sale under which ownership does not revert to the counterparty after a period of time"; }
@source(us.irc.temporal::PL119_21_S70512, coverage = partial, quote = "any purchase or sale of intellectual property where the agreement provides that ownership of the intellectual property reverts to the contractual counterparty after a period of time shall not be considered a bona-fide purchase or sale")
rule BonaFidePurchaseOrSaleOfIp strict {
    effective [@2025-07-04, infinity);
    for a: ControlArrangement;
    when arrangement_is_purchase_or_sale_of_intellectual_property(a) and not_known(intellectual_property_ownership_reverts_to_counterparty_after_time(a));
    then bona_fide_purchase_or_sale_of_intellectual_property(a);
}
pub relation ip_licensing_right_retained(a: ControlArrangement) kind institutional { label en unofficial "helper: the counterparty retains one of the rights (AA)-(FF)"; }
rule IpRightAa strict { effective [@2025-07-04, infinity); for a: ControlArrangement; when arrangement_retains_right_to_direct_sources_of_components(a); then ip_licensing_right_retained(a); }
rule IpRightBb strict { effective [@2025-07-04, infinity); for a: ControlArrangement; when arrangement_retains_right_to_direct_operation(a); then ip_licensing_right_retained(a); }
rule IpRightCc strict { effective [@2025-07-04, infinity); for a: ControlArrangement; when arrangement_retains_right_to_limit_use_of_intellectual_property(a); then ip_licensing_right_retained(a); }
rule IpRightDd strict { effective [@2025-07-04, infinity); for a: ControlArrangement; when arrangement_retains_royalties_beyond_tenth_year(a); then ip_licensing_right_retained(a); }
rule IpRightEe strict { effective [@2025-07-04, infinity); for a: ControlArrangement; when arrangement_retains_right_to_require_services_over_two_years(a); then ip_licensing_right_retained(a); }
rule IpRightFf strict { effective [@2025-07-04, infinity); for a: ControlArrangement; when arrangement_withholds_technical_data_needed_to_produce(a); then ip_licensing_right_retained(a); }
pub relation effective_control_by_subclause_iii(a: ControlArrangement) kind institutional { label en official "effective control by an intellectual property licensing arrangement: one of the rights (AA)-(FF), the arrangement entered into or modified on or after enactment, and not a bona fide purchase or sale of intellectual property"; }
@source(us.irc.temporal::PL119_21_S70512, coverage = partial, quote = "Item (aa) shall not apply in the case of a bona fide purchase or sale of intellectual property.")
rule EffectiveControlIii strict {
    effective [@2025-07-04, infinity);
    for a: ControlArrangement; for d: Date;
    when arrangement_is_ip_licensing_agreement_or_related(a) and ip_licensing_right_retained(a) and arrangement_entered_into_or_modified_on(a, d) and d >= @2025-07-04
        and not_known(bona_fide_purchase_or_sale_of_intellectual_property(a));
    then effective_control_by_subclause_iii(a);
}
// (I)(aa): after guidance the general rule is a judgment.
pub external judgment relation arrangement_provides_specific_authority_over_key_aspects(a: ControlArrangement) {
    authority Secretary;
    label en official "the arrangement is similar to those described in subclauses (II) and (III) and provides one or more contractual counterparties specific authority over key aspects of the production of eligible components, energy generation in a qualified facility, or energy storage, not included in the measures of control through authority, ownership, or debt held (subclause (I)(aa))";
}
pub relation effective_control_arrangement(a: ControlArrangement, on: Date) kind institutional { label en official "the arrangement confers effective control on the counterparty at the date"; }
@source(us.irc.temporal::PL119_21_S70512, coverage = partial, quote = "During any period prior to the date that the guidance described in subclause (I)(bb) is issued by the Secretary")
rule EffectiveControlBeforeGuidanceByIi strict {
    effective [@2025-07-04, infinity);
    for a: ControlArrangement; for on: Date; for g: Date;
    when effective_control_by_subclause_ii(a) and arrangement_payment_made_on(a, on) and guidance_on_effective_control_issued_on(g) and on < g;
    then effective_control_arrangement(a, on);
}
pub relation effective_control_guidance_issued_by(a: ControlArrangement, on: Date) kind institutional { label en unofficial "helper: guidance of (I)(bb) has been issued on or before the payment date of the arrangement"; }
rule GuidanceIssuedByDate strict { effective [@2025-07-04, infinity); for a: ControlArrangement; for on: Date; for g: Date; when arrangement_payment_made_on(a, on) and guidance_on_effective_control_issued_on(g) and on >= g; then effective_control_guidance_issued_by(a, on); }
rule EffectiveControlBeforeGuidanceNoGuidanceIssued strict {
    effective [@2025-07-04, infinity);
    for a: ControlArrangement; for on: Date;
    when effective_control_by_subclause_ii(a) and arrangement_payment_made_on(a, on) and not_known(effective_control_guidance_issued_by(a, on));
    then effective_control_arrangement(a, on);
}
rule EffectiveControlAfterGuidanceIi strict {
    effective [@2025-07-04, infinity);
    for a: ControlArrangement; for on: Date;
    when effective_control_by_subclause_ii(a) and arrangement_payment_made_on(a, on) and effective_control_guidance_issued_by(a, on);
    then effective_control_arrangement(a, on);
}
rule EffectiveControlByIii strict {
    effective [@2025-07-04, infinity);
    for a: ControlArrangement; for on: Date;
    when effective_control_by_subclause_iii(a) and arrangement_payment_made_on(a, on);
    then effective_control_arrangement(a, on);
}
rule EffectiveControlByGeneralRule strict {
    effective [@2025-07-04, infinity);
    for a: ControlArrangement; for on: Date;
    when arrangement_provides_specific_authority_over_key_aspects(a) and arrangement_payment_made_on(a, on) and effective_control_guidance_issued_by(a, on);
    then effective_control_arrangement(a, on);
}
pub relation paid_sfe_in_previous_year_under_effective_control(e: Person, y: TaxableYear) kind institutional {
    label en official "during the previous taxable year the entity made a payment to a specified foreign entity under an arrangement entitling it (or a related entity) to exercise effective control over a qualified facility, energy storage technology or eligible component production";
}
@source(us.irc.temporal::PL119_21_S70512, coverage = partial, quote = "which, during the previous taxable year, made a payment to a specified foreign entity pursuant to a contract, agreement, or other arrangement which entitles such specified foreign entity (or an entity related to such specified foreign entity) to exercise effective control over—")
rule PaymentToSfeUnderEffectiveControlArrangementInPreviousYear strict {
    effective [@2025-07-04, infinity);
    for e: Person; for y: TaxableYear; for a: ControlArrangement; for x: Person; for on: Date; for b: Date;
    for calendar_before_1: Date;
    when arrangement_taxpayer(a, e) and arrangement_counterparty(a, x) and arrangement_payment_made_on(a, on) and effective_control_arrangement(a, on)
        and us.irc.core::begins(y, b) and on >= calendar_before_1 and on < b
        and specified_foreign_entity_by_clauses_i_to_iv_on(x, on)
        and arrangement_concerns_qualified_facility_or_storage(a)
        and us.irc.core::civil_calendar_boundary_before(b, 12, us.irc.core::CalendarMonth, calendar_before_1);
    then paid_sfe_in_previous_year_under_effective_control(e, y);
}
rule PaymentToSfeUnderEffectiveControlOverComponentProductionInPreviousYear strict {
    effective [@2025-07-04, infinity);
    for e: Person; for y: TaxableYear; for a: ControlArrangement; for x: Person; for on: Date; for b: Date;
    for calendar_before_1: Date;
    when arrangement_taxpayer(a, e) and arrangement_counterparty(a, x) and arrangement_payment_made_on(a, on) and effective_control_arrangement(a, on)
        and us.irc.core::begins(y, b) and on >= calendar_before_1 and on < b
        and specified_foreign_entity_by_clauses_i_to_iv_on(x, on)
        and arrangement_concerns_eligible_component_production(a)
        and us.irc.core::civil_calendar_boundary_before(b, 12, us.irc.core::CalendarMonth, calendar_before_1);
    then paid_sfe_in_previous_year_under_effective_control(e, y);
}
rule DerivedEffectiveControlPaymentMakesForeignInfluenced strict {
    effective [@2025-07-04, infinity);
    for e: Person; for y: TaxableYear; for b: Date;
    when paid_sfe_in_previous_year_under_effective_control(e, y) and us.irc.core::begins(y, b) and b > @2025-07-04;
    then foreign_influenced_entity_for_year(e, y);
}

// ============================================================================
// (a)(52)(C)(ii): critical-mineral thresholds issued by the Secretary
// ============================================================================

pub relation secretary_issued_critical_mineral_threshold(c: EligibleComponentProduction, pct: Integer, issued_on: Date) kind empirical {
    label en official "the threshold percentage the Secretary issued for the applicable critical mineral, in lieu of the percentage of clause (i)(V), with the date of issuance";
}
pub relation critical_mineral_default_threshold(c: EligibleComponentProduction, pct: Integer) kind institutional { label en unofficial "the percentage clause (i)(V) sets for the sale date (helper for the equal-or-exceed limit)"; }
rule CriticalMineralDefault0 strict { effective [@2025-07-04, infinity); for c: EligibleComponentProduction; for d: Date; when is_applicable_critical_mineral_under_45x_c6(c) and component_sold_on(c, d) and d > @2025-12-31 and d < @2030-01-01; then critical_mineral_default_threshold(c, 0); }
rule CriticalMineralDefault25 strict { effective [@2025-07-04, infinity); for c: EligibleComponentProduction; for d: Date; when is_applicable_critical_mineral_under_45x_c6(c) and component_sold_on(c, d) and d >= @2030-01-01 and d <= @2030-12-31; then critical_mineral_default_threshold(c, 25); }
rule CriticalMineralDefault30 strict { effective [@2025-07-04, infinity); for c: EligibleComponentProduction; for d: Date; when is_applicable_critical_mineral_under_45x_c6(c) and component_sold_on(c, d) and d >= @2031-01-01 and d <= @2031-12-31; then critical_mineral_default_threshold(c, 30); }
rule CriticalMineralDefault40 strict { effective [@2025-07-04, infinity); for c: EligibleComponentProduction; for d: Date; when is_applicable_critical_mineral_under_45x_c6(c) and component_sold_on(c, d) and d >= @2032-01-01 and d <= @2032-12-31; then critical_mineral_default_threshold(c, 40); }
rule CriticalMineralDefault50 strict { effective [@2025-07-04, infinity); for c: EligibleComponentProduction; for d: Date; when is_applicable_critical_mineral_under_45x_c6(c) and component_sold_on(c, d) and d > @2032-12-31; then critical_mineral_default_threshold(c, 50); }
pub relation secretary_issued_threshold_applies(c: EligibleComponentProduction, pct: Integer) kind institutional {
    label en official "the threshold percentage issued by the Secretary applies in lieu of clause (i)(V) to a component sold after it was issued, if it equals or exceeds the percentage which would otherwise apply";
}
@source(us.irc.temporal::PL119_21_S70512, coverage = partial, quote = "which shall apply in lieu of the threshold percentage determined under clause (i)(V)")
rule SecretaryIssuedThresholdApplies strict {
    effective [@2025-07-04, infinity);
    for c: EligibleComponentProduction; for pct: Integer; for issued: Date; for d: Date; for dflt: Integer;
    when secretary_issued_critical_mineral_threshold(c, pct, issued) and component_sold_on(c, d) and d > issued and critical_mineral_default_threshold(c, dflt) and pct >= dflt;
    then secretary_issued_threshold_applies(c, pct);
}
pub relation secretary_issued_threshold_applies_to_component(c: EligibleComponentProduction) kind institutional { label en unofficial "helper: an issued threshold applies to this component"; }
rule SecretaryIssuedThresholdAppliesToComponent strict { effective [@2025-07-04, infinity); for c: EligibleComponentProduction; for pct: Integer; when secretary_issued_threshold_applies(c, pct); then secretary_issued_threshold_applies_to_component(c); }
rule SecretaryIssuedThresholdIsTheThreshold defeasible {
    effective [@2025-07-04, infinity);
    for c: EligibleComponentProduction; for pct: Integer;
    when secretary_issued_threshold_applies(c, pct);
    then material_assistance_threshold_percentage_component(c, pct);
}

// ============================================================================
// (a)(52)(D)(iv): excluded existing-contract costs netted from the ratio
// ============================================================================

pub relation existing_contract_item_of_facility(i: ExistingContractCostItem, f: CleanEnergyFacility) kind empirical { label en official "the item is incorporated in the qualified facility or energy storage technology"; }
pub relation existing_contract_item_of_component(i: ExistingContractCostItem, c: EligibleComponentProduction) kind empirical { label en official "the item is used in the production of the eligible component"; }
pub relation item_direct_cost(i: ExistingContractCostItem, amount: Money) kind empirical { label en official "the direct cost (or direct material cost) to the taxpayer of the item"; }
pub relation item_direct_cost_from_prohibited_foreign_entity(i: ExistingContractCostItem, amount: Money) kind empirical { label en official "the part of the item's direct cost attributable to a prohibited foreign entity"; }
pub relation excluded_direct_costs_of_facility(f: CleanEnergyFacility, amount: Money) kind institutional { label en official "the direct costs of the facility's items whose cost the taxpayer elected to exclude"; }
@source(us.irc.temporal::PL119_21_S70512, coverage = partial, quote = "shall not be included for purposes of determining the material assistance cost ratio")
rule ExcludedDirectCostsOfFacility defeasible {
    effective [@2025-07-04, infinity);
    for f: CleanEnergyFacility; for i0: ExistingContractCostItem;
    when existing_contract_item_of_facility(i0, f) and cost_excluded_from_material_assistance_cost_ratio(i0);
    then excluded_direct_costs_of_facility(f, sum all a: Money for i: ExistingContractCostItem where existing_contract_item_of_facility(i, f) and cost_excluded_from_material_assistance_cost_ratio(i) and item_direct_cost(i, a));
}
pub relation excluded_pfe_costs_of_facility(f: CleanEnergyFacility, amount: Money) kind institutional { label en official "the part of the excluded costs attributable to a prohibited foreign entity"; }
rule ExcludedPfeCostsOfFacility defeasible {
    effective [@2025-07-04, infinity);
    for f: CleanEnergyFacility; for i0: ExistingContractCostItem;
    when existing_contract_item_of_facility(i0, f) and cost_excluded_from_material_assistance_cost_ratio(i0);
    then excluded_pfe_costs_of_facility(f, sum all a: Money for i: ExistingContractCostItem where existing_contract_item_of_facility(i, f) and cost_excluded_from_material_assistance_cost_ratio(i) and item_direct_cost_from_prohibited_foreign_entity(i, a));
}
pub relation facility_has_excluded_item(f: CleanEnergyFacility) kind institutional { label en unofficial "helper: some item of the facility is excluded"; }
rule FacilityHasExcludedItem defeasible { effective [@2025-07-04, infinity); for f: CleanEnergyFacility; for i: ExistingContractCostItem; when existing_contract_item_of_facility(i, f) and cost_excluded_from_material_assistance_cost_ratio(i); then facility_has_excluded_item(f); }
pub relation net_total_direct_costs_of_facility(f: CleanEnergyFacility, amount: Money) kind institutional { label en official "the total direct costs of the incorporated products, net of the excluded items"; }
rule NetTotalDirectCostsOfFacilityExcluded defeasible { effective [@2025-07-04, infinity); for f: CleanEnergyFacility; for t: Money; for x: Money; when total_direct_costs_of_manufactured_products_incorporated(f, t) and excluded_direct_costs_of_facility(f, x); then net_total_direct_costs_of_facility(f, t - x); }
rule NetTotalDirectCostsOfFacilityAll defeasible { effective [@2025-07-04, infinity); for f: CleanEnergyFacility; for t: Money; when total_direct_costs_of_manufactured_products_incorporated(f, t) and not_known(facility_has_excluded_item(f)); then net_total_direct_costs_of_facility(f, t); }
pub relation net_pfe_costs_of_facility(f: CleanEnergyFacility, amount: Money) kind institutional { label en official "the costs attributable to a prohibited foreign entity, net of the excluded items"; }
rule NetPfeCostsOfFacilityExcluded defeasible { effective [@2025-07-04, infinity); for f: CleanEnergyFacility; for c: Money; for x: Money; when pfe_attributed_direct_costs_facility(f, c) and excluded_pfe_costs_of_facility(f, x); then net_pfe_costs_of_facility(f, max(0 USD, c - x)); }
rule NetPfeCostsOfFacilityAll defeasible { effective [@2025-07-04, infinity); for f: CleanEnergyFacility; for c: Money; when pfe_attributed_direct_costs_facility(f, c) and not_known(facility_has_excluded_item(f)); then net_pfe_costs_of_facility(f, c); }
pub relation excluded_direct_material_costs_of_component(c: EligibleComponentProduction, amount: Money) kind institutional { label en official "the direct material costs of the component's items whose cost the taxpayer elected to exclude"; }
rule ExcludedDirectMaterialCostsOfComponent defeasible {
    effective [@2025-07-04, infinity);
    for c: EligibleComponentProduction; for i0: ExistingContractCostItem;
    when existing_contract_item_of_component(i0, c) and cost_excluded_from_material_assistance_cost_ratio(i0);
    then excluded_direct_material_costs_of_component(c, sum all a: Money for i: ExistingContractCostItem where existing_contract_item_of_component(i, c) and cost_excluded_from_material_assistance_cost_ratio(i) and item_direct_cost(i, a));
}
pub relation excluded_pfe_material_costs_of_component(c: EligibleComponentProduction, amount: Money) kind institutional { label en official "the part of the excluded material costs attributable to a prohibited foreign entity"; }
rule ExcludedPfeMaterialCostsOfComponent defeasible {
    effective [@2025-07-04, infinity);
    for c: EligibleComponentProduction; for i0: ExistingContractCostItem;
    when existing_contract_item_of_component(i0, c) and cost_excluded_from_material_assistance_cost_ratio(i0);
    then excluded_pfe_material_costs_of_component(c, sum all a: Money for i: ExistingContractCostItem where existing_contract_item_of_component(i, c) and cost_excluded_from_material_assistance_cost_ratio(i) and item_direct_cost_from_prohibited_foreign_entity(i, a));
}
pub relation component_has_excluded_item(c: EligibleComponentProduction) kind institutional { label en unofficial "helper: some item of the component is excluded"; }
rule ComponentHasExcludedItem defeasible { effective [@2025-07-04, infinity); for c: EligibleComponentProduction; for i: ExistingContractCostItem; when existing_contract_item_of_component(i, c) and cost_excluded_from_material_assistance_cost_ratio(i); then component_has_excluded_item(c); }
pub relation net_total_direct_material_costs_of_component(c: EligibleComponentProduction, amount: Money) kind institutional { label en official "the total direct material costs of the component, net of the excluded items"; }
rule NetTotalMaterialCostsOfComponentExcluded defeasible { effective [@2025-07-04, infinity); for c: EligibleComponentProduction; for t: Money; for x: Money; when total_direct_material_costs_of_eligible_component(c, t) and excluded_direct_material_costs_of_component(c, x); then net_total_direct_material_costs_of_component(c, t - x); }
rule NetTotalMaterialCostsOfComponentAll defeasible { effective [@2025-07-04, infinity); for c: EligibleComponentProduction; for t: Money; when total_direct_material_costs_of_eligible_component(c, t) and not_known(component_has_excluded_item(c)); then net_total_direct_material_costs_of_component(c, t); }
pub relation net_pfe_material_costs_of_component(c: EligibleComponentProduction, amount: Money) kind institutional { label en official "the material costs attributable to a prohibited foreign entity, net of the excluded items"; }
rule NetPfeMaterialCostsOfComponentExcluded defeasible { effective [@2025-07-04, infinity); for c: EligibleComponentProduction; for m: Money; for x: Money; when pfe_attributed_direct_material_costs_component(c, m) and excluded_pfe_material_costs_of_component(c, x); then net_pfe_material_costs_of_component(c, max(0 USD, m - x)); }
rule NetPfeMaterialCostsOfComponentAll defeasible { effective [@2025-07-04, infinity); for c: EligibleComponentProduction; for m: Money; when pfe_attributed_direct_material_costs_component(c, m) and not_known(component_has_excluded_item(c)); then net_pfe_material_costs_of_component(c, m); }

// ============================================================================
// §7704(d)(1)(E): the added-category items composed into the aggregate
// ============================================================================

pub relation ptp_income_item_amount(item: PtpIncomeItem, amount: Money) kind empirical { label en unofficial "the amount of the item of income or gain"; }
pub relation qualifying_income_from_added_categories(p: Partnership, y: TaxableYear, amount: Money) kind institutional {
    label en official "the qualifying income of the year from the categories added to section 7704(d)(1)(E) by Public Law 119-21 sec. 70524: the amounts of the qualifying items";
}
@source(us.irc.temporal::PL119_21_S70524, coverage = partial, quote = "(3) by striking “or the transportation or storage” and all that follows and inserting the following:“(ii) the transportation or storage of—“(I) any fuel described in subsection (b), (c), (d), (e), or (k) of section 6426")
rule QualifyingIncomeFromAddedCategories strict {
    effective [@2025-07-04, infinity);
    for p: Partnership; for y: TaxableYear; for i0: PtpIncomeItem;
    when ptp_income_item_of_taxable_year(i0, p, y) and qualifying_income_item_under_7704d1e_as_amended_by_pl119_21(i0);
    then qualifying_income_from_added_categories(p, y, sum all a: Money for i: PtpIncomeItem where ptp_income_item_of_taxable_year(i, p, y) and qualifying_income_item_under_7704d1e_as_amended_by_pl119_21(i) and ptp_income_item_amount(i, a));
}
pub relation added_category_income_present(p: Partnership, y: TaxableYear) kind institutional { label en unofficial "helper: some item qualifies under the added categories"; }
rule AddedCategoryIncomePresent strict { effective [@2025-07-04, infinity); for p: Partnership; for y: TaxableYear; for i: PtpIncomeItem; when ptp_income_item_of_taxable_year(i, p, y) and qualifying_income_item_under_7704d1e_as_amended_by_pl119_21(i); then added_category_income_present(p, y); }
pub relation qualifying_gross_income_including_added_categories(p: Partnership, y: TaxableYear, amount: Money) kind institutional {
    label en official "the qualifying gross income for the 90-percent test: the case's aggregate of the pre-amendment categories plus the items of the categories added by Public Law 119-21 (the asserted aggregate must not include the added items)";
}
rule QualifyingGrossIncomeWithAddedCategories strict { effective [@2025-07-04, infinity); for p: Partnership; for y: TaxableYear; for q: Money; for added: Money; when qualifying_gross_income_for_year(p, y, q) and qualifying_income_from_added_categories(p, y, added); then qualifying_gross_income_including_added_categories(p, y, q + added); }
rule QualifyingGrossIncomeWithoutAddedCategories strict { for p: Partnership; for y: TaxableYear; for q: Money; when qualifying_gross_income_for_year(p, y, q) and not_known(added_category_income_present(p, y)); then qualifying_gross_income_including_added_categories(p, y, q); }
