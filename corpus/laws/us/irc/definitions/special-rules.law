// §7701(d)-(n), (p) — stage 2: the special rules that follow the general
// definitions: (d) Puerto Rico and "possessions", (e) service contracts and
// leases, (f) anti-avoidance regulations (a duty of the Secretary), (g) FMV of
// property subject to nonrecourse debt, (h) qualified motor vehicle operating
// agreements with a terminal rental adjustment clause, (i) taxable mortgage
// pools, (j) Federal Thrift Savings Fund, (k) payments to charities on behalf
// of Federal officers, (l) multiple-party financing (regulations only), (m)
// contract-market designation, (n) conventions or associations of churches.
// (a) lead-in, (c) "includes"/"including", (p) cross-reference table: see
// the coverage rows (no executable rule; reasons recorded there).
//
// Anchor: the whole-section fragment `IRC_S7701`, quote anchors
// (DECISION-0358).
//
// DEONTICS. (f) is a duty of the Secretary (the only "shall prescribe"
// directed at an organ); (l), (e)(6), (i)(2)(D), (i)(3) are permissions to
// prescribe regulations whose content is not in the pinned text: they are
// recorded as EXTERNAL_DEPENDENCY rows, not as powers with an invented effect.
// (k)(2) "no deduction shall be allowed" is a consequence of a payment
// characterisation (a calculation-side rule), not a prohibition on a person's
// conduct; (h)(2)(D) lessor knowledge is a condition of the definition.

language "law.core" version "0.2";
package us.irc.definitions version "0.1.1";
namespace "urn:us:irc:definitions:clir";

use self::{
    GeographicArea,
    IRC_S7701,
    IRC_S7701_NOTE_6,
    Organ,
    Person,
    Property,
    Secretary,
};

// --- (d) Commonwealth of Puerto Rico ------------------------------------------
pub relation reference_to_possessions_of_united_states_applied(g: GeographicArea) kind empirical {
    label en official "references in this title to possessions of the United States";
}
pub relation is_commonwealth_of_puerto_rico(g: GeographicArea) kind empirical {
    label en official "the Commonwealth of Puerto Rico";
}
pub relation provision_distinctly_expresses_otherwise_for_possessions(g: GeographicArea) kind empirical {
    label en official "where not otherwise distinctly expressed";
}
external judgment relation PossessionReferenceManifestlyIncompatibleWithIntent(g: GeographicArea) {
    authority TaxCourt;
    label en official "manifestly incompatible with the intent thereof";
}
pub relation possession_reference_also_refers_to_puerto_rico(g: GeographicArea) kind institutional {
    label en official "references in this title to possessions of the United States shall be treated as also referring to the Commonwealth of Puerto Rico";
}
@source(IRC_S7701, relation = formalizes, coverage = exact, quote = "Where not otherwise distinctly expressed or manifestly incompatible with the intent thereof, references in this title to possessions of the United States shall be treated as also referring to the Commonwealth of Puerto Rico.")
rule PossessionsReferenceCoversPuertoRicoByDefault strict {
    for g: GeographicArea;
    when reference_to_possessions_of_united_states_applied(g) and is_commonwealth_of_puerto_rico(g)
        and not_known(provision_distinctly_expresses_otherwise_for_possessions(g))
        and not_known(PossessionReferenceManifestlyIncompatibleWithIntent(g));
    then possession_reference_also_refers_to_puerto_rico(g);
}

// --- (e) Service contracts and leases ------------------------------------------
pub entity ServiceArrangement { label en unofficial "a contract or arrangement between a service provider and a service recipient"; }
pub relation purports_to_be_service_contract(k: ServiceArrangement) kind empirical {
    label en official "a contract which purports to be a service contract";
}
pub relation service_recipient_in_physical_possession_of_property(k: ServiceArrangement) kind empirical {
    label en official "(A) the service recipient is in physical possession of the property";
}
pub relation service_recipient_controls_property(k: ServiceArrangement) kind empirical {
    label en official "(B) the service recipient controls the property";
}
pub relation service_recipient_has_significant_economic_or_possessory_interest(k: ServiceArrangement) kind empirical {
    label en official "(C) the service recipient has a significant economic or possessory interest in the property";
}
pub relation service_provider_bears_no_risk_on_nonperformance(k: ServiceArrangement) kind empirical {
    label en official "(D) the service provider does not bear any risk of substantially diminished receipts or substantially increased expenditures if there is nonperformance under the contract";
}
pub relation service_provider_does_not_use_property_concurrently_for_unrelated_entities(k: ServiceArrangement) kind empirical {
    label en official "(E) the service provider does not use the property concurrently to provide significant services to entities unrelated to the service recipient";
}
pub relation total_contract_price_does_not_substantially_exceed_rental_value(k: ServiceArrangement) kind empirical {
    label en official "(F) the total contract price does not substantially exceed the rental value of the property for the contract period";
}
// (e)(1) and (e)(2) are evaluative: "properly treated as a lease, taking into
// account all relevant factors including" the six factors above (asserted
// facts that inform the judgment, not a closed test). DECISION-0194: the
// authority is the court that decides the character of the arrangement.
external judgment relation ContractProperlyTreatedAsLeaseOfProperty(k: ServiceArrangement) {
    authority TaxCourt;
    label en official "such contract is properly treated as a lease of property, taking into account all relevant factors including whether or not the service recipient is in physical possession of the property, controls the property, has a significant economic or possessory interest, the service provider bears risk, uses the property concurrently, and the total contract price";
}
external judgment relation OtherArrangementProperlyTreatedAsLease(k: ServiceArrangement) {
    authority TaxCourt;
    label en official "such arrangement is properly treated as a lease, taking into account all relevant factors including factors similar to those set forth in paragraph (1)";
}
pub relation treated_as_lease_of_property_for_chapter_1(k: ServiceArrangement) kind institutional {
    label en official "a contract which purports to be a service contract shall be treated as a lease of property if such contract is properly treated as a lease of property; an arrangement not described in paragraph (1) shall be treated as a lease if such arrangement is properly treated as a lease";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "A contract which purports to be a service contract shall be treated as a lease of property if such contract is properly treated as a lease of property, taking into account all relevant factors including whether or not—")
rule PurportedServiceContractProperlyALeaseIsLease strict {
    for k: ServiceArrangement;
    when purports_to_be_service_contract(k) and ContractProperlyTreatedAsLeaseOfProperty(k);
    then treated_as_lease_of_property_for_chapter_1(k);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "An arrangement (including a partnership or other pass-thru entity) which is not described in paragraph (1) shall be treated as a lease if such arrangement is properly treated as a lease")
rule OtherArrangementProperlyALeaseIsLease strict {
    for k: ServiceArrangement;
    when not_known(purports_to_be_service_contract(k)) and OtherArrangementProperlyTreatedAsLease(k);
    then treated_as_lease_of_property_for_chapter_1(k);
}

// (e)(3)-(4): the safe harbour for qualified facilities.
pub entity ServiceFacility { label en unofficial "a facility that is the subject of a service arrangement"; }
pub relation arrangement_concerns_facility(k: ServiceArrangement, f: ServiceFacility) kind empirical {
    label en unofficial "the arrangement is with respect to this facility";
}
pub relation arrangement_is_for_operation_of_facility(k: ServiceArrangement) kind empirical {
    label en official "the operation of a qualified solid waste disposal facility, the operation of a water treatment works facility, or the operation of a storage facility";
}
pub relation arrangement_is_for_sale_of_energy_produced_at_facility(k: ServiceArrangement) kind empirical {
    label en official "the sale to the service recipient of electrical or thermal energy produced at a cogeneration or alternative energy facility";
}
// (e)(3)(B)-(F) facility definitions.
pub relation provides_solid_waste_disposal_services_for_residents_of_governmental_units(f: ServiceFacility) kind empirical {
    label en official "such facility provides solid waste disposal services for residents of part or all of 1 or more governmental units";
}
external judgment relation SubstantiallyAllSolidWasteCollectedFromGeneralPublic(f: ServiceFacility) {
    authority TaxCourt;
    label en official "substantially all of the solid waste processed at such facility is collected from the general public";
}
pub relation qualified_solid_waste_disposal_facility(f: ServiceFacility) kind institutional {
    label en official "the term \"qualified solid waste disposal facility\" means any facility if such facility provides solid waste disposal services for residents of part or all of 1 or more governmental units and substantially all of the solid waste processed at such facility is collected from the general public";
}
@source(IRC_S7701, relation = formalizes, coverage = exact, quote = "the term \"qualified solid waste disposal facility\" means any facility if such facility provides solid waste disposal services for residents of part or all of 1 or more governmental units and substantially all of the solid waste processed at such facility is collected from the general public.")
rule FacilityServingGovernmentalUnitsWithPublicWasteIsQualifiedSolidWasteFacility strict {
    for f: ServiceFacility;
    when provides_solid_waste_disposal_services_for_residents_of_governmental_units(f) and SubstantiallyAllSolidWasteCollectedFromGeneralPublic(f);
    then qualified_solid_waste_disposal_facility(f);
}
pub relation uses_same_energy_source_for_sequential_generation_of_power_with_useful_energy(f: ServiceFacility) kind empirical {
    label en official "a facility which uses the same energy source for the sequential generation of electrical or mechanical power in combination with steam, heat, or other forms of useful energy";
}
pub relation cogeneration_facility(f: ServiceFacility) kind institutional {
    label en official "the term \"cogeneration facility\" means a facility which uses the same energy source for the sequential generation of electrical or mechanical power in combination with steam, heat, or other forms of useful energy";
}
@source(IRC_S7701, relation = formalizes, coverage = exact, quote = "the term \"cogeneration facility\" means a facility which uses the same energy source for the sequential generation of electrical or mechanical power in combination with steam, heat, or other forms of useful energy.")
rule SequentialSameSourceGenerationIsCogeneration strict {
    for f: ServiceFacility;
    when uses_same_energy_source_for_sequential_generation_of_power_with_useful_energy(f);
    then cogeneration_facility(f);
}
pub relation produces_electrical_or_thermal_energy(f: ServiceFacility) kind empirical {
    label en official "a facility for producing electrical or thermal energy";
}
pub relation primary_energy_source_is_oil(f: ServiceFacility) kind empirical {
    label en official "the primary energy source for the facility is oil";
}
pub relation primary_energy_source_is_natural_gas(f: ServiceFacility) kind empirical {
    label en official "the primary energy source for the facility is natural gas";
}
pub relation primary_energy_source_is_coal(f: ServiceFacility) kind empirical {
    label en official "the primary energy source for the facility is coal";
}
pub relation primary_energy_source_is_nuclear_power(f: ServiceFacility) kind empirical {
    label en official "the primary energy source for the facility is nuclear power";
}
pub relation alternative_energy_facility(f: ServiceFacility) kind institutional {
    label en official "the term \"alternative energy facility\" means a facility for producing electrical or thermal energy if the primary energy source for the facility is not oil, natural gas, coal, or nuclear power";
}
@source(IRC_S7701, relation = formalizes, coverage = exact, quote = "the term \"alternative energy facility\" means a facility for producing electrical or thermal energy if the primary energy source for the facility is not oil, natural gas, coal, or nuclear power.")
rule EnergyFacilityWithoutFossilOrNuclearPrimarySourceIsAlternative strict {
    for f: ServiceFacility;
    when produces_electrical_or_thermal_energy(f)
        and not_known(primary_energy_source_is_oil(f)) and not_known(primary_energy_source_is_natural_gas(f))
        and not_known(primary_energy_source_is_coal(f)) and not_known(primary_energy_source_is_nuclear_power(f));
    then alternative_energy_facility(f);
}
pub relation treatment_works_within_meaning_of_fwpca_section_212_2(f: ServiceFacility) kind empirical {
    label en official "any treatment works within the meaning of section 212(2) of the Federal Water Pollution Control Act";
}
pub relation water_treatment_works_facility(f: ServiceFacility) kind institutional {
    label en official "the term \"water treatment works facility\" means any treatment works within the meaning of section 212(2) of the Federal Water Pollution Control Act";
}
@source(IRC_S7701, relation = formalizes, coverage = exact, quote = "the term \"water treatment works facility\" means any treatment works within the meaning of section 212(2) of the Federal Water Pollution Control Act.")
rule TreatmentWorksUnderFwpca212IsWaterTreatmentWorksFacility strict {
    for f: ServiceFacility;
    when treatment_works_within_meaning_of_fwpca_section_212_2(f);
    then water_treatment_works_facility(f);
}
pub relation uses_energy_storage_technology_within_meaning_of_48c6(f: ServiceFacility) kind empirical {
    label en official "a facility which uses energy storage technology within the meaning of section 48(c)(6)";
}
pub relation storage_facility(f: ServiceFacility) kind institutional {
    label en official "the term \"storage facility\" means a facility which uses energy storage technology within the meaning of section 48(c)(6)";
}
@source(IRC_S7701, relation = formalizes, coverage = exact, quote = "the term \"storage facility\" means a facility which uses energy storage technology within the meaning of section 48(c)(6).")
rule EnergyStorageTechnologyFacilityIsStorageFacility strict {
    for f: ServiceFacility;
    when uses_energy_storage_technology_within_meaning_of_48c6(f);
    then storage_facility(f);
}
// (e)(3)(A) categories of arrangement over these facilities.
pub relation arrangement_within_paragraph_3_categories(k: ServiceArrangement) kind institutional {
    label en official "any contract or arrangement between a service provider and a service recipient with respect to the operation of a qualified solid waste disposal facility, the sale to the service recipient of electrical or thermal energy produced at a cogeneration or alternative energy facility, the operation of a water treatment works facility, or the operation of a storage facility";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "(I) the operation of a qualified solid waste disposal facility,")
rule OperationOfQualifiedSolidWasteFacilityIsWithinCategories strict {
    for k: ServiceArrangement; for f: ServiceFacility;
    when arrangement_concerns_facility(k, f) and arrangement_is_for_operation_of_facility(k) and qualified_solid_waste_disposal_facility(f);
    then arrangement_within_paragraph_3_categories(k);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "(II) the sale to the service recipient of electrical or thermal energy produced at a cogeneration or alternative energy facility,")
rule SaleOfCogenerationEnergyIsWithinCategories strict {
    for k: ServiceArrangement; for f: ServiceFacility;
    when arrangement_concerns_facility(k, f) and arrangement_is_for_sale_of_energy_produced_at_facility(k) and cogeneration_facility(f);
    then arrangement_within_paragraph_3_categories(k);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "(II) the sale to the service recipient of electrical or thermal energy produced at a cogeneration or alternative energy facility,")
rule SaleOfAlternativeEnergyIsWithinCategories strict {
    for k: ServiceArrangement; for f: ServiceFacility;
    when arrangement_concerns_facility(k, f) and arrangement_is_for_sale_of_energy_produced_at_facility(k) and alternative_energy_facility(f);
    then arrangement_within_paragraph_3_categories(k);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "(III) the operation of a water treatment works facility, or")
rule OperationOfWaterTreatmentWorksIsWithinCategories strict {
    for k: ServiceArrangement; for f: ServiceFacility;
    when arrangement_concerns_facility(k, f) and arrangement_is_for_operation_of_facility(k) and water_treatment_works_facility(f);
    then arrangement_within_paragraph_3_categories(k);
}
// Category (IV) (storage facility) was added by Pub. L. 117-169 (Inflation Reduction Act of 2022):
// "Amendment by Pub. L. 117-169 applicable to property placed in service after Dec. 31, 2022"
// (statutory note 6 of section 7701); earlier property is outside the category.
pub relation facility_property_placed_in_service_on(f: ServiceFacility, d: Date) kind empirical {
    label en official "property placed in service";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "(IV) the operation of a storage facility, and")
@source(IRC_S7701_NOTE_6, relation = formalizes, coverage = partial, quote = "Amendment by Pub. L. 117–169 applicable to property placed in service after Dec. 31, 2022")
rule OperationOfStorageFacilityIsWithinCategories strict {
    for k: ServiceArrangement; for f: ServiceFacility; for d: Date;
    when arrangement_concerns_facility(k, f) and arrangement_is_for_operation_of_facility(k) and storage_facility(f)
        and facility_property_placed_in_service_on(f, d) and d > @2022-12-31;
    then arrangement_within_paragraph_3_categories(k);
}
// (e)(4)(A) exceptions with the (B) and (C) items disregarded.
pub relation service_recipient_or_related_entity_operates_facility(k: ServiceArrangement) kind empirical {
    label en official "the service recipient (or a related entity) operates such facility (\"related entity\" having the same meaning as when used in section 168(h))";
}
pub relation recipient_bears_significant_financial_burden_on_nonperformance(k: ServiceArrangement) kind empirical {
    label en official "the service recipient (or a related entity) bears any significant financial burden if there is nonperformance under the contract or arrangement (other than for reasons beyond the control of the service provider)";
}
pub relation recipient_receives_significant_financial_benefit_if_operating_costs_below_standards(k: ServiceArrangement) kind empirical {
    label en official "the service recipient (or a related entity) receives any significant financial benefit if the operating costs of such facility are less than the standards of performance or operation under the contract or arrangement";
}
pub relation recipient_has_option_or_obligation_to_purchase_facility_at_fixed_price_other_than_fmv(k: ServiceArrangement) kind empirical {
    label en official "the service recipient (or a related entity) has an option to purchase, or may be required to purchase, all or a part of such facility at a fixed and determinable price (other than for fair market value)";
}
pub relation burden_only_from_temporary_shutdown_bankruptcy_or_change_in_law_allocation(k: ServiceArrangement) kind empirical {
    label en official "the burden arises only from items not taken into account: any right of a service recipient to inspect any facility, to exercise any sovereign power the service recipient may possess, or to act in the event of a breach of contract by the service provider; any allocation of any financial burden or benefits in the event of any change in any law; any temporary shut-down of the facility for repairs, maintenance, or capital improvements; any financial burden caused by the bankruptcy or similar financial difficulty of the service provider";
}
pub relation benefit_only_from_decreased_payments_by_increased_production_or_efficiency(k: ServiceArrangement) kind empirical {
    label en official "the benefit arises only from items not taken into account: any significant financial benefit merely because payments by the service recipient under the contract or arrangement are decreased by reason of increased production or efficiency or the recovery of energy or other products; any allocation of financial benefits in the event of any change in any law; any right of the service recipient to inspect any facility, to exercise any sovereign power, or to act in the event of a breach of contract by the service provider";
}
pub relation exception_to_paragraph_3_applies(k: ServiceArrangement) kind institutional {
    label en official "paragraph (3) shall not apply to any qualified solid waste disposal facility, cogeneration facility, alternative energy facility, water treatment works facility, or storage facility used under a contract or arrangement if (i) the service recipient operates the facility, (ii) bears a significant financial burden, (iii) receives a significant financial benefit, or (iv) has a purchase option or obligation at a fixed price other than fair market value";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "(i) the service recipient (or a related entity) operates such facility,")
rule RecipientOperatingFacilityDisablesParagraph3 strict {
    for k: ServiceArrangement;
    when service_recipient_or_related_entity_operates_facility(k);
    then exception_to_paragraph_3_applies(k);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "(ii) the service recipient (or a related entity) bears any significant financial burden if there is nonperformance under the contract or arrangement (other than for reasons beyond the control of the service provider),")
rule RecipientFinancialBurdenDisablesParagraph3 strict {
    for k: ServiceArrangement;
    when recipient_bears_significant_financial_burden_on_nonperformance(k)
        and not_known(burden_only_from_temporary_shutdown_bankruptcy_or_change_in_law_allocation(k));
    then exception_to_paragraph_3_applies(k);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "(iii) the service recipient (or a related entity) receives any significant financial benefit if the operating costs of such facility are less than the standards of performance or operation under the contract or arrangement, or")
rule RecipientFinancialBenefitDisablesParagraph3 strict {
    for k: ServiceArrangement;
    when recipient_receives_significant_financial_benefit_if_operating_costs_below_standards(k)
        and not_known(benefit_only_from_decreased_payments_by_increased_production_or_efficiency(k));
    then exception_to_paragraph_3_applies(k);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "(iv) the service recipient (or a related entity) has an option to purchase, or may be required to purchase, all or a part of such facility at a fixed and determinable price (other than for fair market value).")
rule RecipientPurchaseOptionAtFixedPriceDisablesParagraph3 strict {
    for k: ServiceArrangement;
    when recipient_has_option_or_obligation_to_purchase_facility_at_fixed_price_other_than_fmv(k);
    then exception_to_paragraph_3_applies(k);
}
pub relation treated_as_service_contract_under_paragraph_3(k: ServiceArrangement) kind institutional {
    label en official "notwithstanding paragraphs (1) and (2), and except as provided in paragraph (4), any such contract or arrangement which purports to be a service contract shall be treated as a service contract";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "Notwithstanding paragraphs (1) and (2), and except as provided in paragraph (4), any contract or arrangement between a service provider and a service recipient—")
rule QualifiedFacilityArrangementPurportingServiceIsServiceContract strict {
    for k: ServiceArrangement;
    when arrangement_within_paragraph_3_categories(k) and purports_to_be_service_contract(k)
        and not_known(exception_to_paragraph_3_applies(k));
    then treated_as_service_contract_under_paragraph_3(k);
}
// (e)(5): low-income housing carve-out.
pub entity LowIncomeHousingProperty { label en unofficial "property described in clause (i), (ii), (iii), or (iv) of section 1250(a)(1)(B)"; }
pub relation operated_by_or_for_501c3_or_501c4_organization(pr: LowIncomeHousingProperty) kind empirical {
    label en official "such property is operated by or for an organization described in paragraph (3) or (4) of section 501(c)";
}
pub relation number_of_units_leased_to_low_income_tenants(pr: LowIncomeHousingProperty, n: Integer) kind empirical {
    label en official "units in such property leased to low-income tenants (within the meaning of section 167(k)(3)(B)) (as in effect on the day before the date of the enactment of the Revenue Reconciliation Act of 1990)";
}
pub relation total_number_of_units(pr: LowIncomeHousingProperty, n: Integer) kind empirical {
    label en unofficial "total units in the property";
}
pub relation subsection_e_does_not_apply_to_property(pr: LowIncomeHousingProperty) kind institutional {
    label en official "this subsection shall not apply to any property described in clause (i), (ii), (iii), or (iv) of section 1250(a)(1)(B) (relating to low-income housing) if the property is operated by or for a section 501(c)(3) or (4) organization and at least 80 percent of the units are leased to low-income tenants";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "(B) at least 80 percent of the units in such property are leased to low-income tenants")
rule LowIncomeHousingOperatedByExemptOrganizationWithEightyPercentUnitsIsCarvedOut strict {
    for pr: LowIncomeHousingProperty; for a: Integer; for b: Integer;
    when operated_by_or_for_501c3_or_501c4_organization(pr) and number_of_units_leased_to_low_income_tenants(pr, a)
        and total_number_of_units(pr, b) and a * 100 >= b * 80;
    then subsection_e_does_not_apply_to_property(pr);
}

// --- (f) Anti-avoidance regulations: a duty of the Secretary ----------------------
pub relation prescribes_regulations_preventing_avoidance_through_related_persons_or_intermediaries(o: Organ) kind empirical {
    label en official "such regulations as may be necessary or appropriate to prevent the avoidance of those provisions of this title which deal with the linking of borrowing to investment, or diminishing risks, through the use of related persons, pass-thru entities, or other intermediaries";
}
@source(IRC_S7701, relation = formalizes, coverage = exact, quote = "The Secretary shall prescribe such regulations as may be necessary or appropriate to prevent the avoidance of those provisions of this title which deal with—")
rule S7701fSecretaryShallPrescribeAntiAvoidanceRegulations strict {
    when true;
    then duty PrescribeAntiAvoidanceRegulationsForBorrowingAndRiskProvisions {
        bearer Secretary;
        goal achievement {
            condition prescribes_regulations_preventing_avoidance_through_related_persons_or_intermediaries(Secretary);
            window [-infinity, infinity];
        }
    };
}

// --- (g) Fair market value of property subject to nonrecourse indebtedness -------
pub relation gain_or_loss_determined_for_subtitle_a(pr: Property) kind empirical {
    label en official "for purposes of subtitle A, in determining the amount of gain or loss (or deemed gain or loss) with respect to any property";
}
pub relation actual_fair_market_value_of_property(pr: Property, amount: Money) kind empirical {
    label en unofficial "the fair market value of the property apart from the (g) floor";
}
pub relation nonrecourse_indebtedness_to_which_property_is_subject(pr: Property, amount: Money) kind empirical {
    label en official "the amount of any nonrecourse indebtedness to which such property is subject";
}
pub relation fair_market_value_treated_for_gain_or_loss(pr: Property, amount: Money) kind institutional {
    label en official "the fair market value of such property shall be treated as being not less than the amount of any nonrecourse indebtedness to which such property is subject";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "the fair market value of such property shall be treated as being not less than the amount of any nonrecourse indebtedness to which such property is subject")
rule FairMarketValueAtOrAboveNonrecourseDebtStands strict {
    for pr: Property; for v: Money; for d: Money;
    when gain_or_loss_determined_for_subtitle_a(pr) and actual_fair_market_value_of_property(pr, v)
        and nonrecourse_indebtedness_to_which_property_is_subject(pr, d) and v >= d;
    then fair_market_value_treated_for_gain_or_loss(pr, v);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "the fair market value of such property shall be treated as being not less than the amount of any nonrecourse indebtedness to which such property is subject")
rule FairMarketValueBelowNonrecourseDebtIsRaisedToDebt strict {
    for pr: Property; for v: Money; for d: Money;
    when gain_or_loss_determined_for_subtitle_a(pr) and actual_fair_market_value_of_property(pr, v)
        and nonrecourse_indebtedness_to_which_property_is_subject(pr, d) and v < d;
    then fair_market_value_treated_for_gain_or_loss(pr, d);
}

// --- (h) Motor vehicle operating agreements with terminal rental adjustment ---------
pub entity MotorVehicleAgreement { label en unofficial "an agreement with respect to a motor vehicle (including a trailer)"; }
pub relation agreement_lease_but_for_terminal_rental_adjustment_clause(a: MotorVehicleAgreement) kind empirical {
    label en official "but for such terminal rental adjustment clause such agreement would be treated as a lease under this title";
}
pub relation rental_price_adjusted_by_reference_to_amount_realized_on_disposition(a: MotorVehicleAgreement) kind empirical {
    label en official "a provision of an agreement which permits or requires the rental price to be adjusted upward or downward by reference to the amount realized by the lessor under the agreement upon sale or other disposition of such property";
}
pub relation dealer_lessee_must_purchase_and_resell_for_predetermined_price(a: MotorVehicleAgreement) kind empirical {
    label en official "a provision of an agreement which requires a lessee who is a dealer in motor vehicles to purchase the motor vehicle for a predetermined price and then resell such vehicle";
}
external judgment relation DealerProvisionAchievesSubstantiallySameResults(a: MotorVehicleAgreement) {
    authority TaxCourt;
    label en official "where such provision achieves substantially the same results as a provision described in subparagraph (A)";
}
pub relation contains_terminal_rental_adjustment_clause(a: MotorVehicleAgreement) kind institutional {
    label en official "the term \"terminal rental adjustment clause\" means a provision of an agreement which permits or requires the rental price to be adjusted upward or downward by reference to the amount realized by the lessor under the agreement upon sale or other disposition of such property; it also includes a dealer purchase-and-resell provision achieving substantially the same results";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "For purposes of this subsection, the term \"terminal rental adjustment clause\" means a provision of an agreement which permits or requires the rental price to be adjusted upward or downward by reference to the amount realized by the lessor under the agreement upon sale or other disposition of such property.")
rule PriceAdjustmentByAmountRealizedIsTerminalRentalAdjustmentClause strict {
    for a: MotorVehicleAgreement;
    when rental_price_adjusted_by_reference_to_amount_realized_on_disposition(a);
    then contains_terminal_rental_adjustment_clause(a);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"terminal rental adjustment clause\" also includes a provision of an agreement which requires a lessee who is a dealer in motor vehicles to purchase the motor vehicle for a predetermined price and then resell such vehicle where such provision achieves substantially the same results as a provision described in subparagraph (A).")
rule DealerRepurchaseWithSameResultsIsTerminalRentalAdjustmentClause strict {
    for a: MotorVehicleAgreement;
    when dealer_lessee_must_purchase_and_resell_for_predetermined_price(a) and DealerProvisionAchievesSubstantiallySameResults(a);
    then contains_terminal_rental_adjustment_clause(a);
}
pub relation lessor_personally_liable_amount(a: MotorVehicleAgreement, amount: Money) kind empirical {
    label en official "the amount the lessor is personally liable to repay";
}
pub relation net_fair_market_value_of_lessor_interest_in_pledged_security(a: MotorVehicleAgreement, amount: Money) kind empirical {
    label en official "the net fair market value of the lessor's interest in any property pledged as security for property subject to the agreement (not counting the property subject to the agreement or property financed by indebtedness secured by it)";
}
pub relation amounts_borrowed_to_finance_acquisition_of_agreement_property(a: MotorVehicleAgreement, amount: Money) kind empirical {
    label en official "all amounts borrowed to finance the acquisition of property subject to the agreement";
}
pub relation meets_lessor_liability_requirement_of_h2b(a: MotorVehicleAgreement) kind institutional {
    label en official "an agreement meets the requirements of this subparagraph if the sum of the amount the lessor is personally liable to repay and the net fair market value of the lessor's interest in pledged property equals or exceeds all amounts borrowed to finance the acquisition of property subject to the agreement";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "equals or exceeds all amounts borrowed to finance the acquisition of property subject to the agreement.")
rule LessorLiabilityPlusSecurityCoversBorrowing strict {
    for a: MotorVehicleAgreement; for l: Money; for s: Money; for b: Money;
    when lessor_personally_liable_amount(a, l) and net_fair_market_value_of_lessor_interest_in_pledged_security(a, s)
        and amounts_borrowed_to_finance_acquisition_of_agreement_property(a, b) and l + s >= b;
    then meets_lessor_liability_requirement_of_h2b(a);
}
pub relation has_separate_written_statement_separately_signed_by_lessee(a: MotorVehicleAgreement) kind empirical {
    label en official "such agreement contains a separate written statement separately signed by the lessee";
}
pub relation lessee_certifies_under_penalty_of_perjury_more_than_half_business_use(a: MotorVehicleAgreement) kind empirical {
    label en official "the lessee certifies, under penalty of perjury, that it intends that more than 50 percent of the use of the property subject to such agreement is to be in a trade or business of the lessee";
}
pub relation statement_clearly_advises_lessee_not_treated_as_owner(a: MotorVehicleAgreement) kind empirical {
    label en official "which clearly and legibly states that the lessee has been advised that it will not be treated as the owner of the property subject to the agreement for Federal income tax purposes";
}
pub relation lessor_knows_lessee_certification_is_false(a: MotorVehicleAgreement) kind empirical {
    label en official "the lessor knows that the certification described in subparagraph (C)(i) is false";
}
pub relation meets_lessee_statement_requirement_of_h2c(a: MotorVehicleAgreement) kind institutional {
    label en official "an agreement meets the requirements of this subparagraph if such agreement contains a separate written statement separately signed by the lessee certifying more than 50 percent business use and clearly stating that the lessee has been advised it will not be treated as the owner";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "An agreement meets the requirements of this subparagraph if such agreement contains a separate written statement separately signed by the lessee—")
rule SignedStatementWithCertificationAndAdviceMeetsH2c strict {
    for a: MotorVehicleAgreement;
    when has_separate_written_statement_separately_signed_by_lessee(a)
        and lessee_certifies_under_penalty_of_perjury_more_than_half_business_use(a)
        and statement_clearly_advises_lessee_not_treated_as_owner(a);
    then meets_lessee_statement_requirement_of_h2c(a);
}
pub relation qualified_motor_vehicle_operating_agreement(a: MotorVehicleAgreement) kind institutional {
    label en official "the term \"qualified motor vehicle operating agreement\" means any agreement with respect to a motor vehicle (including a trailer) which meets the requirements of subparagraphs (B), (C), and (D)";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "An agreement meets the requirements of this subparagraph if the lessor does not know that the certification described in subparagraph (C)(i) is false.")
rule AgreementMeetingBCAndDIsQualifiedMotorVehicleOperatingAgreement strict {
    for a: MotorVehicleAgreement;
    when meets_lessor_liability_requirement_of_h2b(a) and meets_lessee_statement_requirement_of_h2c(a)
        and not_known(lessor_knows_lessee_certification_is_false(a));
    then qualified_motor_vehicle_operating_agreement(a);
}
pub relation treated_as_lease_despite_terminal_rental_adjustment_clause(a: MotorVehicleAgreement) kind institutional {
    label en official "such agreement shall be treated as a lease if (but for such terminal rental adjustment clause) such agreement would be treated as a lease under this title";
}
pub relation lessee_not_treated_as_owner_of_agreement_property(a: MotorVehicleAgreement) kind institutional {
    label en official "the lessee shall not be treated as the owner of the property subject to an agreement during any period such agreement is in effect";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "(A) such agreement shall be treated as a lease if (but for such terminal rental adjustment clause) such agreement would be treated as a lease under this title, and")
rule TracAgreementIsLeaseIfLeaseButForClause strict {
    for a: MotorVehicleAgreement;
    when qualified_motor_vehicle_operating_agreement(a) and contains_terminal_rental_adjustment_clause(a)
        and agreement_lease_but_for_terminal_rental_adjustment_clause(a);
    then treated_as_lease_despite_terminal_rental_adjustment_clause(a);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "(B) the lessee shall not be treated as the owner of the property subject to an agreement during any period such agreement is in effect.")
rule TracAgreementLesseeIsNotOwner strict {
    for a: MotorVehicleAgreement;
    when qualified_motor_vehicle_operating_agreement(a) and contains_terminal_rental_adjustment_clause(a);
    then lessee_not_treated_as_owner_of_agreement_property(a);
}

// --- (i) Taxable mortgage pools ------------------------------------------------------
pub entity MortgageEntityCandidate : Person { label en unofficial "an entity (or a portion of an entity) tested under (i)(2)"; }
pub relation entity_is_a_remic(e: MortgageEntityCandidate) kind empirical {
    label en official "any entity (other than a REMIC)";
}
external judgment relation SubstantiallyAllAssetsAreDebtObligations(e: MortgageEntityCandidate) {
    authority TaxCourt;
    label en official "substantially all of the assets of such entity consists of debt obligations (or interests therein)";
}
pub relation amount_of_debt_obligations_held(e: MortgageEntityCandidate, amount: Money) kind empirical {
    label en unofficial "the amount of the entity's debt obligations (or interests therein)";
}
pub relation amount_of_real_estate_mortgages_held(e: MortgageEntityCandidate, amount: Money) kind empirical {
    label en unofficial "the amount of those debt obligations (or interests) that consists of real estate mortgages (or interests therein)";
}
pub relation more_than_half_of_debt_obligations_are_real_estate_mortgages(e: MortgageEntityCandidate) kind institutional {
    label en official "more than 50 percent of such debt obligations (or interests) consists of real estate mortgages (or interests therein)";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "more than 50 percent of such debt obligations (or interests) consists of real estate mortgages (or interests therein),")
rule MortgageShareAboveFiftyPercentByAmount strict {
    for e: MortgageEntityCandidate; for m: Money; for d: Money;
    when amount_of_real_estate_mortgages_held(e, m) and amount_of_debt_obligations_held(e, d) and m * 100 > d * 50;
    then more_than_half_of_debt_obligations_are_real_estate_mortgages(e);
}
pub relation number_of_maturities_of_debt_obligations_of_which_entity_is_obligor(e: MortgageEntityCandidate, n: Integer) kind empirical {
    label en official "such entity is the obligor under debt obligations with 2 or more maturities";
}
pub relation payments_on_entity_debt_bear_relationship_to_payments_on_held_debt(e: MortgageEntityCandidate) kind empirical {
    label en official "under the terms of the debt obligations referred to in clause (ii) (or underlying arrangement), payments on such debt obligations bear a relationship to payments on the debt obligations (or interests) referred to in clause (i)";
}
pub relation entity_is_domestic_building_and_loan_association_or_portion(e: MortgageEntityCandidate) kind empirical {
    label en official "any domestic building and loan association (or portion thereof)";
}
pub relation portion_of_entity_meets_taxable_mortgage_pool_definition(e: MortgageEntityCandidate) kind empirical {
    label en official "any portion of an entity which meets the definition of subparagraph (A)";
}
pub relation taxable_mortgage_pool(e: MortgageEntityCandidate) kind institutional {
    label en official "a taxable mortgage pool is any entity (other than a REMIC) if (i) substantially all of its assets consist of debt obligations and more than 50 percent of them real estate mortgages, (ii) it is the obligor under debt obligations with 2 or more maturities, and (iii) payments on those debt obligations bear a relationship to payments on the debt obligations it holds";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "Except as otherwise provided in this paragraph, a taxable mortgage pool is any entity (other than a REMIC) if—")
rule EntityMeetingThreeClausesIsTaxableMortgagePool strict {
    for e: MortgageEntityCandidate; for n: Integer;
    when SubstantiallyAllAssetsAreDebtObligations(e) and more_than_half_of_debt_obligations_are_real_estate_mortgages(e)
        and number_of_maturities_of_debt_obligations_of_which_entity_is_obligor(e, n) and n >= 2
        and payments_on_entity_debt_bear_relationship_to_payments_on_held_debt(e)
        and not_known(entity_is_a_remic(e))
        and not_known(entity_is_domestic_building_and_loan_association_or_portion(e));
    then taxable_mortgage_pool(e);
}
@source(IRC_S7701, relation = formalizes, coverage = exact, quote = "Any portion of an entity which meets the definition of subparagraph (A) shall be treated as a taxable mortgage pool.")
rule PortionMeetingDefinitionIsTaxableMortgagePool strict {
    for e: MortgageEntityCandidate;
    when portion_of_entity_meets_taxable_mortgage_pool_definition(e)
        and not_known(entity_is_domestic_building_and_loan_association_or_portion(e));
    then taxable_mortgage_pool(e);
}
pub relation treated_as_separate_corporation_for_tax_purposes(e: MortgageEntityCandidate) kind institutional {
    label en official "a taxable mortgage pool shall be treated as a separate corporation";
}
pub relation not_includible_corporation_with_any_other_corporation_for_1501(e: MortgageEntityCandidate) kind institutional {
    label en official "which may not be treated as an includible corporation with any other corporation for purposes of section 1501";
}
@source(IRC_S7701, relation = formalizes, coverage = exact, quote = "A taxable mortgage pool shall be treated as a separate corporation which may not be treated as an includible corporation with any other corporation for purposes of section 1501.")
rule TaxableMortgagePoolIsSeparateCorporation strict {
    for e: MortgageEntityCandidate;
    when taxable_mortgage_pool(e);
    then treated_as_separate_corporation_for_tax_purposes(e);
}
@source(IRC_S7701, relation = formalizes, coverage = exact, quote = "A taxable mortgage pool shall be treated as a separate corporation which may not be treated as an includible corporation with any other corporation for purposes of section 1501.")
rule TaxableMortgagePoolIsNotIncludibleCorporation strict {
    for e: MortgageEntityCandidate;
    when taxable_mortgage_pool(e);
    then not_includible_corporation_with_any_other_corporation_for_1501(e);
}

// --- (j) Federal Thrift Savings Fund ---------------------------------------------------
pub const ThriftSavingsFund: Person = entity_ref("urn:us:irc:definitions:clir#thrift-savings-fund") {
    label en official "the Thrift Savings Fund (subchapter III of chapter 84 of title 5, United States Code)";
}
pub relation thrift_savings_fund_treated_as_exempt_trust_described_in_401a(f: Person) kind institutional {
    label en official "the Thrift Savings Fund shall be treated as a trust described in section 401(a) which is exempt from taxation under section 501(a)";
}
@source(IRC_S7701, relation = formalizes, coverage = exact, quote = "(A) the Thrift Savings Fund shall be treated as a trust described in section 401(a) which is exempt from taxation under section 501(a);")
rule ThriftSavingsFundIsExemptTrust strict {
    when true;
    then thrift_savings_fund_treated_as_exempt_trust_described_in_401a(ThriftSavingsFund);
}
pub relation contribution_to_or_distribution_from_thrift_savings_fund(t: us.irc.core::Transaction) kind empirical {
    label en official "any contribution to, or distribution from, the Thrift Savings Fund";
}
pub relation treated_as_contribution_to_or_distribution_from_401a_trust(t: us.irc.core::Transaction) kind institutional {
    label en official "any contribution to, or distribution from, the Thrift Savings Fund shall be treated in the same manner as contributions to or distributions from such a trust";
}
@source(IRC_S7701, relation = formalizes, coverage = exact, quote = "(B) any contribution to, or distribution from, the Thrift Savings Fund shall be treated in the same manner as contributions to or distributions from such a trust; and")
rule ThriftSavingsFundFlowsFollowSection401aTrust strict {
    for t: us.irc.core::Transaction;
    when contribution_to_or_distribution_from_thrift_savings_fund(t);
    then treated_as_contribution_to_or_distribution_from_401a_trust(t);
}
pub relation contribution_subject_to_election_between_cash_and_fund_contribution_under_title_5(t: us.irc.core::Transaction) kind empirical {
    label en official "the employee or Member has, under the provisions of subchapter III of chapter 84 of title 5, United States Code, and section 8351 of such title 5, an election whether the contribution will be made to the Thrift Savings Fund or received by the employee or Member in cash";
}
pub relation not_treated_as_distributed_or_made_available_and_not_as_employee_contribution(t: us.irc.core::Transaction) kind institutional {
    label en official "contributions to the Thrift Savings Fund shall not be treated as distributed or made available to an employee or Member nor as a contribution made to the Fund by an employee or Member merely because of such an election (subject to section 401(k)(4)(B) and any dollar limitation on the application of section 402(e)(3))";
}
pub relation thrift_elective_contribution_amount(t: us.irc.core::Transaction, amount: Money) kind empirical {
    label en official "the amount of the elective contribution to the Thrift Savings Fund (stage 3b: asserted)";
}
pub relation dollar_limitation_on_application_of_402e3(t: us.irc.core::Transaction, limit: Money) kind empirical {
    label en official "the dollar limitation on the application of section 402(e)(3) that applies to the contribution (owner: deferred-compensation; asserted here because that package imports this one)";
}
pub relation thrift_contribution_exceeds_402e3_dollar_limitation(t: us.irc.core::Transaction, excess: Money) kind institutional {
    label en official "the part of the elective contribution above the dollar limitation on the application of section 402(e)(3)";
}
rule ThriftContributionAboveDollarLimitationHasExcess strict {
    for t: us.irc.core::Transaction;
    for amount: Money;
    for limit: Money;
    when thrift_elective_contribution_amount(t, amount) and dollar_limitation_on_application_of_402e3(t, limit) and amount > limit;
    then thrift_contribution_exceeds_402e3_dollar_limitation(t, amount - limit);
}
pub relation thrift_contribution_over_dollar_limitation(t: us.irc.core::Transaction) kind institutional { label en unofficial "helper: the elective contribution exceeds the dollar limitation"; }
rule ThriftContributionOverDollarLimitationStated strict { for t: us.irc.core::Transaction; for x: Money; when thrift_contribution_exceeds_402e3_dollar_limitation(t, x); then thrift_contribution_over_dollar_limitation(t); }
pub relation thrift_contribution_barred_by_401k4B(t: us.irc.core::Transaction) kind empirical {
    label en official "the contribution does not satisfy section 401(k)(4)(B) (asserted: the section 401(k)(4)(B) condition is owned by deferred-compensation)";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "(C) subject to section 401(k)(4)(B) and any dollar limitation on the application of section 402(e)(3), contributions to the Thrift Savings Fund shall not be treated as distributed or made available to an employee or Member")
rule ElectiveThriftContributionIsNotConstructiveDistribution strict {
    for t: us.irc.core::Transaction;
    when contribution_to_or_distribution_from_thrift_savings_fund(t)
        and contribution_subject_to_election_between_cash_and_fund_contribution_under_title_5(t)
        and not_known(thrift_contribution_barred_by_401k4B(t))
        and not_known(thrift_contribution_over_dollar_limitation(t));
    then not_treated_as_distributed_or_made_available_and_not_as_employee_contribution(t);
}
pub relation thrift_savings_fund_meets_requirements_of_section_7701j(f: Person) kind empirical {
    label en official "so long as it meets the requirements of this section";
}
pub relation thrift_savings_fund_exempt_from_401k_and_401m_nondiscrimination_requirements(f: Person) kind institutional {
    label en official "the Thrift Savings Fund is not subject to the nondiscrimination requirements applicable to arrangements described in section 401(k) or to matching contributions (as described in section 401(m)), so long as it meets the requirements of this section";
}
@source(IRC_S7701, relation = formalizes, coverage = exact, quote = "Notwithstanding any other provision of law, the Thrift Savings Fund is not subject to the nondiscrimination requirements applicable to arrangements described in section 401(k) or to matching contributions (as described in section 401(m)), so long as it meets the requirements of this section.")
rule ThriftSavingsFundIsExemptFromNondiscrimination strict {
    for f: Person;
    when thrift_savings_fund_meets_requirements_of_section_7701j(f);
    then thrift_savings_fund_exempt_from_401k_and_401m_nondiscrimination_requirements(f);
}

// --- (k) Payments to charities on behalf of Federal officers and employees ---------------
pub entity OfficerCharityPayment { label en unofficial "a payment which, except for section 13143(b) of title 5, might be made to a Federal officer or employee but is made instead on his behalf to an organization described in section 170(c)"; }
pub relation payment_made_on_behalf_of_officer_to_170c_organization(pay: OfficerCharityPayment, p: Person) kind empirical {
    label en official "any payment which, except for section 13143(b) of title 5, United States Code, might be made to any officer or employee of the Federal Government but which is made instead on behalf of such officer or employee to an organization described in section 170(c)";
}
pub relation is_senator_representative_delegate_or_resident_commissioner(p: Person) kind empirical {
    label en official "a Senator, a Representative in, or a Delegate or Resident Commissioner to, the Congress";
}
pub relation is_officer_or_employee_of_federal_government(p: Person) kind empirical {
    label en unofficial "the person is an officer or employee of the Federal Government";
}
pub relation treated_as_officer_or_employee_of_federal_government_for_7701k(p: Person) kind institutional {
    label en official "for purposes of this subsection, a Senator, a Representative in, or a Delegate or Resident Commissioner to, the Congress shall be treated as an officer or employee of the Federal Government";
}
@source(IRC_S7701, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, a Senator, a Representative in, or a Delegate or Resident Commissioner to, the Congress shall be treated as an officer or employee of the Federal Government.")
rule MemberOfCongressIsTreatedAsFederalOfficerForSubsectionK strict {
    for p: Person;
    when is_senator_representative_delegate_or_resident_commissioner(p);
    then treated_as_officer_or_employee_of_federal_government_for_7701k(p);
}
@source(IRC_S7701, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, a Senator, a Representative in, or a Delegate or Resident Commissioner to, the Congress shall be treated as an officer or employee of the Federal Government.")
rule FederalOfficerOrEmployeeIsOfficerForSubsectionK strict {
    for p: Person;
    when is_officer_or_employee_of_federal_government(p);
    then treated_as_officer_or_employee_of_federal_government_for_7701k(p);
}
pub relation payment_not_treated_as_received_by_officer_for_this_title(pay: OfficerCharityPayment, p: Person) kind institutional {
    label en official "such payment shall not be treated as received by such officer or employee for all purposes of this title";
}
pub relation payment_not_treated_as_received_for_state_or_local_tax_law(pay: OfficerCharityPayment, p: Person) kind institutional {
    label en official "such payment shall not be treated as received by such officer or employee for all purposes of any tax law of a State or political subdivision thereof";
}
pub relation no_deduction_allowed_to_officer_by_reason_of_payment(pay: OfficerCharityPayment, p: Person) kind institutional {
    label en official "no deduction shall be allowed under any provision of this title (or of any tax law of a State or political subdivision thereof) to such officer or employee by reason of having such payment made to such organization";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "(1) such payment shall not be treated as received by such officer or employee for all purposes of this title and for all purposes of any tax law of a State or political subdivision thereof, and")
rule OfficerCharityPaymentIsNotReceivedForThisTitle strict {
    for pay: OfficerCharityPayment; for p: Person;
    when payment_made_on_behalf_of_officer_to_170c_organization(pay, p) and treated_as_officer_or_employee_of_federal_government_for_7701k(p);
    then payment_not_treated_as_received_by_officer_for_this_title(pay, p);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "(1) such payment shall not be treated as received by such officer or employee for all purposes of this title and for all purposes of any tax law of a State or political subdivision thereof, and")
rule OfficerCharityPaymentIsNotReceivedForStateTaxLaw strict {
    for pay: OfficerCharityPayment; for p: Person;
    when payment_made_on_behalf_of_officer_to_170c_organization(pay, p) and treated_as_officer_or_employee_of_federal_government_for_7701k(p);
    then payment_not_treated_as_received_for_state_or_local_tax_law(pay, p);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "(2) no deduction shall be allowed under any provision of this title (or of any tax law of a State or political subdivision thereof) to such officer or employee by reason of having such payment made to such organization.")
rule OfficerCharityPaymentGivesNoDeduction strict {
    for pay: OfficerCharityPayment; for p: Person;
    when payment_made_on_behalf_of_officer_to_170c_organization(pay, p) and treated_as_officer_or_employee_of_federal_government_for_7701k(p);
    then no_deduction_allowed_to_officer_by_reason_of_payment(pay, p);
}

// --- (m) Contract-market designations ---------------------------------------------------
pub entity ContractMarketDesignation { label en unofficial "a designation by the Commodity Futures Trading Commission of a contract market"; }
pub relation designation_could_not_have_been_made_before_cfma_2000(d: ContractMarketDesignation) kind empirical {
    label en official "any designation by the Commodity Futures Trading Commission of a contract market which could not have been made under the law in effect on the day before the date of the enactment of the Commodity Futures Modernization Act of 2000";
}
pub relation regulations_provide_otherwise_for_designation(d: ContractMarketDesignation) kind empirical {
    label en official "except to the extent provided in regulations prescribed by the Secretary";
}
pub relation designation_applies_for_purposes_of_this_title(d: ContractMarketDesignation) kind institutional {
    label en official "any such designation shall apply for purposes of this title except to the extent provided in regulations prescribed by the Secretary";
}
@source(IRC_S7701, relation = formalizes, coverage = exact, quote = "Any designation by the Commodity Futures Trading Commission of a contract market which could not have been made under the law in effect on the day before the date of the enactment of the Commodity Futures Modernization Act of 2000 shall apply for purposes of this title except to the extent provided in regulations prescribed by the Secretary.")
rule CftcDesignationAppliesUnlessRegulationsProvideOtherwise strict {
    for d: ContractMarketDesignation;
    when designation_could_not_have_been_made_before_cfma_2000(d) and not_known(regulations_provide_otherwise_for_designation(d));
    then designation_applies_for_purposes_of_this_title(d);
}

// --- (n) Convention or association of churches ------------------------------------------
pub relation otherwise_qualifies_as_convention_or_association_of_churches(o: Person) kind empirical {
    label en official "any organization which is otherwise a convention or association of churches";
}
pub relation membership_includes_individuals_or_individuals_have_voting_rights(o: Person) kind empirical {
    label en official "the membership of such organization includes individuals as well as churches or individuals have voting rights in such organization";
}
pub relation convention_or_association_of_churches(o: Person) kind institutional {
    label en official "any organization which is otherwise a convention or association of churches shall not fail to so qualify merely because the membership of such organization includes individuals as well as churches or because individuals have voting rights in such organization";
}
@source(IRC_S7701, relation = formalizes, coverage = exact, quote = "For purposes of this title, any organization which is otherwise a convention or association of churches shall not fail to so qualify merely because the membership of such organization includes individuals as well as churches or because individuals have voting rights in such organization.")
rule ChurchConventionQualifiesDespiteIndividualMembersOrVoting strict {
    for o: Person;
    when otherwise_qualifies_as_convention_or_association_of_churches(o);
    then convention_or_association_of_churches(o);
}
