// Stage 3b (26.09.2026, DECISION-0379 with deontics), implemented_unverified, NOT executed, no legal review.
//  - 26 U.S.C. 7702A(a)(2): the chain of exchanges is unrolled to EIGHT levels (levels 6-8 here; 3-5 in insurance-stage3.law).
//  - 26 U.S.C. 7702(j): church self-funded death benefit plans are treated as life insurance without the
//    applicable-law requirement of subsection (a) (rows 26/7702/j/*).
//  - 26 U.S.C. 7705(f): the Secretary's duty of public disclosure of certified, suspended and revoked CPEOs.
//
// JUDGMENT CALLS AND GAPS
//  - A predicate cannot depend on itself (LDC-E4102), so the exchange chain is bounded at eight links (TECH-GAPS G6301).
//  - A plan or arrangement of 7702(j) is an InsuranceContract of this package; "provided by a church directly or
//    through an organization described in 414(e)(3)(A) or (B)(ii)" is read as: the provider is a church (or a
//    convention or association of churches) and the plan is provided directly or through one of those
//    organizations (asserted as flags: the classification of the organization is owned by deferred-compensation,
//    which imports this package).
//  - "Employee" for the church plan includes an employee described in 414(e)(3)(B) (asserted as its own flag).
//  - The public disclosure duty of 7705(f) has no deadline in the text: its window is open (from certification or
//    from the suspension or revocation).

language "law.core" version "0.2";
package us.irc.definitions version "0.1.1";
namespace "urn:us:irc:definitions:clir";

use self::{
    IRC_S7702A_A,
    IRC_S7702_J,
    IRC_S7705_F,
    InsuranceContract,
    Person,
    ProfessionalEmployerOrganization,
    Secretary,
    certification_suspended_or_revoked,
    certified_professional_employer_organization,
    contract_under_applicable_law_for_a_and_g,
    modified_endowment_contract_7702a,
    received_in_exchange_fifth_level,
    received_in_exchange_for_contract,
};

// ============================================================================
// 7702A(a)(2): exchange chain, levels 6 to 8
// ============================================================================
pub relation received_in_exchange_sixth_level(c: InsuranceContract) kind institutional { label en official "a contract received in exchange for a level-5 exchange contract (sixth link of the chain)"; }
pub relation received_in_exchange_seventh_level(c: InsuranceContract) kind institutional { label en official "a contract received in exchange for a level-6 exchange contract (seventh link of the chain)"; }
pub relation received_in_exchange_eighth_level(c: InsuranceContract) kind institutional { label en official "a contract received in exchange for a level-7 exchange contract (eighth link of the chain)"; }
@source(IRC_S7702A_A, coverage = partial, quote = "(2) which is received in exchange for a contract described in paragraph (1) or this paragraph.")
rule ExchangeForFifthLevelGivesSixthLevel strict { for c: InsuranceContract; for prior: InsuranceContract; when received_in_exchange_for_contract(c, prior) and received_in_exchange_fifth_level(prior); then received_in_exchange_sixth_level(c); }
rule ExchangeForSixthLevelGivesSeventhLevel strict { for c: InsuranceContract; for prior: InsuranceContract; when received_in_exchange_for_contract(c, prior) and received_in_exchange_sixth_level(prior); then received_in_exchange_seventh_level(c); }
rule ExchangeForSeventhLevelGivesEighthLevel strict { for c: InsuranceContract; for prior: InsuranceContract; when received_in_exchange_for_contract(c, prior) and received_in_exchange_seventh_level(prior); then received_in_exchange_eighth_level(c); }
rule SixthLevelExchangeContractIsMec strict { for c: InsuranceContract; when received_in_exchange_sixth_level(c); then modified_endowment_contract_7702a(c); }
rule SeventhLevelExchangeContractIsMec strict { for c: InsuranceContract; when received_in_exchange_seventh_level(c); then modified_endowment_contract_7702a(c); }
rule EighthLevelExchangeContractIsMec strict { for c: InsuranceContract; when received_in_exchange_eighth_level(c); then modified_endowment_contract_7702a(c); }

// ============================================================================
// 7702(j): church self-funded death benefit plans
// ============================================================================
pub relation plan_provider(c: InsuranceContract, p: Person) kind empirical { label en official "the person that provides the plan or arrangement"; }
pub relation is_a_church(p: Person) kind empirical { label en official "a church"; }
pub relation is_a_convention_of_churches(p: Person) kind empirical { label en official "a convention of churches"; }
pub relation is_an_association_of_churches(p: Person) kind empirical { label en official "an association of churches"; }
pub relation church_for_7702j(p: Person) kind institutional { label en official "the term church means a church or a convention or association of churches"; }
@source(IRC_S7702_J, coverage = exact, quote = "The term \"church\" means a church or a convention or association of churches.")
rule ChurchIsAChurch strict { for p: Person; when is_a_church(p); then church_for_7702j(p); }
rule ChurchIsAConventionOfChurches strict { for p: Person; when is_a_convention_of_churches(p); then church_for_7702j(p); }
rule ChurchIsAnAssociationOfChurches strict { for p: Person; when is_an_association_of_churches(p); then church_for_7702j(p); }
pub relation plan_pays_benefits_by_reason_of_death_of_covered_individuals(c: InsuranceContract) kind empirical { label en official "such plan or arrangement provides for the payment of benefits by reason of the death of the individuals covered under such plan or arrangement"; }
pub relation plan_benefits_employees_and_beneficiaries(c: InsuranceContract) kind empirical { label en official "the plan is for the benefit of employees and their beneficiaries"; }
pub relation plan_benefits_employees_described_in_414e3B_and_beneficiaries(c: InsuranceContract) kind empirical { label en official "the plan is for the benefit of employees described in section 414(e)(3)(B) and their beneficiaries"; }
pub relation plan_provided_directly(c: InsuranceContract) kind empirical { label en official "the plan is provided directly"; }
pub relation plan_provided_through_organization_414e3A(c: InsuranceContract) kind empirical { label en official "the plan is provided through an organization described in section 414(e)(3)(A)"; }
pub relation plan_provided_through_organization_414e3B_ii(c: InsuranceContract) kind empirical { label en official "the plan is provided through an organization described in section 414(e)(3)(B)(ii)"; }
pub relation plan_beneficiaries_are_employees_7702j3B(c: InsuranceContract) kind institutional { label en official "the term employee includes an employee described in section 414(e)(3)(B)"; }
@source(IRC_S7702_J, coverage = exact, quote = "The term \"employee\" includes an employee described in section 414(e)(3)(B).")
rule ChurchPlanCoversEmployees strict { for c: InsuranceContract; when plan_benefits_employees_and_beneficiaries(c); then plan_beneficiaries_are_employees_7702j3B(c); }
rule ChurchPlanCoversSection414e3BEmployees strict { for c: InsuranceContract; when plan_benefits_employees_described_in_414e3B_and_beneficiaries(c); then plan_beneficiaries_are_employees_7702j3B(c); }
pub relation plan_provided_by_church_for_employees(c: InsuranceContract) kind institutional { label en official "the plan is provided by a church for the benefit of its employees and their beneficiaries, directly or through an organization described in section 414(e)(3)(A) or (B)(ii)"; }
@source(IRC_S7702_J, coverage = partial, quote = "(B) such plan or arrangement is provided by a church for the benefit of its employees and their beneficiaries")
rule ChurchPlanProvidedDirectly strict { for c: InsuranceContract; for p: Person; when plan_provider(c, p) and church_for_7702j(p) and plan_beneficiaries_are_employees_7702j3B(c) and plan_provided_directly(c); then plan_provided_by_church_for_employees(c); }
rule ChurchPlanProvidedThrough414e3A strict { for c: InsuranceContract; for p: Person; when plan_provider(c, p) and church_for_7702j(p) and plan_beneficiaries_are_employees_7702j3B(c) and plan_provided_through_organization_414e3A(c); then plan_provided_by_church_for_employees(c); }
rule ChurchPlanProvidedThrough414e3Bii strict { for c: InsuranceContract; for p: Person; when plan_provider(c, p) and church_for_7702j(p) and plan_beneficiaries_are_employees_7702j3B(c) and plan_provided_through_organization_414e3B_ii(c); then plan_provided_by_church_for_employees(c); }
pub relation church_plan_described_in_7702j2(c: InsuranceContract) kind institutional { label en official "a plan or arrangement described in paragraph (2) of subsection (j)"; }
@source(IRC_S7702_J, coverage = partial, quote = "(A) such plan or arrangement provides for the payment of benefits by reason of the death of the individuals covered under such plan or arrangement, and")
rule ChurchPlanDescribedInParagraph2 strict { for c: InsuranceContract; when plan_pays_benefits_by_reason_of_death_of_covered_individuals(c) and plan_provided_by_church_for_employees(c); then church_plan_described_in_7702j2(c); }
@source(IRC_S7702_J, coverage = exact, quote = "the requirement of subsection (a) that the contract be a life insurance contract under applicable law shall not apply")
rule ChurchPlanNeedNotBeLifeInsuranceUnderApplicableLaw strict { for c: InsuranceContract; when church_plan_described_in_7702j2(c); then contract_under_applicable_law_for_a_and_g(c); }

// ============================================================================
// 7705(f): public disclosure
// ============================================================================
pub relation secretary_makes_name_and_address_public(o: ProfessionalEmployerOrganization) kind empirical { label en official "the Secretary has made the name and address of the organization available to the public"; }
@source(IRC_S7705_F, coverage = exact, quote = "(1) each person certified as a professional employer organization under subsection (a), and")
rule S7705F1SecretaryDiscloseCertifiedCpeo strict {
    for o: ProfessionalEmployerOrganization;
    when certified_professional_employer_organization(o);
    then duty PublishNameAndAddressOfCertifiedCpeo {
        bearer Secretary;
        goal achievement {
            condition secretary_makes_name_and_address_public(o);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S7705_F, coverage = exact, quote = "(2) each person whose certification as a professional employer organization is suspended or revoked under subsection (d).")
rule S7705F2SecretaryDiscloseSuspendedOrRevokedCpeo strict {
    for o: ProfessionalEmployerOrganization;
    when certification_suspended_or_revoked(o);
    then duty PublishNameAndAddressOfSuspendedOrRevokedCpeo {
        bearer Secretary;
        goal achievement {
            condition secretary_makes_name_and_address_public(o);
            window [-infinity, infinity];
        }
    };
}
