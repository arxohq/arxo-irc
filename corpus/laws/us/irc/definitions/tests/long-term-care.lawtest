        context { legal_time @2026-03-01; decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": plan_established_and_maintained_by_state_or_instrumentality(entity_ref("urn:test:s7702b:t74#pl")) { origin case_input; }
        assert "f1": plan_provides_coverage_only_for_qualified_long_term_care_services(entity_ref("urn:test:s7702b:t74#pl")) { origin case_input; }
        assert "f2": coverage_provided_only_to_state_employees_former_employees_spouses_and_152d2_relatives(entity_ref("urn:test:s7702b:t74#pl")) { origin case_input; }
        assert "f3": covered_on_december_31_1996_under_state_plan(entity_ref("urn:test:s7702b:t74#p"), entity_ref("urn:test:s7702b:t74#pl")) { origin case_input; }
        assert "f4": plan_terms_on_december_31_1996_met_state_long_term_care_insurance_requirements(entity_ref("urn:test:s7702b:t74#pl")) { origin case_input; }
    }
    evaluate truth(state_plan_terms_treated_as_contract_issued_december_31_1996_meeting_state_requirements(entity_ref("urn:test:s7702b:t74#pl")));
    expect truth_status == TRUE_ONLY;
}

