test "S7701-A50-02-ON-RELINQUISHMENT-DATE-RULE-NO-LONGER-KEEPS-CITIZENSHIP" {
    given {
        context { legal_time @2026-03-01; decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": held_united_states_citizenship(entity_ref("urn:test:s7701g:t50#p")) { origin case_input; }
        assert "f1": citizen_status_evaluated_on(entity_ref("urn:test:s7701g:t50#p"), @2026-09-01) { origin case_input; }
        assert "f2": citizenship_treated_as_relinquished_under_877a_g4_on(entity_ref("urn:test:s7701g:t50#p"), @2026-09-01) { origin case_input; }
    }
    evaluate truth(treated_as_united_states_citizen_on(entity_ref("urn:test:s7701g:t50#p"), @2026-09-01));
    expect truth_status == NEITHER;
}

test "S7701-A50-03-NO-RELINQUISHMENT-DATE-FACT-LEAVES-RESULT-UNKNOWN" {
    given {
        context { legal_time @2026-03-01; decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": held_united_states_citizenship(entity_ref("urn:test:s7701g:t51#p")) { origin case_input; }
        assert "f1": citizen_status_evaluated_on(entity_ref("urn:test:s7701g:t51#p"), @2026-06-01) { origin case_input; }
    }
    evaluate truth(treated_as_united_states_citizen_on(entity_ref("urn:test:s7701g:t51#p"), @2026-06-01));
    expect truth_status == NEITHER;
}
