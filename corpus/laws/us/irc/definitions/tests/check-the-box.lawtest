language "law.core" version "0.2";
package us.irc.definitions version "0.1.1";
namespace "urn:us:irc:definitions:clir";

// §7701(a)(3) check-the-box wire (26/7701/3/u1): eligible-entity election
// as association (Form 8832) vs the domestic two-or-more-members default.
// Written per AGENT-BRIEF (applies/does not apply, unknown fact ->
// NEITHER); NOT executed (owner's NO-HEAVY-CHECKS restriction) —
// `implemented_unverified`. Key literals from the pinned renders
// (`us.cfr.t26_301_7701`, eCFR 2026-09-24): 301.7701-3(a) eligible entity,
// (b)(1)(i) partnership default, (c)(1)(i) Form 8832.

test "S7701-CTB-01-ELECTED-ASSOCIATION-IS-CORPORATION" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "America/New_York"; }
        assert eligible_entity_for_check_box(entity_ref("urn:us:irc:case:ctb1")) { id "f0"; origin case_input; }
        assert check_box_association_election_filed(entity_ref("urn:us:irc:case:ctb1")) { id "f1"; origin case_input; }
    }
    evaluate truth(corporation(entity_ref("urn:us:irc:case:ctb1")));
    expect truth_status == TRUE_ONLY;
}

test "S7701-CTB-02-DOMESTIC-DEFAULT-IS-PARTNERSHIP-NOT-CORPORATION" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "America/New_York"; }
        assert domestic_eligible_entity_with_two_or_more_members(entity_ref("urn:us:irc:case:ctb2")) { id "f0"; origin case_input; }
        assert no_check_box_election_filed(entity_ref("urn:us:irc:case:ctb2")) { id "f1"; origin case_input; }
    }
    evaluate truth(partnership(entity_ref("urn:us:irc:case:ctb2")));
    expect truth_status == TRUE_ONLY;
}
