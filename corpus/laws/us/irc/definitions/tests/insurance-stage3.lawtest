test "S7702A-C4-01-PRIOR-CONTRACTS-OF-SAME-HOLDER-AND-COMPANY-AGGREGATED" {
    given {
        context { decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; legal_time @2024-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert contract_policyholder(entity_ref("urn:test:g1#c1"), entity_ref("urn:test:g1#h")) { id "f0"; origin case_input; }
        assert contract_issuing_company(entity_ref("urn:test:g1#c1"), entity_ref("urn:test:g1#co")) { id "f1"; origin case_input; }
        assert contract_issue_date(entity_ref("urn:test:g1#c1"), @2020-01-01) { id "f2"; origin case_input; }
        assert contract_initial_death_benefit(entity_ref("urn:test:g1#c1"), 4000.00 USD) { id "f3"; origin case_input; }
        assert contract_policyholder(entity_ref("urn:test:g1#c2"), entity_ref("urn:test:g1#h")) { id "f4"; origin case_input; }
        assert contract_issuing_company(entity_ref("urn:test:g1#c2"), entity_ref("urn:test:g1#co")) { id "f5"; origin case_input; }
        assert contract_issue_date(entity_ref("urn:test:g1#c2"), @2022-01-01) { id "f6"; origin case_input; }
        assert contract_initial_death_benefit(entity_ref("urn:test:g1#c2"), 5000.00 USD) { id "f7"; origin case_input; }
        assert contract_policyholder(entity_ref("urn:test:g1#c"), entity_ref("urn:test:g1#h")) { id "f8"; origin case_input; }
        assert contract_issuing_company(entity_ref("urn:test:g1#c"), entity_ref("urn:test:g1#co")) { id "f9"; origin case_input; }
        assert contract_issue_date(entity_ref("urn:test:g1#c"), @2024-06-01) { id "f10"; origin case_input; }
        assert contract_initial_death_benefit(entity_ref("urn:test:g1#c"), 1000.00 USD) { id "f11"; origin case_input; }
        assert contract_policyholder(entity_ref("urn:test:g1#c4"), entity_ref("urn:test:g1#h")) { id "f12"; origin case_input; }
        assert contract_issuing_company(entity_ref("urn:test:g1#c4"), entity_ref("urn:test:g1#co")) { id "f13"; origin case_input; }
        assert contract_issue_date(entity_ref("urn:test:g1#c4"), @2025-01-01) { id "f14"; origin case_input; }
        assert contract_initial_death_benefit(entity_ref("urn:test:g1#c4"), 9000.00 USD) { id "f15"; origin case_input; }
        assert contract_policyholder(entity_ref("urn:test:g1#c5"), entity_ref("urn:test:g1#h2")) { id "f16"; origin case_input; }
        assert contract_issuing_company(entity_ref("urn:test:g1#c5"), entity_ref("urn:test:g1#co")) { id "f17"; origin case_input; }
        assert contract_issue_date(entity_ref("urn:test:g1#c5"), @2021-01-01) { id "f18"; origin case_input; }
        assert contract_initial_death_benefit(entity_ref("urn:test:g1#c5"), 3000.00 USD) { id "f19"; origin case_input; }
    }
    // 4000 + 5000 + 1000 = 10000; contracts issued later (c4) or to another holder (c5) are not part of the one contract.
    evaluate truth(aggregate_initial_death_benefit_one_contract(entity_ref("urn:test:g1#c"), 10000.00 USD));
    expect truth_status == TRUE_ONLY;
}

