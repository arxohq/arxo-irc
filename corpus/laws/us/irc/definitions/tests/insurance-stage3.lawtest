// Stage 3 (26.09.2026) scenarios for 26 U.S.C. 7702A(a)(2), (b), (c)(1), (c)(4), module insurance-stage3.law (chain levels 3-5) and stage3b-definitions.law (levels 6-8). NOT EXECUTED (implemented_unverified). Actuarial outputs are scenario facts.


language "law.core" version "0.2";
package us.irc.definitions version "0.1.1";
namespace "urn:us:irc:definitions:clir";

test "S7702A-B-01-LEVEL-ANNUAL-PREMIUM-IS-NSP-OVER-ANNUITY-DUE" {
    given {
        context { decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; legal_time @2024-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert seven_pay_net_single_premium_at_issue(entity_ref("urn:test:a1#c"), 100000.00 USD) { id "f0"; origin case_input; }
        assert seven_pay_annuity_due_factor_at_issue(entity_ref("urn:test:a1#c"), 6.5) { id "f1"; origin case_input; }
        assert first_month_for_which_contract_is_in_effect_begins_on(entity_ref("urn:test:a1#c"), @2024-01-01) { id "f2"; origin case_input; }
        assert contract_year_evaluated_on(entity_ref("urn:test:a1#c"), @2024-06-01) { id "f3"; origin case_input; }
    }
    // 100000 / 6.5 = 15384.615..., cents HALF_UP: 15384.62.
    evaluate truth(seven_pay_level_annual_premium(entity_ref("urn:test:a1#c"), 15384.62 USD));
    expect truth_status == TRUE_ONLY;
}

