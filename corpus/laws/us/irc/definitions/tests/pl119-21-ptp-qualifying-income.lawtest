test "S7704D1E-PL70524-01-HYDROGEN-STORAGE-INCOME-IN-YEAR-BEGINNING-2026-IS-QUALIFYING" {
    given {
        context { legal_time @2026-03-01; decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": ptp_income_item_of_taxable_year(entity_ref("urn:test:s7704pl:t1#it"), entity_ref("urn:test:s7704pl:t1#p"), entity_ref("urn:test:s7704pl:t1#y")) { origin case_input; }
        assert "f1": us.irc.core::begins(entity_ref("urn:test:s7704pl:t1#y"), @2026-01-01) { origin case_input; }
        assert "f2": income_item_in_category_added_by_pl119_21(entity_ref("urn:test:s7704pl:t1#it"), LiquefiedOrCompressedHydrogenTransportOrStorage) { origin case_input; }
    }
    evaluate truth(qualifying_income_item_under_7704d1e_as_amended_by_pl119_21(entity_ref("urn:test:s7704pl:t1#it")));
    expect truth_status == TRUE_ONLY;
}

