language "law.core" version "0.2";
package us.irc.definitions version "0.1.1";
namespace "urn:us:irc:definitions:clir";

// §7704 publicly traded partnerships. `implemented_unverified`.

test "S7704-B-01-TRADED-ON-ESTABLISHED-MARKET-IS-PUBLICLY-TRADED" {
    given {
        context { decision_time @2026-06-01T12:00:00Z; knowledge_time @2026-06-01T12:00:00Z; legal_time @2026-06-01; timezone "America/New_York"; }
        assert interests_traded_on_established_securities_market(entity_ref("urn:us:irc:case:p1")) { id "f0"; origin case_input; }
    }
    evaluate truth(publicly_traded_partnership(entity_ref("urn:us:irc:case:p1")));
    expect truth_status == TRUE_ONLY;
}

test "S7704-A-01-PUBLICLY-TRADED-PARTNERSHIP-TREATED-AS-CORPORATION" {
    given {
        context { decision_time @2026-06-01T12:00:00Z; knowledge_time @2026-06-01T12:00:00Z; legal_time @2026-06-01; timezone "America/New_York"; }
        assert interests_traded_on_established_securities_market(entity_ref("urn:us:irc:case:p2")) { id "f0"; origin case_input; }
        assert ptp_status_evaluated_for_year(entity_ref("urn:us:irc:case:p2"), entity_ref("urn:us:irc:case:y2026")) { id "f1"; origin case_input; }
    }
    evaluate truth(treated_as_corporation_under_ptp_rule(entity_ref("urn:us:irc:case:p2"), entity_ref("urn:us:irc:case:y2026")));
    expect truth_status == TRUE_ONLY;
}

test "S7704-C-01-NINETY-PERCENT-QUALIFYING-INCOME-EXEMPTS-FROM-CORPORATE-TREATMENT" {
    given {
        context { decision_time @2026-06-01T12:00:00Z; knowledge_time @2026-06-01T12:00:00Z; legal_time @2026-06-01; timezone "America/New_York"; }
        assert interests_traded_on_established_securities_market(entity_ref("urn:us:irc:case:p3")) { id "f0"; origin case_input; }
        assert qualifying_gross_income_for_year(entity_ref("urn:us:irc:case:p3"), entity_ref("urn:us:irc:case:y2026"), 900000 USD) { id "f1"; origin case_input; }
        assert total_gross_income_for_year(entity_ref("urn:us:irc:case:p3"), entity_ref("urn:us:irc:case:y2026"), 1000000 USD) { id "f2"; origin case_input; }
        assert met_gross_income_requirement_every_year_since_1988_or_first_existence(entity_ref("urn:us:irc:case:p3"), entity_ref("urn:us:irc:case:y2026")) { id "f3"; origin case_input; }
        assert ptp_status_evaluated_for_year(entity_ref("urn:us:irc:case:p3"), entity_ref("urn:us:irc:case:y2026")) { id "f4"; origin case_input; }
    }
    evaluate truth(treated_as_corporation_under_ptp_rule(entity_ref("urn:us:irc:case:p3"), entity_ref("urn:us:irc:case:y2026")));
    expect truth_status == NEITHER;
}

test "S7704-C-02-EIGHTY-NINE-PERCENT-QUALIFYING-INCOME-FAILS-NINETY-PERCENT-TEST" {
    given {
        context { decision_time @2026-06-01T12:00:00Z; knowledge_time @2026-06-01T12:00:00Z; legal_time @2026-06-01; timezone "America/New_York"; }
        assert qualifying_gross_income_for_year(entity_ref("urn:us:irc:case:p4"), entity_ref("urn:us:irc:case:y2026"), 890000 USD) { id "f0"; origin case_input; }
        assert total_gross_income_for_year(entity_ref("urn:us:irc:case:p4"), entity_ref("urn:us:irc:case:y2026"), 1000000 USD) { id "f1"; origin case_input; }
    }
    evaluate truth(ninety_percent_gross_income_requirement_met_for_year(entity_ref("urn:us:irc:case:p4"), entity_ref("urn:us:irc:case:y2026")));
    expect truth_status == NEITHER;
}

test "S7704-E-01-INADVERTENT-CURED-FAILURE-TREATED-AS-CONTINUING-TO-QUALIFY" {
    given {
        context { decision_time @2026-06-01T12:00:00Z; knowledge_time @2026-06-01T12:00:00Z; legal_time @2026-06-01; timezone "America/New_York"; }
        assert failed_gross_income_requirement(entity_ref("urn:us:irc:case:p5"), entity_ref("urn:us:irc:case:y2026")) { id "f0"; origin case_input; }
        assert secretary_determines_failure_inadvertent(entity_ref("urn:us:irc:case:p5"), entity_ref("urn:us:irc:case:y2026")) { id "f1"; origin case_input; }
        assert cured_within_reasonable_time(entity_ref("urn:us:irc:case:p5"), entity_ref("urn:us:irc:case:y2026")) { id "f2"; origin case_input; }
        assert partnership_agrees_to_secretary_required_adjustments_or_payments(entity_ref("urn:us:irc:case:p5"), entity_ref("urn:us:irc:case:y2026")) { id "f3"; origin case_input; }
    }
    evaluate truth(treated_as_continuing_to_meet_gross_income_requirements(entity_ref("urn:us:irc:case:p5"), entity_ref("urn:us:irc:case:y2026")));
    expect truth_status == TRUE_ONLY;
}

test "S7704-G-01-ELECTING-1987-PARTNERSHIP-EXEMPT-FROM-CORPORATE-TREATMENT" {
    given {
        context { decision_time @2026-06-01T12:00:00Z; knowledge_time @2026-06-01T12:00:00Z; legal_time @2026-06-01; timezone "America/New_York"; }
        assert interests_traded_on_established_securities_market(entity_ref("urn:us:irc:case:p6")) { id "f0"; origin case_input; }
        assert is_electing_1987_partnership(entity_ref("urn:us:irc:case:p6")) { id "f1"; origin case_input; }
        assert ptp_status_evaluated_for_year(entity_ref("urn:us:irc:case:p6"), entity_ref("urn:us:irc:case:y2026")) { id "f2"; origin case_input; }
    }
    evaluate truth(treated_as_corporation_under_ptp_rule(entity_ref("urn:us:irc:case:p6"), entity_ref("urn:us:irc:case:y2026")));
    expect truth_status == NEITHER;
}
