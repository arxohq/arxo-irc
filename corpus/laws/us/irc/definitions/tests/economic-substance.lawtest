language "law.core" version "0.2";
package us.irc.definitions version "0.1.1";
namespace "urn:us:irc:definitions:clir";

// §7701(o) economic substance doctrine. `implemented_unverified`.

test "S7701-O-01-BOTH-PRONGS-DIRECTLY-ESTABLISHED-GIVES-ECONOMIC-SUBSTANCE" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "America/New_York"; }
        assert economic_substance_doctrine_relevant(entity_ref("urn:us:irc:case:t1")) { id "f0"; origin case_input; }
        assert changes_taxpayers_economic_position_meaningfully(entity_ref("urn:us:irc:case:t1")) { id "f1"; origin case_input; }
        assert taxpayer_has_substantial_nontax_purpose(entity_ref("urn:us:irc:case:t1")) { id "f2"; origin case_input; }
    }
    evaluate truth(transaction_has_economic_substance(entity_ref("urn:us:irc:case:t1")));
    expect truth_status == TRUE_ONLY;
}

test "S7701-O-02-ONLY-ONE-PRONG-DOES-NOT-ESTABLISH-ECONOMIC-SUBSTANCE" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "America/New_York"; }
        assert economic_substance_doctrine_relevant(entity_ref("urn:us:irc:case:t2")) { id "f0"; origin case_input; }
        assert changes_taxpayers_economic_position_meaningfully(entity_ref("urn:us:irc:case:t2")) { id "f1"; origin case_input; }
    }
    evaluate truth(transaction_has_economic_substance(entity_ref("urn:us:irc:case:t2")));
    expect truth_status == NEITHER;
}

test "S7701-O-03-PROFIT-POTENTIAL-RELIANCE-WITHOUT-SUBSTANTIAL-COMPARISON-FAILS" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "America/New_York"; }
        assert economic_substance_doctrine_relevant(entity_ref("urn:us:irc:case:t3")) { id "f0"; origin case_input; }
        assert taxpayer_relies_on_profit_potential(entity_ref("urn:us:irc:case:t3")) { id "f1"; origin case_input; }
        assert changes_taxpayers_economic_position_meaningfully(entity_ref("urn:us:irc:case:t3")) { id "f2"; origin case_input; }
        assert taxpayer_has_substantial_nontax_purpose(entity_ref("urn:us:irc:case:t3")) { id "f3"; origin case_input; }
    }
    evaluate truth(transaction_has_economic_substance(entity_ref("urn:us:irc:case:t3")));
    expect truth_status == NEITHER;
}

test "S7701-O-04-COURT-JUDGMENT-GIVES-ECONOMIC-SUBSTANCE-WITHOUT-DIRECT-PRONG-FACTS" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "America/New_York"; }
        assert economic_substance_doctrine_relevant(entity_ref("urn:us:irc:case:t4")) { id "f0"; origin case_input; }
        assert TransactionHasEconomicSubstanceUnderCommonLawDoctrine(entity_ref("urn:us:irc:case:t4")) { id "f1"; origin adjudicated; }
    }
    evaluate truth(transaction_has_economic_substance(entity_ref("urn:us:irc:case:t4")));
    expect truth_status == TRUE_ONLY;
}

test "S7701-O-05-INDIVIDUAL-PERSONAL-TRANSACTION-DOCTRINE-DOES-NOT-APPLY" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "America/New_York"; }
        assert economic_substance_doctrine_relevant(entity_ref("urn:us:irc:case:t5")) { id "f0"; origin case_input; }
        assert transacting_party_is_individual(entity_ref("urn:us:irc:case:t5")) { id "f1"; origin case_input; }
        assert changes_taxpayers_economic_position_meaningfully(entity_ref("urn:us:irc:case:t5")) { id "f2"; origin case_input; }
        assert taxpayer_has_substantial_nontax_purpose(entity_ref("urn:us:irc:case:t5")) { id "f3"; origin case_input; }
    }
    evaluate truth(transaction_has_economic_substance(entity_ref("urn:us:irc:case:t5")));
    expect truth_status == NEITHER;
}

test "S7701-O-06-DOCTRINE-RELEVANCE-UNKNOWN-GIVES-NEITHER" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "America/New_York"; }
        assert changes_taxpayers_economic_position_meaningfully(entity_ref("urn:us:irc:case:t6")) { id "f0"; origin case_input; }
        assert taxpayer_has_substantial_nontax_purpose(entity_ref("urn:us:irc:case:t6")) { id "f1"; origin case_input; }
    }
    evaluate truth(transaction_has_economic_substance(entity_ref("urn:us:irc:case:t6")));
    expect truth_status == NEITHER;
}
