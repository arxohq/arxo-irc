        assert present_run_of_at_least_31_days_from(entity_ref("urn:test:y1#p"), 2023, @2023-03-01) { id "f1"; origin case_input; }
        assert days_present_in_testing_period_from(entity_ref("urn:test:y1#p"), 2023, @2023-03-01, 230) { id "f2"; origin case_input; }
        assert days_absent_in_testing_period_from(entity_ref("urn:test:y1#p"), 2023, @2023-03-01, 0) { id "f3"; origin case_input; }
    }
    // testing period 2023-03-01..2023-12-31 has 306 days; 230 x 100 = 23000 >= 306 x 75 = 22950.
    evaluate truth(testing_period_from_meets_75_percent(entity_ref("urn:test:y1#p"), 2023, @2023-03-01));
    expect truth_status == TRUE_ONLY;
}

