test "S7702F7C-01-FIRST-FIVE-YEARS-CASH-VALUE-CONTRACT-CEILING" {
    given {
        context { decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; legal_time @2024-12-31; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert contract_issue_date_7702(entity_ref("urn:test:l33#c"), @2020-01-01) { id "f0"; origin case_input; }
        assert benefit_reducing_change_on(entity_ref("urn:test:l33#c"), @2024-12-31) { id "f1"; origin case_input; }
        assert cash_distribution_from_change(entity_ref("urn:test:l33#c"), @2024-12-31, 40000.00 USD) { id "f2"; origin case_input; }
        assert csv_immediately_before_reduction(entity_ref("urn:test:l33#c"), 90000.00 USD) { id "f3"; origin case_input; }
        assert net_single_premium_immediately_after_reduction(entity_ref("urn:test:l33#c"), 60000.00 USD) { id "f4"; origin case_input; }
        assert aggregate_premiums_paid_immediately_before_reduction(entity_ref("urn:test:l33#c"), 80000.00 USD) { id "f5"; origin case_input; }
        assert guideline_premium_limitation_with_adjustment(entity_ref("urn:test:l33#c"), 70000.00 USD) { id "f6"; origin case_input; }
        assert cash_value_corridor_immediately_after_reduction(entity_ref("urn:test:l33#c"), 85000.00 USD) { id "f7"; origin case_input; }
        assert contract_meets_a1_cash_value_test(entity_ref("urn:test:l33#c")) { id "f8"; origin case_input; }
    }
    // 90000 - 60000 = 30000.
    evaluate truth(recapture_ceiling(entity_ref("urn:test:l33#c"), @2024-12-31, 30000.00 USD));
    expect truth_status == TRUE_ONLY;
}

