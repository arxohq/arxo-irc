language "law.core" version "0.2";
package us.irc.definitions version "0.1.1";
namespace "urn:us:irc:definitions:clir";

// §7702 life insurance contract definition. `implemented_unverified`.

test "S7702-B-01-CASH-VALUE-NOT-EXCEEDING-NET-SINGLE-PREMIUM-MEETS-CVAT" {
    given {
        context { decision_time @2026-06-01T12:00:00Z; knowledge_time @2026-06-01T12:00:00Z; legal_time @2026-06-01; timezone "America/New_York"; }
        assert life_insurance_contract_under_applicable_law(entity_ref("urn:us:irc:case:c1")) { id "f0"; origin case_input; }
        assert cash_surrender_value_at(entity_ref("urn:us:irc:case:c1"), @2026-06-01, 50000 USD) { id "f1"; origin case_input; }
        assert net_single_premium_to_fund_future_benefits_at(entity_ref("urn:us:irc:case:c1"), @2026-06-01, 55000 USD) { id "f2"; origin case_input; }
    }
    evaluate truth(life_insurance_contract(entity_ref("urn:us:irc:case:c1")));
    expect truth_status == TRUE_ONLY;
}

test "S7702-B-02-CASH-VALUE-EXCEEDING-NET-SINGLE-PREMIUM-FAILS-CVAT" {
    given {
        context { decision_time @2026-06-01T12:00:00Z; knowledge_time @2026-06-01T12:00:00Z; legal_time @2026-06-01; timezone "America/New_York"; }
        assert life_insurance_contract_under_applicable_law(entity_ref("urn:us:irc:case:c2")) { id "f0"; origin case_input; }
        assert cash_surrender_value_at(entity_ref("urn:us:irc:case:c2"), @2026-06-01, 60000 USD) { id "f1"; origin case_input; }
        assert net_single_premium_to_fund_future_benefits_at(entity_ref("urn:us:irc:case:c2"), @2026-06-01, 55000 USD) { id "f2"; origin case_input; }
    }
    evaluate truth(cash_value_accumulation_test(entity_ref("urn:us:irc:case:c2")));
    expect truth_status == NEITHER;
}

test "S7702-CD-01-GUIDELINE-PREMIUM-AND-CORRIDOR-BOTH-MET-QUALIFIES-UNDER-GPT" {
    given {
        context { decision_time @2026-06-01T12:00:00Z; knowledge_time @2026-06-01T12:00:00Z; legal_time @2026-06-01; timezone "America/New_York"; }
        assert life_insurance_contract_under_applicable_law(entity_ref("urn:us:irc:case:c3")) { id "f0"; origin case_input; }
        assert sum_of_premiums_paid_to_date(entity_ref("urn:us:irc:case:c3"), @2026-06-01, 10000 USD) { id "f1"; origin case_input; }
        assert guideline_single_premium(entity_ref("urn:us:irc:case:c3"), 12000 USD) { id "f2"; origin case_input; }
        assert sum_of_guideline_level_premiums_to_date(entity_ref("urn:us:irc:case:c3"), @2026-06-01, 9000 USD) { id "f3"; origin case_input; }
        assert death_benefit_at(entity_ref("urn:us:irc:case:c3"), @2026-06-01, 100000 USD) { id "f4"; origin case_input; }
        assert applicable_percentage_of_cash_surrender_value_at(entity_ref("urn:us:irc:case:c3"), @2026-06-01, 90000 USD) { id "f5"; origin case_input; }
    }
    evaluate truth(life_insurance_contract(entity_ref("urn:us:irc:case:c3")));
    expect truth_status == TRUE_ONLY;
}

test "S7702-CD-02-PREMIUMS-PAID-EXCEEDING-GUIDELINE-LIMITATION-FAILS-GPT-REQUIREMENT" {
    given {
        context { decision_time @2026-06-01T12:00:00Z; knowledge_time @2026-06-01T12:00:00Z; legal_time @2026-06-01; timezone "America/New_York"; }
        assert sum_of_premiums_paid_to_date(entity_ref("urn:us:irc:case:c4"), @2026-06-01, 13000 USD) { id "f0"; origin case_input; }
        assert guideline_single_premium(entity_ref("urn:us:irc:case:c4"), 12000 USD) { id "f1"; origin case_input; }
        assert sum_of_guideline_level_premiums_to_date(entity_ref("urn:us:irc:case:c4"), @2026-06-01, 9000 USD) { id "f2"; origin case_input; }
    }
    evaluate truth(meets_guideline_premium_requirements(entity_ref("urn:us:irc:case:c4")));
    expect truth_status == NEITHER;
}

test "S7702-G-01-CONTRACT-FAILING-BOTH-TESTS-LOSES-LIFE-INSURANCE-DEFINITION" {
    given {
        context { decision_time @2026-06-01T12:00:00Z; knowledge_time @2026-06-01T12:00:00Z; legal_time @2026-06-01; timezone "America/New_York"; }
        assert life_insurance_contract_under_applicable_law(entity_ref("urn:us:irc:case:c5")) { id "f0"; origin case_input; }
        assert cash_surrender_value_at(entity_ref("urn:us:irc:case:c5"), @2026-06-01, 60000 USD) { id "f1"; origin case_input; }
        assert net_single_premium_to_fund_future_benefits_at(entity_ref("urn:us:irc:case:c5"), @2026-06-01, 55000 USD) { id "f2"; origin case_input; }
        assert sum_of_premiums_paid_to_date(entity_ref("urn:us:irc:case:c5"), @2026-06-01, 13000 USD) { id "f3"; origin case_input; }
        assert guideline_single_premium(entity_ref("urn:us:irc:case:c5"), 12000 USD) { id "f4"; origin case_input; }
        assert sum_of_guideline_level_premiums_to_date(entity_ref("urn:us:irc:case:c5"), @2026-06-01, 9000 USD) { id "f5"; origin case_input; }
    }
    evaluate truth(fails_life_insurance_contract_definition(entity_ref("urn:us:irc:case:c5")));
    expect truth_status == TRUE_ONLY;
}
