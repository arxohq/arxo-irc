    }
    evaluate truth(exempt_individual_for_year(entity_ref("urn:us:irc:case:st1"), 2026));
    expect truth_status == TRUE_ONLY;
}

test "S7701-B6-01-STATUS-HELD-AND-NOT-REVOKED-IS-LAWFUL-PERMANENT-RESIDENT" {
    given {
        context { decision_time @2026-06-01T12:00:00Z; knowledge_time @2026-06-01T12:00:00Z; legal_time @2026-06-01; timezone "America/New_York"; }
        assert accorded_privilege_of_permanent_residence_as_immigrant(entity_ref("urn:us:irc:case:lpr2")) { id "f0"; origin case_input; }
        assert status_not_revoked_or_judicially_abandoned(entity_ref("urn:us:irc:case:lpr2")) { id "f1"; origin case_input; }
    }
    evaluate truth(lawful_permanent_resident(entity_ref("urn:us:irc:case:lpr2")));
    expect truth_status == TRUE_ONLY;
}

test "S7701-B6-02-TREATY-RESIDENCY-ELECTION-DEFEATS-LAWFUL-PERMANENT-RESIDENT-STATUS" {
    given {
        context { decision_time @2026-06-01T12:00:00Z; knowledge_time @2026-06-01T12:00:00Z; legal_time @2026-06-01; timezone "America/New_York"; }
        assert accorded_privilege_of_permanent_residence_as_immigrant(entity_ref("urn:us:irc:case:lpr3")) { id "f0"; origin case_input; }
        assert status_not_revoked_or_judicially_abandoned(entity_ref("urn:us:irc:case:lpr3")) { id "f1"; origin case_input; }
        assert treaty_residency_election_made(entity_ref("urn:us:irc:case:lpr3")) { id "f2"; origin case_input; }
    }
    evaluate truth(lawful_permanent_resident(entity_ref("urn:us:irc:case:lpr3")));
    expect truth_status == NEITHER;
}
