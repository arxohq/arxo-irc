language "law.core" version "0.2";
package us.irc.definitions version "0.1.1";
namespace "urn:us:irc:definitions:clir";

// §7701(b) substantial presence test and residency rules. `implemented_unverified`.

test "S7701-B3-01-183-DAYS-CURRENT-YEAR-ALONE-MEETS-WEIGHTED-THRESHOLD" {
    given {
        context { decision_time @2027-01-15T12:00:00Z; knowledge_time @2027-01-15T12:00:00Z; legal_time @2027-01-15; timezone "America/New_York"; }
        assert days_present_current_year(entity_ref("urn:us:irc:case:al1"), 2026, 183) { id "f0"; origin case_input; }
        assert days_present_first_preceding_year(entity_ref("urn:us:irc:case:al1"), 2026, 0) { id "f1"; origin case_input; }
        assert days_present_second_preceding_year(entity_ref("urn:us:irc:case:al1"), 2026, 0) { id "f2"; origin case_input; }
    }
    evaluate truth(substantial_presence_test(entity_ref("urn:us:irc:case:al1"), 2026));
    expect truth_status == TRUE_ONLY;
}

test "S7701-B3-02-182-DAYS-CURRENT-YEAR-ALONE-FAILS-WEIGHTED-THRESHOLD" {
    given {
        context { decision_time @2027-01-15T12:00:00Z; knowledge_time @2027-01-15T12:00:00Z; legal_time @2027-01-15; timezone "America/New_York"; }
        assert days_present_current_year(entity_ref("urn:us:irc:case:al2"), 2026, 182) { id "f0"; origin case_input; }
        assert days_present_first_preceding_year(entity_ref("urn:us:irc:case:al2"), 2026, 0) { id "f1"; origin case_input; }
        assert days_present_second_preceding_year(entity_ref("urn:us:irc:case:al2"), 2026, 0) { id "f2"; origin case_input; }
    }
    evaluate truth(substantial_presence_test(entity_ref("urn:us:irc:case:al2"), 2026));
    expect truth_status == NEITHER;
}

test "S7701-B3-03-120-EACH-YEAR-EQUALS-EXACTLY-183-WEIGHTED" {
    // 120 + 120/3 + 120/6 = 120 + 40 + 20 = 180: below threshold, confirms
    // the weighting is applied (not a naive sum of 360).
    given {
        context { decision_time @2027-01-15T12:00:00Z; knowledge_time @2027-01-15T12:00:00Z; legal_time @2027-01-15; timezone "America/New_York"; }
        assert days_present_current_year(entity_ref("urn:us:irc:case:al3"), 2026, 120) { id "f0"; origin case_input; }
        assert days_present_first_preceding_year(entity_ref("urn:us:irc:case:al3"), 2026, 120) { id "f1"; origin case_input; }
        assert days_present_second_preceding_year(entity_ref("urn:us:irc:case:al3"), 2026, 120) { id "f2"; origin case_input; }
    }
    evaluate truth(meets_weighted_183_day_threshold(entity_ref("urn:us:irc:case:al3"), 2026));
    expect truth_status == NEITHER;
}

test "S7701-B3-04-THIRTY-ONE-DAY-THRESHOLD-NOT-MET-BLOCKS-TEST-EVEN-IF-WEIGHTED-SUM-IS-HIGH" {
    // 30 current-year days cannot meet the 31-day gate, regardless of prior years.
    given {
        context { decision_time @2027-01-15T12:00:00Z; knowledge_time @2027-01-15T12:00:00Z; legal_time @2027-01-15; timezone "America/New_York"; }
        assert days_present_current_year(entity_ref("urn:us:irc:case:al4"), 2026, 30) { id "f0"; origin case_input; }
        assert days_present_first_preceding_year(entity_ref("urn:us:irc:case:al4"), 2026, 365) { id "f1"; origin case_input; }
        assert days_present_second_preceding_year(entity_ref("urn:us:irc:case:al4"), 2026, 365) { id "f2"; origin case_input; }
    }
    evaluate truth(substantial_presence_test(entity_ref("urn:us:irc:case:al4"), 2026));
    expect truth_status == NEITHER;
}

test "S7701-B3-05-CLOSER-CONNECTION-EXCEPTION-DEFEATS-TEST-UNDER-183-DAYS" {
    given {
        context { decision_time @2027-01-15T12:00:00Z; knowledge_time @2027-01-15T12:00:00Z; legal_time @2027-01-15; timezone "America/New_York"; }
        assert days_present_current_year(entity_ref("urn:us:irc:case:al5"), 2026, 180) { id "f0"; origin case_input; }
        assert days_present_first_preceding_year(entity_ref("urn:us:irc:case:al5"), 2026, 300) { id "f1"; origin case_input; }
        assert days_present_second_preceding_year(entity_ref("urn:us:irc:case:al5"), 2026, 300) { id "f2"; origin case_input; }
        assert tax_home_in_foreign_country(entity_ref("urn:us:irc:case:al5"), 2026) { id "f3"; origin case_input; }
        assert closer_connection_to_foreign_country(entity_ref("urn:us:irc:case:al5"), 2026) { id "f4"; origin case_input; }
    }
    evaluate truth(substantial_presence_test(entity_ref("urn:us:irc:case:al5"), 2026));
    expect truth_status == NEITHER;
}

test "S7701-B3-06-PENDING-ADJUSTMENT-OF-STATUS-DEFEATS-CLOSER-CONNECTION-EXCEPTION" {
    given {
        context { decision_time @2027-01-15T12:00:00Z; knowledge_time @2027-01-15T12:00:00Z; legal_time @2027-01-15; timezone "America/New_York"; }
        assert days_present_current_year(entity_ref("urn:us:irc:case:al6"), 2026, 180) { id "f0"; origin case_input; }
        assert days_present_first_preceding_year(entity_ref("urn:us:irc:case:al6"), 2026, 300) { id "f1"; origin case_input; }
        assert days_present_second_preceding_year(entity_ref("urn:us:irc:case:al6"), 2026, 300) { id "f2"; origin case_input; }
        assert tax_home_in_foreign_country(entity_ref("urn:us:irc:case:al6"), 2026) { id "f3"; origin case_input; }
        assert closer_connection_to_foreign_country(entity_ref("urn:us:irc:case:al6"), 2026) { id "f4"; origin case_input; }
        assert application_for_adjustment_of_status_pending(entity_ref("urn:us:irc:case:al6"), 2026) { id "f5"; origin case_input; }
    }
    evaluate truth(substantial_presence_test(entity_ref("urn:us:irc:case:al6"), 2026));
    expect truth_status == TRUE_ONLY;
}

test "S7701-B1-01-LAWFUL-PERMANENT-RESIDENT-IS-RESIDENT-ALIEN" {
    given {
        context { decision_time @2026-06-01T12:00:00Z; knowledge_time @2026-06-01T12:00:00Z; legal_time @2026-06-01; timezone "America/New_York"; }
        assert lawfully_admitted_for_permanent_residence(entity_ref("urn:us:irc:case:lpr1"), 2026) { id "f0"; origin case_input; }
    }
    evaluate truth(resident_alien_for_year(entity_ref("urn:us:irc:case:lpr1"), 2026));
    expect truth_status == TRUE_ONLY;
}

test "S7701-B1-02-NEITHER-CITIZEN-NOR-RESIDENT-IS-NONRESIDENT-ALIEN" {
    given {
        context { decision_time @2026-06-01T12:00:00Z; knowledge_time @2026-06-01T12:00:00Z; legal_time @2026-06-01; timezone "America/New_York"; }
