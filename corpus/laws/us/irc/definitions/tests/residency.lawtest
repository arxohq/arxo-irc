test "S7701-B2-01-RESIDENCY-STARTING-DATE-FOR-SUBSTANTIAL-PRESENCE-FIRST-DAY" {
    given {
        context { decision_time @2027-01-15T12:00:00Z; knowledge_time @2027-01-15T12:00:00Z; legal_time @2027-01-15; timezone "America/New_York"; }
        assert days_present_current_year(entity_ref("urn:us:irc:case:sy1"), 2026, 200) { id "f0"; origin case_input; }
        assert days_present_first_preceding_year(entity_ref("urn:us:irc:case:sy1"), 2026, 0) { id "f1"; origin case_input; }
        assert days_present_second_preceding_year(entity_ref("urn:us:irc:case:sy1"), 2026, 0) { id "f2"; origin case_input; }
        assert first_day_present_in_calendar_year(entity_ref("urn:us:irc:case:sy1"), 2026, @2026-03-10) { id "f3"; origin case_input; }
    }
    evaluate truth(residency_starting_date(entity_ref("urn:us:irc:case:sy1"), 2026, @2026-03-10));
    expect truth_status == TRUE_ONLY;
}

test "S7701-B2-02-RESIDENCY-TERMINATION-DATE-WHEN-ALL-THREE-CONDITIONS-MET" {
    given {
        context { decision_time @2027-01-15T12:00:00Z; knowledge_time @2027-01-15T12:00:00Z; legal_time @2027-01-15; timezone "America/New_York"; }
        assert last_day_present_in_calendar_year(entity_ref("urn:us:irc:case:ly1"), 2026, @2026-09-01) { id "f0"; origin case_input; }
        assert closer_connection_to_foreign_country_after(entity_ref("urn:us:irc:case:ly1"), 2026, @2026-09-01) { id "f1"; origin case_input; }
    }
    evaluate truth(not_resident_for_portion_after(entity_ref("urn:us:irc:case:ly1"), 2026, @2026-09-01));
    expect truth_status == TRUE_ONLY;
}

