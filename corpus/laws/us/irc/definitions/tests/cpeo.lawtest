language "law.core" version "0.2";
package us.irc.definitions version "0.1.1";
namespace "urn:us:irc:definitions:clir";

// §7705 certified professional employer organization. `implemented_unverified`.

test "S7705-B-01-ALL-SIX-CONDITIONS-MEET-CERTIFICATION-REQUIREMENTS" {
    given {
        context { decision_time @2026-06-01T12:00:00Z; knowledge_time @2026-06-01T12:00:00Z; legal_time @2026-06-01; timezone "America/New_York"; }
        assert demonstrates_secretary_prescribed_requirements(entity_ref("urn:us:irc:case:o1")) { id "f0"; origin case_input; }
        assert agrees_to_ongoing_bond_and_review_requirements(entity_ref("urn:us:irc:case:o1")) { id "f1"; origin case_input; }
        assert agrees_to_secretary_reporting_obligations(entity_ref("urn:us:irc:case:o1")) { id "f2"; origin case_input; }
        assert computes_taxable_income_on_accrual_method_or_approved_alternative(entity_ref("urn:us:irc:case:o1")) { id "f3"; origin case_input; }
        assert agrees_to_periodic_verification_of_continued_compliance(entity_ref("urn:us:irc:case:o1")) { id "f4"; origin case_input; }
        assert agrees_to_notify_secretary_of_material_changes(entity_ref("urn:us:irc:case:o1")) { id "f5"; origin case_input; }
    }
    evaluate truth(meets_certification_requirements(entity_ref("urn:us:irc:case:o1")));
    expect truth_status == TRUE_ONLY;
}

test "S7705-B-02-MISSING-ONE-CONDITION-LEAVES-CERTIFICATION-REQUIREMENTS-UNDETERMINED" {
    given {
        context { decision_time @2026-06-01T12:00:00Z; knowledge_time @2026-06-01T12:00:00Z; legal_time @2026-06-01; timezone "America/New_York"; }
        assert demonstrates_secretary_prescribed_requirements(entity_ref("urn:us:irc:case:o2")) { id "f0"; origin case_input; }
        assert agrees_to_ongoing_bond_and_review_requirements(entity_ref("urn:us:irc:case:o2")) { id "f1"; origin case_input; }
        assert agrees_to_secretary_reporting_obligations(entity_ref("urn:us:irc:case:o2")) { id "f2"; origin case_input; }
        assert computes_taxable_income_on_accrual_method_or_approved_alternative(entity_ref("urn:us:irc:case:o2")) { id "f3"; origin case_input; }
        assert agrees_to_periodic_verification_of_continued_compliance(entity_ref("urn:us:irc:case:o2")) { id "f4"; origin case_input; }
    }
    evaluate truth(meets_certification_requirements(entity_ref("urn:us:irc:case:o2")));
    expect truth_status == NEITHER;
}

test "S7705-C-01-FIVE-PERCENT-BOND-WITHIN-FLOOR-AND-CAP" {
    given {
        context { decision_time @2026-06-01T12:00:00Z; knowledge_time @2026-06-01T12:00:00Z; legal_time @2026-06-01; timezone "America/New_York"; }
        assert prior_calendar_year_section_3511_liability(entity_ref("urn:us:irc:case:o3"), 2000000 USD) { id "f0"; origin case_input; }
    }
    evaluate truth(required_bond_amount(entity_ref("urn:us:irc:case:o3"), 100000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S7705-C-02-BOND-CAPPED-AT-ONE-MILLION" {
    given {
        context { decision_time @2026-06-01T12:00:00Z; knowledge_time @2026-06-01T12:00:00Z; legal_time @2026-06-01; timezone "America/New_York"; }
        assert prior_calendar_year_section_3511_liability(entity_ref("urn:us:irc:case:o4"), 30000000 USD) { id "f0"; origin case_input; }
    }
    evaluate truth(required_bond_amount(entity_ref("urn:us:irc:case:o4"), 1000000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S7705-C-03-BOND-FLOORED-AT-FIFTY-THOUSAND" {
    given {
        context { decision_time @2026-06-01T12:00:00Z; knowledge_time @2026-06-01T12:00:00Z; legal_time @2026-06-01; timezone "America/New_York"; }
        assert prior_calendar_year_section_3511_liability(entity_ref("urn:us:irc:case:o5"), 200000 USD) { id "f0"; origin case_input; }
    }
    evaluate truth(required_bond_amount(entity_ref("urn:us:irc:case:o5"), 50000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S7705-A-01-CERTIFICATION-VALID-WHEN-REQUIREMENTS-MET" {
    given {
        context { decision_time @2026-06-01T12:00:00Z; knowledge_time @2026-06-01T12:00:00Z; legal_time @2026-06-01; timezone "America/New_York"; }
        assert applies_for_cpeo_certification(entity_ref("urn:us:irc:case:o6")) { id "f0"; origin case_input; }
        assert demonstrates_secretary_prescribed_requirements(entity_ref("urn:us:irc:case:o6")) { id "f1"; origin case_input; }
        assert agrees_to_ongoing_bond_and_review_requirements(entity_ref("urn:us:irc:case:o6")) { id "f2"; origin case_input; }
        assert agrees_to_secretary_reporting_obligations(entity_ref("urn:us:irc:case:o6")) { id "f3"; origin case_input; }
        assert computes_taxable_income_on_accrual_method_or_approved_alternative(entity_ref("urn:us:irc:case:o6")) { id "f4"; origin case_input; }
        assert agrees_to_periodic_verification_of_continued_compliance(entity_ref("urn:us:irc:case:o6")) { id "f5"; origin case_input; }
        assert agrees_to_notify_secretary_of_material_changes(entity_ref("urn:us:irc:case:o6")) { id "f6"; origin case_input; }
        assert secretary_certifies(entity_ref("urn:us:irc:case:o6")) { id "f7"; origin case_input; }
    }
    evaluate truth(certified_professional_employer_organization(entity_ref("urn:us:irc:case:o6")));
    expect truth_status == TRUE_ONLY;
}

test "S7705-A-02-CERTIFICATION-ATTEMPT-INVALID-WITHOUT-REQUIREMENTS-HAS-NO-EFFECT" {
    given {
        context { decision_time @2026-06-01T12:00:00Z; knowledge_time @2026-06-01T12:00:00Z; legal_time @2026-06-01; timezone "America/New_York"; }
        assert applies_for_cpeo_certification(entity_ref("urn:us:irc:case:o7")) { id "f0"; origin case_input; }
        assert secretary_certifies(entity_ref("urn:us:irc:case:o7")) { id "f1"; origin case_input; }
    }
    evaluate truth(certified_professional_employer_organization(entity_ref("urn:us:irc:case:o7")));
    expect truth_status == NEITHER;
}

test "S7705-D-01-SECRETARY-MAY-SUSPEND-CERTIFICATION-ON-GROUNDS" {
    given {
        context { decision_time @2026-06-01T12:00:00Z; knowledge_time @2026-06-01T12:00:00Z; legal_time @2026-06-01; timezone "America/New_York"; }
        assert applies_for_cpeo_certification(entity_ref("urn:us:irc:case:o8")) { id "f0"; origin case_input; }
        assert demonstrates_secretary_prescribed_requirements(entity_ref("urn:us:irc:case:o8")) { id "f1"; origin case_input; }
        assert agrees_to_ongoing_bond_and_review_requirements(entity_ref("urn:us:irc:case:o8")) { id "f2"; origin case_input; }
        assert agrees_to_secretary_reporting_obligations(entity_ref("urn:us:irc:case:o8")) { id "f3"; origin case_input; }
        assert computes_taxable_income_on_accrual_method_or_approved_alternative(entity_ref("urn:us:irc:case:o8")) { id "f4"; origin case_input; }
        assert agrees_to_periodic_verification_of_continued_compliance(entity_ref("urn:us:irc:case:o8")) { id "f5"; origin case_input; }
        assert agrees_to_notify_secretary_of_material_changes(entity_ref("urn:us:irc:case:o8")) { id "f6"; origin case_input; }
        assert secretary_certifies(entity_ref("urn:us:irc:case:o8")) { id "f7"; origin case_input; }
        assert not_satisfying_b_or_c_agreements_or_requirements(entity_ref("urn:us:irc:case:o8")) { id "f8"; origin case_input; }
        assert secretary_suspends_or_revokes_certification(entity_ref("urn:us:irc:case:o8")) { id "f9"; origin case_input; }
    }
    evaluate truth(certification_suspended_or_revoked(entity_ref("urn:us:irc:case:o8")));
    expect truth_status == TRUE_ONLY;
}
