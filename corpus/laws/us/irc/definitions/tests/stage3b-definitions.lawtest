test "S7702J-01-CHURCH-PLAN-PROVIDED-DIRECTLY-DISREGARDS-APPLICABLE-LAW-REQUIREMENT" {
    given {
        context { decision_time @2024-06-01T09:00:00-05:00; knowledge_time @2024-06-01T09:00:00-05:00; legal_time @2024-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert plan_pays_benefits_by_reason_of_death_of_covered_individuals(entity_ref("urn:test:n1#c")) { id "f0"; origin case_input; }
        assert plan_provider(entity_ref("urn:test:n1#c"), entity_ref("urn:test:n1#ch")) { id "f1"; origin case_input; }
        assert is_a_church(entity_ref("urn:test:n1#ch")) { id "f2"; origin case_input; }
        assert plan_benefits_employees_and_beneficiaries(entity_ref("urn:test:n1#c")) { id "f3"; origin case_input; }
        assert plan_provided_directly(entity_ref("urn:test:n1#c")) { id "f4"; origin case_input; }
        assert cash_value_accumulation_test(entity_ref("urn:test:n1#c")) { id "f5"; origin case_input; }
    }
    // no life_insurance_contract_under_applicable_law fact: subsection (j)(1) disregards that requirement.
    evaluate truth(life_insurance_contract(entity_ref("urn:test:n1#c")));
    expect truth_status == TRUE_ONLY;
}

