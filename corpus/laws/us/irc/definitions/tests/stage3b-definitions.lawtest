        assert dollar_limitation_on_application_of_402e3(entity_ref("urn:test:s5#t"), 23000.0 USD) { id "f3"; origin case_input; }
        assert thrift_contribution_barred_by_401k4B(entity_ref("urn:test:s5#t")) { id "f4"; origin case_input; }
    }
    evaluate truth(not_treated_as_distributed_or_made_available_and_not_as_employee_contribution(entity_ref("urn:test:s5#t")));
    expect truth_status == NEITHER;
}

