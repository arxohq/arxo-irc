language "law.core" version "0.2";
package us.irc.definitions version "0.1.1";
namespace "urn:us:irc:definitions:clir";

// §7703(a)-(b). `implemented_unverified`.

test "S7703-A-01-MARRIED-AT-CLOSE-OF-YEAR-IS-MARRIED" {
    given {
        context { decision_time @2027-01-15T12:00:00Z; knowledge_time @2027-01-15T12:00:00Z; legal_time @2027-01-15; timezone "America/New_York"; }
        assert married_as_of_close_of_taxable_year(entity_ref("urn:us:irc:case:m1"), entity_ref("urn:us:irc:case:y2026")) { id "f0"; origin case_input; }
    }
    evaluate truth(married_for_this_title(entity_ref("urn:us:irc:case:m1"), entity_ref("urn:us:irc:case:y2026")));
    expect truth_status == TRUE_ONLY;
}

test "S7703-A-02-LEGALLY-SEPARATED-UNDER-DECREE-IS-NOT-MARRIED-EVEN-IF-MARRIED-AT-CLOSE-OF-YEAR" {
    given {
        context { decision_time @2027-01-15T12:00:00Z; knowledge_time @2027-01-15T12:00:00Z; legal_time @2027-01-15; timezone "America/New_York"; }
        assert married_as_of_close_of_taxable_year(entity_ref("urn:us:irc:case:m2"), entity_ref("urn:us:irc:case:y2026")) { id "f0"; origin case_input; }
        assert legally_separated_under_decree_of_divorce_or_separate_maintenance(entity_ref("urn:us:irc:case:m2"), entity_ref("urn:us:irc:case:y2026")) { id "f1"; origin case_input; }
    }
    evaluate truth(married_for_this_title(entity_ref("urn:us:irc:case:m2"), entity_ref("urn:us:irc:case:y2026")));
    expect truth_status == NEITHER;
}

test "S7703-A-03-LEGALLY-SEPARATED-IS-AFFIRMATIVELY-NOT-MARRIED" {
    given {
        context { decision_time @2027-01-15T12:00:00Z; knowledge_time @2027-01-15T12:00:00Z; legal_time @2027-01-15; timezone "America/New_York"; }
        assert legally_separated_under_decree_of_divorce_or_separate_maintenance(entity_ref("urn:us:irc:case:m3"), entity_ref("urn:us:irc:case:y2026")) { id "f0"; origin case_input; }
    }
    evaluate truth(not_married_for_this_title(entity_ref("urn:us:irc:case:m3"), entity_ref("urn:us:irc:case:y2026")));
    expect truth_status == TRUE_ONLY;
}

test "S7703-A-04-SPOUSE-DIED-DURING-YEAR-DETERMINATION-AT-DEATH" {
    given {
        context { decision_time @2027-01-15T12:00:00Z; knowledge_time @2027-01-15T12:00:00Z; legal_time @2027-01-15; timezone "America/New_York"; }
        assert spouse_died_during_taxable_year(entity_ref("urn:us:irc:case:m4"), entity_ref("urn:us:irc:case:y2026")) { id "f0"; origin case_input; }
        assert married_at_time_of_spouses_death(entity_ref("urn:us:irc:case:m4"), entity_ref("urn:us:irc:case:y2026")) { id "f1"; origin case_input; }
    }
    evaluate truth(married_for_this_title(entity_ref("urn:us:irc:case:m4"), entity_ref("urn:us:irc:case:y2026")));
    expect truth_status == TRUE_ONLY;
}

test "S7703-B-01-LIVING-APART-WITH-DEPENDENT-CHILD-ALL-CONDITIONS-MET-IS-CONSIDERED-UNMARRIED" {
    given {
        context { decision_time @2027-01-15T12:00:00Z; knowledge_time @2027-01-15T12:00:00Z; legal_time @2027-01-15; timezone "America/New_York"; }
        assert married_within_meaning_of_subsection_a(entity_ref("urn:us:irc:case:m5"), entity_ref("urn:us:irc:case:y2026")) { id "f0"; origin case_input; }
        assert files_separate_return(entity_ref("urn:us:irc:case:m5"), entity_ref("urn:us:irc:case:y2026")) { id "f1"; origin case_input; }
        assert household_is_principal_place_of_abode_of_child_more_than_half_year(entity_ref("urn:us:irc:case:m5"), entity_ref("urn:us:irc:case:y2026"), entity_ref("urn:us:irc:case:child1")) { id "f2"; origin case_input; }
        assert entitled_to_151_deduction_for_child_or_would_be_but_for_152e(entity_ref("urn:us:irc:case:m5"), entity_ref("urn:us:irc:case:y2026"), entity_ref("urn:us:irc:case:child1")) { id "f3"; origin case_input; }
        assert furnishes_over_half_cost_of_maintaining_household(entity_ref("urn:us:irc:case:m5"), entity_ref("urn:us:irc:case:y2026")) { id "f4"; origin case_input; }
        assert spouse_not_member_of_household_during_last_six_months(entity_ref("urn:us:irc:case:m5"), entity_ref("urn:us:irc:case:y2026")) { id "f5"; origin case_input; }
    }
    evaluate truth(considered_unmarried_under_living_apart_rule(entity_ref("urn:us:irc:case:m5"), entity_ref("urn:us:irc:case:y2026")));
    expect truth_status == TRUE_ONLY;
}

test "S7703-B-02-SPOUSE-STILL-IN-HOUSEHOLD-DURING-LAST-SIX-MONTHS-FAILS-LIVING-APART-RULE" {
    given {
        context { decision_time @2027-01-15T12:00:00Z; knowledge_time @2027-01-15T12:00:00Z; legal_time @2027-01-15; timezone "America/New_York"; }
        assert married_within_meaning_of_subsection_a(entity_ref("urn:us:irc:case:m6"), entity_ref("urn:us:irc:case:y2026")) { id "f0"; origin case_input; }
        assert files_separate_return(entity_ref("urn:us:irc:case:m6"), entity_ref("urn:us:irc:case:y2026")) { id "f1"; origin case_input; }
        assert household_is_principal_place_of_abode_of_child_more_than_half_year(entity_ref("urn:us:irc:case:m6"), entity_ref("urn:us:irc:case:y2026"), entity_ref("urn:us:irc:case:child2")) { id "f2"; origin case_input; }
        assert entitled_to_151_deduction_for_child_or_would_be_but_for_152e(entity_ref("urn:us:irc:case:m6"), entity_ref("urn:us:irc:case:y2026"), entity_ref("urn:us:irc:case:child2")) { id "f3"; origin case_input; }
        assert furnishes_over_half_cost_of_maintaining_household(entity_ref("urn:us:irc:case:m6"), entity_ref("urn:us:irc:case:y2026")) { id "f4"; origin case_input; }
    }
    evaluate truth(considered_unmarried_under_living_apart_rule(entity_ref("urn:us:irc:case:m6"), entity_ref("urn:us:irc:case:y2026")));
    expect truth_status == NEITHER;
}
