language "law.core" version "0.2";
package us.irc.definitions version "0.1.1";
namespace "urn:us:irc:definitions:clir";

// §7701(a) classifications, stage 1. Written per AGENT-BRIEF (applies/does
// not apply, unknown fact -> NEITHER); NOT executed (owner's NO-HEAVY-CHECKS
// restriction) — `implemented_unverified`.

test "S7701-A1-01-INDIVIDUAL-IS-A-PERSON" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "America/New_York"; }
    }
    evaluate truth(person(entity_ref("urn:us:irc:case:p1")));
    expect truth_status == TRUE_ONLY;
}

