// Stage 3 (26.09.2026) — leftovers of stage 1 that are plain conditions:
// section 7701(b)(4) first-year election and (b)(10) coordination with section
// 877; section 7702(h) endowment contracts and (i) qualified 20-pay contracts;
// section 7705(e) work site employees.
//
// JUDGMENT CALLS
//  - (b)(4)(A)(iv): the 31-day runs and the day counts of the testing period are
//    asserted per candidate start date (a scan of daily presence is not derived,
//    the same reduction the stage-1 substantial-presence test uses). The 5
//    days treated as present are added to the counted days, capped by the number
//    of days of the period. 75 percent is compared as
//    (present + treated) x 100 >= 75 x days in the period (no rounding invented).
//  - (b)(4)(A)(iii): the substantial presence test for the FOLLOWING year is read
//    from `substantial_presence_test(p, y + 1)`.
//  - (b)(10): the tax comparison of the last sentence and the 877(b) regime itself
//    belong to the international owner; here the conditions and the comparison
//    over asserted amounts are derived and the period to which the 877(b) regime
//    applies is named.

language "law.core" version "0.2";
package us.irc.definitions version "0.1.1";
namespace "urn:us:irc:definitions:clir";

use self::{
    IRC_S7701,
    IRC_S7702_H,
    IRC_S7702_I,
    IRC_S7705_E,
    Individual,
    InsuranceContract,
    Person,
    ProfessionalEmployerOrganization,
    cash_value_accumulation_test,
    lawfully_admitted_for_permanent_residence,
    life_insurance_contract_under_applicable_law,
    meets_guideline_premium_test,
    resident_in_preceding_calendar_year,
    substantial_presence_test,
};

// ============================================================================
// §7701(b)(4) first-year election
// ============================================================================

pub relation election_year_last_day(p: Individual, y: Integer, d: Date) kind empirical { label en official "the last day of the election year (the last day of the calendar year y)"; }
pub relation present_run_of_at_least_31_days_from(p: Individual, y: Integer, start: Date) kind empirical { label en official "the individual is present in the United States for a period of at least 31 consecutive days in the election year beginning on start (subclause (I))"; }
pub relation days_present_in_testing_period_from(p: Individual, y: Integer, start: Date, n: Integer) kind empirical { label en official "the number of days on which the individual is present in the United States (day_counts_as_present_in_us, so exempt-individual and medical days do not count, subparagraph (D)) during the period beginning with the first day of the 31-day period and ending with the last day of the election year"; }
pub relation days_absent_in_testing_period_from(p: Individual, y: Integer, start: Date, n: Integer) kind empirical { label en official "the number of days of absence from the United States in that testing period"; }
pub relation testing_period_from_meets_75_percent(p: Individual, y: Integer, start: Date) kind institutional {
    label en official "present in the United States during the testing period for a number of days equal to or exceeding 75 percent of the number of days in the period, up to 5 days of absence counting as presence";
}
@source(IRC_S7701, coverage = partial, quote = "for a number of days equal to or exceeding 75 percent of the number of days in the testing period")
rule TestingPeriodMeetsSeventyFivePercent strict {
    for p: Individual; for y: Integer; for start: Date; for last: Date; for present: Integer; for absent: Integer;
    when present_run_of_at_least_31_days_from(p, y, start) and election_year_last_day(p, y, last)
        and days_present_in_testing_period_from(p, y, start, present) and days_absent_in_testing_period_from(p, y, start, absent)
        and (present + min(absent, 5)) * 100 >= (days_between(start, last) + 1) * 75;
    then testing_period_from_meets_75_percent(p, y, start);
}
pub relation election_year_requirement_iv_met(p: Individual, y: Integer) kind institutional { label en official "clause (iv): present for at least 31 consecutive days and the 75-percent testing period rule met"; }
rule ClauseIvMetByAnyTestingPeriod strict { for p: Individual; for y: Integer; for start: Date; when testing_period_from_meets_75_percent(p, y, start); then election_year_requirement_iv_met(p, y); }
pub relation first_year_election_requirements_met(p: Individual, y: Integer) kind institutional {
    label en official "the alien individual meets the requirements of subparagraph (A): (i) not a resident under clause (i) or (ii) of (1)(A) for the election year, (ii) not a resident for the preceding year, (iii) a resident under clause (ii) of (1)(A) for the following year, (iv) the 31-day and 75-percent rules";
}
@source(IRC_S7701, coverage = partial, quote = "(iii) is a resident of the United States under clause (ii) of paragraph (1)(A) with respect to the calendar year immediately following the election year, and")
rule FirstYearElectionRequirementsMet strict {
    for p: Individual; for y: Integer;
    when election_year_requirement_iv_met(p, y) and substantial_presence_test(p, y + 1)
        and not_known(lawfully_admitted_for_permanent_residence(p, y)) and not_known(substantial_presence_test(p, y))
        and not_known(resident_in_preceding_calendar_year(p, y));
    then first_year_election_requirements_met(p, y);
}
pub relation first_year_election_made_on(p: Individual, y: Integer, d: Date) kind empirical { label en official "the election is made (on the individual's tax return for the election year) on the date"; }
pub relation substantial_presence_test_for_following_year_met_on(p: Individual, y: Integer, d: Date) kind empirical { label en official "the date the individual first met the substantial presence test for the calendar year following the election year"; }
pub relation first_year_election_timely_made(p: Individual, y: Integer) kind institutional { label en official "the election is not made before the individual has met the substantial presence test for the following year"; }
@source(IRC_S7701, coverage = partial, quote = "such election may not be made before the individual has met the substantial presence test of paragraph (3) with respect to the calendar year immediately following the election year")
rule FirstYearElectionNotBeforeSubstantialPresenceMet strict {
    for p: Individual; for y: Integer; for made: Date; for met: Date;
    when first_year_election_made_on(p, y, made) and substantial_presence_test_for_following_year_met_on(p, y, met) and made >= met;
    then first_year_election_timely_made(p, y);
}
pub relation first_year_election_valid(p: Individual, y: Integer) kind institutional { label en official "the requirements of (A) are met and the election is made at a permitted time"; }
rule FirstYearElectionValid strict { for p: Individual; for y: Integer; when first_year_election_requirements_met(p, y) and first_year_election_timely_made(p, y); then first_year_election_valid(p, y); }
pub relation first_year_election_in_effect(p: Individual, y: Integer) kind institutional { label en official "a valid election under (B): the individual is treated as a resident with respect to the election year"; }
@source(IRC_S7701, coverage = partial, quote = "An alien individual who meets the requirements of subparagraph (A) shall, if he so elects, be treated as a resident of the United States with respect to the election year.")
rule FirstYearElectionPower strict {
    label en official "an alien individual meeting (A) may elect to be treated as a resident for the election year (subparagraph (B)); an election outside the requirements or before the following-year test is met has no effect (E-0239)";
    for p: Individual; for y: Integer; for made: Date;
    when first_year_election_made_on(p, y, made);
    then power S7701b4FirstYearElectionPower {
        holder p;
        over p;
        exercise first_year_election_made_on(p, y, made);
        valid_when first_year_election_valid(p, y);
        effect create(first_year_election_in_effect(p, y));
        window [@1986-01-01, infinity);
    };
}
pub relation testing_period_start_candidate_meeting_iv(p: Individual, y: Integer, start: Date) kind institutional { label en unofficial "candidate start dates of testing periods that meet clause (iv)"; }
rule TestingPeriodStartCandidate strict { for p: Individual; for y: Integer; for start: Date; when testing_period_from_meets_75_percent(p, y, start); then testing_period_start_candidate_meeting_iv(p, y, start); }
pub relation earlier_testing_period_meeting_iv_exists(p: Individual, y: Integer, start: Date) kind institutional { label en unofficial "helper: a strictly earlier testing period meeting (iv) exists"; }
rule EarlierTestingPeriodExists strict { for p: Individual; for y: Integer; for s1: Date; for s2: Date; when testing_period_start_candidate_meeting_iv(p, y, s1) and testing_period_start_candidate_meeting_iv(p, y, s2) and s2 < s1; then earlier_testing_period_meeting_iv_exists(p, y, s1); }
pub relation first_year_election_residency_starts_on(p: Individual, y: Integer, d: Date) kind institutional { label en official "the individual is treated as a resident for the portion of the election year which begins on the 1st day of the earliest testing period meeting clause (iv)"; }
@source(IRC_S7701, coverage = partial, quote = "shall be treated as a resident of the United States for the portion of the election year which begins on the 1st day of the earliest testing period during such year")
rule FirstYearElectionResidencyStartDate strict {
    for p: Individual; for y: Integer; for start: Date;
    when first_year_election_in_effect(p, y) and testing_period_start_candidate_meeting_iv(p, y, start) and not_known(earlier_testing_period_meeting_iv_exists(p, y, start));
    then first_year_election_residency_starts_on(p, y, start);
}
pub external judgment relation secretary_consents_to_revocation_of_first_year_election(p: Individual, y: Integer) {
    authority Secretary;
    label en official "the Secretary consents to the revocation of the election (subparagraph (F))";
}
pub relation revokes_first_year_election_on(p: Individual, y: Integer, d: Date) kind empirical { label en official "the individual revokes the election"; }
pub relation first_year_election_revoked(p: Individual, y: Integer) kind institutional { label en official "a revocation made with the Secretary's consent"; }
@source(IRC_S7701, coverage = partial, quote = "An election once made under subparagraph (B) remains in effect for the election year, unless revoked with the consent of the Secretary.")
rule FirstYearElectionRevocationPower strict {
    for p: Individual; for y: Integer; for d: Date;
    when revokes_first_year_election_on(p, y, d);
    then power S7701b4FirstYearElectionRevocationPower {
        holder p;
        over p;
        exercise revokes_first_year_election_on(p, y, d);
        valid_when secretary_consents_to_revocation_of_first_year_election(p, y);
        effect create(first_year_election_revoked(p, y));
        window [@1986-01-01, infinity);
    };
}

// ============================================================================
// §7701(b)(10) coordination with section 877
// ============================================================================

pub relation initial_residency_period_years(p: Individual, first_year: Integer, last_year: Integer) kind empirical { label en official "the individual was treated as a resident during a period covering the calendar years first_year to last_year (an initial residency period when it includes at least 3 consecutive calendar years)"; }
pub relation initial_residency_period_of_individual(p: Individual, first_year: Integer, last_year: Integer) kind institutional { label en official "an initial residency period: a period of residency that includes at least 3 consecutive calendar years"; }
@source(IRC_S7701, coverage = partial, quote = "an alien individual was treated as a resident of the United States during any period which includes at least 3 consecutive calendar years")
rule InitialResidencyPeriodOfThreeYears strict { for p: Individual; for a: Integer; for b: Integer; when initial_residency_period_years(p, a, b) and b - a >= 2; then initial_residency_period_of_individual(p, a, b); }
pub relation resumes_residency_in_calendar_year(p: Individual, year: Integer, d: Date) kind empirical { label en official "after ceasing to be treated as a resident, the individual subsequently becomes a resident of the United States on the date, in the calendar year"; }
pub relation subsequent_residency_within_three_years(p: Individual, resumption: Date) kind institutional { label en official "the individual subsequently becomes a resident before the close of the 3rd calendar year beginning after the close of the initial residency period"; }
@source(IRC_S7701, coverage = partial, quote = "subsequently becomes a resident of the United States before the close of the 3rd calendar year beginning after the close of the initial residency period")
rule SubsequentResidencyWithinThreeCalendarYears strict {
    for p: Individual; for a: Integer; for b: Integer; for year: Integer; for d: Date;
    when initial_residency_period_of_individual(p, a, b) and resumes_residency_in_calendar_year(p, year, d) and year > b and year <= b + 3;
    then subsequent_residency_within_three_years(p, d);
}
pub relation tax_imposed_under_877b(p: Individual, amount: Money) kind empirical { label en official "the tax imposed pursuant to section 877(b) for the period (computed by the international owner)"; }
pub relation tax_imposed_under_871_without_paragraph(p: Individual, amount: Money) kind empirical { label en official "the tax which, without regard to paragraph (10), is imposed pursuant to section 871"; }
pub relation initial_residency_period_closes_on(p: Individual, d: Date) kind empirical { label en official "the close of the initial residency period"; }
pub relation taxable_in_manner_of_877b_between(p: Individual, after: Date, before: Date) kind institutional {
    label en official "the individual is taxable for the period after the close of the initial residency period and before the day he subsequently became a resident in the manner provided in section 877(b), only if the section 877(b) tax exceeds the section 871 tax";
}
@source(IRC_S7701, coverage = partial, quote = "such individual shall be taxable for the period after the close of the initial residency period and before the day on which he subsequently became a resident of the United States in the manner provided in section 877(b).")
rule TaxableInMannerOf877bAfterInitialResidency strict {
    for p: Individual; for closes: Date; for resumption: Date; for t877: Money; for t871: Money;
    when initial_residency_period_closes_on(p, closes) and subsequent_residency_within_three_years(p, resumption) and tax_imposed_under_877b(p, t877) and tax_imposed_under_871_without_paragraph(p, t871) and t877 > t871;
    then taxable_in_manner_of_877b_between(p, closes, resumption);
}

// ============================================================================
// §7702(h) endowment contracts; (i) qualified 20-pay contracts
// ============================================================================

pub relation endowment_contract_under_applicable_law(c: InsuranceContract) kind empirical { label en official "a contract which is an endowment contract under the applicable law"; }
pub relation contract_under_applicable_law_for_a_and_g(c: InsuranceContract) kind institutional {
    label en official "a life insurance contract under the applicable law, or an endowment contract under the applicable law: references in subsections (a) and (g) to a life insurance contract include an endowment contract";
}
@source(IRC_S7702_H, coverage = exact, quote = "References in subsections (a) and (g) to a life insurance contract shall be treated as including references to a contract which is an endowment contract under the applicable law.")
rule EndowmentContractIsReferredToBySubsectionsAAndG strict { for c: InsuranceContract; when endowment_contract_under_applicable_law(c); then contract_under_applicable_law_for_a_and_g(c); }
rule LifeInsuranceContractUnderApplicableLawIsReferredTo strict { for c: InsuranceContract; when life_insurance_contract_under_applicable_law(c); then contract_under_applicable_law_for_a_and_g(c); }
pub relation endowment_contract_under_7702h(c: InsuranceContract) kind institutional { label en official "the term endowment contract: a contract which is an endowment contract under the applicable law and which meets the requirements of subsection (a)"; }
@source(IRC_S7702_H, coverage = exact, quote = "the term \"endowment contract\" means a contract which is an endowment contract under the applicable law and which meets the requirements of subsection (a)")
rule EndowmentContractMeetingCashValueAccumulationTest strict { for c: InsuranceContract; when endowment_contract_under_applicable_law(c) and cash_value_accumulation_test(c); then endowment_contract_under_7702h(c); }
rule EndowmentContractMeetingGuidelinePremiumTest strict { for c: InsuranceContract; when endowment_contract_under_applicable_law(c) and meets_guideline_premium_test(c); then endowment_contract_under_7702h(c); }
pub relation requires_at_least_20_nondecreasing_annual_premium_payments(c: InsuranceContract) kind empirical { label en official "the contract requires at least 20 nondecreasing annual premium payments"; }
pub relation plan_of_insurance_filed_before_september_28_1983(c: InsuranceContract, filed: Date) kind empirical { label en official "a plan of insurance filed by the issuing company in one or more States on the date"; }
pub relation plan_of_insurance_on_file_in_appropriate_state(c: InsuranceContract) kind empirical { label en official "the plan of insurance is on file in the appropriate State for such contract"; }
pub relation issued_pursuant_to_existing_plan_of_insurance(c: InsuranceContract) kind institutional { label en official "a plan of insurance filed by the issuing company before September 28, 1983, and on file in the appropriate State"; }
@source(IRC_S7702_I, coverage = exact, quote = "any plan of insurance which was filed by the company issuing such contract in 1 or more States before September 28, 1983, and is on file in the appropriate State for such contract")
rule ExistingPlanOfInsurance strict { for c: InsuranceContract; for d: Date; when plan_of_insurance_filed_before_september_28_1983(c, d) and d < @1983-09-28 and plan_of_insurance_on_file_in_appropriate_state(c); then issued_pursuant_to_existing_plan_of_insurance(c); }
pub relation qualified_20_pay_contract(c: InsuranceContract) kind institutional { label en official "a contract which requires at least 20 nondecreasing annual premium payments and is issued pursuant to an existing plan of insurance"; }
@source(IRC_S7702_I, coverage = exact, quote = "the term \"qualified 20-pay contract\" means any contract which—")
rule QualifiedTwentyPayContract strict { for c: InsuranceContract; when requires_at_least_20_nondecreasing_annual_premium_payments(c) and issued_pursuant_to_existing_plan_of_insurance(c); then qualified_20_pay_contract(c); }
pub relation accumulation_test_minimum_interest_rate_percent(c: InsuranceContract, pct: Decimal) kind institutional { label en official "the annual effective interest rate of section 7702(b)(2)(A): 4 percent, or 3 percent for a qualified 20-pay contract"; }
@source(IRC_S7702_I, coverage = exact, quote = "this section shall be applied by substituting \"3 percent\" for \"4 percent\" in subsection (b)(2)")
rule QualifiedTwentyPayContractThreePercent strict { for c: InsuranceContract; when qualified_20_pay_contract(c); then accumulation_test_minimum_interest_rate_percent(c, 3.0); }
rule OrdinaryContractFourPercent strict { for c: InsuranceContract; when life_insurance_contract_under_applicable_law(c) and not_known(qualified_20_pay_contract(c)); then accumulation_test_minimum_interest_rate_percent(c, 4.0); }

// ============================================================================
// §7705(e) work site employee
// ============================================================================

pub entity CpeoServiceContract { label en unofficial "a contract between a customer and a certified professional employer organization"; }
pub relation cpeo_contract_between(k: CpeoServiceContract, customer: Person, cpeo: ProfessionalEmployerOrganization) kind empirical { label en official "the contract is between the customer and the certified professional employer organization"; }
pub relation cpeo_contract_in_writing(k: CpeoServiceContract) kind empirical { label en official "the contract is in writing"; }
pub relation cpeo_assumes_payment_of_wages(k: CpeoServiceContract) kind empirical { label en official "(A) assumes responsibility for payment of wages, without regard to the receipt or adequacy of payment from the customer"; }
pub relation cpeo_assumes_reporting_withholding_and_paying_taxes(k: CpeoServiceContract) kind empirical { label en official "(B) assumes responsibility for reporting, withholding, and paying any applicable taxes under subtitle C, without regard to the receipt or adequacy of payment from the customer"; }
pub relation cpeo_assumes_employee_benefits(k: CpeoServiceContract) kind empirical { label en official "(C) assumes responsibility for any employee benefits the service contract may require, without regard to the receipt or adequacy of payment from the customer"; }
pub relation cpeo_assumes_recruiting_hiring_and_firing(k: CpeoServiceContract) kind empirical { label en official "(D) assumes responsibility for recruiting, hiring, and firing workers in addition to the customer's responsibility"; }
pub relation cpeo_maintains_employee_records(k: CpeoServiceContract) kind empirical { label en official "(E) maintains employee records relating to the individual"; }
pub relation cpeo_agrees_to_be_treated_as_cpeo_for_section_3511(k: CpeoServiceContract) kind empirical { label en official "(F) agrees to be treated as a certified professional employer organization for purposes of section 3511"; }
pub relation service_contract_meets_paragraph_2(k: CpeoServiceContract) kind institutional { label en official "a contract meets the requirements of paragraph (2): in writing, and the organization assumes the six responsibilities (A)-(F)"; }
@source(IRC_S7705_E, coverage = exact, quote = "A contract meets the requirements of this paragraph with respect to an individual performing services for a customer if such contract is in writing and provides that the certified professional employer organization shall—")
rule ServiceContractRequirementsMet strict {
    for k: CpeoServiceContract;
    when cpeo_contract_in_writing(k) and cpeo_assumes_payment_of_wages(k) and cpeo_assumes_reporting_withholding_and_paying_taxes(k) and cpeo_assumes_employee_benefits(k)
        and cpeo_assumes_recruiting_hiring_and_firing(k) and cpeo_maintains_employee_records(k) and cpeo_agrees_to_be_treated_as_cpeo_for_section_3511(k);
    then service_contract_meets_paragraph_2(k);
}
pub relation individual_performs_services_under(i: Individual, k: CpeoServiceContract, work_site: Text) kind empirical { label en official "the individual performs services for the customer under the contract, at the work site"; }
pub relation individual_at_work_site(i: Individual, work_site: Text, customer: Person) kind empirical { label en official "the individual performs services for the customer at the work site"; }
pub relation excluded_employee_under_414q5(i: Individual) kind empirical { label en official "an individual who is an excluded employee within the meaning of section 414(q)(5)"; }
pub relation individual_subject_to_qualifying_cpeo_contract(i: Individual, cpeo: ProfessionalEmployerOrganization) kind institutional { label en unofficial "the individual is subject to a contract with the organization that meets the requirements of paragraph (2)"; }
rule IndividualSubjectToQualifyingCpeoContract strict {
    for i: Individual; for k: CpeoServiceContract; for cpeo: ProfessionalEmployerOrganization; for customer: Person; for ws: Text;
    when individual_performs_services_under(i, k, ws) and cpeo_contract_between(k, customer, cpeo) and service_contract_meets_paragraph_2(k);
    then individual_subject_to_qualifying_cpeo_contract(i, cpeo);
}
pub relation work_site_counted_individual(i: Individual, work_site: Text, customer: Person) kind institutional { label en unofficial "an individual performing services for the customer at the work site, not counting excluded employees"; }
rule WorkSiteCountedIndividual strict { for i: Individual; for ws: Text; for customer: Person; when individual_at_work_site(i, ws, customer) and not_known(excluded_employee_under_414q5(i)); then work_site_counted_individual(i, ws, customer); }
pub relation work_site_meets_paragraph_3(work_site: Text, customer: Person, cpeo: ProfessionalEmployerOrganization) kind institutional { label en official "at least 85 percent of the individuals performing services for the customer at the work site (not counting excluded employees) are subject to contracts with the organization that meet paragraph (2)"; }
@source(IRC_S7705_E, coverage = exact, quote = "The requirements of this paragraph are met with respect to an individual if at least 85 percent of the individuals performing services for the customer at the work site")
rule WorkSiteCoverageAtLeastEightyFivePercent strict {
    for ws: Text; for customer: Person; for cpeo: ProfessionalEmployerOrganization; for i0: Individual;
    when work_site_counted_individual(i0, ws, customer) and individual_subject_to_qualifying_cpeo_contract(i0, cpeo)
        and count(collect i: Individual where work_site_counted_individual(i, ws, customer) and individual_subject_to_qualifying_cpeo_contract(i, cpeo)) * 100
            >= count(collect j: Individual where work_site_counted_individual(j, ws, customer)) * 85;
    then work_site_meets_paragraph_3(ws, customer, cpeo);
}
pub relation work_site_employee_of(i: Individual, cpeo: ProfessionalEmployerOrganization) kind institutional { label en official "the term work site employee: an individual who performs services for a customer under a contract meeting paragraph (2), at a work site meeting paragraph (3)"; }
@source(IRC_S7705_E, coverage = exact, quote = "The term \"work site employee\" means, with respect to a certified professional employer organization, an individual who—")
rule WorkSiteEmployee strict {
    for i: Individual; for k: CpeoServiceContract; for cpeo: ProfessionalEmployerOrganization; for customer: Person; for ws: Text;
    when individual_performs_services_under(i, k, ws) and cpeo_contract_between(k, customer, cpeo) and service_contract_meets_paragraph_2(k) and work_site_meets_paragraph_3(ws, customer, cpeo);
    then work_site_employee_of(i, cpeo);
}
