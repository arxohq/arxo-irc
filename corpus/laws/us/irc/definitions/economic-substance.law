// §7701(o) — clarification of the economic substance doctrine. A
// classification with EVALUATIVE elements under DECISION-0194: the statute
// itself states the two-prong CONJUNCTIVE test ((1)(A) objective economic
// position change, (1)(B) subjective substantial non-tax purpose), but
// "meaningful way", "substantial purpose" and the profit-potential
// comparison in (2) are not mechanically decidable from asserted numbers
// alone in every case — the doctrine is a COMMON LAW doctrine the courts
// apply ((5)(A): "the common law doctrine under which tax benefits … are
// not allowable if the transaction does not have economic substance or
// lacks a business purpose"), so this package models the ultimate
// determination as an `external judgment relation` with authority the
// courts (`TaxCourt`), while the (2) profit-potential comparison, which the
// statute DOES give a numeric relation for ("substantial in relation to"),
// is left to a case's own comparison of the two present-value amounts it
// asserts (a genuine "substantial in relation to" comparison is itself
// evaluative — no fixed percentage is in the text — so this package does not
// invent a threshold).
//
// Anchor: whole-section fragment `IRC_S7701`, quote anchors (DECISION-0358).

language "law.core" version "0.2";
package us.irc.definitions version "0.1.1";
namespace "urn:us:irc:definitions:clir";

use self::{
    IRC_S7701,
    IRC_S7701_NOTE_6,
};

pub entity EconomicSubstanceTransaction { label en unofficial "a transaction (or series of transactions) to which the economic substance doctrine may be relevant"; }

pub relation economic_substance_doctrine_relevant(t: EconomicSubstanceTransaction) kind empirical {
    label en unofficial "the economic substance doctrine is relevant to the transaction (determined without regard to this subsection: (5)(C))";
}
pub relation changes_taxpayers_economic_position_meaningfully(t: EconomicSubstanceTransaction) kind empirical {
    label en official "the transaction changes in a meaningful way (apart from Federal income tax effects) the taxpayer's economic position";
}
pub relation taxpayer_has_substantial_nontax_purpose(t: EconomicSubstanceTransaction) kind empirical {
    label en official "the taxpayer has a substantial purpose (apart from Federal income tax effects) for entering into such transaction";
}
pub relation taxpayer_relies_on_profit_potential(t: EconomicSubstanceTransaction) kind empirical {
    label en unofficial "the taxpayer relies on the transaction's profit potential to satisfy (1)(A)/(1)(B) — triggers the (2) special rule";
}
pub relation present_value_reasonably_expected_pretax_profit(t: EconomicSubstanceTransaction, amount: Money) kind empirical {
    label en official "the present value of the reasonably expected pre-tax profit from the transaction (fees, other transaction expenses, and — under Secretary regulations — foreign taxes taken into account as expenses)";
}
pub relation present_value_expected_net_tax_benefits(t: EconomicSubstanceTransaction, amount: Money) kind empirical {
    label en official "the present value of the expected net tax benefits that would be allowed if the transaction were respected";
}
pub relation profit_potential_substantial_in_relation_to_tax_benefits(t: EconomicSubstanceTransaction) kind empirical {
    label en unofficial "the present value of the reasonably expected pre-tax profit is substantial in relation to the present value of the expected net tax benefits (a comparison the statute names but does not quantify; asserted by the case, not computed by a fixed ratio this package would have to invent)";
}
pub relation individual_transaction_entered_in_connection_with_trade_or_business_or_income_production(t: EconomicSubstanceTransaction) kind empirical {
    label en official "in the case of an individual, paragraph (1) shall apply only to transactions entered into in connection with a trade or business or an activity engaged in for the production of income";
}
pub relation transacting_party_is_individual(t: EconomicSubstanceTransaction) kind empirical {
    label en unofficial "the taxpayer entering into the transaction is an individual (for the (5)(B) personal-transaction exception)";
}
pub relation state_or_local_tax_effect_related_to_federal_effect(t: EconomicSubstanceTransaction) kind empirical {
    label en official "any State or local income tax effect which is related to a Federal income tax effect shall be treated in the same manner as a Federal income tax effect";
}
pub relation financial_accounting_benefit_originates_from_federal_tax_reduction(t: EconomicSubstanceTransaction) kind empirical {
    label en official "achieving a financial accounting benefit shall not be taken into account as a purpose for entering into a transaction if the origin of such financial accounting benefit is a reduction of Federal income tax";
}

// Stage 3 (26.09.2026): the date guard of the note to section 7701 (Pub. L.
// 111-152 sec. 1409(e)): the codified doctrine applies to transactions entered
// into after March 30, 2010. A transaction with no asserted entry date keeps the
// stage-1 behavior (the guard is silent); an asserted date on or before the
// enactment date leaves the codified test inapplicable.
pub relation transaction_entered_into_on(t: EconomicSubstanceTransaction, d: Date) kind empirical {
    label en official "the date the transaction was entered into";
}
pub relation transaction_entry_date_stated(t: EconomicSubstanceTransaction) kind institutional {
    label en unofficial "helper: an entry date is asserted for the transaction";
}
rule TransactionEntryDateStated strict {
    for t: EconomicSubstanceTransaction; for d: Date;
    when transaction_entered_into_on(t, d);
    then transaction_entry_date_stated(t);
}
pub relation codified_doctrine_in_effect_for(t: EconomicSubstanceTransaction) kind institutional {
    label en official "subsection (o) applies to transactions entered into after the date of enactment of Pub. L. 111-152 (March 30, 2010)";
}
@source(IRC_S7701_NOTE_6, coverage = partial, quote = "Amendment by Pub. L. 111–152 applicable to transactions entered into after Mar. 30, 2010")
rule CodifiedDoctrineAppliesToTransactionsEnteredAfterMarch302010 strict {
    for t: EconomicSubstanceTransaction; for d: Date;
    when transaction_entered_into_on(t, d) and d > @2010-03-30;
    then codified_doctrine_in_effect_for(t);
}
rule CodifiedDoctrineGuardSilentWithoutEntryDate strict {
    for t: EconomicSubstanceTransaction;
    when economic_substance_doctrine_relevant(t) and not_known(transaction_entry_date_stated(t));
    then codified_doctrine_in_effect_for(t);
}

// (1)(A): objective prong, informed by the (2) profit-potential special rule
// when the taxpayer relies on it.
pub relation meaningful_economic_position_change_prong(t: EconomicSubstanceTransaction) kind institutional {
    label en official "the transaction changes in a meaningful way (apart from Federal income tax effects) the taxpayer's economic position";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "the transaction changes in a meaningful way (apart from Federal income tax effects) the taxpayer's economic position")
rule EconomicPositionChangeAssertedDirectly strict {
    for t: EconomicSubstanceTransaction;
    when changes_taxpayers_economic_position_meaningfully(t) and not_known(taxpayer_relies_on_profit_potential(t));
    then meaningful_economic_position_change_prong(t);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The potential for profit of a transaction shall be taken into account in determining whether the requirements of subparagraphs (A) and (B) of paragraph (1) are met with respect to the transaction only if the present value of the reasonably expected pre-tax profit from the transaction is substantial in relation to the present value of the expected net tax benefits that would be allowed if the transaction were respected.")
rule EconomicPositionChangeViaSubstantialProfitPotential strict {
    for t: EconomicSubstanceTransaction;
    when taxpayer_relies_on_profit_potential(t) and profit_potential_substantial_in_relation_to_tax_benefits(t)
        and changes_taxpayers_economic_position_meaningfully(t);
    then meaningful_economic_position_change_prong(t);
}

// (1)(B): subjective prong, same profit-potential gate, plus (4)'s
// financial-accounting-benefit carve-out.
pub relation substantial_nontax_purpose_prong(t: EconomicSubstanceTransaction) kind institutional {
    label en official "the taxpayer has a substantial purpose (apart from Federal income tax effects) for entering into such transaction";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "the taxpayer has a substantial purpose (apart from Federal income tax effects) for entering into such transaction")
rule SubstantialPurposeAssertedDirectly strict {
    for t: EconomicSubstanceTransaction;
    when taxpayer_has_substantial_nontax_purpose(t) and not_known(taxpayer_relies_on_profit_potential(t))
        and not_known(financial_accounting_benefit_originates_from_federal_tax_reduction(t));
    then substantial_nontax_purpose_prong(t);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "For purposes of paragraph (1)(B), achieving a financial accounting benefit shall not be taken into account as a purpose for entering into a transaction if the origin of such financial accounting benefit is a reduction of Federal income tax.")
rule SubstantialPurposeViaSubstantialProfitPotential strict {
    for t: EconomicSubstanceTransaction;
    when taxpayer_relies_on_profit_potential(t) and profit_potential_substantial_in_relation_to_tax_benefits(t)
        and taxpayer_has_substantial_nontax_purpose(t)
        and not_known(financial_accounting_benefit_originates_from_federal_tax_reduction(t));
    then substantial_nontax_purpose_prong(t);
}

// The doctrine's own conjunctive test, and the personal-transaction
// exception of (5)(B) restricting when it even applies to an individual.
pub relation economic_substance_doctrine_applies_to_transaction(t: EconomicSubstanceTransaction) kind institutional {
    label en unofficial "(5)(B): for an individual, the doctrine applies only to a transaction entered into in connection with a trade or business or an activity engaged in for the production of income; for any other taxpayer, it applies whenever the doctrine is relevant";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "In the case of an individual, paragraph (1) shall apply only to transactions entered into in connection with a trade or business or an activity engaged in for the production of income.")
rule IndividualDoctrineAppliesOnlyToBusinessOrIncomeTransactions strict {
    for t: EconomicSubstanceTransaction;
    when transacting_party_is_individual(t) and individual_transaction_entered_in_connection_with_trade_or_business_or_income_production(t)
        and codified_doctrine_in_effect_for(t);
    then economic_substance_doctrine_applies_to_transaction(t);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "In the case of an individual, paragraph (1) shall apply only to transactions entered into in connection with a trade or business or an activity engaged in for the production of income.")
rule NonIndividualDoctrineAlwaysApplicableWhenRelevant strict {
    for t: EconomicSubstanceTransaction;
    when economic_substance_doctrine_relevant(t) and not_known(transacting_party_is_individual(t)) and codified_doctrine_in_effect_for(t);
    then economic_substance_doctrine_applies_to_transaction(t);
}

// The ultimate "has economic substance" conclusion: the two-prong test IS
// the statutory codification, so where both prongs are established (and the
// doctrine applies to this taxpayer/transaction), the transaction has
// economic substance BY THE STATUTE'S OWN TERMS. Where the doctrine is
// relevant but a prong is contested on facts the case does not fully supply
// (typically: is the claimed purpose "substantial", is the position change
// "meaningful"), the authority that ultimately decides is the court hearing
// the case — modeled as an evaluative channel a case can invoke instead of
// (or in addition to) the direct-fact rules above.
external judgment relation TransactionHasEconomicSubstanceUnderCommonLawDoctrine(t: EconomicSubstanceTransaction) {
    authority TaxCourt;
    label en official "the common law doctrine under which tax benefits under subtitle A with respect to a transaction are not allowable if the transaction does not have economic substance or lacks a business purpose";
}
pub relation transaction_has_economic_substance(t: EconomicSubstanceTransaction) kind institutional {
    label en official "such transaction shall be treated as having economic substance only if (A) the transaction changes in a meaningful way … the taxpayer's economic position, and (B) the taxpayer has a substantial purpose … for entering into such transaction";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "In the case of any transaction to which the economic substance doctrine is relevant, such transaction shall be treated as having economic substance only if—")
rule BothProngsEstablishedGivesEconomicSubstance strict {
    for t: EconomicSubstanceTransaction;
    when economic_substance_doctrine_relevant(t) and economic_substance_doctrine_applies_to_transaction(t)
        and meaningful_economic_position_change_prong(t) and substantial_nontax_purpose_prong(t);
    then transaction_has_economic_substance(t);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"economic substance doctrine\" means the common law doctrine under which tax benefits under subtitle A with respect to a transaction are not allowable if the transaction does not have economic substance or lacks a business purpose.")
rule CourtJudgmentGivesEconomicSubstance strict {
    for t: EconomicSubstanceTransaction;
    when economic_substance_doctrine_relevant(t) and economic_substance_doctrine_applies_to_transaction(t)
        and TransactionHasEconomicSubstanceUnderCommonLawDoctrine(t);
    then transaction_has_economic_substance(t);
}
