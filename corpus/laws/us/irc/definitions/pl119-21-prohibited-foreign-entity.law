// Public Law 119-21 (July 4, 2025), amendments of provisions this package owns:
//   * sec. 70512(c): new §7701(a)(51) "prohibited foreign entity" and
//     §7701(a)(52) "material assistance from a prohibited foreign entity"
//     (fragment `us.irc.temporal::PL119_21_S70512`), applicable to taxable
//     years beginning after the date of enactment (sec. 70512(l)(1)); the
//     (52) uses for facilities apply to facilities for which construction
//     begins after December 31, 2025 (sec. 70512(l)(2));
//   * sec. 70524: §7704(d)(1)(E) — module pl119-21-ptp-qualifying-income.law;
//   * sec. 70605 does NOT amend §7705 (it defines a "COVID-ERTC promoter" that
//     excludes a certified professional employer organization by reference to
//     §7705): no change to cpeo.law; recorded in HANDOFF (AMENDMENTS.json lists
//     §7705 for it heuristically).
//
// REVISION vs WINDOWS. The grammar has `revision_decl` (§32), but the corpus
// convention of this title (accounting, deductions, ...) is `effective`-
// windowed rules anchored on the temporal fragment; the base 2024 text of
// §7701(a) has no paragraphs (51)-(52), so a `revision` with `op replace`
// over a locator the base does not model would carry no evaluable effect.
// Windows are used and the reason is recorded in the coverage notes.
//
// DEONTICS. The section addresses the Secretary in five places: two duties
// with statutory deadlines ("Not later than December 31, 2026, the Secretary
// shall issue" anti-evasion guidance (51)(D)(iii) and safe-harbor tables
// (52)(D)(iii)(I); "Not later than December 31, 2027" critical-mineral
// threshold percentages (52)(C)(ii)) and two "shall prescribe / shall issue"
// duties without a deadline ((51)(D)(ii)(I)(bb), (52)(D)(v)). They are
// `duty` positions of the Secretary with achievement goals over the statutory
// window. The taxpayer's (52)(D)(iv) election is a `power`. The permissions
// "may prescribe regulations" ((51)(K), (52)(G)) are EXTERNAL_DEPENDENCY rows,
// no invented effect.
//
// SCOPE OF THIS PASS. Modelled: (51)(A)-(D)(i), (F)-(G), the (E)(i) publicly
// traded carve-outs, (52)(A)-(D)(ii), the (D)(iii)(III)(aa) knowledge rule.
// Not modelled (TECH-GAPS G3504-G3510): (51)(D)(ii)-(iii) effective-control
// detail beyond the asserted fact, (51)(E)(ii)-(iii), (51)(H)-(K), (52)(C)(ii)
// issued critical-mineral thresholds, (52)(D)(iii)(II)/(IV) safe harbor and
// certification, (52)(D)(iv) exclusion effect on the ratio inputs.

language "law.core" version "0.2";
package us.irc.definitions version "0.1.1";
namespace "urn:us:irc:definitions:clir";

use self::{
    Organ,
    Person,
    Secretary,
    TaxableYear,
};

// ===== (51)(B)-(C): specified foreign entity, foreign-controlled entity =============
// Determination time (51)(A)(ii): last day of the taxable year; for the first
// taxable year beginning after enactment, clauses (i)-(iv) are determined on
// the FIRST day. Membership facts are asserted for a determination date.
pub relation is_foreign_entity_of_concern_under_9901_8_a_b_d_or_e_on(e: Person, d: Date) kind empirical {
    label en official "a foreign entity of concern described in subparagraph (A), (B), (D), or (E) of section 9901(8) of the William M. (Mac) Thornberry National Defense Authorization Act for Fiscal Year 2021";
}
pub relation is_chinese_military_company_under_1260h_on(e: Person, d: Date) kind empirical {
    label en official "an entity identified as a Chinese military company operating in the United States in accordance with section 1260H of the William M. (Mac) Thornberry National Defense Authorization Act for Fiscal Year 2021";
}
pub relation is_on_list_required_by_section_2d2b_of_public_law_117_78_on(e: Person, d: Date) kind empirical {
    label en official "an entity included on a list required by clause (i), (ii), (iv), or (v) of section 2(d)(2)(B) of Public Law 117-78";
}
pub relation is_specified_under_section_154b_of_ndaa_2024_on(e: Person, d: Date) kind empirical {
    label en official "an entity specified under section 154(b) of the National Defense Authorization Act for Fiscal Year 2024";
}
pub relation specified_foreign_entity_by_clauses_i_to_iv_on(e: Person, d: Date) kind institutional {
    label en official "a specified foreign entity described in clauses (i) through (iv) of subparagraph (B), as of the determination date";
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(i) a foreign entity of concern described in subparagraph (A), (B), (D), or (E) of section 9901(8)")
rule ForeignEntityOfConcernIsSpecifiedForeignEntityClause strict {
    effective [@2025-07-04, infinity);
    for e: Person; for d: Date;
    when is_foreign_entity_of_concern_under_9901_8_a_b_d_or_e_on(e, d);
    then specified_foreign_entity_by_clauses_i_to_iv_on(e, d);
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(ii) an entity identified as a Chinese military company operating in the United States in accordance")
rule ChineseMilitaryCompanyIsSpecifiedForeignEntityClause strict {
    effective [@2025-07-04, infinity);
    for e: Person; for d: Date;
    when is_chinese_military_company_under_1260h_on(e, d);
    then specified_foreign_entity_by_clauses_i_to_iv_on(e, d);
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(iii) an entity included on a list required by clause (i), (ii), (iv), or (v) of section 2(d)(2)(B) of Public Law 117–78")
rule PublicLaw11778ListedEntityIsSpecifiedForeignEntityClause strict {
    effective [@2025-07-04, infinity);
    for e: Person; for d: Date;
    when is_on_list_required_by_section_2d2b_of_public_law_117_78_on(e, d);
    then specified_foreign_entity_by_clauses_i_to_iv_on(e, d);
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(iv) an entity specified under section 154(b) of the National Defense Authorization Act for Fiscal Year 2024")
rule Ndaa2024Section154bEntityIsSpecifiedForeignEntityClause strict {
    effective [@2025-07-04, infinity);
    for e: Person; for d: Date;
    when is_specified_under_section_154b_of_ndaa_2024_on(e, d);
    then specified_foreign_entity_by_clauses_i_to_iv_on(e, d);
}

// (C) foreign-controlled entity. (G) control; (E)(i)(I) publicly traded carve-out.
pub relation is_government_of_covered_nation_or_agency_or_instrumentality_on(e: Person, d: Date) kind empirical {
    label en official "the government (including any level of government below the national level) of a covered nation, or an agency or instrumentality of such a government";
}
pub relation is_citizen_or_national_of_covered_nation_on(e: Person, d: Date) kind empirical {
    label en official "a person who is a citizen or national of a covered nation";
}
pub relation is_individual_us_citizen_national_or_lawful_permanent_resident_on(e: Person, d: Date) kind empirical {
    label en official "an individual who is a citizen, national, or lawful permanent resident of the United States";
}
pub relation incorporated_organized_or_principal_place_of_business_in_covered_nation_on(e: Person, d: Date) kind empirical {
    label en official "an entity or a qualified business unit (as defined in section 989(a)) incorporated or organized under the laws of, or having its principal place of business in, a covered nation";
}
pub relation described_in_foreign_controlled_clauses_i_to_iv_on(e: Person, d: Date) kind institutional {
    label en official "an entity described in clause (i), (ii), (iii), or (iv) of subparagraph (C)";
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(i) the government (including any level of government below the national level) of a covered nation,")
rule GovernmentOrAgencyOfCoveredNationIsForeignControlledClause strict {
    effective [@2025-07-04, infinity);
    for e: Person; for d: Date;
    when is_government_of_covered_nation_or_agency_or_instrumentality_on(e, d);
    then described_in_foreign_controlled_clauses_i_to_iv_on(e, d);
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(iii) a person who is a citizen or national of a covered nation, provided that such person is not an individual who is a citizen, national, or lawful permanent resident of the United States,")
rule CoveredNationCitizenNotUsPersonIsForeignControlledClause strict {
    effective [@2025-07-04, infinity);
    for e: Person; for d: Date;
    when is_citizen_or_national_of_covered_nation_on(e, d) and not_known(is_individual_us_citizen_national_or_lawful_permanent_resident_on(e, d));
    then described_in_foreign_controlled_clauses_i_to_iv_on(e, d);
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(iv) an entity or a qualified business unit (as defined in section 989(a)) incorporated or organized under the laws of, or having its principal place of business in, a covered nation, or")
rule EntityOrganizedInCoveredNationIsForeignControlledClause strict {
    effective [@2025-07-04, infinity);
    for e: Person; for d: Date;
    when incorporated_organized_or_principal_place_of_business_in_covered_nation_on(e, d);
    then described_in_foreign_controlled_clauses_i_to_iv_on(e, d);
}
// (G) control: more than 50 percent, by kind of entity.
pub relation is_corporation_for_control_test(e: Person) kind empirical {
    label en unofficial "the controlled entity is a corporation (for the (G)(i) test)";
}
pub relation is_partnership_for_control_test(e: Person) kind empirical {
    label en unofficial "the controlled entity is a partnership (for the (G)(ii) test)";
}
pub relation percent_of_stock_owned_by_vote(owner: Person, e: Person, pct: Decimal) kind empirical {
    label en official "ownership (by vote or value) of more than 50 percent of the stock in such corporation (by vote)";
}
pub relation percent_of_stock_owned_by_value(owner: Person, e: Person, pct: Decimal) kind empirical {
    label en official "ownership (by vote or value) of more than 50 percent of the stock in such corporation (by value)";
}
pub relation percent_of_profits_or_capital_interests_owned(owner: Person, e: Person, pct: Decimal) kind empirical {
    label en official "ownership of more than 50 percent of the profits interests or capital interests in such partnership";
}
pub relation percent_of_beneficial_interests_owned(owner: Person, e: Person, pct: Decimal) kind empirical {
    label en official "ownership of more than 50 percent of the beneficial interests in the entity";
}
pub relation controls_under_subparagraph_g(owner: Person, e: Person) kind institutional {
    label en official "the term \"control\" means, in the case of a corporation, ownership (by vote or value) of more than 50 percent of the stock; in the case of a partnership, more than 50 percent of the profits interests or capital interests; in any other case, more than 50 percent of the beneficial interests in the entity";
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(i) in the case of a corporation, ownership (by vote or value) of more than 50 percent of the stock in such corporation,")
rule CorporationControlByVoteOverHalf strict {
    effective [@2025-07-04, infinity);
    for o: Person; for e: Person; for p: Decimal;
    when is_corporation_for_control_test(e) and percent_of_stock_owned_by_vote(o, e, p) and p > 50.0;
    then controls_under_subparagraph_g(o, e);
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(i) in the case of a corporation, ownership (by vote or value) of more than 50 percent of the stock in such corporation,")
rule CorporationControlByValueOverHalf strict {
    effective [@2025-07-04, infinity);
    for o: Person; for e: Person; for p: Decimal;
    when is_corporation_for_control_test(e) and percent_of_stock_owned_by_value(o, e, p) and p > 50.0;
    then controls_under_subparagraph_g(o, e);
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(ii) in the case of a partnership, ownership of more than 50 percent of the profits interests or capital interests in such partnership, or")
rule PartnershipControlOverHalfOfProfitsOrCapital strict {
    effective [@2025-07-04, infinity);
    for o: Person; for e: Person; for p: Decimal;
    when is_partnership_for_control_test(e) and percent_of_profits_or_capital_interests_owned(o, e, p) and p > 50.0;
    then controls_under_subparagraph_g(o, e);
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(iii) in any other case, ownership of more than 50 percent of the beneficial interests in the entity.")
rule OtherEntityControlOverHalfOfBeneficialInterests strict {
    effective [@2025-07-04, infinity);
    for o: Person; for e: Person; for p: Decimal;
    when not_known(is_corporation_for_control_test(e)) and not_known(is_partnership_for_control_test(e)) and percent_of_beneficial_interests_owned(o, e, p) and p > 50.0;
    then controls_under_subparagraph_g(o, e);
}
pub relation regularly_traded_on_qualifying_exchange_or_market(e: Person) kind empirical {
    label en official "the securities of which are regularly traded on a national securities exchange registered with the Securities and Exchange Commission, the national market system established pursuant to section 11A of the Securities and Exchange Act of 1934, or any other exchange or market which the Secretary has determined has adequate rules (not incorporated or with principal place of business in a covered nation)";
}
pub relation foreign_controlled_entity_on(e: Person, d: Date) kind institutional {
    label en official "a foreign-controlled entity: described in clause (i), (ii), (iii), or (iv) of subparagraph (C), or an entity controlled (as determined under subparagraph (G)) by such an entity";
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "For purposes of subparagraph (B), the term ‘foreign-controlled entity’ means—")
rule EntityInClausesIToIvIsForeignControlled strict {
    effective [@2025-07-04, infinity);
    for e: Person; for d: Date;
    when described_in_foreign_controlled_clauses_i_to_iv_on(e, d);
    then foreign_controlled_entity_on(e, d);
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(v) an entity (including subsidiary entities) controlled (as determined under subparagraph (G)) by an entity described in clause (i), (ii), (iii), or (iv).")
rule EntityControlledByClauseIToIvEntityIsForeignControlled strict {
    effective [@2025-07-04, infinity);
    for e: Person; for parent: Person; for d: Date;
    when controls_under_subparagraph_g(parent, e) and described_in_foreign_controlled_clauses_i_to_iv_on(parent, d)
        and not_known(regularly_traded_on_qualifying_exchange_or_market(e));
    then foreign_controlled_entity_on(e, d);
}

// (A)(i)-(ii) + (B): specified foreign entity for a taxable year.
pub relation first_taxable_year_beginning_after_enactment_of_paragraph(y: TaxableYear) kind empirical {
    label en official "the first taxable year beginning after the date of enactment of this paragraph";
}
pub relation taxable_year_under_prohibited_foreign_entity_test(e: Person, y: TaxableYear) kind empirical {
    label en unofficial "grounding fact: the entity is being tested for this taxable year";
}
pub relation specified_foreign_entity_for_year(e: Person, y: TaxableYear) kind institutional {
    label en official "the term \"specified foreign entity\" means an entity described in clauses (i) through (v) of subparagraph (B), determined as of the last day of the taxable year (for the first taxable year beginning after enactment, clauses (i) through (iv) are determined as of the first day)";
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(I) In general.—Subject to subclause (II), for any taxable year, the determination as to whether an entity is a specified foreign entity or foreign-influenced entity shall be made as of the last day of such taxable year.")
rule ListedEntityOnLastDayOfYearIsSpecifiedForeignEntity strict {
    effective [@2025-07-04, infinity);
    for e: Person; for y: TaxableYear; for d: Date; for b: Date;
    when taxable_year_under_prohibited_foreign_entity_test(e, y) and us.irc.core::ends(y, d) and us.irc.core::begins(y, b) and b > @2025-07-04
        and not_known(first_taxable_year_beginning_after_enactment_of_paragraph(y))
        and specified_foreign_entity_by_clauses_i_to_iv_on(e, d);
    then specified_foreign_entity_for_year(e, y);
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(II) Initial taxable year.—For purposes of the first taxable year beginning after the date of enactment of this paragraph, the determination as to whether an entity is a specified foreign entity described in clauses (i) through (iv) of subparagraph (B) shall be made as of the first day of such taxable year.")
rule ListedEntityOnFirstDayOfInitialYearIsSpecifiedForeignEntity strict {
    effective [@2025-07-04, infinity);
    for e: Person; for y: TaxableYear; for d: Date;
    when taxable_year_under_prohibited_foreign_entity_test(e, y) and first_taxable_year_beginning_after_enactment_of_paragraph(y)
        and us.irc.core::begins(y, d) and specified_foreign_entity_by_clauses_i_to_iv_on(e, d);
    then specified_foreign_entity_for_year(e, y);
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(v) a foreign-controlled entity.")
rule ForeignControlledEntityOnLastDayOfYearIsSpecifiedForeignEntity strict {
    effective [@2025-07-04, infinity);
    for e: Person; for y: TaxableYear; for d: Date; for b: Date;
    when taxable_year_under_prohibited_foreign_entity_test(e, y) and us.irc.core::ends(y, d) and us.irc.core::begins(y, b) and b > @2025-07-04
        and foreign_controlled_entity_on(e, d);
    then specified_foreign_entity_for_year(e, y);
}

// ===== (51)(D): foreign-influenced entity =================================================
pub relation sfe_has_direct_authority_to_appoint_covered_officer_during(e: Person, y: TaxableYear) kind empirical {
    label en official "a specified foreign entity has the direct authority to appoint a covered officer of such entity";
}
pub relation single_specified_foreign_entity_owns_percent_during(e: Person, y: TaxableYear, pct: Decimal) kind empirical {
    label en official "a single specified foreign entity owns at least 25 percent of such entity";
}
pub relation specified_foreign_entities_own_in_aggregate_percent_during(e: Person, y: TaxableYear, pct: Decimal) kind empirical {
    label en official "one or more specified foreign entities own in the aggregate at least 40 percent of such entity";
}
pub relation percent_of_debt_issued_to_specified_foreign_entities_during(e: Person, y: TaxableYear, pct: Decimal) kind empirical {
    label en official "at least 15 percent of the debt of such entity has been issued, in the aggregate, to 1 or more specified foreign entities";
}
pub relation paid_specified_foreign_entity_in_previous_year_under_effective_control_arrangement(e: Person, y: TaxableYear) kind empirical {
    label en official "which, during the previous taxable year, made a payment to a specified foreign entity pursuant to a contract, agreement, or other arrangement which entitles such specified foreign entity (or an entity related to such specified foreign entity) to exercise effective control over a qualified facility or energy storage technology of the taxpayer or the production of an eligible component";
}
pub relation foreign_influenced_entity_for_year(e: Person, y: TaxableYear) kind institutional {
    label en official "the term \"foreign-influenced entity\" means an entity with respect to which, during the taxable year, a specified foreign entity has authority to appoint a covered officer, a single specified foreign entity owns at least 25 percent, specified foreign entities own at least 40 percent in aggregate, or at least 15 percent of the debt is held by specified foreign entities, or which made a payment during the previous taxable year under an arrangement conferring effective control";
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(aa) a specified foreign entity has the direct authority to appoint a covered officer of such entity,")
rule AuthorityToAppointCoveredOfficerMakesForeignInfluenced strict {
    effective [@2025-07-04, infinity);
    for e: Person; for y: TaxableYear; for b: Date;
    when sfe_has_direct_authority_to_appoint_covered_officer_during(e, y) and us.irc.core::begins(y, b) and b > @2025-07-04
        and not_known(exempt_from_foreign_influenced_clause_d_i_i_as_publicly_traded(e));
    then foreign_influenced_entity_for_year(e, y);
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(bb) a single specified foreign entity owns at least 25 percent of such entity,")
rule SingleSfeOwnershipAtLeastTwentyFivePercentMakesForeignInfluenced strict {
    effective [@2025-07-04, infinity);
    for e: Person; for y: TaxableYear; for p: Decimal; for b: Date;
    when single_specified_foreign_entity_owns_percent_during(e, y, p) and p >= 25.0 and us.irc.core::begins(y, b) and b > @2025-07-04
        and not_known(exempt_from_foreign_influenced_clause_d_i_i_as_publicly_traded(e));
    then foreign_influenced_entity_for_year(e, y);
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(cc) one or more specified foreign entities own in the aggregate at least 40 percent of such entity, or")
rule AggregateSfeOwnershipAtLeastFortyPercentMakesForeignInfluenced strict {
    effective [@2025-07-04, infinity);
    for e: Person; for y: TaxableYear; for p: Decimal; for b: Date;
    when specified_foreign_entities_own_in_aggregate_percent_during(e, y, p) and p >= 40.0 and us.irc.core::begins(y, b) and b > @2025-07-04
        and not_known(exempt_from_foreign_influenced_clause_d_i_i_as_publicly_traded(e));
    then foreign_influenced_entity_for_year(e, y);
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(dd) at least 15 percent of the debt of such entity has been issued, in the aggregate, to 1 or more specified foreign entities, or")
rule DebtAtLeastFifteenPercentToSfesMakesForeignInfluenced strict {
    effective [@2025-07-04, infinity);
    for e: Person; for y: TaxableYear; for p: Decimal; for b: Date;
    when percent_of_debt_issued_to_specified_foreign_entities_during(e, y, p) and p >= 15.0 and us.irc.core::begins(y, b) and b > @2025-07-04
        and not_known(exempt_from_foreign_influenced_clause_d_i_i_as_publicly_traded(e));
    then foreign_influenced_entity_for_year(e, y);
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(II) which, during the previous taxable year, made a payment to a specified foreign entity pursuant to a contract, agreement, or other arrangement which entitles such specified foreign entity (or an entity related to such specified foreign entity) to exercise effective control over—")
rule PaymentUnderEffectiveControlArrangementMakesForeignInfluenced strict {
    effective [@2025-07-04, infinity);
    for e: Person; for y: TaxableYear; for b: Date;
    when paid_specified_foreign_entity_in_previous_year_under_effective_control_arrangement(e, y) and us.irc.core::begins(y, b) and b > @2025-07-04;
    then foreign_influenced_entity_for_year(e, y);
}
// (E)(i)(II): publicly traded (or 80 percent owned by a publicly traded) entity
// is outside (D)(i)(I). The listed-market status is asserted; the 80 percent
// alternative is a fact of the same shape (see the coverage row).
pub relation at_least_eighty_percent_of_equity_owned_by_regularly_traded_entity(e: Person) kind empirical {
    label en official "not less than 80 percent of the equity securities of such entity are owned directly or indirectly by an entity the securities of which are regularly traded";
}
pub relation exempt_from_foreign_influenced_clause_d_i_i_as_publicly_traded(e: Person) kind institutional {
    label en official "subparagraph (D)(i)(I) shall not apply in the case of any entity the securities of which are regularly traded in a manner described in subclause (I), or for which not less than 80 percent of the equity securities are owned by such an entity";
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(II) Nonapplication of certain foreign-influenced entity rules.—Subparagraph (D)(i)(I) shall not apply in the case of any entity—")
rule RegularlyTradedEntityIsOutsideDiI strict {
    effective [@2025-07-04, infinity);
    for e: Person;
    when regularly_traded_on_qualifying_exchange_or_market(e);
    then exempt_from_foreign_influenced_clause_d_i_i_as_publicly_traded(e);
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(bb) for which not less than 80 percent of the equity securities of such entity are owned directly or indirectly by an entity which is described in item (aa).")
rule EightyPercentOwnedByRegularlyTradedEntityIsOutsideDiI strict {
    effective [@2025-07-04, infinity);
    for e: Person;
    when at_least_eighty_percent_of_equity_owned_by_regularly_traded_entity(e);
    then exempt_from_foreign_influenced_clause_d_i_i_as_publicly_traded(e);
}
pub relation prohibited_foreign_entity_for_year(e: Person, y: TaxableYear) kind institutional {
    label en official "the term \"prohibited foreign entity\" means a specified foreign entity or a foreign-influenced entity";
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = exact, quote = "(i) Definition.—The term ‘prohibited foreign entity’ means a specified foreign entity or a foreign-influenced entity.")
rule SpecifiedForeignEntityIsProhibitedForeignEntity strict {
    effective [@2025-07-04, infinity);
    for e: Person; for y: TaxableYear;
    when specified_foreign_entity_for_year(e, y);
    then prohibited_foreign_entity_for_year(e, y);
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = exact, quote = "(i) Definition.—The term ‘prohibited foreign entity’ means a specified foreign entity or a foreign-influenced entity.")
rule ForeignInfluencedEntityIsProhibitedForeignEntity strict {
    effective [@2025-07-04, infinity);
    for e: Person; for y: TaxableYear;
    when foreign_influenced_entity_for_year(e, y);
    then prohibited_foreign_entity_for_year(e, y);
}
// (F) covered officer.
pub relation is_member_of_board_of_directors_supervisors_or_equivalent(p: Person, e: Person) kind empirical {
    label en official "a member of the board of directors, board of supervisors, or equivalent governing body";
}
pub relation is_executive_level_officer(p: Person, e: Person) kind empirical {
    label en official "an executive-level officer, including the president, chief executive officer, chief operating officer, chief financial officer, general counsel, or senior vice president";
}
pub relation has_powers_or_responsibilities_similar_to_board_member_or_executive(p: Person, e: Person) kind empirical {
    label en official "an individual having powers or responsibilities similar to those of officers or members described in clause (i) or (ii)";
}
pub relation covered_officer_of(p: Person, e: Person) kind institutional {
    label en official "the term \"covered officer\" means, with respect to an entity, a member of the board of directors, an executive-level officer, or an individual having similar powers or responsibilities";
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(i) a member of the board of directors, board of supervisors, or equivalent governing body,")
rule BoardMemberIsCoveredOfficer strict {
    effective [@2025-07-04, infinity);
    for p: Person; for e: Person;
    when is_member_of_board_of_directors_supervisors_or_equivalent(p, e);
    then covered_officer_of(p, e);
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(ii) an executive-level officer, including the president, chief executive officer, chief operating officer, chief financial officer, general counsel, or senior vice president, or")
rule ExecutiveLevelOfficerIsCoveredOfficer strict {
    effective [@2025-07-04, infinity);
    for p: Person; for e: Person;
    when is_executive_level_officer(p, e);
    then covered_officer_of(p, e);
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(iii) an individual having powers or responsibilities similar to those of officers or members described in clause (i) or (ii).")
rule SimilarPowersIndividualIsCoveredOfficer strict {
    effective [@2025-07-04, infinity);
    for p: Person; for e: Person;
    when has_powers_or_responsibilities_similar_to_board_member_or_executive(p, e);
    then covered_officer_of(p, e);
}

// ===== Secretary's duties in (51) ===========================================================
pub relation issues_guidance_preventing_evasion_of_effective_control_restrictions(o: Organ) kind empirical {
    label en official "the Secretary shall issue such guidance as is necessary to carry out the purposes of this clause, including the establishment of rules to prevent entities from evading, circumventing, or abusing the application of the restrictions through a contract, agreement, or other arrangement";
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(bb) Regulations.Contracts.Guidance.—The Secretary shall issue such guidance as is necessary to carry out the purposes of this clause")
rule S7701a51DiiIbbSecretaryShallIssueEffectiveControlGuidance strict {
    effective [@2025-07-04, infinity);
    when true;
    then duty IssueEffectiveControlAntiEvasionGuidance {
        bearer Secretary;
        goal achievement {
            condition issues_guidance_preventing_evasion_of_effective_control_restrictions(Secretary);
            window [@2025-07-04, infinity];
        }
    };
}
pub relation issues_guidance_against_impermissible_technology_licensing_arrangements(o: Organ) kind empirical {
    label en official "not later than December 31, 2026, the Secretary shall issue such guidance as is necessary to carry out the purposes of this subparagraph, including establishment of rules to prevent entities from evading, circumventing, or abusing the application of the restrictions against impermissible technology licensing arrangements with specified foreign entities";
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = exact, quote = "Not later than December 31, 2026, the Secretary shall issue such guidance as is necessary to carry out the purposes of this subparagraph")
rule S7701a51DiiiSecretaryShallIssueTechnologyLicensingGuidanceByEnd2026 strict {
    effective [@2025-07-04, infinity);
    when true;
    then duty IssueTechnologyLicensingGuidanceByDecember312026 {
        bearer Secretary;
        goal achievement {
            condition issues_guidance_against_impermissible_technology_licensing_arrangements(Secretary);
            window [@2025-07-04, @2026-12-31];
        }
    };
}
