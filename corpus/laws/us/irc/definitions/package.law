// us.irc.definitions — Chapter 79 of Title 26 (§§7701-7705), STAGE 1.
//
// SCOPE OF THIS STAGE (owner's task, `docs/foundations/us-irc/AGENT-BRIEF.md`,
// `CONTRACT.md` "DEFINITIONS interface"). §7701(a) paragraphs (1)-(4), (6)-
// (14), (17)-(20), (23)-(31), (42)-(46) as far as they are pure definitions/
// classifications; §7701(b) resident/nonresident alien (the substantial
// presence test in full); §7701(o) economic substance doctrine; §7703 marital
// status (both subsections); §7702 life insurance contract definition
// (structure + the two numerical tests as computations over asserted
// actuarial inputs); §7704 publicly traded partnerships; §7705 certified
// professional employer organizations.
//
// OUT OF STAGE 1 (left `unreviewed` in DISPOSITIONS.json with
// `owner_package = "definitions"`, NOT reclassified as a boundary — see
// `docs/foundations/us-irc/coverage/definitions.json` for the exact row
// list this stage covers): §7701(a)(5), (15), (16), (21), (22), (32)-(41),
// (47)-(51); §7701(c)-(n), (p) (includes/including canon, Puerto Rico,
// service-contract leasing, related-persons anti-abuse, nonrecourse FMV,
// motor-vehicle leases, taxable mortgage pools, Thrift Savings Fund, charity
// pay-in-lieu, conduit regulations, contract-market designation, church
// convention/association, cross-reference table); §7702A (modified endowment
// contracts) and §7702B (qualified long-term care insurance contracts) —
// both owned by this package per `OWNERSHIP.json` but not named by the
// owner's task, so a full 158/54/137-row set of §7702/7702A/7702B rows
// remains, of which only the §7702 rows are this stage's.
//
// STAGE 2 (DECISION-0379 with deontics, 26.09.2026) closed the rows stage 1
// left open — every owned row is now classified in `coverage/definitions.json`:
//   general-terms.law        — §7701(a)(15), (16), (21), (22), (32), (33), (35)-
//                              (41), (48)-(50) (paragraph (5) is the stage 1
//                              rule ForeignCorporationOrPartnershipByExclusion)
//   special-rules.law        — §7701(d)-(n): Puerto Rico, service contracts and
//                              leases (evaluative channels), the Secretary's
//                              anti-avoidance regulations DUTY (f), nonrecourse
//                              FMV floor, terminal rental adjustment clauses,
//                              taxable mortgage pools, Thrift Savings Fund,
//                              officer-charity payments, CFTC designations,
//                              church conventions; (a) lead-in, (c), (p): rows
//                              only (no executable rule, reasons recorded)
//   modified-endowment.law   — §7702A (a)-(e) and the 1988 transition note,
//                              incl. the taxpayer's exchange-election POWER
//   long-term-care.law       — §7702B (a)-(g) and the 1996 transition note;
//                              A3 dataset long-term-care-per-diem-dollar-
//                              amount.lawparam.json (statutory 1997, Rev. Proc.
//                              2024-40 / 2025-32)
//   pl119-21-prohibited-foreign-entity.law, pl119-21-material-assistance.law
//                            — §7701(a)(51)-(52) (Public Law 119-21 sec. 70512(c);
//                              Secretary DUTIES with statutory deadlines, the
//                              taxpayer's election POWER)
//   pl119-21-ptp-qualifying-income.law — §7704(d)(1)(E) as amended by sec. 70524
//
// MODULE MAP
//   package.law              — this file: header, type aliases, module map
//   classifications.law      — §7701(a) general definitions in scope (person,
//                               partnership, corporation, domestic/foreign,
//                               fiduciary, United States/State, Secretary/
//                               delegate/Commissioner, taxpayer, taxable
//                               year/fiscal year gloss, trade or business,
//                               Tax Court, U.S. person, foreign estate/trust,
//                               basis-carryover terms, employee
//                               representatives)
//   residency.law             — §7701(b): resident alien / nonresident
//                               alien, the substantial presence test in full
//                               (31-day and weighted 183-day thresholds,
//                               closer-connection exception, exempt
//                               individuals, presence rules, first/last-year
//                               residency start/termination dates)
//   economic-substance.law    — §7701(o): the two-prong conjunctive test as
//                               an evaluative classification (DECISION-0194)
//   marital-status.law        — §7703(a)-(b): marital status for filing-
//                               status-relevant provisions, including the
//                               "considered unmarried" living-apart test
//   life-insurance.law         — §7702: life insurance contract definition,
//                               cash value accumulation test and guideline
//                               premium/corridor tests as computations over
//                               asserted actuarial inputs
//   ptp.law                   — §7704: publicly traded partnership, the 90%
//                               qualifying-income exception and the
//                               qualifying-income list
//   cpeo.law                  — §7705: certified professional employer
//                               organization — definition, certification
//                               requirements as institutional facts/duties
//                               of the Secretary and the CPEO, suspension/
//                               revocation as a power of the Secretary
//
// CONVENTIONS
//   * every relation this package exports is `pub` (CONTRACT.md's
//     "DEFINITIONS interface" is meant to be imported by every subject-matter
//     owner that reads a §7701(a) term);
//   * `@source(IRC_S7701, relation = formalizes, coverage = partial,
//     quote = "...")` for every rule anchored in §7701: the whole section is
//     ONE fragment (`sources.law`; DECISION-0379 §5 pins a subsection only
//     when the section HAS top-level lettered subsections at the model's
//     structural level — this snapshot's extraction did not split §7701 that
//     way), so every position below the whole-section fragment is a quote
//     anchor (DECISION-0358), never a separate fragment id. §7702-7705 DO
//     have per-subsection fragments (`IRC_S7702_A` … `IRC_S7705_H`); those
//     modules anchor on the subsection fragment directly;
//   * classification tests that turn on an unincorporated entity's
//     resemblance to a corporation ("check-the-box" factors) are named as
//     empirical facts a case asserts, with a `DEPENDENCIES.json` row marking
//     the underlying 26 CFR 301.7701-2/3 test as `external_norm_unresolved`
//     — this package does not invent the regulatory factors;
//   * no fact of this package is asserted true or false by silence: every
//     classification is `kind institutional`, produced by a rule from
//     `kind empirical` facts a case supplies.

language "law.core" version "0.2";
package us.irc.definitions version "0.1.1";
namespace "urn:us:irc:definitions:clir";

import us.irc.core version "0.1.1";
import us.irc.inflation_adjustments version "0.1.1";
import us.irc.temporal version "0.1.1";

// Local aliases (CONTRACT.md: "re-export a type alias locally" convention
// used by `calc.tiers`/`calc.depreciation`), so the modules below read
// naturally without repeating the `us.irc.core::` prefix on every use.
type Person = us.irc.core::Person;
type Individual = us.irc.core::Individual;
type Corporation = us.irc.core::Corporation;
type Partnership = us.irc.core::Partnership;
type Trust = us.irc.core::Trust;
type Estate = us.irc.core::Estate;
type Association = us.irc.core::Association;
type Organ = us.irc.core::Organ;
type TaxableYear = us.irc.core::TaxableYear;

// Local const aliases: an `authority`/`holder` clause takes a bare
// identifier (grammar.ebnf `external_judgment_item`, `power_conclusion`),
// not a qualified name, so core's named organs are re-bound here to the
// SAME entity reference (identity is the URN, not the declaring symbol).
const Secretary: Organ = us.irc.core::Secretary;
const TaxCourt: Organ = us.irc.core::TaxCourt;
