// §7702 — definition of life insurance contract. The cash value accumulation
// test (CVAT, subsection (b)) and the guideline premium requirements +
// cash value corridor (GPT, subsections (c)-(d)) are COMPUTATIONS, but per
// the owner's task they are implemented "as computations over asserted
// actuarial inputs where the statute gives the formula, otherwise a typed
// contract": this package does not compute a net single premium or a
// guideline premium from mortality tables and interest assumptions itself
// (that is an actuarial calculation resting on tables the Secretary
// prescribes, (c)(3)(B)(i)) — it asks the case for the actuarially
// determined amounts the statute's own comparison operates on (net single
// premium, cash surrender value, guideline premium limitation, sum of
// premiums paid, death benefit, applicable percentage) and executes the
// COMPARISON the statute states in plain terms ("may not at any time
// exceed", "does not at any time exceed", "is not less than").
//
// Anchors: `IRC_S7702_A` through `IRC_S7702_G` (§7702 has top-level lettered
// subsection fragments).

language "law.core" version "0.2";
package us.irc.definitions version "0.1.1";
namespace "urn:us:irc:definitions:clir";

use self::{
    IRC_S7702_A,
    IRC_S7702_B,
    IRC_S7702_C,
    IRC_S7702_D,
    IRC_S7702_G,
    contract_under_applicable_law_for_a_and_g,
};

pub entity InsuranceContract { label en unofficial "a contract which is a life insurance contract under the applicable [State/foreign] law"; }

pub relation life_insurance_contract_under_applicable_law(c: InsuranceContract) kind empirical {
    label en official "any contract which is a life insurance contract under the applicable law";
}

// --- (b) Cash value accumulation test ---------------------------------------
pub relation cash_surrender_value_at(c: InsuranceContract, on: Date, amount: Money) kind empirical {
    label en official "the cash surrender value of such contract";
}
pub relation net_single_premium_to_fund_future_benefits_at(c: InsuranceContract, on: Date, amount: Money) kind empirical {
    label en official "the net single premium which would have to be paid at such time to fund future benefits under the contract [determined at the greater of the applicable accumulation test minimum rate or the rate(s) guaranteed on issuance, per (b)(2)]";
}
pub relation cash_value_never_exceeds_net_single_premium(c: InsuranceContract) kind institutional {
    label en unofficial "by the terms of the contract, the cash surrender value may not at any time exceed the net single premium which would have to be paid at such time to fund future benefits under the contract — the (b)(1) test holds at every asserted comparison date";
}
pub relation cash_value_accumulation_test(c: InsuranceContract) kind institutional {
    label en official "a contract meets the cash value accumulation test of this subsection if, by the terms of the contract, the cash surrender value of such contract may not at any time exceed the net single premium which would have to be paid at such time to fund future benefits under the contract";
}
@source(IRC_S7702_B, relation = formalizes, coverage = partial, quote = "A contract meets the cash value accumulation test of this subsection if, by the terms of the contract, the cash surrender value of such contract may not at any time exceed the net single premium which would have to be paid at such time to fund future benefits under the contract.")
rule CashValueNeverExceedsNetSinglePremiumAtAssertedDate strict {
    for c: InsuranceContract; for on: Date; for csv: Money; for nsp: Money;
    when cash_surrender_value_at(c, on, csv) and net_single_premium_to_fund_future_benefits_at(c, on, nsp)
        and csv <= nsp;
    then cash_value_never_exceeds_net_single_premium(c);
}
@source(IRC_S7702_B, relation = formalizes, coverage = partial, quote = "A contract meets the cash value accumulation test of this subsection if, by the terms of the contract, the cash surrender value of such contract may not at any time exceed the net single premium which would have to be paid at such time to fund future benefits under the contract.")
rule ContractMeetingCashValueTestQualifies strict {
    for c: InsuranceContract;
    when cash_value_never_exceeds_net_single_premium(c);
    then cash_value_accumulation_test(c);
}

// --- (c) Guideline premium requirements; (d) cash value corridor ------------
pub relation sum_of_premiums_paid_to_date(c: InsuranceContract, on: Date, amount: Money) kind empirical {
    label en official "the sum of the premiums paid under such contract";
}
pub relation guideline_single_premium(c: InsuranceContract, amount: Money) kind empirical {
    label en official "the premium at issue with respect to future benefits under the contract [determined per (c)(3)(B) on reasonable mortality/other charges and interest]";
}
pub relation sum_of_guideline_level_premiums_to_date(c: InsuranceContract, on: Date, amount: Money) kind empirical {
    label en official "the sum of the guideline level premiums to such date";
}
pub relation guideline_premium_limitation_at(c: InsuranceContract, on: Date, amount: Money) kind institutional {
    label en official "the term \"guideline premium limitation\" means, as of any date, the greater of the guideline single premium, or the sum of the guideline level premiums to such date";
}
pub relation meets_guideline_premium_requirements(c: InsuranceContract) kind institutional {
    label en official "a contract meets the guideline premium requirements of this subsection if the sum of the premiums paid under such contract does not at any time exceed the guideline premium limitation as of such time";
}
pub relation death_benefit_at(c: InsuranceContract, on: Date, amount: Money) kind empirical {
    label en official "the death benefit under the contract at any time";
}
pub relation applicable_percentage_of_cash_surrender_value_at(c: InsuranceContract, on: Date, amount: Money) kind empirical {
    label en official "the applicable percentage of the cash surrender value [per the age-based table of (d)(2)]";
}
pub relation falls_within_cash_value_corridor(c: InsuranceContract) kind institutional {
    label en official "a contract falls within the cash value corridor of this subsection if the death benefit under the contract at any time is not less than the applicable percentage of the cash surrender value";
}
pub relation meets_guideline_premium_test(c: InsuranceContract) kind institutional {
    label en unofficial "(a)(2): the contract meets the guideline premium requirements of (c) AND falls within the cash value corridor of (d)";
}

@source(IRC_S7702_C, relation = formalizes, coverage = partial, quote = "The term \"guideline premium limitation\" means, as of any date, the greater of—")
rule GuidelinePremiumLimitationIsGreaterOfSingleOrLevelSum strict {
    for c: InsuranceContract; for on: Date; for single: Money; for levelSum: Money;
    when guideline_single_premium(c, single) and sum_of_guideline_level_premiums_to_date(c, on, levelSum) and single >= levelSum;
    then guideline_premium_limitation_at(c, on, single);
}
@source(IRC_S7702_C, relation = formalizes, coverage = partial, quote = "The term \"guideline premium limitation\" means, as of any date, the greater of—")
rule GuidelinePremiumLimitationIsLevelSumWhenGreater strict {
    for c: InsuranceContract; for on: Date; for single: Money; for levelSum: Money;
    when guideline_single_premium(c, single) and sum_of_guideline_level_premiums_to_date(c, on, levelSum) and levelSum > single;
    then guideline_premium_limitation_at(c, on, levelSum);
}
@source(IRC_S7702_C, relation = formalizes, coverage = partial, quote = "A contract meets the guideline premium requirements of this subsection if the sum of the premiums paid under such contract does not at any time exceed the guideline premium limitation as of such time.")
rule PremiumsPaidNeverExceedGuidelineLimitation strict {
    for c: InsuranceContract; for on: Date; for paid: Money; for limit: Money;
    when sum_of_premiums_paid_to_date(c, on, paid) and guideline_premium_limitation_at(c, on, limit) and paid <= limit;
    then meets_guideline_premium_requirements(c);
}
@source(IRC_S7702_D, relation = formalizes, coverage = partial, quote = "A contract falls within the cash value corridor of this subsection if the death benefit under the contract at any time is not less than the applicable percentage of the cash surrender value.")
rule DeathBenefitAtLeastApplicablePercentage strict {
    for c: InsuranceContract; for on: Date; for db: Money; for corridor: Money;
    when death_benefit_at(c, on, db) and applicable_percentage_of_cash_surrender_value_at(c, on, corridor) and db >= corridor;
    then falls_within_cash_value_corridor(c);
}
@source(IRC_S7702_A, relation = formalizes, coverage = partial, quote = "meets the guideline premium requirements of subsection (c)")
rule GuidelinePremiumRequirementsAndCorridorGiveGuidelinePremiumTest strict {
    for c: InsuranceContract;
    when meets_guideline_premium_requirements(c) and falls_within_cash_value_corridor(c);
    then meets_guideline_premium_test(c);
}

// --- (a) General rule: the definition itself --------------------------------
pub relation life_insurance_contract(c: InsuranceContract) kind institutional {
    label en official "for purposes of this title, the term \"life insurance contract\" means any contract which is a life insurance contract under the applicable law, but only if such contract meets the cash value accumulation test of subsection (b), or meets the guideline premium requirements of subsection (c) and falls within the cash value corridor of subsection (d)";
}
@source(IRC_S7702_A, relation = formalizes, coverage = partial, quote = "the term \"life insurance contract\" means any contract which is a life insurance contract under the applicable law, but only if such contract—")
rule QualifiesUnderCashValueAccumulationTest strict {
    for c: InsuranceContract;
    when contract_under_applicable_law_for_a_and_g(c) and cash_value_accumulation_test(c);
    then life_insurance_contract(c);
}
@source(IRC_S7702_A, relation = formalizes, coverage = partial, quote = "the term \"life insurance contract\" means any contract which is a life insurance contract under the applicable law, but only if such contract—")
rule QualifiesUnderGuidelinePremiumTest strict {
    for c: InsuranceContract;
    when contract_under_applicable_law_for_a_and_g(c) and meets_guideline_premium_test(c);
    then life_insurance_contract(c);
}

// --- (g) Treatment of contracts which do not meet the (a) test -------------
// Modeled at the level the task requires (a typed classification, not the
// full income-inclusion computation of (g)(1)(B)-(D), which is a technical
// gap noted in the coverage row for `26/7702/g/...`): a contract which is a
// life insurance contract under State/foreign law but fails BOTH (a) tests
// loses the title's life-insurance-contract treatment and its "income on
// the contract" becomes ordinary income of the policyholder — the FACT of
// that consequence is modeled; the (g)(1)(B) formula for the amount is not.
pub relation fails_life_insurance_contract_definition(c: InsuranceContract) kind institutional {
    label en official "if at any time any contract which is a life insurance contract under the applicable law does not meet the definition of life insurance contract under subsection (a), the income on the contract for any taxable year of the policyholder shall be treated as ordinary income received or accrued by the policyholder during such year";
}
@source(IRC_S7702_G, relation = formalizes, coverage = partial, quote = "If at any time any contract which is a life insurance contract under the applicable law does not meet the definition of life insurance contract under subsection (a), the income on the contract for any taxable year of the policyholder shall be treated as ordinary income received or accrued by the policyholder during such year.")
rule ContractUnderApplicableLawFailingBothTestsFailsDefinition strict {
    for c: InsuranceContract;
    when contract_under_applicable_law_for_a_and_g(c) and not_known(cash_value_accumulation_test(c)) and not_known(meets_guideline_premium_test(c));
    then fails_life_insurance_contract_definition(c);
}
