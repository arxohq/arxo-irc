// Stage 3 (26.09.2026) — section 7701(a)(33): the deeming sentences stage 2
// left to the case's aggregates. (G) the pre-1954 agreement for lease is
// considered a lease including the years it may be renewed or continued; (H)
// dividends and interest, and (G) lease income, received from a regulated public
// utility that is a member of the common parent's affiliated group are treated
// as derived from sources (A)-(F); the last sentence of the limiting paragraph:
// revenue from unregulated rates counts as (A) or (D) income when the Secretary
// is satisfied.
//
// JUDGMENT CALLS
//  - (H) reads the payer's status from `regulated_public_utility_not_h`: the
//    payer utility is tested by (A)-(G) only. A payer that is itself a
//    subparagraph (H) common parent would make `regulated_public_utility` depend
//    on itself (LDC-E4102); a chain of common parents is not derived.
//  - The amounts of income are asserted per item; they are added by aggregates over
//    strict-derived relations, which the runtime subset supports.

language "law.core" version "0.2";
package us.irc.definitions version "0.1.1";
namespace "urn:us:irc:definitions:clir";

use self::{
    IRC_S7701,
    SecretarySatisfiedUnregulatedRatesAsFavourableAsRegulated,
    TaxableYear,
    UtilityCandidate,
    described_in_utility_subparagraphs_a_through_f,
    each_lease_term_more_than_twenty_years,
    gross_income_derived_directly_or_indirectly_from_sources_a_through_f,
    gross_income_for_utility_test,
    gross_income_from_leases_and_sources_a_through_f,
    gross_income_from_utility_sources_a_through_f,
    rail_carrier_subject_to_part_a_of_subtitle_iv_of_title_49,
    substantially_all_railroad_properties_leased_before_1954,
    utility_eighty_percent_income_test_met,
};

// --- (G): the lease term including renewals ----------------------------------------
pub relation railroad_lease_of(u: UtilityCandidate, lease: Text) kind empirical { label en official "a lease of the railroad properties of the rail carrier"; }
pub relation lease_agreement_entered_into_on(u: UtilityCandidate, lease: Text, d: Date) kind empirical { label en official "the date the agreement for lease was entered into"; }
pub relation lease_stated_term_years(u: UtilityCandidate, lease: Text, years: Integer) kind empirical { label en official "the term of the lease in years, before renewals"; }
pub relation lease_renewable_additional_years(u: UtilityCandidate, lease: Text, years: Integer) kind empirical { label en official "the total number of years the agreement may, unless sooner terminated, be renewed or continued under its terms"; }
pub relation lease_term_years_for_g(u: UtilityCandidate, lease: Text, years: Integer) kind institutional {
    label en official "the term of the lease for (G)(ii): for an agreement entered into before January 1, 1954, the years it may be renewed or continued are part of the lease";
}
@source(IRC_S7701, coverage = partial, quote = "an agreement for lease of railroad properties entered into before January 1, 1954, shall be considered to be a lease including such term as the total number of years of such agreement may, unless sooner terminated, be renewed or continued under the terms of the agreement")
rule PreNineteenFiftyFourLeaseIncludesRenewalYears strict {
    for u: UtilityCandidate; for l: Text; for d: Date; for base: Integer; for extra: Integer;
    when lease_agreement_entered_into_on(u, l, d) and d < @1954-01-01 and lease_stated_term_years(u, l, base) and lease_renewable_additional_years(u, l, extra);
    then lease_term_years_for_g(u, l, base + extra);
}
rule PreNineteenFiftyFourLeaseWithoutRenewalYears strict {
    for u: UtilityCandidate; for l: Text; for d: Date; for base: Integer;
    when lease_agreement_entered_into_on(u, l, d) and d < @1954-01-01 and lease_stated_term_years(u, l, base) and not_known(lease_has_renewal_years(u, l));
    then lease_term_years_for_g(u, l, base);
}
pub relation lease_has_renewal_years(u: UtilityCandidate, lease: Text) kind institutional { label en unofficial "helper: renewal years are stated for the lease"; }
rule LeaseHasRenewalYears strict { for u: UtilityCandidate; for l: Text; for y: Integer; when lease_renewable_additional_years(u, l, y); then lease_has_renewal_years(u, l); }
@source(IRC_S7701, coverage = partial, quote = "any such renewal or continuance under such agreement shall be considered part of the lease entered into before January 1, 1954")
rule PostNineteenFiftyFourLeaseKeepsStatedTerm strict {
    for u: UtilityCandidate; for l: Text; for d: Date; for base: Integer;
    when lease_agreement_entered_into_on(u, l, d) and d >= @1954-01-01 and lease_stated_term_years(u, l, base);
    then lease_term_years_for_g(u, l, base);
}
pub relation lease_not_over_twenty_years_for_g(u: UtilityCandidate, lease: Text) kind institutional { label en unofficial "helper: the lease has a term of 20 years or less"; }
rule LeaseNotOverTwentyYears strict { for u: UtilityCandidate; for l: Text; for y: Integer; when lease_term_years_for_g(u, l, y) and y <= 20; then lease_not_over_twenty_years_for_g(u, l); }
pub relation each_lease_over_twenty_years_derived(u: UtilityCandidate) kind institutional { label en official "each lease is for a term of more than 20 years, the renewal years of a pre-1954 agreement counted"; }
@source(IRC_S7701, coverage = partial, quote = "(ii) each lease is for a term of more than 20 years")
rule EachLeaseOverTwentyYearsFromTerms strict {
    for u: UtilityCandidate; for l: Text;
    when railroad_lease_of(u, l) and not_known(lease_not_over_twenty_years_for_g(u, l)) and lease_term_years_for_g(u, l, _);
    then each_lease_over_twenty_years_derived(u);
}
pub relation lease_short_term_exists_for_g(u: UtilityCandidate) kind institutional { label en unofficial "helper: some lease of the carrier has a term of 20 years or less"; }
rule LeaseShortTermExists strict { for u: UtilityCandidate; for l: Text; when lease_not_over_twenty_years_for_g(u, l); then lease_short_term_exists_for_g(u); }
pub relation each_lease_term_more_than_twenty_years_for_g(u: UtilityCandidate) kind institutional { label en official "each lease is for a term of more than 20 years: asserted by the case, or derived from the lease terms"; }
rule EachLeaseOverTwentyAsserted strict { for u: UtilityCandidate; when each_lease_term_more_than_twenty_years(u); then each_lease_term_more_than_twenty_years_for_g(u); }
rule EachLeaseOverTwentyDerivedAndNoShortLease strict { for u: UtilityCandidate; when each_lease_over_twenty_years_derived(u) and not_known(lease_short_term_exists_for_g(u)); then each_lease_term_more_than_twenty_years_for_g(u); }

// --- (H): income from affiliated regulated utilities ----------------------------------
pub relation regulated_public_utility_not_h(u: UtilityCandidate, y: TaxableYear) kind institutional { label en unofficial "a regulated public utility under (A)-(G), the payer test of the deeming sentence of (H) (avoids a dependency of the definition on itself)"; }
rule PayerRegulatedByAThroughF strict { for u: UtilityCandidate; for y: TaxableYear; when described_in_utility_subparagraphs_a_through_f(u) and utility_eighty_percent_income_test_met(u, y); then regulated_public_utility_not_h(u, y); }
rule PayerRegulatedByG strict {
    for u: UtilityCandidate; for y: TaxableYear; for d: Money; for t: Money;
    when rail_carrier_subject_to_part_a_of_subtitle_iv_of_title_49(u) and substantially_all_railroad_properties_leased_before_1954(u) and each_lease_term_more_than_twenty_years_for_g(u)
        and gross_income_from_leases_and_sources_a_through_f(u, y, d) and gross_income_for_utility_test(u, y, t) and d * 100 >= t * 80;
    then regulated_public_utility_not_h(u, y);
}
pub relation income_received_from_utility(u: UtilityCandidate, y: TaxableYear, payer: UtilityCandidate, amount: Money) kind empirical { label en official "dividends and interest, and income from (G) leases, received by the common parent from the payer"; }
pub relation payer_in_affiliated_group_of_common_parent(payer: UtilityCandidate, u: UtilityCandidate) kind empirical { label en official "the regulated public utility is a member of an affiliated group (as defined in section 1504) which includes the common parent corporation"; }
pub relation deemed_income_from_sources_a_through_f(u: UtilityCandidate, y: TaxableYear, amount: Money) kind institutional { label en official "income received from a regulated public utility in the common parent's affiliated group, considered as derived from sources described in (A)-(F)"; }
@source(IRC_S7701, coverage = partial, quote = "received from a regulated public utility shall be considered as derived from sources described in subparagraphs (A) through (F), inclusive, if the regulated public utility is a member of an affiliated group")
rule DeemedIncomeFromAffiliatedRegulatedUtilities strict {
    for u: UtilityCandidate; for y: TaxableYear; for p0: UtilityCandidate; for a0: Money;
    when income_received_from_utility(u, y, p0, a0) and payer_in_affiliated_group_of_common_parent(p0, u) and regulated_public_utility_not_h(p0, y);
    then deemed_income_from_sources_a_through_f(u, y, sum all a: Money for p: UtilityCandidate where income_received_from_utility(u, y, p, a) and payer_in_affiliated_group_of_common_parent(p, u) and regulated_public_utility_not_h(p, y));
}
pub relation deemed_income_stated(u: UtilityCandidate, y: TaxableYear) kind institutional { label en unofficial "helper: deemed income exists for the year"; }
rule DeemedIncomeStated strict { for u: UtilityCandidate; for y: TaxableYear; for a: Money; when deemed_income_from_sources_a_through_f(u, y, a); then deemed_income_stated(u, y); }
pub relation gross_income_from_a_through_f_including_deemed(u: UtilityCandidate, y: TaxableYear, amount: Money) kind institutional { label en official "gross income derived directly or indirectly from sources (A)-(F), with the deemed income of (H)"; }
rule GrossIncomeFromAThroughFWithDeemed strict { for u: UtilityCandidate; for y: TaxableYear; for d: Money; for x: Money; when gross_income_derived_directly_or_indirectly_from_sources_a_through_f(u, y, d) and deemed_income_from_sources_a_through_f(u, y, x); then gross_income_from_a_through_f_including_deemed(u, y, d + x); }
rule GrossIncomeFromAThroughFWithoutDeemed strict { for u: UtilityCandidate; for y: TaxableYear; for d: Money; when gross_income_derived_directly_or_indirectly_from_sources_a_through_f(u, y, d) and not_known(deemed_income_stated(u, y)); then gross_income_from_a_through_f_including_deemed(u, y, d); }

// --- limiting paragraph, last sentence: unregulated-rate revenue ---------------------
pub relation revenue_from_unregulated_rates(u: UtilityCandidate, y: TaxableYear, amount: Money) kind empirical { label en official "revenue derived from unregulated rates"; }
pub relation unregulated_revenue_stated(u: UtilityCandidate, y: TaxableYear) kind institutional { label en unofficial "helper: unregulated-rate revenue is asserted"; }
rule UnregulatedRevenueStated strict { for u: UtilityCandidate; for y: TaxableYear; for a: Money; when revenue_from_unregulated_rates(u, y, a); then unregulated_revenue_stated(u, y); }
pub relation utility_source_income_for_eighty_percent_test(u: UtilityCandidate, y: TaxableYear, amount: Money) kind institutional { label en official "gross income derived from sources (A)-(F), with the unregulated-rate revenue considered as (A) or (D) income when the Secretary is satisfied"; }
@source(IRC_S7701, coverage = partial, quote = "then such revenue from such unregulated rates shall be considered, for purposes of the preceding sentence, as income derived from sources described in subparagraph (A) or (D)")
rule UnregulatedRevenueCountsWhenSecretarySatisfied strict {
    for u: UtilityCandidate; for y: TaxableYear; for d: Money; for x: Money;
    when gross_income_from_utility_sources_a_through_f(u, y, d) and revenue_from_unregulated_rates(u, y, x) and SecretarySatisfiedUnregulatedRatesAsFavourableAsRegulated(u, y);
    then utility_source_income_for_eighty_percent_test(u, y, d + x);
}
rule UnregulatedRevenueIgnoredWithoutSatisfaction strict {
    for u: UtilityCandidate; for y: TaxableYear; for d: Money;
    when gross_income_from_utility_sources_a_through_f(u, y, d) and unregulated_revenue_stated(u, y) and not_known(SecretarySatisfiedUnregulatedRatesAsFavourableAsRegulated(u, y));
    then utility_source_income_for_eighty_percent_test(u, y, d);
}
rule NoUnregulatedRevenueStated strict {
    for u: UtilityCandidate; for y: TaxableYear; for d: Money;
    when gross_income_from_utility_sources_a_through_f(u, y, d) and not_known(unregulated_revenue_stated(u, y));
    then utility_source_income_for_eighty_percent_test(u, y, d);
}
