// §7704(d)(1)(E), as amended by Public Law 119-21 sec. 70524 (fragment
// `us.irc.temporal::PL119_21_S70524`): income and gains from the transportation
// or storage of the added fuels (subsection (k) of section 6426 fuels and
// sustainable aviation fuel; liquefied or compressed hydrogen) and from
// carbon capture, advanced nuclear electricity, certain qualified energy
// resources and energy property become qualifying income of a publicly traded
// partnership for taxable years beginning after December 31, 2025 (sec.
// 70524(b)).
//
// ptp.law reads the case-asserted AGGREGATE qualifying and total gross income
// of a year (`qualifying_gross_income_for_year`); an aggregate over the
// derived item relation below is outside the runtime subset (§111), so the
// amendment is exposed at the item level and the case composes the aggregate
// (TECH-GAPS G3511). The enum of ptp.law is NOT extended: `QualifyingIncomeCategory`
// is a pub interface that other owners import; the new categories get their
// own enum (additive, no change to the existing interface).
//
// DEONTICS: none (a definition of qualifying income).

language "law.core" version "0.2";
package us.irc.definitions version "0.1.1";
namespace "urn:us:irc:definitions:clir";

use self::{
    Partnership,
    TaxableYear,
};

pub enum PtpCategoryAddedByPl11921 {
    Section6426kFuelOrSustainableAviationFuelTransportOrStorage;
    LiquefiedOrCompressedHydrogenTransportOrStorage;
    QualifiedCarbonCaptureFacilityElectricityOrCapture;
    AdvancedNuclearFacilityElectricity;
    QualifiedEnergyResourceElectricityOrThermal;
    EnergyPropertyOperation;
    label en official "the qualifying-income categories added to section 7704(d)(1)(E) by Public Law 119-21 sec. 70524(a)";
}
pub entity PtpIncomeItem { label en unofficial "an item of income or gain of a partnership"; }
pub relation ptp_income_item_of_taxable_year(item: PtpIncomeItem, p: Partnership, y: TaxableYear) kind empirical {
    label en unofficial "the item is income or gain of the partnership for the taxable year";
}
pub relation income_item_in_category_added_by_pl119_21(item: PtpIncomeItem, cat: PtpCategoryAddedByPl11921) kind empirical {
    label en official "income and gains derived from the added activity";
}
pub relation qualifying_income_item_under_7704d1e_as_amended_by_pl119_21(item: PtpIncomeItem) kind institutional {
    label en official "income and gains derived from the transportation or storage of fuels described in section 6426(b), (c), (d), (e), or (k) or sustainable aviation fuel; liquefied or compressed hydrogen; certain carbon capture, advanced nuclear, qualified energy resource and energy property activities, for taxable years beginning after December 31, 2025";
}
@source(us.irc.temporal::PL119_21_S70524, relation = formalizes, coverage = partial, quote = "(3) by striking “or the transportation or storage” and all that follows and inserting the following:“(ii) the transportation or storage of—“(I) any fuel described in subsection (b), (c), (d), (e), or (k) of section 6426")
rule AddedActivityIncomeIsQualifyingForYearsBeginningAfter2025 strict {
    effective [@2025-07-04, infinity);
    for item: PtpIncomeItem; for p: Partnership; for y: TaxableYear; for cat: PtpCategoryAddedByPl11921; for b: Date;
    when ptp_income_item_of_taxable_year(item, p, y) and income_item_in_category_added_by_pl119_21(item, cat)
        and us.irc.core::begins(y, b) and b > @2025-12-31;
    then qualifying_income_item_under_7704d1e_as_amended_by_pl119_21(item);
}
