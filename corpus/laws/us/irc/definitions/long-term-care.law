// §7702B — treatment of qualified long-term care insurance (stage 2),
// subsections (a)-(g) and the 1996 effective-date note (Pub. L. 104-191
// §321(f), fragment `IRC_S7702B_NOTE_7`).
//
// SHAPE. (b)(1) is the definition: six conjuncts (A)-(F), with the special
// rules of (b)(2) turning off (A)/(B)/(D)/(E) in stated cases; (c) defines
// qualified long-term care services and the chronically ill individual;
// (a) lists the consequences of QLTC status; (d) computes the per diem
// limitation (periodic payments above it are gross income); (e) riders; (f)
// State plans; (g) the model regulation/Act, disclosure and nonforfeiture
// requirements.
//
// DEONTICS. The subsection allocates no conduct to a person: (a) and (d) are
// tax characterisations, (b)/(c)/(g) are eligibility conditions. The only
// norm on an organ is (g)(2)(B)(iii): the Secretary decides whether a model
// requirement is met (an evaluative channel, DECISION-0194, modelled as an
// external judgment relation with authority Secretary). The insurer's
// nonforfeiture "offer" of (g)(4) is a condition of the contract's
// qualification, not a duty whose breach the section sanctions (the sanction
// is loss of QLTC status): modelled as a condition.
//
// AMOUNTS. The per diem dollar amount is the A3 dataset
// `LongTermCarePerDiemDollarAmount` (statutory $175 for calendar year 1997;
// Rev. Proc. 2024-40 sec. 2.62 for 2025, Rev. Proc. 2025-32 sec. 4.62 for
// 2026); other calendar years are gaps (MISSING_PARAMETER_VALUE, TECH-GAPS
// G3503), not zero. The parameter is read only inside `round(..., 2,
// "HALF_UP")` (a bare parameter as a head argument is silent, TECH-GAPS
// "Находка 25.09").

language "law.core" version "0.2";
package us.irc.definitions version "0.1.1";
namespace "urn:us:irc:definitions:clir";

use self::{
    IRC_S7702B_A,
    IRC_S7702B_B,
    IRC_S7702B_C,
    IRC_S7702B_D,
    IRC_S7702B_E,
    IRC_S7702B_F,
    IRC_S7702B_G,
    IRC_S7702B_NOTE_7,
    Individual,
};

// --- (c)(4) Licensed health care practitioner ---------------------------------------------
pub relation is_physician_under_social_security_act_1861r1(p: Individual) kind empirical {
    label en official "any physician (as defined in section 1861(r)(1) of the Social Security Act)";
}
pub relation is_registered_professional_nurse_or_licensed_social_worker(p: Individual) kind empirical {
    label en official "any registered professional nurse, licensed social worker";
}
pub relation meets_secretary_prescribed_practitioner_requirements(p: Individual) kind empirical {
    label en official "other individual who meets such requirements as may be prescribed by the Secretary";
}
pub relation licensed_health_care_practitioner(p: Individual) kind institutional {
    label en official "the term \"licensed health care practitioner\" means any physician (as defined in section 1861(r)(1) of the Social Security Act) and any registered professional nurse, licensed social worker, or other individual who meets such requirements as may be prescribed by the Secretary";
}
@source(IRC_S7702B_C, relation = formalizes, coverage = partial, quote = "any physician (as defined in section 1861(r)(1) of the Social Security Act)")
rule PhysicianIsLicensedHealthCarePractitioner strict {
    for p: Individual;
    when is_physician_under_social_security_act_1861r1(p);
    then licensed_health_care_practitioner(p);
}
@source(IRC_S7702B_C, relation = formalizes, coverage = partial, quote = "any registered professional nurse, licensed social worker")
rule NurseOrSocialWorkerIsLicensedHealthCarePractitioner strict {
    for p: Individual;
    when is_registered_professional_nurse_or_licensed_social_worker(p);
    then licensed_health_care_practitioner(p);
}
@source(IRC_S7702B_C, relation = formalizes, coverage = partial, quote = "or other individual who meets such requirements as may be prescribed by the Secretary")
rule SecretaryPrescribedPractitionerIsLicensedHealthCarePractitioner strict {
    for p: Individual;
    when meets_secretary_prescribed_practitioner_requirements(p);
    then licensed_health_care_practitioner(p);
}

// --- (c)(2) Chronically ill individual -----------------------------------------------------
pub enum ActivityOfDailyLiving {
    Eating;
    Toileting;
    Transferring;
    Bathing;
    Dressing;
    Continence;
    label en official "each of the following is an activity of daily living: (i) Eating. (ii) Toileting. (iii) Transferring. (iv) Bathing. (v) Dressing. (vi) Continence.";
}
pub relation unable_to_perform_activity_without_substantial_assistance_for_at_least_90_days(p: Individual, a: ActivityOfDailyLiving) kind empirical {
    label en official "unable to perform (without substantial assistance from another individual) the activity for a period of at least 90 days due to a loss of functional capacity";
}
pub relation unable_to_perform_at_least_two_activities_of_daily_living_for_90_days(p: Individual) kind institutional {
    label en official "being unable to perform (without substantial assistance from another individual) at least 2 activities of daily living for a period of at least 90 days due to a loss of functional capacity";
}
@source(IRC_S7702B_C, relation = formalizes, coverage = partial, quote = "(i) being unable to perform (without substantial assistance from another individual) at least 2 activities of daily living for a period of at least 90 days due to a loss of functional capacity,")
rule AtLeastTwoActivitiesUnperformableIsFirstLimb strict {
    for p: Individual; for a: ActivityOfDailyLiving;
    when unable_to_perform_activity_without_substantial_assistance_for_at_least_90_days(p, a)
        and count(collect x: ActivityOfDailyLiving where unable_to_perform_activity_without_substantial_assistance_for_at_least_90_days(p, x)) >= 2;
    then unable_to_perform_at_least_two_activities_of_daily_living_for_90_days(p);
}
pub relation has_disability_level_similar_under_regulations(p: Individual) kind empirical {
    label en official "having a level of disability similar (as determined under regulations prescribed by the Secretary in consultation with the Secretary of Health and Human Services) to the level of disability described in clause (i)";
}
pub relation requires_substantial_supervision_due_to_severe_cognitive_impairment(p: Individual) kind empirical {
    label en official "requiring substantial supervision to protect such individual from threats to health and safety due to severe cognitive impairment";
}
pub relation certified_by_practitioner_on(p: Individual, practitioner: Individual, cert_date: Date) kind empirical {
    label en official "has been certified by a licensed health care practitioner";
}
pub relation chronically_ill_evaluated_on(p: Individual, on: Date) kind empirical {
    label en unofficial "grounding fact: the date on which chronic illness is being determined";
}
pub relation certification_within_preceding_12_months(p: Individual, on: Date) kind institutional {
    label en official "within the preceding 12-month period a licensed health care practitioner has certified that such individual meets such requirements";
}
@source(IRC_S7702B_C, relation = formalizes, coverage = exact, quote = "Such term shall not include any individual otherwise meeting the requirements of the preceding sentence unless within the preceding 12-month period a licensed health care practitioner has certified that such individual meets such requirements.")
rule PractitionerCertificationWithinPrecedingTwelveMonths strict {
    for p: Individual; for pr: Individual; for cd: Date; for on: Date;
    for calendar_before_1: Date;
    when certified_by_practitioner_on(p, pr, cd) and licensed_health_care_practitioner(pr) and chronically_ill_evaluated_on(p, on)
        and cd <= on and cd >= calendar_before_1
        and us.irc.core::civil_calendar_boundary_before(on, 12, us.irc.core::CalendarMonth, calendar_before_1);
    then certification_within_preceding_12_months(p, on);
}
pub relation chronically_ill_individual(p: Individual, on: Date) kind institutional {
    label en official "the term \"chronically ill individual\" means any individual who has been certified by a licensed health care practitioner as (i) unable to perform at least 2 activities of daily living for at least 90 days, (ii) having a similar level of disability, or (iii) requiring substantial supervision due to severe cognitive impairment";
}
@source(IRC_S7702B_C, relation = formalizes, coverage = partial, quote = "(i) being unable to perform (without substantial assistance from another individual) at least 2 activities of daily living for a period of at least 90 days due to a loss of functional capacity,")
rule TwoActivitiesLimbMakesChronicallyIll strict {
    for p: Individual; for on: Date;
    when unable_to_perform_at_least_two_activities_of_daily_living_for_90_days(p) and certification_within_preceding_12_months(p, on);
    then chronically_ill_individual(p, on);
}
@source(IRC_S7702B_C, relation = formalizes, coverage = partial, quote = "(ii) having a level of disability similar (as determined under regulations prescribed by the Secretary in consultation with the Secretary of Health and Human Services) to the level of disability described in clause (i), or")
rule SimilarDisabilityLimbMakesChronicallyIll strict {
    for p: Individual; for on: Date;
    when has_disability_level_similar_under_regulations(p) and certification_within_preceding_12_months(p, on);
    then chronically_ill_individual(p, on);
}
@source(IRC_S7702B_C, relation = formalizes, coverage = partial, quote = "(iii) requiring substantial supervision to protect such individual from threats to health and safety due to severe cognitive impairment.")
rule SevereCognitiveImpairmentLimbMakesChronicallyIll strict {
    for p: Individual; for on: Date;
    when requires_substantial_supervision_due_to_severe_cognitive_impairment(p) and certification_within_preceding_12_months(p, on);
    then chronically_ill_individual(p, on);
}

// --- (c)(1), (c)(3) Qualified long-term care services -------------------------------------------
pub entity LongTermCareService { label en unofficial "a service or item furnished to an individual"; }
pub relation is_diagnostic_preventive_therapeutic_curing_treating_mitigating_or_rehabilitative_service(s: LongTermCareService) kind empirical {
    label en official "necessary diagnostic, preventive, therapeutic, curing, treating, mitigating, and rehabilitative services";
}
pub relation care_primary_purpose_is_needed_assistance_with_disabilities_of_chronic_illness(s: LongTermCareService) kind empirical {
    label en official "any care the primary purpose of which is the provision of needed assistance with any of the disabilities as a result of which the individual is a chronically ill individual (including the protection from threats to health and safety due to severe cognitive impairment)";
}
pub relation maintenance_or_personal_care_services(s: LongTermCareService) kind institutional {
    label en official "the term \"maintenance or personal care services\" means any care the primary purpose of which is the provision of needed assistance with any of the disabilities as a result of which the individual is a chronically ill individual";
}
@source(IRC_S7702B_C, relation = formalizes, coverage = exact, quote = "The term \"maintenance or personal care services\" means any care the primary purpose of which is the provision of needed assistance with any of the disabilities as a result of which the individual is a chronically ill individual (including the protection from threats to health and safety due to severe cognitive impairment).")
rule CarePrimarilyAssistingDisabilitiesIsMaintenanceOrPersonalCare strict {
    for s: LongTermCareService;
    when care_primary_purpose_is_needed_assistance_with_disabilities_of_chronic_illness(s);
    then maintenance_or_personal_care_services(s);
}
pub relation service_required_by_individual(s: LongTermCareService, p: Individual, on: Date) kind empirical {
    label en official "are required by a chronically ill individual";
}
pub relation provided_pursuant_to_plan_of_care_prescribed_by_licensed_practitioner(s: LongTermCareService) kind empirical {
    label en official "are provided pursuant to a plan of care prescribed by a licensed health care practitioner";
}
pub relation qualified_long_term_care_service(s: LongTermCareService, p: Individual, on: Date) kind institutional {
    label en official "the term \"qualified long-term care services\" means necessary diagnostic, preventive, therapeutic, curing, treating, mitigating, and rehabilitative services, and maintenance or personal care services, which are required by a chronically ill individual and are provided pursuant to a plan of care prescribed by a licensed health care practitioner";
}
@source(IRC_S7702B_C, relation = formalizes, coverage = partial, quote = "The term \"qualified long-term care services\" means necessary diagnostic, preventive, therapeutic, curing, treating, mitigating, and rehabilitative services, and maintenance or personal care services, which—")
rule ListedServiceRequiredByChronicallyIllUnderPlanOfCareIsQualified strict {
    for s: LongTermCareService; for p: Individual; for on: Date;
    when is_diagnostic_preventive_therapeutic_curing_treating_mitigating_or_rehabilitative_service(s)
        and service_required_by_individual(s, p, on) and chronically_ill_individual(p, on)
        and provided_pursuant_to_plan_of_care_prescribed_by_licensed_practitioner(s);
    then qualified_long_term_care_service(s, p, on);
}
@source(IRC_S7702B_C, relation = formalizes, coverage = partial, quote = "The term \"qualified long-term care services\" means necessary diagnostic, preventive, therapeutic, curing, treating, mitigating, and rehabilitative services, and maintenance or personal care services, which—")
rule MaintenanceOrPersonalCareRequiredByChronicallyIllUnderPlanIsQualified strict {
    for s: LongTermCareService; for p: Individual; for on: Date;
    when maintenance_or_personal_care_services(s)
        and service_required_by_individual(s, p, on) and chronically_ill_individual(p, on)
        and provided_pursuant_to_plan_of_care_prescribed_by_licensed_practitioner(s);
    then qualified_long_term_care_service(s, p, on);
}

// --- (g) Additional requirements --------------------------------------------------------------
pub entity LongTermCareContract { label en unofficial "an insurance contract presented for qualified long-term care insurance treatment"; }
pub relation contract_presented_for_qualification(c: LongTermCareContract) kind empirical {
    label en unofficial "grounding fact: the contract is being tested against the (b)(1) definition (an absent-fact conjunct such as (B) or (D) needs the contract named by a positive fact)";
}
pub enum ModelRequirement {
    RegSection7AWithActSection6B;
    RegSection7B;
    RegSection7C;
    RegSection7D;
    RegSection7E;
    RegSection8;
    RegSection9OtherThan9F;
    RegSection10;
    RegSection11;
    RegSection12;
    RegSection23;
    ActSection6C;
    ActSection6D;
    label en official "the requirements of the model regulation (sections 7A with model Act 6B, 7B, 7C, 7D, 7E, 8, 9 other than 9F, 10, 11, 12, 23) and of the model Act (sections 6C and 6D) listed in (g)(2)(A)";
}
external judgment relation SecretaryDeterminesModelRequirementMet(c: LongTermCareContract, r: ModelRequirement) {
    authority Secretary;
    label en official "the determination of whether any requirement of a model regulation or the model Act has been met shall be made by the Secretary";
}
pub relation meets_model_regulation_and_model_act_requirements(c: LongTermCareContract) kind institutional {
    label en official "the requirements of this paragraph are met with respect to any contract if such contract meets the listed requirements of the model regulation and of the model Act (as adopted as of January 1993)";
}
@source(IRC_S7702B_G, relation = formalizes, coverage = partial, quote = "The requirements of this paragraph are met with respect to any contract if such contract meets—")
rule AllThirteenModelRequirementsMetGivesParagraph2 strict {
    for c: LongTermCareContract;
    when SecretaryDeterminesModelRequirementMet(c, RegSection7AWithActSection6B) and SecretaryDeterminesModelRequirementMet(c, RegSection7B)
        and SecretaryDeterminesModelRequirementMet(c, RegSection7C) and SecretaryDeterminesModelRequirementMet(c, RegSection7D)
        and SecretaryDeterminesModelRequirementMet(c, RegSection7E) and SecretaryDeterminesModelRequirementMet(c, RegSection8)
        and SecretaryDeterminesModelRequirementMet(c, RegSection9OtherThan9F) and SecretaryDeterminesModelRequirementMet(c, RegSection10)
        and SecretaryDeterminesModelRequirementMet(c, RegSection11) and SecretaryDeterminesModelRequirementMet(c, RegSection12)
        and SecretaryDeterminesModelRequirementMet(c, RegSection23) and SecretaryDeterminesModelRequirementMet(c, ActSection6C)
        and SecretaryDeterminesModelRequirementMet(c, ActSection6D);
    then meets_model_regulation_and_model_act_requirements(c);
}
pub relation meets_disclosure_requirements_of_section_4980c_d(c: LongTermCareContract) kind empirical {
    label en official "such contract meets the requirements of section 4980C(d)";
}
pub relation level_premium_contract(c: LongTermCareContract) kind empirical {
    label en official "any level premium contract";
}
pub relation issuer_offers_nonforfeiture_provision_to_policyholder(c: LongTermCareContract) kind empirical {
    label en official "the issuer of such contract offers to the policyholder, including any group policyholder, a nonforfeiture provision meeting the requirements of subparagraph (B)";
}
pub relation nonforfeiture_provision_appropriately_captioned(c: LongTermCareContract) kind empirical {
    label en official "the nonforfeiture provision shall be appropriately captioned";
}
pub relation nonforfeiture_provision_gives_benefit_on_premium_default_adjusted_only_for_claims_persistency_interest(c: LongTermCareContract) kind empirical {
    label en official "the nonforfeiture provision shall provide for a benefit available in the event of a default in the payment of any premiums and the amount of the benefit may be adjusted subsequent to being initially granted only as necessary to reflect changes in claims, persistency, and interest as reflected in changes in rates for premium paying contracts approved by the appropriate State regulatory agency for the same contract form";
}
pub relation nonforfeiture_provision_provides_reduced_paid_up_extended_term_shortened_benefit_or_similar_offering(c: LongTermCareContract) kind empirical {
    label en official "the nonforfeiture provision shall provide at least one of: reduced paid-up insurance, extended term insurance, shortened benefit period, or other similar offerings approved by the appropriate State regulatory agency";
}
pub relation nonforfeiture_requirements_of_paragraph_4_met(c: LongTermCareContract) kind institutional {
    label en official "the requirements of this paragraph are met with respect to any level premium contract, if the issuer of such contract offers to the policyholder a nonforfeiture provision meeting the requirements of subparagraph (B)";
}
@source(IRC_S7702B_G, relation = formalizes, coverage = partial, quote = "The requirements of this paragraph are met with respect to any level premium contract, if the issuer of such contract offers to the policyholder, including any group policyholder, a nonforfeiture provision meeting the requirements of subparagraph (B).")
rule LevelPremiumContractOfferingCompliantNonforfeitureMeetsParagraph4 strict {
    for c: LongTermCareContract;
    when level_premium_contract(c) and issuer_offers_nonforfeiture_provision_to_policyholder(c)
        and nonforfeiture_provision_appropriately_captioned(c)
        and nonforfeiture_provision_gives_benefit_on_premium_default_adjusted_only_for_claims_persistency_interest(c)
        and nonforfeiture_provision_provides_reduced_paid_up_extended_term_shortened_benefit_or_similar_offering(c);
    then nonforfeiture_requirements_of_paragraph_4_met(c);
}
@source(IRC_S7702B_G, relation = formalizes, coverage = partial, quote = "The requirements of this paragraph are met with respect to any level premium contract, if the issuer of such contract offers to the policyholder, including any group policyholder, a nonforfeiture provision meeting the requirements of subparagraph (B).")
rule ContractThatIsNotLevelPremiumMeetsParagraph4Vacuously strict {
    for c: LongTermCareContract;
    when contract_presented_for_qualification(c) and not_known(level_premium_contract(c));
    then nonforfeiture_requirements_of_paragraph_4_met(c);
}
pub relation meets_requirements_of_subsection_g(c: LongTermCareContract) kind institutional {
    label en official "the requirements of this subsection are met with respect to any contract if the contract meets the model regulation and model Act requirements, the disclosure requirement of paragraph (3), and the nonforfeiture requirements of paragraph (4)";
}
@source(IRC_S7702B_G, relation = formalizes, coverage = exact, quote = "The requirements of this subsection are met with respect to any contract if the contract meets—")
rule ModelDisclosureAndNonforfeitureGiveSubsectionG strict {
    for c: LongTermCareContract;
    when meets_model_regulation_and_model_act_requirements(c) and meets_disclosure_requirements_of_section_4980c_d(c)
        and nonforfeiture_requirements_of_paragraph_4_met(c);
    then meets_requirements_of_subsection_g(c);
}

// --- (b) The definition -------------------------------------------------------------------------
pub relation only_insurance_protection_is_coverage_of_qualified_long_term_care_services(c: LongTermCareContract) kind empirical {
    label en official "the only insurance protection provided under such contract is coverage of qualified long-term care services";
}
pub relation payments_made_on_per_diem_or_periodic_basis_without_regard_to_expenses(c: LongTermCareContract) kind empirical {
    label en official "payments being made on a per diem or other periodic basis without regard to the expenses incurred during the period to which the payments relate";
}
pub relation coverage_limited_to_qualified_services_apart_from_per_diem_basis(c: LongTermCareContract) kind empirical {
    label en unofficial "apart from the per diem or periodic payment basis, the only insurance protection is coverage of qualified long-term care services";
}
pub relation pays_or_reimburses_expenses_reimbursable_under_title_xviii(c: LongTermCareContract) kind empirical {
    label en official "such contract pays or reimburses expenses incurred for services or items to the extent that such expenses are reimbursable under title XVIII of the Social Security Act or would be so reimbursable but for the application of a deductible or coinsurance amount";
}
pub relation medicare_reimbursable_only_as_secondary_payor(c: LongTermCareContract) kind empirical {
    label en official "expenses which are reimbursable under title XVIII of the Social Security Act only as a secondary payor";
}
pub relation is_guaranteed_renewable(c: LongTermCareContract) kind empirical {
    label en official "such contract is guaranteed renewable";
}
pub relation provides_cash_value_that_can_be_paid_assigned_pledged_or_borrowed(c: LongTermCareContract) kind empirical {
    label en official "such contract provides for a cash surrender value or other money that can be paid, assigned, or pledged as collateral for a loan, or borrowed";
}
pub relation cash_value_only_as_provided_in_1e_or_2c(c: LongTermCareContract) kind empirical {
    label en official "other than as provided in subparagraph (E) or paragraph (2)(C)";
}
pub relation all_refunds_and_dividends_applied_to_reduce_future_premiums_or_increase_future_benefits(c: LongTermCareContract) kind empirical {
    label en official "all refunds of premiums, and all policyholder dividends or similar amounts, under such contract are to be applied as a reduction in future premiums or to increase future benefits";
}
pub relation refund_on_death_or_complete_surrender_not_exceeding_aggregate_premiums(c: LongTermCareContract) kind empirical {
    label en official "any refund on the death of the insured, or on a complete surrender or cancellation of the contract, which cannot exceed the aggregate premiums paid under the contract";
}
pub relation determination_of_chronic_illness_takes_into_account_activity(c: LongTermCareContract, a: ActivityOfDailyLiving) kind empirical {
    label en official "the determination of whether an individual is a chronically ill individual described in subparagraph (A)(i) takes into account the activity";
}
pub relation meets_paragraph_1a_only_ltc_coverage(c: LongTermCareContract) kind institutional {
    label en official "(A) the only insurance protection provided under such contract is coverage of qualified long-term care services";
}
@source(IRC_S7702B_B, relation = formalizes, coverage = partial, quote = "(A) the only insurance protection provided under such contract is coverage of qualified long-term care services,")
rule OnlyLongTermCareCoverageMeets1A strict {
    for c: LongTermCareContract;
    when only_insurance_protection_is_coverage_of_qualified_long_term_care_services(c);
    then meets_paragraph_1a_only_ltc_coverage(c);
}
pub relation meets_paragraph_1b_no_medicare_overlap(c: LongTermCareContract) kind institutional {
    label en official "(B) such contract does not pay or reimburse expenses reimbursable under title XVIII of the Social Security Act (or reimbursable but for a deductible or coinsurance amount)";
}
@source(IRC_S7702B_B, relation = formalizes, coverage = partial, quote = "(B) such contract does not pay or reimburse expenses incurred for services or items to the extent that such expenses are reimbursable under title XVIII of the Social Security Act or would be so reimbursable but for the application of a deductible or coinsurance amount,")
rule NoMedicareOverlapMeets1B strict {
    for c: LongTermCareContract;
    when contract_presented_for_qualification(c) and not_known(pays_or_reimburses_expenses_reimbursable_under_title_xviii(c));
    then meets_paragraph_1b_no_medicare_overlap(c);
}
@source(IRC_S7702B_B, relation = formalizes, coverage = exact, quote = "Paragraph (1)(B) shall not apply to expenses which are reimbursable under title XVIII of the Social Security Act only as a secondary payor.")
rule MedicareSecondaryPayorExpensesDoNotDefeat1B strict {
    for c: LongTermCareContract;
    when pays_or_reimburses_expenses_reimbursable_under_title_xviii(c) and medicare_reimbursable_only_as_secondary_payor(c);
    then meets_paragraph_1b_no_medicare_overlap(c);
}
@source(IRC_S7702B_B, relation = formalizes, coverage = exact, quote = "A contract shall not fail to be described in subparagraph (A) or (B) of paragraph (1) by reason of payments being made on a per diem or other periodic basis without regard to the expenses incurred during the period to which the payments relate.")
rule PerDiemPaymentBasisDoesNotDefeat1A strict {
    for c: LongTermCareContract;
    when payments_made_on_per_diem_or_periodic_basis_without_regard_to_expenses(c) and coverage_limited_to_qualified_services_apart_from_per_diem_basis(c);
    then meets_paragraph_1a_only_ltc_coverage(c);
}
pub relation meets_paragraph_1c_guaranteed_renewable(c: LongTermCareContract) kind institutional {
    label en official "(C) such contract is guaranteed renewable";
}
@source(IRC_S7702B_B, relation = formalizes, coverage = exact, quote = "(C) such contract is guaranteed renewable,")
rule GuaranteedRenewableMeets1C strict {
    for c: LongTermCareContract;
    when is_guaranteed_renewable(c);
    then meets_paragraph_1c_guaranteed_renewable(c);
}
pub relation meets_paragraph_1d_no_pledgeable_cash_value(c: LongTermCareContract) kind institutional {
    label en official "(D) such contract does not provide for a cash surrender value or other money that can be paid, assigned, or pledged as collateral for a loan, or borrowed, other than as provided in subparagraph (E) or paragraph (2)(C)";
}
@source(IRC_S7702B_B, relation = formalizes, coverage = partial, quote = "(D) such contract does not provide for a cash surrender value or other money that can be—")
rule NoPledgeableCashValueMeets1D strict {
    for c: LongTermCareContract;
    when contract_presented_for_qualification(c) and not_known(provides_cash_value_that_can_be_paid_assigned_pledged_or_borrowed(c));
    then meets_paragraph_1d_no_pledgeable_cash_value(c);
}
@source(IRC_S7702B_B, relation = formalizes, coverage = partial, quote = "other than as provided in subparagraph (E) or paragraph (2)(C),")
rule CashValueOnlyAsProvidedInEOr2CMeets1D strict {
    for c: LongTermCareContract;
    when provides_cash_value_that_can_be_paid_assigned_pledged_or_borrowed(c) and cash_value_only_as_provided_in_1e_or_2c(c);
    then meets_paragraph_1d_no_pledgeable_cash_value(c);
}
pub relation meets_paragraph_1e_refunds_applied_forward(c: LongTermCareContract) kind institutional {
    label en official "(E) all refunds of premiums, and all policyholder dividends or similar amounts, under such contract are to be applied as a reduction in future premiums or to increase future benefits";
}
@source(IRC_S7702B_B, relation = formalizes, coverage = exact, quote = "(E) all refunds of premiums, and all policyholder dividends or similar amounts, under such contract are to be applied as a reduction in future premiums or to increase future benefits, and")
rule RefundsAppliedForwardMeets1E strict {
    for c: LongTermCareContract;
    when all_refunds_and_dividends_applied_to_reduce_future_premiums_or_increase_future_benefits(c);
    then meets_paragraph_1e_refunds_applied_forward(c);
}
@source(IRC_S7702B_B, relation = formalizes, coverage = exact, quote = "Paragraph (1)(E) shall not apply to any refund on the death of the insured, or on a complete surrender or cancellation of the contract, which cannot exceed the aggregate premiums paid under the contract.")
rule DeathOrSurrenderRefundNotExceedingPremiumsDoesNotDefeat1E strict {
    for c: LongTermCareContract;
    when refund_on_death_or_complete_surrender_not_exceeding_aggregate_premiums(c);
    then meets_paragraph_1e_refunds_applied_forward(c);
}
pub relation takes_into_account_at_least_five_activities_of_daily_living(c: LongTermCareContract) kind institutional {
    label en official "a contract shall not be treated as a qualified long-term care insurance contract unless the determination of whether an individual is a chronically ill individual described in subparagraph (A)(i) takes into account at least 5 of such activities";
}
@source(IRC_S7702B_C, relation = formalizes, coverage = exact, quote = "A contract shall not be treated as a qualified long-term care insurance contract unless the determination of whether an individual is a chronically ill individual described in subparagraph (A)(i) takes into account at least 5 of such activities.")
rule ContractConsideringAtLeastFiveActivitiesMeetsC2B strict {
    for c: LongTermCareContract; for a: ActivityOfDailyLiving;
    when determination_of_chronic_illness_takes_into_account_activity(c, a)
        and count(collect x: ActivityOfDailyLiving where determination_of_chronic_illness_takes_into_account_activity(c, x)) >= 5;
    then takes_into_account_at_least_five_activities_of_daily_living(c);
}
pub relation qualified_long_term_care_insurance_contract(c: LongTermCareContract) kind institutional {
    label en official "the term \"qualified long-term care insurance contract\" means any insurance contract if (A) the only insurance protection is coverage of qualified long-term care services, (B) it does not pay or reimburse expenses reimbursable under title XVIII, (C) it is guaranteed renewable, (D) it has no pledgeable or borrowable cash value, (E) all refunds and dividends are applied forward, and (F) it meets the requirements of subsection (g)";
}
@source(IRC_S7702B_B, relation = formalizes, coverage = exact, quote = "The term \"qualified long-term care insurance contract\" means any insurance contract if—")
rule AllSixConjunctsMakeQualifiedLongTermCareInsuranceContract strict {
    for c: LongTermCareContract;
    when meets_paragraph_1a_only_ltc_coverage(c) and meets_paragraph_1b_no_medicare_overlap(c) and meets_paragraph_1c_guaranteed_renewable(c)
        and meets_paragraph_1d_no_pledgeable_cash_value(c) and meets_paragraph_1e_refunds_applied_forward(c)
        and meets_requirements_of_subsection_g(c) and takes_into_account_at_least_five_activities_of_daily_living(c);
    then qualified_long_term_care_insurance_contract(c);
}
// (b)(2)(C) second sentence: a complete-surrender refund is gross income to
// the extent any deduction or exclusion was allowable for the premiums.
pub relation refund_on_complete_surrender_or_cancellation(c: LongTermCareContract, amount: Money) kind empirical {
    label en official "any refund on a complete surrender or cancellation of the contract";
}
pub relation premiums_for_which_deduction_or_exclusion_was_allowable(c: LongTermCareContract, amount: Money) kind empirical {
    label en official "any deduction or exclusion was allowable with respect to the premiums";
}
pub relation surrender_refund_includible_in_gross_income(c: LongTermCareContract, amount: Money) kind institutional {
    label en official "any refund on a complete surrender or cancellation of the contract shall be includible in gross income to the extent that any deduction or exclusion was allowable with respect to the premiums";
}
@source(IRC_S7702B_B, relation = formalizes, coverage = exact, quote = "Any refund on a complete surrender or cancellation of the contract shall be includible in gross income to the extent that any deduction or exclusion was allowable with respect to the premiums.")
rule SurrenderRefundIsIncomeUpToAllowablePremiums strict {
    for c: LongTermCareContract; for r: Money; for a: Money;
    when refund_on_complete_surrender_or_cancellation(c, r) and premiums_for_which_deduction_or_exclusion_was_allowable(c, a);
    then surrender_refund_includible_in_gross_income(c, min(r, a));
}

// --- (a) Treatment of qualified long-term care insurance -------------------------------------
pub relation treated_as_accident_and_health_insurance_contract(c: LongTermCareContract) kind institutional {
    label en official "a qualified long-term care insurance contract shall be treated as an accident and health insurance contract";
}
@source(IRC_S7702B_A, relation = formalizes, coverage = partial, quote = "(1) a qualified long-term care insurance contract shall be treated as an accident and health insurance contract,")
rule QualifiedContractIsAccidentAndHealthInsurance strict {
    for c: LongTermCareContract;
    when qualified_long_term_care_insurance_contract(c);
    then treated_as_accident_and_health_insurance_contract(c);
}
pub relation amount_received_under_contract(c: LongTermCareContract, amount: Money) kind empirical {
    label en official "amounts received under a qualified long-term care insurance contract";
}
pub relation amount_is_policyholder_dividend_or_premium_refund(c: LongTermCareContract, amount: Money) kind empirical {
    label en official "policyholder dividends, as defined in section 808, or premium refunds";
}
pub relation amount_treated_as_received_for_personal_injuries_and_sickness_and_as_medical_reimbursement(c: LongTermCareContract, amount: Money) kind institutional {
    label en official "amounts (other than policyholder dividends or premium refunds) received under a qualified long-term care insurance contract shall be treated as amounts received for personal injuries and sickness and shall be treated as reimbursement for expenses actually incurred for medical care";
}
@source(IRC_S7702B_A, relation = formalizes, coverage = partial, quote = "(2) amounts (other than policyholder dividends, as defined in section 808, or premium refunds) received under a qualified long-term care insurance contract shall be treated as amounts received for personal injuries and sickness")
rule AmountsReceivedUnderQualifiedContractAreSicknessAmounts strict {
    for c: LongTermCareContract; for a: Money;
    when qualified_long_term_care_insurance_contract(c) and amount_received_under_contract(c, a)
        and not_known(amount_is_policyholder_dividend_or_premium_refund(c, a));
    then amount_treated_as_received_for_personal_injuries_and_sickness_and_as_medical_reimbursement(c, a);
}
pub entity EmployerLongTermCarePlan { label en unofficial "a plan of an employer providing coverage under a qualified long-term care insurance contract"; }
pub relation plan_provides_coverage_under_contract(plan: EmployerLongTermCarePlan, c: LongTermCareContract) kind empirical {
    label en official "any plan of an employer providing coverage under a qualified long-term care insurance contract";
}
pub relation treated_as_accident_and_health_plan_with_respect_to_coverage(plan: EmployerLongTermCarePlan) kind institutional {
    label en official "any plan of an employer providing coverage under a qualified long-term care insurance contract shall be treated as an accident and health plan with respect to such coverage";
}
@source(IRC_S7702B_A, relation = formalizes, coverage = partial, quote = "(3) any plan of an employer providing coverage under a qualified long-term care insurance contract shall be treated as an accident and health plan with respect to such coverage,")
rule EmployerPlanCoveringQualifiedContractIsAccidentAndHealthPlan strict {
    for plan: EmployerLongTermCarePlan; for c: LongTermCareContract;
    when plan_provides_coverage_under_contract(plan, c) and qualified_long_term_care_insurance_contract(c);
    then treated_as_accident_and_health_plan_with_respect_to_coverage(plan);
}
pub relation contract_provides_per_diem_benefits_described_in_b2a(c: LongTermCareContract) kind empirical {
    label en official "a qualified long-term care insurance contract providing the benefits described in subsection (b)(2)(A)";
}
pub relation amounts_paid_are_for_rider_portion_under_e3(c: LongTermCareContract) kind empirical {
    label en official "except as provided in subsection (e)(3)";
}
pub relation amounts_paid_treated_as_payments_for_insurance_under_213d1d(c: LongTermCareContract) kind institutional {
    label en official "amounts paid for a qualified long-term care insurance contract providing the benefits described in subsection (b)(2)(A) shall be treated as payments made for insurance for purposes of section 213(d)(1)(D)";
}
@source(IRC_S7702B_A, relation = formalizes, coverage = partial, quote = "(4) except as provided in subsection (e)(3), amounts paid for a qualified long-term care insurance contract providing the benefits described in subsection (b)(2)(A) shall be treated as payments made for insurance for purposes of section 213(d)(1)(D), and")
rule PremiumsForPerDiemQualifiedContractAreInsurancePayments strict {
    for c: LongTermCareContract;
    when qualified_long_term_care_insurance_contract(c) and contract_provides_per_diem_benefits_described_in_b2a(c)
        and not_known(amounts_paid_are_for_rider_portion_under_e3(c));
    then amounts_paid_treated_as_payments_for_insurance_under_213d1d(c);
}
pub relation treated_as_guaranteed_renewable_contract_under_816e(c: LongTermCareContract) kind institutional {
    label en official "a qualified long-term care insurance contract shall be treated as a guaranteed renewable contract subject to the rules of section 816(e)";
}
@source(IRC_S7702B_A, relation = formalizes, coverage = partial, quote = "(5) a qualified long-term care insurance contract shall be treated as a guaranteed renewable contract subject to the rules of section 816(e).")
rule QualifiedContractIsGuaranteedRenewableUnder816e strict {
    for c: LongTermCareContract;
    when qualified_long_term_care_insurance_contract(c);
    then treated_as_guaranteed_renewable_contract_under_816e(c);
}

// --- (d) Treatment of periodic payments: the per diem limitation ------------------------------
pub entity LongTermCarePaymentPeriod { label en unofficial "a period for which periodic payments under long-term care contracts are received for an insured"; }
pub relation days_in_payment_period(per: LongTermCarePaymentPeriod, n: Integer) kind empirical {
    label en unofficial "the number of days in the period (the per diem dollar amount applies to each day, or an equivalent amount on another periodic basis)";
}
pub relation periodic_payments_treated_as_made_for_qualified_long_term_care_services(insured: Individual, per: LongTermCarePaymentPeriod, amount: Money) kind empirical {
    label en official "the periodic payments received for any period under all qualified long-term care insurance contracts which are treated as made for qualified long-term care services for an insured (all persons receiving such payments for the same insured being treated as 1 person)";
}
pub relation periodic_payments_treated_under_101g_as_paid_by_reason_of_death(insured: Individual, per: LongTermCarePaymentPeriod, amount: Money) kind empirical {
    label en official "the periodic payments received for such period which are treated under section 101(g) as paid by reason of the death of such insured";
}
pub relation insured_terminally_ill_when_payment_received(insured: Individual, per: LongTermCarePaymentPeriod) kind empirical {
    label en official "the insured is a terminally ill individual (as defined in section 101(g)) at the time the payment is received";
}
pub relation costs_incurred_for_qualified_long_term_care_services(insured: Individual, per: LongTermCarePaymentPeriod, amount: Money) kind empirical {
    label en official "the costs incurred for qualified long-term care services provided for the insured for such period";
}
pub relation aggregate_reimbursements_for_qualified_long_term_care_services(insured: Individual, per: LongTermCarePaymentPeriod, amount: Money) kind empirical {
    label en official "the aggregate payments received as reimbursements (through insurance or otherwise) for qualified long-term care services provided for the insured during such period";
}
pub relation aggregate_periodic_payments_counted_against_limitation(insured: Individual, per: LongTermCarePaymentPeriod, amount: Money) kind institutional {
    label en official "the aggregate of (A) the periodic payments for qualified long-term care services and (B) the periodic payments treated under section 101(g) as paid by reason of death (a payment is not counted under (B) if the insured is a terminally ill individual when received)";
}
@source(IRC_S7702B_D, relation = formalizes, coverage = partial, quote = "(A) the periodic payments received for any period under all qualified long-term care insurance contracts which are treated as made for qualified long-term care services for an insured, and")
rule AggregateCountsBothPaymentStreamsWhenInsuredNotTerminallyIll strict {
    for i: Individual; for per: LongTermCarePaymentPeriod; for a: Money; for b: Money;
    when periodic_payments_treated_as_made_for_qualified_long_term_care_services(i, per, a)
        and periodic_payments_treated_under_101g_as_paid_by_reason_of_death(i, per, b)
        and not_known(insured_terminally_ill_when_payment_received(i, per));
    then aggregate_periodic_payments_counted_against_limitation(i, per, a + b);
}
@source(IRC_S7702B_D, relation = formalizes, coverage = partial, quote = "A payment shall not be taken into account under subparagraph (B) if the insured is a terminally ill individual (as defined in section 101(g)) at the time the payment is received.")
rule DeathBenefitStreamIsDisregardedForTerminallyIllInsured strict {
    for i: Individual; for per: LongTermCarePaymentPeriod; for a: Money; for b: Money;
    when periodic_payments_treated_as_made_for_qualified_long_term_care_services(i, per, a)
        and periodic_payments_treated_under_101g_as_paid_by_reason_of_death(i, per, b)
        and insured_terminally_ill_when_payment_received(i, per);
    then aggregate_periodic_payments_counted_against_limitation(i, per, a);
}
pub relation per_diem_limitation_for_period(insured: Individual, per: LongTermCarePaymentPeriod, amount: Money) kind institutional {
    label en official "the per diem limitation for any period is an amount equal to the excess (if any) of (A) the greater of (i) the dollar amount in effect for such period under paragraph (4), or (ii) the costs incurred for qualified long-term care services provided for the insured for such period, over (B) the aggregate payments received as reimbursements for such services during such period";
}
pub relation reimbursements_under_contract_issued_on_or_before_july_31_1996(insured: Individual, per: LongTermCarePaymentPeriod, amount: Money) kind empirical {
    label en official "the part of the aggregate reimbursements that is received under a contract issued on or before July 31, 1996 (Pub. L. 104-191 sec. 321(f)(5) note)";
}
pub relation pre_august_1996_contract_exchanged_or_modified_to_increase_amounts(insured: Individual, per: LongTermCarePaymentPeriod) kind empirical {
    label en official "after July 31, 1996 the contract is exchanged or there is a contract modification which results in an increase in the amount of the per diem payments or of the reimbursements";
}
pub relation pre_1996_reimbursement_protected(insured: Individual, per: LongTermCarePaymentPeriod) kind institutional {
    label en unofficial "helper: reimbursements under a contract issued on or before July 31, 1996 do not reduce the per diem limitation (not ceased by exchange or modification)";
}
@source(IRC_S7702B_NOTE_7, relation = formalizes, coverage = partial, quote = "shall not be reduced under subsection (d)(2)(B) thereof by reason of reimbursements received under a contract issued on or before such date")
rule PreAugust1996ReimbursementsDoNotReduceTheLimitation strict {
    for i: Individual; for per: LongTermCarePaymentPeriod; for rp: Money;
    when reimbursements_under_contract_issued_on_or_before_july_31_1996(i, per, rp) and not_known(pre_august_1996_contract_exchanged_or_modified_to_increase_amounts(i, per));
    then pre_1996_reimbursement_protected(i, per);
}
pub relation reimbursements_subtracted_for_per_diem_limitation(insured: Individual, per: LongTermCarePaymentPeriod, amount: Money) kind institutional {
    label en official "the reimbursements subtracted in (d)(2)(B): all of them, except those under a contract issued on or before July 31, 1996 while the note (5) protection lasts";
}
rule AllReimbursementsAreSubtracted strict {
    for i: Individual; for per: LongTermCarePaymentPeriod; for reimb: Money;
    when aggregate_reimbursements_for_qualified_long_term_care_services(i, per, reimb) and not_known(pre_1996_reimbursement_protected(i, per));
    then reimbursements_subtracted_for_per_diem_limitation(i, per, reimb);
}
rule ProtectedPre1996ReimbursementsAreNotSubtracted strict {
    for i: Individual; for per: LongTermCarePaymentPeriod; for reimb: Money; for rp: Money;
    when aggregate_reimbursements_for_qualified_long_term_care_services(i, per, reimb) and reimbursements_under_contract_issued_on_or_before_july_31_1996(i, per, rp) and pre_1996_reimbursement_protected(i, per);
    then reimbursements_subtracted_for_per_diem_limitation(i, per, max(0.00 USD, reimb - rp));
}
@source(IRC_S7702B_D, relation = formalizes, coverage = exact, quote = "For purposes of paragraph (1), the per diem limitation for any period is an amount equal to the excess (if any) of—")
rule PerDiemLimitationIsGreaterOfDollarAmountAndCostsLessReimbursements strict {
    for i: Individual; for per: LongTermCarePaymentPeriod; for n: Integer; for costs: Money; for reimb: Money;
    when days_in_payment_period(per, n) and costs_incurred_for_qualified_long_term_care_services(i, per, costs)
        and reimbursements_subtracted_for_per_diem_limitation(i, per, reimb);
    then per_diem_limitation_for_period(i, per, max(0.00 USD, max(round(n * LongTermCarePerDiemDollarAmount, 2, "HALF_UP"), costs) - reimb));
}
pub relation excess_periodic_payments_includible_in_gross_income(insured: Individual, per: LongTermCarePaymentPeriod, amount: Money) kind institutional {
    label en official "if the aggregate of the periodic payments exceeds the per diem limitation for such period, such excess shall be includible in gross income without regard to section 72";
}
@source(IRC_S7702B_D, relation = formalizes, coverage = partial, quote = "exceeds the per diem limitation for such period, such excess shall be includible in gross income without regard to section 72.")
rule ExcessOverPerDiemLimitationIsGrossIncome strict {
    for i: Individual; for per: LongTermCarePaymentPeriod; for agg: Money; for lim: Money;
    when aggregate_periodic_payments_counted_against_limitation(i, per, agg) and per_diem_limitation_for_period(i, per, lim) and agg > lim;
    then excess_periodic_payments_includible_in_gross_income(i, per, agg - lim);
}

// --- (e) Coverage provided by rider or as part of life insurance or annuity contract -----------
pub entity RiderCoverage { label en unofficial "long-term care insurance coverage (whether or not qualified) provided by a rider on or as part of a life insurance contract or an annuity contract"; }
pub relation coverage_provided_by_rider_or_as_part_of_contract(r: RiderCoverage) kind empirical {
    label en official "any long-term care insurance coverage (whether or not qualified) provided by a rider on or as part of a life insurance contract or an annuity contract";
}
pub relation regulations_provide_otherwise_for_rider_coverage(r: RiderCoverage) kind empirical {
    label en official "except as otherwise provided in regulations prescribed by the Secretary";
}
pub relation treated_as_separate_contract_for_this_title(r: RiderCoverage) kind institutional {
    label en official "this title shall apply as if the portion of the contract providing such coverage is a separate contract";
}
@source(IRC_S7702B_E, relation = formalizes, coverage = exact, quote = "This title shall apply as if the portion of the contract providing such coverage is a separate contract.")
rule RiderCoveragePortionIsSeparateContract strict {
    for r: RiderCoverage;
    when coverage_provided_by_rider_or_as_part_of_contract(r) and not_known(regulations_provide_otherwise_for_rider_coverage(r));
    then treated_as_separate_contract_for_this_title(r);
}
pub relation payment_charged_against_cash_surrender_value_or_cash_value(pay: us.irc.core::Payment, r: RiderCoverage) kind empirical {
    label en official "such payment is made as a charge against the cash surrender value of a life insurance contract or the cash value of an annuity contract";
}
pub relation payment_is_for_coverage_under_qualified_long_term_care_insurance_contract(pay: us.irc.core::Payment, r: RiderCoverage) kind empirical {
    label en official "any payment made for coverage under a qualified long-term care insurance contract";
}
pub relation no_213a_deduction_for_rider_payment(pay: us.irc.core::Payment) kind institutional {
    label en official "no deduction shall be allowed under section 213(a) for any payment made for coverage under a qualified long-term care insurance contract if such payment is made as a charge against the cash surrender value of a life insurance contract or the cash value of an annuity contract";
}
@source(IRC_S7702B_E, relation = formalizes, coverage = exact, quote = "No deduction shall be allowed under section 213(a) for any payment made for coverage under a qualified long-term care insurance contract if such payment is made as a charge against the cash surrender value of a life insurance contract or the cash value of an annuity contract.")
rule ChargeAgainstCashValueGivesNo213aDeduction strict {
    for pay: us.irc.core::Payment; for r: RiderCoverage;
    when payment_is_for_coverage_under_qualified_long_term_care_insurance_contract(pay, r) and payment_charged_against_cash_surrender_value_or_cash_value(pay, r);
    then no_213a_deduction_for_rider_payment(pay);
}
pub entity AnnuityCandidate { label en unofficial "an arrangement tested against the (e)(4) list of things not treated as annuity contracts"; }
pub relation is_401a_trust_exempt_under_501a(x: AnnuityCandidate) kind empirical {
    label en official "a trust described in section 401(a) which is exempt from tax under section 501(a)";
}
pub relation contract_purchased_by_401a_trust_or_under_403a_plan_or_is_403b_or_818a3_or_ira(x: AnnuityCandidate) kind empirical {
    label en official "a contract (i) purchased by a trust described in subparagraph (A), (ii) purchased as part of a plan described in section 403(a), (iii) described in section 403(b), (iv) provided for employees of a life insurance company under a plan described in section 818(a)(3), or (v) from an individual retirement account or an individual retirement annuity";
}
pub relation contract_purchased_by_employer_for_benefit_of_employee_or_spouse(x: AnnuityCandidate) kind empirical {
    label en official "a contract purchased by an employer for the benefit of the employee (or the employee's spouse)";
}
pub relation dividend_described_in_404k_received_by_participant_or_beneficiary(x: AnnuityCandidate) kind empirical {
    label en official "any dividend described in section 404(k) which is received by a participant or beneficiary";
}
pub relation not_treated_as_annuity_contract_for_subsection_e(x: AnnuityCandidate) kind institutional {
    label en official "for purposes of this subsection, none of the following shall be treated as an annuity contract: a section 401(a) trust exempt under 501(a); a contract purchased by such a trust, under a section 403(a) plan, described in section 403(b), provided under a section 818(a)(3) plan, or from an IRA; a contract purchased by an employer for the benefit of the employee (or spouse)";
}
@source(IRC_S7702B_E, relation = formalizes, coverage = partial, quote = "(A) A trust described in section 401(a) which is exempt from tax under section 501(a).")
rule ExemptTrustIsNotAnnuityContractForSubsectionE strict {
    for x: AnnuityCandidate;
    when is_401a_trust_exempt_under_501a(x);
    then not_treated_as_annuity_contract_for_subsection_e(x);
}
@source(IRC_S7702B_E, relation = formalizes, coverage = partial, quote = "(B) A contract—")
rule ListedQualifiedPlanContractIsNotAnnuityContractForSubsectionE strict {
    for x: AnnuityCandidate;
    when contract_purchased_by_401a_trust_or_under_403a_plan_or_is_403b_or_818a3_or_ira(x);
    then not_treated_as_annuity_contract_for_subsection_e(x);
}
@source(IRC_S7702B_E, relation = formalizes, coverage = partial, quote = "(C) A contract purchased by an employer for the benefit of the employee (or the employee's spouse).")
rule EmployerPurchasedContractIsNotAnnuityContractForSubsectionE strict {
    for x: AnnuityCandidate;
    when contract_purchased_by_employer_for_benefit_of_employee_or_spouse(x);
    then not_treated_as_annuity_contract_for_subsection_e(x);
}
@source(IRC_S7702B_E, relation = formalizes, coverage = partial, quote = "Any dividend described in section 404(k) which is received by a participant or beneficiary shall, for purposes of this paragraph, be treated as paid under a separate contract to which subparagraph (B)(i) applies.")
rule Section404kDividendIsPaidUnderSeparateContractOfBi strict {
    for x: AnnuityCandidate;
    when dividend_described_in_404k_received_by_participant_or_beneficiary(x);
    then not_treated_as_annuity_contract_for_subsection_e(x);
}

// --- (f) State long-term care plans ---------------------------------------------------------------
pub entity StateLongTermCarePlan { label en unofficial "a plan providing coverage for qualified long-term care services"; }
pub relation plan_established_and_maintained_by_state_or_instrumentality(pl: StateLongTermCarePlan) kind empirical {
    label en official "established and maintained by a State or an instrumentality of a State";
}
pub relation plan_provides_coverage_only_for_qualified_long_term_care_services(pl: StateLongTermCarePlan) kind empirical {
    label en official "which provides coverage only for qualified long-term care services";
}
pub relation coverage_provided_only_to_state_employees_former_employees_spouses_and_152d2_relatives(pl: StateLongTermCarePlan) kind empirical {
    label en official "under which such coverage is provided only to employees and former employees of a State (or any political subdivision or instrumentality of a State), the spouses of such employees, and individuals bearing a relationship to such employees or spouses which is described in any of subparagraphs (A) through (G) of section 152(d)(2)";
}
pub relation state_long_term_care_plan(pl: StateLongTermCarePlan) kind institutional {
    label en official "the term \"State long-term care plan\" means any plan which is established and maintained by a State or an instrumentality of a State, provides coverage only for qualified long-term care services, and under which coverage is provided only to the listed individuals";
}
@source(IRC_S7702B_F, relation = formalizes, coverage = exact, quote = "For purposes of paragraph (1), the term \"State long-term care plan\" means any plan—")
rule PlanMeetingThreeLimbsIsStateLongTermCarePlan strict {
    for pl: StateLongTermCarePlan;
    when plan_established_and_maintained_by_state_or_instrumentality(pl)
        and plan_provides_coverage_only_for_qualified_long_term_care_services(pl)
        and coverage_provided_only_to_state_employees_former_employees_spouses_and_152d2_relatives(pl);
    then state_long_term_care_plan(pl);
}
pub relation individual_receives_coverage_under_state_plan(p: Individual, pl: StateLongTermCarePlan) kind empirical {
    label en official "an individual receives coverage for qualified long-term care services under a State long-term care plan";
}
pub relation plan_terms_would_satisfy_subsection_b_were_it_an_insurance_contract(pl: StateLongTermCarePlan) kind empirical {
    label en official "the terms of such plan would satisfy the requirements of subsection (b) were such plan an insurance contract";
}
pub relation state_plan_treated_as_qualified_long_term_care_insurance_contract(pl: StateLongTermCarePlan) kind institutional {
    label en official "such plan shall be treated as a qualified long-term care insurance contract for purposes of this title";
}
@source(IRC_S7702B_F, relation = formalizes, coverage = exact, quote = "such plan shall be treated as a qualified long-term care insurance contract for purposes of this title.")
rule StatePlanSatisfyingSubsectionBIsTreatedAsQualifiedContract strict {
    for p: Individual; for pl: StateLongTermCarePlan;
    when individual_receives_coverage_under_state_plan(p, pl) and state_long_term_care_plan(pl)
        and plan_terms_would_satisfy_subsection_b_were_it_an_insurance_contract(pl);
    then state_plan_treated_as_qualified_long_term_care_insurance_contract(pl);
}

// --- Effective-date note (Pub. L. 104-191 §321(f)) -------------------------------------------------
pub relation contract_issued_on(c: LongTermCareContract, d: Date) kind empirical {
    label en official "contracts issued on the date";
}
pub relation section_7702b_amendments_apply_to_contract(c: LongTermCareContract) kind institutional {
    label en official "the amendments made by this section shall apply to contracts issued after December 31, 1996";
}
@source(IRC_S7702B_NOTE_7, relation = formalizes, coverage = partial, quote = "the amendments made by this section [enacting this section and amending sections 106, 125, 807, and 4980B of this title, section 1167 of Title 29, Labor, and section 300bb–8 of Title 42, The Public Health and Welfare] shall apply to contracts issued after December 31, 1996.")
rule SectionAppliesToContractsIssuedAfterDecember311996 strict {
    for c: LongTermCareContract; for d: Date;
    when contract_issued_on(c, d) and d > @1996-12-31;
    then section_7702b_amendments_apply_to_contract(c);
}
pub relation contract_met_long_term_care_requirements_of_state_at_issue(c: LongTermCareContract) kind empirical {
    label en official "which met the long-term care insurance requirements of the State in which the contract was sitused at the time the contract was issued";
}
pub relation continued_pre_1997_contract_treated_as_qualified_long_term_care_insurance_contract(c: LongTermCareContract) kind institutional {
    label en official "such contract shall be treated for purposes of the Internal Revenue Code of 1986 as a qualified long-term care insurance contract";
}
@source(IRC_S7702B_NOTE_7, relation = formalizes, coverage = partial, quote = "\"(2) Continuation of existing policies.—In the case of any contract issued before January 1, 1997, which met the long-term care insurance requirements of the State in which the contract was sitused [sic] at the time the contract was issued—")
rule PreJanuary11997ContractMeetingStateRequirementsIsTreatedAsQualifiedContract strict {
    for c: LongTermCareContract; for d: Date;
    when contract_issued_on(c, d) and d < @1997-01-01 and contract_met_long_term_care_requirements_of_state_at_issue(c);
    then continued_pre_1997_contract_treated_as_qualified_long_term_care_insurance_contract(c);
}
pub relation services_under_continued_contract_treated_as_qualified_long_term_care_services(c: LongTermCareContract) kind institutional {
    label en official "services provided under, or reimbursed by, such contract shall be treated for such purposes as qualified long-term care services";
}
@source(IRC_S7702B_NOTE_7, relation = formalizes, coverage = partial, quote = "\"(B) services provided under, or reimbursed by, such contract shall be treated for such purposes as qualified long-term care services (as defined in section 7702B(c) of such Code).")
rule ServicesUnderContinuedContractAreQualifiedServices strict {
    for c: LongTermCareContract;
    when continued_pre_1997_contract_treated_as_qualified_long_term_care_insurance_contract(c);
    then services_under_continued_contract_treated_as_qualified_long_term_care_services(c);
}
pub relation covered_on_december_31_1996_under_state_plan(p: Individual, pl: StateLongTermCarePlan) kind empirical {
    label en official "an individual who is covered on December 31, 1996, under a State long-term care plan";
}
pub relation plan_terms_on_december_31_1996_met_state_long_term_care_insurance_requirements(pl: StateLongTermCarePlan) kind empirical {
    label en official "the terms of such plan on such date ... a contract issued on such date which met the long-term care insurance requirements of such State";
}
pub relation state_plan_terms_treated_as_contract_issued_december_31_1996_meeting_state_requirements(pl: StateLongTermCarePlan) kind institutional {
    label en official "the terms of such plan on such date shall be treated for purposes of the preceding sentence as a contract issued on such date which met the long-term care insurance requirements of such State";
}
@source(IRC_S7702B_NOTE_7, relation = formalizes, coverage = partial, quote = "In the case of an individual who is covered on December 31, 1996, under a State long-term care plan (as defined in section 7702B(f)(2) of such Code), the terms of such plan on such date shall be treated for purposes of the preceding sentence as a contract issued on such date which met the long-term care insurance requirements of such State.")
rule StatePlanCoveredOnDecember311996IsTreatedAsContractMeetingStateRequirements strict {
    for p: Individual; for pl: StateLongTermCarePlan;
    when covered_on_december_31_1996_under_state_plan(p, pl) and state_long_term_care_plan(pl)
        and plan_terms_on_december_31_1996_met_state_long_term_care_insurance_requirements(pl);
    then state_plan_terms_treated_as_contract_issued_december_31_1996_meeting_state_requirements(pl);
}
pub relation rider_issuance_or_conforming_provision_added(c: LongTermCareContract) kind empirical {
    label en official "the issuance of a rider which is treated as a qualified long-term care insurance contract under section 7702B, or the addition of any provision required to conform any other long-term care rider to be so treated";
}
pub relation not_treated_as_modification_or_material_change_for_101f_7702_7702a(c: LongTermCareContract) kind institutional {
    label en official "shall not be treated as a modification or material change of such contract";
}
@source(IRC_S7702B_NOTE_7, relation = formalizes, coverage = partial, quote = "\"(4) Issuance of certain riders permitted.—For purposes of applying sections 101(f), 7702, and 7702A of the Internal Revenue Code of 1986 to any contract—")
rule LongTermCareRiderIssuanceIsNotMaterialChange strict {
    for c: LongTermCareContract;
    when rider_issuance_or_conforming_provision_added(c);
    then not_treated_as_modification_or_material_change_for_101f_7702_7702a(c);
}
// (3) exchanges of existing policies between the enactment and 1 January 1998.
pub entity LongTermCareExchange { label en unofficial "an exchange of a contract providing long-term care insurance coverage for a qualified long-term care insurance contract"; }
pub relation exchange_made_on(x: LongTermCareExchange, d: Date) kind empirical {
    label en official "after the date of enactment of this Act [Aug. 21, 1996] and before January 1, 1998, a contract providing for long-term care insurance coverage is exchanged";
}
pub relation exchanged_solely_for_qualified_long_term_care_insurance_contract(x: LongTermCareExchange) kind empirical {
    label en official "exchanged solely for a qualified long-term care insurance contract";
}
pub relation money_and_fair_market_value_of_other_property_received_in_exchange(x: LongTermCareExchange, amount: Money) kind empirical {
    label en official "money or other property is received in the exchange (the sum of the money and the fair market value of the other property received)";
}
pub relation realized_gain_on_exchange(x: LongTermCareExchange, amount: Money) kind empirical {
    label en unofficial "the gain realized on the exchange, before recognition";
}
pub relation gain_recognized_on_exchange(x: LongTermCareExchange, amount: Money) kind institutional {
    label en official "no gain or loss shall be recognized on the exchange; if money or other property is received, any gain shall be recognized to the extent of the sum of the money and the fair market value of the other property received";
}
@source(IRC_S7702B_NOTE_7, relation = formalizes, coverage = partial, quote = "no gain or loss shall be recognized on the exchange.")
rule SolelyExchangeRecognizesNoGain strict {
    for x: LongTermCareExchange; for d: Date;
    when exchange_made_on(x, d) and d > @1996-08-21 and d < @1998-01-01 and exchanged_solely_for_qualified_long_term_care_insurance_contract(x);
    then gain_recognized_on_exchange(x, 0.00 USD);
}
@source(IRC_S7702B_NOTE_7, relation = formalizes, coverage = partial, quote = "then any gain shall be recognized to the extent of the sum of the money and the fair market value of the other property received.")
rule ExchangeWithBootRecognizesGainUpToBoot strict {
    for x: LongTermCareExchange; for d: Date; for boot: Money; for g: Money;
    when exchange_made_on(x, d) and d > @1996-08-21 and d < @1998-01-01
        and money_and_fair_market_value_of_other_property_received_in_exchange(x, boot) and realized_gain_on_exchange(x, g);
    then gain_recognized_on_exchange(x, max(0.00 USD, min(g, boot)));
}
