// §7701(a)(52) (added by Public Law 119-21 sec. 70512(c), fragment
// `us.irc.temporal::PL119_21_S70512`): "material assistance from a prohibited
// foreign entity". A qualified facility or energy storage technology (A)(i),
// or a facility producing eligible components (A)(ii), has material assistance
// when its material assistance cost ratio is LESS than the threshold
// percentage of (B) (by year construction begins) or (C) (by product and year
// sold). The ratio is (total direct costs - costs attributable to a
// prohibited foreign entity) / total direct costs, compared as integers
// `(total - pfe) * 100 < total * threshold` (no rounding invented; the text
// names none). Thresholds are literal statutory numbers keyed on a DATE OF
// THE EVENT (construction begins / sale), so they are rules with date guards,
// not A3 datasets (an A3 dataset is selected by the legal time of reading, not
// by an event date). (C)(i)(II): the statute names thresholds for wind
// components only for 2026 and 2027; no value for later years is stated
// (TECH-GAPS G3506, MISSING threshold, not zero).
//
// The "beginning of construction" date and the classification of a product as
// solar/wind/inverter/battery/critical mineral are asserted facts (credits
// owner, sections 45X/45Y/48E).

language "law.core" version "0.2";
package us.irc.definitions version "0.1.1";
namespace "urn:us:irc:definitions:clir";

use self::{
    Organ,
    Person,
    Secretary,
    net_pfe_costs_of_facility,
    net_pfe_material_costs_of_component,
    net_total_direct_costs_of_facility,
    net_total_direct_material_costs_of_component,
    secretary_issued_threshold_applies_to_component,
};

pub entity CleanEnergyFacility { label en unofficial "a qualified facility or energy storage technology of the taxpayer (subparagraph (A)(i))"; }
pub entity EligibleComponentProduction { label en unofficial "a facility which produces an eligible component, or the eligible component produced (subparagraph (A)(ii))"; }

pub relation is_qualified_facility_under_45y_b1_or_48e_b3(f: CleanEnergyFacility) kind empirical {
    label en official "a qualified facility, as defined in section 45Y(b)(1) or section 48E(b)(3)";
}
pub relation is_energy_storage_technology_under_48e_c2(f: CleanEnergyFacility) kind empirical {
    label en official "energy storage technology (as defined in section 48E(c)(2))";
}
pub relation construction_begins_on(f: CleanEnergyFacility, d: Date) kind empirical {
    label en official "the construction of which begins";
}
pub relation total_direct_costs_of_manufactured_products_incorporated(f: CleanEnergyFacility, amount: Money) kind empirical {
    label en official "the total direct costs to the taxpayer attributable to all manufactured products (including components) which are incorporated into the qualified facility or energy storage technology upon completion of construction";
}
pub relation direct_costs_of_manufactured_products_made_by_prohibited_foreign_entity(f: CleanEnergyFacility, amount: Money) kind empirical {
    label en official "the total direct costs to the taxpayer attributable to all manufactured products which are incorporated into the facility and mined, produced, or manufactured by a prohibited foreign entity";
}
pub relation taxpayer_knows_or_has_reason_to_know_product_made_by_prohibited_foreign_entity_facility(f: CleanEnergyFacility) kind empirical {
    label en official "the taxpayer knows (or has reason to know) that a manufactured product was produced or manufactured by a prohibited foreign entity";
}
pub relation pfe_attributed_direct_costs_facility(f: CleanEnergyFacility, amount: Money) kind institutional {
    label en official "the direct costs attributable to a prohibited foreign entity (all direct costs of a product the taxpayer knows or has reason to know was produced by a prohibited foreign entity)";
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "if the taxpayer knows (or has reason to know) that a manufactured product or eligible component was produced or manufactured by a prohibited foreign entity, the taxpayer shall treat all direct costs with respect to such manufactured product, or all direct material costs with respect to such eligible component, as attributable to a prohibited foreign entity")
rule KnownPfeProductMakesAllFacilityDirectCostsAttributable strict {
    effective [@2025-07-04, infinity);
    for f: CleanEnergyFacility; for t: Money;
    when taxpayer_knows_or_has_reason_to_know_product_made_by_prohibited_foreign_entity_facility(f) and total_direct_costs_of_manufactured_products_incorporated(f, t);
    then pfe_attributed_direct_costs_facility(f, t);
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(bb) the total direct costs to the taxpayer attributable to all manufactured products (including components) which are—")
rule AssertedPfeDirectCostsAreAttributedAbsentKnowledge strict {
    effective [@2025-07-04, infinity);
    for f: CleanEnergyFacility; for c: Money;
    when direct_costs_of_manufactured_products_made_by_prohibited_foreign_entity(f, c)
        and not_known(taxpayer_knows_or_has_reason_to_know_product_made_by_prohibited_foreign_entity_facility(f));
    then pfe_attributed_direct_costs_facility(f, c);
}
pub relation material_assistance_threshold_percentage_facility(f: CleanEnergyFacility, pct: Integer) kind institutional {
    label en official "the threshold percentage under subparagraph (B) for a qualified facility or energy storage technology, by the calendar year in which construction begins";
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(I) during calendar year 2026, 40 percent,")
rule QualifiedFacilityThreshold2026 strict {
    effective [@2025-07-04, infinity);
    for f: CleanEnergyFacility; for d: Date;
    when is_qualified_facility_under_45y_b1_or_48e_b3(f) and construction_begins_on(f, d) and d >= @2026-01-01 and d <= @2026-12-31;
    then material_assistance_threshold_percentage_facility(f, 40);
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(II) during calendar year 2027, 45 percent,")
rule QualifiedFacilityThreshold2027 strict {
    effective [@2025-07-04, infinity);
    for f: CleanEnergyFacility; for d: Date;
    when is_qualified_facility_under_45y_b1_or_48e_b3(f) and construction_begins_on(f, d) and d >= @2027-01-01 and d <= @2027-12-31;
    then material_assistance_threshold_percentage_facility(f, 45);
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(III) during calendar year 2028, 50 percent,")
rule QualifiedFacilityThreshold2028 strict {
    effective [@2025-07-04, infinity);
    for f: CleanEnergyFacility; for d: Date;
    when is_qualified_facility_under_45y_b1_or_48e_b3(f) and construction_begins_on(f, d) and d >= @2028-01-01 and d <= @2028-12-31;
    then material_assistance_threshold_percentage_facility(f, 50);
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(IV) during calendar year 2029, 55 percent, and")
rule QualifiedFacilityThreshold2029 strict {
    effective [@2025-07-04, infinity);
    for f: CleanEnergyFacility; for d: Date;
    when is_qualified_facility_under_45y_b1_or_48e_b3(f) and construction_begins_on(f, d) and d >= @2029-01-01 and d <= @2029-12-31;
    then material_assistance_threshold_percentage_facility(f, 55);
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(V) after December 31, 2029, 60 percent, and")
rule QualifiedFacilityThresholdAfter2029 strict {
    effective [@2025-07-04, infinity);
    for f: CleanEnergyFacility; for d: Date;
    when is_qualified_facility_under_45y_b1_or_48e_b3(f) and construction_begins_on(f, d) and d > @2029-12-31;
    then material_assistance_threshold_percentage_facility(f, 60);
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(I) during calendar year 2026, 55 percent,")
rule EnergyStorageThreshold2026 strict {
    effective [@2025-07-04, infinity);
    for f: CleanEnergyFacility; for d: Date;
    when is_energy_storage_technology_under_48e_c2(f) and construction_begins_on(f, d) and d >= @2026-01-01 and d <= @2026-12-31;
    then material_assistance_threshold_percentage_facility(f, 55);
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(II) during calendar year 2027, 60 percent,")
rule EnergyStorageThreshold2027 strict {
    effective [@2025-07-04, infinity);
    for f: CleanEnergyFacility; for d: Date;
    when is_energy_storage_technology_under_48e_c2(f) and construction_begins_on(f, d) and d >= @2027-01-01 and d <= @2027-12-31;
    then material_assistance_threshold_percentage_facility(f, 60);
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(III) during calendar year 2028, 65 percent,")
rule EnergyStorageThreshold2028 strict {
    effective [@2025-07-04, infinity);
    for f: CleanEnergyFacility; for d: Date;
    when is_energy_storage_technology_under_48e_c2(f) and construction_begins_on(f, d) and d >= @2028-01-01 and d <= @2028-12-31;
    then material_assistance_threshold_percentage_facility(f, 65);
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(IV) during calendar year 2029, 70 percent, and")
rule EnergyStorageThreshold2029 strict {
    effective [@2025-07-04, infinity);
    for f: CleanEnergyFacility; for d: Date;
    when is_energy_storage_technology_under_48e_c2(f) and construction_begins_on(f, d) and d >= @2029-01-01 and d <= @2029-12-31;
    then material_assistance_threshold_percentage_facility(f, 70);
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(V) after December 31, 2029, 75 percent.")
rule EnergyStorageThresholdAfter2029 strict {
    effective [@2025-07-04, infinity);
    for f: CleanEnergyFacility; for d: Date;
    when is_energy_storage_technology_under_48e_c2(f) and construction_begins_on(f, d) and d > @2029-12-31;
    then material_assistance_threshold_percentage_facility(f, 75);
}
pub relation material_assistance_from_prohibited_foreign_entity_facility(f: CleanEnergyFacility) kind institutional {
    label en official "material assistance from a prohibited foreign entity: with respect to any qualified facility or energy storage technology, a material assistance cost ratio which is less than the threshold percentage applicable under subparagraph (B)";
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(i) with respect to any qualified facility or energy storage technology, a material assistance cost ratio which is less than the threshold percentage applicable under subparagraph (B), or")
rule FacilityRatioBelowThresholdIsMaterialAssistance defeasible {
    effective [@2025-07-04, infinity);
    for f: CleanEnergyFacility; for t: Money; for c: Money; for th: Integer;
    when net_total_direct_costs_of_facility(f, t) and net_pfe_costs_of_facility(f, c)
        and material_assistance_threshold_percentage_facility(f, th) and (t - c) * 100 < t * th;
    then material_assistance_from_prohibited_foreign_entity_facility(f);
}

// --- (A)(ii), (C), (D)(ii): eligible components ---------------------------------------
pub relation is_solar_energy_component_under_45x_c3a(c: EligibleComponentProduction) kind empirical {
    label en official "any solar energy component (as such term is defined in section 45X(c)(3)(A))";
}
pub relation is_wind_energy_component_under_45x_c4a(c: EligibleComponentProduction) kind empirical {
    label en official "any wind energy component (as such term is defined in section 45X(c)(4)(A))";
}
pub relation is_inverter_described_in_45x_c2_b_through_g(c: EligibleComponentProduction) kind empirical {
    label en official "any inverter described in subparagraphs (B) through (G) of section 45X(c)(2)";
}
pub relation is_qualifying_battery_component_under_45x_c5a(c: EligibleComponentProduction) kind empirical {
    label en official "any qualifying battery component (as such term is defined in section 45X(c)(5)(A))";
}
pub relation is_applicable_critical_mineral_under_45x_c6(c: EligibleComponentProduction) kind empirical {
    label en official "any applicable critical mineral (as such term is defined in section 45X(c)(6))";
}
pub relation component_sold_on(c: EligibleComponentProduction, d: Date) kind empirical {
    label en official "which is sold";
}
pub relation total_direct_material_costs_of_eligible_component(c: EligibleComponentProduction, amount: Money) kind empirical {
    label en official "the total direct material costs that are paid or incurred (within the meaning of section 461 and any regulations issued under section 263A) by the taxpayer for production of such eligible component";
}
pub relation direct_material_costs_of_eligible_component_from_prohibited_foreign_entity(c: EligibleComponentProduction, amount: Money) kind empirical {
    label en official "the total direct material costs paid or incurred by the taxpayer for production of such eligible component that are mined, produced, or manufactured by a prohibited foreign entity";
}
pub relation taxpayer_knows_or_has_reason_to_know_component_made_by_prohibited_foreign_entity(c: EligibleComponentProduction) kind empirical {
    label en official "the taxpayer knows (or has reason to know) that an eligible component was produced or manufactured by a prohibited foreign entity";
}
pub relation pfe_attributed_direct_material_costs_component(c: EligibleComponentProduction, amount: Money) kind institutional {
    label en official "the direct material costs attributable to a prohibited foreign entity (all direct material costs of a component the taxpayer knows or has reason to know was produced by a prohibited foreign entity)";
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "if the taxpayer knows (or has reason to know) that a manufactured product or eligible component was produced or manufactured by a prohibited foreign entity, the taxpayer shall treat all direct costs with respect to such manufactured product, or all direct material costs with respect to such eligible component, as attributable to a prohibited foreign entity")
rule KnownPfeComponentMakesAllDirectMaterialCostsAttributable strict {
    effective [@2025-07-04, infinity);
    for c: EligibleComponentProduction; for t: Money;
    when taxpayer_knows_or_has_reason_to_know_component_made_by_prohibited_foreign_entity(c) and total_direct_material_costs_of_eligible_component(c, t);
    then pfe_attributed_direct_material_costs_component(c, t);
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(bb) with respect to an eligible component, the total direct material costs that are paid or incurred (within the meaning of section 461 and any regulations issued under section 263A) by the taxpayer for production of such eligible component that are mined, produced, or manufactured by a prohibited foreign entity, divided by")
rule AssertedPfeMaterialCostsAreAttributedAbsentKnowledge strict {
    effective [@2025-07-04, infinity);
    for c: EligibleComponentProduction; for m: Money;
    when direct_material_costs_of_eligible_component_from_prohibited_foreign_entity(c, m)
        and not_known(taxpayer_knows_or_has_reason_to_know_component_made_by_prohibited_foreign_entity(c));
    then pfe_attributed_direct_material_costs_component(c, m);
}
pub relation material_assistance_threshold_percentage_component(c: EligibleComponentProduction, pct: Integer) kind institutional {
    label en official "the threshold percentage under subparagraph (C)(i) for an eligible component, by product and the calendar year in which it is sold";
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(aa) during calendar year 2026, 50 percent,")
rule SolarThreshold2026 strict {
    effective [@2025-07-04, infinity);
    for c: EligibleComponentProduction; for d: Date;
    when is_solar_energy_component_under_45x_c3a(c) and component_sold_on(c, d) and d >= @2026-01-01 and d <= @2026-12-31;
    then material_assistance_threshold_percentage_component(c, 50);
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(bb) during calendar year 2027, 60 percent,")
rule SolarThreshold2027 strict {
    effective [@2025-07-04, infinity);
    for c: EligibleComponentProduction; for d: Date;
