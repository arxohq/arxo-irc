}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(cc) during calendar year 2028, 70 percent,")
rule SolarThreshold2028 strict {
    effective [@2025-07-04, infinity);
    for c: EligibleComponentProduction; for d: Date;
    when is_solar_energy_component_under_45x_c3a(c) and component_sold_on(c, d) and d >= @2028-01-01 and d <= @2028-12-31;
