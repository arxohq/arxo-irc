}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(aa) after December 31, 2025, and before January 1, 2030, 0 percent,")
rule CriticalMineralThreshold2026To2029 defeasible {
    effective [@2025-07-04, infinity);
    for c: EligibleComponentProduction; for d: Date;
    when is_applicable_critical_mineral_under_45x_c6(c) and component_sold_on(c, d) and d > @2025-12-31 and d < @2030-01-01;
    unless secretary_issued_threshold_applies_to_component(c);
    then material_assistance_threshold_percentage_component(c, 0);
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(bb) during calendar year 2030, 25 percent,")
rule CriticalMineralThreshold2030 defeasible {
    effective [@2025-07-04, infinity);
    for c: EligibleComponentProduction; for d: Date;
    when is_applicable_critical_mineral_under_45x_c6(c) and component_sold_on(c, d) and d >= @2030-01-01 and d <= @2030-12-31;
    unless secretary_issued_threshold_applies_to_component(c);
    then material_assistance_threshold_percentage_component(c, 25);
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(cc) during calendar year 2031, 30 percent,")
rule CriticalMineralThreshold2031 defeasible {
    effective [@2025-07-04, infinity);
    for c: EligibleComponentProduction; for d: Date;
    when is_applicable_critical_mineral_under_45x_c6(c) and component_sold_on(c, d) and d >= @2031-01-01 and d <= @2031-12-31;
