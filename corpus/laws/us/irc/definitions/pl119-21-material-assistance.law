}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(dd) during calendar year 2032, 40 percent, and")
rule CriticalMineralThreshold2032 defeasible {
    effective [@2025-07-04, infinity);
    for c: EligibleComponentProduction; for d: Date;
    when is_applicable_critical_mineral_under_45x_c6(c) and component_sold_on(c, d) and d >= @2032-01-01 and d <= @2032-12-31;
    unless secretary_issued_threshold_applies_to_component(c);
    then material_assistance_threshold_percentage_component(c, 40);
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(ee) after December 31, 2032, 50 percent.")
rule CriticalMineralThresholdAfter2032 defeasible {
    effective [@2025-07-04, infinity);
    for c: EligibleComponentProduction; for d: Date;
    when is_applicable_critical_mineral_under_45x_c6(c) and component_sold_on(c, d) and d > @2032-12-31;
    unless secretary_issued_threshold_applies_to_component(c);
    then material_assistance_threshold_percentage_component(c, 50);
}
pub relation material_assistance_from_prohibited_foreign_entity_component(c: EligibleComponentProduction) kind institutional {
    label en official "material assistance from a prohibited foreign entity: with respect to any facility which produces eligible components, a material assistance cost ratio which is less than the threshold percentage applicable under subparagraph (C)";
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(ii) with respect to any facility which produces eligible components, a material assistance cost ratio which is less than the threshold percentage applicable under subparagraph (C).")
rule ComponentRatioBelowThresholdIsMaterialAssistance defeasible {
    effective [@2025-07-04, infinity);
    for c: EligibleComponentProduction; for t: Money; for m: Money; for th: Integer;
    when net_total_direct_material_costs_of_component(c, t) and net_pfe_material_costs_of_component(c, m)
        and material_assistance_threshold_percentage_component(c, th) and (t - m) * 100 < t * th;
    then material_assistance_from_prohibited_foreign_entity_component(c);
}

// --- Secretary's duties in (52) ----------------------------------------------------------
pub relation issues_critical_mineral_threshold_percentages(o: Organ) kind empirical {
    label en official "the Secretary shall issue threshold percentages for each of the applicable critical minerals described in section 45X(c)(6), which apply in lieu of the threshold percentage determined under clause (i)(V) and equal or exceed the threshold percentage which would otherwise apply";
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = exact, quote = "Not later than December 31, 2027, the Secretary shall issue threshold percentages for each of the applicable critical minerals described in section 45X(c)(6))")
rule S7701a52CiiSecretaryShallIssueCriticalMineralThresholdsByEnd2027 strict {
    effective [@2025-07-04, infinity);
    when true;
    then duty IssueCriticalMineralThresholdPercentagesByDecember312027 {
        bearer Secretary;
        goal achievement {
            condition issues_critical_mineral_threshold_percentages(Secretary);
            window [@2025-07-04, @2027-12-31];
        }
    };
}
pub relation issues_safe_harbor_tables_and_guidance_for_material_assistance(o: Organ) kind empirical {
    label en official "the Secretary shall issue safe harbor tables (and such other guidance as deemed necessary) to identify the percentage of total direct costs of any manufactured product and of total direct material costs of any eligible component attributable to a prohibited foreign entity, and provide all rules necessary to determine the amount of a taxpayer's material assistance from a prohibited foreign entity";
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = exact, quote = "Not later than December 31, 2026, the Secretary shall issue safe harbor tables (and such other guidance as deemed necessary) to—")
rule S7701a52DiiiSecretaryShallIssueSafeHarborTablesByEnd2026 strict {
    effective [@2025-07-04, infinity);
    when true;
    then duty IssueMaterialAssistanceSafeHarborTablesByDecember312026 {
        bearer Secretary;
        goal achievement {
            condition issues_safe_harbor_tables_and_guidance_for_material_assistance(Secretary);
            window [@2025-07-04, @2026-12-31];
        }
    };
}
pub relation prescribes_regulations_preventing_circumvention_of_material_assistance_rules(o: Organ) kind empirical {
    label en official "the Secretary shall prescribe such regulations and guidance as may be necessary or appropriate to prevent circumvention of the rules under this subparagraph, including stockpiling abuse of the clause (iv) exception and evasion where the beginning of construction has not in fact occurred";
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "The Secretary shall prescribe such regulations and guidance as may be necessary or appropriate to prevent circumvention of the rules under this subparagraph")
rule S7701a52DvSecretaryShallPrescribeAntiCircumventionRules strict {
    effective [@2025-07-04, infinity);
    when true;
    then duty PrescribeMaterialAssistanceAntiCircumventionRules {
        bearer Secretary;
        goal achievement {
            condition prescribes_regulations_preventing_circumvention_of_material_assistance_rules(Secretary);
            window [@2025-07-04, infinity];
        }
    };
}

// --- (D)(iv): the taxpayer's election for existing contracts ---------------------------------
pub entity ExistingContractCostItem { label en unofficial "a manufactured product, eligible component, or constituent element, material, or subcomponent whose cost the taxpayer elects to exclude"; }
pub relation acquired_under_binding_written_contract_entered_before_june_16_2025(i: ExistingContractCostItem) kind empirical {
    label en official "acquired by the taxpayer, or manufactured or assembled by or for the taxpayer, pursuant to a binding written contract which was entered into prior to June 16, 2025";
}
pub relation placed_in_service_before_2030_in_facility_construction_began_before_august_1_2025(i: ExistingContractCostItem) kind empirical {
    label en official "placed into service before January 1, 2030 (or, in the case of an applicable facility, as defined in section 45Y(d)(4)(B), before January 1, 2028) in a facility the construction of which began before August 1, 2025";
}
pub relation constituent_used_in_product_sold_before_2030(i: ExistingContractCostItem) kind empirical {
    label en official "in the case of a constituent element, material, or subcomponent, used in a product sold before January 1, 2030";
}
pub relation taxpayer_elects_to_exclude_cost_from_material_assistance_ratio(i: ExistingContractCostItem) kind empirical {
    label en official "upon the election of the taxpayer (in such form and manner as the Secretary shall designate) ... the cost to the taxpayer with respect to such product, component, element, material, or subcomponent shall not be included for purposes of determining the material assistance cost ratio";
}
pub relation election_conditions_of_clause_iv_met(i: ExistingContractCostItem) kind institutional {
    label en official "the item is acquired under a binding written contract entered into before June 16, 2025 and is either placed into service in a facility whose construction began before August 1, 2025 (before 2030, or 2028 for an applicable facility) or, as a constituent element, material or subcomponent, used in a product sold before January 1, 2030";
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(I) acquired by the taxpayer, or manufactured or assembled by or for the taxpayer, pursuant to a binding written contract which was entered into prior to June 16, 2025, and")
rule ContractBeforeJune162025AndPlacedInServiceInEarlyFacilityMeetsElectionConditions strict {
    effective [@2025-07-04, infinity);
    for i: ExistingContractCostItem;
    when acquired_under_binding_written_contract_entered_before_june_16_2025(i) and placed_in_service_before_2030_in_facility_construction_began_before_august_1_2025(i);
    then election_conditions_of_clause_iv_met(i);
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(bb) in the case of a constituent element, material, or subcomponent, used in a product sold before January 1, 2030,")
rule ContractBeforeJune162025AndConstituentUsedInEarlyProductMeetsElectionConditions strict {
    effective [@2025-07-04, infinity);
    for i: ExistingContractCostItem;
    when acquired_under_binding_written_contract_entered_before_june_16_2025(i) and constituent_used_in_product_sold_before_2030(i);
    then election_conditions_of_clause_iv_met(i);
}
pub relation cost_excluded_from_material_assistance_cost_ratio(i: ExistingContractCostItem) kind institutional {
    label en official "the cost to the taxpayer with respect to such product, component, element, material, or subcomponent shall not be included for purposes of determining the material assistance cost ratio";
}
pub relation electing_taxpayer_of_item(i: ExistingContractCostItem, p: Person) kind empirical {
    label en unofficial "the taxpayer who may make the election for this item";
}
@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "the cost to the taxpayer with respect to such product, component, element, material, or subcomponent shall not be included for purposes of determining the material assistance cost ratio under this subparagraph.")
rule TaxpayerMayElectToExcludeExistingContractCosts strict {
    label en unofficial "§7701(a)(52)(D)(iv): the taxpayer's election excludes the cost of qualifying existing-contract items from the ratio; an election over an item outside the conditions has no effect (E-0239). The exclusion is created as a fact about the item; the ratio inputs of the rules above are aggregates asserted by the case, which must net it (stage 3: netted in pl119-21-stage3.law)";
    effective [@2025-07-04, infinity);
    for i: ExistingContractCostItem; for p: Person;
    when electing_taxpayer_of_item(i, p);
    then power ElectToExcludeExistingContractCostsFromMaterialAssistanceRatio {
        holder p;
        over i;
        exercise taxpayer_elects_to_exclude_cost_from_material_assistance_ratio(i);
        valid_when election_conditions_of_clause_iv_met(i);
        effect create(cost_excluded_from_material_assistance_cost_ratio(i));
    };
}
