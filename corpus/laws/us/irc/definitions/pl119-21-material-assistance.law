@source(us.irc.temporal::PL119_21_S70512, relation = formalizes, coverage = partial, quote = "(aa) during calendar year 2026, 50 percent,")
rule InverterThreshold2026 strict {
    effective [@2025-07-04, infinity);
    for c: EligibleComponentProduction; for d: Date;
