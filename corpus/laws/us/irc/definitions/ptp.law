// §7704 — publicly traded partnerships. Full section per the owner's task:
// (a) general rule (treated as a corporation), (b) the "publicly traded"
// definition, (c) the 90% qualifying-income exception, (d) the qualifying-
// income list, (e) inadvertent terminations, (f) the deemed-incorporation
// transaction, (g) the electing-1987-partnership grandfather (summarized:
// the 1997-2026-window-specific additional 3.5% tax computation of (g)(3)
// is a TECH_GAP left as a typed fact, not computed, since no partnership can
// newly qualify for it and the owner's task does not ask for legacy 1997
// transition mechanics in full).
//
// Anchors: `IRC_S7704_A` through `IRC_S7704_G`.

language "law.core" version "0.2";
package us.irc.definitions version "0.1.1";
namespace "urn:us:irc:definitions:clir";

use self::{
    IRC_S7704_A,
    IRC_S7704_B,
    IRC_S7704_C,
    IRC_S7704_E,
    IRC_S7704_F,
    IRC_S7704_G,
    Partnership,
    TaxableYear,
    qualifying_gross_income_including_added_categories,
};

// --- (b) Publicly traded partnership ----------------------------------------
pub relation interests_traded_on_established_securities_market(p: Partnership) kind empirical {
    label en official "interests in such partnership are traded on an established securities market";
}
pub relation interests_readily_tradable_on_secondary_market(p: Partnership) kind empirical {
    label en official "interests in such partnership are readily tradable on a secondary market (or the substantial equivalent thereof)";
}
pub relation publicly_traded_partnership(p: Partnership) kind institutional {
    label en official "the term \"publicly traded partnership\" means any partnership if interests in such partnership are traded on an established securities market, or are readily tradable on a secondary market (or the substantial equivalent thereof)";
}
@source(IRC_S7704_B, relation = formalizes, coverage = partial, quote = "interests in such partnership are traded on an established securities market")
rule TradedOnEstablishedMarketIsPubliclyTraded strict {
    for p: Partnership;
    when interests_traded_on_established_securities_market(p);
    then publicly_traded_partnership(p);
}
@source(IRC_S7704_B, relation = formalizes, coverage = partial, quote = "interests in such partnership are readily tradable on a secondary market (or the substantial equivalent thereof)")
rule ReadilyTradableOnSecondaryMarketIsPubliclyTraded strict {
    for p: Partnership;
    when interests_readily_tradable_on_secondary_market(p);
    then publicly_traded_partnership(p);
}

// --- (d) Qualifying income ---------------------------------------------------
// The (d)(1) list (interest not from a financial/insurance business,
// dividends, real property rents, gain from real property, minerals/natural
// resources activities, industrial carbon dioxide/fuel transport or
// storage, gain from a capital asset held for the production of the
// foregoing, and — for the RIC-eligible commodity-trading partnerships of
// (c)(3)'s second sentence — commodities/derivatives income) is a TYPED
// enumeration a case uses to classify its own reported figures; this
// package asks directly for the AGGREGATE qualifying and total gross-income
// amounts for the year (not a re-derivation from first principles of
// "interest" or "dividends", which belongs to the owners of those concepts
// elsewhere in the title, and not a per-item sum, which would need an
// entity per income item this stage does not introduce).
pub enum QualifyingIncomeCategory {
    InterestNotFromFinancialOrInsuranceBusiness;
    Dividends;
    RealPropertyRents;
    GainFromSaleOfRealProperty;
    MineralOrNaturalResourceActivities;
    IndustrialSourceCarbonDioxideOrFuelTransportOrStorage;
    GainFromCapitalAssetHeldForQualifyingIncomeProduction;
    CommoditiesOrDerivativesForRicLikePartnerships;
    label en unofficial "the (d)(1) qualifying-income categories (A)-(G)";
}
pub relation total_gross_income_for_year(p: Partnership, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the partnership's total gross income for the taxable year";
}
pub relation qualifying_gross_income_for_year(p: Partnership, y: TaxableYear, amount: Money) kind empirical {
    label en official "the term \"qualifying income\" means— (A) interest, (B) dividends, (C) real property rents, (D) gain from the sale or other disposition of real property … (E) income and gains derived from the exploration, development, mining or production, processing, refining, transportation … or the marketing of any mineral or natural resource … (F) any gain from the sale or disposition of a capital asset … held for the production of income described in any of the foregoing subparagraphs, and (G) [RIC-eligible commodity partnerships] income and gains from commodities or futures, forwards, and options with respect to commodities — the case's own aggregate of amounts falling in one of these categories";
}

// --- (c) Exception for partnerships with passive-type income ----------------
pub relation ninety_percent_gross_income_requirement_met_for_year(p: Partnership, y: TaxableYear) kind institutional {
    label en official "a partnership meets the gross income requirements of this paragraph for any taxable year if 90 percent or more of the gross income of such partnership for such taxable year consists of qualifying income";
}
pub relation met_gross_income_requirement_every_year_since_1988_or_first_existence(p: Partnership, y: TaxableYear) kind empirical {
    label en unofficial "the partnership met the (c)(2) 90% requirement for this taxable year and every preceding taxable year beginning after December 31, 1987, during which it (or a predecessor) was in existence — the (c)(1) multi-year condition, asserted directly rather than re-derived from a full accounting history";
}
pub relation would_be_regulated_investment_company_if_domestic_corporation(p: Partnership) kind empirical {
    label en official "any partnership which would be described in section 851(a) if such partnership were a domestic corporation";
}
pub relation principal_activity_is_buying_and_selling_commodities_or_derivatives(p: Partnership) kind empirical {
    label en official "a partnership a principal activity of which is the buying and selling of commodities (not described in section 1221(a)(1)), or options, futures, or forwards with respect to commodities";
}
pub relation passive_type_income_exception_applies(p: Partnership, y: TaxableYear) kind institutional {
    label en official "subsection (a) shall not apply to any publicly traded partnership for any taxable year if such partnership met the gross income requirements of paragraph (2) for such taxable year and each preceding taxable year beginning after December 31, 1987, during which the partnership (or any predecessor) was in existence";
}
@source(IRC_S7704_C, relation = formalizes, coverage = partial, quote = "A partnership meets the gross income requirements of this paragraph for any taxable year if 90 percent or more of the gross income of such partnership for such taxable year consists of qualifying income.")
rule NinetyPercentTestByAmount strict {
    for p: Partnership; for y: TaxableYear; for q: Money; for t: Money;
    when qualifying_gross_income_including_added_categories(p, y, q) and total_gross_income_for_year(p, y, t) and q * 100 >= t * 90;
    then ninety_percent_gross_income_requirement_met_for_year(p, y);
}
@source(IRC_S7704_C, relation = formalizes, coverage = partial, quote = "Subsection (a) shall not apply to any publicly traded partnership for any taxable year if such partnership met the gross income requirements of paragraph (2) for such taxable year and each preceding taxable year beginning after December 31, 1987, during which the partnership (or any predecessor) was in existence.")
rule NotRicEligibleAndMeetsMultiYearNinetyPercentGetsPassiveIncomeException strict {
    for p: Partnership; for y: TaxableYear;
    when ninety_percent_gross_income_requirement_met_for_year(p, y)
        and met_gross_income_requirement_every_year_since_1988_or_first_existence(p, y)
        and not_known(would_be_regulated_investment_company_if_domestic_corporation(p));
    then passive_type_income_exception_applies(p, y);
}
@source(IRC_S7704_C, relation = formalizes, coverage = partial, quote = "This subsection shall not apply to any partnership which would be described in section 851(a) if such partnership were a domestic corporation.")
rule RicEligibleButCommodityTradingPartnershipStillGetsException strict {
    for p: Partnership; for y: TaxableYear;
    when ninety_percent_gross_income_requirement_met_for_year(p, y)
        and met_gross_income_requirement_every_year_since_1988_or_first_existence(p, y)
        and would_be_regulated_investment_company_if_domestic_corporation(p)
        and principal_activity_is_buying_and_selling_commodities_or_derivatives(p);
    then passive_type_income_exception_applies(p, y);
}

// --- (e) Inadvertent terminations --------------------------------------------
pub relation failed_gross_income_requirement(p: Partnership, y: TaxableYear) kind empirical {
    label en official "a partnership fails to meet the gross income requirements of subsection (c)(2)";
}
pub relation secretary_determines_failure_inadvertent(p: Partnership, y: TaxableYear) kind empirical {
    label en official "the Secretary determines that such failure was inadvertent";
}
pub relation cured_within_reasonable_time(p: Partnership, y: TaxableYear) kind empirical {
    label en official "no later than a reasonable time after the discovery of such failure, steps are taken so that such partnership once more meets such gross income requirements";
}
pub relation partnership_agrees_to_secretary_required_adjustments_or_payments(p: Partnership, y: TaxableYear) kind empirical {
    label en official "such partnership agrees to make such adjustments (including adjustments with respect to the partners) or to pay such amounts as may be required by the Secretary with respect to such period";
}
pub relation treated_as_continuing_to_meet_gross_income_requirements(p: Partnership, y: TaxableYear) kind institutional {
    label en official "notwithstanding such failure, such entity shall be treated as continuing to meet such gross income requirements for such period";
}
@source(IRC_S7704_E, relation = formalizes, coverage = partial, quote = "a partnership fails to meet the gross income requirements of subsection (c)(2),")
rule InadvertentFailureCuredIsTreatedAsContinuingToQualify strict {
    for p: Partnership; for y: TaxableYear;
    when failed_gross_income_requirement(p, y) and secretary_determines_failure_inadvertent(p, y)
        and cured_within_reasonable_time(p, y) and partnership_agrees_to_secretary_required_adjustments_or_payments(p, y);
    then treated_as_continuing_to_meet_gross_income_requirements(p, y);
}

// --- (a) General rule: treated as a corporation -----------------------------
// Grounding fact for `y` (§190 range-restriction): `publicly_traded_
// partnership(p)` alone does not mention a taxable year, so the case names
// the specific year its PTP-status question is about.
pub relation ptp_status_evaluated_for_year(p: Partnership, y: TaxableYear) kind empirical {
    label en unofficial "grounding fact: the partnership's treatment under this section is being evaluated for this taxable year";
}
pub relation treated_as_corporation_under_ptp_rule(p: Partnership, y: TaxableYear) kind institutional {
    label en official "for purposes of this title, except as provided in subsection (c), a publicly traded partnership shall be treated as a corporation";
}
@source(IRC_S7704_A, relation = formalizes, coverage = partial, quote = "For purposes of this title, except as provided in subsection (c), a publicly traded partnership shall be treated as a corporation.")
rule PubliclyTradedPartnershipTreatedAsCorporationUnlessExcepted strict {
    for p: Partnership; for y: TaxableYear;
    when publicly_traded_partnership(p) and ptp_status_evaluated_for_year(p, y)
        and not_known(passive_type_income_exception_applies(p, y))
        and not_known(treated_as_continuing_to_meet_gross_income_requirements(p, y))
        and not_known(electing_1987_partnership_exception_applies(p, y));
    then treated_as_corporation_under_ptp_rule(p, y);
}

// --- (f) Effect of becoming a corporation: the deemed transaction ----------
pub relation deemed_transfer_of_assets_to_new_corporation_for_stock(p: Partnership, y: TaxableYear) kind institutional {
    label en official "as of the 1st day that a partnership is treated as a corporation under this section … such partnership shall be treated as— (1) transferring all of its assets (subject to its liabilities) to a newly formed corporation in exchange for the stock of the corporation, and (2) distributing such stock to its partners in liquidation of their interests in the partnership";
}
@source(IRC_S7704_F, relation = formalizes, coverage = partial, quote = "As of the 1st day that a partnership is treated as a corporation under this section, for purposes of this title, such partnership shall be treated as—")
rule FirstDayOfCorporateTreatmentTriggersDeemedIncorporation strict {
    for p: Partnership; for y: TaxableYear;
    when treated_as_corporation_under_ptp_rule(p, y);
    then deemed_transfer_of_assets_to_new_corporation_for_stock(p, y);
}

// --- (g) Electing 1987 partnerships (typed fact; the 3.5% tax is a TECH_GAP) -
pub relation is_electing_1987_partnership(p: Partnership) kind empirical {
    label en unofficial "the partnership is an electing 1987 partnership within the meaning of (g)(2) (asserted directly: the (A)-(C) 1987-1997 eligibility window is closed history, not a computation this stage re-derives)";
}
pub relation electing_1987_partnership_exception_applies(p: Partnership, y: TaxableYear) kind institutional {
    label en official "subsection (a) shall not apply to an electing 1987 partnership";
}
@source(IRC_S7704_G, relation = formalizes, coverage = partial, quote = "Subsection (a) shall not apply to an electing 1987 partnership.")
rule Electing1987PartnershipExempt strict {
    for p: Partnership; for y: TaxableYear;
    when is_electing_1987_partnership(p) and ptp_status_evaluated_for_year(p, y);
    then electing_1987_partnership_exception_applies(p, y);
}
// TECH_GAP: the (g)(3) 3.5%-of-active-trade-or-business-gross-income
// additional tax on an electing 1987 partnership, including the tiered-
// partnership look-through of (g)(3)(B), is NOT computed by this package —
// no rule derives an amount from it. Minimal reproduction: a case asserting
// `is_electing_1987_partnership(p)` and gross income from an active trade or
// business gets no `liability` fact of `TaxKind` for this 3.5% tax; the
// enum `us.irc.core::TaxKind` also has no dedicated value for it. See
// `coverage/definitions.json` id `26/7704/g/...`.
