// §7701(a) general definitions, stage 1 scope. Every rule below anchors on
// the single whole-section fragment `IRC_S7701` with a quote anchor
// (DECISION-0358); paragraph numbers in comments are the statute's own.

language "law.core" version "0.2";
package us.irc.definitions version "0.1.1";
namespace "urn:us:irc:definitions:clir";

use self::{
    Association,
    Corporation,
    Estate,
    IRC_S7701,
    Organ,
    Partnership,
    Person,
    TaxCourt,
    TaxableYear,
    Trust,
};

// --- (a)(1) Person -----------------------------------------------------
// "The term 'person' shall be construed to mean and include an individual, a
// trust, estate, partnership, association, company or corporation."
// EXECUTABLE trivially: `us.irc.core::Person`'s subtype list (Individual,
// Trust, Estate, Partnership, Association, Corporation) already IS this
// enumeration ("company" is absorbed into Corporation by (a)(3), see
// `us.irc.core::persons.law` comment) — no separate rule needed; a value of
// any of these six subtypes is a `person` by construction of the type.
pub relation person(x: Person) kind institutional {
    label en official "the term \"person\" shall be construed to mean and include an individual, a trust, estate, partnership, association, company or corporation";
}
// Grounding fact: the compiler's range-restriction check (§190) rejects a
// rule whose head variable is bound by nothing but the entity TYPE (an
// infinite-domain guard, not a finite extension) — so even a trivially-true-
// by-construction identity needs the case to name its entity through SOME
// premise. A case brings any `Person` instance into evidence via this
// marker (or, more often, via any of the OTHER empirical facts below that
// already mention it).
pub relation person_presented_in_case(x: Person) kind empirical {
    label en unofficial "grounding fact: the person is named in the case (a marker only where no other fact about them is asserted)";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"person\" shall be construed to mean and include an individual, a trust, estate, partnership, association, company or corporation.")
rule EveryPersonSubtypeIsAPerson strict {
    for x: Person;
    when person_presented_in_case(x);
    then person(x);
}

// --- (a)(2) Partnership; (a)(3) Corporation -----------------------------
// The core subtype already carries most of the classification for a case
// that types its entity as `Corporation`/`Partnership` directly. The
// content-bearing test is for an `Association` (an unincorporated
// organization not already typed by the case as one of the other five):
// does it carry on business through the organization (→ partnership,
// (a)(2)), or does it resemble a corporation (joint-stock company,
// insurance company, or "association" under the regulatory factors)
// (→ corporation, (a)(3))? An association is not both: `corporation`
// classification takes priority over `partnership` classification per the
// text's own structure ((a)(2) partnership excludes "a trust or estate or a
// corporation").
pub relation carries_on_business_or_venture_through_organization(a: Association) kind empirical {
    label en official "through or by means of which any business, financial operation, or venture is carried on";
}
pub relation organized_as_joint_stock_company(a: Association) kind empirical {
    label en official "joint-stock companies";
}
pub relation organized_as_insurance_company(a: Association) kind empirical {
    label en official "insurance companies";
}
// The "check-the-box" resemblance-to-a-corporation factors (26 CFR
// 301.7701-2/3) are NOT this package's rule: this relation is the point
// where a case (or a future rule ported from the regulation) supplies the
// regulatory classification result. `DEPENDENCIES.json` records 26 CFR as
// `external_norm_unresolved`.
pub relation treated_as_corporation_under_entity_classification_regulations(a: Association) kind empirical {
    label en unofficial "the association is classified as a corporation under 26 CFR 301.7701-2/3 (external dependency)";
}
pub relation corporation(x: Person) kind institutional {
    label en official "the term \"corporation\" includes associations, joint-stock companies, and insurance companies";
}
pub relation partnership(x: Person) kind institutional {
    label en official "the term \"partnership\" includes a syndicate, group, pool, joint venture, or other unincorporated organization, through or by means of which any business, financial operation, or venture is carried on, and which is not, within the meaning of this title, a trust or estate or a corporation";
}

pub relation corporation_presented_in_case(c: Corporation) kind empirical {
    label en unofficial "grounding fact: the Corporation-typed entity is named in the case (see the person-marker comment above)";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"corporation\" includes associations, joint-stock companies, and insurance companies.")
rule CorporationEntityIsCorporation strict {
    for c: Corporation;
    when corporation_presented_in_case(c);
    then corporation(c);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"corporation\" includes associations, joint-stock companies, and insurance companies.")
rule AssociationJointStockCompanyIsCorporation strict {
    for a: Association;
    when organized_as_joint_stock_company(a);
    then corporation(a);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"corporation\" includes associations, joint-stock companies, and insurance companies.")
rule AssociationInsuranceCompanyIsCorporation strict {
    for a: Association;
    when organized_as_insurance_company(a);
    then corporation(a);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"corporation\" includes associations, joint-stock companies, and insurance companies.")
rule AssociationRegulatorilyClassifiedIsCorporation strict {
    for a: Association;
    when treated_as_corporation_under_entity_classification_regulations(a);
    then corporation(a);
}

pub relation partnership_presented_in_case(p: Partnership) kind empirical {
    label en unofficial "grounding fact: the Partnership-typed entity is named in the case (see the person-marker comment above)";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"partnership\" includes a syndicate, group, pool, joint venture, or other unincorporated organization, through or by means of which any business, financial operation, or venture is carried on, and which is not, within the meaning of this title, a trust or estate or a corporation")
rule PartnershipEntityIsPartnership strict {
    for p: Partnership;
    when partnership_presented_in_case(p);
    then partnership(p);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"partnership\" includes a syndicate, group, pool, joint venture, or other unincorporated organization, through or by means of which any business, financial operation, or venture is carried on, and which is not, within the meaning of this title, a trust or estate or a corporation")
rule AssociationCarryingOnBusinessIsPartnership strict {
    for a: Association;
    when carries_on_business_or_venture_through_organization(a) and not_known(corporation(a));
    then partnership(a);
}

// --- (a)(4)/(a)(5, out of scope) domestic ------------------------------
// "The term 'domestic' when applied to a corporation or partnership means
// created or organized in the United States or under the law of the United
// States or of any State unless, in the case of a partnership, the
// Secretary provides otherwise by regulations." `foreign` is (a)(5),
// literally out of this stage's paragraph list, but the CONTRACT interface
// asks for `foreign(x) iff not_known(domestic(x))` restricted to corporations/
// partnerships, and (a)(4)'s own "unless the Secretary provides otherwise"
// clause cannot be read without it, so both are declared together here.
pub relation created_or_organized_in_us_or_state(x: Person) kind empirical {
    label en official "created or organized in the United States or under the law of the United States or of any State";
}
// The Secretary's regulatory override for partnerships (a)(4) names —
// asserted as its own fact so a case can show the override applies without
// this package inventing the regulation's content.
pub relation secretary_regulation_overrides_domestic_for_partnership(p: Partnership) kind empirical {
    label en unofficial "the Secretary provides otherwise by regulations for this partnership (26 CFR, external dependency)";
}
pub relation domestic(x: Person) kind institutional {
    label en official "created or organized in the United States or under the law of the United States or of any State";
}
pub relation foreign(x: Person) kind institutional {
    label en unofficial "(a)(5), read together with (a)(4)): not domestic, restricted to corporations and partnerships";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"domestic\" when applied to a corporation or partnership means created or organized in the United States or under the law of the United States or of any State unless, in the case of a partnership, the Secretary provides otherwise by regulations.")
rule DomesticCorporationByOrganization strict {
    for x: Corporation;
    when created_or_organized_in_us_or_state(x);
    then domestic(x);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"domestic\" when applied to a corporation or partnership means created or organized in the United States or under the law of the United States or of any State unless, in the case of a partnership, the Secretary provides otherwise by regulations.")
rule DomesticPartnershipByOrganizationUnlessOverridden strict {
    for x: Partnership;
    when created_or_organized_in_us_or_state(x) and not_known(secretary_regulation_overrides_domestic_for_partnership(x));
    then domestic(x);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"domestic\" when applied to a corporation or partnership means created or organized in the United States or under the law of the United States or of any State unless, in the case of a partnership, the Secretary provides otherwise by regulations.")
rule ForeignCorporationOrPartnershipByExclusion strict {
    for x: Person;
    when (corporation(x) or partnership(x)) and not_known(domestic(x));
    then foreign(x);
}

// --- (a)(6) Fiduciary ----------------------------------------------------
// Already given a shared shape by core (`role Fiduciary`, `fiduciary_for`);
// this package supplies the actual membership TEST — a person is a
// fiduciary when the case shows they act in one of the named capacities (or
// any other fiduciary capacity) for another person.
pub relation acts_as_guardian_trustee_executor_administrator_receiver_or_conservator(p: Person) kind empirical {
    label en official "a guardian, trustee, executor, administrator, receiver, conservator";
}
pub relation acts_in_fiduciary_capacity_for_another(p: Person, principal: Person) kind empirical {
    label en official "any person acting in any fiduciary capacity for any person";
}
// `fiduciary(p)` is this package's own predicate; a case that also wants the
// core role membership fact asserts `has_role(p, us.irc.core::Fiduciary, …)`
// and `us.irc.core::fiduciary_for(p, principal)` directly (both are
// core-declared relations this rule does not need to re-derive to be a
// complete definitional test).
pub relation fiduciary(p: Person) kind institutional {
    label en official "the term \"fiduciary\" means a guardian, trustee, executor, administrator, receiver, conservator, or any person acting in any fiduciary capacity for any person";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"fiduciary\" means a guardian, trustee, executor, administrator, receiver, conservator, or any person acting in any fiduciary capacity for any person.")
rule NamedCapacityHolderIsFiduciary strict {
    for p: Person;
    when acts_as_guardian_trustee_executor_administrator_receiver_or_conservator(p);
    then fiduciary(p);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"fiduciary\" means a guardian, trustee, executor, administrator, receiver, conservator, or any person acting in any fiduciary capacity for any person.")
rule AnyFiduciaryCapacityHolderIsFiduciary strict {
    for p: Person; for principal: Person;
    when acts_in_fiduciary_capacity_for_another(p, principal);
    then fiduciary(p);
}

// --- (a)(7) Stock; (a)(8) Shareholder --------------------------------------
// Both are INCLUSION glosses (broaden, not exhaustively define, the term)
// extending "stock"/"shareholder" to the Association/joint-stock company/
// insurance company family that (a)(3) sweeps into "corporation".
pub relation share_in_association_joint_stock_company_or_insurance_company(x: Association) kind empirical {
    label en official "shares in an association, joint-stock company, or insurance company";
}
pub relation stock_includes(x: Association) kind institutional {
    label en official "the term \"stock\" includes shares in an association, joint-stock company, or insurance company";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"stock\" includes shares in an association, joint-stock company, or insurance company.")
rule ShareInAssociationIsStock strict {
    for x: Association;
    when share_in_association_joint_stock_company_or_insurance_company(x);
    then stock_includes(x);
}
pub relation member_in_association_joint_stock_company_or_insurance_company(p: Person, x: Association) kind empirical {
    label en official "a member in an association, joint-stock company, or insurance company";
}
pub relation shareholder_includes(p: Person, x: Association) kind institutional {
    label en official "the term \"shareholder\" includes a member in an association, joint-stock company, or insurance company";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"shareholder\" includes a member in an association, joint-stock company, or insurance company.")
rule MemberInAssociationIsShareholder strict {
    for p: Person; for x: Association;
    when member_in_association_joint_stock_company_or_insurance_company(p, x);
    then shareholder_includes(p, x);
}

// --- (a)(9) United States (geographic); (a)(10) State ---------------------
// No `Place`/geographic type exists in core (CONTRACT.md names this as the
// definitions agent's own introduction). A minimal local entity suffices: a
// case names a jurisdiction and asserts whether it is one of the 50 States
// or the District of Columbia; this package derives the two title-wide
// geographic predicates.
pub entity GeographicArea { label en unofficial "a jurisdiction named in a case (a State, the District of Columbia, or elsewhere)"; }
pub relation is_state_of_the_union(g: GeographicArea) kind empirical {
    label en unofficial "the area is one of the fifty States";
}
pub relation is_district_of_columbia(g: GeographicArea) kind empirical {
    label en unofficial "the area is the District of Columbia";
}
pub relation united_states_geographic(g: GeographicArea) kind institutional {
    label en official "the term \"United States\" when used in a geographical sense includes only the States and the District of Columbia";
}
pub relation state_for_this_title(g: GeographicArea) kind institutional {
    label en official "the term \"State\" shall be construed to include the District of Columbia, where such construction is necessary to carry out provisions of this title";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"United States\" when used in a geographical sense includes only the States and the District of Columbia.")
rule StateIsWithinUnitedStatesGeographic strict {
    for g: GeographicArea;
    when is_state_of_the_union(g);
    then united_states_geographic(g);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"United States\" when used in a geographical sense includes only the States and the District of Columbia.")
rule DistrictOfColumbiaIsWithinUnitedStatesGeographic strict {
    for g: GeographicArea;
    when is_district_of_columbia(g);
    then united_states_geographic(g);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"State\" shall be construed to include the District of Columbia, where such construction is necessary to carry out provisions of this title.")
rule StateOfTheUnionIsStateForThisTitle strict {
    for g: GeographicArea;
    when is_state_of_the_union(g);
    then state_for_this_title(g);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"State\" shall be construed to include the District of Columbia, where such construction is necessary to carry out provisions of this title.")
rule DistrictOfColumbiaIsStateForThisTitle strict {
    for g: GeographicArea;
    when is_district_of_columbia(g);
    then state_for_this_title(g);
}

// --- (a)(11)-(12) Secretary of the Treasury / Secretary / delegate --------
// `us.irc.core::Secretary` already identifies "the Secretary of the
// Treasury or his delegate" as ONE constant (a)(11)(B). (a)(11)(A) is the
// narrower "Secretary of the Treasury, personally" reading, and (a)(12) is
// the delegation test itself: WHICH officer, employee or agency currently
// holds the delegated authority for a named function.
pub relation is_delegate_of_secretary_for_function(o: Organ, func: Text) kind empirical {
    label en official "any officer, employee, or agency of the Treasury Department duly authorized by the Secretary of the Treasury directly, or indirectly by one or more redelegations of authority, to perform the function mentioned or described in the context";
}
pub relation secretary_or_delegate_for_function(o: Organ, func: Text) kind institutional {
    label en official "\"or his delegate\"";
}
// NOTE: "the Secretary personally is secretary-or-delegate for every
// function" is not written as a rule quantifying freely over `Text`: a
// free-`Text` head is outside the L0 lowering slice (unbounded scalar
// domain, no finite extension) and the compiler will not lower it (would be
// a silent no-op node, LDC-E1302/E1305). A case simply cites
// `us.irc.core::Secretary` directly wherever "the Secretary" is needed; only
// the DELEGATE test below (bound through an actual case-asserted
// delegation) is a genuine classification rule.
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "when used with reference to the Secretary of the Treasury, means any officer, employee, or agency of the Treasury Department duly authorized by the Secretary of the Treasury directly, or indirectly by one or more redelegations of authority, to perform the function mentioned or described in the context")
rule DelegateForFunctionIsSecretaryOrDelegate strict {
    for o: Organ; for func: Text;
    when is_delegate_of_secretary_for_function(o, func);
    then secretary_or_delegate_for_function(o, func);
}

// --- (a)(13) Commissioner --------------------------------------------------
// Not among core's named constants (CONTRACT.md's core table stops at
// Secretary/IRS/TaxCourt/DistrictCourt/CourtOfFederalClaims/Congress); this
// package declares its own constant of core's `Organ` type, per the
// "definitions agent should re-derive it" instruction.
pub const Commissioner: Organ = entity_ref("urn:us:irc:definitions:clir#commissioner") {
    label en official "the Commissioner of Internal Revenue";
}

// --- (a)(14) Taxpayer -------------------------------------------------------
// The actual test behind `us.irc.core::role Taxpayer` membership: "any
// person subject to any internal revenue tax." Derived institutionally from
// the existence of a `liability` fact of core (an owner package's rule
// produces `liability`); a case may also assert the underlying fact
// directly for a scenario that does not compute a full liability.
pub relation subject_to_internal_revenue_tax(p: Person) kind empirical {
    label en unofficial "the person is subject to an internal revenue tax (asserted directly, e.g. for a scenario that does not compute a full liability)";
}
pub relation taxpayer(p: Person) kind institutional {
    label en official "the term \"taxpayer\" means any person subject to any internal revenue tax";
}
// `taxpayer(p)` is this package's own predicate — the CONTRACT interface's
// "actual test behind `role Taxpayer` membership". A case that also wants
// the core role fact asserts `has_role(p, us.irc.core::Taxpayer, …)`
// directly; this rule does not re-derive it to stay a complete test on its
// own terms.
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"taxpayer\" means any person subject to any internal revenue tax.")
rule PersonAssertedSubjectToTaxIsTaxpayer strict {
    for p: Person;
    when subject_to_internal_revenue_tax(p);
    then taxpayer(p);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"taxpayer\" means any person subject to any internal revenue tax.")
rule PersonWithLiabilityIsTaxpayer strict {
    for p: Person; for y: TaxableYear; for k: us.irc.core::TaxKind; for amt: Money;
    when us.irc.core::liability(p, y, k, amt);
    then taxpayer(p);
}

// --- (a)(17) §2516 divorce terminology substitution ------------------------
// A textual substitution instruction confined to the operation of §2516
// (gift tax — transfers under a divorce/separation instrument), owned by
// `estate-gift`, not this package. NON_NORMATIVE for this package: no
// freestanding predicate of Chapter 79 to compute — the instruction only
// tells §2516's OWNER how to read "wife"/"husband" in a divorced case. See
// `coverage/definitions.json` id `26/7701/17/u1`, classification
// NON_NORMATIVE (judgment call, noted in the final report).

// --- (a)(18) International organization ------------------------------------
// "Entitled to enjoy privileges, exemptions, and immunities as an
// international organization under the International Organizations
// Immunities Act (22 U.S.C. 288-288f)" is an executive-branch designation
// (Presidential Executive Order under 22 U.S.C. 288) external to Title 26;
// modeled as an empirical fact the case asserts (a designation list is not
// this package's data), with the institutional relation the actual §7701
// term.
pub relation designated_under_international_organizations_immunities_act(o: Organ) kind empirical {
    label en unofficial "the organization is designated under the International Organizations Immunities Act, 22 U.S.C. 288-288f (external dependency: the Act and the Presidential designation are outside Title 26)";
}
pub relation international_organization(o: Organ) kind institutional {
    label en official "the term \"international organization\" means a public international organization entitled to enjoy privileges, exemptions, and immunities as an international organization under the International Organizations Immunities Act";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"international organization\" means a public international organization entitled to enjoy privileges, exemptions, and immunities as an international organization under the International Organizations Immunities Act")
rule DesignatedOrganizationIsInternationalOrganization strict {
    for o: Organ;
    when designated_under_international_organizations_immunities_act(o);
    then international_organization(o);
}

// --- (a)(19) Domestic building and loan association ------------------------
// Full asset-composition test: an association qualifies if it is under
// State/Federal supervision, its business consists principally of
// acquiring savings and investing in loans, and AT LEAST 60% of its total
// assets (at the close of the taxable year) fall in the listed categories
// (subparagraphs (i)-(xi)). The 11 categories are not separately typed here
// (each would need its own asserted dollar amount); this package asks the
// case for the AGGREGATE amount that qualifies under (C)(i)-(xi) and the
// total assets, and computes the 60% test with integer arithmetic
// (qualifying * 100 >= total * 60) to avoid a Decimal division — the
// statute's own text sets no rounding rule for the percentage, so none is
// invented. The election in the last sentence of (C) (average vs.
// close-of-year assets) is exposed as a boolean the case chooses.
pub entity DomesticBuildingAndLoanAssociation : Association {
    label en unofficial "a domestic building and loan association, domestic savings and loan association, or Federal savings and loan association";
}
pub relation supervised_by_state_or_federal_authority(a: DomesticBuildingAndLoanAssociation) kind empirical {
    label en official "subject by law to supervision and examination by State or Federal authority having supervision over such associations";
}
pub relation business_is_acquiring_savings_and_investing_in_loans(a: DomesticBuildingAndLoanAssociation) kind empirical {
    label en official "the business of which consists principally of acquiring the savings of the public and investing in loans";
}
pub relation qualifying_asset_amount(a: DomesticBuildingAndLoanAssociation, amount: Money) kind empirical {
    label en official "the amount of the total assets of which (at the close of the taxable year) consists of [subparagraphs (i)-(xi)]";
}
pub relation total_asset_amount(a: DomesticBuildingAndLoanAssociation, amount: Money) kind empirical {
    label en unofficial "total assets of the association at the close of the taxable year (or, at the association's election, the average for the year)";
}
pub relation meets_sixty_percent_asset_test(a: DomesticBuildingAndLoanAssociation) kind institutional {
    label en official "at least 60 percent of the amount of the total assets of which (at the close of the taxable year) consists of—";
}
pub relation domestic_building_and_loan_association(a: DomesticBuildingAndLoanAssociation) kind institutional {
    label en official "the term \"domestic building and loan association\" means a domestic building and loan association, a domestic savings and loan association, and a Federal savings and loan association";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "at least 60 percent of the amount of the total assets of which (at the close of the taxable year) consists of")
rule SixtyPercentAssetTestByAmount strict {
    for a: DomesticBuildingAndLoanAssociation; for q: Money; for t: Money;
    when qualifying_asset_amount(a, q) and total_asset_amount(a, t) and q * 100 >= t * 60;
    then meets_sixty_percent_asset_test(a);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"domestic building and loan association\" means a domestic building and loan association, a domestic savings and loan association, and a Federal savings and loan association")
rule AllThreeConditionsMakeDomesticBuildingAndLoanAssociation strict {
    for a: DomesticBuildingAndLoanAssociation;
    when supervised_by_state_or_federal_authority(a)
        and business_is_acquiring_savings_and_investing_in_loans(a)
        and meets_sixty_percent_asset_test(a);
    then domestic_building_and_loan_association(a);
}

// --- (a)(20) full-time life insurance salesman treated as employee ---------
// Narrow scope gloss: for §79 (group-term life), §§104/105/106 (accident and
// health), subtitle A stock bonus/pension/profit-sharing/annuity plan
// provisions, and §125 cafeteria plans ONLY, a full-time life insurance
// salesman who is a statutory employee for chapter 21 (FICA, §3121(d)(3)(B))
// is treated as an "employee". Modeled as a scoped institutional fact rather
// than folding into `us.irc.core::role Employee` generally (the Code's
// general common-law "employee" test is untouched outside the named
// sections).
pub enum BenefitProvisionScope {
    GroupTermLifeInsuranceS79;
    AccidentAndHealthS104To106;
    StockBonusPensionProfitSharingOrAnnuityPlanSubtitleA;
    CafeteriaPlanS125;
    label en unofficial "the specific benefit provisions (a)(20) names";
}
pub relation full_time_life_insurance_salesman(p: Person) kind empirical {
    label en official "a full-time life insurance salesman";
}
pub relation considered_employee_for_chapter_21(p: Person) kind empirical {
    label en official "considered an employee for the purpose of chapter 21";
}
// Grounding fact for `benefit_scope` (§190 range-restriction: an enum-typed
// head variable still needs a positive premise binding it to the SPECIFIC
// value at issue in the case, not just its finite type). The case names
// which of the four named benefit provisions is actually in question.
pub relation benefit_provision_at_issue(benefit_scope: BenefitProvisionScope) kind empirical {
    label en unofficial "grounding fact: this benefit provision is the one at issue in the case";
}
pub relation treated_as_employee_for_benefit_provision(p: Person, benefit_scope: BenefitProvisionScope) kind institutional {
    label en official "the term \"employee\" shall include a full-time life insurance salesman who is considered an employee for the purpose of chapter 21";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "the term \"employee\" shall include a full-time life insurance salesman who is considered an employee for the purpose of chapter 21")
rule LifeInsuranceSalesmanTreatedAsEmployee strict {
    for p: Person; for benefit_scope: BenefitProvisionScope;
    when full_time_life_insurance_salesman(p) and considered_employee_for_chapter_21(p)
        and benefit_provision_at_issue(benefit_scope);
    then treated_as_employee_for_benefit_provision(p, benefit_scope);
}

// --- (a)(23) Taxable year; (a)(24) Fiscal year; (a)(25) Paid or incurred ---
// Core already carries the SHAPE (`TaxableYear`, `fiscal_year`, `short_year`
// relations, §441). (a)(23)'s own content beyond core's shape is the
// fractional-period sentence, exposed here as its own institutional fact so
// a scenario can show a short period IS a "taxable year" for title purposes
// without recomputing §443 itself (owned by `accounting`).
pub relation fractional_period_return_made(y: TaxableYear) kind empirical {
    label en official "the period for which such return is made, if a return is made for a fractional part of a year under the provisions of subtitle A or under regulations prescribed by the Secretary";
}
pub relation is_taxable_year_for_this_title(y: TaxableYear) kind institutional {
    label en official "the term \"taxable year\" means the calendar year, or the fiscal year ending during such calendar year, upon the basis of which the taxable income is computed under subtitle A";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"taxable year\" means the calendar year, or the fiscal year ending during such calendar year, upon the basis of which the taxable income is computed under subtitle A.")
rule CalendarOrFiscalYearIsTaxableYear strict {
    for y: TaxableYear;
    when us.irc.core::calendar_year_of(y, _) or us.irc.core::fiscal_year(y);
    then is_taxable_year_for_this_title(y);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "\"Taxable year\" means, in the case of a return made for a fractional part of a year under the provisions of subtitle A or under regulations prescribed by the Secretary, the period for which such return is made.")
rule FractionalPeriodReturnIsTaxableYear strict {
    for y: TaxableYear;
    when fractional_period_return_made(y);
    then is_taxable_year_for_this_title(y);
}
pub relation accounting_method_of(p: Person, y: TaxableYear) kind empirical {
    label en unofficial "the method of accounting upon the basis of which the person's taxable income is computed under subtitle A (for the paid-or-incurred/paid-or-accrued construction)";
}

// --- (a)(26) Trade or business ---------------------------------------------
pub relation performs_functions_of_public_office(p: Person) kind empirical {
    label en official "the performance of the functions of a public office";
}
pub relation trade_or_business(p: Person) kind institutional {
    label en official "the term \"trade or business\" includes the performance of the functions of a public office";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"trade or business\" includes the performance of the functions of a public office.")
rule PublicOfficeFunctionsAreTradeOrBusiness strict {
    for p: Person;
    when performs_functions_of_public_office(p);
    then trade_or_business(p);
}

// --- (a)(27) Tax Court -------------------------------------------------------
// `us.irc.core::TaxCourt` already names the forum; (a)(27) is the naming
// definition itself, exposed as a trivial institutional restatement so a
// rule that reads "the Tax Court" by the statutory term resolves to core's
// constant without redeclaring it.
pub relation is_the_tax_court(o: Organ) kind institutional {
    label en official "the term \"Tax Court\" means the United States Tax Court";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"Tax Court\" means the United States Tax Court.")
assert is_the_tax_court(TaxCourt);

// --- (a)(28) Same meaning across subtitles ----------------------------------
// General interpretive canon of construction: a term used in one subtitle,
// applied in connection with another subtitle's provisions, keeps the SAME
// meaning. It sets no independent predicate a case could establish or deny
// — it constrains how THIS FORMALIZATION reads a cross-subtitle term, not a
// fact about a person or transaction. NON_NORMATIVE for this package (see
// `coverage/definitions.json` id `26/7701/28/u1`).

// --- (a)(29) "Internal Revenue Code of 1986" / "of 1939" --------------------
// Names the codification itself; `us.irc.core::source IRC_TITLE26` already
// carries this identity for `[metadata].primarySource`. No classification
// test a case could apply. NON_NORMATIVE (id `26/7701/29/u1`).

// --- (a)(30) United States person; (a)(31) foreign estate / foreign trust ---
pub relation citizen_of_united_states(p: Person) kind empirical {
    label en official "a citizen … of the United States";
}
pub relation resident_of_united_states(p: Person) kind empirical {
    label en unofficial "a resident of the United States (an individual meeting (a)(30)(A); see `residency.law` for the alien residency test of (b))";
}
pub relation court_within_us_has_primary_supervision(t: Trust) kind empirical {
    label en official "a court within the United States is able to exercise primary supervision over the administration of the trust";
}
pub relation us_persons_control_all_substantial_decisions(t: Trust) kind empirical {
    label en official "one or more United States persons have the authority to control all substantial decisions of the trust";
}
pub relation income_from_us_sources_not_effectively_connected_excluded_from_gross_income(e: Estate) kind empirical {
    label en official "an estate the income of which, from sources without the United States which is not effectively connected with the conduct of a trade or business within the United States, is not includible in gross income under subtitle A";
}
pub relation united_states_person(p: Person) kind institutional {
    label en official "the term \"United States person\" means—(A) a citizen or resident of the United States, (B) a domestic partnership, (C) a domestic corporation, (D) any estate (other than a foreign estate), and (E) any trust [meeting the two conditions]";
}
pub relation foreign_estate(e: Estate) kind institutional {
    label en official "the term \"foreign estate\" means an estate the income of which, from sources without the United States which is not effectively connected with the conduct of a trade or business within the United States, is not includible in gross income under subtitle A";
}
pub relation foreign_trust(t: Trust) kind institutional {
    label en official "the term \"foreign trust\" means any trust other than a trust described in subparagraph (E) of paragraph (30)";
}
pub relation domestic_trust_under_30e(t: Trust) kind institutional {
    label en official "(E) any trust if (i) a court within the United States is able to exercise primary supervision over the administration of the trust, and (ii) one or more United States persons have the authority to control all substantial decisions of the trust";
}

@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "(A) a citizen or resident of the United States,")
rule CitizenIsUnitedStatesPerson strict {
    for p: Person;
    when citizen_of_united_states(p);
    then united_states_person(p);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "(A) a citizen or resident of the United States,")
rule ResidentIsUnitedStatesPerson strict {
    for p: Person;
    when resident_of_united_states(p);
    then united_states_person(p);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "(B) a domestic partnership,")
rule DomesticPartnershipIsUnitedStatesPerson strict {
    for p: Partnership;
    when domestic(p);
    then united_states_person(p);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "(C) a domestic corporation,")
rule DomesticCorporationIsUnitedStatesPerson strict {
    for c: Corporation;
    when domestic(c);
    then united_states_person(c);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "(D) any estate (other than a foreign estate, within the meaning of paragraph (31)), and")
// Grounding fact: the compiler's range-restriction check (§190) requires a
// POSITIVE premise binding `e`; `not_known(foreign_estate(e))` alone does
// not bind it (an infinite-domain guard, not a finite extension). A case
// that wants to test an estate's United-States-person status names it via
// this marker, exactly as it would need to name the estate through SOME
// fact to bring it into evidence in the first place.
pub relation estate_presented_for_us_person_classification(e: Estate) kind empirical {
    label en unofficial "grounding fact: the estate is presented in the case for a §7701(a)(30)/(31) classification";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "(D) any estate (other than a foreign estate, within the meaning of paragraph (31)), and")
rule NonForeignEstateIsUnitedStatesPerson strict {
    for e: Estate;
    when estate_presented_for_us_person_classification(e) and not_known(foreign_estate(e));
    then united_states_person(e);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "a court within the United States is able to exercise primary supervision over the administration of the trust")
rule TrustMeetingBothConditionsIsDomesticUnder30E strict {
    for t: Trust;
    when court_within_us_has_primary_supervision(t) and us_persons_control_all_substantial_decisions(t);
    then domestic_trust_under_30e(t);
}
// Split into two single-conclusion rules (a `then { A; B; }` block is
// grammatically legal but outside the L0 lowering slice for a norm
// template — LDC-E1302 — so the whole rule would silently produce no CLIR
// node; two ordinary rules over the same premise lower correctly).
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "(i) a court within the United States is able to exercise primary supervision over the administration of the trust")
rule TrustMeetingBothConditionsIsUnitedStatesPerson strict {
    for t: Trust;
    when court_within_us_has_primary_supervision(t) and us_persons_control_all_substantial_decisions(t);
    then united_states_person(t);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"foreign estate\" means an estate the income of which, from sources without the United States which is not effectively connected with the conduct of a trade or business within the United States, is not includible in gross income under subtitle A.")
rule EstateMeetingIncomeTestIsForeignEstate strict {
    for e: Estate;
    when income_from_us_sources_not_effectively_connected_excluded_from_gross_income(e);
    then foreign_estate(e);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"foreign trust\" means any trust other than a trust described in subparagraph (E) of paragraph (30).")
// Same grounding need as the estate marker above.
pub relation trust_presented_for_us_person_classification(t: Trust) kind empirical {
    label en unofficial "grounding fact: the trust is presented in the case for a §7701(a)(30)/(31) classification";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"foreign trust\" means any trust other than a trust described in subparagraph (E) of paragraph (30).")
rule TrustNotMeetingBothConditionsIsForeignTrust strict {
    for t: Trust;
    when trust_presented_for_us_person_classification(t) and not_known(domestic_trust_under_30e(t));
    then foreign_trust(t);
}

// --- (a)(42)-(45) Substituted/transferred/exchanged basis property; nonrecognition transaction ---
pub entity Property { label en unofficial "an item of property under subtitle A basis rules"; }
pub relation basis_determined_under_carryover_transferor_provision(pr: Property) kind empirical {
    label en official "property having a basis determined under any provision of subtitle A (or under any corresponding provision of prior income tax law) providing that the basis shall be determined by reference to the basis in the hands of the transferor, donor, or grantor";
}
pub relation basis_determined_under_exchange_or_involuntary_conversion_provision(pr: Property) kind empirical {
    label en official "property having a basis determined under any provision of subtitle A (or under any corresponding provision of prior income tax law) providing that the basis shall be determined by reference to other property held at any time by the person for whom the basis is to be determined";
}
pub relation gain_or_loss_not_recognized_in_whole_or_part(pr: Property) kind empirical {
    label en official "any disposition of property in a transaction in which gain or loss is not recognized in whole or in part for purposes of subtitle A";
}
pub relation transferred_basis_property(pr: Property) kind institutional {
    label en official "the term \"transferred basis property\" means property having a basis determined under any provision of subtitle A (or under any corresponding provision of prior income tax law) providing that the basis shall be determined in whole or in part by reference to the basis in the hands of the donor, grantor, or other transferor.";
}
pub relation exchanged_basis_property(pr: Property) kind institutional {
    label en official "the term \"exchanged basis property\" means property having a basis determined under any provision of subtitle A (or under any corresponding provision of prior income tax law) providing that the basis shall be determined in whole or in part by reference to other property held at any time by the person for whom the basis is to be determined.";
}
pub relation substituted_basis_property(pr: Property) kind institutional {
    label en official "the term \"substituted basis property\" means property which is—(A) transferred basis property, or (B) exchanged basis property";
}
pub relation nonrecognition_transaction(pr: Property) kind institutional {
    label en official "the term \"nonrecognition transaction\" means any disposition of property in a transaction in which gain or loss is not recognized in whole or in part for purposes of subtitle A";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"transferred basis property\" means property having a basis determined under any provision of subtitle A (or under any corresponding provision of prior income tax law) providing that the basis shall be determined in whole or in part by reference to the basis in the hands of the donor, grantor, or other transferor.")
rule CarryoverBasisPropertyIsTransferredBasisProperty strict {
    for pr: Property;
    when basis_determined_under_carryover_transferor_provision(pr);
    then transferred_basis_property(pr);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"substituted basis property\" means property which is—")
rule CarryoverBasisPropertyIsSubstitutedBasisProperty strict {
    for pr: Property;
    when basis_determined_under_carryover_transferor_provision(pr);
    then substituted_basis_property(pr);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"exchanged basis property\" means property having a basis determined under any provision of subtitle A (or under any corresponding provision of prior income tax law) providing that the basis shall be determined in whole or in part by reference to other property held at any time by the person for whom the basis is to be determined.")
rule ExchangeBasisPropertyIsExchangedBasisProperty strict {
    for pr: Property;
    when basis_determined_under_exchange_or_involuntary_conversion_provision(pr);
    then exchanged_basis_property(pr);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"substituted basis property\" means property which is—")
rule ExchangeBasisPropertyIsSubstitutedBasisProperty strict {
    for pr: Property;
    when basis_determined_under_exchange_or_involuntary_conversion_provision(pr);
    then substituted_basis_property(pr);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"nonrecognition transaction\" means any disposition of property in a transaction in which gain or loss is not recognized in whole or in part for purposes of subtitle A.")
rule UnrecognizedGainOrLossDispositionIsNonrecognitionTransaction strict {
    for pr: Property;
    when gain_or_loss_not_recognized_in_whole_or_part(pr);
    then nonrecognition_transaction(pr);
}

// --- (a)(46) Employee representatives (collective bargaining) --------------
pub entity Agreement { label en unofficial "a purported collective bargaining agreement"; }
pub relation more_than_half_of_representative_members_are_owners_officers_or_executives(rep: Person) kind empirical {
    label en official "any organization more than one-half of the members of which are employees who are owners, officers, or executives of the employer";
}
pub relation is_bona_fide_agreement_between_bona_fide_representatives(a: Agreement) kind empirical {
    label en official "a bona fide agreement between bona fide employee representatives and 1 or more employers";
}
pub relation counts_as_employee_representative(rep: Person) kind institutional {
    label en official "the term \"employee representatives\" shall not include any organization more than one-half of the members of which are employees who are owners, officers, or executives of the employer";
}
pub relation collective_bargaining_agreement(a: Agreement) kind institutional {
    label en official "an agreement shall not be treated as a collective bargaining agreement unless it is a bona fide agreement between bona fide employee representatives and 1 or more employers";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "the term \"employee representatives\" shall not include any organization more than one-half of the members of which are employees who are owners, officers, or executives of the employer")
pub relation proposed_as_employee_representative(rep: Person) kind empirical {
    label en unofficial "grounding fact: the organization/person is put forward in the case as the employee representative under a collective bargaining agreement";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "the term \"employee representatives\" shall not include any organization more than one-half of the members of which are employees who are owners, officers, or executives of the employer")
rule RepresentativeNotMajorityOwnersOfficersExecutivesCounts strict {
    for rep: Person;
    when proposed_as_employee_representative(rep)
        and not_known(more_than_half_of_representative_members_are_owners_officers_or_executives(rep));
    then counts_as_employee_representative(rep);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "An agreement shall not be treated as a collective bargaining agreement unless it is a bona fide agreement between bona fide employee representatives and 1 or more employers.")
rule BonaFideAgreementIsCollectiveBargainingAgreement strict {
    for a: Agreement;
    when is_bona_fide_agreement_between_bona_fide_representatives(a);
    then collective_bargaining_agreement(a);
}
