// §7701(a) — stage 2: the paragraphs stage 1 (classifications.law) left open:
// (15) military or naval forces / Armed Forces, (16) withholding agent,
// (21) levy, (22) Attorney General, (32) cooperative bank, (33) regulated
// public utility, (35) enrolled actuary, (36) tax return preparer, (37)
// individual retirement plan, (38) joint return, (39) residence of citizens
// and residents abroad, (40) Indian tribal government, (41) TIN, (48)
// highway vehicle limits, (49) qualified blood collector organization,
// (50) citizenship not ceased before the §877A(g)(4) date. Paragraph (5)
// (foreign corporation or partnership) is the stage 1 rule
// `ForeignCorporationOrPartnershipByExclusion` (classifications.law).
//
// Anchor: the whole-section fragment `IRC_S7701` with quote anchors
// (DECISION-0358). Every relation is `pub`: this is shared vocabulary.
// Deontic content of these paragraphs: only (40)(B) is addressed to the
// Secretary (a limit on what a determination may grant) and is modelled as a
// prohibition; the rest are definitions or scope rules and carry no
// duty/power/liberty (there is no conduct they command or permit).

language "law.core" version "0.2";
package us.irc.definitions version "0.1.1";
namespace "urn:us:irc:definitions:clir";

use self::{
    DomesticBuildingAndLoanAssociation,
    IRC_S7701,
    Individual,
    Organ,
    Person,
    Secretary,
    TaxableYear,
    business_is_acquiring_savings_and_investing_in_loans,
    each_lease_term_more_than_twenty_years_for_g,
    gross_income_from_a_through_f_including_deemed,
    meets_sixty_percent_asset_test,
    utility_source_income_for_eighty_percent_test,
};

// --- (15) Military or naval forces; Armed Forces of the United States ------
pub entity UniformedServiceComponent { label en unofficial "a component of the uniformed services (regular or reserve), or the Coast Guard"; }
pub relation is_regular_or_reserve_component_of_uniformed_services(c: UniformedServiceComponent) kind empirical {
    label en official "all regular and reserve components of the uniformed services";
}
pub relation subject_to_jurisdiction_of_defense_or_military_department_secretary(c: UniformedServiceComponent) kind empirical {
    label en official "subject to the jurisdiction of the Secretary of Defense, the Secretary of the Army, the Secretary of the Navy, or the Secretary of the Air Force";
}
pub relation is_the_coast_guard(c: UniformedServiceComponent) kind empirical {
    label en official "each term also includes the Coast Guard";
}
pub relation component_of_armed_forces_of_united_states(c: UniformedServiceComponent) kind institutional {
    label en official "the term \"military or naval forces of the United States\" and the term \"Armed Forces of the United States\" each includes all regular and reserve components of the uniformed services which are subject to the jurisdiction of the Secretary of Defense, the Secretary of the Army, the Secretary of the Navy, or the Secretary of the Air Force, and each term also includes the Coast Guard";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "each includes all regular and reserve components of the uniformed services which are subject to the jurisdiction of the Secretary of Defense, the Secretary of the Army, the Secretary of the Navy, or the Secretary of the Air Force")
rule UniformedComponentUnderDefenseJurisdictionIsArmedForces strict {
    for c: UniformedServiceComponent;
    when is_regular_or_reserve_component_of_uniformed_services(c) and subject_to_jurisdiction_of_defense_or_military_department_secretary(c);
    then component_of_armed_forces_of_united_states(c);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "and each term also includes the Coast Guard")
rule CoastGuardIsArmedForces strict {
    for c: UniformedServiceComponent;
    when is_the_coast_guard(c);
    then component_of_armed_forces_of_united_states(c);
}
pub relation is_commissioned_officer_in(p: Individual, c: UniformedServiceComponent) kind empirical {
    label en official "commissioned officers";
}
pub relation is_below_commissioned_grade_in(p: Individual, c: UniformedServiceComponent) kind empirical {
    label en official "personnel below the grade of commissioned officers";
}
pub relation member_of_armed_forces_of_united_states(p: Individual, c: UniformedServiceComponent) kind institutional {
    label en official "the members of such forces include commissioned officers and personnel below the grade of commissioned officers in such forces";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The members of such forces include commissioned officers and personnel below the grade of commissioned officers in such forces.")
rule CommissionedOfficerOfArmedForcesComponentIsMember strict {
    for p: Individual; for c: UniformedServiceComponent;
    when component_of_armed_forces_of_united_states(c) and is_commissioned_officer_in(p, c);
    then member_of_armed_forces_of_united_states(p, c);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The members of such forces include commissioned officers and personnel below the grade of commissioned officers in such forces.")
rule PersonnelBelowCommissionedGradeIsMember strict {
    for p: Individual; for c: UniformedServiceComponent;
    when component_of_armed_forces_of_united_states(c) and is_below_commissioned_grade_in(p, c);
    then member_of_armed_forces_of_united_states(p, c);
}

// --- (16) Withholding agent -------------------------------------------------
pub relation required_to_deduct_and_withhold_under_1441_1442_1443_or_1461(p: Person) kind empirical {
    label en official "any person required to deduct and withhold any tax under the provisions of section 1441, 1442, 1443, or 1461";
}
pub relation withholding_agent(p: Person) kind institutional {
    label en official "the term \"withholding agent\" means any person required to deduct and withhold any tax under the provisions of section 1441, 1442, 1443, or 1461";
}
@source(IRC_S7701, relation = formalizes, coverage = exact, quote = "The term \"withholding agent\" means any person required to deduct and withhold any tax under the provisions of section 1441, 1442, 1443, or 1461.")
rule PersonRequiredToWithholdIsWithholdingAgent strict {
    for p: Person;
    when required_to_deduct_and_withhold_under_1441_1442_1443_or_1461(p);
    then withholding_agent(p);
}

// --- (21) Levy ----------------------------------------------------------------
pub relation exercised_through_power_of_distraint_and_seizure_by_any_means(l: us.irc.core::Levy) kind empirical {
    label en official "the power of distraint and seizure by any means";
}
pub relation is_levy_within_meaning_of_title(l: us.irc.core::Levy) kind institutional {
    label en official "the term \"levy\" includes the power of distraint and seizure by any means";
}
@source(IRC_S7701, relation = formalizes, coverage = exact, quote = "The term \"levy\" includes the power of distraint and seizure by any means.")
rule DistraintAndSeizureByAnyMeansIsLevy strict {
    for l: us.irc.core::Levy;
    when exercised_through_power_of_distraint_and_seizure_by_any_means(l);
    then is_levy_within_meaning_of_title(l);
}

// --- (22) Attorney General --------------------------------------------------
pub const AttorneyGeneral: Organ = entity_ref("urn:us:irc:definitions:clir#attorney-general") {
    label en official "the Attorney General of the United States";
}

// --- (32) Cooperative bank ----------------------------------------------------------------
// "(B) meets the requirements of subparagraphs (B) and (C) of paragraph (19)
// ... any reference to an association or to a domestic building and loan
// association contained in paragraph (19) shall be deemed to be a reference to
// such institution": the candidate is a subtype of the (19) entity, so the
// (19)(B) business test and the (19)(C) 60 percent asset test
// (classifications.law) apply to it unchanged.
pub entity CooperativeBankCandidate : DomesticBuildingAndLoanAssociation {
    label en unofficial "an institution presented as a possible cooperative bank (the paragraph (19) tests apply to it as if it were the association named there)";
}
pub relation without_capital_stock_organized_and_operated_for_mutual_purposes_and_without_profit(b: CooperativeBankCandidate) kind empirical {
    label en official "an institution without capital stock organized and operated for mutual purposes and without profit";
}
pub relation cooperative_bank_supervised_by_state_or_federal_authority(b: CooperativeBankCandidate) kind empirical {
    label en official "is subject by law to supervision and examination by State or Federal authority having supervision over such institutions";
}
pub relation cooperative_bank(b: CooperativeBankCandidate) kind institutional {
    label en official "the term \"cooperative bank\" means an institution without capital stock organized and operated for mutual purposes and without profit, which— (A) is subject by law to supervision and examination by State or Federal authority having supervision over such institutions, and (B) meets the requirements of subparagraphs (B) and (C) of paragraph (19)";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"cooperative bank\" means an institution without capital stock organized and operated for mutual purposes and without profit, which—")
rule InstitutionMeetingBothLimbsIsCooperativeBank strict {
    for b: CooperativeBankCandidate;
    when without_capital_stock_organized_and_operated_for_mutual_purposes_and_without_profit(b)
        and cooperative_bank_supervised_by_state_or_federal_authority(b)
        and business_is_acquiring_savings_and_investing_in_loans(b)
        and meets_sixty_percent_asset_test(b);
    then cooperative_bank(b);
}

// --- (33) Regulated public utility -------------------------------------------
// The definition is a disjunction of subparagraphs (A)-(H) plus a limiting
// paragraph (an 80 percent gross-income test for the (A)-(F) corporations).
// Each subparagraph's activity and its jurisdictional condition are separate
// asserted facts; the 80 percent test is the integer comparison
// `derived * 100 >= total * 80` (the text names no rounding, so none is
// invented). The last-sentence Secretary satisfaction rule (unregulated rates
// substantially as favourable) is an evaluative channel (DECISION-0194):
// `external judgment relation` with authority Secretary. The (33)(A) rate
// approval by a State, a foreign country etc. is one case fact.
pub entity UtilityCandidate : Corporation { label en unofficial "a corporation presented as a possible regulated public utility"; }
pub relation furnishes_or_sells_electric_gas_water_or_sewerage_service(u: UtilityCandidate) kind empirical {
    label en official "electric energy, gas, water, or sewerage disposal services";
}
pub relation furnishes_local_electric_railway_trolley_or_bus_transportation(u: UtilityCandidate) kind empirical {
    label en official "transportation on an intrastate, suburban, municipal, or interurban electric railroad, on an intrastate, municipal, or suburban trackless trolley system, or on a municipal or suburban bus system";
}
pub relation furnishes_motor_vehicle_transportation(u: UtilityCandidate) kind empirical {
    label en official "transportation by motor vehicle";
}
pub relation rates_established_or_approved_by_public_authority(u: UtilityCandidate) kind empirical {
    label en official "the rates for such furnishing or sale have been established or approved by a State or political subdivision thereof, by an agency or instrumentality of the United States, by a public service or public utility commission or other similar body of the District of Columbia or of any State or political subdivision thereof, or by a foreign country or an agency or instrumentality or political subdivision thereof";
}
pub relation common_carrier_of_gas_by_pipe_line_subject_to_ferc(u: UtilityCandidate) kind empirical {
    label en official "a common carrier in the furnishing or sale of transportation of gas by pipe line, if subject to the jurisdiction of the Federal Energy Regulatory Commission";
}
pub relation common_carrier_by_railroad_subject_to_stb(u: UtilityCandidate) kind empirical {
    label en official "a common carrier in the furnishing or sale of transportation by railroad, if subject to the jurisdiction of the Surface Transportation Board";
}
pub relation common_carrier_of_oil_by_pipe_line_under_ferc_or_commission_rates(u: UtilityCandidate) kind empirical {
    label en official "a common carrier in the furnishing or sale of transportation of oil or other petroleum products (including shale oil) by pipe line, if subject to the jurisdiction of the Federal Energy Regulatory Commission or if the rates are subject to the jurisdiction of a public service or public utility commission or other similar body of the District of Columbia or of any State";
}
pub relation furnishes_telephone_or_telegraph_service(u: UtilityCandidate) kind empirical {
    label en official "the furnishing or sale of telephone or telegraph service";
}
pub relation common_carrier_by_air_subject_to_secretary_of_transportation(u: UtilityCandidate) kind empirical {
    label en official "the furnishing or sale of transportation as a common carrier by air, subject to the jurisdiction of the Secretary of Transportation";
}
pub relation water_carrier_subject_to_title_49_subchapter_ii_of_chapter_135(u: UtilityCandidate) kind empirical {
    label en official "the furnishing or sale of transportation by a water carrier subject to jurisdiction under subchapter II of chapter 135 of title 49";
}
pub relation described_in_utility_subparagraphs_a_through_f(u: UtilityCandidate) kind institutional {
    label en official "a corporation described in subparagraphs (A) through (F)";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "if the rates for such furnishing or sale, as the case may be, have been established or approved by a State or political subdivision thereof")
rule EnergyWaterOrSewerageUtilityWithApprovedRatesIsDescribed strict {
    for u: UtilityCandidate;
    when furnishes_or_sells_electric_gas_water_or_sewerage_service(u) and rates_established_or_approved_by_public_authority(u);
    then described_in_utility_subparagraphs_a_through_f(u);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "if the rates for such furnishing or sale, as the case may be, have been established or approved by a State or political subdivision thereof")
rule LocalTransitUtilityWithApprovedRatesIsDescribed strict {
    for u: UtilityCandidate;
    when furnishes_local_electric_railway_trolley_or_bus_transportation(u) and rates_established_or_approved_by_public_authority(u);
    then described_in_utility_subparagraphs_a_through_f(u);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "if the rates for such furnishing or sale, as the case may be, have been established or approved by a State or political subdivision thereof")
rule MotorVehicleUtilityWithApprovedRatesIsDescribed strict {
    for u: UtilityCandidate;
    when furnishes_motor_vehicle_transportation(u) and rates_established_or_approved_by_public_authority(u);
    then described_in_utility_subparagraphs_a_through_f(u);
}
@source(IRC_S7701, relation = formalizes, coverage = exact, quote = "(B) A corporation engaged as a common carrier in the furnishing or sale of transportation of gas by pipe line, if subject to the jurisdiction of the Federal Energy Regulatory Commission.")
rule GasPipeLineCommonCarrierUnderFercIsDescribed strict {
    for u: UtilityCandidate;
    when common_carrier_of_gas_by_pipe_line_subject_to_ferc(u);
    then described_in_utility_subparagraphs_a_through_f(u);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "(C) A corporation engaged as a common carrier (i) in the furnishing or sale of transportation by railroad, if subject to the jurisdiction of the Surface Transportation Board")
rule RailroadCommonCarrierUnderStbIsDescribed strict {
    for u: UtilityCandidate;
    when common_carrier_by_railroad_subject_to_stb(u);
    then described_in_utility_subparagraphs_a_through_f(u);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "(ii) in the furnishing or sale of transportation of oil or other petroleum products (including shale oil) by pipe line")
rule OilPipeLineCommonCarrierIsDescribed strict {
    for u: UtilityCandidate;
    when common_carrier_of_oil_by_pipe_line_under_ferc_or_commission_rates(u);
    then described_in_utility_subparagraphs_a_through_f(u);
}
@source(IRC_S7701, relation = formalizes, coverage = exact, quote = "(D) A corporation engaged in the furnishing or sale of telephone or telegraph service, if the rates for such furnishing or sale meet the requirements of subparagraph (A).")
rule TelephoneOrTelegraphUtilityWithApprovedRatesIsDescribed strict {
    for u: UtilityCandidate;
    when furnishes_telephone_or_telegraph_service(u) and rates_established_or_approved_by_public_authority(u);
    then described_in_utility_subparagraphs_a_through_f(u);
}
@source(IRC_S7701, relation = formalizes, coverage = exact, quote = "(E) A corporation engaged in the furnishing or sale of transportation as a common carrier by air, subject to the jurisdiction of the Secretary of Transportation.")
rule AirCommonCarrierUnderTransportationSecretaryIsDescribed strict {
    for u: UtilityCandidate;
    when common_carrier_by_air_subject_to_secretary_of_transportation(u);
    then described_in_utility_subparagraphs_a_through_f(u);
}
@source(IRC_S7701, relation = formalizes, coverage = exact, quote = "(F) A corporation engaged in the furnishing or sale of transportation by a water carrier subject to jurisdiction under subchapter II of chapter 135 of title 49.")
rule WaterCarrierUnderTitle49IsDescribed strict {
    for u: UtilityCandidate;
    when water_carrier_subject_to_title_49_subchapter_ii_of_chapter_135(u);
    then described_in_utility_subparagraphs_a_through_f(u);
}

pub relation gross_income_for_utility_test(u: UtilityCandidate, y: TaxableYear, amount: Money) kind empirical {
    label en official "gross income (computed without regard to dividends and capital gains and losses) for the taxable year";
}
pub relation gross_income_from_utility_sources_a_through_f(u: UtilityCandidate, y: TaxableYear, amount: Money) kind empirical {
    label en official "gross income derived from sources described in subparagraphs (A) through (F), inclusive";
}
pub relation utility_eighty_percent_income_test_met(u: UtilityCandidate, y: TaxableYear) kind institutional {
    label en official "80 percent or more of its gross income (computed without regard to dividends and capital gains and losses) for the taxable year is derived from sources described in subparagraphs (A) through (F), inclusive";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "unless 80 percent or more of its gross income (computed without regard to dividends and capital gains and losses) for the taxable year is derived from sources described in subparagraphs (A) through (F), inclusive")
rule UtilityEightyPercentIncomeTestByAmount strict {
    for u: UtilityCandidate; for y: TaxableYear; for d: Money; for t: Money;
    when utility_source_income_for_eighty_percent_test(u, y, d) and gross_income_for_utility_test(u, y, t) and d * 100 >= t * 80;
    then utility_eighty_percent_income_test_met(u, y);
}
// Last sentence of the limiting paragraph: unregulated-rate revenue counts as
// (A)/(D)-source income when the Secretary is satisfied on the two clauses.
external judgment relation SecretarySatisfiedUnregulatedRatesAsFavourableAsRegulated(u: UtilityCandidate, y: TaxableYear) {
    authority Secretary;
    label en official "the taxpayer establishes to the satisfaction of the Secretary that (i) its revenue from regulated rates and its revenue derived from unregulated rates are derived from the operation of a single interconnected and coordinated system or from the operation of more than one such system, and (ii) the unregulated rates have been and are substantially as favorable to users and consumers as are the regulated rates";
}
pub relation regulated_public_utility(u: UtilityCandidate, y: TaxableYear) kind institutional {
    label en official "the term \"regulated public utility\" means a corporation described in subparagraphs (A) through (F) that meets the 80 percent test of the limiting paragraph, or a rail carrier described in (G), or a common parent corporation described in (H)";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"regulated public utility\" does not (except as provided in subparagraphs (G) and (H)) include a corporation described in subparagraphs (A) through (F), inclusive, unless 80 percent or more of its gross income")
rule DescribedCorporationMeetingEightyPercentIsRegulatedPublicUtility strict {
    for u: UtilityCandidate; for y: TaxableYear;
    when described_in_utility_subparagraphs_a_through_f(u) and utility_eighty_percent_income_test_met(u, y);
    then regulated_public_utility(u, y);
}
// (G) and (H): the qualifying rail-carrier conditions.
pub relation rail_carrier_subject_to_part_a_of_subtitle_iv_of_title_49(u: UtilityCandidate) kind empirical {
    label en official "a rail carrier subject to part A of subtitle IV of title 49";
}
pub relation substantially_all_railroad_properties_leased_before_1954(u: UtilityCandidate) kind empirical {
    label en official "substantially all of its railroad properties have been leased to another such railroad corporation or corporations by an agreement or agreements entered into before January 1, 1954";
}
pub relation each_lease_term_more_than_twenty_years(u: UtilityCandidate) kind empirical {
    label en official "each lease is for a term of more than 20 years";
}
pub relation gross_income_from_leases_and_sources_a_through_f(u: UtilityCandidate, y: TaxableYear, amount: Money) kind empirical {
    label en official "gross income (computed without regard to dividends and capital gains and losses) for the taxable year derived from such leases and from sources described in subparagraphs (A) through (F), inclusive";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "(G) A rail carrier subject to part A of subtitle IV of title 49, if (i) substantially all of its railroad properties have been leased to another such railroad corporation or corporations by an agreement or agreements entered into before January 1, 1954, (ii) each lease is for a term of more than 20 years, and (iii) at least 80 percent or more of its gross income")
rule LeasedRailCarrierMeetingEightyPercentIsRegulatedPublicUtility strict {
    for u: UtilityCandidate; for y: TaxableYear; for d: Money; for t: Money;
    when rail_carrier_subject_to_part_a_of_subtitle_iv_of_title_49(u) and substantially_all_railroad_properties_leased_before_1954(u)
        and each_lease_term_more_than_twenty_years_for_g(u)
        and gross_income_from_leases_and_sources_a_through_f(u, y, d) and gross_income_for_utility_test(u, y, t) and d * 100 >= t * 80;
    then regulated_public_utility(u, y);
}
pub relation common_parent_railroad_common_carrier_under_part_a(u: UtilityCandidate) kind empirical {
    label en official "a common parent corporation which is a common carrier by railroad subject to part A of subtitle IV of title 49";
}
pub relation gross_income_derived_directly_or_indirectly_from_sources_a_through_f(u: UtilityCandidate, y: TaxableYear, amount: Money) kind empirical {
    label en official "gross income (computed without regard to capital gains or losses) derived directly or indirectly from sources described in subparagraphs (A) through (F), inclusive (dividends and interest, and income from (G) leases, received from a regulated public utility counting as so derived)";
}
pub relation gross_income_for_common_parent_test(u: UtilityCandidate, y: TaxableYear, amount: Money) kind empirical {
    label en official "gross income (computed without regard to capital gains or losses)";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "(H) A common parent corporation which is a common carrier by railroad subject to part A of subtitle IV of title 49 if at least 80 percent of its gross income (computed without regard to capital gains or losses) is derived directly or indirectly from sources described in subparagraphs (A) through (F), inclusive.")
rule CommonParentRailroadMeetingEightyPercentIsRegulatedPublicUtility strict {
    for u: UtilityCandidate; for y: TaxableYear; for d: Money; for t: Money;
    when common_parent_railroad_common_carrier_under_part_a(u)
        and gross_income_from_a_through_f_including_deemed(u, y, d) and gross_income_for_common_parent_test(u, y, t) and d * 100 >= t * 80;
    then regulated_public_utility(u, y);
}

// --- (35) Enrolled actuary ----------------------------------------------------
pub relation enrolled_by_joint_board_for_enrollment_of_actuaries(p: Person) kind empirical {
    label en official "a person who is enrolled by the Joint Board for the Enrollment of Actuaries established under subtitle C of the title III of the Employee Retirement Income Security Act of 1974";
}
pub relation enrolled_actuary(p: Person) kind institutional {
    label en official "the term \"enrolled actuary\" means a person who is enrolled by the Joint Board for the Enrollment of Actuaries";
}
@source(IRC_S7701, relation = formalizes, coverage = exact, quote = "The term \"enrolled actuary\" means a person who is enrolled by the Joint Board for the Enrollment of Actuaries established under subtitle C of the title III of the Employee Retirement Income Security Act of 1974.")
rule EnrolledByJointBoardIsEnrolledActuary strict {
    for p: Person;
    when enrolled_by_joint_board_for_enrollment_of_actuaries(p);
    then enrolled_actuary(p);
}

// --- (36) Tax return preparer -------------------------------------------------
pub relation prepares_for_compensation(p: Person, r: us.irc.core::Return) kind empirical {
    label en official "any person who prepares for compensation ... any return of tax imposed by this title or any claim for refund of tax imposed by this title";
}
pub relation employs_persons_to_prepare_for_compensation(p: Person, r: us.irc.core::Return) kind empirical {
    label en official "or who employs one or more persons to prepare for compensation";
}
pub relation return_or_refund_claim_is_under_this_title(r: us.irc.core::Return) kind empirical {
    label en official "any return of tax imposed by this title or any claim for refund of tax imposed by this title";
}
pub relation prepares_substantial_portion_for_compensation(p: Person, r: us.irc.core::Return) kind empirical {
    label en official "the preparation of a substantial portion of a return or claim for refund";
}
pub relation furnishes_only_typing_reproducing_or_mechanical_assistance(p: Person, r: us.irc.core::Return) kind empirical {
    label en official "furnishes typing, reproducing, or other mechanical assistance";
}
pub relation prepares_return_of_regular_and_continuous_employer_or_its_staff(p: Person, r: us.irc.core::Return) kind empirical {
    label en official "prepares a return or claim for refund of the employer (or of an officer or employee of the employer) by whom he is regularly and continuously employed";
}
pub relation prepares_return_as_fiduciary(p: Person, r: us.irc.core::Return) kind empirical {
    label en official "prepares as a fiduciary a return or claim for refund for any person";
}
pub relation prepares_refund_claim_in_response_to_deficiency_notice_or_audit_waiver(p: Person, r: us.irc.core::Return) kind empirical {
    label en official "prepares a claim for refund for a taxpayer in response to any notice of deficiency issued to such taxpayer or in response to any waiver of restriction after the commencement of an audit of such taxpayer or another taxpayer if a determination in such audit of such other taxpayer directly or indirectly affects the tax liability of such taxpayer";
}
pub relation excepted_from_tax_return_preparer_status(p: Person, r: us.irc.core::Return) kind institutional {
    label en official "a person shall not be a \"tax return preparer\" merely because such person furnishes mechanical assistance, prepares a return of the employer by whom he is regularly and continuously employed, prepares as a fiduciary, or prepares a claim for refund in response to a notice of deficiency or waiver of restriction";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "(i) furnishes typing, reproducing, or other mechanical assistance,")
rule MechanicalAssistanceAloneIsExcepted strict {
    for p: Person; for r: us.irc.core::Return;
    when furnishes_only_typing_reproducing_or_mechanical_assistance(p, r);
    then excepted_from_tax_return_preparer_status(p, r);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "prepares a return or claim for refund of the employer (or of an officer or employee of the employer) by whom he is regularly and continuously employed")
rule RegularEmployerReturnIsExcepted strict {
    for p: Person; for r: us.irc.core::Return;
    when prepares_return_of_regular_and_continuous_employer_or_its_staff(p, r);
    then excepted_from_tax_return_preparer_status(p, r);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "prepares as a fiduciary a return or claim for refund for any person")
rule FiduciaryPreparationIsExcepted strict {
    for p: Person; for r: us.irc.core::Return;
    when prepares_return_as_fiduciary(p, r);
    then excepted_from_tax_return_preparer_status(p, r);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "prepares a claim for refund for a taxpayer in response to any notice of deficiency issued to such taxpayer")
rule RefundClaimInResponseToDeficiencyNoticeIsExcepted strict {
    for p: Person; for r: us.irc.core::Return;
    when prepares_refund_claim_in_response_to_deficiency_notice_or_audit_waiver(p, r);
    then excepted_from_tax_return_preparer_status(p, r);
}
pub relation tax_return_preparer(p: Person, r: us.irc.core::Return) kind institutional {
    label en official "the term \"tax return preparer\" means any person who prepares for compensation, or who employs one or more persons to prepare for compensation, any return of tax imposed by this title or any claim for refund of tax imposed by this title";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"tax return preparer\" means any person who prepares for compensation, or who employs one or more persons to prepare for compensation, any return of tax imposed by this title or any claim for refund of tax imposed by this title.")
rule PersonPreparingForCompensationIsTaxReturnPreparer strict {
    for p: Person; for r: us.irc.core::Return;
    when prepares_for_compensation(p, r) and return_or_refund_claim_is_under_this_title(r)
        and not_known(excepted_from_tax_return_preparer_status(p, r));
    then tax_return_preparer(p, r);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"tax return preparer\" means any person who prepares for compensation, or who employs one or more persons to prepare for compensation, any return of tax imposed by this title or any claim for refund of tax imposed by this title.")
rule PersonEmployingPreparersForCompensationIsTaxReturnPreparer strict {
    for p: Person; for r: us.irc.core::Return;
    when employs_persons_to_prepare_for_compensation(p, r) and return_or_refund_claim_is_under_this_title(r)
        and not_known(excepted_from_tax_return_preparer_status(p, r));
    then tax_return_preparer(p, r);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "the preparation of a substantial portion of a return or claim for refund shall be treated as if it were the preparation of such return or claim for refund")
rule SubstantialPortionIsTreatedAsPreparationOfWholeReturn strict {
    for p: Person; for r: us.irc.core::Return;
    when prepares_substantial_portion_for_compensation(p, r) and return_or_refund_claim_is_under_this_title(r)
        and not_known(excepted_from_tax_return_preparer_status(p, r));
    then tax_return_preparer(p, r);
}

// --- (37) Individual retirement plan ------------------------------------------
pub entity RetirementArrangement { label en unofficial "an arrangement presented as a possible individual retirement account or annuity"; }
pub relation is_individual_retirement_account_described_in_408a(x: RetirementArrangement) kind empirical {
    label en official "an individual retirement account described in section 408(a)";
}
pub relation is_individual_retirement_annuity_described_in_408b(x: RetirementArrangement) kind empirical {
    label en official "an individual retirement annuity described in section 408(b)";
}
pub relation individual_retirement_plan(x: RetirementArrangement) kind institutional {
    label en official "the term \"individual retirement plan\" means (A) an individual retirement account described in section 408(a), and (B) an individual retirement annuity described in section 408(b)";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "(A) an individual retirement account described in section 408(a), and")
rule IraAccountIsIndividualRetirementPlan strict {
    for x: RetirementArrangement;
    when is_individual_retirement_account_described_in_408a(x);
    then individual_retirement_plan(x);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "(B) an individual retirement annuity described in section 408(b).")
rule IraAnnuityIsIndividualRetirementPlan strict {
    for x: RetirementArrangement;
    when is_individual_retirement_annuity_described_in_408b(x);
    then individual_retirement_plan(x);
}

// --- (38) Joint return ----------------------------------------------------------
pub relation single_return_made_jointly_under_6013_by_husband_and_wife(r: us.irc.core::Return) kind empirical {
    label en official "a single return made jointly under section 6013 by a husband and wife";
}
pub relation joint_return(r: us.irc.core::Return) kind institutional {
    label en official "the term \"joint return\" means a single return made jointly under section 6013 by a husband and wife";
}
@source(IRC_S7701, relation = formalizes, coverage = exact, quote = "The term \"joint return\" means a single return made jointly under section 6013 by a husband and wife.")
rule SingleReturnMadeJointlyUnder6013IsJointReturn strict {
    for r: us.irc.core::Return;
    when single_return_made_jointly_under_6013_by_husband_and_wife(r);
    then joint_return(r);
}

// --- (39) Residence of United States citizens and residents abroad --------------
pub relation citizen_or_resident_of_united_states_for_residence_rule(p: Individual) kind empirical {
    label en official "any citizen or resident of the United States";
}
pub relation neither_resides_nor_is_found_in_any_united_states_judicial_district(p: Individual) kind empirical {
    label en official "does not reside in (and is not found in) any United States judicial district";
}
pub relation provision_relates_to_jurisdiction_of_courts(p: Individual) kind empirical {
    label en official "any provision of this title relating to (A) jurisdiction of courts";
}
pub relation provision_relates_to_enforcement_of_summons(p: Individual) kind empirical {
    label en official "any provision of this title relating to (B) enforcement of summons";
}
pub relation treated_as_residing_in_district_of_columbia(p: Individual) kind institutional {
    label en official "such citizen or resident shall be treated as residing in the District of Columbia for purposes of any provision of this title relating to (A) jurisdiction of courts, or (B) enforcement of summons";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "such citizen or resident shall be treated as residing in the District of Columbia for purposes of any provision of this title relating to—")
rule AbroadCitizenIsTreatedAsResidingInDcForCourtJurisdiction strict {
    for p: Individual;
    when citizen_or_resident_of_united_states_for_residence_rule(p) and neither_resides_nor_is_found_in_any_united_states_judicial_district(p)
        and provision_relates_to_jurisdiction_of_courts(p);
    then treated_as_residing_in_district_of_columbia(p);
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "such citizen or resident shall be treated as residing in the District of Columbia for purposes of any provision of this title relating to—")
rule AbroadCitizenIsTreatedAsResidingInDcForSummonsEnforcement strict {
    for p: Individual;
    when citizen_or_resident_of_united_states_for_residence_rule(p) and neither_resides_nor_is_found_in_any_united_states_judicial_district(p)
        and provision_relates_to_enforcement_of_summons(p);
    then treated_as_residing_in_district_of_columbia(p);
}

// --- (40) Indian tribal government ----------------------------------------------
pub entity TribalBodyCandidate { label en unofficial "the governing body of a tribe, band, community, village, or group of Indians, or (if applicable) Alaska Natives"; }
external judgment relation SecretaryDeterminesTribalBodyExercisesGovernmentalFunctions(b: TribalBodyCandidate) {
    authority Secretary;
    label en official "which is determined by the Secretary, after consultation with the Secretary of the Interior, to exercise governmental functions";
}
pub relation indian_tribal_government(b: TribalBodyCandidate) kind institutional {
    label en official "the term \"Indian tribal government\" means the governing body of any tribe, band, community, village, or group of Indians, or (if applicable) Alaska Natives, which is determined by the Secretary, after consultation with the Secretary of the Interior, to exercise governmental functions";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"Indian tribal government\" means the governing body of any tribe, band, community, village, or group of Indians, or (if applicable) Alaska Natives, which is determined by the Secretary, after consultation with the Secretary of the Interior, to exercise governmental functions.")
rule SecretaryDeterminedTribalBodyIsIndianTribalGovernment strict {
    for b: TribalBodyCandidate;
    when SecretaryDeterminesTribalBodyExercisesGovernmentalFunctions(b);
    then indian_tribal_government(b);
}
pub relation determination_for_alaska_natives_grants_status_or_powers_beyond_section_7871(b: TribalBodyCandidate) kind empirical {
    label en official "a determination under subparagraph (A) with respect to Alaska Natives grants or defers any status or powers other than those enumerated in section 7871";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "No determination under subparagraph (A) with respect to Alaska Natives shall grant or defer any status or powers other than those enumerated in section 7871.")
rule SecretaryMayNotGrantAlaskaNativesStatusBeyond7871 strict {
    label en unofficial "§7701(a)(40)(B), first sentence: a limit on the Secretary's determination for Alaska Natives, modelled as a prohibition on the Secretary";
    for b: TribalBodyCandidate;
    when SecretaryDeterminesTribalBodyExercisesGovernmentalFunctions(b);
    then prohibition GrantStatusBeyond7871ByAlaskaNativeDetermination {
        bearer Secretary;
        action determination_for_alaska_natives_grants_status_or_powers_beyond_section_7871(b);
        window [-infinity, infinity];
    };
}

// --- (41) TIN --------------------------------------------------------------------
pub relation identifying_number_assigned_under_6109(p: Person, n: Text) kind empirical {
    label en official "the identifying number assigned to a person under section 6109";
}
pub relation tin_of(p: Person, n: Text) kind institutional {
    label en official "the term \"TIN\" means the identifying number assigned to a person under section 6109";
}
@source(IRC_S7701, relation = formalizes, coverage = exact, quote = "The term \"TIN\" means the identifying number assigned to a person under section 6109.")
rule IdentifyingNumberAssignedUnder6109IsTin strict {
    for p: Person; for n: Text;
    when identifying_number_assigned_under_6109(p, n);
    then tin_of(p, n);
}

// --- (48) Highway vehicle: what is NOT treated as one ---------------------------
pub entity VehicleCandidate { label en unofficial "a vehicle, trailer or semitrailer presented for the (a)(48) classification"; }
pub relation specially_designed_for_primary_function_of_transporting_particular_load_off_public_highway(v: VehicleCandidate) kind empirical {
    label en official "a vehicle specially designed for the primary function of transporting a particular type of load other than over the public highway";
}
// (a)(48)(A)(iii): "substantial limitation or impairment" is evaluative (DECISION-0194); the
// factors the text names ("such as the size of the vehicle, whether such vehicle is subject to
// the licensing, safety, and other requirements applicable to highway vehicles, and whether such
// vehicle can transport a load at a sustained speed of at least 25 miles per hour") are facts that
// inform the judgment, not a closed test; the design is determined solely by physical
// characteristics ((A)(ii)) and it is immaterial that the vehicle can carry more off the highway
// than the law permits on it ((A)(iii), last sentence).
external judgment relation SpecialDesignSubstantiallyLimitsOrImpairsHighwayLoadCapability(v: VehicleCandidate) {
    authority TaxCourt;
    label en official "because of this special design such vehicle's capability to transport a load over the public highway is substantially limited or impaired";
}
pub relation vehicle_size_bears_on_impairment(v: VehicleCandidate) kind empirical {
    label en official "the size of the vehicle";
}
pub relation vehicle_subject_to_highway_licensing_and_safety_requirements(v: VehicleCandidate) kind empirical {
    label en official "whether such vehicle is subject to the licensing, safety, and other requirements applicable to highway vehicles";
}
pub relation vehicle_can_transport_load_at_sustained_speed_of_at_least_25_mph(v: VehicleCandidate) kind empirical {
    label en official "whether such vehicle can transport a load at a sustained speed of at least 25 miles per hour";
}
pub relation trailer_specially_designed_only_as_enclosed_stationary_shelter_at_off_highway_site(v: VehicleCandidate) kind empirical {
    label en official "a trailer or semitrailer specially designed to function only as an enclosed stationary shelter for the carrying on of an off-highway function at an off-highway site";
}
pub relation excluded_from_highway_vehicle_by_special_design(v: VehicleCandidate) kind institutional {
    label en official "a vehicle shall not be treated as a highway vehicle if such vehicle is specially designed for the primary function of transporting a particular type of load other than over the public highway and because of this special design such vehicle's capability to transport a load over the public highway is substantially limited or impaired";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "A vehicle shall not be treated as a highway vehicle if such vehicle is specially designed for the primary function of transporting a particular type of load other than over the public highway and because of this special design such vehicle's capability to transport a load over the public highway is substantially limited or impaired.")
rule SpeciallyDesignedOffHighwayVehicleIsNotHighwayVehicle strict {
    for v: VehicleCandidate;
    when specially_designed_for_primary_function_of_transporting_particular_load_off_public_highway(v)
        and SpecialDesignSubstantiallyLimitsOrImpairsHighwayLoadCapability(v);
    then excluded_from_highway_vehicle_by_special_design(v);
}
@source(IRC_S7701, relation = formalizes, coverage = exact, quote = "A trailer or semitrailer shall not be treated as a highway vehicle if it is specially designed to function only as an enclosed stationary shelter for the carrying on of an off-highway function at an off-highway site.")
rule StationaryShelterTrailerIsNotHighwayVehicle strict {
    for v: VehicleCandidate;
    when trailer_specially_designed_only_as_enclosed_stationary_shelter_at_off_highway_site(v);
    then excluded_from_highway_vehicle_by_special_design(v);
}

// --- (49) Qualified blood collector organization --------------------------------
pub entity BloodCollectorCandidate : Person { label en unofficial "an organization presented as a possible qualified blood collector organization"; }
pub relation described_in_501c3_and_exempt_under_501a(o: BloodCollectorCandidate) kind empirical {
    label en official "described in section 501(c)(3) and exempt from tax under section 501(a)";
}
pub relation primarily_engaged_in_collection_of_human_blood(o: BloodCollectorCandidate) kind empirical {
    label en official "primarily engaged in the activity of the collection of human blood";
}
pub relation registered_with_secretary_for_excise_tax_exemptions(o: BloodCollectorCandidate) kind empirical {
    label en official "registered with the Secretary for purposes of excise tax exemptions";
}
pub relation registered_by_fda_to_collect_blood(o: BloodCollectorCandidate) kind empirical {
    label en official "registered by the Food and Drug Administration to collect blood";
}
pub relation qualified_blood_collector_organization(o: BloodCollectorCandidate) kind institutional {
    label en official "the term \"qualified blood collector organization\" means an organization which is (A) described in section 501(c)(3) and exempt from tax under section 501(a), (B) primarily engaged in the activity of the collection of human blood, (C) registered with the Secretary for purposes of excise tax exemptions, and (D) registered by the Food and Drug Administration to collect blood";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "The term \"qualified blood collector organization\" means an organization which is—")
rule AllFourLimbsMakeQualifiedBloodCollectorOrganization strict {
    for o: BloodCollectorCandidate;
    when described_in_501c3_and_exempt_under_501a(o) and primarily_engaged_in_collection_of_human_blood(o)
        and registered_with_secretary_for_excise_tax_exemptions(o) and registered_by_fda_to_collect_blood(o);
    then qualified_blood_collector_organization(o);
}

// --- (50) Certain former citizens ------------------------------------------------
pub relation citizenship_treated_as_relinquished_under_877a_g4_on(p: Individual, d: Date) kind empirical {
    label en official "the date on which the individual's citizenship is treated as relinquished under section 877A(g)(4)";
}
pub relation held_united_states_citizenship(p: Individual) kind empirical {
    label en unofficial "the individual is (or was) a United States citizen under other law before the (a)(50)(A) rule is applied";
}
pub relation citizen_status_evaluated_on(p: Individual, on: Date) kind empirical {
    label en unofficial "grounding fact: the individual's treatment as a citizen is being determined for this date";
}
pub relation treated_as_united_states_citizen_on(p: Individual, on: Date) kind institutional {
    label en official "an individual shall not cease to be treated as a United States citizen before the date on which the individual's citizenship is treated as relinquished under section 877A(g)(4)";
}
@source(IRC_S7701, relation = formalizes, coverage = partial, quote = "An individual shall not cease to be treated as a United States citizen before the date on which the individual's citizenship is treated as relinquished under section 877A(g)(4).")
rule CitizenNotCeasedBeforeRelinquishmentDate strict {
    for p: Individual; for on: Date; for d: Date;
    when held_united_states_citizenship(p) and citizen_status_evaluated_on(p, on)
        and citizenship_treated_as_relinquished_under_877a_g4_on(p, d) and on < d;
    then treated_as_united_states_citizen_on(p, on);
}
