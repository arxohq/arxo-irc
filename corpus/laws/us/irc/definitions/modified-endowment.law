// §7702A — modified endowment contracts (stage 2), (a)-(e) and the transition
// note (Pub. L. 100-647 §5012(e), fragment `IRC_S7702A_NOTE_5`).
//
// Reads §7702 (life-insurance.law): a modified endowment contract is a
// contract meeting the §7702 requirements that fails the 7-pay test. The
// actuarial values of the 7-pay test (the 7 level annual premiums and their
// running sum) are asserted by the case, like the §7702 actuarial inputs:
// the package does not derive them from the mortality and interest
// assumptions of §7702(b)(2) and (e) (see the coverage row for (c)(1)).
//
// DEONTICS. §7702A allocates no conduct: it defines a status (MEC) and its
// computational rules; the only norm addressed to a holder is the one-time
// exchange election of the 1988 transition note, modelled as a power of the
// taxpayer with `valid_when` the note's three conditions.
//
// Anchors: the subsection fragments `IRC_S7702A_A` ... `IRC_S7702A_E` and the
// note `IRC_S7702A_NOTE_5`.

language "law.core" version "0.2";
package us.irc.definitions version "0.1.1";
namespace "urn:us:irc:definitions:clir";

use self::{
    IRC_S7702A_A,
    IRC_S7702A_B,
    IRC_S7702A_C,
    IRC_S7702A_D,
    IRC_S7702A_E,
    IRC_S7702A_NOTE_5,
    InsuranceContract,
    Person,
    initial_death_benefit_for_small_contract_test,
    life_insurance_contract,
    seven_pay_limit_through,
};

// --- (e)(2) Contract year; the first 7 contract years -----------------------------
pub relation first_month_for_which_contract_is_in_effect_begins_on(c: InsuranceContract, d: Date) kind empirical {
    label en official "the 12-month period beginning with the 1st month for which the contract is in effect";
}
pub relation contract_year_evaluated_on(c: InsuranceContract, on: Date) kind empirical {
    label en unofficial "grounding fact: the date on which the contract year (and 7-pay window) is being read";
}
pub relation within_first_seven_contract_years(c: InsuranceContract, on: Date) kind institutional {
    label en official "the 1st 7 contract years: seven consecutive 12-month periods, the first beginning with the 1st month for which the contract is in effect";
}
@source(IRC_S7702A_E, relation = formalizes, coverage = partial, quote = "The term \"contract year\" means the 12-month period beginning with the 1st month for which the contract is in effect, and each 12-month period beginning with the corresponding month in subsequent calendar years.")
rule DateInsideSevenTwelveMonthPeriodsIsInFirstSevenContractYears strict {
    for c: InsuranceContract; for on: Date; for d0: Date;
    when first_month_for_which_contract_is_in_effect_begins_on(c, d0) and contract_year_evaluated_on(c, on)
        and on >= d0 and on < add_calendar_period(d0, 84 calendar_month);
    then within_first_seven_contract_years(c, on);
}

// --- (e)(1) Amount paid ----------------------------------------------------------------
pub relation premiums_paid_under_contract(c: InsuranceContract, cy: Integer, amount: Money) kind empirical {
    label en official "the premiums paid under the contract (for the contract year)";
}
pub relation amounts_subject_to_72e_not_includible_in_gross_income(c: InsuranceContract, cy: Integer, amount: Money) kind empirical {
    label en official "amounts to which section 72(e) applies (determined without regard to paragraph (4)(A) thereof) but not including amounts includible in gross income";
}
pub relation premium_returned_with_interest_within_60_days_after_contract_year(c: InsuranceContract, cy: Integer, amount: Money) kind empirical {
    label en official "any portion of any premium paid during any contract year is returned by the insurance company (with interest) within 60 days after the end of such contract year (the amount excluding interest)";
}
pub relation returned_premium_is_needed_to_comply_with_7_pay_test(c: InsuranceContract, cy: Integer) kind empirical {
    label en official "in order to comply with the requirements of subsection (b)";
}
pub relation interest_returned_with_premium(c: InsuranceContract, cy: Integer, amount: Money) kind empirical {
    label en official "the amount of any interest returned as provided in subparagraph (B)";
}
pub relation amount_paid_under_contract(c: InsuranceContract, cy: Integer, amount: Money) kind institutional {
    label en official "the term \"amount paid\" means the premiums paid under the contract, reduced by amounts to which section 72(e) applies but not including amounts includible in gross income, and by premium returned within 60 days after the contract year to comply with the 7-pay test";
}
@source(IRC_S7702A_E, relation = formalizes, coverage = partial, quote = "The term \"amount paid\" means—")
rule AmountPaidIsPremiumsLessSection72eAmounts strict {
    for c: InsuranceContract; for cy: Integer; for p: Money; for a: Money;
    when premiums_paid_under_contract(c, cy, p) and amounts_subject_to_72e_not_includible_in_gross_income(c, cy, a)
        and not_known(returned_premium_is_needed_to_comply_with_7_pay_test(c, cy));
    then amount_paid_under_contract(c, cy, p - a);
}
@source(IRC_S7702A_E, relation = formalizes, coverage = partial, quote = "the amount so returned (excluding interest) shall be deemed to reduce the sum of the premiums paid under the contract during such contract year.")
rule ReturnedPremiumReducesAmountPaid strict {
    for c: InsuranceContract; for cy: Integer; for p: Money; for a: Money; for r: Money;
    when premiums_paid_under_contract(c, cy, p) and amounts_subject_to_72e_not_includible_in_gross_income(c, cy, a)
        and returned_premium_is_needed_to_comply_with_7_pay_test(c, cy)
        and premium_returned_with_interest_within_60_days_after_contract_year(c, cy, r);
    then amount_paid_under_contract(c, cy, p - a - r);
}
pub relation returned_interest_includible_in_gross_income_of_recipient(c: InsuranceContract, cy: Integer, amount: Money) kind institutional {
    label en official "notwithstanding the provisions of section 72(e), the amount of any interest returned as provided in subparagraph (B) shall be includible in the gross income of the recipient";
}
@source(IRC_S7702A_E, relation = formalizes, coverage = exact, quote = "Notwithstanding the provisions of section 72(e), the amount of any interest returned as provided in subparagraph (B) shall be includible in the gross income of the recipient.")
rule ReturnedInterestIsGrossIncome strict {
    for c: InsuranceContract; for cy: Integer; for i: Money; for r: Money;
    when interest_returned_with_premium(c, cy, i) and returned_premium_is_needed_to_comply_with_7_pay_test(c, cy)
        and premium_returned_with_interest_within_60_days_after_contract_year(c, cy, r);
    then returned_interest_includible_in_gross_income_of_recipient(c, cy, i);
}

// --- (b) The 7-pay test ----------------------------------------------------------------
// `accumulated_amount_paid_through` and `seven_pay_net_level_premium_sum_through`
// are asserted at a date: the second is the sum of the net level premiums that
// would have been paid on or before that date if the contract provided for
// paid-up future benefits after 7 level annual premiums ((b), (c)(1)).
pub relation accumulated_amount_paid_through(c: InsuranceContract, on: Date, amount: Money) kind empirical {
    label en official "the accumulated amount paid under the contract at any time during the 1st 7 contract years";
}
pub relation seven_pay_net_level_premium_sum_through(c: InsuranceContract, on: Date, amount: Money) kind empirical {
    label en official "the sum of the net level premiums which would have been paid on or before such time if the contract provided for paid-up future benefits after the payment of 7 level annual premiums";
}
pub relation seven_pay_limit_increase_for_small_contract(c: InsuranceContract, amount: Money) kind institutional {
    label en official "each of the 7 level annual premiums determined under subsection (b) shall be increased by $75 (contract with an initial death benefit of $10,000 or less requiring at least 7 nondecreasing annual premium payments)";
}
pub relation fails_seven_pay_test_at(c: InsuranceContract, on: Date) kind institutional {
    label en official "a contract fails to meet the 7-pay test of this subsection if the accumulated amount paid under the contract at any time during the 1st 7 contract years exceeds the sum of the net level premiums";
}
@source(IRC_S7702A_B, relation = formalizes, coverage = exact, quote = "a contract fails to meet the 7-pay test of this subsection if the accumulated amount paid under the contract at any time during the 1st 7 contract years exceeds the sum of the net level premiums which would have been paid on or before such time if the contract provided for paid-up future benefits after the payment of 7 level annual premiums.")
rule PaymentsAboveSevenPayLimitFailTest strict {
    for c: InsuranceContract; for on: Date; for paid: Money; for limit: Money;
    when within_first_seven_contract_years(c, on) and accumulated_amount_paid_through(c, on, paid)
        and seven_pay_limit_through(c, on, limit)
        and not_known(small_contract_special_rule_applies(c)) and paid > limit;
    then fails_seven_pay_test_at(c, on);
}
@source(IRC_S7702A_C, relation = formalizes, coverage = partial, quote = "each of the 7 level annual premiums determined under subsection (b) (without regard to this paragraph) shall be increased by $75.")
rule PaymentsAboveSevenPayLimitPlusSmallContractIncreaseFailTest strict {
    for c: InsuranceContract; for on: Date; for paid: Money; for limit: Money; for inc: Money;
    when within_first_seven_contract_years(c, on) and accumulated_amount_paid_through(c, on, paid)
        and seven_pay_limit_through(c, on, limit)
        and seven_pay_limit_increase_for_small_contract(c, inc) and paid > limit + inc;
    then fails_seven_pay_test_at(c, on);
}
pub relation fails_seven_pay_test(c: InsuranceContract) kind institutional {
    label en official "the contract fails to meet the 7-pay test of subsection (b) (at some date within the 1st 7 contract years)";
}
@source(IRC_S7702A_B, relation = formalizes, coverage = partial, quote = "at any time during the 1st 7 contract years")
rule FailureAtAnyDateFailsSevenPayTest strict {
    for c: InsuranceContract; for on: Date;
    when fails_seven_pay_test_at(c, on);
    then fails_seven_pay_test(c);
}

// (c)(4) special rule for contracts with death benefits of $10,000 or less.
pub relation initial_death_benefit_of_treated_as_one_contract(c: InsuranceContract, amount: Money) kind empirical {
    label en official "an initial death benefit (the contract involved and all contracts previously issued to the same policyholder by the same company being treated as one contract; the aggregate is asserted by the case, TECH-GAPS G3500)";
}
pub relation requires_at_least_seven_nondecreasing_annual_premium_payments(c: InsuranceContract) kind empirical {
    label en official "which requires at least 7 nondecreasing annual premium payments";
}
pub relation small_contract_special_rule_applies(c: InsuranceContract) kind institutional {
    label en official "a contract which provides an initial death benefit of $10,000 or less and which requires at least 7 nondecreasing annual premium payments";
}
@source(IRC_S7702A_C, relation = formalizes, coverage = partial, quote = "(A) which provides an initial death benefit of $10,000 or less, and")
rule SmallDeathBenefitContractWithSevenNondecreasingPremiumsQualifies strict {
    for c: InsuranceContract; for db: Money;
    when initial_death_benefit_for_small_contract_test(c, db) and db <= 10000 USD
        and requires_at_least_seven_nondecreasing_annual_premium_payments(c);
    then small_contract_special_rule_applies(c);
}
@source(IRC_S7702A_C, relation = formalizes, coverage = partial, quote = "each of the 7 level annual premiums determined under subsection (b) (without regard to this paragraph) shall be increased by $75.")
rule SmallContractSevenPayPremiumsIncreasedBySeventyFiveDollars strict {
    for c: InsuranceContract;
    when small_contract_special_rule_applies(c);
    then seven_pay_limit_increase_for_small_contract(c, 75 USD);
}

// --- (c)(2), (c)(6) Reductions in benefits during the 1st 7 years ------------------------
pub relation benefits_reduced_on(c: InsuranceContract, d: Date) kind empirical {
    label en official "a reduction in benefits under the contract";
}
pub relation reduction_attributable_to_nonpayment_of_premiums_due(c: InsuranceContract, d: Date) kind empirical {
    label en official "any reduction in benefits attributable to the nonpayment of premiums due under the contract";
}
pub relation benefits_reinstated_on(c: InsuranceContract, d: Date) kind empirical {
    label en official "the benefits are reinstated";
}
pub relation reduction_disregarded_because_reinstated_within_90_days(c: InsuranceContract, d: Date) kind institutional {
    label en official "any reduction in benefits attributable to the nonpayment of premiums due under the contract shall not be taken into account if the benefits are reinstated within 90 days after the reduction in such benefits";
}
@source(IRC_S7702A_C, relation = formalizes, coverage = exact, quote = "Any reduction in benefits attributable to the nonpayment of premiums due under the contract shall not be taken into account under subparagraph (A) if the benefits are reinstated within 90 days after the reduction in such benefits.")
rule NonpaymentReductionReinstatedWithin90DaysIsDisregarded strict {
    for c: InsuranceContract; for d: Date; for r: Date;
    when benefits_reduced_on(c, d) and reduction_attributable_to_nonpayment_of_premiums_due(c, d)
        and benefits_reinstated_on(c, r) and r >= d and r <= add_calendar_period(d, 90 calendar_day);
    then reduction_disregarded_because_reinstated_within_90_days(c, d);
}
pub relation treated_as_issued_at_reduced_benefit_level(c: InsuranceContract) kind institutional {
    label en official "this section shall be applied as if the contract had originally been issued at the reduced benefit level";
}
@source(IRC_S7702A_C, relation = formalizes, coverage = partial, quote = "If there is a reduction in benefits under the contract within the 1st 7 contract years, this section shall be applied as if the contract had originally been issued at the reduced benefit level.")
rule ReductionInFirstSevenYearsIsTreatedAsIssuedAtReducedLevel strict {
    for c: InsuranceContract; for d: Date;
    when benefits_reduced_on(c, d) and within_first_seven_contract_years(c, d)
        and not_known(reduction_disregarded_because_reinstated_within_90_days(c, d));
    then treated_as_issued_at_reduced_benefit_level(c);
}
pub relation death_benefit_payable_only_on_death_of_one_insured_after_another(c: InsuranceContract) kind empirical {
    label en official "a contract provides a death benefit which is payable only upon the death of 1 insured following (or occurring simultaneously with) the death of another insured";
}
pub relation survivorship_death_benefit_reduced_below_lowest_level_of_first_seven_years(c: InsuranceContract) kind empirical {
    label en official "there is a reduction in such death benefit below the lowest level of such death benefit provided under the contract during the 1st 7 contract years";
}
@source(IRC_S7702A_C, relation = formalizes, coverage = exact, quote = "this section shall be applied as if the contract had originally been issued at the reduced benefit level.")
rule SurvivorshipBenefitReductionIsTreatedAsIssuedAtReducedLevel strict {
    for c: InsuranceContract;
    when death_benefit_payable_only_on_death_of_one_insured_after_another(c)
        and survivorship_death_benefit_reduced_below_lowest_level_of_first_seven_years(c);
    then treated_as_issued_at_reduced_benefit_level(c);
}

// --- (c)(3) Material changes ---------------------------------------------------------------
pub relation death_benefit_increased_on(c: InsuranceContract, d: Date) kind empirical {
    label en official "any increase in the death benefit under the contract";
}
pub relation qualified_additional_benefit_increased_or_added_on(c: InsuranceContract, d: Date) kind empirical {
    label en official "any increase in, or addition of, a qualified additional benefit under the contract";
}
pub relation other_material_change_in_terms_on(c: InsuranceContract, d: Date) kind empirical {
    label en official "a material change in the benefits under (or in other terms of) the contract which was not reflected in any previous determination under this section";
}
pub relation increase_attributable_to_premiums_necessary_for_lowest_level_or_interest_credits(c: InsuranceContract, d: Date) kind empirical {
    label en official "any increase which is attributable to the payment of premiums necessary to fund the lowest level of the death benefit and qualified additional benefits payable in the 1st 7 contract years or to crediting of interest or other earnings (including policyholder dividends)";
}
pub relation increase_is_regulation_excluded_cost_of_living_increase(c: InsuranceContract, d: Date) kind empirical {
    label en official "to the extent provided in regulations, any cost-of-living increase based on an established broad-based index if such increase is funded ratably over the remaining period during which premiums are required to be paid under the contract";
}
pub relation material_change_takes_effect_on(c: InsuranceContract, d: Date) kind institutional {
    label en official "a material change in the benefits under (or in other terms of) the contract; the term includes any increase in the death benefit or any increase in, or addition of, a qualified additional benefit, but not the two excluded increases";
}
@source(IRC_S7702A_C, relation = formalizes, coverage = partial, quote = "the term \"material change\" includes any increase in the death benefit under the contract or any increase in, or addition of, a qualified additional benefit under the contract.")
rule DeathBenefitIncreaseIsMaterialChangeUnlessExcluded strict {
    for c: InsuranceContract; for d: Date;
    when death_benefit_increased_on(c, d)
        and not_known(increase_attributable_to_premiums_necessary_for_lowest_level_or_interest_credits(c, d))
        and not_known(increase_is_regulation_excluded_cost_of_living_increase(c, d));
    then material_change_takes_effect_on(c, d);
}
@source(IRC_S7702A_C, relation = formalizes, coverage = partial, quote = "the term \"material change\" includes any increase in the death benefit under the contract or any increase in, or addition of, a qualified additional benefit under the contract.")
rule QualifiedAdditionalBenefitIncreaseIsMaterialChangeUnlessExcluded strict {
    for c: InsuranceContract; for d: Date;
    when qualified_additional_benefit_increased_or_added_on(c, d)
        and not_known(increase_attributable_to_premiums_necessary_for_lowest_level_or_interest_credits(c, d))
        and not_known(increase_is_regulation_excluded_cost_of_living_increase(c, d));
    then material_change_takes_effect_on(c, d);
}
@source(IRC_S7702A_C, relation = formalizes, coverage = partial, quote = "If there is a material change in the benefits under (or in other terms of) the contract which was not reflected in any previous determination under this section, for purposes of this section—")
rule OtherMaterialChangeIsMaterialChange strict {
    for c: InsuranceContract; for d: Date;
    when other_material_change_in_terms_on(c, d);
    then material_change_takes_effect_on(c, d);
}
pub relation treated_as_new_contract_entered_into_on(c: InsuranceContract, d: Date) kind institutional {
    label en official "such contract shall be treated as a new contract entered into on the day on which such material change takes effect";
}
@source(IRC_S7702A_C, relation = formalizes, coverage = partial, quote = "(i) such contract shall be treated as a new contract entered into on the day on which such material change takes effect, and")
rule MaterialChangeCreatesNewContractOnEffectiveDay strict {
    for c: InsuranceContract; for d: Date;
    when material_change_takes_effect_on(c, d);
    then treated_as_new_contract_entered_into_on(c, d);
}

// --- (a) The definition; transition note (3) on entry dates -------------------------------
pub relation contract_entered_into_on(c: InsuranceContract, d: Date) kind empirical {
    label en official "a contract entered into on the date";
}
pub relation increase_or_conversion_after_june_20_1988_without_unilateral_right(c: InsuranceContract) kind empirical {
    label en official "on or after June 21, 1988, the death benefit under the contract is increased (or a qualified additional benefit is increased or added) and before June 21, 1988, the owner of the contract did not have a unilateral right under the contract to obtain such increase or addition without providing additional evidence of insurability, or the contract is converted after June 20, 1988, from a term life insurance contract to a life insurance contract providing coverage other than term life insurance coverage";
}
pub relation entered_into_on_or_after_june_21_1988(c: InsuranceContract) kind institutional {
    label en official "is entered into on or after June 21, 1988";
}
@source(IRC_S7702A_A, relation = formalizes, coverage = partial, quote = "(A) is entered into on or after June 21, 1988, and")
rule EntryDateOnOrAfterJune211988 strict {
    for c: InsuranceContract; for d: Date;
    when contract_entered_into_on(c, d) and d >= @1988-06-21;
    then entered_into_on_or_after_june_21_1988(c);
}
@source(IRC_S7702A_A, relation = formalizes, coverage = partial, quote = "(A) is entered into on or after June 21, 1988, and")
rule NewContractOnMaterialChangeDayOnOrAfterJune211988 strict {
    for c: InsuranceContract; for d: Date;
    when treated_as_new_contract_entered_into_on(c, d) and d >= @1988-06-21;
    then entered_into_on_or_after_june_21_1988(c);
}
@source(IRC_S7702A_NOTE_5, relation = formalizes, coverage = partial, quote = "A contract entered into before June 21, 1988, shall be treated as entered into after such date if—")
rule PreJune1988ContractWithLaterIncreaseOrConversionIsTreatedAsEnteredAfter strict {
    for c: InsuranceContract; for d: Date;
    when contract_entered_into_on(c, d) and d < @1988-06-21 and increase_or_conversion_after_june_20_1988_without_unilateral_right(c);
    then entered_into_on_or_after_june_21_1988(c);
}
pub relation modified_endowment_contract_by_paragraph_1(c: InsuranceContract) kind institutional {
    label en official "any contract meeting the requirements of section 7702 which is entered into on or after June 21, 1988, and fails to meet the 7-pay test of subsection (b)";
}
@source(IRC_S7702A_A, relation = formalizes, coverage = partial, quote = "For purposes of section 72, the term \"modified endowment contract\" means any contract meeting the requirements of section 7702—")
rule LifeInsuranceContractFailingSevenPayAfter1988IsMec strict {
    for c: InsuranceContract;
    when life_insurance_contract(c) and entered_into_on_or_after_june_21_1988(c) and fails_seven_pay_test(c)
        and not_known(treated_as_issued_at_reduced_benefit_level(c));
    then modified_endowment_contract_by_paragraph_1(c);
}
// When the contract is treated as issued at the reduced level, the 7-pay
// facts the case asserts are those of the reduced level: the reduced-level
// failure is the same `fails_seven_pay_test`; the two rules differ only in
// recording the "as if issued" step for the reader.
@source(IRC_S7702A_C, relation = formalizes, coverage = partial, quote = "If there is a reduction in benefits under the contract within the 1st 7 contract years, this section shall be applied as if the contract had originally been issued at the reduced benefit level.")
rule ReducedLevelContractFailingSevenPayAfter1988IsMec strict {
    for c: InsuranceContract;
    when life_insurance_contract(c) and entered_into_on_or_after_june_21_1988(c) and fails_seven_pay_test(c)
        and treated_as_issued_at_reduced_benefit_level(c);
    then modified_endowment_contract_by_paragraph_1(c);
}
pub relation received_in_exchange_for_contract(c: InsuranceContract, prior: InsuranceContract) kind empirical {
    label en official "which is received in exchange for a contract described in paragraph (1) or this paragraph";
}
pub relation modified_endowment_contract_7702a(c: InsuranceContract) kind institutional {
    label en official "for purposes of section 72, the term \"modified endowment contract\" means any contract meeting the requirements of section 7702 (1) which is entered into on or after June 21, 1988, and fails the 7-pay test, or (2) which is received in exchange for a contract described in paragraph (1) or this paragraph";
}
@source(IRC_S7702A_A, relation = formalizes, coverage = partial, quote = "(A) is entered into on or after June 21, 1988, and")
rule Paragraph1ContractIsMec strict {
    for c: InsuranceContract;
    when modified_endowment_contract_by_paragraph_1(c);
    then modified_endowment_contract_7702a(c);
}
// Paragraph (2) is recursive ("described in paragraph (1) or this
// paragraph"); a predicate may not depend on itself (LDC-E4102), so the chain
// of exchanges is unrolled to two levels through helper relations
// (levels 3-5 are in insurance-stage3.law, levels 6-8 in stage3b-definitions.law; a ninth link is not reached, TECH-GAPS G6301).
pub relation received_in_exchange_for_paragraph_1_contract(c: InsuranceContract) kind institutional {
    label en official "a contract which is received in exchange for a contract described in paragraph (1)";
}
@source(IRC_S7702A_A, relation = formalizes, coverage = partial, quote = "(2) which is received in exchange for a contract described in paragraph (1) or this paragraph.")
rule ExchangeForParagraph1ContractGivesFirstLevel strict {
    for c: InsuranceContract; for prior: InsuranceContract;
    when received_in_exchange_for_contract(c, prior) and modified_endowment_contract_by_paragraph_1(prior);
    then received_in_exchange_for_paragraph_1_contract(c);
}
pub relation received_in_exchange_for_first_level_exchange_contract(c: InsuranceContract) kind institutional {
    label en official "a contract which is received in exchange for a contract described in paragraph (2) (second link of the chain)";
}
@source(IRC_S7702A_A, relation = formalizes, coverage = partial, quote = "(2) which is received in exchange for a contract described in paragraph (1) or this paragraph.")
rule ExchangeForFirstLevelExchangeContractGivesSecondLevel strict {
    for c: InsuranceContract; for prior: InsuranceContract;
    when received_in_exchange_for_contract(c, prior) and received_in_exchange_for_paragraph_1_contract(prior);
    then received_in_exchange_for_first_level_exchange_contract(c);
}
@source(IRC_S7702A_A, relation = formalizes, coverage = partial, quote = "(2) which is received in exchange for a contract described in paragraph (1) or this paragraph.")
rule FirstLevelExchangeContractIsMec strict {
    for c: InsuranceContract;
    when received_in_exchange_for_paragraph_1_contract(c);
    then modified_endowment_contract_7702a(c);
}
@source(IRC_S7702A_A, relation = formalizes, coverage = partial, quote = "(2) which is received in exchange for a contract described in paragraph (1) or this paragraph.")
rule SecondLevelExchangeContractIsMec strict {
    for c: InsuranceContract;
    when received_in_exchange_for_first_level_exchange_contract(c);
    then modified_endowment_contract_7702a(c);
}

// --- (d) Distributions affected ---------------------------------------------------------------
pub entity ContractDistribution { label en unofficial "a distribution under an insurance contract"; }
pub relation distribution_from_contract(dist: ContractDistribution, c: InsuranceContract) kind empirical {
    label en unofficial "the distribution is made under this contract";
}
pub relation distribution_made_on(dist: ContractDistribution, d: Date) kind empirical {
    label en unofficial "the date of the distribution";
}
pub relation contract_year_in_which_seven_pay_failure_takes_effect_begins_on(c: InsuranceContract, d: Date) kind empirical {
    label en official "the contract year in which the failure takes effect";
}
pub relation seven_pay_failure_takes_effect_on(c: InsuranceContract, d: Date) kind empirical {
    label en official "the failure to meet the 7-pay test takes effect";
}
pub relation regulations_extend_mec_treatment_to_anticipatory_distributions(c: InsuranceContract) kind empirical {
    label en official "under regulations prescribed by the Secretary, distributions (not described in paragraph (1)) in anticipation of such failure";
}
pub relation distribution_treated_as_failing_seven_pay_test(dist: ContractDistribution) kind institutional {
    label en official "such contract shall be treated as failing to meet such requirements only in the case of distributions during the contract year in which the failure takes effect and during any subsequent contract year, and (under regulations) distributions in anticipation of such failure";
}
@source(IRC_S7702A_D, relation = formalizes, coverage = partial, quote = "(1) distributions during the contract year in which the failure takes effect and during any subsequent contract year, and")
rule DistributionFromFailureYearOnIsTreatedAsFailing strict {
    for dist: ContractDistribution; for c: InsuranceContract; for d: Date; for start: Date;
    when distribution_from_contract(dist, c) and distribution_made_on(dist, d)
        and fails_seven_pay_test(c) and contract_year_in_which_seven_pay_failure_takes_effect_begins_on(c, start) and d >= start;
    then distribution_treated_as_failing_seven_pay_test(dist);
}
pub relation distribution_treated_as_made_in_anticipation_of_failure(dist: ContractDistribution) kind institutional {
    label en official "any distribution which is made within 2 years before the failure to meet the 7-pay test shall be treated as made in anticipation of such failure";
}
@source(IRC_S7702A_D, relation = formalizes, coverage = exact, quote = "For purposes of the preceding sentence, any distribution which is made within 2 years before the failure to meet the 7-pay test shall be treated as made in anticipation of such failure.")
rule DistributionWithinTwoYearsBeforeFailureIsInAnticipation strict {
    for dist: ContractDistribution; for c: InsuranceContract; for d: Date; for f: Date;
    for calendar_before_1: Date;
    when distribution_from_contract(dist, c) and distribution_made_on(dist, d)
        and seven_pay_failure_takes_effect_on(c, f) and d < f and d >= calendar_before_1
        and us.irc.core::civil_calendar_boundary_before(f, 2, us.irc.core::CalendarYear, calendar_before_1);
    then distribution_treated_as_made_in_anticipation_of_failure(dist);
}
@source(IRC_S7702A_D, relation = formalizes, coverage = partial, quote = "(2) under regulations prescribed by the Secretary, distributions (not described in paragraph (1)) in anticipation of such failure.")
rule AnticipatoryDistributionIsTreatedAsFailingWhenRegulationsSoProvide strict {
    for dist: ContractDistribution; for c: InsuranceContract;
    when distribution_from_contract(dist, c) and distribution_treated_as_made_in_anticipation_of_failure(dist)
        and regulations_extend_mec_treatment_to_anticipatory_distributions(c);
    then distribution_treated_as_failing_seven_pay_test(dist);
}

// --- Transition note (4): the one-time exchange election (taxpayer's power) -----------------
pub entity Section7702ANoteExchange { label en unofficial "an exchange of a modified endowment contract for a life insurance contract under note (4) of the 1988 effective-date provision"; }
pub relation exchanged_mec_required_at_least_seven_annual_level_premium_payments(x: Section7702ANoteExchange) kind empirical {
    label en official "a modified endowment contract which required at least 7 annual level premium payments";
}
pub relation exchanged_mec_entered_into_between_june_21_1988_and_enactment(x: Section7702ANoteExchange) kind empirical {
    label en official "is entered into after June 20, 1988, and before the date of the enactment of this Act [Nov. 10, 1988]";
}
pub relation exchanged_within_three_months_after_enactment_for_contract_meeting_7702a_b(x: Section7702ANoteExchange) kind empirical {
    label en official "is exchanged within 3 months after such date of enactment for a life insurance contract which meets the requirements of section 7702A(b)";
}
pub relation taxpayer_elects_to_recognize_gain_on_exchange(x: Section7702ANoteExchange) kind empirical {
    label en official "the taxpayer elects, notwithstanding section 1035 of the 1986 Code, to recognize gain on such exchange";
}
pub relation exchange_meets_note_4_conditions(x: Section7702ANoteExchange) kind institutional {
    label en official "the modified endowment contract required at least 7 annual level premium payments, was entered into after June 20, 1988 and before the enactment date, and is exchanged within 3 months after enactment for a life insurance contract which meets the requirements of section 7702A(b)";
}
@source(IRC_S7702A_NOTE_5, relation = formalizes, coverage = partial, quote = "\"(4) Certain exchanges permitted.—In the case of a modified endowment contract which—")
rule ExchangeWithAllThreeConditionsMeetsNote4 strict {
    for x: Section7702ANoteExchange;
    when exchanged_mec_required_at_least_seven_annual_level_premium_payments(x)
        and exchanged_mec_entered_into_between_june_21_1988_and_enactment(x)
        and exchanged_within_three_months_after_enactment_for_contract_meeting_7702a_b(x);
    then exchange_meets_note_4_conditions(x);
}
pub relation exchange_contract_not_treated_as_modified_endowment_contract(x: Section7702ANoteExchange) kind institutional {
    label en official "the contract which is received in exchange for such contract shall not be treated as a modified endowment contract if the taxpayer elects, notwithstanding section 1035 of the 1986 Code, to recognize gain on such exchange";
}
pub relation exchanging_taxpayer_of(x: Section7702ANoteExchange, p: Person) kind empirical {
    label en unofficial "the taxpayer who made the exchange";
}
@source(IRC_S7702A_NOTE_5, relation = formalizes, coverage = partial, quote = "the contract which is received in exchange for such contract shall not be treated as a modified endowment contract if the taxpayer elects, notwithstanding section 1035 of the 1986 Code, to recognize gain on such exchange.")
rule TaxpayerMayElectToRecognizeGainOnNote4Exchange strict {
    label en unofficial "1988 transition note (4): the taxpayer's election to recognize gain on a qualifying exchange keeps the received contract out of the MEC class; an election without the note's conditions has no effect (E-0239)";
    for x: Section7702ANoteExchange; for p: Person;
    when exchanging_taxpayer_of(x, p);
    then power ElectToRecognizeGainOnNote4Exchange {
        holder p;
        over x;
        exercise taxpayer_elects_to_recognize_gain_on_exchange(x);
        valid_when exchange_meets_note_4_conditions(x);
        effect create(exchange_contract_not_treated_as_modified_endowment_contract(x));
    };
}
