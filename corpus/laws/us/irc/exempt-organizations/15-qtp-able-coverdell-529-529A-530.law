// Section 529 (qualified tuition programs), 529A (ABLE programs, core),
// and 530 (Coverdell education savings accounts) — STAGE 2b (25.09.2026).
// Individual-side rules, deprioritized until after the organization-side
// sections, now reached within this stage's budget.

// =======================================================================
// Section 529(b): qualified tuition program requirements.
// =======================================================================

use self::{
    IRC_S529A_A,
    IRC_S529A_B,
    IRC_S529A_C,
    IRC_S529_B,
    IRC_S529_C,
    IRC_S530_A,
    IRC_S530_B,
    IRC_S530_C,
    IRC_S530_D,
    Person,
    TaxableYear,
    Trust,
};

@source(IRC_S529_B, quote = "The term \"qualified tuition program\" means a program established and maintained by a State or agency or instrumentality thereof or by 1 or more eligible educational institutions—")
pub relation qualified_tuition_program(program: Person) kind institutional {
    label en official "section 529(b)(1): a State (or agency/instrumentality) or eligible-educational-institution program meeting the (A)-(B) structural requirements and the (2)-(6) operating requirements";
}
pub relation established_by_state_or_eligible_institution_529b1(program: Person) kind empirical {
    label en official "the program is established and maintained by a State (or agency/instrumentality) or by 1 or more eligible educational institutions (section 529(b)(1))";
}
@source(IRC_S529_B, quote = "A program shall not be treated as a qualified tuition program unless it provides that purchases or contributions may only be made in cash.")
pub relation cash_only_contributions_529b2(program: Person) kind empirical {
    label en official "section 529(b)(2): the program provides that purchases/contributions may only be made in cash";
}
@source(IRC_S529_B, quote = "A program shall not be treated as a qualified tuition program unless it provides separate accounting for each designated beneficiary.")
pub relation separate_accounting_per_beneficiary_529b3(program: Person) kind empirical {
    label en official "section 529(b)(3): separate accounting for each designated beneficiary";
}
@source(IRC_S529_B, quote = "A program shall not be treated as a qualified tuition program unless it provides that any contributor to, or designated beneficiary under, such program may, directly or indirectly, direct the investment of any contributions to the program (or any earnings thereon) no more than 2 times in any calendar year.")
pub relation investment_direction_limit_529b4(program: Person) kind empirical {
    label en official "section 529(b)(4): investment direction limited to no more than 2 times per calendar year";
}
@source(IRC_S529_B, quote = "A program shall not be treated as a qualified tuition program if it allows any interest in the program or any portion thereof to be used as security for a loan.")
pub relation allows_pledging_as_security_529b5(program: Person) kind empirical {
    label en official "section 529(b)(5): the program allows an interest to be used as loan security — a disqualifying condition";
}
@source(IRC_S529_B, quote = "A program shall not be treated as a qualified tuition program unless it provides adequate safeguards to prevent contributions on behalf of a designated beneficiary in excess of those necessary to provide for the qualified higher education expenses of the beneficiary.")
pub relation excess_contribution_safeguards_529b6(program: Person) kind empirical {
    label en official "section 529(b)(6): adequate safeguards against excess contributions";
}
rule QualifiedTuitionProgram(program: Person) defeasible {
    label en official "section 529(b)(1)-(6): all structural and operating requirements";
    when established_by_state_or_eligible_institution_529b1(program);
    when cash_only_contributions_529b2(program);
    when separate_accounting_per_beneficiary_529b3(program);
    when investment_direction_limit_529b4(program);
    unless allows_pledging_as_security_529b5(program);
    when excess_contribution_safeguards_529b6(program);
    then qualified_tuition_program(program);
}

// --- (c): tax treatment ----------------------------------------------

@source(IRC_S529_C, quote = "Except as otherwise provided in this subsection, no amount shall be includible in gross income of—\n(A) a designated beneficiary under a qualified tuition program, or\n(B) a contributor to such program on behalf of a designated beneficiary,\nwith respect to any distribution or earnings under such program.")
pub relation qtp_amounts_not_includible_529c1(beneficiary: Person, program: Person, y: TaxableYear) kind institutional {
    label en official "section 529(c)(1): no amount includible in gross income for a designated beneficiary or contributor, except as (c) otherwise provides";
}
pub relation designated_beneficiary_of_qtp(beneficiary: Person, program: Person, y: TaxableYear) kind empirical {
    label en official "the person is the designated beneficiary of the qualified tuition program for the taxable year (section 529(c)(1)(A))";
}
rule QtpAmountsNotIncludible529c1(beneficiary: Person, program: Person, y: TaxableYear) defeasible {
    label en official "section 529(c)(1)";
    when qualified_tuition_program(program);
    when designated_beneficiary_of_qtp(beneficiary, program, y);
    then qtp_amounts_not_includible_529c1(beneficiary, program, y);
}

@source(IRC_S529_C, quote = "Any distribution under a qualified tuition program shall be includible in the gross income of the distributee in the manner as provided under section 72 to the extent not excluded from gross income under any other provision of this chapter.")
pub relation qtp_distribution_includible_under_72_529c3A(beneficiary: Person, program: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 529(c)(3)(A): a QTP distribution is includible under section 72's mechanics except as (B) excludes it";
}
pub relation qtp_distribution_amount_529c3(beneficiary: Person, program: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount distributed under the qualified tuition program during the taxable year (section 529(c)(3)(A))";
}

// The (c)(3)(B) earnings-ratio computation — the flagship item, with
// intermediate values: the earnings portion of the distribution (the
// section 72-style earnings ratio applied to the total distribution) is
// excluded to the extent of qualified higher education expenses, and
// proportionally otherwise.
@source(IRC_S529_C, quote = "In-kind distributions\nNo amount shall be includible in gross income under subparagraph (A) by reason of a distribution which consists of providing a benefit to the distributee which, if paid for by the distributee, would constitute payment of a qualified higher education expense.")
pub relation qtp_in_kind_distribution_not_includible_529c3Bi(beneficiary: Person, program: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 529(c)(3)(B)(i): an in-kind benefit that would itself be a qualified higher education expense is not includible";
}
pub relation qtp_distribution_earnings_portion_529c3(beneficiary: Person, program: Person, y: TaxableYear, earnings_amount: Money) kind empirical {
    label en unofficial "the earnings portion of the QTP distribution (the section 72-style ratio of earnings to total account value, applied to the distribution) — case-asserted intermediate value, the ratio computation itself not derived (TECH-GAPS G489)";
}
pub relation qtp_qualified_higher_education_expenses_529c3(beneficiary: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the designated beneficiary's qualified higher education expenses for the taxable year (section 529(c)(3)(B)(ii), section 529(e)(3))";
}
pub relation qtp_qualified_distribution(beneficiary: Person, program: Person, y: TaxableYear, excluded_amount: Money) kind institutional {
    label en official "section 529(c)(3)(B)(ii): the excluded portion of a cash QTP distribution — task's requested pub interface";
}
rule QtpQualifiedDistributionFullyExcluded(beneficiary: Person, program: Person, y: TaxableYear, earnings: Money, expenses: Money, total: Money) defeasible {
    label en official "section 529(c)(3)(B)(ii)(I): distributions not exceeding qualified higher education expenses are fully excluded";
    when qtp_distribution_earnings_portion_529c3(beneficiary, program, y, earnings);
    when qtp_qualified_higher_education_expenses_529c3(beneficiary, y, expenses);
    when qtp_distribution_amount_529c3(beneficiary, program, y, total);
    when total <= expenses;
    then qtp_qualified_distribution(beneficiary, program, y, earnings);
}
rule QtpQualifiedDistributionProrated(beneficiary: Person, program: Person, y: TaxableYear, earnings: Money, expenses: Money, total: Money) defeasible {
    label en official "section 529(c)(3)(B)(ii)(II): distributions exceeding expenses are excluded in the same ratio as expenses bear to distributions — the intermediate ratio is computed exactly, then applied to the earnings portion";
    when qtp_distribution_earnings_portion_529c3(beneficiary, program, y, earnings);
    when qtp_qualified_higher_education_expenses_529c3(beneficiary, y, expenses);
    when qtp_distribution_amount_529c3(beneficiary, program, y, total);
    when total > expenses;
    then qtp_qualified_distribution(beneficiary, program, y, round(earnings * (expenses / total), 2, "HALF_UP"));
}

@source(IRC_S529_C, quote = "Subparagraph (A) shall not apply to that portion of any distribution which, within 60 days of such distribution, is transferred—\n(I) to another qualified tuition program for the benefit of the designated beneficiary,")
pub relation qtp_rollover_not_includible_529c3C(beneficiary: Person, program: Person, y: TaxableYear, amount: Money, distributed_on: Date, transferred_on: Date) kind institutional {
    label en official "section 529(c)(3)(C)(i): a QTP-to-QTP rollover within the EXACT 60-day window is not includible";
}
rule QtpRolloverNotIncludible529c3C(beneficiary: Person, program: Person, y: TaxableYear, amount: Money, distributed_on: Date, transferred_on: Date) defeasible {
    label en official "section 529(c)(3)(C)(i)(I): exact 60-day window";
    when qtp_rollover_transfer_529c3C(beneficiary, program, y, amount, distributed_on, transferred_on);
    when transferred_on <= add_calendar_period(distributed_on, 60 calendar_day);
    then qtp_rollover_not_includible_529c3C(beneficiary, program, y, amount, distributed_on, transferred_on);
}
pub relation qtp_rollover_transfer_529c3C(beneficiary: Person, program: Person, y: TaxableYear, amount: Money, distributed_on: Date, transferred_on: Date) kind empirical {
    label en official "a distribution transferred to another QTP for the same designated beneficiary (section 529(c)(3)(C)(i)(I))";
}

@source(IRC_S529_C, quote = "This subparagraph shall not apply to any distribution described in clause (i) to the extent that the aggregate amount of such distributions with respect to the designated beneficiary for such taxable year and all prior taxable years exceeds $35,000.")
pub relation qtp_roth_rollover_lifetime_limit_exceeded_529c3E(beneficiary: Person, aggregate_lifetime_amount: Money) kind institutional {
    label en official "section 529(c)(3)(E)(ii)(II): the EXACT $35,000 lifetime cap on QTP-to-Roth-IRA rollovers is exceeded";
}
rule QtpRothRolloverLifetimeLimitExceeded529c3E(beneficiary: Person, aggregate_lifetime_amount: Money) defeasible {
    label en official "section 529(c)(3)(E)(ii)(II): exact $35,000 lifetime cap, no rounding";
    when qtp_roth_rollover_aggregate_lifetime_529c3E(beneficiary, aggregate_lifetime_amount);
    when aggregate_lifetime_amount > 35000.00 USD;
    then qtp_roth_rollover_lifetime_limit_exceeded_529c3E(beneficiary, aggregate_lifetime_amount);
}
pub relation qtp_roth_rollover_aggregate_lifetime_529c3E(beneficiary: Person, amount: Money) kind empirical {
    label en official "the aggregate amount of QTP-to-Roth-IRA rollovers for the designated beneficiary, this year and all prior years (section 529(c)(3)(E)(ii)(II))";
}
@source(IRC_S529_C, quote = "In the case of a distribution from a qualified tuition program of a designated beneficiary which has been maintained for the 15-year period ending on the date of such distribution, subparagraph (A) shall not apply to so much the portion of such distribution which—\n(I) does not exceed the aggregate amount contributed to the program (and earnings attributable thereto) before the 5-year period ending on the date of the distribution, and")
pub relation qtp_fifteen_year_maintenance_met_529c3E(beneficiary: Person, program: Person, established_on: Date, distributed_on: Date) kind empirical {
    label en official "the QTP has been maintained for the EXACT 15-year period ending on the distribution date (section 529(c)(3)(E)(i))";
}

@source(IRC_S529_C, quote = "The tax imposed by section 530(d)(4) shall apply to any payment or distribution from a qualified tuition program in the same manner as such tax applies to a payment or distribution from a Coverdell education savings account.")
pub relation qtp_additional_tax_529c6(beneficiary: Person, program: Person, y: TaxableYear, includible_amount: Money, additional_tax: Money) kind institutional {
    label en official "section 529(c)(6): the section 530(d)(4) 10 percent additional tax applies to a taxable QTP distribution the same way it applies to a Coverdell distribution";
}
pub relation qtp_additional_tax_exception_529c6(beneficiary: Person, program: Person, y: TaxableYear, includible_amount: Money) kind empirical {
    label en unofficial "one of the section 530(d)(4)(B) exceptions applies to this QTP distribution (section 529(c)(6) incorporates section 530(d)(4) 'in the same manner') — a QTP-scoped restatement of `coverdell_additional_tax_exception_530d4B` so this rule's `unless` clause binds `program`/`includible` per the corpus's unless-binds-every-head-field convention";
}
rule QtpAdditionalTax529c6(beneficiary: Person, program: Person, y: TaxableYear, includible: Money) defeasible {
    label en official "section 529(c)(6) via section 530(d)(4): exact 10 percent, no rounding of the rate itself";
    when qtp_distribution_includible_under_72_529c3A(beneficiary, program, y, includible);
    unless qtp_additional_tax_exception_529c6(beneficiary, program, y, includible);
    then qtp_additional_tax_529c6(beneficiary, program, y, includible, round(includible * 0.10, 2, "HALF_UP"));
}

@source(IRC_S529_C, quote = "Any reference in this subsection to the term \"qualified higher education expense\" shall include a reference to expenses for tuition in connection with enrollment or attendance at an elementary or secondary public, private, or religious school.")
pub relation qtp_k12_tuition_qualifies_529c7(beneficiary: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 529(c)(7): K-12 tuition qualifies as a qualified higher education expense, capped at the EXACT $10,000/year aggregate under section 529(e)(3) — the pinned 2024-Edition text shows $10,000, NOT $20,000; a later PL 119-21 increase, if enacted, is not carried in this snapshot (SOURCE_GAP, not invented)";
}
pub relation qtp_k12_tuition_expenses_529c7(beneficiary: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "K-12 tuition expenses incurred during the taxable year, before the section 529(e)(3) $10,000 cap (section 529(c)(7))";
}
rule QtpK12TuitionQualifies529c7(beneficiary: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 529(c)(7)/(e)(3): EXACT $10,000/year cap, no rounding";
    effective [-infinity, @2026-01-01);
    when qtp_k12_tuition_expenses_529c7(beneficiary, y, amount);
    when amount <= 10000.00 USD;
    then qtp_k12_tuition_qualifies_529c7(beneficiary, y, amount);
}

// =======================================================================
// Section 529A: ABLE programs, core.
// =======================================================================

@source(IRC_S529A_A, quote = "A qualified ABLE program shall be exempt from taxation under this subtitle. Notwithstanding the preceding sentence, such program shall be subject to the taxes imposed by section 511 (relating to imposition of tax on unrelated business income of charitable organizations).")
pub relation qualified_able_program_exempt_529Aa(program: Person, y: TaxableYear) kind institutional {
    label en official "section 529A(a): a qualified ABLE program is exempt from taxation, subject to section 511 UBIT";
}
pub relation able_program_operating_in_year(program: Person, y: TaxableYear) kind empirical {
    label en unofficial "the ABLE program is operating for this taxable year, binding the year for section 529A(a)'s exemption classification";
}
rule QualifiedAbleProgramExempt529Aa(program: Person, y: TaxableYear) defeasible {
    label en official "section 529A(a)";
    when qualified_able_program(program);
    when able_program_operating_in_year(program, y);
    then qualified_able_program_exempt_529Aa(program, y);
}

@source(IRC_S529A_B, quote = "The term \"qualified ABLE program\" means a program established and maintained by a State, or agency or instrumentality thereof—\n(A) under which a person may make contributions for a taxable year, for the benefit of an individual who is an eligible individual for such taxable year, to an ABLE account which is established for the purpose of meeting the qualified disability expenses of the designated beneficiary of the account,")
pub relation qualified_able_program(program: Person) kind institutional {
    label en official "section 529A(b)(1): a State (or agency/instrumentality) ABLE-contribution program meeting the (A)-(C) structural requirements and the (2)-(6) operating requirements";
}
pub relation established_by_state_529Ab1(program: Person) kind empirical {
    label en official "the program is established and maintained by a State or agency/instrumentality (section 529A(b)(1))";
}
pub relation limits_to_one_able_account_529Ab1B(program: Person) kind empirical {
    label en official "the program limits a designated beneficiary to 1 ABLE account (section 529A(b)(1)(B))";
}
pub relation able_cash_only_contributions_529Ab2(program: Person) kind empirical {
    label en official "the program accepts contributions only in cash (subject to the (c)(1)(C) exception) (section 529A(b)(2))";
}
pub relation able_separate_accounting_529Ab3(program: Person) kind empirical {
    label en official "separate accounting for each designated beneficiary (section 529A(b)(3))";
}
pub relation able_investment_direction_limit_529Ab4(program: Person) kind empirical {
    label en official "investment direction limited to no more than 2 times per calendar year (section 529A(b)(4))";
}
pub relation able_allows_pledging_as_security_529Ab5(program: Person) kind empirical {
    label en official "the program allows an interest to be used as loan security (section 529A(b)(5), disqualifying)";
}
pub relation able_excess_contribution_safeguards_529Ab6(program: Person) kind empirical {
    label en official "adequate safeguards against contributions exceeding the section 529(b)(6) State limit (section 529A(b)(6))";
}
rule QualifiedAbleProgram(program: Person) defeasible {
    label en official "section 529A(b)(1)-(6): all structural and operating requirements";
    when established_by_state_529Ab1(program);
    when limits_to_one_able_account_529Ab1B(program);
    when able_cash_only_contributions_529Ab2(program);
    when able_separate_accounting_529Ab3(program);
    when able_investment_direction_limit_529Ab4(program);
    unless able_allows_pledging_as_security_529Ab5(program);
    when able_excess_contribution_safeguards_529Ab6(program);
    then qualified_able_program(program);
}
@source(IRC_S529A_B, quote = "except in the case of contributions under subsection (c)(1)(C), if such contribution to an ABLE account would result in aggregate contributions from all contributors to the ABLE account for the taxable year exceeding the sum of—\n(i) the amount in effect under section 2503(b) for the calendar year in which the taxable year begins, plus")
pub relation able_annual_contribution_limit_exceeded_529Ab2B(beneficiary: Person, y: TaxableYear, aggregate_contributions: Money, gift_tax_annual_exclusion: Money) kind institutional {
    label en official "section 529A(b)(2)(B)(i): aggregate ABLE contributions for the year may not exceed the section 2503(b) gift-tax annual exclusion amount (plus the (ii) working-beneficiary addition, not modelled — TECH-GAPS G489); the section 2503(b) figure is an EXTERNAL_DEPENDENCY on us.irc.estate_gift, which does not `pub` it — case-asserted here";
}
rule AbleAnnualContributionLimitExceeded529Ab2B(beneficiary: Person, y: TaxableYear, aggregate: Money, exclusion: Money) defeasible {
    label en official "section 529A(b)(2)(B)(i): exact comparison against the (case-asserted) section 2503(b) figure";
    when aggregate_contributions_529Ab2B(beneficiary, y, aggregate);
    when gift_tax_annual_exclusion_2503b(y, exclusion);
    when aggregate > exclusion;
    then able_annual_contribution_limit_exceeded_529Ab2B(beneficiary, y, aggregate, exclusion);
}
pub relation aggregate_contributions_529Ab2B(beneficiary: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "aggregate contributions from all contributors to the ABLE account for the taxable year (section 529A(b)(2)(B))";
}
pub relation gift_tax_annual_exclusion_2503b(y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the section 2503(b) gift-tax annual exclusion amount for the calendar year — EXTERNAL_DEPENDENCY, us.irc.estate_gift's AnnualExclusionAmount is not `pub`; case-asserted rather than duplicated";
}

@source(IRC_S529A_C, quote = "Any distribution under a qualified ABLE program shall be includible in the gross income of the distributee in the manner as provided under section 72 to the extent not excluded from gross income under any other provision of this chapter.")
pub relation able_distribution_includible_under_72_529Ac1A(beneficiary: Person, program: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 529A(c)(1)(A): an ABLE distribution is includible under section 72's mechanics except as (B) excludes it";
}
@source(IRC_S529A_C, quote = "if distributions from a qualified ABLE program—\n(i) do not exceed the qualified disability expenses of the designated beneficiary, no amount shall be includible in gross income, and")
pub relation able_qualified_distribution(beneficiary: Person, program: Person, y: TaxableYear, excluded_amount: Money) kind institutional {
    label en official "section 529A(c)(1)(B): the excluded portion of an ABLE distribution — fully excluded if not exceeding qualified disability expenses, prorated otherwise";
}
pub relation able_distribution_amount_529Ac1(beneficiary: Person, program: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount distributed from the ABLE account during the taxable year (section 529A(c)(1))";
}
pub relation qualified_disability_expenses_529Ac1(beneficiary: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the designated beneficiary's qualified disability expenses for the taxable year (section 529A(c)(1)(B), section 529A(e)(5))";
}
rule AbleQualifiedDistributionFullyExcluded(beneficiary: Person, program: Person, y: TaxableYear, total: Money, expenses: Money) defeasible {
    label en official "section 529A(c)(1)(B)(i): distributions not exceeding qualified disability expenses are fully excluded";
    when able_distribution_amount_529Ac1(beneficiary, program, y, total);
    when qualified_disability_expenses_529Ac1(beneficiary, y, expenses);
    when total <= expenses;
    then able_qualified_distribution(beneficiary, program, y, total);
}
rule AbleQualifiedDistributionProrated(beneficiary: Person, program: Person, y: TaxableYear, total: Money, expenses: Money) defeasible {
    label en official "section 529A(c)(1)(B)(ii): distributions exceeding expenses are excluded in the same ratio as expenses bear to distributions";
    when able_distribution_amount_529Ac1(beneficiary, program, y, total);
    when qualified_disability_expenses_529Ac1(beneficiary, y, expenses);
    when total > expenses;
    then able_qualified_distribution(beneficiary, program, y, round(total * (expenses / total), 2, "HALF_UP"));
}

// =======================================================================
// Section 530: Coverdell education savings accounts.
// =======================================================================

@source(IRC_S530_A, quote = "A Coverdell education savings account shall be exempt from taxation under this subtitle. Notwithstanding the preceding sentence, the Coverdell education savings account shall be subject to the taxes imposed by section 511 (relating to imposition of tax on unrelated business income of charitable organizations).")
pub relation coverdell_account_exempt_530a(account: Person, y: TaxableYear) kind institutional {
    label en official "section 530(a): a Coverdell education savings account is exempt from taxation, subject to section 511 UBIT";
}
pub relation coverdell_account_open_in_year(account: Trust, y: TaxableYear) kind empirical {
    label en unofficial "the Coverdell account is open/in existence for this taxable year, binding the year for section 530(a)'s exemption classification";
}
rule CoverdellAccountExempt530a(account: Trust, y: TaxableYear) defeasible {
    label en official "section 530(a)";
    when coverdell_education_savings_account(account);
    when coverdell_account_open_in_year(account, y);
    then coverdell_account_exempt_530a(account, y);
}

@source(IRC_S530_B, quote = "The term \"Coverdell education savings account\" means a trust created or organized in the United States exclusively for the purpose of paying the qualified education expenses of an individual who is the designated beneficiary of the trust")
pub relation coverdell_education_savings_account(account: Trust) kind institutional {
    label en official "section 530(b)(1): a US trust exclusively for paying a designated beneficiary's qualified education expenses, meeting the (A)-(E) governing-instrument requirements";
}
pub relation coverdell_trust_us_exclusive_purpose_530b1(account: Trust) kind empirical {
    label en official "the trust is created/organized in the US exclusively to pay the designated beneficiary's qualified education expenses (section 530(b)(1))";
}
@source(IRC_S530_B, quote = "unless it is in cash,")
pub relation coverdell_cash_only_530b1Ai(account: Trust) kind empirical {
    label en official "section 530(b)(1)(A)(i): contributions only in cash";
}
@source(IRC_S530_B, quote = "The term \"Coverdell education savings account\" means a trust created or organized in the United States exclusively for the purpose of paying the qualified education expenses of an individual who is the designated beneficiary of the trust (and designated as a Coverdell education savings account at the time created or organized), but only if the written governing instrument creating the trust meets the following requirements:\n(A) No contribution will be accepted—\n(i) unless it is in cash,\n(ii) after the date on which such beneficiary attains age 18, or")
pub relation coverdell_contribution_after_age_18_530b1Aii(account: Trust, beneficiary: Person, contribution_on: Date, beneficiary_born_on: Date) kind institutional {
    label en official "section 530(b)(1)(A)(ii): a disqualifying contribution EXACTLY after the beneficiary's 18th birthday (special-needs beneficiaries excepted per the flush language, TECH-GAPS G489)";
}
rule CoverdellContributionAfterAge18(account: Trust, beneficiary: Person, contribution_on: Date, beneficiary_born_on: Date) defeasible {
    label en official "section 530(b)(1)(A)(ii): EXACT age-18 date comparison";
    when contribution_made_on_530b1Aii(account, beneficiary, contribution_on);
    when beneficiary_born_on_530(beneficiary, beneficiary_born_on);
    when contribution_on > add_calendar_period(beneficiary_born_on, 18 calendar_year);
    unless special_needs_beneficiary_530(beneficiary) and contribution_made_on_530b1Aii(account, beneficiary, contribution_on) and beneficiary_born_on_530(beneficiary, beneficiary_born_on);
    then coverdell_contribution_after_age_18_530b1Aii(account, beneficiary, contribution_on, beneficiary_born_on);
}
pub relation contribution_made_on_530b1Aii(account: Trust, beneficiary: Person, contribution_on: Date) kind empirical {
    label en official "a contribution was made to the account on this date (section 530(b)(1)(A)(ii))";
}
pub relation beneficiary_born_on_530(beneficiary: Person, born_on: Date) kind empirical {
    label en official "the designated beneficiary's date of birth, for the section 530 age-18/age-30 EXACT date tests";
}
pub relation special_needs_beneficiary_530(beneficiary: Person) kind empirical {
    label en official "the designated beneficiary has special needs (section 530(b)(1), flush language) — the age-18/(E) age-30 limitations do not apply";
}
@source(IRC_S530_B, quote = "if such contribution would result in aggregate contributions for the taxable year exceeding $2,000.")
pub relation coverdell_contribution_limit(account: Trust, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 530(b)(1)(A)(iii): the EXACT $2,000 annual aggregate contribution limit — task's requested pub interface";
}
pub relation coverdell_aggregate_contributions_530b1Aiii(account: Trust, y: TaxableYear, amount: Money) kind empirical {
    label en official "aggregate contributions to the account for the taxable year (section 530(b)(1)(A)(iii))";
}
rule CoverdellContributionLimitExceeded(account: Trust, y: TaxableYear, amount: Money) defeasible {
    label en official "section 530(b)(1)(A)(iii): exact $2,000, no rounding";
    when coverdell_aggregate_contributions_530b1Aiii(account, y, amount);
    when amount > 2000.00 USD;
    then coverdell_contribution_limit(account, y, amount);
}
@source(IRC_S530_B, quote = "any balance to the credit of the designated beneficiary on the date on which the beneficiary attains age 30 shall be distributed within 30 days after such date to the beneficiary")
pub relation coverdell_mandatory_distribution_at_age_30_530b1E(account: Trust, beneficiary: Person, beneficiary_born_on: Date, distribution_deadline: Date) kind institutional {
    label en official "section 530(b)(1)(E): mandatory distribution of the balance within 30 days of the beneficiary's EXACT 30th birthday (special-needs beneficiaries excepted)";
}
rule CoverdellMandatoryDistributionAtAge30(account: Trust, beneficiary: Person, beneficiary_born_on: Date) defeasible {
    label en official "section 530(b)(1)(E): exact 30-years-plus-30-days deadline";
    when designated_beneficiary_of_coverdell_account(beneficiary, account);
    when beneficiary_born_on_530(beneficiary, beneficiary_born_on);
    unless special_needs_beneficiary_530(beneficiary) and designated_beneficiary_of_coverdell_account(beneficiary, account) and beneficiary_born_on_530(beneficiary, beneficiary_born_on);
    then coverdell_mandatory_distribution_at_age_30_530b1E(account, beneficiary, beneficiary_born_on, add_calendar_period(add_calendar_period(beneficiary_born_on, 30 calendar_year), 30 calendar_day));
}
pub relation designated_beneficiary_of_coverdell_account(beneficiary: Person, account: Trust) kind empirical {
    label en official "the person is the designated beneficiary of this Coverdell education savings account (section 530(b)(1))";
}

@source(IRC_S530_C, quote = "In the case of a contributor who is an individual, the maximum amount the contributor could otherwise make to an account under this section shall be reduced by an amount which bears the same ratio to such maximum amount as—\n(A) the excess of—\n(i) the contributor's modified adjusted gross income for such taxable year, over\n(ii) $95,000 ($190,000 in the case of a joint return), bears to\n(B) $15,000 ($30,000 in the case of a joint return).")
pub relation coverdell_magi_phaseout_reduction_530c(contributor: Person, y: TaxableYear, magi: Money, reduced_amount: Money) kind institutional {
    label en official "section 530(c)(1): EXACT $95,000/$15,000 (or $190,000/$30,000 joint) phase-out ratio, applied to the $2,000 statutory maximum, with intermediate values (excess over the threshold, the phase-out ratio, the reduction)";
}
pub relation contributor_files_joint_return_530c(contributor: Person, y: TaxableYear) kind empirical {
    label en official "the contributor files a joint return for the taxable year (section 530(c)(1), doubling the threshold and range)";
}
rule CoverdellMagiPhaseoutSingle(contributor: Person, y: TaxableYear, magi: Money) defeasible {
    label en official "section 530(c)(1): single/non-joint EXACT $95,000 threshold, $15,000 range, applied to the $2,000 statutory maximum";
    when modified_agi_530c2(contributor, y, magi);
    unless contributor_files_joint_return_530c(contributor, y) and modified_agi_530c2(contributor, y, magi);
    when magi > 95000.00 USD;
    then coverdell_magi_phaseout_reduction_530c(contributor, y, magi, round(2000.00 USD * ((magi - 95000.00 USD) / 15000.00 USD), 2, "HALF_UP"));
}
rule CoverdellMagiPhaseoutJoint(contributor: Person, y: TaxableYear, magi: Money) defeasible {
    label en official "section 530(c)(1): joint-return EXACT $190,000 threshold, $30,000 range";
    when contributor_files_joint_return_530c(contributor, y);
    when modified_agi_530c2(contributor, y, magi);
    when magi > 190000.00 USD;
    then coverdell_magi_phaseout_reduction_530c(contributor, y, magi, round(2000.00 USD * ((magi - 190000.00 USD) / 30000.00 USD), 2, "HALF_UP"));
}
pub relation modified_agi_530c2(contributor: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "modified adjusted gross income: AGI increased by amounts excluded under sections 911, 931, or 933 (section 530(c)(2))";
}

@source(IRC_S530_D, quote = "Any distribution shall be includible in the gross income of the distributee in the manner as provided in section 72.")
pub relation coverdell_distribution_includible_under_72_530d1(beneficiary: Person, account: Trust, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 530(d)(1): a Coverdell distribution is includible under section 72's mechanics except as (2) excludes it";
}
@source(IRC_S530_D, quote = "No amount shall be includible in gross income under paragraph (1) if the qualified education expenses of the designated beneficiary during the taxable year are not less than the aggregate distributions during the taxable year.")
pub relation coverdell_qualified_distribution(beneficiary: Person, account: Trust, y: TaxableYear, excluded_amount: Money) kind institutional {
    label en official "section 530(d)(2): the excluded portion of a Coverdell distribution — fully excluded if not exceeding qualified education expenses, prorated otherwise";
}
pub relation coverdell_distribution_amount_530d2(beneficiary: Person, account: Trust, y: TaxableYear, amount: Money) kind empirical {
    label en official "aggregate Coverdell distributions during the taxable year (section 530(d)(2)(A))";
}
pub relation coverdell_qualified_education_expenses_530d2(beneficiary: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the designated beneficiary's qualified education expenses for the taxable year (section 530(d)(2)(A), section 530(b)(2))";
}
rule CoverdellQualifiedDistributionFullyExcluded(beneficiary: Person, account: Trust, y: TaxableYear, total: Money, expenses: Money) defeasible {
    label en official "section 530(d)(2)(A): fully excluded when expenses are not less than distributions";
    when coverdell_distribution_amount_530d2(beneficiary, account, y, total);
    when coverdell_qualified_education_expenses_530d2(beneficiary, y, expenses);
    when total <= expenses;
    then coverdell_qualified_distribution(beneficiary, account, y, total);
}
rule CoverdellQualifiedDistributionProrated(beneficiary: Person, account: Trust, y: TaxableYear, total: Money, expenses: Money) defeasible {
    label en official "section 530(d)(2)(B): prorated exclusion when distributions exceed expenses";
    when coverdell_distribution_amount_530d2(beneficiary, account, y, total);
    when coverdell_qualified_education_expenses_530d2(beneficiary, y, expenses);
    when total > expenses;
    then coverdell_qualified_distribution(beneficiary, account, y, round(total * (expenses / total), 2, "HALF_UP"));
}

@source(IRC_S530_D, quote = "The tax imposed by this chapter for any taxable year on any taxpayer who receives a payment or distribution from a Coverdell education savings account which is includible in gross income shall be increased by 10 percent of the amount which is so includible.")
pub relation coverdell_additional_tax_530d4(beneficiary: Person, account: Trust, y: TaxableYear, includible_amount: Money, additional_tax: Money) kind institutional {
    label en official "section 530(d)(4)(A): EXACT 10 percent additional tax on the includible portion of a Coverdell distribution, unless a (B) exception applies — task's requested pub-adjacent `pub coverdell_contribution_limit` companion";
}
pub relation coverdell_additional_tax_exception_530d4B(beneficiary: Person, y: TaxableYear) kind empirical {
    label en official "one of the section 530(d)(4)(B) exceptions applies (death, disability, scholarship, service academy, timely-returned excess contribution) — case-asserted compound fact, not decomposed into the five sub-tests (TECH-GAPS G489)";
}
rule CoverdellAdditionalTax530d4(beneficiary: Person, account: Trust, y: TaxableYear, includible: Money) defeasible {
    label en official "section 530(d)(4)(A): exact 10 percent, no rounding of the rate itself";
    when coverdell_distribution_includible_under_72_530d1(beneficiary, account, y, includible);
    unless coverdell_additional_tax_exception_530d4B(beneficiary, y) and coverdell_distribution_includible_under_72_530d1(beneficiary, account, y, includible);
    then coverdell_additional_tax_530d4(beneficiary, account, y, includible, round(includible * 0.10, 2, "HALF_UP"));
}
