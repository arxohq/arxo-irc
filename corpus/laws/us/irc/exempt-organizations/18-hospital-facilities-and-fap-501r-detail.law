// Section 501(r), stage 3 — the pieces stage 1 left at their top-level
// condition: (r)(2)(B) per-facility compliance, (r)(4)(A) the five contents of
// the written financial assistance policy, (r)(4)(B) the emergency-care policy,
// (r)(5)(A)-(B) the limitation on charges and the gross-charges bar, (r)(6) the
// billing-and-collection restriction. The deontic positions are the hospital
// organization's own conduct: a duty to establish the policies (achievement over
// the taxable year) and two prohibitions (VIOLATED on the established act, no
// section 137 pair, E-0179). The consequence of failing any requirement stays
// where stage 1 put it: `hospital_denied_501c3_by_501r` / section 501(c)(3)
// classification in 01 and 03. (r)(7) is a directive to the Secretary and sets
// no norm for a taxpayer.

// ---------------------------------------------------------------------
// (r)(2)(B): more than one hospital facility.
// ---------------------------------------------------------------------

use self::{
    IRC_S501_R,
    Person,
    TaxableYear,
    charges_limitation_prohibited_established,
    chna_requirement_satisfied_for_year,
    extraordinary_collection_before_eligibility_effort_established,
    financial_assistance_policy_established,
    section_501r_applies,
    section_501r_requirements_met_for_year,
};

pub entity HospitalFacility {
    label en unofficial "a hospital facility operated by a hospital organization (section 501(r)(2)(B)); the pinned text names the unit but does not define it";
}
pub relation operates_hospital_facility(o: Person, f: HospitalFacility) kind empirical {
    label en official "the hospital organization operates the hospital facility (section 501(r)(2)(B))";
}
pub relation operates_more_than_one_hospital_facility(o: Person) kind institutional {
    label en official "the hospital organization operates more than 1 hospital facility (section 501(r)(2)(B))";
}
@source(IRC_S501_R, quote = "If a hospital organization operates more than 1 hospital facility—")
rule OperatesMoreThanOneHospitalFacility(o: Person, f1: HospitalFacility, f2: HospitalFacility) defeasible {
    label en official "section 501(r)(2)(B): a hospital organization that operates two distinct hospital facilities operates more than 1";
    when operates_hospital_facility(o, f1);
    when operates_hospital_facility(o, f2);
    when f1 != f2;
    then operates_more_than_one_hospital_facility(o);
}

pub relation facility_chna_requirement_met(o: Person, f: HospitalFacility, y: TaxableYear) kind empirical {
    label en official "the community health needs assessment requirements of section 501(r)(3) are met with respect to the hospital facility for the taxable year";
}
pub relation facility_fap_requirement_met(o: Person, f: HospitalFacility, y: TaxableYear) kind empirical {
    label en official "the financial assistance policy requirements of section 501(r)(4) are met with respect to the hospital facility for the taxable year";
}
pub relation facility_charges_requirement_met(o: Person, f: HospitalFacility, y: TaxableYear) kind empirical {
    label en official "the requirements on charges of section 501(r)(5) are met with respect to the hospital facility for the taxable year";
}
pub relation facility_collection_requirement_met(o: Person, f: HospitalFacility, y: TaxableYear) kind empirical {
    label en official "the billing and collection requirement of section 501(r)(6) is met with respect to the hospital facility for the taxable year";
}
pub relation facility_meets_501r_separately(o: Person, f: HospitalFacility, y: TaxableYear) kind institutional {
    label en official "the requirements of section 501(r) are separately met with respect to the hospital facility for the taxable year (section 501(r)(2)(B)(i))";
}
@source(IRC_S501_R, quote = "(i) the organization shall meet the requirements of this subsection separately with respect to each such facility, and")
rule FacilityMeets501rSeparately(o: Person, f: HospitalFacility, y: TaxableYear) defeasible {
    label en official "section 501(r)(2)(B)(i): a facility meets section 501(r) separately when its CHNA, financial assistance policy, charges and collection requirements are each met";
    when operates_hospital_facility(o, f);
    when facility_chna_requirement_met(o, f, y);
    when facility_fap_requirement_met(o, f, y);
    when facility_charges_requirement_met(o, f, y);
    when facility_collection_requirement_met(o, f, y);
    then facility_meets_501r_separately(o, f, y);
}
pub relation not_treated_as_501c3_with_respect_to_facility(o: Person, f: HospitalFacility, y: TaxableYear) kind institutional {
    label en official "the organization is not treated as described in section 501(c)(3) with respect to the hospital facility (section 501(r)(2)(B)(ii))";
}
@source(IRC_S501_R, quote = "(ii) the organization shall not be treated as described in subsection (c)(3) with respect to any such facility for which such requirements are not separately met.")
rule NotTreatedAs501c3ForFacilityLackingSeparateCompliance(o: Person, f: HospitalFacility, y: TaxableYear) defeasible {
    label en official "section 501(r)(2)(B)(ii): with more than 1 facility, the organization is not treated as a section 501(c)(3) organization with respect to a facility for which the requirements are not separately met";
    when section_501r_applies(o);
    when operates_more_than_one_hospital_facility(o);
    when operates_hospital_facility(o, f);
    when us.irc.core::year_of(o, y);
    unless facility_meets_501r_separately(o, f, y);
    then not_treated_as_501c3_with_respect_to_facility(o, f, y);
}

// ---------------------------------------------------------------------
// (r)(4): the written financial assistance policy and the emergency policy.
// ---------------------------------------------------------------------

pub relation written_financial_assistance_policy_501r4A(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization has a written financial assistance policy (section 501(r)(4)(A))";
}
pub relation fap_states_eligibility_criteria_and_free_or_discounted_care_501r4Ai(o: Person, y: TaxableYear) kind empirical {
    label en official "the policy includes eligibility criteria for financial assistance and states whether the assistance includes free or discounted care (section 501(r)(4)(A)(i))";
}
pub relation fap_states_basis_for_calculating_charges_501r4Aii(o: Person, y: TaxableYear) kind empirical {
    label en official "the policy includes the basis for calculating amounts charged to patients (section 501(r)(4)(A)(ii))";
}
pub relation fap_states_method_for_applying_501r4Aiii(o: Person, y: TaxableYear) kind empirical {
    label en official "the policy includes the method for applying for financial assistance (section 501(r)(4)(A)(iii))";
}
pub relation has_separate_billing_and_collections_policy_501r4Aiv(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization has a separate billing and collections policy (the condition of section 501(r)(4)(A)(iv))";
}
pub relation fap_states_actions_on_nonpayment_501r4Aiv(o: Person, y: TaxableYear) kind empirical {
    label en official "the policy states the actions the organization may take in the event of non-payment, including collections action and reporting to credit agencies (section 501(r)(4)(A)(iv))";
}
pub relation fap_includes_widely_publicizing_measures_501r4Av(o: Person, y: TaxableYear) kind empirical {
    label en official "the policy includes measures to widely publicize it within the community to be served (section 501(r)(4)(A)(v))";
}
pub relation written_emergency_care_policy_501r4B(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization has a written policy requiring it to provide, without discrimination, care for emergency medical conditions regardless of eligibility under the financial assistance policy (section 501(r)(4)(B))";
}
pub relation fap_contents_complete_501r4A(o: Person, y: TaxableYear) kind institutional {
    label en official "the written financial assistance policy includes all contents required by section 501(r)(4)(A)(i)-(v)";
}
@source(IRC_S501_R, quote = "(i) eligibility criteria for financial assistance, and whether such assistance includes free or discounted care,")
@source(IRC_S501_R, quote = "(iv) in the case of an organization which does not have a separate billing and collections policy, the actions the organization may take in the event of non-payment, including collections action and reporting to credit agencies, and")
rule FapContentsCompleteWithSeparateCollectionsPolicy(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(r)(4)(A): contents (i), (ii), (iii) and (v) are present and (iv) is not required because the organization has a separate billing and collections policy";
    when written_financial_assistance_policy_501r4A(o, y);
    when fap_states_eligibility_criteria_and_free_or_discounted_care_501r4Ai(o, y);
    when fap_states_basis_for_calculating_charges_501r4Aii(o, y);
    when fap_states_method_for_applying_501r4Aiii(o, y);
    when fap_includes_widely_publicizing_measures_501r4Av(o, y);
    when has_separate_billing_and_collections_policy_501r4Aiv(o, y);
    then fap_contents_complete_501r4A(o, y);
}
@source(IRC_S501_R, quote = "(i) eligibility criteria for financial assistance, and whether such assistance includes free or discounted care,")
@source(IRC_S501_R, quote = "(iv) in the case of an organization which does not have a separate billing and collections policy, the actions the organization may take in the event of non-payment, including collections action and reporting to credit agencies, and")
rule FapContentsCompleteWithoutSeparateCollectionsPolicy(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(r)(4)(A): contents (i)-(v) are present, including (iv) the non-payment actions, for an organization without a separate billing and collections policy";
    when written_financial_assistance_policy_501r4A(o, y);
    when fap_states_eligibility_criteria_and_free_or_discounted_care_501r4Ai(o, y);
    when fap_states_basis_for_calculating_charges_501r4Aii(o, y);
    when fap_states_method_for_applying_501r4Aiii(o, y);
    when fap_states_actions_on_nonpayment_501r4Aiv(o, y);
    when fap_includes_widely_publicizing_measures_501r4Av(o, y);
    then fap_contents_complete_501r4A(o, y);
}
pub relation fap_requirements_met_501r4(o: Person, y: TaxableYear) kind institutional {
    label en official "the organization meets the financial assistance policy requirements of section 501(r)(4): the written policy with its required contents and the emergency-care policy";
}
@source(IRC_S501_R, quote = "An organization meets the requirements of this paragraph if the organization establishes the following policies:")
rule FapRequirementsMetFromContents(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(r)(4): the requirements are met when the written policy has all required contents and the written emergency-care policy is established";
    when fap_contents_complete_501r4A(o, y);
    when written_emergency_care_policy_501r4B(o, y);
    then fap_requirements_met_501r4(o, y);
}
@source(IRC_S501_R, quote = "An organization meets the requirements of this paragraph if the organization establishes the following policies:")
rule FapRequirementsMetFromAggregateFact(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(r)(4): a case that asserts only the aggregate fact that both policies are established (the stage 1 shape) also satisfies the requirements";
    when financial_assistance_policy_established(o, y);
    then fap_requirements_met_501r4(o, y);
}

// ---------------------------------------------------------------------
// (r)(5): charges. (r)(6): billing and collection.
// ---------------------------------------------------------------------

pub relation charged_eligible_individual_more_than_amounts_generally_billed_501r5A(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization charged an individual eligible under the financial assistance policy for emergency or other medically necessary care more than the amounts generally billed to individuals who have insurance covering such care (section 501(r)(5)(A))";
}
pub relation used_gross_charges_501r5B(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization used gross charges (section 501(r)(5)(B))";
}
pub relation charges_requirement_breached_501r5(o: Person, y: TaxableYear) kind institutional {
    label en official "the organization breached the requirements on charges of section 501(r)(5)";
}
@source(IRC_S501_R, quote = "(A) limits amounts charged for emergency or other medically necessary care provided to individuals eligible for assistance under the financial assistance policy described in paragraph (4)(A) to not more than the amounts generally billed to individuals who have insurance covering such care, and")
rule ChargesRequirementBreachedByExcessCharge(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(r)(5)(A): charging an eligible individual more than the amounts generally billed to insured individuals breaches the requirement";
    when section_501r_applies(o);
    when charged_eligible_individual_more_than_amounts_generally_billed_501r5A(o, y);
    then charges_requirement_breached_501r5(o, y);
}
@source(IRC_S501_R, quote = "(B) prohibits the use of gross charges.")
rule ChargesRequirementBreachedByGrossCharges(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(r)(5)(B): using gross charges breaches the requirement";
    when section_501r_applies(o);
    when used_gross_charges_501r5B(o, y);
    then charges_requirement_breached_501r5(o, y);
}

// Section 501(r)(1) revisited: the derived breach and the derived (r)(4)
// requirement join the stage 1 empirical shortcuts. The stage 1 rule
// Section501rRequirementsMet in 03 carries the same guards; the two rules
// below add the derived paths without removing the aggregate ones.
@source(IRC_S501_R, quote = "(B) meets the financial assistance policy requirements described in paragraph (4),")
@source(IRC_S501_R, quote = "(C) meets the requirements on charges described in paragraph (5), and")
rule Section501rRequirementsMetFromDerivedRelations(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(r)(1)(A)-(D): the CHNA requirement, the derived financial assistance policy requirement, no charges breach and no premature extraordinary collection";
    when chna_requirement_satisfied_for_year(o, y);
    when fap_requirements_met_501r4(o, y);
    unless charges_requirement_breached_501r5(o, y);
    unless charges_limitation_prohibited_established(o, y);
    unless extraordinary_collection_before_eligibility_effort_established(o, y);
    then section_501r_requirements_met_for_year(o, y);
}

// ---------------------------------------------------------------------
// Deontic positions of the hospital organization.
// ---------------------------------------------------------------------

@source(IRC_S501_R, quote = "An organization meets the requirements of this paragraph if the organization establishes the following policies:")
rule EstablishFinancialAssistancePolicyDutyRule(o: Person, y: TaxableYear, start: Date, ending: Date) strict {
    label en official "section 501(r)(4): a hospital organization to which section 501(r) applies is under a duty, for each taxable year, to have established the written financial assistance policy and the emergency-care policy";
    when section_501r_applies(o);
    when us.irc.core::begins(y, start);
    when us.irc.core::ends(y, ending);
    then duty EstablishFinancialAssistancePolicies {
        bearer o;
        goal achievement {
            condition fap_requirements_met_501r4(o, y);
            window [start, ending];
        }
    };
}
@source(IRC_S501_R, quote = "(A) limits amounts charged for emergency or other medically necessary care provided to individuals eligible for assistance under the financial assistance policy described in paragraph (4)(A) to not more than the amounts generally billed to individuals who have insurance covering such care, and")
rule RefrainFromExcessChargesProhibitionRule(o: Person, y: TaxableYear, start: Date, ending: Date) strict {
    label en official "section 501(r)(5)(A): a hospital organization to which section 501(r) applies is under a prohibition against charging an eligible individual more than the amounts generally billed to insured individuals";
    when section_501r_applies(o);
    when us.irc.core::begins(y, start);
    when us.irc.core::ends(y, ending);
    then prohibition RefrainFromExcessChargesToEligibleIndividuals {
        bearer o;
        action charged_eligible_individual_more_than_amounts_generally_billed_501r5A(o, y);
        window [start, ending];
    };
}
@source(IRC_S501_R, quote = "(B) prohibits the use of gross charges.")
rule RefrainFromGrossChargesProhibitionRule(o: Person, y: TaxableYear, start: Date, ending: Date) strict {
    label en official "section 501(r)(5)(B): a hospital organization to which section 501(r) applies is under a prohibition against the use of gross charges";
    when section_501r_applies(o);
    when us.irc.core::begins(y, start);
    when us.irc.core::ends(y, ending);
    then prohibition RefrainFromUsingGrossCharges {
        bearer o;
        action used_gross_charges_501r5B(o, y);
        window [start, ending];
    };
}
@source(IRC_S501_R, quote = "An organization meets the requirement of this paragraph only if the organization does not engage in extraordinary collection actions before the organization has made reasonable efforts to determine whether the individual is eligible for assistance under the financial assistance policy described in paragraph (4)(A).")
rule RefrainFromPrematureExtraordinaryCollectionProhibitionRule(o: Person, y: TaxableYear, start: Date, ending: Date) strict {
    label en official "section 501(r)(6): a hospital organization to which section 501(r) applies is under a prohibition against extraordinary collection actions before reasonable efforts to determine financial-assistance eligibility";
    when section_501r_applies(o);
    when us.irc.core::begins(y, start);
    when us.irc.core::ends(y, ending);
    then prohibition RefrainFromPrematureExtraordinaryCollection {
        bearer o;
        action extraordinary_collection_before_eligibility_effort_established(o, y);
        window [start, ending];
    };
}
