// Section 501(r) — additional requirements for certain hospitals.
//
// SCOPE (partial, as flagged by the task): (r)(1)-(3) — applicability and
// the community health needs assessment (CHNA) duty with its 3-year
// rolling window — modelled in full, with exact date/year arithmetic.
// (r)(4)-(6) — financial assistance policy, limitation on charges, and the
// billing/collection requirement — modelled as duties/prohibitions over
// their TOP-LEVEL condition only (the sub-elements of the FAP, e.g. the
// five (4)(A) content items, are not separately modelled this stage —
// TECH-GAPS row G71). (r)(2)(B) (multi-facility, per-facility compliance)
// is NOT modelled: `hospital_facility` is not a distinct entity in this
// package (a single `o: Person` operates at most one facility as far as
// this stage's scenarios need). (r)(7) (Secretary regulations/guidance) is
// NON_NORMATIVE — a directive to the Secretary to issue guidance, no
// consequence for a taxpayer.

// ---------------------------------------------------------------------
// (r)(2)(A): applicability.
// ---------------------------------------------------------------------

use self::{
    IRC_S501_R,
    Person,
    TaxableYear,
};

@source(IRC_S501_R, quote = "an organization which operates a facility which is required by a State to be licensed, registered, or similarly recognized as a hospital")
pub relation licensed_as_hospital_by_state(o: Person) kind empirical {
    label en official "the organization operates a facility required by a State to be licensed, registered, or similarly recognized as a hospital (section 501(r)(2)(A)(i))";
}
@source(IRC_S501_R, quote = "any other organization which the Secretary determines has the provision of hospital care as its principal function or purpose constituting the basis for its exemption under subsection (c)(3)")
pub external judgment relation SecretaryDeterminesHospitalCarePrincipalFunction(o: Person) {
    authority Secretary;
    label en official "the Secretary determines the organization has the provision of hospital care as its principal function or purpose constituting the basis for its section 501(c)(3) exemption (section 501(r)(2)(A)(ii)) — DECISION-0194 evaluative channel";
}
@source(IRC_S501_R, quote = "This subsection shall apply to—")
pub relation section_501r_applies(o: Person) kind institutional {
    label en official "section 501(r) applies to the organization";
}
@source(IRC_S501_R, quote = "an organization which operates a facility which is required by a State to be licensed, registered, or similarly recognized as a hospital")
rule Section501rAppliesViaStateLicense(o: Person) defeasible {
    label en official "section 501(r)(2)(A)(i): section 501(r) applies to an organization operating a state-licensed hospital facility";
    when licensed_as_hospital_by_state(o);
    then section_501r_applies(o);
}
@source(IRC_S501_R, quote = "any other organization which the Secretary determines has the provision of hospital care as its principal function or purpose constituting the basis for its exemption under subsection (c)(3)")
rule Section501rAppliesViaSecretaryDetermination(o: Person) defeasible {
    label en official "section 501(r)(2)(A)(ii): section 501(r) applies to an organization the Secretary determines has hospital care as its principal (c)(3) function";
    when SecretaryDeterminesHospitalCarePrincipalFunction(o);
    then section_501r_applies(o);
}

// ---------------------------------------------------------------------
// (r)(1) and (r)(3): the community health needs assessment gate.
// ---------------------------------------------------------------------

@source(IRC_S501_R, quote = "takes into account input from persons who represent the broad interests of the community served by the hospital facility, including those with special knowledge of or expertise in public health")
pub relation chna_takes_into_account_broad_community_input(o: Person, y: TaxableYear) kind empirical {
    label en official "the community health needs assessment takes into account input from persons representing the broad interests of the community served, including public-health expertise (section 501(r)(3)(B)(i))";
}
@source(IRC_S501_R, quote = "is made widely available to the public")
pub relation chna_made_widely_available(o: Person, y: TaxableYear) kind empirical {
    label en official "the community health needs assessment is made widely available to the public (section 501(r)(3)(B)(ii))";
}
@source(IRC_S501_R, quote = "has adopted an implementation strategy to meet the community health needs identified through such assessment")
pub relation chna_implementation_strategy_adopted(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization has adopted an implementation strategy to meet the community health needs identified through the assessment (section 501(r)(3)(A)(ii))";
}

@source(IRC_S501_R, quote = "A community health needs assessment meets the requirements of this paragraph if such community health needs assessment—")
pub relation chna_meets_requirements(o: Person, y: TaxableYear) kind institutional {
    label en official "the community health needs assessment conducted in this taxable year meets the section 501(r)(3)(B) requirements";
}
@source(IRC_S501_R, quote = "A community health needs assessment meets the requirements of this paragraph if such community health needs assessment—")
rule ChnaMeetsRequirements(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(r)(3)(B): the assessment meets the requirements if it takes into account broad community input and is made widely available";
    when chna_takes_into_account_broad_community_input(o, y);
    when chna_made_widely_available(o, y);
    then chna_meets_requirements(o, y);
}

// The 3-year rolling window ("in such taxable year or in either of the 2
// taxable years immediately preceding such taxable year") compared by
// exact calendar-year integer arithmetic (us.irc.core::calendar_year_of),
// never a date-duration guess.
@source(IRC_S501_R, quote = "has conducted a community health needs assessment which meets the requirements of subparagraph (B) in such taxable year or in either of the 2 taxable years immediately preceding such taxable year")
pub relation chna_requirement_satisfied_for_year(o: Person, y: TaxableYear) kind institutional {
    label en official "section 501(r)(3)(A): a qualifying community health needs assessment, with an adopted implementation strategy, exists for this taxable year or either of the 2 immediately preceding taxable years";
}
@source(IRC_S501_R, quote = "has conducted a community health needs assessment which meets the requirements of subparagraph (B) in such taxable year or in either of the 2 taxable years immediately preceding such taxable year")
rule ChnaRequirementSatisfiedForYear(o: Person, y: TaxableYear, y_assessed: TaxableYear, n: Integer, n_assessed: Integer) defeasible {
    label en official "section 501(r)(3)(A): the CHNA requirement is met for year y if a qualifying assessment (with implementation strategy) was conducted in y or either of the 2 preceding taxable years";
    when us.irc.core::calendar_year_of(y, n);
    when us.irc.core::calendar_year_of(y_assessed, n_assessed);
    when chna_meets_requirements(o, y_assessed);
    when chna_implementation_strategy_adopted(o, y_assessed);
    when n_assessed <= n;
    when (n - n_assessed) <= 2;
    then chna_requirement_satisfied_for_year(o, y);
}

// ---------------------------------------------------------------------
// (r)(4)-(6): financial assistance policy, limitation on charges, billing
// and collection — top-level condition only (see scope note above).
// ---------------------------------------------------------------------

@source(IRC_S501_R, quote = "An organization meets the requirements of this paragraph if the organization establishes the following policies:")
pub relation financial_assistance_policy_established(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization has established the written financial assistance policy and the written emergency-care policy described in section 501(r)(4)";
}
@source(IRC_S501_R, quote = "limits amounts charged for emergency or other medically necessary care provided to individuals eligible for assistance under the financial assistance policy described in paragraph (4)(A) to not more than the amounts generally billed to individuals who have insurance covering such care")
pub relation charges_limitation_prohibited_established(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization charged an eligible individual more than the amounts generally billed to insured individuals, or used gross charges — a breach of section 501(r)(5)";
}
@source(IRC_S501_R, quote = "the organization does not engage in extraordinary collection actions before the organization has made reasonable efforts to determine whether the individual is eligible for assistance under the financial assistance policy described in paragraph (4)(A)")
pub relation extraordinary_collection_before_eligibility_effort_established(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization engaged in extraordinary collection actions before making reasonable efforts to determine financial-assistance eligibility — a breach of section 501(r)(6)";
}

pub relation section_501r_requirements_met_for_year(o: Person, y: TaxableYear) kind institutional {
    label en official "the hospital organization meets all four section 501(r)(1) requirements for the taxable year";
}
@source(IRC_S501_R, quote = "A hospital organization to which this subsection applies shall not be treated as described in subsection (c)(3) unless the organization—")
rule Section501rRequirementsMet(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(r)(1): the hospital organization meets the CHNA, financial assistance, charges-limitation and billing/collection requirements";
    when chna_requirement_satisfied_for_year(o, y);
    when financial_assistance_policy_established(o, y);
    unless charges_limitation_prohibited_established(o, y);
    unless extraordinary_collection_before_eligibility_effort_established(o, y);
    then section_501r_requirements_met_for_year(o, y);
}

// The consequence: for a hospital organization to which section 501(r)
// applies, failing (r)(1) means the organization is NOT treated as
// described in section 501(c)(3), whatever section 501(c)(3) itself would
// otherwise say. Modelled as a prohibition on the organizational/
// operational classification bridging into `section_501c3` via `unless`.
@source(IRC_S501_R, quote = "A hospital organization to which this subsection applies shall not be treated as described in subsection (c)(3) unless the organization—")
rule Section501rFailureDeniesC3(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(r)(1): a hospital organization to which section 501(r) applies is not treated as described in section 501(c)(3) unless it meets all four (r)(1) requirements";
    when section_501r_applies(o);
    when us.irc.core::year_of(o, y);
    unless section_501r_requirements_met_for_year(o, y);
    then hospital_denied_501c3_by_501r(o, y);
}
pub relation hospital_denied_501c3_by_501r(o: Person, y: TaxableYear) kind institutional {
    label en official "the hospital organization is denied section 501(c)(3) treatment because it does not meet the section 501(r)(1) requirements";
}

// Duty framing: the CHNA obligation is a maintenance goal (a recurring
// obligation to keep a qualifying assessment on file at all times, not a
// one-off filing) with the beneficiary the community the hospital serves
// (no `Person` beneficiary the statute names — `beneficiary` omitted per
// the optional grammar production).
@source(IRC_S501_R, quote = "has conducted a community health needs assessment which meets the requirements of subparagraph (B) in such taxable year or in either of the 2 taxable years immediately preceding such taxable year, and")
rule ChnaDutyRule(o: Person, y: TaxableYear, start: Date, ending: Date) strict {
    label en official "section 501(r)(3)(A): a hospital organization to which section 501(r) applies is under a duty to maintain a qualifying community health needs assessment on a rolling 3-year basis, for the taxable year";
    when section_501r_applies(o);
    when us.irc.core::begins(y, start);
    when us.irc.core::ends(y, ending);
    then duty MaintainCommunityHealthNeedsAssessment {
        bearer o;
        goal maintenance {
            condition chna_requirement_satisfied_for_year(o, y);
            window [start, ending];
            completeness_policy ChnaCompletenessPolicy;
        }
    };
}
