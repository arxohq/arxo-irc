// Sections 529A and 530, stage 3, and the new section 530A (Trump accounts)
// added by Pub. L. 119-21 section 70204 (July 4, 2025), with the section 70115
// revision of section 529A(b)(2)(B). Windows follow us.irc.deductions: an
// `effective` window over legal_time and the amending fragment of
// us.irc.temporal as the `derives_from` source. Indexed amounts are A3
// parameters (AbleAnnualLimit529Ab2Bi) anchored on the Revenue Procedures pinned
// in us.irc.inflation_adjustments; a year without a pinned value stays
// MISSING_PARAMETER_VALUE.

// ---------------------------------------------------------------------
// Section 529A.
// ---------------------------------------------------------------------

use self::{
    IRC_S529A_B,
    IRC_S529A_C,
    IRC_S529A_D,
    IRC_S529A_E,
    IRC_S529A_F,
    IRC_S530_B,
    IRC_S530_C,
    IRC_S530_D,
    IRC_S530_F,
    IRC_S530_G,
    IRC_S530_H,
    Person,
    Secretary,
    TaxableYear,
    Trust,
    coverdell_cash_only_530b1Ai,
    qualified_able_program,
};

pub relation program_established_and_maintained_by_state_529Ab1(program: Person) kind empirical {
    label en official "the program is established and maintained by a State, or agency or instrumentality thereof";
}
pub relation program_accepts_contributions_for_eligible_individuals_529Ab1A(program: Person) kind empirical {
    label en official "a person may make contributions for a taxable year, for the benefit of an eligible individual, to an ABLE account established to meet the beneficiary's qualified disability expenses";
}
pub relation program_limits_beneficiary_to_one_able_account_529Ab1B(program: Person) kind empirical {
    label en official "the program limits a designated beneficiary to 1 ABLE account";
}
pub relation qualified_able_program_requirements_529Ab1(program: Person) kind institutional {
    label en official "the program meets the structural requirements of section 529A(b)(1)(A)-(B)";
}
@source(IRC_S529A_B, quote = "(A) under which a person may make contributions for a taxable year, for the benefit of an individual who is an eligible individual for such taxable year, to an ABLE account which is established for the purpose of meeting the qualified disability expenses of the designated beneficiary of the account,")
@source(IRC_S529A_B, quote = "(B) which limits a designated beneficiary to 1 ABLE account for purposes of this section, and")
@source(IRC_S529A_B, quote = "(C) which meets the other requirements of this section.")
rule QualifiedAbleProgramRequirements(program: Person) defeasible {
    label en official "section 529A(b)(1)";
    when program_established_and_maintained_by_state_529Ab1(program);
    when program_accepts_contributions_for_eligible_individuals_529Ab1A(program);
    when program_limits_beneficiary_to_one_able_account_529Ab1B(program);
    then qualified_able_program_requirements_529Ab1(program);
}
pub relation contribution_made_by_designated_beneficiary_529Ab2Bii(beneficiary: Person, y: TaxableYear) kind empirical {
    label en official "the contribution is made by the designated beneficiary";
}
pub relation no_contribution_to_defined_contribution_plan_for_year_529Ab7Ai(beneficiary: Person, y: TaxableYear) kind empirical {
    label en official "no contribution is made for the taxable year to a defined contribution plan (section 414(i)) meeting section 401(a) or 403(a)";
}
pub relation no_contribution_to_403b_annuity_for_year_529Ab7Aii(beneficiary: Person, y: TaxableYear) kind empirical {
    label en official "no contribution is made for the taxable year to an annuity contract described in section 403(b)";
}
pub relation no_contribution_to_457b_plan_for_year_529Ab7Aiii(beneficiary: Person, y: TaxableYear) kind empirical {
    label en official "no contribution is made for the taxable year to an eligible deferred compensation plan described in section 457(b)";
}
pub relation designated_beneficiary_is_employee_529Ab7A(beneficiary: Person, y: TaxableYear) kind empirical {
    label en official "the designated beneficiary is an employee (including an employee within the meaning of section 401(c))";
}
pub relation designated_beneficiary_described_in_529Ab7(beneficiary: Person, y: TaxableYear) kind institutional {
    label en official "the designated beneficiary is an employee with no contribution for the year to a qualified defined contribution plan, a section 403(b) annuity or a section 457(b) plan";
}
@source(IRC_S529A_B, quote = "For purposes of paragraph (2)(B)(ii)—")
@source(IRC_S529A_B, quote = "A designated beneficiary described in this paragraph is an employee (including an employee within the meaning of section 401(c)) with respect to whom—")
@source(IRC_S529A_B, quote = "(i) no contribution is made for the taxable year to a defined contribution plan (within the meaning of section 414(i)) with respect to which the requirements of section 401(a) or 403(a) are met,")
@source(IRC_S529A_B, quote = "(ii) no contribution is made for the taxable year to an annuity contract described in section 403(b), and")
@source(IRC_S529A_B, quote = "(iii) no contribution is made for the taxable year to an eligible deferred compensation plan described in section 457(b).")
rule DesignatedBeneficiaryDescribedIn529Ab7(beneficiary: Person, y: TaxableYear) defeasible {
    label en official "section 529A(b)(7)(A)(i)-(iii)";
    when designated_beneficiary_is_employee_529Ab7A(beneficiary, y);
    when no_contribution_to_defined_contribution_plan_for_year_529Ab7Ai(beneficiary, y);
    when no_contribution_to_403b_annuity_for_year_529Ab7Aii(beneficiary, y);
    when no_contribution_to_457b_plan_for_year_529Ab7Aiii(beneficiary, y);
    then designated_beneficiary_described_in_529Ab7(beneficiary, y);
}
pub relation compensation_includible_in_gross_income_529Ab2BiiI(beneficiary: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "compensation (as defined by section 219(f)(1)) includible in the designated beneficiary's gross income for the taxable year";
}
pub relation poverty_line_one_person_household_529Ab2BiiII(beneficiary: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the poverty line for a one-person household (section 673 of the Community Services Block Grant Act) as determined for the calendar year preceding the calendar year in which the taxable year begins — EXTERNAL_DEPENDENCY on the HHS poverty guidelines";
}
pub relation able_additional_contribution_room_529Ab2Bii(beneficiary: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the additional room for contributions by a paragraph (7) designated beneficiary: the lesser of compensation and the poverty line";
}
@source(IRC_S529A_B, quote = "(ii) in the case of any contribution by a designated beneficiary described in paragraph (7) before January 1, 2026, the lesser of—")
@source(IRC_S529A_B, quote = "(I) compensation (as defined by section 219(f)(1)) includible in the designated beneficiary's gross income for the taxable year, or")
@source(IRC_S529A_B, quote = "(II) an amount equal to the poverty line for a one-person household, as determined for the calendar year preceding the calendar year in which the taxable year begins.")
rule AbleAdditionalContributionRoom2025(beneficiary: Person, y: TaxableYear, comp: Money, poverty: Money) defeasible {
    label en official "section 529A(b)(2)(B)(ii) as in the 2024 edition: for a contribution by a paragraph (7) beneficiary before January 1, 2026, the lesser of compensation and the poverty line";
    effective [-infinity, @2026-01-01);
    when designated_beneficiary_described_in_529Ab7(beneficiary, y);
    when contribution_made_by_designated_beneficiary_529Ab2Bii(beneficiary, y);
    when compensation_includible_in_gross_income_529Ab2BiiI(beneficiary, y, comp);
    when poverty_line_one_person_household_529Ab2BiiII(beneficiary, y, poverty);
    then able_additional_contribution_room_529Ab2Bii(beneficiary, y, min(comp, poverty));
}
@source(us.irc.temporal::PL119_21_S70115, relation = derives_from, quote = "in clause (ii), by striking “before January 1, 2026”")
rule AbleAdditionalContributionRoomFrom2026(beneficiary: Person, y: TaxableYear, comp: Money, poverty: Money) defeasible {
    label en official "Pub. L. 119-21 section 70115(a)(2): the section 529A(b)(2)(B)(ii) additional room is no longer limited to contributions before January 1, 2026 — applies to contributions made after December 31, 2025";
    effective [@2026-01-01, infinity);
    when designated_beneficiary_described_in_529Ab7(beneficiary, y);
    when contribution_made_by_designated_beneficiary_529Ab2Bii(beneficiary, y);
    when compensation_includible_in_gross_income_529Ab2BiiI(beneficiary, y, comp);
    when poverty_line_one_person_household_529Ab2BiiII(beneficiary, y, poverty);
    then able_additional_contribution_room_529Ab2Bii(beneficiary, y, min(comp, poverty));
}
pub relation able_aggregate_contribution_limit_529Ab2B(beneficiary: Person, y: TaxableYear, limit: Money) kind institutional {
    label en official "the aggregate contributions from all contributors that the program may accept for the taxable year: the section 2503(b) amount (for taxable years beginning after 2025 with 1996 substituted for 1997 in section 2503(b)(2)(B)) plus any additional room";
}
pub relation able_contribution_room_type_529Ab2B(beneficiary: Person, y: TaxableYear) kind empirical {
    label en official "the taxable year for which the aggregate contribution limit is computed";
}
@source(us.irc.temporal::PL119_21_S70115, relation = derives_from, quote = "by inserting “(determined by substituting ‘1996’ for ‘1997’ in paragraph (2)(B) thereof)” after “section 2503(b)”")
@source(IRC_S529A_B, quote = "(i) the amount in effect under section 2503(b) for the calendar year in which the taxable year begins, plus")
rule AbleAggregateLimitWithAdditionalRoom(beneficiary: Person, y: TaxableYear, extra: Money) defeasible {
    label en official "section 529A(b)(2)(B)(i)-(ii): the annual amount (parameter AbleAnnualLimit529Ab2Bi, anchored on the Revenue Procedures) plus the (ii) additional room";
    when able_contribution_room_type_529Ab2B(beneficiary, y);
    when able_additional_contribution_room_529Ab2Bii(beneficiary, y, extra);
    then able_aggregate_contribution_limit_529Ab2B(beneficiary, y, AbleAnnualLimit529Ab2Bi + extra);
}
pub relation able_additional_room_absent_529Ab2Bii(beneficiary: Person, y: TaxableYear) kind institutional {
    label en official "helper: some additional room exists for the year (the exception atom that binds every head variable)";
}
rule AbleAdditionalRoomPresent(beneficiary: Person, y: TaxableYear, extra: Money) defeasible {
    label en official "helper";
    when able_contribution_room_type_529Ab2B(beneficiary, y);
    when able_additional_contribution_room_529Ab2Bii(beneficiary, y, extra);
    then able_additional_room_absent_529Ab2Bii(beneficiary, y);
}
@source(us.irc.temporal::PL119_21_S70115, relation = derives_from, quote = "by inserting “(determined by substituting ‘1996’ for ‘1997’ in paragraph (2)(B) thereof)” after “section 2503(b)”")
@source(IRC_S529A_B, quote = "(i) the amount in effect under section 2503(b) for the calendar year in which the taxable year begins, plus")
rule AbleAggregateLimitWithoutAdditionalRoom(beneficiary: Person, y: TaxableYear) defeasible {
    label en official "section 529A(b)(2)(B)(i): the annual amount alone when no additional room applies";
    when able_contribution_room_type_529Ab2B(beneficiary, y);
    unless able_additional_room_absent_529Ab2Bii(beneficiary, y);
    then able_aggregate_contribution_limit_529Ab2B(beneficiary, y, AbleAnnualLimit529Ab2Bi + 0.00 USD);
}
pub relation contributions_from_all_contributors_for_year_529Ab2B(beneficiary: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate contributions from all contributors to the ABLE account for the taxable year (other than rollovers under subsection (c)(1)(C))";
}
pub relation able_contribution_would_exceed_limit_529Ab2B(beneficiary: Person, y: TaxableYear) kind institutional {
    label en official "accepting the contribution would result in aggregate contributions exceeding the limit — the program may not accept it";
}
rule AbleContributionWouldExceedLimit(beneficiary: Person, y: TaxableYear, total: Money, limit: Money) defeasible {
    label en official "section 529A(b)(2)(B): aggregate contributions above the limit — exactly at the limit is accepted";
    when contributions_from_all_contributors_for_year_529Ab2B(beneficiary, y, total);
    when able_aggregate_contribution_limit_529Ab2B(beneficiary, y, limit);
    when total > limit;
    then able_contribution_would_exceed_limit_529Ab2B(beneficiary, y);
}
pub relation able_program_accepts_contribution_in_year_529Ab2(program: Person, beneficiary: Person, y: TaxableYear) kind empirical {
    label en official "the program accepted a contribution for the beneficiary in the taxable year";
}
@source(IRC_S529A_B, quote = "A program shall not be treated as a qualified ABLE program unless it provides that no contribution will be accepted—")
@source(IRC_S529A_B, quote = "(B) except in the case of contributions under subsection (c)(1)(C), if such contribution to an ABLE account would result in aggregate contributions from all contributors to the ABLE account for the taxable year exceeding the sum of—")
rule AbleProgramAcceptanceProhibitionRule(program: Person, y: TaxableYear, start: Date, ending: Date) strict {
    label en official "section 529A(b)(2)(B): a qualified ABLE program provides that no contribution will be accepted if it would push the year's aggregate contributions above the limit";
    when qualified_able_program(program);
    when us.irc.core::begins(y, start);
    when us.irc.core::ends(y, ending);
    then prohibition RefrainFromAcceptingContributionsAboveAbleLimit {
        bearer program;
        action able_program_accepts_contribution_above_limit_529Ab2B(program, y);
        window [start, ending];
    };
}
pub relation able_program_accepts_contribution_above_limit_529Ab2B(program: Person, y: TaxableYear) kind empirical {
    label en official "the program accepted a contribution that pushed the year's aggregate contributions above the limit";
}
// (c): rollovers, gift tax, additional tax, one account.
pub relation able_distribution_paid_into_another_able_account_529Ac1Ci(beneficiary: Person, distributed_on: Date, paid_on: Date, amount: Money) kind empirical {
    label en official "an amount paid or distributed from an ABLE account is paid into another ABLE account for the same beneficiary or an eligible family member";
}
pub relation able_rollover_not_includible_529Ac1Ci(beneficiary: Person, amount: Money) kind institutional {
    label en official "the rollover is not includible: paid not later than the 60th day after the distribution";
}
@source(IRC_S529A_C, quote = "Subparagraph (A) shall not apply to any amount paid or distributed from an ABLE account to the extent that the amount received is paid, not later than the 60th day after the date of such payment or distribution, into another ABLE account for the benefit of the same designated beneficiary or an eligible individual who is a member of the family of the designated beneficiary.")
rule AbleRolloverNotIncludible(beneficiary: Person, distributed_on: Date, paid_on: Date, amount: Money) defeasible {
    label en official "section 529A(c)(1)(C)(i): within 60 days (the 60th day is inclusive)";
    when able_distribution_paid_into_another_able_account_529Ac1Ci(beneficiary, distributed_on, paid_on, amount);
    when paid_on <= add_calendar_period(distributed_on, 60 calendar_day);
    then able_rollover_not_includible_529Ac1Ci(beneficiary, amount);
}
pub relation able_beneficiary_change_to_eligible_family_member_529Ac1Cii(old: Person, new: Person, y: TaxableYear) kind empirical {
    label en official "the designated beneficiary changed to a new beneficiary who is an eligible individual for the taxable year and a member of the family of the former beneficiary";
}
pub relation able_beneficiary_change_not_a_distribution_529Ac1Cii(old: Person, new: Person, y: TaxableYear) kind institutional {
    label en official "the change is not treated as a distribution";
}
@source(IRC_S529A_C, quote = "Any change in the designated beneficiary of an interest in a qualified ABLE program during a taxable year shall not be treated as a distribution for purposes of subparagraph (A) if the new beneficiary is an eligible individual for such taxable year and a member of the family of the former beneficiary.")
rule AbleBeneficiaryChangeNotADistribution(old: Person, new: Person, y: TaxableYear) defeasible {
    label en official "section 529A(c)(1)(C)(ii)";
    when able_beneficiary_change_to_eligible_family_member_529Ac1Cii(old, new, y);
    then able_beneficiary_change_not_a_distribution_529Ac1Cii(old, new, y);
}
pub relation able_transfer_for_benefit_of_beneficiary_on_529Ac1Ciii(beneficiary: Person, transferred_on: Date) kind empirical {
    label en official "a transfer to a qualified ABLE program for the benefit of the designated beneficiary on the date";
}
pub relation able_transfer_within_12_months_of_previous_529Ac1Ciii(beneficiary: Person, transferred_on: Date) kind institutional {
    label en official "the transfer occurs within 12 months from the date of a previous transfer — clause (i) does not apply to it";
}
@source(IRC_S529A_C, quote = "Clause (i) shall not apply to any transfer if such transfer occurs within 12 months from the date of a previous transfer to any qualified ABLE program for the benefit of the designated beneficiary.")
rule AbleTransferWithin12MonthsOfPrevious(beneficiary: Person, transferred_on: Date, previous: Date) defeasible {
    label en official "section 529A(c)(1)(C)(iii)";
    when able_transfer_for_benefit_of_beneficiary_on_529Ac1Ciii(beneficiary, transferred_on);
    when able_transfer_for_benefit_of_beneficiary_on_529Ac1Ciii(beneficiary, previous);
    when previous < transferred_on;
    when transferred_on < add_calendar_period(previous, 12 calendar_month);
    then able_transfer_within_12_months_of_previous_529Ac1Ciii(beneficiary, transferred_on);
}
pub relation able_contribution_to_program_529Ac2A(donor: Person, beneficiary: Person, amount: Money) kind empirical {
    label en official "a contribution to a qualified ABLE program on behalf of the designated beneficiary";
}
pub relation able_contribution_is_completed_gift_529Ac2A(donor: Person, beneficiary: Person) kind institutional {
    label en official "the contribution is a completed gift to the beneficiary which is not a future interest, and not a qualified transfer under section 2503(e)";
}
@source(IRC_S529A_C, quote = "Any contribution to a qualified ABLE program on behalf of any designated beneficiary—")
@source(IRC_S529A_C, quote = "(i) shall be treated as a completed gift to such designated beneficiary which is not a future interest in property, and")
@source(IRC_S529A_C, quote = "(ii) shall not be treated as a qualified transfer under section 2503(e).")
rule AbleContributionIsCompletedGift(donor: Person, beneficiary: Person, amount: Money) defeasible {
    label en official "section 529A(c)(2)(A)";
    when able_contribution_to_program_529Ac2A(donor, beneficiary, amount);
    then able_contribution_is_completed_gift_529Ac2A(donor, beneficiary);
}
pub relation able_distribution_to_designated_beneficiary_529Ac2B(beneficiary: Person, amount: Money) kind empirical {
    label en official "a distribution from an ABLE account to the account's designated beneficiary";
}
pub relation able_distribution_not_a_taxable_gift_529Ac2B(beneficiary: Person, amount: Money) kind institutional {
    label en official "in no event is the distribution a taxable gift";
}
@source(IRC_S529A_C, quote = "In no event shall a distribution from an ABLE account to such account's designated beneficiary be treated as a taxable gift.")
rule AbleDistributionNotATaxableGift(beneficiary: Person, amount: Money) defeasible {
    label en official "section 529A(c)(2)(B)";
    when able_distribution_to_designated_beneficiary_529Ac2B(beneficiary, amount);
    then able_distribution_not_a_taxable_gift_529Ac2B(beneficiary, amount);
}
pub relation able_additional_tax_529Ac3A(beneficiary: Person, y: TaxableYear, includible: Money, additional_tax: Money) kind institutional {
    label en official "the tax imposed for the taxable year is increased by 10 percent of the includible amount";
}
pub relation able_includible_distribution_529Ac3A(beneficiary: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of a distribution from a qualified ABLE program that is includible in gross income";
}
pub relation able_distribution_after_death_529Ac3B(beneficiary: Person, y: TaxableYear) kind empirical {
    label en official "the payment or distribution is made to a beneficiary (or the estate) on or after the death of the designated beneficiary";
}
pub relation able_contribution_returned_by_return_due_date_with_net_income_529Ac3C(beneficiary: Person, y: TaxableYear) kind empirical {
    label en official "the distribution of a contribution made during the taxable year is received on or before the day prescribed by law (including extensions) for filing the beneficiary's return for that year, accompanied by the net income attributable to the excess contribution";
}
pub relation able_additional_tax_exception_529Ac3(beneficiary: Person, y: TaxableYear, includible: Money) kind institutional {
    label en official "the additional tax does not apply";
}
@source(IRC_S529A_C, quote = "Subparagraph (A) shall not apply if the payment or distribution is made to a beneficiary (or to the estate of the designated beneficiary) on or after the death of the designated beneficiary.")
rule AbleAdditionalTaxExceptionDeath(beneficiary: Person, y: TaxableYear, includible: Money) defeasible {
    label en official "section 529A(c)(3)(B)";
    when able_includible_distribution_529Ac3A(beneficiary, y, includible);
    when able_distribution_after_death_529Ac3B(beneficiary, y);
    then able_additional_tax_exception_529Ac3(beneficiary, y, includible);
}
@source(IRC_S529A_C, quote = "Subparagraph (A) shall not apply to the distribution of any contribution made during a taxable year on behalf of the designated beneficiary if—")
@source(IRC_S529A_C, quote = "(i) such distribution is received on or before the day prescribed by law (including extensions of time) for filing such designated beneficiary's return for such taxable year, and")
@source(IRC_S529A_C, quote = "(ii) such distribution is accompanied by the amount of net income attributable to such excess contribution.")
@source(IRC_S529A_C, quote = "Any net income described in clause (ii) shall be included in gross income for the taxable year in which such excess contribution was made.")
rule AbleAdditionalTaxExceptionReturnedContribution(beneficiary: Person, y: TaxableYear, includible: Money) defeasible {
    label en official "section 529A(c)(3)(C)";
    when able_includible_distribution_529Ac3A(beneficiary, y, includible);
    when able_contribution_returned_by_return_due_date_with_net_income_529Ac3C(beneficiary, y);
    then able_additional_tax_exception_529Ac3(beneficiary, y, includible);
}
@source(IRC_S529A_C, quote = "The tax imposed by this chapter for any taxable year on any taxpayer who receives a distribution from a qualified ABLE program which is includible in gross income shall be increased by 10 percent of the amount which is so includible.")
rule AbleAdditionalTaxIsTenPercent(beneficiary: Person, y: TaxableYear, includible: Money) defeasible {
    label en official "section 529A(c)(3)(A): 10 percent of the includible amount, unless an exception applies";
    when able_includible_distribution_529Ac3A(beneficiary, y, includible);
    unless able_additional_tax_exception_529Ac3(beneficiary, y, includible);
    then able_additional_tax_529Ac3A(beneficiary, y, includible, round(includible * 0.10, 2, "HALF_UP"));
}
pub relation able_account_established_for_beneficiary_529Ac4(beneficiary: Person, account: Text, established_on: Date) kind empirical {
    label en official "an ABLE account established for the designated beneficiary on the date";
}
pub relation subsequent_account_not_an_able_account_529Ac4(beneficiary: Person, account: Text) kind institutional {
    label en official "the later account is not treated as an ABLE account";
}
@source(IRC_S529A_C, quote = "If an ABLE account is established for a designated beneficiary, no account subsequently established for such beneficiary shall be treated as an ABLE account. The preceding sentence shall not apply in the case of an account established for purposes of a rollover described in paragraph (1)(C)(i) of this section if the transferor account is closed as of the end of the 60th day referred to in paragraph (1)(C)(i).")
rule SubsequentAccountNotAnAbleAccount(beneficiary: Person, account: Text, established_on: Date, earlier: Date) defeasible {
    label en official "section 529A(c)(4): once an ABLE account is established, no account subsequently established for the beneficiary is treated as an ABLE account";
    when able_account_established_for_beneficiary_529Ac4(beneficiary, account, established_on);
    when able_account_established_for_beneficiary_529Ac4(beneficiary, "first", earlier);
    when earlier < established_on;
    then subsequent_account_not_an_able_account_529Ac4(beneficiary, account);
}
// (d): reports and notices.
pub relation officer_having_control_of_able_program_529Ad(officer: Person, program: Person) kind empirical {
    label en official "the officer or employee having control of the qualified ABLE program (or their designee)";
}
pub relation able_reports_made_529Ad1(program: Person, y: TaxableYear) kind empirical {
    label en official "the reports regarding the program to the Secretary and to designated beneficiaries were made";
}
@source(IRC_S529A_D, quote = "Each officer or employee having control of the qualified ABLE program or their designee shall make such reports regarding such program to the Secretary and to designated beneficiaries with respect to contributions, distributions, the return of excess contributions, and such other matters as the Secretary may require.")
rule MakeAbleProgramReportsDutyRule(officer: Person, program: Person, y: TaxableYear, start: Date, ending: Date) strict {
    label en official "section 529A(d)(1): the officer or employee having control of the program shall make reports to the Secretary and to designated beneficiaries";
    when officer_having_control_of_able_program_529Ad(officer, program);
    when us.irc.core::begins(y, start);
    when us.irc.core::ends(y, ending);
    then duty MakeAbleProgramReports {
        bearer officer;
        goal achievement {
            condition able_reports_made_529Ad1(program, y);
            window [start, ending];
        }
    };
}
pub relation able_account_established_notice_given_529Ad3(program: Person, account: Text) kind empirical {
    label en official "the program submitted to the Secretary the notice of the establishment of an ABLE account (with the name of the designated beneficiary and other required information)";
}
pub relation able_account_established_on_529Ad3(program: Person, account: Text, on: Date) kind empirical {
    label en official "the program established the ABLE account on the date";
}
@source(IRC_S529A_D, quote = "A qualified ABLE program shall submit a notice to the Secretary upon the establishment of an ABLE account. Such notice shall contain the name of the designated beneficiary and such other information as the Secretary may require.")
rule SubmitAbleAccountNoticeDutyRule(program: Person, account: Text, on: Date) strict {
    label en official "section 529A(d)(3): a qualified ABLE program shall submit a notice to the Secretary upon the establishment of an ABLE account";
    when able_account_established_on_529Ad3(program, account, on);
    then duty SubmitAbleAccountEstablishmentNotice {
        bearer program;
        beneficiary Secretary;
        goal achievement {
            condition able_account_established_notice_given_529Ad3(program, account);
            window [on, infinity];
        }
    };
}
pub relation state_monthly_submission_to_ssa_529Ad4(program: Person, month_end: Date) kind empirical {
    label en official "the State submitted electronically, on a monthly basis, to the Commissioner of Social Security the information required by section 103 of the Stephen Beck, Jr., ABLE Act of 2014";
}
pub relation state_maintains_able_program_month_529Ad4(program: Person, month_end: Date) kind empirical {
    label en official "the month (with its last day) for which the State's program is maintained";
}
@source(IRC_S529A_D, quote = "For purposes of section 103 of the Stephen Beck, Jr., ABLE Act of 2014, States shall submit electronically on a monthly basis to the Commissioner of Social Security, in the manner specified by the Commissioner, statements on relevant distributions and account balances from all ABLE accounts.")
rule MonthlySsaSubmissionDutyRule(program: Person, month_end: Date) strict {
    label en official "section 529A(d)(4): States shall submit information electronically on a monthly basis to the Commissioner of Social Security";
    when state_maintains_able_program_month_529Ad4(program, month_end);
    then duty SubmitMonthlyAbleInformationToSocialSecurity {
        bearer program;
        goal achievement {
            condition state_monthly_submission_to_ssa_529Ad4(program, month_end);
            window [month_end, add_calendar_period(month_end, 1 calendar_month)];
        }
    };
}
// (e): eligible individual and definitions.
pub relation entitled_to_ssa_benefits_based_on_blindness_or_disability_before_26_529Ae1A(individual: Person, y: TaxableYear) kind empirical {
    label en official "the individual is entitled to benefits based on blindness or disability under title II or XVI of the Social Security Act, and the blindness or disability occurred before the individual attained age 26 (age 46 for taxable years beginning after December 31, 2025 under the ABLE Age Adjustment Act, not pinned in the 2024 edition text)";
}
pub relation disability_certification_filed_529Ae1B(individual: Person, y: TaxableYear) kind empirical {
    label en official "a disability certification with respect to the individual is filed with the Secretary for the taxable year";
}
pub relation eligible_individual_529Ae1(individual: Person, y: TaxableYear) kind institutional {
    label en official "the individual is an eligible individual for the taxable year";
}
@source(IRC_S529A_E, quote = "An individual is an eligible individual for a taxable year if during such taxable year—")
@source(IRC_S529A_E, quote = "(A) the individual is entitled to benefits based on blindness or disability under title II or XVI of the Social Security Act, and such blindness or disability occurred before the date on which the individual attained age 26, or")
@source(IRC_S529A_E, quote = "(B) a disability certification with respect to such individual is filed with the Secretary for such taxable year.")
rule EligibleIndividualViaBenefitsAndCertification(individual: Person, y: TaxableYear) defeasible {
    label en official "section 529A(e)(1)(A)-(B)";
    when entitled_to_ssa_benefits_based_on_blindness_or_disability_before_26_529Ae1A(individual, y);
    when disability_certification_filed_529Ae1B(individual, y);
    then eligible_individual_529Ae1(individual, y);
}
pub relation medically_determinable_impairment_marked_and_severe_529Ae2Ai_I(individual: Person) kind empirical {
    label en official "the individual has a medically determinable physical or mental impairment which results in marked and severe functional limitations and can be expected to result in death or last a continuous period of not less than 12 months, or is blind";
}
pub relation blindness_or_disability_occurred_before_26_529Ae2Ai_II(individual: Person) kind empirical {
    label en official "the blindness or disability occurred before the date on which the individual attained age 26";
}
pub relation copy_of_signed_physician_diagnosis_included_529Ae2Aii(individual: Person) kind empirical {
    label en official "the certification includes a copy of the individual's diagnosis, signed by a licensed physician";
}
pub relation disability_certification_529Ae2A(individual: Person) kind institutional {
    label en official "a disability certification: a certification to the satisfaction of the Secretary by the individual or their parent or guardian that the (i) conditions are met and including the (ii) diagnosis";
}
@source(IRC_S529A_E, quote = "The term \"disability certification\" means, with respect to an individual, a certification to the satisfaction of the Secretary by the individual or the parent or guardian of the individual that—")
@source(IRC_S529A_E, quote = "(i) certifies that—")
@source(IRC_S529A_E, quote = "(I) the individual has a medically determinable physical or mental impairment, which results in marked and severe functional limitations, and which can be expected to result in death or which has lasted or can be expected to last for a continuous period of not less than 12 months, or is blind (within the meaning of section 1614(a)(2) of the Social Security Act), and")
@source(IRC_S529A_E, quote = "(II) such blindness or disability occurred before the date on which the individual attained age 26, and")
@source(IRC_S529A_E, quote = "(ii) includes a copy of the individual's diagnosis relating to the individual's relevant impairment or impairments, signed by a physician meeting the criteria of section 1861(r)(1) of the Social Security Act.")
rule DisabilityCertification(individual: Person) defeasible {
    label en official "section 529A(e)(2)(A)";
    when medically_determinable_impairment_marked_and_severe_529Ae2Ai_I(individual);
    when blindness_or_disability_occurred_before_26_529Ae2Ai_II(individual);
    when copy_of_signed_physician_diagnosis_included_529Ae2Aii(individual);
    then disability_certification_529Ae2A(individual);
}
pub relation account_established_and_owned_by_eligible_individual_under_qualified_program_529Ae6(account: Text) kind empirical {
    label en official "the account is established by an eligible individual, owned by that eligible individual, and maintained under a qualified ABLE program";
}
pub relation able_account_529Ae6(account: Text) kind institutional {
    label en official "the account is an ABLE account";
}
@source(IRC_S529A_E, quote = "The term \"ABLE account\" means an account established by an eligible individual, owned by such eligible individual, and maintained under a qualified ABLE program.")
rule AbleAccountDefinition(account: Text) defeasible {
    label en official "section 529A(e)(6)";
    when account_established_and_owned_by_eligible_individual_under_qualified_program_529Ae6(account);
    then able_account_529Ae6(account);
}
pub relation designated_beneficiary_is_eligible_individual_who_established_account_529Ae3(individual: Person, account: Text) kind empirical {
    label en official "the eligible individual who established an ABLE account under a qualified ABLE program";
}
pub relation designated_beneficiary_529Ae3(individual: Person, account: Text) kind institutional {
    label en official "the individual is the designated beneficiary of the ABLE account";
}
@source(IRC_S529A_E, quote = "The term \"designated beneficiary\" in connection with an ABLE account established under a qualified ABLE program means the eligible individual who established an ABLE account and is the owner of such account.")
rule DesignatedBeneficiaryOfAbleAccount(individual: Person, account: Text) defeasible {
    label en official "section 529A(e)(3)";
    when designated_beneficiary_is_eligible_individual_who_established_account_529Ae3(individual, account);
    then designated_beneficiary_529Ae3(individual, account);
}
pub external judgment relation ExpensesRelatedToBlindnessOrDisabilityAndForBenefitOfEligibleIndividual529Ae5(individual: Person, expense: Text) {
    authority Secretary;
    label en official "the expense is related to the eligible individual's blindness or disability and is made for the benefit of the eligible individual in the categories the text lists (education, housing, transportation, employment training, assistive technology, personal support services, health, prevention and wellness, financial management, legal fees, funeral and burial, and other expenses the Secretary may permit) (section 529A(e)(5)) — DECISION-0194 evaluative channel";
}
// (f): transfer to State.
pub relation amounts_remaining_in_able_account_on_death_529Af(beneficiary: Person, amount: Money) kind empirical {
    label en official "all amounts remaining in the qualified ABLE account on the death of the designated beneficiary, subject to any outstanding payments due for qualified disability expenses";
}
pub relation total_medical_assistance_paid_after_establishment_529Af(beneficiary: Person, amount: Money) kind empirical {
    label en official "the total medical assistance paid for the designated beneficiary under the State Medicaid plan after the establishment of the account";
}
pub relation premiums_paid_from_account_or_to_medicaid_buy_in_529Af(beneficiary: Person, amount: Money) kind empirical {
    label en official "premiums paid from the account or paid by or on behalf of the beneficiary to a Medicaid Buy-In program";
}
pub relation state_claim_for_payment_filed_529Af(beneficiary: Person, state: Person) kind empirical {
    label en official "the State filed a claim for payment";
}
pub relation state_claim_amount_529Af(beneficiary: Person, amount: Money) kind institutional {
    label en official "the amount distributable to the State: the remaining balance, but not more than medical assistance paid net of premiums";
}
@source(IRC_S529A_F, quote = "Subject to any outstanding payments due for qualified disability expenses, upon the death of the designated beneficiary, all amounts remaining in the qualified ABLE account not in excess of the amount equal to the total medical assistance paid for the designated beneficiary after the establishment of the account, net of any premiums paid from the account or paid by or on behalf of the beneficiary to a Medicaid Buy-In program under any State Medicaid plan established under title XIX of the Social")
rule StateClaimAmountIsLesserOfBalanceAndNetMedicalAssistance(beneficiary: Person, state: Person, balance: Money, assistance: Money, premiums: Money) defeasible {
    label en official "section 529A(f): the lesser of the remaining balance and (medical assistance paid - premiums), never below zero";
    when state_claim_for_payment_filed_529Af(beneficiary, state);
    when amounts_remaining_in_able_account_on_death_529Af(beneficiary, balance);
    when total_medical_assistance_paid_after_establishment_529Af(beneficiary, assistance);
    when premiums_paid_from_account_or_to_medicaid_buy_in_529Af(beneficiary, premiums);
    then state_claim_amount_529Af(beneficiary, min(balance, max(0.00 USD, assistance - premiums)));
}
@source(IRC_S529A_F, quote = "Subject to any outstanding payments due for qualified disability expenses, upon the death of the designated beneficiary, all amounts remaining in the qualified ABLE account not in excess of the amount equal to the total medical assistance paid for the designated beneficiary after the establishment of the account, net of any premiums paid from the account or paid by or on behalf of the beneficiary to a Medicaid Buy-In program under any State Medicaid plan established under title XIX of the Social")
rule DistributeToStateDutyRule(beneficiary: Person, state: Person, state_amt: Money, program: Person) strict {
    label en official "section 529A(f): upon the filing of the State's claim the program shall distribute the remaining amounts, up to the net medical assistance, to the State";
    when state_claim_for_payment_filed_529Af(beneficiary, state);
    when state_claim_amount_529Af(beneficiary, state_amt);
    when able_program_of_beneficiary_529Af(program, beneficiary);
    then duty DistributeRemainingAbleBalanceToState {
        bearer program;
        beneficiary state;
        goal achievement {
            condition amount_distributed_to_state_529Af(beneficiary, state_amt);
            window [-infinity, infinity];
        }
    };
}
pub relation able_program_of_beneficiary_529Af(program: Person, beneficiary: Person) kind empirical {
    label en official "the program that maintains the beneficiary's ABLE account";
}
pub relation amount_distributed_to_state_529Af(beneficiary: Person, amount: Money) kind empirical {
    label en official "the amount actually distributed to the State on the claim";
}

// ---------------------------------------------------------------------
// Section 530.
// ---------------------------------------------------------------------

pub relation coverdell_trust_created_in_us_exclusively_for_beneficiarys_expenses_530b1(account: Trust) kind empirical {
    label en official "a trust created or organized in the United States exclusively for the purpose of paying the qualified education expenses of the designated beneficiary, designated as a Coverdell education savings account when created";
}
pub relation coverdell_governing_instrument_no_life_insurance_530b1C(account: Trust) kind empirical {
    label en official "no part of the trust assets will be invested in life insurance contracts";
}
pub relation coverdell_governing_instrument_no_commingling_530b1D(account: Trust) kind empirical {
    label en official "the assets of the trust shall not be commingled with other property except in a common trust fund or common investment fund";
}
pub relation coverdell_trustee_is_bank_or_approved_530b1B(account: Trust) kind empirical {
    label en official "the trustee is a bank (as defined in section 408(n)) or another person who demonstrates to the satisfaction of the Secretary that its administration will be consistent with the requirements of this section";
}
pub relation coverdell_instrument_requires_age_30_distribution_530b1E(account: Trust) kind empirical {
    label en official "the balance to the credit of the beneficiary at age 30 (or death before 30) shall be distributed within 30 days";
}
pub relation coverdell_governing_instrument_requirements_met_530b1(account: Trust) kind institutional {
    label en official "the written governing instrument meets the requirements of section 530(b)(1)(A)-(E)";
}
@source(IRC_S530_B, quote = "The term \"Coverdell education savings account\" means a trust created or organized in the United States exclusively for the purpose of paying the qualified education expenses of an individual who is the designated beneficiary of the trust (and designated as a Coverdell education savings account at the time created or organized), but only if the written governing instrument creating the trust meets the following requirements:")
@source(IRC_S530_B, quote = "(B) The trustee is a bank (as defined in section 408(n)) or another person who demonstrates to the satisfaction of the Secretary that the manner in which that person will administer the trust will be consistent with the requirements of this section or who has so demonstrated with respect to any individual retirement plan.")
@source(IRC_S530_B, quote = "(C) No part of the trust assets will be invested in life insurance contracts.")
@source(IRC_S530_B, quote = "(D) The assets of the trust shall not be commingled with other property except in a common trust fund or common investment fund.")
@source(IRC_S530_B, quote = "(E) Except as provided in subsection (d)(7), any balance to the credit of the designated beneficiary on the date on which the beneficiary attains age 30 shall be distributed within 30 days after such date to the beneficiary or, if the beneficiary dies before attaining age 30, shall be distributed within 30 days after the date of death of such beneficiary.")
rule CoverdellGoverningInstrumentRequirementsMet(account: Trust) defeasible {
    label en official "section 530(b)(1)(A)-(E): cash-only and age limits and the annual limit (asserted by the existing relations), an approved trustee, no life insurance, no commingling, and the age-30 distribution";
    when coverdell_trust_created_in_us_exclusively_for_beneficiarys_expenses_530b1(account);
    when coverdell_cash_only_530b1Ai(account);
    when coverdell_trustee_is_bank_or_approved_530b1B(account);
    when coverdell_governing_instrument_no_life_insurance_530b1C(account);
    when coverdell_governing_instrument_no_commingling_530b1D(account);
    when coverdell_instrument_requires_age_30_distribution_530b1E(account);
    then coverdell_governing_instrument_requirements_met_530b1(account);
}
pub relation contribution_made_on_account_of_year_530b4(contributor: Person, account: Trust, y: TaxableYear, made_on: Date) kind empirical {
    label en official "the contribution made on the date on account of the taxable year";
}
pub relation return_due_date_without_extensions_530b4(contributor: Person, y: TaxableYear, due: Date) kind empirical {
    label en official "the time prescribed by law for filing the return for the taxable year, not including extensions";
}
pub relation contribution_deemed_made_on_last_day_of_preceding_year_530b4(contributor: Person, account: Trust, y: TaxableYear) kind institutional {
    label en official "the contribution is deemed made on the last day of the preceding taxable year";
}
@source(IRC_S530_B, quote = "An individual shall be deemed to have made a contribution to an education individual retirement account on the last day of the preceding taxable year if the contribution is made on account of such taxable year and is made not later than the time prescribed by law for filing the return for such taxable year (not including extensions thereof).")
rule ContributionDeemedMadeOnLastDayOfPrecedingYear(contributor: Person, account: Trust, y: TaxableYear, made_on: Date, due: Date) defeasible {
    label en official "section 530(b)(4): made on account of the year and not later than the return due date (the due date itself is timely; extensions do not count)";
    when contribution_made_on_account_of_year_530b4(contributor, account, y, made_on);
    when return_due_date_without_extensions_530b4(contributor, y, due);
    when made_on <= due;
    then contribution_deemed_made_on_last_day_of_preceding_year_530b4(contributor, account, y);
}
pub relation agi_530c2(contributor: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the contributor's adjusted gross income for the taxable year";
}
pub relation amount_excluded_under_911_931_or_933_530c2(contributor: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "any amount excluded from gross income under section 911, 931 or 933";
}
pub relation modified_agi_derived_530c2(contributor: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "modified adjusted gross income: AGI increased by the section 911, 931 and 933 exclusions";
}
@source(IRC_S530_C, quote = "For purposes of paragraph (1), the term \"modified adjusted gross income\" means the adjusted gross income of the taxpayer for the taxable year increased by any amount excluded from gross income under section 911, 931, or 933.")
rule ModifiedAdjustedGrossIncomeDerived(contributor: Person, y: TaxableYear, agi: Money, excluded: Money) defeasible {
    label en official "section 530(c)(2)";
    when agi_530c2(contributor, y, agi);
    when amount_excluded_under_911_931_or_933_530c2(contributor, y, excluded);
    then modified_agi_derived_530c2(contributor, y, agi + excluded);
}
pub relation qualified_education_expenses_of_beneficiary_530d2(beneficiary: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the qualified education expenses of the designated beneficiary during the taxable year";
}
pub relation aggregate_distributions_from_coverdell_accounts_530d2(beneficiary: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate distributions during the taxable year";
}
pub relation coverdell_expenses_after_reductions_530d2C(beneficiary: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "qualified education expenses after the (C)(i) reductions";
}
pub relation coverdell_expenses_reduced_under_25Ag2_530d2Ci_I(beneficiary: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the reduction provided in section 25A(g)(2)";
}
pub relation coverdell_expenses_used_for_25A_credit_530d2Ci_II(beneficiary: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the expenses taken into account in determining the credit allowed under section 25A";
}
@source(IRC_S530_D, quote = "The total amount of qualified education expenses with respect to an individual for the taxable year shall be reduced—")
@source(IRC_S530_D, quote = "(I) as provided in section 25A(g)(2), and")
@source(IRC_S530_D, quote = "(II) by the amount of such expenses which were taken into account in determining the credit allowed to the taxpayer or any other person under section 25A.")
rule CoverdellExpensesAfterReductions(beneficiary: Person, y: TaxableYear, expenses: Money, r1: Money, r2: Money) defeasible {
    label en official "section 530(d)(2)(C)(i): expenses reduced by the section 25A(g)(2) amount and the expenses used for the section 25A credit";
    when qualified_education_expenses_of_beneficiary_530d2(beneficiary, y, expenses);
    when coverdell_expenses_reduced_under_25Ag2_530d2Ci_I(beneficiary, y, r1);
    when coverdell_expenses_used_for_25A_credit_530d2Ci_II(beneficiary, y, r2);
    then coverdell_expenses_after_reductions_530d2C(beneficiary, y, max(0.00 USD, expenses - r1 - r2));
}
pub enum CoverdellAdditionalTaxException530d4B { DeathOfBeneficiary, Disability, ScholarshipAllowanceOrPayment, ServiceAcademyAttendance, IncludibleSolelyByRollover }
pub relation coverdell_distribution_exception_kind_530d4B(beneficiary: Person, y: TaxableYear, kind: CoverdellAdditionalTaxException530d4B) kind empirical {
    label en official "the payment or distribution is made to a beneficiary or the beneficiary's estate on or after the death of the designated beneficiary (i); attributable to the beneficiary being disabled (ii); made on account of a scholarship, allowance or payment described in section 25A(g)(2) to the extent it does not exceed it (iii); made on account of attendance at a United States service academy to the extent it does not exceed the costs of advanced education (iv); or includible solely by application of paragraph (2)(C)(i)(II) (v)";
}
pub relation coverdell_additional_tax_exception_derived_530d4B(beneficiary: Person, y: TaxableYear) kind institutional {
    label en official "the 10 percent additional tax does not apply";
}
@source(IRC_S530_D, quote = "Subparagraph (A) shall not apply if the payment or distribution is—")
@source(IRC_S530_D, quote = "(i) made to a beneficiary (or to the estate of the designated beneficiary) on or after the death of the designated beneficiary,")
@source(IRC_S530_D, quote = "(ii) attributable to the designated beneficiary's being disabled (within the meaning of section 72(m)(7)),")
@source(IRC_S530_D, quote = "(iii) made on account of a scholarship, allowance, or payment described in section 25A(g)(2) received by the designated beneficiary to the extent the amount of the payment or distribution does not exceed the amount of the scholarship, allowance, or payment,")
@source(IRC_S530_D, quote = "(iv) made on account of the attendance of the designated beneficiary at the United States Military Academy, the United States Naval Academy, the United States Air Force Academy, the United States Coast Guard Academy, or the United States Merchant Marine Academy, to the extent that the amount of the payment or distribution does not exceed the costs of advanced education (as defined by section 2005(e)(3) of title 10, United States Code, as in effect on the date of the enactment of this section) at")
@source(IRC_S530_D, quote = "(v) an amount which is includible in gross income solely by application of paragraph (2)(C)(i)(II) for the taxable year.")
rule CoverdellAdditionalTaxExceptionDerived(beneficiary: Person, y: TaxableYear, k: CoverdellAdditionalTaxException530d4B) defeasible {
    label en official "section 530(d)(4)(B)(i)-(v)";
    when coverdell_distribution_exception_kind_530d4B(beneficiary, y, k);
    then coverdell_additional_tax_exception_derived_530d4B(beneficiary, y);
}
pub relation coverdell_excess_contribution_withdrawn_on_530d4C(beneficiary: Person, y: TaxableYear, withdrawn_on: Date) kind empirical {
    label en official "the distribution of a contribution made during the taxable year, accompanied by the net income attributable to it";
}
pub relation first_day_of_sixth_month_of_following_year_530d4Cii(y: TaxableYear, day: Date) kind empirical {
    label en official "the first day of the sixth month of the taxable year following the taxable year";
}
pub relation coverdell_excess_contribution_returned_in_time_530d4C(beneficiary: Person, y: TaxableYear) kind institutional {
    label en official "the excess contribution was distributed, with its net income, before the first day of the sixth month of the following taxable year";
}
@source(IRC_S530_D, quote = "Subparagraph (A) shall not apply to the distribution of any contribution made during a taxable year on behalf of the designated beneficiary if—")
@source(IRC_S530_D, quote = "(i) such distribution is made before the first day of the sixth month of the taxable year following the taxable year, and")
@source(IRC_S530_D, quote = "(ii) such distribution is accompanied by the amount of net income attributable to such excess contribution.")
@source(IRC_S530_D, quote = "Any net income described in clause (ii) shall be included in gross income for the taxable year in which such excess contribution was made.")
rule CoverdellExcessContributionReturnedInTime(beneficiary: Person, y: TaxableYear, withdrawn_on: Date, deadline: Date) defeasible {
    label en official "section 530(d)(4)(C): made before the first day of the sixth month of the following year (that day itself is too late)";
    when coverdell_excess_contribution_withdrawn_on_530d4C(beneficiary, y, withdrawn_on);
    when first_day_of_sixth_month_of_following_year_530d4Cii(y, deadline);
    when withdrawn_on < deadline;
    then coverdell_excess_contribution_returned_in_time_530d4C(beneficiary, y);
}
pub relation coverdell_rollover_amount_530d5(beneficiary: Person, distributed_on: Date, rolled_on: Date, amount: Money) kind empirical {
    label en official "an amount paid or distributed from a Coverdell account paid into another Coverdell account for the same beneficiary or a member of the family";
}
pub relation coverdell_receiving_beneficiary_age_in_years_530d5(receiving: Person, age: Decimal) kind empirical {
    label en official "the age of the receiving beneficiary on the date of the rollover";
}
pub relation coverdell_rollover_not_includible_530d5(beneficiary: Person, amount: Money) kind institutional {
    label en official "the rollover is not includible in gross income";
}
@source(IRC_S530_D, quote = "Paragraph (1) shall not apply to any amount paid or distributed from a Coverdell education savings account to the extent that the amount received is paid, not later than the 60th day after the date of such payment or distribution, into another Coverdell education savings account for the benefit of the same beneficiary or a member of the family (within the meaning of section 529(e)(2)) of such beneficiary who has not attained age 30 as of such date. The preceding sentence shall not apply to any p")
rule CoverdellRolloverNotIncludible(beneficiary: Person, receiving: Person, distributed_on: Date, rolled_on: Date, amount: Money, age: Decimal) defeasible {
    label en official "section 530(d)(5): within 60 days (inclusive) into another account for the same beneficiary or a family member who has not attained age 30";
    when coverdell_rollover_amount_530d5(beneficiary, distributed_on, rolled_on, amount);
    when rolled_on <= add_calendar_period(distributed_on, 60 calendar_day);
    when coverdell_receiving_beneficiary_age_in_years_530d5(receiving, age);
    when age < 30.0;
    then coverdell_rollover_not_includible_530d5(beneficiary, amount);
}
pub relation coverdell_change_of_beneficiary_530d6(old: Person, new: Person, y: TaxableYear, new_age: Decimal) kind empirical {
    label en official "the beneficiary of a Coverdell account changed to a member of the family who has not attained age 30";
}
pub relation coverdell_change_not_a_distribution_530d6(old: Person, new: Person, y: TaxableYear) kind institutional {
    label en official "the change is not treated as a distribution";
}
@source(IRC_S530_D, quote = "Any change in the beneficiary of a Coverdell education savings account shall not be treated as a distribution for purposes of paragraph (1) if the new beneficiary is a member of the family (as so defined) of the old beneficiary and has not attained age 30 as of the date of such change.")
rule CoverdellChangeNotADistribution(old: Person, new: Person, y: TaxableYear, age: Decimal) defeasible {
    label en official "section 530(d)(6): the new beneficiary is a member of the family and not yet 30";
    when coverdell_change_of_beneficiary_530d6(old, new, y, age);
    when age < 30.0;
    then coverdell_change_not_a_distribution_530d6(old, new, y);
}
pub relation coverdell_age_30_date_530b1E(account: Trust, beneficiary: Person, thirtieth_birthday: Date) kind empirical {
    label en official "the date the beneficiary attains age 30";
}
pub relation coverdell_deemed_distribution_date_530d8(account: Trust, beneficiary: Person, on: Date) kind institutional {
    label en official "any balance at the close of the 30-day period after the age-30 date is deemed distributed at the close of that period";
}
@source(IRC_S530_D, quote = "In any case in which a distribution is required under subsection (b)(1)(E), any balance to the credit of a designated beneficiary as of the close of the 30-day period referred to in such subsection for making such distribution shall be deemed distributed at the close of such period.")
rule CoverdellBalanceDeemedDistributedAtCloseOfThirtyDays(account: Trust, beneficiary: Person, birthday: Date) defeasible {
    label en official "section 530(d)(8): the 30-day period after the beneficiary's 30th birthday";
    when coverdell_age_30_date_530b1E(account, beneficiary, birthday);
    then coverdell_deemed_distribution_date_530d8(account, beneficiary, add_calendar_period(birthday, 30 calendar_day));
}
pub relation death_gratuity_or_sgli_received_530d9A(contributor: Person, received_on: Date, amount: Money) kind empirical {
    label en official "the contributor receives an amount under section 1477 of title 10 or section 1967 of title 38 with respect to a person";
}
pub relation contributions_of_such_amounts_to_roth_or_other_coverdell_530d9Aii(contributor: Person, amount: Money) kind empirical {
    label en official "the amounts so received which were contributed to a Roth IRA under section 408A(e)(2) or to another Coverdell education savings account";
}
pub relation coverdell_contribution_530d9A(contributor: Person, contributed_on: Date, amount: Money) kind empirical {
    label en official "a contribution to a Coverdell education savings account";
}
pub relation coverdell_contribution_is_rollover_contribution_530d9A(contributor: Person, amount: Money) kind institutional {
    label en official "the contribution made within 1 year of receiving the death gratuity or SGLI payment is a rollover contribution, to the extent of the amount received less what was contributed elsewhere";
}
@source(IRC_S530_D, quote = "For purposes of this section, the term \"rollover contribution\" includes a contribution to a Coverdell education savings account made before the end of the 1-year period beginning on the date on which the contributor receives an amount under section 1477 of title 10, United States Code, or section 1967 of title 38 of such Code, with respect to a person, to the extent that such contribution does not exceed—")
@source(IRC_S530_D, quote = "(i) the sum of the amounts received during such period by such contributor under such sections with respect to such person, reduced by")
@source(IRC_S530_D, quote = "(ii) the amounts so received which were contributed to a Roth IRA under section 408A(e)(2) or to another Coverdell education savings account.")
rule CoverdellContributionIsRolloverContribution(contributor: Person, received_on: Date, received: Money, elsewhere: Money, contributed_on: Date, amount: Money) defeasible {
    label en official "section 530(d)(9)(A): within the 1-year period beginning on the receipt date (the last day is inclusive) and not above the receipts net of amounts contributed elsewhere";
    when death_gratuity_or_sgli_received_530d9A(contributor, received_on, received);
    when contributions_of_such_amounts_to_roth_or_other_coverdell_530d9Aii(contributor, elsewhere);
    when coverdell_contribution_530d9A(contributor, contributed_on, amount);
    when contributed_on < add_calendar_period(received_on, 1 calendar_year);
    when amount <= max(0.00 USD, received - elsewhere);
    then coverdell_contribution_is_rollover_contribution_530d9A(contributor, amount);
}
pub relation section_530_applied_without_regard_to_community_property_530f() kind institutional {
    label en official "this section is applied without regard to any community property laws";
}
@source(IRC_S530_F, quote = "This section shall be applied without regard to any community property laws.")
rule CommunityPropertyLawsDisregarded() defeasible {
    label en official "section 530(f)";
    when us.irc.core::year_of(Secretary, _);
    then section_530_applied_without_regard_to_community_property_530f();
}
pub relation custodial_account_held_by_bank_or_approved_person_530g(account: Text) kind empirical {
    label en official "the assets of the custodial account are held by a bank or another person who demonstrates to the Secretary's satisfaction that its administration is consistent with the requirements of this section";
}
pub relation custodial_account_would_be_a_coverdell_trust_but_for_form_530g(account: Text) kind empirical {
    label en official "the custodial account would, except for the fact that it is not a trust, constitute an account described in subsection (b)(1)";
}
pub relation custodial_account_treated_as_trust_530g(account: Text) kind institutional {
    label en official "the custodial account is treated as a trust";
}
@source(IRC_S530_G, quote = "For purposes of this section, a custodial account shall be treated as a trust if the assets of such account are held by a bank (as defined in section 408(n)) or another person who demonstrates, to the satisfaction of the Secretary, that the manner in which he will administer the account will be consistent with the requirements of this section, and if the custodial account would, except for the fact that it is not a trust, constitute an account described in subsection (b)(1). For purposes of this")
rule CustodialAccountTreatedAsTrust(account: Text) defeasible {
    label en official "section 530(g)";
    when custodial_account_held_by_bank_or_approved_person_530g(account);
    when custodial_account_would_be_a_coverdell_trust_but_for_form_530g(account);
    then custodial_account_treated_as_trust_530g(account);
}
pub relation trustee_of_coverdell_account_530h(trustee: Person, account: Trust) kind empirical {
    label en official "the trustee of a Coverdell education savings account";
}
pub relation section_530h_report_made(account: Trust, y: TaxableYear) kind empirical {
    label en official "the reports regarding the account to the Secretary and to the beneficiary with respect to contributions, distributions and other matters were made";
}
@source(IRC_S530_H, quote = "The trustee of a Coverdell education savings account shall make such reports regarding such account to the Secretary and to the beneficiary of the account with respect to contributions, distributions, and such other matters as the Secretary may require. The reports required by this subsection shall be filed at such time and in such manner and furnished to such individuals at such time and in such manner as may be required.")
rule MakeCoverdellReportsDutyRule(trustee: Person, account: Trust, y: TaxableYear, start: Date, ending: Date) strict {
    label en official "section 530(h): the trustee shall make reports to the Secretary and to the beneficiary";
    when trustee_of_coverdell_account_530h(trustee, account);
    when us.irc.core::begins(y, start);
    when us.irc.core::ends(y, ending);
    then duty MakeCoverdellAccountReports {
        bearer trustee;
        goal achievement {
            condition section_530h_report_made(account, y);
            window [start, ending];
        }
    };
}

// ---------------------------------------------------------------------
// Section 530A (Pub. L. 119-21 section 70204): Trump accounts.
// ---------------------------------------------------------------------

pub relation individual_has_not_attained_18_before_close_of_calendar_year_530Ab2A(individual: Person, election_year: Integer, age_at_year_end: Decimal) kind empirical {
    label en official "the individual has not attained the age of 18 before the close of the calendar year in which the election is made";
}
pub relation social_security_number_issued_before_election_530Ab2B(individual: Person) kind empirical {
    label en official "a social security number (within the meaning of section 24(h)(7)) has been issued for the individual before the date of the election";
}
pub relation election_made_by_secretary_530Ab2Ci(individual: Person) kind empirical {
    label en official "the Secretary made the election because the individual meets subparagraphs (A) and (B) and no prior election was made under clause (ii)";
}
pub relation election_made_by_other_person_530Ab2Cii(individual: Person) kind empirical {
    label en official "a person other than the Secretary made the election for the establishment of a Trump account and no prior election was made under clause (i)";
}
pub relation eligible_individual_530Ab2(individual: Person) kind institutional {
    label en official "the individual is an eligible individual for a Trump account";
}
@source(us.irc.temporal::PL119_21_S70204, relation = derives_from, quote = "The term ‘eligible individual’ means any individual—")
rule EligibleIndividualViaSecretaryElection(individual: Person, ey: Integer, age: Decimal) defeasible {
    label en official "section 530A(b)(2)(A), (B), (C)(i), added by Pub. L. 119-21 section 70204: under 18 by the close of the election year, a social security number issued, and an election by the Secretary";
    effective [@2026-01-01, infinity);
    when individual_has_not_attained_18_before_close_of_calendar_year_530Ab2A(individual, ey, age);
    when age < 18.0;
    when social_security_number_issued_before_election_530Ab2B(individual);
    when election_made_by_secretary_530Ab2Ci(individual);
    then eligible_individual_530Ab2(individual);
}
@source(us.irc.temporal::PL119_21_S70204, relation = derives_from, quote = "The term ‘eligible individual’ means any individual—")
rule EligibleIndividualViaOtherPersonElection(individual: Person, ey: Integer, age: Decimal) defeasible {
    label en official "section 530A(b)(2)(A), (B), (C)(ii), added by Pub. L. 119-21 section 70204: an election by a person other than the Secretary";
    effective [@2026-01-01, infinity);
    when individual_has_not_attained_18_before_close_of_calendar_year_530Ab2A(individual, ey, age);
    when age < 18.0;
    when social_security_number_issued_before_election_530Ab2B(individual);
    when election_made_by_other_person_530Ab2Cii(individual);
    then eligible_individual_530Ab2(individual);
}
pub enum QualifiedIndexBasis530Ab3B { StandardAndPoors500, OtherIndexOfPrimarilyUnitedStatesEquitiesWithRegulatedFutures }
pub relation fund_tracks_index_530Ab3Ai(fund: Text, basis: QualifiedIndexBasis530Ab3B) kind empirical {
    label en official "the fund tracks the returns of the Standard and Poor's 500 stock market index (B)(i), or of any other index comprised of equity investments in primarily United States companies for which regulated futures contracts (section 1256(g)(1)) are traded on a qualified board or exchange (B)(ii), and not an industry or sector-specific index";
}
pub relation fund_uses_leverage_530Ab3Aii(fund: Text) kind empirical {
    label en official "the fund uses leverage";
}
pub relation fund_annual_fees_and_expenses_percent_of_balance_530Ab3Aiii(fund: Text, percent: Decimal) kind empirical {
    label en official "the annual fees and expenses of the fund as a percentage of the balance of the investment in the fund";
}
pub relation fund_is_mutual_fund_or_etf_530Ab3A(fund: Text) kind empirical {
    label en official "the investment is a mutual fund or exchange traded fund";
}
pub relation eligible_investment_530Ab3(fund: Text) kind institutional {
    label en official "the fund is an eligible investment for a Trump account";
}
@source(us.irc.temporal::PL119_21_S70204, relation = derives_from, quote = "The term ‘eligible investment’ means any mutual fund or exchange traded fund which—")
rule EligibleInvestment(fund: Text, basis: QualifiedIndexBasis530Ab3B, pct: Decimal) defeasible {
    label en official "section 530A(b)(3)(A)-(B), added by Pub. L. 119-21 section 70204: a mutual fund or ETF tracking a qualified index, without leverage, with annual fees and expenses of not more than 0.1 percent of the balance — exactly 0.1 percent qualifies";
    effective [@2026-01-01, infinity);
    when fund_is_mutual_fund_or_etf_530Ab3A(fund);
    when fund_tracks_index_530Ab3Ai(fund, basis);
    unless fund_uses_leverage_for_fund_530Ab3Aii(fund, pct);
    when fund_annual_fees_and_expenses_percent_of_balance_530Ab3Aiii(fund, pct);
    when pct <= 0.1;
    then eligible_investment_530Ab3(fund);
}
pub relation fund_uses_leverage_for_fund_530Ab3Aii(fund: Text, pct: Decimal) kind institutional {
    label en official "helper: leverage bound to the fund and its fee figure (the exception atom that binds every head variable)";
}
rule FundUsesLeverageForFund(fund: Text, pct: Decimal) defeasible {
    label en official "helper";
    when fund_uses_leverage_530Ab3Aii(fund);
    when fund_annual_fees_and_expenses_percent_of_balance_530Ab3Aiii(fund, pct);
    then fund_uses_leverage_for_fund_530Ab3Aii(fund, pct);
}
pub relation trump_account_contribution_530Ac2(account: Text, beneficiary: Person, calendar_year: Integer, made_on: Date, amount: Money, exempt: Boolean) kind empirical {
    label en official "a contribution to a Trump account made before the calendar year in which the account beneficiary attains age 18; exempt contributions are qualified rollover contributions, qualified general contributions and contributions under section 6434";
}
pub relation aggregate_non_exempt_contributions_530Ac2A(account: Text, calendar_year: Integer, amount: Money) kind institutional {
    label en official "the aggregate contributions (other than exempt contributions) for the calendar year";
}
@source(us.irc.temporal::PL119_21_S70204, relation = derives_from, quote = "The aggregate amount of contributions (other than exempt contributions) for such calendar year shall not exceed $5,000.")
rule AggregateNonExemptContributions(account: Text, beneficiary: Person, calendar_year: Integer, made_on: Date, first: Money) defeasible {
    label en official "section 530A(c)(2)(A): the non-exempt contributions for the calendar year";
    effective [@2026-01-01, infinity);
    when trump_account_contribution_530Ac2(account, beneficiary, calendar_year, made_on, first, false);
    then aggregate_non_exempt_contributions_530Ac2A(account, calendar_year, sum all a: Money for d: Date where trump_account_contribution_530Ac2_amount_by_date(account, calendar_year, d, a));
}
pub relation trump_account_contribution_530Ac2_amount_by_date(account: Text, calendar_year: Integer, made_on: Date, amount: Money) kind empirical {
    label en official "a non-exempt contribution to the Trump account for the calendar year, by date (helper for the sum)";
}
pub relation trump_contribution_limit_530Ac2A(calendar_year: Integer, limit: Money) kind empirical {
    label en official "the contribution limit for the calendar year: $5,000, increased for taxable years after 2027 by the section 1(f)(3) cost-of-living adjustment with calendar year 2026 as the base, rounded down to a multiple of $100 — the indexed figures are not published in a pinned source, so the case supplies them (SOURCE_GAP)";
}
pub relation trump_contribution_limit_exceeded_530Ac2A(account: Text, calendar_year: Integer) kind institutional {
    label en official "the non-exempt contributions for the calendar year exceed the limit";
}
@source(us.irc.temporal::PL119_21_S70204, relation = derives_from, quote = "The aggregate amount of contributions (other than exempt contributions) for such calendar year shall not exceed $5,000.")
rule TrumpContributionLimitExceeded(account: Text, calendar_year: Integer, total: Money, limit: Money) defeasible {
    label en official "section 530A(c)(2)(A): aggregate non-exempt contributions above the limit — exactly at the limit does not exceed it";
    effective [@2026-01-01, infinity);
    when aggregate_non_exempt_contributions_530Ac2A(account, calendar_year, total);
    when trump_contribution_limit_530Ac2A(calendar_year, limit);
    when total > limit;
    then trump_contribution_limit_exceeded_530Ac2A(account, calendar_year);
}
pub relation trump_account_contribution_accepted_before_12_months_after_enactment_530Ab1Ci(account: Text, accepted_on: Date) kind empirical {
    label en official "a contribution was accepted on the date";
}
pub relation contribution_accepted_before_first_permitted_date_530Ab1Ci(account: Text, accepted_on: Date) kind institutional {
    label en official "a contribution was accepted before the date that is 12 months after the date of enactment (July 4, 2026)";
}
@source(us.irc.temporal::PL119_21_S70204, relation = derives_from, quote = "before the date that is 12 months after the date of the enactment of this section")
rule ContributionAcceptedBeforeFirstPermittedDate(account: Text, accepted_on: Date) defeasible {
    label en official "section 530A(b)(1)(C)(i)(I): no contribution will be accepted before the date that is 12 months after enactment (July 4, 2025 + 12 months = July 4, 2026)";
    effective [@2025-07-04, infinity);
    when trump_account_contribution_accepted_before_12_months_after_enactment_530Ab1Ci(account, accepted_on);
    when accepted_on < @2026-07-04;
    then contribution_accepted_before_first_permitted_date_530Ab1Ci(account, accepted_on);
}
pub relation trump_account_trustee_530A(trustee: Person, account: Text) kind empirical {
    label en official "the trustee of the Trump account";
}
pub relation trustee_accepts_contribution_violating_530Ab1C(trustee: Person, account: Text, y: TaxableYear) kind empirical {
    label en official "the trustee accepts a contribution before the first permitted date or above the annual limit";
}
@source(us.irc.temporal::PL119_21_S70204, relation = derives_from, quote = "No contribution will be accepted—")
rule TrumpTrusteeContributionProhibitionRule(trustee: Person, account: Text, y: TaxableYear, start: Date, ending: Date) strict {
    label en official "section 530A(b)(1)(C)(i): the governing instrument provides that no contribution will be accepted before the first permitted date, or above the annual limit — a prohibition on the trustee";
    when trump_account_trustee_530A(trustee, account);
    when us.irc.core::begins(y, start);
    when us.irc.core::ends(y, ending);
    then prohibition RefrainFromAcceptingNonPermittedTrumpAccountContributions {
        bearer trustee;
        action trustee_accepts_contribution_violating_530Ab1C(trustee, account, y);
        window [start, ending];
    };
}
pub enum TrumpDistributionException530Ad { QualifiedRolloverContribution, QualifiedAbleRolloverContribution, DistributionOfExcessContribution, DeathOfAccountBeneficiary }
pub relation trump_account_distribution_530Ad(trustee: Person, account: Text, beneficiary: Person, y: TaxableYear, made_on: Date) kind empirical {
    label en official "a distribution from a Trump account";
}
pub relation distribution_before_year_beneficiary_attains_18_530Ad1(account: Text, beneficiary: Person, made_on: Date) kind empirical {
    label en official "the distribution is made before the first day of the calendar year in which the account beneficiary attains age 18";
}
pub relation distribution_exception_530Ad(account: Text, beneficiary: Person, made_on: Date, kind: TrumpDistributionException530Ad) kind empirical {
    label en official "the distribution is a qualified rollover contribution (3), a qualified ABLE rollover contribution made in the calendar year the beneficiary attains age 17 (4), a distribution of an excess contribution (5), or occurs by reason of the beneficiary's death (6)";
}
pub relation distribution_allowed_530Ad(account: Text, beneficiary: Person, made_on: Date) kind institutional {
    label en official "the distribution is allowed: it is after the first day of the year the beneficiary attains 18, or within an exception";
}
@source(us.irc.temporal::PL119_21_S70204, relation = derives_from, quote = "no distribution shall be allowed before the first day of the calendar year in which the account beneficiary attains age 18")
rule DistributionAllowedViaException(account: Text, beneficiary: Person, made_on: Date, k: TrumpDistributionException530Ad) defeasible {
    label en official "section 530A(d)(3)-(6): the exceptions to the prohibition on early distributions";
    effective [@2026-01-01, infinity);
    when distribution_exception_530Ad(account, beneficiary, made_on, k);
    then distribution_allowed_530Ad(account, beneficiary, made_on);
}
pub relation distribution_on_or_after_first_day_of_year_beneficiary_attains_18_530Ad1(account: Text, beneficiary: Person, made_on: Date) kind empirical {
    label en official "the distribution is made on or after the first day of the calendar year in which the account beneficiary attains age 18";
}
@source(us.irc.temporal::PL119_21_S70204, relation = derives_from, quote = "no distribution shall be allowed before the first day of the calendar year in which the account beneficiary attains age 18")
rule DistributionAllowedAtAgeEighteenYear(account: Text, beneficiary: Person, made_on: Date) defeasible {
    label en official "section 530A(d)(1): distributions are allowed from the first day of the calendar year in which the beneficiary attains age 18";
    effective [@2026-01-01, infinity);
    when distribution_on_or_after_first_day_of_year_beneficiary_attains_18_530Ad1(account, beneficiary, made_on);
    then distribution_allowed_530Ad(account, beneficiary, made_on);
}
@source(us.irc.temporal::PL119_21_S70204, relation = derives_from, quote = "no distribution shall be allowed before the first day of the calendar year in which the account beneficiary attains age 18")
rule TrumpTrusteeDistributionProhibitionRule(trustee: Person, account: Text, beneficiary: Person, y: TaxableYear, made_on: Date, start: Date, ending: Date) strict {
    label en official "section 530A(d)(1): no distribution shall be allowed before the first day of the calendar year in which the account beneficiary attains age 18, except as the subsection provides — a prohibition on the trustee";
    effective [@2026-01-01, infinity);
    when trump_account_distribution_530Ad(trustee, account, beneficiary, y, made_on);
    when us.irc.core::begins(y, start);
    when us.irc.core::ends(y, ending);
    then prohibition RefrainFromEarlyTrumpAccountDistributions {
        bearer trustee;
        action early_distribution_not_within_exception_530Ad(trustee, account, beneficiary, made_on);
        window [start, ending];
    };
}
pub relation early_distribution_not_within_exception_530Ad(trustee: Person, account: Text, beneficiary: Person, made_on: Date) kind empirical {
    label en official "the trustee made a distribution before the first day of the calendar year in which the beneficiary attains age 18 that no exception allows";
}
pub relation trump_account_excess_contribution_530Ad5(account: Text, calendar_year: Integer, excess: Money) kind empirical {
    label en official "a contribution made before the year the beneficiary attains age 18 in excess of the limitation for the calendar year";
}
pub relation net_income_attributable_to_excess_530Ad5C(account: Text, y: TaxableYear, amount: Money) kind empirical {
    label en official "the net income attributable to the excess (determined without regard to subparagraph (B))";
}
pub relation excess_distribution_tax_increase_530Ad5C(account: Text, y: TaxableYear, amount: Money) kind institutional {
    label en official "the tax on the distributee is increased by 100 percent of the net income attributable to the excess";
}
@source(us.irc.temporal::PL119_21_S70204, relation = derives_from, quote = "the tax imposed by this chapter on the distributee for the taxable year in which the distribution is made shall be increased by 100 percent of the amount of net income attributable to such excess")
rule ExcessDistributionTaxIncrease(account: Text, y: TaxableYear, income: Money) defeasible {
    label en official "section 530A(d)(5)(C): 100 percent of the net income attributable to the excess";
    effective [@2026-01-01, infinity);
    when net_income_attributable_to_excess_530Ad5C(account, y, income);
    then excess_distribution_tax_increase_530Ad5C(account, y, income);
}
pub relation trump_account_death_of_beneficiary_530Ad6(account: Text, fair_market_value: Money, investment_in_contract: Money) kind empirical {
    label en official "the account beneficiary died before the first day of the calendar year in which the beneficiary would attain age 18: the fair market value of the assets on the date of death and the investment in the contract";
}
pub relation amount_includible_on_death_530Ad6C(account: Text, amount: Money) kind institutional {
    label en official "the fair market value of the assets, reduced by the investment in the contract, is includible in the acquirer's gross income (or the beneficiary's last taxable year when the estate acquires it)";
}
@source(us.irc.temporal::PL119_21_S70204, relation = derives_from, quote = "an amount equal to the fair market value of the assets (reduced by the investment in the contract) in such account on such date shall—")
rule AmountIncludibleOnDeath(account: Text, fmv: Money, basis: Money) defeasible {
    label en official "section 530A(d)(6)(C): fair market value less the investment in the contract";
    effective [@2026-01-01, infinity);
    when trump_account_death_of_beneficiary_530Ad6(account, fmv, basis);
    then amount_includible_on_death_530Ad6C(account, max(0.00 USD, fmv - basis));
}
pub relation qualified_general_contribution_pool_530Af1(pool: Text, amount: Money, class_size: Decimal) kind empirical {
    label en official "a general funding contribution made by the Secretary in the total amount for the number of account beneficiaries in the qualified class";
}
pub relation qualified_general_contribution_per_beneficiary_530Af1C(pool: Text, per_beneficiary: Money) kind institutional {
    label en official "each account beneficiary in the qualified class receives the ratio of the general funding contribution to the number of beneficiaries in the class";
}
@source(us.irc.temporal::PL119_21_S70204, relation = derives_from, quote = "is in an amount which is equal to the ratio of—")
rule QualifiedGeneralContributionPerBeneficiary(pool: Text, amount: Money, class_size: Decimal) defeasible {
    label en official "section 530A(f)(1)(C): the general funding contribution divided by the number of beneficiaries in the class, rounded to the cent";
    effective [@2026-01-01, infinity);
    when qualified_general_contribution_pool_530Af1(pool, amount, class_size);
    when class_size > 0.0;
    then qualified_general_contribution_per_beneficiary_530Af1C(pool, round(amount / class_size, 2, "HALF_UP"));
}
pub relation trump_account_report_trustee_530Ai(trustee: Person, account: Text) kind empirical {
    label en official "the trustee of a Trump account, for the reporting duties of subsection (i)";
}
pub relation contribution_over_25_dollars_from_person_other_than_secretary_account_beneficiary_or_parent_530Ai1A(account: Text, from_person: Person, amount: Money) kind empirical {
    label en official "a contribution in excess of $25 made by a person other than the Secretary, the account beneficiary, or the parent or legal guardian";
}
pub relation qualified_rollover_contribution_made_on_530Ai2(account: Text, made_on: Date) kind empirical {
    label en official "a qualified rollover contribution was made to the Trump account on the date";
}
pub relation section_530Ai2_report_made_on(account: Text, reported_on: Date) kind empirical {
    label en official "the trustee made the report to the Secretary on the date";
}
pub relation rollover_report_timely_530Ai2(account: Text) kind institutional {
    label en official "the report of the qualified rollover contribution was made not later than 30 days after it";
}
@source(us.irc.temporal::PL119_21_S70204, relation = derives_from, quote = "Not later than 30 days after the date of any qualified rollover contribution, the trustee of the Trump account to which the contribution was made shall make a report to the Secretary.")
rule RolloverReportTimely(account: Text, made_on: Date, reported_on: Date) defeasible {
    label en official "section 530A(i)(2): not later than 30 days after the rollover — the 30th day is inclusive";
    effective [@2026-01-01, infinity);
    when qualified_rollover_contribution_made_on_530Ai2(account, made_on);
    when section_530Ai2_report_made_on(account, reported_on);
    when reported_on <= add_calendar_period(made_on, 30 calendar_day);
    then rollover_report_timely_530Ai2(account);
}
@source(us.irc.temporal::PL119_21_S70204, relation = derives_from, quote = "Not later than 30 days after the date of any qualified rollover contribution, the trustee of the Trump account to which the contribution was made shall make a report to the Secretary.")
rule TrumpRolloverReportDutyRule(trustee: Person, account: Text, made_on: Date) strict {
    label en official "section 530A(i)(2): the trustee of the receiving Trump account shall report a qualified rollover contribution to the Secretary not later than 30 days after it";
    effective [@2026-01-01, infinity);
    when trump_account_report_trustee_530Ai(trustee, account);
    when qualified_rollover_contribution_made_on_530Ai2(account, made_on);
    then duty ReportTrumpAccountRolloverToSecretary {
        bearer trustee;
        beneficiary Secretary;
        goal achievement {
            condition rollover_report_timely_530Ai2(account);
            window [made_on, add_calendar_period(made_on, 30 calendar_day)];
        }
    };
}
