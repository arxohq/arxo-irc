// Exempt organizations -- WIRE-8 (26.09.2026, DECISION-0379 Д-22 item (б), implemented_unverified).
//
// The lower package `corporations` (section 532(b)(2)) declares a local contract for "the corporation is exempt from tax under
// subchapter F" and cannot import this package (this package imports `corporations`; a direct import back would be an import cycle).
// The owner of section 501 DERIVES the lower package's `pub` relation from its own exemption status with a qualified rule head
// (Д-13 item 5). JUDGMENT CALL: the derivation is one-directional. An organization exempt under section 501(a) is exempt under
// subchapter F; exemption under other sections of subchapter F (for example section 521 cooperatives) stays a case fact.
// The case-fact channel stays valid: scenarios of `corporations` never load this package.

language "law.core" version "0.2";
package us.irc.exempt_organizations version "0.1.1";
namespace "urn:us:irc:exempt_organizations:clir";

use self::{
    Corporation,
    Person,
    TaxableYear,
    exempt_organization,
};

rule W8ExemptUnderSubchapterFForSection532(c: Corporation, y: TaxableYear) strict {
    label en official "section 532(b)(2): a corporation exempt from taxation under section 501(a) for the year is exempt from tax under subchapter F";
    when exempt_organization(c, y);
    then us.irc.corporations::exempt_under_subchapter_f(c, y);
}
