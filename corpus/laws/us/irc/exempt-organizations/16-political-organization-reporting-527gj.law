// Section 527(g)-(j): newsletter funds, principal campaign committees, and
// the notice/reporting duties with their exact windows — STAGE 2b
// (25.09.2026).

use self::{
    Corporation,
    IRC_S527_G,
    IRC_S527_H,
    IRC_S527_I,
    IRC_S527_J,
    Person,
    TaxableYear,
    political_organization_taxable_income,
};

@source(IRC_S527_G, quote = "a fund established and maintained by an individual who holds, has been elected to, or is a candidate (within the meaning of paragraph (3)) for nomination or election to, any Federal, State, or local elective public office, for use by such individual exclusively for the preparation and circulation of such individual's newsletter shall, except as provided in paragraph (2), be treated as if such fund constituted a political organization.")
pub relation newsletter_fund_treated_as_political_organization_527g(fund: Person) kind institutional {
    label en official "section 527(g)(1): a candidate/officeholder's newsletter fund is treated as a political organization";
}
pub relation newsletter_fund_established_by_officeholder_or_candidate_527g1(fund: Person, individual: Person) kind empirical {
    label en official "the fund is established and maintained by an individual who holds, has been elected to, or is a candidate for a described public office, exclusively for preparing/circulating that individual's newsletter (section 527(g)(1))";
}
rule NewsletterFundTreatedAsPoliticalOrganization527g(fund: Person, individual: Person) defeasible {
    label en official "section 527(g)(1)";
    when newsletter_fund_established_by_officeholder_or_candidate_527g1(fund, individual);
    then newsletter_fund_treated_as_political_organization_527g(fund);
}
@source(IRC_S527_G, quote = "publicly announces that he is a candidate for nomination or election to such office, and")
pub relation candidate_527g3(individual: Person, office: Text) kind institutional {
    label en official "section 527(g)(3): a candidate — publicly announced and meeting the legal qualifications for the office";
}
pub relation publicly_announced_candidacy_527g3A(individual: Person, office: Text) kind empirical {
    label en official "the individual publicly announced candidacy for the office (section 527(g)(3)(A))";
}
pub relation meets_legal_qualifications_for_office_527g3B(individual: Person, office: Text) kind empirical {
    label en official "the individual meets the legal qualifications to hold the office (section 527(g)(3)(B))";
}
rule Candidate527g3(individual: Person, office: Text) defeasible {
    label en official "section 527(g)(3)(A)-(B)";
    when publicly_announced_candidacy_527g3A(individual, office);
    when meets_legal_qualifications_for_office_527g3B(individual, office);
    then candidate_527g3(individual, office);
}
@source(IRC_S527_G, quote = "the exempt function shall be only the preparation and circulation of the newsletter, and")
pub relation newsletter_fund_exempt_function_527g2A(fund: Person) kind institutional {
    label en official "section 527(g)(2)(A): the newsletter fund's exempt function is narrowed to only newsletter preparation/circulation";
}
@source(IRC_S527_G, quote = "the specific deduction provided by subsection (c)(2)(A) shall not be allowed.")
pub relation newsletter_fund_no_100_specific_deduction_527g2B(fund: Person) kind institutional {
    label en official "section 527(g)(2)(B): the newsletter fund does NOT get the section 527(c)(2)(A) $100 specific deduction";
}

@source(IRC_S527_H, quote = "In the case of a political organization, which is a principal campaign committee, paragraph (1) of subsection (b) shall be applied by substituting \"the appropriate rates\" for \"the highest rate\".")
pub relation principal_campaign_committee_appropriate_rates_527h(committee: Person, y: TaxableYear) kind institutional {
    label en official "section 527(h)(1): a principal campaign committee is taxed at the 'appropriate rates' (the graduated section 11(b) schedule, if any then in force) rather than the highest section 11(b) rate — since section 11(b) is a single flat rate under current law, this reduces to the same corporate_tax_rate import";
}
pub relation principal_campaign_committee_527h2(committee: Person, candidate: Person) kind institutional {
    label en official "section 527(h)(2): the political committee a candidate for Congress designates as the principal campaign committee under FECA section 302(e) and this subsection";
}
pub relation designated_as_principal_campaign_committee_527h2B(committee: Person, candidate: Person) kind empirical {
    label en official "the candidate has designated this committee as the principal campaign committee (section 527(h)(2)(B))";
}
rule PrincipalCampaignCommittee527h2(committee: Person, candidate: Person) defeasible {
    label en official "section 527(h)(2)";
    when designated_as_principal_campaign_committee_527h2B(committee, candidate);
    then principal_campaign_committee_527h2(committee, candidate);
}
rule PrincipalCampaignCommitteeAppropriateRates527h(committee: Person, candidate: Person, y: TaxableYear, income: Money, rate: Decimal) defeasible {
    label en official "section 527(h)(1): principal campaign committees taxed at the corporate rate, same wiring as section 527(b)/511(a)";
    when principal_campaign_committee_527h2(committee, candidate);
    when political_organization_taxable_income(committee, y, income);
    when us.irc.corporations::corporate_tax_rate(committee, y, rate);
    then principal_campaign_committee_appropriate_rates_527h(committee, y);
}

// --- (i): 24-hour/30-day notice duty, with the disclosure-window structure ---

@source(IRC_S527_I, quote = "Except as provided in paragraph (5), an organization shall not be treated as an organization described in this section—\n(A) unless it has given notice to the Secretary electronically that it is to be so treated, or")
pub relation section_527i_notice_duty_discharged(o: Person) kind institutional {
    label en official "section 527(i)(1)(A): the organization is treated as a section 527 organization only once it gives the Secretary electronic notice (subject to the (5) exceptions)";
}
@source(IRC_S527_I, quote = "The notice required under paragraph (1) shall be transmitted not later than 24 hours after the date on which the organization is established or, in the case of any material change in the information required under paragraph (3), not later than 30 days after such material change.")
pub relation section_527i_notice_duty(o: Person, established_on: Date, notified_on: Date) kind institutional {
    label en official "section 527(i)(2): a duty to transmit the section 527(i)(1) notice not later than 24 HOURS after the organization is established — the 30-day material-change window is a SEPARATE recurring duty, not modelled as a distinct relation this stage (TECH-GAPS G489)";
}
pub relation section_527i_notice_timely(o: Person, established_on: Date, notified_on: Date) kind institutional {
    label en unofficial "the section 527(i)(2) 24-hour notice window was met — TECH-GAPS G489: `Date` in this corpus is day-granularity only (no hour-level `add_calendar_period` unit exists, confirmed by grep of spec/grammar.ebnf and the whole corpus), so the EXACT 24-hour deadline cannot be computed the way the 60-day/90-day/10-year windows elsewhere in this package are; case-asserted directly rather than approximated as a 1-calendar-day window, which would silently misstate the statute";
}
pub relation organization_established_on_527i(o: Person, established_on: Date) kind empirical {
    label en official "the date the section 527 organization was established, for the section 527(i)(2) notice window";
}
pub relation section_527i_notice_given_on(o: Person, notified_on: Date) kind empirical {
    label en official "the date the organization gave the section 527(i) electronic notice";
}
rule Section527iNoticeDutyDischarged(o: Person, established_on: Date, notified_on: Date) defeasible {
    label en official "section 527(i)(1)(A): notice given (timeliness affects only the retroactive-taxation consequence of (i)(4), not the underlying duty)";
    when section_527i_notice_given_on(o, notified_on);
    then section_527i_notice_duty_discharged(o);
}
@source(IRC_S527_I, quote = "which reasonably anticipates that it will not have gross receipts of $25,000 or more for any taxable year, or")
pub relation section_527i5B_small_organization_exception(o: Person, y: TaxableYear) kind institutional {
    label en official "section 527(i)(5)(B): EXACT $25,000 gross-receipts exception from the notice duty";
}
pub relation reasonably_anticipated_gross_receipts_527i5B(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the organization's reasonably anticipated gross receipts for any taxable year (section 527(i)(5)(B))";
}
rule Section527i5BSmallOrganizationException(o: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 527(i)(5)(B): exact $25,000, no rounding";
    when reasonably_anticipated_gross_receipts_527i5B(o, y, amount);
    when amount < 25000.00 USD;
    then section_527i5B_small_organization_exception(o, y);
}

// --- (j): required disclosure of expenditures/contributions ---

@source(IRC_S527_J, quote = "A political organization which accepts a contribution, or makes an expenditure, for an exempt function during any calendar year shall file with the Secretary either—")
pub relation section_527j_disclosure_duty(o: Person, y: TaxableYear) kind institutional {
    label en official "section 527(j)(2): a political organization accepting a contribution or making an expenditure for an exempt function during a calendar year must file either the (A) quarterly/semiannual schedule or the (B) monthly schedule — a duty, achievement goal per filing deadline, the exact quarterly/monthly deadlines themselves are case-asserted per filing rather than derived as a generic calendar routine (TECH-GAPS G489)";
}
pub relation accepted_contribution_or_made_expenditure_for_exempt_function(o: Person, y: TaxableYear) kind empirical {
    label en official "the political organization accepted a contribution or made an expenditure for an exempt function during the calendar year (section 527(j)(2))";
}
rule Section527jDisclosureDuty(o: Person, y: TaxableYear) defeasible {
    label en official "section 527(j)(2): the disclosure duty arises";
    when accepted_contribution_or_made_expenditure_for_exempt_function(o, y);
    then section_527j_disclosure_duty(o, y);
}
@source(IRC_S527_J, quote = "there shall be paid by the organization an amount equal to the rate of tax specified in subsection (b)(1) multiplied by the amount to which the failure relates.")
pub relation section_527j_penalty_amount(o: Person, y: TaxableYear, failure_amount: Money, rate: Decimal, penalty: Money) kind institutional {
    label en official "section 527(j)(1): the penalty for a disclosure failure is the section 527(b)(1) rate (the same corporate_tax_rate import) times the amount to which the failure relates";
}
rule Section527jPenaltyAmount(o: Corporation, y: TaxableYear, failure_amount: Money, rate: Decimal) defeasible {
    label en official "section 527(j)(1): exact multiplication, same rate import as section 527(b)";
    when section_527j_disclosure_failure_amount(o, y, failure_amount);
    when us.irc.corporations::corporate_tax_rate(o, y, rate);
    then section_527j_penalty_amount(o, y, failure_amount, rate, round(failure_amount * rate, 2, "HALF_UP"));
}
pub relation section_527j_disclosure_failure_amount(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount to which a section 527(j)(1) disclosure failure relates";
}
@source(IRC_S527_J, quote = "to any organization which reasonably anticipates that it will not have gross receipts of $25,000 or more for any taxable year,")
pub relation section_527j5D_small_organization_exception(o: Person, y: TaxableYear) kind institutional {
    label en official "section 527(j)(5)(D): the same EXACT $25,000 gross-receipts exception as (i)(5)(B), for the disclosure duty";
}
rule Section527j5DSmallOrganizationException(o: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 527(j)(5)(D): exact $25,000";
    when reasonably_anticipated_gross_receipts_527i5B(o, y, amount);
    when amount < 25000.00 USD;
    then section_527j5D_small_organization_exception(o, y);
}
