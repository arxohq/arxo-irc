// Section 501(d)-(p), the (h) lobbying-expenditure test in full, and the
// remaining parts of (q) — stage 3. New denial relations are wired into the
// (a) exemption rules in 01-exemption-classification-501.law; new "deemed
// charitable" paths are wired into the (c)(3) classification through the two
// sibling rules at the end of this module.

// ---------------------------------------------------------------------
// (d): religious and apostolic associations.
// ---------------------------------------------------------------------

use self::{
    IRC_S501_D,
    IRC_S501_E,
    IRC_S501_F,
    IRC_S501_G,
    IRC_S501_H,
    IRC_S501_I,
    IRC_S501_J,
    IRC_S501_K,
    IRC_S501_M,
    IRC_S501_N,
    IRC_S501_O,
    IRC_S501_P,
    IRC_S501_Q,
    IRS,
    Person,
    Secretary,
    SubstantialLegislativeActivity,
    TaxableYear,
    TradeOrBusiness,
    activity_is_trade_or_business,
    credit_counseling_substantial_purpose,
    described_in_501d,
    dmp_attributable_revenue_501q2Aii,
    does_not_solicit_during_counseling_501q2Ai,
    exempt_organization,
    hospital_denied_501c3_by_501r,
    no_fee_bearing_loans_to_debtors_501q1Aii,
    no_separate_fee_for_credit_improvement_501q1Aiv,
    political_campaign_intervention_established,
    private_inurement_established,
    section_501c3,
    section_501c4,
    section_501c7,
    section_501h_election_eligible,
    section_501h_election_in_effect,
    section_501h_election_made,
    section_501h_election_revoked,
    section_501h_expenditures_exceed_ceiling,
    section_501q3_notice_given,
    section_501q_requirements_met,
    section_508_notice_requirement_unsatisfied_for_year,
    tailored_credit_counseling_services_501q1Ai,
    total_revenue_501q2Aii,
    unrelated_trade_or_business,
};

pub relation religious_or_apostolic_association_with_common_treasury_501d(o: Person, y: TaxableYear) kind empirical {
    label en official "the association or corporation is a religious or apostolic association or corporation with a common treasury or community treasury, even if it engages in business for the common benefit of the members (section 501(d))";
}
pub relation members_include_entire_pro_rata_share_in_gross_income_501d(o: Person, y: TaxableYear) kind empirical {
    label en official "the members include (at the time of filing their returns) in their gross incomes their entire pro rata shares, whether distributed or not, of the taxable income of the association or corporation for the year (section 501(d))";
}
@source(IRC_S501_D, quote = "The following organizations are referred to in subsection (a): Religious or apostolic associations or corporations, if such associations or corporations have a common treasury or community treasury, even if such associations or corporations engage in business for the common benefit of the members, but only if the members thereof include (at the time of filing their returns) in their gross income their entire pro rata shares, whether distributed or not, of the taxable income of the association or")
rule DescribedIn501dViaCommonTreasury(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(d): a religious or apostolic association with a common treasury, whose members include their entire pro rata shares of its taxable income, is described in subsection (d)";
    when religious_or_apostolic_association_with_common_treasury_501d(o, y);
    when members_include_entire_pro_rata_share_in_gross_income_501d(o, y);
    then described_in_501d(o, y);
}
pub relation member_pro_rata_share_of_taxable_income_501d(member: Person, o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the member's pro rata share of the taxable income of the association or corporation for the year";
}
pub relation member_share_treated_as_dividend_received_501d(member: Person, o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount included in the member's gross income is treated as a dividend received";
}
@source(IRC_S501_D, quote = "The following organizations are referred to in subsection (a): Religious or apostolic associations or corporations, if such associations or corporations have a common treasury or community treasury, even if such associations or corporations engage in business for the common benefit of the members, but only if the members thereof include (at the time of filing their returns) in their gross income their entire pro rata shares, whether distributed or not, of the taxable income of the association or")
rule MemberShareTreatedAsDividend(member: Person, o: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 501(d), last sentence: any amount so included in the gross income of a member is treated as a dividend received";
    when described_in_501d(o, y);
    when member_pro_rata_share_of_taxable_income_501d(member, o, y, amount);
    then member_share_treated_as_dividend_received_501d(member, o, y, amount);
}

// ---------------------------------------------------------------------
// (e): cooperative hospital service organizations.
// ---------------------------------------------------------------------

pub enum HospitalServiceKind501e { DataProcessing, Purchasing, Warehousing, BillingAndCollection, FoodService, ClinicalService, IndustrialEngineering, Laboratory, Printing, Communications, RecordCenter, PersonnelService }
pub relation performs_centralized_service_for_hospitals_501e1A(o: Person, y: TaxableYear, kind: HospitalServiceKind501e) kind empirical {
    label en official "the organization performs, on a centralized basis, a listed service which, if performed by a section 501(c)(3) hospital on its own behalf, would be an exempt-function activity (section 501(e)(1)(A))";
}
pub relation organized_and_operated_solely_for_centralized_hospital_services_501e1A(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization is organized and operated solely to perform those services (section 501(e)(1)(A))";
}
pub enum ServedHospitalKind501e1B { ExemptC3Hospital, ConstituentPartOfExemptC3Organization, GovernmentOwnedAndOperatedHospital }
pub relation served_hospital_501e1B(o: Person, y: TaxableYear, hospital: Person, kind: ServedHospitalKind501e1B) kind empirical {
    label en official "a hospital the organization serves: an exempt section 501(c)(3) organization (i), a constituent part of one that would itself be described in section 501(c)(3) (ii), or a hospital owned and operated by the United States, a State, the District of Columbia, a possession or a political subdivision, agency or instrumentality (iii)";
}
pub relation serves_only_qualifying_hospitals_501e1B(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization performs the services solely for two or more hospitals each of which is described in clause (i), (ii) or (iii) (section 501(e)(1)(B)) — the 'solely' universal is asserted, the two-hospital minimum is derived below";
}
pub relation serves_two_or_more_qualifying_hospitals_501e1B(o: Person, y: TaxableYear) kind institutional {
    label en official "the organization serves at least two distinct qualifying hospitals";
}
@source(IRC_S501_E, quote = "(B) to perform such services solely for two or more hospitals each of which is—")
@source(IRC_S501_E, quote = "(i) an organization described in subsection (c)(3) which is exempt from taxation under subsection (a),")
@source(IRC_S501_E, quote = "(ii) a constituent part of an organization described in subsection (c)(3) which is exempt from taxation under subsection (a) and which, if organized and operated as a separate entity, would constitute an organization described in subsection (c)(3), or")
@source(IRC_S501_E, quote = "(iii) owned and operated by the United States, a State, the District of Columbia, or a possession of the United States, or a political subdivision or an agency or instrumentality of any of the foregoing;")
rule ServesTwoOrMoreQualifyingHospitals(o: Person, y: TaxableYear, h1: Person, k1: ServedHospitalKind501e1B, h2: Person, k2: ServedHospitalKind501e1B) defeasible {
    label en official "section 501(e)(1)(B): at least two distinct hospitals of the listed kinds";
    when served_hospital_501e1B(o, y, h1, k1);
    when served_hospital_501e1B(o, y, h2, k2);
    when h1 != h2;
    then serves_two_or_more_qualifying_hospitals_501e1B(o, y);
}
pub relation operated_on_cooperative_basis_501e2(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization is organized and operated on a cooperative basis (section 501(e)(2))";
}
pub relation hospital_service_organization_year_bounds_501e2(o: Person, y: TaxableYear, start: Date, year_end: Date) kind empirical {
    label en official "the taxable-year bounds of the cooperative hospital service organization, for the 8½-month computation";
}
pub relation all_net_earnings_allocated_or_paid_to_patrons_by_501e2(o: Person, y: TaxableYear, on: Date) kind empirical {
    label en official "the date on which the organization completed allocating or paying all net earnings to patrons on the basis of services performed for them (section 501(e)(2))";
}
pub relation section_501e2_allocation_deadline(o: Person, y: TaxableYear, deadline: Date) kind institutional {
    label en official "the last day of the 8½ months after the close of the taxable year: the 15th day of the ninth month after the close";
}
@source(IRC_S501_E, quote = "(2) such organization is organized and operated on a cooperative basis and allocates or pays, within 8½ months after the close of its taxable year, all net earnings to patrons on the basis of services performed for them; and")
rule Section501e2AllocationDeadline(o: Person, y: TaxableYear, start: Date, year_end: Date) strict {
    label en official "section 501(e)(2): 8½ months after the close of the taxable year is the 15th day of the ninth month after the close (the same computation as section 1382(d)); a month is not 30 days";
    when hospital_service_organization_year_bounds_501e2(o, y, start, year_end);
    then section_501e2_allocation_deadline(o, y, add_calendar_period(add_calendar_period(year_end, 9 calendar_month), 15 calendar_day));
}
pub relation net_earnings_allocated_or_paid_within_8_and_half_months_501e2(o: Person, y: TaxableYear) kind institutional {
    label en official "the organization allocated or paid all net earnings to patrons within 8½ months after the close of its taxable year";
}
@source(IRC_S501_E, quote = "(2) such organization is organized and operated on a cooperative basis and allocates or pays, within 8½ months after the close of its taxable year, all net earnings to patrons on the basis of services performed for them; and")
rule NetEarningsAllocatedWithin8AndHalfMonths(o: Person, y: TaxableYear, on: Date, deadline: Date) defeasible {
    label en official "section 501(e)(2): allocation or payment on or before the deadline satisfies the 8½-month requirement";
    when all_net_earnings_allocated_or_paid_to_patrons_by_501e2(o, y, on);
    when section_501e2_allocation_deadline(o, y, deadline);
    when on <= deadline;
    then net_earnings_allocated_or_paid_within_8_and_half_months_501e2(o, y);
}
pub relation has_capital_stock_501e3(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization has capital stock";
}
pub relation all_outstanding_stock_owned_by_patrons_501e3(o: Person, y: TaxableYear) kind empirical {
    label en official "all of the organization's outstanding stock is owned by its patrons (section 501(e)(3))";
}
pub relation stock_condition_satisfied_501e3(o: Person, y: TaxableYear) kind institutional {
    label en official "section 501(e)(3): the organization has no capital stock, or all its outstanding stock is owned by its patrons";
}
@source(IRC_S501_E, quote = "(3) if such organization has capital stock, all of such stock outstanding is owned by its patrons.")
rule StockConditionSatisfiedByPatronOwnership(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(e)(3): all outstanding stock owned by patrons";
    when has_capital_stock_501e3(o, y);
    when all_outstanding_stock_owned_by_patrons_501e3(o, y);
    then stock_condition_satisfied_501e3(o, y);
}
pub relation has_no_capital_stock_501e3(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization has no capital stock";
}
@source(IRC_S501_E, quote = "(3) if such organization has capital stock, all of such stock outstanding is owned by its patrons.")
rule StockConditionSatisfiedWithoutStock(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(e)(3): an organization without capital stock has nothing to test";
    when has_no_capital_stock_501e3(o, y);
    then stock_condition_satisfied_501e3(o, y);
}
pub relation cooperative_hospital_service_organization_501e(o: Person, y: TaxableYear) kind institutional {
    label en official "the organization meets section 501(e)(1)-(3) and is treated as organized and operated exclusively for charitable purposes, and as a hospital and section 170(b)(1)(A)(iii) organization";
}
@source(IRC_S501_E, quote = "For purposes of this title, an organization shall be treated as an organization organized and operated exclusively for charitable purposes, if—")
@source(IRC_S501_E, quote = "(1) such organization is organized and operated solely—")
@source(IRC_S501_E, quote = "For purposes of this title, any organization which, by reason of the preceding sentence, is an organization described in subsection (c)(3) and exempt from taxation under subsection (a), shall be treated as a hospital and as an organization referred to in section 170(b)(1)(A)(iii).")
rule CooperativeHospitalServiceOrganization501e(o: Person, y: TaxableYear, kind: HospitalServiceKind501e) defeasible {
    label en official "section 501(e): centralized hospital services solely for two or more qualifying hospitals, on a cooperative basis with timely allocation of net earnings, and patron-owned stock";
    when organized_and_operated_solely_for_centralized_hospital_services_501e1A(o, y);
    when performs_centralized_service_for_hospitals_501e1A(o, y, kind);
    when serves_only_qualifying_hospitals_501e1B(o, y);
    when serves_two_or_more_qualifying_hospitals_501e1B(o, y);
    when operated_on_cooperative_basis_501e2(o, y);
    when net_earnings_allocated_or_paid_within_8_and_half_months_501e2(o, y);
    when stock_condition_satisfied_501e3(o, y);
    then cooperative_hospital_service_organization_501e(o, y);
}
pub relation treated_as_hospital_and_170b1Aiii_organization_501e(o: Person, y: TaxableYear) kind institutional {
    label en official "the organization is treated as a hospital and as an organization referred to in section 170(b)(1)(A)(iii)";
}
@source(IRC_S501_E, quote = "For purposes of this title, any organization which, by reason of the preceding sentence, is an organization described in subsection (c)(3) and exempt from taxation under subsection (a), shall be treated as a hospital and as an organization referred to in section 170(b)(1)(A)(iii).")
rule CooperativeHospitalServiceOrganizationTreatedAsHospital(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(e), last sentence: such an organization that is a section 501(c)(3) exempt organization is treated as a hospital and a section 170(b)(1)(A)(iii) organization";
    when cooperative_hospital_service_organization_501e(o, y);
    when exempt_organization(o, y);
    then treated_as_hospital_and_170b1Aiii_organization_501e(o, y);
}

// ---------------------------------------------------------------------
// (f): cooperative service organizations of operating educational organizations.
// ---------------------------------------------------------------------

pub relation organized_and_operated_solely_to_invest_members_moneys_and_turn_over_income_501f1(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization is organized and operated solely to hold, commingle, and collectively invest and reinvest in stocks and securities the moneys contributed by each member, and to collect the income and turn over the entire amount, less expenses, to the members (section 501(f)(1))";
}
pub relation organized_and_controlled_by_members_501f2(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization is organized and controlled by one or more of its members (section 501(f)(2))";
}
pub enum MemberKind501f3 { ExemptEducationalOrganization170b1Aii, ExemptSupportOfGovernmentSchools170b1Aiv, EducationalOrganizationIncomeExcludedUnder115, GovernmentSchoolSupportIncomeExcludedUnder115 }
pub relation member_501f3(o: Person, y: TaxableYear, member: Person, kind: MemberKind501f3) kind empirical {
    label en official "a member of the organization: an organization described in section 170(b)(1)(A)(ii) or (iv) that is exempt under subsection (a) (A) or whose income is excluded from taxation under section 115 (B)";
}
pub relation organization_has_member_not_described_in_501f3(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization has a member that is not an organization described in section 501(f)(3) — the 'comprised solely of' universal is a negation over the member list";
}
pub relation treated_as_charitable_cooperative_service_organization_501f(o: Person, y: TaxableYear) kind institutional {
    label en official "the organization is treated as organized and operated exclusively for charitable purposes (section 501(f))";
}
@source(IRC_S501_F, quote = "For purposes of this title, if an organization is—")
@source(IRC_S501_F, quote = "(1) organized and operated solely to hold, commingle, and collectively invest and reinvest (including arranging for and supervising the performance by independent contractors of investment services related thereto) in stocks and securities, the moneys contributed thereto by each of the members of such organization, and to collect income therefrom and turn over the entire amount thereof, less expenses, to such members,")
@source(IRC_S501_F, quote = "(2) organized and controlled by one or more such members, and")
@source(IRC_S501_F, quote = "(3) comprised solely of members that are organizations described in clause (ii) or (iv) of section 170(b)(1)(A)—")
@source(IRC_S501_F, quote = "then such organization shall be treated as an organization organized and operated exclusively for charitable purposes.")
rule CooperativeServiceOrganizationOfEducationalOrganizations501f(o: Person, y: TaxableYear, m: Person, k: MemberKind501f3) defeasible {
    label en official "section 501(f): investment cooperative organized and controlled by members, comprised solely of the listed educational members";
    when organized_and_operated_solely_to_invest_members_moneys_and_turn_over_income_501f1(o, y);
    when organized_and_controlled_by_members_501f2(o, y);
    when member_501f3(o, y, m, k);
    unless organization_has_member_not_described_in_501f3(o, y);
    then treated_as_charitable_cooperative_service_organization_501f(o, y);
}

// ---------------------------------------------------------------------
// (g): agricultural.
// ---------------------------------------------------------------------

pub enum AgriculturalActivityKind501g { CultivatingLand, HarvestingCrops, HarvestingAquaticResources, RaisingLivestock }
pub relation activity_kind_501g(activity: Text, kind: AgriculturalActivityKind501g) kind empirical {
    label en official "the activity is the art or science of cultivating land, harvesting crops or aquatic resources, or raising livestock";
}
pub relation agricultural_for_501c5_501g(activity: Text) kind institutional {
    label en official "the activity is 'agricultural' for purposes of subsection (c)(5)";
}
@source(IRC_S501_G, quote = "For purposes of subsection (c)(5), the term \"agricultural\" includes the art or science of cultivating land, harvesting crops or aquatic resources, or raising livestock.")
rule AgriculturalIncludesListedActivities(activity: Text, k: AgriculturalActivityKind501g) defeasible {
    label en official "section 501(g): 'agricultural' includes the art or science of cultivating land, harvesting crops or aquatic resources, or raising livestock";
    when activity_kind_501g(activity, k);
    then agricultural_for_501c5_501g(activity);
}

// ---------------------------------------------------------------------
// (h): the lobbying expenditure test.
// ---------------------------------------------------------------------

pub relation lobbying_expenditures_501h2A(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the organization's lobbying expenditures (expenditures for the purpose of influencing legislation as defined in section 4911(d)) for the taxable year (section 501(h)(2)(A)) — the section 4911(d) definition is an EXTERNAL_DEPENDENCY on us.irc.excise_entities";
}
pub relation lobbying_nontaxable_amount_4911_for_501h2B(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the lobbying nontaxable amount for the organization for the taxable year, determined under section 4911 — EXTERNAL_DEPENDENCY on us.irc.excise_entities";
}
pub relation grass_roots_expenditures_501h2C(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the organization's grass roots expenditures (section 4911(d) without regard to paragraph (1)(B) thereof) for the taxable year (section 501(h)(2)(C))";
}
pub relation grass_roots_nontaxable_amount_4911_for_501h2D(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the grass roots nontaxable amount for the organization for the taxable year, determined under section 4911 — EXTERNAL_DEPENDENCY on us.irc.excise_entities";
}
pub relation lobbying_ceiling_amount_501h2B(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the lobbying ceiling amount: 150 percent of the lobbying nontaxable amount";
}
@source(IRC_S501_H, quote = "The lobbying ceiling amount for any organization for any taxable year is 150 percent of the lobbying nontaxable amount for such organization for such taxable year, determined under section 4911.")
rule LobbyingCeilingIsOneHundredFiftyPercent(o: Person, y: TaxableYear, nontaxable: Money) defeasible {
    label en official "section 501(h)(2)(B): the lobbying ceiling amount is 150 percent of the lobbying nontaxable amount (exact decimal multiplication)";
    when lobbying_nontaxable_amount_4911_for_501h2B(o, y, nontaxable);
    then lobbying_ceiling_amount_501h2B(o, y, nontaxable * 1.50);
}
pub relation grass_roots_ceiling_amount_501h2D(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the grass roots ceiling amount: 150 percent of the grass roots nontaxable amount";
}
@source(IRC_S501_H, quote = "The grass roots ceiling amount for any organization for any taxable year is 150 percent of the grass roots nontaxable amount for such organization for such taxable year, determined under section 4911.")
rule GrassRootsCeilingIsOneHundredFiftyPercent(o: Person, y: TaxableYear, nontaxable: Money) defeasible {
    label en official "section 501(h)(2)(D): the grass roots ceiling amount is 150 percent of the grass roots nontaxable amount";
    when grass_roots_nontaxable_amount_4911_for_501h2D(o, y, nontaxable);
    then grass_roots_ceiling_amount_501h2D(o, y, nontaxable * 1.50);
}
pub relation lobbying_expenditures_exceed_ceiling_501h1A(o: Person, y: TaxableYear) kind institutional {
    label en official "the organization makes lobbying expenditures in excess of the lobbying ceiling amount for the taxable year";
}
@source(IRC_S501_H, quote = "(A) makes lobbying expenditures in excess of the lobbying ceiling amount for such organization for each taxable year, or")
rule LobbyingExpendituresExceedCeiling(o: Person, y: TaxableYear, spent: Money, ceiling: Money) defeasible {
    label en official "section 501(h)(1)(A): lobbying expenditures > the lobbying ceiling amount — at the ceiling does not exceed it";
    when lobbying_expenditures_501h2A(o, y, spent);
    when lobbying_ceiling_amount_501h2B(o, y, ceiling);
    when spent > ceiling;
    then lobbying_expenditures_exceed_ceiling_501h1A(o, y);
}
pub relation grass_roots_expenditures_exceed_ceiling_501h1B(o: Person, y: TaxableYear) kind institutional {
    label en official "the organization makes grass roots expenditures in excess of the grass roots ceiling amount for the taxable year";
}
@source(IRC_S501_H, quote = "(B) makes grass roots expenditures in excess of the grass roots ceiling amount for such organization for each taxable year.")
rule GrassRootsExpendituresExceedCeiling(o: Person, y: TaxableYear, spent: Money, ceiling: Money) defeasible {
    label en official "section 501(h)(1)(B): grass roots expenditures > the grass roots ceiling amount";
    when grass_roots_expenditures_501h2C(o, y, spent);
    when grass_roots_ceiling_amount_501h2D(o, y, ceiling);
    when spent > ceiling;
    then grass_roots_expenditures_exceed_ceiling_501h1B(o, y);
}
@source(IRC_S501_H, quote = "In the case of an organization to which this subsection applies, exemption from taxation under subsection (a) shall be denied because a substantial part of the activities of such organization consists of carrying on propaganda, or otherwise attempting, to influence legislation, but only if such organization normally—")
rule Section501hExceedsCeilingViaLobbying(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(h)(1): the expenditure test is failed when lobbying expenditures exceed the lobbying ceiling (the 'normally' averaging of regulations is not in the pinned text; the year's figures are read)";
    when lobbying_expenditures_exceed_ceiling_501h1A(o, y);
    then section_501h_expenditures_exceed_ceiling(o, y);
}
@source(IRC_S501_H, quote = "In the case of an organization to which this subsection applies, exemption from taxation under subsection (a) shall be denied because a substantial part of the activities of such organization consists of carrying on propaganda, or otherwise attempting, to influence legislation, but only if such organization normally—")
rule Section501hExceedsCeilingViaGrassRoots(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(h)(1): the expenditure test is failed when grass roots expenditures exceed the grass roots ceiling";
    when grass_roots_expenditures_exceed_ceiling_501h1B(o, y);
    then section_501h_expenditures_exceed_ceiling(o, y);
}
// (h)(3)-(5): eligibility.
pub enum Section501h4Kind { EducationalInstitution170b1Aii, HospitalOrMedicalResearch170b1Aiii, GovernmentSchoolSupport170b1Aiv, PubliclySupported170b1Avi, AgriculturalResearch170b1Aix, PubliclySupportedByAdmissionsAndSales509a2, SupportingOrganization509a3 }
pub relation described_in_501h4_kind(o: Person, kind: Section501h4Kind) kind empirical {
    label en official "the organization is described in the listed provision (section 501(h)(4)(A)-(G); for (G), section 509(a)(3) applied without regard to the last sentence of section 509(a))";
}
pub relation described_in_501h4(o: Person) kind institutional {
    label en official "the organization is described in section 501(h)(4)";
}
@source(IRC_S501_H, quote = "An organization is described in this paragraph if it is described in—")
@source(IRC_S501_H, quote = "(A) section 170(b)(1)(A)(ii) (relating to educational institutions),")
@source(IRC_S501_H, quote = "(B) section 170(b)(1)(A)(iii) (relating to hospitals and medical research organizations),")
@source(IRC_S501_H, quote = "(C) section 170(b)(1)(A)(iv) (relating to organizations supporting government schools),")
@source(IRC_S501_H, quote = "(D) section 170(b)(1)(A)(vi) (relating to organizations publicly supported by charitable contributions),")
@source(IRC_S501_H, quote = "(E) section 170(b)(1)(A)(ix) (relating to agricultural research organizations),")
@source(IRC_S501_H, quote = "(F) section 509(a)(2) (relating to organizations publicly supported by admissions, sales, etc.), or")
@source(IRC_S501_H, quote = "(G) section 509(a)(3) (relating to organizations supporting certain types of public charities) except that for purposes of this subparagraph, section 509(a)(3) shall be applied without regard to the last sentence of section 509(a).")
rule DescribedIn501h4(o: Person, k: Section501h4Kind) defeasible {
    label en official "section 501(h)(4)(A)-(G): the seven kinds of organization eligible for the election";
    when described_in_501h4_kind(o, k);
    then described_in_501h4(o);
}
pub relation church_170b1Ai_501h5A(o: Person) kind empirical {
    label en official "the organization is described in section 170(b)(1)(A)(i) (a church)";
}
pub relation integrated_auxiliary_of_church_501h5B(o: Person) kind empirical {
    label en official "the organization is an integrated auxiliary of a church or of a convention or association of churches";
}
pub relation member_of_affiliated_group_4911f2_501h5C(o: Person, other: Person) kind empirical {
    label en official "the other organization is a member of the same affiliated group of organizations (within the meaning of section 4911(f)(2)) — EXTERNAL_DEPENDENCY on us.irc.excise_entities";
}
pub relation disqualified_organization_501h5(o: Person) kind institutional {
    label en official "the organization is a disqualified organization under section 501(h)(5)";
}
@source(IRC_S501_H, quote = "(A) described in section 170(b)(1)(A)(i) (relating to churches),")
rule DisqualifiedOrganizationChurch(o: Person) defeasible {
    label en official "section 501(h)(5)(A): a church is disqualified";
    when church_170b1Ai_501h5A(o);
    then disqualified_organization_501h5(o);
}
@source(IRC_S501_H, quote = "(B) an integrated auxiliary of a church or of a convention or association of churches, or")
rule DisqualifiedOrganizationIntegratedAuxiliary(o: Person) defeasible {
    label en official "section 501(h)(5)(B): an integrated auxiliary of a church is disqualified";
    when integrated_auxiliary_of_church_501h5B(o);
    then disqualified_organization_501h5(o);
}
@source(IRC_S501_H, quote = "(C) a member of an affiliated group of organizations (within the meaning of section 4911(f)(2)) if one or more members of such group is described in subparagraph (A) or (B).")
rule DisqualifiedOrganizationAffiliatedWithChurch(o: Person, other: Person) defeasible {
    label en official "section 501(h)(5)(C): a member of an affiliated group with a member described in (A) or (B) is disqualified";
    when member_of_affiliated_group_4911f2_501h5C(o, other);
    when disqualified_by_own_status_501h5(other);
    then disqualified_organization_501h5(o);
}
pub relation disqualified_by_own_status_501h5(o: Person) kind institutional {
    label en official "the organization is itself a church or an integrated auxiliary of a church (the members of an affiliated group that make the group disqualifying)";
}
rule DisqualifiedByOwnStatusChurch(o: Person) defeasible {
    label en official "helper for section 501(h)(5)(C): a church";
    when church_170b1Ai_501h5A(o);
    then disqualified_by_own_status_501h5(o);
}
rule DisqualifiedByOwnStatusAuxiliary(o: Person) defeasible {
    label en official "helper for section 501(h)(5)(C): an integrated auxiliary";
    when integrated_auxiliary_of_church_501h5B(o);
    then disqualified_by_own_status_501h5(o);
}
@source(IRC_S501_H, quote = "This subsection shall apply to any organization which has elected (in such manner and at such time as the Secretary may prescribe) to have the provisions of this subsection apply to such organization and which, for the taxable year which includes the date the election is made, is described in subsection (c)(3) and—")
@source(IRC_S501_H, quote = "(A) is described in paragraph (4), and")
@source(IRC_S501_H, quote = "(B) is not a disqualified organization under paragraph (5).")
rule Section501hElectionEligibleWhenDescribedAndNotDisqualified(o: Person) defeasible {
    label en official "section 501(h)(3): the subsection applies to an organization described in paragraph (4) that is not a disqualified organization under paragraph (5) (the election itself is the power in 01)";
    when described_in_501h4(o);
    unless disqualified_organization_501h5(o);
    then section_501h_election_eligible(o);
}
// (h)(6): the years an election covers.
pub relation year_begins_on_or_after_revocation_501h6B(o: Person, y: TaxableYear) kind institutional {
    label en official "the taxable year begins on or after the date the election was revoked";
}
@source(IRC_S501_H, quote = "(B) begin before the date the election is revoked by such organization (under regulations prescribed by the Secretary).")
rule YearBeginsOnOrAfterRevocation(o: Person, y: TaxableYear, revoked_on: Date, year_start: Date) defeasible {
    label en official "section 501(h)(6)(B): an election covers only years that begin before the revocation date";
    when section_501h_election_revoked(o, revoked_on);
    when us.irc.core::begins(y, year_start);
    when year_start >= revoked_on;
    then year_begins_on_or_after_revocation_501h6B(o, y);
}
pub relation election_covers_taxable_year_501h6(o: Person, y: TaxableYear) kind institutional {
    label en official "the section 501(h) election is effective for the taxable year: the year ends after the election date and begins before any revocation date";
}
@source(IRC_S501_H, quote = "An election by an organization under this subsection shall be effective for all taxable years of such organization which—")
@source(IRC_S501_H, quote = "(A) end after the date the election is made, and")
rule ElectionCoversTaxableYear(o: Person, y: TaxableYear, made_on: Date, year_end: Date) defeasible {
    label en official "section 501(h)(6): a taxable year ending after the election date is covered until a revocation date on or before its first day";
    when section_501h_election_made(o, made_on);
    when us.irc.core::ends(y, year_end);
    when year_end > made_on;
    unless year_begins_on_or_after_revocation_501h6B(o, y);
    then election_covers_taxable_year_501h6(o, y);
}
@source(IRC_S501_H, quote = "An election by an organization under this subsection shall be effective for all taxable years of such organization which—")
rule ElectionInEffectForCoveredYears(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(h)(6): an election by an eligible organization is in effect for every year it covers";
    when election_covers_taxable_year_501h6(o, y);
    when section_501h_election_eligible(o);
    then section_501h_election_in_effect(o, y);
}

// ---------------------------------------------------------------------
// (i): social clubs — discrimination in governing instruments.
// ---------------------------------------------------------------------

pub enum DiscriminationBasis501i { Race, Color, Religion }
pub relation governing_instrument_or_written_policy_provides_discrimination_501i(o: Person, y: TaxableYear, basis: DiscriminationBasis501i) kind empirical {
    label en official "at some time during the taxable year the charter, bylaws or other governing instrument, or a written policy statement, contains a provision that provides for discrimination against a person on the basis of race, color, or religion (section 501(i))";
}
pub relation auxiliary_of_fraternal_beneficiary_society_limiting_membership_to_a_religion_501i1(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization is an auxiliary of a fraternal beneficiary society that is described in subsection (c)(8), exempt under (a), and limits its membership to the members of a particular religion (section 501(i)(1))";
}
pub relation club_in_good_faith_limits_membership_to_religion_501i2(o: Person, y: TaxableYear) kind empirical {
    label en official "the club in good faith limits its membership to the members of a particular religion in order to further the teachings or principles of that religion, and not to exclude individuals of a particular race or color (section 501(i)(2))";
}
pub relation religion_based_membership_exception_501i(o: Person, y: TaxableYear) kind institutional {
    label en official "the religion-discrimination bar does not apply to the organization";
}
@source(IRC_S501_I, quote = "(1) an auxiliary of a fraternal beneficiary society if such society—")
@source(IRC_S501_I, quote = "(A) is described in subsection (c)(8) and exempt from tax under subsection (a), and")
@source(IRC_S501_I, quote = "(B) limits its membership to the members of a particular religion, or")
rule ReligionExceptionForFraternalAuxiliary(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(i)(1): an auxiliary of a religion-limited fraternal beneficiary society";
    when auxiliary_of_fraternal_beneficiary_society_limiting_membership_to_a_religion_501i1(o, y);
    then religion_based_membership_exception_501i(o, y);
}
@source(IRC_S501_I, quote = "(2) a club which in good faith limits its membership to the members of a particular religion in order to further the teachings or principles of that religion, and not to exclude individuals of a particular race or color.")
rule ReligionExceptionForReligiousClub(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(i)(2): a club that in good faith limits membership to a religion to further its teachings";
    when club_in_good_faith_limits_membership_to_religion_501i2(o, y);
    then religion_based_membership_exception_501i(o, y);
}
pub relation exemption_denied_under_501i(o: Person, y: TaxableYear) kind institutional {
    label en official "a section 501(c)(7) organization is not exempt under subsection (a) for the taxable year because of a discriminatory provision";
}
@source(IRC_S501_I, quote = "Notwithstanding subsection (a), an organization which is described in subsection (c)(7) shall not be exempt from taxation under subsection (a) for any taxable year if, at any time during such taxable year, the charter, bylaws, or other governing instrument, of such organization or any written policy statement of such organization contains a provision which provides for discrimination against any person on the basis of race, color, or religion. The preceding sentence to the extent it relates to d")
rule ExemptionDeniedForRaceOrColorDiscrimination(o: Person, y: TaxableYear, basis: DiscriminationBasis501i) defeasible {
    label en official "section 501(i): a section 501(c)(7) organization with a governing-instrument or written-policy provision discriminating on the basis of race or color is not exempt for the year";
    when section_501c7(o, y);
    when governing_instrument_or_written_policy_provides_discrimination_501i(o, y, basis);
    when basis != DiscriminationBasis501i.Religion;
    then exemption_denied_under_501i(o, y);
}
@source(IRC_S501_I, quote = "Notwithstanding subsection (a), an organization which is described in subsection (c)(7) shall not be exempt from taxation under subsection (a) for any taxable year if, at any time during such taxable year, the charter, bylaws, or other governing instrument, of such organization or any written policy statement of such organization contains a provision which provides for discrimination against any person on the basis of race, color, or religion. The preceding sentence to the extent it relates to d")
rule ExemptionDeniedForReligionDiscrimination(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(i): a discriminatory religion provision denies exemption unless the (1) or (2) exception applies";
    when section_501c7(o, y);
    when governing_instrument_or_written_policy_provides_discrimination_501i(o, y, DiscriminationBasis501i.Religion);
    unless religion_based_membership_exception_501i(o, y);
    then exemption_denied_under_501i(o, y);
}

// ---------------------------------------------------------------------
// (j): qualified amateur sports organizations.
// ---------------------------------------------------------------------

pub relation organized_and_operated_exclusively_to_foster_national_or_international_amateur_sports_501j2(o: Person) kind empirical {
    label en official "the organization is organized and operated exclusively to foster national or international amateur sports competition (section 501(j)(2))";
}
pub relation organized_and_operated_primarily_to_conduct_national_or_international_competition_or_develop_athletes_501j2(o: Person) kind empirical {
    label en official "the organization is also organized and operated primarily to conduct national or international competition in sports or to support and develop amateur athletes for such competition (section 501(j)(2))";
}
pub relation qualified_amateur_sports_organization_501j2(o: Person) kind institutional {
    label en official "a qualified amateur sports organization";
}
@source(IRC_S501_J, quote = "For purposes of this subsection, the term \"qualified amateur sports organization\" means any organization organized and operated exclusively to foster national or international amateur sports competition if such organization is also organized and operated primarily to conduct national or international competition in sports or to support and develop amateur athletes for national or international competition in sports.")
rule QualifiedAmateurSportsOrganization(o: Person) defeasible {
    label en official "section 501(j)(2): exclusively fostering national or international amateur sports competition and primarily conducting it or supporting and developing athletes";
    when organized_and_operated_exclusively_to_foster_national_or_international_amateur_sports_501j2(o);
    when organized_and_operated_primarily_to_conduct_national_or_international_competition_or_develop_athletes_501j2(o);
    then qualified_amateur_sports_organization_501j2(o);
}
pub relation athletic_facilities_condition_disapplied_501j1A(o: Person) kind institutional {
    label en official "the section 501(c)(3) requirement that no part of the organization's activities involve the provision of athletic facilities or equipment does not apply";
}
@source(IRC_S501_J, quote = "(A) the requirement of subsection (c)(3) that no part of its activities involve the provision of athletic facilities or equipment shall not apply, and")
rule AthleticFacilitiesConditionDisapplied(o: Person) defeasible {
    label en official "section 501(j)(1)(A): for a qualified amateur sports organization the no-athletic-facilities requirement is disapplied";
    when qualified_amateur_sports_organization_501j2(o);
    then athletic_facilities_condition_disapplied_501j1A(o);
}
pub relation membership_local_or_regional_501j1B(o: Person) kind empirical {
    label en official "the membership of the organization is local or regional in nature";
}
pub relation local_or_regional_membership_does_not_defeat_c3_501j1B(o: Person) kind institutional {
    label en official "the organization does not fail to meet the section 501(c)(3) requirements merely because its membership is local or regional in nature";
}
@source(IRC_S501_J, quote = "(B) such organization shall not fail to meet the requirements of subsection (c)(3) merely because its membership is local or regional in nature.")
rule LocalOrRegionalMembershipDoesNotDefeatC3(o: Person) defeasible {
    label en official "section 501(j)(1)(B): local or regional membership of a qualified amateur sports organization is not disqualifying";
    when qualified_amateur_sports_organization_501j2(o);
    when membership_local_or_regional_501j1B(o);
    then local_or_regional_membership_does_not_defeat_c3_501j1B(o);
}

// ---------------------------------------------------------------------
// (k): child care as educational purposes.
// ---------------------------------------------------------------------

pub relation substantially_all_care_enables_gainful_employment_501k1(o: Person, y: TaxableYear) kind empirical {
    label en official "substantially all of the care provided by the organization is for purposes of enabling individuals to be gainfully employed (section 501(k)(1))";
}
pub relation child_care_services_available_to_general_public_501k2(o: Person, y: TaxableYear) kind empirical {
    label en official "the services provided by the organization are available to the general public (section 501(k)(2))";
}
pub relation child_care_is_educational_purpose_501k(o: Person, y: TaxableYear) kind institutional {
    label en official "the providing of care of children away from their homes is an 'educational purpose' for section 501(c)(3) and sections 170(c)(2), 2055(a)(2) and 2522(a)(2)";
}
@source(IRC_S501_K, quote = "For purposes of subsection (c)(3) of this section and sections 170(c)(2), 2055(a)(2), and 2522(a)(2), the term \"educational purposes\" includes the providing of care of children away from their homes if—")
@source(IRC_S501_K, quote = "(1) substantially all of the care provided by the organization is for purposes of enabling individuals to be gainfully employed, and")
@source(IRC_S501_K, quote = "(2) the services provided by the organization are available to the general public.")
rule ChildCareIsEducationalPurpose(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(k): child care away from home is educational when substantially all of it enables gainful employment and it is open to the general public";
    when substantially_all_care_enables_gainful_employment_501k1(o, y);
    when child_care_services_available_to_general_public_501k2(o, y);
    then child_care_is_educational_purpose_501k(o, y);
}

// ---------------------------------------------------------------------
// (m): commercial-type insurance.
// ---------------------------------------------------------------------

pub enum CommercialInsuranceExclusion501m3 { BelowCostToCharitableClass, IncidentalHmoHealthInsurance, ChurchPropertyOrCasualtyForItself, ChurchRetirementOrWelfareBenefits, CharitableGiftAnnuity }
pub relation insurance_activity_501m(tb: TradeOrBusiness) kind empirical {
    label en official "the activity consists of providing insurance";
}
pub relation issues_annuity_contracts_501m4(tb: TradeOrBusiness) kind empirical {
    label en official "the activity is the issuance of annuity contracts";
}
pub relation activity_is_insurance_501m4(tb: TradeOrBusiness) kind institutional {
    label en official "the activity is providing insurance, the issuance of annuity contracts being treated as providing insurance";
}
@source(IRC_S501_M, quote = "For purposes of this subsection, the issuance of annuity contracts shall be treated as providing insurance.")
rule ActivityIsInsuranceDirectly(tb: TradeOrBusiness) defeasible {
    label en official "section 501(m): providing insurance";
    when insurance_activity_501m(tb);
    then activity_is_insurance_501m4(tb);
}
@source(IRC_S501_M, quote = "For purposes of this subsection, the issuance of annuity contracts shall be treated as providing insurance.")
rule IssuingAnnuityContractsIsProvidingInsurance(tb: TradeOrBusiness) defeasible {
    label en official "section 501(m)(4): the issuance of annuity contracts is providing insurance";
    when issues_annuity_contracts_501m4(tb);
    then activity_is_insurance_501m4(tb);
}
pub relation insurance_activity_within_exclusion_501m3(tb: TradeOrBusiness, kind: CommercialInsuranceExclusion501m3) kind empirical {
    label en official "the insurance activity is within the listed exclusion from 'commercial-type insurance': insurance at substantially below cost to a class of charitable recipients (A), incidental health insurance customarily provided by a health maintenance organization (B), property or casualty insurance provided by a church for itself (C), retirement or welfare benefits provided by a church for its employees (D), charitable gift annuities (E)";
}
pub relation activity_excluded_from_commercial_type_insurance_501m3(tb: TradeOrBusiness) kind institutional {
    label en official "the insurance activity is not 'commercial-type insurance'";
}
@source(IRC_S501_M, quote = "For purposes of this subsection, the term \"commercial-type insurance\" shall not include—")
@source(IRC_S501_M, quote = "(A) insurance provided at substantially below cost to a class of charitable recipients,")
@source(IRC_S501_M, quote = "(B) incidental health insurance provided by a health maintenance organization of a kind customarily provided by such organizations,")
@source(IRC_S501_M, quote = "(C) property or casualty insurance provided (directly or through an organization described in section 414(e)(3)(B)(ii)) by a church or convention or association of churches for such church or convention or association of churches,")
@source(IRC_S501_M, quote = "(D) providing retirement or welfare benefits (or both) by a church or a convention or association of churches (directly or through an organization described in section 414(e)(3)(A) or 414(e)(3)(B)(ii)) for the employees (including employees described in section 414(e)(3)(B)) of such church or convention or association of churches or the beneficiaries of such employees, and")
@source(IRC_S501_M, quote = "(E) charitable gift annuities.")
rule ActivityExcludedFromCommercialTypeInsurance(tb: TradeOrBusiness, k: CommercialInsuranceExclusion501m3) defeasible {
    label en official "section 501(m)(3)(A)-(E): the five exclusions";
    when insurance_activity_within_exclusion_501m3(tb, k);
    then activity_excluded_from_commercial_type_insurance_501m3(tb);
}
pub relation gift_annuity_deduction_allowable_501m5A(tb: TradeOrBusiness) kind empirical {
    label en official "a portion of the amount paid in connection with the issuance of the annuity is allowable as a deduction under section 170 or 2055 (section 501(m)(5)(A))";
}
pub relation gift_annuity_described_in_514c5_501m5B(tb: TradeOrBusiness) kind empirical {
    label en official "the annuity is described in section 514(c)(5), determined as if any amount paid in cash in connection with the issuance were property (section 501(m)(5)(B))";
}
pub relation charitable_gift_annuity_501m5(tb: TradeOrBusiness) kind institutional {
    label en official "the annuity is a charitable gift annuity";
}
@source(IRC_S501_M, quote = "For purposes of paragraph (3)(E), the term \"charitable gift annuity\" means an annuity if—")
@source(IRC_S501_M, quote = "(A) a portion of the amount paid in connection with the issuance of the annuity is allowable as a deduction under section 170 or 2055, and")
@source(IRC_S501_M, quote = "(B) the annuity is described in section 514(c)(5) (determined as if any amount paid in cash in connection with such issuance were property).")
rule CharitableGiftAnnuityDefinition(tb: TradeOrBusiness) defeasible {
    label en official "section 501(m)(5): a deductible-portion annuity that is described in section 514(c)(5)";
    when gift_annuity_deduction_allowable_501m5A(tb);
    when gift_annuity_described_in_514c5_501m5B(tb);
    then charitable_gift_annuity_501m5(tb);
}
pub relation commercial_type_insurance_activity_501m(tb: TradeOrBusiness) kind institutional {
    label en official "the activity is commercial-type insurance";
}
@source(IRC_S501_M, quote = "For purposes of this subsection, the term \"commercial-type insurance\" shall not include—")
rule CommercialTypeInsuranceActivity(tb: TradeOrBusiness) defeasible {
    label en official "section 501(m)(3): insurance that is not within one of the five exclusions is commercial-type insurance";
    when activity_is_insurance_501m4(tb);
    unless activity_excluded_from_commercial_type_insurance_501m3(tb);
    then commercial_type_insurance_activity_501m(tb);
}
pub external judgment relation SubstantialPartOfActivitiesConsistsOfCommercialTypeInsurance501m1(o: Person, y: TaxableYear) {
    authority Secretary;
    label en official "a substantial part of the organization's activities consists of providing commercial-type insurance (section 501(m)(1)) — DECISION-0194 evaluative channel";
}
pub relation described_in_501c3_or_501c4_for_501m(o: Person, y: TaxableYear) kind institutional {
    label en official "the organization is described in paragraph (3) or (4) of subsection (c)";
}
rule DescribedInC3ForSection501m(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(m)(1): a paragraph (3) organization";
    when section_501c3(o, y);
    then described_in_501c3_or_501c4_for_501m(o, y);
}
rule DescribedInC4ForSection501m(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(m)(1): a paragraph (4) organization";
    when section_501c4(o, y);
    then described_in_501c3_or_501c4_for_501m(o, y);
}
pub relation exemption_denied_under_501m1(o: Person, y: TaxableYear) kind institutional {
    label en official "a section 501(c)(3) or (4) organization is not exempt under subsection (a) because a substantial part of its activities consists of providing commercial-type insurance";
}
@source(IRC_S501_M, quote = "An organization described in paragraph (3) or (4) of subsection (c) shall be exempt from tax under subsection (a) only if no substantial part of its activities consists of providing commercial-type insurance.")
rule ExemptionDeniedForSubstantialCommercialTypeInsurance(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(m)(1): a paragraph (3) or (4) organization is exempt only if no substantial part of its activities is commercial-type insurance";
    when described_in_501c3_or_501c4_for_501m(o, y);
    when SubstantialPartOfActivitiesConsistsOfCommercialTypeInsurance501m1(o, y);
    unless charitable_risk_pool_501n1(o, y);
    then exemption_denied_under_501m1(o, y);
}
pub relation commercial_type_insurance_activity_taxed_as_insurance_company_501m2(tb: TradeOrBusiness, o: Person, y: TaxableYear) kind institutional {
    label en official "in lieu of the section 511 tax, the organization is treated as an insurance company for subchapter L with respect to the commercial-type insurance activity";
}
@source(IRC_S501_M, quote = "(A) the activity of providing commercial-type insurance shall be treated as an unrelated trade or business (as defined in section 513), and")
rule CommercialTypeInsuranceActivityIsUnrelatedTradeOrBusiness(tb: TradeOrBusiness, o: Person, y: TaxableYear) defeasible {
    label en official "section 501(m)(2)(A): the commercial-type insurance activity of an exempt paragraph (3) or (4) organization is an unrelated trade or business";
    when described_in_501c3_or_501c4_for_501m(o, y);
    when exempt_organization(o, y);
    when commercial_type_insurance_activity_501m(tb);
    when activity_is_trade_or_business(tb, o);
    then unrelated_trade_or_business(tb, o, y);
}
@source(IRC_S501_M, quote = "(B) in lieu of the tax imposed by section 511 with respect to such activity, such organization shall be treated as an insurance company for purposes of applying subchapter L with respect to such activity.")
rule CommercialTypeInsuranceActivityTaxedAsInsuranceCompany(tb: TradeOrBusiness, o: Person, y: TaxableYear) defeasible {
    label en official "section 501(m)(2)(B): in lieu of the section 511 tax the organization is treated as an insurance company under subchapter L for that activity";
    when described_in_501c3_or_501c4_for_501m(o, y);
    when exempt_organization(o, y);
    when commercial_type_insurance_activity_501m(tb);
    when activity_is_trade_or_business(tb, o);
    then commercial_type_insurance_activity_taxed_as_insurance_company_501m2(tb, o, y);
}

// ---------------------------------------------------------------------
// (n): qualified charitable risk pools.
// ---------------------------------------------------------------------

pub relation organized_and_operated_solely_to_pool_insurable_risks_and_inform_501n2A(o: Person, y: TaxableYear) kind empirical {
    label en official "the pool is organized and operated solely to pool insurable risks of its members (other than medical malpractice risks) and to provide loss control and risk management information (section 501(n)(2)(A))";
}
pub relation comprised_solely_of_exempt_c3_members_501n2B(o: Person, y: TaxableYear) kind empirical {
    label en official "the pool is comprised solely of members that are section 501(c)(3) organizations exempt under subsection (a) (section 501(n)(2)(B))";
}
pub relation organized_as_nonprofit_under_state_risk_pooling_law_501n3A(o: Person) kind empirical {
    label en official "the pool is organized as a nonprofit organization under State law authorizing risk pooling arrangements for charitable organizations (section 501(n)(3)(A))";
}
pub relation exempt_from_state_income_tax_501n3B(o: Person) kind empirical {
    label en official "the pool is exempt from any State income tax (or will be so exempt after it qualifies under this title) (section 501(n)(3)(B))";
}
pub relation startup_capital_from_nonmember_charitable_organizations_501n3C(o: Person, amount: Money) kind empirical {
    label en official "capital contributed to, and program-related investments made in, the pool before it commences operations by section 501(c)(3) exempt organizations that are not members and do not benefit from the coverage (section 501(n)(4))";
}
pub relation startup_capital_requirement_met_501n3C(o: Person) kind institutional {
    label en official "the pool has obtained at least $1,000,000 in startup capital from nonmember charitable organizations";
}
@source(IRC_S501_N, quote = "(C) such risk pool has obtained at least $1,000,000 in startup capital from nonmember charitable organizations,")
rule StartupCapitalRequirementMet(o: Person, capital: Money) defeasible {
    label en official "section 501(n)(3)(C): at least $1,000,000 — exactly $1,000,000 qualifies";
    when startup_capital_from_nonmember_charitable_organizations_501n3C(o, capital);
    when capital >= 1000000.00 USD;
    then startup_capital_requirement_met_501n3C(o);
}
pub relation controlled_by_board_elected_by_members_501n3D(o: Person) kind empirical {
    label en official "the pool is controlled by a board of directors elected by its members (section 501(n)(3)(D))";
}
pub relation organizational_documents_require_c3_membership_at_all_times_501n3Ei(o: Person) kind empirical {
    label en official "the organizational documents require each member at all times to be an exempt section 501(c)(3) organization (section 501(n)(3)(E)(i))";
}
pub relation organizational_documents_require_notice_of_final_determination_501n3Eii(o: Person) kind empirical {
    label en official "the organizational documents require a member that receives a final determination that it no longer qualifies to notify the pool immediately of the determination and its effective date (section 501(n)(3)(E)(ii))";
}
pub relation organizational_documents_require_policies_to_stop_covering_after_determination_501n3Eiii(o: Person) kind empirical {
    label en official "the organizational documents require each policy to provide that it will not cover the insured for events after the date the final determination was issued (section 501(n)(3)(E)(iii))";
}
pub relation risk_pool_meets_organizational_requirements_501n3(o: Person) kind institutional {
    label en official "the risk pool meets the organizational requirements of section 501(n)(3)";
}
@source(IRC_S501_N, quote = "An organization (hereinafter in this subsection referred to as the \"risk pool\") meets the organizational requirements of this paragraph if—")
@source(IRC_S501_N, quote = "(A) such risk pool is organized as a nonprofit organization under State law provisions authorizing risk pooling arrangements for charitable organizations,")
@source(IRC_S501_N, quote = "(B) such risk pool is exempt from any income tax imposed by the State (or will be so exempt after such pool qualifies as an organization exempt from tax under this title),")
@source(IRC_S501_N, quote = "(D) such risk pool is controlled by a board of directors elected by its members, and")
@source(IRC_S501_N, quote = "(E) the organizational documents of such risk pool require that—")
@source(IRC_S501_N, quote = "(i) each member of such pool shall at all times be an organization described in subsection (c)(3) and exempt from tax under subsection (a),")
@source(IRC_S501_N, quote = "(ii) any member which receives a final determination that it no longer qualifies as an organization described in subsection (c)(3) shall immediately notify the pool of such determination and the effective date of such determination, and")
@source(IRC_S501_N, quote = "(iii) each policy of insurance issued by the risk pool shall provide that such policy will not cover the insured with respect to events occurring after the date such final determination was issued to the insured.")
rule RiskPoolMeetsOrganizationalRequirements(o: Person) defeasible {
    label en official "section 501(n)(3)(A)-(E): nonprofit under State pooling law, exempt from State income tax, $1,000,000 startup capital, member-elected board and the three required provisions in its documents";
    when organized_as_nonprofit_under_state_risk_pooling_law_501n3A(o);
    when exempt_from_state_income_tax_501n3B(o);
    when startup_capital_requirement_met_501n3C(o);
    when controlled_by_board_elected_by_members_501n3D(o);
    when organizational_documents_require_c3_membership_at_all_times_501n3Ei(o);
    when organizational_documents_require_notice_of_final_determination_501n3Eii(o);
    when organizational_documents_require_policies_to_stop_covering_after_determination_501n3Eiii(o);
    then risk_pool_meets_organizational_requirements_501n3(o);
}
pub external judgment relation PoolActedWithinReasonablePeriodToRemoveMember501n3(o: Person) {
    authority Secretary;
    label en official "within a reasonable period after being notified the pool took such action as may be reasonably necessary to remove the member (section 501(n)(3), last sentence) — DECISION-0194 evaluative channel";
}
pub relation pool_member_ceased_to_be_exempt_c3_501n3(o: Person, y: TaxableYear) kind empirical {
    label en official "a member of the pool ceased to be an organization described in subsection (c)(3)";
}
pub relation pool_saved_despite_member_failure_501n3(o: Person, y: TaxableYear) kind institutional {
    label en official "the pool does not cease to qualify solely because a member failed to continue as a section 501(c)(3) organization";
}
@source(IRC_S501_N, quote = "An organization shall not cease to qualify as a qualified charitable risk pool solely by reason of the failure of any of its members to continue to be an organization described in subsection (c)(3) if, within a reasonable period of time after such pool is notified as required under subparagraph (E)(ii), such pool takes such action as may be reasonably necessary to remove such member from such pool.")
rule PoolSavedDespiteMemberFailure(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(n)(3), last sentence: prompt removal of the failed member saves the pool";
    when pool_member_ceased_to_be_exempt_c3_501n3(o, y);
    when PoolActedWithinReasonablePeriodToRemoveMember501n3(o);
    then pool_saved_despite_member_failure_501n3(o, y);
}
pub relation pool_member_failure_defeats_501n2_501n3(o: Person, y: TaxableYear) kind institutional {
    label en official "a member ceased to be a section 501(c)(3) organization and the pool was not saved by prompt removal";
}
rule PoolMemberFailureNotSaved(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(n)(2)(B), (3): a lapsed member not removed within a reasonable period defeats the pool";
    when pool_member_ceased_to_be_exempt_c3_501n3(o, y);
    unless pool_saved_despite_member_failure_501n3(o, y);
    then pool_member_failure_defeats_501n2_501n3(o, y);
}
pub relation charitable_risk_pool_501n1(o: Person, y: TaxableYear) kind institutional {
    label en official "the organization is a qualified charitable risk pool, treated as organized and operated exclusively for charitable purposes; subsection (m) does not apply to it";
}
@source(IRC_S501_N, quote = "For purposes of this title—")
@source(IRC_S501_N, quote = "(A) a qualified charitable risk pool shall be treated as an organization organized and operated exclusively for charitable purposes, and")
@source(IRC_S501_N, quote = "(B) subsection (m) shall not apply to a qualified charitable risk pool.")
@source(IRC_S501_N, quote = "For purposes of this subsection, the term \"qualified charitable risk pool\" means any organization—")
@source(IRC_S501_N, quote = "(A) which is organized and operated solely to pool insurable risks of its members (other than risks related to medical malpractice) and to provide information to its members with respect to loss control and risk management,")
@source(IRC_S501_N, quote = "(B) which is comprised solely of members that are organizations described in subsection (c)(3) and exempt from tax under subsection (a), and")
@source(IRC_S501_N, quote = "(C) which meets the organizational requirements of paragraph (3).")
rule QualifiedCharitableRiskPool(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(n)(1)-(2): pooling risks solely for exempt charitable members and meeting the organizational requirements";
    when organized_and_operated_solely_to_pool_insurable_risks_and_inform_501n2A(o, y);
    when comprised_solely_of_exempt_c3_members_501n2B(o, y);
    when risk_pool_meets_organizational_requirements_501n3(o);
    unless pool_member_failure_defeats_501n2_501n3(o, y);
    then charitable_risk_pool_501n1(o, y);
}

// ---------------------------------------------------------------------
// (o): hospitals participating in provider-sponsored organizations.
// ---------------------------------------------------------------------

pub relation hospital_owned_and_operated_participates_in_pso_501o(o: Person, y: TaxableYear, pso: Person) kind empirical {
    label en official "a hospital owned and operated by the organization participates in a provider-sponsored organization (as defined in section 1855(d) of the Social Security Act), whether or not the PSO is exempt from tax";
}
pub relation pso_participation_alone_does_not_defeat_charitable_purpose_501o(o: Person, y: TaxableYear) kind institutional {
    label en official "the organization does not fail to be treated as organized and operated exclusively for a charitable purpose solely because of the hospital's PSO participation";
}
@source(IRC_S501_O, quote = "An organization shall not fail to be treated as organized and operated exclusively for a charitable purpose for purposes of subsection (c)(3) solely because a hospital which is owned and operated by such organization participates in a provider-sponsored organization (as defined in section 1855(d) of the Social Security Act), whether or not the provider-sponsored organization is exempt from tax. For purposes of subsection (c)(3), any person with a material financial interest in such a provider-sp")
rule PsoParticipationAloneDoesNotDefeatCharitablePurpose(o: Person, y: TaxableYear, pso: Person) defeasible {
    label en official "section 501(o), first sentence: participation of an owned hospital in a provider-sponsored organization is not by itself disqualifying";
    when hospital_owned_and_operated_participates_in_pso_501o(o, y, pso);
    then pso_participation_alone_does_not_defeat_charitable_purpose_501o(o, y);
}
pub relation material_financial_interest_in_pso_501o(person: Person, pso: Person) kind empirical {
    label en official "the person has a material financial interest in the provider-sponsored organization";
}
pub relation treated_as_private_shareholder_or_individual_of_hospital_501o(person: Person, hospital_owner: Person, y: TaxableYear) kind institutional {
    label en official "for purposes of subsection (c)(3), the person is treated as a private shareholder or individual with respect to the hospital";
}
@source(IRC_S501_O, quote = "An organization shall not fail to be treated as organized and operated exclusively for a charitable purpose for purposes of subsection (c)(3) solely because a hospital which is owned and operated by such organization participates in a provider-sponsored organization (as defined in section 1855(d) of the Social Security Act), whether or not the provider-sponsored organization is exempt from tax. For purposes of subsection (c)(3), any person with a material financial interest in such a provider-sp")
rule PsoFinancialInterestHolderIsPrivateShareholder(person: Person, hospital_owner: Person, y: TaxableYear, pso: Person) defeasible {
    label en official "section 501(o), second sentence: a person with a material financial interest in the PSO is a private shareholder or individual with respect to the hospital";
    when hospital_owned_and_operated_participates_in_pso_501o(hospital_owner, y, pso);
    when material_financial_interest_in_pso_501o(person, pso);
    then treated_as_private_shareholder_or_individual_of_hospital_501o(person, hospital_owner, y);
}

// ---------------------------------------------------------------------
// (p): suspension of exemption of designated terrorist organizations.
// ---------------------------------------------------------------------

pub enum TerroristDesignationBasis501p2 { ImmigrationAndNationalityAct212a3Bvi2Or219, ExecutiveOrderIeepaOrUnParticipationAct, ExecutiveOrderSupportingTerroristActivityReferringToSubsectionP }
pub relation designated_or_identified_501p2(o: Person, basis: TerroristDesignationBasis501p2) kind empirical {
    label en official "the organization is designated or otherwise individually identified as a terrorist or foreign terrorist organization under INA section 212(a)(3)(B)(vi)(II) or 219 (A), in or pursuant to an Executive order related to terrorism under IEEPA or the UN Participation Act to impose a sanction (B), or in or pursuant to an Executive order as supporting terrorist activity that refers to this subsection (C)";
}
pub relation described_in_501p2(o: Person) kind institutional {
    label en official "the organization is described in section 501(p)(2)";
}
@source(IRC_S501_P, quote = "An organization is described in this paragraph if such organization is designated or otherwise individually identified—")
@source(IRC_S501_P, quote = "(A) under section 212(a)(3)(B)(vi)(II) or 219 of the Immigration and Nationality Act as a terrorist organization or foreign terrorist organization,")
@source(IRC_S501_P, quote = "(B) in or pursuant to an Executive order which is related to terrorism and issued under the authority of the International Emergency Economic Powers Act or section 5 of the United Nations Participation Act of 1945 for the purpose of imposing on such organization an economic or other sanction, or")
@source(IRC_S501_P, quote = "(C) in or pursuant to an Executive order issued under the authority of any Federal law if—")
@source(IRC_S501_P, quote = "(i) the organization is designated or otherwise individually identified in or pursuant to such Executive order as supporting or engaging in terrorist activity (as defined in section 212(a)(3)(B) of the Immigration and Nationality Act) or supporting terrorism (as defined in section 140(d)(2) of the Foreign Relations Authorization Act, Fiscal Years 1988 and 1989); and")
@source(IRC_S501_P, quote = "(ii) such Executive order refers to this subsection.")
rule DescribedIn501p2(o: Person, b: TerroristDesignationBasis501p2) defeasible {
    label en official "section 501(p)(2)(A)-(C): designated or identified under one of the three bases";
    when designated_or_identified_501p2(o, b);
    then described_in_501p2(o);
}
pub relation first_publication_of_designation_501p3Ai(o: Person, published_on: Date) kind empirical {
    label en official "the date of the first publication of a designation or identification described in paragraph (2) with respect to the organization";
}
pub relation date_all_designations_rescinded_501p3B(o: Person, rescinded_on: Date) kind empirical {
    label en official "the first date on which all designations and identifications with respect to the organization are rescinded pursuant to the law or Executive order under which they were made";
}
pub relation section_501p3_suspension_begins(o: Person, start: Date) kind institutional {
    label en official "the suspension period begins on the later of the first publication date and the date of enactment of subsection (p) (November 11, 2003, Pub. L. 108-121 section 108)";
}
@source(IRC_S501_P, quote = "(i) the date of the first publication of a designation or identification described in paragraph (2) with respect to such organization, or")
@source(IRC_S501_P, quote = "(ii) the date of the enactment of this subsection, and")
rule SuspensionBeginsOnPublicationWhenLater(o: Person, published: Date) defeasible {
    label en official "section 501(p)(3)(A): publication on or after the enactment date starts the period on the publication date";
    when described_in_501p2(o);
    when first_publication_of_designation_501p3Ai(o, published);
    when published >= @2003-11-11;
    then section_501p3_suspension_begins(o, published);
}
@source(IRC_S501_P, quote = "(i) the date of the first publication of a designation or identification described in paragraph (2) with respect to such organization, or")
@source(IRC_S501_P, quote = "(ii) the date of the enactment of this subsection, and")
rule SuspensionBeginsOnEnactmentWhenLater(o: Person, published: Date) defeasible {
    label en official "section 501(p)(3)(A): publication before the enactment date starts the period on the enactment date";
    when described_in_501p2(o);
    when first_publication_of_designation_501p3Ai(o, published);
    when published < @2003-11-11;
    then section_501p3_suspension_begins(o, @2003-11-11);
}
pub relation exemption_suspended_under_501p(o: Person, y: TaxableYear) kind institutional {
    label en official "the exemption under subsection (a) of an organization described in paragraph (2) is suspended for a taxable year that overlaps the suspension period (section 501(p)(1)) — a year partly in the period is treated as suspended (INTERPRETATION, the text speaks of the period, not the year)";
}
@source(IRC_S501_P, quote = "The exemption from tax under subsection (a) with respect to any organization described in paragraph (2), and the eligibility of any organization described in paragraph (2) to apply for recognition of exemption under subsection (a), shall be suspended during the period described in paragraph (3).")
rule ExemptionSuspendedDuringOpenEndedPeriod(o: Person, y: TaxableYear, start: Date, year_end: Date) defeasible {
    label en official "section 501(p)(1): while no rescission has ended the period, the exemption is suspended for every year ending on or after the start";
    when section_501p3_suspension_begins(o, start);
    when us.irc.core::ends(y, year_end);
    when year_end >= start;
    unless suspension_ended_before_year_begins_501p3B(o, y);
    then exemption_suspended_under_501p(o, y);
}
pub relation suspension_ended_before_year_begins_501p3B(o: Person, y: TaxableYear) kind institutional {
    label en official "all designations were rescinded before the taxable year began, so the suspension period does not reach the year";
}
@source(IRC_S501_P, quote = "(B) ends on the first date that all designations and identifications described in paragraph (2) with respect to such organization are rescinded pursuant to the law or Executive order under which such designation or identification was made.")
rule SuspensionEndedBeforeYearBegins(o: Person, y: TaxableYear, rescinded: Date, year_start: Date) defeasible {
    label en official "section 501(p)(3)(B): the period ends on the first date all designations are rescinded";
    when date_all_designations_rescinded_501p3B(o, rescinded);
    when us.irc.core::begins(y, year_start);
    when rescinded < year_start;
    then suspension_ended_before_year_begins_501p3B(o, y);
}
pub relation contribution_to_organization_made_on_501p4(contributor: Person, o: Person, on: Date) kind empirical {
    label en official "the contribution to the organization made on the date";
}
pub relation deduction_disallowed_for_contribution_during_suspension_501p4(contributor: Person, o: Person, on: Date) kind institutional {
    label en official "no deduction is allowed under any provision of this title (including sections 170, 545(b)(2), 642(c), 2055, 2106(a)(2), and 2522) for the contribution made during the suspension period";
}
@source(IRC_S501_P, quote = "No deduction shall be allowed under any provision of this title, including sections 170, 545(b)(2), 642(c), 2055, 2106(a)(2), and 2522, with respect to any contribution to an organization described in paragraph (2) during the period described in paragraph (3).")
rule NoDeductionForContributionDuringSuspension(contributor: Person, o: Person, on: Date, start: Date) defeasible {
    label en official "section 501(p)(4): a contribution on or after the start of the suspension period, before all designations are rescinded, is not deductible";
    when contribution_to_organization_made_on_501p4(contributor, o, on);
    when section_501p3_suspension_begins(o, start);
    when on >= start;
    unless contribution_made_after_rescission_501p3B(contributor, o, on);
    then deduction_disallowed_for_contribution_during_suspension_501p4(contributor, o, on);
}
pub relation contribution_made_after_rescission_501p3B(contributor: Person, o: Person, on: Date) kind institutional {
    label en official "the contribution was made on or after the date all designations were rescinded";
}
rule ContributionMadeAfterRescission(o: Person, on: Date, rescinded: Date, contributor: Person) defeasible {
    label en official "section 501(p)(3)(B): after the period ends the disallowance no longer applies";
    when contribution_to_organization_made_on_501p4(contributor, o, on);
    when date_all_designations_rescinded_501p3B(o, rescinded);
    when on >= rescinded;
    then contribution_made_after_rescission_501p3B(contributor, o, on);
}
// (p)(5): no challenge — an immunity of the Secretary's suspension and designations.
pub relation suspension_challenged_successfully_in_tax_proceeding_501p5(org_or_person: Person, o: Person) kind empirical {
    label en official "the organization or another person challenges a suspension, a designation or identification, the suspension period, or a denial of a deduction in an administrative or judicial proceeding relating to Federal tax liability and the challenge is entertained";
}
@source(IRC_S501_P, quote = "Notwithstanding section 7428 or any other provision of law, no organization or other person may challenge a suspension under paragraph (1), a designation or identification described in paragraph (2), the period of suspension described in paragraph (3), or a denial of a deduction under paragraph (4) in any administrative or judicial proceeding relating to the Federal tax liability of such organization or other person.")
rule Section501p5NoChallengeImmunityRule(o: Person) strict {
    label en official "section 501(p)(5): notwithstanding section 7428 or any other provision of law, no organization or other person may challenge a suspension, a designation or identification, the suspension period, or a denial of a deduction in a proceeding relating to Federal tax liability";
    when described_in_501p2(o);
    then immunity SuspensionAndDesignationNotChallengeableInTaxProceedings {
        holder Secretary;
        protected_effect suspension_challenged_successfully_in_tax_proceeding_501p5(o, o);
        window [-infinity, infinity];
    };
}
// (p)(6): credit or refund after an erroneous designation.
pub relation exemption_suspended_designation_determined_erroneous_501p6Aii(o: Person, determined_on: Date) kind empirical {
    label en official "each designation and identification made with respect to the organization is determined to be erroneous pursuant to the law or Executive order under which it was made (date of the last such determination)";
}
pub relation overpayment_resulting_from_erroneous_designations_501p6Aiii(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the erroneous designations and identifications result in an overpayment of income tax for the taxable year";
}
pub relation credit_or_refund_with_interest_made_501p6A(o: Person, y: TaxableYear) kind empirical {
    label en official "credit or refund (with interest) with respect to the overpayment has been made";
}
pub relation refund_claim_filed_501p6B(o: Person, y: TaxableYear, filed_on: Date) kind empirical {
    label en official "the claim for credit or refund of the overpayment was filed on the date";
}
pub relation section_501p6B_claim_deadline(o: Person, deadline: Date) kind institutional {
    label en official "the close of the 1-year period beginning on the date of the last determination that the designations were erroneous";
}
@source(IRC_S501_P, quote = "If the credit or refund of any overpayment of tax described in subparagraph (A)(iii) is prevented at any time by the operation of any law or rule of law (including res judicata), such credit or refund may nevertheless be allowed or made if the claim therefor is filed before the close of the 1-year period beginning on the date of the last determination described in subparagraph (A)(ii).")
rule Section501p6BClaimDeadline(o: Person, determined_on: Date) strict {
    label en official "section 501(p)(6)(B): the claim must be filed before the close of the 1-year period beginning on the date of the last determination";
    when exemption_suspended_designation_determined_erroneous_501p6Aii(o, determined_on);
    then section_501p6B_claim_deadline(o, add_calendar_period(determined_on, 1 calendar_year));
}
pub relation refund_allowed_notwithstanding_bar_501p6B(o: Person, y: TaxableYear) kind institutional {
    label en official "the credit or refund may be allowed or made even though prevented by a law or rule of law (including res judicata)";
}
@source(IRC_S501_P, quote = "If the credit or refund of any overpayment of tax described in subparagraph (A)(iii) is prevented at any time by the operation of any law or rule of law (including res judicata), such credit or refund may nevertheless be allowed or made if the claim therefor is filed before the close of the 1-year period beginning on the date of the last determination described in subparagraph (A)(ii).")
rule RefundAllowedNotwithstandingBar(o: Person, y: TaxableYear, filed_on: Date, deadline: Date) defeasible {
    label en official "section 501(p)(6)(B): a claim filed on or before the end of the 1-year period is not defeated by a bar such as res judicata";
    when refund_claim_filed_501p6B(o, y, filed_on);
    when section_501p6B_claim_deadline(o, deadline);
    when filed_on <= deadline;
    then refund_allowed_notwithstanding_bar_501p6B(o, y);
}
@source(IRC_S501_P, quote = "If—")
@source(IRC_S501_P, quote = "(i) the tax exemption of any organization described in paragraph (2) is suspended under paragraph (1),")
@source(IRC_S501_P, quote = "(ii) each designation and identification described in paragraph (2) which has been made with respect to such organization is determined to be erroneous pursuant to the law or Executive order under which such designation or identification was made, and")
@source(IRC_S501_P, quote = "(iii) the erroneous designations and identifications result in an overpayment of income tax for any taxable year by such organization,")
@source(IRC_S501_P, quote = "credit or refund (with interest) with respect to such overpayment shall be made.")
rule Section501p6ARefundDutyRule(o: Person, y: TaxableYear, determined_on: Date, amount: Money) strict {
    label en official "section 501(p)(6)(A): when a suspended organization's designations are all determined erroneous and an overpayment results, credit or refund with interest shall be made";
    when described_in_501p2(o);
    when exemption_suspended_designation_determined_erroneous_501p6Aii(o, determined_on);
    when overpayment_resulting_from_erroneous_designations_501p6Aiii(o, y, amount);
    then duty CreditOrRefundOverpaymentFromErroneousDesignations {
        bearer Secretary;
        goal achievement {
            condition credit_or_refund_with_interest_made_501p6A(o, y);
            window [determined_on, infinity];
        }
    };
}
pub relation listings_updated_and_notice_published_501p7(o: Person) kind empirical {
    label en official "the Internal Revenue Service updated the listings of tax-exempt organizations and published notice to taxpayers of the suspension and of the non-deductibility of contributions during it";
}
pub relation suspension_effective_for_501p7(o: Person, start: Date) kind institutional {
    label en official "the organization's exemption is suspended from the start date (the trigger of the section 501(p)(7) duty)";
}
rule SuspensionTriggersListingDuty(o: Person, start: Date) defeasible {
    label en official "helper: a suspended organization triggers the duty of paragraph (7)";
    when section_501p3_suspension_begins(o, start);
    then suspension_effective_for_501p7(o, start);
}
@source(IRC_S501_P, quote = "If the tax exemption of any organization is suspended under this subsection, the Internal Revenue Service shall update the listings of tax-exempt organizations and shall publish appropriate notice to taxpayers of such suspension and of the fact that contributions to such organization are not deductible during the period of such suspension.")
rule Section501p7ListingDutyRule(o: Person, start: Date) strict {
    label en official "section 501(p)(7): the Internal Revenue Service shall update the listings of tax-exempt organizations and publish notice of the suspension and of the non-deductibility of contributions";
    when suspension_effective_for_501p7(o, start);
    then duty UpdateListingsAndPublishNoticeOfSuspension {
        bearer IRS;
        goal achievement {
            condition listings_updated_and_notice_published_501p7(o);
            window [start, infinity];
        }
    };
}

// ---------------------------------------------------------------------
// (q): what stage 2b left — (A)(iii), (E)(ii)-(iii), (2)(B)(ii) transition, (3) notice, (4) definitions.
// ---------------------------------------------------------------------

pub relation credit_repair_services_only_incidental_to_credit_counseling_501q1Aiii(o: Person) kind empirical {
    label en official "the organization provides services for the purpose of improving a consumer's credit record, credit history, or credit rating only to the extent that such services are incidental to providing credit counseling services (section 501(q)(1)(A)(iii))";
}
pub relation credit_counseling_activities_conditions_501q1A(o: Person) kind institutional {
    label en official "the section 501(q)(1)(A)(i)-(iv) service conditions are all met";
}
@source(IRC_S501_Q, quote = "(i) provides credit counseling services tailored to the specific needs and circumstances of consumers,")
@source(IRC_S501_Q, quote = "(ii) makes no loans to debtors (other than loans with no fees or interest) and does not negotiate the making of loans on behalf of debtors,")
@source(IRC_S501_Q, quote = "(iii) provides services for the purpose of improving a consumer's credit record, credit history, or credit rating only to the extent that such services are incidental to providing credit counseling services, and")
@source(IRC_S501_Q, quote = "(iv) does not charge any separately stated fee for services for the purpose of improving any consumer's credit record, credit history, or credit rating.")
rule CreditCounselingServiceConditionsMet(o: Person) defeasible {
    label en official "section 501(q)(1)(A): tailored counseling, no fee-bearing loans, credit repair only incidental, and no separately stated credit-repair fee";
    when tailored_credit_counseling_services_501q1Ai(o);
    when no_fee_bearing_loans_to_debtors_501q1Aii(o);
    when credit_repair_services_only_incidental_to_credit_counseling_501q1Aiii(o);
    when no_separate_fee_for_credit_improvement_501q1Aiv(o);
    then credit_counseling_activities_conditions_501q1A(o);
}
pub enum RelatedBusinessInterest501q1E { VotingPowerOfCorporation, ProfitsInterestOfPartnership, BeneficialInterestOfTrustOrEstate }
pub relation ownership_percentage_of_related_business_by_kind_501q1E(o: Person, kind: RelatedBusinessInterest501q1E, pct: Decimal) kind empirical {
    label en official "the organization's percentage of the total combined voting power of a corporation (i), the profits interest of a partnership (ii), or the beneficial interest of a trust or estate (iii) engaged in lending money, repairing credit, or providing debt management plan services, payment processing or similar services (other than a section 501(c)(3) exempt corporation, partnership or trust)";
}
pub relation ownership_of_related_business_within_35_percent_501q1E_all_kinds(o: Person) kind institutional {
    label en official "the organization owns not more than 35 percent of any of the three kinds of interest — asserted per kind, the derived per-kind test is below";
}
pub relation ownership_in_related_business_kind_at_most_35_percent_501q1E(o: Person, kind: RelatedBusinessInterest501q1E) kind institutional {
    label en official "the organization owns not more than 35 percent of the listed kind of interest";
}
@source(IRC_S501_Q, quote = "(i) the total combined voting power of any corporation (other than a corporation which is an organization described in subsection (c)(3) and exempt from tax under subsection (a)) which is in the trade or business of lending money, repairing credit, or providing debt management plan services, payment processing, or similar services,")
@source(IRC_S501_Q, quote = "(ii) the profits interest of any partnership (other than a partnership which is an organization described in subsection (c)(3) and exempt from tax under subsection (a)) which is in the trade or business of lending money, repairing credit, or providing debt management plan services, payment processing, or similar services, and")
@source(IRC_S501_Q, quote = "(iii) the beneficial interest of any trust or estate (other than a trust which is an organization described in subsection (c)(3) and exempt from tax under subsection (a)) which is in the trade or business of lending money, repairing credit, or providing debt management plan services, payment processing, or similar services.")
rule OwnershipOfRelatedBusinessKindAtMost35Percent(o: Person, k: RelatedBusinessInterest501q1E, pct: Decimal) defeasible {
    label en official "section 501(q)(1)(E)(i)-(iii): not more than 35 percent of the interest of each kind — exactly 35 percent qualifies";
    when ownership_percentage_of_related_business_by_kind_501q1E(o, k, pct);
    when pct <= 35.0;
    then ownership_in_related_business_kind_at_most_35_percent_501q1E(o, k);
}
pub relation first_taxable_year_beginning_after_first_anniversary_of_501q_enactment_501q2Bii(o: Person, y0: TaxableYear) kind empirical {
    label en official "the first taxable year of the organization beginning after the date which is 1 year after the date of the enactment of section 501(q) (August 17, 2006), for an organization exempt under (c)(3) on the enactment date";
}
pub relation exempt_c3_credit_counseling_on_501q_enactment_date_501q2Bii(o: Person) kind empirical {
    label en official "the organization has credit counseling as a substantial purpose, is described in (c)(3) and exempt under (a) on the date of the enactment of the subsection (Pension Protection Act of 2006, August 17, 2006)";
}
pub relation transition_applicable_percentage_501q2Bii(o: Person, y: TaxableYear, percent: Decimal) kind institutional {
    label en official "the 80, 70 or 60 percent applicable percentage of the first three taxable years under the section 501(q)(2)(B)(ii) transition rule";
}
@source(IRC_S501_Q, quote = "(I) 80 percent for the first taxable year of such organization beginning after the date which is 1 year after the date of the enactment of this subsection, and")
rule ApplicablePercentageFirstTransitionYear(o: Person, y: TaxableYear, y0: TaxableYear, n: Integer, n0: Integer) defeasible {
    label en official "section 501(q)(2)(B)(ii)(I): 80 percent for the first taxable year beginning after the first anniversary of enactment";
    when exempt_c3_credit_counseling_on_501q_enactment_date_501q2Bii(o);
    when first_taxable_year_beginning_after_first_anniversary_of_501q_enactment_501q2Bii(o, y0);
    when us.irc.core::calendar_year_of(y, n);
    when us.irc.core::calendar_year_of(y0, n0);
    when n == n0;
    then transition_applicable_percentage_501q2Bii(o, y, 80.0);
}
@source(IRC_S501_Q, quote = "(II) 70 percent for the second such taxable year beginning after such date, and")
rule ApplicablePercentageSecondTransitionYear(o: Person, y: TaxableYear, y0: TaxableYear, n: Integer, n0: Integer) defeasible {
    label en official "section 501(q)(2)(B)(ii)(II): 70 percent for the second such taxable year";
    when exempt_c3_credit_counseling_on_501q_enactment_date_501q2Bii(o);
    when first_taxable_year_beginning_after_first_anniversary_of_501q_enactment_501q2Bii(o, y0);
    when us.irc.core::calendar_year_of(y, n);
    when us.irc.core::calendar_year_of(y0, n0);
    when n == n0 + 1;
    then transition_applicable_percentage_501q2Bii(o, y, 70.0);
}
@source(IRC_S501_Q, quote = "(III) 60 percent for the third such taxable year beginning after such date.")
rule ApplicablePercentageThirdTransitionYear(o: Person, y: TaxableYear, y0: TaxableYear, n: Integer, n0: Integer) defeasible {
    label en official "section 501(q)(2)(B)(ii)(III): 60 percent for the third such taxable year";
    when exempt_c3_credit_counseling_on_501q_enactment_date_501q2Bii(o);
    when first_taxable_year_beginning_after_first_anniversary_of_501q_enactment_501q2Bii(o, y0);
    when us.irc.core::calendar_year_of(y, n);
    when us.irc.core::calendar_year_of(y0, n0);
    when n == n0 + 2;
    then transition_applicable_percentage_501q2Bii(o, y, 60.0);
}
pub relation has_transition_percentage_501q2Bii(o: Person, y: TaxableYear) kind institutional {
    label en official "the taxable year has a transition percentage";
}
rule HasTransitionPercentage(o: Person, y: TaxableYear, p: Decimal) defeasible {
    label en official "helper: a transition year";
    when transition_applicable_percentage_501q2Bii(o, y, p);
    then has_transition_percentage_501q2Bii(o, y);
}
pub relation applicable_percentage_501q2B(o: Person, y: TaxableYear, percent: Decimal) kind institutional {
    label en official "the applicable percentage for the section 501(q)(2)(A)(ii) debt management plan revenue test: the transition percentage, otherwise 50 percent";
}
rule ApplicablePercentageViaTransition(o: Person, y: TaxableYear, p: Decimal) defeasible {
    label en official "section 501(q)(2)(B)(ii): the transition percentage applies to the first three taxable years";
    when transition_applicable_percentage_501q2Bii(o, y, p);
    then applicable_percentage_501q2B(o, y, p);
}
@source(IRC_S501_Q, quote = "Notwithstanding clause (i), in the case of an organization with respect to which the provision of credit counseling services is a substantial purpose and which is described in paragraph (3) of subsection (c) and exempt from tax under subsection (a) on the date of the enactment of this subsection, the applicable percentage is—")
rule ApplicablePercentageOtherwiseFifty(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(q)(2)(B)(i): 50 percent otherwise";
    when us.irc.core::year_of(o, y);
    unless has_transition_percentage_501q2Bii(o, y);
    then applicable_percentage_501q2B(o, y, 50.0);
}
pub relation dmp_revenue_within_applicable_percentage_501q2Aii(o: Person, y: TaxableYear) kind institutional {
    label en official "the debt management plan revenue does not exceed the applicable percentage of total revenue";
}
@source(IRC_S501_Q, quote = "(ii) The aggregate revenues of the organization which are from payments of creditors of consumers of the organization and which are attributable to debt management plan services do not exceed the applicable percentage of the total revenues of the organization.")
rule DmpRevenueWithinApplicablePercentage(o: Person, y: TaxableYear, dmp: Money, total: Money, p: Decimal) defeasible {
    label en official "section 501(q)(2)(A)(ii): 100 * DMP revenue <= applicable percentage * total revenue — exact; at the percentage passes";
    when dmp_attributable_revenue_501q2Aii(o, y, dmp);
    when total_revenue_501q2Aii(o, y, total);
    when applicable_percentage_501q2B(o, y, p);
    when dmp * 100 <= total * p;
    then dmp_revenue_within_applicable_percentage_501q2Aii(o, y);
}
pub relation credit_counseling_c3_additional_requirements_met_501q2A(o: Person, y: TaxableYear) kind institutional {
    label en official "the additional section 501(q)(2)(A) requirements for a credit counseling section 501(c)(3) organization are met";
}
@source(IRC_S501_Q, quote = "In addition to the requirements under paragraph (1), an organization with respect to which the provision of credit counseling services is a substantial purpose and which is described in paragraph (3) of subsection (c) shall not be exempt from tax under subsection (a) unless such organization is organized and operated in accordance with the following requirements:")
@source(IRC_S501_Q, quote = "(i) The organization does not solicit contributions from consumers during the initial counseling process or while the consumer is receiving services from the organization.")
rule CreditCounselingC3AdditionalRequirementsMet(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(q)(2)(A): no solicitation of consumers and DMP revenue within the applicable percentage";
    when credit_counseling_substantial_purpose(o);
    when does_not_solicit_during_counseling_501q2Ai(o);
    when dmp_revenue_within_applicable_percentage_501q2Aii(o, y);
    then credit_counseling_c3_additional_requirements_met_501q2A(o, y);
}
pub relation section_501q3_notice_established_for_year(o: Person, y: TaxableYear) kind institutional {
    label en official "helper: the section 501(q)(3) notice has been given, read for a taxable year";
}
rule Section501q3NoticeEstablishedForYear(o: Person, y: TaxableYear) defeasible {
    label en official "helper: the notice fact bound to the year";
    when section_501q3_notice_given(o);
    when us.irc.core::year_of(o, y);
    then section_501q3_notice_established_for_year(o, y);
}
pub relation credit_counseling_c4_notice_missing_501q3(o: Person, y: TaxableYear) kind institutional {
    label en official "a section 501(c)(4) credit counseling organization has not notified the Secretary that it is applying for recognition as a credit counseling organization";
}
@source(IRC_S501_Q, quote = "In addition to the requirements under paragraph (1), an organization with respect to which the provision of credit counseling services is a substantial purpose and which is described in paragraph (4) of subsection (c) shall not be exempt from tax under subsection (a) unless such organization notifies the Secretary, in such manner as the Secretary may by regulations prescribe, that it is applying for recognition as a credit counseling organization.")
rule CreditCounselingC4NoticeMissing(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(q)(3): a credit counseling section 501(c)(4) organization is not exempt unless it has notified the Secretary";
    when credit_counseling_substantial_purpose(o);
    when section_501c4(o, y);
    unless section_501q3_notice_established_for_year(o, y);
    then credit_counseling_c4_notice_missing_501q3(o, y);
}
pub relation credit_counseling_organization_not_exempt_501q(o: Person, y: TaxableYear) kind institutional {
    label en official "a credit counseling organization is not exempt under subsection (a) for the taxable year because it fails section 501(q)";
}
@source(IRC_S501_Q, quote = "An organization with respect to which the provision of credit counseling services is a substantial purpose shall not be exempt from tax under subsection (a) unless such organization is described in paragraph (3) or (4) of subsection (c) and such organization is organized and operated in accordance with the following requirements:")
rule CreditCounselingC3NotExemptWithoutRequirements(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(q)(1)-(2): a credit counseling section 501(c)(3) organization that does not meet the (1) and (2) requirements is not exempt";
    when credit_counseling_substantial_purpose(o);
    when section_501c3(o, y);
    unless section_501q_requirements_met(o, y);
    then credit_counseling_organization_not_exempt_501q(o, y);
}
@source(IRC_S501_Q, quote = "In addition to the requirements under paragraph (1), an organization with respect to which the provision of credit counseling services is a substantial purpose and which is described in paragraph (4) of subsection (c) shall not be exempt from tax under subsection (a) unless such organization notifies the Secretary, in such manner as the Secretary may by regulations prescribe, that it is applying for recognition as a credit counseling organization.")
rule CreditCounselingC4NotExemptWithoutNotice(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(q)(3): a credit counseling section 501(c)(4) organization without notice is not exempt";
    when credit_counseling_c4_notice_missing_501q3(o, y);
    then credit_counseling_organization_not_exempt_501q(o, y);
}
pub enum CreditCounselingServiceKind501q4 { EducationalInformationToPublic, CounselingIndividualsAndFamilies }
pub relation credit_counseling_activity_501q4A(activity: Text, kind: CreditCounselingServiceKind501q4) kind empirical {
    label en official "the activity is the providing of educational information to the general public on budgeting, personal finance, financial literacy, saving and spending practices, and the sound use of consumer credit (i), or the assisting of individuals and families with financial problems by providing them with counseling (ii)";
}
pub relation credit_counseling_services_501q4A(activity: Text) kind institutional {
    label en official "the activity is 'credit counseling services' (i), (ii) or a combination (iii)";
}
@source(IRC_S501_Q, quote = "The term \"credit counseling services\" means—")
@source(IRC_S501_Q, quote = "(i) the providing of educational information to the general public on budgeting, personal finance, financial literacy, saving and spending practices, and the sound use of consumer credit,")
@source(IRC_S501_Q, quote = "(ii) the assisting of individuals and families with financial problems by providing them with counseling, or")
@source(IRC_S501_Q, quote = "(iii) a combination of the activities described in clauses (i) and (ii).")
rule CreditCounselingServicesDefinition(activity: Text, k: CreditCounselingServiceKind501q4) defeasible {
    label en official "section 501(q)(4)(A)(i)-(iii): educational information, counseling, or a combination";
    when credit_counseling_activity_501q4A(activity, k);
    then credit_counseling_services_501q4A(activity);
}
pub enum DebtManagementPlanServiceKind501q4B { RepaymentConsolidationOrRestructuring, NegotiationOfLowerInterestRates, WaiverOrReductionOfFees, MarketingAndProcessingOfDebtManagementPlans }
pub relation debt_management_plan_activity_501q4B(activity: Text, kind: DebtManagementPlanServiceKind501q4B) kind empirical {
    label en official "the activity is a service related to the repayment, consolidation, or restructuring of a consumer's debt, including negotiating lower interest rates, waiving or reducing fees, and marketing and processing debt management plans";
}
pub relation debt_management_plan_services_501q4B(activity: Text) kind institutional {
    label en official "the activity is 'debt management plan services'";
}
@source(IRC_S501_Q, quote = "The term \"debt management plan services\" means services related to the repayment, consolidation, or restructuring of a consumer's debt, and includes the negotiation with creditors of lower interest rates, the waiver or reduction of fees, and the marketing and processing of debt management plans.")
rule DebtManagementPlanServicesDefinition(activity: Text, k: DebtManagementPlanServiceKind501q4B) defeasible {
    label en official "section 501(q)(4)(B): services related to repayment, consolidation or restructuring of debt, including the listed activities";
    when debt_management_plan_activity_501q4B(activity, k);
    then debt_management_plan_services_501q4B(activity);
}

// ---------------------------------------------------------------------
// Wiring: "deemed charitable" paths into the (c)(3) classification. Sibling
// rules of the two stage 1 rules in 01-exemption-classification-501.law: the
// external judgments of "organized/operated exclusively" are replaced by a
// subsection (e), (f), (n) or (k) deeming; the inurement, lobbying, campaign,
// hospital and notice guards are unchanged.
// ---------------------------------------------------------------------

pub relation deemed_organized_and_operated_exclusively_for_charitable_purposes(o: Person, y: TaxableYear) kind institutional {
    label en official "the organization is treated as organized and operated exclusively for charitable purposes by subsection (e), (f) or (n)";
}
rule DeemedCharitableViaHospitalServiceCooperative(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(e): a cooperative hospital service organization";
    when cooperative_hospital_service_organization_501e(o, y);
    then deemed_organized_and_operated_exclusively_for_charitable_purposes(o, y);
}
rule DeemedCharitableViaEducationalInvestmentCooperative(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(f): a cooperative service organization of operating educational organizations";
    when treated_as_charitable_cooperative_service_organization_501f(o, y);
    then deemed_organized_and_operated_exclusively_for_charitable_purposes(o, y);
}
rule DeemedCharitableViaRiskPool(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(n)(1)(A): a qualified charitable risk pool";
    when charitable_risk_pool_501n1(o, y);
    then deemed_organized_and_operated_exclusively_for_charitable_purposes(o, y);
}
rule Section501c3ClassificationDeemedCharitableUnderSubstantialPartTest(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(3) via a deeming subsection, substantial-part lobbying test: no inurement, no substantial legislative activity, no campaign intervention";
    when deemed_organized_and_operated_exclusively_for_charitable_purposes(o, y);
    unless private_inurement_established(o, y);
    unless SubstantialLegislativeActivity(o, y);
    unless political_campaign_intervention_established(o, y);
    unless section_501h_election_in_effect(o, y);
    unless hospital_denied_501c3_by_501r(o, y);
    unless section_508_notice_requirement_unsatisfied_for_year(o, y);
    then section_501c3(o, y);
}
rule Section501c3ClassificationDeemedCharitableUnderHElection(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(3) via a deeming subsection, with the (h) election in effect";
    when section_501h_election_in_effect(o, y);
    when deemed_organized_and_operated_exclusively_for_charitable_purposes(o, y);
    unless private_inurement_established(o, y);
    unless section_501h_expenditures_exceed_ceiling(o, y);
    unless political_campaign_intervention_established(o, y);
    unless hospital_denied_501c3_by_501r(o, y);
    unless section_508_notice_requirement_unsatisfied_for_year(o, y);
    then section_501c3(o, y);
}
