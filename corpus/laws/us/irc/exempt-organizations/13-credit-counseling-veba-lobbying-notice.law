// Section 501(q) (credit counseling organizations), section 505 (VEBA/SUB
// nondiscrimination and notice requirements), section 504 (loss of
// section 501(c)(4) status after lobbying/political disqualification from
// (c)(3)), section 502(b)/503(b) (further feeder/prohibited-transaction
// detail), and section 508(c)(2)-(3)/(d)-(f) (notice exceptions,
// disallowed deductions, governing-instrument requirements, sponsoring-
// organization notice) — STAGE 2b (25.09.2026).

// =======================================================================
// Section 501(q): credit counseling organizations.
// =======================================================================
//
// FINDING: the pinned 2024-Edition text has NO "15 percent initial fee"
// rule anywhere on its face — only the (1)(C) reasonable/waivable/no-
// percentage-of-debt fee-policy conditions and the (2)(B) 50/80/70/60
// percent debt-management-plan-revenue tests. Per AGENT-BRIEF's "never
// invent a rate," this package does NOT assert a 15 percent test; the
// task's own description of a "50%-referral/15%-initial-fee" rule is not
// on this fragment's face and is not modelled.

use self::{
    Corporation,
    IRC_S501_Q,
    IRC_S502_B,
    IRC_S503_B,
    IRC_S504_A,
    IRC_S504_C,
    IRC_S505_A,
    IRC_S505_B,
    IRC_S505_C,
    IRC_S508_C,
    IRC_S508_D,
    IRC_S508_E,
    IRC_S508_F,
    Person,
    TaxableYear,
    TradeOrBusiness,
    gift_within_508d3_exception,
    loan_within_safe_harbor_503b1,
    prohibited_transaction_engaged,
    rent_excluded_512b3,
    section_501c3,
};

@source(IRC_S501_Q, quote = "An organization with respect to which the provision of credit counseling services is a substantial purpose shall not be exempt from tax under subsection (a) unless such organization is described in paragraph (3) or (4) of subsection (c) and such organization is organized and operated in accordance with the following requirements:")
pub relation section_501q_requirements_met(o: Person, y: TaxableYear) kind institutional {
    label en official "section 501(q)(1): a credit-counseling-substantial-purpose organization is exempt only if it is a section 501(c)(3)/(4) organization meeting the (A)-(F) requirements — task's requested pub-adjacent classification, feeding section 513(j)'s exception";
}
pub relation credit_counseling_substantial_purpose(o: Person) kind empirical {
    label en official "the provision of credit counseling services is a substantial purpose of the organization (section 501(q)(1))";
}
@source(IRC_S501_Q, quote = "provides credit counseling services tailored to the specific needs and circumstances of consumers,")
pub relation tailored_credit_counseling_services_501q1Ai(o: Person) kind empirical {
    label en official "section 501(q)(1)(A)(i): tailored credit counseling services";
}
@source(IRC_S501_Q, quote = "makes no loans to debtors (other than loans with no fees or interest) and does not negotiate the making of loans on behalf of debtors,")
pub relation no_fee_bearing_loans_to_debtors_501q1Aii(o: Person) kind empirical {
    label en official "section 501(q)(1)(A)(ii): no loans to debtors other than fee/interest-free loans, and no negotiating loans on debtors' behalf";
}
@source(IRC_S501_Q, quote = "does not charge any separately stated fee for services for the purpose of improving any consumer's credit record, credit history, or credit rating.")
pub relation no_separate_fee_for_credit_improvement_501q1Aiv(o: Person) kind empirical {
    label en official "section 501(q)(1)(A)(iv): no separately stated fee for credit-record/history/rating improvement services";
}
@source(IRC_S501_Q, quote = "The organization does not refuse to provide credit counseling services to a consumer due to the inability of the consumer to pay, the ineligibility of the consumer for debt management plan enrollment, or the unwillingness of the consumer to enroll in a debt management plan.")
pub relation does_not_refuse_service_for_inability_to_pay_501q1B(o: Person) kind empirical {
    label en official "section 501(q)(1)(B): does not refuse service due to inability to pay, DMP ineligibility, or unwillingness to enroll";
}
@source(IRC_S501_Q, quote = "requires that any fees charged to a consumer for services are reasonable,")
pub relation fee_policy_reasonable_waivable_no_percentage_501q1C(o: Person) kind empirical {
    label en official "section 501(q)(1)(C)(i)-(iii): the fee policy requires reasonable fees, allows waiver for inability to pay, and (except as State law allows) prohibits debt/payment/savings-percentage-based fees";
}
@source(IRC_S501_Q, quote = "which is controlled by persons who represent the broad interests of the public, such as public officials acting in their capacities as such, persons having special knowledge or expertise in credit or financial education, and community leaders,")
pub relation board_controlled_by_public_interest_representatives_501q1Di(o: Person) kind empirical {
    label en official "section 501(q)(1)(D)(i): the governing body is controlled by persons representing the broad interests of the public";
}
pub relation board_voting_power_employed_or_benefiting_501q1Dii(o: Person, pct: Decimal) kind empirical {
    label en official "the percentage of board voting power held by persons employed by the organization or financially benefiting from its activities other than through directors' fees or debt repayment (section 501(q)(1)(D)(ii): must not exceed 20 percent)";
}
@source(IRC_S501_Q, quote = "not more than 20 percent of the voting power of which is vested in persons who are employed by the organization or who will benefit financially, directly or indirectly, from the organization's activities (other than through the receipt of reasonable directors' fees or the repayment of consumer debt to creditors other than the credit counseling organization or its affiliates),")
pub relation board_composition_twenty_percent_test_501q1Dii(o: Person, pct: Decimal) kind institutional {
    label en official "section 501(q)(1)(D)(ii): EXACT test — 100 * board voting power percentage <= 20 * 100 (i.e. pct <= 20), no rounding";
}
rule BoardCompositionTwentyPercentTest501q1Dii(o: Person, pct: Decimal) defeasible {
    label en official "section 501(q)(1)(D)(ii): not more than 20 percent — exact";
    when board_voting_power_employed_or_benefiting_501q1Dii(o, pct);
    when pct <= 20.0;
    then board_composition_twenty_percent_test_501q1Dii(o, pct);
}
@source(IRC_S501_Q, quote = "not more than 49 percent of the voting power of which is vested in persons who are employed by the organization or who will benefit financially, directly or indirectly, from the organization's activities (other than through the receipt of reasonable directors' fees).")
pub relation board_composition_forty_nine_percent_test_501q1Diii(o: Person, pct: Decimal) kind institutional {
    label en official "section 501(q)(1)(D)(iii): EXACT test — pct <= 49, no rounding (this is a SEPARATE, broader test than (D)(ii): it excludes only the directors'-fees carve-out, not the debt-repayment carve-out)";
}
pub relation board_voting_power_employed_or_benefiting_501q1Diii(o: Person, pct: Decimal) kind empirical {
    label en official "the percentage of board voting power held by persons employed by the organization or financially benefiting from its activities other than through directors' fees (section 501(q)(1)(D)(iii): must not exceed 49 percent)";
}
rule BoardCompositionFortyNinePercentTest501q1Diii(o: Person, pct: Decimal) defeasible {
    label en official "section 501(q)(1)(D)(iii): not more than 49 percent — exact";
    when board_voting_power_employed_or_benefiting_501q1Diii(o, pct);
    when pct <= 49.0;
    then board_composition_forty_nine_percent_test_501q1Diii(o, pct);
}
@source(IRC_S501_Q, quote = "The organization does not own more than 35 percent of—\n(i) the total combined voting power of any corporation (other than a corporation which is an organization described in subsection (c)(3) and exempt from tax under subsection (a)) which is in the trade or business of lending money, repairing credit, or providing debt management plan services, payment processing, or similar services,")
pub relation ownership_percentage_in_related_business_501q1E(o: Person, pct: Decimal) kind empirical {
    label en official "the organization's ownership percentage (voting power/profits interest/beneficial interest) in a related lending/credit-repair/DMP/payment-processing business (section 501(q)(1)(E)(i)-(iii))";
}
pub relation ownership_in_related_business_at_most_35_percent_501q1E(o: Person, pct: Decimal) kind institutional {
    label en official "section 501(q)(1)(E): EXACT test — pct <= 35, no rounding";
}
rule OwnershipInRelatedBusinessAtMost35Percent501q1E(o: Person, pct: Decimal) defeasible {
    label en official "section 501(q)(1)(E): not more than 35 percent — exact";
    when ownership_percentage_in_related_business_501q1E(o, pct);
    when pct <= 35.0;
    then ownership_in_related_business_at_most_35_percent_501q1E(o, pct);
}
@source(IRC_S501_Q, quote = "The organization receives no amount for providing referrals to others for debt management plan services, and pays no amount to others for obtaining referrals of consumers.")
pub relation no_referral_payments_received_or_paid_501q1F(o: Person) kind empirical {
    label en official "section 501(q)(1)(F): the organization neither receives amounts for DMP referrals nor pays amounts to obtain consumer referrals";
}
rule Section501qRequirementsMet(o: Person, y: TaxableYear, board_pct_ii: Decimal, board_pct_iii: Decimal, ownership_pct: Decimal) defeasible {
    label en official "section 501(q)(1): all (A)-(F) requirements, for a section 501(c)(3) or (4) organization for which credit counseling is a substantial purpose";
    when credit_counseling_substantial_purpose(o);
    when described_in_501c3_or_501c4(o, y);
    when tailored_credit_counseling_services_501q1Ai(o);
    when no_fee_bearing_loans_to_debtors_501q1Aii(o);
    when no_separate_fee_for_credit_improvement_501q1Aiv(o);
    when does_not_refuse_service_for_inability_to_pay_501q1B(o);
    when fee_policy_reasonable_waivable_no_percentage_501q1C(o);
    when board_controlled_by_public_interest_representatives_501q1Di(o);
    when board_composition_twenty_percent_test_501q1Dii(o, board_pct_ii);
    when board_composition_forty_nine_percent_test_501q1Diii(o, board_pct_iii);
    when ownership_in_related_business_at_most_35_percent_501q1E(o, ownership_pct);
    when no_referral_payments_received_or_paid_501q1F(o);
    then section_501q_requirements_met(o, y);
}
pub relation described_in_501c3_or_501c4(o: Person, y: TaxableYear) kind empirical {
    label en unofficial "the organization is described in section 501(c)(3) or (4), for section 501(q)(1)'s own predicate condition — case-asserted bridge to avoid a defeasible-taint cascade back into described_in_501c";
}

@source(IRC_S501_Q, quote = "For purposes of subparagraph (A)(ii), the applicable percentage is 50 percent.")
pub relation credit_counseling_c3_dmp_revenue_percentage_test_501q2(o: Person, y: TaxableYear, dmp_revenue: Money, total_revenue: Money) kind institutional {
    label en official "section 501(q)(2)(B)(i): EXACT test — 100 * DMP-attributable revenue <= 50 * total revenue, for a section 501(c)(3) organization not within the (ii) transition rule";
}
rule CreditCounselingC3DmpRevenuePercentageTest501q2(o: Person, y: TaxableYear, dmp_revenue: Money, total_revenue: Money) defeasible {
    label en official "section 501(q)(2)(A)-(B)(i): the 50 percent applicable-percentage test, exact";
    when credit_counseling_substantial_purpose(o);
    when section_501c3(o, y);
    when does_not_solicit_during_counseling_501q2Ai(o);
    when dmp_attributable_revenue_501q2Aii(o, y, dmp_revenue);
    when total_revenue_501q2Aii(o, y, total_revenue);
    when dmp_revenue * 100 <= total_revenue * 50;
    then credit_counseling_c3_dmp_revenue_percentage_test_501q2(o, y, dmp_revenue, total_revenue);
}
pub relation does_not_solicit_during_counseling_501q2Ai(o: Person) kind empirical {
    label en official "the organization does not solicit contributions from consumers during initial counseling or while receiving services (section 501(q)(2)(A)(i))";
}
pub relation dmp_attributable_revenue_501q2Aii(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "aggregate revenue from consumer creditors attributable to DMP services (section 501(q)(2)(A)(ii))";
}
pub relation total_revenue_501q2Aii(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "total organization revenue, for the section 501(q)(2)(A)(ii) ratio";
}

@source(IRC_S501_Q, quote = "an organization with respect to which the provision of credit counseling services is a substantial purpose and which is described in paragraph (4) of subsection (c) shall not be exempt from tax under subsection (a) unless such organization notifies the Secretary, in such manner as the Secretary may by regulations prescribe, that it is applying for recognition as a credit counseling organization.")
pub relation section_501q3_notice_given(o: Person) kind empirical {
    label en official "section 501(q)(3): a section 501(c)(4) credit-counseling organization notified the Secretary that it is applying for recognition as such";
}

// =======================================================================
// Section 505: requirements for section 501(c)(9)/(17) plans.
// =======================================================================

@source(IRC_S505_A, quote = "An organization described in section 501(c)(9) which is part of a plan shall not be exempt from tax under section 501(a) unless such plan meets the requirements of subsection (b) of this section.")
pub relation section_505a_veba_plan_requirement(o: Person, y: TaxableYear) kind institutional {
    label en official "section 505(a)(1): a section 501(c)(9) organization that is part of a plan is exempt only if the plan meets the section 505(b) nondiscrimination requirements, unless the (a)(2) collective-bargaining exception applies";
}
pub relation veba_part_of_plan(o: Person, y: TaxableYear) kind empirical {
    label en official "the section 501(c)(9) organization is part of an employee-benefit plan (section 505(a)(1))";
}
@source(IRC_S505_A, quote = "Paragraph (1) shall not apply to any organization which is part of a plan maintained pursuant to an agreement between employee representatives and 1 or more employers if the Secretary finds that such agreement is a collective bargaining agreement and that such plan was the subject of good faith bargaining between such employee representatives and such employer or employers.")
pub relation veba_collective_bargaining_exception_505a2(o: Person, y: TaxableYear) kind empirical {
    label en official "section 505(a)(2): the plan is maintained under a Secretary-found collective bargaining agreement, subject to good-faith bargaining";
}
rule Section505aVebaPlanRequirement(o: Person, y: TaxableYear) defeasible {
    label en official "section 505(a): the nondiscrimination requirement applies unless the collective-bargaining exception controls";
    when veba_part_of_plan(o, y);
    unless veba_collective_bargaining_exception_505a2(o, y);
    then section_505a_veba_plan_requirement(o, y);
}
@source(IRC_S505_B, quote = "each class of benefits under the plan is provided under a classification of employees which is set forth in the plan and which is found by the Secretary not to be discriminatory in favor of employees who are highly compensated individuals, and")
pub external judgment relation ClassificationFoundNondiscriminatory505b1A(o: Person, y: TaxableYear) {
    authority Secretary;
    label en official "the plan's benefit classification is found by the Secretary not to discriminate in favor of highly compensated individuals (section 505(b)(1)(A)) — DECISION-0194 evaluative channel";
}
@source(IRC_S505_B, quote = "in the case of each class of benefits, such benefits do not discriminate in favor of employees who are highly compensated individuals.")
pub relation benefits_do_not_discriminate_505b1B(o: Person, y: TaxableYear) kind empirical {
    label en official "the benefits within each class do not discriminate in favor of highly compensated individuals (section 505(b)(1)(B))";
}
pub relation veba_plan_meets_nondiscrimination_505b(o: Person, y: TaxableYear) kind institutional {
    label en official "section 505(b)(1): the plan meets the nondiscrimination requirements";
}
rule VebaPlanMeetsNondiscrimination505b(o: Person, y: TaxableYear) defeasible {
    label en official "section 505(b)(1)(A)-(B)";
    when ClassificationFoundNondiscriminatory505b1A(o, y);
    when benefits_do_not_discriminate_505b1B(o, y);
    then veba_plan_meets_nondiscrimination_505b(o, y);
}
@source(IRC_S505_B, quote = "A plan shall not be treated as meeting the requirements of this subsection unless under the plan the annual compensation of each employee taken into account for any year does not exceed $200,000.")
pub relation compensation_limit_exceeded_505b7(o: Person, y: TaxableYear, compensation: Money) kind institutional {
    label en official "section 505(b)(7): the plan violates the compensation limit if any employee's annual compensation taken into account exceeds the statutory base $200,000 (subject to section 401(a)(17)(B) indexing — SOURCE_GAP for the indexed figure)";
}
rule CompensationLimitExceeded505b7(o: Person, y: TaxableYear, compensation: Money) defeasible {
    label en official "section 505(b)(7): exact $200,000 statutory-base test";
    when employee_compensation_taken_into_account_505b7(o, y, compensation);
    when compensation > 200000.00 USD;
    then compensation_limit_exceeded_505b7(o, y, compensation);
}
pub relation employee_compensation_taken_into_account_505b7(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "an employee's annual compensation taken into account under the plan, for section 505(b)(7)";
}

@source(IRC_S505_C, quote = "An organization shall not be treated as an organization described in paragraph (9) or (17) of section 501(c)—\n(A) unless it has given notice to the Secretary, in such manner as the Secretary may by regulations prescribe, that it is applying for recognition of such status, or")
pub relation section_505c_notice_requirement_met(o: Person, notified_on: Date) kind institutional {
    label en official "section 505(c)(1): the organization is treated as a section 501(c)(9)/(17) organization only from the date it gives the Secretary notice (subject to the (c)(2) pre-1984 transition rule)";
}
pub relation section_505c_notice_given(o: Person, notified_on: Date) kind empirical {
    label en official "the date the organization gave the Secretary notice under section 505(c)(1)(A)";
}
rule Section505cNoticeRequirementMet(o: Person, notified_on: Date) defeasible {
    label en official "section 505(c)(1)(A): notice given";
    when section_505c_notice_given(o, notified_on);
    then section_505c_notice_requirement_met(o, notified_on);
}

// =======================================================================
// Section 504: loss of section 501(c)(4) status after (c)(3)
// disqualification for lobbying/political-campaign activity.
// =======================================================================

@source(IRC_S504_A, quote = "An organization which—\n(1) was exempt (or was determined by the Secretary to be exempt) from taxation under section 501(a) by reason of being an organization described in section 501(c)(3), and\n(2) is not an organization described in section 501(c)(3)—\n(A) by reason of carrying on propaganda, or otherwise attempting, to influence legislation, or\n(B) by reason of participating in, or intervening in, any political campaign on behalf of (or in opposition to) any candidate for public office,\nshall not at any time thereafter be treated as an organization described in section 501(c)(4).")
pub relation permanently_barred_from_501c4_504a(o: Person) kind institutional {
    label en official "section 504(a): an organization once section 501(c)(3)-exempt, then disqualified from (c)(3) for lobbying or political-campaign activity, is permanently barred from ever being treated as a section 501(c)(4) organization";
}
pub relation formerly_exempt_as_501c3_504a1(o: Person) kind empirical {
    label en official "the organization was exempt (or Secretary-determined exempt) as a section 501(c)(3) organization (section 504(a)(1))";
}
pub relation no_longer_501c3_due_to_lobbying_504a2A(o: Person) kind empirical {
    label en official "the organization is not (or no longer) a section 501(c)(3) organization because of carrying on propaganda/influencing legislation (section 504(a)(2)(A))";
}
pub relation no_longer_501c3_due_to_political_campaign_504a2B(o: Person) kind empirical {
    label en official "the organization is not (or no longer) a section 501(c)(3) organization because of political-campaign participation/intervention (section 504(a)(2)(B))";
}
@source(IRC_S504_C, quote = "Subsection (a) shall not apply to any organization which is a disqualified organization within the meaning of section 501(h)(5) (relating to churches, etc.) for the taxable year immediately preceding the first taxable year for which such organization is described in paragraph (2) of subsection (a).")
pub relation church_exception_504c(o: Person) kind empirical {
    label en official "section 504(c): the organization was a section 501(h)(5) disqualified organization (church, etc.) for the taxable year immediately preceding its first disqualifying year — exempts it from section 504(a)";
}
rule PermanentlyBarredFrom501c4Lobbying504a(o: Person) defeasible {
    label en official "section 504(a) via (2)(A) lobbying disqualification";
    when formerly_exempt_as_501c3_504a1(o);
    when no_longer_501c3_due_to_lobbying_504a2A(o);
    unless church_exception_504c(o);
    then permanently_barred_from_501c4_504a(o);
}
rule PermanentlyBarredFrom501c4PoliticalCampaign504a(o: Person) defeasible {
    label en official "section 504(a) via (2)(B) political-campaign disqualification";
    when formerly_exempt_as_501c3_504a1(o);
    when no_longer_501c3_due_to_political_campaign_504a2B(o);
    unless church_exception_504c(o);
    then permanently_barred_from_501c4_504a(o);
}

// =======================================================================
// Section 502(b): further "trade or business" exclusions for feeder
// organizations.
// =======================================================================

@source(IRC_S502_B, quote = "the deriving of rents which would be excluded under section 512(b)(3), if section 512 applied to the organization,")
pub relation not_feeder_trade_or_business_502b1(o: Person, activity: TradeOrBusiness) kind institutional {
    label en official "section 502(b)(1): rents that would be excluded under section 512(b)(3) are not 'trade or business' for feeder-organization purposes";
}
rule NotFeederTradeOrBusiness502b1(o: Person, activity: TradeOrBusiness, y: TaxableYear, amount: Money) defeasible {
    label en official "section 502(b)(1)";
    when rent_excluded_512b3(o, activity, y, amount);
    then not_feeder_trade_or_business_502b1(o, activity);
}
@source(IRC_S502_B, quote = "any trade or business in which substantially all the work in carrying on such trade or business is performed for the organization without compensation, or")
pub relation not_feeder_trade_or_business_502b2(o: Person, activity: TradeOrBusiness) kind institutional {
    label en official "section 502(b)(2): a trade or business substantially all of whose work is performed without compensation is not 'trade or business' for feeder-organization purposes";
}
pub relation substantially_all_work_uncompensated_502b2(o: Person, activity: TradeOrBusiness) kind empirical {
    label en official "substantially all the work carrying on the activity is performed for the organization without compensation (section 502(b)(2))";
}
rule NotFeederTradeOrBusiness502b2(o: Person, activity: TradeOrBusiness) defeasible {
    label en official "section 502(b)(2)";
    when substantially_all_work_uncompensated_502b2(o, activity);
    then not_feeder_trade_or_business_502b2(o, activity);
}
@source(IRC_S502_B, quote = "any trade or business which is the selling of merchandise, substantially all of which has been received by the organization as gifts or contributions.")
pub relation not_feeder_trade_or_business_502b3(o: Person, activity: TradeOrBusiness) kind institutional {
    label en official "section 502(b)(3): selling merchandise substantially all received as gifts/contributions is not 'trade or business' for feeder-organization purposes";
}
pub relation merchandise_substantially_all_donated_502b3(o: Person, activity: TradeOrBusiness) kind empirical {
    label en official "substantially all the merchandise sold was received by the organization as gifts or contributions (section 502(b)(3))";
}
rule NotFeederTradeOrBusiness502b3(o: Person, activity: TradeOrBusiness) defeasible {
    label en official "section 502(b)(3)";
    when merchandise_substantially_all_donated_502b3(o, activity);
    then not_feeder_trade_or_business_502b3(o, activity);
}

// =======================================================================
// Section 503(b): the prohibited-transaction catalogue, decomposed.
// =======================================================================

pub enum ProhibitedTransactionKind {
    LoanWithoutAdequateSecurityOrInterest,
    ExcessCompensation,
    PreferentialServices,
    PurchaseAtMoreThanAdequateConsideration,
    SaleAtLessThanAdequateConsideration,
    OtherSubstantialDiversion
}
@source(IRC_S503_B, quote = "the term \"prohibited transaction\" means any transaction in which an organization subject to the provisions of this section—\n(1) lends any part of its income or corpus, without the receipt of adequate security and a reasonable rate of interest, to;")
pub relation prohibited_transaction_503b(o: Person, y: TaxableYear, counterparty: Person, kind: ProhibitedTransactionKind) kind institutional {
    label en official "section 503(b): a transaction of one of the six kinds, with a section 503(b) counterparty, is a prohibited transaction";
}
pub relation loan_without_adequate_security_or_interest_503b1(o: Person, y: TaxableYear, counterparty: Person) kind empirical {
    label en official "section 503(b)(1): a loan of income/corpus without adequate security and a reasonable interest rate";
}
pub relation excess_compensation_503b2(o: Person, y: TaxableYear, counterparty: Person) kind empirical {
    label en official "section 503(b)(2): compensation exceeding a reasonable allowance for services actually rendered";
}
pub relation preferential_services_503b3(o: Person, y: TaxableYear, counterparty: Person) kind empirical {
    label en official "section 503(b)(3): services made available on a preferential basis";
}
pub relation purchase_at_excess_consideration_503b4(o: Person, y: TaxableYear, counterparty: Person) kind empirical {
    label en official "section 503(b)(4): a substantial purchase of securities/property for more than adequate consideration";
}
pub relation sale_at_inadequate_consideration_503b5(o: Person, y: TaxableYear, counterparty: Person) kind empirical {
    label en official "section 503(b)(5): a sale of a substantial part of securities/property for less than adequate consideration";
}
pub relation other_substantial_diversion_503b6(o: Person, y: TaxableYear, counterparty: Person) kind empirical {
    label en official "section 503(b)(6): any other transaction resulting in a substantial diversion of income or corpus";
}
pub relation section_503b_covered_counterparty(o: Person, counterparty: Person) kind institutional {
    label en official "the counterparty is the creator (if a trust), a substantial contributor, a section 267(c)(4) family member of either, or a corporation 50-percent-or-more controlled (by vote or value) by the creator or substantial contributor — section 503(b) flush language";
}
pub relation creator_of_trust_503b(o: Person, creator: Person) kind empirical { label en official "the person is the creator of the organization (if a trust) (section 503(b) flush language)"; }
pub relation substantial_contributor_503b(o: Person, contributor: Person) kind empirical { label en official "the person has made a substantial contribution to the organization (section 503(b) flush language)"; }
pub relation family_member_267c4_of_creator_or_contributor_503b(o: Person, family_member: Person) kind empirical { label en official "the person is a section 267(c)(4) family member of the creator or a substantial contributor (section 503(b) flush language)"; }
rule Section503bCoveredViaCreator(o: Person, creator: Person) defeasible { label en official "section 503(b) flush: the trust's creator"; when creator_of_trust_503b(o, creator); then section_503b_covered_counterparty(o, creator); }
rule Section503bCoveredViaContributor(o: Person, contributor: Person) defeasible { label en official "section 503(b) flush: a substantial contributor"; when substantial_contributor_503b(o, contributor); then section_503b_covered_counterparty(o, contributor); }
rule Section503bCoveredViaFamily(o: Person, family_member: Person) defeasible { label en official "section 503(b) flush: a section 267(c)(4) family member"; when family_member_267c4_of_creator_or_contributor_503b(o, family_member); then section_503b_covered_counterparty(o, family_member); }
rule Section503bCoveredViaControlledCorporation(o: Person, corp: Corporation, controller: Person, share: Decimal, via: us.irc.corporations::AttributionKind) defeasible {
    label en official "section 503(b) flush: a corporation 50-percent-or-more controlled (by vote or value) by the creator or a substantial contributor, applying section 318-style constructive ownership — reads the CREATOR/CONTRIBUTOR base facts directly (not the general `section_503b_covered_counterparty` head) to avoid an LDC-E4102 self-referential cycle, matching the statute's own literal text ('a corporation controlled by such creator or person'), not the family-member category";
    when creator_or_contributor_503b(o, controller);
    when us.irc.corporations::constructive_ownership(controller, corp, share, via);
    when share >= 0.50;
    then section_503b_covered_counterparty(o, corp);
}
pub relation creator_or_contributor_503b(o: Person, controller: Person) kind institutional {
    label en official "the person is the creator of the trust or a substantial contributor to the organization (section 503(b) flush language, the two categories a controlled corporation's control chain can run through)";
}
rule CreatorOrContributor503bViaCreator(o: Person, controller: Person) defeasible { label en official "creator branch"; when creator_of_trust_503b(o, controller); then creator_or_contributor_503b(o, controller); }
rule CreatorOrContributor503bViaContributor(o: Person, controller: Person) defeasible { label en official "contributor branch"; when substantial_contributor_503b(o, controller); then creator_or_contributor_503b(o, controller); }
rule ProhibitedTransaction503bVia1(o: Person, y: TaxableYear, counterparty: Person) defeasible { label en official "section 503(b)(1)"; when loan_without_adequate_security_or_interest_503b1(o, y, counterparty); when section_503b_covered_counterparty(o, counterparty); unless loan_within_safe_harbor_503b1(o, y, counterparty); then prohibited_transaction_503b(o, y, counterparty, LoanWithoutAdequateSecurityOrInterest); }
rule ProhibitedTransaction503bVia2(o: Person, y: TaxableYear, counterparty: Person) defeasible { label en official "section 503(b)(2)"; when excess_compensation_503b2(o, y, counterparty); when section_503b_covered_counterparty(o, counterparty); then prohibited_transaction_503b(o, y, counterparty, ExcessCompensation); }
rule ProhibitedTransaction503bVia3(o: Person, y: TaxableYear, counterparty: Person) defeasible { label en official "section 503(b)(3)"; when preferential_services_503b3(o, y, counterparty); when section_503b_covered_counterparty(o, counterparty); then prohibited_transaction_503b(o, y, counterparty, PreferentialServices); }
rule ProhibitedTransaction503bVia4(o: Person, y: TaxableYear, counterparty: Person) defeasible { label en official "section 503(b)(4)"; when purchase_at_excess_consideration_503b4(o, y, counterparty); when section_503b_covered_counterparty(o, counterparty); then prohibited_transaction_503b(o, y, counterparty, PurchaseAtMoreThanAdequateConsideration); }
rule ProhibitedTransaction503bVia5(o: Person, y: TaxableYear, counterparty: Person) defeasible { label en official "section 503(b)(5)"; when sale_at_inadequate_consideration_503b5(o, y, counterparty); when section_503b_covered_counterparty(o, counterparty); then prohibited_transaction_503b(o, y, counterparty, SaleAtLessThanAdequateConsideration); }
rule ProhibitedTransaction503bVia6(o: Person, y: TaxableYear, counterparty: Person) defeasible { label en official "section 503(b)(6)"; when other_substantial_diversion_503b6(o, y, counterparty); when section_503b_covered_counterparty(o, counterparty); then prohibited_transaction_503b(o, y, counterparty, OtherSubstantialDiversion); }
rule ProhibitedTransactionEngagedBridge(o: Person, y: TaxableYear, counterparty: Person, kind: ProhibitedTransactionKind) defeasible {
    label en unofficial "bridges the decomposed section 503(b) catalogue to module 02's existing prohibited_transaction_engaged head";
    when prohibited_transaction_503b(o, y, counterparty, kind);
    then prohibited_transaction_engaged(o, y);
}

// =======================================================================
// Section 508(c)(2)-(3), (d)-(f).
// =======================================================================

@source(IRC_S508_C, quote = "The Secretary may by regulations exempt (to the extent and subject to such conditions as may be prescribed in such regulations) from the provisions of subsection (a) or (b) or both—\n(A) educational organizations described in section 170(b)(1)(A)(ii), and")
pub relation section_508c2_regulatory_exception(o: Person) kind institutional {
    label en unofficial "section 508(c)(2): a Secretary-regulation exception from subsections (a)/(b) — EXTERNAL_DEPENDENCY (regulations not pinned by this package)";
}
@source(IRC_S508_D, quote = "No gift or bequest made to an organization upon which the tax provided by section 507(c) has been imposed shall be allowed as a deduction under section 170, 545(b)(2), 642(c), 2055, 2106(a)(2), or 2522, if such gift or bequest is made—\n(A) by any person after notification is made under section 507(a), or")
pub relation charitable_deduction_disallowed_508d1(donor: Person, org: Person, gift_amount: Money) kind institutional {
    label en official "section 508(d)(1): no charitable deduction (sections 170/545(b)(2)/642(c)/2055/2106(a)(2)/2522) for a gift or bequest to a section 507(c)-taxed organization, made after section 507(a) notification or by a substantial contributor from the tainted year onward";
}
pub relation gift_made_after_507a_notification(donor: Person, org: Person, gift_amount: Money) kind empirical {
    label en official "the gift or bequest was made after section 507(a) termination notification (section 508(d)(1)(A))";
}
pub relation gift_by_substantial_contributor_in_tainted_year_508d1B(donor: Person, org: Person, gift_amount: Money) kind empirical {
    label en official "the gift or bequest was made by a substantial contributor (section 507(d)(2)) in the taxable year including the first day of the culminating section 507(c) action, or a subsequent year (section 508(d)(1)(B))";
}
rule CharitableDeductionDisallowed508d1ViaA(donor: Person, org: Person, gift_amount: Money) defeasible { label en official "section 508(d)(1)(A)"; when gift_made_after_507a_notification(donor, org, gift_amount); unless gift_within_508d3_exception(donor, org, gift_amount); then charitable_deduction_disallowed_508d1(donor, org, gift_amount); }
rule CharitableDeductionDisallowed508d1ViaB(donor: Person, org: Person, gift_amount: Money) defeasible { label en official "section 508(d)(1)(B)"; when gift_by_substantial_contributor_in_tainted_year_508d1B(donor, org, gift_amount); unless gift_within_508d3_exception(donor, org, gift_amount); then charitable_deduction_disallowed_508d1(donor, org, gift_amount); }

@source(IRC_S508_E, quote = "A private foundation shall not be exempt from taxation under section 501(a) unless its governing instrument includes provisions the effects of which are—\n(A) to require its income for each taxable year to be distributed at such time and in such manner as not to subject the foundation to tax under section 4942, and")
pub relation governing_instrument_requires_4942_distribution_508e1A(o: Person) kind empirical {
    label en official "the governing instrument requires timely income distribution to avoid section 4942 tax (section 508(e)(1)(A))";
}
@source(IRC_S508_E, quote = "to prohibit the foundation from engaging in any act of self-dealing (as defined in section 4941(d)), from retaining any excess business holdings (as defined in section 4943(c)), from making any investments in such manner as to subject the foundation to tax under section 4944, and from making any taxable expenditures (as defined in section 4945(d)).")
pub relation governing_instrument_prohibits_4941_4943_4944_4945_508e1B(o: Person) kind empirical {
    label en official "the governing instrument prohibits self-dealing (section 4941(d)), excess business holdings (section 4943(c)), jeopardizing investments (section 4944), and taxable expenditures (section 4945(d)) (section 508(e)(1)(B))";
}
pub relation private_foundation_governing_instrument_requirement_met_508e(o: Person) kind institutional {
    label en official "section 508(e)(1): the private foundation's governing instrument meets both required provisions";
}
rule PrivateFoundationGoverningInstrumentRequirementMet508e(o: Person) defeasible {
    label en official "section 508(e)(1)(A)-(B)";
    when governing_instrument_requires_4942_distribution_508e1A(o);
    when governing_instrument_prohibits_4941_4943_4944_4945_508e1B(o);
    then private_foundation_governing_instrument_requirement_met_508e(o);
}
@source(IRC_S508_E, quote = "In the case of any organization organized before January 1, 1970, paragraph (1) shall not apply—\n(A) to any period after December 31, 1971, during the pendency of any judicial proceeding begun before January 1, 1972, by the private foundation which is necessary to reform, or to excuse such foundation from compliance with, its governing instrument or any other instrument in order to meet the requirements of paragraph (1), and")
pub relation pre_1970_judicial_proceeding_exception_508e2(o: Person) kind empirical {
    label en official "section 508(e)(2): the organization, organized before January 1, 1970, is within the pendency (or post-termination gap) of a qualifying pre-1972 judicial reformation proceeding — exempting it from (e)(1)";
}

@source(IRC_S508_F, quote = "A sponsoring organization (as defined in section 4966(d)(1)) shall give notice to the Secretary (in such manner as the Secretary may provide) whether such organization maintains or intends to maintain donor advised funds (as defined in section 4966(d)(2)) and the manner in which such organization plans to operate such funds.")
pub relation section_508f_sponsoring_organization_notice_given(o: Person) kind empirical {
    label en official "section 508(f): the sponsoring organization (section 4966(d)(1)) gave the Secretary notice on whether/how it maintains donor advised funds";
}
pub relation section_508f_sponsoring_organization_duty_discharged(o: Person) kind institutional {
    label en official "section 508(f): the sponsoring organization's notice duty is discharged";
}
rule Section508fSponsoringOrganizationDutyDischarged(o: Person) defeasible {
    label en official "section 508(f)";
    when sponsoring_organization_4966d1(o);
    when section_508f_sponsoring_organization_notice_given(o);
    then section_508f_sponsoring_organization_duty_discharged(o);
}
pub relation sponsoring_organization_4966d1(o: Person) kind empirical {
    label en unofficial "the organization is a sponsoring organization within section 4966(d)(1) — EXTERNAL_DEPENDENCY, section 4966 is not owned by this package";
}
