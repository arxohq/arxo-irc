// Stage 3: section 512(b)(19)(F)-(I) (TECH-GAPS G2004): the determination of gain, the qualifying partnership, the
// partner's share, the one-time election to average the expenditures of several properties, its start, revocation, and
// the recapture. Modules 23 and 24 carry (A)-(E), (H)(ii)(II) and (J).

// =====================================================================
// (F): determination of gain or loss
// =====================================================================

use self::{
    IRC_S512_B,
    Person,
    TaxableYear,
    election_return_first_day_of_taxable_year_512b19Hii_I,
};

pub relation brownfield_gain_or_loss_before_recapture_carveout_512b19F(o: Person, asset_id: Text, amount: Money) kind empirical {
    label en official "section 512(b)(19)(F): the gain or loss from the qualified disposition before taking out ordinary income";
}
pub relation brownfield_ordinary_income_recapture_deducted_in_ubti_512b19F(o: Person, asset_id: Text, amount: Money) kind empirical {
    label en official "section 512(b)(19)(F): the amount treated as gain which is ordinary income with respect to section 1245 or section 1250 property (including section 198 expenses subject to the recapture rules of section 198(e)), if the taxpayer had deducted such amounts in the computation of its unrelated business taxable income";
}
pub relation brownfield_gain_or_loss_for_paragraph_19_512b19F(o: Person, asset_id: Text, amount: Money) kind institutional {
    label en official "section 512(b)(19)(F): the gain or loss for the exclusion is the gain or loss less the recaptured ordinary income deducted in unrelated business taxable income. The exclusion rule of module 23 still reads its own asserted amount";
}
@source(IRC_S512_B, quote = "(F) Determination of gain or loss.—For purposes of this paragraph, the determination of gain or loss shall not include an amount treated as gain which is ordinary income with respect to section 1245 or section 1250 property")
rule BrownfieldGainOrLossForParagraph19DeterminedWithoutRecapture512b19F(o: Person, asset_id: Text, gain: Money, recapture: Money) defeasible {
    label en official "section 512(b)(19)(F): the gain less the ordinary income recaptured and deducted";
    when brownfield_gain_or_loss_before_recapture_carveout_512b19F(o, asset_id, gain);
    when brownfield_ordinary_income_recapture_deducted_in_ubti_512b19F(o, asset_id, recapture);
    then brownfield_gain_or_loss_for_paragraph_19_512b19F(o, asset_id, gain - recapture);
}
rule BrownfieldGainOrLossForParagraph19WithoutRecapture512b19F(o: Person, asset_id: Text, gain: Money) defeasible {
    label en official "section 512(b)(19)(F): no recaptured ordinary income deducted: the gain or loss is unchanged";
    when brownfield_gain_or_loss_before_recapture_carveout_512b19F(o, asset_id, gain);
    when not_known(brownfield_recapture_recorded_for_asset_512b19F(o, asset_id));
    then brownfield_gain_or_loss_for_paragraph_19_512b19F(o, asset_id, gain);
}
pub relation brownfield_recapture_recorded_for_asset_512b19F(o: Person, asset_id: Text) kind institutional {
    label en official "marker: a recaptured ordinary income amount is recorded for the property";
}
rule BrownfieldRecaptureRecordedMarker512b19F(o: Person, asset_id: Text, recapture: Money) defeasible {
    label en official "marker";
    when brownfield_ordinary_income_recapture_deducted_in_ubti_512b19F(o, asset_id, recapture);
    then brownfield_recapture_recorded_for_asset_512b19F(o, asset_id);
}

// =====================================================================
// (G): partnerships
// =====================================================================

pub relation partnership_agreement_meets_514c9Bvi_since_first_certification_512b19GiiI(partnership: Person) kind empirical {
    label en official "section 512(b)(19)(G)(ii)(I): the partnership agreement satisfies the requirements of section 514(c)(9)(B)(vi) at all times beginning on the date of the first certification received by the partnership under subparagraph (C)(i)";
}
pub relation partnership_meets_eligible_taxpayer_requirements_as_qualified_partnership_512b19GiiII(partnership: Person) kind empirical {
    label en official "section 512(b)(19)(G)(ii)(II): the partnership satisfies the requirements of subparagraphs (B)(i), (C), (D) and (E), reading \"qualified partnership\" for \"eligible taxpayer\" each place it appears (except subparagraph (D)(iii))";
}
pub relation partnership_prevented_from_being_eligible_taxpayer_by_512b19Bii_512b19GiiIII(partnership: Person) kind empirical {
    label en official "section 512(b)(19)(G)(ii)(III): the partnership is an organization which would be prevented from constituting an eligible taxpayer by reason of subparagraph (B)(ii)";
}
pub relation qualifying_partnership_512b19G(partnership: Person) kind institutional {
    label en official "section 512(b)(19)(G)(ii): a qualifying partnership";
}
@source(IRC_S512_B, quote = "(ii) Qualifying partnership.—The term \"qualifying partnership\" means a partnership which—")
rule QualifyingPartnership512b19Gii(partnership: Person) defeasible {
    label en official "section 512(b)(19)(G)(ii)(I)-(III): the agreement condition, the substituted requirements, and not an organization barred by (B)(ii)";
    when partnership_agreement_meets_514c9Bvi_since_first_certification_512b19GiiI(partnership);
    when partnership_meets_eligible_taxpayer_requirements_as_qualified_partnership_512b19GiiII(partnership);
    unless partnership_prevented_from_being_eligible_taxpayer_by_512b19Bii_512b19GiiIII(partnership);
    then qualifying_partnership_512b19G(partnership);
}
pub relation first_certification_received_by_partnership_on_512b19Giii(partnership: Person, on: Date) kind empirical {
    label en official "section 512(b)(19)(G)(iii): the date of the first certification received by the partnership under subparagraph (C)(i)";
}
pub relation partnership_disposed_of_brownfield_property_on_512b19Giii(partnership: Person, on: Date) kind empirical {
    label en official "section 512(b)(19)(G)(iii): the date of the sale, exchange or other disposition of the property by the partnership";
}
pub relation partner_of_partnership_continuously_from_to_512b19Giii(partner: Person, partnership: Person, from: Date, through: Date) kind empirical {
    label en official "section 512(b)(19)(G)(iii): the eligible taxpayer was a partner of the qualifying partnership continuously from the first date through the last date";
}
pub relation partner_for_the_whole_certification_to_disposition_period_512b19Giii(partner: Person, partnership: Person) kind institutional {
    label en official "section 512(b)(19)(G)(iii): the partner was a partner at all times from the first certification to the disposition (the end date itself counts)";
}
@source(IRC_S512_B, quote = "only if such eligible taxpayer was a partner of the qualifying partnership at all times beginning on the date of the first certification received by the partnership under subparagraph (C)(i) and ending on the date of the sale, exchange, or other disposition of the property by the partnership.")
rule PartnerForTheWholePeriod512b19Giii(partner: Person, partnership: Person, from: Date, through: Date, first: Date, disposed: Date) defeasible {
    label en official "section 512(b)(19)(G)(iii): the membership span covers the whole period from the first certification to the disposition";
    when partner_of_partnership_continuously_from_to_512b19Giii(partner, partnership, from, through);
    when first_certification_received_by_partnership_on_512b19Giii(partnership, first);
    when partnership_disposed_of_brownfield_property_on_512b19Giii(partnership, disposed);
    when from <= first;
    when through >= disposed;
    then partner_for_the_whole_certification_to_disposition_period_512b19Giii(partner, partnership);
}
pub relation partner_is_eligible_taxpayer_for_partnership_property_512b19Gi(partner: Person, partnership: Person) kind empirical {
    label en official "section 512(b)(19)(G)(i): the partner is an eligible taxpayer";
}
pub relation distributive_share_of_partnership_brownfield_gain_or_loss_512b19Gi(partner: Person, partnership: Person, amount: Money) kind empirical {
    label en official "section 512(b)(19)(G)(i): the partner's distributive share of the qualifying partnership's gain or loss from the disposition of the property";
}
pub relation partner_share_of_partnership_brownfield_gain_or_loss_excluded_512b19Gi(partner: Person, partnership: Person, amount: Money) kind institutional {
    label en official "section 512(b)(19)(G)(i), (iii): the paragraph applies to the eligible taxpayer's distributive share of the qualifying partnership's gain or loss, if the partner was a partner for the whole period";
}
@source(IRC_S512_B, quote = "this paragraph shall apply to the eligible taxpayer's distributive share of the qualifying partnership's gain or loss from the sale, exchange, or other disposition of such property.")
rule PartnerShareOfPartnershipBrownfieldGainExcluded512b19Gi(partner: Person, partnership: Person, share: Money) defeasible {
    label en official "section 512(b)(19)(G)(i)";
    when partner_is_eligible_taxpayer_for_partnership_property_512b19Gi(partner, partnership);
    when qualifying_partnership_512b19G(partnership);
    when partner_for_the_whole_certification_to_disposition_period_512b19Giii(partner, partnership);
    when distributive_share_of_partnership_brownfield_gain_or_loss_512b19Gi(partner, partnership, share);
    then partner_share_of_partnership_brownfield_gain_or_loss_excluded_512b19Gi(partner, partnership, share);
}

// =====================================================================
// (H): the one-time election for several properties
// =====================================================================

pub relation eligible_taxpayer_or_partner_of_qualifying_partnership_512b19Hi(o: Person) kind empirical {
    label en official "section 512(b)(19)(H)(i): an eligible taxpayer, or a qualifying partnership of which the eligible taxpayer is a partner";
}
pub relation election_revoked_512b19Hiii(o: Person) kind empirical {
    label en official "section 512(b)(19)(H)(iii): the election under clause (i) was revoked";
}
pub relation ineligible_to_make_another_election_512b19Hiii(o: Person) kind institutional {
    label en official "section 512(b)(19)(H)(iii): once the election is revoked the taxpayer is ineligible to make another election under clause (i) with respect to any qualifying brownfield property subject to the revoked election";
}
@source(IRC_S512_B, quote = "Once an eligible taxpayer or qualifying partnership revokes the election, the eligible taxpayer or qualifying partnership is ineligible to make another election under clause (i) with respect to any qualifying brownfield property subject to the revoked election.")
rule IneligibleToMakeAnotherElection512b19Hiii(o: Person) defeasible {
    label en official "section 512(b)(19)(H)(iii), last sentence";
    when election_revoked_512b19Hiii(o);
    then ineligible_to_make_another_election_512b19Hiii(o);
}
pub relation may_make_multi_property_election_512b19Hi(o: Person) kind institutional {
    label en official "section 512(b)(19)(H)(i): the taxpayer may make the 1-time election (an eligible taxpayer or qualifying partnership, not one that revoked)";
}
rule MayMakeMultiPropertyElection512b19Hi(o: Person) defeasible {
    label en official "section 512(b)(19)(H)(i), (iii)";
    when eligible_taxpayer_or_partner_of_qualifying_partnership_512b19Hi(o);
    unless ineligible_to_make_another_election_512b19Hiii(o);
    then may_make_multi_property_election_512b19Hi(o);
}
pub relation multi_property_election_made_512b19Hi(o: Person) kind institutional {
    label en official "section 512(b)(19)(H)(i): the election to apply the paragraph to more than 1 qualifying brownfield property by averaging the eligible remediation expenditures";
}
pub relation elects_multi_property_averaging_512b19Hi(o: Person) kind empirical {
    label en official "the exercise fact for the section 512(b)(19)(H)(i) election, made with a timely filed return";
}
@source(IRC_S512_B, quote = "may make a 1-time election to apply this paragraph to more than 1 qualifying brownfield property by averaging the eligible remediation expenditures for all such properties acquired during the election period.")
rule MultiPropertyElectionPower512b19Hi(o: Person) defeasible {
    label en official "section 512(b)(19)(H)(i)-(ii): a power of the eligible taxpayer or qualifying partnership to elect (once) to average the expenditures of the properties";
    when eligible_taxpayer_or_partner_of_qualifying_partnership_512b19Hi(o);
    then power MultiPropertyBrownfieldElection512b19H {
        holder o;
        exercise elects_multi_property_averaging_512b19Hi(o);
        valid_when may_make_multi_property_election_512b19Hi(o);
        effect multi_property_election_made_512b19Hi(o);
    };
}
pub relation later_day_selected_in_election_year_512b19HiiI(o: Person, day: Date) kind empirical {
    label en official "section 512(b)(19)(H)(ii)(I): a later day in the taxable year of the return, selected by the taxpayer";
}
pub relation later_day_selected_marker_512b19HiiI(o: Person) kind institutional {
    label en official "marker: a later day was selected";
}
rule LaterDaySelectedMarker512b19HiiI(o: Person, day: Date) defeasible {
    label en official "marker";
    when later_day_selected_in_election_year_512b19HiiI(o, day);
    then later_day_selected_marker_512b19HiiI(o);
}
pub relation election_period_start_512b19HiiI(o: Person, start: Date) kind institutional {
    label en official "section 512(b)(19)(H)(ii)(I): the election period begins on the first day of the taxable year of the return in which the election is included, or a later day in that year selected by the taxpayer";
}
@source(IRC_S512_B, quote = "(I) beginning on the date which is the first day of the taxable year of the return in which the election is included or a later day in such taxable year selected by the eligible taxpayer or qualifying partnership, and")
rule ElectionPeriodStartFirstDay512b19HiiI(o: Person, first: Date) defeasible {
    label en official "section 512(b)(19)(H)(ii)(I): the first day of the taxable year of the return, when no later day is selected";
    when election_return_first_day_of_taxable_year_512b19Hii_I(o, first);
    when not_known(later_day_selected_marker_512b19HiiI(o));
    then election_period_start_512b19HiiI(o, first);
}
rule ElectionPeriodStartLaterDay512b19HiiI(o: Person, first: Date, day: Date) defeasible {
    label en official "section 512(b)(19)(H)(ii)(I): the later day selected in that year";
    when election_return_first_day_of_taxable_year_512b19Hii_I(o, first);
    when later_day_selected_in_election_year_512b19HiiI(o, day);
    when day >= first;
    then election_period_start_512b19HiiI(o, day);
}
pub relation revocation_effective_first_day_of_return_year_512b19Hiii(o: Person, first_day: Date) kind empirical {
    label en official "section 512(b)(19)(H)(iii): the first day of the taxable year of the return in which the revocation is included";
}
pub relation revocation_later_day_selected_512b19Hiii(o: Person, day: Date) kind empirical {
    label en official "section 512(b)(19)(H)(iii): a later day in that taxable year selected by the taxpayer";
}
pub relation revocation_later_day_marker_512b19Hiii(o: Person) kind institutional {
    label en official "marker: a later revocation day was selected";
}
rule RevocationLaterDayMarker512b19Hiii(o: Person, day: Date) defeasible {
    label en official "marker";
    when revocation_later_day_selected_512b19Hiii(o, day);
    then revocation_later_day_marker_512b19Hiii(o);
}
pub relation revocation_effective_on_512b19Hiii(o: Person, on: Date) kind institutional {
    label en official "section 512(b)(19)(H)(iii): the revocation is effective as of the first day of the taxable year of the return, or a later day in that year selected by the taxpayer";
}
@source(IRC_S512_B, quote = "A revocation is effective as of the first day of the taxable year of the return in which the revocation is included or a later day in such taxable year selected by the eligible taxpayer or qualifying partnership.")
rule RevocationEffectiveFirstDay512b19Hiii(o: Person, first: Date) defeasible {
    label en official "section 512(b)(19)(H)(iii): no later day selected";
    when revocation_effective_first_day_of_return_year_512b19Hiii(o, first);
    when not_known(revocation_later_day_marker_512b19Hiii(o));
    then revocation_effective_on_512b19Hiii(o, first);
}
rule RevocationEffectiveLaterDay512b19Hiii(o: Person, first: Date, day: Date) defeasible {
    label en official "section 512(b)(19)(H)(iii): a later day selected in that year";
    when revocation_effective_first_day_of_return_year_512b19Hiii(o, first);
    when revocation_later_day_selected_512b19Hiii(o, day);
    when day >= first;
    then revocation_effective_on_512b19Hiii(o, day);
}
pub relation election_property_expenditures_512b19Hi(o: Person, asset_id: Text, amount: Money) kind empirical {
    label en official "section 512(b)(19)(H)(i): the eligible remediation expenditures for a qualifying brownfield property acquired during the election period";
}
pub relation election_property_count_512b19Hi(o: Person, count: Integer) kind empirical {
    label en official "section 512(b)(19)(H)(i): the number of qualifying brownfield properties acquired during the election period";
}
pub relation averaged_eligible_remediation_expenditure_512b19Hi(o: Person, average: Money) kind institutional {
    label en official "section 512(b)(19)(H)(i): the eligible remediation expenditures averaged over all the properties acquired during the election period (a sum over the recorded properties, one rounding, half up)";
}
@source(IRC_S512_B, quote = "by averaging the eligible remediation expenditures for all such properties acquired during the election period.")
rule AveragedEligibleRemediationExpenditure512b19Hi(o: Person, n: Integer) defeasible {
    label en official "section 512(b)(19)(H)(i): total expenditures over the number of properties";
    when multi_property_election_made_512b19Hi(o);
    when election_property_count_512b19Hi(o, n);
    when n > 0;
    then averaged_eligible_remediation_expenditure_512b19Hi(o, div_round(sum(collect all a: Money, p: Text where election_property_expenditures_512b19Hi(o, p, a), empty: 0.00 USD), n * 1.0, 2, "HALF_UP"));
}

// =====================================================================
// (I): recapture
// =====================================================================

pub relation previously_excluded_brownfield_gain_or_loss_allocable_to_taxpayer_512b19I(o: Person, asset_id: Text, amount: Money) kind empirical {
    label en official "section 512(b)(19)(I): the gain or loss previously excluded from the sale, exchange or other disposition of property to which an election under subparagraph (H) applies, allocable to the taxpayer";
}
pub relation property_fails_requirements_of_paragraph_19_in_year_512b19I(o: Person, asset_id: Text, y: TaxableYear) kind empirical {
    label en official "section 512(b)(19)(I): the property fails to satisfy the requirements of the paragraph, in the taxable year";
}
pub relation brownfield_recapture_included_in_ubti_512b19I(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 512(b)(19)(I): the unrelated business taxable income for the taxable year in which the failure occurs includes the previously excluded gain or loss (the interest at the overpayment rate under section 6621 on the resulting tax is NOT computed: it is left to the payment computation, TECH-GAPS G6000 class)";
}
@source(IRC_S512_B, quote = "the unrelated business taxable income of the eligible taxpayer for the taxable year in which such failure occurs shall be determined by including any previously excluded gain or loss from such sale, exchange, or other disposition allocable to such taxpayer")
rule BrownfieldRecaptureIncluded512b19I(o: Person, asset_id: Text, y: TaxableYear, amount: Money) defeasible {
    label en official "section 512(b)(19)(I): an elected property that fails the requirements brings its previously excluded gain or loss back into income in the year of the failure";
    when multi_property_election_made_512b19Hi(o);
    when property_fails_requirements_of_paragraph_19_in_year_512b19I(o, asset_id, y);
    when previously_excluded_brownfield_gain_or_loss_allocable_to_taxpayer_512b19I(o, asset_id, amount);
    then brownfield_recapture_included_in_ubti_512b19I(o, y, amount);
}
