// Section 508 — special rules with respect to section 501(c)(3)
// organizations: the notice requirement, the private-foundation
// presumption, and the (c) exceptions.
//
// FINDING (report this precisely): the pinned statutory text does NOT
// give "15 months" or any other exact deadline for the section 508(a)
// notice. Section 508(a)(1)-(2) delegates the manner AND the timing of
// notice entirely to Secretary regulations ("in such manner as the
// Secretary may by regulations prescribe" / "the time prescribed by the
// Secretary by regulations"); the 15-month/27-month figures live in 26
// CFR 1.508-1(a), not in section 508 itself. Per AGENT-BRIEF ("never
// invent... a missing value is MISSING_PARAMETER_VALUE, not zero") and the
// task's own instruction ("check the pinned text"), this package does NOT
// assert a 15-month deadline. The duty below is modelled with the deadline
// itself as an EXTERNAL_DEPENDENCY relation the Secretary's regulation
// supplies (`section_508a_notice_deadline`), not a literal.

use self::{
    IRC_S508_A,
    IRC_S508_B,
    IRC_S508_C,
    IRC_S509_A,
    Person,
    TaxableYear,
    is_public_charity,
    section_501c3,
};

@source(IRC_S508_A, quote = "Except as provided in subsection (c), an organization organized after October 9, 1969, shall not be treated as an organization described in section 501(c)(3)—")
pub relation organized_after_1969_10_09(o: Person) kind empirical {
    label en official "the organization was organized after October 9, 1969 (section 508(a))";
}
@source(IRC_S508_A, quote = "unless it has given notice to the Secretary in such manner as the Secretary may by regulations prescribe, that it is applying for recognition of such status, or")
pub relation section_508a_notice_given(o: Person, on: Date) kind empirical {
    label en official "the organization has given notice to the Secretary, in the manner the Secretary's regulations prescribe, that it is applying for recognition of section 501(c)(3) status (section 508(a)(1))";
}
// EXTERNAL_DEPENDENCY: 26 CFR 1.508-1(a) — the Secretary's regulations fix
// both the manner of notice (not modelled, procedural) and this deadline.
// This package supplies no value; a rule reading it awaits a real date.
pub relation section_508a_notice_deadline(o: Person, deadline: Date) kind institutional {
    label en unofficial "the time prescribed by the Secretary by regulations for giving section 508(a) notice, measured from organization (26 CFR 1.508-1(a)) — EXTERNAL_DEPENDENCY, no value asserted by this package";
}
@source(IRC_S508_A, quote = "for any period before the giving of such notice, if such notice is given after the time prescribed by the Secretary by regulations for giving notice under this subsection")
pub relation section_508a_notice_timely(o: Person) kind institutional {
    label en official "section 508(a)(2): the organization's notice was given on or before the Secretary's regulatory deadline (so no period is excluded from section 501(c)(3) treatment for lateness)";
}
@source(IRC_S508_A, quote = "for any period before the giving of such notice, if such notice is given after the time prescribed by the Secretary by regulations for giving notice under this subsection")
rule Section508aNoticeTimely(o: Person, given_on: Date, deadline: Date) defeasible {
    label en official "section 508(a)(2): notice given on or before the Secretary's regulatory deadline is timely";
    when section_508a_notice_given(o, given_on);
    when section_508a_notice_deadline(o, deadline);
    when given_on <= deadline;
    then section_508a_notice_timely(o);
}

@source(IRC_S508_A, quote = "Except as provided in subsection (c), an organization organized after October 9, 1969, shall not be treated as an organization described in section 501(c)(3)—")
pub relation section_508_notice_requirement_satisfied(o: Person) kind institutional {
    label en official "the organization satisfies the section 508(a) notice requirement (given notice, and either timely or not organized after October 9, 1969, or within a section 508(c) exception)";
}
@source(IRC_S508_A, quote = "Except as provided in subsection (c), an organization organized after October 9, 1969, shall not be treated as an organization described in section 501(c)(3)—")
rule Section508NoticeSatisfiedByGivingNotice(o: Person) defeasible {
    label en official "section 508(a): an organization organized after October 9, 1969 satisfies the notice requirement once it has given timely notice";
    when organized_after_1969_10_09(o);
    when section_508a_notice_timely(o);
    then section_508_notice_requirement_satisfied(o);
}
@source(IRC_S508_A, quote = "an organization organized after October 9, 1969, shall not be treated as an organization described in section 501(c)(3)")
rule Section508NoticeNotApplicableBefore1969(o: Person) defeasible {
    label en official "section 508(a) applies only to organizations organized after October 9, 1969; an organization organized on or before that date is not subject to its notice requirement";
    when us.irc.definitions::person(o);
    unless organized_after_1969_10_09(o);
    then section_508_notice_requirement_satisfied(o);
}
@source(IRC_S508_C, quote = "churches, their integrated auxiliaries, and conventions or associations of churches")
rule Section508NoticeChurchException(o: Person) defeasible {
    label en official "section 508(c)(1)(A): a church, its integrated auxiliary, or a convention or association of churches is exempt from the section 508(a) notice requirement";
    when church_or_integrated_auxiliary_or_convention(o);
    then section_508_notice_requirement_satisfied(o);
}
@source(IRC_S508_C, quote = "any organization which is not a private foundation (as defined in section 509(a)) and the gross receipts of which in each taxable year are normally not more than $5,000")
rule Section508NoticeSmallOrganizationException(o: Person) defeasible {
    label en official "section 508(c)(1)(B): an organization that is not a private foundation and whose gross receipts normally do not exceed $5,000 in each taxable year is exempt from the section 508(a) notice requirement";
    when not_private_foundation(o);
    when gross_receipts_normally_not_more_than_5000(o);
    then section_508_notice_requirement_satisfied(o);
}
pub relation church_or_integrated_auxiliary_or_convention(o: Person) kind empirical {
    label en official "the organization is a church, an integrated auxiliary of a church, or a convention or association of churches (section 508(c)(1)(A))";
}
pub relation gross_receipts_normally_not_more_than_5000(o: Person) kind empirical {
    label en official "the organization's gross receipts in each taxable year normally are not more than $5,000 (section 508(c)(1)(B)) — the amount is the exact statutory figure, not an indexed one";
}
pub relation not_private_foundation(o: Person) kind institutional {
    label en unofficial "the organization is not a private foundation as defined in section 509(a) — bridges to `private_foundation` in 05-private-foundation-509.law";
}
@source(IRC_S509_A, quote = "the term \"private foundation\" means a domestic or foreign organization described in section 501(c)(3) other than—")
rule NotPrivateFoundationBridge(o: Person, y: TaxableYear) defeasible {
    label en official "section 508(c)(1)(B) reads section 509(a) directly: an organization within one of the section 509(a)(1)-(4) public-charity branches is not a private foundation for purposes of this exception. Modelled off `is_public_charity` rather than the full `private_foundation` head (05-private-foundation-509.law) deliberately: `private_foundation` itself is defined FROM `section_501c3`, and `section_501c3` in turn reads the section 508 notice requirement this rule feeds — routing through `is_public_charity` (which does not depend on `section_501c3`) breaks that cycle without changing the result, since `is_public_charity` and `not private_foundation` coincide for any organization that IS section 501(c)(3)-described.";
    when is_public_charity(o, y);
    then not_private_foundation(o);
}

// Section 508(a)'s effect on the section 501(c)(3) classification: an
// organization organized after October 9, 1969 that does NOT satisfy the
// notice requirement is not TREATED as described in (c)(3), whatever the
// substantive (c)(3) test would otherwise say. Bridged into both
// classification rules in 01-exemption-classification-501.law via
// `unless section_508_notice_requirement_unsatisfied`.
pub relation section_508_notice_requirement_unsatisfied(o: Person) kind institutional {
    label en official "the organization is organized after October 9, 1969 and has not satisfied the section 508(a) notice requirement";
}
@source(IRC_S508_A, quote = "an organization organized after October 9, 1969, shall not be treated as an organization described in section 501(c)(3)")
rule Section508NoticeUnsatisfied(o: Person) defeasible {
    label en official "section 508(a): an organization organized after October 9, 1969 that has not satisfied the notice requirement is not treated as described in section 501(c)(3)";
    when organized_after_1969_10_09(o);
    unless section_508_notice_requirement_satisfied(o);
    then section_508_notice_requirement_unsatisfied(o);
}
// `unless` requires its exception atom to bind every head variable
// (including `y`), while `section_508_notice_requirement_unsatisfied(o)`
// does not name a taxable year — this bridge relation supplies the
// `y`-bound form (Lessons from the pilot: "derive a helper relation with
// an ordinary rule").
pub relation section_508_notice_requirement_unsatisfied_for_year(o: Person, y: TaxableYear) kind institutional {
    label en official "the organization has not satisfied the section 508(a) notice requirement, bound to the taxable year being tested for section 501(c)(3) classification";
}
rule Section508NoticeUnsatisfiedForYear(o: Person, y: TaxableYear) defeasible {
    label en official "bridges the year-independent section 508(a) notice failure onto the specific taxable year y";
    when section_508_notice_requirement_unsatisfied(o);
    when us.irc.core::year_of(o, y);
    then section_508_notice_requirement_unsatisfied_for_year(o, y);
}

// ---------------------------------------------------------------------
// (b): the private-foundation presumption.
// ---------------------------------------------------------------------

@source(IRC_S508_B, quote = "any organization (including an organization in existence on October 9, 1969) which is described in section 501(c)(3) and which does not notify the Secretary, at such time and in such manner as the Secretary may by regulations prescribe, that it is not a private foundation shall be presumed to be a private foundation.")
pub relation section_508b_public_charity_notice_given(o: Person) kind empirical {
    label en official "the organization has notified the Secretary, in the manner and by the time the Secretary's regulations prescribe, that it is not a private foundation (section 508(b))";
}
@source(IRC_S508_B, quote = "any organization (including an organization in existence on October 9, 1969) which is described in section 501(c)(3) and which does not notify the Secretary, at such time and in such manner as the Secretary may by regulations prescribe, that it is not a private foundation shall be presumed to be a private foundation.")
presumption PrivateFoundationPresumption(o: Person, y: TaxableYear) {
    label en official "section 508(b): a section 501(c)(3) organization that has not given the required notice that it is not a private foundation is presumed to be a private foundation";
    when section_501c3(o, y);
    presume private_foundation_presumed(o, y);
    unless section_508b_public_charity_notice_given(o) and church_or_integrated_auxiliary_or_convention(o) and us.irc.core::year_of(o, y) then not private_foundation_presumed(o, y);
    unless section_508b_public_charity_notice_given(o) and gross_receipts_normally_not_more_than_5000(o) and us.irc.core::year_of(o, y) then not private_foundation_presumed(o, y);
}
pub relation private_foundation_presumed(o: Person, y: TaxableYear) kind institutional {
    label en official "the organization is presumed to be a private foundation under section 508(b)";
}
