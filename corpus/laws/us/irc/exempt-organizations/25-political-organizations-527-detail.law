// Section 527, stage 3: everything stage 2 and 2b left case-asserted — the
// political organization definition, exempt function, exempt function income,
// (d), the (e)(5) State and local organizations, (f)(2)-(3), (g)(2), (h)(2)(B),
// the (i) notice consequences and duty, the (j) report calendar, contents and
// duty, (k) and (l). Reporting deadlines are computed with calendar arithmetic;
// the two 24- and 48-hour windows of (i)(2) and (k)(1) cannot be computed
// because Date is day-granular (TECH-GAPS G489), so the deadline is a case
// fact and the duty positions run to that asserted date.

// ---------------------------------------------------------------------
// (a), (c), (e)(1)-(2): definitions and income.
// ---------------------------------------------------------------------

use self::{
    IRC_S527_A,
    IRC_S527_C,
    IRC_S527_D,
    IRC_S527_E,
    IRC_S527_F,
    IRC_S527_G,
    IRC_S527_H,
    IRC_S527_I,
    IRC_S527_J,
    IRC_S527_K,
    IRC_S527_L,
    Person,
    Secretary,
    TaxableYear,
    newsletter_fund_treated_as_political_organization_527g,
    organization_established_on_527i,
    political_organization,
    political_organization_taxable_income,
    section_527a_treated_as_income_tax_exempt,
    section_527i5B_small_organization_exception,
    section_527i_notice_given_on,
    section_527j5D_small_organization_exception,
    section_527j_disclosure_duty,
};

pub external judgment relation OrganizedAndOperatedPrimarilyForExemptFunction527e1(o: Person, y: TaxableYear) {
    authority Secretary;
    label en official "the party, committee, association, fund or other organization is organized and operated primarily for the purpose of directly or indirectly accepting contributions or making expenditures, or both, for an exempt function (section 527(e)(1)) — DECISION-0194 evaluative channel";
}
pub relation political_organization_by_definition_527e1(o: Person, y: TaxableYear) kind institutional {
    label en official "the organization is a political organization within section 527(e)(1)";
}
@source(IRC_S527_E, quote = "The term \"political organization\" means a party, committee, association, fund, or other organization (whether or not incorporated) organized and operated primarily for the purpose of directly or indirectly accepting contributions or making expenditures, or both, for an exempt function.")
rule PoliticalOrganizationByDefinition(o: Person, y: TaxableYear) defeasible {
    label en official "section 527(e)(1): organized and operated primarily for accepting contributions or making expenditures for an exempt function";
    when OrganizedAndOperatedPrimarilyForExemptFunction527e1(o, y);
    then political_organization_by_definition_527e1(o, y);
}
@source(IRC_S527_A, quote = "A political organization shall be subject to taxation under this subtitle only to the extent provided in this section. A political organization shall be considered an organization exempt from income taxes for the purpose of any law which refers to organizations exempt from income taxes.")
rule Section527aTreatedExemptViaDefinition(o: Person, y: TaxableYear) defeasible {
    label en official "section 527(a): a political organization is treated as exempt from income taxes for the purpose of any law referring to exempt organizations — reached through the derived (e)(1) definition";
    when political_organization_by_definition_527e1(o, y);
    then section_527a_treated_as_income_tax_exempt(o, y);
}
pub enum ExemptFunctionTarget527e2 { FederalOffice, StateOffice, LocalOffice, OfficeInPoliticalOrganization, PresidentialOrVicePresidentialElectors }
pub relation activity_influences_selection_nomination_election_or_appointment_527e2(activity: Text, target: ExemptFunctionTarget527e2) kind empirical {
    label en official "the activity influences or attempts to influence the selection, nomination, election, or appointment of an individual to a Federal, State or local public office or an office in a political organization, or the election of Presidential or Vice-Presidential electors, whether or not the individual or electors are selected, nominated, elected or appointed";
}
pub relation exempt_function_derived_527e2(activity: Text) kind institutional {
    label en official "the activity is an exempt function within section 527(e)(2)";
}
@source(IRC_S527_E, quote = "The term \"exempt function\" means the function of influencing or attempting to influence the selection, nomination, election, or appointment of any individual to any Federal, State, or local public office or office in a political organization, or the election of Presidential or Vice-Presidential electors, whether or not such individual or electors are selected, nominated, elected, or appointed. Such term includes the making of expenditures relating to an office described in the preceding sentence")
rule ExemptFunctionDerived(activity: Text, target: ExemptFunctionTarget527e2) defeasible {
    label en official "section 527(e)(2): the function of influencing selection to the listed offices or electors";
    when activity_influences_selection_nomination_election_or_appointment_527e2(activity, target);
    then exempt_function_derived_527e2(activity);
}
pub enum ExemptFunctionIncomeKind527c3 { Contribution, MembershipDuesFeeOrAssessment, FundraisingOrEntertainmentProceedsOrCampaignMaterialSales, BingoProceeds }
pub relation segregated_receipt_527c3(o: Person, y: TaxableYear, kind: ExemptFunctionIncomeKind527c3, amount: Money) kind empirical {
    label en official "an amount received as a contribution of money or other property (A); membership dues, a membership fee or assessment from a member (B); proceeds from a political fundraising or entertainment event or from the sale of political campaign materials not received in the ordinary course of a trade or business (C); or proceeds from a bingo game (D) — asserted only to the extent it is segregated for use only for the exempt function of the political organization";
}
pub relation exempt_function_income_527c3(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the exempt function income of the political organization: the segregated receipts of the four listed kinds";
}
@source(IRC_S527_C, quote = "For purposes of this subsection, the term \"exempt function income\" means any amount received as—")
@source(IRC_S527_C, quote = "(A) a contribution of money or other property,")
@source(IRC_S527_C, quote = "(B) membership dues, a membership fee or assessment from a member of the political organization,")
@source(IRC_S527_C, quote = "(C) proceeds from a political fundraising or entertainment event, or proceeds from the sale of political campaign materials, which are not received in the ordinary course of any trade or business, or")
@source(IRC_S527_C, quote = "(D) proceeds from the conducting of any bingo game (as defined in section 513(f)(2)),")
@source(IRC_S527_C, quote = "to the extent such amount is segregated for use only for the exempt function of the political organization.")
rule ExemptFunctionIncomeIsSumOfSegregatedReceipts(o: Person, y: TaxableYear) defeasible {
    label en official "section 527(c)(3): the sum of the amounts received in the four kinds to the extent segregated for exempt function use";
    when political_organization(o, y);
    then exempt_function_income_527c3(o, y, sum all a: Money for k: ExemptFunctionIncomeKind527c3 where segregated_receipt_527c3(o, y, k, a));
}
pub relation total_gross_income_527c1(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the political organization's gross income for the taxable year before excluding exempt function income";
}
pub relation total_directly_connected_deductions_527c1(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the deductions allowed by this chapter directly connected with the production of the gross income (excluding exempt function income)";
}
@source(IRC_S527_C, quote = "(A) the gross income for the taxable year (excluding any exempt function income), over")
@source(IRC_S527_C, quote = "(B) the deductions allowed by this chapter which are directly connected with the production of the gross income (excluding exempt function income), computed with the modifications provided in paragraph (2).")
@source(IRC_S527_C, quote = "(B) no net operating loss deduction shall be allowed under section 172, and")
@source(IRC_S527_C, quote = "(C) no deduction shall be allowed under part VIII of subchapter B (relating to special deductions for corporations).")
// (row 527/c/2/u5 not found)
rule PoliticalOrganizationTaxableIncomeFromTotalGross(o: Person, y: TaxableYear, gross: Money, efi: Money, deductions: Money) defeasible {
    label en official "section 527(c)(1)-(2): gross income less exempt function income, less directly connected deductions, less the $100 specific deduction, not below zero; no net operating loss deduction and no part VIII special deductions are allowed";
    when political_organization(o, y);
    when total_gross_income_527c1(o, y, gross);
    when exempt_function_income_527c3(o, y, efi);
    when total_directly_connected_deductions_527c1(o, y, deductions);
    unless newsletter_fund_inputs_527g(o, y, gross, efi, deductions);
    then political_organization_taxable_income(o, y, max(0.00 USD, gross - efi - deductions - 100.00 USD));
}
pub relation newsletter_fund_treated_as_political_organization_for_year_527g(o: Person, y: TaxableYear) kind institutional {
    label en official "helper: the political organization is a newsletter fund, bound to the year";
}
rule NewsletterFundForYear(o: Person, y: TaxableYear) defeasible {
    label en official "helper";
    when newsletter_fund_treated_as_political_organization_527g(o);
    when us.irc.core::year_of(o, y);
    then newsletter_fund_treated_as_political_organization_for_year_527g(o, y);
}
pub relation newsletter_fund_inputs_527g(o: Person, y: TaxableYear, gross: Money, efi: Money, deductions: Money) kind institutional {
    label en official "helper: the income inputs of a newsletter fund (the exception atom that binds every head variable of the general computation)";
}
rule NewsletterFundInputs(o: Person, y: TaxableYear, gross: Money, efi: Money, deductions: Money) defeasible {
    label en official "helper";
    when newsletter_fund_treated_as_political_organization_for_year_527g(o, y);
    when total_gross_income_527c1(o, y, gross);
    when exempt_function_income_527c3(o, y, efi);
    when total_directly_connected_deductions_527c1(o, y, deductions);
    then newsletter_fund_inputs_527g(o, y, gross, efi, deductions);
}
@source(IRC_S527_G, quote = "In the case of any fund described in paragraph (1)—")
@source(IRC_S527_G, quote = "(B) the specific deduction provided by subsection (c)(2)(A) shall not be allowed.")
rule NewsletterFundTaxableIncomeWithoutSpecificDeduction(o: Person, y: TaxableYear, gross: Money, efi: Money, deductions: Money) defeasible {
    label en official "section 527(g)(2)(B): a newsletter fund's political organization taxable income is computed without the $100 specific deduction";
    when newsletter_fund_treated_as_political_organization_for_year_527g(o, y);
    when total_gross_income_527c1(o, y, gross);
    when exempt_function_income_527c3(o, y, efi);
    when total_directly_connected_deductions_527c1(o, y, deductions);
    then political_organization_taxable_income(o, y, max(0.00 USD, gross - efi - deductions));
}
// (d): contributions by a political organization.
pub enum RecipientKind527d { PoliticalOrganizationTreatedAsExempt, ExemptSection509a1Or2Organization, GeneralFundOfTreasuryOrOfStateOrLocalGovernment }
pub relation political_organization_contributes_or_deposits_527d(o: Person, recipient: Person, kind: RecipientKind527d, amount: Money) kind empirical {
    label en official "the political organization contributes an amount to or for the use of another political organization treated as exempt (1), an exempt organization described in section 509(a)(1) or (2) (2), or deposits the amount in the general fund of the Treasury or of a State or local government (3)";
}
pub relation amount_treated_as_not_diverted_for_personal_use_527d(o: Person, recipient: Person, amount: Money) kind institutional {
    label en official "the amount is treated as an amount not diverted for the personal use of the candidate or any other person";
}
pub relation no_deduction_for_contribution_or_deposit_527d(o: Person, recipient: Person, amount: Money) kind institutional {
    label en official "no deduction is allowed under this title for the contribution or deposit";
}
@source(IRC_S527_D, quote = "For purposes of this title, if any political organization—")
@source(IRC_S527_D, quote = "(1) contributes any amount to or for the use of any political organization which is treated as exempt from tax under subsection (a) of this section,")
@source(IRC_S527_D, quote = "(2) contributes any amount to or for the use of any organization described in paragraph (1) or (2) of section 509(a) which is exempt from tax under section 501(a), or")
@source(IRC_S527_D, quote = "(3) deposits any amount in the general fund of the Treasury or in the general fund of any State or local government,")
@source(IRC_S527_D, quote = "such amount shall be treated as an amount not diverted for the personal use of the candidate or any other person. No deduction shall be allowed under this title for the contribution or deposit of any amount described in the preceding sentence.")
rule ContributionOrDepositNotDivertedAndNotDeductible(o: Person, recipient: Person, k: RecipientKind527d, amount: Money) defeasible {
    label en official "section 527(d): the three kinds of recipient — treated as not diverted, and not deductible";
    when political_organization_contributes_or_deposits_527d(o, recipient, k, amount);
    then amount_treated_as_not_diverted_for_personal_use_527d(o, recipient, amount);
}
rule NoDeductionForContributionOrDeposit(o: Person, recipient: Person, k: RecipientKind527d, amount: Money) defeasible {
    label en official "section 527(d), last sentence";
    when political_organization_contributes_or_deposits_527d(o, recipient, k, amount);
    then no_deduction_for_contribution_or_deposit_527d(o, recipient, amount);
}
// (e)(5): qualified State or local political organizations.
pub relation exempt_functions_solely_for_state_or_local_office_527e5Ai(o: Person) kind empirical {
    label en official "all the exempt functions of the organization are solely for influencing the selection, nomination, election or appointment of an individual to a State or local public office or office in a State or local political organization";
}
pub relation state_law_requires_reports_of_each_expenditure_and_contribution_527e5AiiI(o: Person) kind empirical {
    label en official "the organization is subject to State law that requires it to report (and it so reports) information regarding each separate expenditure from and contribution to the organization";
}
pub relation state_law_requires_reports_identifying_contributors_and_recipients_527e5AiiII(o: Person) kind empirical {
    label en official "State law requires (and the organization provides) information regarding the person who makes a contribution or receives an expenditure";
}
pub relation reports_made_public_by_state_agency_527e5AiiiI(o: Person) kind empirical {
    label en official "the reports are made public by the agency with which they are filed";
}
pub relation reports_available_for_inspection_by_organization_527e5AiiiII(o: Person) kind empirical {
    label en official "the reports are made publicly available for inspection by the organization in the manner described in section 6104(d)";
}
pub relation state_minimum_reportable_contribution_527e5Bi(o: Person, amount: Money) kind empirical {
    label en official "the minimum amount of a contribution required to be reported under State law";
}
pub relation state_minimum_reportable_expenditure_527e5Bi(o: Person, amount: Money) kind empirical {
    label en official "the minimum amount of an expenditure required to be reported under State law";
}
pub relation state_minimums_within_300_of_federal_527e5Bi(o: Person) kind institutional {
    label en official "State reporting minimums are not more than $300 greater than the subsection (j) minimums ($200 for contributions, $500 for expenditures)";
}
@source(IRC_S527_E, quote = "(i) The minimum amount of any expenditure or contribution required to be reported under State law is not more than $300 greater than the minimum amount required to be reported under subsection (j).")
rule StateMinimumsWithin300OfFederal(o: Person, c_min: Money, e_min: Money) defeasible {
    label en official "section 527(e)(5)(B)(i): not more than $300 greater — a State minimum of exactly $500 for contributions and $800 for expenditures qualifies";
    when state_minimum_reportable_contribution_527e5Bi(o, c_min);
    when state_minimum_reportable_expenditure_527e5Bi(o, e_min);
    when c_min <= 500.00 USD;
    when e_min <= 800.00 USD;
    then state_minimums_within_300_of_federal_527e5Bi(o);
}
pub enum StateReportingOmission527e5Bii { EmployerOfContributor, OccupationOfContributor, EmployerOfExpenditureRecipient, OccupationOfExpenditureRecipient, PurposeOfExpenditure, DateOfContribution, DateOfExpenditure }
pub relation state_law_does_not_require_identification_of_527e5Bii(o: Person, item: StateReportingOmission527e5Bii) kind empirical {
    label en official "State law does not require the organization to identify the item";
}
pub relation state_reporting_tolerances_apply_527e5B(o: Person) kind institutional {
    label en official "the organization is not treated as failing subparagraph (A)(ii) solely by reason of the tolerances of subparagraph (B)";
}
@source(IRC_S527_E, quote = "An organization shall not be treated as failing to meet the requirements of subparagraph (A)(ii) solely by reason of 1 or more of the following:")
@source(IRC_S527_E, quote = "(ii) The State law does not require the organization to identify 1 or more of the following:")
@source(IRC_S527_E, quote = "(I) The employer of any person who makes contributions to the organization.")
@source(IRC_S527_E, quote = "(II) The occupation of any person who makes contributions to the organization.")
@source(IRC_S527_E, quote = "(III) The employer of any person who receives expenditures from the organization.")
@source(IRC_S527_E, quote = "(IV) The occupation of any person who receives expenditures from the organization.")
@source(IRC_S527_E, quote = "(V) The purpose of any expenditure of the organization.")
@source(IRC_S527_E, quote = "(VI) The date any contribution was made to the organization.")
@source(IRC_S527_E, quote = "(VII) The date of any expenditure of the organization.")
rule StateReportingToleranceForOmittedItem(o: Person, item: StateReportingOmission527e5Bii) defeasible {
    label en official "section 527(e)(5)(B)(ii): omitting any one or more of the seven items is tolerated";
    when state_law_does_not_require_identification_of_527e5Bii(o, item);
    then state_reporting_tolerances_apply_527e5B(o);
}
pub relation only_de_minimis_errors_corrected_within_reasonable_period_527e5C(o: Person) kind empirical {
    label en official "the organization makes only de minimis errors in complying with the State reporting and public inspection requirements and corrects them within a reasonable period after becoming aware of them";
}
pub relation federal_candidate_or_officeholder_controls_or_materially_participates_527e5Di(o: Person) kind empirical {
    label en official "a candidate for nomination or election to Federal elective public office, or an individual who holds such office, controls or materially participates in the direction of the organization";
}
pub relation federal_candidate_or_officeholder_solicits_contributions_527e5Dii(o: Person) kind empirical {
    label en official "such an individual solicits contributions to the organization (unless the Secretary determines the solicitations resulted in de minimis contributions and were made without the organization's prior knowledge and consent)";
}
pub relation federal_candidate_or_officeholder_directs_disbursements_527e5Diii(o: Person) kind empirical {
    label en official "such an individual directs, in whole or in part, disbursements by the organization";
}
pub relation federal_candidate_involvement_disqualifies_527e5D(o: Person) kind institutional {
    label en official "a Federal candidate's or officeholder's involvement disqualifies the organization";
}
@source(IRC_S527_E, quote = "The term \"qualified State or local political organization\" shall not include any organization otherwise described in subparagraph (A) if a candidate for nomination or election to Federal elective public office or an individual who holds such office—")
@source(IRC_S527_E, quote = "(i) controls or materially participates in the direction of the organization,")
@source(IRC_S527_E, quote = "(ii) solicits contributions to the organization (unless the Secretary determines that such solicitations resulted in de minimis contributions and were made without the prior knowledge and consent, whether explicit or implicit, of the organization or its officers, directors, agents, or employees), or")
@source(IRC_S527_E, quote = "(iii) directs, in whole or in part, disbursements by the organization.")
rule FederalCandidateControlDisqualifies(o: Person) defeasible {
    label en official "section 527(e)(5)(D)(i)";
    when federal_candidate_or_officeholder_controls_or_materially_participates_527e5Di(o);
    then federal_candidate_involvement_disqualifies_527e5D(o);
}
rule FederalCandidateSolicitationDisqualifies(o: Person) defeasible {
    label en official "section 527(e)(5)(D)(ii)";
    when federal_candidate_or_officeholder_solicits_contributions_527e5Dii(o);
    then federal_candidate_involvement_disqualifies_527e5D(o);
}
rule FederalCandidateDirectionOfDisbursementsDisqualifies(o: Person) defeasible {
    label en official "section 527(e)(5)(D)(iii)";
    when federal_candidate_or_officeholder_directs_disbursements_527e5Diii(o);
    then federal_candidate_involvement_disqualifies_527e5D(o);
}
pub relation qualified_state_or_local_political_organization_527e5(o: Person) kind institutional {
    label en official "the organization is a qualified State or local political organization";
}
@source(IRC_S527_E, quote = "The term \"qualified State or local political organization\" means a political organization—")
@source(IRC_S527_E, quote = "(i) all the exempt functions of which are solely for the purposes of influencing or attempting to influence the selection, nomination, election, or appointment of any individual to any State or local public office or office in a State or local political organization,")
@source(IRC_S527_E, quote = "(ii) which is subject to State law that requires the organization to report (and it so reports)—")
@source(IRC_S527_E, quote = "(I) information regarding each separate expenditure from and contribution to such organization, and")
@source(IRC_S527_E, quote = "(II) information regarding the person who makes such contribution or receives such expenditure,")
@source(IRC_S527_E, quote = "which would otherwise be required to be reported under this section, and")
@source(IRC_S527_E, quote = "(iii) with respect to which the reports referred to in clause (ii) are (I) made public by the agency with which such reports are filed, and (II) made publicly available for inspection by the organization in the manner described in section 6104(d).")
rule QualifiedStateOrLocalPoliticalOrganization(o: Person) defeasible {
    label en official "section 527(e)(5)(A): State or local exempt functions only, State reporting of each expenditure and contribution and of the persons involved, and public availability of the reports; not a Federal candidate's organization";
    when political_organization_for_527e5(o);
    when exempt_functions_solely_for_state_or_local_office_527e5Ai(o);
    when state_law_requires_reports_of_each_expenditure_and_contribution_527e5AiiI(o);
    when state_law_requires_reports_identifying_contributors_and_recipients_527e5AiiII(o);
    when reports_made_public_by_state_agency_527e5AiiiI(o);
    when reports_available_for_inspection_by_organization_527e5AiiiII(o);
    unless federal_candidate_involvement_disqualifies_for_org_527e5D(o);
    then qualified_state_or_local_political_organization_527e5(o);
}
pub relation political_organization_for_527e5(o: Person) kind empirical {
    label en official "the organization is a political organization";
}
pub relation federal_candidate_involvement_disqualifies_for_org_527e5D(o: Person) kind institutional {
    label en official "helper: the exception atom that binds every head variable";
}
rule FederalCandidateInvolvementForOrg(o: Person) defeasible {
    label en official "helper";
    when federal_candidate_involvement_disqualifies_527e5D(o);
    then federal_candidate_involvement_disqualifies_for_org_527e5D(o);
}
// (f)(2)-(3).
pub relation gross_income_from_interest_dividends_rents_royalties_527f2A(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the gross amount of income from interest, dividends, rents, and royalties, not taking into account items taken into account for the section 511 tax";
}
pub relation excess_of_gains_over_losses_from_sale_of_assets_527f2A(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the excess (if any) of gains from the sale or exchange of assets over the losses from the sale or exchange of assets";
}
pub relation deductions_directly_connected_with_investment_income_527f2B(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the deductions allowed by this chapter which are directly connected with the production of the income referred to in subparagraph (A)";
}
pub relation net_investment_income_527f2_derived(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "net investment income: the excess of the (A) income over the (B) deductions";
}
@source(IRC_S527_F, quote = "For purposes of this subsection, the term \"net investment income\" means the excess of—")
@source(IRC_S527_F, quote = "(A) the gross amount of income from interest, dividends, rents, and royalties, plus the excess (if any) of gains from the sale or exchange of assets over the losses from the sale or exchange of assets, over")
@source(IRC_S527_F, quote = "(B) the deductions allowed by this chapter which are directly connected with the production of the income referred to in subparagraph (A).")
@source(IRC_S527_F, quote = "For purposes of the preceding sentence, there shall not be taken into account items taken into account for purposes of the tax imposed by section 511 (relating to tax on unrelated business income).")
rule NetInvestmentIncomeIsExcessOfIncomeOverDeductions(o: Person, y: TaxableYear, income: Money, gains: Money, deductions: Money) defeasible {
    label en official "section 527(f)(2): the excess of interest, dividends, rents, royalties and net gains over the directly connected deductions — equal amounts leave no excess";
    when gross_income_from_interest_dividends_rents_royalties_527f2A(o, y, income);
    when excess_of_gains_over_losses_from_sale_of_assets_527f2A(o, y, gains);
    when deductions_directly_connected_with_investment_income_527f2B(o, y, deductions);
    when income + gains > deductions;
    then net_investment_income_527f2_derived(o, y, income + gains - deductions);
}
pub relation segregated_fund_maintained_by_exempt_organization_527f3(fund: Person, maintainer: Person) kind empirical {
    label en official "a separate segregated fund (within the meaning of section 610 of title 18, a similar State statute, or a State statute permitting segregation of dues moneys for exempt functions) maintained by a section 501(c) organization exempt under section 501(a)";
}
pub relation segregated_fund_treated_as_separate_organization_527f3(fund: Person, maintainer: Person) kind institutional {
    label en official "for section 527(f) and (e)(1) the fund is treated as a separate organization";
}
@source(IRC_S527_F, quote = "For purposes of this subsection and subsection (e)(1), a separate segregated fund (within the meaning of section 610 of title 18 or of any similar State statute, or within the meaning of any State statute which permits the segregation of dues moneys for exempt functions (within the meaning of subsection (e)(2))) which is maintained by an organization described in section 501(c) which is exempt from tax under section 501(a) shall be treated as a separate organization.")
rule SegregatedFundTreatedAsSeparateOrganization(fund: Person, maintainer: Person) defeasible {
    label en official "section 527(f)(3): a separate segregated fund is a separate organization";
    when segregated_fund_maintained_by_exempt_organization_527f3(fund, maintainer);
    then segregated_fund_treated_as_separate_organization_527f3(fund, maintainer);
}
// (h)(2)(B): the designation.
pub relation candidate_designation_in_effect_527h2B(candidate: Person, committee: Person) kind empirical {
    label en official "the candidate's designation of the committee as principal campaign committee under FECA section 302(e) and section 527(h) is in effect";
}
pub relation candidate_has_another_designation_in_effect_527h2B(candidate: Person, committee: Person) kind empirical {
    label en official "the candidate has a different designation in effect at the same time";
}
pub relation designation_revoked_with_secretary_consent_527h2Bii(candidate: Person, committee: Person) kind empirical {
    label en official "the designation was revoked with the consent of the Secretary";
}
pub relation designation_valid_527h2B(candidate: Person, committee: Person) kind institutional {
    label en official "the designation is the candidate's only designation in effect and has not been revoked without the Secretary's consent";
}
@source(IRC_S527_H, quote = "A candidate may have only 1 designation in effect under subparagraph (A)(ii) at any time and such designation—")
@source(IRC_S527_H, quote = "(i) shall be made at such time and in such manner as the Secretary may prescribe by regulations, and")
@source(IRC_S527_H, quote = "(ii) once made, may be revoked only with the consent of the Secretary.")
rule DesignationValid(candidate: Person, committee: Person) defeasible {
    label en official "section 527(h)(2)(B): only 1 designation in effect at any time, revocable only with the Secretary's consent";
    when candidate_designation_in_effect_527h2B(candidate, committee);
    unless candidate_has_another_designation_in_effect_for_pair_527h2B(candidate, committee);
    then designation_valid_527h2B(candidate, committee);
}
pub relation candidate_has_another_designation_in_effect_for_pair_527h2B(candidate: Person, committee: Person) kind institutional {
    label en official "helper: another designation is in effect (the exception atom that binds every head variable)";
}
rule CandidateHasAnotherDesignationForPair(candidate: Person, committee: Person) defeasible {
    label en official "helper";
    when candidate_has_another_designation_in_effect_527h2B(candidate, committee);
    then candidate_has_another_designation_in_effect_for_pair_527h2B(candidate, committee);
}

// ---------------------------------------------------------------------
// (i): the notice.
// ---------------------------------------------------------------------

pub relation notice_transmitted_within_24_hours_of_establishment_527i2(o: Person) kind empirical {
    label en official "the notice was transmitted not later than 24 hours after the date on which the organization was established — asserted, because Date has no hour unit (TECH-GAPS G489)";
}
pub relation material_change_occurred_on_527i2(o: Person, on: Date) kind empirical {
    label en official "the date a material change occurred in the information required by paragraph (3)";
}
pub relation notice_of_material_change_given_on_527i2(o: Person, on: Date) kind empirical {
    label en official "the date the notice of the material change was transmitted";
}
pub relation material_change_notice_timely_527i2(o: Person, changed_on: Date) kind institutional {
    label en official "the notice of the material change was transmitted not later than 30 days after the change";
}
@source(IRC_S527_I, quote = "The notice required under paragraph (1) shall be transmitted not later than 24 hours after the date on which the organization is established or, in the case of any material change in the information required under paragraph (3), not later than 30 days after such material change.")
rule MaterialChangeNoticeTimely(o: Person, changed_on: Date, notified_on: Date) defeasible {
    label en official "section 527(i)(2): not later than 30 days after the material change — the 30th day is inclusive";
    when material_change_occurred_on_527i2(o, changed_on);
    when notice_of_material_change_given_on_527i2(o, notified_on);
    when notified_on <= add_calendar_period(changed_on, 30 calendar_day);
    then material_change_notice_timely_527i2(o, changed_on);
}
pub relation period_not_treated_as_political_organization_527i1B(o: Person, start: Date, end: Date) kind institutional {
    label en official "the organization is not treated as an organization described in section 527 for the period";
}
@source(IRC_S527_I, quote = "(B) if the notice is given after the time required under paragraph (2), the organization shall not be so treated for any period before such notice is given or, in the case of any material change in the information required under paragraph (3), for the period beginning on the date on which the material change occurs and ending on the date on which such notice is given.")
rule NotTreatedForPeriodBeforeLateMaterialChangeNotice(o: Person, changed_on: Date, notified_on: Date) defeasible {
    label en official "section 527(i)(1)(B): for a late notice of a material change, no treatment from the change date until the notice is given";
    when material_change_occurred_on_527i2(o, changed_on);
    when notice_of_material_change_given_on_527i2(o, notified_on);
    when notified_on > add_calendar_period(changed_on, 30 calendar_day);
    then period_not_treated_as_political_organization_527i1B(o, changed_on, notified_on);
}
@source(IRC_S527_I, quote = "(B) if the notice is given after the time required under paragraph (2), the organization shall not be so treated for any period before such notice is given or, in the case of any material change in the information required under paragraph (3), for the period beginning on the date on which the material change occurs and ending on the date on which such notice is given.")
rule NotTreatedForPeriodBeforeLateEstablishmentNotice(o: Person, established_on: Date, notified_on: Date) defeasible {
    label en official "section 527(i)(1)(B): for a late establishment notice, no treatment before the notice is given";
    when organization_established_on_527i(o, established_on);
    when section_527i_notice_given_on(o, notified_on);
    unless notice_transmitted_within_24_hours_of_establishment_for_org_527i2(o, established_on, notified_on);
    then period_not_treated_as_political_organization_527i1B(o, established_on, notified_on);
}
pub relation notice_transmitted_within_24_hours_of_establishment_for_org_527i2(o: Person, established_on: Date, notified_on: Date) kind institutional {
    label en official "helper: the 24-hour fact bound to the established date (the exception atom that binds every head variable)";
}
rule TimelyEstablishmentNoticeForOrg(o: Person, established_on: Date, notified_on: Date) defeasible {
    label en official "helper";
    when organization_established_on_527i(o, established_on);
    when section_527i_notice_given_on(o, notified_on);
    when notice_transmitted_within_24_hours_of_establishment_527i2(o);
    then notice_transmitted_within_24_hours_of_establishment_for_org_527i2(o, established_on, notified_on);
}
pub relation exempt_function_income_taxed_for_period_527i4(o: Person, start: Date, end: Date) kind institutional {
    label en official "for the period of failure the organization's taxable income is computed by taking into account its exempt function income (and the directly connected deductions)";
}
@source(IRC_S527_I, quote = "In the case of an organization failing to meet the requirements of paragraph (1) for any period, the taxable income of such organization shall be computed by taking into account any exempt function income (and any deductions directly connected with the production of such income) or, in the case of a failure relating to a material change, by taking into account such income and deductions only during the period beginning on the date on which the material change occurs and ending on the date on whi")
rule ExemptFunctionIncomeTaxedForPeriodOfFailure(o: Person, start: Date, end: Date) defeasible {
    label en official "section 527(i)(4): a failure to give the notice puts the exempt function income into taxable income for the period";
    when period_not_treated_as_political_organization_527i1B(o, start, end);
    then exempt_function_income_taxed_for_period_527i4(o, start, end);
}
pub enum NoticeContent527i3 { NameAndAddressAndEmail, PurposeOfOrganization, OfficersEmployeesContactCustodianDirectors, RelatedEntities, IntentToClaimExemptionFromJAndSection6033 }
pub relation notice_contains_527i3(o: Person, item: NoticeContent527i3) kind empirical {
    label en official "the notice includes: the name and address (including business address if different) and electronic mailing address (A); the purpose (B); the names and addresses of officers, highly compensated employees, contact person, custodian of records and directors (C); the name, address and relationship of related entities within section 168(h)(4) (D); whether the organization intends to claim an exemption from subsection (j) or section 6033 (E)";
}
pub relation notice_complete_527i3(o: Person) kind institutional {
    label en official "the section 527(i) notice includes the five items (A)-(E); item (F) (other information the Secretary requires) is set by the Secretary";
}
@source(IRC_S527_I, quote = "The notice required under paragraph (1) shall include information regarding—")
@source(IRC_S527_I, quote = "(A) the name and address of the organization (including any business address, if different) and its electronic mailing address,")
@source(IRC_S527_I, quote = "(B) the purpose of the organization,")
@source(IRC_S527_I, quote = "(C) the names and addresses of its officers, highly compensated employees, contact person, custodian of records, and members of its Board of Directors,")
@source(IRC_S527_I, quote = "(D) the name and address of, and relationship to, any related entities (within the meaning of section 168(h)(4)),")
@source(IRC_S527_I, quote = "(E) whether the organization intends to claim an exemption from the requirements of subsection (j) or section 6033, and")
@source(IRC_S527_I, quote = "(F) such other information as the Secretary may require to carry out the internal revenue laws.")
rule NoticeComplete(o: Person) defeasible {
    label en official "section 527(i)(3)(A)-(E)";
    when notice_contains_527i3(o, NoticeContent527i3.NameAndAddressAndEmail);
    when notice_contains_527i3(o, NoticeContent527i3.PurposeOfOrganization);
    when notice_contains_527i3(o, NoticeContent527i3.OfficersEmployeesContactCustodianDirectors);
    when notice_contains_527i3(o, NoticeContent527i3.RelatedEntities);
    when notice_contains_527i3(o, NoticeContent527i3.IntentToClaimExemptionFromJAndSection6033);
    then notice_complete_527i3(o);
}
pub relation organization_applies_solely_by_reason_of_527f1_527i5A(o: Person, y: TaxableYear) kind empirical {
    label en official "section 527 applies to the organization solely by reason of subsection (f)(1)";
}
pub relation political_committee_of_state_or_local_candidate_or_party_527i5C(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization is a political committee of a State or local candidate or a State or local committee of a political party";
}
pub relation person_required_to_report_under_feca_as_political_committee_527i6(o: Person, y: TaxableYear) kind empirical {
    label en official "the person is required (without regard to this subsection) to report under the Federal Election Campaign Act of 1971 as a political committee";
}
pub relation section_527i_does_not_apply_527i5_6(o: Person, y: TaxableYear) kind institutional {
    label en official "subsection (i) does not apply to the organization";
}
@source(IRC_S527_I, quote = "This subsection shall not apply to any organization—")
@source(IRC_S527_I, quote = "(A) to which this section applies solely by reason of subsection (f)(1),")
rule Section527iNotApplicableViaF1(o: Person, y: TaxableYear) defeasible {
    label en official "section 527(i)(5)(A)";
    when organization_applies_solely_by_reason_of_527f1_527i5A(o, y);
    then section_527i_does_not_apply_527i5_6(o, y);
}
rule Section527iNotApplicableViaSmallOrganization(o: Person, y: TaxableYear) defeasible {
    label en official "section 527(i)(5)(B): the $25,000 exception";
    when section_527i5B_small_organization_exception(o, y);
    then section_527i_does_not_apply_527i5_6(o, y);
}
@source(IRC_S527_I, quote = "(C) which is a political committee of a State or local candidate or which is a State or local committee of a political party.")
rule Section527iNotApplicableViaStateOrLocalCommittee(o: Person, y: TaxableYear) defeasible {
    label en official "section 527(i)(5)(C)";
    when political_committee_of_state_or_local_candidate_or_party_527i5C(o, y);
    then section_527i_does_not_apply_527i5_6(o, y);
}
@source(IRC_S527_I, quote = "This subsection shall not apply to any person required (without regard to this subsection) to report under the Federal Election Campaign Act of 1971 (52 U.S.C. 30101 et seq.) as a political committee.")
rule Section527iNotApplicableViaFecaReporting(o: Person, y: TaxableYear) defeasible {
    label en official "section 527(i)(6)";
    when person_required_to_report_under_feca_as_political_committee_527i6(o, y);
    then section_527i_does_not_apply_527i5_6(o, y);
}
pub relation notice_deadline_527i2(o: Person, deadline: Date) kind institutional {
    label en official "section 527(i)(2): the date on which the notice window closes, computed from the establishment date. JUDGMENT CALL (stage 3, replaces the asserted deadline of G489): the statute says 24 hours after THE DATE on which the organization is established; on a day-granularity Date the window closes one calendar day after that date (no hour of the day is modelled)";
}
@source(IRC_S527_I, quote = "The notice required under paragraph (1) shall be transmitted not later than 24 hours after the date on which the organization is established")
rule NoticeDeadline527i2FromEstablishment(o: Person, established_on: Date) strict {
    label en official "section 527(i)(2): 24 hours after the date of establishment, read at day granularity as the next calendar day";
    when organization_established_on_527i(o, established_on);
    then notice_deadline_527i2(o, add_calendar_period(established_on, 1 calendar_day));
}
pub relation section_527i_notice_transmitted_timely_527i2(o: Person, transmitted_on: Date) kind institutional {
    label en official "the notice was transmitted on or before the asserted deadline";
}
rule NoticeTransmittedTimely(o: Person, on: Date, deadline: Date) defeasible {
    label en official "section 527(i)(2): transmission on or before the deadline";
    when section_527i_notice_given_on(o, on);
    when notice_deadline_527i2(o, deadline);
    when on <= deadline;
    then section_527i_notice_transmitted_timely_527i2(o, on);
}
@source(IRC_S527_I, quote = "(A) unless it has given notice to the Secretary electronically that it is to be so treated, or")
rule TransmitSection527iNoticeDutyRule(o: Person, y: TaxableYear, established_on: Date, deadline: Date) strict {
    label en official "section 527(i)(1)-(2): a political organization to which subsection (i) applies is under a duty to transmit the notice by the deadline (24 hours after establishment; 30 days after a material change)";
    when section_527i_applies_527i(o, y);
    when organization_established_on_527i(o, established_on);
    when notice_deadline_527i2(o, deadline);
    then duty TransmitSection527iNotice {
        bearer o;
        goal achievement {
            condition section_527i_notice_transmitted_timely_527i2(o, established_on);
            window [established_on, deadline];
        }
    };
}
pub relation section_527i_applies_527i(o: Person, y: TaxableYear) kind institutional {
    label en official "subsection (i) applies to the political organization: no (5) or (6) exception";
}
rule Section527iApplies(o: Person, y: TaxableYear) defeasible {
    label en official "section 527(i)(5)-(6): a political organization outside every exception";
    when political_organization(o, y);
    unless section_527i_does_not_apply_527i5_6(o, y);
    then section_527i_applies_527i(o, y);
}

// ---------------------------------------------------------------------
// (j): the report calendar, contents and duty.
// ---------------------------------------------------------------------

pub enum ReportKind527j2 { QuarterEndingMarchJuneOrSeptember, QuarterEndingDecember31, SemiannualJanuaryToJune, SemiannualJulyToDecember, Monthly }
pub relation report_period_527j2(o: Person, period: Text, kind: ReportKind527j2, period_end: Date) kind empirical {
    label en official "a reporting period of the organization: the quarter (A)(i)(I) — the December quarter is reported by January 31 — the half-year (A)(ii), or the month (B); with its last day";
}
pub relation report_due_date_527j2(o: Person, period: Text, due: Date) kind institutional {
    label en official "the date the report for the period is due";
}
@source(IRC_S527_J, quote = "(I) quarterly reports, beginning with the first quarter of the calendar year in which a contribution is accepted or expenditure is made, which shall be filed not later than the fifteenth day after the last day of each calendar quarter, except that the report for the quarter ending on December 31 of such calendar year shall be filed not later than January 31 of the following calendar year,")
rule QuarterlyReportDueFifteenDaysAfterQuarter(o: Person, period: Text, end: Date) defeasible {
    label en official "section 527(j)(2)(A)(i)(I): not later than the fifteenth day after the last day of a calendar quarter";
    when report_period_527j2(o, period, ReportKind527j2.QuarterEndingMarchJuneOrSeptember, end);
    then report_due_date_527j2(o, period, add_calendar_period(end, 15 calendar_day));
}
@source(IRC_S527_J, quote = "(I) quarterly reports, beginning with the first quarter of the calendar year in which a contribution is accepted or expenditure is made, which shall be filed not later than the fifteenth day after the last day of each calendar quarter, except that the report for the quarter ending on December 31 of such calendar year shall be filed not later than January 31 of the following calendar year,")
rule DecemberQuarterReportDueJanuary31(o: Person, period: Text, end: Date) defeasible {
    label en official "section 527(j)(2)(A)(i)(I): the report for the quarter ending December 31 is due January 31 of the following year";
    when report_period_527j2(o, period, ReportKind527j2.QuarterEndingDecember31, end);
    then report_due_date_527j2(o, period, add_calendar_period(end, 1 calendar_month));
}
@source(IRC_S527_J, quote = "(ii) in the case of any other calendar year, a report covering the period beginning January 1 and ending June 30, which shall be filed no later than July 31 and a report covering the period beginning July 1 and ending December 31, which shall be filed no later than January 31 of the following calendar year, or")
rule SemiannualJanuaryToJuneReportDueJuly31(o: Person, period: Text, end: Date) defeasible {
    label en official "section 527(j)(2)(A)(ii): the January 1-June 30 report is due July 31";
    when report_period_527j2(o, period, ReportKind527j2.SemiannualJanuaryToJune, end);
    then report_due_date_527j2(o, period, add_calendar_period(end, 1 calendar_month));
}
@source(IRC_S527_J, quote = "(ii) in the case of any other calendar year, a report covering the period beginning January 1 and ending June 30, which shall be filed no later than July 31 and a report covering the period beginning July 1 and ending December 31, which shall be filed no later than January 31 of the following calendar year, or")
rule SemiannualJulyToDecemberReportDueJanuary31(o: Person, period: Text, end: Date) defeasible {
    label en official "section 527(j)(2)(A)(ii): the July 1-December 31 report is due January 31 of the following year";
    when report_period_527j2(o, period, ReportKind527j2.SemiannualJulyToDecember, end);
    then report_due_date_527j2(o, period, add_calendar_period(end, 1 calendar_month));
}
@source(IRC_S527_J, quote = "(B) monthly reports for the calendar year, beginning with the first month of the calendar year in which a contribution is accepted or expenditure is made, which shall be filed not later than the twentieth day after the last day of the month and shall be complete as if the last day of the month, except that, in lieu of filing the reports otherwise due in November and December of any year in which a regularly scheduled general election is held, a pre-general election report shall be filed in accor")
rule MonthlyReportDueTwentiethDay(o: Person, period: Text, end: Date) defeasible {
    label en official "section 527(j)(2)(B): not later than the twentieth day after the last day of the month";
    when report_period_527j2(o, period, ReportKind527j2.Monthly, end);
    then report_due_date_527j2(o, period, add_calendar_period(end, 20 calendar_day));
}
pub relation election_date_527j2(o: Person, election: Text, on: Date, general: Boolean) kind empirical {
    label en official "an election with respect to which the organization makes a contribution or expenditure, with its date and whether it is the general election (section 527(j)(6): a general, special, primary or runoff election for Federal office, a party convention or caucus with nominating authority, a delegate-selection primary, or a presidential preference primary)";
}
pub relation pre_election_report_due_527j2AiII(o: Person, election: Text, filed_by: Date, mailed_by: Date, complete_as_of: Date) kind institutional {
    label en official "the pre-election report is due 12 days before the election (or posted by registered or certified mail 15 days before) and is complete as of the twentieth day before the election";
}
@source(IRC_S527_J, quote = "(II) a pre-election report, which shall be filed not later than the twelfth day before (or posted by registered or certified mail not later than the fifteenth day before) any election with respect to which the organization makes a contribution or expenditure, and which shall be complete as of the twentieth day before the election, and")
rule PreElectionReportDates(o: Person, election: Text, on: Date, is_general: Boolean, calendar_before_1: Date, calendar_before_2: Date, calendar_before_3: Date) defeasible {
    label en official "section 527(j)(2)(A)(i)(II): filed not later than the twelfth day before the election, mailed not later than the fifteenth day before it, complete as of the twentieth day before it";
    when election_date_527j2(o, election, on, is_general)
        and us.irc.core::civil_calendar_boundary_before(on, 20, us.irc.core::CalendarDay, calendar_before_1)
        and us.irc.core::civil_calendar_boundary_before(on, 15, us.irc.core::CalendarDay, calendar_before_2)
        and us.irc.core::civil_calendar_boundary_before(on, 12, us.irc.core::CalendarDay, calendar_before_3);
    then pre_election_report_due_527j2AiII(o, election, calendar_before_3, calendar_before_2, calendar_before_1);
}
pub relation post_general_election_report_dates_527j2AiIII(o: Person, election: Text, filed_by: Date, complete_as_of: Date) kind institutional {
    label en official "the post-general election report is due 30 days after the general election and is complete as of the twentieth day after it";
}
@source(IRC_S527_J, quote = "(III) a post-general election report, which shall be filed not later than the thirtieth day after the general election and which shall be complete as of the twentieth day after such general election, and")
rule PostGeneralElectionReportDates(o: Person, election: Text, on: Date) defeasible {
    label en official "section 527(j)(2)(A)(i)(III)";
    when election_date_527j2(o, election, on, true);
    then post_general_election_report_dates_527j2AiIII(o, election, add_calendar_period(on, 30 calendar_day), add_calendar_period(on, 20 calendar_day));
}
pub relation report_filed_on_527j2(o: Person, period: Text, filed_on: Date) kind empirical {
    label en official "the date the report for the period was filed (in electronic form, section 527(j)(7))";
}
pub relation report_filed_by_due_date_527j2(o: Person, period: Text) kind institutional {
    label en official "the report was filed on or before its due date";
}
@source(IRC_S527_J, quote = "(A)(i) in the case of a calendar year in which a regularly scheduled election is held—")
rule ReportFiledByDueDate(o: Person, period: Text, due: Date, filed: Date) defeasible {
    label en official "section 527(j)(2): a report filed on the due date is timely";
    when report_due_date_527j2(o, period, due);
    when report_filed_on_527j2(o, period, filed);
    when filed <= due;
    then report_filed_by_due_date_527j2(o, period);
}
@source(IRC_S527_J, quote = "A political organization which accepts a contribution, or makes an expenditure, for an exempt function during any calendar year shall file with the Secretary either—")
rule FileSection527jReportDutyRule(o: Person, y: TaxableYear, period: Text, end: Date, due: Date) strict {
    label en official "section 527(j)(2): a political organization that accepted a contribution or made an expenditure for an exempt function during the calendar year shall file the report for each reporting period by its due date";
    when section_527j_applies_527j(o, y);
    when report_period_527j2(o, period, _, end);
    when report_due_date_527j2(o, period, due);
    then duty FileSection527jReport {
        bearer o;
        goal achievement {
            condition report_filed_by_due_date_527j2(o, period);
            window [end, due];
        }
    };
}
pub relation exemption_from_527j_527j5(o: Person, y: TaxableYear) kind institutional {
    label en official "subsection (j) does not apply to the organization";
}
pub relation required_to_report_under_feca_527j5A(o: Person, y: TaxableYear) kind empirical {
    label en official "the person is required (without regard to this subsection) to report under the Federal Election Campaign Act as a political committee";
}
pub relation state_or_local_party_committee_or_candidate_committee_527j5B(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization is a State or local committee of a political party or a political committee of a State or local candidate";
}
pub relation applies_solely_by_reason_of_527f1_527j5E(o: Person, y: TaxableYear) kind empirical {
    label en official "section 527 applies to the organization solely by reason of subsection (f)(1)";
}
pub relation expenditure_is_independent_expenditure_527j5F(o: Person, y: TaxableYear) kind empirical {
    label en official "the expenditure is an independent expenditure (as defined in section 301 of the Federal Election Campaign Act)";
}
@source(IRC_S527_J, quote = "This subsection shall not apply—")
@source(IRC_S527_J, quote = "(A) to any person required (without regard to this subsection) to report under the Federal Election Campaign Act of 1971 (52 U.S.C. 30101 et seq.) as a political committee,")
rule ExemptionFromJViaFecaReporting(o: Person, y: TaxableYear) defeasible {
    label en official "section 527(j)(5)(A)";
    when required_to_report_under_feca_527j5A(o, y);
    then exemption_from_527j_527j5(o, y);
}
@source(IRC_S527_J, quote = "(B) to any State or local committee of a political party or political committee of a State or local candidate,")
rule ExemptionFromJViaStateOrLocalCommittee(o: Person, y: TaxableYear) defeasible {
    label en official "section 527(j)(5)(B)";
    when state_or_local_party_committee_or_candidate_committee_527j5B(o, y);
    then exemption_from_527j_527j5(o, y);
}
@source(IRC_S527_J, quote = "(C) to any organization which is a qualified State or local political organization,")
rule ExemptionFromJViaQualifiedStateOrLocalOrganization(o: Person, y: TaxableYear) defeasible {
    label en official "section 527(j)(5)(C)";
    when qualified_state_or_local_political_organization_527e5(o);
    when us.irc.core::year_of(o, y);
    then exemption_from_527j_527j5(o, y);
}
rule ExemptionFromJViaSmallOrganization(o: Person, y: TaxableYear) defeasible {
    label en official "section 527(j)(5)(D)";
    when section_527j5D_small_organization_exception(o, y);
    then exemption_from_527j_527j5(o, y);
}
@source(IRC_S527_J, quote = "(E) to any organization to which this section applies solely by reason of subsection (f)(1), or")
rule ExemptionFromJViaF1Only(o: Person, y: TaxableYear) defeasible {
    label en official "section 527(j)(5)(E)";
    when applies_solely_by_reason_of_527f1_527j5E(o, y);
    then exemption_from_527j_527j5(o, y);
}
pub relation section_527j_applies_527j(o: Person, y: TaxableYear) kind institutional {
    label en official "subsection (j) applies: the organization accepted a contribution or made an expenditure for an exempt function and no (5) exception applies";
}
rule Section527jApplies(o: Person, y: TaxableYear) defeasible {
    label en official "section 527(j)(2), (5): a disclosure-duty organization outside every exception";
    when section_527j_disclosure_duty(o, y);
    unless exemption_from_527j_527j5(o, y);
    then section_527j_applies_527j(o, y);
}
pub relation aggregate_expenditures_to_person_in_calendar_year_527j3A(o: Person, payee: Person, calendar_year: Integer, amount: Money) kind empirical {
    label en official "the aggregate amount of expenditures to the person during the calendar year";
}
pub relation expenditure_reportable_527j3A(o: Person, payee: Person, calendar_year: Integer) kind institutional {
    label en official "the amount, date and purpose of the expenditures to the person, and its name and address, must be reported";
}
@source(IRC_S527_J, quote = "(A) The amount, date, and purpose of each expenditure made to a person if the aggregate amount of expenditures to such person during the calendar year equals or exceeds $500 and the name and address of the person (in the case of an individual, including the occupation and name of employer of such individual).")
rule ExpenditureReportableAtFiveHundred(o: Person, payee: Person, calendar_year: Integer, amount: Money) defeasible {
    label en official "section 527(j)(3)(A): aggregate expenditures to a person that equal or exceed $500";
    when aggregate_expenditures_to_person_in_calendar_year_527j3A(o, payee, calendar_year, amount);
    when amount >= 500.00 USD;
    then expenditure_reportable_527j3A(o, payee, calendar_year);
}
pub relation aggregate_contributions_from_contributor_in_calendar_year_527j3B(o: Person, contributor: Person, calendar_year: Integer, amount: Money) kind empirical {
    label en official "the aggregate amount contributed by the contributor to the organization during the calendar year";
}
pub relation contributor_reportable_527j3B(o: Person, contributor: Person, calendar_year: Integer) kind institutional {
    label en official "the contributor's name and address (with occupation and employer for an individual) and the amount and date of the contribution must be reported";
}
@source(IRC_S527_J, quote = "(B) The name and address (in the case of an individual, including the occupation and name of employer of such individual) of all contributors which contributed an aggregate amount of $200 or more to the organization during the calendar year and the amount and date of the contribution.")
rule ContributorReportableAtTwoHundred(o: Person, contributor: Person, calendar_year: Integer, amount: Money) defeasible {
    label en official "section 527(j)(3)(B): contributors that contributed an aggregate of $200 or more";
    when aggregate_contributions_from_contributor_in_calendar_year_527j3B(o, contributor, calendar_year, amount);
    when amount >= 200.00 USD;
    then contributor_reportable_527j3B(o, contributor, calendar_year);
}
pub relation contracted_or_obligated_to_make_expenditure_or_contribution_527j4(person: Person, o: Person) kind empirical {
    label en official "the person has contracted or is otherwise obligated to make the expenditure or contribution";
}
pub relation treated_as_having_made_expenditure_or_contribution_527j4(person: Person, o: Person) kind institutional {
    label en official "the person is treated as having made the expenditure or contribution";
}
@source(IRC_S527_J, quote = "For purposes of this subsection, a person shall be treated as having made an expenditure or contribution if the person has contracted or is otherwise obligated to make the expenditure or contribution.")
rule TreatedAsHavingMadeWhenObligated(person: Person, o: Person) defeasible {
    label en official "section 527(j)(4): a person contractually obligated to make an expenditure or contribution is treated as having made it";
    when contracted_or_obligated_to_make_expenditure_or_contribution_527j4(person, o);
    then treated_as_having_made_expenditure_or_contribution_527j4(person, o);
}
pub relation report_filed_in_electronic_form_527j7(o: Person, calendar_year: Integer) kind empirical {
    label en official "the report for the calendar year was filed in electronic form";
}
pub relation report_meets_electronic_filing_requirement_527j7(o: Person, calendar_year: Integer) kind institutional {
    label en official "the report satisfies the electronic filing requirement";
}
@source(IRC_S527_J, quote = "Any report required under paragraph (2) with respect to any calendar year shall be filed in electronic form.")
rule ReportMeetsElectronicFilingRequirement(o: Person, calendar_year: Integer) defeasible {
    label en official "section 527(j)(7): reports are filed in electronic form";
    when report_filed_in_electronic_form_527j7(o, calendar_year);
    then report_meets_electronic_filing_requirement_527j7(o, calendar_year);
}

// ---------------------------------------------------------------------
// (k), (l).
// ---------------------------------------------------------------------

pub relation notice_or_report_filed_on_527k1(o: Person, filed_on: Date) kind empirical {
    label en official "the date a notice described in subsection (i)(1) or a report described in subsection (j)(7) was filed";
}
pub relation internet_publication_deadline_527k1(o: Person, deadline: Date) kind institutional {
    label en official "section 527(k)(1): the date the 48-hour window after filing closes, computed from the filing date. JUDGMENT CALL (stage 3, replaces the asserted deadline of G489): on a day-granularity Date 48 hours after the filing is two calendar days after the filing date (no hour of the day is modelled)";
}
@source(IRC_S527_K, quote = "not later than 48 hours after such notice or report has been filed")
rule InternetPublicationDeadline527k1FromFiling(o: Person, filed_on: Date) strict {
    label en official "section 527(k)(1): 48 hours after the filing, read at day granularity as two calendar days";
    when notice_or_report_filed_on_527k1(o, filed_on);
    then internet_publication_deadline_527k1(o, add_calendar_period(filed_on, 2 calendar_day));
}
pub relation notice_or_report_available_on_internet_by_527k1(o: Person, available_on: Date) kind empirical {
    label en official "the date the notice or report was made available for public inspection on the Internet";
}
pub relation internet_availability_timely_527k1(o: Person) kind institutional {
    label en official "the notice or report was made publicly available on the Internet within the window";
}
rule InternetAvailabilityTimely(o: Person, on: Date, deadline: Date) defeasible {
    label en official "section 527(k)(1): availability on or before the asserted 48-hour deadline";
    when notice_or_report_available_on_internet_by_527k1(o, on);
    when internet_publication_deadline_527k1(o, deadline);
    when on <= deadline;
    then internet_availability_timely_527k1(o);
}
@source(IRC_S527_K, quote = "The Secretary shall make any notice described in subsection (i)(1) or report described in subsection (j)(7) available for public inspection on the Internet not later than 48 hours after such notice or report has been filed (in addition to such public availability as may be made under section 6104(d)(7)).")
rule PublishNoticeOrReportDutyRule(o: Person, filed_on: Date, deadline: Date) strict {
    label en official "section 527(k)(1): the Secretary shall make a filed notice or report available for public inspection on the Internet not later than 48 hours after it has been filed";
    when notice_or_report_filed_on_527k1(o, filed_on);
    when internet_publication_deadline_527k1(o, deadline);
    then duty PublishSection527NoticeOrReportOnInternet {
        bearer Secretary;
        beneficiary o;
        goal achievement {
            condition internet_availability_timely_527k1(o);
            window [filed_on, deadline];
        }
    };
}
pub enum DatabaseSearchItem527k2 { OrganizationNamesStatesZipCodesCustodiansDirectorsPurposes, RelatedEntities, Contributors, EmployersOfContributors, RecipientsOfExpenditures, RangesOfContributionsAndExpenditures, TimePeriodsOfNoticesAndReports }
pub relation database_searchable_by_527k2(item: DatabaseSearchItem527k2) kind empirical {
    label en official "the database of notices and reports is searchable by the item (to the extent the items are required to be included)";
}
pub relation database_downloadable_527k2() kind empirical {
    label en official "the database is downloadable";
}
pub relation database_meets_527k2() kind institutional {
    label en official "the database is searchable by all seven items (A)-(G) and downloadable";
}
@source(IRC_S527_K, quote = "The Secretary shall make the entire database of notices and reports which are made available to the public under paragraph (1) searchable by the following items (to the extent the items are required to be included in the notices and reports):")
@source(IRC_S527_K, quote = "(A) Names, States, zip codes, custodians of records, directors, and general purposes of the organizations.")
@source(IRC_S527_K, quote = "(B) Entities related to the organizations.")
@source(IRC_S527_K, quote = "(C) Contributors to the organizations.")
@source(IRC_S527_K, quote = "(D) Employers of such contributors.")
@source(IRC_S527_K, quote = "(E) Recipients of expenditures by the organizations.")
@source(IRC_S527_K, quote = "(F) Ranges of contributions and expenditures.")
@source(IRC_S527_K, quote = "(G) Time periods of the notices and reports.")
@source(IRC_S527_K, quote = "Such database shall be downloadable.")
rule DatabaseMeets527k2() defeasible {
    label en official "section 527(k)(2): searchable by each of the seven items and downloadable";
    when database_searchable_by_527k2(DatabaseSearchItem527k2.OrganizationNamesStatesZipCodesCustodiansDirectorsPurposes);
    when database_searchable_by_527k2(DatabaseSearchItem527k2.RelatedEntities);
    when database_searchable_by_527k2(DatabaseSearchItem527k2.Contributors);
    when database_searchable_by_527k2(DatabaseSearchItem527k2.EmployersOfContributors);
    when database_searchable_by_527k2(DatabaseSearchItem527k2.RecipientsOfExpenditures);
    when database_searchable_by_527k2(DatabaseSearchItem527k2.RangesOfContributionsAndExpenditures);
    when database_searchable_by_527k2(DatabaseSearchItem527k2.TimePeriodsOfNoticesAndReports);
    when database_downloadable_527k2();
    then database_meets_527k2();
}
pub relation section_527_notice_or_report_database_exists() kind empirical {
    label en official "the Secretary has made the notices and reports available to the public under paragraph (1)";
}
@source(IRC_S527_K, quote = "The Secretary shall make the entire database of notices and reports which are made available to the public under paragraph (1) searchable by the following items (to the extent the items are required to be included in the notices and reports):")
rule MaintainSearchableDatabaseDutyRule() strict {
    label en official "section 527(k)(2): the Secretary shall make the entire database of notices and reports searchable by the listed items and downloadable";
    when section_527_notice_or_report_database_exists();
    then duty MaintainSearchableDownloadableSection527Database {
        bearer Secretary;
        goal maintenance {
            condition database_meets_527k2();
            window [-infinity, infinity];
            completeness_policy DatabaseCompletenessPolicy527k2;
        }
    };
}
pub external judgment relation FailureDueToReasonableCauseAndNotWillfulNeglect527l(o: Person, y: TaxableYear) {
    authority Secretary;
    label en official "the organization's failure to comply with subsection (i) or (j) was due to reasonable cause and not due to willful neglect (section 527(l)) — DECISION-0194 evaluative channel";
}
pub relation showing_of_reasonable_cause_made_527l(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization has made a showing of reasonable cause and not willful neglect";
}
pub relation section_527l_waiver_granted(o: Person, y: TaxableYear) kind empirical {
    label en official "the Secretary waived all or a portion of the section 527(i) tax or the section 527(j) amount";
}
pub relation section_527l_waiver_in_effect(o: Person, y: TaxableYear) kind institutional {
    label en official "the tax assessed for a subsection (i) failure or the amount imposed under subsection (j) is waived, in whole or in part";
}
@source(IRC_S527_L, quote = "The Secretary may waive all or any portion of the—")
@source(IRC_S527_L, quote = "(1) tax assessed on an organization by reason of the failure of the organization to comply with the requirements of subsection (i), or")
@source(IRC_S527_L, quote = "(2) amount imposed under subsection (j) for a failure to comply with the requirements thereof,")
@source(IRC_S527_L, quote = "on a showing that such failure was due to reasonable cause and not due to willful neglect.")
rule Section527lWaiverPowerRule(o: Person, y: TaxableYear) strict {
    label en official "section 527(l): the Secretary may waive all or any portion of the subsection (i) tax or the subsection (j) amount on a showing that the failure was due to reasonable cause and not willful neglect";
    when showing_of_reasonable_cause_made_527l(o, y);
    then power WaiveSection527iOrJAmount {
        holder Secretary;
        exercise section_527l_waiver_granted(o, y);
        valid_when FailureDueToReasonableCauseAndNotWillfulNeglect527l(o, y);
        effect section_527l_waiver_in_effect(o, y);
    };
}
