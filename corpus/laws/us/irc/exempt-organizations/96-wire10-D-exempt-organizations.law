// Exempt organizations -- WIRE-10 group D (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// Section 507(c) imposes the termination tax "on each organization which is referred to in subsection (a)". The amount is computed by the
// module 08 (`termination_tax_507`, keyed by the organization only); the consumers need the fact that the tax is imposed on the
// organization for the year of the section 507(a) event (section 6501(c)(6): the tax may be assessed at any time). This module states that
// imposition, keyed by the organization and the taxable year of the event.

language "law.core" version "0.2";
package us.irc.exempt_organizations version "0.1.1";
namespace "urn:us:irc:exempt_organizations:clir";

use self::{
    IRC_S507_C,
    Person,
    TaxableYear,
    section_507a_voluntary_termination_notice_given,
    section_507a_willful_repeated_or_flagrant_act_established,
};

pub relation section_507c_tax_imposed(o: Person, y: TaxableYear) kind institutional {
    label en official "a tax is imposed by section 507(c) on the organization, which is referred to in section 507(a), for the taxable year of the event";
}

@source(IRC_S507_C, relation = formalizes, coverage = partial, quote = "There is hereby imposed on each organization which is referred to in subsection (a) a tax equal to the lower of—")
rule W10DSection507cTaxImposedAfterVoluntaryNotice strict {
    label en official "section 507(c): the tax is imposed on an organization that notified the Secretary of its intent to terminate (section 507(a)(1))";
    for o: Person;
    for y: TaxableYear;
    when section_507a_voluntary_termination_notice_given(o, y);
    then section_507c_tax_imposed(o, y);
}

@source(IRC_S507_C, relation = formalizes, coverage = partial, quote = "There is hereby imposed on each organization which is referred to in subsection (a) a tax equal to the lower of—")
rule W10DSection507cTaxImposedAfterWillfulActs strict {
    label en official "section 507(c): the tax is imposed on an organization referred to in section 507(a)(2), after willful repeated or flagrant acts and the Secretary's notice";
    for o: Person;
    for y: TaxableYear;
    when section_507a_willful_repeated_or_flagrant_act_established(o, y);
    then section_507c_tax_imposed(o, y);
}
