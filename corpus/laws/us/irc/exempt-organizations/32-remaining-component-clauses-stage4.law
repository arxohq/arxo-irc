// Stage 4: the last G6002 component clauses (audit of the text-order links, TECH-GAPS G6002) and the items G2005, G488, G72.
// Every rule below is an alternative or a missing piece next to rules of earlier modules; the aggregate facts of the earlier
// modules stay valid inputs. Bounded readings and JUDGMENT CALLs are stated in the labels and in the coverage notes.

// --- section 1381(a)(2)(C): a cooperative-basis corporation engaged in rural electric or telephone service ---

use self::{
    Asset,
    Corporation,
    IRC_S1381_A,
    IRC_S1383_B,
    IRC_S1385_C,
    IRC_S1388_H,
    IRC_S507_A,
    IRC_S509_A,
    IRC_S509_F,
    IRC_S512_B,
    IRC_S514_B,
    IRC_S514_C,
    IRC_S527_E,
    IRC_S530_B,
    Person,
    Secretary,
    TaxableYear,
    TradeOrBusiness,
    Trust,
    cooperative_taxable_year_bounds,
    coverdell_aggregate_contributions_530b1Aiii,
    exempt_functions_solely_for_state_or_local_office_527e5Ai,
    federal_candidate_involvement_disqualifies_for_org_527e5D,
    political_organization_for_527e5,
    private_foundation_status_terminated,
    products_delivered_by_distributee_on_1388h3,
    qualified_organization_514c9C,
    section_507c_tax_paid_or_abated,
    section_509a3_operated_in_connection_with,
    section_509a3_operated_supervised_or_controlled_by,
    section_509a3_supervised_or_controlled_in_connection_with,
    section_509f1_type_iii_requirements_met,
    section_509f2Bi_controls_governing_body_of_supported_org,
    section_509f2Bii_family_member_of_controlling_individual,
    section_509f2Biii_thirty_five_percent_controlled_entity,
    section_509f2_accepted_gift_from_disqualifying_person,
    section_511b_trust,
};

pub relation furnishes_electric_energy_to_persons_in_rural_areas_1381a2C(o: Corporation) kind empirical {
    label en official "section 1381(a)(2)(C): the corporation is engaged in furnishing electric energy to persons in rural areas";
}
pub relation provides_telephone_service_to_persons_in_rural_areas_1381a2C(o: Corporation) kind empirical {
    label en official "section 1381(a)(2)(C): the corporation is engaged in providing telephone service to persons in rural areas";
}
pub relation engaged_in_rural_electric_or_telephone_1381a2C(o: Corporation) kind institutional {
    label en official "section 1381(a)(2)(C): the corporation is engaged in furnishing electric energy, or providing telephone service, to persons in rural areas";
}
@source(IRC_S1381_A, quote = "(C) which is engaged in furnishing electric energy, or providing telephone service, to persons in rural areas.")
rule RuralElectricCooperative1381a2C(o: Corporation) defeasible {
    label en official "section 1381(a)(2)(C): furnishing electric energy to persons in rural areas";
    when furnishes_electric_energy_to_persons_in_rural_areas_1381a2C(o);
    then engaged_in_rural_electric_or_telephone_1381a2C(o);
}
@source(IRC_S1381_A, quote = "(C) which is engaged in furnishing electric energy, or providing telephone service, to persons in rural areas.")
rule RuralTelephoneCooperative1381a2C(o: Corporation) defeasible {
    label en official "section 1381(a)(2)(C): providing telephone service to persons in rural areas";
    when provides_telephone_service_to_persons_in_rural_areas_1381a2C(o);
    then engaged_in_rural_electric_or_telephone_1381a2C(o);
}

// --- section 1383(b)(2): the stated dollar amount of a redeemed nonqualified notice ---

pub relation amount_paid_in_redemption_of_nonqualified_notice_1383b2(coop: Person, y: TaxableYear, notice: Text, amount: Money) kind empirical {
    label en official "section 1383(b)(2): the amount paid in redemption of the nonqualified written notice of allocation or nonqualified per-unit retain certificate during the taxable year";
}
pub relation amount_allowable_as_deduction_under_1382_for_redemption_1383b2(coop: Person, y: TaxableYear, notice: Text, amount: Money) kind empirical {
    label en official "section 1383(b)(2): the part of the redemption payment allowable as a deduction under section 1382(b)(2) or (4), or (c)(2)(B) for the taxable year";
}
pub relation stated_dollar_amount_treated_as_qualified_1383b2(coop: Person, y: TaxableYear, notice: Text, amount: Money) kind institutional {
    label en official "section 1383(b)(2): for the decrease in tax under subsection (a)(2)(B), the stated dollar amount of the notice treated as qualified is the amount paid in redemption which is allowable as a deduction. JUDGMENT CALL: the redemption payment and the deductible part are case-supplied amounts; the amount is their minimum";
}
@source(IRC_S1383_B, quote = "(2) For purposes of determining the decrease in tax under subsection (a)(2)(B), the stated dollar amount of any nonqualified written notice of allocation or nonqualified per-unit retain certificate which is to be treated under such subsection as a qualified written notice of allocation or qualified per-unit retain certificate (as the case may be) shall be the amount paid in redemption of such written notice of allocation or per-unit retain certificate which is allowable as a deduction under section 1382(b)(2) or (4), or (c)(2)(B) for the taxable year.")
rule StatedDollarAmountOfRedeemedNotice1383b2(coop: Person, y: TaxableYear, notice: Text, paid: Money, allowable: Money) defeasible {
    label en official "section 1383(b)(2): the amount paid in redemption that is allowable as a deduction (bounded reading: the smaller of the payment and the deductible amount)";
    when amount_paid_in_redemption_of_nonqualified_notice_1383b2(coop, y, notice, paid);
    when amount_allowable_as_deduction_under_1382_for_redemption_1383b2(coop, y, notice, allowable);
    then stated_dollar_amount_treated_as_qualified_1383b2(coop, y, notice, min(paid, allowable));
}

// --- section 1385(c)(1): the notices to which the basis and ordinary-income rules apply ---

pub relation nonqualified_notice_paid_as_patronage_dividend_1385c1Ai(notice: Text) kind empirical {
    label en official "section 1385(c)(1)(A)(i): the nonqualified written notice of allocation was paid as a patronage dividend";
}
pub relation nonqualified_notice_paid_by_1381a1_organization_1385c1Aii(notice: Text, coop: Person) kind empirical {
    label en official "section 1385(c)(1)(A)(ii): the nonqualified written notice of allocation was paid by an organization described in section 1381(a)(1)";
}
pub relation notice_paid_on_patronage_basis_for_1382c2A_earnings_1385c1Aii(notice: Text) kind empirical {
    label en official "section 1385(c)(1)(A)(ii): the notice was paid on a patronage basis with respect to earnings derived from business or sources described in section 1382(c)(2)(A)";
}
pub relation nonqualified_per_unit_retain_certificate_paid_as_allocation_1385c1B(notice: Text) kind empirical {
    label en official "section 1385(c)(1)(B): the nonqualified per-unit retain certificate was paid as a per-unit retain allocation";
}
pub relation subsection_1385c_applies_to_notice_1385c1(notice: Text) kind institutional {
    label en official "section 1385(c)(1): subsection (c) applies to the notice or certificate";
}
@source(IRC_S1385_C, quote = "(i) was paid as a patronage dividend, or")
rule Subsection1385cAppliesViaPatronageDividend(notice: Text) defeasible {
    label en official "section 1385(c)(1)(A)(i)";
    when nonqualified_notice_paid_as_patronage_dividend_1385c1Ai(notice);
    then subsection_1385c_applies_to_notice_1385c1(notice);
}
@source(IRC_S1385_C, quote = "(ii) was paid by an organization described in section 1381(a)(1) on a patronage basis with respect to earnings derived from business or sources described in section 1382(c)(2)(A), and")
rule Subsection1385cAppliesViaFarmersCoopPatronageOnNonpatronageEarnings(notice: Text, coop: Person) defeasible {
    label en official "section 1385(c)(1)(A)(ii): both components: paid by a section 1381(a)(1) organization and on a patronage basis for section 1382(c)(2)(A) earnings";
    when nonqualified_notice_paid_by_1381a1_organization_1385c1Aii(notice, coop);
    when notice_paid_on_patronage_basis_for_1382c2A_earnings_1385c1Aii(notice);
    then subsection_1385c_applies_to_notice_1385c1(notice);
}
@source(IRC_S1385_C, quote = "(B) any nonqualified per-unit retain certificate which was paid as a per-unit retain allocation.")
rule Subsection1385cAppliesToPerUnitRetainCertificate(notice: Text) defeasible {
    label en official "section 1385(c)(1)(B)";
    when nonqualified_per_unit_retain_certificate_paid_as_allocation_1385c1B(notice);
    then subsection_1385c_applies_to_notice_1385c1(notice);
}

// --- section 1388(h)(3)(B)(i): revocation of a written agreement ---

pub relation written_revocation_filed_with_organization_on_1388h3Bi(coop: Person, patron: Person, filed_on: Date) kind empirical {
    label en official "section 1388(h)(3)(B)(i): the distributee revoked, in writing, an agreement described in paragraph (2)(A); the date the revocation was filed with the organization";
}
pub relation pooling_arrangement_1382e_applies_1388h3Bi(coop: Person, patron: Person) kind empirical {
    label en official "section 1388(h)(3)(B)(i): the case is a pooling arrangement described in section 1382(e)";
}
pub relation revocation_effective_date_candidate_1388h3Bi(coop: Person, patron: Person, on: Date) kind institutional {
    label en unofficial "helper: the first day of a taxable year of the organization beginning after the revocation was filed";
}
pub relation earlier_revocation_candidate_exists_1388h3Bi(coop: Person, patron: Person, on: Date) kind institutional {
    label en unofficial "helper: a strictly earlier taxable-year start after the filing exists (TECH-GAPS G136 pattern)";
}
pub relation revocation_effective_from_1388h3Bi(coop: Person, patron: Person, on: Date) kind institutional {
    label en official "section 1388(h)(3)(B)(i): the first day of the first taxable year of the organization beginning after the revocation is filed";
}
pub relation revocation_applies_to_delivery_1388h3Bi(coop: Person, patron: Person, delivered_on: Date) kind institutional {
    label en official "section 1388(h)(3)(B)(i): the revocation is effective for products delivered on or after the first day of the first taxable year beginning after it was filed";
}
pub relation revocation_ineffective_for_pooled_delivery_before_revocation_1388h3Bi(coop: Person, patron: Person, delivered_on: Date) kind institutional {
    label en official "section 1388(h)(3)(B)(i), proviso: in a pooling arrangement a revocation is not effective as to products delivered before it. Bounded reading: the proviso is implied by the effective date (which is after the filing) and is recorded as its own conclusion for pooled deliveries dated before the filing";
}
rule RevocationEffectiveDateCandidate1388h3Bi(coop: Person, patron: Person, y: TaxableYear, begins: Date, ends: Date, filed_on: Date) defeasible {
    label en unofficial "helper: candidate start dates";
    when written_revocation_filed_with_organization_on_1388h3Bi(coop, patron, filed_on);
    when cooperative_taxable_year_bounds(coop, y, begins, ends);
    when begins > filed_on;
    then revocation_effective_date_candidate_1388h3Bi(coop, patron, begins);
}
rule EarlierRevocationCandidateExists1388h3Bi(coop: Person, patron: Person, on: Date, other: Date) defeasible {
    label en unofficial "helper: an earlier candidate";
    when revocation_effective_date_candidate_1388h3Bi(coop, patron, on);
    when revocation_effective_date_candidate_1388h3Bi(coop, patron, other);
    when other < on;
    then earlier_revocation_candidate_exists_1388h3Bi(coop, patron, on);
}
@source(IRC_S1388_H, quote = "Any such revocation shall be effective with respect to products delivered by the distributee on or after the first day of the first taxable year of the organization beginning after the revocation is filed with the organization;")
rule RevocationEffectiveFromFirstYearAfterFiling1388h3Bi(coop: Person, patron: Person, on: Date) defeasible {
    label en official "section 1388(h)(3)(B)(i): the earliest taxable-year start after the filing (no strictly earlier candidate)";
    when revocation_effective_date_candidate_1388h3Bi(coop, patron, on);
    when not_known(earlier_revocation_candidate_exists_1388h3Bi(coop, patron, on));
    then revocation_effective_from_1388h3Bi(coop, patron, on);
}
@source(IRC_S1388_H, quote = "Any such revocation shall be effective with respect to products delivered by the distributee on or after the first day of the first taxable year of the organization beginning after the revocation is filed with the organization;")
rule RevocationAppliesToLaterDeliveries1388h3Bi(coop: Person, patron: Person, eff_from: Date, delivered_on: Date) defeasible {
    label en official "section 1388(h)(3)(B)(i): a delivery on the first day is covered (on or after)";
    when revocation_effective_from_1388h3Bi(coop, patron, eff_from);
    when products_delivered_by_distributee_on_1388h3(coop, patron, delivered_on);
    when delivered_on >= eff_from;
    then revocation_applies_to_delivery_1388h3Bi(coop, patron, delivered_on);
}
@source(IRC_S1388_H, quote = "except that in the case of a pooling arrangement described in section 1382(e) a revocation made by a distributee shall not be effective as to any products which were delivered to the organization by the distributee before such revocation.")
rule RevocationNotEffectiveForEarlierPooledDeliveries1388h3Bi(coop: Person, patron: Person, filed_on: Date, delivered_on: Date) defeasible {
    label en official "section 1388(h)(3)(B)(i), proviso: pooled products delivered before the revocation";
    when pooling_arrangement_1382e_applies_1388h3Bi(coop, patron);
    when written_revocation_filed_with_organization_on_1388h3Bi(coop, patron, filed_on);
    when products_delivered_by_distributee_on_1388h3(coop, patron, delivered_on);
    when delivered_on < filed_on;
    then revocation_ineffective_for_pooled_delivery_before_revocation_1388h3Bi(coop, patron, delivered_on);
}

// --- section 507(a)(2)(B): the Secretary's notification ---

pub relation willful_acts_giving_rise_to_chapter_42_liability_507a2A(o: Person, y: TaxableYear) kind empirical {
    label en official "section 507(a)(2)(A): willful repeated acts (or failures to act), or a willful and flagrant act (or failure to act), giving rise to liability for tax under chapter 42";
}
pub relation secretary_notified_organization_liable_for_507c_tax_507a2B(o: Person, y: TaxableYear) kind empirical {
    label en official "section 507(a)(2)(B): the Secretary notified the organization that, by reason of subparagraph (A), it is liable for the tax imposed by subsection (c)";
}
pub relation organization_liable_for_507c_termination_tax_507a2B(o: Person, y: TaxableYear) kind institutional {
    label en official "section 507(a)(2)(B): the organization is notified as liable for the section 507(c) tax by reason of subparagraph (A)";
}
rule Section507a2BNotificationPower(o: Person, y: TaxableYear) strict {
    label en official "section 507(a)(2)(B): the Secretary's notification is the power that fixes the liability for the section 507(c) tax; without the (A) acts the exercise is invalid";
    when willful_acts_giving_rise_to_chapter_42_liability_507a2A(o, y);
    then power Section507a2BNotification {
        holder Secretary;
        exercise secretary_notified_organization_liable_for_507c_tax_507a2B(o, y);
        valid_when willful_acts_giving_rise_to_chapter_42_liability_507a2A(o, y);
        effect organization_liable_for_507c_termination_tax_507a2B(o, y);
    };
}
@source(IRC_S507_A, quote = "(B) the Secretary notifies such organization that, by reason of subparagraph (A), such organization is liable for the tax imposed by subsection (c),")
rule Section507a2InvoluntaryTerminationDecomposed(o: Person, y: TaxableYear) defeasible {
    label en official "section 507(a)(2)(A)-(B): the acts, the Secretary's notification and payment or abatement of the section 507(c) tax terminate the status (components of the aggregate section507a_willful_repeated_or_flagrant_act_established of module 08)";
    when willful_acts_giving_rise_to_chapter_42_liability_507a2A(o, y);
    when organization_liable_for_507c_termination_tax_507a2B(o, y);
    when section_507c_tax_paid_or_abated(o, y);
    then private_foundation_status_terminated(o, y);
}

// --- section 509(f)(2), (3) and (a)(3)(B)(iii): donor control and the supported organization ---

pub relation supported_org_described_in_509a1_or_a2_509f3(sup_org: Person) kind empirical {
    label en official "section 509(f)(3): the organization is described in paragraph (1) or (2) of subsection (a)";
}
pub relation supporting_org_organized_and_operated_for_benefit_of_509f3A(supporting: Person, sup_org: Person) kind empirical {
    label en official "section 509(f)(3)(A): the supported organization is one for whose benefit the section 509(a)(3) organization is organized and operated";
}
pub relation supporting_org_performs_functions_or_carries_out_purposes_of_509f3B(supporting: Person, sup_org: Person) kind empirical {
    label en official "section 509(f)(3)(B): the supported organization is one whose functions the section 509(a)(3) organization performs, or whose purposes it carries out";
}
pub relation derived_supported_organization_509f3(supporting: Person, sup_org: Person) kind institutional {
    label en official "section 509(f)(3): the supported organization of a section 509(a)(3) organization, derived from clauses (A) and (B)";
}
@source(IRC_S509_F, quote = "(A) for whose benefit the organization described in subsection (a)(3) is organized and operated, or")
rule DerivedSupportedOrganizationViaBenefit509f3A(supporting: Person, sup_org: Person) defeasible {
    label en official "section 509(f)(3)(A)";
    when supported_org_described_in_509a1_or_a2_509f3(sup_org);
    when supporting_org_organized_and_operated_for_benefit_of_509f3A(supporting, sup_org);
    then derived_supported_organization_509f3(supporting, sup_org);
}
@source(IRC_S509_F, quote = "(B) with respect to which the organization performs the functions of, or carries out the purposes of.")
rule DerivedSupportedOrganizationViaFunctions509f3B(supporting: Person, sup_org: Person) defeasible {
    label en official "section 509(f)(3)(B)";
    when supported_org_described_in_509a1_or_a2_509f3(sup_org);
    when supporting_org_performs_functions_or_carries_out_purposes_of_509f3B(supporting, sup_org);
    then derived_supported_organization_509f3(supporting, sup_org);
}

pub relation person_described_in_509f2B(p: Person, sup_org: Person) kind institutional {
    label en official "section 509(f)(2)(B): a person described in this subparagraph with respect to the supported organization of the organization in (A)";
}
pub relation entity_controlled_by_persons_of_509f2Bi_ii_for_supported_509f2Biii(ent: Person, sup_org: Person) kind empirical {
    label en official "section 509(f)(2)(B)(iii): the entity's 35-percent control is by persons described in clause (i) or (ii) with respect to the supported organization (link fact; the share test is ThirtyFivePercentControlledEntity509f2)";
}
@source(IRC_S509_F, quote = "a person (other than an organization described in paragraph (1), (2), or (4) of section 509(a)) who directly or indirectly controls, either alone or together with persons described in clauses (ii) and (iii), the governing body of such supported organization,")
rule PersonDescribedIn509f2BViaControl(p: Person, sup_org: Person) defeasible {
    label en official "section 509(f)(2)(B)(i)";
    when section_509f2Bi_controls_governing_body_of_supported_org(p, sup_org);
    then person_described_in_509f2B(p, sup_org);
}
@source(IRC_S509_F, quote = "(ii) a member of the family (determined under section 4958(f)(4)) of an individual described in clause (i), or")
rule PersonDescribedIn509f2BViaFamily(p: Person, ci: Person, sup_org: Person) defeasible {
    label en official "section 509(f)(2)(B)(ii): a family member (section 4958(f)(4)) of an individual described in clause (i)";
    when section_509f2Bii_family_member_of_controlling_individual(p, ci);
    when section_509f2Bi_controls_governing_body_of_supported_org(ci, sup_org);
    then person_described_in_509f2B(p, sup_org);
}
@source(IRC_S509_F, quote = "a 35-percent controlled entity (as defined in section 4958(f)(3) by substituting \"persons described in clause (i) or (ii) of section 509(f)(2)(B)\" for \"persons described in subparagraph (A) or (B) of paragraph (1)\" in subparagraph (A)(i) thereof).")
rule PersonDescribedIn509f2BViaControlledEntity(e: Corporation, share: Decimal, sup_org: Person) defeasible {
    label en official "section 509(f)(2)(B)(iii)";
    when section_509f2Biii_thirty_five_percent_controlled_entity(e, share);
    when entity_controlled_by_persons_of_509f2Bi_ii_for_supported_509f2Biii(e, sup_org);
    then person_described_in_509f2B(e, sup_org);
}
pub relation gift_or_contribution_accepted_from_person_509f2A(o: Person, y: TaxableYear, donor: Person) kind empirical {
    label en official "section 509(f)(2)(A): the organization accepted a gift or contribution from the person in the taxable year";
}
@source(IRC_S509_F, quote = "if such organization accepts any gift or contribution from any person described in subparagraph (B).")
rule AcceptedGiftFromDisqualifyingPerson509f2A(o: Person, y: TaxableYear, donor: Person, sup_org: Person) defeasible {
    label en official "section 509(f)(2)(A): a gift from a person described in (B) with respect to a supported organization of the organization";
    when gift_or_contribution_accepted_from_person_509f2A(o, y, donor);
    when derived_supported_organization_509f3(o, sup_org);
    when person_described_in_509f2B(donor, sup_org);
    then section_509f2_accepted_gift_from_disqualifying_person(o, y);
}
pub relation not_considered_operated_supervised_or_controlled_509f2Ai(o: Person, y: TaxableYear) kind institutional {
    label en official "section 509(f)(2)(A)(i): the organization is not considered operated, supervised, or controlled by an organization described in paragraph (1) or (2) of subsection (a), for subsection (a)(3)(B)";
}
pub relation not_considered_operated_in_connection_509f2Aii(o: Person, y: TaxableYear) kind institutional {
    label en official "section 509(f)(2)(A)(ii): the organization is not considered operated in connection with an organization described in paragraph (1) or (2) of subsection (a), for subsection (a)(3)(B)";
}
@source(IRC_S509_F, quote = "(i) operated, supervised, or controlled by any organization described in paragraph (1) or (2) of subsection (a), or")
rule NotConsideredOperatedSupervisedOrControlled509f2Ai(o: Person, y: TaxableYear) defeasible {
    label en official "section 509(f)(2)(A)(i)";
    when section_509f2_accepted_gift_from_disqualifying_person(o, y);
    then not_considered_operated_supervised_or_controlled_509f2Ai(o, y);
}
@source(IRC_S509_F, quote = "(ii) operated in connection with any organization described in paragraph (1) or (2) of subsection (a),")
rule NotConsideredOperatedInConnection509f2Aii(o: Person, y: TaxableYear) defeasible {
    label en official "section 509(f)(2)(A)(ii)";
    when section_509f2_accepted_gift_from_disqualifying_person(o, y);
    then not_considered_operated_in_connection_509f2Aii(o, y);
}
pub relation section_509a3_relationship_prong_satisfied_after_509f(o: Person, y: TaxableYear) kind institutional {
    label en official "section 509(a)(3)(B) read with subsection (f): a relationship prong is satisfied, the (i) prong not defeated by a disqualifying gift and the (iii) prong requiring the Type III responsiveness and foreign-supported-organization rules and not defeated by a disqualifying gift";
}
@source(IRC_S509_A, quote = "operated in connection with one or more such organizations, and")
rule Section509a3ProngIAfter509f(o: Person, y: TaxableYear) defeasible {
    label en official "section 509(a)(3)(B)(i) with (f)(2)(A)(i)";
    when section_509a3_operated_supervised_or_controlled_by(o);
    when us.irc.core::year_of(o, y);
    unless not_considered_operated_supervised_or_controlled_509f2Ai(o, y);
    then section_509a3_relationship_prong_satisfied_after_509f(o, y);
}
@source(IRC_S509_A, quote = "supervised or controlled in connection with one or more such organizations, or")
rule Section509a3ProngIIAfter509f(o: Person, y: TaxableYear) defeasible {
    label en official "section 509(a)(3)(B)(ii): not listed in subsection (f)(2)(A), so the prong stands as in module 05";
    when section_509a3_supervised_or_controlled_in_connection_with(o);
    when us.irc.core::year_of(o, y);
    then section_509a3_relationship_prong_satisfied_after_509f(o, y);
}
@source(IRC_S509_A, quote = "operated in connection with one or more such organizations, and")
rule Section509a3ProngIIIAfter509f(o: Person, y: TaxableYear) defeasible {
    label en official "section 509(a)(3)(B)(iii) with (f)(1) and (f)(2)(A)(ii): the Type III requirements are met and no disqualifying gift was accepted";
    when section_509a3_operated_in_connection_with(o);
    when section_509f1_type_iii_requirements_met(o, y);
    unless not_considered_operated_in_connection_509f2Aii(o, y);
    then section_509a3_relationship_prong_satisfied_after_509f(o, y);
}

// --- section 512(b)(11): the section 170 limit against unrelated business taxable income ---

pub relation ubti_computed_without_benefit_of_512b11(t: Trust, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 512(b)(11): the unrelated business taxable income computed without the benefit of this paragraph, the base that replaces adjusted gross income";
}
pub relation contributions_and_gifts_of_511b_trust_512b11(t: Trust, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 512(b)(11): the gifts and contributions of the trust (including distributions to section 170 beneficiaries) for the taxable year";
}
pub relation section_170b1_limit_percentage_for_512b11(t: Trust, y: TaxableYear, percentage: Decimal) kind empirical {
    label en official "section 512(b)(11): the section 170(b)(1)(A) or (B) percentage that applies to the trust's contributions. JUDGMENT CALL and EXTERNAL_DEPENDENCY on the section 170(b)(1) owner (us.irc.deductions): the percentage class is case-supplied";
}
pub relation charitable_deduction_512b11_computed(t: Trust, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 512(b)(11): the deduction is the smaller of the contributions and the section 170(b)(1) percentage of the unrelated business taxable income computed without the benefit of this paragraph (in lieu of adjusted gross income); whole intermediate rounding to cents HALF_UP is a corpus convention (JUDGMENT CALL)";
}
@source(IRC_S512_B, quote = "The deduction allowed by this paragraph shall be allowed with the limitations prescribed in section 170(b)(1)(A) and (B) determined with reference to the unrelated business taxable income computed without the benefit of this paragraph (in lieu of with reference to adjusted gross income).")
rule CharitableDeduction512b11Computed(t: Trust, y: TaxableYear, base: Money, gifts: Money, pct: Decimal) defeasible {
    label en official "section 512(b)(11): limit = percentage of the UBTI base, deduction = the smaller";
    when section_511b_trust(t, y);
    when ubti_computed_without_benefit_of_512b11(t, y, base);
    when contributions_and_gifts_of_511b_trust_512b11(t, y, gifts);
    when section_170b1_limit_percentage_for_512b11(t, y, pct);
    then charitable_deduction_512b11_computed(t, y, min(gifts, round(base * pct, 2, "HALF_UP")));
}

// --- section 512(b)(13)(B)(ii): net unrelated loss ---

pub relation controlled_entity_exempt_under_501a_512b13B(controlled: Person) kind empirical {
    label en official "section 512(b)(13)(B)(i)(II): the controlled entity is exempt from tax under section 501(a)";
}
pub relation net_operating_loss_of_controlled_entity_512b13Bii(controlled: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 512(b)(13)(B)(ii): the net operating loss of the controlled entity for the taxable year";
}
pub relation portion_of_nol_that_would_be_unrelated_if_exempt_with_same_purposes_512b13Bii(controlled: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 512(b)(13)(B)(ii) with (i)(I): the portion of the net operating loss of a non-exempt entity that would be an unrelated business loss if it were exempt with the same exempt purposes as the controlling organization";
}
pub relation unrelated_business_net_operating_loss_of_exempt_entity_512b13Bii(controlled: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 512(b)(13)(B)(ii) with (i)(II): the net operating loss of an entity exempt under section 501(a), adjusted to the unrelated business loss";
}
pub relation net_unrelated_loss_512b13Bii(controlled: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 512(b)(13)(B)(ii): the net unrelated loss, the net operating loss adjusted under rules similar to clause (i). Bounded reading: the adjusted amount is case-supplied on each branch; the adjustment itself is not re-derived";
}
@source(IRC_S512_B, quote = "(ii) Net unrelated loss.—The term \"net unrelated loss\" means the net operating loss adjusted under rules similar to the rules of clause (i).")
rule NetUnrelatedLossOfNonExemptEntity512b13Bii(controlled: Person, y: TaxableYear, loss: Money, adjusted: Money) defeasible {
    label en official "section 512(b)(13)(B)(ii) with (i)(I): non-exempt entity";
    when net_operating_loss_of_controlled_entity_512b13Bii(controlled, y, loss);
    when portion_of_nol_that_would_be_unrelated_if_exempt_with_same_purposes_512b13Bii(controlled, y, adjusted);
    when not_known(controlled_entity_exempt_under_501a_512b13B(controlled));
    then net_unrelated_loss_512b13Bii(controlled, y, adjusted);
}
@source(IRC_S512_B, quote = "(ii) Net unrelated loss.—The term \"net unrelated loss\" means the net operating loss adjusted under rules similar to the rules of clause (i).")
rule NetUnrelatedLossOfExemptEntity512b13Bii(controlled: Person, y: TaxableYear, loss: Money, adjusted: Money) defeasible {
    label en official "section 512(b)(13)(B)(ii) with (i)(II): exempt entity";
    when net_operating_loss_of_controlled_entity_512b13Bii(controlled, y, loss);
    when controlled_entity_exempt_under_501a_512b13B(controlled);
    when unrelated_business_net_operating_loss_of_exempt_entity_512b13Bii(controlled, y, adjusted);
    then net_unrelated_loss_512b13Bii(controlled, y, adjusted);
}

// --- section 514(b)(3)(D): the return date and the later satisfaction of the use condition ---

pub relation return_due_date_with_extensions_514b3D(o: Person, y: TaxableYear, due: Date) kind empirical {
    label en official "section 514(b)(3)(D): the time prescribed by law (including extensions) for filing the return for the taxable year";
}
pub relation actual_use_condition_of_514b3B_satisfied_on(o: Person, tb: TradeOrBusiness, on: Date) kind empirical {
    label en official "section 514(b)(3)(D): the date on which the organization satisfied the actual use condition of subparagraph (B)";
}
pub relation tax_computed_without_514b3B_for_year_514b3D(o: Person, tb: TradeOrBusiness, y: TaxableYear) kind institutional {
    label en official "section 514(b)(3)(D), first sentence: the use condition was not satisfied before the filing time, so the tax for the year is computed without regard to subparagraph (B)";
}
pub relation provision_514b3B_applied_to_year_514b3D(o: Person, tb: TradeOrBusiness, y: TaxableYear) kind institutional {
    label en official "section 514(b)(3)(D), first sentence, after the comma: if and when the use condition is satisfied, subparagraph (B) is applied to the taxable year";
}
@source(IRC_S514_B, quote = "If an organization for any taxable year has not used land in the manner to satisfy the actual use condition of subparagraph (B) before the time prescribed by law (including extensions thereof) for filing the return for such taxable year, the tax for such year shall be computed without regard to the application of subparagraph (B), but if and when such use condition is satisfied, the provisions of subparagraph (B) shall then be applied to such taxable year.")
rule TaxComputedWithoutSubparagraphBWhenUseNotYetSatisfied514b3D(o: Person, tb: TradeOrBusiness, y: TaxableYear, due: Date, satisfied_on: Date) defeasible {
    label en official "section 514(b)(3)(D): the condition was satisfied only after the filing time (satisfaction on the last day is not after it)";
    when return_due_date_with_extensions_514b3D(o, y, due);
    when actual_use_condition_of_514b3B_satisfied_on(o, tb, satisfied_on);
    when satisfied_on > due;
    then tax_computed_without_514b3B_for_year_514b3D(o, tb, y);
}
@source(IRC_S514_B, quote = "If an organization for any taxable year has not used land in the manner to satisfy the actual use condition of subparagraph (B) before the time prescribed by law (including extensions thereof) for filing the return for such taxable year, the tax for such year shall be computed without regard to the application of subparagraph (B), but if and when such use condition is satisfied, the provisions of subparagraph (B) shall then be applied to such taxable year.")
rule Subparagraph514b3BAppliedWhenSatisfied514b3D(o: Person, tb: TradeOrBusiness, y: TaxableYear, due: Date, satisfied_on: Date) defeasible {
    label en official "section 514(b)(3)(D): when the condition is satisfied after the filing time, subparagraph (B) is applied to the year";
    when tax_computed_without_514b3B_for_year_514b3D(o, tb, y);
    when actual_use_condition_of_514b3B_satisfied_on(o, tb, satisfied_on);
    then provision_514b3B_applied_to_year_514b3D(o, tb, y);
}
pub relation taxable_year_of_satisfaction_ends_on_514b3D(o: Person, tb: TradeOrBusiness, ends_on: Date) kind empirical {
    label en official "section 514(b)(3)(D), second sentence: the close of the taxable year in which the use condition is satisfied";
}
pub relation credit_or_refund_barred_at_close_of_satisfaction_year_514b3D(o: Person, tb: TradeOrBusiness, y: TaxableYear) kind empirical {
    label en official "section 514(b)(3)(D), second sentence: credit or refund of the overpayment resulting from the satisfaction is prevented at the close of the year of satisfaction by a law or rule of law (other than chapter 74)";
}
pub relation refund_claim_filed_on_514b3D(o: Person, tb: TradeOrBusiness, y: TaxableYear, filed_on: Date) kind empirical {
    label en official "section 514(b)(3)(D), second sentence: the date the claim for credit or refund was filed";
}
pub relation credit_or_refund_may_nevertheless_be_allowed_514b3D(o: Person, tb: TradeOrBusiness, y: TaxableYear) kind institutional {
    label en official "section 514(b)(3)(D), second sentence: credit or refund may nevertheless be allowed. JUDGMENT CALL: a claim filed on the last day of the one-year period is treated as filed before its expiration";
}
@source(IRC_S514_B, quote = "If the actual use condition of subparagraph (B) is satisfied for any taxable year after such time for filing the return, and if credit or refund of any overpayment for the taxable year resulting from the satisfaction of such use condition is prevented at the close of the taxable year in which the use condition is satisfied, by the operation of any law or rule of law (other than chapter 74, relating to closing agreements and compromises), credit or refund of such overpayment may nevertheless be allowed or made if claim therefor is filed before the expiration of 1 year after the close of the taxable year in which the use condition is satisfied.")
rule CreditOrRefundMayNevertheless514b3D(o: Person, tb: TradeOrBusiness, y: TaxableYear, due: Date, satisfied_on: Date, ends_on: Date, filed_on: Date) defeasible {
    label en official "section 514(b)(3)(D), second sentence";
    when return_due_date_with_extensions_514b3D(o, y, due);
    when actual_use_condition_of_514b3B_satisfied_on(o, tb, satisfied_on);
    when satisfied_on > due;
    when credit_or_refund_barred_at_close_of_satisfaction_year_514b3D(o, tb, y);
    when taxable_year_of_satisfaction_ends_on_514b3D(o, tb, ends_on);
    when refund_claim_filed_on_514b3D(o, tb, y, filed_on);
    when filed_on <= add_calendar_period(ends_on, 1 calendar_year);
    then credit_or_refund_may_nevertheless_be_allowed_514b3D(o, tb, y);
}

// --- section 514(c)(9)(B)(ii), the last sentence of (B), and (D) ---

pub relation amount_of_indebtedness_depends_on_property_revenue_514c9Bii(o: Person, real_prop: Asset) kind empirical {
    label en official "section 514(c)(9)(B)(ii): the amount of the indebtedness is dependent, in whole or in part, upon revenue, income, or profits derived from the real property";
}
pub relation other_amount_payable_depends_on_property_revenue_514c9Bii(o: Person, real_prop: Asset) kind empirical {
    label en official "section 514(c)(9)(B)(ii): any other amount payable with respect to the indebtedness is dependent, in whole or in part, upon revenue, income, or profits derived from the real property";
}
pub relation time_of_payment_depends_on_property_revenue_514c9Bii(o: Person, real_prop: Asset) kind empirical {
    label en official "section 514(c)(9)(B)(ii): the time for making any payment is dependent, in whole or in part, upon revenue, income, or profits derived from the real property";
}
pub relation payment_terms_depend_on_property_income_514c9Bii_derived(o: Person, real_prop: Asset) kind institutional {
    label en official "section 514(c)(9)(B)(ii): the (B)(ii) exception holds on its three components";
}
@source(IRC_S514_C, quote = "(ii) the amount of any indebtedness or any other amount payable with respect to such indebtedness, or the time for making any payment of any such amount, is dependent, in whole or in part, upon any revenue, income, or profits derived from such real property;")
rule Exception514c9BiiViaAmountOfIndebtedness(o: Person, real_prop: Asset) defeasible {
    label en official "section 514(c)(9)(B)(ii): amount of the indebtedness";
    when amount_of_indebtedness_depends_on_property_revenue_514c9Bii(o, real_prop);
    then payment_terms_depend_on_property_income_514c9Bii_derived(o, real_prop);
}
@source(IRC_S514_C, quote = "(ii) the amount of any indebtedness or any other amount payable with respect to such indebtedness, or the time for making any payment of any such amount, is dependent, in whole or in part, upon any revenue, income, or profits derived from such real property;")
rule Exception514c9BiiViaOtherAmount(o: Person, real_prop: Asset) defeasible {
    label en official "section 514(c)(9)(B)(ii): any other amount payable";
    when other_amount_payable_depends_on_property_revenue_514c9Bii(o, real_prop);
    then payment_terms_depend_on_property_income_514c9Bii_derived(o, real_prop);
}
@source(IRC_S514_C, quote = "(ii) the amount of any indebtedness or any other amount payable with respect to such indebtedness, or the time for making any payment of any such amount, is dependent, in whole or in part, upon any revenue, income, or profits derived from such real property;")
rule Exception514c9BiiViaTimeOfPayment(o: Person, real_prop: Asset) defeasible {
    label en official "section 514(c)(9)(B)(ii): time for making any payment";
    when time_of_payment_depends_on_property_revenue_514c9Bii(o, real_prop);
    then payment_terms_depend_on_property_income_514c9Bii_derived(o, real_prop);
}
pub relation organization_has_unrelated_business_taxable_income_514c9B(o: Person) kind empirical {
    label en official "section 514(c)(9)(B), last sentence: some income of the organization is unrelated business taxable income";
}
pub relation partner_of_partnership_514c9BviI(partnership: Person, partner: Person) kind empirical {
    label en official "section 514(c)(9)(B)(vi)(I): the person is a partner of the partnership";
}
pub relation qualified_organization_for_subclause_514c9BviI(o: Person) kind institutional {
    label en official "section 514(c)(9)(B), last sentence: for subclause (I) of clause (vi), a qualified organization none of whose income is unrelated business taxable income";
}
@source(IRC_S514_C, quote = "For purposes of subclause (I) of clause (vi), an organization shall not be treated as a qualified organization if any income of such organization is unrelated business taxable income.")
rule QualifiedOrganizationForSubclause514c9BviI(o: Person) defeasible {
    label en official "section 514(c)(9)(B), last sentence: a qualified organization (subparagraph (C)) that has no unrelated business taxable income";
    when qualified_organization_514c9C(o);
    unless organization_has_unrelated_business_taxable_income_514c9B(o);
    then qualified_organization_for_subclause_514c9BviI(o);
}
pub relation partner_not_qualified_organization_514c9BviI(partnership: Person, partner: Person) kind institutional {
    label en unofficial "helper: a partner that is not a qualified organization for subclause (I)";
}
rule PartnerNotQualifiedOrganization514c9BviI(partnership: Person, partner: Person) defeasible {
    label en unofficial "helper";
    when partner_of_partnership_514c9BviI(partnership, partner);
    unless qualified_organization_for_subclause_514c9BviI(partner) and partner_of_partnership_514c9BviI(partnership, partner);
    then partner_not_qualified_organization_514c9BviI(partnership, partner);
}
pub relation all_partners_are_qualified_organizations_514c9BviI(partnership: Person) kind institutional {
    label en official "section 514(c)(9)(B)(vi)(I): all of the partners are qualified organizations (with the last-sentence rule on unrelated business taxable income)";
}
@source(IRC_S514_C, quote = "(I) all of the partners of the partnership are qualified organizations,")
rule AllPartnersAreQualifiedOrganizations514c9BviI(partnership: Person, partner: Person) defeasible {
    label en official "section 514(c)(9)(B)(vi)(I): at least one partner is recorded, and none is a non-qualified partner";
    when partner_of_partnership_514c9BviI(partnership, partner);
    when not_known(partner_not_qualified_organization_514c9BviI(partnership, partner));
    then all_partners_are_qualified_organizations_514c9BviI(partnership);
}
pub relation property_held_by_pass_thru_entity_other_than_partnership_514c9D(o: Person, real_prop: Asset, ent: Person) kind empirical {
    label en official "section 514(c)(9)(D): the real property is held by a pass-thru entity other than a partnership, or by a tier of partnerships or other entities";
}
pub relation pass_thru_entity_fails_rules_similar_to_514c9Bvi_514c9D(ent: Person) kind empirical {
    label en official "section 514(c)(9)(D): the pass-thru or tiered entity fails the rules similar to the rules of subparagraph (B)(vi) (explicit incorporation by analogy: the same clause (i)-(v) and partner tests)";
}
pub relation pass_thru_held_property_fails_partner_requirements_514c9D(o: Person, real_prop: Asset) kind institutional {
    label en official "section 514(c)(9)(D): the property held by a pass-thru or tiered entity is subject to the (B)(vi) exception by analogy";
}
@source(IRC_S514_C, quote = "Rules similar to the rules of subparagraph (B)(vi) shall also apply in the case of any pass-thru entity other than a partnership and in the case of tiered partnerships and other entities.")
rule PassThruHeldPropertyFailsPartnerRequirements514c9D(o: Person, real_prop: Asset, ent: Person) defeasible {
    label en official "section 514(c)(9)(D): the analogy of (B)(vi) applied to other pass-thru and tiered entities";
    when property_held_by_pass_thru_entity_other_than_partnership_514c9D(o, real_prop, ent);
    when pass_thru_entity_fails_rules_similar_to_514c9Bvi_514c9D(ent);
    then pass_thru_held_property_fails_partner_requirements_514c9D(o, real_prop);
}

// --- section 527(e)(5)(C): de minimis reporting errors ---

pub external judgment relation ReportingErrorsAreDeMinimis527e5C(o: Person) {
    authority Secretary;
    label en official "the organization's errors in complying with the State reporting and public inspection requirements are de minimis (section 527(e)(5)(C)) — DECISION-0194 evaluative channel; the text names no authority, so the administering Secretary is used as in the neighbouring evaluative clauses";
}
pub external judgment relation ErrorsCorrectedWithinReasonablePeriod527e5C(o: Person) {
    authority Secretary;
    label en official "the organization corrects the errors within a reasonable period after it becomes aware of them (section 527(e)(5)(C)) — DECISION-0194 evaluative channel";
}
pub relation state_reporting_or_inspection_errors_made_527e5C(o: Person) kind empirical {
    label en official "section 527(e)(5)(C): the organization made errors in complying with the State reporting requirements or the public inspection requirements described in subparagraph (A)";
}
pub relation not_failed_to_be_qualified_solely_by_de_minimis_errors_527e5C(o: Person) kind institutional {
    label en official "section 527(e)(5)(C): the organization does not fail to be treated as a qualified State or local political organization solely because of its errors";
}
@source(IRC_S527_E, quote = "An organization shall not fail to be treated as a qualified State or local political organization solely because such organization makes de minimis errors in complying with the State reporting requirements and the public inspection requirements described in subparagraph (A) as long as the organization corrects such errors within a reasonable period after the organization becomes aware of such errors.")
rule DeMinimisErrorsDoNotDisqualify527e5C(o: Person) defeasible {
    label en official "section 527(e)(5)(C): errors that are de minimis and corrected within a reasonable period";
    when state_reporting_or_inspection_errors_made_527e5C(o);
    when ReportingErrorsAreDeMinimis527e5C(o);
    when ErrorsCorrectedWithinReasonablePeriod527e5C(o);
    then not_failed_to_be_qualified_solely_by_de_minimis_errors_527e5C(o);
}
pub relation qualified_state_or_local_political_organization_despite_de_minimis_errors_527e5C(o: Person) kind institutional {
    label en official "section 527(e)(5)(A) with (C): the organization is a qualified State or local political organization when its only shortfall is de minimis errors: all the other (A) conditions hold, the reporting conditions being met except for the errors";
}
@source(IRC_S527_E, quote = "An organization shall not fail to be treated as a qualified State or local political organization solely because such organization makes de minimis errors in complying with the State reporting requirements and the public inspection requirements described in subparagraph (A) as long as the organization corrects such errors within a reasonable period after the organization becomes aware of such errors.")
rule QualifiedDespiteDeMinimisErrors527e5C(o: Person) defeasible {
    label en official "section 527(e)(5)(A), (C): political organization, State or local exempt functions only, no Federal candidate involvement, and the shortfall is only de minimis errors that do not disqualify. Bounded reading: which of the reporting conditions carries the error is not tracked";
    when political_organization_for_527e5(o);
    when exempt_functions_solely_for_state_or_local_office_527e5Ai(o);
    when not_failed_to_be_qualified_solely_by_de_minimis_errors_527e5C(o);
    unless federal_candidate_involvement_disqualifies_for_org_527e5D(o);
    then qualified_state_or_local_political_organization_despite_de_minimis_errors_527e5C(o);
}

// --- section 529A(b)(2)(B)(i): the section 2503(b) amount is the A3 parameter AbleAnnualLimit529Ab2Bi (module 27) ---

// --- section 530(b)(1)(A)(iii): rollover contributions are outside the annual limit ---

pub relation coverdell_rollover_contributions_530b1Aiii(account: Trust, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 530(b)(1)(A)(iii): the part of the contributions for the taxable year that are rollover contributions";
}
pub relation coverdell_contribution_limit_exceeded_excluding_rollovers_530b1Aiii(account: Trust, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 530(b)(1)(A)(iii): except in the case of rollover contributions, the contribution would result in aggregate contributions for the taxable year exceeding $2,000; the excess is measured on the non-rollover contributions";
}
@source(IRC_S530_B, quote = "(iii) except in the case of rollover contributions, if such contribution would result in aggregate contributions for the taxable year exceeding $2,000.")
rule CoverdellNonRolloverContributionLimitExceeded(account: Trust, y: TaxableYear, aggregate: Money, rollover: Money) defeasible {
    label en official "section 530(b)(1)(A)(iii): exact $2,000, rollover contributions excluded from the aggregate";
    when coverdell_aggregate_contributions_530b1Aiii(account, y, aggregate);
    when coverdell_rollover_contributions_530b1Aiii(account, y, rollover);
    when aggregate - rollover > 2000.00 USD;
    then coverdell_contribution_limit_exceeded_excluding_rollovers_530b1Aiii(account, y, aggregate - rollover);
}

// --- section 530(b)(2)(B): qualified tuition program contributions ---

pub relation contribution_to_qualified_tuition_program_on_behalf_of_designated_beneficiary_530b2B(contribution: Text, account: Trust) kind empirical {
    label en official "section 530(b)(2)(B): a contribution to a qualified tuition program (section 529(b)) on behalf of the designated beneficiary (section 529(e)(1))";
}
pub relation contribution_counts_as_qualified_education_expense_530b2B(contribution: Text, account: Trust) kind institutional {
    label en official "section 530(b)(2)(B): the term qualified education expenses includes the contribution";
}
@source(IRC_S530_B, quote = "Such term shall include any contribution to a qualified tuition program (as defined in section 529(b)) on behalf of the designated beneficiary (as defined in section 529(e)(1));")
rule QualifiedTuitionProgramContributionIsQualifiedEducationExpense530b2B(contribution: Text, account: Trust) defeasible {
    label en official "section 530(b)(2)(B), first clause";
    when contribution_to_qualified_tuition_program_on_behalf_of_designated_beneficiary_530b2B(contribution, account);
    then contribution_counts_as_qualified_education_expense_530b2B(contribution, account);
}
pub relation portion_of_contribution_not_includible_by_reason_of_530d2_530b2B(contribution: Text, amount: Money) kind empirical {
    label en official "section 530(b)(2)(B): the portion of the contribution that is not includible in gross income by reason of subsection (d)(2)";
}
pub relation no_increase_in_investment_in_contract_530b2B(contribution: Text, amount: Money) kind institutional {
    label en official "section 530(b)(2)(B): there is no increase in the investment in the contract for purposes of applying section 72 by reason of that portion";
}
@source(IRC_S530_B, quote = "but there shall be no increase in the investment in the contract for purposes of applying section 72 by reason of any portion of such contribution which is not includible in gross income by reason of subsection (d)(2).")
rule NoIncreaseInInvestmentInContractForExcludedPortion530b2B(contribution: Text, amount: Money) defeasible {
    label en official "section 530(b)(2)(B), proviso";
    when portion_of_contribution_not_includible_by_reason_of_530d2_530b2B(contribution, amount);
    then no_increase_in_investment_in_contract_530b2B(contribution, amount);
}
