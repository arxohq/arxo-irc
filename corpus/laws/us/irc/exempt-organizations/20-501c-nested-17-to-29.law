// Section 501(c), stage 3 (b): nested sub-paragraph machinery for paragraphs
// (17), (18), (21), (22), (25), (26), (27) and the (29)(B) conditions.
// Same method as 19-501c-nested-1-to-15.law: a decomposed derivation is added
// next to the stage 2 aggregate rule (the aggregate empirical fact stays
// available for a case that asserts it), and "in the case of X, Y is required"
// clauses become defeaters written `unless <derived unmet relation>` so that a
// missing fact blocks the classification rather than passing it.

// ---------------------------------------------------------------------
// (c)(17): supplemental unemployment compensation benefit (SUB) trusts.
// ---------------------------------------------------------------------

use self::{
    C18BenefitClassificationNondiscriminatory,
    IRC_S501_C,
    Person,
    TaxableYear,
    black_lung_trust_established_in_writing_in_us,
    c18_trust_no_diversion_possible,
    established_by_state_for_not_for_profit_medical_coverage,
    has_only_one_class_of_stock_or_interest,
    membership_composition_specified_by_state,
    multiemployer_plan_sponsor_trust_established_in_writing,
    organized_exclusively_for_real_property_title_holding_multi,
    pension_trust_funded_only_by_employee_contributions,
    private_inurement_established,
    section_501c17,
    section_501c18,
    section_501c21,
    section_501c22,
    section_501c25,
    section_501c26,
    section_501c27,
    section_501c9,
    shareholder_or_beneficiary_count_501c25,
    sub_trust_no_diversion_possible,
    trust_created_before_date,
};

pub relation sub_classification_set_forth_in_plan_501c17Aii(o: Person) kind empirical {
    label en official "the benefits are payable to employees under a classification set forth in the plan (section 501(c)(17)(A)(ii))";
}
@source(IRC_S501_C, quote = "(ii) such benefits are payable to employees under a classification which is set forth in the plan and which is found by the Secretary not to be discriminatory in favor of employees who are highly compensated employees (within the meaning of section 414(q)), and")
pub external judgment relation SecretaryFindsSubClassificationNotDiscriminatory501c17Aii(o: Person, y: TaxableYear) {
    authority Secretary;
    label en official "the Secretary finds the plan's classification not discriminatory in favor of employees who are highly compensated employees within the meaning of section 414(q) (section 501(c)(17)(A)(ii)) — DECISION-0194 evaluative channel";
}
pub relation sub_benefits_do_not_favor_highly_compensated_501c17Aiii(o: Person, y: TaxableYear) kind empirical {
    label en official "the SUB benefits do not discriminate in favor of employees who are highly compensated employees within the meaning of section 414(q) (section 501(c)(17)(A)(iii)) — the section 414(q) classification is an EXTERNAL_DEPENDENCY on us.irc.deferred_compensation";
}
pub relation sub_benefits_bear_uniform_relationship_to_compensation_501c17Aiii(o: Person, y: TaxableYear) kind empirical {
    label en official "the benefits received under the plan bear a uniform relationship to the total compensation, or the basic or regular rate of compensation, of the employees covered (section 501(c)(17)(A)(iii))";
}
pub relation sub_benefits_nondiscriminatory_501c17Aiii(o: Person, y: TaxableYear) kind institutional {
    label en official "the SUB benefits do not discriminate in favor of highly compensated employees";
}
@source(IRC_S501_C, quote = "(iii) such benefits do not discriminate in favor of employees who are highly compensated employees (within the meaning of section 414(q)). A plan shall not be considered discriminatory within the meaning of this clause merely because the benefits received under the plan bear a uniform relationship to the total compensation, or the basic or regular rate of compensation, of the employees covered by the plan.")
rule SubBenefitsNondiscriminatoryOnTheFacts(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(17)(A)(iii): the benefits do not discriminate in favor of highly compensated employees";
    when sub_benefits_do_not_favor_highly_compensated_501c17Aiii(o, y);
    then sub_benefits_nondiscriminatory_501c17Aiii(o, y);
}
@source(IRC_S501_C, quote = "(iii) such benefits do not discriminate in favor of employees who are highly compensated employees (within the meaning of section 414(q)). A plan shall not be considered discriminatory within the meaning of this clause merely because the benefits received under the plan bear a uniform relationship to the total compensation, or the basic or regular rate of compensation, of the employees covered by the plan.")
rule SubBenefitsNondiscriminatoryBySafeHarbor(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(17)(A)(iii), last sentence: a plan is not discriminatory merely because benefits bear a uniform relationship to compensation";
    when sub_benefits_bear_uniform_relationship_to_compensation_501c17Aiii(o, y);
    then sub_benefits_nondiscriminatory_501c17Aiii(o, y);
}
// (B): other plans are not taken into consideration, except that the plan is
// not considered discriminatory merely because of one of three coordination features.
pub relation sub_benefits_first_determined_nondiscriminatorily_501c17B(o: Person, y: TaxableYear) kind empirical {
    label en official "the plan's benefits are first determined in a nondiscriminatory manner within the meaning of subparagraph (A) (section 501(c)(17)(B))";
}
pub relation sub_benefits_reduced_by_sick_accident_or_unemployment_compensation_501c17Bi(o: Person, y: TaxableYear) kind empirical {
    label en official "the nondiscriminatorily determined benefits are then reduced by sick, accident, or unemployment compensation benefits received under State or Federal law (or reduced by a portion of such benefits if determined in a nondiscriminatory manner) (section 501(c)(17)(B)(i))";
}
pub relation sub_plan_covers_only_employees_ineligible_for_public_benefits_501c17Bii(o: Person, y: TaxableYear) kind empirical {
    label en official "the plan provides only for employees who are not eligible to receive sick, accident, or unemployment compensation benefits under State or Federal law the same benefits (or a portion, if determined in a nondiscriminatory manner) (section 501(c)(17)(B)(ii))";
}
pub relation sub_plan_covers_only_employees_ineligible_under_other_sub_plan_501c17Biii(o: Person, y: TaxableYear) kind empirical {
    label en official "the plan provides only for employees who are not eligible under another plan meeting subparagraph (A) of supplemental unemployment compensation benefits provided wholly by the employer (section 501(c)(17)(B)(iii))";
}
pub relation sub_plan_not_considered_discriminatory_by_coordination_501c17B(o: Person, y: TaxableYear) kind institutional {
    label en official "the plan is not considered discriminatory merely because of one of the section 501(c)(17)(B) coordination features";
}
@source(IRC_S501_C, quote = "(B) In determining whether a plan meets the requirements of subparagraph (A), any benefits provided under any other plan shall not be taken into consideration, except that a plan shall not be considered discriminatory—")
@source(IRC_S501_C, quote = "(i) merely because the benefits under the plan which are first determined in a nondiscriminatory manner within the meaning of subparagraph (A) are then reduced by any sick, accident, or unemployment compensation benefits received under State or Federal law (or reduced by a portion of such benefits if determined in a nondiscriminatory manner), or")
rule SubCoordinationReducedByPublicBenefits(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(17)(B)(i): reduction of nondiscriminatorily determined benefits by public sick, accident or unemployment compensation is not discriminatory";
    when sub_benefits_first_determined_nondiscriminatorily_501c17B(o, y);
    when sub_benefits_reduced_by_sick_accident_or_unemployment_compensation_501c17Bi(o, y);
    then sub_plan_not_considered_discriminatory_by_coordination_501c17B(o, y);
}
@source(IRC_S501_C, quote = "(ii) merely because the plan provides only for employees who are not eligible to receive sick, accident, or unemployment compensation benefits under State or Federal law the same benefits (or a portion of such benefits if determined in a nondiscriminatory manner) which such employees would receive under such laws if such employees were eligible for such benefits, or")
rule SubCoordinationOnlyEmployeesIneligibleForPublicBenefits(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(17)(B)(ii): covering only employees ineligible for the same public benefits is not discriminatory";
    when sub_benefits_first_determined_nondiscriminatorily_501c17B(o, y);
    when sub_plan_covers_only_employees_ineligible_for_public_benefits_501c17Bii(o, y);
    then sub_plan_not_considered_discriminatory_by_coordination_501c17B(o, y);
}
@source(IRC_S501_C, quote = "(iii) merely because the plan provides only for employees who are not eligible under another plan (which meets the requirements of subparagraph (A)) of supplemental unemployment compensation benefits provided wholly by the employer the same benefits (or a portion of such benefits if determined in a nondiscriminatory manner) which such employees would receive under such other plan if such employees were eligible under such other plan, but only if the employees eligible under both plans would make")
rule SubCoordinationOnlyEmployeesIneligibleUnderOtherSubPlan(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(17)(B)(iii): covering only employees ineligible under another qualifying SUB plan provided wholly by the employer is not discriminatory";
    when sub_benefits_first_determined_nondiscriminatorily_501c17B(o, y);
    when sub_plan_covers_only_employees_ineligible_under_other_sub_plan_501c17Biii(o, y);
    then sub_plan_not_considered_discriminatory_by_coordination_501c17B(o, y);
}
@source(IRC_S501_C, quote = "(B) In determining whether a plan meets the requirements of subparagraph (A), any benefits provided under any other plan shall not be taken into consideration, except that a plan shall not be considered discriminatory—")
rule SubBenefitsNondiscriminatoryByCoordination(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(17)(B): a plan that is not considered discriminatory by reason of coordination features satisfies clause (iii)";
    when sub_plan_not_considered_discriminatory_by_coordination_501c17B(o, y);
    then sub_benefits_nondiscriminatory_501c17Aiii(o, y);
}
// (C): the plan meets the requirements for the whole year if it satisfies them on one day in each quarter.
pub relation sub_plan_satisfies_requirements_on_a_day_in_quarter_501c17C(o: Person, y: TaxableYear, quarter: Integer) kind empirical {
    label en official "the plan satisfies the requirements of subparagraph (A) on one day in the given quarter (1 to 4) of the plan year (section 501(c)(17)(C))";
}
pub relation sub_plan_meets_requirements_for_whole_year_501c17C(o: Person, y: TaxableYear) kind institutional {
    label en official "the plan is considered to meet the requirements of subparagraph (A) during the whole of the plan year";
}
@source(IRC_S501_C, quote = "(C) A plan shall be considered to meet the requirements of subparagraph (A) during the whole of any year of the plan if on one day in each quarter it satisfies such requirements.")
rule SubPlanMeetsRequirementsForWholeYear(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(17)(C): satisfying the requirements on one day in each of the four quarters is satisfying them for the whole year";
    when sub_plan_satisfies_requirements_on_a_day_in_quarter_501c17C(o, y, 1);
    when sub_plan_satisfies_requirements_on_a_day_in_quarter_501c17C(o, y, 2);
    when sub_plan_satisfies_requirements_on_a_day_in_quarter_501c17C(o, y, 3);
    when sub_plan_satisfies_requirements_on_a_day_in_quarter_501c17C(o, y, 4);
    then sub_plan_meets_requirements_for_whole_year_501c17C(o, y);
}
// (D): supplemental unemployment compensation benefits.
pub relation benefit_paid_on_involuntary_separation_from_reduction_in_force_or_similar_501c17Di(benefit: Text) kind empirical {
    label en official "the benefit is paid to an employee because of his involuntary separation (whether or not temporary) resulting directly from a reduction in force, the discontinuance of a plant or operation, or other similar conditions (section 501(c)(17)(D)(i))";
}
pub relation sick_or_accident_benefit_subordinate_to_501c17Di_benefits(benefit: Text) kind empirical {
    label en official "the benefit is a sick or accident benefit subordinate to the benefits described in clause (i) (section 501(c)(17)(D)(ii))";
}
pub relation supplemental_unemployment_compensation_benefit_501c17D(benefit: Text) kind institutional {
    label en official "a supplemental unemployment compensation benefit within section 501(c)(17)(D)";
}
@source(IRC_S501_C, quote = "(i) benefits which are paid to an employee because of his involuntary separation from the employment of the employer (whether or not such separation is temporary) resulting directly from a reduction in force, the discontinuance of a plant or operation, or other similar conditions, and")
rule SupplementalUnemploymentBenefitViaInvoluntarySeparation(benefit: Text) defeasible {
    label en official "section 501(c)(17)(D)(i): a benefit paid because of involuntary separation resulting from a reduction in force, discontinuance of a plant or operation, or similar conditions";
    when benefit_paid_on_involuntary_separation_from_reduction_in_force_or_similar_501c17Di(benefit);
    then supplemental_unemployment_compensation_benefit_501c17D(benefit);
}
@source(IRC_S501_C, quote = "(ii) sick and accident benefits subordinate to the benefits described in clause (i).")
rule SupplementalUnemploymentBenefitViaSubordinateSickAccident(benefit: Text) defeasible {
    label en official "section 501(c)(17)(D)(ii): sick and accident benefits subordinate to the clause (i) benefits";
    when sick_or_accident_benefit_subordinate_to_501c17Di_benefits(benefit);
    then supplemental_unemployment_compensation_benefit_501c17D(benefit);
}
// (E): a paragraph (9) association is not denied exemption merely for paying SUB.
pub relation veba_provides_supplemental_unemployment_benefits_501c17E(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization entitled to exemption as an association described in paragraph (9) provides for the payment of supplemental unemployment benefits (as defined in subparagraph (D)(i))";
}
pub relation veba_exemption_not_denied_for_paying_supplemental_unemployment_benefits_501c17E(o: Person, y: TaxableYear) kind institutional {
    label en official "exemption is not denied under subsection (a) to a paragraph (9) association merely because it provides for the payment of supplemental unemployment benefits";
}
@source(IRC_S501_C, quote = "(E) Exemption shall not be denied under subsection (a) to any organization entitled to such exemption as an association described in paragraph (9) of this subsection merely because such organization provides for the payment of supplemental unemployment benefits (as defined in subparagraph (D)(i)).")
rule VebaNotDeniedForSupplementalUnemploymentBenefits(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(17)(E): providing supplemental unemployment benefits does not deny a paragraph (9) association its exemption";
    when section_501c9(o, y);
    when veba_provides_supplemental_unemployment_benefits_501c17E(o, y);
    then veba_exemption_not_denied_for_paying_supplemental_unemployment_benefits_501c17E(o, y);
}
// The decomposed classification.
@source(IRC_S501_C, quote = "(i) under the plan, it is impossible, at any time prior to the satisfaction of all liabilities, with respect to employees under the plan, for any part of the corpus or income to be (within the taxable year or thereafter) used for, or diverted to, any purpose other than the providing of supplemental unemployment compensation benefits,")
@source(IRC_S501_C, quote = "(ii) such benefits are payable to employees under a classification which is set forth in the plan and which is found by the Secretary not to be discriminatory in favor of employees who are highly compensated employees (within the meaning of section 414(q)), and")
@source(IRC_S501_C, quote = "(iii) such benefits do not discriminate in favor of employees who are highly compensated employees (within the meaning of section 414(q)). A plan shall not be considered discriminatory within the meaning of this clause merely because the benefits received under the plan bear a uniform relationship to the total compensation, or the basic or regular rate of compensation, of the employees covered by the plan.")
rule Section501c17ClassificationDecomposed(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(17)(A), decomposed: no diversion possible, a classification set forth in the plan that the Secretary finds nondiscriminatory, benefits that do not discriminate, and the plan meeting the requirements in each quarter";
    when sub_trust_no_diversion_possible(o);
    when sub_classification_set_forth_in_plan_501c17Aii(o);
    when SecretaryFindsSubClassificationNotDiscriminatory501c17Aii(o, y);
    when sub_benefits_nondiscriminatory_501c17Aiii(o, y);
    when sub_plan_meets_requirements_for_whole_year_501c17C(o, y);
    then section_501c17(o, y);
}

// ---------------------------------------------------------------------
// (c)(18)(D): plans under which an employee may designate contributions as deductible.
// ---------------------------------------------------------------------

pub relation plan_permits_employee_designation_of_deductible_contributions_501c18D(o: Person, y: TaxableYear) kind empirical {
    label en official "the plan permits an employee to designate certain contributions as deductible (section 501(c)(18)(D))";
}
pub relation designated_contributions_501c18D(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the contributions the employee designated as deductible for the taxable year";
}
pub relation deduction_limit_under_219b3_501c18D(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount with respect to which a deduction is allowable under section 219(b)(3) — EXTERNAL_DEPENDENCY on the section 219 owner";
}
pub relation requirements_similar_to_401k3Aii_met_501c18Dii(o: Person, y: TaxableYear) kind empirical {
    label en official "requirements similar to section 401(k)(3)(A)(ii) are met with respect to the elective contributions (section 501(c)(18)(D)(ii)) — EXTERNAL_DEPENDENCY on the section 401(k) owner";
}
pub relation contributions_treated_as_elective_deferrals_402g_501c18Diii(o: Person, y: TaxableYear) kind empirical {
    label en official "the contributions are treated as elective deferrals for purposes of section 402(g) (section 501(c)(18)(D)(iii))";
}
pub relation requirements_of_401a30_met_501c18Div(o: Person, y: TaxableYear) kind empirical {
    label en official "the requirements of section 401(a)(30) are met (section 501(c)(18)(D)(iv))";
}
pub relation c18_designated_contributions_within_219b3_limit_501c18Di(o: Person, y: TaxableYear) kind institutional {
    label en official "the designated contributions do not exceed the amount with respect to which a deduction is allowable under section 219(b)(3)";
}
@source(IRC_S501_C, quote = "(i) such contributions do not exceed the amount with respect to which a deduction is allowable under section 219(b)(3),")
rule C18DesignatedContributionsWithinLimit(o: Person, y: TaxableYear, designated: Money, limit: Money) defeasible {
    label en official "section 501(c)(18)(D)(i): designated contributions <= the section 219(b)(3) amount — exact, at the limit passes";
    when designated_contributions_501c18D(o, y, designated);
    when deduction_limit_under_219b3_501c18D(o, y, limit);
    when designated <= limit;
    then c18_designated_contributions_within_219b3_limit_501c18Di(o, y);
}
pub relation c18_designation_requirements_met_501c18D(o: Person, y: TaxableYear) kind institutional {
    label en official "all four requirements of section 501(c)(18)(D)(i)-(iv) are met";
}
@source(IRC_S501_C, quote = "(D) in the case of a plan under which an employee may designate certain contributions as deductible—")
rule C18DesignationRequirementsMet(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(18)(D): the limit, the 401(k)(3)(A)(ii)-similar requirements, elective-deferral treatment and the 401(a)(30) requirements are all met";
    when c18_designated_contributions_within_219b3_limit_501c18Di(o, y);
    when requirements_similar_to_401k3Aii_met_501c18Dii(o, y);
    when contributions_treated_as_elective_deferrals_402g_501c18Diii(o, y);
    when requirements_of_401a30_met_501c18Div(o, y);
    then c18_designation_requirements_met_501c18D(o, y);
}
pub relation c18_designation_requirements_unmet_501c18D(o: Person, y: TaxableYear) kind institutional {
    label en official "the plan permits designation of deductible contributions but the section 501(c)(18)(D) requirements are not established as met (a missing fact blocks the classification)";
}
@source(IRC_S501_C, quote = "(D) in the case of a plan under which an employee may designate certain contributions as deductible—")
rule C18DesignationRequirementsUnmet(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(18)(D): in the case of a plan permitting designation, the (D) requirements must be met";
    when plan_permits_employee_designation_of_deductible_contributions_501c18D(o, y);
    unless c18_designation_requirements_met_501c18D(o, y);
    then c18_designation_requirements_unmet_501c18D(o, y);
}
@source(IRC_S501_C, quote = "(A) under the plan, it is impossible, at any time prior to the satisfaction of all liabilities with respect to employees under the plan, for any part of the corpus or income to be (within the taxable year or thereafter) used for, or diverted to, any purpose other than the providing of benefits under the plan,")
@source(IRC_S501_C, quote = "(B) such benefits are payable to employees under a classification which is set forth in the plan and which is found by the Secretary not to be discriminatory in favor of employees who are highly compensated employees (within the meaning of section 414(q)),")
@source(IRC_S501_C, quote = "(C) such benefits do not discriminate in favor of employees who are highly compensated employees (within the meaning of section 414(q)). A plan shall not be considered discriminatory within the meaning of this subparagraph merely because the benefits received under the plan bear a uniform relationship to the total compensation, or the basic or regular rate of compensation, of the employees covered by the plan, and")
rule Section501c18ClassificationWithDesignationGuard(o: Person, y: TaxableYear, created_on: Date) defeasible {
    label en official "section 501(c)(18)(A)-(D): a pre-June 25, 1959 employee-funded pension trust meeting (A)-(C), and (D) where the plan permits designation of deductible contributions";
    when trust_created_before_date(o, created_on);
    when created_on < @1959-06-25;
    when pension_trust_funded_only_by_employee_contributions(o);
    when c18_trust_no_diversion_possible(o);
    when C18BenefitClassificationNondiscriminatory(o, y);
    unless c18_designation_requirements_unmet_501c18D(o, y);
    then section_501c18(o, y);
}

// ---------------------------------------------------------------------
// (c)(21): Black Lung Acts trusts.
// ---------------------------------------------------------------------

pub enum BlackLungTrustPurpose { SatisfyBlackLungLiability, PayPremiumsForInsuranceCoveringThatLiability, PayAdministrativeAndIncidentalExpenses, PayRetiredMinerHealthBenefitsOrPremiums, AnyOtherPurpose }
pub enum BlackLungAssetUse { ListedPurpose, QualifiedInvestmentNotCurrentlyNeeded, PaymentIntoBlackLungDisabilityTrustFund, PaymentIntoGeneralFundNotSatisfyingLiability, PaymentIntoGeneralFundInSatisfactionOfLiability, AnyOtherUse }
@source(IRC_S501_C, quote = "(i) the purpose of such trust or trusts is exclusively—")
pub relation black_lung_trust_declared_purpose_501c21Ai(o: Person, purpose: BlackLungTrustPurpose) kind empirical {
    label en official "a purpose of the trust: to satisfy liability for Black Lung Acts claims (I), to pay premiums for insurance exclusively covering that liability (II), to pay administrative and incidental expenses (III), or to pay accident or health benefits for retired miners and their spouses and dependents or premiums for insurance exclusively covering such benefits (IV)";
}
@source(IRC_S501_C, quote = "(ii) no part of the assets of the trust may be used for, or diverted to, any purpose other than—")
pub relation black_lung_trust_asset_use_501c21Aii(o: Person, y: TaxableYear, use: BlackLungAssetUse) kind empirical {
    label en official "a use of the trust's assets in the taxable year: the listed purposes (I), investment in qualified investments of assets not currently needed (II), payment into the Black Lung Disability Trust Fund or into the general fund of the Treasury other than in satisfaction of tax or other liability of the person (III)";
}
pub relation black_lung_trust_has_unlisted_purpose_501c21Ai(o: Person, y: TaxableYear) kind institutional {
    label en official "the trust has a purpose outside those exclusively permitted by section 501(c)(21)(A)(i)";
}
rule BlackLungUnlistedPurpose(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(21)(A)(i): a purpose other than the four listed is a breach of exclusivity";
    when black_lung_trust_declared_purpose_501c21Ai(o, BlackLungTrustPurpose.AnyOtherPurpose);
    when us.irc.core::year_of(o, y);
    then black_lung_trust_has_unlisted_purpose_501c21Ai(o, y);
}
pub relation black_lung_trust_diverts_assets_501c21Aii(o: Person, y: TaxableYear) kind institutional {
    label en official "some part of the trust's assets is used for, or diverted to, a purpose other than the section 501(c)(21)(A)(ii) list — including a payment into the general fund in satisfaction of a tax or other civil or criminal liability of the person";
}
@source(IRC_S501_C, quote = "(ii) no part of the assets of the trust may be used for, or diverted to, any purpose other than—")
@source(IRC_S501_C, quote = "(III) payment into the Black Lung Disability Trust Fund established under section 9501, or into the general fund of the United States Treasury (other than in satisfaction of any tax or other civil or criminal liability of the person who established or contributed to the trust).")
rule BlackLungAssetsDiverted(o: Person, y: TaxableYear, use: BlackLungAssetUse) defeasible {
    label en official "section 501(c)(21)(A)(ii): a use outside the list, or a general-fund payment satisfying a liability, is a diversion";
    when black_lung_trust_asset_use_501c21Aii(o, y, use);
    when use == BlackLungAssetUse.AnyOtherUse;
    then black_lung_trust_diverts_assets_501c21Aii(o, y);
}
@source(IRC_S501_C, quote = "(III) payment into the Black Lung Disability Trust Fund established under section 9501, or into the general fund of the United States Treasury (other than in satisfaction of any tax or other civil or criminal liability of the person who established or contributed to the trust).")
rule BlackLungAssetsDivertedByLiabilityPayment(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(21)(A)(ii)(III): paying the general fund in satisfaction of any tax or other liability of the person is not a permitted use";
    when black_lung_trust_asset_use_501c21Aii(o, y, BlackLungAssetUse.PaymentIntoGeneralFundInSatisfactionOfLiability);
    then black_lung_trust_diverts_assets_501c21Aii(o, y);
}
// (B), (C): retiree health benefit payments.
pub relation retiree_health_benefit_payments_501c21C(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "payments described in subparagraph (A)(i)(IV) made from the trust during the taxable year";
}
pub relation trust_asset_fair_market_value_at_close_of_prior_year_501c21C(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the fair market value of the trust's assets as of the close of the preceding taxable year (section 501(c)(21)(C)(i)), determined by an independent actuary using reasonable methods and assumptions";
}
pub relation present_value_of_black_lung_liability_at_close_of_prior_year_501c21C(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the present value of the person's liability described in subparagraph (A)(i)(I) as of the close of the preceding taxable year, as determined by an independent actuary (section 501(c)(21)(C)(ii))";
}
pub relation retiree_benefit_payments_within_funding_limit_501c21C(o: Person, y: TaxableYear) kind institutional {
    label en official "the payments during the taxable year do not exceed the excess, as of the close of the preceding year, of the trust's asset value over 110 percent of the present value of the liability";
}
@source(IRC_S501_C, quote = "(C) Payments described in subparagraph (A)(i)(IV) may be made from such trust during a taxable year only to the extent that the aggregate amount of such payments during such taxable year does not exceed the excess (if any), as of the close of the preceding taxable year, of—")
@source(IRC_S501_C, quote = "(i) the fair market value of the assets of the trust, over")
@source(IRC_S501_C, quote = "(ii) 110 percent of the present value of the liability described in subparagraph (A)(i)(I) of such person.")
rule RetireeBenefitPaymentsWithinFundingLimit(o: Person, y: TaxableYear, paid: Money, assets: Money, pv: Money) defeasible {
    label en official "section 501(c)(21)(C): payments <= (asset value - 110 percent of the present value of the liability) — exact decimal arithmetic, payments equal to the excess pass";
    when retiree_health_benefit_payments_501c21C(o, y, paid);
    when trust_asset_fair_market_value_at_close_of_prior_year_501c21C(o, y, assets);
    when present_value_of_black_lung_liability_at_close_of_prior_year_501c21C(o, y, pv);
    when assets > pv * 1.10;
    when paid <= assets - pv * 1.10;
    then retiree_benefit_payments_within_funding_limit_501c21C(o, y);
}
pub relation retiree_benefit_payments_exceed_funding_limit_501c21C(o: Person, y: TaxableYear) kind institutional {
    label en official "payments described in (A)(i)(IV) exceed the section 501(c)(21)(C) funding limit (or no excess exists), a breach of the condition on those payments";
}
@source(IRC_S501_C, quote = "(C) Payments described in subparagraph (A)(i)(IV) may be made from such trust during a taxable year only to the extent that the aggregate amount of such payments during such taxable year does not exceed the excess (if any), as of the close of the preceding taxable year, of—")
rule RetireeBenefitPaymentsExceedFundingLimit(o: Person, y: TaxableYear, paid: Money) defeasible {
    label en official "section 501(c)(21)(C): payments beyond the funding limit are not permitted";
    when retiree_health_benefit_payments_501c21C(o, y, paid);
    when paid > 0.00 USD;
    unless retiree_benefit_payments_within_funding_limit_501c21C(o, y);
    then retiree_benefit_payments_exceed_funding_limit_501c21C(o, y);
}
pub relation deduction_disallowed_for_retiree_health_payments_from_black_lung_trust_501c21B(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "no deduction is allowed under this chapter for a payment described in subparagraph (A)(i)(IV) from the trust";
}
@source(IRC_S501_C, quote = "(B) No deduction shall be allowed under this chapter for any payment described in subparagraph (A)(i)(IV) from such trust.")
rule NoDeductionForRetireeHealthPayments(o: Person, y: TaxableYear, paid: Money) defeasible {
    label en official "section 501(c)(21)(B): the deduction for retiree health benefit payments from the trust is disallowed";
    when retiree_health_benefit_payments_501c21C(o, y, paid);
    then deduction_disallowed_for_retiree_health_payments_from_black_lung_trust_501c21B(o, y, paid);
}
// (D): definitions.
pub enum QualifiedInvestmentKind501c21Dii { UnitedStatesPublicDebtSecurity, StateOrLocalObligationNotInDefault, BankOrCreditUnionDeposit }
pub relation investment_kind_501c21Dii(inv: Text, kind: QualifiedInvestmentKind501c21Dii) kind empirical {
    label en official "the investment is a public debt security of the United States (I), an obligation of a State or local government not in default as to principal or interest (II), or a time or demand deposit in a bank or insured credit union located in the United States (III)";
}
pub relation qualified_investment_501c21Dii(inv: Text) kind institutional {
    label en official "a qualified investment within section 501(c)(21)(D)(ii)";
}
@source(IRC_S501_C, quote = "(ii) The term \"qualified investments\" means—")
@source(IRC_S501_C, quote = "(I) public debt securities of the United States,")
@source(IRC_S501_C, quote = "(II) obligations of a State or local government which are not in default as to principal or interest, and")
@source(IRC_S501_C, quote = "(III) time or demand deposits in a bank (as defined in section 581) or an insured credit union (within the meaning of section 101(7) of the Federal Credit Union Act, 12 U.S.C. 1752(7)) located in the United States.")
rule QualifiedInvestmentDefinition(inv: Text, k: QualifiedInvestmentKind501c21Dii) defeasible {
    label en official "section 501(c)(21)(D)(ii): the three kinds of qualified investment";
    when investment_kind_501c21Dii(inv, k);
    then qualified_investment_501c21Dii(inv);
}
pub enum IncidentalExpenseKind501c21Div { Legal, Accounting, Actuarial, Trustee }
pub relation expense_kind_501c21Div(expense: Text, kind: IncidentalExpenseKind501c21Div) kind empirical {
    label en official "the expense is a legal, accounting, actuarial, or trustee expense";
}
pub relation incidental_expense_501c21Div(expense: Text) kind institutional {
    label en official "an incidental expense within section 501(c)(21)(D)(iv): the term includes legal, accounting, actuarial, and trustee expenses";
}
@source(IRC_S501_C, quote = "(iv) The term \"incidental expenses\" includes legal, accounting, actuarial, and trustee expenses.")
rule IncidentalExpenseIncludesListedKinds(expense: Text, k: IncidentalExpenseKind501c21Div) defeasible {
    label en official "section 501(c)(21)(D)(iv): legal, accounting, actuarial and trustee expenses are incidental expenses";
    when expense_kind_501c21Div(expense, k);
    then incidental_expense_501c21Div(expense);
}
pub relation black_lung_trust_conditions_met_501c21(o: Person, y: TaxableYear) kind institutional {
    label en official "the Black Lung trust meets the (A) purpose and asset-use conditions and the (C) payment limit";
}
@source(IRC_S501_C, quote = "(i) the purpose of such trust or trusts is exclusively—")
@source(IRC_S501_C, quote = "(ii) no part of the assets of the trust may be used for, or diverted to, any purpose other than—")
rule Section501c21ClassificationDecomposed(o: Person, y: TaxableYear, purpose: BlackLungTrustPurpose) defeasible {
    label en official "section 501(c)(21)(A), decomposed: a trust established in writing in the United States, having at least one listed purpose and no unlisted purpose, no diversion of assets, and retiree health payments within the funding limit";
    when black_lung_trust_established_in_writing_in_us(o);
    when us.irc.core::year_of(o, y);
    when black_lung_trust_declared_purpose_501c21Ai(o, purpose);
    when purpose != BlackLungTrustPurpose.AnyOtherPurpose;
    unless black_lung_trust_has_unlisted_purpose_501c21Ai(o, y);
    unless black_lung_trust_diverts_assets_501c21Aii(o, y);
    unless retiree_benefit_payments_exceed_funding_limit_501c21C(o, y);
    then section_501c21(o, y);
}

// ---------------------------------------------------------------------
// (c)(22): multiemployer plan withdrawal-liability trusts.
// ---------------------------------------------------------------------

pub enum MultiemployerTrustPurpose501c22A { PayErisa4223cOr4223hAmount, PayReasonableAndNecessaryAdministrativeExpenses, AnyOtherPurpose }
pub relation multiemployer_trust_declared_purpose_501c22A(o: Person, purpose: MultiemployerTrustPurpose501c22A) kind empirical {
    label en official "a purpose of the trust: to pay an amount described in section 4223(c) or (h) of ERISA (i), or reasonable and necessary administrative expenses in connection with establishing and operating the trust and processing claims against it (ii)";
}
pub enum MultiemployerTrustAssetUse501c22B { ListedPurpose, InvestmentInSecuritiesObligationsOrDepositsOfSection501c21Dii, AnyOtherUse }
pub relation multiemployer_trust_asset_use_501c22B(o: Person, y: TaxableYear, use: MultiemployerTrustAssetUse501c22B) kind empirical {
    label en official "a use of the trust's assets: the (A) purposes (i), or investment in securities, obligations or time or demand deposits described in paragraph (21)(D)(ii) (ii)";
}
pub relation multiemployer_trust_meets_erisa_4223_requirements_501c22C(o: Person, y: TaxableYear) kind empirical {
    label en official "the trust meets the requirements of paragraphs (2), (3) and (4) of section 4223(b), 4223(h), or if applicable section 4223(c) of ERISA (section 501(c)(22)(C)) — EXTERNAL_DEPENDENCY on ERISA, no us.irc.* owner";
}
pub relation multiemployer_trust_instrument_limits_dissolution_payments_501c22D(o: Person) kind empirical {
    label en official "the trust instrument provides that, on dissolution, assets may be paid only to plans which have participated in the plan (or, for a section 4223(h) trust, to plans with respect to which employers have participated in the fund) (section 501(c)(22)(D))";
}
pub relation multiemployer_trust_has_unlisted_purpose_501c22A(o: Person, y: TaxableYear) kind institutional {
    label en official "the trust has a purpose outside section 501(c)(22)(A)";
}
@source(IRC_S501_C, quote = "(A) the purpose of such trust is exclusively—")
rule MultiemployerTrustUnlistedPurpose(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(22)(A): a purpose other than the two listed is a breach of exclusivity";
    when multiemployer_trust_declared_purpose_501c22A(o, MultiemployerTrustPurpose501c22A.AnyOtherPurpose);
    when us.irc.core::year_of(o, y);
    then multiemployer_trust_has_unlisted_purpose_501c22A(o, y);
}
pub relation multiemployer_trust_diverts_assets_501c22B(o: Person, y: TaxableYear) kind institutional {
    label en official "some part of the trust's assets is used for, or diverted to, a purpose other than those in section 501(c)(22)(B)";
}
@source(IRC_S501_C, quote = "(B) no part of the assets of the trust may be used for, or diverted to, any purpose other than—")
rule MultiemployerTrustAssetsDiverted(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(22)(B): a use outside the (A) purposes and the qualified investments is a diversion";
    when multiemployer_trust_asset_use_501c22B(o, y, MultiemployerTrustAssetUse501c22B.AnyOtherUse);
    then multiemployer_trust_diverts_assets_501c22B(o, y);
}
@source(IRC_S501_C, quote = "(A) the purpose of such trust is exclusively—")
@source(IRC_S501_C, quote = "(C) such trust meets the requirements of paragraphs (2), (3), and (4) of section 4223(b), 4223(h), or, if applicable, section 4223(c) of the Employee Retirement Income Security Act of 1974, and")
@source(IRC_S501_C, quote = "(D) the trust instrument provides that, on dissolution of the trust, assets of the trust may not be paid other than to plans which have participated in the plan or, in the case of a trust established under section 4223(h) of such Act, to plans with respect to which employers have participated in the fund.")
rule Section501c22ClassificationDecomposed(o: Person, y: TaxableYear, purpose: MultiemployerTrustPurpose501c22A) defeasible {
    label en official "section 501(c)(22)(A)-(D), decomposed: established in writing, a listed purpose and no unlisted one, no diversion, ERISA 4223 requirements met, and the dissolution restriction in the trust instrument";
    when multiemployer_plan_sponsor_trust_established_in_writing(o, y);
    when multiemployer_trust_declared_purpose_501c22A(o, purpose);
    when purpose != MultiemployerTrustPurpose501c22A.AnyOtherPurpose;
    unless multiemployer_trust_has_unlisted_purpose_501c22A(o, y);
    unless multiemployer_trust_diverts_assets_501c22B(o, y);
    when multiemployer_trust_meets_erisa_4223_requirements_501c22C(o, y);
    when multiemployer_trust_instrument_limits_dissolution_payments_501c22D(o);
    then section_501c22(o, y);
}

// ---------------------------------------------------------------------
// (c)(25): title-holding corporations and trusts for several exempt organizations.
// ---------------------------------------------------------------------

pub enum Section501c25COrganizationKind { QualifiedPensionProfitSharingOrStockBonusPlan401a, GovernmentalPlan414d, UnitedStatesStateOrPoliticalSubdivision, OrganizationDescribedInParagraph3 }
pub relation is_section_501c25C_kind(holder: Person, kind: Section501c25COrganizationKind) kind empirical {
    label en official "the holder is a qualified plan under section 401(a), a governmental plan under section 414(d), the United States or a State or political subdivision or their agency or instrumentality, or an organization described in paragraph (3)";
}
pub relation is_501c25C_organization(holder: Person) kind institutional {
    label en official "the holder is an organization described in section 501(c)(25)(C)";
}
@source(IRC_S501_C, quote = "(C) An organization is described in this subparagraph if such organization is—")
@source(IRC_S501_C, quote = "(i) a qualified pension, profit sharing, or stock bonus plan that meets the requirements of section 401(a),")
@source(IRC_S501_C, quote = "(ii) a governmental plan (within the meaning of section 414(d)),")
@source(IRC_S501_C, quote = "(iii) the United States, any State or political subdivision thereof, or any agency or instrumentality of any of the foregoing, or")
@source(IRC_S501_C, quote = "(iv) any organization described in paragraph (3).")
rule Is501c25COrganization(holder: Person, k: Section501c25COrganizationKind) defeasible {
    label en official "section 501(c)(25)(C)(i)-(iv): the four kinds of permitted shareholder or beneficiary";
    when is_section_501c25C_kind(holder, k);
    then is_501c25C_organization(holder);
}
pub relation dismiss_investment_adviser_on_majority_vote_after_reasonable_notice_501c25Di(o: Person) kind empirical {
    label en official "the corporation or trust permits its shareholders or beneficiaries to dismiss its investment adviser, following reasonable notice, upon a vote of holders of a majority of the interest (section 501(c)(25)(D)(i))";
}
pub relation holders_may_sell_to_501c25C_organization_without_exceeding_35_501c25DiiI(o: Person) kind empirical {
    label en official "the holders may terminate their interest by selling or exchanging it to a subparagraph (C) organization so long as the sale does not raise the number of shareholders or beneficiaries above 35 (section 501(c)(25)(D)(ii)(I))";
}
pub relation holders_may_redeem_on_90_days_notice_501c25DiiII(o: Person) kind empirical {
    label en official "the holders may terminate their interest by having it redeemed after 90 days' notice to the corporation or trust (section 501(c)(25)(D)(ii)(II))";
}
pub relation holders_may_terminate_interest_501c25Dii(o: Person) kind institutional {
    label en official "the shareholders or beneficiaries may terminate their interest by either or both of the alternatives in clause (ii)";
}
@source(IRC_S501_C, quote = "(I) by selling or exchanging their stock in the corporation or interest in the trust (subject to any Federal or State securities law) to any organization described in subparagraph (C) so long as the sale or exchange does not increase the number of shareholders or beneficiaries in such corporation or trust above 35, or")
rule HoldersMayTerminateInterestBySale(o: Person) defeasible {
    label en official "section 501(c)(25)(D)(ii)(I): termination by sale or exchange to a subparagraph (C) organization within the 35-holder ceiling";
    when holders_may_sell_to_501c25C_organization_without_exceeding_35_501c25DiiI(o);
    then holders_may_terminate_interest_501c25Dii(o);
}
@source(IRC_S501_C, quote = "(II) by having their stock or interest redeemed by the corporation or trust after the shareholder or beneficiary has provided 90 days notice to such corporation or trust.")
rule HoldersMayTerminateInterestByRedemption(o: Person) defeasible {
    label en official "section 501(c)(25)(D)(ii)(II): termination by redemption after 90 days' notice";
    when holders_may_redeem_on_90_days_notice_501c25DiiII(o);
    then holders_may_terminate_interest_501c25Dii(o);
}
pub relation shareholder_rights_requirements_met_501c25D(o: Person) kind institutional {
    label en official "the corporation or trust permits its holders both to dismiss the investment adviser and to terminate their interest (section 501(c)(25)(D))";
}
@source(IRC_S501_C, quote = "(D) A corporation or trust shall in no event be treated as described in subparagraph (A) unless such corporation or trust permits its shareholders or beneficiaries—")
@source(IRC_S501_C, quote = "(i) to dismiss the corporation's or trust's investment adviser, following reasonable notice, upon a vote of the shareholders or beneficiaries holding a majority of interest in the corporation or trust, and")
@source(IRC_S501_C, quote = "(ii) to terminate their interest in the corporation or trust by either, or both, of the following alternatives, as determined by the corporation or trust:")
rule ShareholderRightsRequirementsMet(o: Person) defeasible {
    label en official "section 501(c)(25)(D): a corporation or trust is in no event described in (A) unless it permits both rights";
    when dismiss_investment_adviser_on_majority_vote_after_reasonable_notice_501c25Di(o);
    when holders_may_terminate_interest_501c25Dii(o);
    then shareholder_rights_requirements_met_501c25D(o);
}
// (E): qualified subsidiary.
pub relation subsidiary_stock_held_100_percent_by_parent_at_all_times_501c25Eii(sub: Person, parent: Person) kind empirical {
    label en official "at all times during the period the corporation was in existence, 100 percent of its stock is held by the corporation or trust described in subparagraph (A)";
}
pub relation qualified_subsidiary_501c25Eii(sub: Person, parent: Person) kind institutional {
    label en official "the corporation is a qualified subsidiary of the corporation or trust described in subparagraph (A)";
}
@source(IRC_S501_C, quote = "(ii) For purposes of this subparagraph, the term \"qualified subsidiary\" means any corporation if, at all times during the period such corporation was in existence, 100 percent of the stock of such corporation is held by the corporation or trust described in subparagraph (A).")
rule QualifiedSubsidiaryDefinition(sub: Person, parent: Person) defeasible {
    label en official "section 501(c)(25)(E)(ii): a corporation wholly owned at all times by the subparagraph (A) corporation or trust";
    when subsidiary_stock_held_100_percent_by_parent_at_all_times_501c25Eii(sub, parent);
    when section_501c25_holding_entity_501c25(parent);
    then qualified_subsidiary_501c25Eii(sub, parent);
}
pub relation section_501c25_holding_entity_501c25(parent: Person) kind empirical {
    label en official "the parent is a corporation or trust described in section 501(c)(25)(A)";
}
pub relation qualified_subsidiary_not_a_separate_corporation_501c25Ei(sub: Person, parent: Person) kind institutional {
    label en official "for purposes of the title, a qualified subsidiary is not treated as a separate corporation and all its assets, liabilities and items of income, deduction and credit are those of the parent";
}
@source(IRC_S501_C, quote = "(E)(i) For purposes of this title—")
@source(IRC_S501_C, quote = "(I) a corporation which is a qualified subsidiary shall not be treated as a separate corporation, and")
@source(IRC_S501_C, quote = "(II) all assets, liabilities, and items of income, deduction, and credit of a qualified subsidiary shall be treated as assets, liabilities, and such items (as the case may be) of the corporation or trust described in subparagraph (A).")
rule QualifiedSubsidiaryTreatedAsPartOfParent(sub: Person, parent: Person) defeasible {
    label en official "section 501(c)(25)(E)(i): a qualified subsidiary is not a separate corporation";
    when qualified_subsidiary_501c25Eii(sub, parent);
    then qualified_subsidiary_not_a_separate_corporation_501c25Ei(sub, parent);
}
pub relation formerly_qualified_subsidiary_ceased_to_meet_definition_501c25Eiii(sub: Person, parent: Person) kind empirical {
    label en official "a corporation which was a qualified subsidiary ceases to meet the section 501(c)(25)(E)(ii) requirements";
}
pub relation ceased_subsidiary_treated_as_new_corporation_acquiring_assets_for_stock_501c25Eiii(sub: Person, parent: Person) kind institutional {
    label en official "the corporation is treated as a new corporation acquiring all its assets (and assuming all its liabilities) immediately before the cessation from the parent in exchange for its stock";
}
@source(IRC_S501_C, quote = "(iii) For purposes of this subtitle, if any corporation which was a qualified subsidiary ceases to meet the requirements of clause (ii), such corporation shall be treated as a new corporation acquiring all of its assets (and assuming all of its liabilities) immediately before such cessation from the corporation or trust described in subparagraph (A) in exchange for its stock.")
rule CeasedSubsidiaryTreatedAsNewCorporation(sub: Person, parent: Person) defeasible {
    label en official "section 501(c)(25)(E)(iii): cessation makes the subsidiary a new corporation acquiring its assets from the parent in exchange for stock";
    when formerly_qualified_subsidiary_ceased_to_meet_definition_501c25Eiii(sub, parent);
    then ceased_subsidiary_treated_as_new_corporation_acquiring_assets_for_stock_501c25Eiii(sub, parent);
}
// (F): personal property leased with real property counts as real property up to 15 percent of the rent.
pub relation rent_attributable_to_personal_property_501c25F(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the rent for the taxable year attributable to personal property leased in connection with a lease of real property, determined under section 856(d)(1)";
}
pub relation total_rent_under_lease_501c25F(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the total rent for the taxable year attributable to both the real and the personal property leased under, or in connection with, the lease";
}
pub relation leased_personal_property_counts_as_real_property_501c25F(o: Person, y: TaxableYear) kind institutional {
    label en official "the leased personal property is included in 'real property' for subparagraph (A)";
}
@source(IRC_S501_C, quote = "(F) For purposes of subparagraph (A), the term \"real property\" includes any personal property which is leased under, or in connection with, a lease of real property, but only if the rent attributable to such personal property (determined under the rules of section 856(d)(1)) for the taxable year does not exceed 15 percent of the total rent for the taxable year attributable to both the real and personal property leased under, or in connection with, such lease.")
rule LeasedPersonalPropertyCountsAsRealProperty(o: Person, y: TaxableYear, personal: Money, total: Money) defeasible {
    label en official "section 501(c)(25)(F): 100 * rent attributable to personal property <= 15 * total rent — exact cross-multiplication, exactly 15 percent qualifies";
    when rent_attributable_to_personal_property_501c25F(o, y, personal);
    when total_rent_under_lease_501c25F(o, y, total);
    when personal * 100 <= total * 15;
    then leased_personal_property_counts_as_real_property_501c25F(o, y);
}
// (G): incidental income.
pub relation otherwise_disqualifying_income_incidentally_derived_from_holding_real_property_501c25Gi(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the otherwise disqualifying income incidentally derived from the holding of real property (section 501(c)(25)(G)(i))";
}
pub relation gross_income_of_holding_entity_501c25G(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the organization's gross income for the taxable year";
}
pub external judgment relation IncomeInadvertentAndReasonableStepsBeingTakenToCorrect501c25Gii(o: Person, y: TaxableYear) {
    authority Secretary;
    label en official "the organization establishes to the satisfaction of the Secretary that the receipt of the excess disqualifying income was inadvertent and reasonable steps are being taken to correct the circumstances (section 501(c)(25)(G)(ii)) — DECISION-0194 evaluative channel";
}
pub relation incidental_income_does_not_defeat_501c25_status_501c25G(o: Person, y: TaxableYear) kind institutional {
    label en official "the receipt of disqualifying income does not cause the organization to fail to be described in paragraph (25)";
}
@source(IRC_S501_C, quote = "(G)(i) An organization shall not be treated as failing to be described in this paragraph merely by reason of the receipt of any otherwise disqualifying income which is incidentally derived from the holding of real property.")
@source(IRC_S501_C, quote = "(ii) Clause (i) shall not apply if the amount of gross income described in such clause exceeds 10 percent of the organization's gross income for the taxable year unless the organization establishes to the satisfaction of the Secretary that the receipt of gross income described in clause (i) in excess of such limitation was inadvertent and reasonable steps are being taken to correct the circumstances giving rise to such income.")
rule IncidentalIncomeWithinTenPercent(o: Person, y: TaxableYear, income: Money, gross: Money) defeasible {
    label en official "section 501(c)(25)(G): incidental disqualifying income not more than 10 percent of gross income (100 * income <= 10 * gross, exactly 10 percent qualifies) does not defeat status";
    when otherwise_disqualifying_income_incidentally_derived_from_holding_real_property_501c25Gi(o, y, income);
    when gross_income_of_holding_entity_501c25G(o, y, gross);
    when income * 100 <= gross * 10;
    then incidental_income_does_not_defeat_501c25_status_501c25G(o, y);
}
@source(IRC_S501_C, quote = "(ii) Clause (i) shall not apply if the amount of gross income described in such clause exceeds 10 percent of the organization's gross income for the taxable year unless the organization establishes to the satisfaction of the Secretary that the receipt of gross income described in clause (i) in excess of such limitation was inadvertent and reasonable steps are being taken to correct the circumstances giving rise to such income.")
rule IncidentalIncomeAboveTenPercentInadvertent(o: Person, y: TaxableYear, income: Money, gross: Money) defeasible {
    label en official "section 501(c)(25)(G)(ii): income above 10 percent still does not defeat status when the Secretary is satisfied that it was inadvertent and reasonable steps are being taken to correct";
    when otherwise_disqualifying_income_incidentally_derived_from_holding_real_property_501c25Gi(o, y, income);
    when gross_income_of_holding_entity_501c25G(o, y, gross);
    when income * 100 > gross * 10;
    when IncomeInadvertentAndReasonableStepsBeingTakenToCorrect501c25Gii(o, y);
    then incidental_income_does_not_defeat_501c25_status_501c25G(o, y);
}
pub relation received_otherwise_disqualifying_income_501c25(o: Person, y: TaxableYear) kind institutional {
    label en official "the organization received income that would disqualify it from being described in paragraph (25) but for subparagraph (G)";
}
rule ReceivedDisqualifyingIncome(o: Person, y: TaxableYear, income: Money) defeasible {
    label en official "helper: the organization received otherwise disqualifying income";
    when otherwise_disqualifying_income_incidentally_derived_from_holding_real_property_501c25Gi(o, y, income);
    then received_otherwise_disqualifying_income_501c25(o, y);
}
pub relation disqualifying_income_not_saved_by_subparagraph_G_501c25(o: Person, y: TaxableYear) kind institutional {
    label en official "the organization received disqualifying income that subparagraph (G) does not save";
}
rule DisqualifyingIncomeNotSaved(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(25)(G): disqualifying income not saved by the incidental-income rule defeats the classification";
    when received_otherwise_disqualifying_income_501c25(o, y);
    unless incidental_income_does_not_defeat_501c25_status_501c25G(o, y);
    then disqualifying_income_not_saved_by_subparagraph_G_501c25(o, y);
}
@source(IRC_S501_C, quote = "(25)(A) Any corporation or trust which—")
@source(IRC_S501_C, quote = "(ii) has only 1 class of stock or beneficial interest, and")
@source(IRC_S501_C, quote = "(iii) is organized for the exclusive purposes of—")
rule Section501c25ClassificationDecomposed(o: Person, y: TaxableYear, count: Decimal) defeasible {
    label en official "section 501(c)(25)(A)-(D), (G), decomposed: at most 35 holders, one class of interest, exclusive real-property title-holding purposes, the holder rights of (D), and no disqualifying income that (G) does not save";
    when shareholder_or_beneficiary_count_501c25(o, y, count);
    when count <= 35.0;
    when has_only_one_class_of_stock_or_interest(o);
    when organized_exclusively_for_real_property_title_holding_multi(o);
    when shareholder_rights_requirements_met_501c25D(o);
    unless disqualifying_income_not_saved_by_subparagraph_G_501c25(o, y);
    then section_501c25(o, y);
}

// ---------------------------------------------------------------------
// (c)(26): State high-risk pool membership organizations.
// ---------------------------------------------------------------------

pub relation individual_receives_coverage_through_501c26_organization(org: Person, individual: Person, y: TaxableYear) kind empirical {
    label en official "the individual receives coverage through the organization in the taxable year";
}
pub relation individual_resident_of_state_501c26Bi(individual: Person) kind empirical {
    label en official "the individual is a resident of the State (section 501(c)(26)(B)(i))";
}
pub relation individual_unable_to_acquire_coverage_for_medical_condition_501c26BiiI(individual: Person) kind empirical {
    label en official "by reason of the existence or history of a medical condition the individual is unable to acquire medical care coverage through insurance or from a health maintenance organization (section 501(c)(26)(B)(ii)(I))";
}
pub external judgment relation CoverageRateSubstantiallyInExcess501c26BiiII(individual: Person) {
    authority Secretary;
    label en official "the individual is able to acquire such coverage only at a rate substantially in excess of the rate for such coverage through the membership organization (section 501(c)(26)(B)(ii)(II)) — DECISION-0194 evaluative channel";
}
pub relation spouse_or_qualifying_child_of_eligible_individual_501c26(individual: Person, eligible: Person) kind empirical {
    label en official "the individual is a spouse or qualifying child (section 24(c)) of an individual described in subparagraph (B)";
}
pub relation individual_directly_described_in_501c26B(individual: Person) kind institutional {
    label en official "the individual is described in section 501(c)(26)(B) without regard to the last sentence";
}
@source(IRC_S501_C, quote = "(i) who are residents of such State, and")
@source(IRC_S501_C, quote = "(ii) who, by reason of the existence or history of a medical condition—")
@source(IRC_S501_C, quote = "(I) are unable to acquire medical care coverage for such condition through insurance or from a health maintenance organization, or")
rule IndividualDirectlyDescribedViaUnableToAcquireCoverage(individual: Person) defeasible {
    label en official "section 501(c)(26)(B): a resident who, because of a medical condition, is unable to acquire coverage";
    when individual_resident_of_state_501c26Bi(individual);
    when individual_unable_to_acquire_coverage_for_medical_condition_501c26BiiI(individual);
    then individual_directly_described_in_501c26B(individual);
}
@source(IRC_S501_C, quote = "(II) are able to acquire such coverage only at a rate which is substantially in excess of the rate for such coverage through the membership organization,")
rule IndividualDirectlyDescribedViaSubstantiallyHigherRate(individual: Person) defeasible {
    label en official "section 501(c)(26)(B): a resident who, because of a medical condition, can acquire coverage only at a rate substantially in excess of the organization's rate";
    when individual_resident_of_state_501c26Bi(individual);
    when CoverageRateSubstantiallyInExcess501c26BiiII(individual);
    then individual_directly_described_in_501c26B(individual);
}
pub relation individual_qualifies_for_501c26B_coverage(individual: Person) kind institutional {
    label en official "the individual is an individual described in section 501(c)(26)(B), including by the spouse and qualifying-child sentence";
}
rule IndividualQualifiesWhenDirectlyDescribed(individual: Person) defeasible {
    label en official "section 501(c)(26)(B): a directly described individual qualifies";
    when individual_directly_described_in_501c26B(individual);
    then individual_qualifies_for_501c26B_coverage(individual);
}
@source(IRC_S501_C, quote = "A spouse and any qualifying child (as defined in section 24(c)) of an individual described in subparagraph (B) (without regard to this sentence) shall be treated as described in subparagraph (B).")
rule SpouseOrQualifyingChildQualifies(individual: Person, eligible: Person) defeasible {
    label en official "section 501(c)(26), last sentence: a spouse and any qualifying child of a subparagraph (B) individual are treated as described in subparagraph (B)";
    when spouse_or_qualifying_child_of_eligible_individual_501c26(individual, eligible);
    when individual_directly_described_in_501c26B(eligible);
    then individual_qualifies_for_501c26B_coverage(individual);
}
pub relation qualifying_individual_receives_coverage_501c26B(org: Person, individual: Person, y: TaxableYear) kind institutional {
    label en official "helper: the individual receives coverage through the organization and qualifies under section 501(c)(26)(B) (the exception atom that binds every head variable of the rule below)";
}
rule QualifyingIndividualReceivesCoverage(org: Person, individual: Person, y: TaxableYear) defeasible {
    label en official "helper: a receiving individual who qualifies";
    when individual_receives_coverage_through_501c26_organization(org, individual, y);
    when individual_qualifies_for_501c26B_coverage(individual);
    then qualifying_individual_receives_coverage_501c26B(org, individual, y);
}
pub relation organization_covers_non_qualifying_individual_501c26B(org: Person, y: TaxableYear) kind institutional {
    label en official "the organization provides coverage to an individual who is not described in section 501(c)(26)(B)";
}
@source(IRC_S501_C, quote = "(B) the only individuals receiving such coverage through the organization are individuals—")
rule OrganizationCoversNonQualifyingIndividual(org: Person, y: TaxableYear, individual: Person) defeasible {
    label en official "section 501(c)(26)(B): the only individuals receiving coverage must be qualifying individuals";
    when individual_receives_coverage_through_501c26_organization(org, individual, y);
    unless qualifying_individual_receives_coverage_501c26B(org, individual, y);
    then organization_covers_non_qualifying_individual_501c26B(org, y);
}
@source(IRC_S501_C, quote = "(A) such organization is established by a State exclusively to provide coverage for medical care (as defined in section 213(d)) on a not-for-profit basis to individuals described in subparagraph (B) through—")
@source(IRC_S501_C, quote = "(C) the composition of the membership in such organization is specified by such State, and")
@source(IRC_S501_C, quote = "(D) no part of the net earnings of the organization inures to the benefit of any private shareholder or individual.")
rule Section501c26ClassificationDecomposed(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(26), decomposed: State-established not-for-profit coverage, coverage limited to qualifying individuals, State-specified membership, no private inurement";
    when established_by_state_for_not_for_profit_medical_coverage(o, y);
    when membership_composition_specified_by_state(o);
    unless organization_covers_non_qualifying_individual_501c26B(o, y);
    unless private_inurement_established(o, y);
    then section_501c26(o, y);
}

// ---------------------------------------------------------------------
// (c)(27): State workers' compensation organizations.
// ---------------------------------------------------------------------

pub relation established_before_june_1_1996_by_state_exclusively_to_reimburse_members_501c27Ai(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization is established before June 1, 1996, by a State exclusively to reimburse its members for losses arising under workmen's compensation acts (section 501(c)(27)(A)(i))";
}
pub relation state_requires_membership_of_all_insurers_and_self_insurers_501c27Aii(o: Person) kind empirical {
    label en official "the State requires the membership to consist of all persons who issue workmen's compensation insurance in the State (I) and all persons and governmental entities who self-insure against such losses (II)";
}
pub relation returns_surplus_income_periodically_501c27AiiiI(o: Person) kind empirical {
    label en official "the organization returns surplus income to its members or workmen's compensation policyholders on a periodic basis (section 501(c)(27)(A)(iii)(I))";
}
pub relation reduces_initial_premiums_in_anticipation_of_investment_income_501c27AiiiII(o: Person) kind empirical {
    label en official "the organization reduces initial premiums in anticipation of investment income (section 501(c)(27)(A)(iii)(II))";
}
@source(IRC_S501_C, quote = "(i) such organization is established before June 1, 1996, by a State exclusively to reimburse its members for losses arising under workmen's compensation acts,")
@source(IRC_S501_C, quote = "(ii) such State requires that the membership of such organization consist of—")
@source(IRC_S501_C, quote = "(iii) such organization operates as a non-profit organization by—")
rule Section501c27ADecomposed(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(27)(A), decomposed: pre-June 1, 1996 State-established reimbursement organization with State-required membership of all insurers and self-insurers, operated as a non-profit by returning surplus and reducing initial premiums";
    when established_before_june_1_1996_by_state_exclusively_to_reimburse_members_501c27Ai(o, y);
    when state_requires_membership_of_all_insurers_and_self_insurers_501c27Aii(o);
    when returns_surplus_income_periodically_501c27AiiiI(o);
    when reduces_initial_premiums_in_anticipation_of_investment_income_501c27AiiiII(o);
    then section_501c27(o, y);
}
pub relation created_by_state_law_and_operated_exclusively_to_provide_required_workers_comp_insurance_501c27Bi(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization is created by State law and organized and operated under State law exclusively to provide workmen's compensation insurance required by State law (or subject to significant disincentives if not purchased) and related incidental coverage (section 501(c)(27)(B)(i))";
}
pub relation must_insure_any_employer_seeking_coverage_501c27Bii(o: Person) kind empirical {
    label en official "the organization must provide workmen's compensation insurance to any employer in the State which seeks such insurance and meets other reasonable requirements (section 501(c)(27)(B)(ii))";
}
pub relation state_extends_full_faith_and_credit_or_provides_initial_operating_capital_501c27BiiiI(o: Person) kind empirical {
    label en official "the State extends its full faith and credit to the initial debt of the organization or provides its initial operating capital (section 501(c)(27)(B)(iii)(I))";
}
pub relation assets_revert_to_state_or_dissolution_not_permitted_501c27BiiiII(o: Person) kind empirical {
    label en official "for periods after the date of enactment of the subparagraph, the assets revert to the State upon dissolution or State law does not permit dissolution (section 501(c)(27)(B)(iii)(II))";
}
pub relation majority_of_board_appointed_by_state_officials_501c27Biv(o: Person) kind empirical {
    label en official "the majority of the board of directors or oversight body is appointed by the State's chief executive or other executive branch official, by the State legislature, or by both (section 501(c)(27)(B)(iv))";
}
@source(IRC_S501_C, quote = "(B) Any organization (including a mutual insurance company) if—")
@source(IRC_S501_C, quote = "(i) such organization is created by State law and is organized and operated under State law exclusively to—")
@source(IRC_S501_C, quote = "(ii) such organization must provide workmen's compensation insurance to any employer in the State (for employees in the State or temporarily assigned out-of-State) which seeks such insurance and meets other reasonable requirements relating thereto,")
@source(IRC_S501_C, quote = "(iii)(I) the State makes a financial commitment with respect to such organization either by extending the full faith and credit of the State to the initial debt of such organization or by providing the initial operating capital of such organization, and (II) in the case of periods after the date of enactment of this subparagraph, the assets of such organization revert to the State upon dissolution or State law does not permit the dissolution of such organization, and")
@source(IRC_S501_C, quote = "(iv) the majority of the board of directors or oversight body of such organization are appointed by the chief executive officer or other executive branch official of the State, by the State legislature, or by both.")
rule Section501c27BDecomposed(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(27)(B), decomposed: State-created exclusive workers' compensation insurer that must insure any employer, backed by the State, with reversion of assets and a State-appointed board majority";
    when created_by_state_law_and_operated_exclusively_to_provide_required_workers_comp_insurance_501c27Bi(o, y);
    when must_insure_any_employer_seeking_coverage_501c27Bii(o);
    when state_extends_full_faith_and_credit_or_provides_initial_operating_capital_501c27BiiiI(o);
    when assets_revert_to_state_or_dissolution_not_permitted_501c27BiiiII(o);
    when majority_of_board_appointed_by_state_officials_501c27Biv(o);
    then section_501c27(o, y);
}
