// Section 521 (farmers' cooperatives) and Subchapter T remainder —
// section 1381 (scope), 1383 (redemption tax-benefit rule), 1385 (patron
// inclusion/exclusion), 1388(b),(d)-(k) (definitions) — STAGE 2b
// (25.09.2026).
//
// FINDING: section 521's pinned text has NO "85 percent" test on its
// face (unlike section 501(c)(12)/(15)'s 85-percent tests) — the
// nonmember-business limit in (b)(4) is a value COMPARISON (nonmember
// value <= member value, an implicit 50-percent-of-total-business
// equivalent) plus an EXACT 15 percent cap on purchases from non-member/
// non-producer persons. Modelled exactly as pinned; the task's own "85%/
// 50%" description is not invented onto the text.

// =======================================================================
// Section 521: farmers' cooperatives.
// =======================================================================

use self::{
    Corporation,
    IRC_S1381_A,
    IRC_S1381_B,
    IRC_S1383_A,
    IRC_S1383_B,
    IRC_S1385_A,
    IRC_S1385_B,
    IRC_S1385_C,
    IRC_S1388_B,
    IRC_S1388_D,
    IRC_S1388_E,
    IRC_S1388_F,
    IRC_S1388_G,
    IRC_S1388_H,
    IRC_S1388_I,
    IRC_S1388_J,
    IRC_S1388_K,
    IRC_S521_A,
    IRC_S521_B,
    Person,
    TaxableYear,
    cooperative_taxable_year_bounds,
    engaged_in_rural_electric_or_telephone_1381a2C,
    qualified_check_endorsed_and_cashed_by,
    qualified_check_issued_during_payment_period,
    qualified_written_notice_of_allocation_1388c,
    section_1382d_payment_period,
    total_patronage_dividend_payment_1388c,
};

@source(IRC_S521_A, quote = "A farmers' cooperative organization described in subsection (b)(1) shall be exempt from taxation under this subtitle except as otherwise provided in part I of subchapter T (sec. 1381 and following). Notwithstanding part I of subchapter T (sec. 1381 and following), such an organization shall be considered an organization exempt from income taxes for purposes of any law which refers to organizations exempt from income taxes.")
pub relation farmers_cooperative_exempt_521a(o: Person, y: TaxableYear) kind institutional {
    label en official "section 521(a): a section 521(b)(1) farmers' cooperative is exempt except as Subchapter T part I provides, and is treated as income-tax-exempt for other laws' purposes";
}
rule FarmersCooperativeExempt521a(o: Person, y: TaxableYear) defeasible {
    label en official "section 521(a)";
    when farmers_fruit_growers_or_like_association_521b1(o);
    when us.irc.core::year_of(o, y);
    then farmers_cooperative_exempt_521a(o, y);
}
@source(IRC_S521_B, quote = "The farmers' cooperatives exempt from taxation to the extent provided in subsection (a) are farmers', fruit growers', or like associations organized and operated on a cooperative basis (A) for the purpose of marketing the products of members or other producers, and turning back to them the proceeds of sales, less the necessary marketing expenses, on the basis of either the quantity or the value of the products furnished by them, or (B) for the purpose of purchasing supplies and equipment for the use of members or other persons, and turning over such supplies and equipment to them at actual cost, plus necessary expenses.")
pub relation farmers_fruit_growers_or_like_association_521b1(o: Person) kind institutional {
    label en official "section 521(b)(1): a farmers'/fruit growers'/like association operated on a cooperative basis for marketing (A) or purchasing (B), meeting (2)/(4)";
}
pub relation marketing_association_cooperative_basis_521b1A(o: Person) kind empirical {
    label en official "the association markets members'/producers' products and turns back sale proceeds less marketing expenses, on a quantity/value basis (section 521(b)(1)(A))";
}
pub relation purchasing_association_cooperative_basis_521b1B(o: Person) kind empirical {
    label en official "the association purchases supplies/equipment and turns them over at actual cost plus expenses (section 521(b)(1)(B))";
}
rule FarmersFruitGrowersOrLikeAssociationViaMarketing(o: Person) defeasible { label en official "section 521(b)(1)(A)"; when marketing_association_cooperative_basis_521b1A(o); unless nonmember_business_limit_exceeded_521b4(o); then farmers_fruit_growers_or_like_association_521b1(o); }
rule FarmersFruitGrowersOrLikeAssociationViaPurchasing(o: Person) defeasible { label en official "section 521(b)(1)(B)"; when purchasing_association_cooperative_basis_521b1B(o); unless nonmember_purchase_limit_exceeded_521b4(o); then farmers_fruit_growers_or_like_association_521b1(o); }

@source(IRC_S521_B, quote = "Exemption shall not be denied any such association which markets the products of nonmembers in an amount the value of which does not exceed the value of the products marketed for members, or which purchases supplies and equipment for nonmembers in an amount the value of which does not exceed the value of the supplies and equipment purchased for members, provided the value of the purchases made for persons who are neither members nor producers does not exceed 15 percent of the value of all its purchases.")
pub relation nonmember_business_limit_exceeded_521b4(o: Person) kind institutional {
    label en official "section 521(b)(4), marketing branch: the value of products marketed for nonmembers EXCEEDS the value marketed for members — a disqualifying condition, EXACT comparison";
}
pub relation nonmember_marketing_value_521b4(o: Person, nonmember_value: Money, member_value: Money) kind empirical {
    label en official "the value of products marketed for nonmembers and for members, respectively, for the section 521(b)(4) comparison";
}
rule NonmemberBusinessLimitExceeded521b4(o: Person, nonmember_value: Money, member_value: Money) defeasible {
    label en official "section 521(b)(4): exact value comparison, no percentage/rounding";
    when nonmember_marketing_value_521b4(o, nonmember_value, member_value);
    when nonmember_value > member_value;
    then nonmember_business_limit_exceeded_521b4(o);
}
pub relation nonmember_purchase_limit_exceeded_521b4(o: Person) kind institutional {
    label en official "section 521(b)(4), purchasing branch: the value of supplies/equipment purchased for nonmembers EXCEEDS the value purchased for members, OR non-member/non-producer purchases exceed 15 percent of all purchases — either disqualifies";
}
pub relation nonmember_purchase_value_521b4(o: Person, nonmember_value: Money, member_value: Money) kind empirical {
    label en official "the value of supplies/equipment purchased for nonmembers and for members, respectively (section 521(b)(4))";
}
pub relation non_member_non_producer_purchase_value_521b4(o: Person, amount: Money, total_purchases: Money) kind empirical {
    label en official "the value of purchases made for persons who are neither members nor producers, and total purchases, for the EXACT 15 percent cap (section 521(b)(4))";
}
rule NonmemberPurchaseLimitExceededViaValue521b4(o: Person, nonmember_value: Money, member_value: Money) defeasible {
    label en official "section 521(b)(4): exact value comparison";
    when nonmember_purchase_value_521b4(o, nonmember_value, member_value);
    when nonmember_value > member_value;
    then nonmember_purchase_limit_exceeded_521b4(o);
}
rule NonmemberPurchaseLimitExceededViaFifteenPercent521b4(o: Person, amount: Money, total: Money) defeasible {
    label en official "section 521(b)(4): EXACT 15 percent cap on non-member/non-producer purchases, cross-multiplication, no division";
    when non_member_non_producer_purchase_value_521b4(o, amount, total);
    when amount * 100 > total * 15;
    then nonmember_purchase_limit_exceeded_521b4(o);
}
@source(IRC_S521_B, quote = "Exemption shall not be denied any such association because it has capital stock, if the dividend rate of such stock is fixed at not to exceed the legal rate of interest in the State of incorporation or 8 percent per annum, whichever is greater, on the value of the consideration for which the stock was issued, and if substantially all such stock (other than nonvoting preferred stock, the owners of which are not entitled or permitted to participate, directly or indirectly, in the profits of the association, upon dissolution or otherwise, beyond the fixed dividends) is owned by producers who market their products or purchase their supplies and equipment through the association.")
pub relation capital_stock_dividend_rate_disqualifying_521b2(o: Person) kind empirical {
    label en unofficial "the capital-stock dividend rate exceeds the greater of the State legal interest rate or 8 percent, OR stock ownership by patron-producers fails the substantially-all test (section 521(b)(2)) — the State-legal-rate comparison is EXTERNAL_DEPENDENCY on state law this package does not own, so this compound fact is case-asserted rather than decomposed";
}
@source(IRC_S521_B, quote = "Exemption shall not be denied any such association because there is accumulated and maintained by it a reserve required by State law or a reasonable reserve for any necessary purpose.")
pub relation reasonable_reserve_maintained_521b3(o: Person) kind institutional {
    label en official "section 521(b)(3): a State-law-required or reasonable-purpose reserve does not deny exemption — a non-denial rule, not itself an operative condition to satisfy";
}

// =======================================================================
// Section 1381: scope of Subchapter T part I.
// =======================================================================

@source(IRC_S1381_A, quote = "This part shall apply to—\n(1) any organization exempt from tax under section 521 (relating to exemption of farmers' cooperatives from tax), and\n(2) any corporation operating on a cooperative basis other than an organization—\n(A) which is exempt from tax under this chapter,")
pub relation subchapter_t_part_i_applies_1381a(o: Person) kind institutional {
    label en official "section 1381(a): Subchapter T part I applies to a section 521 farmers' cooperative, or to a corporation operating on a cooperative basis other than the three excluded categories in (2)(A)-(C)";
}
rule SubchapterTPartIAppliesViaFarmersCoop(o: Person, y: TaxableYear) defeasible { label en official "section 1381(a)(1)"; when farmers_cooperative_exempt_521a(o, y); then subchapter_t_part_i_applies_1381a(o); }
pub relation corporation_operating_on_cooperative_basis_1381a2(o: Corporation) kind empirical {
    label en official "the corporation operates on a cooperative basis (section 1381(a)(2))";
}
pub relation exempt_under_this_chapter_1381a2A(o: Corporation) kind empirical { label en official "the corporation is exempt from tax under chapter 1 (section 1381(a)(2)(A)) — a disqualifying condition"; }
pub relation mutual_savings_bank_or_insurance_company_1381a2B(o: Corporation) kind empirical { label en official "the corporation is subject to part II of subchapter H (mutual savings banks) or subchapter L (insurance companies) (section 1381(a)(2)(B)) — a disqualifying condition"; }
pub relation rural_electric_or_telephone_service_1381a2C(o: Corporation) kind empirical { label en official "the corporation furnishes electric energy or telephone service to persons in rural areas (section 1381(a)(2)(C)) — a disqualifying condition"; }
rule SubchapterTPartIAppliesViaCooperativeCorporation(o: Corporation) defeasible {
    label en official "section 1381(a)(2): applies to a cooperative-basis corporation unless one of the three exclusions applies";
    when corporation_operating_on_cooperative_basis_1381a2(o);
    unless exempt_under_this_chapter_1381a2A(o);
    unless mutual_savings_bank_or_insurance_company_1381a2B(o);
    unless rural_electric_or_telephone_service_1381a2C(o);
    unless engaged_in_rural_electric_or_telephone_1381a2C(o);
    then subchapter_t_part_i_applies_1381a(o);
}
@source(IRC_S1381_B, quote = "An organization described in subsection (a)(1) shall be subject to the tax imposed by section 11.")
pub relation farmers_cooperative_subject_to_section_11_1381b(o: Corporation, y: TaxableYear) kind institutional {
    label en official "section 1381(b): a section 521 farmers' cooperative is subject to the section 11 corporate tax (on the taxable income remaining after the Subchapter T deductions)";
}
rule FarmersCooperativeSubjectToSection11_1381b(o: Corporation, y: TaxableYear) defeasible {
    label en official "section 1381(b)";
    when farmers_cooperative_exempt_521a(o, y);
    then farmers_cooperative_subject_to_section_11_1381b(o, y);
}

// =======================================================================
// Section 1383: the redemption-deduction lesser-of-tax rule.
// =======================================================================

@source(IRC_S1383_A, quote = "If, under section 1382(b)(2) or (4), or (c)(2)(B), a deduction is allowable to an organization for the taxable year for amounts paid in redemption of nonqualified written notices of allocation or nonqualified per-unit retain certificates, then the tax imposed by this chapter on such organization for the taxable year shall be the lesser of the following:\n(1) the tax for the taxable year computed with such deduction; or\n(2) an amount equal to—\n(A) the tax for the taxable year computed without such deduction, minus\n(B) the decrease in tax under this chapter for any prior taxable year (or years) which would result solely from treating such nonqualified written notices of allocation or nonqualified per-unit retain certificates as qualified written notices of allocation or qualified per-unit retain certificates (as the case may be).")
pub relation redemption_tax_1383(coop: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1383(a): the tax on redemption of a nonqualified written notice/certificate is the EXACT lesser of the tax computed with the section 1382(b)(2)/(4)/(c)(2)(B) deduction, or (tax without the deduction minus the prior-year decrease attributable to requalification)";
}
pub relation tax_with_redemption_deduction_1383a1(coop: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the tax for the taxable year computed WITH the redemption deduction (section 1383(a)(1))";
}
pub relation tax_without_redemption_deduction_1383a2A(coop: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the tax for the taxable year computed WITHOUT the redemption deduction (section 1383(a)(2)(A))";
}
pub relation prior_year_decrease_from_requalification_1383a2B(coop: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the decrease in prior-year tax that would result solely from treating the nonqualified notice/certificate as qualified (section 1383(a)(2)(B))";
}
rule RedemptionTax1383LowerIsWithDeduction(coop: Person, y: TaxableYear, with_ded: Money, without_ded: Money, decrease: Money) defeasible {
    label en official "section 1383(a): the with-deduction figure is the lower";
    when tax_with_redemption_deduction_1383a1(coop, y, with_ded);
    when tax_without_redemption_deduction_1383a2A(coop, y, without_ded);
    when prior_year_decrease_from_requalification_1383a2B(coop, y, decrease);
    when with_ded <= without_ded - decrease;
    then redemption_tax_1383(coop, y, with_ded);
}
rule RedemptionTax1383LowerIsWithoutDeductionMinusDecrease(coop: Person, y: TaxableYear, with_ded: Money, without_ded: Money, decrease: Money) defeasible {
    label en official "section 1383(a): the without-deduction-minus-prior-decrease figure is the lower";
    when tax_with_redemption_deduction_1383a1(coop, y, with_ded);
    when tax_without_redemption_deduction_1383a2A(coop, y, without_ded);
    when prior_year_decrease_from_requalification_1383a2B(coop, y, decrease);
    when without_ded - decrease < with_ded;
    then redemption_tax_1383(coop, y, without_ded - decrease);
}
@source(IRC_S1383_B, quote = "If the decrease in tax ascertained under subsection (a)(2)(B) exceeds the tax for the taxable year (computed without the deduction described in subsection (a)) such excess shall be considered to be a payment of tax on the last day prescribed by law for the payment of tax for the taxable year, and shall be refunded or credited in the same manner as if it were an overpayment for such taxable year.")
pub relation excess_decrease_treated_as_tax_payment_1383b1(coop: Person, y: TaxableYear, excess_amount: Money) kind institutional {
    label en official "section 1383(b)(1): a prior-year decrease exceeding the tax computed without the deduction is treated as a tax payment (refundable/creditable as an overpayment)";
}
rule ExcessDecreaseTreatedAsTaxPayment1383b1(coop: Person, y: TaxableYear, decrease: Money, without_ded: Money) defeasible {
    label en official "section 1383(b)(1): exact comparison";
    when prior_year_decrease_from_requalification_1383a2B(coop, y, decrease);
    when tax_without_redemption_deduction_1383a2A(coop, y, without_ded);
    when decrease > without_ded;
    then excess_decrease_treated_as_tax_payment_1383b1(coop, y, decrease - without_ded);
}

// =======================================================================
// Section 1385: patron inclusion/exclusion of patronage dividends and
// per-unit retain allocations.
// =======================================================================

@source(IRC_S1385_A, quote = "Except as otherwise provided in subsection (b), each person shall include in gross income—\n(1) the amount of any patronage dividend which is paid in money, a qualified written notice of allocation, or other property (except a nonqualified written notice of allocation), and which is received by him during the taxable year from an organization described in section 1381(a),")
pub relation patron_includes_patronage_dividend_1385a1(patron: Person, coop: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1385(a)(1): the patron includes a patronage dividend paid in qualifying media, unless the (b) exclusion applies";
}
pub relation patronage_dividend_paid_in_qualifying_medium_1385a1(patron: Person, coop: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "a patronage dividend paid in money, a qualified written notice of allocation, or other property (except a nonqualified written notice) (section 1385(a)(1))";
}
@source(IRC_S1385_B, quote = "Under regulations prescribed by the Secretary, the amount of any patronage dividend, and any amount received on the redemption, sale, or other disposition of a nonqualified written notice of allocation which was paid as a patronage dividend, shall not be included in gross income to the extent that such amount—\n(1) is properly taken into account as an adjustment to basis of property, or\n(2) is attributable to personal, living, or family items.")
pub relation patronage_dividend_excluded_1385b(patron: Person, coop: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1385(b): a patronage dividend amount properly a basis adjustment, or attributable to personal/living/family items, is excluded from gross income";
}
pub relation properly_basis_adjustment_or_personal_family_item_1385b(patron: Person, coop: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount is properly taken into account as a basis adjustment, or is attributable to personal/living/family items (section 1385(b)(1)-(2))";
}
rule PatronIncludesPatronageDividend1385a1(patron: Person, coop: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 1385(a)(1), subject to the (b) exclusion";
    when patronage_dividend_paid_in_qualifying_medium_1385a1(patron, coop, y, amount);
    unless properly_basis_adjustment_or_personal_family_item_1385b(patron, coop, y, amount);
    then patron_includes_patronage_dividend_1385a1(patron, coop, y, amount);
}
rule PatronageDividendExcluded1385b(patron: Person, coop: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 1385(b)";
    when properly_basis_adjustment_or_personal_family_item_1385b(patron, coop, y, amount);
    then patronage_dividend_excluded_1385b(patron, coop, y, amount);
}
@source(IRC_S1385_C, quote = "the basis of such written notice of allocation or per-unit retain certificate in the hands of the patron to whom such written notice of allocation or per-unit retain certificate was paid shall be zero,")
pub relation nonqualified_notice_basis_zero_1385c2A(patron: Person, notice: Text) kind institutional {
    label en official "section 1385(c)(2)(A): a nonqualified written notice/certificate has a ZERO basis in the original patron's hands — exact, not a rounding artifact";
}
@source(IRC_S1385_C, quote = "gain on the redemption, sale, or other disposition of such written notice of allocation or per-unit retain certificate by any person shall, to the extent that the stated dollar amount of such written notice of allocation or per-unit retain certificate exceeds its basis, be considered as ordinary income.")
pub relation nonqualified_notice_gain_ordinary_income_1385c2C(patron: Person, notice: Text, stated_amount: Money, basis: Money, ordinary_income: Money) kind institutional {
    label en official "section 1385(c)(2)(C): gain equal to the excess of the stated dollar amount over basis is ordinary income";
}
rule NonqualifiedNoticeGainOrdinaryIncome1385c2C(patron: Person, notice: Text, stated_amount: Money, basis: Money) defeasible {
    label en official "section 1385(c)(2)(C): exact excess, no rounding beyond ordinary Money precision";
    when nonqualified_notice_disposed_1385c(patron, notice, stated_amount, basis);
    when stated_amount > basis;
    then nonqualified_notice_gain_ordinary_income_1385c2C(patron, notice, stated_amount, basis, stated_amount - basis);
}
pub relation nonqualified_notice_disposed_1385c(patron: Person, notice: Text, stated_amount: Money, basis: Money) kind empirical {
    label en official "a nonqualified written notice of allocation or per-unit retain certificate (within section 1385(c)(1)) was redeemed, sold, or otherwise disposed of, with this stated dollar amount and basis (section 1385(c)(2))";
}

// =======================================================================
// Section 1388(b),(d)-(k): remaining Subchapter T definitions.
// =======================================================================

@source(IRC_S1388_B, quote = "the term \"written notice of allocation\" means any capital stock, revolving fund certificate, retain certificate, certificate of indebtedness, letter of advice, or other written notice, which discloses to the recipient the stated dollar amount allocated to him by the organization and the portion thereof, if any, which constitutes a patronage dividend.")
pub relation written_notice_of_allocation_1388b(coop: Person, patron: Person, y: TaxableYear, stated_amount: Money) kind institutional {
    label en official "section 1388(b): a written notice of allocation — capital stock/revolving fund/retain certificate/certificate of indebtedness/letter of advice/other, disclosing the stated dollar amount and patronage-dividend portion";
}
pub relation discloses_stated_amount_and_patronage_portion_1388b(coop: Person, patron: Person, y: TaxableYear, stated_amount: Money) kind empirical {
    label en official "the instrument discloses the stated dollar amount allocated and the patronage-dividend portion (section 1388(b))";
}
rule WrittenNoticeOfAllocation1388b(coop: Person, patron: Person, y: TaxableYear, stated_amount: Money) defeasible { label en official "section 1388(b)"; when discloses_stated_amount_and_patronage_portion_1388b(coop, patron, y, stated_amount); then written_notice_of_allocation_1388b(coop, patron, y, stated_amount); }

@source(IRC_S1388_D, quote = "the term \"nonqualified written notice of allocation\" means a written notice of allocation which is not described in subsection (c) or a qualified check which is not cashed on or before the 90th day after the close of the payment period for the taxable year for which the distribution of which it is a part is paid.")
pub relation nonqualified_written_notice_of_allocation_1388d(coop: Person, patron: Person, y: TaxableYear, stated_amount: Money) kind institutional {
    label en official "section 1388(d): a written notice not qualified under section 1388(c), OR a qualified check not cashed within the EXACT 90-day post-payment-period window";
}
rule NonqualifiedWrittenNoticeViaNotQualified(coop: Person, patron: Person, y: TaxableYear, stated_amount: Money) defeasible {
    label en official "section 1388(d), first branch: not a section 1388(c) qualified written notice";
    when written_notice_of_allocation_1388b(coop, patron, y, stated_amount);
    unless qualified_written_notice_of_allocation_1388c(stated_amount, coop, patron, y);
    then nonqualified_written_notice_of_allocation_1388d(coop, patron, y, stated_amount);
}
rule NonqualifiedWrittenNoticeViaUncashedCheck1388d(coop: Person, patron: Person, y: TaxableYear, deadline: Date, cashed_on: Date, stated_amount: Money) defeasible {
    label en official "section 1388(d), second branch: a qualified check not cashed within 90 days after the close of the payment period — exact";
    when section_1382d_payment_period(coop, y, _, deadline);
    when qualified_check_issued_during_payment_period(coop, patron, y);
    when qualified_check_endorsed_and_cashed_by(coop, patron, y, cashed_on);
    when cashed_on > add_calendar_period(deadline, 90 calendar_day);
    when total_patronage_dividend_payment_1388c(coop, patron, y, stated_amount);
    then nonqualified_written_notice_of_allocation_1388d(coop, patron, y, stated_amount);
}

@source(IRC_S1388_E, quote = "property (other than a written notice of allocation or a per-unit retain certificate) shall be taken into account at its fair market value, and")
pub relation property_valued_at_fmv_1388e1(coop: Person, patron: Person, y: TaxableYear, fmv: Money) kind institutional {
    label en official "section 1388(e)(1): non-notice/certificate property is taken into account at fair market value";
}
@source(IRC_S1388_E, quote = "a qualified written notice of allocation or qualified per-unit retain certificate shall be taken into account at its stated dollar amount.")
pub relation qualified_notice_valued_at_stated_amount_1388e2(coop: Person, patron: Person, y: TaxableYear, stated_amount: Money) kind institutional {
    label en official "section 1388(e)(2): a qualified written notice/certificate is taken into account at its EXACT stated dollar amount, never fair market value";
}

@source(IRC_S1388_F, quote = "the term \"per-unit retain allocation\" means any allocation, by an organization to which part I of this subchapter applies, to a patron with respect to products marketed for him, the amount of which is fixed without reference to the net earnings of the organization pursuant to an agreement between the organization and the patron.")
pub relation per_unit_retain_allocation_1388f(coop: Person, patron: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1388(f): an allocation fixed WITHOUT reference to net earnings, per an organization-patron agreement, with respect to marketed products";
}
pub relation fixed_without_reference_to_net_earnings_1388f(coop: Person, patron: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the allocation amount is fixed without reference to the organization's net earnings, under an organization-patron agreement (section 1388(f))";
}
rule PerUnitRetainAllocation1388f(coop: Person, patron: Person, y: TaxableYear, amount: Money) defeasible { label en official "section 1388(f)"; when fixed_without_reference_to_net_earnings_1388f(coop, patron, y, amount); then per_unit_retain_allocation_1388f(coop, patron, y, amount); }

@source(IRC_S1388_G, quote = "the term \"per-unit retain certificate\" means any written notice which discloses to the recipient the stated dollar amount of a per-unit retain allocation to him by the organization.")
pub relation per_unit_retain_certificate_1388g(coop: Person, patron: Person, y: TaxableYear, stated_amount: Money) kind institutional {
    label en official "section 1388(g): a written notice disclosing the stated dollar amount of a per-unit retain allocation";
}
rule PerUnitRetainCertificate1388g(coop: Person, patron: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 1388(g): the certificate discloses the per-unit retain allocation amount";
    when per_unit_retain_allocation_1388f(coop, patron, y, amount);
    then per_unit_retain_certificate_1388g(coop, patron, y, amount);
}

@source(IRC_S1388_H, quote = "the term \"qualified per-unit retain certificate\" means any per-unit retain certificate which the distributee has agreed, in the manner provided in paragraph (2), to take into account at its stated dollar amount as provided in section 1385(a).")
pub relation qualified_per_unit_retain_certificate_1388h(coop: Person, patron: Person, y: TaxableYear, stated_amount: Money) kind institutional {
    label en official "section 1388(h)(1): a per-unit retain certificate the distributee has agreed (in writing, or via a qualifying bylaw-membership mechanism) to take into account at its stated dollar amount under section 1385(a)";
}
pub relation distributee_agreed_in_writing_1388h2A(coop: Person, patron: Person, y: TaxableYear) kind empirical {
    label en official "the distributee agreed in writing to take the certificate into account at its stated dollar amount (section 1388(h)(2)(A))";
}
pub relation distributee_agreed_via_bylaw_membership_1388h2B(coop: Person, patron: Person, y: TaxableYear) kind empirical {
    label en official "the distributee obtained/retained membership after the organization adopted (post-November 13, 1966) a bylaw providing that membership constitutes agreement, and received notice and a copy of the bylaw (section 1388(h)(2)(B))";
}
rule QualifiedPerUnitRetainCertificateViaWriting(coop: Person, patron: Person, y: TaxableYear, amount: Money) defeasible { label en official "section 1388(h)(2)(A)"; when per_unit_retain_certificate_1388g(coop, patron, y, amount); when distributee_agreed_in_writing_1388h2A(coop, patron, y); then qualified_per_unit_retain_certificate_1388h(coop, patron, y, amount); }
rule QualifiedPerUnitRetainCertificateViaBylaw(coop: Person, patron: Person, y: TaxableYear, amount: Money) defeasible { label en official "section 1388(h)(2)(B)"; when per_unit_retain_certificate_1388g(coop, patron, y, amount); when distributee_agreed_via_bylaw_membership_1388h2B(coop, patron, y); then qualified_per_unit_retain_certificate_1388h(coop, patron, y, amount); }

@source(IRC_S1388_I, quote = "the term \"nonqualified per-unit retain certificate\" means a per-unit retain certificate which is not described in subsection (h).")
pub relation nonqualified_per_unit_retain_certificate_1388i(coop: Person, patron: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1388(i): a per-unit retain certificate not qualified under section 1388(h)";
}
rule NonqualifiedPerUnitRetainCertificate1388i(coop: Person, patron: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 1388(i)";
    when per_unit_retain_certificate_1388g(coop, patron, y, amount);
    unless qualified_per_unit_retain_certificate_1388h(coop, patron, y, amount);
    then nonqualified_per_unit_retain_certificate_1388i(coop, patron, y, amount);
}

@source(IRC_S1388_J, quote = "The net earnings of such organization may, at its option, be determined by offsetting patronage losses (including any patronage loss carried to such year) which are attributable to 1 or more allocation units (whether such units are functional, divisional, departmental, geographic, or otherwise) against patronage earnings of 1 or more other such allocation units.")
pub relation optional_netting_of_allocation_unit_gains_losses_1388j1(coop: Person, y: TaxableYear) kind institutional {
    label en official "section 1388(j)(1): the cooperative may elect to net patronage losses of one or more allocation units against patronage earnings of others";
}
pub relation elects_to_net_allocation_units_1388j1(coop: Person, y: TaxableYear) kind empirical {
    label en unofficial "the exercise fact for the section 1388(j)(1) netting election";
}
rule OptionalNettingElectionPower1388j(coop: Person, y: TaxableYear) strict {
    label en official "section 1388(j)(1): the netting option is a power exercised by electing it";
    when subchapter_t_part_i_applies_1381a(coop);
    when us.irc.core::year_of(coop, y);
    then power OptionalNettingElection1388j {
        holder coop;
        exercise elects_to_net_allocation_units_1388j1(coop, y);
        valid_when subchapter_t_part_i_applies_1381a(coop);
        effect optional_netting_of_allocation_unit_gains_losses_1388j1(coop, y);
    };
}
@source(IRC_S1388_J, quote = "In the case of any organization which exercises its option under paragraph (1) for any taxable year, such organization shall, on or before the 15th day of the 9th month following the close of such taxable year, provide to its patrons a written notice")
pub relation netting_notice_duty_1388j3(coop: Person, y: TaxableYear, year_end: Date) kind institutional {
    label en official "section 1388(j)(3)(A): a duty to notify patrons of the netting election, by the SAME EXACT 8½-month deadline as section 1382(d)'s payment period";
}
rule NettingNoticeDuty1388j3(coop: Person, y: TaxableYear, year_end: Date) defeasible {
    label en official "section 1388(j)(3)(A): reuses the section 1382(d) 8½-month deadline computation";
    when optional_netting_of_allocation_unit_gains_losses_1388j1(coop, y);
    when cooperative_taxable_year_bounds(coop, y, _, year_end);
    then netting_notice_duty_1388j3(coop, y, add_calendar_period(add_calendar_period(year_end, 9 calendar_month), 15 calendar_day));
}

@source(IRC_S1388_K, quote = "the marketing of the products of members or other producers shall include the feeding of such products to cattle, hogs, fish, chickens, or other animals and the sale of the resulting animals or animal products.")
pub relation value_added_animal_processing_included_in_marketing_1388k(coop: Person) kind institutional {
    label en official "section 1388(k): marketing of member/producer products includes feeding them to animals and selling the resulting animals/animal products, for sections 521 and this subchapter";
}
rule ValueAddedAnimalProcessingIncludedInMarketing1388k(coop: Person) defeasible {
    label en official "section 1388(k)";
    when feeds_products_to_animals_and_sells_result_1388k(coop);
    then value_added_animal_processing_included_in_marketing_1388k(coop);
}
pub relation feeds_products_to_animals_and_sells_result_1388k(coop: Person) kind empirical {
    label en official "the association feeds members'/producers' products to cattle, hogs, fish, chickens, or other animals and sells the resulting animals or animal products (section 1388(k))";
}
