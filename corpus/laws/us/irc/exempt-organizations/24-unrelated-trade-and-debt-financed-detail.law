// Sections 513 and 514, stage 3: the sub-paragraph detail stage 2b left at the
// top-level condition. Numeric tests are exact (cross-multiplication for
// percentages, inclusive or exclusive boundaries as the text says).

// ---------------------------------------------------------------------
// Section 513.
// ---------------------------------------------------------------------

use self::{
    IRC_S513_C,
    IRC_S513_D,
    IRC_S513_F,
    IRC_S513_H,
    IRC_S513_I,
    IRC_S514_B,
    IRC_S514_C,
    IRC_S514_D,
    IRC_S514_F,
    Person,
    SecuritiesLoanPayment512a5A,
    TaxableYear,
    TradeOrBusiness,
    abandoned_intent_to_use_land_514b3,
    activity_is_trade_or_business,
    carried_on_within_larger_complex,
    determination_date_514,
    exempt_organization,
    neighborhood_land_acquired_for_future_exempt_use,
    not_unrelated_trade_convention_trade_show_513d,
    not_unrelated_trade_qualified_public_entertainment_513d,
    payment_with_respect_to_securities_loan_512a5,
    qualified_public_entertainment_does_not_endanger_exemption_513d4,
    section_501c25,
    unrelated_trade_or_business,
};

pub relation activity_carried_on_for_profit_513c(tb: TradeOrBusiness, o: Person, y: TaxableYear) kind empirical {
    label en official "the activity is carried on for profit";
}
pub relation activity_results_in_profit_513c(tb: TradeOrBusiness, o: Person, y: TaxableYear) kind empirical {
    label en official "the activity results in a profit for the taxable year";
}
pub relation no_part_excluded_for_lack_of_profit_513c(tb: TradeOrBusiness, o: Person, y: TaxableYear) kind institutional {
    label en official "no part of the unrelated trade or business is excluded from that classification merely because it does not result in profit";
}
@source(IRC_S513_C, quote = "For purposes of this section, the term \"trade or business\" includes any activity which is carried on for the production of income from the sale of goods or the performance of services. For purposes of the preceding sentence, an activity does not lose identity as a trade or business merely because it is carried on within a larger aggregate of similar activities or within a larger complex of other endeavors which may, or may not, be related to the exempt purposes of the organization. Where an acti")
rule NoPartExcludedForLackOfProfit(tb: TradeOrBusiness, o: Person, y: TaxableYear) defeasible {
    label en official "section 513(c), last sentence: an activity carried on for profit that is an unrelated trade or business stays one even when it yields no profit";
    when unrelated_trade_or_business(tb, o, y);
    when activity_carried_on_for_profit_513c(tb, o, y);
    then no_part_excluded_for_lack_of_profit_513c(tb, o, y);
}
pub relation trade_or_business_identity_kept_within_larger_complex_513c(tb: TradeOrBusiness, o: Person) kind institutional {
    label en official "the activity does not lose its identity as a trade or business merely because it is carried on within a larger aggregate of similar activities or a larger complex of other endeavors";
}
@source(IRC_S513_C, quote = "For purposes of this section, the term \"trade or business\" includes any activity which is carried on for the production of income from the sale of goods or the performance of services. For purposes of the preceding sentence, an activity does not lose identity as a trade or business merely because it is carried on within a larger aggregate of similar activities or within a larger complex of other endeavors which may, or may not, be related to the exempt purposes of the organization. Where an acti")
rule TradeOrBusinessIdentityKeptWithinLargerComplex(tb: TradeOrBusiness, o: Person) defeasible {
    label en official "section 513(c), second sentence: carrying the activity on within a larger complex does not deprive it of trade-or-business identity";
    when activity_is_trade_or_business(tb, o);
    when carried_on_within_larger_complex(tb, o);
    then trade_or_business_identity_kept_within_larger_complex_513c(tb, o);
}
// (d)(2)-(3): qualified public entertainment and convention and trade show activities.
pub relation entertainment_or_recreational_activity_traditional_at_agricultural_fairs_513d2A(tb: TradeOrBusiness) kind empirical {
    label en official "the activity is an entertainment or recreational activity of a kind traditionally conducted at fairs or expositions promoting agricultural and educational purposes, including any activity one of the purposes of which is to attract the public to fairs or expositions or to promote animal breeding or the development of products or equipment";
}
pub relation conducted_in_conjunction_with_fair_or_exposition_513d2Bi(tb: TradeOrBusiness) kind empirical {
    label en official "the activity is conducted in conjunction with an international, national, State, regional, or local fair or exposition";
}
pub relation conducted_under_state_law_reserving_it_to_such_organizations_513d2Bii(tb: TradeOrBusiness) kind empirical {
    label en official "the activity is conducted in accordance with State law that permits it to be operated solely by such an organization or by an agency, instrumentality or political subdivision of the State";
}
pub relation days_licensed_under_state_law_513d2Biii(tb: TradeOrBusiness, days: Decimal) kind empirical {
    label en official "the number of days of the activity licensed under State law that permits such an organization to be granted a license on payment of a lower percentage of the revenue than the State requires from organizations not described in section 501(c)(3), (4) or (5)";
}
pub relation conducted_by_qualifying_fair_organization_513d2C(tb: TradeOrBusiness, o: Person) kind empirical {
    label en official "the organization is described in section 501(c)(3), (4) or (5) and regularly conducts, as one of its substantial exempt purposes, an agricultural and educational fair or exposition";
}
pub relation qualified_public_entertainment_activity_of_qualifying_organization_513d2B(tb: TradeOrBusiness, o: Person) kind institutional {
    label en official "the public entertainment activity is a qualified public entertainment activity of a qualifying organization";
}
@source(IRC_S513_D, quote = "The term \"public entertainment activity\" means any entertainment or recreational activity of a kind traditionally conducted at fairs or expositions promoting agricultural and educational purposes, including, but not limited to, any activity one of the purposes of which is to attract the public to fairs or expositions or to promote the breeding of animals or the development of products or equipment.")
@source(IRC_S513_D, quote = "The term \"qualified public entertainment activity\" means a public entertainment activity which is conducted by a qualifying organization described in subparagraph (C) in—")
@source(IRC_S513_D, quote = "(i) conjunction with an international, national, State, regional, or local fair or exposition,")
rule QualifiedPublicEntertainmentViaFair(tb: TradeOrBusiness, o: Person) defeasible {
    label en official "section 513(d)(2)(B)(i): conducted in conjunction with a fair or exposition";
    when entertainment_or_recreational_activity_traditional_at_agricultural_fairs_513d2A(tb);
    when conducted_by_qualifying_fair_organization_513d2C(tb, o);
    when conducted_in_conjunction_with_fair_or_exposition_513d2Bi(tb);
    then qualified_public_entertainment_activity_of_qualifying_organization_513d2B(tb, o);
}
@source(IRC_S513_D, quote = "(ii) accordance with the provisions of State law which permit the activity to be operated or conducted solely by such an organization, or by an agency, instrumentality, or political subdivision of such State, or")
rule QualifiedPublicEntertainmentViaStateLawReservation(tb: TradeOrBusiness, o: Person) defeasible {
    label en official "section 513(d)(2)(B)(ii): conducted under State law reserving the activity to such organizations";
    when entertainment_or_recreational_activity_traditional_at_agricultural_fairs_513d2A(tb);
    when conducted_by_qualifying_fair_organization_513d2C(tb, o);
    when conducted_under_state_law_reserving_it_to_such_organizations_513d2Bii(tb);
    then qualified_public_entertainment_activity_of_qualifying_organization_513d2B(tb, o);
}
@source(IRC_S513_D, quote = "(iii) accordance with the provisions of State law which permit such an organization to be granted a license to conduct not more than 20 days of such activity on payment to the State of a lower percentage of the revenue from such licensed activity than the State requires from organizations not described in section 501(c)(3), (4), or (5).")
rule QualifiedPublicEntertainmentViaStateLicense(tb: TradeOrBusiness, o: Person, days: Decimal) defeasible {
    label en official "section 513(d)(2)(B)(iii): a State license for not more than 20 days — exactly 20 days qualifies";
    when entertainment_or_recreational_activity_traditional_at_agricultural_fairs_513d2A(tb);
    when conducted_by_qualifying_fair_organization_513d2C(tb, o);
    when days_licensed_under_state_law_513d2Biii(tb, days);
    when days <= 20.0;
    then qualified_public_entertainment_activity_of_qualifying_organization_513d2B(tb, o);
}
@source(IRC_S513_D, quote = "The term \"unrelated trade or business\" does not include qualified public entertainment activities of an organization described in paragraph (2)(C), or qualified convention and trade show activities of an organization described in paragraph (3)(C).")
rule NotUnrelatedTradePublicEntertainmentViaDerivedQualification(tb: TradeOrBusiness, o: Person, y: TaxableYear) defeasible {
    label en official "section 513(d)(1): a qualified public entertainment activity of a qualifying organization is not an unrelated trade or business";
    when qualified_public_entertainment_activity_of_qualifying_organization_513d2B(tb, o);
    when us.irc.core::year_of(o, y);
    then not_unrelated_trade_qualified_public_entertainment_513d(o, tb, y);
}
pub relation activity_traditional_at_conventions_annual_meetings_or_trade_shows_513d3A(tb: TradeOrBusiness) kind empirical {
    label en official "the activity is of a kind traditionally conducted at conventions, annual meetings, or trade shows, including any activity one of whose purposes is to attract persons in an industry generally, as well as members of the public, to the show to display or stimulate interest in industry products or services, or to educate persons in attendance regarding new developments";
}
pub relation carried_out_in_conjunction_with_convention_or_show_conducted_by_qualifying_organization_513d3B(tb: TradeOrBusiness, o: Person) kind empirical {
    label en official "the activity is carried out by a qualifying organization in conjunction with an international, national, State, regional, or local convention, annual meeting, or show conducted by a section 513(d)(3)(C) organization, one of whose purposes in sponsoring it is promoting interest in and demand for the industry's products and services or educating persons about new developments";
}
pub relation qualifying_trade_show_organization_513d3C(o: Person) kind empirical {
    label en official "the organization is described in section 501(c)(3), (4), (5) or (6) and regularly conducts as one of its substantial exempt purposes a show which stimulates interest in, and demand for, the products of a particular industry or which educates attendees regarding new developments";
}
pub relation qualified_convention_and_trade_show_activity_of_qualifying_organization_513d3B(tb: TradeOrBusiness, o: Person) kind institutional {
    label en official "the activity is a qualified convention and trade show activity of a qualifying organization";
}
@source(IRC_S513_D, quote = "The term \"convention and trade show activity\" means any activity of a kind traditionally conducted at conventions, annual meetings, or trade shows, including, but not limited to, any activity one of the purposes of which is to attract persons in an industry generally (without regard to membership in the sponsoring organization) as well as members of the public to the show for the purpose of displaying industry products or to stimulate interest in, and demand for, industry products or services, o")
@source(IRC_S513_D, quote = "The term \"qualified convention and trade show activity\" means a convention and trade show activity carried out by a qualifying organization described in subparagraph (C) in conjunction with an international, national, State, regional, or local convention, annual meeting, or show conducted by an organization described in subparagraph (C) if one of the purposes of such organization in sponsoring the activity is the promotion and stimulation of interest in, and demand for, the products and services")
@source(IRC_S513_D, quote = "For purposes of this paragraph, the term \"qualifying organization\" means an organization described in section 501(c)(3), (4), (5), or (6) which regularly conducts as one of its substantial exempt purposes a show which stimulates interest in, and demand for, the products of a particular industry or segment of such industry or which educates persons in attendance regarding new developments or products and services related to the exempt activities of the organization.")
rule QualifiedConventionAndTradeShowActivity(tb: TradeOrBusiness, o: Person) defeasible {
    label en official "section 513(d)(3): a convention or trade show activity of a qualifying organization carried out in conjunction with a qualifying show";
    when activity_traditional_at_conventions_annual_meetings_or_trade_shows_513d3A(tb);
    when qualifying_trade_show_organization_513d3C(o);
    when carried_out_in_conjunction_with_convention_or_show_conducted_by_qualifying_organization_513d3B(tb, o);
    then qualified_convention_and_trade_show_activity_of_qualifying_organization_513d3B(tb, o);
}
@source(IRC_S513_D, quote = "The term \"unrelated trade or business\" does not include qualified public entertainment activities of an organization described in paragraph (2)(C), or qualified convention and trade show activities of an organization described in paragraph (3)(C).")
rule NotUnrelatedTradeConventionViaDerivedQualification(tb: TradeOrBusiness, o: Person, y: TaxableYear) defeasible {
    label en official "section 513(d)(1): a qualified convention and trade show activity of a qualifying organization is not an unrelated trade or business";
    when qualified_convention_and_trade_show_activity_of_qualifying_organization_513d3B(tb, o);
    when us.irc.core::year_of(o, y);
    then not_unrelated_trade_convention_trade_show_513d(o, tb, y);
}
pub relation exempt_c3_c4_or_c5_organization_conducting_qualified_entertainment_513d4(o: Person, y: TaxableYear) kind empirical {
    label en official "a section 501(c)(3), (4) or (5) organization conducts qualified public entertainment activities";
}
@source(IRC_S513_D, quote = "An organization described in section 501(c) (3), (4), or (5) shall not be considered as not entitled to the exemption allowed under section 501(a) solely because of qualified public entertainment activities conducted by it.")
rule QualifiedEntertainmentDoesNotEndangerExemptionViaDerivedFacts(o: Person, y: TaxableYear) defeasible {
    label en official "section 513(d)(4): such an organization is not considered as not entitled to exemption solely because of qualified public entertainment activities";
    when exempt_c3_c4_or_c5_organization_conducting_qualified_entertainment_513d4(o, y);
    then qualified_public_entertainment_does_not_endanger_exemption_513d4(o, y);
}
// (f)(2): bingo.
pub relation bingo_wagers_winners_and_prizes_in_presence_of_all_players_513f2A(o: Person, tb: TradeOrBusiness, y: TaxableYear) kind empirical {
    label en official "of a type in which usually the wagers are placed, the winners are determined, and the prizes are distributed in the presence of all persons placing wagers";
}
pub relation bingo_not_ordinarily_carried_out_on_commercial_basis_513f2B(o: Person, tb: TradeOrBusiness, y: TaxableYear) kind empirical {
    label en official "the conducting of the game is not an activity ordinarily carried out on a commercial basis";
}
pub relation bingo_does_not_violate_state_or_local_law_513f2C(o: Person, tb: TradeOrBusiness, y: TaxableYear) kind empirical {
    label en official "the conducting of the game does not violate any State or local law";
}
pub relation bingo_game_within_513f2_definition(o: Person, tb: TradeOrBusiness, y: TaxableYear) kind institutional {
    label en official "the game is a bingo game within section 513(f)(2)";
}
@source(IRC_S513_F, quote = "For purposes of paragraph (1), the term \"bingo game\" means any game of bingo—")
@source(IRC_S513_F, quote = "(A) of a type in which usually—")
@source(IRC_S513_F, quote = "(i) the wagers are placed,")
@source(IRC_S513_F, quote = "(B) the conducting of which is not an activity ordinarily carried out on a commercial basis, and")
@source(IRC_S513_F, quote = "(C) the conducting of which does not violate any State or local law.")
rule BingoGameDefinition(o: Person, tb: TradeOrBusiness, y: TaxableYear) defeasible {
    label en official "section 513(f)(2): the three-part bingo game definition";
    when bingo_wagers_winners_and_prizes_in_presence_of_all_players_513f2A(o, tb, y);
    when bingo_not_ordinarily_carried_out_on_commercial_basis_513f2B(o, tb, y);
    when bingo_does_not_violate_state_or_local_law_513f2C(o, tb, y);
    then bingo_game_within_513f2_definition(o, tb, y);
}
// (h): low cost articles.
pub relation low_cost_article_distribution_513h(o: Person, distributee: Person, calendar_year: Integer, article_cost: Money) kind empirical {
    label en official "an item distributed by or on behalf of the organization to a distributee in the calendar year, with its cost to the organization";
}
pub relation aggregate_cost_of_articles_to_single_distributee_513h2B(o: Person, distributee: Person, calendar_year: Integer, amount: Money) kind institutional {
    label en official "the aggregate of the items distributed to a single distributee in the calendar year, treated as 1 article";
}
@source(IRC_S513_H, quote = "If more than 1 item is distributed by or on behalf of an organization to a single distributee in any calendar year, the aggregate of the items so distributed in such calendar year to such distributee shall be treated as 1 article for purposes of subparagraph (A).")
rule AggregateCostOfArticlesToSingleDistributee(o: Person, distributee: Person, calendar_year: Integer, first_cost: Money) defeasible {
    label en official "section 513(h)(2)(B): several items to the same distributee in a calendar year are one article";
    when low_cost_article_distribution_513h(o, distributee, calendar_year, first_cost);
    then aggregate_cost_of_articles_to_single_distributee_513h2B(o, distributee, calendar_year, sum all c: Money for d: Person where low_cost_article_distribution_513h(o, d, calendar_year, c) and d == distributee);
}
pub relation low_cost_article_limit_513h2A(y: TaxableYear, limit: Money) kind empirical {
    label en official "the section 513(h)(2)(A) limit for the taxable year: $5, increased for taxable years beginning after 1987 by the cost-of-living adjustment (calendar year 1987 base) — the published indexed amounts ($13.60 for 2025, $13.90 for 2026) are pinned in the parameter dataset LowCostArticleLimit513h2 where their Revenue Procedure is pinned";
}
pub relation aggregate_article_cost_within_limit_513h2(o: Person, distributee: Person, calendar_year: Integer, y: TaxableYear) kind institutional {
    label en official "the aggregate cost of the articles distributed to the distributee in the calendar year does not exceed the limit";
}
@source(IRC_S513_H, quote = "The term \"low cost article\" means any article which has a cost not in excess of $5 to the organization which distributes such item (or on whose behalf such item is distributed).")
@source(IRC_S513_H, quote = "If more than 1 item is distributed by or on behalf of an organization to a single distributee in any calendar year, the aggregate of the items so distributed in such calendar year to such distributee shall be treated as 1 article for purposes of subparagraph (A).")
rule AggregateArticleCostWithinLimit(o: Person, distributee: Person, calendar_year: Integer, y: TaxableYear, total: Money, limit: Money) defeasible {
    label en official "section 513(h)(2)(A)-(B): an article costing not in excess of the limit — an aggregate exactly at the limit qualifies";
    when aggregate_cost_of_articles_to_single_distributee_513h2B(o, distributee, calendar_year, total);
    when low_cost_article_limit_513h2A(y, limit);
    when total <= limit;
    then aggregate_article_cost_within_limit_513h2(o, distributee, calendar_year, y);
}
pub relation distribution_not_requested_by_distributee_513h3A(o: Person) kind empirical {
    label en official "the distribution is not made at the request of the distributee";
}
pub relation distribution_without_express_consent_513h3B(o: Person) kind empirical {
    label en official "the distribution is made without the express consent of the distributee";
}
pub relation articles_accompanied_by_contribution_request_513h3Ci(o: Person) kind empirical {
    label en official "the articles are accompanied by a request for a charitable contribution (section 170(c)) by the distributee to the organization";
}
pub relation articles_accompanied_by_statement_distributee_may_retain_513h3Cii(o: Person) kind empirical {
    label en official "the articles are accompanied by a statement that the distributee may retain the low cost article regardless of whether the distributee makes a charitable contribution";
}
pub relation distribution_incidental_to_solicitation_derived_513h3(o: Person) kind institutional {
    label en official "the distribution of low cost articles is treated as a distribution incidental to the solicitation of charitable contributions";
}
@source(IRC_S513_H, quote = "For purposes of this subsection, any distribution of low cost articles by an organization shall be treated as a distribution incidental to the solicitation of charitable contributions only if—")
@source(IRC_S513_H, quote = "(A) such distribution is not made at the request of the distributee,")
@source(IRC_S513_H, quote = "(B) such distribution is made without the express consent of the distributee, and")
@source(IRC_S513_H, quote = "(C) the articles so distributed are accompanied by—")
@source(IRC_S513_H, quote = "(i) a request for a charitable contribution (as defined in section 170(c)) by the distributee to such organization, and")
@source(IRC_S513_H, quote = "(ii) a statement that the distributee may retain the low cost article regardless of whether such distributee makes a charitable contribution to such organization.")
rule DistributionIncidentalToSolicitation(o: Person) defeasible {
    label en official "section 513(h)(3): unrequested, without express consent, accompanied by a contribution request and a retention statement";
    when distribution_not_requested_by_distributee_513h3A(o);
    when distribution_without_express_consent_513h3B(o);
    when articles_accompanied_by_contribution_request_513h3Ci(o);
    when articles_accompanied_by_statement_distributee_may_retain_513h3Cii(o);
    then distribution_incidental_to_solicitation_derived_513h3(o);
}
// (i): sponsorship payments.
pub relation payment_is_arrangement_free_of_substantial_return_benefit_513i2A(o: Person, payor: Person, y: TaxableYear) kind empirical {
    label en official "there is no arrangement or expectation that the payor will receive any substantial return benefit other than the use or acknowledgement of the name or logo (or product lines) of its trade or business in connection with the organization's activities";
}
pub relation acknowledgement_includes_advertising_513i2A(o: Person, payor: Person, y: TaxableYear) kind empirical {
    label en official "the use or acknowledgement includes advertising the payor's products or services, including messages containing qualitative or comparative language, price information or other indications of savings or value, an endorsement, or an inducement to purchase, sell or use the products or services";
}
pub relation payment_amount_contingent_on_attendance_or_exposure_513i2Bi_derived(o: Person, payor: Person, y: TaxableYear) kind empirical {
    label en official "the amount of the payment is contingent upon the level of attendance at events, broadcast ratings, or other factors indicating the degree of public exposure to events";
}
pub relation payment_for_periodical_use_513i2BiiI(o: Person, payor: Person, y: TaxableYear) kind empirical {
    label en official "the payment entitles the payor to the use or acknowledgement of its name or logo (or product lines) in regularly scheduled and printed material published by or on behalf of the payee that is not related to and primarily distributed in connection with a specific event";
}
pub relation payment_in_connection_with_qualified_convention_or_trade_show_513i2BiiII(o: Person, payor: Person, y: TaxableYear) kind empirical {
    label en official "the payment is made in connection with a qualified convention or trade show activity (subsection (d)(3)(B))";
}
pub relation qualified_sponsorship_payment_derived_513i2(o: Person, payor: Person, y: TaxableYear) kind institutional {
    label en official "the payment is a qualified sponsorship payment";
}
@source(IRC_S513_I, quote = "The term \"qualified sponsorship payment\" means any payment made by any person engaged in a trade or business with respect to which there is no arrangement or expectation that such person will receive any substantial return benefit other than the use or acknowledgement of the name or logo (or product lines) of such person's trade or business in connection with the activities of the organization that receives such payment. Such a use or acknowledgement does not include advertising such person's pr")
@source(IRC_S513_I, quote = "The term \"qualified sponsorship payment\" does not include any payment if the amount of such payment is contingent upon the level of attendance at one or more events, broadcast ratings, or other factors indicating the degree of public exposure to one or more events.")
@source(IRC_S513_I, quote = "The term \"qualified sponsorship payment\" does not include—")
@source(IRC_S513_I, quote = "(I) any payment which entitles the payor to the use or acknowledgement of the name or logo (or product lines) of the payor's trade or business in regularly scheduled and printed material published by or on behalf of the payee organization that is not related to and primarily distributed in connection with a specific event conducted by the payee organization, or")
@source(IRC_S513_I, quote = "(II) any payment made in connection with any qualified convention or trade show activity (as defined in subsection (d)(3)(B)).")
rule QualifiedSponsorshipPaymentDerived(o: Person, payor: Person, y: TaxableYear) defeasible {
    label en official "section 513(i)(2): a payment by a trade or business with no substantial return benefit, without advertising, not contingent on attendance or exposure, not for periodical use and not for a qualified convention or trade show";
    when payment_is_arrangement_free_of_substantial_return_benefit_513i2A(o, payor, y);
    unless acknowledgement_includes_advertising_513i2A(o, payor, y);
    unless payment_amount_contingent_on_attendance_or_exposure_513i2Bi_derived(o, payor, y);
    unless payment_for_periodical_use_513i2BiiI_for_payor(o, payor, y);
    unless payment_in_connection_with_qualified_convention_or_trade_show_513i2BiiII(o, payor, y);
    then qualified_sponsorship_payment_derived_513i2(o, payor, y);
}
pub relation payment_for_periodical_use_513i2BiiI_for_payor(o: Person, payor: Person, y: TaxableYear) kind institutional {
    label en official "helper: the periodical-use exclusion bound to the payor and the year (the exception atom that binds every head variable)";
}
rule PaymentForPeriodicalUseForPayor(o: Person, payor: Person, y: TaxableYear) defeasible {
    label en official "helper: a payment for periodical use by the payor";
    when payment_for_periodical_use_513i2BiiI(o, payor, y);
    then payment_for_periodical_use_513i2BiiI_for_payor(o, payor, y);
}
pub relation payment_portion_qualified_separately_513i3(o: Person, payor: Person, y: TaxableYear, qualified_portion: Money, other_portion: Money) kind institutional {
    label en official "the portion that would be a qualified sponsorship payment if made separately and the other portion are treated as separate payments";
}
pub relation payment_split_into_portions_513i3(o: Person, payor: Person, y: TaxableYear, qualified_portion: Money, other_portion: Money) kind empirical {
    label en official "a payment consisting of a portion that would, if made separately, be a qualified sponsorship payment and another portion";
}
@source(IRC_S513_I, quote = "For purposes of this subsection, to the extent that a portion of a payment would (if made as a separate payment) be a qualified sponsorship payment, such portion of such payment and the other portion of such payment shall be treated as separate payments.")
rule PaymentPortionsTreatedAsSeparatePayments(o: Person, payor: Person, y: TaxableYear, q: Money, other: Money) defeasible {
    label en official "section 513(i)(3): the portions of a mixed payment are separate payments";
    when payment_split_into_portions_513i3(o, payor, y, q, other);
    then payment_portion_qualified_separately_513i3(o, payor, y, q, other);
}

// ---------------------------------------------------------------------
// Section 514.
// ---------------------------------------------------------------------

pub relation property_real_property_leased_to_medical_clinic_primarily_for_related_purposes_514b1flush(tb: TradeOrBusiness, o: Person, y: TaxableYear) kind empirical {
    label en official "the property is real property subject to a lease to a medical clinic entered into primarily for purposes substantially related (aside from the organization's need for income or funds) to the exercise or performance of its exempt purpose, such as by tying the clinic's use to the organization's hospital";
}
pub relation substantially_all_use_treated_as_substantially_related_514b1flush(tb: TradeOrBusiness, o: Person, y: TaxableYear) kind institutional {
    label en official "substantially all the use of the property is considered substantially related to the organization's exempt purpose";
}
@source(IRC_S514_B, quote = "For purposes of subparagraph (A), substantially all the use of a property shall be considered to be substantially related to the exercise or performance by an organization of its charitable, educational, or other purpose or function constituting the basis for its exemption under section 501 if such property is real property subject to a lease to a medical clinic entered into primarily for purposes which are substantially related (aside from the need of such organization for income or funds or th")
rule MedicalClinicLeaseIsSubstantiallyRelatedUse(tb: TradeOrBusiness, o: Person, y: TaxableYear) defeasible {
    label en official "section 514(b)(1)(A), last sentence: a lease of real property to a medical clinic for related purposes";
    when property_real_property_leased_to_medical_clinic_primarily_for_related_purposes_514b1flush(tb, o, y);
    then substantially_all_use_treated_as_substantially_related_514b1flush(tb, o, y);
}
pub relation property_used_by_related_exempt_organization_514b2(tb: TradeOrBusiness, o: Person, related: Person, y: TaxableYear) kind empirical {
    label en official "the property is used by an exempt organization which is related to the organization";
}
pub relation use_by_related_organization_treated_as_use_by_organization_514b2(tb: TradeOrBusiness, o: Person, y: TaxableYear) kind institutional {
    label en official "for paragraphs (1)(A), (C) and (D) the use by the related exempt organization is treated as use by the organization";
}
@source(IRC_S514_B, quote = "For purposes of applying paragraphs (1) (A), (C), and (D), the use of any property by an exempt organization which is related to an organization shall be treated as use by such organization.")
rule UseByRelatedExemptOrganizationTreatedAsOwnUse(tb: TradeOrBusiness, o: Person, related: Person, y: TaxableYear) defeasible {
    label en official "section 514(b)(2): use by a related exempt organization counts as the organization's own use";
    when property_used_by_related_exempt_organization_514b2(tb, o, related, y);
    when exempt_organization(related, y);
    then use_by_related_organization_treated_as_use_by_organization_514b2(tb, o, y);
}
// (b)(3): the church rules and conversion.
pub relation church_or_convention_or_association_of_churches_514b3E(o: Person) kind empirical {
    label en official "the organization is a church or a convention or association of churches";
}
pub relation neighborhood_land_not_debt_financed_church_514b3E(o: Person, tb: TradeOrBusiness, acquired_on: Date, current_date: Date) kind institutional {
    label en official "section 514(b)(3) as applied to a church: a 15-year period, whether or not the land meets the neighborhood test";
}
@source(IRC_S514_B, quote = "In applying this paragraph to a church or convention or association of churches, in lieu of the 10-year period referred to in subparagraphs (A) and (B) a 15-year period shall be applied, and subparagraphs (A) and (B)(ii) shall apply whether or not the acquired land meets the neighborhood test.")
rule NeighborhoodLandNotDebtFinancedChurch(o: Person, tb: TradeOrBusiness, acquired_on: Date, current_date: Date) defeasible {
    label en official "section 514(b)(3)(E): a church gets a 15-year period instead of 10 years, and subparagraphs (A) and (B)(ii) apply whether or not the land is in the neighborhood — the day 15 years after acquisition is outside the period";
    when church_or_convention_or_association_of_churches_514b3E(o);
    when neighborhood_land_acquired_for_future_exempt_use(o, tb, acquired_on);
    when determination_date_514(o, tb, current_date);
    when current_date < add_calendar_period(acquired_on, 15 calendar_year);
    unless abandoned_intent_to_use_land_514b3(o, tb, acquired_on, current_date);
    then neighborhood_land_not_debt_financed_church_514b3E(o, tb, acquired_on, current_date);
}
pub relation land_converted_to_exempt_use_on_514b3B(o: Person, tb: TradeOrBusiness, acquired_on: Date, converted_on: Date) kind empirical {
    label en official "the organization converted the acquired land to the paragraph (1)(A) use on the date";
}
pub relation land_outside_neighborhood_or_unable_to_show_reasonable_certainty_514b3B(o: Person, tb: TradeOrBusiness, acquired_on: Date) kind empirical {
    label en official "the acquired land is not in the neighborhood, or after the first 5 years the organization is unable to establish to the Secretary's satisfaction that it is reasonably certain the land will be so used within the 10-year period";
}
pub relation land_not_debt_financed_before_conversion_514b3B(o: Person, tb: TradeOrBusiness, acquired_on: Date, current_date: Date) kind institutional {
    label en official "the real property is not debt-financed property for any period before its conversion within the 10-year period";
}
@source(IRC_S514_B, quote = "If the first sentence of subparagraph (A) is inapplicable only because—")
@source(IRC_S514_B, quote = "(i) the acquired land is not in the neighborhood referred to in subparagraph (A), or")
@source(IRC_S514_B, quote = "(ii) the organization (for the period after the first 5 years of the 10-year period) is unable to establish to the satisfaction of the Secretary that it is reasonably certain that the land will be used in the manner described in paragraph (1)(A) before the expiration of the 10-year period,")
@source(IRC_S514_B, quote = "but the land is converted to such use by the organization within the 10-year period, the real property (subject to the provisions of subparagraph (D)) shall not be treated as debt-financed property for any period before such conversion. For purposes of this subparagraph, land shall not be treated as used in the manner described in paragraph (1)(A) by reason of the use made of any structure which was on the land when acquired by the organization.")
rule LandNotDebtFinancedBeforeConversion(o: Person, tb: TradeOrBusiness, acquired_on: Date, converted_on: Date, current_date: Date) defeasible {
    label en official "section 514(b)(3)(B): converted to the exempt use within 10 years, so no debt-financed status before conversion — conversion on the last day of the period is within it";
    when land_outside_neighborhood_or_unable_to_show_reasonable_certainty_514b3B(o, tb, acquired_on);
    when land_converted_to_exempt_use_on_514b3B(o, tb, acquired_on, converted_on);
    when converted_on <= add_calendar_period(acquired_on, 10 calendar_year);
    when determination_date_514(o, tb, current_date);
    when current_date < converted_on;
    then land_not_debt_financed_before_conversion_514b3B(o, tb, acquired_on, current_date);
}
pub relation structure_on_land_when_acquired_514b3C(o: Person, tb: TradeOrBusiness) kind empirical {
    label en official "there was a structure on the land when it was acquired";
}
pub relation intended_future_use_requires_demolition_of_structure_514b3Ci(o: Person, tb: TradeOrBusiness) kind empirical {
    label en official "the intended future use of the land requires that the structure be demolished or removed";
}
pub relation structure_erected_after_acquisition_514b3Cii(o: Person, tb: TradeOrBusiness) kind empirical {
    label en official "the structure was erected on the land after its acquisition";
}
pub relation property_subject_to_pre_1976_business_lease_514b3Ciii(o: Person, tb: TradeOrBusiness) kind empirical {
    label en official "the property is subject to a lease which is a business lease (as defined in section 514 immediately before the Tax Reform Act of 1976)";
}
pub relation neighborhood_land_rule_applies_to_land_514b3C(o: Person, tb: TradeOrBusiness) kind institutional {
    label en official "subparagraphs (A) and (B) apply to the land and to its structure as paragraph (3)(C) provides";
}
@source(IRC_S514_B, quote = "Subparagraphs (A) and (B)—")
@source(IRC_S514_B, quote = "(i) shall apply with respect to any structure on the land when acquired by the organization, or to the land occupied by the structure, only if (and so long as) the intended future use of the land in the manner described in paragraph (1)(A) requires that the structure be demolished or removed in order to use the land in such manner;")
@source(IRC_S514_B, quote = "(ii) shall not apply to structures erected on the land after the acquisition of the land; and")
@source(IRC_S514_B, quote = "(iii) shall not apply to property subject to a lease which is a business lease (as defined in this section immediately before the enactment of the Tax Reform Act of 1976).")
rule NeighborhoodLandRuleAppliesToLandAndDemolishedStructure(o: Person, tb: TradeOrBusiness) defeasible {
    label en official "section 514(b)(3)(C): the rule reaches an existing structure only if the intended use requires its demolition, never a structure erected later or a pre-1976 business lease";
    when structure_on_land_when_acquired_514b3C(o, tb);
    when intended_future_use_requires_demolition_of_structure_514b3Ci(o, tb);
    unless structure_erected_after_acquisition_514b3Cii_for(o, tb);
    unless property_subject_to_pre_1976_business_lease_514b3Ciii_for(o, tb);
    then neighborhood_land_rule_applies_to_land_514b3C(o, tb);
}
pub relation structure_erected_after_acquisition_514b3Cii_for(o: Person, tb: TradeOrBusiness) kind institutional {
    label en official "helper: a post-acquisition structure (exception atom binding every head variable)";
}
rule StructureErectedAfterAcquisitionFor(o: Person, tb: TradeOrBusiness) defeasible {
    label en official "helper";
    when structure_erected_after_acquisition_514b3Cii(o, tb);
    then structure_erected_after_acquisition_514b3Cii_for(o, tb);
}
pub relation property_subject_to_pre_1976_business_lease_514b3Ciii_for(o: Person, tb: TradeOrBusiness) kind institutional {
    label en official "helper: a pre-1976 business lease (exception atom binding every head variable)";
}
rule PropertySubjectToPre1976BusinessLeaseFor(o: Person, tb: TradeOrBusiness) defeasible {
    label en official "helper";
    when property_subject_to_pre_1976_business_lease_514b3Ciii(o, tb);
    then property_subject_to_pre_1976_business_lease_514b3Ciii_for(o, tb);
}
// (c)(1): acquisition indebtedness.
pub enum AcquisitionIndebtednessKind514c1 { IncurredInAcquiringOrImproving, IncurredBeforeButForTheAcquisition, IncurredAfterButForAndReasonablyForeseeable }
pub relation indebtedness_kind_514c1(o: Person, tb: TradeOrBusiness, debt: Text, kind: AcquisitionIndebtednessKind514c1) kind empirical {
    label en official "the indebtedness: incurred in acquiring or improving the property (A); incurred before the acquisition or improvement and not incurred but for it (B); incurred after it, not incurred but for it, with the incurrence reasonably foreseeable at the time of the acquisition or improvement (C)";
}
pub relation acquisition_indebtedness_514c1(o: Person, tb: TradeOrBusiness, debt: Text) kind institutional {
    label en official "the indebtedness is acquisition indebtedness with respect to the property";
}
@source(IRC_S514_C, quote = "(A) the indebtedness incurred by the organization in acquiring or improving such property;")
@source(IRC_S514_C, quote = "(B) the indebtedness incurred before the acquisition or improvement of such property if such indebtedness would not have been incurred but for such acquisition or improvement; and")
@source(IRC_S514_C, quote = "(C) the indebtedness incurred after the acquisition or improvement of such property if such indebtedness would not have been incurred but for such acquisition or improvement and the incurrence of such indebtedness was reasonably foreseeable at the time of such acquisition or improvement.")
rule AcquisitionIndebtednessDefinition(o: Person, tb: TradeOrBusiness, debt: Text, k: AcquisitionIndebtednessKind514c1) defeasible {
    label en official "section 514(c)(1)(A)-(C): the three kinds of acquisition indebtedness";
    when indebtedness_kind_514c1(o, tb, debt, k);
    then acquisition_indebtedness_514c1(o, tb, debt);
}
pub relation state_tax_or_assessment_lien_attaches_before_due_514c2C(o: Person, tb: TradeOrBusiness, lien: Text) kind empirical {
    label en official "State law provides that a lien for taxes or assessments made by a State or political subdivision attaches to property before the taxes or assessments become due and payable";
}
pub relation taxes_or_assessments_due_and_payable_514c2C(o: Person, tb: TradeOrBusiness, lien: Text) kind empirical {
    label en official "the taxes or assessments have become due and payable";
}
pub relation organization_has_had_opportunity_to_pay_under_state_law_514c2C(o: Person, tb: TradeOrBusiness, lien: Text) kind empirical {
    label en official "the organization has had an opportunity to pay the taxes or assessments in accordance with State law";
}
pub relation lien_treated_similar_to_mortgage_514c2C(o: Person, tb: TradeOrBusiness, lien: Text) kind institutional {
    label en official "the lien is treated as similar to a mortgage within the meaning of subparagraph (A), but only after the taxes or assessments are due and the organization had an opportunity to pay";
}
@source(IRC_S514_C, quote = "Where State law provides that—")
@source(IRC_S514_C, quote = "(i) a lien for taxes, or")
@source(IRC_S514_C, quote = "(ii) a lien for assessments,")
@source(IRC_S514_C, quote = "made by a State or a political subdivision thereof attaches to property prior to the time when such taxes or assessments become due and payable, then such lien shall be treated as similar to a mortgage (within the meaning of subparagraph (A)) but only after such taxes or assessments become due and payable and the organization has had an opportunity to pay such taxes or assessments in accordance with State law.")
rule LienTreatedSimilarToMortgage(o: Person, tb: TradeOrBusiness, lien: Text) defeasible {
    label en official "section 514(c)(2)(C): a tax or assessment lien is a mortgage-like lien only once due and the organization has had a chance to pay";
    when state_tax_or_assessment_lien_attaches_before_due_514c2C(o, tb, lien);
    when taxes_or_assessments_due_and_payable_514c2C(o, tb, lien);
    when organization_has_had_opportunity_to_pay_under_state_law_514c2C(o, tb, lien);
    then lien_treated_similar_to_mortgage_514c2C(o, tb, lien);
}
// (c)(5): annuities.
pub relation annuity_value_514c5A(o: Person, annuity: Text, amount: Money) kind empirical {
    label en official "the value of the annuity at the time of the exchange";
}
pub relation value_of_property_received_in_exchange_514c5A(o: Person, annuity: Text, amount: Money) kind empirical {
    label en official "the value of the property received in the exchange";
}
pub relation annuity_is_sole_consideration_514c5A(o: Person, annuity: Text) kind empirical {
    label en official "the annuity is the sole consideration (other than a mortgage to which paragraph (2)(B) applies) issued in exchange for the property";
}
pub relation annuity_payable_over_lives_of_one_or_two_individuals_in_being_514c5B(o: Person, annuity: Text) kind empirical {
    label en official "the annuity is payable over the life of one individual in being at the time it is issued, or the lives of two individuals in being at that time";
}
pub relation contract_guarantees_no_minimum_or_maximum_payments_514c5Ci(o: Person, annuity: Text) kind empirical {
    label en official "the contract does not guarantee a minimum amount of payments or specify a maximum amount of payments";
}
pub relation contract_does_not_adjust_by_reference_to_income_514c5Cii(o: Person, annuity: Text) kind empirical {
    label en official "the contract does not provide for any adjustment of the annuity payments by reference to the income received from the transferred property or any other property";
}
pub relation annuity_obligation_not_acquisition_indebtedness_514c5(o: Person, annuity: Text) kind institutional {
    label en official "the obligation to pay the annuity is not acquisition indebtedness";
}
@source(IRC_S514_C, quote = "For purposes of this section, the term \"acquisition indebtedness\" does not include an obligation to pay an annuity which—")
@source(IRC_S514_C, quote = "(A) is the sole consideration (other than a mortgage to which paragraph (2)(B) applies) issued in exchange for property if, at the time of the exchange, the value of the annuity is less than 90 percent of the value of the property received in the exchange,")
@source(IRC_S514_C, quote = "(B) is payable over the life of one individual in being at the time the annuity is issued, or over the lives of two individuals in being at such time, and")
@source(IRC_S514_C, quote = "(C) is payable under a contract which—")
@source(IRC_S514_C, quote = "(i) does not guarantee a minimum amount of payments or specify a maximum amount of payments, and")
@source(IRC_S514_C, quote = "(ii) does not provide for any adjustment of the amount of the annuity payments by reference to the income received from the transferred property or any other property.")
rule AnnuityObligationNotAcquisitionIndebtedness(o: Person, annuity: Text, value: Money, property_value: Money) defeasible {
    label en official "section 514(c)(5): a sole-consideration annuity worth less than 90 percent of the property, payable over one or two lives, without guaranteed or maximum payments or income adjustment — exactly 90 percent is not less than 90 percent";
    when annuity_is_sole_consideration_514c5A(o, annuity);
    when annuity_value_514c5A(o, annuity, value);
    when value_of_property_received_in_exchange_514c5A(o, annuity, property_value);
    when value * 100 < property_value * 90;
    when annuity_payable_over_lives_of_one_or_two_individuals_in_being_514c5B(o, annuity);
    when contract_guarantees_no_minimum_or_maximum_payments_514c5Ci(o, annuity);
    when contract_does_not_adjust_by_reference_to_income_514c5Cii(o, annuity);
    then annuity_obligation_not_acquisition_indebtedness_514c5(o, annuity);
}
// (c)(6): FHA-insured and small business investment company debt.
pub relation obligation_amount_514c6(o: Person, obligation: Text, amount: Money) kind empirical {
    label en official "the amount of the obligation";
}
pub relation obligation_insured_by_fha_amount_514c6Ai(o: Person, obligation: Text, insured_amount: Money) kind empirical {
    label en official "the extent to which the obligation is insured by the Federal Housing Administration to finance the purchase, rehabilitation or construction of housing for low and moderate income persons";
}
pub relation fha_insured_portion_not_acquisition_indebtedness_514c6Ai(o: Person, obligation: Text, amount: Money) kind institutional {
    label en official "the FHA-insured portion of the obligation is not acquisition indebtedness";
}
@source(IRC_S514_C, quote = "(i) an obligation, to the extent that it is insured by the Federal Housing Administration, to finance the purchase, rehabilitation, or construction of housing for low and moderate income persons, or")
rule FhaInsuredPortionNotAcquisitionIndebtedness(o: Person, obligation: Text, insured: Money) defeasible {
    label en official "section 514(c)(6)(A)(i): the obligation to the extent it is FHA-insured";
    when obligation_insured_by_fha_amount_514c6Ai(o, obligation, insured);
    then fha_insured_portion_not_acquisition_indebtedness_514c6Ai(o, obligation, insured);
}
pub relation sbic_debenture_licensed_after_2004_under_303a_and_held_or_guaranteed_by_sba_514c6Aii(o: Person, debenture: Text) kind empirical {
    label en official "the indebtedness is incurred by a small business investment company licensed after the enactment of the American Jobs Creation Act of 2004 under the Small Business Investment Act of 1958, evidenced by a debenture issued under section 303(a) of that Act and held or guaranteed by the Small Business Administration";
}
pub relation exempt_organization_share_of_sbic_capital_or_profits_percent_514c6Bi(o: Person, sbic: Person, pct: Decimal) kind empirical {
    label en official "the percentage of the capital or profits interest in the company owned by an organization exempt under this title (other than a governmental unit)";
}
pub relation exempt_organizations_aggregate_share_of_sbic_percent_514c6Bii(sbic: Person, pct: Decimal) kind empirical {
    label en official "the aggregate percentage of the capital or profits interest owned by exempt organizations (including governmental units other than agencies or instrumentalities of the United States)";
}
pub relation sbic_exception_disapplied_514c6B(sbic: Person) kind institutional {
    label en official "subparagraph (A)(ii) does not apply to the company during the period";
}
@source(IRC_S514_C, quote = "Subparagraph (A)(ii) shall not apply with respect to any small business investment company during any period that—")
@source(IRC_S514_C, quote = "(i) any organization which is exempt from tax under this title (other than a governmental unit) owns more than 25 percent of the capital or profits interest in such company, or")
rule SbicExceptionDisappliedByLargeSingleHolder(o: Person, sbic: Person, pct: Decimal) defeasible {
    label en official "section 514(c)(6)(B)(i): an exempt organization owning more than 25 percent — exactly 25 percent does not disapply";
    when exempt_organization_share_of_sbic_capital_or_profits_percent_514c6Bi(o, sbic, pct);
    when pct > 25.0;
    then sbic_exception_disapplied_514c6B(sbic);
}
@source(IRC_S514_C, quote = "(ii) organizations which are exempt from tax under this title (including governmental units other than any agency or instrumentality of the United States) own, in the aggregate, 50 percent or more of the capital or profits interest in such company.")
rule SbicExceptionDisappliedByAggregateExemptOwnership(sbic: Person, pct: Decimal) defeasible {
    label en official "section 514(c)(6)(B)(ii): exempt organizations owning in the aggregate 50 percent or more — exactly 50 percent disapplies";
    when exempt_organizations_aggregate_share_of_sbic_percent_514c6Bii(sbic, pct);
    when pct >= 50.0;
    then sbic_exception_disapplied_514c6B(sbic);
}
pub relation sbic_debenture_not_acquisition_indebtedness_514c6Aii(o: Person, sbic: Person, debenture: Text) kind institutional {
    label en official "the debenture is not acquisition indebtedness";
}
@source(IRC_S514_C, quote = "(ii) indebtedness incurred by a small business investment company licensed after the date of the enactment of the American Jobs Creation Act of 2004 under the Small Business Investment Act of 1958 if such indebtedness is evidenced by a debenture—")
@source(IRC_S514_C, quote = "(I) issued by such company under section 303(a) of such Act, and")
@source(IRC_S514_C, quote = "(II) held or guaranteed by the Small Business Administration.")
rule SbicDebentureNotAcquisitionIndebtedness(o: Person, sbic: Person, debenture: Text) defeasible {
    label en official "section 514(c)(6)(A)(ii): a qualifying SBIC debenture, except while the ownership limits of (B) are exceeded";
    when sbic_debenture_licensed_after_2004_under_303a_and_held_or_guaranteed_by_sba_514c6Aii(o, debenture);
    when debenture_issued_by_sbic_514c6(o, sbic, debenture);
    unless sbic_exception_disapplied_for_debenture_514c6B(o, sbic, debenture);
    then sbic_debenture_not_acquisition_indebtedness_514c6Aii(o, sbic, debenture);
}
pub relation debenture_issued_by_sbic_514c6(o: Person, sbic: Person, debenture: Text) kind empirical {
    label en official "the debenture was issued by the small business investment company";
}
pub relation sbic_exception_disapplied_for_debenture_514c6B(o: Person, sbic: Person, debenture: Text) kind institutional {
    label en official "helper: the ownership limits disapply the exception for the debenture's issuer (the exception atom that binds every head variable)";
}
rule SbicExceptionDisappliedForDebenture(o: Person, sbic: Person, debenture: Text) defeasible {
    label en official "helper";
    when debenture_issued_by_sbic_514c6(o, sbic, debenture);
    when sbic_exception_disapplied_514c6B(sbic);
    then sbic_exception_disapplied_for_debenture_514c6B(o, sbic, debenture);
}
// (c)(7): average acquisition indebtedness on a sale.
pub relation highest_acquisition_indebtedness_in_12_months_before_disposition_514c7(o: Person, tb: TradeOrBusiness, amount: Money) kind empirical {
    label en official "the highest amount of the acquisition indebtedness with respect to the property during the 12-month period ending with the date of the sale or other disposition";
}
pub relation average_acquisition_indebtedness_for_gain_or_loss_percentage_514c7(o: Person, tb: TradeOrBusiness, amount: Money) kind institutional {
    label en official "for computing the percentage of gain or loss on a disposition, the average acquisition indebtedness is the highest amount during the 12 months ending with the disposition";
}
@source(IRC_S514_C, quote = "For purposes of this section, the term \"average acquisition indebtedness\" for any taxable year with respect to a debt-financed property means the average amount, determined under regulations prescribed by the Secretary of the acquisition indebtedness during the period the property is held by the organization during the taxable year, except that for the purpose of computing the percentage of any gain or loss to be taken into account on a sale or other disposition of debt-financed property, such t")
rule AverageAcquisitionIndebtednessOnDisposition(o: Person, tb: TradeOrBusiness, highest: Money) defeasible {
    label en official "section 514(c)(7): on a sale the highest acquisition indebtedness during the preceding 12 months";
    when highest_acquisition_indebtedness_in_12_months_before_disposition_514c7(o, tb, highest);
    then average_acquisition_indebtedness_for_gain_or_loss_percentage_514c7(o, tb, highest);
}
// (c)(8): securities loans.
pub relation obligation_to_return_collateral_security_514c8C(o: Person, obligation: Text) kind empirical {
    label en official "the obligation is an obligation to return collateral security for a securities loan";
}
pub relation collateral_return_obligation_not_acquisition_indebtedness_514c8C(o: Person, obligation: Text) kind institutional {
    label en official "an obligation to return collateral security is not acquisition indebtedness";
}
@source(IRC_S514_C, quote = "(C) an obligation to return collateral security shall not be treated as acquisition indebtedness (as defined in paragraph (1)).")
rule CollateralReturnObligationNotAcquisitionIndebtedness(o: Person, obligation: Text) defeasible {
    label en official "section 514(c)(8)(C)";
    when obligation_to_return_collateral_security_514c8C(o, obligation);
    then collateral_return_obligation_not_acquisition_indebtedness_514c8C(o, obligation);
}
pub relation securities_loan_payment_derived_from_loaned_securities_514c8A(loan: Text) kind institutional {
    label en official "payments with respect to securities loans are deemed derived from the securities loaned and not from collateral security or its investment";
}
@source(IRC_S514_C, quote = "(A) payments with respect to securities loans (as defined in section 512(a)(5)) shall be deemed to be derived from the securities loaned and not from collateral security or the investment of collateral security from such loans,")
rule SecuritiesLoanPaymentDerivedFromLoanedSecurities(loan: Text, k: SecuritiesLoanPayment512a5A) defeasible {
    label en official "section 514(c)(8)(A): the source of securities loan payments is the loaned securities";
    when payment_with_respect_to_securities_loan_512a5(loan, k);
    then securities_loan_payment_derived_from_loaned_securities_514c8A(loan);
}
pub relation deductions_connected_with_collateral_deemed_connected_with_securities_loaned_514c8B(loan: Text) kind institutional {
    label en official "deductions directly connected with collateral security or its investment are deemed directly connected with the securities loaned";
}
pub relation deductions_directly_connected_with_collateral_or_its_investment_514c8B(loan: Text) kind empirical {
    label en official "the deductions are directly connected with collateral security for the loan or the investment of collateral";
}
@source(IRC_S514_C, quote = "(B) any deductions which are directly connected with collateral security for such loan, or with the investment of collateral security, shall be deemed to be deductions which are directly connected with the securities loaned, and")
rule DeductionsConnectedWithCollateralDeemedConnectedWithSecuritiesLoaned(loan: Text) defeasible {
    label en official "section 514(c)(8)(B)";
    when deductions_directly_connected_with_collateral_or_its_investment_514c8B(loan);
    then deductions_connected_with_collateral_deemed_connected_with_securities_loaned_514c8B(loan);
}
// (c)(9)(E)-(H).
pub relation partner_income_share_percent_514c9Ei(o: Person, partnership: Person, pct: Decimal) kind empirical {
    label en official "the qualified organization partner's largest possible share of overall partnership income for any taxable year, as a percentage";
}
pub relation partner_smallest_loss_share_percent_514c9Ei(o: Person, partnership: Person, pct: Decimal) kind empirical {
    label en official "the qualified organization partner's share of the overall partnership loss for the taxable year for which its loss share is the smallest, as a percentage";
}
pub relation allocations_have_substantial_economic_effect_514c9EiII(partnership: Person) kind empirical {
    label en official "each allocation with respect to the partnership has substantial economic effect within the meaning of section 704(b)(2) — EXTERNAL_DEPENDENCY on the section 704(b) owner";
}
pub relation partnership_meets_514c9E_requirements(o: Person, partnership: Person) kind institutional {
    label en official "the partnership meets the requirements of subparagraph (E)";
}
@source(IRC_S514_C, quote = "A partnership meets the requirements of this subparagraph if—")
@source(IRC_S514_C, quote = "(I) the allocation of items to any partner which is a qualified organization cannot result in such partner having a share of the overall partnership income for any taxable year greater than such partner's share of the overall partnership loss for the taxable year for which such partner's loss share will be the smallest, and")
@source(IRC_S514_C, quote = "(II) each allocation with respect to the partnership has substantial economic effect within the meaning of section 704(b)(2).")
rule PartnershipMeets514c9E(o: Person, partnership: Person, income_share: Decimal, loss_share: Decimal) defeasible {
    label en official "section 514(c)(9)(E)(i): the qualified partner's income share can never exceed its smallest loss share, and allocations have substantial economic effect — equal shares qualify";
    when partner_income_share_percent_514c9Ei(o, partnership, income_share);
    when partner_smallest_loss_share_percent_514c9Ei(o, partnership, loss_share);
    when income_share <= loss_share;
    when allocations_have_substantial_economic_effect_514c9EiII(partnership);
    then partnership_meets_514c9E_requirements(o, partnership);
}
pub relation disqualified_holder_of_c25_organization_514c9Fiii(holder: Person, c25_org: Person) kind empirical {
    label en official "the shareholder or beneficiary is not described in clause (i) or (ii) of subparagraph (C)";
}
pub relation pro_rata_share_of_c25_income_described_in_514c9Fii_I(holder: Person, c25_org: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the holder's pro rata share of gross income of the section 501(c)(25) organization that would (but for this paragraph) be treated under subsection (a) as derived from an unrelated trade or business";
}
pub relation pro_rata_share_of_c25_deductions_described_in_514c9Fii_II(holder: Person, c25_org: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the holder's pro rata share of deductions that would (but for this paragraph) be allowable under subsection (a)(2) in computing unrelated business taxable income";
}
pub relation disqualified_holder_ubti_inclusion_514c9Fi(holder: Person, c25_org: Person, y: TaxableYear, gross_income: Money, deductions: Money) kind institutional {
    label en official "the disqualified holder takes into account, in computing its unrelated business taxable income, its pro rata share of the gross income and deductions, in the taxable year in which or with which the organization's year ends";
}
@source(IRC_S514_C, quote = "In computing under section 512 the unrelated business taxable income of a disqualified holder of an interest in an organization described in section 501(c)(25), there shall be taken into account—")
@source(IRC_S514_C, quote = "(I) as gross income derived from an unrelated trade or business, such holder's pro rata share of the items of income described in clause (ii)(I) of such organization, and")
@source(IRC_S514_C, quote = "(II) as deductions allowable in computing unrelated business taxable income, such holder's pro rata share of the items of deduction described in clause (ii)(II) of such organization.")
@source(IRC_S514_C, quote = "Such amounts shall be taken into account for the taxable year of the holder in which (or with which) the taxable year of such organization ends.")
@source(IRC_S514_C, quote = "For purposes of clause (i)—")
@source(IRC_S514_C, quote = "(I) gross income is described in this clause to the extent such income would (but for this paragraph) be treated under subsection (a) as derived from an unrelated trade or business, and")
@source(IRC_S514_C, quote = "(II) any deduction is described in this clause to the extent it would (but for this paragraph) be allowable under subsection (a)(2) in computing unrelated business taxable income.")
@source(IRC_S514_C, quote = "For purposes of this subparagraph, the term \"disqualified holder\" means any shareholder (or beneficiary) which is not described in clause (i) or (ii) of subparagraph (C).")
rule DisqualifiedHolderUbtiInclusion(holder: Person, c25_org: Person, y: TaxableYear, gross: Money, ded: Money) defeasible {
    label en official "section 514(c)(9)(F): a disqualified holder's UBTI includes its pro rata share of the section 501(c)(25) organization's income and deductions";
    when section_501c25(c25_org, y);
    when disqualified_holder_of_c25_organization_514c9Fiii(holder, c25_org);
    when pro_rata_share_of_c25_income_described_in_514c9Fii_I(holder, c25_org, y, gross);
    when pro_rata_share_of_c25_deductions_described_in_514c9Fii_II(holder, c25_org, y, ded);
    then disqualified_holder_ubti_inclusion_514c9Fi(holder, c25_org, y, gross, ded);
}
pub relation leasable_floor_space_covered_by_lease_percent_514c9Gi(o: Person, lease: Text, pct: Decimal) kind empirical {
    label en official "the percentage of the leasable floor space in a building (or complex of buildings) covered by the lease";
}
pub relation lease_on_commercially_reasonable_terms_514c9G(o: Person, lease: Text) kind empirical {
    label en official "the lease (or financing) is on commercially reasonable terms";
}
pub relation lease_disregarded_for_514c9Biii_iv_514c9Gi(o: Person, lease: Text) kind institutional {
    label en official "the lease to a person described in clause (iii) or (iv) of subparagraph (B) is disregarded";
}
@source(IRC_S514_C, quote = "Except as otherwise provided by regulations—")
@source(IRC_S514_C, quote = "For purposes of clauses (iii) and (iv) of subparagraph (B), a lease to a person described in such clause (iii) or (iv) shall be disregarded if no more than 25 percent of the leasable floor space in a building (or complex of buildings) is covered by the lease and if the lease is on commercially reasonable terms.")
rule LeaseDisregardedSmallSpaceCommerciallyReasonable(o: Person, lease: Text, pct: Decimal) defeasible {
    label en official "section 514(c)(9)(G)(i): no more than 25 percent of the leasable floor space and commercially reasonable terms — exactly 25 percent qualifies";
    when leasable_floor_space_covered_by_lease_percent_514c9Gi(o, lease, pct);
    when pct <= 25.0;
    when lease_on_commercially_reasonable_terms_514c9G(o, lease);
    then lease_disregarded_for_514c9Biii_iv_514c9Gi(o, lease);
}
pub relation financing_on_commercially_reasonable_terms_514c9Gii(o: Person, financing: Text) kind empirical {
    label en official "the financing provided by a person described in clause (iii) or (iv) is on commercially reasonable terms";
}
pub relation clause_v_of_514c9B_not_applicable_514c9Gii(o: Person, financing: Text) kind institutional {
    label en official "clause (v) of subparagraph (B) does not apply to the financing";
}
@source(IRC_S514_C, quote = "Clause (v) of subparagraph (B) shall not apply if the financing is on commercially reasonable terms.")
rule ClauseVNotApplicableForCommerciallyReasonableFinancing(o: Person, financing: Text) defeasible {
    label en official "section 514(c)(9)(G)(ii): commercially reasonable financing does not trigger clause (v)";
    when financing_on_commercially_reasonable_terms_514c9Gii(o, financing);
    then clause_v_of_514c9B_not_applicable_514c9Gii(o, financing);
}
pub relation financial_institution_gain_is_ordinary_income_514c9HiiI(sale: Text) kind empirical {
    label en official "the qualified organization acquires property described in clause (iii) from a financial institution and any gain recognized by the institution is ordinary income";
}
pub relation stated_principal_amount_of_financing_514c9HiiII(sale: Text, amount: Money) kind empirical {
    label en official "the stated principal amount of the financing provided by the financial institution";
}
pub relation outstanding_indebtedness_of_institution_before_acquisition_514c9HiiII(sale: Text, amount: Money) kind empirical {
    label en official "the outstanding indebtedness (including accrued but unpaid interest) of the financial institution with respect to the property immediately before the acquisition";
}
pub relation present_value_of_contingent_payments_514c9HiiIII(sale: Text, amount: Money) kind empirical {
    label en official "the present value (as of the sale, using the applicable Federal rate under section 1274(d)) of the maximum amount payable under the financing that is determined by reference to the revenue, income or profits derived from the property";
}
pub relation total_purchase_price_including_contingent_payments_514c9HiiIII(sale: Text, amount: Money) kind empirical {
    label en official "the total purchase price of the property (including the contingent payments)";
}
pub relation qualifying_sale_by_financial_institution_514c9Hii(sale: Text) kind institutional {
    label en official "the sale is a qualifying sale by a financial institution";
}
@source(IRC_S514_C, quote = "For purposes of this clause, there is a qualifying sale by a financial institution if—")
@source(IRC_S514_C, quote = "(I) a qualified organization acquires property described in clause (iii) from a financial institution and any gain recognized by the financial institution with respect to the property is ordinary income,")
@source(IRC_S514_C, quote = "(II) the stated principal amount of the financing provided by the financial institution does not exceed the amount of the outstanding indebtedness (including accrued but unpaid interest) of the financial institution with respect to the property described in clause (iii) immediately before the acquisition referred to in clause (iii) or (v), whichever is applicable, and")
@source(IRC_S514_C, quote = "(III) the present value (determined as of the time of the sale and by using the applicable Federal rate determined under section 1274(d)) of the maximum amount payable pursuant to the financing that is determined by reference to the revenue, income, or profits derived from the property cannot exceed 30 percent of the total purchase price of the property (including the contingent payments).")
rule QualifyingSaleByFinancialInstitution(sale: Text, principal: Money, outstanding: Money, contingent_pv: Money, price: Money) defeasible {
    label en official "section 514(c)(9)(H)(ii): ordinary-income gain, financing principal not above the institution's outstanding indebtedness, and contingent payments' present value at most 30 percent of the total price — exactly 30 percent qualifies";
    when financial_institution_gain_is_ordinary_income_514c9HiiI(sale);
    when stated_principal_amount_of_financing_514c9HiiII(sale, principal);
    when outstanding_indebtedness_of_institution_before_acquisition_514c9HiiII(sale, outstanding);
    when principal <= outstanding;
    when present_value_of_contingent_payments_514c9HiiIII(sale, contingent_pv);
    when total_purchase_price_including_contingent_payments_514c9HiiIII(sale, price);
    when contingent_pv * 100 <= price * 30;
    then qualifying_sale_by_financial_institution_514c9Hii(sale);
}
pub relation clauses_i_and_ii_of_514c9B_not_applicable_to_financing_514c9Hi(sale: Text) kind institutional {
    label en official "clauses (i) and (ii) of subparagraph (B) do not apply to financing provided by the institution for the qualifying sale";
}
@source(IRC_S514_C, quote = "In the case of a qualifying sale by a financial institution, except as provided in regulations, clauses (i) and (ii) of subparagraph (B) shall not apply with respect to financing provided by such institution for such sale.")
rule ClausesIAndIiNotApplicableForQualifyingSale(sale: Text) defeasible {
    label en official "section 514(c)(9)(H)(i): a qualifying sale by a financial institution takes its financing outside clauses (i) and (ii) of subparagraph (B)";
    when qualifying_sale_by_financial_institution_514c9Hii(sale);
    then clauses_i_and_ii_of_514c9B_not_applicable_to_financing_514c9Hi(sale);
}
pub enum FinancialInstitutionKind514c9Hiv { InstitutionUnder581Or591a, SupervisedSubsidiaryOfSuchInstitution, ConservatorOrReceiverOrItsSuccessor }
pub relation financial_institution_kind_514c9Hiv(entity_id: Person, kind: FinancialInstitutionKind514c9Hiv) kind empirical {
    label en official "the entity is a financial institution described in section 581 or 591(a) (I); a direct or indirect subsidiary of such an institution that is subject, by virtue of the affiliation, to supervision and examination by a Federal or State agency regulating such institutions (II); or a person acting as a conservator or receiver of such an entity, or the government agency or corporation succeeding to its rights (III)";
}
pub relation financial_institution_514c9Hiv(entity_id: Person) kind institutional {
    label en official "the entity is a financial institution for purposes of subparagraph (H)";
}
@source(IRC_S514_C, quote = "For purposes of this subparagraph, the term \"financial institution\" means—")
@source(IRC_S514_C, quote = "(I) any financial institution described in section 581 or 591(a),")
@source(IRC_S514_C, quote = "(II) any other corporation which is a direct or indirect subsidiary of an institution referred to in subclause (I) but only if, by virtue of being affiliated with such institution, such other corporation is subject to supervision and examination by a Federal or State agency which regulates institutions referred to in subclause (I), and")
@source(IRC_S514_C, quote = "(III) any person acting as a conservator or receiver of an entity referred to in subclause (I) or (II) (or any government agency or corporation succeeding to the rights or interest of such person).")
rule FinancialInstitutionDefinition(entity_id: Person, k: FinancialInstitutionKind514c9Hiv) defeasible {
    label en official "section 514(c)(9)(H)(iv)(I)-(III)";
    when financial_institution_kind_514c9Hiv(entity_id, k);
    then financial_institution_514c9Hiv(entity_id);
}
pub relation real_property_acquired_by_bid_at_foreclosure_or_by_agreement_after_default_514c9Hv(asset_id: Text) kind empirical {
    label en official "the real property was acquired by the financial institution as the result of having bid on it at foreclosure, or by operation of an agreement or process of law, after there was a default (or a default was imminent) on indebtedness which the property secured";
}
pub relation foreclosure_property_514c9Hv(asset_id: Text) kind institutional {
    label en official "the real property is foreclosure property";
}
@source(IRC_S514_C, quote = "For purposes of this subparagraph, the term \"foreclosure property\" means any real property acquired by the financial institution as the result of having bid on such property at foreclosure, or by operation of an agreement or process of law, after there was a default (or a default was imminent) on indebtedness which such property secured.")
rule ForeclosurePropertyDefinition(asset_id: Text) defeasible {
    label en official "section 514(c)(9)(H)(v)";
    when real_property_acquired_by_bid_at_foreclosure_or_by_agreement_after_default_514c9Hv(asset_id);
    then foreclosure_property_514c9Hv(asset_id);
}
// (d), (f).
pub relation transferor_corporation_basis_514d(o: Person, asset_id: Text, amount: Money) kind empirical {
    label en official "the basis of the property in the hands of the transferor corporation";
}
pub relation gain_recognized_by_transferor_corporation_on_distribution_514d(o: Person, asset_id: Text, amount: Money) kind empirical {
    label en official "the gain recognized to the transferor corporation upon the distribution";
}
pub relation gain_of_organization_included_in_ubti_on_liquidation_514d(o: Person, asset_id: Text, amount: Money) kind empirical {
    label en official "the amount of any gain to the organization which was included, on account of the distribution, in unrelated business taxable income under subsection (a)";
}
pub relation property_acquired_in_liquidation_in_exchange_for_stock_514d(o: Person, asset_id: Text) kind empirical {
    label en official "the property was acquired in a complete or partial liquidation of a corporation in exchange for its stock";
}
pub relation basis_of_debt_financed_property_acquired_in_liquidation_514d(o: Person, asset_id: Text, amount: Money) kind institutional {
    label en official "the basis of the property: the transferor's basis, increased by the transferor's recognized gain and by the organization's gain included in unrelated business taxable income";
}
@source(IRC_S514_D, quote = "For purposes of this subtitle, if the property was acquired in a complete or partial liquidation of a corporation in exchange for its stock, the basis of the property shall be the same as it would be in the hands of the transferor corporation, increased by the amount of gain recognized to the transferor corporation upon such distribution and by the amount of any gain to the organization which was included, on account of such distribution, in unrelated business taxable income under subsection (a)")
rule BasisOfPropertyAcquiredInLiquidation(o: Person, asset_id: Text, base: Money, transferor_gain: Money, own_gain: Money) defeasible {
    label en official "section 514(d): transferor basis + transferor's recognized gain + the organization's gain included in UBTI";
    when property_acquired_in_liquidation_in_exchange_for_stock_514d(o, asset_id);
    when transferor_corporation_basis_514d(o, asset_id, base);
    when gain_recognized_by_transferor_corporation_on_distribution_514d(o, asset_id, transferor_gain);
    when gain_of_organization_included_in_ubti_on_liquidation_514d(o, asset_id, own_gain);
    then basis_of_debt_financed_property_acquired_in_liquidation_514d(o, asset_id, base + transferor_gain + own_gain);
}
pub relation personal_property_leased_in_connection_with_lease_of_real_estate_514f(lessor: Person, asset_id: Text) kind empirical {
    label en official "the personal property of the lessor is leased by it to a lessee of its real estate, the lease being made under, or in connection with, the lease of the real estate";
}
pub relation personal_property_counts_as_real_property_514f(lessor: Person, asset_id: Text) kind institutional {
    label en official "for section 514, 'real property' includes the personal property";
}
@source(IRC_S514_F, quote = "For purposes of this section, the term \"real property\" includes personal property of the lessor leased by it to a lessee of its real estate if the lease of such personal property is made under, or in connection with, the lease of such real estate.")
rule PersonalPropertyLeasedWithRealEstateIsRealProperty(lessor: Person, asset_id: Text) defeasible {
    label en official "section 514(f): personal property leased with the lessor's real estate is real property";
    when personal_property_leased_in_connection_with_lease_of_real_estate_514f(lessor, asset_id);
    then personal_property_counts_as_real_property_514f(lessor, asset_id);
}

// Pinned-parameter reading of the section 513(h)(2)(A) limit: LowCostArticleLimit513h2
// (Rev. Proc. 2024-40 section 2.34(1), Rev. Proc. 2025-32 section 4.33(1)) at legal_time.
@source(IRC_S513_H, quote = "The term \"low cost article\" means any article which has a cost not in excess of $5 to the organization which distributes such item (or on whose behalf such item is distributed).")
rule AggregateArticleCostWithinPinnedIndexedLimit(o: Person, distributee: Person, calendar_year: Integer, y: TaxableYear, total: Money) defeasible {
    label en official "section 513(h)(2)(A)-(C): the aggregate cost within the pinned indexed limit (LowCostArticleLimit513h2) — exactly at the limit qualifies";
    when aggregate_cost_of_articles_to_single_distributee_513h2B(o, distributee, calendar_year, total);
    when us.irc.core::calendar_year_of(y, calendar_year);
    when total <= LowCostArticleLimit513h2;
    then aggregate_article_cost_within_limit_513h2(o, distributee, calendar_year, y);
}
