// Sections 503-509, stage 3: the pieces the earlier stages left as
// case-asserted facts or did not reach — the (a)(2) notification limit,
// (c), (e) and (f) of section 503; the section 504 wiring into (c)(4); section
// 505(b)(2)-(4) and (c)(1)(B)-(2); the section 506 deadline and its duties;
// section 507(b)(1)(B), (d)(2), (e), (f); section 508(d)(2)-(3), (e)(2); section
// 509(a) last sentence, (b), (c), (d).

// ---------------------------------------------------------------------
// Section 503.
// ---------------------------------------------------------------------

use self::{
    ClassificationFoundNondiscriminatory505b1A,
    IRC_S503_A,
    IRC_S503_B,
    IRC_S503_C,
    IRC_S503_E,
    IRC_S503_F,
    IRC_S504_A,
    IRC_S504_C,
    IRC_S505_B,
    IRC_S505_C,
    IRC_S506_A,
    IRC_S506_B,
    IRC_S506_C,
    IRC_S506_D,
    IRC_S506_E,
    IRC_S507_B,
    IRC_S507_C,
    IRC_S507_D,
    IRC_S507_E,
    IRC_S507_F,
    IRC_S508_D,
    IRC_S508_E,
    IRC_S508_F,
    IRC_S509_A,
    IRC_S509_B,
    IRC_S509_C,
    IRC_S509_D,
    IRC_S509_E,
    Person,
    Secretary,
    TaxableYear,
    aggregate_gifts_grants_and_membership_fees,
    aggregate_qualifying_admissions_and_sales_receipts,
    aggregate_tax_benefit,
    aggregate_ubti_excess_over_511_tax,
    disqualified_organization_501h5,
    formerly_exempt_as_501c3_504a1,
    gift_by_substantial_contributor_in_tainted_year_508d1B,
    gift_made_after_507a_notification,
    meets_509a2A_more_than_one_third_support,
    meets_509a2B_not_more_than_one_third_investment,
    no_longer_501c3_due_to_lobbying_504a2A,
    no_longer_501c3_due_to_political_campaign_504a2B,
    permanently_barred_from_501c4_504a,
    private_foundation_status_terminated,
    prohibited_transaction_engaged,
    section_501c4,
    section_501c4_established_on,
    section_501c5,
    section_501c6,
    section_503a_covered_organization,
    section_505c_notice_given,
    section_506a_notice_filed,
    section_506d_extension_for_reasonable_cause,
    section_508f_sponsoring_organization_notice_given,
    section_509a2a_source_restriction_applied,
    sponsoring_organization_4966d1,
    termination_tax_507,
    veba_plan_meets_nondiscrimination_505b,
};

pub relation notified_by_secretary_of_prohibited_transaction_503a2(o: Person, notified_in: TaxableYear) kind empirical {
    label en official "the taxable year during which the organization is notified by the Secretary that it has engaged in a prohibited transaction (section 503(a)(2))";
}
pub relation transaction_entered_with_purpose_of_diverting_corpus_or_income_503a2(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization entered into the prohibited transaction with the purpose of diverting corpus or income from its exempt purposes (section 503(a)(2))";
}
pub external judgment relation TransactionInvolvedSubstantialPartOfCorpusOrIncome503a2(o: Person, y: TaxableYear) {
    authority Secretary;
    label en official "the transaction involved a substantial part of the corpus or income of the organization (section 503(a)(2)) — DECISION-0194 evaluative channel";
}
pub relation section_503a2_diversion_exception(o: Person, y: TaxableYear) kind institutional {
    label en official "the notification limit does not apply: the transaction was entered into to divert corpus or income and involved a substantial part of it";
}
@source(IRC_S503_A, quote = "An organization described in paragraph (1) shall be denied exemption from taxation under section 501(a) by reason of paragraph (1) only for taxable years after the taxable year during which it is notified by the Secretary that it has engaged in a prohibited transaction, unless such organization entered into such prohibited transaction with the purpose of diverting corpus or income of the organization from its exempt purposes, and such transaction involved a substantial part of the corpus or inco")
rule Section503a2DiversionException(o: Person, y: TaxableYear) defeasible {
    label en official "section 503(a)(2): a purposeful diversion of a substantial part of corpus or income is denied without waiting for notification";
    when transaction_entered_with_purpose_of_diverting_corpus_or_income_503a2(o, y);
    when TransactionInvolvedSubstantialPartOfCorpusOrIncome503a2(o, y);
    then section_503a2_diversion_exception(o, y);
}
pub relation section_503a2_year_after_notification(o: Person, y: TaxableYear) kind institutional {
    label en official "the taxable year is after the taxable year during which the organization was notified";
}
@source(IRC_S503_A, quote = "An organization described in paragraph (1) shall be denied exemption from taxation under section 501(a) by reason of paragraph (1) only for taxable years after the taxable year during which it is notified by the Secretary that it has engaged in a prohibited transaction, unless such organization entered into such prohibited transaction with the purpose of diverting corpus or income of the organization from its exempt purposes, and such transaction involved a substantial part of the corpus or inco")
rule Section503a2YearAfterNotification(o: Person, y: TaxableYear, notified_in: TaxableYear, n_notified: Integer, n: Integer) defeasible {
    label en official "section 503(a)(2): only taxable years after the year of notification are affected";
    when notified_by_secretary_of_prohibited_transaction_503a2(o, notified_in);
    when us.irc.core::calendar_year_of(notified_in, n_notified);
    when us.irc.core::calendar_year_of(y, n);
    when n > n_notified;
    then section_503a2_year_after_notification(o, y);
}
pub relation section_503a2_taxable_year_affected(o: Person, y: TaxableYear) kind institutional {
    label en official "the taxable year is one for which section 503(a)(1) denies exemption";
}
rule Section503a2AffectedAfterNotification(o: Person, y: TaxableYear) defeasible {
    label en official "section 503(a)(2): years after notification";
    when section_503a2_year_after_notification(o, y);
    then section_503a2_taxable_year_affected(o, y);
}
rule Section503a2AffectedByDiversion(o: Person, y: TaxableYear) defeasible {
    label en official "section 503(a)(2), exception clause: the year of a purposeful substantial diversion";
    when section_503a2_diversion_exception(o, y);
    then section_503a2_taxable_year_affected(o, y);
}
// (c): future status.
pub relation section_503c_claim_for_exemption_filed_in(o: Person, claim_year: TaxableYear) kind empirical {
    label en official "the organization filed a claim for exemption under section 503(c) in the taxable year";
}
pub external judgment relation SecretarySatisfiedNotToEngageAgainInProhibitedTransaction503c(o: Person) {
    authority Secretary;
    label en official "the Secretary is satisfied that the organization will not knowingly again engage in a prohibited transaction (section 503(c)) — DECISION-0194 evaluative channel";
}
pub relation section_503c_exemption_restored(o: Person, y: TaxableYear) kind institutional {
    label en official "the organization is exempt for the taxable year, which is after the year in which its claim under section 503(c) was filed";
}
@source(IRC_S503_C, quote = "Any organization described in subsection (a)(1) which is denied exemption under section 501(a) by reason of subsection (a) of this section, with respect to any taxable year following the taxable year in which notice of denial of exemption was received, may, under regulations prescribed by the Secretary, file claim for exemption, and if the Secretary, pursuant to such regulations, is satisfied that such organization will not knowingly again engage in a prohibited transaction, such organization sh")
rule Section503cExemptionRestored(o: Person, y: TaxableYear, claim_year: TaxableYear, n_claim: Integer, n: Integer) defeasible {
    label en official "section 503(c): once the Secretary is satisfied, the organization is exempt with respect to taxable years after the year the claim is filed";
    when section_503c_claim_for_exemption_filed_in(o, claim_year);
    when SecretarySatisfiedNotToEngageAgainInProhibitedTransaction503c(o);
    when us.irc.core::calendar_year_of(claim_year, n_claim);
    when us.irc.core::calendar_year_of(y, n);
    when n > n_claim;
    then section_503c_exemption_restored(o, y);
}
// (e): obligations acquired by a trust are not loans without adequate security.
pub enum ObligationAcquisition503e1 { OnMarketAtExchangePrice, OnMarketAtIndependentQuotedPrice, FromUnderwriterAtOrBelowPublicOfferingPrice, DirectlyFromIssuerNoLessFavorablyThanIndependentPersons }
pub relation obligation_acquired_503e1(o: Person, obligation: Text, how: ObligationAcquisition503e1) kind empirical {
    label en official "the obligation is acquired: on the market at the prevailing exchange price (A)(i) or, if not exchange-traded, at a price not less favorable than the independent bid and asked prices (A)(ii); from an underwriter at a price not above the public offering price with a substantial portion acquired by independent persons (B); directly from the issuer at a price not less favorable than that paid by independent persons for a substantial portion of the issue (C)";
}
pub relation share_of_issue_held_by_trust_percent_503e2A(o: Person, obligation: Text, pct: Decimal) kind empirical {
    label en official "immediately following acquisition, the percentage of the aggregate amount of the obligations issued in the issue and outstanding that is held by the trust";
}
pub relation share_of_issue_held_by_independent_persons_percent_503e2B(o: Person, obligation: Text, pct: Decimal) kind empirical {
    label en official "immediately following acquisition, the percentage of that aggregate amount that is held by persons independent of the issuer";
}
pub relation share_of_trust_assets_in_obligations_of_503b_persons_percent_503e3(o: Person, pct: Decimal) kind empirical {
    label en official "immediately following acquisition, the percentage of the assets of the trust invested in obligations of persons described in subsection (b)";
}
pub relation obligation_not_a_loan_without_adequate_security_503e(o: Person, obligation: Text) kind institutional {
    label en official "the obligation is not treated as a loan made without the receipt of adequate security";
}
@source(IRC_S503_E, quote = "For purposes of subsection (b)(1), a bond, debenture, note, or certificate or other evidence of indebtedness (hereinafter in this subsection referred to as \"obligation\") shall not be treated as a loan made without the receipt of adequate security if—")
@source(IRC_S503_E, quote = "(1) such obligation is acquired—")
@source(IRC_S503_E, quote = "(A) on the market, either (i) at the price of the obligation prevailing on a national securities exchange which is registered with the Securities and Exchange Commission, or (ii) if the obligation is not traded on such a national securities exchange, at a price not less favorable to the trust than the offering price for the obligation as established by current bid and asked prices quoted by persons independent of the issuer;")
@source(IRC_S503_E, quote = "(B) from an underwriter, at a price (i) not in excess of the public offering price for the obligation as set forth in a prospectus or offering circular filed with the Securities and Exchange Commission, and (ii) at which a substantial portion of the same issue is acquired by persons independent of the issuer; or")
@source(IRC_S503_E, quote = "(C) directly from the issuer, at a price not less favorable to the trust than the price paid currently for a substantial portion of the same issue by persons independent of the issuer;")
@source(IRC_S503_E, quote = "(2) immediately following acquisition of such obligation—")
@source(IRC_S503_E, quote = "(A) not more than 25 percent of the aggregate amount of obligations issued in such issue and outstanding at the time of acquisition is held by the trust, and")
@source(IRC_S503_E, quote = "(B) at least 50 percent of the aggregate amount referred to in subparagraph (A) is held by persons independent of the issuer; and")
@source(IRC_S503_E, quote = "(3) immediately following acquisition of the obligation, not more than 25 percent of the assets of the trust is invested in obligations of persons described in subsection (b).")
rule ObligationNotALoanWithoutAdequateSecurity(o: Person, obligation: Text, how: ObligationAcquisition503e1, held: Decimal, independent: Decimal, invested: Decimal) defeasible {
    label en official "section 503(e): properly acquired, at most 25 percent of the issue held by the trust, at least 50 percent of the issue held by independent persons, at most 25 percent of trust assets in obligations of (b) persons — the boundaries 25, 50 and 25 percent all qualify";
    when obligation_acquired_503e1(o, obligation, how);
    when share_of_issue_held_by_trust_percent_503e2A(o, obligation, held);
    when held <= 25.0;
    when share_of_issue_held_by_independent_persons_percent_503e2B(o, obligation, independent);
    when independent >= 50.0;
    when share_of_trust_assets_in_obligations_of_503b_persons_percent_503e3(o, invested);
    when invested <= 25.0;
    then obligation_not_a_loan_without_adequate_security_503e(o, obligation);
}
// (f): loans by a section 401(a) trust to the employer.
pub relation loan_bears_reasonable_rate_of_interest_503f(o: Person, loan: Text) kind empirical {
    label en official "the loan bears a reasonable rate of interest";
}
pub relation employer_prohibited_by_law_from_pledging_more_than_half_of_assets_503f1(o: Person, loan: Text) kind empirical {
    label en official "at the time of the making or renewal the employer is prohibited by any law of the United States or regulation thereunder from directly or indirectly pledging, as security for the loan, a class or classes of assets whose value then represents more than one-half of the value of all his assets";
}
pub relation independent_trustee_approved_in_writing_503f2(o: Person, loan: Text) kind empirical {
    label en official "the making or renewal is approved in writing as an investment consistent with the exempt purposes of the trust by a trustee independent of the employer — where several independent trustees serve, a majority of them";
}
pub relation another_independent_trustee_previously_refused_503f2(o: Person, loan: Text) kind empirical {
    label en official "another independent trustee had previously refused to give the written approval";
}
pub relation aggregate_unsecured_loans_to_employer_503f3(o: Person, loan: Text, amount: Money) kind empirical {
    label en official "immediately following the making or renewal, the aggregate amount loaned by the trust to the employer without adequate security, determined without regard to subsection (e)";
}
pub relation value_of_all_trust_assets_503f3(o: Person, loan: Text, amount: Money) kind empirical {
    label en official "the value of all the assets of the trust immediately following the making or renewal";
}
pub relation trust_described_in_section_401a_for_503f(o: Person) kind empirical {
    label en official "the lender is a trust described in section 401(a)";
}
pub relation employer_loan_within_503f_safe_harbor(o: Person, loan: Text) kind institutional {
    label en official "section 503(b)(1) does not apply to the employer loan of the section 401(a) trust";
}
@source(IRC_S503_F, quote = "Subsection (b)(1) shall not apply to a loan made by a trust described in section 401(a) to the employer (or to a renewal of such a loan or, if the loan is repayable upon demand, to a continuation of such a loan) if the loan bears a reasonable rate of interest, and if (in the case of a making or renewal)—")
@source(IRC_S503_F, quote = "(1) the employer is prohibited (at the time of such making or renewal) by any law of the United States or regulation thereunder from directly or indirectly pledging, as security for such a loan, a particular class or classes of his assets the value of which (at such time) represents more than one-half of the value of all his assets;")
@source(IRC_S503_F, quote = "(2) the making or renewal, as the case may be, is approved in writing as an investment which is consistent with the exempt purposes of the trust by a trustee who is independent of the employer, and no other such trustee had previously refused to give such written approval; and")
@source(IRC_S503_F, quote = "(3) immediately following the making or renewal, as the case may be, the aggregate amount loaned by the trust to the employer, without the receipt of adequate security, does not exceed 25 percent of the value of all the assets of the trust.")
@source(IRC_S503_F, quote = "For purposes of paragraph (2), the term \"trustee\" means, with respect to any trust for which there is more than one trustee who is independent of the employer, a majority of such independent trustees. For purposes of paragraph (3), the determination as to whether any amount loaned by the trust to the employer is loaned without the receipt of adequate security shall be made without regard to subsection (e).")
rule EmployerLoanWithin503fSafeHarbor(o: Person, loan: Text, unsecured: Money, assets: Money) defeasible {
    label en official "section 503(f): reasonable interest, employer barred from pledging more than half its assets, written independent-trustee approval never previously refused, and unsecured loans at most 25 percent of trust assets — exactly 25 percent qualifies";
    when trust_described_in_section_401a_for_503f(o);
    when loan_bears_reasonable_rate_of_interest_503f(o, loan);
    when employer_prohibited_by_law_from_pledging_more_than_half_of_assets_503f1(o, loan);
    when independent_trustee_approved_in_writing_503f2(o, loan);
    unless another_independent_trustee_previously_refused_503f2(o, loan);
    when aggregate_unsecured_loans_to_employer_503f3(o, loan, unsecured);
    when value_of_all_trust_assets_503f3(o, loan, assets);
    when unsecured * 100 <= assets * 25;
    then employer_loan_within_503f_safe_harbor(o, loan);
}
pub relation loan_is_the_obligation_or_employer_loan_503ef(o: Person, y: TaxableYear, counterparty: Person, item: Text) kind empirical {
    label en official "the section 503(b)(1) loan to the counterparty is the identified obligation (subsection (e)) or employer loan (subsection (f))";
}
pub relation loan_within_safe_harbor_503b1(o: Person, y: TaxableYear, counterparty: Person) kind institutional {
    label en official "the loan is outside section 503(b)(1) by reason of subsection (e) or (f)";
}
rule LoanWithinSafeHarborViaSubsectionE(o: Person, y: TaxableYear, counterparty: Person, item: Text) defeasible {
    label en official "section 503(e): an obligation meeting the acquisition and concentration tests is not a loan without adequate security";
    when loan_is_the_obligation_or_employer_loan_503ef(o, y, counterparty, item);
    when obligation_not_a_loan_without_adequate_security_503e(o, item);
    then loan_within_safe_harbor_503b1(o, y, counterparty);
}
rule LoanWithinSafeHarborViaSubsectionF(o: Person, y: TaxableYear, counterparty: Person, item: Text) defeasible {
    label en official "section 503(f): an employer loan of a section 401(a) trust meeting the safe harbor is outside section 503(b)(1)";
    when loan_is_the_obligation_or_employer_loan_503ef(o, y, counterparty, item);
    when employer_loan_within_503f_safe_harbor(o, item);
    then loan_within_safe_harbor_503b1(o, y, counterparty);
}
// Deontics: the prohibition on engaging in a prohibited transaction.
@source(IRC_S503_B, quote = "(1) lends any part of its income or corpus, without the receipt of adequate security and a reasonable rate of interest, to;")
rule RefrainFromProhibitedTransactionProhibitionRule(o: Person, y: TaxableYear, start: Date, ending: Date) strict {
    label en official "section 503(a)(1), (b): an organization subject to section 503 is under a prohibition against engaging in a prohibited transaction in the taxable year";
    when section_503a_covered_organization(o, y);
    when us.irc.core::begins(y, start);
    when us.irc.core::ends(y, ending);
    then prohibition RefrainFromProhibitedTransactions {
        bearer o;
        action prohibited_transaction_engaged(o, y);
        window [start, ending];
    };
}

// ---------------------------------------------------------------------
// Section 504: the wiring into the section 501(c)(4) classification.
// ---------------------------------------------------------------------

pub relation barred_from_501c4_for_year_504a(o: Person, y: TaxableYear) kind institutional {
    label en official "section 504(a): the organization may not be treated as a section 501(c)(4) organization for the taxable year";
}
@source(IRC_S504_A, quote = "shall not at any time thereafter be treated as an organization described in section 501(c)(4).")
rule BarredFrom501c4ForYear(o: Person, y: TaxableYear) defeasible {
    label en official "section 504(a): a permanently barred organization is not a section 501(c)(4) organization at any time thereafter";
    when permanently_barred_from_501c4_504a(o);
    when us.irc.core::year_of(o, y);
    then barred_from_501c4_for_year_504a(o, y);
}
pub relation church_exception_504c_derived(o: Person) kind institutional {
    label en official "the organization was a section 501(h)(5) disqualified organization for the taxable year immediately preceding the first taxable year for which it is described in section 504(a)(2) — derived from the disqualified-organization definition";
}
pub relation disqualified_in_year_before_first_disqualifying_year_504c(o: Person) kind empirical {
    label en official "the organization was a disqualified organization within the meaning of section 501(h)(5) for the taxable year immediately preceding the first taxable year for which it is described in paragraph (2) of subsection (a)";
}
@source(IRC_S504_C, quote = "Subsection (a) shall not apply to any organization which is a disqualified organization within the meaning of section 501(h)(5) (relating to churches, etc.) for the taxable year immediately preceding the first taxable year for which such organization is described in paragraph (2) of subsection (a).")
rule ChurchException504cDerived(o: Person) defeasible {
    label en official "section 504(c): a church or its affiliate, disqualified in the year before the first disqualifying year, is not barred";
    when disqualified_in_year_before_first_disqualifying_year_504c(o);
    when disqualified_organization_501h5(o);
    then church_exception_504c_derived(o);
}
@source(IRC_S504_A, quote = "(1) was exempt (or was determined by the Secretary to be exempt) from taxation under section 501(a) by reason of being an organization described in section 501(c)(3), and")
@source(IRC_S504_A, quote = "(2) is not an organization described in section 501(c)(3)—")
@source(IRC_S504_A, quote = "(A) by reason of carrying on propaganda, or otherwise attempting, to influence legislation, or")
@source(IRC_S504_A, quote = "(B) by reason of participating in, or intervening in, any political campaign on behalf of (or in opposition to) any candidate for public office,")
rule PermanentlyBarredFrom501c4LobbyingWithDerivedChurchException(o: Person) defeasible {
    label en official "section 504(a) via (2)(A), with the (c) exception derived from section 501(h)(5)";
    when formerly_exempt_as_501c3_504a1(o);
    when no_longer_501c3_due_to_lobbying_504a2A(o);
    unless church_exception_504c_derived(o);
    then permanently_barred_from_501c4_504a(o);
}
@source(IRC_S504_A, quote = "(B) by reason of participating in, or intervening in, any political campaign on behalf of (or in opposition to) any candidate for public office,")
rule PermanentlyBarredFrom501c4PoliticalWithDerivedChurchException(o: Person) defeasible {
    label en official "section 504(a) via (2)(B), with the (c) exception derived from section 501(h)(5)";
    when formerly_exempt_as_501c3_504a1(o);
    when no_longer_501c3_due_to_political_campaign_504a2B(o);
    unless church_exception_504c_derived(o);
    then permanently_barred_from_501c4_504a(o);
}

// ---------------------------------------------------------------------
// Section 505.
// ---------------------------------------------------------------------

pub enum ExcludableEmployee505b2 { FewerThanThreeYearsOfService, UnderAge21, SeasonalOrLessThanHalfTime, CoveredByCollectiveBargainingAgreement, NonresidentAlienWithoutUnitedStatesSourceEarnedIncome }
pub relation employee_years_of_service_completed_505b2A(emp: Person, years: Decimal) kind empirical {
    label en official "the number of years of service the employee has completed";
}
pub relation employee_age_in_years_505b2B(emp: Person, age: Decimal) kind empirical {
    label en official "the employee's attained age in years";
}
pub relation employee_seasonal_or_less_than_half_time_505b2C(emp: Person) kind empirical {
    label en official "the employee is a seasonal employee or a less than half-time employee";
}
pub relation employee_in_collective_bargaining_unit_with_good_faith_bargaining_505b2D(emp: Person, y: TaxableYear) kind empirical {
    label en official "the employee is not included in the plan but is included in a unit covered by an agreement between employee representatives and one or more employers that the Secretary finds to be a collective bargaining agreement, and the class of benefits was the subject of good faith bargaining";
}
pub relation employee_nonresident_alien_without_us_source_earned_income_505b2E(emp: Person, y: TaxableYear) kind empirical {
    label en official "the employee is a nonresident alien who receives no earned income (section 911(d)(2)) from the employer that is income from sources within the United States (section 861(a)(3))";
}
pub relation employee_excludable_from_nondiscrimination_test_505b2(emp: Person, y: TaxableYear, kind: ExcludableEmployee505b2) kind institutional {
    label en official "the employee may be excluded from consideration under section 505(b)(1)";
}
@source(IRC_S505_B, quote = "(A) employees who have not completed 3 years of service,")
rule ExcludableForFewerThanThreeYearsOfService(emp: Person, y: TaxableYear, years: Decimal) defeasible {
    label en official "section 505(b)(2)(A): employees who have not completed 3 years of service (3 years completed is not excludable)";
    when employee_years_of_service_completed_505b2A(emp, years);
    when years < 3.0;
    when us.irc.core::year_of(emp, y);
    then employee_excludable_from_nondiscrimination_test_505b2(emp, y, ExcludableEmployee505b2.FewerThanThreeYearsOfService);
}
@source(IRC_S505_B, quote = "(B) employees who have not attained age 21,")
rule ExcludableUnderAge21(emp: Person, y: TaxableYear, age: Decimal) defeasible {
    label en official "section 505(b)(2)(B): employees who have not attained age 21 (attaining 21 is not excludable)";
    when employee_age_in_years_505b2B(emp, age);
    when age < 21.0;
    when us.irc.core::year_of(emp, y);
    then employee_excludable_from_nondiscrimination_test_505b2(emp, y, ExcludableEmployee505b2.UnderAge21);
}
@source(IRC_S505_B, quote = "(C) seasonal employees or less than half-time employees,")
rule ExcludableSeasonalOrLessThanHalfTime(emp: Person, y: TaxableYear) defeasible {
    label en official "section 505(b)(2)(C): seasonal or less than half-time employees";
    when employee_seasonal_or_less_than_half_time_505b2C(emp);
    when us.irc.core::year_of(emp, y);
    then employee_excludable_from_nondiscrimination_test_505b2(emp, y, ExcludableEmployee505b2.SeasonalOrLessThanHalfTime);
}
@source(IRC_S505_B, quote = "(D) employees not included in the plan who are included in a unit of employees covered by an agreement between employee representatives and 1 or more employers which the Secretary finds to be a collective bargaining agreement if the class of benefits involved was the subject of good faith bargaining between such employee representatives and such employer or employers, and")
rule ExcludableCollectiveBargainingUnit(emp: Person, y: TaxableYear) defeasible {
    label en official "section 505(b)(2)(D): employees in a collectively bargained unit where the benefit class was bargained in good faith";
    when employee_in_collective_bargaining_unit_with_good_faith_bargaining_505b2D(emp, y);
    then employee_excludable_from_nondiscrimination_test_505b2(emp, y, ExcludableEmployee505b2.CoveredByCollectiveBargainingAgreement);
}
@source(IRC_S505_B, quote = "(E) employees who are nonresident aliens and who receive no earned income (within the meaning of section 911(d)(2)) from the employer which constitutes income from sources within the United States (within the meaning of section 861(a)(3)).")
rule ExcludableNonresidentAlien(emp: Person, y: TaxableYear) defeasible {
    label en official "section 505(b)(2)(E): nonresident aliens with no United States source earned income from the employer";
    when employee_nonresident_alien_without_us_source_earned_income_505b2E(emp, y);
    then employee_excludable_from_nondiscrimination_test_505b2(emp, y, ExcludableEmployee505b2.NonresidentAlienWithoutUnitedStatesSourceEarnedIncome);
}
pub enum UniformRelationshipBenefit505b1 { LifeInsurance, Disability, SeverancePay, SupplementalUnemploymentCompensation }
pub relation benefit_available_bears_uniform_relationship_to_compensation_505b1(o: Person, y: TaxableYear, kind: UniformRelationshipBenefit505b1) kind empirical {
    label en official "the life insurance, disability, severance pay, or supplemental unemployment compensation benefits available bear a uniform relationship to the total compensation, or the basic or regular rate of compensation, of the employees covered";
}
pub relation benefit_not_considered_to_fail_505b1B(o: Person, y: TaxableYear) kind institutional {
    label en official "the benefit is not considered to fail the requirements of subparagraph (B) merely because the benefits bear a uniform relationship to compensation";
}
@source(IRC_S505_B, quote = "A life insurance, disability, severance pay, or supplemental unemployment compensation benefit shall not be considered to fail to meet the requirements of subparagraph (B) merely because the benefits available bear a uniform relationship to the total compensation, or the basic or regular rate of compensation, of employees covered by the plan.")
rule BenefitNotConsideredToFailByUniformRelationship(o: Person, y: TaxableYear, k: UniformRelationshipBenefit505b1) defeasible {
    label en official "section 505(b)(1), last sentence: the uniform-relationship safe harbor for the four benefit kinds";
    when benefit_available_bears_uniform_relationship_to_compensation_505b1(o, y, k);
    then benefit_not_considered_to_fail_505b1B(o, y);
}
@source(IRC_S505_B, quote = "Except as otherwise provided in this subsection, a plan meets the requirements of this subsection only if—")
@source(IRC_S505_B, quote = "A life insurance, disability, severance pay, or supplemental unemployment compensation benefit shall not be considered to fail to meet the requirements of subparagraph (B) merely because the benefits available bear a uniform relationship to the total compensation, or the basic or regular rate of compensation, of employees covered by the plan.")
rule VebaPlanMeetsNondiscriminationBySafeHarbor(o: Person, y: TaxableYear) defeasible {
    label en official "section 505(b)(1)(A)-(B): a classification found nondiscriminatory and the uniform-relationship safe harbor for the (B) test";
    when ClassificationFoundNondiscriminatory505b1A(o, y);
    when benefit_not_considered_to_fail_505b1B(o, y);
    then veba_plan_meets_nondiscrimination_505b(o, y);
}
pub relation benefit_has_other_nondiscrimination_rules_505b3(o: Person, y: TaxableYear) kind empirical {
    label en official "a provision of this chapter other than section 505(b) provides nondiscrimination rules for the benefit";
}
pub relation other_nondiscrimination_rules_satisfied_505b3(o: Person, y: TaxableYear) kind empirical {
    label en official "the nondiscrimination rules so provided are satisfied with respect to the benefit";
}
@source(IRC_S505_B, quote = "In the case of any benefit for which a provision of this chapter other than this subsection provides nondiscrimination rules, paragraph (1) shall not apply but the requirements of this subsection shall be met only if the nondiscrimination rules so provided are satisfied with respect to such benefit.")
rule VebaPlanMeetsNondiscriminationViaOtherRules(o: Person, y: TaxableYear) defeasible {
    label en official "section 505(b)(3): where other nondiscrimination rules apply, paragraph (1) does not apply and the plan meets the requirements only if those rules are satisfied";
    when benefit_has_other_nondiscrimination_rules_505b3(o, y);
    when other_nondiscrimination_rules_satisfied_505b3(o, y);
    then veba_plan_meets_nondiscrimination_505b(o, y);
}
pub relation employer_elects_to_treat_plans_as_one_505b4(employer: Person, plan_a: Person, plan_b: Person) kind empirical {
    label en official "the employer elected to treat two of its plans as one plan for purposes of section 505(b)";
}
pub relation employer_maintains_plan_505b4(employer: Person, plan: Person) kind empirical {
    label en official "the plan is a plan of the employer";
}
pub relation plans_treated_as_one_plan_505b4(plan_a: Person, plan_b: Person) kind institutional {
    label en official "the two plans are treated as one plan for purposes of section 505(b)";
}
@source(IRC_S505_B, quote = "At the election of the employer, 2 or more plans of such employer may be treated as 1 plan for purposes of this subsection.")
rule Section505b4AggregationElectionRule(employer: Person, plan_a: Person, plan_b: Person) strict {
    label en official "section 505(b)(4): at the election of the employer, 2 or more of its plans may be treated as 1 plan";
    when employer_maintains_plan_505b4(employer, plan_a);
    when employer_maintains_plan_505b4(employer, plan_b);
    then power AggregatePlansForSection505b {
        holder employer;
        exercise employer_elects_to_treat_plans_as_one_505b4(employer, plan_a, plan_b);
        valid_when employer_maintains_plan_505b4(employer, plan_b);
        effect plans_treated_as_one_plan_505b4(plan_a, plan_b);
    };
}
pub relation section_505c_regulatory_notice_deadline(o: Person, deadline: Date) kind empirical {
    label en official "the time prescribed by the Secretary by regulations for giving notice under section 505(c) — EXTERNAL_DEPENDENCY, not pinned in the text";
}
pub relation organization_in_existence_on_july_18_1984_505c2(o: Person) kind empirical {
    label en official "the organization was in existence on July 18, 1984 (the enactment date of section 505)";
}
pub relation section_505c_effective_notice_deadline(o: Person, deadline: Date) kind institutional {
    label en official "the time for giving notice: the regulatory deadline, but for an organization in existence on July 18, 1984 not earlier than July 18, 1985";
}
pub relation existing_organization_with_regulatory_deadline_505c2(o: Person, deadline: Date) kind institutional {
    label en official "helper: an organization in existence on July 18, 1984 and its regulatory deadline";
}
rule ExistingOrganizationWithRegulatoryDeadline(o: Person, dl: Date) defeasible {
    label en official "helper: the existing organization's regulatory deadline";
    when organization_in_existence_on_july_18_1984_505c2(o);
    when section_505c_regulatory_notice_deadline(o, dl);
    then existing_organization_with_regulatory_deadline_505c2(o, dl);
}
@source(IRC_S505_C, quote = "(B) for any period before the giving of such notice, if such notice is given after the time prescribed by the Secretary by regulations for giving notice under this subsection.")
rule Section505cDeadlineForNewOrganization(o: Person, dl: Date) defeasible {
    label en official "section 505(c)(1)(B): the regulatory deadline governs an organization not in existence on the enactment date";
    when section_505c_regulatory_notice_deadline(o, dl);
    unless existing_organization_with_regulatory_deadline_505c2(o, dl);
    then section_505c_effective_notice_deadline(o, dl);
}
@source(IRC_S505_C, quote = "In the case of any organization in existence on July 18, 1984, the time for giving notice under paragraph (1) shall not expire before the date 1 year after such date of the enactment.")
rule Section505cDeadlineForExistingOrganizationAtOrAfterFloor(o: Person, dl: Date) defeasible {
    label en official "section 505(c)(2): for an organization in existence on July 18, 1984 the deadline does not expire before July 18, 1985 — a later regulatory date governs";
    when existing_organization_with_regulatory_deadline_505c2(o, dl);
    when dl >= @1985-07-18;
    then section_505c_effective_notice_deadline(o, dl);
}
@source(IRC_S505_C, quote = "In the case of any organization in existence on July 18, 1984, the time for giving notice under paragraph (1) shall not expire before the date 1 year after such date of the enactment.")
rule Section505cDeadlineForExistingOrganizationFloor(o: Person, dl: Date) defeasible {
    label en official "section 505(c)(2): an earlier regulatory deadline is lifted to July 18, 1985";
    when existing_organization_with_regulatory_deadline_505c2(o, dl);
    when dl < @1985-07-18;
    then section_505c_effective_notice_deadline(o, @1985-07-18);
}
pub relation section_505c_treated_as_from(o: Person, from: Date) kind institutional {
    label en official "the organization is treated as a section 501(c)(9) or (17) organization from this date: the date of the organization's start when notice is timely, the notice date when it is late";
}
pub relation organization_started_on_505c(o: Person, started_on: Date) kind empirical {
    label en official "the date the organization began (the earliest date from which it can be treated as a section 501(c)(9) or (17) organization)";
}
@source(IRC_S505_C, quote = "(A) unless it has given notice to the Secretary, in such manner as the Secretary may by regulations prescribe, that it is applying for recognition of such status, or")
rule Section505cTreatedFromStartWhenNoticeTimely(o: Person, notified_on: Date, deadline: Date, started_on: Date) defeasible {
    label en official "section 505(c)(1)(B): notice given by the deadline leaves the organization treated as described from its start";
    when section_505c_notice_given(o, notified_on);
    when section_505c_effective_notice_deadline(o, deadline);
    when notified_on <= deadline;
    when organization_started_on_505c(o, started_on);
    then section_505c_treated_as_from(o, started_on);
}
@source(IRC_S505_C, quote = "(B) for any period before the giving of such notice, if such notice is given after the time prescribed by the Secretary by regulations for giving notice under this subsection.")
rule Section505cTreatedFromNoticeWhenNoticeLate(o: Person, notified_on: Date, deadline: Date) defeasible {
    label en official "section 505(c)(1)(B): late notice means no treatment for any period before the notice is given";
    when section_505c_notice_given(o, notified_on);
    when section_505c_effective_notice_deadline(o, deadline);
    when notified_on > deadline;
    then section_505c_treated_as_from(o, notified_on);
}
@source(IRC_S505_C, quote = "(A) unless it has given notice to the Secretary, in such manner as the Secretary may by regulations prescribe, that it is applying for recognition of such status, or")
rule Section505cNoticeDutyRule(o: Person, started: Date, deadline: Date) strict {
    label en official "section 505(c)(1): an organization seeking treatment under section 501(c)(9) or (17) is under a duty to give the Secretary notice by the prescribed time";
    when section_505c_effective_notice_deadline(o, deadline);
    when organization_started_on_505c(o, started);
    then duty GiveSection505cNotice {
        bearer o;
        goal achievement {
            condition section_505c_notice_timely_505c1(o);
            window [started, deadline];
        }
    };
}
pub relation section_505c_notice_timely_505c1(o: Person) kind institutional {
    label en official "the section 505(c) notice was given on or before the effective deadline";
}
rule Section505cNoticeTimely(o: Person, notified_on: Date, deadline: Date) defeasible {
    label en official "section 505(c)(1)(B): notice given on or before the deadline is timely";
    when section_505c_notice_given(o, notified_on);
    when section_505c_effective_notice_deadline(o, deadline);
    when notified_on <= deadline;
    then section_505c_notice_timely_505c1(o);
}

// ---------------------------------------------------------------------
// Section 506: the 60-day notice, its contents, the acknowledgment duty and the user fee.
// ---------------------------------------------------------------------

pub relation section_506a_notice_contains_identity_506b1(o: Person) kind empirical {
    label en official "the notice includes the name, address, and taxpayer identification number of the organization (section 506(b)(1))";
}
pub relation section_506a_notice_contains_organization_date_and_state_506b2(o: Person) kind empirical {
    label en official "the notice includes the date on which, and the State under the laws of which, the organization was organized (section 506(b)(2))";
}
pub relation section_506a_notice_contains_statement_of_purpose_506b3(o: Person) kind empirical {
    label en official "the notice includes a statement of the purpose of the organization (section 506(b)(3))";
}
pub relation section_506a_notice_complete_506b(o: Person) kind institutional {
    label en official "the section 506(a) notice contains all the information section 506(b) requires";
}
@source(IRC_S506_B, quote = "(1) The name, address, and taxpayer identification number of the organization.")
@source(IRC_S506_B, quote = "(2) The date on which, and the State under the laws of which, the organization was organized.")
@source(IRC_S506_B, quote = "(3) A statement of the purpose of the organization.")
rule Section506aNoticeComplete(o: Person) defeasible {
    label en official "section 506(b)(1)-(3): identity, organization date and State, and statement of purpose";
    when section_506a_notice_contains_identity_506b1(o);
    when section_506a_notice_contains_organization_date_and_state_506b2(o);
    when section_506a_notice_contains_statement_of_purpose_506b3(o);
    then section_506a_notice_complete_506b(o);
}
pub relation section_506a_basic_deadline(o: Person, deadline: Date) kind institutional {
    label en official "60 days after the organization is established";
}
@source(IRC_S506_A, quote = "An organization described in section 501(c)(4) shall, not later than 60 days after the organization is established, notify the Secretary (in such manner as the Secretary shall by regulation prescribe) that it is operating as such.")
rule Section506aBasicDeadline(o: Person, established_on: Date) strict {
    label en official "section 506(a): not later than 60 days after the organization is established";
    when section_501c4_established_on(o, established_on);
    then section_506a_basic_deadline(o, add_calendar_period(established_on, 60 calendar_day));
}
pub relation section_506a_notice_deadline(o: Person, deadline: Date) kind institutional {
    label en official "the deadline for the section 506(a) notice: 60 days after establishment, or the later date the Secretary set under section 506(d) for reasonable cause";
}
pub relation section_506d_extension_granted_for_deadline(o: Person, basic: Date) kind institutional {
    label en official "helper: the Secretary extended the basic deadline (the exception atom that binds every head variable)";
}
rule Section506dExtensionGrantedForDeadline(o: Person, basic: Date, extended: Date) defeasible {
    label en official "helper: an extension later than the basic deadline exists for the organization";
    when section_506a_basic_deadline(o, basic);
    when section_506d_extension_for_reasonable_cause(o, extended);
    when extended > basic;
    then section_506d_extension_granted_for_deadline(o, basic);
}
rule Section506aDeadlineWithoutExtension(o: Person, basic: Date) defeasible {
    label en official "section 506(a): the basic deadline applies when no extension was granted";
    when section_506a_basic_deadline(o, basic);
    unless section_506d_extension_granted_for_deadline(o, basic);
    then section_506a_notice_deadline(o, basic);
}
@source(IRC_S506_D, quote = "The Secretary may, for reasonable cause, extend the 60-day period described in subsection (a).")
rule Section506aDeadlineWithExtension(o: Person, basic: Date, extended: Date) defeasible {
    label en official "section 506(d): for reasonable cause the Secretary may extend the 60-day period — the extended date governs";
    when section_506a_basic_deadline(o, basic);
    when section_506d_extension_for_reasonable_cause(o, extended);
    when extended > basic;
    then section_506a_notice_deadline(o, extended);
}
pub relation section_506a_notice_filed_by_deadline(o: Person) kind institutional {
    label en official "the section 506(a) notice was filed on or before its deadline";
}
@source(IRC_S506_A, quote = "An organization described in section 501(c)(4) shall, not later than 60 days after the organization is established, notify the Secretary (in such manner as the Secretary shall by regulation prescribe) that it is operating as such.")
rule Section506aNoticeFiledByDeadline(o: Person, filed_on: Date, deadline: Date) defeasible {
    label en official "section 506(a): a notice filed on the last day is timely";
    when section_506a_notice_filed(o, filed_on);
    when section_506a_notice_deadline(o, deadline);
    when filed_on <= deadline;
    then section_506a_notice_filed_by_deadline(o);
}
@source(IRC_S506_A, quote = "An organization described in section 501(c)(4) shall, not later than 60 days after the organization is established, notify the Secretary (in such manner as the Secretary shall by regulation prescribe) that it is operating as such.")
rule Section506aNoticeDutyRule(o: Person, y: TaxableYear, established_on: Date, deadline: Date) strict {
    label en official "section 506(a): a section 501(c)(4) organization shall notify the Secretary that it is operating as such not later than 60 days after it is established";
    when section_501c4(o, y);
    when section_501c4_established_on(o, established_on);
    when section_506a_notice_deadline(o, deadline);
    then duty NotifySecretaryOfSection501c4Operation {
        bearer o;
        goal achievement {
            condition section_506a_notice_filed_by_deadline(o);
            window [established_on, deadline];
        }
    };
}
pub relation section_506c_acknowledgment_sent_on(o: Person, sent_on: Date) kind empirical {
    label en official "the date the Secretary sent the organization an acknowledgment of receipt of its section 506(a) notice";
}
pub relation section_506c_acknowledgment_timely(o: Person) kind institutional {
    label en official "the acknowledgment was sent within 60 days after receipt of the notice";
}
@source(IRC_S506_C, quote = "Not later than 60 days after receipt of such a notice, the Secretary shall send to the organization an acknowledgment of such receipt.")
rule Section506cAcknowledgmentTimely(o: Person, filed_on: Date, sent_on: Date) defeasible {
    label en official "section 506(c): the acknowledgment sent not later than 60 days after receipt";
    when section_506a_notice_filed(o, filed_on);
    when section_506c_acknowledgment_sent_on(o, sent_on);
    when sent_on <= add_calendar_period(filed_on, 60 calendar_day);
    then section_506c_acknowledgment_timely(o);
}
@source(IRC_S506_C, quote = "Not later than 60 days after receipt of such a notice, the Secretary shall send to the organization an acknowledgment of such receipt.")
rule Section506cAcknowledgmentDutyRule(o: Person, filed_on: Date) strict {
    label en official "section 506(c): not later than 60 days after receiving a notice the Secretary shall send the organization an acknowledgment of receipt";
    when section_506a_notice_filed(o, filed_on);
    then duty AcknowledgeSection506aNotice {
        bearer Secretary;
        beneficiary o;
        goal achievement {
            condition section_506c_acknowledgment_timely(o);
            window [filed_on, add_calendar_period(filed_on, 60 calendar_day)];
        }
    };
}
pub relation user_fee_imposed_for_506a_notice_506e(notice_of: Person) kind empirical {
    label en official "the Secretary has imposed a user fee for the submission of the section 506(a) notice";
}
@source(IRC_S506_E, quote = "The Secretary shall impose a reasonable user fee for submission of the notice under subsection (a).")
rule Section506eUserFeeDutyRule(o: Person, filed_on: Date) strict {
    label en official "section 506(e): the Secretary shall impose a reasonable user fee for submission of the notice";
    when section_506a_notice_filed(o, filed_on);
    then duty ImposeUserFeeOnSection506aNotice {
        bearer Secretary;
        goal achievement {
            condition user_fee_imposed_for_506a_notice_506e(o);
            window [-infinity, infinity];
        }
    };
}

// ---------------------------------------------------------------------
// Section 507.
// ---------------------------------------------------------------------

pub relation notified_secretary_before_12_or_60_month_period_507b1Bii(o: Person) kind empirical {
    label en official "the organization notified the Secretary, before the commencement of the 12-month or 60-month period (or before the 90th day after the first final regulations under the subsection), that it is terminating its private foundation status";
}
pub relation met_509a1_2_or_3_for_period_507b1Bi(o: Person, period_months: Integer) kind empirical {
    label en official "the organization met section 509(a)(1), (2) or (3) by the end of the 12-month period beginning with its first taxable year beginning after December 31, 1969 (period 12), or for a continuous period of 60 calendar months beginning with the first day of a taxable year beginning after that date (period 60)";
}
pub external judgment relation EstablishedToSecretaryComplianceWithSection507b1Bi(o: Person) {
    authority Secretary;
    label en official "the organization establishes to the satisfaction of the Secretary, immediately after the period expires, that it complied with clause (i) (section 507(b)(1)(B)(iii)) — DECISION-0194 evaluative channel";
}
pub relation no_willful_repeated_or_flagrant_chapter_42_act_507b1(o: Person) kind empirical {
    label en official "there have not been willful repeated acts (or failures to act), or a willful and flagrant act (or failure to act), giving rise to liability for tax under chapter 42";
}
pub relation section_507b1B_termination_conditions_met(o: Person, y: TaxableYear) kind institutional {
    label en official "the section 507(b)(1)(B)(i)-(iii) conditions for termination by operating as a public charity are met";
}
@source(IRC_S507_B, quote = "The status as a private foundation of any organization, with respect to which there have not been either willful repeated acts (or failures to act) or a willful and flagrant act (or failure to act) giving rise to liability for tax under chapter 42, shall be terminated if—")
@source(IRC_S507_B, quote = "(B)(i) such organization meets the requirements of paragraph (1), (2), or (3) of section 509(a) by the end of the 12-month period beginning with its first taxable year which begins after December 31, 1969, or for a continuous period of 60 calendar months beginning with the first day of any taxable year which begins after December 31, 1969,")
@source(IRC_S507_B, quote = "(ii) such organization notifies the Secretary (in such manner as the Secretary may by regulations prescribe) before the commencement of such 12-month or 60-month period (or before the 90th day after the day on which regulations first prescribed under this subsection become final) that it is terminating its private foundation status, and")
@source(IRC_S507_B, quote = "(iii) such organization establishes to the satisfaction of the Secretary (in such manner as the Secretary may by regulations prescribe) immediately after the expiration of such 12-month or 60-month period that such organization has complied with clause (i).")
rule Section507b1BTerminationConditionsMet(o: Person, y: TaxableYear, months: Integer) defeasible {
    label en official "section 507(b)(1)(B): no willful chapter 42 violations, compliance with section 509(a)(1)-(3) for the 12- or 60-month period, notice before the period, and establishment to the Secretary's satisfaction";
    when no_willful_repeated_or_flagrant_chapter_42_act_507b1(o);
    when met_509a1_2_or_3_for_period_507b1Bi(o, months);
    when notified_secretary_before_12_or_60_month_period_507b1Bii(o);
    when EstablishedToSecretaryComplianceWithSection507b1Bi(o);
    when us.irc.core::year_of(o, y);
    then section_507b1B_termination_conditions_met(o, y);
}
@source(IRC_S507_B, quote = "(B)(i) such organization meets the requirements of paragraph (1), (2), or (3) of section 509(a) by the end of the 12-month period beginning with its first taxable year which begins after December 31, 1969, or for a continuous period of 60 calendar months beginning with the first day of any taxable year which begins after December 31, 1969,")
rule Section507b1TerminationViaOperationAsPublicCharity(o: Person, y: TaxableYear) defeasible {
    label en official "section 507(b)(1)(B): private foundation status is terminated when the (B) conditions are met";
    when section_507b1B_termination_conditions_met(o, y);
    then private_foundation_status_terminated(o, y);
}
pub relation section_507b1_flush_years_outside_part_and_chapter_42(o: Person, y: TaxableYear) kind institutional {
    label en official "this part and chapter 42 do not apply to the organization for the taxable year within the 60-month period for which it does meet section 509(a)(1)-(3)";
}
pub relation gave_notice_of_60_month_period_507b1(o: Person) kind empirical {
    label en official "the organization gave notice under subparagraph (B)(ii) of the commencement of a 60-month period";
}
pub relation failed_509a_for_entire_60_month_period_507b1(o: Person) kind empirical {
    label en official "the organization failed to meet section 509(a)(1), (2) or (3) for the entire 60-month period";
}
pub relation meets_509a_in_taxable_year_within_60_month_period_507b1(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization meets section 509(a)(1), (2) or (3) in the taxable year within the 60-month period";
}
@source(IRC_S507_B, quote = "If an organization gives notice under subparagraph (B)(ii) of the commencement of a 60-month period and such organization fails to meet the requirements of paragraph (1), (2), or (3) of section 509(a) for the entire 60-month period, this part and chapter 42 shall not apply to such organization for any taxable year within such 60-month period for which it does meet such requirements.")
rule Section507b1FlushTaxableYearOutsidePartAndChapter42(o: Person, y: TaxableYear) defeasible {
    label en official "section 507(b)(1), last sentence: after a failed 60-month attempt, this part and chapter 42 do not apply for any year within the period in which the organization does meet the requirements";
    when gave_notice_of_60_month_period_507b1(o);
    when failed_509a_for_entire_60_month_period_507b1(o);
    when meets_509a_in_taxable_year_within_60_month_period_507b1(o, y);
    then section_507b1_flush_years_outside_part_and_chapter_42(o, y);
}
pub relation transferee_foundation_507b2(o: Person) kind empirical {
    label en official "the foundation received assets of another private foundation pursuant to a liquidation, merger, redemption, recapitalization, or other adjustment, organization, or reorganization";
}
pub relation transferee_not_treated_as_newly_created_507b2(o: Person) kind institutional {
    label en official "the transferee foundation is not treated as a newly created organization for purposes of this part";
}
@source(IRC_S507_B, quote = "For purposes of this part, in the case of a transfer of assets of any private foundation to another private foundation pursuant to any liquidation, merger, redemption, recapitalization, or other adjustment, organization, or reorganization, the transferee foundation shall not be treated as a newly created organization.")
rule TransfereeNotTreatedAsNewlyCreated(o: Person) defeasible {
    label en official "section 507(b)(2): a transferee foundation is not a newly created organization";
    when transferee_foundation_507b2(o);
    then transferee_not_treated_as_newly_created_507b2(o);
}
pub relation contributions_and_bequests_by_person_507d2A(person: Person, foundation: Person, amount: Money) kind empirical {
    label en official "the aggregate amount contributed or bequeathed by the person to the foundation (each valued at fair market value on the date received; an individual is treated as making all the contributions of his spouse; contributions received on or before October 9, 1969 by a foundation then in existence are treated as received on that date)";
}
pub relation total_contributions_and_bequests_received_507d2A(foundation: Person, amount: Money) kind empirical {
    label en official "the total contributions and bequests received by the foundation before the close of the taxable year in which the contribution or bequest is received from the person";
}
pub relation creator_of_trust_507d2A(person: Person, foundation: Person) kind empirical {
    label en official "the person is the creator of the foundation, which is a trust";
}
pub relation substantial_contributor_507d2(person: Person, foundation: Person) kind institutional {
    label en official "the person is a substantial contributor to the private foundation";
}
@source(IRC_S507_D, quote = "For purposes of paragraph (1), the term \"substantial contributor\" means any person who contributed or bequeathed an aggregate amount of more than $5,000 to the private foundation, if such amount is more than 2 percent of the total contributions and bequests received by the foundation before the close of the taxable year of the foundation in which the contribution or bequest is received by the foundation from such person. In the case of a trust, the term \"substantial contributor\" also means the c")
rule SubstantialContributorByAmountAndShare(person: Person, foundation: Person, amount: Money, total: Money) defeasible {
    label en official "section 507(d)(2)(A): more than $5,000 and more than 2 percent of total contributions and bequests — exactly $5,000 or exactly 2 percent does not qualify";
    when contributions_and_bequests_by_person_507d2A(person, foundation, amount);
    when total_contributions_and_bequests_received_507d2A(foundation, total);
    when amount > 5000.00 USD;
    when amount * 100 > total * 2;
    then substantial_contributor_507d2(person, foundation);
}
@source(IRC_S507_D, quote = "For purposes of paragraph (1), the term \"substantial contributor\" means any person who contributed or bequeathed an aggregate amount of more than $5,000 to the private foundation, if such amount is more than 2 percent of the total contributions and bequests received by the foundation before the close of the taxable year of the foundation in which the contribution or bequest is received by the foundation from such person. In the case of a trust, the term \"substantial contributor\" also means the c")
rule SubstantialContributorTrustCreator(person: Person, foundation: Person) defeasible {
    label en official "section 507(d)(2)(A), last sentence: in the case of a trust, the creator is also a substantial contributor";
    when creator_of_trust_507d2A(person, foundation);
    then substantial_contributor_507d2(person, foundation);
}
pub relation was_substantial_contributor_on_an_earlier_date_507d2Biv(person: Person, foundation: Person) kind empirical {
    label en official "the person was a substantial contributor on an earlier date";
}
pub relation remains_substantial_contributor_507d2Biv(person: Person, foundation: Person) kind institutional {
    label en official "the person remains a substantial contributor for all subsequent periods, subject to the (C) ceasing rule";
}
@source(IRC_S507_D, quote = "(iv) any person who is a substantial contributor on any date shall remain a substantial contributor for all subsequent periods.")
rule RemainsSubstantialContributor(person: Person, foundation: Person) defeasible {
    label en official "section 507(d)(2)(B)(iv): once a substantial contributor, always one for later periods";
    when was_substantial_contributor_on_an_earlier_date_507d2Biv(person, foundation);
    unless ceased_to_be_substantial_contributor_507d2C(person, foundation);
    then remains_substantial_contributor_507d2Biv(person, foundation);
}
pub relation no_contribution_by_person_or_related_persons_in_10_years_507d2Ci(person: Person, foundation: Person) kind empirical {
    label en official "during the 10-year period ending at the close of the taxable year the person (and all related persons) made no contribution to the foundation";
}
pub relation no_foundation_manager_role_in_10_years_507d2Cii(person: Person, foundation: Person) kind empirical {
    label en official "at no time during the 10-year period was the person (or any related person) a foundation manager of the foundation";
}
pub external judgment relation SecretaryDeterminesContributionsInsignificantCompared507d2CiIII(person: Person, foundation: Person) {
    authority Secretary;
    label en official "the Secretary determines the aggregate contributions made by the person (and related persons), taking appreciation into account, to be insignificant compared with the aggregate contributions of one other person (section 507(d)(2)(C)(i)(III)) — DECISION-0194 evaluative channel";
}
pub relation ceased_to_be_substantial_contributor_507d2C(person: Person, foundation: Person) kind institutional {
    label en official "the person ceases to be treated as a substantial contributor as of the close of the taxable year";
}
@source(IRC_S507_D, quote = "(I) during the 10-year period ending at the close of such taxable year such person (and all related persons) have not made any contribution to such private foundation,")
@source(IRC_S507_D, quote = "(II) at no time during such 10-year period was such person (or any related person) a foundation manager of such private foundation, and")
@source(IRC_S507_D, quote = "(III) the aggregate contributions made by such person (and related persons) are determined by the Secretary to be insignificant when compared to the aggregate amount of contributions to such foundation by one other person.")
rule CeasedToBeSubstantialContributor(person: Person, foundation: Person) defeasible {
    label en official "section 507(d)(2)(C): no contribution and no manager role for 10 years and insignificant contributions compared with another person's";
    when no_contribution_by_person_or_related_persons_in_10_years_507d2Ci(person, foundation);
    when no_foundation_manager_role_in_10_years_507d2Cii(person, foundation);
    when SecretaryDeterminesContributionsInsignificantCompared507d2CiIII(person, foundation);
    then ceased_to_be_substantial_contributor_507d2C(person, foundation);
}
pub relation net_asset_value_on_first_day_of_culminating_action_507e1(o: Person, amount: Money) kind empirical {
    label en official "the value of the net assets on the first day on which action is taken by the organization which culminates in its ceasing to be a private foundation";
}
pub relation net_asset_value_on_date_of_ceasing_507e2(o: Person, amount: Money) kind empirical {
    label en official "the value of the net assets on the date on which the organization ceases to be a private foundation";
}
pub relation net_asset_value_for_507c_at_the_higher_time_507e(o: Person, amount: Money) kind institutional {
    label en official "the value of the net assets for section 507(c): whichever of the two values is higher";
}
@source(IRC_S507_E, quote = "For purposes of subsection (c), the value of the net assets shall be determined at whichever time such value is higher: (1) the first day on which action is taken by the organization which culminates in its ceasing to be a private foundation, or (2) the date on which it ceases to be a private foundation.")
rule NetAssetValueIsTheHigherOfTheTwo(o: Person, first_day_value: Money, ceasing_value: Money) defeasible {
    label en official "section 507(e): the higher of the value on the first day of the culminating action and the value on the day of ceasing (equal values give the same figure)";
    when net_asset_value_on_first_day_of_culminating_action_507e1(o, first_day_value);
    when net_asset_value_on_date_of_ceasing_507e2(o, ceasing_value);
    then net_asset_value_for_507c_at_the_higher_time_507e(o, max(first_day_value, ceasing_value));
}
@source(IRC_S507_C, quote = "(2) the value of the net assets of such foundation.")
rule TerminationTax507LowerIsBenefitHigherValue(o: Person, benefit: Money, value: Money) defeasible {
    label en official "section 507(c) with the section 507(e) value: the tax is the lower of the aggregate tax benefit and the higher net asset value — when the benefit is lower";
    when aggregate_tax_benefit(o, benefit);
    when net_asset_value_for_507c_at_the_higher_time_507e(o, value);
    when benefit <= value;
    then termination_tax_507(o, benefit);
}
@source(IRC_S507_C, quote = "(2) the value of the net assets of such foundation.")
rule TerminationTax507LowerIsAssetsHigherValue(o: Person, benefit: Money, value: Money) defeasible {
    label en official "section 507(c) with the section 507(e) value: when the higher net asset value is lower";
    when aggregate_tax_benefit(o, benefit);
    when net_asset_value_for_507c_at_the_higher_time_507e(o, value);
    when value < benefit;
    then termination_tax_507(o, value);
}
pub relation first_day_of_action_culminating_in_ceasing_507f(o: Person, first_day: Date) kind empirical {
    label en official "the first day on which action is taken by the organization which culminates in its ceasing to be a private foundation";
}
pub relation assets_transferred_by_private_foundation_507f(o: Person) kind empirical {
    label en official "the private foundation transferred assets";
}
pub relation termination_tax_deemed_imposed_on_507f(o: Person, on: Date) kind institutional {
    label en official "for determining liability for the section 507(c) tax on transferred assets, the tax is deemed imposed on this date";
}
@source(IRC_S507_F, quote = "For purposes of determining liability for the tax imposed by subsection (c) in the case of assets transferred by the private foundation, such tax shall be deemed to have been imposed on the first day on which action is taken by the organization which culminates in its ceasing to be a private foundation.")
rule TerminationTaxDeemedImposedOnFirstDayOfAction(o: Person, first_day: Date) defeasible {
    label en official "section 507(f): for transferred assets the tax is deemed imposed on the first day of the culminating action";
    when assets_transferred_by_private_foundation_507f(o);
    when first_day_of_action_culminating_in_ceasing_507f(o, first_day);
    then termination_tax_deemed_imposed_on_507f(o, first_day);
}

// ---------------------------------------------------------------------
// Section 508.
// ---------------------------------------------------------------------

pub relation gift_to_private_foundation_or_4947_trust_failing_508e_in_year_508d2A(donor: Person, org: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "a gift or bequest made to a private foundation or a section 4947 trust in a taxable year for which it fails to meet the section 508(e) requirements (determined without regard to subsection (e)(2))";
}
pub relation gift_to_organization_for_period_not_treated_as_c3_by_reason_of_508a_508d2B(donor: Person, org: Person, amount: Money) kind empirical {
    label en official "a gift or bequest made to an organization in a period for which it is not treated as a section 501(c)(3) organization by reason of subsection (a)";
}
pub relation charitable_deduction_disallowed_508d2(donor: Person, org: Person, amount: Money) kind institutional {
    label en official "no deduction is allowed under section 170, 545(b)(2), 642(c), 2055, 2106(a)(2), or 2522 for the gift or bequest";
}
@source(IRC_S508_D, quote = "(A) to a private foundation or a trust described in section 4947 in a taxable year for which it fails to meet the requirements of subsection (e) (determined without regard to subsection (e)(2)), or")
rule CharitableDeductionDisallowed508d2A(donor: Person, org: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 508(d)(2)(A): gifts to a private foundation or section 4947 trust failing the governing-instrument requirements";
    when gift_to_private_foundation_or_4947_trust_failing_508e_in_year_508d2A(donor, org, y, amount);
    then charitable_deduction_disallowed_508d2(donor, org, amount);
}
@source(IRC_S508_D, quote = "(B) to any organization in a period for which it is not treated as an organization described in section 501(c)(3) by reason of subsection (a).")
rule CharitableDeductionDisallowed508d2B(donor: Person, org: Person, amount: Money) defeasible {
    label en official "section 508(d)(2)(B): gifts to an organization not treated as a section 501(c)(3) organization by reason of subsection (a)";
    when gift_to_organization_for_period_not_treated_as_c3_by_reason_of_508a_508d2B(donor, org, amount);
    then charitable_deduction_disallowed_508d2(donor, org, amount);
}
pub relation section_507c_tax_entirely_abated_508d3(org: Person) kind empirical {
    label en official "the entire amount of the unpaid portion of the section 507(c) tax is abated by the Secretary under section 507(g)";
}
pub relation gift_within_508d3_exception(donor: Person, org: Person, amount: Money) kind institutional {
    label en official "helper: a gift covered by paragraph (1) to an organization whose whole unpaid section 507(c) tax is abated (paragraph (3) exception)";
}
@source(IRC_S508_D, quote = "Paragraph (1) shall not apply if the entire amount of the unpaid portion of the tax imposed by section 507(c) is abated by the Secretary under section 507(g).")
rule GiftWithin508d3ExceptionViaA(donor: Person, org: Person, amount: Money) defeasible {
    label en official "section 508(d)(3): paragraph (1)(A) does not apply when the entire tax is abated";
    when gift_made_after_507a_notification(donor, org, amount);
    when section_507c_tax_entirely_abated_508d3(org);
    then gift_within_508d3_exception(donor, org, amount);
}
@source(IRC_S508_D, quote = "Paragraph (1) shall not apply if the entire amount of the unpaid portion of the tax imposed by section 507(c) is abated by the Secretary under section 507(g).")
rule GiftWithin508d3ExceptionViaB(donor: Person, org: Person, amount: Money) defeasible {
    label en official "section 508(d)(3): paragraph (1)(B) does not apply when the entire tax is abated";
    when gift_by_substantial_contributor_in_tainted_year_508d1B(donor, org, amount);
    when section_507c_tax_entirely_abated_508d3(org);
    then gift_within_508d3_exception(donor, org, amount);
}
pub relation organized_before_1970_508e2(o: Person) kind empirical {
    label en official "the organization was organized before January 1, 1970";
}
pub relation judicial_proceeding_begun_before_1972_to_reform_governing_instrument_508e2A(o: Person, begun_on: Date) kind empirical {
    label en official "the private foundation began before January 1, 1972 a judicial proceeding necessary to reform, or to excuse it from compliance with, its governing instrument or any other instrument in order to meet paragraph (1)";
}
pub relation judicial_proceeding_terminated_on_508e2B(o: Person, ended_on: Date) kind empirical {
    label en official "the judicial proceeding terminated on the date";
}
pub relation governing_instrument_does_not_permit_compliance_508e2B(o: Person, on: Date) kind empirical {
    label en official "on the date the governing instrument or any other instrument does not permit the foundation to meet the requirements of paragraph (1)";
}
pub relation date_asked_508e2(o: Person, on: Date) kind empirical {
    label en official "the date for which it is asked whether paragraph (1) applies to the organization";
}
pub relation proceeding_terminated_before_date_508e2(o: Person, on: Date) kind institutional {
    label en official "the judicial proceeding terminated before the date";
}
rule ProceedingTerminatedBeforeDate(o: Person, on: Date, ended: Date) defeasible {
    label en official "helper: a termination date earlier than the date asked";
    when date_asked_508e2(o, on);
    when judicial_proceeding_terminated_on_508e2B(o, ended);
    when ended < on;
    then proceeding_terminated_before_date_508e2(o, on);
}
pub relation period_within_508e2_exception(o: Person, on: Date) kind institutional {
    label en official "paragraph (1) does not apply to the organization for the date";
}
@source(IRC_S508_E, quote = "(A) to any period after December 31, 1971, during the pendency of any judicial proceeding begun before January 1, 1972, by the private foundation which is necessary to reform, or to excuse such foundation from compliance with, its governing instrument or any other instrument in order to meet the requirements of paragraph (1), and")
rule Period508e2AWithinPendingProceeding(o: Person, on: Date, begun: Date) defeasible {
    label en official "section 508(e)(2)(A): any period after December 31, 1971 during the pendency of a proceeding begun before January 1, 1972 — a proceeding is pending until the day it terminates";
    when organized_before_1970_508e2(o);
    when judicial_proceeding_begun_before_1972_to_reform_governing_instrument_508e2A(o, begun);
    when begun < @1972-01-01;
    when date_asked_508e2(o, on);
    when on > @1971-12-31;
    unless proceeding_terminated_before_date_508e2(o, on);
    then period_within_508e2_exception(o, on);
}
@source(IRC_S508_E, quote = "(B) to any period after the termination of any judicial proceeding described in subparagraph (A) during which its governing instrument or any other instrument does not permit it to meet the requirements of paragraph (1).")
rule Period508e2BAfterTerminationWhileInstrumentPrevents(o: Person, on: Date, ended: Date) defeasible {
    label en official "section 508(e)(2)(B): after the proceeding terminates, any period in which the instruments do not permit compliance";
    when organized_before_1970_508e2(o);
    when judicial_proceeding_terminated_on_508e2B(o, ended);
    when date_asked_508e2(o, on);
    when on > ended;
    when governing_instrument_does_not_permit_compliance_508e2B(o, on);
    then period_within_508e2_exception(o, on);
}
@source(IRC_S508_F, quote = "A sponsoring organization (as defined in section 4966(d)(1)) shall give notice to the Secretary (in such manner as the Secretary may provide) whether such organization maintains or intends to maintain donor advised funds (as defined in section 4966(d)(2)) and the manner in which such organization plans to operate such funds.")
rule Section508fSponsoringOrganizationNoticeDutyRule(o: Person) strict {
    label en official "section 508(f): a sponsoring organization shall give notice to the Secretary whether it maintains or intends to maintain donor advised funds";
    when sponsoring_organization_4966d1(o);
    then duty GiveSection508fSponsoringOrganizationNotice {
        bearer o;
        goal achievement {
            condition section_508f_sponsoring_organization_notice_given(o);
            window [-infinity, infinity];
        }
    };
}

// ---------------------------------------------------------------------
// Section 509.
// ---------------------------------------------------------------------

pub relation described_in_509a2_for_509a3_purposes(o: Person, y: TaxableYear) kind institutional {
    label en official "for section 509(a)(3), an organization described in paragraph (2) includes a section 501(c)(4), (5) or (6) organization that would be described in paragraph (2) if it were a section 501(c)(3) organization";
}
pub relation section_501c4_5_or_6_organization_for_509a(o: Person, y: TaxableYear) kind institutional {
    label en official "the organization is described in section 501(c)(4), (5) or (6)";
}
rule C4ForSection509aLastSentence(o: Person, y: TaxableYear) defeasible {
    label en official "section 509(a), last sentence: paragraph (4)";
    when section_501c4(o, y);
    then section_501c4_5_or_6_organization_for_509a(o, y);
}
rule C5ForSection509aLastSentence(o: Person, y: TaxableYear) defeasible {
    label en official "section 509(a), last sentence: paragraph (5)";
    when section_501c5(o, y);
    then section_501c4_5_or_6_organization_for_509a(o, y);
}
rule C6ForSection509aLastSentence(o: Person, y: TaxableYear) defeasible {
    label en official "section 509(a), last sentence: paragraph (6)";
    when section_501c6(o, y);
    then section_501c4_5_or_6_organization_for_509a(o, y);
}
@source(IRC_S509_A, quote = "For purposes of paragraph (3), an organization described in paragraph (2) shall be deemed to include an organization described in section 501(c)(4), (5), or (6) which would be described in paragraph (2) if it were an organization described in section 501(c)(3).")
rule DeemedDescribedIn509a2ForThe509a3Test(o: Person, y: TaxableYear) defeasible {
    label en official "section 509(a), last sentence: a section 501(c)(4), (5) or (6) organization that would satisfy the paragraph (2) support tests is treated as a paragraph (2) organization for paragraph (3)";
    when section_501c4_5_or_6_organization_for_509a(o, y);
    when meets_509a2A_more_than_one_third_support(o, y);
    when meets_509a2B_not_more_than_one_third_investment(o, y);
    then described_in_509a2_for_509a3_purposes(o, y);
}
pub relation private_foundation_status_continues_509b(o: Person, y: TaxableYear) kind institutional {
    label en official "the organization, a private foundation on October 9, 1969 or thereafter, is treated as a private foundation for the taxable year";
}
pub relation private_foundation_since_509b(o: Person, since: TaxableYear) kind empirical {
    label en official "the taxable year in which the organization was, or became, a private foundation (on or after October 9, 1969)";
}
pub relation status_terminated_under_507_in_or_before_509b(o: Person, y: TaxableYear) kind institutional {
    label en official "the private foundation status was terminated under section 507 in a taxable year not after the given taxable year";
}
rule StatusTerminatedInOrBefore(o: Person, y: TaxableYear, ty: TaxableYear, n: Integer, nt: Integer) defeasible {
    label en official "section 509(b): termination under section 507 in or before the taxable year";
    when private_foundation_status_terminated(o, ty);
    when us.irc.core::calendar_year_of(ty, nt);
    when us.irc.core::calendar_year_of(y, n);
    when nt <= n;
    then status_terminated_under_507_in_or_before_509b(o, y);
}
@source(IRC_S509_B, quote = "For purposes of this title, if an organization is a private foundation (within the meaning of subsection (a)) on October 9, 1969, or becomes a private foundation on any subsequent date, such organization shall be treated as a private foundation for all periods after October 9, 1969, or after such subsequent date, unless its status as such is terminated under section 507.")
rule PrivateFoundationStatusContinues(o: Person, y: TaxableYear, since: TaxableYear, ns: Integer, n: Integer) defeasible {
    label en official "section 509(b): a private foundation remains one for all subsequent periods except as section 507 provides";
    when private_foundation_since_509b(o, since);
    when us.irc.core::calendar_year_of(since, ns);
    when us.irc.core::calendar_year_of(y, n);
    when n >= ns;
    unless status_terminated_under_507_in_or_before_509b(o, y);
    then private_foundation_status_continues_509b(o, y);
}
pub relation treated_as_newly_created_organization_509c(o: Person, y: TaxableYear) kind institutional {
    label en official "the organization whose private foundation status was terminated under section 507 is treated as a newly created organization (except a transferee under section 507(b)(2))";
}
pub relation transferee_not_treated_as_newly_created_for_year(o: Person, y: TaxableYear) kind institutional {
    label en official "helper: the transferee exception of section 507(b)(2), bound to the year";
}
rule TransfereeNotTreatedAsNewlyCreatedForYear(o: Person, y: TaxableYear) defeasible {
    label en official "helper: a transferee foundation";
    when transferee_not_treated_as_newly_created_507b2(o);
    when us.irc.core::year_of(o, y);
    then transferee_not_treated_as_newly_created_for_year(o, y);
}
@source(IRC_S509_C, quote = "For purposes of this part, an organization the status of which as a private foundation is terminated under section 507 shall (except as provided in section 507(b)(2)) be treated as an organization created on the day after the date of such termination.")
rule TerminatedFoundationTreatedAsNewlyCreated(o: Person, y: TaxableYear) defeasible {
    label en official "section 509(c): an organization whose private foundation status is terminated is treated as newly created, except as section 507(b)(2) provides";
    when private_foundation_status_terminated(o, y);
    unless transferee_not_treated_as_newly_created_for_year(o, y);
    then treated_as_newly_created_organization_509c(o, y);
}
pub enum SupportComponent509d { GiftsGrantsContributionsMembershipFees, GrossReceiptsFromRelatedActivities, NetIncomeFromUnrelatedBusinessActivities, GrossInvestmentIncome, TaxRevenuesLeviedForBenefit, ValueOfGovernmentalServicesOrFacilities }
pub relation support_component_509d(o: Person, y: TaxableYear, kind: SupportComponent509d, amount: Money) kind empirical {
    label en official "an amount of the organization's support of the given kind for the taxable year: gifts, grants, contributions or membership fees (1); gross receipts from admissions, sales, services or facilities in an activity that is not an unrelated trade or business (2); net income from unrelated business activities, whether or not regularly carried on (3); gross investment income (4); tax revenues levied for its benefit and paid to it or expended on its behalf (5); the value of services or facilities furnished by a governmental unit without charge to the public (6) — gain from the sale of a capital asset and the value of exempt function services are not support";
}
pub relation total_support_509d(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the organization's total support: the sum of its support components";
}
@source(IRC_S509_D, quote = "For purposes of this part and chapter 42, the term \"support\" includes (but is not limited to)—")
@source(IRC_S509_D, quote = "(1) gifts, grants, contributions, or membership fees,")
@source(IRC_S509_D, quote = "(2) gross receipts from admissions, sales of merchandise, performance of services, or furnishing of facilities in any activity which is not an unrelated trade or business (within the meaning of section 513),")
@source(IRC_S509_D, quote = "(3) net income from unrelated business activities, whether or not such activities are carried on regularly as a trade or business,")
@source(IRC_S509_D, quote = "(4) gross investment income (as defined in subsection (e)),")
@source(IRC_S509_D, quote = "(5) tax revenues levied for the benefit of an organization and either paid to or expended on behalf of such organization, and")
@source(IRC_S509_D, quote = "(6) the value of services or facilities (exclusive of services or facilities generally furnished to the public without charge) furnished by a governmental unit referred to in section 170(c)(1) to an organization without charge.")
@source(IRC_S509_D, quote = "Such term does not include any gain from the sale or other disposition of property which would be considered as gain from the sale or exchange of a capital asset, or the value of exemption from any Federal, State, or local tax or any similar benefit.")
rule TotalSupportIsSumOfComponents(o: Person, y: TaxableYear) defeasible {
    label en official "section 509(d)(1)-(6): support is the sum of the six kinds of receipt";
    when us.irc.core::year_of(o, y);
    then total_support_509d(o, y, sum all a: Money for k: SupportComponent509d where support_component_509d(o, y, k, a));
}
pub relation gross_income_from_investment_source_509e(o: Person, y: TaxableYear, investment_source: Text, amount: Money) kind empirical {
    label en official "gross income from interest, dividends, payments with respect to securities loans (section 512(a)(5)), rents, royalties, or a similar source, not including income to the extent included in computing the tax imposed by section 511";
}
pub relation gross_investment_income_from_sources_509e(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the gross amount of gross investment income for the taxable year, summed over its sources";
}
@source(IRC_S509_E, quote = "For purposes of subsection (d), the term \"gross investment income\" means the gross amount of income from interest, dividends, payments with respect to securities loans (as defined in section 512(a)(5)), rents, and royalties, but not including any such income to the extent included in computing the tax imposed by section 511. Such term shall also include income from sources similar to those in the preceding sentence.")
rule GrossInvestmentIncomeIsSumOfSources(o: Person, y: TaxableYear) defeasible {
    label en official "section 509(e): the gross amount of investment income across the listed and similar sources, excluding income included in the section 511 tax base";
    when us.irc.core::year_of(o, y);
    then gross_investment_income_from_sources_509e(o, y, sum all a: Money for s: Text where gross_income_from_investment_source_509e(o, y, s, a));
}
@source(IRC_S509_A, quote = "(i) gifts, grants, contributions, or membership fees, and")
@source(IRC_S509_A, quote = "(ii) gross receipts from admissions, sales of merchandise, performance of services, or furnishing of facilities, in an activity which is not an unrelated trade or business (within the meaning of section 513), not including such receipts from any person, or from any bureau or similar agency of a governmental unit (as described in section 170(c)(1)), in any taxable year to the extent such receipts exceed the greater of $5,000 or 1 percent of the organization's support in such taxable year,")
@source(IRC_S509_A, quote = "from persons other than disqualified persons (as defined in section 4946) with respect to the organization, from governmental units described in section 170(c)(1), or from organizations described in section 170(b)(1)(A) (other than in clauses (vii) and (viii)), and")
rule Meets509a2ASupportTestFromComponents(o: Person, y: TaxableYear, gifts: Money, receipts: Money, total: Money) defeasible {
    label en official "section 509(a)(2)(A) with support computed under section 509(d): 3 * (gifts + qualifying receipts) > total support";
    when aggregate_gifts_grants_and_membership_fees(o, y, gifts);
    when aggregate_qualifying_admissions_and_sales_receipts(o, y, receipts);
    when section_509a2a_source_restriction_applied(o, y);
    when total_support_509d(o, y, total);
    when (gifts + receipts) * 3 > total;
    then meets_509a2A_more_than_one_third_support(o, y);
}
@source(IRC_S509_A, quote = "(i) gross investment income (as defined in subsection (e)) and")
@source(IRC_S509_A, quote = "(ii) the excess (if any) of the amount of the unrelated business taxable income (as defined in section 512) over the amount of the tax imposed by section 511;")
rule Meets509a2BInvestmentCeilingFromComponents(o: Person, y: TaxableYear, investment: Money, ubti_excess: Money, total: Money) defeasible {
    label en official "section 509(a)(2)(B) with support computed under section 509(d) and investment income under section 509(e): 3 * (investment income + UBTI excess) <= total support";
    when gross_investment_income_from_sources_509e(o, y, investment);
    when aggregate_ubti_excess_over_511_tax(o, y, ubti_excess);
    when total_support_509d(o, y, total);
    when (investment + ubti_excess) * 3 <= total;
    then meets_509a2B_not_more_than_one_third_investment(o, y);
}
