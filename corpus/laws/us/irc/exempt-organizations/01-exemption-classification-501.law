// Section 501(a)-(c): the exemption itself as an institutional
// classification, not an immunity from tax — the task brief's own framing:
// `exempt_organization(o, y)` is a status; the consequence (no tax under
// section 11/1 except UBIT under part II) is carried by the section 511/512
// module (06-ubit-511-514.law), which never asserts `us.irc.core::liability`
// against an organization holding this status for any TaxKind this package
// does not itself compute.
//
// SCOPE (stage 1, priority sections per the task): 501(a) mechanism in
// full; 501(c)(3) in full (organizational/operational test, inurement,
// lobbying — including the (h) election — and campaign-intervention
// prohibition); 501(c)(4) as a plain classification (assignment's own
// scope: "(c)(4) social welfare ... only what the pinned text says", no
// further detail requested). 501(c)(1),(2),(5)-(29) and 501(d),(e)-(q) other
// than (h)/(p)/(r) are NOT modelled this stage — `unreviewed`, "stage 2" —
// 534 disposition rows sit under section 501 alone and stage 1's budget
// does not reach a per-paragraph classification for all 29 categories.
// 501(p) (terrorist-organization suspension) is likewise not modelled this
// stage (see the coverage note under S501-TECH-GAPS).

// ---------------------------------------------------------------------
// (a) Exemption from taxation.
// ---------------------------------------------------------------------

use self::{
    IRC_S501_A,
    IRC_S501_B,
    IRC_S501_C,
    IRC_S501_H,
    IRC_S502_A,
    Person,
    TaxableYear,
    barred_from_501c4_for_year_504a,
    credit_counseling_organization_not_exempt_501q,
    exemption_denied_under_501i,
    exemption_denied_under_501m1,
    exemption_suspended_under_501p,
    hospital_denied_501c3_by_501r,
    section_508_notice_requirement_unsatisfied_for_year,
};

@source(IRC_S501_A, quote = "An organization described in subsection (c) or (d) or section 401(a) shall be exempt from taxation under this subtitle unless such exemption is denied under section 502 or 503.")
pub relation exempt_organization(o: Person, y: TaxableYear) kind institutional {
    label en official "an organization exempt from taxation under section 501(a) for the taxable year";
}

@source(IRC_S501_C, quote = "The following organizations are referred to in subsection (a):")
pub relation described_in_501c(o: Person, y: TaxableYear) kind institutional {
    label en official "an organization described in section 501(c), for the taxable year";
}

// section 501(d) (religious/apostolic associations) and section 401(a)
// (qualified pension, profit-sharing and stock bonus plans) are separate
// exemption paths this package does not own — EXTERNAL_DEPENDENCY
// (`deferred-compensation` owns section 401(a); no owner for 501(d) is
// recorded in OWNERSHIP.json as read). Modelled here as institutional
// switches this package reads, never computed by this package.
pub relation described_in_501d(o: Person, y: TaxableYear) kind institutional {
    label en unofficial "an organization described in section 501(d) (religious or apostolic association) — EXTERNAL_DEPENDENCY, no owner package recorded";
}
pub relation described_in_401a(o: Person, y: TaxableYear) kind institutional {
    label en unofficial "a plan described in section 401(a) — EXTERNAL_DEPENDENCY on `us.irc.deferred-compensation`";
}

@source(IRC_S502_A, quote = "An organization operated for the primary purpose of carrying on a trade or business for profit shall not be exempt from taxation under section 501")
pub relation exemption_denied_under_502_or_503(o: Person, y: TaxableYear) kind institutional {
    label en official "the section 501(a) exemption is denied under section 502 (feeder organization) or section 503 (prohibited transaction)";
}

@source(IRC_S501_A, quote = "An organization described in subsection (c) or (d) or section 401(a) shall be exempt from taxation under this subtitle unless such exemption is denied under section 502 or 503.")
rule ExemptFromDescribedInC(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(a): an organization described in subsection (c) is exempt from taxation under this subtitle, unless the exemption is denied under section 502 or 503";
    when described_in_501c(o, y);
    unless exemption_denied_under_502_or_503(o, y);
    unless exemption_denied_under_501i(o, y);
    unless exemption_denied_under_501m1(o, y);
    unless exemption_suspended_under_501p(o, y);
    unless credit_counseling_organization_not_exempt_501q(o, y);
    then exempt_organization(o, y);
}
@source(IRC_S501_A, quote = "An organization described in subsection (c) or (d) or section 401(a) shall be exempt from taxation under this subtitle unless such exemption is denied under section 502 or 503.")
rule ExemptFromDescribedInD(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(a): an organization described in subsection (d) is exempt from taxation under this subtitle, unless the exemption is denied under section 502 or 503";
    when described_in_501d(o, y);
    unless exemption_denied_under_502_or_503(o, y);
    unless exemption_suspended_under_501p(o, y);
    then exempt_organization(o, y);
}
@source(IRC_S501_A, quote = "An organization described in subsection (c) or (d) or section 401(a) shall be exempt from taxation under this subtitle unless such exemption is denied under section 502 or 503.")
rule ExemptFromDescribed401a(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(a): a trust described in section 401(a) is exempt from taxation under this subtitle, unless the exemption is denied under section 502 or 503";
    when described_in_401a(o, y);
    unless exemption_denied_under_502_or_503(o, y);
    unless exemption_suspended_under_501p(o, y);
    then exempt_organization(o, y);
}

// (b) tax on unrelated business income and certain other activities:
// exemption from OTHER laws referring to income-tax-exempt organizations
// survives the part II/III/VI taxes (UBIT among them). Modelled as its own
// institutional_effect head so the section 511 module's tax does not have
// to (and structurally cannot) undo the section 501(a) classification.
@source(IRC_S501_B, quote = "An organization exempt from taxation under subsection (a) shall be subject to tax to the extent provided in parts II, III, and VI of this subchapter, but (notwithstanding parts II, III, and VI of this subchapter) shall be considered an organization exempt from income taxes for the purpose of any law which refers to organizations exempt from income taxes.")
pub relation treated_as_income_tax_exempt_for_other_laws(o: Person, y: TaxableYear) kind institutional {
    label en official "section 501(b): notwithstanding parts II, III and VI of this subchapter, the organization is considered exempt from income taxes for the purpose of any law referring to income-tax-exempt organizations";
}
@source(IRC_S501_B, quote = "An organization exempt from taxation under subsection (a) shall be subject to tax to the extent provided in parts II, III, and VI of this subchapter, but (notwithstanding parts II, III, and VI of this subchapter) shall be considered an organization exempt from income taxes for the purpose of any law which refers to organizations exempt from income taxes.")
rule Section501bStillTreatedExempt(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(b): an organization exempt under section 501(a) is still considered income-tax-exempt for the purpose of any law referring to income-tax-exempt organizations, notwithstanding UBIT";
    when exempt_organization(o, y);
    then treated_as_income_tax_exempt_for_other_laws(o, y);
}

// ---------------------------------------------------------------------
// (c)(3): the flagship category.
// ---------------------------------------------------------------------
//
// EVALUATIVE ELEMENTS (DECISION-0194, per the task's own framing): the
// organizational and operational tests are 26 CFR 1.501(c)(3)-1's content,
// not this statute's — EXTERNAL_DEPENDENCY, channelled as an `external
// judgment relation` naming the Secretary (the authority the statute
// itself names for administering exemption determinations, section
// 7701(a)(11)(B)); "no substantial part... carrying on propaganda... to
// influence legislation" (lobbying) and "exclusively" are likewise
// evaluative and channelled the same way UNLESS the organization has made
// the (h) election, in which case the (h) expenditure test displaces the
// evaluative "substantial part" test with an exact computation keyed to
// section 4911 (external — excise-entities' contract).

pub external judgment relation Section501c3OrganizedExclusively(o: Person) {
    authority Secretary;
    label en official "the organization is organized exclusively for a purpose described in section 501(c)(3) (26 CFR 1.501(c)(3)-1(b), organizational test) — DECISION-0194 evaluative channel";
}
pub external judgment relation Section501c3OperatedExclusively(o: Person) {
    authority Secretary;
    label en official "the organization is operated exclusively for a purpose described in section 501(c)(3) (26 CFR 1.501(c)(3)-1(c), operational test) — DECISION-0194 evaluative channel";
}

@source(IRC_S501_C, quote = "no part of the net earnings of which inures to the benefit of any private shareholder or individual")
pub relation private_inurement_established(o: Person, y: TaxableYear) kind empirical {
    label en official "a part of the organization's net earnings inures to the benefit of a private shareholder or individual, in the taxable year";
}

@source(IRC_S501_C, quote = "no substantial part of the activities of which is carrying on propaganda, or otherwise attempting, to influence legislation (except as otherwise provided in subsection (h))")
pub external judgment relation SubstantialLegislativeActivity(o: Person, y: TaxableYear) {
    authority Secretary;
    label en official "a substantial part of the organization's activities is carrying on propaganda, or otherwise attempting, to influence legislation (section 501(c)(3), absent an (h) election) — DECISION-0194 evaluative channel";
}

@source(IRC_S501_C, quote = "which does not participate in, or intervene in (including the publishing or distributing of statements), any political campaign on behalf of (or in opposition to) any candidate for public office")
pub relation political_campaign_intervention_established(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization participated or intervened (including by publishing or distributing statements) in a political campaign on behalf of or in opposition to a candidate for public office, in the taxable year";
}

@source(IRC_S501_C, quote = "Corporations, and any community chest, fund, or foundation, organized and operated exclusively for religious, charitable, scientific, testing for public safety, literary, or educational purposes, or to foster national or international amateur sports competition (but only if no part of its activities involve the provision of athletic facilities or equipment), or for the prevention of cruelty to children or animals, no part of the net earnings of which inures to the benefit of any private shareholder or individual, no substantial part of the activities of which is carrying on propaganda, or otherwise attempting, to influence legislation (except as otherwise provided in subsection (h)), and which does not participate in, or intervene in (including the publishing or distributing of statements), any political campaign on behalf of (or in opposition to) any candidate for public office.")
pub relation section_501c3(o: Person, y: TaxableYear) kind institutional {
    label en official "an organization described in section 501(c)(3), for the taxable year";
}

// Two rules with the same head, one per lobbying regime, so the language's
// historical `or`-in-body restriction (core-surfaces.md) is not hit: an
// organization either has NOT made a valid (h) election (evaluative
// "substantial part" test governs) or HAS one (exact (h) expenditure test
// governs, via the Section501hExpenditureTestSatisfied bridge in the (h)
// block below).
@source(IRC_S501_C, quote = "Corporations, and any community chest, fund, or foundation, organized and operated exclusively for religious, charitable, scientific, testing for public safety, literary, or educational purposes, or to foster national or international amateur sports competition (but only if no part of its activities involve the provision of athletic facilities or equipment), or for the prevention of cruelty to children or animals, no part of the net earnings of which inures to the benefit of any private shareholder or individual, no substantial part of the activities of which is carrying on propaganda, or otherwise attempting, to influence legislation (except as otherwise provided in subsection (h)), and which does not participate in, or intervene in (including the publishing or distributing of statements), any political campaign on behalf of (or in opposition to) any candidate for public office.")
rule Section501c3ClassificationUnderSubstantialPartTest(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(3): organized and operated exclusively for an exempt purpose, no private inurement, no substantial legislative activity (substantial-part test, no (h) election in effect), and no political campaign intervention";
    when us.irc.core::year_of(o, y);
    when Section501c3OrganizedExclusively(o);
    when Section501c3OperatedExclusively(o);
    unless private_inurement_established(o, y);
    unless SubstantialLegislativeActivity(o, y);
    unless political_campaign_intervention_established(o, y);
    unless section_501h_election_in_effect(o, y);
    unless hospital_denied_501c3_by_501r(o, y);
    unless section_508_notice_requirement_unsatisfied_for_year(o, y);
    then section_501c3(o, y);
}
@source(IRC_S501_C, quote = "no substantial part of the activities of which is carrying on propaganda, or otherwise attempting, to influence legislation (except as otherwise provided in subsection (h))")
rule Section501c3ClassificationUnderHElection(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(3), read with the (h) election: the (h) expenditure test replaces the evaluative substantial-part test while the election is in effect";
    when section_501h_election_in_effect(o, y);
    when Section501c3OrganizedExclusively(o);
    when Section501c3OperatedExclusively(o);
    unless private_inurement_established(o, y);
    unless section_501h_expenditures_exceed_ceiling(o, y);
    unless political_campaign_intervention_established(o, y);
    unless hospital_denied_501c3_by_501r(o, y);
    unless section_508_notice_requirement_unsatisfied_for_year(o, y);
    then section_501c3(o, y);
}

// Prohibition: private inurement (bearer the organization itself — the
// organization's own conduct is the disposition of its net earnings).
// VIOLATED on an established act, no separate maintenance pair (E-0179).
@source(IRC_S501_C, quote = "no part of the net earnings of which inures to the benefit of any private shareholder or individual")
rule PrivateInurementProhibitionRule(o: Person, y: TaxableYear, start: Date, ending: Date) strict {
    label en official "section 501(c)(3): the organization is under a standing prohibition against private inurement of its net earnings, for every taxable year it claims the classification";
    when section_501c3(o, y);
    when us.irc.core::begins(y, start);
    when us.irc.core::ends(y, ending);
    then prohibition RefrainFromPrivateInurement {
        bearer o;
        action private_inurement_established(o, y);
        window [start, ending];
    };
}

// Prohibition: political campaign intervention. Same shape.
@source(IRC_S501_C, quote = "which does not participate in, or intervene in (including the publishing or distributing of statements), any political campaign on behalf of (or in opposition to) any candidate for public office")
rule PoliticalCampaignProhibitionRule(o: Person, y: TaxableYear, start: Date, ending: Date) strict {
    label en official "section 501(c)(3): the organization is under a standing prohibition against participating or intervening in a political campaign for or against a candidate for public office, for every taxable year it claims the classification";
    when section_501c3(o, y);
    when us.irc.core::begins(y, start);
    when us.irc.core::ends(y, ending);
    then prohibition RefrainFromPoliticalCampaignIntervention {
        bearer o;
        action political_campaign_intervention_established(o, y);
        window [start, ending];
    };
}

// ---------------------------------------------------------------------
// (h): the lobbying expenditure test election — a POWER (it changes the
// organization's legal regime from the evaluative substantial-part test to
// an exact-computation ceiling), not a liberty: the text's own words are
// "shall be denied ... but only if" tied to an election, per section
// 501(h)(1)-(2). The ceiling amounts and the section 4911(d) definitions
// are EXTERNAL_DEPENDENCY on `us.irc.excise-entities` (section 4911 owner);
// this package computes nothing of the ceiling itself, only the election's
// validity and effect on the classification above.
// ---------------------------------------------------------------------

@source(IRC_S501_H, quote = "In the case of an organization to which this subsection applies, exemption from taxation under subsection (a) shall be denied because a substantial part of the activities of such organization consists of carrying on propaganda, or otherwise attempting, to influence legislation, but only if such organization normally—")
pub relation section_501h_election_in_effect(o: Person, y: TaxableYear) kind institutional {
    label en official "an election under section 501(h) is in effect for the organization for the taxable year";
}
pub relation section_501h_election_made(o: Person, on: Date) kind empirical {
    label en official "the organization made the election referred to in section 501(h)";
}
pub relation section_501h_election_revoked(o: Person, on: Date) kind empirical {
    label en official "the organization revoked the election referred to in section 501(h)";
}

// EXTERNAL_DEPENDENCY: the lobbying/grass-roots ceiling amounts are a
// function of "exempt purpose expenditures" defined in section 4911(c),
// owned by `us.irc.excise-entities` (this package's assignment names the
// section 4911 limits explicitly as "a contract to excise-entities").
// `section_501h_expenditures_exceed_ceiling` is the bridge relation this
// package reads; it is NOT computed here.
pub relation section_501h_expenditures_exceed_ceiling(o: Person, y: TaxableYear) kind institutional {
    label en unofficial "the organization's lobbying expenditures exceed the lobbying ceiling amount, or its grass roots expenditures exceed the grass roots ceiling amount, for the taxable year (section 501(h)(1), section 4911 limits) — EXTERNAL_DEPENDENCY on us.irc.excise-entities";
}

@source(IRC_S501_H, quote = "In the case of an organization to which this subsection applies, exemption from taxation under subsection (a) shall be denied because a substantial part of the activities of such organization consists of carrying on propaganda, or otherwise attempting, to influence legislation, but only if such organization normally—")
rule Section501hElectionPower(o: Person, y: TaxableYear, start: Date) strict {
    label en official "section 501(h): an eligible organization may elect to have the expenditure test, rather than the evaluative substantial-part test, applied to its lobbying activity";
    when section_501c3(o, y);
    when us.irc.core::begins(y, start);
    then power Section501hElection {
        holder o;
        exercise section_501h_election_made(o, start);
        valid_when section_501h_election_eligible(o);
        effect section_501h_election_in_effect(o, y);
    };
}
pub relation section_501h_election_eligible(o: Person) kind institutional {
    label en unofficial "the organization is eligible to make the section 501(h) election (section 501(h)(2): not a church, an integrated auxiliary of a church, or a member of an affiliated group with such a member; not a disqualified organization under section 4911(f)(2)) — EXTERNAL_DEPENDENCY, this package classifies eligibility no further this stage";
}

// No `priority` needed between Section501c3ClassificationUnderHElection and
// Section501c3ClassificationUnderSubstantialPartTest: their guards on
// `section_501h_election_in_effect` are already mutually exclusive.

// ---------------------------------------------------------------------
// (c)(4): social welfare organizations — plain classification per the
// assignment's own scope ("only what the pinned text says"), including the
// (B) inurement condition added by later amendment.
// ---------------------------------------------------------------------

@source(IRC_S501_C, quote = "Civic leagues or organizations not organized for profit but operated exclusively for the promotion of social welfare, or local associations of employees, the membership of which is limited to the employees of a designated person or persons in a particular municipality, and the net earnings of which are devoted exclusively to charitable, educational, or recreational purposes.")
pub relation section_501c4(o: Person, y: TaxableYear) kind institutional {
    label en official "an organization described in section 501(c)(4), for the taxable year";
}
pub external judgment relation OperatedExclusivelyForSocialWelfare(o: Person, y: TaxableYear) {
    authority Secretary;
    label en official "the organization is operated exclusively for the promotion of social welfare (section 501(c)(4)(A)) — DECISION-0194 evaluative channel";
}
@source(IRC_S501_C, quote = "Subparagraph (A) shall not apply to an entity unless no part of the net earnings of such entity inures to the benefit of any private shareholder or individual.")
rule Section501c4Classification(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(4): a civic league or organization not organized for profit, operated exclusively for social welfare, no part of whose net earnings inures to a private shareholder or individual";
    when OperatedExclusivelyForSocialWelfare(o, y);
    when not_organized_for_profit(o);
    unless private_inurement_established(o, y);
    unless barred_from_501c4_for_year_504a(o, y);
    then section_501c4(o, y);
}
pub relation not_organized_for_profit(o: Person) kind empirical {
    label en official "the organization is not organized for profit (section 501(c)(4)(A))";
}
@source(IRC_S501_C, quote = "Civic leagues or organizations not organized for profit but operated exclusively for the promotion of social welfare, or local associations of employees, the membership of which is limited to the employees of a designated person or persons in a particular municipality, and the net earnings of which are devoted exclusively to charitable, educational, or recreational purposes.")
rule DescribedIn501cViaC4(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c): an organization described in section 501(c)(4) is described in subsection (c)";
    when section_501c4(o, y);
    then described_in_501c(o, y);
}
@source(IRC_S501_C, quote = "Corporations, and any community chest, fund, or foundation, organized and operated exclusively for religious, charitable, scientific, testing for public safety, literary, or educational purposes, or to foster national or international amateur sports competition (but only if no part of its activities involve the provision of athletic facilities or equipment), or for the prevention of cruelty to children or animals, no part of the net earnings of which inures to the benefit of any private shareholder or individual, no substantial part of the activities of which is carrying on propaganda, or otherwise attempting, to influence legislation (except as otherwise provided in subsection (h)), and which does not participate in, or intervene in (including the publishing or distributing of statements), any political campaign on behalf of (or in opposition to) any candidate for public office.")
rule DescribedIn501cViaC3(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c): an organization described in section 501(c)(3) is described in subsection (c)";
    when section_501c3(o, y);
    then described_in_501c(o, y);
}
