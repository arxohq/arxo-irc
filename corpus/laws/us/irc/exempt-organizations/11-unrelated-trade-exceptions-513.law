// Section 513(b) (special trust rule) and (d)-(j) (the named exceptions
// to "unrelated trade or business") — STAGE 2b (25.09.2026), closing
// TECH-GAPS G73.

// ---------------------------------------------------------------------
// (b): special rule for trusts.
// ---------------------------------------------------------------------

use self::{
    IRC_S513_B,
    IRC_S513_D,
    IRC_S513_E,
    IRC_S513_F,
    IRC_S513_G,
    IRC_S513_H,
    IRC_S513_I,
    IRC_S513_J,
    Person,
    TaxableYear,
    TradeOrBusiness,
    Trust,
    section_501q_requirements_met,
};

@source(IRC_S513_B, quote = "The term \"unrelated trade or business\" means, in the case of—\n(1) a trust computing its unrelated business taxable income under section 512 for purposes of section 681; or\n(2) a trust described in section 401(a), or section 501(c)(17), which is exempt from tax under section 501(a);\nany trade or business regularly carried on by such trust or by a partnership of which it is a member.")
pub relation unrelated_trade_or_business_trust_513b(t: Trust, tb: TradeOrBusiness, y: TaxableYear) kind institutional {
    label en official "section 513(b): for a trust within (1) or (2), 'unrelated trade or business' means any trade or business regularly carried on by the trust or a partnership of which it is a member";
}
pub relation trust_computing_ubti_for_681_513b1(t: Trust) kind empirical {
    label en official "the trust computes its UBTI under section 512 for purposes of section 681 (section 513(b)(1))";
}
pub relation trust_401a_or_501c17_exempt_513b2(t: Trust) kind empirical {
    label en official "the trust is described in section 401(a) or section 501(c)(17) and exempt from tax under section 501(a) (section 513(b)(2))";
}
pub relation regularly_carried_on_by_trust_or_its_partnership(t: Trust, tb: TradeOrBusiness, y: TaxableYear) kind empirical {
    label en official "the trade or business is regularly carried on by the trust or by a partnership of which the trust is a member (section 513(b))";
}
rule UnrelatedTradeOrBusinessTrust513bVia1(t: Trust, tb: TradeOrBusiness, y: TaxableYear) defeasible {
    label en official "section 513(b)(1)";
    when trust_computing_ubti_for_681_513b1(t);
    when regularly_carried_on_by_trust_or_its_partnership(t, tb, y);
    then unrelated_trade_or_business_trust_513b(t, tb, y);
}
rule UnrelatedTradeOrBusinessTrust513bVia2(t: Trust, tb: TradeOrBusiness, y: TaxableYear) defeasible {
    label en official "section 513(b)(2)";
    when trust_401a_or_501c17_exempt_513b2(t);
    when regularly_carried_on_by_trust_or_its_partnership(t, tb, y);
    then unrelated_trade_or_business_trust_513b(t, tb, y);
}

// ---------------------------------------------------------------------
// (d): qualified public entertainment / convention and trade show
// activities.
// ---------------------------------------------------------------------

@source(IRC_S513_D, quote = "The term \"unrelated trade or business\" does not include qualified public entertainment activities of an organization described in paragraph (2)(C), or qualified convention and trade show activities of an organization described in paragraph (3)(C).")
pub relation not_unrelated_trade_qualified_public_entertainment_513d(o: Person, tb: TradeOrBusiness, y: TaxableYear) kind institutional {
    label en official "section 513(d)(1): a qualified public entertainment activity of a qualifying (c)(3)/(4)/(5) organization is not an unrelated trade or business";
}
pub relation qualified_public_entertainment_activity_513d2(tb: TradeOrBusiness) kind empirical {
    label en official "the activity is a qualified public entertainment activity conducted in conjunction with a fair/exposition, under permitting State law, or under a limited (<=20-day) State license (section 513(d)(2)(B)(i)-(iii))";
}
pub relation qualifying_organization_fair_or_exposition_513d2C(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization is described in section 501(c)(3), (4), or (5) and regularly conducts an agricultural/educational fair or exposition as one of its substantial exempt purposes (section 513(d)(2)(C))";
}
rule NotUnrelatedTradePublicEntertainment513d(o: Person, tb: TradeOrBusiness, y: TaxableYear) defeasible {
    label en official "section 513(d)(1): qualified public entertainment activity exception";
    when qualified_public_entertainment_activity_513d2(tb);
    when qualifying_organization_fair_or_exposition_513d2C(o, y);
    then not_unrelated_trade_qualified_public_entertainment_513d(o, tb, y);
}
@source(IRC_S513_D, quote = "The term \"unrelated trade or business\" does not include qualified public entertainment activities of an organization described in paragraph (2)(C), or qualified convention and trade show activities of an organization described in paragraph (3)(C).")
pub relation not_unrelated_trade_convention_trade_show_513d(o: Person, tb: TradeOrBusiness, y: TaxableYear) kind institutional {
    label en official "section 513(d)(1): a qualified convention and trade show activity of a qualifying (c)(3)/(4)/(5)/(6) organization is not an unrelated trade or business";
}
pub relation qualified_convention_and_trade_show_activity_513d3(tb: TradeOrBusiness) kind empirical {
    label en official "the activity is a qualified convention and trade show activity carried out in conjunction with a described convention/meeting/show for the purpose of promoting/educating about the industry's products (section 513(d)(3)(B))";
}
pub relation qualifying_organization_industry_show_513d3C(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization is described in section 501(c)(3), (4), (5), or (6) and regularly conducts an industry-stimulating/educating show as one of its substantial exempt purposes (section 513(d)(3)(C))";
}
rule NotUnrelatedTradeConventionTradeShow513d(o: Person, tb: TradeOrBusiness, y: TaxableYear) defeasible {
    label en official "section 513(d)(1): qualified convention and trade show activity exception";
    when qualified_convention_and_trade_show_activity_513d3(tb);
    when qualifying_organization_industry_show_513d3C(o, y);
    then not_unrelated_trade_convention_trade_show_513d(o, tb, y);
}
@source(IRC_S513_D, quote = "An organization described in section 501(c) (3), (4), or (5) shall not be considered as not entitled to the exemption allowed under section 501(a) solely because of qualified public entertainment activities conducted by it.")
pub relation qualified_public_entertainment_does_not_endanger_exemption_513d4(o: Person, y: TaxableYear) kind institutional {
    label en official "section 513(d)(4): conducting a qualified public entertainment activity does not, by itself, disqualify a section 501(c)(3)/(4)/(5) organization from exemption";
}
rule QualifiedPublicEntertainmentDoesNotEndangerExemption513d4(o: Person, tb: TradeOrBusiness, y: TaxableYear) defeasible {
    label en official "section 513(d)(4)";
    when not_unrelated_trade_qualified_public_entertainment_513d(o, tb, y);
    then qualified_public_entertainment_does_not_endanger_exemption_513d4(o, y);
}

// ---------------------------------------------------------------------
// (e): certain hospital services (small-hospital cost-sharing).
// ---------------------------------------------------------------------

@source(IRC_S513_E, quote = "In the case of a hospital described in section 170(b)(1)(A)(iii), the term \"unrelated trade or business\" does not include the furnishing of one or more of the services described in section 501(e)(1)(A) to one or more hospitals described in section 170(b)(1)(A)(iii) if—\n(1) such services are furnished solely to such hospitals which have facilities to serve not more than 100 inpatients;")
pub relation not_unrelated_trade_hospital_services_513e(hospital: Person, recipient_hospital: Person, y: TaxableYear) kind institutional {
    label en official "section 513(e): a section 170(b)(1)(A)(iii) hospital furnishing section 501(e)(1)(A) services to another such hospital (<=100 inpatient capacity), at cost, is not conducting an unrelated trade or business";
}
pub relation hospital_170b1Aiii(o: Person) kind empirical {
    label en official "the organization is a hospital described in section 170(b)(1)(A)(iii) (section 513(e))";
}
pub relation recipient_hospital_at_most_100_inpatients_513e1(recipient: Person) kind empirical {
    label en official "the recipient hospital has facilities to serve not more than 100 inpatients (section 513(e)(1))";
}
pub relation service_would_further_recipients_own_exempt_purpose_513e2(recipient: Person) kind empirical {
    label en official "the service, if performed by the recipient hospital on its own behalf, would further the recipient's own exempt purpose (section 513(e)(2))";
}
pub relation fee_does_not_exceed_actual_cost_513e3(hospital: Person, recipient_hospital: Person, y: TaxableYear) kind empirical {
    label en official "the fee for the service does not exceed the actual cost of providing it, including straight-line depreciation and a reasonable return on capital (section 513(e)(3))";
}
rule NotUnrelatedTradeHospitalServices513e(hospital: Person, recipient_hospital: Person, y: TaxableYear) defeasible {
    label en official "section 513(e): the three-condition small-hospital shared-services exception";
    when hospital_170b1Aiii(hospital);
    when hospital_170b1Aiii(recipient_hospital);
    when recipient_hospital_at_most_100_inpatients_513e1(recipient_hospital);
    when service_would_further_recipients_own_exempt_purpose_513e2(recipient_hospital);
    when fee_does_not_exceed_actual_cost_513e3(hospital, recipient_hospital, y);
    then not_unrelated_trade_hospital_services_513e(hospital, recipient_hospital, y);
}

// ---------------------------------------------------------------------
// (f): certain bingo games.
// ---------------------------------------------------------------------

@source(IRC_S513_F, quote = "The term \"unrelated trade or business\" does not include any trade or business which consists of conducting bingo games.")
pub relation not_unrelated_trade_bingo_513f(o: Person, tb: TradeOrBusiness, y: TaxableYear) kind institutional {
    label en official "section 513(f)(1): conducting a qualifying bingo game is not an unrelated trade or business";
}
pub relation qualifying_bingo_game_513f2(o: Person, tb: TradeOrBusiness, y: TaxableYear) kind empirical {
    label en official "the game meets the section 513(f)(2) bingo-game definition: wagers/winners/prize-distribution occur in the presence of all players (A), not ordinarily conducted on a commercial basis (B), and does not violate State/local law (C)";
}
rule NotUnrelatedTradeBingo513f(o: Person, tb: TradeOrBusiness, y: TaxableYear) defeasible {
    label en official "section 513(f)(1): the bingo exception";
    when qualifying_bingo_game_513f2(o, tb, y);
    then not_unrelated_trade_bingo_513f(o, tb, y);
}

// ---------------------------------------------------------------------
// (g): certain pole rentals (mutual/cooperative telephone or electric).
// ---------------------------------------------------------------------

@source(IRC_S513_G, quote = "In the case of a mutual or cooperative telephone or electric company, the term \"unrelated trade or business\" does not include engaging in qualified pole rentals (as defined in section 501(c)(12)(D)).")
pub relation not_unrelated_trade_pole_rentals_513g(o: Person, y: TaxableYear) kind institutional {
    label en official "section 513(g): qualified pole rentals by a mutual or cooperative telephone or electric company are not an unrelated trade or business";
}
pub relation mutual_or_cooperative_telephone_or_electric_company_513g(o: Person) kind empirical {
    label en official "the organization is a mutual or cooperative telephone or electric company (section 513(g))";
}
pub relation engages_in_qualified_pole_rentals_501c12D(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization engages in qualified pole rentals as defined in section 501(c)(12)(D) (section 513(g)) — the (D) definition is not independently decomposed this stage";
}
rule NotUnrelatedTradePoleRentals513g(o: Person, y: TaxableYear) defeasible {
    label en official "section 513(g): the pole-rental exception";
    when mutual_or_cooperative_telephone_or_electric_company_513g(o);
    when engages_in_qualified_pole_rentals_501c12D(o, y);
    then not_unrelated_trade_pole_rentals_513g(o, y);
}

// ---------------------------------------------------------------------
// (h): low-cost-article distributions and donor-list exchanges/rentals.
// The (2)(C) COLA indexation of the $5 figure is a SOURCE_GAP (no Rev.
// Proc. dataset pinned) — the statutory $5 base is used, never invented.
// ---------------------------------------------------------------------

@source(IRC_S513_H, quote = "In the case of an organization which is described in section 501 and contributions to which are deductible under paragraph (2) or (3) of section 170(c), the term \"unrelated trade or business\" does not include—\n(A) activities relating to the distribution of low cost articles if the distribution of such articles is incidental to the solicitation of charitable contributions, or")
pub relation not_unrelated_trade_low_cost_articles_513h(o: Person, y: TaxableYear) kind institutional {
    label en official "section 513(h)(1)(A): distributing low-cost articles incidental to a charitable-contribution solicitation is not an unrelated trade or business, for a section 501 organization whose contributions are deductible under section 170(c)(2)/(3)";
}
pub relation organization_170c2_or_3_deductible_513h(o: Person, y: TaxableYear) kind empirical {
    label en official "contributions to the organization are deductible under section 170(c)(2) or (3) (section 513(h)(1))";
}
@source(IRC_S513_H, quote = "The term \"low cost article\" means any article which has a cost not in excess of $5 to the organization which distributes such item (or on whose behalf such item is distributed).")
pub relation article_cost_513h2(o: Person, article_cost: Money) kind empirical {
    label en official "the cost of the article to the distributing organization, for the section 513(h)(2)(A) $5 low-cost-article test — the (C) annual COLA indexation of the $5 base is a SOURCE_GAP (no Rev. Proc. dataset pinned); the statutory $5 base is used";
}
pub relation distribution_incidental_to_solicitation_513h3(o: Person) kind empirical {
    label en official "the distribution meets all three section 513(h)(3)(A)-(C) incidental-to-solicitation conditions (not requested, not consented to, accompanied by a contribution request and retention statement)";
}
rule NotUnrelatedTradeLowCostArticles513h(o: Person, y: TaxableYear, article_cost: Money) defeasible {
    label en official "section 513(h)(1)(A): the $5 exact ceiling (no rounding — the SOURCE_GAP COLA adjustment is not applied) plus the incidental-to-solicitation conditions";
    when organization_170c2_or_3_deductible_513h(o, y);
    when article_cost_513h2(o, article_cost);
    when article_cost <= 5.00 USD;
    when distribution_incidental_to_solicitation_513h3(o);
    then not_unrelated_trade_low_cost_articles_513h(o, y);
}
@source(IRC_S513_H, quote = "any trade or business which consists of—\n(i) exchanging with another such organization names and addresses of donors to (or members of) such organization, or\n(ii) renting such names and addresses to another such organization.")
pub relation not_unrelated_trade_donor_list_exchange_or_rental_513h(o: Person, y: TaxableYear) kind institutional {
    label en official "section 513(h)(1)(B): exchanging or renting donor/member names and addresses with another section 170(c)(2)/(3) organization is not an unrelated trade or business";
}
pub relation exchanges_or_rents_donor_list_with_another_170c_org_513h1B(o: Person, other: Person) kind empirical {
    label en official "the organization exchanges or rents donor/member names and addresses with another organization described in section 513(h)(1) (section 513(h)(1)(B))";
}
rule NotUnrelatedTradeDonorListExchange513h(o: Person, other: Person, y: TaxableYear) defeasible {
    label en official "section 513(h)(1)(B): donor-list exchange/rental exception";
    when organization_170c2_or_3_deductible_513h(o, y);
    when organization_170c2_or_3_deductible_513h(other, y);
    when exchanges_or_rents_donor_list_with_another_170c_org_513h1B(o, other);
    then not_unrelated_trade_donor_list_exchange_or_rental_513h(o, y);
}

// ---------------------------------------------------------------------
// (i): qualified sponsorship payments, with the substantial-return-
// benefit definition.
// ---------------------------------------------------------------------

@source(IRC_S513_I, quote = "The term \"unrelated trade or business\" does not include the activity of soliciting and receiving qualified sponsorship payments.")
pub relation not_unrelated_trade_sponsorship_513i(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 513(i)(1): soliciting and receiving qualified sponsorship payments is not an unrelated trade or business";
}
@source(IRC_S513_I, quote = "The term \"qualified sponsorship payment\" means any payment made by any person engaged in a trade or business with respect to which there is no arrangement or expectation that such person will receive any substantial return benefit other than the use or acknowledgement of the name or logo (or product lines) of such person's trade or business in connection with the activities of the organization that receives such payment.")
pub relation qualified_sponsorship_payment_513i2A(o: Person, payor: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 513(i)(2)(A): a payment with no arrangement or expectation of a substantial return benefit beyond mere use/acknowledgement of the payor's name, logo, or product lines";
}
pub relation payment_by_trade_or_business_payor_513i2A(o: Person, payor: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "a payment made by a person engaged in a trade or business, for section 513(i)(2)(A)";
}
pub relation substantial_return_benefit_beyond_acknowledgement(o: Person, payor: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "there is an arrangement or expectation that the payor will receive a SUBSTANTIAL RETURN BENEFIT beyond mere use/acknowledgement of its name, logo, or product lines — including advertising with qualitative/comparative language, price information, an endorsement, or an inducement to purchase (section 513(i)(2)(A), the definitional exclusion for 'advertising')";
}
pub relation payment_contingent_on_attendance_or_exposure_513i2Bi(o: Person, payor: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the payment amount is contingent on the level of attendance, broadcast ratings, or other public-exposure factors (section 513(i)(2)(B)(i)) — a disqualifying condition";
}
pub relation payment_for_periodical_or_trade_show_513i2Bii(o: Person, payor: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the payment is for acknowledgement in a regularly scheduled, non-event-specific periodical, or is made in connection with a qualified convention or trade show activity (section 513(i)(2)(B)(ii)) — a disqualifying condition";
}
rule QualifiedSponsorshipPayment513i2A(o: Person, payor: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 513(i)(2)(A)-(B): a qualified sponsorship payment, with no substantial return benefit and none of the two disqualifying conditions";
    when payment_by_trade_or_business_payor_513i2A(o, payor, y, amount);
    unless substantial_return_benefit_beyond_acknowledgement(o, payor, y, amount);
    unless payment_contingent_on_attendance_or_exposure_513i2Bi(o, payor, y, amount);
    unless payment_for_periodical_or_trade_show_513i2Bii(o, payor, y, amount);
    then qualified_sponsorship_payment_513i2A(o, payor, y, amount);
}
rule NotUnrelatedTradeSponsorship513i(o: Person, payor: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 513(i)(1): soliciting and receiving the qualified sponsorship payment";
    when qualified_sponsorship_payment_513i2A(o, payor, y, amount);
    then not_unrelated_trade_sponsorship_513i(o, y, amount);
}

// ---------------------------------------------------------------------
// (j): debt management plan services — an INCLUSION, not an exception.
// ---------------------------------------------------------------------

@source(IRC_S513_J, quote = "The term \"unrelated trade or business\" includes the provision of debt management plan services (as defined in section 501(q)(4)(B)) by any organization other than an organization which meets the requirements of section 501(q).")
pub relation unrelated_trade_debt_management_services_513j(o: Person, y: TaxableYear) kind institutional {
    label en official "section 513(j): providing debt management plan services IS an unrelated trade or business, unless the organization meets section 501(q)";
}
pub relation provides_debt_management_plan_services_501q4B(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization provides debt management plan services as defined in section 501(q)(4)(B) (section 513(j))";
}
rule UnrelatedTradeDebtManagementServices513j(o: Person, y: TaxableYear) defeasible {
    label en official "section 513(j): debt management plan services are an unrelated trade or business unless section 501(q) is met";
    when provides_debt_management_plan_services_501q4B(o, y);
    unless section_501q_requirements_met(o, y);
    then unrelated_trade_debt_management_services_513j(o, y);
}
