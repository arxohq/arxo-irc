// Section 501(c)(1),(2),(5)-(29): the remaining exemption categories not
// modelled in module 01 (which covers (a), (b), (c)(3), (c)(4), (h)).
// STAGE 2 (IRC-09 stage 2, A11), per the task's priority order:
// "(c)(4)-(7),(12),(15)" flagship exact tests, the rest "as pinned".
//
// METHOD: each paragraph's TOP-LEVEL statutory condition is modelled as a
// `classification` rule bridging into `described_in_501c` (module 01's
// master switch feeding section 501(a)). Percentage/dollar tests the text
// states EXACTLY ((c)(12)(A) 85%, (c)(15)(A) $600,000/$150,000 and 50%/35%,
// (c)(19)(B) 75%, (c)(23) 75%, (c)(25)(A)(i) 35 shareholders) are modelled
// as EXACT cross-multiplication comparisons (no division), matching
// `05-private-foundation-509.law`'s section 509(a)(2) convention. Deeply
// nested sub-paragraph detail — (c)(12)(B)-(J) telephone/electric carve-
// outs, (c)(17)(B)-(E)/(c)(18)(D) SUB/pension-plan sub-rules, (c)(21)(B)-
// (D)/(c)(22)(B)-(D) Black Lung/multiemployer trust asset-use detail,
// (c)(25)(D)-(G) title-holding-company governance/de-minimis-income rules,
// (c)(26)(A)-(D)'s and (c)(27)(A)-(B)'s further sub-items beyond the
// conditions modelled below — is NOT decomposed this stage: TECH-GAPS row
// G485 (breadth-over-depth judgment call for stage 2, recorded per-row in
// coverage/exempt-organizations.json, never silently folded into
// `non_normative`). "Evaluative" content genuinely thin enough to be a
// case-asserted fact (parallel to module 01's `not_organized_for_profit`)
// stays `empirical`; content the statute itself commits to Secretary
// discretion (the (c)(17)/(18) nondiscrimination findings) is an
// `external judgment relation` (DECISION-0194).
//
// `described_in_501c1` in `06-ubit-511-512-513-514.law` is a DIFFERENT,
// narrower relation (a case-asserted switch used only for the section
// 511(a)(2)(A) exclusion) from `section_501c1` below (the full section
// 501(c)(1) classification feeding section 501(a) itself) — kept separate
// deliberately: the former's `kind empirical` cannot be a rule head, and
// unifying them is not this stage's write scope for module 06. Documented
// as a judgment call, not an oversight.

// ---------------------------------------------------------------------
// (c)(1): federal instrumentalities.
// ---------------------------------------------------------------------

use self::{
    IRC_S501_C,
    IRC_S506_A,
    IRC_S506_C,
    IRC_S506_D,
    IRC_S506_F,
    Person,
    Secretary,
    SubstantialLegislativeActivity,
    TaxableYear,
    described_in_501c,
    has_controlled_group_members_501c15B,
    mutual_clause_ii_disapplied_501c15A,
    not_organized_for_profit,
    political_campaign_intervention_established,
    private_inurement_established,
    section_501c3,
    section_501c4,
};

@source(IRC_S501_C, quote = "Any corporation organized under Act of Congress which is an instrumentality of the United States but only if such corporation—")
pub relation section_501c1(o: Person, y: TaxableYear) kind institutional {
    label en official "an organization described in section 501(c)(1): a corporation organized under an Act of Congress that is an instrumentality of the United States, exempt from federal income taxes under that Act or under this title without regard to any non-title provision";
}
pub relation organized_under_act_of_congress(o: Person) kind empirical {
    label en official "the corporation is organized under an Act of Congress (section 501(c)(1))";
}
pub relation instrumentality_of_united_states(o: Person) kind empirical {
    label en official "the corporation is an instrumentality of the United States (section 501(c)(1))";
}
@source(IRC_S501_C, quote = "is exempt from Federal income taxes—\n(i) under such Act as amended and supplemented before July 18, 1984, or\n(ii) under this title without regard to any provision of law which is not contained in this title and which is not contained in a revenue Act, or")
pub relation exempt_from_federal_income_taxes_under_own_act_or_title(o: Person, y: TaxableYear) kind empirical {
    label en official "the corporation is exempt from federal income taxes under its own organizing Act (as amended before July 18, 1984) or under this title without regard to any non-title, non-revenue-Act provision (section 501(c)(1)(A))";
}
rule Section501c1Classification(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(1): a corporation organized under an Act of Congress, an instrumentality of the United States, exempt from federal income taxes under (A)";
    when organized_under_act_of_congress(o);
    when instrumentality_of_united_states(o);
    when exempt_from_federal_income_taxes_under_own_act_or_title(o, y);
    then section_501c1(o, y);
}
rule DescribedIn501cViaC1(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c): an organization described in section 501(c)(1) is described in subsection (c)";
    when section_501c1(o, y);
    then described_in_501c(o, y);
}

// ---------------------------------------------------------------------
// (c)(2): title-holding corporations for a single exempt parent.
// ---------------------------------------------------------------------

@source(IRC_S501_C, quote = "Corporations organized for the exclusive purpose of holding title to property, collecting income therefrom, and turning over the entire amount thereof, less expenses, to an organization which itself is exempt under this section.")
pub relation section_501c2(o: Person, y: TaxableYear) kind institutional {
    label en official "an organization described in section 501(c)(2): a corporation organized exclusively to hold title to property, collect income, and remit the entire net amount to a section 501(a)-exempt organization";
}
pub relation organized_exclusively_for_title_holding(o: Person) kind empirical {
    label en official "the corporation is organized for the exclusive purpose of holding title to property, collecting income therefrom, and turning over the entire net amount to a beneficiary (section 501(c)(2))";
}
pub relation remits_entire_net_income_to_exempt_beneficiary(o: Person, beneficiary: Person, y: TaxableYear) kind empirical {
    label en official "the corporation turns over the entire amount of the income from the property, less expenses, to a beneficiary organization that is ITSELF exempt under this section, section 501(a) (section 501(c)(2)) — the beneficiary's own section 501(a) exemption is asserted as part of this fact rather than re-derived via `exempt_organization`, to avoid an `exempt_organization` <-> `described_in_501c` predicate-level cycle (LDC-E4102) across the two distinct entities; documented as a judgment call, not an oversight";
}
rule Section501c2Classification(o: Person, beneficiary: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(2): title-holding corporation for a single exempt-organization beneficiary";
    when organized_exclusively_for_title_holding(o);
    when remits_entire_net_income_to_exempt_beneficiary(o, beneficiary, y);
    then section_501c2(o, y);
}
rule DescribedIn501cViaC2(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c): an organization described in section 501(c)(2) is described in subsection (c)";
    when section_501c2(o, y);
    then described_in_501c(o, y);
}

// ---------------------------------------------------------------------
// (c)(4)(B): the PL 114-113 §506 notice contract, bridged onto module 01's
// existing section 501(c)(4)(B) inurement classification.
// ---------------------------------------------------------------------

// NOTE: the pinned 2024-Edition text of section 506 is the SHORT,
// current-law version (Pub. L. 114-113 §405, as it stands after later
// housekeeping) — (a) notice, (b) contents of notice, (c) acknowledgment,
// (d) extension for reasonable cause, (e) user fee, (f) request for
// determination. It carries NO "existing organization" grandfather clause
// on its face (an earlier drafting round of this module assumed the
// original 2015 enactment's transition text, which is not part of the
// pinned fragment — corrected here).

@source(IRC_S506_A, quote = "An organization described in section 501(c)(4) shall, not later than 60 days after the organization is established, notify the Secretary (in such manner as the Secretary shall by regulation prescribe) that it is operating as such.")
pub relation section_506a_notice_required(o: Person, y: TaxableYear) kind institutional {
    label en official "section 506(a): a section 501(c)(4) organization must notify the Secretary that it is operating as such, not later than 60 days after it is established";
}
rule Section506aNoticeRequiredFromC4(o: Person, y: TaxableYear) defeasible {
    label en official "section 506(a) applies once the organization is classified under section 501(c)(4)";
    when section_501c4(o, y);
    then section_506a_notice_required(o, y);
}
pub relation section_506a_notice_filed(o: Person, filed_on: Date) kind empirical {
    label en official "the organization filed the section 506(a) notification with the Secretary on this date";
}
pub relation section_501c4_established_on(o: Person, established_on: Date) kind empirical {
    label en unofficial "the date the section 501(c)(4) organization was established, for the section 506(a) 60-day notice window";
}
@source(IRC_S506_C, quote = "Not later than 60 days after receipt of such a notice, the Secretary shall send to the organization an acknowledgment of such receipt.")
pub relation section_506c_acknowledgement_sent(o: Person) kind institutional {
    label en official "section 506(c): not later than 60 days after receiving the section 506(a) notice, the Secretary sends the organization an acknowledgment of receipt";
}
rule Section506cAcknowledgement(o: Person, filed_on: Date) defeasible {
    label en official "section 506(c): the Secretary acknowledges a filed section 506(a) notification";
    when section_506a_notice_filed(o, filed_on);
    then section_506c_acknowledgement_sent(o);
}
@source(IRC_S506_D, quote = "The Secretary may, for reasonable cause, extend the 60-day period described in subsection (a).")
pub relation section_506d_extension_for_reasonable_cause(o: Person, extended_deadline: Date) kind institutional {
    label en official "section 506(d): the Secretary may, for reasonable cause, extend the section 506(a) 60-day notice period to this date";
}
pub relation section_506d_reasonable_cause_established(o: Person, extended_deadline: Date) kind empirical {
    label en official "reasonable cause for extending the section 506(a) 60-day period is established (section 506(d)) — DECISION-0194 evaluative content thin enough to leave as a case-asserted fact, parallel to `not_organized_for_profit`";
}
rule Section506dExtension(o: Person, extended_deadline: Date) defeasible {
    label en official "section 506(d): the Secretary extends the 60-day notice period for reasonable cause";
    when section_506d_reasonable_cause_established(o, extended_deadline);
    then section_506d_extension_for_reasonable_cause(o, extended_deadline);
}
@source(IRC_S506_F, quote = "Upon request by an organization to be treated as an organization described in section 501(c)(4), the Secretary may issue a determination with respect to such treatment.")
pub relation section_506f_determination_requested(o: Person) kind empirical {
    label en official "the organization has requested a Secretary determination that it be treated as a section 501(c)(4) organization (section 506(f))";
}
pub relation section_506f_determination_issued(o: Person) kind institutional {
    label en official "section 506(f): the Secretary may issue a determination on the organization's requested section 501(c)(4) treatment";
}
rule Section506fDeterminationPower(o: Person) strict {
    label en official "section 506(f): the Secretary's power to issue a section 501(c)(4) treatment determination on request";
    when section_506f_determination_requested(o);
    then power Section506fDetermination {
        holder Secretary;
        exercise section_506f_determination_issued(o);
        valid_when section_506f_determination_requested(o);
        effect section_506f_determination_issued(o);
    };
}

// ---------------------------------------------------------------------
// (c)(5): labor, agricultural, or horticultural organizations.
// ---------------------------------------------------------------------

@source(IRC_S501_C, quote = "Labor, agricultural, or horticultural organizations.")
pub relation section_501c5(o: Person, y: TaxableYear) kind institutional {
    label en official "an organization described in section 501(c)(5): a labor, agricultural, or horticultural organization";
}
pub relation labor_agricultural_or_horticultural_organization(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization is a labor, agricultural, or horticultural organization (section 501(c)(5))";
}
rule Section501c5Classification(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(5): labor, agricultural, or horticultural organizations";
    when labor_agricultural_or_horticultural_organization(o, y);
    then section_501c5(o, y);
}
rule DescribedIn501cViaC5(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c): an organization described in section 501(c)(5) is described in subsection (c)";
    when section_501c5(o, y);
    then described_in_501c(o, y);
}

// ---------------------------------------------------------------------
// (c)(6): business leagues, chambers of commerce, boards of trade,
// professional football leagues.
// ---------------------------------------------------------------------

@source(IRC_S501_C, quote = "Business leagues, chambers of commerce, real-estate boards, boards of trade, or professional football leagues (whether or not administering a pension fund for football players), not organized for profit and no part of the net earnings of which inures to the benefit of any private shareholder or individual.")
pub relation section_501c6(o: Person, y: TaxableYear) kind institutional {
    label en official "an organization described in section 501(c)(6): a business league, chamber of commerce, real-estate board, board of trade, or professional football league, not organized for profit and with no private inurement";
}
pub relation business_league_or_equivalent(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization is a business league, chamber of commerce, real-estate board, board of trade, or professional football league (whether or not administering a pension fund for football players) — section 501(c)(6)";
}
rule Section501c6Classification(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(6): a business league or equivalent, not organized for profit, no part of whose net earnings inures to a private shareholder or individual";
    when business_league_or_equivalent(o, y);
    when not_organized_for_profit(o);
    unless private_inurement_established(o, y);
    then section_501c6(o, y);
}
rule DescribedIn501cViaC6(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c): an organization described in section 501(c)(6) is described in subsection (c)";
    when section_501c6(o, y);
    then described_in_501c(o, y);
}

// ---------------------------------------------------------------------
// (c)(7): social clubs.
// ---------------------------------------------------------------------

@source(IRC_S501_C, quote = "Clubs organized for pleasure, recreation, and other nonprofitable purposes, substantially all of the activities of which are for such purposes and no part of the net earnings of which inures to the benefit of any private shareholder.")
pub relation section_501c7(o: Person, y: TaxableYear) kind institutional {
    label en official "an organization described in section 501(c)(7): a social club organized for pleasure, recreation and other nonprofitable purposes, substantially all of whose activities are for such purposes, with no private inurement";
}
pub relation organized_for_pleasure_recreation_nonprofitable_purposes(o: Person) kind empirical {
    label en official "the club is organized for pleasure, recreation, and other nonprofitable purposes (section 501(c)(7))";
}
pub external judgment relation SubstantiallyAllActivitiesForClubPurposes(o: Person, y: TaxableYear) {
    authority Secretary;
    label en official "substantially all of the club's activities are for pleasure, recreation, and other nonprofitable purposes (section 501(c)(7)) — DECISION-0194 evaluative channel";
}
rule Section501c7Classification(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(7): a social club, substantially all of whose activities are nonprofitable, with no private inurement";
    when organized_for_pleasure_recreation_nonprofitable_purposes(o);
    when SubstantiallyAllActivitiesForClubPurposes(o, y);
    unless private_inurement_established(o, y);
    then section_501c7(o, y);
}
rule DescribedIn501cViaC7(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c): an organization described in section 501(c)(7) is described in subsection (c)";
    when section_501c7(o, y);
    then described_in_501c(o, y);
}

// ---------------------------------------------------------------------
// (c)(8): fraternal beneficiary societies operating under the lodge system.
// ---------------------------------------------------------------------

@source(IRC_S501_C, quote = "Fraternal beneficiary societies, orders, or associations—\n(A) operating under the lodge system or for the exclusive benefit of the members of a fraternity itself operating under the lodge system, and\n(B) providing for the payment of life, sick, accident, or other benefits to the members of such society, order, or association or their dependents.")
pub relation section_501c8(o: Person, y: TaxableYear) kind institutional {
    label en official "an organization described in section 501(c)(8): a fraternal beneficiary society operating under the lodge system (or for the exclusive benefit of members of a lodge-system fraternity) that provides for payment of benefits to members or their dependents";
}
pub relation operates_under_lodge_system_or_for_lodge_fraternity(o: Person, y: TaxableYear) kind empirical {
    label en official "the society operates under the lodge system, or for the exclusive benefit of members of a fraternity itself operating under the lodge system (section 501(c)(8)(A))";
}
pub relation provides_life_sick_accident_or_other_benefits_to_members(o: Person) kind empirical {
    label en official "the society provides for the payment of life, sick, accident, or other benefits to its members or their dependents (section 501(c)(8)(B))";
}
rule Section501c8Classification(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(8): a lodge-system fraternal beneficiary society providing member/dependent benefits";
    when operates_under_lodge_system_or_for_lodge_fraternity(o, y);
    when provides_life_sick_accident_or_other_benefits_to_members(o);
    then section_501c8(o, y);
}
rule DescribedIn501cViaC8(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c): an organization described in section 501(c)(8) is described in subsection (c)";
    when section_501c8(o, y);
    then described_in_501c(o, y);
}

// ---------------------------------------------------------------------
// (c)(9): voluntary employees' beneficiary associations (VEBAs). Also see
// `05-veba-505.law` for the section 505 nondiscrimination/notice contract.
// ---------------------------------------------------------------------

@source(IRC_S501_C, quote = "Voluntary employees' beneficiary associations providing for the payment of life, sick, accident, or other benefits to the members of such association or their dependents or designated beneficiaries, if no part of the net earnings of such association inures (other than through such payments) to the benefit of any private shareholder or individual.")
pub relation section_501c9(o: Person, y: TaxableYear) kind institutional {
    label en official "an organization described in section 501(c)(9): a voluntary employees' beneficiary association providing member/dependent/designated-beneficiary benefits, with no non-payment private inurement";
}
pub relation voluntary_employees_beneficiary_association(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization is a voluntary employees' beneficiary association providing for the payment of life, sick, accident, or other benefits to members, dependents, or designated beneficiaries (section 501(c)(9))";
}
pub relation veba_inurement_other_than_through_benefit_payments(o: Person, y: TaxableYear) kind empirical {
    label en official "a part of the association's net earnings inures to a private shareholder or individual OTHER than through the benefit payments themselves (section 501(c)(9)) — the payments-carve-in means ordinary benefit payments are never inurement for this test";
}
rule Section501c9Classification(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(9): a VEBA, with no inurement other than through the benefit payments themselves";
    when voluntary_employees_beneficiary_association(o, y);
    unless veba_inurement_other_than_through_benefit_payments(o, y);
    then section_501c9(o, y);
}
rule DescribedIn501cViaC9(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c): an organization described in section 501(c)(9) is described in subsection (c)";
    when section_501c9(o, y);
    then described_in_501c(o, y);
}

// ---------------------------------------------------------------------
// (c)(10): domestic fraternal societies (no benefit payments).
// ---------------------------------------------------------------------

@source(IRC_S501_C, quote = "Domestic fraternal societies, orders, or associations, operating under the lodge system—\n(A) the net earnings of which are devoted exclusively to religious, charitable, scientific, literary, educational, and fraternal purposes, and\n(B) which do not provide for the payment of life, sick, accident, or other benefits.")
pub relation section_501c10(o: Person, y: TaxableYear) kind institutional {
    label en official "an organization described in section 501(c)(10): a domestic lodge-system fraternal society whose net earnings are devoted exclusively to the listed purposes and which pays no life/sick/accident/other benefits";
}
pub external judgment relation NetEarningsDevotedExclusivelyToFraternalPurposes(o: Person, y: TaxableYear) {
    authority Secretary;
    label en official "the domestic fraternal society's net earnings are devoted exclusively to religious, charitable, scientific, literary, educational, and fraternal purposes (section 501(c)(10)(A)) — DECISION-0194 evaluative channel";
}
pub relation provides_life_sick_accident_or_other_benefits_10(o: Person, y: TaxableYear) kind empirical {
    label en official "the domestic fraternal society provides for the payment of life, sick, accident, or other benefits (section 501(c)(10)(B), a disqualifying condition)";
}
rule Section501c10Classification(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(10): a domestic lodge-system fraternal society devoted exclusively to the listed purposes, paying no member benefits";
    when operates_under_lodge_system_or_for_lodge_fraternity(o, y);
    when NetEarningsDevotedExclusivelyToFraternalPurposes(o, y);
    unless provides_life_sick_accident_or_other_benefits_10(o, y);
    then section_501c10(o, y);
}
rule DescribedIn501cViaC10(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c): an organization described in section 501(c)(10) is described in subsection (c)";
    when section_501c10(o, y);
    then described_in_501c(o, y);
}

// ---------------------------------------------------------------------
// (c)(11): local teachers' retirement fund associations.
// ---------------------------------------------------------------------

@source(IRC_S501_C, quote = "Teachers' retirement fund associations of a purely local character, if—\n(A) no part of their net earnings inures (other than through payment of retirement benefits) to the benefit of any private shareholder or individual, and\n(B) the income consists solely of amounts received from public taxation, amounts received from assessments on the teaching salaries of members, and income in respect of investments.")
pub relation section_501c11(o: Person, y: TaxableYear) kind institutional {
    label en official "an organization described in section 501(c)(11): a purely local teachers' retirement fund association with no non-retirement-benefit inurement and income limited to taxation/member-assessment/investment amounts";
}
pub relation teachers_retirement_fund_of_purely_local_character(o: Person) kind empirical {
    label en official "the association is a teachers' retirement fund association of a purely local character (section 501(c)(11))";
}
pub relation c11_inurement_other_than_retirement_benefits(o: Person, y: TaxableYear) kind empirical {
    label en official "a part of the association's net earnings inures to a private shareholder or individual OTHER than through payment of retirement benefits (section 501(c)(11)(A))";
}
pub relation c11_income_restricted_to_taxation_assessments_and_investments(o: Person, y: TaxableYear) kind empirical {
    label en official "the association's income consists solely of amounts from public taxation, member-salary assessments, and investment income (section 501(c)(11)(B))";
}
rule Section501c11Classification(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(11): a local teachers' retirement fund association meeting the inurement and income-source restrictions";
    when teachers_retirement_fund_of_purely_local_character(o);
    when c11_income_restricted_to_taxation_assessments_and_investments(o, y);
    unless c11_inurement_other_than_retirement_benefits(o, y);
    then section_501c11(o, y);
}
rule DescribedIn501cViaC11(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c): an organization described in section 501(c)(11) is described in subsection (c)";
    when section_501c11(o, y);
    then described_in_501c(o, y);
}

// ---------------------------------------------------------------------
// (c)(12)(A): benevolent life insurance associations, mutual ditch/
// irrigation/telephone companies — the 85 PERCENT EXACT test. (B)-(J)'s
// telephone/electric income exclusions are NOT modelled this stage
// (TECH-GAPS G485): a case is expected to assert the member-income and
// total-income figures ALREADY reflecting whichever (B)-(J) exclusion, if
// any, applies — same judgment call module 06 already made for section
// 512(b)'s exclusions feeding a single net figure.
// ---------------------------------------------------------------------

@source(IRC_S501_C, quote = "Benevolent life insurance associations of a purely local character, mutual ditch or irrigation companies, mutual or cooperative telephone companies, or like organizations; but only if 85 percent or more of the income consists of amounts collected from members for the sole purpose of meeting losses and expenses.")
pub relation section_501c12(o: Person, y: TaxableYear) kind institutional {
    label en official "an organization described in section 501(c)(12)(A): a benevolent life insurance association, mutual ditch/irrigation/telephone company, or like organization, 85 percent or more of whose income is member loss/expense income";
}
pub relation benevolent_insurance_or_mutual_utility_organization(o: Person) kind empirical {
    label en official "the organization is a benevolent life insurance association of a purely local character, a mutual ditch or irrigation company, a mutual or cooperative telephone company, or a like organization (section 501(c)(12)(A))";
}
pub relation member_loss_and_expense_income_501c12(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "amounts collected from members for the sole purpose of meeting losses and expenses, for the taxable year (section 501(c)(12)(A)) — already net of any (B)-(J) exclusion/inclusion that applies, per this stage's judgment call";
}
pub relation total_income_501c12(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the organization's total income for the taxable year, for the section 501(c)(12)(A) 85 percent test";
}
rule Section501c12EightyFivePercentTest(o: Person, y: TaxableYear, member: Money, total: Money) defeasible {
    label en official "section 501(c)(12)(A): 100 * member loss/expense income >= 85 * total income — exact cross-multiplication, never division, so exactly 85 percent satisfies '85 percent or more'";
    when benevolent_insurance_or_mutual_utility_organization(o);
    when member_loss_and_expense_income_501c12(o, y, member);
    when total_income_501c12(o, y, total);
    when member * 100 >= total * 85;
    then section_501c12(o, y);
}
rule DescribedIn501cViaC12(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c): an organization described in section 501(c)(12) is described in subsection (c)";
    when section_501c12(o, y);
    then described_in_501c(o, y);
}

// ---------------------------------------------------------------------
// (c)(13): cemetery companies / burial-disposal corporations.
// ---------------------------------------------------------------------

@source(IRC_S501_C, quote = "Cemetery companies owned and operated exclusively for the benefit of their members or which are not operated for profit; and any corporation chartered solely for the purpose of the disposal of bodies by burial or cremation which is not permitted by its charter to engage in any business not necessarily incident to that purpose and no part of the net earnings of which inures to the benefit of any private shareholder or individual.")
pub relation section_501c13(o: Person, y: TaxableYear) kind institutional {
    label en official "an organization described in section 501(c)(13): a member-benefit or not-for-profit cemetery company, or a charter-limited burial/cremation-disposal corporation with no private inurement";
}
pub relation cemetery_company_member_benefit_or_not_for_profit(o: Person, y: TaxableYear) kind empirical {
    label en official "the cemetery company is owned and operated exclusively for the benefit of its members, or is not operated for profit (section 501(c)(13), first branch)";
}
rule Section501c13ClassificationCemetery(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(13), first branch: a member-benefit or not-for-profit cemetery company";
    when cemetery_company_member_benefit_or_not_for_profit(o, y);
    then section_501c13(o, y);
}
pub relation chartered_solely_for_body_disposal_by_burial_or_cremation(o: Person, y: TaxableYear) kind empirical {
    label en official "the corporation is chartered solely for the disposal of bodies by burial or cremation and its charter does not permit engaging in business not necessarily incident to that purpose (section 501(c)(13), second branch)";
}
rule Section501c13ClassificationBurialDisposal(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(13), second branch: a charter-limited burial/cremation-disposal corporation with no private inurement";
    when chartered_solely_for_body_disposal_by_burial_or_cremation(o, y);
    unless private_inurement_established(o, y);
    then section_501c13(o, y);
}
rule DescribedIn501cViaC13(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c): an organization described in section 501(c)(13) is described in subsection (c)";
    when section_501c13(o, y);
    then described_in_501c(o, y);
}

// ---------------------------------------------------------------------
// (c)(14)(A): credit unions without capital stock. (B)/(C)'s pre-1957
// reserve-fund corporations are NOT modelled this stage (TECH-GAPS G485).
// ---------------------------------------------------------------------

@source(IRC_S501_C, quote = "Credit unions without capital stock organized and operated for mutual purposes and without profit.")
pub relation section_501c14(o: Person, y: TaxableYear) kind institutional {
    label en official "an organization described in section 501(c)(14)(A): a credit union without capital stock, organized and operated for mutual purposes and without profit";
}
pub relation credit_union_without_capital_stock(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization is a credit union without capital stock, organized and operated for mutual purposes and without profit (section 501(c)(14)(A))";
}
rule Section501c14Classification(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(14)(A): a credit union without capital stock, mutual and without profit";
    when credit_union_without_capital_stock(o, y);
    then section_501c14(o, y);
}
rule DescribedIn501cViaC14(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c): an organization described in section 501(c)(14) is described in subsection (c)";
    when section_501c14(o, y);
    then described_in_501c(o, y);
}

// ---------------------------------------------------------------------
// (c)(15)(A): small non-life insurance companies — the $600,000/$150,000
// gross-receipts EXACT tests plus the 50%/35% premium-composition EXACT
// tests. (B)/(C)'s controlled-group aggregation is NOT modelled this
// stage (TECH-GAPS G485): a case is expected to assert already-aggregated
// gross-receipts and premium figures per (B)/(C).
// ---------------------------------------------------------------------

@source(IRC_S501_C, quote = "Insurance companies (as defined in section 816(a)) other than life (including interinsurers and reciprocal underwriters) if—\n(i)(I) the gross receipts for the taxable year do not exceed $600,000, and\n(II) more than 50 percent of such gross receipts consist of premiums, or\n(ii) in the case of a mutual insurance company—\n(I) the gross receipts of which for the taxable year do not exceed $150,000, and\n(II) more than 35 percent of such gross receipts consist of premiums.")
pub relation section_501c15(o: Person, y: TaxableYear) kind institutional {
    label en official "an organization described in section 501(c)(15)(A): a small non-life insurance company meeting the (i) $600,000/50-percent or (ii) mutual $150,000/35-percent tests";
}
pub relation non_life_insurance_company_816a(o: Person) kind empirical {
    label en official "the organization is an insurance company (as defined in section 816(a)) other than life, including interinsurers and reciprocal underwriters (section 501(c)(15)(A))";
}
pub relation gross_receipts_501c15(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the insurance company's gross receipts for the taxable year (section 501(c)(15)(A))";
}
pub relation premium_receipts_501c15(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the portion of the insurance company's gross receipts consisting of premiums, for the taxable year (section 501(c)(15)(A))";
}
pub relation is_mutual_insurance_company_501c15(o: Person, y: TaxableYear) kind empirical {
    label en official "the insurance company is a mutual insurance company, for purposes of section 501(c)(15)(A)(ii)";
}
rule Section501c15NonMutualTest(o: Person, y: TaxableYear, gross: Money, premium: Money) defeasible {
    label en official "section 501(c)(15)(A)(i): gross receipts <= $600,000 and 100 * premium receipts > 50 * gross receipts — exact, no division";
    when non_life_insurance_company_816a(o);
    unless is_mutual_insurance_company_501c15(o, y);
    when gross_receipts_501c15(o, y, gross);
    when premium_receipts_501c15(o, y, premium);
    when gross <= 600000.00 USD;
    when premium * 100 > gross * 50;
    unless has_controlled_group_members_501c15B(o, y);
    then section_501c15(o, y);
}
rule Section501c15MutualTest(o: Person, y: TaxableYear, gross: Money, premium: Money) defeasible {
    label en official "section 501(c)(15)(A)(ii): for a mutual insurance company, gross receipts <= $150,000 and 100 * premium receipts > 35 * gross receipts — exact, no division";
    when non_life_insurance_company_816a(o);
    when is_mutual_insurance_company_501c15(o, y);
    when gross_receipts_501c15(o, y, gross);
    when premium_receipts_501c15(o, y, premium);
    when gross <= 150000.00 USD;
    when premium * 100 > gross * 35;
    unless has_controlled_group_members_501c15B(o, y);
    unless mutual_clause_ii_disapplied_501c15A(o, y);
    then section_501c15(o, y);
}
rule DescribedIn501cViaC15(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c): an organization described in section 501(c)(15) is described in subsection (c)";
    when section_501c15(o, y);
    then described_in_501c(o, y);
}

// ---------------------------------------------------------------------
// (c)(16): cooperative crop-financing corporations. The capital-stock
// dividend-rate proviso (state legal rate or 8 percent, whichever
// greater) is NOT modelled this stage — the "State legal rate of
// interest" is an EXTERNAL_DEPENDENCY on state law this package does not
// own (TECH-GAPS G485); the top-level classification is modelled.
// ---------------------------------------------------------------------

@source(IRC_S501_C, quote = "Corporations organized by an association subject to part IV of this subchapter or members thereof, for the purpose of financing the ordinary crop operations of such members or other producers, and operated in conjunction with such association.")
pub relation section_501c16(o: Person, y: TaxableYear) kind institutional {
    label en official "an organization described in section 501(c)(16): a corporation organized by a part-IV cooperative association or its members, to finance ordinary crop operations, operated in conjunction with that association";
}
pub relation organized_by_part_iv_cooperative_or_members(o: Person, y: TaxableYear) kind empirical {
    label en official "the corporation is organized by a part IV (section 521) cooperative association or its members (section 501(c)(16))";
}
pub relation finances_ordinary_crop_operations_in_conjunction_with_association(o: Person) kind empirical {
    label en official "the corporation's purpose is financing the ordinary crop operations of the association's members or other producers, and it is operated in conjunction with that association (section 501(c)(16))";
}
rule Section501c16Classification(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(16): a crop-financing corporation organized by, and operated in conjunction with, a part-IV cooperative association";
    when organized_by_part_iv_cooperative_or_members(o, y);
    when finances_ordinary_crop_operations_in_conjunction_with_association(o);
    then section_501c16(o, y);
}
rule DescribedIn501cViaC16(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c): an organization described in section 501(c)(16) is described in subsection (c)";
    when section_501c16(o, y);
    then described_in_501c(o, y);
}

// ---------------------------------------------------------------------
// (c)(17)(A): supplemental unemployment compensation benefit (SUB)
// trusts. (B)-(E)'s coordination-with-other-plans detail is NOT modelled
// this stage (TECH-GAPS G485).
// ---------------------------------------------------------------------

@source(IRC_S501_C, quote = "A trust or trusts forming part of a plan providing for the payment of supplemental unemployment compensation benefits, if—\n(i) under the plan, it is impossible, at any time prior to the satisfaction of all liabilities, with respect to employees under the plan, for any part of the corpus or income to be (within the taxable year or thereafter) used for, or diverted to, any purpose other than the providing of supplemental unemployment compensation benefits,")
pub relation section_501c17(o: Person, y: TaxableYear) kind institutional {
    label en official "an organization described in section 501(c)(17)(A): a SUB-benefit trust whose corpus/income cannot be diverted from SUB purposes, with a nondiscriminatory benefit classification";
}
pub relation sub_trust_no_diversion_possible(o: Person) kind empirical {
    label en official "under the plan it is impossible, prior to satisfying all liabilities, for any corpus or income to be used for or diverted to a purpose other than supplemental unemployment compensation benefits (section 501(c)(17)(A)(i))";
}
@source(IRC_S501_C, quote = "such benefits are payable to employees under a classification which is set forth in the plan and which is found by the Secretary not to be discriminatory in favor of employees who are highly compensated employees (within the meaning of section 414(q)),")
pub external judgment relation SubBenefitClassificationNondiscriminatory(o: Person, y: TaxableYear) {
    authority Secretary;
    label en official "the Secretary finds the plan's benefit classification not discriminatory in favor of highly compensated employees (section 501(c)(17)(A)(ii)-(iii)) — DECISION-0194 evaluative channel";
}
rule Section501c17Classification(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(17)(A): a SUB-benefit trust with no diversion possible and a Secretary-approved nondiscriminatory classification";
    when sub_trust_no_diversion_possible(o);
    when SubBenefitClassificationNondiscriminatory(o, y);
    then section_501c17(o, y);
}
rule DescribedIn501cViaC17(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c): an organization described in section 501(c)(17) is described in subsection (c)";
    when section_501c17(o, y);
    then described_in_501c(o, y);
}

// ---------------------------------------------------------------------
// (c)(18): pre-June 25, 1959 employee-funded pension trusts. (D)'s
// elective-contribution sub-rules are NOT modelled this stage
// (TECH-GAPS G485).
// ---------------------------------------------------------------------

@source(IRC_S501_C, quote = "A trust or trusts created before June 25, 1959, forming part of a plan providing for the payment of benefits under a pension plan funded only by contributions of employees, if—\n(A) under the plan, it is impossible, at any time prior to the satisfaction of all liabilities with respect to employees under the plan, for any part of the corpus or income to be (within the taxable year or thereafter) used for, or diverted to, any purpose other than the providing of benefits under the plan,")
pub relation section_501c18(o: Person, y: TaxableYear) kind institutional {
    label en official "an organization described in section 501(c)(18): a pre-June 25, 1959 employee-funded pension trust with no diversion possible and a nondiscriminatory benefit classification";
}
pub relation trust_created_before_date(o: Person, created_on: Date) kind empirical {
    label en official "the date the trust was created, for the section 501(c)(18) June 25, 1959 cutoff";
}
pub relation pension_trust_funded_only_by_employee_contributions(o: Person) kind empirical {
    label en official "the pension plan is funded only by contributions of employees (section 501(c)(18))";
}
pub relation c18_trust_no_diversion_possible(o: Person) kind empirical {
    label en official "under the plan it is impossible, prior to satisfying all liabilities, for any corpus or income to be used for or diverted to a purpose other than providing plan benefits (section 501(c)(18)(A))";
}
pub external judgment relation C18BenefitClassificationNondiscriminatory(o: Person, y: TaxableYear) {
    authority Secretary;
    label en official "the Secretary finds the plan's benefit classification not discriminatory in favor of highly compensated employees (section 501(c)(18)(B)-(C)) — DECISION-0194 evaluative channel";
}
rule Section501c18Classification(o: Person, y: TaxableYear, created_on: Date) defeasible {
    label en official "section 501(c)(18): a pre-June 25, 1959 employee-funded pension trust meeting (A)-(C)";
    when trust_created_before_date(o, created_on);
    when created_on < @1959-06-25;
    when pension_trust_funded_only_by_employee_contributions(o);
    when c18_trust_no_diversion_possible(o);
    when C18BenefitClassificationNondiscriminatory(o, y);
    then section_501c18(o, y);
}
rule DescribedIn501cViaC18(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c): an organization described in section 501(c)(18) is described in subsection (c)";
    when section_501c18(o, y);
    then described_in_501c(o, y);
}

// ---------------------------------------------------------------------
// (c)(19): veterans' posts/organizations — the 75 PERCENT EXACT test.
// ---------------------------------------------------------------------

@source(IRC_S501_C, quote = "A post or organization of past or present members of the Armed Forces of the United States, or an auxiliary unit or society of, or a trust or foundation for, any such post or organization—\n(A) organized in the United States or any of its possessions,\n(B) at least 75 percent of the members of which are past or present members of the Armed Forces of the United States and substantially all of the other members of which are individuals who are cadets or are spouses, widows, widowers, ancestors, or lineal descendants of past or present members of the Armed Forces of the United States or of cadets, and\n(C) no part of the net earnings of which inures to the benefit of any private shareholder or individual.")
pub relation section_501c19(o: Person, y: TaxableYear) kind institutional {
    label en official "an organization described in section 501(c)(19): a veterans' post/organization organized in the US, at least 75 percent past/present armed-forces members, no private inurement";
}
pub relation veterans_post_or_organization(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization is a post or organization of past or present Armed Forces members, or an auxiliary unit, society, trust, or foundation for such a post (section 501(c)(19))";
}
pub relation organized_in_us_or_possessions(o: Person) kind empirical {
    label en official "the organization is organized in the United States or any of its possessions (section 501(c)(19)(A))";
}
pub relation armed_forces_member_count_501c19(o: Person, count: Decimal) kind empirical {
    label en official "the count of members of the organization who are past or present members of the Armed Forces of the United States (section 501(c)(19)(B))";
}
pub relation total_member_count_501c19(o: Person, count: Decimal) kind empirical {
    label en official "the total membership count of the organization (section 501(c)(19)(B))";
}
pub external judgment relation OtherMembersSubstantiallyAllCadetsOrRelatives(o: Person) {
    authority Secretary;
    label en official "substantially all of the organization's other members are cadets or spouses/widows/widowers/ancestors/lineal descendants of past or present Armed Forces members or of cadets (section 501(c)(19)(B)) — DECISION-0194 evaluative channel";
}
rule Section501c19Classification(o: Person, y: TaxableYear, armed_forces: Decimal, total: Decimal) defeasible {
    label en official "section 501(c)(19): 100 * armed-forces-member count >= 75 * total member count — exact, no division — plus the (A)/(C) conditions and the (B) 'substantially all' remainder";
    when veterans_post_or_organization(o, y);
    when organized_in_us_or_possessions(o);
    when armed_forces_member_count_501c19(o, armed_forces);
    when total_member_count_501c19(o, total);
    when armed_forces * 100 >= total * 75;
    when OtherMembersSubstantiallyAllCadetsOrRelatives(o);
    unless private_inurement_established(o, y);
    then section_501c19(o, y);
}
rule DescribedIn501cViaC19(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c): an organization described in section 501(c)(19) is described in subsection (c)";
    when section_501c19(o, y);
    then described_in_501c(o, y);
}

// ---------------------------------------------------------------------
// (c)(20): REPEALED (Pub. L. 113-295, div. A, title II, §221(a)(19)(B)(iii),
// Dec. 19, 2014, 128 Stat. 4040). No operative text on the pinned
// fragment's face — classification `repealed_or_reserved`, no rule.
// ---------------------------------------------------------------------

// (c)(20) carries no operative text in the 2024-Edition pinned fragment
// (bracketed repeal notice only) — see coverage row, classification
// `repealed_or_reserved`, no relation/rule declared.

// ---------------------------------------------------------------------
// (c)(21)(A): Black Lung Acts trusts. (B)-(D)'s 110-percent funding-limit
// computation, actuarial-valuation and definitional detail are NOT
// modelled this stage (TECH-GAPS G485): the top-level purpose-exclusivity
// and no-diversion conditions are modelled.
// ---------------------------------------------------------------------

@source(IRC_S501_C, quote = "A trust or trusts established in writing, created or organized in the United States, and contributed to by any person (except an insurance company) if—\n(i) the purpose of such trust or trusts is exclusively—\n(I) to satisfy, in whole or in part, the liability of such person for, or with respect to, claims for compensation for disability or death due to pneumoconiosis under Black Lung Acts,")
pub relation section_501c21(o: Person, y: TaxableYear) kind institutional {
    label en official "an organization described in section 501(c)(21)(A): a Black Lung Acts liability trust, established in writing in the United States, exclusively for the listed Black Lung purposes, with no non-listed diversion of assets";
}
pub relation black_lung_trust_established_in_writing_in_us(o: Person) kind empirical {
    label en official "the trust is established in writing, created or organized in the United States, and contributed to by a person other than an insurance company (section 501(c)(21)(A))";
}
pub relation black_lung_trust_exclusive_purpose(o: Person) kind empirical {
    label en official "the trust's purpose is exclusively the section 501(c)(21)(A)(i) Black Lung liability/insurance/expense/benefit purposes";
}
pub relation black_lung_trust_no_disqualifying_diversion(o: Person, y: TaxableYear) kind empirical {
    label en official "no part of the Black Lung trust's assets is used for, or diverted to, a purpose outside section 501(c)(21)(A)(ii)'s list, for the taxable year";
}
rule Section501c21Classification(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(21)(A): a Black Lung Acts liability trust with an exclusive statutory purpose and no disqualifying diversion of assets";
    when black_lung_trust_established_in_writing_in_us(o);
    when black_lung_trust_exclusive_purpose(o);
    when black_lung_trust_no_disqualifying_diversion(o, y);
    then section_501c21(o, y);
}
rule DescribedIn501cViaC21(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c): an organization described in section 501(c)(21) is described in subsection (c)";
    when section_501c21(o, y);
    then described_in_501c(o, y);
}

// ---------------------------------------------------------------------
// (c)(22): multiemployer-plan withdrawal-liability payment trusts. (C)/(D)
// detail is NOT modelled this stage (TECH-GAPS G485).
// ---------------------------------------------------------------------

@source(IRC_S501_C, quote = "A trust created or organized in the United States and established in writing by the plan sponsors of multiemployer plans if—\n(A) the purpose of such trust is exclusively—\n(i) to pay any amount described in section 4223(c) or (h) of the Employee Retirement Income Security Act of 1974, and\n(ii) to pay reasonable and necessary administrative expenses in connection with the establishment and operation of the trust and the processing of claims against the trust,")
pub relation section_501c22(o: Person, y: TaxableYear) kind institutional {
    label en official "an organization described in section 501(c)(22): a multiemployer-plan-sponsor trust established in writing in the United States, exclusively for section 4223(c)/(h) payments and reasonable administrative expenses";
}
pub relation multiemployer_plan_sponsor_trust_established_in_writing(o: Person, y: TaxableYear) kind empirical {
    label en official "the trust is created or organized in the United States and established in writing by the plan sponsors of multiemployer plans (section 501(c)(22))";
}
pub relation multiemployer_trust_exclusive_purpose(o: Person) kind empirical {
    label en official "the trust's purpose is exclusively to pay section 4223(c)/(h) ERISA amounts and reasonable administrative expenses (section 501(c)(22)(A))";
}
rule Section501c22Classification(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(22): a multiemployer-plan-sponsor trust with an exclusive statutory purpose";
    when multiemployer_plan_sponsor_trust_established_in_writing(o, y);
    when multiemployer_trust_exclusive_purpose(o);
    then section_501c22(o, y);
}
rule DescribedIn501cViaC22(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c): an organization described in section 501(c)(22) is described in subsection (c)";
    when section_501c22(o, y);
    then described_in_501c(o, y);
}

// ---------------------------------------------------------------------
// (c)(23): pre-1880 veterans' associations — a second 75 PERCENT EXACT
// test.
// ---------------------------------------------------------------------

@source(IRC_S501_C, quote = "Any association organized before 1880 more than 75 percent of the members of which are present or past members of the Armed Forces and a principal purpose of which is to provide insurance and other benefits to veterans or their dependents.")
pub relation section_501c23(o: Person, y: TaxableYear) kind institutional {
    label en official "an organization described in section 501(c)(23): an association organized before 1880, more than 75 percent Armed Forces members, principal purpose providing veteran/dependent insurance and benefits";
}
pub relation organized_before_1880(o: Person, y: TaxableYear) kind empirical {
    label en official "the association was organized before the year 1880 (section 501(c)(23))";
}
pub relation armed_forces_member_count_501c23(o: Person, count: Decimal) kind empirical {
    label en official "the count of the association's members who are present or past Armed Forces members (section 501(c)(23))";
}
pub relation total_member_count_501c23(o: Person, count: Decimal) kind empirical {
    label en official "the total membership count of the association (section 501(c)(23))";
}
pub relation principal_purpose_veterans_insurance_and_benefits(o: Person) kind empirical {
    label en official "a principal purpose of the association is to provide insurance and other benefits to veterans or their dependents (section 501(c)(23))";
}
rule Section501c23Classification(o: Person, y: TaxableYear, armed_forces: Decimal, total: Decimal) defeasible {
    label en official "section 501(c)(23): 100 * armed-forces-member count > 75 * total member count — exact, no division — plus the pre-1880/purpose conditions";
    when organized_before_1880(o, y);
    when armed_forces_member_count_501c23(o, armed_forces);
    when total_member_count_501c23(o, total);
    when armed_forces * 100 > total * 75;
    when principal_purpose_veterans_insurance_and_benefits(o);
    then section_501c23(o, y);
}
rule DescribedIn501cViaC23(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c): an organization described in section 501(c)(23) is described in subsection (c)";
    when section_501c23(o, y);
    then described_in_501c(o, y);
}

// ---------------------------------------------------------------------
// (c)(24): ERISA section 4049 trust — a pure cross-reference to an
// external trust type this package does not own. EXTERNAL_DEPENDENCY
// switch, never computed here.
// ---------------------------------------------------------------------

@source(IRC_S501_C, quote = "A trust described in section 4049 of the Employee Retirement Income Security Act of 1974 (as in effect on the date of the enactment of the Single-Employer Pension Plan Amendments Act of 1986).")
pub relation described_in_erisa_4049(o: Person, y: TaxableYear) kind institutional {
    label en unofficial "a trust described in section 4049 of ERISA (as in effect on the SEPPAA-1986 enactment date) — EXTERNAL_DEPENDENCY, classification asserted; section text pinned in us.erisa.definitions (29 USC 1349: repealed, repeal record + historic text)";
}
rule Section501c24Classification(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(24): a trust described in ERISA section 4049 (as in effect 1986)";
    when described_in_erisa_4049(o, y);
    then described_in_501c(o, y);
}

// ---------------------------------------------------------------------
// (c)(25)(A): title-holding companies/trusts for multiple exempt
// beneficiaries — the 35-SHAREHOLDER EXACT test and the 1-class-of-stock
// exact test. (B)-(G)'s qualified-subsidiary/de-minimis-income/exit-
// rights detail is NOT modelled this stage (TECH-GAPS G485).
// ---------------------------------------------------------------------

@source(IRC_S501_C, quote = "Any corporation or trust which—\n(i) has no more than 35 shareholders or beneficiaries,\n(ii) has only 1 class of stock or beneficial interest, and\n(iii) is organized for the exclusive purposes of—\n(I) acquiring real property and holding title to, and collecting income from, such property, and\n(II) remitting the entire amount of income from such property (less expenses) to 1 or more organizations described in subparagraph (C) which are shareholders of such corporation or beneficiaries of such trust.")
pub relation section_501c25(o: Person, y: TaxableYear) kind institutional {
    label en official "an organization described in section 501(c)(25)(A): a corporation or trust with at most 35 shareholders/beneficiaries, 1 class of stock/interest, organized exclusively to hold title to and remit real-property income to section (C) beneficiaries";
}
pub relation shareholder_or_beneficiary_count_501c25(o: Person, y: TaxableYear, count: Decimal) kind empirical {
    label en official "the number of shareholders or beneficiaries of the corporation or trust (section 501(c)(25)(A)(i))";
}
pub relation has_only_one_class_of_stock_or_interest(o: Person) kind empirical {
    label en official "the corporation or trust has only 1 class of stock or beneficial interest (section 501(c)(25)(A)(ii))";
}
pub relation organized_exclusively_for_real_property_title_holding_multi(o: Person) kind empirical {
    label en official "the corporation or trust is organized for the exclusive purpose of acquiring real property, holding title, collecting income, and remitting it (less expenses) to one or more section 501(c)(25)(C) beneficiaries (section 501(c)(25)(A)(iii))";
}
rule Section501c25Classification(o: Person, y: TaxableYear, count: Decimal) defeasible {
    label en official "section 501(c)(25)(A): shareholder/beneficiary count <= 35 (exact integer, no rounding) plus the 1-class and exclusive-purpose conditions";
    when shareholder_or_beneficiary_count_501c25(o, y, count);
    when count <= 35.0;
    when has_only_one_class_of_stock_or_interest(o);
    when organized_exclusively_for_real_property_title_holding_multi(o);
    then section_501c25(o, y);
}
rule DescribedIn501cViaC25(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c): an organization described in section 501(c)(25) is described in subsection (c)";
    when section_501c25(o, y);
    then described_in_501c(o, y);
}

// ---------------------------------------------------------------------
// (c)(26): state high-risk-pool membership organizations.
// ---------------------------------------------------------------------

@source(IRC_S501_C, quote = "Any membership organization if—\n(A) such organization is established by a State exclusively to provide coverage for medical care (as defined in section 213(d)) on a not-for-profit basis to individuals described in subparagraph (B) through—\n(i) insurance issued by the organization, or\n(ii) a health maintenance organization under an arrangement with the organization,")
pub relation section_501c26(o: Person, y: TaxableYear) kind institutional {
    label en official "an organization described in section 501(c)(26): a State-established not-for-profit medical-coverage membership organization for high-risk individuals, with State-specified membership and no private inurement";
}
pub relation established_by_state_for_not_for_profit_medical_coverage(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization is established by a State exclusively to provide not-for-profit medical-care coverage to high-risk individuals through insurance or an HMO arrangement (section 501(c)(26)(A))";
}
pub relation membership_limited_to_state_high_risk_residents(o: Person) kind empirical {
    label en official "the only individuals receiving coverage through the organization are State residents unable to obtain, or able to obtain only at a substantially higher rate, medical coverage because of a medical condition (section 501(c)(26)(B))";
}
pub relation membership_composition_specified_by_state(o: Person) kind empirical {
    label en official "the composition of the organization's membership is specified by the State (section 501(c)(26)(C))";
}
rule Section501c26Classification(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(26): a State high-risk-pool membership organization meeting (A)-(C), with no private inurement";
    when established_by_state_for_not_for_profit_medical_coverage(o, y);
    when membership_limited_to_state_high_risk_residents(o);
    when membership_composition_specified_by_state(o);
    unless private_inurement_established(o, y);
    then section_501c26(o, y);
}
rule DescribedIn501cViaC26(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c): an organization described in section 501(c)(26) is described in subsection (c)";
    when section_501c26(o, y);
    then described_in_501c(o, y);
}

// ---------------------------------------------------------------------
// (c)(27): State workers' compensation reinsurance/insurance
// organizations — (A) pre-1996 member-reimbursement pools and (B)
// State-law-created insurers, modelled at top-level condition.
// ---------------------------------------------------------------------

@source(IRC_S501_C, quote = "Any membership organization if—\n(i) such organization is established before June 1, 1996, by a State exclusively to reimburse its members for losses arising under workmen's compensation acts,")
pub relation section_501c27(o: Person, y: TaxableYear) kind institutional {
    label en official "an organization described in section 501(c)(27): a pre-June 1, 1996 State workers'-compensation-loss-reimbursement membership organization, or a State-law-created workers'-compensation insurer meeting section 501(c)(27)(B)";
}
pub relation pre_1996_state_workers_comp_reimbursement_pool(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization was established before June 1, 1996 by a State exclusively to reimburse members for workmen's-compensation-act losses, with State-mandated membership and non-profit surplus/premium practices (section 501(c)(27)(A))";
}
rule Section501c27ClassificationA(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(27)(A): a pre-1996 State workers'-compensation-loss-reimbursement pool";
    when pre_1996_state_workers_comp_reimbursement_pool(o, y);
    then section_501c27(o, y);
}
pub relation state_law_created_workers_comp_insurer(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization is created by State law and organized/operated under State law to provide mandatory (or heavily incentivized) workers'-compensation insurance, open to any employer in the State, with State financial backing and majority State-appointed governance (section 501(c)(27)(B))";
}
rule Section501c27ClassificationB(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(27)(B): a State-law-created workers'-compensation insurer";
    when state_law_created_workers_comp_insurer(o, y);
    then section_501c27(o, y);
}
rule DescribedIn501cViaC27(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c): an organization described in section 501(c)(27) is described in subsection (c)";
    when section_501c27(o, y);
    then described_in_501c(o, y);
}

// ---------------------------------------------------------------------
// (c)(28): the National Railroad Retirement Investment Trust — a single
// NAMED entity, not a general classification test.
// ---------------------------------------------------------------------

@source(IRC_S501_C, quote = "The National Railroad Retirement Investment Trust established under section 15(j) of the Railroad Retirement Act of 1974.")
pub relation section_501c28(o: Person, y: TaxableYear) kind institutional {
    label en official "the National Railroad Retirement Investment Trust, established under section 15(j) of the Railroad Retirement Act of 1974 (section 501(c)(28))";
}
pub relation is_national_railroad_retirement_investment_trust(o: Person, y: TaxableYear) kind empirical {
    label en official "the entity is the National Railroad Retirement Investment Trust established under section 15(j) of the Railroad Retirement Act of 1974 (a single named entity, section 501(c)(28))";
}
rule Section501c28Classification(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(28): the named National Railroad Retirement Investment Trust";
    when is_national_railroad_retirement_investment_trust(o, y);
    then section_501c28(o, y);
}
rule DescribedIn501cViaC28(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c): the organization described in section 501(c)(28) is described in subsection (c)";
    when section_501c28(o, y);
    then described_in_501c(o, y);
}

// ---------------------------------------------------------------------
// (c)(29): CO-OP health insurance issuers.
// ---------------------------------------------------------------------

@source(IRC_S501_C, quote = "CO–OP health insurance issuers.—\n(A) In general.—A qualified nonprofit health insurance issuer (within the meaning of section 1322 of the Patient Protection and Affordable Care Act) which has received a loan or grant under the CO–OP program under such section, but only with respect to periods for which the issuer is in compliance with the requirements of such section and any agreement with respect to the loan or grant.")
pub relation section_501c29(o: Person, y: TaxableYear) kind institutional {
    label en official "an organization described in section 501(c)(29): a qualified nonprofit CO-OP health insurance issuer under ACA section 1322, in compliance with section 1322 and its loan/grant agreement, meeting the (B) conditions";
}
pub relation qualified_nonprofit_co_op_health_insurance_issuer(o: Person) kind empirical {
    label en official "the organization is a qualified nonprofit health insurance issuer (ACA section 1322) that has received a CO-OP program loan or grant (section 501(c)(29)(A))";
}
pub relation in_compliance_with_1322_and_loan_grant_agreement(o: Person, y: TaxableYear) kind empirical {
    label en official "the issuer is in compliance, for the taxable year, with ACA section 1322's requirements and its CO-OP loan/grant agreement (section 501(c)(29)(A))";
}
pub relation section_501c29_notice_given_to_secretary(o: Person) kind empirical {
    label en official "the organization has given notice to the Secretary that it is applying for recognition of its section 501(c)(29) status (section 501(c)(29)(B)(i))";
}
pub relation section_501c29_inurement_established(o: Person, y: TaxableYear) kind empirical {
    label en official "a part of the CO-OP issuer's net earnings inures to the benefit of a private shareholder or individual, other than as permitted by ACA section 1322(c)(4) (section 501(c)(29)(B)(ii))";
}
rule Section501c29Classification(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(29): a qualified, compliant, notice-filed CO-OP health insurance issuer with no disqualifying inurement, substantial lobbying, or political-campaign intervention";
    when qualified_nonprofit_co_op_health_insurance_issuer(o);
    when in_compliance_with_1322_and_loan_grant_agreement(o, y);
    when section_501c29_notice_given_to_secretary(o);
    unless section_501c29_inurement_established(o, y);
    unless SubstantialLegislativeActivity(o, y);
    unless political_campaign_intervention_established(o, y);
    then section_501c29(o, y);
}
rule DescribedIn501cViaC29(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c): an organization described in section 501(c)(29) is described in subsection (c)";
    when section_501c29(o, y);
    then described_in_501c(o, y);
}

// ---------------------------------------------------------------------
// `section_501c_category` — the task's requested pub interface: which of
// the 20 modelled categories ((1)-(19), (21)-(29) minus the repealed
// (20)) an organization is classified under, for a given taxable year.
// One bridging rule per category; NOT a `defeasible` head requiring
// mutual exclusion (an organization could in principle qualify under more
// than one paragraph on the same facts — the statute itself does not
// require uniqueness, and this package does not invent one).
// ---------------------------------------------------------------------

pub enum Section501cParagraph {
    C1, C2, C3, C4, C5, C6, C7, C8, C9, C10, C11, C12, C13, C14, C15, C16,
    C17, C18, C19, C21, C22, C23, C24, C25, C26, C27, C28, C29
}
pub relation section_501c_category(o: Person, y: TaxableYear, category: Section501cParagraph) kind institutional {
    label en unofficial "the section 501(c) paragraph the organization is classified under for the taxable year (task's requested pub interface; an organization satisfying more than one paragraph on the same facts yields more than one row, which the statute itself does not forbid)";
}
rule Section501cCategoryC1(o: Person, y: TaxableYear) defeasible { when section_501c1(o, y); then section_501c_category(o, y, C1); }
rule Section501cCategoryC2(o: Person, y: TaxableYear) defeasible { when section_501c2(o, y); then section_501c_category(o, y, C2); }
rule Section501cCategoryC3(o: Person, y: TaxableYear) defeasible { when section_501c3(o, y); then section_501c_category(o, y, C3); }
rule Section501cCategoryC4(o: Person, y: TaxableYear) defeasible { when section_501c4(o, y); then section_501c_category(o, y, C4); }
rule Section501cCategoryC5(o: Person, y: TaxableYear) defeasible { when section_501c5(o, y); then section_501c_category(o, y, C5); }
rule Section501cCategoryC6(o: Person, y: TaxableYear) defeasible { when section_501c6(o, y); then section_501c_category(o, y, C6); }
rule Section501cCategoryC7(o: Person, y: TaxableYear) defeasible { when section_501c7(o, y); then section_501c_category(o, y, C7); }
rule Section501cCategoryC8(o: Person, y: TaxableYear) defeasible { when section_501c8(o, y); then section_501c_category(o, y, C8); }
rule Section501cCategoryC9(o: Person, y: TaxableYear) defeasible { when section_501c9(o, y); then section_501c_category(o, y, C9); }
rule Section501cCategoryC10(o: Person, y: TaxableYear) defeasible { when section_501c10(o, y); then section_501c_category(o, y, C10); }
rule Section501cCategoryC11(o: Person, y: TaxableYear) defeasible { when section_501c11(o, y); then section_501c_category(o, y, C11); }
rule Section501cCategoryC12(o: Person, y: TaxableYear) defeasible { when section_501c12(o, y); then section_501c_category(o, y, C12); }
rule Section501cCategoryC13(o: Person, y: TaxableYear) defeasible { when section_501c13(o, y); then section_501c_category(o, y, C13); }
rule Section501cCategoryC14(o: Person, y: TaxableYear) defeasible { when section_501c14(o, y); then section_501c_category(o, y, C14); }
rule Section501cCategoryC15(o: Person, y: TaxableYear) defeasible { when section_501c15(o, y); then section_501c_category(o, y, C15); }
rule Section501cCategoryC16(o: Person, y: TaxableYear) defeasible { when section_501c16(o, y); then section_501c_category(o, y, C16); }
rule Section501cCategoryC17(o: Person, y: TaxableYear) defeasible { when section_501c17(o, y); then section_501c_category(o, y, C17); }
rule Section501cCategoryC18(o: Person, y: TaxableYear) defeasible { when section_501c18(o, y); then section_501c_category(o, y, C18); }
rule Section501cCategoryC19(o: Person, y: TaxableYear) defeasible { when section_501c19(o, y); then section_501c_category(o, y, C19); }
rule Section501cCategoryC21(o: Person, y: TaxableYear) defeasible { when section_501c21(o, y); then section_501c_category(o, y, C21); }
rule Section501cCategoryC22(o: Person, y: TaxableYear) defeasible { when section_501c22(o, y); then section_501c_category(o, y, C22); }
rule Section501cCategoryC23(o: Person, y: TaxableYear) defeasible { when section_501c23(o, y); then section_501c_category(o, y, C23); }
rule Section501cCategoryC25(o: Person, y: TaxableYear) defeasible { when section_501c25(o, y); then section_501c_category(o, y, C25); }
rule Section501cCategoryC26(o: Person, y: TaxableYear) defeasible { when section_501c26(o, y); then section_501c_category(o, y, C26); }
rule Section501cCategoryC27(o: Person, y: TaxableYear) defeasible { when section_501c27(o, y); then section_501c_category(o, y, C27); }
rule Section501cCategoryC28(o: Person, y: TaxableYear) defeasible { when section_501c28(o, y); then section_501c_category(o, y, C28); }
rule Section501cCategoryC29(o: Person, y: TaxableYear) defeasible { when section_501c29(o, y); then section_501c_category(o, y, C29); }
// (c)(24) is deliberately excluded from `Section501cParagraph`: it is a
// pure EXTERNAL_DEPENDENCY cross-reference to an ERISA trust type this
// package does not classify on its own facts (see `described_in_erisa_4049`
// above), not a self-standing classification this package concludes.
