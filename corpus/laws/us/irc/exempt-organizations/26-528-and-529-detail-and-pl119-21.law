// Section 528 and section 529, stage 3, with the Public Law 119-21
// (July 4, 2025) revisions that touch section 529: section 70413 (the new
// section 529(c)(7) list of elementary and secondary expenses, and the higher
// cap in the last sentence of section 529(e)(3)), section 70414 (qualified
// postsecondary credentialing expenses, new (e)(3)(C) and (f)) and section
// 70117 (the ABLE rollover of section 529(c)(3)(C)(i)(III) made permanent).
// Windows use `effective` over legal_time exactly as us.irc.deductions does; the
// enactment date is 2025-07-04 and the section 70413(b)/70117 dates are
// taxable years beginning after December 31, 2025.

// ---------------------------------------------------------------------
// Section 528.
// ---------------------------------------------------------------------

use self::{
    IRC_S528_C,
    IRC_S528_D,
    IRC_S529_A,
    IRC_S529_B,
    IRC_S529_C,
    IRC_S529_D,
    IRC_S529_E,
    Person,
    TaxableYear,
    established_by_state_or_eligible_institution_529b1,
    gross_income_528c,
    homeowners_association,
    homeowners_association_sixty_percent_income_test,
    homeowners_association_taxable_income,
    organized_for_association_property_care_528c1A,
    qtp_k12_tuition_expenses_529c7,
    qtp_k12_tuition_qualifies_529c7,
    qualified_tuition_program,
};

pub enum HomeownersAssociationDuesSource528 { CondominiumUnitOwners, ResidenceOrLotOwners, TimeshareRightOwners }
pub relation dues_fees_or_assessments_from_owners_528c1B(o: Person, y: TaxableYear, dues_source: HomeownersAssociationDuesSource528, amount: Money) kind empirical {
    label en official "amounts received as membership dues, fees, or assessments from owners of residential units in the case of a condominium management association (i), owners of residences or residential lots in the case of a residential real estate management association (ii), or owners of timeshare rights or ownership interests in the case of a timeshare association (iii)";
}
pub relation dues_from_owners_total_528c1B(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the association's membership dues, fees and assessments from owners, summed over the three sources";
}
@source(IRC_S528_C, quote = "(B) 60 percent or more of the gross income of such organization for the taxable year consists solely of amounts received as membership dues, fees, or assessments from—")
@source(IRC_S528_C, quote = "(i) owners of residential units in the case of a condominium management association,")
@source(IRC_S528_C, quote = "(ii) owners of residences or residential lots in the case of a residential real estate management association, or")
@source(IRC_S528_C, quote = "(iii) owners of timeshare rights to use, or timeshare ownership interests in, association property in the case of a timeshare association,")
rule DuesFromOwnersTotal(o: Person, y: TaxableYear) defeasible {
    label en official "section 528(c)(1)(B)(i)-(iii): amounts received solely as membership dues, fees or assessments from owners of the three kinds";
    when us.irc.core::year_of(o, y);
    then dues_from_owners_total_528c1B(o, y, sum all a: Money for s: HomeownersAssociationDuesSource528 where dues_fees_or_assessments_from_owners_528c1B(o, y, s, a));
}
@source(IRC_S528_C, quote = "(B) 60 percent or more of the gross income of such organization for the taxable year consists solely of amounts received as membership dues, fees, or assessments from—")
rule HomeownersAssociationSixtyPercentIncomeTestFromSources(o: Person, y: TaxableYear, dues: Money, gross: Money) defeasible {
    label en official "section 528(c)(1)(B): 100 * dues from owners >= 60 * gross income — exactly 60 percent qualifies";
    when dues_from_owners_total_528c1B(o, y, dues);
    when gross_income_528c(o, y, gross);
    when dues * 100 >= gross * 60;
    then homeowners_association_sixty_percent_income_test(o, y, dues, gross);
}
pub enum NetEarningsInurementKind528c1D { AcquiringConstructingOrProvidingCareOfAssociationProperty, RebateOfExcessDuesFeesOrAssessments, AnyOtherInurement }
pub relation net_earnings_inure_528c1D(o: Person, y: TaxableYear, kind: NetEarningsInurementKind528c1D) kind empirical {
    label en official "a part of the net earnings of the organization inures to the benefit of a private shareholder or individual in the given way";
}
pub relation prohibited_inurement_528c1D(o: Person, y: TaxableYear) kind institutional {
    label en official "net earnings inure to the benefit of a private shareholder or individual other than by acquiring, constructing or providing management, maintenance and care of association property, or by a rebate of excess membership dues, fees or assessments";
}
@source(IRC_S528_C, quote = "(D) no part of the net earnings of such organization inures (other than by acquiring, constructing, or providing management, maintenance, and care of association property, and other than by a rebate of excess membership dues, fees, or assessments) to the benefit of any private shareholder or individual, and")
rule ProhibitedInurementUnderSection528c1D(o: Person, y: TaxableYear) defeasible {
    label en official "section 528(c)(1)(D): only inurement of the other kind is prohibited";
    when net_earnings_inure_528c1D(o, y, NetEarningsInurementKind528c1D.AnyOtherInurement);
    then prohibited_inurement_528c1D(o, y);
}
pub external judgment relation SubstantiallyAllUnitsUsedByIndividualsForResidences528c2(o: Person) {
    authority Secretary;
    label en official "substantially all the units of the condominium project are used by individuals for residences (section 528(c)(2)) — DECISION-0194 evaluative channel";
}
pub external judgment relation SubstantiallyAllLotsOrBuildingsOnlyUsableByIndividualsForResidences528c3(o: Person) {
    authority Secretary;
    label en official "substantially all the lots or buildings of the subdivision, development, or similar area may only be used by individuals for residences (section 528(c)(3)) — DECISION-0194 evaluative channel";
}
pub relation condominium_management_association_528c2(o: Person) kind institutional {
    label en official "a condominium management association";
}
@source(IRC_S528_C, quote = "The term \"condominium management association\" means any organization meeting the requirement of subparagraph (A) of paragraph (1) with respect to a condominium project substantially all of the units of which are used by individuals for residences.")
rule CondominiumManagementAssociation(o: Person) defeasible {
    label en official "section 528(c)(2): an organization meeting subparagraph (A) with respect to a condominium project substantially all of whose units are residences";
    when organized_for_association_property_care_528c1A(o);
    when SubstantiallyAllUnitsUsedByIndividualsForResidences528c2(o);
    then condominium_management_association_528c2(o);
}
pub relation residential_real_estate_management_association_528c3(o: Person) kind institutional {
    label en official "a residential real estate management association";
}
@source(IRC_S528_C, quote = "The term \"residential real estate management association\" means any organization meeting the requirements of subparagraph (A) of paragraph (1) with respect to a subdivision, development, or similar area substantially all the lots or buildings of which may only be used by individuals for residences.")
rule ResidentialRealEstateManagementAssociation(o: Person) defeasible {
    label en official "section 528(c)(3): an organization meeting subparagraph (A) with respect to a subdivision, development or similar area substantially all of whose lots or buildings may only be used for residences";
    when organized_for_association_property_care_528c1A(o);
    when SubstantiallyAllLotsOrBuildingsOnlyUsableByIndividualsForResidences528c3(o);
    then residential_real_estate_management_association_528c3(o);
}
pub relation member_holds_timeshare_right_or_interest_in_association_property_528c4(o: Person) kind empirical {
    label en official "a member holds a timeshare right to use, or a timeshare ownership interest in, real property constituting association property";
}
pub relation timeshare_association_derived_528c4(o: Person) kind institutional {
    label en official "a timeshare association: an organization other than a condominium management association meeting subparagraph (A) where a member holds a timeshare right or interest in association property";
}
@source(IRC_S528_C, quote = "The term \"timeshare association\" means any organization (other than a condominium management association) meeting the requirement of subparagraph (A) of paragraph (1) if any member thereof holds a timeshare right to use, or a timeshare ownership interest in, real property constituting association property.")
rule TimeshareAssociationDerived(o: Person) defeasible {
    label en official "section 528(c)(4)";
    when organized_for_association_property_care_528c1A(o);
    when member_holds_timeshare_right_or_interest_in_association_property_528c4(o);
    unless condominium_management_association_528c2(o);
    then timeshare_association_derived_528c4(o);
}
pub enum AssociationPropertyKind528c5 { HeldByTheOrganization, CommonlyHeldByMembers, PrivatelyHeldByMembersWithinTheOrganization, GovernmentOwnedAndUsedForResidentsBenefit, TimeshareRecordedRightsToUseRelatedProperty }
pub relation property_kind_528c5(asset_id: Text, kind: AssociationPropertyKind528c5) kind empirical {
    label en official "the property is held by the organization (A), commonly held by the members (B), privately held by members within the organization (C), owned by a governmental unit and used for the benefit of residents of the unit (D); for a timeshare association, property in which the association or its members have rights under recorded easements, covenants or other recorded instruments to use property related to the timeshare project";
}
pub relation association_property_528c5(asset_id: Text) kind institutional {
    label en official "the property is association property";
}
@source(IRC_S528_C, quote = "The term \"association property\" means—")
@source(IRC_S528_C, quote = "(A) property held by the organization,")
@source(IRC_S528_C, quote = "(B) property commonly held by the members of the organization,")
@source(IRC_S528_C, quote = "(C) property within the organization privately held by the members of the organization, and")
@source(IRC_S528_C, quote = "(D) property owned by a governmental unit and used for the benefit of residents of such unit.")
@source(IRC_S528_C, quote = "In the case of a timeshare association, such term includes property in which the timeshare association, or members of the association, have rights arising out of recorded easements, covenants, or other recorded instruments to use property related to the timeshare project.")
rule AssociationProperty(asset_id: Text, k: AssociationPropertyKind528c5) defeasible {
    label en official "section 528(c)(5)(A)-(D) and the timeshare sentence";
    when property_kind_528c5(asset_id, k);
    then association_property_528c5(asset_id);
}
pub relation political_no_nol_or_special_deductions_flag_528d2(o: Person, y: TaxableYear) kind institutional {
    label en official "no net operating loss deduction under section 172 and no part VIII special deduction for corporations is allowed in computing homeowners association taxable income";
}
@source(IRC_S528_D, quote = "(B) no net operating loss deduction shall be allowed under section 172, and")
@source(IRC_S528_D, quote = "(C) no deduction shall be allowed under part VIII of subchapter B (relating to special deductions for corporations).")
rule HomeownersAssociationNoNolNoPartVIIIDeduction(o: Person, y: TaxableYear) defeasible {
    label en official "section 528(d)(2)(B)-(C)";
    when homeowners_association(o, y);
    then political_no_nol_or_special_deductions_flag_528d2(o, y);
}
pub relation exempt_function_income_from_owners_528d3(o: Person, y: TaxableYear, dues_source: HomeownersAssociationDuesSource528, amount: Money) kind empirical {
    label en official "membership dues, fees or assessments from condominium housing unit owners (A), owners of real property in a residential real estate management association (B), or owners of timeshare rights or interests in real property in a timeshare association (C)";
}
pub relation homeowners_exempt_function_income_total_528d3(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the association's exempt function income: the owners' dues, fees and assessments";
}
@source(IRC_S528_D, quote = "For purposes of this subsection, the term \"exempt function income\" means any amount received as membership dues, fees, or assessments from—")
@source(IRC_S528_D, quote = "(A) owners of condominium housing units in the case of a condominium management association,")
@source(IRC_S528_D, quote = "(B) owners of real property in the case of a residential real estate management association, or")
@source(IRC_S528_D, quote = "(C) owners of timeshare rights to use, or timeshare ownership interests in, real property in the case of a timeshare association.")
rule HomeownersExemptFunctionIncomeTotal(o: Person, y: TaxableYear) defeasible {
    label en official "section 528(d)(3): the sum of dues, fees and assessments from the three kinds of owner";
    when homeowners_association(o, y);
    then homeowners_exempt_function_income_total_528d3(o, y, sum all a: Money for s: HomeownersAssociationDuesSource528 where exempt_function_income_from_owners_528d3(o, y, s, a));
}
pub relation total_gross_income_528d1(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the homeowners association's gross income for the taxable year before excluding exempt function income";
}
pub relation total_directly_connected_deductions_528d1(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the deductions allowed by this chapter directly connected with the production of the gross income (excluding exempt function income)";
}
@source(IRC_S528_D, quote = "(A) the gross income for the taxable year (excluding any exempt function income), over")
@source(IRC_S528_D, quote = "(B) the deductions allowed by this chapter which are directly connected with the production of the gross income (excluding exempt function income), computed with the modifications provided in paragraph (2).")
@source(IRC_S528_D, quote = "(A) there shall be allowed a specific deduction of $100,")
rule HomeownersAssociationTaxableIncomeFromTotals(o: Person, y: TaxableYear, gross: Money, efi: Money, deductions: Money) defeasible {
    label en official "section 528(d)(1)-(2): gross income less exempt function income, less directly connected deductions, less the $100 specific deduction, not below zero";
    when homeowners_association(o, y);
    when total_gross_income_528d1(o, y, gross);
    when homeowners_exempt_function_income_total_528d3(o, y, efi);
    when total_directly_connected_deductions_528d1(o, y, deductions);
    then homeowners_association_taxable_income(o, y, max(0.00 USD, gross - efi - deductions - 100.00 USD));
}

// ---------------------------------------------------------------------
// Section 529.
// ---------------------------------------------------------------------

pub relation qualified_tuition_program_exempt_529a(program: Person, y: TaxableYear) kind institutional {
    label en official "a qualified tuition program is exempt from taxation under this subtitle";
}
pub relation qualified_tuition_program_subject_to_section_511_529a(program: Person, y: TaxableYear) kind institutional {
    label en official "the program remains subject to the tax imposed by section 511 on unrelated business income";
}
@source(IRC_S529_A, quote = "A qualified tuition program shall be exempt from taxation under this subtitle. Notwithstanding the preceding sentence, such program shall be subject to the taxes imposed by section 511 (relating to imposition of tax on unrelated business income of charitable organizations).")
rule QualifiedTuitionProgramExemptButSubjectTo511(program: Person, y: TaxableYear) defeasible {
    label en official "section 529(a): exempt, but subject to section 511";
    when qualified_tuition_program(program);
    when us.irc.core::year_of(program, y);
    then qualified_tuition_program_exempt_529a(program, y);
}
@source(IRC_S529_A, quote = "A qualified tuition program shall be exempt from taxation under this subtitle. Notwithstanding the preceding sentence, such program shall be subject to the taxes imposed by section 511 (relating to imposition of tax on unrelated business income of charitable organizations).")
rule QualifiedTuitionProgramSubjectTo511(program: Person, y: TaxableYear) defeasible {
    label en official "section 529(a), second sentence";
    when qualified_tuition_program(program);
    when us.irc.core::year_of(program, y);
    then qualified_tuition_program_subject_to_section_511_529a(program, y);
}
pub relation program_permits_purchase_of_tuition_credits_or_certificates_529b1Ai(program: Person) kind empirical {
    label en official "under the program a person may purchase tuition credits or certificates on behalf of a designated beneficiary entitling the beneficiary to the waiver or payment of qualified higher education expenses";
}
pub relation state_program_permits_contributions_to_beneficiary_account_529b1Aii(program: Person) kind empirical {
    label en official "in the case of a program established and maintained by a State or its agency or instrumentality, a person may make contributions to an account established to meet the qualified higher education expenses of the designated beneficiary";
}
pub relation program_type_requirements_met_529b1A(program: Person) kind institutional {
    label en official "the program is of one of the two kinds section 529(b)(1)(A) describes";
}
@source(IRC_S529_B, quote = "(A) under which a person—")
@source(IRC_S529_B, quote = "(i) may purchase tuition credits or certificates on behalf of a designated beneficiary which entitle the beneficiary to the waiver or payment of qualified higher education expenses of the beneficiary, or")
rule ProgramTypeRequirementsMetViaCredits(program: Person) defeasible {
    label en official "section 529(b)(1)(A)(i)";
    when program_permits_purchase_of_tuition_credits_or_certificates_529b1Ai(program);
    then program_type_requirements_met_529b1A(program);
}
@source(IRC_S529_B, quote = "(ii) in the case of a program established and maintained by a State or agency or instrumentality thereof, may make contributions to an account which is established for the purpose of meeting the qualified higher education expenses of the designated beneficiary of the account, and")
rule ProgramTypeRequirementsMetViaStateAccount(program: Person) defeasible {
    label en official "section 529(b)(1)(A)(ii)";
    when established_by_state_or_eligible_institution_529b1(program);
    when state_program_permits_contributions_to_beneficiary_account_529b1Aii(program);
    then program_type_requirements_met_529b1A(program);
}
pub relation institution_program_amounts_held_in_qualified_trust_529b1flush(program: Person) kind empirical {
    label en official "a program established and maintained by one or more eligible educational institutions provides that amounts are held in a qualified trust";
}
pub relation institution_program_received_ruling_or_determination_529b1flush(program: Person) kind empirical {
    label en official "the program has received a ruling or determination that it meets the applicable requirements for a qualified tuition program";
}
pub relation institution_program_requirements_met_529b1flush(program: Person) kind institutional {
    label en official "an institution-maintained program holds amounts in a qualified trust and has received the ruling or determination";
}
@source(IRC_S529_B, quote = "Except to the extent provided in regulations, a program established and maintained by 1 or more eligible educational institutions shall not be treated as a qualified tuition program unless such program provides that amounts are held in a qualified trust and such program has received a ruling or determination that such program meets the applicable requirements for a qualified tuition program. For purposes of the preceding sentence, the term \"qualified trust\" means a trust which is created or orga")
rule InstitutionProgramRequirementsMet(program: Person) defeasible {
    label en official "section 529(b)(1), last sentence";
    when institution_program_amounts_held_in_qualified_trust_529b1flush(program);
    when institution_program_received_ruling_or_determination_529b1flush(program);
    then institution_program_requirements_met_529b1flush(program);
}
pub relation investment_direction_changes_in_calendar_year_529b4(program: Person, beneficiary: Person, calendar_year: Integer, count: Decimal) kind empirical {
    label en official "the number of times in the calendar year a contributor or designated beneficiary directed the investment of contributions (or earnings)";
}
pub relation investment_direction_within_two_per_year_529b4(program: Person, beneficiary: Person, calendar_year: Integer) kind institutional {
    label en official "the investment was directed no more than 2 times in the calendar year";
}
@source(IRC_S529_B, quote = "A program shall not be treated as a qualified tuition program unless it provides that any contributor to, or designated beneficiary under, such program may, directly or indirectly, direct the investment of any contributions to the program (or any earnings thereon) no more than 2 times in any calendar year.")
rule InvestmentDirectionWithinTwoPerYear(program: Person, beneficiary: Person, calendar_year: Integer, count: Decimal) defeasible {
    label en official "section 529(b)(4): no more than 2 times — exactly 2 qualifies";
    when investment_direction_changes_in_calendar_year_529b4(program, beneficiary, calendar_year, count);
    when count <= 2.0;
    then investment_direction_within_two_per_year_529b4(program, beneficiary, calendar_year);
}
// (c)(2): gift tax.
pub relation contribution_to_qtp_made_529c2A(donor: Person, beneficiary: Person, calendar_year: Integer, amount: Money) kind empirical {
    label en official "a contribution to a qualified tuition program on behalf of the designated beneficiary";
}
pub relation contribution_treated_as_completed_gift_not_future_interest_529c2A(donor: Person, beneficiary: Person, calendar_year: Integer) kind institutional {
    label en official "the contribution is a completed gift to the beneficiary which is not a future interest in property, and is not a qualified transfer under section 2503(e)";
}
@source(IRC_S529_C, quote = "Any contribution to a qualified tuition program on behalf of any designated beneficiary—")
@source(IRC_S529_C, quote = "(i) shall be treated as a completed gift to such beneficiary which is not a future interest in property, and")
@source(IRC_S529_C, quote = "(ii) shall not be treated as a qualified transfer under section 2503(e).")
rule ContributionIsCompletedGift(donor: Person, beneficiary: Person, calendar_year: Integer, amount: Money) defeasible {
    label en official "section 529(c)(2)(A)";
    when contribution_to_qtp_made_529c2A(donor, beneficiary, calendar_year, amount);
    then contribution_treated_as_completed_gift_not_future_interest_529c2A(donor, beneficiary, calendar_year);
}
pub relation aggregate_qtp_contributions_by_donor_in_calendar_year_529c2B(donor: Person, beneficiary: Person, calendar_year: Integer, amount: Money) kind empirical {
    label en official "the aggregate amount of the donor's contributions to qualified tuition programs on behalf of the beneficiary during the calendar year";
}
pub relation section_2503b_limit_for_year_529c2B(calendar_year: Integer, amount: Money) kind empirical {
    label en official "the limitation for the calendar year under section 2503(b)";
}
pub relation five_year_election_made_529c2B(donor: Person, beneficiary: Person, calendar_year: Integer) kind empirical {
    label en official "the donor elected to take the contributions into account ratably over the 5-year period beginning with the calendar year";
}
pub relation five_year_election_available_529c2B(donor: Person, beneficiary: Person, calendar_year: Integer) kind institutional {
    label en official "the aggregate contributions in the calendar year exceed the section 2503(b) limitation, so the election is available";
}
@source(IRC_S529_C, quote = "If the aggregate amount of contributions described in subparagraph (A) during the calendar year by a donor exceeds the limitation for such year under section 2503(b), such aggregate amount shall, at the election of the donor, be taken into account for purposes of such section ratably over the 5-year period beginning with such calendar year.")
rule FiveYearElectionAvailable(donor: Person, beneficiary: Person, calendar_year: Integer, aggregate: Money, limit: Money) defeasible {
    label en official "section 529(c)(2)(B): contributions above the section 2503(b) limitation — equal to the limitation does not exceed it";
    when aggregate_qtp_contributions_by_donor_in_calendar_year_529c2B(donor, beneficiary, calendar_year, aggregate);
    when section_2503b_limit_for_year_529c2B(calendar_year, limit);
    when aggregate > limit;
    then five_year_election_available_529c2B(donor, beneficiary, calendar_year);
}
pub relation five_year_ratable_amount_per_year_529c2B(donor: Person, beneficiary: Person, calendar_year: Integer, amount: Money) kind institutional {
    label en official "the amount taken into account in each of the 5 years: one fifth of the aggregate contributions";
}
@source(IRC_S529_C, quote = "If the aggregate amount of contributions described in subparagraph (A) during the calendar year by a donor exceeds the limitation for such year under section 2503(b), such aggregate amount shall, at the election of the donor, be taken into account for purposes of such section ratably over the 5-year period beginning with such calendar year.")
rule FiveYearRatableAmount(donor: Person, beneficiary: Person, calendar_year: Integer, aggregate: Money) defeasible {
    label en official "section 529(c)(2)(B): ratably over the 5-year period — one fifth in each year";
    when five_year_election_available_529c2B(donor, beneficiary, calendar_year);
    when five_year_election_made_529c2B(donor, beneficiary, calendar_year);
    when aggregate_qtp_contributions_by_donor_in_calendar_year_529c2B(donor, beneficiary, calendar_year, aggregate);
    then five_year_ratable_amount_per_year_529c2B(donor, beneficiary, calendar_year, aggregate * 0.20);
}
pub relation donor_elected_five_year_and_died_before_close_of_period_529c4C(donor: Person, beneficiary: Person, calendar_year: Integer, years_after_death: Decimal) kind empirical {
    label en official "the donor made the paragraph (2)(B) election and died before the close of the 5-year period; the number of the period's years that fall after the date of death";
}
pub relation gross_estate_includes_portion_allocable_after_death_529c4C(donor: Person, beneficiary: Person, calendar_year: Integer, amount: Money) kind institutional {
    label en official "the donor's gross estate includes the portion of the contributions properly allocable to periods after the date of death";
}
@source(IRC_S529_C, quote = "In the case of a donor who makes the election described in paragraph (2)(B) and who dies before the close of the 5-year period referred to in such paragraph, notwithstanding subparagraph (A), the gross estate of the donor shall include the portion of such contributions properly allocable to periods after the date of death of the donor.")
rule GrossEstateIncludesPortionAllocableAfterDeath(donor: Person, beneficiary: Person, calendar_year: Integer, aggregate: Money, years_after: Decimal) defeasible {
    label en official "section 529(c)(4)(C): one fifth of the contributions for each year of the period after the date of death";
    when donor_elected_five_year_and_died_before_close_of_period_529c4C(donor, beneficiary, calendar_year, years_after);
    when aggregate_qtp_contributions_by_donor_in_calendar_year_529c2B(donor, beneficiary, calendar_year, aggregate);
    then gross_estate_includes_portion_allocable_after_death_529c4C(donor, beneficiary, calendar_year, aggregate * 0.20 * years_after);
}
pub relation interest_in_qtp_529c4A(decedent: Person, program: Person) kind empirical {
    label en official "the individual holds an interest in a qualified tuition program";
}
pub relation distribution_on_account_of_death_of_beneficiary_529c4B(decedent: Person, program: Person) kind empirical {
    label en official "the amount is distributed on account of the death of a beneficiary";
}
pub relation interest_excluded_from_gross_estate_529c4A(decedent: Person, program: Person) kind institutional {
    label en official "no amount is includible in the gross estate by reason of the interest in the qualified tuition program";
}
@source(IRC_S529_C, quote = "No amount shall be includible in the gross estate of any individual for purposes of chapter 11 by reason of an interest in a qualified tuition program.")
@source(IRC_S529_C, quote = "Subparagraph (A) shall not apply to amounts distributed on account of the death of a beneficiary.")
rule InterestExcludedFromGrossEstate(decedent: Person, program: Person) defeasible {
    label en official "section 529(c)(4)(A)-(B): excluded, except amounts distributed on account of the death of a beneficiary";
    when interest_in_qtp_529c4A(decedent, program);
    unless distribution_on_account_of_death_of_beneficiary_for_pair_529c4B(decedent, program);
    then interest_excluded_from_gross_estate_529c4A(decedent, program);
}
pub relation distribution_on_account_of_death_of_beneficiary_for_pair_529c4B(decedent: Person, program: Person) kind institutional {
    label en official "helper: the death exception bound to the decedent and program";
}
rule DistributionOnDeathForPair(decedent: Person, program: Person) defeasible {
    label en official "helper";
    when distribution_on_account_of_death_of_beneficiary_529c4B(decedent, program);
    then distribution_on_account_of_death_of_beneficiary_for_pair_529c4B(decedent, program);
}
// (c)(3): distributions and rollovers — the parts stage 2b skipped.
pub relation qtp_qualified_expenses_before_reductions_529c3Bv(beneficiary: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the beneficiary's qualified higher education expenses for the taxable year";
}
pub relation expenses_reduced_under_25Ag2_529c3BvI(beneficiary: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the reduction provided in section 25A(g)(2)";
}
pub relation expenses_taken_into_account_for_25A_credit_529c3BvII(beneficiary: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of such expenses taken into account in determining the credit allowed to the taxpayer or any other person under section 25A";
}
pub relation qtp_qualified_expenses_after_reductions_529c3Bv(beneficiary: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "qualified higher education expenses after the (v) reductions, never below zero";
}
@source(IRC_S529_C, quote = "The total amount of qualified higher education expenses with respect to an individual for the taxable year shall be reduced—")
@source(IRC_S529_C, quote = "(I) as provided in section 25A(g)(2), and")
@source(IRC_S529_C, quote = "(II) by the amount of such expenses which were taken into account in determining the credit allowed to the taxpayer or any other person under section 25A.")
rule QualifiedExpensesAfterReductions(beneficiary: Person, y: TaxableYear, expenses: Money, r1: Money, r2: Money) defeasible {
    label en official "section 529(c)(3)(B)(v): the total qualified higher education expenses less the section 25A(g)(2) reduction and the expenses used for the section 25A credit";
    when qtp_qualified_expenses_before_reductions_529c3Bv(beneficiary, y, expenses);
    when expenses_reduced_under_25Ag2_529c3BvI(beneficiary, y, r1);
    when expenses_taken_into_account_for_25A_credit_529c3BvII(beneficiary, y, r2);
    then qtp_qualified_expenses_after_reductions_529c3Bv(beneficiary, y, max(0.00 USD, expenses - r1 - r2));
}
pub relation transfer_to_qtp_for_benefit_of_beneficiary_on_529c3Ciii(beneficiary: Person, transferred_on: Date) kind empirical {
    label en official "a transfer to a qualified tuition program for the benefit of the designated beneficiary on the date";
}
pub relation transfer_within_12_months_of_previous_transfer_529c3Ciii(beneficiary: Person, transferred_on: Date) kind institutional {
    label en official "the transfer occurs within 12 months from the date of a previous transfer for the benefit of the beneficiary — clause (i)(I) does not apply to it";
}
@source(IRC_S529_C, quote = "Clause (i)(I) shall not apply to any transfer if such transfer occurs within 12 months from the date of a previous transfer to any qualified tuition program for the benefit of the designated beneficiary.")
rule TransferWithin12MonthsOfPrevious(beneficiary: Person, transferred_on: Date, previous: Date) defeasible {
    label en official "section 529(c)(3)(C)(iii): a transfer less than 12 months after a previous transfer";
    when transfer_to_qtp_for_benefit_of_beneficiary_on_529c3Ciii(beneficiary, transferred_on);
    when transfer_to_qtp_for_benefit_of_beneficiary_on_529c3Ciii(beneficiary, previous);
    when previous < transferred_on;
    when transferred_on < add_calendar_period(previous, 12 calendar_month);
    then transfer_within_12_months_of_previous_transfer_529c3Ciii(beneficiary, transferred_on);
}
pub relation beneficiary_change_to_family_member_529c3Cii(old: Person, new: Person, y: TaxableYear) kind empirical {
    label en official "the designated beneficiary of an interest changed to a new beneficiary who is a member of the family of the old beneficiary";
}
pub relation beneficiary_change_not_a_distribution_529c3Cii(old: Person, new: Person, y: TaxableYear) kind institutional {
    label en official "the change in designated beneficiary is not treated as a distribution";
}
@source(IRC_S529_C, quote = "Any change in the designated beneficiary of an interest in a qualified tuition program shall not be treated as a distribution for purposes of subparagraph (A) if the new beneficiary is a member of the family of the old beneficiary.")
rule BeneficiaryChangeNotADistribution(old: Person, new: Person, y: TaxableYear) defeasible {
    label en official "section 529(c)(3)(C)(ii)";
    when beneficiary_change_to_family_member_529c3Cii(old, new, y);
    then beneficiary_change_not_a_distribution_529c3Cii(old, new, y);
}
pub relation refund_of_qualified_expenses_received_on_529c3D(beneficiary: Person, refunded_on: Date, refund_amount: Money) kind empirical {
    label en official "the beneficiary received a refund of qualified higher education expenses from an eligible educational institution";
}
pub relation recontribution_to_qtp_529c3D(beneficiary: Person, recontributed_on: Date, amount: Money) kind empirical {
    label en official "the recontribution to a qualified tuition program of which the individual is a beneficiary";
}
pub relation recontribution_excluded_from_distribution_529c3D(beneficiary: Person, amount: Money) kind institutional {
    label en official "the recontributed portion of the distribution is not includible: made within 60 days of the refund and not more than the refunded amount";
}
@source(IRC_S529_C, quote = "In the case of a beneficiary who receives a refund of any qualified higher education expenses from an eligible educational institution, subparagraph (A) shall not apply to that portion of any distribution for the taxable year which is recontributed to a qualified tuition program of which such individual is a beneficiary, but only to the extent such recontribution is made not later than 60 days after the date of such refund and does not exceed the refunded amount.")
rule RecontributionExcludedFromDistribution(beneficiary: Person, refunded_on: Date, refund: Money, recontributed_on: Date, amount: Money) defeasible {
    label en official "section 529(c)(3)(D): within 60 days after the refund (the 60th day is inclusive) and not exceeding the refunded amount";
    when refund_of_qualified_expenses_received_on_529c3D(beneficiary, refunded_on, refund);
    when recontribution_to_qtp_529c3D(beneficiary, recontributed_on, amount);
    when recontributed_on <= add_calendar_period(refunded_on, 60 calendar_day);
    when amount <= refund;
    then recontribution_excluded_from_distribution_529c3D(beneficiary, amount);
}
pub relation distribution_on_15_year_program_amount_529c3Ei(beneficiary: Person, distribution: Money) kind empirical {
    label en official "the distribution from a program maintained for the 15-year period ending on the date of the distribution";
}
pub relation contributions_and_earnings_before_5_year_period_529c3EiI(beneficiary: Person, amount: Money) kind empirical {
    label en official "the aggregate amount contributed to the program (and earnings attributable) before the 5-year period ending on the date of the distribution";
}
pub relation roth_ira_annual_limit_less_other_contributions_529c3Eii(beneficiary: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount applicable to the designated beneficiary under section 408A(c)(2) for the taxable year, reduced by aggregate contributions to all individual retirement plans for the beneficiary during the year";
}
pub relation roth_rollover_trustee_to_trustee_529c3EiII(beneficiary: Person) kind empirical {
    label en official "the amount is paid in a direct trustee-to-trustee transfer to a Roth IRA maintained for the beneficiary";
}
pub relation roth_rollover_excluded_amount_529c3E(beneficiary: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the portion of the distribution not includible: the lesser of the distribution, the pre-5-year contributions and earnings, and the annual Roth limit";
}
@source(IRC_S529_C, quote = "In the case of a distribution from a qualified tuition program of a designated beneficiary which has been maintained for the 15-year period ending on the date of such distribution, subparagraph (A) shall not apply to so much the portion of such distribution which—")
@source(IRC_S529_C, quote = "(I) does not exceed the aggregate amount contributed to the program (and earnings attributable thereto) before the 5-year period ending on the date of the distribution, and")
@source(IRC_S529_C, quote = "(II) is paid in a direct trustee-to-trustee transfer to a Roth IRA maintained for the benefit of such designated beneficiary.")
@source(IRC_S529_C, quote = "Clause (i) shall only apply to so much of any distribution as does not exceed the amount applicable to the designated beneficiary under section 408A(c)(2) for the taxable year (reduced by the amount of aggregate contributions made during the taxable year to all individual retirement plans maintained for the benefit of the designated beneficiary).")
rule RothRolloverExcludedAmount(beneficiary: Person, y: TaxableYear, distribution: Money, pre5: Money, limit: Money) defeasible {
    label en official "section 529(c)(3)(E)(i)-(ii): the distribution, capped by amounts contributed before the 5-year period and by the annual Roth limit net of other IRA contributions";
    when distribution_on_15_year_program_amount_529c3Ei(beneficiary, distribution);
    when contributions_and_earnings_before_5_year_period_529c3EiI(beneficiary, pre5);
    when roth_ira_annual_limit_less_other_contributions_529c3Eii(beneficiary, y, limit);
    when roth_rollover_trustee_to_trustee_529c3EiiII_alias(beneficiary);
    then roth_rollover_excluded_amount_529c3E(beneficiary, y, min(distribution, min(pre5, max(0.00 USD, limit))));
}
pub relation roth_rollover_trustee_to_trustee_529c3EiiII_alias(beneficiary: Person) kind institutional {
    label en official "alias of the trustee-to-trustee condition";
}
rule RothTrusteeToTrusteeAlias(beneficiary: Person) defeasible {
    label en official "alias";
    when roth_rollover_trustee_to_trustee_529c3EiII(beneficiary);
    then roth_rollover_trustee_to_trustee_529c3EiiII_alias(beneficiary);
}
// (c)(5).
pub relation new_beneficiary_same_or_higher_generation_and_family_member_529c5B(old: Person, new: Person) kind empirical {
    label en official "the new beneficiary is assigned to the same generation as (or a higher generation than) the old beneficiary (section 2651) and is a member of the family of the old beneficiary";
}
pub relation beneficiary_change_or_rollover_529c5B(old: Person, new: Person) kind empirical {
    label en official "a transfer by reason of a change in the designated beneficiary under the program (or a rollover to the account of a new beneficiary)";
}
pub relation chapters_12_and_13_apply_to_beneficiary_change_529c5B(old: Person, new: Person) kind institutional {
    label en official "the taxes of chapters 12 and 13 apply to the transfer";
}
@source(IRC_S529_C, quote = "The taxes imposed by chapters 12 and 13 shall apply to a transfer by reason of a change in the designated beneficiary under the program (or a rollover to the account of a new beneficiary) unless the new beneficiary is—")
@source(IRC_S529_C, quote = "(i) assigned to the same generation as (or a higher generation than) the old beneficiary (determined in accordance with section 2651), and")
@source(IRC_S529_C, quote = "(ii) a member of the family of the old beneficiary.")
rule Chapters12And13ApplyToBeneficiaryChange(old: Person, new: Person) defeasible {
    label en official "section 529(c)(5)(B): applies unless the new beneficiary is of the same or a higher generation and a member of the family";
    when beneficiary_change_or_rollover_529c5B(old, new);
    unless new_beneficiary_same_or_higher_generation_and_family_member_529c5B(old, new);
    then chapters_12_and_13_apply_to_beneficiary_change_529c5B(old, new);
}
// (c)(8), (9): apprenticeship expenses and student loan payments.
pub relation apprenticeship_program_registered_with_secretary_of_labor_529c8(program_id: Text) kind empirical {
    label en official "the apprenticeship program is registered and certified with the Secretary of Labor under section 1 of the National Apprenticeship Act";
}
pub relation apprenticeship_expense_for_beneficiary_529c8(beneficiary: Person, program_id: Text, amount: Money) kind empirical {
    label en official "fees, books, supplies, and equipment required for the participation of the designated beneficiary in the apprenticeship program";
}
pub relation apprenticeship_expense_is_qualified_higher_education_expense_529c8(beneficiary: Person, program_id: Text, amount: Money) kind institutional {
    label en official "the expense is treated as a qualified higher education expense";
}
@source(IRC_S529_C, quote = "Any reference in this subsection to the term \"qualified higher education expense\" shall include a reference to expenses for fees, books, supplies, and equipment required for the participation of a designated beneficiary in an apprenticeship program registered and certified with the Secretary of Labor under section 1 of the National Apprenticeship Act (29 U.S.C. 50).")
rule ApprenticeshipExpenseIsQualified(beneficiary: Person, program_id: Text, amount: Money) defeasible {
    label en official "section 529(c)(8)";
    when apprenticeship_program_registered_with_secretary_of_labor_529c8(program_id);
    when apprenticeship_expense_for_beneficiary_529c8(beneficiary, program_id, amount);
    then apprenticeship_expense_is_qualified_higher_education_expense_529c8(beneficiary, program_id, amount);
}
pub relation qualified_education_loan_payment_529c9A(beneficiary: Person, borrower: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "principal or interest paid on a qualified education loan (section 221(d)) of the designated beneficiary or of a sibling of the beneficiary";
}
pub relation prior_distributions_treated_as_loan_expenses_for_individual_529c9B(borrower: Person, amount: Money) kind empirical {
    label en official "the amount of distributions so treated for all prior taxable years with respect to the individual's loans";
}
pub relation loan_payment_treated_as_qualified_expense_529c9(beneficiary: Person, borrower: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the loan payment treated as a qualified higher education expense, not above $10,000 lifetime per individual";
}
@source(IRC_S529_C, quote = "Any reference in this subsection to the term \"qualified higher education expense\" shall include a reference to amounts paid as principal or interest on any qualified education loan (as defined in section 221(d)) of the designated beneficiary or a sibling of the designated beneficiary.")
@source(IRC_S529_C, quote = "The amount of distributions treated as a qualified higher education expense under this paragraph with respect to the loans of any individual shall not exceed $10,000 (reduced by the amount of distributions so treated for all prior taxable years).")
@source(IRC_S529_C, quote = "For purposes of subparagraph (B) and subsection (d), amounts treated as a qualified higher education expense with respect to the loans of a sibling of the designated beneficiary shall be taken into account with respect to such sibling and not with respect to such designated beneficiary.")
rule LoanPaymentTreatedAsQualifiedExpense(beneficiary: Person, borrower: Person, y: TaxableYear, payment: Money, prior: Money) defeasible {
    label en official "section 529(c)(9)(B): not exceeding $10,000 reduced by the amount so treated for all prior taxable years; a sibling's loans are counted against the sibling";
    when qualified_education_loan_payment_529c9A(beneficiary, borrower, y, payment);
    when prior_distributions_treated_as_loan_expenses_for_individual_529c9B(borrower, prior);
    then loan_payment_treated_as_qualified_expense_529c9(beneficiary, borrower, y, min(payment, max(0.00 USD, 10000.00 USD - prior)));
}
// (d): reports.
pub relation officer_having_control_of_qtp_529d1(officer: Person, program: Person) kind empirical {
    label en official "the officer or employee having control of the qualified tuition program (or their designee)";
}
pub relation section_529d1_report_made(program: Person, y: TaxableYear) kind empirical {
    label en official "the reports required by section 529(d)(1) regarding contributions, distributions and other matters were made to the Secretary and to designated beneficiaries";
}
@source(IRC_S529_D, quote = "Each officer or employee having control of the qualified tuition program or their designee shall make such reports regarding such program to the Secretary and to designated beneficiaries with respect to contributions, distributions, and such other matters as the Secretary may require. The reports required by this paragraph shall be filed at such time and in such manner and furnished to such individuals at such time and in such manner as may be required by the Secretary.")
rule MakeSection529ReportsDutyRule(officer: Person, program: Person, y: TaxableYear, start: Date, ending: Date) strict {
    label en official "section 529(d)(1): the officer or employee having control of the program shall make reports to the Secretary and to designated beneficiaries";
    when officer_having_control_of_qtp_529d1(officer, program);
    when us.irc.core::begins(y, start);
    when us.irc.core::ends(y, ending);
    then duty MakeSection529Reports {
        bearer officer;
        goal achievement {
            condition section_529d1_report_made(program, y);
            window [start, ending];
        }
    };
}
pub relation roth_distribution_report_provided_to_trustee_529d2(program: Person, beneficiary: Person) kind empirical {
    label en official "the report to the trustee of the Roth IRA of the contributions, distributions and earnings as of the date of the distribution was provided";
}
pub relation section_529c3E_distribution_made_529d2(program: Person, beneficiary: Person) kind empirical {
    label en official "a distribution described in subsection (c)(3)(E) was made";
}
@source(IRC_S529_D, quote = "In the case of any distribution described in subsection (c)(3)(E), the officer or employee having control of the qualified tuition program (or their designee) shall provide a report to the trustee of the Roth IRA to which the distribution is made. Such report shall be filed at such time and in such manner as the Secretary may require and shall include information with respect to the contributions, distributions, and earnings of the qualified tuition program as of the date of the distribution des")
rule ProvideRothDistributionReportDutyRule(officer: Person, program: Person, beneficiary: Person) strict {
    label en official "section 529(d)(2): for a section 529(c)(3)(E) distribution the officer having control shall provide a report to the trustee of the Roth IRA";
    when officer_having_control_of_qtp_529d1(officer, program);
    when section_529c3E_distribution_made_529d2(program, beneficiary);
    then duty ProvideSection529RothDistributionReport {
        bearer officer;
        goal achievement {
            condition roth_distribution_report_provided_to_trustee_529d2(program, beneficiary);
            window [-infinity, infinity];
        }
    };
}
// (e): definitions.
pub relation beneficiary_designated_at_commencement_529e1A(individual: Person, program: Person) kind empirical {
    label en official "the individual designated at the commencement of participation in the program as the beneficiary of amounts paid or to be paid";
}
pub relation beneficiary_after_change_529e1B(individual: Person, program: Person) kind empirical {
    label en official "in the case of a change in beneficiaries described in subsection (c)(3)(C), the individual who is the new beneficiary";
}
pub relation scholarship_recipient_of_interest_purchased_by_government_or_c3_529e1C(individual: Person, program: Person) kind empirical {
    label en official "the interest was purchased by a State or local government (or agency or instrumentality) or an exempt section 501(c)(3) organization as part of a scholarship program, and the individual receives the interest as a scholarship";
}
pub relation designated_beneficiary_derived_529e1(individual: Person, program: Person) kind institutional {
    label en official "the individual is a designated beneficiary";
}
@source(IRC_S529_E, quote = "(A) the individual designated at the commencement of participation in the qualified tuition program as the beneficiary of amounts paid (or to be paid) to the program,")
rule DesignatedBeneficiaryAtCommencement(individual: Person, program: Person) defeasible {
    label en official "section 529(e)(1)(A)";
    when beneficiary_designated_at_commencement_529e1A(individual, program);
    then designated_beneficiary_derived_529e1(individual, program);
}
@source(IRC_S529_E, quote = "(B) in the case of a change in beneficiaries described in subsection (c)(3)(C), the individual who is the new beneficiary, and")
rule DesignatedBeneficiaryAfterChange(individual: Person, program: Person) defeasible {
    label en official "section 529(e)(1)(B)";
    when beneficiary_after_change_529e1B(individual, program);
    then designated_beneficiary_derived_529e1(individual, program);
}
@source(IRC_S529_E, quote = "(C) in the case of an interest in a qualified tuition program purchased by a State or local government (or agency or instrumentality thereof) or an organization described in section 501(c)(3) and exempt from taxation under section 501(a) as part of a scholarship program operated by such government or organization, the individual receiving such interest as a scholarship.")
rule DesignatedBeneficiaryScholarshipRecipient(individual: Person, program: Person) defeasible {
    label en official "section 529(e)(1)(C)";
    when scholarship_recipient_of_interest_purchased_by_government_or_c3_529e1C(individual, program);
    then designated_beneficiary_derived_529e1(individual, program);
}
pub enum FamilyRelation529e2 { Spouse, RelationInSection152d2AThroughG, SpouseOfSuchRelation, FirstCousin }
pub relation family_relation_529e2(beneficiary: Person, other: Person, kind: FamilyRelation529e2) kind empirical {
    label en official "the other person is the spouse of the beneficiary (A); an individual bearing a relationship described in subparagraphs (A) through (G) of section 152(d)(2) (B) — EXTERNAL_DEPENDENCY on the section 152 owner; the spouse of such an individual (C); or a first cousin (D)";
}
pub relation member_of_family_529e2(beneficiary: Person, other: Person) kind institutional {
    label en official "the other person is a member of the family of the designated beneficiary";
}
@source(IRC_S529_E, quote = "The term \"member of the family\" means, with respect to any designated beneficiary—")
@source(IRC_S529_E, quote = "(A) the spouse of such beneficiary;")
@source(IRC_S529_E, quote = "(B) an individual who bears a relationship to such beneficiary which is described in subparagraphs (A) through (G) of section 152(d)(2);")
@source(IRC_S529_E, quote = "(C) the spouse of any individual described in subparagraph (B); and")
@source(IRC_S529_E, quote = "(D) any first cousin of such beneficiary.")
rule MemberOfFamily(beneficiary: Person, other: Person, k: FamilyRelation529e2) defeasible {
    label en official "section 529(e)(2)(A)-(D)";
    when family_relation_529e2(beneficiary, other, k);
    then member_of_family_529e2(beneficiary, other);
}
pub relation actual_room_and_board_cost_529e3Bi(beneficiary: Person, period: Text, amount: Money) kind empirical {
    label en official "the reasonable costs for room and board incurred by the designated beneficiary for the academic period as determined under the qualified tuition program";
}
pub relation cost_of_attendance_room_and_board_allowance_529e3Bii_I(beneficiary: Person, period: Text, amount: Money) kind empirical {
    label en official "the allowance (applicable to the student) for room and board included in the cost of attendance as determined by the eligible educational institution";
}
pub relation actual_invoice_amount_for_institution_housing_529e3Bii_II(beneficiary: Person, period: Text, amount: Money) kind empirical {
    label en official "the actual invoice amount the student residing in housing owned or operated by the institution is charged for room and board";
}
pub relation eligible_student_for_room_and_board_529e3Bi(beneficiary: Person, period: Text) kind empirical {
    label en official "the individual is an eligible student (section 25A(b)(3)) for the academic period";
}
pub relation room_and_board_qualified_expense_529e3B(beneficiary: Person, period: Text, amount: Money) kind institutional {
    label en official "the room and board treated as qualified higher education expenses: the actual cost, not above the greater of the allowance and the actual invoice amount";
}
@source(IRC_S529_E, quote = "In the case of an individual who is an eligible student (as defined in section 25A(b)(3)) for any academic period, such term shall also include reasonable costs for such period (as determined under the qualified tuition program) incurred by the designated beneficiary for room and board while attending such institution. For purposes of subsection (b)(6), a designated beneficiary shall be treated as meeting the requirements of this clause.")
@source(IRC_S529_E, quote = "The amount treated as qualified higher education expenses by reason of clause (i) shall not exceed—")
@source(IRC_S529_E, quote = "(I) the allowance (applicable to the student) for room and board included in the cost of attendance (as defined in section 472 of the Higher Education Act of 1965 (20 U.S.C. 1087ll), as in effect on the date of the enactment of the Economic Growth and Tax Relief Reconciliation Act of 2001) as determined by the eligible educational institution for such period, or")
@source(IRC_S529_E, quote = "(II) if greater, the actual invoice amount the student residing in housing owned or operated by the eligible educational institution is charged by such institution for room and board costs for such period.")
rule RoomAndBoardQualifiedExpense(beneficiary: Person, period: Text, actual: Money, allowance: Money, invoice: Money) defeasible {
    label en official "section 529(e)(3)(B): reasonable room and board costs of an eligible student, not exceeding the greater of the allowance and the invoice amount";
    when eligible_student_for_room_and_board_529e3Bi(beneficiary, period);
    when actual_room_and_board_cost_529e3Bi(beneficiary, period, actual);
    when cost_of_attendance_room_and_board_allowance_529e3Bii_I(beneficiary, period, allowance);
    when actual_invoice_amount_for_institution_housing_529e3Bii_II(beneficiary, period, invoice);
    then room_and_board_qualified_expense_529e3B(beneficiary, period, min(actual, max(allowance, invoice)));
}
pub relation qtp_interest_not_debt_for_section_514_529e4(program: Person) kind institutional {
    label en official "an interest in a qualified tuition program is not treated as debt for purposes of section 514";
}
@source(IRC_S529_E, quote = "An interest in a qualified tuition program shall not be treated as debt for purposes of section 514.")
rule QtpInterestNotDebtForSection514(program: Person) defeasible {
    label en official "section 529(e)(4)";
    when qualified_tuition_program(program);
    then qtp_interest_not_debt_for_section_514_529e4(program);
}

// ---------------------------------------------------------------------
// Public Law 119-21 section 70413: elementary and secondary expenses.
// ---------------------------------------------------------------------

pub enum ElementaryOrSecondaryExpense529c7 { Tuition, CurriculumAndCurricularMaterials, BooksOrOtherInstructionalMaterials, OnlineEducationalMaterials, DualEnrollmentFees, StandardizedOrAdmissionTestFees, EducationalTherapiesForStudentsWithDisabilities }
pub relation elementary_or_secondary_expense_529c7(beneficiary: Person, y: TaxableYear, kind: ElementaryOrSecondaryExpense529c7, amount: Money) kind empirical {
    label en official "an expense in connection with enrollment or attendance at, or for a student enrolled at or attending, an elementary or secondary public, private or religious school: tuition (A); curriculum and curricular materials (B); books or other instructional materials (C); online educational materials (D); fees for a nationally standardized norm-referenced achievement test, an advanced placement examination or an examination related to college or university admission (F); fees for dual enrollment in an institution of higher education (G); educational therapies for students with disabilities provided by a licensed or accredited practitioner (H)";
}
pub relation tutoring_expense_529c7E(beneficiary: Person, y: TaxableYear, instructor: Person, amount: Money) kind empirical {
    label en official "tuition for tutoring or educational classes outside of the home, including at a tutoring facility";
}
pub relation instructor_not_related_to_student_529c7E(instructor: Person, beneficiary: Person) kind empirical {
    label en official "the tutor or instructor is not related to the student";
}
pub relation instructor_licensed_teacher_in_any_state_529c7Ei(instructor: Person) kind empirical {
    label en official "the instructor is licensed as a teacher in any State";
}
pub relation instructor_has_taught_at_eligible_educational_institution_529c7Eii(instructor: Person) kind empirical {
    label en official "the instructor has taught at an eligible educational institution";
}
pub relation instructor_subject_matter_expert_529c7Eiii(instructor: Person) kind empirical {
    label en official "the instructor is a subject matter expert in the relevant subject";
}
pub relation instructor_qualified_529c7E(instructor: Person, beneficiary: Person) kind institutional {
    label en official "the tutor or instructor is unrelated to the student and is licensed, has taught at an eligible institution, or is a subject matter expert";
}
@source(us.irc.temporal::PL119_21_S70413, relation = derives_from, quote = "but only if the tutor or instructor is not related to the student and")
rule InstructorQualifiedViaLicense(instructor: Person, beneficiary: Person) defeasible {
    label en official "section 529(c)(7)(E)(i), as amended by Pub. L. 119-21 section 70413";
    effective [@2025-07-04, infinity);
    when instructor_not_related_to_student_529c7E(instructor, beneficiary);
    when instructor_licensed_teacher_in_any_state_529c7Ei(instructor);
    then instructor_qualified_529c7E(instructor, beneficiary);
}
@source(us.irc.temporal::PL119_21_S70413, relation = derives_from, quote = "but only if the tutor or instructor is not related to the student and")
rule InstructorQualifiedViaEligibleInstitutionTeaching(instructor: Person, beneficiary: Person) defeasible {
    label en official "section 529(c)(7)(E)(ii), as amended by Pub. L. 119-21 section 70413";
    effective [@2025-07-04, infinity);
    when instructor_not_related_to_student_529c7E(instructor, beneficiary);
    when instructor_has_taught_at_eligible_educational_institution_529c7Eii(instructor);
    then instructor_qualified_529c7E(instructor, beneficiary);
}
@source(us.irc.temporal::PL119_21_S70413, relation = derives_from, quote = "but only if the tutor or instructor is not related to the student and")
rule InstructorQualifiedViaSubjectMatterExpertise(instructor: Person, beneficiary: Person) defeasible {
    label en official "section 529(c)(7)(E)(iii), as amended by Pub. L. 119-21 section 70413";
    effective [@2025-07-04, infinity);
    when instructor_not_related_to_student_529c7E(instructor, beneficiary);
    when instructor_subject_matter_expert_529c7Eiii(instructor);
    then instructor_qualified_529c7E(instructor, beneficiary);
}
pub relation qualified_tutoring_amount_529c7E(beneficiary: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the tutoring expense of a qualified instructor";
}
@source(us.irc.temporal::PL119_21_S70413, relation = derives_from, quote = "Tuition for tutoring or educational classes outside of the home, including at a tutoring facility")
rule QualifiedTutoringAmount(beneficiary: Person, y: TaxableYear, instructor: Person, amount: Money) defeasible {
    label en official "section 529(c)(7)(E): tutoring counts only when the instructor qualifies";
    effective [@2025-07-04, infinity);
    when tutoring_expense_529c7E(beneficiary, y, instructor, amount);
    when instructor_qualified_529c7E(instructor, beneficiary);
    then qualified_tutoring_amount_529c7E(beneficiary, y, amount);
}
pub relation elementary_secondary_expenses_before_cap_529c7(beneficiary: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the expenses described in section 529(c)(7) for the year: the listed kinds plus qualified tutoring";
}
pub relation has_qualified_tutoring_529c7E(beneficiary: Person, y: TaxableYear, other_kinds: Money) kind institutional {
    label en official "helper: the beneficiary has qualified tutoring expenses (the exception atom that binds every head variable)";
}
@source(us.irc.temporal::PL119_21_S70413, relation = derives_from, quote = "Curriculum and curricular materials.")
rule ElementarySecondaryExpensesWithTutoring(beneficiary: Person, y: TaxableYear, tutoring: Money) defeasible {
    label en official "section 529(c)(7), as amended by Pub. L. 119-21 section 70413: the listed kinds plus qualified tutoring";
    effective [@2025-07-04, infinity);
    when qualified_tutoring_amount_529c7E(beneficiary, y, tutoring);
    then elementary_secondary_expenses_before_cap_529c7(beneficiary, y, tutoring + sum all a: Money for k: ElementaryOrSecondaryExpense529c7 where elementary_or_secondary_expense_529c7(beneficiary, y, k, a));
}
rule HasQualifiedTutoringHelper(beneficiary: Person, y: TaxableYear, tutoring: Money) defeasible {
    label en official "helper";
    when qualified_tutoring_amount_529c7E(beneficiary, y, tutoring);
    then has_qualified_tutoring_529c7E(beneficiary, y, tutoring);
}
@source(us.irc.temporal::PL119_21_S70413, relation = derives_from, quote = "Curriculum and curricular materials.")
rule ElementarySecondaryExpensesWithoutTutoring(beneficiary: Person, y: TaxableYear, kind: ElementaryOrSecondaryExpense529c7, first: Money) defeasible {
    label en official "section 529(c)(7), as amended: the listed kinds when there is no qualified tutoring";
    effective [@2025-07-04, infinity);
    when elementary_or_secondary_expense_529c7(beneficiary, y, kind, first);
    unless has_qualified_tutoring_for_year_529c7E(beneficiary, y, first);
    then elementary_secondary_expenses_before_cap_529c7(beneficiary, y, sum all a: Money for k: ElementaryOrSecondaryExpense529c7 where elementary_or_secondary_expense_529c7(beneficiary, y, k, a));
}
pub relation has_qualified_tutoring_for_year_529c7E(beneficiary: Person, y: TaxableYear, first: Money) kind institutional {
    label en official "helper: qualified tutoring exists for the year (binds the same variables as the rule above)";
}
rule HasQualifiedTutoringForYear(beneficiary: Person, y: TaxableYear, kind: ElementaryOrSecondaryExpense529c7, first: Money, tutoring: Money) defeasible {
    label en official "helper";
    when elementary_or_secondary_expense_529c7(beneficiary, y, kind, first);
    when qualified_tutoring_amount_529c7E(beneficiary, y, tutoring);
    then has_qualified_tutoring_for_year_529c7E(beneficiary, y, first);
}
pub relation elementary_secondary_expenses_qualified_529c7(beneficiary: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the expenses treated as qualified higher education expenses under section 529(c)(7): the listed expenses not above the aggregate cap — $10,000 from enactment through 2025, $20,000 for taxable years beginning after December 31, 2025";
}
@source(us.irc.temporal::PL119_21_S70413, relation = derives_from, quote = "shall apply to distributions made after the date of the enactment of this Act")
rule ElementarySecondaryExpensesQualifiedUnder10000Cap(beneficiary: Person, y: TaxableYear, total: Money) defeasible {
    label en official "section 529(c)(7) and the last sentence of section 529(e)(3): for distributions after enactment and taxable years before 2026, not more than $10,000 (exactly $10,000 stays whole)";
    effective [@2025-07-04, @2026-01-01);
    when elementary_secondary_expenses_before_cap_529c7(beneficiary, y, total);
    then elementary_secondary_expenses_qualified_529c7(beneficiary, y, min(total, 10000.00 USD));
}
@source(us.irc.temporal::PL119_21_S70413, relation = derives_from, quote = "The last sentence of section 529(e)(3) is amended by striking")
rule ElementarySecondaryExpensesQualifiedUnder20000Cap(beneficiary: Person, y: TaxableYear, total: Money) defeasible {
    label en official "section 529(e)(3), last sentence, as amended by Pub. L. 119-21 section 70413(b): $20,000 for taxable years beginning after December 31, 2025";
    effective [@2026-01-01, infinity);
    when elementary_secondary_expenses_before_cap_529c7(beneficiary, y, total);
    then elementary_secondary_expenses_qualified_529c7(beneficiary, y, min(total, 20000.00 USD));
}
@source(us.irc.temporal::PL119_21_S70413, relation = derives_from, quote = "The last sentence of section 529(e)(3) is amended by striking")
rule TuitionOnlyBoundFrom2026(beneficiary: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "stage 2b's section 529(c)(7) tuition rule for taxable years beginning after December 31, 2025: the cap is $20,000";
    effective [@2026-01-01, infinity);
    when qtp_k12_tuition_expenses_529c7(beneficiary, y, amount);
    when amount <= 20000.00 USD;
    then qtp_k12_tuition_qualifies_529c7(beneficiary, y, amount);
}

// ---------------------------------------------------------------------
// Public Law 119-21 section 70414: qualified postsecondary credentialing expenses.
// ---------------------------------------------------------------------

pub enum RecognizedCredentialProgram529f2 { OnStateWorkforceList, OnVeteransWeamsDirectory, ExaminationBasedWithRecognizingOrganization, IdentifiedBySecretary }
pub relation credential_program_basis_529f2(program_id: Text, basis: RecognizedCredentialProgram529f2) kind empirical {
    label en official "the program is included on a State list prepared under section 122(d) of the Workforce Innovation and Opportunity Act (A); listed in the public directory of the Web Enabled Approval Management System of the Veterans Benefits Administration (B); an examination developed or administered by a widely recognized credentialing organization is required to obtain or maintain the credential and that organization recognizes the program as preparing individuals for it (C); or identified by the Secretary, after consultation with the Secretary of Labor, as reputable (D)";
}
pub relation recognized_postsecondary_credential_program_529f2(program_id: Text) kind institutional {
    label en official "the program is a recognized postsecondary credential program";
}
@source(us.irc.temporal::PL119_21_S70414, relation = derives_from, quote = "The term ‘recognized postsecondary credential program’ means any program to obtain a recognized postsecondary credential if—")
rule RecognizedCredentialProgram(program_id: Text, b: RecognizedCredentialProgram529f2) defeasible {
    label en official "section 529(f)(2)(A)-(D), added by Pub. L. 119-21 section 70414";
    effective [@2025-07-04, infinity);
    when credential_program_basis_529f2(program_id, b);
    then recognized_postsecondary_credential_program_529f2(program_id);
}
pub enum ExpenseInRecognizedProgram529f1 { TuitionFeesBooksSuppliesEquipment, OtherExpenseCoveredIfIncurredAtEligibleInstitution, TestingFeesRequiredForCredential, ContinuingEducationFeesRequiredToMaintainCredential }
pub relation credentialing_expense_529f1(beneficiary: Person, program_id: Text, kind: ExpenseInRecognizedProgram529f1, amount: Money) kind empirical {
    label en official "tuition, fees, books, supplies and equipment required for enrollment or attendance in a recognized postsecondary credential program, or any other expense that would be covered under subsection (e)(3)(A) if incurred at an eligible educational institution (A); fees for testing required to obtain or maintain a recognized credential (B); fees for continuing education required to maintain a recognized credential (C)";
}
pub relation qualified_postsecondary_credentialing_expense_529f1(beneficiary: Person, program_id: Text, amount: Money) kind institutional {
    label en official "the amount is a qualified postsecondary credentialing expense, which section 529(e)(3)(C) includes in qualified higher education expenses";
}
@source(us.irc.temporal::PL119_21_S70414, relation = derives_from, quote = "The term ‘qualified postsecondary credentialing expenses’ means—")
rule QualifiedPostsecondaryCredentialingExpense(beneficiary: Person, program_id: Text, k: ExpenseInRecognizedProgram529f1, amount: Money) defeasible {
    label en official "section 529(f)(1)(A)-(C) and (e)(3)(C), added by Pub. L. 119-21 section 70414, for distributions after enactment";
    effective [@2025-07-04, infinity);
    when recognized_postsecondary_credential_program_529f2(program_id);
    when credentialing_expense_529f1(beneficiary, program_id, k, amount);
    then qualified_postsecondary_credentialing_expense_529f1(beneficiary, program_id, amount);
}
pub enum RecognizedCredential529f3 { IndustryRecognizedCredentialIssuedByAccreditedProgram, IndustryRecognizedCredentialInDodCoolDirectory, IndustryRecognizedCredentialIdentifiedBySecretary, RegisteredApprenticeshipCertificate, StateOrFederalOccupationalOrProfessionalLicense, WioaRecognizedCredentialThroughListedProgram }
pub relation credential_basis_529f3(credential: Text, basis: RecognizedCredential529f3) kind empirical {
    label en official "the credential is a postsecondary employment credential that is industry recognized and issued by a program accredited by the Institute for Credentialing Excellence, the National Commission on Certifying Agencies or the American National Standards Institute (A)(i), included in the Department of Defense COOL directory (A)(ii) or identified by the Secretary (A)(iii); a certificate of completion of a registered apprenticeship (B); an occupational or professional license issued or recognized by a State or the Federal Government, or a certification satisfying a condition for obtaining it (C); or a recognized postsecondary credential under section 3(52) of the Workforce Innovation and Opportunity Act provided through a program described in paragraph (2)(A) (D)";
}
pub relation recognized_postsecondary_credential_529f3(credential: Text) kind institutional {
    label en official "the credential is a recognized postsecondary credential";
}
@source(us.irc.temporal::PL119_21_S70414, relation = derives_from, quote = "The term ‘recognized postsecondary credential’ means—")
rule RecognizedCredential(credential: Text, b: RecognizedCredential529f3) defeasible {
    label en official "section 529(f)(3)(A)-(D), added by Pub. L. 119-21 section 70414";
    effective [@2025-07-04, infinity);
    when credential_basis_529f3(credential, b);
    then recognized_postsecondary_credential_529f3(credential);
}

// ---------------------------------------------------------------------
// Public Law 119-21 section 70117: the ABLE rollover of section 529(c)(3)(C)(i)(III).
// ---------------------------------------------------------------------

pub relation qtp_distribution_paid_to_able_account_529c3CiIII(beneficiary: Person, program: Person, able_account_holder: Person, amount: Money, transferred_on: Date) kind empirical {
    label en official "an amount paid or distributed from a qualified tuition program to an ABLE account of the designated beneficiary or a member of the family of the designated beneficiary";
}
pub relation contributions_to_able_account_for_year_529c3CiIII(able_account_holder: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "all other contributions made to the ABLE account for the taxable year";
}
pub relation able_annual_limit_for_rollover_529c3CiIII(y: TaxableYear, limit: Money) kind empirical {
    label en official "the limitation under section 529A(b)(2)(B)(i) for the taxable year";
}
pub relation qtp_to_able_rollover_not_includible_529c3CiIII(beneficiary: Person, program: Person, amount: Money) kind institutional {
    label en official "the rollover to an ABLE account is not includible in gross income, to the extent it does not push the year's contributions above the section 529A(b)(2)(B)(i) limitation";
}
@source(IRC_S529_C, quote = "(III) before January 1, 2026, to an ABLE account (as defined in section 529A(e)(6)) of the designated beneficiary or a member of the family of the designated beneficiary.")
@source(IRC_S529_C, quote = "Subclause (III) shall not apply to so much of a distribution which, when added to all other contributions made to the ABLE account for the taxable year, exceeds the limitation under section 529A(b)(2)(B)(i).")
rule QtpToAbleRolloverBefore2026(beneficiary: Person, program: Person, holder: Person, y: TaxableYear, amount: Money, transferred_on: Date, others: Money, limit: Money) defeasible {
    label en official "section 529(c)(3)(C)(i)(III) as in the 2024 edition: only a rollover made before January 1, 2026, capped so that the year's ABLE contributions stay within the limitation";
    effective [-infinity, @2026-01-01);
    when qtp_distribution_paid_to_able_account_529c3CiIII(beneficiary, program, holder, amount, transferred_on);
    when transferred_on < @2026-01-01;
    when contributions_to_able_account_for_year_529c3CiIII(holder, y, others);
    when able_annual_limit_for_rollover_529c3CiIII(y, limit);
    when others + amount <= limit;
    then qtp_to_able_rollover_not_includible_529c3CiIII(beneficiary, program, amount);
}
@source(us.irc.temporal::PL119_21_S70117, relation = derives_from, quote = "Section 529(c)(3)(C)(i)(III) is amended by striking “before January 1, 2026,”")
rule QtpToAbleRolloverPermanentFrom2026(beneficiary: Person, program: Person, holder: Person, y: TaxableYear, amount: Money, transferred_on: Date, others: Money, limit: Money) defeasible {
    label en official "Pub. L. 119-21 section 70117: for taxable years beginning after December 31, 2025 the ABLE rollover no longer sunsets — the same cap on the year's ABLE contributions";
    effective [@2026-01-01, infinity);
    when qtp_distribution_paid_to_able_account_529c3CiIII(beneficiary, program, holder, amount, transferred_on);
    when contributions_to_able_account_for_year_529c3CiIII(holder, y, others);
    when able_annual_limit_for_rollover_529c3CiIII(y, limit);
    when others + amount <= limit;
    then qtp_to_able_rollover_not_includible_529c3CiIII(beneficiary, program, amount);
}
