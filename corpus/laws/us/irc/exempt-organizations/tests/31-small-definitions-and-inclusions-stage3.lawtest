test "S501N4A-01-STARTUP-CAPITAL-IS-THE-ITEMS-BEFORE-COMMENCEMENT" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": risk_pool_commences_operations_on_501n4A(entity_ref("urn:test:s501n4a01startupcapitalistheitemsbeforec#q"), @2024-01-01) { origin case_input; }
        assert "f1": capital_contributed_to_risk_pool_on_501n4A(entity_ref("urn:test:s501n4a01startupcapitalistheitemsbeforec#q"), "i1", @2023-06-01, 400000.00 USD) { origin case_input; }
        assert "f2": capital_contributed_to_risk_pool_on_501n4A(entity_ref("urn:test:s501n4a01startupcapitalistheitemsbeforec#q"), "i2", @2023-12-31, 250000.00 USD) { origin case_input; }
        assert "f3": capital_contributed_to_risk_pool_on_501n4A(entity_ref("urn:test:s501n4a01startupcapitalistheitemsbeforec#q"), "i3", @2024-01-01, 100000.00 USD) { origin case_input; }
        assert "f4": capital_contributed_to_risk_pool_on_501n4A(entity_ref("urn:test:s501n4a01startupcapitalistheitemsbeforec#q"), "i4", @2024-03-01, 50000.00 USD) { origin case_input; }
    }
    // the item dated on the commencement day is not before it
    evaluate truth(startup_capital_of_risk_pool_501n4A(entity_ref("urn:test:s501n4a01startupcapitalistheitemsbeforec#q"), 650000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

