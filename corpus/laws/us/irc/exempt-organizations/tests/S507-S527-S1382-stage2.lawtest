test "S511-05-CORPORATE-ORGANIZATION-UBIT-AMOUNT-AT-TWENTY-ONE-PERCENT" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; }
        assert "f0": exempt_organization(entity_ref("urn:us:irc:exempt_organizations:clir#O511C"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025")) { origin case_input; }
        assert "f1": unrelated_business_taxable_income(entity_ref("urn:us:irc:exempt_organizations:clir#O511C"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025"), 10000.00 USD) { origin case_input; }
        assert "f2": us.irc.corporations::taxable_income(entity_ref("urn:us:irc:exempt_organizations:clir#O511C"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025"), 0.00 USD) { origin case_input; }
    }
    evaluate truth(ubit_amount(entity_ref("urn:us:irc:exempt_organizations:clir#O511C"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025"), 2100.00 USD));
    expect truth_status == TRUE_ONLY;
}

