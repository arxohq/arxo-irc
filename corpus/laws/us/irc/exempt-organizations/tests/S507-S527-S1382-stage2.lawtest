// Scenarios for section 507 (termination of private foundation status),
// section 527 (political organizations), and Subchapter T section
// 1382/1388 (cooperatives), module 08-termination-political-cooperatives.law.
// Also covers section 511(a)'s rate wiring in
// 06-ubit-511-512-513-514.law (STAGE 2, WIRE-2). Written from the text;
// NOT executed in this stage (owner's NO-HEAVY-CHECKS restriction) —
// `implemented_unverified` per AGENT-BRIEF.md.

language "law.core" version "0.2";
package us.irc.exempt_organizations version "0.1.1";
namespace "urn:us:irc:exempt_organizations:clir";

test "S507-01-VOLUNTARY-TERMINATION-ON-NOTICE" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; }
        assert "f0": section_507a_voluntary_termination_notice_given(entity_ref("urn:us:irc:exempt_organizations:clir#PF1"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025")) { origin case_input; }
    }
    evaluate truth(private_foundation_status_terminated(entity_ref("urn:us:irc:exempt_organizations:clir#PF1"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025")));
    expect truth_status == TRUE_ONLY;
}

test "S507-02-TERMINATION-TAX-LOWER-IS-AGGREGATE-BENEFIT" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; }
        assert "f0": section_507a_voluntary_termination_notice_given(entity_ref("urn:us:irc:exempt_organizations:clir#PF2"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025")) { origin case_input; }
        assert "f1": aggregate_tax_benefit(entity_ref("urn:us:irc:exempt_organizations:clir#PF2"), 40000.00 USD) { origin case_input; }
        assert "f2": net_asset_value_507c(entity_ref("urn:us:irc:exempt_organizations:clir#PF2"), 100000.00 USD) { origin case_input; }
    }
    evaluate truth(termination_tax_507(entity_ref("urn:us:irc:exempt_organizations:clir#PF2"), 40000.00 USD));
    expect truth_status == TRUE_ONLY;
}

