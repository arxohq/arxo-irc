test "S501r-22-FAP-DUTY-ACHIEVED-WHEN-BOTH-POLICIES-ESTABLISHED" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; }
        assert "f0": licensed_as_hospital_by_state(entity_ref("urn:us:irc:exempt_organizations:clir#H22")) { origin case_input; }
        assert "f1": us.irc.core::begins(entity_ref("urn:us:irc:exempt_organizations:clir#Y2025"), @2025-01-01) { origin case_input; }
        assert "f2": us.irc.core::ends(entity_ref("urn:us:irc:exempt_organizations:clir#Y2025"), @2025-12-31) { origin case_input; }
        assert "f3": written_financial_assistance_policy_501r4A(entity_ref("urn:us:irc:exempt_organizations:clir#H22"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025")) { origin case_input; }
        assert "f4": fap_states_eligibility_criteria_and_free_or_discounted_care_501r4Ai(entity_ref("urn:us:irc:exempt_organizations:clir#H22"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025")) { origin case_input; }
        assert "f5": fap_states_basis_for_calculating_charges_501r4Aii(entity_ref("urn:us:irc:exempt_organizations:clir#H22"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025")) { origin case_input; }
        assert "f6": fap_states_method_for_applying_501r4Aiii(entity_ref("urn:us:irc:exempt_organizations:clir#H22"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025")) { origin case_input; }
        assert "f7": fap_includes_widely_publicizing_measures_501r4Av(entity_ref("urn:us:irc:exempt_organizations:clir#H22"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025")) { origin case_input; }
        assert "f8": fap_states_actions_on_nonpayment_501r4Aiv(entity_ref("urn:us:irc:exempt_organizations:clir#H22"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025")) { origin case_input; }
        assert "f9": written_emergency_care_policy_501r4B(entity_ref("urn:us:irc:exempt_organizations:clir#H22"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025")) { origin case_input; }
    }
    evaluate positions(entity_ref("urn:us:irc:exempt_organizations:clir#H22"));
