// Exempt organizations WIRE-10 group D scenarios. NOT EXECUTED (implemented_unverified); no legal review.

language "law.core" version "0.2";
package us.irc.exempt_organizations version "0.1.1";
namespace "urn:us:irc:exempt_organizations:clir";

test "W10-D-EO-01-VOLUNTARY-NOTICE-IMPOSES-THE-507C-TAX" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": section_507a_voluntary_termination_notice_given(entity_ref("urn:test:w10deo:o1#o"), entity_ref("urn:test:w10deo:o1#y")) { origin case_input; }
    }
    evaluate truth(section_507c_tax_imposed(entity_ref("urn:test:w10deo:o1#o"), entity_ref("urn:test:w10deo:o1#y")));
    expect truth_status == TRUE_ONLY;
}

test "W10-D-EO-02-WILLFUL-ACTS-IMPOSE-THE-507C-TAX" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": section_507a_willful_repeated_or_flagrant_act_established(entity_ref("urn:test:w10deo:o2#o"), entity_ref("urn:test:w10deo:o2#y")) { origin case_input; }
    }
    evaluate truth(section_507c_tax_imposed(entity_ref("urn:test:w10deo:o2#o"), entity_ref("urn:test:w10deo:o2#y")));
    expect truth_status == TRUE_ONLY;
}

test "W10-D-EO-03-NO-EVENT-NO-507C-TAX" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": section_507c_tax_paid_or_abated(entity_ref("urn:test:w10deo:o3#o"), entity_ref("urn:test:w10deo:o3#y")) { origin case_input; }
    }
    evaluate truth(section_507c_tax_imposed(entity_ref("urn:test:w10deo:o3#o"), entity_ref("urn:test:w10deo:o3#y")));
    expect truth_status == FALSE_ONLY;
}
