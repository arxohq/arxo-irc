            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": multi_property_election_made_512b19Hi(entity_ref("urn:test:s512b19i01recaptureintheyearofthefailure#o")) { origin case_input; }
        assert "f1": property_fails_requirements_of_paragraph_19_in_year_512b19I(entity_ref("urn:test:s512b19i01recaptureintheyearofthefailure#o"), "a1", entity_ref("urn:test:s512b19i01recaptureintheyearofthefailure#Y1")) { origin case_input; }
        assert "f2": previously_excluded_brownfield_gain_or_loss_allocable_to_taxpayer_512b19I(entity_ref("urn:test:s512b19i01recaptureintheyearofthefailure#o"), "a1", 120000.00 USD) { origin case_input; }
    }
    evaluate truth(brownfield_recapture_included_in_ubti_512b19I(entity_ref("urn:test:s512b19i01recaptureintheyearofthefailure#o"), entity_ref("urn:test:s512b19i01recaptureintheyearofthefailure#Y1"), 120000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S512B19I-02-NO-ELECTION-NO-RECAPTURE" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": property_fails_requirements_of_paragraph_19_in_year_512b19I(entity_ref("urn:test:s512b19i02noelectionnorecapture#o"), "a1", entity_ref("urn:test:s512b19i02noelectionnorecapture#Y1")) { origin case_input; }
        assert "f1": previously_excluded_brownfield_gain_or_loss_allocable_to_taxpayer_512b19I(entity_ref("urn:test:s512b19i02noelectionnorecapture#o"), "a1", 120000.00 USD) { origin case_input; }
    }
    // the recapture is for property to which an election under (H) applies
    evaluate truth(brownfield_recapture_included_in_ubti_512b19I(entity_ref("urn:test:s512b19i02noelectionnorecapture#o"), entity_ref("urn:test:s512b19i02noelectionnorecapture#Y1"), 120000.00 USD));
    expect truth_status == NEITHER;
}
