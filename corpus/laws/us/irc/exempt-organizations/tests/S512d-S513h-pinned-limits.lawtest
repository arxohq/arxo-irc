        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; }
        assert "f0": aggregate_cost_of_articles_to_single_distributee_513h2B(entity_ref("urn:us:irc:exempt_organizations:clir#CH1"), entity_ref("urn:us:irc:exempt_organizations:clir#DI1"), 2026, 13.90 USD) { origin case_input; }
        assert "f1": us.irc.core::calendar_year_of(entity_ref("urn:us:irc:exempt_organizations:clir#Y2026"), 2026) { origin case_input; }
    }
    evaluate truth(aggregate_article_cost_within_limit_513h2(entity_ref("urn:us:irc:exempt_organizations:clir#CH1"), entity_ref("urn:us:irc:exempt_organizations:clir#DI1"), 2026, entity_ref("urn:us:irc:exempt_organizations:clir#Y2026")));
    expect truth_status == TRUE_ONLY;
}

