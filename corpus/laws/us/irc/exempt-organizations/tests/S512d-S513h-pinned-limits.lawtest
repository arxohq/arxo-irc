// Scenarios for the pinned-parameter readings of section 512(d)(1) (DuesLimit512d1) and section 513(h)(2)(A) (LowCostArticleLimit513h2).
// Written from the text, NOT executed (implemented_unverified). legal_time selects the pinned value.

language "law.core" version "0.2";
package us.irc.exempt_organizations version "0.1.1";
namespace "urn:us:irc:exempt_organizations:clir";

test "S512d1P-01-DUES-EQUAL-TO-PINNED-2026-LIMIT" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; }
        assert "f0": c5_agricultural_or_horticultural_organization_requiring_annual_dues_512d1A(entity_ref("urn:us:irc:exempt_organizations:clir#AG1"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2026")) { origin case_input; }
        assert "f1": required_annual_dues_amount_512d1B(entity_ref("urn:us:irc:exempt_organizations:clir#AG1"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2026"), 212.00 USD) { origin case_input; }
    }
    evaluate truth(member_dues_not_unrelated_trade_or_business_income_512d1(entity_ref("urn:us:irc:exempt_organizations:clir#AG1"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2026")));
    expect truth_status == TRUE_ONLY;
}

