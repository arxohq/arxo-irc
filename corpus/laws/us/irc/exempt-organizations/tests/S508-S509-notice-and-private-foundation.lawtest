// Scenarios for sections 508 and 509, modules 04-notice-508.law and
// 05-private-foundation-509.law. `implemented_unverified` per AGENT-BRIEF.md.

language "law.core" version "0.2";
package us.irc.exempt_organizations version "0.1.1";
namespace "urn:us:irc:exempt_organizations:clir";

test "S509-01-PUBLIC-SUPPORT-JUST-ABOVE-ONE-THIRD" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; }
        assert "f0": aggregate_gifts_grants_and_membership_fees(entity_ref("urn:us:irc:exempt_organizations:clir#O10"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025"), 34.01 USD) { origin case_input; }
        assert "f1": aggregate_qualifying_admissions_and_sales_receipts(entity_ref("urn:us:irc:exempt_organizations:clir#O10"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025"), 0.00 USD) { origin case_input; }
        assert "f2": section_509a2a_source_restriction_applied(entity_ref("urn:us:irc:exempt_organizations:clir#O10"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025")) { origin case_input; }
        assert "f3": aggregate_total_support(entity_ref("urn:us:irc:exempt_organizations:clir#O10"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025"), 100.00 USD) { origin case_input; }
    }
    evaluate truth(meets_509a2A_more_than_one_third_support(entity_ref("urn:us:irc:exempt_organizations:clir#O10"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025")));
    expect truth_status == TRUE_ONLY;
}

test "S509-02-PUBLIC-SUPPORT-EXACTLY-ONE-THIRD-FAILS-MORE-THAN-TEST" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; }
        assert "f0": aggregate_gifts_grants_and_membership_fees(entity_ref("urn:us:irc:exempt_organizations:clir#O11"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025"), 100.00 USD) { origin case_input; }
        assert "f1": aggregate_qualifying_admissions_and_sales_receipts(entity_ref("urn:us:irc:exempt_organizations:clir#O11"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025"), 0.00 USD) { origin case_input; }
        assert "f2": section_509a2a_source_restriction_applied(entity_ref("urn:us:irc:exempt_organizations:clir#O11"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025")) { origin case_input; }
        assert "f3": aggregate_total_support(entity_ref("urn:us:irc:exempt_organizations:clir#O11"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025"), 300.00 USD) { origin case_input; }
    }
    evaluate truth(meets_509a2A_more_than_one_third_support(entity_ref("urn:us:irc:exempt_organizations:clir#O11"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025")));
    expect truth_status == NEITHER;
}

test "S509-03-INVESTMENT-INCOME-CEILING-EXACTLY-ONE-THIRD-SATISFIES" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; }
        assert "f0": aggregate_gross_investment_income_509e(entity_ref("urn:us:irc:exempt_organizations:clir#O12"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025"), 100.00 USD) { origin case_input; }
        assert "f1": aggregate_ubti_excess_over_511_tax(entity_ref("urn:us:irc:exempt_organizations:clir#O12"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025"), 0.00 USD) { origin case_input; }
        assert "f2": aggregate_total_support(entity_ref("urn:us:irc:exempt_organizations:clir#O12"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025"), 300.00 USD) { origin case_input; }
    }
    evaluate truth(meets_509a2B_not_more_than_one_third_investment(entity_ref("urn:us:irc:exempt_organizations:clir#O12"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025")));
    expect truth_status == TRUE_ONLY;
}

test "S508-01-NOTICE-GIVEN-ON-TIME-SATISFIES-REQUIREMENT" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; }
        assert "f0": organized_after_1969_10_09(entity_ref("urn:us:irc:exempt_organizations:clir#O13")) { origin case_input; }
        assert "f1": section_508a_notice_given(entity_ref("urn:us:irc:exempt_organizations:clir#O13"), @2025-03-15) { origin case_input; }
        assert "f2": section_508a_notice_deadline(entity_ref("urn:us:irc:exempt_organizations:clir#O13"), @2025-04-15) { origin adjudicated; }
    }
    evaluate truth(section_508_notice_requirement_satisfied(entity_ref("urn:us:irc:exempt_organizations:clir#O13")));
    expect truth_status == TRUE_ONLY;
}

