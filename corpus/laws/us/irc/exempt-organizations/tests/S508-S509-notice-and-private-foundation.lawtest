test "S508-04-SMALL-GROSS-RECEIPTS-EXCEPTION" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; }
        assert "f0": organized_after_1969_10_09(entity_ref("urn:us:irc:exempt_organizations:clir#O16")) { origin case_input; }
        assert "f1": gross_receipts_normally_not_more_than_5000(entity_ref("urn:us:irc:exempt_organizations:clir#O16")) { origin case_input; }
        assert "f2": organized_and_operated_exclusively_for_testing_for_public_safety(entity_ref("urn:us:irc:exempt_organizations:clir#O16")) { origin case_input; }
        assert "f3": us.irc.core::year_of(entity_ref("urn:us:irc:exempt_organizations:clir#O16"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025")) { origin case_input; }
    }
    evaluate truth(section_508_notice_requirement_satisfied(entity_ref("urn:us:irc:exempt_organizations:clir#O16")));
    expect truth_status == TRUE_ONLY;
}

