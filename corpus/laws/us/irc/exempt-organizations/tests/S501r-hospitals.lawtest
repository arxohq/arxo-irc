// Scenarios for section 501(r), module 03-hospitals-501r.law.
// `implemented_unverified` per AGENT-BRIEF.md.

language "law.core" version "0.2";
package us.irc.exempt_organizations version "0.1.1";
namespace "urn:us:irc:exempt_organizations:clir";

test "S501r-01-CHNA-CONDUCTED-IN-CURRENT-YEAR-SATISFIES" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; }
        assert "f0": licensed_as_hospital_by_state(entity_ref("urn:us:irc:exempt_organizations:clir#H1")) { origin case_input; }
        assert "f1": us.irc.core::calendar_year_of(entity_ref("urn:us:irc:exempt_organizations:clir#Y2025"), 2025) { origin case_input; }
        assert "f2": chna_takes_into_account_broad_community_input(entity_ref("urn:us:irc:exempt_organizations:clir#H1"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025")) { origin case_input; }
        assert "f3": chna_made_widely_available(entity_ref("urn:us:irc:exempt_organizations:clir#H1"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025")) { origin case_input; }
        assert "f4": chna_implementation_strategy_adopted(entity_ref("urn:us:irc:exempt_organizations:clir#H1"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025")) { origin case_input; }
    }
    evaluate truth(chna_requirement_satisfied_for_year(entity_ref("urn:us:irc:exempt_organizations:clir#H1"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025")));
    expect truth_status == TRUE_ONLY;
}

test "S501r-02-CHNA-CONDUCTED-TWO-YEARS-EARLIER-STILL-SATISFIES" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; }
        assert "f0": licensed_as_hospital_by_state(entity_ref("urn:us:irc:exempt_organizations:clir#H2")) { origin case_input; }
        assert "f1": us.irc.core::calendar_year_of(entity_ref("urn:us:irc:exempt_organizations:clir#Y2025"), 2025) { origin case_input; }
        assert "f2": us.irc.core::calendar_year_of(entity_ref("urn:us:irc:exempt_organizations:clir#Y2023"), 2023) { origin case_input; }
        assert "f3": chna_takes_into_account_broad_community_input(entity_ref("urn:us:irc:exempt_organizations:clir#H2"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2023")) { origin case_input; }
        assert "f4": chna_made_widely_available(entity_ref("urn:us:irc:exempt_organizations:clir#H2"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2023")) { origin case_input; }
        assert "f5": chna_implementation_strategy_adopted(entity_ref("urn:us:irc:exempt_organizations:clir#H2"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2023")) { origin case_input; }
    }
    evaluate truth(chna_requirement_satisfied_for_year(entity_ref("urn:us:irc:exempt_organizations:clir#H2"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025")));
    expect truth_status == TRUE_ONLY;
}

test "S501r-03-CHNA-CONDUCTED-THREE-YEARS-EARLIER-OUTSIDE-WINDOW" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; }
        assert "f0": licensed_as_hospital_by_state(entity_ref("urn:us:irc:exempt_organizations:clir#H3")) { origin case_input; }
        assert "f1": us.irc.core::calendar_year_of(entity_ref("urn:us:irc:exempt_organizations:clir#Y2025"), 2025) { origin case_input; }
        assert "f2": us.irc.core::calendar_year_of(entity_ref("urn:us:irc:exempt_organizations:clir#Y2022"), 2022) { origin case_input; }
        assert "f3": chna_takes_into_account_broad_community_input(entity_ref("urn:us:irc:exempt_organizations:clir#H3"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2022")) { origin case_input; }
        assert "f4": chna_made_widely_available(entity_ref("urn:us:irc:exempt_organizations:clir#H3"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2022")) { origin case_input; }
        assert "f5": chna_implementation_strategy_adopted(entity_ref("urn:us:irc:exempt_organizations:clir#H3"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2022")) { origin case_input; }
    }
    evaluate truth(chna_requirement_satisfied_for_year(entity_ref("urn:us:irc:exempt_organizations:clir#H3"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025")));
    expect truth_status == NEITHER;
}

test "S501r-04-NO-CHNA-DENIES-C3-TREATMENT-FOR-HOSPITAL" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; }
        assert "f0": licensed_as_hospital_by_state(entity_ref("urn:us:irc:exempt_organizations:clir#H4")) { origin case_input; }
        assert "f1": us.irc.core::year_of(entity_ref("urn:us:irc:exempt_organizations:clir#H4"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025")) { origin case_input; }
        assert "f2": Section501c3OrganizedExclusively(entity_ref("urn:us:irc:exempt_organizations:clir#H4")) { origin adjudicated; }
        assert "f3": Section501c3OperatedExclusively(entity_ref("urn:us:irc:exempt_organizations:clir#H4")) { origin adjudicated; }
        assert "f4": us.irc.core::begins(entity_ref("urn:us:irc:exempt_organizations:clir#Y2025"), @2025-01-01) { origin case_input; }
        assert "f5": us.irc.core::ends(entity_ref("urn:us:irc:exempt_organizations:clir#Y2025"), @2025-12-31) { origin case_input; }
    }
    evaluate truth(section_501c3(entity_ref("urn:us:irc:exempt_organizations:clir#H4"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025")));
    expect truth_status == NEITHER;
}
