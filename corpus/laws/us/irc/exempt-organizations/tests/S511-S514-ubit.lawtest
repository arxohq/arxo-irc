test "S512-01-SINGLE-BUSINESS-UBTI-AFTER-SPECIFIC-DEDUCTION" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; }
        assert "f0": activity_is_trade_or_business(entity_ref("urn:us:irc:exempt_organizations:clir#TB3"), entity_ref("urn:us:irc:exempt_organizations:clir#O22")) { origin case_input; }
        assert "f1": us.irc.core::year_of(entity_ref("urn:us:irc:exempt_organizations:clir#O22"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025")) { origin case_input; }
        assert "f2": not SubstantiallyRelatedToExemptPurpose(entity_ref("urn:us:irc:exempt_organizations:clir#TB3"), entity_ref("urn:us:irc:exempt_organizations:clir#O22"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025")) { origin adjudicated; }
        assert "f3": gross_income_from_business(entity_ref("urn:us:irc:exempt_organizations:clir#TB3"), entity_ref("urn:us:irc:exempt_organizations:clir#O22"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025"), 10000.00 USD) { origin case_input; }
        assert "f4": directly_connected_deductions(entity_ref("urn:us:irc:exempt_organizations:clir#TB3"), entity_ref("urn:us:irc:exempt_organizations:clir#O22"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025"), 3000.00 USD) { origin case_input; }
    }
    evaluate truth(unrelated_business_taxable_income(entity_ref("urn:us:irc:exempt_organizations:clir#O22"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025"), 6000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S512-02-TWO-BUSINESSES-NO-NETTING-ACROSS-SILOS" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; }
        assert "f0": activity_is_trade_or_business(entity_ref("urn:us:irc:exempt_organizations:clir#TB4"), entity_ref("urn:us:irc:exempt_organizations:clir#O23")) { origin case_input; }
        assert "f1": activity_is_trade_or_business(entity_ref("urn:us:irc:exempt_organizations:clir#TB5"), entity_ref("urn:us:irc:exempt_organizations:clir#O23")) { origin case_input; }
        assert "f2": us.irc.core::year_of(entity_ref("urn:us:irc:exempt_organizations:clir#O23"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025")) { origin case_input; }
        assert "f3": not SubstantiallyRelatedToExemptPurpose(entity_ref("urn:us:irc:exempt_organizations:clir#TB4"), entity_ref("urn:us:irc:exempt_organizations:clir#O23"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025")) { origin adjudicated; }
        assert "f4": not SubstantiallyRelatedToExemptPurpose(entity_ref("urn:us:irc:exempt_organizations:clir#TB5"), entity_ref("urn:us:irc:exempt_organizations:clir#O23"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025")) { origin adjudicated; }
        assert "f5": gross_income_from_business(entity_ref("urn:us:irc:exempt_organizations:clir#TB4"), entity_ref("urn:us:irc:exempt_organizations:clir#O23"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025"), 10000.00 USD) { origin case_input; }
        assert "f6": directly_connected_deductions(entity_ref("urn:us:irc:exempt_organizations:clir#TB4"), entity_ref("urn:us:irc:exempt_organizations:clir#O23"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025"), 3000.00 USD) { origin case_input; }
        assert "f7": gross_income_from_business(entity_ref("urn:us:irc:exempt_organizations:clir#TB5"), entity_ref("urn:us:irc:exempt_organizations:clir#O23"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025"), 1000.00 USD) { origin case_input; }
        assert "f8": directly_connected_deductions(entity_ref("urn:us:irc:exempt_organizations:clir#TB5"), entity_ref("urn:us:irc:exempt_organizations:clir#O23"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025"), 5000.00 USD) { origin case_input; }
    }
    evaluate truth(unrelated_business_taxable_income(entity_ref("urn:us:irc:exempt_organizations:clir#O23"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025"), 6000.00 USD));
    expect truth_status == TRUE_ONLY;
}

