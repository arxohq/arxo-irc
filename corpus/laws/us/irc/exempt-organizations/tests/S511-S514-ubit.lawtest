        assert "f1": adjusted_basis_average(entity_ref("urn:us:irc:exempt_organizations:clir#TB6"), entity_ref("urn:us:irc:exempt_organizations:clir#O24"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025"), 200000.00 USD) { origin case_input; }
        assert "f2": total_gross_income_from_property(entity_ref("urn:us:irc:exempt_organizations:clir#TB6"), entity_ref("urn:us:irc:exempt_organizations:clir#O24"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025"), 40000.00 USD) { origin case_input; }
    }
    evaluate truth(debt_financed_income_514a1(entity_ref("urn:us:irc:exempt_organizations:clir#TB6"), entity_ref("urn:us:irc:exempt_organizations:clir#O24"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025"), 10000.00 USD));
    expect truth_status == TRUE_ONLY;
