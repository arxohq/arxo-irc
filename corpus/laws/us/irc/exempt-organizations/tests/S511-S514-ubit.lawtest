// Scenarios for sections 511-514, module 06-ubit-511-512-513-514.law.
// `implemented_unverified` per AGENT-BRIEF.md.

language "law.core" version "0.2";
package us.irc.exempt_organizations version "0.1.1";
namespace "urn:us:irc:exempt_organizations:clir";

test "S513-01-UNRELATED-TRADE-OR-BUSINESS-NOT-SUBSTANTIALLY-RELATED" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; }
        assert "f0": activity_is_trade_or_business(entity_ref("urn:us:irc:exempt_organizations:clir#TB1"), entity_ref("urn:us:irc:exempt_organizations:clir#O20")) { origin case_input; }
        assert "f1": us.irc.core::year_of(entity_ref("urn:us:irc:exempt_organizations:clir#O20"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025")) { origin case_input; }
    }
    evaluate truth(unrelated_trade_or_business(entity_ref("urn:us:irc:exempt_organizations:clir#TB1"), entity_ref("urn:us:irc:exempt_organizations:clir#O20"), entity_ref("urn:us:irc:exempt_organizations:clir#Y2025")));
    expect truth_status == NEITHER;
    expect evaluation_status == REQUIRES_JUDGMENT;
}

