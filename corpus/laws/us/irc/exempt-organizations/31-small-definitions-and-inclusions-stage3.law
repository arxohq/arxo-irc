// Stage 3: small definitions and inclusion rules that modules 17-28 carried only through a neighbouring rule (audit of the
// text-order links, TECH-GAPS G6002). Each rule is an alternative or a missing piece next to the rules it names; the
// aggregate facts of the earlier modules stay valid inputs.

// --- section 1385(a)(2), (3): the other inclusions of a patron ---

use self::{
    Asset,
    IRC_S1385_A,
    IRC_S1388_J,
    IRC_S501_N,
    IRC_S507_D,
    IRC_S513_D,
    IRC_S514_C,
    IRC_S521_B,
    IRC_S527_J,
    IRC_S529_C,
    Person,
    TaxableYear,
};

pub relation nonpatronage_distribution_received_1385a2(patron: Person, coop: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1385(a)(2): an amount described in section 1382(c)(2)(A) (certain nonpatronage distributions by tax-exempt farmers' cooperatives) paid in money, a qualified written notice of allocation or other property (except a nonqualified written notice), received by the patron from an organization described in section 1381(a)(1) during the taxable year";
}
pub relation patron_includes_nonpatronage_distribution_1385a2(patron: Person, coop: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1385(a)(2): the patron includes the amount in gross income";
}
@source(IRC_S1385_A, quote = "(2) any amount, described in section 1382 (c)(2)(A) (relating to certain nonpatronage distributions by tax-exempt farmers' cooperatives), which is paid in money, a qualified written notice of allocation, or other property (except a nonqualified written notice of allocation), and which is received by him during the taxable year from an organization described in section 1381(a)(1), and")
rule PatronIncludesNonpatronageDistribution1385a2(patron: Person, coop: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 1385(a)(2)";
    when nonpatronage_distribution_received_1385a2(patron, coop, y, amount);
    then patron_includes_nonpatronage_distribution_1385a2(patron, coop, y, amount);
}
pub relation per_unit_retain_allocation_paid_in_qualified_certificates_received_1385a3(patron: Person, coop: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 1385(a)(3): the amount of a per-unit retain allocation paid in qualified per-unit retain certificates and received by the patron during the taxable year from an organization described in section 1381(a)";
}
pub relation patron_includes_per_unit_retain_allocation_1385a3(patron: Person, coop: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1385(a)(3): the patron includes the amount in gross income";
}
@source(IRC_S1385_A, quote = "(3) the amount of any per-unit retain allocation which is paid in qualified per-unit retain certificates and which is received by him during the taxable year from an organization described in section 1381(a).")
rule PatronIncludesPerUnitRetainAllocation1385a3(patron: Person, coop: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 1385(a)(3)";
    when per_unit_retain_allocation_paid_in_qualified_certificates_received_1385a3(patron, coop, y, amount);
    then patron_includes_per_unit_retain_allocation_1385a3(patron, coop, y, amount);
}

// --- section 1388(j)(4): patronage earnings and losses ---

pub relation earnings_or_losses_derived_from_business_done_with_or_for_patrons_1388j4(coop: Person, item: Text) kind empirical {
    label en official "section 1388(j)(4): earnings (or losses) derived from business done with or for patrons of the organization";
}
pub relation patronage_earnings_or_losses_1388j4(coop: Person, item: Text) kind institutional {
    label en official "section 1388(j)(4): the item is a patronage earning or patronage loss for the subsection";
}
@source(IRC_S1388_J, quote = "For purposes of this subsection, the terms \"patronage earnings\" and \"patronage losses\" means [1] earnings and losses, respectively, which are derived from business done with or for patrons of the organization.")
rule PatronageEarningsOrLosses1388j4(coop: Person, item: Text) defeasible {
    label en official "section 1388(j)(4)";
    when earnings_or_losses_derived_from_business_done_with_or_for_patrons_1388j4(coop, item);
    then patronage_earnings_or_losses_1388j4(coop, item);
}

// --- section 501(n)(4)(A): startup capital of a risk pool ---

pub relation risk_pool_commences_operations_on_501n4A(pool: Person, on: Date) kind empirical {
    label en official "section 501(n)(4)(A): the date the risk pool commences operations";
}
pub relation capital_contributed_to_risk_pool_on_501n4A(pool: Person, item: Text, on: Date, amount: Money) kind empirical {
    label en official "section 501(n)(4)(A): capital contributed to the risk pool, or a program-related investment (within the meaning of section 4944(c)) made in it, on the date";
}
pub relation startup_capital_of_risk_pool_501n4A(pool: Person, amount: Money) kind institutional {
    label en official "section 501(n)(4)(A): the startup capital: all capital contributed and program-related investments made before the pool commences operations (a sum over the recorded items; the commencement date itself is not before it)";
}
@source(IRC_S501_N, quote = "The term \"startup capital\" means any capital contributed to, and any program-related investments (within the meaning of section 4944(c)) made in, the risk pool before such pool commences operations.")
rule StartupCapitalOfRiskPool501n4A(pool: Person, commenced: Date) defeasible {
    label en official "section 501(n)(4)(A): the sum of the items dated before the commencement";
    when risk_pool_commences_operations_on_501n4A(pool, commenced);
    then startup_capital_of_risk_pool_501n4A(pool, sum(collect all a: Money, i: Text, d: Date where capital_contributed_to_risk_pool_on_501n4A(pool, i, d, a) and d < commenced, empty: 0.00 USD));
}

// --- section 507(d)(2)(B)(i), (iii): valuation and spouse attribution of contributions ---

pub relation spouse_of_507d2Biii(person: Person, spouse: Person) kind empirical {
    label en official "section 507(d)(2)(B)(iii): the person is the spouse of the individual";
}
pub relation contribution_or_bequest_fair_market_value_at_receipt_507d2Bi(person: Person, foundation: Person, item: Text, amount: Money) kind empirical {
    label en official "section 507(d)(2)(B)(i): a contribution or bequest made by the person, valued at fair market value on the date it was received";
}
pub relation contributions_treated_as_made_by_individual_507d2Biii(person: Person, foundation: Person, amount: Money) kind institutional {
    label en official "section 507(d)(2)(B)(i), (iii): the individual's own contributions and bequests, valued at fair market value on receipt, plus all those made by his spouse. JUDGMENT CALL: the foundation-side total and the (A) threshold are read by the section 507(d)(2)(A) rule of module 22 from its own asserted amount, not from this sum";
}
@source(IRC_S507_D, quote = "(iii) an individual shall be treated as making all contributions and bequests made by his spouse, and")
rule ContributionsTreatedAsMadeByIndividual507d2Biii(person: Person, foundation: Person) defeasible {
    label en official "section 507(d)(2)(B)(i), (iii): own items plus the spouse's items";
    when contribution_or_bequest_fair_market_value_at_receipt_507d2Bi(person, foundation, _, _);
    then contributions_treated_as_made_by_individual_507d2Biii(person, foundation, sum(collect all a: Money, i: Text where contribution_or_bequest_fair_market_value_at_receipt_507d2Bi(person, foundation, i, a), empty: 0.00 USD) + sum(collect all b: Money, s: Person, j: Text where spouse_of_507d2Biii(person, s) and contribution_or_bequest_fair_market_value_at_receipt_507d2Bi(s, foundation, j, b), empty: 0.00 USD));
}

// --- section 512(b)(5)(A), (B): property that stays in the gain and loss rule ---

pub relation property_of_a_kind_includible_in_inventory_512b5A(o: Person, asset: Asset) kind empirical {
    label en official "section 512(b)(5)(A): stock in trade or other property of a kind which would properly be includible in inventory if on hand at the close of the taxable year";
}
pub relation property_held_primarily_for_sale_to_customers_512b5B(o: Person, asset: Asset) kind empirical {
    label en official "section 512(b)(5)(B): property held primarily for sale to customers in the ordinary course of the trade or business";
}
pub relation property_not_covered_by_the_512b5_exclusion_512b5(o: Person, asset: Asset) kind institutional {
    label en official "section 512(b)(5)(A)-(B): the property is inventory-type or dealer property, so its gain or loss is not excluded by paragraph (5)";
}
rule PropertyNotCoveredByExclusionViaInventory512b5A(o: Person, asset: Asset) defeasible {
    label en official "section 512(b)(5)(A)";
    when property_of_a_kind_includible_in_inventory_512b5A(o, asset);
    then property_not_covered_by_the_512b5_exclusion_512b5(o, asset);
}
rule PropertyNotCoveredByExclusionViaDealerProperty512b5B(o: Person, asset: Asset) defeasible {
    label en official "section 512(b)(5)(B)";
    when property_held_primarily_for_sale_to_customers_512b5B(o, asset);
    then property_not_covered_by_the_512b5_exclusion_512b5(o, asset);
}

// --- section 513(d)(2)(C): qualifying organization for the fair or exposition rule ---

pub relation organization_described_in_501c3_c4_or_c5_513d2C(o: Person) kind empirical {
    label en official "section 513(d)(2)(C): the organization is described in section 501(c)(3), (4) or (5)";
}
pub relation regularly_conducts_agricultural_and_educational_fair_as_substantial_exempt_purpose_513d2C(o: Person) kind empirical {
    label en official "section 513(d)(2)(C): the organization regularly conducts, as one of its substantial exempt purposes, an agricultural and educational fair or exposition";
}
pub relation qualifying_organization_for_fair_or_exposition_513d2C(o: Person) kind institutional {
    label en official "section 513(d)(2)(C): a qualifying organization";
}
@source(IRC_S513_D, quote = "For purposes of this paragraph, the term \"qualifying organization\" means an organization which is described in section 501(c) (3), (4), or (5) which regularly conducts, as one of its substantial exempt purposes, an agricultural and educational fair or exposition.")
rule QualifyingOrganizationForFair513d2C(o: Person) defeasible {
    label en official "section 513(d)(2)(C)";
    when organization_described_in_501c3_c4_or_c5_513d2C(o);
    when regularly_conducts_agricultural_and_educational_fair_as_substantial_exempt_purpose_513d2C(o);
    then qualifying_organization_for_fair_or_exposition_513d2C(o);
}

// --- section 514(c)(9)(H)(iii)(I), (II): property of a qualifying sale by a financial institution ---

pub relation property_acquired_from_institution_in_conservatorship_or_its_conservator_514c9HiiiI(asset_id: Text) kind empirical {
    label en official "section 514(c)(9)(H)(iii)(I): the property was acquired by the qualified organization from a financial institution which is in conservatorship or receivership, or from the conservator or receiver of such an institution";
}
pub relation property_held_by_institution_when_it_entered_conservatorship_514c9HiiiII(asset_id: Text) kind empirical {
    label en official "section 514(c)(9)(H)(iii)(II): the property was held by the financial institution at the time it entered into conservatorship or receivership";
}
pub relation property_described_in_514c9Hiii(asset_id: Text) kind institutional {
    label en official "section 514(c)(9)(H)(iii): property described in clause (iii), for the qualifying-sale rule of clause (ii)";
}
@source(IRC_S514_C, quote = "(II) was held by the financial institution at the time it entered into conservatorship or receivership.")
rule PropertyDescribedIn514c9Hiii(asset_id: Text) defeasible {
    label en official "section 514(c)(9)(H)(iii)(I)-(II)";
    when property_acquired_from_institution_in_conservatorship_or_its_conservator_514c9HiiiI(asset_id);
    when property_held_by_institution_when_it_entered_conservatorship_514c9HiiiII(asset_id);
    then property_described_in_514c9Hiii(asset_id);
}

// --- section 521(b)(3): reserves ---

pub relation reserve_required_by_state_law_or_reasonable_for_necessary_purpose_521b3(o: Person) kind empirical {
    label en official "section 521(b)(3): the association accumulates and maintains a reserve required by State law or a reasonable reserve for any necessary purpose";
}
pub relation reserve_does_not_deny_exemption_521b3(o: Person) kind institutional {
    label en official "section 521(b)(3): exemption is not denied because of the reserve";
}
@source(IRC_S521_B, quote = "Exemption shall not be denied any such association because there is accumulated and maintained by it a reserve required by State law or a reasonable reserve for any necessary purpose.")
rule ReserveDoesNotDenyExemption521b3(o: Person) defeasible {
    label en official "section 521(b)(3)";
    when reserve_required_by_state_law_or_reasonable_for_necessary_purpose_521b3(o);
    then reserve_does_not_deny_exemption_521b3(o);
}

// --- section 527(j)(5)(F): independent expenditures ---

pub relation expenditure_is_independent_expenditure_under_feca_301_527j5F(o: Person, item: Text) kind empirical {
    label en official "section 527(j)(5)(F): the expenditure is an independent expenditure (as defined in section 301 of the Federal Election Campaign Act of 1971)";
}
pub relation expenditure_exempt_from_subsection_j_527j5F(o: Person, item: Text) kind institutional {
    label en official "section 527(j)(5)(F): subsection (j) does not apply with respect to the expenditure";
}
@source(IRC_S527_J, quote = "(F) with respect to any expenditure which is an independent expenditure (as defined in section 301 of such Act).")
rule ExpenditureExemptFromSubsectionJ527j5F(o: Person, item: Text) defeasible {
    label en official "section 527(j)(5)(F)";
    when expenditure_is_independent_expenditure_under_feca_301_527j5F(o, item);
    then expenditure_exempt_from_subsection_j_527j5F(o, item);
}

// --- section 529(c)(3)(B)(i), (iii), (iv); (c)(5)(A) ---

pub relation distribution_consists_of_a_benefit_that_would_be_a_qualified_expense_529c3Bi(distribution: Text) kind empirical {
    label en official "section 529(c)(3)(B)(i): the distribution consists of providing a benefit to the distributee which, if paid for by the distributee, would constitute payment of a qualified higher education expense";
}
pub relation distribution_of_institution_program_in_year_beginning_before_2004_529c3Biii(distribution: Text, year_begins: Date) kind empirical {
    label en official "section 529(c)(3)(B)(iii): a distribution during a taxable year under a qualified tuition program established and maintained by one or more eligible educational institutions, in the taxable year beginning on the date";
}
pub relation benefit_furnished_to_designated_beneficiary_529c3Biv(benefit: Text) kind empirical {
    label en official "section 529(c)(3)(B)(iv): a benefit furnished to a designated beneficiary under a qualified tuition program";
}
pub relation benefit_treated_as_distribution_529c3Biv(benefit: Text) kind institutional {
    label en official "section 529(c)(3)(B)(iv): the benefit is treated as a distribution to the beneficiary for the paragraph";
}
pub relation benefit_distribution_not_includible_under_529c3A_529c3Bi(distribution: Text) kind institutional {
    label en official "section 529(c)(3)(B)(i): no amount is includible under subparagraph (A) by reason of the distribution of a benefit";
}
@source(IRC_S529_C, quote = "No amount shall be includible in gross income under subparagraph (A) by reason of a distribution which consists of providing a benefit to the distributee which, if paid for by the distributee, would constitute payment of a qualified higher education expense.")
rule BenefitDistributionNotIncludible529c3Bi(distribution: Text) defeasible {
    label en official "section 529(c)(3)(B)(i), except for a pre-2004 institution program distribution (clause (iii))";
    when distribution_consists_of_a_benefit_that_would_be_a_qualified_expense_529c3Bi(distribution);
    when not_known(clauses_i_and_ii_do_not_apply_529c3Biii(distribution));
    then benefit_distribution_not_includible_under_529c3A_529c3Bi(distribution);
}
pub relation clauses_i_and_ii_do_not_apply_529c3Biii(distribution: Text) kind institutional {
    label en official "section 529(c)(3)(B)(iii): for a taxable year beginning before January 1, 2004 clauses (i) and (ii) do not apply to a distribution under a program of eligible educational institutions";
}
@source(IRC_S529_C, quote = "In the case of any taxable year beginning before January 1, 2004, clauses (i) and (ii) shall not apply with respect to any distribution during such taxable year under a qualified tuition program established and maintained by 1 or more eligible educational institutions.")
rule ClausesIAndIIDoNotApply529c3Biii(distribution: Text, begins: Date) defeasible {
    label en official "section 529(c)(3)(B)(iii): the taxable year begins before 2004-01-01 (that day itself is not before it)";
    when distribution_of_institution_program_in_year_beginning_before_2004_529c3Biii(distribution, begins);
    when begins < @2004-01-01;
    then clauses_i_and_ii_do_not_apply_529c3Biii(distribution);
}
@source(IRC_S529_C, quote = "Any benefit furnished to a designated beneficiary under a qualified tuition program shall be treated as a distribution to the beneficiary for purposes of this paragraph.")
rule BenefitTreatedAsDistribution529c3Biv(benefit: Text) defeasible {
    label en official "section 529(c)(3)(B)(iv)";
    when benefit_furnished_to_designated_beneficiary_529c3Biv(benefit);
    then benefit_treated_as_distribution_529c3Biv(benefit);
}
pub relation distribution_from_qualified_tuition_program_529c5A(distribution: Text) kind empirical {
    label en official "section 529(c)(5)(A): a distribution from a qualified tuition program";
}
pub relation distribution_within_529c5B_exception(distribution: Text) kind empirical {
    label en official "section 529(c)(5)(A), lead-in: the distribution is one to which the exception of subparagraph (B) applies";
}
pub relation distribution_not_treated_as_taxable_gift_529c5A(distribution: Text) kind institutional {
    label en official "section 529(c)(5)(A): in no event is a distribution from a qualified tuition program treated as a taxable gift (except as provided in subparagraph (B))";
}
@source(IRC_S529_C, quote = "Except as provided in subparagraph (B), in no event shall a distribution from a qualified tuition program be treated as a taxable gift.")
rule DistributionNotTreatedAsTaxableGift529c5A(distribution: Text) defeasible {
    label en official "section 529(c)(5)(A)";
    when distribution_from_qualified_tuition_program_529c5A(distribution);
    unless distribution_within_529c5B_exception(distribution);
    then distribution_not_treated_as_taxable_gift_529c5A(distribution);
}
