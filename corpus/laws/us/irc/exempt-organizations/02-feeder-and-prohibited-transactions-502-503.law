// Sections 502 (feeder organizations) and 503 (prohibited transactions).
// Both feed the `exemption_denied_under_502_or_503` head declared in
// 01-exemption-classification-501.law.
//
// SCOPE: section 502 in full (both subsections). Section 503 modelled as
// far as (a)(1)-(2) and the prohibited-transaction classification head;
// the six-item catalogue of what counts as a "prohibited transaction"
// ((b)(1)-(6), the related-party definition, and the (e)/(f) safe harbors
// for bond acquisitions and employer loans) is NOT modelled this stage —
// `prohibited_transaction_engaged(o, y)` stays a case-asserted empirical
// fact rather than a derived classification; TECH-GAPS row G70.

// ---------------------------------------------------------------------
// Section 502 — feeder organizations.
// ---------------------------------------------------------------------

use self::{
    IRC_S502_A,
    IRC_S502_B,
    IRC_S503_A,
    IRC_S503_B,
    Person,
    TaxableYear,
    exemption_denied_under_502_or_503,
    section_501c17,
    section_501c18,
    section_503a2_taxable_year_affected,
    section_503c_exemption_restored,
};

@source(IRC_S502_A, quote = "An organization operated for the primary purpose of carrying on a trade or business for profit shall not be exempt from taxation under section 501 on the ground that all of its profits are payable to one or more organizations exempt from taxation under section 501.")
pub relation operated_for_primary_purpose_of_business_for_profit(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization is operated for the primary purpose of carrying on a trade or business for profit (section 502(a))";
}

@source(IRC_S502_B, quote = "the deriving of rents which would be excluded under section 512(b)(3), if section 512 applied to the organization")
pub relation excluded_502b_rents_only_business(o: Person, y: TaxableYear) kind empirical {
    label en unofficial "the organization's only trade-or-business activity is the deriving of rents that would be excluded under section 512(b)(3) — section 502(b)(1) exclusion from the section 502(a) 'trade or business' concept";
}
@source(IRC_S502_B, quote = "any trade or business in which substantially all the work in carrying on such trade or business is performed for the organization without compensation")
pub relation substantially_all_work_uncompensated(o: Person, y: TaxableYear) kind empirical {
    label en official "substantially all the work in carrying on the organization's trade or business is performed for the organization without compensation (section 502(b)(2))";
}
@source(IRC_S502_B, quote = "any trade or business which is the selling of merchandise, substantially all of which has been received by the organization as gifts or contributions")
pub relation substantially_all_merchandise_donated(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization's trade or business is the selling of merchandise substantially all of which it received as gifts or contributions (section 502(b)(3))";
}

@source(IRC_S502_A, quote = "An organization operated for the primary purpose of carrying on a trade or business for profit shall not be exempt from taxation under section 501 on the ground that all of its profits are payable to one or more organizations exempt from taxation under section 501.")
rule FeederOrganizationDeniesExemption(o: Person, y: TaxableYear) defeasible {
    label en official "section 502(a): an organization operated for the primary purpose of carrying on a trade or business for profit is not exempt merely because all its profits are payable to exempt organizations, unless section 502(b) removes the activity from 'trade or business'";
    when operated_for_primary_purpose_of_business_for_profit(o, y);
    unless excluded_502b_rents_only_business(o, y);
    unless substantially_all_work_uncompensated(o, y);
    unless substantially_all_merchandise_donated(o, y);
    then exemption_denied_under_502_or_503(o, y);
}

// ---------------------------------------------------------------------
// Section 503 — prohibited transactions.
// ---------------------------------------------------------------------
//
// Scope note: section 503(a)(1) applies to organizations described in
// section 501(c)(17)-(18) and certain section 401(a) trusts referred to in
// section 4975(g)(2)-(3). STAGE 2 (25.09.2026): `07-additional-
// classification-501c.law` now models section 501(c)(17)/(c)(18) as
// `section_501c17`/`section_501c18`; `section_503a_covered_organization`
// is wired to them below. The section 401(a)-and-4975(g)(2)/(3) branch
// remains an EXTERNAL_DEPENDENCY placeholder (401(a) itself is owned by
// `us.irc.deferred-compensation`; section 4975(g)(2)/(3) is not modelled
// by any owner package as read).

pub relation section_503a_covered_organization(o: Person, y: TaxableYear) kind institutional {
    label en official "an organization described in section 501(c)(17) or (18), or in section 401(a) and referred to in section 4975(g)(2) or (3) (section 503(a)(1))";
}
rule Section503aCoveredViaC17(o: Person, y: TaxableYear) defeasible {
    label en official "section 503(a)(1): a section 501(c)(17) organization is covered by section 503";
    when section_501c17(o, y);
    then section_503a_covered_organization(o, y);
}
rule Section503aCoveredViaC18(o: Person, y: TaxableYear) defeasible {
    label en official "section 503(a)(1): a section 501(c)(18) organization is covered by section 503";
    when section_501c18(o, y);
    then section_503a_covered_organization(o, y);
}
pub relation described_in_401a_and_4975g2_or_3(o: Person, y: TaxableYear) kind empirical {
    label en unofficial "the trust is described in section 401(a) and referred to in section 4975(g)(2) or (3) — EXTERNAL_DEPENDENCY, section 4975(g)(2)/(3) not modelled by any owner package as read";
}
rule Section503aCoveredVia401a(o: Person, y: TaxableYear) defeasible {
    label en official "section 503(a)(1): a section 401(a) trust referred to in section 4975(g)(2)/(3) is covered by section 503";
    when described_in_401a_and_4975g2_or_3(o, y);
    then section_503a_covered_organization(o, y);
}
@source(IRC_S503_B, quote = "the term \"prohibited transaction\" means any transaction in which an organization subject to the provisions of this section")
pub relation prohibited_transaction_engaged(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization engaged in a prohibited transaction as defined in section 503(b), in the taxable year";
}
@source(IRC_S503_A, quote = "An organization described in paragraph (17) or (18) of section 501(c), or described in section 401(a) and referred to in section 4975(g) (2) or (3), shall not be exempt from taxation under section 501(a) if it has engaged in a prohibited transaction.")
rule ProhibitedTransactionDeniesExemption(o: Person, y: TaxableYear) defeasible {
    label en official "section 503(a)(1): a covered organization is not exempt under section 501(a) if it has engaged in a prohibited transaction";
    when section_503a_covered_organization(o, y);
    when prohibited_transaction_engaged(o, y);
    when section_503a2_taxable_year_affected(o, y);
    unless section_503c_exemption_restored(o, y);
    then exemption_denied_under_502_or_503(o, y);
}
