// Sections 521 and 1382, stage 3: the parts of the cooperative provisions that
// module 17 did not carry: the section 521(b)(2), (5), (6) statements, the
// section 1382(b) exclusion, the section 1382(c) deduction, the section 1382(d)
// payment period, the section 1382(e) pooling rule and the section 1382(g)
// completed crop pool conditions.

use self::{
    IRC_S1382_B,
    IRC_S1382_C,
    IRC_S1382_D,
    IRC_S1382_E,
    IRC_S1382_G,
    IRC_S521_B,
    IRC_S526,
    IRC_S529A_C,
    IRC_S529_C,
    IRC_S530_D,
    Person,
    TaxableYear,
};

pub relation capital_stock_dividend_rate_within_521b2(o: Person, rate_percent: Decimal, legal_rate_percent: Decimal) kind empirical {
    label en official "the association's fixed capital stock dividend rate, and the legal rate of interest in the State of incorporation, both in percent per annum";
}
pub relation capital_stock_does_not_deny_exemption_521b2(o: Person) kind institutional {
    label en official "the association's capital stock does not deny exemption";
}
@source(IRC_S521_B, quote = "Exemption shall not be denied any such association because it has capital stock, if the dividend rate of such stock is fixed at not to exceed the legal rate of interest in the State of incorporation or 8 percent per annum, whichever is greater, on the value of the consideration for which the stock was issued, and if substantially all such stock (other than nonvoting preferred stock, the owners of which are not entitled or permitted to participate, directly or indirectly, in the profits of the as")
rule CapitalStockDoesNotDenyExemption521b2(o: Person, rate: Decimal, legal: Decimal) defeasible {
    label en official "section 521(b)(2): the dividend rate is fixed at not more than the greater of the State legal rate of interest and 8 percent per annum (equal to the ceiling is within it)";
    when capital_stock_dividend_rate_within_521b2(o, rate, legal);
    when rate <= max(legal, 8.0);
    then capital_stock_does_not_deny_exemption_521b2(o);
}
pub relation business_done_for_united_states_521b5(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "business done for the United States or any of its agencies";
}
pub relation business_disregarded_in_521_exemption_test_521b5(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount is disregarded in determining the right to exemption";
}
@source(IRC_S521_B, quote = "Business done for the United States or any of its agencies shall be disregarded in determining the right to exemption under this section.")
rule BusinessForUnitedStatesDisregarded521b5(o: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 521(b)(5)";
    when business_done_for_united_states_521b5(o, y, amount);
    then business_disregarded_in_521_exemption_test_521b5(o, y, amount);
}
pub relation net_earnings_computed_under_1382c_manner_521b6(o: Person) kind empirical {
    label en official "the association computes its net earnings for purposes of determining any amount available for distribution to patrons in the manner described in section 1382(c)(1)";
}
pub relation exemption_not_denied_for_net_earnings_computation_521b6(o: Person) kind institutional {
    label en official "exemption is not denied because of the net earnings computation";
}
@source(IRC_S521_B, quote = "Exemption shall not be denied any such association because such association computes its net earnings for purposes of determining any amount available for distribution to patrons in the manner described in paragraph (1) of section 1388(j).")
rule NetEarningsComputationDoesNotDenyExemption521b6(o: Person) defeasible {
    label en official "section 521(b)(6)";
    when net_earnings_computed_under_1382c_manner_521b6(o);
    then exemption_not_denied_for_net_earnings_computation_521b6(o);
}

// Section 1382(d): the payment period.
pub relation taxable_year_end_1382d(coop: Person, y: TaxableYear, year_end: Date) kind empirical {
    label en official "the last day of the organization's taxable year";
}
pub relation return_due_date_1382d(coop: Person, y: TaxableYear, due: Date) kind empirical {
    label en official "the time prescribed by law for filing the return for the taxable year (determined without regard to extensions) — a case fact because the return calendar sits with the filing rules";
}
pub relation payment_period_end_1382d(coop: Person, y: TaxableYear, ends: Date) kind institutional {
    label en official "the payment period for the taxable year ends on the 15th day of the ninth month following the close of the year (the return due date is a case fact)";
}
@source(IRC_S1382_D, quote = "For purposes of subsections (b) and (c)(2), the payment period for any taxable year is the period beginning with the first day of such taxable year and ending with the fifteenth day of the ninth month following the close of such year. For purposes of subsections (b)(1) and (c)(2)(A), a qualified check issued during the payment period shall be treated as an amount paid in money during such period if endorsed and cashed on or before the 90th day after the close of such period.")
rule PaymentPeriodEnd1382d(coop: Person, y: TaxableYear, year_end: Date) defeasible {
    label en official "section 1382(d): the period begins with the first day of the taxable year and ends with the 15th day of the ninth month following the close of the year";
    when taxable_year_end_1382d(coop, y, year_end);
    then payment_period_end_1382d(coop, y, add_calendar_period(add_calendar_period(year_end, 9 calendar_month), 15 calendar_day));
}
// Section 1382(b): exclusion from patronage earnings.
pub relation patronage_dividend_payment_1382b1(coop: Person, y: TaxableYear, paid_on: Date, amount: Money, in_qualifying_medium: Boolean) kind empirical {
    label en official "an amount paid as a patronage dividend on account of the taxable year; in_qualifying_medium is true for money, qualified written notices of allocation, or other property (except nonqualified written notices of allocation)";
}
pub relation patronage_dividend_excluded_from_net_earnings_1382b1(coop: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount is not taken into account in computing net earnings of the organization";
}
@source(IRC_S1382_B, quote = "In determining the taxable income of an organization to which this part applies, there shall not be taken into account amounts paid during the payment period for the taxable year—")
@source(IRC_S1382_B, quote = "(1) as patronage dividends (as defined in section 1388(a)), to the extent paid in money, qualified written notices of allocation (as defined in section 1388(c)), or other property (except nonqualified written notices of allocation (as defined in section 1388(d))) with respect to patronage occurring during such taxable year;")
rule PatronageDividendExcludedFromNetEarnings1382b1(coop: Person, y: TaxableYear, paid_on: Date, amount: Money, ends: Date) defeasible {
    label en official "section 1382(b)(1): paid during the payment period in a qualifying medium (the last day of the period is inclusive)";
    when patronage_dividend_payment_1382b1(coop, y, paid_on, amount, true);
    when payment_period_end_1382d(coop, y, ends);
    when paid_on <= ends;
    then patronage_dividend_excluded_from_net_earnings_1382b1(coop, y, amount);
}
pub relation redemption_of_nonqualified_notice_1382b2(coop: Person, y: TaxableYear, paid_on: Date, amount: Money, notice_paid_during_period: Boolean) kind empirical {
    label en official "an amount paid in money or other property (except written notices of allocation) in redemption of a nonqualified written notice of allocation which was paid as a patronage dividend during the payment period for the taxable year in which the redemption is made";
}
pub relation redemption_excluded_from_net_earnings_1382b2(coop: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the redemption amount is not taken into account in computing net earnings";
}
@source(IRC_S1382_B, quote = "(2) in money or other property (except written notices of allocation) in redemption of a nonqualified written notice of allocation which was paid as a patronage dividend during the payment period for the taxable year during which the patronage occurred;")
rule RedemptionExcludedFromNetEarnings1382b2(coop: Person, y: TaxableYear, paid_on: Date, amount: Money, ends: Date) defeasible {
    label en official "section 1382(b)(2): redemption within the payment period of a notice paid as patronage dividend in that period";
    when redemption_of_nonqualified_notice_1382b2(coop, y, paid_on, amount, true);
    when payment_period_end_1382d(coop, y, ends);
    when paid_on <= ends;
    then redemption_excluded_from_net_earnings_1382b2(coop, y, amount);
}
// Section 1382(c): the deduction.
pub relation capital_stock_dividends_paid_1382c1(coop: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "amounts paid during the taxable year as dividends on its capital stock";
}
pub relation cooperative_deduction_1382c(coop: Person, y: TaxableYear, kind: Text, amount: Money) kind institutional {
    label en official "a deduction allowed under section 1382(c), by paragraph";
}
pub relation coop_described_in_1381a1_for_1382c(coop: Person, y: TaxableYear) kind empirical {
    label en official "the organization is described in section 1381(a)(1) for the taxable year";
}
@source(IRC_S1382_C, quote = "In determining the taxable income of an organization described in section 1381(a)(1), there shall be allowed as a deduction (in addition to other deductions allowable under this chapter)—")
@source(IRC_S1382_C, quote = "(1) amounts paid during the taxable year as dividends on its capital stock; and")
rule CapitalStockDividendDeduction1382c1(coop: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 1382(c)(1): amounts paid during the taxable year as dividends on capital stock";
    when coop_described_in_1381a1_for_1382c(coop, y);
    when capital_stock_dividends_paid_1382c1(coop, y, amount);
    then cooperative_deduction_1382c(coop, y, "1382(c)(1)", amount);
}
pub relation patronage_earnings_payment_1382c2A(coop: Person, y: TaxableYear, paid_on: Date, amount: Money, in_qualifying_medium: Boolean) kind empirical {
    label en official "an amount paid on a patronage basis to patrons with respect to earnings of the taxable year derived from business done with or for patrons, or from incidental sources for patronage-related sources; in_qualifying_medium as above";
}
@source(IRC_S1382_C, quote = "(2) amounts paid during the payment period for the taxable year—")
@source(IRC_S1382_C, quote = "(A) in money, qualified written notices of allocation, or other property (except nonqualified written notices of allocation) on a patronage basis to patrons with respect to its earnings during such taxable year which are derived from business done for the United States or any of its agencies or from sources other than patronage, or")
rule PatronageEarningsDeduction1382c2A(coop: Person, y: TaxableYear, paid_on: Date, amount: Money, ends: Date) defeasible {
    label en official "section 1382(c)(2)(A): paid during the payment period in a qualifying medium";
    when coop_described_in_1381a1_for_1382c(coop, y);
    when patronage_earnings_payment_1382c2A(coop, y, paid_on, amount, true);
    when payment_period_end_1382d(coop, y, ends);
    when paid_on <= ends;
    then cooperative_deduction_1382c(coop, y, "1382(c)(2)(A)", amount);
}
pub relation redemption_of_prior_year_nonqualified_notice_1382c2B(coop: Person, y: TaxableYear, paid_on: Date, amount: Money, notice_in_period: Boolean) kind empirical {
    label en official "an amount paid in money or other property (except written notices of allocation) in redemption of a nonqualified written notice of allocation which was paid, during the payment period for the taxable year in which the earnings were derived, on a patronage basis";
}
@source(IRC_S1382_C, quote = "(B) in money or other property (except written notices of allocation) in redemption of a nonqualified written notice of allocation which was paid, during the payment period for the taxable year during which the earnings were derived, on a patronage basis to a patron with respect to earnings derived from business or sources described in subparagraph (A).")
rule RedemptionDeduction1382c2B(coop: Person, y: TaxableYear, paid_on: Date, amount: Money, ends: Date) defeasible {
    label en official "section 1382(c)(2)(B): redemption during the payment period of the taxable year";
    when coop_described_in_1381a1_for_1382c(coop, y);
    when redemption_of_prior_year_nonqualified_notice_1382c2B(coop, y, paid_on, amount, true);
    when payment_period_end_1382d(coop, y, ends);
    when paid_on <= ends;
    then cooperative_deduction_1382c(coop, y, "1382(c)(2)(B)", amount);
}
pub relation total_cooperative_deductions_1382c(coop: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the sum of the section 1382(c) deductions for the taxable year";
}
rule TotalCooperativeDeductions1382c(coop: Person, y: TaxableYear) defeasible {
    label en official "section 1382(c): total of the deductions allowed, aggregated over the pinned deduction kinds";
    when coop_described_in_1381a1_for_1382c(coop, y);
    then total_cooperative_deductions_1382c(coop, y, sum all a: Money for k: Text where cooperative_deduction_1382c(coop, y, k, a));
}
// Section 1382(e): pooling.
pub relation pool_opened_and_closed_1382e(coop: Person, pool: Text, opened_year: TaxableYear, closed_year: TaxableYear) kind empirical {
    label en official "a pooling arrangement for the marketing of products, open in the first year and closed in the second";
}
pub relation patronage_treated_as_occurring_in_year_1382e1(coop: Person, pool: Text, y: TaxableYear) kind institutional {
    label en official "the patronage is treated as occurring during the taxable year in which the pool closes (to the extent provided in regulations)";
}
@source(IRC_S1382_E, quote = "For purposes of subsection (b), in the case of a pooling arrangement for the marketing of products—")
@source(IRC_S1382_E, quote = "(1) the patronage shall (to the extent provided in regulations prescribed by the Secretary) be treated as patronage occurring during the taxable year in which the pool closes, and")
rule PoolPatronageOccursInClosingYear1382e1(coop: Person, pool: Text, opened: TaxableYear, closed: TaxableYear) defeasible {
    label en official "section 1382(e)(1)";
    when pool_opened_and_closed_1382e(coop, pool, opened, closed);
    then patronage_treated_as_occurring_in_year_1382e1(coop, pool, closed);
}
// Section 1382(g): completed crop pool method.
pub relation pool_opened_before_march_1_1978_1382g1(coop: Person, pool: Text, opened_on: Date) kind empirical {
    label en official "the date the pool was opened";
}
pub relation computed_under_completed_crop_method_for_10_years_1382g1A(coop: Person) kind empirical {
    label en official "the organization computed its taxable income under the completed crop pool method for the 10 taxable years ending with its first taxable year beginning after December 31, 1976";
}
pub relation pool_agreement_with_united_states_conditions_1382g1B(coop: Person, pool: Text) kind empirical {
    label en official "the organization entered into an agreement with the United States or an agency providing (i) a collateral loan, (ii) price support advances, (iii) repayment from net proceeds, and (iv) distribution of net gains to eligible producers";
}
pub relation completed_crop_pool_method_permitted_1382g1(coop: Person, pool: Text) kind institutional {
    label en official "the organization may compute its taxable income with respect to the pool under the completed crop pool method of accounting";
}
@source(IRC_S1382_G, quote = "An organization described in section 1381(a) which is engaged in pooling arrangements for the marketing of products may compute its taxable income with respect to any pool opened prior to March 1, 1978, under the completed crop pool method of accounting if—")
@source(IRC_S1382_G, quote = "(A) the organization has computed its taxable income under such method for the 10 taxable years ending with its first taxable year beginning after December 31, 1976, and")
@source(IRC_S1382_G, quote = "(B) with respect to the pool, the organization has entered into an agreement with the United States or any of its agencies which includes provisions to the effect that—")
rule CompletedCropPoolMethodPermitted1382g1(coop: Person, pool: Text, opened_on: Date) defeasible {
    label en official "section 1382(g)(1)(A)-(B): a pool opened before March 1, 1978 (that date itself is too late)";
    when pool_opened_before_march_1_1978_1382g1(coop, pool, opened_on);
    when opened_on < @1978-03-01;
    when computed_under_completed_crop_method_for_10_years_1382g1A(coop);
    when pool_agreement_with_united_states_conditions_1382g1B(coop, pool);
    then completed_crop_pool_method_permitted_1382g1(coop, pool);
}

// Sections 515 and 526.
pub relation shipowners_mutual_protection_and_indemnity_association_not_for_profit_526(o: Person) kind empirical {
    label en official "the association is a shipowners' mutual protection and indemnity association not organized for profit";
}
pub relation receipts_of_shipowners_association_526(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the receipts of the association for the taxable year";
}
pub relation shipowners_association_receipts_excluded_from_gross_income_526(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the receipts are not included in gross income";
}
@source(IRC_S526, quote = "There shall not be included in gross income the receipts of shipowners' mutual protection and indemnity associations not organized for profit, and no part of the net earnings of which inures to the benefit of any private shareholder; but such corporations shall be subject as other persons to the tax on their taxable income from interest, dividends, and rents.")
rule ShipownersAssociationReceiptsExcluded526(o: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 526";
    when shipowners_mutual_protection_and_indemnity_association_not_for_profit_526(o);
    when receipts_of_shipowners_association_526(o, y, amount);
    then shipowners_association_receipts_excluded_from_gross_income_526(o, y, amount);
}

// Pro rata reduction of the includible amount (sections 529(c)(3)(B)(ii), 529A(c)(1)(B)(ii), 530(d)(2)(B)).
pub relation distributions_in_excess_of_expenses_prorata_input(b: Person, y: TaxableYear, includible: Money, expenses: Money, distributions: Money) kind empirical {
    label en official "the amount otherwise includible in gross income, the qualified expenses, and the aggregate distributions for the taxable year, when distributions exceed the expenses";
}
pub relation includible_amount_after_prorata_reduction(b: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the includible amount after reduction by the amount bearing the same ratio to it as the expenses bear to the distributions";
}
@source(IRC_S529_C, quote = "(II) in any other case, the amount otherwise includible in gross income shall be reduced by an amount which bears the same ratio to such amount as such expenses bear to such distributions.")
@source(IRC_S529A_C, quote = "(ii) in any other case, the amount otherwise includible in gross income shall be reduced by an amount which bears the same ratio to such amount as such expenses bear to such distributions.")
@source(IRC_S530_D, quote = "If such aggregate distributions exceed such expenses during the taxable year, the amount otherwise includible in gross income under paragraph (1) shall be reduced by the amount which bears the same ratio to the amount which would be includible in gross income under paragraph (1) (without regard to this subparagraph) as the qualified education expenses bear to such aggregate distributions.")
rule IncludibleAmountAfterProrataReduction(b: Person, y: TaxableYear, includible: Money, expenses: Money, distributions: Money) defeasible {
    label en official "sections 529(c)(3)(B)(ii), 529A(c)(1)(B)(ii), 530(d)(2)(B): the reduction bears to the includible amount the ratio of expenses to distributions — the result rounds to the cent";
    when distributions_in_excess_of_expenses_prorata_input(b, y, includible, expenses, distributions);
    when distributions > expenses;
    when distributions > 0.00 USD;
    then includible_amount_after_prorata_reduction(b, y, includible - round(includible * (expenses / distributions), 2, "HALF_UP"));
}
