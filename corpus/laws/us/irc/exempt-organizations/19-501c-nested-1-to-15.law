// Section 501(c), stage 3 (a): the nested sub-paragraph machinery that stage 2
// (07-additional-classification-501c.law) took as already reflected in
// case-asserted top-level facts, for paragraphs (1), (12), (14) and (15).
// Each block adds an ADDITIONAL derivation path or an extra guard next to the
// stage 2 rule; no stage 2 relation is removed. Whatever needs a sum uses an
// empirical relation (never a sum over a derived one, TECH-GAPS G76 class).

// ---------------------------------------------------------------------
// (c)(1)(B) and subsection (l): the entities the statute lists by name.
// ---------------------------------------------------------------------

use self::{
    IRC_S501_C,
    IRC_S501_L,
    Person,
    TaxableYear,
    benevolent_insurance_or_mutual_utility_organization,
    gross_receipts_501c15,
    instrumentality_of_united_states,
    is_mutual_insurance_company_501c15,
    non_life_insurance_company_816a,
    organized_under_act_of_congress,
    premium_receipts_501c15,
    section_501c1,
    section_501c12,
    section_501c14,
    section_501c15,
};

pub enum Section501lEntity { CentralLiquidityFacility, ResolutionTrustCorporation, ResolutionFundingCorporation, PatientCenteredOutcomesResearchInstitute }

@source(IRC_S501_L, quote = "For purposes of subsection (c)(1), the following organizations are described in this subsection:")
pub relation is_listed_501l_entity(o: Person, e: Section501lEntity) kind empirical {
    label en official "the organization is the listed subsection (l) entity (Central Liquidity Facility, Resolution Trust Corporation, Resolution Funding Corporation, or the Patient-Centered Outcomes Research Institute)";
}
pub relation described_in_501l(o: Person) kind institutional {
    label en official "the organization is described in section 501(l)";
}
@source(IRC_S501_L, quote = "(1) The Central Liquidity Facility established under title III of the Federal Credit Union Act (12 U.S.C. 1795 et seq.).")
@source(IRC_S501_L, quote = "(2) The Resolution Trust Corporation established under section 21A [1] of the Federal Home Loan Bank Act.")
@source(IRC_S501_L, quote = "(3) The Resolution Funding Corporation established under section 21B of the Federal Home Loan Bank Act.")
@source(IRC_S501_L, quote = "(4) The Patient-Centered Outcomes Research Institute established under section 1181(b) of the Social Security Act.")
rule DescribedIn501lViaListedEntity(o: Person, e: Section501lEntity) defeasible {
    label en official "section 501(l)(1)-(4): each of the four named entities is described in subsection (l)";
    when is_listed_501l_entity(o, e);
    then described_in_501l(o);
}
@source(IRC_S501_C, quote = "(B) is described in subsection (l).")
rule Section501c1ClassificationViaSubsectionL(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(1)(B): a corporation organized under an Act of Congress that is an instrumentality of the United States is described in paragraph (1) when it is described in subsection (l)";
    when organized_under_act_of_congress(o);
    when instrumentality_of_united_states(o);
    when described_in_501l(o);
    when us.irc.core::year_of(o, y);
    then section_501c1(o, y);
}

// ---------------------------------------------------------------------
// (c)(12)(B)-(J): the income a mutual or cooperative telephone or electric
// company disregards or counts as member income, then the 85 percent test on
// the adjusted figures (exact cross-multiplication).
// ---------------------------------------------------------------------

pub relation mutual_or_cooperative_telephone_company_501c12B(o: Person) kind empirical {
    label en official "the organization is a mutual or cooperative telephone company (section 501(c)(12)(B))";
}
pub relation mutual_or_cooperative_electric_company_501c12C(o: Person) kind empirical {
    label en official "the organization is a mutual or cooperative electric company (section 501(c)(12)(C))";
}
pub enum TelephoneIncomeExclusion501c12B { NonmemberTelephoneCompanyServices, QualifiedPoleRentals, DirectoryDisplayListings, RuralElectrificationLoanPrepayment, DisasterRelief, GovernmentFacilitiesGrant }
pub enum ElectricIncomeExclusion501c12C { QualifiedPoleRentals, OpenAccessTransmission, OpenAccessDistribution, NuclearDecommissioning, AssetExchangeOrConversion, DisasterRelief, GovernmentFacilitiesGrant }
pub enum MemberTreatedIncome501c12 { IncomeReceivedIndirectlyFromMember, Section45JElectionIncome }

@source(IRC_S501_C, quote = "(B) In the case of a mutual or cooperative telephone company, subparagraph (A) shall be applied without taking into account any income received or accrued—")
@source(IRC_S501_C, quote = "(i) from a nonmember telephone company for the performance of communication services which involve members of the mutual or cooperative telephone company,")
@source(IRC_S501_C, quote = "(ii) from qualified pole rentals,")
@source(IRC_S501_C, quote = "(iii) from the sale of display listings in a directory furnished to the members of the mutual or cooperative telephone company, or")
@source(IRC_S501_C, quote = "(iv) from the prepayment of a loan under section 306A, 306B, or 311 [1] of the Rural Electrification Act of 1936 (as in effect on January 1, 1987).")
pub relation telephone_income_excluded_501c12B(o: Person, y: TaxableYear, kind: TelephoneIncomeExclusion501c12B, amount: Money) kind empirical {
    label en official "income of a mutual or cooperative telephone company that subparagraph (A) is applied without taking into account: from a nonmember telephone company for communication services involving members, from qualified pole rentals, from display listings in a members' directory, or from prepayment of a Rural Electrification Act loan (section 501(c)(12)(B)(i)-(iv)); plus the (J) disaster and government-grant income";
}
@source(IRC_S501_C, quote = "(C) In the case of a mutual or cooperative electric company, subparagraph (A) shall be applied without taking into account any income received or accrued—")
@source(IRC_S501_C, quote = "(i) from qualified pole rentals, or")
@source(IRC_S501_C, quote = "(ii) from any provision or sale of electric energy transmission services or ancillary services if such services are provided on a nondiscriminatory open access basis under an open access transmission tariff approved or accepted by FERC or under an independent transmission provider agreement approved or accepted by FERC (other than income received or accrued directly or indirectly from a member),")
@source(IRC_S501_C, quote = "(iii) from the provision or sale of electric energy distribution services or ancillary services if such services are provided on a nondiscriminatory open access basis to distribute electric energy not owned by the mutual or electric cooperative company—")
@source(IRC_S501_C, quote = "(iv) from any nuclear decommissioning transaction, or")
@source(IRC_S501_C, quote = "(v) from any asset exchange or conversion transaction.")
pub relation electric_income_excluded_501c12C(o: Person, y: TaxableYear, kind: ElectricIncomeExclusion501c12C, amount: Money) kind empirical {
    label en official "income of a mutual or cooperative electric company that subparagraph (A) is applied without taking into account: qualified pole rentals, open-access transmission or distribution services, nuclear decommissioning transactions, asset exchange or conversion transactions (section 501(c)(12)(C)(i)-(v)); plus the (J) disaster and government-grant income";
}
@source(IRC_S501_C, quote = "(I) In the case of a mutual or cooperative electric company described in this paragraph or an organization described in section 1381(a)(2), income received or accrued in connection with an election under section 45J(e)(1) shall be treated as an amount collected from members for the sole purpose of meeting losses and expenses.")
@source(IRC_S501_C, quote = "(ix) For purposes of subparagraph (A), in the case of a mutual or cooperative electric company, income received, or accrued, indirectly from a member shall be treated as an amount collected from members for the sole purpose of meeting losses and expenses.")
pub relation income_treated_as_member_collected_501c12(o: Person, y: TaxableYear, kind: MemberTreatedIncome501c12, amount: Money) kind empirical {
    label en official "income of a mutual or cooperative electric company treated as an amount collected from members for the sole purpose of meeting losses and expenses: income received or accrued indirectly from a member (H)(ix), or in connection with a section 45J(e)(1) election (I)";
}

// (D): qualified pole rental; the rental includes a sale of the right to use the pole.
pub relation pole_supports_company_wires_for_member_services_501c12Di(pole: Text) kind empirical {
    label en official "the pole (or other structure) is used by the telephone or electric company to support one or more wires used in providing telephone or electric services to its members (section 501(c)(12)(D)(i))";
}
pub relation pole_used_under_rental_to_support_additional_wires_501c12Dii(pole: Text) kind empirical {
    label en official "the pole is used pursuant to the rental to support one or more additional wires for the transmission by wire of electricity or of telephone or other communications (section 501(c)(12)(D)(ii))";
}
pub relation qualified_pole_rental_501c12D(pole: Text) kind institutional {
    label en official "a rental of a pole that meets section 501(c)(12)(D)(i) and (ii) — 'rental' includes any sale of the right to use the pole";
}
@source(IRC_S501_C, quote = "(D) For purposes of this paragraph, the term \"qualified pole rental\" means any rental of a pole (or other structure used to support wires) if such pole (or other structure)—")
@source(IRC_S501_C, quote = "(i) is used by the telephone or electric company to support one or more wires which are used by such company in providing telephone or electric services to its members, and")
@source(IRC_S501_C, quote = "(ii) is used pursuant to the rental to support one or more wires (in addition to the wires described in clause (i)) for use in connection with the transmission by wire of electricity or of telephone or other communications.")
@source(IRC_S501_C, quote = "For purposes of the preceding sentence, the term \"rental\" includes any sale of the right to use the pole (or other structure).")
rule QualifiedPoleRentalDefinition(pole: Text) defeasible {
    label en official "section 501(c)(12)(D): a pole rental is qualified when the pole supports the company's own member-service wires and, under the rental, additional wires";
    when pole_supports_company_wires_for_member_services_501c12Di(pole);
    when pole_used_under_rental_to_support_additional_wires_501c12Dii(pole);
    then qualified_pole_rental_501c12D(pole);
}

// (E): FERC.
pub relation regulator_is_federal_energy_regulatory_commission_501c12Ei(regulator: Text) kind empirical {
    label en official "the regulator is the Federal Energy Regulatory Commission (section 501(c)(12)(E)(i))";
}
pub relation utility_wholly_intrastate_501c12Eii(utility: Text) kind empirical {
    label en official "all of the electricity generated, transmitted, or distributed by the utility is generated, transmitted, distributed, and consumed in the same State (section 501(c)(12)(E)(ii))";
}
pub relation regulator_is_the_states_agency_for_the_utility_501c12Eii(regulator: Text, utility: Text) kind empirical {
    label en official "the regulator is the State agency of that State with the authority to regulate the utility (section 501(c)(12)(E)(ii))";
}
pub relation regulator_is_ferc_within_501c12E(regulator: Text, utility: Text) kind institutional {
    label en official "the regulator is 'FERC' as section 501(c)(12)(E) defines it for the utility";
}
@source(IRC_S501_C, quote = "(E) For purposes of subparagraph (C)(ii), the term \"FERC\" means—")
@source(IRC_S501_C, quote = "(i) the Federal Energy Regulatory Commission, or")
rule FercIsTheCommission(regulator: Text, utility: Text) defeasible {
    label en official "section 501(c)(12)(E)(i): the Federal Energy Regulatory Commission is FERC";
    when regulator_is_federal_energy_regulatory_commission_501c12Ei(regulator);
    when utility_wholly_intrastate_501c12Eii(utility);
    then regulator_is_ferc_within_501c12E(regulator, utility);
}
@source(IRC_S501_C, quote = "(ii) in the case of any utility with respect to which all of the electricity generated, transmitted, or distributed by such utility is generated, transmitted, distributed, and consumed in the same State, the State agency of such State with the authority to regulate electric utilities.")
rule FercIsTheStateAgencyForIntrastateUtility(regulator: Text, utility: Text) defeasible {
    label en official "section 501(c)(12)(E)(ii): for a wholly intrastate utility, FERC means the State agency that regulates it";
    when utility_wholly_intrastate_501c12Eii(utility);
    when regulator_is_the_states_agency_for_the_utility_501c12Eii(regulator, utility);
    then regulator_is_ferc_within_501c12E(regulator, utility);
}

// (F), (G): nuclear decommissioning and asset exchange/conversion transactions.
pub enum NuclearDecommissioningTransfer501c12F { TransferInConnectionWithSaleOfNuclearInterest, DistributionFromDecommissioningFund, EarningsOfDecommissioningFund }
pub relation nuclear_decommissioning_flow_501c12F(flow: Text, kind: NuclearDecommissioningTransfer501c12F) kind empirical {
    label en official "the flow is a transfer into, distribution from, or earnings of a trust, fund, or instrument established to pay nuclear decommissioning costs (section 501(c)(12)(F)(i)-(iii))";
}
pub relation nuclear_decommissioning_transaction_501c12F(flow: Text) kind institutional {
    label en official "the flow is a nuclear decommissioning transaction within section 501(c)(12)(F)";
}
@source(IRC_S501_C, quote = "(F) For purposes of subparagraph (C)(iv), the term \"nuclear decommissioning transaction\" means—")
@source(IRC_S501_C, quote = "(i) any transfer into a trust, fund, or instrument established to pay any nuclear decommissioning costs if the transfer is in connection with the transfer of the mutual or cooperative electric company's interest in a nuclear power plant or nuclear power plant unit,")
@source(IRC_S501_C, quote = "(ii) any distribution from any trust, fund, or instrument established to pay any nuclear decommissioning costs, or")
@source(IRC_S501_C, quote = "(iii) any earnings from any trust, fund, or instrument established to pay any nuclear decommissioning costs.")
rule NuclearDecommissioningTransactionDefinition(flow: Text, k: NuclearDecommissioningTransfer501c12F) defeasible {
    label en official "section 501(c)(12)(F): a transfer into (on transfer of the company's interest in a nuclear plant), a distribution from, or earnings of a decommissioning trust, fund, or instrument is a nuclear decommissioning transaction";
    when nuclear_decommissioning_flow_501c12F(flow, k);
    then nuclear_decommissioning_transaction_501c12F(flow);
}
pub relation exchange_or_conversion_of_electric_or_gas_utility_property_501c12G(tx: Text) kind empirical {
    label en official "the transaction is a voluntary exchange or involuntary conversion of property related to generating, transmitting, distributing, or selling electric energy, or producing, transmitting, distributing, or selling natural gas (section 501(c)(12)(G)(i)-(ii))";
}
pub relation asset_exchange_or_conversion_transaction_501c12G(tx: Text) kind institutional {
    label en official "the transaction is an asset exchange or conversion transaction within section 501(c)(12)(G)";
}
@source(IRC_S501_C, quote = "(G) For purposes of subparagraph (C)(v), the term \"asset exchange or conversion transaction\" means any voluntary exchange or involuntary conversion of any property related to generating, transmitting, distributing, or selling electric energy by a mutual or cooperative electric company, the gain from which qualifies for deferred recognition under section 1031 or 1033, but only if the replacement property acquired by such company pursuant to such section constitutes property which is used, or to b")
@source(IRC_S501_C, quote = "(i) generating, transmitting, distributing, or selling electric energy, or")
@source(IRC_S501_C, quote = "(ii) producing, transmitting, distributing, or selling natural gas.")
rule AssetExchangeOrConversionDefinition(tx: Text) defeasible {
    label en official "section 501(c)(12)(G): a voluntary exchange or involuntary conversion of electric or natural gas utility property";
    when exchange_or_conversion_of_electric_or_gas_utility_property_501c12G(tx);
    then asset_exchange_or_conversion_transaction_501c12G(tx);
}

// (H): load loss transactions. The recovery period is the 7-year period
// beginning with the start-up year (vi); the limit is the sum of the annual
// load losses (iii); an annual load loss is the amount by which the
// megawatt hours sold to members in the year are less than those sold in the
// base year (iv). The seven recovery years are indexed 1..7 relative to the
// start-up year so no year arithmetic is needed.
pub relation megawatt_hours_sold_to_members_in_recovery_year_501c12H(o: Person, k: Integer, mwh: Decimal) kind empirical {
    label en official "the megawatt hours of electric energy sold to members in the k-th year (1 to 7) of the recovery period beginning with the start-up year (section 501(c)(12)(H)(iv)(I), (vi))";
}
pub relation megawatt_hours_sold_to_members_in_base_year_501c12H(o: Person, mwh: Decimal) kind empirical {
    label en official "the megawatt hours of electric energy sold to members in the base year: the calendar year preceding the start-up year, or at the company's election the second or third calendar year preceding it (section 501(c)(12)(H)(iv)(II), (v))";
}
pub relation annual_load_loss_501c12H(o: Person, k: Integer, loss: Decimal) kind institutional {
    label en official "the annual load loss for the k-th recovery year: the amount, if any, by which members' megawatt hours sold in that year are less than in the base year (section 501(c)(12)(H)(iv))";
}
@source(IRC_S501_C, quote = "(iv) For purposes of clause (iii), a mutual or cooperative electric company's annual load loss for each year of the recovery period is the amount (if any) by which—")
@source(IRC_S501_C, quote = "(I) the megawatt hours of electric energy sold during such year to members of such electric company are less than")
@source(IRC_S501_C, quote = "(II) the megawatt hours of electric energy sold during the base year to such members.")
rule AnnualLoadLossPositive(o: Person, k: Integer, sold: Decimal, base: Decimal) defeasible {
    label en official "section 501(c)(12)(H)(iv): when sales to members fell below the base year, the annual load loss is the shortfall";
    when megawatt_hours_sold_to_members_in_recovery_year_501c12H(o, k, sold);
    when megawatt_hours_sold_to_members_in_base_year_501c12H(o, base);
    when sold < base;
    then annual_load_loss_501c12H(o, k, base - sold);
}
rule AnnualLoadLossZero(o: Person, k: Integer, sold: Decimal, base: Decimal) defeasible {
    label en official "section 501(c)(12)(H)(iv): when sales to members did not fall below the base year, the annual load loss is zero";
    when megawatt_hours_sold_to_members_in_recovery_year_501c12H(o, k, sold);
    when megawatt_hours_sold_to_members_in_base_year_501c12H(o, base);
    when sold >= base;
    then annual_load_loss_501c12H(o, k, 0.0);
}
pub relation load_loss_mitigation_sales_limit_501c12H(o: Person, limit: Decimal) kind institutional {
    label en official "the load loss mitigation sales limit for the recovery period: the sum of the annual load losses for each of its 7 years (section 501(c)(12)(H)(iii), (vi))";
}
@source(IRC_S501_C, quote = "(iii) For purposes of clause (ii), the load loss mitigation sales limit for the recovery period is the sum of the annual load losses for each year of such period.")
@source(IRC_S501_C, quote = "(vi) For purposes of this subparagraph, the recovery period is the 7-year period beginning with the start-up year.")
rule LoadLossMitigationSalesLimitSumOfSevenYears(o: Person, l1: Decimal, l2: Decimal, l3: Decimal, l4: Decimal, l5: Decimal, l6: Decimal, l7: Decimal) defeasible {
    label en official "section 501(c)(12)(H)(iii), (vi): the limit is the sum of the annual load losses of the 7 years of the recovery period";
    when annual_load_loss_501c12H(o, 1, l1);
    when annual_load_loss_501c12H(o, 2, l2);
    when annual_load_loss_501c12H(o, 3, l3);
    when annual_load_loss_501c12H(o, 4, l4);
    when annual_load_loss_501c12H(o, 5, l5);
    when annual_load_loss_501c12H(o, 6, l6);
    when annual_load_loss_501c12H(o, 7, l7);
    then load_loss_mitigation_sales_limit_501c12H(o, l1 + l2 + l3 + l4 + l5 + l6 + l7);
}
pub relation nonmember_electric_sales_mwh_during_recovery_period_501c12H(o: Person, mwh: Decimal) kind empirical {
    label en official "the aggregate megawatt hours of wholesale or retail sales of electric energy other than to members during the recovery period (section 501(c)(12)(H)(ii))";
}
pub relation nonmember_electric_sales_income_501c12H(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the income received or accrued in the taxable year from those sales (section 501(c)(12)(H)(i))";
}
pub relation load_loss_transaction_income_501c12H(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "income received or accrued from a load loss transaction, which is treated as an amount collected from members for the sole purpose of meeting losses and expenses";
}
@source(IRC_S501_C, quote = "(H)(i) In the case of a mutual or cooperative electric company described in this paragraph or an organization described in section 1381(a)(2)(C), income received or accrued from a load loss transaction shall be treated as an amount collected from members for the sole purpose of meeting losses and expenses.")
@source(IRC_S501_C, quote = "(ii) For purposes of clause (i), the term \"load loss transaction\" means any wholesale or retail sale of electric energy (other than to members) to the extent that the aggregate sales during the recovery period do not exceed the load loss mitigation sales limit for such period.")
rule LoadLossTransactionIncomeWithinLimit(o: Person, y: TaxableYear, mwh: Decimal, limit: Decimal, income: Money) defeasible {
    label en official "section 501(c)(12)(H)(i)-(ii): sales other than to members are load loss transactions to the extent the aggregate sales during the recovery period do not exceed the limit — when they do not exceed it, all of the income is treated as member-collected";
    when mutual_or_cooperative_electric_company_501c12C(o);
    when nonmember_electric_sales_mwh_during_recovery_period_501c12H(o, mwh);
    when load_loss_mitigation_sales_limit_501c12H(o, limit);
    when mwh <= limit;
    when nonmember_electric_sales_income_501c12H(o, y, income);
    then load_loss_transaction_income_501c12H(o, y, income);
}
pub relation nonmember_sales_exceed_load_loss_limit_501c12H(o: Person) kind institutional {
    label en official "aggregate nonmember sales during the recovery period exceed the load loss mitigation sales limit, so only part of the income can be load loss transaction income — the statute does not say how the income is apportioned (INTERPRETATION)";
}
@source(IRC_S501_C, quote = "(ii) For purposes of clause (i), the term \"load loss transaction\" means any wholesale or retail sale of electric energy (other than to members) to the extent that the aggregate sales during the recovery period do not exceed the load loss mitigation sales limit for such period.")
rule NonmemberSalesExceedLoadLossLimit(o: Person, mwh: Decimal, limit: Decimal) defeasible {
    label en official "section 501(c)(12)(H)(ii): aggregate sales beyond the limit are not load loss transactions to that extent";
    when nonmember_electric_sales_mwh_during_recovery_period_501c12H(o, mwh);
    when load_loss_mitigation_sales_limit_501c12H(o, limit);
    when mwh > limit;
    then nonmember_sales_exceed_load_loss_limit_501c12H(o);
}
@source(IRC_S501_C, quote = "(viii) A company shall not fail to be treated as a mutual or cooperative electric company for purposes of this paragraph or as a corporation operating on a cooperative basis for purposes of section 1381(a)(2)(C) by reason of the treatment under clause (i).")
pub relation electric_company_status_unaffected_by_load_loss_treatment_501c12Hviii(o: Person) kind institutional {
    label en official "the company does not fail to be a mutual or cooperative electric company, or a cooperative-basis corporation under section 1381(a)(2)(C), by reason of the load loss treatment";
}
rule ElectricCompanyStatusUnaffectedByLoadLossTreatment(o: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 501(c)(12)(H)(viii): treating load loss income as member-collected does not change the company's status";
    when load_loss_transaction_income_501c12H(o, y, amount);
    then electric_company_status_unaffected_by_load_loss_treatment_501c12Hviii(o);
}

// The adjusted 85 percent test.
pub relation gross_member_income_501c12(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "amounts collected from members for the sole purpose of meeting losses and expenses before the subparagraph (B)-(J) adjustments (section 501(c)(12)(A))";
}
pub relation gross_total_income_501c12(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the organization's total income for the taxable year before the subparagraph (B)-(J) adjustments (section 501(c)(12)(A))";
}
pub relation adjusted_total_income_501c12(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "total income after leaving out the income that subparagraphs (B), (C) and (J) say is not taken into account";
}
@source(IRC_S501_C, quote = "(B) In the case of a mutual or cooperative telephone company, subparagraph (A) shall be applied without taking into account any income received or accrued—")
rule AdjustedTotalIncomeTelephone(o: Person, y: TaxableYear, gross: Money) defeasible {
    label en official "section 501(c)(12)(B), (J): a telephone company's total income less the excluded income";
    when mutual_or_cooperative_telephone_company_501c12B(o);
    when gross_total_income_501c12(o, y, gross);
    then adjusted_total_income_501c12(o, y, gross - sum all a: Money for k: TelephoneIncomeExclusion501c12B where telephone_income_excluded_501c12B(o, y, k, a));
}
@source(IRC_S501_C, quote = "(C) In the case of a mutual or cooperative electric company, subparagraph (A) shall be applied without taking into account any income received or accrued—")
rule AdjustedTotalIncomeElectric(o: Person, y: TaxableYear, gross: Money) defeasible {
    label en official "section 501(c)(12)(C), (J): an electric company's total income less the excluded income";
    when mutual_or_cooperative_electric_company_501c12C(o);
    when gross_total_income_501c12(o, y, gross);
    then adjusted_total_income_501c12(o, y, gross - sum all a: Money for k: ElectricIncomeExclusion501c12C where electric_income_excluded_501c12C(o, y, k, a));
}
pub relation gross_total_income_of_telephone_or_electric_company_501c12(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the gross total income of a mutual or cooperative telephone or electric company (helper: the exception atom that binds every head variable of the default rule below)";
}
rule GrossTotalIncomeOfTelephoneCompany(o: Person, y: TaxableYear, gross: Money) defeasible {
    label en official "helper: a telephone company's gross total income";
    when mutual_or_cooperative_telephone_company_501c12B(o);
    when gross_total_income_501c12(o, y, gross);
    then gross_total_income_of_telephone_or_electric_company_501c12(o, y, gross);
}
rule GrossTotalIncomeOfElectricCompany(o: Person, y: TaxableYear, gross: Money) defeasible {
    label en official "helper: an electric company's gross total income";
    when mutual_or_cooperative_electric_company_501c12C(o);
    when gross_total_income_501c12(o, y, gross);
    then gross_total_income_of_telephone_or_electric_company_501c12(o, y, gross);
}
rule AdjustedTotalIncomeOtherOrganization(o: Person, y: TaxableYear, gross: Money) defeasible {
    label en official "section 501(c)(12)(A): an organization that is neither a telephone nor an electric company has no subparagraph (B)/(C) adjustment";
    when gross_total_income_501c12(o, y, gross);
    unless gross_total_income_of_telephone_or_electric_company_501c12(o, y, gross);
    then adjusted_total_income_501c12(o, y, gross);
}
pub relation adjusted_member_income_501c12(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "member-collected income after adding the income that subparagraph (H) and (I) treat as collected from members";
}
@source(IRC_S501_C, quote = "(H)(i) In the case of a mutual or cooperative electric company described in this paragraph or an organization described in section 1381(a)(2)(C), income received or accrued from a load loss transaction shall be treated as an amount collected from members for the sole purpose of meeting losses and expenses.")
@source(IRC_S501_C, quote = "(ix) For purposes of subparagraph (A), in the case of a mutual or cooperative electric company, income received, or accrued, indirectly from a member shall be treated as an amount collected from members for the sole purpose of meeting losses and expenses.")
rule AdjustedMemberIncomeWithLoadLoss(o: Person, y: TaxableYear, gross: Money, ll: Money) defeasible {
    label en official "section 501(c)(12)(H), (I): member-collected income plus load loss transaction income plus the indirect-member and section 45J election income";
    when gross_member_income_501c12(o, y, gross);
    when load_loss_transaction_income_501c12H(o, y, ll);
    then adjusted_member_income_501c12(o, y, gross + ll + sum all a: Money for k: MemberTreatedIncome501c12 where income_treated_as_member_collected_501c12(o, y, k, a));
}
pub relation gross_member_income_with_load_loss_income_501c12(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "gross member income of a company that also has load loss transaction income (helper: the exception atom that binds every head variable of the rule below)";
}
rule GrossMemberIncomeWithLoadLossIncome(o: Person, y: TaxableYear, gross: Money, ll: Money) defeasible {
    label en official "helper: gross member income for a year that has load loss transaction income";
    when gross_member_income_501c12(o, y, gross);
    when load_loss_transaction_income_501c12H(o, y, ll);
    then gross_member_income_with_load_loss_income_501c12(o, y, gross);
}
rule AdjustedMemberIncomeWithoutLoadLoss(o: Person, y: TaxableYear, gross: Money) defeasible {
    label en official "section 501(c)(12)(H), (I): member-collected income plus the indirect-member and section 45J election income when there is no load loss transaction income";
    when gross_member_income_501c12(o, y, gross);
    unless gross_member_income_with_load_loss_income_501c12(o, y, gross);
    then adjusted_member_income_501c12(o, y, gross + sum all a: Money for k: MemberTreatedIncome501c12 where income_treated_as_member_collected_501c12(o, y, k, a));
}
@source(IRC_S501_C, quote = "(i) from a nonmember telephone company for the performance of communication services which involve members of the mutual or cooperative telephone company,")
rule Section501c12EightyFivePercentTestAdjusted(o: Person, y: TaxableYear, member: Money, total: Money) defeasible {
    label en official "section 501(c)(12)(A) applied to the adjusted figures: 100 * adjusted member income >= 85 * adjusted total income — exact cross-multiplication";
    when benevolent_insurance_or_mutual_utility_organization(o);
    when adjusted_member_income_501c12(o, y, member);
    when adjusted_total_income_501c12(o, y, total);
    when member * 100 >= total * 85;
    then section_501c12(o, y);
}

// ---------------------------------------------------------------------
// (c)(14)(B), (C): pre-September 1, 1957 reserve-fund corporations.
// ---------------------------------------------------------------------

pub enum ReserveFundInstitution501c14B { DomesticBuildingAndLoanAssociation, CooperativeBankWithoutCapitalStock, MutualSavingsBankWithoutShares, MutualSavingsBankUnder591b }
pub relation organized_on_501c14(o: Person, on: Date) kind empirical {
    label en official "the date on which the corporation or association was organized";
}
pub relation mutual_no_profit_without_capital_stock_501c14B(o: Person, y: TaxableYear) kind empirical {
    label en official "the corporation or association is without capital stock and is operated for mutual purposes and without profit (section 501(c)(14)(B))";
}
pub relation provides_reserve_funds_and_insurance_for_institution_501c14B(o: Person, inst: ReserveFundInstitution501c14B) kind empirical {
    label en official "the organization provides reserve funds for, and insurance of shares or deposits in, the listed kind of institution (section 501(c)(14)(B)(i)-(iv))";
}
pub relation entitled_to_exemption_under_501c14B(o: Person, y: TaxableYear) kind institutional {
    label en official "the corporation or association is described in section 501(c)(14)(B)";
}
@source(IRC_S501_C, quote = "(B) Corporations or associations without capital stock organized before September 1, 1957, and operated for mutual purposes and without profit for the purpose of providing reserve funds for, and insurance of shares or deposits in—")
@source(IRC_S501_C, quote = "(i) domestic building and loan associations,")
@source(IRC_S501_C, quote = "(ii) cooperative banks without capital stock organized and operated for mutual purposes and without profit,")
@source(IRC_S501_C, quote = "(iii) mutual savings banks not having capital stock represented by shares, or")
@source(IRC_S501_C, quote = "(iv) mutual savings banks described in section 591(b).")
rule Section501c14BClassification(o: Person, y: TaxableYear, organized: Date, inst: ReserveFundInstitution501c14B) defeasible {
    label en official "section 501(c)(14)(B): a corporation or association without capital stock organized before September 1, 1957, mutual and without profit, providing reserve funds and insurance for one of the four listed kinds of institution";
    when organized_on_501c14(o, organized);
    when organized < @1957-09-01;
    when mutual_no_profit_without_capital_stock_501c14B(o, y);
    when provides_reserve_funds_and_insurance_for_institution_501c14B(o, inst);
    then entitled_to_exemption_under_501c14B(o, y);
}
rule Section501c14BIsSection501c14(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(14)(B): such a corporation or association is described in paragraph (14)";
    when entitled_to_exemption_under_501c14B(o, y);
    then section_501c14(o, y);
}
pub relation provides_reserve_funds_for_c14B_institutions_501c14C(o: Person, y: TaxableYear) kind empirical {
    label en official "the corporation or association, organized before September 1, 1957 and operated for mutual purposes and without profit, provides reserve funds for associations or banks described in clause (i), (ii) or (iii) of subparagraph (B) (section 501(c)(14)(C))";
}
pub relation income_from_reserve_funds_and_investments_501c14C(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the income attributable to providing reserve funds and to investments (section 501(c)(14)(C))";
}
pub relation total_income_501c14C(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the total income of the corporation or association (section 501(c)(14)(C))";
}
@source(IRC_S501_C, quote = "(C) Corporations or associations organized before September 1, 1957, and operated for mutual purposes and without profit for the purpose of providing reserve funds for associations or banks described in clause (i), (ii), or (iii) of subparagraph (B); but only if 85 percent or more of the income is attributable to providing such reserve funds and to investments. This subparagraph shall not apply to any corporation or association entitled to exemption under subparagraph (B).")
rule Section501c14CClassification(o: Person, y: TaxableYear, organized: Date, reserve_income: Money, total: Money) defeasible {
    label en official "section 501(c)(14)(C): pre-September 1, 1957 mutual reserve-fund corporations for institutions described in (B)(i)-(iii), at least 85 percent of whose income is reserve-fund and investment income — exact cross-multiplication; not applicable to a corporation entitled under (B)";
    when organized_on_501c14(o, organized);
    when organized < @1957-09-01;
    when provides_reserve_funds_for_c14B_institutions_501c14C(o, y);
    when income_from_reserve_funds_and_investments_501c14C(o, y, reserve_income);
    when total_income_501c14C(o, y, total);
    when reserve_income * 100 >= total * 85;
    unless entitled_to_exemption_under_501c14B(o, y);
    then section_501c14(o, y);
}

// ---------------------------------------------------------------------
// (c)(15)(A) last sentence and (B), (C): family-employee bar and the
// controlled-group aggregation of gross receipts and premiums.
// ---------------------------------------------------------------------

pub relation employee_or_family_member_employed_by_other_c15_company_501c15A(o: Person, y: TaxableYear) kind empirical {
    label en official "an employee of the company, or a member of the employee's family (section 2032A(e)(2)), is an employee of another company exempt by reason of paragraph (15) (or that would be so exempt but for this sentence)";
}
@source(IRC_S501_C, quote = "Clause (ii) shall not apply to a company if any employee of the company, or a member of the employee's family (as defined in section 2032A(e)(2)), is an employee of another company exempt from taxation by reason of this paragraph (or would be so exempt but for this sentence).")
pub relation mutual_clause_ii_disapplied_501c15A(o: Person, y: TaxableYear) kind institutional {
    label en official "clause (ii) (the mutual insurance company test) does not apply to the company (section 501(c)(15)(A), last sentence)";
}
rule MutualClauseIiDisappliedByFamilyEmployment(o: Person, y: TaxableYear) defeasible {
    label en official "section 501(c)(15)(A), last sentence: clause (ii) does not apply if an employee or family member is an employee of another paragraph (15) company";
    when employee_or_family_member_employed_by_other_c15_company_501c15A(o, y);
    then mutual_clause_ii_disapplied_501c15A(o, y);
}
pub relation controlled_group_member_501c15C(o: Person, other: Person, y: TaxableYear) kind empirical {
    label en official "the other company or association is a member of the same controlled group as the insurance company or association for which the determination is made (section 831(b)(2)(B)(ii), with subparagraphs (B) and (C) of section 1563(b)(2) disregarded) — EXTERNAL_DEPENDENCY on the section 831/1563 tests";
}
pub relation has_controlled_group_members_501c15B(o: Person, y: TaxableYear) kind institutional {
    label en official "the company has at least one other member in its controlled group";
}
@source(IRC_S501_C, quote = "(B) For purposes of subparagraph (A), in determining whether any company or association is described in subparagraph (A), such company or association shall be treated as receiving during the taxable year amounts described in subparagraph (A) which are received during such year by all other companies or associations which are members of the same controlled group as the insurance company or association for which the determination is being made.")
@source(IRC_S501_C, quote = "(C) For purposes of subparagraph (B), the term \"controlled group\" has the meaning given such term by section 831(b)(2)(B)(ii),[1] except that in applying section 831(b)(2)(B)(ii) [1] for purposes of this subparagraph, subparagraphs (B) and (C) of section 1563(b)(2) shall be disregarded.")
rule HasControlledGroupMembers(o: Person, y: TaxableYear, other: Person) defeasible {
    label en official "section 501(c)(15)(B)-(C): the company has a controlled group";
    when controlled_group_member_501c15C(o, other, y);
    then has_controlled_group_members_501c15B(o, y);
}
pub relation member_gross_receipts_501c15B(other: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the gross receipts a controlled group member received during the taxable year";
}
pub relation member_premium_receipts_501c15B(other: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the premiums a controlled group member received during the taxable year";
}
pub relation aggregated_gross_receipts_501c15B(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "gross receipts treated as received by the company: its own plus those received by all other members of its controlled group (section 501(c)(15)(B))";
}
pub relation aggregated_premium_receipts_501c15B(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "premium receipts treated as received by the company: its own plus those of its controlled group (section 501(c)(15)(B))";
}
@source(IRC_S501_C, quote = "(B) For purposes of subparagraph (A), in determining whether any company or association is described in subparagraph (A), such company or association shall be treated as receiving during the taxable year amounts described in subparagraph (A) which are received during such year by all other companies or associations which are members of the same controlled group as the insurance company or association for which the determination is being made.")
rule AggregatedGrossReceiptsWithControlledGroup(o: Person, y: TaxableYear, own: Money) defeasible {
    label en official "section 501(c)(15)(B): the amounts in subparagraph (A) include what all other controlled group members received";
    when has_controlled_group_members_501c15B(o, y);
    when gross_receipts_501c15(o, y, own);
    then aggregated_gross_receipts_501c15B(o, y, own + sum all a: Money for other: Person where controlled_group_member_gross_receipts_501c15B(o, y, other, a));
}
pub relation controlled_group_member_gross_receipts_501c15B(o: Person, y: TaxableYear, other: Person, amount: Money) kind empirical {
    label en official "the gross receipts of a controlled group member of the company, for the section 501(c)(15)(B) aggregation";
}
pub relation controlled_group_member_premium_receipts_501c15B(o: Person, y: TaxableYear, other: Person, amount: Money) kind empirical {
    label en official "the premium receipts of a controlled group member of the company, for the section 501(c)(15)(B) aggregation";
}
@source(IRC_S501_C, quote = "(B) For purposes of subparagraph (A), in determining whether any company or association is described in subparagraph (A), such company or association shall be treated as receiving during the taxable year amounts described in subparagraph (A) which are received during such year by all other companies or associations which are members of the same controlled group as the insurance company or association for which the determination is being made.")
rule AggregatedPremiumReceiptsWithControlledGroup(o: Person, y: TaxableYear, own: Money) defeasible {
    label en official "section 501(c)(15)(B): the premium amounts in subparagraph (A) include what all other controlled group members received";
    when has_controlled_group_members_501c15B(o, y);
    when premium_receipts_501c15(o, y, own);
    then aggregated_premium_receipts_501c15B(o, y, own + sum all a: Money for other: Person where controlled_group_member_premium_receipts_501c15B(o, y, other, a));
}
@source(IRC_S501_C, quote = "(i)(I) the gross receipts for the taxable year do not exceed $600,000, and")
@source(IRC_S501_C, quote = "(II) more than 50 percent of such gross receipts consist of premiums, or")
rule Section501c15NonMutualTestControlledGroup(o: Person, y: TaxableYear, gross: Money, premium: Money) defeasible {
    label en official "section 501(c)(15)(A)(i) with the (B) aggregation: controlled group gross receipts <= $600,000 and 100 * controlled group premiums > 50 * controlled group gross receipts";
    when non_life_insurance_company_816a(o);
    unless is_mutual_insurance_company_501c15(o, y);
    when aggregated_gross_receipts_501c15B(o, y, gross);
    when aggregated_premium_receipts_501c15B(o, y, premium);
    when gross <= 600000.00 USD;
    when premium * 100 > gross * 50;
    then section_501c15(o, y);
}
@source(IRC_S501_C, quote = "(ii) in the case of a mutual insurance company—")
@source(IRC_S501_C, quote = "(I) the gross receipts of which for the taxable year do not exceed $150,000, and")
@source(IRC_S501_C, quote = "(II) more than 35 percent of such gross receipts consist of premiums.")
rule Section501c15MutualTestControlledGroup(o: Person, y: TaxableYear, gross: Money, premium: Money) defeasible {
    label en official "section 501(c)(15)(A)(ii) with the (B) aggregation: a mutual company's controlled group gross receipts <= $150,000 and 100 * premiums > 35 * gross receipts, unless clause (ii) is disapplied";
    when non_life_insurance_company_816a(o);
    when is_mutual_insurance_company_501c15(o, y);
    when aggregated_gross_receipts_501c15B(o, y, gross);
    when aggregated_premium_receipts_501c15B(o, y, premium);
    when gross <= 150000.00 USD;
    when premium * 100 > gross * 35;
    unless mutual_clause_ii_disapplied_501c15A(o, y);
    then section_501c15(o, y);
}
