// Section 514(b)(1)(B)-(E) further debt-financed-real_prop exclusions,
// (b)(3) the EXACT 10-year neighborhood-land rule, and (c)(2)-(9)
// acquisition-indebtedness special rules including the real-real_prop-of-
// qualified-organizations 6-condition test — STAGE 2b (25.09.2026),
// closing part of TECH-GAPS G75.

// ---------------------------------------------------------------------
// (b)(1)(B)-(E): further debt-financed-real_prop exclusions (stage 1
// modelled (A)'s substantially-related exclusion only).
// ---------------------------------------------------------------------

use self::{
    Asset,
    IRC_S514_B,
    IRC_S514_C,
    Person,
    SupportingOrganizationType,
    TaxableYear,
    TradeOrBusiness,
    brownfield_property_gain_loss_excluded_512b19,
    pass_thru_held_property_fails_partner_requirements_514c9D,
    payment_terms_depend_on_property_income_514c9Bii_derived,
    research_income_excluded_512b8,
    research_income_excluded_512b9,
    section_501c25,
    supported_organization_509f3,
    supporting_organization_type,
};

@source(IRC_S514_B, quote = "except in the case of income excluded under section 512(b)(5), any property to the extent that the income from such property is taken into account in computing the gross income of any unrelated trade or business;")
pub relation debt_financed_property_excluded_514b1B(tb: TradeOrBusiness, o: Person, y: TaxableYear) kind institutional {
    label en official "section 514(b)(1)(B): property excluded from 'debt-financed property' to the extent its income is already taken into account in computing gross income of an unrelated trade or business (except section 512(b)(5)-excluded income)";
}
pub relation property_income_taken_into_account_in_ubti_514b1B(tb: TradeOrBusiness, o: Person, y: TaxableYear) kind empirical {
    label en official "the property's income is taken into account in computing the gross income of an unrelated trade or business (section 514(b)(1)(B))";
}
pub relation capital_gain_loss_excluded_512b5_for_activity(tb: TradeOrBusiness, o: Person, y: TaxableYear) kind empirical {
    label en unofficial "section 512(b)(5) gain/loss exclusion applies to income from this specific trade or business's property — a tb-scoped restatement of `capital_gain_loss_excluded_512b5` so the section 514(b)(1)(B) `unless` clause can bind `tb` per the corpus's unless-binds-every-head-field convention";
}
rule DebtFinancedPropertyExcluded514b1B(tb: TradeOrBusiness, o: Person, y: TaxableYear) defeasible {
    label en official "section 514(b)(1)(B): already-taxed-as-UBTI property exclusion";
    when property_income_taken_into_account_in_ubti_514b1B(tb, o, y);
    unless capital_gain_loss_excluded_512b5_for_activity(tb, o, y);
    then debt_financed_property_excluded_514b1B(tb, o, y);
}
@source(IRC_S514_B, quote = "any property to the extent that the income from such property is excluded by reason of the provisions of paragraph (7), (8), or (9) of section 512(b) in computing the gross income of any unrelated trade or business;")
pub relation debt_financed_property_excluded_514b1C(tb: TradeOrBusiness, o: Person, y: TaxableYear) kind institutional {
    label en official "section 514(b)(1)(C): property excluded from 'debt-financed property' to the extent its income is excluded under section 512(b)(7)/(8)/(9) (research income)";
}
pub relation research_income_activity_514b1C(tb: TradeOrBusiness, o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the trade or business (property) whose income is excluded research income under section 512(b)(8)/(9) — a tb-scoped bridge so section 514(b)(1)(C)'s head binds `tb`";
}
rule DebtFinancedPropertyExcludedVia512b8(tb: TradeOrBusiness, o: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 514(b)(1)(C) via section 512(b)(8) research income";
    when research_income_excluded_512b8(o, y, amount);
    when research_income_activity_514b1C(tb, o, y, amount);
    then debt_financed_property_excluded_514b1C(tb, o, y);
}
rule DebtFinancedPropertyExcludedVia512b9(tb: TradeOrBusiness, o: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 514(b)(1)(C) via section 512(b)(9) research income";
    when research_income_excluded_512b9(o, y, amount);
    when research_income_activity_514b1C(tb, o, y, amount);
    then debt_financed_property_excluded_514b1C(tb, o, y);
}
@source(IRC_S514_B, quote = "any property to the extent that it is used in any trade or business described in paragraph (1), (2), or (3) of section 513(a); or")
pub relation debt_financed_property_excluded_514b1D(tb: TradeOrBusiness, o: Person, y: TaxableYear) kind institutional {
    label en official "section 514(b)(1)(D): property excluded from 'debt-financed property' to the extent used in a section 513(a)(1)-(3) excepted trade or business";
}
rule DebtFinancedPropertyExcluded514b1D(tb: TradeOrBusiness, o: Person, y: TaxableYear) defeasible {
    label en official "section 514(b)(1)(D): section 513(a)(1)-(3) excepted-business property";
    when used_in_513a_excepted_trade_or_business(tb, o, y);
    then debt_financed_property_excluded_514b1D(tb, o, y);
}
pub relation used_in_513a_excepted_trade_or_business(tb: TradeOrBusiness, o: Person, y: TaxableYear) kind empirical {
    label en official "the property is used in a trade or business excepted under section 513(a)(1), (2), or (3) (section 514(b)(1)(D))";
}
@source(IRC_S514_B, quote = "any property the gain or loss from the sale, exchange, or other disposition of which would be excluded by reason of the provisions of section 512(b)(19) in computing the gross income of any unrelated trade or business.")
pub relation debt_financed_property_excluded_514b1E(tb: TradeOrBusiness, o: Person, y: TaxableYear) kind institutional {
    label en official "section 514(b)(1)(E): brownfield property whose gain/loss would be excluded under section 512(b)(19)";
}
pub relation brownfield_activity_514b1E(tb: TradeOrBusiness, o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the trade or business (property) whose gain/loss is excluded brownfield gain/loss under section 512(b)(19) — a tb-scoped bridge so section 514(b)(1)(E)'s head binds `tb`";
}
rule DebtFinancedPropertyExcluded514b1E(tb: TradeOrBusiness, o: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 514(b)(1)(E): section 512(b)(19) brownfield exclusion bridge";
    when brownfield_property_gain_loss_excluded_512b19(o, y, amount);
    when brownfield_activity_514b1E(tb, o, y, amount);
    then debt_financed_property_excluded_514b1E(tb, o, y);
}

// ---------------------------------------------------------------------
// (b)(3): the EXACT 10-year neighborhood-land rule.
// ---------------------------------------------------------------------

pub relation determination_date_514(o: Person, tb: TradeOrBusiness, current_date: Date) kind empirical {
    label en unofficial "the date as of which a section 514(b)(3)/(c)(2) exact time-window test is evaluated (the case's own decision/legal date) — case-asserted rather than an implicit 'today', matching the `basis_as_of`/`holding_period_measured_as_of` convention elsewhere in this corpus";
}

@source(IRC_S514_B, quote = "If an organization acquires real property for the principal purpose of using the land (commencing within 10 years of the time of acquisition) in the manner described in paragraph (1)(A) and at the time of acquisition the property is in the neighborhood of other property owned by the organization which is used in such manner, the real property acquired for such future use shall not be treated as debt-financed property so long as the organization does not abandon its intent to so use the land within the 10-year period.")
pub relation neighborhood_land_not_debt_financed_514b3(o: Person, tb: TradeOrBusiness, acquired_on: Date, current_date: Date) kind institutional {
    label en official "section 514(b)(3)(A): neighborhood land acquired for future exempt use is not debt-financed property so long as the organization has not abandoned that intent, within the EXACT 10-year period from acquisition";
}
pub relation neighborhood_land_acquired_for_future_exempt_use(o: Person, tb: TradeOrBusiness, acquired_on: Date) kind empirical {
    label en official "the organization acquired real property for the principal purpose of future exempt use, in the neighborhood of other property it already owns and so uses (section 514(b)(3)(A))";
}
pub relation abandoned_intent_to_use_land_514b3(o: Person, tb: TradeOrBusiness, acquired_on: Date, current_date: Date) kind empirical {
    label en official "the organization abandoned its intent to use the neighborhood land in the exempt manner (section 514(b)(3)(A), the disqualifying condition)";
}
rule NeighborhoodLandNotDebtFinanced514b3(o: Person, tb: TradeOrBusiness, acquired_on: Date, current_date: Date) defeasible {
    label en official "section 514(b)(3)(A): the EXACT 10-year window — current_date < acquired_on + 10 years, no abandonment";
    when neighborhood_land_acquired_for_future_exempt_use(o, tb, acquired_on);
    when determination_date_514(o, tb, current_date);
    when current_date < add_calendar_period(acquired_on, 10 calendar_year);
    unless abandoned_intent_to_use_land_514b3(o, tb, acquired_on, current_date);
    then neighborhood_land_not_debt_financed_514b3(o, tb, acquired_on, current_date);
}
@source(IRC_S514_B, quote = "shall apply after the first 5 years of the 10-year period only if the organization establishes to the satisfaction of the Secretary that it is reasonably certain that the land will be used in the described manner before the expiration of the 10-year period.")
pub external judgment relation ReasonablyCertainLandWillBeUsedInTime514b3(o: Person, tb: TradeOrBusiness) {
    authority Secretary;
    label en official "the organization establishes to the Secretary's satisfaction that it is reasonably certain the land will be used in the exempt manner before the 10-year period expires (section 514(b)(3)(A), fifth-through-tenth-year requirement) — DECISION-0194 evaluative channel";
}
rule NeighborhoodLandNotDebtFinancedAfterFiveYears514b3(o: Person, tb: TradeOrBusiness, acquired_on: Date, current_date: Date) defeasible {
    label en official "section 514(b)(3)(A), after the first 5 years: the exception continues only with the Secretary's reasonable-certainty determination";
    when neighborhood_land_acquired_for_future_exempt_use(o, tb, acquired_on);
    when determination_date_514(o, tb, current_date);
    when current_date >= add_calendar_period(acquired_on, 5 calendar_year);
    when current_date < add_calendar_period(acquired_on, 10 calendar_year);
    when ReasonablyCertainLandWillBeUsedInTime514b3(o, tb);
    unless abandoned_intent_to_use_land_514b3(o, tb, acquired_on, current_date);
    then neighborhood_land_not_debt_financed_514b3(o, tb, acquired_on, current_date);
}

// ---------------------------------------------------------------------
// (c)(2): mortgaged real_prop acquired subject to a mortgage, with the
// bequest/devise and gift-mortgage 10-year exceptions.
// ---------------------------------------------------------------------

@source(IRC_S514_C, quote = "Where property (no matter how acquired) is acquired subject to a mortgage or other similar lien, the amount of the indebtedness secured by such mortgage or lien shall be considered as an indebtedness of the organization incurred in acquiring such property even though the organization did not assume or agree to pay such indebtedness.")
pub relation mortgage_indebtedness_treated_as_acquisition_indebtedness_514c2A(o: Person, tb: TradeOrBusiness, amount: Money) kind institutional {
    label en official "section 514(c)(2)(A): indebtedness secured by a mortgage or similar lien on acquired property is treated as acquisition indebtedness, even without assumption";
}
pub relation acquired_subject_to_mortgage_or_lien(o: Person, tb: TradeOrBusiness, amount: Money) kind empirical {
    label en official "the property was acquired subject to a mortgage or similar lien securing this amount (section 514(c)(2)(A))";
}
@source(IRC_S514_C, quote = "Where property subject to a mortgage is acquired by an organization by bequest or devise, the indebtedness secured by the mortgage shall not be treated as acquisition indebtedness during a period of 10 years following the date of the acquisition.")
pub relation bequest_devise_mortgage_exception_514c2B(o: Person, tb: TradeOrBusiness, acquired_on: Date) kind empirical {
    label en official "the mortgaged property was acquired by bequest or devise (section 514(c)(2)(B), first sentence) — the EXACT 10-year exception window runs from the acquisition date";
}
@source(IRC_S514_C, quote = "If an organization acquires property by gift subject to a mortgage which was placed on the property more than 5 years before the gift, which property was held by the donor more than 5 years before the gift, the indebtedness secured by such mortgage shall not be treated as acquisition indebtedness during a period of 10 years following the date of such gift.")
pub relation gift_mortgage_exception_514c2B(o: Person, tb: TradeOrBusiness, gift_on: Date, mortgage_placed_on: Date, donor_held_since: Date) kind empirical {
    label en official "the mortgaged property was acquired by gift, the mortgage placed more than 5 years before the gift and the property held by the donor more than 5 years before the gift (section 514(c)(2)(B), second sentence) — the EXACT 10-year exception window runs from the gift date";
}
pub relation organization_assumed_or_paid_for_equity_514c2B(o: Person, tb: TradeOrBusiness, current_date: Date) kind empirical {
    label en official "the organization assumed and agreed to pay the mortgage indebtedness to acquire the equity, or made a payment for the equity (section 514(c)(2)(B), third sentence) — disqualifies the bequest/devise/gift exception";
}
rule MortgageIndebtednessNotAcquisitionIndebtednessBequestDevise514c2B(o: Person, tb: TradeOrBusiness, acquired_on: Date, current_date: Date) defeasible {
    label en official "section 514(c)(2)(B): bequest/devise mortgage exception, EXACT 10-year window from acquisition";
    when bequest_devise_mortgage_exception_514c2B(o, tb, acquired_on);
    when determination_date_514(o, tb, current_date);
    when current_date < add_calendar_period(acquired_on, 10 calendar_year);
    unless organization_assumed_or_paid_for_equity_514c2B(o, tb, current_date);
    then mortgage_not_acquisition_indebtedness_514c2B(o, tb, current_date);
}
rule MortgageIndebtednessNotAcquisitionIndebtednessGift514c2B(o: Person, tb: TradeOrBusiness, gift_on: Date, mortgage_placed_on: Date, donor_held_since: Date, current_date: Date) defeasible {
    label en official "section 514(c)(2)(B): gift mortgage exception, both 5-year predicate periods plus the EXACT 10-year window from the gift date";
    when gift_mortgage_exception_514c2B(o, tb, gift_on, mortgage_placed_on, donor_held_since);
    when determination_date_514(o, tb, current_date);
    when add_calendar_period(mortgage_placed_on, 5 calendar_year) < gift_on;
    when add_calendar_period(donor_held_since, 5 calendar_year) < gift_on;
    when current_date < add_calendar_period(gift_on, 10 calendar_year);
    unless organization_assumed_or_paid_for_equity_514c2B(o, tb, current_date);
    then mortgage_not_acquisition_indebtedness_514c2B(o, tb, current_date);
}
pub relation mortgage_not_acquisition_indebtedness_514c2B(o: Person, tb: TradeOrBusiness, current_date: Date) kind institutional {
    label en official "section 514(c)(2)(B): the mortgage indebtedness is NOT treated as acquisition indebtedness for the applicable 10-year period";
}

// ---------------------------------------------------------------------
// (c)(3): extension/renewal/refinancing is not a new indebtedness.
// ---------------------------------------------------------------------

@source(IRC_S514_C, quote = "an extension, renewal, or refinancing of an obligation evidencing a pre-existing indebtedness shall not be treated as the creation of a new indebtedness.")
pub relation extension_renewal_refinancing_not_new_indebtedness_514c3(o: Person, obligation: Text) kind institutional {
    label en official "section 514(c)(3): an extension, renewal, or refinancing of a pre-existing indebtedness's obligation is not a new indebtedness";
}
rule ExtensionRenewalRefinancingNotNewIndebtedness514c3(o: Person, obligation: Text) defeasible {
    label en official "section 514(c)(3)";
    when extension_renewal_or_refinancing_of_preexisting_obligation(o, obligation);
    then extension_renewal_refinancing_not_new_indebtedness_514c3(o, obligation);
}
pub relation extension_renewal_or_refinancing_of_preexisting_obligation(o: Person, obligation: Text) kind empirical {
    label en official "the obligation is an extension, renewal, or refinancing of a pre-existing indebtedness's obligation (section 514(c)(3))";
}

// ---------------------------------------------------------------------
// (c)(4): indebtedness inherent in the exempt purpose (e.g. credit union
// member deposits) is not acquisition indebtedness.
// ---------------------------------------------------------------------

@source(IRC_S514_C, quote = "the term \"acquisition indebtedness\" does not include indebtedness the incurrence of which is inherent in the performance or exercise of the purpose or function constituting the basis of the organization's exemption, such as the indebtedness incurred by a credit union described in section 501(c)(14) in accepting deposits from its members.")
pub relation indebtedness_inherent_in_exempt_purpose_514c4(o: Person, indebtedness: Text) kind institutional {
    label en official "section 514(c)(4): indebtedness inherent in performing the organization's exempt purpose is not acquisition indebtedness (e.g. a section 501(c)(14) credit union's member deposits)";
}
pub relation indebtedness_inherent_in_organizations_exempt_function(o: Person, indebtedness: Text) kind empirical {
    label en official "the indebtedness's incurrence is inherent in performing or exercising the organization's exempt purpose or function (section 514(c)(4))";
}
rule IndebtednessInherentInExemptPurpose514c4(o: Person, indebtedness: Text) defeasible {
    label en official "section 514(c)(4)";
    when indebtedness_inherent_in_organizations_exempt_function(o, indebtedness);
    then indebtedness_inherent_in_exempt_purpose_514c4(o, indebtedness);
}

// ---------------------------------------------------------------------
// (c)(9): real real_prop acquired by a QUALIFIED ORGANIZATION — the
// flagship item, with the six (B) exception conditions.
// ---------------------------------------------------------------------

@source(IRC_S514_C, quote = "Except as provided in subparagraph (B), the term \"acquisition indebtedness\" does not, for purposes of this section, include indebtedness incurred by a qualified organization in acquiring or improving any real property.")
pub relation real_property_qualified_organization_indebtedness_excluded_514c9(o: Person, real_prop: Asset) kind institutional {
    label en official "section 514(c)(9)(A): indebtedness incurred by a qualified organization to acquire or improve real property is NOT acquisition indebtedness, unless one of the six (B) exceptions applies";
}
@source(IRC_S514_C, quote = "the term \"qualified organization\" means—\n(i) an organization described in section 170(b)(1)(A)(ii) and its affiliated support organizations described in section 509(a)(3);\n(ii) any trust which constitutes a qualified trust under section 401;\n(iii) an organization described in section 501(c)(25); or\n(iv) a retirement income account described in section 403(b)(9).")
pub relation qualified_organization_514c9C(o: Person) kind institutional {
    label en official "section 514(c)(9)(C): a qualified organization — a section 170(b)(1)(A)(ii) educational organization (or its section 509(a)(3) affiliated support organization), a section 401 qualified trust, a section 501(c)(25) organization, or a section 403(b)(9) retirement income account";
}
rule QualifiedOrgViaEducational514c9C(o: Person) defeasible { label en official "section 514(c)(9)(C)(i): section 170(b)(1)(A)(ii) educational organization"; when educational_organization_170b1Aii(o); then qualified_organization_514c9C(o); }
rule QualifiedOrgViaSupportOrg514c9C(o: Person, supported_org: Person) defeasible { label en official "section 514(c)(9)(C)(i): a section 509(a)(3) affiliated support organization of a section 170(b)(1)(A)(ii) educational organization"; when supported_organization_509f3(o, supported_org); when educational_organization_170b1Aii(supported_org); when supporting_organization_type(o, TypeI); then qualified_organization_514c9C(o); }
rule QualifiedOrgViaQualifiedTrust514c9C(o: Person) defeasible { label en official "section 514(c)(9)(C)(ii): a section 401 qualified trust"; when section_401a_qualified_trust(o); then qualified_organization_514c9C(o); }
rule QualifiedOrgViaC25_514c9C(o: Person, y: TaxableYear) defeasible { label en official "section 514(c)(9)(C)(iii): a section 501(c)(25) organization"; when section_501c25(o, y); then qualified_organization_514c9C(o); }
rule QualifiedOrgVia403b9_514c9C(o: Person) defeasible { label en official "section 514(c)(9)(C)(iv): a section 403(b)(9) retirement income account"; when retirement_income_account_403b9(o); then qualified_organization_514c9C(o); }
pub relation educational_organization_170b1Aii(o: Person) kind empirical {
    label en unofficial "the organization is described in section 170(b)(1)(A)(ii) (an educational organization) — case-asserted, section 170(b)(1)(A) not independently decomposed by this package (EXTERNAL_DEPENDENCY, us.irc.deductions)";
}
pub relation section_401a_qualified_trust(o: Person) kind empirical {
    label en unofficial "the trust constitutes a qualified trust under section 401 — EXTERNAL_DEPENDENCY, us.irc.deferred_compensation";
}
pub relation retirement_income_account_403b9(o: Person) kind empirical {
    label en unofficial "the account is a retirement income account described in section 403(b)(9) — EXTERNAL_DEPENDENCY, us.irc.deferred_compensation";
}

// The six (B) exception conditions, each an independent `unless` defeater.
@source(IRC_S514_C, quote = "the price for the acquisition or improvement is not a fixed amount determined as of the date of the acquisition or the completion of the improvement;")
pub relation price_not_fixed_as_of_acquisition_514c9Bi(o: Person, real_prop: Asset) kind empirical {
    label en official "section 514(c)(9)(B)(i): the price is not a fixed amount determined as of the acquisition/improvement-completion date";
}
@source(IRC_S514_C, quote = "the amount of any indebtedness or any other amount payable with respect to such indebtedness, or the time for making any payment of any such amount, is dependent, in whole or in part, upon any revenue, income, or profits derived from such real property;")
pub relation payment_dependent_on_property_income_514c9Bii(o: Person, real_prop: Asset) kind empirical {
    label en official "section 514(c)(9)(B)(ii): the indebtedness payment amount or timing depends on revenue/income/profits from the property";
}
@source(IRC_S514_C, quote = "the real property is at any time after the acquisition leased by the qualified organization to the person selling such property to such organization or to any person who bears a relationship described in section 267(b) or 707(b) to such person;")
pub relation leased_back_to_seller_or_related_person_514c9Biii(o: Person, real_prop: Asset) kind empirical {
    label en official "section 514(c)(9)(B)(iii): the property is leased back to the seller or a section 267(b)/707(b)-related person";
}
@source(IRC_S514_C, quote = "the real property is acquired by a qualified trust from, or is at any time after the acquisition leased by such trust to, any person who—\n(I) bears a relationship which is described in subparagraph (C), (E), or (G) of section 4975(e)(2) to any plan with respect to which such trust was formed, or")
pub relation qualified_trust_transaction_with_4975e2_related_person_514c9Biv(o: Person, real_prop: Asset) kind empirical {
    label en official "section 514(c)(9)(B)(iv): a qualified trust acquires from, or leases to, a section 4975(e)(2)(C)/(E)/(F)/(G)/(H)-related person";
}
@source(IRC_S514_C, quote = "any person described in clause (iii) or (iv) provides the qualified organization with financing in connection with the acquisition or improvement; or")
pub relation seller_or_related_person_provides_financing_514c9Bv(o: Person, real_prop: Asset) kind empirical {
    label en official "section 514(c)(9)(B)(v): a (iii)/(iv) person provides the financing for the acquisition or improvement";
}
@source(IRC_S514_C, quote = "the real property is held by a partnership unless the partnership meets the requirements of clauses (i) through (v) and unless—\n(I) all of the partners of the partnership are qualified organizations,")
pub relation partnership_held_property_fails_partner_requirements_514c9Bvi(o: Person, real_prop: Asset) kind empirical {
    label en official "section 514(c)(9)(B)(vi): the property is held by a partnership that fails clauses (i)-(v) or the all-qualified-organizations/qualified-allocation/subparagraph-(E) partner tests";
}
rule RealPropertyQualifiedOrganizationIndebtednessExcluded514c9(o: Person, real_prop: Asset) defeasible {
    label en official "section 514(c)(9)(A)-(B): the real-property-of-qualified-organizations exclusion, defeated by any of the SIX (B) exception conditions";
    when qualified_organization_514c9C(o);
    when real_property_acquired_or_improved_by_indebtedness_514c9(o, real_prop);
    unless price_not_fixed_as_of_acquisition_514c9Bi(o, real_prop);
    unless payment_dependent_on_property_income_514c9Bii(o, real_prop);
    unless leased_back_to_seller_or_related_person_514c9Biii(o, real_prop);
    unless qualified_trust_transaction_with_4975e2_related_person_514c9Biv(o, real_prop);
    unless seller_or_related_person_provides_financing_514c9Bv(o, real_prop);
    unless partnership_held_property_fails_partner_requirements_514c9Bvi(o, real_prop);
    unless payment_terms_depend_on_property_income_514c9Bii_derived(o, real_prop);
    unless pass_thru_held_property_fails_partner_requirements_514c9D(o, real_prop);
    then real_property_qualified_organization_indebtedness_excluded_514c9(o, real_prop);
}
pub relation real_property_acquired_or_improved_by_indebtedness_514c9(o: Person, real_prop: Asset) kind empirical {
    label en official "the organization incurred indebtedness to acquire or improve this real property (section 514(c)(9)(A))";
}
