// Section 512(a)(3) (the alternate UBTI definition for section 501(c)(7)/
// (9)/(17) organizations) and section 512(b)'s remaining modifications
// (5),(6),(8)-(11),(13),(15)-(19) — STAGE 2b (25.09.2026), closing part of
// TECH-GAPS G74. (1),(2),(3),(4),(7),(12) were modelled in stage 1
// (06-ubit-511-512-513-514.law); (14) is REPEALED (no rule).
//
// METHOD, unchanged from stage 1's judgment call: each exclusion/inclusion
// modification is its own case-asserted Money amount (already reflecting
// the modification), NOT netted automatically into a single running total
// — the net UBTI figure remains a case-asserted amount this stage, per
// the stage-1 note under `gross_income_from_business`/`directly_connected_
// deductions`. Deep sub-lettered detail within each paragraph ((13)(E)'s
// section-482 excess-payment computation, (16)'s financial-institution
// property detail, (17)(B)'s affiliate rules, (19)(B)-(E)'s brownfield
// eligibility/certification detail) is NOT decomposed — TECH-GAPS G488.

// ---------------------------------------------------------------------
// (a)(3): alternate UBTI definition for section 501(c)(7)/(9)/(17) orgs.
// ---------------------------------------------------------------------

use self::{
    Asset,
    Corporation,
    IRC_S512_A,
    IRC_S512_B,
    Person,
    TaxableYear,
    TradeOrBusiness,
    Trust,
    benevolent_insurance_or_mutual_utility_organization,
    section_501c17,
    section_501c7,
    section_501c9,
    section_511a_covered_organization,
    section_511b_trust,
};

@source(IRC_S512_A, quote = "In the case of an organization described in paragraph (7), (9), or (17) of section 501(c), the term \"unrelated business taxable income\" means the gross income (excluding any exempt function income), less the deductions allowed by this chapter which are directly connected with the production of the gross income (excluding exempt function income), both computed with the modifications provided in paragraphs (6), (10), (11), and (12) of subsection (b).")
pub relation unrelated_business_taxable_income_512a3(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 512(a)(3)(A): for a section 501(c)(7)/(9)/(17) organization, UBTI is gross income (excluding exempt function income) less directly connected deductions (excluding exempt function income), with the (b)(6)/(10)/(11)/(12) modifications";
}
pub relation section_501c_7_9_or_17_organization(o: Person) kind institutional {
    label en official "the organization is described in paragraph (7), (9), or (17) of section 501(c), for section 512(a)(3)";
}
rule Section501c_7_9_17_OrganizationViaC7(o: Person, y: TaxableYear) defeasible { label en official "section 512(a)(3): a section 501(c)(7) organization"; when section_501c7(o, y); then section_501c_7_9_or_17_organization(o); }
rule Section501c_7_9_17_OrganizationViaC9(o: Person, y: TaxableYear) defeasible { label en official "section 512(a)(3): a section 501(c)(9) organization"; when section_501c9(o, y); then section_501c_7_9_or_17_organization(o); }
rule Section501c_7_9_17_OrganizationViaC17(o: Person, y: TaxableYear) defeasible { label en official "section 512(a)(3): a section 501(c)(17) organization"; when section_501c17(o, y); then section_501c_7_9_or_17_organization(o); }

pub relation gross_income_excluding_exempt_function_512a3(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "gross income excluding exempt function income, for section 512(a)(3)(A)";
}
pub relation deductions_directly_connected_excluding_exempt_function_512a3(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "deductions directly connected with the production of the gross income, excluding exempt function income, before the (b)(6)/(10)/(11)/(12) modifications, for section 512(a)(3)(A)";
}
rule UnrelatedBusinessTaxableIncome512a3(o: Person, y: TaxableYear, gross: Money, deductions: Money) defeasible {
    label en official "section 512(a)(3)(A): UBTI for a section 501(c)(7)/(9)/(17) organization";
    when section_501c_7_9_or_17_organization(o);
    when gross_income_excluding_exempt_function_512a3(o, y, gross);
    when deductions_directly_connected_excluding_exempt_function_512a3(o, y, deductions);
    then unrelated_business_taxable_income_512a3(o, y, max(0.00 USD, gross - deductions));
}

@source(IRC_S512_A, quote = "the term \"exempt function income\" means the gross income from dues, fees, charges, or similar amounts paid by members of the organization as consideration for providing such members or their dependents or guests goods, facilities, or services in furtherance of the purposes constituting the basis for the exemption of the organization to which such income is paid.")
pub relation member_dues_exempt_function_income_512a3B(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 512(a)(3)(B), first sentence: gross income from member dues/fees/charges paid in consideration for goods/facilities/services furthering the organization's exempt purposes";
}
@source(IRC_S512_A, quote = "Such term also means all income (other than an amount equal to the gross income derived from any unrelated trade or business regularly carried on by such organization computed as if the organization were subject to paragraph (1)), which is set aside—\n(i) for a purpose specified in section 170(c)(4), or\n(ii) in the case of an organization described in paragraph (9) or (17) of section 501(c), to provide for the payment of life, sick, accident, or other benefits,")
pub relation set_aside_for_170c4_or_veba_sub_benefits_512a3B(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 512(a)(3)(B), second sentence: income set aside for a section 170(c)(4) purpose, or (for a (c)(9)/(17) organization) to provide life/sick/accident/other benefits — excluding the organization's own section 512(a)(1)-style unrelated-business gross income (subject to the (E) set-aside limitation, TECH-GAPS G488)";
}
pub relation exempt_function_income_512a3B(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 512(a)(3)(B): the organization's total exempt function income (member dues/fees plus the qualifying set-aside)";
}
rule ExemptFunctionIncome512a3B(o: Person, y: TaxableYear, dues: Money, set_aside: Money) defeasible {
    label en official "section 512(a)(3)(B): exempt function income is member dues/fees plus the qualifying set-aside";
    when member_dues_exempt_function_income_512a3B(o, y, dues);
    when set_aside_for_170c4_or_veba_sub_benefits_512a3B(o, y, set_aside);
    then exempt_function_income_512a3B(o, y, dues + set_aside);
}

// ---------------------------------------------------------------------
// (b)(5): exclusion of gains/losses on property other than inventory/
// dealer property, plus investment-activity option-lapse/good-faith-
// deposit gains/losses (the timber carve-out is NOT modelled — TECH-GAPS
// G488).
// ---------------------------------------------------------------------

@source(IRC_S512_B, quote = "There shall be excluded all gains or losses from the sale, exchange, or other disposition of property other than—\n(A) stock in trade or other property of a kind which would properly be includible in inventory if on hand at the close of the taxable year, or\n(B) property held primarily for sale to customers in the ordinary course of the trade or business.")
pub relation capital_gain_loss_excluded_512b5(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 512(b)(5): gain or loss from the sale, exchange, or other disposition of property other than inventory-type or dealer property, excluded from UBTI";
}
pub relation property_is_inventory_or_dealer_property_512b5(o: Person, asset: Asset) kind empirical {
    label en unofficial "the property is inventory-type property (section 512(b)(5)(A)) or dealer property held primarily for sale to customers (section 512(b)(5)(B)) — the disqualifying condition for the (b)(5) exclusion";
}

// ---------------------------------------------------------------------
// (b)(6): net operating loss deduction under section 172, with the
// unrelated-business-income-only computation and the "preceding taxable
// year" limitation. The section 172 NOL computation itself is owned by
// `us.irc.accounting` — imported by reference, not duplicated.
// ---------------------------------------------------------------------

@source(IRC_S512_B, quote = "The net operating loss deduction provided in section 172 shall be allowed, except that—\n(A) the net operating loss for any taxable year, the amount of the net operating loss carryback or carryover to any taxable year, and the net operating loss deduction for any taxable year shall be determined under section 172 without taking into account any amount of income or deduction which is excluded under this part in computing the unrelated business taxable income; and")
pub relation unrelated_business_net_operating_loss_deduction_512b6(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 512(b)(6): the section 172 net operating loss deduction, recomputed on an unrelated-business-income-only basis (case-asserted; the section 172 mechanics themselves are us.irc.accounting's, not duplicated here — EXTERNAL_DEPENDENCY contract)";
}
pub relation unrelated_business_activity_prior_year_512b6B(o: Person, y: TaxableYear) kind empirical {
    label en official "section 512(b)(6)(B): the organization was subject to part II (the UBIT part) for this prior taxable year, so it counts as a 'preceding taxable year' for the section 172 carryback/carryover";
}

// ---------------------------------------------------------------------
// (b)(8),(9): research income exclusions broader than (b)(7)'s government-
// only rule.
// ---------------------------------------------------------------------

@source(IRC_S512_B, quote = "In the case of a college, university, or hospital, there shall be excluded all income derived from research performed for any person, and all deductions directly connected with such income.")
pub relation college_university_or_hospital_512b8(o: Person) kind empirical {
    label en official "the organization is a college, university, or hospital (section 512(b)(8))";
}
pub relation research_income_from_any_person_excluded_512b8(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "income derived from research performed for any person, and directly connected deductions, excluded under section 512(b)(8) for a college/university/hospital";
}
pub relation research_income_excluded_512b8(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 512(b)(8): the college/university/hospital's research-income exclusion";
}
rule ResearchIncomeExcluded512b8(o: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 512(b)(8): a college, university, or hospital excludes research income from any person";
    when college_university_or_hospital_512b8(o);
    when research_income_from_any_person_excluded_512b8(o, y, amount);
    then research_income_excluded_512b8(o, y, amount);
}
@source(IRC_S512_B, quote = "In the case of an organization operated primarily for purposes of carrying on fundamental research the results of which are freely available to the general public, there shall be excluded all income derived from research performed for any person, and all deductions directly connected with such income.")
pub relation organization_operated_primarily_for_fundamental_research_512b9(o: Person) kind empirical {
    label en official "the organization is operated primarily for carrying on fundamental research, the results of which are freely available to the general public (section 512(b)(9))";
}
pub relation research_income_excluded_512b9(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 512(b)(9): the fundamental-research organization's research-income exclusion";
}
rule ResearchIncomeExcluded512b9(o: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 512(b)(9): a fundamental-research organization excludes research income from any person";
    when organization_operated_primarily_for_fundamental_research_512b9(o);
    when research_income_from_any_person_excluded_512b8(o, y, amount);
    then research_income_excluded_512b9(o, y, amount);
}

// ---------------------------------------------------------------------
// (b)(10),(11): charitable deduction for section 511(a)/(b) organizations,
// 10 percent EXACT cap for (10), section 170(b)(1)(A)/(B) limitations for
// (11).
// ---------------------------------------------------------------------

@source(IRC_S512_B, quote = "In the case of any organization described in section 511(a), the deduction allowed by section 170 (relating to charitable etc. contributions and gifts) shall be allowed (whether or not directly connected with the carrying on of the trade or business), but shall not exceed 10 percent of the unrelated business taxable income computed without the benefit of this paragraph.")
pub relation charitable_deduction_512b10(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 512(b)(10): the section 170 charitable deduction for a section 511(a) organization, capped at 10 percent of UBTI computed without this paragraph — exact, no rounding of the percentage itself";
}
pub relation section_170_contribution_amount_512b10(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the section 170 charitable contribution amount otherwise allowable, for section 512(b)(10)/(11)";
}
pub relation ubti_before_512b10_deduction(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "UBTI computed without the benefit of section 512(b)(10), for the 10 percent cap";
}
rule CharitableDeduction512b10(o: Person, y: TaxableYear, contribution: Money, ubti_before: Money) defeasible {
    label en official "section 512(b)(10): the lesser of the section 170 contribution or 10 percent of UBTI computed without this paragraph";
    when section_511a_covered_organization(o, y);
    when section_170_contribution_amount_512b10(o, y, contribution);
    when ubti_before_512b10_deduction(o, y, ubti_before);
    when contribution * 10 <= ubti_before;
    then charitable_deduction_512b10(o, y, contribution);
}
rule CharitableDeduction512b10Capped(o: Person, y: TaxableYear, contribution: Money, ubti_before: Money) defeasible {
    label en official "section 512(b)(10): the 10-percent-of-UBTI cap controls when the contribution exceeds it — exact cross-multiplication, no division";
    when section_511a_covered_organization(o, y);
    when section_170_contribution_amount_512b10(o, y, contribution);
    when ubti_before_512b10_deduction(o, y, ubti_before);
    when contribution * 10 > ubti_before;
    then charitable_deduction_512b10(o, y, round(ubti_before * 0.10, 2, "HALF_UP"));
}
@source(IRC_S512_B, quote = "In the case of any trust described in section 511(b), the deduction allowed by section 170 (relating to charitable etc. contributions and gifts) shall be allowed (whether or not directly connected with the carrying on of the trade or business), and for such purpose a distribution made by the trust to a beneficiary described in section 170 shall be considered as a gift or contribution.")
pub relation charitable_deduction_512b11(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 512(b)(11): the section 170 charitable deduction for a section 511(b) trust, with the section 170(b)(1)(A)/(B) limitations applied against UBTI computed without this paragraph in lieu of AGI — the section 170(b) limitation computation itself is a case-asserted figure (TECH-GAPS G488)";
}
pub relation distribution_to_170_beneficiary_treated_as_gift_512b11(t: Trust, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 512(b)(11): a distribution by a section 511(b) trust to a section 170 beneficiary is considered a gift or contribution for the section 512(b)(11) deduction";
}
rule DistributionTreatedAsGift512b11(t: Trust, y: TaxableYear, amount: Money) defeasible {
    label en official "section 512(b)(11): distribution-as-gift treatment";
    when section_511b_trust(t, y);
    when distribution_to_170_beneficiary_512b11(t, y, amount);
    then distribution_to_170_beneficiary_treated_as_gift_512b11(t, y, amount);
}
pub relation distribution_to_170_beneficiary_512b11(t: Trust, y: TaxableYear, amount: Money) kind empirical {
    label en official "a distribution made by a section 511(b) trust to a beneficiary described in section 170, for section 512(b)(11)";
}
pub relation charitable_deduction_512b11_limited_amount(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the section 170(b)(1)(A)/(B)-limited charitable deduction amount for a section 511(b) trust, case-asserted rather than derived from the section 170(b) limitation machinery (TECH-GAPS G488)";
}
rule CharitableDeduction512b11(o: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 512(b)(11): the trust's charitable deduction, section-170(b)-limited";
    when section_511b_trust(o, y);
    when charitable_deduction_512b11_limited_amount(o, y, amount);
    then charitable_deduction_512b11(o, y, amount);
}

// ---------------------------------------------------------------------
// (b)(13): controlled-entity specified payments — the flagship item.
// ---------------------------------------------------------------------

@source(IRC_S512_B, quote = "If an organization (in this paragraph referred to as the \"controlling organization\") receives or accrues (directly or indirectly) a specified payment from another entity which it controls (in this paragraph referred to as the \"controlled entity\"), notwithstanding paragraphs (1), (2), and (3), the controlling organization shall include such payment as an item of gross income derived from an unrelated trade or business to the extent such payment reduces the net unrelated income of the controlled entity (or increases any net unrelated loss of the controlled entity).")
pub relation controlled_entity_specified_payment_included_512b13(controlling: Person, controlled: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 512(b)(13)(A): a specified payment (interest, annuity, royalty, or rent) the controlling organization receives from a controlled entity is included in UBTI to the extent it reduces the controlled entity's net unrelated income (or increases its net unrelated loss)";
}
pub relation specified_payment_received_from_controlled_entity(controlling: Person, controlled: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 512(b)(13)(C): an interest, annuity, royalty, or rent payment the controlling organization receives or accrues from the controlled entity";
}
pub relation net_unrelated_income_reduction_from_payment(controlled: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 512(b)(13)(B): the extent to which the specified payment reduces the controlled entity's net unrelated income (or increases its net unrelated loss)";
}
rule ControlledEntitySpecifiedPaymentIncluded512b13(controlling: Person, controlled: Person, y: TaxableYear, reduction: Money) defeasible {
    label en official "section 512(b)(13)(A): inclusion equal to the net-unrelated-income reduction attributable to the specified payment";
    when specified_payment_received_from_controlled_entity(controlling, controlled, y, _);
    when controls_entity_512b13D(controlling, controlled);
    when net_unrelated_income_reduction_from_payment(controlled, y, reduction);
    then controlled_entity_specified_payment_included_512b13(controlling, controlled, y, reduction);
}
@source(IRC_S512_B, quote = "The term \"control\" means—\n(I) in the case of a corporation, ownership (by vote or value) of more than 50 percent of the stock in such corporation,\n(II) in the case of a partnership, ownership of more than 50 percent of the profits interests or capital interests in such partnership, or\n(III) in any other case, ownership of more than 50 percent of the beneficial interests in the entity.")
pub relation controls_entity_512b13D(controlling: Person, controlled: Person) kind institutional {
    label en official "section 512(b)(13)(D): control of the entity — more than 50 percent of stock (corporation), profits/capital interests (partnership), or beneficial interests (other entity)";
}
rule ControlsCorporationViaStock512b13D(controlling: Person, controlled: Corporation, share: Decimal, via: us.irc.corporations::AttributionKind) defeasible {
    label en official "section 512(b)(13)(D)(i)(I)/(ii): control of a corporation by more than 50 percent stock ownership, applying section 318 constructive ownership per (D)(ii)";
    when us.irc.corporations::constructive_ownership(controlling, controlled, share, via);
    when share > 0.50;
    then controls_entity_512b13D(controlling, controlled);
}
pub relation ownership_share_of_other_entity_512b13D(controlling: Person, controlled: Person, share: Decimal) kind empirical {
    label en unofficial "the controlling person's ownership share of profits/capital interests (partnership) or beneficial interests (other entity), for section 512(b)(13)(D)(i)(II)-(III) — case-asserted since no partnership/other-entity constructive-ownership import exists in this package";
}
rule ControlsOtherEntityViaShare512b13D(controlling: Person, controlled: Person, share: Decimal) defeasible {
    label en official "section 512(b)(13)(D)(i)(II)-(III): control of a partnership or other entity by more than 50 percent of profits/capital/beneficial interests";
    when ownership_share_of_other_entity_512b13D(controlling, controlled, share);
    when share > 0.50;
    then controls_entity_512b13D(controlling, controlled);
}

// ---------------------------------------------------------------------
// (b)(15): religious-order licensed-service trade or business, with the
// EXACT less-than-10-percent test.
// ---------------------------------------------------------------------

@source(IRC_S512_B, quote = "Except as provided in paragraph (4), in the case of a trade or business—\n(A) which consists of providing services under license issued by a Federal regulatory agency,\n(B) which is carried on by a religious order or by an educational organization described in section 170(b)(1)(A)(ii) maintained by such religious order, and which was so carried on before May 27, 1959, and\n(C) less than 10 percent of the net income of which for each taxable year is used for activities which are not related to the purpose constituting the basis for the religious order's exemption,\nthere shall be excluded all gross income derived from such trade or business and all deductions directly connected with the carrying on of such trade or business")
pub relation religious_order_licensed_service_trade_excluded_512b15(o: Person, tb: TradeOrBusiness, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 512(b)(15): gross income and directly connected deductions of a pre-1959 religious-order/affiliated-school federally licensed service business, less than 10 percent of whose net income funds unrelated activities, excluded from UBTI, subject to Secretary satisfaction on competitive rates";
}
pub relation licensed_service_business_by_religious_order_pre_1959(o: Person, tb: TradeOrBusiness) kind empirical {
    label en official "the trade or business provides services under a Federal regulatory agency license, carried on by a religious order (or its affiliated section 170(b)(1)(A)(ii) educational organization) before May 27, 1959 (section 512(b)(15)(A)-(B))";
}
pub relation net_income_percentage_512b15(o: Person, tb: TradeOrBusiness, y: TaxableYear, unrelated_use: Money, net_income: Money) kind empirical {
    label en official "the portion of net income used for activities unrelated to the religious order's exempt purpose, and total net income, for the section 512(b)(15)(C) less-than-10-percent test";
}
pub external judgment relation RatesCompetitiveWithNonExemptProviders512b15(o: Person, tb: TradeOrBusiness, y: TaxableYear) {
    authority Secretary;
    label en official "the Secretary is satisfied that the rates/charges for the licensed services are competitive with rates charged by non-exempt providers (section 512(b)(15), flush language) — DECISION-0194 evaluative channel";
}
pub relation gross_income_and_deductions_512b15(o: Person, tb: TradeOrBusiness, y: TaxableYear, amount: Money) kind empirical {
    label en official "the trade or business's gross income (and directly connected deductions, netted) for section 512(b)(15)";
}
rule ReligiousOrderLicensedServiceExcluded512b15(o: Person, tb: TradeOrBusiness, y: TaxableYear, unrelated_use: Money, net_income: Money, amount: Money) defeasible {
    label en official "section 512(b)(15): the less-than-10-percent test is exact cross-multiplication (100 * unrelated-use < 10 * net income), no division";
    when licensed_service_business_by_religious_order_pre_1959(o, tb);
    when net_income_percentage_512b15(o, tb, y, unrelated_use, net_income);
    when unrelated_use * 100 < net_income * 10;
    when RatesCompetitiveWithNonExemptProviders512b15(o, tb, y);
    when gross_income_and_deductions_512b15(o, tb, y, amount);
    then religious_order_licensed_service_trade_excluded_512b15(o, tb, y, amount);
}

// ---------------------------------------------------------------------
// (b)(16): financial-institution-conservatorship real property. TOP LEVEL
// only — the exact 9-month designation window and 30-month/20-percent-
// improvement tests are NOT decomposed (TECH-GAPS G488).
// ---------------------------------------------------------------------

@source(IRC_S512_B, quote = "Notwithstanding paragraph (5)(B), there shall be excluded all gains or losses from the sale, exchange, or other disposition of any real property described in subparagraph (B) if—")
pub relation financial_institution_conservatorship_property_gain_excluded_512b16(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "section 512(b)(16): gain or loss on financial-institution-conservatorship real property, excluded from UBTI — case-asserted as a compound fact (the (A)(i)-(iv)/(B) acquisition-source/designation-window/disposition-timing/improvement-limit conditions are not separately decomposed, TECH-GAPS G488)";
}

// ---------------------------------------------------------------------
// (b)(17): foreign-corporation insurance income inclusion. TOP LEVEL; the
// (B) affiliate exception and (C) regulatory-chain rules are NOT
// decomposed (TECH-GAPS G488).
// ---------------------------------------------------------------------

@source(IRC_S512_B, quote = "Notwithstanding paragraph (1), any amount included in gross income under section 951(a)(1)(A) shall be included as an item of gross income derived from an unrelated trade or business to the extent the amount so included is attributable to insurance income (as defined in section 953) which, if derived directly by the organization, would be treated as gross income from an unrelated trade or business.")
pub relation foreign_corporation_insurance_income_included_512b17(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 512(b)(17)(A): section 951(a)(1)(A) subpart F income attributable to section 953 insurance income, which would be UBTI if earned directly, is included in UBTI";
}
pub relation section_951a1A_amount_attributable_to_953_insurance_income(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount included in gross income under section 951(a)(1)(A) attributable to section 953 insurance income that would be UBTI if earned directly (section 512(b)(17)(A))";
}
pub relation section_512b17B_exception_applies(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the section 512(b)(17)(B) exception applies (insured is the organization itself, an exempt affiliate, or a covered director/officer/service-performer) — case-asserted, not decomposed (TECH-GAPS G488)";
}
rule ForeignCorporationInsuranceIncomeIncluded512b17(o: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 512(b)(17)(A), subject to the (B) exception";
    when section_951a1A_amount_attributable_to_953_insurance_income(o, y, amount);
    unless section_512b17B_exception_applies(o, y, amount);
    then foreign_corporation_insurance_income_included_512b17(o, y, amount);
}

// ---------------------------------------------------------------------
// (b)(18): mutual/cooperative electric company member income — a pure
// cross-reference bridge to section 501(c)(12)(H).
// ---------------------------------------------------------------------

@source(IRC_S512_B, quote = "In the case of a mutual or cooperative electric company described in section 501(c)(12), there shall be excluded income which is treated as member income under subparagraph (H) thereof.")
pub relation mutual_electric_company_member_income_excluded_512b18(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 512(b)(18): income treated as member income under section 501(c)(12)(H) is excluded from UBTI for a mutual/cooperative electric company";
}
pub relation load_loss_transaction_income_treated_as_member_income_501c12H(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "income from a section 501(c)(12)(H) load-loss transaction treated as member income (section 501(c)(12)(H) is not independently decomposed this stage — case-asserted)";
}
rule MutualElectricMemberIncomeExcluded512b18(o: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 512(b)(18): the section 501(c)(12)(H) bridge";
    when benevolent_insurance_or_mutual_utility_organization(o);
    when load_loss_transaction_income_treated_as_member_income_501c12H(o, y, amount);
    then mutual_electric_company_member_income_excluded_512b18(o, y, amount);
}

// ---------------------------------------------------------------------
// (b)(19): brownfield property gain/loss exclusion. TOP LEVEL; the (B)-(E)
// eligible-taxpayer/qualifying-property/certification/qualified-
// disposition sub-definitions are NOT decomposed (TECH-GAPS G488) — the
// $550,000/12-percent remediation-expenditure test is case-asserted
// rather than computed, since its own "greater of" comparison depends on
// entirely case-specific facts already summarized in the eligibility flag.
// ---------------------------------------------------------------------

@source(IRC_S512_B, quote = "Notwithstanding paragraph (5)(B), there shall be excluded any gain or loss from the qualified sale, exchange, or other disposition of any qualifying brownfield property by an eligible taxpayer.")
pub relation brownfield_property_gain_loss_excluded_512b19(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 512(b)(19)(A): gain or loss from the qualified disposition of qualifying brownfield property by an eligible taxpayer, excluded from UBTI";
}
pub relation eligible_taxpayer_qualifying_brownfield_disposition_512b19(o: Person) kind empirical {
    label en unofficial "the organization is an eligible taxpayer (section 512(b)(19)(B)) disposing of qualifying brownfield property (section 512(b)(19)(C)) in a qualified disposition (section 512(b)(19)(D)) — case-asserted compound fact, sub-definitions not decomposed (TECH-GAPS G488)";
}
rule BrownfieldPropertyGainLossExcluded512b19(o: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 512(b)(19)(A): the brownfield gain/loss exclusion";
    when eligible_taxpayer_qualifying_brownfield_disposition_512b19(o);
    when capital_gain_loss_excluded_512b5(o, y, amount);
    then brownfield_property_gain_loss_excluded_512b19(o, y, amount);
}
