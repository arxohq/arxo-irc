// Sections 511 and 512 — stage 3: the coverage clauses of section 511, the
// parts of section 512(a) stage 1/2 skipped ((a)(2) foreign organizations,
// (a)(3)(B)-(E), (a)(4), (a)(5)), the sub-paragraph detail of section 512(b)
// ((3), (12), (13)(B)-(F), (16), (17)(B), (19)) and section 512(c)-(e). Every
// numeric threshold is an exact comparison; sums use empirical relations only.

// ---------------------------------------------------------------------
// Section 511.
// ---------------------------------------------------------------------

use self::{
    IRC_S511_A,
    IRC_S511_B,
    IRC_S511_C,
    IRC_S512_A,
    IRC_S512_B,
    IRC_S512_C,
    IRC_S512_D,
    IRC_S512_E,
    Person,
    SpecificDeduction1000,
    TaxableYear,
    TradeOrBusiness,
    Trust,
    election_period_start_512b19HiiI,
    exempt_organization,
    rent_excluded_512b3,
    rent_override_at_amount,
    section_501c19,
    section_501c2,
    section_501c9,
    section_501c_7_9_or_17_organization,
    section_511a_covered_organization,
    unrelated_business_income_tax,
    unrelated_business_taxable_income,
};

pub relation college_or_university_agency_or_instrumentality_or_government_owned_511a2B(o: Person) kind empirical {
    label en official "the college or university is an agency or instrumentality of any government or political subdivision, or is owned or operated by a government, a political subdivision, or an agency or instrumentality of one or more of them (section 511(a)(2)(B))";
}
pub relation corporation_wholly_owned_by_such_colleges_511a2B(o: Person, owner: Person) kind empirical {
    label en official "the corporation is wholly owned by one or more such colleges or universities (section 511(a)(2)(B))";
}
pub relation section_511a2B_coverage(o: Person, y: TaxableYear) kind institutional {
    label en official "a government college or university, or a corporation wholly owned by one, within the section 511(a) tax";
}
@source(IRC_S511_A, quote = "The tax imposed by paragraph (1) shall apply in the case of any college or university which is an agency or instrumentality of any government or any political subdivision thereof, or which is owned or operated by a government or any political subdivision thereof, or by any agency or instrumentality of one or more governments or political subdivisions. Such tax shall also apply in the case of any corporation wholly owned by one or more such colleges or universities.")
rule Section511a2BGovernmentCollege(o: Person, y: TaxableYear) defeasible {
    label en official "section 511(a)(2)(B): the tax applies to a government college or university";
    when college_or_university_agency_or_instrumentality_or_government_owned_511a2B(o);
    when us.irc.core::year_of(o, y);
    then section_511a2B_coverage(o, y);
}
@source(IRC_S511_A, quote = "The tax imposed by paragraph (1) shall apply in the case of any college or university which is an agency or instrumentality of any government or any political subdivision thereof, or which is owned or operated by a government or any political subdivision thereof, or by any agency or instrumentality of one or more governments or political subdivisions. Such tax shall also apply in the case of any corporation wholly owned by one or more such colleges or universities.")
rule Section511a2BWhollyOwnedCorporation(o: Person, y: TaxableYear, owner: Person) defeasible {
    label en official "section 511(a)(2)(B): the tax also applies to a corporation wholly owned by such colleges";
    when corporation_wholly_owned_by_such_colleges_511a2B(o, owner);
    when college_or_university_agency_or_instrumentality_or_government_owned_511a2B(owner);
    when us.irc.core::year_of(o, y);
    then section_511a2B_coverage(o, y);
}
@source(IRC_S511_A, quote = "The tax imposed by paragraph (1) shall apply in the case of any college or university which is an agency or instrumentality of any government or any political subdivision thereof, or which is owned or operated by a government or any political subdivision thereof, or by any agency or instrumentality of one or more governments or political subdivisions. Such tax shall also apply in the case of any corporation wholly owned by one or more such colleges or universities.")
rule Section511aCoveredViaGovernmentCollege(o: Person, y: TaxableYear) defeasible {
    label en official "section 511(a)(2)(B): a government college or university, or a corporation it wholly owns, is a covered organization";
    when section_511a2B_coverage(o, y);
    then section_511a_covered_organization(o, y);
}
pub relation would_be_subject_to_subchapter_J_511b2(t: Trust) kind empirical {
    label en official "if it were not for the exemption, the trust would be subject to subchapter J (sections 641 and following)";
}
pub relation trust_within_511b2(t: Trust, y: TaxableYear) kind institutional {
    label en official "the trust is exempt under section 501(a) and would otherwise be subject to subchapter J, so the section 511(b) tax applies";
}
@source(IRC_S511_B, quote = "The tax imposed by paragraph (1) shall apply in the case of any trust which is exempt, except as provided in this part or part II (relating to private foundations), from taxation under this subtitle by reason of section 501(a) and which, if it were not for such exemption, would be subject to subchapter J (sec. 641 and following, relating to estates, trusts, beneficiaries, and decedents).")
rule TrustWithin511b2(t: Trust, y: TaxableYear) defeasible {
    label en official "section 511(b)(2): an exempt trust that would be subject to subchapter J but for the exemption";
    when exempt_organization(t, y);
    when would_be_subject_to_subchapter_J_511b2(t);
    then trust_within_511b2(t, y);
}
@source(IRC_S511_B, quote = "The tax imposed by paragraph (1) shall apply in the case of any trust which is exempt, except as provided in this part or part II (relating to private foundations), from taxation under this subtitle by reason of section 501(a) and which, if it were not for such exemption, would be subject to subchapter J (sec. 641 and following, relating to estates, trusts, beneficiaries, and decedents).")
rule Section511bTaxBaseViaDerivedTrust(t: Trust, y: TaxableYear, ubti: Money) defeasible {
    label en official "section 511(b)(1) with the derived (b)(2) trust: a tax computed as provided in section 1(e) is imposed on the unrelated business taxable income";
    when trust_within_511b2(t, y);
    when unrelated_business_taxable_income(t, y, ubti);
    then unrelated_business_income_tax(t, y, ubti);
}
pub relation pays_net_income_to_exempt_organization_511c1(corp: Person, org: Person, y: TaxableYear) kind empirical {
    label en official "the section 501(c)(2) corporation pays any amount of its net income for the taxable year to an organization exempt under section 501(a) (or would pay it but for the fact that the expenses of collecting the income exceed the income)";
}
pub relation files_consolidated_return_with_organization_511c2(corp: Person, org: Person, y: TaxableYear) kind empirical {
    label en official "the corporation and the organization file a consolidated return for the taxable year";
}
pub relation treated_as_organized_and_operated_for_same_purposes_as_payee_511c(corp: Person, org: Person, y: TaxableYear) kind institutional {
    label en official "for purposes of the section 511(a) tax, the corporation is treated as organized and operated for the same purposes as the payee organization, in addition to its section 501(c)(2) purposes";
}
@source(IRC_S511_C, quote = "If a corporation described in section 501(c)(2)—")
@source(IRC_S511_C, quote = "(1) pays any amount of its net income for a taxable year to an organization exempt from taxation under section 501(a) (or which would pay such an amount but for the fact that the expenses of collecting its income exceed its income), and")
@source(IRC_S511_C, quote = "(2) such corporation and such organization file a consolidated return for the taxable year,")
@source(IRC_S511_C, quote = "such corporation shall be treated, for purposes of the tax imposed by subsection (a), as being organized and operated for the same purposes as such organization, in addition to the purposes described in section 501(c)(2).")
rule Section511cTitleHoldingCorporationTreatedAsPayee(corp: Person, org: Person, y: TaxableYear) defeasible {
    label en official "section 511(c): a section 501(c)(2) corporation that pays its net income to an exempt organization and files a consolidated return with it is treated as organized and operated for the same purposes";
    when section_501c2(corp, y);
    when pays_net_income_to_exempt_organization_511c1(corp, org, y);
    when files_consolidated_return_with_organization_511c2(corp, org, y);
    then treated_as_organized_and_operated_for_same_purposes_as_payee_511c(corp, org, y);
}

// ---------------------------------------------------------------------
// Section 512(a).
// ---------------------------------------------------------------------

pub relation foreign_organization_ubti_us_source_not_effectively_connected_512a2A(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the unrelated business taxable income derived from sources within the United States that is not effectively connected with the conduct of a trade or business within the United States";
}
pub relation foreign_organization_ubti_effectively_connected_512a2B(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the unrelated business taxable income effectively connected with the conduct of a trade or business within the United States";
}
pub relation foreign_organization_unrelated_business_taxable_income_512a2(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the unrelated business taxable income of a foreign organization: the sum of (A) and (B)";
}
@source(IRC_S512_A, quote = "In the case of an organization described in section 511 which is a foreign organization, the unrelated business taxable income shall be—")
@source(IRC_S512_A, quote = "(A) its unrelated business taxable income which is derived from sources within the United States and which is not effectively connected with the conduct of a trade or business within the United States, plus")
@source(IRC_S512_A, quote = "(B) its unrelated business taxable income which is effectively connected with the conduct of a trade or business within the United States.")
rule ForeignOrganizationUbtiIsSumOfSourcePlusEffectivelyConnected(o: Person, y: TaxableYear, a: Money, b: Money) defeasible {
    label en official "section 512(a)(2): its US-source income not effectively connected, plus its effectively connected income";
    when foreign_organization_ubti_us_source_not_effectively_connected_512a2A(o, y, a);
    when foreign_organization_ubti_effectively_connected_512a2B(o, y, b);
    then foreign_organization_unrelated_business_taxable_income_512a2(o, y, a + b);
}
// (a)(3)(B): set-asides.
pub relation set_aside_income_used_for_other_purpose_512a3B(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "an amount attributable to income set aside for a purpose specified in clause (i) or (ii) that is used during the taxable year for another purpose";
}
pub relation set_aside_diverted_amount_included_in_ubti_512a3B(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the diverted set-aside amount is included in unrelated business taxable income for the taxable year";
}
@source(IRC_S512_A, quote = "including reasonable costs of administration directly connected with a purpose described in clause (i) or (ii). If during the taxable year, an amount which is attributable to income so set aside is used for a purpose other than that described in clause (i) or (ii), such amount shall be included, under subparagraph (A), in unrelated business taxable income for the taxable year.")
rule DivertedSetAsideIncludedInUbti(o: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 512(a)(3)(B), last sentence: an amount attributable to set-aside income used for another purpose is included under subparagraph (A)";
    when section_501c_7_9_or_17_organization(o);
    when set_aside_income_used_for_other_purpose_512a3B(o, y, amount);
    then set_aside_diverted_amount_included_in_ubti_512a3B(o, y, amount);
}
@source(IRC_S512_A, quote = "For purposes of subparagraph (A), the term \"exempt function income\" means the gross income from dues, fees, charges, or similar amounts paid by members of the organization as consideration for providing such members or their dependents or guests goods, facilities, or services in furtherance of the purposes constituting the basis for the exemption of the organization to which such income is paid. Such term also means all income (other than an amount equal to the gross income derived from any unre")
@source(IRC_S512_A, quote = "(i) for a purpose specified in section 170(c)(4), or")
@source(IRC_S512_A, quote = "(ii) in the case of an organization described in paragraph (9) or (17) of section 501(c), to provide for the payment of life, sick, accident, or other benefits,")
pub relation set_aside_purpose_512a3B_reasonable_administration_included(o: Person, y: TaxableYear) kind empirical {
    label en official "the set-aside includes reasonable costs of administration directly connected with a purpose described in clause (i) or (ii)";
}
// (a)(3)(C): section 501(c)(2) corporation whose income is payable to a (7), (9) or (17) organization.
pub relation c2_corporation_income_payable_to_c7_c9_or_c17_organization_512a3C(corp: Person, org: Person) kind empirical {
    label en official "the section 501(c)(2) corporation's income is payable to an organization described in paragraph (7), (9) or (17) of section 501(c)";
}
pub relation c2_corporation_treated_as_the_payee_512a3C(corp: Person, org: Person) kind institutional {
    label en official "subparagraph (A) applies as if the corporation were the organization to which the income is payable";
}
@source(IRC_S512_A, quote = "In the case of a corporation described in section 501(c)(2), the income of which is payable to an organization described in paragraph (7), (9), or (17) of section 501(c), subparagraph (A) shall apply as if such corporation were the organization to which the income is payable. For purposes of the preceding sentence, such corporation shall be treated as having exempt function income for a taxable year only if it files a consolidated return with such organization for such year.")
rule C2CorporationTreatedAsThePayee(corp: Person, org: Person, y: TaxableYear) defeasible {
    label en official "section 512(a)(3)(C): the section 501(c)(2) corporation stands in the payee's place";
    when section_501c2(corp, y);
    when c2_corporation_income_payable_to_c7_c9_or_c17_organization_512a3C(corp, org);
    then c2_corporation_treated_as_the_payee_512a3C(corp, org);
}
pub relation c2_corporation_has_exempt_function_income_512a3C(corp: Person, y: TaxableYear) kind institutional {
    label en official "the corporation is treated as having exempt function income for the taxable year only if it files a consolidated return with the payee organization";
}
@source(IRC_S512_A, quote = "In the case of a corporation described in section 501(c)(2), the income of which is payable to an organization described in paragraph (7), (9), or (17) of section 501(c), subparagraph (A) shall apply as if such corporation were the organization to which the income is payable. For purposes of the preceding sentence, such corporation shall be treated as having exempt function income for a taxable year only if it files a consolidated return with such organization for such year.")
rule C2CorporationHasExemptFunctionIncomeOnlyWithConsolidatedReturn(corp: Person, org: Person, y: TaxableYear) defeasible {
    label en official "section 512(a)(3)(C), second sentence: exempt function income only with a consolidated return";
    when c2_corporation_treated_as_the_payee_512a3C(corp, org);
    when files_consolidated_return_with_organization_511c2(corp, org, y);
    then c2_corporation_has_exempt_function_income_512a3C(corp, y);
}
// (a)(3)(D): gain on the sale of exempt-function asset_id.
pub relation sale_of_exempt_function_property_512a3D(o: Person, y: TaxableYear, sale: Text, sale_date: Date, sales_price: Money, gain: Money) kind empirical {
    label en official "a sale by a paragraph (7), (9) or (17) organization of property used directly in the performance of its exempt function: the sales price and the gain realized";
}
pub relation replacement_property_purchased_512a3D(o: Person, sale: Text, purchase_date: Date, cost: Money) kind empirical {
    label en official "other property purchased and used by the organization directly in the performance of its exempt function, with its cost";
}
pub relation replacement_property_within_period_512a3D(o: Person, sale: Text) kind institutional {
    label en official "the replacement property was purchased in the period beginning 1 year before the date of the sale and ending 3 years after it";
}
@source(IRC_S512_A, quote = "If property used directly in the performance of the exempt function of an organization described in paragraph (7), (9), or (17) of section 501(c) is sold by such organization, and within a period beginning 1 year before the date of such sale, and ending 3 years after such date, other property is purchased and used by such organization directly in the performance of its exempt function, gain (if any) from such sale shall be recognized only to the extent that such organization's sales price of the")
rule ReplacementPropertyWithinPeriod(o: Person, y: TaxableYear, sale: Text, sale_date: Date, price: Money, gain: Money, purchase_date: Date, cost: Money) defeasible {
    label en official "section 512(a)(3)(D): purchase within 1 year before through 3 years after the sale — the end dates of the window are inclusive";
    when sale_of_exempt_function_property_512a3D(o, y, sale, sale_date, price, gain);
    when replacement_property_purchased_512a3D(o, sale, purchase_date, cost);
    when add_calendar_period(purchase_date, 1 calendar_year) >= sale_date;
    when purchase_date <= add_calendar_period(sale_date, 3 calendar_year);
    then replacement_property_within_period_512a3D(o, sale);
}
pub relation recognized_gain_on_exempt_function_property_512a3D(o: Person, y: TaxableYear, sale: Text, amount: Money) kind institutional {
    label en official "the gain recognized: only to the extent the sales price exceeds the cost of the replacement property";
}
@source(IRC_S512_A, quote = "If property used directly in the performance of the exempt function of an organization described in paragraph (7), (9), or (17) of section 501(c) is sold by such organization, and within a period beginning 1 year before the date of such sale, and ending 3 years after such date, other property is purchased and used by such organization directly in the performance of its exempt function, gain (if any) from such sale shall be recognized only to the extent that such organization's sales price of the")
rule RecognizedGainLimitedToExcessOverReplacementCost(o: Person, y: TaxableYear, sale: Text, sale_date: Date, price: Money, gain: Money, purchase_date: Date, cost: Money) defeasible {
    label en official "section 512(a)(3)(D): recognized gain = the lesser of the gain and (sales price - replacement cost), never below zero";
    when sale_of_exempt_function_property_512a3D(o, y, sale, sale_date, price, gain);
    when replacement_property_purchased_512a3D(o, sale, purchase_date, cost);
    when replacement_property_within_period_512a3D(o, sale);
    then recognized_gain_on_exempt_function_property_512a3D(o, y, sale, min(gain, max(0.00 USD, price - cost)));
}
// (a)(3)(E): the account limit.
pub relation assets_set_aside_for_benefits_512a3E(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of assets set aside for the purpose specified in clause (ii) of subparagraph (B), not taking into account any reserve described in clause (ii) of this subparagraph";
}
pub relation account_limit_under_419A_512a3E(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the account limit determined under section 419A (without regard to subsection (f)(6) thereof) for the taxable year — EXTERNAL_DEPENDENCY on the section 419A owner";
}
pub relation set_aside_taken_into_account_512a3E(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the set-aside that may be taken into account under subparagraph (B): not in excess of the section 419A account limit";
}
@source(IRC_S512_A, quote = "In the case of any organization described in paragraph (9) or (17) of section 501(c), a set-aside for any purpose specified in clause (ii) of subparagraph (B) may be taken into account under subparagraph (B) only to the extent that such set-aside does not result in an amount of assets set aside for such purpose in excess of the account limit determined under section 419A (without regard to subsection (f)(6) thereof) for the taxable year (not taking into account any reserve described in section 4")
rule SetAsideTakenIntoAccountUpToAccountLimit(o: Person, y: TaxableYear, assets: Money, limit: Money) defeasible {
    label en official "section 512(a)(3)(E)(i): a (9) or (17) organization's set-aside counts only up to the section 419A account limit (the pre-1984 reserve of clause (ii) is left out of the assets counted)";
    when section_501c9(o, y);
    when assets_set_aside_for_benefits_512a3E(o, y, assets);
    when account_limit_under_419A_512a3E(o, y, limit);
    then set_aside_taken_into_account_512a3E(o, y, min(assets, limit));
}
pub relation set_aside_amount_at_close_of_last_plan_year_before_tra84_512a3Eii(o: Person, amount: Money) kind empirical {
    label en official "the amount of assets set aside for post-retirement medical or life insurance benefits as of the close of the last plan year ending before the date of enactment of the Tax Reform Act of 1984";
}
pub relation set_aside_amount_on_july_18_1984_512a3Eii(o: Person, amount: Money) kind empirical {
    label en official "the amount of assets set aside for those benefits on July 18, 1984";
}
pub relation reserve_for_post_retirement_benefits_512a3Eii(o: Person, amount: Money) kind institutional {
    label en official "the reserve for post-retirement medical or life insurance benefits: the greater of the two amounts";
}
@source(IRC_S512_A, quote = "(II) For purposes of subclause (I), the term \"reserve for post-retirement medical or life insurance benefits\" means the greater of the amount of assets set aside for purposes of post-retirement medical or life insurance benefits to be provided to covered employees as of the close of the last plan year ending before the date of the enactment of the Tax Reform Act of 1984 or on July 18, 1984.")
rule ReserveIsGreaterOfTheTwoAmounts(o: Person, a: Money, b: Money) defeasible {
    label en official "section 512(a)(3)(E)(ii)(II): the greater of the amount set aside as of the close of the last plan year before enactment and the amount on July 18, 1984";
    when set_aside_amount_at_close_of_last_plan_year_before_tra84_512a3Eii(o, a);
    when set_aside_amount_on_july_18_1984_512a3Eii(o, b);
    then reserve_for_post_retirement_benefits_512a3Eii(o, max(a, b));
}
pub external judgment relation SubstantiallyAllContributionsFromEmployersExemptForFiveYears512a3Eiii(o: Person, y: TaxableYear) {
    authority Secretary;
    label en official "substantially all of the contributions to the organization are made by employers who were exempt from tax under this chapter throughout the 5-taxable-year period ending with the taxable year in which the contributions are made (section 512(a)(3)(E)(iii)) — DECISION-0194 evaluative channel";
}
pub relation set_aside_limit_of_512a3E_disapplied(o: Person, y: TaxableYear) kind institutional {
    label en official "subparagraph (E) does not apply to the organization";
}
@source(IRC_S512_A, quote = "This subparagraph shall not apply to any organization if substantially all of the contributions to such organization are made by employers who were exempt from tax under this chapter throughout the 5-taxable year period ending with the taxable year in which the contributions are made.")
rule SetAsideLimitDisapplied(o: Person, y: TaxableYear) defeasible {
    label en official "section 512(a)(3)(E)(iii): the account limit does not apply where the contributing employers were exempt throughout the 5-year period";
    when SubstantiallyAllContributionsFromEmployersExemptForFiveYears512a3Eiii(o, y);
    then set_aside_limit_of_512a3E_disapplied(o, y);
}
// (a)(4): section 501(c)(19) organizations.
pub relation insurance_payments_set_aside_512a4(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "amounts attributable to payments for life, sick, accident or health insurance with respect to members or their dependents that are set aside to provide insurance benefits or for a purpose specified in section 170(c)(4)";
}
pub relation insurance_set_aside_used_for_other_purpose_512a4(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "an amount set aside that is used during the taxable year for another purpose";
}
pub relation set_aside_excluded_from_ubti_512a4(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the set-aside insurance payments are not unrelated business taxable income of a section 501(c)(19) organization";
}
@source(IRC_S512_A, quote = "In the case of an organization described in section 501(c)(19), the term \"unrelated business taxable income\" does not include any amount attributable to payments for life, sick, accident, or health insurance with respect to members of such organizations or their dependents which is set aside for the purpose of providing for the payment of insurance benefits or for a purpose specified in section 170(c)(4). If an amount set aside under the preceding sentence is used during the taxable year for a p")
rule C19SetAsideInsurancePaymentsExcluded(o: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 512(a)(4): set-aside insurance payments of a section 501(c)(19) organization are not unrelated business taxable income";
    when section_501c19(o, y);
    when insurance_payments_set_aside_512a4(o, y, amount);
    then set_aside_excluded_from_ubti_512a4(o, y, amount);
}
pub relation set_aside_diverted_included_in_ubti_512a4(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount set aside and used for another purpose is included in unrelated business taxable income";
}
@source(IRC_S512_A, quote = "In the case of an organization described in section 501(c)(19), the term \"unrelated business taxable income\" does not include any amount attributable to payments for life, sick, accident, or health insurance with respect to members of such organizations or their dependents which is set aside for the purpose of providing for the payment of insurance benefits or for a purpose specified in section 170(c)(4). If an amount set aside under the preceding sentence is used during the taxable year for a p")
rule C19DivertedSetAsideIncluded(o: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 512(a)(4), last sentence: an amount used during the taxable year for another purpose is included in unrelated business taxable income";
    when section_501c19(o, y);
    when insurance_set_aside_used_for_other_purpose_512a4(o, y, amount);
    then set_aside_diverted_included_in_ubti_512a4(o, y, amount);
}
// (a)(5): securities loans.
pub enum SecuritiesLoanPayment512a5A { DividendsInterestOrDistributions, FeesByReferenceToLoanPeriodAndValue, IncomeFromCollateralSecurity, IncomeFromInvestmentOfCollateral }
pub relation security_transferred_in_section_1058_transaction_512a5A(loan: Text) kind empirical {
    label en official "the security (as defined in section 1236(c)) was transferred by the owner to another person in a transaction to which section 1058 applies (whether or not title remains in the lender's name)";
}
pub relation loan_agreement_provides_daily_collateral_at_least_fair_market_value_512a5Bi(loan: Text) kind empirical {
    label en official "the agreement provides reasonable procedures to implement the transferee's obligation to furnish collateral, for each business day, with a fair market value not less than the fair market value of the security at the close of the preceding business day";
}
pub relation loan_agreement_termination_notice_business_days_512a5Bii(loan: Text, days: Decimal) kind empirical {
    label en official "the number of business days of notice on which the transferor may terminate the loan under the agreement";
}
pub relation loan_agreement_provides_return_of_identical_securities_512a5Biii(loan: Text) kind empirical {
    label en official "the agreement provides for the return to the transferor of securities identical to those transferred upon termination of the loan";
}
pub relation securities_loan_agreement_meets_512a5B(loan: Text) kind institutional {
    label en official "the securities loan agreement meets the requirements of section 512(a)(5)(B)";
}
@source(IRC_S512_A, quote = "(B) Subparagraph (A) shall apply only with respect to securities transferred pursuant to an agreement between the transferor and the transferee which provides for—")
@source(IRC_S512_A, quote = "(i) reasonable procedures to implement the obligation of the transferee to furnish to the transferor, for each business day during such period, collateral with a fair market value not less than the fair market value of the security at the close of business on the preceding business day,")
@source(IRC_S512_A, quote = "(ii) termination of the loan by the transferor upon notice of not more than 5 business days, and")
@source(IRC_S512_A, quote = "(iii) return to the transferor of securities identical to the transferred securities upon termination of the loan.")
rule SecuritiesLoanAgreementMeets512a5B(loan: Text, days: Decimal) defeasible {
    label en official "section 512(a)(5)(B): daily collateral procedures, termination on notice of not more than 5 business days (5 qualifies), and return of identical securities";
    when loan_agreement_provides_daily_collateral_at_least_fair_market_value_512a5Bi(loan);
    when loan_agreement_termination_notice_business_days_512a5Bii(loan, days);
    when days <= 5.0;
    when loan_agreement_provides_return_of_identical_securities_512a5Biii(loan);
    then securities_loan_agreement_meets_512a5B(loan);
}
pub relation received_in_respect_of_loaned_security_512a5A(loan: Text, kind: SecuritiesLoanPayment512a5A) kind empirical {
    label en official "an amount received in respect of the loaned security of the given kind";
}
pub relation payment_with_respect_to_securities_loan_512a5(loan: Text, kind: SecuritiesLoanPayment512a5A) kind institutional {
    label en official "the amount is a payment with respect to securities loans (section 512(a)(5))";
}
@source(IRC_S512_A, quote = "(A) The term \"payments with respect to securities loans\" includes all amounts received in respect of a security (as defined in section 1236(c)) transferred by the owner to another person in a transaction to which section 1058 applies (whether or not title to the security remains in the name of the lender) including—")
@source(IRC_S512_A, quote = "(i) amounts in respect of dividends, interest, or other distributions,")
@source(IRC_S512_A, quote = "(ii) fees computed by reference to the period beginning with the transfer of securities by the owner and ending with the transfer of identical securities back to the transferor by the transferee and the fair market value of the security during such period,")
@source(IRC_S512_A, quote = "(iii) income from collateral security for such loan, and")
@source(IRC_S512_A, quote = "(iv) income from the investment of collateral security.")
rule PaymentWithRespectToSecuritiesLoan(loan: Text, k: SecuritiesLoanPayment512a5A) defeasible {
    label en official "section 512(a)(5)(A)-(B): all amounts received in respect of a security transferred under section 1058, including dividends and distributions, fees, collateral income and income from investing collateral — only under a qualifying agreement";
    when security_transferred_in_section_1058_transaction_512a5A(loan);
    when received_in_respect_of_loaned_security_512a5A(loan, k);
    when securities_loan_agreement_meets_512a5B(loan);
    then payment_with_respect_to_securities_loan_512a5(loan, k);
}

// ---------------------------------------------------------------------
// Section 512(b).
// ---------------------------------------------------------------------

pub external judgment relation PersonalPropertyRentsIncidentalAtPlacedInService512b3Aii(o: Person, tb: TradeOrBusiness, y: TaxableYear) {
    authority Secretary;
    label en official "the rents attributable to personal property leased with real property are an incidental amount of the total rents received or accrued under the lease, determined at the time the personal property is placed in service (section 512(b)(3)(A)(ii)) — DECISION-0194 evaluative channel";
}
pub relation rents_from_personal_property_leased_with_real_property_512b3Aii(o: Person, tb: TradeOrBusiness, y: TaxableYear, amount: Money) kind empirical {
    label en official "rents from personal property (including section 1245(a)(3)(B) property) leased with the real property";
}
pub relation personal_property_rent_excluded_512b3Aii(o: Person, tb: TradeOrBusiness, y: TaxableYear, amount: Money) kind institutional {
    label en official "the rent from personal property leased with real property is excluded from unrelated business taxable income";
}
@source(IRC_S512_B, quote = "(ii) all rents from personal property (including for purposes of this paragraph as personal property any property described in section 1245(a)(3)(B)) leased with such real property, if the rents attributable to such personal property are an incidental amount of the total rents received or accrued under the lease, determined at the time the personal property is placed in service.")
rule PersonalPropertyRentLeasedWithRealPropertyExcluded(o: Person, tb: TradeOrBusiness, y: TaxableYear, amount: Money) defeasible {
    label en official "section 512(b)(3)(A)(ii): rents from personal property leased with real property when incidental to the total rents";
    when rents_from_personal_property_leased_with_real_property_512b3Aii(o, tb, y, amount);
    when PersonalPropertyRentsIncidentalAtPlacedInService512b3Aii(o, tb, y);
    unless rent_override_at_amount(o, tb, y, amount);
    then personal_property_rent_excluded_512b3Aii(o, tb, y, amount);
}
pub relation deductions_directly_connected_with_excluded_rents_512b3C(o: Person, tb: TradeOrBusiness, y: TaxableYear, amount: Money) kind empirical {
    label en official "the deductions directly connected with the rents excluded under subparagraph (A)";
}
pub relation deductions_connected_with_excluded_rents_excluded_512b3C(o: Person, tb: TradeOrBusiness, y: TaxableYear, amount: Money) kind institutional {
    label en official "all deductions directly connected with excluded rents are excluded";
}
@source(IRC_S512_B, quote = "(C) There shall be excluded all deductions directly connected with rents excluded under subparagraph (A).")
rule DeductionsConnectedWithExcludedRentsExcluded(o: Person, tb: TradeOrBusiness, y: TaxableYear, rent: Money, ded: Money) defeasible {
    label en official "section 512(b)(3)(C): the deductions directly connected with excluded rents are excluded too";
    when rent_excluded_512b3(o, tb, y, rent);
    when deductions_directly_connected_with_excluded_rents_512b3C(o, tb, y, ded);
    then deductions_connected_with_excluded_rents_excluded_512b3C(o, tb, y, ded);
}
// (5): options.
pub relation gain_or_loss_from_lapse_or_termination_of_investment_options_512b5(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "gain or loss recognized in connection with the organization's investment activities from the lapse or termination of options to buy or sell securities (section 1236(c)) or real property, or from the forfeiture of good-faith deposits consistent with established business practice for the purchase, sale or lease of real property";
}
pub relation option_gain_or_loss_excluded_512b5(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the lapse, termination or forfeiture gain or loss is excluded from unrelated business taxable income";
}
@source(IRC_S512_B, quote = "There shall also be excluded all gains or losses recognized, in connection with the organization's investment activities, from the lapse or termination of options to buy or sell securities (as defined in section 1236(c)) or real property and all gains or losses from the forfeiture of good-faith deposits (that are consistent with established business practice) for the purchase, sale, or lease of real property in connection with the organization's investment activities. This paragraph shall not ap")
rule OptionLapseGainOrLossExcluded(o: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 512(b)(5), last paragraph: investment-option lapse or termination gains and losses and good-faith deposit forfeitures are excluded";
    when gain_or_loss_from_lapse_or_termination_of_investment_options_512b5(o, y, amount);
    then option_gain_or_loss_excluded_512b5(o, y, amount);
}
// (12): local units.
pub relation local_unit_gross_income_from_unrelated_business_512b12B(unit: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the gross income derived from any unrelated trade or business regularly carried on by the parish, individual church, district or other local unit";
}
pub relation local_unit_of_diocese_province_or_convention_512b12(unit: Person, parent: Person) kind empirical {
    label en official "the unit is a parish, individual church, district, or other local unit of a diocese, province of a religious order, or convention or association of churches";
}
pub relation local_unit_specific_deduction_512b12(unit: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the specific deduction for the local unit: the lower of $1,000 and the gross income from its unrelated trade or business";
}
@source(IRC_S512_B, quote = "(A) $1,000, or")
@source(IRC_S512_B, quote = "(B) the gross income derived from any unrelated trade or business regularly carried on by such local unit.")
rule LocalUnitSpecificDeductionLowerOf(unit: Person, parent: Person, y: TaxableYear, gross: Money) defeasible {
    label en official "section 512(b)(12)(A)-(B): the lower of $1,000 and the local unit's unrelated gross income";
    when local_unit_of_diocese_province_or_convention_512b12(unit, parent);
    when local_unit_gross_income_from_unrelated_business_512b12B(unit, y, gross);
    then local_unit_specific_deduction_512b12(unit, y, min(SpecificDeduction1000, gross));
}
// (13)(B)-(F).
pub enum SpecifiedPaymentKind512b13C { Interest, Annuity, Royalty, Rent }
pub relation payment_kind_512b13C(payment: Text, kind: SpecifiedPaymentKind512b13C) kind empirical {
    label en official "the payment is interest, an annuity, a royalty, or rent";
}
pub relation specified_payment_512b13C(payment: Text) kind institutional {
    label en official "the payment is a specified payment";
}
@source(IRC_S512_B, quote = "(C) Specified payment.—For purposes of this paragraph, the term \"specified payment\" means any interest, annuity, royalty, or rent.")
rule SpecifiedPaymentDefinition(payment: Text, k: SpecifiedPaymentKind512b13C) defeasible {
    label en official "section 512(b)(13)(C): any interest, annuity, royalty, or rent";
    when payment_kind_512b13C(payment, k);
    then specified_payment_512b13C(payment);
}
pub relation controlled_entity_not_exempt_taxable_income_attributable_to_unrelated_512b13Bi_I(controlled: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "in the case of a controlled entity not exempt under section 501(a), the portion of its taxable income that would be unrelated business taxable income if the entity were exempt and had the same exempt purposes as the controlling organization";
}
pub relation controlled_entity_exempt_ubti_512b13Bi_II(controlled: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "in the case of a controlled entity exempt under section 501(a), the amount of its unrelated business taxable income";
}
pub relation net_unrelated_income_512b13Bi(controlled: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the net unrelated income of the controlled entity";
}
@source(IRC_S512_B, quote = "(I) in the case of a controlled entity which is not exempt from tax under section 501(a), the portion of such entity's taxable income which would be unrelated business taxable income if such entity were exempt from tax under section 501(a) and had the same exempt purposes as the controlling organization, or")
rule NetUnrelatedIncomeNonExemptEntity(controlled: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 512(b)(13)(B)(i)(I): a non-exempt controlled entity's taxable income that would be unrelated business taxable income";
    when controlled_entity_not_exempt_taxable_income_attributable_to_unrelated_512b13Bi_I(controlled, y, amount);
    then net_unrelated_income_512b13Bi(controlled, y, amount);
}
@source(IRC_S512_B, quote = "(II) in the case of a controlled entity which is exempt from tax under section 501(a), the amount of the unrelated business taxable income of the controlled entity.")
rule NetUnrelatedIncomeExemptEntity(controlled: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 512(b)(13)(B)(i)(II): an exempt controlled entity's unrelated business taxable income";
    when controlled_entity_exempt_ubti_512b13Bi_II(controlled, y, amount);
    then net_unrelated_income_512b13Bi(controlled, y, amount);
}
pub relation specified_payment_binding_contract_in_effect_on_enactment_512b13Eiii_I(payment: Text) kind empirical {
    label en official "the specified payment is made pursuant to a binding written contract in effect on the date of enactment of subparagraph (E) (August 5, 1997)";
}
pub relation specified_payment_renewal_on_substantially_similar_terms_512b13Eiii_II(payment: Text) kind empirical {
    label en official "the specified payment is made pursuant to a contract that is a renewal, under substantially similar terms, of a contract described in subclause (I)";
}
pub relation qualifying_specified_payment_512b13Eiii(payment: Text) kind institutional {
    label en official "the payment is a qualifying specified payment";
}
@source(IRC_S512_B, quote = "(iii) Qualifying specified payment.—The term \"qualifying specified payment\" means a specified payment which is made pursuant to—")
@source(IRC_S512_B, quote = "(I) a binding written contract in effect on the date of the enactment of this subparagraph, or")
rule QualifyingSpecifiedPaymentViaBindingContract(payment: Text) defeasible {
    label en official "section 512(b)(13)(E)(iii)(I): a specified payment under a binding written contract in effect on the enactment date";
    when specified_payment_512b13C(payment);
    when specified_payment_binding_contract_in_effect_on_enactment_512b13Eiii_I(payment);
    then qualifying_specified_payment_512b13Eiii(payment);
}
@source(IRC_S512_B, quote = "(II) a contract which is a renewal, under substantially similar terms, of a contract described in subclause (I).")
rule QualifyingSpecifiedPaymentViaRenewal(payment: Text) defeasible {
    label en official "section 512(b)(13)(E)(iii)(II): a specified payment under a renewal on substantially similar terms";
    when specified_payment_512b13C(payment);
    when specified_payment_renewal_on_substantially_similar_terms_512b13Eiii_II(payment);
    then qualifying_specified_payment_512b13Eiii(payment);
}
pub relation qualifying_specified_payment_amount_512b13E(payment: Text, amount: Money) kind empirical {
    label en official "the amount of the qualifying specified payment received or accrued by the controlling organization";
}
pub relation arm_length_payment_amount_under_section_482_512b13E(payment: Text, amount: Money) kind empirical {
    label en official "the amount that would have been paid or accrued if the payment met the requirements prescribed under section 482";
}
pub relation excess_of_qualifying_payment_over_arm_length_512b13Ei(payment: Text, amount: Money) kind institutional {
    label en official "the portion of the qualifying specified payment that exceeds the arm's length amount — the only portion to which subparagraph (A) applies";
}
@source(IRC_S512_B, quote = "(i) In general.—Subparagraph (A) shall apply only to the portion of a qualifying specified payment received or accrued by the controlling organization that exceeds the amount which would have been paid or accrued if such payment met the requirements prescribed under section 482.")
rule ExcessOverArmLength(payment: Text, paid: Money, arm: Money) defeasible {
    label en official "section 512(b)(13)(E)(i): the excess of the payment over the section 482 amount (a payment at or below the arm's length amount has no excess)";
    when qualifying_specified_payment_512b13Eiii(payment);
    when qualifying_specified_payment_amount_512b13E(payment, paid);
    when arm_length_payment_amount_under_section_482_512b13E(payment, arm);
    when paid > arm;
    then excess_of_qualifying_payment_over_arm_length_512b13Ei(payment, paid - arm);
}
pub relation excess_determined_without_regard_to_amendments_512b13EiiI(payment: Text, amount: Money) kind empirical {
    label en official "the excess determined without regard to any amendment or supplement to a return of tax";
}
pub relation excess_determined_with_regard_to_all_amendments_512b13EiiII(payment: Text, amount: Money) kind empirical {
    label en official "the excess determined with regard to all such amendments and supplements";
}
pub relation valuation_misstatement_addition_to_tax_512b13Eii(payment: Text, amount: Money) kind institutional {
    label en official "the tax imposed on the controlling organization is increased by 20 percent of the larger of the two excess figures";
}
@source(IRC_S512_B, quote = "(ii) Addition to tax for valuation misstatements.—The tax imposed by this chapter on the controlling organization shall be increased by an amount equal to 20 percent of the larger of—")
@source(IRC_S512_B, quote = "(I) such excess determined without regard to any amendment or supplement to a return of tax, or")
@source(IRC_S512_B, quote = "(II) such excess determined with regard to all such amendments and supplements.")
rule ValuationMisstatementAdditionToTax(payment: Text, a: Money, b: Money) defeasible {
    label en official "section 512(b)(13)(E)(ii): 20 percent of the larger of the excess without regard to, and with regard to, amendments (equal figures give the same addition)";
    when excess_determined_without_regard_to_amendments_512b13EiiI(payment, a);
    when excess_determined_with_regard_to_all_amendments_512b13EiiII(payment, b);
    then valuation_misstatement_addition_to_tax_512b13Eii(payment, round(max(a, b) * 0.20, 2, "HALF_UP"));
}
// (16): financial institution conservatorship asset_id.
pub relation property_acquired_from_institution_in_conservatorship_512b16A(o: Person, asset_id: Text, acquired_on: Date) kind empirical {
    label en official "the property was acquired by the organization from a financial institution described in section 581 or 591(a) which is in conservatorship or receivership, or from the conservator or receiver (or a government agency succeeding to its rights)";
}
pub relation property_was_held_by_institution_or_foreclosed_512b16B(o: Person, asset_id: Text) kind empirical {
    label en official "the real property was held by the financial institution at the time it entered conservatorship or receivership, or was foreclosure property (section 514(c)(9)(H)(v)) that secured indebtedness it then held (an interest in a mortgage counts as real property)";
}
pub relation property_designated_held_for_sale_on_512b16Aii(o: Person, asset_id: Text, designated_on: Date) kind empirical {
    label en official "the date the organization designated the property as property held for sale";
}
pub relation designated_share_of_transaction_value_percent_512b16Aii(o: Person, asset_id: Text, pct: Decimal) kind empirical {
    label en official "the share (by value determined as of the acquisition date) of the property acquired in a single transaction that is designated as held for sale";
}
pub relation property_disposed_of_on_512b16Aiii(o: Person, asset_id: Text, disposed_on: Date) kind empirical {
    label en official "the date of the sale, exchange or other disposition";
}
pub relation secretary_specified_orderly_disposition_date_512b16AiiiII(o: Person, asset_id: Text, on: Date) kind empirical {
    label en official "the date specified by the Secretary in order to assure an orderly disposition of property held by such institutions";
}
pub relation improvement_expenditures_included_in_basis_512b16Aiv(o: Person, asset_id: Text, amount: Money) kind empirical {
    label en official "the aggregate expenditures on improvements and development activities included in the basis of the property while held by the organization";
}
pub relation net_selling_price_512b16Aiv(o: Person, asset_id: Text, amount: Money) kind empirical {
    label en official "the net selling price of the property";
}
pub relation financial_institution_property_disposition_conditions_met_512b16A(o: Person, asset_id: Text) kind institutional {
    label en official "the section 512(b)(16)(A)(i)-(iv) conditions are met, so the gain or loss is excluded";
}
@source(IRC_S512_B, quote = "(i) such property was acquired by the organization from—")
@source(IRC_S512_B, quote = "(ii) such property is designated by the organization within the 9-month period beginning on the date of its acquisition as property held for sale, except that not more than one-half (by value determined as of such date) of property acquired in a single transaction may be so designated,")
@source(IRC_S512_B, quote = "(iii) such sale, exchange, or disposition occurs before the later of—")
@source(IRC_S512_B, quote = "(I) the date which is 30 months after the date of the acquisition of such property, or")
@source(IRC_S512_B, quote = "(iv) while such property was held by the organization, the aggregate expenditures on improvements and development activities included in the basis of the property are (or were) not in excess of 20 percent of the net selling price of such property.")
rule FinancialInstitutionPropertyDispositionConditionsMet(o: Person, asset_id: Text, acquired: Date, designated: Date, pct: Decimal, disposed: Date, price: Money, spent: Money) defeasible {
    label en official "section 512(b)(16)(A): acquired from an institution in conservatorship, designated within 9 months (at most one-half of a single transaction by value), disposed of before 30 months after acquisition, improvements at most 20 percent of net selling price — every boundary is inclusive";
    when property_acquired_from_institution_in_conservatorship_512b16A(o, asset_id, acquired);
    when property_was_held_by_institution_or_foreclosed_512b16B(o, asset_id);
    when property_designated_held_for_sale_on_512b16Aii(o, asset_id, designated);
    when designated <= add_calendar_period(acquired, 9 calendar_month);
    when designated_share_of_transaction_value_percent_512b16Aii(o, asset_id, pct);
    when pct <= 50.0;
    when property_disposed_of_on_512b16Aiii(o, asset_id, disposed);
    when disposed < add_calendar_period(acquired, 30 calendar_month);
    when net_selling_price_512b16Aiv(o, asset_id, price);
    when improvement_expenditures_included_in_basis_512b16Aiv(o, asset_id, spent);
    when spent * 100 <= price * 20;
    then financial_institution_property_disposition_conditions_met_512b16A(o, asset_id);
}
// (17): insurance income of foreign corporations — the (B) exception.
pub enum InsuredPerson512b17B { TheOrganization, ExemptAffiliate, DirectorOfficerOrServiceProviderForRisksOfThoseServices }
pub relation insured_person_under_policy_512b17B(o: Person, policy: Text, kind: InsuredPerson512b17B) kind empirical {
    label en official "the person (directly or indirectly) insured by the policy of insurance or reinsurance is the organization (I), an affiliate exempt under section 501(a) (II), or a director, officer or individual performing services for the organization or affiliate where the insurance covers primarily risks associated with those services (III)";
}
pub relation insurance_income_exception_applies_512b17B(o: Person, policy: Text) kind institutional {
    label en official "subparagraph (A) does not apply to income attributable to the policy";
}
@source(IRC_S512_B, quote = "(i) In general.—Subparagraph (A) shall not apply to income attributable to a policy of insurance or reinsurance with respect to which the person (directly or indirectly) insured is—")
@source(IRC_S512_B, quote = "(I) such organization,")
@source(IRC_S512_B, quote = "(II) an affiliate of such organization which is exempt from tax under section 501(a), or")
@source(IRC_S512_B, quote = "(III) a director or officer of, or an individual who (directly or indirectly) performs services for, such organization or affiliate but only if the insurance covers primarily risks associated with the performance of services in connection with such organization or affiliate.")
rule InsuranceIncomeExceptionApplies(o: Person, policy: Text, k: InsuredPerson512b17B) defeasible {
    label en official "section 512(b)(17)(B)(i): policies insuring the organization, an exempt affiliate, or their directors, officers and service providers for their service risks";
    when insured_person_under_policy_512b17B(o, policy, k);
    then insurance_income_exception_applies_512b17B(o, policy);
}
pub relation colleges_or_hospitals_in_profit_returning_insurance_arrangement_512b17BiiII(a: Person, b: Person) kind empirical {
    label en official "the two organizations are colleges or universities described in section 170(b)(1)(A)(ii) or organizations described in section 170(b)(1)(A)(iii) and participate in an insurance arrangement that returns profits to the policyholders in their capacity as such";
}
pub relation treated_as_affiliates_512b17BiiII(a: Person, b: Person) kind institutional {
    label en official "the two organizations (and their affiliates) are treated as affiliates";
}
@source(IRC_S512_B, quote = "(II) Special rule.—Two or more organizations (and any affiliates of such organizations) shall be treated as affiliates if such organizations are colleges or universities described in section 170(b)(1)(A)(ii) or organizations described in section 170(b)(1)(A)(iii) and participate in an insurance arrangement that provides for any profits from such arrangement to be returned to the policyholders in their capacity as such.")
rule TreatedAsAffiliatesInReturnOfProfitArrangement(a: Person, b: Person) defeasible {
    label en official "section 512(b)(17)(B)(ii)(II): colleges or hospitals in a profit-returning insurance arrangement are affiliates";
    when colleges_or_hospitals_in_profit_returning_insurance_arrangement_512b17BiiII(a, b);
    then treated_as_affiliates_512b17BiiII(a, b);
}
// (19): brownfield sites — the eligible taxpayer test, the certification facts, the
// election period and the termination.
pub relation qualifying_brownfield_property_acquired_from_unrelated_person_512b19Bi_I(o: Person, asset_id: Text, acquired_on: Date) kind empirical {
    label en official "the organization acquires the qualifying brownfield property from an unrelated person";
}
pub relation eligible_remediation_expenditures_paid_512b19BiII(o: Person, asset_id: Text, amount: Money) kind empirical {
    label en official "the eligible remediation expenditures paid or incurred with respect to the property";
}
pub relation fair_market_value_at_acquisition_without_contamination_512b19BiII(o: Person, asset_id: Text, amount: Money) kind empirical {
    label en official "the fair market value of the property at the time it was acquired, determined as if there were no hazardous substance, pollutant or contaminant complicating its expansion, redevelopment or reuse";
}
pub relation potentially_liable_under_cercla_107_512b19Bii_I(o: Person, asset_id: Text) kind empirical {
    label en official "the organization is potentially liable under section 107 of the Comprehensive Environmental Response, Compensation, and Liability Act with respect to the property — EXTERNAL_DEPENDENCY on CERCLA";
}
pub relation affiliated_with_potentially_liable_person_512b19Bii_II(o: Person, asset_id: Text) kind empirical {
    label en official "the organization is affiliated with a potentially liable person through a familial, contractual, corporate or financial relationship other than one created by the conveyance or financing instruments or a contract for goods or services";
}
pub relation result_of_reorganization_of_potentially_liable_entity_512b19Bii_III(o: Person, asset_id: Text) kind empirical {
    label en official "the organization is the result of a reorganization of a business entity which was so potentially liable";
}
pub relation brownfield_eligible_taxpayer_exception_512b19Bii(o: Person, asset_id: Text) kind institutional {
    label en official "the organization is excluded from 'eligible taxpayer' by clause (ii)";
}
@source(IRC_S512_B, quote = "(ii) Exception.—Such term shall not include any organization which is—")
@source(IRC_S512_B, quote = "(I) potentially liable under section 107 of the Comprehensive Environmental Response, Compensation, and Liability Act of 1980 with respect to the qualifying brownfield property,")
rule EligibleTaxpayerExcludedViaLiability(o: Person, asset_id: Text) defeasible {
    label en official "section 512(b)(19)(B)(ii)(I): an organization potentially liable under CERCLA section 107";
    when potentially_liable_under_cercla_107_512b19Bii_I(o, asset_id);
    then brownfield_eligible_taxpayer_exception_512b19Bii(o, asset_id);
}
@source(IRC_S512_B, quote = "(II) affiliated with any other person which is so potentially liable through any direct or indirect familial relationship or any contractual, corporate, or financial relationship (other than a contractual, corporate, or financial relationship which is created by the instruments by which title to any qualifying brownfield property is conveyed or financed or by a contract of sale of goods or services), or")
rule EligibleTaxpayerExcludedViaAffiliation(o: Person, asset_id: Text) defeasible {
    label en official "section 512(b)(19)(B)(ii)(II): affiliated with a potentially liable person";
    when affiliated_with_potentially_liable_person_512b19Bii_II(o, asset_id);
    then brownfield_eligible_taxpayer_exception_512b19Bii(o, asset_id);
}
@source(IRC_S512_B, quote = "(III) the result of a reorganization of a business entity which was so potentially liable.")
rule EligibleTaxpayerExcludedViaReorganization(o: Person, asset_id: Text) defeasible {
    label en official "section 512(b)(19)(B)(ii)(III): the result of a reorganization of a potentially liable entity";
    when result_of_reorganization_of_potentially_liable_entity_512b19Bii_III(o, asset_id);
    then brownfield_eligible_taxpayer_exception_512b19Bii(o, asset_id);
}
pub relation brownfield_eligible_taxpayer_512b19B(o: Person, asset_id: Text) kind institutional {
    label en official "the organization is an eligible taxpayer for the property";
}
@source(IRC_S512_B, quote = "(B) Eligible taxpayer.—For purposes of this paragraph—")
@source(IRC_S512_B, quote = "(i) In general.—The term \"eligible taxpayer\" means, with respect to a property, any organization exempt from tax under section 501(a) which—")
@source(IRC_S512_B, quote = "(I) acquires from an unrelated person a qualifying brownfield property, and")
@source(IRC_S512_B, quote = "(II) pays or incurs eligible remediation expenditures with respect to such property in an amount which exceeds the greater of $550,000 or 12 percent of the fair market value of the property at the time such property was acquired by the eligible taxpayer, determined as if there was not a presence of a hazardous substance, pollutant, or contaminant on the property which is complicating the expansion, redevelopment, or reuse of the property.")
rule BrownfieldEligibleTaxpayer(o: Person, y: TaxableYear, asset_id: Text, acquired: Date, spent: Money, fmv: Money) defeasible {
    label en official "section 512(b)(19)(B): an exempt organization that acquires qualifying brownfield property from an unrelated person and pays or incurs eligible remediation expenditures exceeding the greater of $550,000 and 12 percent of the fair market value — an amount equal to the threshold does not exceed it";
    when exempt_organization(o, y);
    when qualifying_brownfield_property_acquired_from_unrelated_person_512b19Bi_I(o, asset_id, acquired);
    when eligible_remediation_expenditures_paid_512b19BiII(o, asset_id, spent);
    when fair_market_value_at_acquisition_without_contamination_512b19BiII(o, asset_id, fmv);
    when spent > 550000.00 USD;
    when spent * 100 > fmv * 12;
    unless brownfield_eligible_taxpayer_exception_512b19Bii(o, asset_id);
    then brownfield_eligible_taxpayer_512b19B(o, asset_id);
}
pub relation brownfield_property_certified_before_expenditures_512b19Ci(o: Person, asset_id: Text) kind empirical {
    label en official "the real property is certified, before the taxpayer incurs any eligible remediation expenditures (other than to obtain a Phase I environmental site assessment), by an appropriate State agency as a brownfield site within the meaning of section 101(39) of CERCLA — EXTERNAL_DEPENDENCY on the State agency and CERCLA";
}
pub relation qualified_disposition_transfer_to_unrelated_person_512b19DiI(o: Person, asset_id: Text) kind empirical {
    label en official "the property is transferred by the eligible taxpayer to an unrelated person";
}
pub relation transfer_date_512b19D(o: Person, asset_id: Text, on: Date) kind empirical {
    label en official "the date of the transfer";
}
pub relation transferee_non_qualifying_certification_received_on_512b19DiII(o: Person, asset_id: Text, on: Date) kind empirical {
    label en official "the date the eligible taxpayer received a certification from the Environmental Protection Agency or an appropriate State agency that, as a result of its remediation actions, the property would not be treated as qualifying brownfield property in the transferee's hands";
}
pub relation brownfield_disposition_qualified_512b19D(o: Person, asset_id: Text) kind institutional {
    label en official "the sale, exchange or other disposition is a qualified one: transferred to an unrelated person, with the transferee certification received within 1 year of the transfer";
}
@source(IRC_S512_B, quote = "(i) In general.—A sale, exchange, or other disposition of property shall be considered as qualified if—")
@source(IRC_S512_B, quote = "(I) such property is transferred by the eligible taxpayer to an unrelated person, and")
@source(IRC_S512_B, quote = "(II) within 1 year of such transfer the eligible taxpayer has received a certification from the Environmental Protection Agency or an appropriate State agency (within the meaning of section 198(c)(4)) in the State in which such property is located that, as a result of the eligible taxpayer's remediation actions, such property would not be treated as a qualifying brownfield property in the hands of the transferee.")
rule BrownfieldDispositionQualified(o: Person, asset_id: Text, transferred_on: Date, certified_on: Date) defeasible {
    label en official "section 512(b)(19)(D)(i): transfer to an unrelated person and, within 1 year of the transfer, the transferee-side certification — the last day of the year is inclusive";
    when brownfield_eligible_taxpayer_512b19B(o, asset_id);
    when qualified_disposition_transfer_to_unrelated_person_512b19DiI(o, asset_id);
    when transfer_date_512b19D(o, asset_id, transferred_on);
    when transferee_non_qualifying_certification_received_on_512b19DiII(o, asset_id, certified_on);
    when certified_on <= add_calendar_period(transferred_on, 1 calendar_year);
    then brownfield_disposition_qualified_512b19D(o, asset_id);
}
pub relation property_acquired_by_eligible_taxpayer_on_512b19K(o: Person, asset_id: Text, acquired_on: Date) kind empirical {
    label en official "the date the eligible taxpayer or qualifying partnership acquired the property";
}
pub relation brownfield_gain_or_loss_amount_512b19A(o: Person, asset_id: Text, amount: Money) kind empirical {
    label en official "the gain or loss from the disposition of the property, determined without amounts treated as ordinary income with respect to section 1245 or 1250 property (including section 198 expenses subject to recapture) that the taxpayer deducted in computing its unrelated business taxable income (section 512(b)(19)(F))";
}
pub relation brownfield_gain_or_loss_excluded_by_paragraph_19(o: Person, asset_id: Text, amount: Money) kind institutional {
    label en official "the gain or loss is excluded by section 512(b)(19)(A) — this paragraph does not apply to property acquired after December 31, 2009 (subparagraph (K))";
}
@source(IRC_S512_B, quote = "(A) In general.—Notwithstanding paragraph (5)(B), there shall be excluded any gain or loss from the qualified sale, exchange, or other disposition of any qualifying brownfield property by an eligible taxpayer.")
@source(IRC_S512_B, quote = "(K) Termination.—Except for purposes of determining the average eligible remediation expenditures for properties acquired during the election period under subparagraph (H), this paragraph shall not apply to any property acquired by the eligible taxpayer or qualifying partnership after December 31, 2009.")
rule BrownfieldGainOrLossExcludedForPropertyAcquiredThrough2009(o: Person, asset_id: Text, acquired_on: Date, amount: Money) defeasible {
    label en official "section 512(b)(19)(A), (K): notwithstanding paragraph (5)(B), gain or loss from the qualified disposition by an eligible taxpayer is excluded, but only for property acquired on or before December 31, 2009";
    when brownfield_eligible_taxpayer_512b19B(o, asset_id);
    when brownfield_property_certified_before_expenditures_512b19Ci(o, asset_id);
    when brownfield_disposition_qualified_512b19D(o, asset_id);
    when property_acquired_by_eligible_taxpayer_on_512b19K(o, asset_id, acquired_on);
    when acquired_on <= @2009-12-31;
    when brownfield_gain_or_loss_amount_512b19A(o, asset_id, amount);
    then brownfield_gain_or_loss_excluded_by_paragraph_19(o, asset_id, amount);
}
// (E)(ii): exceptions to eligible remediation expenditures.
pub enum ExcludedFromEligibleRemediationExpenditures512b19Eii { PurchasePriceOfProperty, LegalDefenseOrLiabilityInsuranceCosts, GovernmentGrantOrSubsidizedFinancing, ExpenditureBeforeEnactment }
pub relation expenditure_within_exclusion_512b19Eii(o: Person, expenditure: Text, kind: ExcludedFromEligibleRemediationExpenditures512b19Eii) kind empirical {
    label en official "the expenditure is any portion of the purchase price (I), environmental insurance for legal defense, owner/operator liability, lender liability or professional liability coverage (II), an amount reimbursed, funded or subsidized by government grants, tax-exempt bond proceeds or subsidized financing to that extent (III), or paid or incurred before the date of enactment of the paragraph (IV)";
}
pub relation paid_to_unrelated_third_person_512b19Ei(o: Person, expenditure: Text) kind empirical {
    label en official "the amount is paid or incurred by the eligible taxpayer to an unrelated third person";
}
pub relation expenditure_purpose_within_512b19EiI_to_IV(o: Person, expenditure: Text) kind empirical {
    label en official "the amount is for a Phase I environmental site assessment, or after the certification for goods and services necessary to obtain the certification of subparagraph (D)(i), including remediation of a hazardous substance (I), a Phase II assessment (II), environmental regulatory certifications and approvals (III), or cost-cap, stop-loss, re-opener or financial guarantee coverage required to manage the remediation (IV)";
}
pub relation eligible_remediation_expenditure_512b19E(o: Person, expenditure: Text) kind institutional {
    label en official "the amount is an eligible remediation expenditure";
}
@source(IRC_S512_B, quote = "(i) In general.—The term \"eligible remediation expenditures\" means, with respect to any qualifying brownfield property, any amount paid or incurred by the eligible taxpayer to an unrelated third person to obtain a Phase I environmental site assessment of the property, and any amount so paid or incurred after the date of the certification described in subparagraph (C)(i) for goods and services necessary to obtain a certification described in subparagraph (D)(i) with respect to such property, incl")
@source(IRC_S512_B, quote = "(I) to manage, remove, control, contain, abate, or otherwise remediate a hazardous substance, pollutant, or contaminant on the property,")
@source(IRC_S512_B, quote = "(II) to obtain a Phase II environmental site assessment of the property, including any expenditure to monitor, sample, study, assess, or otherwise evaluate the release, threat of release, or presence of a hazardous substance, pollutant, or contaminant on the property,")
@source(IRC_S512_B, quote = "(III) to obtain environmental regulatory certifications and approvals required to manage the remediation and monitoring of the hazardous substance, pollutant, or contaminant on the property, and")
@source(IRC_S512_B, quote = "(IV) regardless of whether it is necessary to obtain a certification described in subparagraph (D)(i)(II), to obtain remediation cost-cap or stop-loss coverage, re-opener or regulatory action coverage, or similar coverage under environmental insurance policies, or financial guarantees required to manage such remediation and monitoring.")
@source(IRC_S512_B, quote = "(ii) Exceptions.—Such term shall not include—")
rule EligibleRemediationExpenditure(o: Person, expenditure: Text) defeasible {
    label en official "section 512(b)(19)(E): amounts paid to an unrelated third person for the listed purposes, unless within one of the four exclusions";
    when paid_to_unrelated_third_person_512b19Ei(o, expenditure);
    when expenditure_purpose_within_512b19EiI_to_IV(o, expenditure);
    unless expenditure_excluded_512b19Eii(o, expenditure);
    then eligible_remediation_expenditure_512b19E(o, expenditure);
}
pub relation expenditure_excluded_512b19Eii(o: Person, expenditure: Text) kind institutional {
    label en official "the expenditure is within an exclusion from eligible remediation expenditures";
}
@source(IRC_S512_B, quote = "(I) any portion of the purchase price paid or incurred by the eligible taxpayer to acquire the qualifying brownfield property,")
@source(IRC_S512_B, quote = "(II) environmental insurance costs paid or incurred to obtain legal defense coverage, owner/operator liability coverage, lender liability coverage, professional liability coverage, or similar types of coverage,")
@source(IRC_S512_B, quote = "(III) any amount paid or incurred to the extent such amount is reimbursed, funded, or otherwise subsidized by grants provided by the United States, a State, or a political subdivision of a State for use in connection with the property, proceeds of an issue of State or local government obligations used to provide financing for the property the interest of which is exempt from tax under section 103, or subsidized financing provided (directly or indirectly) under a Federal, State, or local program ")
@source(IRC_S512_B, quote = "(IV) any expenditure paid or incurred before the date of the enactment of this paragraph.")
rule ExpenditureExcluded(o: Person, expenditure: Text, k: ExcludedFromEligibleRemediationExpenditures512b19Eii) defeasible {
    label en official "section 512(b)(19)(E)(ii)(I)-(IV): the four exclusions";
    when expenditure_within_exclusion_512b19Eii(o, expenditure, k);
    then expenditure_excluded_512b19Eii(o, expenditure);
}
// (H): the one-time election averaging expenditures.
pub relation election_return_first_day_of_taxable_year_512b19Hii_I(o: Person, start: Date) kind empirical {
    label en official "the first day of the taxable year of the return in which the election is included, or a later day in that year selected by the taxpayer, the day the election period begins";
}
pub relation revocation_date_selected_512b19HiiII(o: Person, on: Date) kind empirical {
    label en official "the revocation date selected by the eligible taxpayer or qualifying partnership";
}
pub relation election_period_end_candidate_512b19HiiII(o: Person, candidate: Date) kind institutional {
    label en official "a candidate end date of the election period: the revocation date, or the date 8 years after the start";
}
@source(IRC_S512_B, quote = "(II) ending on the date which is the earliest of a date of revocation selected by the eligible taxpayer or qualifying partnership, the date which is 8 years after the date described in subclause (I), or, in the case of an election by a qualifying partnership of which the eligible taxpayer is a partner, the date of the termination of the qualifying partnership.")
rule ElectionPeriodEndCandidateEightYears(o: Person, start: Date) defeasible {
    label en official "section 512(b)(19)(H)(ii)(II): the date which is 8 years after the start of the election period";
    when election_period_start_512b19HiiI(o, start);
    then election_period_end_candidate_512b19HiiII(o, add_calendar_period(start, 8 calendar_year));
}
@source(IRC_S512_B, quote = "(II) ending on the date which is the earliest of a date of revocation selected by the eligible taxpayer or qualifying partnership, the date which is 8 years after the date described in subclause (I), or, in the case of an election by a qualifying partnership of which the eligible taxpayer is a partner, the date of the termination of the qualifying partnership.")
rule ElectionPeriodEndCandidateRevocation(o: Person, on: Date) defeasible {
    label en official "section 512(b)(19)(H)(ii)(II): a revocation date selected by the taxpayer";
    when revocation_date_selected_512b19HiiII(o, on);
    then election_period_end_candidate_512b19HiiII(o, on);
}
pub relation election_period_end_512b19Hii(o: Person, end: Date) kind institutional {
    label en official "the election period ends on the earliest of the candidate dates";
}
@source(IRC_S512_B, quote = "(II) ending on the date which is the earliest of a date of revocation selected by the eligible taxpayer or qualifying partnership, the date which is 8 years after the date described in subclause (I), or, in the case of an election by a qualifying partnership of which the eligible taxpayer is a partner, the date of the termination of the qualifying partnership.")
rule ElectionPeriodEndsOnEarliestCandidate(o: Person, end: Date) defeasible {
    label en official "section 512(b)(19)(H)(ii)(II): the earliest of the candidate dates (no strictly earlier candidate exists)";
    when election_period_end_candidate_512b19HiiII(o, end);
    unless earlier_election_period_end_candidate_exists_512b19H(o, end);
    then election_period_end_512b19Hii(o, end);
}
pub relation earlier_election_period_end_candidate_exists_512b19H(o: Person, end: Date) kind institutional {
    label en official "helper: a strictly earlier candidate end date exists (the exception atom that binds every head variable)";
}
rule EarlierElectionPeriodEndCandidateExists(o: Person, end: Date, other: Date) defeasible {
    label en official "helper: another candidate date strictly earlier than the given one";
    when election_period_end_candidate_512b19HiiII(o, end);
    when election_period_end_candidate_512b19HiiII(o, other);
    when other < end;
    then earlier_election_period_end_candidate_exists_512b19H(o, end);
}
// (J): related persons.
pub relation person_bears_267b_or_707b1_relationship_at_25_percent_512b19Ji(a: Person, b: Person) kind empirical {
    label en official "the person bears a relationship to the other person described in section 267(b) (without regard to paragraph (9)) or section 707(b)(1), determined by substituting 25 percent for 50 percent";
}
pub relation share_of_governing_body_controlled_percent_512b19Jii(a: Person, nonprofit: Person, pct: Decimal) kind empirical {
    label en official "the percentage of the governing body of the nonprofit organization that the person controls directly or indirectly";
}
pub relation related_person_512b19J(a: Person, b: Person) kind institutional {
    label en official "the person is related to the other person for section 512(b)(19)";
}
@source(IRC_S512_B, quote = "(i) such person bears a relationship to such other person described in section 267(b) (determined without regard to paragraph (9) thereof), or section 707(b)(1), determined by substituting \"25 percent\" for \"50 percent\" each place it appears therein, and")
rule RelatedPersonViaStatutoryRelationship(a: Person, b: Person) defeasible {
    label en official "section 512(b)(19)(J)(i): a section 267(b) or 707(b)(1) relationship at 25 percent";
    when person_bears_267b_or_707b1_relationship_at_25_percent_512b19Ji(a, b);
    then related_person_512b19J(a, b);
}
@source(IRC_S512_B, quote = "(ii) in the case such other person is a nonprofit organization, if such person controls directly or indirectly more than 25 percent of the governing body of such organization.")
rule RelatedPersonViaGoverningBodyControl(a: Person, b: Person, pct: Decimal) defeasible {
    label en official "section 512(b)(19)(J)(ii): controls more than 25 percent of a nonprofit organization's governing body (exactly 25 percent does not)";
    when share_of_governing_body_controlled_percent_512b19Jii(a, b, pct);
    when pct > 25.0;
    then related_person_512b19J(a, b);
}

// ---------------------------------------------------------------------
// Section 512(c), (d), (e).
// ---------------------------------------------------------------------

pub relation partnership_unrelated_trade_or_business_regularly_carried_on_512c1(o: Person, partnership: Person, y: TaxableYear) kind empirical {
    label en official "a trade or business regularly carried on by a partnership of which the organization is a member is an unrelated trade or business with respect to the organization";
}
pub relation organization_share_of_partnership_gross_income_512c1(o: Person, partnership: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the organization's share (whether or not distributed) of the partnership's gross income from the unrelated trade or business";
}
pub relation organization_share_of_partnership_deductions_512c1(o: Person, partnership: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the organization's share of the partnership deductions directly connected with the gross income";
}
pub relation partnership_share_included_in_ubti_512c1(o: Person, partnership: Person, y: TaxableYear, gross: Money, deductions: Money) kind institutional {
    label en official "the organization includes its share of the partnership's gross income and deductions in computing its unrelated business taxable income, subject to the section 512(b) exceptions, additions and limitations";
}
@source(IRC_S512_C, quote = "If a trade or business regularly carried on by a partnership of which an organization is a member is an unrelated trade or business with respect to such organization, such organization in computing its unrelated business taxable income shall, subject to the exceptions, additions, and limitations contained in subsection (b), include its share (whether or not distributed) of the gross income of the partnership from such unrelated trade or business and its share of the partnership deductions direct")
rule PartnershipShareIncludedInUbti(o: Person, partnership: Person, y: TaxableYear, gross: Money, ded: Money) defeasible {
    label en official "section 512(c)(1): an unrelated partnership trade or business flows through to the member organization";
    when partnership_unrelated_trade_or_business_regularly_carried_on_512c1(o, partnership, y);
    when organization_share_of_partnership_gross_income_512c1(o, partnership, y, gross);
    when organization_share_of_partnership_deductions_512c1(o, partnership, y, ded);
    then partnership_share_included_in_ubti_512c1(o, partnership, y, gross, ded);
}
pub relation partnership_taxable_year_ending_within_or_with_organizations_year_512c2(partnership: Person, py: TaxableYear, o: Person, oy: TaxableYear) kind empirical {
    label en official "the partnership taxable year py ends within or with the organization's taxable year oy";
}
pub relation partnership_year_used_for_organization_year_512c2(partnership: Person, py: TaxableYear, o: Person, oy: TaxableYear) kind institutional {
    label en official "the amounts included or deducted are based on the partnership's taxable year py for the organization's taxable year oy";
}
@source(IRC_S512_C, quote = "If the taxable year of the organization is different from that of the partnership, the amounts to be included or deducted in computing the unrelated business taxable income under paragraph (1) shall be based upon the income and deductions of the partnership for any taxable year of the partnership ending within or with the taxable year of the organization.")
rule PartnershipYearUsedForDifferentTaxableYears(partnership: Person, py: TaxableYear, o: Person, oy: TaxableYear) defeasible {
    label en official "section 512(c)(2): with different taxable years, the amounts are based on the partnership year ending within or with the organization's year";
    when partnership_taxable_year_ending_within_or_with_organizations_year_512c2(partnership, py, o, oy);
    then partnership_year_used_for_organization_year_512c2(partnership, py, o, oy);
}
// (d): agricultural or horticultural organization dues.
pub relation c5_agricultural_or_horticultural_organization_requiring_annual_dues_512d1A(o: Person, y: TaxableYear) kind empirical {
    label en official "an agricultural or horticultural organization described in section 501(c)(5) requires annual dues to be paid in order to be a member";
}
pub relation required_annual_dues_amount_512d1B(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of the required annual dues — 'dues' means any payment (whether or not designated as dues) that is required to be made in order to be recognized as a member (section 512(d)(3))";
}
pub relation dues_limit_512d1_for_year(o: Person, y: TaxableYear, limit: Money) kind empirical {
    label en official "the section 512(d)(1) dues limit for the taxable year: $100, increased for taxable years beginning after 1995 by the cost-of-living adjustment (calendar year 1994 base) — the published indexed amounts are pinned in the parameter dataset DuesLimit512d1 where their Revenue Procedure is pinned";
}
pub relation member_dues_not_unrelated_trade_or_business_income_512d1(o: Person, y: TaxableYear) kind institutional {
    label en official "no portion of the dues is treated as derived from an unrelated trade or business by reason of the benefits or privileges to which members are entitled";
}
@source(IRC_S512_D, quote = "If—")
@source(IRC_S512_D, quote = "(A) an agricultural or horticultural organization described in section 501(c)(5) requires annual dues to be paid in order to be a member of such organization, and")
@source(IRC_S512_D, quote = "(B) the amount of such required annual dues does not exceed $100,")
@source(IRC_S512_D, quote = "in no event shall any portion of such dues be treated as derived by such organization from an unrelated trade or business by reason of any benefits or privileges to which members of such organization are entitled.")
rule MemberDuesNotUnrelatedTradeOrBusinessIncome(o: Person, y: TaxableYear, dues: Money, limit: Money) defeasible {
    label en official "section 512(d)(1): annual required dues not exceeding the limit are not unrelated trade or business income — dues equal to the limit qualify";
    when c5_agricultural_or_horticultural_organization_requiring_annual_dues_512d1A(o, y);
    when required_annual_dues_amount_512d1B(o, y, dues);
    when dues_limit_512d1_for_year(o, y, limit);
    when dues <= limit;
    then member_dues_not_unrelated_trade_or_business_income_512d1(o, y);
}
// (e): S corporation stock.
pub relation organization_holds_s_corporation_stock_512e1(o: Person, s_corp: Person, y: TaxableYear) kind empirical {
    label en official "an organization described in section 1361(c)(2)(A)(vi) or 1361(c)(6) holds stock in an S corporation";
}
pub relation employer_securities_held_by_esop_512e3(o: Person, s_corp: Person, y: TaxableYear) kind empirical {
    label en official "the stock is employer securities (within the meaning of section 409(l)) held by an employee stock ownership plan described in section 4975(e)(7)";
}
pub relation s_corporation_interest_is_unrelated_trade_or_business_512e1A(o: Person, s_corp: Person, y: TaxableYear) kind institutional {
    label en official "the interest in the S corporation is treated as an interest in an unrelated trade or business, and its items and the gain or loss on disposition are taken into account in computing unrelated business taxable income";
}
@source(IRC_S512_E, quote = "If an organization described in section 1361(c)(2)(A)(vi) or 1361(c)(6) holds stock in an S corporation—")
@source(IRC_S512_E, quote = "(A) such interest shall be treated as an interest in an unrelated trade or business, and")
@source(IRC_S512_E, quote = "(B) notwithstanding any other provision of this part—")
@source(IRC_S512_E, quote = "(i) all items of income, loss, or deduction taken into account under section 1366(a), and")
@source(IRC_S512_E, quote = "(ii) any gain or loss on the disposition of the stock in the S corporation,")
@source(IRC_S512_E, quote = "shall be taken into account in computing the unrelated business taxable income of such organization.")
rule SCorporationStockIsUnrelatedTradeOrBusiness(o: Person, s_corp: Person, y: TaxableYear) defeasible {
    label en official "section 512(e)(1): S corporation stock held by an organization described in section 1361(c)(2)(A)(vi) or (c)(6) is an unrelated trade or business interest";
    when organization_holds_s_corporation_stock_512e1(o, s_corp, y);
    unless employer_securities_held_by_esop_512e3(o, s_corp, y);
    then s_corporation_interest_is_unrelated_trade_or_business_512e1A(o, s_corp, y);
}
pub relation basis_of_purchased_s_stock_before_reduction_512e2(o: Person, s_corp: Person, amount: Money) kind empirical {
    label en official "the basis of stock in the S corporation acquired by purchase (as defined in section 1361(e)(1)(C))";
}
pub relation dividends_received_on_s_stock_512e2(o: Person, s_corp: Person, amount: Money) kind empirical {
    label en official "the dividends received by the organization with respect to the stock";
}
pub relation basis_of_purchased_s_stock_for_512e1_gain_or_loss_512e2(o: Person, s_corp: Person, amount: Money) kind institutional {
    label en official "the basis of purchased stock, reduced by the dividends received with respect to it (except as provided in regulations)";
}
@source(IRC_S512_E, quote = "Except as provided in regulations, for purposes of paragraph (1), the basis of any stock acquired by purchase (as defined in section 1361(e)(1)(C)) shall be reduced by the amount of any dividends received by the organization with respect to the stock.")
rule BasisOfPurchasedSStockReducedByDividends(o: Person, s_corp: Person, basis: Money, dividends: Money) defeasible {
    label en official "section 512(e)(2): the basis of purchased S stock is reduced by dividends received with respect to it";
    when basis_of_purchased_s_stock_before_reduction_512e2(o, s_corp, basis);
    when dividends_received_on_s_stock_512e2(o, s_corp, dividends);
    then basis_of_purchased_s_stock_for_512e1_gain_or_loss_512e2(o, s_corp, basis - dividends);
}

// Pinned-parameter reading of the section 512(d)(1) limit: the indexed
// amount is looked up from the dataset DuesLimit512d1 (Rev. Proc. 2024-40
// section 2.33, Rev. Proc. 2025-32 section 4.32) at legal_time; a date with no
// pinned value stays MISSING_PARAMETER_VALUE and this path does not fire.
@source(IRC_S512_D, quote = "(B) the amount of such required annual dues does not exceed $100,")
rule MemberDuesWithinPinnedIndexedLimit(o: Person, y: TaxableYear, dues: Money) defeasible {
    label en official "section 512(d)(1), (d)(2): annual required dues not exceeding the pinned indexed limit (DuesLimit512d1) — dues equal to the limit qualify";
    when c5_agricultural_or_horticultural_organization_requiring_annual_dues_512d1A(o, y);
    when required_annual_dues_amount_512d1B(o, y, dues);
    when dues <= DuesLimit512d1;
    then member_dues_not_unrelated_trade_or_business_income_512d1(o, y);
}
