// Section 509(a)(3) type labelling and section 509(f) requirements for
// supporting organizations — STAGE 2b (25.09.2026), closing TECH-GAPS G72.
//
// The statute itself names three relationship prongs in (a)(3)(B)(i)-(iii)
// (already modelled in 05-private-foundation-509.law); "Type I/II/III" is
// the REGULATORY (26 CFR 1.509(a)-4) label attached to each prong — Type I
// = operated, supervised, or controlled BY (B)(i); Type II = supervised or
// controlled IN CONNECTION WITH (B)(ii); Type III = operated IN CONNECTION
// WITH (B)(iii). Sourced to the same IRC_S509_A fragment as the prongs
// themselves since the label is a direct one-to-one restatement of them.
//
// (f)(1) Type III responsiveness/foreign-supported_org-organization bar and
// (f)(2) donor-control bar are modelled at the TOP-LEVEL condition; the
// (f)(2)(B)(iii) 35-percent-controlled-controlled_entity test reuses
// `us.irc.corporations::constructive_ownership` (already a package
// dependency) for an EXACT >35% test, matching `deductions/267-related-
// party.law`'s `share > 0.50` precedent for the analogous >50% test.

use self::{
    Corporation,
    IRC_S509_A,
    IRC_S509_F,
    Person,
    TaxableYear,
    section_509a3_operated_in_connection_with,
    section_509a3_operated_supervised_or_controlled_by,
    section_509a3_supervised_or_controlled_in_connection_with,
};

pub enum SupportingOrganizationType { TypeI, TypeII, TypeIII }

@source(IRC_S509_A, quote = "operated, supervised, or controlled by one or more organizations described in paragraph (1) or (2),")
pub relation supporting_organization_type(o: Person, kind: SupportingOrganizationType) kind institutional {
    label en unofficial "the section 509(a)(3)(B) relationship-prong label the organization satisfies (26 CFR 1.509(a)-4 nomenclature: Type I/II/III) — task's requested pub interface";
}
rule SupportingOrganizationTypeI(o: Person) defeasible {
    label en official "section 509(a)(3)(B)(i): Type I supporting organization";
    when section_509a3_operated_supervised_or_controlled_by(o);
    then supporting_organization_type(o, TypeI);
}
rule SupportingOrganizationTypeII(o: Person) defeasible {
    label en official "section 509(a)(3)(B)(ii): Type II supporting organization";
    when section_509a3_supervised_or_controlled_in_connection_with(o);
    then supporting_organization_type(o, TypeII);
}
rule SupportingOrganizationTypeIII(o: Person) defeasible {
    label en official "section 509(a)(3)(B)(iii): Type III supporting organization";
    when section_509a3_operated_in_connection_with(o);
    then supporting_organization_type(o, TypeIII);
}

// --- (f)(3): supported_org organization definition ---------------------------

@source(IRC_S509_F, quote = "the term \"supported organization\" means, with respect to an organization described in subsection (a)(3), an organization described in paragraph (1) or (2) of subsection (a)—\n(A) for whose benefit the organization described in subsection (a)(3) is organized and operated, or\n(B) with respect to which the organization performs the functions of, or carries out the purposes of.")
pub relation supported_organization_509f3(supporting: Person, supported_org: Person) kind empirical {
    label en official "the supported organization with respect to a section 509(a)(3) supporting organization: a section 509(a)(1)/(2) organization for whose benefit the supporting organization is organized and operated, or with respect to which it performs functions/carries out purposes (section 509(f)(3))";
}

// --- (f)(1): Type III responsiveness and foreign-supported_org-organization bar ---

@source(IRC_S509_F, quote = "the organization provides to each supported organization such information as the Secretary may require to ensure that such organization is responsive to the needs or demands of the supported organization.")
pub relation section_509f1A_responsiveness_information_provided(o: Person, y: TaxableYear) kind empirical {
    label en official "section 509(f)(1)(A): for each taxable year, the Type III organization provides each supported organization the information the Secretary requires to ensure responsiveness";
}
@source(IRC_S509_F, quote = "The organization is not operated in connection with any supported organization that is not organized in the United States.")
pub relation section_509f1B_operated_in_connection_with_foreign_supported_org(o: Person, y: TaxableYear) kind empirical {
    label en official "section 509(f)(1)(B)(i): the organization is operated in connection with a supported organization not organized in the United States (the disqualifying condition, subject to the (ii) transition rule — case-asserted directly, TECH-GAPS G487)";
}
pub relation section_509f1_type_iii_requirements_met(o: Person, y: TaxableYear) kind institutional {
    label en official "section 509(f)(1): the Type III supporting organization meets the responsiveness requirement and is not operated in connection with a foreign supported organization (subject to the (ii) transition rule)";
}
rule Section509f1TypeIIIRequirements(o: Person, y: TaxableYear) defeasible {
    label en official "section 509(f)(1): Type III responsiveness plus the foreign-supported-organization bar";
    when supporting_organization_type(o, TypeIII);
    when section_509f1A_responsiveness_information_provided(o, y);
    unless section_509f1B_operated_in_connection_with_foreign_supported_org(o, y);
    then section_509f1_type_iii_requirements_met(o, y);
}

// --- (f)(2): donor-control bar, incl. the 35-percent-controlled-controlled_entity rule ---

@source(IRC_S509_F, quote = "if such organization accepts any gift or contribution from any person described in subparagraph (B).")
pub relation section_509f2_accepted_gift_from_disqualifying_person(o: Person, y: TaxableYear) kind institutional {
    label en official "section 509(f)(2)(A): the organization accepted a gift or contribution from a person described in section 509(f)(2)(B) — this DISQUALIFIES the organization from Type I/II 'controlled by'/'supervised or controlled in connection with' status and from the Type III 'operated in connection with' status";
}
@source(IRC_S509_F, quote = "a person (other than an organization described in paragraph (1), (2), or (4) of section 509(a)) who directly or indirectly controls, either alone or together with persons described in clauses (ii) and (iii), the governing body of such supported organization,")
pub relation section_509f2Bi_controls_governing_body_of_supported_org(p: Person, supported_org: Person) kind empirical {
    label en official "section 509(f)(2)(B)(i): p (other than a section 509(a)(1)/(2)/(4) organization) directly or indirectly controls the governing body of the supported organization";
}
@source(IRC_S509_F, quote = "a member of the family (determined under section 4958(f)(4)) of an individual described in clause (i), or")
pub relation section_509f2Bii_family_member_of_controlling_individual(p: Person, controlling_individual: Person) kind empirical {
    label en official "section 509(f)(2)(B)(ii): p is a member of the family (section 4958(f)(4)) of a section 509(f)(2)(B)(i) controlling individual";
}
@source(IRC_S509_F, quote = "a 35-percent controlled entity (as defined in section 4958(f)(3) by substituting \"persons described in clause (i) or (ii) of section 509(f)(2)(B)\" for \"persons described in subparagraph (A) or (B) of paragraph (1)\" in subparagraph (A)(i) thereof).")
pub relation section_509f2Biii_thirty_five_percent_controlled_entity(controlled_entity: Corporation, disqualifying_group_combined_share: Decimal) kind institutional {
    label en official "section 509(f)(2)(B)(iii): the entity is a 35-percent controlled entity of the section 509(f)(2)(B)(i)/(ii) persons — combined voting/profits/beneficial interest exceeding 35 percent (section 4958(f)(3), as cross-referenced and modified)";
}
rule ThirtyFivePercentControlledEntity509f2(controlled_entity: Corporation, p: Person, share: Decimal, via: us.irc.corporations::AttributionKind) defeasible {
    label en official "section 509(f)(2)(B)(iii)/section 4958(f)(3): combined ownership share exceeding 35 percent (exact, matching the section 267(b)(2) >50%-share convention) makes the entity a 35-percent controlled entity";
    when section_509f2Bi_controls_governing_body_of_supported_org(p, _);
    when us.irc.corporations::constructive_ownership(p, controlled_entity, share, via);
    when share > 0.35;
    then section_509f2Biii_thirty_five_percent_controlled_entity(controlled_entity, share);
}

// ---------------------------------------------------------------------
// §108 note: `_` used as a wildcard argument follows the corpus
// convention already confirmed working in deferred-compensation
// (`adp_125x_test(plan, y, _, _)`).
// ---------------------------------------------------------------------
