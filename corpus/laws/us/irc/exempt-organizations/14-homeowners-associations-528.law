// Section 528: homeowners associations — STAGE 2b (25.09.2026).

use self::{
    IRC_S528_A,
    IRC_S528_B,
    IRC_S528_C,
    IRC_S528_D,
    Person,
    TaxableYear,
};

@source(IRC_S528_A, quote = "A homeowners association (as defined in subsection (c)) shall be subject to taxation under this subtitle only to the extent provided in this section. A homeowners association shall be considered an organization exempt from income taxes for the purpose of any law which refers to organizations exempt from income taxes.")
pub relation section_528a_treated_as_income_tax_exempt(o: Person, y: TaxableYear) kind institutional {
    label en official "section 528(a): a homeowners association is treated as income-tax-exempt for the purpose of any law referring to income-tax-exempt organizations, notwithstanding the section 528(b) tax";
}
rule Section528aTreatedExempt(o: Person, y: TaxableYear) defeasible {
    label en official "section 528(a)";
    when homeowners_association(o, y);
    then section_528a_treated_as_income_tax_exempt(o, y);
}

@source(IRC_S528_C, quote = "The term \"homeowners association\" means an organization which is a condominium management association, a residential real estate management association, or a timeshare association if—\n(A) such organization is organized and operated to provide for the acquisition, construction, management, maintenance, and care of association property,")
pub relation homeowners_association(o: Person, y: TaxableYear) kind institutional {
    label en official "section 528(c)(1): a condominium management, residential real estate management, or timeshare association meeting the (A)-(E) conditions — the election as a POWER, not an automatic status";
}
pub relation condo_residential_or_timeshare_association(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization is a condominium management association, a residential real estate management association, or a timeshare association (section 528(c)(1), (2), (3), or (4))";
}
pub relation organized_for_association_property_care_528c1A(o: Person) kind empirical {
    label en official "the organization is organized and operated to provide for the acquisition, construction, management, maintenance, and care of association property (section 528(c)(1)(A))";
}
@source(IRC_S528_C, quote = "60 percent or more of the gross income of such organization for the taxable year consists solely of amounts received as membership dues, fees, or assessments from—")
pub relation homeowners_association_sixty_percent_income_test(o: Person, y: TaxableYear, dues_income: Money, gross_income: Money) kind institutional {
    label en official "section 528(c)(1)(B): EXACT test — 100 * dues/fees/assessments income >= 60 * gross income, no division";
}
pub relation member_dues_fees_assessments_income_528c1B(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "gross income consisting solely of membership dues, fees, or assessments from unit/lot/timeshare owners (section 528(c)(1)(B))";
}
pub relation gross_income_528c(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the organization's gross income for the taxable year, for the section 528(c)(1)(B)/(C) percentage tests";
}
rule HomeownersAssociationSixtyPercentIncomeTest(o: Person, y: TaxableYear, dues: Money, gross: Money) defeasible {
    label en official "section 528(c)(1)(B): 60 percent income test, exact cross-multiplication";
    when member_dues_fees_assessments_income_528c1B(o, y, dues);
    when gross_income_528c(o, y, gross);
    when dues * 100 >= gross * 60;
    then homeowners_association_sixty_percent_income_test(o, y, dues, gross);
}
@source(IRC_S528_C, quote = "90 percent or more of the expenditures of the organization for the taxable year are expenditures for the acquisition, construction, management, maintenance, and care of association property and, in the case of a timeshare association, for activities provided to or on behalf of members of the association,")
pub relation homeowners_association_ninety_percent_expenditure_test(o: Person, y: TaxableYear, qualifying_expenditures: Money, total_expenditures: Money) kind institutional {
    label en official "section 528(c)(1)(C): EXACT test — 100 * qualifying expenditures >= 90 * total expenditures, no division";
}
pub relation qualifying_association_property_expenditures_528c1C(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "expenditures for the acquisition/construction/management/maintenance/care of association property (and, for a timeshare association, member activities) (section 528(c)(1)(C))";
}
pub relation total_expenditures_528c1C(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "total organization expenditures for the taxable year, for the section 528(c)(1)(C) percentage test";
}
rule HomeownersAssociationNinetyPercentExpenditureTest(o: Person, y: TaxableYear, qualifying: Money, total: Money) defeasible {
    label en official "section 528(c)(1)(C): 90 percent expenditure test, exact cross-multiplication";
    when qualifying_association_property_expenditures_528c1C(o, y, qualifying);
    when total_expenditures_528c1C(o, y, total);
    when qualifying * 100 >= total * 90;
    then homeowners_association_ninety_percent_expenditure_test(o, y, qualifying, total);
}
@source(IRC_S528_C, quote = "no part of the net earnings of such organization inures (other than by acquiring, constructing, or providing management, maintenance, and care of association property, and other than by a rebate of excess membership dues, fees, or assessments) to the benefit of any private shareholder or individual, and")
pub relation homeowners_association_inurement_established_528c1D(o: Person, y: TaxableYear) kind empirical {
    label en official "net earnings inure to a private shareholder or individual, other than through association-property care or an excess-dues rebate (section 528(c)(1)(D), the disqualifying condition)";
}
@source(IRC_S528_C, quote = "such organization elects (at such time and in such manner as the Secretary by regulations prescribes) to have this section apply for the taxable year.")
pub relation section_528c1E_election_made(o: Person, y: TaxableYear) kind empirical {
    label en unofficial "the exercise fact for the section 528(c)(1)(E) election";
}
rule Section528ElectionPower(o: Person, y: TaxableYear) strict {
    label en official "section 528(c)(1)(E): the organization may elect to have section 528 apply for the taxable year — a power, since the election changes the organization's tax regime";
    when condo_residential_or_timeshare_association(o, y);
    then power Section528Election {
        holder o;
        exercise section_528c1E_election_made(o, y);
        valid_when section_528_election_eligibility_met(o, y);
        effect homeowners_association(o, y);
    };
}
pub relation section_528_election_eligibility_met(o: Person, y: TaxableYear) kind institutional {
    label en official "the section 528(c)(1)(A)-(D) conditions (other than the election itself) are met, so the section 528(c)(1)(E) election is validly exercisable";
}
rule Section528ElectionEligibilityMet(o: Person, y: TaxableYear, dues: Money, gross: Money, qualifying_exp: Money, total_exp: Money) defeasible {
    label en official "section 528(c)(1)(A)-(D): eligibility for the section 528(c)(1)(E) election";
    when organized_for_association_property_care_528c1A(o);
    when homeowners_association_sixty_percent_income_test(o, y, dues, gross);
    when homeowners_association_ninety_percent_expenditure_test(o, y, qualifying_exp, total_exp);
    unless homeowners_association_inurement_established_528c1D(o, y);
    then section_528_election_eligibility_met(o, y);
}

@source(IRC_S528_B, quote = "A tax is hereby imposed for each taxable year on the homeowners association taxable income of every homeowners association. Such tax shall be equal to 30 percent of the homeowners association taxable income (32 percent of such income in the case of a timeshare association).")
pub relation section_528b_tax(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 528(b): 30 percent of homeowners association taxable income (32 percent for a timeshare association) — EXACT statutory rates, no A3 lookup needed since they are not indexed";
}
pub relation timeshare_association_528c4(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization is a timeshare association (section 528(c)(4)), for the section 528(b) 32-percent rate";
}
rule Section528bTaxNonTimeshare(o: Person, y: TaxableYear, income: Money) defeasible {
    label en official "section 528(b): 30 percent rate for a non-timeshare homeowners association";
    when homeowners_association(o, y);
    when homeowners_association_taxable_income(o, y, income);
    unless timeshare_association_528c4(o, y) and homeowners_association_taxable_income(o, y, income);
    then section_528b_tax(o, y, round(income * 0.30, 2, "HALF_UP"));
}
rule Section528bTaxTimeshare(o: Person, y: TaxableYear, income: Money) defeasible {
    label en official "section 528(b): 32 percent rate for a timeshare association";
    when homeowners_association(o, y);
    when timeshare_association_528c4(o, y);
    when homeowners_association_taxable_income(o, y, income);
    then section_528b_tax(o, y, round(income * 0.32, 2, "HALF_UP"));
}

@source(IRC_S528_D, quote = "the homeowners association taxable income of any organization for any taxable year is an amount equal to the excess (if any) of—\n(A) the gross income for the taxable year (excluding any exempt function income), over\n(B) the deductions allowed by this chapter which are directly connected with the production of the gross income (excluding exempt function income), computed with the modifications provided in paragraph (2).")
pub relation homeowners_association_taxable_income(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 528(d)(1): homeowners association taxable income — gross income excluding exempt function income, less directly connected deductions (excluding exempt function income) and the $100 specific deduction, not below zero";
}
pub relation gross_income_excluding_exempt_function_528d(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "gross income excluding exempt function income (section 528(d)(1)(A))";
}
pub relation deductions_directly_connected_excluding_exempt_function_528d(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "deductions directly connected with the production of gross income, excluding exempt function income, before modifications (section 528(d)(1)(B))";
}
rule HomeownersAssociationTaxableIncome(o: Person, y: TaxableYear, gross: Money, deductions: Money) defeasible {
    label en official "section 528(d)(1)-(2)(A): taxable income less the $100 specific deduction, not below zero";
    when homeowners_association(o, y);
    when gross_income_excluding_exempt_function_528d(o, y, gross);
    when deductions_directly_connected_excluding_exempt_function_528d(o, y, deductions);
    then homeowners_association_taxable_income(o, y, max(0.00 USD, gross - deductions - 100.00 USD));
}
@source(IRC_S528_D, quote = "the term \"exempt function income\" means any amount received as membership dues, fees, or assessments from—\n(A) owners of condominium housing units in the case of a condominium management association,")
pub relation homeowners_exempt_function_income_528d3(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 528(d)(3): exempt function income — membership dues/fees/assessments from condo unit owners, residential real property owners, or timeshare owners";
}
