// Stage 3 (TECH_GAP reduction and audit of the text-order links): clauses that modules 17-28 carried only through a
// neighbouring rule, and the multi-year ledgers of TECH-GAPS G2000-G2002, G2006, G2007.
//
// Ledgers are computed from RECORDED per-item facts (sums over empirical relations); nothing here reads a balance
// that a rule of the same chain produced (LDC-E4102). Every rule below is an ALTERNATIVE producer next to the
// aggregate-fact rule it decomposes; the aggregate facts of the earlier modules stay valid inputs.

// =====================================================================
// Section 1382(g)(1)(B): the four provisions of the pool agreement
// =====================================================================

use self::{
    IRC_S1382_G,
    IRC_S1383_B,
    IRC_S1388_H,
    IRC_S1388_J,
    IRC_S507_D,
    IRC_S512_A,
    IRC_S512_D,
    IRC_S527_J,
    IRC_S529A_B,
    IRC_S529_B,
    IRC_S529_C,
    IRC_S530_B,
    IRC_S530_D,
    Person,
    TaxableYear,
    aggregate_tax_benefit,
    completed_crop_pool_method_permitted_1382g1,
    computed_under_completed_crop_method_for_10_years_1382g1A,
    cooperative_taxable_year_bounds,
    net_asset_value_507c,
    per_unit_retain_certificate_1388g,
    pool_opened_before_march_1_1978_1382g1,
    qualified_per_unit_retain_certificate_1388h,
    reserve_for_post_retirement_benefits_512a3Eii,
    section_507a_voluntary_termination_notice_given,
    section_507a_willful_repeated_or_flagrant_act_established,
    termination_tax_507,
};

pub relation pool_agreement_loan_of_united_states_with_pool_as_collateral_1382g1Bi(coop: Person, pool: Text) kind empirical {
    label en official "section 1382(g)(1)(B)(i): the United States or its agency provides a loan to the organization with the products comprising the pool serving as collateral";
}
pub relation pool_agreement_loan_proceeds_used_for_price_support_advances_1382g1Bii(coop: Person, pool: Text) kind empirical {
    label en official "section 1382(g)(1)(B)(ii): the organization uses an amount equal to the loan proceeds to make price support advances to eligible producers, to defray costs of handling, processing and storage, and for related purposes";
}
pub relation pool_agreement_net_proceeds_repay_loan_1382g1Biii(coop: Person, pool: Text) kind empirical {
    label en official "section 1382(g)(1)(B)(iii): an amount equal to the net proceeds of the sale or exchange of the pool products is used to repay the loan until it is repaid in full (or all the products in the pool are sold or exchanged)";
}
pub relation pool_agreement_net_gains_distributed_to_producers_1382g1Biv(coop: Person, pool: Text) kind empirical {
    label en official "section 1382(g)(1)(B)(iv): the net gains of the sale or exchange of the pool products are distributed to eligible producers, except to the extent the United States or its agency permits otherwise";
}
pub relation pool_agreement_provisions_all_present_1382g1B(coop: Person, pool: Text) kind institutional {
    label en official "section 1382(g)(1)(B): the agreement with the United States or its agency includes all of the provisions (i)-(iv)";
}
@source(IRC_S1382_G, quote = "(i) the United States or such agency shall provide a loan to the organization with the products comprising the pool serving as collateral for such loan,")
@source(IRC_S1382_G, quote = "(iv) the net gains (as determined under such agreement) from the sale or exchange of such products shall be distributed to eligible producers, except to the extent that the United States or such agency permits otherwise.")
rule PoolAgreementProvisionsAllPresent1382g1B(coop: Person, pool: Text) defeasible {
    label en official "section 1382(g)(1)(B)(i)-(iv): all four provisions are in the agreement";
    when pool_agreement_loan_of_united_states_with_pool_as_collateral_1382g1Bi(coop, pool);
    when pool_agreement_loan_proceeds_used_for_price_support_advances_1382g1Bii(coop, pool);
    when pool_agreement_net_proceeds_repay_loan_1382g1Biii(coop, pool);
    when pool_agreement_net_gains_distributed_to_producers_1382g1Biv(coop, pool);
    then pool_agreement_provisions_all_present_1382g1B(coop, pool);
}
rule CompletedCropPoolMethodPermittedViaDecomposedAgreement(coop: Person, pool: Text, opened_on: Date) defeasible {
    label en official "section 1382(g)(1)(A)-(B): as the aggregate-agreement rule, with the agreement condition derived from its four provisions";
    when pool_opened_before_march_1_1978_1382g1(coop, pool, opened_on);
    when opened_on < @1978-03-01;
    when computed_under_completed_crop_method_for_10_years_1382g1A(coop);
    when pool_agreement_provisions_all_present_1382g1B(coop, pool);
    then completed_crop_pool_method_permitted_1382g1(coop, pool);
}

// =====================================================================
// Section 1388(h)(2)(B), (3): the bylaw agreement and the products it covers
// =====================================================================

pub relation cooperative_bylaw_membership_is_agreement_adopted_on_1388h2Bi(coop: Person, adopted_on: Date) kind empirical {
    label en official "section 1388(h)(2)(B)(i): the organization has adopted a bylaw providing that membership in the organization constitutes the agreement, on the date";
}
pub relation distributee_received_bylaw_notification_and_copy_on_1388h2Bii(coop: Person, patron: Person, received_on: Date) kind empirical {
    label en official "section 1388(h)(2)(B)(ii): the distributee has received a written notification and copy of the bylaw, on the date";
}
pub relation distributee_agreed_via_bylaw_components_1388h2B(coop: Person, patron: Person) kind institutional {
    label en official "section 1388(h)(2)(B): the distributee agreed by the bylaw (a bylaw adopted after November 13, 1966, and the notification with a copy received)";
}
@source(IRC_S1388_H, quote = "(i) such organization has adopted (after November 13, 1966) a bylaw providing that membership in the organization constitutes such agreement, and")
rule DistributeeAgreedViaBylawComponents1388h2B(coop: Person, patron: Person, adopted_on: Date, received_on: Date) defeasible {
    label en official "section 1388(h)(2)(B): bylaw adopted after November 13, 1966 (that day itself is too early) and the notification and copy received";
    when cooperative_bylaw_membership_is_agreement_adopted_on_1388h2Bi(coop, adopted_on);
    when adopted_on > @1966-11-13;
    when distributee_received_bylaw_notification_and_copy_on_1388h2Bii(coop, patron, received_on);
    then distributee_agreed_via_bylaw_components_1388h2B(coop, patron);
}
rule QualifiedPerUnitRetainCertificateViaBylawComponents(coop: Person, patron: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 1388(h)(2)(B): as the bylaw rule, with the agreement derived from its two components";
    when per_unit_retain_certificate_1388g(coop, patron, y, amount);
    when distributee_agreed_via_bylaw_components_1388h2B(coop, patron);
    then qualified_per_unit_retain_certificate_1388h(coop, patron, y, amount);
}
pub relation written_agreement_made_on_1388h2A(coop: Person, patron: Person, made_on: Date) kind empirical {
    label en official "section 1388(h)(2)(A): the date on which the distributee made the agreement in writing";
}
pub relation products_delivered_by_distributee_on_1388h3(coop: Person, patron: Person, delivered_on: Date) kind empirical {
    label en official "section 1388(h)(3): the date on which the distributee delivered products to the organization";
}
pub relation distributee_ceased_to_be_member_on_1388h3Bii(coop: Person, patron: Person, ceased_on: Date) kind empirical {
    label en official "section 1388(h)(3)(B)(ii): the date on which the distributee ceased to be a member of the organization";
}
pub relation bylaws_ceased_to_contain_the_provision_on_1388h3Bii(coop: Person, ceased_on: Date) kind empirical {
    label en official "section 1388(h)(3)(B)(ii): the date on which the bylaws of the organization ceased to contain the provision described in paragraph (2)(B)(i)";
}
pub relation written_agreement_covers_delivery_1388h3Ai(coop: Person, patron: Person, delivered_on: Date) kind institutional {
    label en official "section 1388(h)(3)(A)(i): a written agreement covers all products delivered during the taxable year of the organization in which it is made and all later taxable years";
}
@source(IRC_S1388_H, quote = "(i) an agreement described in paragraph (2)(A) shall be an agreement with respect to all products delivered by the distributee to the organization during the taxable year of the organization during which such agreement is made and all subsequent taxable years of the organization; and")
rule WrittenAgreementCoversDeliveries1388h3Ai(coop: Person, patron: Person, made_on: Date, delivered_on: Date, y: TaxableYear, begins: Date, ends: Date) defeasible {
    label en official "section 1388(h)(3)(A)(i): deliveries on or after the first day of the organization's taxable year in which the written agreement was made";
    when written_agreement_made_on_1388h2A(coop, patron, made_on);
    when products_delivered_by_distributee_on_1388h3(coop, patron, delivered_on);
    when cooperative_taxable_year_bounds(coop, y, begins, ends);
    when made_on >= begins;
    when made_on <= ends;
    when delivered_on >= begins;
    then written_agreement_covers_delivery_1388h3Ai(coop, patron, delivered_on);
}
pub relation bylaw_agreement_covers_delivery_1388h3Aii(coop: Person, patron: Person, delivered_on: Date) kind institutional {
    label en official "section 1388(h)(3)(A)(ii), (B)(ii): a bylaw agreement covers the products delivered after the notification and copy were received, and not those delivered after the distributee ceased to be a member or the bylaws ceased to contain the provision";
}
pub relation bylaw_agreement_ended_before_delivery_1388h3Bii(coop: Person, patron: Person, delivered_on: Date) kind institutional {
    label en official "marker: membership ended, or the bylaw provision was removed, before the delivery date";
}
rule BylawAgreementEndedByMembership1388h3Bii(coop: Person, patron: Person, delivered_on: Date, ceased_on: Date) defeasible {
    label en official "section 1388(h)(3)(B)(ii): the distributee ceased to be a member before the delivery";
    when products_delivered_by_distributee_on_1388h3(coop, patron, delivered_on);
    when distributee_ceased_to_be_member_on_1388h3Bii(coop, patron, ceased_on);
    when ceased_on < delivered_on;
    then bylaw_agreement_ended_before_delivery_1388h3Bii(coop, patron, delivered_on);
}
rule BylawAgreementEndedByBylawChange1388h3Bii(coop: Person, patron: Person, delivered_on: Date, ceased_on: Date) defeasible {
    label en official "section 1388(h)(3)(B)(ii): the bylaws ceased to contain the provision before the delivery";
    when products_delivered_by_distributee_on_1388h3(coop, patron, delivered_on);
    when bylaws_ceased_to_contain_the_provision_on_1388h3Bii(coop, ceased_on);
    when ceased_on < delivered_on;
    then bylaw_agreement_ended_before_delivery_1388h3Bii(coop, patron, delivered_on);
}
@source(IRC_S1388_H, quote = "(ii) an agreement described in paragraph (2)(B) shall be an agreement with respect to all products delivered by the distributee to the organization after he received the notification and copy described in paragraph (2)(B)(ii).")
rule BylawAgreementCoversDeliveries1388h3Aii(coop: Person, patron: Person, received_on: Date, delivered_on: Date) defeasible {
    label en official "section 1388(h)(3)(A)(ii): deliveries after the notification and copy were received (the delivery on the day of receipt is not after it), unless the agreement ended first";
    when distributee_received_bylaw_notification_and_copy_on_1388h2Bii(coop, patron, received_on);
    when products_delivered_by_distributee_on_1388h3(coop, patron, delivered_on);
    when delivered_on > received_on;
    unless bylaw_agreement_ended_before_delivery_1388h3Bii(coop, patron, delivered_on);
    then bylaw_agreement_covers_delivery_1388h3Aii(coop, patron, delivered_on);
}

// =====================================================================
// Section 1388(j)(3)(B), (C): commercially sensitive data and the revised notice
// =====================================================================

pub relation data_could_result_in_competitive_disadvantage_to_organization_1388j3Bi(coop: Person, item: Text) kind empirical {
    label en official "section 1388(j)(3)(B)(i): disclosing the data could result in a competitive disadvantage to the organization";
}
pub relation data_could_create_competitive_advantage_for_a_competitor_1388j3Bii(coop: Person, item: Text) kind empirical {
    label en official "section 1388(j)(3)(B)(ii): disclosing the data could create a competitive advantage to the benefit of a competitor of the organization";
}
pub relation commercially_sensitive_data_may_be_excluded_from_notice_1388j3B(coop: Person, item: Text) kind institutional {
    label en official "section 1388(j)(3)(B): the organization may exclude the detailed or specific data on earnings or losses of the units from the information of the notice (the determination is the organization's)";
}
rule CommercialSensitivityViaDisadvantage1388j3B(coop: Person, item: Text) defeasible {
    label en official "section 1388(j)(3)(B)(i)";
    when data_could_result_in_competitive_disadvantage_to_organization_1388j3Bi(coop, item);
    then commercially_sensitive_data_may_be_excluded_from_notice_1388j3B(coop, item);
}
rule CommercialSensitivityViaCompetitorAdvantage1388j3B(coop: Person, item: Text) defeasible {
    label en official "section 1388(j)(3)(B)(ii)";
    when data_could_create_competitive_advantage_for_a_competitor_1388j3Bii(coop, item);
    then commercially_sensitive_data_may_be_excluded_from_notice_1388j3B(coop, item);
}
pub relation secretary_determined_notice_insufficient_1388j3C(coop: Person, y: TaxableYear, determined_on: Date) kind empirical {
    label en official "section 1388(j)(3)(C): the Secretary determined that the organization failed to provide sufficient notice under paragraph (3), on the date";
}
pub relation secretary_notified_organization_of_insufficient_notice_1388j3Ci(coop: Person, y: TaxableYear, notified_on: Date) kind empirical {
    label en official "section 1388(j)(3)(C)(i): the Secretary notified the organization, on the date";
}
pub relation revised_notice_provided_to_patrons_1388j3Cii(coop: Person, y: TaxableYear) kind empirical {
    label en official "section 1388(j)(3)(C)(ii): the organization provided its patrons a revised notice meeting the requirements of paragraph (3)";
}
pub relation revised_notice_duty_1388j3Cii(coop: Person, y: TaxableYear, notified_on: Date) kind institutional {
    label en official "section 1388(j)(3)(C)(ii): the organization must provide a revised notice upon receipt of the Secretary's notification (no time limit is stated: the window is open-ended)";
}
@source(IRC_S1388_J, quote = "(ii) such organization shall, upon receipt of such notification, provide to its patrons a revised notice meeting the requirements of this paragraph.")
rule RevisedNoticeDuty1388j3Cii(coop: Person, y: TaxableYear, notified_on: Date) defeasible {
    label en official "section 1388(j)(3)(C): after a determination of insufficient notice and the Secretary's notification, a duty to provide a revised notice";
    when secretary_determined_notice_insufficient_1388j3C(coop, y, _);
    when secretary_notified_organization_of_insufficient_notice_1388j3Ci(coop, y, notified_on);
    then duty ProvideRevisedNettingNoticeToPatrons {
        bearer coop;
        goal achievement {
            condition revised_notice_provided_to_patrons_1388j3Cii(coop, y);
            window [notified_on, infinity];
        }
    };
}
pub relation treatment_of_organization_unaffected_by_notice_failure_1388j3C(coop: Person, y: TaxableYear) kind institutional {
    label en official "section 1388(j)(3)(C), last sentence: a failure to give sufficient notice does not affect the organization's treatment under any provision of this subchapter or section 521";
}
@source(IRC_S1388_J, quote = "Any such failure shall not affect the treatment of the organization under any provision of this subchapter or section 521.")
rule NoticeFailureDoesNotAffectTreatment1388j3C(coop: Person, y: TaxableYear) defeasible {
    label en official "section 1388(j)(3)(C), last sentence";
    when secretary_determined_notice_insufficient_1388j3C(coop, y, _);
    then treatment_of_organization_unaffected_by_notice_failure_1388j3C(coop, y);
}

// =====================================================================
// Sections 512(b)(5), 512(d)(3), 527(g)(3), 527(j)(3), (j)(6)
// =====================================================================

pub relation payment_required_to_be_recognized_as_member_512d3(o: Person, payment: Text) kind empirical {
    label en official "section 512(d)(3): the payment is required to be made in order to be recognized by the organization as a member (whether or not designated as dues)";
}
pub relation dues_payment_512d3(o: Person, payment: Text) kind institutional {
    label en official "section 512(d)(3): the payment is dues";
}
@source(IRC_S512_D, quote = "For purposes of this subsection, the term \"dues\" means any payment (whether or not designated as dues) which is required to be made in order to be recognized by the organization as a member of the organization.")
rule DuesPayment512d3(o: Person, payment: Text) defeasible {
    label en official "section 512(d)(3): dues are payments required for recognition as a member, by whatever name";
    when payment_required_to_be_recognized_as_member_512d3(o, payment);
    then dues_payment_512d3(o, payment);
}
pub relation candidate_publicly_announced_candidacy_527g3A(candidate: Person) kind empirical {
    label en official "section 527(g)(3)(A): the individual publicly announces that he is a candidate for nomination or election to the office";
}
pub relation candidate_meets_legal_qualifications_for_office_527g3B(candidate: Person) kind empirical {
    label en official "section 527(g)(3)(B): the individual meets the qualifications prescribed by law to hold the office";
}
pub relation candidate_for_purposes_of_527g_527g3(candidate: Person) kind institutional {
    label en official "section 527(g)(3): an individual who publicly announces his candidacy and meets the qualifications prescribed by law to hold the office is a candidate for the newsletter-fund rule";
}
rule CandidateFor527g527g3(candidate: Person) defeasible {
    label en official "section 527(g)(3)(A)-(B)";
    when candidate_publicly_announced_candidacy_527g3A(candidate);
    when candidate_meets_legal_qualifications_for_office_527g3B(candidate);
    then candidate_for_purposes_of_527g_527g3(candidate);
}
pub relation contribution_or_expenditure_disclosed_in_previous_period_527j3(o: Person, item: Text) kind empirical {
    label en official "section 527(j)(3): the expenditure or contribution was disclosed in a previous reporting period";
}
pub relation contribution_or_expenditure_reportable_in_current_period_527j3(o: Person, item: Text) kind institutional {
    label en official "section 527(j)(3): the item has to be included in the current reporting period (it is not if disclosed in a previous period)";
}
pub relation contribution_or_expenditure_recorded_for_period_527j3(o: Person, item: Text) kind empirical {
    label en official "the item is a reportable expenditure or contribution of the reporting period";
}
@source(IRC_S527_J, quote = "Any expenditure or contribution disclosed in a previous reporting period is not required to be included in the current reporting period.")
rule ReportableInCurrentPeriodUnlessDisclosedBefore527j3(o: Person, item: Text) defeasible {
    label en official "section 527(j)(3), last sentence";
    when contribution_or_expenditure_recorded_for_period_527j3(o, item);
    unless contribution_or_expenditure_disclosed_in_previous_period_527j3(o, item);
    then contribution_or_expenditure_reportable_in_current_period_527j3(o, item);
}
pub enum FederalElectionEvent527j6 { GeneralSpecialPrimaryOrRunoffElection, PartyConventionOrCaucusWithNominatingAuthority, PrimaryForSelectionOfDelegatesToNationalConvention, PrimaryForPresidentialNominationPreference }
pub relation federal_office_election_event_527j6(ev: Text, kind: FederalElectionEvent527j6) kind empirical {
    label en official "section 527(j)(6): the event is a general, special, primary or runoff election for a Federal office (A), a convention or caucus of a political party with authority to nominate a candidate for Federal office (B), a primary election held for the selection of delegates to a national nominating convention (C), or a primary election held for the expression of a preference for the nomination of individuals for election to the office of President (D)";
}
pub relation election_within_527j6(ev: Text) kind institutional {
    label en official "section 527(j)(6): the event is an election within the meaning of subsection (j)";
}
@source(IRC_S527_J, quote = "(D) a primary election held for the expression of a preference for the nomination of individuals for election to the office of President.")
rule ElectionWithin527j6(ev: Text, kind: FederalElectionEvent527j6) defeasible {
    label en official "section 527(j)(6)(A)-(D)";
    when federal_office_election_event_527j6(ev, kind);
    then election_within_527j6(ev);
}

// =====================================================================
// Sections 529(b)(5), (6), 529A(b)(3)-(6): what disqualifies a program
// =====================================================================

pub enum ProgramBar529 { InterestUsableAsSecurityForLoan, NoSafeguardsAgainstExcessContributions, NoSeparateAccountingPerBeneficiary, NoLimitOnInvestmentDirectionTwicePerYear }
pub relation program_allows_interest_as_security_for_loan_529b5(program: Person) kind empirical {
    label en official "sections 529(b)(5), 529A(b)(5): the program allows any interest in it (or any portion) to be used as security for a loan";
}
pub relation program_lacks_adequate_safeguards_against_excess_contributions_529b6(program: Person) kind empirical {
    label en official "section 529(b)(6): the program does not provide adequate safeguards to prevent contributions on behalf of a designated beneficiary in excess of those necessary to provide for the qualified higher education expenses of the beneficiary";
}
pub relation able_program_lacks_adequate_safeguards_against_excess_contributions_529Ab6(program: Person) kind empirical {
    label en official "section 529A(b)(6): the program does not provide adequate safeguards to prevent aggregate contributions on behalf of a designated beneficiary in excess of the limit established by the State under section 529(b)(6)";
}
pub relation able_program_lacks_separate_accounting_529Ab3(program: Person) kind empirical {
    label en official "section 529A(b)(3): the program does not provide separate accounting for each designated beneficiary";
}
pub relation able_program_lacks_investment_direction_limit_529Ab4(program: Person) kind empirical {
    label en official "section 529A(b)(4): the program does not provide that a designated beneficiary may direct the investment of contributions (or earnings) no more than 2 times in any calendar year";
}
pub relation program_barred_from_qualified_status_529(program: Person, bar: ProgramBar529) kind institutional {
    label en official "sections 529(b)(5)-(6), 529A(b)(3)-(6): the program is not treated as a qualified tuition program or qualified ABLE program for the reason";
}
@source(IRC_S529_B, quote = "A program shall not be treated as a qualified tuition program if it allows any interest in the program or any portion thereof to be used as security for a loan.")
rule ProgramBarredByLoanSecurity529b5(program: Person) defeasible {
    label en official "sections 529(b)(5), 529A(b)(5)";
    when program_allows_interest_as_security_for_loan_529b5(program);
    then program_barred_from_qualified_status_529(program, ProgramBar529.InterestUsableAsSecurityForLoan);
}
rule ProgramBarredByMissingSafeguards529b6(program: Person) defeasible {
    label en official "section 529(b)(6)";
    when program_lacks_adequate_safeguards_against_excess_contributions_529b6(program);
    then program_barred_from_qualified_status_529(program, ProgramBar529.NoSafeguardsAgainstExcessContributions);
}
@source(IRC_S529A_B, quote = "A program shall not be treated as a qualified ABLE program unless it provides adequate safeguards to prevent aggregate contributions on behalf of a designated beneficiary in excess of the limit established by the State under section 529(b)(6).")
rule AbleProgramBarredByMissingSafeguards529Ab6(program: Person) defeasible {
    label en official "section 529A(b)(6)";
    when able_program_lacks_adequate_safeguards_against_excess_contributions_529Ab6(program);
    then program_barred_from_qualified_status_529(program, ProgramBar529.NoSafeguardsAgainstExcessContributions);
}
@source(IRC_S529A_B, quote = "A program shall not be treated as a qualified ABLE program unless it provides separate accounting for each designated beneficiary.")
rule AbleProgramBarredByMissingSeparateAccounting529Ab3(program: Person) defeasible {
    label en official "section 529A(b)(3)";
    when able_program_lacks_separate_accounting_529Ab3(program);
    then program_barred_from_qualified_status_529(program, ProgramBar529.NoSeparateAccountingPerBeneficiary);
}
rule AbleProgramBarredByMissingInvestmentDirectionLimit529Ab4(program: Person) defeasible {
    label en official "section 529A(b)(4)";
    when able_program_lacks_investment_direction_limit_529Ab4(program);
    then program_barred_from_qualified_status_529(program, ProgramBar529.NoLimitOnInvestmentDirectionTwicePerYear);
}

// =====================================================================
// Section 530(b)(3): qualified elementary and secondary education expenses
// =====================================================================

pub enum ElementarySecondaryExpenseKind530b3 { TuitionFeesTutoringSpecialNeedsBooksSuppliesEquipment, RoomBoardUniformsTransportationSupplementaryItems, ComputerTechnologyEquipmentOrInternetAccess }
pub relation elementary_secondary_expense_530b3A(item: Text, kind: ElementarySecondaryExpenseKind530b3) kind empirical {
    label en official "section 530(b)(3)(A): the expense is of the kind (i) tuition, fees, academic tutoring, special needs services, books, supplies and other equipment incurred in connection with enrollment or attendance, (ii) room and board, uniforms, transportation and supplementary items and services required or provided by the school, or (iii) computer technology or equipment or Internet access and related services used by the beneficiary and family while in school";
}
pub relation expense_incurred_for_enrollment_or_attendance_at_school_530b3A(item: Text, school: Text) kind empirical {
    label en official "section 530(b)(3)(A): the expense is incurred in connection with the enrollment or attendance of the designated beneficiary as an elementary or secondary school student at the school";
}
pub relation school_provides_k12_education_under_state_law_530b3B(school: Text) kind empirical {
    label en official "section 530(b)(3)(B): the school provides elementary education or secondary education (kindergarten through grade 12), as determined under State law";
}
pub relation software_for_sports_games_or_hobbies_not_predominantly_educational_530b3A(item: Text) kind empirical {
    label en official "section 530(b)(3)(A), last sentence: the item is computer software designed for sports, games or hobbies which is not predominantly educational in nature";
}
pub relation qualified_elementary_secondary_expense_530b3(item: Text) kind institutional {
    label en official "section 530(b)(3): the item is a qualified elementary and secondary education expense";
}
@source(IRC_S530_B, quote = "The term \"school\" means any school which provides elementary education or secondary education (kindergarten through grade 12), as determined under State law.")
rule QualifiedElementarySecondaryExpense530b3(item: Text, kind: ElementarySecondaryExpenseKind530b3, school: Text) defeasible {
    label en official "section 530(b)(3)(A)-(B): an expense of a listed kind incurred for enrollment or attendance at a school (K-12 under State law), except software for sports, games or hobbies that is not predominantly educational";
    when elementary_secondary_expense_530b3A(item, kind);
    when expense_incurred_for_enrollment_or_attendance_at_school_530b3A(item, school);
    when school_provides_k12_education_under_state_law_530b3B(school);
    unless software_for_sports_games_or_hobbies_not_predominantly_educational_530b3A(item);
    then qualified_elementary_secondary_expense_530b3(item);
}

// =====================================================================
// G2006, G2007: sections 529(c)(3)(B)(vi), 530(d)(2)(C)(ii), (D)
// =====================================================================

pub relation distribution_of_individual_for_year_529c3Bvi(taxpayer: Person, calendar_year: Integer, distribution: Text, amount: Money) kind empirical {
    label en official "sections 529(c)(3)(B)(vi), 530(d)(2)(C)(ii): a distribution of the individual for the taxable year to which clauses (i) and (ii) and section 530(d)(2)(A) apply, and its amount";
}
pub relation qualified_expenses_taken_into_account_for_year_529c3Bvi(taxpayer: Person, calendar_year: Integer, amount: Money) kind empirical {
    label en official "section 529(c)(3)(B)(vi)(II): the total amount of qualified higher education expenses (qualified education expenses under section 530(d)(2)(C)) otherwise taken into account under clauses (i) and (ii), after the application of clause (v)";
}
pub relation aggregate_distributions_of_individual_for_year_529c3Bvi(taxpayer: Person, calendar_year: Integer, amount: Money) kind institutional {
    label en official "section 529(c)(3)(B)(vi)(I): the aggregate of the distributions of the individual for the year (a sum over the recorded distributions)";
}
rule AggregateDistributionsOfIndividual529c3Bvi(taxpayer: Person, calendar_year: Integer) defeasible {
    label en official "section 529(c)(3)(B)(vi)(I)";
    when qualified_expenses_taken_into_account_for_year_529c3Bvi(taxpayer, calendar_year, _);
    then aggregate_distributions_of_individual_for_year_529c3Bvi(taxpayer, calendar_year, sum(collect all d: Money, n: Text where distribution_of_individual_for_year_529c3Bvi(taxpayer, calendar_year, n, d), empty: 0.00 USD));
}
pub relation expenses_allocated_to_distribution_529c3Bvi(taxpayer: Person, calendar_year: Integer, distribution: Text, allocated: Money) kind institutional {
    label en official "sections 529(c)(3)(B)(vi), 530(d)(2)(C)(ii): where the aggregate distributions exceed the expenses, the taxpayer allocates the expenses among the distributions. JUDGMENT CALL: the statute leaves the method to the taxpayer; the pro rata share is the default computed here (one rounding, half up, cents)";
}
@source(IRC_S529_C, quote = "the taxpayer shall allocate such expenses among such distributions for purposes of determining the amount of the exclusion under clauses (i) and (ii) and section 530(d)(2)(A).")
rule ExpensesAllocatedProRataToDistribution529c3Bvi(taxpayer: Person, calendar_year: Integer, distribution: Text, amount: Money, total: Money, expenses: Money) defeasible {
    label en official "sections 529(c)(3)(B)(vi), 530(d)(2)(C)(ii): the expenses times the distribution over the aggregate, when the aggregate exceeds the expenses";
    when distribution_of_individual_for_year_529c3Bvi(taxpayer, calendar_year, distribution, amount);
    when aggregate_distributions_of_individual_for_year_529c3Bvi(taxpayer, calendar_year, total);
    when qualified_expenses_taken_into_account_for_year_529c3Bvi(taxpayer, calendar_year, expenses);
    when total > expenses;
    then expenses_allocated_to_distribution_529c3Bvi(taxpayer, calendar_year, distribution, div_round(expenses * (amount / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}
rule ExpensesAllocatedFullyWhenAggregateDoesNotExceed529c3Bvi(taxpayer: Person, calendar_year: Integer, distribution: Text, amount: Money, total: Money, expenses: Money) defeasible {
    label en official "sections 529(c)(3)(B)(vi), 530(d)(2)(C)(ii): no allocation is needed when the aggregate distributions do not exceed the expenses: each distribution is fully covered";
    when distribution_of_individual_for_year_529c3Bvi(taxpayer, calendar_year, distribution, amount);
    when aggregate_distributions_of_individual_for_year_529c3Bvi(taxpayer, calendar_year, total);
    when qualified_expenses_taken_into_account_for_year_529c3Bvi(taxpayer, calendar_year, expenses);
    when total <= expenses;
    then expenses_allocated_to_distribution_529c3Bvi(taxpayer, calendar_year, distribution, amount);
}
pub relation expenses_used_for_530d2_exclusion_530d2D(taxpayer: Person, calendar_year: Integer, amount: Money) kind empirical {
    label en official "section 530(d)(2)(D): the qualified education expenses taken into account in determining the amount of the exclusion under section 530(d)(2)";
}
pub relation qualified_education_expenses_of_year_530d2D(taxpayer: Person, calendar_year: Integer, amount: Money) kind empirical {
    label en official "the qualified education expenses of the taxpayer for the year, before any other benefit";
}
pub relation expenses_left_for_other_deduction_credit_or_exclusion_530d2D(taxpayer: Person, calendar_year: Integer, amount: Money) kind institutional {
    label en official "section 530(d)(2)(D): the part of the expenses not taken into account in the exclusion, the only part for which another section of this chapter may allow a deduction, credit or exclusion. The wiring into the rules of the other packages is NOT done (TECH-GAPS G6003)";
}
@source(IRC_S530_D, quote = "No deduction, credit, or exclusion shall be allowed to the taxpayer under any other section of this chapter for any qualified education expenses to the extent taken into account in determining the amount of the exclusion under this paragraph.")
rule ExpensesLeftForOtherBenefit530d2D(taxpayer: Person, calendar_year: Integer, total: Money, used: Money) defeasible {
    label en official "section 530(d)(2)(D): expenses less the expenses taken into account in the exclusion, not below zero";
    when qualified_education_expenses_of_year_530d2D(taxpayer, calendar_year, total);
    when expenses_used_for_530d2_exclusion_530d2D(taxpayer, calendar_year, used);
    then expenses_left_for_other_deduction_credit_or_exclusion_530d2D(taxpayer, calendar_year, max(0.00 USD, total - used));
}

// =====================================================================
// G2000: section 507(d)(1): the aggregate tax benefit
// =====================================================================

pub relation components_of_aggregate_tax_benefit_recorded_507d1(foundation: Person) kind empirical {
    label en official "section 507(d)(1): the components (A)-(C) of the aggregate tax benefit are recorded for the foundation";
}
pub relation contributor_tax_increase_if_deductions_disallowed_507d1A(foundation: Person, item: Text, amount: Money) kind empirical {
    label en official "section 507(d)(1)(A): an increase in tax under chapters 1, 11 and 12 (or the corresponding provisions of prior law) of a substantial contributor if deductions for his contributions after February 28, 1913 had been disallowed";
}
pub relation foundation_tax_increase_if_not_exempt_507d1B(foundation: Person, item: Text, amount: Money) kind empirical {
    label en official "section 507(d)(1)(B): an increase in tax under chapter 1 (or prior law) on the income of the foundation for a taxable year beginning after December 31, 1912 if it had not been exempt (and, for a trust, section 642(c) deductions had been limited to 20 percent of the taxable income)";
}
pub relation interest_on_tax_increase_507d1C(foundation: Person, item: Text, amount: Money) kind empirical {
    label en official "section 507(d)(1)(C): interest on an increase determined under (A) or (B), from the first date on which it would have been due and payable to the date the organization ceases to be a private foundation";
}
pub relation aggregate_tax_benefit_case_asserted_507d1(foundation: Person) kind institutional {
    label en official "marker: a single aggregate figure is asserted for the foundation";
}
rule AggregateTaxBenefitCaseAssertedMarker507d1(foundation: Person, amount: Money) defeasible {
    label en official "marker";
    when aggregate_tax_benefit(foundation, amount);
    then aggregate_tax_benefit_case_asserted_507d1(foundation);
}
pub relation aggregate_tax_benefit_computed_507d1(foundation: Person, amount: Money) kind institutional {
    label en official "section 507(d)(1): the aggregate tax benefit is the sum of (A), (B) and (C). The amount of each increase in tax is determined in accordance with regulations (section 507(d)(3)) and is recorded, not recomputed";
}
@source(IRC_S507_D, quote = "For purposes of subsection (c), the aggregate tax benefit resulting from the section 501(c)(3) status of any private foundation is the sum of—")
rule AggregateTaxBenefitFromComponents507d1(foundation: Person) defeasible {
    label en official "section 507(d)(1): (A) + (B) + (C), sums over the recorded items";
    when components_of_aggregate_tax_benefit_recorded_507d1(foundation);
    then aggregate_tax_benefit_computed_507d1(foundation, sum(collect all a: Money, i: Text where contributor_tax_increase_if_deductions_disallowed_507d1A(foundation, i, a), empty: 0.00 USD) + sum(collect all b: Money, j: Text where foundation_tax_increase_if_not_exempt_507d1B(foundation, j, b), empty: 0.00 USD) + sum(collect all c: Money, k: Text where interest_on_tax_increase_507d1C(foundation, k, c), empty: 0.00 USD));
}
rule TerminationTax507LowerIsBenefitComputed(o: Person, y: TaxableYear, benefit: Money, assets: Money) defeasible {
    label en official "section 507(c): as TerminationTax507LowerIsBenefit, with the aggregate tax benefit computed from the recorded components; not used when a single figure is asserted";
    when section_507a_voluntary_termination_notice_given(o, y) or section_507a_willful_repeated_or_flagrant_act_established(o, y);
    when aggregate_tax_benefit_computed_507d1(o, benefit);
    when net_asset_value_507c(o, assets);
    when benefit <= assets;
    when not_known(aggregate_tax_benefit_case_asserted_507d1(o));
    then termination_tax_507(o, benefit);
}
rule TerminationTax507LowerIsAssetsComputed(o: Person, y: TaxableYear, benefit: Money, assets: Money) defeasible {
    label en official "section 507(c): as TerminationTax507LowerIsAssets, with the aggregate tax benefit computed from the recorded components; not used when a single figure is asserted";
    when section_507a_voluntary_termination_notice_given(o, y) or section_507a_willful_repeated_or_flagrant_act_established(o, y);
    when aggregate_tax_benefit_computed_507d1(o, benefit);
    when net_asset_value_507c(o, assets);
    when assets < benefit;
    when not_known(aggregate_tax_benefit_case_asserted_507d1(o));
    then termination_tax_507(o, assets);
}

// =====================================================================
// G2001: section 512(a)(6): an organization with more than one unrelated trade or business
// =====================================================================

pub relation organization_with_recorded_unrelated_businesses_512a6(o: Person, y: TaxableYear) kind empirical {
    label en official "section 512(a)(6): the organization has more than 1 unrelated trade or business, recorded for the year";
}
pub relation business_taxable_income_before_nol_512a6A(o: Person, y: TaxableYear, business: Text, amount: Money) kind empirical {
    label en official "section 512(a)(6)(A): the unrelated business taxable income of the trade or business computed separately, without regard to subsection (b)(12) and before the net operating loss deduction (negative for a loss)";
}
pub relation business_nol_deduction_claimed_512a6A(o: Person, y: TaxableYear, business: Text, amount: Money) kind empirical {
    label en official "section 512(a)(6)(A): the net operating loss deduction claimed for the trade or business";
}
pub relation business_nol_carryover_available_512a6A(o: Person, y: TaxableYear, business: Text, amount: Money) kind empirical {
    label en official "section 512(a)(6)(A): the net operating loss carryovers of the same trade or business available for the year";
}
pub relation business_nol_deduction_exceeds_own_carryover_512a6A(o: Person, y: TaxableYear, business: Text) kind institutional {
    label en official "section 512(a)(6)(A): the deduction claimed for the trade or business exceeds the net operating loss carryovers of that same trade or business (the deduction is computed separately for each business)";
}
rule BusinessNolDeductionExceedsOwnCarryover512a6A(o: Person, y: TaxableYear, business: Text, claimed: Money, available: Money) defeasible {
    label en official "section 512(a)(6)(A): the deduction claimed above the business's own carryover (equal is within it)";
    when business_nol_deduction_claimed_512a6A(o, y, business, claimed);
    when business_nol_carryover_available_512a6A(o, y, business, available);
    when claimed > available;
    then business_nol_deduction_exceeds_own_carryover_512a6A(o, y, business);
}
pub relation specific_deduction_512b12_claimed(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 512(a)(6)(B): the specific deduction under subsection (b)(12) claimed once for the whole organization";
}
pub relation unrelated_business_taxable_income_of_all_businesses_512a6B(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 512(a)(6)(B): the sum of the separately computed amounts of all trades or businesses (each net of its own net operating loss deduction), less the specific deduction under (b)(12); no floor at zero is stated for the sum";
}
@source(IRC_S512_A, quote = "(B) the unrelated business taxable income of such organization shall be the sum of the unrelated business taxable income so computed with respect to each such trade or business, less a specific deduction under subsection (b)(12), and")
rule UnrelatedBusinessTaxableIncomeOfAllBusinesses512a6B(o: Person, y: TaxableYear, specific: Money) defeasible {
    label en official "section 512(a)(6)(B): sum over the recorded businesses of income before NOL, less the sum of NOL deductions, less the specific deduction";
    when organization_with_recorded_unrelated_businesses_512a6(o, y);
    when specific_deduction_512b12_claimed(o, y, specific);
    then unrelated_business_taxable_income_of_all_businesses_512a6B(o, y, sum(collect all a: Money, b: Text where business_taxable_income_before_nol_512a6A(o, y, b, a), empty: 0.00 USD) - sum(collect all n: Money, c: Text where business_nol_deduction_claimed_512a6A(o, y, c, n), empty: 0.00 USD) - specific);
}

// =====================================================================
// G2002: section 512(a)(3)(E)(ii)(I), (III): the existing reserve and the payments charged to it
// =====================================================================

pub relation post_retirement_benefit_payment_charged_512a3EiiIII(o: Person, item: Text, amount: Money) kind empirical {
    label en official "section 512(a)(3)(E)(ii)(III): a payment during a plan year ending on or after the date of enactment of the Tax Reform Act of 1984 of post-retirement medical or life insurance benefits (the plans of an employer are treated as 1 plan)";
}
pub relation reserve_remaining_after_charged_payments_512a3EiiIII(o: Person, amount: Money) kind institutional {
    label en official "section 512(a)(3)(E)(ii)(III): the reserve of subclause (II) reduced by all the recorded payments charged to it, not below zero";
}
@source(IRC_S512_A, quote = "(III) All payments during plan years ending on or after the date of the enactment of the Tax Reform Act of 1984 of post-retirement medical benefits or life insurance benefits shall be charged against the reserve referred to in subclause (II).")
rule ReserveRemainingAfterChargedPayments512a3EiiIII(o: Person, reserve: Money) defeasible {
    label en official "section 512(a)(3)(E)(ii)(III): the reserve less the sum of the charged payments";
    when reserve_for_post_retirement_benefits_512a3Eii(o, reserve);
    then reserve_remaining_after_charged_payments_512a3EiiIII(o, max(0.00 USD, reserve - sum(collect all p: Money, i: Text where post_retirement_benefit_payment_charged_512a3EiiIII(o, i, p), empty: 0.00 USD)));
}
pub relation income_attributable_to_existing_reserve_512a3EiiI(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 512(a)(3)(E)(ii)(I): the income of the set-aside attributable to the existing reserve";
}
pub relation clause_i_income_limitation_not_applicable_to_reserve_income_512a3EiiI(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 512(a)(3)(E)(ii)(I): clause (i) (the limit on the exclusion of set-aside income) does not apply to the income attributable to the existing reserve, up to the reserve remaining after the charged payments. JUDGMENT CALL: the statute does not say how the charge reduces the income attributable to the reserve; the income counts up to the remaining reserve (an amount cap)";
}
@source(IRC_S512_A, quote = "(I) Clause (i) shall not apply to any income attributable to an existing reserve for post-retirement medical or life insurance benefits.")
rule ClauseILimitationNotApplicableToReserveIncome512a3EiiI(o: Person, y: TaxableYear, income: Money, remaining: Money) defeasible {
    label en official "section 512(a)(3)(E)(ii)(I): reserve income, up to the remaining reserve";
    when income_attributable_to_existing_reserve_512a3EiiI(o, y, income);
    when reserve_remaining_after_charged_payments_512a3EiiIII(o, remaining);
    then clause_i_income_limitation_not_applicable_to_reserve_income_512a3EiiI(o, y, min(income, remaining));
}

// =====================================================================
// G2003 (part): section 512(b)(16)(A)(i), (B): the acquisition source and the property described
// =====================================================================

pub relation seller_is_financial_institution_in_conservatorship_or_receivership_512b16Ai(o: Person, asset_id: Text) kind empirical {
    label en official "section 512(b)(16)(A)(i)(I): the property was acquired from a financial institution described in section 581 or 591(a) which is in conservatorship or receivership";
}
pub relation seller_is_conservator_receiver_or_successor_agency_512b16Ai(o: Person, asset_id: Text) kind empirical {
    label en official "section 512(b)(16)(A)(i)(II): the property was acquired from the conservator or receiver of such an institution (or a government agency or corporation succeeding to the rights or interests of the conservator or receiver)";
}
pub relation acquisition_source_qualifies_512b16Ai(o: Person, asset_id: Text) kind institutional {
    label en official "section 512(b)(16)(A)(i): the property was acquired from a source described in subclause (I) or (II)";
}
rule AcquisitionSourceViaInstitution512b16Ai(o: Person, asset_id: Text) defeasible {
    label en official "section 512(b)(16)(A)(i)(I)";
    when seller_is_financial_institution_in_conservatorship_or_receivership_512b16Ai(o, asset_id);
    then acquisition_source_qualifies_512b16Ai(o, asset_id);
}
rule AcquisitionSourceViaConservator512b16Ai(o: Person, asset_id: Text) defeasible {
    label en official "section 512(b)(16)(A)(i)(II)";
    when seller_is_conservator_receiver_or_successor_agency_512b16Ai(o, asset_id);
    then acquisition_source_qualifies_512b16Ai(o, asset_id);
}
pub relation property_is_real_property_or_interest_in_a_mortgage_512b16B(asset_id: Text) kind empirical {
    label en official "section 512(b)(16)(B): the property is real property (real property includes an interest in a mortgage)";
}
pub relation property_held_by_institution_when_conservatorship_began_512b16Bi(asset_id: Text) kind empirical {
    label en official "section 512(b)(16)(B)(i): the property was held by the financial institution at the time it entered into conservatorship or receivership";
}
pub relation property_is_foreclosure_property_securing_indebtedness_held_by_institution_512b16Bii(asset_id: Text) kind empirical {
    label en official "section 512(b)(16)(B)(ii): the property was foreclosure property (section 514(c)(9)(H)(v)) which secured indebtedness held by the financial institution at such time";
}
pub relation real_property_described_512b16B(asset_id: Text) kind institutional {
    label en official "section 512(b)(16)(B): real property (including an interest in a mortgage) held by the institution when it entered conservatorship or receivership, or foreclosure property securing indebtedness it then held";
}
rule RealPropertyDescribedViaHeld512b16B(asset_id: Text) defeasible {
    label en official "section 512(b)(16)(B)(i)";
    when property_is_real_property_or_interest_in_a_mortgage_512b16B(asset_id);
    when property_held_by_institution_when_conservatorship_began_512b16Bi(asset_id);
    then real_property_described_512b16B(asset_id);
}
rule RealPropertyDescribedViaForeclosure512b16B(asset_id: Text) defeasible {
    label en official "section 512(b)(16)(B)(ii)";
    when property_is_real_property_or_interest_in_a_mortgage_512b16B(asset_id);
    when property_is_foreclosure_property_securing_indebtedness_held_by_institution_512b16Bii(asset_id);
    then real_property_described_512b16B(asset_id);
}

// =====================================================================
// G489: sections 527(i)(2), (k)(1): the hour windows computed at day granularity
// =====================================================================
// The two deadline rules sit next to their consumers in module 25 (NoticeDeadline527i2FromEstablishment,
// InternetPublicationDeadline527k1FromFiling): the asserted deadline facts are replaced by dates computed from the
// establishment and filing dates (JUDGMENT CALL recorded in their labels).

// =====================================================================
// Section 1383(b)(3)
// =====================================================================

pub relation tax_is_the_amount_determined_under_1383a2(coop: Person, y: TaxableYear) kind empirical {
    label en official "section 1383(b)(3): the tax imposed by this chapter for the taxable year is the amount determined under subsection (a)(2)";
}
pub relation deduction_of_1383a_disregarded_for_other_purposes_1383b3(coop: Person, y: TaxableYear) kind institutional {
    label en official "section 1383(b)(3): the deduction described in subsection (a) is not taken into account for any purpose of this subtitle other than for purposes of this section";
}
@source(IRC_S1383_B, quote = "(3) If the tax imposed by this chapter for the taxable year is the amount determined under subsection (a)(2), then the deduction described in subsection (a) shall not be taken into account for any purpose of this subtitle other than for purposes of this section.")
rule DeductionOf1383aDisregardedForOtherPurposes1383b3(coop: Person, y: TaxableYear) defeasible {
    label en official "section 1383(b)(3)";
    when tax_is_the_amount_determined_under_1383a2(coop, y);
    then deduction_of_1383a_disregarded_for_other_purposes_1383b3(coop, y);
}

// =====================================================================
// Section 1388(j)(2): netting after the acquisition of another organization's assets
// =====================================================================

pub relation cooperative_acquired_assets_of_another_in_381a_transaction_1388j2(acquirer: Person, acquired: Person, acquired_on: Date) kind empirical {
    label en official "section 1388(j)(2): the organization acquires the assets of another such organization in a transaction described in section 381(a), on the date";
}
pub relation earnings_of_allocation_unit_allocable_to_period_after_acquisition_1388j2A(unit: Text, allocable_after: Boolean) kind empirical {
    label en official "section 1388(j)(2)(A): the earnings of the allocation unit are properly allocable to periods after the date of acquisition (true) or not (false)";
}
pub relation earnings_could_have_been_offset_by_losses_within_one_organization_1388j2B(earnings_unit: Text, loss_unit: Text) kind empirical {
    label en official "section 1388(j)(2)(B): the earnings could have been offset by the losses if they had been derived from allocation units of the same organization";
}
pub relation cross_organization_offset_permitted_1388j2(acquirer: Person, earnings_unit: Text, loss_unit: Text) kind institutional {
    label en official "section 1388(j)(2): after the acquisition the acquiring organization may offset the losses of a unit of the acquiring or acquired organization against the earnings of a unit of the acquired or acquiring organization, only to the extent (A) and (B)";
}
@source(IRC_S1388_J, quote = "(B) such earnings could have been offset by such losses if such earnings and losses had been derived from allocation units of the same organization.")
rule CrossOrganizationOffsetPermitted1388j2(acquirer: Person, acquired: Person, acquired_on: Date, earnings_unit: Text, loss_unit: Text) defeasible {
    label en official "section 1388(j)(2)(A)-(B): earnings allocable to periods after the acquisition that the losses could have offset within one organization";
    when cooperative_acquired_assets_of_another_in_381a_transaction_1388j2(acquirer, acquired, acquired_on);
    when earnings_of_allocation_unit_allocable_to_period_after_acquisition_1388j2A(earnings_unit, true);
    when earnings_could_have_been_offset_by_losses_within_one_organization_1388j2B(earnings_unit, loss_unit);
    then cross_organization_offset_permitted_1388j2(acquirer, earnings_unit, loss_unit);
}
