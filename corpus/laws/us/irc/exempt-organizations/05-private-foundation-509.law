// Section 509 — private foundation defined.
//
// SCOPE: (a) in full structure — the four `is_public_charity` branches
// (a)(1)-(4) — with (a)(2)'s 33⅓%/33⅓% tests as EXACT Decimal computations
// over case-asserted aggregate support figures (per the task: "over
// asserted 5-year support figures"; the regulatory meaning of "normally",
// 26 CFR 1.509(a)-3(c), is itself EXTERNAL_DEPENDENCY — this package reads
// the aggregate figures as already-computed inputs, it does not compute
// the rolling 4-year-plus-current average itself). (a)(1) is
// EXTERNAL_DEPENDENCY on `us.irc.deductions` (section 170(b)(1)(A) is that
// package's classification). (a)(3) (supporting organizations) is modelled
// structurally to the three named prongs (A)/(B)/(C) WITHOUT the (f)
// responsiveness/integral-part sub-requirements or the type I/II/III
// labelling — TECH-GAPS row G72. (a)(4) (testing for public safety) is a
// plain classification. (b)-(c) (continuing private-foundation status
// after termination) and (d)-(f) (the "support" definition detail beyond
// what (a)(2) needs, and the (a)(3)(B)(iii) responsiveness requirements)
// are NOT modelled this stage.

// ---------------------------------------------------------------------
// (a)(1): cross-reference to section 170(b)(1)(A).
// ---------------------------------------------------------------------

use self::{
    IRC_S509_A,
    IRC_S509_D,
    Person,
    TaxableYear,
    section_501c3,
};

@source(IRC_S509_A, quote = "an organization described in section 170(b)(1)(A) (other than in clauses (vii) and (viii))")
pub relation section_170b1A_organization_excluding_vii_viii(o: Person, y: TaxableYear) kind institutional {
    label en unofficial "the organization is described in section 170(b)(1)(A), other than in clauses (vii) and (viii) — EXTERNAL_DEPENDENCY on us.irc.deductions (section 170(c) donee-status owner)";
}
@source(IRC_S509_A, quote = "an organization described in section 170(b)(1)(A) (other than in clauses (vii) and (viii));")
rule PublicCharityVia509a1(o: Person, y: TaxableYear) defeasible {
    label en official "section 509(a)(1): an organization described in section 170(b)(1)(A) (other than clauses (vii)-(viii)) is not a private foundation";
    when section_170b1A_organization_excluding_vii_viii(o, y);
    then is_public_charity(o, y);
}

// ---------------------------------------------------------------------
// (a)(2): the 33 1/3% support test and the 33 1/3% investment-income
// ceiling. Exact fraction comparisons — multiply, never divide, so the
// exactly-one-third boundary is comparable without rounding.
// ---------------------------------------------------------------------

@source(IRC_S509_A, quote = "gifts, grants, contributions, or membership fees, and")
pub relation aggregate_gifts_grants_and_membership_fees(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate section 509(a)(2)(A)(i) support (gifts, grants, contributions, membership fees) for the 'normally' testing period ending with this taxable year";
}
@source(IRC_S509_A, quote = "gross receipts from admissions, sales of merchandise, performance of services, or furnishing of facilities, in an activity which is not an unrelated trade or business (within the meaning of section 513), not including such receipts from any person, or from any bureau or similar agency of a governmental unit (as described in section 170(c)(1)), in any taxable year to the extent such receipts exceed the greater of $5,000 or 1 percent of the organization's support in such taxable year")
pub relation aggregate_qualifying_admissions_and_sales_receipts(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate section 509(a)(2)(A)(ii) support (qualifying gross receipts from admissions, merchandise, services, facilities), already net of the per-person/governmental-unit excess over the greater of $5,000 or 1 percent of the organization's support, for the 'normally' testing period ending with this taxable year";
}
@source(IRC_S509_A, quote = "from persons other than disqualified persons (as defined in section 4946) with respect to the organization, from governmental units described in section 170(c)(1), or from organizations described in section 170(b)(1)(A) (other than in clauses (vii) and (viii)), and")
pub relation section_509a2a_source_restriction_applied(o: Person, y: TaxableYear) kind empirical {
    label en official "the aggregate amounts asserted for section 509(a)(2)(A) already exclude amounts from disqualified persons, so that only support from persons other than disqualified persons (or from governmental units or section 170(b)(1)(A) organizations) is counted";
}
@source(IRC_S509_A, quote = "gross investment income (as defined in subsection (e)) and")
pub relation aggregate_gross_investment_income_509e(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate section 509(e) gross investment income for the 'normally' testing period ending with this taxable year";
}
@source(IRC_S509_A, quote = "the excess (if any) of the amount of the unrelated business taxable income (as defined in section 512) over the amount of the tax imposed by section 511;")
pub relation aggregate_ubti_excess_over_511_tax(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate excess, over the testing period, of unrelated business taxable income (section 512) over the tax imposed by section 511";
}
@source(IRC_S509_D, quote = "the term \"support\" includes (but is not limited to)—")
pub relation aggregate_total_support(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the organization's aggregate total support (section 509(d)) for the 'normally' testing period ending with this taxable year";
}

@source(IRC_S509_A, quote = "normally receives more than one-third of its support in each taxable year from any combination of—")
pub relation meets_509a2A_more_than_one_third_support(o: Person, y: TaxableYear) kind institutional {
    label en official "section 509(a)(2)(A): the organization normally receives more than one-third of its support from the combination of qualifying gifts/grants/fees and qualifying gross receipts";
}
rule Meets509a2ASupportTest(o: Person, y: TaxableYear, gifts: Money, receipts: Money, total: Money) defeasible {
    label en official "section 509(a)(2)(A): 3 * (gifts + qualifying receipts) > total support — exact multiplication, no division, so exactly one-third fails this strict inequality";
    when aggregate_gifts_grants_and_membership_fees(o, y, gifts);
    when aggregate_qualifying_admissions_and_sales_receipts(o, y, receipts);
    when section_509a2a_source_restriction_applied(o, y);
    when aggregate_total_support(o, y, total);
    when (gifts + receipts) * 3 > total;
    then meets_509a2A_more_than_one_third_support(o, y);
}

@source(IRC_S509_A, quote = "normally receives not more than one-third of its support in each taxable year from the sum of—")
pub relation meets_509a2B_not_more_than_one_third_investment(o: Person, y: TaxableYear) kind institutional {
    label en official "section 509(a)(2)(B): the organization normally receives not more than one-third of its support from the sum of gross investment income and the section 511/512 UBTI excess";
}
rule Meets509a2BInvestmentCeiling(o: Person, y: TaxableYear, investment: Money, ubti_excess: Money, total: Money) defeasible {
    label en official "section 509(a)(2)(B): 3 * (investment income + UBTI excess) <= total support — the boundary (exactly one-third) SATISFIES 'not more than'";
    when aggregate_gross_investment_income_509e(o, y, investment);
    when aggregate_ubti_excess_over_511_tax(o, y, ubti_excess);
    when aggregate_total_support(o, y, total);
    when (investment + ubti_excess) * 3 <= total;
    then meets_509a2B_not_more_than_one_third_investment(o, y);
}

@source(IRC_S509_A, quote = "an organization which—")
rule PublicCharityVia509a2(o: Person, y: TaxableYear) defeasible {
    label en official "section 509(a)(2): an organization meeting both the more-than-one-third support test and the not-more-than-one-third investment-income ceiling is not a private foundation";
    when meets_509a2A_more_than_one_third_support(o, y);
    when meets_509a2B_not_more_than_one_third_investment(o, y);
    then is_public_charity(o, y);
}

// ---------------------------------------------------------------------
// (a)(3): supporting organizations — the three named prongs, without the
// (f) responsiveness/integral-part detail or type labelling.
// ---------------------------------------------------------------------

@source(IRC_S509_A, quote = "is organized, and at all times thereafter is operated, exclusively for the benefit of, to perform the functions of, or to carry out the purposes of one or more specified organizations described in paragraph (1) or (2),")
pub relation section_509a3_organized_and_operated_for_supported_orgs(o: Person) kind empirical {
    label en official "the organization is organized, and at all times thereafter operated, exclusively for the benefit of, to perform the functions of, or to carry out the purposes of one or more section 509(a)(1)/(2) organizations (section 509(a)(3)(A))";
}
@source(IRC_S509_A, quote = "operated, supervised, or controlled by one or more organizations described in paragraph (1) or (2),")
pub relation section_509a3_operated_supervised_or_controlled_by(o: Person) kind empirical {
    label en official "the organization is operated, supervised, or controlled by one or more section 509(a)(1)/(2) organizations (section 509(a)(3)(B)(i))";
}
@source(IRC_S509_A, quote = "supervised or controlled in connection with one or more such organizations, or")
pub relation section_509a3_supervised_or_controlled_in_connection_with(o: Person) kind empirical {
    label en official "the organization is supervised or controlled in connection with one or more section 509(a)(1)/(2) organizations (section 509(a)(3)(B)(ii))";
}
@source(IRC_S509_A, quote = "operated in connection with one or more such organizations, and")
pub relation section_509a3_operated_in_connection_with(o: Person) kind empirical {
    label en official "the organization is operated in connection with one or more section 509(a)(1)/(2) organizations (section 509(a)(3)(B)(iii)) — the (f) responsiveness/integral-part requirements this bare relation does not further test are TECH-GAPS row G72";
}
@source(IRC_S509_A, quote = "is not controlled directly or indirectly by one or more disqualified persons (as defined in section 4946) other than foundation managers and other than one or more organizations described in paragraph (1) or (2); and")
pub relation section_509a3_not_controlled_by_disqualified_persons(o: Person) kind empirical {
    label en official "the organization is not controlled directly or indirectly by one or more disqualified persons (section 4946), other than foundation managers or section 509(a)(1)/(2) organizations (section 509(a)(3)(C))";
}
pub relation section_509a3_relationship_prong_satisfied(o: Person) kind institutional {
    label en official "the organization satisfies at least one of the three section 509(a)(3)(B) relationship prongs";
}
rule Section509a3RelationshipViaOperatedSupervisedControlled(o: Person) defeasible {
    label en official "section 509(a)(3)(B)(i)";
    when section_509a3_operated_supervised_or_controlled_by(o);
    then section_509a3_relationship_prong_satisfied(o);
}
rule Section509a3RelationshipViaSupervisedInConnection(o: Person) defeasible {
    label en official "section 509(a)(3)(B)(ii)";
    when section_509a3_supervised_or_controlled_in_connection_with(o);
    then section_509a3_relationship_prong_satisfied(o);
}
rule Section509a3RelationshipViaOperatedInConnection(o: Person) defeasible {
    label en official "section 509(a)(3)(B)(iii)";
    when section_509a3_operated_in_connection_with(o);
    then section_509a3_relationship_prong_satisfied(o);
}
@source(IRC_S509_A, quote = "an organization which—")
rule PublicCharityVia509a3(o: Person, y: TaxableYear) defeasible {
    label en official "section 509(a)(3): a supporting organization satisfying the organizational-purpose, relationship, and non-control-by-disqualified-persons prongs is not a private foundation";
    when section_509a3_organized_and_operated_for_supported_orgs(o);
    when section_509a3_relationship_prong_satisfied(o);
    when section_509a3_not_controlled_by_disqualified_persons(o);
    when us.irc.core::year_of(o, y);
    then is_public_charity(o, y);
}

// ---------------------------------------------------------------------
// (a)(4): testing for public safety.
// ---------------------------------------------------------------------

@source(IRC_S509_A, quote = "an organization which is organized and operated exclusively for testing for public safety.")
pub relation organized_and_operated_exclusively_for_testing_for_public_safety(o: Person) kind empirical {
    label en official "the organization is organized and operated exclusively for testing for public safety (section 509(a)(4))";
}
rule PublicCharityVia509a4(o: Person, y: TaxableYear) defeasible {
    label en official "section 509(a)(4): an organization organized and operated exclusively for testing for public safety is not a private foundation";
    when organized_and_operated_exclusively_for_testing_for_public_safety(o);
    when us.irc.core::year_of(o, y);
    then is_public_charity(o, y);
}

// ---------------------------------------------------------------------
// The definition itself: private foundation = section 501(c)(3)
// organization other than a public charity under (a)(1)-(4).
// ---------------------------------------------------------------------

pub relation is_public_charity(o: Person, y: TaxableYear) kind institutional {
    label en official "the organization falls within one of the section 509(a)(1)-(4) exceptions to 'private foundation'";
}
@source(IRC_S509_A, quote = "the term \"private foundation\" means a domestic or foreign organization described in section 501(c)(3) other than—")
pub relation private_foundation(o: Person, y: TaxableYear) kind institutional {
    label en official "the organization is a private foundation for the taxable year (section 509(a))";
}
@source(IRC_S509_A, quote = "the term \"private foundation\" means a domestic or foreign organization described in section 501(c)(3) other than—")
rule PrivateFoundationDefinition(o: Person, y: TaxableYear) defeasible {
    label en official "section 509(a): a section 501(c)(3) organization is a private foundation unless it is a public charity under (a)(1)-(4)";
    when section_501c3(o, y);
    unless is_public_charity(o, y);
    then private_foundation(o, y);
}

pub relation public_charity(o: Person, y: TaxableYear) kind institutional {
    label en official "the organization is a public charity (a section 501(c)(3) organization within one of the section 509(a)(1)-(4) exceptions), the pub interface name the task requests";
}
rule PublicCharityHeadBridge(o: Person, y: TaxableYear) defeasible {
    label en official "bridges `is_public_charity` (the internal (a)(1)-(4) disjunction head) to the `public_charity` pub interface name";
    when section_501c3(o, y);
    when is_public_charity(o, y);
    then public_charity(o, y);
}
