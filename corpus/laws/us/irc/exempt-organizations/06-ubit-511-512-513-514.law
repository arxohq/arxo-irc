// Sections 511 (imposition), 512 (unrelated business taxable income), 513
// (unrelated trade or business) and 514 (debt-financed income) — the
// "part II: tax on unrelated business income" priority block.
//
// SCOPE:
// - 513(a) in full (definition + the three (a)(1)-(3) exceptions) and
//   513(c) (the "trade or business"/fragmentation rule). 513(b), (d)-(j)
//   NOT modelled (trust special rule, entertainment/trade-show/bingo/pole-
//   rental/low-cost-article/mailing-list exceptions) — TECH-GAPS row G73.
// - 512(a)(1) (the core definition) and 512(a)(6) (siloing, "no netting
//   across silos") in full, subject to the aggregate limitation noted
//   below. 512(b): modifications (1) dividends/interest, (2) royalties,
//   (3) rents (including the (B) personal-property/contingent-rent
//   override), (4) the debt-financed bridge to section 514, (7) research
//   income, and (12) the $1,000 specific deduction are modelled; (5), (6),
//   (8)-(11), (13)-(19) are NOT modelled this stage — TECH-GAPS row G74.
// - 514(a)-(c) core: the acquisition-indebtedness/adjusted-basis ratio
//   computed exactly (Decimal, no float), (b)(1) debt-financed property
//   definition with the (A) substantially-related exclusion, (c)(1)
//   acquisition indebtedness. The (b)(3) neighborhood land rule, the
//   (c)(2)-(9) special indebtedness/exception rules (bequest/devise,
//   church 15-year rule, real property of qualified organizations, etc.)
//   are NOT modelled — TECH-GAPS row G75.
// - 511(a)-(b): imposition classification (which organizations/trusts are
//   within the tax) IS modelled; the FINAL tax amount computation is an
//   EXTERNAL_DEPENDENCY / unresolved normative dependency — see the note
//   at `unrelated_business_income_tax` below. This is the one priority
//   item this package cannot close within its own write scope.

// ---------------------------------------------------------------------
// Section 513(a), (c): unrelated trade or business.
// ---------------------------------------------------------------------

use self::{
    Corporation,
    IRC_S511_A,
    IRC_S511_B,
    IRC_S512_A,
    IRC_S512_B,
    IRC_S513_A,
    IRC_S513_C,
    IRC_S514_A,
    IRC_S514_B,
    IRC_S514_C,
    Person,
    TaxableYear,
    exempt_organization,
};

pub entity TradeOrBusiness {
    label en unofficial "an activity of an organization carried on for the production of income from the sale of goods or the performance of services (section 513(c))";
}
@source(IRC_S513_C, quote = "the term \"trade or business\" includes any activity which is carried on for the production of income from the sale of goods or the performance of services")
pub relation activity_is_trade_or_business(tb: TradeOrBusiness, o: Person) kind empirical {
    label en official "the activity is a trade or business of the organization (section 513(c)): carried on for the production of income from the sale of goods or the performance of services";
}
@source(IRC_S513_C, quote = "an activity does not lose identity as a trade or business merely because it is carried on within a larger aggregate of similar activities or within a larger complex of other endeavors which may, or may not, be related to the exempt purposes of the organization")
pub relation carried_on_within_larger_complex(tb: TradeOrBusiness, o: Person) kind empirical {
    label en unofficial "the activity is carried on within a larger aggregate or complex of other endeavors — asserted so the fragmentation rule can be exercised without changing the trade-or-business classification";
}
@source(IRC_S513_A, quote = "any trade or business the conduct of which is not substantially related (aside from the need of such organization for income or funds or the use it makes of the profits derived) to the exercise or performance by such organization of its charitable, educational, or other purpose or function constituting the basis for its exemption under section 501")
pub external judgment relation SubstantiallyRelatedToExemptPurpose(tb: TradeOrBusiness, o: Person, y: TaxableYear) {
    authority Secretary;
    label en official "the conduct of the trade or business is substantially related, aside from the organization's need for income or funds, to the exercise of its exempt purpose (section 513(a)) — DECISION-0194 evaluative channel";
}
@source(IRC_S513_A, quote = "in which substantially all the work in carrying on such trade or business is performed for the organization without compensation")
pub relation substantially_all_work_uncompensated_513a1(tb: TradeOrBusiness, o: Person, y: TaxableYear) kind empirical {
    label en official "substantially all the work in carrying on the trade or business is performed for the organization without compensation (section 513(a)(1))";
}
@source(IRC_S513_A, quote = "which is carried on, in the case of an organization described in section 501(c)(3) or in the case of a college or university described in section 511(a)(2)(B), by the organization primarily for the convenience of its members, students, patients, officers, or employees")
pub relation primarily_for_convenience_513a2(tb: TradeOrBusiness, o: Person, y: TaxableYear) kind empirical {
    label en official "the trade or business is carried on primarily for the convenience of the organization's members, students, patients, officers, or employees (section 513(a)(2))";
}
@source(IRC_S513_A, quote = "which is the selling of merchandise, substantially all of which has been received by the organization as gifts or contributions")
pub relation substantially_all_merchandise_donated_513a3(tb: TradeOrBusiness, o: Person, y: TaxableYear) kind empirical {
    label en official "the trade or business is the selling of merchandise substantially all of which the organization received as gifts or contributions (section 513(a)(3))";
}
@source(IRC_S513_A, quote = "The term \"unrelated trade or business\" means, in the case of any organization subject to the tax imposed by section 511, any trade or business the conduct of which is not substantially related (aside from the need of such organization for income or funds or the use it makes of the profits derived) to the exercise or performance by such organization of its charitable, educational, or other purpose or function constituting the basis for its exemption under section 501 (or, in the case of an organization described in section 511(a)(2)(B), to the exercise or performance of any purpose or function described in section 501(c)(3)), except that such term does not include any trade or business—")
pub relation unrelated_trade_or_business(tb: TradeOrBusiness, o: Person, y: TaxableYear) kind institutional {
    label en official "an unrelated trade or business of the organization for the taxable year (section 513(a))";
}
@source(IRC_S513_A, quote = "The term \"unrelated trade or business\" means, in the case of any organization subject to the tax imposed by section 511, any trade or business the conduct of which is not substantially related (aside from the need of such organization for income or funds or the use it makes of the profits derived) to the exercise or performance by such organization of its charitable, educational, or other purpose or function constituting the basis for its exemption under section 501 (or, in the case of an organization described in section 511(a)(2)(B), to the exercise or performance of any purpose or function described in section 501(c)(3)), except that such term does not include any trade or business—")
rule UnrelatedTradeOrBusinessClassification(tb: TradeOrBusiness, o: Person, y: TaxableYear) defeasible {
    label en official "section 513(a): a trade or business not substantially related to the organization's exempt purpose is an unrelated trade or business, unless it falls within one of the three (a)(1)-(3) exceptions";
    when activity_is_trade_or_business(tb, o);
    when us.irc.core::year_of(o, y);
    unless SubstantiallyRelatedToExemptPurpose(tb, o, y);
    unless substantially_all_work_uncompensated_513a1(tb, o, y);
    unless primarily_for_convenience_513a2(tb, o, y);
    unless substantially_all_merchandise_donated_513a3(tb, o, y);
    then unrelated_trade_or_business(tb, o, y);
}
// pub interface name requested by the task.
pub relation ubit(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "alias of `unrelated_business_income_tax`, the pub interface name the task requests for the section 511 tax amount";
}

// ---------------------------------------------------------------------
// Section 512(a)(1), (a)(6): unrelated business taxable income, with
// siloing.
// ---------------------------------------------------------------------

@source(IRC_S512_A, quote = "the gross income derived by any organization from any unrelated trade or business (as defined in section 513) regularly carried on by it")
pub relation gross_income_from_business(tb: TradeOrBusiness, o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the gross income derived from the trade or business, regularly carried on, for the taxable year, computed with the section 512(b) modifications already reflected (dividends/interest/royalties/excluded rents and other passive categories not modelled this stage are not case-asserted here) — see the section 512(b) rules below for the modifications this package DOES apply on top of this base figure";
}
@source(IRC_S512_A, quote = "regularly carried on by it, less the deductions allowed by this chapter which are directly connected with the carrying on of such trade or business, both computed with the modifications provided in subsection (b)")
pub relation directly_connected_deductions(tb: TradeOrBusiness, o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the deductions directly connected with the carrying on of the trade or business, for the taxable year (section 512(a)(1))";
}
@source(IRC_S512_B, quote = "Except for purposes of computing the net operating loss under section 172 and paragraph (6), there shall be allowed a specific deduction of $1,000.")
pub const SpecificDeduction1000: Money = 1000.00 USD {
    label en official "section 512(b)(12): the specific deduction of $1,000 — the exact statutory figure, not an indexed one";
}

@source(IRC_S512_A, quote = "Except as otherwise provided in this subsection, the term \"unrelated business taxable income\" means the gross income derived by any organization from any unrelated trade or business (as defined in section 513) regularly carried on by it, less the deductions allowed by this chapter which are directly connected with the carrying on of such trade or business, both computed with the modifications provided in subsection (b).")
pub relation unrelated_business_taxable_income_per_business(tb: TradeOrBusiness, o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "unrelated business taxable income computed separately with respect to a single trade or business, before the specific deduction (section 512(a)(1), read with section 512(a)(6)(A): 'without regard to subsection (b)(12)')";
}
@source(IRC_S512_A, quote = "unrelated business taxable income, including for purposes of determining any net operating loss deduction, shall be computed separately with respect to each such trade or business and without regard to subsection (b)(12),")
rule UnrelatedBusinessTaxableIncomePerBusiness(tb: TradeOrBusiness, o: Person, y: TaxableYear, gross: Money, deductions: Money, debt_financed_income: Money, debt_financed_deduction: Money) defeasible {
    label en official "section 512(a)(1)/(a)(6)(A): UBTI per trade or business, before the specific deduction, including the section 514/512(b)(4) debt-financed adjustment";
    when unrelated_trade_or_business(tb, o, y);
    when gross_income_from_business(tb, o, y, gross);
    when directly_connected_deductions(tb, o, y, deductions);
    when debt_financed_gross_income_included_512b4(tb, o, y, debt_financed_income);
    when debt_financed_deduction_allowed_512b4(tb, o, y, debt_financed_deduction);
    then unrelated_business_taxable_income_per_business(tb, o, y, (gross + debt_financed_income) - (deductions + debt_financed_deduction));
}
// bridge for organizations/businesses with no debt-financed property this
// taxable year (both amounts zero) so the rule above does not force a
// case to assert section 514 facts it does not have.
rule NoDebtFinancedIncomeDefault(tb: TradeOrBusiness, o: Person, y: TaxableYear) defeasible {
    label en official "default: no debt-financed property, so the section 512(b)(4)/514 adjustment is zero";
    when unrelated_trade_or_business(tb, o, y);
    unless debt_financed_property_held(tb, o, y);
    then debt_financed_gross_income_included_512b4(tb, o, y, 0.00 USD);
}
rule NoDebtFinancedDeductionDefault(tb: TradeOrBusiness, o: Person, y: TaxableYear) defeasible {
    label en official "default: no debt-financed property, so the section 512(b)(4)/514 deduction adjustment is zero";
    when unrelated_trade_or_business(tb, o, y);
    unless debt_financed_property_held(tb, o, y);
    then debt_financed_deduction_allowed_512b4(tb, o, y, 0.00 USD);
}

@source(IRC_S512_A, quote = "for purposes of subparagraph (B), unrelated business taxable income with respect to any such trade or business shall not be less than zero.")
pub relation unrelated_business_taxable_income_per_business_floor(tb: TradeOrBusiness, o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 512(a)(6)(C): UBTI per trade or business, floored at zero (no loss silo)";
}
rule UbtiPerBusinessFloor(tb: TradeOrBusiness, o: Person, y: TaxableYear, raw: Money) defeasible {
    label en official "section 512(a)(6)(C): per-business UBTI is not less than zero";
    when unrelated_business_taxable_income_per_business(tb, o, y, raw);
    then unrelated_business_taxable_income_per_business_floor(tb, o, y, max(0.00 USD, raw));
}

// Siloing total: `unrelated_business_taxable_income` is the SUM of the
// floored per-business amounts, less the section 512(b)(12) specific
// deduction (section 512(a)(6)(B)). A general aggregate over the derived
// `unrelated_business_taxable_income_per_business_floor` relation across
// an unbounded number of trades or businesses is a runtime subset
// limitation (core-surfaces.md: "aggregates over derived predicates" —
// §111); this package therefore provides the TWO-business total explicitly
// (the scenario the task itself asks for: "UBTI with two businesses (no
// netting across silos)") and flags the general N-business sum as
// TECH-GAPS row G76 rather than hiding the limitation behind an
// unimplemented `sum all` that would silently return nothing for a third
// business.
@source(IRC_S512_A, quote = "the unrelated business taxable income of such organization shall be the sum of the unrelated business taxable income so computed with respect to each such trade or business, less a specific deduction under subsection (b)(12), and")
pub relation unrelated_business_taxable_income(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the organization's unrelated business taxable income for the taxable year: the sum of the floored per-business amounts, less the section 512(b)(12) specific deduction (section 512(a)(1), (a)(6)(B))";
}
@source(IRC_S512_A, quote = "the unrelated business taxable income of such organization shall be the sum of the unrelated business taxable income so computed with respect to each such trade or business, less a specific deduction under subsection (b)(12), and")
pub relation has_second_unrelated_business_at_income(o: Person, y: TaxableYear, tb1: TradeOrBusiness, income1: Money) kind institutional {
    label en unofficial "`unless` requires its exception atom to bind every head variable including `income1` — bridges `has_second_unrelated_business` onto the specific per-business amount being tested";
}
rule HasSecondUnrelatedBusinessAtIncome(o: Person, y: TaxableYear, tb1: TradeOrBusiness, income1: Money) defeasible {
    when has_second_unrelated_business(o, y, tb1);
    when unrelated_business_taxable_income_per_business_floor(tb1, o, y, income1);
    then has_second_unrelated_business_at_income(o, y, tb1, income1);
}
rule UbtiSingleBusiness(o: Person, y: TaxableYear, tb1: TradeOrBusiness, income1: Money) defeasible {
    label en official "section 512(a)(1): an organization with exactly one unrelated trade or business — UBTI is that business's floored amount less the section 512(b)(12) specific deduction";
    when unrelated_business_taxable_income_per_business_floor(tb1, o, y, income1);
    unless has_second_unrelated_business_at_income(o, y, tb1, income1);
    then unrelated_business_taxable_income(o, y, max(0.00 USD, income1 - SpecificDeduction1000));
}
@source(IRC_S512_A, quote = "In the case of any organization with more than 1 unrelated trade or business—")
rule UbtiTwoBusinessesNoNetting(o: Person, y: TaxableYear, tb1: TradeOrBusiness, tb2: TradeOrBusiness, income1: Money, income2: Money) defeasible {
    label en official "section 512(a)(6): two unrelated trades or businesses — the total is the sum of the two separately-floored amounts (no netting a loss silo against a profit silo), less the section 512(b)(12) specific deduction";
    when unrelated_business_taxable_income_per_business_floor(tb1, o, y, income1);
    when unrelated_business_taxable_income_per_business_floor(tb2, o, y, income2);
    when tb1 != tb2;
    then unrelated_business_taxable_income(o, y, max(0.00 USD, (income1 + income2) - SpecificDeduction1000));
}
pub relation has_second_unrelated_business(o: Person, y: TaxableYear, tb1: TradeOrBusiness) kind institutional {
    label en unofficial "bridge: the organization has a second unrelated trade or business distinct from tb1, for the taxable year — used only to keep UbtiSingleBusiness from double-counting a two-business organization";
}
rule HasSecondUnrelatedBusiness(o: Person, y: TaxableYear, tb1: TradeOrBusiness, tb2: TradeOrBusiness) defeasible {
    when unrelated_trade_or_business(tb1, o, y);
    when unrelated_trade_or_business(tb2, o, y);
    when tb1 != tb2;
    then has_second_unrelated_business(o, y, tb1);
}

// ---------------------------------------------------------------------
// Section 512(b): modifications (1), (2), (3), (7) — excluded income
// categories, asserted directly as the amounts a case says are dividends/
// interest/royalties/qualifying rent/research income, distinct from
// `gross_income_from_business` (which is unrelated-business gross income
// net of these categories by construction). These relations exist so a
// scenario can show the EXCLUSION operating, not to feed back into the
// per-business UBTI amount above (that would double back into
// `gross_income_from_business`, which this stage keeps as a single
// case-asserted net figure — see the module header's scope note).
// ---------------------------------------------------------------------

@source(IRC_S512_B, quote = "There shall be excluded all dividends, interest, payments with respect to securities loans (as defined in subsection (a)(5)), amounts received or accrued as consideration for entering into agreements to make loans, and annuities, and all deductions directly connected with such income.")
pub relation dividends_interest_excluded_512b1(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "dividends, interest, securities-loan payments, loan-agreement consideration, and annuities excluded from unrelated business taxable income (section 512(b)(1))";
}
@source(IRC_S512_B, quote = "There shall be excluded all royalties (including overriding royalties) whether measured by production or by gross or taxable income from the property, and all deductions directly connected with such income.")
pub relation royalties_excluded_512b2(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "royalties (including overriding royalties) excluded from unrelated business taxable income (section 512(b)(2))";
}
@source(IRC_S512_B, quote = "there shall be excluded—")
pub relation rents_from_real_property(o: Person, tb: TradeOrBusiness, y: TaxableYear, amount: Money) kind empirical {
    label en official "rents from real property received under the lease (section 512(b)(3)(A)(i))";
}
@source(IRC_S512_B, quote = "if more than 50 percent of the total rent received or accrued under the lease is attributable to personal property described in subparagraph (A)(ii), or")
pub relation personal_property_rent_over_50_percent(o: Person, tb: TradeOrBusiness, y: TaxableYear) kind empirical {
    label en official "more than 50 percent of the total rent under the lease is attributable to personal property (section 512(b)(3)(B)(i)) — this alone removes the rent from the section 512(b)(3)(A) exclusion";
}
@source(IRC_S512_B, quote = "if the determination of the amount of such rent depends in whole or in part on the income or profits derived by any person from the property leased (other than an amount based on a fixed percentage or percentages of receipts or sales)")
pub relation rent_contingent_on_income_or_profits(o: Person, tb: TradeOrBusiness, y: TaxableYear) kind empirical {
    label en official "the rent depends in whole or in part on the lessee's income or profits from the leased property, other than a fixed percentage of receipts or sales (section 512(b)(3)(B)(ii)) — this alone removes the rent from the section 512(b)(3)(A) exclusion";
}
pub relation rent_excluded_512b3(o: Person, tb: TradeOrBusiness, y: TaxableYear, amount: Money) kind institutional {
    label en official "rent from real property excluded from unrelated business taxable income under section 512(b)(3)(A), because neither (B)(i) nor (B)(ii) applies";
}
@source(IRC_S512_B, quote = "Except as provided in subparagraph (B), there shall be excluded—")
pub relation rent_override_at_amount(o: Person, tb: TradeOrBusiness, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "`unless` requires its exception atom to bind every head variable including `amount` — bridges the two section 512(b)(3)(B) overrides onto the specific rent amount being tested";
}
rule RentOverrideAtAmountViaPersonalProperty(o: Person, tb: TradeOrBusiness, y: TaxableYear, amount: Money) defeasible {
    when personal_property_rent_over_50_percent(o, tb, y);
    when rents_from_real_property(o, tb, y, amount);
    then rent_override_at_amount(o, tb, y, amount);
}
rule RentOverrideAtAmountViaContingentRent(o: Person, tb: TradeOrBusiness, y: TaxableYear, amount: Money) defeasible {
    when rent_contingent_on_income_or_profits(o, tb, y);
    when rents_from_real_property(o, tb, y, amount);
    then rent_override_at_amount(o, tb, y, amount);
}
rule RentExcluded512b3(o: Person, tb: TradeOrBusiness, y: TaxableYear, amount: Money) defeasible {
    label en official "section 512(b)(3)(A): rent from real property is excluded unless the (B) personal-property or contingent-rent override applies";
    when rents_from_real_property(o, tb, y, amount);
    unless rent_override_at_amount(o, tb, y, amount);
    then rent_excluded_512b3(o, tb, y, amount);
}

@source(IRC_S512_B, quote = "There shall be excluded all income derived from research for (A) the United States, or any of its agencies or instrumentalities, or (B) any State or political subdivision thereof; and there shall be excluded all deductions directly connected with such income.")
pub relation government_research_income_excluded_512b7(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "income from research performed for the United States (or an agency/instrumentality) or for a State or political subdivision, excluded from unrelated business taxable income (section 512(b)(7))";
}

// The section 512(b)(4)/514 bridge feeding `UnrelatedBusinessTaxableIncomePerBusiness` above.
pub relation debt_financed_property_held(tb: TradeOrBusiness, o: Person, y: TaxableYear) kind empirical {
    label en official "the trade or business's income is derived from debt-financed property (section 514) held during the taxable year";
}
@source(IRC_S512_B, quote = "Notwithstanding paragraph (1), (2), (3), or (5), in the case of debt-financed property (as defined in section 514) there shall be included, as an item of gross income derived from an unrelated trade or business, the amount ascertained under section 514(a)(1), and there shall be allowed, as a deduction, the amount ascertained under section 514(a)(2).")
pub relation debt_financed_gross_income_included_512b4(tb: TradeOrBusiness, o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 512(b)(4): the section 514(a)(1) debt-financed-income amount, included as an item of unrelated-business gross income";
}
@source(IRC_S512_B, quote = "Notwithstanding paragraph (1), (2), (3), or (5), in the case of debt-financed property (as defined in section 514) there shall be included, as an item of gross income derived from an unrelated trade or business, the amount ascertained under section 514(a)(1), and there shall be allowed, as a deduction, the amount ascertained under section 514(a)(2).")
pub relation debt_financed_deduction_allowed_512b4(tb: TradeOrBusiness, o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 512(b)(4): the section 514(a)(2) debt-financed deduction amount";
}
rule DebtFinancedGrossIncomeIncluded(tb: TradeOrBusiness, o: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "bridges the section 514(a)(1) computation (below) into the section 512(b)(4) inclusion";
    when debt_financed_property_held(tb, o, y);
    when debt_financed_income_514a1(tb, o, y, amount);
    then debt_financed_gross_income_included_512b4(tb, o, y, amount);
}
rule DebtFinancedDeductionAllowed(tb: TradeOrBusiness, o: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "bridges the section 514(a)(2) computation (below) into the section 512(b)(4) deduction";
    when debt_financed_property_held(tb, o, y);
    when debt_financed_deduction_514a2(tb, o, y, amount);
    then debt_financed_deduction_allowed_512b4(tb, o, y, amount);
}

// ---------------------------------------------------------------------
// Section 514(a)-(c): debt-financed income.
// ---------------------------------------------------------------------

@source(IRC_S514_C, quote = "the term \"acquisition indebtedness\" means, with respect to any debt-financed property, the unpaid amount of—")
pub relation acquisition_indebtedness_average(tb: TradeOrBusiness, o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the average acquisition indebtedness (section 514(c)(7)) for the taxable year with respect to the debt-financed property";
}
@source(IRC_S514_A, quote = "the average amount (determined under regulations prescribed by the Secretary) of the adjusted basis of such property during the period it is held by the organization during such taxable year")
pub relation adjusted_basis_average(tb: TradeOrBusiness, o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the average adjusted basis of the debt-financed property during the period held in the taxable year";
}
@source(IRC_S514_A, quote = "the total gross income derived during the taxable year from or on account of such property")
pub relation total_gross_income_from_property(tb: TradeOrBusiness, o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the total gross income derived during the taxable year from or on account of the debt-financed property";
}
@source(IRC_S514_A, quote = "the sum of the deductions under this chapter which are directly connected with the debt-financed property or the income therefrom")
pub relation total_deductions_from_property(tb: TradeOrBusiness, o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 514(a)(3): the sum of the deductions directly connected with the debt-financed property or its income (straight-line depreciation only, if depreciable)";
}
@source(IRC_S514_A, quote = "There shall be included with respect to each debt-financed property as an item of gross income derived from an unrelated trade or business an amount which is the same percentage (but not in excess of 100 percent) of the total gross income derived during the taxable year from or on account of such property as (A) the average acquisition indebtedness (as defined in subsection (c)(7)) for the taxable year with respect to the property is of (B) the average amount (determined under regulations prescribed by the Secretary) of the adjusted basis of such property during the period it is held by the organization during such taxable year.")
pub relation debt_financed_income_514a1(tb: TradeOrBusiness, o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 514(a)(1): (acquisition indebtedness / adjusted basis) x total gross income from the property, capped at 100 percent of that ratio";
}
@source(IRC_S514_A, quote = "There shall be included with respect to each debt-financed property as an item of gross income derived from an unrelated trade or business an amount which is the same percentage (but not in excess of 100 percent) of the total gross income derived during the taxable year from or on account of such property as (A) the average acquisition indebtedness (as defined in subsection (c)(7)) for the taxable year with respect to the property is of (B) the average amount (determined under regulations prescribed by the Secretary) of the adjusted basis of such property during the period it is held by the organization during such taxable year.")
rule DebtFinancedIncome514a1(tb: TradeOrBusiness, o: Person, y: TaxableYear, indebtedness: Money, basis: Money, gross: Money) strict {
    label en official "section 514(a)(1): the debt-financed portion of gross income, capped at 100 percent of the acquisition-indebtedness-to-adjusted-basis ratio — exact Decimal ratio, never a rounded percentage";
    when acquisition_indebtedness_average(tb, o, y, indebtedness);
    when adjusted_basis_average(tb, o, y, basis);
    when total_gross_income_from_property(tb, o, y, gross);
    when indebtedness <= basis;
    then debt_financed_income_514a1(tb, o, y, round(gross * (indebtedness / basis), 2, "HALF_UP"));
}
@source(IRC_S514_A, quote = "There shall be allowed as a deduction with respect to each debt-financed property an amount determined by applying (except as provided in the last sentence of this paragraph) the percentage derived under paragraph (1) to the sum determined under paragraph (3).")
pub relation debt_financed_deduction_514a2(tb: TradeOrBusiness, o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 514(a)(2): the same acquisition-indebtedness-to-adjusted-basis percentage, applied to the section 514(a)(3) directly-connected deductions";
}
rule DebtFinancedDeduction514a2(tb: TradeOrBusiness, o: Person, y: TaxableYear, indebtedness: Money, basis: Money, deductions: Money) strict {
    label en official "section 514(a)(2)-(3): the debt-financed portion of the directly connected deductions, using the same ratio as section 514(a)(1)";
    when acquisition_indebtedness_average(tb, o, y, indebtedness);
    when adjusted_basis_average(tb, o, y, basis);
    when total_deductions_from_property(tb, o, y, deductions);
    when indebtedness <= basis;
    then debt_financed_deduction_514a2(tb, o, y, round(deductions * (indebtedness / basis), 2, "HALF_UP"));
}

// (b)(1): debt-financed property definition, with the (A) substantially-
// related exclusion (the (B)-(E) exclusions and the (b)(3) neighborhood
// land rule are NOT modelled — TECH-GAPS row G75).
@source(IRC_S514_B, quote = "any property which is held to produce income and with respect to which there is an acquisition indebtedness (as defined in subsection (c)) at any time during the taxable year")
pub relation held_to_produce_income_with_acquisition_indebtedness(tb: TradeOrBusiness, o: Person, y: TaxableYear) kind empirical {
    label en official "the property is held to produce income and there is an acquisition indebtedness with respect to it at some time during the taxable year (section 514(b)(1))";
}
@source(IRC_S514_B, quote = "any property substantially all the use of which is substantially related (aside from the need of the organization for income or funds) to the exercise or performance by such organization of its charitable, educational, or other purpose or function constituting the basis for its exemption under section 501")
pub external judgment relation SubstantiallyAllUseSubstantiallyRelated514b1A(tb: TradeOrBusiness, o: Person, y: TaxableYear) {
    authority Secretary;
    label en official "substantially all the use of the property is substantially related to the organization's exempt purpose (section 514(b)(1)(A)) — DECISION-0194 evaluative channel";
}
@source(IRC_S514_B, quote = "except that such term does not include—")
rule DebtFinancedPropertyHeld(tb: TradeOrBusiness, o: Person, y: TaxableYear) defeasible {
    label en official "section 514(b)(1): the property is debt-financed property unless substantially all its use is substantially related to the organization's exempt purpose";
    when held_to_produce_income_with_acquisition_indebtedness(tb, o, y);
    unless SubstantiallyAllUseSubstantiallyRelated514b1A(tb, o, y);
    then debt_financed_property_held(tb, o, y);
}

// ---------------------------------------------------------------------
// Section 511(a)-(b): imposition of the tax. The applicability
// classification is modelled in full; the FINAL tax amount is an
// unresolved normative dependency (see the block comment below).
// ---------------------------------------------------------------------

@source(IRC_S511_A, quote = "The tax imposed by paragraph (1) shall apply in the case of any organization (other than a trust described in subsection (b) or an organization described in section 501(c)(1)) which is exempt, except as provided in this part or part II (relating to private foundations), from taxation under this subtitle by reason of section 501(a).")
pub relation section_511a_covered_organization(o: Person, y: TaxableYear) kind institutional {
    label en official "an organization within section 511(a)(2)(A): exempt under section 501(a), other than a section 511(b) trust or a section 501(c)(1) instrumentality";
}
@source(IRC_S511_A, quote = "The tax imposed by paragraph (1) shall apply in the case of any organization (other than a trust described in subsection (b) or an organization described in section 501(c)(1)) which is exempt, except as provided in this part or part II (relating to private foundations), from taxation under this subtitle by reason of section 501(a).")
rule Section511aCoveredOrganization(o: Person, y: TaxableYear) defeasible {
    label en official "section 511(a)(2)(A): an organization exempt under section 501(a), other than a section 511(b) trust or a section 501(c)(1) organization, is within the section 511(a) tax";
    when exempt_organization(o, y);
    unless section_511b_trust(o, y);
    unless described_in_501c1(o, y);
    then section_511a_covered_organization(o, y);
}
pub relation described_in_501c1(o: Person, y: TaxableYear) kind empirical {
    label en unofficial "the organization is described in section 501(c)(1) (federal instrumentality) — section 501(c)(1) is not otherwise modelled this stage";
}
@source(IRC_S511_B, quote = "The tax imposed by paragraph (1) shall apply in the case of any trust which is exempt, except as provided in this part or part II (relating to private foundations), from taxation under this subtitle by reason of section 501(a) and which, if it were not for such exemption, would be subject to subchapter J (sec. 641 and following, relating to estates, trusts, beneficiaries, and decedents).")
pub relation section_511b_trust(o: Person, y: TaxableYear) kind empirical {
    label en official "a trust exempt under section 501(a) that, absent the exemption, would be subject to subchapter J (section 511(b)(2))";
}

// section 511(a)(1) computes the tax "as provided in section 11", reading
// "taxable income" in section 11 as "unrelated business taxable income";
// section 511(b)(1) does the same with section 1(e). `unrelated_business_
// income_tax`/`ubit` (below) record the UBTI BASE, not the dollar tax
// amount — kept as-is for backward compatibility with existing scenarios.
pub relation unrelated_business_income_tax(o: Person, y: TaxableYear, ubti: Money) kind institutional {
    label en official "section 511(a)(1)/(b)(1): the organization or trust is liable for a tax computed as provided in section 11 (or section 1(e) for a trust) on this unrelated business taxable income — this relation records the UBTI base the tax is computed on; see `ubit_amount` for the actual dollar tax";
}
@source(IRC_S511_A, quote = "There is hereby imposed for each taxable year on the unrelated business taxable income (as defined in section 512) of every organization described in paragraph (2) a tax computed as provided in section 11.")
rule Section511aTaxBase(o: Person, y: TaxableYear, ubti: Money) defeasible {
    label en official "section 511(a)(1): a tax computed as provided in section 11 is imposed on the unrelated business taxable income of a section 511(a)(2) organization";
    when section_511a_covered_organization(o, y);
    when unrelated_business_taxable_income(o, y, ubti);
    then unrelated_business_income_tax(o, y, ubti);
}
@source(IRC_S511_B, quote = "There is hereby imposed for each taxable year on the unrelated business taxable income of every trust described in paragraph (2) a tax computed as provided in section 1(e).")
rule Section511bTaxBase(o: Person, y: TaxableYear, ubti: Money) defeasible {
    label en official "section 511(b)(1): a tax computed as provided in section 1(e) is imposed on the unrelated business taxable income of a section 511(b)(2) trust";
    when section_511b_trust(o, y);
    when unrelated_business_taxable_income(o, y, ubti);
    then unrelated_business_income_tax(o, y, ubti);
}
rule UbitAlias(o: Person, y: TaxableYear, ubti: Money) defeasible {
    label en unofficial "bridges `unrelated_business_income_tax` to the `ubit` pub interface name the task requests";
    when unrelated_business_income_tax(o, y, ubti);
    then ubit(o, y, ubti);
}

// STAGE 2 (WIRE-2, 25.09.2026): the rate multiplication itself, closing
// half of the priority gap. `us.irc.corporations` now exports
// `pub corporate_tax_rate(c: Corporation, y: TaxableYear, rate: Decimal)`
// (its own stage 2), confirmed by the SAME wiring pattern already used by
// `us.irc.special-entities::life_insurance_company_tax` (section 801(a)):
// its export rule is keyed to `us.irc.corporations::taxable_income(c, y,
// _)` being KNOWN for the same (corporation, year) pair (gating on the
// fact's presence, not its value, since the rate is one flat constant) —
// a scenario for a section 511(a) organization taxed at the corporate
// rate must therefore also assert that fact (a $0 or nominal section 11
// "taxable income" placeholder is the accepted judgment call the
// life-insurance precedent already established, not an invention of this
// package's own).
//
// Section 511(b) (a trust taxed "as provided in section 1(e)") remains
// UNRESOLVED: `us.irc.trusts_estates` exports `section_641a_tax` (the
// dollar tax on the TRUST'S OWN section 1(e) taxable income, read via its
// own `taxable_income(et, y, ·)` fact) and `section_1e_tax_applies`, but
// no relation applies the section 1(e) SCHEDULE to an ARBITRARY base
// amount the way `corporate_tax_rate` applies a flat rate to any base —
// the section 1(e) brackets are graduated, not a bare constant, and the
// bracket-table relations in `us.irc.income_individual/rates.law`
// (`bracket_1986_estate_trust`, `bracket_tcja_estate_trust`) are plain
// `relation`s, not `pub`. Substituting UBTI for the trust's own
// `taxable_income(et, y, ·)` to reuse `tax_under_section_1` would
// overwrite/conflict with that trust's REAL section 1(e) taxable-income
// fact for the same (et, y) key. This is a genuine architecture gap, not
// a missing `pub`: recorded as `external_norm_unresolved` in
// `exempt-organizations.deps.json` (target `us.irc.trusts_estates`,
// symbol "a section 1(e) schedule callable on an arbitrary Money base",
// status `pending`).
pub relation ubit_amount(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the actual dollar tax under section 511(a)(1)/(b)(1): the unrelated business taxable income multiplied by the section 11(b) (corporate) or section 1(e) (trust) rate — task's requested `pub` name";
}
@source(IRC_S511_A, quote = "There is hereby imposed for each taxable year on the unrelated business taxable income (as defined in section 512) of every organization described in paragraph (2) a tax computed as provided in section 11.")
rule Section511aTaxAmountForCorporation(o: Corporation, y: TaxableYear, ubti: Money, rate: Decimal) defeasible {
    label en official "section 511(a)(1), corporate-rate case: the dollar tax is the unrelated business taxable income times the section 11(b) rate (imported from us.irc.corporations, STAGE 2 WIRE-2)";
    when section_511a_covered_organization(o, y);
    when unrelated_business_taxable_income(o, y, ubti);
    when us.irc.corporations::corporate_tax_rate(o, y, rate);
    then ubit_amount(o, y, round(ubti * rate, 2, "HALF_UP"));
}
// Section 511(b) (trust taxed under section 1(e)): NO producing rule this
// stage — see the block comment above. `ubit_amount` is simply not
// concluded for a section 511(b) trust until `us.irc.trusts_estates`
// exposes a section 1(e) schedule callable on an arbitrary base; this is
// an honest gap (NEITHER on the trust-rate branch), not a silently wrong
// zero or a duplicated rate table.
