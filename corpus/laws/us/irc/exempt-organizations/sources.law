// 26 U.S.C. 1381(a) — Organizations to which part applies
fragment IRC_S1381_A in IRC_2024_EDITION {
    kind subsection;
    locator "section/1381/a";
    text en official """(a) In general
This part shall apply to—
(1) any organization exempt from tax under section 521 (relating to exemption of farmers' cooperatives from tax), and
(2) any corporation operating on a cooperative basis other than an organization—
(A) which is exempt from tax under this chapter,
(B) which is subject to the provisions of—
(i) part II of subchapter H (relating to mutual savings banks, etc.), or
(ii) subchapter L (relating to insurance companies), or
(C) which is engaged in furnishing electric energy, or providing telephone service, to persons in rural areas.""";
    content_hash "sha256:084a6fbc928a0748dbcdc1b218840401e8f7b321d81aaeb699e8a9915eb6e470";
}

// 26 U.S.C. 1381(b) — Organizations to which part applies
fragment IRC_S1381_B in IRC_2024_EDITION {
    kind subsection;
    locator "section/1381/b";
    text en official """(b) Tax on certain farmers' cooperatives
An organization described in subsection (a)(1) shall be subject to the tax imposed by section 11.""";
    content_hash "sha256:d563ed6bba3605bae957a23e377915aab6da85ed15d4fab9668902e9e2dba94e";
}

// 26 U.S.C. 1381(c) — Organizations to which part applies
fragment IRC_S1381_C in IRC_2024_EDITION {
    kind subsection;
    locator "section/1381/c";
    text en official """(c) Cross reference
For treatment of income from load loss transactions of organizations described in subsection (a)(2)(C), see section 501(c)(12)(H).""";
    content_hash "sha256:d33f8324327bd83a6fd6e9dd711588904529fc05d9d5d70bb05f40b31af11f30";
}

// 26 U.S.C. §1381 — statutory note 4 (effectivedate-amendment-note)
