// Sections 507 (termination of private foundation status), 527 (political
// organizations) and Subchapter T §§1382, 1385, 1388 (cooperatives'
// patronage dividend mechanics) — STAGE 2 (IRC-09 stage 2, A11) priority
// items.
//
// SCOPE:
// - 507(a) voluntary/involuntary termination gate, (b)(1) transfer-to-
//   public-charity termination, (c) termination tax as the EXACT lesser
//   of the aggregate tax benefit or net asset value, (g) abatement as a
//   `power`. (d)'s aggregate-tax-benefit computation is modelled at the
//   TOP level only — the substantial-contributor tracing, section 4946
//   disqualified-person cross-reference, and interest-accrual ledger
//   (d)(1)(A)-(C)/(d)(2)-(3) are NOT decomposed (TECH-GAPS G486): a case
//   asserts `aggregate_tax_benefit` as a single Money figure, the same
//   judgment call already made for section 512(b)'s net UBTI figure.
// - 527(a)-(c),(e)-(f) in full: the taxable-income definition with its
//   $100 specific deduction and two modifications, the tax rate wired to
//   `us.irc.corporations::corporate_tax_rate` (the highest section 11(b)
//   rate — a single flat 21 percent since TCJA, so "highest rate" IS that
//   rate, no bracket search needed), the exempt-function/political-
//   organization definitions, and the section 501(c)-organization
//   political-expenditure inclusion rule. (d) recordkeeping, (h)
//   newsletter-fund carve-out, (i)-(l) notice/reporting timing windows
//   are NOT modelled (TECH-GAPS G79 — the (i)/(j) 24-hour/periodic report
//   windows are a contract to `us.irc.information_reporting`, not yet
//   wired).
// - Subchapter T: section 1382(b) patronage-dividend/per-unit-retain
//   exclusion from taxable income (the flagship `patronage_dividend_
//   deduction`), section 1382(d)'s payment period computed with EXACT
//   `add_calendar_period` date arithmetic (first day of the taxable year
//   through the 15th day of the ninth following month — the "8½-month"
//   rule — plus the 90-day qualified-check cash extension), section
//   1388(a)'s three-part patronage-dividend definition, section 1388(c)'s
//   qualified-written-notice-of-allocation definition with the EXACT 20
//   percent cash-or-qualified-check test. Section 1383 (redemption),
//   section 1385 (patron inclusion) and section 1388(c)(2)-(3)'s consent
//   mechanics are NOT modelled (TECH-GAPS G486).

// =======================================================================
// Section 507: termination of private foundation status.
// =======================================================================

use self::{
    Corporation,
    IRC_S1382_B,
    IRC_S1382_D,
    IRC_S1388_A,
    IRC_S1388_C,
    IRC_S507_A,
    IRC_S507_B,
    IRC_S507_C,
    IRC_S507_D,
    IRC_S507_G,
    IRC_S527_A,
    IRC_S527_B,
    IRC_S527_C,
    IRC_S527_E,
    IRC_S527_F,
    Person,
    Secretary,
    TaxableYear,
    exempt_organization,
};

@source(IRC_S507_A, quote = "Except as provided in subsection (b), the status of any organization as a private foundation shall be terminated only if—\n(1) such organization notifies the Secretary (at such time and in such manner as the Secretary may by regulations prescribe) of its intent to accomplish such termination, or")
pub relation section_507a_voluntary_termination_notice_given(o: Person, y: TaxableYear) kind empirical {
    label en official "the private foundation notified the Secretary of its intent to terminate its private foundation status (section 507(a)(1))";
}
@source(IRC_S507_A, quote = "(2)(A) with respect to such organization, there have been either willful repeated acts (or failures to act), or a willful and flagrant act (or failure to act), giving rise to liability for tax under chapter 42, and\n(B) the Secretary notifies such organization that, by reason of subparagraph (A), such organization is liable for the tax imposed by subsection (c),")
pub relation section_507a_willful_repeated_or_flagrant_act_established(o: Person, y: TaxableYear) kind empirical {
    label en official "there have been willful repeated acts (or failures to act), or a willful and flagrant act (or failure to act), giving rise to chapter 42 tax liability with respect to the foundation, and the Secretary has so notified it (section 507(a)(2)(A)-(B))";
}
pub relation section_507c_tax_paid_or_abated(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization has paid the section 507(c) termination tax (or the unabated portion) or the entire tax has been abated under section 507(g)";
}
pub relation private_foundation_status_terminated(o: Person, y: TaxableYear) kind institutional {
    label en official "the organization's status as a private foundation is terminated (section 507(a)) as of this date";
}
rule Section507aVoluntaryTermination(o: Person, y: TaxableYear) defeasible {
    label en official "section 507(a)(1): voluntary termination on notice to the Secretary";
    when section_507a_voluntary_termination_notice_given(o, y);
    then private_foundation_status_terminated(o, y);
}
rule Section507aInvoluntaryTermination(o: Person, y: TaxableYear) defeasible {
    label en official "section 507(a)(2): involuntary termination after a willful repeated/flagrant chapter 42 violation, once the section 507(c) tax is paid or abated";
    when section_507a_willful_repeated_or_flagrant_act_established(o, y);
    when section_507c_tax_paid_or_abated(o, y);
    then private_foundation_status_terminated(o, y);
}

@source(IRC_S507_B, quote = "The status as a private foundation of any organization, with respect to which there have not been either willful repeated acts (or failures to act) or a willful and flagrant act (or failure to act) giving rise to liability for tax under chapter 42, shall be terminated if—\n(A) such organization distributes all of its net assets to one or more organizations described in section 170(b)(1)(A) (other than in clauses (vii) and (viii)) each of which has been in existence and so described for a continuous period of at least 60 calendar months immediately preceding such distribution, or")
pub relation section_507b1A_distributed_all_net_assets_to_qualified_public_charities(o: Person, y: TaxableYear) kind empirical {
    label en official "the foundation distributed all of its net assets to one or more section 170(b)(1)(A) organizations (excluding clauses (vii)-(viii)), each in existence and so described for the preceding 60 calendar months (section 507(b)(1)(A))";
}
rule Section507b1TerminationByTransfer(o: Person, y: TaxableYear) defeasible {
    label en official "section 507(b)(1)(A): termination without chapter 42 liability, by distributing all net assets to qualified public charities";
    when section_507b1A_distributed_all_net_assets_to_qualified_public_charities(o, y);
    unless section_507a_willful_repeated_or_flagrant_act_established(o, y);
    then private_foundation_status_terminated(o, y);
}

@source(IRC_S507_C, quote = "There is hereby imposed on each organization which is referred to in subsection (a) a tax equal to the lower of—\n(1) the amount which the private foundation substantiates by adequate records or other corroborating evidence as the aggregate tax benefit resulting from the section 501(c)(3) status of such foundation, or\n(2) the value of the net assets of such foundation.")
pub relation termination_tax_507(o: Person, amount: Money) kind institutional {
    label en official "section 507(c): the termination tax on an organization referred to in section 507(a) — the LOWER of the substantiated aggregate tax benefit or the value of the foundation's net assets — task's requested pub interface";
}
pub relation net_asset_value_507c(o: Person, amount: Money) kind empirical {
    label en official "the value of the foundation's net assets, for the section 507(c)(2) termination-tax comparison";
}
rule TerminationTax507LowerIsBenefit(o: Person, y: TaxableYear, benefit: Money, assets: Money) defeasible {
    label en official "section 507(c): the aggregate tax benefit is the lower figure, so it is the termination tax";
    when section_507a_voluntary_termination_notice_given(o, y) or section_507a_willful_repeated_or_flagrant_act_established(o, y);
    when aggregate_tax_benefit(o, benefit);
    when net_asset_value_507c(o, assets);
    when benefit <= assets;
    then termination_tax_507(o, benefit);
}
rule TerminationTax507LowerIsAssets(o: Person, y: TaxableYear, benefit: Money, assets: Money) defeasible {
    label en official "section 507(c): the net asset value is the lower figure, so it is the termination tax";
    when section_507a_voluntary_termination_notice_given(o, y) or section_507a_willful_repeated_or_flagrant_act_established(o, y);
    when aggregate_tax_benefit(o, benefit);
    when net_asset_value_507c(o, assets);
    when assets < benefit;
    then termination_tax_507(o, assets);
}

// (d): aggregate tax benefit — TOP LEVEL only (TECH-GAPS G486). The
// substantial-contributor tracing (section 507(d)(2), with its own
// section 4946 disqualified-person cross-reference), the chapters
// 1/11/12 increase-in-tax recomputation, and the interest-accrual ledger
// from each increase's original due date are NOT decomposed: a case
// asserts the final `aggregate_tax_benefit` Money figure directly, the
// same breadth-over-depth judgment call this stage already made for
// section 512(b)'s per-category modifications.
@source(IRC_S507_D, quote = "For purposes of subsection (c), the aggregate tax benefit resulting from the section 501(c)(3) status of any private foundation is the sum of—\n(A) the aggregate increases in tax under chapters 1, 11, and 12 (or the corresponding provisions of prior law) which would have been imposed with respect to all substantial contributors to the foundation if deductions for all contributions made by such contributors to the foundation after February 28, 1913, had been disallowed, and")
pub relation aggregate_tax_benefit(o: Person, amount: Money) kind empirical {
    label en unofficial "section 507(d)(1): the aggregate tax benefit resulting from the foundation's section 501(c)(3) status — TECH-GAP G486, case-asserted as a single figure rather than derived from the (A)-(C) substantial-contributor/interest-accrual computation";
}

@source(IRC_S507_G, quote = "The Secretary may abate the unpaid portion of the assessment of any tax imposed by subsection (c), or any liability in respect thereof, if—\n(1) the private foundation distributes all of its net assets to one or more organizations described in section 170(b)(1)(A) (other than in clauses (vii) and (viii)) each of which has been in existence and so described for a continuous period of at least 60 calendar months, or")
pub relation section_507g_abatement_condition_met(o: Person) kind empirical {
    label en official "either the section 507(g)(1) qualified-public-charity distribution or the section 507(g)(2) State-corrective-action condition is met, for the section 507(c) tax abatement power";
}
rule Section507gAbatementPower(o: Person, y: TaxableYear) strict {
    label en official "section 507(g): the Secretary may abate the unpaid section 507(c) tax if either condition is met";
    when section_507a_voluntary_termination_notice_given(o, y) or section_507a_willful_repeated_or_flagrant_act_established(o, y);
    then power Section507gAbatement {
        holder Secretary;
        exercise section_507c_tax_abated(o);
        valid_when section_507g_abatement_condition_met(o);
        effect section_507c_tax_paid_or_abated(o, y);
    };
}
pub relation section_507c_tax_abated(o: Person) kind empirical {
    label en unofficial "the exercise fact for the section 507(g) abatement power: the Secretary has abated the unpaid section 507(c) tax";
}

// =======================================================================
// Section 527: political organizations.
// =======================================================================

@source(IRC_S527_A, quote = "A political organization shall be subject to taxation under this subtitle only to the extent provided in this section. A political organization shall be considered an organization exempt from income taxes for the purpose of any law which refers to organizations exempt from income taxes.")
pub relation political_organization(o: Person, y: TaxableYear) kind empirical {
    label en official "the organization is a political organization: a party, committee, association, fund, or other organization organized and operated primarily to accept contributions or make expenditures, or both, for an exempt function (section 527(e)(1))";
}
pub relation section_527a_treated_as_income_tax_exempt(o: Person, y: TaxableYear) kind institutional {
    label en official "section 527(a): a political organization is treated as exempt from income taxes for the purpose of any law referring to income-tax-exempt organizations, notwithstanding the section 527(b) tax";
}
rule Section527aTreatedExempt(o: Person, y: TaxableYear) defeasible {
    label en official "section 527(a): a political organization is treated as income-tax-exempt notwithstanding the section 527(b) tax";
    when political_organization(o, y);
    then section_527a_treated_as_income_tax_exempt(o, y);
}

@source(IRC_S527_C, quote = "the political organization taxable income of any organization for any taxable year is an amount equal to the excess (if any) of—\n(A) the gross income for the taxable year (excluding any exempt function income), over\n(B) the deductions allowed by this chapter which are directly connected with the production of the gross income (excluding exempt function income), computed with the modifications provided in paragraph (2).")
pub relation political_organization_taxable_income(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 527(c)(1): the political organization taxable income — gross income excluding exempt function income, less directly connected deductions (excluding exempt function income) and the (c)(2) modifications — task's requested pub interface";
}
pub relation gross_income_excluding_exempt_function_527(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "gross income for the taxable year, excluding exempt function income (section 527(c)(1)(A))";
}
pub relation deductions_directly_connected_excluding_exempt_function_527(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "deductions allowed by chapter 1 directly connected with the production of the gross income, excluding exempt function income, before the (c)(2) modifications (section 527(c)(1)(B))";
}
@source(IRC_S527_C, quote = "(A) there shall be allowed a specific deduction of $100,\n(B) no net operating loss deduction shall be allowed under section 172, and\n(C) no deduction shall be allowed under part VIII of subchapter B (relating to special deductions for corporations).")
pub relation section_527_specific_deduction() kind institutional {
    label en official "section 527(c)(2)(A): the $100 specific deduction allowed in computing political organization taxable income";
}
rule PoliticalOrganizationTaxableIncome(o: Person, y: TaxableYear, gross: Money, deductions: Money) defeasible {
    label en official "section 527(c)(1)-(2): political organization taxable income is gross income (excl. exempt function income) less directly connected deductions and the $100 specific deduction, not below zero";
    when political_organization(o, y);
    when gross_income_excluding_exempt_function_527(o, y, gross);
    when deductions_directly_connected_excluding_exempt_function_527(o, y, deductions);
    then political_organization_taxable_income(o, y, max(0.00 USD, gross - deductions - 100.00 USD));
}

@source(IRC_S527_B, quote = "A tax is hereby imposed for each taxable year on the political organization taxable income of every political organization. Such tax shall be computed by multiplying the political organization taxable income by the highest rate of tax specified in section 11(b).")
pub relation section_527b_tax(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 527(b): the political organization taxable income multiplied by the highest section 11(b) rate — a single flat rate under current law, imported from us.irc.corporations (STAGE 2, same WIRE-2 pattern as section 511(a))";
}
rule Section527bTax(o: Corporation, y: TaxableYear, income: Money, rate: Decimal) defeasible {
    label en official "section 527(b): tax equals political organization taxable income times the highest section 11(b) rate";
    when political_organization_taxable_income(o, y, income);
    when us.irc.corporations::corporate_tax_rate(o, y, rate);
    then section_527b_tax(o, y, round(income * rate, 2, "HALF_UP"));
}

@source(IRC_S527_E, quote = "The term \"exempt function\" means the function of influencing or attempting to influence the selection, nomination, election, or appointment of any individual to any Federal, State, or local public office or office in a political organization, or the election of Presidential or Vice-Presidential electors, whether or not such individual or electors are selected, nominated, elected, or appointed.")
pub relation exempt_function_527e2(activity: Text) kind empirical {
    label en official "the activity is an exempt function under section 527(e)(2): influencing or attempting to influence the selection, nomination, election, or appointment of an individual to a described public/political office, or the election of Presidential/Vice-Presidential electors";
}

@source(IRC_S527_F, quote = "If an organization described in section 501(c) which is exempt from tax under section 501(a) expends any amount during the taxable year directly (or through another organization) for an exempt function (within the meaning of subsection (e)(2)), then, notwithstanding any other provision of law, there shall be included in the gross income of such organization for the taxable year, and shall be subject to tax under subsection (b) as if it constituted political organization taxable income, an amount equal to the lesser of—\n(A) the net investment income of such organization for the taxable year, or\n(B) the aggregate amount so expended during the taxable year for such an exempt function.")
pub relation section_501c_organization_political_expenditure_inclusion(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 527(f)(1): a section 501(c) exempt organization that expends amounts for an exempt function includes the lesser of its net investment income or the aggregate exempt-function expenditure in gross income, taxed under section 527(b)";
}
pub relation net_investment_income_527f(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 527(f)(2): net investment income (interest, dividends, rents, royalties, plus net gains, less directly connected deductions, excluding section 511 UBTI items) for the section 527(f) inclusion";
}
pub relation exempt_function_expenditures_527f(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate amount a section 501(c) organization expended, directly or through another organization, for an exempt function during the taxable year (section 527(f)(1))";
}
rule Section527fInclusionNetInvestmentLower(o: Person, y: TaxableYear, net_inv: Money, expend: Money) defeasible {
    label en official "section 527(f)(1): net investment income is the lower figure, so it is the included amount";
    when exempt_organization(o, y);
    when net_investment_income_527f(o, y, net_inv);
    when exempt_function_expenditures_527f(o, y, expend);
    when net_inv <= expend;
    then section_501c_organization_political_expenditure_inclusion(o, y, net_inv);
}
rule Section527fInclusionExpendituresLower(o: Person, y: TaxableYear, net_inv: Money, expend: Money) defeasible {
    label en official "section 527(f)(1): the aggregate exempt-function expenditure is the lower figure, so it is the included amount";
    when exempt_organization(o, y);
    when net_investment_income_527f(o, y, net_inv);
    when exempt_function_expenditures_527f(o, y, expend);
    when expend < net_inv;
    then section_501c_organization_political_expenditure_inclusion(o, y, expend);
}

// =======================================================================
// Subchapter T (§§1381-1388): cooperatives' patronage-dividend mechanics.
// =======================================================================

@source(IRC_S1388_A, quote = "the term \"patronage dividend\" means an amount paid to a patron by an organization to which part I of this subchapter applies—\n(1) on the basis of quantity or value of business done with or for such patron,\n(2) under an obligation of such organization to pay such amount, which obligation existed before the organization received the amount so paid, and\n(3) which is determined by reference to the net earnings of the organization from business done with or for its patrons.")
pub relation patronage_dividend_1388a(coop: Person, patron: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "an amount paid to a patron qualifies as a patronage dividend under section 1388(a): based on quantity/value of business done, under a pre-existing obligation, determined by reference to net earnings from patron business";
}
pub relation paid_on_basis_of_quantity_or_value_of_business(coop: Person, patron: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount is paid on the basis of the quantity or value of business done with or for the patron (section 1388(a)(1))";
}
pub relation paid_under_preexisting_obligation(coop: Person, patron: Person, y: TaxableYear) kind empirical {
    label en official "the amount is paid under an obligation of the organization that existed before it received the amount so paid (section 1388(a)(2))";
}
pub relation determined_by_reference_to_net_earnings_from_patron_business(coop: Person, patron: Person, y: TaxableYear) kind empirical {
    label en official "the amount is determined by reference to the net earnings of the organization from business done with or for its patrons (section 1388(a)(3))";
}
pub relation paid_out_of_non_patron_earnings_or_disparately(coop: Person, patron: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount is out of earnings other than from patron business, or out of earnings from business with other patrons paid no or smaller amounts on substantially identical transactions (section 1388(a), the flush exclusion)";
}
rule PatronageDividend1388a(coop: Person, patron: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 1388(a): the three-test patronage-dividend definition, subject to the flush-language exclusion";
    when paid_on_basis_of_quantity_or_value_of_business(coop, patron, y, amount);
    when paid_under_preexisting_obligation(coop, patron, y);
    when determined_by_reference_to_net_earnings_from_patron_business(coop, patron, y);
    unless paid_out_of_non_patron_earnings_or_disparately(coop, patron, y, amount);
    then patronage_dividend_1388a(coop, patron, y, amount);
}

@source(IRC_S1388_C, quote = "the term \"qualified written notice of allocation\" means—\n(A) a written notice of allocation which may be redeemed in cash at its stated dollar amount at any time within a period beginning on the date such written notice of allocation is paid and ending not earlier than 90 days from such date, but only if the distributee receives written notice of the right of redemption at the time he receives such written notice of allocation; and\n(B) a written notice of allocation which the distributee has consented, in the manner provided in paragraph (2), to take into account at its stated dollar amount as provided in section 1385(a).")
pub relation qualified_written_notice_of_allocation_1388c(notice_amount: Money, coop: Person, patron: Person, y: TaxableYear) kind empirical {
    label en official "the written notice of allocation is a qualified written notice under section 1388(c)(1)(A) (90-day cash redemption right) or (B) (patron consent) — the (A)/(B) sub-tests and (2)'s consent mechanics are TECH-GAP G486, case-asserted";
}
@source(IRC_S1388_C, quote = "Such term does not include any written notice of allocation which is paid as part of a patronage dividend or as part of a payment described in section 1382(c)(2)(A), unless 20 percent or more of the amount of such patronage dividend, or such payment, is paid in money or by qualified check.")
pub relation cash_or_qualified_check_portion_1388c(coop: Person, patron: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the portion of the patronage-dividend payment paid in money or by qualified check (section 1388(c)(1), the 20 percent flush condition)";
}
pub relation total_patronage_dividend_payment_1388c(coop: Person, patron: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the total amount of the patronage-dividend payment of which the written notice of allocation is a part (section 1388(c)(1), the 20 percent flush condition)";
}
rule QualifiedWrittenNoticeTwentyPercentCashTest(coop: Person, patron: Person, y: TaxableYear, cash: Money, total: Money) defeasible {
    label en official "section 1388(c)(1) flush language: 100 * cash-or-qualified-check portion >= 20 * total patronage-dividend payment — exact, no division, so exactly 20 percent satisfies the requirement";
    when cash_or_qualified_check_portion_1388c(coop, patron, y, cash);
    when total_patronage_dividend_payment_1388c(coop, patron, y, total);
    when cash * 100 >= total * 20;
    then cash_or_qualified_check_condition_met_1388c(coop, patron, y);
}
pub relation cash_or_qualified_check_condition_met_1388c(coop: Person, patron: Person, y: TaxableYear) kind institutional {
    label en official "section 1388(c)(1)'s flush 20 percent cash-or-qualified-check condition is met for this patronage-dividend payment";
}

@source(IRC_S1382_B, quote = "In determining the taxable income of an organization to which this part applies, there shall not be taken into account amounts paid during the payment period for the taxable year—\n(1) as patronage dividends (as defined in section 1388(a)), to the extent paid in money, qualified written notices of allocation (as defined in section 1388(c)), or other property (except nonqualified written notices of allocation (as defined in section 1388(d))) with respect to patronage occurring during such taxable year;")
pub relation patronage_dividend_deduction(coop: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 1382(b): the aggregate patronage-dividend/per-unit-retain-allocation exclusion from a cooperative's taxable income for amounts properly paid within the section 1382(d) payment period — task's requested pub interface";
}
pub relation qualifying_patronage_dividend_payment_within_payment_period(coop: Person, patron: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "a patronage-dividend amount paid within the section 1382(d) payment period, in money, a qualified written notice of allocation, or other qualifying property with respect to patronage occurring during the taxable year (section 1382(b)(1)) — already reflecting whichever payment-medium test applies, per this stage's judgment call";
}
pub relation total_qualifying_patronage_payments(coop: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the sum, over all patrons, of qualifying section 1382(b)(1) patronage-dividend payments for the taxable year";
}
rule TotalQualifyingPatronagePaymentsFromDividend(coop: Person, y: TaxableYear, patron: Person, amount: Money) defeasible {
    label en official "a single qualifying patronage-dividend payment stands as the total when it is the only one asserted for the cooperative and year — the general N-patron sum is a runtime aggregate-over-derived-predicate limitation (§111 class, same as section 512(a)(6)'s TECH-GAPS G76), recorded here rather than silently computed";
    when qualifying_patronage_dividend_payment_within_payment_period(coop, patron, y, amount);
    when patronage_dividend_1388a(coop, patron, y, amount);
    then total_qualifying_patronage_payments(coop, y, amount);
}
rule PatronageDividendDeduction(coop: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 1382(b): the patronage-dividend deduction equals the total qualifying patronage payments for the year";
    when total_qualifying_patronage_payments(coop, y, amount);
    then patronage_dividend_deduction(coop, y, amount);
}

@source(IRC_S1382_D, quote = "For purposes of subsections (b) and (c)(2), the payment period for any taxable year is the period beginning with the first day of such taxable year and ending with the fifteenth day of the ninth month following the close of such year.")
pub relation section_1382d_payment_period(coop: Person, y: TaxableYear, start: Date, deadline: Date) kind institutional {
    label en official "section 1382(d): the payment period for the taxable year — from its first day through the 15th day of the ninth month following its close (the '8½-month' rule) — exact `add_calendar_period` arithmetic, no approximation";
}
pub relation cooperative_taxable_year_bounds(coop: Person, y: TaxableYear, start: Date, year_end: Date) kind empirical {
    label en unofficial "the cooperative's taxable-year bounds (first day, last day) asserted for the section 1382(d) payment-period computation — binds `coop` to the (start, year_end) dates directly rather than via a separate coop-less `begins`/`ends` lookup, avoiding an unbound-variable range-restriction failure";
}
rule Section1382dPaymentPeriod(coop: Person, y: TaxableYear, start: Date, year_end: Date) strict {
    label en official "section 1382(d): payment period end = the 15th day of the ninth month after the taxable year's close";
    when cooperative_taxable_year_bounds(coop, y, start, year_end);
    then section_1382d_payment_period(coop, y, start, add_calendar_period(add_calendar_period(year_end, 9 calendar_month), 15 calendar_day));
}
@source(IRC_S1382_D, quote = "For purposes of subsections (b)(1) and (c)(2)(A), a qualified check issued during the payment period shall be treated as an amount paid in money during such period if endorsed and cashed on or before the 90th day after the close of such period.")
pub relation qualified_check_issued_during_payment_period(coop: Person, patron: Person, y: TaxableYear) kind empirical {
    label en official "a qualified check was issued during the section 1382(d) payment period (section 1382(d), second sentence)";
}
pub relation qualified_check_endorsed_and_cashed_by(coop: Person, patron: Person, y: TaxableYear, cashed_on: Date) kind empirical {
    label en official "the date the qualified check was endorsed and cashed, for the section 1382(d) 90-day extension";
}
pub relation qualified_check_treated_as_paid_in_money_during_period(coop: Person, patron: Person, y: TaxableYear) kind institutional {
    label en official "section 1382(d): a qualified check issued during the payment period, endorsed and cashed within 90 days after the close of the payment period, is treated as paid in money during the payment period";
}
rule QualifiedCheckNinetyDayExtension(coop: Person, patron: Person, y: TaxableYear, start: Date, deadline: Date, cashed_on: Date) strict {
    label en official "section 1382(d): a qualified check issued during the payment period, cashed on or before the 90th day after its close, counts as money paid during the period";
    when section_1382d_payment_period(coop, y, start, deadline);
    when qualified_check_issued_during_payment_period(coop, patron, y);
    when qualified_check_endorsed_and_cashed_by(coop, patron, y, cashed_on);
    when cashed_on <= add_calendar_period(deadline, 90 calendar_day);
    then qualified_check_treated_as_paid_in_money_during_period(coop, patron, y);
}
