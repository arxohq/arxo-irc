// 26 U.S.C. Chapter 95 — Presidential Election Campaign Fund: §9001 (short
// title), §9002 (definitions: party classification), §9003 (conditions for
// eligibility), §9004 (entitlement to payments), §9005 (certification by the
// Commission), §9007 (examinations, audits, repayments).
//
// JUDGMENT CALLS:
//  - Party classification (§9002(6)-(8)) is an EXACT-BOUNDARY classification
//    at 25%/5% of the preceding election's total popular vote — modelled as
//    three mutually exclusive `strict` rules over a single case-supplied
//    vote-share Decimal, per AGENT-BRIEF's "exact classification" method.
//  - §9003(a)-(c) (agreements/certifications) are each a `power`: the
//    candidates' certification is the EXERCISE, `valid_when` the statutory
//    content-truth of the certification (represented as case facts, since
//    truth-of-a-certification is itself the thing certified, not something
//    this package re-derives), `effect` creates eligibility.
//  - §9004(a)(1) major-party equal payments is EXECUTABLE (the FECA
//    §315(b)(1)(A) expenditure limitation itself is EXTERNAL_DEPENDENCY,
//    taken as a case-supplied Money value). §9004(a)(2)(A)'s minor-party
//    ratio (minor-candidate votes ÷ average major-party-candidate votes,
//    applied to the major-party entitlement) is EXECUTABLE arithmetic with
//    intermediate values, per AGENT-BRIEF's method. §9004(a)(3) new-party
//    post-election entitlement reuses the SAME ratio shape. §9004(b)'s
//    lower-of-two-amounts limitation is an exact `min`.
//  - §9007 examination/repayment: the Commission's excess-payment
//    determination is EXECUTABLE (exact comparison); the repayment DUTY
//    itself is `achievement` (no explicit statutory day-count window is
//    given for the repayment itself, so the window is open-ended per the
//    same convention the joint-committee pilot used for §8002(d)).

language "law.core" version "0.2";
package us.irc.election_funding version "0.1.1";
namespace "urn:us:irc:election_funding:clir";

use self::{
    IRC_S9001,
    IRC_S9002,
    IRC_S9003_A,
    IRC_S9003_B,
    IRC_S9003_C,
    IRC_S9003_E,
    IRC_S9004_A,
    IRC_S9004_B,
    IRC_S9007_B,
    Organ,
};

const FederalElectionCommission: Organ = entity_ref("urn:us:irc:election_funding:clir#FederalElectionCommission") {
    label en official "Federal Election Commission";
}

// --- §9001 Short title ---------------------------------------------------------

relation chapter_95_cited_as(name: Text) kind institutional;
@source(IRC_S9001, relation = formalizes, coverage = exact, quote = "This chapter may be cited as the \"Presidential Election Campaign Fund Act\".")
rule S9001ShortTitle strict { then chapter_95_cited_as("Presidential Election Campaign Fund Act"); }

// --- §9002 Definitions: party classification -----------------------------------

entity PoliticalParty { label en unofficial "a political party, for purposes of Chapter 95's party classification (§9002(6)-(8))"; }

relation preceding_election_vote_share(party: PoliticalParty, share: Decimal) kind empirical {
    label en unofficial "the party's presidential candidate's share of the total popular vote for President in the PRECEDING presidential election (§9002(6)-(8))";
}

relation is_major_party(party: PoliticalParty) kind institutional {
    label en unofficial "the party's candidate in the preceding election received 25 percent or more of the total popular vote (§9002(6))";
}
@source(IRC_S9002, relation = formalizes, coverage = partial, quote = "The term \"major party\" means, with respect to any presidential election, a political party whose candidate for the office of President in the preceding presidential election received, as the candidate of such party, ")
rule S9002MajorParty strict {
    for party: PoliticalParty;
    for share: Decimal;
    when preceding_election_vote_share(party, share) and share >= 0.25;
    then is_major_party(party);
}

relation is_minor_party(party: PoliticalParty) kind institutional {
    label en unofficial "the party's candidate in the preceding election received 5 percent or more but less than 25 percent of the total popular vote (§9002(7))";
}
@source(IRC_S9002, relation = formalizes, coverage = partial, quote = "The term \"minor party\" means, with respect to any presidential election, a political party whose candidate for the office of President in the preceding presidential election received, as the candidate of such party, ")
rule S9002MinorParty strict {
    for party: PoliticalParty;
    for share: Decimal;
    when preceding_election_vote_share(party, share) and share >= 0.05 and share < 0.25;
    then is_minor_party(party);
}

relation is_new_party(party: PoliticalParty) kind institutional {
    label en unofficial "the party is neither a major nor a minor party (§9002(8)) — includes a party with no preceding-election candidate/vote share";
}
@source(IRC_S9002, relation = formalizes, coverage = partial, quote = "The term \"new party\" means, with respect to any presidential election, a political party which is neither a major party nor a minor party.")
rule S9002NewPartyByShare strict {
    for party: PoliticalParty;
    for share: Decimal;
    when preceding_election_vote_share(party, share) and share < 0.05;
    then is_new_party(party);
}

// --- §9003 Conditions for eligibility for payments ------------------------------

relation candidates_agree_to_audit(party: PoliticalParty) kind empirical {
    label en unofficial "the candidates have agreed in writing to furnish evidence/records and to an audit under §9007 (§9003(a))";
}
relation eligible_for_payments_general(party: PoliticalParty) kind institutional {
    label en unofficial "the candidates of the party are eligible to receive §9006 payments (the §9003(a) baseline condition, common to all parties)";
}
@source(IRC_S9003_A, relation = formalizes, coverage = partial, quote = "agree to an audit and examination by the Commission under section 9007 and to pay any amounts required to be paid under such section.")
rule S9003BaselineAgreement strict {
    for party: PoliticalParty;
    when candidates_agree_to_audit(party);
    then power S9003BaselineAgreementPower {
        holder party;
        over FederalElectionCommission;
        exercise candidates_agree_to_audit(party);
        valid_when candidates_agree_to_audit(party);
        effect create(eligible_for_payments_general(party));
    };
}

relation major_party_certification_content_true(party: PoliticalParty) kind empirical {
    label en unofficial "the major party's §9003(b)(1)-(2) certified content (expenses within entitlement; no non-deficiency-makeup contributions) is true — represented as a case fact since the certification's TRUTH, not its filing, is the condition tested";
}
relation major_party_certified(party: PoliticalParty) kind empirical {
    label en unofficial "the major party's candidates have filed the §9003(b) certification under penalty of perjury";
}
relation eligible_major_party(party: PoliticalParty) kind institutional;
@source(IRC_S9003_B, relation = formalizes, coverage = partial, quote = "In order to be eligible to receive any payments under section 9006, the candidates of a major party in a presidential election shall certify to the Commission, under penalty of perjury, that—")
rule S9003MajorPartyCertification strict {
    for party: PoliticalParty;
    when is_major_party(party) and major_party_certified(party);
    then power S9003MajorPartyCertificationPower {
        holder party;
        over FederalElectionCommission;
        exercise major_party_certified(party);
        valid_when major_party_certification_content_true(party);
        effect create(eligible_major_party(party));
    };
}

relation minor_or_new_party_certification_content_true(party: PoliticalParty) kind empirical;
relation minor_or_new_party_certified(party: PoliticalParty) kind empirical;
relation eligible_minor_or_new_party(party: PoliticalParty) kind institutional;
@source(IRC_S9003_C, relation = formalizes, coverage = partial, quote = "In order to be eligible to receive any payments under section 9006, the candidates of a minor or new party in a presidential election shall certify to the Commission, under penalty of perjury, that—")
rule S9003MinorOrNewPartyCertification strict {
    for party: PoliticalParty;
    when (is_minor_party(party) or is_new_party(party)) and minor_or_new_party_certified(party);
    then power S9003MinorOrNewPartyCertificationPower {
        holder party;
        over FederalElectionCommission;
        exercise minor_or_new_party_certified(party);
        valid_when minor_or_new_party_certification_content_true(party);
        effect create(eligible_minor_or_new_party(party));
    };
}

relation closed_captioning_certified(party: PoliticalParty) kind empirical;
relation closed_captioning_condition_met(party: PoliticalParty) kind institutional {
    label en unofficial "the candidate has certified that television commercials will be closed-captioned for the hearing impaired (§9003(e))";
}
@source(IRC_S9003_E, relation = formalizes, coverage = partial, quote = "No candidate for the office of President or Vice President may receive amounts from the Presidential Election Campaign Fund under this chapter or chapter 96 unless such candidate has certified that any television commerc")
rule S9003ClosedCaptioning strict {
    for party: PoliticalParty;
    when closed_captioning_certified(party);
    then closed_captioning_condition_met(party);
}

// --- §9004 Entitlement of eligible candidates to payments -----------------------

relation major_party_expenditure_limitation(amount: Money) kind empirical {
    label en unofficial "the FECA §315(b)(1)(A) expenditure limitation applicable to major-party candidates — external dependency, case-supplied";
}
relation major_party_entitlement(party: PoliticalParty, amount: Money) kind institutional {
    label en unofficial "the major party's eligible candidates' aggregate entitlement under §9004(a)(1) — equal to the FECA expenditure limitation";
}
@source(IRC_S9004_A, relation = formalizes, coverage = partial, quote = "The eligible candidates of each major party in a presidential election shall be entitled to equal payments under section 9006 in an amount which, in the aggregate, shall not exceed the expenditure limitations applica")
rule S9004MajorPartyEntitlement strict {
    for party: PoliticalParty;
    for amount: Money;
    when is_major_party(party) and eligible_major_party(party) and major_party_expenditure_limitation(amount);
    then major_party_entitlement(party, amount);
}

relation minor_party_own_election_votes(party: PoliticalParty, votes: Decimal) kind empirical {
    label en unofficial "the minor party candidate's popular-vote count in the CURRENT presidential election (§9004(a)(2)(A) ratio numerator)";
}
relation average_major_party_votes(votes: Decimal) kind empirical {
    label en unofficial "the average popular-vote count of the two major-party candidates in the current election (§9004(a)(2)(A) ratio denominator)";
}
relation minor_party_entitlement(party: PoliticalParty, amount: Money) kind institutional {
    label en unofficial "the minor party's entitlement: the (a)(1) major-party amount times the ratio of the minor party's votes to the average major-party votes (§9004(a)(2)(A)) — intermediate value: the ratio itself is exposed via minor_party_vote_ratio";
}
relation minor_party_vote_ratio(party: PoliticalParty, ratio: Decimal) kind institutional {
    label en unofficial "intermediate value: minor_party_own_election_votes / average_major_party_votes";
}
@source(IRC_S9004_A, relation = formalizes, coverage = partial, quote = "The eligible candidates of a minor party in a presidential election shall be entitled to payments under section 9006 equal in the aggregate to an amount which bears the same ratio to the amount allowed under paragraph")
rule S9004MinorPartyVoteRatio strict {
    for party: PoliticalParty;
    for own: Decimal;
    for avg: Decimal;
    when minor_party_own_election_votes(party, own) and average_major_party_votes(avg) and avg > 0.0;
    then minor_party_vote_ratio(party, round(own / avg, 6, "HALF_UP"));
}
@source(IRC_S9004_A, relation = formalizes, coverage = partial, quote = "The eligible candidates of a minor party in a presidential election shall be entitled to payments under section 9006 equal in the aggregate to an amount which bears the same ratio to the amount allowed under paragraph")
rule S9004MinorPartyEntitlement strict {
    for party: PoliticalParty;
    for major_amount: Money;
    for ratio: Decimal;
    when is_minor_party(party)
        and eligible_minor_or_new_party(party)
        and minor_party_vote_ratio(party, ratio)
        and exists_major_party_amount(major_amount);
    then minor_party_entitlement(party, round(major_amount * ratio, 2, "HALF_UP"));
}
relation exists_major_party_amount(amount: Money) kind empirical {
    label en unofficial "the (a)(1) major-party amount for the current election — the ratio's base, a case-supplied figure (equal to the FECA limitation of the current cycle, not necessarily the SAME party instance's own entitlement fact)";
}

relation new_party_election_votes(party: PoliticalParty, votes: Decimal) kind empirical {
    label en unofficial "the new/minor party candidate's popular-vote count in the CURRENT election, for the post-election §9004(a)(3) entitlement (only relevant once votes >= 5 percent of the total)";
}
relation new_party_vote_share(party: PoliticalParty, share: Decimal) kind empirical;
relation new_party_post_election_entitlement(party: PoliticalParty, amount: Money) kind institutional {
    label en unofficial "§9004(a)(3): a minor/new party whose candidate receives 5 percent or more of the popular vote is entitled to the SAME ratio-based amount as (a)(2), computed after the election";
}
@source(IRC_S9004_A, relation = formalizes, coverage = partial, quote = "The eligible candidates of a minor party or a new party in a presidential election whose candidate for President in such election receives, as such candidate, 5 percent or more of the total number of popular votes ca")
rule S9004NewPartyPostElectionEntitlement strict {
    for party: PoliticalParty;
    for share: Decimal;
    for ratio: Decimal;
    for major_amount: Money;
    when new_party_vote_share(party, share)
        and share >= 0.05
        and minor_party_vote_ratio(party, ratio)
        and exists_major_party_amount(major_amount);
    then new_party_post_election_entitlement(party, round(major_amount * ratio, 2, "HALF_UP"));
}

relation qualified_expenses_less_contributions(party: PoliticalParty, amount: Money) kind empirical {
    label en unofficial "§9004(b)(1): qualified campaign expenses incurred, reduced by non-deficiency-makeup contributions received";
}
relation limited_entitlement(party: PoliticalParty, amount: Money) kind institutional {
    label en unofficial "§9004(b): the LOWER of (1) net qualified expenses and (2) the (a)(1) major-party amount net of the same contributions — the actual cap on (a)(2)/(3) entitlements";
}
@source(IRC_S9004_B, relation = formalizes, coverage = exact, quote = "The aggregate payments to which the eligible candidates of a political party shall be entitled under subsections (a)(2) and (3) with respect to a presidential election shall not exceed an amount equal to the lower of—")
rule S9004Limitation strict {
    for party: PoliticalParty;
    for net_expenses: Money;
    for major_amount: Money;
    for contributions: Money;
    when qualified_expenses_less_contributions(party, net_expenses)
        and exists_major_party_amount(major_amount)
        and contributions_received(party, contributions);
    then limited_entitlement(party, min(net_expenses, major_amount - contributions));
}
relation contributions_received(party: PoliticalParty, amount: Money) kind empirical;

// --- §9007 Examinations and audits; repayments ----------------------------------

relation payments_received(party: PoliticalParty, amount: Money) kind empirical;
relation entitled_amount(party: PoliticalParty, amount: Money) kind empirical {
    label en unofficial "the aggregate amount to which the party's candidates were actually entitled (the audit's own comparator, drawing on §9004's entitlement facts)";
}
relation excess_payment_determined(party: PoliticalParty, excess: Money) kind institutional {
    label en unofficial "the Commission has determined that payments received exceeded the entitled amount (§9007(b)(1)) — the exact excess is received minus entitled";
}
@source(IRC_S9007_B, relation = formalizes, coverage = partial, quote = "If the Commission determines that any portion of the payments made to the eligible candidates of a political party under section 9006 was in excess of the aggregate payments to which candidates were entitled under section 9004")
rule S9007ExcessPaymentDetermined strict {
    for party: PoliticalParty;
    for received: Money;
    for entitled: Money;
    when payments_received(party, received) and entitled_amount(party, entitled) and received > entitled;
    then excess_payment_determined(party, received - entitled);
}
relation repaid_excess(party: PoliticalParty, amount: Money) kind empirical;
@source(IRC_S9007_B, relation = formalizes, coverage = partial, quote = "it shall so notify such candidates, and such candidates shall pay to the Secretary of the Treasury an amount equal to such portion.")
rule S9007RepaymentDuty defeasible {
    for party: PoliticalParty;
    for excess: Money;
    when excess_payment_determined(party, excess);
    then duty S9007RepayExcess {
        bearer party;
        beneficiary us.irc.core::Secretary;
        goal achievement {
            condition repaid_excess(party, excess);
            window [-infinity, infinity];
        }
    };
}
