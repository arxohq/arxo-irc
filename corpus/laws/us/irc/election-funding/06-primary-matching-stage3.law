// Stage 3 (TECH_GAP reduction), Chapter 96: §9033(c)(1)(A), (c)(2)-(4) termination, continued payments, voting
// percentage and reestablishment of eligibility; §9038(a) audit duty and §9038(b)(3) retention and pro-rata
// repayment; §9039(b) and §9040(c)-(d) powers of the Commission.
//
// JUDGMENT CALLS
//  - Vote percentages are Decimal fractions of 1 (0.10 = 10 percent), as the party vote shares of module 01.
//  - §9033(c)(3): the treated percentage on a date is the MAX over the recorded per-State percentages of that date
//    (max over an EMPIRICAL relation); "second consecutive primary" is a case-supplied pairing of dates
//    (`consecutive_primary_pair`), each date tested with the treated percentage. The pre-existing case-supplied
//    `second_consecutive_primary_under_10_percent` stays a second producer path of the same termination.
//  - §9033(c)(4)(B): the 20-percent test compares the candidate's votes with 20 percent of the total votes cast for
//    candidates of the same party, in a primary held after the primary that was the basis of the termination.
//  - §9038(b)(3): the retention period ends at the earlier of the liquidation date and six months after the end of
//    the matching payment period (three exclusive rules); the pro-rata repayment is due from that date, with no
//    upper bound ("promptly"). The ratio uses exact division, cents HALF_UP (JUDGMENT CALL: no rounding is named).
//  - The Commission's general powers are powers whose limiting condition ("determines to be necessary") is an
//    external judgment relation of the Commission (DECISION-0194).

language "law.core" version "0.2";
package us.irc.election_funding version "0.1.1";
namespace "urn:us:irc:election_funding:clir";

use self::{
    FederalElectionCommission,
    IRC_S9033_C,
    IRC_S9038_A,
    IRC_S9038_B,
    IRC_S9039_B,
    IRC_S9040_C,
    IRC_S9040_D,
    PresidentialPrimaryMatchingPaymentAccount,
    PrimaryCandidate,
    matching_payments_received,
    payments_terminated_9033,
    total_votes_same_party,
    votes_cast_for_candidate,
};

// =====================================================================
// §9033(c): termination of payments
// =====================================================================

relation ceased_to_be_candidate_9032_2(c: PrimaryCandidate) kind empirical {
    label en unofficial "the individual ceases to be a candidate as a result of the last sentence of section 9032(2) (section 9033(c)(1)(A))";
}
relation candidate_status_restored(c: PrimaryCandidate) kind institutional {
    label en unofficial "section 9033(c)(4)(A): the Commission has determined that the individual is a candidate again";
}
relation payments_reestablished_by_20_percent(c: PrimaryCandidate) kind institutional {
    label en unofficial "section 9033(c)(4)(B): the candidate whose payments were terminated under (c)(1)(B) received 20 percent or more of the votes in a later primary and may again receive payments";
}

relation state_primary_percent(c: PrimaryCandidate, primary_date: Date, state: Text, percent: Decimal) kind empirical {
    label en unofficial "the percentage of the votes (fraction of 1) the candidate received in the primary held in the State on the date (section 9033(c)(3))";
}
relation treated_primary_percent(c: PrimaryCandidate, primary_date: Date, percent: Decimal) kind institutional {
    label en unofficial "section 9033(c)(3): where primaries are held in more than one State on the same date, the greatest percentage received in any of them is treated as the candidate's percentage on that date";
}
@source(IRC_S9033_C, relation = formalizes, coverage = exact, quote = "a candidate shall be treated as receiving that percentage of the votes on such date which he received in the primary election conducted on such date in which he received the greatest percentage vote.")
rule S9033c3TreatedPercent strict {
    for c: PrimaryCandidate;
    for d: Date;
    when state_primary_percent(c, d, _, _);
    then treated_primary_percent(c, d, max(collect all p: Decimal, s: Text where state_primary_percent(c, d, s, p)));
}
relation consecutive_primary_pair(c: PrimaryCandidate, first: Date, second: Date) kind empirical {
    label en unofficial "the second date is the date of the next primary election after the first in which the individual received votes (a case-supplied pairing of consecutive primaries)";
}
relation second_consecutive_primary_under_10_percent_by_dates(c: PrimaryCandidate) kind institutional {
    label en unofficial "section 9033(c)(1)(B) with (c)(3): the treated percentage was under 10 percent in each of two consecutive primary dates";
}
@source(IRC_S9033_C, relation = formalizes, coverage = partial, quote = "the second consecutive primary election in which such individual receives less than 10 percent of the number of votes cast for all candidates of the same party for the same office in such primary election")
rule S9033c1BSecondConsecutiveUnder10 strict {
    for c: PrimaryCandidate;
    for d1: Date;
    for d2: Date;
    for p1: Decimal;
    for p2: Decimal;
    when consecutive_primary_pair(c, d1, d2) and treated_primary_percent(c, d1, p1) and treated_primary_percent(c, d2, p2) and p1 < 0.10 and p2 < 0.10;
    then second_consecutive_primary_under_10_percent_by_dates(c);
}

// (c)(4)(B): reestablishment by a later 20-percent result (reads only recorded facts: no loop with the termination)

relation termination_basis_primary_date(c: PrimaryCandidate, primary_date: Date) kind empirical {
    label en unofficial "the date of the election that was the basis for terminating payments under (c)(1)(B)";
}
@source(IRC_S9033_C, relation = formalizes, coverage = exact, quote = "if he receives 20 percent or more of the total number of votes cast for candidates of the same party in a primary election held after the date on which the election was held which was the basis for terminating payments to him.")
rule S9033c4BReestablishment strict {
    for c: PrimaryCandidate;
    for basis: Date;
    for d: Date;
    for votes: Decimal;
    for total: Decimal;
    when termination_basis_primary_date(c, basis) and votes_cast_for_candidate(c, d, votes) and total_votes_same_party(d, total) and d > basis and votes >= total * 0.20;
    then payments_reestablished_by_20_percent(c);
}
relation withheld_amounts_receivable(c: PrimaryCandidate) kind institutional {
    label en unofficial "section 9033(c)(4)(B): the reestablished candidate may receive the amounts he would have received but for (c)(1)(B)";
}
@source(IRC_S9033_C, relation = formalizes, coverage = exact, quote = "may again receive payments (including amounts he would have received but for paragraph (1)(B))")
rule S9033c4BWithheldAmounts strict {
    for c: PrimaryCandidate;
    when payments_reestablished_by_20_percent(c);
    then withheld_amounts_receivable(c);
}

// (c)(4)(A): the Commission's redetermination (a power)

relation actively_seeking_election_in_more_than_one_state(c: PrimaryCandidate) kind empirical {
    label en unofficial "the individual is actively seeking election to the office of President in more than one State";
}
relation redetermination_conditions_met(c: PrimaryCandidate) kind institutional {
    label en unofficial "section 9033(c)(4)(A): the individual is ineligible under (c)(1)(A) and is found to be actively seeking election in more than one State";
}
@source(IRC_S9033_C, relation = formalizes, coverage = partial, quote = "upon a finding that such individual is actively seeking election to the office of President of the United States in more than one State.")
rule S9033c4AConditions strict {
    for c: PrimaryCandidate;
    when ceased_to_be_candidate_9032_2(c) and actively_seeking_election_in_more_than_one_state(c);
    then redetermination_conditions_met(c);
}
relation commission_determines_individual_is_candidate(c: PrimaryCandidate) kind empirical;
@source(IRC_S9033_C, relation = formalizes, coverage = partial, quote = "the Commission may subsequently determine that such individual is a candidate")
rule S9033c4ARedetermination strict {
    for c: PrimaryCandidate;
    when commission_determines_individual_is_candidate(c);
    then power S9033c4ARedeterminationPower {
        holder FederalElectionCommission;
        over c;
        exercise commission_determines_individual_is_candidate(c);
        valid_when redetermination_conditions_met(c);
        effect create(candidate_status_restored(c));
    };
}
relation eligibility_need_not_be_reestablished(c: PrimaryCandidate) kind institutional {
    label en unofficial "section 9033(c)(4)(A): the Commission makes the determination without requiring the individual to reestablish his eligibility under subsection (a)";
}
@source(IRC_S9033_C, relation = formalizes, coverage = exact, quote = "The Commission shall make such determination without requiring such individual to reestablish his eligibility to receive payments under subsection (a).")
rule S9033c4ANoReestablishment strict {
    for c: PrimaryCandidate;
    when candidate_status_restored(c);
    then eligibility_need_not_be_reestablished(c);
}

// The termination itself: the (c)(1)(B) rule of module 02 gains the (c)(4)(B) exception in place (see there); the
// (c)(1)(A) branch, the derived (c)(1)(B) path and the (c)(4)(A) exception are added here with the same head.

@source(IRC_S9033_C, relation = formalizes, coverage = partial, quote = "if such individual ceases to be a candidate as a result of the operation of the last sentence of section 9032(2)")
rule S9033TerminationCeasedCandidate defeasible {
    for c: PrimaryCandidate;
    when ceased_to_be_candidate_9032_2(c);
    then payments_terminated_9033(c);
    unless candidate_status_restored(c);
}
@source(IRC_S9033_C, relation = formalizes, coverage = partial, quote = "the second consecutive primary election in which such individual receives less than 10 percent of the number of votes cast for all candidates of the same party for the same office in such primary election")
rule S9033TerminationUnder10PercentByDates defeasible {
    for c: PrimaryCandidate;
    when second_consecutive_primary_under_10_percent_by_dates(c);
    then payments_terminated_9033(c);
    unless payments_reestablished_by_20_percent(c);
}

// (c)(2): payments continue for expenses incurred before the date of ineligibility

relation ineligible_on(c: PrimaryCandidate, d: Date) kind empirical {
    label en unofficial "the date upon which the candidate becomes ineligible under section 9033(c)(1)";
}
relation qualified_expense_incurred_on(c: PrimaryCandidate, d: Date, amount: Money) kind empirical;
relation matching_payment_receivable_for_prior_expense(c: PrimaryCandidate, amount: Money) kind institutional {
    label en unofficial "section 9033(c)(2): the ineligible candidate may continue to receive section 9037 payments to defray this qualified campaign expense incurred before the date of ineligibility";
}
@source(IRC_S9033_C, relation = formalizes, coverage = exact, quote = "shall be eligible to continue to receive payments under section 9037 to defray qualified campaign expenses incurred before the date upon which such candidate becomes ineligible under paragraph (1).")
rule S9033c2PriorExpenses defeasible {
    for c: PrimaryCandidate;
    for ineligible: Date;
    for incurred: Date;
    for amount: Money;
    when payments_terminated_9033(c) and ineligible_on(c, ineligible) and qualified_expense_incurred_on(c, incurred, amount) and incurred < ineligible;
    then matching_payment_receivable_for_prior_expense(c, amount);
}

// =====================================================================
// §9038(a): audit duty; (b)(3): retention and pro-rata repayment
// =====================================================================

relation candidate_received_payments_in_period(c: PrimaryCandidate, period: Text) kind empirical;
relation matching_period_end_date(period: Text, d: Date) kind empirical;
relation matching_period_audit_conducted(c: PrimaryCandidate, period: Text) kind empirical;
@source(IRC_S9038_A, relation = formalizes, coverage = exact, quote = "After each matching payment period, the Commission shall conduct a thorough examination and audit of the qualified campaign expenses of every candidate and his authorized committees who received payments under section 9037.")
rule S9038aAuditDuty defeasible {
    for c: PrimaryCandidate;
    for period: Text;
    for end: Date;
    for received: Money;
    when candidate_received_payments_in_period(c, period) and matching_period_end_date(period, end) and matching_payments_received(c, received) and received > 0.00 USD;
    then duty S9038aConductExaminationAndAudit {
        bearer FederalElectionCommission;
        goal achievement {
            condition matching_period_audit_conducted(c, period);
            window [end, infinity];
        }
    };
}

relation matching_period_end_of_candidate(c: PrimaryCandidate, d: Date) kind empirical;
relation all_obligations_liquidated(c: PrimaryCandidate) kind empirical;
relation obligations_liquidated_on(c: PrimaryCandidate, d: Date) kind empirical;
relation retention_ends_on(c: PrimaryCandidate, d: Date) kind institutional {
    label en unofficial "section 9038(b)(3): the date on which retention of matching payment account amounts ends (liquidation of all obligations, or six months after the end of the matching payment period if earlier)";
}
@source(IRC_S9038_B, relation = formalizes, coverage = partial, quote = "Amounts received by a candidate from the matching payment account may be retained for the liquidation of all obligations to pay qualified campaign expenses incurred for a period not exceeding 6 months after the end of the matching payment period.")
rule S9038b3RetentionEndsAtLiquidation strict {
    for c: PrimaryCandidate;
    for liquidated: Date;
    for end: Date;
    when obligations_liquidated_on(c, liquidated) and matching_period_end_of_candidate(c, end) and liquidated <= add_calendar_period(end, 6 calendar_month);
    then retention_ends_on(c, liquidated);
}
@source(IRC_S9038_B, relation = formalizes, coverage = partial, quote = "for a period not exceeding 6 months after the end of the matching payment period.")
rule S9038b3RetentionEndsAtSixMonthsAfterLiquidation strict {
    for c: PrimaryCandidate;
    for liquidated: Date;
    for end: Date;
    when obligations_liquidated_on(c, liquidated) and matching_period_end_of_candidate(c, end) and liquidated > add_calendar_period(end, 6 calendar_month);
    then retention_ends_on(c, add_calendar_period(end, 6 calendar_month));
}
@source(IRC_S9038_B, relation = formalizes, coverage = partial, quote = "for a period not exceeding 6 months after the end of the matching payment period.")
rule S9038b3RetentionEndsAtSixMonthsUnliquidated strict {
    for c: PrimaryCandidate;
    for end: Date;
    when matching_period_end_of_candidate(c, end) and not_known(all_obligations_liquidated(c));
    then retention_ends_on(c, add_calendar_period(end, 6 calendar_month));
}
relation unexpended_balance_in_candidate_accounts(c: PrimaryCandidate, amount: Money) kind empirical;
relation total_deposits_to_candidate_accounts(c: PrimaryCandidate, amount: Money) kind empirical;
relation unexpended_balance_repayable_pro_rata(c: PrimaryCandidate, amount: Money) kind institutional {
    label en unofficial "section 9038(b)(3): the portion of the unexpended balance that bears the same ratio to the total unexpended balance as the total received from the matching payment account bears to the total of all deposits into the candidate's accounts";
}
@source(IRC_S9038_B, relation = formalizes, coverage = exact, quote = "that portion of any unexpended balance remaining in the candidate's accounts which bears the same ratio to the total unexpended balance as the total amount received from the matching payment account bears to the total of all deposits made into the candidate's accounts shall be promptly repaid to the matching payment account.")
rule S9038b3ProRataRepayable strict {
    for c: PrimaryCandidate;
    for unexpended: Money;
    for received: Money;
    for deposits: Money;
    when unexpended_balance_in_candidate_accounts(c, unexpended) and matching_payments_received(c, received) and total_deposits_to_candidate_accounts(c, deposits) and deposits > 0.00 USD;
    then unexpended_balance_repayable_pro_rata(c, div_round(unexpended * (received / 1.00 USD), deposits / 1.00 USD, 2, "HALF_UP"));
}
relation unexpended_balance_repaid_to_account(c: PrimaryCandidate, amount: Money) kind empirical;
@source(IRC_S9038_B, relation = formalizes, coverage = exact, quote = "shall be promptly repaid to the matching payment account.")
rule S9038b3RepaymentDuty defeasible {
    for c: PrimaryCandidate;
    for amount: Money;
    for start: Date;
    when unexpended_balance_repayable_pro_rata(c, amount) and retention_ends_on(c, start);
    then duty S9038b3RepayUnexpendedBalance {
        bearer c;
        beneficiary PresidentialPrimaryMatchingPaymentAccount;
        goal achievement {
            condition unexpended_balance_repaid_to_account(c, amount);
            window [start, infinity]; // "promptly": no day count in the text
        }
    };
}

// =====================================================================
// §9039(b) and §9040(c)-(d): powers of the Commission
// =====================================================================

external judgment relation commission_deems_necessary_9039b(c: PrimaryCandidate) {
    authority FederalElectionCommission;
    label en official "the Commission determines it necessary to carry out its responsibilities under Chapter 96 (section 9039(b))";
}
relation additional_examination_exercised_9039(c: PrimaryCandidate) kind empirical;
relation investigation_exercised_9039(c: PrimaryCandidate) kind empirical;
relation records_requirement_exercised_9039(c: PrimaryCandidate) kind empirical;
relation additional_examination_authorized_9039(c: PrimaryCandidate) kind institutional;
relation investigation_authorized_9039(c: PrimaryCandidate) kind institutional;
relation records_requirement_effective_9039(c: PrimaryCandidate) kind institutional;
@source(IRC_S9039_B, relation = formalizes, coverage = partial, quote = "to conduct examinations and audits (in addition to the examinations and audits required by section 9038(a))")
rule S9039bAdditionalExamination strict {
    for c: PrimaryCandidate;
    when additional_examination_exercised_9039(c);
    then power S9039bAdditionalExaminationPower {
        holder FederalElectionCommission;
        over c;
        exercise additional_examination_exercised_9039(c);
        valid_when commission_deems_necessary_9039b(c);
        effect create(additional_examination_authorized_9039(c));
    };
}
@source(IRC_S9039_B, relation = formalizes, coverage = partial, quote = "to conduct investigations")
rule S9039bInvestigation strict {
    for c: PrimaryCandidate;
    when investigation_exercised_9039(c);
    then power S9039bInvestigationPower {
        holder FederalElectionCommission;
        over c;
        exercise investigation_exercised_9039(c);
        valid_when commission_deems_necessary_9039b(c);
        effect create(investigation_authorized_9039(c));
    };
}
@source(IRC_S9039_B, relation = formalizes, coverage = partial, quote = "and to require the keeping and submission of any books, records, and information")
rule S9039bRecordsRequirement strict {
    for c: PrimaryCandidate;
    when records_requirement_exercised_9039(c);
    then power S9039bRecordsRequirementPower {
        holder FederalElectionCommission;
        over c;
        exercise records_requirement_exercised_9039(c);
        valid_when commission_deems_necessary_9039b(c);
        effect create(records_requirement_effective_9039(c));
    };
}

relation action_seeks_relief_implementing_chapter_96(action_id: Text) kind empirical {
    label en unofficial "the action seeks injunctive relief appropriate to implement a provision of Chapter 96";
}
relation commission_injunction_petition_filed(action_id: Text) kind empirical;
relation commission_injunction_petition_pending(action_id: Text) kind institutional;
@source(IRC_S9040_C, relation = formalizes, coverage = exact, quote = "The Commission is authorized, through attorneys and counsel described in subsection (a), to petition the courts of the United States for such injunctive relief as is appropriate to implement any provision of this chapter.")
rule S9040cInjunctionPetition strict {
    for action_id: Text;
    when commission_injunction_petition_filed(action_id);
    then power S9040cInjunctionPetitionPower {
        holder FederalElectionCommission;
        over action_id;
        exercise commission_injunction_petition_filed(action_id);
        valid_when action_seeks_relief_implementing_chapter_96(action_id);
        effect create(commission_injunction_petition_pending(action_id));
    };
}

relation judgment_entered_in_chapter_96_action_where_commission_appears(action_id: Text) kind empirical;
relation commission_appeal_taken_9040(action_id: Text) kind empirical;
relation commission_certiorari_petition_filed_9040(action_id: Text) kind empirical;
relation commission_appeal_pending_9040(action_id: Text) kind institutional;
relation commission_certiorari_petition_pending_9040(action_id: Text) kind institutional;
@source(IRC_S9040_D, relation = formalizes, coverage = partial, quote = "The Commission is authorized on behalf of the United States to appeal from")
rule S9040dAppeal strict {
    for action_id: Text;
    when commission_appeal_taken_9040(action_id);
    then power S9040dAppealPower {
        holder FederalElectionCommission;
        over action_id;
        exercise commission_appeal_taken_9040(action_id);
        valid_when judgment_entered_in_chapter_96_action_where_commission_appears(action_id);
        effect create(commission_appeal_pending_9040(action_id));
    };
}
@source(IRC_S9040_D, relation = formalizes, coverage = partial, quote = "and to petition the Supreme Court for certiorari to review, judgments or decrees entered with respect to actions in which it appears pursuant to the authority provided in this section.")
rule S9040dCertiorari strict {
    for action_id: Text;
    when commission_certiorari_petition_filed_9040(action_id);
    then power S9040dCertiorariPower {
        holder FederalElectionCommission;
        over action_id;
        exercise commission_certiorari_petition_filed_9040(action_id);
        valid_when judgment_entered_in_chapter_96_action_where_commission_appears(action_id);
        effect create(commission_certiorari_petition_pending_9040(action_id));
    };
}
