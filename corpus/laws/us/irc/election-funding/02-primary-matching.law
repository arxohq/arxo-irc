// 26 U.S.C. Chapter 96 — Presidential Primary Matching Payment Account:
// §9031 (short title), §9033 (eligibility), §9034 (entitlement/matching),
// §9035 (expenditure limitations), §9038 (examinations/repayments).
//
// JUDGMENT CALLS:
//  - §9033(b)(3)-(4): the "$5,000 in each of at least 20 States" and "$250
//    per contributor" thresholds are EXECUTABLE exact classifications/caps
//    over case-supplied per-State aggregates and per-contributor totals.
//  - §9034(a) matching: EVERY contribution of $250 or less is matched
//    dollar-for-dollar (the statute's own text, read with §9033(b)(4)'s cap,
//    means only the portion of a contribution up to $250 counts) — modelled
//    as an exact per-contribution rule, not an aggregate.
//  - §9034(b)'s cap (50 percent of the FECA expenditure limitation) is an
//    exact comparison over a case-supplied limitation figure.
//  - §9035(a) (expenditure limitation itself) is a `prohibition` (knowingly
//    incurring expenses in excess of the FECA limitation).

language "law.core" version "0.2";
package us.irc.election_funding version "0.1.1";
namespace "urn:us:irc:election_funding:clir";

use self::{
    FederalElectionCommission,
    IRC_S9031,
    IRC_S9033_A,
    IRC_S9033_B,
    IRC_S9033_C,
    IRC_S9034_A,
    IRC_S9034_B,
    IRC_S9035_A,
    IRC_S9038_B,
    IRC_S9038_C,
    Person,
    payments_reestablished_by_20_percent,
};

relation chapter_96_cited_as(name: Text) kind institutional;
@source(IRC_S9031, relation = formalizes, coverage = exact, quote = "This chapter may be cited as the \"Presidential Primary Matching Payment Account Act\".")
rule S9031ShortTitle strict { then chapter_96_cited_as("Presidential Primary Matching Payment Account Act"); }

// --- §9033 Eligibility for payments ---------------------------------------------

entity PrimaryCandidate { label en unofficial "a candidate seeking a party's presidential nomination, for Chapter 96 purposes"; }

relation candidate_agrees_to_audit_9033(c: PrimaryCandidate) kind empirical;
relation eligible_baseline_9033(c: PrimaryCandidate) kind institutional;
@source(IRC_S9033_A, relation = formalizes, coverage = partial, quote = "agree to an audit and examination by the Commission under section 9038 and to pay any amounts required to be paid under such section.")
rule S9033BaselineAgreement strict {
    for c: PrimaryCandidate;
    when candidate_agrees_to_audit_9033(c);
    then power S9033BaselineAgreementPower {
        holder c;
        over FederalElectionCommission;
        exercise candidate_agrees_to_audit_9033(c);
        valid_when candidate_agrees_to_audit_9033(c);
        effect create(eligible_baseline_9033(c));
    };
}

relation state_matching_total(c: PrimaryCandidate, state: Text, amount: Money) kind empirical {
    label en unofficial "the candidate's aggregate matchable contributions from residents of the named State (§9033(b)(3))";
}
relation states_meeting_5000_threshold(c: PrimaryCandidate, count: Integer) kind institutional {
    label en unofficial "the number of States in which the candidate's matching contributions exceed $5,000 — the (b)(3) threshold count";
}
relation state_meets_5000_threshold(c: PrimaryCandidate, state: Text) kind institutional;
@source(IRC_S9033_B, relation = formalizes, coverage = partial, quote = "the candidate has received matching contributions which in the aggregate, exceed $5,000 in contributions from residents of each of at least 20 States, and")
rule S9033StateThreshold strict {
    for c: PrimaryCandidate;
    for state: Text;
    for amount: Money;
    when state_matching_total(c, state, amount) and amount > 5000 USD;
    then state_meets_5000_threshold(c, state);
}
relation twenty_state_condition_met(c: PrimaryCandidate) kind institutional {
    label en unofficial "the candidate meets the $5,000-in-at-least-20-States threshold — a case-supplied classification over the count of `state_meets_5000_threshold` facts (this package does not itself count/aggregate the qualifying States into an integer; the count is a case fact, per AGENT-BRIEF's guidance on institutional sizing directives without a countable-roster aggregate)";
}
relation qualifying_state_count(c: PrimaryCandidate, count: Integer) kind empirical;
@source(IRC_S9033_B, relation = formalizes, coverage = partial, quote = "the candidate has received matching contributions which in the aggregate, exceed $5,000 in contributions from residents of each of at least 20 States, and")
rule S9033TwentyStateCondition strict {
    for c: PrimaryCandidate;
    for count: Integer;
    when qualifying_state_count(c, count) and count >= 20;
    then twenty_state_condition_met(c);
}

relation contributor_matchable_total(c: PrimaryCandidate, contributor: Person, amount: Money) kind empirical {
    label en unofficial "the aggregate amount certified as matchable with respect to one contributor (§9033(b)(4))";
}
relation contributor_within_250_cap(c: PrimaryCandidate, contributor: Person) kind institutional {
    label en unofficial "the per-contributor aggregate certified does not exceed $250 (§9033(b)(4))";
}
@source(IRC_S9033_B, relation = formalizes, coverage = exact, quote = "the aggregate of contributions certified with respect to any person under paragraph (3) does not exceed $250.")
rule S9033ContributorCap strict {
    for c: PrimaryCandidate;
    for contributor: Person;
    for amount: Money;
    when contributor_matchable_total(c, contributor, amount) and amount <= 250 USD;
    then contributor_within_250_cap(c, contributor);
}

relation eligible_for_matching_9033 (c: PrimaryCandidate) kind institutional {
    label en unofficial "the candidate is eligible for §9037 payments: baseline agreement, the 20-State threshold, and (per-contributor) the $250 cap all satisfied";
}
@source(IRC_S9033_B, relation = formalizes, coverage = partial, quote = "To be eligible to receive payments under section 9037, a candidate shall certify to the Commission that—")
rule S9033EligibleForMatching strict {
    for c: PrimaryCandidate;
    when eligible_baseline_9033(c) and twenty_state_condition_met(c);
    then eligible_for_matching_9033(c);
}

relation votes_cast_for_candidate(c: PrimaryCandidate, primary_date: Date, votes: Decimal) kind empirical;
relation total_votes_same_party(primary_date: Date, votes: Decimal) kind empirical;
relation second_consecutive_primary_under_10_percent(c: PrimaryCandidate) kind empirical {
    label en unofficial "the candidate received less than 10 percent of the vote in the second consecutive primary (§9033(c)(1)(B)) — a case-supplied classification (this package does not track a running consecutive-primary streak)";
}
relation payments_terminated_9033(c: PrimaryCandidate) kind institutional {
    label en unofficial "no further §9037 payments (except to defray already-incurred qualified campaign expenses) — §9033(c)(1)";
}
@source(IRC_S9033_C, relation = formalizes, coverage = partial, quote = "more than 30 days after the date of the second consecutive primary election in which such individual receives less than 10 percent of the number of votes cast for all candidates of the same party ")
rule S9033TerminationUnder10Percent defeasible {
    for c: PrimaryCandidate;
    when second_consecutive_primary_under_10_percent(c);
    then payments_terminated_9033(c);
    unless payments_reestablished_by_20_percent(c); // stage 3: section 9033(c)(4)(B) (module 06)
}

// --- §9034 Entitlement of eligible candidates to payments -----------------------

relation matchable_contribution(c: PrimaryCandidate, contributor: Person, amount: Money) kind empirical {
    label en unofficial "an individual contribution received by the candidate on or after the date the candidate becomes eligible under §9033 — the §9034(a) matching base, ALREADY capped at $250 per contributor per §9033(b)(4)";
}
relation matching_payment_entitlement_per_contribution(c: PrimaryCandidate, contributor: Person, amount: Money) kind institutional {
    label en unofficial "§9034(a): a payment equal to the contribution amount, contribution by contribution";
}
@source(IRC_S9034_A, relation = formalizes, coverage = partial, quote = "Every candidate who is eligible to receive payments under section 9033 is entitled to payments under section 9037 in an amount equal to the amount of each contribution received by such candidate on or")
rule S9034MatchingEntitlementPerContribution strict {
    for c: PrimaryCandidate;
    for contributor: Person;
    for amount: Money;
    when eligible_for_matching_9033(c) and matchable_contribution(c, contributor, amount) and amount <= 250 USD;
    then matching_payment_entitlement_per_contribution(c, contributor, amount);
}

relation aggregate_matching_entitlement(c: PrimaryCandidate, amount: Money) kind empirical {
    label en unofficial "the running total of the candidate's per-contribution entitlements (§9034(a)) — a case-supplied aggregate, not summed by this package (see 00-shared-style no-aggregation judgment call)";
}
relation feca_expenditure_limitation_9034(c: PrimaryCandidate, amount: Money) kind empirical {
    label en unofficial "the FECA §315(b)(1)(A) expenditure limitation applicable to the candidate — external dependency, case-supplied";
}
relation matching_entitlement_within_cap(c: PrimaryCandidate) kind institutional {
    label en unofficial "§9034(b): the candidate's aggregate matching entitlement does not exceed 50 percent of the applicable FECA expenditure limitation";
}
@source(IRC_S9034_B, relation = formalizes, coverage = exact, quote = "The total amount of payments to which a candidate is entitled under subsection (a) shall not exceed 50 percent of the expenditure limitation applicable under section 315(b)(1)(A) of the Federal Electi")
rule S9034MatchingCap strict {
    for c: PrimaryCandidate;
    for aggregate: Money;
    for limitation: Money;
    when aggregate_matching_entitlement(c, aggregate)
        and feca_expenditure_limitation_9034(c, limitation)
        and aggregate <= round(limitation * 0.50, 2, "HALF_UP");
    then matching_entitlement_within_cap(c);
}

// --- §9035 Qualified campaign expense limitations -------------------------------

relation qualified_expense_incurred(c: PrimaryCandidate, amount: Money) kind empirical;
relation feca_expenditure_limitation_9035(c: PrimaryCandidate, amount: Money) kind empirical;
@source(IRC_S9035_A, relation = formalizes, coverage = partial, quote = "No candidate shall knowingly incur qualified campaign expenses in excess of the expenditure limitation applicable under section 315(b)(1)(A) of the Federal Election Campaign Act of 1971, and no candid")
rule S9035ExpenditureLimitation defeasible {
    for c: PrimaryCandidate;
    for incurred: Money;
    for limitation: Money;
    when qualified_expense_incurred(c, incurred) and feca_expenditure_limitation_9035(c, limitation) and incurred > limitation;
    then prohibition S9035NoExcessExpenses {
        bearer c;
        beneficiary FederalElectionCommission;
        action qualified_expense_incurred(c, incurred);
        window [-infinity, infinity];
    };
}

// --- §9038 Examinations and audits; repayments ----------------------------------

relation matching_payments_received(c: PrimaryCandidate, amount: Money) kind empirical;
relation matching_entitled_amount(c: PrimaryCandidate, amount: Money) kind empirical;
relation matching_excess_determined(c: PrimaryCandidate, excess: Money) kind institutional;
@source(IRC_S9038_B, relation = formalizes, coverage = partial, quote = "If the Commission determines that any portion of the payments made to a candidate from the matching payment account was in excess of the aggregate amount of payments to which such candidate was en")
rule S9038ExcessDetermined strict {
    for c: PrimaryCandidate;
    for received: Money;
    for entitled: Money;
    when matching_payments_received(c, received) and matching_entitled_amount(c, entitled) and received > entitled;
    then matching_excess_determined(c, received - entitled);
}
relation matching_excess_repaid(c: PrimaryCandidate, amount: Money) kind empirical;
@source(IRC_S9038_B, relation = formalizes, coverage = partial, quote = "it shall notify such candidate of the amount so used, and the candidate shall pay to the Secretary an amount equal to such amount.")
rule S9038RepaymentDuty defeasible {
    for c: PrimaryCandidate;
    for excess: Money;
    when matching_excess_determined(c, excess);
    then duty S9038RepayExcess {
        bearer c;
        beneficiary us.irc.core::Secretary;
        goal achievement {
            condition matching_excess_repaid(c, excess);
            window [-infinity, infinity];
        }
    };
}
relation notification_more_than_3_years_after_period(period_end: Date, notified_on: Date) kind institutional {
    label en unofficial "§9038(c): no notification may be made more than 3 years after the end of the matching payment period";
}
relation commission_notification_made_on(period_end: Date, notified_on: Date) kind empirical {
    label en unofficial "the Commission's §9038(b) notification date, for comparison against the matching payment period's end date";
}
@source(IRC_S9038_C, relation = formalizes, coverage = exact, quote = "No notification shall be made by the Commission under subsection (b) with respect to a matching payment period more than 3 years after the end of such period.")
rule S9038NotificationWindowExpired strict {
    for period_end: Date;
    for notified_on: Date;
    when commission_notification_made_on(period_end, notified_on)
        and notified_on > add_calendar_period(period_end, 3 calendar_year);
    then notification_more_than_3_years_after_period(period_end, notified_on);
}
