// Stage 3 (TECH_GAP reduction), Chapter 95: §9003(d) withdrawal by a candidate, §9004(c) restrictions on the use of
// payments, §9004(d)-(e) personal-funds certification and "immediate family", §9007(a) post-election audit duty,
// §9008(b)(3)-(4), (c), (d)(4), (e), (g) convention machinery (HISTORICAL: superseded by §9008(i), so every rule is
// guarded by not_known(terminated_after_2014_04_03())), §9009(b) and §9010 Commission powers.
//
// JUDGMENT CALLS
//  - The Commission's general powers ("is authorized to ...") are `power`s whose holder is the Commission; the
//    statutory condition that limits them ("as it deems necessary") is an `external judgment relation` with the
//    Commission as its authority (DECISION-0194), asserted with origin adjudicated.
//  - "As soon as practicable" (§9003(d)(2)) and "promptly" (§9008(g)) give no day count: the duty window is open
//    at the upper end and starts at the date the statute names; the coverage note says so.
//  - §9004(d): the certification is a power of the party (as §9003(b)/(c) in module 01); its valid_when is the
//    truth of the content (aggregate personal-funds expenditures <= $50,000, computed from recorded items over
//    EMPIRICAL relations). Expenditures of the vice-presidential candidate count as the presidential candidate's.
//  - §9008(d)(4): read as excluding from the convention-expenditure limit a legal/accounting compensation payment
//    made by a person who is not the national committee AND is the regular employer of the individual rendering the
//    services (the parenthetical removes payers who are not the regular employer).
//  - The vote-share and money inputs are asserted by the case; nothing is invented.

language "law.core" version "0.2";
package us.irc.election_funding version "0.1.1";
namespace "urn:us:irc:election_funding:clir";

use self::{
    FederalElectionCommission,
    IRC_S9002,
    IRC_S9003_D,
    IRC_S9004_C,
    IRC_S9004_D,
    IRC_S9004_E,
    IRC_S9007_A,
    IRC_S9008_B,
    IRC_S9008_C,
    IRC_S9008_E,
    IRC_S9008_G,
    IRC_S9009_B,
    IRC_S9010_A,
    IRC_S9010_B,
    IRC_S9010_C,
    IRC_S9010_D,
    Person,
    PoliticalParty,
    convention_account_balance,
    election_day,
    is_major_party,
    is_minor_party,
    payments_received,
    repayment_required,
    terminated_after_2014_04_03,
};

// =====================================================================
// §9002(2) last sentence and §9003(d): withdrawal by a candidate
// =====================================================================

entity GeneralElectionCandidate { label en unofficial "an individual candidate for President or Vice President in a presidential election (Chapter 95)"; }

relation ceased_actively_seeking_election_in_more_than_one_state(c: GeneralElectionCandidate) kind empirical {
    label en unofficial "the individual has ceased actively to seek election to the office of President or Vice President in more than one State (section 9002(2), last sentence)";
}
relation ceased_to_be_candidate_9002_2(c: GeneralElectionCandidate) kind institutional {
    label en unofficial "the individual ceases to be a candidate as a result of the last sentence of section 9002(2)";
}
@source(IRC_S9002, relation = formalizes, coverage = partial, quote = "The term \"candidate\" shall not include any individual who has ceased actively to seek election to the office of President of the United States or to the office of Vice President of the United States, in more than one State.")
rule S9002CeasedToBeCandidate strict {
    for c: GeneralElectionCandidate;
    when ceased_actively_seeking_election_in_more_than_one_state(c);
    then ceased_to_be_candidate_9002_2(c);
}

relation ceased_to_be_candidate_on(c: GeneralElectionCandidate, d: Date) kind empirical {
    label en unofficial "the date upon which the individual ceases to be a candidate (section 9003(d)(2))";
}
relation payments_9006_ended_for_candidate(c: GeneralElectionCandidate) kind institutional {
    label en unofficial "section 9003(d)(1): the individual is no longer eligible to receive any payments under section 9006 (subject to the expense exception)";
}
@source(IRC_S9003_D, relation = formalizes, coverage = partial, quote = "shall no longer be eligible to receive any payments under section 9006")
rule S9003dEligibilityEnded strict {
    for c: GeneralElectionCandidate;
    when ceased_to_be_candidate_9002_2(c);
    then payments_9006_ended_for_candidate(c);
}
relation expense_incurred_while_actively_seeking_in_more_than_one_state(c: GeneralElectionCandidate, amount: Money) kind empirical {
    label en unofficial "a qualified campaign expense incurred while actively seeking election to the office of President or Vice President in more than one State (section 9003(d)(1))";
}
relation payment_9006_still_receivable_for_expense(c: GeneralElectionCandidate, amount: Money) kind institutional {
    label en unofficial "section 9003(d)(1) exception: the individual remains eligible for section 9006 payments to defray this qualified campaign expense";
}
@source(IRC_S9003_D, relation = formalizes, coverage = partial, quote = "except that such individual shall be eligible to receive payments under such section to defray qualified campaign expenses incurred while actively seeking election to the office of President of the United States or to the office of Vice President of the United States in more than one State")
rule S9003dExpenseException strict {
    for c: GeneralElectionCandidate;
    for amount: Money;
    when payments_9006_ended_for_candidate(c) and expense_incurred_while_actively_seeking_in_more_than_one_state(c, amount);
    then payment_9006_still_receivable_for_expense(c, amount);
}

relation payments_9006_received_by_candidate(c: GeneralElectionCandidate, amount: Money) kind empirical {
    label en unofficial "the aggregate of payments received by the individual under section 9006";
}
relation payments_9006_used_for_qualified_expenses(c: GeneralElectionCandidate, amount: Money) kind empirical {
    label en unofficial "the part of those payments used to defray qualified campaign expenses";
}
relation unused_9006_payments(c: GeneralElectionCandidate, amount: Money) kind institutional {
    label en unofficial "section 9003(d)(2): payments received under section 9006 that are not used to defray qualified campaign expenses";
}
@source(IRC_S9003_D, relation = formalizes, coverage = partial, quote = "an amount equal to the amount of payments received by such individual under section 9006 which are not used to defray qualified campaign expenses.")
rule S9003dUnusedPayments strict {
    for c: GeneralElectionCandidate;
    for received: Money;
    for used: Money;
    when ceased_to_be_candidate_9002_2(c) and payments_9006_received_by_candidate(c, received) and payments_9006_used_for_qualified_expenses(c, used) and received > used;
    then unused_9006_payments(c, received - used);
}
relation unused_9006_payments_repaid(c: GeneralElectionCandidate, amount: Money) kind empirical;
@source(IRC_S9003_D, relation = formalizes, coverage = partial, quote = "shall pay to the Secretary, as soon as practicable after the date upon which such individual ceases to be a candidate")
rule S9003dRepayDuty defeasible {
    for c: GeneralElectionCandidate;
    for amount: Money;
    for d: Date;
    when unused_9006_payments(c, amount) and ceased_to_be_candidate_on(c, d);
    then duty S9003dPayUnusedPayments {
        bearer c;
        beneficiary us.irc.core::Secretary;
        goal achievement {
            condition unused_9006_payments_repaid(c, amount);
            window [d, infinity]; // "as soon as practicable": no day count in the text
        }
    };
}

// =====================================================================
// §9004(c): restrictions on the use of payments
// =====================================================================

relation payments_used_to_defray_qualified_expenses(party: PoliticalParty, amount: Money) kind empirical {
    label en unofficial "the part of the section 9006 payments used to defray qualified campaign expenses of the eligible candidates or their authorized committees (section 9004(c)(1))";
}
relation payments_used_to_repay_loans_or_restore_funds(party: PoliticalParty, amount: Money) kind empirical {
    label en unofficial "the part used to repay loans the proceeds of which defrayed such expenses, or to restore funds used to defray them (section 9004(c)(2))";
}
relation payments_used_for_unpermitted_purpose(party: PoliticalParty, amount: Money) kind institutional {
    label en unofficial "payments received under section 9006 that were used for neither purpose permitted by section 9004(c)";
}
@source(IRC_S9004_C, relation = formalizes, coverage = exact, quote = "The eligible candidates of a political party shall be entitled to payments under subsection (a) only—")
rule S9004cUnpermittedUse strict {
    for party: PoliticalParty;
    for received: Money;
    for defrayed: Money;
    for repaid: Money;
    when payments_received(party, received) and payments_used_to_defray_qualified_expenses(party, defrayed) and payments_used_to_repay_loans_or_restore_funds(party, repaid) and received > defrayed + repaid;
    then payments_used_for_unpermitted_purpose(party, received - defrayed - repaid);
}
@source(IRC_S9004_C, relation = formalizes, coverage = exact, quote = "(2) to repay loans the proceeds of which were used to defray such qualified campaign expenses, or otherwise to restore funds (other than contributions to defray qualified campaign expenses received and expended by such candidates or such committees) used to defray such qualified campaign expenses.")
rule S9004cUseRestriction defeasible {
    for party: PoliticalParty;
    for amount: Money;
    when payments_used_for_unpermitted_purpose(party, amount);
    then prohibition S9004cNoUnpermittedUse {
        bearer party;
        beneficiary FederalElectionCommission;
        action payments_used_for_unpermitted_purpose(party, amount);
        window [-infinity, infinity];
    };
}

// =====================================================================
// §9004(d)-(e): expenditures from personal funds
// =====================================================================

enum FamilyRelation { Spouse; Child; Parent; Grandparent; Brother; HalfBrother; Sister; HalfSister; SpouseOfListedRelative; OtherRelative; }

relation family_relation_of_candidate(p: Person, party: PoliticalParty, kind: FamilyRelation) kind empirical {
    label en unofficial "the person's relation to the presidential candidate of the party";
}
relation immediate_family_of_candidate(p: Person, party: PoliticalParty) kind institutional {
    label en unofficial "section 9004(e): the person is the candidate's spouse, or a child, parent, grandparent, brother, half-brother, sister or half-sister of the candidate, or the spouse of such a person";
}
@source(IRC_S9004_E, relation = formalizes, coverage = exact, quote = "the term \"immediate family\" means a candidate's spouse, and any child, parent, grandparent, brother, half-brother, sister, or half-sister of the candidate, and the spouses of such persons.")
rule S9004eImmediateFamily strict {
    for p: Person;
    for party: PoliticalParty;
    for kind: FamilyRelation;
    when family_relation_of_candidate(p, party, kind) and kind != OtherRelative;
    then immediate_family_of_candidate(p, party);
}

relation presidential_candidate_person(p: Person, party: PoliticalParty) kind empirical;
relation vice_presidential_candidate_person(p: Person, party: PoliticalParty) kind empirical;
relation personal_funds_expenditure_item(party: PoliticalParty, item: Text, spender: Person, amount: Money) kind empirical {
    label en unofficial "a recorded knowing expenditure from personal funds in connection with the campaign for election to the office of President (by the candidate, by immediate family, or by the vice-presidential candidate)";
}
relation personal_funds_certified(party: PoliticalParty) kind empirical {
    label en unofficial "the candidate of the party has certified to the Commission, under penalty of perjury, that he will not knowingly make expenditures from personal funds in excess of $50,000 (section 9004(d))";
}
relation personal_funds_within_limit(party: PoliticalParty) kind institutional {
    label en unofficial "section 9004(d): the aggregate recorded personal-funds expenditures (candidate + immediate family + vice-presidential candidate) do not exceed $50,000";
}
@source(IRC_S9004_D, relation = formalizes, coverage = partial, quote = "in excess of, in the aggregate, $50,000. For purposes of this subsection, expenditures from personal funds made by a candidate of a major, minor, or new party for the office of Vice President shall be considered to be expenditures by the candidate of such party for the office of President.")
rule S9004dWithinLimit strict {
    for party: PoliticalParty;
    when personal_funds_certified(party)
        and sum(collect all a1: Money, i1: Text, s1: Person where personal_funds_expenditure_item(party, i1, s1, a1) and presidential_candidate_person(s1, party), empty: 0.00 USD)
          + sum(collect all a2: Money, i2: Text, s2: Person where personal_funds_expenditure_item(party, i2, s2, a2) and vice_presidential_candidate_person(s2, party), empty: 0.00 USD)
          + sum(collect all a3: Money, i3: Text, s3: Person, k3: FamilyRelation where personal_funds_expenditure_item(party, i3, s3, a3) and family_relation_of_candidate(s3, party, k3) and k3 != OtherRelative, empty: 0.00 USD) <= 50000 USD;
    then personal_funds_within_limit(party);
}
relation personal_funds_condition_met(party: PoliticalParty) kind institutional {
    label en unofficial "section 9004(d): the candidate has satisfied the personal-funds certification condition for eligibility to receive payments under section 9006";
}
@source(IRC_S9004_D, relation = formalizes, coverage = partial, quote = "In order to be eligible to receive any payment under section 9006, the candidate of a major, minor, or new party in an election for the office of President shall certify to the Commission, under penalty of perjury,")
rule S9004dCertification strict {
    for party: PoliticalParty;
    when personal_funds_certified(party);
    then power S9004dPersonalFundsCertificationPower {
        holder party;
        over FederalElectionCommission;
        exercise personal_funds_certified(party);
        valid_when personal_funds_within_limit(party);
        effect create(personal_funds_condition_met(party));
    };
}

// =====================================================================
// §9007(a): examination and audit after each presidential election
// =====================================================================

relation party_candidate_in_election(party: PoliticalParty, election: Text) kind empirical {
    label en unofficial "the party had candidates for President and Vice President in the presidential election";
}
relation audit_of_qualified_expenses_conducted(party: PoliticalParty, election: Text) kind empirical {
    label en unofficial "the Commission has conducted a thorough examination and audit of the party's candidates' qualified campaign expenses for the election";
}
@source(IRC_S9007_A, relation = formalizes, coverage = exact, quote = "After each presidential election, the Commission shall conduct a thorough examination and audit of the qualified campaign expenses of the candidates of each political party for President and Vice President.")
rule S9007aAuditDuty defeasible {
    for party: PoliticalParty;
    for election: Text;
    for d: Date;
    when election_day(election, d) and party_candidate_in_election(party, election);
    then duty S9007aConductExaminationAndAudit {
        bearer FederalElectionCommission;
        goal achievement {
            condition audit_of_qualified_expenses_conducted(party, election);
            window [d, infinity]; // "after each presidential election": no upper bound in the text
        }
    };
}

// =====================================================================
// §9008 (HISTORICAL; superseded by (i) for conventions after 2014-04-03)
// =====================================================================

relation convention_calendar_year_begins(party: PoliticalParty, d: Date) kind empirical {
    label en unofficial "January 1 of the calendar year in which the party's presidential nominating convention is held";
}
relation convention_payments_available_from(party: PoliticalParty, d: Date) kind institutional {
    label en unofficial "section 9008(e): July 1 of the calendar year immediately preceding the year of the convention";
}
@source(IRC_S9008_E, relation = formalizes, coverage = exact, quote = "may receive payments under subsection (b)(3) beginning on July 1 of the calendar year immediately preceding the calendar year in which a presidential nominating convention of the political party involved is held.")
rule S9008eAvailability strict {
    for party: PoliticalParty;
    for y: Date;
    for calendar_before_1: Date;
    when convention_calendar_year_begins(party, y) and (is_major_party(party) or is_minor_party(party)) and not_known(terminated_after_2014_04_03())
        and us.irc.core::civil_calendar_boundary_before(y, 6, us.irc.core::CalendarMonth, calendar_before_1);
    then convention_payments_available_from(party, calendar_before_1);
}

relation convention_certified_amount(party: PoliticalParty, amount: Money) kind empirical {
    label en unofficial "the amount the Commission certified to the Secretary for the national committee under section 9008(g)";
}
relation convention_committee_elects_payment(party: PoliticalParty) kind empirical {
    label en unofficial "the national committee elects to receive its entitlement under section 9008(b)";
}
relation convention_payment_limit(party: PoliticalParty, amount: Money) kind institutional {
    label en unofficial "section 9008(b)(4): payments are limited to the amounts in the committee's account at the time of payment";
}
@source(IRC_S9008_B, relation = formalizes, coverage = exact, quote = "Payments to the national committee of a major party or minor party under this subsection, from the account designated for such committee shall be limited to the amounts in such account at the time of payment.")
rule S9008b4PaymentLimit strict {
    for party: PoliticalParty;
    for certified: Money;
    for balance: Money;
    when convention_certified_amount(party, certified) and convention_account_balance(party, balance) and not_known(terminated_after_2014_04_03());
    then convention_payment_limit(party, min(certified, balance));
}
relation convention_payment_made(party: PoliticalParty, amount: Money) kind empirical;
@source(IRC_S9008_B, relation = formalizes, coverage = exact, quote = "Upon receipt of certification from the Commission under subsection (g), the Secretary shall make payments from the appropriate account maintained under subsection (a) to the national committee of a major party or minor party which elects to receive its entitlement under this subsection.")
rule S9008b3PaymentDuty defeasible {
    for party: PoliticalParty;
    for amount: Money;
    for start: Date;
    when convention_payment_limit(party, amount) and convention_committee_elects_payment(party) and convention_payments_available_from(party, start);
    then duty S9008b3PayConventionAmount {
        bearer us.irc.core::Secretary;
        beneficiary party;
        goal achievement {
            condition convention_payment_made(party, amount);
            window [start, infinity];
        }
    };
}

// (c): use of funds

relation convention_payments_received(party: PoliticalParty, amount: Money) kind empirical;
relation convention_payment_used_for_candidate_or_delegate_expenses(party: PoliticalParty, amount: Money) kind empirical {
    label en unofficial "a payment under section 9008(b) used to defray the expenses of a candidate or delegate participating in a presidential nominating convention";
}
relation convention_payment_used_to_defray_convention_expenses(party: PoliticalParty, amount: Money) kind empirical {
    label en unofficial "section 9008(c)(1): used to defray expenses incurred with respect to the convention by or on behalf of the national committee";
}
relation convention_payment_used_to_repay_or_restore(party: PoliticalParty, amount: Money) kind empirical {
    label en unofficial "section 9008(c)(2): used to repay loans that defrayed such expenses, or to restore funds used to defray them";
}
relation convention_payment_used_for_unpermitted_purpose(party: PoliticalParty, amount: Money) kind institutional;
@source(IRC_S9008_C, relation = formalizes, coverage = exact, quote = "No part of any payment made under subsection (b) shall be used to defray the expenses of any candidate or delegate who is participating in any presidential nominating convention.")
rule S9008cCandidateDelegateProhibition defeasible {
    for party: PoliticalParty;
    for amount: Money;
    when convention_payment_used_for_candidate_or_delegate_expenses(party, amount) and not_known(terminated_after_2014_04_03());
    then prohibition S9008cNoUseForCandidateOrDelegateExpenses {
        bearer party;
        beneficiary FederalElectionCommission;
        action convention_payment_used_for_candidate_or_delegate_expenses(party, amount);
        window [-infinity, infinity];
    };
}
@source(IRC_S9008_C, relation = formalizes, coverage = exact, quote = "Such payments shall be used only—")
rule S9008cUnpermittedUse strict {
    for party: PoliticalParty;
    for received: Money;
    for defrayed: Money;
    for repaid: Money;
    when convention_payments_received(party, received) and convention_payment_used_to_defray_convention_expenses(party, defrayed) and convention_payment_used_to_repay_or_restore(party, repaid) and received > defrayed + repaid and not_known(terminated_after_2014_04_03());
    then convention_payment_used_for_unpermitted_purpose(party, received - defrayed - repaid);
}
@source(IRC_S9008_C, relation = formalizes, coverage = exact, quote = "(2) to repay loans the proceeds of which were used to defray such expenses, or otherwise to restore funds (other than contributions to defray such expenses received by such committee) used to defray such expenses.")
rule S9008cUseRestriction defeasible {
    for party: PoliticalParty;
    for amount: Money;
    when convention_payment_used_for_unpermitted_purpose(party, amount);
    then prohibition S9008cNoUnpermittedUse {
        bearer party;
        beneficiary FederalElectionCommission;
        action convention_payment_used_for_unpermitted_purpose(party, amount);
        window [-infinity, infinity];
    };
}

// (d)(4): legal or accounting services are not convention expenditures (read as a deduction from the limit's comparand;
// see S9008ExpenditureWithinLimitHistorical in module 03)

relation legal_accounting_compensation_item(party: PoliticalParty, item: Text, payer_is_national_committee: Boolean, payer_is_regular_employer: Boolean, amount: Money) kind empirical {
    label en unofficial "compensation paid to an individual for legal or accounting services rendered to or on behalf of the party's national committee; who paid, and whether the payer is the individual's regular employer";
}

// (g): designation statement, verification and certification

relation convention_designation_statement_filed(party: PoliticalParty) kind empirical {
    label en unofficial "the major or minor party filed a statement with the Commission designating its national committee (section 9008(g))";
}
relation convention_statement_includes_required_information(party: PoliticalParty) kind empirical {
    label en unofficial "the statement includes the information required by section 303(b) of the Federal Election Campaign Act of 1971 and the additional information the Commission requires (EXTERNAL_DEPENDENCY on FECA and Commission forms, carried as a fact)";
}
relation national_committee_designated(party: PoliticalParty) kind institutional;
@source(IRC_S9008_G, relation = formalizes, coverage = partial, quote = "Any major party or minor party may file a statement with the Commission in such form and manner and at such times as it may require, designating the national committee of such party.")
rule S9008gDesignation strict {
    for party: PoliticalParty;
    when (is_major_party(party) or is_minor_party(party)) and convention_designation_statement_filed(party) and not_known(terminated_after_2014_04_03());
    then power S9008gDesignationPower {
        holder party;
        over FederalElectionCommission;
        exercise convention_designation_statement_filed(party);
        valid_when convention_statement_includes_required_information(party);
        effect create(national_committee_designated(party));
    };
}
relation convention_statement_verified_and_certified(party: PoliticalParty) kind empirical;
@source(IRC_S9008_G, relation = formalizes, coverage = partial, quote = "Upon receipt of a statement filed under the preceding sentences, the Commission promptly shall verify such statement according to such procedures and criteria as it may establish and shall certify to the Secretary for payment in full to any such committee of amounts to which such committee may be entitled under subsection (b).")
rule S9008gCertifyDuty defeasible {
    for party: PoliticalParty;
    when national_committee_designated(party);
    then duty S9008gVerifyAndCertify {
        bearer FederalElectionCommission;
        beneficiary party;
        goal achievement {
            condition convention_statement_verified_and_certified(party);
            window [-infinity, infinity]; // "promptly": no day count in the text
        }
    };
}
relation convention_certification_audit_conducted(party: PoliticalParty) kind empirical;
@source(IRC_S9008_G, relation = formalizes, coverage = partial, quote = "Such certifications shall be subject to an examination and audit which the Commission shall conduct no later than December 31, of the calendar year in which the presidential nominating convention involved is held.")
rule S9008gAuditDuty defeasible {
    for party: PoliticalParty;
    for y: Date;
    for calendar_before_1: Date;
    when convention_certified_amount(party, _) and convention_calendar_year_begins(party, y) and not_known(terminated_after_2014_04_03())
        and us.irc.core::civil_calendar_boundary_before(add_calendar_period(y, 1 calendar_year), 1, us.irc.core::CalendarDay, calendar_before_1);
    then duty S9008gAuditCertification {
        bearer FederalElectionCommission;
        goal achievement {
            condition convention_certification_audit_conducted(party);
            window [-infinity, calendar_before_1];
        }
    };
}

// =====================================================================
// §9009(b) and §9010: powers of the Commission
// =====================================================================

external judgment relation commission_deems_necessary_9009b(party: PoliticalParty) {
    authority FederalElectionCommission;
    label en official "the Commission deems it necessary to carry out the functions and duties imposed on it by Chapter 95 (section 9009(b))";
}
relation additional_examination_exercised(party: PoliticalParty) kind empirical;
relation investigation_exercised(party: PoliticalParty) kind empirical;
relation records_requirement_exercised(party: PoliticalParty) kind empirical;
relation additional_examination_authorized(party: PoliticalParty) kind institutional;
relation investigation_authorized(party: PoliticalParty) kind institutional;
relation records_requirement_effective(party: PoliticalParty) kind institutional;
@source(IRC_S9009_B, relation = formalizes, coverage = partial, quote = "to conduct such examinations and audits (in addition to the examinations and audits required by section 9007(a))")
rule S9009bAdditionalExamination strict {
    for party: PoliticalParty;
    when additional_examination_exercised(party);
    then power S9009bAdditionalExaminationPower {
        holder FederalElectionCommission;
        over party;
        exercise additional_examination_exercised(party);
        valid_when commission_deems_necessary_9009b(party);
        effect create(additional_examination_authorized(party));
    };
}
@source(IRC_S9009_B, relation = formalizes, coverage = partial, quote = "to conduct such investigations")
rule S9009bInvestigation strict {
    for party: PoliticalParty;
    when investigation_exercised(party);
    then power S9009bInvestigationPower {
        holder FederalElectionCommission;
        over party;
        exercise investigation_exercised(party);
        valid_when commission_deems_necessary_9009b(party);
        effect create(investigation_authorized(party));
    };
}
@source(IRC_S9009_B, relation = formalizes, coverage = partial, quote = "and to require the keeping and submission of such books, records, and information")
rule S9009bRecordsRequirement strict {
    for party: PoliticalParty;
    when records_requirement_exercised(party);
    then power S9009bRecordsRequirementPower {
        holder FederalElectionCommission;
        over party;
        exercise records_requirement_exercised(party);
        valid_when commission_deems_necessary_9009b(party);
        effect create(records_requirement_effective(party));
    };
}

// §9010(a): appearance by counsel

relation action_filed_under_9011(action_id: Text) kind empirical {
    label en unofficial "an action filed under section 9011 (judicial review of Commission certifications and determinations)";
}
relation commission_appears_in_9011_action(action_id: Text) kind empirical;
relation commission_defends_action(action_id: Text) kind institutional;
@source(IRC_S9010_A, relation = formalizes, coverage = partial, quote = "The Commission is authorized to appear in and defend against any action filed under section 9011")
rule S9010aAppearAndDefend strict {
    for action_id: Text;
    when commission_appears_in_9011_action(action_id);
    then power S9010aAppearAndDefendPower {
        holder FederalElectionCommission;
        over action_id;
        exercise commission_appears_in_9011_action(action_id);
        valid_when action_filed_under_9011(action_id);
        effect create(commission_defends_action(action_id));
    };
}
relation commission_appoints_counsel(counsel: Person) kind empirical;
relation counsel_authorized_outside_title_5_competitive_service(counsel: Person) kind institutional {
    label en unofficial "section 9010(a): counsel appointed without regard to the title 5 competitive-service provisions, compensation fixed without regard to chapter 51 and subchapter III of chapter 53";
}
@source(IRC_S9010_A, relation = formalizes, coverage = partial, quote = "or by counsel whom it may appoint without regard to the provisions of title 5, United States Code, governing appointments in the competitive service")
rule S9010aAppointCounsel strict {
    for counsel: Person;
    when commission_appoints_counsel(counsel);
    then power S9010aAppointCounselPower {
        holder FederalElectionCommission;
        over counsel;
        exercise commission_appoints_counsel(counsel);
        valid_when commission_appoints_counsel(counsel);
        effect create(counsel_authorized_outside_title_5_competitive_service(counsel));
    };
}

// §9010(b): recovery of payments determined payable under §9007

relation commission_recovery_action_filed(party: PoliticalParty, amount: Money) kind empirical;
relation recovery_action_pending(party: PoliticalParty, amount: Money) kind institutional;
@source(IRC_S9010_B, relation = formalizes, coverage = exact, quote = "The Commission is authorized through attorneys and counsel described in subsection (a) to appear in the district courts of the United States to seek recovery of any amounts determined to be payable to the Secretary of the Treasury as a result of examination and audit made pursuant to section 9007.")
rule S9010bRecoveryAction strict {
    for party: PoliticalParty;
    for amount: Money;
    when commission_recovery_action_filed(party, amount);
    then power S9010bRecoveryActionPower {
        holder FederalElectionCommission;
        over party;
        exercise commission_recovery_action_filed(party, amount);
        valid_when repayment_required(party, amount);
        effect create(recovery_action_pending(party, amount));
    };
}

// §9010(c): declaratory and injunctive relief; three-judge court; direct appeal

relation civil_matter_covered_by_subtitle_h_or_6096(action_id: Text) kind empirical {
    label en unofficial "the action concerns a civil matter covered by the provisions of Subtitle H or section 6096";
}
relation commission_relief_petition_filed(action_id: Text) kind empirical;
relation relief_petition_pending(action_id: Text) kind institutional;
@source(IRC_S9010_C, relation = formalizes, coverage = partial, quote = "The Commission is authorized through attorneys and counsel described in subsection (a) to petition the courts of the United States for declaratory or injunctive relief concerning any civil matter covered by the provisions of this subtitle or section 6096.")
rule S9010cReliefPetition strict {
    for action_id: Text;
    when commission_relief_petition_filed(action_id);
    then power S9010cReliefPetitionPower {
        holder FederalElectionCommission;
        over action_id;
        exercise commission_relief_petition_filed(action_id);
        valid_when civil_matter_covered_by_subtitle_h_or_6096(action_id);
        effect create(relief_petition_pending(action_id));
    };
}
relation heard_by_three_judge_court_under_28_usc_2284(action_id: Text) kind institutional;
relation appeal_lies_to_supreme_court(action_id: Text) kind institutional;
@source(IRC_S9010_C, relation = formalizes, coverage = partial, quote = "Upon application of the Commission an action brought pursuant to this subsection shall be heard and determined by a court of three judges in accordance with the provisions of section 2284 of title 28, United States Code")
rule S9010cThreeJudgeCourt strict {
    for action_id: Text;
    when relief_petition_pending(action_id);
    then heard_by_three_judge_court_under_28_usc_2284(action_id);
}
@source(IRC_S9010_C, relation = formalizes, coverage = partial, quote = "and any appeal shall lie to the Supreme Court.")
rule S9010cDirectAppeal strict {
    for action_id: Text;
    when relief_petition_pending(action_id);
    then appeal_lies_to_supreme_court(action_id);
}

// §9010(d): appeal and certiorari

relation judgment_entered_in_action_where_commission_appears(action_id: Text) kind empirical;
relation commission_appeal_taken(action_id: Text) kind empirical;
relation commission_certiorari_petition_filed(action_id: Text) kind empirical;
relation commission_appeal_pending(action_id: Text) kind institutional;
relation commission_certiorari_petition_pending(action_id: Text) kind institutional;
@source(IRC_S9010_D, relation = formalizes, coverage = partial, quote = "The Commission is authorized on behalf of the United States to appeal from")
rule S9010dAppeal strict {
    for action_id: Text;
    when commission_appeal_taken(action_id);
    then power S9010dAppealPower {
        holder FederalElectionCommission;
        over action_id;
        exercise commission_appeal_taken(action_id);
        valid_when judgment_entered_in_action_where_commission_appears(action_id);
        effect create(commission_appeal_pending(action_id));
    };
}
@source(IRC_S9010_D, relation = formalizes, coverage = partial, quote = "and to petition the Supreme Court for certiorari to review, judgments or decrees entered with respect to actions in which it appears pursuant to the authority provided in this section.")
rule S9010dCertiorari strict {
    for action_id: Text;
    when commission_certiorari_petition_filed(action_id);
    then power S9010dCertiorariPower {
        holder FederalElectionCommission;
        over action_id;
        exercise commission_certiorari_petition_filed(action_id);
        valid_when judgment_entered_in_action_where_commission_appears(action_id);
        effect create(commission_certiorari_petition_pending(action_id));
    };
}
