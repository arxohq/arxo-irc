        assert repaid_amount(entity_ref("urn:us:irc:election_funding:clir#PartyA"), 1000000 USD) { id "f2"; origin case_input; }
    }
    evaluate positions();
    expect position(S9007RepayRequiredAmount, SATISFIED);
}

