// Scenarios for §9007(b)-(d)/§9038(b)-(d) (repayment determinations as
// powers), §9009/§9039 (reports/rulemaking), §9041 (judicial review),
// §9012/§9042 (offenses). NOT executed (NO-HEAVY-CHECKS) —
// implemented_unverified.

language "law.core" version "0.2";
package us.irc.election_funding version "0.1.1";
namespace "urn:us:irc:election_funding:clir";

test "S9007b1-01-EXCESS-PAYMENT-POWER-VALID" {
    given {
        context { decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; legal_time @2026-01-15; timezone "America/New_York"; }
        assert payments_received(entity_ref("urn:us:irc:election_funding:clir#PartyA"), 21000000 USD) { id "f0"; origin case_input; }
        assert entitled_amount(entity_ref("urn:us:irc:election_funding:clir#PartyA"), 20000000 USD) { id "f1"; origin case_input; }
    }
    evaluate truth(repayment_required(entity_ref("urn:us:irc:election_funding:clir#PartyA"), 1000000 USD));
    expect truth_status == TRUE_ONLY;
}

