// Scenarios for §9005/§9036 (certification), §9006/§9037 (Fund/Account
// payments), §9008 (conventions — historical machinery + the (i)
// termination that is actually operative today). NOT executed
// (NO-HEAVY-CHECKS) — implemented_unverified.

language "law.core" version "0.2";
package us.irc.election_funding version "0.1.1";
namespace "urn:us:irc:election_funding:clir";

test "S9005-01-ALL-CONDITIONS-MET-MAJOR-PARTY" {
    given {
        context { decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; legal_time @2026-01-15; timezone "America/New_York"; }
        assert candidates_agree_to_audit(entity_ref("urn:us:irc:election_funding:clir#PartyA")) { id "f0"; origin case_input; }
        assert preceding_election_vote_share(entity_ref("urn:us:irc:election_funding:clir#PartyA"), 0.40) { id "f1"; origin case_input; }
        assert major_party_certified(entity_ref("urn:us:irc:election_funding:clir#PartyA")) { id "f2"; origin case_input; }
        assert major_party_certification_content_true(entity_ref("urn:us:irc:election_funding:clir#PartyA")) { id "f3"; origin case_input; }
    }
    evaluate truth(all_9003_conditions_met(entity_ref("urn:us:irc:election_funding:clir#PartyA")));
    expect truth_status == TRUE_ONLY;
}

test "S9005-02-CERTIFICATION-DUTY-SATISFIED" {
    given {
        context { decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; legal_time @2026-01-15; timezone "America/New_York"; }
        assert candidates_agree_to_audit(entity_ref("urn:us:irc:election_funding:clir#PartyA")) { id "f0"; origin case_input; }
        assert preceding_election_vote_share(entity_ref("urn:us:irc:election_funding:clir#PartyA"), 0.40) { id "f1"; origin case_input; }
        assert major_party_certified(entity_ref("urn:us:irc:election_funding:clir#PartyA")) { id "f2"; origin case_input; }
        assert major_party_certification_content_true(entity_ref("urn:us:irc:election_funding:clir#PartyA")) { id "f3"; origin case_input; }
        assert major_party_expenditure_limitation(20000000 USD) { id "f4"; origin case_input; }
        assert personal_funds_certified(entity_ref("urn:us:irc:election_funding:clir#PartyA")) { id "f6"; origin case_input; } // stage 3: the section 9004(d) condition now gates the certification duty
        assert certification_amount(entity_ref("urn:us:irc:election_funding:clir#PartyA"), 20000000 USD) { id "f5"; origin case_input; }
    }
    evaluate positions();
    expect position(S9005Certify10Days, SATISFIED);
}

