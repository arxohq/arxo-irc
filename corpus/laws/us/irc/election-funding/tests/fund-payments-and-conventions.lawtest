        assert major_party_certified(entity_ref("urn:us:irc:election_funding:clir#PartyA")) { id "f1"; origin case_input; }
        assert major_party_certification_content_true(entity_ref("urn:us:irc:election_funding:clir#PartyA")) { id "f2"; origin case_input; }
        assert major_party_expenditure_limitation(20000000 USD) { id "f3"; origin case_input; }
        assert total_entitlements_all_parties(40000000 USD) { id "f4"; origin case_input; }
        assert fund_amount_available(20000000 USD) { id "f5"; origin case_input; }
        assert fund_insufficient(PresidentialElectionCampaignFund) { id "f6"; origin case_input; }
    }
    evaluate truth(pro_rata_share(entity_ref("urn:us:irc:election_funding:clir#PartyA"), 10000000.00 USD));
    expect truth_status == TRUE_ONLY;
}

