test "S9033-01-STATE-MEETS-5000-THRESHOLD" {
    given {
        context { decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; legal_time @2026-01-15; timezone "America/New_York"; }
        assert state_matching_total(entity_ref("urn:us:irc:election_funding:clir#C1"), "Iowa", 5001 USD) { id "f0"; origin case_input; }
    }
    evaluate truth(state_meets_5000_threshold(entity_ref("urn:us:irc:election_funding:clir#C1"), "Iowa"));
    expect truth_status == TRUE_ONLY;
}

test "S9033-02-STATE-AT-EXACTLY-5000-DOES-NOT-MEET-THRESHOLD" {
