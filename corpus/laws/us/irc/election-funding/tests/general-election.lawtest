test "S9004-01-MAJOR-PARTY-ENTITLEMENT-EQUALS-FECA-LIMITATION" {
    given {
        context { decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; legal_time @2026-01-15; timezone "America/New_York"; }
        assert preceding_election_vote_share(entity_ref("urn:us:irc:election_funding:clir#PartyA"), 0.40) { id "f0"; origin case_input; }
        assert major_party_certified(entity_ref("urn:us:irc:election_funding:clir#PartyA")) { id "f1"; origin case_input; }
        assert major_party_certification_content_true(entity_ref("urn:us:irc:election_funding:clir#PartyA")) { id "f2"; origin case_input; }
        assert major_party_expenditure_limitation(20000000 USD) { id "f3"; origin case_input; }
    }
    evaluate truth(major_party_entitlement(entity_ref("urn:us:irc:election_funding:clir#PartyA"), 20000000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S9004-02-MINOR-PARTY-VOTE-RATIO-INTERMEDIATE-VALUE" {
    given {
        context { decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; legal_time @2026-01-15; timezone "America/New_York"; }
        assert minor_party_own_election_votes(entity_ref("urn:us:irc:election_funding:clir#PartyC"), 1000000) { id "f0"; origin case_input; }
        assert average_major_party_votes(10000000) { id "f1"; origin case_input; }
    }
    evaluate truth(minor_party_vote_ratio(entity_ref("urn:us:irc:election_funding:clir#PartyC"), 0.1));
    expect truth_status == TRUE_ONLY;
}

test "S9004-03-MINOR-PARTY-ENTITLEMENT-FROM-RATIO" {
    given {
        context { decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; legal_time @2026-01-15; timezone "America/New_York"; }
        assert preceding_election_vote_share(entity_ref("urn:us:irc:election_funding:clir#PartyC"), 0.10) { id "f0"; origin case_input; }
        assert minor_or_new_party_certified(entity_ref("urn:us:irc:election_funding:clir#PartyC")) { id "f1"; origin case_input; }
        assert minor_or_new_party_certification_content_true(entity_ref("urn:us:irc:election_funding:clir#PartyC")) { id "f2"; origin case_input; }
        assert minor_party_own_election_votes(entity_ref("urn:us:irc:election_funding:clir#PartyC"), 1000000) { id "f3"; origin case_input; }
        assert average_major_party_votes(10000000) { id "f4"; origin case_input; }
        assert exists_major_party_amount(20000000 USD) { id "f5"; origin case_input; }
    }
    evaluate truth(minor_party_entitlement(entity_ref("urn:us:irc:election_funding:clir#PartyC"), 2000000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S9004-04-LIMITATION-IS-LOWER-OF-TWO-AMOUNTS" {
    given {
        context { decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; legal_time @2026-01-15; timezone "America/New_York"; }
        assert qualified_expenses_less_contributions(entity_ref("urn:us:irc:election_funding:clir#PartyC"), 1500000 USD) { id "f0"; origin case_input; }
        assert exists_major_party_amount(20000000 USD) { id "f1"; origin case_input; }
        assert contributions_received(entity_ref("urn:us:irc:election_funding:clir#PartyC"), 0 USD) { id "f2"; origin case_input; }
    }
    evaluate truth(limited_entitlement(entity_ref("urn:us:irc:election_funding:clir#PartyC"), 1500000 USD));
    expect truth_status == TRUE_ONLY;
}

