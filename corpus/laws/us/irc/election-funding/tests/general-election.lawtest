// Scenarios for Chapter 95 (§§9001-9007). NOT executed (NO-HEAVY-CHECKS) —
// implemented_unverified.

language "law.core" version "0.2";
package us.irc.election_funding version "0.1.1";
namespace "urn:us:irc:election_funding:clir";

test "S9002-01-MAJOR-PARTY-AT-25-PERCENT" {
    given {
        context { decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; legal_time @2026-01-15; timezone "America/New_York"; }
        assert preceding_election_vote_share(entity_ref("urn:us:irc:election_funding:clir#PartyA"), 0.25) { id "f0"; origin case_input; }
    }
    evaluate truth(is_major_party(entity_ref("urn:us:irc:election_funding:clir#PartyA")));
    expect truth_status == TRUE_ONLY;
}

test "S9002-02-MINOR-PARTY-JUST-BELOW-25-PERCENT" {
