// 26 U.S.C. §9007(b)-(d) / §9038(b)-(c) (repayment determinations as
// Commission POWERS, the 3-year notification window, deposit of
// repayments), §9009/§9039 (reports to Congress; rulemaking), §9012/§9042
// (criminal penalties — offense classification, mental element via
// DECISION-0194 as `us.irc.crimes` does), §9041 (judicial review, same
// non_normative shape as §9011).
//
// JUDGMENT CALLS:
//  - §9007(b)(1)-(4)/§9038(b)(1)-(2): each Commission repayment
//    DETERMINATION is a `power` (the Commission's own act of determining
//    and notifying), `valid_when` the underlying excess/misuse condition is
//    an exact comparison over case-supplied amounts, `effect` creates the
//    repayment duty. This is the coordinator's own instruction ("repayment
//    determinations as powers"); stage 1 had modelled the determination as
//    a plain `strict` classification rule feeding the duty directly — this
//    stage 1b REPLACES that with the power shape for §9007(b)(1) and
//    extends it to §9007(b)(2)-(4) and §9038(b)(2), matching the pattern
//    end to end.
//  - No 90-day repayment window: the coordinator's instruction says "the
//    repayment duty within 90 days per the text" — the pinned §9007(b)/
//    §9038(b) text was read in full for this stage and contains NO day-
//    count at all for the repayment itself ("shall pay to the Secretary an
//    amount equal to such amount", no deadline stated); the only day-counts
//    in either section are the §9007(c)/§9038(c) 3-YEAR notification
//    windows, already modelled. Per AGENT-BRIEF ("Never invent a rate, a
//    date or a threshold... a missing value is MISSING_PARAMETER_VALUE, not
//    zero") this package does NOT assert a 90-day repayment window that is
//    not in the text; the repayment duty keeps the open-ended window used
//    throughout this corpus for repayment duties with no stated deadline
//    (e.g. trust-funds' advance-repayment duty). Flagged here, in HANDOFF,
//    and in the report, rather than silently complying with an instruction
//    that conflicts with the pinned source.
//  - §9009(b)/(c) and §9039(b)/(c) (rulemaking: a Congressional 30-
//    legislative-day review window before a rule/regulation takes effect)
//    is modelled as an exact comparison over a case-supplied legislative-
//    day count (this package does not compute "legislative days" from a
//    session calendar — that is a distinct calendar primitive from the
//    federal-holiday business-day calendar `administration` owns, and is
//    not attempted here: TECH_GAP, TECH-GAPS.md G225).
//  - §9012/§9042: EVERY offense in both sections shares the SAME single
//    mental element, "knowingly and willfully" (or, for one clause of
//    §9012(f)/§9042(a)'s second sentence, "knowingly" alone) — unlike
//    `us.irc.crimes`, which channels several DIFFERENT named elements
//    (willfully / corruptly / intent to defraud / intent to evade). This
//    package therefore declares ONE `external judgment relation
//    knowingly_and_willfully_established(o: Offense) { authority Court; }`
//    (plus a separate `knowingly_established` for the narrower "knowingly"
//    clauses), not the crimes package's four-relation family — the SHAPE
//    (Offense entity, elements as a court-found DECISION-0194 channel,
//    `offense_elements_established` never derived from conduct alone,
//    punishment as a recorded ceiling REFERENCE, not a sentence) is ported
//    exactly; the vocabulary is not, because chapter 95/96's own text does
//    not name multiple distinct elements the way chapter 75 does.
//  - Punishment (fine/imprisonment ceilings) is recorded institutionally
//    (the STATED ceiling, exact numbers from the text) but the actual
//    sentence a court imposes up to that ceiling is EXTERNAL_DEPENDENCY —
//    identical convention to `us.irc.crimes`' own module header.
//  - §9041 is Judicial review, NOT a penalty section (the coordinator's
//    message grouped it with the penalty sections, but the pinned text is
//    unambiguous: §9041's heading is "Judicial review" and its content
//    mirrors §9011 verbatim in structure). Modelled the same way §9011 was
//    in stage 1: NON_NORMATIVE (a procedural cross-reference to 5 U.S.C.
//    chapter 7, no independent institutional effect this package derives),
//    not an offense classification. Likewise §9009/§9039 are Reports-to-
//    Congress/rulemaking sections, not offenses — modelled as duties/powers
//    above, not folded into the Offense shape.

language "law.core" version "0.2";
package us.irc.election_funding version "0.1.1";
namespace "urn:us:irc:election_funding:clir";

use self::{
    FederalElectionCommission,
    IRC_S9007_B,
    IRC_S9007_C,
    IRC_S9007_D,
    IRC_S9009_A,
    IRC_S9009_C,
    IRC_S9012_A,
    IRC_S9012_B,
    IRC_S9012_C,
    IRC_S9012_D,
    IRC_S9012_E,
    IRC_S9012_F,
    IRC_S9012_G,
    IRC_S9038_B,
    IRC_S9038_D,
    IRC_S9039_A,
    IRC_S9039_C,
    IRC_S9041_A,
    IRC_S9042_A,
    IRC_S9042_B,
    IRC_S9042_C,
    IRC_S9042_D,
    Organ,
    Person,
    PoliticalParty,
    PrimaryCandidate,
    entitled_amount,
    excess_payment_determined,
    is_major_party,
    payments_received,
};

// ============== §9007(b)-(d) / §9038(b)-(c): repayment determinations ==========

relation excess_payment_amount_claimed(party: PoliticalParty, amount: Money) kind empirical {
    label en unofficial "the Commission's own candidate figure for the excess-payment determination — the exercise of the §9007(b)(1) power";
}
@source(IRC_S9007_B, relation = formalizes, coverage = partial, quote = "If the Commission determines that any portion of the payments made to the eligible candidates of a political party under section 9006 was in excess of the aggregate payments to which candidates were entitled under section 9004")
rule S9007ExcessPaymentDeterminationPower strict {
    for party: PoliticalParty;
    for received: Money;
    for entitled: Money;
    when payments_received(party, received) and entitled_amount(party, entitled) and received > entitled;
    then power S9007ExcessPaymentPower {
        holder FederalElectionCommission;
        over party;
        exercise excess_payment_amount_claimed(party, received - entitled);
        valid_when excess_payment_determined(party, received - entitled);
        effect create(repayment_required(party, received - entitled));
    };
}
relation repayment_required(party: PoliticalParty, amount: Money) kind institutional;

relation excess_expenses_claimed(party: PoliticalParty, incurred: Money, major_amount: Money) kind empirical {
    label en unofficial "§9007(b)(2): qualified campaign expenses incurred in excess of the major-party §9004 entitlement";
}
relation excess_expenses_determined(party: PoliticalParty, excess: Money) kind institutional {
    label en unofficial "classification: qualified campaign expenses incurred exceed the major-party §9004 entitlement — the §9007(b)(2) power's own valid_when condition";
}
@source(IRC_S9007_B, relation = formalizes, coverage = partial, quote = "If the Commission determines that the eligible candidates of a political party and their authorized committees incurred qualified campaign expenses in excess of the aggregate payments to which the eligible candidates of a major party were entitled under section 9004")
rule S9007ExcessExpensesClassification strict {
    for party: PoliticalParty;
    for incurred: Money;
    for major_amount: Money;
    when excess_expenses_claimed(party, incurred, major_amount) and incurred > major_amount;
    then excess_expenses_determined(party, incurred - major_amount);
}
@source(IRC_S9007_B, relation = formalizes, coverage = partial, quote = "If the Commission determines that the eligible candidates of a political party and their authorized committees incurred qualified campaign expenses in excess of the aggregate payments to which the eligible candidates of a major party were entitled under section 9004")
rule S9007ExcessExpensesDeterminationPower strict {
    for party: PoliticalParty;
    for excess: Money;
    when excess_expenses_determined(party, excess);
    then power S9007ExcessExpensesPower {
        holder FederalElectionCommission;
        over party;
        exercise excess_expenses_determined(party, excess);
        valid_when excess_expenses_determined(party, excess);
        effect create(repayment_required(party, excess));
    };
}

relation disallowed_contributions_accepted(party: PoliticalParty, amount: Money) kind empirical {
    label en unofficial "§9007(b)(3): contributions accepted by a major party's eligible candidates other than to make up a §9006(c) deficiency — a case-supplied classification, the §9002(11)(C)/§9006(c) exclusions folded into the fact itself";
}
@source(IRC_S9007_B, relation = formalizes, coverage = partial, quote = "If the Commission determines that the eligible candidates of a major party or any authorized committee of such candidates accepted contributions (other than contributions to make up deficiencies in payments out of the fund on account of the application of section 9006(c))")
rule S9007DisallowedContributionsDetermination strict {
    for party: PoliticalParty;
    for amount: Money;
    when disallowed_contributions_accepted(party, amount) and is_major_party(party);
    then power S9007DisallowedContributionsPower {
        holder FederalElectionCommission;
        over party;
        exercise disallowed_contributions_accepted(party, amount);
        valid_when disallowed_contributions_accepted(party, amount);
        effect create(repayment_required(party, amount));
    };
}

relation misused_payment_amount(party: PoliticalParty, amount: Money) kind empirical {
    label en unofficial "§9007(b)(4): a payment amount used for a purpose other than defraying qualified campaign expenses or repaying/restoring loans used for such expenses";
}
@source(IRC_S9007_B, relation = formalizes, coverage = partial, quote = "If the Commission determines that any amount of any payment made to the eligible candidates of a political party under section 9006 was used for any purpose other than")
rule S9007MisusedPaymentDetermination strict {
    for party: PoliticalParty;
    for amount: Money;
    when misused_payment_amount(party, amount);
    then power S9007MisusedPaymentPower {
        holder FederalElectionCommission;
        over party;
        exercise misused_payment_amount(party, amount);
        valid_when misused_payment_amount(party, amount);
        effect create(repayment_required(party, amount));
    };
}

relation aggregate_repayments_required(party: PoliticalParty, total: Money) kind empirical {
    label en unofficial "the running total of amounts already required from the party under this subsection — the (5) ceiling's own comparator (this package does not sum repayment_required facts itself; the total is a case-supplied aggregate, same no-aggregation judgment call as elsewhere in this corpus)";
}
relation total_payments_received_9006(party: PoliticalParty, amount: Money) kind empirical;
relation repayment_capped_at_payments_received(party: PoliticalParty) kind institutional {
    label en unofficial "§9007(b)(5): no further repayment is required once the aggregate required equals the amount the party actually received under §9006";
}
@source(IRC_S9007_B, relation = formalizes, coverage = exact, quote = "No payment shall be required from the eligible candidates of a political party under this subsection to the extent that such payment, when added to other payments required from such candidates under this subsection, exceeds the amount of payments received by such candidates under section 9006.")
rule S9007RepaymentCap strict {
    for party: PoliticalParty;
    for total: Money;
    for received: Money;
    when aggregate_repayments_required(party, total) and total_payments_received_9006(party, received) and total >= received;
    then repayment_capped_at_payments_received(party);
}

relation repaid_amount(party: PoliticalParty, amount: Money) kind empirical;
@source(IRC_S9007_B, relation = formalizes, coverage = partial, quote = "it shall so notify such candidates, and such candidates shall pay to the Secretary of the Treasury an amount equal to such portion.")
rule S9007RepaymentDutyFromRequirement defeasible {
    for party: PoliticalParty;
    for amount: Money;
    when repayment_required(party, amount);
    then duty S9007RepayRequiredAmount {
        bearer party;
        beneficiary us.irc.core::Secretary;
        goal achievement {
            condition repaid_amount(party, amount);
            window [-infinity, infinity]; // see module header: no 90-day (or any) window is stated in the pinned text for the repayment itself
        }
    };
}

relation election_day(election: Text, day: Date) kind empirical;
relation notification_made_on_9007(election: Text, notified_on: Date) kind empirical;
relation notification_more_than_3_years_after_election(election: Text, notified_on: Date) kind institutional {
    label en unofficial "§9007(c): no notification may be made more than 3 years after the day of the presidential election";
}
@source(IRC_S9007_C, relation = formalizes, coverage = exact, quote = "No notification shall be made by the Commission under subsection (b) with respect to a presidential election more than 3 years after the day of such election.")
rule S9007NotificationWindowExpired strict {
    for election: Text;
    for day: Date;
    for notified_on: Date;
    when election_day(election, day) and notification_made_on_9007(election, notified_on) and notified_on > add_calendar_period(day, 3 calendar_year);
    then notification_more_than_3_years_after_election(election, notified_on);
}

relation repayment_deposited_general_fund(party: PoliticalParty, amount: Money) kind institutional;
@source(IRC_S9007_D, relation = formalizes, coverage = exact, quote = "All payments received by the Secretary of the Treasury under subsection (b) shall be deposited by him in the general fund of the Treasury.")
rule S9007DepositRepayment strict {
    for party: PoliticalParty;
    for amount: Money;
    when repaid_amount(party, amount);
    then repayment_deposited_general_fund(party, amount);
}

// (Chapter 96 mirror: §9038(b)(2), (d) — (b)(1)/(c) already modelled stage 1)

relation misused_matching_payment_amount(c: PrimaryCandidate, amount: Money) kind empirical;
relation matching_repayment_required(c: PrimaryCandidate, amount: Money) kind institutional;
@source(IRC_S9038_B, relation = formalizes, coverage = partial, quote = "If the Commission determines that any amount of any payment made to a candidate from the matching payment account was used for any purpose other than")
rule S9038MisusedPaymentDetermination strict {
    for c: PrimaryCandidate;
    for amount: Money;
    when misused_matching_payment_amount(c, amount);
    then power S9038MisusedPaymentPower {
        holder FederalElectionCommission;
        over c;
        exercise misused_matching_payment_amount(c, amount);
        valid_when misused_matching_payment_amount(c, amount);
        effect create(matching_repayment_required(c, amount));
    };
}
relation matching_repaid_amount(c: PrimaryCandidate, amount: Money) kind empirical;
@source(IRC_S9038_B, relation = formalizes, coverage = partial, quote = "it shall notify such candidate of the amount so used, and the candidate shall pay to the Secretary an amount equal to such amount.")
rule S9038RepaymentDutyFromRequirement defeasible {
    for c: PrimaryCandidate;
    for amount: Money;
    when matching_repayment_required(c, amount);
    then duty S9038RepayRequiredAmount {
        bearer c;
        beneficiary us.irc.core::Secretary;
        goal achievement {
            condition matching_repaid_amount(c, amount);
            window [-infinity, infinity]; // same no-90-day-window note
        }
    };
}
relation matching_repayment_deposited(c: PrimaryCandidate, amount: Money) kind institutional;
@source(IRC_S9038_D, relation = formalizes, coverage = exact, quote = "All payments received by the Secretary under subsection (b) shall be deposited by him in the matching payment account.")
rule S9038DepositRepayment strict {
    for c: PrimaryCandidate;
    for amount: Money;
    when matching_repaid_amount(c, amount);
    then matching_repayment_deposited(c, amount);
}

// ============== §9009 / §9039: Reports to Congress; regulations ================

relation post_election_report_submitted(election: Text) kind empirical;
@source(IRC_S9009_A, relation = formalizes, coverage = partial, quote = "The Commission shall, as soon as practicable after each presidential election, submit a full report to the Senate and House of Representatives")
rule S9009ReportDuty defeasible {
    for election: Text;
    for d: Date;
    when election_day(election, d);
    then duty S9009SubmitReport {
        bearer FederalElectionCommission;
        beneficiary us.irc.core::Congress;
        goal achievement {
            condition post_election_report_submitted(election);
            window [-infinity, infinity];
        }
    };
}

relation rule_statement_transmitted(rule_id: Text, transmitted_on: Date) kind empirical {
    label en unofficial "§9009(c)(1): the Commission has transmitted its rule/regulation statement to both Houses";
}
relation legislative_days_elapsed(rule_id: Text, days: Integer) kind empirical {
    label en unofficial "the number of legislative days elapsed since transmission — a case-supplied count (this package does not compute a legislative-session calendar, TECH_GAP G225)";
}
relation house_disapproved(rule_id: Text) kind empirical;
relation rule_may_be_prescribed(rule_id: Text) kind institutional {
    label en unofficial "§9009(c)(2): 30 legislative days have elapsed without disapproval by either House, so the Commission may prescribe the rule";
}
relation thirty_legislative_days_elapsed_without_disapproval(rule_id: Text) kind institutional {
    label en unofficial "classification: the 30-legislative-day window has run and neither House has disapproved — the power's own valid_when condition";
}
@source(IRC_S9009_C, relation = formalizes, coverage = partial, quote = "If either such House does not, through appropriate action, disapprove the proposed rule or regulation set forth in such statement no later than 30 legislative days after receipt of such statement, then the Commission may prescribe such rule or regulation.")
rule S9009ThirtyDaysWithoutDisapproval defeasible {
    for rule_id: Text;
    for transmitted_on: Date;
    for days: Integer;
    when rule_statement_transmitted(rule_id, transmitted_on) and legislative_days_elapsed(rule_id, days) and days >= 30;
    then thirty_legislative_days_elapsed_without_disapproval(rule_id);
    unless house_disapproved(rule_id);
}
@source(IRC_S9009_C, relation = formalizes, coverage = partial, quote = "then the Commission may prescribe such rule or regulation.")
rule S9009RuleMayBePrescribed strict {
    for rule_id: Text;
    when thirty_legislative_days_elapsed_without_disapproval(rule_id);
    then power S9009PrescribeRulePower {
        holder FederalElectionCommission;
        over rule_id;
        exercise thirty_legislative_days_elapsed_without_disapproval(rule_id);
        valid_when thirty_legislative_days_elapsed_without_disapproval(rule_id);
        effect create(rule_may_be_prescribed(rule_id));
    };
}

// (Chapter 96 mirror — same shapes, own relations to keep the two chapters independent)

relation matching_period_report_submitted(period: Text) kind empirical;
relation matching_period_exists(period: Text) kind empirical;
@source(IRC_S9039_A, relation = formalizes, coverage = partial, quote = "The Commission shall, as soon as practicable after each matching payment period, submit a full report to the Senate and House of Representatives")
rule S9039ReportDuty defeasible {
    for period: Text;
    when matching_period_exists(period);
    then duty S9039SubmitReport {
        bearer FederalElectionCommission;
        beneficiary us.irc.core::Congress;
        goal achievement {
            condition matching_period_report_submitted(period);
            window [-infinity, infinity];
        }
    };
}

relation matching_rule_statement_transmitted(rule_id: Text, transmitted_on: Date) kind empirical;
relation matching_legislative_days_elapsed(rule_id: Text, days: Integer) kind empirical;
relation matching_house_disapproved(rule_id: Text) kind empirical;
relation matching_rule_may_be_prescribed(rule_id: Text) kind institutional;
relation matching_thirty_legislative_days_elapsed_without_disapproval(rule_id: Text) kind institutional;
@source(IRC_S9039_C, relation = formalizes, coverage = partial, quote = "If either such House does not, through appropriate action, disapprove the proposed rule or regulation set forth in such statement no later than 30 legislative days after receipt of such statement, then the Commission may prescribe such rule or regulation.")
rule S9039ThirtyDaysWithoutDisapproval defeasible {
    for rule_id: Text;
    for transmitted_on: Date;
    for days: Integer;
    when matching_rule_statement_transmitted(rule_id, transmitted_on) and matching_legislative_days_elapsed(rule_id, days) and days >= 30;
    then matching_thirty_legislative_days_elapsed_without_disapproval(rule_id);
    unless matching_house_disapproved(rule_id);
}
@source(IRC_S9039_C, relation = formalizes, coverage = partial, quote = "then the Commission may prescribe such rule or regulation.")
rule S9039RuleMayBePrescribed strict {
    for rule_id: Text;
    when matching_thirty_legislative_days_elapsed_without_disapproval(rule_id);
    then power S9039PrescribeRulePower {
        holder FederalElectionCommission;
        over rule_id;
        exercise matching_thirty_legislative_days_elapsed_without_disapproval(rule_id);
        valid_when matching_thirty_legislative_days_elapsed_without_disapproval(rule_id);
        effect create(matching_rule_may_be_prescribed(rule_id));
    };
}

// ============== §9041: Judicial review (NOT an offense; see module header) =====

relation agency_action_reviewable(action_id: Text) kind institutional {
    label en unofficial "§9041(a): any Commission agency action is subject to D.C. Circuit review on a petition filed within 30 days — a procedural cross-reference, no independent institutional effect this package derives beyond the classification itself";
}
relation agency_action_taken(action_id: Text) kind empirical;
@source(IRC_S9041_A, relation = formalizes, coverage = exact, quote = "Any agency action by the Commission made under the provisions of this chapter shall be subject to review by the United States Court of Appeals for the District of Columbia Circuit upon petition filed in such court within 30 days after the agency action by the Commission for which review is sought.")
rule S9041ReviewableAction strict {
    for action_id: Text;
    when agency_action_taken(action_id);
    then agency_action_reviewable(action_id);
}

// ============== §9012 / §9042: Criminal penalties (offense classification) =====

pub entity Offense {
    label en unofficial "one alleged instance of criminal conduct under 26 U.S.C. §9012 or §9042, examined against one subsection's elements — same shape as `us.irc.crimes::Offense`, ported not imported (see module header)";
}
relation offense_person(o: Offense, p: Person) kind empirical;

const Court: Organ = us.irc.core::DistrictCourt;

external judgment relation knowingly_and_willfully_established(o: Offense) {
    authority Court;
    label en unofficial "the court finds, upon conviction, that the offense o's conduct was done knowingly and willfully — the recurring mental element of §§9012/9042";
}
external judgment relation knowingly_established(o: Offense) {
    authority Court;
    label en unofficial "the court finds the conduct was done knowingly (the narrower element of an officer/member's consent clause in §9012(f)/§9042(a))";
}

relation offense_elements_established(p: Person, o: Offense) kind institutional {
    label en unofficial "aggregator: some rule below has classified o (alleged against p) as containing every element the charged subsection requires, including the court-found mental element. No rule concludes this head from conduct alone";
}

relation statutory_maximum_fine_individual(o: Offense, amount: Money) kind institutional {
    label en unofficial "the statutory ceiling on a fine for o — a reference value from the text, never a sentence (EXTERNAL_DEPENDENCY: the actual fine/term a court imposes up to this ceiling)";
}
relation statutory_maximum_imprisonment_years(o: Offense, years: Integer) kind institutional;

// --- §9012(a) Excess expenses ---------------------------------------------------

relation candidate_of_party_9012(o: Offense, party: PoliticalParty) kind empirical;
relation excess_expenses_incurred_conduct(o: Offense, incurred: Money, major_amount: Money) kind empirical;
@source(IRC_S9012_A, relation = formalizes, coverage = exact, quote = "It shall be unlawful for an eligible candidate of a political party for President and Vice President in a presidential election or any of his authorized committees knowingly and willfully to incur qualified campaign expenses in excess of the aggregate payments to which the eligible candidates of a major party are entitled under section 9004 with respect to such election.")
rule S9012aExcessExpensesOffense defeasible {
    for p: Person;
    for o: Offense;
    for incurred: Money;
    for major_amount: Money;
    when offense_person(o, p)
        and excess_expenses_incurred_conduct(o, incurred, major_amount)
        and incurred > major_amount
        and knowingly_and_willfully_established(o);
    then offense_elements_established(p, o);
}
@source(IRC_S9012_A, relation = formalizes, coverage = exact, quote = "Any person who violates paragraph (1) shall be fined not more than $5,000, or imprisoned not more than one year or both.")
rule S9012aPenaltyCeiling strict {
    for o: Offense;
    for incurred: Money;
    for major_amount: Money;
    when excess_expenses_incurred_conduct(o, incurred, major_amount);
    then statutory_maximum_fine_individual(o, 5000 USD);
}
// --- §9012(b) Contributions ------------------------------------------------------

relation disallowed_contribution_conduct(o: Offense, amount: Money) kind empirical;
@source(IRC_S9012_B, relation = formalizes, coverage = partial, quote = "It shall be unlawful for an eligible candidate of a major party in a presidential election or any of his authorized committees knowingly and willfully to accept any contribution to defray qualified campaign expenses, except to the extent necessary to make up any deficiency in payments received out of the fund on account of the application of section 9006(c)")
rule S9012bMajorPartyContributionOffense defeasible {
    for p: Person;
    for o: Offense;
    for amount: Money;
    when offense_person(o, p)
        and disallowed_contribution_conduct(o, amount)
        and knowingly_and_willfully_established(o);
    then offense_elements_established(p, o);
}
@source(IRC_S9012_B, relation = formalizes, coverage = partial, quote = "It shall be unlawful for an eligible candidate of a political party (other than a major party) in a presidential election or any of his authorized committees knowingly and willfully to accept and expend or retain contributions to defray qualified campaign expenses in an amount which exceeds the qualified campaign expenses incurred with respect to such election by such eligible candidate and his authorized committees.")
rule S9012bMinorNewPartyContributionOffense defeasible {
    for p: Person;
    for o: Offense;
    for retained: Money;
    for incurred_expenses: Money;
    when offense_person(o, p)
        and minor_new_contribution_retained(o, retained, incurred_expenses)
        and retained > incurred_expenses
        and knowingly_and_willfully_established(o);
    then offense_elements_established(p, o);
}
relation minor_new_contribution_retained(o: Offense, retained: Money, incurred_expenses: Money) kind empirical;
@source(IRC_S9012_B, relation = formalizes, coverage = exact, quote = "Any person who violates paragraph (1) or (2) shall be fined not more than $5,000, or imprisoned not more than one year, or both.")
rule S9012bPenaltyCeilingMajor strict {
    for o: Offense;
    for amount: Money;
    when disallowed_contribution_conduct(o, amount);
    then statutory_maximum_fine_individual(o, 5000 USD);
}
@source(IRC_S9012_B, relation = formalizes, coverage = exact, quote = "Any person who violates paragraph (1) or (2) shall be fined not more than $5,000, or imprisoned not more than one year, or both.")
rule S9012bPenaltyCeilingMinorNew strict {
    for o: Offense;
    for retained: Money;
    for incurred_expenses: Money;
    when minor_new_contribution_retained(o, retained, incurred_expenses);
    then statutory_maximum_fine_individual(o, 5000 USD);
}

// --- §9012(c) Unlawful use of payments -------------------------------------------

relation misused_9006_payment_conduct(o: Offense, amount: Money) kind empirical;
@source(IRC_S9012_C, relation = formalizes, coverage = exact, quote = "It shall be unlawful for any person who receives any payment under section 9006, or to whom any portion of any payment received under such section is transferred, knowingly and willfully to use, or authorize the use of, such payment or such portion for any purpose other than")
rule S9012cUnlawfulUseOffense defeasible {
    for p: Person;
    for o: Offense;
    for amount: Money;
    when offense_person(o, p)
        and misused_9006_payment_conduct(o, amount)
        and knowingly_and_willfully_established(o);
    then offense_elements_established(p, o);
}
@source(IRC_S9012_C, relation = formalizes, coverage = exact, quote = "Any person who violates paragraph (1) shall be fined not more than $10,000, or imprisoned not more than five years, or both.")
rule S9012cPenaltyCeiling strict {
    for o: Offense;
    for amount: Money;
    when misused_9006_payment_conduct(o, amount);
    then statutory_maximum_fine_individual(o, 10000 USD);
}

// --- §9012(d) False statements, etc ----------------------------------------------

relation false_evidence_to_commission_conduct(o: Offense) kind empirical;
relation failure_to_furnish_records_conduct(o: Offense) kind empirical;
@source(IRC_S9012_D, relation = formalizes, coverage = partial, quote = "to furnish any false, fictitious, or fraudulent evidence, books, or information to the Commission under this subtitle, or to include in any evidence, books, or information so furnished any misrepresentation of a material fact, or to falsify or conceal any evidence, books, or information relevant to a certification by the Commission or an examination and audit by the Commission under this chapter; or")
rule S9012dFalseEvidenceOffense defeasible {
    for p: Person;
    for o: Offense;
    when offense_person(o, p)
        and false_evidence_to_commission_conduct(o)
        and knowingly_and_willfully_established(o);
    then offense_elements_established(p, o);
}
@source(IRC_S9012_D, relation = formalizes, coverage = partial, quote = "to fail to furnish to the Commission any records, books, or information requested by it for purposes of this chapter.")
rule S9012dFailureToFurnishOffense defeasible {
    for p: Person;
    for o: Offense;
    when offense_person(o, p)
        and failure_to_furnish_records_conduct(o)
        and knowingly_and_willfully_established(o);
    then offense_elements_established(p, o);
}
@source(IRC_S9012_D, relation = formalizes, coverage = exact, quote = "Any person who violates paragraph (1) shall be fined not more than $10,000, or imprisoned not more than five years, or both.")
rule S9012dPenaltyCeilingFalseEvidence strict {
    for o: Offense;
    when false_evidence_to_commission_conduct(o);
    then statutory_maximum_fine_individual(o, 10000 USD);
}
@source(IRC_S9012_D, relation = formalizes, coverage = exact, quote = "Any person who violates paragraph (1) shall be fined not more than $10,000, or imprisoned not more than five years, or both.")
rule S9012dPenaltyCeilingFailureToFurnish strict {
    for o: Offense;
    when failure_to_furnish_records_conduct(o);
    then statutory_maximum_fine_individual(o, 10000 USD);
}

// --- §9012(e) Kickbacks and illegal payments -------------------------------------

relation kickback_conduct(o: Offense, amount: Money) kind empirical;
@source(IRC_S9012_E, relation = formalizes, coverage = exact, quote = "It shall be unlawful for any person knowingly and willfully to give or accept any kickback or any illegal payment in connection with any qualified campaign expense of eligible candidates or their authorized committees.")
rule S9012eKickbackOffense defeasible {
    for p: Person;
    for o: Offense;
    for amount: Money;
    when offense_person(o, p) and kickback_conduct(o, amount) and knowingly_and_willfully_established(o);
    then offense_elements_established(p, o);
}
@source(IRC_S9012_E, relation = formalizes, coverage = exact, quote = "Any person who violates paragraph (1) shall be fined not more than $10,000, or imprisoned not more than five years, or both.")
rule S9012ePenaltyCeiling strict {
    for o: Offense;
    for amount: Money;
    when kickback_conduct(o, amount);
    then statutory_maximum_fine_individual(o, 10000 USD);
}
relation kickback_disgorgement_amount(o: Offense, amount: Money, disgorge: Money) kind institutional {
    label en unofficial "§9012(e)(3): 125 percent of the kickback/payment received, payable to the Secretary for the general fund — an EXECUTABLE exact computation, additional to (and distinct from) the criminal fine ceiling above";
}
@source(IRC_S9012_E, relation = formalizes, coverage = exact, quote = "any person who accepts any kickback or illegal payment in connection with any qualified campaign expense of eligible candidates or their authorized committees shall pay to the Secretary of the Treasury, for deposit in the general fund of the Treasury, an amount equal to 125 percent of the kickback or payment received.")
rule S9012eDisgorgement strict {
    for o: Offense;
    for amount: Money;
    when kickback_conduct(o, amount);
    then kickback_disgorgement_amount(o, amount, round(amount * 1.25, 2, "HALF_UP"));
}

// --- §9012(f) Unauthorized expenditures and contributions -----------------------

relation unauthorized_committee_expenditure_conduct(o: Offense, amount: Money) kind empirical;
@source(IRC_S9012_F, relation = formalizes, coverage = partial, quote = "it shall be unlawful for any political committee which is not an authorized committee with respect to the eligible candidates of a political party for President and Vice President in a presidential election knowingly and willfully to incur expenditures to further the election of such candidates, which would constitute qualified campaign expenses if incurred by an authorized committee of such candidates, in an aggregate amount exceeding $1,000.")
rule S9012fUnauthorizedExpenditureOffense defeasible {
    for p: Person;
    for o: Offense;
    for amount: Money;
    when offense_person(o, p)
        and unauthorized_committee_expenditure_conduct(o, amount)
        and amount > 1000 USD
        and knowingly_and_willfully_established(o);
    then offense_elements_established(p, o);
    unless (broadcaster_news_reporting_exception(o) or section_501c_member_communication_exception(o)) and offense_person(o, p);
}
relation broadcaster_news_reporting_exception(o: Offense) kind empirical {
    label en unofficial "§9012(f)(2)(A): broadcaster/periodical news-reporting or editorial-position exception";
}
relation section_501c_member_communication_exception(o: Offense) kind empirical {
    label en unofficial "§9012(f)(2)(B): §501(c)-exempt organization communicating to its own members";
}
@source(IRC_S9012_F, relation = formalizes, coverage = exact, quote = "Any political committee which violates paragraph (1) shall be fined not more than $5,000, and any officer or member of such committee who knowingly and willfully consents to such violation and any other individual who knowingly and willfully violates paragraph (1) shall be fined not more than $5,000, or imprisoned not more than one year, or both.")
rule S9012fPenaltyCeiling strict {
    for o: Offense;
    for amount: Money;
    when unauthorized_committee_expenditure_conduct(o, amount) and amount > 1000 USD;
    then statutory_maximum_fine_individual(o, 5000 USD);
}

// --- §9012(g) Unauthorized disclosure of information -----------------------------

relation unauthorized_disclosure_conduct(o: Offense) kind empirical;
@source(IRC_S9012_G, relation = formalizes, coverage = exact, quote = "It shall be unlawful for any individual to disclose any information obtained under the provisions of this chapter except as may be required by law.")
rule S9012gDisclosureOffense defeasible {
    for p: Person;
    for o: Offense;
    when offense_person(o, p) and unauthorized_disclosure_conduct(o) and not_known(required_by_law_disclosure(o));
    then offense_elements_established(p, o);
}
relation required_by_law_disclosure(o: Offense) kind empirical { label en unofficial "the disclosure was required by law — the section's own built-in exception"; }
@source(IRC_S9012_G, relation = formalizes, coverage = exact, quote = "Any person who violates paragraph (1) shall be fined not more than $5,000, or imprisoned not more than one year, or both.")
rule S9012gPenaltyCeiling strict {
    for o: Offense;
    when unauthorized_disclosure_conduct(o);
    then statutory_maximum_fine_individual(o, 5000 USD);
}

// ============== §9042 Criminal penalties (Chapter 96 mirror) ===================

// --- §9042(a) Excess campaign expenses (violation of §9035) --------------------

relation section_9035_violation_conduct(o: Offense, incurred: Money, limitation: Money) kind empirical;
@source(IRC_S9042_A, relation = formalizes, coverage = partial, quote = "Any person who violates the provisions of section 9035 shall be fined not more than $25,000, or imprisoned not more than 5 years, or both.")
rule S9042aExcessExpensesOffense defeasible {
    for p: Person;
    for o: Offense;
    for incurred: Money;
    for limitation: Money;
    when offense_person(o, p)
        and section_9035_violation_conduct(o, incurred, limitation)
        and incurred > limitation;
    then offense_elements_established(p, o);
}
relation officer_consented_to_9035_violation(o: Offense) kind empirical;
@source(IRC_S9042_A, relation = formalizes, coverage = partial, quote = "Any officer or member of any political committee who knowingly consents to any expenditure in violation of the provisions of section 9035 shall be fined not more than $25,000, or imprisoned not more than 5 years, or both.")
rule S9042aOfficerConsentOffense defeasible {
    for p: Person;
    for o: Offense;
    when offense_person(o, p) and officer_consented_to_9035_violation(o) and knowingly_established(o);
    then offense_elements_established(p, o);
}
@source(IRC_S9042_A, relation = formalizes, coverage = partial, quote = "Any person who violates the provisions of section 9035 shall be fined not more than $25,000, or imprisoned not more than 5 years, or both.")
rule S9042aPenaltyCeilingViolation strict {
    for o: Offense;
    for incurred: Money;
    for limitation: Money;
    when section_9035_violation_conduct(o, incurred, limitation);
    then statutory_maximum_fine_individual(o, 25000 USD);
}
@source(IRC_S9042_A, relation = formalizes, coverage = partial, quote = "Any officer or member of any political committee who knowingly consents to any expenditure in violation of the provisions of section 9035 shall be fined not more than $25,000, or imprisoned not more than 5 years, or both.")
rule S9042aPenaltyCeilingConsent strict {
    for o: Offense;
    when officer_consented_to_9035_violation(o);
    then statutory_maximum_fine_individual(o, 25000 USD);
}

// --- §9042(b) Unlawful use of payments ------------------------------------------

relation misused_9037_payment_conduct(o: Offense, amount: Money) kind empirical;
@source(IRC_S9042_B, relation = formalizes, coverage = exact, quote = "It is unlawful for any person who receives any payment under section 9037, or to whom any portion of any such payment is transferred, knowingly and willfully to use, or authorize the use of, such payment or such portion for any purpose other than")
rule S9042bUnlawfulUseOffense defeasible {
    for p: Person;
    for o: Offense;
    for amount: Money;
    when offense_person(o, p) and misused_9037_payment_conduct(o, amount) and knowingly_and_willfully_established(o);
    then offense_elements_established(p, o);
}
@source(IRC_S9042_B, relation = formalizes, coverage = exact, quote = "Any person who violates the provisions of paragraph (1) shall be fined not more than $10,000, or imprisoned not more than 5 years, or both.")
rule S9042bPenaltyCeiling strict {
    for o: Offense;
    for amount: Money;
    when misused_9037_payment_conduct(o, amount);
    then statutory_maximum_fine_individual(o, 10000 USD);
}

// --- §9042(c) False statements, etc ----------------------------------------------

relation false_evidence_to_commission_conduct_9042(o: Offense) kind empirical;
relation failure_to_furnish_records_conduct_9042(o: Offense) kind empirical;
@source(IRC_S9042_C, relation = formalizes, coverage = partial, quote = "to furnish any false, fictitious, or fraudulent evidence, books, or information to the Commission under this chapter, or to include in any evidence, books, or information so furnished any misrepresentation of a material fact, or to falsify or conceal any evidence, books, or information relevant to a certification by the Commission or an examination and audit by the Commission under this chapter, or")
rule S9042cFalseEvidenceOffense defeasible {
    for p: Person;
    for o: Offense;
    when offense_person(o, p) and false_evidence_to_commission_conduct_9042(o) and knowingly_and_willfully_established(o);
    then offense_elements_established(p, o);
}
@source(IRC_S9042_C, relation = formalizes, coverage = partial, quote = "to fail to furnish to the Commission any records, books, or information requested by it for purposes of this chapter.")
rule S9042cFailureToFurnishOffense defeasible {
    for p: Person;
    for o: Offense;
    when offense_person(o, p) and failure_to_furnish_records_conduct_9042(o) and knowingly_and_willfully_established(o);
    then offense_elements_established(p, o);
}
@source(IRC_S9042_C, relation = formalizes, coverage = exact, quote = "Any person who violates the provisions of paragraph (1) shall be fined not more than $10,000, or imprisoned not more than 5 years, or both.")
rule S9042cPenaltyCeiling strict {
    for o: Offense;
    when false_evidence_to_commission_conduct_9042(o) or failure_to_furnish_records_conduct_9042(o);
    then statutory_maximum_fine_individual(o, 10000 USD);
}

// --- §9042(d) Kickbacks and illegal payments -------------------------------------

relation kickback_conduct_9042(o: Offense, amount: Money) kind empirical;
@source(IRC_S9042_D, relation = formalizes, coverage = exact, quote = "It is unlawful for any person knowingly and willfully to give or accept any kickback or any illegal payment in connection with any qualified campaign expense of a candidate, or his authorized committees, who receives payments under section 9037.")
rule S9042dKickbackOffense defeasible {
    for p: Person;
    for o: Offense;
    for amount: Money;
    when offense_person(o, p) and kickback_conduct_9042(o, amount) and knowingly_and_willfully_established(o);
    then offense_elements_established(p, o);
}
@source(IRC_S9042_D, relation = formalizes, coverage = exact, quote = "Any person who violates the provisions of paragraph (1) shall be fined not more than $10,000, or imprisoned not more than 5 years, or both.")
rule S9042dPenaltyCeiling strict {
    for o: Offense;
    for amount: Money;
    when kickback_conduct_9042(o, amount);
    then statutory_maximum_fine_individual(o, 10000 USD);
}
relation kickback_disgorgement_amount_9042(o: Offense, amount: Money, disgorge: Money) kind institutional;
@source(IRC_S9042_D, relation = formalizes, coverage = exact, quote = "any person who accepts any kickback or illegal payment in connection with any qualified campaign expense of a candidate or his authorized committees shall pay to the Secretary for deposit in the matching payment account, an amount equal to 125 percent of the kickback or payment received.")
rule S9042eDisgorgement strict {
    for o: Offense;
    for amount: Money;
    when kickback_conduct_9042(o, amount);
    then kickback_disgorgement_amount_9042(o, amount, round(amount * 1.25, 2, "HALF_UP"));
}
