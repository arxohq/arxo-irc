// Section 119 — Meals or lodging furnished for the convenience of the
// employer. Stage 2d (IRC-06). Scope: (a) general exclusion, (b)(1)-(4)
// the convenience-of-the-employer tests (incl. the (b)(4) more-than-half
// population test read as a case-asserted boolean, and the (b)(3) fixed-
// charge exclusion), (c) foreign camps, (d) qualified campus lodging with
// the 5% rule. NOT reached: the notes.

// =====================================================================
// §119(a): general exclusion
// =====================================================================

use self::{
    IRC_S119_A,
    IRC_S119_B,
    IRC_S119_C,
    IRC_S119_D,
    Individual,
    TaxableYear,
};

pub relation meals_or_lodging_furnished_for_convenience(p: Individual, y: TaxableYear, kind: MealsOrLodgingKind, amount: Money) kind empirical {
    label en official "the value of meals or lodging furnished to the employee, spouse, or a dependent by or on behalf of the employer for the convenience of the employer (section 119(a))";
}
pub enum MealsOrLodgingKind {
    Meals;
    Lodging;
}
relation meals_furnished_on_business_premises(p: Individual, y: TaxableYear) kind empirical {
    label en official "the meals are furnished on the business premises of the employer (section 119(a)(1))";
}
relation lodging_required_on_business_premises_as_condition(p: Individual, y: TaxableYear) kind empirical {
    label en official "the employee is required to accept the lodging on the business premises of the employer as a condition of employment (section 119(a)(2))";
}

pub relation meals_or_lodging_excluded_119a(p: Individual, y: TaxableYear, kind: MealsOrLodgingKind, amount: Money) kind institutional {
    label en official "the value of meals or lodging excluded from gross income under section 119(a)";
}
@source(IRC_S119_A, quote = "There shall be excluded from gross income of an employee the value of any meals or lodging furnished to him, his spouse, or any of his dependents by or on behalf of his employer for the convenience of the employer, but only if—\n(1) in the case of meals, the meals are furnished on the business premises of the employer, or")
rule MealsExcluded(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 119(a)(1): meals for the convenience of the employer, furnished on the business premises";
    when meals_or_lodging_furnished_for_convenience(p, y, Meals, amount);
    when meals_furnished_on_business_premises(p, y);
    then meals_or_lodging_excluded_119a(p, y, Meals, amount);
}
@source(IRC_S119_A, quote = "(2) in the case of lodging, the employee is required to accept such lodging on the business premises of his employer as a condition of his employment.")
rule LodgingExcluded(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 119(a)(2): lodging for the convenience of the employer, required as a condition of employment";
    when meals_or_lodging_furnished_for_convenience(p, y, Lodging, amount);
    when lodging_required_on_business_premises_as_condition(p, y);
    then meals_or_lodging_excluded_119a(p, y, Lodging, amount);
}

// =====================================================================
// §119(b): convenience-of-the-employer refinements
// =====================================================================

pub relation employee_pays_fixed_periodic_charge_for_meals(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the employee is required to pay, on a periodic basis, a fixed charge for meals furnished by the employer for the employer's convenience, whether accepted or declined (section 119(b)(3))";
}
pub relation fixed_charge_meals_excluded_119b3(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "an amount equal to the fixed charge is excluded from the employee's gross income (section 119(b)(3)(A))";
}
@source(IRC_S119_B, quote = "there shall be excluded from the employee's gross income an amount equal to such fixed charge")
rule FixedChargeMealsExcluded(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 119(b)(3)(A)-(B): the fixed periodic charge itself is excluded, regardless of the source of payment";
    when employee_pays_fixed_periodic_charge_for_meals(p, y, amount);
    then fixed_charge_meals_excluded_119b3(p, y, amount);
}

relation more_than_half_employees_furnished_for_employer_convenience(employer: us.irc.core::Organ, y: TaxableYear) kind empirical {
    label en official "without regard to section 119(b)(4), more than half of the employees to whom meals are furnished on the business premises are furnished those meals for the convenience of the employer (section 119(b)(4)) — a population-wide test read as a case-asserted boolean, §111 aggregate-over-derived-predicate limitation";
}
pub relation all_meals_treated_as_for_employer_convenience_119b4(employer: us.irc.core::Organ, y: TaxableYear) kind institutional {
    label en official "all meals furnished on the employer's business premises to its employees are treated as furnished for the convenience of the employer (section 119(b)(4))";
}
@source(IRC_S119_B, quote = "All meals furnished on the business premises of an employer to such employer's employees shall be treated as furnished for the convenience of the employer if, without regard to this paragraph, more than half of the employees to whom such meals are furnished on such premises are furnished such meals for the convenience of the employer.")
rule AllMealsTreatedAsConvenienceOfEmployer(employer: us.irc.core::Organ, y: TaxableYear) strict {
    label en official "section 119(b)(4): the more-than-half test, taken as a case-asserted population fact (not derived from a per-employee census — §111)";
    when more_than_half_employees_furnished_for_employer_convenience(employer, y);
    then all_meals_treated_as_for_employer_convenience_119b4(employer, y);
}

// =====================================================================
// §119(c): foreign camps
// =====================================================================

pub relation lodging_in_foreign_camp(p: Individual, y: TaxableYear) kind empirical {
    label en official "the individual is furnished lodging in a camp located in a foreign country by or on behalf of the employer (section 119(c)(1))";
}
pub relation camp_treated_as_business_premises_119c(p: Individual, y: TaxableYear) kind institutional {
    label en official "the foreign camp is considered part of the business premises of the employer for section 119 purposes (section 119(c)(1))";
}
@source(IRC_S119_C, quote = "such camp shall be considered to be part of the business premises of the employer")
rule ForeignCampTreatedAsBusinessPremises(p: Individual, y: TaxableYear) strict {
    label en official "section 119(c)(1)";
    when lodging_in_foreign_camp(p, y);
    then camp_treated_as_business_premises_119c(p, y);
}

// =====================================================================
// §119(d): qualified campus lodging
// =====================================================================

pub relation employee_of_educational_institution_119d(p: Individual, institution: us.irc.core::Organ) kind empirical {
    label en official "the individual is an employee of an educational institution within the meaning of section 119(d)(4) (section 170(b)(1)(A)(ii) institution or academic health center)";
}
pub relation qualified_campus_lodging_value(p: Individual, institution: us.irc.core::Organ, y: TaxableYear, amount: Money) kind empirical {
    label en official "the value of qualified campus lodging furnished to the employee during the taxable year (section 119(d)(1),(3))";
}
relation campus_lodging_appraised_value(p: Individual, institution: us.irc.core::Organ, y: TaxableYear, amount: Money) kind empirical {
    label en official "the appraised value of the qualified campus lodging, determined as of the close of the calendar year (or, for a rental period of 1 year or less, at any time during the period) (section 119(d)(2)(A)(i),(2), final sentence)";
}
relation comparable_lodging_average_rental_119d2Aii(p: Individual, institution: us.irc.core::Organ, y: TaxableYear, amount: Money) kind empirical {
    label en official "the average of the rentals paid by individuals other than employees or students of the institution during the calendar year for comparable lodging provided by the institution (section 119(d)(2)(A)(ii))";
}
relation rent_paid_by_employee_119d2B(p: Individual, institution: us.irc.core::Organ, y: TaxableYear, amount: Money) kind empirical {
    label en official "the rent paid by the employee for the qualified campus lodging during the calendar year (section 119(d)(2)(B))";
}

pub relation campus_lodging_included_excess_119d2(p: Individual, institution: us.irc.core::Organ, y: TaxableYear, amount: Money) kind institutional {
    label en official "the portion of qualified campus lodging value NOT excluded: the excess of the lesser of (5% of appraised value) or (comparable-rental average) over the rent the employee actually paid (section 119(d)(2))";
}
@source(IRC_S119_D, quote = "5 percent of the appraised value of the qualified campus lodging")
rule CampusLodgingIncludedExcess(p: Individual, institution: us.irc.core::Organ, y: TaxableYear, appraised: Money, comparable: Money, rent_paid: Money) strict {
    label en official "section 119(d)(2): the taxable excess over rent actually paid";
    when campus_lodging_appraised_value(p, institution, y, appraised);
    when comparable_lodging_average_rental_119d2Aii(p, institution, y, comparable);
    when rent_paid_by_employee_119d2B(p, institution, y, rent_paid);
    when min(round(appraised * 0.05, 2, "HALF_UP"), comparable) > rent_paid;
    then campus_lodging_included_excess_119d2(p, institution, y, round(min(round(appraised * 0.05, 2, "HALF_UP"), comparable) - rent_paid, 2, "HALF_UP"));
}

pub relation qualified_campus_lodging_excluded_119d1(p: Individual, institution: us.irc.core::Organ, y: TaxableYear, amount: Money) kind institutional {
    label en official "gross income does not include this value of qualified campus lodging, net of the (d)(2) 5%-rule excess (section 119(d)(1))";
}
@source(IRC_S119_D, quote = "gross income shall not include the value of qualified campus lodging furnished to such employee during the taxable year")
rule QualifiedCampusLodgingExcludedNetOfExcess(p: Individual, institution: us.irc.core::Organ, y: TaxableYear, value: Money, excess: Money) strict {
    label en official "section 119(d)(1) net of the (d)(2) excess";
    when employee_of_educational_institution_119d(p, institution);
    when qualified_campus_lodging_value(p, institution, y, value);
    when campus_lodging_included_excess_119d2(p, institution, y, excess);
    when value > excess;
    then qualified_campus_lodging_excluded_119d1(p, institution, y, round(value - excess, 2, "HALF_UP"));
}
@source(IRC_S119_D, quote = "gross income shall not include the value of qualified campus lodging furnished to such employee during the taxable year")
rule QualifiedCampusLodgingExcludedNoExcess(p: Individual, institution: us.irc.core::Organ, y: TaxableYear, value: Money) strict {
    label en official "section 119(d)(1): full exclusion when the (d)(2) 5%-rule produces no excess (rent paid already covers the lesser-of amount)";
    when employee_of_educational_institution_119d(p, institution);
    when qualified_campus_lodging_value(p, institution, y, value);
    when not_known(has_campus_lodging_excess_119d2(p, institution, y));
    then qualified_campus_lodging_excluded_119d1(p, institution, y, value);
}
relation has_campus_lodging_excess_119d2(p: Individual, institution: us.irc.core::Organ, y: TaxableYear) kind institutional {
    label en official "helper binding the otherwise-open excess amount for the not_known test above";
}
rule HasCampusLodgingExcess(p: Individual, institution: us.irc.core::Organ, y: TaxableYear, amount: Money) strict {
    label en official "helper for QualifiedCampusLodgingExcludedNoExcess";
    when campus_lodging_included_excess_119d2(p, institution, y, amount);
    then has_campus_lodging_excess_119d2(p, institution, y);
}

relation academic_health_center_170b1Aiii(institution: us.irc.core::Organ) kind empirical {
    label en official "the entity is described in section 170(b)(1)(A)(iii), receives graduate-medical-education payments under section 1886(d)(5)(B)/(h) of the Social Security Act, and has as a principal purpose the providing and teaching of basic and clinical medical science with its own faculty (section 119(d)(4)(B)) — a compound definitional test taken as a single case-asserted fact";
}
