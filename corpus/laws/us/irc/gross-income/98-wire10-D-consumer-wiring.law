// Gross income -- WIRE-10 group D (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// Section 68(a)(2) as replaced by Pub. L. 119-21 section 70111: the dollar amount at which the 37 percent bracket begins is
// the adjusted lower bound of bracket 7 of the table of section 1(j)(2) for the taxpayer's filing status, which
// `us.irc.income_individual` derives (the beginning of a bracket higher than 22 percent is indexed with 2017 substituted for 2016,
// also after 2025, by the rule W10DRequestIndexingOfTcjaBracketBoundAfter2025 of that package). The index values are case facts of the
// owner; the case-fact channel `bracket_37_percent_begins_at` stays valid (a case must not assert both).

language "law.core" version "0.2";
package us.irc.gross_income version "0.1.1";
namespace "urn:us:irc:gross_income:clir";

use self::{
    Individual,
    TaxableYear,
    bracket_37_percent_begins_at,
};

rule W10Bracket37PercentBeginsAtFromIncomeIndividual strict {
    label en official "the amount at which the 37 percent bracket begins for the taxpayer is the adjusted lower bound of bracket 7 of the table for the taxpayer's filing status";
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for s: us.irc.income_individual::FilingStatus;
    for amount: Money;
    when us.irc.income_individual::filing_status(p, y, s);
    when us.irc.income_individual::tcja_bracket_lower_indexed(s, y, 7, amount);
    then bracket_37_percent_begins_at(p, y, amount);
}
