// Section 83 — Property transferred in connection with performance of
// services. Stage 2c (IRC-06). Scope: (a) general inclusion rule, (b) the
// election to include at transfer plus its 30-day timing power, (c)
// definitions (substantial risk of forfeiture, transferability, the section
// 16(b) special rule), (d) formula-price never-lapsing restrictions and
// their cancellation, (e) the five exclusions, (f) holding period, (g)
// exchanges for substantially similar restricted property, (h) the
// employer's matching deduction. (i) qualified equity grants ("83(i)
// election") is reached only at the CORE level named in the task priority
// (`section_83_inclusion` covers (a)-(h); (i)'s own deferred-inclusion
// election is modelled as a distinct power with a (i)(4)(A) 30-day
// `valid_when`, but the "eligible corporation"/"qualified stock" 80%-grant
// and disqualification tests of (i)(2)-(4) are NOT modelled — TECH_GAP,
// noted at the (i) block below).

// `Individual`/`Person`/`TaxableYear` already aliased package-wide by
// s61-gross-income.law; not re-declared here (LDC-E1201 duplicate-name).
// `Asset` is used fully-qualified as `us.irc.core::Asset`, matching the
// existing convention in s121-sale-of-principal-residence.law.

// =====================================================================
// §83(c): definitions used by (a)/(b)/(d)
// =====================================================================

use self::{
    IRC_S83_A,
    IRC_S83_B,
    IRC_S83_C,
    IRC_S83_D,
    IRC_S83_E,
    IRC_S83_F,
    IRC_S83_G,
    IRC_S83_H,
    IRC_S83_I,
    Person,
    TaxableYear,
    election_barred_83i4B,
    section_83_not_applicable_to_rsu_83i7,
};

// "Substantial risk of forfeiture" turns on whether there is a realistic
// possibility that the condition will cause a forfeiture — an evaluative
// judgment akin to DECISION-0194's listed examples (fair market value,
// business purpose), not a bright-line arithmetic test.
external judgment relation substantial_risk_of_forfeiture_83c1(p: Person, asset: us.irc.core::Asset, on: Date) {
    authority Secretary;
    label en official "the person's rights to full enjoyment of the property are conditioned upon the future performance of substantial services by any individual (section 83(c)(1)) — an evaluative \"realistic possibility of forfeiture\" judgment, DECISION-0194 channel";
}
// Section 83(c)(1) itself has no separate arithmetic rule beyond the
// `external judgment relation` declaration above (a rule whose body and head
// are the same predicate is a dependency cycle the engine rejects, per the
// s61 GrossIncomeItemKind convention this package already follows). It is
// referenced only as a positive `when` fact elsewhere in this package group
// (an evaluative relation cannot itself be the subject of `not_known`, per
// DECISION-0194: "unknown is not negative" — this package does not test its
// ABSENCE, only cases that affirmatively assert it).

pub relation transferable_83c2(p: Person, asset: us.irc.core::Asset, on: Date) kind empirical {
    label en official "the rights of a person in property are transferable within the meaning of section 83(c)(2): case-asserted directly (the (c)(2) test — that a transferee's own rights are not subject to a substantial risk of forfeiture — is not itself derived from the evaluative (c)(1) relation over a hypothetical transferee, since `not_known` cannot test an evaluative relation's absence; a case asserting `transferable_83c2` has already resolved that question)";
}

pub relation section_16b_restricted_83c3(p: Person, asset: us.irc.core::Asset, on: Date) kind institutional {
    label en official "so long as a sale of the property at a profit could subject the person to suit under section 16(b) of the Securities Exchange Act of 1934, the person's rights are treated as subject to a substantial risk of forfeiture and not transferable (section 83(c)(3))";
}
relation subject_to_section_16b_suit_on_profit(p: Person, asset: us.irc.core::Asset, on: Date) kind empirical {
    label en official "a sale of the property at a profit could subject this person to suit under section 16(b) of the Securities Exchange Act of 1934 (case-asserted; the insider-trading-law question itself is EXTERNAL_DEPENDENCY on Exchange Act status, not this package's to compute)";
}
@source(IRC_S83_C, quote = "So long as the sale of property at a profit could subject a person to suit under section 16(b) of the Securities Exchange Act of 1934, such person's rights in such property are—\n(A) subject to a substantial risk of forfeiture, and\n(B) not transferable.")
rule Section16bSpecialRule(p: Person, asset: us.irc.core::Asset, on: Date) strict {
    label en official "section 83(c)(3): the section 16(b) special rule overrides the ordinary (c)(1)/(2) tests while it applies";
    when subject_to_section_16b_suit_on_profit(p, asset, on);
    then section_16b_restricted_83c3(p, asset, on);
}

// =====================================================================
// §83(a): general rule
// =====================================================================

pub relation property_transferred_for_services(p: Person, asset: us.irc.core::Asset, transfer_date: Date, fmv_at_transfer: Money, amount_paid: Money) kind empirical {
    label en official "property transferred in connection with the performance of services by this person, with its fair market value at transfer (determined without regard to any restriction other than one that by its terms will never lapse) and the amount (if any) paid for it (section 83(a))";
}
pub relation vesting_date_83(p: Person, asset: us.irc.core::Asset, on: Date) kind institutional {
    label en official "the first date on which the person's rights in the property are transferable, or are not subject to a substantial risk of forfeiture, whichever occurs earlier (section 83(a))";
}
@source(IRC_S83_A, quote = "the first time the rights of the person having the beneficial interest in such property are transferable or are not subject to a substantial risk of forfeiture, whichever occurs earlier")
rule VestingByTransferability(p: Person, asset: us.irc.core::Asset, on: Date) strict {
    label en official "vesting occurs when transferability is reached, if that is earlier (this package does not compare the two dates and pick the minimum — TECH_GAP: a case asserts whichever event it treats as controlling)";
    when transferable_83c2(p, asset, on);
    when not_known(section_16b_restricted_83c3(p, asset, on)); // G6404 wiring: §83(c)(3)(B) — rights are not transferable while a section 16(b) suit could lie
    then vesting_date_83(p, asset, on);
}
@source(IRC_S83_A, quote = "or are not subject to a substantial risk of forfeiture, whichever occurs earlier")
rule VestingByLapseOfForfeitureRisk(p: Person, asset: us.irc.core::Asset, on: Date) strict {
    label en official "vesting occurs when the substantial-risk-of-forfeiture condition lapses (case-asserted lapse date), if that is earlier";
    when substantial_risk_of_forfeiture_lapses_on(p, asset, on);
    when not_known(section_16b_restricted_83c3(p, asset, on)); // G6404 wiring: §83(c)(3)(A) — the rights stay subject to a substantial risk of forfeiture
    then vesting_date_83(p, asset, on);
}
relation substantial_risk_of_forfeiture_lapses_on(p: Person, asset: us.irc.core::Asset, on: Date) kind empirical {
    label en official "the date the substantial-risk-of-forfeiture condition on the property lapses (case-asserted)";
}

relation section_83_excluded_transfer(p: Person, asset: us.irc.core::Asset) kind institutional {
    label en official "helper: one of the section 83(e) exclusions applies to this transfer (see the (e) block below)";
}

relation arms_length_disposition_before_vesting(p: Person, asset: us.irc.core::Asset) kind empirical {
    label en official "the person sells or otherwise disposes of the property in an arm's-length transaction before the person's rights become transferable or cease to be subject to a substantial risk of forfeiture — the section 83(a) inclusion rule does not apply at all in that case (its own final sentence)";
}

pub relation section_83_inclusion(p: Person, asset: us.irc.core::Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount included in gross income under section 83(a): the excess of the property's fair market value (restriction-adjusted per (a)(1)) over the amount paid, in the first taxable year the person's rights are transferable or not subject to a substantial risk of forfeiture";
}
@source(IRC_S83_A, quote = "shall be included in the gross income of the person who performed such services in the first taxable year in which the rights of the person having the beneficial interest in such property are transferable or are not subject to a substantial risk of forfeiture, whichever is applicable.")
rule Section83aInclusion(p: Person, asset: us.irc.core::Asset, transfer_date: Date, on: Date, y: TaxableYear, fmv: Money, paid: Money) strict {
    label en official "section 83(a): FMV at vesting minus amount paid, included in the year of vesting, absent a pre-vesting arm's-length disposition or a (b) election or a (e) exclusion";
    when property_transferred_for_services(p, asset, transfer_date, fmv, paid);
    when vesting_date_83(p, asset, on);
    when not_known(arms_length_disposition_before_vesting(p, asset));
    when not_known(section_83b_election_made(p, asset));
    when not_known(section_83_excluded_transfer(p, asset));
    when not_known(section_83_not_applicable_to_rsu_83i7(asset)); // G6404 wiring: §83(i)(7) — section 83 (other than (i)) does not apply to restricted stock units
    when not_known(has_formula_price_83d1(p, asset)); // G6404 wiring: §83(d)(1) — variant below
    when fmv > paid;
    when us.irc.core::year_of(p, y);
    then section_83_inclusion(p, asset, y, round(fmv - paid, 2, "HALF_UP"));
}

// =====================================================================
// §83(b): election to include at time of transfer
// =====================================================================

pub relation section_83b_election_made(p: Person, asset: us.irc.core::Asset) kind empirical {
    label en official "the person elected, under section 83(b), to include the excess of FMV over amount paid in gross income for the year of transfer rather than the year of vesting (case-asserted election)";
}
relation section_83b_election_date(p: Person, asset: us.irc.core::Asset, transfer_date: Date, elected_on: Date) kind empirical {
    label en official "the date the section 83(b) election was filed, for the (b)(2) 30-day timing test";
}
pub relation section_83b_election_timely(p: Person, asset: us.irc.core::Asset, transfer_date: Date, elected_on: Date) kind institutional {
    label en official "section 83(b)(2): the election is made not later than 30 days after the date of transfer (the single valid_when atom for the power below, per core-surfaces.md)";
}
@source(IRC_S83_B, quote = "An election under paragraph (1) with respect to any transfer of property shall be made in such manner as the Secretary prescribes and shall be made not later than 30 days after the date of such transfer.")
rule Section83bElectionTimely(p: Person, asset: us.irc.core::Asset, transfer_date: Date, elected_on: Date) strict {
    label en official "the 30-day filing window, an exact boundary (day 30 is timely, day 31 is not)";
    when section_83b_election_date(p, asset, transfer_date, elected_on);
    when days_between(transfer_date, elected_on) <= 30;
    then section_83b_election_timely(p, asset, transfer_date, elected_on);
}

@source(IRC_S83_B, quote = "Any person who performs services in connection with which property is transferred to any person may elect to include in his gross income for the taxable year in which such property is transferred, the excess of—\n(A) the fair market value of such property at the time of transfer (determined without regard to any restriction other than a restriction which by its terms will never lapse), over\n(B) the amount (if any) paid for such property.")
rule Section83bElectionPower(p: Person, asset: us.irc.core::Asset, transfer_date: Date, elected_on: Date, fmv: Money, paid: Money) strict {
    label en official "section 83(b): the power to elect immediate inclusion at the transfer-date FMV, valid only within the 30-day window";
    when property_transferred_for_services(p, asset, transfer_date, fmv, paid);
    when section_83b_election_date(p, asset, transfer_date, elected_on);
    when not_known(section_83_not_applicable_to_rsu_83i7(asset)); // G6404 wiring: §83(i)(7) — a section 83(b) election does not apply to restricted stock units
    then power Section83bElection {
        holder p;
        over asset;
        exercise section_83b_election_made(p, asset);
        valid_when section_83b_election_timely(p, asset, transfer_date, elected_on);
        effect section_83_inclusion_at_transfer_83b(p, asset, transfer_date, fmv, paid);
    };
}
// G6404 wiring, §83(d)(1): where the restriction never lapses and the price is fixed by a formula, the price so
// determined is deemed to be the fair market value, so the §83(a) inclusion at vesting is the deemed price less the
// amount paid (the asserted `fmv_at_transfer` is then not used). The Secretary's rebuttal stays a judgment.
relation has_formula_price_83d1(p: Person, asset: us.irc.core::Asset) kind institutional {
    label en official "the formula price of a never-lapsing restriction is deemed the fair market value (section 83(d)(1))";
}
rule HasFormulaPrice83d1(p: Person, asset: us.irc.core::Asset, amount: Money) strict {
    when formula_price_deemed_fmv_83d1(p, asset, amount);
    then has_formula_price_83d1(p, asset);
}
@source(IRC_S83_D, quote = "the price so determined shall be deemed to be the fair market value of the property unless established to the contrary by the Secretary, and the burden of proof shall be on the Secretary with respect to such value")
rule Section83aInclusionAtFormulaPrice(p: Person, asset: us.irc.core::Asset, transfer_date: Date, on: Date, y: TaxableYear, fmv: Money, paid: Money, deemed: Money) strict {
    label en official "section 83(a) with (d)(1): inclusion at the deemed formula price";
    when property_transferred_for_services(p, asset, transfer_date, fmv, paid);
    when vesting_date_83(p, asset, on);
    when formula_price_deemed_fmv_83d1(p, asset, deemed);
    when not_known(arms_length_disposition_before_vesting(p, asset));
    when not_known(section_83b_election_made(p, asset));
    when not_known(section_83_excluded_transfer(p, asset));
    when not_known(section_83_not_applicable_to_rsu_83i7(asset));
    when deemed > paid;
    when us.irc.core::year_of(p, y);
    then section_83_inclusion(p, asset, y, round(deemed - paid, 2, "HALF_UP"));
}
pub relation section_83_inclusion_at_transfer_83b(p: Person, asset: us.irc.core::Asset, transfer_date: Date, fmv: Money, paid: Money) kind institutional {
    label en official "the (b) election's effect: FMV at transfer minus amount paid, included for the year of transfer instead of the year of vesting";
}

relation section_83b_election_property_forfeited(p: Person, asset: us.irc.core::Asset) kind empirical {
    label en official "after a section 83(b) election, the property is subsequently forfeited (case-asserted)";
}
pub relation section_83b_forfeiture_deduction_denied(p: Person, asset: us.irc.core::Asset) kind institutional {
    label en official "section 83(b)'s own final sentence: if the property is subsequently forfeited after a (b) election, no deduction is allowed in respect of the forfeiture";
}
@source(IRC_S83_B, quote = "if such property is subsequently forfeited, no deduction shall be allowed in respect of such forfeiture")
rule NoDeductionOnForfeitureAfter83bElection(p: Person, asset: us.irc.core::Asset) strict {
    label en official "section 83(b): no deduction for a post-election forfeiture";
    when section_83b_election_made(p, asset);
    when section_83b_election_property_forfeited(p, asset);
    then section_83b_forfeiture_deduction_denied(p, asset);
}

// =====================================================================
// §83(d): formula-price never-lapsing restrictions
// =====================================================================

relation formula_price_never_lapsing_restriction(p: Person, asset: us.irc.core::Asset) kind empirical {
    label en official "the property is subject to a restriction which by its terms will never lapse and which allows the transferee to sell the property only at a price determined under a formula (section 83(d)(1))";
}
pub relation formula_price_deemed_fmv_83d1(p: Person, asset: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the formula price is deemed to be the fair market value of the property, unless the Secretary establishes the contrary (section 83(d)(1)) — the Secretary's rebuttal is EVALUATIVE (external judgment) and not separately modelled: the deeming rule stands absent a case fact asserting a successful rebuttal";
}
relation formula_price(p: Person, asset: us.irc.core::Asset, amount: Money) kind empirical {
    label en official "the price determined under the (d)(1) formula";
}
external judgment relation secretary_rebutted_formula_price_83d1(p: Person, asset: us.irc.core::Asset) {
    authority Secretary;
    label en official "the Secretary has established, with the burden of proof on the Secretary, that the formula price does not reflect fair market value (section 83(d)(1))";
}
@source(IRC_S83_D, quote = "the price so determined shall be deemed to be the fair market value of the property unless established to the contrary by the Secretary, and the burden of proof shall be on the Secretary with respect to such value")
rule FormulaPriceDeemedFmv(p: Person, asset: us.irc.core::Asset, amount: Money) strict {
    label en official "section 83(d)(1): formula price deemed FMV — this pass does not gate on a rebuttal, since `not_known` cannot test an evaluative relation's absence (DECISION-0194); a case that wants the rebuttal to defeat this rule must not assert `formula_price_never_lapsing_restriction`/`formula_price` in the first place (TECH_GAP: no defeat mechanism for an affirmatively-asserted `secretary_rebutted_formula_price_83d1` fact)";
    when formula_price_never_lapsing_restriction(p, asset);
    when formula_price(p, asset, amount);
    then formula_price_deemed_fmv_83d1(p, asset, amount);
}

relation restriction_canceled_83d2(p: Person, asset: us.irc.core::Asset, cancellation_date: Date) kind empirical {
    label en official "a never-lapsing restriction described in (d)(1) is canceled (section 83(d)(2))";
}
pub relation cancellation_treated_as_compensation_83d2(p: Person, asset: us.irc.core::Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "unless the taxpayer establishes both (A) the cancellation was not compensatory and (B) the person who would otherwise get a deduction will treat it consistently, the excess of unrestricted FMV at cancellation over (restricted FMV immediately before + amount paid for the cancellation) is treated as compensation for the year of cancellation (section 83(d)(2))";
}
relation cancellation_not_compensatory_established_83d2(p: Person, asset: us.irc.core::Asset) kind empirical {
    label en official "the taxpayer has established both the (d)(2)(A) not-compensatory and (d)(2)(B) consistent-treatment conditions (case-asserted; a joint condition per the statute's own \"unless the taxpayer establishes—(A) ... and (B) ...\" wording)";
}
@source(IRC_S83_D, quote = "the excess of the fair market value of the property (computed without regard to the restrictions) at the time of cancellation over the sum of—\n(C) the fair market value of such property (computed by taking the restriction into account) immediately before the cancellation, and\n(D) the amount, if any, paid for the cancellation,\nshall be treated as compensation for the taxable year in which such cancellation occurs")
rule CancellationTreatedAsCompensation(p: Person, asset: us.irc.core::Asset, cancellation_date: Date, y: TaxableYear, unrestricted_fmv: Money, restricted_fmv_before: Money, amount_paid_for_cancellation: Money) strict {
    label en official "section 83(d)(2): the compensation amount on cancellation of a never-lapsing restriction, absent the taxpayer establishing the (A)/(B) exception";
    when restriction_canceled_83d2(p, asset, cancellation_date);
    when not_known(cancellation_not_compensatory_established_83d2(p, asset));
    when not_known(section_83_not_applicable_to_rsu_83i7(asset)); // G6404 wiring: §83(i)(7)
    when unrestricted_fmv_at_cancellation_83d2(p, asset, cancellation_date, unrestricted_fmv);
    when restricted_fmv_before_cancellation_83d2(p, asset, cancellation_date, restricted_fmv_before);
    when amount_paid_for_cancellation_83d2(p, asset, cancellation_date, amount_paid_for_cancellation);
    when unrestricted_fmv > restricted_fmv_before + amount_paid_for_cancellation;
    when us.irc.core::year_of(p, y);
    then cancellation_treated_as_compensation_83d2(p, asset, y, round(unrestricted_fmv - (restricted_fmv_before + amount_paid_for_cancellation), 2, "HALF_UP"));
}
relation unrestricted_fmv_at_cancellation_83d2(p: Person, asset: us.irc.core::Asset, on: Date, amount: Money) kind empirical {
    label en official "fair market value of the property, computed without regard to the restriction, at the time of cancellation (section 83(d)(2)(C) counterpart)";
}
relation restricted_fmv_before_cancellation_83d2(p: Person, asset: us.irc.core::Asset, on: Date, amount: Money) kind empirical {
    label en official "fair market value of the property, computed by taking the restriction into account, immediately before the cancellation (section 83(d)(2)(C))";
}
relation amount_paid_for_cancellation_83d2(p: Person, asset: us.irc.core::Asset, on: Date, amount: Money) kind empirical {
    label en official "the amount, if any, paid for the cancellation (section 83(d)(2)(D))";
}

// =====================================================================
// §83(e): transfers section 83 does not apply to
// =====================================================================

relation transfer_within_421_83e1(p: Person, asset: us.irc.core::Asset) kind empirical {
    label en official "a transaction to which section 421 applies (statutory stock options) — section 83(e)(1)";
}
@source(IRC_S83_E, quote = "(1) a transaction to which section 421 applies,")
rule Exclusion83e1(p: Person, asset: us.irc.core::Asset) strict {
    label en official "section 83(e)(1)";
    when transfer_within_421_83e1(p, asset);
    then section_83_excluded_transfer(p, asset);
}
relation transfer_qualified_trust_or_annuity_plan_83e2(p: Person, asset: us.irc.core::Asset) kind empirical {
    label en official "a transfer to or from a trust described in section 401(a) or a transfer under an annuity plan meeting section 404(a)(2) — section 83(e)(2)";
}
@source(IRC_S83_E, quote = "(2) a transfer to or from a trust described in section 401(a) or a transfer under an annuity plan which meets the requirements of section 404(a)(2),")
rule Exclusion83e2(p: Person, asset: us.irc.core::Asset) strict {
    label en official "section 83(e)(2)";
    when transfer_qualified_trust_or_annuity_plan_83e2(p, asset);
    then section_83_excluded_transfer(p, asset);
}
relation option_without_readily_ascertainable_fmv_83e3(p: Person, asset: us.irc.core::Asset) kind empirical {
    label en official "the transfer of an option without a readily ascertainable fair market value — section 83(e)(3)";
}
@source(IRC_S83_E, quote = "(3) the transfer of an option without a readily ascertainable fair market value,")
rule Exclusion83e3(p: Person, asset: us.irc.core::Asset) strict {
    label en official "section 83(e)(3)";
    when option_without_readily_ascertainable_fmv_83e3(p, asset);
    then section_83_excluded_transfer(p, asset);
}
relation option_exercise_with_ascertainable_fmv_at_grant_83e4(p: Person, asset: us.irc.core::Asset) kind empirical {
    label en official "the transfer of property pursuant to the exercise of an option with a readily ascertainable fair market value at the date of grant — section 83(e)(4) (the value at grant was already taxed under section 83 at that time)";
}
@source(IRC_S83_E, quote = "(4) the transfer of property pursuant to the exercise of an option with a readily ascertainable fair market value at the date of grant, or")
rule Exclusion83e4(p: Person, asset: us.irc.core::Asset) strict {
    label en official "section 83(e)(4)";
    when option_exercise_with_ascertainable_fmv_at_grant_83e4(p, asset);
    then section_83_excluded_transfer(p, asset);
}
relation group_term_life_insurance_79_83e5(p: Person, asset: us.irc.core::Asset) kind empirical {
    label en official "group-term life insurance to which section 79 applies — section 83(e)(5)";
}
@source(IRC_S83_E, quote = "(5) group-term life insurance to which section 79 applies.")
rule Exclusion83e5(p: Person, asset: us.irc.core::Asset) strict {
    label en official "section 83(e)(5)";
    when group_term_life_insurance_79_83e5(p, asset);
    then section_83_excluded_transfer(p, asset);
}

// =====================================================================
// §83(f): holding period
// =====================================================================

pub relation holding_period_starts_83f(p: Person, asset: us.irc.core::Asset, on: Date) kind institutional {
    label en official "the holding period for section 1222 purposes includes only the period beginning at vesting (section 83(f))";
}
@source(IRC_S83_F, quote = "there shall be included only the period beginning at the first time his rights in such property are transferable or are not subject to a substantial risk of forfeiture, whichever occurs earlier")
rule HoldingPeriodStartsAtVesting(p: Person, asset: us.irc.core::Asset, on: Date) strict {
    label en official "section 83(f): the holding period starts at the same vesting event as (a)'s inclusion timing";
    when vesting_date_83(p, asset, on);
    then holding_period_starts_83f(p, asset, on);
}

// =====================================================================
// §83(g): exchange for substantially similar restricted property
// =====================================================================

relation exchange_for_similarly_restricted_property_83g(p: Person, old_asset: us.irc.core::Asset, new_asset: us.irc.core::Asset) kind empirical {
    label en official "property to which section 83(a) applies is exchanged for property subject to substantially similar restrictions and conditions, in an exchange to which section 354, 355, 356, 1036 (or so much of 1031 as relates to 1036) applied, or pursuant to a conversion privilege (section 83(g))";
}
pub relation exchange_disregarded_and_new_property_covered_83g(p: Person, old_asset: us.irc.core::Asset, new_asset: us.irc.core::Asset) kind institutional {
    label en official "the exchange is disregarded for section 83(a) purposes and the newly received property is itself treated as property to which section 83(a) applies (section 83(g)(1)-(2))";
}
@source(IRC_S83_G, quote = "(1) such exchange shall be disregarded for purposes of subsection (a), and\n(2) the property received shall be treated as property to which subsection (a) applies.")
rule ExchangeForSimilarRestrictedProperty(p: Person, old_asset: us.irc.core::Asset, new_asset: us.irc.core::Asset) strict {
    label en official "section 83(g): a qualifying exchange carries the (a) treatment forward to the new property rather than triggering inclusion";
    when exchange_for_similarly_restricted_property_83g(p, old_asset, new_asset);
    then exchange_disregarded_and_new_property_covered_83g(p, old_asset, new_asset);
}

// =====================================================================
// §83(h): employer's deduction
// =====================================================================

pub relation service_recipient_deduction_83h(recipient: Person, p: Person, asset: us.irc.core::Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "a section 162 deduction allowed to the person for whom the services were performed, equal to the amount included in the service-provider's gross income under (a), (b), or (d)(2), for the recipient's taxable year in which or with which the service-provider's year (of inclusion) ends (section 83(h))";
}
@source(IRC_S83_H, quote = "there shall be allowed as a deduction under section 162, to the person for whom were performed the services in connection with which such property was transferred, an amount equal to the amount included under subsection (a), (b), or (d)(2) in the gross income of the person who performed such services")
rule ServiceRecipientDeductionFromInclusion(recipient: Person, p: Person, asset: us.irc.core::Asset, y: TaxableYear, amount: Money) strict {
    label en official "section 83(h): mirrors the (a) inclusion as the recipient's deduction (the (b)/(d)(2) mirrors are separate rules below since they are separate inclusion relations)";
    when section_83_inclusion(p, asset, y, amount);
    when property_transferred_for_services(p, asset, _, _, _);
    when service_performed_for(p, recipient);
    then service_recipient_deduction_83h(recipient, p, asset, y, amount);
}
// G6404 wiring, §83(h): the deduction mirrors the amount included under (a), (b) OR (d)(2); the (d)(2)
// cancellation inclusion is the third source read here.
@source(IRC_S83_H, quote = "there shall be allowed as a deduction under section 162, to the person for whom were performed the services in connection with which such property was transferred, an amount equal to the amount included under subsection (a), (b), or (d)(2)")
rule ServiceRecipientDeductionFromCancellation(recipient: Person, p: Person, asset: us.irc.core::Asset, y: TaxableYear, amount: Money) strict {
    label en official "section 83(h): the deduction mirrors the amount included under (d)(2) on the cancellation of a restriction";
    when cancellation_treated_as_compensation_83d2(p, asset, y, amount);
    when service_performed_for(p, recipient);
    then service_recipient_deduction_83h(recipient, p, asset, y, amount);
}
relation service_performed_for(p: Person, recipient: Person) kind empirical {
    label en official "the person for whom the services connected with the property transfer were performed (section 83(h))";
}
@source(IRC_S83_H, quote = "there shall be allowed as a deduction under section 162, to the person for whom were performed the services in connection with which such property was transferred, an amount equal to the amount included under subsection (a), (b), or (d)(2)")
rule ServiceRecipientDeductionFrom83bElection(recipient: Person, p: Person, asset: us.irc.core::Asset, transfer_date: Date, y: TaxableYear, fmv: Money, paid: Money) strict {
    label en official "section 83(h)'s mirror of a (b)-election inclusion";
    when section_83_inclusion_at_transfer_83b(p, asset, transfer_date, fmv, paid);
    when service_performed_for(p, recipient);
    when us.irc.core::year_of(p, y);
    then service_recipient_deduction_83h(recipient, p, asset, y, round(fmv - paid, 2, "HALF_UP"));
}

// =====================================================================
// §83(i): qualified equity grants — CORE ONLY (election + 30-day timing)
// =====================================================================
//
// TECH_GAP / not modelled: the "eligible corporation" 80%-of-employees
// written-plan test ((i)(2)(C)), the "qualified employee"/"excluded
// employee" 1%-owner and 4-highest-compensated-officer tests ((i)(3)), the
// disqualifying-event tests of (i)(1)(B) clauses (iii)-(v) beyond the 5-year
// outer bound, and the (i)(4)(B)-(C) no-election conditions (prior (b)
// election, readily-tradable stock, buyback proportionality) are none of
// them modelled — each would need its own payroll-census-style aggregate
// this package does not have the underlying data model for (same class as
// the section 105(h)/employment-discrimination TECH_GAPs elsewhere in this
// package group). Only the election's existence and its own 30-day filing
// deadline (squarely a `power`/`valid_when` fact, like section 83(b) above)
// are modelled.

pub relation section_83i_election_made(p: Person, asset: us.irc.core::Asset) kind empirical {
    label en official "the qualified employee elected, under section 83(i), to defer income on qualified stock (case-asserted; the (i)(3) qualified-employee eligibility gate is not separately modelled — TECH_GAP)";
}
relation section_83i_election_date(p: Person, asset: us.irc.core::Asset, first_transferable_or_vested_date: Date, elected_on: Date) kind empirical {
    label en official "the date the section 83(i) election was made, for the (i)(4)(A) 30-day timing test";
}
pub relation section_83i_election_timely(p: Person, asset: us.irc.core::Asset, first_date: Date, elected_on: Date) kind institutional {
    label en official "section 83(i)(4)(A): the election is made no later than 30 days after the first date the employee's rights in the qualified stock are transferable or not subject to a substantial risk of forfeiture, whichever is earlier";
}
@source(IRC_S83_I, quote = "An election with respect to qualified stock shall be made under this subsection no later than 30 days after the first date the rights of the employee in such stock are transferable or are not subject to a substantial risk of forfeiture, whichever occurs earlier")
rule Section83iElectionTimely(p: Person, asset: us.irc.core::Asset, first_date: Date, elected_on: Date) strict {
    label en official "the 30-day filing window, exact boundary, same idiom as section 83(b) above";
    when section_83i_election_date(p, asset, first_date, elected_on);
    when days_between(first_date, elected_on) <= 30;
    then section_83i_election_timely(p, asset, first_date, elected_on);
}
@source(IRC_S83_I, quote = "If qualified stock is transferred to a qualified employee who makes an election with respect to such stock under this subsection, subsection (a) shall be applied by including the amount determined under such subsection")
rule Section83iElectionPower(p: Person, asset: us.irc.core::Asset, first_date: Date, elected_on: Date) strict {
    label en official "section 83(i): the qualified employee's power to defer the (a) inclusion, valid only within the 30-day window (the (i)(1)(B) deferred taxable-year determination itself — earliest of five listed triggering events — is TECH_GAP: this package does not compute an earliest-of-several-dates result, TECH-GAPS G136 class)";
    when section_83i_election_date(p, asset, first_date, elected_on);
    then power Section83iElection {
        holder p;
        over asset;
        exercise section_83i_election_made(p, asset);
        valid_when section_83i_election_permitted(p, asset, first_date, elected_on);
        effect section_83a_deferred_by_83i(p, asset);
    };
}
// G6404 wiring, §83(i)(4)(B): no election may be made for stock in the cases of `election_barred_83i4B`
// (a prior (b) election, readily tradable stock, a buyback without the deferral-stock exception); the single
// `valid_when` atom is this helper, which adds the bar to the 30-day timeliness test.
relation section_83i_election_permitted(p: Person, asset: us.irc.core::Asset, first_date: Date, elected_on: Date) kind institutional {
    label en official "the section 83(i) election is timely (section 83(i)(4)(A)) and not barred by section 83(i)(4)(B)";
}
rule Section83iElectionPermitted(p: Person, asset: us.irc.core::Asset, first_date: Date, elected_on: Date) strict {
    label en official "section 83(i)(4): timely and not barred";
    when section_83i_election_timely(p, asset, first_date, elected_on);
    when not_known(election_barred_83i4B(p, asset));
    then section_83i_election_permitted(p, asset, first_date, elected_on);
}
pub relation section_83a_deferred_by_83i(p: Person, asset: us.irc.core::Asset) kind institutional {
    label en official "the effect of a valid section 83(i) election: section 83(a) does not apply for the taxable year of transfer (deferred to a later year determined under (i)(1)(B), not itself computed by this package — TECH_GAP)";
}
