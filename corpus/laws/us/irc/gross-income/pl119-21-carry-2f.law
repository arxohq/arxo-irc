// Stage 2f (TECH_GAP reduction) — Pub. L. 119-21 carry: §70113(c)-(d) (section 132(g)(2)),
// §70201-70203 (section 63(b)), §70312 (sections 78 and 960(d)), §70309(d) (section 149(b)(3)(F)).
// STATUS: implemented_unverified (static check only; scenarios in tests/pl119-21-carry-2f.lawtest
// are NOT executed). Section 70112 (bicycle reimbursement) and 70309(a)-(c) are carried in
// s2f-b-fringe-and-relief-residuals.law and the bonds-* modules.
//
// Judgment call: the deductions of sections 224, 225 and 163(h)(4) are produced by the
// deductions package; here they are dependency contracts (zero when the case asserts none) so
// that the section 63(b) formula for taxable years beginning after 2024 subtracts them.

language "law.core" version "0.2";
package us.irc.gross_income version "0.1.1";
namespace "urn:us:irc:gross_income:clir";

use self::{
    Individual,
    Person,
    TaxableYear,
    adjusted_gross_income,
    armed_forces_member_moving_under_military_order_pcs_132g2,
    domestic_corporation_chooses_foreign_tax_credit,
    moving_expense_would_be_deductible_under_217_132g1,
    moving_reimbursement_exclusion_suspended_132g2,
    personal_exemption_deduction_151,
    section_170p_deduction,
    section_199a_deduction,
    section_78_gross_up_dividend,
    standard_deduction,
    taxable_income,
    taxable_income_non_itemizer_formula_applies,
};

// =====================================================================
// §70113: section 132(g)(2) after 2025
// =====================================================================

relation intelligence_community_employee_moving_on_reassignment_132g2(employee: Individual, y: TaxableYear) kind empirical {
    label en official "an employee or new appointee of the intelligence community (section 3 of the National Security Act of 1947), other than a member of the Armed Forces, who moves pursuant to a change in assignment that requires relocation";
}
@source(us.irc.temporal::PL119_21_S70113, relation = formalizes, coverage = exact, quote = "(c) Extension of Limitation on Exclusion.—Section 132(g)(2) is amended—")
@source(us.irc.temporal::PL119_21_S70113, relation = formalizes, coverage = exact, quote = "(e) 26 USC 132 note.Effective Date.—The amendments made by this section shall apply to taxable years beginning after December 31, 2025.")
rule MovingReimbursementExclusionSuspendedFrom2026(employee: Individual, y: TaxableYear, b: Date) strict {
    label en official "Pub. L. 119-21 section 70113(c): the limitation of section 132(g)(2) has no end date, so for taxable years beginning after December 31, 2025 subsection (a)(6) does not apply except for a member of the Armed Forces moving under a military order or (section 70113(d)) an intelligence community employee moving on a change in assignment";
    when moving_expense_would_be_deductible_under_217_132g1(_, employee, y, _);
    when us.irc.core::begins(y, b);
    when b > @2025-12-31;
    when not_known(armed_forces_member_moving_under_military_order_pcs_132g2(employee, y));
    when not_known(intelligence_community_employee_moving_on_reassignment_132g2(employee, y));
    then moving_reimbursement_exclusion_suspended_132g2(employee, y);
}

// =====================================================================
// §70201-70203: section 63(b) deductions for non-itemizers
// =====================================================================

pub relation qualified_tips_deduction_224(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the deduction provided in section 224 (qualified tips) — dependency contract, producer: deductions";
}
pub relation qualified_overtime_deduction_225(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the deduction provided in section 225 (qualified overtime compensation) — dependency contract, producer: deductions";
}
pub relation qualified_passenger_vehicle_loan_interest_deduction_163h4(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "so much of the deduction allowed by section 163(a) as is attributable to the exception under section 163(h)(4)(A) — dependency contract, producer: deductions";
}
pub relation new_63b_deductions_asserted(p: Individual, y: TaxableYear) kind institutional {
    label en official "helper: the case asserts at least one of the deductions of section 63(b)(5)-(7)";
}
rule New63bDeductionsAssertedTips(p: Individual, y: TaxableYear, a: Money) strict {
    label en official "helper for section 63(b)(5)";
    when qualified_tips_deduction_224(p, y, a);
    then new_63b_deductions_asserted(p, y);
}
rule New63bDeductionsAssertedOvertime(p: Individual, y: TaxableYear, a: Money) strict {
    label en official "helper for section 63(b)(6)";
    when qualified_overtime_deduction_225(p, y, a);
    then new_63b_deductions_asserted(p, y);
}
rule New63bDeductionsAssertedCarLoan(p: Individual, y: TaxableYear, a: Money) strict {
    label en official "helper for section 63(b)(7)";
    when qualified_passenger_vehicle_loan_interest_deduction_163h4(p, y, a);
    then new_63b_deductions_asserted(p, y);
}
pub relation tips_deduction_or_zero_63b5(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 224 deduction, or zero when none is asserted";
}
@source(us.irc.temporal::PL119_21_S70201, relation = formalizes, coverage = exact, quote = "(5) the deduction provided in section 224.”.")
rule TipsDeductionPresent(p: Individual, y: TaxableYear, a: Money) strict {
    label en official "section 63(b)(5), added by Pub. L. 119-21 section 70201(b)";
    when qualified_tips_deduction_224(p, y, a);
    then tips_deduction_or_zero_63b5(p, y, a);
}
rule TipsDeductionAbsent(p: Individual, y: TaxableYear) strict {
    label en official "section 63(b)(5): none asserted";
    when new_63b_deductions_asserted(p, y);
    when not_known(tips_deduction_asserted_63b5(p, y));
    then tips_deduction_or_zero_63b5(p, y, 0.00 USD);
}
relation tips_deduction_asserted_63b5(p: Individual, y: TaxableYear) kind institutional {
    label en official "helper";
}
rule TipsDeductionAssertedHelper(p: Individual, y: TaxableYear, a: Money) strict {
    label en official "helper";
    when qualified_tips_deduction_224(p, y, a);
    then tips_deduction_asserted_63b5(p, y);
}
pub relation overtime_deduction_or_zero_63b6(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 225 deduction, or zero when none is asserted";
}
@source(us.irc.temporal::PL119_21_S70202, relation = formalizes, coverage = exact, quote = "(6) the deduction provided in section 225.”.")
rule OvertimeDeductionPresent(p: Individual, y: TaxableYear, a: Money) strict {
    label en official "section 63(b)(6), added by Pub. L. 119-21 section 70202(b)";
    when qualified_overtime_deduction_225(p, y, a);
    then overtime_deduction_or_zero_63b6(p, y, a);
}
relation overtime_deduction_asserted_63b6(p: Individual, y: TaxableYear) kind institutional {
    label en official "helper";
}
rule OvertimeDeductionAssertedHelper(p: Individual, y: TaxableYear, a: Money) strict {
    label en official "helper";
    when qualified_overtime_deduction_225(p, y, a);
    then overtime_deduction_asserted_63b6(p, y);
}
rule OvertimeDeductionAbsent(p: Individual, y: TaxableYear) strict {
    label en official "section 63(b)(6): none asserted";
    when new_63b_deductions_asserted(p, y);
    when not_known(overtime_deduction_asserted_63b6(p, y));
    then overtime_deduction_or_zero_63b6(p, y, 0.00 USD);
}
pub relation car_loan_deduction_or_zero_63b7(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 163(h)(4)(A) deduction of section 63(b)(7), or zero when none is asserted";
}
@source(us.irc.temporal::PL119_21_S70203, relation = formalizes, coverage = exact, quote = "(7) so much of the deduction allowed by section 163(a) as is attributable to the exception under section 163(h)(4)(A).”.")
rule CarLoanDeductionPresent(p: Individual, y: TaxableYear, a: Money) strict {
    label en official "section 63(b)(7), added by Pub. L. 119-21 section 70203(b)";
    when qualified_passenger_vehicle_loan_interest_deduction_163h4(p, y, a);
    then car_loan_deduction_or_zero_63b7(p, y, a);
}
relation car_loan_deduction_asserted_63b7(p: Individual, y: TaxableYear) kind institutional {
    label en official "helper";
}
rule CarLoanDeductionAssertedHelper(p: Individual, y: TaxableYear, a: Money) strict {
    label en official "helper";
    when qualified_passenger_vehicle_loan_interest_deduction_163h4(p, y, a);
    then car_loan_deduction_asserted_63b7(p, y);
}
rule CarLoanDeductionAbsent(p: Individual, y: TaxableYear) strict {
    label en official "section 63(b)(7): none asserted";
    when new_63b_deductions_asserted(p, y);
    when not_known(car_loan_deduction_asserted_63b7(p, y));
    then car_loan_deduction_or_zero_63b7(p, y, 0.00 USD);
}
@source(us.irc.temporal::PL119_21_S70201, relation = formalizes, coverage = exact, quote = "Section 63(b) is amended by striking “and” at the end of paragraph (3), by striking the period at the end of paragraph (4) and inserting “, and”, and by adding at the end the following new paragraph:“(5) the deduction provided in section 224.”.")
rule TaxableIncomeNonItemizerFormulaWithNewDeductions(p: Individual, y: TaxableYear, agi: Money, std: Money, exempt: Money, s199a: Money, s170p: Money, tips: Money, overtime: Money, carloan: Money) strict {
    label en official "section 63(b)(1)-(7) after Pub. L. 119-21: for a non-itemizer, taxable income is AGI minus the standard deduction, personal exemptions, the section 199A, 170(p), 224 and 225 deductions and the section 163(h)(4)(A) part of the section 163(a) deduction";
    when taxable_income_non_itemizer_formula_applies(p, y);
    when adjusted_gross_income(p, y, agi);
    when standard_deduction(p, y, std);
    when personal_exemption_deduction_151(p, y, exempt);
    when section_199a_deduction(p, y, s199a);
    when section_170p_deduction(p, y, s170p);
    when tips_deduction_or_zero_63b5(p, y, tips);
    when overtime_deduction_or_zero_63b6(p, y, overtime);
    when car_loan_deduction_or_zero_63b7(p, y, carloan);
    then taxable_income(p, y, agi - std - exempt - s199a - s170p - tips - overtime - carloan);
}

// =====================================================================
// §70312: sections 78 and 960(d)
// =====================================================================

pub relation deemed_paid_credit_percentage_960d1(y: TaxableYear, percentage: Decimal) kind institutional {
    label en official "the percentage of section 960(d)(1): 80 percent, and 90 percent for taxable years beginning after December 31, 2025";
}
@source(us.irc.temporal::PL119_21_S70312, relation = formalizes, coverage = exact, quote = "(1) In general.—Section 960(d)(1) is amended by striking “80 percent” and inserting “90 percent”.")
rule DeemedPaidCreditPercentageFrom2026(y: TaxableYear, b: Date) strict {
    label en official "Pub. L. 119-21 section 70312(a)(1), (c)(1)";
    when tax_year_begins_78(y, b);
    when b > @2025-12-31;
    then deemed_paid_credit_percentage_960d1(y, 0.90);
}
relation tax_year_begins_78(y: TaxableYear, b: Date) kind institutional {
    label en official "helper: the taxable year begins on the date";
}
rule TaxYearBegins78(y: TaxableYear, b: Date) strict {
    label en official "helper";
    when us.irc.core::begins(y, b);
    then tax_year_begins_78(y, b);
}
rule DeemedPaidCreditPercentageBefore2026(y: TaxableYear, b: Date) strict {
    label en official "section 960(d)(1) as before the amendment";
    when tax_year_begins_78(y, b);
    when b <= @2025-12-31;
    then deemed_paid_credit_percentage_960d1(y, 0.80);
}
relation section_78_inputs_78(corp: Person, y: TaxableYear, foreign_corp: Person, deemed_paid_960a: Money, deemed_paid_960b: Money, tested_income_taxes_before_percentage_960d: Money) kind empirical {
    label en official "the taxes deemed paid under section 960(a), section 960(b), and the taxes properly attributable to tested income before the section 960(d)(1) percentage (the section 960 computations belong to the international package: EXTERNAL_DEPENDENCY)";
}
pub relation section_78_amended_inputs_present_78(corp: Person, y: TaxableYear, foreign_corp: Person) kind institutional {
    label en official "helper: the amended inputs are asserted (the earlier single-amount input is then not used)";
}
rule Section78AmendedInputsPresent(corp: Person, y: TaxableYear, fc: Person, a: Money, b: Money, d: Money) strict {
    label en official "helper for section 78";
    when section_78_inputs_78(corp, y, fc, a, b, d);
    then section_78_amended_inputs_present_78(corp, y, fc);
}
pub relation section_78_deemed_paid_amount_78(corp: Person, y: TaxableYear, foreign_corp: Person, amount: Money) kind institutional {
    label en official "the amount of taxes taken into account in the section 78 gross-up: subsections (a), (b) and (d) of section 960 with the 80 percent, and for taxable years beginning after 2025 subsections (a) and (d) only, with the 90 percent";
}
@source(us.irc.temporal::PL119_21_S70312, relation = formalizes, coverage = exact, quote = "(A) by striking “subsections (a), (b), and (d)” and inserting “subsections (a) and (d)”, and")
rule Section78AmountFrom2026(corp: Person, y: TaxableYear, fc: Person, a: Money, b: Money, d: Money, p: Decimal, bd: Date) strict {
    label en official "Pub. L. 119-21 section 70312(a)(2): section 960(b) taxes are no longer grossed up, the 960(d) part at 90 percent";
    when section_78_inputs_78(corp, y, fc, a, b, d);
    when deemed_paid_credit_percentage_960d1(y, p);
    when tax_year_begins_78(y, bd);
    when bd > @2025-12-31;
    then section_78_deemed_paid_amount_78(corp, y, fc, a + round(d * p, 2, "HALF_UP"));
}
rule Section78AmountBefore2026(corp: Person, y: TaxableYear, fc: Person, a: Money, b: Money, d: Money, p: Decimal, bd: Date) strict {
    label en official "section 78 before the amendment: subsections (a), (b) and (d), the 960(d) part at 80 percent";
    when section_78_inputs_78(corp, y, fc, a, b, d);
    when deemed_paid_credit_percentage_960d1(y, p);
    when tax_year_begins_78(y, bd);
    when bd <= @2025-12-31;
    then section_78_deemed_paid_amount_78(corp, y, fc, a + b + round(d * p, 2, "HALF_UP"));
}
@source(us.irc.temporal::PL119_21_S70312, relation = formalizes, coverage = exact, quote = "(B) by striking “80 percent” and inserting “90 percent”.")
rule Section78GrossUpDividendFromAmendedInputs(corp: Person, y: TaxableYear, fc: Person, amount: Money) strict {
    label en official "section 78 with the amended composition of the deemed-paid amount";
    when domestic_corporation_chooses_foreign_tax_credit(corp, y);
    when section_78_deemed_paid_amount_78(corp, y, fc, amount);
    then section_78_gross_up_dividend(corp, y, fc, amount);
}
relation ptep_taxes_960d4(corp: Person, y: TaxableYear, foreign_income_taxes_on_959a_excluded_951a_amounts: Money, paid_or_accrued_after_2025_06_28: Boolean) kind empirical {
    label en official "foreign income taxes paid or accrued (or deemed paid under section 960(b)(1)) with respect to an amount excluded from gross income under section 959(a) by reason of an inclusion under section 951A(a), and whether they were paid or accrued after June 28, 2025";
}
pub relation credit_disallowed_960d4(corp: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "no credit is allowed under section 901 for 10 percent of those taxes";
}
@source(us.irc.temporal::PL119_21_S70312, relation = formalizes, coverage = exact, quote = "No credit shall be allowed under section 901 for 10 percent of any foreign income taxes paid or accrued (or deemed paid under subsection (b)(1)) with respect to any amount excluded from gross income under section 959(a) by reason of an inclusion in gross income under section 951A(a).")
rule CreditDisallowedOnPreviouslyTaxedTestedIncome(corp: Person, y: TaxableYear, taxes: Money) strict {
    label en official "Pub. L. 119-21 section 70312(b), (c)(2): taxes paid or accrued after June 28, 2025";
    when ptep_taxes_960d4(corp, y, taxes, true);
    then credit_disallowed_960d4(corp, y, round(taxes * 0.10, 2, "HALF_UP"));
}

// =====================================================================
// §70309(d): section 149(b)(3)(F)
// =====================================================================

relation us_payments_only_for_use_of_spaceport_149b3F(bond: us.irc.core::Asset) kind empirical {
    label en official "the only basis for treating the bond as federally guaranteed is the payment of rent, user fees, or other charges by the United States (or an agency or instrumentality) in exchange for its use of the spaceport";
}
pub relation bond_not_federally_guaranteed_for_spaceport_payments_149b3F(bond: us.irc.core::Asset) kind institutional {
    label en official "the bond is not treated as federally guaranteed merely because of such payments";
}
@source(us.irc.temporal::PL119_21_S70309, relation = formalizes, coverage = exact, quote = "(d) Exception From Federally Guaranteed Bond Prohibition.—Section 149(b)(3) is amended by adding at the end the following new subparagraph:")
rule SpaceportPaymentsDoNotMakeABondFederallyGuaranteed(bond: us.irc.core::Asset) strict {
    label en official "section 149(b)(3)(F), for obligations issued after July 4, 2025 (section 70309(f))";
    when us_payments_only_for_use_of_spaceport_149b3F(bond);
    then bond_not_federally_guaranteed_for_spaceport_payments_149b3F(bond);
}
