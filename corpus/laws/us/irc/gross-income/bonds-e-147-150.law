// Stage 2f (TECH_GAP reduction) — private activity bonds, fifth part: §147(a), (b), (e), (g),
// (h); §148(b)-(e), (g); §149(c), (e), (f), (g); §150(b)-(e).
// STATUS: implemented_unverified (static check only; scenarios in tests/bonds-e-147-150.lawtest
// are NOT executed).
//
// The derived `issue_meets_147_requirements_derived` feeds §141(e)(3) through the parallel
// rule at the end of the section 147 part.

// =====================================================================
// §147(a): substantial users and related persons
// =====================================================================

use self::{
    BondIssue,
    IRC_S147_A,
    IRC_S147_B,
    IRC_S147_E,
    IRC_S147_G,
    IRC_S147_H,
    IRC_S148_B,
    IRC_S148_C,
    IRC_S148_D,
    IRC_S148_E,
    IRC_S148_G,
    IRC_S149_C,
    IRC_S149_E,
    IRC_S149_F,
    IRC_S149_G,
    IRC_S150_B,
    IRC_S150_C,
    IRC_S150_D,
    IRC_S150_E,
    Individual,
    Person,
    ResidentialRentalProject142,
    Secretary,
    issue_fails_land_acquisition_test_147c1,
    issue_meets_146_volume_cap,
    private_activity_bond,
    public_approval_requirement_satisfied_147f,
    public_educational_facility_conditions_met_142k,
    qualified_501c3_bond_145a,
    qualified_bond_141e,
    qualified_bond_category_141e1,
    qualified_mortgage_issue_143a2A,
    qualified_student_loan_bond_144b_derived,
    qualified_veterans_mortgage_issue_143b,
    section_147cd_disapplied_141d5A,
};

relation persons_loss_disallowance_relation_147a2A(a: Person, b: Person) kind empirical {
    label en official "the relationship between the persons would result in a disallowance of losses under section 267 or 707(b)";
}
relation persons_controlled_group_over_50_percent_147a2B(a: Person, b: Person) kind empirical {
    label en official "the persons are members of the same controlled group of corporations (section 1563(a), more than 50 percent in place of at least 80 percent)";
}
relation partner_of_partnership_147a2C(partner: Person, partnership: Person) kind empirical {
    label en official "the person is a partner (or the spouse or minor child of a partner) of the partnership";
}
relation shareholder_of_s_corporation_147a2D(shareholder: Person, corporation: Person) kind empirical {
    label en official "the person is a shareholder (or the spouse or minor child of a shareholder) of the S corporation";
}
relation related_person_base_147a2(a: Person, b: Person) kind institutional {
    label en official "helper: related in the asserted direction";
}
@source(IRC_S147_A, relation = formalizes, coverage = exact, quote = "(A) 2 or more persons if the relationship between such persons would result in a disallowance of losses under section 267 or 707(b),")
rule RelatedPersonBaseByLossDisallowance(a: Person, b: Person) strict {
    label en official "section 147(a)(2)(A)";
    when persons_loss_disallowance_relation_147a2A(a, b);
    then related_person_base_147a2(a, b);
}
@source(IRC_S147_A, relation = formalizes, coverage = exact, quote = "(B) 2 or more persons which are members of the same controlled group of corporations (as defined in section 1563(a), except that \"more than 50 percent\" shall be")
rule RelatedPersonBaseByControlledGroup(a: Person, b: Person) strict {
    label en official "section 147(a)(2)(B)";
    when persons_controlled_group_over_50_percent_147a2B(a, b);
    then related_person_base_147a2(a, b);
}
@source(IRC_S147_A, relation = formalizes, coverage = exact, quote = "(C) a partnership and each of its partners (and their spouses and minor children), and")
rule RelatedPersonBaseByPartnership(a: Person, b: Person) strict {
    label en official "section 147(a)(2)(C)";
    when partner_of_partnership_147a2C(a, b);
    then related_person_base_147a2(a, b);
}
@source(IRC_S147_A, relation = formalizes, coverage = exact, quote = "(D) an S corporation and each of its shareholders (and their spouses and minor children).")
rule RelatedPersonBaseByS(a: Person, b: Person) strict {
    label en official "section 147(a)(2)(D)";
    when shareholder_of_s_corporation_147a2D(a, b);
    then related_person_base_147a2(a, b);
}
pub relation related_person_147a2(a: Person, b: Person) kind institutional {
    label en official "the persons are related persons within section 147(a)(2), in either order";
}
rule RelatedPersonForward147(a: Person, b: Person) strict {
    label en official "section 147(a)(2), asserted order";
    when related_person_base_147a2(a, b);
    then related_person_147a2(a, b);
}
rule RelatedPersonBackward147(a: Person, b: Person) strict {
    label en official "section 147(a)(2): symmetric";
    when related_person_base_147a2(a, b);
    then related_person_147a2(b, a);
}
relation bond_of_issue_147(bond: us.irc.core::Asset, issue: BondIssue) kind empirical {
    label en official "the private activity bond is part of the issue";
}
relation bond_holder_period_147a1(bond: us.irc.core::Asset, holder: Person, held_from: Date, held_to: Date) kind empirical {
    label en official "a person who holds the bond for the period";
}
relation person_is_substantial_user_147a1(person: Person, issue: BondIssue) kind empirical {
    label en official "the person is a substantial user of the facilities financed by the issue (the definition is left to the regulations of the Secretary: EXTERNAL_DEPENDENCY)";
}
pub relation bond_not_qualified_while_held_by_substantial_user_147a1(bond: us.irc.core::Asset, held_from: Date, held_to: Date) kind institutional {
    label en official "a private activity bond is not a qualified bond for any period during which it is held by a person who is a substantial user of the facilities or by a related person of such a substantial user";
}
@source(IRC_S147_A, relation = formalizes, coverage = exact, quote = "Except as provided in subsection (h), a private activity bond shall not be a qualified bond for any period during which it is held by a person who is a substantial user")
rule NotQualifiedWhenHeldBySubstantialUser(bond: us.irc.core::Asset, issue: BondIssue, holder: Person, from: Date, to: Date) strict {
    label en official "section 147(a)(1), the holder is a substantial user";
    when bond_of_issue_147(bond, issue);
    when bond_holder_period_147a1(bond, holder, from, to);
    when person_is_substantial_user_147a1(holder, issue);
    then bond_not_qualified_while_held_by_substantial_user_147a1(bond, from, to);
}
@source(IRC_S147_A, relation = formalizes, coverage = exact, quote = "Except as provided in subsection (h), a private activity bond shall not be a qualified bond for any period during which it is held by a person who is a substantial user")
rule NotQualifiedWhenHeldByRelatedPersonOfSubstantialUser(bond: us.irc.core::Asset, issue: BondIssue, holder: Person, user: Person, from: Date, to: Date) strict {
    label en official "section 147(a)(1), the holder is related to a substantial user";
    when bond_of_issue_147(bond, issue);
    when bond_holder_period_147a1(bond, holder, from, to);
    when person_is_substantial_user_147a1(user, issue);
    when related_person_147a2(holder, user);
    then bond_not_qualified_while_held_by_substantial_user_147a1(bond, from, to);
}

// =====================================================================
// §147(b): maturity may not exceed 120 percent of economic life
// =====================================================================

relation average_maturity_by_issue_prices_147b2A(issue: BondIssue, years: Decimal) kind empirical {
    label en official "the average maturity of the bonds of the issue, in years, determined by taking into account the respective issue prices of the bonds (the weighting by issue prices is done in the input)";
}
relation nonland_facilities_life_and_cost_147b2B(issue: BondIssue, average_life_years: Decimal, cost: Money) kind empirical {
    label en official "the average reasonably expected economic life of the facilities financed with the net proceeds, land excluded, determined by taking into account the respective costs of the facilities, and their total cost";
}
relation land_cost_and_net_proceeds_147b3B(issue: BondIssue, land_cost: Money, net_proceeds: Money) kind empirical {
    label en official "the cost of the land financed with the net proceeds and the net proceeds of the issue";
}
pub relation economic_life_average_147b(issue: BondIssue, years: Decimal) kind institutional {
    label en official "the average reasonably expected economic life of the facilities financed: land is not taken into account, except that if 25 percent or more of the net proceeds finance land the land is taken into account with an economic life of 30 years";
}
@source(IRC_S147_B, relation = formalizes, coverage = exact, quote = "Except as provided in clause (ii), land shall not be taken into account under paragraph (1)(B).")
rule EconomicLifeExcludingLand(issue: BondIssue, life: Decimal, cost: Money, land: Money, net: Money) strict {
    label en official "section 147(b)(3)(B)(i): land not taken into account below 25 percent of the net proceeds";
    when nonland_facilities_life_and_cost_147b2B(issue, life, cost);
    when land_cost_and_net_proceeds_147b3B(issue, land, net);
    when net > 0.00 USD;
    when land * 4 < net;
    then economic_life_average_147b(issue, life);
}
@source(IRC_S147_B, relation = formalizes, coverage = exact, quote = "If 25 percent or more of the net proceeds of any issue is to be used to finance land, such land shall be taken into account under paragraph (1)(B) and shall be treated")
rule EconomicLifeIncludingLand(issue: BondIssue, life: Decimal, cost: Money, land: Money, net: Money) strict {
    label en official "section 147(b)(3)(B)(ii): land counts with 30 years; cost-weighted average with one rounding to six places HALF_UP";
    when nonland_facilities_life_and_cost_147b2B(issue, life, cost);
    when land_cost_and_net_proceeds_147b3B(issue, land, net);
    when net > 0.00 USD;
    when land * 4 >= net;
    when cost + land > 0.00 USD;
    then economic_life_average_147b(issue, div_round(life * (cost / 1.00 USD) + 30.0 * (land / 1.00 USD), (cost + land) / 1.00 USD, 6, "HALF_UP"));
}
pub relation maturity_exceeds_120_percent_of_life_147b1(issue: BondIssue) kind institutional {
    label en official "the average maturity of the issue exceeds 120 percent of the average reasonably expected economic life of the facilities";
}
@source(IRC_S147_B, relation = formalizes, coverage = exact, quote = "Except as provided in subsection (h), a private activity bond shall not be a qualified bond if it is issued as part of an issue and—")
rule MaturityExceeds120PercentOfLife(issue: BondIssue, maturity: Decimal, life: Decimal) strict {
    label en official "section 147(b)(1)(A)-(B): maturity > 1.2 x life, exact";
    when average_maturity_by_issue_prices_147b2A(issue, maturity);
    when economic_life_average_147b(issue, life);
    when maturity > life * 1.2;
    then maturity_exceeds_120_percent_of_life_147b1(issue);
}
relation economic_life_determination_dates_147b3A(issue: BondIssue, issue_date: Date, placed_in_service_date: Date) kind empirical {
    label en official "the date the bonds are issued and the date the facility is placed in service (or expected to be)";
}
pub relation economic_life_determination_date_147b3A(issue: BondIssue, on: Date) kind institutional {
    label en official "the reasonably expected economic life is determined as of the later of the issue date and the placed-in-service date";
}
@source(IRC_S147_B, relation = formalizes, coverage = exact, quote = "(i) the date on which the bonds are issued, or")
rule EconomicLifeDeterminedAtIssueDate(issue: BondIssue, iss: Date, pis: Date) strict {
    label en official "section 147(b)(3)(A)(i): the issue date is the later";
    when economic_life_determination_dates_147b3A(issue, iss, pis);
    when iss >= pis;
    then economic_life_determination_date_147b3A(issue, iss);
}
@source(IRC_S147_B, relation = formalizes, coverage = exact, quote = "(ii) the date on which the facility is placed in service (or expected to be placed in service).")
rule EconomicLifeDeterminedAtServiceDate(issue: BondIssue, iss: Date, pis: Date) strict {
    label en official "section 147(b)(3)(A)(ii): the placed-in-service date is the later";
    when economic_life_determination_dates_147b3A(issue, iss, pis);
    when pis > iss;
    then economic_life_determination_date_147b3A(issue, pis);
}
relation pooled_501c3_election_facts_147b4(issue: BondIssue, share_loaned_to_2_or_more_organizations: Decimal, each_loan_meets_147b1: Boolean, demand_survey_demand_over_120_percent_of_lendable_proceeds: Boolean, share_loaned_within_one_year: Decimal, unspent_redeemed_within_18_months: Boolean, longest_maturity_years_after_issue: Integer, elected_by_issuer: Boolean) kind empirical {
    label en official "the pooled financing facts of section 147(b)(4)(B): the share of the net proceeds used for loans to 2 or more 501(c)(3) organizations or governmental units, whether each loan (as a separate issue) meets paragraph (1), whether a demand survey showed demand above 120 percent of the lendable proceeds, the share loaned within 1 year, whether unspent proceeds are redeemed within 18 months, the longest maturity of any bond in years after issuance (original issuance for refundings), and the issuer's election";
}
pub relation pooled_501c3_bond_meets_maturity_rule_147b4(issue: BondIssue) kind institutional {
    label en official "a qualified 501(c)(3) bond is treated as meeting paragraph (1) on the issuer's election if it meets the requirements of subparagraph (B): 95 percent for loans to 2 or more organizations, each loan meeting paragraph (1), a demand survey, 95 percent loaned within 1 year and unspent proceeds redeemed within 18 months, and no maturity beyond 30 years";
}
@source(IRC_S147_B, relation = formalizes, coverage = exact, quote = "(i) 95 percent or more of the net proceeds of the issue of which such bond is a part are to be used to make or finance loans to 2 or more 501(c)(3) organizations or")
rule PooledBondMeetsMaturityRule(issue: BondIssue, share1: Decimal, share2: Decimal, years: Integer) strict {
    label en official "section 147(b)(4)(A)-(B)(i)-(iv) and the closing sentence";
    when pooled_501c3_election_facts_147b4(issue, share1, true, true, share2, true, years, true);
    when share1 >= 0.95;
    when share2 >= 0.95;
    when years <= 30;
    then pooled_501c3_bond_meets_maturity_rule_147b4(issue);
}
relation fha_insured_mortgage_issue_147b5(issue: BondIssue, share_of_net_proceeds_for_fha_242_or_similar_loans: Decimal, loan_term_plus_debenture_maturity_exceeds_permitted_term: Boolean) kind empirical {
    label en official "the share of the net proceeds used to finance mortgage loans insured under FHA 242 or a similar Federal Housing Administration program (as in effect on the enactment date of the Tax Reform Act of 1986), and whether the loan term approved by the Administration plus the maximum maturity of debentures it could issue exceeds the term permitted under paragraph (1)";
}
pub relation maturity_rule_does_not_apply_fha_147b5(issue: BondIssue) kind institutional {
    label en official "paragraph (1) does not apply to a bond of such an issue";
}
@source(IRC_S147_B, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall not apply to any bond issued as part of an issue 95 percent or more of the net proceeds of which are to be used to finance mortgage loans insured")
rule MaturityRuleDoesNotApplyForFhaInsuredLoans(issue: BondIssue, share: Decimal) strict {
    label en official "section 147(b)(5)";
    when fha_insured_mortgage_issue_147b5(issue, share, true);
    when share >= 0.95;
    then maturity_rule_does_not_apply_fha_147b5(issue);
}

// =====================================================================
// §147(e), (g): prohibited facilities, issuance costs
// =====================================================================

pub enum ProhibitedFacility147e { Airplane; SkyboxOrPrivateLuxuryBox; HealthClubFacility; GamblingFacility; OffPremisesLiquorStore; OtherFacility; }
relation proceeds_used_for_facility_147e(issue: BondIssue, facility: ProhibitedFacility147e) kind empirical {
    label en official "a portion of the proceeds of the issue is to be used to provide the facility";
}
relation aircraft_is_fixed_wing_acute_care_ems_only_147e(issue: BondIssue) kind empirical {
    label en official "the airplane is a fixed-wing aircraft equipped for, and exclusively dedicated to providing, acute care emergency medical services (within the meaning of section 4261(g)(2))";
}
pub relation prohibited_facility_financed_147e(issue: BondIssue) kind institutional {
    label en official "a portion of the proceeds is to be used to provide an airplane, skybox or private luxury box, health club facility, gambling facility, or off-premises liquor store (an emergency medical services airplane excepted)";
}
@source(IRC_S147_E, relation = formalizes, coverage = exact, quote = "A private activity bond shall not be a qualified bond if issued as part of an issue and any portion of the proceeds of such issue is to be used to provide any airplane,")
rule ProhibitedFacilityAirplane(issue: BondIssue) strict {
    label en official "section 147(e), airplane, with the exception for acute care emergency medical services";
    when proceeds_used_for_facility_147e(issue, Airplane);
    when not_known(aircraft_is_fixed_wing_acute_care_ems_only_147e(issue));
    then prohibited_facility_financed_147e(issue);
}
rule ProhibitedFacilitySkybox(issue: BondIssue) strict {
    label en official "section 147(e), skybox or other private luxury box";
    when proceeds_used_for_facility_147e(issue, SkyboxOrPrivateLuxuryBox);
    then prohibited_facility_financed_147e(issue);
}
rule ProhibitedFacilityHealthClub(issue: BondIssue) strict {
    label en official "section 147(e), health club facility (not for a qualified 501(c)(3) bond, section 147(h)(2), applied below)";
    when proceeds_used_for_facility_147e(issue, HealthClubFacility);
    when not_known(is_501c3_issue_147h2(issue));
    then prohibited_facility_financed_147e(issue);
}
rule ProhibitedFacilityGambling(issue: BondIssue) strict {
    label en official "section 147(e), facility primarily used for gambling";
    when proceeds_used_for_facility_147e(issue, GamblingFacility);
    then prohibited_facility_financed_147e(issue);
}
rule ProhibitedFacilityLiquorStore(issue: BondIssue) strict {
    label en official "section 147(e), a store the principal business of which is the sale of alcoholic beverages for consumption off premises";
    when proceeds_used_for_facility_147e(issue, OffPremisesLiquorStore);
    then prohibited_facility_financed_147e(issue);
}
relation is_501c3_issue_147h2(issue: BondIssue) kind institutional {
    label en official "helper: the issue is a qualified 501(c)(3) bond issue";
}
rule Is501c3Issue147(issue: BondIssue) strict {
    label en official "helper for section 147(h)(2)";
    when qualified_501c3_bond_145a(issue);
    then is_501c3_issue_147h2(issue);
}
relation issuance_costs_and_proceeds_147g(issue: BondIssue, issuance_costs_financed: Money, proceeds: Money) kind empirical {
    label en official "the issuance costs financed by the issue and the proceeds of the issue";
}
pub relation issuance_costs_within_limit_147g(issue: BondIssue) kind institutional {
    label en official "the issuance costs financed by the issue do not exceed 2 percent of the proceeds (3.5 percent for an issue of qualified mortgage bonds or qualified veterans' mortgage bonds whose proceeds do not exceed $20,000,000)";
}
@source(IRC_S147_G, relation = formalizes, coverage = exact, quote = "A private activity bond shall not be a qualified bond if the issuance costs financed by the issue (of which such bond is a part) exceed 2 percent of the proceeds of the")
rule IssuanceCostsWithinTwoPercent(issue: BondIssue, costs: Money, proceeds: Money) strict {
    label en official "section 147(g)(1): exact cross multiplication";
    when issuance_costs_and_proceeds_147g(issue, costs, proceeds);
    when costs * 50 <= proceeds;
    then issuance_costs_within_limit_147g(issue);
}
@source(IRC_S147_G, relation = formalizes, coverage = exact, quote = "In the case of an issue of qualified mortgage bonds or qualified veterans' mortgage bonds, paragraph (1) shall be applied by substituting \"3.5 percent\" for \"2 percent\"")
rule IssuanceCostsWithinThreeAndAHalfPercentForSmallMortgageIssues(issue: BondIssue, costs: Money, proceeds: Money) strict {
    label en official "section 147(g)(2): 3.5 percent for a qualified mortgage or veterans' mortgage issue with proceeds not above $20,000,000";
    when issuance_costs_and_proceeds_147g(issue, costs, proceeds);
    when qualified_mortgage_issue_143a2A(issue);
    when proceeds <= 20000000.00 USD;
    when costs * 1000 <= proceeds * 35;
    then issuance_costs_within_limit_147g(issue);
}
@source(IRC_S147_G, relation = formalizes, coverage = exact, quote = "In the case of an issue of qualified mortgage bonds or qualified veterans' mortgage bonds, paragraph (1) shall be applied by substituting \"3.5 percent\" for \"2 percent\"")
rule IssuanceCostsWithinThreeAndAHalfPercentForSmallVeteransIssues(issue: BondIssue, costs: Money, proceeds: Money) strict {
    label en official "section 147(g)(2), veterans' mortgage issue";
    when issuance_costs_and_proceeds_147g(issue, costs, proceeds);
    when qualified_veterans_mortgage_issue_143b(issue);
    when proceeds <= 20000000.00 USD;
    when costs * 1000 <= proceeds * 35;
    then issuance_costs_within_limit_147g(issue);
}

// =====================================================================
// §147(h) exceptions and the derived requirements status
// =====================================================================

pub relation section_147abcd_exempt_bond_147h1(issue: BondIssue) kind institutional {
    label en official "subsections (a), (b), (c) and (d) do not apply to a qualified mortgage bond, qualified veterans' mortgage bond or qualified student loan bond";
}
@source(IRC_S147_H, relation = formalizes, coverage = exact, quote = "Subsections (a), (b), (c), and (d) shall not apply to any qualified mortgage bond, qualified veterans' mortgage bond, or qualified student loan bond.")
rule Section147abcdExemptForMortgageBonds(issue: BondIssue) strict {
    label en official "section 147(h)(1): qualified mortgage bond";
    when qualified_mortgage_issue_143a2A(issue);
    then section_147abcd_exempt_bond_147h1(issue);
}
rule Section147abcdExemptForVeteransBonds(issue: BondIssue) strict {
    label en official "section 147(h)(1): qualified veterans' mortgage bond";
    when qualified_veterans_mortgage_issue_143b(issue);
    then section_147abcd_exempt_bond_147h1(issue);
}
rule Section147abcdExemptForStudentLoanBonds(issue: BondIssue) strict {
    label en official "section 147(h)(1): qualified student loan bond";
    when qualified_student_loan_bond_144b_derived(issue);
    then section_147abcd_exempt_bond_147h1(issue);
}
pub relation section_147acd_exempt_bond_147h2(issue: BondIssue) kind institutional {
    label en official "subsections (a), (c) and (d) do not apply to a qualified 501(c)(3) bond (and subsection (e) is applied without the health club words)";
}
@source(IRC_S147_H, relation = formalizes, coverage = exact, quote = "Subsections (a), (c), and (d) shall not apply to any qualified 501(c)(3) bond and subsection (e) shall be applied as if it did not contain \"health club facility\" with")
rule Section147acdExemptFor501c3Bonds(issue: BondIssue) strict {
    label en official "section 147(h)(2)";
    when qualified_501c3_bond_145a(issue);
    then section_147acd_exempt_bond_147h2(issue);
}
pub relation section_147c_exempt_public_educational_147h3(issue: BondIssue) kind institutional {
    label en official "subsection (c) does not apply to an exempt facility bond of an issue described in section 142(a)(13) (qualified public educational facilities)";
}
@source(IRC_S147_H, relation = formalizes, coverage = exact, quote = "Subsection (c) shall not apply to any exempt facility bond issued as part of an issue described in section 142(a)(13) (relating to qualified public educational")
rule Section147cExemptForPublicEducational(issue: BondIssue) strict {
    label en official "section 147(h)(3)";
    when public_educational_facility_conditions_met_142k(issue);
    then section_147c_exempt_public_educational_147h3(issue);
}
relation issue_needs_147_review(issue: BondIssue) kind empirical {
    label en official "the issue is a private activity bond issue whose section 147 requirements are tested";
}
pub relation issue_fails_147_requirement(issue: BondIssue) kind institutional {
    label en official "the issue fails a requirement of section 147 not excepted by (h)";
}
@source(IRC_S147_B, relation = formalizes, coverage = exact, quote = "Except as provided in subsection (h), a private activity bond shall not be a qualified bond if it is issued as part of an issue and—")
rule IssueFailsMaturityRule(issue: BondIssue) strict {
    label en official "section 147(b)(1) failure not excepted by (h)(1), (b)(4), (b)(5)";
    when maturity_exceeds_120_percent_of_life_147b1(issue);
    when not_known(section_147abcd_exempt_bond_147h1(issue));
    when not_known(pooled_501c3_bond_meets_maturity_rule_147b4(issue));
    when not_known(maturity_rule_does_not_apply_fha_147b5(issue));
    then issue_fails_147_requirement(issue);
}
@source(IRC_S147_E, relation = formalizes, coverage = exact, quote = "A private activity bond shall not be a qualified bond if issued as part of an issue and any portion of the proceeds of such issue is to be used to provide any airplane,")
rule IssueFailsProhibitedFacilityRule(issue: BondIssue) strict {
    label en official "section 147(e)";
    when prohibited_facility_financed_147e(issue);
    then issue_fails_147_requirement(issue);
}
@source(IRC_S147_G, relation = formalizes, coverage = exact, quote = "A private activity bond shall not be a qualified bond if the issuance costs financed by the issue (of which such bond is a part) exceed 2 percent of the proceeds of the")
rule IssueFailsIssuanceCostRule(issue: BondIssue, costs: Money, proceeds: Money) strict {
    label en official "section 147(g)";
    when issuance_costs_and_proceeds_147g(issue, costs, proceeds);
    when not_known(issuance_costs_within_limit_147g(issue));
    then issue_fails_147_requirement(issue);
}
@source(IRC_S147_A, relation = formalizes, coverage = exact, quote = "Except as provided in subsection (h), a private activity bond shall not be a qualified bond for any period during which it is held by a person who is a substantial user")
rule IssueFailsSubstantialUserRule(issue: BondIssue, bond: us.irc.core::Asset, from: Date, to: Date) strict {
    label en official "section 147(a)(1) not excepted by (h)(1), (h)(2)";
    when bond_of_issue_147(bond, issue);
    when bond_not_qualified_while_held_by_substantial_user_147a1(bond, from, to);
    when not_known(section_147abcd_exempt_bond_147h1(issue));
    when not_known(section_147acd_exempt_bond_147h2(issue));
    then issue_fails_147_requirement(issue);
}
@source(IRC_S147_H, relation = formalizes, coverage = exact, quote = "Subsections (a), (b), (c), and (d) shall not apply to any qualified mortgage bond, qualified veterans' mortgage bond, or qualified student loan bond.")
rule IssueFailsLandAcquisitionRule(issue: BondIssue) strict {
    label en official "section 147(c)(1) not excepted by (h), (d)(5), 144(c)(8), 141(d)(5)";
    when issue_fails_land_acquisition_test_147c1(issue);
    when not_known(section_147abcd_exempt_bond_147h1(issue));
    when not_known(section_147acd_exempt_bond_147h2(issue));
    when not_known(section_147c_exempt_public_educational_147h3(issue));
    when not_known(section_147cd_disapplied_141d5A(issue));
    then issue_fails_147_requirement(issue);
}
pub relation issue_meets_147_requirements_derived(issue: BondIssue) kind institutional {
    label en official "the issue meets the requirements of section 147: it is under review and no requirement is failed, and the public approval requirement is satisfied";
}
@source(IRC_S147_H, relation = formalizes, coverage = exact, quote = "Subsections (a), (b), (c), and (d) shall not apply to any qualified mortgage bond, qualified veterans' mortgage bond, or qualified student loan bond.")
rule IssueMeets147RequirementsDerived(issue: BondIssue) strict {
    label en official "section 141(e)(3) read with the derived section 147 statuses";
    when issue_needs_147_review(issue);
    when not_known(issue_fails_147_requirement(issue));
    when public_approval_requirement_satisfied_147f(issue);
    then issue_meets_147_requirements_derived(issue);
}
@source(IRC_S147_H, relation = formalizes, coverage = exact, quote = "Subsections (a), (b), (c), and (d) shall not apply to any qualified mortgage bond, qualified veterans' mortgage bond, or qualified student loan bond.")
rule QualifiedBondDefinedFromDerivedRequirements(issue: BondIssue) strict {
    label en official "section 141(e) with the derived 147 status: private activity bond, a category, the volume cap (case fact) and the derived section 147 requirements";
    when private_activity_bond(issue);
    when qualified_bond_category_141e1(issue);
    when issue_meets_146_volume_cap(issue);
    when issue_meets_147_requirements_derived(issue);
    then qualified_bond_141e(issue);
}

// =====================================================================
// §148(b): higher yielding investments and investment property
// =====================================================================

pub enum InvestmentPropertyKind148 { SecurityUnder165g2AOrB; ObligationKind; AnnuityContractKind; InvestmentTypeProperty; OutOfJurisdictionResidentialRentalProperty; TaxExemptBondKind; SpecifiedPrivateActivityBondKind; OtherProperty; }
relation asset_kind_148b2(asset: us.irc.core::Asset, kind: InvestmentPropertyKind148) kind empirical {
    label en official "the kind of property under section 148(b)(2)-(3)";
}
relation bond_issue_for_148b(issue: BondIssue, is_private_activity_bond_issue: Boolean, part_is_specified_pab_57a5C: Boolean) kind empirical {
    label en official "whether the issue is an issue of private activity bonds, and whether a part of the issue is a specified private activity bond (section 57(a)(5)(C))";
}
relation residential_rental_outside_jurisdiction_not_desegregation_148b2E(asset: us.irc.core::Asset) kind empirical {
    label en official "the residential rental property for family units is not located within the jurisdiction of the issuer and is not acquired to implement a court ordered or approved housing desegregation plan";
}
relation asset_held_by_issue_148b(issue: BondIssue, asset: us.irc.core::Asset) kind empirical {
    label en official "the asset is acquired with proceeds of the issue";
}
pub relation investment_property_148b2(issue: BondIssue, asset: us.irc.core::Asset) kind institutional {
    label en official "investment property within section 148(b)(2)-(4) for the issue";
}
@source(IRC_S148_B, relation = formalizes, coverage = exact, quote = "(A) any security (within the meaning of section 165(g)(2)(A) or (B)),")
rule InvestmentPropertySecurity(issue: BondIssue, asset: us.irc.core::Asset) strict {
    label en official "section 148(b)(2)(A)";
    when asset_held_by_issue_148b(issue, asset);
    when asset_kind_148b2(asset, SecurityUnder165g2AOrB);
    then investment_property_148b2(issue, asset);
}
@source(IRC_S148_B, relation = formalizes, coverage = exact, quote = "(B) any obligation,")
rule InvestmentPropertyObligation(issue: BondIssue, asset: us.irc.core::Asset) strict {
    label en official "section 148(b)(2)(B)";
    when asset_held_by_issue_148b(issue, asset);
    when asset_kind_148b2(asset, ObligationKind);
    then investment_property_148b2(issue, asset);
}
@source(IRC_S148_B, relation = formalizes, coverage = exact, quote = "(C) any annuity contract,")
rule InvestmentPropertyAnnuity(issue: BondIssue, asset: us.irc.core::Asset) strict {
    label en official "section 148(b)(2)(C)";
    when asset_held_by_issue_148b(issue, asset);
    when asset_kind_148b2(asset, AnnuityContractKind);
    then investment_property_148b2(issue, asset);
}
@source(IRC_S148_B, relation = formalizes, coverage = exact, quote = "(D) any investment-type property, or")
rule InvestmentPropertyInvestmentType(issue: BondIssue, asset: us.irc.core::Asset) strict {
    label en official "section 148(b)(2)(D), investment-type property not within the natural gas safe harbor of (b)(4)(A)";
    when asset_held_by_issue_148b(issue, asset);
    when asset_kind_148b2(asset, InvestmentTypeProperty);
    when not_known(qualified_natural_gas_prepayment_148b4(asset));
    then investment_property_148b2(issue, asset);
}
@source(IRC_S148_B, relation = formalizes, coverage = exact, quote = "(E) in the case of a bond other than a private activity bond, any residential rental property for family units which is not located within the jurisdiction of the issuer")
rule InvestmentPropertyOutOfJurisdictionRental(issue: BondIssue, asset: us.irc.core::Asset) strict {
    label en official "section 148(b)(2)(E): only for a bond other than a private activity bond";
    when asset_held_by_issue_148b(issue, asset);
    when asset_kind_148b2(asset, OutOfJurisdictionResidentialRentalProperty);
    when residential_rental_outside_jurisdiction_not_desegregation_148b2E(asset);
    when bond_issue_for_148b(issue, false, _);
    then investment_property_148b2(issue, asset);
}
@source(IRC_S148_B, relation = formalizes, coverage = exact, quote = "With respect to an issue other than an issue a part of which is a specified private activity bond (as defined in section 57(a)(5)(C)), the term \"investment property\"")
rule InvestmentPropertySpecifiedPab(issue: BondIssue, asset: us.irc.core::Asset) strict {
    label en official "section 148(b)(3)(B): a specified private activity bond is investment property for an issue no part of which is a specified private activity bond; (A): other tax-exempt bonds are not";
    when asset_held_by_issue_148b(issue, asset);
    when asset_kind_148b2(asset, SpecifiedPrivateActivityBondKind);
    when bond_issue_for_148b(issue, _, false);
    then investment_property_148b2(issue, asset);
}
external judgment relation yield_materially_higher_than_issue_yield_148b1(asset: us.irc.core::Asset) {
    authority Secretary;
    label en official "the investment property produces a yield over the term of the issue which is materially higher than the yield on the issue (section 148(b)(1)): an evaluative element left to the regulations and rulings of the Secretary, DECISION-0194 channel";
}
pub relation higher_yielding_investment_148b1(issue: BondIssue, asset: us.irc.core::Asset) kind institutional {
    label en official "a higher yielding investment: investment property producing a yield materially higher than the yield on the issue";
}
@source(IRC_S148_B, relation = formalizes, coverage = exact, quote = "The term \"higher yielding investments\" means any investment property which produces a yield over the term of the issue which is materially higher than the yield on the")
rule HigherYieldingInvestmentDefined(issue: BondIssue, asset: us.irc.core::Asset) strict {
    label en official "section 148(b)(1)";
    when investment_property_148b2(issue, asset);
    when yield_materially_higher_than_issue_yield_148b1(asset);
    then higher_yielding_investment_148b1(issue, asset);
}

// §148(b)(4): prepaid natural gas
relation natural_gas_contract_facts_148b4B(asset: us.irc.core::Asset, annual_amount_permitted_under_contract: Decimal, testing_period_average_purchases_by_service_area_customers: Decimal, transport_amount: Decimal, gas_for_generation_counted_148b4C: Decimal, added_new_business_customers_amount_148b4Di: Decimal, expected_annual_amount_of_current_customers_148b4Dii: Decimal, ruling_increase_148b4E: Decimal, reduction_for_gas_on_hand_and_rights_148b4F: Decimal) kind empirical {
    label en official "the annual amount of natural gas permitted to be acquired under the contract, the annual average during the testing period purchased (other than for resale) by customers in the service area, the transport amount, the gas used to generate electricity that counts under (C), the additional amount for new business customers (D)(i), the amount reasonably expected to be purchased by current customers (D)(ii), the Secretary's ruling increase (E), and the reductions of (F)";
}
relation gas_utility_owned_by_governmental_unit_148b4B(asset: us.irc.core::Asset) kind empirical {
    label en official "the contract is to acquire natural gas for resale by a utility owned by a governmental unit";
}
relation utility_intentional_act_to_exceed_needs_148b4G(asset: us.irc.core::Asset) kind empirical {
    label en official "the utility engages in any intentional act to render the volume of natural gas acquired by the prepayment in excess of the sum of the customers' needs and the transport amount";
}
pub relation qualified_natural_gas_prepayment_148b4(asset: us.irc.core::Asset) kind institutional {
    label en official "a prepayment under a qualified natural gas supply contract: the annual amount permitted does not exceed the customer average (capped at the amount current customers are expected to buy, plus the new-customer and ruling increases) plus the transport amount, less the reductions; the safe harbor ceases if the utility acts intentionally to exceed the needs";
}
@source(IRC_S148_B, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the term \"qualified natural gas supply contract\" means any contract to acquire natural gas for resale by a utility owned by a")
rule QualifiedNaturalGasPrepayment(asset: us.irc.core::Asset, permitted: Decimal, avg: Decimal, transport: Decimal, gen: Decimal, added: Decimal, expected: Decimal, ruling: Decimal, reduction: Decimal) strict {
    label en official "section 148(b)(4)(A)-(F): permitted <= (min(average + generation, expected) + added + ruling) + transport - reductions; here the average includes the (C) generation gas";
    when gas_utility_owned_by_governmental_unit_148b4B(asset);
    when natural_gas_contract_facts_148b4B(asset, permitted, avg, transport, gen, added, expected, ruling, reduction);
    when not_known(utility_intentional_act_to_exceed_needs_148b4G(asset));
    when permitted <= min(avg + gen, expected) + added + ruling + transport - reduction;
    then qualified_natural_gas_prepayment_148b4(asset);
}
relation service_area_facts_148b4I(utility: Person, provided_services_throughout_during_testing_period: Boolean, county_contiguous_area_with_retail_customers_not_served_by_other_utility: Boolean, recognized_under_state_or_federal_law: Boolean) kind empirical {
    label en official "the areas that make up the utility's service area: an area throughout which it provided natural gas transmission or distribution (or electricity distribution) at all times during the testing period, a contiguous county area with its retail customers not served by another utility, and an area recognized as its service area under State or Federal law";
}
pub relation service_area_component_148b4I(utility: Person, component: Integer) kind institutional {
    label en official "the area component that belongs to the service area (1: the testing period area, 2: the contiguous county area, 3: the recognized area)";
}
@source(IRC_S148_B, relation = formalizes, coverage = exact, quote = "(i) any area throughout which such utility provided at all times during the testing period—")
rule ServiceAreaTestingPeriodComponent(utility: Person, contiguous: Boolean, recognized: Boolean) strict {
    label en official "section 148(b)(4)(I)(i)";
    when service_area_facts_148b4I(utility, true, contiguous, recognized);
    then service_area_component_148b4I(utility, 1);
}
@source(IRC_S148_B, relation = formalizes, coverage = exact, quote = "(ii) any area within a county contiguous to the area described in clause (i) in which retail customers of such utility are located if such area is not also served by")
rule ServiceAreaContiguousCountyComponent(utility: Person, testing: Boolean, recognized: Boolean) strict {
    label en official "section 148(b)(4)(I)(ii)";
    when service_area_facts_148b4I(utility, testing, true, recognized);
    then service_area_component_148b4I(utility, 2);
}
@source(IRC_S148_B, relation = formalizes, coverage = exact, quote = "(iii) any area recognized as the service area of such utility under State or Federal law.")
rule ServiceAreaRecognizedComponent(utility: Person, testing: Boolean, contiguous: Boolean) strict {
    label en official "section 148(b)(4)(I)(iii)";
    when service_area_facts_148b4I(utility, testing, contiguous, true);
    then service_area_component_148b4I(utility, 3);
}
relation issue_date_and_testing_years_148b4H(issue: BondIssue, issued_on: Date, first_year: Integer, last_year: Integer) kind empirical {
    label en official "the date of issuance and the calendar years of the testing period";
}
pub relation testing_period_148b4H(issue: BondIssue, first_year: Integer, last_year: Integer) kind institutional {
    label en official "the testing period: the most recent 5 calendar years ending before the date of issuance";
}
@source(IRC_S148_B, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the term \"qualified natural gas supply contract\" means any contract to acquire natural gas for resale by a utility owned by a")
rule TestingPeriodIsFiveYears(issue: BondIssue, issued: Date, first: Integer, last: Integer) strict {
    label en official "section 148(b)(4)(H): five calendar years, the last ending before the issue date";
    when issue_date_and_testing_years_148b4H(issue, issued, first, last);
    when last - first == 4;
    then testing_period_148b4H(issue, first, last);
}
pub relation section_148b4_safe_harbor_ceases_148b4G(asset: us.irc.core::Asset) kind institutional {
    label en official "subparagraph (A) ceases to apply to the issue when the utility acts intentionally to render the acquired volume above the needs of the service area customers plus transport";
}
@source(IRC_S148_B, relation = formalizes, coverage = exact, quote = "Subparagraph (A) shall cease to apply to any issue if the utility owned by the governmental unit engages in any intentional act to render the volume of natural gas")
rule SafeHarborCeasesOnIntentionalAct(asset: us.irc.core::Asset) strict {
    label en official "section 148(b)(4)(G)";
    when utility_intentional_act_to_exceed_needs_148b4G(asset);
    then section_148b4_safe_harbor_ceases_148b4G(asset);
}

// =====================================================================
// §148(c)(2), (d)(2), (e): temporary period, reserve funds, the $100,000 exception
// =====================================================================

relation loan_proceeds_temporary_period_148c2(issue: BondIssue, months_of_temporary_period_claimed: Integer, loans_to_2_or_more_persons: Boolean, from_repayment_of_loan: Boolean, construction_loans_2_year_rule: Boolean, mortgage_bond_issue: Boolean) kind empirical {
    label en official "the temporary period claimed in months, whether the proceeds finance loans (other than nonpurpose investments) to 2 or more persons, whether they come from the repayment of a loan and are to finance another loan, whether the loans are for construction expenditures with rules similar to (f)(4)(C)(v), and whether the issue is a qualified mortgage bond or qualified veterans' mortgage bond";
}
pub relation temporary_period_limit_months_148c2(issue: BondIssue, months: Integer) kind institutional {
    label en official "the maximum temporary period: 6 months for loan proceeds to 2 or more persons, 3 months for proceeds from loan repayments used for another loan, 2 years for construction loans; none of these for a qualified mortgage bond or qualified veterans' mortgage bond";
}
@source(IRC_S148_C, relation = formalizes, coverage = exact, quote = "The temporary period referred to in paragraph (1) shall not exceed 6 months with respect to the proceeds of an issue which are to be used to make or finance loans (other")
rule TemporaryPeriodSixMonths(issue: BondIssue, months: Integer) strict {
    label en official "section 148(c)(2)(A)";
    when loan_proceeds_temporary_period_148c2(issue, months, true, false, false, false);
    then temporary_period_limit_months_148c2(issue, 6);
}
@source(IRC_S148_C, relation = formalizes, coverage = exact, quote = "Subparagraph (A) shall be applied by substituting \"3 months\" for \"6 months\" with respect to the proceeds from the sale or repayment of any loan which are to be used to")
rule TemporaryPeriodThreeMonthsForRepayments(issue: BondIssue, months: Integer) strict {
    label en official "section 148(c)(2)(B): 3 months in place of 6 for proceeds from the sale or repayment of a loan used to finance another loan (a nonpurpose investment is not a loan)";
    when loan_proceeds_temporary_period_148c2(issue, months, true, true, false, false);
    then temporary_period_limit_months_148c2(issue, 3);
}
@source(IRC_S148_C, relation = formalizes, coverage = exact, quote = "In the case of an issue described in subparagraph (A) any portion of which is used to make or finance loans for construction expenditures (within the meaning of")
rule TemporaryPeriodTwoYearsForConstructionLoans(issue: BondIssue, months: Integer) strict {
    label en official "section 148(c)(2)(C)(ii): 2 years in place of 6 months for the construction portion";
    when loan_proceeds_temporary_period_148c2(issue, months, true, false, true, false);
    then temporary_period_limit_months_148c2(issue, 24);
}
pub relation temporary_period_exceeds_limit_148c2(issue: BondIssue) kind institutional {
    label en official "the temporary period claimed exceeds the maximum";
}
@source(IRC_S148_C, relation = formalizes, coverage = exact, quote = "This paragraph shall not apply to any qualified mortgage bond or qualified veterans' mortgage bond.")
rule TemporaryPeriodExceedsLimit(issue: BondIssue, claimed: Integer, limit: Integer, f2: Boolean, f3: Boolean, f4: Boolean) strict {
    label en official "section 148(c)(2)(A)-(D): the paragraph does not apply to mortgage bonds (asserted by the last flag false)";
    when loan_proceeds_temporary_period_148c2(issue, claimed, f2, f3, f4, false);
    when temporary_period_limit_months_148c2(issue, limit);
    when claimed > limit;
    then temporary_period_exceeds_limit_148c2(issue);
}
relation reserve_or_replacement_fund_148d2(issue: BondIssue, fund_from_sale_proceeds: Money, issue_proceeds: Money, higher_amount_established_necessary_to_secretary: Money) kind empirical {
    label en official "the amount of the proceeds of the issue's sale which is part of any reserve or replacement fund, the proceeds of the issue, and any higher amount the issuer establishes is necessary to the satisfaction of the Secretary (zero when none)";
}
pub relation arbitrage_bond_by_reserve_fund_148d2(issue: BondIssue) kind institutional {
    label en official "a bond is an arbitrage bond if the reserve or replacement fund from the sale proceeds exceeds 10 percent of the proceeds (or the higher amount established as necessary)";
}
@source(IRC_S148_D, relation = formalizes, coverage = exact, quote = "A bond issued as part of an issue shall be treated as an arbitrage bond if the amount of the proceeds from the sale of such issue which is part of any reserve or")
rule ArbitrageBondByReserveFund(issue: BondIssue, fund: Money, proceeds: Money, higher: Money) strict {
    label en official "section 148(d)(2): the fund exceeds the greater of 10 percent and the established amount";
    when reserve_or_replacement_fund_148d2(issue, fund, proceeds, higher);
    when fund > max(round(proceeds * 0.10, 2, "HALF_UP"), higher);
    then arbitrage_bond_by_reserve_fund_148d2(issue);
}
relation additional_higher_yielding_investment_148e(issue: BondIssue, amount_invested_in_higher_yielding_investments: Money, proceeds: Money) kind empirical {
    label en official "the amount of the proceeds invested in higher yielding investments beyond those permitted by subsections (c) and (d), and the proceeds of the issue";
}
pub relation arbitrage_bond_exception_148e(issue: BondIssue) kind institutional {
    label en official "a bond is not an arbitrage bond solely because a further amount of proceeds is invested in higher yielding investments if it does not exceed the lesser of 5 percent of the proceeds and $100,000";
}
@source(IRC_S148_E, relation = formalizes, coverage = exact, quote = "Notwithstanding subsections (a), (c), and (d), a bond issued as part of an issue shall not be treated as an arbitrage bond solely by reason of the fact that an amount of")
rule ArbitrageBondException100000(issue: BondIssue, amount: Money, proceeds: Money) strict {
    label en official "section 148(e)(1)-(2): not above the lesser of 5 percent and $100,000";
    when additional_higher_yielding_investment_148e(issue, amount, proceeds);
    when amount <= min(round(proceeds * 0.05, 2, "HALF_UP"), 100000.00 USD);
    then arbitrage_bond_exception_148e(issue);
}
relation student_loan_special_allowance_payment_148g(issue: BondIssue, payment: Money) kind empirical {
    label en official "payments made by the Secretary of Education under section 438 of the Higher Education Act of 1965 (except as provided in regulations)";
}
relation yield_on_student_loan_notes_148g(issue: BondIssue, yield_including_payments: Decimal, yield_excluding_payments: Decimal) kind empirical {
    label en official "the yield on student loan notes with and without the special allowance payments";
}
pub relation student_loan_yield_for_148a1_148g(issue: BondIssue, yield_used: Decimal) kind institutional {
    label en official "the yield on student loan notes for section 148(a)(1) is determined without taking the section 438 payments into account";
}
@source(IRC_S148_G, relation = formalizes, coverage = exact, quote = "Except to the extent otherwise provided in regulations, payments made by the Secretary of Education pursuant to section 438 of the Higher Education Act of 1965 are not")
rule StudentLoanYieldExcludesSpecialAllowance(issue: BondIssue, payment: Money, with_p: Decimal, without_p: Decimal) strict {
    label en official "section 148(g)";
    when student_loan_special_allowance_payment_148g(issue, payment);
    when yield_on_student_loan_notes_148g(issue, with_p, without_p);
    then student_loan_yield_for_148a1_148g(issue, without_p);
}

// =====================================================================
// §149(c), (e): federal-law exemption limit; information reporting
// =====================================================================

relation bond_exemption_facts_149c(bond: us.irc.core::Asset, exempt_without_provision_outside_title_or_revenue_act: Boolean, issued_after_1983: Boolean, requirements_of_part_met: Boolean, described_in_149c2C: Boolean) kind empirical {
    label en official "whether the interest is exempt under this title without regard to any provision of law which is not contained in this title (or a revenue Act), whether the bond is issued after 1983, whether the appropriate requirements of this part are met, and whether it is a bond described in (2)(C) (Northwest Power Act, section 608(a)(6)(A) of Pub. L. 97-468, or issued before June 19, 1984 under section 11(b) of the United States Housing Act of 1937)";
}
pub relation bond_exemption_recognized_149c(bond: us.irc.core::Asset) kind institutional {
    label en official "no interest on a bond is exempt under this title unless it is exempt without regard to provisions outside this title; the exception of (2) for bonds issued after 1983 requires the requirements of this part to be met, and a (2)(C) bond is treated as described in (2)(A)";
}
@source(IRC_S149_C, relation = formalizes, coverage = exact, quote = "Except as provided in paragraph (2), no interest on any bond shall be exempt from taxation under this title unless such interest is exempt from tax under this title")
rule BondExemptionRecognizedWithoutOutsideProvision(bond: us.irc.core::Asset, issued_after_1983: Boolean, met: Boolean, c2: Boolean) strict {
    label en official "section 149(c)(1)";
    when bond_exemption_facts_149c(bond, true, issued_after_1983, met, c2);
    then bond_exemption_recognized_149c(bond);
}
@source(IRC_S149_C, relation = formalizes, coverage = exact, quote = "Subparagraph (A) shall not apply to a bond (not described in subparagraph (C)) issued after 1983 if the appropriate requirements of this part (or the corresponding")
rule BondExemptionRecognizedByOutsideProvisionWhenPartMet(bond: us.irc.core::Asset, ok: Boolean, c2: Boolean) strict {
    label en official "section 149(c)(2)(A)-(B): the outside-title provision is respected only if, for a bond issued after 1983 not described in (C), the requirements of this part are met";
    when bond_exemption_facts_149c(bond, false, true, true, false);
    then bond_exemption_recognized_149c(bond);
}
@source(IRC_S149_C, relation = formalizes, coverage = exact, quote = "A bond is described in this subparagraph (and treated as described in subparagraph (A)) if—")
rule BondExemptionRecognizedForSubparagraphCBonds(bond: us.irc.core::Asset, ok: Boolean, issued: Boolean, met: Boolean) strict {
    label en official "section 149(c)(2)(C): treated as described in subparagraph (A)";
    when bond_exemption_facts_149c(bond, false, issued, met, true);
    then bond_exemption_recognized_149c(bond);
}
@source(IRC_S149_C, relation = formalizes, coverage = exact, quote = "Subparagraph (A) shall not apply to a bond (not described in subparagraph (C)) issued after 1983 if the appropriate requirements of this part (or the corresponding")
rule BondExemptionRecognizedForPre1984Bonds(bond: us.irc.core::Asset) strict {
    label en official "section 149(c)(2)(A): a bond not issued after 1983 keeps the outside-title exemption";
    when bond_exemption_facts_149c(bond, false, false, false, false);
    then bond_exemption_recognized_149c(bond);
}
relation issue_statement_facts_149e2(issue: BondIssue, issuer_name_and_address: Boolean, issue_particulars: Boolean, approving_representative_or_referendum: Boolean, principal_users_with_eins: Boolean, property_description: Boolean, state_official_certification_of_146: Boolean, other_information_required_by_secretary: Boolean) kind empirical {
    label en official "the contents of the statement of section 149(e)(2): (A) issuer name and address, (B) date of issue, net proceeds, rate, term, face amounts, issuance costs and reserves, (C) the approving elected representative or referendum (private activity bonds), (D) name, address and EIN of each initial principal user, the common parent of its affiliated group, and any person treated as a principal user under section 144(a)(6)(B) (private activity bonds), (E) a description of the property financed, (F) the State official's certification that section 146 is met, if applicable, and (G) other information the Secretary requires";
}
relation statement_deadline_and_submission_149e2(issue: BondIssue, deadline: Date, submitted_on: Date) kind empirical {
    label en official "the 15th day of the 2d calendar month after the close of the calendar quarter in which the bond is issued (or the later time the Secretary prescribes for any portion), and the date the statement is submitted";
}
relation bond_is_private_activity_bond_issue_149e(issue: BondIssue) kind empirical {
    label en official "the bond is a private activity bond (subparagraphs (C) and (D) of the statement apply only to private activity bonds)";
}
pub relation information_statement_requirement_met_149e2(issue: BondIssue) kind institutional {
    label en official "the issuer submits, on time, a statement with the required contents";
}
@source(IRC_S149_E, relation = formalizes, coverage = exact, quote = "A bond satisfies the requirements of this paragraph if the issuer submits to the Secretary, not later than the 15th day of the 2d calendar month after the close of the")
rule InformationStatementRequirementMetPrivateActivityBond(issue: BondIssue, deadline: Date, submitted: Date) strict {
    label en official "section 149(e)(2)(A)-(G) for a private activity bond";
    when bond_is_private_activity_bond_issue_149e(issue);
    when issue_statement_facts_149e2(issue, true, true, true, true, true, true, true);
    when statement_deadline_and_submission_149e2(issue, deadline, submitted);
    when submitted <= deadline;
    then information_statement_requirement_met_149e2(issue);
}
@source(IRC_S149_E, relation = formalizes, coverage = exact, quote = "Subparagraphs (C) and (D) shall not apply to any bond which is not a private activity bond. The Secretary may provide that certain information specified in the 1st")
rule InformationStatementRequirementMetOtherBond(issue: BondIssue, deadline: Date, submitted: Date, c: Boolean, d: Boolean, f: Boolean) strict {
    label en official "section 149(e)(2), closing sentence: subparagraphs (C) and (D) do not apply to a bond that is not a private activity bond";
    when issue_statement_facts_149e2(issue, true, true, c, d, true, f, true);
    when statement_deadline_and_submission_149e2(issue, deadline, submitted);
    when not_known(bond_is_private_activity_bond_issue_149e(issue));
    when submitted <= deadline;
    then information_statement_requirement_met_149e2(issue);
}
relation issuer_of_bond_149e(issue: BondIssue, issuer: Person) kind empirical {
    label en official "the issuer of the issue";
}
relation statement_submitted_149e2(issue: BondIssue) kind empirical {
    label en official "the issuer has submitted the statement to the Secretary";
}
relation statement_due_date_149e2(issue: BondIssue, due: Date) kind empirical {
    label en official "the due date of the statement (15th day of the 2d calendar month after the quarter's close)";
}
relation issue_date_149e2(issue: BondIssue, issued_on: Date) kind empirical {
    label en official "the date the bond is issued";
}
@source(IRC_S149_E, relation = formalizes, coverage = exact, quote = "A bond satisfies the requirements of this paragraph if the issuer submits to the Secretary, not later than the 15th day of the 2d calendar month after the close of the")
rule Section149e2StatementDutyRule strict {
    for issue: BondIssue;
    for issuer: Person;
    for issued: Date;
    for due: Date;
    when issuer_of_bond_149e(issue, issuer)
        and issue_date_149e2(issue, issued)
        and statement_due_date_149e2(issue, due);
    then duty Section149e2StatementDuty {
        bearer issuer;
        beneficiary Secretary;
        goal achievement {
            condition statement_submitted_149e2(issue);
            window [issued, due];
        }
    };
}
relation failure_to_file_timely_not_due_to_willful_neglect_149e3(issue: BondIssue) kind empirical {
    label en official "the failure to file the statement in a timely fashion is not due to willful neglect";
}
relation secretary_grants_extension_149e3(issue: BondIssue) kind empirical {
    label en official "the Secretary grants an extension of time for filing the statement";
}
pub relation filing_extension_granted_149e3(issue: BondIssue) kind institutional {
    label en official "an extension of time for filing the statement is in effect";
}
@source(IRC_S149_E, relation = formalizes, coverage = exact, quote = "The Secretary may grant an extension of time for the filing of any statement required under paragraph (2) if the failure to file in a timely fashion is not due to")
rule Section149e3ExtensionRule defeasible {
    for issue: BondIssue;
    when statement_due_date_149e2(issue, _)
        and failure_to_file_timely_not_due_to_willful_neglect_149e3(issue);
    then power Section149e3Extension {
        holder Secretary;
        over issue;
        exercise secretary_grants_extension_149e3(issue);
        valid_when failure_to_file_timely_not_due_to_willful_neglect_149e3(issue);
        effect create(filing_extension_granted_149e3(issue));
        window [-infinity, infinity];
    };
}

// =====================================================================
// §149(f): pooled financing bonds; §149(g): hedge bonds
// =====================================================================

relation pooled_financing_facts_149f6(issue: BondIssue, proceeds_used_for_loans_to_2_or_more_ultimate_borrowers: Money, section_146_applies_or_would_but_for_146i: Boolean, section_143l3_applies: Boolean) kind empirical {
    label en official "the proceeds reasonably expected to be used (or intentionally used) to make or finance loans to 2 or more ultimate borrowers, whether section 146 applies to the issue (or would but for 146(i)), and whether section 143(l)(3) applies";
}
pub relation pooled_financing_bond_149f6(issue: BondIssue) kind institutional {
    label en official "a pooled financing bond: more than $5,000,000 of the proceeds are reasonably expected to be used for loans to 2 or more ultimate borrowers, unless the volume cap or section 143(l)(3) applies";
}
@source(IRC_S149_F, relation = formalizes, coverage = exact, quote = "The term \"pooled financing bond\" means any bond issued as part of an issue more than $5,000,000 of the proceeds of which are reasonably expected (at the time of the")
rule PooledFinancingBondDefined(issue: BondIssue, amount: Money) strict {
    label en official "section 149(f)(6)(A)-(B)";
    when pooled_financing_facts_149f6(issue, amount, false, false);
    when amount > 5000000.00 USD;
    then pooled_financing_bond_149f6(issue);
}
relation reasonable_expectations_149f2(issue: BondIssue, share_lent_within_1_year: Decimal, share_lent_within_3_years: Decimal, expectations_disregard_rate_and_law_changes: Boolean) kind empirical {
    label en official "the shares of the net proceeds the issuer reasonably expects to have been used to make or finance loans to ultimate borrowers at the close of the 1-year and 3-year periods beginning on the date of issuance, with expectations as to changes in interest rates or in the provisions of this title not taken into account";
}
pub relation pooled_lending_expectations_met_149f2(issue: BondIssue) kind institutional {
    label en official "at least 30 percent within 1 year and at least 95 percent within 3 years are reasonably expected to be lent";
}
@source(IRC_S149_F, relation = formalizes, coverage = exact, quote = "The requirements of this paragraph are met with respect to an issue if the issuer reasonably expects that—")
rule PooledLendingExpectationsMet(issue: BondIssue, s1: Decimal, s3: Decimal) strict {
    label en official "section 149(f)(2)(A)(i)-(ii), (B)";
    when reasonable_expectations_149f2(issue, s1, s3, true);
    when s1 >= 0.30;
    when s3 >= 0.95;
    then pooled_lending_expectations_met_149f2(issue);
}
relation legal_and_underwriting_costs_149f3(issue: BondIssue, costs_are_contingent: Boolean, share_of_expected_costs_paid_by_day_180: Decimal) kind empirical {
    label en official "whether the payment of legal and underwriting costs is contingent, and the share of the reasonably expected costs paid not later than the 180th day after issuance";
}
pub relation pooled_cost_requirement_met_149f3(issue: BondIssue) kind institutional {
    label en official "the payment of legal and underwriting costs is not contingent and at least 95 percent of the expected costs are paid by the 180th day";
}
@source(IRC_S149_F, relation = formalizes, coverage = exact, quote = "The requirements of this paragraph are met with respect to an issue if—")
rule PooledCostRequirementMet(issue: BondIssue, share: Decimal) strict {
    label en official "section 149(f)(3)(A)-(B)";
    when legal_and_underwriting_costs_149f3(issue, false, share);
    when share >= 0.95;
    then pooled_cost_requirement_met_149f3(issue);
}
relation written_loan_commitments_149f4(issue: BondIssue, share_of_net_proceeds_identified_by_commitments: Decimal, issuer_is_state_lending_to_subordinate_units: Boolean, issuer_is_state_revolving_fund_entity: Boolean) kind empirical {
    label en official "the share of the net proceeds covered by written loan commitments received before issuance that identify the ultimate potential borrowers, whether the issuer is a State (or integral part) lending to subordinate governmental units, and whether it is a State-created entity providing water infrastructure financing through the State revolving fund program";
}
pub relation pooled_commitments_requirement_met_149f4(issue: BondIssue) kind institutional {
    label en official "the issuer received before issuance written loan commitments identifying ultimate potential borrowers for at least 30 percent of the net proceeds, or is one of the excepted issuers";
}
@source(IRC_S149_F, relation = formalizes, coverage = exact, quote = "The requirement of this paragraph is met with respect to an issue if the issuer receives prior to issuance written loan commitments identifying the ultimate potential")
rule PooledCommitmentsRequirementMetByCommitments(issue: BondIssue, share: Decimal, a: Boolean, b: Boolean) strict {
    label en official "section 149(f)(4)(A)";
    when written_loan_commitments_149f4(issue, share, a, b);
    when share >= 0.30;
    then pooled_commitments_requirement_met_149f4(issue);
}
@source(IRC_S149_F, relation = formalizes, coverage = exact, quote = "(i) is a State (or an integral part of a State) issuing pooled financing bonds to make or finance loans to subordinate governmental units of such State, or")
rule PooledCommitmentsRequirementMetByStateLender(issue: BondIssue, share: Decimal, b: Boolean) strict {
    label en official "section 149(f)(4)(B)(i)";
    when written_loan_commitments_149f4(issue, share, true, b);
    then pooled_commitments_requirement_met_149f4(issue);
}
@source(IRC_S149_F, relation = formalizes, coverage = exact, quote = "Subparagraph (A) shall not apply with respect to any issuer which—")
rule PooledCommitmentsRequirementMetByRevolvingFundEntity(issue: BondIssue, share: Decimal, a: Boolean) strict {
    label en official "section 149(f)(4)(B)(ii)";
    when written_loan_commitments_149f4(issue, share, a, true);
    then pooled_commitments_requirement_met_149f4(issue);
}
relation lent_share_and_redemption_149f5(issue: BondIssue, required_percentage_by_period_end: Money, actually_used_by_period_end: Money, redeemed_within_90_days_after_period: Money) kind empirical {
    label en official "the amount required to be used by the close of the period under (2)(A)(i) or (ii), the amount actually used, and the amount of proceeds used to redeem outstanding bonds within 90 days after the end of the period";
}
pub relation pooled_redemption_requirement_met_149f5(issue: BondIssue) kind institutional {
    label en official "to the extent less than the required percentage is used by the close of the period, the issuer redeems bonds with an amount equal to the shortfall within 90 days after the period";
}
@source(IRC_S149_F, relation = formalizes, coverage = exact, quote = "The requirement of this paragraph is met if to the extent that less than the percentage of the proceeds of an issue required to be used under clause (i) or (ii) of")
rule PooledRedemptionRequirementMet(issue: BondIssue, required: Money, used: Money, redeemed: Money) strict {
    label en official "section 149(f)(5)(A)-(B): the redeemed amount covers the shortfall (a period with no shortfall needs no redemption: the redemption is then zero)";
    when lent_share_and_redemption_149f5(issue, required, used, redeemed);
    when redeemed >= max(0.00 USD, round(required - used, 2, "HALF_UP"));
    then pooled_redemption_requirement_met_149f5(issue);
}
pub relation pooled_financing_requirements_met_149f1(issue: BondIssue) kind institutional {
    label en official "section 103(a) applies to the pooled financing bond: the requirements of paragraphs (2), (3), (4) and (5) are met";
}
@source(IRC_S149_F, relation = formalizes, coverage = exact, quote = "Section 103(a) shall not apply to any pooled financing bond unless, with respect to the issue of which such bond is a part, the requirements of paragraphs (2), (3), (4),")
rule PooledFinancingRequirementsMet(issue: BondIssue) strict {
    label en official "section 149(f)(1)";
    when pooled_lending_expectations_met_149f2(issue);
    when pooled_cost_requirement_met_149f3(issue);
    when pooled_commitments_requirement_met_149f4(issue);
    when pooled_redemption_requirement_met_149f5(issue);
    then pooled_financing_requirements_met_149f1(issue);
}
relation ultimate_borrower_use_149f7(issue: BondIssue, loan_is_nonpurpose_investment: Boolean, use_by_agency_not_political_subdivision_or_instrumentality: Boolean) kind empirical {
    label en official "a use of the proceeds that is a nonpurpose investment (section 148(f)(6)(A), determined without regard to section 148(b)(3)) or a use by an agency of the issuer that is not a political subdivision or instrumentality of the issuer";
}
pub relation ultimate_borrower_loan_excluded_149f7(issue: BondIssue) kind institutional {
    label en official "the use is not a loan to an ultimate borrower for the pooled financing test";
}
@source(IRC_S149_F, relation = formalizes, coverage = exact, quote = "(i) any loan which is a nonpurpose investment (within the meaning of section 148(f)(6)(A), determined without regard to section 148(b)(3)), and")
rule NonpurposeInvestmentNotAnUltimateBorrowerLoan(issue: BondIssue, agency: Boolean) strict {
    label en official "section 149(f)(7)(A)(i)";
    when ultimate_borrower_use_149f7(issue, true, agency);
    then ultimate_borrower_loan_excluded_149f7(issue);
}
@source(IRC_S149_F, relation = formalizes, coverage = exact, quote = "(ii) any use of proceeds by an agency of the issuer unless such agency is a political subdivision or instrumentality of the issuer.")
rule AgencyUseNotAnUltimateBorrowerLoan(issue: BondIssue, nonpurpose: Boolean) strict {
    label en official "section 149(f)(7)(A)(ii)";
    when ultimate_borrower_use_149f7(issue, nonpurpose, true);
    then ultimate_borrower_loan_excluded_149f7(issue);
}
relation spendable_proceeds_expectations_149g2(issue: BondIssue, within_1_year: Decimal, within_2_years: Decimal, within_3_years: Decimal, within_5_years: Decimal) kind empirical {
    label en official "the shares of the spendable proceeds the issuer reasonably expects to be spent for the governmental purposes within 1, 2, 3 and 5 years from the date of issue";
}
pub relation hedge_bond_spending_expectations_met_149g2(issue: BondIssue) kind institutional {
    label en official "at least 10 percent in 1 year, 30 percent in 2 years, 60 percent in 3 years and 85 percent in 5 years are reasonably expected to be spent";
}
@source(IRC_S149_G, relation = formalizes, coverage = exact, quote = "An issue meets the requirement of this paragraph if the issuer reasonably expects that—")
rule HedgeBondSpendingExpectationsMet(issue: BondIssue, y1: Decimal, y2: Decimal, y3: Decimal, y5: Decimal) strict {
    label en official "section 149(g)(2)(A)-(D)";
    when spendable_proceeds_expectations_149g2(issue, y1, y2, y3, y5);
    when y1 >= 0.10;
    when y2 >= 0.30;
    when y3 >= 0.60;
    when y5 >= 0.85;
    then hedge_bond_spending_expectations_met_149g2(issue);
}
relation hedge_bond_facts_149g3(issue: BondIssue, spendable_within_3_years: Decimal, share_in_guaranteed_yield_nonpurpose_investments_4_years_or_more: Decimal, ninety_five_percent_in_tax_exempt_non_specified_pab_bonds: Boolean) kind empirical {
    label en official "the share of the spendable proceeds the issuer reasonably expects to use within 3 years, the share of the proceeds invested in nonpurpose investments with a substantially guaranteed yield of 4 years or more, and whether 95 percent of the net proceeds are invested in bonds the interest on which is excluded under section 103 and which are not specified private activity bonds";
}
pub relation hedge_bond_149g3(issue: BondIssue) kind institutional {
    label en official "a hedge bond: not (85 percent of the spendable proceeds expected to be used within 3 years and not more than 50 percent invested in long guaranteed-yield nonpurpose investments), and not an issue 95 percent invested in tax-exempt non-specified-private-activity bonds";
}
@source(IRC_S149_G, relation = formalizes, coverage = exact, quote = "(i) the issuer reasonably expects that 85 percent of the spendable proceeds of the issue will be used to carry out the governmental purposes of the issue within the")
rule HedgeBondDefined(issue: BondIssue, s3: Decimal, g: Decimal) strict {
    label en official "section 149(g)(3)(A)-(B): the bond is a hedge bond unless the 85 percent and the 50 percent tests are met, or the 95 percent investment exception applies";
    when hedge_bond_facts_149g3(issue, s3, g, false);
    when not_known(hedge_bond_tests_met_149g3A(issue));
    then hedge_bond_149g3(issue);
}
pub relation hedge_bond_tests_met_149g3A(issue: BondIssue) kind institutional {
    label en official "the issuer reasonably expects 85 percent of the spendable proceeds to be used within 3 years and not more than 50 percent is invested in long guaranteed-yield nonpurpose investments";
}
@source(IRC_S149_G, relation = formalizes, coverage = exact, quote = "(i) the issuer reasonably expects that 85 percent of the spendable proceeds of the issue will be used to carry out the governmental purposes of the issue within the")
rule HedgeBondTestsMet(issue: BondIssue, s3: Decimal, g: Decimal, x: Boolean) strict {
    label en official "section 149(g)(3)(A)(i)-(ii)";
    when hedge_bond_facts_149g3(issue, s3, g, x);
    when s3 >= 0.85;
    when g <= 0.50;
    then hedge_bond_tests_met_149g3A(issue);
}
relation refunding_bond_of_hedge_149g3C(refunding: BondIssue, original_met_requirements: Boolean, original_outside_subsection: Boolean, avg_maturity_not_later: Boolean, amount_not_above_outstanding: Boolean, original_expected_85_within_5_but_not_3: Boolean, original_85_spent_before_refunding: Boolean) kind empirical {
    label en official "the refunding bond's facts: the original bond met the requirements, or (subsection did not apply to it and average maturity and amount conditions hold), or (the original was expected to spend 85 percent within 5 years but not within 3, and at least 85 percent was spent before the refunding bonds are issued)";
}
pub relation refunding_bond_treated_as_meeting_149g3C(refunding: BondIssue) kind institutional {
    label en official "a refunding bond is treated as meeting the hedge bond requirements";
}
@source(IRC_S149_G, relation = formalizes, coverage = exact, quote = "A refunding bond shall be treated as meeting the requirements of this subsection only if the original bond met such requirements.")
rule RefundingBondMeetsBecauseOriginalDid(refunding: BondIssue, a: Boolean, b: Boolean, c: Boolean, d: Boolean, e: Boolean) strict {
    label en official "section 149(g)(3)(C)(i)";
    when refunding_bond_of_hedge_149g3C(refunding, true, a, b, c, d, e);
    then refunding_bond_treated_as_meeting_149g3C(refunding);
}
@source(IRC_S149_G, relation = formalizes, coverage = exact, quote = "A refunding bond shall be treated as meeting the requirements of this subsection if—")
rule RefundingBondMeetsByMaturityAndAmount(refunding: BondIssue, a: Boolean, b: Boolean, c: Boolean, d: Boolean, e: Boolean) strict {
    label en official "section 149(g)(3)(C)(ii)(I)-(III)";
    when refunding_bond_of_hedge_149g3C(refunding, a, true, true, true, b, c);
    then refunding_bond_treated_as_meeting_149g3C(refunding);
}
@source(IRC_S149_G, relation = formalizes, coverage = exact, quote = "A refunding bond shall be treated as meeting the requirements of this subsection if—")
rule RefundingBondMeetsByEightyFiveSpent(refunding: BondIssue, a: Boolean, b: Boolean, c: Boolean, d: Boolean) strict {
    label en official "section 149(g)(3)(C)(iii)(I)-(III)";
    when refunding_bond_of_hedge_149g3C(refunding, a, true, b, c, true, true);
    then refunding_bond_treated_as_meeting_149g3C(refunding);
}
relation debt_service_fund_or_short_holding_149g3Bii(issue: BondIssue, amount_in_bona_fide_debt_service_fund: Money, amount_held_30_days_or_less_pending_reinvestment_or_redemption: Money, net_proceeds: Money, invested_in_qualifying_bonds: Money) kind empirical {
    label en official "amounts in a bona fide debt service fund and amounts held for not more than 30 days pending reinvestment or redemption, the net proceeds, and the amount invested in bonds the interest on which is excluded under section 103 (not specified private activity bonds)";
}
pub relation ninety_five_percent_invested_in_tax_exempt_bonds_149g3B(issue: BondIssue) kind institutional {
    label en official "95 percent of the net proceeds are invested in qualifying tax-exempt bonds, counting bona fide debt service fund amounts and amounts held for not more than 30 days as invested in such bonds";
}
@source(IRC_S149_G, relation = formalizes, coverage = exact, quote = "Such term shall not include any bond issued as part of an issue 95 percent of the net proceeds of which are invested in bonds—")
rule NinetyFivePercentInvestedInTaxExemptBonds(issue: BondIssue, dsf: Money, held: Money, net: Money, invested: Money) strict {
    label en official "section 149(g)(3)(B)(i)-(iii)";
    when debt_service_fund_or_short_holding_149g3Bii(issue, dsf, held, net, invested);
    when net > 0.00 USD;
    when (invested + dsf + held) * 100 >= net * 95;
    then ninety_five_percent_invested_in_tax_exempt_bonds_149g3B(issue);
}
pub relation hedge_bond_requirements_met_149g1(issue: BondIssue) kind institutional {
    label en official "section 103(a) applies to the hedge bond: paragraph (2) and subsection (f)(3) are met, or the bond is not a hedge bond";
}
@source(IRC_S149_G, relation = formalizes, coverage = exact, quote = "Section 103(a) shall not apply to any hedge bond unless, with respect to the issue of which such bond is a part—")
rule HedgeBondRequirementsMet(issue: BondIssue) strict {
    label en official "section 149(g)(1)(A)-(B)";
    when hedge_bond_spending_expectations_met_149g2(issue);
    when pooled_cost_requirement_met_149f3(issue);
    then hedge_bond_requirements_met_149g1(issue);
}
relation construction_project_schedule_request_149g4(issue: BondIssue, construction_period_years: Integer, requested_by_issuer: Boolean, spending_over_reasonable_schedule_expected: Boolean) kind empirical {
    label en official "a construction project with a construction period of more than 5 years, the issuer's request, and whether it is reasonably expected that the proceeds will be spent over a reasonable construction schedule specified in the request";
}
pub relation secretary_may_treat_spending_requirement_met_149g4(issue: BondIssue) kind institutional {
    label en official "the Secretary may, at the issuer's request, treat the requirement of paragraph (2) as met for the spendable proceeds of a construction project over 5 years (the Secretary's act itself is EXTERNAL_DEPENDENCY)";
}
@source(IRC_S149_G, relation = formalizes, coverage = exact, quote = "The Secretary may, at the request of any issuer, provide that the requirement of paragraph (2) shall be treated as met with respect to the portion of the spendable")
rule SecretaryMayTreatSpendingRequirementMet(issue: BondIssue, years: Integer) strict {
    label en official "section 149(g)(4)(A)";
    when construction_project_schedule_request_149g4(issue, years, true, true);
    when years > 5;
    then secretary_may_treat_spending_requirement_met_149g4(issue);
}

// =====================================================================
// §150(b)-(e)
// =====================================================================

relation financed_residence_149_150b1(residence: us.irc.core::Asset, financing: us.irc.core::Asset) kind empirical {
    label en official "financing provided from the proceeds of a tax-exempt qualified mortgage bond or qualified veterans' mortgage bond for the residence";
}
relation residence_not_principal_residence_of_any_mortgagor_from_150b1(residence: us.irc.core::Asset, from: Date, until: Date) kind empirical {
    label en official "the residence is not the principal residence of at least 1 of the mortgagors who received the financing, from the date to the date it again is";
}
relation secretary_finds_undue_hardship_150b1B(residence: us.irc.core::Asset) kind empirical {
    label en official "the Secretary determines that the application would result in undue hardship and that the failure resulted from circumstances beyond the mortgagor's control";
}
relation interest_accrued_on_financing_150(financing: us.irc.core::Asset, accrued_on: Date, amount: Money) kind empirical {
    label en official "interest that accrues on the financing on the date";
}
pub relation interest_deduction_denied_150b(financing: us.irc.core::Asset, accrued_on: Date, amount: Money, paragraph: Integer) kind institutional {
    label en official "no deduction is allowed under this chapter for the interest accrued on the date, by reason of the given paragraph of section 150(b)";
}
@source(IRC_S150_B, relation = formalizes, coverage = exact, quote = "In the case of any residence with respect to which financing is provided from the proceeds of a tax-exempt qualified mortgage bond or qualified veterans' mortgage bond,")
rule InterestDeniedMortgageResidenceVacant(residence: us.irc.core::Asset, financing: us.irc.core::Asset, from: Date, until: Date, on: Date, amount: Money) strict {
    label en official "section 150(b)(1)(A): a continuous period of at least 1 year of non-residence; interest accruing during the period is not deductible (unless (B) hardship)";
    when financed_residence_149_150b1(residence, financing);
    when residence_not_principal_residence_of_any_mortgagor_from_150b1(residence, from, until);
    when until >= add_calendar_period(from, 1 calendar_year);
    when interest_accrued_on_financing_150(financing, on, amount);
    when on >= from;
    when on < until;
    when not_known(secretary_finds_undue_hardship_150b1B(residence));
    then interest_deduction_denied_150b(financing, on, amount, 1);
}
relation project_purported_142a7_bond_financing_150b2(financing: us.irc.core::Asset, project: ResidentialRentalProject142) kind empirical {
    label en official "financing provided from the proceeds of a private activity bond which, when issued, purported to be a tax-exempt bond described in section 142(a)(7)";
}
relation project_fails_142d_from_150b2(project: ResidentialRentalProject142, first_day_of_year_of_failure: Date, meets_again_on: Date) kind empirical {
    label en official "the project fails the requirements of section 142(d) beginning with the first day of the taxable year of failure, and meets them again on the date";
}
@source(IRC_S150_B, relation = formalizes, coverage = exact, quote = "In the case of any project for residential rental property—")
rule InterestDeniedRentalProjectFailing(financing: us.irc.core::Asset, project: ResidentialRentalProject142, from: Date, until: Date, on: Date, amount: Money) strict {
    label en official "section 150(b)(2)";
    when project_purported_142a7_bond_financing_150b2(financing, project);
    when project_fails_142d_from_150b2(project, from, until);
    when interest_accrued_on_financing_150(financing, on, amount);
    when on >= from;
    when on < until;
    then interest_deduction_denied_150b(financing, on, amount, 2);
}
relation facility_used_by_other_than_501c3_or_government_while_owned_by_501c3_150b3(financing: us.irc.core::Asset, used_from: Date, used_until: Date, fair_rental_value_for_period: Money) kind empirical {
    label en official "a facility financed by a bond that purported to be a qualified 501(c)(3) bond is used in the trade or business of a person other than a 501(c)(3) organization or a governmental unit while still owned by a 501(c)(3) organization, the period, and the fair rental value of that portion for the period";
}
relation gross_income_attributable_to_portion_150b3A(financing: us.irc.core::Asset, gross_income: Money) kind empirical {
    label en official "the gross income attributable to the portion for the period";
}
@source(IRC_S150_B, relation = formalizes, coverage = exact, quote = "No deduction shall be allowed under this chapter for interest on financing described in subparagraph (A) which accrues during the period beginning on the date such")
rule InterestDeniedWhileUsedByNon501c3(financing: us.irc.core::Asset, from: Date, until: Date, fair: Money, on: Date, amount: Money) strict {
    label en official "section 150(b)(3)(B)";
    when facility_used_by_other_than_501c3_or_government_while_owned_by_501c3_150b3(financing, from, until, fair);
    when interest_accrued_on_financing_150(financing, on, amount);
    when on >= from;
    when on < until;
    then interest_deduction_denied_150b(financing, on, amount, 3);
}
pub relation unrelated_business_income_of_owner_150b3A(financing: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the owner of the portion is treated as engaged in an unrelated trade or business with respect to it; the gross income attributable to the portion is not less than the fair rental value for the period";
}
@source(IRC_S150_B, relation = formalizes, coverage = exact, quote = "In the case of any facility with respect to which financing is provided from the proceeds of any private activity bond which, when issued, purported to be a tax-exempt")
rule UnrelatedBusinessIncomeNotLessThanFairRentalValue(financing: us.irc.core::Asset, from: Date, until: Date, fair: Money, income: Money) strict {
    label en official "section 150(b)(3)(A), last sentence";
    when facility_used_by_other_than_501c3_or_government_while_owned_by_501c3_150b3(financing, from, until, fair);
    when gross_income_attributable_to_portion_150b3A(financing, income);
    then unrelated_business_income_of_owner_150b3A(financing, max(income, fair));
}
relation facility_not_used_for_exempt_purpose_150b4(financing: us.irc.core::Asset, not_used_from: Date, used_again_on: Date) kind empirical {
    label en official "the facility is not used for a purpose for which a tax-exempt bond could be issued on the date of the issue, from the date to the date it is so used again";
}
relation bond_purported_exempt_facility_not_142a7_or_small_issue_150b4B(financing: us.irc.core::Asset) kind empirical {
    label en official "the bond, when issued, purported to be a tax-exempt exempt facility bond described in a paragraph (other than paragraph (7)) of section 142(a) or a qualified small issue bond";
}
@source(IRC_S150_B, relation = formalizes, coverage = exact, quote = "In the case of any facility with respect to which financing is provided from the proceeds of any private activity bond to which this paragraph applies, if such facility")
rule InterestDeniedFacilityNotUsedForExemptPurpose(financing: us.irc.core::Asset, from: Date, until: Date, on: Date, amount: Money) strict {
    label en official "section 150(b)(4)(A)-(B)";
    when bond_purported_exempt_facility_not_142a7_or_small_issue_150b4B(financing);
    when facility_not_used_for_exempt_purpose_150b4(financing, from, until);
    when interest_accrued_on_financing_150(financing, on, amount);
    when on >= from;
    when on < until;
    then interest_deduction_denied_150b(financing, on, amount, 4);
}
relation facility_required_to_be_owned_by_government_or_501c3_not_so_owned_150b5(financing: us.irc.core::Asset, not_owned_from: Date, owned_again_on: Date) kind empirical {
    label en official "the facility is required to be owned by a governmental unit or a 501(c)(3) organization as a condition of the exemption and is not so owned, from the date to the date it is";
}
@source(IRC_S150_B, relation = formalizes, coverage = exact, quote = "If—")
rule InterestDeniedFacilityNotProperlyOwned(financing: us.irc.core::Asset, from: Date, until: Date, on: Date, amount: Money) strict {
    label en official "section 150(b)(5)";
    when facility_required_to_be_owned_by_government_or_501c3_not_so_owned_150b5(financing, from, until);
    when interest_accrued_on_financing_150(financing, on, amount);
    when on >= from;
    when on < until;
    then interest_deduction_denied_150b(financing, on, amount, 5);
}
relation bond_purported_small_issue_not_one_now_150b6(financing: us.irc.core::Asset, from: Date, until: Date) kind empirical {
    label en official "the bond, when issued, purported to be a qualified small issue bond and is not one during the period";
}
@source(IRC_S150_B, relation = formalizes, coverage = exact, quote = "In the case of any financing provided from the proceeds of any bond which, when issued, purported to be a qualified small issue bond, no deduction shall be allowed under")
rule InterestDeniedSmallIssueBondNotQualified(financing: us.irc.core::Asset, from: Date, until: Date, on: Date, amount: Money) strict {
    label en official "section 150(b)(6)";
    when bond_purported_small_issue_not_one_now_150b6(financing, from, until);
    when interest_accrued_on_financing_150(financing, on, amount);
    when on >= from;
    when on < until;
    then interest_deduction_denied_150b(financing, on, amount, 6);
}
relation use_not_required_for_exempt_purpose_150c1(financing: us.irc.core::Asset) kind empirical {
    label en official "a use of the facility financed with proceeds of an issue which is not required to be used for the exempt purpose of the issue";
}
pub relation use_not_taken_into_account_150c1(financing: us.irc.core::Asset) kind institutional {
    label en official "any use not required for the exempt purpose is not taken into account";
}
@source(IRC_S150_C, relation = formalizes, coverage = exact, quote = "Any use with respect to facilities financed with proceeds of an issue which are not required to be used for the exempt purpose of such issue shall not be taken into")
rule UseNotRequiredForExemptPurposeNotTakenIntoAccount(financing: us.irc.core::Asset) strict {
    label en official "section 150(c)(1)";
    when use_not_required_for_exempt_purpose_150c1(financing);
    then use_not_taken_into_account_150c1(financing);
}
relation payments_for_use_not_interest_150c2(financing: us.irc.core::Asset, period_payments: Money, period_accrued_interest: Money) kind empirical {
    label en official "amounts payable for the use of the facility that are not interest for a period, and the interest accrued on the bond financing for the period";
}
pub relation payments_treated_as_interest_for_150b_150c2(financing: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "subsection (b) applies to the amounts as if they were interest, only to the extent the amounts for any period do not exceed the interest accrued on the bond financing for the period";
}
@source(IRC_S150_C, relation = formalizes, coverage = exact, quote = "If the amounts payable for the use of a facility are not interest, subsection (b) shall apply to such amounts as if they were interest but only to the extent such")
rule PaymentsTreatedAsInterestUpToAccrued(financing: us.irc.core::Asset, payments: Money, accrued: Money) strict {
    label en official "section 150(c)(2): the lesser of the payments and the accrued interest";
    when payments_for_use_not_interest_150c2(financing, payments, accrued);
    then payments_treated_as_interest_for_150b_150c2(financing, min(payments, accrued));
}
relation portion_use_and_financing_allocation_150c3(financing: us.irc.core::Asset, person: Person, interest_on_financing_allocable_to_portion: Money, interest_on_whole_financing: Money) kind empirical {
    label en official "the interest accruing on the financing allocable to the portion used by the person, and on the whole financing";
}
pub relation interest_taken_into_account_by_partial_user_150c3(financing: us.irc.core::Asset, person: Person, amount: Money) kind institutional {
    label en official "in the case of a person who uses only a portion of the facility, only the interest accruing on the financing allocable to that portion is taken into account";
}
@source(IRC_S150_C, relation = formalizes, coverage = exact, quote = "In the case of any person which uses only a portion of the facility, only the interest accruing on the financing allocable to such portion shall be taken into account by")
rule InterestTakenIntoAccountByPartialUser(financing: us.irc.core::Asset, person: Person, allocable: Money, whole: Money) strict {
    label en official "section 150(c)(3)";
    when portion_use_and_financing_allocation_150c3(financing, person, allocable, whole);
    then interest_taken_into_account_by_partial_user_150c3(financing, person, allocable);
}
relation part_of_facility_not_used_for_exempt_purpose_150c4(financing: us.irc.core::Asset, interest_allocable_to_that_part: Money) kind empirical {
    label en official "the interest accruing on the financing allocable to the part of the facility that is not used for an exempt purpose";
}
pub relation interest_taken_into_account_for_partly_exempt_facility_150c4(financing: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "where part but not all of the facility is not used for an exempt purpose, only the interest on the financing allocable to that part is taken into account";
}
@source(IRC_S150_C, relation = formalizes, coverage = exact, quote = "In the case of any facility where part but not all of the facility is not used for an exempt purpose, only the interest accruing on the financing allocable to such part")
rule InterestTakenIntoAccountForPartlyExemptFacility(financing: us.irc.core::Asset, allocable: Money) strict {
    label en official "section 150(c)(4)";
    when part_of_facility_not_used_for_exempt_purpose_150c4(financing, allocable);
    then interest_taken_into_account_for_partly_exempt_facility_150c4(financing, allocable);
}
relation scholarship_funding_corporation_facts_150d2(bond: us.irc.core::Asset, corporation_not_for_profit_exclusively_acquiring_student_loan_notes: Boolean, organized_at_request_of_state_or_political_subdivision: Boolean, required_to_devote_income_to_notes_or_united_states: Boolean) kind empirical {
    label en official "the issuer is a corporation not for profit established and operated exclusively to acquire student loan notes under the Higher Education Act of 1965, organized at the request of a State or political subdivision (or requested to exercise the power by one and required by its charter, bylaws or State law) to devote any income (after expenses, debt service and reserves) to the purchase of additional student loan notes or to pay it over to the United States";
}
pub relation qualified_scholarship_funding_bond_150d2(bond: us.irc.core::Asset) kind institutional {
    label en official "a qualified scholarship funding bond, treated as a State or local bond";
}
@source(IRC_S150_D, relation = formalizes, coverage = exact, quote = "The term \"qualified scholarship funding bond\" means a bond issued by a corporation which—")
rule QualifiedScholarshipFundingBondDefined(bond: us.irc.core::Asset) strict {
    label en official "section 150(d)(1)-(2)(A)-(B)";
    when scholarship_funding_corporation_facts_150d2(bond, true, true, true);
    then qualified_scholarship_funding_bond_150d2(bond);
}
relation transfer_of_notes_and_assets_150d3B(bond: us.irc.core::Asset, notes_and_pledged_assets_transferred_reasonable_time: Boolean, transferee_assumes_bond_debt: Boolean, transferee_assumes_education_agreements: Boolean, issuer_holds_all_senior_stock: Boolean, transferee_not_tax_exempt: Boolean) kind empirical {
    label en official "the requirements of section 150(d)(3)(B): the student loan notes and pledged assets are transferred to another corporation, which assumes the bond debt and (to the extent permitted) the agreements with the Secretary of Education, the issuer (with others) holds all the senior stock, and the transferee is not tax-exempt";
}
relation issuer_becomes_501c3_with_independent_board_150d3C(bond: us.irc.core::Asset, is_501c3_exempt: Boolean, no_longer_described_in_150d2AB: Boolean, independent_board_share: Decimal) kind empirical {
    label en official "the requirements of section 150(d)(3)(C): within a reasonable period after the transfer the issuer is a section 501(c)(3) organization exempt under section 501(a), no longer described in (2)(A) and (B), and at least 80 percent of its directors are independent members";
}
relation election_of_150d3_made(bond: us.irc.core::Asset) kind empirical {
    label en official "the issuer makes the election under paragraph (3)";
}
pub relation bond_remains_tax_exempt_after_issuer_change_150d3A(bond: us.irc.core::Asset) kind institutional {
    label en official "a qualified scholarship funding bond or qualified student loan bond outstanding on the date of the election (and any refunding bond) does not fail to be a tax-exempt bond solely because the issuer ceases to be described in (2)(A) and (B), if the issuer meets (B) and (C)";
}
@source(IRC_S150_D, relation = formalizes, coverage = exact, quote = "Any qualified scholarship funding bond, and qualified student loan bond, outstanding on the date of the issuer's election under this paragraph (and any bond (or series")
rule BondRemainsTaxExemptAfterIssuerChange(bond: us.irc.core::Asset, share: Decimal) strict {
    label en official "section 150(d)(3)(A)-(C)";
    when election_of_150d3_made(bond);
    when transfer_of_notes_and_assets_150d3B(bond, true, true, true, true, true);
    when issuer_becomes_501c3_with_independent_board_150d3C(bond, true, true, share);
    when share >= 0.80;
    then bond_remains_tax_exempt_after_issuer_change_150d3A(bond);
}
relation election_revoked_with_secretary_consent_150d3g(bond: us.irc.core::Asset) kind empirical {
    label en official "the Secretary consents to the revocation of the election";
}
relation revokes_election_150d3g(bond: us.irc.core::Asset) kind empirical {
    label en official "the issuer revokes the election under paragraph (3)";
}
pub relation election_150d3_revoked(bond: us.irc.core::Asset) kind institutional {
    label en official "the election is revoked";
}
@source(IRC_S150_D, relation = formalizes, coverage = exact, quote = "An election under this paragraph may be revoked only with the consent of the Secretary.")
rule Section150d3gRevocationRule defeasible {
    for bond: us.irc.core::Asset;
    when election_of_150d3_made(bond);
    then power Section150d3gRevocation {
        holder bond;
        over bond;
        exercise revokes_election_150d3g(bond);
        valid_when election_revoked_with_secretary_consent_150d3g(bond);
        effect create(election_150d3_revoked(bond));
        window [-infinity, infinity];
    };
}
relation independent_member_compensation_150d3e(member: Individual, compensated_for_transferee_services: Boolean, compensated_as_transferee_director_or_officer: Boolean) kind empirical {
    label en official "whether the member of the issuer's board receives compensation (other than for services as such a member) for services performed in connection with the transferee corporation, or for services as a director or officer of the transferee";
}
pub relation independent_member_150d3e(member: Individual) kind institutional {
    label en official "an independent member: receives no compensation directly or indirectly for services in connection with the transferee or as its director or officer";
}
@source(IRC_S150_D, relation = formalizes, coverage = exact, quote = "The term \"independent member\" means a member of the board of directors of the issuer who (except for services as a member of such board) receives no compensation")
rule IndependentMemberDefined(member: Individual) strict {
    label en official "section 150(d)(3)(E)(i)-(ii)";
    when independent_member_compensation_150d3e(member, false, false);
    then independent_member_150d3e(member);
}
relation senior_stock_facts_150d3D(stock: us.irc.core::Asset, participates_pro_rata_with_liquidation_priority: Boolean, fixed_liquidation_and_redemption_right_at_greater_of_fmv_or_net_assets: Boolean, holder_can_require_redemption_within_10_years: Boolean, no_superior_equity: Boolean) kind empirical {
    label en official "the characteristics of the senior stock of paragraph (3)(D): participates pro rata and fully in the equity value with a liquidation priority, a fixed right on liquidation and redemption to the greater of fair market value and the value of assets transferred net of liabilities assumed, redeemable at the holder's demand not later than 10 years after the election, and no superior equity interest";
}
pub relation senior_stock_150d3D(stock: us.irc.core::Asset) kind institutional {
    label en official "senior stock within section 150(d)(3)(D)";
}
@source(IRC_S150_D, relation = formalizes, coverage = exact, quote = "(i) which participates pro rata and fully in the equity value of the corporation with all other common stock of the corporation but which has the right to payment of")
rule SeniorStockDefined(stock: us.irc.core::Asset) strict {
    label en official "section 150(d)(3)(D)(i)-(iv)";
    when senior_stock_facts_150d3D(stock, true, true, true, true);
    then senior_stock_150d3D(stock);
}
relation transferee_asset_and_income_shares_150d3F(transferee: Person, last_year_ends_on: Date, share_of_income_or_assets_from_student_loan_notes: Decimal, tenth_anniversary_year_end: Date) kind empirical {
    label en official "the last day of the last taxable year for which more than 50 percent of the transferee's gross income is derived from, or of its assets (by value) consists of, student loan notes, and the last day of the issuer's taxable year during which the date 10 years after the election occurs";
}
relation election_period_end_candidates_150d3F(transferee: Person, first_candidate: Date, second_candidate: Date) kind empirical {
    label en official "the two dates of subparagraph (F)(i) and (ii)";
}
pub relation election_period_ends_150d3F(transferee: Person, ends: Date) kind institutional {
    label en official "the period of the election ends on the earlier of the two dates of clauses (i) and (ii)";
}
@source(IRC_S150_D, relation = formalizes, coverage = exact, quote = "(i) the last day of the last taxable year for which more than 50 percent of the gross income of such transferee corporation is derived from, or more than 50 percent of")
rule ElectionPeriodEndsAtFirstCandidate(transferee: Person, a: Date, b: Date) strict {
    label en official "section 150(d)(3)(F): the earlier of the two dates (the (i) date is the earlier)";
    when election_period_end_candidates_150d3F(transferee, a, b);
    when a <= b;
    then election_period_ends_150d3F(transferee, a);
}
@source(IRC_S150_D, relation = formalizes, coverage = exact, quote = "(ii) the last day of the taxable year of the issuer during which occurs the date which is 10 years after the date on which the election under this paragraph is made.")
rule ElectionPeriodEndsAtSecondCandidate(transferee: Person, a: Date, b: Date) strict {
    label en official "section 150(d)(3)(F): the earlier of the two dates (the (ii) date is the earlier)";
    when election_period_end_candidates_150d3F(transferee, a, b);
    when b < a;
    then election_period_ends_150d3F(transferee, b);
}
relation volunteer_fire_department_bond_150e(bond: us.irc.core::Asset, qualified_department_for_area_of_political_subdivision: Boolean, share_of_net_proceeds_for_firehouse_or_firetruck: Decimal) kind empirical {
    label en official "the bond is a bond of a volunteer fire department that is a qualified volunteer fire department with respect to an area within the jurisdiction of the political subdivision, issued as part of an issue with the given share of its net proceeds for a firehouse (with functionally related and subordinate land) or firetruck";
}
relation department_facts_150e2(department: Person, organized_to_provide_firefighting_or_ems_in_area_without_other_firefighting: Boolean, required_by_written_agreement_of_political_subdivision: Boolean) kind empirical {
    label en official "the department is organized and operated to provide firefighting or emergency medical services for persons in an area within the political subdivision not provided with any other firefighting services, and is required by written agreement with the political subdivision to furnish firefighting services in the area";
}
pub relation qualified_volunteer_fire_department_150e2(department: Person) kind institutional {
    label en official "a qualified volunteer fire department";
}
@source(IRC_S150_E, relation = formalizes, coverage = exact, quote = "(A) which is organized and operated to provide firefighting or emergency medical services for persons in an area (within the jurisdiction of such political subdivision)")
rule QualifiedVolunteerFireDepartmentDefined(department: Person) strict {
    label en official "section 150(e)(2)(A)-(B)";
    when department_facts_150e2(department, true, true);
    then qualified_volunteer_fire_department_150e2(department);
}
pub relation volunteer_fire_bond_treated_as_political_subdivision_bond_150e1(bond: us.irc.core::Asset) kind institutional {
    label en official "a bond of a volunteer fire department is treated as a bond of a political subdivision of a State: the department is qualified and 95 percent or more of the net proceeds are for a firehouse or firetruck";
}
@source(IRC_S150_E, relation = formalizes, coverage = exact, quote = "A bond of a volunteer fire department shall be treated as a bond of a political subdivision of a State if—")
rule VolunteerFireBondTreatedAsPoliticalSubdivisionBond(bond: us.irc.core::Asset, share: Decimal) strict {
    label en official "section 150(e)(1)(A)-(B)";
    when volunteer_fire_department_bond_150e(bond, true, share);
    when share >= 0.95;
    then volunteer_fire_bond_treated_as_political_subdivision_bond_150e1(bond);
}
pub relation volunteer_fire_bonds_not_private_activity_bonds_150e3(bond: us.irc.core::Asset) kind institutional {
    label en official "bonds of an issue meeting paragraph (1) are not treated as private activity bonds except for purposes of sections 147(f) and 149(d)";
}
@source(IRC_S150_E, relation = formalizes, coverage = exact, quote = "Bonds which are part of an issue which meets the requirements of paragraph (1) shall not be treated as private activity bonds except for purposes of sections 147(f) and")
rule VolunteerFireBondsNotPrivateActivityBonds(bond: us.irc.core::Asset) strict {
    label en official "section 150(e)(3)";
    when volunteer_fire_bond_treated_as_political_subdivision_bond_150e1(bond);
    then volunteer_fire_bonds_not_private_activity_bonds_150e3(bond);
}
