// Section 72(e)(4)(C), (e)(10)-(11), (f), (g), (h), (j), (l), (m), (n), (o), (q),
// (r), (s), (u), (v), (w) — special rules, contract-status rules and the
// additional taxes on annuity and modified-endowment distributions.
// Stage 2e (IRC-06), DECISION-0379. STATUS: implemented_unverified (static
// check only; scenarios in tests/s72-special-rules.lawtest are NOT executed).
//
// Judgment calls recorded here (coverage rows repeat them):
//  * Relations typed on `Individual` in s72-annuities.law stay so; the
//    holder of a section 72(u) contract is a `Person` (not a natural person by
//    definition), so (u) uses `Person`.
//  * Aggregates over DERIVED predicates (e.g. summing the per-item
//    classifications of (f) and (w)) are the runtime-subset limitation of §111;
//    per-item classification is executable, the total is a TECH_GAP or a
//    case-asserted total (each place says which).
//  * "Regulations prescribed by the Secretary" directives ((m)(2), (m)(10),
//    (o)(4), (w)(4)) are EXTERNAL_DEPENDENCY: this module does not invent
//    the regulations' content.

// =====================================================================
// §72(e)(4)(C): transfer of an annuity contract without adequate consideration
// =====================================================================

use self::{
    AnnuityContract,
    IRC_S72_E,
    IRC_S72_F,
    IRC_S72_G,
    IRC_S72_H,
    IRC_S72_J,
    IRC_S72_L,
    IRC_S72_M,
    IRC_S72_N,
    IRC_S72_O,
    IRC_S72_Q,
    IRC_S72_R,
    IRC_S72_S,
    IRC_S72_U,
    IRC_S72_V,
    IRC_S72_W,
    Individual,
    Person,
    RetirementArrangement,
    TaxableYear,
    annuity_starting_date_72c4,
    contract_described_in_72e5d,
    employee_attains_age_59_half_on,
    investment_in_contract_72c1,
    investment_in_contract_72e6,
    modified_endowment_contract_effective,
    nonannuity_amount_includible_72e,
    subsection_e_applies,
};

pub relation annuity_transferred_without_full_consideration(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, cash_surrender_value: Money) kind empirical {
    label en official "an individual who holds an annuity contract transfers it without full and adequate consideration; the amount is the cash surrender value at the time of transfer (section 72(e)(4)(C)(i)(I))";
}
relation transfer_to_which_1041a_applies(p: Individual, contract: AnnuityContract, on: Date) kind empirical {
    label en official "the transfer is one to which section 1041(a) applies (transfer between spouses or incident to divorce) (section 72(e)(4)(C)(ii))";
}
@source(IRC_S72_E, relation = formalizes, coverage = exact, quote = "such individual shall be treated as receiving an amount equal to the excess of—")
rule TransferWithoutConsiderationDeemedReceipt(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, csv: Money, inv: Money) strict {
    label en official "section 72(e)(4)(C)(i): the transferor is treated as receiving the excess of cash surrender value over the investment in the contract as an amount not received as an annuity; (ii) excludes a section 1041(a) transfer";
    when annuity_transferred_without_full_consideration(p, contract, y, on, csv);
    when investment_in_contract_72e6(p, contract, on, inv);
    when csv > inv;
    when not_known(transfer_to_which_1041a_applies(p, contract, on));
    then subsection_e_applies(p, contract, y, on, round(csv - inv, 2, "HALF_UP"));
}
pub relation transferee_investment_increase_72e4c3(p: Individual, contract: AnnuityContract, on: Date, amount: Money) kind institutional {
    label en official "the increase in the transferee's investment in the contract equal to the amount included in the transferor's gross income (section 72(e)(4)(C)(iii))";
}
@source(IRC_S72_E, relation = formalizes, coverage = exact, quote = "the investment in the contract of the transferee in such contract shall be increased by the amount so included.")
rule TransfereeInvestmentIncreased(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, amount: Money) strict {
    label en official "section 72(e)(4)(C)(iii): the transferee's investment increases by the amount the transferor includes";
    when annuity_transferred_without_full_consideration(p, contract, y, on, _);
    when nonannuity_amount_includible_72e(p, contract, y, on, amount);
    then transferee_investment_increase_72e4c3(p, contract, on, amount);
}

// =====================================================================
// §72(e)(10)(B) burial contracts; (e)(11) long-term-care charges
// =====================================================================

relation pledge_solely_for_burial_expenses(p: Individual, contract: AnnuityContract, on: Date) kind empirical {
    label en official "the assignment (or pledge) of the modified endowment contract is solely to cover the payment of expenses referred to in section 7702(e)(2)(C)(iii) (section 72(e)(10)(B))";
}
relation maximum_death_benefit(contract: AnnuityContract, amount: Money) kind empirical {
    label en official "the maximum death benefit under the contract";
}
pub relation burial_contract_pledge_exception_72e10b(p: Individual, contract: AnnuityContract, on: Date) kind institutional {
    label en official "the (e)(10)(B) burial-contract exception: (4)(A) does not apply to the assignment or pledge of a modified endowment contract solely for burial expenses where the maximum death benefit does not exceed $25,000";
}
@source(IRC_S72_E, relation = formalizes, coverage = exact, quote = "if the maximum death benefit under such contract does not exceed $25,000.")
rule BurialContractPledgeException(p: Individual, contract: AnnuityContract, on: Date, benefit: Money) strict {
    label en official "section 72(e)(10)(B)";
    when modified_endowment_contract_effective(contract);
    when pledge_solely_for_burial_expenses(p, contract, on);
    when maximum_death_benefit(contract, benefit);
    when benefit <= 25000.00 USD;
    then burial_contract_pledge_exception_72e10b(p, contract, on);
}

relation ltc_charge_against_contract_value(p: Individual, contract: AnnuityContract, on: Date, charge: Money) kind empirical {
    label en official "a charge against the cash value of an annuity contract (or cash surrender value of a life insurance contract) made as payment for coverage under a qualified long-term care insurance contract that is part of or a rider on the contract (section 72(e)(11))";
}
pub relation investment_after_ltc_charge_72e11(p: Individual, contract: AnnuityContract, on: Date, amount: Money) kind institutional {
    label en official "the investment in the contract after being reduced (but not below zero) by the long-term-care charge (section 72(e)(11)(A))";
}
@source(IRC_S72_E, relation = formalizes, coverage = exact, quote = "(A) the investment in the contract shall be reduced (but not below zero) by such charge, and")
rule InvestmentReducedByLtcCharge(p: Individual, contract: AnnuityContract, on: Date, charge: Money, inv: Money) strict {
    label en official "section 72(e)(11)(A)";
    when ltc_charge_against_contract_value(p, contract, on, charge);
    when investment_in_contract_72e6(p, contract, on, inv);
    then investment_after_ltc_charge_72e11(p, contract, on, max(0.00 USD, round(inv - charge, 2, "HALF_UP")));
}
pub relation ltc_charge_includible_amount_72e11(p: Individual, contract: AnnuityContract, on: Date, amount: Money) kind institutional {
    label en official "the amount of the long-term-care charge includible in gross income: none (section 72(e)(11)(B))";
}
@source(IRC_S72_E, relation = formalizes, coverage = exact, quote = "(B) such charge shall not be includible in gross income.")
rule LtcChargeNotIncludible(p: Individual, contract: AnnuityContract, on: Date, charge: Money) strict {
    label en official "section 72(e)(11)(B)";
    when ltc_charge_against_contract_value(p, contract, on, charge);
    then ltc_charge_includible_amount_72e11(p, contract, on, 0.00 USD);
}

// =====================================================================
// §72(f): employer contributions counted as the employee's consideration
// =====================================================================

pub relation employer_contribution(p: Individual, contract: AnnuityContract, seq: Integer, amount: Money) kind empirical {
    label en official "the seq-th amount contributed by the employer toward the contract (section 72(f))";
}
relation contribution_includible_in_employee_income(p: Individual, contract: AnnuityContract, seq: Integer) kind empirical {
    label en official "the contribution was includible in the gross income of the employee under this subtitle or prior income tax laws (section 72(f)(1))";
}
relation contribution_would_have_been_excluded_if_paid_directly(p: Individual, contract: AnnuityContract, seq: Integer) kind empirical {
    label en official "if paid directly to the employee when contributed, the contribution would not have been includible under the law then applicable (section 72(f)(2))";
}
relation contribution_excluded_only_by_section_911_after_1962(p: Individual, contract: AnnuityContract, seq: Integer) kind empirical {
    label en official "the contribution was made after December 31, 1962 and would not have been includible only by reason of section 911 (section 72(f), second sentence)";
}
pub relation employer_contribution_counts_as_consideration_72f(p: Individual, contract: AnnuityContract, seq: Integer, amount: Money) kind institutional {
    label en official "the employer contribution is included in the aggregate consideration paid for the contract for purposes of section 72(c)(1)(A) and (e)(6)";
}
@source(IRC_S72_F, relation = formalizes, coverage = partial, quote = "(1) such amounts were includible in the gross income of the employee under this subtitle or prior income tax laws; or")
rule EmployerContributionCountsIfIncludible(p: Individual, contract: AnnuityContract, seq: Integer, amount: Money) strict {
    label en official "section 72(f)(1)";
    when employer_contribution(p, contract, seq, amount);
    when contribution_includible_in_employee_income(p, contract, seq);
    then employer_contribution_counts_as_consideration_72f(p, contract, seq, amount);
}
@source(IRC_S72_F, relation = formalizes, coverage = partial, quote = "Paragraph (2) shall not apply to amounts which were contributed by the employer after December 31, 1962")
rule EmployerContributionCountsIfExcludedUnderPriorLaw(p: Individual, contract: AnnuityContract, seq: Integer, amount: Money) strict {
    label en official "section 72(f)(2), except the section 911 post-1962 contributions (the pre-1963 service-credit and foreign-missionary saving clauses of the last sentence are not modelled: TECH-GAPS)";
    when employer_contribution(p, contract, seq, amount);
    when contribution_would_have_been_excluded_if_paid_directly(p, contract, seq);
    when not_known(contribution_excluded_only_by_section_911_after_1962(p, contract, seq));
    then employer_contribution_counts_as_consideration_72f(p, contract, seq, amount);
}

// =====================================================================
// §72(g): transferee for value
// =====================================================================

relation transferred_for_valuable_consideration(p: Individual, contract: AnnuityContract) kind empirical {
    label en official "the contract (or an interest in it) was transferred by assignment or otherwise for a valuable consideration to the transferee p (section 72(g))";
}
relation transferee_basis_from_transferor(p: Individual, contract: AnnuityContract) kind empirical {
    label en official "in the hands of the transferee the contract has a basis determined by reference to the basis in the hands of the transferor (section 72(g), lead-in)";
}
relation actual_value_of_consideration_paid_on_transfer(p: Individual, contract: AnnuityContract, amount: Money) kind empirical {
    label en official "the actual value of the consideration the transferee paid on the transfer";
}
relation premiums_paid_by_transferee_after_transfer(p: Individual, contract: AnnuityContract, amount: Money) kind empirical {
    label en official "the premiums and other consideration paid by the transferee after the transfer";
}
pub relation consideration_taken_into_account_72g1(p: Individual, contract: AnnuityContract, amount: Money) kind institutional {
    label en official "for a transferee for value, the aggregate consideration taken into account under section 72(c)(1)(A): actual value of the consideration plus later premiums (section 72(g)(1))";
}
@source(IRC_S72_G, relation = formalizes, coverage = exact, quote = "only the actual value of such consideration, plus the amount of the premiums and other consideration paid by the transferee after the transfer, shall be taken into account")
rule TransfereeConsiderationLimited(p: Individual, contract: AnnuityContract, actual: Money, later: Money) strict {
    label en official "section 72(g)(1): applies only where the transferee's basis is not a carryover basis";
    when transferred_for_valuable_consideration(p, contract);
    when not_known(transferee_basis_from_transferor(p, contract));
    when actual_value_of_consideration_paid_on_transfer(p, contract, actual);
    when premiums_paid_by_transferee_after_transfer(p, contract, later);
    then consideration_taken_into_account_72g1(p, contract, round(actual + later, 2, "HALF_UP"));
}

// =====================================================================
// §72(h): option to receive an annuity in lieu of a lump sum (a power)
// =====================================================================

relation lump_sum_with_annuity_option(p: Individual, contract: AnnuityContract, first_payable: Date) kind empirical {
    label en official "the contract provides for payment of a lump sum in full discharge of an obligation under the contract, subject to an option to receive an annuity in lieu of the lump sum; the lump sum first became payable on the date (section 72(h)(1)-(2))";
}
pub relation annuity_option_exercised(p: Individual, contract: AnnuityContract, on: Date) kind empirical {
    label en official "the holder exercises the option to receive an annuity in lieu of the lump sum on the date (section 72(h))";
}
relation lump_sum_includible_by_e1(p: Individual, contract: AnnuityContract) kind empirical {
    label en official "part or all of the lump sum would, but for section 72(h), be includible in gross income by reason of section 72(e)(1) (section 72(h)(3))";
}
relation annuity_option_valid_72h(p: Individual, contract: AnnuityContract) kind institutional {
    label en official "helper for valid_when: all three conditions of section 72(h) hold (lump sum with option; exercised within 60 days after the lump sum first became payable; the lump sum would otherwise be includible)";
}
@source(IRC_S72_H, relation = formalizes, coverage = exact, quote = "(2) the option is exercised within 60 days after the day on which such lump sum first became payable; and")
rule AnnuityOptionValidityConditions(p: Individual, contract: AnnuityContract, first_payable: Date, on: Date) strict {
    label en official "section 72(h)(1)-(3), the 60-day window counted in calendar days (a day is not a month)";
    when lump_sum_with_annuity_option(p, contract, first_payable);
    when annuity_option_exercised(p, contract, on);
    when lump_sum_includible_by_e1(p, contract);
    when on >= first_payable;
    when on <= add_calendar_period(first_payable, 60 calendar_day);
    then annuity_option_valid_72h(p, contract);
}
pub relation lump_sum_not_includible_when_first_payable_72h(p: Individual, contract: AnnuityContract) kind institutional {
    label en official "no part of the lump sum is considered includible in gross income at the time it first became payable (section 72(h), closing clause)";
}
@source(IRC_S72_H, relation = formalizes, coverage = exact, quote = "then, for purposes of this subtitle, no part of such lump sum shall be considered as includible in gross income at the time such lump sum first became payable.")
rule AnnuityOptionPowerRule(p: Individual, contract: AnnuityContract, first_payable: Date, on: Date) strict {
    label en official "section 72(h): the holder's election of the annuity option is a power; an invalid exercise (late, or no (e)(1) inclusion) has no effect (E-0239)";
    when lump_sum_with_annuity_option(p, contract, first_payable);
    when annuity_option_exercised(p, contract, on);
    then power Section72HAnnuityOptionElection {
        holder p;
        over contract;
        exercise annuity_option_exercised(p, contract, on);
        valid_when annuity_option_valid_72h(p, contract);
        effect create(lump_sum_not_includible_when_first_payable_72h(p, contract));
        window [-infinity, infinity];
    };
}

// =====================================================================
// §72(j) interest; (l) face-amount certificates
// =====================================================================

pub relation amount_held_under_agreement_to_pay_interest(p: Individual, y: TaxableYear, interest: Money) kind empirical {
    label en official "interest payments on an amount held under an agreement to pay interest thereon (section 72(j))";
}
pub relation held_amount_interest_includible_72j(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "interest on an amount held under an agreement to pay interest is included in gross income notwithstanding any other provision of section 72";
}
@source(IRC_S72_J, relation = formalizes, coverage = exact, quote = "if any amount is held under an agreement to pay interest thereon, the interest payments shall be included in gross income.")
rule HeldAmountInterestIncludible(p: Individual, y: TaxableYear, interest: Money) strict {
    label en official "section 72(j)";
    when amount_held_under_agreement_to_pay_interest(p, y, interest);
    then held_amount_interest_includible_72j(p, y, interest);
}

relation face_amount_certificate_issued_on(contract: AnnuityContract, issued: Date) kind empirical {
    label en official "the contract is a face-amount certificate as defined in section 2(a)(15) of the Investment Company Act of 1940, issued on the date (section 72(l))";
}
pub relation endowment_contract_72l(contract: AnnuityContract) kind institutional {
    label en official "the contract is an endowment contract for purposes of section 72 because it is a face-amount certificate issued after December 31, 1954";
}
@source(IRC_S72_L, relation = formalizes, coverage = exact, quote = "the term \"endowment contract\" includes a face-amount certificate")
rule FaceAmountCertificateIsEndowmentContract(contract: AnnuityContract, issued: Date) strict {
    label en official "section 72(l)";
    when face_amount_certificate_issued_on(contract, issued);
    when issued > @1954-12-31;
    then endowment_contract_72l(contract);
}

// =====================================================================
// §72(m): employee annuities and distributions under employee plans
// =====================================================================

// (m)(7) disability
external judgment relation unable_to_engage_in_substantial_gainful_activity(p: Individual) {
    authority Secretary;
    label en official "the individual is unable to engage in any substantial gainful activity by reason of a medically determinable physical or mental impairment (section 72(m)(7)) — an evaluative determination (DECISION-0194 channel: judgment of the Secretary on proof furnished)";
}
relation impairment_expected_to_result_in_death_or_long_duration(p: Individual) kind empirical {
    label en official "the impairment can be expected to result in death or to be of long-continued and indefinite duration (section 72(m)(7))";
}
relation proof_of_disability_furnished(p: Individual) kind empirical {
    label en official "the individual furnishes proof of the existence of the disability in such form and manner as the Secretary may require (section 72(m)(7), last sentence)";
}
pub relation disabled_72m7(p: Individual) kind institutional {
    label en official "the individual is considered disabled for purposes of section 72";
}
@source(IRC_S72_M, relation = formalizes, coverage = exact, quote = "an individual shall be considered to be disabled if he is unable to engage in any substantial gainful activity")
rule DisabledWithinM7(p: Individual) strict {
    label en official "section 72(m)(7): inability (judgment) + expected duration + proof furnished";
    when unable_to_engage_in_substantial_gainful_activity(p);
    when impairment_expected_to_result_in_death_or_long_duration(p);
    when proof_of_disability_furnished(p);
    then disabled_72m7(p);
}

// (m)(3) life insurance contracts under employee plans
relation life_insurance_protection_applied(p: Individual, contract: AnnuityContract, y: TaxableYear, amount: Money) kind empirical {
    label en official "a contribution to the plan (allowed as a deduction under section 404), or income of the trust, determined under regulations to have been applied to purchase life insurance protection under a contract described in section 72(m)(3)(A), in the taxable year";
}
relation life_insurance_contract_of_employee_plan(contract: AnnuityContract) kind empirical {
    label en official "the life insurance contract is purchased as part of a section 403(a) plan, or by a section 401(a) trust exempt under section 501(a) with proceeds payable directly or indirectly to a participant or beneficiary (section 72(m)(3)(A))";
}
pub relation life_insurance_protection_includible_72m3b(p: Individual, contract: AnnuityContract, y: TaxableYear, amount: Money) kind institutional {
    label en official "the cost of life insurance protection applied under a section 72(m)(3)(A) contract, includible in the participant's gross income for the taxable year when so applied";
}
@source(IRC_S72_M, relation = formalizes, coverage = partial, quote = "is includible in the gross income of the participant for the taxable year when so applied.")
rule LifeInsuranceProtectionIncludibleM3B(p: Individual, contract: AnnuityContract, y: TaxableYear, amount: Money) strict {
    label en official "section 72(m)(3)(B) (the regulations that determine the amount applied are an EXTERNAL_DEPENDENCY — the amount is a case fact)";
    when life_insurance_contract_of_employee_plan(contract);
    when life_insurance_protection_applied(p, contract, y, amount);
    then life_insurance_protection_includible_72m3b(p, contract, y, amount);
}
relation cash_surrender_value_immediately_before_death(contract: AnnuityContract, amount: Money) kind empirical {
    label en official "the cash surrender value of the contract immediately before the death of the insured";
}
relation amount_payable_by_reason_of_death(contract: AnnuityContract, amount: Money) kind empirical {
    label en official "the amount payable by reason of the death of the insured";
}
pub relation death_payment_treated_as_plan_distribution_72m3c(contract: AnnuityContract, amount: Money) kind institutional {
    label en official "an amount equal to the cash surrender value immediately before death is treated as a payment under the plan or a distribution by the trust (section 72(m)(3)(C))";
}
pub relation death_proceeds_over_cash_value_not_includible_72m3c(contract: AnnuityContract, amount: Money) kind institutional {
    label en official "the excess of the death payment over the cash surrender value is not includible under section 72 and is treated as provided in section 101";
}
@source(IRC_S72_M, relation = formalizes, coverage = exact, quote = "an amount equal to the cash surrender value of the contract immediately before the death of the insured shall be treated as a payment under such plan or a distribution by such trust")
rule DeathOfInsuredCashValueIsPlanPayment(contract: AnnuityContract, csv: Money) strict {
    label en official "section 72(m)(3)(C), first clause";
    when life_insurance_contract_of_employee_plan(contract);
    when cash_surrender_value_immediately_before_death(contract, csv);
    then death_payment_treated_as_plan_distribution_72m3c(contract, csv);
}
@source(IRC_S72_M, relation = formalizes, coverage = exact, quote = "the excess of the amount payable by reason of the death of the insured over such cash surrender value shall not be includible in gross income under this section")
rule DeathProceedsExcessOverCashValueNotIncludible(contract: AnnuityContract, csv: Money, payable: Money) strict {
    label en official "section 72(m)(3)(C), second clause";
    when life_insurance_contract_of_employee_plan(contract);
    when cash_surrender_value_immediately_before_death(contract, csv);
    when amount_payable_by_reason_of_death(contract, payable);
    when payable > csv;
    then death_proceeds_over_cash_value_not_includible_72m3c(contract, round(payable - csv, 2, "HALF_UP"));
}

// (m)(5) 5-percent owners
relation five_percent_owner_within_5_plan_years(p: Individual, y: TaxableYear) kind empirical {
    label en official "the individual is, or has been, a 5-percent owner (section 416(i)(1)(B)) at any time during the 5 plan years preceding the plan year ending in the taxable year of receipt, or a successor of such an individual (section 72(m)(5)(A), (C))";
}
relation amount_over_plan_formula_received(p: Individual, y: TaxableYear, includible_portion: Money) kind empirical {
    label en official "the portion, includible in gross income for the year, of amounts received from a qualified trust or section 403(a) plan that are determined under regulations to exceed the benefits provided under the plan formula (section 72(m)(5)(A)-(B)); the excess determination is an EXTERNAL_DEPENDENCY (regulations)";
}
pub relation five_percent_owner_additional_tax_72m5(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the increase in the taxpayer's tax under chapter 1 for the year: 10 percent of the includible portion of the excess amounts received by a 5-percent owner (section 72(m)(5)(B))";
}
@source(IRC_S72_M, relation = formalizes, coverage = exact, quote = "his tax under this chapter for the taxable year in which such amount is received shall be increased by an amount equal to 10 percent of the portion of the amount so received which is includible in his gross income for such taxable year.")
rule FivePercentOwnerAdditionalTax(p: Individual, y: TaxableYear, includible: Money) strict {
    label en official "section 72(m)(5)(B)";
    when five_percent_owner_within_5_plan_years(p, y);
    when amount_over_plan_formula_received(p, y, includible);
    then five_percent_owner_additional_tax_72m5(p, y, round(includible * 0.10, 2, "HALF_UP"));
}

// =====================================================================
// §72(n): survivor benefit plan annuities
// =====================================================================

relation survivor_plan_annuity_received(p: Individual, contract: AnnuityContract, y: TaxableYear, received_on: Date, amount: Money) kind empirical {
    label en official "an amount received as an annuity under chapter 73 of title 10, United States Code (retired serviceman's family protection plan or survivor benefit plan), on the date (section 72(n))";
}
relation consideration_for_survivor_plan_contract(p: Individual, contract: AnnuityContract, amount: Money) kind empirical {
    label en official "the consideration for the contract as defined by section 122(b)(2), plus any amount treated under former section 101(b)(2)(D) as additional consideration paid by the employee (section 72(n))";
}
relation survivor_plan_amounts_previously_excluded(p: Individual, contract: AnnuityContract, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount already excluded under section 122(b)(1) or section 72(n), including amounts excluded before January 1, 1966";
}
pub relation survivor_plan_annuity_excluded_72n(p: Individual, contract: AnnuityContract, y: TaxableYear, amount: Money) kind institutional {
    label en official "the part of a survivor-plan annuity excluded from gross income until the consideration for the contract has been recovered (section 72(n))";
}
@source(IRC_S72_N, relation = formalizes, coverage = partial, quote = "but all such amounts shall be excluded from gross income until there has been so excluded")
rule SurvivorPlanAnnuityExcludedUntilRecovered(p: Individual, contract: AnnuityContract, y: TaxableYear, received_on: Date, amount: Money, consideration: Money, prior: Money) strict {
    label en official "section 72(n): for amounts received after December 31, 1965, the exclusion is min(amount, consideration - already excluded); subsection (b) does not apply";
    when survivor_plan_annuity_received(p, contract, y, received_on, amount);
    when received_on > @1965-12-31;
    when consideration_for_survivor_plan_contract(p, contract, consideration);
    when survivor_plan_amounts_previously_excluded(p, contract, y, prior);
    then survivor_plan_annuity_excluded_72n(p, contract, y, min(amount, max(0.00 USD, round(consideration - prior, 2, "HALF_UP"))));
}
pub relation survivor_plan_annuity_includible_72n(p: Individual, contract: AnnuityContract, y: TaxableYear, amount: Money) kind institutional {
    label en official "the part of a survivor-plan annuity included in gross income once the consideration has been recovered";
}
@source(IRC_S72_N, relation = formalizes, coverage = partial, quote = "Thereafter all amounts so received shall be included in gross income.")
rule SurvivorPlanAnnuityIncludibleRemainder(p: Individual, contract: AnnuityContract, y: TaxableYear, received_on: Date, amount: Money, excluded: Money) strict {
    label en official "section 72(n), last sentence: the remainder of the amount received is included";
    when survivor_plan_annuity_received(p, contract, y, received_on, amount);
    when survivor_plan_annuity_excluded_72n(p, contract, y, excluded);
    then survivor_plan_annuity_includible_72n(p, contract, y, round(amount - excluded, 2, "HALF_UP"));
}

// =====================================================================
// §72(o): deductible employee contributions
// =====================================================================

pub relation qualified_voluntary_employee_contribution(p: Individual, plan: RetirementArrangement, made_on: Date, for_year_begins: Date, amount: Money) kind empirical {
    label en official "a qualified voluntary employee contribution (section 219(e)(2)) made on the date for a taxable year beginning on the given date (section 72(o)(5)(A))";
}
relation allowable_as_deduction_under_219a(p: Individual, plan: RetirementArrangement, for_year_begins: Date) kind empirical {
    label en official "the contribution was allowable as a deduction under section 219(a) for that taxable year";
}
pub relation deductible_employee_contribution_72o5a(p: Individual, plan: RetirementArrangement, amount: Money) kind institutional {
    label en official "a deductible employee contribution: a qualified voluntary employee contribution made after December 31, 1981, in a taxable year beginning after that date, for a taxable year beginning before January 1, 1987, and allowable under section 219(a) for it";
}
@source(IRC_S72_O, relation = formalizes, coverage = exact, quote = "The term \"deductible employee contributions\" means any qualified voluntary employee contribution")
rule DeductibleEmployeeContributionDefined(p: Individual, plan: RetirementArrangement, made_on: Date, year_begins: Date, amount: Money) strict {
    label en official "section 72(o)(5)(A)";
    when qualified_voluntary_employee_contribution(p, plan, made_on, year_begins, amount);
    when allowable_as_deduction_under_219a(p, plan, year_begins);
    when made_on > @1981-12-31;
    when year_begins > @1981-12-31;
    when year_begins < @1987-01-01;
    then deductible_employee_contribution_72o5a(p, plan, amount);
}
pub relation treated_as_employer_contribution_not_includible_72o1(p: Individual, plan: RetirementArrangement, amount: Money) kind institutional {
    label en official "a deductible employee contribution is treated as an amount contributed by the employer which is not includible in the employee's gross income, for purposes of sections 72, 402 and 403 (section 72(o)(1))";
}
@source(IRC_S72_O, relation = formalizes, coverage = exact, quote = "any deductible employee contribution made to a qualified employer plan or government plan shall be treated as an amount contributed by the employer which is not includible in the gross income of the employee.")
rule DeductibleEmployeeContributionTreatedAsEmployerContribution(p: Individual, plan: RetirementArrangement, amount: Money) strict {
    label en official "section 72(o)(1)";
    when deductible_employee_contribution_72o5a(p, plan, amount);
    then treated_as_employer_contribution_not_includible_72o1(p, plan, amount);
}
relation accumulated_deductible_contributions_applied_to_life_insurance(p: Individual, plan: RetirementArrangement, y: TaxableYear, amount: Money) kind empirical {
    label en official "accumulated deductible employee contributions applied to the purchase of life insurance contracts in the year (section 72(o)(3)(B))";
}
pub relation treated_as_distributed_72o3b(p: Individual, plan: RetirementArrangement, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount applied is treated as distributed to the employee in the year applied";
}
@source(IRC_S72_O, relation = formalizes, coverage = exact, quote = "such amount shall be treated as distributed to the employee in the year so applied.")
rule LifeInsurancePurchaseFromAccumulatedContributionsIsDistribution(p: Individual, plan: RetirementArrangement, y: TaxableYear, amount: Money) strict {
    label en official "section 72(o)(3)(B)";
    when accumulated_deductible_contributions_applied_to_life_insurance(p, plan, y, amount);
    then treated_as_distributed_72o3b(p, plan, y, amount);
}
relation plan_specifies_distribution_ordering(plan: RetirementArrangement) kind empirical {
    label en official "the plan specifies the order in which distributions are treated as made (section 72(o)(6), lead-in \"Unless the plan specifies otherwise\")";
}
relation distribution_from_plan_on(p: Individual, plan: RetirementArrangement, on: Date) kind empirical {
    label en official "a distribution is made to the employee from the plan on the date";
}
relation all_other_amounts_distributed(p: Individual, plan: RetirementArrangement, on: Date) kind empirical {
    label en official "all amounts to the credit of the employee under the plan other than accumulated deductible employee contributions have been distributed by the date (section 72(o)(6))";
}
pub relation distribution_may_come_from_accumulated_deductible_contributions(p: Individual, plan: RetirementArrangement, on: Date) kind institutional {
    label en official "a distribution may be treated as made from accumulated deductible employee contributions: either the plan so specifies, or all other amounts to the credit of the employee have been distributed (section 72(o)(6))";
}
@source(IRC_S72_O, relation = formalizes, coverage = exact, quote = "Unless the plan specifies otherwise, any distribution from such plan shall not be treated as being made from the accumulated deductible employee contributions")
rule OrderingPlanSpecifiesOtherwise(p: Individual, plan: RetirementArrangement, on: Date) strict {
    label en official "section 72(o)(6), lead-in: the plan's own ordering governs when it specifies one";
    when distribution_from_plan_on(p, plan, on);
    when plan_specifies_distribution_ordering(plan);
    then distribution_may_come_from_accumulated_deductible_contributions(p, plan, on);
}
@source(IRC_S72_O, relation = formalizes, coverage = exact, quote = "until all other amounts to the credit of the employee have been distributed.")
rule OrderingDefaultAllOtherAmountsDistributed(p: Individual, plan: RetirementArrangement, on: Date) strict {
    label en official "section 72(o)(6), default order: accumulated deductible contributions are reached only after all other amounts have been distributed";
    when distribution_from_plan_on(p, plan, on);
    when all_other_amounts_distributed(p, plan, on);
    then distribution_may_come_from_accumulated_deductible_contributions(p, plan, on);
}

// =====================================================================
// §72(s): required distributions where the holder dies (contract status)
// =====================================================================

relation contract_provides_post_starting_date_death_distribution_rule(contract: AnnuityContract) kind empirical {
    label en official "the contract provides that if any holder dies on or after the annuity starting date and before the entire interest has been distributed, the remaining interest will be distributed at least as rapidly as under the method being used at death (section 72(s)(1)(A))";
}
relation contract_provides_five_year_rule(contract: AnnuityContract) kind empirical {
    label en official "the contract provides that if any holder dies before the annuity starting date, the entire interest will be distributed within 5 years after the holder's death (section 72(s)(1)(B))";
}
relation contract_exempt_from_72s_by_paragraph_5(contract: AnnuityContract) kind empirical {
    label en official "the contract is one to which section 72(s) does not apply by paragraph (5): provided under a section 401(a) plan with an exempt trust or a section 403(a) plan, described in section 403(b), an individual retirement annuity or provided under an individual retirement account or annuity, or a qualified funding asset (section 130(d))";
}
pub relation contract_treated_as_annuity_contract_72s(contract: AnnuityContract) kind institutional {
    label en official "the contract is treated as an annuity contract for purposes of the title: it contains both required-distribution provisions, or is excepted by section 72(s)(5)";
}
@source(IRC_S72_S, relation = formalizes, coverage = exact, quote = "A contract shall not be treated as an annuity contract for purposes of this title unless it provides that—")
rule ContractProvidesBothDistributionRules(contract: AnnuityContract) strict {
    label en official "section 72(s)(1)(A) and (B)";
    when contract_provides_post_starting_date_death_distribution_rule(contract);
    when contract_provides_five_year_rule(contract);
    then contract_treated_as_annuity_contract_72s(contract);
}
@source(IRC_S72_S, relation = formalizes, coverage = exact, quote = "This subsection shall not apply to any annuity contract—")
rule ContractExemptFrom72s(contract: AnnuityContract) strict {
    label en official "section 72(s)(5): excepted contracts are treated as annuity contracts without the required provisions";
    when contract_exempt_from_72s_by_paragraph_5(contract);
    then contract_treated_as_annuity_contract_72s(contract);
}

relation holder_death_date(contract: AnnuityContract, died: Date) kind empirical {
    label en official "the date of death of the holder of the contract";
}
relation portion_payable_to_designated_beneficiary_over_life(contract: AnnuityContract, beneficiary: Individual) kind empirical {
    label en official "a portion of the holder's interest is payable to (or for the benefit of) a designated beneficiary and will be distributed (in accordance with regulations) over the beneficiary's life or a period not extending beyond the beneficiary's life expectancy (section 72(s)(2)(A)-(B))";
}
relation beneficiary_distributions_begin_on(contract: AnnuityContract, beneficiary: Individual, begin: Date) kind empirical {
    label en official "the date on which the distributions to the beneficiary begin";
}
pub relation beneficiary_portion_treated_distributed_on(contract: AnnuityContract, beneficiary: Individual, on: Date) kind institutional {
    label en official "the beneficiary's portion is treated as distributed on the day the life-expectancy distributions begin (section 72(s)(2))";
}
@source(IRC_S72_S, relation = formalizes, coverage = partial, quote = "such distributions begin not later than 1 year after the date of the holder's death or such later date as the Secretary may by regulations prescribe")
rule BeneficiaryPortionTreatedDistributedWhenPaymentsBegin(contract: AnnuityContract, beneficiary: Individual, died: Date, begin: Date) strict {
    label en official "section 72(s)(2)(A)-(C), the later date the Secretary may prescribe by regulations is not modelled (EXTERNAL_DEPENDENCY)";
    when portion_payable_to_designated_beneficiary_over_life(contract, beneficiary);
    when holder_death_date(contract, died);
    when beneficiary_distributions_begin_on(contract, beneficiary, begin);
    when begin <= add_calendar_period(died, 1 calendar_year);
    then beneficiary_portion_treated_distributed_on(contract, beneficiary, begin);
}
// G6404 wiring, §72(s)(7): a change of the primary annuitant of a contract held by a non-individual is treated as
// the death of the holder, so the one-year distribution window of (s)(1)(B) runs from that date.
@source(IRC_S72_S, relation = formalizes, coverage = partial, quote = "such distributions begin not later than 1 year after the date of the holder's death or such later date as the Secretary may by regulations prescribe")
rule BeneficiaryPortionTreatedDistributedWhenPaymentsBeginAfterAnnuitantChange(contract: AnnuityContract, beneficiary: Individual, died: Date, begin: Date) strict {
    label en official "section 72(s)(7) with (s)(1)(B), (s)(2): the annuitant change is the holder's death";
    when portion_payable_to_designated_beneficiary_over_life(contract, beneficiary);
    when holder_deemed_dead_on_annuitant_change_72s7(contract, died);
    when beneficiary_distributions_begin_on(contract, beneficiary, begin);
    when begin <= add_calendar_period(died, 1 calendar_year);
    then beneficiary_portion_treated_distributed_on(contract, beneficiary, begin);
}
relation designated_by_holder(contract: AnnuityContract, beneficiary: Individual) kind empirical {
    label en official "the individual was designated a beneficiary by the holder of the contract";
}
pub relation designated_beneficiary_72s4(contract: AnnuityContract, beneficiary: Individual) kind institutional {
    label en official "designated beneficiary: any individual designated a beneficiary by the holder of the contract (section 72(s)(4))";
}
@source(IRC_S72_S, relation = formalizes, coverage = exact, quote = "the term \"designated beneficiary\" means any individual designated a beneficiary by the holder of the contract.")
rule DesignatedBeneficiaryDefined(contract: AnnuityContract, beneficiary: Individual) strict {
    label en official "section 72(s)(4)";
    when designated_by_holder(contract, beneficiary);
    then designated_beneficiary_72s4(contract, beneficiary);
}
relation holder_is_surviving_spouse_beneficiary(contract: AnnuityContract, spouse: Individual) kind empirical {
    label en official "the designated beneficiary is the surviving spouse of the holder";
}
relation holder_is_not_individual(contract: AnnuityContract) kind empirical {
    label en official "the holder of the contract is not an individual (section 72(s)(6)(A))";
}
relation primary_annuitant_of(contract: AnnuityContract, annuitant: Individual) kind empirical {
    label en official "the individual, the events in the life of whom are of primary importance in affecting the timing or amount of the payout under the contract (section 72(s)(6)(B))";
}
pub relation treated_as_holder_72s(contract: AnnuityContract, person: Individual) kind institutional {
    label en official "the person is treated as the holder of the contract for purposes of section 72(s): the surviving spouse beneficiary ((s)(3)) or, where the holder is not an individual, the primary annuitant ((s)(6)(A))";
}
@source(IRC_S72_S, relation = formalizes, coverage = exact, quote = "if the holder of the contract is not an individual, the primary annuitant shall be treated as the holder of the contract.")
rule PrimaryAnnuitantTreatedAsHolder(contract: AnnuityContract, annuitant: Individual) strict {
    label en official "section 72(s)(6)(A)";
    when holder_is_not_individual(contract);
    when primary_annuitant_of(contract, annuitant);
    then treated_as_holder_72s(contract, annuitant);
}
@source(IRC_S72_S, relation = formalizes, coverage = exact, quote = "paragraphs (1) and (2) shall be applied by treating such spouse as the holder of such contract.")
rule SurvivingSpouseTreatedAsHolder(contract: AnnuityContract, spouse: Individual) strict {
    label en official "section 72(s)(3)";
    when designated_beneficiary_72s4(contract, spouse);
    when holder_is_surviving_spouse_beneficiary(contract, spouse);
    then treated_as_holder_72s(contract, spouse);
}
relation primary_annuitant_changed_on(contract: AnnuityContract, on: Date) kind empirical {
    label en official "there is a change in the primary annuitant of a contract whose holder is not an individual on the date (section 72(s)(7))";
}
pub relation holder_deemed_dead_on_annuitant_change_72s7(contract: AnnuityContract, on: Date) kind institutional {
    label en official "a change in primary annuitant is treated as the death of the holder";
}
@source(IRC_S72_S, relation = formalizes, coverage = exact, quote = "such change shall be treated as the death of the holder.")
rule PrimaryAnnuitantChangeIsHolderDeath(contract: AnnuityContract, on: Date) strict {
    label en official "section 72(s)(7)";
    when holder_is_not_individual(contract);
    when primary_annuitant_changed_on(contract, on);
    then holder_deemed_dead_on_annuitant_change_72s7(contract, on);
}

// =====================================================================
// §72(u): annuity contracts not held by natural persons
// =====================================================================

pub relation contract_held_by_person_not_natural(holder: Person, contract: AnnuityContract) kind empirical {
    label en official "the annuity contract is held by a person who is not a natural person (section 72(u)(1))";
}
relation held_as_agent_for_natural_person(holder: Person, contract: AnnuityContract) kind empirical {
    label en official "the trust or other entity holds the contract as an agent for a natural person, which is not taken into account (section 72(u)(1), last sentence)";
}
relation contract_purchase_date(contract: AnnuityContract, purchased: Date) kind empirical {
    label en official "the date on which the annuity was purchased";
}
relation purchased_with_single_premium(contract: AnnuityContract) kind empirical {
    label en official "the annuity is purchased with a single premium or annuity consideration (section 72(u)(4)(A))";
}
relation provides_substantially_equal_periodic_payments_at_least_annually(contract: AnnuityContract) kind empirical {
    label en official "the annuity provides for a series of substantially equal periodic payments (to be made not less frequently than annually) during the annuity period (section 72(u)(4)(C))";
}
pub relation immediate_annuity_72u4(contract: AnnuityContract) kind institutional {
    label en official "an immediate annuity: single premium, annuity starting date no later than 1 year from purchase, series of substantially equal periodic payments at least annually (section 72(u)(4))";
}
@source(IRC_S72_U, relation = formalizes, coverage = exact, quote = "the term \"immediate annuity\" means an annuity—")
rule ImmediateAnnuityDefined(contract: AnnuityContract, purchased: Date, asd: Date) strict {
    label en official "section 72(u)(4)(A)-(C); the one-year test is a calendar-year step from the purchase date";
    when purchased_with_single_premium(contract);
    when contract_purchase_date(contract, purchased);
    when annuity_starting_date_72c4(contract, asd);
    when asd <= add_calendar_period(purchased, 1 calendar_year);
    when provides_substantially_equal_periodic_payments_at_least_annually(contract);
    then immediate_annuity_72u4(contract);
}
relation contract_acquired_by_estate_of_decedent(contract: AnnuityContract) kind empirical {
    label en official "the contract is acquired by the estate of a decedent by reason of the death of the decedent (section 72(u)(3)(A))";
}
relation contract_held_under_plan_or_ira(contract: AnnuityContract) kind empirical {
    label en official "the contract is held under a section 401(a) or 403(a) plan, under a section 403(b) program, or under an individual retirement plan (section 72(u)(3)(B))";
}
relation contract_is_qualified_funding_asset(contract: AnnuityContract) kind empirical {
    label en official "the contract is a qualified funding asset (section 130(d), without regard to whether there is a qualified assignment) (section 72(u)(3)(C))";
}
relation purchased_by_employer_upon_plan_termination_and_held(contract: AnnuityContract) kind empirical {
    label en official "the contract is purchased by an employer upon termination of a section 401(a) or 403(a) plan and held by the employer until all amounts under it are distributed to the employee or beneficiary (section 72(u)(3)(D))";
}
relation exception_72u3_applies(contract: AnnuityContract) kind institutional {
    label en official "one of the section 72(u)(3)(A)-(E) exceptions applies to the contract";
}
@source(IRC_S72_U, relation = formalizes, coverage = exact, quote = "is acquired by the estate of a decedent by reason of the death of the decedent,")
rule Exception72u3EstateOfDecedent(contract: AnnuityContract) strict {
    label en official "section 72(u)(3)(A)";
    when contract_acquired_by_estate_of_decedent(contract);
    then exception_72u3_applies(contract);
}
@source(IRC_S72_U, relation = formalizes, coverage = exact, quote = "is held under a plan described in section 401(a) or 403(a), under a program described in section 403(b), or under an individual retirement plan,")
rule Exception72u3PlanOrIra(contract: AnnuityContract) strict {
    label en official "section 72(u)(3)(B)";
    when contract_held_under_plan_or_ira(contract);
    then exception_72u3_applies(contract);
}
@source(IRC_S72_U, relation = formalizes, coverage = exact, quote = "is a qualified funding asset (as defined in section 130(d), but without regard to whether there is a qualified assignment),")
rule Exception72u3QualifiedFundingAsset(contract: AnnuityContract) strict {
    label en official "section 72(u)(3)(C)";
    when contract_is_qualified_funding_asset(contract);
    then exception_72u3_applies(contract);
}
@source(IRC_S72_U, relation = formalizes, coverage = exact, quote = "is purchased by an employer upon the termination of a plan described in section 401(a) or 403(a) and is held by the employer until all amounts under such contract are distributed to the employee for whom such contract was purchased or the employee's beneficiary, or")
rule Exception72u3EmployerHeldAfterTermination(contract: AnnuityContract) strict {
    label en official "section 72(u)(3)(D)";
    when purchased_by_employer_upon_plan_termination_and_held(contract);
    then exception_72u3_applies(contract);
}
@source(IRC_S72_U, relation = formalizes, coverage = exact, quote = "is an immediate annuity.")
rule Exception72u3ImmediateAnnuity(contract: AnnuityContract) strict {
    label en official "section 72(u)(3)(E)";
    when immediate_annuity_72u4(contract);
    then exception_72u3_applies(contract);
}
pub relation contract_not_annuity_contract_72u1(holder: Person, contract: AnnuityContract) kind institutional {
    label en official "the contract is not treated as an annuity contract for purposes of this subtitle (other than subchapter L): held by a non-natural person, not as agent for a natural person, and no (u)(3) exception applies";
}
@source(IRC_S72_U, relation = formalizes, coverage = exact, quote = "such contract shall not be treated as an annuity contract for purposes of this subtitle (other than subchapter L)")
rule NonNaturalHolderContractNotAnnuity(holder: Person, contract: AnnuityContract) strict {
    label en official "section 72(u)(1)(A), (3)";
    when contract_held_by_person_not_natural(holder, contract);
    when not_known(held_as_agent_for_natural_person(holder, contract));
    when not_known(exception_72u3_applies(contract));
    then contract_not_annuity_contract_72u1(holder, contract);
}
relation net_surrender_value_at_close(holder: Person, contract: AnnuityContract, y: TaxableYear, amount: Money) kind empirical {
    label en official "the net surrender value of the contract as of the close of the taxable year (or its fair market value where the Secretary so substitutes to prevent avoidance) (section 72(u)(2)(A)(i))";
}
relation distributions_received_through_year(holder: Person, contract: AnnuityContract, y: TaxableYear, amount: Money) kind empirical {
    label en official "all distributions under the contract received during the taxable year or any prior taxable year";
}
relation premiums_paid_through_year(holder: Person, contract: AnnuityContract, y: TaxableYear, amount: Money) kind empirical {
    label en official "premiums paid under the contract for the taxable year and prior taxable years";
}
relation policyholder_dividends_through_year(holder: Person, contract: AnnuityContract, y: TaxableYear, amount: Money) kind empirical {
    label en official "policyholder dividends reducing premiums (section 72(u)(2)(B))";
}
relation included_in_gross_income_prior_years_72u(holder: Person, contract: AnnuityContract, y: TaxableYear, amount: Money) kind empirical {
    label en official "amounts includible in gross income for prior taxable years with respect to the contract under section 72(u)";
}
pub relation income_on_contract_72u2(holder: Person, contract: AnnuityContract, y: TaxableYear, amount: Money) kind institutional {
    label en official "the income on the contract for the taxable year: the excess (never below zero) of net surrender value at close plus distributions to date over net premiums to date plus amounts included in prior years";
}
@source(IRC_S72_U, relation = formalizes, coverage = exact, quote = "the term \"income on the contract\" means, with respect to any taxable year of the policyholder, the excess of—")
rule IncomeOnContractComputed(holder: Person, contract: AnnuityContract, y: TaxableYear, surrender: Money, dist: Money, premiums: Money, dividends: Money, prior: Money) strict {
    label en official "section 72(u)(2)(A)-(B): (net surrender value + distributions) minus (premiums - policyholder dividends + prior inclusions)";
    when contract_not_annuity_contract_72u1(holder, contract);
    when net_surrender_value_at_close(holder, contract, y, surrender);
    when distributions_received_through_year(holder, contract, y, dist);
    when premiums_paid_through_year(holder, contract, y, premiums);
    when policyholder_dividends_through_year(holder, contract, y, dividends);
    when included_in_gross_income_prior_years_72u(holder, contract, y, prior);
    then income_on_contract_72u2(holder, contract, y, max(0.00 USD, round((surrender + dist) - ((premiums - dividends) + prior), 2, "HALF_UP")));
}
pub relation ordinary_income_of_nonnatural_holder_72u1b(holder: Person, contract: AnnuityContract, y: TaxableYear, amount: Money) kind institutional {
    label en official "the income on the contract is treated as ordinary income received or accrued by the owner during the taxable year (section 72(u)(1)(B))";
}
@source(IRC_S72_U, relation = formalizes, coverage = exact, quote = "the income on the contract for any taxable year of the policyholder shall be treated as ordinary income received or accrued by the owner during such taxable year.")
rule IncomeOnContractIsOrdinaryIncome(holder: Person, contract: AnnuityContract, y: TaxableYear, amount: Money) strict {
    label en official "section 72(u)(1)(B)";
    when income_on_contract_72u2(holder, contract, y, amount);
    then ordinary_income_of_nonnatural_holder_72u1b(holder, contract, y, amount);
}

// =====================================================================
// §72(q) and §72(v): 10-percent additional taxes on annuity / MEC distributions
// =====================================================================

pub entity AnnuityContractDistribution {
    label en unofficial "one amount received under an annuity contract (or modified endowment contract) within the meaning of section 72(q)(1) or (v)(1); case-asserted, one entity per receipt so that per-receipt exceptions are tested independently";
}
pub relation annuity_contract_distribution(p: Individual, contract: AnnuityContract, dist: AnnuityContractDistribution, y: TaxableYear, includible: Money) kind empirical {
    label en official "the taxpayer receives an amount under the contract in the taxable year; the amount is the portion of it includible in gross income (sections 72(q)(1), (v)(1))";
}
relation annuity_distribution_date(dist: AnnuityContractDistribution, on: Date) kind empirical {
    label en official "the date the distribution was made";
}
relation annuity_distribution_after_holder_death(dist: AnnuityContractDistribution) kind empirical {
    label en official "the distribution is made on or after the death of the holder (or, where the holder is not an individual, of the primary annuitant) (section 72(q)(2)(B))";
}
relation annuity_distribution_attributable_to_disability(p: Individual, dist: AnnuityContractDistribution) kind empirical {
    label en official "the distribution is attributable to the taxpayer's becoming disabled within the meaning of section 72(m)(7)";
}
relation annuity_distribution_part_of_sepp(dist: AnnuityContractDistribution) kind empirical {
    label en official "the distribution is part of a series of substantially equal periodic payments (not less frequently than annually) made for the life (or life expectancy) of the taxpayer or the joint lives of the taxpayer and the designated beneficiary";
}
relation annuity_distribution_allocable_to_pre_19820814_investment(dist: AnnuityContractDistribution) kind empirical {
    label en official "the distribution is allocable to investment in the contract before August 14, 1982 (section 72(q)(2)(F))";
}
relation annuity_distribution_from_qualified_funding_asset(dist: AnnuityContractDistribution) kind empirical {
    label en official "the distribution is under a qualified funding asset (section 130(d), without regard to whether there is a qualified assignment) (section 72(q)(2)(G))";
}
relation annuity_distribution_subject_to_72t(dist: AnnuityContractDistribution) kind empirical {
    label en official "subsection (t) applies to the distribution (without regard to paragraph (2) thereof) (section 72(q)(2)(H))";
}
relation annuity_distribution_from_employer_purchased_on_termination(dist: AnnuityContractDistribution) kind empirical {
    label en official "the annuity is purchased by an employer upon termination of a section 401(a)/403(a) plan and held by the employer until the employee separates from service (section 72(q)(2)(J))";
}
relation annuity_distribution_excepted_72q(dist: AnnuityContractDistribution) kind institutional {
    label en official "the distribution falls within a section 72(q)(2) exception";
}
relation annuity_distribution_excepted_72v(dist: AnnuityContractDistribution) kind institutional {
    label en official "the distribution falls within a section 72(v)(2) exception";
}
@source(IRC_S72_Q, relation = formalizes, coverage = exact, quote = "(A) made on or after the date on which the taxpayer attains age 59½,")
rule AnnuityExceptionAge59Half(p: Individual, contract: AnnuityContract, dist: AnnuityContractDistribution, y: TaxableYear, on: Date, age_date: Date) strict {
    label en official "section 72(q)(2)(A): distribution on or after the exact date the taxpayer attains age 59 1/2";
    when annuity_contract_distribution(p, contract, dist, y, _);
    when annuity_distribution_date(dist, on);
    when employee_attains_age_59_half_on(p, age_date);
    when on >= age_date;
    then annuity_distribution_excepted_72q(dist);
}
@source(IRC_S72_Q, relation = formalizes, coverage = exact, quote = "(B) made on or after the death of the holder")
rule AnnuityExceptionHolderDeath(dist: AnnuityContractDistribution) strict {
    label en official "section 72(q)(2)(B)";
    when annuity_distribution_after_holder_death(dist);
    then annuity_distribution_excepted_72q(dist);
}
@source(IRC_S72_Q, relation = formalizes, coverage = exact, quote = "(C) attributable to the taxpayer's becoming disabled within the meaning of subsection (m)(7),")
rule AnnuityExceptionDisability(p: Individual, dist: AnnuityContractDistribution) strict {
    label en official "section 72(q)(2)(C), with the (m)(7) definition of this module";
    when annuity_distribution_attributable_to_disability(p, dist);
    when disabled_72m7(p);
    then annuity_distribution_excepted_72q(dist);
}
@source(IRC_S72_Q, relation = formalizes, coverage = exact, quote = "(D) which is a part of a series of substantially equal periodic payments (not less frequently than annually) made for the life (or life expectancy) of the taxpayer")
rule AnnuityExceptionSepp(dist: AnnuityContractDistribution) strict {
    label en official "section 72(q)(2)(D)";
    when annuity_distribution_part_of_sepp(dist);
    then annuity_distribution_excepted_72q(dist);
}
@source(IRC_S72_Q, relation = formalizes, coverage = exact, quote = "(E) from a plan, contract, account, trust, or annuity described in subsection (e)(5)(D),")
rule AnnuityExceptionQualifiedPlanContract(contract: AnnuityContract, dist: AnnuityContractDistribution, p: Individual, y: TaxableYear) strict {
    label en official "section 72(q)(2)(E)";
    when annuity_contract_distribution(p, contract, dist, y, _);
    when contract_described_in_72e5d(contract);
    then annuity_distribution_excepted_72q(dist);
}
@source(IRC_S72_Q, relation = formalizes, coverage = exact, quote = "(F) allocable to investment in the contract before August 14, 1982, or [2]")
rule AnnuityExceptionPre1982Investment(dist: AnnuityContractDistribution) strict {
    label en official "section 72(q)(2)(F)";
    when annuity_distribution_allocable_to_pre_19820814_investment(dist);
    then annuity_distribution_excepted_72q(dist);
}
@source(IRC_S72_Q, relation = formalizes, coverage = exact, quote = "(G) under a qualified funding asset (within the meaning of section 130(d), but without regard to whether there is a qualified assignment),")
rule AnnuityExceptionQualifiedFundingAsset(dist: AnnuityContractDistribution) strict {
    label en official "section 72(q)(2)(G)";
    when annuity_distribution_from_qualified_funding_asset(dist);
    then annuity_distribution_excepted_72q(dist);
}
@source(IRC_S72_Q, relation = formalizes, coverage = exact, quote = "(H) to which subsection (t) applies (without regard to paragraph (2) thereof),")
rule AnnuityExceptionSubsectionT(dist: AnnuityContractDistribution) strict {
    label en official "section 72(q)(2)(H)";
    when annuity_distribution_subject_to_72t(dist);
    then annuity_distribution_excepted_72q(dist);
}
@source(IRC_S72_Q, relation = formalizes, coverage = exact, quote = "(I) under an immediate annuity contract (within the meaning of section 72(u)(4)), or")
rule AnnuityExceptionImmediateAnnuity(p: Individual, contract: AnnuityContract, dist: AnnuityContractDistribution, y: TaxableYear) strict {
    label en official "section 72(q)(2)(I), using this module's (u)(4) definition";
    when annuity_contract_distribution(p, contract, dist, y, _);
    when immediate_annuity_72u4(contract);
    then annuity_distribution_excepted_72q(dist);
}
@source(IRC_S72_Q, relation = formalizes, coverage = exact, quote = "(J) which is purchased by an employer upon the termination of a plan described in section 401(a) or 403(a) and which is held by the employer until such time as the employee separates from service.")
rule AnnuityExceptionEmployerPurchasedOnTermination(dist: AnnuityContractDistribution) strict {
    label en official "section 72(q)(2)(J)";
    when annuity_distribution_from_employer_purchased_on_termination(dist);
    then annuity_distribution_excepted_72q(dist);
}

pub relation annuity_distribution_additional_tax_72q(p: Individual, dist: AnnuityContractDistribution, y: TaxableYear, amount: Money) kind institutional {
    label en official "the additional tax under section 72(q)(1): 10 percent of the portion of the amount received under an annuity contract that is includible in gross income, zero where a (q)(2) exception applies";
}
@source(IRC_S72_Q, relation = formalizes, coverage = exact, quote = "the taxpayer's tax under this chapter for the taxable year in which such amount is received shall be increased by an amount equal to 10 percent of the portion of such amount which is includible in gross income.")
rule AnnuityAdditionalTaxNoException(p: Individual, contract: AnnuityContract, dist: AnnuityContractDistribution, y: TaxableYear, includible: Money) strict {
    label en official "section 72(q)(1): 10 percent of the includible portion when no (q)(2) exception applies";
    when annuity_contract_distribution(p, contract, dist, y, includible);
    when not_known(annuity_distribution_excepted_72q(dist));
    when not_known(modified_endowment_contract_effective(contract));
    then annuity_distribution_additional_tax_72q(p, dist, y, round(includible * 0.10, 2, "HALF_UP"));
}
@source(IRC_S72_Q, relation = formalizes, coverage = exact, quote = "(2) Subsection not to apply to certain distributions")
rule AnnuityAdditionalTaxExcepted(p: Individual, contract: AnnuityContract, dist: AnnuityContractDistribution, y: TaxableYear) strict {
    label en official "section 72(q)(2): an excepted distribution bears no additional tax (explicit zero)";
    when annuity_contract_distribution(p, contract, dist, y, _);
    when annuity_distribution_excepted_72q(dist);
    then annuity_distribution_additional_tax_72q(p, dist, y, 0.00 USD);
}

@source(IRC_S72_V, relation = formalizes, coverage = exact, quote = "(A) made on or after the date on which the taxpayer attains age 59½,")
rule MecExceptionAge59Half(p: Individual, contract: AnnuityContract, dist: AnnuityContractDistribution, y: TaxableYear, on: Date, age_date: Date) strict {
    label en official "section 72(v)(2)(A)";
    when annuity_contract_distribution(p, contract, dist, y, _);
    when modified_endowment_contract_effective(contract);
    when annuity_distribution_date(dist, on);
    when employee_attains_age_59_half_on(p, age_date);
    when on >= age_date;
    then annuity_distribution_excepted_72v(dist);
}
@source(IRC_S72_V, relation = formalizes, coverage = exact, quote = "(B) which is attributable to the taxpayer's becoming disabled (within the meaning of subsection (m)(7)), or")
rule MecExceptionDisability(p: Individual, contract: AnnuityContract, dist: AnnuityContractDistribution, y: TaxableYear) strict {
    label en official "section 72(v)(2)(B)";
    when annuity_contract_distribution(p, contract, dist, y, _);
    when modified_endowment_contract_effective(contract);
    when annuity_distribution_attributable_to_disability(p, dist);
    when disabled_72m7(p);
    then annuity_distribution_excepted_72v(dist);
}
@source(IRC_S72_V, relation = formalizes, coverage = exact, quote = "(C) which is part of a series of substantially equal periodic payments (not less frequently than annually) made for the life (or life expectancy) of the taxpayer or the joint lives")
rule MecExceptionSepp(contract: AnnuityContract, dist: AnnuityContractDistribution, p: Individual, y: TaxableYear) strict {
    label en official "section 72(v)(2)(C)";
    when annuity_contract_distribution(p, contract, dist, y, _);
    when modified_endowment_contract_effective(contract);
    when annuity_distribution_part_of_sepp(dist);
    then annuity_distribution_excepted_72v(dist);
}
pub relation mec_distribution_additional_tax_72v(p: Individual, dist: AnnuityContractDistribution, y: TaxableYear, amount: Money) kind institutional {
    label en official "the additional tax under section 72(v)(1): 10 percent of the portion of an amount received under a modified endowment contract that is includible in gross income, zero where a (v)(2) exception applies";
}
@source(IRC_S72_V, relation = formalizes, coverage = exact, quote = "the taxpayer's tax under this chapter for the taxable year in which such amount is received shall be increased by an amount equal to 10 percent of the portion of such amount which is includible in gross income.")
rule MecAdditionalTaxNoException(p: Individual, contract: AnnuityContract, dist: AnnuityContractDistribution, y: TaxableYear, includible: Money) strict {
    label en official "section 72(v)(1)";
    when annuity_contract_distribution(p, contract, dist, y, includible);
    when modified_endowment_contract_effective(contract);
    when not_known(annuity_distribution_excepted_72v(dist));
    then mec_distribution_additional_tax_72v(p, dist, y, round(includible * 0.10, 2, "HALF_UP"));
}
@source(IRC_S72_V, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall not apply to any distribution—")
rule MecAdditionalTaxExcepted(p: Individual, contract: AnnuityContract, dist: AnnuityContractDistribution, y: TaxableYear) strict {
    label en official "section 72(v)(2): an excepted distribution bears no additional tax (explicit zero)";
    when annuity_contract_distribution(p, contract, dist, y, _);
    when modified_endowment_contract_effective(contract);
    when annuity_distribution_excepted_72v(dist);
    then mec_distribution_additional_tax_72v(p, dist, y, 0.00 USD);
}

// (q)(3)(A): modification of the series of substantially equal payments
relation annuity_sepp_modified_before_59_half(p: Individual, y: TaxableYear) kind empirical {
    label en official "the series of payments exempted by (q)(2)(D) is modified (other than by death or disability) before the taxpayer attains age 59 1/2 (section 72(q)(3)(A)(ii)(II))";
}
relation annuity_sepp_modified_within_5_years_after_59_half(p: Individual, y: TaxableYear) kind empirical {
    label en official "the series is modified after age 59 1/2 but before the close of the 5-year period beginning on the date of the first payment (section 72(q)(3)(A)(ii)(I))";
}
relation exchange_under_1035_continues_sepp(p: Individual, y: TaxableYear) kind empirical {
    label en official "the modification is an exchange under section 1035 after which aggregate distributions continue to satisfy (q)(2)(D) (section 72(q)(3)(B)): not a modification";
}
relation exempted_sepp_includible_total(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the includible portion of the distributions that (q)(2)(D) exempted and that would have been subject to the (q)(1) tax";
}
pub relation annuity_sepp_recapture_tax_72q3(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the principal of the recapture in the year of modification: the tax that would have been imposed under (q)(1) but for (q)(2)(D); the interest for the deferral period is not modelled (TECH_GAP)";
}
@source(IRC_S72_Q, relation = formalizes, coverage = partial, quote = "the taxpayer's tax for the 1st taxable year in which such modification occurs shall be increased by an amount, determined under regulations, equal to the tax which (but for paragraph (2)(D)) would have been imposed")
rule AnnuitySeppRecaptureBefore59Half(p: Individual, y: TaxableYear, total: Money) strict {
    label en official "section 72(q)(3)(A)(ii)(II); a section 1035 exchange that preserves the series is not a modification";
    when annuity_sepp_modified_before_59_half(p, y);
    when not_known(exchange_under_1035_continues_sepp(p, y));
    when exempted_sepp_includible_total(p, y, total);
    then annuity_sepp_recapture_tax_72q3(p, y, round(total * 0.10, 2, "HALF_UP"));
}
@source(IRC_S72_Q, relation = formalizes, coverage = partial, quote = "before the close of the 5-year period beginning on the date of the first payment and after the taxpayer attains age 59½, or")
rule AnnuitySeppRecaptureWithin5YearsAfter59Half(p: Individual, y: TaxableYear, total: Money) strict {
    label en official "section 72(q)(3)(A)(ii)(I)";
    when annuity_sepp_modified_within_5_years_after_59_half(p, y);
    when not_known(exchange_under_1035_continues_sepp(p, y));
    when exempted_sepp_includible_total(p, y, total);
    then annuity_sepp_recapture_tax_72q3(p, y, round(total * 0.10, 2, "HALF_UP"));
}

// =====================================================================
// §72(r): railroad retirement benefits treated as employer-plan benefits
// =====================================================================

relation railroad_retirement_benefit(benefit: AnnuityContract) kind empirical {
    label en official "a benefit provided under the Railroad Retirement Act of 1974 (section 72(r)(1))";
}
relation tier_1_railroad_retirement_benefit(benefit: AnnuityContract) kind empirical {
    label en official "a tier 1 railroad retirement benefit within the meaning of section 86(d)(4)";
}
pub relation treated_as_qualified_employer_plan_benefit_72r1(benefit: AnnuityContract) kind institutional {
    label en official "the benefit is treated for purposes of the title as a benefit provided under an employer plan meeting the requirements of section 401(a)";
}
@source(IRC_S72_R, relation = formalizes, coverage = exact, quote = "shall be treated for purposes of this title as a benefit provided under an employer plan which meets the requirements of section 401(a).")
rule RailroadBenefitTreatedAsEmployerPlanBenefit(benefit: AnnuityContract) strict {
    label en official "section 72(r)(1), excluding tier 1 benefits";
    when railroad_retirement_benefit(benefit);
    when not_known(tier_1_railroad_retirement_benefit(benefit));
    then treated_as_qualified_employer_plan_benefit_72r1(benefit);
}

// =====================================================================
// §72(w): basis rules for nonresident-alien compensation
// =====================================================================

relation contribution_for_services_of_nonresident_alien(contract: AnnuityContract, seq: Integer, amount: Money) kind empirical {
    label en official "an employer or employee contribution made with respect to compensation for labor or personal services performed by an employee who at the time was a nonresident alien (section 72(w)(2)(A)(i))";
}
relation contribution_compensation_from_sources_outside_us(contract: AnnuityContract, seq: Integer) kind empirical {
    label en official "the compensation is treated as from sources without the United States (section 72(w)(2)(A)(ii))";
}
relation contribution_not_subject_to_income_tax(contract: AnnuityContract, seq: Integer) kind empirical {
    label en official "the contribution was not subject to income tax (and would have been if paid as cash compensation when the services were rendered) under the laws of the United States or any foreign country (section 72(w)(2)(B))";
}
pub relation applicable_nontaxable_contribution_72w2(contract: AnnuityContract, seq: Integer, amount: Money) kind institutional {
    label en official "an applicable nontaxable contribution (section 72(w)(2))";
}
@source(IRC_S72_W, relation = formalizes, coverage = exact, quote = "the term \"applicable nontaxable contribution\" means any employer or employee contribution—")
rule ApplicableNontaxableContributionDefined(contract: AnnuityContract, seq: Integer, amount: Money) strict {
    label en official "section 72(w)(2)(A)-(B)";
    when contribution_for_services_of_nonresident_alien(contract, seq, amount);
    when contribution_compensation_from_sources_outside_us(contract, seq);
    when contribution_not_subject_to_income_tax(contract, seq);
    then applicable_nontaxable_contribution_72w2(contract, seq, amount);
}
relation applicable_nontaxable_contributions_total(contract: AnnuityContract, amount: Money) kind empirical {
    label en official "the total of the applicable nontaxable contributions to the contract (case-asserted total: an aggregate over the derived per-item classification is the §111 runtime-subset limitation)";
}
relation applicable_nontaxable_earnings_total(contract: AnnuityContract, amount: Money) kind empirical {
    label en official "the total of the applicable nontaxable earnings of section 72(w)(3) (earnings on qualifying contributions, nonresident-alien employee at the time, not subject to income tax)";
}
relation distributee_is_us_citizen_or_resident(p: Individual) kind empirical {
    label en official "the distributee is a citizen or resident of the United States (section 72(w)(1))";
}
pub relation investment_in_contract_for_us_distributee_72w1(p: Individual, contract: AnnuityContract, amount: Money) kind institutional {
    label en official "the investment in the contract for a U.S. citizen or resident distributee, excluding applicable nontaxable contributions and earnings";
}
@source(IRC_S72_W, relation = formalizes, coverage = exact, quote = "the investment in the contract shall not include any applicable nontaxable contributions or applicable nontaxable earnings.")
rule InvestmentExcludesNontaxableContributionsAndEarnings(p: Individual, contract: AnnuityContract, inv: Money, contributions: Money, earnings: Money) strict {
    label en official "section 72(w)(1)";
    when distributee_is_us_citizen_or_resident(p);
    when investment_in_contract_72c1(p, contract, inv);
    when applicable_nontaxable_contributions_total(contract, contributions);
    when applicable_nontaxable_earnings_total(contract, earnings);
    then investment_in_contract_for_us_distributee_72w1(p, contract, round(inv - contributions - earnings, 2, "HALF_UP"));
}
