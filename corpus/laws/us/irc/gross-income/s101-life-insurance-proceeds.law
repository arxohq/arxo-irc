// Section 101 — Certain death benefits (life insurance proceeds payable by
// reason of death). Stage 2b (IRC-06). Scope: (a), (a)(2), (g), (j) per task.

// --- §101(a)(1): general rule --------------------------------------------------

use self::{
    IRC_S101_A,
    IRC_S101_G,
    IRC_S101_J,
    Individual,
    TaxableYear,
};

pub relation paid_by_reason_of_death_of_insured(p: Individual, contract: us.irc.core::Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "an amount received under a life insurance contract, paid by reason of the death of the insured (section 101(a)(1))";
}
pub relation life_insurance_proceeds_excluded_101a(p: Individual, contract: us.irc.core::Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "gross income does not include this amount, paid by reason of the death of the insured under a life insurance contract (section 101(a)(1))";
}

@source(IRC_S101_A, quote = "gross income does not include amounts received (whether in a single sum or otherwise) under a life insurance contract, if such amounts are paid by reason of the death of the insured")
rule LifeInsuranceProceedsExcluded(p: Individual, contract: us.irc.core::Asset, y: TaxableYear, amount: Money) strict {
    label en official "life insurance proceeds paid by reason of death are excluded, unless the (a)(2) transfer-for-value cap, or subsections (d)/(f)/(j), limit or deny the exclusion";
    when paid_by_reason_of_death_of_insured(p, contract, y, amount);
    when not_known(transfer_for_value_cap_applies_101a2(p, contract, y, amount));
    then life_insurance_proceeds_excluded_101a(p, contract, y, amount);
}

// G6404 wiring, §101(g)(1): an accelerated death benefit (terminally or chronically ill insured) is treated
// as an amount paid by reason of the death of the insured, so §101(a)(1) excludes it. The contract is the
// case-asserted contract under which the benefit was paid (the derived `treated_as_paid_by_reason_of_death_101g`
// carries no contract). JUDGMENT CALL: the (a)(2) transfer-for-value cap reads only `paid_by_reason_of_death_of_insured`,
// so an accelerated benefit under a transferred contract is excluded without the cap here.
relation accelerated_death_benefit_contract_101g(p: Individual, insured: Individual, y: TaxableYear, contract: us.irc.core::Asset) kind empirical {
    label en official "the life insurance contract under which the accelerated death benefit was received by the payee for the taxable year (section 101(g)(1))";
}
@source(IRC_S101_G, quote = "the following amounts shall be treated as an amount paid by reason of the death of an insured")
rule AcceleratedBenefitExcludedAsDeathBenefit(p: Individual, insured: Individual, y: TaxableYear, amount: Money, contract: us.irc.core::Asset) strict {
    label en official "section 101(g)(1) with 101(a)(1): the accelerated death benefit is excluded as an amount paid by reason of death";
    when treated_as_paid_by_reason_of_death_101g(p, insured, y, amount);
    when accelerated_death_benefit_contract_101g(p, insured, y, contract);
    then life_insurance_proceeds_excluded_101a(p, contract, y, amount);
}

// --- §101(a)(2): transfer for valuable consideration --------------------------

relation contract_transferred_for_valuable_consideration(p: Individual, contract: us.irc.core::Asset, y: TaxableYear) kind empirical {
    label en official "the life insurance contract (or an interest therein) was transferred for a valuable consideration, by assignment or otherwise (section 101(a)(2))";
}
relation transferee_basis_determined_by_reference_to_transferor_basis(p: Individual, contract: us.irc.core::Asset) kind empirical {
    label en official "the contract/interest has a basis in the transferee's hands determined in whole or in part by reference to the transferor's basis (section 101(a)(2)(A)) — a carryover-basis transfer exempted from the (a)(2) cap";
}
relation transfer_to_insured_partner_partnership_or_corporation(p: Individual, contract: us.irc.core::Asset) kind empirical {
    label en official "the transfer is to the insured, to a partner of the insured, to a partnership in which the insured is a partner, or to a corporation in which the insured is a shareholder or officer (section 101(a)(2)(B)) — exempted from the (a)(2) cap";
}
relation transfer_is_reportable_policy_sale(p: Individual, contract: us.irc.core::Asset) kind empirical {
    label en official "the transfer is a reportable policy sale (section 101(a)(3)(B)): the acquirer has no substantial family, business, or financial relationship with the insured apart from the acquirer's interest in the contract — disables the (a)(2)(A)/(B) exemptions from the cap (section 101(a)(3)(A))";
}
relation actual_value_of_consideration_paid(p: Individual, contract: us.irc.core::Asset, amount: Money) kind empirical {
    label en official "the actual value of the consideration paid for the transfer (section 101(a)(2), first sentence)";
}
relation premiums_and_other_amounts_subsequently_paid_by_transferee(p: Individual, contract: us.irc.core::Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "premiums and other amounts (including nondeductible section 264(a)(4) interest) subsequently paid by the transferee with respect to the contract (section 101(a)(2), first and last sentences)";
}
pub relation transfer_for_value_cap_applies_101a2(p: Individual, contract: us.irc.core::Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 101(a)(2) transfer-for-value cap applies to this proceeds amount (the (a)(1) exclusion is limited to consideration paid plus later premiums, rather than excluding the full proceeds)";
}
pub relation life_insurance_proceeds_excluded_up_to_cap_101a2(p: Individual, contract: us.irc.core::Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount excluded from gross income, capped at the sum of the consideration paid and later premiums/amounts paid by the transferee (section 101(a)(2))";
}

@source(IRC_S101_A, quote = "In the case of a transfer for a valuable consideration, by assignment or otherwise, of a life insurance contract or any interest therein, the amount excluded from gross income by paragraph (1) shall not exceed an amount equal to the sum of the actual value of such consideration and the premiums and other amounts subsequently paid by the transferee.")
rule TransferForValueCapApplies(p: Individual, contract: us.irc.core::Asset, y: TaxableYear, amount: Money) strict {
    label en official "a transfer for valuable consideration caps the exclusion, unless the carryover-basis or insured/partner/partnership/corporation exemption applies (and is not itself disabled by a reportable policy sale)";
    when contract_transferred_for_valuable_consideration(p, contract, y);
    when paid_by_reason_of_death_of_insured(p, contract, y, amount);
    when not_known(carryover_basis_or_insider_transfer_exempt_101a2(p, contract));
    then transfer_for_value_cap_applies_101a2(p, contract, y, amount);
}
relation carryover_basis_or_insider_transfer_exempt_101a2(p: Individual, contract: us.irc.core::Asset) kind institutional {
    label en official "the transfer is exempted from the (a)(2) cap by (A) carryover basis or (B) an insured/partner/partnership/corporation transferee, and is not a reportable policy sale disabling that exemption";
}
@source(IRC_S101_A, quote = "if such contract or interest therein has a basis for determining gain or loss in the hands of a transferee determined in whole or in part by reference to such basis of such contract or interest therein in the hands of the transferor, or")
rule CarryoverBasisTransferExempt(p: Individual, contract: us.irc.core::Asset) strict {
    label en official "a carryover-basis transfer is exempt from the (a)(2) cap, unless it is a reportable policy sale (section 101(a)(3)(A) disables this exemption for such sales)";
    when transferee_basis_determined_by_reference_to_transferor_basis(p, contract);
    when not_known(transfer_is_reportable_policy_sale(p, contract));
    then carryover_basis_or_insider_transfer_exempt_101a2(p, contract);
}
@source(IRC_S101_A, quote = "if such transfer is to the insured, to a partner of the insured, to a partnership in which the insured is a partner, or to a corporation in which the insured is a shareholder or officer")
rule InsiderTransferExempt(p: Individual, contract: us.irc.core::Asset) strict {
    label en official "a transfer to the insured/a partner/a partnership/a corporation is exempt from the (a)(2) cap";
    when transfer_to_insured_partner_partnership_or_corporation(p, contract);
    then carryover_basis_or_insider_transfer_exempt_101a2(p, contract);
}
// §101(a)(3): "The second sentence of paragraph (2) [the (A)/(B) carve-outs
// from the cap] shall not apply ... which is a reportable policy sale."
// Already implemented above via `CarryoverBasisTransferExempt`'s own
// `not_known(transfer_is_reportable_policy_sale(...))` guard — a reportable
// policy sale simply prevents that rule from firing, which is exactly (a)(3)'s
// effect, so no separate rule concluding the SAME `transfer_for_value_cap_
// applies_101a2` head is needed (same-predicate-cycle avoidance convention).

@source(IRC_S101_A, quote = "the amount excluded from gross income by paragraph (1) shall not exceed an amount equal to the sum of the actual value of such consideration and the premiums and other amounts subsequently paid by the transferee")
rule LifeInsuranceProceedsCappedByConsiderationAndPremiums(p: Individual, contract: us.irc.core::Asset, y: TaxableYear, amount: Money, consideration: Money, premiums: Money) strict {
    label en official "the excluded amount is capped at consideration paid plus later premiums/amounts paid by the transferee";
    when transfer_for_value_cap_applies_101a2(p, contract, y, amount);
    when actual_value_of_consideration_paid(p, contract, consideration);
    when premiums_and_other_amounts_subsequently_paid_by_transferee(p, contract, y, premiums);
    when amount > (consideration + premiums);
    then life_insurance_proceeds_excluded_up_to_cap_101a2(p, contract, y, consideration + premiums);
}

// --- §101(g): accelerated death benefits --------------------------------------

pub enum InsuredHealthStatusKind {
    TerminallyIll;
    ChronicallyIll;
}
relation certified_terminally_ill(insured: Individual, y: TaxableYear) kind empirical {
    label en official "certified by a physician as having an illness or physical condition reasonably expected to result in death within 24 months of the certification (section 101(g)(4)(A))";
}
relation certified_chronically_ill(insured: Individual, y: TaxableYear) kind empirical {
    label en official "a chronically ill individual within the meaning of section 7702B(c)(2), other than a terminally ill individual (section 101(g)(4)(B))";
}
relation received_under_life_insurance_contract_on_life_of(p: Individual, insured: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "an amount received under a life insurance contract on the life of the named insured (section 101(g)(1))";
}
relation chronically_ill_payment_meets_qualified_ltc_conditions_101g3(p: Individual, insured: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "for a chronically ill insured, the payment is for costs incurred for qualified long-term care services satisfying section 7702B(b)(1)(B) and any applicable (g)(3)(B) requirements (section 101(g)(3)(A)) — EXTERNAL_DEPENDENCY: the section 7702B qualification itself is not modelled, asserted as a case fact";
}
relation payee_has_business_insurable_interest_101g5(payee: Individual, insured: Individual) kind empirical {
    label en official "the payee (other than the insured) has an insurable interest in the insured's life by reason of the insured being a director, officer, or employee of the payee, or being financially interested in a trade or business the payee carries on (section 101(g)(5)) — disqualifies the payment from (g) treatment";
}
pub relation treated_as_paid_by_reason_of_death_101g(p: Individual, insured: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the accelerated death benefit is treated as an amount paid by reason of the death of the insured, for purposes of section 101 (section 101(g)(1))";
}

@source(IRC_S101_G, quote = "Any amount received under a life insurance contract on the life of an insured who is a terminally ill individual.")
rule AcceleratedBenefitTerminallyIllTreatedAsDeathBenefit(p: Individual, insured: Individual, y: TaxableYear, amount: Money) strict {
    label en official "an amount received under a life insurance contract on a terminally ill insured's life is treated as paid by reason of death";
    when received_under_life_insurance_contract_on_life_of(p, insured, y, amount);
    when certified_terminally_ill(insured, y);
    when not_known(payee_has_business_insurable_interest_101g5(p, insured));
    then treated_as_paid_by_reason_of_death_101g(p, insured, y, amount);
}
@source(IRC_S101_G, quote = "Any amount received under a life insurance contract on the life of an insured who is a chronically ill individual.")
rule AcceleratedBenefitChronicallyIllTreatedAsDeathBenefit(p: Individual, insured: Individual, y: TaxableYear, amount: Money) strict {
    label en official "an amount received under a life insurance contract on a chronically ill insured's life is treated as paid by reason of death, if the (g)(3) qualified-long-term-care-payment conditions are met";
    when received_under_life_insurance_contract_on_life_of(p, insured, y, amount);
    when certified_chronically_ill(insured, y);
    when chronically_ill_payment_meets_qualified_ltc_conditions_101g3(p, insured, y, amount);
    when not_known(payee_has_business_insurable_interest_101g5(p, insured));
    then treated_as_paid_by_reason_of_death_101g(p, insured, y, amount);
}
// §101(g)(5) (@source(IRC_S101_G, quote = "This subsection shall not apply in
// the case of any amount paid to any taxpayer other than the insured if such
// taxpayer has an insurable interest ...")): applied via the `not_known(payee_
// has_business_insurable_interest_101g5(...))` guards in the two rules above,
// not a separate rule (the fact is empirical/case-asserted, not derived).
// (g)(2) viatical-settlement-provider treatment and (g)(3)(B)-(D)'s detailed
// per-diem/limitation sub-mechanics are EXTERNAL_DEPENDENCY/TECH_GAP: each
// turns on licensing/NAIC-standard facts or a section 7702B(d) periodic-
// payment ceiling this package does not model; folded into
// `chronically_ill_payment_meets_qualified_ltc_conditions_101g3`'s own case
// fact where relevant.

// --- §101(j): employer-owned life insurance contracts --------------------------

relation employer_owned_life_insurance_contract(contract: us.irc.core::Asset, policyholder: us.irc.core::Person, insured: Individual) kind empirical {
    label en official "a life insurance contract owned by a person engaged in a trade or business, under which that person (or a related person) is directly or indirectly a beneficiary, covering the life of an employee of the trade or business as of issuance (section 101(j)(3)(A))";
}
relation amount_received_by_policyholder_by_reason_of_death(policyholder: us.irc.core::Person, contract: us.irc.core::Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "an amount the applicable policyholder receives by reason of the death of the insured under the employer-owned contract (section 101(j)(1))";
}
relation premiums_and_other_amounts_paid_by_policyholder(contract: us.irc.core::Asset, policyholder: us.irc.core::Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "premiums and other amounts paid by the applicable policyholder for the employer-owned contract (section 101(j)(1))";
}
pub relation employer_owned_life_insurance_excluded_up_to_cap_101j(policyholder: us.irc.core::Person, insured: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount excluded to the applicable policyholder, capped at premiums and other amounts paid, absent a (j)(2) exception (section 101(j)(1))";
}
@source(IRC_S101_J, quote = "the amount excluded from gross income of an applicable policyholder by reason of paragraph (1) of subsection (a) shall not exceed an amount equal to the sum of the premiums and other amounts paid by the policyholder for the contract")
rule EmployerOwnedLifeInsuranceCappedAmount(contract: us.irc.core::Asset, policyholder: us.irc.core::Person, insured: Individual, y: TaxableYear, amount: Money, premiums: Money) strict {
    label en official "absent a (j)(2) exception, the exclusion to the policyholder is capped at premiums and other amounts paid";
    when employer_owned_life_insurance_contract(contract, policyholder, insured);
    when amount_received_by_policyholder_by_reason_of_death(policyholder, contract, y, amount);
    when premiums_and_other_amounts_paid_by_policyholder(contract, policyholder, y, premiums);
    when not_known(employer_owned_life_insurance_exception_101j2(contract, policyholder, insured));
    when amount > premiums;
    then employer_owned_life_insurance_excluded_up_to_cap_101j(policyholder, insured, y, premiums);
}
@source(IRC_S101_J, quote = "the amount excluded from gross income of an applicable policyholder by reason of paragraph (1) of subsection (a) shall not exceed an amount equal to the sum of the premiums and other amounts paid by the policyholder for the contract")
rule EmployerOwnedLifeInsuranceUnderCapFullyExcluded(contract: us.irc.core::Asset, policyholder: us.irc.core::Person, insured: Individual, y: TaxableYear, amount: Money, premiums: Money) strict {
    label en official "an amount not exceeding premiums paid is fully excluded (the cap does not reduce it)";
    when employer_owned_life_insurance_contract(contract, policyholder, insured);
    when amount_received_by_policyholder_by_reason_of_death(policyholder, contract, y, amount);
    when premiums_and_other_amounts_paid_by_policyholder(contract, policyholder, y, premiums);
    when not_known(employer_owned_life_insurance_exception_101j2(contract, policyholder, insured));
    when amount <= premiums;
    then employer_owned_life_insurance_excluded_up_to_cap_101j(policyholder, insured, y, amount);
}

relation notice_and_consent_met_101j4(contract: us.irc.core::Asset, insured: Individual) kind empirical {
    label en official "before issuance, the employee was notified in writing of the intent to insure and the maximum face amount, gave written consent (including to post-termination coverage), and was informed the policyholder would be a beneficiary (section 101(j)(4)(A)-(C))";
}
relation insured_was_employee_within_12_months_before_death_101j2a(insured: Individual, policyholder: us.irc.core::Person) kind empirical {
    label en official "the insured was an employee of the applicable policyholder at any time during the 12-month period before death, or at issuance was a director/highly-compensated employee/highly-compensated individual (section 101(j)(2)(A))";
}
relation amount_paid_to_family_designated_beneficiary_trust_or_estate_101j2b(contract: us.irc.core::Asset, insured: Individual) kind empirical {
    label en official "the amount is paid to a family member (section 267(c)(4)), a designated beneficiary other than the policyholder, a trust for their benefit, the insured's estate, or used to purchase an equity interest from such a person (section 101(j)(2)(B))";
}
pub relation employer_owned_life_insurance_exception_101j2(contract: us.irc.core::Asset, policyholder: us.irc.core::Person, insured: Individual) kind institutional {
    label en official "a section 101(j)(2) exception applies (insured's status, or amounts paid to heirs), conditioned on the (j)(4) notice-and-consent requirements being met: the (j)(1) cap does not apply";
}
@source(IRC_S101_J, quote = "Any amount received by reason of the death of an insured who, with respect to an applicable policyholder—")
rule EmployerOwnedLifeInsuranceExceptionInsuredStatus(contract: us.irc.core::Asset, policyholder: us.irc.core::Person, insured: Individual) strict {
    label en official "with notice and consent met, the (j)(1) cap does not apply where the insured was recently an employee, or was a director/HCE/HCI at issuance";
    when employer_owned_life_insurance_contract(contract, policyholder, insured);
    when notice_and_consent_met_101j4(contract, insured);
    when insured_was_employee_within_12_months_before_death_101j2a(insured, policyholder);
    then employer_owned_life_insurance_exception_101j2(contract, policyholder, insured);
}
@source(IRC_S101_J, quote = "Any amount received by reason of the death of an insured to the extent—")
rule EmployerOwnedLifeInsuranceExceptionHeirs(contract: us.irc.core::Asset, policyholder: us.irc.core::Person, insured: Individual) strict {
    label en official "with notice and consent met, the (j)(1) cap does not apply to the extent the proceeds are paid to the insured's family/designated beneficiary/trust/estate";
    when employer_owned_life_insurance_contract(contract, policyholder, insured);
    when notice_and_consent_met_101j4(contract, insured);
    when amount_paid_to_family_designated_beneficiary_trust_or_estate_101j2b(contract, insured);
    then employer_owned_life_insurance_exception_101j2(contract, policyholder, insured);
}
@source(IRC_S101_J, quote = "paragraph (1) shall not apply to any of the following:")
rule EmployerOwnedLifeInsuranceExceptionFullyExcluded(contract: us.irc.core::Asset, policyholder: us.irc.core::Person, insured: Individual, y: TaxableYear, amount: Money) strict {
    label en official "when a (j)(2) exception applies, the (j)(1) cap does not apply and the full amount received is excluded to the policyholder (subject to the underlying section 101(a)(1) exclusion)";
    when employer_owned_life_insurance_contract(contract, policyholder, insured);
    when amount_received_by_policyholder_by_reason_of_death(policyholder, contract, y, amount);
    when employer_owned_life_insurance_exception_101j2(contract, policyholder, insured);
    then employer_owned_life_insurance_excluded_up_to_cap_101j(policyholder, insured, y, amount);
}
