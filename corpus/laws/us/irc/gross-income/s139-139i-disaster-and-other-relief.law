// Sections 139, 139A-139I — disaster relief and miscellaneous exclusions.
// Stage 2d (IRC-06). Each section's general exclusion rule is modelled;
// deep sub-definitions (constructive-ownership-style cross-references,
// procedural/administrative subsections) are taken as case-asserted
// compound facts rather than decomposed, given the number of short
// sections in this group. NOT reached per section: §139(d)-(h) (self-
// employment/wage non-treatment, the terrorist-participant carve-out, the
// no-basis-increase rule, the no-double-benefit rule); §139B(b) (the
// section 164/170 coordination for members who do NOT elect the (a)
// exclusion — a distinct branch this pass does not model); §139C(c)(3)
// (the partial-12-month-period proration); §139D(d) (the anti-double-
// exclusion coordination); §139E(c)(3)-(5) (Secretary guidelines, tribal-
// custom-program savings clause, cultural-honorarium carve-out); §139F(b)
// (the wrongfully-incarcerated-individual definition's own multi-branch
// pardon/reversal test — taken as one compound case fact); §139G(b)-(f)
// (the Settlement Trust inclusion, assignment-formality, and no-deduction
// rules — a Native Corporation/ANCSA-specific regime this pass does not
// build out beyond the (a) exclusion).

// =====================================================================
// §139: qualified disaster relief payments
// =====================================================================

use self::{
    IRC_S139A,
    IRC_S139B_A,
    IRC_S139B_C,
    IRC_S139C_A,
    IRC_S139D_A,
    IRC_S139E_A,
    IRC_S139F_A,
    IRC_S139G_A,
    IRC_S139H,
    IRC_S139I,
    IRC_S139_A,
    IRC_S139_F,
    IRC_S139_G,
    Individual,
    Person,
    TaxableYear,
    section_139_exclusion_denied_139e,
};

pub enum QualifiedDisasterReliefPaymentKind {
    PersonalFamilyLivingOrFuneralExpenses;  // (b)(1)
    ResidenceRepairOrRehabilitation;        // (b)(2)
    CommonCarrierDeathOrInjury;             // (b)(3)
    GovernmentGeneralWelfare;               // (b)(4)
}
pub relation qualified_disaster_relief_payment(p: Individual, y: TaxableYear, kind: QualifiedDisasterReliefPaymentKind, amount: Money, disaster: us.irc.core::Organ) kind empirical {
    label en official "an amount paid to or for the benefit of an individual within one of the four section 139(b) categories, in connection with a qualified disaster, not otherwise compensated by insurance (section 139(a)-(b))";
}
pub relation qualified_disaster_139c(disaster: us.irc.core::Organ) kind empirical {
    label en official "a qualified disaster within the meaning of section 139(c): terroristic/military action, a federally declared disaster, a catastrophic common-carrier/other accident, or (for (b)(4) amounts) a government-determined disaster warranting assistance (section 139(c)(1)-(4))";
}
pub relation qualified_disaster_relief_payment_excluded_139a(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "gross income does not include a qualified disaster relief payment (section 139(a))";
}
@source(IRC_S139_A, quote = "Gross income shall not include any amount received by an individual as a qualified disaster relief payment.")
rule QualifiedDisasterReliefPaymentExcluded(p: Individual, y: TaxableYear, kind: QualifiedDisasterReliefPaymentKind, amount: Money, disaster: us.irc.core::Organ) strict {
    label en official "section 139(a), for a payment within a section 139(c) qualified disaster";
    when qualified_disaster_relief_payment(p, y, kind, amount, disaster);
    when qualified_disaster_139c(disaster);
    when not_known(section_139_exclusion_denied_139e(p));
    then qualified_disaster_relief_payment_excluded_139a(p, y, amount);
}

pub relation air_transportation_safety_act_payment_excluded_139f(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "gross income does not include an amount received as payment under section 406 of the Air Transportation Safety and System Stabilization Act (section 139(f))";
}
relation air_transportation_safety_act_payment_received(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "an amount received as payment under section 406 of the Air Transportation Safety and System Stabilization Act (section 139(f))";
}
@source(IRC_S139_F, quote = "Gross income shall not include any amount received as payment under section 406 of the Air Transportation Safety and System Stabilization Act.")
rule AirTransportationSafetyActPaymentExcluded(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 139(f)";
    when air_transportation_safety_act_payment_received(p, y, amount);
    when not_known(section_139_exclusion_denied_139e(p));
    then air_transportation_safety_act_payment_excluded_139f(p, y, amount);
}

pub relation qualified_disaster_mitigation_payment_excluded_139g(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "gross income does not include a qualified disaster mitigation payment under the Stafford Act (section 139(g)(1))";
}
relation qualified_disaster_mitigation_payment_received(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "an amount paid pursuant to the Robert T. Stafford Disaster Relief and Emergency Assistance Act as a hazard mitigation payment (section 139(g)(2))";
}
@source(IRC_S139_G, quote = "Gross income shall not include any amount received as a qualified disaster mitigation payment.")
rule QualifiedDisasterMitigationPaymentExcluded(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 139(g)(1)";
    when qualified_disaster_mitigation_payment_received(p, y, amount);
    when not_known(section_139_exclusion_denied_139e(p));
    then qualified_disaster_mitigation_payment_excluded_139g(p, y, amount);
}

// =====================================================================
// §139A: Medicare Part D special subsidy payments
// =====================================================================

pub relation medicare_part_d_special_subsidy_excluded_139a_section(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "gross income does not include a special subsidy payment received under section 1860D-22 of the Social Security Act (section 139A)";
}
relation medicare_part_d_special_subsidy_received(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "a special subsidy payment received under section 1860D-22 of the Social Security Act (section 139A)";
}
@source(IRC_S139A, quote = "Gross income shall not include any special subsidy payment received under section 1860D–22 of the Social Security Act.")
rule MedicarePartDSpecialSubsidyExcluded(p: Person, y: TaxableYear, amount: Money) strict {
    label en official "section 139A";
    when medicare_part_d_special_subsidy_received(p, y, amount);
    then medicare_part_d_special_subsidy_excluded_139a_section(p, y, amount);
}

// =====================================================================
// §139B: volunteer emergency responders
// =====================================================================

pub relation qualified_volunteer_emergency_responder_139b(p: Individual) kind empirical {
    label en official "a member of a qualified volunteer emergency response organization within the meaning of section 139B(c)(3): a volunteer organization organized to provide firefighting/EMS services and required by written agreement to furnish them (section 139B(c)(3)(A)-(B))";
}
pub relation qualified_state_local_tax_benefit_139b(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "a reduction or rebate of a section 164(a)(1)-(3) tax provided by a State or political subdivision on account of the member's services (section 139B(c)(1))";
}
pub relation qualified_payment_139b_amount(p: Individual, y: TaxableYear, months: Integer, amount: Money) kind empirical {
    label en official "a payment (reimbursement or otherwise) provided by a State or political subdivision on account of the member's services, before the (c)(2)(B) $50-per-month cap (section 139B(c)(2)(A))";
}
pub relation qualified_payment_139b_capped(p: Individual, y: TaxableYear, months: Integer, amount: Money) kind institutional {
    label en official "the section 139B(c)(2)(B) $50-per-month cap on the qualified payment";
}
@source(IRC_S139B_C, quote = "The amount determined under subparagraph (A) for any taxable year shall not exceed $50 multiplied by the number of months during such year that the taxpayer performs such services.")
rule QualifiedPayment139bCapped(p: Individual, y: TaxableYear, months: Integer, raw: Money) strict {
    label en official "section 139B(c)(2)(B): $50 x months";
    when qualified_payment_139b_amount(p, y, months, raw);
    then qualified_payment_139b_capped(p, y, months, min(raw, round(50.00 USD * months, 2, "HALF_UP")));
}
pub relation volunteer_emergency_responder_excluded_139b(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "gross income does not include the member's qualified State/local tax benefit and qualified (capped) payment (section 139B(a)(1)-(2))";
}
@source(IRC_S139B_A, quote = "In the case of any member of a qualified volunteer emergency response organization, gross income shall not include—\n(1) any qualified State and local tax benefit, and\n(2) any qualified payment.")
rule VolunteerEmergencyResponderExcluded(p: Individual, y: TaxableYear, tax_benefit: Money, payment: Money) strict {
    label en official "section 139B(a)";
    when qualified_volunteer_emergency_responder_139b(p);
    when qualified_state_local_tax_benefit_139b(p, y, tax_benefit);
    when qualified_payment_139b_capped(p, y, _, payment);
    then volunteer_emergency_responder_excluded_139b(p, y, round(tax_benefit + payment, 2, "HALF_UP"));
}

// =====================================================================
// §139C: first responder retirement payments
// =====================================================================

pub relation qualified_first_responder_retirement_payment(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "a pension or annuity, from a plan described in section 402(c)(8)(B)(iii)-(vi), received in connection with qualified first responder service (law enforcement officer, firefighter, paramedic, or EMT) (section 139C(b),(d))";
}
pub relation annualized_excludable_disability_amount_139c(p: Individual, amount: Money) kind empirical {
    label en official "the service-connected excludable disability amounts (section 104(a)(1)-excluded periodic payments received in connection with qualified first responder service, terminating at retirement age) attributable to the 12 months immediately before retirement (section 139C(c)(1)-(2))";
}
pub relation first_responder_retirement_payment_excluded_139c(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "gross income does not include so much of the qualified first responder retirement payment as does not exceed the annualized excludable disability amount (section 139C(a))";
}
@source(IRC_S139C_A, quote = "gross income shall not include so much of such payments as do not exceed the annualized excludable disability amount")
rule FirstResponderRetirementPaymentExcluded(p: Individual, y: TaxableYear, payment: Money, cap: Money) strict {
    label en official "section 139C(a)";
    when qualified_first_responder_retirement_payment(p, y, payment);
    when annualized_excludable_disability_amount_139c(p, cap);
    then first_responder_retirement_payment_excluded_139c(p, y, min(payment, cap));
}

// =====================================================================
// §139D: Indian health care benefits
// =====================================================================

pub relation qualified_indian_health_care_benefit(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "a health service/benefit provided or purchased by the Indian Health Service through a tribal grant/contract/compact, medical care provided by an Indian tribe or tribal organization, tribal accident-or-health coverage, or other supplemental tribal medical care (section 139D(b)(1)-(4))";
}
pub relation indian_health_care_benefit_excluded_139d(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "gross income does not include the value of a qualified Indian health care benefit (section 139D(a))";
}
@source(IRC_S139D_A, quote = "gross income does not include the value of any qualified Indian health care benefit")
rule IndianHealthCareBenefitExcluded(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 139D(a)";
    when qualified_indian_health_care_benefit(p, y, amount);
    then indian_health_care_benefit_excluded_139d(p, y, amount);
}

// =====================================================================
// §139E: Indian general welfare benefits
// =====================================================================

pub relation indian_general_welfare_benefit(p: Individual, tribe: us.irc.core::Organ, y: TaxableYear, amount: Money) kind empirical {
    label en official "a payment made or services provided to or on behalf of a member of an Indian tribe (or spouse/dependent) under a nondiscriminatory tribal-government program whose benefits are available to any qualifying member, promote general welfare, are not lavish/extravagant, and are not compensation for services (section 139E(b)(1)-(2))";
}
pub relation indian_general_welfare_benefit_excluded_139e(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "gross income does not include the value of an Indian general welfare benefit (section 139E(a))";
}
@source(IRC_S139E_A, quote = "Gross income does not include the value of any Indian general welfare benefit.")
rule IndianGeneralWelfareBenefitExcluded(p: Individual, tribe: us.irc.core::Organ, y: TaxableYear, amount: Money) strict {
    label en official "section 139E(a)";
    when indian_general_welfare_benefit(p, tribe, y, amount);
    then indian_general_welfare_benefit_excluded_139e(p, y, amount);
}

// =====================================================================
// §139F: wrongfully incarcerated individuals
// =====================================================================

pub relation wrongfully_incarcerated_individual_139f(p: Individual) kind empirical {
    label en official "an individual convicted of a covered offense who served all or part of a sentence and was pardoned/granted clemency or amnesty for innocence, or whose conviction was reversed/vacated and the charge dismissed or who was acquitted at retrial (section 139F(b)(1)-(3)) — a compound multi-branch test taken as one case-asserted fact";
}
pub relation wrongful_incarceration_award(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "civil damages, restitution, or other monetary award (compensatory, statutory, or nominal) received by a wrongfully incarcerated individual relating to the covered offense or the time served (section 139F(a))";
}
pub relation wrongful_incarceration_award_excluded_139f(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "gross income does not include a wrongful-incarceration award (section 139F(a))";
}
@source(IRC_S139F_A, quote = "gross income shall not include any civil damages, restitution, or other monetary award (including compensatory or statutory damages and restitution")
rule WrongfulIncarcerationAwardExcluded(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 139F(a)";
    when wrongfully_incarcerated_individual_139f(p);
    when wrongful_incarceration_award(p, y, amount);
    then wrongful_incarceration_award_excluded_139f(p, y, amount);
}

// =====================================================================
// §139G: Alaska Native Settlement Trust payment assignments
// =====================================================================

pub relation native_corporation_assigned_payment_139g(corp: Person, trust: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "a payment that would otherwise be made (or treated as made) to a Native Corporation, assigned in writing to a Settlement Trust before receipt by the Corporation (section 139G(a)(1)-(2))";
}
pub relation native_corporation_assigned_payment_excluded_139g(corp: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "gross income of the Native Corporation does not include a validly assigned payment (section 139G(a))";
}
@source(IRC_S139G_A, quote = "In the case of a Native Corporation, gross income shall not include the value of any payments that would otherwise be made, or treated as being made, to such Native Corporation")
rule NativeCorporationAssignedPaymentExcluded(corp: Person, trust: Person, y: TaxableYear, amount: Money) strict {
    label en official "section 139G(a)";
    when native_corporation_assigned_payment_139g(corp, trust, y, amount);
    then native_corporation_assigned_payment_excluded_139g(corp, y, amount);
}

// =====================================================================
// §139H: interest on wrongful IRS seizure recovery
// =====================================================================

pub relation irs_seizure_interest_received_139h(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "interest received from the Federal Government in connection with an action to recover property seized by the IRS under 31 U.S.C. 5317(c)(2) (section 139H)";
}
pub relation irs_seizure_interest_excluded_139h(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "gross income does not include this interest (section 139H)";
}
@source(IRC_S139H, quote = "Gross income shall not include any interest received from the Federal Government in connection with an action to recover property seized by the Internal Revenue Service pursuant to section 5317(c)(2)")
rule IrsSeizureInterestExcluded(p: Person, y: TaxableYear, amount: Money) strict {
    label en official "section 139H";
    when irs_seizure_interest_received_139h(p, y, amount);
    then irs_seizure_interest_excluded_139h(p, y, amount);
}

// =====================================================================
// §139I: COBRA premium assistance (American Rescue Plan Act)
// =====================================================================

pub relation arpa_assistance_eligible_individual_139i(p: Individual) kind empirical {
    label en official "an assistance eligible individual as defined in section 9501(a)(3) of the American Rescue Plan Act of 2021 (section 139I)";
}
pub relation cobra_premium_assistance_received_139i(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "premium assistance provided under section 9501 of the American Rescue Plan Act of 2021 (section 139I)";
}
pub relation cobra_premium_assistance_excluded_139i(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "gross income does not include the COBRA premium assistance (section 139I)";
}
@source(IRC_S139I, quote = "gross income does not include any premium assistance provided")
rule CobraPremiumAssistanceExcluded(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 139I";
    when arpa_assistance_eligible_individual_139i(p);
    when cobra_premium_assistance_received_139i(p, y, amount);
    then cobra_premium_assistance_excluded_139i(p, y, amount);
}
