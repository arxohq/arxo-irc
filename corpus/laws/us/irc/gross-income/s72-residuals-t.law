// Stage 2f (TECH_GAP reduction) — §72(t) residuals: exceptions (2)(A)(vi),(viii),(ix)
// and the deemed-equal sentence, (2)(D)-(M) and their plan-treatment and
// repayment clauses, (3) blockers, (4) modification recapture, (5), (6), (7), (8),
// (9), (10)(B), (11).
// STATUS: implemented_unverified (static check only; scenarios in
// tests/s72-residuals.lawtest are NOT executed).
//
// TECHNIQUE: the earlier rules of s72-annuities.law (the exceptions of (2)(A)-(C),
// (H), (I), (K), the additional-tax rules) stay; this module adds the exceptions
// that were not modelled, parallel rules over statuses it derives, guards on the
// earlier exception rules for paragraphs (3) and (6), and generic clauses that
// several subparagraphs share ("rules similar to those of (H)(v)").
// Distribution-level exceptions are attached to the earlier
// `RetirementDistributionEvent`; the exemption amounts feed
// `distribution_fully_exempt_72t` and `distribution_partial_exemption_amount_72t`.

// =====================================================================
// §72(t)(3): blockers of exceptions for IRAs and for qualified-trust series
// =====================================================================

use self::{
    IRC_S72_T,
    Individual,
    InsuredHealthStatusKind,
    Person,
    QualifiedDisaster72p6,
    RetirementArrangement,
    RetirementDistributionEvent,
    TaxableYear,
    applicable_date_72t11Fiii,
    distribution_date,
    distribution_fully_exempt_72t,
    distribution_part_of_sepp_series,
    distribution_partial_exemption_amount_72t,
    has_partial_exemption_72t,
    incident_period_72t11Fii,
    plan_maintained_by_employer_group_72p2e,
    qualified_individual_72p6c,
    retirement_plan_distribution_received,
    sepp_recapture_tax_72t4,
};

relation distribution_from_individual_retirement_plan_72t3A(d: RetirementDistributionEvent) kind empirical {
    label en official "the distribution is from an individual retirement plan";
}
pub relation exception_a5_and_c_barred_for_ira_72t3A(d: RetirementDistributionEvent) kind institutional {
    label en official "subparagraphs (A)(v) (separation from service after the required age) and (C) (alternate payee under a qualified domestic relations order) of paragraph (2) do not apply to a distribution from an individual retirement plan";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "Subparagraphs (A)(v) and (C) of paragraph (2) shall not apply to distributions from an individual retirement plan.")
rule ExceptionsA5AndCBarredForIra(d: RetirementDistributionEvent) strict {
    label en official "section 72(t)(3)(A); the earlier rules ExceptionSeparationAfter55, ExceptionSeparationAfter50PublicSafety and ExceptionQdro carry a not_known guard on this status";
    when distribution_from_individual_retirement_plan_72t3A(d);
    then exception_a5_and_c_barred_for_ira_72t3A(d);
}
relation distribution_paid_from_401a_trust_or_5D_contract_72t3B(d: RetirementDistributionEvent) kind empirical {
    label en official "the amount is paid from a trust described in section 401(a) which is exempt from tax under section 501(a) or from a contract described in section 72(e)(5)(D)(ii)";
}
relation sepp_series_begins_after_separation_from_service_72t3B(d: RetirementDistributionEvent) kind empirical {
    label en official "the series of payments begins after the employee separates from service";
}
pub relation sepp_exception_barred_from_qualified_trust_72t3B(d: RetirementDistributionEvent) kind institutional {
    label en official "paragraph (2)(A)(iv) does not apply to an amount paid from such a trust or contract unless the series of payments begins after the employee separates from service";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "Paragraph (2)(A)(iv) shall not apply to any amount paid from a trust described in section 401(a) which is exempt from tax under section 501(a) or from a contract")
rule SeppExceptionBarredFromQualifiedTrust(d: RetirementDistributionEvent) strict {
    label en official "section 72(t)(3)(B); the earlier rule ExceptionSeppSeries carries a not_known guard on this status";
    when distribution_paid_from_401a_trust_or_5D_contract_72t3B(d);
    when not_known(sepp_series_begins_after_separation_from_service_72t3B(d));
    then sepp_exception_barred_from_qualified_trust_72t3B(d);
}

// =====================================================================
// §72(t)(2)(A)(iv) closing sentence; (vi), (viii), (ix)
// =====================================================================

relation distribution_payable_over_period_of_clause_iv_72t(p: Individual, d: RetirementDistributionEvent) kind empirical {
    label en official "the periodic payments are payable over a period described in clause (iv) (the life or life expectancy of the employee, or the joint lives or life expectancies of the employee and beneficiary)";
}
relation distribution_periodic_payments_satisfy_401a9_annuity_rules_72t(p: Individual, d: RetirementDistributionEvent) kind empirical {
    label en official "the payments satisfy the requirements applicable to annuity payments under section 401(a)(9)";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "For purposes of clause (iv), periodic payments shall not fail to be treated as substantially equal merely because they are amounts received as an annuity, and such")
rule ExceptionSeppDeemedSubstantiallyEqual(p: Individual, d: RetirementDistributionEvent) strict {
    label en official "section 72(t)(2)(A)(iv), closing sentence: payments payable over the clause (iv) period that satisfy the section 401(a)(9) annuity requirements are deemed substantially equal (being amounts received as an annuity does not defeat the equality)";
    when distribution_payable_over_period_of_clause_iv_72t(p, d);
    when distribution_periodic_payments_satisfy_401a9_annuity_rules_72t(p, d);
    when not_known(sepp_exception_barred_from_qualified_trust_72t3B(d));
    then distribution_fully_exempt_72t(d);
}
relation distribution_is_404k_dividend_72t2Avi(d: RetirementDistributionEvent) kind empirical {
    label en official "the distribution is a dividend paid with respect to stock of a corporation which is described in section 404(k)";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "(vi) dividends paid with respect to stock of a corporation which are described in section 404(k),")
rule Exception404kDividends(d: RetirementDistributionEvent) strict {
    label en official "section 72(t)(2)(A)(vi)";
    when distribution_is_404k_dividend_72t2Avi(d);
    then distribution_fully_exempt_72t(d);
}
relation distribution_is_phased_or_composite_retirement_annuity_72t2Aviii(d: RetirementDistributionEvent) kind empirical {
    label en official "the distribution is a payment under a phased retirement annuity under section 8366a(a)(5) or 8412a(a)(5) of title 5, United States Code, or a composite retirement annuity under section 8366a(a)(1) or 8412a(a)(1) of that title";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "(viii) payments under a phased retirement annuity under section 8366a(a)(5) [3] or 8412a(a)(5) of title 5, United States Code, or a composite retirement annuity under")
rule ExceptionPhasedRetirementAnnuity(d: RetirementDistributionEvent) strict {
    label en official "section 72(t)(2)(A)(viii)";
    when distribution_is_phased_or_composite_retirement_annuity_72t2Aviii(d);
    then distribution_fully_exempt_72t(d);
}
relation distribution_is_net_income_withdrawn_under_408d4_72t2Aix(d: RetirementDistributionEvent) kind empirical {
    label en official "the distribution is attributable to the withdrawal of net income attributable to a contribution which is distributed pursuant to section 408(d)(4)";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "(ix) attributable to withdrawal of net income attributable to a contribution which is distributed pursuant to section 408(d)(4).")
rule Exception408d4NetIncome(d: RetirementDistributionEvent) strict {
    label en official "section 72(t)(2)(A)(ix)";
    when distribution_is_net_income_withdrawn_under_408d4_72t2Aix(d);
    then distribution_fully_exempt_72t(d);
}

// =====================================================================
// §72(t)(2)(D): health insurance premiums of an unemployed individual (IRA)
// =====================================================================

relation ira_distribution_after_separation_from_employment_72t2D(p: Individual, d: RetirementDistributionEvent) kind empirical {
    label en official "the distribution is from an individual retirement plan to an individual after separation from employment";
}
relation consecutive_weeks_of_unemployment_compensation_by_reason_of_separation_72t2D(p: Individual, weeks: Integer) kind empirical {
    label en official "the number of consecutive weeks the individual has received unemployment compensation under a Federal or State law by reason of the separation";
}
relation self_employed_would_have_received_unemployment_compensation_72t2Diii(p: Individual) kind empirical {
    label en official "under Federal or State law the self-employed individual would have received unemployment compensation but for being self-employed (to the extent provided in regulations)";
}
relation unemployment_compensation_paid_in_year_72t2D(p: Individual, y: TaxableYear) kind empirical {
    label en official "unemployment compensation is paid to the individual during the taxable year";
}
relation year_follows_year_72t(earlier: TaxableYear, later: TaxableYear) kind empirical {
    label en official "the later taxable year is the succeeding taxable year of the earlier";
}
relation health_insurance_premiums_paid_213d1D_72t2D(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount paid during the taxable year for insurance described in section 213(d)(1)(D) with respect to the individual and the individual's spouse and dependents (section 152 without regard to (b)(1), (b)(2) and (d)(1)(B))";
}
relation employed_at_least_60_days_after_separation_before_distribution_72t2Dii(p: Individual, d: RetirementDistributionEvent) kind empirical {
    label en official "the individual has been employed for at least 60 days after the separation from employment before the distribution is made";
}
pub relation unemployment_condition_of_72t2D_met(p: Individual) kind institutional {
    label en official "the individual has received unemployment compensation for 12 consecutive weeks, or is a self-employed individual treated as meeting that requirement";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "(I) if such individual has received unemployment compensation for 12 consecutive weeks under any Federal or State unemployment compensation law by reason of such")
rule UnemploymentCondition12Weeks(p: Individual, weeks: Integer) strict {
    label en official "section 72(t)(2)(D)(i)(I): at least 12 consecutive weeks";
    when consecutive_weeks_of_unemployment_compensation_by_reason_of_separation_72t2D(p, weeks);
    when weeks >= 12;
    then unemployment_condition_of_72t2D_met(p);
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "To the extent provided in regulations, a self-employed individual shall be treated as meeting the requirements of clause (i)(I) if, under Federal or State law, the")
rule UnemploymentConditionSelfEmployed(p: Individual) strict {
    label en official "section 72(t)(2)(D)(iii)";
    when self_employed_would_have_received_unemployment_compensation_72t2Diii(p);
    then unemployment_condition_of_72t2D_met(p);
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "(II) if such distributions are made during any taxable year during which such unemployment compensation is paid or the succeeding taxable year, and")
rule ExceptionUnemploymentHealthInsuranceSameYear(p: Individual, d: RetirementDistributionEvent, y: TaxableYear, dist: Money, premiums: Money) strict {
    label en official "section 72(t)(2)(D)(i)(II)-(III), (ii): exempt up to the premiums, in a year unemployment compensation is paid; not after 60 days of re-employment";
    when retirement_plan_distribution_received(p, d, y, dist);
    when ira_distribution_after_separation_from_employment_72t2D(p, d);
    when unemployment_condition_of_72t2D_met(p);
    when unemployment_compensation_paid_in_year_72t2D(p, y);
    when health_insurance_premiums_paid_213d1D_72t2D(p, y, premiums);
    when not_known(employed_at_least_60_days_after_separation_before_distribution_72t2Dii(p, d));
    then distribution_partial_exemption_amount_72t(d, min(dist, premiums));
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "(II) if such distributions are made during any taxable year during which such unemployment compensation is paid or the succeeding taxable year, and")
rule ExceptionUnemploymentHealthInsuranceSucceedingYear(p: Individual, d: RetirementDistributionEvent, y: TaxableYear, y0: TaxableYear, dist: Money, premiums: Money) strict {
    label en official "section 72(t)(2)(D)(i)(II): the distribution year is the year following one in which unemployment compensation was paid";
    when retirement_plan_distribution_received(p, d, y, dist);
    when ira_distribution_after_separation_from_employment_72t2D(p, d);
    when unemployment_condition_of_72t2D_met(p);
    when year_follows_year_72t(y0, y);
    when unemployment_compensation_paid_in_year_72t2D(p, y0);
    when health_insurance_premiums_paid_213d1D_72t2D(p, y, premiums);
    when not_known(employed_at_least_60_days_after_separation_before_distribution_72t2Dii(p, d));
    then distribution_partial_exemption_amount_72t(d, min(dist, premiums));
}

// =====================================================================
// §72(t)(2)(E), (7): qualified higher education expenses
// =====================================================================

pub enum EducationRecipient72t7 { TaxpayerHimself; TaxpayersSpouse; ChildOrGrandchildOfTaxpayerOrSpouse; OtherRecipient; }
relation higher_education_expenses_72t7(p: Individual, y: TaxableYear, recipient: EducationRecipient72t7, at_eligible_institution_529e5: Boolean, amount: Money) kind empirical {
    label en official "qualified higher education expenses within section 529(e)(3) for education furnished to the recipient at an institution, with the fact whether it is an eligible educational institution (section 529(e)(5))";
}
relation education_expense_reduction_25Ag2_72t7b(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the reduction of the qualified higher education expenses as provided in section 25A(g)(2)";
}
pub relation qualified_higher_education_expenses_72t7(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the qualified higher education expenses of the taxpayer for the year: expenses for education of the taxpayer, spouse, child or grandchild (of the taxpayer or the spouse) at an eligible educational institution, reduced as provided in section 25A(g)(2), not below zero";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "The term \"qualified higher education expenses\" means qualified higher education expenses (as defined in section 529(e)(3)) for education furnished to—")
rule QualifiedHigherEducationExpensesDefined(p: Individual, y: TaxableYear, reduction: Money) strict {
    label en official "section 72(t)(7)(A)-(B): the sum of the expenses for the three named recipients at eligible institutions less the 25A(g)(2) reduction (one rounding to cents HALF_UP)";
    when education_expense_reduction_25Ag2_72t7b(p, y, reduction);
    when higher_education_expenses_72t7(p, y, _, _, _);
    then qualified_higher_education_expenses_72t7(p, y, max(0.00 USD, round(sum(collect all a: Money, r: EducationRecipient72t7, e: Boolean where higher_education_expenses_72t7(p, y, r, e, a) and e == true and r != OtherRecipient, empty: 0.00 USD) - reduction, 2, "HALF_UP")));
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "Distributions to an individual from an individual retirement plan to the extent such distributions do not exceed the qualified higher education expenses (as defined in")
rule ExceptionHigherEducation(p: Individual, d: RetirementDistributionEvent, y: TaxableYear, dist: Money, qhee: Money) strict {
    label en official "section 72(t)(2)(E): exempt to the extent the IRA distribution does not exceed the qualified higher education expenses; a distribution already fully excepted by (A), (C) or (D) is not taken into account";
    when retirement_plan_distribution_received(p, d, y, dist);
    when distribution_from_individual_retirement_plan_72t3A(d);
    when not_known(distribution_fully_exempt_72t(d));
    when qualified_higher_education_expenses_72t7(p, y, qhee);
    then distribution_partial_exemption_amount_72t(d, min(dist, qhee));
}

// =====================================================================
// §72(t)(2)(F), (8): qualified first-time homebuyer distributions
// =====================================================================

pub enum HomebuyerRelation72t8 { TheIndividual; SpouseOfIndividual; ChildOrGrandchild; AncestorOfIndividualOrSpouse; OtherOwner; }
relation homebuyer_distribution_received_on_72t8A(p: Individual, d: RetirementDistributionEvent, received_on: Date) kind empirical {
    label en official "the date the payment or distribution is received by the individual";
}
relation homebuyer_distribution_used_for_acquisition_costs_72t8A(p: Individual, d: RetirementDistributionEvent, used_on: Date, costs: Money, owner: HomebuyerRelation72t8) kind empirical {
    label en official "the payment is used on the date to pay qualified acquisition costs of a principal residence of a first-time homebuyer of the given relation to the individual";
}
relation residence_acquisition_or_construction_costs_72t8C(p: Individual, d: RetirementDistributionEvent, cost: Money, closing_costs: Money) kind empirical {
    label en official "the costs of acquiring, constructing or reconstructing a residence, and the usual or reasonable settlement, financing or other closing costs";
}
relation no_present_ownership_interest_2_years_before_acquisition_72t8Di(p: Individual, d: RetirementDistributionEvent) kind empirical {
    label en official "neither the individual nor the individual's spouse (if married) had a present ownership interest in a principal residence during the 2-year period ending on the date of acquisition";
}
relation section_1034_hk_suspension_applies_72t8Dii(p: Individual, d: RetirementDistributionEvent) kind empirical {
    label en official "subsection (h) or (k) of section 1034 (as in effect before its repeal) suspended the running of a period specified in section 1034 for the individual on the day before the distribution is applied";
}
relation date_of_acquisition_72t8Diii(p: Individual, d: RetirementDistributionEvent, acquisition_date: Date) kind empirical {
    label en official "the date on which a binding contract to acquire the principal residence is entered into, or on which construction or reconstruction is commenced";
}
pub relation first_time_homebuyer_72t8D(p: Individual, d: RetirementDistributionEvent) kind institutional {
    label en official "the individual is a first-time homebuyer for the distribution";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "The term \"first-time homebuyer\" means any individual if—")
rule FirstTimeHomebuyerDefined(p: Individual, d: RetirementDistributionEvent) strict {
    label en official "section 72(t)(8)(D)(i)(I)-(II)";
    when no_present_ownership_interest_2_years_before_acquisition_72t8Di(p, d);
    when not_known(section_1034_hk_suspension_applies_72t8Dii(p, d));
    then first_time_homebuyer_72t8D(p, d);
}
pub relation qualified_acquisition_costs_72t8C(p: Individual, d: RetirementDistributionEvent, amount: Money) kind institutional {
    label en official "qualified acquisition costs: the costs of acquiring, constructing or reconstructing a residence, including usual or reasonable settlement, financing or other closing costs";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the term \"qualified acquisition costs\" means the costs of acquiring, constructing, or reconstructing a residence. Such term includes any")
rule QualifiedAcquisitionCostsDefined(p: Individual, d: RetirementDistributionEvent, cost: Money, closing: Money) strict {
    label en official "section 72(t)(8)(C)";
    when residence_acquisition_or_construction_costs_72t8C(p, d, cost, closing);
    then qualified_acquisition_costs_72t8C(p, d, round(cost + closing, 2, "HALF_UP"));
}
relation aggregate_prior_year_homebuyer_distributions_72t8B(p: Individual, amount: Money) kind empirical {
    label en official "the aggregate amounts treated as qualified first-time homebuyer distributions with respect to the individual for all prior taxable years";
}
pub relation homebuyer_distribution_limit_remaining_72t8B(p: Individual, amount: Money) kind institutional {
    label en official "the amount that may still be treated as qualified first-time homebuyer distributions: $10,000 less the aggregate for all prior taxable years, not below zero";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "The aggregate amount of payments or distributions received by an individual which may be treated as qualified first-time homebuyer distributions for any taxable year")
rule HomebuyerDistributionLimitRemaining(p: Individual, prior: Money) strict {
    label en official "section 72(t)(8)(B)(i)-(ii); the amount is a lifetime limit";
    when aggregate_prior_year_homebuyer_distributions_72t8B(p, prior);
    then homebuyer_distribution_limit_remaining_72t8B(p, max(0.00 USD, round(10000.00 USD - prior, 2, "HALF_UP")));
}
pub relation qualified_first_time_homebuyer_distribution_72t8A(p: Individual, d: RetirementDistributionEvent, amount: Money) kind institutional {
    label en official "the part of the distribution that is a qualified first-time homebuyer distribution: used before the close of the 120th day after receipt to pay qualified acquisition costs of a principal residence of a first-time homebuyer who is the individual, the spouse, or a child, grandchild or ancestor of the individual or the spouse";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "The term \"qualified first-time homebuyer distribution\" means any payment or distribution received by an individual to the extent such payment or distribution is used by")
rule QualifiedFirstTimeHomebuyerDistribution(p: Individual, d: RetirementDistributionEvent, y: TaxableYear, dist: Money, received: Date, used_on: Date, costs: Money, owner: HomebuyerRelation72t8) strict {
    label en official "section 72(t)(8)(A): the lesser of the distribution and the costs paid within 120 days; the owner must be one of the four related classes";
    when retirement_plan_distribution_received(p, d, y, dist);
    when homebuyer_distribution_received_on_72t8A(p, d, received);
    when homebuyer_distribution_used_for_acquisition_costs_72t8A(p, d, used_on, costs, owner);
    when owner != OtherOwner;
    when used_on <= add_calendar_period(received, 120 calendar_day);
    when first_time_homebuyer_72t8D(p, d);
    then qualified_first_time_homebuyer_distribution_72t8A(p, d, min(dist, costs));
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "Distributions to an individual from an individual retirement plan which are qualified first-time homebuyer distributions (as defined in paragraph (8)). Distributions")
rule ExceptionFirstTimeHomebuyer(p: Individual, d: RetirementDistributionEvent, qualified: Money, remaining: Money) strict {
    label en official "section 72(t)(2)(F) with (8)(B): exempt up to the qualified amount, not above the remaining $10,000; distributions of (A), (C), (D), (E) are not taken into account";
    when qualified_first_time_homebuyer_distribution_72t8A(p, d, qualified);
    when homebuyer_distribution_limit_remaining_72t8B(p, remaining);
    when distribution_from_individual_retirement_plan_72t3A(d);
    when not_known(distribution_fully_exempt_72t(d));
    then distribution_partial_exemption_amount_72t(d, min(qualified, remaining));
}
relation homebuyer_delay_recontribution_to_ira_72t8E(p: Individual, d: RetirementDistributionEvent, contributed_on: Date, amount: Money) kind empirical {
    label en official "the amount of an IRA distribution that fails subparagraph (A) solely by reason of a delay or cancellation of the purchase or construction is contributed back to an individual retirement plan";
}
pub relation delayed_purchase_recontribution_is_rollover_72t8E(p: Individual, d: RetirementDistributionEvent, amount: Money) kind institutional {
    label en official "the recontribution within 120 days (in place of the 60 days of section 408(d)(3)(A)(i)) is a rollover contribution; section 408(d)(3)(B) is not applied to it and the amount is not taken into account for another amount";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "If any distribution from any individual retirement plan fails to meet the requirements of subparagraph (A) solely by reason of a delay or cancellation of the purchase or")
rule DelayedPurchaseRecontributionIsRollover(p: Individual, d: RetirementDistributionEvent, received: Date, on: Date, amount: Money) strict {
    label en official "section 72(t)(8)(E)(i)-(ii): the contribution is made no later than the 120th day after receipt";
    when homebuyer_distribution_received_on_72t8A(p, d, received);
    when homebuyer_delay_recontribution_to_ira_72t8E(p, d, on, amount);
    when on <= add_calendar_period(received, 120 calendar_day);
    then delayed_purchase_recontribution_is_rollover_72t8E(p, d, amount);
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "(i) section 408(d)(3)(B) shall not be applied to such contribution, and")
rule DelayedRecontributionNotSubjectTo408d3BOneYearRule(p: Individual, d: RetirementDistributionEvent, amount: Money) strict {
    label en official "section 72(t)(8)(E)(i)-(ii): the recontribution is outside the one-rollover-per-year limit of section 408(d)(3)(B)";
    when delayed_purchase_recontribution_is_rollover_72t8E(p, d, amount);
    then rollover_outside_408d3B_limit_72t8E(p, d);
}
pub relation rollover_outside_408d3B_limit_72t8E(p: Individual, d: RetirementDistributionEvent) kind institutional {
    label en official "the recontribution is not counted for the section 408(d)(3)(B) limit for this or any other amount";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "(ii) such amount shall not be taken into account in determining whether section 408(d)(3)(B) applies to any other amount.")
rule DelayedRecontributionNotCountedForOtherAmounts(p: Individual, d: RetirementDistributionEvent, amount: Money) strict {
    label en official "section 72(t)(8)(E)(ii)";
    when delayed_purchase_recontribution_is_rollover_72t8E(p, d, amount);
    then rollover_outside_408d3B_limit_72t8E(p, d);
}
relation homebuyer_disaster_recontribution_72t8F(p: Individual, d: RetirementDistributionEvent, disaster: QualifiedDisaster72p6, contributed_on: Date, amount: Money) kind empirical {
    label en official "recontribution of a distribution that was to be used to purchase or construct a principal residence in a qualified disaster area but was not so used on account of the disaster";
}
relation homebuyer_distribution_was_to_purchase_in_disaster_area_72t8Fii(p: Individual, d: RetirementDistributionEvent, disaster: QualifiedDisaster72p6) kind empirical {
    label en official "the distribution was to be used to purchase or construct a principal residence in the qualified disaster area but was not so used on account of the disaster";
}
pub relation disaster_homebuyer_recontribution_permitted_72t8F(p: Individual, d: RetirementDistributionEvent, disaster: QualifiedDisaster72p6, amount: Money) kind institutional {
    label en official "the recontribution is made during the applicable period (from the first day of the incident period to 180 days after the applicable date), not above the qualified distribution, and the distribution was received from 180 days before the incident period to 30 days after its last day";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "(I) which is a qualified first-time homebuyer distribution,")
rule DisasterHomebuyerRecontributionPermitted(p: Individual, d: RetirementDistributionEvent, disaster: QualifiedDisaster72p6, on: Date, amount: Money, dist: Money, y: TaxableYear, received: Date, first_day: Date, last_day: Date, applicable: Date, calendar_before_1: Date) strict {
    label en official "section 72(t)(8)(F)(i)-(iii): qualified distribution of clause (ii) and the applicable period of clause (iii)";
    when homebuyer_disaster_recontribution_72t8F(p, d, disaster, on, amount);
    when homebuyer_distribution_was_to_purchase_in_disaster_area_72t8Fii(p, d, disaster);
    when retirement_plan_distribution_received(p, d, y, dist);
    when homebuyer_distribution_received_on_72t8A(p, d, received);
    when incident_period_72t11Fii(disaster, first_day, last_day);
    when applicable_date_72t11Fiii(disaster, applicable);
    when amount <= dist;
    when received >= calendar_before_1;
    when received <= add_calendar_period(last_day, 30 calendar_day);
    when on >= first_day;
    when on <= add_calendar_period(applicable, 180 calendar_day)
        and us.irc.core::civil_calendar_boundary_before(first_day, 180, us.irc.core::CalendarDay, calendar_before_1);
    then disaster_homebuyer_recontribution_permitted_72t8F(p, d, disaster, amount);
}

// =====================================================================
// §72(t)(2)(G)(ii)-(iv): qualified reservist distributions may be repaid
// =====================================================================

relation reservist_active_duty_period_end_72t2G(p: Individual, end: Date) kind empirical {
    label en official "the last day of the active duty period";
}
relation reservist_distribution_amount_72t2G(p: Individual, d: RetirementDistributionEvent, amount: Money) kind empirical {
    label en official "the amount of the qualified reservist distribution";
}
relation reservist_ira_contribution_72t2G(p: Individual, d: RetirementDistributionEvent, contributed_on: Date, amount: Money) kind empirical {
    label en official "a contribution to an individual retirement plan of the individual made by reason of the qualified reservist distribution";
}
relation contributes_reservist_repayment_72t2G(p: Individual, d: RetirementDistributionEvent) kind empirical {
    label en official "the individual makes a contribution under subparagraph (G)(ii) (the exercise of the option)";
}
pub relation reservist_repayment_conditions_met_72t2G(p: Individual, d: RetirementDistributionEvent) kind institutional {
    label en official "the contribution is made during the 2-year period beginning on the day after the end of the active duty period and does not exceed the distribution";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "Any individual who receives a qualified reservist distribution may, at any time during the 2-year period beginning on the day after the end of the active duty period,")
rule ReservistRepaymentConditions(p: Individual, d: RetirementDistributionEvent, end: Date, on: Date, amount: Money, dist: Money) strict {
    label en official "section 72(t)(2)(G)(ii): first day the day after the end of the active duty period; the two-year period is not treated as ending before two years after the enactment of the subparagraph (clause (iv))";
    when reservist_active_duty_period_end_72t2G(p, end);
    when reservist_ira_contribution_72t2G(p, d, on, amount);
    when reservist_distribution_amount_72t2G(p, d, dist);
    when on > end;
    when on <= add_calendar_period(end, 2 calendar_year);
    when amount <= dist;
    then reservist_repayment_conditions_met_72t2G(p, d);
}
pub relation reservist_contribution_limit_waived_72t2G(p: Individual, d: RetirementDistributionEvent) kind institutional {
    label en official "the dollar limitations otherwise applicable to contributions to individual retirement plans do not apply to the repayment contribution";
}
@source(IRC_S72_T, relation = formalizes, coverage = partial, quote = "Any individual who receives a qualified reservist distribution may, at any time during the 2-year period beginning on the day after the end of the active duty period")
rule Section72t2GRepaymentRule defeasible {
    for p: Individual;
    for d: RetirementDistributionEvent;
    when reservist_repayment_conditions_met_72t2G(p, d);
    then power Section72t2GReservistRepayment {
        holder p;
        over d;
        exercise contributes_reservist_repayment_72t2G(p, d);
        valid_when reservist_repayment_conditions_met_72t2G(p, d);
        effect create(reservist_contribution_limit_waived_72t2G(p, d));
        window [-infinity, infinity];
    };
}
pub relation reservist_contribution_not_deductible_72t2G(p: Individual, d: RetirementDistributionEvent) kind institutional {
    label en official "no deduction is allowed for the repayment contribution";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "Any individual who receives a qualified reservist distribution may, at any time during the 2-year period beginning on the day after the end of the active duty period,")
rule ReservistContributionNotDeductible(p: Individual, d: RetirementDistributionEvent) strict {
    label en official "section 72(t)(2)(G)(ii), last sentence";
    when reservist_contribution_limit_waived_72t2G(p, d);
    then reservist_contribution_not_deductible_72t2G(p, d);
}
relation active_duty_ordered_after_20010911_72t2Giv(p: Individual, order_date: Date) kind empirical {
    label en official "the individual was ordered or called to active duty after September 11, 2001";
}
pub relation reservist_provision_applies_72t2Giv(p: Individual) kind institutional {
    label en official "subparagraph (G) applies to the individual: ordered or called to active duty after September 11, 2001";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "This subparagraph applies to individuals ordered or called to active duty after September 11, 2001. In no event shall the 2-year period referred to in clause (ii) end")
rule ReservistProvisionApplies(p: Individual, order_date: Date) strict {
    label en official "section 72(t)(2)(G)(iv), first sentence";
    when active_duty_ordered_after_20010911_72t2Giv(p, order_date);
    when order_date > @2001-09-11;
    then reservist_provision_applies_72t2Giv(p);
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "For purposes of this subparagraph, the term \"qualified reservist distribution\" means any distribution to an individual if—")
rule QualifiedReservistDistributionDefined(p: Individual, d: RetirementDistributionEvent, order_date: Date, dist_on: Date, end: Date) strict {
    label en official "section 72(t)(2)(G)(iii): a distribution from an IRA or from elective-deferral amounts, to a reserve component member ordered to active duty for more than 179 days or indefinitely, made from the date of the order to the end of the active duty period";
    when qualified_reservist_distribution_facts_72t2G(p, d);
    when reservist_order_or_call_date_72t2G(p, order_date);
    when distribution_date(d, dist_on);
    when reservist_active_duty_period_end_72t2G(p, end);
    when dist_on >= order_date;
    when dist_on <= end;
    then qualified_reservist_distribution_derived_72t2G(d);
}
relation qualified_reservist_distribution_facts_72t2G(p: Individual, d: RetirementDistributionEvent) kind empirical {
    label en official "the distribution is from an individual retirement plan or from amounts attributable to elective deferrals described in section 402(g)(3)(A) or (C) or 501(c)(18)(D)(iii), and the individual was, as a member of a reserve component, ordered or called to active duty for a period in excess of 179 days or for an indefinite period";
}
relation reservist_order_or_call_date_72t2G(p: Individual, order_date: Date) kind empirical {
    label en official "the date of the order or call to active duty";
}
pub relation qualified_reservist_distribution_derived_72t2G(d: RetirementDistributionEvent) kind institutional {
    label en official "a qualified reservist distribution derived from the elements of subparagraph (G)(iii)";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "For purposes of this subparagraph, the term \"qualified reservist distribution\" means any distribution to an individual if—")
rule ExceptionReservistDerived(d: RetirementDistributionEvent) strict {
    label en official "section 72(t)(2)(G)(i)";
    when qualified_reservist_distribution_derived_72t2G(d);
    then distribution_fully_exempt_72t(d);
}

// =====================================================================
// Shared machinery of (H)-(L) and (11): plan treatment and repayment
// =====================================================================

pub enum SpecialDistributionKind72t { QualifiedBirthOrAdoption; EmergencyPersonalExpense; DomesticAbuseVictim; TerminallyIll; QualifiedDisasterRecovery; }
pub enum RetirementPlanClass72t { IndividualRetirementPlan; OtherEligibleRetirementPlan; }
relation special_distribution_72t(p: Individual, d: RetirementDistributionEvent, kind: SpecialDistributionKind72t, group: Person, received_on: Date, amount: Money) kind empirical {
    label en official "a distribution that would be a qualified birth or adoption, emergency personal expense, domestic abuse, terminal illness or disaster recovery distribution, with the employer group (the employer and its controlled group determined under section 414(b), (c), (m) or (o)) maintaining the plan";
}
relation employer_controlled_group_414_72t(employer: Person, group: Person) kind empirical {
    label en official "the employer belongs to the group treated as a single employer under section 414(b), (c), (m) or (o) (section 72(t)(2)(H)(iv)(II)); the group is identified by a representative person";
}
pub relation controlled_group_of_employer_72t2H4II(employer: Person, group: Person) kind institutional {
    label en official "the controlled group which includes the employer";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "For purposes of subclause (I), the term \"controlled group\" means any group treated as a single employer under subsection (b), (c), (m), or (o) of section 414.")
rule ControlledGroupDefined(employer: Person, group: Person) strict {
    label en official "section 72(t)(2)(H)(iv)(II), also used by (I)(v), (K)(iv) and (11)(B)(iii)";
    when employer_controlled_group_414_72t(employer, group);
    then controlled_group_of_employer_72t2H4II(employer, group);
}
relation qbad_distribution_of_group_72t2H4(p: Individual, group: Person, amount: Money, d: RetirementDistributionEvent) kind empirical {
    label en official "an amount of qualified birth or adoption distributions to the individual from plans maintained by the group";
}
pub relation plan_treatment_of_qbad_permitted_72t2H4(p: Individual, group: Person) kind institutional {
    label en official "a plan is not treated as failing any requirement merely because it treats the distribution as a qualified birth or adoption distribution: the aggregate from all plans of the employer and its controlled group to the individual does not exceed $5,000";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "If a distribution to an individual would (without regard to clause (ii)) be a qualified birth or adoption distribution, a plan shall not be treated as failing to meet")
rule PlanTreatmentOfQbadPermitted(p: Individual, group: Person, d0: RetirementDistributionEvent, a0: Money) strict {
    label en official "section 72(t)(2)(H)(iv)(I): aggregate not above $5,000, exact";
    when qbad_distribution_of_group_72t2H4(p, group, a0, d0);
    when sum(collect all a: Money, dd: RetirementDistributionEvent where qbad_distribution_of_group_72t2H4(p, group, a, dd), empty: 0.00 USD) <= 5000.00 USD;
    then plan_treatment_of_qbad_permitted_72t2H4(p, group);
}
relation eped_distribution_of_group_72t2I5(p: Individual, group: Person, calendar_year: Integer, amount: Money, d: RetirementDistributionEvent) kind empirical {
    label en official "an emergency personal expense distribution to the individual from plans maintained by the group in the calendar year";
}
relation total_nonforfeitable_accrued_benefit_72t2Iiii(p: Individual, benefit: Money) kind empirical {
    label en official "the individual's total nonforfeitable accrued benefit under the plan (the total interest in an individual retirement plan), determined as of the date of each distribution";
}
pub relation eped_annual_limit_exceeded_72t2Iii(p: Individual, calendar_year: Integer) kind institutional {
    label en official "more than 1 distribution in the calendar year is claimed to be an emergency personal expense distribution";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "Not more than 1 distribution per calendar year may be treated as an emergency personal expense distribution by any individual.")
rule EpedAnnualLimitExceeded(p: Individual, group: Person, cy: Integer, a0: Money, d0: RetirementDistributionEvent) strict {
    label en official "section 72(t)(2)(I)(ii): not more than 1 distribution per calendar year";
    when eped_distribution_of_group_72t2I5(p, group, cy, a0, d0);
    when count(collect dd: RetirementDistributionEvent where eped_distribution_of_group_72t2I5(p, group, cy, _, dd)) > 1;
    then eped_annual_limit_exceeded_72t2Iii(p, cy);
}
pub relation plan_treatment_of_eped_permitted_72t2I5(p: Individual, group: Person, calendar_year: Integer) kind institutional {
    label en official "a plan is not treated as failing a requirement merely because it treats the distribution as an emergency personal expense distribution: not more than one distribution in the year and the aggregate not above the lesser of $1,000 and the accrued benefit less $1,000";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "If a distribution to an individual would (without regard to clause (ii) or (iii)) be an emergency personal expense distribution, a plan shall not be treated as failing")
rule PlanTreatmentOfEpedPermitted(p: Individual, group: Person, cy: Integer, a0: Money, d0: RetirementDistributionEvent, benefit: Money) strict {
    label en official "section 72(t)(2)(I)(iii), (v): aggregate <= min($1,000, benefit - $1,000) and a single distribution";
    when eped_distribution_of_group_72t2I5(p, group, cy, a0, d0);
    when total_nonforfeitable_accrued_benefit_72t2Iiii(p, benefit);
    when not_known(eped_annual_limit_exceeded_72t2Iii(p, cy));
    when sum(collect all a: Money, dd: RetirementDistributionEvent where eped_distribution_of_group_72t2I5(p, group, cy, _, dd) and eped_distribution_of_group_72t2I5(p, group, cy, a, dd), empty: 0.00 USD) <= 1000.00 USD;
    when sum(collect all a2: Money, dd2: RetirementDistributionEvent where eped_distribution_of_group_72t2I5(p, group, cy, a2, dd2), empty: 0.00 USD) <= benefit - 1000.00 USD;
    then plan_treatment_of_eped_permitted_72t2I5(p, group, cy);
}
relation eped_certification_by_employee_72t2Iiv(p: Individual, d: RetirementDistributionEvent) kind empirical {
    label en official "the employee has certified in writing that the distribution is for unforeseeable or immediate financial needs relating to necessary personal or family emergency expenses";
}
relation administrator_has_actual_knowledge_to_the_contrary_72t2Iiv(d: RetirementDistributionEvent) kind empirical {
    label en official "the plan administrator has actual knowledge contrary to the certification (the Secretary may provide exceptions by regulations)";
}
pub relation administrator_may_rely_on_eped_certification_72t2Iiv(d: RetirementDistributionEvent) kind institutional {
    label en official "the administrator of an applicable eligible retirement plan may rely on the employee's written certification in determining whether a distribution is an emergency personal expense distribution";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "For purposes of this subparagraph, the term \"emergency personal expense distribution\" means any distribution from an applicable eligible retirement plan (as defined in")
rule AdministratorMayRelyOnEpedCertification(p: Individual, d: RetirementDistributionEvent) strict {
    label en official "section 72(t)(2)(I)(iv), second sentence; the third sentence (regulatory exceptions for actual knowledge) is an EXTERNAL_DEPENDENCY, the fact of actual knowledge blocks the reliance here only as a conservative reading";
    when eped_certification_by_employee_72t2Iiv(p, d);
    when not_known(administrator_has_actual_knowledge_to_the_contrary_72t2Iiv(d));
    then administrator_may_rely_on_eped_certification_72t2Iiv(d);
}
relation eped_treated_in_calendar_year_with_plan_72t2Ivii(p: Individual, plan: RetirementArrangement, calendar_year: Integer) kind empirical {
    label en official "a distribution is treated as an emergency personal expense distribution in the calendar year with respect to a plan of the employee";
}
relation eped_fully_repaid_to_plan_72t2Ivii1(p: Individual, plan: RetirementArrangement, calendar_year: Integer) kind empirical {
    label en official "the previous distribution is fully repaid to the plan pursuant to clause (vi)";
}
relation contributions_since_eped_and_unrepaid_72t2Ivii2(p: Individual, plan: RetirementArrangement, calendar_year: Integer, contributions: Money, unrepaid: Money) kind empirical {
    label en official "the elective deferrals and employee contributions to the plan (the total contributed in the case of an IRA) since the previous distribution, and the amount of that distribution not repaid";
}
pub relation eped_barred_in_year_72t2Ivii(p: Individual, plan: RetirementArrangement, calendar_year: Integer) kind institutional {
    label en official "no amount may be treated as an emergency personal expense distribution with respect to the plan in the calendar year: an earlier one was treated in one of the 3 preceding calendar years and neither repayment nor contribution condition is met";
}
pub relation eped_repayment_or_contribution_condition_met_72t2Ivii(p: Individual, plan: RetirementArrangement, calendar_year: Integer) kind institutional {
    label en official "helper: the previous distribution was fully repaid or the contributions since are at least the unrepaid amount";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "(I) such previous distribution is fully repaid to such plan pursuant to clause (vi), or")
rule EpedConditionMetByFullRepayment(p: Individual, plan: RetirementArrangement, cy: Integer) strict {
    label en official "section 72(t)(2)(I)(vii)(I)";
    when eped_fully_repaid_to_plan_72t2Ivii1(p, plan, cy);
    then eped_repayment_or_contribution_condition_met_72t2Ivii(p, plan, cy);
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "(II) the aggregate of the elective deferrals and employee contributions to the plan (the total amounts contributed to the plan in the case of an individual retirement")
rule EpedConditionMetByContributions(p: Individual, plan: RetirementArrangement, cy: Integer, contributions: Money, unrepaid: Money) strict {
    label en official "section 72(t)(2)(I)(vii)(II): contributions since are at least the unrepaid amount";
    when contributions_since_eped_and_unrepaid_72t2Ivii2(p, plan, cy, contributions, unrepaid);
    when contributions >= unrepaid;
    then eped_repayment_or_contribution_condition_met_72t2Ivii(p, plan, cy);
}
relation eped_claimed_in_year_72t2Ivii(p: Individual, plan: RetirementArrangement, calendar_year: Integer) kind empirical {
    label en official "a distribution is claimed as an emergency personal expense distribution with respect to the plan in the calendar year";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "If a distribution is treated as an emergency personal expense distribution in any calendar year with respect to a plan of the employee, no amount may be treated as such")
rule EpedBarredWithinThreeYears(p: Individual, plan: RetirementArrangement, cy: Integer, earlier: Integer) strict {
    label en official "section 72(t)(2)(I)(vii): a new one is barred in the 3 calendar years following the calendar year of the earlier one";
    when eped_claimed_in_year_72t2Ivii(p, plan, cy);
    when eped_treated_in_calendar_year_with_plan_72t2Ivii(p, plan, earlier);
    when earlier < cy;
    when cy <= earlier + 3;
    when not_known(eped_repayment_or_contribution_condition_met_72t2Ivii(p, plan, earlier));
    then eped_barred_in_year_72t2Ivii(p, plan, cy);
}
// G6404 wiring, §72(t)(2)(I)(vii): a distribution in a barred calendar year with respect to a plan of the
// employer group is not an emergency personal expense distribution; the plan is linked to the group of
// `eped_distribution_of_group_72t2I5` by `plan_maintained_by_employer_group_72p2e`.
relation eped_barred_for_distribution_72t2Ivii(d: RetirementDistributionEvent) kind institutional {
    label en official "the distribution is claimed as an emergency personal expense distribution in a calendar year barred under section 72(t)(2)(I)(vii)";
}
rule EpedBarredForDistribution(d: RetirementDistributionEvent, p: Individual, group: Person, cy: Integer, plan: RetirementArrangement) strict {
    label en official "section 72(t)(2)(I)(vii): the claimed distribution falls in a barred year of a plan of the employer group";
    when eped_distribution_of_group_72t2I5(p, group, cy, _, d);
    when plan_maintained_by_employer_group_72p2e(plan, group);
    when eped_barred_in_year_72t2Ivii(p, plan, cy);
    then eped_barred_for_distribution_72t2Ivii(d);
}
pub relation distribution_from_pension_linked_emergency_savings_account_72t2J(d: RetirementDistributionEvent) kind empirical {
    label en official "the distribution is from a pension-linked emergency savings account pursuant to section 402A(e)";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "Distributions from a pension-linked emergency savings account pursuant to section 402A(e).")
rule ExceptionPensionLinkedEmergencySavings(d: RetirementDistributionEvent) strict {
    label en official "section 72(t)(2)(J)";
    when distribution_from_pension_linked_emergency_savings_account_72t2J(d);
    then distribution_fully_exempt_72t(d);
}

relation dabuse_distribution_of_group_72t2K4(p: Individual, group: Person, amount: Money, d: RetirementDistributionEvent) kind empirical {
    label en official "an eligible distribution to a domestic abuse victim from plans maintained by the group";
}
relation dabuse_present_value_of_accrued_benefit_72t2K4(p: Individual, pv: Money) kind empirical {
    label en official "the present value of the nonforfeitable accrued benefit of the employee under the plan";
}
pub relation plan_treatment_of_dabuse_permitted_72t2K4(p: Individual, group: Person) kind institutional {
    label en official "a plan is not treated as failing a requirement merely because it treats the distribution as an eligible distribution to a domestic abuse victim: the aggregate does not exceed the lesser of $10,000 and 50 percent of the present value of the nonforfeitable accrued benefit";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "If a distribution to an individual would (without regard to clause (ii)) be an eligible distribution to a domestic abuse victim, a plan shall not be treated as failing")
rule PlanTreatmentOfDabusePermitted(p: Individual, group: Person, a0: Money, d0: RetirementDistributionEvent, pv: Money) strict {
    label en official "section 72(t)(2)(K)(ii), (iv): sum <= 10,000 and sum x 2 <= pv (the inflation adjustment of clause (vii) after 2024 is not pinned: SOURCE_GAP)";
    when dabuse_distribution_of_group_72t2K4(p, group, a0, d0);
    when dabuse_present_value_of_accrued_benefit_72t2K4(p, pv);
    when sum(collect all a: Money, dd: RetirementDistributionEvent where dabuse_distribution_of_group_72t2K4(p, group, a, dd), empty: 0.00 USD) <= 10000.00 USD;
    when sum(collect all a2: Money, dd2: RetirementDistributionEvent where dabuse_distribution_of_group_72t2K4(p, group, a2, dd2), empty: 0.00 USD) * 2 <= pv;
    then plan_treatment_of_dabuse_permitted_72t2K4(p, group);
}
relation individual_is_victim_of_domestic_abuse_by_spouse_or_partner_72t2Kiii(p: Individual, victim_from: Date) kind empirical {
    label en official "the individual is a victim of domestic abuse (physical, psychological, sexual, emotional or economic abuse, including efforts to control, isolate, humiliate or intimidate) by a spouse or domestic partner, on a date within the year before the distribution";
}
relation dabuse_distribution_from_applicable_plan_72t2Kiii(d: RetirementDistributionEvent) kind empirical {
    label en official "the distribution is from an applicable eligible retirement plan (an eligible retirement plan other than a defined benefit plan or a plan to which sections 401(a)(11) and 417 apply)";
}
pub relation eligible_distribution_to_domestic_abuse_victim_72t2Kiii(p: Individual, d: RetirementDistributionEvent) kind institutional {
    label en official "an eligible distribution to a domestic abuse victim: from an applicable eligible retirement plan, made during the 1-year period beginning on any date on which the individual is a victim";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "For purposes of this subparagraph:")
rule EligibleDistributionToDomesticAbuseVictim(p: Individual, d: RetirementDistributionEvent, on: Date, victim_from: Date) strict {
    label en official "section 72(t)(2)(K)(iii)(I) with (vi)(I)";
    when dabuse_distribution_from_applicable_plan_72t2Kiii(d);
    when individual_is_victim_of_domestic_abuse_by_spouse_or_partner_72t2Kiii(p, victim_from);
    when distribution_date(d, on);
    when on >= victim_from;
    when on < add_calendar_period(victim_from, 1 calendar_year);
    then eligible_distribution_to_domestic_abuse_victim_72t2Kiii(p, d);
}
relation plan_kind_flags_72t(plan_class: Person, is_eligible_plan: Boolean, is_defined_benefit: Boolean, subject_to_401a11_and_417: Boolean) kind empirical {
    label en official "the plan (represented by a Person record) is an eligible retirement plan within section 402(c)(8)(B), is a defined benefit plan, and is a plan to which sections 401(a)(11) and 417 apply";
}
pub relation applicable_eligible_retirement_plan_72t2Hvi(plan_class: Person) kind institutional {
    label en official "an applicable eligible retirement plan for birth or adoption and emergency distributions: an eligible retirement plan other than a defined benefit plan";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "The term \"applicable eligible retirement plan\" means an eligible retirement plan (as defined in section 402(c)(8)(B)) other than a defined benefit plan.")
rule ApplicableEligibleRetirementPlanHvi(plan_class: Person) strict {
    label en official "section 72(t)(2)(H)(vi)(I)";
    when plan_kind_flags_72t(plan_class, true, false, _);
    then applicable_eligible_retirement_plan_72t2Hvi(plan_class);
}
pub relation applicable_eligible_retirement_plan_72t2Kvi(plan_class: Person) kind institutional {
    label en official "an applicable eligible retirement plan for domestic abuse distributions: an eligible retirement plan other than a defined benefit plan or a plan to which sections 401(a)(11) and 417 apply";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "The term \"applicable eligible retirement plan\" means an eligible retirement plan (as defined in section 402(c)(8)(B)) other than a defined benefit plan or a plan to")
rule ApplicableEligibleRetirementPlanKvi(plan_class: Person) strict {
    label en official "section 72(t)(2)(K)(vi)(I)";
    when plan_kind_flags_72t(plan_class, true, false, false);
    then applicable_eligible_retirement_plan_72t2Kvi(plan_class);
}
pub relation special_distribution_not_an_eligible_rollover_distribution_72t(d: RetirementDistributionEvent) kind institutional {
    label en official "for purposes of sections 401(a)(31), 402(f) and 3405 the distribution is not treated as an eligible rollover distribution";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "For purposes of sections 401(a)(31), 402(f), and 3405, a qualified birth or adoption distribution shall not be treated as an eligible rollover distribution.")
rule QbadNotEligibleRolloverDistribution(p: Individual, d: RetirementDistributionEvent, group: Person, on: Date, amount: Money) strict {
    label en official "section 72(t)(2)(H)(vi)(II)";
    when special_distribution_72t(p, d, QualifiedBirthOrAdoption, group, on, amount);
    then special_distribution_not_an_eligible_rollover_distribution_72t(d);
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "Rules similar to the rules of subclauses (II) and (IV) of subparagraph (H)(vi) shall apply to any emergency personal expense distribution.")
rule EpedNotEligibleRolloverDistribution(p: Individual, d: RetirementDistributionEvent, group: Person, on: Date, amount: Money) strict {
    label en official "section 72(t)(2)(I)(viii), by reference to (H)(vi)(II)";
    when special_distribution_72t(p, d, EmergencyPersonalExpense, group, on, amount);
    then special_distribution_not_an_eligible_rollover_distribution_72t(d);
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "For purposes of sections 401(a)(31), 402(f), and 3405, an eligible distribution to a domestic abuse victim shall not be treated as an eligible rollover distribution.")
rule DabuseNotEligibleRolloverDistribution(p: Individual, d: RetirementDistributionEvent, group: Person, on: Date, amount: Money) strict {
    label en official "section 72(t)(2)(K)(vi)(II)";
    when special_distribution_72t(p, d, DomesticAbuseVictim, group, on, amount);
    then special_distribution_not_an_eligible_rollover_distribution_72t(d);
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "For purposes of sections 401(a)(31), 402(f), and 3405, qualified disaster recovery distributions shall not be treated as eligible rollover distributions.")
rule QdrdNotEligibleRolloverDistribution(p: Individual, d: RetirementDistributionEvent, group: Person, on: Date, amount: Money) strict {
    label en official "section 72(t)(11)(G)(i)";
    when special_distribution_72t(p, d, QualifiedDisasterRecovery, group, on, amount);
    then special_distribution_not_an_eligible_rollover_distribution_72t(d);
}
pub relation special_distribution_meets_plan_distribution_requirements_72t(d: RetirementDistributionEvent) kind institutional {
    label en official "the distribution is treated as meeting the requirements of sections 401(k)(2)(B)(i), 403(b)(7)(A)(i), 403(b)(11) and 457(d)(1)(A)";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "Any qualified birth or adoption distribution shall be treated as meeting the requirements of sections 401(k)(2)(B)(i), 403(b)(7)(A)(i), 403(b)(11), and 457(d)(1)(A).")
rule QbadMeetsPlanDistributionRequirements(p: Individual, d: RetirementDistributionEvent, group: Person, on: Date, amount: Money) strict {
    label en official "section 72(t)(2)(H)(vi)(IV)";
    when special_distribution_72t(p, d, QualifiedBirthOrAdoption, group, on, amount);
    then special_distribution_meets_plan_distribution_requirements_72t(d);
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "Rules similar to the rules of subclauses (II) and (IV) of subparagraph (H)(vi) shall apply to any emergency personal expense distribution.")
rule EpedMeetsPlanDistributionRequirements(p: Individual, d: RetirementDistributionEvent, group: Person, on: Date, amount: Money) strict {
    label en official "section 72(t)(2)(I)(viii), by reference to (H)(vi)(IV)";
    when special_distribution_72t(p, d, EmergencyPersonalExpense, group, on, amount);
    then special_distribution_meets_plan_distribution_requirements_72t(d);
}
relation employee_certifies_domestic_abuse_distribution_72t2Kvi(d: RetirementDistributionEvent) kind empirical {
    label en official "the employee or participant certifies the distribution as an eligible distribution to a domestic abuse victim";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "Any distribution which the employee or participant certifies as being an eligible distribution to a domestic abuse victim shall be treated as meeting the requirements of")
rule DabuseCertifiedMeetsPlanDistributionRequirements(d: RetirementDistributionEvent) strict {
    label en official "section 72(t)(2)(K)(vi)(III): self-certification";
    when employee_certifies_domestic_abuse_distribution_72t2Kvi(d);
    then special_distribution_meets_plan_distribution_requirements_72t(d);
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "(I) a qualified disaster recovery distribution shall be treated as meeting the requirements of sections 401(k)(2)(B)(i), 403(b)(7)(A)(i), 403(b)(11), and 457(d)(1)(A),")
rule QdrdMeetsPlanDistributionRequirements(p: Individual, d: RetirementDistributionEvent, group: Person, on: Date, amount: Money) strict {
    label en official "section 72(t)(11)(G)(ii)(I)";
    when special_distribution_72t(p, d, QualifiedDisasterRecovery, group, on, amount);
    then special_distribution_meets_plan_distribution_requirements_72t(d);
}
relation qdrd_in_service_withdrawal_from_money_purchase_plan_72t11Gii(d: RetirementDistributionEvent) kind empirical {
    label en official "the qualified disaster recovery distribution is an in-service withdrawal from a money purchase pension plan";
}
pub relation money_purchase_in_service_withdrawal_meets_401a_72t11Gii(d: RetirementDistributionEvent) kind institutional {
    label en official "the withdrawal is treated as meeting the requirements of section 401(a) applicable to distributions";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "(II) in the case of a money purchase pension plan, a qualified disaster recovery distribution which is an in-service withdrawal shall be treated as meeting the")
rule MoneyPurchaseInServiceWithdrawalMeets401a(p: Individual, d: RetirementDistributionEvent, group: Person, on: Date, amount: Money) strict {
    label en official "section 72(t)(11)(G)(ii)(II)";
    when special_distribution_72t(p, d, QualifiedDisasterRecovery, group, on, amount);
    when qdrd_in_service_withdrawal_from_money_purchase_plan_72t11Gii(d);
    then money_purchase_in_service_withdrawal_meets_401a_72t11Gii(d);
}
relation return_includes_name_age_and_tin_of_child_72t2Hvi(d: RetirementDistributionEvent) kind empirical {
    label en official "the taxpayer includes the name, age and TIN of the child or eligible adoptee on the return of tax for the year";
}
pub relation qbad_recognized_72t2Hvi(d: RetirementDistributionEvent) kind institutional {
    label en official "a distribution is treated as a qualified birth or adoption distribution with respect to a child or eligible adoptee only if the return includes the name, age and TIN";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "A distribution shall not be treated as a qualified birth or adoption distribution with respect to any child or eligible adoptee unless the taxpayer includes the name,")
rule QbadRecognizedWithTin(p: Individual, d: RetirementDistributionEvent, group: Person, on: Date, amount: Money) strict {
    label en official "section 72(t)(2)(H)(vi)(III)";
    when special_distribution_72t(p, d, QualifiedBirthOrAdoption, group, on, amount);
    when return_includes_name_age_and_tin_of_child_72t2Hvi(d);
    then qbad_recognized_72t2Hvi(d);
}

// repayment of (H)(v), (I)(vi), (K)(v), (L)(iv) and (11)(C)
relation contributes_repayment_72t(p: Individual, d: RetirementDistributionEvent) kind empirical {
    label en official "the individual makes the repayment contributions (the exercise of the option)";
}
relation repayment_contribution_72t(p: Individual, d: RetirementDistributionEvent, received_on: Date, contributed_on: Date, amount: Money, plan_class: RetirementPlanClass72t) kind empirical {
    label en official "a contribution repaying the distribution, with the date the distribution was received, the date of the contribution and the class of the receiving plan";
}
relation individual_eligible_to_make_non_rollover_contributions_72t2Hv(p: Individual, d: RetirementDistributionEvent) kind empirical {
    label en official "the individual is eligible to make contributions (other than rollover contributions) to the non-IRA plan";
}
pub relation repayment_conditions_met_72t(p: Individual, d: RetirementDistributionEvent) kind institutional {
    label en official "the repayment is made within the 3-year period beginning on the day after receipt, the aggregate does not exceed the distribution, and for a plan other than an IRA the individual is eligible to make non-rollover contributions and the aggregate does not exceed the distributions from that plan";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "Any individual who receives a qualified birth or adoption distribution may, at any time during the 3-year period beginning on the day after the date on which such")
rule RepaymentConditionsMetForIra(p: Individual, d: RetirementDistributionEvent, k: SpecialDistributionKind72t, group: Person, on: Date, dist: Money, r0: Date, c0: Date, a0: Money) strict {
    label en official "section 72(t)(2)(H)(v)(I): to an IRA, within 3 years after the day of receipt, aggregate not above the distribution";
    when special_distribution_72t(p, d, k, group, on, dist);
    when repayment_contribution_72t(p, d, r0, c0, a0, IndividualRetirementPlan);
    when sum(collect all a: Money, r: Date, c: Date where repayment_contribution_72t(p, d, r, c, a, IndividualRetirementPlan) and c > r and c <= add_calendar_period(r, 3 calendar_year), empty: 0.00 USD) <= dist;
    then repayment_conditions_met_72t(p, d);
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "The aggregate amount of contributions made by an individual under subclause (I) to any applicable eligible retirement plan which is not an individual retirement plan")
rule RepaymentConditionsMetForOtherPlan(p: Individual, d: RetirementDistributionEvent, k: SpecialDistributionKind72t, group: Person, on: Date, dist: Money, r0: Date, c0: Date, a0: Money) strict {
    label en official "section 72(t)(2)(H)(v)(I)-(II): to a plan other than an IRA the aggregate is capped by the distributions from that plan and the individual must be eligible to contribute";
    when special_distribution_72t(p, d, k, group, on, dist);
    when repayment_contribution_72t(p, d, r0, c0, a0, OtherEligibleRetirementPlan);
    when individual_eligible_to_make_non_rollover_contributions_72t2Hv(p, d);
    when sum(collect all a: Money, r: Date, c: Date where repayment_contribution_72t(p, d, r, c, a, OtherEligibleRetirementPlan) and c > r and c <= add_calendar_period(r, 3 calendar_year), empty: 0.00 USD) <= dist;
    then repayment_conditions_met_72t(p, d);
}
pub relation repayment_treated_as_eligible_rollover_and_direct_transfer_72t(p: Individual, d: RetirementDistributionEvent) kind institutional {
    label en official "for a distribution from a plan other than an IRA the taxpayer is treated, to the extent of the contribution, as having received the distribution in an eligible rollover distribution (section 402(c)(4)) and as having transferred the amount in a direct trustee to trustee transfer";
}
pub relation repayment_treated_as_ira_rollover_within_60_days_72t(p: Individual, d: RetirementDistributionEvent) kind institutional {
    label en official "for a distribution from an IRA the distribution is treated, to the extent of the contribution, as a distribution described in section 408(d)(3) transferred in a direct trustee to trustee transfer within 60 days";
}
relation distribution_from_plan_class_72t(d: RetirementDistributionEvent, plan_class: RetirementPlanClass72t) kind empirical {
    label en official "the class of the plan from which the distribution was made";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "If a contribution is made under subclause (I) with respect to a qualified birth or adoption distribution from an applicable eligible retirement plan other than an")
rule Section72tRepaymentRule defeasible {
    for p: Individual;
    for d: RetirementDistributionEvent;
    when repayment_conditions_met_72t(p, d);
    then power Section72tRepaymentPower {
        holder p;
        over d;
        exercise contributes_repayment_72t(p, d);
        valid_when repayment_conditions_met_72t(p, d);
        effect create(repayment_exercised_72t(p, d));
        window [-infinity, infinity];
    };
}
pub relation repayment_exercised_72t(p: Individual, d: RetirementDistributionEvent) kind institutional {
    label en official "the repayment power was validly exercised";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "If a contribution is made under subclause (I) with respect to a qualified birth or adoption distribution from an applicable eligible retirement plan other than an")
rule RepaymentFromOtherPlanTreatedAsRollover(p: Individual, d: RetirementDistributionEvent) strict {
    label en official "section 72(t)(2)(H)(v)(III), and (11)(C)(ii)";
    when repayment_exercised_72t(p, d);
    when distribution_from_plan_class_72t(d, OtherEligibleRetirementPlan);
    then repayment_treated_as_eligible_rollover_and_direct_transfer_72t(p, d);
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "If a contribution is made under subclause (I) with respect to a qualified birth or adoption distribution from an individual retirement plan, then, to the extent of the")
rule RepaymentFromIraTreatedAsRollover(p: Individual, d: RetirementDistributionEvent) strict {
    label en official "section 72(t)(2)(H)(v)(IV), and (11)(C)(iii)";
    when repayment_exercised_72t(p, d);
    when distribution_from_plan_class_72t(d, IndividualRetirementPlan);
    then repayment_treated_as_ira_rollover_within_60_days_72t(p, d);
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "Rules similar to the rules of subparagraph (H)(v) shall apply with respect to an individual who receives a distribution to which clause (i) applies.")
rule EpedRepaymentSimilarToHv(p: Individual, d: RetirementDistributionEvent, group: Person, on: Date, amount: Money) strict {
    label en official "section 72(t)(2)(I)(vi): rules similar to (H)(v) apply; the shared rules above read every SpecialDistributionKind, so the clause is the statement that the emergency distribution is one of them";
    when special_distribution_72t(p, d, EmergencyPersonalExpense, group, on, amount);
    then special_distribution_repayable_72t(d);
}
pub relation special_distribution_repayable_72t(d: RetirementDistributionEvent) kind institutional {
    label en official "the distribution is of a kind whose amount may be repaid under the rules of (H)(v)";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "Rules similar to the rules of subparagraph (H)(v) shall apply with respect to an individual who receives a distribution to which clause (i) applies.")
rule DabuseRepaymentSimilarToHv(p: Individual, d: RetirementDistributionEvent, group: Person, on: Date, amount: Money) strict {
    label en official "section 72(t)(2)(K)(v)";
    when special_distribution_72t(p, d, DomesticAbuseVictim, group, on, amount);
    then special_distribution_repayable_72t(d);
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "Rules similar to the rules of subparagraph (H)(v) shall apply with respect to an individual who receives a distribution to which clause (i) applies.")
rule TerminalIllnessRepaymentSimilarToHv(p: Individual, d: RetirementDistributionEvent, group: Person, on: Date, amount: Money) strict {
    label en official "section 72(t)(2)(L)(iv)";
    when special_distribution_72t(p, d, TerminallyIll, group, on, amount);
    then special_distribution_repayable_72t(d);
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "Any individual who receives a qualified birth or adoption distribution may, at any time during the 3-year period beginning on the day after the date on which such")
rule QbadRepayable(p: Individual, d: RetirementDistributionEvent, group: Person, on: Date, amount: Money) strict {
    label en official "section 72(t)(2)(H)(v)(I)";
    when special_distribution_72t(p, d, QualifiedBirthOrAdoption, group, on, amount);
    then special_distribution_repayable_72t(d);
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "Any individual who receives a qualified disaster recovery distribution may, at any time during the 3-year period beginning on the day after the date on which such")
rule QdrdRepayable(p: Individual, d: RetirementDistributionEvent, group: Person, on: Date, amount: Money) strict {
    label en official "section 72(t)(11)(C)(i): three years, to an eligible retirement plan";
    when special_distribution_72t(p, d, QualifiedDisasterRecovery, group, on, amount);
    then special_distribution_repayable_72t(d);
}

// (L): terminally ill
relation physician_certified_death_expected_within_months_72t2L(p: Individual, cert_date: Date, months: Integer) kind empirical {
    label en official "a physician certified that the individual has an illness or physical condition which can reasonably be expected to result in death within the number of months after the date of certification";
}
relation evidence_furnished_to_plan_administrator_72t2Liii(p: Individual) kind empirical {
    label en official "the employee furnished sufficient evidence to the plan administrator in the form and manner the Secretary may require";
}
pub relation terminally_ill_individual_72t2L(p: Individual, cert_date: Date) kind institutional {
    label en official "a terminally ill individual under section 101(g)(4)(A) with 84 months substituted for 24 months, having furnished sufficient evidence to the plan administrator";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "For purposes of this subparagraph, the term \"terminally ill individual\" has the same meaning given such term under section 101(g)(4)(A), except that \"84 months\" shall be")
rule TerminallyIllIndividual84Months(p: Individual, cert: Date, months: Integer) strict {
    label en official "section 72(t)(2)(L)(ii)-(iii): death reasonably expected within 84 months or less";
    when physician_certified_death_expected_within_months_72t2L(p, cert, months);
    when months <= 84;
    when evidence_furnished_to_plan_administrator_72t2Liii(p);
    then terminally_ill_individual_72t2L(p, cert);
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "For purposes of this subparagraph, an employee shall not be considered to be a terminally ill individual unless such employee furnishes sufficient evidence to the plan")
rule ExceptionTerminalIllnessDerived(p: Individual, d: RetirementDistributionEvent, on: Date, cert: Date) strict {
    label en official "section 72(t)(2)(L)(i) over the derived status: distributions made on or after the certification date";
    when distribution_date(d, on);
    when terminally_ill_individual_72t2L(p, cert);
    when on >= cert;
    when retirement_plan_distribution_received(p, d, _, _);
    then distribution_fully_exempt_72t(d);
}

// =====================================================================
// §72(t)(4): modification of a substantially equal series
// =====================================================================

relation sepp_series_modified_in_year_72t4A(p: Individual, y: TaxableYear) kind empirical {
    label en official "the series of payments described in paragraph (2)(A)(iv) is subsequently modified in the taxable year";
}
relation sepp_modification_by_death_or_disability_or_72t10_72t4A(p: Individual, y: TaxableYear) kind empirical {
    label en official "the modification is by reason of death or disability or a distribution to which paragraph (10) applies";
}
pub relation sepp_modification_recognized_72t4A(p: Individual, y: TaxableYear) kind institutional {
    label en official "the series is modified other than by reason of death or disability or a distribution to which paragraph (10) applies";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "If—")
rule SeppModificationRecognized(p: Individual, y: TaxableYear) strict {
    label en official "section 72(t)(4)(A)(ii)";
    when sepp_series_modified_in_year_72t4A(p, y);
    when not_known(sepp_modification_by_death_or_disability_or_72t10_72t4A(p, y));
    then sepp_modification_recognized_72t4A(p, y);
}
relation sepp_first_year_without_exception_72t4B(p: Individual, y0: TaxableYear) kind empirical {
    label en official "the taxable year in which the distribution would have been includible in gross income without regard to paragraph (2)(A)(iv)";
}
pub relation deferral_period_72t4B(p: Individual, first_year: TaxableYear, modification_year: TaxableYear) kind institutional {
    label en official "the deferral period begins with the first taxable year in which the distribution would have been includible without the exception and ends with the taxable year in which the modification occurs";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the term \"deferral period\" means the period beginning with the taxable year in which (without regard to paragraph (2)(A)(iv)) the")
rule DeferralPeriodDefined(p: Individual, y0: TaxableYear, y: TaxableYear) strict {
    label en official "section 72(t)(4)(B)";
    when sepp_first_year_without_exception_72t4B(p, y0);
    when sepp_modification_recognized_72t4A(p, y);
    then deferral_period_72t4B(p, y0, y);
}
relation sepp_transfer_or_rollover_between_qualified_plans_72t4C(p: Individual, y: TaxableYear) kind empirical {
    label en official "payments are being made from a qualified retirement plan and all or a portion of the benefit is transferred or rolled over to another qualified retirement plan";
}
relation combined_distributions_would_satisfy_clause_iv_from_transferor_72t4C(p: Individual, y: TaxableYear) kind empirical {
    label en official "distributions from the transferor and transferee plans would in combination continue to satisfy paragraph (2)(A)(iv) if made only from the transferor plan";
}
pub relation transfer_not_a_modification_72t4C(p: Individual, y: TaxableYear) kind institutional {
    label en official "the transfer or rollover is not treated as a modification under (A)(ii); compliance is determined on the combined distributions";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "such transfer or rollover shall not be treated as a modification under subparagraph (A)(ii), and compliance with paragraph (2)(A)(iv) shall be determined on the basis of")
rule TransferNotAModification(p: Individual, y: TaxableYear) strict {
    label en official "section 72(t)(4)(C)(i)-(iii)";
    when sepp_transfer_or_rollover_between_qualified_plans_72t4C(p, y);
    when combined_distributions_would_satisfy_clause_iv_from_transferor_72t4C(p, y);
    then transfer_not_a_modification_72t4C(p, y);
}
pub relation sepp_modification_recapture_applies_72t4(p: Individual, y: TaxableYear) kind institutional {
    label en official "the recapture increase of paragraph (4) applies for the year: a modification is recognized and not excused by a qualifying transfer";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "(ii) the series of payments under such paragraph are subsequently modified (other than by reason of death or disability or a distribution to which paragraph (10)")
rule SeppModificationRecaptureApplies(p: Individual, y: TaxableYear) strict {
    label en official "section 72(t)(4)(A)(ii) with (C)";
    when sepp_modification_recognized_72t4A(p, y);
    when not_known(transfer_not_a_modification_72t4C(p, y));
    then sepp_modification_recapture_applies_72t4(p, y);
}
// G6404 wiring, §72(t)(4)(A): the recapture increase of the year is also concluded from the RECOGNIZED
// modification (not excused by death, disability, (t)(10) or a (t)(4)(C) transfer), in addition to the
// case-asserted `sepp_series_modified_before_5yr_or_age_59_half` read by `SeppRecaptureTax`; both rules give
// the same amount, so the head has one value.
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "the taxpayer's tax for the 1st taxable year in which such modification occurs shall be increased by an amount, determined under regulations, equal to the tax which (but for paragraph (2)(A)(iv)) would have been imposed")
rule SeppRecaptureTaxAfterRecognizedModification(p: Individual, d: RetirementDistributionEvent, y: TaxableYear, original_y: TaxableYear, amount: Money) strict {
    label en official "section 72(t)(4)(A): the recapture tax when the modification is recognized and not excused";
    when sepp_modification_recapture_applies_72t4(p, y);
    when distribution_part_of_sepp_series(p, d);
    when retirement_plan_distribution_received(p, d, original_y, amount);
    then sepp_recapture_tax_72t4(p, y, round(amount * 0.10, 2, "HALF_UP"));
}

// =====================================================================
// §72(t)(5): employee; (t)(6): SIMPLE retirement account; (t)(9): section 457 plans
// =====================================================================

relation participant_in_plan_72t5(person: Individual, plan: RetirementArrangement) kind empirical {
    label en official "the person is a participant in the plan";
}
relation ira_owner_for_whose_benefit_established_72t5(person: Individual, ira: RetirementArrangement) kind empirical {
    label en official "the person is the individual for whose benefit the individual retirement plan was established";
}
pub relation employee_for_purposes_of_72t_72t5(person: Individual, plan: RetirementArrangement) kind institutional {
    label en official "the term employee includes any participant and, in the case of an individual retirement plan, the individual for whose benefit it was established";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, the term \"employee\" includes any participant, and in the case of an individual retirement plan, the individual for whose benefit such")
rule EmployeeIncludesParticipant(person: Individual, plan: RetirementArrangement) strict {
    label en official "section 72(t)(5), participant";
    when participant_in_plan_72t5(person, plan);
    then employee_for_purposes_of_72t_72t5(person, plan);
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, the term \"employee\" includes any participant, and in the case of an individual retirement plan, the individual for whose benefit such")
rule EmployeeIncludesIraOwner(person: Individual, ira: RetirementArrangement) strict {
    label en official "section 72(t)(5), individual retirement plan";
    when ira_owner_for_whose_benefit_established_72t5(person, ira);
    then employee_for_purposes_of_72t_72t5(person, ira);
}
relation amount_from_simple_account_within_2_years_of_participation_72t6a(d: RetirementDistributionEvent) kind empirical {
    label en official "the amount is received from a simple retirement account (section 408(p)) during the 2-year period beginning on the date the individual first participated in a qualified salary reduction arrangement under section 408(p)(2)";
}
relation simple_amount_rolled_over_to_401k_or_403b_after_termination_72t6b(d: RetirementDistributionEvent) kind empirical {
    label en official "on termination of the qualified salary reduction arrangement and establishment of a section 401(k) arrangement or purchase of section 403(b) annuity contracts, the amount is paid in a section 408(d)(3) rollover into a qualified trust under section 401(k) (subject to the rules of section 401(k)(2)(B)) or an annuity contract under section 403(b) (subject to section 403(b)(12)) for the benefit of the employee";
}
pub relation simple_25_percent_rate_applies_72t6a(d: RetirementDistributionEvent) kind institutional {
    label en official "paragraph (1) is applied by substituting 25 percent for 10 percent";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "In the case of any amount received from a simple retirement account (within the meaning of section 408(p)) during the 2-year period beginning on the date such individual")
rule Simple25PercentRateApplies(d: RetirementDistributionEvent) strict {
    label en official "section 72(t)(6)(A), unless the (6)(B) rollover exception applies";
    when amount_from_simple_account_within_2_years_of_participation_72t6a(d);
    when not_known(simple_rollover_exception_applies_72t6b(d)); // G6404 wiring: the derived §72(t)(6)(B) exception (it reads the rollover fact itself)
    then simple_25_percent_rate_applies_72t6a(d);
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "In the case of an employee of an employer which terminates the qualified salary reduction arrangement of the employer under section 408(p) and establishes a qualified")
rule Simple25PercentRateNotAppliedToRollover(d: RetirementDistributionEvent) strict {
    label en official "section 72(t)(6)(B): the rollover amount stays at the general rate; carried by the not_known guard of Simple25PercentRateApplies and of the two 25-percent tax rules";
    when simple_amount_rolled_over_to_401k_or_403b_after_termination_72t6b(d);
    then simple_rollover_exception_applies_72t6b(d);
}
pub relation simple_rollover_exception_applies_72t6b(d: RetirementDistributionEvent) kind institutional {
    label en official "the section 72(t)(6)(B) rollover exception applies to the amount";
}
pub relation early_distribution_additional_tax_simple_25_72t6(p: Individual, d: RetirementDistributionEvent, y: TaxableYear, amount: Money) kind institutional {
    label en official "the additional tax at 25 percent on the amount of an early SIMPLE retirement account distribution not within an exception";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "In the case of any amount received from a simple retirement account (within the meaning of section 408(p)) during the 2-year period beginning on the date such individual")
rule EarlyDistributionTaxSimple25NoException(p: Individual, d: RetirementDistributionEvent, y: TaxableYear, total: Money) strict {
    label en official "section 72(t)(6)(A): 25 percent of the amount when no exception applies";
    when retirement_plan_distribution_received(p, d, y, total);
    when simple_25_percent_rate_applies_72t6a(d);
    when not_known(distribution_fully_exempt_72t(d));
    when not_known(has_partial_exemption_72t(d));
    then early_distribution_additional_tax_simple_25_72t6(p, d, y, round(total * 0.25, 2, "HALF_UP"));
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "In the case of any amount received from a simple retirement account (within the meaning of section 408(p)) during the 2-year period beginning on the date such individual")
rule EarlyDistributionTaxSimple25AboveCap(p: Individual, d: RetirementDistributionEvent, y: TaxableYear, total: Money, exempt: Money) strict {
    label en official "section 72(t)(6)(A): 25 percent of the part above a dollar-capped exception";
    when retirement_plan_distribution_received(p, d, y, total);
    when simple_25_percent_rate_applies_72t6a(d);
    when not_known(distribution_fully_exempt_72t(d));
    when distribution_partial_exemption_amount_72t(d, exempt);
    when total > exempt;
    then early_distribution_additional_tax_simple_25_72t6(p, d, y, round((total - exempt) * 0.25, 2, "HALF_UP"));
}
relation distribution_from_457b_plan_of_eligible_employer_72t9(d: RetirementDistributionEvent) kind empirical {
    label en official "the distribution is from an eligible deferred compensation plan (section 457(b)) of an eligible employer described in section 457(e)(1)(A)";
}
relation amount_attributable_to_transfer_from_qualified_plan_72t9(d: RetirementDistributionEvent, amount: Money) kind empirical {
    label en official "the part of the distribution attributable to an amount transferred to the section 457(b) plan from a qualified retirement plan (section 4974(c))";
}
pub relation distribution_portion_treated_as_qualified_plan_distribution_72t9(d: RetirementDistributionEvent, amount: Money) kind institutional {
    label en official "the part of the distribution treated as a distribution from a qualified retirement plan described in section 4974(c)(1)";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, a distribution from an eligible deferred compensation plan (as defined in section 457(b)) of an eligible employer described in section")
rule Section457DistributionTreatedAsQualifiedPlan(p: Individual, d: RetirementDistributionEvent, y: TaxableYear, dist: Money, attributable: Money) strict {
    label en official "section 72(t)(9): to the extent attributable to an amount transferred from a qualified retirement plan";
    when distribution_from_457b_plan_of_eligible_employer_72t9(d);
    when retirement_plan_distribution_received(p, d, y, dist);
    when amount_attributable_to_transfer_from_qualified_plan_72t9(d, attributable);
    then distribution_portion_treated_as_qualified_plan_distribution_72t9(d, min(dist, attributable));
}

// =====================================================================
// §72(t)(10)(B): qualified public safety employee
// =====================================================================

pub enum PublicSafetyService72t10 {
    PoliceProtection; FirefightingServices; EmergencyMedicalServices; CorrectionsOfficer; ForensicSecurityEmployee;
    FederalLawEnforcementOfficer; FederalCustomsAndBorderProtectionOfficer; FederalFirefighter; AirTrafficController;
    NuclearMaterialsCourier; CapitolPoliceMember; SupremeCourtPoliceMember; DiplomaticSecuritySpecialAgent; OtherService;
}
relation employee_of_state_or_political_subdivision_72t10Bi(p: Individual) kind empirical {
    label en official "the individual is an employee of a State or political subdivision of a State (for services within its jurisdiction)";
}
relation public_safety_service_of_employee_72t10B(p: Individual, service: PublicSafetyService72t10) kind empirical {
    label en official "the kind of service the employee provides";
}
pub relation qualified_public_safety_employee_derived_72t10B(p: Individual) kind institutional {
    label en official "a qualified public safety employee derived from section 72(t)(10)(B)(i)-(ii)";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "(i) any employee of a State or political subdivision of a State who provides police protection, firefighting services, emergency medical services, or services as a")
rule QualifiedPublicSafetyEmployeeStatePolice(p: Individual) strict {
    label en official "section 72(t)(10)(B)(i): police protection";
    when employee_of_state_or_political_subdivision_72t10Bi(p);
    when public_safety_service_of_employee_72t10B(p, PoliceProtection);
    then qualified_public_safety_employee_derived_72t10B(p);
}
rule QualifiedPublicSafetyEmployeeStateFire(p: Individual) strict {
    label en official "section 72(t)(10)(B)(i): firefighting services";
    when employee_of_state_or_political_subdivision_72t10Bi(p);
    when public_safety_service_of_employee_72t10B(p, FirefightingServices);
    then qualified_public_safety_employee_derived_72t10B(p);
}
rule QualifiedPublicSafetyEmployeeStateEms(p: Individual) strict {
    label en official "section 72(t)(10)(B)(i): emergency medical services";
    when employee_of_state_or_political_subdivision_72t10Bi(p);
    when public_safety_service_of_employee_72t10B(p, EmergencyMedicalServices);
    then qualified_public_safety_employee_derived_72t10B(p);
}
rule QualifiedPublicSafetyEmployeeStateCorrections(p: Individual) strict {
    label en official "section 72(t)(10)(B)(i): corrections officer";
    when employee_of_state_or_political_subdivision_72t10Bi(p);
    when public_safety_service_of_employee_72t10B(p, CorrectionsOfficer);
    then qualified_public_safety_employee_derived_72t10B(p);
}
rule QualifiedPublicSafetyEmployeeStateForensic(p: Individual) strict {
    label en official "section 72(t)(10)(B)(i): forensic security employee providing for the care, custody and control of forensic patients";
    when employee_of_state_or_political_subdivision_72t10Bi(p);
    when public_safety_service_of_employee_72t10B(p, ForensicSecurityEmployee);
    then qualified_public_safety_employee_derived_72t10B(p);
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "(ii) any Federal law enforcement officer described in section 8331(20) or 8401(17) of title 5, United States Code, any Federal customs and border protection officer")
rule QualifiedPublicSafetyEmployeeFederalLaw(p: Individual) strict {
    label en official "section 72(t)(10)(B)(ii): Federal law enforcement officer (5 U.S.C. 8331(20), 8401(17))";
    when public_safety_service_of_employee_72t10B(p, FederalLawEnforcementOfficer);
    then qualified_public_safety_employee_derived_72t10B(p);
}
rule QualifiedPublicSafetyEmployeeFederalCustoms(p: Individual) strict {
    label en official "section 72(t)(10)(B)(ii): Federal customs and border protection officer";
    when public_safety_service_of_employee_72t10B(p, FederalCustomsAndBorderProtectionOfficer);
    then qualified_public_safety_employee_derived_72t10B(p);
}
rule QualifiedPublicSafetyEmployeeFederalFirefighter(p: Individual) strict {
    label en official "section 72(t)(10)(B)(ii): Federal firefighter";
    when public_safety_service_of_employee_72t10B(p, FederalFirefighter);
    then qualified_public_safety_employee_derived_72t10B(p);
}
rule QualifiedPublicSafetyEmployeeAirTraffic(p: Individual) strict {
    label en official "section 72(t)(10)(B)(ii): air traffic controller";
    when public_safety_service_of_employee_72t10B(p, AirTrafficController);
    then qualified_public_safety_employee_derived_72t10B(p);
}
rule QualifiedPublicSafetyEmployeeNuclearCourier(p: Individual) strict {
    label en official "section 72(t)(10)(B)(ii): nuclear materials courier";
    when public_safety_service_of_employee_72t10B(p, NuclearMaterialsCourier);
    then qualified_public_safety_employee_derived_72t10B(p);
}
rule QualifiedPublicSafetyEmployeeCapitolPolice(p: Individual) strict {
    label en official "section 72(t)(10)(B)(ii): member of the United States Capitol Police";
    when public_safety_service_of_employee_72t10B(p, CapitolPoliceMember);
    then qualified_public_safety_employee_derived_72t10B(p);
}
rule QualifiedPublicSafetyEmployeeSupremeCourtPolice(p: Individual) strict {
    label en official "section 72(t)(10)(B)(ii): member of the Supreme Court Police";
    when public_safety_service_of_employee_72t10B(p, SupremeCourtPoliceMember);
    then qualified_public_safety_employee_derived_72t10B(p);
}
rule QualifiedPublicSafetyEmployeeDiplomaticSecurity(p: Individual) strict {
    label en official "section 72(t)(10)(B)(ii): diplomatic security special agent of the Department of State";
    when public_safety_service_of_employee_72t10B(p, DiplomaticSecuritySpecialAgent);
    then qualified_public_safety_employee_derived_72t10B(p);
}
relation governmental_plan_distribution_72t10A(d: RetirementDistributionEvent) kind empirical {
    label en official "the distribution is from a governmental plan within section 414(d), or from a plan described in section 402(c)(8)(B)(iii), (iv) or (vi) to an employee who provides firefighting services";
}
relation years_of_service_under_plan_at_separation_72t10A(p: Individual, years: Integer) kind empirical {
    label en official "the years of service under the plan when the employee separates from service";
}
relation separation_from_service_72t10A(p: Individual, d: RetirementDistributionEvent) kind empirical {
    label en official "the distribution is made to the employee after separation from service";
}
@source(IRC_S72_T, relation = formalizes, coverage = partial, quote = "made to an employee after separation from service after attainment of age 55")
rule ExceptionSeparationAfter25YearsPublicSafety(p: Individual, d: RetirementDistributionEvent, years: Integer) strict {
    label en official "section 72(t)(10)(A): for a qualified public safety employee the 55 of (2)(A)(v) becomes age 50 or 25 years of service under the plan, whichever is earlier; the age-50 branch is ExceptionSeparationAfter50PublicSafety, this is the 25-year branch";
    when qualified_public_safety_employee_derived_72t10B(p);
    when governmental_plan_distribution_72t10A(d);
    when separation_from_service_72t10A(p, d);
    when years_of_service_under_plan_at_separation_72t10A(p, years);
    when years >= 25;
    when not_known(exception_a5_and_c_barred_for_ira_72t3A(d));
    then distribution_fully_exempt_72t(d);
}

// =====================================================================
// §72(t)(11)(A)-(F): qualified disaster recovery distributions
// =====================================================================

relation qdrd_distribution_amount_72t11(p: Individual, d: RetirementDistributionEvent, disaster: QualifiedDisaster72p6, amount: Money) kind empirical {
    label en official "a distribution made to the individual with respect to the disaster";
}
relation qdrd_prior_amounts_for_disaster_72t11B(p: Individual, disaster: QualifiedDisaster72p6, amount: Money) kind empirical {
    label en official "the aggregate amount of distributions received by the individual in all earlier taxable years that were treated as qualified disaster recovery distributions with respect to the disaster";
}
pub relation qualified_disaster_recovery_distribution_72t11A(p: Individual, d: RetirementDistributionEvent, disaster: QualifiedDisaster72p6, amount: Money) kind institutional {
    label en official "a qualified disaster recovery distribution: made on or after the first day of the incident period and before the date 180 days after the applicable date, to an individual whose principal abode was in the disaster area and who sustained an economic loss";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "(i) on or after the first day of the incident period of a qualified disaster and before the date that is 180 days after the applicable date with respect to such")
rule QualifiedDisasterRecoveryDistribution(p: Individual, d: RetirementDistributionEvent, disaster: QualifiedDisaster72p6, amount: Money, on: Date, first_day: Date, last_day: Date, applicable: Date) strict {
    label en official "section 72(t)(11)(A)(i)-(ii)";
    when qdrd_distribution_amount_72t11(p, d, disaster, amount);
    when distribution_date(d, on);
    when incident_period_72t11Fii(disaster, first_day, last_day);
    when applicable_date_72t11Fiii(disaster, applicable);
    when qualified_individual_72p6c(p, disaster);
    when on >= first_day;
    when on < add_calendar_period(applicable, 180 calendar_day);
    then qualified_disaster_recovery_distribution_72t11A(p, d, disaster, amount);
}
pub relation qdrd_amount_within_limit_72t11B(p: Individual, d: RetirementDistributionEvent, disaster: QualifiedDisaster72p6, amount: Money) kind institutional {
    label en official "the part of the distribution that may be treated as a qualified disaster recovery distribution: not above $22,000 less the earlier amounts for the disaster in all taxable years";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, the aggregate amount of distributions received by an individual which may be treated as qualified disaster recovery distributions with")
rule QdrdAmountWithinLimit(p: Individual, d: RetirementDistributionEvent, disaster: QualifiedDisaster72p6, amount: Money, prior: Money) strict {
    label en official "section 72(t)(11)(B)(i): 22,000 - prior, not below zero, not above the distribution";
    when qualified_disaster_recovery_distribution_72t11A(p, d, disaster, amount);
    when qdrd_prior_amounts_for_disaster_72t11B(p, disaster, prior);
    when prior < 22000.00 USD;
    then qdrd_amount_within_limit_72t11B(p, d, disaster, min(amount, round(22000.00 USD - prior, 2, "HALF_UP")));
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "Any qualified disaster recovery distribution.")
rule ExceptionQualifiedDisasterRecovery(p: Individual, d: RetirementDistributionEvent, disaster: QualifiedDisaster72p6, cap: Money) strict {
    label en official "section 72(t)(2)(M): exempt to the extent of the section 72(t)(11)(B)(i) limit";
    when qdrd_amount_within_limit_72t11B(p, d, disaster, cap);
    then distribution_partial_exemption_amount_72t(d, cap);
}
relation qdrd_of_group_72t11Bii(p: Individual, disaster: QualifiedDisaster72p6, group: Person, amount: Money, d: RetirementDistributionEvent) kind empirical {
    label en official "a distribution that would be a qualified disaster recovery distribution, from plans of the employer group";
}
pub relation plan_treatment_of_qdrd_permitted_72t11Bii(p: Individual, disaster: QualifiedDisaster72p6, group: Person) kind institutional {
    label en official "a plan is not treated as violating a requirement merely because it treats the distribution as a qualified disaster recovery distribution: the aggregate from the group's plans for the disaster does not exceed $22,000";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "If a distribution to an individual would (without regard to clause (i)) be a qualified disaster recovery distribution, a plan shall not be treated as violating any")
rule PlanTreatmentOfQdrdPermitted(p: Individual, disaster: QualifiedDisaster72p6, group: Person, a0: Money, d0: RetirementDistributionEvent) strict {
    label en official "section 72(t)(11)(B)(ii)-(iii)";
    when qdrd_of_group_72t11Bii(p, disaster, group, a0, d0);
    when sum(collect all a: Money, dd: RetirementDistributionEvent where qdrd_of_group_72t11Bii(p, disaster, group, a, dd), empty: 0.00 USD) <= 22000.00 USD;
    then plan_treatment_of_qdrd_permitted_72t11Bii(p, disaster, group);
}
relation qdrd_elects_out_of_ratable_inclusion_72t11d(p: Individual, y: TaxableYear) kind empirical {
    label en official "the taxpayer elects not to have subparagraph (D) apply for the taxable year";
}
relation qdrd_includible_amount_72t11d(p: Individual, d: RetirementDistributionEvent, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount required to be included in gross income for the taxable year of receipt on account of the distribution";
}
relation later_year_of_qdrd_inclusion_72t11d(y0: TaxableYear, offset: Integer, later: TaxableYear) kind empirical {
    label en official "the taxable year that is the given number of years after the year of receipt";
}
pub relation qdrd_election_out_in_effect_72t11d(p: Individual, y: TaxableYear) kind institutional {
    label en official "the election out of ratable inclusion is in effect for the year";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "In the case of any qualified disaster recovery distribution, unless the taxpayer elects not to have this subparagraph apply for any taxable year, any amount required to")
rule Section72t11dElectionRule defeasible {
    for p: Individual;
    for y: TaxableYear;
    when qdrd_includible_amount_72t11d(p, _, y, _);
    then power Section72t11dElectOut {
        holder p;
        over y;
        exercise qdrd_elects_out_of_ratable_inclusion_72t11d(p, y);
        valid_when has_qdrd_inclusion_72t11d(p, y);
        effect create(qdrd_election_out_in_effect_72t11d(p, y));
        window [-infinity, infinity];
    };
}
pub relation has_qdrd_inclusion_72t11d(p: Individual, y: TaxableYear) kind institutional {
    label en official "helper: the taxable year has an includible amount for a qualified disaster recovery distribution";
}
rule HasQdrdInclusion(p: Individual, d: RetirementDistributionEvent, y: TaxableYear, a: Money) strict {
    label en official "helper for the power validity";
    when qdrd_includible_amount_72t11d(p, d, y, a);
    then has_qdrd_inclusion_72t11d(p, y);
}
pub relation qdrd_ratable_inclusion_72t11d(p: Individual, d: RetirementDistributionEvent, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount included in gross income in the taxable year under the 3-year ratable rule: a third (rounded to cents) in each of the first two years, the remainder in the third";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "In the case of any qualified disaster recovery distribution, unless the taxpayer elects not to have this subparagraph apply for any taxable year, any amount required to")
rule QdrdRatableInclusionYearOne(p: Individual, d: RetirementDistributionEvent, y: TaxableYear, amount: Money) defeasible {
    label en official "section 72(t)(11)(D)(i): first taxable year";
    when qdrd_includible_amount_72t11d(p, d, y, amount);
    when not_known(qdrd_election_out_in_effect_72t11d(p, y));
    when not_known(qdrd_death_in_first_year_72t11dii(p, y)); // G6403 wiring: §72(t)(11)(D)(ii) with §408A(d)(3)(E)(ii)
    then qdrd_ratable_inclusion_72t11d(p, d, y, div_round(amount, 3.0, 2, "HALF_UP"));
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "In the case of any qualified disaster recovery distribution, unless the taxpayer elects not to have this subparagraph apply for any taxable year, any amount required to")
rule QdrdRatableInclusionYearTwo(p: Individual, d: RetirementDistributionEvent, y: TaxableYear, y2: TaxableYear, amount: Money) defeasible {
    label en official "section 72(t)(11)(D)(i): second taxable year";
    when qdrd_includible_amount_72t11d(p, d, y, amount);
    when not_known(qdrd_election_out_in_effect_72t11d(p, y));
    when later_year_of_qdrd_inclusion_72t11d(y, 1, y2);
    when not_known(qdrd_death_in_first_year_72t11dii(p, y)); // G6403 wiring
    when not_known(qdrd_death_in_second_year_72t11dii(p, y)); // G6403 wiring
    then qdrd_ratable_inclusion_72t11d(p, d, y2, div_round(amount, 3.0, 2, "HALF_UP"));
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "In the case of any qualified disaster recovery distribution, unless the taxpayer elects not to have this subparagraph apply for any taxable year, any amount required to")
rule QdrdRatableInclusionYearThree(p: Individual, d: RetirementDistributionEvent, y: TaxableYear, y3: TaxableYear, amount: Money) defeasible {
    label en official "section 72(t)(11)(D)(i): third taxable year takes the remainder after two thirds";
    when qdrd_includible_amount_72t11d(p, d, y, amount);
    when not_known(qdrd_election_out_in_effect_72t11d(p, y));
    when later_year_of_qdrd_inclusion_72t11d(y, 2, y3);
    when not_known(qdrd_death_in_first_year_72t11dii(p, y)); // G6403 wiring
    when not_known(qdrd_death_in_second_year_72t11dii(p, y)); // G6403 wiring
    then qdrd_ratable_inclusion_72t11d(p, d, y3, round(amount - div_round(amount, 3.0, 2, "HALF_UP") - div_round(amount, 3.0, 2, "HALF_UP"), 2, "HALF_UP"));
}
// =====================================================================
// G6403: §72(t)(11)(D)(ii) — rules similar to §408A(d)(3)(E) for the ratable inclusion
// =====================================================================
// The target rule belongs to the retirement-account owner (an importer of this package, so it cannot be read here);
// the content the clause imports is written locally for the three-year schedule. Bounded to the schedule of (D)(i):
// (E)(ii)(I): if the distributee dies before all the amounts are included, all the remaining amounts are included in
// the taxable year that includes the date of death; (E)(i)(II): the amount included for a year never exceeds the
// aggregate less the amounts included for the preceding years (it holds by construction: the third year takes the
// remainder). NOT written: (E)(ii)(II), the election of a surviving spouse to include the remaining amounts in the
// spouse's own years (a power of the spouse, recorded as TECH-GAPS G6700), and (E)(i)(I), the acceleration by
// Roth IRA distributions (it has no counterpart for a qualified disaster recovery distribution).
relation qdrd_distributee_death_year_72t11dii(p: Individual, death_year: TaxableYear) kind empirical {
    label en official "the taxable year that includes the date of death of the distributee (section 408A(d)(3)(E)(ii)(I), applied by section 72(t)(11)(D)(ii))";
}
relation qdrd_death_in_first_year_72t11dii(p: Individual, y: TaxableYear) kind institutional {
    label en official "the distributee dies in the taxable year of receipt: all the remaining amounts are included in that year";
}
rule QdrdDeathInFirstYear(p: Individual, y: TaxableYear) strict {
    label en official "section 408A(d)(3)(E)(ii)(I) applied to the year of receipt";
    when has_qdrd_inclusion_72t11d(p, y);
    when qdrd_distributee_death_year_72t11dii(p, y);
    then qdrd_death_in_first_year_72t11dii(p, y);
}
relation qdrd_death_in_second_year_72t11dii(p: Individual, y: TaxableYear) kind institutional {
    label en official "the distributee dies in the second taxable year of the schedule that begins with the year y: the remaining amounts are included in that year";
}
rule QdrdDeathInSecondYear(p: Individual, y: TaxableYear, y2: TaxableYear) strict {
    label en official "section 408A(d)(3)(E)(ii)(I) applied to the second year";
    when has_qdrd_inclusion_72t11d(p, y);
    when later_year_of_qdrd_inclusion_72t11d(y, 1, y2);
    when qdrd_distributee_death_year_72t11dii(p, y2);
    then qdrd_death_in_second_year_72t11dii(p, y);
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "For purposes of clause (i), rules similar to the rules of subparagraph (E) of section 408A(d)(3) shall apply.")
rule QdrdRatableInclusionDeathInFirstYear(p: Individual, d: RetirementDistributionEvent, y: TaxableYear, amount: Money) defeasible {
    label en official "section 72(t)(11)(D)(ii) with section 408A(d)(3)(E)(ii)(I): the whole amount is included in the year of death when it is the year of receipt";
    when qdrd_includible_amount_72t11d(p, d, y, amount);
    when not_known(qdrd_election_out_in_effect_72t11d(p, y));
    when qdrd_death_in_first_year_72t11dii(p, y);
    then qdrd_ratable_inclusion_72t11d(p, d, y, amount);
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "For purposes of clause (i), rules similar to the rules of subparagraph (E) of section 408A(d)(3) shall apply.")
rule QdrdRatableInclusionDeathInFirstYearFirstThird(p: Individual, d: RetirementDistributionEvent, y: TaxableYear, amount: Money) defeasible {
    label en official "section 72(t)(11)(D)(ii) with section 408A(d)(3)(E)(ii)(I): the first third and, in the year of death (the second year), the remaining two thirds";
    when qdrd_includible_amount_72t11d(p, d, y, amount);
    when not_known(qdrd_election_out_in_effect_72t11d(p, y));
    when qdrd_death_in_second_year_72t11dii(p, y);
    then qdrd_ratable_inclusion_72t11d(p, d, y, div_round(amount, 3.0, 2, "HALF_UP"));
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "For purposes of clause (i), rules similar to the rules of subparagraph (E) of section 408A(d)(3) shall apply.")
rule QdrdRatableInclusionDeathInSecondYear(p: Individual, d: RetirementDistributionEvent, y: TaxableYear, y2: TaxableYear, amount: Money) defeasible {
    label en official "section 72(t)(11)(D)(ii) with section 408A(d)(3)(E)(ii)(I): the remaining two thirds in the year of death";
    when qdrd_includible_amount_72t11d(p, d, y, amount);
    when not_known(qdrd_election_out_in_effect_72t11d(p, y));
    when later_year_of_qdrd_inclusion_72t11d(y, 1, y2);
    when qdrd_death_in_second_year_72t11dii(p, y);
    then qdrd_ratable_inclusion_72t11d(p, d, y2, round(amount - div_round(amount, 3.0, 2, "HALF_UP"), 2, "HALF_UP"));
}
pub relation qdrd_inclusion_rules_similar_to_408Ad3E_72t11dii(p: Individual, y: TaxableYear) kind institutional {
    label en official "rules similar to the rules of section 408A(d)(3)(E) apply to the ratable inclusion (acceleration on death and treatment of a repayment); the content of that subparagraph belongs to the retirement-account owner of section 408A and is EXTERNAL_DEPENDENCY";
}
relation qualified_disaster_area_72t11Fi(disaster: QualifiedDisaster72p6, area_declared_under_stafford_act: Boolean, area_only_by_section_301_tcdtra_2020: Boolean) kind empirical {
    label en official "the area with respect to which the major disaster was declared under the Stafford Act, and whether it is a qualified disaster area solely by reason of section 301 of the Taxpayer Certainty and Disaster Tax Relief Act of 2020";
}
pub relation qualified_disaster_area_recognized_72t11Fi(disaster: QualifiedDisaster72p6) kind institutional {
    label en official "the disaster area is a qualified disaster area for paragraphs (8) and (11): declared under the Stafford Act and not solely by reason of section 301 of the 2020 Act";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "The term \"qualified disaster area\" means, with respect to any qualified disaster, the area with respect to which the major disaster was declared under the Robert T.")
rule QualifiedDisasterAreaRecognized(disaster: QualifiedDisaster72p6) strict {
    label en official "section 72(t)(11)(F)(i)(I)-(II)";
    when qualified_disaster_area_72t11Fi(disaster, true, false);
    then qualified_disaster_area_recognized_72t11Fi(disaster);
}
relation plan_is_eligible_retirement_plan_402c8B_72t11Fiv(plan_class: Person) kind empirical {
    label en official "the plan is an eligible retirement plan within section 402(c)(8)(B)";
}
pub relation eligible_retirement_plan_72t11Fiv(plan_class: Person) kind institutional {
    label en official "an eligible retirement plan has the meaning given by section 402(c)(8)(B)";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "The term \"eligible retirement plan\" shall have the meaning given such term by section 402(c)(8)(B).")
rule EligibleRetirementPlanDefined(plan_class: Person) strict {
    label en official "section 72(t)(11)(F)(iv)";
    when plan_is_eligible_retirement_plan_402c8B_72t11Fiv(plan_class);
    then eligible_retirement_plan_72t11Fiv(plan_class);
}
