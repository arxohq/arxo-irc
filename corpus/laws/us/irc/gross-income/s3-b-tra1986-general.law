// Stage 3 (TECH_GAP reduction): the general transitional rules of Pub. L. 99-514 (Tax Reform Act
// of 1986) sections 1311-1315 and 1318, quoted in the statutory note under section 141
// (fragment IRC_S141_NOTE_6). They decide whether the amendments of section 1301 (sections
// 141-150) reach a bond issued in 1986-1990 and which requirements of the 1986 Code are read into
// the 1954 Code for a bond they do not reach. The rules of sections 1316 and 1317 (established
// programs and named facilities) are in s3-c-tra1986-1316-1317.law and s3-d-tra1986-named-lists.law.
// STATUS: implemented_unverified (static check only; scenarios in tests/s3-b-tra1986-general.lawtest
// are NOT executed).
//
// WHY THE RULES ARE STILL OPERATIVE. The rules have no sunset of their own: a bond issued before
// 1991 may still be outstanding (maturities of 30 to 40 years), and while it is outstanding the
// regime it was grandfathered into decides whether interest on it is excluded under section
// 103(a). The only text limits are on the ISSUE date: section 1317(52) ends section 1317 for
// bonds issued after December 31, 1990, and 1316(g)(5) for bonds issued after December 31, 1988.
//
// SHAPE. A bond issue is the entity; every exception derives `transition_basis_1986` (why the
// amendments of section 1301 do not apply) and, through it, `bond_excepted_from_1986_amendments`.
// For such a bond the 1954 Code regime governs (section 1318(a)(6)); the package does not pin the
// 1954 Code, so a failure of a 1954 Code requirement (and of the requirements the transitional
// rules read into it, `transition_requirement_applies_1986`) is a case fact. The interest
// exclusion of a grandfathered bond is derived in the last part of this file.
//
// JUDGMENT CALLS. Dates and thresholds are compared exactly. A time of day (3 p.m. E.D.T. on
// July 17, 1986, section 1314(d)(3)(A)) is a Boolean case fact, the date type carries no time.
// Averages of maturity and economic life are read as inputs computed under section 147(b)(2).
// The election out of section 1312 (1312(d)) is a case fact of the issuer, not a power: the text
// sets no procedure and no window.

use self::{
    BondIssue,
    IRC_S141_NOTE_6,
    Individual,
    TaxableYear,
    bond_part_of_issue,
    state_or_local_bond,
    state_or_local_bond_interest_excluded_103a,
};

pub enum TransitionRequirement1986 { Section103b4Or5NetProceeds; Section103b6ANetProceeds; Section143Mortgage; Section144a11DepreciableFarmProperty; Section147bMaturity; Section147fPublicApproval; Section147gIssuanceCosts; Section148Arbitrage; Section149eInformationReporting; Section150bChangesInUse; Section143gAnd148Arbitrage; Section149d3And4AdvanceRefunding; Section145bDollarLimit }
pub enum TransitionBasis1986 { IssuedBeforeEffectiveDate; ConstructionOrBindingContract1312a; CurrentRefunding1313a; AdvanceRefunding1313b; EstablishedProgram1316; NamedException1317; NamedException1315; SmallIssueRefunding1313c; ScholarshipRefunding1317 }

// =====================================================================
// core facts and helpers
// =====================================================================

relation bond_issue_date_1986_transition(issue: BondIssue, issued: Date) kind empirical {
    label en official "the date the bond is issued (the issue date of the issue of which the bond is a part)";
}
relation bond_is_refunding_bond_1986_transition(issue: BondIssue) kind empirical {
    label en official "the bond is a refunding bond";
}
relation issuer_elects_out_of_1312_1312d(issue: BondIssue) kind empirical {
    label en official "the issuer of the issue has elected not to have section 1312 apply to the issue (section 1312(d))";
}
relation bond_facts_1312c2(issue: BondIssue, not_industrial_development_bond: Boolean, not_mortgage_subsidy_bond: Boolean, not_private_loan_bond: Boolean) kind empirical {
    label en official "the bond is not an industrial development bond (section 103(b)(2) of the 1954 Code, read with 'directly or indirectly' and without section 103(b)(3)(B)), is not a mortgage subsidy bond (section 103A(b)(1), without regard to any exception), and is not a private loan bond (section 103(o)(2)(A), without regard to any exception other than 103(o)(2)(C))";
}
pub relation government_bond_1312c2(issue: BondIssue) kind institutional {
    label en official "a bond described in section 1312(c)(2): not an industrial development bond, mortgage subsidy bond or private loan bond of the 1954 Code";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(2) Bond described.—A bond is described in this paragraph if such bond is not—")
rule GovernmentBondDefined(issue: BondIssue) strict {
    label en official "section 1312(c)(2)(A)-(C)";
    when bond_facts_1312c2(issue, true, true, true);
    then government_bond_1312c2(issue);
}
pub relation issue_before_effective_date_1986(issue: BondIssue) kind institutional {
    label en official "the bond is issued before the effective date of the amendments of section 1301: on or before August 15, 1986 (August 31, 1986 for a bond described in section 1312(c)(2))";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = partial, quote = "\"(a) In General.—Except as otherwise provided in this subtitle, the amendments made by section 1301")
rule IssueBeforeEffectiveDateOrdinary(issue: BondIssue, issued: Date) strict {
    label en official "section 1311(a): the amendments apply to bonds issued after August 15, 1986; a bond issued on or before that date is outside them";
    when bond_issue_date_1986_transition(issue, issued);
    when issued <= @1986-08-15;
    then issue_before_effective_date_1986(issue);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = partial, quote = "(A) section 1311(a) and (c) and subsection (b) of this section shall be applied by substituting 'August 31, 1986' for 'August 15, 1986' each place it appears,")
rule IssueBeforeEffectiveDateGovernment(issue: BondIssue, issued: Date) strict {
    label en official "section 1312(c)(1)(A): August 31, 1986 replaces August 15, 1986 for a government bond";
    when bond_issue_date_1986_transition(issue, issued);
    when government_bond_1312c2(issue);
    when issued <= @1986-08-31;
    then issue_before_effective_date_1986(issue);
}
pub relation issue_after_effective_date_1986(issue: BondIssue) kind institutional {
    label en official "the bond is issued after the effective date of the amendments of section 1301 (after August 15, 1986; after August 31, 1986 for a government bond)";
}
rule IssueAfterEffectiveDateOrdinary(issue: BondIssue, issued: Date) strict {
    label en official "section 1311(a)";
    when bond_issue_date_1986_transition(issue, issued);
    when issued > @1986-08-15;
    when not_known(government_bond_1312c2(issue));
    then issue_after_effective_date_1986(issue);
}
rule IssueAfterEffectiveDateGovernment(issue: BondIssue, issued: Date) strict {
    label en official "section 1311(a) with section 1312(c)(1)(A)";
    when bond_issue_date_1986_transition(issue, issued);
    when government_bond_1312c2(issue);
    when issued > @1986-08-31;
    then issue_after_effective_date_1986(issue);
}

pub relation transition_basis_1986(issue: BondIssue, basis: TransitionBasis1986) kind institutional {
    label en official "the reason the amendments made by section 1301 (sections 141-150) do not apply to the bond";
}
pub relation bond_excepted_from_1986_amendments(issue: BondIssue) kind institutional {
    label en official "the amendments made by section 1301 do not apply to the bond: the 1954 Code regime governs, with the requirements the transitional rules read into it";
}
rule BondExceptedFromAmendments(issue: BondIssue, basis: TransitionBasis1986) strict {
    label en official "sections 1311(a) to 1317: any basis is enough";
    when transition_basis_1986(issue, basis);
    then bond_excepted_from_1986_amendments(issue);
}
rule BasisIssuedBeforeEffectiveDate(issue: BondIssue) strict {
    label en official "section 1311(a): the bond is issued before the effective date";
    when issue_before_effective_date_1986(issue);
    then transition_basis_1986(issue, IssuedBeforeEffectiveDate);
}
pub relation bond_subject_to_1986_amendments_1311a(issue: BondIssue) kind institutional {
    label en official "the amendments made by section 1301 apply to the bond: it is issued after the effective date and no transitional exception applies";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = partial, quote = "\"(a) In General.—Except as otherwise provided in this subtitle, the amendments made by section 1301")
rule BondSubjectTo1986Amendments(issue: BondIssue) strict {
    label en official "section 1311(a): after the effective date, except as the subtitle otherwise provides";
    when issue_after_effective_date_1986(issue);
    when not_known(bond_excepted_from_1986_amendments(issue));
    then bond_subject_to_1986_amendments_1311a(issue);
}

// =====================================================================
// §1311(c)-(e): dates of section 150(b), 147(f), 149(e), 150(d)
// =====================================================================

relation change_in_use_and_financing_dates_1311c(issue: BondIssue, change_in_use_on: Date, financing_provided_on: Date) kind empirical {
    label en official "the date of the change in use (or ownership) of the facility and the date the financing (including a refinancing) was provided";
}
pub relation section_150b_applies_to_change_1311c(issue: BondIssue) kind institutional {
    label en official "section 150(b) of the 1986 Code applies to the change in use: the change is after August 15, 1986 and the financing was provided after that date";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "Subsection (b) of section 150 of the 1986 Code shall apply to changes in use (and ownership) after August 15, 1986, but only with respect to financing (including refinancings) provided after such date.")
rule Section150bAppliesToChangeInUse(issue: BondIssue, change: Date, financing: Date) strict {
    label en official "section 1311(c)";
    when change_in_use_and_financing_dates_1311c(issue, change, financing);
    when change > @1986-08-15;
    when financing > @1986-08-15;
    then section_150b_applies_to_change_1311c(issue);
}
pub relation sections_147f_149e_apply_1311d(issue: BondIssue) kind institutional {
    label en official "sections 147(f) and 149(e) of the 1986 Code apply to the bond: it is issued after December 31, 1986";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "Sections 147(f) and 149(e) of the 1986 Code shall apply to bonds issued after December 31, 1986.")
rule Sections147f149eApply(issue: BondIssue, issued: Date) strict {
    label en official "section 1311(d)";
    when bond_issue_date_1986_transition(issue, issued);
    when issued > @1986-12-31;
    then sections_147f_149e_apply_1311d(issue);
}
relation scholarship_rebate_payment_date_1311e(issue: BondIssue, paid_on: Date) kind empirical {
    label en official "the date of a payment under the rebate requirement of section 150(d) for a qualified scholarship funding bond";
}
pub relation section_150d_rebate_applies_to_payment_1311e(issue: BondIssue) kind institutional {
    label en official "section 150(d) of the 1986 Code applies to the payment: it is made after August 15, 1986";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "Section 150(d) of the 1986 Code shall apply to payments made after August 15, 1986.")
rule Section150dAppliesToPayment(issue: BondIssue, paid: Date) strict {
    label en official "section 1311(e)";
    when scholarship_rebate_payment_date_1311e(issue, paid);
    when paid > @1986-08-15;
    then section_150d_rebate_applies_to_payment_1311e(issue);
}

// =====================================================================
// §1312(a): construction or binding agreement
// =====================================================================

relation facility_construction_1312a1Ai(issue: BondIssue, original_use_begins_with_taxpayer: Boolean, construction_began: Date, construction_completed: Date) kind empirical {
    label en official "the original use of the facility begins with the taxpayer, and construction, reconstruction or rehabilitation began and was completed on the given dates";
}
relation facility_binding_contract_1312a1Aii(issue: BondIssue, original_use_begins_with_taxpayer: Boolean, contract_entered_on: Date, expenditures_incurred_on_or_after_1985_09_26: Boolean) kind empirical {
    label en official "the original use begins with the taxpayer and a binding contract to incur significant expenditures for construction, reconstruction or rehabilitation was entered into on the date, and some of the expenditures are incurred on or after September 26, 1985";
}
relation facility_acquired_under_binding_contract_1312a1Aiii(issue: BondIssue, acquired_on: Date, contract_entered_on: Date) kind empirical {
    label en official "the facility is acquired on the date pursuant to a binding contract entered into on the earlier date";
}
relation inducement_or_approval_1312a1B(issue: BondIssue, adopted_on: Date) kind empirical {
    label en official "an inducement resolution or other comparable preliminary approval was adopted by the issuing authority (or by a voter referendum) on the date";
}
relation expenditures_and_anticipated_cost_1312a2(issue: BondIssue, expenditures: Money, reasonably_anticipated_cost: Money) kind empirical {
    label en official "the expenditures incurred and the reasonably anticipated cost of the construction, reconstruction or rehabilitation of the facility";
}
pub relation significant_expenditures_1312a2(issue: BondIssue) kind institutional {
    label en official "the expenditures are greater than 10 percent of the reasonably anticipated cost";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(2) Significant expenditures.—For purposes of paragraph (1)(A), the term 'significant expenditures' means expenditures greater than 10 percent of the reasonably anticipated cost of the construction, reconstruction, or rehabilitation of the facility involved.")
rule SignificantExpenditures(issue: BondIssue, spent: Money, cost: Money) strict {
    label en official "section 1312(a)(2): strictly more than 10 percent, exact cross multiplication";
    when expenditures_and_anticipated_cost_1312a2(issue, spent, cost);
    when cost > 0.00 USD;
    when spent * 10 > cost;
    then significant_expenditures_1312a2(issue);
}
pub relation bond_excepted_1312a(issue: BondIssue) kind institutional {
    label en official "the amendments of section 1301 do not apply to the bond: the facility was under construction, under a binding contract or acquired under a binding contract before September 26, 1985 and was described in a preliminary approval before that date";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "(A)(i) the original use of which commences with the taxpayer, and the construction, reconstruction, or rehabilitation of which began before September 26, 1985, and was completed on or after such date,")
rule Exception1312aByConstruction(issue: BondIssue, began: Date, completed: Date, approved: Date) strict {
    label en official "section 1312(a)(1)(A)(i) with (B): not a refunding bond, the issuer has not elected out";
    when facility_construction_1312a1Ai(issue, true, began, completed);
    when began < @1985-09-26;
    when completed >= @1985-09-26;
    when inducement_or_approval_1312a1B(issue, approved);
    when approved < @1985-09-26;
    when not_known(bond_is_refunding_bond_1986_transition(issue));
    when not_known(issuer_elects_out_of_1312_1312d(issue));
    then bond_excepted_1312a(issue);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "(ii) the original use of which begins with the taxpayer and with respect to which a binding contract to incur significant expenditures for construction, reconstruction, or rehabilitation was entered into before September 26, 1985, and some of such expenditures are incurred on or after such date, or")
rule Exception1312aByBindingContractForConstruction(issue: BondIssue, contract: Date, approved: Date) strict {
    label en official "section 1312(a)(1)(A)(ii) with (B) and (2): significant expenditures";
    when facility_binding_contract_1312a1Aii(issue, true, contract, true);
    when contract < @1985-09-26;
    when significant_expenditures_1312a2(issue);
    when inducement_or_approval_1312a1B(issue, approved);
    when approved < @1985-09-26;
    when not_known(bond_is_refunding_bond_1986_transition(issue));
    when not_known(issuer_elects_out_of_1312_1312d(issue));
    then bond_excepted_1312a(issue);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "(iii) acquired on or after September 26, 1985, pursuant to a binding contract entered into before such date, and")
rule Exception1312aByAcquisition(issue: BondIssue, acquired: Date, contract: Date, approved: Date) strict {
    label en official "section 1312(a)(1)(A)(iii) with (B)";
    when facility_acquired_under_binding_contract_1312a1Aiii(issue, acquired, contract);
    when acquired >= @1985-09-26;
    when contract < @1985-09-26;
    when inducement_or_approval_1312a1B(issue, approved);
    when approved < @1985-09-26;
    when not_known(bond_is_refunding_bond_1986_transition(issue));
    when not_known(issuer_elects_out_of_1312_1312d(issue));
    then bond_excepted_1312a(issue);
}
rule BasisConstructionOrBindingContract(issue: BondIssue) strict {
    label en official "section 1312(a)";
    when bond_excepted_1312a(issue);
    then transition_basis_1986(issue, ConstructionOrBindingContract1312a);
}

// =====================================================================
// §1312(b), (c): requirements read into the 1954 Code for a section 1312(a) bond
// =====================================================================

pub relation transition_requirement_applies_1986(issue: BondIssue, requirement: TransitionRequirement1986) kind institutional {
    label en official "the requirement of the 1986 Code is treated as included in section 103 or 103A of the 1954 Code for the bond";
}
pub relation requirement_applied_as_governmental_1986(issue: BondIssue, requirement: TransitionRequirement1986) kind institutional {
    label en official "the requirement is applied to the bond as a bond that is not a private activity bond (section 1312(c)(1)(C), 1313(a)(4)(C), 1313(b)(4)(C))";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(A) The requirement that 95 percent or more of the net proceeds of an issue are to be used for a purpose described in section 103(b)(4) or (5) of such Code in order for section 103(b)(4) or (5) of such Code to apply, including the application of section 142(b)(2) of the 1986 Code (relating to limitation on office space).")
rule Requirement1312bA(issue: BondIssue) strict {
    label en official "section 1312(b)(1)(A)";
    when bond_excepted_1312a(issue);
    when issue_after_effective_date_1986(issue);
    then transition_requirement_applies_1986(issue, Section103b4Or5NetProceeds);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(B) The requirement that 95 percent or more of the net proceeds of an issue are to be used for a purpose described in section 103(b)(6)(A) of the 1954 Code in order for section 103(b)(6)(A) of such Code to apply.")
rule Requirement1312bB(issue: BondIssue) strict {
    label en official "section 1312(b)(1)(B)";
    when bond_excepted_1312a(issue);
    when issue_after_effective_date_1986(issue);
    then transition_requirement_applies_1986(issue, Section103b6ANetProceeds);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(C) The requirements of section 143 of the 1986 Code (relating to qualified mortgage bonds and qualified veterans' mortgage bonds) in order for section 103A(b)(2) of the 1954 Code to apply.")
rule Requirement1312bC(issue: BondIssue) strict {
    label en official "section 1312(b)(1)(C)";
    when bond_excepted_1312a(issue);
    when issue_after_effective_date_1986(issue);
    then transition_requirement_applies_1986(issue, Section143Mortgage);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(D) The requirements of section 144(a)(11) of the 1986 Code (relating to limitation on acquisition of depreciable farm property) in order for section 103(b)(6)(A) of the 1954 Code to apply.")
rule Requirement1312bD(issue: BondIssue) strict {
    label en official "section 1312(b)(1)(D)";
    when bond_excepted_1312a(issue);
    when issue_after_effective_date_1986(issue);
    then transition_requirement_applies_1986(issue, Section144a11DepreciableFarmProperty);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(E) The requirements of section 147(b) of the 1986 Code (relating to maturity may not exceed 120 percent of economic life).")
rule Requirement1312bE(issue: BondIssue) strict {
    label en official "section 1312(b)(1)(E)";
    when bond_excepted_1312a(issue);
    when issue_after_effective_date_1986(issue);
    then transition_requirement_applies_1986(issue, Section147bMaturity);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(F) The requirements of section 147(f) of the 1986 Code (relating to public approval required for private activity bonds).")
rule Requirement1312bF(issue: BondIssue, issued: Date) strict {
    label en official "section 1312(b)(1)(F) with (2): only for a bond issued after December 31, 1986; not for a government bond (1312(c)(1)(B))";
    when bond_excepted_1312a(issue);
    when bond_issue_date_1986_transition(issue, issued);
    when issued > @1986-12-31;
    when not_known(government_bond_1312c2(issue));
    then transition_requirement_applies_1986(issue, Section147fPublicApproval);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(G) The requirements of section 147(g) of the 1986 Code (relating to restriction on issuance costs financed by issue).")
rule Requirement1312bG(issue: BondIssue) strict {
    label en official "section 1312(b)(1)(G); not for a government bond (1312(c)(1)(B))";
    when bond_excepted_1312a(issue);
    when issue_after_effective_date_1986(issue);
    when not_known(government_bond_1312c2(issue));
    then transition_requirement_applies_1986(issue, Section147gIssuanceCosts);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(H) The requirements of section 148 of the 1986 Code (relating to arbitrage).")
rule Requirement1312bH(issue: BondIssue) strict {
    label en official "section 1312(b)(1)(H)";
    when bond_excepted_1312a(issue);
    when issue_after_effective_date_1986(issue);
    then transition_requirement_applies_1986(issue, Section148Arbitrage);
}
rule Requirement1312bHGovernmental(issue: BondIssue) strict {
    label en official "section 1312(c)(1)(C): the government bond is not a private activity bond for the requirement of (H)";
    when bond_excepted_1312a(issue);
    when government_bond_1312c2(issue);
    then requirement_applied_as_governmental_1986(issue, Section148Arbitrage);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(I) The requirements of section 149(e) of the 1986 Code (relating to information reporting).")
rule Requirement1312bI(issue: BondIssue, issued: Date) strict {
    label en official "section 1312(b)(1)(I) with (2): only for a bond issued after December 31, 1986";
    when bond_excepted_1312a(issue);
    when bond_issue_date_1986_transition(issue, issued);
    when issued > @1986-12-31;
    then transition_requirement_applies_1986(issue, Section149eInformationReporting);
}
rule Requirement1312bIGovernmental(issue: BondIssue) strict {
    label en official "section 1312(c)(1)(C): the government bond is not a private activity bond for the requirement of (I)";
    when bond_excepted_1312a(issue);
    when government_bond_1312c2(issue);
    then requirement_applied_as_governmental_1986(issue, Section149eInformationReporting);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(J) The provisions of section 150(b) of the 1986 Code (relating to changes in use).")
rule Requirement1312bJ(issue: BondIssue) strict {
    label en official "section 1312(b)(1)(J); not for a government bond (1312(c)(1)(B))";
    when bond_excepted_1312a(issue);
    when issue_after_effective_date_1986(issue);
    when not_known(government_bond_1312c2(issue));
    then transition_requirement_applies_1986(issue, Section150bChangesInUse);
}
relation bond_would_count_under_103n_or_103Ag_1312b3(issue: BondIssue) kind empirical {
    label en official "the bond would have been taken into account under section 103(n) or 103A(g) of the 1954 Code (determined without regard to any carryforward election) were it issued before August 16, 1986";
}
pub relation treated_as_private_activity_bond_for_146_1312b3(issue: BondIssue) kind institutional {
    label en official "a bond to which section 1312(b) applies is treated as a private activity bond for the volume cap of section 146";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(3) Application of volume cap.—Except as provided in section 1315, any bond to which this subsection applies shall be treated as a private activity bond for purposes of section 146 of the 1986 Code if such bond would have been taken into account under section 103(n) or 103A(g) of the 1954 Code")
rule TreatedAsPrivateActivityBondForVolumeCap(issue: BondIssue) strict {
    label en official "section 1312(b)(3), unless section 1315 applies";
    when bond_excepted_1312a(issue);
    when issue_after_effective_date_1986(issue);
    when bond_would_count_under_103n_or_103Ag_1312b3(issue);
    when not_known(volume_cap_not_applied_1315c(issue));
    then treated_as_private_activity_bond_for_146_1312b3(issue);
}
relation use_most_closely_relates_141d1_1312b4(issue: BondIssue, subparagraph: Integer) kind empirical {
    label en official "the subparagraph of section 141(d)(1) (numbered 1 to 7 for (A) to (G)) to which the use of the proceeds of the bond most closely relates";
}
pub relation treated_as_described_in_141d1_1312b4(issue: BondIssue, subparagraph: Integer) kind institutional {
    label en official "for the requirements of section 1312(b)(1) and section 1313(a)(3), (b)(3) the bond is treated as described in the subparagraph of section 141(d)(1) to which the use of its proceeds most closely relates";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(4) Application of provisions.—For purposes of applying the requirements referred to in any subparagraph of paragraph (1) or of subsection (a)(3) or (b)(3) of section 1313 to any bond, such bond shall be treated as described in the subparagraph of section 141(d)(1) of the 1986 Code to which the use of the proceeds of such bond most closely relates.")
rule TreatedAsDescribedIn141d1(issue: BondIssue, subparagraph: Integer) strict {
    label en official "section 1312(b)(4)";
    when bond_excepted_1986_for_requirements(issue);
    when use_most_closely_relates_141d1_1312b4(issue, subparagraph);
    then treated_as_described_in_141d1_1312b4(issue, subparagraph);
}
relation bond_excepted_1986_for_requirements(issue: BondIssue) kind institutional {
    label en official "helper: the bond is a section 1312(a) bond or a refunding bond of section 1313 to which requirements are read in";
}
rule RequirementsHelperByConstruction(issue: BondIssue) strict {
    label en official "helper";
    when bond_excepted_1312a(issue);
    then bond_excepted_1986_for_requirements(issue);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = partial, quote = "(B) subsection (b)(1) shall be applied without regard to subparagraphs (F), (G), and (J), and")
rule SpecialRuleFederalGuaranteeNotes1312c1B(issue: BondIssue) strict {
    label en official "section 1312(c)(1)(B): recorded by the (F), (G) and (J) rules above, which do not fire for a government bond";
    when government_bond_1312c2(issue);
    when bond_excepted_1312a(issue);
    then requirement_applied_as_governmental_1986(issue, Section149eInformationReporting);
}

// =====================================================================
// §1313(a), (b): refundings
// =====================================================================

relation issue_refunds_bond_1313(issue: BondIssue, refunded: BondIssue) kind empirical {
    label en official "the proceeds of the bond are used exclusively to refund the bond of the refunded issue (or a bond that is part of a series of refundings of it)";
}
relation refunding_amount_and_maturity_1313(issue: BondIssue, amount: Money, outstanding_refunded_amount: Money, average_maturity_years: Decimal, average_economic_life_years: Decimal, maturity_date: Date) kind empirical {
    label en official "the amount of the refunding bond, the outstanding amount of the refunded bond, the average maturity of the issue of which it is a part and the average reasonably expected economic life of the facilities financed (both under section 147(b)), and the maturity date of the refunding bond";
}
relation refunded_bond_issue_date_and_kind_1313(refunded: BondIssue, issued: Date, was_mortgage_bond: Boolean) kind empirical {
    label en official "the date the qualified bond was issued and whether it was a qualified mortgage bond or a qualified veterans' mortgage bond when issued";
}
relation refunding_is_advance_refunding_1313(issue: BondIssue) kind empirical {
    label en official "the refunding bond is issued to advance refund";
}
pub relation qualified_bond_1313a2(issue: BondIssue) kind institutional {
    label en official "a qualified bond: a bond (other than a refunding bond) issued before August 16, 1986 or a bond issued after August 15, 1986 to which section 1312(a) applies";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "(A) issued before August 16, 1986, or")
rule QualifiedBondIssuedBefore(issue: BondIssue) strict {
    label en official "section 1313(a)(2)(A)";
    when issue_before_effective_date_1986(issue);
    when not_known(bond_is_refunding_bond_1986_transition(issue));
    then qualified_bond_1313a2(issue);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "(B) issued after August 15, 1986, if section 1312(a) applies to such bond.")
rule QualifiedBondBy1312a(issue: BondIssue) strict {
    label en official "section 1313(a)(2)(B)";
    when bond_excepted_1312a(issue);
    when not_known(bond_is_refunding_bond_1986_transition(issue));
    then qualified_bond_1313a2(issue);
}
pub relation current_refunding_conditions_met_1313a1(issue: BondIssue) kind institutional {
    label en official "the refunding bond does not exceed the outstanding amount of the refunded bond and its maturity fits section 1313(a)(1)(B): 120 percent of economic life or 17 years (32 years for a mortgage bond) after the qualified bond was issued";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(A) the amount of the refunding bond does not exceed the outstanding amount of the refunded bond, and")
rule CurrentRefundingConditionsByEconomicLife(issue: BondIssue, refunded: BondIssue, amount: Money, outstanding: Money, maturity: Decimal, life: Decimal, matures: Date, issued: Date) strict {
    label en official "section 1313(a)(1)(A) and (B)(i): not for a qualified mortgage or veterans' mortgage bond";
    when issue_refunds_bond_1313(issue, refunded);
    when refunding_amount_and_maturity_1313(issue, amount, outstanding, maturity, life, matures);
    when refunded_bond_issue_date_and_kind_1313(refunded, issued, false);
    when amount <= outstanding;
    when maturity <= life * 1.2;
    then current_refunding_conditions_met_1313a1(issue);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(ii) the refunding bond has a maturity date not later than the date which is 17 years after the date on which the qualified bond was issued.")
rule CurrentRefundingConditionsBySeventeenYears(issue: BondIssue, refunded: BondIssue, amount: Money, outstanding: Money, maturity: Decimal, life: Decimal, matures: Date, issued: Date) strict {
    label en official "section 1313(a)(1)(A) and (B)(ii): 17 years for a bond that was not a mortgage bond";
    when issue_refunds_bond_1313(issue, refunded);
    when refunding_amount_and_maturity_1313(issue, amount, outstanding, maturity, life, matures);
    when refunded_bond_issue_date_and_kind_1313(refunded, issued, false);
    when amount <= outstanding;
    when matures <= add_calendar_period(issued, 17 calendar_year);
    then current_refunding_conditions_met_1313a1(issue);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "In the case of a qualified bond which was (when issued) a qualified mortgage bond or a qualified veterans' mortgage bond, subparagraph (B)(i) shall not apply and subparagraph (B)(ii) shall be applied by substituting '32 years' for '17 years'.")
rule CurrentRefundingConditionsByThirtyTwoYearsMortgage(issue: BondIssue, refunded: BondIssue, amount: Money, outstanding: Money, maturity: Decimal, life: Decimal, matures: Date, issued: Date) strict {
    label en official "section 1313(a)(1) last sentence: 32 years, no economic-life alternative, for a qualified mortgage or veterans' mortgage bond";
    when issue_refunds_bond_1313(issue, refunded);
    when refunding_amount_and_maturity_1313(issue, amount, outstanding, maturity, life, matures);
    when refunded_bond_issue_date_and_kind_1313(refunded, issued, true);
    when amount <= outstanding;
    when matures <= add_calendar_period(issued, 32 calendar_year);
    then current_refunding_conditions_met_1313a1(issue);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(1) In general.—Except as provided in paragraph (3), the amendments made by section 1301 [for classification see section 1311(a) of this note] shall not apply to any bond the proceeds of which are used exclusively to refund (other than to advance refund) a qualified bond")
rule BasisCurrentRefunding(issue: BondIssue, refunded: BondIssue) strict {
    label en official "section 1313(a)(1): a current refunding of a qualified bond meeting (A) and (B)";
    when issue_refunds_bond_1313(issue, refunded);
    when qualified_bond_1313a2(refunded);
    when current_refunding_conditions_met_1313a1(issue);
    when not_known(refunding_is_advance_refunding_1313(issue));
    then transition_basis_1986(issue, CurrentRefunding1313a);
}
relation refunded_bond_facts_1313b2(refunded: BondIssue, not_idb_or_private_loan_bond: Boolean, issued_on: Date) kind empirical {
    label en official "the refunded bond is not described in section 103(b)(2) or (o)(2)(A) of the 1954 Code (without regard to any exception other than 103(o)(2)(C)), and the date it was issued (or the date of the bond it was issued to refund)";
}
pub relation refunded_bond_described_1313b2(refunded: BondIssue) kind institutional {
    label en official "a bond described in section 1313(b)(2): not an IDB or private loan bond and issued (or issued to refund a bond issued) before August 16, 1986 (September 1, 1986 for a government bond, section 1313(b)(4)(A))";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(2) Non-idb's, etc.—A bond is described in this paragraph if such bond is not described in subsection (b)(2) or (o)(2)(A) of section 103 of the 1954 Code")
rule RefundedBondDescribed(refunded: BondIssue, issued: Date) strict {
    label en official "section 1313(b)(2): issued before August 16, 1986";
    when refunded_bond_facts_1313b2(refunded, true, issued);
    when issued <= @1986-08-15;
    then refunded_bond_described_1313b2(refunded);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "(A) paragraph (2) of this subsection shall be applied by substituting 'September 1, 1986' for 'August 16, 1986'")
rule RefundedBondDescribedGovernment(refunded: BondIssue, issued: Date) strict {
    label en official "section 1313(b)(4)(A): September 1, 1986 replaces August 16, 1986 for a government bond";
    when refunded_bond_facts_1313b2(refunded, true, issued);
    when government_bond_1312c2(refunded);
    when issued <= @1986-08-31;
    then refunded_bond_described_1313b2(refunded);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(1) In general.—Except as provided in paragraph (3), the amendments made by section 1301 [for classification see section 1311(a) of this note] shall not apply to any bond the proceeds of which are used exclusively to advance refund a bond if—")
rule BasisAdvanceRefunding(issue: BondIssue, refunded: BondIssue) strict {
    label en official "section 1313(b)(1): an advance refunding of a described bond meeting section 1313(a)(1)(B)";
    when issue_refunds_bond_1313(issue, refunded);
    when refunding_is_advance_refunding_1313(issue);
    when refunded_bond_described_1313b2(refunded);
    when current_refunding_conditions_met_1313a1(issue);
    then transition_basis_1986(issue, AdvanceRefunding1313b);
}
relation refunding_issue_date_1313(issue: BondIssue, issued: Date) kind empirical {
    label en official "the date the refunding bond is issued";
}
relation refunding_maturity_later_than_refunded_1313a3A(issue: BondIssue) kind empirical {
    label en official "the maturity date of the refunding bond is later than the maturity date of the refunded bond";
}
pub relation refunding_requirement_applies_1313(issue: BondIssue, requirement: TransitionRequirement1986) kind institutional {
    label en official "the requirement of the 1986 Code is treated as included in section 103 or 103A of the 1954 Code and applies to the refunding bond of section 1313(a)(1) or (b)(1)";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(A) The requirements of section 147(f) (relating to public approval required for private activity bonds) but only if the maturity date of the refunding bond is later than the maturity date of the refunded bond.")
rule RefundingRequires147fCurrent(issue: BondIssue, issued: Date) strict {
    label en official "section 1313(a)(3)(A): only if the maturity is later and the refunding bond is issued after December 31, 1986; not for a government bond (1313(a)(4)(B))";
    when transition_basis_1986(issue, CurrentRefunding1313a);
    when refunding_maturity_later_than_refunded_1313a3A(issue);
    when refunding_issue_date_1313(issue, issued);
    when issued > @1986-12-31;
    when not_known(government_bond_1312c2(issue));
    then refunding_requirement_applies_1313(issue, Section147fPublicApproval);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(B) The requirements of section 147(g) (relating to restriction on issuance costs financed by issue).")
rule RefundingRequires147gCurrent(issue: BondIssue) strict {
    label en official "section 1313(a)(3)(B); not for a government bond (1313(a)(4)(B))";
    when transition_basis_1986(issue, CurrentRefunding1313a);
    when not_known(government_bond_1312c2(issue));
    then refunding_requirement_applies_1313(issue, Section147gIssuanceCosts);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(C) The requirements of sections 143(g) and 148 (relating to arbitrage).")
rule RefundingRequiresArbitrageCurrent(issue: BondIssue) strict {
    label en official "section 1313(a)(3)(C)";
    when transition_basis_1986(issue, CurrentRefunding1313a);
    then refunding_requirement_applies_1313(issue, Section143gAnd148Arbitrage);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(D) The requirements of section 149(e) (relating to information reporting).")
rule RefundingRequires149eCurrent(issue: BondIssue, issued: Date) strict {
    label en official "section 1313(a)(3)(D) with the closing sentence: only for a refunding bond issued after December 31, 1986";
    when transition_basis_1986(issue, CurrentRefunding1313a);
    when refunding_issue_date_1313(issue, issued);
    when issued > @1986-12-31;
    then refunding_requirement_applies_1313(issue, Section149eInformationReporting);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(E) The provisions of section 150(b) (relating to changes in use).")
rule RefundingRequires150bCurrent(issue: BondIssue) strict {
    label en official "section 1313(a)(3)(E); not for a government bond (1313(a)(4)(B))";
    when transition_basis_1986(issue, CurrentRefunding1313a);
    when not_known(government_bond_1312c2(issue));
    then refunding_requirement_applies_1313(issue, Section150bChangesInUse);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(A) The requirements of section 147(f) (relating to public approval required for private activity bonds).")
rule RefundingRequires147fAdvance(issue: BondIssue, issued: Date) strict {
    label en official "section 1313(b)(3)(A) with the closing sentence: only for a refunding bond issued after December 31, 1986; not for a government bond (1313(b)(4)(B))";
    when transition_basis_1986(issue, AdvanceRefunding1313b);
    when refunding_issue_date_1313(issue, issued);
    when issued > @1986-12-31;
    when not_known(government_bond_1312c2(issue));
    then refunding_requirement_applies_1313(issue, Section147fPublicApproval);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(B) The requirements of section 147(g) (relating to restriction on issuance costs financed by issue).")
rule RefundingRequires147gAdvance(issue: BondIssue) strict {
    label en official "section 1313(b)(3)(B); not for a government bond (1313(b)(4)(B))";
    when transition_basis_1986(issue, AdvanceRefunding1313b);
    when not_known(government_bond_1312c2(issue));
    then refunding_requirement_applies_1313(issue, Section147gIssuanceCosts);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(C) The requirements of section 148 (relating to arbitrage), except that section 148(d)(3) shall not apply to proceeds of such bonds to be used to discharge the refunded bonds.")
rule RefundingRequires148Advance(issue: BondIssue) strict {
    label en official "section 1313(b)(3)(C): 148(d)(3) does not apply to proceeds used to discharge the refunded bonds";
    when transition_basis_1986(issue, AdvanceRefunding1313b);
    then refunding_requirement_applies_1313(issue, Section148Arbitrage);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(D) The requirements of [former] paragraphs (3) and (4) of section 149(d) (relating to advance refundings).")
rule RefundingRequires149dAdvance(issue: BondIssue) strict {
    label en official "section 1313(b)(3)(D)";
    when transition_basis_1986(issue, AdvanceRefunding1313b);
    then refunding_requirement_applies_1313(issue, Section149d3And4AdvanceRefunding);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(E) The requirements of section 149(e) (relating to information reporting).")
rule RefundingRequires149eAdvance(issue: BondIssue, issued: Date) strict {
    label en official "section 1313(b)(3)(E) with the closing sentence: only for a refunding bond issued after December 31, 1986";
    when transition_basis_1986(issue, AdvanceRefunding1313b);
    when refunding_issue_date_1313(issue, issued);
    when issued > @1986-12-31;
    then refunding_requirement_applies_1313(issue, Section149eInformationReporting);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(F) The provisions of section 150(b) (relating to changes in use).")
rule RefundingRequires150bAdvance(issue: BondIssue) strict {
    label en official "section 1313(b)(3)(F); not for a government bond (1313(b)(4)(B))";
    when transition_basis_1986(issue, AdvanceRefunding1313b);
    when not_known(government_bond_1312c2(issue));
    then refunding_requirement_applies_1313(issue, Section150bChangesInUse);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = partial, quote = "\"(G) Except as provided in the last sentence of subsection (c)(2) of this section, the requirements of section 145(b) (relating to $150,000,000 limitation on bonds other than hospital bonds).")
rule RefundingRequires145bAdvance(issue: BondIssue) strict {
    label en official "section 1313(b)(3)(G), subject to the last sentence of subsection (c)(2)";
    when transition_basis_1986(issue, AdvanceRefunding1313b);
    when not_known(first_advance_refunding_after_1986_03_14_1313c2(issue));
    then refunding_requirement_applies_1313(issue, Section145bDollarLimit);
}
relation refunds_output_facility_issue_1313b5(issue: BondIssue) kind empirical {
    label en official "the proceeds refund a bond issued as part of an issue 5 percent or more of the net proceeds of which are or will be used to provide an output facility (section 141(b)(4)), to the extent of the nongovernmental use of that issue";
}
pub relation refunding_treated_as_private_activity_bond_1313b5(issue: BondIssue) kind institutional {
    label en official "the advance refunding bond is treated as a private activity bond for the volume cap of section 146";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(5) Certain refunding bonds subject to volume cap.—Any refunding bond described in paragraph (1) the proceeds of which are used to refund a bond issued as part of an issue 5 percent or more of the net proceeds of which are or will be used to provide an output facility")
rule RefundingTreatedAsPrivateActivityBondForVolumeCap(issue: BondIssue) strict {
    label en official "section 1313(b)(5)";
    when transition_basis_1986(issue, AdvanceRefunding1313b);
    when refunds_output_facility_issue_1313b5(issue);
    then refunding_treated_as_private_activity_bond_1313b5(issue);
}

// =====================================================================
// §1313(c): refundings of certain IDBs and 501(c)(3) bonds; (d) targeting
// =====================================================================

relation refunding_small_issue_facts_1313c1(issue: BondIssue, average_maturity_not_later_than_refunded: Boolean, amount: Money, outstanding_refunded_amount: Money, redeemed_within_90_days_of_issuance: Boolean) kind empirical {
    label en official "the average maturity date of the refunding issue is not later than that of the bonds refunded (section 147(b)(2)(A)), the amount of the refunding bond and the outstanding amount of the refunded bond, and whether the net proceeds redeem the refunded bond within 90 days after the refunding bond is issued";
}
relation refunded_bond_outside_144a10_1313c1(issue: BondIssue) kind empirical {
    label en official "the refunded tax-exempt bond is one to which section 144(a)(10) and the corresponding provision of prior law did not apply";
}
pub relation section_144a10_not_applicable_to_refunding_1313c1(issue: BondIssue) kind institutional {
    label en official "the $40,000,000 limit of section 144(a)(10) does not apply to the refunding bond";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(1) $40,000,000 limit for certain small issue bonds.—Paragraph (10) of section 144(a) of the 1986 Code shall not apply to any bond (or series of bonds) the proceeds of which are used exclusively to refund a tax-exempt bond")
rule Section144a10NotApplicableToRefunding(issue: BondIssue, amount: Money, outstanding: Money) strict {
    label en official "section 1313(c)(1)(A)-(C)";
    when refunded_bond_outside_144a10_1313c1(issue);
    when refunding_small_issue_facts_1313c1(issue, true, amount, outstanding, true);
    when amount <= outstanding;
    then section_144a10_not_applicable_to_refunding_1313c1(issue);
}
rule BasisSmallIssueRefunding(issue: BondIssue) strict {
    label en official "section 1313(c)(1)";
    when section_144a10_not_applicable_to_refunding_1313c1(issue);
    then transition_basis_1986(issue, SmallIssueRefunding1313c);
}
relation refunding_501c3_maturity_facts_1313c2(issue: BondIssue, average_maturity_years: Decimal, average_economic_life_years: Decimal, maturity_date: Date, later_of_17_years_after_qualified_bond_issue: Date) kind empirical {
    label en official "the average maturity and average economic life (section 147(b)), the maturity date of the refunding bond, and the later of the date 17 years after the qualified bond was issued";
}
relation refunded_bond_outside_145b_1313c2(issue: BondIssue) kind empirical {
    label en official "the refunded tax-exempt bond is one to which section 145(b) did not apply";
}
pub relation section_145b_not_applicable_to_refunding_1313c2(issue: BondIssue) kind institutional {
    label en official "the $150,000,000 limitation of section 145(b) does not apply to the refunding bond";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(2) $150,000,000 limitation for certain 501(c)(3) bonds.—Subsection (b) of section 145 of the 1986 Code (relating to $150,000,000 limitation for nonhospital bonds) shall not apply to any bond (or series of bonds) the proceeds of which are used exclusively to refund a tax-exempt bond to which such subsection did not apply")
rule Section145bNotApplicableByEconomicLife(issue: BondIssue, amount: Money, outstanding: Money, maturity: Decimal, life: Decimal, matures: Date, later: Date) strict {
    label en official "section 1313(c)(2)(A)(i) and (B)";
    when refunded_bond_outside_145b_1313c2(issue);
    when refunding_501c3_maturity_facts_1313c2(issue, maturity, life, matures, later);
    when maturity <= life * 1.2;
    when refunding_small_issue_facts_1313c1(issue, true, amount, outstanding, true);
    when amount <= outstanding;
    then section_145b_not_applicable_to_refunding_1313c2(issue);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(ii) the refunding bond has a maturity date not later than the later of the date which is 17 years after the date on which the qualified bond (as defined in subsection (a)(2)) was issued, and")
rule Section145bNotApplicableBySeventeenYears(issue: BondIssue, amount: Money, outstanding: Money, maturity: Decimal, life: Decimal, matures: Date, later: Date) strict {
    label en official "section 1313(c)(2)(A)(ii) and (B)";
    when refunded_bond_outside_145b_1313c2(issue);
    when refunding_501c3_maturity_facts_1313c2(issue, maturity, life, matures, later);
    when matures <= later;
    when refunding_small_issue_facts_1313c1(issue, true, amount, outstanding, true);
    when amount <= outstanding;
    then section_145b_not_applicable_to_refunding_1313c2(issue);
}
relation advance_refunding_of_pre_1986_bond_1313c2(issue: BondIssue, refunding_issued_on: Date, refunded_issued_on: Date, is_first_advance_refunding: Boolean) kind empirical {
    label en official "an advance refunding of a bond issued before January 1, 1986, on the date, and whether it is the first advance refunding after March 14, 1986";
}
pub relation first_advance_refunding_after_1986_03_14_1313c2(issue: BondIssue) kind institutional {
    label en official "the first advance refunding after March 14, 1986 of a bond issued before January 1, 1986: section 145(b) does not apply";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "Subsection (b) of section 145 of the 1986 Code shall not apply to the 1st advance refunding after March 14, 1986, of a bond issued before January 1, 1986.")
rule FirstAdvanceRefundingAfterMarch1986(issue: BondIssue, refunding: Date, refunded: Date) strict {
    label en official "section 1313(c)(2) last sentence";
    when advance_refunding_of_pre_1986_bond_1313c2(issue, refunding, refunded, true);
    when refunding > @1986-03-14;
    when refunded < @1986-01-01;
    then first_advance_refunding_after_1986_03_14_1313c2(issue);
}
pub relation bond_counts_for_later_issues_1313c3(issue: BondIssue) kind institutional {
    label en official "a bond to which section 144(a)(10) or 145(b) does not apply by reason of section 1313 is taken into account in determining whether that section applies to any later issue";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(3) Application to later issues.—Any bond to which section 144(a)(10) or 145(b) of the 1986 Code does not apply by reason of this section shall be taken into account in determining whether such section applies to any later issue.")
rule BondCountsForLaterIssues144a10(issue: BondIssue) strict {
    label en official "section 1313(c)(3), section 144(a)(10)";
    when section_144a10_not_applicable_to_refunding_1313c1(issue);
    then bond_counts_for_later_issues_1313c3(issue);
}
rule BondCountsForLaterIssues145b(issue: BondIssue) strict {
    label en official "section 1313(c)(3), section 145(b)";
    when section_145b_not_applicable_to_refunding_1313c2(issue);
    then bond_counts_for_later_issues_1313c3(issue);
}
relation loan_made_more_than_3_years_after_original_issue_1313d(issue: BondIssue, loan_made_on: Date, original_issued_on: Date) kind empirical {
    label en official "the date a loan financed by the bonds is made and the date the original bond was issued";
}
pub relation targeting_rules_apply_to_loan_1313d(issue: BondIssue) kind institutional {
    label en official "the mortgage and student loan targeting rules (section 143(e) and (f), 144(b)(3) and (4)) apply: the loan is made more than 3 years after the original bond was issued";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(d) Mortgage and Student Loan Targeting Rules To Apply to Loans Made More Than 3 Years After the Date of the Original Issue.")
rule TargetingRulesApplyToLateLoans(issue: BondIssue, loan: Date, original: Date) strict {
    label en official "section 1313(d)";
    when loan_made_more_than_3_years_after_original_issue_1313d(issue, loan, original);
    when loan > add_calendar_period(original, 3 calendar_year);
    then targeting_rules_apply_to_loan_1313d(issue);
}

// =====================================================================
// §1314: rules that override the other rules of the subtitle
// =====================================================================

relation first_advance_refunding_of_pre_sep_26_1985_bond_1314a(issue: BondIssue) kind empirical {
    label en official "the bond is the first advance refunding after September 25, 1985 of a bond issued before September 26, 1985";
}
pub relation annuity_contract_is_security_for_103c2_1314a(issue: BondIssue) kind institutional {
    label en official "for a bond issued after September 25, 1985, the reference to securities in section 103(c)(2) of the 1954 Code includes an annuity contract";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(a) Arbitrage Restriction on Investments in Annuities.—In the case of a bond issued after September 25, 1985, section 103(c) of the 1954 Code shall be applied by treating the reference to securities in paragraph (2) thereof as including a reference to an annuity contract.")
rule AnnuityContractIsSecurity(issue: BondIssue, issued: Date) strict {
    label en official "section 1314(a), except the first advance refunding of a bond issued before September 26, 1985";
    when bond_issue_date_1986_transition(issue, issued);
    when issued > @1985-09-25;
    when not_known(first_advance_refunding_of_pre_sep_26_1985_bond_1314a(issue));
    then annuity_contract_is_security_for_103c2_1314a(issue);
}
relation advance_refunding_bond_1314b(issue: BondIssue, issued: Date) kind empirical {
    label en official "the bond is issued on the date to advance refund a bond";
}
pub relation initial_temporary_period_ends_by_1314b(issue: BondIssue, latest_end: Date) kind institutional {
    label en official "the initial temporary period under section 103(c) of the 1954 Code for the proceeds of the advance refunding bond ends not later than 30 days after the date of issue";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(b) Temporary Period for Advance Refundings.—In the case of a bond issued after December 31, 1985, to advance refund a bond, the initial temporary period under section 103(c) of the 1954 Code with respect to the proceeds of the refunding bond shall end not later than 30 days after the date of issue of the refunding bond.")
rule InitialTemporaryPeriodEnds(issue: BondIssue, issued: Date) strict {
    label en official "section 1314(b)";
    when advance_refunding_bond_1314b(issue, issued);
    when issued > @1985-12-31;
    then initial_temporary_period_ends_by_1314b(issue, add_calendar_period(issued, 30 calendar_day));
}
pub relation yield_determined_on_issue_price_1314c(issue: BondIssue) kind institutional {
    label en official "for a bond issued after December 31, 1985 the yield on an issue is determined on the basis of the issue price (sections 1273 and 1274 of the 1986 Code)";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(c) Determination of Yield.—In the case of a bond issued after December 31, 1985, for purposes of section 103(c) of the 1954 Code, the yield on an issue shall be determined on the basis of the issue price (within the meaning of sections 1273 and 1274 of the 1986 Code).")
rule YieldDeterminedOnIssuePrice(issue: BondIssue, issued: Date) strict {
    label en official "section 1314(c)";
    when bond_issue_date_1986_transition(issue, issued);
    when issued > @1985-12-31;
    then yield_determined_on_issue_price_1314c(issue);
}
relation issued_after_3pm_edt_july_17_1986_1314d3A(issue: BondIssue) kind empirical {
    label en official "the bond is issued after 3 p.m. E.D.T. on July 17, 1986 (the time of day is a Boolean fact: the date type carries no time)";
}
relation pool_issue_facts_1314d3(issue: BondIssue, loans_to_unrelated_governmental_units: Boolean, less_than_75_percent_projects_identified: Boolean, less_than_25_percent_committed: Boolean, maturity_over_30_years_with_recycled_principal: Boolean) kind empirical {
    label en official "the issue makes or finances loans to a governmental unit outside the jurisdiction of the issuer (B), less than 75 percent of the proceeds finance identified projects (C), commitments for less than 25 percent of the proceeds exist at issuance (D), a bond matures after 30 years and loan principal is recycled (E)";
}
relation similar_pools_history_1314d3Fi(issue: BondIssue, issued_similar_before_1986: Boolean, face_issued_in_1986: Money, average_annual_face_1983_1985: Money) kind empirical {
    label en official "the issuer issued similar pool issues before 1986, the aggregate face amount issued during 1986, and the average of the annual aggregate face amounts issued during 1983, 1984 or 1985";
}
pub relation similar_pools_exception_1314d3Fi(issue: BondIssue) kind institutional {
    label en official "the issue is not treated as described in (C) or (D): the issuer issued similar pools before 1986 and the 1986 total does not exceed 250 percent of the annual average of 1983, 1984 or 1985";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(i) Exception from subparagraphs (c) and (d) where similar pools issued by issuer.—An issue shall not be treated as described in subparagraph (C) or (D) with respect to any issue to make or finance loans to governmental units if—")
rule SimilarPoolsException(issue: BondIssue, face: Money, average: Money) strict {
    label en official "section 1314(d)(3)(F)(i)(I)-(II): exact cross multiplication, 250 percent";
    when similar_pools_history_1314d3Fi(issue, true, face, average);
    when face * 2 <= average * 5;
    then similar_pools_exception_1314d3Fi(issue);
}
relation issue_offer_and_sale_facts_1314d3Fii(issue: BondIssue, offered_to_public_with_final_offering_materials: Boolean, share_of_bonds_sold_to_public: Decimal) kind empirical {
    label en official "the bonds are offered to the public pursuant to final offering materials, and the share of the bonds sold to the public (a sale to a securities firm, broker or other person acting as an underwriter or wholesaler is not a sale to the public)";
}
pub relation issue_treated_as_issued_1314d3Fii(issue: BondIssue) kind institutional {
    label en official "for section 1314(d)(3)(A) the issue is treated as issued: the bonds are offered to the public and at least 25 percent of them is sold to the public";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(ii) Determination of issuance.—For purposes of subparagraph (A), an issue shall not be treated as issued until—")
rule IssueTreatedAsIssuedForPools(issue: BondIssue, share: Decimal) strict {
    label en official "section 1314(d)(3)(F)(ii)(I)-(II): at least 25 percent";
    when issue_offer_and_sale_facts_1314d3Fii(issue, true, share);
    when share >= 0.25;
    then issue_treated_as_issued_1314d3Fii(issue);
}
pub relation pool_issue_described_1314d3(issue: BondIssue) kind institutional {
    label en official "the issue is described in section 1314(d)(3)(B), (C), (D) or (E) (subject to the exception of (F)(i) for (C) and (D))";
}
rule PoolIssueByUnrelatedLoans(issue: BondIssue) strict {
    label en official "section 1314(d)(3)(B)";
    when pool_issue_facts_1314d3(issue, true, false, false, false);
    then pool_issue_described_1314d3(issue);
}
rule PoolIssueByUnidentifiedProjects(issue: BondIssue) strict {
    label en official "section 1314(d)(3)(C)";
    when pool_issue_facts_1314d3(issue, false, true, false, false);
    when not_known(similar_pools_exception_1314d3Fi(issue));
    then pool_issue_described_1314d3(issue);
}
rule PoolIssueByUncommittedProceeds(issue: BondIssue) strict {
    label en official "section 1314(d)(3)(D)";
    when pool_issue_facts_1314d3(issue, false, false, true, false);
    when not_known(similar_pools_exception_1314d3Fi(issue));
    then pool_issue_described_1314d3(issue);
}
rule PoolIssueByLongMaturity(issue: BondIssue) strict {
    label en official "section 1314(d)(3)(E)";
    when pool_issue_facts_1314d3(issue, false, false, false, true);
    then pool_issue_described_1314d3(issue);
}
pub relation rebate_requirement_applies_1314d(issue: BondIssue) kind institutional {
    label en official "section 148(f) of the 1986 Code is treated as included in section 103 of the 1954 Code for the bond: it is issued after December 31, 1985 (August 31, 1986 for a government bond, 3 p.m. E.D.T. on July 17, 1986 for a government bond of a pool issue)";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(1) In general.—Except as otherwise provided in this subsection, in the case of a bond issued after December 31, 1985, section 103 of the 1954 Code shall be treated as including the requirements of section 148(f) of the 1986 Code in order for section 103(a) of the 1954 Code to apply.")
rule RebateRequirementAppliesOrdinary(issue: BondIssue, issued: Date) strict {
    label en official "section 1314(d)(1): a bond that is not a government bond";
    when bond_issue_date_1986_transition(issue, issued);
    when issued > @1985-12-31;
    when not_known(government_bond_1312c2(issue));
    then rebate_requirement_applies_1314d(issue);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(2) Government bonds.—In the case of a bond described in section 1312(c)(2) (and not described in paragraph (3) of this subsection), paragraph (1) shall be applied by substituting 'August 31, 1986' for 'December 31, 1985'.")
rule RebateRequirementAppliesGovernment(issue: BondIssue, issued: Date) strict {
    label en official "section 1314(d)(2): August 31, 1986 replaces December 31, 1985";
    when bond_issue_date_1986_transition(issue, issued);
    when government_bond_1312c2(issue);
    when issued > @1986-08-31;
    when not_known(pool_issue_described_1314d3(issue));
    then rebate_requirement_applies_1314d(issue);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(A) In general.—In the case of a bond described in section 1312(c)(2) and issued as part of an issue described in subparagraph (B), (C), (D), or (E), paragraph (1) shall be applied by substituting '3 p.m. E.D.T., July 17, 1986' for 'December 31, 1985'.")
rule RebateRequirementAppliesGovernmentPool(issue: BondIssue) strict {
    label en official "section 1314(d)(3)(A): the issue is treated as issued only under (F)(ii); after 3 p.m. E.D.T. on July 17, 1986";
    when government_bond_1312c2(issue);
    when pool_issue_described_1314d3(issue);
    when issue_treated_as_issued_1314d3Fii(issue);
    when issued_after_3pm_edt_july_17_1986_1314d3A(issue);
    then rebate_requirement_applies_1314d(issue);
}
pub relation information_reporting_bars_exemption_1314e(issue: BondIssue) kind institutional {
    label en official "for a bond issued after December 31, 1986 nothing in section 103(a) or any other provision of law exempts interest on the bond unless it satisfies section 149(e); a government bond is not a private activity bond for it";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(e) Information Reporting.—In the case of a bond issued after December 31, 1986, nothing in section 103(a) of the 1986 Code or any other provision of law shall be construed to provide an exemption from Federal income tax for interest on any bond unless such bond satisfies the requirements of section 149(e) of the 1986 Code.")
rule InformationReportingBarsExemption(issue: BondIssue, issued: Date) strict {
    label en official "section 1314(e)";
    when bond_issue_date_1986_transition(issue, issued);
    when issued > @1986-12-31;
    then information_reporting_bars_exemption_1314e(issue);
}
relation issue_in_abusive_advance_refunding_1314f(issue: BondIssue) kind empirical {
    label en official "the issue of which the bond is a part is described in former section 149(d)(4) of the 1986 Code (abusive transactions)";
}
pub relation exemption_denied_abusive_advance_refunding_1314f(issue: BondIssue) kind institutional {
    label en official "nothing in section 103(a) or any other provision of law exempts interest on the bond: it is issued after August 31, 1986 and its issue is an abusive advance refunding";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(f) Abusive Transaction Limitation on Advance Refundings To Apply.—In the case of a bond issued after August 31, 1986, nothing in section 103(a) of the 1986 Code or any other provision of law shall be construed to provide an exemption from Federal income tax for interest on any bond")
rule ExemptionDeniedAbusiveAdvanceRefunding(issue: BondIssue, issued: Date) strict {
    label en official "section 1314(f)";
    when bond_issue_date_1986_transition(issue, issued);
    when issued > @1986-08-31;
    when issue_in_abusive_advance_refunding_1314f(issue);
    then exemption_denied_abusive_advance_refunding_1314f(issue);
}
pub relation policy_statement_not_required_1314g(issue: BondIssue) kind institutional {
    label en official "section 103A(j)(5) of the 1954 Code (policy statement) does not apply to a bond issued after August 15, 1986";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(g) Termination of Mortgage Bond Policy Statement Requirement.—Paragraph (5) of section 103A(j) of the 1954 Code (relating to policy statement) shall not apply to any bond issued after August 15, 1986")
rule PolicyStatementNotRequired(issue: BondIssue, issued: Date) strict {
    label en official "section 1314(g)";
    when bond_issue_date_1986_transition(issue, issued);
    when issued > @1986-08-15;
    then policy_statement_not_required_1314g(issue);
}
relation advance_refunded_by_later_bond_1314h(issue: BondIssue, advance_refunding_issued_on: Date) kind empirical {
    label en official "a bond issued to advance refund the bond (or a bond that is part of a series of refundings of it) is issued on the date";
}
pub relation investment_type_property_is_security_1314h(issue: BondIssue) kind institutional {
    label en official "for a bond issued before August 16, 1986 (September 1, 1986 for a government bond) the reference to securities in section 103(c)(2) of the 1954 Code includes investment-type property, only to decide whether a bond issued after October 16, 1987 to advance refund it is an arbitrage bond";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(h) Arbitrage Restriction on Investments in Investment-Type Property.—In the case of a bond issued before August 16, 1986 (September 1, 1986 in the case of a bond described in section 1312(c)(2))")
rule InvestmentTypePropertyIsSecurity(issue: BondIssue, later: Date) strict {
    label en official "section 1314(h)";
    when issue_before_effective_date_1986(issue);
    when advance_refunded_by_later_bond_1314h(issue, later);
    when later > @1987-10-16;
    then investment_type_property_is_security_1314h(issue);
}

// =====================================================================
// §1315: volume cap
// =====================================================================

relation carryforward_election_before_1985_11_01_1315b(issue: BondIssue, election_made_on: Date) kind empirical {
    label en official "an election under section 103(n)(10) of the 1954 Code (elective carryforward for a specified project) was made on the date for the bonds";
}
relation carryforward_project_excepted_facility_1315b(issue: BondIssue) kind empirical {
    label en official "the carryforward project is a facility to which the amendments of section 1301 do not apply by reason of section 1312 or 1317";
}
pub relation section_146_carryforward_not_recognized_1315a(issue: BondIssue) kind institutional {
    label en official "section 146(f) does not apply to an issuing authority's volume cap under section 103(n) of the 1954 Code, and no carryforward under it is recognized for a bond issued after August 15, 1986";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = partial, quote = "\"(a) In General.—Except as otherwise provided in this section, section 146(f) of the 1986 Code shall not apply with respect to an issuing authority's volume cap under section 103(n) of the 1954 Code")
rule Section146CarryforwardNotRecognized(issue: BondIssue, issued: Date) strict {
    label en official "section 1315(a)";
    when bond_issue_date_1986_transition(issue, issued);
    when issued > @1986-08-15;
    then section_146_carryforward_not_recognized_1315a(issue);
}
pub relation carryforward_project_outside_volume_cap_1315b(issue: BondIssue) kind institutional {
    label en official "the bond is not taken into account under section 146: it was issued under a section 103(n)(10) election made before November 1, 1985 and the carryforward project is an excepted facility";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(b) Certain Bonds for Carryforward Projects Outside of Volume Cap.—Bonds issued pursuant to an election under section 103(n)(10) of the 1954 Code")
rule CarryforwardProjectOutsideVolumeCap(issue: BondIssue, elected: Date) strict {
    label en official "section 1315(b)";
    when carryforward_election_before_1985_11_01_1315b(issue, elected);
    when elected < @1985-11-01;
    when carryforward_project_excepted_facility_1315b(issue);
    then carryforward_project_outside_volume_cap_1315b(issue);
}
relation bond_facility_or_purpose_described_1315d(issue: BondIssue) kind empirical {
    label en official "the bond is issued for a facility or purpose described in a paragraph of section 1315(d) (the paragraph (1) depreciation cases and the paragraph (2) cases of section 1317 are inputs; the named facilities of paragraphs (3)-(6) are in s3-c-tra1986-1316-1317.law)";
}
relation bond_would_not_count_under_103n_1315c(issue: BondIssue, without_carryforward_election: Boolean, with_carryforward_election_before_1986: Boolean) kind empirical {
    label en official "the bond would not have been taken into account under section 103(n) of the 1954 Code for calendar year 1986 were it issued on August 15, 1986: determined without regard to any carryforward election (first flag), or with regard to a carryforward election made before January 1, 1986 (second flag)";
}
pub relation volume_cap_not_applied_1315c(issue: BondIssue) kind institutional {
    label en official "section 146 does not apply to the bond";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(c) Volume Cap Not To Apply With Respect to Certain Facilities and Purposes.—Section 146 of the 1986 Code shall not apply to any bond issued with respect to any facility or purpose described in a paragraph of subsection (d) if—")
rule VolumeCapNotAppliedWithoutCarryforward(issue: BondIssue) strict {
    label en official "section 1315(c)(1), unless section 1313(b)(5) treats the bond as a private activity bond";
    when bond_facility_or_purpose_described_1315d(issue);
    when bond_would_not_count_under_103n_1315c(issue, true, false);
    when not_known(refunding_treated_as_private_activity_bond_1313b5(issue));
    then volume_cap_not_applied_1315c(issue);
}
rule VolumeCapNotAppliedWithCarryforward(issue: BondIssue) strict {
    label en official "section 1315(c)(2), unless section 1313(b)(5) treats the bond as a private activity bond";
    when bond_facility_or_purpose_described_1315d(issue);
    when bond_would_not_count_under_103n_1315c(issue, false, true);
    when not_known(refunding_treated_as_private_activity_bond_1313b5(issue));
    then volume_cap_not_applied_1315c(issue);
}
relation bond_is_1317_6_redevelopment_bond_1315e(issue: BondIssue) kind empirical {
    label en official "the bond is one to which section 1317(6) applies";
}
relation bond_would_be_idb_if_issued_1986_08_15_1315e(issue: BondIssue) kind empirical {
    label en official "the bond, if issued on August 15, 1986, would have been an industrial development bond (section 103(b)(2) of the 1954 Code)";
}
pub relation redevelopment_bond_treated_as_1315c1_1315e(issue: BondIssue) kind institutional {
    label en official "a bond to which section 1317(6) applies is treated for section 1315 as described in subsection (c)(1), unless it would have been an industrial development bond";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(e) Treatment of Redevelopment Bonds.—Any bond to which section 1317(6) of this Act applies shall be treated for purposes of this section as described in subsection (c)(1).")
rule RedevelopmentBondTreatedAsC1(issue: BondIssue) strict {
    label en official "section 1315(e)";
    when bond_is_1317_6_redevelopment_bond_1315e(issue);
    when not_known(bond_would_be_idb_if_issued_1986_08_15_1315e(issue));
    then redevelopment_bond_treated_as_1315c1_1315e(issue);
}

// =====================================================================
// §1318: definitions and supplementary rules
// =====================================================================

relation refunding_and_redemption_dates_1318a4(issue: BondIssue, issued_on: Date, refunded_redeemed_on: Date) kind empirical {
    label en official "the date the refunding bond is issued and the date the refunded bond is redeemed";
}
pub relation issued_to_advance_refund_1318a4(issue: BondIssue) kind institutional {
    label en official "the bond is treated as issued to advance refund another bond: it is issued more than 90 days before the redemption of the refunded bond";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(4) Advance refund.—A bond shall be treated as issued to advance refund another bond if it is issued more than 90 days before the redemption of the refunded bond.")
rule IssuedToAdvanceRefund(issue: BondIssue, issued: Date, redeemed: Date) strict {
    label en official "section 1318(a)(4): strictly more than 90 days";
    when refunding_and_redemption_dates_1318a4(issue, issued, redeemed);
    when add_calendar_period(issued, 90 calendar_day) < redeemed;
    then issued_to_advance_refund_1318a4(issue);
}
relation bond_has_1954_code_failure_1318a6(issue: BondIssue) kind empirical {
    label en official "the bond fails a provision of the 1954 Code (as in effect on October 21, 1986) or a requirement the transitional rules read into it: the transitional delay or exemption does not exempt the bond from the provision (section 1318(a)(6))";
}
pub relation bond_transition_status_fails_1954_code_1318a6(issue: BondIssue) kind institutional {
    label en official "the delay in (or exemption from) the amendments does not exempt the bond from a provision of the 1954 Code that it fails";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(6) Continued application of the 1954 code.—Nothing in this subtitle shall be construed to exempt any bond from any provision of the 1954 Code by reason of a delay in (or exemption from) the application of any amendment made by subtitle A")
rule TransitionDoesNotExemptFrom1954Code(issue: BondIssue) strict {
    label en official "section 1318(a)(6)";
    when bond_excepted_from_1986_amendments(issue);
    when bond_has_1954_code_failure_1318a6(issue);
    then bond_transition_status_fails_1954_code_1318a6(issue);
}
relation bond_treated_as_exempt_facility_by_1316_or_1317_1318a7(issue: BondIssue) kind empirical {
    label en official "the bond is treated as an exempt facility bond by section 1316 or 1317";
}
pub relation exempt_facility_treatment_survives_142b_1318a7(issue: BondIssue) kind institutional {
    label en official "the bond does not fail to be treated as an exempt facility bond by reason of section 142(b) of the 1986 Code";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(7) Treatment as exempt facility.—Any bond which is treated as an exempt facility bond by section 1316 or 1317 shall not fail to be so treated by reason of subsection (b) of section 142 of the 1986 Code.")
rule ExemptFacilityTreatmentSurvives142b(issue: BondIssue) strict {
    label en official "section 1318(a)(7)";
    when bond_treated_as_exempt_facility_by_1316_or_1317_1318a7(issue);
    then exempt_facility_treatment_survives_142b_1318a7(issue);
}
relation later_law_facts_1318a8(issue: BondIssue, law_enacted_after_1986_10_22: Boolean, law_expressly_excludes_the_bond: Boolean, provision_has_no_corresponding_1954_provision: Boolean, provision_otherwise_included_for_the_bond: Boolean) kind empirical {
    label en official "an amendment of the 1986 Code in a law enacted after October 22, 1986: whether the law expressly provides that it does not apply to the bond, whether the amended provision has no corresponding provision in sections 103 and 103A of the 1954 Code, and whether it is otherwise treated as included in those sections for the bond";
}
pub relation later_amendment_treated_as_included_1318a8(issue: BondIssue) kind institutional {
    label en official "the amendment of the 1986 Code enacted after October 22, 1986 is treated as included in section 103 or 103A of the 1954 Code for the transitioned bond";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(8) Application of future legislation to transitioned bonds.—In the case of any bond to which the amendments made by section 1301")
rule LaterAmendmentTreatedAsIncluded(issue: BondIssue, otherwise_included: Boolean) strict {
    label en official "section 1318(a)(8): included unless (A) the law expressly excludes the bond, or (B) the provision has no 1954 counterpart and is not otherwise included; here the provision has a 1954 counterpart";
    when bond_excepted_from_1986_amendments(issue);
    when later_law_facts_1318a8(issue, true, false, false, otherwise_included);
    then later_amendment_treated_as_included_1318a8(issue);
}
rule LaterAmendmentTreatedAsIncludedOtherwise(issue: BondIssue) strict {
    label en official "section 1318(a)(8)(B): a provision without a 1954 counterpart that is otherwise treated as included in sections 103 and 103A for the bond";
    when bond_excepted_from_1986_amendments(issue);
    when later_law_facts_1318a8(issue, true, false, true, true);
    then later_amendment_treated_as_included_1318a8(issue);
}
relation bond_described_1318b2(issue: BondIssue, excepted_by_1312_or_1316g: Boolean, section_1317_applies: Boolean, refunding_of_such_bond_meeting_1318c: Boolean) kind empirical {
    label en official "the bond is one to which the amendments of section 1301 do not apply by reason of section 1312 or 1316(g) (A), to which a provision of section 1317 applies (B), or refunds such a bond meeting the requirements of subsection (c) (C)";
}
relation bond_would_be_idb_or_private_loan_if_issued_1986_08_07_1318b1(issue: BondIssue) kind empirical {
    label en official "the bond, if issued on August 7, 1986, would be an industrial development bond (section 103(b)(2) of the 1954 Code) or a private loan bond (section 103(o)(2)(A), without regard to any exception other than 103(o)(2)(C))";
}
pub relation not_private_activity_bond_for_minimum_tax_1318b(issue: BondIssue) kind institutional {
    label en official "the bond is not treated as a private activity bond for purposes of section 57 of the 1986 Code";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(1) In general.—Any bond described in paragraph (2) shall not be treated as a private activity bond for purposes of section 57 of the 1986 Code unless such bond would (if issued on August 7, 1986) be—")
rule NotPrivateActivityBondForMinimumTaxA(issue: BondIssue) strict {
    label en official "section 1318(b)(1)-(2)(A)";
    when bond_described_1318b2(issue, true, false, false);
    when not_known(bond_would_be_idb_or_private_loan_if_issued_1986_08_07_1318b1(issue));
    then not_private_activity_bond_for_minimum_tax_1318b(issue);
}
rule NotPrivateActivityBondForMinimumTaxB(issue: BondIssue) strict {
    label en official "section 1318(b)(1)-(2)(B)";
    when bond_described_1318b2(issue, false, true, false);
    when not_known(bond_would_be_idb_or_private_loan_if_issued_1986_08_07_1318b1(issue));
    then not_private_activity_bond_for_minimum_tax_1318b(issue);
}
rule NotPrivateActivityBondForMinimumTaxC(issue: BondIssue) strict {
    label en official "section 1318(b)(1)-(2)(C)";
    when bond_described_1318b2(issue, false, false, true);
    when not_known(bond_would_be_idb_or_private_loan_if_issued_1986_08_07_1318b1(issue));
    then not_private_activity_bond_for_minimum_tax_1318b(issue);
}
relation refunding_aggregate_facts_1318c(issue: BondIssue, average_maturity_not_later_than_refunded: Boolean, amount: Money, outstanding_refunded_amount: Money, redeemed_within_90_days: Boolean) kind empirical {
    label en official "the average maturity date of the refunding issue is not later than that of the refunded issue (section 147(b)(2)(A)), the amount of the refunding bond and the outstanding amount of the refunded bond, and whether the net proceeds redeem the refunded bond within 90 days";
}
pub relation refunding_not_counted_against_transition_limit_1318c(issue: BondIssue) kind institutional {
    label en official "the face amount of the refunding bond does not reduce the aggregate limit on bonds to which section 1316(g) or 1317 applies, and no limit on the period of issue applies to it";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(c) Current Refundings Not Taken Into Account in Applying Aggregate Limit on Bonds to Which Transitional Rules Apply.")
rule RefundingNotCountedAgainstTransitionLimit(issue: BondIssue, amount: Money, outstanding: Money) strict {
    label en official "section 1318(c)(1)-(3)";
    when refunding_aggregate_facts_1318c(issue, true, amount, outstanding, true);
    when amount <= outstanding;
    then refunding_not_counted_against_transition_limit_1318c(issue);
}
relation project_identified_with_reasonable_specificity_1318d(issue: BondIssue) kind empirical {
    label en official "the project financed by the bond is identified with reasonable specificity";
}
relation bond_is_qualified_small_issue_bond_1318d(issue: BondIssue) kind empirical {
    label en official "the bond is a qualified small issue bond";
}
pub relation transitioned_bond_carryforward_permitted_1318d(issue: BondIssue) kind institutional {
    label en official "a bond to which section 1312 or 1317 applies has a carryforward purpose under section 146(f)(5) and satisfies section 146(f)(2)(A) when its project is identified with reasonable specificity; not for a qualified small issue bond";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(d) Special Rule Permitting Carryforward of Volume Cap for Certain Transitioned Projects.—A bond to which section 1312 or 1317 applies shall be treated as having a carryforward purpose described in section 146(f)(5) of the 1986 Code")
rule TransitionedBondCarryforwardPermittedBy1312(issue: BondIssue) strict {
    label en official "section 1318(d), section 1312 bond";
    when bond_excepted_1312a(issue);
    when project_identified_with_reasonable_specificity_1318d(issue);
    when not_known(bond_is_qualified_small_issue_bond_1318d(issue));
    then transitioned_bond_carryforward_permitted_1318d(issue);
}
rule TransitionedBondCarryforwardPermittedBy1317(issue: BondIssue) strict {
    label en official "section 1318(d), section 1317 bond";
    when transition_basis_1986(issue, NamedException1317);
    when project_identified_with_reasonable_specificity_1318d(issue);
    when not_known(bond_is_qualified_small_issue_bond_1318d(issue));
    then transitioned_bond_carryforward_permitted_1318d(issue);
}

// =====================================================================
// the interest exclusion of a grandfathered bond
// =====================================================================

relation bond_interest_amount_transition_1986(p: Individual, y: TaxableYear, bond: us.irc.core::Asset, amount: Money) kind empirical {
    label en official "interest on the transitioned bond received or accrued by the taxpayer in the year";
}
pub relation grandfathered_bond_interest_excluded_103a(p: Individual, y: TaxableYear, bond: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "interest on a State or local bond that the amendments of section 1301 do not reach is excluded from gross income under section 103(a) unless the bond fails a provision of the 1954 Code (or of a requirement the transitional rules read into it)";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = partial, quote = "\"(6) Continued application of the 1954 code.—Nothing in this subtitle shall be construed to exempt any bond from any provision of the 1954 Code")
rule GrandfatheredBondInterestExcluded(p: Individual, y: TaxableYear, bond: us.irc.core::Asset, issue: BondIssue, amount: Money) strict {
    label en official "sections 1311-1317 with 1318(a)(6): the 1954 Code regime governs the grandfathered bond";
    when bond_interest_amount_transition_1986(p, y, bond, amount);
    when state_or_local_bond(bond);
    when bond_part_of_issue(bond, issue);
    when bond_excepted_from_1986_amendments(issue);
    when not_known(bond_transition_status_fails_1954_code_1318a6(issue));
    then grandfathered_bond_interest_excluded_103a(p, y, bond, amount);
}
rule GrandfatheredBondInterestExcludedAs103a(p: Individual, y: TaxableYear, bond: us.irc.core::Asset, amount: Money) strict {
    label en official "section 103(a) for a grandfathered bond: the same conclusion as the ordinary rule";
    when grandfathered_bond_interest_excluded_103a(p, y, bond, amount);
    then state_or_local_bond_interest_excluded_103a(p, y, bond, amount);
}

rule RefundingGovernmentCurrentArbitrageAsGovernmental(issue: BondIssue) strict {
    label en official "section 1313(a)(4)(C): a current refunding government bond is not a private activity bond for the arbitrage requirement of (3)(C)";
    when transition_basis_1986(issue, CurrentRefunding1313a);
    when government_bond_1312c2(issue);
    then requirement_applied_as_governmental_1986(issue, Section143gAnd148Arbitrage);
}
rule RefundingGovernmentCurrentReportingAsGovernmental(issue: BondIssue) strict {
    label en official "section 1313(a)(4)(C): a current refunding government bond is not a private activity bond for the reporting requirement of (3)(D)";
    when transition_basis_1986(issue, CurrentRefunding1313a);
    when government_bond_1312c2(issue);
    then requirement_applied_as_governmental_1986(issue, Section149eInformationReporting);
}
rule RefundingGovernmentAdvanceArbitrageAsGovernmental(issue: BondIssue) strict {
    label en official "section 1313(b)(4)(C): an advance refunding government bond is not a private activity bond for the arbitrage requirement of (3)(C)";
    when transition_basis_1986(issue, AdvanceRefunding1313b);
    when government_bond_1312c2(issue);
    then requirement_applied_as_governmental_1986(issue, Section148Arbitrage);
}
rule RefundingGovernmentAdvanceReportingAsGovernmental(issue: BondIssue) strict {
    label en official "section 1313(b)(4)(C): an advance refunding government bond is not a private activity bond for the reporting requirement of (3)(E)";
    when transition_basis_1986(issue, AdvanceRefunding1313b);
    when government_bond_1312c2(issue);
    then requirement_applied_as_governmental_1986(issue, Section149eInformationReporting);
}
