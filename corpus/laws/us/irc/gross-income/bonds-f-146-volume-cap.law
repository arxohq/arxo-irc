// Stage 2f (TECH_GAP reduction) — private activity bonds, sixth part: §146(a)-(n), the volume cap.
// STATUS: implemented_unverified (static check only; scenarios in tests/bonds-f-146.lawtest
// are NOT executed).
//
// The indexed dollar amounts of §146(d)(2) are computed from the cost-of-living ratio which the
// case supplies as an input factor (the §1(f)(3) computation lives in another package); the
// rounding to a multiple of $5 (or $5,000) is HALF_UP by judgment call (the statute says
// "nearest multiple" and is silent on the exact half).

use self::{
    BondIssue,
    IRC_S146_A,
    IRC_S146_B,
    IRC_S146_C,
    IRC_S146_D,
    IRC_S146_E,
    IRC_S146_F,
    IRC_S146_G,
    IRC_S146_H,
    IRC_S146_I,
    IRC_S146_K,
    IRC_S146_L,
    IRC_S146_M,
    Person,
};

relation state_population_146d(state: Person, year: Integer, population: Integer) kind empirical {
    label en official "the State population for the calendar year (section 146(j): the most recent census estimate of resident population released before the beginning of the calendar year, taken as input)";
}
relation cola_ratio_146d2(year: Integer, ratio: Decimal) kind empirical {
    label en official "the cost-of-living adjustment determined under section 1(f)(3) for the calendar year with 2001 substituted for 2016 in subparagraph (A)(ii), as a decimal ratio (for example 0.35 for 35 percent); the computation itself is left to the input";
}
pub relation per_capita_amount_146d(year: Integer, amount: Money) kind institutional {
    label en official "the per capita dollar amount of section 146(d)(1)(A) for the calendar year, indexed after 2002 by (d)(2), rounded to the nearest multiple of $5";
}
@source(IRC_S146_D, relation = formalizes, coverage = exact, quote = "(A) an amount equal to $75 ($62.50 in the case of calendar year 2001) multiplied by the State population, or")
rule PerCapitaAmount2001(year: Integer) strict {
    label en official "section 146(d)(1)(A): $62.50 for calendar year 2001";
    when year_of_146(year);
    when year == 2001;
    then per_capita_amount_146d(year, 62.50 USD);
}
relation year_of_146(year: Integer) kind empirical {
    label en official "the calendar year under consideration";
}
@source(IRC_S146_D, relation = formalizes, coverage = exact, quote = "(A) an amount equal to $75 ($62.50 in the case of calendar year 2001) multiplied by the State population, or")
rule PerCapitaAmountUpToNo2002Indexing(year: Integer) strict {
    label en official "section 146(d)(1)(A): $75 for a calendar year other than 2001 not after 2002";
    when year_of_146(year);
    when year != 2001;
    when year <= 2002;
    then per_capita_amount_146d(year, 75.00 USD);
}
@source(IRC_S146_D, relation = formalizes, coverage = exact, quote = "In the case of a calendar year after 2002, each of the dollar amounts contained in paragraph (1) shall be increased by an amount equal to—")
rule PerCapitaAmountIndexed(year: Integer, ratio: Decimal) strict {
    label en official "section 146(d)(2): $75 plus the increase (75 x the ratio), the increase rounded to the nearest multiple of $5";
    when year_of_146(year);
    when year > 2002;
    when cola_ratio_146d2(year, ratio);
    then per_capita_amount_146d(year, 75.00 USD + round(75.00 * ratio / 5.0, 0, "HALF_UP") * 5.00 USD);
}
pub relation flat_amount_146d(year: Integer, amount: Money) kind institutional {
    label en official "the flat dollar amount of section 146(d)(1)(B) for the calendar year: $225,000,000 ($187,500,000 for 2001), indexed after 2002, the increase rounded to the nearest multiple of $5,000";
}
@source(IRC_S146_D, relation = formalizes, coverage = exact, quote = "(B) $225,000,000 ($187,500,000 in the case of calendar year 2001).")
rule FlatAmount2001(year: Integer) strict {
    label en official "section 146(d)(1)(B): $187,500,000 for calendar year 2001";
    when year_of_146(year);
    when year == 2001;
    then flat_amount_146d(year, 187500000.00 USD);
}
@source(IRC_S146_D, relation = formalizes, coverage = exact, quote = "(B) $225,000,000 ($187,500,000 in the case of calendar year 2001).")
rule FlatAmountUpTo2002(year: Integer) strict {
    label en official "section 146(d)(1)(B): $225,000,000 for a calendar year other than 2001 not after 2002";
    when year_of_146(year);
    when year != 2001;
    when year <= 2002;
    then flat_amount_146d(year, 225000000.00 USD);
}
@source(IRC_S146_D, relation = formalizes, coverage = exact, quote = "If any increase determined under the preceding sentence is not a multiple of $5 ($5,000 in the case of the dollar amount in paragraph (1)(B)), such increase shall be")
rule FlatAmountIndexed(year: Integer, ratio: Decimal) strict {
    label en official "section 146(d)(2), last sentence: increase rounded to the nearest multiple of $5,000";
    when year_of_146(year);
    when year > 2002;
    when cola_ratio_146d2(year, ratio);
    then flat_amount_146d(year, 225000000.00 USD + round(225000000.0 * ratio / 5000.0, 0, "HALF_UP") * 5000.00 USD);
}
pub relation state_ceiling_before_adjustments_146d1(state: Person, year: Integer, amount: Money) kind institutional {
    label en official "the State ceiling for the calendar year: the greater of the per capita amount times the State population and the flat amount (before the possession minimum of (d)(4), the 2008 increase of (d)(5) and the home rule reduction of (d)(3)(B))";
}
@source(IRC_S146_D, relation = formalizes, coverage = exact, quote = "The State ceiling applicable to any State for any calendar year shall be the greater of—")
rule StateCeilingBeforeAdjustments(state: Person, year: Integer, pop: Integer, per: Money, flat: Money) strict {
    label en official "section 146(d)(1): the greater of (A) and (B)";
    when state_population_146d(state, year, pop);
    when per_capita_amount_146d(year, per);
    when flat_amount_146d(year, flat);
    then state_ceiling_before_adjustments_146d1(state, year, max(round(per * pop, 2, "HALF_UP"), flat));
}
relation possession_and_least_populous_state_146d4(possession: Person, year: Integer, possession_population: Integer, least_populous_state_population: Integer) kind empirical {
    label en official "a possession of the United States whose population is below that of the least populous State (other than a possession), with both populations for the calendar year";
}
pub relation possession_ceiling_146d4(possession: Person, year: Integer, amount: Money) kind institutional {
    label en official "the possession's limitation under paragraph (1)(A) is not less than flat amount / least populous State population x the possession's population";
}
@source(IRC_S146_D, relation = formalizes, coverage = exact, quote = "The limitation determined under this subparagraph, with respect to a possession, for any calendar year is an amount equal to the product of—")
rule PossessionMinimumCeiling(possession: Person, year: Integer, ppop: Integer, lpop: Integer, flat: Money) strict {
    label en official "section 146(d)(4)(A)-(B): the (B) amount, rounded once to cents HALF_UP";
    when possession_and_least_populous_state_146d4(possession, year, ppop, lpop);
    when ppop < lpop;
    when lpop > 0;
    when flat_amount_146d(year, flat);
    then possession_ceiling_146d4(possession, year, div_round(flat * ppop, lpop * 1.0, 2, "HALF_UP"));
}
relation ceiling_2008_facts_146d5A(state: Person, ceiling_2008_before_increase: Money, sum_of_all_states_ceilings_2008: Money) kind empirical {
    label en official "the State ceiling for calendar year 2008 determined without regard to paragraph (5), and the sum of those ceilings for all States";
}
pub relation state_ceiling_increase_2008_146d5A(state: Person, amount: Money) kind institutional {
    label en official "the 2008 increase: $11,000,000,000 x the State's ceiling / the sum of ceilings of all States";
}
@source(IRC_S146_D, relation = formalizes, coverage = exact, quote = "In the case of calendar year 2008, the State ceiling for each State shall be increased by an amount equal to $11,000,000,000 multiplied by a fraction—")
rule StateCeilingIncrease2008(state: Person, own: Money, total: Money) strict {
    label en official "section 146(d)(5)(A)(i)-(ii)";
    when ceiling_2008_facts_146d5A(state, own, total);
    when total > 0.00 USD;
    then state_ceiling_increase_2008_146d5A(state, div_round(11000000000.00 USD * (own / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}
pub relation qualified_housing_issue_146d5Bii(issue: BondIssue) kind institutional {
    label en official "a qualified housing issue: a qualified residential rental project issue under section 142(a)(7), or a qualified mortgage issue (with the 12-month period substituted in section 143(a)(2)(D)(i))";
}
relation qualified_mortgage_issue_with_12_month_period_146d5Bii(issue: BondIssue) kind empirical {
    label en official "the issue is a qualified mortgage issue determined with '12-month period' in place of '42-month period' in section 143(a)(2)(D)(i)";
}
relation residential_rental_project_issue_146d5Bii(issue: BondIssue) kind empirical {
    label en official "the issue is described in section 142(a)(7)";
}
@source(IRC_S146_D, relation = formalizes, coverage = exact, quote = "(I) an issue described in section 142(a)(7) (relating to qualified residential rental projects), or")
rule QualifiedHousingIssueRental(issue: BondIssue) strict {
    label en official "section 146(d)(5)(B)(ii)(I)";
    when residential_rental_project_issue_146d5Bii(issue);
    then qualified_housing_issue_146d5Bii(issue);
}
@source(IRC_S146_D, relation = formalizes, coverage = exact, quote = "(II) a qualified mortgage issue (determined by substituting \"12-month period\" for \"42-month period\" each place it appears in section 143(a)(2)(D)(i)).")
rule QualifiedHousingIssueMortgage(issue: BondIssue) strict {
    label en official "section 146(d)(5)(B)(ii)(II)";
    when qualified_mortgage_issue_with_12_month_period_146d5Bii(issue);
    then qualified_housing_issue_146d5Bii(issue);
}
relation use_of_2008_increase_146f6(issue: BondIssue, amount_attributable_to_2008_increase: Money, bond_issued_year: Integer) kind empirical {
    label en official "the amount of the issue's volume cap attributable to the 2008 increase under subsection (d)(5), and the calendar year in which the bond is issued";
}
pub relation use_of_2008_increase_barred_146f6(issue: BondIssue) kind institutional {
    label en official "no amount attributable to the increase under (d)(5) may be used for an issue other than a qualified housing issue, or to issue any bond after calendar year 2010";
}
@source(IRC_S146_F, relation = formalizes, coverage = exact, quote = "No amount which is attributable to the increase under subsection (d)(5) may be used—")
rule Use2008IncreaseBarredOutsideHousing(issue: BondIssue, amount: Money, year: Integer) strict {
    label en official "section 146(f)(6)(A)";
    when use_of_2008_increase_146f6(issue, amount, year);
    when amount > 0.00 USD;
    when not_known(qualified_housing_issue_146d5Bii(issue));
    then use_of_2008_increase_barred_146f6(issue);
}
@source(IRC_S146_F, relation = formalizes, coverage = exact, quote = "(B) to issue any bond after calendar year 2010.")
rule Use2008IncreaseBarredAfter2010(issue: BondIssue, amount: Money, year: Integer) strict {
    label en official "section 146(f)(6)(B)";
    when use_of_2008_increase_146f6(issue, amount, year);
    when amount > 0.00 USD;
    when year > 2010;
    then use_of_2008_increase_barred_146f6(issue);
}

// (b), (c), (d)(3): agency caps, population shares, home rule cities
relation state_ceiling_for_allocation_146(state: Person, year: Integer, ceiling: Money) kind empirical {
    label en official "the State ceiling for the calendar year after paragraphs (4) and (5) of subsection (d), taken as input";
}
relation home_rule_city_146d3C(city: Person, state: Person, year: Integer) kind empirical {
    label en official "a political subdivision of the State which, under a State constitution adopted in 1970 and effective on July 1, 1971, had home rule powers on the 1st day of the calendar year (constitutional home rule city)";
}
relation issuing_authority_146(authority: Person, state: Person, year: Integer, population: Integer, state_population: Integer) kind empirical {
    label en official "an issuing authority other than a State agency, its State, the calendar year, the population of its jurisdiction and the population of the entire State";
}
relation state_agency_issuer_146b(authority: Person, state: Person, year: Integer) kind empirical {
    label en official "the authority is an agency of the State authorized to issue tax-exempt private activity bonds (with more than one such agency, all are treated as a single agency, section 146(b)(2): the input names one agency for the group)";
}
pub relation volume_cap_before_reductions_146(authority: Person, year: Integer, amount: Money) kind institutional {
    label en official "the volume cap of the issuing authority for the calendar year before the reductions of subsections (m)(1) and (n)";
}
@source(IRC_S146_B, relation = formalizes, coverage = exact, quote = "The volume cap for any agency of the State authorized to issue tax-exempt private activity bonds for any calendar year shall be 50 percent of the State ceiling for such")
rule StateAgencyVolumeCap(authority: Person, state: Person, year: Integer, ceiling: Money) strict {
    label en official "section 146(b)(1): 50 percent of the State ceiling";
    when state_agency_issuer_146b(authority, state, year);
    when state_ceiling_for_allocation_146(state, year, ceiling);
    then volume_cap_before_reductions_146(authority, year, round(ceiling * 0.50, 2, "HALF_UP"));
}
pub relation home_rule_volume_cap_146d3A(authority: Person, year: Integer, amount: Money) kind institutional {
    label en official "the volume cap of a constitutional home rule city: section 146(c)(1) with 100 percent substituted for 50 percent";
}
@source(IRC_S146_D, relation = formalizes, coverage = exact, quote = "The volume cap for any constitutional home rule city for any calendar year shall be determined under paragraph (1) of subsection (c) by substituting \"100 percent\" for")
rule HomeRuleCityVolumeCap(authority: Person, state: Person, year: Integer, pop: Integer, spop: Integer, ceiling: Money) strict {
    label en official "section 146(d)(3)(A), with (c)(1): the State ceiling x population ratio, rounded once to cents HALF_UP";
    when home_rule_city_146d3C(authority, state, year);
    when issuing_authority_146(authority, state, year, pop, spop);
    when state_ceiling_for_allocation_146(state, year, ceiling);
    when spop > 0;
    then home_rule_volume_cap_146d3A(authority, year, div_round(ceiling * pop, spop * 1.0, 2, "HALF_UP"));
}
relation home_rule_caps_total_146d3B(state: Person, year: Integer, total: Money) kind empirical {
    label en official "the aggregate volume caps of the constitutional home rule cities of the State for the calendar year (sum of the derived home rule caps, supplied by the case, since an aggregate over a derived relation is not expressible)";
}
pub relation state_ceiling_for_other_authorities_146d3B(state: Person, year: Integer, amount: Money) kind institutional {
    label en official "the State ceiling for applying subsections (b) and (c) to issuing authorities other than constitutional home rule cities: reduced by the aggregate volume caps of the home rule cities";
}
@source(IRC_S146_D, relation = formalizes, coverage = exact, quote = "In the case of any State which contains 1 or more constitutional home rule cities, for purposes of applying subsections (b) and (c) with respect to issuing authorities")
rule StateCeilingReducedForHomeRule(state: Person, year: Integer, ceiling: Money, caps: Money) strict {
    label en official "section 146(d)(3)(B)";
    when state_ceiling_for_allocation_146(state, year, ceiling);
    when home_rule_caps_total_146d3B(state, year, caps);
    then state_ceiling_for_other_authorities_146d3B(state, year, max(0.00 USD, ceiling - caps));
}
@source(IRC_S146_C, relation = formalizes, coverage = exact, quote = "The volume cap for any issuing authority (other than a State agency) for any calendar year shall be an amount which bears the same ratio to 50 percent of the State")
rule LocalAuthorityVolumeCap(authority: Person, state: Person, year: Integer, pop: Integer, spop: Integer, ceiling: Money) strict {
    label en official "section 146(c)(1)(A)-(B): 50 percent of the (reduced) State ceiling x the population ratio, one rounding HALF_UP; a home rule city is under (d)(3)(A) instead";
    when issuing_authority_146(authority, state, year, pop, spop);
    when state_ceiling_for_other_authorities_146d3B(state, year, ceiling);
    when spop > 0;
    when not_known(home_rule_city_146d3C(authority, state, year));
    when not_known(state_agency_issuer_146b(authority, state, year));
    then volume_cap_before_reductions_146(authority, year, div_round(ceiling * 0.50 * pop, spop * 1.0, 2, "HALF_UP"));
}
@source(IRC_S146_D, relation = formalizes, coverage = exact, quote = "The volume cap for any constitutional home rule city for any calendar year shall be determined under paragraph (1) of subsection (c) by substituting \"100 percent\" for")
rule HomeRuleCapIsTheVolumeCap(authority: Person, year: Integer, amount: Money) strict {
    label en official "section 146(d)(3)(A)";
    when home_rule_volume_cap_146d3A(authority, year, amount);
    then volume_cap_before_reductions_146(authority, year, amount);
}
relation area_in_two_jurisdictions_146c2(area: Person, unit_smallest: Person, other_unit: Person, other_unit_surrenders_jurisdiction: Boolean) kind empirical {
    label en official "an area within the jurisdiction of 2 or more governmental units, the unit having jurisdiction over the smallest geographical area, another unit, and whether the smallest unit agrees to surrender all or part of its jurisdiction to the other (in which case the area is treated as within the other's jurisdiction)";
}
pub relation area_treated_as_within_jurisdiction_of_146c2(area: Person, unit: Person) kind institutional {
    label en official "the area is treated as within only this unit's jurisdiction for the population count";
}
@source(IRC_S146_C, relation = formalizes, coverage = exact, quote = "For purposes of paragraph (1)(A), if an area is within the jurisdiction of 2 or more governmental units, such area shall be treated as only within the jurisdiction of")
rule AreaTreatedAsWithinTheSmallestUnit(area: Person, smallest: Person, other: Person) strict {
    label en official "section 146(c)(2), general rule";
    when area_in_two_jurisdictions_146c2(area, smallest, other, false);
    then area_treated_as_within_jurisdiction_of_146c2(area, smallest);
}
@source(IRC_S146_C, relation = formalizes, coverage = exact, quote = "For purposes of paragraph (1)(A), if an area is within the jurisdiction of 2 or more governmental units, such area shall be treated as only within the jurisdiction of")
rule AreaTreatedAsWithinTheOtherUnitOnSurrender(area: Person, smallest: Person, other: Person) strict {
    label en official "section 146(c)(2), surrender exception";
    when area_in_two_jurisdictions_146c2(area, smallest, other, true);
    then area_treated_as_within_jurisdiction_of_146c2(area, other);
}

// (e): different allocation formulas
relation state_law_allocation_formula_146e1(state: Person, year: Integer, enacted: Boolean) kind empirical {
    label en official "the State has by law provided a different formula for allocating the State ceiling";
}
relation governor_proclamation_146e2(state: Person, year: Integer, proclaimed: Boolean, bond_issue_date: Date, first_regular_session_year_end_after_1986: Date, state_legislation_effective_date: Date) kind empirical {
    label en official "the Governor's proclamation of a different formula, the date of the bond's issue, the last day of the first calendar year after 1986 during which the legislature met in regular session, and the effective date of State legislation on allocation";
}
pub relation state_formula_governs_allocation_146e(state: Person, year: Integer) kind institutional {
    label en official "the State's formula replaces the statutory formula for the year (except for home rule cities' portion, paragraph (3))";
}
@source(IRC_S146_E, relation = formalizes, coverage = exact, quote = "Except as provided in paragraph (3), a State may, by law provide a different formula for allocating the State ceiling among the governmental units (or other authorities)")
rule StateLawFormulaGoverns(state: Person, year: Integer) strict {
    label en official "section 146(e)(1)";
    when state_law_allocation_formula_146e1(state, year, true);
    then state_formula_governs_allocation_146e(state, year);
}
@source(IRC_S146_E, relation = formalizes, coverage = exact, quote = "Except as otherwise provided in paragraph (3), the Governor of any State may proclaim a different formula for allocating the State ceiling among the governmental units")
rule GovernorFormulaGoverns(state: Person, year: Integer, issued: Date, s1: Date, s2: Date) strict {
    label en official "section 146(e)(2)(A)-(B): the Governor's authority does not apply to bonds issued after the earlier of the two dates";
    when governor_proclamation_146e2(state, year, true, issued, s1, s2);
    when issued <= min(s1, s2);
    then state_formula_governs_allocation_146e(state, year);
}
relation constitutional_amendment_permits_override_146e3(state: Person) kind empirical {
    label en official "a State constitutional amendment (or a law changing the home rule provision adopted as the State constitution provides) provides otherwise";
}
pub relation home_rule_portion_exempt_from_state_formula_146e3(state: Person) kind institutional {
    label en official "the authority of subsection (e) does not apply to that portion of the State ceiling allocated to a constitutional home rule city (unless a State constitutional amendment provides otherwise)";
}
@source(IRC_S146_E, relation = formalizes, coverage = exact, quote = "Except as otherwise provided in a State constitutional amendment (or law changing the home rule provision adopted in the manner provided by the State constitution), the")
rule HomeRulePortionExemptFromStateFormula(state: Person) strict {
    label en official "section 146(e)(3)";
    when state_law_allocation_formula_146e1(state, _, _);
    when not_known(constitutional_amendment_permits_override_146e3(state));
    then home_rule_portion_exempt_from_state_formula_146e3(state);
}

// (f): carryforward
relation authority_issued_amount_146f1(authority: Person, year: Integer, volume_cap: Money, issued: Money) kind empirical {
    label en official "the issuing authority's volume cap for the calendar year (after 1985) and the aggregate amount of tax-exempt private activity bonds it issued during the year";
}
pub enum CarryforwardPurpose146f5 { ExemptFacilityBonds; MortgageBondsOrCertificates; StudentLoanBonds; RedevelopmentBonds; }
relation carryforward_election_146f2(authority: Person, year: Integer, purpose: CarryforwardPurpose146f5, portion: Money) kind empirical {
    label en official "the election identifying the purpose of the carryforward and the portion of the excess for that purpose (a purpose named in section 146(f)(5))";
}
pub relation carryforward_excess_146f1(authority: Person, year: Integer, excess: Money) kind institutional {
    label en official "the excess of the volume cap over the tax-exempt private activity bonds issued in the year (available for the election)";
}
@source(IRC_S146_F, relation = formalizes, coverage = exact, quote = "If—")
rule CarryforwardExcess(authority: Person, year: Integer, cap: Money, issued: Money) strict {
    label en official "section 146(f)(1)(A)-(B): only years after 1985";
    when authority_issued_amount_146f1(authority, year, cap, issued);
    when year > 1985;
    when cap > issued;
    then carryforward_excess_146f1(authority, year, cap - issued);
}
pub relation carryforward_election_valid_146f(authority: Person, year: Integer, purpose: CarryforwardPurpose146f5, portion: Money) kind institutional {
    label en official "the election names a carryforward purpose and portions that in total do not exceed the excess";
}
relation carryforward_elected_total_146f2(authority: Person, year: Integer, total_of_portions: Money) kind empirical {
    label en official "the total of the portions elected for all purposes for the calendar year";
}
@source(IRC_S146_F, relation = formalizes, coverage = exact, quote = "In any election under paragraph (1), the issuing authority shall—")
rule CarryforwardElectionValid(authority: Person, year: Integer, purpose: CarryforwardPurpose146f5, portion: Money, excess: Money, total: Money) strict {
    label en official "section 146(f)(1)-(2)";
    when carryforward_election_146f2(authority, year, purpose, portion);
    when carryforward_excess_146f1(authority, year, excess);
    when carryforward_elected_total_146f2(authority, year, total);
    when total <= excess;
    then carryforward_election_valid_146f(authority, year, purpose, portion);
}
relation bond_issued_for_purpose_146f3(authority: Person, purpose: CarryforwardPurpose146f5, issued_year: Integer, amount: Money) kind empirical {
    label en official "private activity bonds issued by the authority for the purpose during a calendar year";
}
pub relation carryforward_used_146f3A(authority: Person, purpose: CarryforwardPurpose146f5, issued_year: Integer, amount: Money) kind institutional {
    label en official "bonds issued for the purpose during the 3 calendar years following the year the carryforward arose are not taken into account under subsection (a) up to the carryforward";
}
@source(IRC_S146_F, relation = formalizes, coverage = exact, quote = "If any issuing authority elects a carryforward under paragraph (1) with respect to any carryforward purpose, any private activity bonds issued by such authority with")
rule CarryforwardUsedWithinThreeYears(authority: Person, purpose: CarryforwardPurpose146f5, iy: Integer, amount: Money, year: Integer, portion: Money) strict {
    label en official "section 146(f)(3)(A): issue year in the 3 years after the year the carryforward arose, amount capped by the portion";
    when bond_issued_for_purpose_146f3(authority, purpose, iy, amount);
    when carryforward_election_valid_146f(authority, year, purpose, portion);
    when iy > year;
    when iy <= year + 3;
    then carryforward_used_146f3A(authority, purpose, iy, min(amount, portion));
}
relation carryforward_arose_years_146f3B(authority: Person, purpose: CarryforwardPurpose146f5, earlier_year: Integer, later_year: Integer, used_from_later_before_earlier_exhausted: Boolean) kind empirical {
    label en official "two carryforwards elected for the same purpose, the years they arose, and whether the later was used before the earlier was exhausted";
}
pub relation carryforward_order_violated_146f3B(authority: Person, purpose: CarryforwardPurpose146f5) kind institutional {
    label en official "a carryforward was used out of the order of the calendar years in which the carryforwards arose";
}
@source(IRC_S146_F, relation = formalizes, coverage = exact, quote = "Carryforwards elected with respect to any purpose shall be used in the order of the calendar years in which they arose.")
rule CarryforwardOrderViolated(authority: Person, purpose: CarryforwardPurpose146f5, e: Integer, l: Integer) strict {
    label en official "section 146(f)(3)(B)";
    when carryforward_arose_years_146f3B(authority, purpose, e, l, true);
    when e < l;
    then carryforward_order_violated_146f3B(authority, purpose);
}
relation carryforward_election_revocation_attempt_146f4(authority: Person, year: Integer, purpose: CarryforwardPurpose146f5) kind empirical {
    label en official "the authority attempts to change or revoke an election made under paragraph (1)";
}
pub relation carryforward_election_revocation_ineffective_146f4(authority: Person, year: Integer, purpose: CarryforwardPurpose146f5) kind institutional {
    label en official "the election, once made (with its identification and specification), is irrevocable";
}
@source(IRC_S146_F, relation = formalizes, coverage = exact, quote = "Any election under this paragraph (and any identification or specification contained therein), once made, shall be irrevocable.")
rule CarryforwardElectionIrrevocable(authority: Person, year: Integer, purpose: CarryforwardPurpose146f5, portion: Money) strict {
    label en official "section 146(f)(4)";
    when carryforward_election_revocation_attempt_146f4(authority, year, purpose);
    when carryforward_election_146f2(authority, year, purpose, portion);
    then carryforward_election_revocation_ineffective_146f4(authority, year, purpose);
}

// (g), (h): definition of private activity bond for the cap
pub enum CapBondKind146 { VeteransMortgageBond; Qualified501c3Bond; ExemptFacilityPara1_2_12_13_14_15; ExemptFacilityPara11HighSpeedRail; ExemptFacilityPara16Broadband; ExemptFacilityPara17CarbonCapture; ExemptFacilityPara6GovernmentOwned; OtherPrivateActivityBond; }
relation bond_kind_for_cap_146(issue: BondIssue, kind: CapBondKind146, face: Money, all_property_owned_by_governmental_unit: Boolean) kind empirical {
    label en official "the kind of the private activity bond for subsection (g)/(h), its face amount, and whether all the property financed by the net proceeds is to be owned by a governmental unit (within section 142(b)(1))";
}
pub relation face_counted_against_volume_cap_146gh(issue: BondIssue, amount: Money) kind institutional {
    label en official "the face amount of the bond counted as a private activity bond for the volume cap: excluded kinds count zero, 75 percent kinds count 75 percent (100 percent when governmentally owned)";
}
@source(IRC_S146_G, relation = formalizes, coverage = exact, quote = "(1) any qualified veterans' mortgage bond,")
rule CapFaceExcludedVeterans(issue: BondIssue, face: Money, gov: Boolean) strict {
    label en official "section 146(g)(1)";
    when bond_kind_for_cap_146(issue, VeteransMortgageBond, face, gov);
    then face_counted_against_volume_cap_146gh(issue, 0.00 USD);
}
@source(IRC_S146_G, relation = formalizes, coverage = exact, quote = "(2) any qualified 501(c)(3) bond,")
rule CapFaceExcluded501c3(issue: BondIssue, face: Money, gov: Boolean) strict {
    label en official "section 146(g)(2)";
    when bond_kind_for_cap_146(issue, Qualified501c3Bond, face, gov);
    then face_counted_against_volume_cap_146gh(issue, 0.00 USD);
}
@source(IRC_S146_G, relation = formalizes, coverage = exact, quote = "(3) any exempt facility bond issued as part of an issue described in paragraph (1), (2), (12), (13), (14), or (15) of section 142(a),")
rule CapFaceExcludedFacilityParas(issue: BondIssue, face: Money, gov: Boolean) strict {
    label en official "section 146(g)(3)";
    when bond_kind_for_cap_146(issue, ExemptFacilityPara1_2_12_13_14_15, face, gov);
    then face_counted_against_volume_cap_146gh(issue, 0.00 USD);
}
@source(IRC_S146_G, relation = formalizes, coverage = exact, quote = "(4) 75 percent of any exempt facility bond issued as part of an issue described in paragraph (11) of section 142(a) (relating to high-speed intercity rail facilities),")
rule CapFaceRail75Percent(issue: BondIssue, face: Money) strict {
    label en official "section 146(g)(4): 75 percent of the high-speed intercity rail bond is excluded, the rest counts";
    when bond_kind_for_cap_146(issue, ExemptFacilityPara11HighSpeedRail, face, false);
    then face_counted_against_volume_cap_146gh(issue, round(face * 0.25, 2, "HALF_UP"));
}
@source(IRC_S146_G, relation = formalizes, coverage = exact, quote = "(5) 75 percent of any exempt facility bond issued as part of an issue described in paragraph (16) of section 142(a) (relating to qualified broadband projects), and")
rule CapFaceBroadband75Percent(issue: BondIssue, face: Money) strict {
    label en official "section 146(g)(5): 75 percent of the qualified broadband bond is excluded";
    when bond_kind_for_cap_146(issue, ExemptFacilityPara16Broadband, face, false);
    then face_counted_against_volume_cap_146gh(issue, round(face * 0.25, 2, "HALF_UP"));
}
@source(IRC_S146_G, relation = formalizes, coverage = exact, quote = "(6) 75 percent of any exempt facility bond issued as part of an issue described in paragraph (17) of section 142(a) (relating to qualified carbon dioxide capture")
rule CapFaceCarbonCapture75Percent(issue: BondIssue, face: Money) strict {
    label en official "section 146(g)(6): 75 percent of the carbon dioxide capture facility bond is excluded";
    when bond_kind_for_cap_146(issue, ExemptFacilityPara17CarbonCapture, face, false);
    then face_counted_against_volume_cap_146gh(issue, round(face * 0.25, 2, "HALF_UP"));
}
@source(IRC_S146_G, relation = formalizes, coverage = exact, quote = "Paragraphs (4) and (5) shall be applied without regard to \"75 percent of\" if all of the property to be financed by the net proceeds of the issue is to be owned by a")
rule CapFaceRailFullyExcludedWhenGovernmentOwned(issue: BondIssue, face: Money) strict {
    label en official "section 146(g), last sentence: paragraphs (4) and (5) apply without '75 percent of' if all the property is governmentally owned";
    when bond_kind_for_cap_146(issue, ExemptFacilityPara11HighSpeedRail, face, true);
    then face_counted_against_volume_cap_146gh(issue, 0.00 USD);
}
@source(IRC_S146_G, relation = formalizes, coverage = exact, quote = "Paragraphs (4) and (5) shall be applied without regard to \"75 percent of\" if all of the property to be financed by the net proceeds of the issue is to be owned by a")
rule CapFaceBroadbandFullyExcludedWhenGovernmentOwned(issue: BondIssue, face: Money) strict {
    label en official "section 146(g), last sentence, paragraph (5)";
    when bond_kind_for_cap_146(issue, ExemptFacilityPara16Broadband, face, true);
    then face_counted_against_volume_cap_146gh(issue, 0.00 USD);
}
@source(IRC_S146_H, relation = formalizes, coverage = exact, quote = "Only for purposes of this section, the term \"private activity bond\" shall not include any exempt facility bond described in section 142(a)(6) which is issued as part of")
rule CapFaceExcludedGovernmentOwnedPara6(issue: BondIssue, face: Money) strict {
    label en official "section 146(h)(1): the paragraph (6) exempt facility bond of an issue whose property is all governmentally owned";
    when bond_kind_for_cap_146(issue, ExemptFacilityPara6GovernmentOwned, face, true);
    then face_counted_against_volume_cap_146gh(issue, 0.00 USD);
}
@source(IRC_S146_H, relation = formalizes, coverage = exact, quote = "Only for purposes of this section, the term \"private activity bond\" shall not include any exempt facility bond described in section 142(a)(6) which is issued as part of")
rule CapFaceCountedForNotGovernmentOwnedPara6(issue: BondIssue, face: Money) strict {
    label en official "section 146(h)(1) not met: the bond counts in full";
    when bond_kind_for_cap_146(issue, ExemptFacilityPara6GovernmentOwned, face, false);
    then face_counted_against_volume_cap_146gh(issue, face);
}
@source(IRC_S146_G, relation = formalizes, coverage = exact, quote = "Only for purposes of this section, the term \"private activity bond\" shall not include—")
rule CapFaceCountedForOtherBonds(issue: BondIssue, face: Money, gov: Boolean) strict {
    label en official "section 146(a): any other private activity bond counts in full";
    when bond_kind_for_cap_146(issue, OtherPrivateActivityBond, face, gov);
    then face_counted_against_volume_cap_146gh(issue, face);
}
relation lease_term_years_146h2(issue: BondIssue, lease_term_years: Integer) kind empirical {
    label en official "the term of a lease of the property under section 142(b)(1)(B)";
}
pub relation lease_term_satisfies_142b1B_ii_146h2(issue: BondIssue) kind institutional {
    label en official "for the section 146(h)(1) ownership test, a lease term is treated as satisfying section 142(b)(1)(B)(ii) if it is not more than 20 years";
}
@source(IRC_S146_H, relation = formalizes, coverage = exact, quote = "In determining ownership for purposes of paragraph (1), section 142(b)(1)(B) shall apply, except that a lease term shall be treated as satisfying clause (ii) thereof if")
rule LeaseTermWithin20Years(issue: BondIssue, years: Integer) strict {
    label en official "section 146(h)(2)";
    when lease_term_years_146h2(issue, years);
    when years <= 20;
    then lease_term_satisfies_142b1B_ii_146h2(issue);
}

// (i): refundings
relation refunding_facts_146i(refunding: BondIssue, refunding_amount: Money, refunded_outstanding: Money, advance_refunding: Boolean) kind empirical {
    label en official "the amount of the refunding bond, the outstanding amount of the refunded bond, and whether it is an advance refunding";
}
pub relation refunding_face_not_counted_146i1(refunding: BondIssue, amount: Money) kind institutional {
    label en official "the refunding bond is not a private activity bond for the cap to the extent its amount does not exceed the outstanding amount of the refunded bond; the excess counts";
}
pub relation refunding_face_counted_146i1(refunding: BondIssue, amount: Money) kind institutional {
    label en official "the part of the refunding bond exceeding the refunded outstanding amount (and an advance refunding in full) counts against the cap";
}
@source(IRC_S146_I, relation = formalizes, coverage = exact, quote = "The term \"private activity bond\" shall not include any bond which is issued to refund another bond to the extent that the amount of such bond does not exceed the")
rule RefundingFaceNotCounted(refunding: BondIssue, amt: Money, out: Money) strict {
    label en official "section 146(i)(1), not for an advance refunding (146(i)(5))";
    when refunding_facts_146i(refunding, amt, out, false);
    then refunding_face_not_counted_146i1(refunding, min(amt, out));
}
@source(IRC_S146_I, relation = formalizes, coverage = exact, quote = "The term \"private activity bond\" shall not include any bond which is issued to refund another bond to the extent that the amount of such bond does not exceed the")
rule RefundingExcessCounted(refunding: BondIssue, amt: Money, out: Money) strict {
    label en official "section 146(i)(1): the excess";
    when refunding_facts_146i(refunding, amt, out, false);
    when amt > out;
    then refunding_face_counted_146i1(refunding, amt - out);
}
@source(IRC_S146_I, relation = formalizes, coverage = exact, quote = "This subsection shall not apply to any bond issued to advance refund another bond.")
rule AdvanceRefundingCountedInFull(refunding: BondIssue, amt: Money, out: Money) strict {
    label en official "section 146(i)(5)";
    when refunding_facts_146i(refunding, amt, out, true);
    then refunding_face_counted_146i1(refunding, amt);
}
pub enum RefundingBondKind146i { StudentLoan; Mortgage; OtherBond; }
relation refunding_maturity_facts_146i(refunding: BondIssue, kind: RefundingBondKind146i, maturity_date: Date, average_maturity_date_of_refunded_bonds: Date, original_issue_date: Date) kind empirical {
    label en official "the maturity date of the refunding bond, the average maturity date of the refunded bonds (section 147(b)(2)(A), (i)(4)), and the issue date of the refunded bond or of the original bond in a series of refundings";
}
pub relation refunding_maturity_condition_met_146i(refunding: BondIssue) kind institutional {
    label en official "for a qualified student loan bond the maturity is not later than the later of the average maturity date of the refunded bonds and the date 17 years after the refunded bond's issue (32 years for a qualified mortgage bond)";
}
@source(IRC_S146_I, relation = formalizes, coverage = exact, quote = "In the case of any qualified student loan bond, paragraph (1) shall apply only if the maturity date of the refunding bond is not later than the later of—")
rule StudentLoanRefundingMaturityCondition(refunding: BondIssue, m: Date, a: Date, o: Date) strict {
    label en official "section 146(i)(2)(A)-(B)";
    when refunding_maturity_facts_146i(refunding, StudentLoan, m, a, o);
    when m <= max(a, add_calendar_period(o, 17 calendar_year));
    then refunding_maturity_condition_met_146i(refunding);
}
@source(IRC_S146_I, relation = formalizes, coverage = exact, quote = "In the case of any qualified mortgage bond, paragraph (1) shall apply only if the maturity date of the refunding bond is not later than the later of—")
rule MortgageRefundingMaturityCondition(refunding: BondIssue, m: Date, a: Date, o: Date) strict {
    label en official "section 146(i)(3)(A)-(B)";
    when refunding_maturity_facts_146i(refunding, Mortgage, m, a, o);
    when m <= max(a, add_calendar_period(o, 32 calendar_year));
    then refunding_maturity_condition_met_146i(refunding);
}
@source(IRC_S146_I, relation = formalizes, coverage = exact, quote = "The term \"private activity bond\" shall not include any bond which is issued to refund another bond to the extent that the amount of such bond does not exceed the")
rule OtherRefundingHasNoMaturityCondition(refunding: BondIssue, m: Date, a: Date, o: Date) strict {
    label en official "section 146(i)(1): paragraphs (2) and (3) apply only to student loan and mortgage bonds";
    when refunding_maturity_facts_146i(refunding, OtherBond, m, a, o);
    then refunding_maturity_condition_met_146i(refunding);
}
relation rental_project_loan_repayment_facts_146i6(refunding: BondIssue, repayment_date: Date, new_loan_date: Date, share_of_original_net_proceeds_for_142d_projects: Decimal, refunding_issue_date: Date, original_issue_date: Date, latest_maturity_date: Date, first_refunding_of_original: Boolean, approved_under_147f_before_issuance: Boolean) kind empirical {
    label en official "the facts of section 146(i)(6): the repayment of a loan financed by an issue 95 percent or more of the net proceeds of which are used for projects described in section 142(d), the new loan for such a project, the refunding issue and its latest maturity, whether it is the only refunding of the original issue, and its approval under section 147(f)";
}
pub relation rental_loan_repayment_refunding_not_counted_146i6(refunding: BondIssue) kind institutional {
    label en official "a bond issued to refund the original issue after a loan repayment used within 6 months for a new project loan is not a private activity bond for the cap, if it is the only refunding, issued within 4 years, matures within 34 years of the refunded bond's issue and is approved under 147(f) before issuance";
}
@source(IRC_S146_I, relation = formalizes, coverage = exact, quote = "Subparagraph (A) shall apply to only one refunding of the original issue and only if—")
rule RentalLoanRepaymentRefundingNotCounted(refunding: BondIssue, rep: Date, nl: Date, share: Decimal, ri: Date, oi: Date, lm: Date) strict {
    label en official "section 146(i)(6)(A)-(B)(i)-(iii)";
    when rental_project_loan_repayment_facts_146i6(refunding, rep, nl, share, ri, oi, lm, true, true);
    when share >= 0.95;
    when nl >= rep;
    when nl <= add_calendar_period(rep, 6 calendar_month);
    when ri <= add_calendar_period(oi, 4 calendar_year);
    when lm <= add_calendar_period(oi, 34 calendar_year);
    then rental_loan_repayment_refunding_not_counted_146i6(refunding);
}

// (k): out-of-State facilities
relation facility_location_and_use_shares_146k(issue: BondIssue, facility_outside_state: Boolean, state_share_of_use_or_output: Decimal, state_share_of_bonds_issued_or_volume_cap: Decimal, facility_kind_para_4_5_6_10_or_output_facility: Boolean, allocated_under_141b5: Boolean, issuer_establishes_shares: Boolean) kind empirical {
    label en official "whether the facility is located outside the State, the State's share of the use of the facility (or its output, or of the private business use under (k)(3)), the State's share of the private activity bonds issued to finance the facility (or of the volume cap allocated under 141(b)(5)), whether the facility is of a kind described in section 142(a)(4), (5), (6) or (10) or an output facility, whether the volume cap is allocated under section 141(b)(5), and whether the issuer establishes the shares";
}
pub relation state_ceiling_use_for_outside_facility_barred_146k1(issue: BondIssue) kind institutional {
    label en official "no portion of the State ceiling may be used for financing a facility located outside the State, except under paragraphs (2) and (3)";
}
pub relation outside_facility_exception_146k(issue: BondIssue) kind institutional {
    label en official "the exception of (k)(2) (paragraphs (4), (5), (6), (10) of section 142(a)) or (k)(3) (a bond allocated under section 141(b)(5) for an output facility or such a facility): the State's share of the use is not less than its share of the bonds (or volume cap)";
}
@source(IRC_S146_K, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall not apply to any exempt facility bond described in paragraph (4), (5), (6), or (10) of section 142(a) if the issuer establishes that the State's")
rule OutsideFacilityExceptionParagraphs(issue: BondIssue, use_share: Decimal, bond_share: Decimal) strict {
    label en official "section 146(k)(2)";
    when facility_location_and_use_shares_146k(issue, true, use_share, bond_share, true, false, true);
    when use_share >= bond_share;
    then outside_facility_exception_146k(issue);
}
@source(IRC_S146_K, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall not apply to any bond to which volume cap is allocated under section 141(b)(5)—")
rule OutsideFacilityExceptionAllocatedUnder141b5(issue: BondIssue, use_share: Decimal, bond_share: Decimal, kind: Boolean) strict {
    label en official "section 146(k)(3)(A)-(B)";
    when facility_location_and_use_shares_146k(issue, true, use_share, bond_share, kind, true, true);
    when use_share >= bond_share;
    then outside_facility_exception_146k(issue);
}
@source(IRC_S146_K, relation = formalizes, coverage = exact, quote = "Except as provided in paragraphs (2) and (3), no portion of the State ceiling applicable to any State for any calendar year may be used with respect to financing for a")
rule StateCeilingUseForOutsideFacilityBarred(issue: BondIssue, u: Decimal, b: Decimal, k: Boolean, a: Boolean, e: Boolean) strict {
    label en official "section 146(k)(1)";
    when facility_location_and_use_shares_146k(issue, true, u, b, k, a, e);
    when not_known(outside_facility_exception_146k(issue));
    then state_ceiling_use_for_outside_facility_barred_146k1(issue);
}

// (l), (m), (n): scholarship funding bonds; reductions of the cap
pub relation scholarship_funding_bond_issuer_kind_146l(bond: us.irc.core::Asset, is_state_issuer: Boolean) kind institutional {
    label en official "a qualified scholarship funding bond is treated as issued by a State or local issuing authority, whichever is appropriate (the input names which)";
}
relation scholarship_funding_bond_146l(bond: us.irc.core::Asset, appropriate_issuer_is_state: Boolean) kind empirical {
    label en official "the bond is a qualified scholarship funding bond and the appropriate issuer is a State (true) or a local authority (false)";
}
@source(IRC_S146_L, relation = formalizes, coverage = exact, quote = "In the case of a qualified scholarship funding bond, such bond shall be treated for purposes of this section as issued by a State or local issuing authority (whichever")
rule ScholarshipBondTreatedAsIssuedByAppropriateAuthority(bond: us.irc.core::Asset, st: Boolean) strict {
    label en official "section 146(l)";
    when scholarship_funding_bond_146l(bond, st);
    then scholarship_funding_bond_issuer_kind_146l(bond, st);
}
relation section_141b5_allocation_146m1(authority: Person, year: Integer, amount: Money) kind empirical {
    label en official "the amount allocated by the issuer to an issue under section 141(b)(5)";
}
relation mortgage_bonds_not_issued_146n(authority: Person, year: Integer, elected_not_to_issue_25c2Aii: Money, reduction_under_25f: Money) kind empirical {
    label en official "the amount of qualified mortgage bonds the authority elects not to issue under section 25(c)(2)(A)(ii) during the year, and any reduction of the ceiling under section 25(f) applicable to it";
}
relation section_141b5_allocation_total_146m1(authority: Person, year: Integer, total: Money) kind empirical {
    label en official "the total amounts allocated by the authority under section 141(b)(5) in the year (an aggregate over the case's allocations)";
}
pub relation volume_cap_146(authority: Person, year: Integer, amount: Money) kind institutional {
    label en official "the volume cap of the issuing authority after the reductions of subsections (m)(1) and (n), not below zero";
}
@source(IRC_S146_M, relation = formalizes, coverage = exact, quote = "The volume cap of an issuer shall be reduced by the amount allocated by the issuer to an issue under section 141(b)(5).")
rule VolumeCapAfterReductions(authority: Person, year: Integer, base: Money, alloc: Money, n1: Money, n2: Money) strict {
    label en official "section 146(m)(1), (n)(1)-(2): the cap reduced by the allocations and by the mortgage bonds not issued plus the section 25(f) reduction";
    when volume_cap_before_reductions_146(authority, year, base);
    when section_141b5_allocation_total_146m1(authority, year, alloc);
    when mortgage_bonds_not_issued_146n(authority, year, n1, n2);
    then volume_cap_146(authority, year, max(0.00 USD, base - alloc - n1 - n2));
}
relation advance_refunding_of_141b5_issue_146m2(refunding: BondIssue, amount_allocated_to_refunded_part: Money, secretary_provides_otherwise: Boolean) kind empirical {
    label en official "an advance refunding of any part of an issue to which an amount was allocated under section 141(b)(5) (or would have been if it applied), the amount allocated to the refunded part, and whether the Secretary provides otherwise";
}
pub relation advance_refunding_taken_into_account_146m2(refunding: BondIssue, amount: Money) kind institutional {
    label en official "the advance refunding is taken into account under this section to the extent of the amount allocated to the refunded part";
}
@source(IRC_S146_M, relation = formalizes, coverage = exact, quote = "Except as otherwise provided by the Secretary, any advance refunding of any part of an issue to which an amount was allocated under section 141(b)(5) (or would have been")
rule AdvanceRefundingOf141b5IssueTakenIntoAccount(refunding: BondIssue, amount: Money) strict {
    label en official "section 146(m)(2)";
    when advance_refunding_of_141b5_issue_146m2(refunding, amount, false);
    then advance_refunding_taken_into_account_146m2(refunding, amount);
}

// (a): the requirement, derived
relation issuance_in_year_146a(issue: BondIssue, authority: Person, year: Integer, face_of_this_issue_counted: Money, previously_issued_counted_in_year: Money) kind empirical {
    label en official "the issuing authority, the calendar year, the aggregate face amount of the private activity bonds issued pursuant to the issue that counts against the cap, and the aggregate face amount of tax-exempt private activity bonds previously issued by the authority during the calendar year that count";
}
pub relation issue_meets_146_volume_cap_derived(issue: BondIssue) kind institutional {
    label en official "section 146(a): the aggregate face amount of the issue, added to the aggregate face amount of the tax-exempt private activity bonds previously issued by the authority during the year, does not exceed the authority's volume cap for the year";
}
@source(IRC_S146_A, relation = formalizes, coverage = exact, quote = "A private activity bond issued as part of an issue meets the requirements of this section if the aggregate face amount of the private activity bonds issued pursuant to")
rule IssueMeetsVolumeCapDerived(issue: BondIssue, authority: Person, year: Integer, face: Money, prior: Money, cap: Money) strict {
    label en official "section 146(a)";
    when issuance_in_year_146a(issue, authority, year, face, prior);
    when volume_cap_146(authority, year, cap);
    when face + prior <= cap;
    then issue_meets_146_volume_cap_derived(issue);
}
