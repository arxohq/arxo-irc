// Stage 2f (TECH_GAP reduction) — private activity bonds, third part: section 143
// (qualified mortgage bonds and qualified veterans' mortgage bonds).
// STATUS: implemented_unverified (static check only; scenarios in
// tests/bonds-c-143.lawtest are NOT executed).
//
// TECHNIQUE: the earlier module models three tests of §143 ((c)(1), (d)(1), (f)(1)) on
// case-asserted percentages; this module adds the remaining requirements, the
// qualified mortgage issue and qualified veterans' mortgage bond definitions, the
// safe harbors of (a)(2)(B)-(C), the definitions of (k) and the recapture of (m).
// The derived `qualified_mortgage_issue_143a2A` and `qualified_veterans_mortgage_issue_143b`
// feed the section 141(e) category rules through the parallel rules at the end.

// =====================================================================
// §143(a)(2): qualified mortgage issue
// =====================================================================

use self::{
    BondIssue,
    IRC_S143_A,
    IRC_S143_B,
    IRC_S143_E,
    IRC_S143_F,
    IRC_S143_G,
    IRC_S143_H,
    IRC_S143_I,
    IRC_S143_J,
    IRC_S143_K,
    IRC_S143_L,
    IRC_S143_M,
    IRC_S143_TABLE_1,
    IRC_S143_TABLE_2,
    Individual,
    Person,
    TaxableYear,
    applicable_median_family_income_143f,
    has_computed_yield_143g2,
    issue_total_proceeds,
    mortgagor_family_income,
    mortgagor_income_within_143f_limit,
    private_business_use_test_met_141b1,
    private_security_or_payment_test_met_141b2,
    qualified_bond_category_141e1,
};

pub enum Requirement143 { RequirementC; RequirementD; RequirementE; RequirementF; RequirementG; RequirementH; RequirementI; RequirementM7; }
relation issue_proceeds_owner_financing_143a2(issue: BondIssue, used_for_owner_occupied_residences: Money, issuance_costs_and_reasonably_required_reserve: Money) kind empirical {
    label en official "the proceeds used to finance owner-occupied residences and the issuance costs and reasonably required reserve";
}
pub relation all_proceeds_finance_owner_occupied_residences_143a2Ai(issue: BondIssue) kind institutional {
    label en official "all proceeds of the issue (exclusive of issuance costs and a reasonably required reserve) are to be used to finance owner-occupied residences";
}
@source(IRC_S143_A, relation = formalizes, coverage = exact, quote = "(i) all proceeds of such issue (exclusive of issuance costs and a reasonably required reserve) are to be used to finance owner-occupied residences,")
rule AllProceedsFinanceOwnerOccupiedResidences(issue: BondIssue, used: Money, costs: Money, total: Money) strict {
    label en official "section 143(a)(2)(A)(i): the residence financing covers the proceeds net of costs and reserve";
    when issue_proceeds_owner_financing_143a2(issue, used, costs);
    when issue_total_proceeds(issue, total);
    when used >= round(total - costs, 2, "HALF_UP");
    then all_proceeds_finance_owner_occupied_residences_143a2Ai(issue);
}
relation issue_requirement_facts_143(issue: BondIssue, req: Requirement143) kind empirical {
    label en official "the case asserts that the issue meets the subsection of section 143 named by the requirement (used for the subsections whose tests are not decomposed here, and to record the good faith safe harbors' input)";
}
relation issuer_good_faith_attempt_143a2B(issue: BondIssue) kind empirical {
    label en official "the issuer in good faith attempted to meet all requirements of (c), (d), (e), (f) and (i) before the mortgages were executed";
}
relation share_of_owner_financing_meeting_all_requirements_143a2Bii(issue: BondIssue, share: Decimal) kind empirical {
    label en official "the share of the proceeds devoted to owner-financing that was devoted to residences with respect to which, at the time the mortgages were executed, all such requirements were met";
}
relation failure_corrected_within_reasonable_period_143a2Biii(issue: BondIssue) kind empirical {
    label en official "any failure to meet the requirements is corrected within a reasonable period after it is first discovered";
}
relation issuer_good_faith_and_inadvertent_error_after_reasonable_steps_143a2C(issue: BondIssue) kind empirical {
    label en official "the issuer in good faith attempted to meet the requirements of (g), (h) and (m)(7), and any failure is due to inadvertent error after taking reasonable steps to comply";
}
pub relation issue_meets_requirement_143(issue: BondIssue, req: Requirement143) kind institutional {
    label en official "the issue meets the requirement of the subsection, directly or by the safe harbor of section 143(a)(2)(B) or (C)";
}
@source(IRC_S143_A, relation = formalizes, coverage = exact, quote = "(ii) such issue meets the requirements of subsections (c), (d), (e), (f), (g), (h), (i), and (m)(7),")
rule IssueMeetsRequirementByFacts(issue: BondIssue, req: Requirement143) strict {
    label en official "section 143(a)(2)(A)(ii): the requirement is met as asserted";
    when issue_requirement_facts_143(issue, req);
    then issue_meets_requirement_143(issue, req);
}
@source(IRC_S143_A, relation = formalizes, coverage = exact, quote = "An issue which fails to meet 1 or more of the requirements of subsections (c), (d), (e), (f), and (i) shall be treated as meeting such requirements if—")
rule SafeHarborBForRequirementC(issue: BondIssue, share: Decimal) strict {
    label en official "section 143(a)(2)(B)(i)-(iii) for the requirement of (c)";
    when issuer_good_faith_attempt_143a2B(issue);
    when share_of_owner_financing_meeting_all_requirements_143a2Bii(issue, share);
    when share >= 0.95;
    when failure_corrected_within_reasonable_period_143a2Biii(issue);
    then issue_meets_requirement_143(issue, RequirementC);
}
rule SafeHarborBForRequirementD(issue: BondIssue, share: Decimal) strict {
    label en official "section 143(a)(2)(B) for the requirement of (d)";
    when issuer_good_faith_attempt_143a2B(issue);
    when share_of_owner_financing_meeting_all_requirements_143a2Bii(issue, share);
    when share >= 0.95;
    when failure_corrected_within_reasonable_period_143a2Biii(issue);
    then issue_meets_requirement_143(issue, RequirementD);
}
rule SafeHarborBForRequirementE(issue: BondIssue, share: Decimal) strict {
    label en official "section 143(a)(2)(B) for the requirement of (e)";
    when issuer_good_faith_attempt_143a2B(issue);
    when share_of_owner_financing_meeting_all_requirements_143a2Bii(issue, share);
    when share >= 0.95;
    when failure_corrected_within_reasonable_period_143a2Biii(issue);
    then issue_meets_requirement_143(issue, RequirementE);
}
rule SafeHarborBForRequirementF(issue: BondIssue, share: Decimal) strict {
    label en official "section 143(a)(2)(B) for the requirement of (f)";
    when issuer_good_faith_attempt_143a2B(issue);
    when share_of_owner_financing_meeting_all_requirements_143a2Bii(issue, share);
    when share >= 0.95;
    when failure_corrected_within_reasonable_period_143a2Biii(issue);
    then issue_meets_requirement_143(issue, RequirementF);
}
rule SafeHarborBForRequirementI(issue: BondIssue, share: Decimal) strict {
    label en official "section 143(a)(2)(B) for the requirement of (i)";
    when issuer_good_faith_attempt_143a2B(issue);
    when share_of_owner_financing_meeting_all_requirements_143a2Bii(issue, share);
    when share >= 0.95;
    when failure_corrected_within_reasonable_period_143a2Biii(issue);
    then issue_meets_requirement_143(issue, RequirementI);
}
@source(IRC_S143_A, relation = formalizes, coverage = exact, quote = "An issue which fails to meet 1 or more of the requirements of subsections (g), (h), and (m)(7) shall be treated as meeting such requirements if—")
rule SafeHarborCForRequirementG(issue: BondIssue) strict {
    label en official "section 143(a)(2)(C)(i)-(ii) for the requirement of (g)";
    when issuer_good_faith_and_inadvertent_error_after_reasonable_steps_143a2C(issue);
    then issue_meets_requirement_143(issue, RequirementG);
}
rule SafeHarborCForRequirementH(issue: BondIssue) strict {
    label en official "section 143(a)(2)(C) for the requirement of (h)";
    when issuer_good_faith_and_inadvertent_error_after_reasonable_steps_143a2C(issue);
    then issue_meets_requirement_143(issue, RequirementH);
}
rule SafeHarborCForRequirementM7(issue: BondIssue) strict {
    label en official "section 143(a)(2)(C) for the requirement of (m)(7)";
    when issuer_good_faith_and_inadvertent_error_after_reasonable_steps_143a2C(issue);
    then issue_meets_requirement_143(issue, RequirementM7);
}
relation principal_repayment_received_143a2Aiv(issue: BondIssue, received_on: Date, amount: Money, redeemed_on: Date) kind empirical {
    label en official "a repayment of principal on financing provided by the issue, the date received, and the date the amount is used to redeem bonds of the issue";
}
relation date_of_issuance_143a2Aiv(issue: BondIssue, issued_on: Date) kind empirical {
    label en official "the date of issuance of the issue (of the original bond for a refunding bond)";
}
relation redemption_de_minimis_under_250000_143a2Dii(issue: BondIssue, amount: Money) kind empirical {
    label en official "the amount of unredeemed repayments, for the $250,000 rule of subparagraph (D)(ii)";
}
pub relation repayments_redeemed_timely_143a2Aiv(issue: BondIssue) kind institutional {
    label en official "repayments of principal are used not later than the close of the 1st semiannual period beginning after the receipt to redeem bonds of the issue; the requirement does not apply to amounts received within 10 years after issuance, and (D)(ii) excepts amounts of less than $250,000";
}
@source(IRC_S143_A, relation = formalizes, coverage = exact, quote = "(iv) except as provided in subparagraph (D)(ii), repayments of principal on financing provided by the issue are used not later than the close of the 1st semiannual")
rule RepaymentsRedeemedTimely(issue: BondIssue, received: Date, amount: Money, redeemed: Date) strict {
    label en official "section 143(a)(2)(A)(iv): the semiannual period is counted from the receipt date: redemption by the end of the 6 months that begin the day after the first January 1 or July 1 on or after receipt (approximated as 12 months, the two semiannual boundaries being reached by a redemption within 6 months of the next one is a simplification recorded in TECH-GAPS G4502)";
    when principal_repayment_received_143a2Aiv(issue, received, amount, redeemed);
    when redeemed <= add_calendar_period(received, 12 calendar_month);
    then repayments_redeemed_timely_143a2Aiv(issue);
}
@source(IRC_S143_A, relation = formalizes, coverage = exact, quote = "Clause (iv) shall not apply to amounts received within 10 years after the date of issuance of the issue (or, in the case of refunding bond, the date of issuance of the")
rule RepaymentRedemptionNotRequiredWithinTenYears(issue: BondIssue, issued: Date, received: Date, amount: Money, redeemed: Date) strict {
    label en official "section 143(a)(2)(A), closing sentence: clause (iv) does not apply to amounts received within 10 years after the date of issuance";
    when principal_repayment_received_143a2Aiv(issue, received, amount, redeemed);
    when date_of_issuance_143a2Aiv(issue, issued);
    when received <= add_calendar_period(issued, 10 calendar_year);
    then repayments_redeemed_timely_143a2Aiv(issue);
}
@source(IRC_S143_A, relation = formalizes, coverage = exact, quote = "Clause (i) (and clause (iv) of subparagraph (A)) shall not be construed to require amounts of less than $250,000 to be used to redeem bonds. The Secretary may by")
rule RepaymentRedemptionNotRequiredBelow250000(issue: BondIssue, amount: Money) strict {
    label en official "section 143(a)(2)(D)(ii): amounts of less than $250,000 need not be used to redeem bonds";
    when redemption_de_minimis_under_250000_143a2Dii(issue, amount);
    when amount < 250000.00 USD;
    then repayments_redeemed_timely_143a2Aiv(issue);
}
relation proceeds_used_or_redeemed_within_42_months_143a2Di(issue: BondIssue, share_used_within_period: Decimal, share_redeemed_within_period: Decimal) kind empirical {
    label en official "the share of the proceeds required to be used for owner-occupied residences that is used within the 42-month period beginning on the date of issuance (of the original bond for a refunding), and the share that is used within the period to redeem bonds of the issue";
}
relation no_loan_made_after_42_months_143a2Dii(issue: BondIssue) kind empirical {
    label en official "no portion of the proceeds is used to make or finance any loan (other than a nonpurpose investment) after the close of that period";
}
pub relation forty_two_month_use_requirement_met_143a2D(issue: BondIssue) kind institutional {
    label en official "the proceeds are used or redeemed within 42 months and no loan is made afterwards: the requirement of (A)(i) under subparagraph (D)(i)";
}
@source(IRC_S143_A, relation = formalizes, coverage = exact, quote = "(I) all proceeds of the issue required to be used to finance owner-occupied residences are so used within the 42-month period beginning on the date of issuance of the")
rule FortyTwoMonthUseRequirementMet(issue: BondIssue, used: Decimal, redeemed: Decimal) strict {
    label en official "section 143(a)(2)(D)(i)(I)-(II): used plus redeemed covers everything";
    when proceeds_used_or_redeemed_within_42_months_143a2Di(issue, used, redeemed);
    when used + redeemed >= 1.00;
    when no_loan_made_after_42_months_143a2Dii(issue);
    then forty_two_month_use_requirement_met_143a2D(issue);
}
pub relation qualified_mortgage_issue_143a2A(issue: BondIssue) kind institutional {
    label en official "a qualified mortgage issue within section 143(a)(2)(A): all proceeds for owner-occupied residences, the requirements of (c), (d), (e), (f), (g), (h), (i) and (m)(7) met, not a private business test issue, and timely redemption of repayments";
}
@source(IRC_S143_A, relation = formalizes, coverage = exact, quote = "(iii) such issue does not meet the private business tests of paragraphs (1) and (2) of section 141(b), and")
rule QualifiedMortgageIssueDefined(issue: BondIssue) strict {
    label en official "section 143(a)(2)(A)(i)-(iv)";
    when all_proceeds_finance_owner_occupied_residences_143a2Ai(issue);
    when issue_meets_requirement_143(issue, RequirementC);
    when issue_meets_requirement_143(issue, RequirementD);
    when issue_meets_requirement_143(issue, RequirementE);
    when issue_meets_requirement_143(issue, RequirementF);
    when issue_meets_requirement_143(issue, RequirementG);
    when issue_meets_requirement_143(issue, RequirementH);
    when issue_meets_requirement_143(issue, RequirementI);
    when issue_meets_requirement_143(issue, RequirementM7);
    when not_known(private_business_use_test_met_141b1(issue));
    when not_known(private_security_or_payment_test_met_141b2(issue));
    when repayments_redeemed_timely_143a2Aiv(issue);
    then qualified_mortgage_issue_143a2A(issue);
}
@source(IRC_S143_A, relation = formalizes, coverage = exact, quote = "(iii) such issue does not meet the private business tests of paragraphs (1) and (2) of section 141(b), and")
rule QualifiedMortgageIssueWithFortyTwoMonthRule(issue: BondIssue) strict {
    label en official "section 143(a)(2)(A) with (D)(i): the 42-month requirement in place of the plain (A)(i) use";
    when forty_two_month_use_requirement_met_143a2D(issue);
    when issue_meets_requirement_143(issue, RequirementC);
    when issue_meets_requirement_143(issue, RequirementD);
    when issue_meets_requirement_143(issue, RequirementE);
    when issue_meets_requirement_143(issue, RequirementF);
    when issue_meets_requirement_143(issue, RequirementG);
    when issue_meets_requirement_143(issue, RequirementH);
    when issue_meets_requirement_143(issue, RequirementI);
    when issue_meets_requirement_143(issue, RequirementM7);
    when not_known(private_business_use_test_met_141b1(issue));
    when not_known(private_security_or_payment_test_met_141b2(issue));
    when repayments_redeemed_timely_143a2Aiv(issue);
    then qualified_mortgage_issue_143a2A(issue);
}

// =====================================================================
// §143(b): qualified veterans' mortgage bond
// =====================================================================

relation issue_share_for_veterans_residences_143b1(issue: BondIssue, share: Decimal) kind empirical {
    label en official "the share of the net proceeds of the issue to be used to provide residences for veterans";
}
relation payment_secured_by_general_obligation_of_state_143b2(issue: BondIssue) kind empirical {
    label en official "the payment of principal and interest is secured by the general obligation of a State";
}
relation issue_meets_143b3_subsections_143(issue: BondIssue, c: Boolean, g: Boolean, i1: Boolean, l: Boolean) kind empirical {
    label en official "the issue meets the requirements of subsections (c), (g), (i)(1) and (l) (each asserted, or met through the safe harbors as stated in the last sentence of (b))";
}
pub relation qualified_veterans_mortgage_issue_143b(issue: BondIssue) kind institutional {
    label en official "a qualified veterans' mortgage bond issue within section 143(b)";
}
@source(IRC_S143_B, relation = formalizes, coverage = exact, quote = "(1) which is issued as part of an issue 95 percent or more of the net proceeds of which are to be used to provide residences for veterans,")
rule QualifiedVeteransMortgageIssueDefined(issue: BondIssue, share: Decimal) strict {
    label en official "section 143(b)(1)-(4): 95 percent for veterans, State general obligation, (c), (g), (i)(1), (l) met, and not a private business test issue (the safe harbors of (a)(2)(B)-(C) apply to the paragraph (3) requirements by the last sentence of (b), carried by the asserted flags)";
    when issue_share_for_veterans_residences_143b1(issue, share);
    when share >= 0.95;
    when payment_secured_by_general_obligation_of_state_143b2(issue);
    when issue_meets_143b3_subsections_143(issue, true, true, true, true);
    when not_known(private_business_use_test_met_141b1(issue));
    when not_known(private_security_or_payment_test_met_141b2(issue));
    then qualified_veterans_mortgage_issue_143b(issue);
}

// =====================================================================
// §143(e): purchase price requirement
// =====================================================================

pub enum ResidenceClass143e { NewResidence; PreviouslyOccupiedResidence; TargetedAreaResidence; QualifiedHomeImprovementLoanResidence; }
relation residence_of_issue_143(issue: BondIssue, residence: us.irc.core::Asset, mortgagor: Individual, issuer: us.irc.core::Organ) kind empirical {
    label en official "a residence financed by the issue, its mortgagor and the issuing authority";
}
relation residence_acquisition_cost_and_average_area_price_143e(residence: us.irc.core::Asset, class: ResidenceClass143e, acquisition_cost: Money, average_area_purchase_price: Money) kind empirical {
    label en official "the acquisition cost of the residence, its class (new, previously occupied, targeted area, home improvement) and the average area purchase price applicable to it (determined separately for new and previously occupied residences, section 143(e)(2)-(4))";
}
pub relation residence_exceeds_purchase_price_limit_143e(issue: BondIssue, residence: us.irc.core::Asset) kind institutional {
    label en official "the acquisition cost of the residence exceeds 90 percent (110 percent for a targeted area residence) of the average area purchase price applicable to it; the limit does not apply to a qualified home improvement loan";
}
@source(IRC_S143_E, relation = formalizes, coverage = exact, quote = "An issue meets the requirements of this subsection only if the acquisition cost of each residence the owner-financing of which is provided under the issue does not")
rule ResidenceExceedsPurchasePriceLimit90(issue: BondIssue, residence: us.irc.core::Asset, mortgagor: Individual, issuer: us.irc.core::Organ, class: ResidenceClass143e, cost: Money, avg: Money) strict {
    label en official "section 143(e)(1) for a new or previously occupied residence: cost > 90 percent of the average price";
    when residence_of_issue_143(issue, residence, mortgagor, issuer);
    when residence_acquisition_cost_and_average_area_price_143e(residence, class, cost, avg);
    when class != TargetedAreaResidence;
    when class != QualifiedHomeImprovementLoanResidence;
    when cost > round(avg * 0.90, 2, "HALF_UP");
    when not_known(disaster_area_modifications_apply_143k11(residence)); // G6404 wiring: §143(k)(11)(B) — applied as a targeted area residence (110 percent, rule below)
    when not_known(mortgagor_has_143k13a_relief(mortgagor)); // G6404 wiring: §143(k)(13)(A) — 110 percent for the taxpayer (rule below)
    when not_known(subprime_refinancing_permitted_143k12A(issue)); // G6404 wiring: §143(k)(12)(B)(iii) — market value in lieu of acquisition cost (rule below)
    then residence_exceeds_purchase_price_limit_143e(issue, residence);
}
// =====================================================================
// G6404 wiring: §143(k)(11)-(13) modifications read by §143(d), (e), (f) and (a)(2)(D)
// =====================================================================
// JUDGMENT CALLS. (1) §143(k)(11)(B): "(e) and (f) ... as if such residence were a targeted area residence" is
// read as the 110-percent limit of (e)(5) and the 140-percent income limit of (f)(3)(B); the one-third free share of
// (f)(3)(A) is an issue-level percentage the package does not model, so the mortgagor-level test uses 140 percent for
// every disaster-area mortgagor. (2) §143(k)(11)(A), (12)(B)(ii), (13)(A): "subsection (d) shall not apply" is read
// per residence (`residence_exempt_from_143d_143k`); requirement (d) is met for an issue only when EVERY residence of
// the issue is exempt (a mixed issue keeps the percentage test), and for an issue whose refinancing is permitted by
// (k)(12)(A) the requirement is concluded met at the issue level (the flag carries no residence). (3) (12)(B)(i): the
// 12-month period is an alternative fact pair to the 42-month pair.
relation mortgagor_has_143k13a_relief(mortgagor: Individual) kind institutional {
    label en official "the mortgagor is a taxpayer to whom the section 143(k)(13)(A) disaster relief applies on some financing date";
}
rule MortgagorHas143k13aRelief(mortgagor: Individual, on: Date) strict {
    label en official "section 143(k)(13)(A): the relief applies to the taxpayer on the financing date";
    when disaster_relief_143k13a_applies(mortgagor, on);
    then mortgagor_has_143k13a_relief(mortgagor);
}
@source(IRC_S143_K, relation = formalizes, coverage = exact, quote = "shall be applied as if such residence were a targeted area residence.")
rule ResidenceExceedsPurchasePriceLimit110DisasterArea(issue: BondIssue, residence: us.irc.core::Asset, mortgagor: Individual, issuer: us.irc.core::Organ, class: ResidenceClass143e, cost: Money, avg: Money) strict {
    label en official "section 143(k)(11)(B): a disaster-area residence is subject to the 110-percent limit of (e)(5)";
    when residence_of_issue_143(issue, residence, mortgagor, issuer);
    when disaster_area_modifications_apply_143k11(residence);
    when residence_acquisition_cost_and_average_area_price_143e(residence, class, cost, avg);
    when class != QualifiedHomeImprovementLoanResidence;
    when cost > round(avg * 1.10, 2, "HALF_UP");
    then residence_exceeds_purchase_price_limit_143e(issue, residence);
}
@source(IRC_S143_K, relation = formalizes, coverage = exact, quote = "subsection (e) shall be applied by substituting \"110\" for \"90\" in paragraph (1) thereof")
rule ResidenceExceedsPurchasePriceLimit110Relief143k13a(issue: BondIssue, residence: us.irc.core::Asset, mortgagor: Individual, issuer: us.irc.core::Organ, class: ResidenceClass143e, cost: Money, avg: Money) strict {
    label en official "section 143(k)(13)(A): the 110-percent limit for a taxpayer with disaster relief";
    when residence_of_issue_143(issue, residence, mortgagor, issuer);
    when mortgagor_has_143k13a_relief(mortgagor);
    when residence_acquisition_cost_and_average_area_price_143e(residence, class, cost, avg);
    when class != QualifiedHomeImprovementLoanResidence;
    when cost > round(avg * 1.10, 2, "HALF_UP");
    then residence_exceeds_purchase_price_limit_143e(issue, residence);
}
relation residence_market_value_at_refinancing_143k12Biii(residence: us.irc.core::Asset, market_value: Money) kind empirical {
    label en official "the market value of the residence at the time of refinancing (section 143(k)(12)(B)(iii))";
}
@source(IRC_S143_K, relation = formalizes, coverage = exact, quote = "using the market value of the residence at the time of refinancing in lieu of the acquisition cost")
rule ResidenceExceedsPurchasePriceLimit90SubprimeRefinancing(issue: BondIssue, residence: us.irc.core::Asset, mortgagor: Individual, issuer: us.irc.core::Organ, class: ResidenceClass143e, market: Money, avg: Money) strict {
    label en official "section 143(k)(12)(B)(iii): (e) with the market value at refinancing in place of the acquisition cost (90 percent)";
    when subprime_refinancing_permitted_143k12A(issue);
    when residence_of_issue_143(issue, residence, mortgagor, issuer);
    when residence_market_value_at_refinancing_143k12Biii(residence, market);
    when residence_acquisition_cost_and_average_area_price_143e(residence, class, _, avg);
    when class != TargetedAreaResidence;
    when class != QualifiedHomeImprovementLoanResidence;
    when market > round(avg * 0.90, 2, "HALF_UP");
    then residence_exceeds_purchase_price_limit_143e(issue, residence);
}
@source(IRC_S143_K, relation = formalizes, coverage = exact, quote = "using the market value of the residence at the time of refinancing in lieu of the acquisition cost")
rule ResidenceExceedsPurchasePriceLimit110SubprimeRefinancingTargeted(issue: BondIssue, residence: us.irc.core::Asset, mortgagor: Individual, issuer: us.irc.core::Organ, market: Money, avg: Money) strict {
    label en official "section 143(k)(12)(B)(iii): (e) with the market value at refinancing in place of the acquisition cost (110 percent, targeted area)";
    when subprime_refinancing_permitted_143k12A(issue);
    when residence_of_issue_143(issue, residence, mortgagor, issuer);
    when residence_market_value_at_refinancing_143k12Biii(residence, market);
    when residence_acquisition_cost_and_average_area_price_143e(residence, TargetedAreaResidence, _, avg);
    when market > round(avg * 1.10, 2, "HALF_UP");
    then residence_exceeds_purchase_price_limit_143e(issue, residence);
}
// (d): the 3-year requirement does not apply
relation residence_exempt_from_143d_143k(residence: us.irc.core::Asset) kind institutional {
    label en official "section 143(d) does not apply to the residence: a disaster-area residence (k)(11)(A), or financing of a taxpayer with disaster relief (k)(13)(A)";
}
rule ResidenceExemptFrom143dDisasterArea(residence: us.irc.core::Asset) strict {
    label en official "section 143(k)(11)(A)";
    when disaster_area_modifications_apply_143k11(residence);
    then residence_exempt_from_143d_143k(residence);
}
rule ResidenceExemptFrom143dRelief(issue: BondIssue, residence: us.irc.core::Asset, mortgagor: Individual, issuer: us.irc.core::Organ) strict {
    label en official "section 143(k)(13)(A): (d)(1) does not apply with respect to the taxpayer";
    when residence_of_issue_143(issue, residence, mortgagor, issuer);
    when mortgagor_has_143k13a_relief(mortgagor);
    then residence_exempt_from_143d_143k(residence);
}
relation issue_has_residence_subject_to_143d_143k(issue: BondIssue) kind institutional {
    label en official "the issue has a residence to which section 143(d) still applies";
}
rule IssueHasResidenceSubjectTo143d(issue: BondIssue, residence: us.irc.core::Asset, mortgagor: Individual, issuer: us.irc.core::Organ) strict {
    label en official "a residence of the issue that is not exempt from (d)";
    when residence_of_issue_143(issue, residence, mortgagor, issuer);
    when not_known(residence_exempt_from_143d_143k(residence));
    then issue_has_residence_subject_to_143d_143k(issue);
}
@source(IRC_S143_K, relation = formalizes, coverage = exact, quote = "Subsection (d) (relating to 3-year requirement) shall not apply.")
rule RequirementDMetWhenEveryResidenceExempt(issue: BondIssue) strict {
    label en official "section 143(k)(11)(A), (13)(A): requirement (d) is met when every residence of the issue is exempt from it";
    when issue_has_residence_143(issue);
    when not_known(issue_has_residence_subject_to_143d_143k(issue));
    then issue_meets_requirement_143(issue, RequirementD);
}
@source(IRC_S143_K, relation = formalizes, coverage = exact, quote = "subsection (d) (relating to 3-year requirement) shall not apply, and")
rule RequirementDMetBySubprimeRefinancing(issue: BondIssue) strict {
    label en official "section 143(k)(12)(B)(ii): (d) does not apply to the refinancing permitted by (k)(12)(A) (issue-level reading, JUDGMENT CALL above)";
    when subprime_refinancing_permitted_143k12A(issue);
    then issue_meets_requirement_143(issue, RequirementD);
}
// (a)(2)(D)(i): 12 months in place of 42 months
relation proceeds_used_or_redeemed_within_12_months_143k12Bi(issue: BondIssue, share_used_within_period: Decimal, share_redeemed_within_period: Decimal) kind empirical {
    label en official "the shares of the proceeds used, or redeemed, within the 12-month period beginning on the date of issuance (section 143(k)(12)(B)(i))";
}
relation no_loan_made_after_12_months_143k12Bi(issue: BondIssue) kind empirical {
    label en official "no loan is made to a mortgagor after the 12-month period (section 143(k)(12)(B)(i), (a)(2)(D)(ii))";
}
@source(IRC_S143_K, relation = formalizes, coverage = exact, quote = "subsection (a)(2)(D)(i) shall be applied by substituting \"12-month period\" for \"42-month period\" each place it appears")
rule TwelveMonthUseRequirementMetSubprimeRefinancing(issue: BondIssue, used: Decimal, redeemed: Decimal) strict {
    label en official "section 143(k)(12)(B)(i): the use requirement with the 12-month period";
    when subprime_refinancing_permitted_143k12A(issue);
    when proceeds_used_or_redeemed_within_12_months_143k12Bi(issue, used, redeemed);
    when used + redeemed >= 1.00;
    when no_loan_made_after_12_months_143k12Bi(issue);
    then forty_two_month_use_requirement_met_143a2D(issue);
}
@source(IRC_S143_E, relation = formalizes, coverage = exact, quote = "In the case of a targeted area residence, paragraph (1) shall be applied by substituting \"110 percent\" for \"90 percent\".")
rule ResidenceExceedsPurchasePriceLimit110Targeted(issue: BondIssue, residence: us.irc.core::Asset, mortgagor: Individual, issuer: us.irc.core::Organ, cost: Money, avg: Money) strict {
    label en official "section 143(e)(5): 110 percent is substituted for 90 percent for a targeted area residence";
    when residence_of_issue_143(issue, residence, mortgagor, issuer);
    when residence_acquisition_cost_and_average_area_price_143e(residence, TargetedAreaResidence, cost, avg);
    when cost > round(avg * 1.10, 2, "HALF_UP");
    then residence_exceeds_purchase_price_limit_143e(issue, residence);
}
@source(IRC_S143_E, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall not apply with respect to any qualified home improvement loan.")
rule HomeImprovementLoanNotSubjectToPurchasePriceLimit(issue: BondIssue, residence: us.irc.core::Asset, mortgagor: Individual, issuer: us.irc.core::Organ) strict {
    label en official "section 143(e)(6): paragraph (1) does not apply to a qualified home improvement loan; the residence is recorded as a class that never exceeds the limit";
    when residence_of_issue_143(issue, residence, mortgagor, issuer);
    when residence_acquisition_cost_and_average_area_price_143e(residence, QualifiedHomeImprovementLoanResidence, _, _);
    then residence_not_subject_to_purchase_price_limit_143e6(residence);
}
pub relation residence_not_subject_to_purchase_price_limit_143e6(residence: us.irc.core::Asset) kind institutional {
    label en official "the residence is financed by a qualified home improvement loan, so the purchase price limit does not apply";
}
relation issue_has_residence_143(issue: BondIssue) kind institutional {
    label en official "helper: some residence is recorded for the issue";
}
rule IssueHasResidence(issue: BondIssue, residence: us.irc.core::Asset, mortgagor: Individual, issuer: us.irc.core::Organ) strict {
    label en official "helper for the not_known tests";
    when residence_of_issue_143(issue, residence, mortgagor, issuer);
    then issue_has_residence_143(issue);
}
relation issue_has_residence_over_price_limit_143e(issue: BondIssue) kind institutional {
    label en official "helper: some residence of the issue exceeds its purchase price limit";
}
rule IssueHasResidenceOverPriceLimit(issue: BondIssue, residence: us.irc.core::Asset) strict {
    label en official "helper for the not_known test";
    when residence_exceeds_purchase_price_limit_143e(issue, residence);
    then issue_has_residence_over_price_limit_143e(issue);
}
@source(IRC_S143_E, relation = formalizes, coverage = exact, quote = "An issue meets the requirements of this subsection only if the acquisition cost of each residence the owner-financing of which is provided under the issue does not")
rule RequirementEMetByPurchasePrice(issue: BondIssue) strict {
    label en official "section 143(e)(1): every residence within its limit (a residence recorded with its cost and average price)";
    when issue_has_residence_143(issue);
    when not_known(issue_has_residence_over_price_limit_143e(issue));
    then issue_meets_requirement_143(issue, RequirementE);
}
relation area_purchase_price_by_class_143e2(area: us.irc.core::Organ, class: ResidenceClass143e, average_purchase_price: Money) kind empirical {
    label en official "the average area purchase price for the statistical area, determined separately for new residences and previously occupied residences (section 143(e)(2)-(4)); the price is computed under the Secretary's rules (EXTERNAL_DEPENDENCY)";
}

// =====================================================================
// §143(f): income requirement; (j) targeted areas
// =====================================================================

pub relation mortgagor_income_over_limit_143f(issue: BondIssue, mortgagor: Individual) kind institutional {
    label en official "a mortgagor's family income exceeds 115 percent (100 percent 140-percent rule of paragraph (3) aside) of the applicable median family income";
}
@source(IRC_S143_F, relation = formalizes, coverage = partial, quote = "whose family income is 115 percent or less of the applicable median family income")
rule MortgagorIncomeOverLimit(issue: BondIssue, residence: us.irc.core::Asset, mortgagor: Individual, issuer: us.irc.core::Organ, y: TaxableYear, income: Money, median: Money) strict {
    label en official "section 143(f)(1): family income above 115 percent of the applicable median";
    when residence_of_issue_143(issue, residence, mortgagor, issuer);
    when mortgagor_family_income(mortgagor, y, income);
    when applicable_median_family_income_143f(issuer, y, median);
    when income > round(median * 1.15, 2, "HALF_UP");
    when not_known(mortgagor_income_within_143f_limit(mortgagor, issuer, y));
    when not_known(disaster_area_modifications_apply_143k11(residence)); // G6404 wiring: §143(k)(11)(B) — the 140-percent rule below
    then mortgagor_income_over_limit_143f(issue, mortgagor);
}
@source(IRC_S143_K, relation = formalizes, coverage = exact, quote = "(B) Subsections (e) and (f) (relating to purchase price requirement and income requirement) shall be applied as if such residence were a targeted area residence.")
rule MortgagorIncomeOverLimit140DisasterArea(issue: BondIssue, residence: us.irc.core::Asset, mortgagor: Individual, issuer: us.irc.core::Organ, y: TaxableYear, income: Money, median: Money) strict {
    label en official "section 143(k)(11)(B) with (f)(3)(B): the 140-percent income limit for a disaster-area residence (the one-third free share of (f)(3)(A) is not modelled, see the JUDGMENT CALL above)";
    when residence_of_issue_143(issue, residence, mortgagor, issuer);
    when disaster_area_modifications_apply_143k11(residence);
    when mortgagor_family_income(mortgagor, y, income);
    when applicable_median_family_income_143f(issuer, y, median);
    when income > round(median * 1.40, 2, "HALF_UP");
    then mortgagor_income_over_limit_143f(issue, mortgagor);
}
relation issue_has_mortgagor_over_income_limit_143f(issue: BondIssue) kind institutional {
    label en official "helper: some mortgagor of the issue is over the income limit";
}
rule IssueHasMortgagorOverIncomeLimit(issue: BondIssue, mortgagor: Individual) strict {
    label en official "helper for the not_known test";
    when mortgagor_income_over_limit_143f(issue, mortgagor);
    then issue_has_mortgagor_over_income_limit_143f(issue);
}
@source(IRC_S143_F, relation = formalizes, coverage = partial, quote = "An issue meets the requirements of this subsection only if all owner-financing provided under the issue is provided for mortgagors")
rule RequirementFMetByIncomes(issue: BondIssue) strict {
    label en official "section 143(f): no mortgagor is over the limit";
    when issue_has_residence_143(issue);
    when not_known(issue_has_mortgagor_over_income_limit_143f(issue));
    then issue_meets_requirement_143(issue, RequirementF);
}

// =====================================================================
// §143(g): arbitrage and rebate; (h) targeted area; (i) no replacement
// =====================================================================

relation effective_rate_and_yield_143g2(issue: BondIssue, effective_rate_of_interest_on_mortgages_percent: Decimal, yield_on_issue_percent: Decimal) kind empirical {
    label en official "the effective rate of interest on the mortgages (all fees, charges and amounts borne by the mortgagor taken into account, except as (b)(ii)-(iii) provide) and the yield on the issue, both determined on an actuarial basis";
}
pub relation effective_rate_spread_within_limit_143g2(issue: BondIssue) kind institutional {
    label en official "the excess of the effective rate of interest on the mortgages over the yield on the issue is not greater than 1.125 percentage points";
}
@source(IRC_S143_G, relation = formalizes, coverage = exact, quote = "An issue shall be treated as meeting the requirements of this paragraph only if the excess of—")
rule EffectiveRateSpreadWithinLimit(issue: BondIssue, eff_rate: Decimal, yield_rate: Decimal) strict {
    label en official "section 143(g)(2)(A)(i)-(ii): exact decimal comparison, percentage points";
    when effective_rate_and_yield_143g2(issue, eff_rate, yield_rate);
    when not_known(has_computed_yield_143g2(issue));
    when eff_rate - yield_rate <= 1.125;
    then effective_rate_spread_within_limit_143g2(issue);
}
// ---------------------------------------------------------------------
// G4500: §143(g)(2)(B) — the amounts taken into account in the effective rate of interest
// ---------------------------------------------------------------------
// The effective rate of (A)(i) is a yield (a discount rate) and stays a case input (`effective_rate_and_yield_143g2`):
// the language has no root-finding and `pow` takes integer bases only. What (B) and (C) fix BESIDES the rate itself —
// which amounts borne by the mortgagor enter the rate, and how — is computed here item by item, so that the case
// (or an external actuarial computation) feeds the rate from the total below. NOT written: the prepayment
// assumptions of (B)(iv) (the FHA table is external data, the Secretary's adjustment a regulation, the month-end of
// an expected prepayment has no date function) and the issue price and expected maturity of (C) (issue price of
// sections 1273 and 1274 is another owner's norm); see the coverage rows of §143(g)(2)(B)(iv) and (C).
pub entity MortgageCharge143g2 {
    label en unofficial "one fee, charge, point or other amount borne by a mortgagor in connection with a mortgage (section 143(g)(2)(B))";
}
pub enum ChargeKind143g2 { FeeOrCharge; SellerPoints; ThirdPartyReceipts; ExpectedArbitrageRebate; RoutineFee; OriginationFeeOrPoints }
relation mortgage_charge_143g2B(residence: us.irc.core::Asset, item: MortgageCharge143g2, kind: ChargeKind143g2, amount: Money, usual_amount: Money) kind empirical {
    label en official "a fee, charge or other amount attributable to the mortgage or to the bond issue, its kind and amount; for ThirdPartyReceipts the amount received from a person other than the mortgagor and the usual and reasonable acquisition costs, for RoutineFee the fee and the amount charged in the area where owner-financing is not provided through qualified mortgage bonds (section 143(g)(2)(B)(i)-(iii))";
}
pub relation mortgage_charge_taken_into_account_143g2B(residence: us.irc.core::Asset, item: MortgageCharge143g2, amount: Money) kind institutional {
    label en official "the part of the charge taken into account in the effective rate of interest on the mortgage (section 143(g)(2)(B))";
}
@source(IRC_S143_G, relation = formalizes, coverage = exact, quote = "In determining the effective rate of interest on any mortgage for purposes of this paragraph, there shall be taken into account all fees, charges, and other amounts borne by the mortgagor which are attributable to the mortgage or to the bond issue.")
rule FeeOrChargeTakenIntoAccount(residence: us.irc.core::Asset, item: MortgageCharge143g2, amount: Money, usual: Money) strict {
    label en official "section 143(g)(2)(B)(i): all fees, charges and other amounts borne by the mortgagor";
    when mortgage_charge_143g2B(residence, item, FeeOrCharge, amount, usual);
    then mortgage_charge_taken_into_account_143g2B(residence, item, amount);
}
@source(IRC_S143_G, relation = formalizes, coverage = exact, quote = "(I) all points or similar charges paid by the seller of the property, and")
rule SellerPointsTakenIntoAccount(residence: us.irc.core::Asset, item: MortgageCharge143g2, amount: Money, usual: Money) strict {
    label en official "section 143(g)(2)(B)(ii)(I): points or similar charges paid by the seller are treated as borne by the mortgagor";
    when mortgage_charge_143g2B(residence, item, SellerPoints, amount, usual);
    then mortgage_charge_taken_into_account_143g2B(residence, item, amount);
}
@source(IRC_S143_G, relation = formalizes, coverage = exact, quote = "(II) the excess of the amounts received from any person other than the mortgagor by any person in connection with the acquisition of the mortgagor's interest in the property over the usual and reasonable acquisition costs")
rule ThirdPartyReceiptsExcessTakenIntoAccount(residence: us.irc.core::Asset, item: MortgageCharge143g2, received: Money, usual: Money) strict {
    label en official "section 143(g)(2)(B)(ii)(II): the excess of the amounts received from others over the usual and reasonable acquisition costs";
    when mortgage_charge_143g2B(residence, item, ThirdPartyReceipts, received, usual);
    when received > usual;
    then mortgage_charge_taken_into_account_143g2B(residence, item, round(received - usual, 2, "HALF_UP"));
}
@source(IRC_S143_G, relation = formalizes, coverage = exact, quote = "(II) the excess of the amounts received from any person other than the mortgagor by any person in connection with the acquisition of the mortgagor's interest in the property over the usual and reasonable acquisition costs")
rule ThirdPartyReceiptsWithinUsualCostsNotTakenIntoAccount(residence: us.irc.core::Asset, item: MortgageCharge143g2, received: Money, usual: Money) strict {
    label en official "section 143(g)(2)(B)(ii)(II): receipts within the usual and reasonable costs add nothing";
    when mortgage_charge_143g2B(residence, item, ThirdPartyReceipts, received, usual);
    when received <= usual;
    then mortgage_charge_taken_into_account_143g2B(residence, item, 0.00 USD);
}
@source(IRC_S143_G, relation = formalizes, coverage = exact, quote = "(I) any expected rebate of arbitrage profits, and")
rule ExpectedArbitrageRebateNotTakenIntoAccount(residence: us.irc.core::Asset, item: MortgageCharge143g2, amount: Money, usual: Money) strict {
    label en official "section 143(g)(2)(B)(iii)(I): an expected rebate of arbitrage profits is not taken into account";
    when mortgage_charge_143g2B(residence, item, ExpectedArbitrageRebate, amount, usual);
    then mortgage_charge_taken_into_account_143g2B(residence, item, 0.00 USD);
}
@source(IRC_S143_G, relation = formalizes, coverage = exact, quote = "(II) any application fee, survey fee, credit report fee, insurance charge, or similar amount to the extent such amount does not exceed amounts charged in such area")
rule RoutineFeeTakenIntoAccountAboveAreaCharge(residence: us.irc.core::Asset, item: MortgageCharge143g2, fee: Money, area: Money) strict {
    label en official "section 143(g)(2)(B)(iii)(II): a routine fee counts only above the amount charged in the area without qualified mortgage bond financing";
    when mortgage_charge_143g2B(residence, item, RoutineFee, fee, area);
    when fee > area;
    then mortgage_charge_taken_into_account_143g2B(residence, item, round(fee - area, 2, "HALF_UP"));
}
@source(IRC_S143_G, relation = formalizes, coverage = exact, quote = "(II) any application fee, survey fee, credit report fee, insurance charge, or similar amount to the extent such amount does not exceed amounts charged in such area")
rule RoutineFeeWithinAreaChargeNotTakenIntoAccount(residence: us.irc.core::Asset, item: MortgageCharge143g2, fee: Money, area: Money) strict {
    label en official "section 143(g)(2)(B)(iii)(II): a routine fee within the area charge is not taken into account";
    when mortgage_charge_143g2B(residence, item, RoutineFee, fee, area);
    when fee <= area;
    then mortgage_charge_taken_into_account_143g2B(residence, item, 0.00 USD);
}
@source(IRC_S143_G, relation = formalizes, coverage = exact, quote = "Subclause (II) shall not apply to origination fees, points, or similar amounts.")
rule OriginationFeeOrPointsTakenIntoAccountInFull(residence: us.irc.core::Asset, item: MortgageCharge143g2, amount: Money, area: Money) strict {
    label en official "section 143(g)(2)(B)(iii), last sentence: origination fees, points and similar amounts are taken into account in full";
    when mortgage_charge_143g2B(residence, item, OriginationFeeOrPoints, amount, area);
    then mortgage_charge_taken_into_account_143g2B(residence, item, amount);
}
pub relation mortgagor_borne_total_143g2B(residence: us.irc.core::Asset, total: Money) kind institutional {
    label en official "the sum of the charges taken into account in the effective rate of interest on the mortgage (section 143(g)(2)(B)); the effective rate itself stays an input of `effective_rate_and_yield_143g2`";
}
@source(IRC_S143_G, relation = formalizes, coverage = exact, quote = "In determining the effective rate of interest on any mortgage for purposes of this paragraph, there shall be taken into account all fees, charges, and other amounts borne by the mortgagor which are attributable to the mortgage or to the bond issue.")
rule MortgagorBorneTotal(residence: us.irc.core::Asset, item: MortgageCharge143g2, amount: Money) strict {
    label en official "section 143(g)(2)(B): the total over the items";
    when mortgage_charge_taken_into_account_143g2B(residence, item, amount);
    then mortgagor_borne_total_143g2B(residence, sum(collect all a: Money, i: MortgageCharge143g2 where mortgage_charge_taken_into_account_143g2B(residence, i, a), empty: 0.00 USD));
}
relation nonpurpose_earnings_and_yield_earnings_143g3A(issue: BondIssue, earned_on_nonpurpose_investments: Money, earned_at_yield_rate: Money, income_attributable_to_excess: Money) kind empirical {
    label en official "the amount earned on nonpurpose investments, the amount that would have been earned at the yield on the issue, and the income attributable to the excess";
}
relation excess_paid_or_credited_to_mortgagors_promptly_143g3A(issue: BondIssue, paid_or_credited: Money) kind empirical {
    label en official "the amount paid or credited to the mortgagors as rapidly as may be practicable";
}
relation unused_paragraph_2_amount_143g3C(issue: BondIssue, amount: Money) kind empirical {
    label en official "the unused paragraph (2) amount by which the required amount is reduced";
}
pub relation arbitrage_required_amount_143g3A(issue: BondIssue, amount: Money) kind institutional {
    label en official "the amount required to be paid or credited to mortgagors: the excess of the nonpurpose earnings over what would have been earned at the yield, plus the income on that excess, less the unused paragraph (2) amount";
}
@source(IRC_S143_G, relation = formalizes, coverage = exact, quote = "An issue shall be treated as meeting the requirements of this paragraph only if an amount equal to the sum of—")
rule ArbitrageRequiredAmount(issue: BondIssue, earned: Money, at_yield: Money, on_excess: Money, unused: Money) strict {
    label en official "section 143(g)(3)(A)(i)-(ii) and (C)(i): (earned - at yield) + income on excess - unused amount, not below zero";
    when nonpurpose_earnings_and_yield_earnings_143g3A(issue, earned, at_yield, on_excess);
    when unused_paragraph_2_amount_143g3C(issue, unused);
    then arbitrage_required_amount_143g3A(issue, max(0.00 USD, round((earned - at_yield) + on_excess - unused, 2, "HALF_UP")));
}
pub relation rebate_requirement_of_143g3_met(issue: BondIssue) kind institutional {
    label en official "the requirement of paragraph (3) is met: the required amount is paid or credited to the mortgagors as rapidly as practicable, or the issuer's election to pay the United States (90 percent at least every 5 years, 100 percent within 60 days after the last redemption) is made";
}
@source(IRC_S143_G, relation = formalizes, coverage = exact, quote = "is paid or credited to the mortgagors as rapidly as may be practicable.")
rule RebateRequirementMetByPayment(issue: BondIssue, required: Money, paid: Money) strict {
    label en official "section 143(g)(3)(A)";
    when arbitrage_required_amount_143g3A(issue, required);
    when excess_paid_or_credited_to_mortgagors_promptly_143g3A(issue, paid);
    when paid >= required;
    then rebate_requirement_of_143g3_met(issue);
}
relation issuer_elects_before_issuing_to_pay_united_states_143g3D(issue: BondIssue) kind empirical {
    label en official "the issuer elects before issuing the bonds to pay over to the United States the amounts of clauses (i) and (ii)";
}
relation payments_to_united_states_143g3D(issue: BondIssue, five_year_payment_percent: Decimal, final_payment_percent: Decimal, days_after_last_redemption: Integer) kind empirical {
    label en official "the percentage of the aggregate amount paid at least once each 5 years after issuance, and the percentage paid after the redemption of the last bond with the days after that redemption";
}
@source(IRC_S143_G, relation = formalizes, coverage = exact, quote = "Subparagraph (A) shall be satisfied with respect to any issue if the issuer elects before issuing the bonds to pay over to the United States—")
rule RebateRequirementMetByElection(issue: BondIssue, p5: Decimal, pf: Decimal, days: Integer) strict {
    label en official "section 143(g)(3)(D)(i)-(ii)";
    when issuer_elects_before_issuing_to_pay_united_states_143g3D(issue);
    when payments_to_united_states_143g3D(issue, p5, pf, days);
    when p5 >= 0.90;
    when pf >= 1.00;
    when days <= 60;
    then rebate_requirement_of_143g3_met(issue);
}
relation veterans_issue_143g1(issue: BondIssue) kind empirical {
    label en official "the issue is an issue described in subsection (b)(1)";
}
@source(IRC_S143_G, relation = formalizes, coverage = exact, quote = "An issue meets the requirements of this subsection only if such issue meets the requirements of paragraph (2) of this subsection and, in the case of an issue described")
rule RequirementGMetOrdinary(issue: BondIssue) strict {
    label en official "section 143(g)(1): paragraph (2), and for a veterans issue also paragraph (3)";
    when effective_rate_spread_within_limit_143g2(issue);
    when not_known(veterans_issue_143g1(issue));
    then issue_meets_requirement_143(issue, RequirementG);
}
@source(IRC_S143_G, relation = formalizes, coverage = exact, quote = "An issue meets the requirements of this subsection only if such issue meets the requirements of paragraph (2) of this subsection and, in the case of an issue described")
rule RequirementGMetVeterans(issue: BondIssue) strict {
    label en official "section 143(g)(1): a veterans issue meets both paragraphs (2) and (3)";
    when effective_rate_spread_within_limit_143g2(issue);
    when veterans_issue_143g1(issue);
    when rebate_requirement_of_143g3_met(issue);
    then issue_meets_requirement_143(issue, RequirementG);
}
relation proceeds_for_owner_financing_and_targeted_143h(issue: BondIssue, owner_financing: Money, made_available_for_targeted_area_residences_for_one_year: Money) kind empirical {
    label en official "the proceeds devoted to owner-financing, and the amount made available (with reasonable diligence) for targeted area residences for at least 1 year after owner-financing is first made available for them";
}
relation targeted_area_mortgages_average_3_years_143h2(issue: BondIssue, average_annual_principal_of_mortgages_in_targeted_areas: Money) kind empirical {
    label en official "the average annual aggregate principal amount of mortgages executed during the immediately preceding 3 calendar years for single-family owner-occupied residences in targeted areas within the jurisdiction of the issuing authority";
}
pub relation targeted_area_requirement_met_143h(issue: BondIssue) kind institutional {
    label en official "at least 20 percent of the owner-financing proceeds is made available for targeted area residences, or the amount made available is at least the amount the 40 percent cap of paragraph (2) allows to be required";
}
@source(IRC_S143_H, relation = formalizes, coverage = exact, quote = "An issue meets the requirements of this subsection only if at least 20 percent of the proceeds of the issue which are devoted to providing owner-financing is made")
rule TargetedAreaRequirementMetByTwentyPercent(issue: BondIssue, owner: Money, targeted: Money) strict {
    label en official "section 143(h)(1): 20 percent or more";
    when proceeds_for_owner_financing_and_targeted_143h(issue, owner, targeted);
    when targeted * 5 >= owner;
    then targeted_area_requirement_met_143h(issue);
}
@source(IRC_S143_H, relation = formalizes, coverage = exact, quote = "Nothing in paragraph (1) shall be treated as requiring the making available of an amount which exceeds 40 percent of the average annual aggregate principal amount of")
rule TargetedAreaRequirementMetByFortyPercentCap(issue: BondIssue, owner: Money, targeted: Money, avg: Money) strict {
    label en official "section 143(h)(2): nothing requires making available an amount above 40 percent of the 3-year average annual principal of targeted area mortgages";
    when proceeds_for_owner_financing_and_targeted_143h(issue, owner, targeted);
    when targeted_area_mortgages_average_3_years_143h2(issue, avg);
    when targeted >= round(avg * 0.40, 2, "HALF_UP");
    then targeted_area_requirement_met_143h(issue);
}
@source(IRC_S143_H, relation = formalizes, coverage = exact, quote = "An issue meets the requirements of this subsection only if at least 20 percent of the proceeds of the issue which are devoted to providing owner-financing is made")
rule RequirementHMet(issue: BondIssue) strict {
    label en official "section 143(h)";
    when targeted_area_requirement_met_143h(issue);
    then issue_meets_requirement_143(issue, RequirementH);
}
relation proceeds_used_to_acquire_or_replace_existing_mortgage_143i1A(issue: BondIssue, amount: Money) kind empirical {
    label en official "the proceeds used to acquire or replace existing mortgages";
}
relation replacement_of_construction_bridge_or_rehabilitation_mortgage_143i1B(issue: BondIssue, amount: Money) kind empirical {
    label en official "the part of the proceeds that replaces construction period loans, bridge loans or similar temporary initial financing, or (in the case of a qualified rehabilitation) an existing mortgage";
}
relation contract_for_deed_land_143i1C(issue: BondIssue, principal_residence_on_land: Boolean, family_income_percent_of_median: Decimal, title_passes_only_on_full_payment: Boolean, remedy_is_forfeiture: Boolean, amount: Money) kind empirical {
    label en official "land possessed under a contract for deed by a mortgagor whose principal residence (section 121) is located on it and whose family income is not more than 50 percent of the applicable median family income, with the contract's characteristics (legal title passes only on full payment; forfeiture rather than foreclosure)";
}
pub relation contract_for_deed_not_an_existing_mortgage_143i1C(issue: BondIssue) kind institutional {
    label en official "the contract for deed is not treated as an existing mortgage";
}
@source(IRC_S143_I, relation = formalizes, coverage = exact, quote = "In the case of land possessed under a contract for deed by a mortgagor—")
rule ContractForDeedNotAnExistingMortgage(issue: BondIssue, income: Decimal, amount: Money) strict {
    label en official "section 143(i)(1)(C)(i)-(ii)";
    when contract_for_deed_land_143i1C(issue, true, income, true, true, amount);
    when income <= 0.50;
    then contract_for_deed_not_an_existing_mortgage_143i1C(issue);
}
pub relation existing_mortgage_replacement_amount_143i1(issue: BondIssue, amount: Money) kind institutional {
    label en official "the proceeds used to acquire or replace existing mortgages, net of the temporary financing and rehabilitation replacements of subparagraph (B)";
}
@source(IRC_S143_I, relation = formalizes, coverage = exact, quote = "Under regulations prescribed by the Secretary, the replacement of—")
rule ExistingMortgageReplacementAmount(issue: BondIssue, used: Money, temp: Money) strict {
    label en official "section 143(i)(1)(A)-(B): the amount replacing existing mortgages beyond the excepted replacements, not below zero";
    when proceeds_used_to_acquire_or_replace_existing_mortgage_143i1A(issue, used);
    when replacement_of_construction_bridge_or_rehabilitation_mortgage_143i1B(issue, temp);
    then existing_mortgage_replacement_amount_143i1(issue, max(0.00 USD, round(used - temp, 2, "HALF_UP")));
}
@source(IRC_S143_I, relation = formalizes, coverage = exact, quote = "An issue meets the requirements of this subsection only if no part of the proceeds of such issue is used to acquire or replace existing mortgages.")
rule RequirementIMetNoReplacement(issue: BondIssue, amount: Money) strict {
    label en official "section 143(i)(1)(A): no part of the proceeds is used to acquire or replace existing mortgages";
    when existing_mortgage_replacement_amount_143i1(issue, amount);
    when amount <= 0.00 USD;
    when mortgage_assumption_conditions_met_143i2(issue);
    then issue_meets_requirement_143(issue, RequirementI);
}
relation assumption_only_if_requirements_met_143i2(issue: BondIssue) kind empirical {
    label en official "each mortgage may be assumed only if the requirements of (c), (d), (e) and (f)(1) or (3)(B) (whichever applies) are met with respect to the assumption";
}
pub relation mortgage_assumption_conditions_met_143i2(issue: BondIssue) kind institutional {
    label en official "the assumption condition of paragraph (2) is met";
}
@source(IRC_S143_I, relation = formalizes, coverage = exact, quote = "An issue meets the requirements of this subsection only if each mortgage with respect to which owner-financing has been provided under such issue may be assumed only if")
rule MortgageAssumptionConditionsMet(issue: BondIssue) strict {
    label en official "section 143(i)(2)";
    when assumption_only_if_requirements_met_143i2(issue);
    then mortgage_assumption_conditions_met_143i2(issue);
}
relation area_is_qualified_census_tract_143j1A(area: us.irc.core::Organ) kind empirical {
    label en official "the area is a qualified census tract (section 42(d)(5)(B)(ii)(I)), determined on the basis of the most recent decennial census for which data are available";
}
relation area_of_chronic_economic_distress_143j1B_designation(area: us.irc.core::Organ, designated_by_state: Boolean, approved_by_secretary_and_hud: Boolean) kind empirical {
    label en official "the area is designated by the State as meeting its standards for this subsection, and the designation is approved by the Secretary and the Secretary of Housing and Urban Development (whose criteria are the condition of the housing stock, the need of residents, the potential of owner-financing, and the existence of a housing assistance plan)";
}
pub relation targeted_area_143j(area: us.irc.core::Organ) kind institutional {
    label en official "a targeted area: a qualified census tract or an area of chronic economic distress";
}
@source(IRC_S143_J, relation = formalizes, coverage = exact, quote = "(A) a qualified census tract, or")
rule TargetedAreaByCensusTract(area: us.irc.core::Organ) strict {
    label en official "section 143(j)(1)(A) with (2)(B)";
    when area_is_qualified_census_tract_143j1A(area);
    then targeted_area_143j(area);
}
@source(IRC_S143_J, relation = formalizes, coverage = exact, quote = "(B) an area of chronic economic distress.")
rule TargetedAreaByChronicDistress(area: us.irc.core::Organ) strict {
    label en official "section 143(j)(1)(B) with (3)(A)(i)-(ii)";
    when area_of_chronic_economic_distress_143j1B_designation(area, true, true);
    then targeted_area_143j(area);
}

// =====================================================================
// §143(k): definitions
// =====================================================================

relation financing_is_owner_financing_143k1(financing: us.irc.core::Asset) kind empirical {
    label en official "the financing is owner-financing";
}
pub relation mortgage_143k1(financing: us.irc.core::Asset) kind institutional {
    label en official "a mortgage is any owner-financing";
}
@source(IRC_S143_K, relation = formalizes, coverage = exact, quote = "The term \"mortgage\" means any owner-financing.")
rule MortgageIsOwnerFinancing(financing: us.irc.core::Asset) strict {
    label en official "section 143(k)(1)";
    when financing_is_owner_financing_143k1(financing);
    then mortgage_143k1(financing);
}
pub enum StatisticalAreaKind143k2 { MetropolitanStatisticalArea; CountyOrPartOutsideMetropolitanArea; OtherAreaKind; }
relation area_kind_143k2(area: us.irc.core::Organ, kind: StatisticalAreaKind143k2) kind empirical {
    label en official "the kind of area";
}
pub relation statistical_area_143k2A(area: us.irc.core::Organ) kind institutional {
    label en official "a statistical area: a metropolitan statistical area (as defined by the Secretary of Commerce), or any county (or portion) outside one";
}
@source(IRC_S143_K, relation = formalizes, coverage = exact, quote = "(i) a metropolitan statistical area, and")
rule StatisticalAreaMetropolitan(area: us.irc.core::Organ) strict {
    label en official "section 143(k)(2)(A)(i), (B)";
    when area_kind_143k2(area, MetropolitanStatisticalArea);
    then statistical_area_143k2A(area);
}
@source(IRC_S143_K, relation = formalizes, coverage = exact, quote = "(ii) any county (or the portion thereof) which is not within a metropolitan statistical area.")
rule StatisticalAreaCountyOutside(area: us.irc.core::Organ) strict {
    label en official "section 143(k)(2)(A)(ii)";
    when area_kind_143k2(area, CountyOrPartOutsideMetropolitanArea);
    then statistical_area_143k2A(area);
}
relation state_portion_not_within_a_county_142k2D(area: us.irc.core::Organ, county_equivalent_designated_by_secretary: Boolean) kind empirical {
    label en official "a portion of a State not within a county, with the area the Secretary designates as the equivalent of a county";
}
pub relation county_equivalent_143k2D(area: us.irc.core::Organ) kind institutional {
    label en official "for a portion of a State not within a county the area designated by the Secretary is the equivalent of a county";
}
@source(IRC_S143_K, relation = formalizes, coverage = exact, quote = "In the case of any portion of a State which is not within a county, subparagraphs (A)(ii) and (C) shall be applied by substituting for \"county\" an area designated by the")
rule CountyEquivalentDesignated(area: us.irc.core::Organ) strict {
    label en official "section 143(k)(2)(D)";
    when state_portion_not_within_a_county_142k2D(area, true);
    then county_equivalent_143k2D(area);
}
relation acquisition_cost_components_143k3(residence: us.irc.core::Asset, cost_as_completed_unit: Money, settlement_or_financing_costs: Money, family_services_value: Money, land_owned_two_years_before_construction: Money, rehabilitation_cost: Money, qualified_rehabilitation_loan: Boolean) kind empirical {
    label en official "the cost of acquiring the residence as a completed unit, the usual and reasonable settlement or financing costs, the value of services by the mortgagor or family in completing it, the cost of land owned at least 2 years before construction began, the cost of a rehabilitation, and whether the loan is a qualified rehabilitation loan";
}
pub relation acquisition_cost_143k3(residence: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the acquisition cost: the cost as a completed residential unit, not including usual and reasonable settlement or financing costs, the value of family services, and the cost of land owned at least 2 years before construction; for a qualified rehabilitation loan the cost of the rehabilitation is included";
}
@source(IRC_S143_K, relation = formalizes, coverage = exact, quote = "The term \"acquisition cost\" means the cost of acquiring the residence as a completed residential unit.")
rule AcquisitionCostDefined(residence: us.irc.core::Asset, cost: Money, settle: Money, services: Money, land: Money, rehab: Money) strict {
    label en official "section 143(k)(3)(A)-(B) for an ordinary residence";
    when acquisition_cost_components_143k3(residence, cost, settle, services, land, rehab, false);
    then acquisition_cost_143k3(residence, max(0.00 USD, round(cost - settle - services - land, 2, "HALF_UP")));
}
@source(IRC_S143_K, relation = formalizes, coverage = exact, quote = "In the case of a qualified rehabilitation loan, for purposes of subsection (e), the term \"acquisition cost\" includes the cost of the rehabilitation.")
rule AcquisitionCostIncludesRehabilitation(residence: us.irc.core::Asset, cost: Money, settle: Money, services: Money, land: Money, rehab: Money) strict {
    label en official "section 143(k)(3)(C): for a qualified rehabilitation loan, for purposes of (e), the cost of the rehabilitation is included";
    when acquisition_cost_components_143k3(residence, cost, settle, services, land, rehab, true);
    then acquisition_cost_143k3(residence, max(0.00 USD, round(cost - settle - services - land + rehab, 2, "HALF_UP")));
}
relation home_improvement_financing_143k4(financing: us.irc.core::Asset, amount: Money, is_alteration_repair_or_improvement_of_existing_residence_by_owner: Boolean, protects_or_improves_livability_or_energy_efficiency: Boolean) kind empirical {
    label en official "the financing of alterations, repairs and improvements on or in connection with an existing residence by its owner, and whether the items substantially protect or improve the basic livability or energy efficiency of the property";
}
pub relation qualified_home_improvement_loan_143k4(financing: us.irc.core::Asset) kind institutional {
    label en official "a qualified home improvement loan: financing, in an amount not above $15,000, of alterations, repairs and improvements by the owner of an existing residence, only of items that substantially protect or improve basic livability or energy efficiency";
}
@source(IRC_S143_K, relation = formalizes, coverage = exact, quote = "The term \"qualified home improvement loan\" means the financing (in an amount which does not exceed $15,000)—")
rule QualifiedHomeImprovementLoanDefined(financing: us.irc.core::Asset, amount: Money) strict {
    label en official "section 143(k)(4)(A)-(B): amount at most $15,000";
    when home_improvement_financing_143k4(financing, amount, true, true);
    when amount <= 15000.00 USD;
    then qualified_home_improvement_loan_143k4(financing);
}
relation rehabilitation_facts_143k5(residence: us.irc.core::Asset, years_between_first_use_and_work_start: Integer, external_walls_retained_as_external_percent: Decimal, external_walls_retained_as_any_walls_percent: Decimal, internal_framework_retained_percent: Decimal, expenditures_percent_of_adjusted_basis: Decimal, mortgagor_is_first_resident_after_completion: Boolean) kind empirical {
    label en official "the facts of a rehabilitation: years between the building's first use and the start of work, the retention shares of external walls (as external, and as external or internal walls) and of the internal structural framework, the expenditures as a fraction of the mortgagor's adjusted basis, and whether the mortgagor is the first resident after completion";
}
pub relation qualified_rehabilitation_143k5B(residence: us.irc.core::Asset) kind institutional {
    label en official "a qualified rehabilitation: at least 20 years between first use and the start of work, at least 50 percent of the external walls retained as external walls, at least 75 percent as walls, at least 75 percent of the internal framework retained, and expenditures at least 25 percent of the mortgagor's adjusted basis";
}
@source(IRC_S143_K, relation = formalizes, coverage = exact, quote = "(i) there is a period of at least 20 years between the date on which the building was first used and the date on which the physical work on such rehabilitation begins,")
rule QualifiedRehabilitationDefined(residence: us.irc.core::Asset, yrs: Integer, ext: Decimal, walls: Decimal, frame: Decimal, exp: Decimal, first: Boolean) strict {
    label en official "section 143(k)(5)(B)(i)-(iii)";
    when rehabilitation_facts_143k5(residence, yrs, ext, walls, frame, exp, first);
    when yrs >= 20;
    when ext >= 0.50;
    when walls >= 0.75;
    when frame >= 0.75;
    when exp >= 0.25;
    then qualified_rehabilitation_143k5B(residence);
}
pub relation qualified_rehabilitation_loan_143k5A(residence: us.irc.core::Asset) kind institutional {
    label en official "a qualified rehabilitation loan: owner-financing in connection with a qualified rehabilitation (or the acquisition of a residence after one), only if the mortgagor is the first resident after completion";
}
@source(IRC_S143_K, relation = formalizes, coverage = exact, quote = "The term \"qualified rehabilitation loan\" means any owner-financing provided in connection with—")
rule QualifiedRehabilitationLoanDefined(residence: us.irc.core::Asset, yrs: Integer, ext: Decimal, walls: Decimal, frame: Decimal, exp: Decimal) strict {
    label en official "section 143(k)(5)(A)";
    when rehabilitation_facts_143k5(residence, yrs, ext, walls, frame, exp, true);
    when qualified_rehabilitation_143k5B(residence);
    then qualified_rehabilitation_loan_143k5A(residence);
}
relation actuarial_determinations_143k6(issue: BondIssue, made_on_actuarial_basis_with_present_value: Boolean) kind empirical {
    label en official "all determinations of yield, effective interest rates and amounts paid or credited to mortgagors or paid to the United States under subsection (g) are made on an actuarial basis taking into account the present value of money";
}
pub relation determinations_made_on_actuarial_basis_143k6(issue: BondIssue) kind institutional {
    label en official "the determinations are made on an actuarial basis";
}
@source(IRC_S143_K, relation = formalizes, coverage = exact, quote = "All determinations of yield, effective interest rates, and amounts required to be paid or credited to mortgagors or paid to the United States under subsection (g) shall")
rule DeterminationsMadeOnActuarialBasis(issue: BondIssue) strict {
    label en official "section 143(k)(6)";
    when actuarial_determinations_143k6(issue, true);
    then determinations_made_on_actuarial_basis_143k6(issue);
}
relation residence_unit_facts_143k7(residence: us.irc.core::Asset, units_in_residence: Integer, one_unit_occupied_by_owner: Boolean, years_since_first_occupied: Integer, targeted_area_two_family: Boolean, mortgagor_meets_143f3B: Boolean) kind empirical {
    label en official "the number of family units of the residence, whether one unit is occupied by its owner, the years since it was first occupied at the time the mortgage is executed, and for a 2-family targeted area residence whether the mortgagor's income meets subsection (f)(3)(B)";
}
pub relation multi_family_residence_counts_as_single_family_143k7(residence: us.irc.core::Asset) kind institutional {
    label en official "a 2, 3 or 4 family residence, one unit of which is occupied by the owner and which was first occupied at least 5 years before the mortgage is executed, counts as single-family and owner-occupied (the 5 years do not apply to a 2-family targeted area residence whose mortgagor meets (f)(3)(B)); the extension does not apply for (h)(2)";
}
@source(IRC_S143_K, relation = formalizes, coverage = exact, quote = "Except for purposes of subsection (h)(2), the terms \"single-family\" and \"owner-occupied\", when used with respect to residences, include 2, 3, or 4 family residences—")
rule MultiFamilyResidenceCountsAsSingleFamily(residence: us.irc.core::Asset, units: Integer, years: Integer) strict {
    label en official "section 143(k)(7)(A)-(B)";
    when residence_unit_facts_143k7(residence, units, true, years, false, false);
    when units >= 2;
    when units <= 4;
    when years >= 5;
    then multi_family_residence_counts_as_single_family_143k7(residence);
}
@source(IRC_S143_K, relation = formalizes, coverage = exact, quote = "Subparagraph (B) shall not apply to any 2-family residence if the residence is a targeted area residence and the family income of the mortgagor meets the requirement of")
rule TwoFamilyTargetedAreaResidenceCountsWithoutFiveYears(residence: us.irc.core::Asset, years: Integer) strict {
    label en official "section 143(k)(7), last sentence";
    when residence_unit_facts_143k7(residence, 2, true, years, true, true);
    then multi_family_residence_counts_as_single_family_143k7(residence);
}
relation cooperative_housing_unit_143k8(unit: us.irc.core::Asset, treated_as_owned_by_stockholder_entitled_to_occupy: Boolean, corporation_indebtedness_allocable: Money) kind empirical {
    label en official "a dwelling unit in a cooperative housing corporation (section 216(b)(1)) and the corporation's indebtedness allocable to it";
}
pub relation cooperative_unit_treated_as_owned_143k8(unit: us.irc.core::Asset, shareholder_indebtedness: Money) kind institutional {
    label en official "each dwelling unit is treated as if actually owned by the stockholder entitled to occupy it, and the allocable indebtedness of the corporation as if it were the shareholder's indebtedness";
}
@source(IRC_S143_K, relation = formalizes, coverage = exact, quote = "In the case of any cooperative housing corporation—")
rule CooperativeUnitTreatedAsOwned(unit: us.irc.core::Asset, debt: Money) strict {
    label en official "section 143(k)(8)(A)(i)-(ii)";
    when cooperative_housing_unit_143k8(unit, true, debt);
    then cooperative_unit_treated_as_owned_143k8(unit, debt);
}
relation cooperative_issue_not_in_targeted_area_143k8B(issue: BondIssue, combined_with_other_issues_by_regulation: Boolean) kind empirical {
    label en official "an issue to finance a cooperative housing corporation with respect to cooperative housing not located in a targeted area may, to the extent provided in regulations, be combined with other issues for the (h) test";
}
pub relation cooperative_issue_may_be_combined_143k8B(issue: BondIssue) kind institutional {
    label en official "the cooperative issue may be combined with 1 or more other issues for purposes of subsection (h), to the extent regulations provide (EXTERNAL_DEPENDENCY: the regulations)";
}
@source(IRC_S143_K, relation = formalizes, coverage = exact, quote = "In the case of any issue to provide financing to a cooperative housing corporation with respect to cooperative housing not located in a targeted area, to the extent")
rule CooperativeIssueMayBeCombined(issue: BondIssue) strict {
    label en official "section 143(k)(8)(B)";
    when cooperative_issue_not_in_targeted_area_143k8B(issue, true);
    then cooperative_issue_may_be_combined_143k8B(issue);
}
relation cooperative_housing_corporation_216b1_143k8C(corp: Person) kind empirical {
    label en official "the corporation is a cooperative housing corporation within section 216(b)(1)";
}
pub relation cooperative_housing_corporation_143k8C(corp: Person) kind institutional {
    label en official "a cooperative housing corporation has the meaning given by section 216(b)(1)";
}
@source(IRC_S143_K, relation = formalizes, coverage = exact, quote = "The term \"cooperative housing corporation\" has the meaning given to such term by section 216(b)(1).")
rule CooperativeHousingCorporationDefined(corp: Person) strict {
    label en official "section 143(k)(8)(C)";
    when cooperative_housing_corporation_216b1_143k8C(corp);
    then cooperative_housing_corporation_143k8C(corp);
}
relation limited_equity_cooperative_143k9(project: us.irc.core::Asset, corp: Person, election_by_corporation_at_issuance_143k9d: Boolean, stock_consideration_within_transfer_value_143k9di: Boolean, surplus_assets_used_only_for_public_benefit_143k9dii: Boolean, issue_after_date_specified_143a1B: Boolean) kind empirical {
    label en official "limited equity cooperative housing: the corporation makes an election at issuance, the consideration for stock does not exceed the first stockholder's consideration (cost-of-living adjusted) plus improvements plus principal amortization, the corporation's surplus assets are used only for public benefit or the corporation itself, and whether the bond is issued after the date specified in subsection (a)(1)(B)";
}
pub relation limited_equity_cooperative_treated_as_rental_143k9A(project: us.irc.core::Asset) kind institutional {
    label en official "limited equity cooperative housing is treated as residential rental property and not as owner-occupied housing; its bonds are subject to the requirements of qualified residential rental projects (section 142(d)), unless the bond is issued after the date specified in subsection (a)(1)(B)";
}
@source(IRC_S143_K, relation = formalizes, coverage = exact, quote = "(i) any limited equity cooperative housing shall be treated as residential rental property and not as owner-occupied housing, and")
rule LimitedEquityCooperativeTreatedAsRental(project: us.irc.core::Asset, corp: Person) strict {
    label en official "section 143(k)(9)(A)-(B), (D)(i)-(iii), (G): the election is irrevocable once made (see the prohibition below)";
    when limited_equity_cooperative_143k9(project, corp, true, true, true, false);
    then limited_equity_cooperative_treated_as_rental_143k9A(project);
}
relation cooperative_election_143k9(corp: Person) kind empirical {
    label en official "the cooperative housing corporation made the election under paragraph (9)";
}
relation cooperative_revokes_election_143k9g(corp: Person) kind empirical {
    label en official "the corporation revokes the election";
}
@source(IRC_S143_K, relation = formalizes, coverage = exact, quote = "Any election under this paragraph, once made, shall be irrevocable.")
rule Section143k9gIrrevocableElectionRule strict {
    for corp: Person;
    when cooperative_election_143k9(corp);
    then prohibition Section143k9gElectionRevocationBar {
        bearer corp;
        action cooperative_revokes_election_143k9g(corp);
        window [-infinity, infinity];
    };
}
relation cooperative_election_period_142d2_143k9e(corp: Person, qualified_project_period_running: Boolean) kind empirical {
    label en official "the qualified project period (section 142(d)(2)) is running for the corporation";
}
pub relation section_216_not_applied_to_electing_cooperative_143k9e(corp: Person) kind institutional {
    label en official "section 216 does not apply to the electing corporation (or a successor) during the qualified project period";
}
@source(IRC_S143_K, relation = formalizes, coverage = exact, quote = "If a cooperative housing corporation makes an election under this paragraph, section 216 shall not apply with respect to such corporation (or any successor thereof)")
rule Section216NotAppliedToElectingCooperative(corp: Person) strict {
    label en official "section 143(k)(9)(E)";
    when cooperative_election_143k9(corp);
    when cooperative_election_period_142d2_143k9e(corp, true);
    then section_216_not_applied_to_electing_cooperative_143k9e(corp);
}
relation cooperative_continues_to_qualify_143k9f(corp: Person) kind empirical {
    label en official "the cooperative housing corporation continues to be a qualified cooperative housing corporation at all times during the qualified project period";
}
pub relation limited_equity_treatment_continues_143k9f(corp: Person) kind institutional {
    label en official "subparagraph (A)(i) applies to limited equity cooperative housing only if the corporation continues to be qualified at all times during the qualified project period";
}
@source(IRC_S143_K, relation = formalizes, coverage = exact, quote = "Subparagraph (A)(i) shall not apply to limited equity cooperative housing unless the cooperative housing corporation continues to be a qualified cooperative housing")
rule LimitedEquityTreatmentContinues(corp: Person) strict {
    label en official "section 143(k)(9)(F)";
    when cooperative_election_143k9(corp);
    when cooperative_continues_to_qualify_143k9f(corp);
    then limited_equity_treatment_continues_143k9f(corp);
}
relation high_housing_cost_area_143f5_143k10(residence: us.irc.core::Asset) kind empirical {
    label en official "the residence is located in a high housing cost area (section 143(f)(5))";
}
relation governmental_financing_143k10(residence: us.irc.core::Asset, amount: Money, resale_restricted_9_years_or_deferred_interest_with_appreciation_share: Boolean, provided_through_tax_exempt_pab: Boolean) kind empirical {
    label en official "financing provided by a governmental unit under a qualified program: (i) restricting for 9 years the resale to a qualifying purchaser at an index price reflecting less than the full appreciation, or (ii) with deferred or reduced interest and a share of the appreciation for the governmental unit, and whether it is provided directly or indirectly through a tax-exempt private activity bond";
}
relation acquisition_cost_before_k10_143k10(residence: us.irc.core::Asset, amount: Money) kind empirical {
    label en official "the acquisition cost of the residence before the reduction of paragraph (10)";
}
pub relation acquisition_cost_reduced_by_governmental_financing_143k10(residence: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "in a high housing cost area the governmental unit's interest by reason of qualified program financing is disregarded (other than for subsection (m)) and the acquisition cost taken into account under (e) is reduced by the financing";
}
@source(IRC_S143_K, relation = formalizes, coverage = exact, quote = "In the case of a residence which is located in a high housing cost area (as defined in section 143(f)(5)), the interest of a governmental unit in such residence by")
rule AcquisitionCostReducedByGovernmentalFinancing(residence: us.irc.core::Asset, financing: Money, cost: Money) strict {
    label en official "section 143(k)(10)(A)-(B): not for financing provided through a tax-exempt private activity bond";
    when high_housing_cost_area_143f5_143k10(residence);
    when governmental_financing_143k10(residence, financing, true, false);
    when acquisition_cost_before_k10_143k10(residence, cost);
    then acquisition_cost_reduced_by_governmental_financing_143k10(residence, max(0.00 USD, round(cost - financing, 2, "HALF_UP")));
}
relation residence_in_disaster_area_143k11(residence: us.irc.core::Asset, disaster_declared_on: Date, financing_provided_on: Date, bond_issued_on: Date) kind empirical {
    label en official "the residence is in an area determined by the President to warrant assistance under the Stafford Act, the disaster declaration date, the date financing is provided and the date the bond is issued";
}
pub relation disaster_area_modifications_apply_143k11(residence: us.irc.core::Asset) kind institutional {
    label en official "financing provided within 2 years after the disaster declaration, for bonds issued after May 1, 2008 and before January 1, 2010: subsection (d) does not apply and subsections (e) and (f) apply as if the residence were a targeted area residence";
}
@source(IRC_S143_K, relation = formalizes, coverage = exact, quote = "In the case of a residence located in an area determined by the President to warrant assistance from the Federal Government under the Robert T. Stafford Disaster Relief")
rule DisasterAreaModificationsApply(residence: us.irc.core::Asset, declared: Date, provided: Date, issued: Date) strict {
    label en official "section 143(k)(11), lead-in and last sentence";
    when residence_in_disaster_area_143k11(residence, declared, provided, issued);
    when provided >= declared;
    when provided <= add_calendar_period(declared, 2 calendar_year);
    when issued > @2008-05-01;
    when issued < @2010-01-01;
    then disaster_area_modifications_apply_143k11(residence);
}
relation refinancing_of_subprime_loan_143k12(issue: BondIssue, loan_originated_on: Date, loan_is_adjustable_rate_single_family: Boolean, issuer_determined_hardship_likely: Boolean, bond_issued_on: Date) kind empirical {
    label en official "a mortgage refinanced with qualified mortgage issue proceeds, originally a qualified subprime loan: an adjustable rate single-family residential mortgage made after December 31, 2001 and before January 1, 2008 that the issuer determines would be reasonably likely to cause financial hardship if not refinanced";
}
pub relation qualified_subprime_loan_143k12C(issue: BondIssue) kind institutional {
    label en official "a qualified subprime loan";
}
@source(IRC_S143_K, relation = formalizes, coverage = exact, quote = "The term \"qualified subprime loan\" means an adjustable rate single-family residential mortgage loan made after December 31, 2001, and before January 1, 2008, that the")
rule QualifiedSubprimeLoanDefined(issue: BondIssue, made: Date, issued: Date) strict {
    label en official "section 143(k)(12)(C)";
    when refinancing_of_subprime_loan_143k12(issue, made, true, true, issued);
    when made > @2001-12-31;
    when made < @2008-01-01;
    then qualified_subprime_loan_143k12C(issue);
}
pub relation subprime_refinancing_permitted_143k12A(issue: BondIssue) kind institutional {
    label en official "notwithstanding subsection (i)(1) the proceeds may be used to refinance a mortgage originally financed through a qualified subprime loan, for bonds issued on or before December 31, 2010, with 12 months in place of 42 months, no subsection (d) requirement, and market value in place of acquisition cost for (e)";
}
@source(IRC_S143_K, relation = formalizes, coverage = exact, quote = "Notwithstanding the requirements of subsection (i)(1), the proceeds of a qualified mortgage issue may be used to refinance a mortgage on a residence which was originally")
rule SubprimeRefinancingPermitted(issue: BondIssue, made: Date, issued: Date) strict {
    label en official "section 143(k)(12)(A), (B)(i)-(iii), (D)";
    when qualified_subprime_loan_143k12C(issue);
    when refinancing_of_subprime_loan_143k12(issue, made, true, true, issued);
    when issued <= @2010-12-31;
    then subprime_refinancing_permitted_143k12A(issue);
}
relation principal_residence_disaster_143k13(p: Individual, residence: us.irc.core::Asset, disaster_declared_on: Date, disaster_occurred_before_20100101: Boolean, rendered_unsafe_or_demolished_or_relocated: Boolean, elected: Boolean) kind empirical {
    label en official "the taxpayer's principal residence (section 121) was rendered unsafe for use, or demolished or relocated by government order, by a federally declared disaster occurring before January 1, 2010, and the taxpayer elects";
}
relation financing_on_date_143k13(p: Individual, on: Date) kind empirical {
    label en official "the date owner-financing is provided to the taxpayer";
}
pub relation disaster_relief_143k13a_applies(p: Individual, on: Date) kind institutional {
    label en official "for the 2-year period beginning on the date of the disaster declaration, subsection (d)(1) does not apply to the taxpayer and (e)(1) applies with 110 in place of 90";
}
@source(IRC_S143_K, relation = formalizes, coverage = exact, quote = "At the election of the taxpayer, if the principal residence (within the meaning of section 121) of such taxpayer is—")
rule DisasterRelief143k13aApplies(p: Individual, residence: us.irc.core::Asset, declared: Date, on: Date) strict {
    label en official "section 143(k)(13)(A)(i)-(ii)";
    when principal_residence_disaster_143k13(p, residence, declared, true, true, true);
    when financing_on_date_143k13(p, on);
    when on >= declared;
    when on < add_calendar_period(declared, 2 calendar_year);
    then disaster_relief_143k13a_applies(p, on);
}
relation repair_or_reconstruction_financing_143k13B(p: Individual, damaged_by_federally_declared_disaster_before_20100101: Boolean, elected: Boolean, financing: Money, cost_of_repair_or_reconstruction: Money) kind empirical {
    label en official "owner-financing for the repair or reconstruction of a principal residence damaged by a federally declared disaster occurring before January 1, 2010, the election, the financing and the cost";
}
pub relation repair_financing_treated_as_rehabilitation_loan_143k13B(p: Individual, amount: Money) kind institutional {
    label en official "the owner-financing is treated as a qualified rehabilitation loan, in an aggregate amount not above the lesser of the cost of repair or reconstruction and $150,000";
}
@source(IRC_S143_K, relation = formalizes, coverage = exact, quote = "At the election of the taxpayer, if the principal residence (within the meaning of section 121) of such taxpayer was damaged as the result of a federally declared")
rule RepairFinancingTreatedAsRehabilitationLoan(p: Individual, financing: Money, cost: Money) strict {
    label en official "section 143(k)(13)(B)(i)-(ii)";
    when repair_or_reconstruction_financing_143k13B(p, true, true, financing, cost);
    then repair_financing_treated_as_rehabilitation_loan_143k13B(p, min(financing, min(cost, 150000.00 USD)));
}
relation election_143k13d_revoked_with_consent(p: Individual) kind empirical {
    label en official "the Secretary consents to the revocation of the election under paragraph (13)";
}
relation revokes_election_143k13d(p: Individual) kind empirical {
    label en official "the taxpayer revokes the election under paragraph (13)";
}
relation elected_under_143k13(p: Individual) kind empirical {
    label en official "the taxpayer elected under paragraph (13)";
}
pub relation election_143k13_revoked(p: Individual) kind institutional {
    label en official "the election under paragraph (13) is revoked";
}
@source(IRC_S143_K, relation = formalizes, coverage = exact, quote = "An election under this paragraph may not be revoked except with the consent of the Secretary.")
rule Section143k13dRevocationRule defeasible {
    for p: Individual;
    when elected_under_143k13(p);
    then power Section143k13dRevocation {
        holder p;
        over p;
        exercise revokes_election_143k13d(p);
        valid_when election_143k13d_revoked_with_consent(p);
        effect create(election_143k13_revoked(p));
        window [-infinity, infinity];
    };
}
pub relation paragraph_11_not_applied_143k13dii(p: Individual) kind institutional {
    label en official "if the taxpayer elects the application of paragraph (13), paragraph (11) does not apply to the purchase or financing of any residence by the taxpayer";
}
@source(IRC_S143_K, relation = formalizes, coverage = exact, quote = "If a taxpayer elects the application of this paragraph, paragraph (11) shall not apply with respect to the purchase or financing of any residence by such taxpayer.")
rule Paragraph11NotAppliedAfterElection(p: Individual) strict {
    label en official "section 143(k)(13)(D)(ii)";
    when elected_under_143k13(p);
    then paragraph_11_not_applied_143k13dii(p);
}

// =====================================================================
// §143(l): qualified veterans' mortgage bonds
// =====================================================================

relation mortgagor_served_on_active_duty_and_applied_143l4(mortgagor: Individual, left_service_on: Date, applied_on: Date) kind empirical {
    label en official "the veteran served on active duty, the date he left active service and the date he applied for the financing";
}
pub relation qualified_veteran_143l4(mortgagor: Individual, applied_on: Date) kind institutional {
    label en official "a qualified veteran: served on active duty and applied for the financing before the date 25 years after the last date he left active service";
}
@source(IRC_S143_L, relation = formalizes, coverage = exact, quote = "(A) served on active duty, and")
rule QualifiedVeteranDefined(mortgagor: Individual, left: Date, applied: Date) strict {
    label en official "section 143(l)(4)(A)-(B): the application date precedes the 25th anniversary of leaving service";
    when mortgagor_served_on_active_duty_and_applied_143l4(mortgagor, left, applied);
    when applied < add_calendar_period(left, 25 calendar_year);
    then qualified_veteran_143l4(mortgagor, applied);
}
relation issue_mortgagors_143l1(issue: BondIssue, mortgagor: Individual, applied_on: Date) kind empirical {
    label en official "a mortgagor to whom financing is provided under the issue, and the application date";
}
relation issue_has_non_veteran_mortgagor_143l1(issue: BondIssue) kind institutional {
    label en official "helper: some mortgagor of the issue is not a qualified veteran";
}
rule IssueHasNonVeteranMortgagor(issue: BondIssue, mortgagor: Individual, applied: Date) strict {
    label en official "helper for the not_known test";
    when issue_mortgagors_143l1(issue, mortgagor, applied);
    when not_known(qualified_veteran_143l4(mortgagor, applied));
    then issue_has_non_veteran_mortgagor_143l1(issue);
}
pub relation veterans_requirement_1_met_143l1(issue: BondIssue) kind institutional {
    label en official "each mortgagor to whom financing is provided under the issue is a qualified veteran";
}
@source(IRC_S143_L, relation = formalizes, coverage = exact, quote = "An issue meets the requirements of this paragraph only if each mortgagor to whom financing is provided under the issue is a qualified veteran.")
rule VeteransRequirementOneMet(issue: BondIssue, mortgagor: Individual, applied: Date) strict {
    label en official "section 143(l)(1)";
    when issue_mortgagors_143l1(issue, mortgagor, applied);
    when not_known(issue_has_non_veteran_mortgagor_143l1(issue));
    then veterans_requirement_1_met_143l1(issue);
}
relation state_general_obligation_issued_qveteran_bonds_before_19840622_143l2(issue: BondIssue) kind empirical {
    label en official "the issue is a general obligation of a State which issued qualified veterans' mortgage bonds before June 22, 1984";
}
pub relation veterans_requirement_2_met_143l2(issue: BondIssue) kind institutional {
    label en official "the issue is a general obligation of a State which issued qualified veterans' mortgage bonds before June 22, 1984";
}
@source(IRC_S143_L, relation = formalizes, coverage = exact, quote = "An issue meets the requirements of this paragraph only if it is a general obligation of a State which issued qualified veterans' mortgage bonds before June 22, 1984.")
rule VeteransRequirementTwoMet(issue: BondIssue) strict {
    label en official "section 143(l)(2)";
    when state_general_obligation_issued_qveteran_bonds_before_19840622_143l2(issue);
    then veterans_requirement_2_met_143l2(issue);
}
relation state_veterans_bond_history_143l3Bi(state: us.irc.core::Organ, bonds_by_calendar_year_1979_to_19840622: Money, lowest_year_amount_excluded: Money, years_with_issuance: Integer) kind empirical {
    label en official "the aggregate amount of qualified veterans bonds issued by the State from January 1, 1979 to June 22, 1984 (not including the lowest year), and the number of calendar years after 1979 and before 1985 in which it issued them (only bonds issued on or before June 22, 1984)";
}
pub relation state_veterans_limit_143l3Bi(state: us.irc.core::Organ, limit: Money) kind institutional {
    label en official "the State veterans limit for a State not covered by clause (ii): the aggregate of its 1979-1984 issues (excluding the lowest year) divided by the number (not more than 5) of calendar years in which it issued them";
}
@source(IRC_S143_L, relation = formalizes, coverage = exact, quote = "In the case of any State to which clause (ii) does not apply, the State veterans limit for any calendar year is the amount equal to—")
rule StateVeteransLimitFormula(state: us.irc.core::Organ, total: Money, lowest: Money, years: Integer) strict {
    label en official "section 143(l)(3)(B)(i)(I)-(II), one rounding to cents HALF_UP over the exact quotient (the text names no rounding)";
    when state_veterans_bond_history_143l3Bi(state, total, lowest, years);
    when years > 0;
    when years <= 5;
    then state_veterans_limit_143l3Bi(state, div_round(total - lowest, years * 1.0, 2, "HALF_UP"));
}
@source(IRC_S143_L, relation = formalizes, coverage = exact, quote = "In the case of any State to which clause (ii) does not apply, the State veterans limit for any calendar year is the amount equal to—")
rule StateVeteransLimitFormulaCappedYears(state: us.irc.core::Organ, total: Money, lowest: Money, years: Integer) strict {
    label en official "section 143(l)(3)(B)(i)(II): the number of years is not to exceed 5";
    when state_veterans_bond_history_143l3Bi(state, total, lowest, years);
    when years > 5;
    then state_veterans_limit_143l3Bi(state, div_round(total - lowest, 5.0, 2, "HALF_UP"));
}
pub enum ScheduledVeteransState143l3Bii { Alaska; Oregon; Wisconsin; OtherState; }
relation state_kind_143l3Bii(state: us.irc.core::Organ, kind: ScheduledVeteransState143l3Bii) kind empirical {
    label en official "the State is Alaska, Oregon or Wisconsin, or another State";
}
pub relation state_veterans_limit_scheduled_143l3Bii(state: us.irc.core::Organ, calendar_year: Integer, limit: Money) kind institutional {
    label en official "Alaska, Oregon and Wisconsin: $100,000,000 each, for calendar years beginning before 2010 multiplied by the applicable percentage of the phase-in table (20, 40, 60, 80 percent for 2006 through 2009)";
}
@source(IRC_S143_L, relation = formalizes, coverage = exact, quote = "(I) $100,000,000 for the State of Alaska,")
rule ScheduledLimitFullFrom2010(state: us.irc.core::Organ, kind: ScheduledVeteransState143l3Bii, cy: Integer) strict {
    label en official "section 143(l)(3)(B)(ii)(I)-(III): $100,000,000 for calendar years from 2010";
    when state_kind_143l3Bii(state, kind);
    when kind != OtherState;
    when veterans_limit_year_query_143l3B(state, cy);
    when cy >= 2010;
    then state_veterans_limit_scheduled_143l3Bii(state, cy, 100000000.00 USD);
}
relation veterans_limit_year_query_143l3B(state: us.irc.core::Organ, calendar_year: Integer) kind empirical {
    label en official "the State and the calendar year for which the limit is asked";
}
@source(IRC_S143_TABLE_1, relation = formalizes, coverage = exact, quote = "/ 2006 / 20 percent")
rule ScheduledLimitPhaseIn2006(state: us.irc.core::Organ, kind: ScheduledVeteransState143l3Bii) strict {
    label en official "section 143(l)(3)(B)(iii), table: 20 percent in 2006";
    when state_kind_143l3Bii(state, kind);
    when kind != OtherState;
    when veterans_limit_year_query_143l3B(state, 2006);
    then state_veterans_limit_scheduled_143l3Bii(state, 2006, 20000000.00 USD);
}
@source(IRC_S143_TABLE_1, relation = formalizes, coverage = exact, quote = "/ 2007 / 40 percent")
rule ScheduledLimitPhaseIn2007(state: us.irc.core::Organ, kind: ScheduledVeteransState143l3Bii) strict {
    label en official "table: 40 percent in 2007";
    when state_kind_143l3Bii(state, kind);
    when kind != OtherState;
    when veterans_limit_year_query_143l3B(state, 2007);
    then state_veterans_limit_scheduled_143l3Bii(state, 2007, 40000000.00 USD);
}
@source(IRC_S143_TABLE_1, relation = formalizes, coverage = exact, quote = "/ 2008 / 60 percent")
rule ScheduledLimitPhaseIn2008(state: us.irc.core::Organ, kind: ScheduledVeteransState143l3Bii) strict {
    label en official "table: 60 percent in 2008";
    when state_kind_143l3Bii(state, kind);
    when kind != OtherState;
    when veterans_limit_year_query_143l3B(state, 2008);
    then state_veterans_limit_scheduled_143l3Bii(state, 2008, 60000000.00 USD);
}
@source(IRC_S143_TABLE_1, relation = formalizes, coverage = exact, quote = "/ 2009 / 80 percent.")
rule ScheduledLimitPhaseIn2009(state: us.irc.core::Organ, kind: ScheduledVeteransState143l3Bii) strict {
    label en official "table: 80 percent in 2009";
    when state_kind_143l3Bii(state, kind);
    when kind != OtherState;
    when veterans_limit_year_query_143l3B(state, 2009);
    then state_veterans_limit_scheduled_143l3Bii(state, 2009, 80000000.00 USD);
}
relation veterans_bonds_issued_this_year_143l3A(state: us.irc.core::Organ, calendar_year: Integer, this_issue: BondIssue, aggregate_including_this_and_earlier_of_year: Money) kind empirical {
    label en official "the aggregate amount of bonds of this issue, added to the aggregate amount of qualified veterans' mortgage bonds previously issued by the State during the calendar year";
}
pub relation veterans_requirement_3_met_143l3A(issue: BondIssue) kind institutional {
    label en official "the aggregate amount issued in the calendar year does not exceed the State veterans limit for it";
}
@source(IRC_S143_L, relation = formalizes, coverage = exact, quote = "An issue meets the requirements of this paragraph only if the aggregate amount of bonds issued pursuant thereto (when added to the aggregate amount of qualified")
rule VeteransRequirementThreeMetByFormulaLimit(issue: BondIssue, state: us.irc.core::Organ, cy: Integer, aggregate: Money, limit: Money) strict {
    label en official "section 143(l)(3)(A) with (B)(i)";
    when veterans_bonds_issued_this_year_143l3A(state, cy, issue, aggregate);
    when state_veterans_limit_143l3Bi(state, limit);
    when aggregate <= limit;
    then veterans_requirement_3_met_143l3A(issue);
}
@source(IRC_S143_L, relation = formalizes, coverage = exact, quote = "An issue meets the requirements of this paragraph only if the aggregate amount of bonds issued pursuant thereto (when added to the aggregate amount of qualified")
rule VeteransRequirementThreeMetByScheduledLimit(issue: BondIssue, state: us.irc.core::Organ, cy: Integer, aggregate: Money, limit: Money) strict {
    label en official "section 143(l)(3)(A) with (B)(ii)-(iii)";
    when veterans_bonds_issued_this_year_143l3A(state, cy, issue, aggregate);
    when state_veterans_limit_scheduled_143l3Bii(state, cy, limit);
    when aggregate <= limit;
    then veterans_requirement_3_met_143l3A(issue);
}
relation refunding_veterans_bond_143l3C(refunding: BondIssue, maturity_date: Date, refunded_maturity_date: Date, refunded_issue_date: Date, refunding_amount: Money, refunded_outstanding: Money, advance_refunding: Boolean) kind empirical {
    label en official "a refunding bond: its maturity date, the maturity and issue date of the refunded bond (or of the original bond in a series of refundings), the refunding amount and the outstanding refunded amount, and whether it is an advance refunding";
}
pub relation refunding_bond_is_qualified_veterans_bond_143l3C(refunding: BondIssue) kind institutional {
    label en official "a refunding bond stays a qualified veterans' mortgage bond only if its maturity date is not later than the later of the refunded bond's maturity and the date 32 years after the refunded bond was issued, to the extent its amount does not exceed the outstanding refunded amount; the exclusion does not apply to an advance refunding";
}
@source(IRC_S143_L, relation = formalizes, coverage = exact, quote = "(I) the maturity date of the bond to be refunded, or")
rule RefundingBondQualifiedByMaturity(refunding: BondIssue, m: Date, rm: Date, ri: Date, amt: Money, out: Money) strict {
    label en official "section 143(l)(3)(C)(i)-(ii): maturity not later than the later date, amount within the outstanding refunded amount, current refunding";
    when refunding_veterans_bond_143l3C(refunding, m, rm, ri, amt, out, false);
    when m <= rm;
    when amt <= out;
    then refunding_bond_is_qualified_veterans_bond_143l3C(refunding);
}
@source(IRC_S143_L, relation = formalizes, coverage = exact, quote = "(II) the date 32 years after the date on which the refunded bond was issued (or in the case of a series of refundings, the date on which the original bond was issued).")
rule RefundingBondQualifiedByThirtyTwoYears(refunding: BondIssue, m: Date, rm: Date, ri: Date, amt: Money, out: Money) strict {
    label en official "section 143(l)(3)(C)(i)(II)";
    when refunding_veterans_bond_143l3C(refunding, m, rm, ri, amt, out, false);
    when m <= add_calendar_period(ri, 32 calendar_year);
    when amt <= out;
    then refunding_bond_is_qualified_veterans_bond_143l3C(refunding);
}
@source(IRC_S143_L, relation = formalizes, coverage = exact, quote = "Clause (i) shall not apply to any bond issued to advance refund another bond.")
rule AdvanceRefundingNotQualifiedVeteransBond(refunding: BondIssue, m: Date, rm: Date, ri: Date, amt: Money, out: Money) strict {
    label en official "section 143(l)(3)(C)(ii)";
    when refunding_veterans_bond_143l3C(refunding, m, rm, ri, amt, out, true);
    then advance_refunding_excluded_from_c_143l3C(refunding);
}
pub relation advance_refunding_excluded_from_c_143l3C(refunding: BondIssue) kind institutional {
    label en official "clause (i) does not apply to a bond issued to advance refund another bond";
}
relation oregon_property_tax_bond_143l5(issue: BondIssue, term_at_most_one_year: Boolean, authorized_ors_407_435: Boolean, redeemed_at_end_of_term: Boolean, principal: Money) kind empirical {
    label en official "a bond with a term of 1 year or less authorized by O.R.S. 407.435 to finance property taxes and redeemed at the end of its term, with its principal amount";
}
pub relation amount_taken_into_account_143l5(issue: BondIssue, amount: Money) kind institutional {
    label en official "the amount taken into account under the veterans limit for such a bond: 1/15 of its principal amount";
}
@source(IRC_S143_L, relation = formalizes, coverage = exact, quote = "In the case of any bond—")
rule AmountTakenIntoAccountForOregonPropertyTaxBond(issue: BondIssue, principal: Money) strict {
    label en official "section 143(l)(5)(A)-(C): one fifteenth, one rounding to cents HALF_UP";
    when oregon_property_tax_bond_143l5(issue, true, true, true, principal);
    then amount_taken_into_account_143l5(issue, div_round(principal, 15.0, 2, "HALF_UP"));
}
pub relation veterans_requirements_met_143l(issue: BondIssue) kind institutional {
    label en official "the issue meets the requirements of paragraphs (1), (2) and (3) of subsection (l)";
}
@source(IRC_S143_L, relation = formalizes, coverage = exact, quote = "An issue meets the requirements of this subsection only if it meets the requirements of paragraphs (1), (2), and (3).")
rule VeteransRequirementsMet(issue: BondIssue) strict {
    label en official "section 143(l), lead-in";
    when veterans_requirement_1_met_143l1(issue);
    when veterans_requirement_2_met_143l2(issue);
    when veterans_requirement_3_met_143l3A(issue);
    then veterans_requirements_met_143l(issue);
}

// =====================================================================
// §143(m): recapture of a portion of the Federal subsidy
// =====================================================================

pub entity SubsidizedIndebtedness143m {
    label en unofficial "indebtedness for which the taxpayer is liable and which is federally subsidized (case-asserted)";
}
relation indebtedness_financing_source_143m3A(debt: SubsidizedIndebtedness143m, financed_from_tax_exempt_qualified_mortgage_bond: Boolean, section_25_credit_allowed: Boolean, only_because_home_improvement_loan: Boolean) kind empirical {
    label en official "whether financing was provided in whole or part from a tax-exempt qualified mortgage bond, whether a credit was allowed under section 25 for interest on it, and whether it is federally subsidized solely by being a qualified home improvement loan";
}
pub relation federally_subsidized_indebtedness_143m3(debt: SubsidizedIndebtedness143m) kind institutional {
    label en official "federally-subsidized indebtedness: financed from a tax-exempt qualified mortgage bond, or with a section 25 credit, not to the extent subsidized solely as a qualified home improvement loan";
}
@source(IRC_S143_M, relation = formalizes, coverage = exact, quote = "(i) financing for the indebtedness was provided in whole or part from the proceeds of any tax-exempt qualified mortgage bond, or")
rule FederallySubsidizedByBond(debt: SubsidizedIndebtedness143m) strict {
    label en official "section 143(m)(3)(A)(i), (B)";
    when indebtedness_financing_source_143m3A(debt, true, _, false);
    then federally_subsidized_indebtedness_143m3(debt);
}
@source(IRC_S143_M, relation = formalizes, coverage = exact, quote = "(ii) any credit was allowed under section 25 (relating to interest on certain home mortgages) to the taxpayer for interest paid or incurred on such indebtedness.")
rule FederallySubsidizedByCredit(debt: SubsidizedIndebtedness143m) strict {
    label en official "section 143(m)(3)(A)(ii), (B)";
    when indebtedness_financing_source_143m3A(debt, _, true, false);
    then federally_subsidized_indebtedness_143m3(debt);
}
relation highest_principal_amount_liable_143m4b(debt: SubsidizedIndebtedness143m, amount: Money) kind empirical {
    label en official "the highest principal amount of the indebtedness for which the taxpayer was liable";
}
pub relation federally_subsidized_amount_143m4b(debt: SubsidizedIndebtedness143m, amount: Money) kind institutional {
    label en official "the federally-subsidized amount: 6.25 percent of the highest principal amount of the indebtedness for which the taxpayer was liable";
}
@source(IRC_S143_M, relation = formalizes, coverage = exact, quote = "The federally-subsidized amount with respect to any indebtedness is the amount equal to 6.25 percent of the highest principal amount of the indebtedness for which the")
rule FederallySubsidizedAmount(debt: SubsidizedIndebtedness143m, highest: Money) strict {
    label en official "section 143(m)(4)(B): 6.25 percent, one rounding to cents HALF_UP";
    when federally_subsidized_indebtedness_143m3(debt);
    when highest_principal_amount_liable_143m4b(debt, highest);
    then federally_subsidized_amount_143m4b(debt, round(highest * 0.0625, 2, "HALF_UP"));
}
relation testing_date_conditions_143m4d(debt: SubsidizedIndebtedness143m, on: Date, is_federally_subsidized: Boolean, taxpayer_liable: Boolean) kind empirical {
    label en official "a date on which the indebtedness is federally-subsidized and the taxpayer is liable in whole or part for it";
}
pub relation testing_date_143m4d(debt: SubsidizedIndebtedness143m, on: Date) kind institutional {
    label en official "the testing date: the earliest date on which the indebtedness is federally-subsidized and the taxpayer is liable for it";
}
@source(IRC_S143_M, relation = formalizes, coverage = exact, quote = "The term \"testing date\" means the earliest date on which all of the following requirements are met:")
rule TestingDateIsTheEarliestQualifyingDate(debt: SubsidizedIndebtedness143m, on: Date) strict {
    label en official "section 143(m)(4)(D)(i)-(ii): a date with no strictly earlier qualifying date (the earliest-date pattern of TECH-GAPS G136)";
    when testing_date_conditions_143m4d(debt, on, true, true);
    when not_known(has_earlier_testing_date_143m4d(debt, on));
    then testing_date_143m4d(debt, on);
}
relation has_earlier_testing_date_143m4d(debt: SubsidizedIndebtedness143m, on: Date) kind institutional {
    label en official "helper: a strictly earlier qualifying date exists";
}
rule HasEarlierTestingDate(debt: SubsidizedIndebtedness143m, on: Date, earlier: Date) strict {
    label en official "helper";
    when testing_date_conditions_143m4d(debt, on, true, true);
    when testing_date_conditions_143m4d(debt, earlier, true, true);
    when earlier < on;
    then has_earlier_testing_date_143m4d(debt, on);
}
relation disposition_143m1(debt: SubsidizedIndebtedness143m, disposed_on: Date, by_reason_of_death: Boolean) kind empirical {
    label en official "the taxpayer disposes of an interest in the residence during the taxable year, on the date, and whether by reason of death";
}
pub relation holding_period_year_143m4c(debt: SubsidizedIndebtedness143m, year_after_testing_date: Integer) kind institutional {
    label en official "the number of the year after the testing date (the 1st such year, the 2d such year, and so on) in which the disposition occurs; more than 9 years after the testing date there is none";
}
@source(IRC_S143_M, relation = formalizes, coverage = exact, quote = "The term \"holding period percentage\" means the percentage determined in accordance with the following table:")
rule HoldingPeriodYear1(debt: SubsidizedIndebtedness143m, on: Date, t: Date) strict {
    label en official "section 143(m)(4)(C)(i), table: the 1st such year (a year is the 12 months from the testing date)";
    when testing_date_143m4d(debt, t);
    when disposition_143m1(debt, on, _);
    when on >= t;
    when on < add_calendar_period(t, 1 calendar_year);
    then holding_period_year_143m4c(debt, 1);
}
@source(IRC_S143_M, relation = formalizes, coverage = exact, quote = "The term \"holding period percentage\" means the percentage determined in accordance with the following table:")
rule HoldingPeriodYear2(debt: SubsidizedIndebtedness143m, on: Date, t: Date) strict {
    label en official "table: the 2d such year";
    when testing_date_143m4d(debt, t);
    when disposition_143m1(debt, on, _);
    when on >= add_calendar_period(t, 1 calendar_year);
    when on < add_calendar_period(t, 2 calendar_year);
    then holding_period_year_143m4c(debt, 2);
}
rule HoldingPeriodYear3(debt: SubsidizedIndebtedness143m, on: Date, t: Date) strict {
    label en official "table: the 3d such year";
    when testing_date_143m4d(debt, t);
    when disposition_143m1(debt, on, _);
    when on >= add_calendar_period(t, 2 calendar_year);
    when on < add_calendar_period(t, 3 calendar_year);
    then holding_period_year_143m4c(debt, 3);
}
rule HoldingPeriodYear4(debt: SubsidizedIndebtedness143m, on: Date, t: Date) strict {
    label en official "table: the 4th such year";
    when testing_date_143m4d(debt, t);
    when disposition_143m1(debt, on, _);
    when on >= add_calendar_period(t, 3 calendar_year);
    when on < add_calendar_period(t, 4 calendar_year);
    then holding_period_year_143m4c(debt, 4);
}
rule HoldingPeriodYear5(debt: SubsidizedIndebtedness143m, on: Date, t: Date) strict {
    label en official "table: the 5th such year";
    when testing_date_143m4d(debt, t);
    when disposition_143m1(debt, on, _);
    when on >= add_calendar_period(t, 4 calendar_year);
    when on < add_calendar_period(t, 5 calendar_year);
    then holding_period_year_143m4c(debt, 5);
}
rule HoldingPeriodYear6(debt: SubsidizedIndebtedness143m, on: Date, t: Date) strict {
    label en official "table: the 6th such year";
    when testing_date_143m4d(debt, t);
    when disposition_143m1(debt, on, _);
    when on >= add_calendar_period(t, 5 calendar_year);
    when on < add_calendar_period(t, 6 calendar_year);
    then holding_period_year_143m4c(debt, 6);
}
rule HoldingPeriodYear7(debt: SubsidizedIndebtedness143m, on: Date, t: Date) strict {
    label en official "table: the 7th such year";
    when testing_date_143m4d(debt, t);
    when disposition_143m1(debt, on, _);
    when on >= add_calendar_period(t, 6 calendar_year);
    when on < add_calendar_period(t, 7 calendar_year);
    then holding_period_year_143m4c(debt, 7);
}
rule HoldingPeriodYear8(debt: SubsidizedIndebtedness143m, on: Date, t: Date) strict {
    label en official "table: the 8th such year";
    when testing_date_143m4d(debt, t);
    when disposition_143m1(debt, on, _);
    when on >= add_calendar_period(t, 7 calendar_year);
    when on < add_calendar_period(t, 8 calendar_year);
    then holding_period_year_143m4c(debt, 8);
}
rule HoldingPeriodYear9(debt: SubsidizedIndebtedness143m, on: Date, t: Date) strict {
    label en official "table: the 9th such year";
    when testing_date_143m4d(debt, t);
    when disposition_143m1(debt, on, _);
    when on >= add_calendar_period(t, 8 calendar_year);
    when on <= add_calendar_period(t, 9 calendar_year);
    then holding_period_year_143m4c(debt, 9);
}
pub relation holding_period_percentage_143m4c(debt: SubsidizedIndebtedness143m, percentage: Decimal) kind institutional {
    label en official "the holding period percentage: 20, 40, 60, 80, 100, 80, 60, 40, 20 percent for the 1st through 9th year after the testing date";
}
@source(IRC_S143_TABLE_2, relation = formalizes, coverage = exact, quote = "The 5th such year / 100")
rule HoldingPeriodPercentagePeak(debt: SubsidizedIndebtedness143m) strict {
    label en official "table: 100 percent in the 5th year";
    when holding_period_year_143m4c(debt, 5);
    then holding_period_percentage_143m4c(debt, 1.00);
}
@source(IRC_S143_TABLE_2, relation = formalizes, coverage = exact, quote = "The 1st such year / 20")
rule HoldingPeriodPercentageYear1(debt: SubsidizedIndebtedness143m) strict {
    label en official "table: 20 percent";
    when holding_period_year_143m4c(debt, 1);
    then holding_period_percentage_143m4c(debt, 0.20);
}
@source(IRC_S143_TABLE_2, relation = formalizes, coverage = exact, quote = "The 2d such year / 40")
rule HoldingPeriodPercentageYear2(debt: SubsidizedIndebtedness143m) strict {
    label en official "table: 40 percent";
    when holding_period_year_143m4c(debt, 2);
    then holding_period_percentage_143m4c(debt, 0.40);
}
@source(IRC_S143_TABLE_2, relation = formalizes, coverage = exact, quote = "The 3d such year / 60")
rule HoldingPeriodPercentageYear3(debt: SubsidizedIndebtedness143m) strict {
    label en official "table: 60 percent";
    when holding_period_year_143m4c(debt, 3);
    then holding_period_percentage_143m4c(debt, 0.60);
}
@source(IRC_S143_TABLE_2, relation = formalizes, coverage = exact, quote = "The 4th such year / 80")
rule HoldingPeriodPercentageYear4(debt: SubsidizedIndebtedness143m) strict {
    label en official "table: 80 percent";
    when holding_period_year_143m4c(debt, 4);
    then holding_period_percentage_143m4c(debt, 0.80);
}
@source(IRC_S143_TABLE_2, relation = formalizes, coverage = exact, quote = "The 6th such year / 80")
rule HoldingPeriodPercentageYear6(debt: SubsidizedIndebtedness143m) strict {
    label en official "table: 80 percent";
    when holding_period_year_143m4c(debt, 6);
    then holding_period_percentage_143m4c(debt, 0.80);
}
@source(IRC_S143_TABLE_2, relation = formalizes, coverage = exact, quote = "The 7th such year / 60")
rule HoldingPeriodPercentageYear7(debt: SubsidizedIndebtedness143m) strict {
    label en official "table: 60 percent";
    when holding_period_year_143m4c(debt, 7);
    then holding_period_percentage_143m4c(debt, 0.60);
}
@source(IRC_S143_TABLE_2, relation = formalizes, coverage = exact, quote = "The 8th such year / 40")
rule HoldingPeriodPercentageYear8(debt: SubsidizedIndebtedness143m) strict {
    label en official "table: 40 percent";
    when holding_period_year_143m4c(debt, 8);
    then holding_period_percentage_143m4c(debt, 0.40);
}
@source(IRC_S143_TABLE_2, relation = formalizes, coverage = exact, quote = "The 9th such year / 20")
rule HoldingPeriodPercentageYear9(debt: SubsidizedIndebtedness143m) strict {
    label en official "table: 20 percent";
    when holding_period_year_143m4c(debt, 9);
    then holding_period_percentage_143m4c(debt, 0.20);
}
relation indebtedness_completely_repaid_during_first_4_years_143m4cii(debt: SubsidizedIndebtedness143m, repaid_in_year_of_period: Integer) kind empirical {
    label en official "the federally-subsidized indebtedness is completely repaid during the given year of the 4-year period beginning on the testing date";
}
relation percentage_at_repayment_date_143m4cii(debt: SubsidizedIndebtedness143m, percentage_had_disposition_occurred_on_repayment_date: Decimal, years_since_repayment: Integer) kind empirical {
    label en official "the holding period percentage the table would have given had the taxpayer disposed of the interest on the repayment date, and the number of full years since the repayment";
}
pub relation holding_period_percentage_after_repayment_143m4cii(debt: SubsidizedIndebtedness143m, years_since_repayment: Integer, percentage: Decimal) kind institutional {
    label en official "after complete repayment during the first 4 years the percentage for succeeding years is reduced ratably to zero over the succeeding 5 years";
}
@source(IRC_S143_M, relation = formalizes, coverage = exact, quote = "If the federally-subsidized indebtedness is completely repaid during any year of the 4-year period beginning on the testing date, the holding period percentage for")
rule HoldingPeriodPercentageAfterRepayment(debt: SubsidizedIndebtedness143m, repay_year: Integer, base: Decimal, n: Integer) strict {
    label en official "section 143(m)(4)(C)(ii): base x (5 - n) / 5 for n full years after repayment, zero from the 5th year";
    when indebtedness_completely_repaid_during_first_4_years_143m4cii(debt, repay_year);
    when repay_year >= 1;
    when repay_year <= 4;
    when percentage_at_repayment_date_143m4cii(debt, base, n);
    when n >= 0;
    when n < 5;
    then holding_period_percentage_after_repayment_143m4cii(debt, n, round(base * (5 - n) * 0.2, 4, "HALF_UP"));
}
relation modified_agi_and_adjusted_qualifying_income_143m4e(taxpayer: Individual, y: TaxableYear, modified_agi: Money, adjusted_qualifying_income: Money) kind empirical {
    label en official "the modified adjusted gross income of the taxpayer for the taxable year in which the disposition occurs and the adjusted qualifying income for that year";
}
pub relation income_percentage_143m4e(taxpayer: Individual, y: TaxableYear, percentage: Decimal) kind institutional {
    label en official "the income percentage: the excess of modified adjusted gross income over adjusted qualifying income divided by $5,000, not above 100 percent, rounded to the nearest whole percentage point (half a point rounds up)";
}
@source(IRC_S143_M, relation = formalizes, coverage = exact, quote = "The term \"income percentage\" means the percentage (but not greater than 100 percent) which—")
rule IncomePercentageDefined(taxpayer: Individual, y: TaxableYear, magi: Money, aqi: Money) strict {
    label en official "section 143(m)(4)(E)(i)-(ii)";
    when modified_agi_and_adjusted_qualifying_income_143m4e(taxpayer, y, magi, aqi);
    when magi > aqi;
    then income_percentage_143m4e(taxpayer, y, min(1.00, round(round((magi - aqi) / 5000.00 USD * 100, 0, "HALF_UP") / 100, 2, "HALF_UP")));
}
@source(IRC_S143_M, relation = formalizes, coverage = exact, quote = "The term \"income percentage\" means the percentage (but not greater than 100 percent) which—")
rule IncomePercentageZeroWhenNoExcess(taxpayer: Individual, y: TaxableYear, magi: Money, aqi: Money) strict {
    label en official "section 143(m)(4)(E): no excess means a zero percentage";
    when modified_agi_and_adjusted_qualifying_income_143m4e(taxpayer, y, magi, aqi);
    when magi <= aqi;
    then income_percentage_143m4e(taxpayer, y, 0.00);
}
pub relation recapture_amount_143m4a(taxpayer: Individual, debt: SubsidizedIndebtedness143m, y: TaxableYear, amount: Money) kind institutional {
    label en official "the recapture amount: the federally-subsidized amount times the holding period percentage times the income percentage";
}
@source(IRC_S143_M, relation = formalizes, coverage = exact, quote = "The recapture amount with respect to any indebtedness is the amount equal to the product of—")
rule RecaptureAmountDefined(taxpayer: Individual, debt: SubsidizedIndebtedness143m, y: TaxableYear, subsidized: Money, hp: Decimal, ip: Decimal) strict {
    label en official "section 143(m)(4)(A)(i)-(iii): one rounding to cents HALF_UP over the exact product";
    when federally_subsidized_amount_143m4b(debt, subsidized);
    when holding_period_percentage_143m4c(debt, hp);
    when income_percentage_143m4e(taxpayer, y, ip);
    then recapture_amount_143m4a(taxpayer, debt, y, round(subsidized * hp * ip, 2, "HALF_UP"));
}
relation gain_on_disposition_143m1B(debt: SubsidizedIndebtedness143m, gain: Money) kind empirical {
    label en official "the gain (if any) on the disposition of the interest; in a disposition other than a sale, exchange or involuntary conversion the gain is determined as if the interest had been sold for its fair market value (section 143(m)(6)(B))";
}
relation disposition_by_reason_of_casualty_with_replacement_143m6c(debt: SubsidizedIndebtedness143m) kind empirical {
    label en official "a compulsory or involuntary conversion by fire, storm or other casualty where the taxpayer purchases, during the section 1033(a)(2)(B) period, property for use as his principal residence on the site of the converted property";
}
relation transfer_incident_to_divorce_1041_143m8c(debt: SubsidizedIndebtedness143m) kind empirical {
    label en official "the disposition is a transfer on which no gain or loss is recognized under section 1041 (the transferee is then treated as the transferor would have been)";
}
pub relation recapture_tax_increase_143m1(taxpayer: Individual, debt: SubsidizedIndebtedness143m, y: TaxableYear, amount: Money) kind institutional {
    label en official "the increase in the taxpayer's tax for the year: the lesser of the recapture amount and 50 percent of the gain on the disposition; none for a disposition by reason of death, a disposition more than 9 years after the testing date, a casualty conversion with replacement, or a section 1041 transfer";
}
@source(IRC_S143_M, relation = formalizes, coverage = exact, quote = "If, during the taxable year, any taxpayer disposes of an interest in a residence with respect to which there is or was any federally-subsidized indebtedness for the")
rule RecaptureTaxIncrease(taxpayer: Individual, debt: SubsidizedIndebtedness143m, y: TaxableYear, recapture: Money, gain: Money, on: Date) strict {
    label en official "section 143(m)(1)(A)-(B) with (m)(2), (m)(6)(C), (m)(8)(C): min(recapture, 50 percent of the gain)";
    when recapture_amount_143m4a(taxpayer, debt, y, recapture);
    when gain_on_disposition_143m1B(debt, gain);
    when disposition_143m1(debt, on, false);
    when not_known(disposition_by_reason_of_casualty_with_replacement_143m6c(debt));
    when not_known(transfer_incident_to_divorce_1041_143m8c(debt));
    when gain > 0.00 USD;
    then recapture_tax_increase_143m1(taxpayer, debt, y, min(recapture, round(gain * 0.50, 2, "HALF_UP")));
}
@source(IRC_S143_M, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall not apply to—")
rule NoRecaptureOnDeath(taxpayer: Individual, debt: SubsidizedIndebtedness143m, y: TaxableYear, on: Date) strict {
    label en official "section 143(m)(2)(A): a disposition by reason of death; (m)(2)(B) beyond 9 years is carried by the absence of a holding period percentage";
    when disposition_143m1(debt, on, true);
    then no_recapture_143m2(debt);
}
pub relation no_recapture_143m2(debt: SubsidizedIndebtedness143m) kind institutional {
    label en official "paragraph (1) does not apply: the disposition is by reason of death";
}
relation highest_family_income_meeting_143f_and_years_143m5a(taxpayer: Individual, highest_family_income: Money, full_years_since_financing: Integer) kind empirical {
    label en official "the highest family income which (as of the date the financing was provided) would have met subsection (f) with respect to the residents, and the number of full years from the financing to the disposition";
}
pub relation adjusted_qualifying_income_143m5a(taxpayer: Individual, amount: Money) kind institutional {
    label en official "the adjusted qualifying income: the highest family income meeting subsection (f) times 1.05 to the nth power for n full years from financing to disposition";
}
@source(IRC_S143_M, relation = formalizes, coverage = exact, quote = "(i) the highest family income which (as of the date the financing was provided) would have met the requirements of subsection (f) with respect to the residents, and")
rule AdjustedQualifyingIncomeDefined(taxpayer: Individual, income: Money, n: Integer) strict {
    label en official "section 143(m)(5)(A)(i)-(ii): income x 1.05^n, one rounding to cents HALF_UP";
    when highest_family_income_meeting_143f_and_years_143m5a(taxpayer, income, n);
    when n >= 0;
    then adjusted_qualifying_income_143m5a(taxpayer, div_round(income * pow(105, n), pow(100, n) * 1.0, 2, "HALF_UP"));
}
relation agi_interest_and_gain_143m5b(taxpayer: Individual, y: TaxableYear, agi: Money, section_103_interest: Money, gain_included_by_reason_of_disposition: Money) kind empirical {
    label en official "adjusted gross income, the interest excluded under section 103 received or accrued in the year, and the gain included by reason of the disposition";
}
pub relation modified_agi_143m5b(taxpayer: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the modified adjusted gross income for subsection (m): adjusted gross income increased by section 103 interest and decreased by the gain included by reason of the disposition";
}
@source(IRC_S143_M, relation = formalizes, coverage = exact, quote = "(i) increased by the amount of interest received or accrued by the taxpayer during the taxable year which is excluded from gross income under section 103, and")
rule ModifiedAgiForRecapture(taxpayer: Individual, y: TaxableYear, agi: Money, interest: Money, gain: Money) strict {
    label en official "section 143(m)(5)(B)(i)-(ii)";
    when agi_interest_and_gain_143m5b(taxpayer, y, agi, interest, gain);
    then modified_agi_143m5b(taxpayer, y, round(agi + interest - gain, 2, "HALF_UP"));
}
relation issuer_of_subsidized_indebtedness_143m7(debt: SubsidizedIndebtedness143m, issuer: Person, mortgagor: Individual) kind empirical {
    label en official "the issuer of the issue that provided the federally-subsidized indebtedness to the mortgagor";
}
relation settlement_date_143m7A(debt: SubsidizedIndebtedness143m, settlement_on: Date) kind empirical {
    label en official "the date of settlement";
}
relation indebtedness_provided_on_143m7B(debt: SubsidizedIndebtedness143m, provided_on: Date) kind empirical {
    label en official "the date the indebtedness is provided";
}
relation issuer_provided_recapture_notice_143m7A(debt: SubsidizedIndebtedness143m) kind empirical {
    label en official "the issuer provided at settlement a written statement informing the mortgagor of the potential recapture";
}
relation issuer_provided_statement_of_subsidized_amount_143m7B(debt: SubsidizedIndebtedness143m) kind empirical {
    label en official "the issuer provided within 90 days after the indebtedness was provided a written statement specifying the federally-subsidized amount and the adjusted qualifying income for each category of family size for each year of the 9-year period";
}
@source(IRC_S143_M, relation = formalizes, coverage = exact, quote = "(A) at the time of settlement, provide a written statement informing the mortgagor of the potential recapture under this subsection, and")
rule Section143m7ANoticeDutyRule strict {
    for debt: SubsidizedIndebtedness143m;
    for issuer: Person;
    for mortgagor: Individual;
    for settlement: Date;
    when issuer_of_subsidized_indebtedness_143m7(debt, issuer, mortgagor)
        and settlement_date_143m7A(debt, settlement);
    then duty Section143m7ANoticeDuty {
        bearer issuer;
        beneficiary mortgagor;
        goal achievement {
            condition issuer_provided_recapture_notice_143m7A(debt);
            window [settlement, settlement];
        }
    };
}
@source(IRC_S143_M, relation = formalizes, coverage = exact, quote = "(B) not later than 90 days after the date such indebtedness is provided, provide a written statement to the mortgagor specifying—")
rule Section143m7BStatementDutyRule strict {
    for debt: SubsidizedIndebtedness143m;
    for issuer: Person;
    for mortgagor: Individual;
    for provided: Date;
    when issuer_of_subsidized_indebtedness_143m7(debt, issuer, mortgagor)
        and indebtedness_provided_on_143m7B(debt, provided);
    then duty Section143m7BStatementDuty {
        bearer issuer;
        beneficiary mortgagor;
        goal achievement {
            condition issuer_provided_statement_of_subsidized_amount_143m7B(debt);
            window [provided, add_calendar_period(provided, 90 calendar_day)];
        }
    };
}
pub relation no_basis_adjustment_for_recapture_143m8a(taxpayer: Individual, debt: SubsidizedIndebtedness143m) kind institutional {
    label en official "no adjustment is made to the basis of any property for the increase in tax under subsection (m)";
}
@source(IRC_S143_M, relation = formalizes, coverage = exact, quote = "No adjustment shall be made to the basis of any property for the increase in tax under this subsection.")
rule NoBasisAdjustmentForRecapture(taxpayer: Individual, debt: SubsidizedIndebtedness143m, y: TaxableYear, amount: Money) strict {
    label en official "section 143(m)(8)(A)";
    when recapture_tax_increase_143m1(taxpayer, debt, y, amount);
    then no_basis_adjustment_for_recapture_143m8a(taxpayer, debt);
}
relation co_holders_jointly_liable_143m8b(debt: SubsidizedIndebtedness143m, holder: Individual, interest_share: Decimal) kind empirical {
    label en official "two or more persons hold interests in the residence and are jointly liable for the indebtedness, with each holder's share of the interest";
}
pub relation recapture_determined_separately_per_holder_143m8b(debt: SubsidizedIndebtedness143m, holder: Individual, share: Decimal) kind institutional {
    label en official "the recapture amount is determined separately with respect to each holder's interest in the residence (subject to subparagraph (C) and regulations)";
}
@source(IRC_S143_M, relation = formalizes, coverage = exact, quote = "Except as provided in subparagraph (C) and in regulations prescribed by the Secretary, if 2 or more persons hold interests in any residence and are jointly liable for")
rule RecaptureDeterminedSeparatelyPerHolder(debt: SubsidizedIndebtedness143m, holder: Individual, share: Decimal) strict {
    label en official "section 143(m)(8)(B)";
    when co_holders_jointly_liable_143m8b(debt, holder, share);
    then recapture_determined_separately_per_holder_143m8b(debt, holder, share);
}
relation casualty_replacement_adjusted_basis_143m6c(debt: SubsidizedIndebtedness143m, adjusted_basis_not_adjusted_for_conversion_gain_or_loss: Boolean) kind empirical {
    label en official "for the casualty conversion exception, the taxpayer's adjusted basis in the residence is not adjusted for any gain or loss on the conversion";
}
@source(IRC_S143_M, relation = formalizes, coverage = exact, quote = "In the case of property which (as a result of its destruction in whole or in part by fire, storm, or other casualty) is compulsorily or involuntarily converted,")
rule NoRecaptureOnCasualtyConversionWithReplacement(debt: SubsidizedIndebtedness143m) strict {
    label en official "section 143(m)(6)(C)";
    when disposition_by_reason_of_casualty_with_replacement_143m6c(debt);
    then no_recapture_143m6c(debt);
}
pub relation no_recapture_143m6c(debt: SubsidizedIndebtedness143m) kind institutional {
    label en official "paragraph (1) does not apply to a casualty conversion when the taxpayer purchases replacement principal-residence property on the site within the section 1033(a)(2)(B) period";
}
@source(IRC_S143_M, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall not apply to any transfer on which no gain or loss is recognized under section 1041. In any such case, the transferee shall be treated under this")
rule NoRecaptureOnDivorceTransfer(debt: SubsidizedIndebtedness143m) strict {
    label en official "section 143(m)(8)(C): a section 1041 transfer";
    when transfer_incident_to_divorce_1041_143m8c(debt);
    then no_recapture_143m8c(debt);
}
pub relation no_recapture_143m8c(debt: SubsidizedIndebtedness143m) kind institutional {
    label en official "paragraph (1) does not apply to a transfer on which no gain or loss is recognized under section 1041; the transferee is treated as the transferor would have been";
}
@source(IRC_S143_M, relation = formalizes, coverage = exact, quote = "In the case of a disposition other than a sale, exchange, or involuntary conversion, gain shall be determined as if the interest had been sold for its fair market value.")
rule GainOnNonSaleDispositionAtFairMarketValue(debt: SubsidizedIndebtedness143m, on: Date, fmv: Money, basis: Money) strict {
    label en official "section 143(m)(6)(B): gain as if the interest had been sold for fair market value";
    when non_sale_disposition_143m6b(debt, on, fmv, basis);
    when fmv > basis;
    then non_sale_gain_143m6b(debt, round(fmv - basis, 2, "HALF_UP"));
}
relation non_sale_disposition_143m6b(debt: SubsidizedIndebtedness143m, on: Date, fair_market_value: Money, adjusted_basis: Money) kind empirical {
    label en official "a disposition other than a sale, exchange or involuntary conversion, the fair market value of the interest and the adjusted basis";
}
pub relation non_sale_gain_143m6b(debt: SubsidizedIndebtedness143m, gain: Money) kind institutional {
    label en official "the gain on a disposition other than a sale, exchange or involuntary conversion: fair market value less adjusted basis";
}

// =====================================================================
// The link to section 141(e)(1)(B), (C): parallel category rules
// =====================================================================

@source(IRC_S143_A, relation = formalizes, coverage = exact, quote = "(iii) such issue does not meet the private business tests of paragraphs (1) and (2) of section 141(b), and")
rule QualifiedBondCategoryMortgageDerived(issue: BondIssue) strict {
    label en official "section 141(e)(1)(B) read with the derived section 143(a) status";
    when qualified_mortgage_issue_143a2A(issue);
    then qualified_bond_category_141e1(issue);
}
@source(IRC_S143_B, relation = formalizes, coverage = exact, quote = "(1) which is issued as part of an issue 95 percent or more of the net proceeds of which are to be used to provide residences for veterans,")
rule QualifiedBondCategoryVeteransMortgageDerived(issue: BondIssue) strict {
    label en official "section 141(e)(1)(C) read with the derived section 143(b) status";
    when qualified_veterans_mortgage_issue_143b(issue);
    when veterans_requirements_met_143l(issue);
    then qualified_bond_category_141e1(issue);
}
