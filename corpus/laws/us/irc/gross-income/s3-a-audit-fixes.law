// Stage 3 (TECH_GAP reduction and audit) — rows whose stage 2f mapping to the parent rule was
// re-read and found NOT covered by that rule: §142(l)(2)(B) and (l)(4)(B) (green building
// projects), §142(d)(2)(C) (students), §149(e)(1) (denial), §149(f)(7)(B) (separate issues),
// §108(e)(7)(A)(iii) (exchange treated as a section 1245(b)(3) exchange), and the variant of
// "dependent" of section 139D(c)(5) / 139E(c)(2) (TECH-GAPS G4502).
// STATUS: implemented_unverified (static check only; scenarios in tests/s3-a-audit-fixes.lawtest
// are NOT executed).
//
// JUDGMENT CALLS. §142(l)(2)(B) has no window of its own: the duty is timed with the designation
// window of (l)(2)(A) (60 days after the application period), the moment at which the aggregate
// of the designated projects is known. "Expand by 75 percent" is read as at least 75 percent,
// "more than 150 megawatts" strictly. The absence of a filed statement under §149(e) is a
// positively asserted case fact (an absent fact is not a negative).

// =====================================================================
// §142(l)(2)(B): aggregate outcomes of the designated projects (duty of the Secretary)
// =====================================================================

use self::{
    BondIssue,
    GreenProject142l,
    IRC_S108_E,
    IRC_S139D_C,
    IRC_S142_D,
    IRC_S142_L,
    IRC_S149_E,
    IRC_S149_F,
    Individual,
    Secretary,
    TaxableYear,
    application_period_ended_142l3A,
    bears_relative_relationship_152d2,
    bond_fails_149_requirement,
    bond_part_of_issue,
    information_statement_requirement_met_149e2,
    is_qualifying_child_of_someone_base,
    non_citizen_excluded_152b3,
    over_half_support_provided_by_taxpayer_152d1c,
    qualifying_child_of,
    stock_is_section_1245_property_108e7Ai,
};

relation aggregate_outcomes_of_designated_projects_142l2B(application_end: Date, electric_megawatts_reduced_annually: Decimal, sulfur_dioxide_tons_reduced_daily: Decimal, solar_market_expansion_percent: Decimal, fuel_cell_megawatts: Decimal) kind empirical {
    label en official "the aggregate outcomes of the designated projects: the annual reduction of electric consumption in megawatts compared to conventional generation, the daily reduction of sulfur dioxide emissions in tons compared to coal generation, the expansion in percent of the domestic solar photovoltaic market compared to the expansion from 2001 to 2002, and the megawatts of fuel cell energy generation";
}
pub relation aggregate_outcomes_of_designated_projects_met_142l2B(application_end: Date) kind institutional {
    label en official "in the aggregate the designated projects reduce electric consumption by more than 150 megawatts annually, reduce daily sulfur dioxide emissions by at least 10 tons, expand the domestic solar photovoltaic market by 75 percent, and use at least 25 megawatts of fuel cell energy generation";
}
@source(IRC_S142_L, relation = formalizes, coverage = exact, quote = "(i) reduce electric consumption by more than 150 megawatts annually as compared to conventional generation,")
rule AggregateOutcomesOfDesignatedProjectsMet(application_end: Date, megawatts: Decimal, tons: Decimal, percent: Decimal, fuel_cell: Decimal) strict {
    label en official "section 142(l)(2)(B)(i)-(iv): more than 150 megawatts, at least 10 tons, 75 percent, at least 25 megawatts";
    when aggregate_outcomes_of_designated_projects_142l2B(application_end, megawatts, tons, percent, fuel_cell);
    when megawatts > 150.0;
    when tons >= 10.0;
    when percent >= 75.0;
    when fuel_cell >= 25.0;
    then aggregate_outcomes_of_designated_projects_met_142l2B(application_end);
}
@source(IRC_S142_L, relation = formalizes, coverage = exact, quote = "The Secretary, after consultation with the Administrator of the Environmental Protection Agency, shall ensure that, in the aggregate, the projects designated shall—")
rule Section142l2BAggregateOutcomesDutyRule strict {
    for application_end: Date;
    when application_period_ended_142l3A(application_end);
    then duty Section142l2BAggregateOutcomesDuty {
        bearer Secretary;
        goal achievement {
            condition aggregate_outcomes_of_designated_projects_met_142l2B(application_end);
            window [application_end, add_calendar_period(application_end, 60 calendar_day)];
        }
    };
}

// =====================================================================
// §142(l)(4)(B): the description each application must contain
// =====================================================================

relation application_describes_measures_142l4B(project: GreenProject142l, electric_consumption_reduced: Boolean, sulfur_dioxide_emissions_reduced: Boolean, solar_photovoltaic_capacity_megawatts: Boolean, fuel_cell_generation_megawatts: Boolean) kind empirical {
    label en official "the application describes for the project (i) the amount of electric consumption reduced compared to conventional construction, (ii) the amount of sulfur dioxide daily emissions reduced compared to coal generation, (iii) the gross installed capacity of the solar photovoltaic capacity in megawatts, and (iv) the megawatts of fuel cell energy generation";
}
pub relation application_description_complete_142l4B(project: GreenProject142l) kind institutional {
    label en official "the application contains for the project the four descriptions required by section 142(l)(4)(B)";
}
@source(IRC_S142_L, relation = formalizes, coverage = exact, quote = "Each application described in subparagraph (A) shall contain for each project a description of—")
rule ApplicationDescriptionComplete(project: GreenProject142l) strict {
    label en official "section 142(l)(4)(B)(i)-(iv)";
    when application_describes_measures_142l4B(project, true, true, true, true);
    then application_description_complete_142l4B(project);
}

// =====================================================================
// §142(d)(2)(C): rules similar to section 42(i)(3)(D): students do not disqualify a unit
// =====================================================================

pub enum StudentOccupancyKind142d { TitleIVAssistanceStudent; FosterCareAlumniStudent; JobTrainingParticipant; FullTimeSingleParentStudents; FullTimeMarriedJointStudents }
relation unit_occupied_by_students_142d2C(unit: us.irc.core::Asset, kind: StudentOccupancyKind142d) kind empirical {
    label en official "the unit is occupied by an individual who is a student receiving assistance under title IV of the Social Security Act, a student formerly under State care and placement responsibility, or a participant in a federally assisted job training program, or entirely by full-time students who are single parents and their children or who are married and file a joint return (rules similar to section 42(i)(3)(D))";
}
relation single_parent_students_not_dependents_of_others_142d2C(unit: us.irc.core::Asset) kind empirical {
    label en official "the single-parent students are not dependents (section 152 determined without regard to (b)(1), (b)(2) and (d)(1)(B)) of another individual, and their children are not dependents of another individual other than a parent of the children";
}
pub relation student_occupancy_does_not_disqualify_unit_142d2C(unit: us.irc.core::Asset) kind institutional {
    label en official "the unit does not fail to be treated as a low-income unit merely because it is occupied by students of the kinds listed (rules similar to section 42(i)(3)(D) apply for purposes of section 142(d))";
}
@source(IRC_S142_D, relation = formalizes, coverage = exact, quote = "Rules similar to the rules of section 42(i)(3)(D) shall apply for purposes of this subsection.")
rule StudentOccupancyIndividuals142d(unit: us.irc.core::Asset, kind: StudentOccupancyKind142d) strict {
    label en official "section 142(d)(2)(C) with section 42(i)(3)(D)(i)(I)-(III): an occupying student receiving Title IV assistance or formerly in State care, or a job training participant";
    when unit_occupied_by_students_142d2C(unit, kind);
    when kind != FullTimeSingleParentStudents;
    when kind != FullTimeMarriedJointStudents;
    then student_occupancy_does_not_disqualify_unit_142d2C(unit);
}
@source(IRC_S142_D, relation = formalizes, coverage = exact, quote = "Rules similar to the rules of section 42(i)(3)(D) shall apply for purposes of this subsection.")
rule StudentOccupancySingleParents142d(unit: us.irc.core::Asset) strict {
    label en official "section 142(d)(2)(C) with section 42(i)(3)(D)(ii)(I): full-time single-parent students who are not dependents of another individual";
    when unit_occupied_by_students_142d2C(unit, FullTimeSingleParentStudents);
    when single_parent_students_not_dependents_of_others_142d2C(unit);
    then student_occupancy_does_not_disqualify_unit_142d2C(unit);
}
@source(IRC_S142_D, relation = formalizes, coverage = exact, quote = "Rules similar to the rules of section 42(i)(3)(D) shall apply for purposes of this subsection.")
rule StudentOccupancyMarriedJoint142d(unit: us.irc.core::Asset) strict {
    label en official "section 142(d)(2)(C) with section 42(i)(3)(D)(ii)(II): full-time students who are married and file a joint return";
    when unit_occupied_by_students_142d2C(unit, FullTimeMarriedJointStudents);
    then student_occupancy_does_not_disqualify_unit_142d2C(unit);
}

// =====================================================================
// §149(e)(1): no exemption for a bond without the information statement
// =====================================================================

relation no_statement_submitted_by_due_date_149e1(issue: BondIssue) kind empirical {
    label en official "the issuer did not submit the statement required by section 149(e)(2) by its due date (asserted by the case; an absent fact is not a negative)";
}
pub relation bond_exemption_denied_information_reporting_149e1(issue: BondIssue) kind institutional {
    label en official "nothing in section 103(a) or any other provision of law provides an exemption for interest on the bond because the statement required by section 149(e)(2) was not submitted";
}
@source(IRC_S149_E, relation = formalizes, coverage = exact, quote = "Nothing in section 103(a) or any other provision of law shall be construed to provide an exemption from Federal income tax for interest on any bond unless such bond satisfies the requirements of paragraph (2).")
rule ExemptionDeniedWithoutInformationStatement(issue: BondIssue) strict {
    label en official "section 149(e)(1): the requirements of paragraph (2) are not met";
    when no_statement_submitted_by_due_date_149e1(issue);
    when not_known(information_statement_requirement_met_149e2(issue));
    then bond_exemption_denied_information_reporting_149e1(issue);
}
rule Bond149FailureInformationReporting(bond: us.irc.core::Asset, issue: BondIssue) strict {
    label en official "section 149(e)(1) read into section 103(b)(3): the bond fails an applicable requirement of section 149";
    when bond_part_of_issue(bond, issue);
    when bond_exemption_denied_information_reporting_149e1(issue);
    then bond_fails_149_requirement(bond);
}

// =====================================================================
// §149(f)(7)(B): the portion of an issue used for loans is a separate issue
// =====================================================================

relation pooled_loan_use_portion_149f7B(issue: BondIssue, loan_portion: Money, whole_issue: Money) kind empirical {
    label en official "the portion of the proceeds reasonably expected at issuance to be used (or intentionally used) as described in paragraph (6)(A) (to make or finance loans to two or more ultimate borrowers), and the proceeds of the whole issue";
}
pub relation pooled_portion_treated_as_separate_issue_149f7B(issue: BondIssue) kind institutional {
    label en official "the loan portion and the other portion of the issue are treated as separate issues for purposes of determining whether the loan portion meets the requirements of section 149(f)";
}
@source(IRC_S149_F, relation = formalizes, coverage = exact, quote = "If only a portion of the proceeds of an issue is reasonably expected (at the time of issuance of the bond) to be used (or is intentionally used) as described in paragraph (6)(A)")
rule PooledPortionTreatedAsSeparateIssue(issue: BondIssue, portion: Money, whole: Money) strict {
    label en official "section 149(f)(7)(B): only a portion is used for such loans";
    when pooled_loan_use_portion_149f7B(issue, portion, whole);
    when portion > 0.00 USD;
    when portion < whole;
    then pooled_portion_treated_as_separate_issue_149f7B(issue);
}

// =====================================================================
// §108(e)(7)(A)(iii): a nonrecognition exchange of the stock is a section 1245(b)(3) exchange
// =====================================================================

relation stock_exchange_under_354a_355a_356a_108e7Aiii(stock: us.irc.core::Asset) kind empirical {
    label en official "an exchange of the stock qualifies under section 354(a), 355(a) or 356(a)";
}
pub relation stock_exchange_treated_as_1245b3_exchange_108e7Aiii(stock: us.irc.core::Asset) kind institutional {
    label en official "the exchange of the stock is treated as an exchange to which section 1245(b)(3) applies";
}
@source(IRC_S108_E, relation = formalizes, coverage = exact, quote = "(iii) an exchange of such stock qualifying under section 354(a), 355(a), or 356(a) shall be treated as an exchange to which section 1245(b)(3) applies.")
rule StockExchangeTreatedAsSection1245b3Exchange(stock: us.irc.core::Asset) strict {
    label en official "section 108(e)(7)(A)(iii)";
    when stock_is_section_1245_property_108e7Ai(stock);
    when stock_exchange_under_354a_355a_356a_108e7Aiii(stock);
    then stock_exchange_treated_as_1245b3_exchange_108e7Aiii(stock);
}

// =====================================================================
// §139D(c)(5), §139E(c)(2): "dependent" determined without regard to section 152(b)(1), (b)(2),
// (d)(1)(B) (TECH-GAPS G4502)
// =====================================================================

pub relation dependent_without_152b1_b2_d1B_of(ind: Individual, taxpayer: Individual, y: TaxableYear) kind institutional {
    label en official "the individual is a dependent (section 152(a)) of the taxpayer for the taxable year determined without regard to section 152(b)(1) (a dependent of another taxpayer), (b)(2) (a joint return) and (d)(1)(B) (the gross income test of a qualifying relative)";
}
@source(IRC_S139D_C, relation = formalizes, coverage = exact, quote = "The term \"dependent\" has the meaning given such term by section 152, determined without regard to subsections (b)(1), (b)(2), and (d)(1)(B) thereof.")
rule DependentVariantViaQualifyingChild(ind: Individual, taxpayer: Individual, y: TaxableYear) defeasible {
    label en official "section 152(a)(1) with the exceptions of (b)(3) only: a qualifying child";
    when qualifying_child_of(ind, taxpayer, y);
    when not_known(non_citizen_excluded_152b3(ind, taxpayer, y));
    then dependent_without_152b1_b2_d1B_of(ind, taxpayer, y);
}
@source(IRC_S139D_C, relation = formalizes, coverage = exact, quote = "The term \"dependent\" has the meaning given such term by section 152, determined without regard to subsections (b)(1), (b)(2), and (d)(1)(B) thereof.")
rule DependentVariantViaQualifyingRelative(ind: Individual, taxpayer: Individual, y: TaxableYear) strict {
    label en official "section 152(a)(2) with (d)(1)(A), (C), (D) and the exception (b)(3): a qualifying relative without the gross income test";
    when bears_relative_relationship_152d2(ind, taxpayer);
    when over_half_support_provided_by_taxpayer_152d1c(taxpayer, ind, y);
    when not_known(is_qualifying_child_of_someone_base(ind, y));
    when not_known(non_citizen_excluded_152b3(ind, taxpayer, y));
    then dependent_without_152b1_b2_d1B_of(ind, taxpayer, y);
}
