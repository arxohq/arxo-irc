// Stage 2f (TECH_GAP reduction) — §121(d)(4)-(12): cooperative housing, involuntary conversion,
// incapacity, remainder interests, military and Foreign Service and intelligence-community
// suspension of the 5-year period, Peace Corps, section 1031 property.
// STATUS: implemented_unverified (static check only; scenarios in tests/s2f-d-121-residuals.lawtest
// are NOT executed).
//
// The day counts of section 121(a) remain case facts (`ownership_and_use_aggregate_days_5yr`);
// the parallel rules here supply the (d)(4), (7), (9), (12) ways of meeting the requirement.

use self::{
    IRC_S121_D,
    Individual,
    gain_excluded_121a,
    meets_ownership_and_use_requirement_121a,
    sale_or_exchange_of_property,
};

// (d)(4): cooperative housing corporation
relation tenant_stockholder_days_121d4(p: Individual, asset: us.irc.core::Asset, sale_date: Date, stock_holding_days: Integer, apartment_use_days: Integer) kind empirical {
    label en official "the taxpayer holds stock as a tenant-stockholder (section 216) in a cooperative housing corporation: the aggregate days in the 5-year period the stock was held and the aggregate days the house or apartment the taxpayer was entitled to occupy was used as the principal residence";
}
@source(IRC_S121_D, relation = formalizes, coverage = exact, quote = "For purposes of this section, if the taxpayer holds stock as a tenant-stockholder (as defined in section 216) in a cooperative housing corporation (as defined in such")
rule MeetsOwnershipAndUseThroughTenantStockholding(p: Individual, asset: us.irc.core::Asset, sale_date: Date, held: Integer, used: Integer) strict {
    label en official "section 121(d)(4)(A)-(B): the holding requirement applies to the stock and the use requirement to the apartment";
    when tenant_stockholder_days_121d4(p, asset, sale_date, held, used);
    when held >= 730;
    when used >= 730;
    then meets_ownership_and_use_requirement_121a(p, asset, sale_date);
}

// (d)(5): involuntary conversions
relation involuntary_disposition_121d5A(p: Individual, asset: us.irc.core::Asset, disposition_date: Date, amount_realized: Money) kind empirical {
    label en official "the destruction, theft, seizure, requisition, or condemnation of the property, and the amount realized";
}
pub relation treated_as_sale_121d5A(p: Individual, asset: us.irc.core::Asset, disposition_date: Date) kind institutional {
    label en official "for purposes of section 121 the destruction, theft, seizure, requisition or condemnation of property is treated as the sale of the property (the case's `sale_or_exchange_of_property` fact is asserted for such a disposition; this relation records the treatment)";
}
@source(IRC_S121_D, relation = formalizes, coverage = exact, quote = "For purposes of this section, the destruction, theft, seizure, requisition, or condemnation of property shall be treated as the sale of such property.")
rule InvoluntaryDispositionTreatedAsSale(p: Individual, asset: us.irc.core::Asset, on: Date, amount: Money) strict {
    label en official "section 121(d)(5)(A)";
    when involuntary_disposition_121d5A(p, asset, on, amount);
    then treated_as_sale_121d5A(p, asset, on);
}
pub relation amount_realized_for_1033_121d5B(p: Individual, asset: us.irc.core::Asset, on: Date, amount: Money) kind institutional {
    label en official "in applying section 1033 the amount realized is the amount determined without regard to section 121, reduced by the gain not included in gross income under section 121";
}
@source(IRC_S121_D, relation = formalizes, coverage = exact, quote = "In applying section 1033 (relating to involuntary conversions), the amount realized from the sale or exchange of property shall be treated as being the amount determined")
rule AmountRealizedFor1033(p: Individual, asset: us.irc.core::Asset, on: Date, amount: Money, excluded: Money) strict {
    label en official "section 121(d)(5)(B)";
    when involuntary_disposition_121d5A(p, asset, on, amount);
    when gain_excluded_121a(p, asset, on, excluded);
    then amount_realized_for_1033_121d5B(p, asset, on, amount - excluded);
}
relation some_gain_excluded_121d5B(p: Individual, asset: us.irc.core::Asset, on: Date) kind institutional {
    label en official "helper: some gain from the disposition is excluded under section 121";
}
rule SomeGainExcluded121d5B(p: Individual, asset: us.irc.core::Asset, on: Date, x: Money) strict {
    label en official "helper for section 121(d)(5)(B)";
    when gain_excluded_121a(p, asset, on, x);
    then some_gain_excluded_121d5B(p, asset, on);
}
@source(IRC_S121_D, relation = formalizes, coverage = exact, quote = "In applying section 1033 (relating to involuntary conversions), the amount realized from the sale or exchange of property shall be treated as being the amount determined")
rule AmountRealizedFor1033NoExclusion(p: Individual, asset: us.irc.core::Asset, on: Date, amount: Money) defeasible {
    label en official "section 121(d)(5)(B), no excluded gain";
    when involuntary_disposition_121d5A(p, asset, on, amount);
    when not_known(some_gain_excluded_121d5B(p, asset, on));
    then amount_realized_for_1033_121d5B(p, asset, on, amount);
}
relation converted_property_basis_under_1033b_121d5C(p: Individual, sold_asset: us.irc.core::Asset, converted_from: us.irc.core::Asset, days_held_and_used_of_converted_property: Integer) kind empirical {
    label en official "the basis of the property sold is determined (in whole or in part) under section 1033(b), and the days of holding and use of the converted property";
}
pub relation days_tacked_from_converted_property_121d5C(p: Individual, sold_asset: us.irc.core::Asset, days: Integer) kind institutional {
    label en official "the holding and use of the converted property is treated as holding and use of the property sold or exchanged";
}
@source(IRC_S121_D, relation = formalizes, coverage = exact, quote = "If the basis of the property sold or exchanged is determined (in whole or in part) under section 1033(b) (relating to basis of property acquired through involuntary")
rule DaysTackedFromConvertedProperty(p: Individual, sold: us.irc.core::Asset, from: us.irc.core::Asset, days: Integer) strict {
    label en official "section 121(d)(5)(C)";
    when converted_property_basis_under_1033b_121d5C(p, sold, from, days);
    then days_tacked_from_converted_property_121d5C(p, sold, days);
}

// (d)(7): incapacity and licensed care facilities
relation incapacity_and_facility_days_121d7(p: Individual, asset: us.irc.core::Asset, sale_date: Date, incapable_of_self_care: Boolean, owned_and_used_as_residence_days: Integer, owned_and_resided_in_licensed_facility_days: Integer) kind empirical {
    label en official "the taxpayer becomes physically or mentally incapable of self-care, the days in the 5-year period the property was owned and used as the principal residence, and the days in the period the taxpayer owned the property and resided in a facility (including a nursing home) licensed by a State or political subdivision to care for an individual in the taxpayer's condition";
}
@source(IRC_S121_D, relation = formalizes, coverage = exact, quote = "then the taxpayer shall be treated as using such property as the taxpayer's principal residence during any time during such 5-year period in which the taxpayer owns the")
rule MeetsOwnershipAndUseWithFacilityDays(p: Individual, asset: us.irc.core::Asset, sale_date: Date, used: Integer, facility: Integer) strict {
    label en official "section 121(d)(7)(A)-(B): at least 1 year of residence use; the facility days count as use";
    when incapacity_and_facility_days_121d7(p, asset, sale_date, true, used, facility);
    when used >= 365;
    when used + facility >= 730;
    then meets_ownership_and_use_requirement_121a(p, asset, sale_date);
}

// (d)(8): remainder interests
relation remainder_interest_sale_121d8(p: Individual, asset: us.irc.core::Asset, sale_date: Date, elected_by_taxpayer: Boolean, buyer_is_related_person_267b_707b: Boolean) kind empirical {
    label en official "the sale or exchange of a remainder interest in the principal residence, whether the taxpayer elects, and whether the buyer bears a relationship described in section 267(b) or 707(b)";
}
pub relation remainder_interest_within_121_121d8A(p: Individual, asset: us.irc.core::Asset, sale_date: Date) kind institutional {
    label en official "section 121 does not fail to apply by reason of the interest being a remainder interest (any other interest sold or exchanged separately is outside the section)";
}
@source(IRC_S121_D, relation = formalizes, coverage = exact, quote = "At the election of the taxpayer, this section shall not fail to apply to the sale or exchange of an interest in a principal residence by reason of such interest being a")
rule RemainderInterestWithinSection121(p: Individual, asset: us.irc.core::Asset, sale_date: Date) strict {
    label en official "section 121(d)(8)(A) and (B)";
    when remainder_interest_sale_121d8(p, asset, sale_date, true, false);
    then remainder_interest_within_121_121d8A(p, asset, sale_date);
}

// (d)(9), (d)(12): suspension of the 5-year period
pub enum SuspensionService121 { UniformedServices; ForeignService; IntelligenceCommunity; PeaceCorpsEmployee; PeaceCorpsVolunteer; OtherService; }
pub enum IntelligenceElement121 { OfficeOfDni; Cia; Nsa; Dia; Nga; Nro; OtherDodReconnaissance; ArmyNavyAirForceMarineFbiTreasuryEnergyCoastGuard; StateBureauOfIntelligenceAndResearch; HomelandSecurityForeignIntelligence; OtherAgency; }
relation employed_by_intelligence_element_121d9C(person: Individual, element: IntelligenceElement121) kind empirical {
    label en official "the individual is an employee (section 2105 of title 5) of the intelligence element";
}
pub relation employee_of_intelligence_community_121d9C(person: Individual) kind institutional {
    label en official "an employee of the intelligence community: an employee of any of the offices and elements listed in section 121(d)(9)(C)(iv)(I)-(X)";
}
@source(IRC_S121_D, relation = formalizes, coverage = exact, quote = "(I) the Office of the Director of National Intelligence,")
rule EmployeeOfIntelligenceCommunity(person: Individual, element: IntelligenceElement121) strict {
    label en official "section 121(d)(9)(C)(iv)(I)-(X)";
    when employed_by_intelligence_element_121d9C(person, element);
    when element != OtherAgency;
    then employee_of_intelligence_community_121d9C(person);
}
relation duty_facts_121d9C(person: Individual, service: SuspensionService121, duty_station_distance_miles: Integer, residing_in_government_quarters_under_orders: Boolean, active_duty_days_ordered: Integer, ordered_indefinitely: Boolean) kind empirical {
    label en official "the service, the distance of the duty station from the property in miles, whether the person resides under Government orders in Government quarters, the number of days of the call or order to active duty, and whether it is for an indefinite period";
}
pub relation extended_duty_121d9Cv(person: Individual, service: SuspensionService121) kind institutional {
    label en official "extended duty: a period of active duty pursuant to a call or order for a period in excess of 90 days or for an indefinite period";
}
@source(IRC_S121_D, relation = formalizes, coverage = exact, quote = "The term \"extended duty\" means any period of active duty pursuant to a call or order to such duty for a period in excess of 90 days or for an indefinite period.")
rule ExtendedDutyByLength(person: Individual, service: SuspensionService121, miles: Integer, quarters: Boolean, days: Integer, indef: Boolean) strict {
    label en official "section 121(d)(9)(C)(v): more than 90 days";
    when duty_facts_121d9C(person, service, miles, quarters, days, indef);
    when days > 90;
    then extended_duty_121d9Cv(person, service);
}
@source(IRC_S121_D, relation = formalizes, coverage = exact, quote = "The term \"extended duty\" means any period of active duty pursuant to a call or order to such duty for a period in excess of 90 days or for an indefinite period.")
rule ExtendedDutyIndefinite(person: Individual, service: SuspensionService121, miles: Integer, quarters: Boolean, days: Integer) strict {
    label en official "section 121(d)(9)(C)(v): indefinite period";
    when duty_facts_121d9C(person, service, miles, quarters, days, true);
    then extended_duty_121d9Cv(person, service);
}
pub relation qualified_official_extended_duty_121d9Ci(person: Individual, service: SuspensionService121) kind institutional {
    label en official "qualified official extended duty: extended duty while serving at a duty station at least 50 miles from the property, or while residing under Government orders in Government quarters";
}
@source(IRC_S121_D, relation = formalizes, coverage = exact, quote = "The term \"qualified official extended duty\" means any extended duty while serving at a duty station which is at least 50 miles from such property or while residing under")
rule QualifiedOfficialExtendedDutyByDistance(person: Individual, service: SuspensionService121, miles: Integer, quarters: Boolean, days: Integer, indef: Boolean) strict {
    label en official "section 121(d)(9)(C)(i), distance limb";
    when duty_facts_121d9C(person, service, miles, quarters, days, indef);
    when extended_duty_121d9Cv(person, service);
    when miles >= 50;
    then qualified_official_extended_duty_121d9Ci(person, service);
}
@source(IRC_S121_D, relation = formalizes, coverage = exact, quote = "The term \"qualified official extended duty\" means any extended duty while serving at a duty station which is at least 50 miles from such property or while residing under")
rule QualifiedOfficialExtendedDutyByQuarters(person: Individual, service: SuspensionService121, miles: Integer, days: Integer, indef: Boolean) strict {
    label en official "section 121(d)(9)(C)(i), Government quarters limb";
    when duty_facts_121d9C(person, service, miles, true, days, indef);
    when extended_duty_121d9Cv(person, service);
    then qualified_official_extended_duty_121d9Ci(person, service);
}
relation suspension_election_121d9A(p: Individual, asset: us.irc.core::Asset, elects: Boolean, suspended_days: Integer, serving_person_is_taxpayer_or_spouse: Boolean, service: SuspensionService121) kind empirical {
    label en official "the individual's election for the property, the number of days the taxpayer or the taxpayer's spouse served on qualified official extended duty (or as a Peace Corps employee or volunteer), the service";
}
relation ten_year_cap_days_121d9B(p: Individual, asset: us.irc.core::Asset, sale_date: Date, cap_days: Integer) kind empirical {
    label en official "the number of days in the 10 years by which the 5-year period may be extended at most (the calendar count is left to the case)";
}
pub relation five_year_period_extension_days_121d9(p: Individual, asset: us.irc.core::Asset, sale_date: Date, days: Integer) kind institutional {
    label en official "the days by which the running of the 5-year period is suspended: the days of service, but no more than 10 years in total";
}
@source(IRC_S121_D, relation = formalizes, coverage = exact, quote = "At the election of an individual with respect to a property, the running of the 5-year period described in subsections (a) and (c)(1)(B) and paragraph (7) of this")
rule FiveYearPeriodExtension(p: Individual, asset: us.irc.core::Asset, sale_date: Date, days: Integer, service: SuspensionService121, cap: Integer) strict {
    label en official "section 121(d)(9)(A)-(B): suspension on election, capped at 10 years";
    when suspension_election_121d9A(p, asset, true, days, true, service);
    when ten_year_cap_days_121d9B(p, asset, sale_date, cap);
    when not_known(revokes_suspension_election_121d9Dii(p, asset));
    when not_known(other_property_election_in_effect_121d9Di(p, asset));
    then five_year_period_extension_days_121d9(p, asset, sale_date, min(days, cap));
}
relation election_in_effect_for_property_121d9D(p: Individual, asset: us.irc.core::Asset) kind empirical {
    label en official "the election under section 121(d)(9)(A) is in effect for the property";
}
relation election_in_effect_for_other_property_121d9D(p: Individual, asset: us.irc.core::Asset, other: us.irc.core::Asset) kind empirical {
    label en official "such an election is in effect with respect to another property";
}
relation other_property_election_in_effect_121d9Di(p: Individual, asset: us.irc.core::Asset) kind institutional {
    label en official "an election is in effect with respect to another property, so none may be made for this one";
}
@source(IRC_S121_D, relation = formalizes, coverage = exact, quote = "An election under subparagraph (A) with respect to any property may not be made if such an election is in effect with respect to any other property.")
rule OtherPropertyElectionInEffect(p: Individual, asset: us.irc.core::Asset, other: us.irc.core::Asset) strict {
    label en official "section 121(d)(9)(D)(i)";
    when election_in_effect_for_other_property_121d9D(p, asset, other);
    when other != asset;
    then other_property_election_in_effect_121d9Di(p, asset);
}
relation revokes_suspension_election_121d9Dii(p: Individual, asset: us.irc.core::Asset) kind empirical {
    label en official "the individual revokes the election";
}
pub relation suspension_election_revoked_121d9Dii(p: Individual, asset: us.irc.core::Asset) kind institutional {
    label en official "the election has been revoked (it may be revoked at any time)";
}
@source(IRC_S121_D, relation = formalizes, coverage = exact, quote = "An election under subparagraph (A) may be revoked at any time.")
rule Section121d9DiiRevocationRule defeasible {
    for p: Individual;
    for asset: us.irc.core::Asset;
    when election_in_effect_for_property_121d9D(p, asset);
    then power Section121d9Dii {
        holder p;
        over asset;
        exercise revokes_suspension_election_121d9Dii(p, asset);
        valid_when election_in_effect_for_property_121d9D(p, asset);
        effect create(suspension_election_revoked_121d9Dii(p, asset));
        window [-infinity, infinity];
    };
}
relation days_in_extended_period_121d9(p: Individual, asset: us.irc.core::Asset, sale_date: Date, days: Integer) kind empirical {
    label en official "the aggregate days owned and used as the principal residence within the 5-year period as extended by the suspension";
}
@source(IRC_S121_D, relation = formalizes, coverage = exact, quote = "At the election of an individual with respect to a property, the running of the 5-year period described in subsections (a) and (c)(1)(B) and paragraph (7) of this")
rule MeetsOwnershipAndUseInExtendedPeriod(p: Individual, asset: us.irc.core::Asset, sale_date: Date, ext: Integer, days: Integer) strict {
    label en official "section 121(d)(9)(A), (12)(A): the 2-year test measured over the extended period";
    when five_year_period_extension_days_121d9(p, asset, sale_date, ext);
    when ext > 0;
    when days_in_extended_period_121d9(p, asset, sale_date, days);
    when days >= 730;
    then meets_ownership_and_use_requirement_121a(p, asset, sale_date);
}
pub relation peace_corps_service_suspends_121d12(p: Individual, asset: us.irc.core::Asset) kind institutional {
    label en official "service on qualified official extended duty as an employee of the Peace Corps, or as an enrolled volunteer or volunteer leader, suspends the 5-year period on election, with rules similar to (9)(B) and (D)";
}
@source(IRC_S121_D, relation = formalizes, coverage = exact, quote = "At the election of an individual with respect to a property, the running of the 5-year period described in subsections (a) and (c)(1)(B) and paragraph (7) of this")
rule PeaceCorpsEmployeeSuspends(p: Individual, asset: us.irc.core::Asset, days: Integer) strict {
    label en official "section 121(d)(12)(A)(i): a Peace Corps employee on qualified official extended duty (as defined in paragraph (9)(C))";
    when suspension_election_121d9A(p, asset, true, days, true, PeaceCorpsEmployee);
    when qualified_official_extended_duty_121d9Ci(p, PeaceCorpsEmployee);
    then peace_corps_service_suspends_121d12(p, asset);
}
@source(IRC_S121_D, relation = formalizes, coverage = exact, quote = "(ii) as an enrolled volunteer or volunteer leader under section 5 or 6 (as the case may be) of the Peace Corps Act (22 U.S.C. 2504, 2505).")
rule PeaceCorpsVolunteerSuspends(p: Individual, asset: us.irc.core::Asset, days: Integer) strict {
    label en official "section 121(d)(12)(A)(ii): an enrolled volunteer or volunteer leader under section 5 or 6 of the Peace Corps Act";
    when suspension_election_121d9A(p, asset, true, days, true, PeaceCorpsVolunteer);
    then peace_corps_service_suspends_121d12(p, asset);
}

// (d)(10): property acquired in a section 1031 exchange
relation acquired_in_1031_exchange_121d10(p: Individual, asset: us.irc.core::Asset, acquired_on: Date, gain_not_recognized_under_1031: Boolean) kind empirical {
    label en official "the taxpayer (or the person whose basis carries over) acquired the property in an exchange with respect to which gain is not recognized (in whole or in part) under section 1031(a) or (b), and the acquisition date";
}
pub relation section_121a_barred_by_1031_acquisition_121d10(p: Individual, asset: us.irc.core::Asset, sale_date: Date) kind institutional {
    label en official "subsection (a) does not apply to the sale of the property if the sale occurs during the 5-year period beginning on the date of the acquisition";
}
@source(IRC_S121_D, relation = formalizes, coverage = exact, quote = "If a taxpayer acquires property in an exchange with respect to which gain is not recognized (in whole or in part) to the taxpayer under subsection (a) or (b) of section")
rule Section121aBarredBy1031Acquisition(p: Individual, asset: us.irc.core::Asset, sale_date: Date, gain: Money, acquired: Date) strict {
    label en official "section 121(d)(10): the 5-year period beginning on the acquisition date";
    when sale_or_exchange_of_property(p, asset, sale_date, gain);
    when acquired_in_1031_exchange_121d10(p, asset, acquired, true);
    when sale_date >= acquired;
    when sale_date < add_calendar_period(acquired, 5 calendar_year);
    then section_121a_barred_by_1031_acquisition_121d10(p, asset, sale_date);
}
