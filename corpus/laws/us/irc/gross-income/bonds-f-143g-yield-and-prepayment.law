rule YieldPv143g2S13(issue: BondIssue, lo: Decimal, hi: Decimal, mid: Decimal, f: Decimal, price: Decimal, p1: Decimal, p2: Decimal, p3: Decimal, p4: Decimal) strict {
    when yield_factor_143g2_13(issue, lo, hi, mid, f);
    when yield_inputs_143g2(issue, price, p1, p2, p3, p4);
    then yield_pv_143g2_13(issue, lo, hi, mid, p1 * div_round(1.0, f, 10, "HALF_UP") + p2 * div_round(div_round(1.0, f, 10, "HALF_UP"), f, 10, "HALF_UP") + p3 * div_round(div_round(div_round(1.0, f, 10, "HALF_UP"), f, 10, "HALF_UP"), f, 10, "HALF_UP") + p4 * div_round(div_round(div_round(div_round(1.0, f, 10, "HALF_UP"), f, 10, "HALF_UP"), f, 10, "HALF_UP"), f, 10, "HALF_UP"));
}
rule YieldRaiseLow143g2S13(issue: BondIssue, lo: Decimal, hi: Decimal, mid: Decimal, pv: Decimal, price: Decimal, p1: Decimal, p2: Decimal, p3: Decimal, p4: Decimal) strict {
    label en unofficial "the present value at the midpoint exceeds the price: the yield is above the midpoint";
    when yield_pv_143g2_13(issue, lo, hi, mid, pv);
    when yield_inputs_143g2(issue, price, p1, p2, p3, p4);
    when pv > price;
    then yield_bisect_143g2_14(issue, mid, hi);
}
rule YieldLowerHigh143g2S13(issue: BondIssue, lo: Decimal, hi: Decimal, mid: Decimal, pv: Decimal, price: Decimal, p1: Decimal, p2: Decimal, p3: Decimal, p4: Decimal) strict {
    label en unofficial "the present value at the midpoint does not exceed the price: the yield is at or below the midpoint";
    when yield_pv_143g2_13(issue, lo, hi, mid, pv);
    when yield_inputs_143g2(issue, price, p1, p2, p3, p4);
    when pv <= price;
    then yield_bisect_143g2_14(issue, lo, mid);
}
relation yield_mid_143g2_14(issue: BondIssue, lo: Decimal, hi: Decimal, mid: Decimal) kind institutional {
    label en unofficial "bisection step 14: the midpoint of the range";
}
relation yield_factor_143g2_14(issue: BondIssue, lo: Decimal, hi: Decimal, mid: Decimal, factor: Decimal) kind institutional {
    label en unofficial "bisection step 14: one plus the midpoint rate as a fraction";
}
relation yield_pv_143g2_14(issue: BondIssue, lo: Decimal, hi: Decimal, mid: Decimal, pv: Decimal) kind institutional {
    label en unofficial "bisection step 14: the present value of the payments at the midpoint rate";
}
relation yield_bisect_143g2_15(issue: BondIssue, lo: Decimal, hi: Decimal) kind institutional {
    label en unofficial "bisection step 15: the range of the yield in percent";
}
rule YieldMid143g2S14(issue: BondIssue, lo: Decimal, hi: Decimal) strict {
    when yield_bisect_143g2_14(issue, lo, hi);
    then yield_mid_143g2_14(issue, lo, hi, div_round(lo + hi, 2.0, 8, "HALF_UP"));
}
rule YieldFactor143g2S14(issue: BondIssue, lo: Decimal, hi: Decimal, mid: Decimal) strict {
    when yield_mid_143g2_14(issue, lo, hi, mid);
    then yield_factor_143g2_14(issue, lo, hi, mid, 1.0 + div_round(mid, 100.0, 10, "HALF_UP"));
}
rule YieldPv143g2S14(issue: BondIssue, lo: Decimal, hi: Decimal, mid: Decimal, f: Decimal, price: Decimal, p1: Decimal, p2: Decimal, p3: Decimal, p4: Decimal) strict {
    when yield_factor_143g2_14(issue, lo, hi, mid, f);
    when yield_inputs_143g2(issue, price, p1, p2, p3, p4);
    then yield_pv_143g2_14(issue, lo, hi, mid, p1 * div_round(1.0, f, 10, "HALF_UP") + p2 * div_round(div_round(1.0, f, 10, "HALF_UP"), f, 10, "HALF_UP") + p3 * div_round(div_round(div_round(1.0, f, 10, "HALF_UP"), f, 10, "HALF_UP"), f, 10, "HALF_UP") + p4 * div_round(div_round(div_round(div_round(1.0, f, 10, "HALF_UP"), f, 10, "HALF_UP"), f, 10, "HALF_UP"), f, 10, "HALF_UP"));
}
rule YieldRaiseLow143g2S14(issue: BondIssue, lo: Decimal, hi: Decimal, mid: Decimal, pv: Decimal, price: Decimal, p1: Decimal, p2: Decimal, p3: Decimal, p4: Decimal) strict {
    label en unofficial "the present value at the midpoint exceeds the price: the yield is above the midpoint";
    when yield_pv_143g2_14(issue, lo, hi, mid, pv);
    when yield_inputs_143g2(issue, price, p1, p2, p3, p4);
    when pv > price;
    then yield_bisect_143g2_15(issue, mid, hi);
}
rule YieldLowerHigh143g2S14(issue: BondIssue, lo: Decimal, hi: Decimal, mid: Decimal, pv: Decimal, price: Decimal, p1: Decimal, p2: Decimal, p3: Decimal, p4: Decimal) strict {
    label en unofficial "the present value at the midpoint does not exceed the price: the yield is at or below the midpoint";
    when yield_pv_143g2_14(issue, lo, hi, mid, pv);
    when yield_inputs_143g2(issue, price, p1, p2, p3, p4);
    when pv <= price;
    then yield_bisect_143g2_15(issue, lo, mid);
}
relation yield_mid_143g2_15(issue: BondIssue, lo: Decimal, hi: Decimal, mid: Decimal) kind institutional {
    label en unofficial "bisection step 15: the midpoint of the range";
}
relation yield_factor_143g2_15(issue: BondIssue, lo: Decimal, hi: Decimal, mid: Decimal, factor: Decimal) kind institutional {
    label en unofficial "bisection step 15: one plus the midpoint rate as a fraction";
}
relation yield_pv_143g2_15(issue: BondIssue, lo: Decimal, hi: Decimal, mid: Decimal, pv: Decimal) kind institutional {
    label en unofficial "bisection step 15: the present value of the payments at the midpoint rate";
}
relation yield_bisect_143g2_16(issue: BondIssue, lo: Decimal, hi: Decimal) kind institutional {
    label en unofficial "bisection step 16: the range of the yield in percent";
}
rule YieldMid143g2S15(issue: BondIssue, lo: Decimal, hi: Decimal) strict {
    when yield_bisect_143g2_15(issue, lo, hi);
    then yield_mid_143g2_15(issue, lo, hi, div_round(lo + hi, 2.0, 8, "HALF_UP"));
}
rule YieldFactor143g2S15(issue: BondIssue, lo: Decimal, hi: Decimal, mid: Decimal) strict {
    when yield_mid_143g2_15(issue, lo, hi, mid);
    then yield_factor_143g2_15(issue, lo, hi, mid, 1.0 + div_round(mid, 100.0, 10, "HALF_UP"));
}
rule YieldPv143g2S15(issue: BondIssue, lo: Decimal, hi: Decimal, mid: Decimal, f: Decimal, price: Decimal, p1: Decimal, p2: Decimal, p3: Decimal, p4: Decimal) strict {
    when yield_factor_143g2_15(issue, lo, hi, mid, f);
    when yield_inputs_143g2(issue, price, p1, p2, p3, p4);
    then yield_pv_143g2_15(issue, lo, hi, mid, p1 * div_round(1.0, f, 10, "HALF_UP") + p2 * div_round(div_round(1.0, f, 10, "HALF_UP"), f, 10, "HALF_UP") + p3 * div_round(div_round(div_round(1.0, f, 10, "HALF_UP"), f, 10, "HALF_UP"), f, 10, "HALF_UP") + p4 * div_round(div_round(div_round(div_round(1.0, f, 10, "HALF_UP"), f, 10, "HALF_UP"), f, 10, "HALF_UP"), f, 10, "HALF_UP"));
}
rule YieldRaiseLow143g2S15(issue: BondIssue, lo: Decimal, hi: Decimal, mid: Decimal, pv: Decimal, price: Decimal, p1: Decimal, p2: Decimal, p3: Decimal, p4: Decimal) strict {
    label en unofficial "the present value at the midpoint exceeds the price: the yield is above the midpoint";
    when yield_pv_143g2_15(issue, lo, hi, mid, pv);
    when yield_inputs_143g2(issue, price, p1, p2, p3, p4);
    when pv > price;
    then yield_bisect_143g2_16(issue, mid, hi);
}
rule YieldLowerHigh143g2S15(issue: BondIssue, lo: Decimal, hi: Decimal, mid: Decimal, pv: Decimal, price: Decimal, p1: Decimal, p2: Decimal, p3: Decimal, p4: Decimal) strict {
    label en unofficial "the present value at the midpoint does not exceed the price: the yield is at or below the midpoint";
    when yield_pv_143g2_15(issue, lo, hi, mid, pv);
    when yield_inputs_143g2(issue, price, p1, p2, p3, p4);
    when pv <= price;
    then yield_bisect_143g2_16(issue, lo, mid);
}
pub relation yield_on_issue_computed_143g2(issue: BondIssue, yield_on_issue_percent: Decimal) kind institutional {
    label en official "the yield on the issue in percent (discount rate at which the payments equal the issue price), by 16-step bisection over 0 to 50 percent";
}
@source(IRC_S143_G, relation = formalizes, coverage = partial, quote = "(ii) an expected maturity for the bonds which is consistent with the assumptions required under subparagraph (B)(iv).")
rule YieldOnIssueComputed143g2(issue: BondIssue, lo: Decimal, hi: Decimal) strict {
    label en official "section 143(g)(2)(A)(ii), (C): the yield is the midpoint of the last bisection range";
    when yield_bisect_143g2_16(issue, lo, hi);
    then yield_on_issue_computed_143g2(issue, div_round(lo + hi, 2.0, 6, "HALF_UP"));
}
relation has_computed_yield_143g2(issue: BondIssue) kind institutional {
    label en unofficial "a yield on the issue is computed from the payment schedule";
}
rule HasComputedYield143g2(issue: BondIssue, y: Decimal) strict {
    when yield_on_issue_computed_143g2(issue, y);
    then has_computed_yield_143g2(issue);
}
relation effective_rate_on_mortgages_143g2(issue: BondIssue, effective_rate_percent: Decimal) kind empirical {
    label en official "the effective rate of interest on the mortgages in percent (the input of subparagraph (A)(i); the yield is computed)";
}
@source(IRC_S143_G, relation = formalizes, coverage = exact, quote = "An issue shall be treated as meeting the requirements of this paragraph only if the excess of—")
rule EffectiveRateSpreadWithinLimitComputedYield(issue: BondIssue, eff_rate: Decimal, yield_rate: Decimal) strict {
    label en official "section 143(g)(2)(A): the excess of the effective rate over the COMPUTED yield is not greater than 1.125 percentage points";
    when effective_rate_on_mortgages_143g2(issue, eff_rate);
    when yield_on_issue_computed_143g2(issue, yield_rate);
    when eff_rate - yield_rate <= 1.125;
    then effective_rate_spread_within_limit_143g2(issue);
}

// ============================================================================
// §143(g)(2)(B)(iv)(II): an expected prepayment is treated as received on the last day of its month (G6702)
// ============================================================================
// The language has no day-of-month accessor, so the case names the first day of the month of the expected prepayment
// (`expected_prepayment_month_start_143g2`); the last day of the month is the calendar step "one month after the first
// day, less one day" (the first day never lands on a nonexistent day, so the month-end policy of `IRC_CALENDAR_STEP`
// never refuses it). The expected date must lie in that month (the rule states no date outside it).

relation expected_prepayment_143g2(issue: BondIssue, index: Integer, expected_on: Date, month_start: Date, amount: Money) kind empirical {
    label en unofficial "an expected prepayment of principal: its expected date, the first day of the month that contains it, and its amount";
}
pub relation prepayment_treated_as_received_143g2(issue: BondIssue, index: Integer, received_on: Date, amount: Money) kind institutional {
    label en official "the expected prepayment treated as received on the last day of the month in which the issuer reasonably expects to receive it";
}
@source(IRC_S143_G, relation = formalizes, coverage = exact, quote = "(II) prepayments of principal shall be treated as received on the last day of the month in which the issuer reasonably expects to receive such prepayments.")
rule PrepaymentTreatedAsReceivedOnMonthEnd(issue: BondIssue, i: Integer, d: Date, m: Date, amount: Money, calendar_before_1: Date) strict {
    label en official "section 143(g)(2)(B)(iv)(II): the last day of the month is the day before the first day of the next month";
    when expected_prepayment_143g2(issue, i, d, m, amount);
    when d >= m;
    when d < add_calendar_period(m, 1 calendar_month)
        and us.irc.core::civil_calendar_boundary_before(add_calendar_period(m, 1 calendar_month), 1, us.irc.core::CalendarDay, calendar_before_1);
    then prepayment_treated_as_received_143g2(issue, i, calendar_before_1, amount);
}
