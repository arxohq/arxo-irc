// Stage 4b (26.09.2026, DECISION-0379 with deontics): §143(g)(2)(A)-(C) yield on the issue (G6701) and the month-end of
// an expected prepayment (G6702).
//
// TECHNIQUE (bounded bisection, no root-finding in the language). The yield is an internal rate of return. `pow` takes
// integer bases only, so the discount factor is formed by REPEATED division (`div_round`, 10 places, HALF_UP), and the
// rate by BISECTION over the closed range 0 to 50 percent, unrolled 16 steps: step k is its own predicate (a predicate
// cannot feed itself, LDC-E4102). The width of the range after 16 steps is 50 / 2^16 = about 0.0008 percentage points;
// the result is the midpoint of the last range, rounded to 6 places. BOUNDS (JUDGMENT CALL, recorded in TECH-GAPS G6712):
// annual payment periods, payments at the ends of years 1 to 4 (`yield_payment_143g2`, a case input; a payment schedule
// longer than four years is outside the bound), a yield between 0 and 50 percent, the present value of payments
// decreasing in the rate. The issue price of (C) is a case input (sections 1273 and 1274 belong to another owner).

use self::{
    BondIssue,
    IRC_S143_G,
    effective_rate_spread_within_limit_143g2,
};

relation yield_payment_143g2(issue: BondIssue, year_index: Integer, amount: Money) kind empirical {
    label en unofficial "the payment on the issue expected at the end of the year_index-th year after the issue date (1 to 4)";
}
relation yield_issue_price_143g2(issue: BondIssue, price: Money) kind empirical {
    label en unofficial "the issue price of the bonds (the value that the payments are discounted to)";
}
relation yield_inputs_143g2(issue: BondIssue, price: Decimal, p1: Decimal, p2: Decimal, p3: Decimal, p4: Decimal) kind institutional {
    label en unofficial "the issue price and the payments of years 1 to 4 in dollars (a year without a payment counts zero)";
}
@source(IRC_S143_G, relation = formalizes, coverage = partial, quote = "(ii) an expected maturity for the bonds which is consistent with the assumptions required under subparagraph (B)(iv).")
rule YieldInputs143g2(issue: BondIssue, price: Money) strict {
    label en official "section 143(g)(2)(C): the issue price and the expected payments, collected per year (bounded at four years)";
    when yield_issue_price_143g2(issue, price);
    then yield_inputs_143g2(issue, price / 1.00 USD,
        sum(collect all a: Money where yield_payment_143g2(issue, 1, a), empty: 0.00 USD) / 1.00 USD,
        sum(collect all a: Money where yield_payment_143g2(issue, 2, a), empty: 0.00 USD) / 1.00 USD,
        sum(collect all a: Money where yield_payment_143g2(issue, 3, a), empty: 0.00 USD) / 1.00 USD,
        sum(collect all a: Money where yield_payment_143g2(issue, 4, a), empty: 0.00 USD) / 1.00 USD);
}
relation yield_bisect_143g2_0(issue: BondIssue, lo: Decimal, hi: Decimal) kind institutional {
    label en unofficial "bisection step 0: the range of the yield in percent (0 to 50)";
}
@source(IRC_S143_G, relation = formalizes, coverage = partial, quote = "(ii) an expected maturity for the bonds which is consistent with the assumptions required under subparagraph (B)(iv).")
rule YieldBisectStart143g2(issue: BondIssue, price: Decimal, p1: Decimal, p2: Decimal, p3: Decimal, p4: Decimal) strict {
    when yield_inputs_143g2(issue, price, p1, p2, p3, p4);
    then yield_bisect_143g2_0(issue, 0.0, 50.0);
}
relation yield_mid_143g2_0(issue: BondIssue, lo: Decimal, hi: Decimal, mid: Decimal) kind institutional {
    label en unofficial "bisection step 0: the midpoint of the range";
}
relation yield_factor_143g2_0(issue: BondIssue, lo: Decimal, hi: Decimal, mid: Decimal, factor: Decimal) kind institutional {
    label en unofficial "bisection step 0: one plus the midpoint rate as a fraction";
}
relation yield_pv_143g2_0(issue: BondIssue, lo: Decimal, hi: Decimal, mid: Decimal, pv: Decimal) kind institutional {
    label en unofficial "bisection step 0: the present value of the payments at the midpoint rate";
}
relation yield_bisect_143g2_1(issue: BondIssue, lo: Decimal, hi: Decimal) kind institutional {
    label en unofficial "bisection step 1: the range of the yield in percent";
}
rule YieldMid143g2S0(issue: BondIssue, lo: Decimal, hi: Decimal) strict {
    when yield_bisect_143g2_0(issue, lo, hi);
    then yield_mid_143g2_0(issue, lo, hi, div_round(lo + hi, 2.0, 8, "HALF_UP"));
}
rule YieldFactor143g2S0(issue: BondIssue, lo: Decimal, hi: Decimal, mid: Decimal) strict {
    when yield_mid_143g2_0(issue, lo, hi, mid);
    then yield_factor_143g2_0(issue, lo, hi, mid, 1.0 + div_round(mid, 100.0, 10, "HALF_UP"));
}
rule YieldPv143g2S0(issue: BondIssue, lo: Decimal, hi: Decimal, mid: Decimal, f: Decimal, price: Decimal, p1: Decimal, p2: Decimal, p3: Decimal, p4: Decimal) strict {
    when yield_factor_143g2_0(issue, lo, hi, mid, f);
    when yield_inputs_143g2(issue, price, p1, p2, p3, p4);
    then yield_pv_143g2_0(issue, lo, hi, mid, p1 * div_round(1.0, f, 10, "HALF_UP") + p2 * div_round(div_round(1.0, f, 10, "HALF_UP"), f, 10, "HALF_UP") + p3 * div_round(div_round(div_round(1.0, f, 10, "HALF_UP"), f, 10, "HALF_UP"), f, 10, "HALF_UP") + p4 * div_round(div_round(div_round(div_round(1.0, f, 10, "HALF_UP"), f, 10, "HALF_UP"), f, 10, "HALF_UP"), f, 10, "HALF_UP"));
}
rule YieldRaiseLow143g2S0(issue: BondIssue, lo: Decimal, hi: Decimal, mid: Decimal, pv: Decimal, price: Decimal, p1: Decimal, p2: Decimal, p3: Decimal, p4: Decimal) strict {
    label en unofficial "the present value at the midpoint exceeds the price: the yield is above the midpoint";
    when yield_pv_143g2_0(issue, lo, hi, mid, pv);
    when yield_inputs_143g2(issue, price, p1, p2, p3, p4);
    when pv > price;
    then yield_bisect_143g2_1(issue, mid, hi);
}
rule YieldLowerHigh143g2S0(issue: BondIssue, lo: Decimal, hi: Decimal, mid: Decimal, pv: Decimal, price: Decimal, p1: Decimal, p2: Decimal, p3: Decimal, p4: Decimal) strict {
    label en unofficial "the present value at the midpoint does not exceed the price: the yield is at or below the midpoint";
    when yield_pv_143g2_0(issue, lo, hi, mid, pv);
    when yield_inputs_143g2(issue, price, p1, p2, p3, p4);
    when pv <= price;
    then yield_bisect_143g2_1(issue, lo, mid);
}
relation yield_mid_143g2_1(issue: BondIssue, lo: Decimal, hi: Decimal, mid: Decimal) kind institutional {
    label en unofficial "bisection step 1: the midpoint of the range";
}
relation yield_factor_143g2_1(issue: BondIssue, lo: Decimal, hi: Decimal, mid: Decimal, factor: Decimal) kind institutional {
    label en unofficial "bisection step 1: one plus the midpoint rate as a fraction";
}
relation yield_pv_143g2_1(issue: BondIssue, lo: Decimal, hi: Decimal, mid: Decimal, pv: Decimal) kind institutional {
    label en unofficial "bisection step 1: the present value of the payments at the midpoint rate";
}
relation yield_bisect_143g2_2(issue: BondIssue, lo: Decimal, hi: Decimal) kind institutional {
    label en unofficial "bisection step 2: the range of the yield in percent";
}
rule YieldMid143g2S1(issue: BondIssue, lo: Decimal, hi: Decimal) strict {
    when yield_bisect_143g2_1(issue, lo, hi);
    then yield_mid_143g2_1(issue, lo, hi, div_round(lo + hi, 2.0, 8, "HALF_UP"));
}
rule YieldFactor143g2S1(issue: BondIssue, lo: Decimal, hi: Decimal, mid: Decimal) strict {
    when yield_mid_143g2_1(issue, lo, hi, mid);
    then yield_factor_143g2_1(issue, lo, hi, mid, 1.0 + div_round(mid, 100.0, 10, "HALF_UP"));
}
rule YieldPv143g2S1(issue: BondIssue, lo: Decimal, hi: Decimal, mid: Decimal, f: Decimal, price: Decimal, p1: Decimal, p2: Decimal, p3: Decimal, p4: Decimal) strict {
    when yield_factor_143g2_1(issue, lo, hi, mid, f);
    when yield_inputs_143g2(issue, price, p1, p2, p3, p4);
    then yield_pv_143g2_1(issue, lo, hi, mid, p1 * div_round(1.0, f, 10, "HALF_UP") + p2 * div_round(div_round(1.0, f, 10, "HALF_UP"), f, 10, "HALF_UP") + p3 * div_round(div_round(div_round(1.0, f, 10, "HALF_UP"), f, 10, "HALF_UP"), f, 10, "HALF_UP") + p4 * div_round(div_round(div_round(div_round(1.0, f, 10, "HALF_UP"), f, 10, "HALF_UP"), f, 10, "HALF_UP"), f, 10, "HALF_UP"));
}
rule YieldRaiseLow143g2S1(issue: BondIssue, lo: Decimal, hi: Decimal, mid: Decimal, pv: Decimal, price: Decimal, p1: Decimal, p2: Decimal, p3: Decimal, p4: Decimal) strict {
    label en unofficial "the present value at the midpoint exceeds the price: the yield is above the midpoint";
    when yield_pv_143g2_1(issue, lo, hi, mid, pv);
    when yield_inputs_143g2(issue, price, p1, p2, p3, p4);
    when pv > price;
    then yield_bisect_143g2_2(issue, mid, hi);
}
rule YieldLowerHigh143g2S1(issue: BondIssue, lo: Decimal, hi: Decimal, mid: Decimal, pv: Decimal, price: Decimal, p1: Decimal, p2: Decimal, p3: Decimal, p4: Decimal) strict {
    label en unofficial "the present value at the midpoint does not exceed the price: the yield is at or below the midpoint";
