}
relation yield_mid_143g2_2(issue: BondIssue, lo: Decimal, hi: Decimal, mid: Decimal) kind institutional {
    label en unofficial "bisection step 2: the midpoint of the range";
}
relation yield_factor_143g2_2(issue: BondIssue, lo: Decimal, hi: Decimal, mid: Decimal, factor: Decimal) kind institutional {
