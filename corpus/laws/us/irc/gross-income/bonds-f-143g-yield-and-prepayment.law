}
rule YieldRaiseLow143g2S2(issue: BondIssue, lo: Decimal, hi: Decimal, mid: Decimal, pv: Decimal, price: Decimal, p1: Decimal, p2: Decimal, p3: Decimal, p4: Decimal) strict {
