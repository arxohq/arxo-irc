// Stage 2f (TECH_GAP reduction) — private activity bonds, second part: the
// per-category definitions of section 142(d)-(p) and the link to the 95 percent
// test of §142(a): `facility_conditions_met_142(issue, kind)` is the conjunction of
// the conditions the statute attaches to a kind; the earlier rule
// `ExemptFacilityBondClassified` now also reads it (the earlier scenario
// S142-01 was extended with the ownership fact accordingly).
// STATUS: implemented_unverified (static check only; scenarios in
// tests/bonds-b-142-kinds.lawtest are NOT executed).

use self::{
    BondIssue,
    ExemptFacilityUseKind,
    Facility142,
    IRC_S142_D,
    IRC_S142_E,
    IRC_S142_F,
    IRC_S142_G,
    IRC_S142_H,
    IRC_S142_I,
    IRC_S142_J,
    IRC_S142_K,
    IRC_S142_L,
    IRC_S142_M,
    IRC_S142_N,
    IRC_S142_O,
    Individual,
    Person,
    Secretary,
    TaxableYear,
    facility_fails_142c2_of_kind,
    governmental_ownership_requirement_met_142b1,
    issue_finances_facility_142,
    issue_net_proceeds_for_exempt_facility_use,
    issue_total_proceeds,
};

pub relation facility_conditions_met_142(issue: BondIssue, kind: ExemptFacilityUseKind) kind institutional {
    label en official "the conditions section 142(b)-(o) attaches to the exempt facility kind are met for the issue (kinds with no further condition are met whenever proceeds are recorded for them)";
}
relation bond_issue_date_142(issue: BondIssue, issued_on: Date) kind empirical {
    label en official "the date the issue is issued";
}

// =====================================================================
// §142(a)(1)-(6): airports, docks, mass commuting, water, sewage, solid waste
// =====================================================================

rule FacilityConditionsAirports(issue: BondIssue) strict {
    label en official "section 142(b)(1): governmental ownership (or treated ownership by lease)";
    when issue_net_proceeds_for_exempt_facility_use(issue, Airports, _);
    when governmental_ownership_requirement_met_142b1(issue);
    then facility_conditions_met_142(issue, Airports);
}
rule FacilityConditionsDocks(issue: BondIssue) strict {
    label en official "section 142(b)(1)";
    when issue_net_proceeds_for_exempt_facility_use(issue, DocksAndWharves, _);
    when governmental_ownership_requirement_met_142b1(issue);
    then facility_conditions_met_142(issue, DocksAndWharves);
}
rule FacilityConditionsMassCommuting(issue: BondIssue) strict {
    label en official "section 142(b)(1)";
    when issue_net_proceeds_for_exempt_facility_use(issue, MassCommutingFacilities, _);
    when governmental_ownership_requirement_met_142b1(issue);
    then facility_conditions_met_142(issue, MassCommutingFacilities);
}
rule FacilityConditionsHydroelectricOwnership(issue: BondIssue) strict {
    label en official "section 142(b)(1) applies to paragraph (12) facilities; the (j) conditions are separate";
    when issue_net_proceeds_for_exempt_facility_use(issue, HydroelectricEnvironmentalEnhancement, _);
    when governmental_ownership_requirement_met_142b1(issue);
    when hydroelectric_conditions_met_142j(issue);
    then facility_conditions_met_142(issue, HydroelectricEnvironmentalEnhancement);
}
rule FacilityConditionsSewage(issue: BondIssue) strict {
    label en official "sewage facilities carry no further condition in subsections (b)-(o)";
    when issue_net_proceeds_for_exempt_facility_use(issue, SewageFacilities, _);
    then facility_conditions_met_142(issue, SewageFacilities);
}
rule FacilityConditionsSolidWaste(issue: BondIssue) strict {
    label en official "solid waste disposal facilities carry no further condition in subsections (b)-(o)";
    when issue_net_proceeds_for_exempt_facility_use(issue, SolidWasteDisposal, _);
    then facility_conditions_met_142(issue, SolidWasteDisposal);
}
relation facility_of_issue_fails_142c2_142(issue: BondIssue) kind institutional {
    label en official "helper: some facility financed by the issue fails the section 142(c)(2) test";
}
rule FacilityOfIssueFails142c2(issue: BondIssue, facility: Facility142, kind: ExemptFacilityUseKind) strict {
    label en official "section 142(c)(2)";
    when issue_finances_facility_142(issue, facility, kind);
    when facility_fails_142c2_of_kind(facility, kind);
    then facility_of_issue_fails_142c2_142(issue);
}

// (e): water
relation water_made_available_to_general_public_142e1(issue: BondIssue) kind empirical {
    label en official "the water is or will be made available to members of the general public (including electric utility, industrial, agricultural or commercial users)";
}
relation water_facility_operated_by_governmental_unit_142e2(issue: BondIssue) kind empirical {
    label en official "the facility is operated by a governmental unit";
}
relation water_rates_established_or_approved_by_public_body_142e2(issue: BondIssue) kind empirical {
    label en official "the rates for furnishing or selling the water have been established or approved by a State or political subdivision, by an agency or instrumentality of the United States, or by a public service or public utility commission or similar body";
}
pub relation water_facility_conditions_met_142e(issue: BondIssue) kind institutional {
    label en official "a facility for the furnishing of water within section 142(e)";
}
@source(IRC_S142_E, relation = formalizes, coverage = exact, quote = "(1) the water is or will be made available to members of the general public (including electric utility, industrial, agricultural, or commercial users), and")
rule WaterFacilityByGovernmentOperation(issue: BondIssue) strict {
    label en official "section 142(e)(1) and (2), operated by a governmental unit";
    when water_made_available_to_general_public_142e1(issue);
    when water_facility_operated_by_governmental_unit_142e2(issue);
    then water_facility_conditions_met_142e(issue);
}
@source(IRC_S142_E, relation = formalizes, coverage = exact, quote = "(2) either the facility is operated by a governmental unit or the rates for the furnishing or sale of the water have been established or approved by a State or political")
rule WaterFacilityByRateApproval(issue: BondIssue) strict {
    label en official "section 142(e)(1) and (2), rates set or approved by a public body";
    when water_made_available_to_general_public_142e1(issue);
    when water_rates_established_or_approved_by_public_body_142e2(issue);
    then water_facility_conditions_met_142e(issue);
}
rule FacilityConditionsWater(issue: BondIssue) strict {
    label en official "section 142(a)(4) with (e)";
    when issue_net_proceeds_for_exempt_facility_use(issue, WaterFurnishing, _);
    when water_facility_conditions_met_142e(issue);
    then facility_conditions_met_142(issue, WaterFurnishing);
}

// =====================================================================
// §142(d): qualified residential rental projects
// =====================================================================

pub entity ResidentialRentalProject142 {
    label en unofficial "a project for residential rental property financed by an issue (case-asserted)";
}
pub enum SetAsideElection142d { TwentyFiftyTest; FortySixtyTest; NoSetAsideElection; }
relation project_of_issue_142d(issue: BondIssue, project: ResidentialRentalProject142) kind empirical {
    label en official "the project is financed by the issue";
}
relation project_is_residential_rental_property_142d1(project: ResidentialRentalProject142) kind empirical {
    label en official "the project is for residential rental property";
}
relation part_of_building_used_for_other_purposes_142d1(project: ResidentialRentalProject142) kind empirical {
    label en official "part of the building in which the property is located is used for purposes other than residential rental purposes";
}
pub relation residential_rental_property_142d1(project: ResidentialRentalProject142) kind institutional {
    label en official "the project is residential rental property, not failing merely because part of the building has another use";
}
@source(IRC_S142_D, relation = formalizes, coverage = exact, quote = "The term \"qualified residential rental project\" means any project for residential rental property if, at all times during the qualified project period, such project")
rule ResidentialRentalPropertyDefined(project: ResidentialRentalProject142) strict {
    label en official "section 142(d)(1), closing sentence (the other-use fact is deliberately not read)";
    when project_is_residential_rental_property_142d1(project);
    then residential_rental_property_142d1(project);
}
relation issuer_election_of_set_aside_142d1(project: ResidentialRentalProject142, election: SetAsideElection142d) kind empirical {
    label en official "the set-aside test elected by the issuer at the time of issuance";
}
relation share_of_units_occupied_by_income_at_most_50_percent_ami_142d1A(project: ResidentialRentalProject142, share: Decimal) kind empirical {
    label en official "the share of the residential units occupied by individuals whose income is 50 percent or less of area median gross income";
}
relation share_of_units_occupied_by_income_at_most_60_percent_ami_142d1B(project: ResidentialRentalProject142, share: Decimal) kind empirical {
    label en official "the share of the residential units occupied by individuals whose income is 60 percent or less of area median gross income";
}
relation project_in_city_with_5_boroughs_and_population_over_5_million_142d6(project: ResidentialRentalProject142) kind empirical {
    label en official "the project is located in a city having 5 boroughs and a population in excess of 5,000,000";
}
relation set_aside_test_holds_at_all_times_of_qualified_project_period_142d1(project: ResidentialRentalProject142) kind empirical {
    label en official "the elected test is met at all times during the qualified project period";
}
pub relation project_meets_elected_set_aside_142d1(project: ResidentialRentalProject142) kind institutional {
    label en official "the project meets the requirements of the subparagraph the issuer elected, at all times during the qualified project period";
}
@source(IRC_S142_D, relation = formalizes, coverage = exact, quote = "The project meets the requirements of this subparagraph if 20 percent or more of the residential units in such project are occupied by individuals whose income is 50")
rule SetAsideTwentyFiftyMet(project: ResidentialRentalProject142, share: Decimal) strict {
    label en official "section 142(d)(1)(A): 20 percent or more at 50 percent or less of area median gross income";
    when issuer_election_of_set_aside_142d1(project, TwentyFiftyTest);
    when share_of_units_occupied_by_income_at_most_50_percent_ami_142d1A(project, share);
    when share >= 0.20;
    when set_aside_test_holds_at_all_times_of_qualified_project_period_142d1(project);
    then project_meets_elected_set_aside_142d1(project);
}
@source(IRC_S142_D, relation = formalizes, coverage = exact, quote = "The project meets the requirements of this subparagraph if 40 percent or more of the residential units in such project are occupied by individuals whose income is 60")
rule SetAsideFortySixtyMet(project: ResidentialRentalProject142, share: Decimal) strict {
    label en official "section 142(d)(1)(B): 40 percent or more at 60 percent or less of area median gross income";
    when issuer_election_of_set_aside_142d1(project, FortySixtyTest);
    when share_of_units_occupied_by_income_at_most_60_percent_ami_142d1B(project, share);
    when share >= 0.40;
    when not_known(project_in_city_with_5_boroughs_and_population_over_5_million_142d6(project));
    when set_aside_test_holds_at_all_times_of_qualified_project_period_142d1(project);
    then project_meets_elected_set_aside_142d1(project);
}
@source(IRC_S142_D, relation = formalizes, coverage = exact, quote = "In the case of a project located in a city having 5 boroughs and a population in excess of 5,000,000, subparagraph (B) of paragraph (1) shall be applied by substituting")
rule SetAsideFortySixtyMetFiveBoroughCity(project: ResidentialRentalProject142, share: Decimal) strict {
    label en official "section 142(d)(6): 25 percent is substituted for 40 percent";
    when issuer_election_of_set_aside_142d1(project, FortySixtyTest);
    when share_of_units_occupied_by_income_at_most_60_percent_ami_142d1B(project, share);
    when share >= 0.25;
    when project_in_city_with_5_boroughs_and_population_over_5_million_142d6(project);
    when set_aside_test_holds_at_all_times_of_qualified_project_period_142d1(project);
    then project_meets_elected_set_aside_142d1(project);
}
pub relation qualified_residential_rental_project_142d1(project: ResidentialRentalProject142) kind institutional {
    label en official "a qualified residential rental project";
}
@source(IRC_S142_D, relation = formalizes, coverage = exact, quote = "The term \"qualified residential rental project\" means any project for residential rental property if, at all times during the qualified project period, such project")
rule QualifiedResidentialRentalProjectDefined(project: ResidentialRentalProject142) strict {
    label en official "section 142(d)(1)";
    when residential_rental_property_142d1(project);
    when project_meets_elected_set_aside_142d1(project);
    then qualified_residential_rental_project_142d1(project);
}
rule FacilityConditionsResidentialRental(issue: BondIssue, project: ResidentialRentalProject142) strict {
    label en official "section 142(a)(7) with (d)";
    when issue_net_proceeds_for_exempt_facility_use(issue, QualifiedResidentialRentalProject, _);
    when project_of_issue_142d(issue, project);
    when qualified_residential_rental_project_142d1(project);
    then facility_conditions_met_142(issue, QualifiedResidentialRentalProject);
}
relation first_day_10_percent_of_units_occupied_142d2A(project: ResidentialRentalProject142, on: Date) kind empirical {
    label en official "the first day on which 10 percent of the residential units in the project are occupied";
}
relation date_50_percent_of_units_occupied_142d2Ai(project: ResidentialRentalProject142, on: Date) kind empirical {
    label en official "the date on which 50 percent of the residential units in the project are occupied";
}
relation first_day_no_tax_exempt_pab_outstanding_for_project_142d2Aii(project: ResidentialRentalProject142, on: Date) kind empirical {
    label en official "the 1st day on which no tax-exempt private activity bond issued with respect to the project is outstanding";
}
relation date_section_8_assistance_terminates_142d2Aiii(project: ResidentialRentalProject142, on: Date) kind empirical {
    label en official "the date on which any assistance provided with respect to the project under section 8 of the United States Housing Act of 1937 terminates";
}
relation has_section_8_assistance_142d2Aiii(project: ResidentialRentalProject142) kind institutional {
    label en official "helper: section 8 assistance is recorded for the project";
}
rule HasSection8Assistance(project: ResidentialRentalProject142, on: Date) strict {
    label en official "helper for the not_known test";
    when date_section_8_assistance_terminates_142d2Aiii(project, on);
    then has_section_8_assistance_142d2Aiii(project);
}
pub relation qualified_project_period_142d2A(project: ResidentialRentalProject142, begins: Date, ends: Date) kind institutional {
    label en official "the qualified project period: from the first day 10 percent of the units are occupied to the latest of the three dates of clauses (i)-(iii)";
}
@source(IRC_S142_D, relation = formalizes, coverage = exact, quote = "(i) the date which is 15 years after the date on which 50 percent of the residential units in the project are occupied,")
rule ProjectPeriodEndsFifteenYearsAfterHalfOccupied(project: ResidentialRentalProject142, start: Date, d50: Date, d2: Date, d3: Date) strict {
    label en official "section 142(d)(2)(A)(i) is the latest of the three";
    when first_day_10_percent_of_units_occupied_142d2A(project, start);
    when date_50_percent_of_units_occupied_142d2Ai(project, d50);
    when first_day_no_tax_exempt_pab_outstanding_for_project_142d2Aii(project, d2);
    when date_section_8_assistance_terminates_142d2Aiii(project, d3);
    when add_calendar_period(d50, 15 calendar_year) >= d2;
    when add_calendar_period(d50, 15 calendar_year) >= d3;
    then qualified_project_period_142d2A(project, start, add_calendar_period(d50, 15 calendar_year));
}
@source(IRC_S142_D, relation = formalizes, coverage = exact, quote = "(ii) the 1st day on which no tax-exempt private activity bond issued with respect to the project is outstanding, or")
rule ProjectPeriodEndsWhenNoBondOutstanding(project: ResidentialRentalProject142, start: Date, d50: Date, d2: Date, d3: Date) strict {
    label en official "section 142(d)(2)(A)(ii) is the latest of the three";
    when first_day_10_percent_of_units_occupied_142d2A(project, start);
    when date_50_percent_of_units_occupied_142d2Ai(project, d50);
    when first_day_no_tax_exempt_pab_outstanding_for_project_142d2Aii(project, d2);
    when date_section_8_assistance_terminates_142d2Aiii(project, d3);
    when d2 > add_calendar_period(d50, 15 calendar_year);
    when d2 >= d3;
    then qualified_project_period_142d2A(project, start, d2);
}
@source(IRC_S142_D, relation = formalizes, coverage = exact, quote = "(iii) the date on which any assistance provided with respect to the project under section 8 of the United States Housing Act of 1937 terminates.")
rule ProjectPeriodEndsWhenSection8Terminates(project: ResidentialRentalProject142, start: Date, d50: Date, d2: Date, d3: Date) strict {
    label en official "section 142(d)(2)(A)(iii) is the latest of the three";
    when first_day_10_percent_of_units_occupied_142d2A(project, start);
    when date_50_percent_of_units_occupied_142d2Ai(project, d50);
    when first_day_no_tax_exempt_pab_outstanding_for_project_142d2Aii(project, d2);
    when date_section_8_assistance_terminates_142d2Aiii(project, d3);
    when d3 > add_calendar_period(d50, 15 calendar_year);
    when d3 > d2;
    then qualified_project_period_142d2A(project, start, d3);
}
@source(IRC_S142_D, relation = formalizes, coverage = exact, quote = "(i) the date which is 15 years after the date on which 50 percent of the residential units in the project are occupied,")
rule ProjectPeriodWithoutSection8FifteenYears(project: ResidentialRentalProject142, start: Date, d50: Date, d2: Date) strict {
    label en official "section 142(d)(2)(A)(i) when no section 8 assistance is recorded: the latest of the two remaining dates";
    when first_day_10_percent_of_units_occupied_142d2A(project, start);
    when date_50_percent_of_units_occupied_142d2Ai(project, d50);
    when first_day_no_tax_exempt_pab_outstanding_for_project_142d2Aii(project, d2);
    when not_known(has_section_8_assistance_142d2Aiii(project));
    when add_calendar_period(d50, 15 calendar_year) >= d2;
    then qualified_project_period_142d2A(project, start, add_calendar_period(d50, 15 calendar_year));
}
@source(IRC_S142_D, relation = formalizes, coverage = exact, quote = "(ii) the 1st day on which no tax-exempt private activity bond issued with respect to the project is outstanding, or")
rule ProjectPeriodWithoutSection8BondOutstanding(project: ResidentialRentalProject142, start: Date, d50: Date, d2: Date) strict {
    label en official "section 142(d)(2)(A)(ii) when no section 8 assistance is recorded";
    when first_day_10_percent_of_units_occupied_142d2A(project, start);
    when date_50_percent_of_units_occupied_142d2Ai(project, d50);
    when first_day_no_tax_exempt_pab_outstanding_for_project_142d2Aii(project, d2);
    when not_known(has_section_8_assistance_142d2Aiii(project));
    when d2 > add_calendar_period(d50, 15 calendar_year);
    then qualified_project_period_142d2A(project, start, d2);
}
relation area_median_gross_income_determined_by_secretary_142d2B(project: ResidentialRentalProject142, calendar_year: Integer, amount: Money) kind empirical {
    label en official "the area median gross income determined by the Secretary consistently with the section 8 determinations, with adjustments for family size (section 7872(g), (h) do not apply): an act of the Secretary (EXTERNAL_DEPENDENCY)";
}
pub relation area_median_gross_income_after_hold_harmless_142d2Ei(project: ResidentialRentalProject142, calendar_year: Integer, amount: Money) kind institutional {
    label en official "the determination for a calendar year after 2008 is not less than the determination for the preceding calendar year";
}
@source(IRC_S142_D, relation = formalizes, coverage = exact, quote = "Any determination of area median gross income under subparagraph (B) with respect to any project for any calendar year after 2008 shall not be less than the area median")
rule AreaMedianGrossIncomeNotLessThanPrecedingYear(project: ResidentialRentalProject142, cy: Integer, current: Money, prev_cy: Integer, prev: Money) strict {
    label en official "section 142(d)(2)(E)(i): the greater of the year's determination and the preceding year's";
    when area_median_gross_income_determined_by_secretary_142d2B(project, cy, current);
    when area_median_gross_income_determined_by_secretary_142d2B(project, prev_cy, prev);
    when cy > 2008;
    when prev_cy == cy - 1;
    then area_median_gross_income_after_hold_harmless_142d2Ei(project, cy, max(current, prev));
}
relation hud_hold_harmless_ami_for_2008_142d2Eii1(project: ResidentialRentalProject142, amount: Money) kind empirical {
    label en official "the area median gross income determined under the HUD hold harmless policy with respect to the project for calendar year 2008";
}
relation ami_without_hold_harmless_2008_142d2Eii2(project: ResidentialRentalProject142, amount: Money) kind empirical {
    label en official "the area median gross income determined under subparagraph (B), without the HUD hold harmless policy and this subparagraph, for calendar year 2008";
}
relation ami_determined_for_2007_or_2008_lower_but_for_hud_policy_142d2Eiv(project: ResidentialRentalProject142) kind empirical {
    label en official "area median gross income was determined under subparagraph (B) for calendar year 2007 or 2008 and the determination would have been less but for the HUD hold harmless policy";
}
pub relation hud_hold_harmless_impacted_project_142d2Eiv(project: ResidentialRentalProject142) kind institutional {
    label en official "a HUD hold harmless impacted project";
}
@source(IRC_S142_D, relation = formalizes, coverage = exact, quote = "The term \"HUD hold harmless impacted project\" means any project with respect to which area median gross income was determined under subparagraph (B) for calendar year")
rule HudHoldHarmlessImpactedProject(project: ResidentialRentalProject142) strict {
    label en official "section 142(d)(2)(E)(iv)";
    when ami_determined_for_2007_or_2008_lower_but_for_hud_policy_142d2Eiv(project);
    then hud_hold_harmless_impacted_project_142d2Eiv(project);
}
pub relation area_median_gross_income_for_impacted_project_142d2Eii(project: ResidentialRentalProject142, calendar_year: Integer, amount: Money) kind institutional {
    label en official "for a HUD hold harmless impacted project and a calendar year after 2008: the greater of the amount determined without this clause and the sum of the 2008 hold-harmless amount and the increase since 2008 (determined without the policy)";
}
@source(IRC_S142_D, relation = formalizes, coverage = exact, quote = "In the case of a HUD hold harmless impacted project, the area median gross income with respect to such project for any calendar year after 2008 (hereafter in this clause")
rule AreaMedianGrossIncomeForImpactedProject(project: ResidentialRentalProject142, cy: Integer, normal: Money, hud2008: Money, plain2008: Money, plain_now: Money) strict {
    label en official "section 142(d)(2)(E)(ii)(I)-(II); the increase is the current determination (without the policy) over the 2008 determination (without the policy)";
    when hud_hold_harmless_impacted_project_142d2Eiv(project);
    when area_median_gross_income_after_hold_harmless_142d2Ei(project, cy, normal);
    when hud_hold_harmless_ami_for_2008_142d2Eii1(project, hud2008);
    when ami_without_hold_harmless_2008_142d2Eii2(project, plain2008);
    when area_median_gross_income_determined_by_secretary_142d2B(project, cy, plain_now);
    when cy > 2008;
    then area_median_gross_income_for_impacted_project_142d2Eii(project, cy, max(normal, round(hud2008 + max(0.00 USD, plain_now - plain2008), 2, "HALF_UP")));
}
relation county_military_installation_members_142d2Biv(county: us.irc.core::Organ, members_june_2008: Integer, members_dec_2005: Integer) kind empirical {
    label en official "the number of members of the Armed Forces assigned to units based out of the qualified military installation in the county, as of June 1, 2008 and as of December 31, 2005";
}
relation county_adjacent_142d2Biii(county: us.irc.core::Organ, adjacent_to: us.irc.core::Organ) kind empirical {
    label en official "the county is adjacent to the other county";
}
relation building_located_in_county_142d2Biii(building: us.irc.core::Asset, county: us.irc.core::Organ) kind empirical {
    label en official "the building is located in the county";
}
pub relation county_with_growing_installation_142d2Biii(county: us.irc.core::Organ) kind institutional {
    label en official "a county in which is located a qualified military installation (not less than 1,000 members as of June 1, 2008) whose assigned members increased by not less than 20 percent compared with December 31, 2005";
}
@source(IRC_S142_D, relation = formalizes, coverage = exact, quote = "(I) in any county in which is located a qualified military installation to which the number of members of the Armed Forces of the United States assigned to units based")
rule CountyWithGrowingInstallation(county: us.irc.core::Organ, m08: Integer, m05: Integer) strict {
    label en official "section 142(d)(2)(B)(iii)(I) with (iv): members in 2008 at least 1,000 and at least 120 percent of the 2005 number (exact cross multiplication)";
    when county_military_installation_members_142d2Biv(county, m08, m05);
    when m08 >= 1000;
    when m08 * 100 >= m05 * 120;
    then county_with_growing_installation_142d2Biii(county);
}
pub relation qualified_building_142d2Biii(building: us.irc.core::Asset) kind institutional {
    label en official "a qualified building: located in a county with a growing installation or in a county adjacent to one";
}
@source(IRC_S142_D, relation = formalizes, coverage = exact, quote = "(I) in any county in which is located a qualified military installation to which the number of members of the Armed Forces of the United States assigned to units based")
rule QualifiedBuildingInGrowingCounty(building: us.irc.core::Asset, county: us.irc.core::Organ) strict {
    label en official "section 142(d)(2)(B)(iii)(I)";
    when building_located_in_county_142d2Biii(building, county);
    when county_with_growing_installation_142d2Biii(county);
    then qualified_building_142d2Biii(building);
}
@source(IRC_S142_D, relation = formalizes, coverage = exact, quote = "(II) in any county adjacent to a county described in subclause (I).")
rule QualifiedBuildingInAdjacentCounty(building: us.irc.core::Asset, county: us.irc.core::Organ, other: us.irc.core::Organ) strict {
    label en official "section 142(d)(2)(B)(iii)(II)";
    when building_located_in_county_142d2Biii(building, county);
    when county_adjacent_142d2Biii(county, other);
    when county_with_growing_installation_142d2Biii(other);
    then qualified_building_142d2Biii(building);
}
relation basic_housing_allowance_payment_403_title_37_142d2Bii(building: us.irc.core::Asset, amount: Money) kind empirical {
    label en official "a basic pay allowance for housing under section 403 of title 37, United States Code, paid to a resident of the building";
}
pub relation basic_housing_allowance_disregarded_for_income_142d2Bii(building: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the allowance is disregarded in determining income under subparagraph (B) for a qualified building";
}
@source(IRC_S142_D, relation = formalizes, coverage = exact, quote = "The income of individuals and area median gross income shall be determined by the Secretary in a manner consistent with determinations of lower income families and area")
rule BasicHousingAllowanceDisregarded(building: us.irc.core::Asset, amount: Money) strict {
    label en official "section 142(d)(2)(B)(ii)";
    when basic_housing_allowance_payment_403_title_37_142d2Bii(building, amount);
    when qualified_building_142d2Biii(building);
    then basic_housing_allowance_disregarded_for_income_142d2Bii(building, amount);
}
relation unit_is_single_room_occupancy_unit_42_142d2D(unit: us.irc.core::Asset) kind empirical {
    label en official "the unit is a single-room occupancy unit within the meaning of section 42";
}
pub relation unit_treated_as_residential_unit_142d2D(unit: us.irc.core::Asset) kind institutional {
    label en official "a unit does not fail to be a residential unit merely because it is a single-room occupancy unit";
}
@source(IRC_S142_D, relation = formalizes, coverage = exact, quote = "A unit shall not fail to be treated as a residential unit merely because such unit is a single-room occupancy unit (within the meaning of section 42).")
rule SingleRoomOccupancyUnitIsResidentialUnit(unit: us.irc.core::Asset) strict {
    label en official "section 142(d)(2)(D)";
    when unit_is_single_room_occupancy_unit_42_142d2D(unit);
    then unit_treated_as_residential_unit_142d2D(unit);
}
// (d)(3)-(5): continuing residents, deep rent skewing, income limit
relation deep_rent_skewing_elected_by_owner_142d4B(project: ResidentialRentalProject142) kind empirical {
    label en official "the owner of the project elects to have paragraph (4) apply";
}
relation share_low_income_units_occupied_at_most_40_percent_ami_142d4Bi(project: ResidentialRentalProject142, share: Decimal) kind empirical {
    label en official "the share of the low-income units occupied by individuals whose income is 40 percent or less of area median gross income";
}
relation low_income_unit_rents_142d4B(project: ResidentialRentalProject142, unit: us.irc.core::Asset, gross_rent: Money, applicable_income_limit_monthly: Money, average_market_rent_comparable_units: Money) kind empirical {
    label en official "a low-income unit (required to be occupied by individuals who meet the applicable income limit), its gross rent (including any section 8 payment and the utility allowance), the applicable income limit that applies to its occupants (as a monthly amount) and the average gross rent of comparable units not occupied by individuals meeting the limit";
}
relation deep_skew_holds_at_all_times_142d4B(project: ResidentialRentalProject142) kind empirical {
    label en official "the requirements of clauses (i), (ii) and (iii) are met at all times during the qualified project period";
}
relation unit_rent_exceeds_30_percent_of_limit_142d4Bii(project: ResidentialRentalProject142) kind institutional {
    label en official "helper: some low-income unit has gross rent above 30 percent of the applicable income limit";
}
@source(IRC_S142_D, relation = formalizes, coverage = exact, quote = "(ii) The project meets the requirements of this clause if the gross rent with respect to each low-income unit in the project does not exceed 30 percent of the applicable")
rule UnitRentExceedsThirtyPercentOfLimit(project: ResidentialRentalProject142, unit: us.irc.core::Asset, rent: Money, limit: Money, avg: Money) strict {
    label en official "section 142(d)(4)(B)(ii) violated: rent x 100 > limit x 30";
    when low_income_unit_rents_142d4B(project, unit, rent, limit, avg);
    when rent * 100 > limit * 30;
    then unit_rent_exceeds_30_percent_of_limit_142d4Bii(project);
}
relation unit_rent_exceeds_half_of_market_average_142d4Biii(project: ResidentialRentalProject142) kind institutional {
    label en official "helper: some low-income unit has gross rent above one half of the average gross rent of comparable market units";
}
@source(IRC_S142_D, relation = formalizes, coverage = exact, quote = "(iii) The project meets the requirements of this clause if the gross rent with respect to each low-income unit in the project does not exceed ½ of the average gross rent")
rule UnitRentExceedsHalfOfMarketAverage(project: ResidentialRentalProject142, unit: us.irc.core::Asset, rent: Money, limit: Money, avg: Money) strict {
    label en official "section 142(d)(4)(B)(iii) violated: rent x 2 > average";
    when low_income_unit_rents_142d4B(project, unit, rent, limit, avg);
    when rent * 2 > avg;
    then unit_rent_exceeds_half_of_market_average_142d4Biii(project);
}
pub relation deep_rent_skewed_project_142d4B(project: ResidentialRentalProject142) kind institutional {
    label en official "a project described in section 142(d)(4)(B): elected, at least 15 percent of the low-income units at 40 percent of area median income or less, and no low-income unit rent above 30 percent of its limit or above half the market average, at all times of the qualified project period";
}
@source(IRC_S142_D, relation = formalizes, coverage = exact, quote = "A project is described in this subparagraph if the owner of the project elects to have this paragraph apply and, at all times during the qualified project period, such")
rule DeepRentSkewedProject(project: ResidentialRentalProject142, share: Decimal, u0: us.irc.core::Asset, r0: Money, l0: Money, a0: Money) strict {
    label en official "section 142(d)(4)(B)(i)-(iii)";
    when deep_rent_skewing_elected_by_owner_142d4B(project);
    when share_low_income_units_occupied_at_most_40_percent_ami_142d4Bi(project, share);
    when share >= 0.15;
    when low_income_unit_rents_142d4B(project, u0, r0, l0, a0);
    when not_known(unit_rent_exceeds_30_percent_of_limit_142d4Bii(project));
    when not_known(unit_rent_exceeds_half_of_market_average_142d4Biii(project));
    when deep_skew_holds_at_all_times_142d4B(project);
    then deep_rent_skewed_project_142d4B(project);
}
relation resident_in_project_142d3(resident: Individual, project: ResidentialRentalProject142) kind empirical {
    label en official "the resident occupies a unit in the project";
}
relation resident_income_within_limit_at_commencement_or_prior_determination_142d3B(resident: Individual) kind empirical {
    label en official "the income of the resident did not exceed the applicable income limit upon commencement of occupancy (or as of any prior determination)";
}
relation resident_income_over_limit_percent_at_latest_determination_142d3B(resident: Individual, ratio_to_limit: Decimal) kind empirical {
    label en official "the income of the resident at the most recent determination as a fraction of the applicable income limit";
}
relation new_over_limit_resident_in_comparable_or_smaller_unit_142d3B(resident: Individual) kind empirical {
    label en official "after the determination and before the next, a residential unit of comparable or smaller size in the same project (or, for a section 42 credit project, the same building) is occupied by a new resident whose income exceeds the applicable income limit";
}
relation new_over_40_percent_ami_resident_in_low_income_unit_142d4A(resident: Individual) kind empirical {
    label en official "after the determination and before the next, a low-income unit in the same project is occupied by a new resident whose income exceeds 40 percent of area median gross income";
}
pub relation resident_income_treated_as_within_limit_142d3B(resident: Individual) kind institutional {
    label en official "the income of a continuing resident is treated as not exceeding the applicable income limit";
}
@source(IRC_S142_D, relation = formalizes, coverage = exact, quote = "If the income of a resident of a unit in a project did not exceed the applicable income limit upon commencement of such resident's occupancy of such unit (or as of any")
rule ContinuingResidentNotOver140Percent(resident: Individual, ratio: Decimal) strict {
    label en official "section 142(d)(3)(B): first sentence, the resident's latest income is not above 140 percent of the limit";
    when resident_income_within_limit_at_commencement_or_prior_determination_142d3B(resident);
    when resident_income_over_limit_percent_at_latest_determination_142d3B(resident, ratio);
    when ratio <= 1.40;
    then resident_income_treated_as_within_limit_142d3B(resident);
}
@source(IRC_S142_D, relation = formalizes, coverage = exact, quote = "If the income of a resident of a unit in a project did not exceed the applicable income limit upon commencement of such resident's occupancy of such unit (or as of any")
rule ContinuingResidentOver140ButNoTrigger(resident: Individual, ratio: Decimal, project: ResidentialRentalProject142) strict {
    label en official "section 142(d)(3)(B), second sentence: above 140 percent but no new over-limit resident in a comparable or smaller unit (170 percent and the 40 percent trigger for a deep rent skewed project, (d)(4)(A))";
    when resident_income_within_limit_at_commencement_or_prior_determination_142d3B(resident);
    when resident_income_over_limit_percent_at_latest_determination_142d3B(resident, ratio);
    when resident_in_project_142d3(resident, project);
    when not_known(deep_rent_skewed_project_142d4B(project));
    when ratio > 1.40;
    when not_known(new_over_limit_resident_in_comparable_or_smaller_unit_142d3B(resident));
    then resident_income_treated_as_within_limit_142d3B(resident);
}
@source(IRC_S142_D, relation = formalizes, coverage = exact, quote = "In the case of any project described in subparagraph (B), the 2d sentence of subparagraph (B) of paragraph (3) shall be applied by substituting—")
rule ContinuingResidentDeepSkewNotOver170Percent(resident: Individual, ratio: Decimal, project: ResidentialRentalProject142) strict {
    label en official "section 142(d)(4)(A)(i): 170 percent replaces 140 percent in a deep rent skewed project";
    when resident_income_within_limit_at_commencement_or_prior_determination_142d3B(resident);
    when resident_income_over_limit_percent_at_latest_determination_142d3B(resident, ratio);
    when resident_in_project_142d3(resident, project);
    when deep_rent_skewed_project_142d4B(project);
    when ratio <= 1.70;
    then resident_income_treated_as_within_limit_142d3B(resident);
}
@source(IRC_S142_D, relation = formalizes, coverage = exact, quote = "(ii) \"any low-income unit in the same project is occupied by a new resident whose income exceeds 40 percent of area median gross income\" for \"any residential unit of")
rule ContinuingResidentDeepSkewOver170ButNoTrigger(resident: Individual, ratio: Decimal, project: ResidentialRentalProject142) strict {
    label en official "section 142(d)(4)(A)(ii): the trigger is a new resident over 40 percent of area median gross income in a low-income unit";
    when resident_income_within_limit_at_commencement_or_prior_determination_142d3B(resident);
    when resident_income_over_limit_percent_at_latest_determination_142d3B(resident, ratio);
    when resident_in_project_142d3(resident, project);
    when deep_rent_skewed_project_142d4B(project);
    when ratio > 1.70;
    when not_known(new_over_40_percent_ami_resident_in_low_income_unit_142d4A(resident));
    then resident_income_treated_as_within_limit_142d3B(resident);
}
relation income_redetermined_within_year_142d3A(project: ResidentialRentalProject142, y: TaxableYear) kind empirical {
    label en official "the income of each resident was determined during the year on the basis of the resident's current income";
}
relation new_resident_over_limit_moved_in_during_year_142d3A(project: ResidentialRentalProject142, y: TaxableYear) kind empirical {
    label en official "during the year a residential unit is occupied by a new resident whose income exceeds the applicable income limit";
}
pub relation current_income_determination_requirement_met_142d3A(project: ResidentialRentalProject142, y: TaxableYear) kind institutional {
    label en official "the determination of whether resident income exceeds the applicable income limit is made at least annually on current income, unless no unit is occupied by a new over-limit resident during the year";
}
@source(IRC_S142_D, relation = formalizes, coverage = exact, quote = "The determination of whether the income of a resident of a unit in a project exceeds the applicable income limit shall be made at least annually on the basis of the")
rule AnnualIncomeDeterminationMade(project: ResidentialRentalProject142, y: TaxableYear) strict {
    label en official "section 142(d)(3)(A), first sentence";
    when income_redetermined_within_year_142d3A(project, y);
    then current_income_determination_requirement_met_142d3A(project, y);
}
@source(IRC_S142_D, relation = formalizes, coverage = exact, quote = "The determination of whether the income of a resident of a unit in a project exceeds the applicable income limit shall be made at least annually on the basis of the")
rule AnnualIncomeDeterminationNotRequired(project: ResidentialRentalProject142, y: TaxableYear) strict {
    label en official "section 142(d)(3)(A), second sentence: no new over-limit resident that year, so no determination is required";
    when project_needs_year_record_142d3A(project, y);
    when not_known(new_resident_over_limit_moved_in_during_year_142d3A(project, y));
    then current_income_determination_requirement_met_142d3A(project, y);
}
relation project_needs_year_record_142d3A(project: ResidentialRentalProject142, y: TaxableYear) kind empirical {
    label en official "the project and the taxable year under test";
}
pub relation applicable_income_limit_percent_142d5(project: ResidentialRentalProject142, percent: Integer) kind institutional {
    label en official "the applicable income limit as a percent of area median gross income: the limit of the elected (d)(1) test (50 or 60 percent)";
}
@source(IRC_S142_D, relation = formalizes, coverage = exact, quote = "(A) the limitation under subparagraph (A) or (B) of paragraph (1) which applies to the project, or")
rule ApplicableIncomeLimitFifty(project: ResidentialRentalProject142) strict {
    label en official "section 142(d)(5)(A), 20-50 test";
    when issuer_election_of_set_aside_142d1(project, TwentyFiftyTest);
    then applicable_income_limit_percent_142d5(project, 50);
}
@source(IRC_S142_D, relation = formalizes, coverage = exact, quote = "(A) the limitation under subparagraph (A) or (B) of paragraph (1) which applies to the project, or")
rule ApplicableIncomeLimitSixty(project: ResidentialRentalProject142) strict {
    label en official "section 142(d)(5)(A), 40-60 test";
    when issuer_election_of_set_aside_142d1(project, FortySixtyTest);
    then applicable_income_limit_percent_142d5(project, 60);
}
pub relation applicable_income_limit_for_deep_skew_unit_142d5B(project: ResidentialRentalProject142, percent: Integer) kind institutional {
    label en official "for a unit to which paragraph (4)(B)(i) applies the limitation that applies to that unit: 40 percent of area median gross income";
}
@source(IRC_S142_D, relation = formalizes, coverage = exact, quote = "(B) in the case of a unit to which paragraph (4)(B)(i) applies, the limitation which applies to such unit.")
rule ApplicableIncomeLimitFortyForDeepSkewUnit(project: ResidentialRentalProject142) strict {
    label en official "section 142(d)(5)(B)";
    when deep_rent_skewed_project_142d4B(project);
    then applicable_income_limit_for_deep_skew_unit_142d5B(project, 40);
}
pub relation gross_rent_includes_142d4C(payment_kind: Text) kind institutional {
    label en official "gross rent includes a payment under section 8 of the United States Housing Act of 1937 and a utility allowance determined by the Secretary after taking into account the section 8 determinations";
}
relation project_operator_142d7(project: ResidentialRentalProject142, operator: Person) kind empirical {
    label en official "the operator of the project";
}
relation set_aside_election_made_for_project_142d7(project: ResidentialRentalProject142) kind empirical {
    label en official "an election was made under section 142(d) for the project";
}
relation annual_certification_submitted_142d7(project: ResidentialRentalProject142, y: TaxableYear) kind empirical {
    label en official "the operator has submitted the annual certification to the Secretary for the year, in the manner and at the time the Secretary prescribes";
}
@source(IRC_S142_D, relation = formalizes, coverage = exact, quote = "The operator of any project with respect to which an election was made under this subsection shall submit to the Secretary (at such time and in such manner as the")
rule Section142d7CertificationDutyRule strict {
    for project: ResidentialRentalProject142;
    for operator: Person;
    for y: TaxableYear;
    when project_operator_142d7(project, operator)
        and set_aside_election_made_for_project_142d7(project)
        and project_needs_year_record_142d3A(project, y);
    then duty Section142d7CertificationDuty {
        bearer operator;
        beneficiary Secretary;
        goal achievement {
            condition annual_certification_submitted_142d7(project, y);
            window [-infinity, infinity];
        }
    };
}
pub relation operator_subject_to_penalty_6652j_142d7(operator: Person, project: ResidentialRentalProject142, y: TaxableYear) kind institutional {
    label en official "failure to submit the certification does not affect the tax-exempt status of any bond but subjects the operator to the penalty of section 6652(j) (the penalty amount belongs to the penalties owner)";
}
@source(IRC_S142_D, relation = formalizes, coverage = exact, quote = "The operator of any project with respect to which an election was made under this subsection shall submit to the Secretary (at such time and in such manner as the")
rule OperatorSubjectToPenaltyForMissingCertification(operator: Person, project: ResidentialRentalProject142, y: TaxableYear) strict {
    label en official "section 142(d)(7), second sentence";
    when project_operator_142d7(project, operator);
    when set_aside_election_made_for_project_142d7(project);
    when project_needs_year_record_142d3A(project, y);
    when not_known(annual_certification_submitted_142d7(project, y));
    then operator_subject_to_penalty_6652j_142d7(operator, project, y);
}

// =====================================================================
// §142(f): local furnishing of electric energy or gas
// =====================================================================

pub enum LocalFurnishingArea142f { CityAndOneContiguousCounty; TwoContiguousCounties; OtherArea; }
relation furnishing_area_142f1(issue: BondIssue, area: LocalFurnishingArea142f) kind empirical {
    label en official "the area within which the electric energy or gas is furnished solely";
}
pub relation local_furnishing_area_requirement_met_142f1(issue: BondIssue) kind institutional {
    label en official "local furnishing includes only furnishing solely within a city and 1 contiguous county, or 2 contiguous counties";
}
@source(IRC_S142_F, relation = formalizes, coverage = exact, quote = "(A) a city and 1 contiguous county, or")
rule LocalFurnishingAreaCityAndCounty(issue: BondIssue) strict {
    label en official "section 142(f)(1)(A)";
    when furnishing_area_142f1(issue, CityAndOneContiguousCounty);
    then local_furnishing_area_requirement_met_142f1(issue);
}
@source(IRC_S142_F, relation = formalizes, coverage = exact, quote = "(B) 2 contiguous counties.")
rule LocalFurnishingAreaTwoCounties(issue: BondIssue) strict {
    label en official "section 142(f)(1)(B)";
    when furnishing_area_142f1(issue, TwoContiguousCounties);
    then local_furnishing_area_requirement_met_142f1(issue);
}
relation electricity_transmitted_under_ferc_order_211_or_213_142f2A(issue: BondIssue) kind empirical {
    label en official "electricity is transmitted pursuant to an order of the Federal Energy Regulatory Commission under section 211 or 213 of the Federal Power Act";
}
relation cost_share_financed_with_tax_exempt_bonds_142f2A(issue: BondIssue, share: Decimal) kind empirical {
    label en official "the portion of the cost of the facility financed with tax-exempt bonds";
}
relation cost_share_allocable_to_local_furnishing_142f2A(issue: BondIssue, share: Decimal) kind empirical {
    label en official "the portion of the cost of the facility allocable to the local furnishing of electric energy (determined without regard to paragraph (2))";
}
pub relation ferc_transmission_does_not_defeat_local_furnishing_142f2A(issue: BondIssue) kind institutional {
    label en official "the facility is not treated as failing the local furnishing requirement by reason of electricity transmitted under a section 211 or 213 order";
}
@source(IRC_S142_F, relation = formalizes, coverage = exact, quote = "A facility shall not be treated as failing to meet the local furnishing requirement of subsection (a)(8) by reason of electricity transmitted pursuant to an order of the")
rule FercTransmissionDoesNotDefeatLocalFurnishing(issue: BondIssue, financed: Decimal, local: Decimal) strict {
    label en official "section 142(f)(2)(A): the financed share is not greater than the local share";
    when electricity_transmitted_under_ferc_order_211_or_213_142f2A(issue);
    when cost_share_financed_with_tax_exempt_bonds_142f2A(issue, financed);
    when cost_share_allocable_to_local_furnishing_142f2A(issue, local);
    when financed <= local;
    then ferc_transmission_does_not_defeat_local_furnishing_142f2A(issue);
}
relation bonds_issued_before_ferc_order_142f2B(issue: BondIssue) kind empirical {
    label en official "the facility was financed with bonds issued before the date of the order";
}
relation escrow_established_within_reasonable_period_after_order_final_142f2Bi(issue: BondIssue) kind empirical {
    label en official "an escrow to pay principal, premium and interest is established within a reasonable period after the order becomes final";
}
relation bonds_redeemed_by_earliest_redemption_date_142f2Bii(issue: BondIssue) kind empirical {
    label en official "bonds are redeemed not later than the earliest date on which they may be redeemed";
}
pub relation existing_bonds_remain_tax_exempt_142f2B(issue: BondIssue) kind institutional {
    label en official "bonds issued before the order remain tax-exempt bonds, and section 150(b)(4) does not apply, to the extent necessary to comply with subparagraph (A)";
}
@source(IRC_S142_F, relation = formalizes, coverage = exact, quote = "In the case of a facility financed with bonds issued before the date of an order referred to in subparagraph (A) which would (but for this subparagraph) cease to be")
rule ExistingBondsRemainTaxExempt(issue: BondIssue) strict {
    label en official "section 142(f)(2)(B)(i)-(ii)";
    when bonds_issued_before_ferc_order_142f2B(issue);
    when escrow_established_within_reasonable_period_after_order_final_142f2Bi(issue);
    when bonds_redeemed_by_earliest_redemption_date_142f2Bii(issue);
    then existing_bonds_remain_tax_exempt_142f2B(issue);
}
relation user_engaged_in_local_furnishing_on_19970101_142f3Ai(issue: BondIssue) kind empirical {
    label en official "the facility will be used by a person engaged in the local furnishing of that energy source on January 1, 1997";
}
relation service_within_area_served_on_19970101_142f3Aii(issue: BondIssue) kind empirical {
    label en official "the facility will be used to provide service within the area served by that person on January 1, 1997 (or within a county or city any portion of which is within such area)";
}
relation user_is_successor_in_interest_for_same_use_and_area_142f3B(issue: BondIssue) kind empirical {
    label en official "the facility will be used by a successor in interest to that person for the same use and within the same service area";
}
pub relation future_financing_permitted_142f3(issue: BondIssue) kind institutional {
    label en official "a bond may be issued as part of an issue described in subsection (a)(8) on or after the date of enactment of paragraph (3) only if the facility meets (A) or (B)";
}
@source(IRC_S142_F, relation = formalizes, coverage = exact, quote = "(A) the facility will—")
rule FutureFinancingPermittedForExistingFurnisher(issue: BondIssue) strict {
    label en official "section 142(f)(3)(A)(i)-(ii)";
    when user_engaged_in_local_furnishing_on_19970101_142f3Ai(issue);
    when service_within_area_served_on_19970101_142f3Aii(issue);
    then future_financing_permitted_142f3(issue);
}
@source(IRC_S142_F, relation = formalizes, coverage = exact, quote = "(B) the facility will be used by a successor in interest to such person for the same use and within the same service area as described in subparagraph (A).")
rule FutureFinancingPermittedForSuccessor(issue: BondIssue) strict {
    label en official "section 142(f)(3)(B)";
    when user_is_successor_in_interest_for_same_use_and_area_142f3B(issue);
    then future_financing_permitted_142f3(issue);
}
relation election_by_furnisher_142f4(issue: BondIssue) kind empirical {
    label en official "the person engaged in the local furnishing makes an election described in subparagraph (B), in the manner the Secretary prescribes, agreeing that: (i) the election covers all its local furnishing facilities, (ii) no further (a)(8) bond is issued for them, (iii) any service area expansion is not financed with (a)(8) exempt facility bond proceeds and is not treated as a nonqualifying use, and (iv) all outstanding bonds are redeemed not later than 6 months after the later of the earliest redemption date and the date of the election";
}
relation service_area_expansion_defeats_local_furnishing_142f4A(issue: BondIssue) kind empirical {
    label en official "the facility was financed with bonds issued before the enactment of paragraph (4), and the local furnishing requirement fails as a result of a service area expansion";
}
relation election_agrees_all_facilities_142f4Bi(issue: BondIssue) kind empirical {
    label en official "the election is made with respect to all facilities for the local furnishing of electric energy or gas by the person";
}
relation election_agrees_no_new_a8_bonds_142f4Bii(issue: BondIssue) kind empirical {
    label en official "no bond exempt under section 103 and described in subsection (a)(8) may be issued on or after the enactment date with respect to all such facilities";
}
relation election_agrees_expansion_not_financed_by_a8_bonds_142f4Biii(issue: BondIssue) kind empirical {
    label en official "any expansion of the service area is not financed with the proceeds of an exempt facility bond described in (a)(8) and is not a nonqualifying use under paragraph (2)";
}
relation bonds_redeemed_within_6_months_of_later_date_142f4Biv(issue: BondIssue) kind empirical {
    label en official "all outstanding bonds used to finance the facilities are redeemed not later than 6 months after the later of the earliest date on which they may be redeemed and the date of the election";
}
pub relation election_of_142f4B_described(issue: BondIssue) kind institutional {
    label en official "an election described in section 142(f)(4)(B)";
}
@source(IRC_S142_F, relation = formalizes, coverage = exact, quote = "An election is described in this subparagraph if it is an election made in such manner as the Secretary prescribes, and such person (or its predecessor in interest)")
rule ElectionOf142f4BDescribed(issue: BondIssue) strict {
    label en official "section 142(f)(4)(B)(i)-(iv)";
    when election_by_furnisher_142f4(issue);
    when election_agrees_all_facilities_142f4Bi(issue);
    when election_agrees_no_new_a8_bonds_142f4Bii(issue);
    when election_agrees_expansion_not_financed_by_a8_bonds_142f4Biii(issue);
    when bonds_redeemed_within_6_months_of_later_date_142f4Biv(issue);
    then election_of_142f4B_described(issue);
}
pub relation expanded_area_bonds_remain_tax_exempt_142f4A(issue: BondIssue) kind institutional {
    label en official "bonds issued before the enactment of paragraph (4) do not cease to be tax-exempt (and section 150(b)(4) does not apply) though the local furnishing requirement fails by a service area expansion, if the furnisher makes the described election";
}
@source(IRC_S142_F, relation = formalizes, coverage = exact, quote = "In the case of a facility financed with bonds issued before the date of the enactment of this paragraph which would cease to be tax-exempt by reason of the failure to")
rule ExpandedAreaBondsRemainTaxExempt(issue: BondIssue) strict {
    label en official "section 142(f)(4)(A)";
    when service_area_expansion_defeats_local_furnishing_142f4A(issue);
    when election_of_142f4B_described(issue);
    then expanded_area_bonds_remain_tax_exempt_142f4A(issue);
}
rule FacilityConditionsLocalFurnishing(issue: BondIssue) strict {
    label en official "section 142(a)(8) with (f)(1), (2)(A)";
    when issue_net_proceeds_for_exempt_facility_use(issue, LocalElectricOrGasFurnishing, _);
    when local_furnishing_area_requirement_met_142f1(issue);
    then facility_conditions_met_142(issue, LocalElectricOrGasFurnishing);
}
rule FacilityConditionsLocalFurnishingFercException(issue: BondIssue) strict {
    label en official "section 142(a)(8) with (f)(2)(A)";
    when issue_net_proceeds_for_exempt_facility_use(issue, LocalElectricOrGasFurnishing, _);
    when ferc_transmission_does_not_defeat_local_furnishing_142f2A(issue);
    then facility_conditions_met_142(issue, LocalElectricOrGasFurnishing);
}
rule FacilityConditionsLocalFurnishingExpansion(issue: BondIssue) strict {
    label en official "section 142(a)(8) with (f)(4)(A)";
    when issue_net_proceeds_for_exempt_facility_use(issue, LocalElectricOrGasFurnishing, _);
    when expanded_area_bonds_remain_tax_exempt_142f4A(issue);
    then facility_conditions_met_142(issue, LocalElectricOrGasFurnishing);
}

// =====================================================================
// §142(g): local district heating or cooling
// =====================================================================

relation district_system_users_and_purpose_142g2A(issue: BondIssue, users: Integer, purposes_residential_commercial_industrial_or_process_steam: Boolean) kind empirical {
    label en official "the local system is a pipeline or network providing hot water, chilled water or steam to the given number of users for residential, commercial or industrial heating or cooling, or process steam";
}
relation district_system_serves_city_and_one_contiguous_county_142g2B(issue: BondIssue) kind empirical {
    label en official "the local system furnishes heating and cooling to an area consisting of a city and 1 contiguous county";
}
relation property_integral_part_of_local_district_system_142g1(issue: BondIssue) kind empirical {
    label en official "the property is used as an integral part of a local district heating or cooling system";
}
pub relation local_district_heating_or_cooling_facility_142g(issue: BondIssue) kind institutional {
    label en official "a local district heating or cooling facility: property that is an integral part of a system serving 2 or more users for the named purposes";
}
@source(IRC_S142_G, relation = formalizes, coverage = exact, quote = "(i) residential, commercial, or industrial heating or cooling, or")
rule LocalDistrictHeatingOrCoolingFacility(issue: BondIssue, users: Integer) strict {
    label en official "section 142(g)(1), (2)(A)(i)-(ii), (B)";
    when property_integral_part_of_local_district_system_142g1(issue);
    when district_system_users_and_purpose_142g2A(issue, users, true);
    when users >= 2;
    when district_system_serves_city_and_one_contiguous_county_142g2B(issue);
    then local_district_heating_or_cooling_facility_142g(issue);
}
rule FacilityConditionsDistrictHeating(issue: BondIssue) strict {
    label en official "section 142(a)(9) with (g)";
    when issue_net_proceeds_for_exempt_facility_use(issue, DistrictHeatingOrCooling, _);
    when local_district_heating_or_cooling_facility_142g(issue);
    then facility_conditions_met_142(issue, DistrictHeatingOrCooling);
}

// =====================================================================
// §142(h): qualified hazardous waste facilities
// =====================================================================

relation hazardous_waste_disposal_by_incineration_or_entombment_142h(issue: BondIssue) kind empirical {
    label en official "the facility is for the disposal of hazardous waste by incineration or entombment";
}
relation facility_subject_to_final_permit_requirements_subtitle_c_142h1(issue: BondIssue) kind empirical {
    label en official "the facility is subject to final permit requirements under subtitle C of title II of the Solid Waste Disposal Act (as in effect on the enactment date of the Tax Reform Act of 1986)";
}
relation portion_provided_by_issue_and_portion_used_by_others_142h2(issue: BondIssue, provided: Decimal, used_by_persons_other_than_owner_or_related: Decimal) kind empirical {
    label en official "the portion of the facility to be provided by the issue, and the portion to be used by persons other than the owner or operator and any related person (section 144(a)(3))";
}
pub relation qualified_hazardous_waste_facility_142h(issue: BondIssue) kind institutional {
    label en official "a qualified hazardous waste facility";
}
@source(IRC_S142_H, relation = formalizes, coverage = exact, quote = "(1) the facility is subject to final permit requirements under subtitle C of title II of the Solid Waste Disposal Act (as in effect on the date of the enactment of the")
rule QualifiedHazardousWasteFacility(issue: BondIssue, provided: Decimal, used_by_others: Decimal) strict {
    label en official "section 142(h)(1)-(2): the portion provided by the issue does not exceed the portion used by unrelated persons";
    when hazardous_waste_disposal_by_incineration_or_entombment_142h(issue);
    when facility_subject_to_final_permit_requirements_subtitle_c_142h1(issue);
    when portion_provided_by_issue_and_portion_used_by_others_142h2(issue, provided, used_by_others);
    when provided <= used_by_others;
    then qualified_hazardous_waste_facility_142h(issue);
}
rule FacilityConditionsHazardousWaste(issue: BondIssue) strict {
    label en official "section 142(a)(10) with (h)";
    when issue_net_proceeds_for_exempt_facility_use(issue, QualifiedHazardousWaste, _);
    when qualified_hazardous_waste_facility_142h(issue);
    then facility_conditions_met_142(issue, QualifiedHazardousWaste);
}

// =====================================================================
// §142(i): high-speed intercity rail
// =====================================================================

relation rail_facility_conditions_142i1(issue: BondIssue, fixed_guideway_between_msas_no_rolling_stock: Boolean, max_speed_over_150_mph: Boolean, available_to_public_as_passengers: Boolean) kind empirical {
    label en official "the facility (not including rolling stock) is for the fixed guideway rail transportation of passengers and baggage between metropolitan statistical areas, uses vehicles reasonably expected to attain more than 150 miles per hour between scheduled stops, and will be available to the general public as passengers";
}
relation nongovernmental_owner_irrevocably_elects_no_deduction_or_credit_142i2(issue: BondIssue) kind empirical {
    label en official "any owner that is not a governmental unit irrevocably elects not to claim any deduction under section 167 or 168 and any credit under this subtitle with respect to the property";
}
relation issue_has_nongovernmental_owner_142i2(issue: BondIssue) kind empirical {
    label en official "the facility has an owner that is not a governmental unit";
}
relation proceeds_unspent_after_3_years_redeemed_within_6_months_142i3(issue: BondIssue) kind empirical {
    label en official "any proceeds not used within the 3-year period from the date of issuance are used, not later than 6 months after the close of that period, to redeem bonds of the issue";
}
relation issue_has_unspent_proceeds_after_3_years_142i3(issue: BondIssue) kind empirical {
    label en official "some proceeds are not used within the 3-year period";
}
pub relation high_speed_rail_conditions_met_142i(issue: BondIssue) kind institutional {
    label en official "high-speed intercity rail facilities within section 142(i)";
}
@source(IRC_S142_I, relation = formalizes, coverage = exact, quote = "A facility shall be treated as described in subsection (a)(11) only if any owner of such facility which is not a governmental unit irrevocably elects not to claim—")
rule HighSpeedRailConditionsMetGovernmentOwner(issue: BondIssue) strict {
    label en official "section 142(i)(1), (3) with only governmental owners";
    when rail_facility_conditions_142i1(issue, true, true, true);
    when not_known(issue_has_nongovernmental_owner_142i2(issue));
    when not_known(issue_has_unspent_proceeds_after_3_years_142i3(issue));
    then high_speed_rail_conditions_met_142i(issue);
}
@source(IRC_S142_I, relation = formalizes, coverage = exact, quote = "A facility shall be treated as described in subsection (a)(11) only if any owner of such facility which is not a governmental unit irrevocably elects not to claim—")
rule HighSpeedRailConditionsMetNongovernmentalOwner(issue: BondIssue) strict {
    label en official "section 142(i)(1)-(2) with a nongovernmental owner who irrevocably elects";
    when rail_facility_conditions_142i1(issue, true, true, true);
    when issue_has_nongovernmental_owner_142i2(issue);
    when nongovernmental_owner_irrevocably_elects_no_deduction_or_credit_142i2(issue);
    when not_known(issue_has_unspent_proceeds_after_3_years_142i3(issue));
    then high_speed_rail_conditions_met_142i(issue);
}
@source(IRC_S142_I, relation = formalizes, coverage = exact, quote = "A bond issued as part of an issue described in subsection (a)(11) shall not be considered an exempt facility bond unless any proceeds not used within a 3-year period of")
rule HighSpeedRailConditionsMetUnspentProceedsRedeemed(issue: BondIssue) strict {
    label en official "section 142(i)(3): unspent proceeds redeemed within 6 months after the 3-year period";
    when rail_facility_conditions_142i1(issue, true, true, true);
    when issue_has_unspent_proceeds_after_3_years_142i3(issue);
    when proceeds_unspent_after_3_years_redeemed_within_6_months_142i3(issue);
    when not_known(issue_has_nongovernmental_owner_142i2(issue));
    then high_speed_rail_conditions_met_142i(issue);
}
rule FacilityConditionsHighSpeedRail(issue: BondIssue) strict {
    label en official "section 142(a)(11) with (i)";
    when issue_net_proceeds_for_exempt_facility_use(issue, HighSpeedIntercityRail, _);
    when high_speed_rail_conditions_met_142i(issue);
    then facility_conditions_met_142(issue, HighSpeedIntercityRail);
}

// =====================================================================
// §142(j): environmental enhancements of hydroelectric generating facilities
// =====================================================================

relation property_related_to_licensed_hydro_facility_owned_and_operated_by_governmental_unit_142j1A(issue: BondIssue) kind empirical {
    label en official "the use of the property is related to a federally licensed hydroelectric generating facility owned and operated by a governmental unit";
}
relation property_protects_fisheries_or_wildlife_142j1Bi(issue: BondIssue, amount: Money) kind empirical {
    label en official "the proceeds financing property that protects or promotes fisheries or other wildlife resources, including any fish by-pass facility, fish hatchery or fisheries enhancement facility";
}
relation property_is_recreational_facility_required_by_federal_license_142j1Bii(issue: BondIssue, amount: Money) kind empirical {
    label en official "the proceeds financing a recreational facility or other improvement required by the terms and conditions of any Federal licensing permit for the operation of the generating facility";
}
pub relation hydroelectric_conditions_met_142j(issue: BondIssue) kind institutional {
    label en official "the property is described in section 142(j)(1) and at least 80 percent of the net proceeds finance property described in (j)(1)(B)(i)";
}
@source(IRC_S142_J, relation = formalizes, coverage = exact, quote = "A bond issued as part of an issue described in subsection (a)(12) shall not be considered an exempt facility bond unless at least 80 percent of the net proceeds of the")
rule HydroelectricConditionsMet(issue: BondIssue, wildlife: Money, other: Money, total: Money) strict {
    label en official "section 142(j)(1), (2): the wildlife share is at least 80 percent, exact";
    when property_related_to_licensed_hydro_facility_owned_and_operated_by_governmental_unit_142j1A(issue);
    when property_protects_fisheries_or_wildlife_142j1Bi(issue, wildlife);
    when issue_total_proceeds(issue, total);
    when total > 0.00 USD;
    when wildlife / total >= 0.80;
    then hydroelectric_conditions_met_142j(issue);
}

// =====================================================================
// §142(k): qualified public educational facilities
// =====================================================================

relation school_facility_part_of_public_school_142k1A(issue: BondIssue) kind empirical {
    label en official "the school facility is part of a public elementary school or a public secondary school (as defined by section 14101 of the Elementary and Secondary Education Act of 1965)";
}
relation owned_by_private_for_profit_corporation_under_ppp_142k1B(issue: BondIssue) kind empirical {
    label en official "the facility is owned by a private, for-profit corporation pursuant to a public-private partnership agreement with a State or local educational agency";
}
relation ppp_agreement_corporation_builds_or_equips_and_transfers_for_no_consideration_142k2A(issue: BondIssue) kind empirical {
    label en official "the corporation agrees to construct, rehabilitate, refurbish or equip a school facility, and at the end of the term to transfer it to the agency for no additional consideration";
}
relation ppp_agreement_term_not_longer_than_issue_term_142k2B(issue: BondIssue) kind empirical {
    label en official "the term of the agreement does not exceed the term of the issue";
}
relation facility_is_school_building_or_related_or_depreciable_property_142k3(issue: BondIssue) kind empirical {
    label en official "the facility is a school building, a functionally related and subordinate facility and land (including a stadium or other facility primarily used for school events), or property to which section 168 applies (or would but for section 179) for use in such a facility";
}
relation state_population_and_calendar_year_issuance_142k5A(issue: BondIssue, aggregate_face_amount_this_and_earlier_issues_in_year: Money, state_population: Integer) kind empirical {
    label en official "the aggregate face amount of bonds issued by the State under paragraph (a)(13) (with those previously issued in the calendar year) and the State population";
}
pub relation public_educational_facility_conditions_met_142k(issue: BondIssue) kind institutional {
    label en official "a qualified public educational facility issue within section 142(k)(1)-(3), (5)";
}
@source(IRC_S142_K, relation = formalizes, coverage = exact, quote = "An issue shall not be treated as an issue described in subsection (a)(13) if the aggregate face amount of bonds issued by the State pursuant thereto (when added to the")
rule PublicEducationalFacilityConditionsMet(issue: BondIssue, aggregate: Money, population: Integer) strict {
    label en official "section 142(k)(1)-(3) and (5)(A): the aggregate face amount does not exceed the greater of $10 times the State population and $5,000,000";
    when school_facility_part_of_public_school_142k1A(issue);
    when owned_by_private_for_profit_corporation_under_ppp_142k1B(issue);
    when ppp_agreement_corporation_builds_or_equips_and_transfers_for_no_consideration_142k2A(issue);
    when ppp_agreement_term_not_longer_than_issue_term_142k2B(issue);
    when facility_is_school_building_or_related_or_depreciable_property_142k3(issue);
    when state_population_and_calendar_year_issuance_142k5A(issue, aggregate, population);
    when aggregate <= max(round(10.00 USD * population, 2, "HALF_UP"), 5000000.00 USD);
    then public_educational_facility_conditions_met_142k(issue);
}
rule FacilityConditionsPublicEducational(issue: BondIssue) strict {
    label en official "section 142(a)(13) with (k)";
    when issue_net_proceeds_for_exempt_facility_use(issue, QualifiedPublicEducational, _);
    when public_educational_facility_conditions_met_142k(issue);
    then facility_conditions_met_142(issue, QualifiedPublicEducational);
}
relation state_elects_carryforward_of_unused_limitation_142k5Bii(state: us.irc.core::Organ, arose_in_calendar_year: Integer, unused: Money) kind empirical {
    label en official "the State elects to carry forward an unused limitation of the calendar year, only for exempt facility bonds described in (a)(13)";
}
pub relation carryforward_years_142k5Bii(state: us.irc.core::Organ, arose_in_calendar_year: Integer, first_year: Integer, last_year: Integer) kind institutional {
    label en official "the unused limitation may be carried forward for the 3 calendar years following the year it arose";
}
@source(IRC_S142_K, relation = formalizes, coverage = exact, quote = "A State may elect to carry forward an unused limitation for any calendar year for 3 calendar years following the calendar year in which the unused limitation arose under")
rule CarryforwardYears142k(state: us.irc.core::Organ, cy: Integer, unused: Money) strict {
    label en official "section 142(k)(5)(B)(ii)";
    when state_elects_carryforward_of_unused_limitation_142k5Bii(state, cy, unused);
    then carryforward_years_142k5Bii(state, cy, cy + 1, cy + 3);
}
relation state_allocation_of_limitation_142k5Bi(state: us.irc.core::Organ, calendar_year: Integer, allocated_to: BondIssue, amount: Money) kind empirical {
    label en official "the State allocates the amount described in subparagraph (A) for the calendar year in the manner the State determines appropriate (subject to the rest of the subparagraph)";
}
pub relation state_allocation_permitted_142k5Bi(state: us.irc.core::Organ, calendar_year: Integer, allocated_to: BondIssue) kind institutional {
    label en official "the State may allocate the limitation in such manner as it determines appropriate";
}
@source(IRC_S142_K, relation = formalizes, coverage = exact, quote = "Except as otherwise provided in this subparagraph, the State may allocate the amount described in subparagraph (A) for any calendar year in such manner as the State")
rule StateAllocationPermitted(state: us.irc.core::Organ, cy: Integer, issue: BondIssue, amount: Money) strict {
    label en official "section 142(k)(5)(B)(i)";
    when state_allocation_of_limitation_142k5Bi(state, cy, issue, amount);
    then state_allocation_permitted_142k5Bi(state, cy, issue);
}

// =====================================================================
// §142(l): qualified green building and sustainable design projects
// =====================================================================

pub entity GreenProject142l {
    label en unofficial "a qualified green building and sustainable design project (case-asserted)";
}
relation project_nominated_by_state_or_local_government_within_180_days_142l3A(project: GreenProject142l) kind empirical {
    label en official "the project is nominated by a State or local government within 180 days of the enactment of subsection (l)";
}
relation state_or_local_government_gives_written_assurances_142l3B(project: GreenProject142l) kind empirical {
    label en official "the nominating government provides written assurances that the project will satisfy the eligibility criteria of paragraph (4)";
}
pub relation project_may_be_designated_142l3(project: GreenProject142l) kind institutional {
    label en official "the project satisfies the limited designation conditions of paragraph (3)";
}
@source(IRC_S142_L, relation = formalizes, coverage = exact, quote = "A project may not be designated under this subsection unless—")
rule ProjectMayBeDesignated(project: GreenProject142l) strict {
    label en official "section 142(l)(3)(A)-(B)";
    when project_nominated_by_state_or_local_government_within_180_days_142l3A(project);
    when state_or_local_government_gives_written_assurances_142l3B(project);
    then project_may_be_designated_142l3(project);
}
relation project_leed_registered_share_142l4Ai(project: GreenProject142l, share_of_commercial_square_footage: Decimal) kind empirical {
    label en official "the share of the square footage of commercial buildings that is registered for LEED certification";
}
external judgment relation leed_certification_reasonably_expected_142l4Ai(project: GreenProject142l) {
    authority Secretary;
    label en official "the registered square footage is reasonably expected (at the time of designation) to receive LEED certification (section 142(l)(4)(A)(i)): an evaluative element, DECISION-0194 channel of the designating authority";
}
relation project_includes_brownfield_site_142l4Aii(project: GreenProject142l) kind empirical {
    label en official "the project includes a brownfield site as defined by section 101(39) of CERCLA";
}
relation state_or_local_resources_supporting_project_142l4Aiii(project: GreenProject142l, amount: Money) kind empirical {
    label en official "specific State or local government resources supporting the project (including tax abatement benefits and contributions in kind)";
}
relation project_square_feet_and_acres_142l4Aiv(project: GreenProject142l, square_feet: Integer, acres: Integer) kind empirical {
    label en official "the building floor area in square feet and the land area in acres of the project";
}
relation proposal_describes_net_benefit_allocation_142l4Av(project: GreenProject142l) kind empirical {
    label en official "the proposal describes the net benefit of the tax-exempt financing allocated to energy efficiency features, LEED compliance, or brownfield remediation";
}
relation projected_employment_142l4Avii(project: GreenProject142l, permanent_fte: Integer, construction_fte: Integer, rural_state: Boolean) kind empirical {
    label en official "the projected permanent and construction employment in full-time equivalents, and whether the project is in a rural State";
}
relation application_includes_independent_economic_impact_analysis_142l4Avii(project: GreenProject142l) kind empirical {
    label en official "the application includes an independent analysis of the project's economic impact, including projected employment";
}
relation issue_proceeds_provide_food_or_alcohol_facility_142l4Avi(project: GreenProject142l) kind empirical {
    label en official "some proceeds are used to provide a facility the principal business of which is the sale of food or alcoholic beverages for consumption on the premises";
}
pub relation project_meets_eligibility_criteria_142l4(project: GreenProject142l) kind institutional {
    label en official "the project satisfies the eligibility criteria of paragraph (4)(A)(i)-(vii)";
}
@source(IRC_S142_L, relation = formalizes, coverage = exact, quote = "A project may not be designated under this subsection unless the application for such designation includes a project proposal which describes the energy efficiency,")
rule ProjectMeetsEligibilityCriteria(project: GreenProject142l, share: Decimal, resources: Money, sqft: Integer, acres: Integer, perm: Integer, constr: Integer, rural: Boolean) strict {
    label en official "section 142(l)(4)(A)(i)-(vii): LEED share at least 75 percent, brownfield, resources at least $5,000,000, at least 1,000,000 square feet or 20 acres, net benefit proposal, no food or alcohol facility, employment at least 1,500 permanent and 1,000 construction (150 and 100 in a rural State)";
    when project_leed_registered_share_142l4Ai(project, share);
    when share >= 0.75;
    when not_known(leed_certification_reasonably_expected_142l4Ai_negated(project));
    when project_includes_brownfield_site_142l4Aii(project);
    when state_or_local_resources_supporting_project_142l4Aiii(project, resources);
    when resources >= 5000000.00 USD;
    when project_square_feet_and_acres_142l4Aiv(project, sqft, acres);
    when sqft >= 1000000;
    when proposal_describes_net_benefit_allocation_142l4Av(project);
    when not_known(issue_proceeds_provide_food_or_alcohol_facility_142l4Avi(project));
    when projected_employment_142l4Avii(project, perm, constr, rural);
    when perm >= 1500;
    when constr >= 1000;
    when application_includes_independent_economic_impact_analysis_142l4Avii(project);
    then project_meets_eligibility_criteria_142l4(project);
}
relation leed_certification_reasonably_expected_142l4Ai_negated(project: GreenProject142l) kind empirical {
    label en official "the designating authority found the LEED certification not reasonably expected (a negated evaluative finding, asserted by the case)";
}
@source(IRC_S142_L, relation = formalizes, coverage = exact, quote = "The project is projected to provide permanent employment of at least 1,500 full time equivalents (150 full time equivalents in rural States) when completed and")
rule ProjectMeetsEligibilityCriteriaRural(project: GreenProject142l, share: Decimal, resources: Money, sqft: Integer, acres: Integer, perm: Integer, constr: Integer) strict {
    label en official "section 142(l)(4)(A)(vii) for a rural State: at least 150 permanent and 100 construction full-time equivalents; the (iv) alternative of 20 acres";
    when project_leed_registered_share_142l4Ai(project, share);
    when share >= 0.75;
    when not_known(leed_certification_reasonably_expected_142l4Ai_negated(project));
    when project_includes_brownfield_site_142l4Aii(project);
    when state_or_local_resources_supporting_project_142l4Aiii(project, resources);
    when resources >= 5000000.00 USD;
    when project_square_feet_and_acres_142l4Aiv(project, sqft, acres);
    when acres >= 20;
    when proposal_describes_net_benefit_allocation_142l4Av(project);
    when not_known(issue_proceeds_provide_food_or_alcohol_facility_142l4Avi(project));
    when projected_employment_142l4Avii(project, perm, constr, true);
    when perm >= 150;
    when constr >= 100;
    when application_includes_independent_economic_impact_analysis_142l4Avii(project);
    then project_meets_eligibility_criteria_142l4(project);
}
relation state_population_2000_142l6A(state: us.irc.core::Organ, population: Integer, density_per_square_mile: Integer, growth_rate_1990_2000: Decimal, national_growth_rate_1990_2000: Decimal) kind empirical {
    label en official "the 2000 census population and density of the State and its population growth 1990-2000 against the national growth";
}
pub relation rural_state_142l6A(state: us.irc.core::Organ) kind institutional {
    label en official "a rural State: population below 4,500,000, density below 150 per square mile, and growth between 1990 and 2000 below half of the national rate";
}
@source(IRC_S142_L, relation = formalizes, coverage = exact, quote = "The term \"rural State\" means any State which has—")
rule RuralStateDefined(state: us.irc.core::Organ, pop: Integer, density: Integer, g: Decimal, ng: Decimal) strict {
    label en official "section 142(l)(6)(A)(i)-(iii)";
    when state_population_2000_142l6A(state, pop, density, g, ng);
    when pop < 4500000;
    when density < 150;
    when g * 2 < ng;
    then rural_state_142l6A(state);
}
relation designation_projected_by_secretary_142l2(project: GreenProject142l, designated_on: Date, application_period_end: Date) kind empirical {
    label en official "the date the Secretary designates the project and the end of the application period";
}
relation secretary_designates_projects_142l2A(application_period_end: Date) kind empirical {
    label en official "the Secretary designates qualified green building and sustainable design projects";
}
relation designation_made_on_142l2A(application_period_end: Date, designation_date: Date) kind empirical {
    label en official "the date the designations are made";
}
@source(IRC_S142_L, relation = formalizes, coverage = exact, quote = "Within 60 days after the end of the application period described in paragraph (3)(A), the Secretary, after consultation with the Administrator of the Environmental")
rule Section142l2ADesignationDutyRule strict {
    for application_end: Date;
    when application_period_ended_142l3A(application_end);
    then duty Section142l2ADesignationDuty {
        bearer Secretary;
        goal achievement {
            condition green_projects_designated_142l2A(application_end);
            window [application_end, add_calendar_period(application_end, 60 calendar_day)];
        }
    };
}
relation application_period_ended_142l3A(application_end: Date) kind empirical {
    label en official "the application period described in paragraph (3)(A) ends on the date";
}
relation green_projects_designated_142l2A(application_end: Date) kind empirical {
    label en official "the Secretary has designated the projects, after consultation with the Administrator of the Environmental Protection Agency";
}
relation project_complete_on_142l5(project: GreenProject142l, completed_on: Date) kind empirical {
    label en official "the date the project is completed";
}
relation project_certified_benefit_used_142l5(project: GreenProject142l) kind empirical {
    label en official "the project certified to the Secretary that the net benefit of the tax-exempt financing was used for the purposes of paragraph (4)";
}
@source(IRC_S142_L, relation = formalizes, coverage = exact, quote = "No later than 30 days after the completion of the project, each project must certify to the Secretary that the net benefit of the tax-exempt financing was used for the")
rule Section142l5CertificationDutyRule strict {
    for project: GreenProject142l;
    for completed: Date;
    when project_complete_on_142l5(project, completed);
    then duty Section142l5CertificationDuty {
        bearer project;
        beneficiary Secretary;
        goal achievement {
            condition project_certified_benefit_used_142l5(project);
            window [completed, add_calendar_period(completed, 30 calendar_day)];
        }
    };
}
relation aggregate_green_authority_allocated_142l7B(secretary_allocation_total: Money) kind empirical {
    label en official "the aggregate face amount of authority to issue qualified green building and sustainable design project bonds the Secretary allocates";
}
relation secretary_allocates_green_authority_142l7B(total: Money) kind empirical {
    label en official "the Secretary allocates authority in the given aggregate face amount";
}
@source(IRC_S142_L, relation = formalizes, coverage = exact, quote = "The Secretary may not allocate authority to issue qualified green building and sustainable design project bonds in an aggregate face amount exceeding $2,000,000,000.")
rule Section142l7BAllocationCapRule strict {
    for total: Money;
    when secretary_allocates_green_authority_142l7B(total)
        and total > 2000000000.00 USD;
    then prohibition Section142l7BAllocationCap {
        bearer Secretary;
        action allocates_green_authority_above_2_billion_142l7B(total);
        window [-infinity, infinity];
    };
}
relation allocates_green_authority_above_2_billion_142l7B(total: Money) kind empirical {
    label en official "the Secretary allocates authority above $2,000,000,000 in the aggregate";
}
relation project_bond_face_amount_and_designated_amount_142l7A(project: GreenProject142l, face_amount_with_earlier: Money, designated_amount: Money) kind empirical {
    label en official "the aggregate face amount of bonds issued for the project (with earlier ones) and the amount the Secretary designated for the project";
}
pub relation green_project_issue_within_designated_amount_142l7A(project: GreenProject142l) kind institutional {
    label en official "the aggregate face amount for the project does not exceed the amount designated by the Secretary as part of the designation";
}
@source(IRC_S142_L, relation = formalizes, coverage = exact, quote = "An issue shall not be treated as an issue described in subsection (a)(14) if the aggregate face amount of bonds issued by the State or local government pursuant thereto")
rule GreenProjectIssueWithinDesignatedAmount(project: GreenProject142l, face: Money, designated: Money) strict {
    label en official "section 142(l)(7)(A)";
    when project_bond_face_amount_and_designated_amount_142l7A(project, face, designated);
    when face <= designated;
    then green_project_issue_within_designated_amount_142l7A(project);
}
pub relation green_building_bond_issue_permitted_142l8(issue: BondIssue) kind institutional {
    label en official "subsection (a)(14) applies to a bond issued on or before September 30, 2012";
}
@source(IRC_S142_L, relation = formalizes, coverage = exact, quote = "Subsection (a)(14) shall not apply with respect to any bond issued after September 30, 2012.")
rule GreenBuildingBondIssuePermittedByDate(issue: BondIssue, issued_on: Date) strict {
    label en official "section 142(l)(8)";
    when bond_issue_date_142(issue, issued_on);
    when issued_on <= @2012-09-30;
    then green_building_bond_issue_permitted_142l8(issue);
}
relation green_project_for_issue_142l(issue: BondIssue, project: GreenProject142l) kind empirical {
    label en official "the issue finances the green building project";
}
rule FacilityConditionsGreenBuilding(issue: BondIssue, project: GreenProject142l) strict {
    label en official "section 142(a)(14) with (l)";
    when issue_net_proceeds_for_exempt_facility_use(issue, QualifiedGreenBuilding, _);
    when green_project_for_issue_142l(issue, project);
    when project_may_be_designated_142l3(project);
    when project_meets_eligibility_criteria_142l4(project);
    when green_project_issue_within_designated_amount_142l7A(project);
    when green_building_bond_issue_permitted_142l8(issue);
    then facility_conditions_met_142(issue, QualifiedGreenBuilding);
}
relation refunding_bond_avg_maturity_amount_redemption_142lm(refunding: BondIssue, avg_maturity_not_later: Boolean, amount_not_above_outstanding: Boolean, redeemed_within_90_days: Boolean) kind empirical {
    label en official "for a refunding bond: the average maturity is not later than that of the refunded bonds, the amount does not exceed the outstanding refunded amount, and the refunded bond is redeemed not later than 90 days after issuance";
}
pub relation refunding_exception_142l9_142m4(refunding: BondIssue) kind institutional {
    label en official "the current refunding exception of section 142(l)(9) and (m)(4): the three refunding conditions are met";
}
@source(IRC_S142_L, relation = formalizes, coverage = exact, quote = "(A) the average maturity date of the issue of which the refunding bond is a part is not later than the average maturity date of the bonds to be refunded by such issue,")
rule RefundingException142(refunding: BondIssue) strict {
    label en official "section 142(l)(9)(A)-(C) and (m)(4)(A)-(C)";
    when refunding_bond_avg_maturity_amount_redemption_142lm(refunding, true, true, true);
    then refunding_exception_142l9_142m4(refunding);
}

// =====================================================================
// §142(m): qualified highway or surface freight transfer facilities
// =====================================================================

pub enum HighwayFacilityKind142m1 { SurfaceTransportationProjectTitle23; InternationalBridgeOrTunnelTitle23; FreightTransferFacilityTitle23Or49; OtherHighwayFacility; }
relation highway_facility_kind_142m1(issue: BondIssue, kind: HighwayFacilityKind142m1) kind empirical {
    label en official "the facility financed: a surface transportation project receiving Federal assistance under title 23, an international bridge or tunnel receiving title 23 assistance, or a facility for the transfer of freight between truck and rail receiving assistance under title 23 or 49";
}
pub relation qualified_highway_facility_142m1(issue: BondIssue) kind institutional {
    label en official "a qualified highway or surface freight transfer facility";
}
@source(IRC_S142_M, relation = formalizes, coverage = exact, quote = "(A) any surface transportation project which receives Federal assistance under title 23, United States Code (as in effect on the date of the enactment of this")
rule QualifiedHighwayFacilityTitle23(issue: BondIssue) strict {
    label en official "section 142(m)(1)(A)";
    when highway_facility_kind_142m1(issue, SurfaceTransportationProjectTitle23);
    then qualified_highway_facility_142m1(issue);
}
@source(IRC_S142_M, relation = formalizes, coverage = exact, quote = "(B) any project for an international bridge or tunnel for which an international entity authorized under Federal or State law is responsible and which receives Federal")
rule QualifiedHighwayFacilityBridge(issue: BondIssue) strict {
    label en official "section 142(m)(1)(B)";
    when highway_facility_kind_142m1(issue, InternationalBridgeOrTunnelTitle23);
    then qualified_highway_facility_142m1(issue);
}
@source(IRC_S142_M, relation = formalizes, coverage = exact, quote = "(C) any facility for the transfer of freight from truck to rail or rail to truck (including any temporary storage facilities directly related to such transfers) which")
rule QualifiedHighwayFacilityFreight(issue: BondIssue) strict {
    label en official "section 142(m)(1)(C)";
    when highway_facility_kind_142m1(issue, FreightTransferFacilityTitle23Or49);
    then qualified_highway_facility_142m1(issue);
}
relation highway_allocation_and_cap_142m2(issue: BondIssue, face_amount_for_facility_with_earlier: Money, amount_allocated_to_facility: Money) kind empirical {
    label en official "the aggregate face amount of bonds issued for the facility (with earlier ones) and the amount the Secretary of Transportation allocated to the facility";
}
pub relation highway_issue_within_allocation_142m2B(issue: BondIssue) kind institutional {
    label en official "the issue is treated as described in (a)(15): the aggregate face amount for the facility does not exceed the amount allocated to it";
}
@source(IRC_S142_M, relation = formalizes, coverage = exact, quote = "An issue shall not be treated as an issue described in subsection (a)(15) if the aggregate face amount of bonds issued pursuant to such issue for any qualified highway")
rule HighwayIssueWithinAllocation(issue: BondIssue, face: Money, allocated: Money) strict {
    label en official "section 142(m)(2)(B)";
    when highway_allocation_and_cap_142m2(issue, face, allocated);
    when face <= allocated;
    then highway_issue_within_allocation_142m2B(issue);
}
relation total_allocated_by_secretary_of_transportation_142m2A(total: Money) kind empirical {
    label en official "the aggregate amount allocated by the Secretary of Transportation under subparagraph (C)";
}
relation transportation_secretary_allocates_142m2A(total: Money) kind empirical {
    label en official "the Secretary of Transportation allocates the aggregate amount";
}
relation allocates_highway_authority_above_30_billion_142m2A(total: Money) kind empirical {
    label en official "the aggregate amount allocated exceeds $30,000,000,000";
}
@source(IRC_S142_M, relation = formalizes, coverage = exact, quote = "The aggregate amount allocated by the Secretary of Transportation under subparagraph (C) shall not exceed $30,000,000,000.")
rule Section142m2ACapRule strict {
    for total: Money;
    when transportation_secretary_allocates_142m2A(total)
        and total > 30000000000.00 USD;
    then prohibition Section142m2AAllocationCap {
        bearer SecretaryOfTransportation142m;
        action allocates_highway_authority_above_30_billion_142m2A(total);
        window [-infinity, infinity];
    };
}
pub const SecretaryOfTransportation142m: us.irc.core::Organ = entity_ref("urn:us:irc:gross_income#secretary-of-transportation") {
    label en official "the Secretary of Transportation (section 142(m)(2))";
}
relation highway_net_proceeds_expended_142m3(issue: BondIssue, share_expended_within_5_years: Decimal) kind empirical {
    label en official "the share of the net proceeds expended for qualified highway or surface freight transfer facilities within the 5-year period beginning on the date of issuance";
}
relation unspent_proceeds_redeemed_within_90_days_after_5_years_142m3(issue: BondIssue) kind empirical {
    label en official "the issuer uses all unspent proceeds to redeem bonds of the issue within 90 days after the end of the 5-year period";
}
pub relation highway_expenditure_requirement_met_142m3(issue: BondIssue) kind institutional {
    label en official "at least 95 percent of the net proceeds are expended within 5 years, or the unspent proceeds are used to redeem bonds within 90 days after the period";
}
@source(IRC_S142_M, relation = formalizes, coverage = exact, quote = "An issue shall not be treated as an issue described in subsection (a)(15) unless at least 95 percent of the net proceeds of the issue is expended for qualified highway")
rule HighwayExpenditureRequirementMetBySpending(issue: BondIssue, share: Decimal) strict {
    label en official "section 142(m)(3), first sentence";
    when highway_net_proceeds_expended_142m3(issue, share);
    when share >= 0.95;
    then highway_expenditure_requirement_met_142m3(issue);
}
@source(IRC_S142_M, relation = formalizes, coverage = exact, quote = "An issue shall not be treated as an issue described in subsection (a)(15) unless at least 95 percent of the net proceeds of the issue is expended for qualified highway")
rule HighwayExpenditureRequirementMetByRedemption(issue: BondIssue, share: Decimal) strict {
    label en official "section 142(m)(3), second sentence (the Secretary's extension for circumstances beyond the issuer's control is EXTERNAL_DEPENDENCY)";
    when highway_net_proceeds_expended_142m3(issue, share);
    when share < 0.95;
    when unspent_proceeds_redeemed_within_90_days_after_5_years_142m3(issue);
    then highway_expenditure_requirement_met_142m3(issue);
}
rule FacilityConditionsHighway(issue: BondIssue) strict {
    label en official "section 142(a)(15) with (m)";
    when issue_net_proceeds_for_exempt_facility_use(issue, QualifiedHighwayOrSurfaceFreightTransfer, _);
    when qualified_highway_facility_142m1(issue);
    when highway_issue_within_allocation_142m2B(issue);
    when highway_expenditure_requirement_met_142m3(issue);
    then facility_conditions_met_142(issue, QualifiedHighwayOrSurfaceFreightTransfer);
}

// =====================================================================
// §142(n): qualified broadband projects
// =====================================================================

relation broadband_project_census_block_groups_142n1A(issue: BondIssue, share_of_households_without_25_3_service: Decimal) kind empirical {
    label en official "the share of residential households, in the census block groups the project is designed to serve solely, without access to fixed terrestrial broadband delivering at least 25 megabits per second downstream and 3 upstream";
}
relation broadband_project_speeds_142n1B(issue: BondIssue, downstream_mbps: Integer, upstream_mbps: Integer, share_of_locations_previously_unserved_or_underserved: Decimal) kind empirical {
    label en official "the speeds the project delivers to locations, and the share of the locations provided access that before the project were unserved or below the (A) minimum speeds";
}
relation issuer_notified_each_provider_with_scope_and_request_142n2AB(issue: BondIssue) kind empirical {
    label en official "before the issue date the issuer notified each broadband provider in the area of the project and its intended scope and included a request for information on the provider's ability to deploy, manage and maintain a gigabit-capable network";
}
relation provider_notice_and_response_days_142n2C(issue: BondIssue, days_allowed_to_respond: Integer) kind empirical {
    label en official "the number of days each provider is allowed to respond to the notice";
}
pub relation qualified_broadband_project_142n(issue: BondIssue) kind institutional {
    label en official "a qualified broadband project";
}
@source(IRC_S142_N, relation = formalizes, coverage = exact, quote = "(A) is designed to provide broadband service solely to 1 or more census block groups in which more than 50 percent of residential households do not have access to fixed,")
rule QualifiedBroadbandProject(issue: BondIssue, share_unserved: Decimal, down: Integer, up: Integer, share_locations: Decimal, days: Integer) strict {
    label en official "section 142(n)(1)(A)-(B) and (2)(A)-(C): more than 50 percent of the households unserved, at least 100 down and 20 up, at least 90 percent of the locations previously unserved or underserved, notice with at least 90 days to respond";
    when broadband_project_census_block_groups_142n1A(issue, share_unserved);
    when share_unserved > 0.50;
    when broadband_project_speeds_142n1B(issue, down, up, share_locations);
    when down >= 100;
    when up >= 20;
    when share_locations >= 0.90;
    when issuer_notified_each_provider_with_scope_and_request_142n2AB(issue);
    when provider_notice_and_response_days_142n2C(issue, days);
    when days >= 90;
    then qualified_broadband_project_142n(issue);
}
rule FacilityConditionsBroadband(issue: BondIssue) strict {
    label en official "section 142(a)(16) with (n)";
    when issue_net_proceeds_for_exempt_facility_use(issue, QualifiedBroadband, _);
    when qualified_broadband_project_142n(issue);
    then facility_conditions_met_142(issue, QualifiedBroadband);
}

// =====================================================================
// §142(o): qualified carbon dioxide capture facilities
// =====================================================================

pub enum IndustrialCo2Process142o { FuelCombustion; Gasification; Bioindustrial; Fermentation; ChemicalsManufacturing; FertilizersManufacturing; GlassManufacturing; SteelManufacturing; PetroleumResidues; ForestProducts; AgricultureIncludingFeedlotsAndDairy; TransportationGradeLiquidFuels; OtherProcess; }
relation facility_emits_co2_from_process_142o2Bi(issue: BondIssue, process: IndustrialCo2Process142o) kind empirical {
    label en official "the facility emits carbon dioxide (including from any fugitive emissions source) that is created as a result of the process";
}
relation facility_is_geological_gas_facility_142o2Bii1(issue: BondIssue) kind empirical {
    label en official "the facility produces a raw product of gas or mixed gas and liquid from a geological formation, transports or removes impurities from it, or separates it into constituent parts (section 142(o)(2)(B)(iii)(II))";
}
relation facility_is_air_separation_unit_outside_gasification_or_oxyfuel_142o2Bii2(issue: BondIssue) kind empirical {
    label en official "the facility is an air separation unit that does not qualify as gasification equipment or is not a necessary component of an oxy-fuel combustion process";
}
pub relation industrial_carbon_dioxide_facility_142o2B(issue: BondIssue) kind institutional {
    label en official "an industrial carbon dioxide facility: it emits carbon dioxide created by a listed process and is not a geological gas facility or an air separation unit outside gasification or oxy-fuel combustion";
}
@source(IRC_S142_O, relation = formalizes, coverage = exact, quote = "(I) Fuel combustion.")
rule IndustrialCo2FacilityFuelCombustion(issue: BondIssue) strict {
    label en official "section 142(o)(2)(B)(i)(I)";
    when facility_emits_co2_from_process_142o2Bi(issue, FuelCombustion);
    when not_known(facility_is_geological_gas_facility_142o2Bii1(issue));
    when not_known(facility_is_air_separation_unit_outside_gasification_or_oxyfuel_142o2Bii2(issue));
    then industrial_carbon_dioxide_facility_142o2B(issue);
}
@source(IRC_S142_O, relation = formalizes, coverage = exact, quote = "(II) Gasification.")
rule IndustrialCo2FacilityGasification(issue: BondIssue) strict {
    label en official "section 142(o)(2)(B)(i)(II)";
    when facility_emits_co2_from_process_142o2Bi(issue, Gasification);
    when not_known(facility_is_geological_gas_facility_142o2Bii1(issue));
    when not_known(facility_is_air_separation_unit_outside_gasification_or_oxyfuel_142o2Bii2(issue));
    then industrial_carbon_dioxide_facility_142o2B(issue);
}
@source(IRC_S142_O, relation = formalizes, coverage = exact, quote = "(III) Bioindustrial.")
rule IndustrialCo2FacilityBioindustrial(issue: BondIssue) strict {
    label en official "section 142(o)(2)(B)(i)(III)";
    when facility_emits_co2_from_process_142o2Bi(issue, Bioindustrial);
    when not_known(facility_is_geological_gas_facility_142o2Bii1(issue));
    when not_known(facility_is_air_separation_unit_outside_gasification_or_oxyfuel_142o2Bii2(issue));
    then industrial_carbon_dioxide_facility_142o2B(issue);
}
@source(IRC_S142_O, relation = formalizes, coverage = exact, quote = "(IV) Fermentation.")
rule IndustrialCo2FacilityFermentation(issue: BondIssue) strict {
    label en official "section 142(o)(2)(B)(i)(IV)";
    when facility_emits_co2_from_process_142o2Bi(issue, Fermentation);
    when not_known(facility_is_geological_gas_facility_142o2Bii1(issue));
    when not_known(facility_is_air_separation_unit_outside_gasification_or_oxyfuel_142o2Bii2(issue));
    then industrial_carbon_dioxide_facility_142o2B(issue);
}
@source(IRC_S142_O, relation = formalizes, coverage = exact, quote = "(V) Any manufacturing industry relating to—")
rule IndustrialCo2FacilityManufacturingChemicals(issue: BondIssue) strict {
    label en official "section 142(o)(2)(B)(i)(V)(aa): chemicals";
    when facility_emits_co2_from_process_142o2Bi(issue, ChemicalsManufacturing);
    when not_known(facility_is_geological_gas_facility_142o2Bii1(issue));
    when not_known(facility_is_air_separation_unit_outside_gasification_or_oxyfuel_142o2Bii2(issue));
    then industrial_carbon_dioxide_facility_142o2B(issue);
}
rule IndustrialCo2FacilityManufacturingFertilizers(issue: BondIssue) strict {
    label en official "section 142(o)(2)(B)(i)(V)(bb): fertilizers";
    when facility_emits_co2_from_process_142o2Bi(issue, FertilizersManufacturing);
    when not_known(facility_is_geological_gas_facility_142o2Bii1(issue));
    when not_known(facility_is_air_separation_unit_outside_gasification_or_oxyfuel_142o2Bii2(issue));
    then industrial_carbon_dioxide_facility_142o2B(issue);
}
rule IndustrialCo2FacilityManufacturingGlass(issue: BondIssue) strict {
    label en official "section 142(o)(2)(B)(i)(V)(cc): glass";
    when facility_emits_co2_from_process_142o2Bi(issue, GlassManufacturing);
    when not_known(facility_is_geological_gas_facility_142o2Bii1(issue));
    when not_known(facility_is_air_separation_unit_outside_gasification_or_oxyfuel_142o2Bii2(issue));
    then industrial_carbon_dioxide_facility_142o2B(issue);
}
rule IndustrialCo2FacilityManufacturingSteel(issue: BondIssue) strict {
    label en official "section 142(o)(2)(B)(i)(V)(dd): steel";
    when facility_emits_co2_from_process_142o2Bi(issue, SteelManufacturing);
    when not_known(facility_is_geological_gas_facility_142o2Bii1(issue));
    when not_known(facility_is_air_separation_unit_outside_gasification_or_oxyfuel_142o2Bii2(issue));
    then industrial_carbon_dioxide_facility_142o2B(issue);
}
rule IndustrialCo2FacilityManufacturingPetroleumResidues(issue: BondIssue) strict {
    label en official "section 142(o)(2)(B)(i)(V)(ee): petroleum residues (the carbonized product of high-boiling hydrocarbon fractions obtained in petroleum processing)";
    when facility_emits_co2_from_process_142o2Bi(issue, PetroleumResidues);
    when not_known(facility_is_geological_gas_facility_142o2Bii1(issue));
    when not_known(facility_is_air_separation_unit_outside_gasification_or_oxyfuel_142o2Bii2(issue));
    then industrial_carbon_dioxide_facility_142o2B(issue);
}
rule IndustrialCo2FacilityManufacturingForestProducts(issue: BondIssue) strict {
    label en official "section 142(o)(2)(B)(i)(V)(ff): forest products";
    when facility_emits_co2_from_process_142o2Bi(issue, ForestProducts);
    when not_known(facility_is_geological_gas_facility_142o2Bii1(issue));
    when not_known(facility_is_air_separation_unit_outside_gasification_or_oxyfuel_142o2Bii2(issue));
    then industrial_carbon_dioxide_facility_142o2B(issue);
}
rule IndustrialCo2FacilityManufacturingAgriculture(issue: BondIssue) strict {
    label en official "section 142(o)(2)(B)(i)(V)(gg): agriculture, including feedlots and dairy operations";
    when facility_emits_co2_from_process_142o2Bi(issue, AgricultureIncludingFeedlotsAndDairy);
    when not_known(facility_is_geological_gas_facility_142o2Bii1(issue));
    when not_known(facility_is_air_separation_unit_outside_gasification_or_oxyfuel_142o2Bii2(issue));
    then industrial_carbon_dioxide_facility_142o2B(issue);
}
rule IndustrialCo2FacilityManufacturingTransportFuels(issue: BondIssue) strict {
    label en official "section 142(o)(2)(B)(i)(V)(hh): transportation grade liquid fuels";
    when facility_emits_co2_from_process_142o2Bi(issue, TransportationGradeLiquidFuels);
    when not_known(facility_is_geological_gas_facility_142o2Bii1(issue));
    when not_known(facility_is_air_separation_unit_outside_gasification_or_oxyfuel_142o2Bii2(issue));
    then industrial_carbon_dioxide_facility_142o2B(issue);
}
relation designed_capture_and_storage_metric_tons_142o3C(issue: BondIssue, captured_and_injected_annually: Integer, otherwise_released_annually: Integer) kind empirical {
    label en official "the total metric tons of carbon dioxide designed to be annually captured, transported and injected into a geologic storage facility or an enhanced oil or gas recovery well followed by geologic storage, and the total metric tons which would otherwise be released each year if the eligible components were not installed (for components designed to capture from specific sources only, the specific sources or portions, section 142(o)(3)(C)(ii))";
}
pub relation capture_and_storage_percentage_142o3C(issue: BondIssue, percentage: Decimal) kind institutional {
    label en official "the capture and storage percentage: captured over otherwise released, expressed as a fraction";
}
@source(IRC_S142_O, relation = formalizes, coverage = exact, quote = "Subject to clause (ii), the capture and storage percentage shall be an amount, expressed as a percentage, equal to the quotient of—")
rule CaptureAndStoragePercentage(issue: BondIssue, captured: Integer, released: Integer) strict {
    label en official "section 142(o)(3)(C)(i)-(ii): exact fraction, one rounding to six places HALF_UP (a judgment call: the text names no rounding)";
    when designed_capture_and_storage_metric_tons_142o3C(issue, captured, released);
    when released > 0;
    then capture_and_storage_percentage_142o3C(issue, div_round(captured * 1.0, released * 1.0, 6, "HALF_UP"));
}
pub relation eligible_components_meet_capture_percentage_142o3A(issue: BondIssue) kind institutional {
    label en official "the eligible components are designed to have a capture and storage percentage of 65 percent or more";
}
@source(IRC_S142_O, relation = formalizes, coverage = exact, quote = "Subject to subparagraph (B), the eligible components of an industrial carbon dioxide facility satisfies the requirements of this paragraph if such eligible components")
rule EligibleComponentsMeetCapturePercentage(issue: BondIssue, pct: Decimal) strict {
    label en official "section 142(o)(3)(A)";
    when capture_and_storage_percentage_142o3C(issue, pct);
    when pct >= 0.65;
    then eligible_components_meet_capture_percentage_142o3A(issue);
}
pub relation financeable_cost_share_of_components_142o3B(issue: BondIssue, share: Decimal) kind institutional {
    label en official "for components designed with a capture and storage percentage below 65 percent, the share of their cost that may be financed with tax-exempt bonds may not exceed the designed percentage";
}
@source(IRC_S142_O, relation = formalizes, coverage = exact, quote = "In the case of an industrial carbon dioxide facility designed with a capture and storage percentage that is less than 65 percent, the percentage of the cost of the")
rule FinanceableCostShareBelowSixtyFive(issue: BondIssue, pct: Decimal) strict {
    label en official "section 142(o)(3)(B)";
    when capture_and_storage_percentage_142o3C(issue, pct);
    when pct < 0.65;
    then financeable_cost_share_of_components_142o3B(issue, pct);
}
relation equipment_used_for_capture_or_syngas_142o2Ai(issue: BondIssue, limb_i: Boolean, limb_ii: Boolean) kind empirical {
    label en official "the equipment is used for the purpose of capture, treatment and purification, compression, transportation or on-site storage of carbon dioxide produced by the facility (I), or is integral or functionally related and subordinate to a process converting a solid or liquid product into synthesis gas (II)";
}
relation direct_air_capture_facility_45Qe3_142o1B(issue: BondIssue) kind empirical {
    label en official "the facility is a direct air capture facility as defined in section 45Q(e)(3)";
}
pub relation qualified_carbon_dioxide_capture_facility_142o(issue: BondIssue) kind institutional {
    label en official "a qualified carbon dioxide capture facility: the eligible components of an industrial carbon dioxide facility, or a direct air capture facility";
}
@source(IRC_S142_O, relation = formalizes, coverage = exact, quote = "(A) the eligible components of an industrial carbon dioxide facility, and")
rule QualifiedCo2CaptureFacilityEligibleComponents(issue: BondIssue) strict {
    label en official "section 142(o)(1)(A) with (2)(A)(i), (3)";
    when industrial_carbon_dioxide_facility_142o2B(issue);
    when equipment_used_for_capture_or_syngas_142o2Ai(issue, true, false);
    when eligible_components_meet_capture_percentage_142o3A(issue);
    then qualified_carbon_dioxide_capture_facility_142o(issue);
}
@source(IRC_S142_O, relation = formalizes, coverage = exact, quote = "(II) integral or functionally related and subordinate to a process which converts a solid or liquid product from coal, petroleum residue, biomass, or other materials")
rule QualifiedCo2CaptureFacilitySyngasComponents(issue: BondIssue) strict {
    label en official "section 142(o)(1)(A) with (2)(A)(i)(II), (3)";
    when industrial_carbon_dioxide_facility_142o2B(issue);
    when equipment_used_for_capture_or_syngas_142o2Ai(issue, false, true);
    when eligible_components_meet_capture_percentage_142o3A(issue);
    then qualified_carbon_dioxide_capture_facility_142o(issue);
}
@source(IRC_S142_O, relation = formalizes, coverage = exact, quote = "(B) a direct air capture facility (as defined in section 45Q(e)(3)).")
rule QualifiedCo2CaptureFacilityDirectAir(issue: BondIssue) strict {
    label en official "section 142(o)(1)(B)";
    when direct_air_capture_facility_45Qe3_142o1B(issue);
    then qualified_carbon_dioxide_capture_facility_142o(issue);
}
rule FacilityConditionsCarbonCapture(issue: BondIssue) strict {
    label en official "section 142(a)(17) with (o)";
    when issue_net_proceeds_for_exempt_facility_use(issue, QualifiedCarbonDioxideCapture, _);
    when qualified_carbon_dioxide_capture_facility_142o(issue);
    then facility_conditions_met_142(issue, QualifiedCarbonDioxideCapture);
}
relation material_coal_or_biomass_142o2Aii(issue: BondIssue, kind: CoalOrBiomassKind142o) kind empirical {
    label en official "the material converted in a process: coal (anthracite, bituminous coal, subbituminous coal, lignite, peat), or biomass (agricultural or plant waste, a byproduct of wood or paper mill operations including lignin in spent pulping liquors, other products of forestry maintenance; paper which is commonly recycled is not biomass)";
}
pub enum CoalOrBiomassKind142o { AnthraciteBituminousSubbituminousLigniteOrPeat; AgriculturalOrPlantWaste; WoodOrPaperMillByproduct; ForestryMaintenanceProduct; CommonlyRecycledPaper; OtherMaterial; }
pub relation material_is_coal_or_biomass_142o2Aii(issue: BondIssue) kind institutional {
    label en official "the material is coal or biomass within section 142(o)(2)(A)(ii)";
}
@source(IRC_S142_O, relation = formalizes, coverage = exact, quote = "The term \"coal\" means anthracite, bituminous coal, subbituminous coal, lignite, and peat.")
rule MaterialIsCoal(issue: BondIssue) strict {
    label en official "section 142(o)(2)(A)(ii)(II)";
    when material_coal_or_biomass_142o2Aii(issue, AnthraciteBituminousSubbituminousLigniteOrPeat);
    then material_is_coal_or_biomass_142o2Aii(issue);
}
@source(IRC_S142_O, relation = formalizes, coverage = exact, quote = "(AA) agricultural or plant waste,")
rule MaterialIsBiomassPlantWaste(issue: BondIssue) strict {
    label en official "section 142(o)(2)(A)(ii)(I)(aa)(AA)";
    when material_coal_or_biomass_142o2Aii(issue, AgriculturalOrPlantWaste);
    then material_is_coal_or_biomass_142o2Aii(issue);
}
@source(IRC_S142_O, relation = formalizes, coverage = exact, quote = "(BB) byproduct of wood or paper mill operations, including lignin in spent pulping liquors, and")
rule MaterialIsBiomassMillByproduct(issue: BondIssue) strict {
    label en official "section 142(o)(2)(A)(ii)(I)(aa)(BB)";
    when material_coal_or_biomass_142o2Aii(issue, WoodOrPaperMillByproduct);
    then material_is_coal_or_biomass_142o2Aii(issue);
}
@source(IRC_S142_O, relation = formalizes, coverage = exact, quote = "(CC) other products of forestry maintenance.")
rule MaterialIsBiomassForestry(issue: BondIssue) strict {
    label en official "section 142(o)(2)(A)(ii)(I)(aa)(CC)";
    when material_coal_or_biomass_142o2Aii(issue, ForestryMaintenanceProduct);
    then material_is_coal_or_biomass_142o2Aii(issue);
}

// =====================================================================
// Pub. L. 119-21 section 70309: spaceports (new §142(p), §149(b)(3)(F))
// =====================================================================

pub enum SpaceportUse142p { ManufacturingOrRepairOfSpacecraft; FlightControlOperations; LaunchAndReentryServices; TransferOfCrewOrCargo; OtherUse; }
relation facility_at_or_near_launch_or_reentry_site_142p1(issue: BondIssue) kind empirical {
    label en official "the facility is located at or in close proximity to a launch site or reentry site";
}
relation facility_used_for_142p1(issue: BondIssue, use: SpaceportUse142p) kind empirical {
    label en official "the use of the facility: manufacturing, assembling or repairing spacecraft, space cargo, other spaceport facilities or components; flight control operations; providing launch and reentry services; transferring crew, spaceflight participants or space cargo to or from spacecraft";
}
pub relation spaceport_142p(issue: BondIssue) kind institutional {
    label en official "a spaceport within section 142(p)(1), added by Pub. L. 119-21 section 70309(c)";
}
@source(us.irc.temporal::PL119_21_S70309, relation = formalizes, coverage = exact, quote = "the term ‘spaceport’ means any facility located at or in close proximity to a launch site or reentry site used for—")
rule SpaceportManufacturing(issue: BondIssue) strict {
    label en official "section 142(p)(1)(A); public availability is not required ((p)(3))";
    when facility_at_or_near_launch_or_reentry_site_142p1(issue);
    when facility_used_for_142p1(issue, ManufacturingOrRepairOfSpacecraft);
    then spaceport_142p(issue);
}
@source(us.irc.temporal::PL119_21_S70309, relation = formalizes, coverage = exact, quote = "(B) flight control operations,")
rule SpaceportFlightControl(issue: BondIssue) strict {
    label en official "section 142(p)(1)(B)";
    when facility_at_or_near_launch_or_reentry_site_142p1(issue);
    when facility_used_for_142p1(issue, FlightControlOperations);
    then spaceport_142p(issue);
}
@source(us.irc.temporal::PL119_21_S70309, relation = formalizes, coverage = exact, quote = "(C) providing launch services and reentry services, or")
rule SpaceportLaunchServices(issue: BondIssue) strict {
    label en official "section 142(p)(1)(C)";
    when facility_at_or_near_launch_or_reentry_site_142p1(issue);
    when facility_used_for_142p1(issue, LaunchAndReentryServices);
    then spaceport_142p(issue);
}
@source(us.irc.temporal::PL119_21_S70309, relation = formalizes, coverage = exact, quote = "(D) transferring crew, spaceflight participants, or space cargo to or from spacecraft.")
rule SpaceportTransfer(issue: BondIssue) strict {
    label en official "section 142(p)(1)(D)";
    when facility_at_or_near_launch_or_reentry_site_142p1(issue);
    when facility_used_for_142p1(issue, TransferOfCrewOrCargo);
    then spaceport_142p(issue);
}
pub relation spaceport_facility_conditions_met_after_70309(issue: BondIssue) kind institutional {
    label en official "for obligations issued after the enactment date (July 4, 2025), paragraph (a)(1) covers airports and spaceports: the spaceport meets the ownership requirement of (b)(1)";
}
@source(us.irc.temporal::PL119_21_S70309, relation = formalizes, coverage = exact, quote = "(a) In General.—Section 142(a)(1) is amended to read as follows:“(1) airports and spaceports,”.")
rule SpaceportFacilityConditionsMet(issue: BondIssue, issued_on: Date) strict {
    label en official "Pub. L. 119-21 section 70309(a), (f): applies to obligations issued after the date of enactment (July 4, 2025)";
    when spaceport_142p(issue);
    when bond_issue_date_142(issue, issued_on);
    when issued_on > @2025-07-04;
    when governmental_ownership_requirement_met_142b1(issue);
    then spaceport_facility_conditions_met_after_70309(issue);
}
rule FacilityConditionsSpaceports(issue: BondIssue) strict {
    label en official "section 142(a)(1) as amended";
    when issue_net_proceeds_for_exempt_facility_use(issue, Airports, _);
    when spaceport_facility_conditions_met_after_70309(issue);
    then facility_conditions_met_142(issue, Airports);
}
