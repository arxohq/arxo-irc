// Section 129 — Dependent care assistance programs. Stage 2d (IRC-06).
// Scope: (a)(1)-(2) the exclusion and its $5,000/$2,500-if-married-filing-
// separately cap (base 2024-edition figures; the Pub. L. 119-21 §70404
// $7,500 edition is SOURCE_GAP, see header note below — same situation as
// section 127's student-loan-payment amendment), (b)(1)-(2) the earned-
// income limitation, (c) the related-dependent/under-19-child exclusion
// from eligible care recipients, (d)(1)-(4) the program-qualification
// conditions incl. the (d)(4) 25% shareholder/owner cap and the (d)(8) 55%
// average-benefits test named by the coordinator, (e)(3)-(4) "employee"
// extensions. NOT reached: (a)(2)(D) (the 2021-only $10,500 COVID-era
// figure, a closed historical window with no ongoing relevance), (d)(5)-(7),
// (9) (unfunded-plan permission, notice, reporting, and the age-21/
// collective-bargaining exclusions from the (d)(3)/(8) population), (e)(1)-
// (2),(5)-(9) (the dependent-care-assistance/earned-income cross-reference
// definitions, the section 1563 constructive-ownership rules, the onsite-
// facility valuation rule, and the identification-of-provider condition).
//
// SOURCE_GAP (Pub. L. 119-21 §70404, "Enhancement of the Dependent Care
// Assistance Program", approved 2025-07-04, `AMENDMENTS.json`-confirmed
// effective for taxable years beginning after December 31, 2025): raises
// the (a)(2)(A) dollar figures to $7,500/$3,750. Only a heuristic effective-
// date sentence is pinned, not the amendment's substituted text, so there
// is no fragment to anchor a post-2025 `@source` quote to. The rule below
// still applies the base 2024-edition $5,000/$2,500 figures unconditionally
// by taxable year (no `effective` window is written, since the amendment
// text itself — and therefore the correct boundary date's exact wording —
// is not available to formalize; a case for a taxable year beginning after
// 2025-12-31 gets the PRE-amendment, too-low cap from this rule until the
// amendment text is pinned).

// =====================================================================
// §129(a): the exclusion and its dollar cap
// =====================================================================

use self::{
    IRC_S129_A,
    IRC_S129_B,
    IRC_S129_C,
    IRC_S129_D,
    IRC_S129_E,
    Individual,
    Person,
    TaxableYear,
};

pub relation dependent_care_assistance_furnished(p: Individual, program: us.irc.core::Organ, y: TaxableYear, amount: Money) kind empirical {
    label en official "an amount paid or incurred by the employer for dependent care assistance provided to the employee, pursuant to a program described in (d) (section 129(a)(1))";
}
pub relation married_filing_separately_129(p: Individual, y: TaxableYear) kind empirical {
    label en official "the employee is married and files a separate return for the taxable year, for the (a)(2)(A) $2,500 (rather than $5,000) cap (section 129(a)(2)(A))";
}
pub relation dependent_care_dollar_limit_129a2A(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 129(a)(2)(A) dollar limitation: $5,000, or $2,500 for an employee married filing separately (2024-edition base figures)";
}
@source(IRC_S129_A, quote = "The amount which may be excluded under paragraph (1) for dependent care assistance with respect to dependent care services provided during a taxable year shall not exceed $5,000 ($2,500 in the case of a separate return by a married individual).")
rule DependentCareDollarLimitMFS(p: Individual, y: TaxableYear, b_start: Date) strict {
    label en official "section 129(a)(2)(A): the $2,500 married-filing-separately figure, for taxable years beginning before January 1, 2026 (Pub. L. 119-21 §70404 raises it to $3,750 for later years — see pl119-21-amendments.law)";
    when married_filing_separately_129(p, y);
    when us.irc.core::begins(y, b_start);
    when b_start < @2026-01-01;
    then dependent_care_dollar_limit_129a2A(p, y, 2500.00 USD);
}
@source(IRC_S129_A, quote = "The amount which may be excluded under paragraph (1) for dependent care assistance with respect to dependent care services provided during a taxable year shall not exceed $5,000 ($2,500 in the case of a separate return by a married individual).")
rule DependentCareDollarLimitGeneral(p: Individual, y: TaxableYear, b_start: Date) strict {
    label en official "section 129(a)(2)(A): the general $5,000 figure, for taxable years beginning before January 1, 2026 (Pub. L. 119-21 §70404 raises it to $7,500 for later years — see pl119-21-amendments.law)";
    when not_known(married_filing_separately_129(p, y));
    when dependent_care_assistance_furnished(p, _, y, _);
    when us.irc.core::begins(y, b_start);
    when b_start < @2026-01-01;
    then dependent_care_dollar_limit_129a2A(p, y, 5000.00 USD);
}

pub relation dependent_care_earned_income_limit_129b(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 129(b)(1) earned-income limitation: the employee's own earned income if unmarried, or the lesser of the employee's/spouse's earned income if married (section 129(b)(1)(A)-(B))";
}
relation earned_income_129(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the employee's earned income for the taxable year within the meaning of section 32(c)(2) (section 129(b)(1),(e)(2))";
}
relation spouse_earned_income_129(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the spouse's earned income for the taxable year (section 129(b)(1)(B)(ii))";
}
relation married_at_close_of_year_129(p: Individual, y: TaxableYear) kind empirical {
    label en official "the employee is married at the close of the taxable year (section 129(b)(1)(B))";
}
@source(IRC_S129_B, quote = "in the case of an employee who is not married at the close of such taxable year, the earned income of such employee for such taxable year")
rule DependentCareEarnedIncomeLimitUnmarried(p: Individual, y: TaxableYear, earned: Money) strict {
    label en official "section 129(b)(1)(A)";
    when not_known(married_at_close_of_year_129(p, y));
    when earned_income_129(p, y, earned);
    then dependent_care_earned_income_limit_129b(p, y, earned);
}
@source(IRC_S129_B, quote = "in the case of an employee who is married at the close of such taxable year, the lesser of—\n(i) the earned income of such employee for such taxable year, or\n(ii) the earned income of the spouse of such employee for such taxable year")
rule DependentCareEarnedIncomeLimitMarried(p: Individual, y: TaxableYear, earned: Money, spouse_earned: Money) strict {
    label en official "section 129(b)(1)(B)";
    when married_at_close_of_year_129(p, y);
    when earned_income_129(p, y, earned);
    when spouse_earned_income_129(p, y, spouse_earned);
    then dependent_care_earned_income_limit_129b(p, y, min(earned, spouse_earned));
}

pub relation dependent_care_assistance_excluded_129a(p: Individual, program: us.irc.core::Organ, y: TaxableYear, amount: Money) kind institutional {
    label en official "gross income does not include this amount of dependent care assistance, capped at the lesser of the (a)(2)(A) dollar limit and the (b)(1) earned-income limit (section 129(a)-(b))";
}
@source(IRC_S129_A, quote = "Gross income of an employee does not include amounts paid or incurred by the employer for dependent care assistance provided to such employee if the assistance is furnished pursuant to a program which is described in subsection (d).")
rule DependentCareAssistanceExcluded(p: Individual, program: us.irc.core::Organ, y: TaxableYear, furnished: Money, dollar_limit: Money, earned_limit: Money) strict {
    label en official "section 129(a)(1)-(2)/(b)(1): the exclusion, doubly capped";
    when dependent_care_program_qualified_129d(program, y);
    when dependent_care_assistance_furnished(p, program, y, furnished);
    when dependent_care_dollar_limit_129a2A(p, y, dollar_limit);
    when dependent_care_earned_income_limit_129b(p, y, earned_limit);
    when not_known(has_dependent_care_disqualified_breakdown_129c(p, program, y)); // G6404 wiring: §129(c) — variant below
    then dependent_care_assistance_excluded_129a(p, program, y, min(furnished, min(dollar_limit, earned_limit)));
}
// G6404 wiring, §129(c): assistance for a dependent who is claimed under §151(c) or is the employee's child under 19
// does not qualify. The case may break the furnished assistance down by dependent; the part for disqualified
// dependents (`dependent_care_recipient_disqualified_129c`) is then taken out of the furnished amount before the caps.
relation dependent_care_assistance_for_dependent_129(p: Individual, program: us.irc.core::Organ, y: TaxableYear, dependent: Individual, amount: Money) kind empirical {
    label en official "the dependent care assistance furnished under the program for the care of this dependent (section 129(c))";
}
relation has_dependent_care_disqualified_breakdown_129c(p: Individual, program: us.irc.core::Organ, y: TaxableYear) kind institutional {
    label en official "the furnished assistance is broken down by dependent for the section 129(c) test";
}
rule HasDependentCareDisqualifiedBreakdown129c(p: Individual, program: us.irc.core::Organ, y: TaxableYear, dependent: Individual, amount: Money) strict {
    when dependent_care_assistance_for_dependent_129(p, program, y, dependent, amount);
    then has_dependent_care_disqualified_breakdown_129c(p, program, y);
}
@source(IRC_S129_A, quote = "Gross income of an employee does not include amounts paid or incurred by the employer for dependent care assistance provided to such employee if the assistance is furnished pursuant to a program which is described in subsection (d).")
rule DependentCareAssistanceExcludedNetOfDisqualifiedDependents(p: Individual, program: us.irc.core::Organ, y: TaxableYear, furnished: Money, dollar_limit: Money, earned_limit: Money) strict {
    label en official "section 129(a)-(c): the exclusion, doubly capped, on the assistance for dependents that qualify";
    when dependent_care_program_qualified_129d(program, y);
    when dependent_care_assistance_furnished(p, program, y, furnished);
    when dependent_care_dollar_limit_129a2A(p, y, dollar_limit);
    when dependent_care_earned_income_limit_129b(p, y, earned_limit);
    when has_dependent_care_disqualified_breakdown_129c(p, program, y);
    then dependent_care_assistance_excluded_129a(p, program, y,
        min(max(0.00 USD, furnished - sum(collect all a: Money, d: Individual where dependent_care_assistance_for_dependent_129(p, program, y, d, a) and dependent_care_recipient_disqualified_129c(p, d, y), empty: 0.00 USD)), min(dollar_limit, earned_limit)));
}

// =====================================================================
// §129(c): related-dependent / under-19-child exclusion from eligible care
// =====================================================================

pub relation dependent_care_recipient_disqualified_129c(p: Individual, dependent: Individual, y: TaxableYear) kind institutional {
    label en official "assistance for care of this dependent does not qualify for the (a) exclusion — the dependent is claimed under section 151(c) by the employee/spouse, or is the employee's child under 19 (section 129(c)(1)-(2))";
}
relation dependent_claimed_under_151c(p: Individual, dependent: Individual, y: TaxableYear) kind empirical {
    label en official "a section 151(c) personal-exemption deduction is allowable for this dependent to the employee or the employee's spouse for the taxable year (section 129(c)(1))";
}
@source(IRC_S129_C, quote = "with respect to whom, for such taxable year, a deduction is allowable under section 151(c) (relating to personal exemptions for dependents) to such employee or the spouse of such employee, or")
rule DependentCareRecipientDisqualifiedClaimedDependent(p: Individual, dependent: Individual, y: TaxableYear) strict {
    label en official "section 129(c)(1)";
    when dependent_claimed_under_151c(p, dependent, y);
    then dependent_care_recipient_disqualified_129c(p, dependent, y);
}
relation dependent_child_under_19_152f1(p: Individual, dependent: Individual, y: TaxableYear) kind empirical {
    label en official "the dependent is a child of the employee (within the meaning of section 152(f)(1)) under age 19 at the close of the taxable year (section 129(c)(2))";
}
@source(IRC_S129_C, quote = "who is a child of such employee (within the meaning of section 152(f)(1)) under the age of 19 at the close of such taxable year")
rule DependentCareRecipientDisqualifiedChildUnder19(p: Individual, dependent: Individual, y: TaxableYear) strict {
    label en official "section 129(c)(2)";
    when dependent_child_under_19_152f1(p, dependent, y);
    then dependent_care_recipient_disqualified_129c(p, dependent, y);
}

// =====================================================================
// §129(d): dependent care assistance program qualification
// =====================================================================

pub relation dependent_care_program_written_129d1(program: us.irc.core::Organ, employer: Person) kind empirical {
    label en official "a separate written plan of the employer for the exclusive benefit of employees, to provide dependent care assistance (section 129(d)(1))";
}
relation dependent_care_program_discriminates_in_favor_of_hce_129d2(program: us.irc.core::Organ, y: TaxableYear) kind empirical {
    label en official "the contributions or benefits under the plan discriminate in favor of highly compensated employees or their dependents (section 129(d)(2))";
}
relation dependent_care_program_classification_nondiscriminatory_129d3(program: us.irc.core::Organ, y: TaxableYear) kind empirical {
    label en official "the program benefits employees under a classification found by the Secretary not to discriminate in favor of highly compensated employees or their dependents (section 129(d)(3))";
}
relation shareholder_owner_class_share_129d4(program: us.irc.core::Organ, y: TaxableYear, fraction: Decimal) kind empirical {
    label en official "the fraction of amounts paid or incurred for dependent care assistance during the year provided to the class of 5%-or-more shareholders/owners (or spouses/dependents) (section 129(d)(4))";
}
relation dependent_care_average_benefits_test_129d8(program: us.irc.core::Organ, y: TaxableYear, ratio: Decimal) kind empirical {
    label en official "the ratio of average benefits provided to non-highly-compensated employees under all of the employer's plans, to average benefits provided to highly compensated employees (section 129(d)(8)(A))";
}
pub relation dependent_care_program_qualified_129d(program: us.irc.core::Organ, y: TaxableYear) kind institutional {
    label en official "the program is a dependent care assistance program within the meaning of section 129(d)";
}
@source(IRC_S129_D, quote = "A plan meets the requirements of this paragraph if the average benefits provided to employees who are not highly compensated employees under all plans of the employer is at least 55 percent of the average benefits provided to highly compensated employees under all plans of the employer.")
rule DependentCareProgramQualified(program: us.irc.core::Organ, employer: Person, y: TaxableYear, fraction: Decimal, ratio: Decimal) strict {
    label en official "section 129(d)(1)-(4),(8): the written-plan, nondiscriminatory-contributions/classification, 25%-owner-cap, and 55%-average-benefits conditions";
    when dependent_care_program_written_129d1(program, employer);
    when not_known(dependent_care_program_discriminates_in_favor_of_hce_129d2(program, y));
    when dependent_care_program_classification_nondiscriminatory_129d3(program, y);
    when shareholder_owner_class_share_129d4(program, y, fraction);
    when fraction <= 0.25;
    when dependent_care_average_benefits_test_129d8(program, y, ratio);
    when ratio >= 0.55;
    then dependent_care_program_qualified_129d(program, y);
}

// =====================================================================
// §129(e)(3)-(4): "employee" extensions
// =====================================================================

relation self_employed_401c1_129(p: Individual) kind empirical {
    label en official "the individual is an employee within the meaning of section 401(c)(1) (section 129(e)(3)) — a local relation distinct from section 127's identically-worded (c)(2) fact, to avoid a cross-file dependency inside this multi-file package";
}
pub relation self_employed_treated_as_employee_129e3(p: Individual) kind institutional {
    label en official "an individual who is an employee within the meaning of section 401(c)(1) is an employee for section 129 purposes (section 129(e)(3))";
}
@source(IRC_S129_E, quote = "The term \"employee\" includes, for any year, an individual who is an employee within the meaning of section 401(c)(1) (relating to self-employed individuals).")
rule SelfEmployedTreatedAsEmployee129(p: Individual) strict {
    label en official "section 129(e)(3)";
    when self_employed_401c1_129(p);
    then self_employed_treated_as_employee_129e3(p);
}

relation owns_entire_interest_unincorporated_business_129(p: Individual) kind empirical {
    label en official "the individual owns the entire interest in an unincorporated trade or business (section 129(e)(4)) — a local relation, see note above";
}
pub relation sole_proprietor_treated_as_own_employer_129e4(p: Individual) kind institutional {
    label en official "an individual who owns the entire interest in an unincorporated trade or business is treated as the individual's own employer (section 129(e)(4))";
}
@source(IRC_S129_E, quote = "An individual who owns the entire interest in an unincorporated trade or business shall be treated as his own employer.")
rule SoleProprietorOwnEmployer129(p: Individual) strict {
    label en official "section 129(e)(4), first sentence";
    when owns_entire_interest_unincorporated_business_129(p);
    then sole_proprietor_treated_as_own_employer_129e4(p);
}
