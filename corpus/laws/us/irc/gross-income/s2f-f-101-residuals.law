// Stage 2f (TECH_GAP reduction) — §101(c), (d), (f), (h), (i).
// STATUS: implemented_unverified (static check only; scenarios in tests/s2f-f-101-residuals.lawtest
// are NOT executed).
//
// Judgment calls recorded in the coverage rows: the "at any time" tests of (f)(1) are read over
// the test points the case names (a contract year each); the guideline premiums and the net
// single premium are inputs (they are actuarial computations with the mortality tables of the
// Secretary, external); HALF_UP rounding for the proration of (d)(1).

use self::{
    IRC_S101_C,
    IRC_S101_D,
    IRC_S101_F,
    IRC_S101_H,
    IRC_S101_I,
    Individual,
    Secretary,
    TaxableYear,
};

// (c): interest on proceeds held
relation proceeds_held_under_interest_agreement_101c(p: Individual, contract: us.irc.core::Asset, y: TaxableYear, interest_paid: Money) kind empirical {
    label en official "an amount excluded by subsection (a) is held under an agreement to pay interest thereon, and the interest paid in the year";
}
pub relation interest_on_held_proceeds_included_101c(p: Individual, contract: us.irc.core::Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the interest payments are included in gross income";
}
@source(IRC_S101_C, relation = formalizes, coverage = exact, quote = "If any amount excluded from gross income by subsection (a) is held under an agreement to pay interest thereon, the interest payments shall be included in gross income.")
rule InterestOnHeldProceedsIncluded(p: Individual, contract: us.irc.core::Asset, y: TaxableYear, interest: Money) strict {
    label en official "section 101(c)";
    when proceeds_held_under_interest_agreement_101c(p, contract, y, interest);
    then interest_on_held_proceeds_included_101c(p, contract, y, interest);
}

relation held_at_interest_101c(p: Individual, contract: us.irc.core::Asset, y: TaxableYear) kind institutional {
    label en official "helper: the amount is held under an agreement to pay interest";
}
rule HeldAtInterest101c(p: Individual, contract: us.irc.core::Asset, y: TaxableYear, interest: Money) strict {
    label en official "helper for section 101(d)(3)";
    when proceeds_held_under_interest_agreement_101c(p, contract, y, interest);
    then held_at_interest_101c(p, contract, y);
}

// (d): payment of the proceeds in installments
relation amount_held_by_insurer_facts_101d2(p: Individual, contract: us.irc.core::Asset, held_under_agreement_in_contract: Boolean, payable_after_death_of_insured: Boolean, value_at_death_discounted_at_insurer_rate_and_mortality: Money) kind empirical {
    label en official "an amount to which subsection (a) applies is held by an insurer under an agreement provided for in the life insurance contract, whether as an option or otherwise, to pay it on a date or dates later than the death of the insured, and its value to the beneficiary as of the date of death (as if any option were exercised then), discounted at the insurer's interest rate and the Secretary's mortality tables (the discounting is an input)";
}
pub relation amount_held_by_insurer_101d2(p: Individual, contract: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the amount held by the insurer with respect to the beneficiary";
}
@source(IRC_S101_D, relation = formalizes, coverage = exact, quote = "(A) held by any insurer under an agreement provided for in the life insurance contract, whether as an option or otherwise, to pay such amount on a date or dates later")
rule AmountHeldByInsurerDefined(p: Individual, contract: us.irc.core::Asset, value: Money) strict {
    label en official "section 101(d)(2)(A)-(B)";
    when amount_held_by_insurer_facts_101d2(p, contract, true, true, value);
    then amount_held_by_insurer_101d2(p, contract, value);
}
relation installment_payment_101d(p: Individual, contract: us.irc.core::Asset, y: TaxableYear, payment: Money, number_of_payment_years: Integer) kind empirical {
    label en official "the payment received in the year and the number of years (taxable years) over which the payments are to be made under the agreement";
}
pub relation installment_excluded_101d1(p: Individual, contract: us.irc.core::Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the part of the payment excluded: the amount held prorated over the period of the payments, not above the payment";
}
@source(IRC_S101_D, relation = formalizes, coverage = exact, quote = "The amounts held by an insurer with respect to any beneficiary shall be prorated (in accordance with such regulations as may be prescribed by the Secretary) over the")
rule InstallmentExcluded(p: Individual, contract: us.irc.core::Asset, y: TaxableYear, pay: Money, n: Integer, held: Money) strict {
    label en official "section 101(d)(1), first sentence: proration by equal parts over the period, one rounding to cents HALF_UP; not applicable to interest amounts (d)(3)";
    when installment_payment_101d(p, contract, y, pay, n);
    when amount_held_by_insurer_101d2(p, contract, held);
    when n > 0;
    when not_known(held_at_interest_101c(p, contract, y));
    then installment_excluded_101d1(p, contract, y, min(pay, div_round(held, n * 1.0, 2, "HALF_UP")));
}
pub relation installment_included_101d1(p: Individual, contract: us.irc.core::Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the excess of the amounts payable over the amounts excluded is included in gross income";
}
@source(IRC_S101_D, relation = formalizes, coverage = exact, quote = "The amounts held by an insurer with respect to any beneficiary shall be prorated (in accordance with such regulations as may be prescribed by the Secretary) over the")
rule InstallmentExcessIncluded(p: Individual, contract: us.irc.core::Asset, y: TaxableYear, pay: Money, n: Integer, excluded: Money) strict {
    label en official "section 101(d)(1), the closing words";
    when installment_payment_101d(p, contract, y, pay, n);
    when installment_excluded_101d1(p, contract, y, excluded);
    then installment_included_101d1(p, contract, y, pay - excluded);
}
@source(IRC_S101_D, relation = formalizes, coverage = exact, quote = "This subsection shall not apply to any amount to which subsection (c) is applicable.")
rule InstallmentSubsectionDoesNotApplyToInterestAmounts(p: Individual, contract: us.irc.core::Asset, y: TaxableYear, interest: Money, pay: Money, n: Integer) strict {
    label en official "section 101(d)(3): subsection (c) governs the amount held under an agreement to pay interest; the whole payment is then interest included under (c)";
    when proceeds_held_under_interest_agreement_101c(p, contract, y, interest);
    when installment_payment_101d(p, contract, y, pay, n);
    then installment_included_101d1(p, contract, y, pay);
}

// (f): flexible premium contracts issued before 1985
relation flexible_contract_facts_101f3A(contract: us.irc.core::Asset, premium_timing_fixed_by_insurer: Boolean, premium_amount_fixed_by_insurer: Boolean, issued_before_1985: Boolean) kind empirical {
    label en official "whether the insurer fixes the timing and the amount of the premiums, and whether the contract was issued before January 1, 1985";
}
pub relation flexible_premium_contract_101f3A(contract: us.irc.core::Asset) kind institutional {
    label en official "a flexible premium life insurance contract: one or more premiums are not fixed by the insurer as to both timing and amount";
}
@source(IRC_S101_F, relation = formalizes, coverage = exact, quote = "The terms \"flexible premium life insurance contract\" and \"contract\" mean a life insurance contract (including any qualified additional benefits) which provides for the")
rule FlexiblePremiumByTiming(contract: us.irc.core::Asset, amount_fixed: Boolean, pre: Boolean) strict {
    label en official "section 101(f)(3)(A): the timing is not fixed";
    when flexible_contract_facts_101f3A(contract, false, amount_fixed, pre);
    then flexible_premium_contract_101f3A(contract);
}
@source(IRC_S101_F, relation = formalizes, coverage = exact, quote = "The terms \"flexible premium life insurance contract\" and \"contract\" mean a life insurance contract (including any qualified additional benefits) which provides for the")
rule FlexiblePremiumByAmount(contract: us.irc.core::Asset, timing_fixed: Boolean, pre: Boolean) strict {
    label en official "section 101(f)(3)(A): the amount is not fixed";
    when flexible_contract_facts_101f3A(contract, timing_fixed, false, pre);
    then flexible_premium_contract_101f3A(contract);
}
pub relation applicable_percentage_101f3C(age: Integer, percentage: Decimal) kind institutional {
    label en official "the applicable percentage: 140 percent for an attained age at the beginning of the contract year of 40 or less; above 40, 140 percent reduced (not below 105 percent) by one percent for each year in excess of 40";
}
@source(IRC_S101_F, relation = formalizes, coverage = exact, quote = "(i) 140 percent in the case of an insured with an attained age at the beginning of the contract year of 40 or less, and")
rule ApplicablePercentageAge40OrLess(age: Integer) strict {
    label en official "section 101(f)(3)(C)(i)";
    when insured_age_101f(age);
    when age <= 40;
    then applicable_percentage_101f3C(age, 1.40);
}
relation insured_age_101f(age: Integer) kind empirical {
    label en official "an attained age of the insured at the beginning of a contract year, for which the applicable percentage is asked";
}
@source(IRC_S101_F, relation = formalizes, coverage = exact, quote = "(ii) in the case of an insured with an attained age of more than 40 as of the beginning of the contract year, 140 percent reduced (but not below 105 percent) by one")
rule ApplicablePercentageAbove40(age: Integer) strict {
    label en official "section 101(f)(3)(C)(ii)";
    when insured_age_101f(age);
    when age > 40;
    then applicable_percentage_101f3C(age, max(1.05, 1.40 - (age - 40) * 0.01));
}
pub relation guideline_single_premium_rate_101f2B(guaranteed_minimum_rate: Decimal, rate: Decimal) kind institutional {
    label en official "the interest of the guideline single premium: the greater of an annual effective rate of 6 percent and the minimum rate guaranteed upon issue";
}
@source(IRC_S101_F, relation = formalizes, coverage = exact, quote = "(ii) interest at the greater of an annual effective rate of 6 percent or the minimum rate or rates guaranteed upon issue of the contract.")
rule GuidelineSinglePremiumRate(guaranteed: Decimal) strict {
    label en official "section 101(f)(2)(B)(ii)";
    when guaranteed_minimum_interest_rate_101f(guaranteed);
    then guideline_single_premium_rate_101f2B(guaranteed, max(0.06, guaranteed));
}
relation guaranteed_minimum_interest_rate_101f(rate: Decimal) kind empirical {
    label en official "the minimum interest rate guaranteed upon the issue of the contract";
}
relation contract_issue_date_101f3G(contract: us.irc.core::Asset, issued_on: Date, guaranteed_minimum_rate: Decimal) kind empirical {
    label en official "the issue date and the minimum rate guaranteed upon issue";
}
pub relation net_single_premium_rate_101f3G(contract: us.irc.core::Asset, rate: Decimal) kind institutional {
    label en official "the interest for the net single premium: the greater of an annual effective rate of 4 percent (3 percent for contracts issued before July 1, 1983) and the minimum rate guaranteed upon issue";
}
@source(IRC_S101_F, relation = formalizes, coverage = exact, quote = "(I) an annual effective rate of 4 percent (3 percent for contracts issued before July 1, 1983), or")
rule NetSinglePremiumRateBefore1983(contract: us.irc.core::Asset, issued: Date, guaranteed: Decimal) strict {
    label en official "section 101(f)(3)(G)(ii)(I): 3 percent before July 1, 1983";
    when contract_issue_date_101f3G(contract, issued, guaranteed);
    when issued < @1983-07-01;
    then net_single_premium_rate_101f3G(contract, max(0.03, guaranteed));
}
@source(IRC_S101_F, relation = formalizes, coverage = exact, quote = "(I) an annual effective rate of 4 percent (3 percent for contracts issued before July 1, 1983), or")
rule NetSinglePremiumRateFrom1983(contract: us.irc.core::Asset, issued: Date, guaranteed: Decimal) strict {
    label en official "section 101(f)(3)(G)(ii)(I): 4 percent from July 1, 1983";
    when contract_issue_date_101f3G(contract, issued, guaranteed);
    when issued >= @1983-07-01;
    then net_single_premium_rate_101f3G(contract, max(0.04, guaranteed));
}
relation maturity_facts_101f2D(contract: us.irc.core::Asset, issued_on: Date, latest_maturity_permitted_by_contract: Date, insured_age_95_date: Date) kind empirical {
    label en official "the issue date, the latest maturity date permitted under the contract, and the date the insured attains age 95";
}
pub relation guideline_maturity_date_101f2Dii(contract: us.irc.core::Asset, maturity: Date) kind institutional {
    label en official "the maturity date for the guideline computations: the latest permitted, but not less than 20 years after issue or (if earlier) age 95";
}
@source(IRC_S101_F, relation = formalizes, coverage = exact, quote = "(ii) the maturity date shall be the latest maturity date permitted under the contract, but not less than 20 years after the date of issue or (if earlier) age 95, and")
rule GuidelineMaturityDate(contract: us.irc.core::Asset, issued: Date, latest: Date, age95: Date) strict {
    label en official "section 101(f)(2)(D)(ii)";
    when maturity_facts_101f2D(contract, issued, latest, age95);
    then guideline_maturity_date_101f2Dii(contract, max(latest, min(add_calendar_period(issued, 20 calendar_year), age95)));
}
pub relation net_single_premium_maturity_date_101f3Giii(contract: us.irc.core::Asset, maturity: Date) kind institutional {
    label en official "for the net single premium the maturity date is not earlier than age 95";
}
@source(IRC_S101_F, relation = formalizes, coverage = exact, quote = "(iii) the computational rules of paragraph (2)(D) shall apply, except that the maturity date referred to in clause (ii) thereof shall not be earlier than age 95.")
rule NetSinglePremiumMaturityDate(contract: us.irc.core::Asset, issued: Date, latest: Date, age95: Date) strict {
    label en official "section 101(f)(3)(G)(iii): the (2)(D)(ii) date, not earlier than age 95";
    when maturity_facts_101f2D(contract, issued, latest, age95);
    then net_single_premium_maturity_date_101f3Giii(contract, max(max(latest, min(add_calendar_period(issued, 20 calendar_year), age95)), age95));
}
relation death_benefit_and_cash_value_at_issue_101f2Di(contract: us.irc.core::Asset, excess_now: Money, excess_at_issue: Money) kind empirical {
    label en official "the excess of the death benefit over the cash value now and at issue";
}
pub relation deemed_death_benefit_excess_101f2Di(contract: us.irc.core::Asset, excess: Money) kind institutional {
    label en official "in computing the guideline premiums the excess of the death benefit over the cash value is deemed not greater than such excess at the time of issue";
}
@source(IRC_S101_F, relation = formalizes, coverage = exact, quote = "(i) the excess of the amount payable by reason of the death of the insured (determined without regard to any qualified additional benefit) over the cash value of the")
rule DeemedDeathBenefitExcess(contract: us.irc.core::Asset, now: Money, at_issue: Money) strict {
    label en official "section 101(f)(2)(D)(i)";
    when death_benefit_and_cash_value_at_issue_101f2Di(contract, now, at_issue);
    then deemed_death_benefit_excess_101f2Di(contract, min(now, at_issue));
}
relation endowment_benefit_facts_101f2Diii(contract: us.irc.core::Asset, endowment_benefits_sum: Money, least_death_benefit_payable: Money) kind empirical {
    label en official "the endowment benefit (or sum of endowment benefits) and the least amount payable by reason of the death of the insured at any time (without regard to any qualified additional benefit)";
}
pub relation deemed_endowment_benefit_101f2Diii(contract: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the endowment benefit is deemed not to exceed the least amount payable by reason of death";
}
@source(IRC_S101_F, relation = formalizes, coverage = exact, quote = "(iii) the amount of any endowment benefit (or sum of endowment benefits) shall be deemed not to exceed the least amount payable by reason of the death of the insured")
rule DeemedEndowmentBenefit(contract: us.irc.core::Asset, endow: Money, least: Money) strict {
    label en official "section 101(f)(2)(D)(iii)";
    when endowment_benefit_facts_101f2Diii(contract, endow, least);
    then deemed_endowment_benefit_101f2Diii(contract, min(endow, least));
}

// (f)(1) test points
relation flexible_contract_test_point_101f(contract: us.irc.core::Asset, point: Integer, premiums_paid_gross: Money, amounts_under_72e_not_includible: Money, returned_premium_principal: Money, premium_disregarded_to_prevent_lapse_101f3F: Money, guideline_single_premium: Money, sum_of_guideline_level_premiums: Money, death_benefit: Money, cash_value_before_surrender_charge_and_loans: Money, attained_age: Integer, net_single_premium: Money) kind empirical {
    label en official "the contract's figures at a test point (a contract year): the premiums paid, amounts to which section 72(e) applies (not includible), premium principal returned under (3)(B), a premium disregarded under (3)(F), the guideline single premium, the sum of the guideline level premiums to the date, the death benefit and cash value (both without qualified additional benefits and, for the cash value, without regard to any surrender charge or policy loan, section 101(f)(3)(D)), the insured's attained age at the beginning of the year, and the net single premium";
}
pub relation premiums_paid_net_101f3B(contract: us.irc.core::Asset, point: Integer, amount: Money) kind institutional {
    label en official "premiums paid: the premiums paid less the amounts (not includible in gross income) to which section 72(e) applies, less premium principal returned to comply with (1)(A) and any premium disregarded under (3)(F)";
}
@source(IRC_S101_F, relation = formalizes, coverage = exact, quote = "The term \"premiums paid\" means the premiums paid under the contract less any amounts (other than amounts includible in gross income) to which section 72(e) applies. If,")
rule PremiumsPaidNet(contract: us.irc.core::Asset, point: Integer, gross: Money, e72: Money, returned: Money, disregarded: Money, g: Money, l: Money, d: Money, c: Money, age: Integer, n: Money) strict {
    label en official "section 101(f)(3)(B) and (F)";
    when flexible_contract_test_point_101f(contract, point, gross, e72, returned, disregarded, g, l, d, c, age, n);
    then premiums_paid_net_101f3B(contract, point, max(0.00 USD, gross - e72 - returned - disregarded));
}
pub relation returned_premium_interest_includible_101f3Bii(contract: us.irc.core::Asset, recipient: Individual, amount: Money) kind institutional {
    label en official "notwithstanding section 72(e), the interest returned with premium is includible in the gross income of the recipient";
}
relation returned_premium_interest_101f3B(contract: us.irc.core::Asset, recipient: Individual, interest: Money) kind empirical {
    label en official "interest returned to the recipient with a premium portion returned to comply with paragraph (1)(A)";
}
@source(IRC_S101_F, relation = formalizes, coverage = exact, quote = "(ii) notwithstanding the provisions of section 72(e), the amount of any interest so returned shall be includible in the gross income of the recipient.")
rule ReturnedPremiumInterestIncludible(contract: us.irc.core::Asset, recipient: Individual, interest: Money) strict {
    label en official "section 101(f)(3)(B)(ii)";
    when returned_premium_interest_101f3B(contract, recipient, interest);
    then returned_premium_interest_includible_101f3Bii(contract, recipient, interest);
}
pub relation guideline_premium_limitation_101f2A(contract: us.irc.core::Asset, point: Integer, amount: Money) kind institutional {
    label en official "the guideline premium limitation: the greater of the guideline single premium and the sum of the guideline level premiums to the date";
}
@source(IRC_S101_F, relation = formalizes, coverage = exact, quote = "The term \"guideline premium limitation\" means, as of any date, the greater of—")
rule GuidelinePremiumLimitation(contract: us.irc.core::Asset, point: Integer, gross: Money, e72: Money, returned: Money, disregarded: Money, g: Money, l: Money, d: Money, c: Money, age: Integer, n: Money) strict {
    label en official "section 101(f)(2)(A)(i)-(ii)";
    when flexible_contract_test_point_101f(contract, point, gross, e72, returned, disregarded, g, l, d, c, age, n);
    then guideline_premium_limitation_101f2A(contract, point, max(g, l));
}
pub relation test_a_fails_at_point_101f1A(contract: us.irc.core::Asset, point: Integer) kind institutional {
    label en official "at the test point the premiums exceed the guideline premium limitation, or the death benefit is less than the applicable percentage of the cash value";
}
@source(IRC_S101_F, relation = formalizes, coverage = exact, quote = "(i) the sum of the premiums paid under such contract does not at any time exceed the guideline premium limitation as of such time, and")
rule TestAFailsOnPremiums(contract: us.irc.core::Asset, point: Integer, paid: Money, limit: Money) strict {
    label en official "section 101(f)(1)(A)(i)";
    when premiums_paid_net_101f3B(contract, point, paid);
    when guideline_premium_limitation_101f2A(contract, point, limit);
    when paid > limit;
    then test_a_fails_at_point_101f1A(contract, point);
}
@source(IRC_S101_F, relation = formalizes, coverage = exact, quote = "(ii) any amount payable by reason of the death of the insured (determined without regard to any qualified additional benefit) is not at any time less than the applicable")
rule TestAFailsOnDeathBenefit(contract: us.irc.core::Asset, point: Integer, gross: Money, e72: Money, returned: Money, disregarded: Money, g: Money, l: Money, d: Money, c: Money, age: Integer, n: Money, pct: Decimal) strict {
    label en official "section 101(f)(1)(A)(ii): the death benefit is less than the applicable percentage of the cash value";
    when flexible_contract_test_point_101f(contract, point, gross, e72, returned, disregarded, g, l, d, c, age, n);
    when applicable_percentage_101f3C(age, pct);
    when d < round(c * pct, 2, "HALF_UP");
    then test_a_fails_at_point_101f1A(contract, point);
}
pub relation test_b_fails_at_point_101f1B(contract: us.irc.core::Asset, point: Integer) kind institutional {
    label en official "at the test point the cash value exceeds the net single premium";
}
@source(IRC_S101_F, relation = formalizes, coverage = exact, quote = "(B) by the terms of such contract, the cash value of such contract may not at any time exceed the net single premium with respect to the amount payable by reason of the")
rule TestBFailsOnCashValue(contract: us.irc.core::Asset, point: Integer, gross: Money, e72: Money, returned: Money, disregarded: Money, g: Money, l: Money, d: Money, c: Money, age: Integer, n: Money) strict {
    label en official "section 101(f)(1)(B)";
    when flexible_contract_test_point_101f(contract, point, gross, e72, returned, disregarded, g, l, d, c, age, n);
    when c > n;
    then test_b_fails_at_point_101f1B(contract, point);
}
pub relation flexible_contract_meets_test_a_101f1A(contract: us.irc.core::Asset) kind institutional {
    label en official "test (A) is met at every test point named";
}
@source(IRC_S101_F, relation = formalizes, coverage = exact, quote = "(A) under such contract—")
rule FlexibleContractMeetsTestA(contract: us.irc.core::Asset, point: Integer, gross: Money, e72: Money, returned: Money, disregarded: Money, g: Money, l: Money, d: Money, c: Money, age: Integer, n: Money) strict {
    label en official "section 101(f)(1)(A): universal over the named test points";
    when flexible_contract_test_point_101f(contract, point, gross, e72, returned, disregarded, g, l, d, c, age, n);
    when not_known(contract_fails_test_a_somewhere_101f(contract));
    then flexible_contract_meets_test_a_101f1A(contract);
}
pub relation contract_fails_test_a_somewhere_101f(contract: us.irc.core::Asset) kind institutional {
    label en official "helper: test (A) fails at some test point";
}
rule ContractFailsTestASomewhere(contract: us.irc.core::Asset, point: Integer) strict {
    label en official "helper for section 101(f)(1)(A)";
    when test_a_fails_at_point_101f1A(contract, point);
    then contract_fails_test_a_somewhere_101f(contract);
}
pub relation flexible_contract_meets_test_b_101f1B(contract: us.irc.core::Asset) kind institutional {
    label en official "test (B) is met at every test point named";
}
@source(IRC_S101_F, relation = formalizes, coverage = exact, quote = "(B) by the terms of such contract, the cash value of such contract may not at any time exceed the net single premium with respect to the amount payable by reason of the")
rule FlexibleContractMeetsTestB(contract: us.irc.core::Asset, point: Integer, gross: Money, e72: Money, returned: Money, disregarded: Money, g: Money, l: Money, d: Money, c: Money, age: Integer, n: Money) strict {
    label en official "section 101(f)(1)(B): universal over the named test points";
    when flexible_contract_test_point_101f(contract, point, gross, e72, returned, disregarded, g, l, d, c, age, n);
    when not_known(contract_fails_test_b_somewhere_101f(contract));
    then flexible_contract_meets_test_b_101f1B(contract);
}
pub relation contract_fails_test_b_somewhere_101f(contract: us.irc.core::Asset) kind institutional {
    label en official "helper: test (B) fails at some test point";
}
rule ContractFailsTestBSomewhere(contract: us.irc.core::Asset, point: Integer) strict {
    label en official "helper for section 101(f)(1)(B)";
    when test_b_fails_at_point_101f1B(contract, point);
    then contract_fails_test_b_somewhere_101f(contract);
}
relation waiver_facts_101f3H(contract: us.irc.core::Asset, requirement_not_satisfied_due_to_reasonable_error: Boolean, reasonable_steps_being_taken: Boolean) kind empirical {
    label en official "the requirements of paragraph (1) for a contract year were not satisfied due to reasonable error, and reasonable steps are being taken to remedy the error";
}
relation secretary_waives_failure_101f3H(contract: us.irc.core::Asset) kind empirical {
    label en official "the Secretary waives the failure to satisfy the requirements";
}
pub relation failure_waived_101f3H(contract: us.irc.core::Asset) kind institutional {
    label en official "the failure to satisfy the requirements of paragraph (1) is waived";
}
@source(IRC_S101_F, relation = formalizes, coverage = exact, quote = "If the taxpayer establishes to the satisfaction of the Secretary that—")
rule Section101f3hWaiverRule defeasible {
    for contract: us.irc.core::Asset;
    when waiver_facts_101f3H(contract, true, true);
    then power Section101f3hWaiver {
        holder Secretary;
        over contract;
        exercise secretary_waives_failure_101f3H(contract);
        valid_when waiver_facts_101f3H(contract, true, true);
        effect create(failure_waived_101f3H(contract));
        window [-infinity, infinity];
    };
}
pub relation flexible_contract_death_benefit_excludable_101f1(contract: us.irc.core::Asset) kind institutional {
    label en official "the amount paid by reason of death under a flexible premium contract issued before 1985 is excludable only if test (A) or test (B) is met (or the failure is waived)";
}
@source(IRC_S101_F, relation = formalizes, coverage = exact, quote = "Any amount paid by reason of the death of the insured under a flexible premium life insurance contract issued before January 1, 1985 shall be excluded from gross income")
rule FlexibleContractExcludableByTestA(contract: us.irc.core::Asset, timing: Boolean, amount: Boolean) strict {
    label en official "section 101(f)(1)(A)";
    when flexible_contract_facts_101f3A(contract, timing, amount, true);
    when flexible_premium_contract_101f3A(contract);
    when flexible_contract_meets_test_a_101f1A(contract);
    then flexible_contract_death_benefit_excludable_101f1(contract);
}
@source(IRC_S101_F, relation = formalizes, coverage = exact, quote = "(B) by the terms of such contract, the cash value of such contract may not at any time exceed the net single premium with respect to the amount payable by reason of the")
rule FlexibleContractExcludableByTestB(contract: us.irc.core::Asset, timing: Boolean, amount: Boolean) strict {
    label en official "section 101(f)(1)(B)";
    when flexible_contract_facts_101f3A(contract, timing, amount, true);
    when flexible_premium_contract_101f3A(contract);
    when flexible_contract_meets_test_b_101f1B(contract);
    then flexible_contract_death_benefit_excludable_101f1(contract);
}
@source(IRC_S101_F, relation = formalizes, coverage = exact, quote = "the Secretary may waive the failure to satisfy such requirements.")
rule FlexibleContractExcludableByWaiver(contract: us.irc.core::Asset, timing: Boolean, amount: Boolean) strict {
    label en official "section 101(f)(3)(H)";
    when flexible_contract_facts_101f3A(contract, timing, amount, true);
    when flexible_premium_contract_101f3A(contract);
    when failure_waived_101f3H(contract);
    then flexible_contract_death_benefit_excludable_101f1(contract);
}
pub enum QualifiedAdditionalBenefit101f3E { GuaranteedInsurability; AccidentalDeathBenefit; FamilyTermCoverage; WaiverOfPremium; OtherBenefit; }
relation additional_benefit_101f3E(contract: us.irc.core::Asset, benefit: QualifiedAdditionalBenefit101f3E) kind empirical {
    label en official "the contract carries the additional benefit";
}
pub relation qualified_additional_benefit_101f3E(contract: us.irc.core::Asset, benefit: QualifiedAdditionalBenefit101f3E) kind institutional {
    label en official "a qualified additional benefit: guaranteed insurability, accidental death benefit, family term coverage, or waiver of premium";
}
@source(IRC_S101_F, relation = formalizes, coverage = exact, quote = "(i) guaranteed insurability,")
rule QualifiedAdditionalBenefitDefined(contract: us.irc.core::Asset, benefit: QualifiedAdditionalBenefit101f3E) strict {
    label en official "section 101(f)(3)(E)(i)-(iv)";
    when additional_benefit_101f3E(contract, benefit);
    when benefit != OtherBenefit;
    then qualified_additional_benefit_101f3E(contract, benefit);
}

// (h): survivor annuities of public safety officers
relation public_safety_survivor_annuity_101h(p: Individual, y: TaxableYear, amount_paid: Money, amount_attributable_to_service_as_public_safety_officer: Money, paid_under_governmental_plan_meeting_401a: Boolean, recipient_is_spouse_former_spouse_or_child: Boolean) kind empirical {
    label en official "a survivor annuity paid on account of the death of a public safety officer (section 1204 of the Omnibus Crime Control and Safe Streets Act of 1968, external), the amount attributable to the officer's service as a public safety officer, whether it is provided under a governmental plan meeting section 401(a), and whether it is paid to the spouse (or a former spouse) or a child of the officer";
}
relation public_safety_officer_death_bar_101h2(p: Individual, y: TaxableYear, intentional_misconduct_or_intent_to_die: Boolean, voluntarily_intoxicated: Boolean, grossly_negligent_in_duties: Boolean, recipient_a_substantial_contributing_factor: Boolean) kind empirical {
    label en official "as determined under the Omnibus Crime Control and Safe Streets Act of 1968: the death was caused by the officer's intentional misconduct or intent to die, the officer was voluntarily intoxicated, the officer was performing duties in a grossly negligent manner, or the payee's actions were a substantial contributing factor to the death";
}
pub relation public_safety_survivor_annuity_barred_101h2(p: Individual, y: TaxableYear) kind institutional {
    label en official "paragraph (1) does not apply to the death of the officer";
}
@source(IRC_S101_H, relation = formalizes, coverage = exact, quote = "(A) the death was caused by the intentional misconduct of the officer or by such officer's intention to bring about such officer's death;")
rule SurvivorAnnuityBarredByMisconduct(p: Individual, y: TaxableYear, b: Boolean, c: Boolean, d: Boolean) strict {
    label en official "section 101(h)(2)(A)";
    when public_safety_officer_death_bar_101h2(p, y, true, b, c, d);
    then public_safety_survivor_annuity_barred_101h2(p, y);
}
@source(IRC_S101_H, relation = formalizes, coverage = exact, quote = "(B) the officer was voluntarily intoxicated (as defined in section 1204 of such Act) at the time of death;")
rule SurvivorAnnuityBarredByIntoxication(p: Individual, y: TaxableYear, a: Boolean, c: Boolean, d: Boolean) strict {
    label en official "section 101(h)(2)(B)";
    when public_safety_officer_death_bar_101h2(p, y, a, true, c, d);
    then public_safety_survivor_annuity_barred_101h2(p, y);
}
@source(IRC_S101_H, relation = formalizes, coverage = exact, quote = "(C) the officer was performing such officer's duties in a grossly negligent manner at the time of death; or")
rule SurvivorAnnuityBarredByGrossNegligence(p: Individual, y: TaxableYear, a: Boolean, b: Boolean, d: Boolean) strict {
    label en official "section 101(h)(2)(C)";
    when public_safety_officer_death_bar_101h2(p, y, a, b, true, d);
    then public_safety_survivor_annuity_barred_101h2(p, y);
}
@source(IRC_S101_H, relation = formalizes, coverage = exact, quote = "(D) the payment is to an individual whose actions were a substantial contributing factor to the death of the officer.")
rule SurvivorAnnuityBarredByContributingPayee(p: Individual, y: TaxableYear, a: Boolean, b: Boolean, c: Boolean) strict {
    label en official "section 101(h)(2)(D)";
    when public_safety_officer_death_bar_101h2(p, y, a, b, c, true);
    then public_safety_survivor_annuity_barred_101h2(p, y);
}
pub relation public_safety_survivor_annuity_excluded_101h1(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the survivor annuity excluded from gross income: provided under a governmental plan meeting section 401(a), to the spouse (or former spouse) or a child, to the extent attributable to the officer's service as a public safety officer";
}
@source(IRC_S101_H, relation = formalizes, coverage = exact, quote = "Gross income shall not include any amount paid as a survivor annuity on account of the death of a public safety officer (as such term is defined in section 1204 of the")
rule PublicSafetySurvivorAnnuityExcluded(p: Individual, y: TaxableYear, paid: Money, attributable: Money) strict {
    label en official "section 101(h)(1)(A)-(B) and (2)";
    when public_safety_survivor_annuity_101h(p, y, paid, attributable, true, true);
    when not_known(public_safety_survivor_annuity_barred_101h2(p, y));
    then public_safety_survivor_annuity_excluded_101h1(p, y, min(paid, attributable));
}

// (i): specified terrorist victims and astronauts
relation employer_death_payment_101i(p: Individual, y: TaxableYear, amount_paid_by_employer: Money, employee_is_specified_terrorist_victim: Boolean, employee_is_astronaut_died_in_line_of_duty: Boolean, amount_payable_had_death_been_otherwise: Money, incidental_death_benefit_from_401a_plan: Boolean) kind empirical {
    label en official "an amount paid by an employer by reason of the death of an employee (including a self-employed individual, section 401(c)(1)) who is a specified terrorist victim (section 692(d)(4)) or an astronaut who died in the line of duty, the amount that would have been payable after death had the individual died other than as such a victim, and whether it is an incidental death benefit from a section 401(a) plan exempt under section 501(a)";
}
pub relation terrorist_or_astronaut_death_payment_excluded_101i(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "gross income does not include amounts paid by an employer by reason of the death of such an employee, except amounts payable after death anyway (other than incidental death benefits of a qualified plan)";
}
@source(IRC_S101_I, relation = formalizes, coverage = exact, quote = "Gross income does not include amounts (whether in a single sum or otherwise) paid by an employer by reason of the death of an employee who is a specified terrorist")
rule TerroristVictimPaymentExcluded(p: Individual, y: TaxableYear, paid: Money, otherwise: Money, astro: Boolean) strict {
    label en official "section 101(i)(1) and (2)(A): the amount that would have been paid anyway stays taxable";
    when employer_death_payment_101i(p, y, paid, true, astro, otherwise, false);
    then terrorist_or_astronaut_death_payment_excluded_101i(p, y, max(0.00 USD, paid - otherwise));
}
@source(IRC_S101_I, relation = formalizes, coverage = exact, quote = "Subparagraph (A) shall not apply to incidental death benefits paid from a plan described in section 401(a) and exempt from tax under section 501(a).")
rule TerroristVictimIncidentalBenefitFullyExcluded(p: Individual, y: TaxableYear, paid: Money, otherwise: Money, astro: Boolean) strict {
    label en official "section 101(i)(2)(B): subparagraph (A) does not apply to incidental death benefits of a qualified plan";
    when employer_death_payment_101i(p, y, paid, true, astro, otherwise, true);
    then terrorist_or_astronaut_death_payment_excluded_101i(p, y, paid);
}
@source(IRC_S101_I, relation = formalizes, coverage = exact, quote = "The provisions of this subsection shall apply to any astronaut whose death occurs in the line of duty.")
rule AstronautPaymentExcluded(p: Individual, y: TaxableYear, paid: Money, otherwise: Money, incidental: Boolean) strict {
    label en official "section 101(i)(4): the subsection applies to any astronaut whose death occurs in the line of duty";
    when employer_death_payment_101i(p, y, paid, false, true, otherwise, incidental);
    then terrorist_or_astronaut_death_payment_excluded_101i(p, y, max(0.00 USD, paid - otherwise));
}
