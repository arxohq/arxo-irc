// Stage 2f (TECH_GAP reduction) — §72 residuals outside subsection (t):
// (a)(2), (b)(3)(B)-(C), (d)(1)(D), (d)(2)-(3), (e)(4)(B), (e)(5)(D) last sentence,
// (e)(8)(D), (e)(12), (g)(2), (m)(2), (o)(3)(A), (o)(5)(B), (p)(1)(B), (p)(2)(E),
// (p)(3)-(6), (q)(2) substantially-equal rule, (r)(2), (w)(3).
// STATUS: implemented_unverified (static check only; scenarios in
// tests/s72-residuals.lawtest are NOT executed).
//
// JUDGMENT CALLS recorded here (the coverage rows repeat them):
//  * Aggregates read empirical relations only (DECISION-0111 subset limit): a
//    total over derived per-item classifications stays a case fact.
//  * "Rules similar to" and "regulations prescribed by the Secretary" clauses
//    are modelled where the text names the content, otherwise they are
//    EXTERNAL_DEPENDENCY rows and no content is invented.
//  * The enactment date of §72(t)(11) is December 29, 2022 (Pub. L. 117-328
//    §331(a) as recorded in the pinned statutory notes of §72).

// =====================================================================
// §72(a)(2): separate contract for a portion paid as an annuity
// =====================================================================

use self::{
    AnnuityContract,
    AnnuityContractDistribution,
    IRC_S72_A,
    IRC_S72_B,
    IRC_S72_D,
    IRC_S72_E,
    IRC_S72_G,
    IRC_S72_M,
    IRC_S72_O,
    IRC_S72_P,
    IRC_S72_Q,
    IRC_S72_R,
    IRC_S72_T,
    IRC_S72_W,
    Individual,
    Person,
    RetirementArrangement,
    TaxableYear,
    amount_received_not_as_annuity,
    annuity_distribution_excepted_72q,
    annuity_payments_cease_by_death,
    annuity_under_qualified_employer_retirement_plan,
    cash_value_before_receipt,
    contract_described_in_72e5d,
    contract_loan_or_pledge_received,
    contract_pays_beneficiary_on_death,
    death_payments_in_nature_of_refund,
    investment_in_contract_72c1,
    investment_in_contract_72e6,
    loan_balance_excess_before_this_loan,
    nonforfeitable_accrued_benefit_pv,
    plan_loan_deemed_distribution,
    plan_loan_dollar_limit_72p2a,
    plan_loan_made,
    plan_loan_repayment_terms_satisfied_72p2,
    premiums_paid_for_contract,
    receipt_before_starting_date,
    unrecovered_investment_deduction_at_death_72b3,
    unrecovered_investment_in_contract,
};

pub entity AnnuityPortion72 {
    label en unofficial "a portion of an annuity, endowment or life insurance contract (case-asserted)";
}
pub enum AnnuityPaymentPeriod72a2 { TenYearsOrMore; DuringOneOrMoreLives; ShorterPeriodCertain; }
relation portion_of_contract_72a2(portion: AnnuityPortion72, contract: AnnuityContract) kind empirical {
    label en official "the portion belongs to the contract";
}
relation portion_paid_as_annuity_over_period_72a2(portion: AnnuityPortion72, period: AnnuityPaymentPeriod72a2) kind empirical {
    label en official "the period over which amounts are received as an annuity under the portion";
}
relation portion_pro_rata_share_72a2B(portion: AnnuityPortion72, share: Decimal) kind empirical {
    label en official "the pro rata share of the investment in the contract allocated to the portion (the shares of all portions add to 1; the pro rata basis is not fixed by the text and is asserted by the case)";
}
relation first_annuity_period_start_of_portion_72a2C(portion: AnnuityPortion72, start: Date) kind empirical {
    label en official "the first day of the first period for which an amount is received as an annuity under the portion (section 72(c)(4) applied to the portion)";
}
pub relation portion_treated_as_separate_contract_72a2A(portion: AnnuityPortion72) kind institutional {
    label en official "the portion from which any amount is received as an annuity for a period of 10 years or more or during one or more lives is treated as a separate contract";
}
@source(IRC_S72_A, relation = formalizes, coverage = exact, quote = "(A) such portion shall be treated as a separate contract for purposes of this section,")
rule PortionSeparateContractTenYears(portion: AnnuityPortion72) strict {
    label en official "section 72(a)(2)(A): a portion paid as an annuity for 10 years or more";
    when portion_paid_as_annuity_over_period_72a2(portion, TenYearsOrMore);
    then portion_treated_as_separate_contract_72a2A(portion);
}
@source(IRC_S72_A, relation = formalizes, coverage = exact, quote = "(A) such portion shall be treated as a separate contract for purposes of this section,")
rule PortionSeparateContractLives(portion: AnnuityPortion72) strict {
    label en official "section 72(a)(2)(A): a portion paid as an annuity during one or more lives";
    when portion_paid_as_annuity_over_period_72a2(portion, DuringOneOrMoreLives);
    then portion_treated_as_separate_contract_72a2A(portion);
}
pub relation investment_allocated_to_portion_72a2B(p: Individual, contract: AnnuityContract, portion: AnnuityPortion72, amount: Money) kind institutional {
    label en official "the part of the investment in the contract allocated pro rata to the portion (subsections (b), (c) and (e))";
}
@source(IRC_S72_A, relation = formalizes, coverage = exact, quote = "(B) for purposes of applying subsections (b), (c), and (e), the investment in the contract shall be allocated pro rata between each portion of the contract from which")
rule InvestmentAllocatedProRataToPortion(p: Individual, contract: AnnuityContract, portion: AnnuityPortion72, inv: Money, share: Decimal) strict {
    label en official "section 72(a)(2)(B): investment x share, one rounding to cents HALF_UP (a judgment call: the text names no rounding)";
    when portion_of_contract_72a2(portion, contract);
    when portion_treated_as_separate_contract_72a2A(portion);
    when investment_in_contract_72c1(p, contract, inv);
    when portion_pro_rata_share_72a2B(portion, share);
    then investment_allocated_to_portion_72a2B(p, contract, portion, round(inv * share, 2, "HALF_UP"));
}
pub relation portion_annuity_starting_date_72a2C(portion: AnnuityPortion72, start: Date) kind institutional {
    label en official "the separate annuity starting date of the portion under subsection (c)(4)";
}
@source(IRC_S72_A, relation = formalizes, coverage = exact, quote = "(C) a separate annuity starting date under subsection (c)(4) shall be determined with respect to each portion of the contract from which amounts are received as an")
rule SeparateAnnuityStartingDateOfPortion(portion: AnnuityPortion72, start: Date) strict {
    label en official "section 72(a)(2)(C)";
    when portion_treated_as_separate_contract_72a2A(portion);
    when first_annuity_period_start_of_portion_72a2C(portion, start);
    then portion_annuity_starting_date_72a2C(portion, start);
}

// =====================================================================
// §72(b)(3)(B)-(C): deduction for the person entitled to refund payments; NOL character
// =====================================================================

relation person_entitled_to_refund_payment_received_in_year_72b3B(person: Individual, contract: AnnuityContract, y: TaxableYear) kind empirical {
    label en official "the person is entitled to payments under the contract on or after the death of the annuitant (a beneficiary or the estate) and receives them in the taxable year (section 72(b)(3)(B))";
}
pub relation unrecovered_investment_deduction_for_beneficiary_72b3B(person: Individual, contract: AnnuityContract, y: TaxableYear, amount: Money) kind institutional {
    label en official "the unrecovered-investment deduction of subparagraph (A) allowed to the person entitled to the refund payments for the taxable year in which the payments are received";
}
@source(IRC_S72_B, relation = formalizes, coverage = exact, quote = "In the case of any contract which provides for payments meeting the requirements of subparagraphs (B) and (C) of subsection (c)(2), the deduction under subparagraph (A)")
rule UnrecoveredInvestmentDeductionForBeneficiary(annuitant: Individual, person: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, unrecovered: Money) strict {
    label en official "section 72(b)(3)(B): payments meeting subparagraphs (B) and (C) of (c)(2) (payment to a beneficiary or estate on the annuitant's death, in the nature of a refund) move the deduction to the person entitled to them, for the year in which they are received";
    when annuity_payments_cease_by_death(annuitant, contract, on);
    when unrecovered_investment_in_contract(annuitant, contract, on, unrecovered);
    when unrecovered > 0.00 USD;
    when contract_pays_beneficiary_on_death(contract);
    when death_payments_in_nature_of_refund(contract);
    when person_entitled_to_refund_payment_received_in_year_72b3B(person, contract, y);
    then unrecovered_investment_deduction_for_beneficiary_72b3B(person, contract, y, unrecovered);
}
pub relation deduction_attributable_to_trade_or_business_for_172_72b3C(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "a deduction allowed under section 72(b)(3) is treated, for purposes of section 172, as attributable to a trade or business of the taxpayer";
}
@source(IRC_S72_B, relation = formalizes, coverage = exact, quote = "For purposes of section 172, a deduction allowed under this paragraph shall be treated as if it were attributable to a trade or business of the taxpayer.")
rule DeductionAtDeathIsTradeOrBusinessFor172(p: Individual, contract: AnnuityContract, y: TaxableYear, amount: Money) strict {
    label en official "section 72(b)(3)(C), annuitant's own deduction";
    when unrecovered_investment_deduction_at_death_72b3(p, contract, y, amount);
    then deduction_attributable_to_trade_or_business_for_172_72b3C(p, y, amount);
}
@source(IRC_S72_B, relation = formalizes, coverage = exact, quote = "For purposes of section 172, a deduction allowed under this paragraph shall be treated as if it were attributable to a trade or business of the taxpayer.")
rule DeductionForBeneficiaryIsTradeOrBusinessFor172(p: Individual, contract: AnnuityContract, y: TaxableYear, amount: Money) strict {
    label en official "section 72(b)(3)(C), deduction of the person entitled to refund payments";
    when unrecovered_investment_deduction_for_beneficiary_72b3B(p, contract, y, amount);
    then deduction_attributable_to_trade_or_business_for_172_72b3C(p, y, amount);
}

// =====================================================================
// §72(d)(1)(D): lump sum in connection with the commencement of annuity payments
// =====================================================================

relation lump_sum_on_commencement_of_annuity_72d1D(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, amount: Money) kind empirical {
    label en official "the taxpayer receives a lump-sum payment in connection with the commencement of annuity payments under a qualified employer retirement plan (section 72(d)(1)(D))";
}
pub relation lump_sum_taxed_as_received_before_starting_date_72d1D(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, amount: Money) kind institutional {
    label en official "the lump sum is taxable under subsection (e) as if received before the annuity starting date";
}
@source(IRC_S72_D, relation = formalizes, coverage = exact, quote = "(i) such payment shall be taxable under subsection (e) as if received before the annuity starting date, and")
rule LumpSumTaxedAsReceivedBeforeStartingDate(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, amount: Money) strict {
    label en official "section 72(d)(1)(D)(i): the payment is in connection with the commencement of annuity payments under a qualified employer retirement plan";
    when lump_sum_on_commencement_of_annuity_72d1D(p, contract, y, on, amount);
    when annuity_under_qualified_employer_retirement_plan(p, contract);
    then lump_sum_taxed_as_received_before_starting_date_72d1D(p, contract, y, on, amount);
}
pub relation lump_sum_includible_72d1D(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, amount: Money) kind institutional {
    label en official "the part of the lump sum included in gross income under subsection (e), the part allocable to income on the contract (subsection (e)(3))";
}
@source(IRC_S72_D, relation = formalizes, coverage = exact, quote = "(i) such payment shall be taxable under subsection (e) as if received before the annuity starting date, and")
rule LumpSumIncludibleAsAllocableToIncome(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, amount: Money, cash: Money, inv: Money) strict {
    label en official "section 72(d)(1)(D)(i) with (e)(2)(B), (e)(3): the lesser of the lump sum and the excess of the cash value over the investment, not below zero";
    when lump_sum_taxed_as_received_before_starting_date_72d1D(p, contract, y, on, amount);
    when cash_value_before_receipt(p, contract, on, cash);
    when investment_in_contract_72e6(p, contract, on, inv);
    then lump_sum_includible_72d1D(p, contract, y, on, min(amount, max(0.00 USD, round(cash - inv, 2, "HALF_UP"))));
}
pub relation investment_after_commencement_lump_sum_72d1D(p: Individual, contract: AnnuityContract, on: Date, amount: Money) kind institutional {
    label en official "the investment in the contract for the simplified method, determined as if the lump sum had been received before the annuity starting date: the investment less the part of the lump sum that was not included";
}
@source(IRC_S72_D, relation = formalizes, coverage = exact, quote = "(ii) the investment in the contract for purposes of this paragraph shall be determined as if such payment had been so received.")
rule InvestmentAfterCommencementLumpSum(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, amount: Money, included: Money, inv: Money) strict {
    label en official "section 72(d)(1)(D)(ii): investment - (lump sum - included part)";
    when lump_sum_includible_72d1D(p, contract, y, on, included);
    when lump_sum_taxed_as_received_before_starting_date_72d1D(p, contract, y, on, amount);
    when investment_in_contract_72c1(p, contract, inv);
    then investment_after_commencement_lump_sum_72d1D(p, contract, on, round(inv - (amount - included), 2, "HALF_UP"));
}

// =====================================================================
// §72(d)(2)-(3): separate contract treatment of employee contributions
// =====================================================================

pub entity ContributionPortion72d {
    label en unofficial "employee contributions to a defined contribution plan, or contributions to a pension-linked emergency savings account, and their allocable income (case-asserted)";
}
relation portion_is_employee_contributions_to_defined_contribution_plan_72d2(portion: ContributionPortion72d) kind empirical {
    label en official "the portion consists of employee contributions (and any income allocable thereto) under a defined contribution plan";
}
relation portion_is_pension_linked_emergency_savings_account_contributions_72d3(portion: ContributionPortion72d) kind empirical {
    label en official "the portion consists of contributions to a pension-linked emergency savings account to which section 402A(e) applies (and any income allocable thereto)";
}
pub relation may_be_treated_as_separate_contract_72d(portion: ContributionPortion72d) kind institutional {
    label en official "the portion may be treated as a separate contract for purposes of section 72";
}
@source(IRC_S72_D, relation = formalizes, coverage = exact, quote = "For purposes of this section, employee contributions (and any income allocable thereto) under a defined contribution plan may be treated as a separate contract.")
rule EmployeeContributionsMayBeSeparateContract(portion: ContributionPortion72d) strict {
    label en official "section 72(d)(2): a permission, not an obligation; the choice is the plan's or the taxpayer's and is not modelled as a power because the text names no act that creates the treatment";
    when portion_is_employee_contributions_to_defined_contribution_plan_72d2(portion);
    then may_be_treated_as_separate_contract_72d(portion);
}
@source(IRC_S72_D, relation = formalizes, coverage = exact, quote = "For purposes of this section, contributions to a pension-linked emergency savings account to which section 402A(e) applies (and any income allocable thereto) may be")
rule EmergencySavingsContributionsMayBeSeparateContract(portion: ContributionPortion72d) strict {
    label en official "section 72(d)(3)";
    when portion_is_pension_linked_emergency_savings_account_contributions_72d3(portion);
    then may_be_treated_as_separate_contract_72d(portion);
}

// =====================================================================
// §72(e)(4)(B): amount retained by the insurer as premium
// =====================================================================

relation loan_or_pledge_amount_retained_by_insurer_as_premium_72e4B(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, retained: Money) kind empirical {
    label en official "the part of an amount described in paragraph (1)(B) (a loan, assignment or pledge amount) that is retained by the insurer as a premium or other consideration paid for the contract";
}
pub relation retained_premium_excluded_from_e2Bi_72e4B(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, amount: Money) kind institutional {
    label en official "the part of the amount that is not included in gross income under paragraph (2)(B)(i) because it is retained by the insurer as a premium";
}
@source(IRC_S72_E, relation = formalizes, coverage = exact, quote = "Any amount described in paragraph (1)(B) shall not be included in gross income under paragraph (2)(B)(i) to the extent such amount is retained by the insurer as a")
rule RetainedPremiumExcludedFromInclusion(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, amount: Money, retained: Money) strict {
    label en official "section 72(e)(4)(B): the excluded part is the retained premium, not more than the loan amount";
    when contract_loan_or_pledge_received(p, contract, y, on, amount);
    when loan_or_pledge_amount_retained_by_insurer_as_premium_72e4B(p, contract, y, on, retained);
    then retained_premium_excluded_from_e2Bi_72e4B(p, contract, y, on, min(amount, retained));
}

// =====================================================================
// §72(e)(5)(D), last sentence: dividends described in section 404(k)
// =====================================================================

relation dividend_described_in_404k_received_72e5D(participant: Individual, contract: AnnuityContract, on: Date) kind empirical {
    label en official "a dividend described in section 404(k) received by a participant or beneficiary";
}
pub relation dividend_404k_paid_under_separate_contract_72e5D(participant: Individual, contract: AnnuityContract, on: Date) kind institutional {
    label en official "the dividend is treated as paid under a separate contract to which clause (ii)(I) of subparagraph (D) applies";
}
@source(IRC_S72_E, relation = formalizes, coverage = exact, quote = "Any dividend described in section 404(k) which is received by a participant or beneficiary shall, for purposes of this subparagraph, be treated as paid under a separate")
rule Dividend404kSeparateContract(participant: Individual, contract: AnnuityContract, on: Date) strict {
    label en official "section 72(e)(5)(D), last sentence";
    when dividend_described_in_404k_received_72e5D(participant, contract, on);
    then dividend_404k_paid_under_separate_contract_72e5D(participant, contract, on);
}

// =====================================================================
// §72(e)(8)(D): plan permitting withdrawal of employee contributions on May 5, 1986
// =====================================================================

relation plan_permitted_withdrawal_of_employee_contributions_on_19860505_72e8D(contract: AnnuityContract) kind empirical {
    label en official "on May 5, 1986 the plan permitted withdrawal of any employee contributions before separation from service";
}
relation investment_in_contract_as_of_19861231_72e8D(p: Individual, contract: AnnuityContract, amount: Money) kind empirical {
    label en official "the investment in the contract as of December 31, 1986";
}
relation amounts_received_after_19861231_before_this_receipt_72e8D(p: Individual, contract: AnnuityContract, amount: Money) kind empirical {
    label en official "amounts previously received under the contract after December 31, 1986";
}
pub relation pro_rata_rule_of_72e8A_applies_72e8D(p: Individual, contract: AnnuityContract, on: Date) kind institutional {
    label en official "subparagraph (A) of paragraph (8) applies to the receipt: the amounts received before the annuity starting date (with the amounts received after December 31, 1986) exceed the investment in the contract as of December 31, 1986";
}
@source(IRC_S72_E, relation = formalizes, coverage = exact, quote = "In the case of a plan which on May 5, 1986, permitted withdrawal of any employee contributions before separation from service, subparagraph (A) shall apply only to the")
rule ProRataRuleAppliesOnlyAboveInvestmentAt19861231(p: Individual, contract: AnnuityContract, on: Date, amount: Money, earlier: Money, inv86: Money) strict {
    label en official "section 72(e)(8)(D): this receipt plus the amounts received after 1986 exceed the investment as of 1986-12-31";
    when plan_permitted_withdrawal_of_employee_contributions_on_19860505_72e8D(contract);
    when amount_received_not_as_annuity(p, contract, _, on, amount);
    when receipt_before_starting_date(p, contract, on);
    when amounts_received_after_19861231_before_this_receipt_72e8D(p, contract, earlier);
    when investment_in_contract_as_of_19861231_72e8D(p, contract, inv86);
    when amount + earlier > inv86;
    then pro_rata_rule_of_72e8A_applies_72e8D(p, contract, on);
}

// =====================================================================
// §72(e)(12): contracts of one issuer, one policyholder and one year are one contract
// =====================================================================

pub enum ContractClass72e12 { ModifiedEndowmentContract; AnnuityContractClass; OtherContractClass; }
relation contract_issued_by_to_in_year_72e12(contract: AnnuityContract, issuer: Person, holder: Person, calendar_year: Integer, class: ContractClass72e12) kind empirical {
    label en official "the contract, its issuing company, its policyholder, the calendar year of issue and its class";
}
pub relation contracts_treated_as_one_contract_72e12(a: AnnuityContract, b: AnnuityContract) kind institutional {
    label en official "the two distinct contracts are treated as one modified endowment contract, or as one annuity contract, in determining the amount includible under subsection (e)";
}
@source(IRC_S72_E, relation = formalizes, coverage = exact, quote = "(i) all modified endowment contracts issued by the same company to the same policyholder during any calendar year shall be treated as 1 modified endowment contract, and")
rule ModifiedEndowmentContractsAggregated(a: AnnuityContract, b: AnnuityContract, issuer: Person, holder: Person, cy: Integer) strict {
    label en official "section 72(e)(12)(A)(i)";
    when contract_issued_by_to_in_year_72e12(a, issuer, holder, cy, ModifiedEndowmentContract);
    when contract_issued_by_to_in_year_72e12(b, issuer, holder, cy, ModifiedEndowmentContract);
    when a != b;
    when not_known(contract_described_in_72e5d(a));
    when not_known(contract_described_in_72e5d(b));
    then contracts_treated_as_one_contract_72e12(a, b);
}
@source(IRC_S72_E, relation = formalizes, coverage = exact, quote = "(ii) all annuity contracts issued by the same company to the same policyholder during any calendar year shall be treated as 1 annuity contract.")
rule AnnuityContractsAggregated(a: AnnuityContract, b: AnnuityContract, issuer: Person, holder: Person, cy: Integer) strict {
    label en official "section 72(e)(12)(A)(ii); the last sentence of (A) excludes contracts described in paragraph (5)(D)";
    when contract_issued_by_to_in_year_72e12(a, issuer, holder, cy, AnnuityContractClass);
    when contract_issued_by_to_in_year_72e12(b, issuer, holder, cy, AnnuityContractClass);
    when a != b;
    when not_known(contract_described_in_72e5d(a));
    when not_known(contract_described_in_72e5d(b));
    then contracts_treated_as_one_contract_72e12(a, b);
}

// =====================================================================
// §72(g)(2): transferee's receipts before the annuity starting date
// =====================================================================

relation receipt_before_starting_date_excludable_by_person_72g2(receiver: Individual, contract: AnnuityContract, amount: Money, on: Date) kind empirical {
    label en official "an amount received under the contract before the annuity starting date by the given person, to the extent excludable from gross income under this subtitle or prior income tax laws";
}
pub relation excludable_receipts_counted_for_transferee_72g2(transferee: Individual, contract: AnnuityContract, amount: Money) kind institutional {
    label en official "for the purposes of subsection (c)(1)(B) only the aggregate amount received under the contract by the transferee before the annuity starting date, to the extent excludable, is taken into account";
}
@source(IRC_S72_G, relation = formalizes, coverage = exact, quote = "(2) for purposes of subsection (c)(1)(B), there shall be taken into account only the aggregate amount received under the contract by the transferee before the annuity")
rule OnlyTransfereesReceiptsCounted(transferee: Individual, contract: AnnuityContract, on0: Date) strict {
    label en official "section 72(g)(2)";
    when receipt_before_starting_date_excludable_by_person_72g2(transferee, contract, _, on0);
    then excludable_receipts_counted_for_transferee_72g2(transferee, contract, sum(collect all a: Money, d: Date where receipt_before_starting_date_excludable_by_person_72g2(transferee, contract, a, d), empty: 0.00 USD));
}
relation beneficiary_of_transferee_72g(person: Individual, transferee: Individual) kind empirical {
    label en official "the person is a beneficiary of the transferee";
}
relation estate_of_transferee_72g(person: Person, transferee: Individual) kind empirical {
    label en official "the person is the estate of the transferee";
}
pub relation treated_as_transferee_72g(person: Person, transferee: Individual) kind institutional {
    label en official "the term transferee includes a beneficiary of, or the estate of, the transferee";
}
@source(IRC_S72_G, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, the term \"transferee\" includes a beneficiary of, or the estate of, the transferee.")
rule TransfereeIncludesBeneficiary(person: Individual, transferee: Individual) strict {
    label en official "section 72(g), last sentence: beneficiary";
    when beneficiary_of_transferee_72g(person, transferee);
    then treated_as_transferee_72g(person, transferee);
}
@source(IRC_S72_G, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, the term \"transferee\" includes a beneficiary of, or the estate of, the transferee.")
rule TransfereeIncludesEstate(person: Person, transferee: Individual) strict {
    label en official "section 72(g), last sentence: estate";
    when estate_of_transferee_72g(person, transferee);
    then treated_as_transferee_72g(person, transferee);
}

// =====================================================================
// §72(m)(2): premiums deducted under section 404 and owner-employee insurance costs
// =====================================================================

relation premium_deducted_under_404_while_self_employed_72m2(p: Individual, contract: AnnuityContract, amount: Money) kind empirical {
    label en official "an amount allowed as a deduction with respect to the contract under section 404, paid while the employee was an employee within the meaning of section 401(c)(1)";
}
relation premium_for_life_accident_or_health_while_owner_employee_72m2(p: Individual, contract: AnnuityContract, amount: Money) kind empirical {
    label en official "the part of the premiums paid while the employee was an owner-employee that is properly allocable, under regulations, to the cost of life, accident, health or other insurance";
}
pub relation aggregate_premiums_adjusted_72m2(p: Individual, contract: AnnuityContract, amount: Money) kind institutional {
    label en official "the aggregate premiums or other consideration paid, after treating section 404 deductions as employer consideration and disregarding owner-employee insurance costs (subsections (c)(1)(A) and (e)(6))";
}
@source(IRC_S72_M, relation = formalizes, coverage = exact, quote = "In computing—")
rule AggregatePremiumsAdjustedForSelfEmployedContributions(p: Individual, contract: AnnuityContract, premiums: Money, deducted: Money, insurance_cost: Money) strict {
    label en official "section 72(m)(2)(A)-(B): premiums minus the 404 deduction minus the owner-employee insurance cost, one rounding to cents HALF_UP";
    when premiums_paid_for_contract(p, contract, premiums);
    when premium_deducted_under_404_while_self_employed_72m2(p, contract, deducted);
    when premium_for_life_accident_or_health_while_owner_employee_72m2(p, contract, insurance_cost);
    then aggregate_premiums_adjusted_72m2(p, contract, round(premiums - deducted - insurance_cost, 2, "HALF_UP"));
}

// =====================================================================
// §72(o)(3)(A), (o)(5)(B): loans against deductible employee contributions; accumulated amount
// =====================================================================

relation loan_attributable_to_deductible_employee_contributions_72o3(p: Individual, plan: RetirementArrangement, on: Date, amount: Money) kind empirical {
    label en official "a loan (or assignment or pledge) from the plan attributable to accumulated deductible employee contributions";
}
pub relation deductible_contribution_loan_treated_as_distribution_72o3A(p: Individual, plan: RetirementArrangement, on: Date, amount: Money) kind institutional {
    label en official "the amount treated as distributed from the accumulated deductible employee contributions under rules similar to those of subsection (p), without the (p)(2) exception";
}
@source(IRC_S72_O, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, rules similar to the rules provided by subsection (p) (other than the exception contained in paragraph (2) thereof) shall apply.")
rule DeductibleContributionLoanTreatedAsDistribution(p: Individual, plan: RetirementArrangement, on: Date, amount: Money) strict {
    label en official "section 72(o)(3)(A): rules similar to (p), other than the exception contained in (p)(2), so the whole amount is treated as a distribution";
    when loan_attributable_to_deductible_employee_contributions_72o3(p, plan, on, amount);
    then deductible_contribution_loan_treated_as_distribution_72o3A(p, plan, on, amount);
}
relation deductible_employee_contributions_total_72o5B(p: Individual, plan: RetirementArrangement, amount: Money) kind empirical {
    label en official "the deductible employee contributions to the plan (section 72(o)(5)(A))";
}
relation income_and_gain_allocable_to_contributions_72o5Bi(p: Individual, plan: RetirementArrangement, amount: Money) kind empirical {
    label en official "the income and gain allocable to the contributions";
}
relation loss_and_expense_allocable_to_contributions_72o5Bii(p: Individual, plan: RetirementArrangement, amount: Money) kind empirical {
    label en official "the loss and expense allocable to the contributions";
}
relation distributions_attributable_to_contributions_72o5Bii(p: Individual, plan: RetirementArrangement, amount: Money) kind empirical {
    label en official "the amounts distributed with respect to the employee attributable to the contributions (or income or gain allocable to them)";
}
pub relation accumulated_deductible_employee_contributions_72o5B(p: Individual, plan: RetirementArrangement, amount: Money) kind institutional {
    label en official "the accumulated deductible employee contributions: the contributions, increased by the income and gain allocable, reduced by the loss, expense and distributions";
}
@source(IRC_S72_O, relation = formalizes, coverage = exact, quote = "The term \"accumulated deductible employee contributions\" means the deductible employee contributions—")
rule AccumulatedDeductibleEmployeeContributions(p: Individual, plan: RetirementArrangement, contrib: Money, gain: Money, loss: Money, dist: Money) strict {
    label en official "section 72(o)(5)(B)(i)-(ii)";
    when deductible_employee_contributions_total_72o5B(p, plan, contrib);
    when income_and_gain_allocable_to_contributions_72o5Bi(p, plan, gain);
    when loss_and_expense_allocable_to_contributions_72o5Bii(p, plan, loss);
    when distributions_attributable_to_contributions_72o5Bii(p, plan, dist);
    then accumulated_deductible_employee_contributions_72o5B(p, plan, round(contrib + gain - (loss + dist), 2, "HALF_UP"));
}

// =====================================================================
// §72(p)(1)(B), (p)(5): assignments, pledges and contract loans treated as plan loans
// =====================================================================

relation plan_interest_assigned_or_pledged_72p1B(p: Individual, plan: RetirementArrangement, on: Date, amount: Money) kind empirical {
    label en official "during the taxable year the participant or beneficiary assigns (or agrees to assign) or pledges (or agrees to pledge) a portion of his interest in a qualified employer plan";
}
relation loan_under_contract_purchased_under_plan_72p5(p: Individual, plan: RetirementArrangement, on: Date, amount: Money) kind empirical {
    label en official "an amount received as a loan under a contract purchased under a qualified employer plan, or an assignment or pledge with respect to such a contract";
}
pub relation indirect_plan_loan_treated_as_loan_72p(p: Individual, plan: RetirementArrangement, on: Date, amount: Money) kind institutional {
    label en official "an assignment, pledge or contract loan treated as a loan from the plan";
}
@source(IRC_S72_P, relation = formalizes, coverage = exact, quote = "If during any taxable year a participant or beneficiary assigns (or agrees to assign) or pledges (or agrees to pledge) any portion of his interest in a qualified")
rule AssignmentOrPledgeTreatedAsPlanLoan(p: Individual, plan: RetirementArrangement, on: Date, amount: Money) strict {
    label en official "section 72(p)(1)(B)";
    when plan_interest_assigned_or_pledged_72p1B(p, plan, on, amount);
    then indirect_plan_loan_treated_as_loan_72p(p, plan, on, amount);
}
@source(IRC_S72_P, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, any amount received as a loan under a contract purchased under a qualified employer plan (and any assignment or pledge with respect to")
rule ContractLoanTreatedAsPlanLoan(p: Individual, plan: RetirementArrangement, on: Date, amount: Money) strict {
    label en official "section 72(p)(5)";
    when loan_under_contract_purchased_under_plan_72p5(p, plan, on, amount);
    then indirect_plan_loan_treated_as_loan_72p(p, plan, on, amount);
}
@source(IRC_S72_P, relation = formalizes, coverage = exact, quote = "If during any taxable year a participant or beneficiary assigns (or agrees to assign) or pledges (or agrees to pledge) any portion of his interest in a qualified")
rule IndirectPlanLoanWithinLimitAndTerms(p: Individual, plan: RetirementArrangement, on: Date, amount: Money, limit: Money) strict {
    label en official "section 72(p)(1)(B) and (5) with (2): within the dollar limit and repayment terms no part is a deemed distribution (explicit zero)";
    when indirect_plan_loan_treated_as_loan_72p(p, plan, on, amount);
    when plan_loan_dollar_limit_72p2a(p, plan, on, limit);
    when plan_loan_repayment_terms_satisfied_72p2(p, plan, on);
    when amount <= limit;
    when on > @1982-08-13;
    then plan_loan_deemed_distribution(p, plan, on, 0.00 USD);
}
@source(IRC_S72_P, relation = formalizes, coverage = exact, quote = "If during any taxable year a participant or beneficiary assigns (or agrees to assign) or pledges (or agrees to pledge) any portion of his interest in a qualified")
rule IndirectPlanLoanOverLimit(p: Individual, plan: RetirementArrangement, on: Date, amount: Money, limit: Money) strict {
    label en official "section 72(p)(1)(B) and (5) with (2): the excess over the dollar limit is a deemed distribution";
    when indirect_plan_loan_treated_as_loan_72p(p, plan, on, amount);
    when plan_loan_dollar_limit_72p2a(p, plan, on, limit);
    when plan_loan_repayment_terms_satisfied_72p2(p, plan, on);
    when amount > limit;
    when on > @1982-08-13;
    then plan_loan_deemed_distribution(p, plan, on, round(amount - limit, 2, "HALF_UP"));
}
@source(IRC_S72_P, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, any amount received as a loan under a contract purchased under a qualified employer plan (and any assignment or pledge with respect to")
rule IndirectPlanLoanTermsFail(p: Individual, plan: RetirementArrangement, on: Date, amount: Money) strict {
    label en official "section 72(p)(1)(B) and (5): the (2)(B)-(D) repayment terms are not met, the whole amount is a deemed distribution";
    when indirect_plan_loan_treated_as_loan_72p(p, plan, on, amount);
    when not_known(plan_loan_repayment_terms_satisfied_72p2(p, plan, on));
    when on > @1982-08-13;
    then plan_loan_deemed_distribution(p, plan, on, amount);
}

// =====================================================================
// §72(p)(2)(E): all plans of an employer are one plan
// =====================================================================

relation plan_maintained_by_employer_group_72p2e(plan: RetirementArrangement, group: Person) kind empirical {
    label en official "the plan is maintained by the employer, determined after the application of section 414(b), (c) and (m) (the aggregated employer is the group)";
}
pub relation plans_of_employer_treated_as_one_plan_72p2e(a: RetirementArrangement, b: RetirementArrangement) kind institutional {
    label en official "two plans of the same employer group are treated as one plan for the loan limit";
}
@source(IRC_S72_P, relation = formalizes, coverage = exact, quote = "(ii) all plans of an employer (determined after the application of such subsections) shall be treated as 1 plan.")
rule PlansOfEmployerGroupTreatedAsOnePlan(a: RetirementArrangement, b: RetirementArrangement, group: Person) strict {
    label en official "section 72(p)(2)(E)(i)-(ii)";
    when plan_maintained_by_employer_group_72p2e(a, group);
    when plan_maintained_by_employer_group_72p2e(b, group);
    when a != b;
    then plans_of_employer_treated_as_one_plan_72p2e(a, b);
}

// =====================================================================
// §72(p)(3): no interest deduction for certain loans; (p)(4): definitions
// =====================================================================

relation key_employee_since_72p3Bi(p: Individual, first_day: Date) kind empirical {
    label en official "the first day on which the individual is a key employee (section 416(i))";
}
relation loan_secured_by_elective_deferrals_72p3Bii(p: Individual, plan: RetirementArrangement, loan_date: Date) kind empirical {
    label en official "the loan is secured by amounts attributable to elective deferrals described in subparagraph (A) or (C) of section 402(g)(3)";
}
relation interest_accrued_on_plan_loan_72p3(p: Individual, plan: RetirementArrangement, loan_date: Date, accrued_on: Date, amount: Money) kind empirical {
    label en official "interest paid or accrued on the loan, with the date of accrual";
}
pub relation interest_deduction_denied_on_plan_loan_72p3(p: Individual, plan: RetirementArrangement, loan_date: Date, accrued_on: Date, amount: Money) kind institutional {
    label en official "no deduction otherwise allowable under this chapter is allowed for the interest";
}
@source(IRC_S72_P, relation = formalizes, coverage = exact, quote = "(i) on or after the 1st day on which the individual to whom the loan is made is a key employee (as defined in section 416(i)), or")
rule InterestDeductionDeniedKeyEmployeePeriod(p: Individual, plan: RetirementArrangement, loan_date: Date, accrued_on: Date, amount: Money, first_day: Date) strict {
    label en official "section 72(p)(3)(A) and (B)(i): the loan is not treated as a distribution (explicit zero deemed) and the interest accrues on or after the first day the borrower is a key employee";
    when interest_accrued_on_plan_loan_72p3(p, plan, loan_date, accrued_on, amount);
    when plan_loan_deemed_distribution(p, plan, loan_date, 0.00 USD);
    when key_employee_since_72p3Bi(p, first_day);
    when accrued_on >= first_day;
    then interest_deduction_denied_on_plan_loan_72p3(p, plan, loan_date, accrued_on, amount);
}
@source(IRC_S72_P, relation = formalizes, coverage = exact, quote = "(ii) such loan is secured by amounts attributable to elective deferrals described in subparagraph (A) or (C) of section 402(g)(3).")
rule InterestDeductionDeniedSecuredByElectiveDeferrals(p: Individual, plan: RetirementArrangement, loan_date: Date, accrued_on: Date, amount: Money) strict {
    label en official "section 72(p)(3)(A) and (B)(ii)";
    when interest_accrued_on_plan_loan_72p3(p, plan, loan_date, accrued_on, amount);
    when plan_loan_deemed_distribution(p, plan, loan_date, 0.00 USD);
    when loan_secured_by_elective_deferrals_72p3Bii(p, plan, loan_date);
    then interest_deduction_denied_on_plan_loan_72p3(p, plan, loan_date, accrued_on, amount);
}

pub enum PlanKind72p4 { Section401aTrustPlan; Section403aAnnuityPlan; Section403bEmployerContributionPlan; OtherKindOfPlan; }
relation plan_kind_72p4(plan: RetirementArrangement, kind: PlanKind72p4) kind empirical {
    label en official "the statutory kind of the plan: a section 401(a) plan with a trust exempt under section 501(a), a section 403(a) annuity plan, or a plan under which the employer contributes for a section 403(b) annuity contract";
}
relation plan_was_or_was_determined_to_be_qualified_72p4aii(plan: RetirementArrangement) kind empirical {
    label en official "the plan was (or was determined to be) a qualified employer plan or a government plan";
}
relation plan_established_and_maintained_by_government_for_employees_72p4b(plan: RetirementArrangement) kind empirical {
    label en official "the plan, whether or not qualified, is established and maintained for its employees by the United States, by a State or political subdivision, or by an agency or instrumentality of any of them";
}
pub relation government_plan_72p4b(plan: RetirementArrangement) kind institutional {
    label en official "a government plan within the meaning of section 72(p)(4)(B)";
}
@source(IRC_S72_P, relation = formalizes, coverage = exact, quote = "The term \"government plan\" means any plan, whether or not qualified, established and maintained for its employees by the United States, by a State or political")
rule GovernmentPlanDefined(plan: RetirementArrangement) strict {
    label en official "section 72(p)(4)(B)";
    when plan_established_and_maintained_by_government_for_employees_72p4b(plan);
    then government_plan_72p4b(plan);
}
pub relation qualified_employer_plan_72p4(plan: RetirementArrangement) kind institutional {
    label en official "a qualified employer plan within the meaning of section 72(p)(4)(A)";
}
@source(IRC_S72_P, relation = formalizes, coverage = exact, quote = "(I) a plan described in section 401(a) which includes a trust exempt from tax under section 501(a),")
rule QualifiedEmployerPlan401a(plan: RetirementArrangement) strict {
    label en official "section 72(p)(4)(A)(i)(I)";
    when plan_kind_72p4(plan, Section401aTrustPlan);
    then qualified_employer_plan_72p4(plan);
}
@source(IRC_S72_P, relation = formalizes, coverage = exact, quote = "(II) an annuity plan described in section 403(a), and")
rule QualifiedEmployerPlan403a(plan: RetirementArrangement) strict {
    label en official "section 72(p)(4)(A)(i)(II)";
    when plan_kind_72p4(plan, Section403aAnnuityPlan);
    then qualified_employer_plan_72p4(plan);
}
@source(IRC_S72_P, relation = formalizes, coverage = exact, quote = "(III) a plan under which amounts are contributed by an individual's employer for an annuity contract described in section 403(b).")
rule QualifiedEmployerPlan403b(plan: RetirementArrangement) strict {
    label en official "section 72(p)(4)(A)(i)(III)";
    when plan_kind_72p4(plan, Section403bEmployerContributionPlan);
    then qualified_employer_plan_72p4(plan);
}
@source(IRC_S72_P, relation = formalizes, coverage = exact, quote = "The term \"qualified employer plan\" shall include any plan which was (or was determined to be) a qualified employer plan or a government plan.")
rule QualifiedEmployerPlanByDetermination(plan: RetirementArrangement) strict {
    label en official "section 72(p)(4)(A)(ii), first limb";
    when plan_was_or_was_determined_to_be_qualified_72p4aii(plan);
    then qualified_employer_plan_72p4(plan);
}
@source(IRC_S72_P, relation = formalizes, coverage = exact, quote = "The term \"qualified employer plan\" shall include any plan which was (or was determined to be) a qualified employer plan or a government plan.")
rule QualifiedEmployerPlanGovernmentPlan(plan: RetirementArrangement) strict {
    label en official "section 72(p)(4)(A)(ii), second limb: a government plan is included";
    when government_plan_72p4b(plan);
    then qualified_employer_plan_72p4(plan);
}

// =====================================================================
// §72(p)(6): qualified disaster loans
// =====================================================================

pub entity QualifiedDisaster72p6 {
    label en unofficial "a disaster within section 72(t)(11)(E), (F) (case-asserted)";
}
relation disaster_declared_after_20201227_72t11E(disaster: QualifiedDisaster72p6, declared_on: Date) kind empirical {
    label en official "the date the President declared a major disaster under section 401 of the Stafford Act";
}
relation incident_period_72t11Fii(disaster: QualifiedDisaster72p6, first_day: Date, last_day: Date) kind empirical {
    label en official "the incident period specified by the Federal Emergency Management Agency";
}
relation disaster_declaration_date_72t11Fiii(disaster: QualifiedDisaster72p6, declared_on: Date) kind empirical {
    label en official "the date of the disaster declaration";
}
pub relation qualified_disaster_72t11E(disaster: QualifiedDisaster72p6) kind institutional {
    label en official "a qualified disaster: a disaster with respect to which a major disaster has been declared by the President under section 401 of the Stafford Act after December 27, 2020";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph and paragraph (8), the term \"qualified disaster\" means any disaster with respect to which a major disaster has been declared by the")
rule QualifiedDisasterDefined(disaster: QualifiedDisaster72p6, declared_on: Date) strict {
    label en official "section 72(t)(11)(E): declared after December 27, 2020";
    when disaster_declared_after_20201227_72t11E(disaster, declared_on);
    when declared_on > @2020-12-27;
    then qualified_disaster_72t11E(disaster);
}
pub relation applicable_date_72t11Fiii(disaster: QualifiedDisaster72p6, applicable_date: Date) kind institutional {
    label en official "the applicable date: the latest of the date of enactment of paragraph (11) (December 29, 2022, Pub. L. 117-328 section 331(a) per the statutory notes of section 72), the first day of the incident period, and the date of the disaster declaration";
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "The term \"applicable date\" means the latest of—")
rule ApplicableDateIsTheLatestOfThree(disaster: QualifiedDisaster72p6, first_day: Date, last_day: Date, declared_on: Date) strict {
    label en official "section 72(t)(11)(F)(iii)(I)-(III): the latest of three dates, computed by comparing the candidates pairwise";
    when incident_period_72t11Fii(disaster, first_day, last_day);
    when disaster_declaration_date_72t11Fiii(disaster, declared_on);
    when first_day >= @2022-12-29;
    when first_day >= declared_on;
    then applicable_date_72t11Fiii(disaster, first_day);
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "The term \"applicable date\" means the latest of—")
rule ApplicableDateIsTheDeclarationDate(disaster: QualifiedDisaster72p6, first_day: Date, last_day: Date, declared_on: Date) strict {
    label en official "section 72(t)(11)(F)(iii): the declaration date is the latest";
    when incident_period_72t11Fii(disaster, first_day, last_day);
    when disaster_declaration_date_72t11Fiii(disaster, declared_on);
    when declared_on >= @2022-12-29;
    when declared_on > first_day;
    then applicable_date_72t11Fiii(disaster, declared_on);
}
@source(IRC_S72_T, relation = formalizes, coverage = exact, quote = "The term \"applicable date\" means the latest of—")
rule ApplicableDateIsTheEnactmentDate(disaster: QualifiedDisaster72p6, first_day: Date, last_day: Date, declared_on: Date) strict {
    label en official "section 72(t)(11)(F)(iii)(I): the enactment date is the latest (Pub. L. 117-328 section 331(a), December 29, 2022)";
    when incident_period_72t11Fii(disaster, first_day, last_day);
    when disaster_declaration_date_72t11Fiii(disaster, declared_on);
    when first_day < @2022-12-29;
    when declared_on < @2022-12-29;
    then applicable_date_72t11Fiii(disaster, @2022-12-29);
}
relation principal_abode_in_disaster_area_during_incident_period_72p6ci(p: Individual, disaster: QualifiedDisaster72p6) kind empirical {
    label en official "the individual's principal place of abode at any time during the incident period is located in the qualified disaster area";
}
relation economic_loss_by_reason_of_disaster_72p6cii(p: Individual, disaster: QualifiedDisaster72p6) kind empirical {
    label en official "the individual has sustained an economic loss by reason of the qualified disaster";
}
pub relation qualified_individual_72p6c(p: Individual, disaster: QualifiedDisaster72p6) kind institutional {
    label en official "a qualified individual for the qualified disaster";
}
@source(IRC_S72_P, relation = formalizes, coverage = exact, quote = "The term \"qualified individual\" means any individual—")
rule QualifiedIndividualForDisasterLoan(p: Individual, disaster: QualifiedDisaster72p6) strict {
    label en official "section 72(p)(6)(C)(i)(I)-(II)";
    when qualified_disaster_72t11E(disaster);
    when principal_abode_in_disaster_area_during_incident_period_72p6ci(p, disaster);
    when economic_loss_by_reason_of_disaster_72p6cii(p, disaster);
    then qualified_individual_72p6c(p, disaster);
}
pub relation loan_within_applicable_period_72p6c(p: Individual, plan: RetirementArrangement, on: Date, disaster: QualifiedDisaster72p6) kind institutional {
    label en official "the loan is made to a qualified individual during the applicable period: from the applicable date to the date 180 days after it";
}
@source(IRC_S72_P, relation = formalizes, coverage = exact, quote = "The applicable period with respect to any disaster is the period—")
rule LoanWithinApplicablePeriod(p: Individual, plan: RetirementArrangement, on: Date, disaster: QualifiedDisaster72p6, applicable: Date) strict {
    label en official "section 72(p)(6)(C)(ii)(I)-(II): applicable period of 180 days beginning on the applicable date";
    when plan_loan_made(p, plan, on, _);
    when qualified_individual_72p6c(p, disaster);
    when applicable_date_72t11Fiii(disaster, applicable);
    when on >= applicable;
    when on <= add_calendar_period(applicable, 180 calendar_day);
    then loan_within_applicable_period_72p6c(p, plan, on, disaster);
}
pub relation disaster_loan_limit_applies_72p6A(p: Individual, plan: RetirementArrangement, on: Date) kind institutional {
    label en official "the qualified disaster loan limits of section 72(p)(6)(A) replace those of (p)(2)(A)";
}
@source(IRC_S72_P, relation = formalizes, coverage = exact, quote = "In the case of any loan from a qualified employer plan to a qualified individual made during the applicable period—")
rule DisasterLoanLimitApplies(p: Individual, plan: RetirementArrangement, on: Date, disaster: QualifiedDisaster72p6) strict {
    label en official "section 72(p)(6)(A)";
    when loan_within_applicable_period_72p6c(p, plan, on, disaster);
    then disaster_loan_limit_applies_72p6A(p, plan, on);
}
pub relation disaster_plan_loan_dollar_limit_72p6A(p: Individual, plan: RetirementArrangement, on: Date, limit: Money) kind institutional {
    label en official "the dollar limit of a qualified disaster loan: the lesser of $100,000 reduced by the 1-year highest-balance excess, and the present value of the whole nonforfeitable accrued benefit (in place of one-half of it and of the $10,000 floor)";
}
@source(IRC_S72_P, relation = formalizes, coverage = exact, quote = "(i) clause (i) of paragraph (2)(A) shall be applied by substituting \"$100,000\" for \"$50,000\", and")
rule DisasterPlanLoanDollarLimit(p: Individual, plan: RetirementArrangement, on: Date, excess: Money, pv: Money) strict {
    label en official "section 72(p)(6)(A)(i)-(ii): the $50,000 becomes $100,000 and one-half of the accrued benefit becomes all of it; the $10,000 alternative of (p)(2)(A)(ii) is replaced with the present value itself";
    when disaster_loan_limit_applies_72p6A(p, plan, on);
    when loan_balance_excess_before_this_loan(p, plan, on, excess);
    when nonforfeitable_accrued_benefit_pv(p, plan, on, pv);
    when 100000.00 USD >= excess;
    then disaster_plan_loan_dollar_limit_72p6A(p, plan, on, min(round(100000.00 USD - excess, 2, "HALF_UP"), pv));
}
relation repayment_due_date_within_delay_window_72p6B(p: Individual, plan: RetirementArrangement, due: Date, incident_last_day: Date) kind empirical {
    label en official "the due date of a repayment on an outstanding loan of a qualified individual and the last day of the incident period of the qualified disaster (section 72(p)(6)(B)(i))";
}
relation repayment_first_incident_day_72p6B(p: Individual, plan: RetirementArrangement, first_day: Date) kind empirical {
    label en official "the first day of the incident period of the qualified disaster";
}
pub relation repayment_due_date_may_be_delayed_72p6B(p: Individual, plan: RetirementArrangement, due: Date, new_due: Date) kind institutional {
    label en official "the due date of the repayment may be delayed for 1 year when it falls between the first day of the incident period and the date 180 days after its last day";
}
@source(IRC_S72_P, relation = formalizes, coverage = exact, quote = "(i) if the due date pursuant to subparagraph (B) or (C) of paragraph (2) for any repayment with respect to such loan occurs during the period beginning on the first day")
rule RepaymentDueDateMayBeDelayedOneYear(p: Individual, plan: RetirementArrangement, due: Date, last_day: Date, first_day: Date) strict {
    label en official "section 72(p)(6)(B)(i): a permission (may be delayed), so the derived date is the delayed date it permits; subsequent repayments adjust for the delay and interest (clause (ii)) and the delay is disregarded for the 5-year period and the loan term (clause (iii)), which stay with the plan";
    when repayment_due_date_within_delay_window_72p6B(p, plan, due, last_day);
    when repayment_first_incident_day_72p6B(p, plan, first_day);
    when due >= first_day;
    when due <= add_calendar_period(last_day, 180 calendar_day);
    then repayment_due_date_may_be_delayed_72p6B(p, plan, due, add_calendar_period(due, 1 calendar_year));
}

// =====================================================================
// §72(q)(2), last sentence: periodic payments deemed substantially equal
// =====================================================================

relation annuity_distribution_payable_over_q2D_period(dist: AnnuityContractDistribution) kind empirical {
    label en official "the payments are payable over the life (or life expectancy) period described in subparagraph (D)";
}
relation annuity_distribution_is_annuity_amount(dist: AnnuityContractDistribution) kind empirical {
    label en official "the periodic payments are amounts received as an annuity";
}
relation annuity_distribution_would_satisfy_401a9_annuity_rules_72q(dist: AnnuityContractDistribution) kind empirical {
    label en official "the payments would satisfy the requirements applicable to annuity payments under section 401(a)(9) if those requirements applied";
}
pub relation periodic_payments_deemed_substantially_equal_72q2D(dist: AnnuityContractDistribution) kind institutional {
    label en official "the periodic payments are deemed substantially equal for the (q)(2)(D) exception";
}
@source(IRC_S72_Q, relation = formalizes, coverage = exact, quote = "For purposes of subparagraph (D), periodic payments shall not fail to be treated as substantially equal merely because they are amounts received as an annuity, and such")
rule PeriodicPaymentsDeemedSubstantiallyEqualQ(dist: AnnuityContractDistribution) strict {
    label en official "section 72(q)(2), last sentence: annuity amounts payable over the (D) period that would satisfy the 401(a)(9) annuity requirements are deemed substantially equal";
    when annuity_distribution_payable_over_q2D_period(dist);
    when annuity_distribution_is_annuity_amount(dist);
    when annuity_distribution_would_satisfy_401a9_annuity_rules_72q(dist);
    then periodic_payments_deemed_substantially_equal_72q2D(dist);
}
@source(IRC_S72_Q, relation = formalizes, coverage = exact, quote = "For purposes of subparagraph (D), periodic payments shall not fail to be treated as substantially equal merely because they are amounts received as an annuity, and such")
rule AnnuityExceptionSeppDeemedEqual(dist: AnnuityContractDistribution) strict {
    label en official "section 72(q)(2)(D) with the deemed-equal sentence";
    when periodic_payments_deemed_substantially_equal_72q2D(dist);
    then annuity_distribution_excepted_72q(dist);
}

// =====================================================================
// §72(r)(2): tier 2 railroad retirement taxes as contributions
// =====================================================================

pub enum RailroadTaxSection72r { Section3201EmployeeTax; Section3211RepresentativeTax; Section3221EmployerTax; }
relation tier2_tax_paid_72r2(payer: Person, section: RailroadTaxSection72r, compensation_paid_on: Date, amount: Money) kind empirical {
    label en official "the tier 2 portion (as defined in (b)) of the tax imposed by the section, with the date the compensation is paid (the (b) amount is asserted after the rate rules of (b)(ii) or the excess of (b)(iii) have been applied)";
}
pub relation tier2_tax_treated_as_employee_contribution_72r2A(payer: Person, amount: Money) kind institutional {
    label en official "the tier 2 portion of the tax under section 3201 or 3211 is treated as an employee contribution";
}
pub relation tier2_tax_treated_as_employer_contribution_72r2A(payer: Person, amount: Money) kind institutional {
    label en official "the tier 2 portion of the tax under section 3221 is treated as an employer contribution";
}
@source(IRC_S72_R, relation = formalizes, coverage = exact, quote = "(i) the tier 2 portion of the tax imposed by section 3201 (relating to tax on employees) shall be treated as an employee contribution,")
rule Tier2Section3201IsEmployeeContribution(payer: Person, d: Date, amount: Money) strict {
    label en official "section 72(r)(2)(A)(i)";
    when tier2_tax_paid_72r2(payer, Section3201EmployeeTax, d, amount);
    then tier2_tax_treated_as_employee_contribution_72r2A(payer, amount);
}
@source(IRC_S72_R, relation = formalizes, coverage = exact, quote = "(ii) the tier 2 portion of the tax imposed by section 3211 (relating to tax on employee representatives) shall be treated as an employee contribution, and")
rule Tier2Section3211IsEmployeeContribution(payer: Person, d: Date, amount: Money) strict {
    label en official "section 72(r)(2)(A)(ii)";
    when tier2_tax_paid_72r2(payer, Section3211RepresentativeTax, d, amount);
    then tier2_tax_treated_as_employee_contribution_72r2A(payer, amount);
}
@source(IRC_S72_R, relation = formalizes, coverage = exact, quote = "(iii) the tier 2 portion of the tax imposed by section 3221 (relating to tax on employers) shall be treated as an employer contribution.")
rule Tier2Section3221IsEmployerContribution(payer: Person, d: Date, amount: Money) strict {
    label en official "section 72(r)(2)(A)(iii)";
    when tier2_tax_paid_72r2(payer, Section3221EmployerTax, d, amount);
    then tier2_tax_treated_as_employer_contribution_72r2A(payer, amount);
}
relation rrta_compensation_and_dates_72r2b(payer: Person, section: RailroadTaxSection72r, compensation: Money, paid_on: Date, services_rendered_on: Date) kind empirical {
    label en official "compensation subject to the railroad tax, the date it is paid and the date the services were rendered";
}
pub relation tier2_portion_by_rate_72r2b(payer: Person, section: RailroadTaxSection72r, paid_on: Date, amount: Money) kind institutional {
    label en official "the tier 2 portion of the tax on compensation paid before 1985 for services rendered after September 30, 1981, determined at the rate the statute names for the section and period";
}
@source(IRC_S72_R, relation = formalizes, coverage = exact, quote = "(I) so much of the tax imposed by section 3201 as is determined at the 2 percent rate, and")
rule Tier2Section3201RateTwoPercent(payer: Person, comp: Money, paid: Date, rendered: Date) strict {
    label en official "section 72(r)(2)(B)(ii)(I): 2 percent of compensation under section 3201, services rendered after September 30, 1981 and before January 1, 1984, compensation paid before 1985";
    when rrta_compensation_and_dates_72r2b(payer, Section3201EmployeeTax, comp, paid, rendered);
    when paid < @1985-01-01;
    when rendered > @1981-09-30;
    when rendered < @1984-01-01;
    then tier2_portion_by_rate_72r2b(payer, Section3201EmployeeTax, paid, round(comp * 0.02, 2, "HALF_UP"));
}
@source(IRC_S72_R, relation = formalizes, coverage = exact, quote = "(II) so much of the taxes imposed by sections 3211 and 3221 as is determined at the 11.75 percent rate.")
rule Tier2Sections3211And3221RateElevenSeventyFive(payer: Person, s: RailroadTaxSection72r, comp: Money, paid: Date, rendered: Date) strict {
    label en official "section 72(r)(2)(B)(ii)(II): 11.75 percent under sections 3211 and 3221, services rendered after September 30, 1981 and before January 1, 1984";
    when rrta_compensation_and_dates_72r2b(payer, s, comp, paid, rendered);
    when s != Section3201EmployeeTax;
    when paid < @1985-01-01;
    when rendered > @1981-09-30;
    when rendered < @1984-01-01;
    then tier2_portion_by_rate_72r2b(payer, s, paid, round(comp * 0.1175, 2, "HALF_UP"));
}
@source(IRC_S72_R, relation = formalizes, coverage = exact, quote = "With respect to compensation paid for services rendered after December 31, 1983, and before 1985, subclause (I) shall be applied by substituting \"2.75 percent\" for \"2")
rule Tier2Section3201RateTwoSeventyFive(payer: Person, comp: Money, paid: Date, rendered: Date) strict {
    label en official "section 72(r)(2)(B)(ii), last sentence: 2.75 percent for services rendered after December 31, 1983 and before 1985";
    when rrta_compensation_and_dates_72r2b(payer, Section3201EmployeeTax, comp, paid, rendered);
    when paid < @1985-01-01;
    when rendered > @1983-12-31;
    when rendered < @1985-01-01;
    then tier2_portion_by_rate_72r2b(payer, Section3201EmployeeTax, paid, round(comp * 0.0275, 2, "HALF_UP"));
}
rule Tier2Sections3211And3221RateTwelveSeventyFive(payer: Person, s: RailroadTaxSection72r, comp: Money, paid: Date, rendered: Date) strict {
    label en official "section 72(r)(2)(B)(ii), last sentence: 12.75 percent for services rendered after December 31, 1983 and before 1985";
    when rrta_compensation_and_dates_72r2b(payer, s, comp, paid, rendered);
    when s != Section3201EmployeeTax;
    when paid < @1985-01-01;
    when rendered > @1983-12-31;
    when rendered < @1985-01-01;
    then tier2_portion_by_rate_72r2b(payer, s, paid, round(comp * 0.1275, 2, "HALF_UP"));
}
relation rrta_tax_imposed_and_chapter21_tax_72r2biii(payer: Person, section: RailroadTaxSection72r, services_period_end: Date, imposed: Money, chapter21_comparable: Money) kind empirical {
    label en official "the tax imposed for a period before October 1, 1981 (other than a tax imposed with respect to man-hours) and the tax that would have been imposed had the rates of the comparable chapter 21 taxes applied";
}
@source(IRC_S72_R, relation = formalizes, coverage = exact, quote = "With respect to compensation paid for services rendered during any period before October 1, 1981, the tier 2 portion shall be the excess (if any) of—")
rule Tier2PortionBeforeOctober1981IsTheExcess(payer: Person, s: RailroadTaxSection72r, end: Date, imposed: Money, comparable: Money) strict {
    label en official "section 72(r)(2)(B)(iii): the excess of the tax imposed over the tax at the chapter 21 comparable rates";
    when rrta_tax_imposed_and_chapter21_tax_72r2biii(payer, s, end, imposed, comparable);
    when end < @1981-10-01;
    when imposed > comparable;
    then tier2_portion_by_rate_72r2b(payer, s, end, round(imposed - comparable, 2, "HALF_UP"));
}
pub enum RailroadBenefitKind72r2c { SupplementalAnnuity2b; Benefit3h; Benefit4e; Benefit4h; OtherRailroadBenefit; }
relation railroad_benefit_kind_72r2c(benefit: AnnuityContract, kind: RailroadBenefitKind72r2c) kind empirical {
    label en official "the kind of railroad retirement benefit";
}
pub relation tier2_employee_contribution_not_allocable_to_benefit_72r2c(benefit: AnnuityContract) kind institutional {
    label en official "no amount treated as an employee contribution under paragraph (2) is allocated to a supplemental annuity paid under section 2(b) of the Railroad Retirement Act of 1974 or to a benefit paid under section 3(h), 4(e) or 4(h) of it";
}
@source(IRC_S72_R, relation = formalizes, coverage = exact, quote = "(i) any supplemental annuity paid under section 2(b) of the Railroad Retirement Act of 1974, or")
rule Tier2NotAllocatedToSupplementalAnnuity(benefit: AnnuityContract) strict {
    label en official "section 72(r)(2)(C)(i)";
    when railroad_benefit_kind_72r2c(benefit, SupplementalAnnuity2b);
    then tier2_employee_contribution_not_allocable_to_benefit_72r2c(benefit);
}
@source(IRC_S72_R, relation = formalizes, coverage = exact, quote = "(ii) any benefit paid under section 3(h), 4(e), or 4(h) of such Act.")
rule Tier2NotAllocatedToBenefit3h(benefit: AnnuityContract) strict {
    label en official "section 72(r)(2)(C)(ii): section 3(h)";
    when railroad_benefit_kind_72r2c(benefit, Benefit3h);
    then tier2_employee_contribution_not_allocable_to_benefit_72r2c(benefit);
}
rule Tier2NotAllocatedToBenefit4e(benefit: AnnuityContract) strict {
    label en official "section 72(r)(2)(C)(ii): section 4(e)";
    when railroad_benefit_kind_72r2c(benefit, Benefit4e);
    then tier2_employee_contribution_not_allocable_to_benefit_72r2c(benefit);
}
rule Tier2NotAllocatedToBenefit4h(benefit: AnnuityContract) strict {
    label en official "section 72(r)(2)(C)(ii): section 4(h)";
    when railroad_benefit_kind_72r2c(benefit, Benefit4h);
    then tier2_employee_contribution_not_allocable_to_benefit_72r2c(benefit);
}

// =====================================================================
// §72(w)(3): applicable nontaxable earnings
// =====================================================================

relation earnings_on_contribution_for_services_72w3A(contract: AnnuityContract, seq: Integer, amount: Money) kind empirical {
    label en official "earnings paid or accrued with respect to an employer or employee contribution made with respect to compensation for labor or personal services performed by an employee";
}
relation employee_nonresident_alien_when_earnings_accrued_72w3B(contract: AnnuityContract, seq: Integer) kind empirical {
    label en official "at the time the earnings were paid or accrued the employee was a nonresident alien for purposes of the laws of the United States";
}
relation earnings_not_subject_to_income_tax_72w3C(contract: AnnuityContract, seq: Integer) kind empirical {
    label en official "the earnings were not subject to income tax under the laws of the United States or any foreign country";
}
pub relation applicable_nontaxable_earnings_item_72w3(contract: AnnuityContract, seq: Integer, amount: Money) kind institutional {
    label en official "an item of applicable nontaxable earnings (the total is the case fact applicable_nontaxable_earnings_total: an aggregate over a derived relation is not supported)";
}
@source(IRC_S72_W, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, the term \"applicable nontaxable earnings\" means earnings—")
rule ApplicableNontaxableEarningsItem(contract: AnnuityContract, seq: Integer, amount: Money) strict {
    label en official "section 72(w)(3)(A)-(C)";
    when earnings_on_contribution_for_services_72w3A(contract, seq, amount);
    when employee_nonresident_alien_when_earnings_accrued_72w3B(contract, seq);
    when earnings_not_subject_to_income_tax_72w3C(contract, seq);
    then applicable_nontaxable_earnings_item_72w3(contract, seq, amount);
}
