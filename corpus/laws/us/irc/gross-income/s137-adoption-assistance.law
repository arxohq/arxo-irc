// Section 137 — Adoption assistance programs. Stage 2d (IRC-06). Scope:
// (a)(1)-(2) the exclusion and the special-needs-adoption increase, (b)(1)
// the $10,000 aggregate per-adoption cap, (b)(2) the $150,000/$40,000 AGI
// phase-out, (c) the adoption-assistance-program definition (cross-
// referencing section 127(b)'s already-modelled (2),(3),(5),(6)
// conditions), (d) the qualified-adoption-expenses cross-reference to
// section 23(d) (taken as a case fact — section 23 is not owned by this
// package). NOT reached: (b)(3) (the MAGI cross-reference computation
// itself), (e) (the section 23(e)-(g) special rules — married-filing-
// jointly requirement, employer-sourced-funds coordination, and the
// special-needs-domestic-adoption deemed-expenses rule), (f) beyond the
// STATUTORY BASE dollar amounts (the ongoing post-2002 COLA computation is
// SOURCE_GAP, same situation as sections 127/129/135 above: no
// `us.irc.inflation_adjustments` relation exists for section 137).
//
// JUDGMENT CALL: the $10,000/$150,000/$40,000 figures below are the 2002
// STATUTORY BASE dollar amounts (before the (f) COLA is applied); every
// taxable year after 2002 has a HIGHER indexed cap and phase-out range in
// reality. This mirrors section 132(f)'s $175/month QTF treatment from
// stage 2b (SOURCE_GAP on the indexed figure, base figure literal) rather
// than section 135's approach above (case-asserted, no literal at all) —
// the difference: section 137's 2002 base figures, unlike section 135's
// 1990 figures, are still explicitly named IN THE CURRENT STATUTORY TEXT
// itself (not superseded language), so using them as a floor is a more
// defensible minimum than omitting a literal entirely.

// =====================================================================
// §137(a): general exclusion and the special-needs increase
// =====================================================================

use self::{
    IRC_S137_A,
    IRC_S137_B,
    IRC_S137_C,
    Individual,
    Person,
    TaxableYear,
};

pub relation qualified_adoption_expenses_furnished(p: Individual, program: us.irc.core::Organ, child: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "amounts paid or expenses incurred by the employer for qualified adoption expenses in connection with the adoption of a child by the employee, furnished pursuant to an adoption assistance program (section 137(a)(1))";
}
pub relation special_needs_adoption_final_this_year(p: Individual, child: Individual, y: TaxableYear) kind empirical {
    label en official "the adoption of a child with special needs (section 23(d)(3)) becomes final during the taxable year (section 137(a)(2))";
}
pub relation qualified_adoption_expenses_after_special_needs_increase_137a2(p: Individual, program: us.irc.core::Organ, child: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "qualified adoption expenses for the year, increased to the (b)(1) $10,000 aggregate limit (less amounts taken into account in prior years) when the adoption of a special-needs child becomes final this year (section 137(a)(2))";
}
@source(IRC_S137_A, quote = "In the case of an adoption of a child with special needs which becomes final during a taxable year, the qualified adoption expenses with respect to such adoption for such year shall be increased by an amount equal to the excess (if any) of")
rule SpecialNeedsAdoptionExpensesIncreased(p: Individual, program: us.irc.core::Organ, child: Individual, y: TaxableYear, prior_amount: Money, prior_years_total: Money) strict {
    label en official "section 137(a)(2): increased to the $10,000 limit less amounts already taken into account for this adoption in prior years";
    when special_needs_adoption_final_this_year(p, child, y);
    when qualified_adoption_expenses_furnished(p, program, child, y, prior_amount);
    when qualified_adoption_expenses_taken_into_account_prior_years(p, child, prior_years_total);
    when 10000.00 USD > prior_years_total;
    then qualified_adoption_expenses_after_special_needs_increase_137a2(p, program, child, y, round(10000.00 USD - prior_years_total, 2, "HALF_UP"));
}
relation qualified_adoption_expenses_taken_into_account_prior_years(p: Individual, child: Individual, amount: Money) kind empirical {
    label en official "the aggregate amount already taken into account under section 137(a) for this adoption in prior taxable years (section 137(b)(1))";
}

// =====================================================================
// §137(b): the $10,000 cap and the AGI phase-out
// =====================================================================

pub relation adoption_expenses_aggregate_cap_exceeded_137b1(p: Individual, child: Individual, total_all_years: Money) kind institutional {
    label en official "the aggregate amount taken into account for all taxable years with respect to this adoption exceeds $10,000 (2002 statutory base — section 137(b)(1); SOURCE_GAP on the current COLA-indexed figure, see module header)";
}
@source(IRC_S137_B, quote = "The aggregate of the amounts paid or expenses incurred which may be taken into account under subsection (a) for all taxable years with respect to the adoption of a child by the taxpayer shall not exceed $10,000.")
rule AdoptionExpensesAggregateCapExceeded(p: Individual, child: Individual, total: Money) strict {
    label en official "section 137(b)(1), 2002 statutory base figure";
    when qualified_adoption_expenses_taken_into_account_prior_years(p, child, total);
    when total > 10000.00 USD;
    then adoption_expenses_aggregate_cap_exceeded_137b1(p, child, total);
}

pub relation adoption_assistance_agi_137(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "adjusted gross income for section 137(b)(2) purposes, determined without regard to this section and sections 85(c),221,911,931,933, after 86,135,219,469 (section 137(b)(3)) — case-asserted; the cross-reference computation is not derived this pass";
}
pub relation adoption_assistance_phaseout_reduction_137b2(p: Individual, y: TaxableYear, before_phaseout: Money, amount: Money) kind institutional {
    label en official "the section 137(b)(2) AGI-phase-out reduction: the exclusion is reduced (not below zero) by the ratio of (AGI minus $150,000) to $40,000 (2002 statutory base figures — SOURCE_GAP on the current COLA-indexed figures, see module header)";
}
@source(IRC_S137_B, quote = "The amount excludable from gross income under subsection (a) for any taxable year shall be reduced (but not below zero) by an amount which bears the same ratio to the amount so excludable")
rule AdoptionAssistancePhaseoutReductionApplies(p: Individual, y: TaxableYear, agi: Money, before_phaseout: Money) strict {
    label en official "section 137(b)(2)(A)-(B), 2002 statutory base figures: ratio = (AGI - 150,000) / 40,000, capped at 1.0 (not below zero already ensured by the > 150,000 guard; the ratio can exceed 1.0 above 190,000, so the reduction is capped at the full exclusion)";
    when adoption_assistance_agi_137(p, y, agi);
    when agi > 150000.00 USD;
    when adoption_assistance_exclusion_before_phaseout_137(p, y, before_phaseout);
    then adoption_assistance_phaseout_reduction_137b2(p, y, before_phaseout, min(before_phaseout, round(before_phaseout * ((agi - 150000.00 USD) / 40000.00 USD), 2, "HALF_UP")));
}
relation adoption_assistance_exclusion_before_phaseout_137(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount excludable from gross income under section 137(a) determined WITHOUT regard to the (b)(2) phase-out (section 137(b)(2), parenthetical)";
}

pub relation adoption_assistance_excluded_137a(p: Individual, program: us.irc.core::Organ, child: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the final amount excluded from gross income under section 137(a), after the (b)(2) AGI phase-out";
}
@source(IRC_S137_A, quote = "Gross income of an employee does not include amounts paid or expenses incurred by the employer for qualified adoption expenses in connection with the adoption of a child by an employee if such amounts are furnished pursuant to an adoption assistance program.")
rule AdoptionAssistanceExcludedAfterPhaseout(p: Individual, program: us.irc.core::Organ, child: Individual, y: TaxableYear, before_phaseout: Money, reduction: Money) strict {
    label en official "section 137(a), net of the (b)(2) phase-out reduction";
    when qualified_adoption_expenses_furnished(p, program, child, y, _);
    when adoption_assistance_exclusion_before_phaseout_137(p, y, before_phaseout);
    when adoption_assistance_phaseout_reduction_137b2(p, y, before_phaseout, reduction);
    when before_phaseout > reduction;
    then adoption_assistance_excluded_137a(p, program, child, y, round(before_phaseout - reduction, 2, "HALF_UP"));
}
@source(IRC_S137_A, quote = "Gross income of an employee does not include amounts paid or expenses incurred by the employer for qualified adoption expenses in connection with the adoption of a child by an employee if such amounts are furnished pursuant to an adoption assistance program.")
rule AdoptionAssistanceExcludedNoPhaseout(p: Individual, program: us.irc.core::Organ, child: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 137(a), no (b)(2) phase-out reduction applies";
    when qualified_adoption_expenses_furnished(p, program, child, y, _);
    when adoption_assistance_exclusion_before_phaseout_137(p, y, amount);
    when not_known(has_adoption_phaseout_reduction_137(p, y));
    then adoption_assistance_excluded_137a(p, program, child, y, amount);
}
relation has_adoption_phaseout_reduction_137(p: Individual, y: TaxableYear) kind institutional {
    label en official "helper binding the otherwise-open reduction amount for the not_known test above";
}
rule HasAdoptionPhaseoutReduction(p: Individual, y: TaxableYear, before: Money, reduction: Money) strict {
    label en official "helper for AdoptionAssistanceExcludedNoPhaseout";
    when adoption_assistance_phaseout_reduction_137b2(p, y, before, reduction);
    then has_adoption_phaseout_reduction_137(p, y);
}

// =====================================================================
// §137(c)/(d): program and expense definitions
// =====================================================================

pub relation adoption_assistance_program_written_137c(program: us.irc.core::Organ, employer: Person) kind empirical {
    label en official "a separate written plan of the employer for the exclusive benefit of employees, to provide adoption assistance (section 137(c))";
}
pub relation adoption_assistance_program_qualified_137c(program: us.irc.core::Organ, employer: Person, y: TaxableYear) kind institutional {
    label en official "the program is an adoption assistance program within the meaning of section 137(c) (requirements similar to section 127(b)(2),(3),(5),(6))";
}
@source(IRC_S137_C, quote = "which meets requirements similar to the requirements of paragraphs (2), (3), (5), and (6) of section 127(b)")
rule AdoptionAssistanceProgramQualified(program: us.irc.core::Organ, employer: Person, y: TaxableYear) strict {
    label en official "section 137(c): reuses this package's section 127(b) nondiscriminatory-classification/5%-owner-cap/unfunded/notice conditions (asserted here as the SAME `educational_assistance_program_qualified_127b`-style condition, but a distinct fact — section 137(c)'s own written-plan requirement is (c)'s opening clause, not (b)(1))";
    when adoption_assistance_program_written_137c(program, employer);
    when adoption_assistance_program_meets_127b_analogues(program, y);
    then adoption_assistance_program_qualified_137c(program, employer, y);
}
relation adoption_assistance_program_meets_127b_analogues(program: us.irc.core::Organ, y: TaxableYear) kind empirical {
    label en official "the program meets requirements similar to section 127(b)(2) (nondiscriminatory classification), (3) (5% owner cap), (5) (unfunded permitted), and (6) (notice) — a compound case-asserted fact, not decomposed into the four sub-tests this pass";
}

pub relation qualified_adoption_expenses_23d(p: Individual, child: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "qualified adoption expenses within the meaning of section 23(d), determined without regard to reimbursements under section 137 (section 137(d)) — a dependency on section 23, not owned by this package; case-asserted";
}
