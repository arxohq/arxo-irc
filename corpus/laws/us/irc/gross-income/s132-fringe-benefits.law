// Section 132 — Certain fringe benefits. Stage 2b (IRC-06). Scope per task:
// (a)-(f), (j).

use self::{
    IRC_S132_A,
    IRC_S132_B,
    IRC_S132_C,
    IRC_S132_D,
    IRC_S132_E,
    IRC_S132_F,
    IRC_S132_J,
    Individual,
    TaxableYear,
    section_132_inapplicable_to_fringe_132l,
};

pub enum FringeBenefitKind {
    NoAdditionalCostService;
    QualifiedEmployeeDiscount;
    WorkingConditionFringe;
    DeMinimisFringe;
    QualifiedTransportationFringe;
    QualifiedMovingExpenseReimbursement;
    QualifiedRetirementPlanningServices;
    QualifiedMilitaryBaseRealignmentAndClosureFringe;
}
pub relation fringe_benefit_provided(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, kind: FringeBenefitKind, amount: Money) kind empirical {
    label en official "a fringe benefit provided by an employer to an employee, of a kind claimed to qualify under section 132(a)";
}
pub relation fringe_benefit_qualifies(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, kind: FringeBenefitKind, amount: Money) kind institutional {
    label en official "the fringe benefit qualifies under one of the section 132(a) categories (its own subsection's test is met)";
}
pub relation fringe_benefit_excluded_132a(employee: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "gross income does not include this fringe benefit (section 132(a))";
}
@source(IRC_S132_A, quote = "Gross income shall not include any fringe benefit which qualifies as a—")
rule FringeBenefitExcluded(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, kind: FringeBenefitKind, amount: Money) strict {
    label en official "a fringe benefit meeting one of the 8 category tests is excluded, subject to the (j)(1) nondiscrimination gate for no-additional-cost service/qualified employee discount";
    when fringe_benefit_provided(employer, employee, y, kind, amount);
    when fringe_benefit_qualifies(employer, employee, y, kind, amount);
    when not_known(discriminates_in_favor_of_hce_132j1(employer, employee, y, kind));
    when not_known(section_132_inapplicable_to_fringe_132l(employer, employee, y, kind)); // G6404 wiring: §132(l)
    then fringe_benefit_excluded_132a(employee, y, amount);
}

// --- §132(b): no-additional-cost service ---------------------------------------

relation service_offered_for_sale_in_employees_line_of_business(employer: us.irc.core::Person, employee: Individual, service: us.irc.core::Asset) kind empirical {
    label en official "the service is offered for sale to customers in the ordinary course of the line of business in which the employee performs services (section 132(b)(1))";
}
relation no_substantial_additional_cost_to_employer(employer: us.irc.core::Person, employee: Individual, service: us.irc.core::Asset, y: TaxableYear) kind empirical {
    label en official "the employer incurs no substantial additional cost (including forgone revenue), determined without regard to any amount the employee pays, in providing the service (section 132(b)(2))";
}
@source(IRC_S132_B, quote = "such service is offered for sale to customers in the ordinary course of the line of business of the employer in which the employee is performing services, and")
rule NoAdditionalCostServiceQualifies(employer: us.irc.core::Person, employee: Individual, service: us.irc.core::Asset, y: TaxableYear, amount: Money) strict {
    label en official "section 132(b): a service meeting both conditions qualifies as a no-additional-cost service";
    when fringe_benefit_provided(employer, employee, y, NoAdditionalCostService, amount);
    when service_offered_for_sale_in_employees_line_of_business(employer, employee, service);
    when no_substantial_additional_cost_to_employer(employer, employee, service, y);
    then fringe_benefit_qualifies(employer, employee, y, NoAdditionalCostService, amount);
}

// --- §132(c): qualified employee discount --------------------------------------

pub enum QualifiedPropertyOrServiceKind { Property; Services; }
relation qualified_property_or_services(employer: us.irc.core::Person, employee: Individual, item: us.irc.core::Asset, kind: QualifiedPropertyOrServiceKind) kind empirical {
    label en official "property (other than real property or investment personal property) or services offered for sale to customers in the ordinary course of the employee's line of business (section 132(c)(4))";
}
relation price_offered_to_employee(employer: us.irc.core::Person, employee: Individual, item: us.irc.core::Asset, amount: Money) kind empirical {
    label en official "the price at which the property or services are provided to the employee (section 132(c)(3)(A))";
}
relation price_offered_to_customers(employer: us.irc.core::Person, item: us.irc.core::Asset, amount: Money) kind empirical {
    label en official "the price at which the property or services are offered to customers (section 132(c)(3)(B))";
}
relation gross_profit_percentage(employer: us.irc.core::Person, item: us.irc.core::Asset, percentage: Decimal) kind empirical {
    label en official "the gross profit percentage (excess of aggregate sales price over aggregate cost, as a fraction of aggregate sales price), determined on a line-of-business or reasonable-classification basis over a representative period (section 132(c)(2))";
}
pub relation qualified_employee_discount_amount(employer: us.irc.core::Person, employee: Individual, item: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the portion of an employee discount that is a qualified employee discount, within the (c)(1)(A)/(B) ceiling (section 132(c)(1))";
}
@source(IRC_S132_C, quote = "in the case of property, the gross profit percentage of the price at which the property is being offered by the employer to customers, or")
rule QualifiedEmployeeDiscountPropertyCeiling(employer: us.irc.core::Person, employee: Individual, item: us.irc.core::Asset, customer_price: Money, employee_price: Money, pct: Decimal) strict {
    label en official "for property, the qualified discount ceiling is the gross profit percentage of the customer price";
    when qualified_property_or_services(employer, employee, item, Property);
    when price_offered_to_customers(employer, item, customer_price);
    when price_offered_to_employee(employer, employee, item, employee_price);
    when gross_profit_percentage(employer, item, pct);
    when (customer_price - employee_price) <= round(customer_price * pct, 2, "HALF_UP");
    then qualified_employee_discount_amount(employer, employee, item, customer_price - employee_price);
}
@source(IRC_S132_C, quote = "in the case of services, 20 percent of the price at which the services are being offered by the employer to customers")
rule QualifiedEmployeeDiscountServicesCeiling(employer: us.irc.core::Person, employee: Individual, item: us.irc.core::Asset, customer_price: Money, employee_price: Money) strict {
    label en official "for services, the qualified discount ceiling is 20 percent of the customer price";
    when qualified_property_or_services(employer, employee, item, Services);
    when price_offered_to_customers(employer, item, customer_price);
    when price_offered_to_employee(employer, employee, item, employee_price);
    when (customer_price - employee_price) <= round(0.20 * customer_price, 2, "HALF_UP");
    then qualified_employee_discount_amount(employer, employee, item, customer_price - employee_price);
}
@source(IRC_S132_A, quote = "qualified employee discount,")
rule QualifiedEmployeeDiscountQualifies(employer: us.irc.core::Person, employee: Individual, item: us.irc.core::Asset, y: TaxableYear, amount: Money) strict {
    label en official "an employee discount within the (c) ceiling qualifies under (a)(2)";
    when fringe_benefit_provided(employer, employee, y, QualifiedEmployeeDiscount, amount);
    when qualified_employee_discount_amount(employer, employee, item, amount);
    then fringe_benefit_qualifies(employer, employee, y, QualifiedEmployeeDiscount, amount);
}

// --- §132(d): working condition fringe -----------------------------------------

relation would_be_deductible_under_162_or_167_if_employee_paid(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "if the employee had paid for the property or services, the payment would be allowable as a section 162 or 167 deduction (section 132(d))";
}
@source(IRC_S132_D, quote = "any property or services provided to an employee of the employer to the extent that, if the employee paid for such property or services, such payment would be allowable as a deduction under section 162 or 167")
rule WorkingConditionFringeQualifies(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 132(d): property/services that would generate a section 162/167 deduction if the employee paid for them qualify as a working condition fringe";
    when fringe_benefit_provided(employer, employee, y, WorkingConditionFringe, amount);
    when would_be_deductible_under_162_or_167_if_employee_paid(employer, employee, y, amount);
    then fringe_benefit_qualifies(employer, employee, y, WorkingConditionFringe, amount);
}
// §132(j)(3): a full-time auto salesman's qualified automobile demonstration
// use is treated as a working condition fringe — modelled as a further
// route into the SAME `would_be_deductible_under_162_or_167_if_employee_paid`
// fact per this package's glossary-folding convention (the demonstration-use
// facts, if asserted, ARE the (j)(3) case), not a separate rule.

// --- §132(e): de minimis fringe --------------------------------------------------

relation value_so_small_accounting_unreasonable(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the value of the property/service, considering the frequency similar fringes are provided, is so small that accounting for it is unreasonable or administratively impracticable (section 132(e)(1))";
}
@source(IRC_S132_E, quote = "The term \"de minimis fringe\" means any property or service the value of which is (after taking into account the frequency with which similar fringes are provided by the employer to the employer's employees) so small as to make accounting for it unreasonable or administratively impracticable.")
rule DeMinimisFringeQualifies(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 132(e)(1): a benefit too small to account for qualifies as a de minimis fringe";
    when fringe_benefit_provided(employer, employee, y, DeMinimisFringe, amount);
    when value_so_small_accounting_unreasonable(employer, employee, y, amount);
    then fringe_benefit_qualifies(employer, employee, y, DeMinimisFringe, amount);
}

relation eating_facility_on_or_near_business_premises(employer: us.irc.core::Person, facility: us.irc.core::Asset) kind empirical {
    label en official "an eating facility for employees located on or near the employer's business premises (section 132(e)(2)(A))";
}
relation eating_facility_revenue_covers_operating_costs(employer: us.irc.core::Person, facility: us.irc.core::Asset, y: TaxableYear) kind empirical {
    label en official "revenue from the eating facility normally equals or exceeds its direct operating costs (section 132(e)(2)(B)) — a section 119 meal exclusion is treated as payment equal to direct operating costs for this test, per the facility's own case-asserted revenue figure";
}
relation eating_facility_available_nondiscriminatorily_to_hce(employer: us.irc.core::Person, facility: us.irc.core::Asset) kind empirical {
    label en official "for a highly compensated employee, access to the facility is available on substantially the same terms to a nondiscriminatory classification of employees (section 132(e)(2), penultimate sentence)";
}
pub relation eating_facility_treated_as_de_minimis_fringe_132e2(employer: us.irc.core::Person, employee: Individual, facility: us.irc.core::Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "operation of the eating facility is treated as a de minimis fringe as to this employee's meals (section 132(e)(2))";
}
@source(IRC_S132_E, quote = "The operation by an employer of any eating facility for employees shall be treated as a de minimis fringe if—")
rule EatingFacilityDeMinimisNonHce(employer: us.irc.core::Person, employee: Individual, facility: us.irc.core::Asset, y: TaxableYear, amount: Money) strict {
    label en official "for an employee who is not highly compensated, the (e)(2)(A)/(B) location/revenue tests suffice";
    when fringe_benefit_provided(employer, employee, y, DeMinimisFringe, amount);
    when eating_facility_on_or_near_business_premises(employer, facility);
    when eating_facility_revenue_covers_operating_costs(employer, facility, y);
    when not_known(highly_compensated_individual_132(employee, y));
    then eating_facility_treated_as_de_minimis_fringe_132e2(employer, employee, facility, y, amount);
}
@source(IRC_S132_E, quote = "The preceding sentence shall apply with respect to any highly compensated employee only if access to the facility is available on substantially the same terms to each member of a group of employees which is defined under a reasonable classification set up by the employer which does not discriminate in favor of highly compensated employees.")
rule EatingFacilityDeMinimisHce(employer: us.irc.core::Person, employee: Individual, facility: us.irc.core::Asset, y: TaxableYear, amount: Money) strict {
    label en official "for a highly compensated employee, the (e)(2)(A)/(B) tests plus the nondiscriminatory-access proviso must be met";
    when fringe_benefit_provided(employer, employee, y, DeMinimisFringe, amount);
    when eating_facility_on_or_near_business_premises(employer, facility);
    when eating_facility_revenue_covers_operating_costs(employer, facility, y);
    when highly_compensated_individual_132(employee, y);
    when eating_facility_available_nondiscriminatorily_to_hce(employer, facility);
    then eating_facility_treated_as_de_minimis_fringe_132e2(employer, employee, facility, y, amount);
}
// G6404 wiring, §132(e)(2): the operation of an eating facility that meets the paragraph is treated as a
// de minimis fringe, so the fringe qualifies under (e)(1) without the value test of `DeMinimisFringeQualifies`.
@source(IRC_S132_E, quote = "The operation by an employer of any eating facility for employees shall be treated as a de minimis fringe if—")
rule DeMinimisFringeQualifiesByEatingFacility(employer: us.irc.core::Person, employee: Individual, facility: us.irc.core::Asset, y: TaxableYear, amount: Money) strict {
    label en official "section 132(e)(2): the eating-facility deeming makes the meals a de minimis fringe";
    when fringe_benefit_provided(employer, employee, y, DeMinimisFringe, amount);
    when eating_facility_treated_as_de_minimis_fringe_132e2(employer, employee, facility, y, amount);
    then fringe_benefit_qualifies(employer, employee, y, DeMinimisFringe, amount);
}
pub relation highly_compensated_individual_132(employee: Individual, y: TaxableYear) kind empirical {
    label en official "a highly compensated employee within the meaning of section 414(q) (section 132(j)(6)) — EXTERNAL_DEPENDENCY: section 414(q)'s own ranking test is not derived, asserted directly";
}

// --- §132(f): qualified transportation fringe -----------------------------------

pub enum QualifiedTransportationFringeKind {
    CommuterHighwayVehicleOrTransitPass;
    QualifiedParking;
    QualifiedBicycleCommutingReimbursement;
}
relation transportation_fringe_item(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, kind: QualifiedTransportationFringeKind, amount: Money) kind empirical {
    label en official "an item within the section 132(f)(1)(A)-(D) list (commuter highway vehicle transportation, transit pass, qualified parking, or a qualified bicycle commuting reimbursement), or a (f)(3) qualifying cash reimbursement for one";
}
pub relation qualified_transportation_fringe_monthly_limit(kind: QualifiedTransportationFringeKind, amount: Money) kind institutional {
    label en official "the section 132(f)(2) monthly dollar limitation on the qualified-transportation-fringe exclusion, before the (f)(6) inflation adjustment";
}
@source(IRC_S132_F, quote = "$175 per month in the case of the aggregate of the benefits described in subparagraphs (A) and (B) of paragraph (1),")
rule TransportationFringeLimitCommuterTransit() strict {
    label en official "the statutory (pre-inflation-adjustment) monthly limit for commuter-highway-vehicle transportation and transit passes is $175";
    then qualified_transportation_fringe_monthly_limit(CommuterHighwayVehicleOrTransitPass, 175.00 USD);
}
@source(IRC_S132_F, quote = "$175 per month in the case of qualified parking, and")
rule TransportationFringeLimitParking() strict {
    label en official "the statutory (pre-inflation-adjustment) monthly limit for qualified parking is $175";
    then qualified_transportation_fringe_monthly_limit(QualifiedParking, 175.00 USD);
}
// SOURCE_GAP: the (f)(6) inflation-adjusted monthly amount actually in
// effect for any taxable year (e.g. $315/month for 2024) is NOT pinned by
// `us.irc.inflation_adjustments` (checked: no section 132/transportation-
// fringe rule exists in that package as of this session) and is not
// invented here; only the pre-1999-base $175 statutory figure is modelled.
// The (f)(2)(C) bicycle-commuting "applicable annual limitation" ($20 x
// qualified months) is not modelled this pass (TECH_GAP: needs a per-month
// qualification count, same class as the section 152(f)(2) student test,
// not attempted here for time).
@source(IRC_S132_F, quote = "The amount of the fringe benefits which are provided by an employer to any employee and which may be excluded from gross income under subsection (a)(5) shall not exceed—")
rule QualifiedTransportationFringeQualifiesWithinLimit(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, kind: QualifiedTransportationFringeKind, amount: Money, limit: Money) strict {
    label en official "a transportation fringe item within the applicable monthly limit qualifies under (a)(5)";
    when fringe_benefit_provided(employer, employee, y, QualifiedTransportationFringe, amount);
    when transportation_fringe_item(employer, employee, y, kind, amount);
    when qualified_transportation_fringe_monthly_limit(kind, limit);
    when amount <= limit;
    then fringe_benefit_qualifies(employer, employee, y, QualifiedTransportationFringe, amount);
}
relation self_employed_within_401c1_132f5e(employee: Individual) kind empirical {
    label en official "an employee within the meaning of section 401(c)(1) (self-employed) — excluded from 'employee' for purposes of this subsection (section 132(f)(5)(E))";
}
// (f)(3) cash reimbursements, (f)(4) no constructive receipt, (f)(5)(A)-(D)
// definitions (transit pass, commuter highway vehicle, qualified parking,
// transportation-provided-by-employer) are folded into
// `transportation_fringe_item`'s own case-asserted scope; (f)(5)(F) bicycle
// definitions and (f)(6) inflation adjustment are TECH_GAP/SOURCE_GAP as
// noted above; (f)(7) working-condition/de-minimis coordination is
// NON_NORMATIVE (already respected structurally: this module's working-
// condition/de-minimis rules do not read transportation-fringe facts).
// section 132(f)(8): "Paragraph (1)(D) [bicycle commuting reimbursement]
// shall not apply to any taxable year beginning after December 31, 2017,
// and before January 1, 2026." Not modelled as a separate rule this pass:
// `QualifiedTransportationFringeQualifiesWithinLimit` above has no
// `qualified_transportation_fringe_monthly_limit(QualifiedBicycleCommutingReimbursement,
// ...)` fact for it to read (the (f)(2)(C)/(5)(F) annual-limitation
// computation itself is the TECH_GAP noted above), so a bicycle-kind item
// simply cannot qualify through that rule regardless of the suspension
// window — the (f)(8) suspension is therefore moot until the annual
// limitation is modelled, and is recorded as its own coverage row rather
// than silently treated as already handled.

// --- §132(j): special rules ------------------------------------------------------

pub relation discriminates_in_favor_of_hce_132j1(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, kind: FringeBenefitKind) kind institutional {
    label en official "the no-additional-cost-service or qualified-employee-discount fringe is provided to a highly compensated employee otherwise than on substantially the same nondiscriminatory-classification terms as other employees (section 132(j)(1)) — disqualifies (a)(1)/(a)(2) exclusion for this employee";
}
relation not_available_nondiscriminatorily_to_hce_132j1(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, kind: FringeBenefitKind) kind empirical {
    label en official "the fringe benefit is not available on substantially the same terms to a nondiscriminatory classification of employees, for this highly compensated employee (section 132(j)(1))";
}
@source(IRC_S132_J, quote = "Paragraphs (1) and (2) of subsection (a) shall apply with respect to any fringe benefit described therein provided with respect to any highly compensated employee only if such fringe benefit is available on substantially the same terms to each member of a group of employees which is defined under a reasonable classification set up by the employer which does not discriminate in favor of highly compensated employees.")
rule DiscriminatesInFavorOfHce(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, kind: FringeBenefitKind) strict {
    label en official "section 132(j)(1): a no-additional-cost-service/employee-discount fringe not nondiscriminatorily available to a HCE loses (a)(1)/(a)(2) exclusion for that employee";
    when highly_compensated_individual_132(employee, y);
    when not_available_nondiscriminatorily_to_hce_132j1(employer, employee, y, kind);
    then discriminates_in_favor_of_hce_132j1(employer, employee, y, kind);
}

relation on_premises_athletic_facility(employer: us.irc.core::Person, facility: us.irc.core::Asset, y: TaxableYear) kind empirical {
    label en official "a gym or other athletic facility located on the employer's premises, operated by the employer, substantially all of whose use is by employees, spouses, and dependent children (section 132(j)(4)(B))";
}
pub relation athletic_facility_value_excluded_132j4(employee: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "gross income does not include the value of an on-premises athletic facility (section 132(j)(4)(A))";
}
@source(IRC_S132_J, quote = "Gross income shall not include the value of any on-premises athletic facility provided by an employer to his employees.")
rule OnPremisesAthleticFacilityExcluded(employer: us.irc.core::Person, employee: Individual, facility: us.irc.core::Asset, y: TaxableYear, amount: Money) strict {
    label en official "section 132(j)(4): the value of an on-premises athletic facility is excluded";
    when on_premises_athletic_facility(employer, facility, y);
    when value_of_athletic_facility_use(employer, employee, facility, y, amount);
    then athletic_facility_value_excluded_132j4(employee, y, amount);
}
relation value_of_athletic_facility_use(employer: us.irc.core::Person, employee: Individual, facility: us.irc.core::Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the value attributable to an employee's use of the on-premises athletic facility";
}
// (j)(2) leased department-store sections, (j)(3) auto-salesman demonstration
// use (folded into (d) above), (j)(5) airline affiliates, (j)(6) HCE
// definition (folded above), (j)(7) air cargo, (j)(8) educational/training
// benefits coordination with section 127 — each a narrow special-case rule
// or cross-reference; classified EXTERNAL_DEPENDENCY/NON_NORMATIVE per the
// coverage row rather than given a dedicated rule this pass.
