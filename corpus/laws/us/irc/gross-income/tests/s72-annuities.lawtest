// Section 72 scenarios (stage 2c). NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.gross_income version "0.1.1";
namespace "urn:us:irc:gross_income:clir";

test "S72-01-EXCLUSION-RATIO-COMPUTED" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": investment_in_contract(entity_ref("urn:test:s72:r1#p"), entity_ref("urn:test:s72:r1#contract"), 60000 USD) { origin case_input; }
        assert "f1": expected_return_72c3(entity_ref("urn:test:s72:r1#p"), entity_ref("urn:test:s72:r1#contract"), 100000 USD) { origin case_input; }
    }
    evaluate truth(annuity_exclusion_ratio(entity_ref("urn:test:s72:r1#p"), entity_ref("urn:test:s72:r1#contract"), 0.6));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S72-02-EXCLUDED-AMOUNT-CAPPED-AT-UNRECOVERED-INVESTMENT" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": investment_in_contract(entity_ref("urn:test:s72:r2#p"), entity_ref("urn:test:s72:r2#contract"), 6000 USD) { origin case_input; }
        assert "f1": expected_return_72c3(entity_ref("urn:test:s72:r2#p"), entity_ref("urn:test:s72:r2#contract"), 100000 USD) { origin case_input; }
        assert "f2": amount_received_as_annuity(entity_ref("urn:test:s72:r2#p"), entity_ref("urn:test:s72:r2#contract"), entity_ref("urn:test:s72:r2#y2024"), 5000 USD) { origin case_input; }
        assert "f3": aggregate_amount_excluded_since_starting_date(entity_ref("urn:test:s72:r2#p"), entity_ref("urn:test:s72:r2#contract"), @2024-04-15, 5900 USD) { origin case_input; }
    }
    // ratio 0.06 * 5000 = 300, but unrecovered = 6000 - 5900 = 100 -> capped at 100
    evaluate truth(amount_excluded_under_annuity_exclusion_ratio(entity_ref("urn:test:s72:r2#p"), entity_ref("urn:test:s72:r2#contract"), entity_ref("urn:test:s72:r2#y2024"), @2024-04-15, 100.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S72-03-EARLY-DISTRIBUTION-NO-EXCEPTION-10-PERCENT-TAX" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": retirement_plan_distribution_received(entity_ref("urn:test:s72t:no-exception#p"), entity_ref("urn:test:s72t:no-exception#d"), entity_ref("urn:test:s72t:no-exception#y2024"), 10000 USD) { origin case_input; }
    }
    evaluate truth(early_distribution_additional_tax(entity_ref("urn:test:s72t:no-exception#p"), entity_ref("urn:test:s72t:no-exception#d"), entity_ref("urn:test:s72t:no-exception#y2024"), 1000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S72-04-EARLY-DISTRIBUTION-AGE-59-HALF-EXACT-DATE-EXEMPT" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": retirement_plan_distribution_received(entity_ref("urn:test:s72t:age59#p"), entity_ref("urn:test:s72t:age59#d"), entity_ref("urn:test:s72t:age59#y2024"), 10000 USD) { origin case_input; }
        assert "f1": distribution_date(entity_ref("urn:test:s72t:age59#d"), @2024-03-01) { origin case_input; }
        assert "f2": employee_attains_age_59_half_on(entity_ref("urn:test:s72t:age59#p"), @2024-03-01) { origin case_input; }
    }
    evaluate truth(distribution_fully_exempt_72t(entity_ref("urn:test:s72t:age59#d")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(early_distribution_additional_tax(entity_ref("urn:test:s72t:age59#p"), entity_ref("urn:test:s72t:age59#d"), entity_ref("urn:test:s72t:age59#y2024"), 0.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S72-05-EARLY-DISTRIBUTION-DAY-BEFORE-59-HALF-NOT-EXEMPT" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": retirement_plan_distribution_received(entity_ref("urn:test:s72t:day-before#p"), entity_ref("urn:test:s72t:day-before#d"), entity_ref("urn:test:s72t:day-before#y2024"), 10000 USD) { origin case_input; }
        assert "f1": distribution_date(entity_ref("urn:test:s72t:day-before#d"), @2024-02-29) { origin case_input; }
        assert "f2": employee_attains_age_59_half_on(entity_ref("urn:test:s72t:day-before#p"), @2024-03-01) { origin case_input; }
    }
    evaluate truth(distribution_fully_exempt_72t(entity_ref("urn:test:s72t:day-before#d")));
    expect truth_status == FALSE_ONLY;
    evaluate truth(early_distribution_additional_tax(entity_ref("urn:test:s72t:day-before#p"), entity_ref("urn:test:s72t:day-before#d"), entity_ref("urn:test:s72t:day-before#y2024"), 1000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S72-06-BIRTH-OR-ADOPTION-DISTRIBUTION-CAPPED-AT-5000" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": retirement_plan_distribution_received(entity_ref("urn:test:s72t:birth#p"), entity_ref("urn:test:s72t:birth#d"), entity_ref("urn:test:s72t:birth#y2024"), 7000 USD) { origin case_input; }
        assert "f1": qualified_birth_or_adoption_distribution_amount(entity_ref("urn:test:s72t:birth#d"), 7000 USD) { origin case_input; }
    }
    // exempt portion capped at 5000; tax on the remaining 2000
    evaluate truth(early_distribution_additional_tax(entity_ref("urn:test:s72t:birth#p"), entity_ref("urn:test:s72t:birth#d"), entity_ref("urn:test:s72t:birth#y2024"), 200.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S72-07-DOMESTIC-ABUSE-DISTRIBUTION-WITHIN-CAP-FULLY-EXEMPT" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": retirement_plan_distribution_received(entity_ref("urn:test:s72t:abuse#p"), entity_ref("urn:test:s72t:abuse#d"), entity_ref("urn:test:s72t:abuse#y2024"), 4000 USD) { origin case_input; }
        assert "f1": domestic_abuse_distribution_amount(entity_ref("urn:test:s72t:abuse#p"), entity_ref("urn:test:s72t:abuse#d"), 4000 USD) { origin case_input; }
        assert "f2": nonforfeitable_accrued_benefit_pv_72t(entity_ref("urn:test:s72t:abuse#p"), 100000 USD) { origin case_input; }
    }
    // cap = min(10000, 50000) = 10000; distribution 4000 is within cap
    evaluate truth(early_distribution_additional_tax(entity_ref("urn:test:s72t:abuse#p"), entity_ref("urn:test:s72t:abuse#d"), entity_ref("urn:test:s72t:abuse#y2024"), 0.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S72-08-PLAN-LOAN-WITHIN-LIMIT-AND-TERMS-NO-DEEMED-DISTRIBUTION" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_loan_made(entity_ref("urn:test:s72p:ok#p"), entity_ref("urn:test:s72p:ok#plan"), @2024-01-15, 20000 USD) { origin case_input; }
        assert "f1": loan_balance_excess_before_this_loan(entity_ref("urn:test:s72p:ok#p"), entity_ref("urn:test:s72p:ok#plan"), @2024-01-15, 0 USD) { origin case_input; }
        assert "f2": nonforfeitable_accrued_benefit_pv(entity_ref("urn:test:s72p:ok#p"), entity_ref("urn:test:s72p:ok#plan"), @2024-01-15, 60000 USD) { origin case_input; }
        assert "f3": loan_repayable_within_5_years(entity_ref("urn:test:s72p:ok#p"), entity_ref("urn:test:s72p:ok#plan"), @2024-01-15) { origin case_input; }
        assert "f4": loan_level_amortization(entity_ref("urn:test:s72p:ok#p"), entity_ref("urn:test:s72p:ok#plan"), @2024-01-15) { origin case_input; }
    }
    // limit = min(50000, max(30000,10000)) = 30000; loan 20000 <= limit
    evaluate truth(plan_loan_deemed_distribution(entity_ref("urn:test:s72p:ok#p"), entity_ref("urn:test:s72p:ok#plan"), @2024-01-15, 0.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S72-09-PLAN-LOAN-FAILS-5-YEAR-TERM-WHOLE-LOAN-DEEMED-DISTRIBUTION" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_loan_made(entity_ref("urn:test:s72p:no-term#p"), entity_ref("urn:test:s72p:no-term#plan"), @2024-01-15, 20000 USD) { origin case_input; }
    }
    // no repayment-term facts asserted at all -> plan_loan_repayment_terms_satisfied_72p2 is not_known
    evaluate truth(plan_loan_deemed_distribution(entity_ref("urn:test:s72p:no-term#p"), entity_ref("urn:test:s72p:no-term#plan"), @2024-01-15, 20000.00 USD));
    expect truth_status == TRUE_ONLY;
}
