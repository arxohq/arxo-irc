// Section 135 scenarios (stage 2d). NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.gross_income version "0.1.1";
namespace "urn:us:irc:gross_income:clir";

test "S135-01-BOND-ELIGIBLE-BY-AGE-AND-DATE" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": qualified_us_savings_bond_135c1(entity_ref("urn:test:s135:bond1#bond"), @2020-01-01, 30) { origin case_input; }
    }
    evaluate truth(qualified_us_savings_bond_135c1_eligible(entity_ref("urn:test:s135:bond1#bond")));
    expect truth_status == TRUE_ONLY;
}

test "S135-02-EXCLUSION-CAPPED-BY-APPLICABLE-FRACTION-WHEN-PROCEEDS-EXCEED-EXPENSES" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": qualified_bonds_redeemed_proceeds(entity_ref("urn:test:s135:frac1#p"), entity_ref("urn:test:s135:frac1#y2024"), 10000 USD) { origin case_input; }
        assert "f1": savings_bond_interest_portion_of_proceeds(entity_ref("urn:test:s135:frac1#p"), entity_ref("urn:test:s135:frac1#y2024"), 4000 USD) { origin case_input; }
        assert "f2": qualified_higher_education_expenses_135c2(entity_ref("urn:test:s135:frac1#p"), entity_ref("urn:test:s135:frac1#y2024"), entity_ref("urn:test:s135:frac1#p"), 5000 USD) { origin case_input; }
        assert "f3": no_educational_benefit_reductions(entity_ref("urn:test:s135:frac1#p"), entity_ref("urn:test:s135:frac1#y2024"), entity_ref("urn:test:s135:frac1#p")) { origin case_input; }
    }
    // applicable fraction = 5000/10000 = 0.5; before-limit exclusion = 4000; after (b)(1) = 2000
    evaluate truth(savings_bond_exclusion_after_proceeds_limit_135b1(entity_ref("urn:test:s135:frac1#p"), entity_ref("urn:test:s135:frac1#y2024"), 2000.00 USD));
    expect truth_status == TRUE_ONLY;
}
