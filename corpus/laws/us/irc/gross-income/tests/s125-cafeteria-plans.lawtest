test "S125-01-CHOICE-AMONG-BENEFITS-NOT-INCLUDED" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": cafeteria_plan_choice_among_benefits(entity_ref("urn:test:s125:choice1#p"), entity_ref("urn:test:s125:choice1#plan"), entity_ref("urn:test:s125:choice1#y2024"), 3000 USD) { origin case_input; }
    }
    evaluate truth(cafeteria_plan_amount_not_included_125a(entity_ref("urn:test:s125:choice1#p"), entity_ref("urn:test:s125:choice1#plan"), entity_ref("urn:test:s125:choice1#y2024"), 3000.00 USD));
    expect truth_status == TRUE_ONLY;
}

