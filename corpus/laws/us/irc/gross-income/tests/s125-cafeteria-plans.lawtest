    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": simple_cafeteria_plan_established_125j2(entity_ref("urn:test:s125:simple1#plan"), entity_ref("urn:test:s125:simple1#employer")) { origin case_input; }
        assert "f1": simple_cafeteria_uniform_contribution_2pct_125j3Ai(entity_ref("urn:test:s125:simple1#plan"), entity_ref("urn:test:s125:simple1#y2024")) { origin case_input; }
        assert "f2": simple_cafeteria_all_1000_hour_employees_eligible_125j4Ai(entity_ref("urn:test:s125:simple1#plan"), entity_ref("urn:test:s125:simple1#y2024")) { origin case_input; }
        assert "f3": simple_cafeteria_uniform_election_terms_125j4Aii(entity_ref("urn:test:s125:simple1#plan"), entity_ref("urn:test:s125:simple1#y2024")) { origin case_input; }
    }
    evaluate truth(simple_cafeteria_plan_deemed_nondiscriminatory_125j1(entity_ref("urn:test:s125:simple1#plan"), entity_ref("urn:test:s125:simple1#y2024")));
    expect truth_status == TRUE_ONLY;
}
