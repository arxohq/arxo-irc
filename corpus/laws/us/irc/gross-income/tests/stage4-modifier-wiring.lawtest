        assert "f3": formula_price_never_lapsing_restriction(entity_ref("urn:test:s4w:83f1#p"), entity_ref("urn:test:s4w:83f1#asset")) { origin case_input; }
        assert "f4": formula_price(entity_ref("urn:test:s4w:83f1#p"), entity_ref("urn:test:s4w:83f1#asset"), 8000 USD) { origin case_input; }
    }
    // the deemed price 8000, not the asserted transfer value 5000
    evaluate truth(section_83_inclusion(entity_ref("urn:test:s4w:83f1#p"), entity_ref("urn:test:s4w:83f1#asset"), entity_ref("urn:test:s4w:83f1#y"), 8000 USD));
    expect truth_status == TRUE_ONLY;
}

