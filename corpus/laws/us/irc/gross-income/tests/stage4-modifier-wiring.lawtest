test "S4W-72E8D-01-PRO-RATA-ONLY-ON-THE-EXCESS-OVER-1986-INVESTMENT" {
    given {
        context { legal_time @2026-09-26; decision_time @2026-09-26T09:00:00-05:00; knowledge_time @2026-09-26T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": amount_received_not_as_annuity(entity_ref("urn:test:s4w:72e8a#p"), entity_ref("urn:test:s4w:72e8a#contract"), entity_ref("urn:test:s4w:72e8a#y"), @2024-06-01, 10000 USD) { origin case_input; }
        assert "f1": contract_described_in_72e5d(entity_ref("urn:test:s4w:72e8a#contract")) { origin case_input; }
        assert "f2": premiums_paid_before_date(entity_ref("urn:test:s4w:72e8a#p"), entity_ref("urn:test:s4w:72e8a#contract"), @2024-06-01, 20000 USD) { origin case_input; }
        assert "f3": excludable_receipts_before_date(entity_ref("urn:test:s4w:72e8a#p"), entity_ref("urn:test:s4w:72e8a#contract"), @2024-06-01, 0 USD) { origin case_input; }
        assert "f4": account_balance_72e8(entity_ref("urn:test:s4w:72e8a#p"), entity_ref("urn:test:s4w:72e8a#contract"), @2024-06-01, 100000 USD) { origin case_input; }
        assert "f5": plan_permitted_withdrawal_of_employee_contributions_on_19860505_72e8D(entity_ref("urn:test:s4w:72e8a#contract")) { origin case_input; }
        assert "f6": investment_in_contract_as_of_19861231_72e8D(entity_ref("urn:test:s4w:72e8a#p"), entity_ref("urn:test:s4w:72e8a#contract"), 8000 USD) { origin case_input; }
        assert "f7": amounts_received_after_19861231_before_this_receipt_72e8D(entity_ref("urn:test:s4w:72e8a#p"), entity_ref("urn:test:s4w:72e8a#contract"), 3000 USD) { origin case_input; }
    }
    // excess = min(10000, 10000 + 3000 - 8000) = 5000; 5000 - 5000 * (20000 / 100000) = 4000
    evaluate truth(nonannuity_amount_includible_72e(entity_ref("urn:test:s4w:72e8a#p"), entity_ref("urn:test:s4w:72e8a#contract"), entity_ref("urn:test:s4w:72e8a#y"), @2024-06-01, 4000 USD));
    expect truth_status == TRUE_ONLY;
}

