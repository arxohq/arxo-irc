        assert "f1": proceeds_for_nongovernmental_output_property(entity_ref("urn:test:s141-10-output-property-acquisition-over-lesser-of-5-percent-and-5m-is-pab#issue"), 5000001 USD) { origin case_input; }
    }
    // lesser of 5 percent x 200,000,000 = 10,000,000 and 5,000,000 = 5,000,000; 5,000,001 exceeds it
    evaluate truth(private_activity_bond(entity_ref("urn:test:s141-10-output-property-acquisition-over-lesser-of-5-percent-and-5m-is-pab#issue")));
    expect truth_status == TRUE_ONLY;
}

test "S141-11-OUTPUT-PROPERTY-ACQUISITION-AT-THE-LESSER-AMOUNT-NOT-PAB" {
    given {
        context {
            legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": issue_total_proceeds(entity_ref("urn:test:s141-11-output-property-acquisition-at-the-lesser-amount-not-pab#issue"), 200000000 USD) { origin case_input; }
        assert "f1": proceeds_for_nongovernmental_output_property(entity_ref("urn:test:s141-11-output-property-acquisition-at-the-lesser-amount-not-pab#issue"), 5000000 USD) { origin case_input; }
    }
    evaluate truth(nongovernmental_output_property_test_met_141d1(entity_ref("urn:test:s141-11-output-property-acquisition-at-the-lesser-amount-not-pab#issue")));
