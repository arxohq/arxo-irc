test "S108-09-QPRI-ORDERING-PARTIAL-QUALIFYING-LOAN" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": loan_partially_qualified_principal_residence_indebtedness_108h4(entity_ref("urn:test:s108:ord1#loan"), 10000 USD) { origin case_input; }
        assert "f1": indebtedness_is_qualified_principal_residence_indebtedness(entity_ref("urn:test:s108:ord1#p"), entity_ref("urn:test:s108:ord1#y2024"), 40000 USD) { origin case_input; }
    }
    // discharged 40000, non-QPRI portion 10000 -> exclusion applies only to 30000
    evaluate truth(qpri_exclusion_amount_after_ordering_108h4(entity_ref("urn:test:s108:ord1#p"), entity_ref("urn:test:s108:ord1#loan"), entity_ref("urn:test:s108:ord1#y2024"), 30000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
