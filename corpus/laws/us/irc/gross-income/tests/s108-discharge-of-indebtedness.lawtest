// Section 108 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.gross_income version "0.1.1";
namespace "urn:us:irc:gross_income:clir";

test "S108-01-TITLE-11-DISCHARGE-EXCLUDED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": discharge_of_indebtedness_amount(entity_ref("urn:test:s108:t11#p"), entity_ref("urn:test:s108:t11#y2024"), 40000 USD) { origin case_input; }
        assert "f1": discharge_occurs_in_title_11_case(entity_ref("urn:test:s108:t11#p"), entity_ref("urn:test:s108:t11#y2024"), 40000 USD) { origin case_input; }
    }
    evaluate truth(discharge_of_indebtedness_excluded_108a(entity_ref("urn:test:s108:t11#p"), entity_ref("urn:test:s108:t11#y2024"), 40000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S108-02-INSOLVENCY-EXCLUSION-CAPPED-AT-INSOLVENCY-AMOUNT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": discharge_of_indebtedness_amount(entity_ref("urn:test:s108:ins1#p"), entity_ref("urn:test:s108:ins1#y2024"), 50000 USD) { origin case_input; }
        assert "f1": taxpayer_insolvent_at_discharge(entity_ref("urn:test:s108:ins1#p"), entity_ref("urn:test:s108:ins1#y2024"), 20000 USD) { origin case_input; }
    }
    // 50000 discharged, only insolvent to the extent of 20000 -> excluded = min(50000,20000) = 20000
    evaluate truth(discharge_of_indebtedness_excluded_108a(entity_ref("urn:test:s108:ins1#p"), entity_ref("urn:test:s108:ins1#y2024"), 20000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S108-03-QPRI-TAKES-PRECEDENCE-OVER-INSOLVENCY-ABSENT-ELECTION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": discharge_of_indebtedness_amount(entity_ref("urn:test:s108:qpri1#p"), entity_ref("urn:test:s108:qpri1#y2024"), 30000 USD) { origin case_input; }
        assert "f1": taxpayer_insolvent_at_discharge(entity_ref("urn:test:s108:qpri1#p"), entity_ref("urn:test:s108:qpri1#y2024"), 10000 USD) { origin case_input; }
        assert "f2": indebtedness_is_qualified_principal_residence_indebtedness(entity_ref("urn:test:s108:qpri1#p"), entity_ref("urn:test:s108:qpri1#y2024"), 30000 USD) { origin case_input; }
        assert "f3": discharge_before_2026_or_written_arrangement_before_2026(entity_ref("urn:test:s108:qpri1#p"), entity_ref("urn:test:s108:qpri1#y2024"), 30000 USD) { origin case_input; }
    }
    evaluate truth(discharge_of_indebtedness_excluded_108a(entity_ref("urn:test:s108:qpri1#p"), entity_ref("urn:test:s108:qpri1#y2024"), 30000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    // the insolvency-based exclusion is displaced (would have given 10000, not 30000)
    evaluate truth(discharge_of_indebtedness_excluded_108a(entity_ref("urn:test:s108:qpri1#p"), entity_ref("urn:test:s108:qpri1#y2024"), 10000.00 USD));
    expect truth_status == FALSE_ONLY;
}

test "S108-04-ATTRIBUTE-REDUCTION-RATES" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
    }
    evaluate truth(section_108_attribute_reduction_rate(NetOperatingLoss, 1.00));
    expect truth_status == TRUE_ONLY;
    evaluate truth(section_108_attribute_reduction_rate(GeneralBusinessCredit, 0.3333333333));
    expect truth_status == TRUE_ONLY;
}

