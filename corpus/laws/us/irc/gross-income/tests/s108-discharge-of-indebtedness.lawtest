    }
    evaluate truth(purchase_price_adjustment_not_discharge_income_108e5(entity_ref("urn:test:s108:pma1#purchaser"), entity_ref("urn:test:s108:pma1#seller"), entity_ref("urn:test:s108:pma1#y2024"), 5000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

