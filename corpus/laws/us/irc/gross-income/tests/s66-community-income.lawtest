// Section 66 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.gross_income version "0.1.1";
namespace "urn:us:irc:gross_income:clir";

test "S66-01-SPOUSES-LIVE-APART-COMMUNITY-INCOME-UNDER-879A" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": married_to(entity_ref("urn:test:s66:apart1#p"), entity_ref("urn:test:s66:apart1#spouse"), entity_ref("urn:test:s66:apart1#y2024")) { origin case_input; }
        assert "f1": live_apart_all_year(entity_ref("urn:test:s66:apart1#p"), entity_ref("urn:test:s66:apart1#spouse"), entity_ref("urn:test:s66:apart1#y2024")) { origin case_input; }
        assert "f2": earned_income_is_community_income(entity_ref("urn:test:s66:apart1#p"), entity_ref("urn:test:s66:apart1#spouse"), entity_ref("urn:test:s66:apart1#y2024"), 20000 USD) { origin case_input; }
    }
    evaluate truth(community_income_treated_under_879a(entity_ref("urn:test:s66:apart1#p"), entity_ref("urn:test:s66:apart1#spouse"), entity_ref("urn:test:s66:apart1#y2024")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S66-02-INCOME-TRANSFERRED-BETWEEN-SPOUSES-EXCLUDED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": married_to(entity_ref("urn:test:s66:xfer1#p"), entity_ref("urn:test:s66:xfer1#spouse"), entity_ref("urn:test:s66:xfer1#y2024")) { origin case_input; }
        assert "f1": live_apart_all_year(entity_ref("urn:test:s66:xfer1#p"), entity_ref("urn:test:s66:xfer1#spouse"), entity_ref("urn:test:s66:xfer1#y2024")) { origin case_input; }
        assert "f2": earned_income_is_community_income(entity_ref("urn:test:s66:xfer1#p"), entity_ref("urn:test:s66:xfer1#spouse"), entity_ref("urn:test:s66:xfer1#y2024"), 20000 USD) { origin case_input; }
        assert "f3": earned_income_transferred_between_spouses(entity_ref("urn:test:s66:xfer1#p"), entity_ref("urn:test:s66:xfer1#spouse"), entity_ref("urn:test:s66:xfer1#y2024")) { origin case_input; }
    }
    evaluate truth(community_income_treated_under_879a(entity_ref("urn:test:s66:xfer1#p"), entity_ref("urn:test:s66:xfer1#spouse"), entity_ref("urn:test:s66:xfer1#y2024")));
    expect truth_status == NEITHER;
}

test "S66-03-RELIEF-REALLOCATION-INEQUITABLE-JUDGMENT-TRUE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": no_joint_return_filed(entity_ref("urn:test:s66:relief1#p"), entity_ref("urn:test:s66:relief1#y2024")) { origin case_input; }
        assert "f1": community_income_item_not_included(entity_ref("urn:test:s66:relief1#p"), entity_ref("urn:test:s66:relief1#spouse"), entity_ref("urn:test:s66:relief1#y2024"), 4000 USD) { origin case_input; }
        assert "f2": no_knowledge_or_reason_to_know(entity_ref("urn:test:s66:relief1#p"), entity_ref("urn:test:s66:relief1#y2024"), 4000 USD) { origin case_input; }
        assert "f3": inequitable_to_include_in_gross_income(entity_ref("urn:test:s66:relief1#p"), entity_ref("urn:test:s66:relief1#spouse"), entity_ref("urn:test:s66:relief1#y2024"), 4000 USD) { origin adjudicated; }
    }
    evaluate truth(community_income_relief_reallocated_to_other_spouse(entity_ref("urn:test:s66:relief1#p"), entity_ref("urn:test:s66:relief1#spouse"), entity_ref("urn:test:s66:relief1#y2024"), 4000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S66-04-RELIEF-DENIED-WHEN-INEQUITABLE-JUDGMENT-UNKNOWN" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": no_joint_return_filed(entity_ref("urn:test:s66:relief2#p"), entity_ref("urn:test:s66:relief2#y2024")) { origin case_input; }
        assert "f1": community_income_item_not_included(entity_ref("urn:test:s66:relief2#p"), entity_ref("urn:test:s66:relief2#spouse"), entity_ref("urn:test:s66:relief2#y2024"), 4000 USD) { origin case_input; }
        assert "f2": no_knowledge_or_reason_to_know(entity_ref("urn:test:s66:relief2#p"), entity_ref("urn:test:s66:relief2#y2024"), 4000 USD) { origin case_input; }
    }
    // No Secretary judgment on record on whether inclusion would be inequitable.
    evaluate truth(community_income_relief_reallocated_to_other_spouse(entity_ref("urn:test:s66:relief2#p"), entity_ref("urn:test:s66:relief2#spouse"), entity_ref("urn:test:s66:relief2#y2024"), 4000 USD));
    expect truth_status == NEITHER;
}
