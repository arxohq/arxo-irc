// Section 67 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.gross_income version "0.1.1";
namespace "urn:us:irc:gross_income:clir";

test "S67-01-TWO-PERCENT-FLOOR-PRE-2018-JUST-ABOVE" {
    given {
        context {
            legal_time @2017-04-15;
            decision_time @2017-04-15T09:00:00-05:00;
            knowledge_time @2017-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": adjusted_gross_income(entity_ref("urn:test:s67:pre1#p"), entity_ref("urn:test:s67:pre1#y2017"), 100000 USD) { origin case_input; }
        assert "f1": miscellaneous_itemized_deduction_item(entity_ref("urn:test:s67:pre1#p"), entity_ref("urn:test:s67:pre1#y2017"), 1, 2500 USD) { origin case_input; }
    }
    // floor = 2% * 100000 = 2000; allowed = 2500 - 2000 = 500.
    evaluate truth(miscellaneous_itemized_deductions_allowed(entity_ref("urn:test:s67:pre1#p"), entity_ref("urn:test:s67:pre1#y2017"), 500 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S67-02-TWO-PERCENT-FLOOR-PRE-2018-AT-THRESHOLD-NO-DEDUCTION" {
    given {
        context {
            legal_time @2017-04-15;
            decision_time @2017-04-15T09:00:00-05:00;
            knowledge_time @2017-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": adjusted_gross_income(entity_ref("urn:test:s67:pre2#p"), entity_ref("urn:test:s67:pre2#y2017"), 100000 USD) { origin case_input; }
        assert "f1": miscellaneous_itemized_deduction_item(entity_ref("urn:test:s67:pre2#p"), entity_ref("urn:test:s67:pre2#y2017"), 1, 2000 USD) { origin case_input; }
    }
    // aggregate (2000) does not EXCEED the floor (2000): the rule's ">" guard fails.
    evaluate truth(miscellaneous_itemized_deductions_allowed(entity_ref("urn:test:s67:pre2#p"), entity_ref("urn:test:s67:pre2#y2017"), 0 USD));
    expect truth_status == NEITHER;
}

test "S67-03-SUSPENDED-2018-2025" {
    given {
        context {
            legal_time @2020-04-15;
            decision_time @2020-04-15T09:00:00-05:00;
            knowledge_time @2020-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
    }
    evaluate truth(miscellaneous_itemized_deductions_allowed(entity_ref("urn:test:s67:susp1#p"), entity_ref("urn:test:s67:susp1#y2020"), 0.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S67-04-PERMANENTLY-SUSPENDED-FROM-2026-NO-EDUCATOR-ITEM" {
    given {
        context {
            legal_time @2026-04-15;
            decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::filing_status(entity_ref("urn:test:s67:perm1#p"), entity_ref("urn:test:s67:perm1#y2026"), Unmarried) { origin case_input; }
    }
    evaluate truth(miscellaneous_itemized_deductions_allowed(entity_ref("urn:test:s67:perm1#p"), entity_ref("urn:test:s67:perm1#y2026"), 0.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S67-05-IMPAIRMENT-RELATED-WORK-EXPENSE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": handicapped_individual_190b3(entity_ref("urn:test:s67:imp1#p")) { origin case_input; }
        assert "f1": attendant_care_expense_at_workplace(entity_ref("urn:test:s67:imp1#p"), entity_ref("urn:test:s67:imp1#y2024"), 3000 USD) { origin case_input; }
        assert "f2": section_162_deduction_allowable_without_regard_to_67(entity_ref("urn:test:s67:imp1#p"), entity_ref("urn:test:s67:imp1#y2024"), 3000 USD) { origin case_input; }
    }
    evaluate truth(impairment_related_work_expense(entity_ref("urn:test:s67:imp1#p"), entity_ref("urn:test:s67:imp1#y2024"), 3000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
