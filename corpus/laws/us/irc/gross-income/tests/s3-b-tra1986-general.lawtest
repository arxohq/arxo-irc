    }
    evaluate truth(state_or_local_bond_interest_excluded_103a(entity_ref("urn:test:s1311-316-the-exclusion-is-the-section-103a-conclusion#p"), entity_ref("urn:test:s1311-316-the-exclusion-is-the-section-103a-conclusion#y"), entity_ref("urn:test:s1311-316-the-exclusion-is-the-section-103a-conclusion#b"), 3000.00 USD));
    expect truth_status == TRUE_ONLY;
}
