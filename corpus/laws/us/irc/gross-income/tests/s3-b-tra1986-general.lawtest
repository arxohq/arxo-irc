    }
    evaluate truth(grandfathered_bond_interest_excluded_103a(entity_ref("urn:test:s1311-317-a-bond-the-amendments-reach-is-not-grandfathered#p"), entity_ref("urn:test:s1311-317-a-bond-the-amendments-reach-is-not-grandfathered#y"), entity_ref("urn:test:s1311-317-a-bond-the-amendments-reach-is-not-grandfathered#b"), 3000.00 USD));
