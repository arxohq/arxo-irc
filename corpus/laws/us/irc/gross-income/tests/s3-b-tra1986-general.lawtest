        assert "f1": bond_issued_by(entity_ref("urn:test:s1311-316-the-exclusion-is-the-section-103a-conclusion#b"), entity_ref("urn:test:s1311-316-the-exclusion-is-the-section-103a-conclusion#iss")) { origin case_input; }
        assert "f2": bond_part_of_issue(entity_ref("urn:test:s1311-316-the-exclusion-is-the-section-103a-conclusion#b"), entity_ref("urn:test:s1311-316-the-exclusion-is-the-section-103a-conclusion#i")) { origin case_input; }
        assert "f3": bond_interest_amount_transition_1986(entity_ref("urn:test:s1311-316-the-exclusion-is-the-section-103a-conclusion#p"), entity_ref("urn:test:s1311-316-the-exclusion-is-the-section-103a-conclusion#y"), entity_ref("urn:test:s1311-316-the-exclusion-is-the-section-103a-conclusion#b"), 3000 USD) { origin case_input; }
