// NOTE: uses a pre-1990 year (1985), not 2024: for 2018-2025 the (d)(5)
// zeroing makes `base_exemption_amount_151` $0, so the (d)(1)(B) "gross
// income less than the exemption amount" test can never be satisfied by a
// nonnegative gross income figure in that window (see S152-07 below, which
// exercises exactly that). Only the pre-1990 statutory $2,000 base (or a
// genuinely indexed 1990-2017/post-2025 amount, which is SOURCE_GAP G283
// and not concluded by any rule) gives a nonzero exemption amount to test
// the "below the exemption amount" branch against.
test "S152-06-QUALIFYING-RELATIVE-GROSS-INCOME-BELOW-EXEMPTION" {
    given {
        context {
            legal_time @1985-04-15;
            decision_time @1985-04-15T09:00:00-05:00;
            knowledge_time @1985-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": bears_relative_relationship_152d2(entity_ref("urn:test:s152:rel1#relative"), entity_ref("urn:test:s152:rel1#taxpayer")) { origin case_input; }
        // anchors `y1985` for BaseExemptionAmountStatutory (range restriction).
        assert "fs": us.irc.income_individual::filing_status(entity_ref("urn:test:s152:rel1#taxpayer"), entity_ref("urn:test:s152:rel1#y1985"), Unmarried) { origin case_input; }
        assert "f1": gross_income_of_individual(entity_ref("urn:test:s152:rel1#relative"), entity_ref("urn:test:s152:rel1#y1985"), 500 USD) { origin case_input; }
        assert "f2": taxpayer_directly_provides_over_half_support(entity_ref("urn:test:s152:rel1#taxpayer"), entity_ref("urn:test:s152:rel1#relative"), entity_ref("urn:test:s152:rel1#y1985")) { origin case_input; }
    }
    evaluate truth(qualifying_relative_of(entity_ref("urn:test:s152:rel1#relative"), entity_ref("urn:test:s152:rel1#taxpayer"), entity_ref("urn:test:s152:rel1#y1985")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S152-07-QUALIFYING-RELATIVE-GROSS-INCOME-AT-EXEMPTION-FAILS" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": bears_relative_relationship_152d2(entity_ref("urn:test:s152:rel2#relative"), entity_ref("urn:test:s152:rel2#taxpayer")) { origin case_input; }
        // anchors `y2024` for BaseExemptionAmountZeroed2018To2025 (range restriction).
        assert "fs": us.irc.income_individual::filing_status(entity_ref("urn:test:s152:rel2#taxpayer"), entity_ref("urn:test:s152:rel2#y2024"), Unmarried) { origin case_input; }
        // gross income exactly at the (zeroed, 2018-2025) exemption amount of $0 fails the "less than" test.
        assert "f1": gross_income_of_individual(entity_ref("urn:test:s152:rel2#relative"), entity_ref("urn:test:s152:rel2#y2024"), 0 USD) { origin case_input; }
        assert "f2": taxpayer_directly_provides_over_half_support(entity_ref("urn:test:s152:rel2#taxpayer"), entity_ref("urn:test:s152:rel2#relative"), entity_ref("urn:test:s152:rel2#y2024")) { origin case_input; }
    }
    evaluate truth(qualifying_relative_of(entity_ref("urn:test:s152:rel2#relative"), entity_ref("urn:test:s152:rel2#taxpayer"), entity_ref("urn:test:s152:rel2#y2024")));
    expect truth_status == FALSE_ONLY;
}

test "S152-08-DIVORCED-PARENTS-NONCUSTODIAL-RELEASE-BY-DECLARATION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": child_receives_over_half_support_from_parents_152e1a(entity_ref("urn:test:s152:e1#child"), entity_ref("urn:test:s152:e1#custodial"), entity_ref("urn:test:s152:e1#noncustodial"), entity_ref("urn:test:s152:e1#y2024")) { origin case_input; }
        assert "f1": parents_divorced_or_legally_separated(entity_ref("urn:test:s152:e1#custodial"), entity_ref("urn:test:s152:e1#noncustodial"), entity_ref("urn:test:s152:e1#y2024")) { origin case_input; }
        assert "f2": child_in_custody_more_than_half_year_152e1b(entity_ref("urn:test:s152:e1#child"), entity_ref("urn:test:s152:e1#custodial"), entity_ref("urn:test:s152:e1#noncustodial"), entity_ref("urn:test:s152:e1#y2024")) { origin case_input; }
        assert "f3": custody_days_152e(entity_ref("urn:test:s152:e1#custodial"), entity_ref("urn:test:s152:e1#child"), entity_ref("urn:test:s152:e1#y2024"), 240) { origin case_input; }
        assert "f4": custody_days_152e(entity_ref("urn:test:s152:e1#noncustodial"), entity_ref("urn:test:s152:e1#child"), entity_ref("urn:test:s152:e1#y2024"), 126) { origin case_input; }
        assert "f5": custodial_parent_signs_written_declaration_152e2a(entity_ref("urn:test:s152:e1#custodial"), entity_ref("urn:test:s152:e1#child"), entity_ref("urn:test:s152:e1#y2024")) { origin case_input; }
        assert "f6": noncustodial_parent_attaches_declaration_152e2b(entity_ref("urn:test:s152:e1#noncustodial"), entity_ref("urn:test:s152:e1#child"), entity_ref("urn:test:s152:e1#y2024")) { origin case_input; }
        assert "f7": bears_child_relationship_152c2a(entity_ref("urn:test:s152:e1#child"), entity_ref("urn:test:s152:e1#noncustodial")) { origin case_input; }
        assert "f8": younger_than_claiming_taxpayer(entity_ref("urn:test:s152:e1#child"), entity_ref("urn:test:s152:e1#noncustodial")) { origin case_input; }
        assert "f9": under_19_at_close_of_calendar_year(entity_ref("urn:test:s152:e1#child"), entity_ref("urn:test:s152:e1#y2024")) { origin case_input; }
        assert "f10": not_provided_over_half_own_support_152c1d(entity_ref("urn:test:s152:e1#child"), entity_ref("urn:test:s152:e1#y2024")) { origin case_input; }
    }
    evaluate truth(noncustodial_parent_release_152e(entity_ref("urn:test:s152:e1#child"), entity_ref("urn:test:s152:e1#noncustodial"), entity_ref("urn:test:s152:e1#y2024")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(qualifying_child_of(entity_ref("urn:test:s152:e1#child"), entity_ref("urn:test:s152:e1#noncustodial"), entity_ref("urn:test:s152:e1#y2024")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

