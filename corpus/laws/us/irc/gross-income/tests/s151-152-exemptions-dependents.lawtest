// Sections 151-152 scenarios. NOT EXECUTED (implemented_unverified, per
// NO-HEAVY-CHECKS). Expectations are worked from the statutory text, not
// from any engine run.

language "law.core" version "0.2";
package us.irc.gross_income version "0.1.1";
namespace "urn:us:irc:gross_income:clir";

test "S152-01-QUALIFYING-CHILD-SOLE-CLAIMANT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": bears_child_relationship_152c2a(entity_ref("urn:test:s152:sole1#child"), entity_ref("urn:test:s152:sole1#taxpayer")) { origin case_input; }
        assert "f1": same_principal_abode_more_than_half_year(entity_ref("urn:test:s152:sole1#child"), entity_ref("urn:test:s152:sole1#taxpayer"), entity_ref("urn:test:s152:sole1#y2024")) { origin case_input; }
        assert "f2": younger_than_claiming_taxpayer(entity_ref("urn:test:s152:sole1#child"), entity_ref("urn:test:s152:sole1#taxpayer")) { origin case_input; }
        assert "f3": under_19_at_close_of_calendar_year(entity_ref("urn:test:s152:sole1#child"), entity_ref("urn:test:s152:sole1#y2024")) { origin case_input; }
        assert "f4": not_provided_over_half_own_support_152c1d(entity_ref("urn:test:s152:sole1#child"), entity_ref("urn:test:s152:sole1#y2024")) { origin case_input; }
    }
    evaluate truth(qualifying_child_of(entity_ref("urn:test:s152:sole1#child"), entity_ref("urn:test:s152:sole1#taxpayer"), entity_ref("urn:test:s152:sole1#y2024")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S152-02-AGE-19-NOT-STUDENT-FAILS-QUALIFYING-CHILD" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": bears_child_relationship_152c2a(entity_ref("urn:test:s152:age1#child"), entity_ref("urn:test:s152:age1#taxpayer")) { origin case_input; }
        assert "f1": same_principal_abode_more_than_half_year(entity_ref("urn:test:s152:age1#child"), entity_ref("urn:test:s152:age1#taxpayer"), entity_ref("urn:test:s152:age1#y2024")) { origin case_input; }
        assert "f2": younger_than_claiming_taxpayer(entity_ref("urn:test:s152:age1#child"), entity_ref("urn:test:s152:age1#taxpayer")) { origin case_input; }
        assert "f3": not_provided_over_half_own_support_152c1d(entity_ref("urn:test:s152:age1#child"), entity_ref("urn:test:s152:age1#y2024")) { origin case_input; }
        // no under-19, no student+under-24, no disability fact asserted: age test fails, NEITHER.
    }
    evaluate truth(qualifying_child_of(entity_ref("urn:test:s152:age1#child"), entity_ref("urn:test:s152:age1#taxpayer"), entity_ref("urn:test:s152:age1#y2024")));
    expect truth_status == NEITHER;
}

test "S152-03-TIE-BREAK-PARENT-DEFEATS-NONPARENT-CLAIMANT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": bears_child_relationship_152c2a(entity_ref("urn:test:s152:tie1#child"), entity_ref("urn:test:s152:tie1#parent")) { origin case_input; }
        assert "f1": same_principal_abode_more_than_half_year(entity_ref("urn:test:s152:tie1#child"), entity_ref("urn:test:s152:tie1#parent"), entity_ref("urn:test:s152:tie1#y2024")) { origin case_input; }
        assert "f2": younger_than_claiming_taxpayer(entity_ref("urn:test:s152:tie1#child"), entity_ref("urn:test:s152:tie1#parent")) { origin case_input; }
        assert "f3": under_19_at_close_of_calendar_year(entity_ref("urn:test:s152:tie1#child"), entity_ref("urn:test:s152:tie1#y2024")) { origin case_input; }
        assert "f4": not_provided_over_half_own_support_152c1d(entity_ref("urn:test:s152:tie1#child"), entity_ref("urn:test:s152:tie1#y2024")) { origin case_input; }
        assert "f5": is_parent_of(entity_ref("urn:test:s152:tie1#parent"), entity_ref("urn:test:s152:tie1#child")) { origin case_input; }

        assert "g0": bears_sibling_relationship_152c2b(entity_ref("urn:test:s152:tie1#child"), entity_ref("urn:test:s152:tie1#aunt")) { origin case_input; }
        assert "g1": same_principal_abode_more_than_half_year(entity_ref("urn:test:s152:tie1#child"), entity_ref("urn:test:s152:tie1#aunt"), entity_ref("urn:test:s152:tie1#y2024")) { origin case_input; }
        assert "g2": younger_than_claiming_taxpayer(entity_ref("urn:test:s152:tie1#child"), entity_ref("urn:test:s152:tie1#aunt")) { origin case_input; }
        assert "g3": under_19_at_close_of_calendar_year(entity_ref("urn:test:s152:tie1#child"), entity_ref("urn:test:s152:tie1#y2024")) { origin case_input; }
        assert "g4": not_provided_over_half_own_support_152c1d(entity_ref("urn:test:s152:tie1#child"), entity_ref("urn:test:s152:tie1#y2024")) { origin case_input; }
    }
    evaluate truth(qualifying_child_of(entity_ref("urn:test:s152:tie1#child"), entity_ref("urn:test:s152:tie1#parent"), entity_ref("urn:test:s152:tie1#y2024")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(qualifying_child_of(entity_ref("urn:test:s152:tie1#child"), entity_ref("urn:test:s152:tie1#aunt"), entity_ref("urn:test:s152:tie1#y2024")));
    expect truth_status == FALSE_ONLY;
}

