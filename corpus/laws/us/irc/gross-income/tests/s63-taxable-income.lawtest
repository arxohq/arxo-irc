// Section 63 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.gross_income version "0.1.1";
namespace "urn:us:irc:gross_income:clir";

test "S63-01-BASIC-STANDARD-DEDUCTION-SINGLE-2024" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::filing_status(entity_ref("urn:test:s63:single1#p"), entity_ref("urn:test:s63:single1#y2024"), Unmarried) { origin case_input; }
    }
    // 2024 is within the section 63(c)(7) window [2018,2025): $12,000 (statutory
    // base, unindexed; SOURCE_GAP for the Rev. Proc.-published amount).
    evaluate truth(basic_standard_deduction(entity_ref("urn:test:s63:single1#p"), entity_ref("urn:test:s63:single1#y2024"), 12000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S63-02-BASIC-STANDARD-DEDUCTION-JOINT-2025-OBBBA" {
    given {
        context {
            legal_time @2025-04-15;
