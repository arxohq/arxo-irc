test "S63-08-NON-ITEMIZER-FORMULA-APPLIES-BY-DEFAULT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::filing_status(entity_ref("urn:test:s63:nonitem1#p"), entity_ref("urn:test:s63:nonitem1#y2024"), Unmarried) { origin case_input; }
        assert "f1": adjusted_gross_income(entity_ref("urn:test:s63:nonitem1#p"), entity_ref("urn:test:s63:nonitem1#y2024"), 50000.00 USD) { origin case_input; }
        assert "f2": standard_deduction(entity_ref("urn:test:s63:nonitem1#p"), entity_ref("urn:test:s63:nonitem1#y2024"), 12000.00 USD) { origin case_input; }
        assert "f3": personal_exemption_deduction_151(entity_ref("urn:test:s63:nonitem1#p"), entity_ref("urn:test:s63:nonitem1#y2024"), 0.00 USD) { origin case_input; }
        assert "f4": section_199a_deduction(entity_ref("urn:test:s63:nonitem1#p"), entity_ref("urn:test:s63:nonitem1#y2024"), 0.00 USD) { origin case_input; }
        assert "f5": section_170p_deduction(entity_ref("urn:test:s63:nonitem1#p"), entity_ref("urn:test:s63:nonitem1#y2024"), 0.00 USD) { origin case_input; }
    }
    // No election-to-itemize fact asserted: the section 63(b) formula applies.
    evaluate truth(taxable_income(entity_ref("urn:test:s63:nonitem1#p"), entity_ref("urn:test:s63:nonitem1#y2024"), 38000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
