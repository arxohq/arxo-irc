test "S63-04-DEPENDENT-BASIC-STANDARD-DEDUCTION-CAPPED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::filing_status(entity_ref("urn:test:s63:dep1#p"), entity_ref("urn:test:s63:dep1#y2024"), Unmarried) { origin case_input; }
        assert "f1": claimed_as_dependent_151(entity_ref("urn:test:s63:dep1#p"), entity_ref("urn:test:s63:dep1#y2024")) { origin case_input; }
        assert "f2": earned_income_of(entity_ref("urn:test:s63:dep1#p"), entity_ref("urn:test:s63:dep1#y2024"), 100.00 USD) { origin case_input; }
    }
    // uncapped $12,000 (2024, unmarried); cap = greater of $500 or ($250+$100=$350) = $500.
    evaluate truth(basic_standard_deduction(entity_ref("urn:test:s63:dep1#p"), entity_ref("urn:test:s63:dep1#y2024"), 500.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S63-05-DEPENDENT-EARNED-INCOME-ABOVE-CAP-NOT-BINDING" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::filing_status(entity_ref("urn:test:s63:dep2#p"), entity_ref("urn:test:s63:dep2#y2024"), Unmarried) { origin case_input; }
        assert "f1": claimed_as_dependent_151(entity_ref("urn:test:s63:dep2#p"), entity_ref("urn:test:s63:dep2#y2024")) { origin case_input; }
        assert "f2": earned_income_of(entity_ref("urn:test:s63:dep2#p"), entity_ref("urn:test:s63:dep2#y2024"), 20000.00 USD) { origin case_input; }
    }
    // $250 + $20,000 earned = $20,250, which exceeds the $12,000 uncapped
    // amount, so the cap does not bind: the amount stays $12,000.
    evaluate truth(basic_standard_deduction(entity_ref("urn:test:s63:dep2#p"), entity_ref("urn:test:s63:dep2#y2024"), 12000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

