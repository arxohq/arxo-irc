            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::filing_status(entity_ref("urn:test:s63:joint1#p"), entity_ref("urn:test:s63:joint1#y2025"), Joint) { origin case_input; }
    }
    // 2025: Pub. L. 119-21 section 70102(b) base $15,750, doubled by (c)(2)(A) for a joint return = $31,500.
    evaluate truth(basic_standard_deduction(entity_ref("urn:test:s63:joint1#p"), entity_ref("urn:test:s63:joint1#y2025"), 31500.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

