// Section 129 scenarios (stage 2d). NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.gross_income version "0.1.1";
namespace "urn:us:irc:gross_income:clir";

test "S129-01-EXCLUSION-CAPPED-AT-5000-UNMARRIED" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": dependent_care_program_written_129d1(entity_ref("urn:test:s129:cap1#program"), entity_ref("urn:test:s129:cap1#employer")) { origin case_input; }
        assert "f1": dependent_care_program_classification_nondiscriminatory_129d3(entity_ref("urn:test:s129:cap1#program"), entity_ref("urn:test:s129:cap1#y2024")) { origin case_input; }
        assert "f2": shareholder_owner_class_share_129d4(entity_ref("urn:test:s129:cap1#program"), entity_ref("urn:test:s129:cap1#y2024"), 0.0) { origin case_input; }
        assert "f3": dependent_care_average_benefits_test_129d8(entity_ref("urn:test:s129:cap1#program"), entity_ref("urn:test:s129:cap1#y2024"), 0.60) { origin case_input; }
        assert "f4": dependent_care_assistance_furnished(entity_ref("urn:test:s129:cap1#p"), entity_ref("urn:test:s129:cap1#program"), entity_ref("urn:test:s129:cap1#y2024"), 7000 USD) { origin case_input; }
        assert "f5": earned_income_129(entity_ref("urn:test:s129:cap1#p"), entity_ref("urn:test:s129:cap1#y2024"), 60000 USD) { origin case_input; }
        assert "f6": us.irc.core::begins(entity_ref("urn:test:s129:cap1#y2024"), @2024-01-01) { origin case_input; }
    }
    evaluate truth(dependent_care_assistance_excluded_129a(entity_ref("urn:test:s129:cap1#p"), entity_ref("urn:test:s129:cap1#program"), entity_ref("urn:test:s129:cap1#y2024"), 5000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S129-02-55-PERCENT-AVERAGE-BENEFITS-TEST-FAILS-BELOW-55" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": dependent_care_program_written_129d1(entity_ref("urn:test:s129:fail1#program"), entity_ref("urn:test:s129:fail1#employer")) { origin case_input; }
        assert "f1": dependent_care_program_classification_nondiscriminatory_129d3(entity_ref("urn:test:s129:fail1#program"), entity_ref("urn:test:s129:fail1#y2024")) { origin case_input; }
        assert "f2": shareholder_owner_class_share_129d4(entity_ref("urn:test:s129:fail1#program"), entity_ref("urn:test:s129:fail1#y2024"), 0.0) { origin case_input; }
        assert "f3": dependent_care_average_benefits_test_129d8(entity_ref("urn:test:s129:fail1#program"), entity_ref("urn:test:s129:fail1#y2024"), 0.40) { origin case_input; }
    }
    evaluate truth(dependent_care_program_qualified_129d(entity_ref("urn:test:s129:fail1#program"), entity_ref("urn:test:s129:fail1#y2024")));
    expect truth_status == FALSE_ONLY;
}

test "S129-03-MARRIED-EARNED-INCOME-LESSER-OF-SPOUSES" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": married_at_close_of_year_129(entity_ref("urn:test:s129:mfj1#p"), entity_ref("urn:test:s129:mfj1#y2024")) { origin case_input; }
        assert "f1": earned_income_129(entity_ref("urn:test:s129:mfj1#p"), entity_ref("urn:test:s129:mfj1#y2024"), 80000 USD) { origin case_input; }
        assert "f2": spouse_earned_income_129(entity_ref("urn:test:s129:mfj1#p"), entity_ref("urn:test:s129:mfj1#y2024"), 3000 USD) { origin case_input; }
    }
    evaluate truth(dependent_care_earned_income_limit_129b(entity_ref("urn:test:s129:mfj1#p"), entity_ref("urn:test:s129:mfj1#y2024"), 3000.00 USD));
    expect truth_status == TRUE_ONLY;
}
