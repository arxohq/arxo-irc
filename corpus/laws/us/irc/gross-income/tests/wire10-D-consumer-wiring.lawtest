test "W10-D-GI-05-SERVICE-BETWEEN-THE-DESIGNATED-DATES-IS-IN-THE-COMBAT-ZONE" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": combat_zone_combatant_activities_commenced_112c3(entity_ref("urn:test:w10dgi2:z1#z"), @1990-08-02) { origin case_input; }
        assert "f1": combat_zone_combatant_activities_terminated_112c3(entity_ref("urn:test:w10dgi2:z1#z"), @1991-02-28) { origin case_input; }
        assert "f2": present_in_combat_zone_area_on_112c3(entity_ref("urn:test:w10dgi2:z1#p"), entity_ref("urn:test:w10dgi2:z1#z"), @1991-01-17) { origin case_input; }
    }
    evaluate truth(service_performed_in_combat_zone_on_112c3(entity_ref("urn:test:w10dgi2:z1#p"), entity_ref("urn:test:w10dgi2:z1#z"), @1991-01-17));
    expect truth_status == TRUE_ONLY;
}

