        assert "f1": us.irc.core::calendar_year_of(entity_ref("urn:test:w10dgi:g3#y"), 2026) { origin case_input; }
    }
    evaluate truth(bracket_37_percent_begins_at(entity_ref("urn:test:w10dgi:g3#p"), entity_ref("urn:test:w10dgi:g3#y"), 720000 USD));
