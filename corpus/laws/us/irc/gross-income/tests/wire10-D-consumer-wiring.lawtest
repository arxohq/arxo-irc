// Gross income WIRE-10 group D consumer-wiring scenarios. NOT EXECUTED (implemented_unverified); no legal review.

language "law.core" version "0.2";
package us.irc.gross_income version "0.1.1";
namespace "urn:us:irc:gross_income:clir";

test "W10-D-GI-01-37-PERCENT-BRACKET-BEGINS-AT-THE-INDEXED-BOUND-OF-THE-OWNER" {
    given {
        context {
            legal_time @2026-12-31;
            decision_time @2026-12-31T09:00:00-05:00;
            knowledge_time @2026-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::filing_status(entity_ref("urn:test:w10dgi:g1#p"), entity_ref("urn:test:w10dgi:g1#y"), us.irc.income_individual::Joint) { origin case_input; }
        assert "f1": us.irc.core::calendar_year_of(entity_ref("urn:test:w10dgi:g1#y"), 2026) { origin case_input; }
        assert "f2": us.irc.income_individual::cola_terms(2017, 2025, 1200.0, 1000.0) { origin case_input; }
    }
    evaluate truth(bracket_37_percent_begins_at(entity_ref("urn:test:w10dgi:g1#p"), entity_ref("urn:test:w10dgi:g1#y"), 720000 USD));
    expect truth_status == TRUE_ONLY;
}

test "W10-D-GI-02-UNMARRIED-BOUND-USES-THE-STEP-OF-25" {
    given {
        context {
            legal_time @2026-12-31;
