        assert "f1": us.irc.core::calendar_year_of(entity_ref("urn:test:w10dgi:g2#y"), 2026) { origin case_input; }
        assert "f2": us.irc.income_individual::cola_terms(2017, 2025, 1200.0, 1000.0) { origin case_input; }
    }
    evaluate truth(bracket_37_percent_begins_at(entity_ref("urn:test:w10dgi:g2#p"), entity_ref("urn:test:w10dgi:g2#y"), 600000 USD));
    expect truth_status == TRUE_ONLY;
}

test "W10-D-GI-03-NO-INDEX-INPUT-LEAVES-THE-BOUND-UNESTABLISHED" {
    given {
        context {
