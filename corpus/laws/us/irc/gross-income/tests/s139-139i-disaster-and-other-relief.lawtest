// Sections 139-139I scenarios (stage 2d). NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.gross_income version "0.1.1";
namespace "urn:us:irc:gross_income:clir";

test "S139-01-DISASTER-RELIEF-PAYMENT-EXCLUDED" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": qualified_disaster_139c(entity_ref("urn:test:s139:d1#disaster")) { origin case_input; }
        assert "f1": qualified_disaster_relief_payment(entity_ref("urn:test:s139:d1#p"), entity_ref("urn:test:s139:d1#y2024"), PersonalFamilyLivingOrFuneralExpenses, 5000 USD, entity_ref("urn:test:s139:d1#disaster")) { origin case_input; }
    }
    evaluate truth(qualified_disaster_relief_payment_excluded_139a(entity_ref("urn:test:s139:d1#p"), entity_ref("urn:test:s139:d1#y2024"), 5000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S139B-01-VOLUNTEER-RESPONDER-PAYMENT-CAPPED-AT-50-PER-MONTH" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": qualified_volunteer_emergency_responder_139b(entity_ref("urn:test:s139b:v1#p")) { origin case_input; }
        assert "f1": qualified_state_local_tax_benefit_139b(entity_ref("urn:test:s139b:v1#p"), entity_ref("urn:test:s139b:v1#y2024"), 200 USD) { origin case_input; }
        assert "f2": qualified_payment_139b_amount(entity_ref("urn:test:s139b:v1#p"), entity_ref("urn:test:s139b:v1#y2024"), 12, 1000 USD) { origin case_input; }
    }
    // cap = 50 * 12 = 600; excluded total = 200 + 600 = 800
    evaluate truth(qualified_payment_139b_capped(entity_ref("urn:test:s139b:v1#p"), entity_ref("urn:test:s139b:v1#y2024"), 12, 600.00 USD));
    expect truth_status == TRUE_ONLY;
    evaluate truth(volunteer_emergency_responder_excluded_139b(entity_ref("urn:test:s139b:v1#p"), entity_ref("urn:test:s139b:v1#y2024"), 800.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S139H-01-IRS-SEIZURE-INTEREST-EXCLUDED" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": irs_seizure_interest_received_139h(entity_ref("urn:test:s139h:i1#p"), entity_ref("urn:test:s139h:i1#y2024"), 300 USD) { origin case_input; }
    }
    evaluate truth(irs_seizure_interest_excluded_139h(entity_ref("urn:test:s139h:i1#p"), entity_ref("urn:test:s139h:i1#y2024"), 300.00 USD));
    expect truth_status == TRUE_ONLY;
}
