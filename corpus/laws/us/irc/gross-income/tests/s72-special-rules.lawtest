        assert "f0": railroad_retirement_benefit(entity_ref("urn:test:s72-124-railroad-tier-1-benefit-not-treated-as-employer-plan-benefit#c")) { origin case_input; }
        assert "f1": tier_1_railroad_retirement_benefit(entity_ref("urn:test:s72-124-railroad-tier-1-benefit-not-treated-as-employer-plan-benefit#c")) { origin case_input; }
    }
    evaluate truth(treated_as_qualified_employer_plan_benefit_72r1(entity_ref("urn:test:s72-124-railroad-tier-1-benefit-not-treated-as-employer-plan-benefit#c")));
    expect truth_status == NEITHER;
}

