// Section 61 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.gross_income version "0.1.1";
namespace "urn:us:irc:gross_income:clir";

test "S61-01-WAGES-ARE-GROSS-INCOME" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": gross_income_item(entity_ref("urn:test:s61:w1#p"), entity_ref("urn:test:s61:w1#y2024"), CompensationForServices, 60000 USD) { origin case_input; }
    }
    evaluate truth(gross_income(entity_ref("urn:test:s61:w1#p"), entity_ref("urn:test:s61:w1#y2024"), 60000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S61-02-MULTIPLE-ITEMS-AGGREGATE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": gross_income_item(entity_ref("urn:test:s61:multi1#p"), entity_ref("urn:test:s61:multi1#y2024"), CompensationForServices, 60000 USD) { origin case_input; }
        assert "f1": gross_income_item(entity_ref("urn:test:s61:multi1#p"), entity_ref("urn:test:s61:multi1#y2024"), Interest, 500 USD) { origin case_input; }
        assert "f2": gross_income_item(entity_ref("urn:test:s61:multi1#p"), entity_ref("urn:test:s61:multi1#y2024"), Dividends, 1200 USD) { origin case_input; }
    }
    // §61(a): all income from whatever source derived, including but not
    // limited to the listed items — the sum of the three asserted items.
    evaluate truth(gross_income(entity_ref("urn:test:s61:multi1#p"), entity_ref("urn:test:s61:multi1#y2024"), 61700 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S61-03-DISCHARGE-OF-INDEBTEDNESS-IS-GROSS-INCOME" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": gross_income_item(entity_ref("urn:test:s61:codi1#p"), entity_ref("urn:test:s61:codi1#y2024"), DischargeOfIndebtedness, 5000 USD) { origin case_input; }
    }
    evaluate truth(gross_income(entity_ref("urn:test:s61:codi1#p"), entity_ref("urn:test:s61:codi1#y2024"), 5000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S61-04-NO-ITEMS-ASSERTED-UNDETERMINED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
    }
    // Open-world: with no `gross_income_item` fact at all, the aggregate rule
    // never fires (its only positive binder is `gross_income_item` itself) —
    // NOT the same statement as "gross income is zero" (see s61-gross-income.law
    // module comment); a case wanting zero gross income asserts it directly.
    evaluate truth(gross_income(entity_ref("urn:test:s61:empty1#p"), entity_ref("urn:test:s61:empty1#y2024"), 0 USD));
    expect truth_status == NEITHER;
}
