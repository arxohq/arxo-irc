// Section 137 scenarios (stage 2d). NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.gross_income version "0.1.1";
namespace "urn:us:irc:gross_income:clir";

test "S137-01-AGGREGATE-CAP-EXCEEDED-OVER-10000" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": qualified_adoption_expenses_taken_into_account_prior_years(entity_ref("urn:test:s137:cap1#p"), entity_ref("urn:test:s137:cap1#child"), 12000 USD) { origin case_input; }
    }
    evaluate truth(adoption_expenses_aggregate_cap_exceeded_137b1(entity_ref("urn:test:s137:cap1#p"), entity_ref("urn:test:s137:cap1#child"), 12000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S137-02-AGI-PHASEOUT-REDUCTION-COMPUTED" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": adoption_assistance_agi_137(entity_ref("urn:test:s137:phase1#p"), entity_ref("urn:test:s137:phase1#y2024"), 170000 USD) { origin case_input; }
        assert "f1": adoption_assistance_exclusion_before_phaseout_137(entity_ref("urn:test:s137:phase1#p"), entity_ref("urn:test:s137:phase1#y2024"), 8000 USD) { origin case_input; }
        assert "f2": qualified_adoption_expenses_furnished(entity_ref("urn:test:s137:phase1#p"), entity_ref("urn:test:s137:phase1#program"), entity_ref("urn:test:s137:phase1#child"), entity_ref("urn:test:s137:phase1#y2024"), 8000 USD) { origin case_input; }
    }
    // ratio = (170000-150000)/40000 = 0.5; reduction = 8000*0.5 = 4000; excluded = 8000-4000 = 4000
    evaluate truth(adoption_assistance_phaseout_reduction_137b2(entity_ref("urn:test:s137:phase1#p"), entity_ref("urn:test:s137:phase1#y2024"), 8000 USD, 4000.00 USD));
    expect truth_status == TRUE_ONLY;
    evaluate truth(adoption_assistance_excluded_137a(entity_ref("urn:test:s137:phase1#p"), entity_ref("urn:test:s137:phase1#program"), entity_ref("urn:test:s137:phase1#child"), entity_ref("urn:test:s137:phase1#y2024"), 4000.00 USD));
    expect truth_status == TRUE_ONLY;
}
