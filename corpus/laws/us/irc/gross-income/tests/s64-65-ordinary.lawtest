// Sections 64-65 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.gross_income version "0.1.1";
namespace "urn:us:irc:gross_income:clir";

test "S64-01-GAIN-ON-NONCAPITAL-NON-1231B-PROPERTY-IS-ORDINARY" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": property_disposed(entity_ref("urn:test:s64:g1#p"), entity_ref("urn:test:s64:g1#asset")) { origin case_input; }
        assert "f1": gain_from_sale_or_exchange_of_property(entity_ref("urn:test:s64:g1#p"), entity_ref("urn:test:s64:g1#y2024"), 3000 USD) { origin case_input; }
    }
    evaluate truth(ordinary_income(entity_ref("urn:test:s64:g1#p"), entity_ref("urn:test:s64:g1#y2024"), entity_ref("urn:test:s64:g1#asset"), 3000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S64-02-GAIN-ON-KNOWN-CAPITAL-ASSET-NOT-ORDINARY" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": property_disposed(entity_ref("urn:test:s64:g2#p"), entity_ref("urn:test:s64:g2#asset")) { origin case_input; }
        assert "f1": gain_from_sale_or_exchange_of_property(entity_ref("urn:test:s64:g2#p"), entity_ref("urn:test:s64:g2#y2024"), 3000 USD) { origin case_input; }
        assert "f2": is_capital_asset(entity_ref("urn:test:s64:g2#p"), entity_ref("urn:test:s64:g2#asset")) { origin case_input; }
    }
    evaluate truth(ordinary_income(entity_ref("urn:test:s64:g2#p"), entity_ref("urn:test:s64:g2#y2024"), entity_ref("urn:test:s64:g2#asset"), 3000 USD));
    expect truth_status == NEITHER;
}

test "S65-01-LOSS-ON-NONCAPITAL-PROPERTY-IS-ORDINARY" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": property_disposed(entity_ref("urn:test:s65:l1#p"), entity_ref("urn:test:s65:l1#asset")) { origin case_input; }
        assert "f1": loss_from_sale_or_exchange_of_property(entity_ref("urn:test:s65:l1#p"), entity_ref("urn:test:s65:l1#y2024"), 1500 USD) { origin case_input; }
    }
    evaluate truth(ordinary_loss(entity_ref("urn:test:s65:l1#p"), entity_ref("urn:test:s65:l1#y2024"), entity_ref("urn:test:s65:l1#asset"), 1500 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
