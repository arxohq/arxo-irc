// Section 101 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.gross_income version "0.1.1";
namespace "urn:us:irc:gross_income:clir";

test "S101-01-DEATH-PROCEEDS-EXCLUDED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": paid_by_reason_of_death_of_insured(entity_ref("urn:test:s101:d1#beneficiary"), entity_ref("urn:test:s101:d1#contract"), entity_ref("urn:test:s101:d1#y2024"), 250000 USD) { origin case_input; }
    }
    evaluate truth(life_insurance_proceeds_excluded_101a(entity_ref("urn:test:s101:d1#beneficiary"), entity_ref("urn:test:s101:d1#contract"), entity_ref("urn:test:s101:d1#y2024"), 250000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S101-02-TRANSFER-FOR-VALUE-CAPS-EXCLUSION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": contract_transferred_for_valuable_consideration(entity_ref("urn:test:s101:tv1#p"), entity_ref("urn:test:s101:tv1#contract"), entity_ref("urn:test:s101:tv1#y2024")) { origin case_input; }
        assert "fp": paid_by_reason_of_death_of_insured(entity_ref("urn:test:s101:tv1#p"), entity_ref("urn:test:s101:tv1#contract"), entity_ref("urn:test:s101:tv1#y2024"), 100000 USD) { origin case_input; }
        assert "f1": actual_value_of_consideration_paid(entity_ref("urn:test:s101:tv1#p"), entity_ref("urn:test:s101:tv1#contract"), 30000 USD) { origin case_input; }
        assert "f2": premiums_and_other_amounts_subsequently_paid_by_transferee(entity_ref("urn:test:s101:tv1#p"), entity_ref("urn:test:s101:tv1#contract"), entity_ref("urn:test:s101:tv1#y2024"), 5000 USD) { origin case_input; }
    }
    // 100000 proceeds, cap = 30000 + 5000 = 35000
    evaluate truth(life_insurance_proceeds_excluded_up_to_cap_101a2(entity_ref("urn:test:s101:tv1#p"), entity_ref("urn:test:s101:tv1#contract"), entity_ref("urn:test:s101:tv1#y2024"), 35000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S101-03-TRANSFER-TO-INSURED-EXEMPT-FROM-CAP" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": contract_transferred_for_valuable_consideration(entity_ref("urn:test:s101:tv2#p"), entity_ref("urn:test:s101:tv2#contract"), entity_ref("urn:test:s101:tv2#y2024")) { origin case_input; }
        assert "f1": transfer_to_insured_partner_partnership_or_corporation(entity_ref("urn:test:s101:tv2#p"), entity_ref("urn:test:s101:tv2#contract")) { origin case_input; }
        assert "f2": paid_by_reason_of_death_of_insured(entity_ref("urn:test:s101:tv2#p"), entity_ref("urn:test:s101:tv2#contract"), entity_ref("urn:test:s101:tv2#y2024"), 100000 USD) { origin case_input; }
    }
    evaluate truth(transfer_for_value_cap_applies_101a2(entity_ref("urn:test:s101:tv2#p"), entity_ref("urn:test:s101:tv2#contract"), entity_ref("urn:test:s101:tv2#y2024"), 100000 USD));
    expect truth_status == NEITHER;
    evaluate truth(life_insurance_proceeds_excluded_101a(entity_ref("urn:test:s101:tv2#p"), entity_ref("urn:test:s101:tv2#contract"), entity_ref("urn:test:s101:tv2#y2024"), 100000 USD));
    expect truth_status == TRUE_ONLY;
}

