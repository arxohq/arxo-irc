            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": received_under_life_insurance_contract_on_life_of(entity_ref("urn:test:s101:g1#p"), entity_ref("urn:test:s101:g1#insured"), entity_ref("urn:test:s101:g1#y2024"), 50000 USD) { origin case_input; }
        assert "f1": certified_terminally_ill(entity_ref("urn:test:s101:g1#insured"), entity_ref("urn:test:s101:g1#y2024")) { origin case_input; }
    }
    evaluate truth(treated_as_paid_by_reason_of_death_101g(entity_ref("urn:test:s101:g1#p"), entity_ref("urn:test:s101:g1#insured"), entity_ref("urn:test:s101:g1#y2024"), 50000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

