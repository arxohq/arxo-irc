test "S132-06-HCE-DISCRIMINATION-DISQUALIFIES-EMPLOYEE-DISCOUNT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": fringe_benefit_provided(entity_ref("urn:test:s132:hce1#employer"), entity_ref("urn:test:s132:hce1#employee"), entity_ref("urn:test:s132:hce1#y2024"), QualifiedEmployeeDiscount, 250 USD) { origin case_input; }
        assert "f1": qualified_property_or_services(entity_ref("urn:test:s132:hce1#employer"), entity_ref("urn:test:s132:hce1#employee"), entity_ref("urn:test:s132:hce1#tv"), Property) { origin case_input; }
        assert "f2": price_offered_to_customers(entity_ref("urn:test:s132:hce1#employer"), entity_ref("urn:test:s132:hce1#tv"), 1000 USD) { origin case_input; }
        assert "f3": price_offered_to_employee(entity_ref("urn:test:s132:hce1#employer"), entity_ref("urn:test:s132:hce1#employee"), entity_ref("urn:test:s132:hce1#tv"), 750 USD) { origin case_input; }
        assert "f4": gross_profit_percentage(entity_ref("urn:test:s132:hce1#employer"), entity_ref("urn:test:s132:hce1#tv"), 0.30) { origin case_input; }
        assert "f5": highly_compensated_individual_132(entity_ref("urn:test:s132:hce1#employee"), entity_ref("urn:test:s132:hce1#y2024")) { origin case_input; }
        assert "f6": not_available_nondiscriminatorily_to_hce_132j1(entity_ref("urn:test:s132:hce1#employer"), entity_ref("urn:test:s132:hce1#employee"), entity_ref("urn:test:s132:hce1#y2024"), QualifiedEmployeeDiscount) { origin case_input; }
    }
    evaluate truth(fringe_benefit_excluded_132a(entity_ref("urn:test:s132:hce1#employee"), entity_ref("urn:test:s132:hce1#y2024"), 250 USD));
    expect truth_status == NEITHER;
}

