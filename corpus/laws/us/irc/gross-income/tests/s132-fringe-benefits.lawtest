// Section 132 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.gross_income version "0.1.1";
namespace "urn:us:irc:gross_income:clir";

test "S132-01-NO-ADDITIONAL-COST-SERVICE-EXCLUDED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": fringe_benefit_provided(entity_ref("urn:test:s132:nac1#employer"), entity_ref("urn:test:s132:nac1#employee"), entity_ref("urn:test:s132:nac1#y2024"), NoAdditionalCostService, 0 USD) { origin case_input; }
        assert "f1": service_offered_for_sale_in_employees_line_of_business(entity_ref("urn:test:s132:nac1#employer"), entity_ref("urn:test:s132:nac1#employee"), entity_ref("urn:test:s132:nac1#seat")) { origin case_input; }
        assert "f2": no_substantial_additional_cost_to_employer(entity_ref("urn:test:s132:nac1#employer"), entity_ref("urn:test:s132:nac1#employee"), entity_ref("urn:test:s132:nac1#seat"), entity_ref("urn:test:s132:nac1#y2024")) { origin case_input; }
    }
    evaluate truth(fringe_benefit_excluded_132a(entity_ref("urn:test:s132:nac1#employee"), entity_ref("urn:test:s132:nac1#y2024"), 0 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S132-02-QUALIFIED-EMPLOYEE-DISCOUNT-PROPERTY-WITHIN-GROSS-PROFIT-PERCENTAGE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": qualified_property_or_services(entity_ref("urn:test:s132:disc1#employer"), entity_ref("urn:test:s132:disc1#employee"), entity_ref("urn:test:s132:disc1#tv"), Property) { origin case_input; }
        assert "f1": price_offered_to_customers(entity_ref("urn:test:s132:disc1#employer"), entity_ref("urn:test:s132:disc1#tv"), 1000 USD) { origin case_input; }
        assert "f2": price_offered_to_employee(entity_ref("urn:test:s132:disc1#employer"), entity_ref("urn:test:s132:disc1#employee"), entity_ref("urn:test:s132:disc1#tv"), 750 USD) { origin case_input; }
        assert "f3": gross_profit_percentage(entity_ref("urn:test:s132:disc1#employer"), entity_ref("urn:test:s132:disc1#tv"), 0.30) { origin case_input; }
    }
    // discount = 250, ceiling = 30% of 1000 = 300; 250 <= 300, qualifies
    evaluate truth(qualified_employee_discount_amount(entity_ref("urn:test:s132:disc1#employer"), entity_ref("urn:test:s132:disc1#employee"), entity_ref("urn:test:s132:disc1#tv"), 250.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

