// Section 141 scenarios (stage 2c). NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.gross_income version "0.1.1";
namespace "urn:us:irc:gross_income:clir";

test "S141-01-BUSINESS-USE-AND-SECURITY-OVER-10-PERCENT-IS-PAB" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": issue_total_proceeds(entity_ref("urn:test:s141:pab1#issue"), 1000000 USD) { origin case_input; }
        assert "f1": proceeds_for_private_business_use(entity_ref("urn:test:s141:pab1#issue"), 150000 USD) { origin case_input; }
        assert "f2": proceeds_secured_by_or_derived_from_private_business_use(entity_ref("urn:test:s141:pab1#issue"), 150000 USD) { origin case_input; }
    }
    evaluate truth(private_activity_bond(entity_ref("urn:test:s141:pab1#issue")));
    expect truth_status == TRUE_ONLY;
}

test "S141-02-AT-EXACTLY-10-PERCENT-IS-NOT-PAB" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": issue_total_proceeds(entity_ref("urn:test:s141:pab2#issue"), 1000000 USD) { origin case_input; }
        assert "f1": proceeds_for_private_business_use(entity_ref("urn:test:s141:pab2#issue"), 100000 USD) { origin case_input; }
        assert "f2": proceeds_secured_by_or_derived_from_private_business_use(entity_ref("urn:test:s141:pab2#issue"), 100000 USD) { origin case_input; }
    }
    // exactly 10% does not exceed the "more than 10 percent" threshold
    evaluate truth(private_business_use_test_met_141b1(entity_ref("urn:test:s141:pab2#issue")));
    expect truth_status == FALSE_ONLY;
    evaluate truth(private_activity_bond(entity_ref("urn:test:s141:pab2#issue")));
    expect truth_status == FALSE_ONLY;
}

test "S141-03-PRIVATE-LOAN-FINANCING-OVER-5-PERCENT-IS-PAB" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": issue_total_proceeds(entity_ref("urn:test:s141:loan1#issue"), 1000000 USD) { origin case_input; }
        assert "f1": loan_proceeds_to_non_governmental_persons(entity_ref("urn:test:s141:loan1#issue"), 60000 USD) { origin case_input; }
    }
    // lesser of (5% of 1,000,000 = 50,000) or 5,000,000 = 50,000; 60,000 > 50,000
    evaluate truth(private_activity_bond(entity_ref("urn:test:s141:loan1#issue")));
    expect truth_status == TRUE_ONLY;
}

test "S141-04-PRIVATE-LOAN-BELOW-5000000-DOLLAR-FLOOR-NOT-PAB" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": issue_total_proceeds(entity_ref("urn:test:s141:loan2#issue"), 200000000 USD) { origin case_input; }
        assert "f1": loan_proceeds_to_non_governmental_persons(entity_ref("urn:test:s141:loan2#issue"), 4000000 USD) { origin case_input; }
    }
    // lesser of (5% of 200,000,000 = 10,000,000) or 5,000,000 = 5,000,000; 4,000,000 does not exceed it
    evaluate truth(private_loan_financing_test_met_141c(entity_ref("urn:test:s141:loan2#issue")));
    expect truth_status == FALSE_ONLY;
}
