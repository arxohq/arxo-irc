        assert "f3": qdrd_distributee_death_year_72t11dii(entity_ref("urn:test:s4b:qd4#p"), entity_ref("urn:test:s4b:qd4#y1")) { origin case_input; }
    }
    evaluate truth(qdrd_ratable_inclusion_72t11d(entity_ref("urn:test:s4b:qd4#p"), entity_ref("urn:test:s4b:qd4#d"), entity_ref("urn:test:s4b:qd4#y1"), 9000 USD));
    expect truth_status == TRUE_ONLY;
}
