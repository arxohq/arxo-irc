// Section 119 scenarios (stage 2d). NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.gross_income version "0.1.1";
namespace "urn:us:irc:gross_income:clir";

test "S119-01-MEALS-ON-PREMISES-EXCLUDED" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": meals_or_lodging_furnished_for_convenience(entity_ref("urn:test:s119:m1#p"), entity_ref("urn:test:s119:m1#y2024"), Meals, 1200 USD) { origin case_input; }
        assert "f1": meals_furnished_on_business_premises(entity_ref("urn:test:s119:m1#p"), entity_ref("urn:test:s119:m1#y2024")) { origin case_input; }
    }
    evaluate truth(meals_or_lodging_excluded_119a(entity_ref("urn:test:s119:m1#p"), entity_ref("urn:test:s119:m1#y2024"), Meals, 1200.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S119-02-LODGING-REQUIRED-AS-CONDITION-EXCLUDED" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": meals_or_lodging_furnished_for_convenience(entity_ref("urn:test:s119:l1#p"), entity_ref("urn:test:s119:l1#y2024"), Lodging, 8000 USD) { origin case_input; }
        assert "f1": lodging_required_on_business_premises_as_condition(entity_ref("urn:test:s119:l1#p"), entity_ref("urn:test:s119:l1#y2024")) { origin case_input; }
    }
    evaluate truth(meals_or_lodging_excluded_119a(entity_ref("urn:test:s119:l1#p"), entity_ref("urn:test:s119:l1#y2024"), Lodging, 8000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S119-03-CAMPUS-LODGING-EXCESS-OVER-5-PERCENT-RULE" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": employee_of_educational_institution_119d(entity_ref("urn:test:s119:campus1#p"), entity_ref("urn:test:s119:campus1#inst")) { origin case_input; }
        assert "f1": qualified_campus_lodging_value(entity_ref("urn:test:s119:campus1#p"), entity_ref("urn:test:s119:campus1#inst"), entity_ref("urn:test:s119:campus1#y2024"), 10000 USD) { origin case_input; }
        assert "f2": campus_lodging_appraised_value(entity_ref("urn:test:s119:campus1#p"), entity_ref("urn:test:s119:campus1#inst"), entity_ref("urn:test:s119:campus1#y2024"), 200000 USD) { origin case_input; }
        assert "f3": comparable_lodging_average_rental_119d2Aii(entity_ref("urn:test:s119:campus1#p"), entity_ref("urn:test:s119:campus1#inst"), entity_ref("urn:test:s119:campus1#y2024"), 12000 USD) { origin case_input; }
        assert "f4": rent_paid_by_employee_119d2B(entity_ref("urn:test:s119:campus1#p"), entity_ref("urn:test:s119:campus1#inst"), entity_ref("urn:test:s119:campus1#y2024"), 5000 USD) { origin case_input; }
    }
    // lesser of (5% of 200000 = 10000) or 12000 = 10000; excess over rent paid (5000) = 5000
    evaluate truth(campus_lodging_included_excess_119d2(entity_ref("urn:test:s119:campus1#p"), entity_ref("urn:test:s119:campus1#inst"), entity_ref("urn:test:s119:campus1#y2024"), 5000.00 USD));
    expect truth_status == TRUE_ONLY;
    evaluate truth(qualified_campus_lodging_excluded_119d1(entity_ref("urn:test:s119:campus1#p"), entity_ref("urn:test:s119:campus1#inst"), entity_ref("urn:test:s119:campus1#y2024"), 5000.00 USD));
    expect truth_status == TRUE_ONLY;
}
