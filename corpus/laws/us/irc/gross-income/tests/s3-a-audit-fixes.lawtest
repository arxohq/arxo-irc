    evaluate truth(dependent_of(entity_ref("urn:test:s139-303-ordinary-dependent-still-excluded-by-the-joint-return#c"), entity_ref("urn:test:s139-303-ordinary-dependent-still-excluded-by-the-joint-return#t"), entity_ref("urn:test:s139-303-ordinary-dependent-still-excluded-by-the-joint-return#y")));
    expect truth_status == FALSE_ONLY;
}

