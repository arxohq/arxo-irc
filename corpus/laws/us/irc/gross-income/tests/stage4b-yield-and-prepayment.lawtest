// Stage 4b (26.09.2026): G6701 (yield by bounded bisection) and G6702 (month-end of an expected prepayment). NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.gross_income version "0.1.1";
namespace "urn:us:irc:gross_income:clir";

test "S4C-YIELD-01" {
    given {
        context { legal_time @2026-09-26; decision_time @2026-09-26T09:00:00-05:00; knowledge_time @2026-09-26T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": yield_issue_price_143g2(entity_ref("urn:test:s4c:01#issue"), 1000 USD) { origin case_input; }
        assert "f1": yield_payment_143g2(entity_ref("urn:test:s4c:01#issue"), 1, 60 USD) { origin case_input; }
        assert "f2": yield_payment_143g2(entity_ref("urn:test:s4c:01#issue"), 2, 1060 USD) { origin case_input; }
        assert "f3": effective_rate_on_mortgages_143g2(entity_ref("urn:test:s4c:01#issue"), 7.0) { origin case_input; }
    }
    // price 1000, payments 60 and 1060: the yield is 6 percent (to 0.001 point); 7.0 - 6.0 = 1.0 <= 1.125
    evaluate truth(effective_rate_spread_within_limit_143g2(entity_ref("urn:test:s4c:01#issue")));
    expect truth_status == TRUE_ONLY;
}

test "S4C-YIELD-02" {
    given {
        context { legal_time @2026-09-26; decision_time @2026-09-26T09:00:00-05:00; knowledge_time @2026-09-26T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": yield_issue_price_143g2(entity_ref("urn:test:s4c:02#issue"), 1000 USD) { origin case_input; }
        assert "f1": yield_payment_143g2(entity_ref("urn:test:s4c:02#issue"), 1, 60 USD) { origin case_input; }
        assert "f2": yield_payment_143g2(entity_ref("urn:test:s4c:02#issue"), 2, 1060 USD) { origin case_input; }
        assert "f3": effective_rate_on_mortgages_143g2(entity_ref("urn:test:s4c:02#issue"), 7.5) { origin case_input; }
    }
    // 7.5 - 6.0 = 1.5 > 1.125
    evaluate truth(effective_rate_spread_within_limit_143g2(entity_ref("urn:test:s4c:02#issue")));
    expect truth_status == FALSE_ONLY;
}

test "S4C-YIELD-03-THREE-YEAR-BOND" {
    given {
        context { legal_time @2026-09-26; decision_time @2026-09-26T09:00:00-05:00; knowledge_time @2026-09-26T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": yield_issue_price_143g2(entity_ref("urn:test:s4c:03#issue"), 1000 USD) { origin case_input; }
        assert "f1": yield_payment_143g2(entity_ref("urn:test:s4c:03#issue"), 1, 100 USD) { origin case_input; }
        assert "f2": yield_payment_143g2(entity_ref("urn:test:s4c:03#issue"), 2, 100 USD) { origin case_input; }
        assert "f3": yield_payment_143g2(entity_ref("urn:test:s4c:03#issue"), 3, 1100 USD) { origin case_input; }
        assert "f4": effective_rate_on_mortgages_143g2(entity_ref("urn:test:s4c:03#issue"), 11.0) { origin case_input; }
    }
    // par bond at 10 percent: 11.0 - 10.0 = 1.0
    evaluate truth(effective_rate_spread_within_limit_143g2(entity_ref("urn:test:s4c:03#issue")));
    expect truth_status == TRUE_ONLY;
}

test "S4C-PREPAY-04-MONTH-END-FEBRUARY" {
    given {
        context { legal_time @2026-09-26; decision_time @2026-09-26T09:00:00-05:00; knowledge_time @2026-09-26T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": expected_prepayment_143g2(entity_ref("urn:test:s4c:04#issue"), 1, @2026-02-10, @2026-02-01, 5000 USD) { origin case_input; }
    }
    // the expected date 2026-02-10 lies in February 2026: treated as received 2026-02-28
    evaluate truth(prepayment_treated_as_received_143g2(entity_ref("urn:test:s4c:04#issue"), 1, @2026-02-28, 5000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S4C-PREPAY-05-MONTH-END-31-DAYS" {
    given {
        context { legal_time @2026-09-26; decision_time @2026-09-26T09:00:00-05:00; knowledge_time @2026-09-26T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": expected_prepayment_143g2(entity_ref("urn:test:s4c:05#issue"), 1, @2026-07-03, @2026-07-01, 5000 USD) { origin case_input; }
    }
    // July has 31 days: the treated date is 2026-07-31, not 07-30
    evaluate truth(prepayment_treated_as_received_143g2(entity_ref("urn:test:s4c:05#issue"), 1, @2026-07-30, 5000 USD));
    expect truth_status == FALSE_ONLY;
}

