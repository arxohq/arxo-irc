// Section 121 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.gross_income version "0.1.1";
namespace "urn:us:irc:gross_income:clir";

test "S121-01-UNMARRIED-MEETS-2-OF-5-YEARS-BELOW-LIMIT-FULLY-EXCLUDED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": sale_or_exchange_of_property(entity_ref("urn:test:s121:u1#p"), entity_ref("urn:test:s121:u1#house"), @2024-06-01, 150000 USD) { origin case_input; }
        assert "f1": no_depreciation_adjustments(entity_ref("urn:test:s121:u1#p"), entity_ref("urn:test:s121:u1#house"), @2024-06-01) { origin case_input; }
        assert "f2": no_nonqualified_use(entity_ref("urn:test:s121:u1#p"), entity_ref("urn:test:s121:u1#house"), @2024-06-01) { origin case_input; }
        assert "f3": ownership_and_use_aggregate_days_5yr(entity_ref("urn:test:s121:u1#p"), entity_ref("urn:test:s121:u1#house"), @2024-06-01, 900) { origin case_input; }
    }
    evaluate truth(gain_excluded_121a(entity_ref("urn:test:s121:u1#p"), entity_ref("urn:test:s121:u1#house"), @2024-06-01, 150000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

