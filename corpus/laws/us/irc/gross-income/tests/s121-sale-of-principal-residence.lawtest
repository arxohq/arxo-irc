test "S121-03-BELOW-2-YEARS-EXCLUSION-NOT-ESTABLISHED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": sale_or_exchange_of_property(entity_ref("urn:test:s121:short1#p"), entity_ref("urn:test:s121:short1#house"), @2024-06-01, 50000 USD) { origin case_input; }
        assert "f1": ownership_and_use_aggregate_days_5yr(entity_ref("urn:test:s121:short1#p"), entity_ref("urn:test:s121:short1#house"), @2024-06-01, 400) { origin case_input; }
    }
    evaluate truth(meets_ownership_and_use_requirement_121a(entity_ref("urn:test:s121:short1#p"), entity_ref("urn:test:s121:short1#house"), @2024-06-01));
    expect truth_status == FALSE_ONLY;
    evaluate truth(gain_excluded_121a(entity_ref("urn:test:s121:short1#p"), entity_ref("urn:test:s121:short1#house"), @2024-06-01, 50000 USD));
    expect truth_status == NEITHER;
}

