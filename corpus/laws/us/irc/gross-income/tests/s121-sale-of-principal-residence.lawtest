test "S121-06-REDUCED-EXCLUSION-FOR-EMPLOYMENT-RELOCATION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": sale_or_exchange_of_property(entity_ref("urn:test:s121:c1#p"), entity_ref("urn:test:s121:c1#house"), @2024-06-01, 100000 USD) { origin case_input; }
        assert "f1": no_depreciation_adjustments(entity_ref("urn:test:s121:c1#p"), entity_ref("urn:test:s121:c1#house"), @2024-06-01) { origin case_input; }
        assert "f2": no_nonqualified_use(entity_ref("urn:test:s121:c1#p"), entity_ref("urn:test:s121:c1#house"), @2024-06-01) { origin case_input; }
        assert "f3": ownership_and_use_aggregate_days_5yr(entity_ref("urn:test:s121:c1#p"), entity_ref("urn:test:s121:c1#house"), @2024-06-01, 365) { origin case_input; }
        assert "f4": sale_by_reason_of_employment_health_or_unforeseen_circumstances(entity_ref("urn:test:s121:c1#p"), entity_ref("urn:test:s121:c1#house"), @2024-06-01) { origin case_input; }
        assert "f5": days_since_prior_121a_sale_121c(entity_ref("urn:test:s121:c1#p"), entity_ref("urn:test:s121:c1#house"), @2024-06-01, 1000) { origin case_input; }
    }
    // ownership_and_use (365 days) < days_since_prior_sale (1000): numerator = 365
    // ratio = 365/730 = 0.5; limit = 250000; reduced = 125000
    evaluate truth(gain_excluded_121c_reduced(entity_ref("urn:test:s121:c1#p"), entity_ref("urn:test:s121:c1#house"), @2024-06-01, 125000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

