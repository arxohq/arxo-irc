test "S104-03-PUNITIVE-DAMAGES-NOT-EXCLUDED-BY-DEFAULT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": section_104a_item(entity_ref("urn:test:s104:pun1#p"), entity_ref("urn:test:s104:pun1#y2024"), PhysicalInjuryOrSicknessDamages, 50000 USD) { origin case_input; }
        assert "f1": on_account_of_personal_physical_injury_or_sickness(entity_ref("urn:test:s104:pun1#p"), entity_ref("urn:test:s104:pun1#y2024"), 50000 USD) { origin case_input; }
        assert "f2": is_punitive_damages(entity_ref("urn:test:s104:pun1#p"), entity_ref("urn:test:s104:pun1#y2024"), 50000 USD) { origin case_input; }
    }
    evaluate truth(section_104a_amount_excluded(entity_ref("urn:test:s104:pun1#p"), entity_ref("urn:test:s104:pun1#y2024"), PhysicalInjuryOrSicknessDamages, 50000 USD));
    expect truth_status == NEITHER;
}

