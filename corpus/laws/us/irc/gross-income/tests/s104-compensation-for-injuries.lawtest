// Section 104 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.gross_income version "0.1.1";
namespace "urn:us:irc:gross_income:clir";

test "S104-01-WORKMENS-COMPENSATION-EXCLUDED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": section_104a_item(entity_ref("urn:test:s104:wc1#p"), entity_ref("urn:test:s104:wc1#y2024"), WorkmensCompensation, 5000 USD) { origin case_input; }
    }
    evaluate truth(section_104a_amount_excluded(entity_ref("urn:test:s104:wc1#p"), entity_ref("urn:test:s104:wc1#y2024"), WorkmensCompensation, 5000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

