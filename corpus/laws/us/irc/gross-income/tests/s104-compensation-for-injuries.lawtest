    evaluate truth(section_104a_amount_excluded(entity_ref("urn:test:s104:pun2#p"), entity_ref("urn:test:s104:pun2#y2024"), PhysicalInjuryOrSicknessDamages, 50000 USD));
    expect truth_status == TRUE_ONLY;
