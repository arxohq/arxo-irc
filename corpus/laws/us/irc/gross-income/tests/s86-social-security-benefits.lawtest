// Section 86 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.gross_income version "0.1.1";
namespace "urn:us:irc:gross_income:clir";

test "S86-01-BELOW-BASE-AMOUNT-NOTHING-INCLUDED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::filing_status(entity_ref("urn:test:s86:below1#p"), entity_ref("urn:test:s86:below1#y2024"), Unmarried) { origin case_input; }
        assert "f1": adjusted_gross_income(entity_ref("urn:test:s86:below1#p"), entity_ref("urn:test:s86:below1#y2024"), 15000 USD) { origin case_input; }
        assert "f2": tax_exempt_interest_received(entity_ref("urn:test:s86:below1#p"), entity_ref("urn:test:s86:below1#y2024"), 0 USD) { origin case_input; }
        assert "f3": social_security_benefits_received(entity_ref("urn:test:s86:below1#p"), entity_ref("urn:test:s86:below1#y2024"), 12000 USD) { origin case_input; }
    }
    // combined = 15000 + 6000 = 21000 <= base 25000: taxpayer not within (b)
    evaluate truth(taxpayer_within_section_86b(entity_ref("urn:test:s86:below1#p"), entity_ref("urn:test:s86:below1#y2024")));
    expect truth_status == FALSE_ONLY;
    evaluate truth(social_security_benefits_included_in_gross_income(entity_ref("urn:test:s86:below1#p"), entity_ref("urn:test:s86:below1#y2024"), 0 USD));
    expect truth_status == NEITHER;
}

test "S86-02-FIFTY-PERCENT-TIER" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::filing_status(entity_ref("urn:test:s86:mid1#p"), entity_ref("urn:test:s86:mid1#y2024"), Unmarried) { origin case_input; }
        assert "f1": adjusted_gross_income(entity_ref("urn:test:s86:mid1#p"), entity_ref("urn:test:s86:mid1#y2024"), 24000 USD) { origin case_input; }
        assert "f2": tax_exempt_interest_received(entity_ref("urn:test:s86:mid1#p"), entity_ref("urn:test:s86:mid1#y2024"), 0 USD) { origin case_input; }
        assert "f3": social_security_benefits_received(entity_ref("urn:test:s86:mid1#p"), entity_ref("urn:test:s86:mid1#y2024"), 12000 USD) { origin case_input; }
    }
    // combined = 24000 + 6000 = 30000; base 25000; adjusted base 34000.
    // 30000 <= 34000, so tier1: lesser of (0.5*12000=6000) or (0.5*(30000-25000)=2500) = 2500
    evaluate truth(social_security_benefits_included_in_gross_income(entity_ref("urn:test:s86:mid1#p"), entity_ref("urn:test:s86:mid1#y2024"), 2500.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S86-03-EIGHTY-FIVE-PERCENT-TIER" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::filing_status(entity_ref("urn:test:s86:hi1#p"), entity_ref("urn:test:s86:hi1#y2024"), Unmarried) { origin case_input; }
        assert "f1": adjusted_gross_income(entity_ref("urn:test:s86:hi1#p"), entity_ref("urn:test:s86:hi1#y2024"), 50000 USD) { origin case_input; }
        assert "f2": tax_exempt_interest_received(entity_ref("urn:test:s86:hi1#p"), entity_ref("urn:test:s86:hi1#y2024"), 0 USD) { origin case_input; }
        assert "f3": social_security_benefits_received(entity_ref("urn:test:s86:hi1#p"), entity_ref("urn:test:s86:hi1#y2024"), 20000 USD) { origin case_input; }
    }
    // combined = 50000 + 10000 = 60000; base 25000; adjusted base 34000. 60000 > 34000.
    // tier1 = min(0.5*20000=10000, 0.5*(60000-25000)=17500) = 10000
    // cap on tier1 addend = 0.5*(34000-25000) = 4500; min(10000, 4500) = 4500
    // 85% of excess over adjusted base = 0.85*(60000-34000) = 0.85*26000 = 22100
    // sum = 22100 + 4500 = 26600; 85% of benefits = 0.85*20000 = 17000
    // included = min(26600, 17000) = 17000
    evaluate truth(social_security_benefits_included_in_gross_income(entity_ref("urn:test:s86:hi1#p"), entity_ref("urn:test:s86:hi1#y2024"), 17000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S86-04-MARRIED-SEPARATE-LIVING-TOGETHER-ZERO-BASE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::filing_status(entity_ref("urn:test:s86:sep1#p"), entity_ref("urn:test:s86:sep1#y2024"), MarriedSeparate) { origin case_input; }
        assert "f1": us.irc.definitions::married_as_of_close_of_taxable_year(entity_ref("urn:test:s86:sep1#p"), entity_ref("urn:test:s86:sep1#y2024")) { origin case_input; }
    }
    evaluate truth(base_amount_86(entity_ref("urn:test:s86:sep1#p"), entity_ref("urn:test:s86:sep1#y2024"), 0.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
