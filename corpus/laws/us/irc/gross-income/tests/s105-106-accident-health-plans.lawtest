// Sections 105-106 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.gross_income version "0.1.1";
namespace "urn:us:irc:gross_income:clir";

test "S105-01-MEDICAL-REIMBURSEMENT-EXCLUDED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": reimbursement_for_medical_care_of_taxpayer_spouse_or_dependent(entity_ref("urn:test:s105:rb1#p"), entity_ref("urn:test:s105:rb1#y2024"), 1200 USD) { origin case_input; }
    }
    evaluate truth(reimbursement_excluded_105b(entity_ref("urn:test:s105:rb1#p"), entity_ref("urn:test:s105:rb1#y2024"), 1200 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S105-02-MEDICAL-REIMBURSEMENT-ATTRIBUTABLE-TO-PRIOR-213-DEDUCTION-NOT-EXCLUDED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": reimbursement_for_medical_care_of_taxpayer_spouse_or_dependent(entity_ref("urn:test:s105:rb2#p"), entity_ref("urn:test:s105:rb2#y2024"), 800 USD) { origin case_input; }
        assert "f1": attributable_to_prior_year_213_deduction(entity_ref("urn:test:s105:rb2#p"), entity_ref("urn:test:s105:rb2#y2024"), 800 USD) { origin case_input; }
    }
    evaluate truth(reimbursement_excluded_105b(entity_ref("urn:test:s105:rb2#p"), entity_ref("urn:test:s105:rb2#y2024"), 800 USD));
    expect truth_status == FALSE_ONLY;
}

test "S105-03-EXCESS-REIMBURSEMENT-OF-HCE-VIA-DISCRIMINATORY-FRACTION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": self_insured_medical_reimbursement_plan(entity_ref("urn:test:s105:h1#plan"), entity_ref("urn:test:s105:h1#y2024")) { origin case_input; }
        assert "f1": highly_compensated_individual(entity_ref("urn:test:s105:h1#hce"), entity_ref("urn:test:s105:h1#y2024")) { origin case_input; }
        assert "f2": plan_discriminates_in_eligibility(entity_ref("urn:test:s105:h1#plan"), entity_ref("urn:test:s105:h1#y2024")) { origin case_input; }
        assert "f3": total_reimbursed_to_hce_for_plan_year(entity_ref("urn:test:s105:h1#plan"), entity_ref("urn:test:s105:h1#hce"), entity_ref("urn:test:s105:h1#y2024"), 10000 USD) { origin case_input; }
        assert "f4": total_reimbursed_to_all_hce_for_plan_year(entity_ref("urn:test:s105:h1#plan"), entity_ref("urn:test:s105:h1#y2024"), 40000 USD) { origin case_input; }
        assert "f5": total_reimbursed_to_all_employees_for_plan_year(entity_ref("urn:test:s105:h1#plan"), entity_ref("urn:test:s105:h1#y2024"), 100000 USD) { origin case_input; }
    }
    // excess = 10000 * (40000/100000) = 10000 * 0.4 = 4000 USD
    evaluate truth(excess_reimbursement_of_hce_105h(entity_ref("urn:test:s105:h1#hce"), entity_ref("urn:test:s105:h1#y2024"), 4000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

