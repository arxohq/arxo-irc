// Section 83 scenarios (stage 2c). NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.gross_income version "0.1.1";
namespace "urn:us:irc:gross_income:clir";

test "S83-01-INCLUSION-AT-VESTING-FMV-MINUS-AMOUNT-PAID" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": property_transferred_for_services(entity_ref("urn:test:s83:vest1#p"), entity_ref("urn:test:s83:vest1#asset"), @2022-01-01, 50000 USD, 5000 USD) { origin case_input; }
        assert "f1": substantial_risk_of_forfeiture_lapses_on(entity_ref("urn:test:s83:vest1#p"), entity_ref("urn:test:s83:vest1#asset"), @2024-01-01) { origin case_input; }
        assert "f2": us.irc.core::year_of(entity_ref("urn:test:s83:vest1#p"), entity_ref("urn:test:s83:vest1#y2024")) { origin case_input; }
    }
    evaluate truth(section_83_inclusion(entity_ref("urn:test:s83:vest1#p"), entity_ref("urn:test:s83:vest1#asset"), entity_ref("urn:test:s83:vest1#y2024"), 45000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S83-02-ARMS-LENGTH-DISPOSITION-BEFORE-VESTING-NO-INCLUSION" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": property_transferred_for_services(entity_ref("urn:test:s83:al1#p"), entity_ref("urn:test:s83:al1#asset"), @2022-01-01, 50000 USD, 5000 USD) { origin case_input; }
        assert "f1": substantial_risk_of_forfeiture_lapses_on(entity_ref("urn:test:s83:al1#p"), entity_ref("urn:test:s83:al1#asset"), @2024-01-01) { origin case_input; }
        assert "f2": arms_length_disposition_before_vesting(entity_ref("urn:test:s83:al1#p"), entity_ref("urn:test:s83:al1#asset")) { origin case_input; }
        assert "f3": us.irc.core::year_of(entity_ref("urn:test:s83:al1#p"), entity_ref("urn:test:s83:al1#y2024")) { origin case_input; }
    }
    evaluate truth(section_83_inclusion(entity_ref("urn:test:s83:al1#p"), entity_ref("urn:test:s83:al1#asset"), entity_ref("urn:test:s83:al1#y2024"), 45000.00 USD));
    expect truth_status == FALSE_ONLY;
}

