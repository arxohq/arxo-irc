// Section 127 scenarios (stage 2d). NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.gross_income version "0.1.1";
namespace "urn:us:irc:gross_income:clir";

test "S127-01-EXCLUSION-CAPPED-AT-5250" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": educational_assistance_program_written_127b1(entity_ref("urn:test:s127:cap1#program"), entity_ref("urn:test:s127:cap1#employer")) { origin case_input; }
        assert "f1": program_classification_found_nondiscriminatory_127b2(entity_ref("urn:test:s127:cap1#program"), entity_ref("urn:test:s127:cap1#y2024")) { origin case_input; }
        assert "f2": shareholder_owner_class_share_of_assistance_127b3(entity_ref("urn:test:s127:cap1#program"), entity_ref("urn:test:s127:cap1#y2024"), 0.0) { origin case_input; }
        assert "f3": total_educational_assistance_furnished_calendar_year(entity_ref("urn:test:s127:cap1#p"), entity_ref("urn:test:s127:cap1#y2024"), 7000 USD) { origin case_input; }
    }
    evaluate truth(educational_assistance_excluded_127a(entity_ref("urn:test:s127:cap1#p"), entity_ref("urn:test:s127:cap1#employer"), entity_ref("urn:test:s127:cap1#y2024"), 5250.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S127-02-STUDENT-LOAN-PAYMENT-VALID-BEFORE-2026" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": educational_assistance_furnished(entity_ref("urn:test:s127:loan1#p"), entity_ref("urn:test:s127:loan1#employer"), entity_ref("urn:test:s127:loan1#y2024"), StudentLoanPayment, 2000 USD, @2024-06-01) { origin case_input; }
    }
    evaluate truth(qualified_education_loan_payment_valid_127c1B(entity_ref("urn:test:s127:loan1#p"), entity_ref("urn:test:s127:loan1#employer"), entity_ref("urn:test:s127:loan1#y2024"), 2000 USD, @2024-06-01));
    expect truth_status == TRUE_ONLY;
}

test "S127-03-STUDENT-LOAN-PAYMENT-AFTER-2025-SUNSET-NOT-VALID-BY-BASE-TEXT" {
    given {
        context { legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00; knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": educational_assistance_furnished(entity_ref("urn:test:s127:loan2#p"), entity_ref("urn:test:s127:loan2#employer"), entity_ref("urn:test:s127:loan2#y2026"), StudentLoanPayment, 2000 USD, @2026-06-01) { origin case_input; }
    }
    // this reflects the 2024-edition sunset (SOURCE_GAP on Pub. L. 119-21's permanence per the module header) -- NOT the real 2026 law
    evaluate truth(qualified_education_loan_payment_valid_127c1B(entity_ref("urn:test:s127:loan2#p"), entity_ref("urn:test:s127:loan2#employer"), entity_ref("urn:test:s127:loan2#y2026"), 2000 USD, @2026-06-01));
    expect truth_status == FALSE_ONLY;
}
