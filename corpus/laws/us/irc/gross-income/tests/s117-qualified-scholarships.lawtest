test "S117-04-TUITION-REDUCTION-HCE-REQUIRES-NONDISCRIMINATION" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": employer_of_educational_organization(entity_ref("urn:test:s117:hce1#p"), entity_ref("urn:test:s117:hce1#org")) { origin case_input; }
        assert "f1": tuition_reduction_amount_117d(entity_ref("urn:test:s117:hce1#p"), entity_ref("urn:test:s117:hce1#org"), entity_ref("urn:test:s117:hce1#y2024"), 5000 USD) { origin case_input; }
        assert "f2": highly_compensated_employee_117d(entity_ref("urn:test:s117:hce1#p"), entity_ref("urn:test:s117:hce1#org"), entity_ref("urn:test:s117:hce1#y2024")) { origin case_input; }
    }
    evaluate truth(qualified_tuition_reduction_117d(entity_ref("urn:test:s117:hce1#p"), entity_ref("urn:test:s117:hce1#org"), entity_ref("urn:test:s117:hce1#y2024"), 5000 USD));
    expect truth_status == FALSE_ONLY;
}
