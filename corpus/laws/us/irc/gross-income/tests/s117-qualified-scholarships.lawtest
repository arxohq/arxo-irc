    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": amount_represents_payment_for_services(entity_ref("urn:test:s117:svc1#p"), entity_ref("urn:test:s117:svc1#org"), entity_ref("urn:test:s117:svc1#y2024"), 3000 USD) { origin case_input; }
    }
    evaluate truth(section_117_services_portion(entity_ref("urn:test:s117:svc1#p"), entity_ref("urn:test:s117:svc1#org"), entity_ref("urn:test:s117:svc1#y2024"), 3000.00 USD));
    expect truth_status == TRUE_ONLY;
