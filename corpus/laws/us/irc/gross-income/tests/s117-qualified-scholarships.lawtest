// Section 117 scenarios (stage 2d). NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.gross_income version "0.1.1";
namespace "urn:us:irc:gross_income:clir";

test "S117-01-SCHOLARSHIP-CAPPED-AT-QUALIFIED-EXPENSES" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": amount_received_as_scholarship_or_fellowship(entity_ref("urn:test:s117:cap1#p"), entity_ref("urn:test:s117:cap1#org"), entity_ref("urn:test:s117:cap1#y2024"), 20000 USD) { origin case_input; }
        assert "f1": qualified_tuition_and_related_expenses_117b2(entity_ref("urn:test:s117:cap1#p"), entity_ref("urn:test:s117:cap1#y2024"), 15000 USD) { origin case_input; }
    }
    evaluate truth(qualified_scholarship_117b1(entity_ref("urn:test:s117:cap1#p"), entity_ref("urn:test:s117:cap1#org"), entity_ref("urn:test:s117:cap1#y2024"), 15000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S117-02-CANDIDATE-EXCLUSION-NO-SERVICES" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": candidate_for_degree_170b1Aii(entity_ref("urn:test:s117:excl1#p"), entity_ref("urn:test:s117:excl1#org")) { origin case_input; }
        assert "f1": amount_received_as_scholarship_or_fellowship(entity_ref("urn:test:s117:excl1#p"), entity_ref("urn:test:s117:excl1#org"), entity_ref("urn:test:s117:excl1#y2024"), 10000 USD) { origin case_input; }
        assert "f2": qualified_tuition_and_related_expenses_117b2(entity_ref("urn:test:s117:excl1#p"), entity_ref("urn:test:s117:excl1#y2024"), 10000 USD) { origin case_input; }
    }
    evaluate truth(qualified_scholarship_excluded_117a(entity_ref("urn:test:s117:excl1#p"), entity_ref("urn:test:s117:excl1#org"), entity_ref("urn:test:s117:excl1#y2024"), 10000.00 USD));
    expect truth_status == TRUE_ONLY;
}

