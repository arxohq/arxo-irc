// Section 68 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.gross_income version "0.1.1";
namespace "urn:us:irc:gross_income:clir";

test "S68-01-APPLICABLE-AMOUNT-JOINT-PRE-2018" {
    given {
        context {
            legal_time @2016-04-15;
            decision_time @2016-04-15T09:00:00-05:00;
            knowledge_time @2016-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::filing_status(entity_ref("urn:test:s68:aa1#p"), entity_ref("urn:test:s68:aa1#y2016"), Joint) { origin case_input; }
    }
    evaluate truth(applicable_amount_68(entity_ref("urn:test:s68:aa1#p"), entity_ref("urn:test:s68:aa1#y2016"), 300000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S68-02-THREE-PERCENT-PRONG-GOVERNS" {
    given {
        context {
            legal_time @2016-04-15;
            decision_time @2016-04-15T09:00:00-05:00;
            knowledge_time @2016-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::filing_status(entity_ref("urn:test:s68:r1#p"), entity_ref("urn:test:s68:r1#y2016"), Unmarried) { origin case_input; }
        assert "f1": adjusted_gross_income(entity_ref("urn:test:s68:r1#p"), entity_ref("urn:test:s68:r1#y2016"), 350000.00 USD) { origin case_input; }
        assert "f2": itemized_deductions_total(entity_ref("urn:test:s68:r1#p"), entity_ref("urn:test:s68:r1#y2016"), 40000.00 USD) { origin case_input; }
    }
    // excess over $250,000 = $100,000; 3% = $3,000. 80% of $40,000 = $32,000.
    // 3,000 <= 32,000: the 3-percent prong is the lesser and governs.
    evaluate truth(itemized_deductions_reduced_amount(entity_ref("urn:test:s68:r1#p"), entity_ref("urn:test:s68:r1#y2016"), 3000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S68-03-EIGHTY-PERCENT-PRONG-GOVERNS" {
    given {
        context {
            legal_time @2016-04-15;
            decision_time @2016-04-15T09:00:00-05:00;
            knowledge_time @2016-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.income_individual::filing_status(entity_ref("urn:test:s68:r2#p"), entity_ref("urn:test:s68:r2#y2016"), Unmarried) { origin case_input; }
        assert "f1": adjusted_gross_income(entity_ref("urn:test:s68:r2#p"), entity_ref("urn:test:s68:r2#y2016"), 1250000.00 USD) { origin case_input; }
        assert "f2": itemized_deductions_total(entity_ref("urn:test:s68:r2#p"), entity_ref("urn:test:s68:r2#y2016"), 1000.00 USD) { origin case_input; }
    }
    // excess over $250,000 = $1,000,000; 3% = $30,000. 80% of $1,000 = $800.
    // 800 < 30,000: the 80-percent prong is the lesser and governs.
    evaluate truth(itemized_deductions_reduced_amount(entity_ref("urn:test:s68:r2#p"), entity_ref("urn:test:s68:r2#y2016"), 800.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S68-04-SUSPENDED-2018-2025-NO-REDUCTION" {
    given {
        context {
            legal_time @2022-04-15;
            decision_time @2022-04-15T09:00:00-05:00;
            knowledge_time @2022-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": itemized_deductions_total(entity_ref("urn:test:s68:susp1#p"), entity_ref("urn:test:s68:susp1#y2022"), 40000.00 USD) { origin case_input; }
    }
    evaluate truth(itemized_deductions_reduced_amount(entity_ref("urn:test:s68:susp1#p"), entity_ref("urn:test:s68:susp1#y2022"), 0.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S68-05-ESTATE-OR-TRUST-EXCEPTION" {
    given {
        context {
            legal_time @2016-04-15;
            decision_time @2016-04-15T09:00:00-05:00;
            knowledge_time @2016-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": is_estate_or_trust(entity_ref("urn:test:s68:et1#p")) { origin case_input; }
        assert "f1": itemized_deductions_total(entity_ref("urn:test:s68:et1#p"), entity_ref("urn:test:s68:et1#y2016"), 40000.00 USD) { origin case_input; }
    }
    evaluate truth(itemized_deductions_reduced_amount(entity_ref("urn:test:s68:et1#p"), entity_ref("urn:test:s68:et1#y2016"), 0.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
