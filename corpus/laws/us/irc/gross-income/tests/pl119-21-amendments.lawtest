        assert "f5": taxpayer_attained_age_65_by_close(entity_ref("urn:test:s151-16-senior-deduction-year-beginning-2029-not-allowed#p"), entity_ref("urn:test:s151-16-senior-deduction-year-beginning-2029-not-allowed#y")) { origin case_input; }
    }
    evaluate truth(senior_deduction_151d5C(entity_ref("urn:test:s151-16-senior-deduction-year-beginning-2029-not-allowed#p"), entity_ref("urn:test:s151-16-senior-deduction-year-beginning-2029-not-allowed#y"), 6000.00 USD));
    expect truth_status == NEITHER;
}

test "S151-17-SENIOR-DEDUCTION-WITHOUT-SSN-NOT-ALLOWED" {
    given {
        context {
            legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York";
