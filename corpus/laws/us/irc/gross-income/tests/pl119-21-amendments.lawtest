        assert "f1": adjusted_gross_income(entity_ref("urn:test:s151-17-senior-deduction-without-ssn-not-allowed#p"), entity_ref("urn:test:s151-17-senior-deduction-without-ssn-not-allowed#y"), 50000 USD) { origin case_input; }
        assert "f2": income_excluded_under_911_931_933(entity_ref("urn:test:s151-17-senior-deduction-without-ssn-not-allowed#p"), entity_ref("urn:test:s151-17-senior-deduction-without-ssn-not-allowed#y"), 0 USD) { origin case_input; }
        assert "f3": us.irc.core::begins(entity_ref("urn:test:s151-17-senior-deduction-without-ssn-not-allowed#y"), @2025-01-01) { origin case_input; }
        assert "f4": taxpayer_attained_age_65_by_close(entity_ref("urn:test:s151-17-senior-deduction-without-ssn-not-allowed#p"), entity_ref("urn:test:s151-17-senior-deduction-without-ssn-not-allowed#y")) { origin case_input; }
    }
    evaluate truth(senior_deduction_151d5C(entity_ref("urn:test:s151-17-senior-deduction-without-ssn-not-allowed#p"), entity_ref("urn:test:s151-17-senior-deduction-without-ssn-not-allowed#y"), 6000.00 USD));
    expect truth_status == NEITHER;
}
