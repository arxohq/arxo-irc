// Section 102 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.gross_income version "0.1.1";
namespace "urn:us:irc:gross_income:clir";

test "S102-01-GIFT-PROPERTY-VALUE-EXCLUDED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": acquired_by_gift_bequest_devise_or_inheritance(entity_ref("urn:test:s102:gift1#p"), entity_ref("urn:test:s102:gift1#house"), entity_ref("urn:test:s102:gift1#y2024")) { origin case_input; }
    }
    evaluate truth(gift_property_value_excluded_102a(entity_ref("urn:test:s102:gift1#p"), entity_ref("urn:test:s102:gift1#house"), entity_ref("urn:test:s102:gift1#y2024")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S102-02-INCOME-FROM-GIFT-PROPERTY-NOT-EXCLUDED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": income_from_gift_property(entity_ref("urn:test:s102:income1#p"), entity_ref("urn:test:s102:income1#trust-corpus"), entity_ref("urn:test:s102:income1#y2024"), 3000 USD) { origin case_input; }
    }
    evaluate truth(income_from_gift_property_not_excluded_102b(entity_ref("urn:test:s102:income1#p"), entity_ref("urn:test:s102:income1#trust-corpus"), entity_ref("urn:test:s102:income1#y2024"), 3000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S102-03-EMPLOYEE-GIFT-NOT-EXCLUDED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": employer_transfer_to_employee(entity_ref("urn:test:s102:emp1#employer"), entity_ref("urn:test:s102:emp1#employee"), entity_ref("urn:test:s102:emp1#y2024"), 500 USD) { origin case_input; }
    }
    evaluate truth(employer_transfer_not_excluded_102c(entity_ref("urn:test:s102:emp1#employer"), entity_ref("urn:test:s102:emp1#employee"), entity_ref("urn:test:s102:emp1#y2024"), 500 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S102-04-NO-GIFT-FACT-EXCLUSION-UNDETERMINED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
    }
    evaluate truth(gift_property_value_excluded_102a(entity_ref("urn:test:s102:none1#p"), entity_ref("urn:test:s102:none1#asset"), entity_ref("urn:test:s102:none1#y2024")));
    expect truth_status == NEITHER;
}
