        assert "f0": is_restricted_stock_unit_83i7(entity_ref("urn:test:s83-125-section-83-does-not-apply-to-a-restricted-stock-unit#s")) { origin case_input; }
    }
    evaluate truth(section_83_not_applicable_to_rsu_83i7(entity_ref("urn:test:s83-125-section-83-does-not-apply-to-a-restricted-stock-unit#s")));
    expect truth_status == TRUE_ONLY;
}

