// Stage 3 (26.09.2026) wiring of section 72(e)(10): the section 7702A test of us.irc.definitions feeds the modified endowment contract flag of section 72. NOT EXECUTED (implemented_unverified). Facts are those of definitions tests/modified-endowment.lawtest.

language "law.core" version "0.2";
package us.irc.gross_income version "0.1.1";
namespace "urn:us:irc:gross_income:clir";

test "S72E10-WIRE-01-CONTRACT-FAILING-SEVEN-PAY-IS-MEC-FOR-SECTION-72" {
    given {
        context { legal_time @2026-03-01; decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": us.irc.definitions::life_insurance_contract_under_applicable_law(entity_ref("urn:test:mecwire:w1#ins")) { origin case_input; }
        assert "f1": us.irc.definitions::cash_surrender_value_at(entity_ref("urn:test:mecwire:w1#ins"), @2021-01-01, 5000 USD) { origin case_input; }
        assert "f2": us.irc.definitions::net_single_premium_to_fund_future_benefits_at(entity_ref("urn:test:mecwire:w1#ins"), @2021-01-01, 6000 USD) { origin case_input; }
        assert "f3": us.irc.definitions::contract_entered_into_on(entity_ref("urn:test:mecwire:w1#ins"), @1990-01-01) { origin case_input; }
        assert "f4": us.irc.definitions::first_month_for_which_contract_is_in_effect_begins_on(entity_ref("urn:test:mecwire:w1#ins"), @2020-01-01) { origin case_input; }
        assert "f5": us.irc.definitions::contract_year_evaluated_on(entity_ref("urn:test:mecwire:w1#ins"), @2022-06-01) { origin case_input; }
        assert "f6": us.irc.definitions::accumulated_amount_paid_through(entity_ref("urn:test:mecwire:w1#ins"), @2022-06-01, 12000 USD) { origin case_input; }
        assert "f7": us.irc.definitions::seven_pay_net_level_premium_sum_through(entity_ref("urn:test:mecwire:w1#ins"), @2022-06-01, 10000 USD) { origin case_input; }
        assert "f8": annuity_contract_is_insurance_contract(entity_ref("urn:test:mecwire:w1#ann"), entity_ref("urn:test:mecwire:w1#ins")) { origin case_input; }
    }
    evaluate truth(modified_endowment_contract_effective(entity_ref("urn:test:mecwire:w1#ann")));
    expect truth_status == TRUE_ONLY;
}

