// Section 62 scenarios. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.gross_income version "0.1.1";
namespace "urn:us:irc:gross_income:clir";

test "S62-01-AGI-EQUALS-GROSS-INCOME-MINUS-ABOVE-LINE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": gross_income_item(entity_ref("urn:test:s62:agi1#p"), entity_ref("urn:test:s62:agi1#y2024"), CompensationForServices, 80000 USD) { origin case_input; }
        assert "f1": above_the_line_deduction_amount(entity_ref("urn:test:s62:agi1#p"), entity_ref("urn:test:s62:agi1#y2024"), RetirementSavingsDeduction, 6000 USD) { origin case_input; }
    }
    evaluate truth(adjusted_gross_income(entity_ref("urn:test:s62:agi1#p"), entity_ref("urn:test:s62:agi1#y2024"), 74000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S62-02-NO-ABOVE-LINE-DEDUCTIONS-AGI-EQUALS-GROSS" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": gross_income_item(entity_ref("urn:test:s62:agi2#p"), entity_ref("urn:test:s62:agi2#y2024"), CompensationForServices, 50000 USD) { origin case_input; }
    }
    evaluate truth(adjusted_gross_income(entity_ref("urn:test:s62:agi2#p"), entity_ref("urn:test:s62:agi2#y2024"), 50000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S62-03-QUALIFIED-PERFORMING-ARTIST-QUALIFIES" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": performed_services_in_performing_arts_for_employers(entity_ref("urn:test:s62:qpa1#p"), entity_ref("urn:test:s62:qpa1#y2024"), 3) { origin case_input; }
        assert "f1": performing_arts_section_162_deductions(entity_ref("urn:test:s62:qpa1#p"), entity_ref("urn:test:s62:qpa1#y2024"), 2000 USD) { origin case_input; }
        assert "f2": performing_arts_attributable_gross_income(entity_ref("urn:test:s62:qpa1#p"), entity_ref("urn:test:s62:qpa1#y2024"), 15000 USD) { origin case_input; }
        assert "f3": agi_without_regard_to_performing_artist_deduction(entity_ref("urn:test:s62:qpa1#p"), entity_ref("urn:test:s62:qpa1#y2024"), 15000 USD) { origin case_input; }
    }
    // 2000 > 10% of 15000 (1500), and AGI 15000 <= 16000: qualifies.
    evaluate truth(qualified_performing_artist(entity_ref("urn:test:s62:qpa1#p"), entity_ref("urn:test:s62:qpa1#y2024")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S62-04-QUALIFIED-PERFORMING-ARTIST-AGI-TOO-HIGH" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": performed_services_in_performing_arts_for_employers(entity_ref("urn:test:s62:qpa2#p"), entity_ref("urn:test:s62:qpa2#y2024"), 3) { origin case_input; }
        assert "f1": performing_arts_section_162_deductions(entity_ref("urn:test:s62:qpa2#p"), entity_ref("urn:test:s62:qpa2#y2024"), 2000 USD) { origin case_input; }
        assert "f2": performing_arts_attributable_gross_income(entity_ref("urn:test:s62:qpa2#p"), entity_ref("urn:test:s62:qpa2#y2024"), 15000 USD) { origin case_input; }
        assert "f3": agi_without_regard_to_performing_artist_deduction(entity_ref("urn:test:s62:qpa2#p"), entity_ref("urn:test:s62:qpa2#y2024"), 20000 USD) { origin case_input; }
    }
    evaluate truth(qualified_performing_artist(entity_ref("urn:test:s62:qpa2#p"), entity_ref("urn:test:s62:qpa2#y2024")));
    expect truth_status == NEITHER;
}

