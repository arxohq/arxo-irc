// Sections 142-150 scenarios (stage 2d). NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.gross_income version "0.1.1";
namespace "urn:us:irc:gross_income:clir";

test "S142-01-EXEMPT-FACILITY-BOND-95-PERCENT-TEST-MET" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": issue_total_proceeds(entity_ref("urn:test:s142:ex1#issue"), 1000000 USD) { origin case_input; }
        assert "f1": issue_net_proceeds_for_exempt_facility_use(entity_ref("urn:test:s142:ex1#issue"), Airports, 960000 USD) { origin case_input; }
        assert "f2": all_property_financed_owned_by_governmental_unit_142b1A(entity_ref("urn:test:s142:ex1#issue")) { origin case_input; }
    }
    evaluate truth(exempt_facility_bond_142a(entity_ref("urn:test:s142:ex1#issue")));
    expect truth_status == TRUE_ONLY;
}

test "S144-01-SMALL-ISSUE-BOND-QUALIFIES-AT-1000000-FACE" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": issue_authorized_face_amount(entity_ref("urn:test:s144:small1#issue"), 1000000 USD) { origin case_input; }
        assert "f1": issue_proceeds_for_depreciable_property_or_redemption(entity_ref("urn:test:s144:small1#issue"), 960000 USD) { origin case_input; }
        assert "f2": issue_total_proceeds(entity_ref("urn:test:s144:small1#issue"), 1000000 USD) { origin case_input; }
        assert "f3": small_issue_issue_date_144a12(entity_ref("urn:test:s144:small1#issue"), @1986-06-30) { origin case_input; }
    }
    evaluate truth(qualified_small_issue_bond_144a1(entity_ref("urn:test:s144:small1#issue")));
    expect truth_status == TRUE_ONLY;
}

test "S144-02-SMALL-ISSUE-BOND-FAILS-OVER-1000000-FACE" {
    given {
        context { legal_time @2024-04-15; decision_time @2024-04-15T09:00:00-05:00; knowledge_time @2024-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": issue_authorized_face_amount(entity_ref("urn:test:s144:small2#issue"), 1000001 USD) { origin case_input; }
    }
    evaluate truth(qualified_small_issue_bond_144a1(entity_ref("urn:test:s144:small2#issue")));
    expect truth_status == FALSE_ONLY;
}

