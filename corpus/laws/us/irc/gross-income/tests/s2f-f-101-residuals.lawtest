        assert "f0": employer_death_payment_101i(entity_ref("urn:test:s101-149-astronaut-death-payment-excluded#p"), entity_ref("urn:test:s101-149-astronaut-death-payment-excluded#y"), 100000 USD, false, true, 0 USD, false) { origin case_input; }
    }
    evaluate truth(terrorist_or_astronaut_death_payment_excluded_101i(entity_ref("urn:test:s101-149-astronaut-death-payment-excluded#p"), entity_ref("urn:test:s101-149-astronaut-death-payment-excluded#y"), 100000.00 USD));
    expect truth_status == TRUE_ONLY;
}

