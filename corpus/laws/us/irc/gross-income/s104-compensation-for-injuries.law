// Section 104 — Compensation for injuries or sickness. Stage 2b (IRC-06).

use self::{
    IRC_S104_A,
    IRC_S104_C,
    Individual,
    TaxableYear,
};

pub enum Section104ExclusionKind {
    WorkmensCompensation;
    PhysicalInjuryOrSicknessDamages;
    AccidentOrHealthInsurance;
    ArmedForcesOrPublicHealthServicePension;
    TerroristOrMilitaryActionDisabilityIncome;
    PublicSafetyOfficerSurvivorCompensation;
}

pub relation section_104a_item(p: Individual, y: TaxableYear, kind: Section104ExclusionKind, amount: Money) kind empirical {
    label en official "an amount within one of the section 104(a) categories, received on account of personal injury or sickness (or a survivor/pension analog)";
}
relation attributable_to_prior_year_213_deduction_104(p: Individual, y: TaxableYear, kind: Section104ExclusionKind, amount: Money) kind empirical {
    label en official "the amount is attributable to (and not in excess of) a section 213 deduction allowed for a prior taxable year — excluded from the section 104(a) exclusion (section 104(a), opening exception, shared with section 105(b))";
}
pub relation section_104a_amount_excluded(p: Individual, y: TaxableYear, kind: Section104ExclusionKind, amount: Money) kind institutional {
    label en official "gross income does not include this section 104(a) item";
}

@source(IRC_S104_A, quote = "amounts received under workmen's compensation acts as compensation for personal injuries or sickness")
rule WorkmensCompensationExcluded(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 104(a)(1): workmen's compensation act amounts are excluded";
    when section_104a_item(p, y, WorkmensCompensation, amount);
    when not attributable_to_prior_year_213_deduction_104(p, y, WorkmensCompensation, amount);
    then section_104a_amount_excluded(p, y, WorkmensCompensation, amount);
}

// --- §104(a)(2): damages for physical injury/sickness, punitive-damages carve-out

relation on_account_of_personal_physical_injury_or_sickness(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "damages received (by suit or agreement, lump sum or periodic) on account of personal physical injuries or physical sickness (section 104(a)(2))";
}
relation is_punitive_damages(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the damages are punitive damages (section 104(a)(2), parenthetical carve-out)";
}
pub relation punitive_damages_carveout_reinstated_104c(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 104(c): the '(other than punitive damages)' carve-out does NOT apply — punitive damages awarded in a qualifying pre-9/13/1995 wrongful-death-only State-law civil action are excludable despite being punitive";
}
relation is_emotional_distress_not_physical(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the damages are for emotional distress, which section 104(a) treats as NOT a physical injury or physical sickness (section 104(a), penultimate sentence)";
}
relation emotional_distress_damages_up_to_medical_care_paid(p: Individual, y: TaxableYear, amount: Money, medical_care_paid: Money) kind empirical {
    label en official "the amount of emotional-distress damages does not exceed the amount paid for medical care (section 213(d)(1)(A)/(B)) attributable to the emotional distress — the emotional-distress carve-out's own exception does not strip exclusion from this portion (section 104(a), last sentence)";
}

@source(IRC_S104_A, quote = "the amount of any damages (other than punitive damages) received (whether by suit or agreement and whether as lump sums or as periodic payments) on account of personal physical injuries or physical sickness")
rule PhysicalInjuryDamagesExcluded(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 104(a)(2): damages on account of personal physical injury/sickness are excluded, unless punitive (absent the (c) carve-out reinstatement) or attributable to (non-medical-care) emotional distress";
    when section_104a_item(p, y, PhysicalInjuryOrSicknessDamages, amount);
    when on_account_of_personal_physical_injury_or_sickness(p, y, amount);
    when not attributable_to_prior_year_213_deduction_104(p, y, PhysicalInjuryOrSicknessDamages, amount);
    when not_known(is_punitive_damages(p, y, amount));
    when not_known(is_emotional_distress_not_physical(p, y, amount));
    then section_104a_amount_excluded(p, y, PhysicalInjuryOrSicknessDamages, amount);
}
// "(other than punitive damages)" needs no separate rule concluding a
// negative: `PhysicalInjuryDamagesExcluded` above already guards on
// `not_known(is_punitive_damages(...))`, so punitive damages simply are
// not concluded excluded by that rule; `PunitiveDamagesExcludedViaWrongfulDeathCarveout`
// below is the ONLY route by which punitive damages become excluded.
@source(IRC_S104_C, quote = "The phrase \"(other than punitive damages)\" shall not apply to punitive damages awarded in a civil action—")
rule PunitiveDamagesExcludedViaWrongfulDeathCarveout(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 104(c): punitive damages in a qualifying wrongful-death action are excluded despite being punitive";
    when section_104a_item(p, y, PhysicalInjuryOrSicknessDamages, amount);
    when is_punitive_damages(p, y, amount);
    when punitive_damages_carveout_reinstated_104c(p, y, amount);
    when not attributable_to_prior_year_213_deduction_104(p, y, PhysicalInjuryOrSicknessDamages, amount);
    then section_104a_amount_excluded(p, y, PhysicalInjuryOrSicknessDamages, amount);
}
// "emotional distress shall not be treated as a physical injury" needs no
// separate rule concluding a negative either: `PhysicalInjuryDamagesExcluded`
// guards on `not_known(is_emotional_distress_not_physical(...))`, so
// emotional-distress damages simply are not concluded excluded by that
// rule; `EmotionalDistressDamagesUpToMedicalCareExcluded` below is the ONLY
// route by which such damages become excluded (up to the medical-care cap).
@source(IRC_S104_A, quote = "The preceding sentence shall not apply to an amount of damages not in excess of the amount paid for medical care (described in subparagraph (A) or (B) of section 213(d)(1)) attributable to emotional distress.")
rule EmotionalDistressDamagesUpToMedicalCareExcluded(p: Individual, y: TaxableYear, amount: Money, medical_care_paid: Money) strict {
    label en official "emotional-distress damages up to the amount paid for medical care attributable to the distress remain excluded";
    when section_104a_item(p, y, PhysicalInjuryOrSicknessDamages, amount);
    when is_emotional_distress_not_physical(p, y, amount);
    when emotional_distress_damages_up_to_medical_care_paid(p, y, amount, medical_care_paid);
    when amount <= medical_care_paid;
    when not attributable_to_prior_year_213_deduction_104(p, y, PhysicalInjuryOrSicknessDamages, amount);
    then section_104a_amount_excluded(p, y, PhysicalInjuryOrSicknessDamages, amount);
}

// --- §104(a)(3): accident/health insurance for non-employer-funded coverage --

relation received_through_accident_or_health_arrangement(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "amounts received through accident or health insurance (or an arrangement having that effect) for personal injuries or sickness (section 104(a)(3))";
}
relation is_employer_funded_within_105(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount is one an EMPLOYEE received to the extent attributable to un-included employer contributions or paid by the employer (section 104(a)(3) parenthetical) — carved OUT of (a)(3), governed instead by section 105";
}
@source(IRC_S104_A, quote = "amounts received through accident or health insurance (or through an arrangement having the effect of accident or health insurance) for personal injuries or sickness (other than amounts received by an employee, to the extent such amounts (A) are attributable to contributions by the employer which were not includible in the gross income of the employee, or (B) are paid by the employer)")
rule AccidentHealthInsuranceExcludedNotEmployerFunded(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 104(a)(3): amounts received for injury/sickness through accident or health insurance are excluded, EXCEPT the employer-funded portion (which section 105 governs instead)";
    when section_104a_item(p, y, AccidentOrHealthInsurance, amount);
    when received_through_accident_or_health_arrangement(p, y, amount);
    when not attributable_to_prior_year_213_deduction_104(p, y, AccidentOrHealthInsurance, amount);
    when not_known(is_employer_funded_within_105(p, y, amount));
    then section_104a_amount_excluded(p, y, AccidentOrHealthInsurance, amount);
}
// The (a)(3) flush language treating certain self-employed section 401(a)/
// 403(a) trust contributions AS employer contributions "for purposes of
// paragraph (3)" is folded into `is_employer_funded_within_105`'s own scope
// (a case asserting that fact pattern already carves the amount out of
// (a)(3), consistent with the glossary-folding convention used throughout
// this package); classification EXECUTABLE via the fact, not a separate rule.

// --- §104(a)(4): armed-forces/Coast-and-Geodetic-Survey/PHS pension ----------

relation active_service_disability_pension(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "a pension, annuity, or similar allowance for personal injuries or sickness resulting from active service in the armed forces of any country, the Coast and Geodetic Survey, or the Public Health Service, or a section 808 Foreign Service Act disability annuity (section 104(a)(4))";
}
relation section_104b_termination_applies(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 104(b)'s termination of (a)(4) applies to this individual/amount (the individual is not within the (b)(2) grandfathering categories, or the (b)(3) combat-related-injury cap otherwise limits the excludable amount) — EXTERNAL_DEPENDENCY: the (b)(2)/(b)(3)/(b)(4) grandfathering and floor computation is not itself derived, only asserted as a case fact this stage";
}
@source(IRC_S104_A, quote = "amounts received as a pension, annuity, or similar allowance for personal injuries or sickness resulting from active service in the armed forces of any country or in the Coast and Geodetic Survey or the Public Health Service, or as a disability annuity payable under the provisions of section 808 of the Foreign Service Act of 1980")
rule ActiveServiceDisabilityPensionExcluded(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 104(a)(4): active-service disability pension/annuity amounts are excluded, unless section 104(b) terminates the exclusion for this individual";
    when section_104a_item(p, y, ArmedForcesOrPublicHealthServicePension, amount);
    when active_service_disability_pension(p, y, amount);
    when not attributable_to_prior_year_213_deduction_104(p, y, ArmedForcesOrPublicHealthServicePension, amount);
    when not_known(section_104b_termination_applies(p, y, amount));
    then section_104a_amount_excluded(p, y, ArmedForcesOrPublicHealthServicePension, amount);
}

// --- §104(a)(5): terroristic/military-action disability income --------------

relation disability_income_from_terroristic_or_military_action(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "disability income attributable to injuries incurred as a direct result of a terroristic or military action (as defined in section 692(c)(2)) (section 104(a)(5))";
}
@source(IRC_S104_A, quote = "amounts received by an individual as disability income attributable to injuries incurred as a direct result of a terroristic or military action (as defined in section 692(c)(2))")
rule TerroristOrMilitaryActionDisabilityIncomeExcluded(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 104(a)(5): disability income from a terroristic or military action injury is excluded";
    when section_104a_item(p, y, TerroristOrMilitaryActionDisabilityIncome, amount);
    when disability_income_from_terroristic_or_military_action(p, y, amount);
    when not attributable_to_prior_year_213_deduction_104(p, y, TerroristOrMilitaryActionDisabilityIncome, amount);
    then section_104a_amount_excluded(p, y, TerroristOrMilitaryActionDisabilityIncome, amount);
}

// --- §104(a)(6): public safety officer survivor compensation ----------------
// (a)(6)(A) (42 U.S.C. 3796) and (a)(6)(B) (State survivor-compensation
// programs, with the line-of-duty proviso) are each a narrow, statute-
// specific classification; declared as a row of the same enum
// (`PublicSafetyOfficerSurvivorCompensation`) but not given their own rule
// this pass — TECH_GAP (the (B) proviso "except that subparagraph (B)
// shall not apply to any amounts that would have been payable if death...
// had occurred other than as the direct and proximate result of a personal
// injury sustained in the line of duty" is a genuine counterfactual
// comparison this package does not attempt to model).

// --- §104(b): termination of (a)(4) in certain cases -------------------------
// The full grandfathering test ((b)(2)(A)-(D): pre-9/24/1975 entitlement or
// membership, combat-related injury, or VA disability-compensation
// eligibility) and the (b)(3) combat-related-injury definition and (b)(4)
// not-less-than-VA-compensation floor are each read as the single case fact
// `section_104b_termination_applies` above (EXTERNAL_DEPENDENCY / TECH_GAP:
// the grandfathering/floor computation itself is not derived).

// --- §104(c): see PunitiveDamagesExcludedViaWrongfulDeathCarveout above ------

// --- §104(d): cross references ------------------------------------------------
// (d)(1) points to section 106 (already formalized in this same package,
// this stage) and (d)(2) to 10 U.S.C. 1403 (outside Title 26 entirely) —
// NON_NORMATIVE pointers, no independent content.
