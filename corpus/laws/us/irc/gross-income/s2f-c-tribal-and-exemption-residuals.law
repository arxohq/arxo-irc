// Stage 2f (TECH_GAP reduction) — §139D(b)-(d), §139E(b)-(c), §139F(b)-(c),
// §139G(c)-(d) definitions; §151(c) and (d)(3) (the phaseout, whose stepped
// percentage uses the "CEILING" rounding mode of `round`).
// STATUS: implemented_unverified (static check only; scenarios in
// tests/s2f-c-tribal-and-exemption-residuals.lawtest are NOT executed).
// Same technique as s2f-b: the definition is decomposed here and a PARALLEL
// exclusion rule reads the derived status; the earlier fact-based rule stays.

// =====================================================================
// §139D(b)-(d): qualified Indian health care benefit
// =====================================================================

use self::{
    IRC_S139D_A,
    IRC_S139D_B,
    IRC_S139D_D,
    IRC_S139E_A,
    IRC_S139E_B,
    IRC_S139E_C,
    IRC_S139F_A,
    IRC_S139F_B,
    IRC_S139F_C,
    IRC_S139G_A,
    IRC_S139G_C,
    IRC_S151_C,
    IRC_S151_D,
    Individual,
    Person,
    TaxableYear,
    adjusted_gross_income,
    applicable_amount_68,
    base_exemption_amount_151,
    dependent_of,
    is_dependent_of_anyone_base,
    native_corporation_assigned_payment_139g,
    wrongful_incarceration_award,
};

pub enum IndianHealthCareBenefitLimb139D {
    IndianHealthServiceProvidedOrPurchased;   // (b)(1)
    TribalMedicalCare;                        // (b)(2)
    TribalHealthInsuranceCoverage;            // (b)(3)
    TribalSupplementalMedicalCare;            // (b)(4)
}
relation indian_health_benefit_item_139d(p: Individual, y: TaxableYear, limb: IndianHealthCareBenefitLimb139D, amount: Money) kind empirical {
    label en official "a health service, medical care, coverage or other benefit received by the individual, classified into one of the four limbs of section 139D(b)";
}
relation indian_health_benefit_by_tribe_for_member_or_family_139d(p: Individual, y: TaxableYear, limb: IndianHealthCareBenefitLimb139D) kind empirical {
    label en official "the benefit of limbs (2)-(4) is provided by an Indian tribe or tribal organization to, or for, a member of an Indian tribe, including a spouse or dependent of such a member (dependent within section 152 determined without regard to (b)(1), (b)(2) and (d)(1)(B), section 139D(c)(5))";
}
relation indian_health_benefit_through_ihs_grant_contract_or_compact_139d1(p: Individual, y: TaxableYear) kind empirical {
    label en official "the benefit is provided or purchased, directly or indirectly, by the Indian Health Service through a grant to or a contract or compact with an Indian tribe or tribal organization, or through a third-party program funded by the Indian Health Service (section 139D(b)(1))";
}
relation indian_health_benefit_supplements_federal_program_139d4(p: Individual, y: TaxableYear) kind empirical {
    label en official "the other medical care supplements, replaces or substitutes for a program or service relating to medical care provided by the Federal government to Indian tribes or their members (section 139D(b)(4))";
}
pub relation qualified_indian_health_care_benefit_derived_139d(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "a qualified Indian health care benefit derived from the four limbs of section 139D(b)";
}
@source(IRC_S139D_B, relation = formalizes, coverage = exact, quote = "(1) any health service or benefit provided or purchased, directly or indirectly, by the Indian Health Service through a grant to or a contract or compact with an Indian tribe or tribal organization, or through a third-party program funded by the Indian Health Service,")
rule QualifiedIndianHealthCareBenefitLimb1(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 139D(b)(1)";
    when indian_health_benefit_item_139d(p, y, IndianHealthServiceProvidedOrPurchased, amount);
    when indian_health_benefit_through_ihs_grant_contract_or_compact_139d1(p, y);
    then qualified_indian_health_care_benefit_derived_139d(p, y, amount);
}
@source(IRC_S139D_B, relation = formalizes, coverage = exact, quote = "(2) medical care provided or purchased by, or amounts to reimburse for such medical care provided by, an Indian tribe or tribal organization for, or to, a member of an Indian tribe, including a spouse or dependent of such a member,")
rule QualifiedIndianHealthCareBenefitLimb2(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 139D(b)(2)";
    when indian_health_benefit_item_139d(p, y, TribalMedicalCare, amount);
    when indian_health_benefit_by_tribe_for_member_or_family_139d(p, y, TribalMedicalCare);
    then qualified_indian_health_care_benefit_derived_139d(p, y, amount);
}
@source(IRC_S139D_B, relation = formalizes, coverage = exact, quote = "(3) coverage under accident or health insurance (or an arrangement having the effect of accident or health insurance), or an accident or health plan, provided by an Indian tribe or tribal organization for medical care to a member of an Indian tribe, include a spouse or dependent of such a member, and")
rule QualifiedIndianHealthCareBenefitLimb3(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 139D(b)(3)";
    when indian_health_benefit_item_139d(p, y, TribalHealthInsuranceCoverage, amount);
    when indian_health_benefit_by_tribe_for_member_or_family_139d(p, y, TribalHealthInsuranceCoverage);
    then qualified_indian_health_care_benefit_derived_139d(p, y, amount);
}
@source(IRC_S139D_B, relation = formalizes, coverage = exact, quote = "(4) any other medical care provided by an Indian tribe or tribal organization that supplements, replaces, or substitutes for a program or service relating to medical care provided by the Federal government to Indian tribes or members of such a tribe.")
rule QualifiedIndianHealthCareBenefitLimb4(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 139D(b)(4)";
    when indian_health_benefit_item_139d(p, y, TribalSupplementalMedicalCare, amount);
    when indian_health_benefit_by_tribe_for_member_or_family_139d(p, y, TribalSupplementalMedicalCare);
    when indian_health_benefit_supplements_federal_program_139d4(p, y);
    then qualified_indian_health_care_benefit_derived_139d(p, y, amount);
}
relation indian_health_benefit_excluded_under_other_provision_139d(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the part of the benefit that is not includible in gross income of the beneficiary under any other provision of this chapter (section 139D(d))";
}
relation indian_health_benefit_deduction_allowed_139d(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the part of the benefit for which a deduction is allowed to the beneficiary under any other provision of this chapter (section 139D(d))";
}
pub relation indian_health_care_benefit_excluded_derived_139d(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 139D(a) exclusion after subsection (d): the benefit less the part excluded under another provision or deducted, not below zero";
}
@source(IRC_S139D_D, relation = formalizes, coverage = exact, quote = "Subsection (a) shall not apply to the amount of any qualified Indian health care benefit which is not includible in gross income of the beneficiary of such benefit under any other provision of this chapter, or to the amount of any such benefit for which a deduction is allowed to such beneficiary under any other provision of this chapter.")
rule IndianHealthCareBenefitExcludedDerived(p: Individual, y: TaxableYear, amount: Money, other: Money, deducted: Money) strict {
    label en official "section 139D(a) with (d): the amount the exclusion adds is the benefit minus the parts already excluded or deducted";
    when qualified_indian_health_care_benefit_derived_139d(p, y, amount);
    when indian_health_benefit_excluded_under_other_provision_139d(p, y, other);
    when indian_health_benefit_deduction_allowed_139d(p, y, deducted);
    when amount > other + deducted;
    then indian_health_care_benefit_excluded_derived_139d(p, y, round(amount - (other + deducted), 2, "HALF_UP"));
}
@source(IRC_S139D_A, relation = formalizes, coverage = partial, quote = "gross income does not include the value of any qualified Indian health care benefit")
rule IndianHealthCareBenefitExcludedNoOverlap(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 139D(a): with no part excluded or deducted under another provision (asserted as zero), the whole benefit is excluded";
    when qualified_indian_health_care_benefit_derived_139d(p, y, amount);
    when indian_health_benefit_excluded_under_other_provision_139d(p, y, 0.00 USD);
    when indian_health_benefit_deduction_allowed_139d(p, y, 0.00 USD);
    then indian_health_care_benefit_excluded_derived_139d(p, y, amount);
}

// =====================================================================
// §139E(b)-(c): Indian general welfare benefit
// =====================================================================

pub entity TribalWelfareBenefit139E {
    label en unofficial "a payment made or services provided to or on behalf of a tribal member under a tribal government program (case-asserted)";
}
relation tribal_benefit_recipient_139e(b: TribalWelfareBenefit139E, p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the recipient, year and amount of the benefit";
}
relation recipient_is_tribe_member_or_spouse_or_dependent_139e(b: TribalWelfareBenefit139E) kind empirical {
    label en official "the recipient is a member of an Indian tribe or a spouse or dependent of such a member (dependent within section 152 determined without regard to (b)(1), (b)(2) and (d)(1)(B), section 139E(c)(2))";
}
relation benefit_under_program_of_tribal_government_139e(b: TribalWelfareBenefit139E) kind empirical {
    label en official "the benefit is made or provided pursuant to a program of an Indian tribal government, including any agency or instrumentality of it and any Alaska Native regional or village corporation (section 139E(c)(1))";
}
relation program_established_by_tribal_custom_or_practice_139ec4(b: TribalWelfareBenefit139E) kind empirical {
    label en official "the program is established by tribal custom or government practice (section 139E(c)(4)): it does not fail to be a tribal government program by that reason alone";
}
relation program_administered_under_specified_guidelines_139eb1(b: TribalWelfareBenefit139E) kind empirical {
    label en official "the program is administered under specified guidelines (section 139E(b)(1))";
}
relation program_discriminates_in_favor_of_governing_body_139eb1(b: TribalWelfareBenefit139E) kind empirical {
    label en official "the program discriminates in favor of members of the governing body of the tribe (section 139E(b)(1))";
}
relation benefit_available_to_any_member_meeting_guidelines_139eb2A(b: TribalWelfareBenefit139E) kind empirical {
    label en official "the benefits are available to any tribal member who meets the guidelines (section 139E(b)(2)(A))";
}
relation benefit_promotes_general_welfare_139eb2B(b: TribalWelfareBenefit139E) kind empirical {
    label en official "the benefits are for the promotion of general welfare (section 139E(b)(2)(B))";
}
external judgment relation benefit_lavish_or_extravagant_139eb2C(b: TribalWelfareBenefit139E) {
    authority Secretary;
    label en official "the benefit is lavish or extravagant (section 139E(b)(2)(C)); the Secretary establishes the guidelines for what constitutes lavish or extravagant benefits in consultation with the Tribal Advisory Committee (section 139E(c)(3)) - an evaluative element, DECISION-0194 channel of the authority the text names";
}
relation benefit_is_compensation_for_services_139eb2D(b: TribalWelfareBenefit139E) kind empirical {
    label en official "the benefit is compensation for services (section 139E(b)(2)(D))";
}
relation benefit_is_cultural_item_reimbursement_or_honorarium_139ec5(b: TribalWelfareBenefit139E) kind empirical {
    label en official "the benefit is an item of cultural significance, a reimbursement of costs, or a cash honorarium for participation in cultural or ceremonial activities for the transmission of tribal culture (section 139E(c)(5)): not compensation for services";
}
relation benefit_treated_as_compensation_for_services_139e(b: TribalWelfareBenefit139E) kind institutional {
    label en official "the benefit is treated as compensation for services: it is compensation and not within the (c)(5) cultural exception";
}
rule BenefitTreatedAsCompensationForServices(b: TribalWelfareBenefit139E) strict {
    label en official "section 139E(b)(2)(D) with (c)(5)";
    when benefit_is_compensation_for_services_139eb2D(b);
    when not_known(benefit_is_cultural_item_reimbursement_or_honorarium_139ec5(b));
    then benefit_treated_as_compensation_for_services_139e(b);
}
relation tribal_government_program_139e(b: TribalWelfareBenefit139E) kind institutional {
    label en official "the program is an Indian tribal government program (section 139E(b), (c)(1), (c)(4))";
}
@source(IRC_S139E_C, relation = formalizes, coverage = exact, quote = "the term \"Indian tribal government\" includes any agencies or instrumentalities of an Indian tribal government and any Alaska Native regional or village corporation")
rule TribalGovernmentProgramByGovernment(b: TribalWelfareBenefit139E) strict {
    label en official "section 139E(c)(1)";
    when benefit_under_program_of_tribal_government_139e(b);
    then tribal_government_program_139e(b);
}
@source(IRC_S139E_C, relation = formalizes, coverage = exact, quote = "A program shall not fail to be treated as an Indian tribal government program solely by reason of the program being established by tribal custom or government practice.")
rule TribalGovernmentProgramByCustom(b: TribalWelfareBenefit139E) strict {
    label en official "section 139E(c)(4)";
    when program_established_by_tribal_custom_or_practice_139ec4(b);
    when benefit_under_program_of_tribal_government_139e(b);
    then tribal_government_program_139e(b);
}
pub relation indian_general_welfare_benefit_derived_139e(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "an Indian general welfare benefit derived from the conditions of section 139E(b)";
}
@source(IRC_S139E_B, relation = formalizes, coverage = exact, quote = "(1) the program is administered under specified guidelines and does not discriminate in favor of members of the governing body of the tribe, and")
rule IndianGeneralWelfareBenefitDerived(p: Individual, y: TaxableYear, amount: Money, b: TribalWelfareBenefit139E) strict {
    label en official "section 139E(b)(1)-(2)(A)-(D): guidelines and no discrimination, availability to any member meeting the guidelines, general welfare, not lavish or extravagant, not compensation for services";
    when tribal_benefit_recipient_139e(b, p, y, amount);
    when recipient_is_tribe_member_or_spouse_or_dependent_139e(b);
    when tribal_government_program_139e(b);
    when program_administered_under_specified_guidelines_139eb1(b);
    when not_known(program_discriminates_in_favor_of_governing_body_139eb1(b));
    when benefit_available_to_any_member_meeting_guidelines_139eb2A(b);
    when benefit_promotes_general_welfare_139eb2B(b);
    when not_known(benefit_lavish_or_extravagant_139eb2C(b));
    when not_known(benefit_treated_as_compensation_for_services_139e(b));
    then indian_general_welfare_benefit_derived_139e(p, y, amount);
}
pub relation indian_general_welfare_benefit_excluded_derived_139e(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "gross income does not include the value of a derived Indian general welfare benefit (section 139E(a))";
}
@source(IRC_S139E_A, relation = formalizes, coverage = exact, quote = "Gross income does not include the value of any Indian general welfare benefit.")
rule IndianGeneralWelfareBenefitExcludedDerived(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 139E(a) over the derived status";
    when indian_general_welfare_benefit_derived_139e(p, y, amount);
    then indian_general_welfare_benefit_excluded_derived_139e(p, y, amount);
}

// =====================================================================
// §139F(b)-(c): wrongfully incarcerated individual
// =====================================================================

relation convicted_of_offense_139fb1(p: Individual, offense: us.irc.core::Organ) kind empirical {
    label en official "the individual was convicted of the offense (section 139F(b)(1)); the offense is any criminal offense under Federal or State law and includes any offense arising from the same course of conduct (section 139F(c)); the second argument names the offense record";
}
relation offense_is_federal_or_state_criminal_offense_139fc(offense: us.irc.core::Organ) kind empirical {
    label en official "the offense is a criminal offense under Federal or State law, or arises from the same course of conduct as one (section 139F(c))";
}
pub relation covered_offense_139fc(offense: us.irc.core::Organ) kind institutional {
    label en official "a covered offense within the meaning of section 139F(c)";
}
@source(IRC_S139F_C, relation = formalizes, coverage = exact, quote = "For purposes of this section, the term \"covered offense\" means any criminal offense under Federal or State law, and includes any criminal offense arising from the same course of conduct as that criminal offense.")
rule CoveredOffenseDefined(offense: us.irc.core::Organ) strict {
    label en official "section 139F(c)";
    when offense_is_federal_or_state_criminal_offense_139fc(offense);
    then covered_offense_139fc(offense);
}
relation served_sentence_of_imprisonment_for_offense_139fb2(p: Individual, offense: us.irc.core::Organ) kind empirical {
    label en official "the individual served all or part of a sentence of imprisonment relating to the covered offense (section 139F(b)(2))";
}
relation pardoned_clemency_or_amnesty_because_innocent_139fb3A(p: Individual, offense: us.irc.core::Organ) kind empirical {
    label en official "the individual was pardoned, granted clemency or granted amnesty for the offense because the individual was innocent of it (section 139F(b)(3)(A))";
}
relation judgment_of_conviction_reversed_or_vacated_139fb3Bi(p: Individual, offense: us.irc.core::Organ) kind empirical {
    label en official "the judgment of conviction for the offense was reversed or vacated (section 139F(b)(3)(B)(i))";
}
relation accusation_dismissed_or_found_not_guilty_at_new_trial_139fb3Bii(p: Individual, offense: us.irc.core::Organ) kind empirical {
    label en official "the indictment, information or other accusatory instrument for the offense was dismissed, or the individual was found not guilty at a new trial after the reversal or vacating (section 139F(b)(3)(B)(ii))";
}
pub relation wrongfully_incarcerated_individual_derived_139f(p: Individual) kind institutional {
    label en official "a wrongfully incarcerated individual derived from section 139F(b)(1)-(3)";
}
@source(IRC_S139F_B, relation = formalizes, coverage = exact, quote = "(A) who was pardoned, granted clemency, or granted amnesty for that covered offense because that individual was innocent of that covered offense, or")
rule WrongfullyIncarceratedByPardonForInnocence(p: Individual, offense: us.irc.core::Organ) strict {
    label en official "section 139F(b)(1), (2), (3)(A)";
    when convicted_of_offense_139fb1(p, offense);
    when covered_offense_139fc(offense);
    when served_sentence_of_imprisonment_for_offense_139fb2(p, offense);
    when pardoned_clemency_or_amnesty_because_innocent_139fb3A(p, offense);
    then wrongfully_incarcerated_individual_derived_139f(p);
}
@source(IRC_S139F_B, relation = formalizes, coverage = exact, quote = "(B)(i) for whom the judgment of conviction for that covered offense was reversed or vacated, and")
rule WrongfullyIncarceratedByReversalAndDismissal(p: Individual, offense: us.irc.core::Organ) strict {
    label en official "section 139F(b)(1), (2), (3)(B)(i)-(ii)";
    when convicted_of_offense_139fb1(p, offense);
    when covered_offense_139fc(offense);
    when served_sentence_of_imprisonment_for_offense_139fb2(p, offense);
    when judgment_of_conviction_reversed_or_vacated_139fb3Bi(p, offense);
    when accusation_dismissed_or_found_not_guilty_at_new_trial_139fb3Bii(p, offense);
    then wrongfully_incarcerated_individual_derived_139f(p);
}
pub relation wrongful_incarceration_award_excluded_derived_139f(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 139F(a) exclusion over the derived status";
}
@source(IRC_S139F_A, relation = formalizes, coverage = partial, quote = "gross income shall not include any civil damages, restitution, or other monetary award (including compensatory or statutory damages and restitution")
rule WrongfulIncarcerationAwardExcludedDerived(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 139F(a)";
    when wrongfully_incarcerated_individual_derived_139f(p);
    when wrongful_incarceration_award(p, y, amount);
    then wrongful_incarceration_award_excluded_derived_139f(p, y, amount);
}

// =====================================================================
// §139G(c)-(d): formalities of an assignment to a Settlement Trust
// =====================================================================

pub entity NativeCorporationAssignment139G {
    label en unofficial "an assignment by a Native Corporation of payments to a Settlement Trust (case-asserted)";
}
relation assignment_described_with_reasonable_particularity_139gc(a: NativeCorporationAssignment139G) kind empirical {
    label en official "the amount and scope of the assignment are described with reasonable particularity (section 139G(c))";
}
pub enum AssignmentAmountForm139G { PercentageOfPayments; FixedDollarAmount; OtherForm; }
relation assignment_amount_form_139gc(a: NativeCorporationAssignment139G, form: AssignmentAmountForm139G) kind empirical {
    label en official "the assignment is in a percentage of one or more payments or in a fixed dollar amount (section 139G(c))";
}
relation assignment_duration_specified_139gd1(a: NativeCorporationAssignment139G) kind empirical {
    label en official "the assignment specifies a duration, either in perpetuity or for a period of time (section 139G(d)(1))";
}
relation assignment_revocability_specified_139gd2(a: NativeCorporationAssignment139G) kind empirical {
    label en official "the assignment specifies whether it is revocable (section 139G(d)(2))";
}
relation assignment_of_payment_139g(a: NativeCorporationAssignment139G, corp: Person, trust: Person) kind empirical {
    label en official "the assignment is made by the Native Corporation to the Settlement Trust";
}
pub relation assignment_formalities_met_139g(a: NativeCorporationAssignment139G) kind institutional {
    label en official "the assignment meets the description requirement of section 139G(c) and specifies duration and revocability (section 139G(d))";
}
@source(IRC_S139G_C, relation = formalizes, coverage = exact, quote = "The amount and scope of any assignment under subsection (a) shall be described with reasonable particularity and may either be in a percentage of one or more such payments or in a fixed dollar amount.")
rule AssignmentFormalitiesMetPercentage(a: NativeCorporationAssignment139G) strict {
    label en official "section 139G(c) (percentage form), (d)(1)-(2)";
    when assignment_described_with_reasonable_particularity_139gc(a);
    when assignment_amount_form_139gc(a, PercentageOfPayments);
    when assignment_duration_specified_139gd1(a);
    when assignment_revocability_specified_139gd2(a);
    then assignment_formalities_met_139g(a);
}
rule AssignmentFormalitiesMetFixedAmount(a: NativeCorporationAssignment139G) strict {
    label en official "section 139G(c) (fixed dollar form), (d)(1)-(2)";
    when assignment_described_with_reasonable_particularity_139gc(a);
    when assignment_amount_form_139gc(a, FixedDollarAmount);
    when assignment_duration_specified_139gd1(a);
    when assignment_revocability_specified_139gd2(a);
    then assignment_formalities_met_139g(a);
}
pub relation native_corporation_assigned_payment_excluded_derived_139g(corp: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 139G(a) exclusion for an assignment that meets the (c)-(d) formalities";
}
@source(IRC_S139G_A, relation = formalizes, coverage = partial, quote = "In the case of a Native Corporation, gross income shall not include the value of any payments that would otherwise be made, or treated as being made, to such Native Corporation")
rule NativeCorporationAssignedPaymentExcludedDerived(a: NativeCorporationAssignment139G, corp: Person, trust: Person, y: TaxableYear, amount: Money) strict {
    label en official "section 139G(a) with (c)-(d)";
    when assignment_of_payment_139g(a, corp, trust);
    when assignment_formalities_met_139g(a);
    when native_corporation_assigned_payment_139g(corp, trust, y, amount);
    then native_corporation_assigned_payment_excluded_derived_139g(corp, y, amount);
}

// =====================================================================
// §151(c): exemption for each dependent; (d)(3): phaseout
// =====================================================================

pub relation dependent_exemption_amount_151c(p: Individual, dep: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the exemption of the exemption amount for one individual who is a dependent (section 152) of the taxpayer for the taxable year (section 151(c)); the exemption amount of section 151(d)(1) is used, not the dependent's own zeroed amount of (d)(2)";
}
@source(IRC_S151_C, relation = formalizes, coverage = exact, quote = "An exemption of the exemption amount for each individual who is a dependent (as defined in section 152) of the taxpayer for the taxable year.")
rule DependentExemptionAmount(p: Individual, dep: Individual, y: TaxableYear, base: Money) defeasible {
    label en official "section 151(c): one exemption of the exemption amount per dependent; the sum over dependents needs the count of a derived relation (TECH-GAPS G4500)";
    when dependent_of(dep, p, y);
    when base_exemption_amount_151(y, base);
    then dependent_exemption_amount_151c(p, dep, y, base);
}
relation claimed_dependent_count_151c(p: Individual, y: TaxableYear, n: Integer) kind empirical {
    label en official "the number of individuals who are dependents of the taxpayer for the year, counted from the case's own dependency findings (an aggregate over the derived dependent_of relation is not supported, TECH-GAPS G4500)";
}
pub relation dependents_exemption_total_151c(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the total of the section 151(c) exemptions: the exemption amount times the number of dependents";
}
rule DependentsExemptionTotal(p: Individual, y: TaxableYear, base: Money, n: Integer) strict {
    label en official "section 151(c): base x n";
    when claimed_dependent_count_151c(p, y, n);
    when base_exemption_amount_151(y, base);
    then dependents_exemption_total_151c(p, y, round(base * n, 2, "HALF_UP"));
}

pub relation exemption_phaseout_percentage_151d3(p: Individual, y: TaxableYear, percentage: Decimal) kind institutional {
    label en official "the applicable percentage of section 151(d)(3)(B): 2 percentage points for each $2,500 ($1,250 for a married individual filing a separate return) or fraction thereof by which adjusted gross income exceeds the applicable amount under section 68(b), never more than 100 percent";
}
@source(IRC_S151_D, relation = formalizes, coverage = exact, quote = "For purposes of subparagraph (A), the term \"applicable percentage\" means 2 percentage points for each $2,500 (or fraction thereof) by which the taxpayer's adjusted gross income for the taxable year exceeds the applicable amount in effect under section 68(b).")
rule ExemptionPhaseoutPercentageStandard(p: Individual, y: TaxableYear, agi: Money, applicable: Money) strict {
    label en official "section 151(d)(3)(A)-(B), step $2,500: 0.02 x ceiling((AGI - applicable amount) / 2,500), capped at 1.00";
    when adjusted_gross_income(p, y, agi);
    when applicable_amount_68(p, y, applicable);
    when agi > applicable;
    when not_known(married_filing_separately_151d3(p, y));
    then exemption_phaseout_percentage_151d3(p, y, min(1.00, 0.02 * round((agi - applicable) / 2500.00 USD, 0, "CEILING")));
}
relation married_filing_separately_151d3(p: Individual, y: TaxableYear) kind institutional {
    label en official "the taxpayer is a married individual filing a separate return (section 151(d)(3)(B), second sentence)";
}
rule MarriedFilingSeparately151d3(p: Individual, y: TaxableYear) strict {
    label en official "filing status Married Filing Separately";
    when us.irc.income_individual::filing_status(p, y, us.irc.income_individual::MarriedSeparate);
    then married_filing_separately_151d3(p, y);
}
@source(IRC_S151_D, relation = formalizes, coverage = exact, quote = "In the case of a married individual filing a separate return, the preceding sentence shall be applied by substituting \"$1,250\" for \"$2,500\".")
rule ExemptionPhaseoutPercentageMarriedSeparate(p: Individual, y: TaxableYear, agi: Money, applicable: Money) strict {
    label en official "section 151(d)(3)(B), second sentence: step $1,250";
    when adjusted_gross_income(p, y, agi);
    when applicable_amount_68(p, y, applicable);
    when agi > applicable;
    when married_filing_separately_151d3(p, y);
    then exemption_phaseout_percentage_151d3(p, y, min(1.00, 0.02 * round((agi - applicable) / 1250.00 USD, 0, "CEILING")));
}
pub relation exemption_amount_after_phaseout_151d3(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the exemption amount of the taxpayer reduced by the applicable percentage (section 151(d)(3)(A))";
}
@source(IRC_S151_D, relation = formalizes, coverage = exact, quote = "In the case of any taxpayer whose adjusted gross income for the taxable year exceeds the applicable amount in effect under section 68(b), the exemption amount shall be reduced by the applicable percentage.")
rule ExemptionAmountReducedByPhaseout(p: Individual, y: TaxableYear, base: Money, pct: Decimal) strict {
    label en official "section 151(d)(3)(A): base x (1 - percentage), one rounding to cents HALF_UP (a judgment call: the text names no rounding)";
    when base_exemption_amount_151(y, base);
    when exemption_phaseout_percentage_151d3(p, y, pct);
    then exemption_amount_after_phaseout_151d3(p, y, round(base * (1.00 - pct), 2, "HALF_UP"));
}
pub relation deduction_allowable_to_another_taxpayer_ignoring_phaseout_151d3C(ind: Individual, y: TaxableYear) kind institutional {
    label en official "whether a deduction under section 151 with respect to the individual is allowable to another taxpayer is determined without applying the (d)(3) phaseout: the test reads only the base dependency relation, never the phaseout percentage";
}
@source(IRC_S151_D, relation = formalizes, coverage = exact, quote = "The provisions of this paragraph shall not apply for purposes of determining whether a deduction under this section with respect to any individual is allowable to another taxpayer for any taxable year.")
rule DeductionAllowableToAnotherIgnoringPhaseout(ind: Individual, y: TaxableYear) strict {
    label en official "section 151(d)(3)(C): structural coordination — the allowability test uses is_dependent_of_anyone_base and does not read exemption_phaseout_percentage_151d3";
    when is_dependent_of_anyone_base(ind, y);
    then deduction_allowable_to_another_taxpayer_ignoring_phaseout_151d3C(ind, y);
}
