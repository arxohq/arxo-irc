// Section 66 — Treatment of community income. Stage 1 (IRC-06).

use self::{
    IRC_S66_A,
    IRC_S66_B,
    IRC_S66_C,
    Individual,
    Secretary,
    TaxableYear,
};

relation married_to(p: Individual, spouse: Individual, y: TaxableYear) kind empirical {
    label en official "2 individuals are married to each other at any time during a calendar year (section 66(a)(1))";
}
relation live_apart_all_year(p: Individual, spouse: Individual, y: TaxableYear) kind empirical {
    label en official "the individuals live apart at all times during the calendar year (section 66(a)(2)(A))";
}
relation joint_return_filed_with(p: Individual, spouse: Individual, y: TaxableYear) kind empirical {
    label en official "the individuals do not file a joint return under section 6013 with each other for a taxable year beginning or ending in the calendar year (section 66(a)(2)(B), negated form used directly)";
}
relation earned_income_is_community_income(p: Individual, spouse: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "one or both individuals have earned income for the calendar year which is community income (section 66(a)(3))";
}
relation earned_income_transferred_between_spouses(p: Individual, spouse: Individual, y: TaxableYear) kind empirical {
    label en official "a portion of such earned income is transferred (directly or indirectly) between the individuals before the close of the calendar year (section 66(a)(4), negated form used directly)";
}
pub relation community_income_treated_under_879a(p: Individual, spouse: Individual, y: TaxableYear) kind institutional {
    label en official "community income treated in accordance with the rules provided by section 879(a) — the actual allocation is a dependency contract, producer: unresolved (section 879 is a subchapter N provision, likely `international`)";
}

@source(IRC_S66_A, quote = "then, for purposes of this title, any community income of such individuals for the calendar year shall be treated in accordance with the rules provided by section 879(a)")
rule CommunityIncomeSpousesLiveApart(p: Individual, spouse: Individual, y: TaxableYear, amount: Money) strict {
    label en official "community income of spouses who live apart all year, do not file jointly, and do not transfer the earned income between them, is treated under section 879(a)";
    when married_to(p, spouse, y);
    when live_apart_all_year(p, spouse, y);
    when not joint_return_filed_with(p, spouse, y);
    when earned_income_is_community_income(p, spouse, y, amount);
    when not earned_income_transferred_between_spouses(p, spouse, y);
    then community_income_treated_under_879a(p, spouse, y);
}

// --- §66(b): Secretary's power to disregard community property benefits ------

relation acted_as_if_solely_entitled(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "acted as if solely entitled to the income (section 66(b))";
}
relation failed_to_notify_spouse_by_due_date(p: Individual, y: TaxableYear) kind empirical {
    label en official "failed to notify the taxpayer's spouse before the due date (including extensions) of the nature and amount of the income (section 66(b))";
}
pub relation community_property_benefit_disallowed(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the benefits of community property law are disallowed as to this income (section 66(b))";
}

@source(IRC_S66_B, quote = "The Secretary may disallow the benefits of any community property law to any taxpayer with respect to any income if such taxpayer acted as if solely entitled to such income and failed to notify the taxpayer's spouse")
rule SecretaryDisallowCommunityBenefitsPowerRule(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "the Secretary has the power to disallow community-property benefits when the taxpayer acted as sole owner and failed to notify the spouse";
    when acted_as_if_solely_entitled(p, y, amount);
    when failed_to_notify_spouse_by_due_date(p, y);
    then power SecretaryDisallowCommunityBenefitsPower {
        holder Secretary;
        over p;
        exercise acted_as_if_solely_entitled(p, y, amount);
        valid_when acted_as_if_solely_entitled(p, y, amount);
        effect create(community_property_benefit_disallowed(p, y, amount));
        window [@1980-01-01, infinity);
    };
}

// --- §66(c): relief provision (evaluative element, DECISION-0194) ------------

relation no_joint_return_filed(p: Individual, y: TaxableYear) kind empirical {
    label en official "the individual does not file a joint return for the taxable year (section 66(c)(1))";
}
relation community_income_item_not_included(p: Individual, spouse: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "an item of community income properly includible in the individual's gross income, which under section 879(a) would be treated as the other spouse's income, was not included (section 66(c)(2))";
}
relation no_knowledge_or_reason_to_know(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the individual establishes no knowledge and no reason to know of the item of community income (section 66(c)(3))";
}

// §66(c)(4): "taking into account all facts and circumstances, it is
// inequitable to include such item" — DECISION-0194 evaluative channel:
// external judgment relation with the authority the text names (Secretary).
external judgment relation inequitable_to_include_in_gross_income(p: Individual, spouse: Individual, y: TaxableYear, amount: Money) {
    authority Secretary;
    label en official "taking into account all facts and circumstances, it is inequitable to include such item of community income in the individual's gross income (section 66(c))";
}
external judgment relation inequitable_to_hold_liable(p: Individual, y: TaxableYear) {
    authority Secretary;
    label en official "taking into account all facts and circumstances, it is inequitable to hold the individual liable for unpaid tax or a deficiency attributable to the item (section 66(c), second sentence)";
}

pub relation community_income_relief_reallocated_to_other_spouse(p: Individual, spouse: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the item of community income is included in the gross income of the other spouse and not the individual (section 66(c))";
}
pub relation community_income_liability_relief(p: Individual, y: TaxableYear) kind institutional {
    label en official "the individual is relieved of liability for unpaid tax or a deficiency attributable to the item (section 66(c), second sentence)";
}

@source(IRC_S66_C, quote = "then, for purposes of this title, such item of community income shall be included in the gross income of the other spouse (and not in the gross income of the individual)")
rule CommunityIncomeReliefReallocation(p: Individual, spouse: Individual, y: TaxableYear, amount: Money) strict {
    label en official "an individual who did not file jointly, did not include the item, had no knowledge or reason to know of it, and for whom inclusion would be inequitable, has the item reallocated to the other spouse";
    when no_joint_return_filed(p, y);
    when community_income_item_not_included(p, spouse, y, amount);
    when no_knowledge_or_reason_to_know(p, y, amount);
    when inequitable_to_include_in_gross_income(p, spouse, y, amount);
    then community_income_relief_reallocated_to_other_spouse(p, spouse, y, amount);
}

@source(IRC_S66_C, quote = "the Secretary may relieve such individual of such liability")
rule CommunityIncomeLiabilityReliefPowerRule(p: Individual, y: TaxableYear) strict {
    label en official "the Secretary has the power to relieve the individual of liability for unpaid tax or a deficiency where inclusion would be inequitable and (c)'s first-sentence relief is unavailable";
    when inequitable_to_hold_liable(p, y);
    then power CommunityIncomeLiabilityReliefPower {
        holder Secretary;
        over p;
        exercise inequitable_to_hold_liable(p, y);
        valid_when inequitable_to_hold_liable(p, y);
        effect create(community_income_liability_relief(p, y));
        window [@1980-01-01, infinity);
    };
}

// --- §66(d): definitions ---------------------------------------------------------
//
// (1) "earned income" — cross-reference to section 911(d)(2), a provision
// this package does not own (likely `international`, unconfirmed):
// EXTERNAL_DEPENDENCY, owner unresolved.
// (2)/(3) "community income"/"community property laws" — descriptive
// definitions turning on the community-property law of a State, foreign
// country, or U.S. possession; the case-asserted facts above
// (`earned_income_is_community_income`, etc.) already encode membership
// directly, so no separate executable rule adds content beyond restating
// the case fact's own label. classification = NON_NORMATIVE for (d)(2)-(3)
// themselves (pure glossary entries consumed by facts asserted elsewhere in
// this module), (d)(1) = EXTERNAL_DEPENDENCY.
