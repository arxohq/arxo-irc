// Sections 103, 107, 109-112, 115, 118, 122, 123, 126, 130, 131, 134, 136, 138
// (exclusions from gross income not formalized in stages 1-2d). Stage 2e
// (IRC-06), DECISION-0379. STATUS: implemented_unverified (static check only;
// scenarios in tests/s103-140-remaining-exclusions.lawtest are NOT executed).
//
// Sections 113, 114, 116, 120, 124, 128, 133 are repealed; 140 and 153 are
// cross-reference sections; both classes are classified in the coverage rows
// (repealed_or_reserved / non_normative), not modelled here.
//
// Deontics in this module:
//   §110(d)   duty of lessee and lessor to furnish information (time and
//             manner by regulations: no window is invented)
//   §118(d)   the statute of limitations extension (an institutional effect of
//             the taxpayer's notification, computed with a calendar-year step)
//   §126(c)   power of the taxpayer to elect out of section 126
//   §138(e)   duty of the trustee to furnish the section 220(h) report by
//             January 31 of the following calendar year
//
// External judgments (DECISION-0194): §126(b)(1)(A)-(B) determinations of the
// Secretary of Agriculture and of the Secretary of the Treasury.

// =====================================================================
// §103: interest on State and local bonds
// =====================================================================

use self::{
    BondIssue,
    IRC_S103_A,
    IRC_S103_B,
    IRC_S103_C,
    IRC_S107,
    IRC_S109,
    IRC_S110_A,
    IRC_S110_B,
    IRC_S110_C,
    IRC_S110_D,
    IRC_S111_A,
    IRC_S111_B,
    IRC_S111_C,
    IRC_S112_A,
    IRC_S112_B,
    IRC_S112_C,
    IRC_S112_D,
    IRC_S115,
    IRC_S118_A,
    IRC_S118_B,
    IRC_S118_C,
    IRC_S118_D,
    IRC_S122_A,
    IRC_S122_B,
    IRC_S123_B,
    IRC_S126_A,
    IRC_S126_B,
    IRC_S126_C,
    IRC_S126_D,
    IRC_S126_E,
    IRC_S130_A,
    IRC_S130_B,
    IRC_S130_C,
    IRC_S130_D,
    IRC_S131_A,
    IRC_S131_B,
    IRC_S131_C,
    IRC_S134_A,
    IRC_S134_B,
    IRC_S136_A,
    IRC_S136_B,
    IRC_S138_A,
    IRC_S138_C,
    IRC_S138_E,
    IRC_S141_D,
    IRC_S141_E,
    Individual,
    Person,
    Secretary,
    TaxableYear,
    advance_refunding_tax_exemption_denied_149d1,
    arbitrage_bond_148a,
    bond_tax_exemption_denied_federal_guarantee_149b,
    carryover_increase_counted_as_tax_reduction_111c,
    exempt_facility_bond_142a,
    issue_total_proceeds,
    issue_treated_as_arbitrage_bond_148f1,
    private_activity_bond,
    qualified_501c3_bond_145a,
    qualified_small_issue_bond_144a1,
    registration_required_bond_149a2,
    registration_requirement_satisfied_149a,
};

pub relation bond_issued_by(bond: us.irc.core::Asset, issuer: us.irc.core::Organ) kind empirical {
    label en official "the obligation is issued by the issuer (section 103(c)(1))";
}
pub relation issuer_is_state_or_political_subdivision(issuer: us.irc.core::Organ) kind empirical {
    label en official "the issuer is a State or a political subdivision of a State (section 103(c)(1)); \"State\" includes the District of Columbia and any possession of the United States (section 103(c)(2)) — the case asserts the fact under that definition";
}
pub relation state_or_local_bond(bond: us.irc.core::Asset) kind institutional {
    label en official "a State or local bond: an obligation of a State or political subdivision thereof (section 103(c)(1))";
}
@source(IRC_S103_C, relation = formalizes, coverage = exact, quote = "The term \"State or local bond\" means an obligation of a State or political subdivision thereof.")
rule StateOrLocalBondDefined(bond: us.irc.core::Asset, issuer: us.irc.core::Organ) strict {
    label en official "section 103(c)(1), with the (c)(2) extension of \"State\" carried in the issuer fact";
    when bond_issued_by(bond, issuer);
    when issuer_is_state_or_political_subdivision(issuer);
    then state_or_local_bond(bond);
}
pub relation bond_part_of_issue(bond: us.irc.core::Asset, issue: BondIssue) kind empirical {
    label en official "the bond is issued as part of the issue";
}
relation qualified_mortgage_bond_143(issue: BondIssue) kind empirical {
    label en official "the issue is an issue of qualified mortgage bonds (section 143(a)); the section 143 conditions not modelled elsewhere in this package (see coverage) are case facts";
}
relation qualified_veterans_mortgage_bond_143(issue: BondIssue) kind empirical {
    label en official "the issue is an issue of qualified veterans' mortgage bonds (section 143(b))";
}
relation qualified_student_loan_bond_144b(issue: BondIssue) kind empirical {
    label en official "the issue is an issue of qualified student loan bonds (section 144(b))";
}
relation qualified_redevelopment_bond_144c(issue: BondIssue) kind empirical {
    label en official "the issue is an issue of qualified redevelopment bonds (section 144(c))";
}
relation issue_meets_146_volume_cap(issue: BondIssue) kind empirical {
    label en official "the issue meets the applicable requirements of section 146 (volume cap); the cap amounts are a SOURCE_GAP of this package, so the outcome is a case fact (section 141(e)(2))";
}
relation issue_meets_147_requirements(issue: BondIssue) kind empirical {
    label en official "the bond meets the applicable requirements of each subsection of section 147; sections 147(c), (d), (f) are modelled in s142-150-bonds.law, the rest is not, so the outcome is a case fact (section 141(e)(3))";
}
relation qualified_bond_category_141e1(issue: BondIssue) kind institutional {
    label en official "helper: the issue is of one of the seven categories of section 141(e)(1)(A)-(G)";
}
rule QualifiedBondCategoryExemptFacility(issue: BondIssue) strict {
    label en official "section 141(e)(1)(A)";
    when exempt_facility_bond_142a(issue);
    then qualified_bond_category_141e1(issue);
}
rule QualifiedBondCategoryMortgage(issue: BondIssue) strict {
    label en official "section 141(e)(1)(B)";
    when qualified_mortgage_bond_143(issue);
    then qualified_bond_category_141e1(issue);
}
rule QualifiedBondCategoryVeteransMortgage(issue: BondIssue) strict {
    label en official "section 141(e)(1)(C)";
    when qualified_veterans_mortgage_bond_143(issue);
    then qualified_bond_category_141e1(issue);
}
rule QualifiedBondCategorySmallIssue(issue: BondIssue) strict {
    label en official "section 141(e)(1)(D)";
    when qualified_small_issue_bond_144a1(issue);
    then qualified_bond_category_141e1(issue);
}
rule QualifiedBondCategoryStudentLoan(issue: BondIssue) strict {
    label en official "section 141(e)(1)(E)";
    when qualified_student_loan_bond_144b(issue);
    then qualified_bond_category_141e1(issue);
}
rule QualifiedBondCategoryRedevelopment(issue: BondIssue) strict {
    label en official "section 141(e)(1)(F)";
    when qualified_redevelopment_bond_144c(issue);
    then qualified_bond_category_141e1(issue);
}
rule QualifiedBondCategory501c3(issue: BondIssue) strict {
    label en official "section 141(e)(1)(G)";
    when qualified_501c3_bond_145a(issue);
    then qualified_bond_category_141e1(issue);
}
pub relation qualified_bond_141e(issue: BondIssue) kind institutional {
    label en official "a qualified bond: a private activity bond of a section 141(e)(1) category, issued as part of an issue meeting section 146, and meeting section 147";
}
@source(IRC_S141_E, relation = formalizes, coverage = exact, quote = "the term \"qualified bond\" means any private activity bond if—")
rule QualifiedBondDefined(issue: BondIssue) strict {
    label en official "section 141(e)(1)-(3)";
    when private_activity_bond(issue);
    when qualified_bond_category_141e1(issue);
    when issue_meets_146_volume_cap(issue);
    when issue_meets_147_requirements(issue);
    then qualified_bond_141e(issue);
}
// =====================================================================
// §141(d)(1): issues used to acquire nongovernmental output property
// =====================================================================

pub relation proceeds_for_nongovernmental_output_property(issue: BondIssue, amount: Money) kind empirical {
    label en official "the amount of the proceeds of the issue to be used (directly or indirectly) for the acquisition by a governmental unit of nongovernmental output property (section 141(d)(1))";
}
relation nongovernmental_output_property_excepted_141d(issue: BondIssue) kind empirical {
    label en official "the property is excepted from \"nongovernmental output property\" by section 141(d)(3) (95 percent consumed in a qualified service or annexed area), (d)(4) (converted to nonoutput use), (d)(6) (joint action agencies applied at member level) or (d)(7) (prepaid electricity or gas contracts) — folded into one case fact (TECH_GAP: the sub-tests are not derived)";
}
pub relation nongovernmental_output_property_test_met_141d1(issue: BondIssue) kind institutional {
    label en official "the proceeds used to acquire nongovernmental output property exceed the lesser of 5 percent of the proceeds or $5,000,000";
}
@source(IRC_S141_D, relation = formalizes, coverage = exact, quote = "exceeds the lesser of—")
rule NongovernmentalOutputPropertyTestMet(issue: BondIssue, output: Money, total: Money) strict {
    label en official "section 141(d)(1)(A)-(B); exactly the lesser amount does not exceed it";
    when proceeds_for_nongovernmental_output_property(issue, output);
    when issue_total_proceeds(issue, total);
    when total > 0.00 USD;
    when not_known(nongovernmental_output_property_excepted_141d(issue));
    when output > min(round(total * 0.05, 2, "HALF_UP"), 5000000.00 USD);
    then nongovernmental_output_property_test_met_141d1(issue);
}
@source(IRC_S141_D, relation = formalizes, coverage = partial, quote = "the term \"private activity bond\" includes any bond issued as part of an issue if the amount of the proceeds of the issue")
rule PrivateActivityBondByNongovernmentalOutputProperty(issue: BondIssue) strict {
    label en official "section 141(d)(1): such an issue is a private activity bond";
    when nongovernmental_output_property_test_met_141d1(issue);
    then private_activity_bond(issue);
}

relation bond_fails_other_149_requirement(bond: us.irc.core::Asset) kind empirical {
    label en official "the bond fails an applicable requirement of section 149 not modelled here (section 149(c), (e)-(g)); a case fact";
}
relation bond_fails_149_requirement(bond: us.irc.core::Asset) kind institutional {
    label en official "helper: a modelled requirement of section 149 is not met (registration, federal guarantee, advance refunding, or an asserted other failure)";
}
rule Bond149FailureRegistration(bond: us.irc.core::Asset) strict {
    label en official "section 149(a): a registration-required bond not satisfying the registration requirement";
    when registration_required_bond_149a2(bond);
    when not_known(registration_requirement_satisfied_149a(bond));
    then bond_fails_149_requirement(bond);
}
rule Bond149FailureFederalGuarantee(bond: us.irc.core::Asset) strict {
    label en official "section 149(b)";
    when bond_tax_exemption_denied_federal_guarantee_149b(bond);
    then bond_fails_149_requirement(bond);
}
rule Bond149FailureAdvanceRefunding(bond: us.irc.core::Asset) strict {
    label en official "section 149(d)";
    when advance_refunding_tax_exemption_denied_149d1(bond);
    then bond_fails_149_requirement(bond);
}
rule Bond149FailureOther(bond: us.irc.core::Asset) strict {
    label en official "section 149, other subsections (asserted)";
    when bond_fails_other_149_requirement(bond);
    then bond_fails_149_requirement(bond);
}
relation section_103b_exception_applies(bond: us.irc.core::Asset) kind institutional {
    label en official "helper: one of the section 103(b)(1)-(3) exceptions applies to the bond";
}
@source(IRC_S103_B, relation = formalizes, coverage = exact, quote = "Any private activity bond which is not a qualified bond (within the meaning of section 141).")
rule Exception103b1PrivateActivityBondNotQualified(bond: us.irc.core::Asset, issue: BondIssue) strict {
    label en official "section 103(b)(1)";
    when bond_part_of_issue(bond, issue);
    when private_activity_bond(issue);
    when not_known(qualified_bond_141e(issue));
    then section_103b_exception_applies(bond);
}
@source(IRC_S103_B, relation = formalizes, coverage = exact, quote = "Any arbitrage bond (within the meaning of section 148).")
rule Exception103b2ArbitrageBond(bond: us.irc.core::Asset, issue: BondIssue) strict {
    label en official "section 103(b)(2), using this package's section 148 rules";
    when bond_part_of_issue(bond, issue);
    when arbitrage_bond_148a(issue);
    then section_103b_exception_applies(bond);
}
rule Exception103b2ArbitrageBondRebate(bond: us.irc.core::Asset, issue: BondIssue) strict {
    label en official "section 103(b)(2) with section 148(f)(1): a bond treated as an arbitrage bond for failing the rebate requirement";
    when bond_part_of_issue(bond, issue);
    when issue_treated_as_arbitrage_bond_148f1(issue);
    then section_103b_exception_applies(bond);
}
@source(IRC_S103_B, relation = formalizes, coverage = exact, quote = "Any bond unless such bond meets the applicable requirements of section 149.")
rule Exception103b3Section149Requirements(bond: us.irc.core::Asset) strict {
    label en official "section 103(b)(3)";
    when bond_fails_149_requirement(bond);
    then section_103b_exception_applies(bond);
}
relation bond_interest_amount(p: Individual, y: TaxableYear, bond: us.irc.core::Asset, amount: Money) kind empirical {
    label en official "interest on the bond received or accrued by the taxpayer in the year";
}
pub relation state_or_local_bond_interest_excluded_103a(p: Individual, y: TaxableYear, bond: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "interest on a State or local bond excluded from gross income under section 103(a)";
}
@source(IRC_S103_A, relation = formalizes, coverage = exact, quote = "gross income does not include interest on any State or local bond.")
rule StateOrLocalBondInterestExcluded(p: Individual, y: TaxableYear, bond: us.irc.core::Asset, amount: Money) strict {
    label en official "section 103(a), unless a (b) exception applies";
    when bond_interest_amount(p, y, bond, amount);
    when state_or_local_bond(bond);
    when not_known(section_103b_exception_applies(bond));
    then state_or_local_bond_interest_excluded_103a(p, y, bond, amount);
}

// =====================================================================
// §107: rental value of parsonages
// =====================================================================

pub relation minister_of_the_gospel(p: Individual, y: TaxableYear) kind empirical {
    label en official "the individual is a minister of the gospel in the taxable year (section 107)";
}
relation home_rental_value_furnished_as_compensation(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the rental value of a home furnished to the minister as part of his compensation (section 107(1))";
}
relation rental_allowance_paid_as_compensation(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the rental allowance paid to the minister as part of his compensation (section 107(2))";
}
relation rental_allowance_used_for_home(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the part of the allowance used to rent or provide a home (section 107(2))";
}
relation fair_rental_value_of_home_plus_utilities(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the fair rental value of the home, including furnishings and appurtenances such as a garage, plus the cost of utilities (section 107(2))";
}
pub relation parsonage_rental_value_excluded_107(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the rental value of a furnished home excluded from a minister's gross income (section 107(1))";
}
@source(IRC_S107, relation = formalizes, coverage = partial, quote = "the rental value of a home furnished to him as part of his compensation; or")
rule ParsonageRentalValueExcluded(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 107(1)";
    when minister_of_the_gospel(p, y);
    when home_rental_value_furnished_as_compensation(p, y, amount);
    then parsonage_rental_value_excluded_107(p, y, amount);
}
pub relation rental_allowance_excluded_107(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the rental allowance excluded from a minister's gross income: the least of the allowance, the amount used for a home, and fair rental value plus utilities (section 107(2))";
}
@source(IRC_S107, relation = formalizes, coverage = partial, quote = "the rental allowance paid to him as part of his compensation, to the extent used by him to rent or provide a home and to the extent such allowance does not exceed the fair rental value of the home")
rule RentalAllowanceExcluded(p: Individual, y: TaxableYear, allowance: Money, used: Money, cap: Money) strict {
    label en official "section 107(2)";
    when minister_of_the_gospel(p, y);
    when rental_allowance_paid_as_compensation(p, y, allowance);
    when rental_allowance_used_for_home(p, y, used);
    when fair_rental_value_of_home_plus_utilities(p, y, cap);
    then rental_allowance_excluded_107(p, y, min(allowance, min(used, cap)));
}

// =====================================================================
// §109 and §110: lessee improvements and construction allowances
// =====================================================================

pub relation lessor_income_from_lessee_improvements_on_termination(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "income (other than rent) derived by a lessor of real property on the termination of a lease, representing the value of buildings erected or other improvements made by the lessee (section 109)";
}
pub relation lessor_improvement_income_excluded_109(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount excluded from the lessor's gross income under section 109";
}
@source(IRC_S109, relation = formalizes, coverage = exact, quote = "Gross income does not include income (other than rent) derived by a lessor of real property on the termination of a lease, representing the value of such property attributable to buildings erected or other improvements made by the lessee.")
rule LessorImprovementIncomeExcluded(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 109";
    when lessor_income_from_lessee_improvements_on_termination(p, y, amount);
    then lessor_improvement_income_excluded_109(p, y, amount);
}

pub relation retail_space_lease(lease: us.irc.core::Transaction) kind empirical {
    label en official "the lease (or other agreement for occupancy or use) is of retail space: real property used by a lessee in its trade or business of selling tangible personal property or services to the general public (section 110(c)(3))";
}
relation lease_term_years(lease: us.irc.core::Transaction, years: Integer) kind empirical {
    label en official "the term of the lease in years, determined under the rules of section 168(i)(3) (section 110(c)(2))";
}
pub relation short_term_lease_110c2(lease: us.irc.core::Transaction) kind institutional {
    label en official "a short-term lease: a lease of retail space for 15 years or less";
}
@source(IRC_S110_C, relation = formalizes, coverage = exact, quote = "The term \"short-term lease\" means a lease (or other agreement for occupancy or use) of retail space for 15 years or less")
rule ShortTermLeaseDefined(lease: us.irc.core::Transaction, years: Integer) strict {
    label en official "section 110(c)(2); exactly 15 years qualifies";
    when retail_space_lease(lease);
    when lease_term_years(lease, years);
    when years <= 15;
    then short_term_lease_110c2(lease);
}
relation nonresidential_real_property_part_of_retail_space(prop: us.irc.core::Asset, lease: us.irc.core::Transaction) kind empirical {
    label en official "nonresidential real property which is part of, or otherwise present at, the retail space (section 110(c)(1))";
}
relation property_reverts_to_lessor_at_termination(prop: us.irc.core::Asset) kind empirical {
    label en official "the property reverts to the lessor at the termination of the lease (section 110(c)(1))";
}
pub relation qualified_long_term_real_property_110c1(prop: us.irc.core::Asset, lease: us.irc.core::Transaction) kind institutional {
    label en official "qualified long-term real property";
}
@source(IRC_S110_C, relation = formalizes, coverage = exact, quote = "The term \"qualified long-term real property\" means nonresidential real property which is part of, or otherwise present at, the retail space referred to in subsection (a) and which reverts to the lessor at the termination of the lease.")
rule QualifiedLongTermRealPropertyDefined(prop: us.irc.core::Asset, lease: us.irc.core::Transaction) strict {
    label en official "section 110(c)(1)";
    when nonresidential_real_property_part_of_retail_space(prop, lease);
    when property_reverts_to_lessor_at_termination(prop);
    then qualified_long_term_real_property_110c1(prop, lease);
}
pub relation lessee_construction_allowance_received(p: Individual, y: TaxableYear, lease: us.irc.core::Transaction, prop: us.irc.core::Asset, received: Money) kind empirical {
    label en official "an amount received in cash (or treated as a rent reduction) by a lessee from a lessor under a short-term lease of retail space, for the purpose of the lessee's constructing or improving qualified long-term real property for use in the lessee's trade or business at the retail space (section 110(a))";
}
relation lessee_expenditure_on_construction_or_improvement(p: Individual, y: TaxableYear, prop: us.irc.core::Asset, spent: Money) kind empirical {
    label en official "the amount expended by the lessee for such construction or improvement";
}
pub relation lessee_construction_allowance_excluded_110a(p: Individual, y: TaxableYear, prop: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the amount excluded from the lessee's gross income: the amount received, but only to the extent it does not exceed the amount expended";
}
@source(IRC_S110_A, relation = formalizes, coverage = exact, quote = "but only to the extent that such amount does not exceed the amount expended by the lessee for such construction or improvement.")
rule LesseeConstructionAllowanceExcluded(p: Individual, y: TaxableYear, lease: us.irc.core::Transaction, prop: us.irc.core::Asset, received: Money, spent: Money) strict {
    label en official "section 110(a): short-term lease of retail space, qualified long-term real property, exclusion capped at expenditure";
    when lessee_construction_allowance_received(p, y, lease, prop, received);
    when short_term_lease_110c2(lease);
    when qualified_long_term_real_property_110c1(prop, lease);
    when lessee_expenditure_on_construction_or_improvement(p, y, prop, spent);
    then lessee_construction_allowance_excluded_110a(p, y, prop, min(received, spent));
}
pub relation treated_as_nonresidential_real_property_of_lessor_110b(prop: us.irc.core::Asset) kind institutional {
    label en official "qualified long-term real property constructed or improved in connection with an excluded amount is treated as nonresidential real property of the lessor";
}
@source(IRC_S110_B, relation = formalizes, coverage = exact, quote = "shall be treated as nonresidential real property of the lessor")
rule ConsistentTreatmentByLessor(p: Individual, y: TaxableYear, prop: us.irc.core::Asset, amount: Money) strict {
    label en official "section 110(b)";
    when lessee_construction_allowance_excluded_110a(p, y, prop, amount);
    then treated_as_nonresidential_real_property_of_lessor_110b(prop);
}
relation lessee_or_lessor_of_110a_allowance(person: Person, lease: us.irc.core::Transaction) kind empirical {
    label en official "the person is the lessee or the lessor described in section 110(a) with respect to an excluded allowance";
}
relation information_furnished_to_secretary_110d(person: Person, lease: us.irc.core::Transaction) kind empirical {
    label en official "the person has furnished to the Secretary the information concerning the amounts received (or treated as a rent reduction) and expended, and any other information the Secretary deems necessary, at the times and in the manner provided in regulations (section 110(d))";
}
@source(IRC_S110_D, relation = formalizes, coverage = partial, quote = "the lessee and lessor described in subsection (a) shall, at such times and in such manner as may be provided in such regulations, furnish to the Secretary—")
rule Section110dFurnishInformationDutyRule strict {
    for person: Person;
    for lease: us.irc.core::Transaction;
    when lessee_or_lessor_of_110a_allowance(person, lease);
    then duty Section110dFurnishInformationDuty {
        bearer person;
        beneficiary Secretary;
        goal achievement {
            condition information_furnished_to_secretary_110d(person, lease);
            window [-infinity, infinity];
        }
    };
}

// =====================================================================
// §111: recovery of tax benefit items
// =====================================================================

pub relation recovery_of_prior_year_deduction(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the recovery during the year of an amount deducted in a prior taxable year (section 111(a))";
}
relation recovery_amount_that_reduced_prior_tax(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the part of the recovered amount whose prior deduction reduced the tax imposed by this chapter for a prior year, an increase in an unexpired carryover counting as a reduction (section 111(a), (c)); determining it requires recomputing the prior year's tax (TECH_GAP: multi-year recomputation), so it is a case fact";
}
pub relation prior_deduction_recovery_excluded_111a(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the part of the recovery excluded from gross income because the prior deduction did not reduce tax";
}
@source(IRC_S111_A, relation = formalizes, coverage = exact, quote = "to the extent such amount did not reduce the amount of tax imposed by this chapter.")
rule PriorDeductionRecoveryExcluded(p: Individual, y: TaxableYear, recovery: Money, benefited: Money) strict {
    label en official "section 111(a): the recovery minus the part that reduced tax";
    when recovery_of_prior_year_deduction(p, y, recovery);
    when recovery_amount_that_reduced_prior_tax(p, y, benefited);
    when recovery >= benefited;
    when not_known(has_carryover_increase_111c(p, y)); // G6404 wiring: §111(c) — variant below
    then prior_deduction_recovery_excluded_111a(p, y, round(recovery - benefited, 2, "HALF_UP"));
}
pub relation prior_deduction_recovery_includible_111(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the part of the recovery that remains in gross income (the part whose deduction reduced tax)";
}
@source(IRC_S111_A, relation = formalizes, coverage = partial, quote = "Gross income does not include income attributable to the recovery during the taxable year of any amount deducted in any prior taxable year")
rule PriorDeductionRecoveryIncludible(p: Individual, y: TaxableYear, recovery: Money, benefited: Money) strict {
    label en official "section 111(a) read with section 61: the benefited part is income";
    when recovery_of_prior_year_deduction(p, y, recovery);
    when recovery_amount_that_reduced_prior_tax(p, y, benefited);
    when recovery >= benefited;
    when not_known(has_carryover_increase_111c(p, y)); // G6404 wiring: §111(c) — variant below
    then prior_deduction_recovery_includible_111(p, y, benefited);
}
// G6404 wiring, §111(c): an increase in an unexpired carryover is treated as a reduction of tax, so the amount that
// reduced tax is the benefited amount plus the counted carryover increase (`carryover_increase_counted_as_tax_reduction_111c`).
// JUDGMENT CALL: the case still asserts `recovery_amount_that_reduced_prior_tax` (the reduction of the tax itself);
// the counted carryover increase is added to it.
relation has_carryover_increase_111c(p: Individual, y: TaxableYear) kind institutional {
    label en official "the recovery year has a counted increase of an unexpired carryover (section 111(c))";
}
rule HasCarryoverIncrease111c(p: Individual, y: TaxableYear, amount: Money) strict {
    when carryover_increase_counted_as_tax_reduction_111c(p, y, amount);
    then has_carryover_increase_111c(p, y);
}
@source(IRC_S111_C, relation = formalizes, coverage = exact, quote = "an increase in a carryover which has not expired before the beginning of the taxable year in which the recovery or adjustment takes place shall be treated as reducing tax imposed by this chapter.")
rule PriorDeductionRecoveryExcludedWithCarryover(p: Individual, y: TaxableYear, recovery: Money, benefited: Money, carry: Money) strict {
    label en official "section 111(a) with (c): the excluded part is what remains after the tax reduction including the carryover increase";
    when recovery_of_prior_year_deduction(p, y, recovery);
    when recovery_amount_that_reduced_prior_tax(p, y, benefited);
    when carryover_increase_counted_as_tax_reduction_111c(p, y, carry);
    when recovery >= benefited + carry;
    then prior_deduction_recovery_excluded_111a(p, y, round(recovery - (benefited + carry), 2, "HALF_UP"));
}
@source(IRC_S111_C, relation = formalizes, coverage = exact, quote = "an increase in a carryover which has not expired before the beginning of the taxable year in which the recovery or adjustment takes place shall be treated as reducing tax imposed by this chapter.")
rule PriorDeductionRecoveryIncludibleWithCarryover(p: Individual, y: TaxableYear, recovery: Money, benefited: Money, carry: Money) strict {
    label en official "section 111(a) with (c): the includible part is the tax reduction including the carryover increase, up to the recovery";
    when recovery_of_prior_year_deduction(p, y, recovery);
    when recovery_amount_that_reduced_prior_tax(p, y, benefited);
    when carryover_increase_counted_as_tax_reduction_111c(p, y, carry);
    then prior_deduction_recovery_includible_111(p, y, min(recovery, round(benefited + carry, 2, "HALF_UP")));
}
@source(IRC_S111_C, relation = formalizes, coverage = exact, quote = "an increase in a carryover which has not expired before the beginning of the taxable year in which the recovery or adjustment takes place shall be treated as reducing tax imposed by this chapter.")
rule PriorDeductionRecoveryExcludedNothingLeftWithCarryover(p: Individual, y: TaxableYear, recovery: Money, benefited: Money, carry: Money) strict {
    label en official "section 111(a) with (c): when the tax reduction including the carryover increase exceeds the recovery, nothing is excluded";
    when recovery_of_prior_year_deduction(p, y, recovery);
    when recovery_amount_that_reduced_prior_tax(p, y, benefited);
    when carryover_increase_counted_as_tax_reduction_111c(p, y, carry);
    when recovery < benefited + carry;
    then prior_deduction_recovery_excluded_111a(p, y, 0.00 USD);
}
relation credit_allowed_in_prior_year_for_amount(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the credit allowable for a prior taxable year with respect to an amount that is the subject of a downward price adjustment or similar adjustment in the year (section 111(b)(1))";
}
relation credit_that_reduced_tax(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the part of that credit which reduced the tax imposed by this chapter (section 111(b)(2))";
}
relation credit_is_section_46_or_foreign_tax_credit(p: Individual, y: TaxableYear) kind empirical {
    label en official "the credit is the credit determined under section 46 or the foreign tax credit (section 111(b)(3))";
}
pub relation tax_increase_for_credit_recovery_111b(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the increase in the year's tax by the amount of the credit attributable to a downward price adjustment or similar adjustment, limited to the credit that reduced tax";
}
@source(IRC_S111_B, relation = formalizes, coverage = exact, quote = "the tax imposed by this chapter for the taxable year shall be increased by the amount of the credit attributable to the adjustment.")
rule TaxIncreasedForCreditRecovery(p: Individual, y: TaxableYear, credit: Money, benefited: Money) strict {
    label en official "section 111(b)(1)-(3): not for the section 46 or foreign tax credit; only to the extent the credit reduced tax";
    when credit_allowed_in_prior_year_for_amount(p, y, credit);
    when credit_that_reduced_tax(p, y, benefited);
    when not_known(credit_is_section_46_or_foreign_tax_credit(p, y));
    then tax_increase_for_credit_recovery_111b(p, y, min(credit, benefited));
}

// =====================================================================
// §112: combat zone compensation
// =====================================================================

pub relation month_compensation(p: Individual, month_start: Date, amount: Money) kind empirical {
    label en official "compensation received for active service in the Armed Forces for the month beginning on the date (section 112(a)-(b)); \"compensation\" does not include pensions and retirement pay (section 112(c)(4))";
}
relation serves_as_enlisted_member(p: Individual, month_start: Date) kind empirical {
    label en official "the member serves below the grade of commissioned officer (a commissioned warrant officer is not a commissioned officer, section 112(c)(1))";
}
relation serves_as_commissioned_officer(p: Individual, month_start: Date) kind empirical {
    label en official "the member is a commissioned officer, not a commissioned warrant officer (section 112(c)(1))";
}
relation served_in_combat_zone_during_month(p: Individual, month_start: Date) kind empirical {
    label en official "the member served in a combat zone during any part of the month; service is in a combat zone only if performed between the dates designated by Executive Order for the commencing and the termination of combatant activities there (section 112(c)(2)-(3))";
}
relation hospitalized_from_combat_zone_service_during_month(p: Individual, month_start: Date) kind empirical {
    label en official "the member was hospitalized during any part of the month as a result of wounds, disease, or injury incurred while serving in a combat zone (section 112(a)(2))";
}
relation combat_zone_termination_date(p: Individual, month_start: Date, terminated: Date) kind empirical {
    label en official "the date of termination of combatant activities in the relevant combat zone";
}
relation month_in_vietnam_zone_after_january_1978(p: Individual, month_start: Date) kind empirical {
    label en official "the relevant combat zone is the one designated for the Vietnam conflict and the month is after January 1978 (section 112(a), last sentence)";
}
relation month_qualifies_for_112_exclusion(p: Individual, month_start: Date) kind institutional {
    label en official "the month is one for which the combat-zone exclusion is available: service in the zone, or hospitalization within 2 years after the termination of combatant activities (and, for Vietnam, not after January 1978)";
}
@source(IRC_S112_A, relation = formalizes, coverage = partial, quote = "(1) served in a combat zone, or")
rule MonthQualifiesByServiceInCombatZone(p: Individual, month_start: Date) strict {
    label en official "section 112(a)(1)/(b)(1)";
    when served_in_combat_zone_during_month(p, month_start);
    then month_qualifies_for_112_exclusion(p, month_start);
}
@source(IRC_S112_A, relation = formalizes, coverage = partial, quote = "but this paragraph shall not apply for any month beginning more than 2 years after the date of the termination of combatant activities in such zone.")
rule MonthQualifiesByHospitalization(p: Individual, month_start: Date, terminated: Date) strict {
    label en official "section 112(a)(2)/(b)(2): the month must not begin more than 2 years after the termination date; Vietnam months after January 1978 are excluded";
    when hospitalized_from_combat_zone_service_during_month(p, month_start);
    when combat_zone_termination_date(p, month_start, terminated);
    when month_start <= add_calendar_period(terminated, 2 calendar_year);
    when not_known(month_in_vietnam_zone_after_january_1978(p, month_start));
    then month_qualifies_for_112_exclusion(p, month_start);
}
pub relation combat_zone_pay_excluded_enlisted_112a(p: Individual, month_start: Date, amount: Money) kind institutional {
    label en official "compensation of an enlisted member excluded for a qualifying month";
}
@source(IRC_S112_A, relation = formalizes, coverage = exact, quote = "Gross income does not include compensation received for active service as a member below the grade of commissioned officer in the Armed Forces of the United States for any month during any part of which such member—")
rule EnlistedCombatZonePayExcluded(p: Individual, month_start: Date, amount: Money) strict {
    label en official "section 112(a)";
    when month_compensation(p, month_start, amount);
    when serves_as_enlisted_member(p, month_start);
    when month_qualifies_for_112_exclusion(p, month_start);
    then combat_zone_pay_excluded_enlisted_112a(p, month_start, amount);
}
relation highest_enlisted_basic_pay_for_month(month_start: Date, amount: Money) kind empirical {
    label en official "the highest rate of basic pay payable for the month to any enlisted member at the highest pay grade applicable to enlisted members (section 112(c)(5)(A))";
}
relation special_pay_37usc_for_month(p: Individual, month_start: Date, amount: Money) kind empirical {
    label en official "special pay payable to the officer for the month under section 310 or section 351(a)(1) or (3) of title 37 (section 112(c)(5)(B))";
}
pub relation maximum_enlisted_amount_112c5(p: Individual, month_start: Date, amount: Money) kind institutional {
    label en official "the maximum enlisted amount for the month";
}
@source(IRC_S112_C, relation = formalizes, coverage = exact, quote = "The term \"maximum enlisted amount\" means, for any month, the sum of—")
rule MaximumEnlistedAmountComputed(p: Individual, month_start: Date, basic: Money, special: Money) strict {
    label en official "section 112(c)(5)";
    when highest_enlisted_basic_pay_for_month(month_start, basic);
    when special_pay_37usc_for_month(p, month_start, special);
    then maximum_enlisted_amount_112c5(p, month_start, round(basic + special, 2, "HALF_UP"));
}
pub relation combat_zone_pay_excluded_officer_112b(p: Individual, month_start: Date, amount: Money) kind institutional {
    label en official "compensation of a commissioned officer excluded for a qualifying month: so much as does not exceed the maximum enlisted amount";
}
@source(IRC_S112_B, relation = formalizes, coverage = exact, quote = "Gross income does not include so much of the compensation as does not exceed the maximum enlisted amount received for active service as a commissioned officer")
rule OfficerCombatZonePayExcluded(p: Individual, month_start: Date, amount: Money, cap: Money) strict {
    label en official "section 112(b)";
    when month_compensation(p, month_start, amount);
    when serves_as_commissioned_officer(p, month_start);
    when month_qualifies_for_112_exclusion(p, month_start);
    when maximum_enlisted_amount_112c5(p, month_start, cap);
    then combat_zone_pay_excluded_officer_112b(p, month_start, min(amount, cap));
}
relation in_missing_status_during_vietnam_conflict_month(p: Individual, month_start: Date) kind empirical {
    label en official "the individual is in a missing status (37 U.S.C. 551(2) for members, 5 U.S.C. 5561 for civilians) as a result of the Vietnam conflict during part of the month, other than a period officially determined to be absence without authority (section 112(d)(1)-(3))";
}
relation officially_determined_absent_without_authority(p: Individual, month_start: Date) kind empirical {
    label en official "it is officially determined under 37 U.S.C. 552(c) that the member is officially absent from his post of duty without authority";
}
pub relation missing_status_compensation_excluded_112d(p: Individual, month_start: Date, amount: Money) kind institutional {
    label en official "compensation for active service for a month in a missing status during the Vietnam conflict excluded";
}
@source(IRC_S112_D, relation = formalizes, coverage = partial, quote = "Gross income does not include compensation received for active service as a member of the Armed Forces of the United States for any month during any part of which such member is in a missing status")
rule MissingStatusCompensationExcluded(p: Individual, month_start: Date, amount: Money) strict {
    label en official "section 112(d)(1)-(2); the war-period start date of February 28, 1961 is asserted through the missing-status fact";
    when month_compensation(p, month_start, amount);
    when in_missing_status_during_vietnam_conflict_month(p, month_start);
    when not_known(officially_determined_absent_without_authority(p, month_start));
    then missing_status_compensation_excluded_112d(p, month_start, amount);
}

// =====================================================================
// §115: income of States, municipalities
// =====================================================================

pub relation income_of_public_utility_or_essential_governmental_function(recipient: us.irc.core::Organ, y: TaxableYear, amount: Money) kind empirical {
    label en official "income derived from any public utility or the exercise of any essential governmental function and accruing to a State, a political subdivision thereof, or the District of Columbia (section 115(1)); whether a function is essential governmental is left to the case";
}
pub relation income_accruing_to_possession_government(recipient: us.irc.core::Organ, y: TaxableYear, amount: Money) kind empirical {
    label en official "income accruing to the government of a possession of the United States, or a political subdivision thereof (section 115(2))";
}
pub relation government_income_excluded_115(recipient: us.irc.core::Organ, y: TaxableYear, amount: Money) kind institutional {
    label en official "the income excluded from gross income under section 115";
}
@source(IRC_S115, relation = formalizes, coverage = partial, quote = "income derived from any public utility or the exercise of any essential governmental function and accruing to a State or any political subdivision thereof, or the District of Columbia; or")
rule PublicUtilityOrGovernmentalFunctionIncomeExcluded(recipient: us.irc.core::Organ, y: TaxableYear, amount: Money) strict {
    label en official "section 115(1)";
    when income_of_public_utility_or_essential_governmental_function(recipient, y, amount);
    then government_income_excluded_115(recipient, y, amount);
}
@source(IRC_S115, relation = formalizes, coverage = partial, quote = "income accruing to the government of any possession of the United States, or any political subdivision thereof.")
rule PossessionGovernmentIncomeExcluded(recipient: us.irc.core::Organ, y: TaxableYear, amount: Money) strict {
    label en official "section 115(2)";
    when income_accruing_to_possession_government(recipient, y, amount);
    then government_income_excluded_115(recipient, y, amount);
}

// =====================================================================
// §118: contributions to the capital of a corporation
// =====================================================================

pub relation contribution_to_corporation(corp: Person, y: TaxableYear, contribution: us.irc.core::Transaction, amount: Money) kind empirical {
    label en official "money or other property received by a corporation as a contribution, of the given amount (section 118(a))";
}
relation contribution_in_aid_of_construction_or_as_customer(contribution: us.irc.core::Transaction) kind empirical {
    label en official "the contribution is a contribution in aid of construction or any other contribution as a customer or potential customer (section 118(b)(1))";
}
relation contribution_by_governmental_entity_or_civic_group(contribution: us.irc.core::Transaction) kind empirical {
    label en official "the contribution is made by a governmental entity or civic group (section 118(b)(2))";
}
relation contribution_made_by_shareholder_as_such(contribution: us.irc.core::Transaction) kind empirical {
    label en official "the contribution is made by a shareholder as such (section 118(b)(2), parenthetical)";
}
relation utility_special_rule_118c_applies(contribution: us.irc.core::Transaction) kind institutional {
    label en official "helper: the contribution is brought back inside \"contribution to the capital\" by the section 118(c) water and sewerage disposal utility rules";
}
relation contribution_excepted_118b(contribution: us.irc.core::Transaction) kind institutional {
    label en official "helper: the contribution is outside \"contribution to the capital of the taxpayer\" under section 118(b)";
}
@source(IRC_S118_B, relation = formalizes, coverage = exact, quote = "(1) any contribution in aid of construction or any other contribution as a customer or potential customer, and")
rule ContributionExceptedCustomer(contribution: us.irc.core::Transaction) strict {
    label en official "section 118(b)(1), except as provided in subsection (c)";
    when contribution_in_aid_of_construction_or_as_customer(contribution);
    when not_known(utility_special_rule_118c_applies(contribution));
    then contribution_excepted_118b(contribution);
}
@source(IRC_S118_B, relation = formalizes, coverage = exact, quote = "(2) any contribution by any governmental entity or civic group (other than a contribution made by a shareholder as such).")
rule ContributionExceptedGovernmentOrCivicGroup(contribution: us.irc.core::Transaction) strict {
    label en official "section 118(b)(2), except as provided in subsection (c) and except a shareholder's contribution as such";
    when contribution_by_governmental_entity_or_civic_group(contribution);
    when not_known(contribution_made_by_shareholder_as_such(contribution));
    when not_known(utility_special_rule_118c_applies(contribution));
    then contribution_excepted_118b(contribution);
}
pub relation contribution_to_capital_excluded_118a(corp: Person, y: TaxableYear, contribution: us.irc.core::Transaction, amount: Money) kind institutional {
    label en official "the contribution to the capital of the corporation excluded from gross income under section 118(a) (capital contribution: not excepted by (b), or included by (c))";
}
@source(IRC_S118_A, relation = formalizes, coverage = exact, quote = "In the case of a corporation, gross income does not include any contribution to the capital of the taxpayer.")
rule ContributionToCapitalExcluded(corp: Person, y: TaxableYear, contribution: us.irc.core::Transaction, amount: Money) strict {
    label en official "section 118(a): an ordinary capital contribution not excepted by (b)";
    when contribution_to_corporation(corp, y, contribution, amount);
    when not_known(contribution_excepted_118b(contribution));
    then contribution_to_capital_excluded_118a(corp, y, contribution, amount);
}

// (c): water and sewerage disposal utilities
relation regulated_public_utility_providing_water_or_sewerage(corp: Person) kind empirical {
    label en official "a regulated public utility (section 7701(a)(33)) which provides water or sewerage disposal services and is required to provide them to members of the general public in its service area (section 118(c)(1), (c)(3)(C))";
}
relation contribution_in_aid_of_construction_118c(contribution: us.irc.core::Transaction) kind empirical {
    label en official "the amount is a contribution in aid of construction as defined by regulations (excluding service charges for starting or stopping services) (section 118(c)(1)(A)(i), (3)(A))";
}
relation contribution_by_governmental_entity_for_water_protection(contribution: us.irc.core::Transaction) kind empirical {
    label en official "the amount is a contribution to the capital of the utility by a governmental entity providing for the protection, preservation, or enhancement of drinking water or sewerage disposal services (section 118(c)(1)(A)(ii))";
}
relation contribution_is_water_or_sewerage_facilities(contribution: us.irc.core::Transaction) kind empirical {
    label en official "the contribution is water or sewerage disposal facilities themselves (exempt from the expenditure rule, section 118(c)(1)(B))";
}
relation contribution_or_acquired_property_in_rate_base(contribution: us.irc.core::Transaction) kind empirical {
    label en official "the amount (or property acquired or constructed with it) is included in the taxpayer's rate base for ratemaking purposes (section 118(c)(1)(C))";
}
relation contribution_received_in_year(contribution: us.irc.core::Transaction, received_year: Integer) kind empirical {
    label en official "the calendar year in which the amount was received";
}
relation expenditure_on_1231b_property_for_contribution(contribution: us.irc.core::Transaction, spent: Money, year: Integer, predominant_water_use_percent: Integer) kind empirical {
    label en official "an amount expended for acquisition or construction of tangible property described in section 1231(b) that is the contribution's property or of the same type, in the calendar year, used predominantly (percent of use) in furnishing water or sewerage disposal services (section 118(c)(2)(A))";
}
relation records_kept_for_contribution(contribution: us.irc.core::Transaction) kind empirical {
    label en official "accurate records are kept of the amounts contributed and expenditures made, the expenditures to which contributions are allocated, and the years received and made (section 118(c)(2)(C))";
}
relation contribution_amount_118c(contribution: us.irc.core::Transaction, amount: Money) kind empirical {
    label en official "the amount of the contribution";
}
pub relation expenditure_rule_met_118c2(contribution: us.irc.core::Transaction) kind institutional {
    label en official "the expenditure rule of section 118(c)(2): an equal amount expended on qualifying property used 80 percent or more in the water/sewerage business, before the end of the second taxable year after the receipt year, with accurate records";
}
@source(IRC_S118_C, relation = formalizes, coverage = exact, quote = "(B) the expenditure referred to in subparagraph (A) occurs before the end of the second taxable year after the year in which such amount was received, and")
rule ExpenditureRuleMet(contribution: us.irc.core::Transaction, amount: Money, spent: Money, spent_year: Integer, percent: Integer, received_year: Integer) strict {
    label en official "section 118(c)(2)(A)-(C), (c)(3)(B): expended amount not below the contribution, in the receipt year or the following two years, predominantly (80 percent or more) used, records kept; a calendar taxable year is assumed for the year arithmetic";
    when contribution_amount_118c(contribution, amount);
    when contribution_received_in_year(contribution, received_year);
    when expenditure_on_1231b_property_for_contribution(contribution, spent, spent_year, percent);
    when records_kept_for_contribution(contribution);
    when spent >= amount;
    when spent_year >= received_year;
    when spent_year <= received_year + 2;
    when percent >= 80;
    then expenditure_rule_met_118c2(contribution);
}
@source(IRC_S118_C, relation = formalizes, coverage = exact, quote = "the term \"contribution to the capital of the taxpayer\" includes any amount of money or other property received from any person (whether or not a shareholder) by a regulated public utility which provides water or sewerage disposal services if—")
rule UtilityContributionInAidOfConstructionIsCapital(corp: Person, contribution: us.irc.core::Transaction) strict {
    label en official "section 118(c)(1)(A)(i), (B), (C): a contribution in aid of construction; if it is not water or sewerage facilities the expenditure rule must be met; not in the rate base";
    when regulated_public_utility_providing_water_or_sewerage(corp);
    when contribution_in_aid_of_construction_118c(contribution);
    when expenditure_rule_met_118c2(contribution);
    when not_known(contribution_or_acquired_property_in_rate_base(contribution));
    then utility_special_rule_118c_applies(contribution);
}
rule UtilityContributionOfFacilitiesIsCapital(corp: Person, contribution: us.irc.core::Transaction) strict {
    label en official "section 118(c)(1)(B): contributions of water or sewerage disposal facilities need not meet the expenditure rule";
    when regulated_public_utility_providing_water_or_sewerage(corp);
    when contribution_in_aid_of_construction_118c(contribution);
    when contribution_is_water_or_sewerage_facilities(contribution);
    when not_known(contribution_or_acquired_property_in_rate_base(contribution));
    then utility_special_rule_118c_applies(contribution);
}
rule UtilityGovernmentContributionIsCapital(corp: Person, contribution: us.irc.core::Transaction) strict {
    label en official "section 118(c)(1)(A)(ii)";
    when regulated_public_utility_providing_water_or_sewerage(corp);
    when contribution_by_governmental_entity_for_water_protection(contribution);
    when not_known(contribution_or_acquired_property_in_rate_base(contribution));
    then utility_special_rule_118c_applies(contribution);
}
pub relation utility_contribution_excluded_118c(corp: Person, y: TaxableYear, contribution: us.irc.core::Transaction, amount: Money) kind institutional {
    label en official "the contribution to a water or sewerage disposal utility that section 118(c) treats as a contribution to capital, and so excluded";
}
rule UtilityContributionExcluded(corp: Person, y: TaxableYear, contribution: us.irc.core::Transaction, amount: Money) strict {
    label en official "section 118(c)(1) with (a)";
    when contribution_to_corporation(corp, y, contribution, amount);
    when utility_special_rule_118c_applies(contribution);
    then utility_contribution_excluded_118c(corp, y, contribution, amount);
}
pub relation deduction_or_credit_denied_for_contribution_expenditure_118c4(corp: Person, contribution: us.irc.core::Transaction) kind institutional {
    label en official "no deduction or credit is allowed for, or by reason of, an expenditure that constitutes a contribution in aid of construction to which section 118(c) applies";
}
@source(IRC_S118_C, relation = formalizes, coverage = exact, quote = "no deduction or credit shall be allowed for, or by reason of, any expenditure which constitutes a contribution in aid of construction to which this subsection applies.")
rule DeductionOrCreditDeniedForContributionInAidOfConstruction(corp: Person, y: TaxableYear, contribution: us.irc.core::Transaction, amount: Money) strict {
    label en official "section 118(c)(4), first sentence";
    when utility_contribution_excluded_118c(corp, y, contribution, amount);
    when contribution_in_aid_of_construction_118c(contribution);
    then deduction_or_credit_denied_for_contribution_expenditure_118c4(corp, contribution);
}
pub relation adjusted_basis_of_property_acquired_with_contribution_118c4(corp: Person, contribution: us.irc.core::Transaction, amount: Money) kind institutional {
    label en official "the adjusted basis of property acquired with contributions in aid of construction to which section 118(c) applies is zero";
}
@source(IRC_S118_C, relation = formalizes, coverage = exact, quote = "The adjusted basis of any property acquired with contributions in aid of construction to which this subsection applies shall be zero.")
rule ZeroBasisForPropertyAcquiredWithContribution(corp: Person, y: TaxableYear, contribution: us.irc.core::Transaction, amount: Money) strict {
    label en official "section 118(c)(4), second sentence";
    when utility_contribution_excluded_118c(corp, y, contribution, amount);
    when contribution_in_aid_of_construction_118c(contribution);
    then adjusted_basis_of_property_acquired_with_contribution_118c4(corp, contribution, 0.00 USD);
}
// (d): statute of limitations
relation taxpayer_treated_amount_as_capital_contribution_118c1Ai(corp: Person, contribution: us.irc.core::Transaction) kind empirical {
    label en official "the taxpayer treats the amount as a contribution to capital described in section 118(c)(1)(A)(i) (a contribution in aid of construction)";
}
relation secretary_notified_of_expenditure_or_intention_or_failure(corp: Person, contribution: us.irc.core::Transaction, notified_on: Date) kind empirical {
    label en official "the Secretary is notified by the taxpayer, in the prescribed manner, of the amount of the expenditure, the taxpayer's intention not to make the expenditures, or a failure to make the expenditure within the (c)(2)(B) period (section 118(d)(1)(A)-(C))";
}
pub relation assessment_period_not_expiring_before_118d(corp: Person, contribution: us.irc.core::Transaction, date: Date) kind institutional {
    label en official "the statutory period for assessment of any deficiency attributable to the contribution does not expire before the date, 3 years after the Secretary's notification; the deficiency may be assessed before that date notwithstanding any other law";
}
@source(IRC_S118_D, relation = formalizes, coverage = exact, quote = "the statutory period for the assessment of any deficiency attributable to any part of such amount shall not expire before the expiration of 3 years from the date the Secretary is notified by the taxpayer")
rule AssessmentPeriodExtendedAfterNotification(corp: Person, contribution: us.irc.core::Transaction, notified: Date) strict {
    label en official "section 118(d)(1)-(2); the 3 years are counted with a calendar-year step";
    when taxpayer_treated_amount_as_capital_contribution_118c1Ai(corp, contribution);
    when secretary_notified_of_expenditure_or_intention_or_failure(corp, contribution, notified);
    then assessment_period_not_expiring_before_118d(corp, contribution, add_calendar_period(notified, 3 calendar_year));
}

// =====================================================================
// §122: certain reduced uniformed services retirement pay
// =====================================================================

pub relation member_or_former_member_of_uniformed_services(p: Individual) kind empirical {
    label en official "a member or former member of the uniformed services of the United States (section 122(a))";
}
relation reduction_in_retired_pay_under_chapter_73(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of any reduction in retired or retainer pay pursuant to chapter 73 of title 10, United States Code";
}
pub relation retired_pay_reduction_excluded_122a(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the reduction in retired pay excluded from gross income";
}
@source(IRC_S122_A, relation = formalizes, coverage = exact, quote = "gross income does not include the amount of any reduction in his retired or retainer pay pursuant to the provisions of chapter 73 of title 10, United States Code.")
rule RetiredPayReductionExcluded(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 122(a)";
    when member_or_former_member_of_uniformed_services(p);
    when reduction_in_retired_pay_under_chapter_73(p, y, amount);
    then retired_pay_reduction_excluded_122a(p, y, amount);
}
relation reductions_before_1966(p: Individual, amount: Money) kind empirical {
    label en official "the total amount of the reductions before January 1, 1966, in retired or retainer pay by reason of an election under chapter 73 of title 10 (section 122(b)(2)(A))";
}
relation deposits_under_title_10_1438_or_1452d(p: Individual, amount: Money) kind empirical {
    label en official "amounts deposited at any time pursuant to section 1438 or 1452(d) of title 10 (section 122(b)(2)(B))";
}
pub relation consideration_for_the_contract_122b2(p: Individual, amount: Money) kind institutional {
    label en official "the consideration for the contract: pre-1966 reductions plus deposits";
}
@source(IRC_S122_B, relation = formalizes, coverage = exact, quote = "the term \"consideration for the contract\" means, in respect of any individual, the sum of—")
rule ConsiderationForTheContractComputed(p: Individual, before_1966: Money, deposits: Money) strict {
    label en official "section 122(b)(2)";
    when reductions_before_1966(p, before_1966);
    when deposits_under_title_10_1438_or_1452d(p, deposits);
    then consideration_for_the_contract_122b2(p, round(before_1966 + deposits, 2, "HALF_UP"));
}
relation retired_pay_received(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "retired or retainer pay received in the year that would, but for section 122(b)(1), be includible in gross income";
}
relation retired_pay_previously_excluded_122b(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "amounts already excluded under section 122(b)(1) in earlier years";
}
pub relation retired_pay_excluded_122b1(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "retired pay excluded until the consideration for the contract has been excluded";
}
@source(IRC_S122_B, relation = formalizes, coverage = exact, quote = "all amounts received as retired or retainer pay shall be excluded from gross income until there has been so excluded an amount equal to the consideration for the contract.")
rule RetiredPayExcludedUntilConsiderationRecovered(p: Individual, y: TaxableYear, received: Money, prior: Money, consideration: Money) strict {
    label en official "section 122(b)(1): min(received, consideration - previously excluded), never below zero";
    when member_or_former_member_of_uniformed_services(p);
    when retired_pay_received(p, y, received);
    when retired_pay_previously_excluded_122b(p, y, prior);
    when consideration_for_the_contract_122b2(p, consideration);
    then retired_pay_excluded_122b1(p, y, min(received, max(0.00 USD, round(consideration - prior, 2, "HALF_UP"))));
}

// =====================================================================
// §123: insurance for living expenses after a casualty
// =====================================================================

relation principal_residence_damaged_or_access_denied(p: Individual, y: TaxableYear) kind empirical {
    label en official "the individual's principal residence is damaged or destroyed by fire, storm, or other casualty, or the individual is denied access to it by governmental authorities because of the occurrence or threat of such a casualty (section 123(a))";
}
relation living_expense_insurance_received(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "amounts received under an insurance contract to compensate or reimburse living expenses incurred for himself and members of his household resulting from the loss of use or occupancy of the residence";
}
relation actual_living_expenses_incurred(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the actual living expenses incurred during the period for the individual and household resulting from the loss of use or occupancy (section 123(b)(1))";
}
relation normal_living_expenses(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the normal living expenses which would have been incurred during the period (section 123(b)(2))";
}
pub relation living_expense_insurance_excluded_123(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the insurance amounts excluded from gross income: not more than actual living expenses in excess of normal living expenses";
}
@source(IRC_S123_B, relation = formalizes, coverage = exact, quote = "only to the extent the amounts received do not exceed the amount by which—")
rule LivingExpenseInsuranceExcluded(p: Individual, y: TaxableYear, received: Money, actual: Money, normal: Money) strict {
    label en official "section 123(a)-(b): min(received, max(0, actual - normal))";
    when principal_residence_damaged_or_access_denied(p, y);
    when living_expense_insurance_received(p, y, received);
    when actual_living_expenses_incurred(p, y, actual);
    when normal_living_expenses(p, y, normal);
    then living_expense_insurance_excluded_123(p, y, min(received, max(0.00 USD, round(actual - normal, 2, "HALF_UP"))));
}

// =====================================================================
// §126: certain cost-sharing payments
// =====================================================================

pub enum ConservationProgram126 {
    RuralCleanWater;              // (a)(1)
    RuralAbandonedMine;           // (a)(2)
    WaterBank;                    // (a)(3)
    EmergencyConservationMeasures; // (a)(4)
    AgriculturalConservation;     // (a)(5)
    ResourceConservationDevelopment; // (a)(6)
    SmallWatershed;               // (a)(7)
    StateOrLocalConservation;     // (a)(8)
}
pub relation cost_sharing_payment(p: Individual, y: TaxableYear, program: ConservationProgram126, amount: Money) kind empirical {
    label en official "a payment received by the taxpayer under a program described in section 126(a)(1)-(8), and the program";
}
external judgment relation determined_by_secretary_of_agriculture_primary_purpose(p: Individual, y: TaxableYear, program: ConservationProgram126) {
    authority Secretary;
    label en official "the Secretary of Agriculture determines the payment to be made primarily for the purpose of conserving soil and water resources, protecting or restoring the environment, improving forests, or providing a habitat for wildlife (section 126(b)(1)(A)); the authority is the Secretary of Agriculture, whom this vocabulary does not name, so the Secretary constant stands for the executive determination and the coverage row notes it";
}
external judgment relation determined_by_secretary_of_treasury_not_increasing_income(p: Individual, y: TaxableYear, program: ConservationProgram126) {
    authority Secretary;
    label en official "the Secretary of the Treasury or his delegate determines that the payment does not increase substantially the annual income derived from the property (section 126(b)(1)(B))";
}
relation payment_portion_associated_with_deductible_amount(p: Individual, y: TaxableYear, program: ConservationProgram126, amount: Money) kind empirical {
    label en official "the portion of the payment properly associated with an amount allowable as a deduction for the year in which it is paid or incurred (section 126(b)(2)), which is not excludable";
}
relation section_126_election_out(p: Individual, y: TaxableYear) kind empirical {
    label en official "the taxpayer elects not to have section 126 (and section 1255) apply to the excludable portion (section 126(c)(1))";
}
relation election_made_on_126c(p: Individual, y: TaxableYear, made_on: Date) kind empirical {
    label en official "the date on which the section 126(c) election is made";
}
relation return_due_date_including_extensions(p: Individual, y: TaxableYear, due: Date) kind empirical {
    label en official "the due date prescribed by law (including extensions) for filing the return for the taxable year in which the payment was received or accrued (section 126(c)(2))";
}
relation election_126c_timely(p: Individual, y: TaxableYear) kind institutional {
    label en official "helper for valid_when: the election is made not later than the due date (with extensions) of the return for the year of receipt";
}
rule Election126cTimelinessComputed(p: Individual, y: TaxableYear, made_on: Date, due: Date) strict {
    label en official "section 126(c)(2)";
    when election_made_on_126c(p, y, made_on);
    when return_due_date_including_extensions(p, y, due);
    when made_on <= due;
    then election_126c_timely(p, y);
}
pub relation section_126_does_not_apply_by_election(p: Individual, y: TaxableYear) kind institutional {
    label en official "the effect of a valid section 126(c) election: section 126 (and section 1255) does not apply to the excludable portion";
}
@source(IRC_S126_C, relation = formalizes, coverage = exact, quote = "The taxpayer may elect not to have this section (and section 1255) apply to any excludable portion (or portion thereof).")
rule Section126cElectionPowerRule(p: Individual, y: TaxableYear, made_on: Date) strict {
    label en official "section 126(c): the taxpayer's election out is a power; an untimely exercise has no effect (E-0239)";
    when election_made_on_126c(p, y, made_on);
    then power Section126cElectOut {
        holder p;
        over y;
        exercise election_made_on_126c(p, y, made_on);
        valid_when election_126c_timely(p, y);
        effect create(section_126_does_not_apply_by_election(p, y));
        window [-infinity, infinity];
    };
}
pub relation cost_sharing_payment_excludable_portion_126b(p: Individual, y: TaxableYear, program: ConservationProgram126, amount: Money) kind institutional {
    label en official "the excludable portion of a payment: all of it when both determinations are made, less the portion associated with a deductible amount";
}
@source(IRC_S126_B, relation = formalizes, coverage = exact, quote = "The term \"excludable portion\" means that portion (or all) of a payment made to any person under any program described in subsection (a) which—")
rule ExcludablePortionComputed(p: Individual, y: TaxableYear, program: ConservationProgram126, amount: Money, deductible_part: Money) strict {
    label en official "section 126(b)(1)-(2)";
    when cost_sharing_payment(p, y, program, amount);
    when determined_by_secretary_of_agriculture_primary_purpose(p, y, program);
    when determined_by_secretary_of_treasury_not_increasing_income(p, y, program);
    when payment_portion_associated_with_deductible_amount(p, y, program, deductible_part);
    when amount >= deductible_part;
    then cost_sharing_payment_excludable_portion_126b(p, y, program, round(amount - deductible_part, 2, "HALF_UP"));
}
pub relation cost_sharing_payment_excluded_126a(p: Individual, y: TaxableYear, program: ConservationProgram126, amount: Money) kind institutional {
    label en official "the excludable portion of the payment excluded from gross income, unless the taxpayer validly elected out";
}
@source(IRC_S126_A, relation = formalizes, coverage = exact, quote = "Gross income does not include the excludable portion of payments received under—")
rule CostSharingPaymentExcluded defeasible {
    for p: Individual;
    for y: TaxableYear;
    for program: ConservationProgram126;
    for amount: Money;
    when cost_sharing_payment_excludable_portion_126b(p, y, program, amount);
    then cost_sharing_payment_excluded_126a(p, y, program, amount);
    unless section_126_does_not_apply_by_election(p, y)
        and cost_sharing_payment_excludable_portion_126b(p, y, program, amount);
}
pub relation deduction_or_credit_denied_double_benefit_126d(p: Individual, y: TaxableYear, program: ConservationProgram126) kind institutional {
    label en official "no deduction or credit is allowed for an expenditure properly associated with an amount excluded under section 126(a)";
}
@source(IRC_S126_D, relation = formalizes, coverage = exact, quote = "No deduction or credit shall be allowed with respect to any expenditure which is properly associated with any amount excluded from gross income under subsection (a).")
rule DoubleBenefitDenied126d defeasible {
    for p: Individual;
    for y: TaxableYear;
    for program: ConservationProgram126;
    for amount: Money;
    when cost_sharing_payment_excluded_126a(p, y, program, amount);
    then deduction_or_credit_denied_double_benefit_126d(p, y, program);
}
pub relation no_basis_adjustment_for_excluded_payment_126e(p: Individual, y: TaxableYear, program: ConservationProgram126, amount: Money) kind institutional {
    label en official "no adjustment to basis is made for property acquired or improved with an excluded payment, to the extent it reflects the excluded amount";
}
@source(IRC_S126_E, relation = formalizes, coverage = exact, quote = "no adjustment to basis shall be made with respect to property acquired or improved through the use of any payment, to the extent that such adjustment would reflect any amount which is excluded from gross income under subsection (a).")
rule NoBasisIncreaseForExcludedPayment126e defeasible {
    for p: Individual;
    for y: TaxableYear;
    for program: ConservationProgram126;
    for amount: Money;
    when cost_sharing_payment_excluded_126a(p, y, program, amount);
    then no_basis_adjustment_for_excluded_payment_126e(p, y, program, amount);
}

// =====================================================================
// §130: certain personal injury liability assignments
// =====================================================================

pub entity LiabilityAssignment {
    label en unofficial "an assignment of a liability to make periodic payments as damages or workmen's compensation on account of personal injury or sickness (section 130(c)); case-asserted";
}
relation assignment_on_account_of_physical_injury_or_sickness(assignment: LiabilityAssignment) kind empirical {
    label en official "the assigned liability is to make periodic payments as damages (by suit or agreement) or workmen's compensation on account of personal injury or sickness in a case involving physical injury or physical sickness (section 130(c))";
}
relation assignee_assumes_liability_from_party(assignment: LiabilityAssignment) kind empirical {
    label en official "the assignee assumes the liability from a party to the suit or agreement, or the workmen's compensation claim (section 130(c)(1))";
}
relation periodic_payments_fixed_and_determinable(assignment: LiabilityAssignment) kind empirical {
    label en official "the periodic payments are fixed and determinable as to amount and time of payment (section 130(c)(2)(A))";
}
relation periodic_payments_not_alterable_by_recipient(assignment: LiabilityAssignment) kind empirical {
    label en official "the payments cannot be accelerated, deferred, increased, or decreased by the recipient (section 130(c)(2)(B))";
}
relation assignee_obligation_no_greater(assignment: LiabilityAssignment) kind empirical {
    label en official "the assignee's obligation is no greater than the obligation of the person who assigned the liability (section 130(c)(2)(C))";
}
relation payments_excludable_under_104a1_or_2(assignment: LiabilityAssignment) kind empirical {
    label en official "the periodic payments are excludable from the recipient's gross income under section 104(a)(1) or (2) (section 130(c)(2)(D)); this package's section 104 module derives it, the case links it";
}
pub relation qualified_assignment_130c(assignment: LiabilityAssignment) kind institutional {
    label en official "a qualified assignment";
}
@source(IRC_S130_C, relation = formalizes, coverage = exact, quote = "For purposes of this section, the term \"qualified assignment\" means any assignment of a liability to make periodic payments as damages")
rule QualifiedAssignmentDefined(assignment: LiabilityAssignment) strict {
    label en official "section 130(c)(1)-(2)(A)-(D)";
    when assignment_on_account_of_physical_injury_or_sickness(assignment);
    when assignee_assumes_liability_from_party(assignment);
    when periodic_payments_fixed_and_determinable(assignment);
    when periodic_payments_not_alterable_by_recipient(assignment);
    when assignee_obligation_no_greater(assignment);
    when payments_excludable_under_104a1_or_2(assignment);
    then qualified_assignment_130c(assignment);
}
pub relation funding_asset_of(asset: us.irc.core::Asset, assignment: LiabilityAssignment) kind empirical {
    label en official "the annuity contract or obligation of the United States is used by the assignee to fund periodic payments under the assignment (section 130(d)(1))";
}
relation funding_asset_is_insurer_annuity_or_us_obligation(asset: us.irc.core::Asset) kind empirical {
    label en official "the asset is an annuity contract issued by a company licensed as an insurance company under State law, or an obligation of the United States (section 130(d), lead-in)";
}
relation funding_periods_reasonably_related(asset: us.irc.core::Asset) kind empirical {
    label en official "the periods of the payments under the asset are reasonably related to the periodic payments under the assignment, and no asset payment exceeds the periodic payment to which it relates (section 130(d)(2))";
}
relation funding_asset_designated_by_taxpayer(asset: us.irc.core::Asset) kind empirical {
    label en official "the asset is designated by the taxpayer, in the manner prescribed by regulations, as taken into account under section 130 for the assignment (section 130(d)(3))";
}
relation funding_asset_purchase_date(asset: us.irc.core::Asset, purchased: Date) kind empirical {
    label en official "the date the asset was purchased by the taxpayer";
}
relation assignment_date(assignment: LiabilityAssignment, on: Date) kind empirical {
    label en official "the date of the qualified assignment";
}
pub relation qualified_funding_asset_130d(asset: us.irc.core::Asset) kind institutional {
    label en official "a qualified funding asset";
}
@source(IRC_S130_D, relation = formalizes, coverage = exact, quote = "such annuity contract or obligation is purchased by the taxpayer not more than 60 days before the date of the qualified assignment and not later than 60 days after the date of such assignment.")
rule QualifiedFundingAssetDefined(asset: us.irc.core::Asset, assignment: LiabilityAssignment, purchased: Date, assigned_on: Date) strict {
    label en official "section 130(d)(1)-(4): the purchase falls in the window [assignment - 60 days, assignment + 60 days], counted in calendar days";
    when funding_asset_of(asset, assignment);
    when qualified_assignment_130c(assignment);
    when funding_asset_is_insurer_annuity_or_us_obligation(asset);
    when funding_periods_reasonably_related(asset);
    when funding_asset_designated_by_taxpayer(asset);
    when funding_asset_purchase_date(asset, purchased);
    when assignment_date(assignment, assigned_on);
    when add_calendar_period(purchased, 60 calendar_day) >= assigned_on;
    when purchased <= add_calendar_period(assigned_on, 60 calendar_day);
    then qualified_funding_asset_130d(asset);
}
relation amount_received_for_agreeing_to_qualified_assignment(p: Person, assignment: LiabilityAssignment, amount: Money) kind empirical {
    label en official "an amount received (by the assignee) for agreeing to a qualified assignment (section 130(a))";
}
relation aggregate_cost_of_qualified_funding_assets(assignment: LiabilityAssignment, cost: Money) kind empirical {
    label en official "the aggregate cost of the qualified funding assets of the assignment";
}
pub relation assignment_payment_excluded_130a(p: Person, assignment: LiabilityAssignment, amount: Money) kind institutional {
    label en official "the amount received for agreeing to a qualified assignment excluded from gross income, to the extent it does not exceed the aggregate cost of qualified funding assets";
}
@source(IRC_S130_A, relation = formalizes, coverage = exact, quote = "shall not be included in gross income to the extent that such amount does not exceed the aggregate cost of any qualified funding assets.")
rule AssignmentPaymentExcluded(p: Person, assignment: LiabilityAssignment, amount: Money, cost: Money) strict {
    label en official "section 130(a)";
    when amount_received_for_agreeing_to_qualified_assignment(p, assignment, amount);
    when qualified_assignment_130c(assignment);
    when aggregate_cost_of_qualified_funding_assets(assignment, cost);
    then assignment_payment_excluded_130a(p, assignment, min(amount, cost));
}
pub relation funding_asset_basis_reduction_130b1(asset: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the basis of the qualified funding asset is reduced by the amount excluded by reason of its purchase";
}
@source(IRC_S130_B, relation = formalizes, coverage = partial, quote = "the basis of such asset shall be reduced by the amount excluded from gross income under subsection (a) by reason of the purchase of such asset")
rule FundingAssetBasisReduced(p: Person, assignment: LiabilityAssignment, asset: us.irc.core::Asset, excluded: Money) strict {
    label en official "section 130(b)(1) (allocation among several assets is the case's)";
    when assignment_payment_excluded_130a(p, assignment, excluded);
    when qualified_funding_asset_130d(asset);
    when funding_asset_of(asset, assignment);
    then funding_asset_basis_reduction_130b1(asset, excluded);
}
pub relation disposition_gain_on_funding_asset_ordinary_130b2(asset: us.irc.core::Asset) kind institutional {
    label en official "any gain recognized on a disposition of a qualified funding asset is ordinary income";
}
@source(IRC_S130_B, relation = formalizes, coverage = exact, quote = "any gain recognized on a disposition of such asset shall be treated as ordinary income.")
rule FundingAssetGainOrdinary(asset: us.irc.core::Asset) strict {
    label en official "section 130(b)(2)";
    when qualified_funding_asset_130d(asset);
    then disposition_gain_on_funding_asset_ordinary_130b2(asset);
}

// =====================================================================
// §131: foster care payments
// =====================================================================

pub relation foster_care_payment(p: Individual, y: TaxableYear, payment: us.irc.core::Transaction, amount: Money) kind empirical {
    label en official "a payment received by a foster care provider during the year (section 131(a))";
}
relation payment_under_state_foster_care_program(payment: us.irc.core::Transaction) kind empirical {
    label en official "the payment is made pursuant to a foster care program of a State or political subdivision (section 131(b)(1))";
}
relation payment_paid_by_state_or_licensed_agency(payment: us.irc.core::Transaction) kind empirical {
    label en official "the payment is paid by a State or political subdivision or a qualified foster care placement agency licensed or certified for the program (section 131(b)(1)(A), (3))";
}
relation payment_for_caring_for_qualified_foster_individual_in_home(payment: us.irc.core::Transaction) kind empirical {
    label en official "the payment is to the provider for caring for a qualified foster individual (placed by a State agency or a qualified placement agency) in the provider's home (section 131(b)(1)(B)(i), (2))";
}
relation payment_designated_difficulty_of_care(payment: us.irc.core::Transaction) kind empirical {
    label en official "the payment is compensation for additional care required by a handicap for which the State determined a need for additional compensation, provided in the provider's home, and designated by the payor as such (section 131(c)(1))";
}
relation payment_is_difficulty_of_care_payment(payment: us.irc.core::Transaction) kind institutional {
    label en official "a difficulty of care payment (not a payment described in (b)(1)(B)(i))";
}
@source(IRC_S131_C, relation = formalizes, coverage = exact, quote = "The term \"difficulty of care payments\" means payments to individuals which are not described in subsection (b)(1)(B)(i), and which—")
rule DifficultyOfCarePaymentDefined(payment: us.irc.core::Transaction) strict {
    label en official "section 131(c)(1)";
    when payment_designated_difficulty_of_care(payment);
    when not_known(payment_for_caring_for_qualified_foster_individual_in_home(payment));
    then payment_is_difficulty_of_care_payment(payment);
}
pub relation qualified_foster_care_payment_131b1(payment: us.irc.core::Transaction) kind institutional {
    label en official "a qualified foster care payment";
}
@source(IRC_S131_B, relation = formalizes, coverage = exact, quote = "The term \"qualified foster care payment\" means any payment made pursuant to a foster care program of a State or political subdivision thereof—")
rule QualifiedFosterCarePaymentCaring(payment: us.irc.core::Transaction) strict {
    label en official "section 131(b)(1)(B)(i)";
    when payment_under_state_foster_care_program(payment);
    when payment_paid_by_state_or_licensed_agency(payment);
    when payment_for_caring_for_qualified_foster_individual_in_home(payment);
    then qualified_foster_care_payment_131b1(payment);
}
rule QualifiedFosterCarePaymentDifficultyOfCare(payment: us.irc.core::Transaction) strict {
    label en official "section 131(b)(1)(B)(ii)";
    when payment_under_state_foster_care_program(payment);
    when payment_paid_by_state_or_licensed_agency(payment);
    when payment_is_difficulty_of_care_payment(payment);
    then qualified_foster_care_payment_131b1(payment);
}
relation foster_home_qualified_individuals(p: Individual, y: TaxableYear, under_19: Integer, aged_19_or_over: Integer) kind empirical {
    label en official "the number of qualified foster individuals in the foster home who have not attained age 19, and the number who have attained age 19 (section 131(b)(4), (c)(2))";
}
relation payment_for_qualified_foster_individual_rank(payment: us.irc.core::Transaction, is_over_limit_b4: Integer) kind empirical {
    label en official "1 when the payment (other than difficulty of care) is made for more individuals than section 131(b)(4) allows (more than 5 individuals aged 19 or over), 0 otherwise";
}
pub relation foster_care_payment_excluded_131a(p: Individual, y: TaxableYear, payment: us.irc.core::Transaction, amount: Money) kind institutional {
    label en official "the qualified foster care payment excluded from the provider's gross income (before the per-home limits are applied to counts)";
}
@source(IRC_S131_A, relation = formalizes, coverage = exact, quote = "Gross income shall not include amounts received by a foster care provider during the taxable year as qualified foster care payments.")
rule FosterCarePaymentExcluded(p: Individual, y: TaxableYear, payment: us.irc.core::Transaction, amount: Money, over_limit: Integer) strict {
    label en official "section 131(a), with the (b)(4) limit: payments (other than difficulty of care) for more than 5 qualified foster individuals aged 19 or over are not excludable to that extent — the case flags a payment made for the individuals above the limit";
    when foster_care_payment(p, y, payment, amount);
    when qualified_foster_care_payment_131b1(payment);
    when not_known(payment_is_difficulty_of_care_payment(payment));
    when payment_for_qualified_foster_individual_rank(payment, over_limit);
    when over_limit == 0;
    then foster_care_payment_excluded_131a(p, y, payment, amount);
}
@source(IRC_S131_C, relation = formalizes, coverage = exact, quote = "difficulty of care payments for any period to which such payments relate shall not be excludable from gross income under subsection (a) to the extent such payments are made for more than—")
rule DifficultyOfCarePaymentExcludedWithinLimits(p: Individual, y: TaxableYear, payment: us.irc.core::Transaction, amount: Money, under_19: Integer, over_19: Integer) strict {
    label en official "section 131(c)(2): difficulty of care payments are excludable for up to 10 qualified foster individuals under 19 and up to 5 others";
    when foster_care_payment(p, y, payment, amount);
    when qualified_foster_care_payment_131b1(payment);
    when payment_is_difficulty_of_care_payment(payment);
    when foster_home_qualified_individuals(p, y, under_19, over_19);
    when under_19 <= 10;
    when over_19 <= 5;
    then foster_care_payment_excluded_131a(p, y, payment, amount);
}

// =====================================================================
// §134: military benefits
// =====================================================================

pub relation benefit_received_by_service_member_or_dependent(p: Individual, y: TaxableYear, benefit: us.irc.core::Transaction, amount: Money) kind empirical {
    label en official "an allowance or in-kind benefit (other than personal use of a vehicle) received by a member or former member of the uniformed services, or a dependent, by reason of the member's status or service (section 134(b)(1)(A))";
}
relation benefit_excludable_on_1986_09_09(benefit: us.irc.core::Transaction) kind empirical {
    label en official "the benefit was excludable from gross income on September 9, 1986, under a provision of law, regulation, or administrative practice then in effect other than a provision of this title (section 134(b)(1)(B))";
}
relation benefit_modified_after_1986(benefit: us.irc.core::Transaction) kind empirical {
    label en official "the benefit was modified or adjusted after September 9, 1986 (section 134(b)(3)(A))";
}
relation modification_within_134b3_exceptions(benefit: us.irc.core::Transaction) kind empirical {
    label en official "the modification is a cash-benefit index adjustment under pre-1986 law ((b)(3)(B)), a death gratuity adjustment made by law ((b)(3)(C)), a dependent care assistance program ((b)(4)), or an Operation Hero Miles travel benefit ((b)(5))";
}
relation state_combat_zone_bonus_payment(benefit: us.irc.core::Transaction) kind empirical {
    label en official "a bonus payment by a State or political subdivision to a member, former member or dependent only by reason of service in a combat zone as defined in section 112(c)(2) (section 134(b)(6))";
}
pub relation qualified_military_benefit_134b(benefit: us.irc.core::Transaction) kind institutional {
    label en official "a qualified military benefit";
}
@source(IRC_S134_B, relation = formalizes, coverage = partial, quote = "was excludable from gross income on September 9, 1986, under any provision of law, regulation, or administrative practice which was in effect on such date (other than a provision of this title).")
rule QualifiedMilitaryBenefitPre1986Exclusion(benefit: us.irc.core::Transaction) strict {
    label en official "section 134(b)(1)(B), with (b)(3): a post-1986 modification is not taken into account unless an exception applies";
    when benefit_excludable_on_1986_09_09(benefit);
    when not_known(benefit_modified_after_1986(benefit));
    then qualified_military_benefit_134b(benefit);
}
rule QualifiedMilitaryBenefitModificationWithinException(benefit: us.irc.core::Transaction) strict {
    label en official "section 134(b)(3)(B)-(C), (b)(4), (b)(5)";
    when benefit_excludable_on_1986_09_09(benefit);
    when benefit_modified_after_1986(benefit);
    when modification_within_134b3_exceptions(benefit);
    then qualified_military_benefit_134b(benefit);
}
@source(IRC_S134_B, relation = formalizes, coverage = partial, quote = "The term \"qualified military benefit\" includes any bonus payment by a State or political subdivision thereof to any member or former member of the uniformed services of the United States or any dependent of such member only by reason of such member's service in a combat zone")
rule QualifiedMilitaryBenefitStateBonus(benefit: us.irc.core::Transaction) strict {
    label en official "section 134(b)(6)";
    when state_combat_zone_bonus_payment(benefit);
    then qualified_military_benefit_134b(benefit);
}
pub relation qualified_military_benefit_excluded_134a(p: Individual, y: TaxableYear, benefit: us.irc.core::Transaction, amount: Money) kind institutional {
    label en official "the qualified military benefit excluded from gross income";
}
@source(IRC_S134_A, relation = formalizes, coverage = exact, quote = "Gross income shall not include any qualified military benefit.")
rule QualifiedMilitaryBenefitExcluded(p: Individual, y: TaxableYear, benefit: us.irc.core::Transaction, amount: Money) strict {
    label en official "section 134(a)";
    when benefit_received_by_service_member_or_dependent(p, y, benefit, amount);
    when qualified_military_benefit_134b(benefit);
    then qualified_military_benefit_excluded_134a(p, y, benefit, amount);
}

// =====================================================================
// §136: energy conservation subsidies
// =====================================================================

pub relation utility_energy_conservation_subsidy(p: Individual, y: TaxableYear, subsidy: us.irc.core::Transaction, amount: Money) kind empirical {
    label en official "the value of a subsidy provided (directly or indirectly) by a public utility to a customer for the purchase or installation of an energy conservation measure (section 136(a))";
}
relation subsidy_provider_is_public_utility(subsidy: us.irc.core::Transaction) kind empirical {
    label en official "the provider is a person engaged in the sale of electricity or natural gas to residential, commercial, or industrial customers for their use, including the Federal Government, a State or local government or instrumentality (section 136(c)(2)(B))";
}
relation measure_reduces_electricity_or_gas_use_for_dwelling_unit(subsidy: us.irc.core::Transaction) kind empirical {
    label en official "the installation or modification is primarily designed to reduce consumption of electricity or natural gas or to improve the management of energy demand with respect to a dwelling unit (section 136(c)(1)-(2)(A))";
}
relation payment_under_public_utility_regulatory_policies_act_210(subsidy: us.irc.core::Transaction) kind empirical {
    label en official "the payment is to or from a qualified cogeneration facility or qualifying small power production facility pursuant to section 210 of the Public Utility Regulatory Policy Act of 1978 (section 136(d))";
}
pub relation energy_conservation_subsidy_excluded_136a(p: Individual, y: TaxableYear, subsidy: us.irc.core::Transaction, amount: Money) kind institutional {
    label en official "the energy conservation subsidy excluded from gross income";
}
@source(IRC_S136_A, relation = formalizes, coverage = exact, quote = "Gross income shall not include the value of any subsidy provided (directly or indirectly) by a public utility to a customer for the purchase or installation of any energy conservation measure.")
rule EnergyConservationSubsidyExcluded(p: Individual, y: TaxableYear, subsidy: us.irc.core::Transaction, amount: Money) strict {
    label en official "section 136(a), (c), (d)";
    when utility_energy_conservation_subsidy(p, y, subsidy, amount);
    when subsidy_provider_is_public_utility(subsidy);
    when measure_reduces_electricity_or_gas_use_for_dwelling_unit(subsidy);
    when not_known(payment_under_public_utility_regulatory_policies_act_210(subsidy));
    then energy_conservation_subsidy_excluded_136a(p, y, subsidy, amount);
}
pub relation basis_reduction_for_excluded_subsidy_136b(subsidy: us.irc.core::Transaction, amount: Money) kind institutional {
    label en official "the adjusted basis of the property is reduced by the amount excluded, and no deduction or credit is allowed for the expenditure to that extent";
}
@source(IRC_S136_B, relation = formalizes, coverage = exact, quote = "The adjusted basis of any property shall be reduced by the amount excluded under subsection (a) which was provided with respect to such property.")
rule ExcludedSubsidyReducesBasisAndDeduction(p: Individual, y: TaxableYear, subsidy: us.irc.core::Transaction, amount: Money) strict {
    label en official "section 136(b)";
    when energy_conservation_subsidy_excluded_136a(p, y, subsidy, amount);
    then basis_reduction_for_excluded_subsidy_136b(subsidy, amount);
}

// =====================================================================
// §138: Medicare Advantage MSA
// =====================================================================

pub relation payment_to_medicare_advantage_msa(p: Individual, y: TaxableYear, msa: us.irc.core::Asset, amount: Money) kind empirical {
    label en official "a payment to the Medicare Advantage MSA of an individual by the Secretary of Health and Human Services under part C of title XVIII of the Social Security Act (section 138(a))";
}
relation archer_msa_designated_medicare_advantage_msa(msa: us.irc.core::Asset) kind empirical {
    label en official "the Archer MSA (section 220(d)) is designated as a Medicare Advantage MSA, contributions are only by the Secretary of Health and Human Services or trustee-to-trustee transfers, the governing instrument permits such transfers, and it is established in connection with an MSA plan described in section 1859(b)(3) of the Social Security Act (section 138(b)(1)-(4))";
}
pub relation medicare_advantage_msa_payment_excluded_138a(p: Individual, y: TaxableYear, msa: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the payment to a Medicare Advantage MSA excluded from gross income";
}
@source(IRC_S138_A, relation = formalizes, coverage = exact, quote = "Gross income shall not include any payment to the Medicare Advantage MSA of an individual by the Secretary of Health and Human Services under part C of title XVIII of the Social Security Act.")
rule MedicareAdvantageMsaPaymentExcluded(p: Individual, y: TaxableYear, msa: us.irc.core::Asset, amount: Money) strict {
    label en official "section 138(a), (b)";
    when payment_to_medicare_advantage_msa(p, y, msa, amount);
    when archer_msa_designated_medicare_advantage_msa(msa);
    then medicare_advantage_msa_payment_excluded_138a(p, y, msa, amount);
}
relation msa_distribution_not_used_for_qualified_medical_expenses(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the total of all payments and distributions from the account holder's Medicare Advantage MSAs (treated as one account and as one distribution, section 138(c)(2)(C)) not used exclusively to pay the qualified medical expenses of the account holder in the year";
}
relation msa_assets_fair_market_value_prior_year_end(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the fair market value of the assets in the MSA as of the close of the calendar year preceding the calendar year in which the taxable year begins (section 138(c)(2)(A)(ii)(I))";
}
relation msa_plan_deductible_on_january_1(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the deductible under the Medicare Advantage MSA plan covering the account holder as of January 1 of the calendar year in which the taxable year begins (section 138(c)(2)(A)(ii)(II))";
}
relation msa_distribution_exempt_from_penalty(p: Individual, y: TaxableYear) kind institutional {
    label en official "helper: the payment or distribution falls under a section 138(c)(2)(B), (3) or (4) exception";
}
relation account_holder_disabled_or_dead_at_distribution(p: Individual, y: TaxableYear) kind empirical {
    label en official "the payment or distribution is made on or after the date the account holder becomes disabled within the meaning of section 72(m)(7), or dies (section 138(c)(2)(B))";
}
relation distribution_is_erroneous_contribution_return_or_trustee_transfer(p: Individual, y: TaxableYear) kind empirical {
    label en official "the distribution is a return to the Secretary of Health and Human Services of an erroneous contribution and its net income (section 138(c)(3)), or a trustee-to-trustee transfer to another Medicare Advantage MSA of the account holder (section 138(c)(4))";
}
rule MsaPenaltyExceptionDisabledOrDead(p: Individual, y: TaxableYear) strict {
    label en official "section 138(c)(2)(B)";
    when account_holder_disabled_or_dead_at_distribution(p, y);
    then msa_distribution_exempt_from_penalty(p, y);
}
rule MsaPenaltyExceptionErroneousOrTransfer(p: Individual, y: TaxableYear) strict {
    label en official "section 138(c)(3)-(4)";
    when distribution_is_erroneous_contribution_return_or_trustee_transfer(p, y);
    then msa_distribution_exempt_from_penalty(p, y);
}
pub relation msa_distribution_additional_tax_138c2(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the increase in the year's tax: 50 percent of the excess (if any) of the non-medical distribution over the excess (if any) of the prior-year-end asset value over 60 percent of the plan deductible";
}
@source(IRC_S138_C, relation = formalizes, coverage = exact, quote = "shall be increased by 50 percent of the excess (if any) of—")
rule MsaAdditionalTaxComputed(p: Individual, y: TaxableYear, dist: Money, fmv: Money, deductible: Money) strict {
    label en official "section 138(c)(2)(A): 50% x max(0, distribution - max(0, FMV - 60% x deductible)); a distribution exception (B), (3), (4) removes the tax";
    when msa_distribution_not_used_for_qualified_medical_expenses(p, y, dist);
    when msa_assets_fair_market_value_prior_year_end(p, y, fmv);
    when msa_plan_deductible_on_january_1(p, y, deductible);
    when not_known(msa_distribution_exempt_from_penalty(p, y));
    then msa_distribution_additional_tax_138c2(p, y,
        round(0.50 * max(0.00 USD, dist - max(0.00 USD, fmv - round(0.60 * deductible, 2, "HALF_UP"))), 2, "HALF_UP"));
}
relation msa_report_due_holder(trustee: Person, holder: Individual, y: TaxableYear) kind empirical {
    label en official "the trustee of a Medicare Advantage MSA is required to make the section 220(h) report for the calendar year to the account holder";
}
relation msa_report_furnished_to_holder(trustee: Person, holder: Individual, y: TaxableYear) kind empirical {
    label en official "the report, including the fair market value of the MSA assets as of the close of the calendar year, is furnished to the account holder (section 138(e))";
}
relation msa_report_window_138e(y: TaxableYear, start: Date, due: Date) kind institutional {
    label en official "the window for the report: from the close of the calendar year to January 31 of the following calendar year (31 calendar days after December 31)";
}
@source(IRC_S138_E, relation = formalizes, coverage = partial, quote = "not later than January 31 of the calendar year following the calendar year to which such reports relate, and")
rule MsaReportWindowComputed(y: TaxableYear, d1: Date) strict {
    label en official "section 138(e)(2)(A)";
    when us.irc.core::ends(y, d1);
    then msa_report_window_138e(y, d1, add_calendar_period(d1, 31 calendar_day));
}
@source(IRC_S138_E, relation = formalizes, coverage = partial, quote = "shall be furnished to the account holder—")
rule Section138eReportDutyRule strict {
    for trustee: Person;
    for holder: Individual;
    for y: TaxableYear;
    for d1: Date;
    for d2: Date;
    when msa_report_due_holder(trustee, holder, y)
        and msa_report_window_138e(y, d1, d2);
    then duty Section138eFurnishReportDuty {
        bearer trustee;
        beneficiary holder;
        goal achievement {
            condition msa_report_furnished_to_holder(trustee, holder, y);
            window [d1, d2];
        }
    };
}
