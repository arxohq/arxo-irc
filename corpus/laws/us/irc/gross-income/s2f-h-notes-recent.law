// Stage 2f (TECH_GAP reduction) — operative special rules quoted in statutory notes that are
// still live for the current edition: §118 note (Pub. L. 115-97 §13312), §61 note (§11051),
// §72 note (Pub. L. 117-328 div. T), §74 note (§11011).
// STATUS: implemented_unverified (static check only; scenarios in tests/s2f-h-notes-recent.lawtest
// are NOT executed).

use self::{
    IRC_S118_NOTE_4,
    IRC_S61_NOTE_4,
    IRC_S72_NOTE_6,
    IRC_S74_NOTE_5,
    Person,
    TaxableYear,
};

// §118 note: contributions after December 22, 2017
relation contribution_118_note_facts(contribution: us.irc.core::Transaction, made_on: Date, by_governmental_entity: Boolean, pursuant_to_master_development_plan_approved_before_2017_12_22: Boolean) kind empirical {
    label en official "the contribution, its date, whether it is made by a governmental entity, and whether it is made pursuant to a master development plan approved before December 22, 2017 by a governmental entity";
}
pub relation section_118_2017_amendments_apply_118note(contribution: us.irc.core::Transaction) kind institutional {
    label en official "the amendments made by Pub. L. 115-97 section 13312 apply to the contribution: made after December 22, 2017, but not a governmental entity's contribution under an earlier approved master development plan";
}
@source(IRC_S118_NOTE_4, relation = formalizes, coverage = exact, quote = "\"(1) In general.—Except as provided in paragraph (2), the amendments made by this section [amending this section] shall apply to contributions made after the date of")
rule Section118AmendmentsApplyAfter2017(c: us.irc.core::Transaction, d: Date, plan: Boolean) strict {
    label en official "Pub. L. 115-97 section 13312(b)(1): non-governmental contribution after the enactment date";
    when contribution_118_note_facts(c, d, false, plan);
    when d > @2017-12-22;
    then section_118_2017_amendments_apply_118note(c);
}
@source(IRC_S118_NOTE_4, relation = formalizes, coverage = exact, quote = "\"(1) In general.—Except as provided in paragraph (2), the amendments made by this section [amending this section] shall apply to contributions made after the date of")
rule Section118AmendmentsApplyToGovernmentContributionWithoutPlan(c: us.irc.core::Transaction, d: Date) strict {
    label en official "Pub. L. 115-97 section 13312(b)(1) with the exception of (2): a governmental contribution not under an earlier master plan";
    when contribution_118_note_facts(c, d, true, false);
    when d > @2017-12-22;
    then section_118_2017_amendments_apply_118note(c);
}
pub relation section_118_2017_amendments_do_not_apply_118note(contribution: us.irc.core::Transaction) kind institutional {
    label en official "the exception: a governmental entity's contribution made after the enactment date pursuant to a master development plan approved before it by a governmental entity";
}
@source(IRC_S118_NOTE_4, relation = formalizes, coverage = exact, quote = "\"(2) Exception.—The amendments made by this section shall not apply to any contribution, made after the date of enactment of this Act by a governmental entity, which is")
rule Section118AmendmentsDoNotApplyToApprovedMasterPlan(c: us.irc.core::Transaction, d: Date) strict {
    label en official "Pub. L. 115-97 section 13312(b)(2)";
    when contribution_118_note_facts(c, d, true, true);
    when d > @2017-12-22;
    then section_118_2017_amendments_do_not_apply_118note(c);
}

// §61 note: alimony instruments (Pub. L. 115-97 section 11051)
relation divorce_instrument_facts_61note(instrument: us.irc.core::Asset, executed_on: Date, modified_on: Date, modification_expressly_provides_the_amendments_apply: Boolean) kind empirical {
    label en official "the divorce or separation instrument (section 71(b)(2) as in effect before the enactment date), its execution date, the date of a modification (the far-future date 9999-12-31 when none), and whether the modification expressly provides that the amendments made by section 11051 apply to it";
}
pub relation section_11051_amendments_apply_61note(instrument: us.irc.core::Asset) kind institutional {
    label en official "the amendments made by section 11051 (repeal of sections 71, 215, 682 and the related conforming changes) apply to the instrument";
}
@source(IRC_S61_NOTE_4, relation = formalizes, coverage = exact, quote = "\"(1) any divorce or separation instrument (as defined in section 71(b)(2) of the Internal Revenue Code of 1986 as in effect before the date of the enactment of this Act")
rule Section11051AppliesToInstrumentExecutedAfter2018(i: us.irc.core::Asset, e: Date, m: Date, x: Boolean) strict {
    label en official "Pub. L. 115-97 section 11051(c)(1): executed after December 31, 2018";
    when divorce_instrument_facts_61note(i, e, m, x);
    when e > @2018-12-31;
    then section_11051_amendments_apply_61note(i);
}
@source(IRC_S61_NOTE_4, relation = formalizes, coverage = exact, quote = "\"(2) any divorce or separation instrument (as so defined) executed on or before such date and modified after such date if the modification expressly provides that the")
rule Section11051AppliesToModifiedInstrument(i: us.irc.core::Asset, e: Date, m: Date) strict {
    label en official "Pub. L. 115-97 section 11051(c)(2): executed on or before December 31, 2018 and modified after that date if the modification expressly provides that the amendments apply";
    when divorce_instrument_facts_61note(i, e, m, true);
    when e <= @2018-12-31;
    when m > @2018-12-31;
    then section_11051_amendments_apply_61note(i);
}

// §72 note: qualified birth or adoption distributions (Pub. L. 117-328 div. T section 314)
relation birth_or_adoption_distribution_note_72(distribution: us.irc.core::Asset, made_on: Date) kind empirical {
    label en official "a qualified birth or adoption distribution (section 72(t)(2)(H)(iii)(I)) and the date it was made";
}
pub relation amendment_applies_to_distribution_72note(distribution: us.irc.core::Asset) kind institutional {
    label en official "the amendment of section 72(t)(2)(H)(v)(I) made by division T of Pub. L. 117-328 applies to distributions made after December 29, 2022";
}
@source(IRC_S72_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(1) In general.—Except as provided in paragraph (2), the amendment made by this section [amending this section] shall apply to distributions made after the date of the")
rule Section72NoteAmendmentAppliesAfterEnactment(d: us.irc.core::Asset, on: Date) strict {
    label en official "Pub. L. 117-328 div. T section 314(b)(1)";
    when birth_or_adoption_distribution_note_72(d, on);
    when on > @2022-12-29;
    then amendment_applies_to_distribution_72note(d);
}
pub relation repayment_window_end_before_72note(distribution: us.irc.core::Asset, before: Date) kind institutional {
    label en official "a distribution made on or before the enactment date may be repaid after the distribution and before January 1, 2026 (in place of the 3-year period beginning on the day after the distribution)";
}
@source(IRC_S72_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(2) Temporary rule with respect to distributions already made.—In the case of a qualified birth or adoption distribution (as defined in section 72(t)(2)(H)(iii)(I) of")
rule Section72NoteTemporaryRepaymentWindow(d: us.irc.core::Asset, on: Date) strict {
    label en official "Pub. L. 117-328 div. T section 314(b)(2)";
    when birth_or_adoption_distribution_note_72(d, on);
    when on <= @2022-12-29;
    then repayment_window_end_before_72note(d, @2026-01-01);
}

// §74 note: Pub. L. 115-97 section 11011 (deduction for qualified business income) transition
relation section_11011_taxable_year_74note(y: TaxableYear, begins: Date) kind empirical {
    label en official "the taxable year and the day it begins";
}
pub relation section_11011_amendments_apply_74note(y: TaxableYear) kind institutional {
    label en official "the amendments made by section 11011 apply to taxable years beginning after December 31, 2017";
}
@source(IRC_S74_NOTE_5, relation = formalizes, coverage = exact, quote = "\"(1) In general.—Except as provided in paragraph (2), the amendments made by this section [amending this section and sections 86, 135, 137, 170, 172, 219, 221, 222, 246,")
rule Section11011AmendmentsApply(y: TaxableYear, b: Date) strict {
    label en official "Pub. L. 115-97 section 11011(d)(1)";
    when section_11011_taxable_year_74note(y, b);
    when b > @2017-12-31;
    then section_11011_amendments_apply_74note(y);
}
relation cooperative_qualified_payment_74note(p: Person, y: TaxableYear, received_from_specified_agricultural_or_horticultural_cooperative: Boolean, attributable_to_qpai_with_section_199_deduction_allowable_to_the_cooperative_for_a_year_before_2018: Boolean, amount: Money) kind empirical {
    label en official "a qualified payment received by a taxpayer from a specified agricultural or horticultural cooperative in a taxable year beginning after December 31, 2017, attributable to qualified production activities income for which the cooperative was allowed a section 199 deduction (as in effect before the amendments) for a taxable year beginning before January 1, 2018";
}
pub relation section_11011_amendments_do_not_apply_to_payment_74note(p: Person, y: TaxableYear) kind institutional {
    label en official "the amendments do not apply to the payment";
}
@source(IRC_S74_NOTE_5, relation = formalizes, coverage = exact, quote = "\"(A) In general.—The amendments made by this section shall not apply to a qualified payment received by a taxpayer from a specified agricultural or horticultural")
rule Section11011DoesNotApplyToCooperativePayment(p: Person, y: TaxableYear, amount: Money) strict {
    label en official "Pub. L. 115-97 section 11011(d)(2)(A)";
    when cooperative_qualified_payment_74note(p, y, true, true, amount);
    then section_11011_amendments_do_not_apply_to_payment_74note(p, y);
}
pub relation section_199a_deduction_denied_for_payment_74note(p: Person, y: TaxableYear) kind institutional {
    label en official "no deduction is allowed under section 199A for a qualified payment to which subparagraph (A) applies";
}
@source(IRC_S74_NOTE_5, relation = formalizes, coverage = exact, quote = "\"(B) Coordination with section 199a.—No deduction shall be allowed under section 199A of such Code for any qualified payment to which subparagraph (A) applies.\"")
rule Section199aDeniedForTransitionPayment(p: Person, y: TaxableYear) strict {
    label en official "Pub. L. 115-97 section 11011(d)(2)(B)";
    when section_11011_amendments_do_not_apply_to_payment_74note(p, y);
    then section_199a_deduction_denied_for_payment_74note(p, y);
}
