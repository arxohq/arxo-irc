// Gross income -- WIRE-7 (26.09.2026, DECISION-0379, implemented_unverified).
//
// Each relation below was a local contract (a fact or an underived institutional placeholder naming its owner). The owner package
// publishes the same concept, so the local relation is now DERIVED from the owner's `pub` relation; the case-fact channel stays valid
// (an institutional relation may still be asserted, DECISIONS Д-15/Д-19), so existing scenarios are unchanged. Nothing is restated.
// JUDGMENT CALL: the consumer reads these two classifications under `not_known(...)` (sections 64-65); deriving them from the owner
// can only add derived facts in a world that imports the owner's own inputs, so the consumer's own scenarios (which never supply the
// owner's inputs) keep their statuses.

language "law.core" version "0.2";
package us.irc.gross_income version "0.1.1";
namespace "urn:us:irc:gross_income:clir";

use self::{
    Person,
    is_capital_asset,
    is_section_1231b_property,
};

rule W7CapitalAssetFromPropertyTransactions strict {
    label en official "section 64: a capital asset is the section 1221(a) capital asset of the owner package `property_transactions`";
    for p: Person;
    for asset: us.irc.core::Asset;
    when us.irc.property_transactions::capital_asset(p, asset);
    then is_capital_asset(p, asset);
}

rule W7Section1231bPropertyFromPropertyTransactions strict {
    label en official "section 64: section 1231(b) property is the property of the owner package `property_transactions`";
    for p: Person;
    for asset: us.irc.core::Asset;
    when us.irc.property_transactions::section_1231b_property(p, asset);
    then is_section_1231b_property(p, asset);
}

