// Stage G3 (IRC-G steps 4-5, 2026-09-27): the refinancing and binding-contract bridges of
// Pub. L. 104-188 section 1602(c)(2)-(3) (fragment IRC_S133_NOTE_4), rows 26/133/note/4/3-8.
// The repeal of section 133 reaches loans made after enactment (August 20, 1996, the pinned
// note header); a post-enactment refinancing of a securities acquisition loan keeps the
// former section 133 when conditions (A)-(C) hold, and a loan under a binding written
// contract in effect before June 10, 1996 counts as made on or before enactment. Parallel
// to the existing stage-3 modules: no existing rule is touched. STATUS: implemented_unverified
// (static check only; scenarios in tests/97-g3-section133-refinancing-1996.lawtest are NOT executed).

use self::{
    IRC_S133_NOTE_4,
};

entity SecuritiesAcquisitionLoan133 {
    label en unofficial "a loan (or refinancing loan) whose section 1602 treatment the transition decides";
}
relation loan_made_on_133(loan: SecuritiesAcquisitionLoan133, on: Date) kind empirical {
    label en unofficial "section 1602(c)(1)-(2): the date the loan is made";
}
relation loan_refinances_133(loan: SecuritiesAcquisitionLoan133, original: SecuritiesAcquisitionLoan133) kind empirical {
    label en unofficial "section 1602(c)(2): the loan refinances the original loan (or a loan described in the paragraph)";
}
relation original_described_as_sal_133(original: SecuritiesAcquisitionLoan133, is_securities_acquisition_loan: Boolean) kind empirical {
    label en unofficial "section 1602(c)(2): the refinanced loan is a securities acquisition loan (case-applied; the former section 133 text is not pinned)";
}
pub relation securities_acquisition_loan_133(loan: SecuritiesAcquisitionLoan133) kind institutional {
    label en official "section 1602(c)(2) of Pub. L. 104-188: the loan is a securities acquisition loan for the refinancing paragraph";
}
@source(IRC_S133_NOTE_4, quote = "\"(2) Refinancings.—The amendments made by this section shall not apply to loans made after the date of the enactment of this Act to refinance securities acquisition loans (determined without regard to section 133(b)(1)(B) of the Internal Revenue Code of 1986, as in effect on the day before the date of the enactment of this Act) [set out above] made on or before such date or to refinance loans described in this paragraph if—")
rule OriginalIsSecuritiesAcquisitionLoan133(original: SecuritiesAcquisitionLoan133) strict {
    label en official "section 1602(c)(2) of Pub. L. 104-188: the case-applied securities acquisition loan";
    when original_described_as_sal_133(original, true);
    then securities_acquisition_loan_133(original);
}
relation esop_b3_loan_133(loan: SecuritiesAcquisitionLoan133, corp_to_esop_133b3: Boolean) kind empirical {
    label en unofficial "section 1602(c)(2), last sentence: the loan is from a corporation to an employee stock ownership plan described in section 133(b)(3) (as formerly in effect)";
}
@source(IRC_S133_NOTE_4, quote = "For purposes of this paragraph, the term 'securities acquisition loan' includes a loan from a corporation to an employee stock ownership plan described in section 133(b)(3) of such Code (as so in effect).")
rule EsopLoanIsSecuritiesAcquisitionLoan133(loan: SecuritiesAcquisitionLoan133) strict {
    label en official "section 1602(c)(2) of Pub. L. 104-188, last sentence";
    when esop_b3_loan_133(loan, true);
    then securities_acquisition_loan_133(loan);
}
relation refinancing_meets_former_133_133(loan: SecuritiesAcquisitionLoan133, meets: Boolean) kind empirical {
    label en unofficial "section 1602(c)(2)(A): the refinancing loan meets the requirements of section 133 (as formerly in effect)";
}
pub relation refinancing_meets_requirements_133(loan: SecuritiesAcquisitionLoan133) kind institutional {
    label en official "section 1602(c)(2)(A) of Pub. L. 104-188";
}
@source(IRC_S133_NOTE_4, quote = "\"(A) the refinancing loans meet the requirements of section 133 of such Code (as so in effect),")
rule RefinancingMeetsFormer133_133(loan: SecuritiesAcquisitionLoan133) strict {
    label en official "section 1602(c)(2)(A) of Pub. L. 104-188";
    when refinancing_meets_former_133_133(loan, true);
    then refinancing_meets_requirements_133(loan);
}
relation refinancing_principal_133(loan: SecuritiesAcquisitionLoan133, amount: Money) kind empirical {
    label en unofficial "section 1602(c)(2)(B): the principal amount of the refinancing loan immediately after the refinancing";
}
relation refinanced_principal_before_133(original: SecuritiesAcquisitionLoan133, amount: Money) kind empirical {
    label en unofficial "section 1602(c)(2)(B): the principal amount of the refinanced loan immediately before the refinancing";
}
pub relation refinancing_principal_ok_133(loan: SecuritiesAcquisitionLoan133) kind institutional {
    label en official "section 1602(c)(2)(B) of Pub. L. 104-188: the refinancing principal does not exceed the refinanced principal";
}
@source(IRC_S133_NOTE_4, quote = "\"(B) immediately after the refinancing the principal amount of the loan resulting from the refinancing does not exceed the principal amount of the refinanced loan (immediately before the refinancing), and")
rule RefinancingPrincipalCap133(loan: SecuritiesAcquisitionLoan133, original: SecuritiesAcquisitionLoan133, amount: Money, before: Money) strict {
    label en official "section 1602(c)(2)(B) of Pub. L. 104-188";
    when loan_refinances_133(loan, original);
    when refinancing_principal_133(loan, amount);
    when refinanced_principal_before_133(original, before);
    when amount <= before;
    then refinancing_principal_ok_133(loan);
}
relation refinancing_term_ends_133(loan: SecuritiesAcquisitionLoan133, end: Date) kind empirical {
    label en unofficial "section 1602(c)(2)(C): the last day of the term of the refinancing loan";
}
relation original_term_ends_133(original: SecuritiesAcquisitionLoan133, end: Date) kind empirical {
    label en unofficial "section 1602(c)(2)(C): the last day of the term of the original securities acquisition loan";
}
pub relation refinancing_term_ok_133(loan: SecuritiesAcquisitionLoan133) kind institutional {
    label en official "section 1602(c)(2)(C) of Pub. L. 104-188: the refinancing term does not extend beyond the original term";
}
@source(IRC_S133_NOTE_4, quote = "\"(C) the term of such refinancing loan does not extend beyond the last day of the term of the original securities acquisition loan.")
rule RefinancingTermCap133(loan: SecuritiesAcquisitionLoan133, original: SecuritiesAcquisitionLoan133, end: Date, original_end: Date) strict {
    label en official "section 1602(c)(2)(C) of Pub. L. 104-188";
    when loan_refinances_133(loan, original);
    when refinancing_term_ends_133(loan, end);
    when original_term_ends_133(original, original_end);
    when end <= original_end;
    then refinancing_term_ok_133(loan);
}
relation binding_contract_133(loan: SecuritiesAcquisitionLoan133, binding_before_1996_06_10_and_ever_since: Boolean) kind empirical {
    label en unofficial "section 1602(c)(3): the loan is made pursuant to a binding written contract in effect before June 10, 1996, and at all times thereafter before the loan is made";
}
pub relation loan_treated_as_made_before_enactment_133(loan: SecuritiesAcquisitionLoan133) kind institutional {
    label en official "section 1602(c)(3) of Pub. L. 104-188: the loan counts as made on or before enactment (August 20, 1996) for paragraphs (1) and (2)";
}
@source(IRC_S133_NOTE_4, quote = "\"(3) Exception.—Any loan made pursuant to a binding written contract in effect before June 10, 1996, and at all times thereafter before such loan is made, shall be treated for purposes of paragraphs (1) and (2) as a loan made on or before the date of the enactment of this Act.")
rule BindingContractLoanTreatedAsBeforeEnactment133(loan: SecuritiesAcquisitionLoan133) strict {
    label en official "section 1602(c)(3) of Pub. L. 104-188";
    when binding_contract_133(loan, true);
    then loan_treated_as_made_before_enactment_133(loan);
}
pub relation original_timing_ok_133(original: SecuritiesAcquisitionLoan133) kind institutional {
    label en official "section 1602(c)(2) of Pub. L. 104-188: the refinanced loan was made on or before enactment, actually or by the paragraph (3) fiction";
}
rule OriginalTimingByDate133(original: SecuritiesAcquisitionLoan133, made: Date) strict {
    label en official "section 1602(c)(2) of Pub. L. 104-188: made on or before August 20, 1996";
    when loan_made_on_133(original, made);
    when made <= @1996-08-20;
    then original_timing_ok_133(original);
}
rule OriginalTimingByBindingContract133(original: SecuritiesAcquisitionLoan133) strict {
    label en official "section 1602(c)(3) of Pub. L. 104-188 applied in (c)(2): deemed made on or before enactment";
    when loan_treated_as_made_before_enactment_133(original);
    then original_timing_ok_133(original);
}
pub relation section1602_amendments_inapplicable_133(loan: SecuritiesAcquisitionLoan133) kind institutional {
    label en official "section 1602(c)(2) of Pub. L. 104-188: the amendments made by section 1602 do not apply to the post-enactment refinancing loan";
}
rule RefinancingOutside1602_133(loan: SecuritiesAcquisitionLoan133, original: SecuritiesAcquisitionLoan133, made: Date) strict {
    label en official "section 1602(c)(2) of Pub. L. 104-188: a post-enactment refinancing meeting (A)-(C) of a timely securities acquisition loan";
    when loan_made_on_133(loan, made);
    when made > @1996-08-20;
    when loan_refinances_133(loan, original);
    when securities_acquisition_loan_133(original);
    when original_timing_ok_133(original);
    when refinancing_meets_requirements_133(loan);
    when refinancing_principal_ok_133(loan);
    when refinancing_term_ok_133(loan);
    then section1602_amendments_inapplicable_133(loan);
}
