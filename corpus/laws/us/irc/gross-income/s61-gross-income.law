// Section 61 — Gross income defined. Stage 1 (IRC-06), DECISION-0379.
//
// §61(a): "gross income means all income from whatever source derived,
// including (but not limited to) the following items" — the fourteen listed
// items are modelled as CLASSIFICATION rules that read a case-asserted
// per-item amount (`gross_income_item`) and the aggregate is a `sum all`
// over the fourteen `GrossIncomeItemKind` values (§111 aggregate-over-
// case-asserted-predicate discipline: `gross_income_item` is asserted
// directly by the case, never itself DERIVED, so the runtime-subset
// limitation on aggregating over derived predicates does not apply here).
//
// The list is illustrative ("including but not limited to"), not exhaustive:
// a taxpayer can have gross income from a source not named in (a)(1)-(14).
// This package does not attempt to enumerate every possible unlisted source;
// an unlisted item is asserted directly as `gross_income_item(p, y,
// UnlistedItem, amount)` with its own `@source` citation to whatever
// provision includes it (case package's job, not this package's).
//
// Items (1)-(14) each have PRODUCERS this package does not own (stage 2 of
// this package for §§71-140 inclusions/exclusions; `property-transactions`
// for §1001 gains; `partnerships` for §702; `trusts-estates` for
// §§652/662/691). Those producers are named as pending dependency contracts
// below; until they exist, the amount of each item is a CASE FACT the
// scenario asserts directly (`gross_income_item(...)`), which is why every
// item rule here is a trivial "the asserted amount classifies as this item"
// rule rather than a computation.

use self::{
    IRC_S61_A,
};

type Person = us.irc.core::Person;
type Individual = us.irc.core::Individual;
type TaxableYear = us.irc.core::TaxableYear;

const Secretary: us.irc.core::Organ = us.irc.core::Secretary;

// --- §61(a): the fourteen items -----------------------------------------------

pub enum GrossIncomeItemKind {
    CompensationForServices;      // (a)(1)
    BusinessGrossIncome;          // (a)(2)
    GainsFromDealingsInProperty;  // (a)(3)
    Interest;                     // (a)(4)
    Rents;                        // (a)(5)
    Royalties;                    // (a)(6)
    Dividends;                    // (a)(7)
    Annuities;                    // (a)(8)
    LifeInsuranceAndEndowment;    // (a)(9)
    Pensions;                     // (a)(10)
    DischargeOfIndebtedness;      // (a)(11)
    DistributiveShareOfPartnershipGrossIncome; // (a)(12)
    IncomeInRespectOfDecedent;    // (a)(13)
    IncomeFromEstateOrTrustInterest; // (a)(14)
}

// Case-asserted per-item amount for a taxable year. `kind empirical`: this
// stage does not own the producing sections (§§71-140, §1001, §702,
// §§652/662/691) that would DERIVE these amounts; a case package asserts
// them directly, with its own `@source` to the producing provision.
pub relation gross_income_item(p: Person, y: TaxableYear, item: GrossIncomeItemKind, amount: Money) kind empirical {
    label en official "an item of gross income under section 61(a)";
}

pub relation gross_income(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "gross income (section 61)";
}

// Every `GrossIncomeItemKind` value is itself the executable classification:
// a case fact `gross_income_item(p, y, <kind>, amount)` IS, by the
// declaration above, an item of gross income under the matching paragraph
// of section 61(a) — no separate per-paragraph rule restates that (a rule
// whose body and head are the SAME predicate is a dependency cycle the
// engine rejects as unstratifiable, LDC-E4102, and adds no content beyond
// the relation's own label). The disposition for each of the fourteen
// paragraphs is recorded in the coverage rows against this relation
// declaration and against `GrossIncomeAggregate` below, which is the
// executable content: the sum.

@source(IRC_S61_A)
rule GrossIncomeAggregate(p: Person, y: TaxableYear, item0: GrossIncomeItemKind, amount0: Money) strict {
    label en official "gross income is the sum of all items of gross income for the taxable year";
    when gross_income_item(p, y, item0, amount0);
    then gross_income(p, y,
        sum all amount: Money for item: GrossIncomeItemKind where gross_income_item(p, y, item, amount));
}

// A taxpayer with NO asserted item has zero gross income (not UNDETERMINED —
// absence of any item fact is itself informative once at least one taxable
// year/person pairing is in scope for the case; left to the case package to
// assert `gross_income(p, y, 0.00 USD)` directly when that is the intended
// fact, since a universally-quantified "no item exists" antecedent is not
// expressible as a `when` guard here without an unsound negation over an
// open per-item enumeration).

// --- §61(b): cross references (non-normative) ---------------------------------
//
// "For items specifically included in gross income, see part II (sec. 71 and
// following). For items specifically excluded from gross income, see part
// III (sec. 101 and following)." A pure navigation aid: it enacts no rule of
// its own, and the sections it points to are this package's own stage 2
// (inclusions/exclusions §§71-140). classification = NON_NORMATIVE.
