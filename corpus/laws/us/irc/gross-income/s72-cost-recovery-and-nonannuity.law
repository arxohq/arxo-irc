// Section 72(c)-(h), (j), (l), (n) — cost recovery and amounts not received
// as annuities. Stage 2e (IRC-06), DECISION-0379. STATUS: implemented_unverified
// (static check only; scenarios in tests/s72-cost-recovery.lawtest are NOT executed).
//
// Scope of this module:
//   (c)(1)  investment in the contract (premiums minus excluded prior receipts)
//   (c)(2)  refund-feature adjustment (actuarial value taken as a case fact)
//   (c)(3)  expected return, installment branch (sum of amounts receivable)
//   (c)(4)  annuity starting date (earliest period start; G136 candidate idiom)
//   (d)(1)  simplified method: anticipated-payments tables, age-75 exception,
//           per-payment exclusion capped by unrecovered investment
//   (e)(1)-(6),(8),(10),(11)  amounts not received as an annuity
//   (f), (g)(1),(3), (h), (j), (l), (n)
//
// Actuarial tables prescribed by the Secretary ((c)(2), (c)(3)(A)) are an
// EXTERNAL_DEPENDENCY: their RESULT enters as a case fact.
//
// Deontics: §72(h) option to take an annuity in lieu of a lump sum is a
// `power` of the contract holder (exercise within 60 days, valid_when the
// window helper) whose effect is that the lump sum is not includible when it
// first became payable.

// =====================================================================
// §72(c)(1): investment in the contract
// =====================================================================

use self::{
    AnnuityContract,
    IRC_S72_A,
    IRC_S72_C,
    IRC_S72_D,
    IRC_S72_E,
    IRC_S72_F,
    IRC_S72_G,
    IRC_S72_M,
    IRC_S72_TABLE_1,
    IRC_S72_TABLE_2,
    Individual,
    TaxableYear,
    aggregate_premiums_adjusted_72m2,
    amounts_received_after_19861231_before_this_receipt_72e8D,
    burial_contract_pledge_exception_72e10b,
    consideration_taken_into_account_72g1,
    employer_contribution_counts_as_consideration_72f,
    excludable_receipts_counted_for_transferee_72g2,
    investment_in_contract_as_of_19861231_72e8D,
    lump_sum_taxed_as_received_before_starting_date_72d1D,
    plan_permitted_withdrawal_of_employee_contributions_on_19860505_72e8D,
    pro_rata_rule_of_72e8A_applies_72e8D,
    retained_premium_excluded_from_e2Bi_72e4B,
    unrecovered_investment_in_contract,
};

pub relation premiums_paid_for_contract(p: Individual, contract: AnnuityContract, amount: Money) kind empirical {
    label en official "the aggregate amount of premiums or other consideration paid for the contract (section 72(c)(1)(A)), after the section 72(f) employer-contribution and section 72(g) transferee adjustments have been applied by the case or by the rules of this module";
}
pub relation excludable_receipts_before_starting_date(p: Individual, contract: AnnuityContract, amount: Money) kind empirical {
    label en official "the aggregate amount received under the contract before the annuity starting date, to the extent excludable from gross income under this subtitle or prior income tax laws (section 72(c)(1)(B))";
}
pub relation investment_in_contract_72c1(p: Individual, contract: AnnuityContract, amount: Money) kind institutional {
    label en official "the investment in the contract as of the annuity starting date, determined under section 72(c)(1) (without regard to the (c)(2) refund-feature adjustment)";
}
@source(IRC_S72_C, relation = formalizes, coverage = partial, quote = "the investment in the contract as of the annuity starting date is—")
rule InvestmentInContractComputed(p: Individual, contract: AnnuityContract, premiums: Money, excluded: Money) strict {
    label en official "section 72(c)(1): premiums or other consideration paid, minus the amounts received before the starting date that were excludable";
    when premiums_paid_for_contract(p, contract, premiums);
    when excludable_receipts_before_starting_date(p, contract, excluded);
    then investment_in_contract_72c1(p, contract, round(premiums - excluded, 2, "HALF_UP"));
}

// =====================================================================
// §72(c)(2): refund feature
// =====================================================================

relation expected_return_depends_on_life_expectancy(contract: AnnuityContract) kind empirical {
    label en official "the expected return under the contract depends in whole or in part on the life expectancy of one or more individuals (section 72(c)(2)(A))";
}
relation contract_pays_beneficiary_on_death(contract: AnnuityContract) kind empirical {
    label en official "the contract provides for payments to a beneficiary (or the estate of an annuitant) on or after the death of the annuitant or annuitants (section 72(c)(2)(B))";
}
relation death_payments_in_nature_of_refund(contract: AnnuityContract) kind empirical {
    label en official "such payments are in the nature of a refund of the consideration paid (section 72(c)(2)(C)), including the life-annuity-with-period-certain provision, and, for employer-contributed contracts, only the part attributable to the employee's consideration";
}
relation refund_feature_value_at_starting_date(contract: AnnuityContract, value: Money) kind empirical {
    label en official "the value, computed without discount for interest, of such refund payments on the annuity starting date, computed under the actuarial tables prescribed by the Secretary (EXTERNAL_DEPENDENCY: the tables are not carried; their result is a case fact)";
}
pub relation investment_in_contract_after_refund_adjustment(p: Individual, contract: AnnuityContract, amount: Money) kind institutional {
    label en official "the investment in the contract after subtracting the value of the refund feature (section 72(c)(2)) — the amount used in the section 72(b) exclusion ratio when the refund feature exists";
}
@source(IRC_S72_C, relation = formalizes, coverage = partial, quote = "then the value (computed without discount for interest) of such payments on the annuity starting date shall be subtracted from the amount determined under paragraph (1).")
rule RefundFeatureAdjustsInvestment(p: Individual, contract: AnnuityContract, inv: Money, value: Money) strict {
    label en official "section 72(c)(2): with a life-expectancy-dependent contract whose death payments are a refund of consideration, the refund value is subtracted from the (c)(1) investment";
    when expected_return_depends_on_life_expectancy(contract);
    when contract_pays_beneficiary_on_death(contract);
    when death_payments_in_nature_of_refund(contract);
    when investment_in_contract_72c1(p, contract, inv);
    when refund_feature_value_at_starting_date(contract, value);
    then investment_in_contract_after_refund_adjustment(p, contract, round(inv - value, 2, "HALF_UP"));
}

// =====================================================================
// §72(c)(3)(B): expected return, installment payments
// =====================================================================

relation amount_receivable_as_annuity(contract: AnnuityContract, seq: Integer, amount: Money) kind empirical {
    label en official "the seq-th amount receivable under the contract as an annuity (section 72(c)(3)(B)); one fact per scheduled payment";
}
pub relation expected_return_installment(contract: AnnuityContract, amount: Money) kind institutional {
    label en official "the expected return where it does not depend on life expectancy: the aggregate of the amounts receivable under the contract as an annuity (section 72(c)(3)(B))";
}
@source(IRC_S72_C, relation = formalizes, coverage = partial, quote = "the expected return is the aggregate of the amounts receivable under the contract as an annuity.")
rule ExpectedReturnInstallmentBranch(contract: AnnuityContract, seq0: Integer, amount0: Money) strict {
    label en official "section 72(c)(3)(B): when (A) does not apply, the expected return is the sum of the scheduled annuity amounts";
    when amount_receivable_as_annuity(contract, seq0, amount0);
    when not_known(expected_return_depends_on_life_expectancy(contract));
    then expected_return_installment(contract,
        sum all amount: Money for seq: Integer where amount_receivable_as_annuity(contract, seq, amount));
}

// =====================================================================
// §72(c)(4) and §72(g)(3): annuity starting date
// =====================================================================

relation annuity_period_start(contract: AnnuityContract, start: Date) kind empirical {
    label en official "the first day of a period for which an amount is received as an annuity under the contract (section 72(c)(4)); one fact per period";
}
relation has_earlier_annuity_period_start(contract: AnnuityContract, start: Date) kind institutional {
    label en official "helper: another annuity period of the same contract begins strictly earlier (TECH-GAPS G136 candidate idiom for earliest-of-several-dates)";
}
rule EarlierAnnuityPeriodExists(contract: AnnuityContract, start: Date, other: Date) strict {
    label en official "helper for the earliest-date selection in AnnuityStartingDateIsEarliestPeriodStart";
    when annuity_period_start(contract, start);
    when annuity_period_start(contract, other);
    when other < start;
    then has_earlier_annuity_period_start(contract, start);
}
pub relation annuity_starting_date_72c4(contract: AnnuityContract, on: Date) kind institutional {
    label en official "the annuity starting date: the first day of the first period for which an amount is received as an annuity under the contract (section 72(c)(4)); for a transferee for value, section 72(g)(3) reads the same over the transferee's receipts";
}
@source(IRC_S72_C, relation = formalizes, coverage = exact, quote = "the annuity starting date in the case of any contract is the first day of the first period for which an amount is received as an annuity under the contract.")
@source(IRC_S72_G, relation = formalizes, coverage = partial, quote = "the annuity starting date is the first day of the first period for which the transferee received an amount under the contract as an annuity.")
rule AnnuityStartingDateIsEarliestPeriodStart(contract: AnnuityContract, start: Date) strict {
    label en official "section 72(c)(4): the earliest period start among the contract's annuity periods";
    when annuity_period_start(contract, start);
    when not_known(has_earlier_annuity_period_start(contract, start));
    then annuity_starting_date_72c4(contract, start);
}

// =====================================================================
// §72(d)(1): simplified method for qualified employer retirement plans
// =====================================================================

pub relation annuity_under_qualified_employer_retirement_plan(p: Individual, contract: AnnuityContract) kind empirical {
    label en official "the amount is received as an annuity under a qualified employer retirement plan: a plan or contract described in paragraph (1), (2), or (3) of section 4974(c) (section 72(d)(1)(A), (G))";
}
relation primary_annuitant_age_at_starting_date(contract: AnnuityContract, age: Integer) kind empirical {
    label en official "the age of the primary annuitant on the annuity starting date, in whole years";
}
relation guaranteed_payment_years(contract: AnnuityContract, years: Integer) kind empirical {
    label en official "the number of years of guaranteed payments under the annuity";
}
relation simplified_method_excepted_72d1e(contract: AnnuityContract) kind institutional {
    label en official "the (d)(1)(E) exception: the primary annuitant has attained age 75 on the annuity starting date and there are fewer than 5 years of guaranteed payments";
}
@source(IRC_S72_D, relation = formalizes, coverage = exact, quote = "This paragraph shall not apply in any case where the primary annuitant has attained age 75 on the annuity starting date unless there are fewer than 5 years of guaranteed payments under the annuity.")
rule SimplifiedMethodExceptionAge75(contract: AnnuityContract, age: Integer, years: Integer) strict {
    label en official "section 72(d)(1)(E): paragraph (1) does not apply where the primary annuitant is 75 or older at the starting date unless fewer than 5 guaranteed-payment years exist; the excepted case is age 75 or more with at least 5 years of guaranteed payments";
    when primary_annuitant_age_at_starting_date(contract, age);
    when guaranteed_payment_years(contract, years);
    when age >= 75;
    when years >= 5;
    then simplified_method_excepted_72d1e(contract);
}
pub relation simplified_method_applies_72d1(p: Individual, contract: AnnuityContract) kind institutional {
    label en official "section 72(b) is displaced and the (d)(1) simplified method governs the annuity";
}
@source(IRC_S72_D, relation = formalizes, coverage = partial, quote = "In the case of any amount received as an annuity under a qualified employer retirement plan—\n(i) subsection (b) shall not apply, and\n(ii) the investment in the contract shall be recovered as provided in this paragraph.")
rule SimplifiedMethodApplies(p: Individual, contract: AnnuityContract) strict {
    label en official "section 72(d)(1)(A): for a qualified employer retirement plan annuity, subsection (b) does not apply and the simplified method does, unless the (E) exception applies";
    when annuity_under_qualified_employer_retirement_plan(p, contract);
    when not_known(simplified_method_excepted_72d1e(contract));
    then simplified_method_applies_72d1(p, contract);
}

relation annuitant_age_single_life(contract: AnnuityContract, age: Integer) kind empirical {
    label en official "the annuity is payable over the life of a single individual whose age at the annuity starting date is this value (section 72(d)(1)(B)(iii))";
}
relation annuitants_combined_age(contract: AnnuityContract, age: Integer) kind empirical {
    label en official "the annuity is payable over the lives of more than one individual whose combined ages at the annuity starting date are this value (section 72(d)(1)(B)(iv))";
}
pub relation anticipated_payments_72d1(contract: AnnuityContract, n: Integer) kind institutional {
    label en official "the number of anticipated monthly payments under the section 72(d)(1)(B)(iii)/(iv) tables";
}
@source(IRC_S72_TABLE_1, relation = formalizes, coverage = exact)
rule AnticipatedPaymentsSingleLifeAge55OrLess(contract: AnnuityContract, age: Integer) strict {
    label en official "table 1: not more than 55 -> 360";
    when annuitant_age_single_life(contract, age);
    when age <= 55;
    then anticipated_payments_72d1(contract, 360);
}
@source(IRC_S72_TABLE_1, relation = formalizes, coverage = exact)
rule AnticipatedPaymentsSingleLifeAge56To60(contract: AnnuityContract, age: Integer) strict {
    label en official "table 1: more than 55 but not more than 60 -> 310";
    when annuitant_age_single_life(contract, age);
    when age > 55;
    when age <= 60;
    then anticipated_payments_72d1(contract, 310);
}
@source(IRC_S72_TABLE_1, relation = formalizes, coverage = exact)
rule AnticipatedPaymentsSingleLifeAge61To65(contract: AnnuityContract, age: Integer) strict {
    label en official "table 1: more than 60 but not more than 65 -> 260";
    when annuitant_age_single_life(contract, age);
    when age > 60;
    when age <= 65;
    then anticipated_payments_72d1(contract, 260);
}
@source(IRC_S72_TABLE_1, relation = formalizes, coverage = exact)
rule AnticipatedPaymentsSingleLifeAge66To70(contract: AnnuityContract, age: Integer) strict {
    label en official "table 1: more than 65 but not more than 70 -> 210";
    when annuitant_age_single_life(contract, age);
    when age > 65;
    when age <= 70;
    then anticipated_payments_72d1(contract, 210);
}
@source(IRC_S72_TABLE_1, relation = formalizes, coverage = exact)
rule AnticipatedPaymentsSingleLifeAgeOver70(contract: AnnuityContract, age: Integer) strict {
    label en official "table 1: more than 70 -> 160";
    when annuitant_age_single_life(contract, age);
    when age > 70;
    then anticipated_payments_72d1(contract, 160);
}
@source(IRC_S72_TABLE_2, relation = formalizes, coverage = exact)
rule AnticipatedPaymentsJointLivesCombined110OrLess(contract: AnnuityContract, age: Integer) strict {
    label en official "table 2: combined ages not more than 110 -> 410";
    when annuitants_combined_age(contract, age);
    when age <= 110;
    then anticipated_payments_72d1(contract, 410);
}
@source(IRC_S72_TABLE_2, relation = formalizes, coverage = exact)
rule AnticipatedPaymentsJointLivesCombined111To120(contract: AnnuityContract, age: Integer) strict {
    label en official "table 2: more than 110 but not more than 120 -> 360";
    when annuitants_combined_age(contract, age);
    when age > 110;
    when age <= 120;
    then anticipated_payments_72d1(contract, 360);
}
@source(IRC_S72_TABLE_2, relation = formalizes, coverage = exact)
rule AnticipatedPaymentsJointLivesCombined121To130(contract: AnnuityContract, age: Integer) strict {
    label en official "table 2: more than 120 but not more than 130 -> 310";
    when annuitants_combined_age(contract, age);
    when age > 120;
    when age <= 130;
    then anticipated_payments_72d1(contract, 310);
}
@source(IRC_S72_TABLE_2, relation = formalizes, coverage = exact)
rule AnticipatedPaymentsJointLivesCombined131To140(contract: AnnuityContract, age: Integer) strict {
    label en official "table 2: more than 130 but not more than 140 -> 260";
    when annuitants_combined_age(contract, age);
    when age > 130;
    when age <= 140;
    then anticipated_payments_72d1(contract, 260);
}
@source(IRC_S72_TABLE_2, relation = formalizes, coverage = exact)
rule AnticipatedPaymentsJointLivesCombinedOver140(contract: AnnuityContract, age: Integer) strict {
    label en official "table 2: more than 140 -> 210";
    when annuitants_combined_age(contract, age);
    when age > 140;
    then anticipated_payments_72d1(contract, 210);
}

pub relation simplified_method_monthly_exclusion(p: Individual, contract: AnnuityContract, amount: Money) kind institutional {
    label en official "the monthly amount excludable from gross income under the section 72(d)(1)(B)(i) simplified method: investment in the contract divided by the number of anticipated payments";
}
@source(IRC_S72_D, relation = formalizes, coverage = partial, quote = "Gross income shall not include so much of any monthly annuity payment under a qualified employer retirement plan as does not exceed the amount obtained by dividing—")
rule SimplifiedMethodMonthlyExclusion(p: Individual, contract: AnnuityContract, inv: Money, n: Integer) strict {
    label en official "section 72(d)(1)(B)(i) and (C): investment in the contract determined under (c)(1) WITHOUT the (c)(2) refund adjustment, divided by the anticipated number of payments";
    when simplified_method_applies_72d1(p, contract);
    when investment_in_contract_72c1(p, contract, inv);
    when anticipated_payments_72d1(contract, n);
    then simplified_method_monthly_exclusion(p, contract, round(inv * (1 / n), 2, "HALF_UP"));
}
relation monthly_annuity_payment(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, amount: Money) kind empirical {
    label en official "a monthly annuity payment under the contract received on the given date";
}
pub relation simplified_method_excluded_amount(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, amount: Money) kind institutional {
    label en official "the part of a monthly payment excluded under the simplified method: not more than the monthly exclusion, and (rules similar to (b)(2)) not more than the unrecovered investment";
}
@source(IRC_S72_D, relation = formalizes, coverage = partial, quote = "Rules similar to the rules of paragraphs (2) and (3) of subsection (b) shall apply for purposes of this paragraph.")
rule SimplifiedMethodExcludedAmount(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, payment: Money, monthly: Money, unrecovered: Money) strict {
    label en official "section 72(d)(1)(B)(i)-(ii): min(payment, monthly exclusion, unrecovered investment)";
    when monthly_annuity_payment(p, contract, y, on, payment);
    when simplified_method_monthly_exclusion(p, contract, monthly);
    when unrecovered_investment_in_contract(p, contract, on, unrecovered);
    then simplified_method_excluded_amount(p, contract, y, on, min(payment, min(monthly, unrecovered)));
}
pub relation simplified_method_includible_amount(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, amount: Money) kind institutional {
    label en official "the part of a monthly payment under the simplified method that is includible in gross income under section 72(a) (payment minus the excluded part)";
}
@source(IRC_S72_A, relation = formalizes, coverage = partial, quote = "gross income includes any amount received as an annuity")
rule SimplifiedMethodIncludibleAmount(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, payment: Money, excluded: Money) strict {
    label en official "the (d)(1) method changes only what is excluded; the remainder of the payment is included under (a)";
    when monthly_annuity_payment(p, contract, y, on, payment);
    when simplified_method_excluded_amount(p, contract, y, on, excluded);
    then simplified_method_includible_amount(p, contract, y, on, round(payment - excluded, 2, "HALF_UP"));
}

// =====================================================================
// §72(e): amounts not received as an annuity
// =====================================================================

pub relation amount_received_not_as_annuity(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, amount: Money) kind empirical {
    label en official "an amount received under an annuity, endowment, or life insurance contract that is not received as an annuity (section 72(e)(1)(A)(i)-(ii)), on the given date";
}
relation other_subtitle_provision_applies(p: Individual, contract: AnnuityContract, on: Date) kind empirical {
    label en official "a provision of this subtitle other than section 72(e) applies with respect to the amount (section 72(e)(1)(A), last clause) — subsection (e) then does not apply";
}
relation amount_in_nature_of_dividend(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, amount: Money) kind empirical {
    label en official "an amount received in the nature of a dividend or similar distribution, treated as not received as an annuity (section 72(e)(1)(B))";
}
pub relation subsection_e_applies(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, amount: Money) kind institutional {
    label en official "section 72(e) applies to this amount";
}
@source(IRC_S72_E, relation = formalizes, coverage = partial, quote = "if no provision of this subtitle (other than this subsection) applies with respect to such amount.")
rule SubsectionEAppliesToNonAnnuityAmount(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, amount: Money) strict {
    label en official "section 72(e)(1)(A): amount received under the contract, not as an annuity, no other provision applies";
    when amount_received_not_as_annuity(p, contract, y, on, amount);
    when not_known(other_subtitle_provision_applies(p, contract, on));
    then subsection_e_applies(p, contract, y, on, amount);
}
@source(IRC_S72_E, relation = formalizes, coverage = partial, quote = "any amount received which is in the nature of a dividend or similar distribution shall be treated as an amount not received as an annuity.")
rule SubsectionEAppliesToDividends(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, amount: Money) strict {
    label en official "section 72(e)(1)(B): dividends and similar distributions are amounts not received as an annuity";
    when amount_in_nature_of_dividend(p, contract, y, on, amount);
    when not_known(other_subtitle_provision_applies(p, contract, on));
    then subsection_e_applies(p, contract, y, on, amount);
}

// (e)(6): investment in the contract as of a date
relation premiums_paid_before_date(p: Individual, contract: AnnuityContract, on: Date, amount: Money) kind empirical {
    label en official "the aggregate premiums or other consideration paid for the contract before the date (section 72(e)(6)(A))";
}
relation excludable_receipts_before_date(p: Individual, contract: AnnuityContract, on: Date, amount: Money) kind empirical {
    label en official "the aggregate amount received under the contract before the date, to the extent excludable from gross income under this subtitle or prior income tax laws (section 72(e)(6)(B))";
}
pub relation investment_in_contract_72e6(p: Individual, contract: AnnuityContract, on: Date, amount: Money) kind institutional {
    label en official "the investment in the contract as of the date, for purposes of section 72(e)";
}
@source(IRC_S72_E, relation = formalizes, coverage = partial, quote = "the investment in the contract as of any date is—")
rule InvestmentInContractAsOfDate(p: Individual, contract: AnnuityContract, on: Date, premiums: Money, excluded: Money) strict {
    label en official "section 72(e)(6): premiums paid before the date minus excludable receipts before the date";
    when premiums_paid_before_date(p, contract, on, premiums);
    when excludable_receipts_before_date(p, contract, on, excluded);
    when not_known(has_transferee_consideration_72g1(p, contract)); // G6404 wiring: §72(g)(1) — variant below
    when not_known(has_employer_contribution_consideration_72f(p, contract)); // G6404 wiring: §72(f) — variant below
    when not_known(has_premium_adjustment_72m2(p, contract)); // G6404 wiring: §72(m)(2) — variant below
    then investment_in_contract_72e6(p, contract, on, round(premiums - excluded, 2, "HALF_UP"));
}
// G6404 wiring: the investment in the contract read from the derived consideration rules of §72(f), (g), (m)(2).
// JUDGMENT CALL: the three variants are mutually exclusive (each is guarded by the helpers of the other two, and the
// base rule by all three), so a contract that meets two of them gets no investment conclusion (NEITHER) rather than
// a silently chosen one; the case names the combined figure itself.
relation has_transferee_consideration_72g1(p: Individual, contract: AnnuityContract) kind institutional {
    label en official "the consideration of a transferee for value is taken into account under section 72(g)(1)";
}
rule HasTransfereeConsideration72g1(p: Individual, contract: AnnuityContract, amount: Money) strict {
    when consideration_taken_into_account_72g1(p, contract, amount);
    then has_transferee_consideration_72g1(p, contract);
}
relation has_employer_contribution_consideration_72f(p: Individual, contract: AnnuityContract) kind institutional {
    label en official "an employer contribution counts as consideration paid by the employee under section 72(f)";
}
rule HasEmployerContributionConsideration72f(p: Individual, contract: AnnuityContract, seq: Integer, amount: Money) strict {
    when employer_contribution_counts_as_consideration_72f(p, contract, seq, amount);
    then has_employer_contribution_consideration_72f(p, contract);
}
relation has_premium_adjustment_72m2(p: Individual, contract: AnnuityContract) kind institutional {
    label en official "the aggregate premiums are adjusted under section 72(m)(2)";
}
rule HasPremiumAdjustment72m2(p: Individual, contract: AnnuityContract, amount: Money) strict {
    when aggregate_premiums_adjusted_72m2(p, contract, amount);
    then has_premium_adjustment_72m2(p, contract);
}
@source(IRC_S72_G, relation = formalizes, coverage = exact, quote = "only the actual value of such consideration, plus the amount of the premiums and other consideration paid by the transferee after the transfer, shall be taken into account")
rule InvestmentInContractOfTransfereeForValue(p: Individual, contract: AnnuityContract, on: Date, consideration: Money, received: Money) strict {
    label en official "section 72(g)(1)-(2) with (e)(6): the transferee's investment is the consideration taken into account less the excludable receipts counted for the transferee";
    when consideration_taken_into_account_72g1(p, contract, consideration);
    when excludable_receipts_counted_for_transferee_72g2(p, contract, received);
    when excludable_receipts_before_date(p, contract, on, _);
    when not_known(has_employer_contribution_consideration_72f(p, contract));
    when not_known(has_premium_adjustment_72m2(p, contract));
    then investment_in_contract_72e6(p, contract, on, max(0.00 USD, round(consideration - received, 2, "HALF_UP")));
}
@source(IRC_S72_F, relation = formalizes, coverage = partial, quote = "(1) such amounts were includible in the gross income of the employee under this subtitle or prior income tax laws; or")
rule InvestmentInContractWithEmployerContributions(p: Individual, contract: AnnuityContract, on: Date, premiums: Money, excluded: Money) strict {
    label en official "section 72(f) with (e)(6): the employer contributions that count as consideration are added to the premiums paid";
    when premiums_paid_before_date(p, contract, on, premiums);
    when excludable_receipts_before_date(p, contract, on, excluded);
    when has_employer_contribution_consideration_72f(p, contract);
    when not_known(has_transferee_consideration_72g1(p, contract));
    when not_known(has_premium_adjustment_72m2(p, contract));
    then investment_in_contract_72e6(p, contract, on, round(premiums + sum(collect all a: Money, s: Integer where employer_contribution_counts_as_consideration_72f(p, contract, s, a), empty: 0.00 USD) - excluded, 2, "HALF_UP"));
}
@source(IRC_S72_M, relation = formalizes, coverage = exact, quote = "In computing—")
rule InvestmentInContractWithAdjustedPremiums(p: Individual, contract: AnnuityContract, on: Date, adjusted: Money, excluded: Money) strict {
    label en official "section 72(m)(2) with (e)(6): the aggregate premiums adjusted for self-employed deductions and life, accident or health premiums";
    when aggregate_premiums_adjusted_72m2(p, contract, adjusted);
    when excludable_receipts_before_date(p, contract, on, excluded);
    when not_known(has_transferee_consideration_72g1(p, contract));
    when not_known(has_employer_contribution_consideration_72f(p, contract));
    then investment_in_contract_72e6(p, contract, on, round(adjusted - excluded, 2, "HALF_UP"));
}

// regime flags for the retention rules of (e)(5) and the extensions of (e)(8),(10)
relation contract_entered_before_19820814(contract: AnnuityContract) kind empirical {
    label en official "the contract was entered into before August 14, 1982 (section 72(e)(5)(B))";
}
relation life_insurance_or_endowment_contract(contract: AnnuityContract) kind empirical {
    label en official "the contract is a life insurance or endowment contract (section 72(e)(5)(C))";
}
relation modified_endowment_contract(contract: AnnuityContract) kind empirical {
    label en official "the contract is a modified endowment contract as defined in section 7702A, asserted by the case (section 72(e)(10)); the section 7702A test itself is derived by us.irc.definitions and read through modified_endowment_contract_effective";
}
// Stage 3 wiring (26.09.2026): the AnnuityContract of section 72 and the InsuranceContract of
// section 7702 are the same real contract; the case links them and the section 7702A result of the
// definitions package is read here. An asserted flag is still accepted.
relation annuity_contract_is_insurance_contract(contract: AnnuityContract, ins: us.irc.definitions::InsuranceContract) kind empirical {
    label en official "the section 72 contract is the section 7702 insurance contract (identity link supplied by the case)";
}
relation modified_endowment_contract_effective(contract: AnnuityContract) kind institutional {
    label en official "the contract is a modified endowment contract: asserted by the case or derived by the section 7702A test of us.irc.definitions (section 72(e)(10))";
}
rule ModifiedEndowmentContractAsserted(contract: AnnuityContract) strict {
    label en official "section 72(e)(10), asserted by the case";
    when modified_endowment_contract(contract);
    then modified_endowment_contract_effective(contract);
}
rule ModifiedEndowmentContractFromSection7702A(contract: AnnuityContract, ins: us.irc.definitions::InsuranceContract) strict {
    label en official "section 72(e)(10) with section 7702A";
    when annuity_contract_is_insurance_contract(contract, ins) and us.irc.definitions::modified_endowment_contract_7702a(ins);
    then modified_endowment_contract_effective(contract);
}
relation contract_described_in_72e5d(contract: AnnuityContract) kind empirical {
    label en official "the amount is received from a trust described in section 401(a) exempt under section 501(a), from a contract purchased by such a trust or under section 403(a), described in section 403(b), provided for employees of a life insurance company under section 818(a)(3), or from an individual retirement account or annuity (section 72(e)(5)(D))";
}
relation received_in_full_discharge_or_surrender(p: Individual, contract: AnnuityContract, on: Date) kind empirical {
    label en official "the amount is received under the contract in full discharge of a refund-type obligation, or on complete surrender, redemption, or maturity (section 72(e)(5)(E))";
}
relation retained_rules_apply_72e5(contract: AnnuityContract) kind institutional {
    label en official "the section 72(e)(5) retention of existing rules applies to the contract by reason of (B) or (C) (not by reason of (D), which section 72(e)(8) reverses for pre-starting-date receipts, nor of (E), which is tested per receipt)";
}
@source(IRC_S72_E, relation = formalizes, coverage = partial, quote = "This paragraph shall apply to contracts entered into before August 14, 1982.")
rule RetainedRulesByEntryDate(contract: AnnuityContract) strict {
    label en official "section 72(e)(5)(B)";
    when contract_entered_before_19820814(contract);
    then retained_rules_apply_72e5(contract);
}
@source(IRC_S72_E, relation = formalizes, coverage = partial, quote = "this paragraph shall apply to any amount not received as an annuity which is received under a life insurance or endowment contract.")
rule RetainedRulesLifeInsuranceNotMec(contract: AnnuityContract) strict {
    label en official "section 72(e)(5)(C), subject to the (e)(10) modified endowment contract override";
    when life_insurance_or_endowment_contract(contract);
    when not_known(modified_endowment_contract_effective(contract));
    then retained_rules_apply_72e5(contract);
}

pub relation nonannuity_amount_includible_72e(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, amount: Money) kind institutional {
    label en official "the part of an amount not received as an annuity that is included in gross income under section 72(e)";
}
// (2)(A) with the (5)(E) carve-out
@source(IRC_S72_E, relation = formalizes, coverage = exact, quote = "(A) if received on or after the annuity starting date, shall be included in gross income, or")
rule NonAnnuityOnOrAfterStartingDateIncluded(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, amount: Money, asd: Date) strict {
    label en official "section 72(e)(2)(A): an amount received on or after the annuity starting date is included in full — except a (5)(E) full-discharge/surrender amount, for which (2)(A) does not apply";
    when subsection_e_applies(p, contract, y, on, amount);
    when annuity_starting_date_72c4(contract, asd);
    when on >= asd;
    when not_known(received_in_full_discharge_or_surrender(p, contract, on));
    then nonannuity_amount_includible_72e(p, contract, y, on, amount);
}
// (5)(E): full discharge or surrender -> only the excess over investment
@source(IRC_S72_E, relation = formalizes, coverage = exact, quote = "any amount received under a contract on its complete surrender, redemption, or maturity.")
rule NonAnnuityFullSurrenderExcessOverInvestment(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, amount: Money, inv: Money) strict {
    label en official "section 72(e)(5)(A)(ii) with (5)(E): on complete surrender, redemption or maturity (or full discharge of a refund obligation) the amount is included only to the extent it exceeds the investment in the contract";
    when subsection_e_applies(p, contract, y, on, amount);
    when received_in_full_discharge_or_surrender(p, contract, on);
    when investment_in_contract_72e6(p, contract, on, inv);
    when amount > inv;
    then nonannuity_amount_includible_72e(p, contract, y, on, round(amount - inv, 2, "HALF_UP"));
}
@source(IRC_S72_E, relation = formalizes, coverage = exact, quote = "the amount shall be included in gross income, but only to the extent it exceeds the investment in the contract.")
rule NonAnnuityFullSurrenderNoExcess(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, amount: Money, inv: Money) strict {
    label en official "section 72(e)(5)(A)(ii) with (5)(E): a surrender amount not exceeding the investment is not included (explicit zero)";
    when subsection_e_applies(p, contract, y, on, amount);
    when received_in_full_discharge_or_surrender(p, contract, on);
    when investment_in_contract_72e6(p, contract, on, inv);
    when amount <= inv;
    then nonannuity_amount_includible_72e(p, contract, y, on, 0.00 USD);
}

relation annuity_starting_date_known(contract: AnnuityContract) kind institutional {
    label en official "helper: the contract has a derivable annuity starting date (some annuity period is on record)";
}
rule AnnuityStartingDateKnownHelper(contract: AnnuityContract, asd: Date) strict {
    label en official "helper";
    when annuity_starting_date_72c4(contract, asd);
    then annuity_starting_date_known(contract);
}
pub relation receipt_before_starting_date(p: Individual, contract: AnnuityContract, on: Date) kind institutional {
    label en official "the amount is received before the annuity starting date; a contract with no annuity starting date on record (never annuitized) has every receipt before it (section 72(e)(2)(B))";
}
rule ReceiptBeforeStartingDateByDate(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, asd: Date) strict {
    label en official "section 72(e)(2)(B): receipt strictly before the starting date";
    when subsection_e_applies(p, contract, y, on, _);
    when annuity_starting_date_72c4(contract, asd);
    when on < asd;
    then receipt_before_starting_date(p, contract, on);
}
rule ReceiptBeforeStartingDateNoStartingDate(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date) strict {
    label en official "section 72(e)(2)(B): no annuity starting date exists, so the receipt precedes it";
    when subsection_e_applies(p, contract, y, on, _);
    when not_known(annuity_starting_date_known(contract));
    then receipt_before_starting_date(p, contract, on);
}

// before the starting date: general rule (2)(B)/(3)
relation cash_value_before_receipt(p: Individual, contract: AnnuityContract, on: Date, amount: Money) kind empirical {
    label en official "the cash value of the contract, determined without regard to any surrender charge, immediately before the amount is received (section 72(e)(3)(A)(i))";
}
pub relation allocable_to_income_72e3(p: Individual, contract: AnnuityContract, on: Date, amount: Money) kind institutional {
    label en official "the part of an amount received before the starting date that is treated as allocable to income on the contract under section 72(e)(3)(A)";
}
relation before_starting_date_general_regime(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, amount: Money) kind institutional {
    label en official "helper: an amount received before the annuity starting date under the general regime of (2)(B)/(3) (neither the (5) retention rules nor the (8) qualified-plan rule governs it)";
}
rule BeforeStartingDateGeneralRegime(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, amount: Money) strict {
    label en official "helper for section 72(e)(2)(B)";
    when subsection_e_applies(p, contract, y, on, amount);
    when receipt_before_starting_date(p, contract, on);
    when not_known(retained_rules_apply_72e5(contract));
    when not_known(contract_described_in_72e5d(contract));
    when not_known(received_in_full_discharge_or_surrender(p, contract, on));
    then before_starting_date_general_regime(p, contract, y, on, amount);
}
@source(IRC_S72_E, relation = formalizes, coverage = exact, quote = "Any amount to which this subsection applies shall be treated as allocable to income on the contract to the extent that such amount does not exceed the excess (if any) of—")
rule AllocableToIncomeUpToGain(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, amount: Money, cash: Money, inv: Money) strict {
    label en official "section 72(e)(3)(A): allocable to income up to the excess of cash value over investment; where cash value does not exceed the investment, nothing is allocable to income";
    when before_starting_date_general_regime(p, contract, y, on, amount);
    when cash_value_before_receipt(p, contract, on, cash);
    when investment_in_contract_72e6(p, contract, on, inv);
    then allocable_to_income_72e3(p, contract, on, min(amount, max(0.00 USD, round(cash - inv, 2, "HALF_UP"))));
}
@source(IRC_S72_E, relation = formalizes, coverage = exact, quote = "(i) shall be included in gross income to the extent allocable to income on the contract, and")
rule NonAnnuityBeforeStartingDateIncludesIncomePart(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, amount: Money, income: Money) strict {
    label en official "section 72(e)(2)(B)(i) (investment part is excluded under (B)(ii) and needs no separate conclusion)";
    when before_starting_date_general_regime(p, contract, y, on, amount);
    when allocable_to_income_72e3(p, contract, on, income);
    then nonannuity_amount_includible_72e(p, contract, y, on, income);
}
// (5) retained rules before the starting date: excess over investment
@source(IRC_S72_E, relation = formalizes, coverage = partial, quote = "(ii) if paragraph (2)(A) does not apply,")
rule NonAnnuityRetainedRulesExcessOverInvestment(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, amount: Money, inv: Money) strict {
    label en official "section 72(e)(5)(A): where the retention rules apply and (2)(A) does not (receipt before the starting date), the amount is included only to the extent it exceeds the investment in the contract";
    when subsection_e_applies(p, contract, y, on, amount);
    when retained_rules_apply_72e5(contract);
    when receipt_before_starting_date(p, contract, on);
    when not_known(received_in_full_discharge_or_surrender(p, contract, on));
    when investment_in_contract_72e6(p, contract, on, inv);
    when amount > inv;
    then nonannuity_amount_includible_72e(p, contract, y, on, round(amount - inv, 2, "HALF_UP"));
}
@source(IRC_S72_E, relation = formalizes, coverage = partial, quote = "(i) paragraphs (2)(B) and (4)(A) shall not apply, and")
rule NonAnnuityRetainedRulesNoExcess(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, amount: Money, inv: Money) strict {
    label en official "section 72(e)(5)(A)(i): under the retention rules a pre-starting-date receipt not exceeding investment is not included (explicit zero)";
    when subsection_e_applies(p, contract, y, on, amount);
    when retained_rules_apply_72e5(contract);
    when receipt_before_starting_date(p, contract, on);
    when not_known(received_in_full_discharge_or_surrender(p, contract, on));
    when investment_in_contract_72e6(p, contract, on, inv);
    when amount <= inv;
    then nonannuity_amount_includible_72e(p, contract, y, on, 0.00 USD);
}
// (8): qualified plans before the starting date, pro rata allocation
relation account_balance_72e8(p: Individual, contract: AnnuityContract, on: Date, amount: Money) kind empirical {
    label en official "the account balance under the trust or contract described in section 72(e)(5)(D) at the time of the distribution, excluding amounts to which the employee has no nonforfeitable right (section 72(e)(8)(B)-(C))";
}
@source(IRC_S72_E, relation = formalizes, coverage = partial, quote = "the amount allocated to the investment in the contract shall be the portion of the amount described in subparagraph (A) which bears the same ratio to such amount as the investment in the contract bears to the account balance.")
rule QualifiedPlanBeforeStartingDateProRata(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, amount: Money, inv: Money, balance: Money) strict {
    label en official "section 72(e)(8)(A)-(B): from a (5)(D) trust or contract before the starting date, (2)(B) applies and the investment part is amount x investment / account balance; the rest is included";
    when subsection_e_applies(p, contract, y, on, amount);
    when contract_described_in_72e5d(contract);
    when receipt_before_starting_date(p, contract, on);
    when investment_in_contract_72e6(p, contract, on, inv);
    when account_balance_72e8(p, contract, on, balance);
    when balance > 0.00 USD;
    when not_known(plan_permitted_withdrawal_of_employee_contributions_on_19860505_72e8D(contract)); // G6404 wiring: §72(e)(8)(D) has its own rule below
    then nonannuity_amount_includible_72e(p, contract, y, on, round(amount - amount * (inv / balance), 2, "HALF_UP"));
}
// G6404 wiring, §72(e)(8)(D): for a plan that on May 5, 1986 permitted withdrawal of employee contributions
// before separation from service, the pro rata rule of (A) applies only to the part of the amounts received
// after December 31, 1986 that exceeds the investment in the contract as of that date
// (`pro_rata_rule_of_72e8A_applies_72e8D` is the gate; the part is `min(amount, amount + earlier - investment_1986)`).
// JUDGMENT CALL: the part within the 1986 investment is left to the case (retained rules of (e)(5)), no
// includible amount is concluded for it here.
@source(IRC_S72_E, relation = formalizes, coverage = partial, quote = "the amount allocated to the investment in the contract shall be the portion of the amount described in subparagraph (A) which bears the same ratio to such amount as the investment in the contract bears to the account balance.")
rule QualifiedPlanBeforeStartingDateProRataOnly1986Excess(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, amount: Money, inv: Money, balance: Money, earlier: Money, inv86: Money) strict {
    label en official "section 72(e)(8)(A) and (D): pro rata allocation applies only to the part of the receipt above the investment in the contract as of 31 December 1986";
    when subsection_e_applies(p, contract, y, on, amount);
    when contract_described_in_72e5d(contract);
    when receipt_before_starting_date(p, contract, on);
    when plan_permitted_withdrawal_of_employee_contributions_on_19860505_72e8D(contract);
    when pro_rata_rule_of_72e8A_applies_72e8D(p, contract, on);
    when amounts_received_after_19861231_before_this_receipt_72e8D(p, contract, earlier);
    when investment_in_contract_as_of_19861231_72e8D(p, contract, inv86);
    when investment_in_contract_72e6(p, contract, on, inv);
    when account_balance_72e8(p, contract, on, balance);
    when balance > 0.00 USD;
    when amount + earlier > inv86;
    then nonannuity_amount_includible_72e(p, contract, y, on,
        round(min(amount, amount + earlier - inv86) - min(amount, amount + earlier - inv86) * (inv / balance), 2, "HALF_UP"));
}

// (4)(A): loans and pledges treated as distributions
pub relation contract_loan_or_pledge_received(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, amount: Money) kind empirical {
    label en official "an individual receives (directly or indirectly) an amount as a loan under a contract to which section 72(e) applies, or assigns or pledges (or agrees to) a portion of its value (section 72(e)(4)(A))";
}
@source(IRC_S72_E, relation = formalizes, coverage = partial, quote = "such amount or portion shall be treated as received under the contract as an amount not received as an annuity.")
rule LoanOrPledgeTreatedAsNonAnnuityReceipt(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, amount: Money) strict {
    label en official "section 72(e)(4)(A): the loan/pledge amount is an amount received not as an annuity, subject to (2)(B) — for contracts under the (5) retention rules (4)(A) does not apply (section 72(e)(5)(A)(i)), and for a modified endowment contract it applies to any person ((10)(A)(ii))";
    when contract_loan_or_pledge_received(p, contract, y, on, amount);
    when not_known(retained_rules_apply_72e5(contract));
    when not_known(burial_contract_pledge_exception_72e10b(p, contract, on));
    when not_known(has_retained_premium_72e4B(p, contract, y, on)); // G6404 wiring: §72(e)(4)(B) — rule below reduces the amount
    then subsection_e_applies(p, contract, y, on, amount);
}
// G6404 wiring, §72(e)(4)(B): the part of a loan or pledge retained by the insurer as a premium is not treated as
// received (not included under (e)(2)(B)(i)); the rest is.
relation has_retained_premium_72e4B(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date) kind institutional {
    label en official "part of the loan or pledge is retained by the insurer as a premium (section 72(e)(4)(B))";
}
rule HasRetainedPremium72e4B(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, retained: Money) strict {
    when retained_premium_excluded_from_e2Bi_72e4B(p, contract, y, on, retained);
    then has_retained_premium_72e4B(p, contract, y, on);
}
@source(IRC_S72_E, relation = formalizes, coverage = exact, quote = "Any amount described in paragraph (1)(B) shall not be included in gross income under paragraph (2)(B)(i) to the extent such amount is retained by the insurer as a")
rule LoanOrPledgeTreatedAsNonAnnuityReceiptNetOfRetainedPremium(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, amount: Money, retained: Money) strict {
    label en official "section 72(e)(4)(A) net of the premium retained by the insurer, (4)(B)";
    when contract_loan_or_pledge_received(p, contract, y, on, amount);
    when retained_premium_excluded_from_e2Bi_72e4B(p, contract, y, on, retained);
    when not_known(retained_rules_apply_72e5(contract));
    when not_known(burial_contract_pledge_exception_72e10b(p, contract, on));
    when amount > retained;
    then subsection_e_applies(p, contract, y, on, round(amount - retained, 2, "HALF_UP"));
}
// G6404 wiring, §72(d)(1)(D): a lump sum received in connection with the commencement of annuity payments under a
// qualified employer plan is taxable under (e) as if received before the annuity starting date.
@source(IRC_S72_D, relation = formalizes, coverage = exact, quote = "(i) such payment shall be taxable under subsection (e) as if received before the annuity starting date, and")
rule LumpSumOnCommencementTaxableUnderSubsectionE(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, amount: Money) strict {
    label en official "section 72(d)(1)(D)(i): the lump sum is an amount to which subsection (e) applies";
    when lump_sum_taxed_as_received_before_starting_date_72d1D(p, contract, y, on, amount);
    then subsection_e_applies(p, contract, y, on, amount);
}
@source(IRC_S72_D, relation = formalizes, coverage = exact, quote = "(i) such payment shall be taxable under subsection (e) as if received before the annuity starting date, and")
rule LumpSumOnCommencementIsReceiptBeforeStartingDate(p: Individual, contract: AnnuityContract, y: TaxableYear, on: Date, amount: Money) strict {
    label en official "section 72(d)(1)(D)(i): the receipt is treated as before the annuity starting date";
    when lump_sum_taxed_as_received_before_starting_date_72d1D(p, contract, y, on, amount);
    then receipt_before_starting_date(p, contract, on);
}
