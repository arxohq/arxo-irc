// Section 125 — Cafeteria plans. Stage 2d (IRC-06). Scope: (a) general
// non-inclusion rule, (b)(1)-(2) the HCE/key-employee discrimination tests
// (the 25%-of-total-benefits key-employee test named by the coordinator),
// (d)(1)-(2) the cafeteria-plan definition and its deferred-compensation
// carve-out with the (2)(B)-(D) exceptions, (f)(1)-(3) the qualified-
// benefit definition and its long-term-care/Exchange-plan carve-outs,
// (i)(1) the $2,500 health-FSA salary-reduction cap (statutory base figure;
// the (i)(2) post-2013 COLA-indexed CURRENT value is SOURCE_GAP — no
// `us.irc.inflation_adjustments` pub relation exists yet for section 125(i),
// confirmed by inspection of that package's `package.law`, which has no
// executable content at all), and (j)(1)-(4) the SIMPLE cafeteria plan
// core (nondiscrimination safe harbor, the (3)(A) minimum-contribution
// test, the (4)(A) minimum-eligibility test). NOT reached: (b)(3) (taxable-
// year-of-inclusion timing), (c) (the (b)(1)(B) benefits-discrimination
// definition), (e) (highly-compensated-participant/individual definitions
// — read as case-asserted booleans via the existing `us.irc.definitions`-
// style convention, not derived), (g) (collective-bargaining and health-
// plan/classification nondiscrimination safe harbors beyond (a) already
// covered by taking (b)(1)/(2) as case facts), (h) (qualified-reservist-
// distribution machinery, section 72(t)(2)(G)'s FSA analogue), (i)(2)
// (COLA computation itself), (j)(5)-(7) (eligible-employer size test,
// grace-period continuation, "compensation" cross-reference), (k)-(l)
// (reporting cross-reference, regulatory authority — non_normative).

// =====================================================================
// §125(a): general rule
// =====================================================================

use self::{
    IRC_S125_A,
    IRC_S125_B,
    IRC_S125_D,
    IRC_S125_F,
    IRC_S125_I,
    IRC_S125_J,
    Individual,
    Person,
    TaxableYear,
};

pub relation cafeteria_plan_choice_among_benefits(p: Individual, plan: us.irc.core::Organ, y: TaxableYear, amount: Money) kind empirical {
    label en official "an amount not included in gross income solely because, under a cafeteria plan, the participant may choose among the benefits of the plan (section 125(a))";
}
pub relation cafeteria_plan_amount_not_included_125a(p: Individual, plan: us.irc.core::Organ, y: TaxableYear, amount: Money) kind institutional {
    label en official "gross income does not include this amount, absent a (b) discrimination failure (section 125(a))";
}
@source(IRC_S125_A, quote = "Except as provided in subsection (b), no amount shall be included in the gross income of a participant in a cafeteria plan solely because, under the plan, the participant may choose among the benefits of the plan.")
rule CafeteriaPlanAmountNotIncluded(p: Individual, plan: us.irc.core::Organ, y: TaxableYear, amount: Money) strict {
    label en official "section 125(a), absent either (b) discrimination test failing";
    when cafeteria_plan_choice_among_benefits(p, plan, y, amount);
    when not_known(cafeteria_plan_discriminates_against_hce_125b1(p, plan, y));
    when not_known(cafeteria_plan_discriminates_against_key_employee_125b2(p, plan, y));
    then cafeteria_plan_amount_not_included_125a(p, plan, y, amount);
}

// =====================================================================
// §125(b): discrimination tests
// =====================================================================

pub relation highly_compensated_participant_125(p: Individual, plan: us.irc.core::Organ, y: TaxableYear) kind empirical {
    label en official "the participant is a highly compensated participant within the meaning of section 125(e)(1) (case-asserted; the officer/5%-shareholder/highly-compensated/family sub-tests of (e)(1)(A)-(D) are not separately derived)";
}
relation plan_discriminates_in_favor_of_hce_eligibility_or_benefits(plan: us.irc.core::Organ, y: TaxableYear) kind empirical {
    label en official "for the plan year, the cafeteria plan discriminates in favor of highly compensated individuals as to eligibility to participate, or in favor of highly compensated participants as to contributions and benefits (section 125(b)(1)(A)-(B)) — a population-wide plan-design test, §111, taken as a case-asserted fact";
}
pub relation cafeteria_plan_discriminates_against_hce_125b1(p: Individual, plan: us.irc.core::Organ, y: TaxableYear) kind institutional {
    label en official "section 125(b)(1): the plan's (a) exclusion does not apply to this HCE's benefit for a plan year the plan discriminates";
}
@source(IRC_S125_B, quote = "In the case of a highly compensated participant, subsection (a) shall not apply to any benefit attributable to a plan year for which the plan discriminates in favor of—\n(A) highly compensated individuals as to eligibility to participate, or\n(B) highly compensated participants as to contributions and benefits.")
rule CafeteriaPlanDiscriminatesAgainstHce(p: Individual, plan: us.irc.core::Organ, y: TaxableYear) strict {
    label en official "section 125(b)(1)";
    when highly_compensated_participant_125(p, plan, y);
    when plan_discriminates_in_favor_of_hce_eligibility_or_benefits(plan, y);
    when not_known(simple_cafeteria_plan_deemed_nondiscriminatory_125j1(plan, y)); // G6404 wiring: §125(j)(1) — a simple cafeteria plan is treated as meeting (b)
    then cafeteria_plan_discriminates_against_hce_125b1(p, plan, y);
}

pub relation key_employee_416i1(p: Individual, plan: us.irc.core::Organ, y: TaxableYear) kind empirical {
    label en official "the participant is a key employee within the meaning of section 416(i)(1) (case-asserted, dependency on `us.irc.deferred_compensation`'s section 416 module, not imported this pass — see coverage-row dependency note)";
}
relation key_employee_qualified_benefits_fraction_125b2(plan: us.irc.core::Organ, y: TaxableYear, fraction: Decimal) kind empirical {
    label en official "the fraction of qualified benefits provided to key employees under the plan divided by qualified benefits provided to all employees, for the plan year (section 125(b)(2))";
}
pub relation cafeteria_plan_discriminates_against_key_employee_125b2(p: Individual, plan: us.irc.core::Organ, y: TaxableYear) kind institutional {
    label en official "section 125(b)(2): the plan fails the 25%-of-qualified-benefits key-employee concentration test";
}
@source(IRC_S125_B, quote = "In the case of a key employee (within the meaning of section 416(i)(1)), subsection (a) shall not apply to any benefit attributable to a plan for which the qualified benefits provided to key employees exceed 25 percent of the aggregate of such benefits provided for all employees under the plan.")
rule CafeteriaPlanDiscriminatesAgainstKeyEmployee(p: Individual, plan: us.irc.core::Organ, y: TaxableYear, fraction: Decimal) strict {
    label en official "section 125(b)(2): the 25% concentration test, an exact boundary (25.0% exactly does not exceed the limit)";
    when key_employee_416i1(p, plan, y);
    when key_employee_qualified_benefits_fraction_125b2(plan, y, fraction);
    when fraction > 0.25;
    when not_known(simple_cafeteria_plan_deemed_nondiscriminatory_125j1(plan, y)); // G6404 wiring: §125(j)(1)
    then cafeteria_plan_discriminates_against_key_employee_125b2(p, plan, y);
}

// =====================================================================
// §125(d): "cafeteria plan" defined
// =====================================================================

pub relation cafeteria_plan_written_plan_125d1(plan: us.irc.core::Organ) kind empirical {
    label en official "a written plan under which all participants are employees and participants may choose among 2 or more benefits consisting of cash and qualified benefits (section 125(d)(1)(A)-(B))";
}
relation plan_provides_deferred_compensation_125d2(plan: us.irc.core::Organ) kind empirical {
    label en official "the plan provides for deferred compensation (section 125(d)(2)(A))";
}
relation qualified_cash_or_deferred_arrangement_401k7_exception(plan: us.irc.core::Organ) kind empirical {
    label en official "the plan is a profit-sharing/stock-bonus/rural-cooperative plan with a section 401(k) qualified cash-or-deferred arrangement (section 125(d)(2)(B) exception)";
}
relation educational_organization_life_insurance_exception_125d2c(plan: us.irc.core::Organ) kind empirical {
    label en official "the plan is maintained by a section 170(b)(1)(A)(ii) educational organization for post-retirement group-term life insurance meeting the (d)(2)(C) pre-retirement-contribution/no-cash-surrender-value conditions (section 125(d)(2)(C))";
}
relation hsa_contribution_exception_125d2d(plan: us.irc.core::Organ) kind empirical {
    label en official "the plan allows an employee to elect employer contributions to a health savings account (section 125(d)(2)(D))";
}
pub relation cafeteria_plan_defined_125d(plan: us.irc.core::Organ) kind institutional {
    label en official "the plan is a cafeteria plan within the meaning of section 125(d)";
}
@source(IRC_S125_D, quote = "The term \"cafeteria plan\" does not include any plan which provides for deferred compensation.")
rule CafeteriaPlanDefinedNoDeferredComp(plan: us.irc.core::Organ) strict {
    label en official "section 125(d)(1)-(2)(A): a written plan with the choice structure, and no deferred-compensation feature";
    when cafeteria_plan_written_plan_125d1(plan);
    when not_known(plan_provides_deferred_compensation_flag(plan));
    then cafeteria_plan_defined_125d(plan);
}
relation plan_provides_deferred_compensation_flag(plan: us.irc.core::Organ) kind institutional {
    label en official "helper binding the (d)(2)(A) deferred-compensation fact for the not_known test, so the (B)-(D) exceptions can override it";
}
rule PlanProvidesDeferredCompensationFlag(plan: us.irc.core::Organ) strict {
    label en official "helper: the plan provides deferred compensation and none of the (B)-(D) exceptions apply";
    when plan_provides_deferred_compensation_125d2(plan);
    when not_known(qualified_cash_or_deferred_arrangement_401k7_exception(plan));
    when not_known(educational_organization_life_insurance_exception_125d2c(plan));
    when not_known(hsa_contribution_exception_125d2d(plan));
    then plan_provides_deferred_compensation_flag(plan);
}
// section 125(d)(2)(B)-(D): when the plan DOES provide deferred
// compensation, `PlanProvidesDeferredCompensationFlag` above already
// withholds the disqualifying flag if any of the three (B)-(D) exceptions
// is asserted, so `CafeteriaPlanDefinedNoDeferredComp`'s `not_known` guard
// fires and the plan still qualifies — no separate rule is needed.

// =====================================================================
// §125(f): "qualified benefit" defined
// =====================================================================

pub relation benefit_excluded_by_express_chapter_provision(benefit: BenefitKind) kind empirical {
    label en official "with the application of section 125(a), the benefit is not includible in gross income by reason of an express provision of chapter 1 (other than sections 106(b), 117, 127, or 132) (section 125(f)(1))";
}
pub entity BenefitKind {
    label en unofficial "a kind of benefit offered under a cafeteria plan (case-asserted, e.g. health coverage, group-term life, dependent care assistance)";
}
relation long_term_care_product_125f2(benefit: BenefitKind) kind empirical {
    label en official "the product is advertised, marketed, or offered as long-term care insurance (section 125(f)(2))";
}
relation exchange_qualified_health_plan_125f3(benefit: BenefitKind) kind empirical {
    label en official "the benefit is a qualified health plan offered through an Exchange, and the (f)(3)(B) small/qualified-employer exception does not apply (section 125(f)(3)(A))";
}
pub relation qualified_benefit_125f(benefit: BenefitKind) kind institutional {
    label en official "the benefit is a qualified benefit within the meaning of section 125(f)";
}
@source(IRC_S125_F, quote = "The term \"qualified benefit\" means any benefit which, with the application of subsection (a), is not includible in the gross income of the employee by reason of an express provision of this chapter")
rule QualifiedBenefitDefined(benefit: BenefitKind) strict {
    label en official "section 125(f)(1)-(3): a chapter-1-excludable benefit that is not long-term-care insurance and not a non-exempt Exchange plan";
    when benefit_excluded_by_express_chapter_provision(benefit);
    when not_known(long_term_care_product_125f2(benefit));
    when not_known(exchange_qualified_health_plan_125f3(benefit));
    then qualified_benefit_125f(benefit);
}

// =====================================================================
// §125(i): $2,500 health FSA salary-reduction limit
// =====================================================================

pub relation health_fsa_salary_reduction_election(p: Individual, plan: us.irc.core::Organ, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of salary reduction contributions the employee elects to a health flexible spending arrangement under the cafeteria plan for the taxable year (section 125(i)(1))";
}
pub relation health_fsa_not_qualified_benefit_excess_125i(p: Individual, plan: us.irc.core::Organ, y: TaxableYear, amount: Money) kind institutional {
    label en official "the portion of the health-FSA election exceeding the section 125(i) dollar limit — that portion is not treated as a qualified benefit";
}
@source(IRC_S125_I, quote = "if a benefit is provided under a cafeteria plan through employer contributions to a health flexible spending arrangement, such benefit shall not be treated as a qualified benefit unless the cafeteria plan provides that an employee may not elect for any taxable year to have salary reduction contributions in excess of $2,500 made to such arrangement")
rule HealthFsaExcessOverStatutoryBase(p: Individual, plan: us.irc.core::Organ, y: TaxableYear, election: Money) strict {
    label en official "section 125(i)(1): the $2,500 STATUTORY BASE figure (2013 dollars); the current post-2013 COLA-indexed figure is SOURCE_GAP (no `us.irc.inflation_adjustments` pub relation exists for section 125(i) — confirmed by inspecting that package) — a case for a post-2013 year must supply the correct indexed amount itself via a higher `health_fsa_salary_reduction_election` reading if it wants the indexed ceiling; this rule alone understates the true ceiling for any year after 2013";
    when health_fsa_salary_reduction_election(p, plan, y, election);
    when election > 2500.00 USD;
    then health_fsa_not_qualified_benefit_excess_125i(p, plan, y, round(election - 2500.00 USD, 2, "HALF_UP"));
}

// =====================================================================
// §125(j): SIMPLE cafeteria plans
// =====================================================================

pub relation simple_cafeteria_plan_established_125j2(plan: us.irc.core::Organ, eligible_employer: Person) kind empirical {
    label en official "a simple cafeteria plan established and maintained by an eligible employer (section 125(j)(2)(A))";
}
relation simple_cafeteria_uniform_contribution_2pct_125j3Ai(plan: us.irc.core::Organ, y: TaxableYear) kind empirical {
    label en official "the plan requires, without regard to salary reduction, an employer contribution of a uniform 2% (or more) of compensation for each qualified employee (section 125(j)(3)(A)(i))";
}
relation simple_cafeteria_matching_contribution_125j3Aii(plan: us.irc.core::Organ, y: TaxableYear) kind empirical {
    label en official "the plan requires an employer contribution of not less than the lesser of 6% of compensation or twice the qualified employee's own salary-reduction contribution (section 125(j)(3)(A)(ii))";
}
pub relation simple_cafeteria_contribution_requirement_met_125j3(plan: us.irc.core::Organ, y: TaxableYear) kind institutional {
    label en official "the section 125(j)(3) minimum-contribution requirement is met (the (B) higher-rate-for-HCE/key-employee anti-abuse condition is not separately modelled — TECH_GAP)";
}
@source(IRC_S125_J, quote = "The requirements of this paragraph are met if, under the plan the employer is required, without regard to whether a qualified employee makes any salary reduction contribution, to make a contribution to provide qualified benefits under the plan on behalf of each qualified employee in an amount equal to—\n(i) a uniform percentage (not less than 2 percent) of the employee's compensation for the plan year")
rule SimpleCafeteriaContributionUniform(plan: us.irc.core::Organ, y: TaxableYear) strict {
    label en official "section 125(j)(3)(A)(i)";
    when simple_cafeteria_uniform_contribution_2pct_125j3Ai(plan, y);
    then simple_cafeteria_contribution_requirement_met_125j3(plan, y);
}
@source(IRC_S125_J, quote = "(ii) an amount which is not less than the lesser of—\n(I) 6 percent of the employee's compensation for the plan year, or\n(II) twice the amount of the salary reduction contributions of each qualified employee")
rule SimpleCafeteriaContributionMatching(plan: us.irc.core::Organ, y: TaxableYear) strict {
    label en official "section 125(j)(3)(A)(ii)";
    when simple_cafeteria_matching_contribution_125j3Aii(plan, y);
    then simple_cafeteria_contribution_requirement_met_125j3(plan, y);
}

relation simple_cafeteria_all_1000_hour_employees_eligible_125j4Ai(plan: us.irc.core::Organ, y: TaxableYear) kind empirical {
    label en official "all employees who had at least 1,000 hours of service for the preceding plan year are eligible to participate, subject to the (B) permitted exclusions (section 125(j)(4)(A)(i))";
}
relation simple_cafeteria_uniform_election_terms_125j4Aii(plan: us.irc.core::Organ, y: TaxableYear) kind empirical {
    label en official "each eligible employee may elect any benefit available under the plan, subject to terms and conditions applicable to all participants (section 125(j)(4)(A)(ii))";
}
pub relation simple_cafeteria_eligibility_requirement_met_125j4(plan: us.irc.core::Organ, y: TaxableYear) kind institutional {
    label en official "the section 125(j)(4) minimum-eligibility-and-participation requirement is met";
}
@source(IRC_S125_J, quote = "The requirements of this paragraph shall be treated as met with respect to any year if, under the plan—\n(i) all employees who had at least 1,000 hours of service for the preceding plan year are eligible to participate, and\n(ii) each employee eligible to participate in the plan may, subject to terms and conditions applicable to all participants, elect any benefit available under the plan.")
rule SimpleCafeteriaEligibilityMet(plan: us.irc.core::Organ, y: TaxableYear) strict {
    label en official "section 125(j)(4)(A)(i)-(ii) (the (B) permitted-exclusion categories are not separately modelled — a case simply asserts (i) as already reflecting them, TECH_GAP)";
    when simple_cafeteria_all_1000_hour_employees_eligible_125j4Ai(plan, y);
    when simple_cafeteria_uniform_election_terms_125j4Aii(plan, y);
    then simple_cafeteria_eligibility_requirement_met_125j4(plan, y);
}

pub relation simple_cafeteria_plan_defined_125j2(plan: us.irc.core::Organ, eligible_employer: Person, y: TaxableYear) kind institutional {
    label en official "the plan is a simple cafeteria plan within the meaning of section 125(j)(2)";
}
@source(IRC_S125_J, quote = "the term \"simple cafeteria plan\" means a cafeteria plan—\n(A) which is established and maintained by an eligible employer, and\n(B) with respect to which the contribution requirements of paragraph (3), and the eligibility and participation requirements of paragraph (4), are met")
rule SimpleCafeteriaPlanDefined(plan: us.irc.core::Organ, eligible_employer: Person, y: TaxableYear) strict {
    label en official "section 125(j)(2)";
    when simple_cafeteria_plan_established_125j2(plan, eligible_employer);
    when simple_cafeteria_contribution_requirement_met_125j3(plan, y);
    when simple_cafeteria_eligibility_requirement_met_125j4(plan, y);
    then simple_cafeteria_plan_defined_125j2(plan, eligible_employer, y);
}

pub relation simple_cafeteria_plan_deemed_nondiscriminatory_125j1(plan: us.irc.core::Organ, y: TaxableYear) kind institutional {
    label en official "an eligible employer's simple cafeteria plan is treated as meeting the (b)/79(d)/105(h)/etc. applicable nondiscrimination requirements (section 125(j)(1))";
}
@source(IRC_S125_J, quote = "An eligible employer maintaining a simple cafeteria plan with respect to which the requirements of this subsection are met for any year shall be treated as meeting any applicable nondiscrimination requirement during such year.")
rule SimpleCafeteriaPlanDeemedNondiscriminatory(plan: us.irc.core::Organ, eligible_employer: Person, y: TaxableYear) strict {
    label en official "section 125(j)(1): the SIMPLE safe harbor";
    when simple_cafeteria_plan_defined_125j2(plan, eligible_employer, y);
    then simple_cafeteria_plan_deemed_nondiscriminatory_125j1(plan, y);
}
