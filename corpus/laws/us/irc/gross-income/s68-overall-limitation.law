// Section 68 — Overall limitation on itemized deductions. Stage 1 (IRC-06).
//
// §68 itself is suspended for taxable years beginning after December 31,
// 2017 and before January 1, 2026 (pinned (f)). Pub. L. 119-21 §70111
// REPLACES section 68 in full, effective for taxable years beginning after
// December 31, 2025, with a new formula: reduce itemized deductions by
// 2/37 of the LESSER of (1) the itemized deductions, or (2) so much of
// taxable income (determined without regard to this section, increased by
// the itemized deductions) as exceeds [a threshold amount] — the XML
// extraction of PLAW-119publ21.xml available to this task breaks at the
// page boundary ("139 STAT. 165") before stating that threshold amount.
// SOURCE_GAP: the new (b) "applicable amount"/threshold definition of
// post-2025 section 68 is NOT pinned by this task's sources and is not
// modelled below; only the pre-2026 law (suspended, then the old 3%/80%
// formula for years outside the 2018-2025 window) is executable.

use self::{
    IRC_S68_A,
    IRC_S68_B,
    IRC_S68_E,
    IRC_S68_F,
    Individual,
    Person,
    TaxableYear,
    adjusted_gross_income,
    itemized_deductions_total,
};

pub relation applicable_amount_68(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the applicable amount (section 68(b))";
}

@source(IRC_S68_B, quote = "$300,000 in the case of a joint return or a surviving spouse")
rule ApplicableAmountJoint(p: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus) strict {
    label en official "the applicable amount for a joint return or surviving spouse";
    effective (-infinity, @2018-01-01);
    when us.irc.income_individual::filing_status(p, y, s);
    when s == us.irc.income_individual::Joint;
    then applicable_amount_68(p, y, round(ApplicableAmount68Joint, 2, "HALF_UP"));
}

@source(IRC_S68_B, quote = "$275,000 in the case of a head of household")
rule ApplicableAmountHoh(p: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus) strict {
    label en official "the applicable amount for a head of household";
    effective (-infinity, @2018-01-01);
    when us.irc.income_individual::filing_status(p, y, s);
    when s == us.irc.income_individual::HeadOfHousehold;
    then applicable_amount_68(p, y, round(ApplicableAmount68HeadOfHousehold, 2, "HALF_UP"));
}

@source(IRC_S68_B, quote = "$250,000 in the case of an individual who is not married and who is not a surviving spouse or head of household")
rule ApplicableAmountOther(p: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus) strict {
    label en official "the applicable amount for an unmarried individual who is not a surviving spouse or head of household";
    effective (-infinity, @2018-01-01);
    when us.irc.income_individual::filing_status(p, y, s);
    when s == us.irc.income_individual::Unmarried;
    then applicable_amount_68(p, y, round(ApplicableAmount68Other, 2, "HALF_UP"));
}

@source(IRC_S68_B, quote = "½ the amount applicable under subparagraph (A) (after adjustment, if any, under paragraph (2)) in the case of a married individual filing a separate return")
rule ApplicableAmountMarriedSeparate(p: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus) strict {
    label en official "the applicable amount for a married individual filing a separate return is half the joint-return amount";
    effective (-infinity, @2018-01-01);
    when us.irc.income_individual::filing_status(p, y, s);
    when s == us.irc.income_individual::MarriedSeparate;
    then applicable_amount_68(p, y, 0.5 * round(ApplicableAmount68Joint, 2, "HALF_UP"));
}

// --- §68(c): itemized deductions excepted from this section's reduction ------

pub enum Section68ExceptedDeductionKind {
    MedicalExpenseDeduction213;
    InvestmentInterestDeduction163d;
    CasualtyTheftLossDeduction165;
}

relation section_68_excepted_deduction_amount(p: Individual, y: TaxableYear, kind: Section68ExceptedDeductionKind, amount: Money) kind institutional {
    label en official "an itemized deduction excepted from section 68's reduction (section 68(c)) — dependency contract, producer: deductions";
}

// --- §68(a): the reduction formula (pre-2018/estates-trusts-excepted years) ---

pub relation itemized_deductions_reduced_amount(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the reduction of itemized deductions under section 68 (the lesser of the two prongs, before subtracting from the itemized deductions otherwise allowable)";
}

@source(IRC_S68_A, quote = "the amount of the itemized deductions otherwise allowable for the taxable year shall be reduced by the lesser of")
rule OverallLimitationReduction(p: Individual, y: TaxableYear, agi: Money, applicable: Money, itemized: Money) strict {
    label en official "for an individual whose AGI exceeds the applicable amount, the reduction is the lesser of 3 percent of the excess or 80 percent of the itemized deductions otherwise allowable (excepted deductions of (c) do not count toward the reduced amount)";
    effective (-infinity, @2018-01-01);
    when not_known(is_estate_or_trust(p));
    when adjusted_gross_income(p, y, agi);
    when applicable_amount_68(p, y, applicable);
    when agi > applicable;
    when itemized_deductions_total(p, y, itemized);
    when (0.03 * (agi - applicable)) <= (0.80 * (itemized - (sum all amount: Money for k: Section68ExceptedDeductionKind where section_68_excepted_deduction_amount(p, y, k, amount))));
    then itemized_deductions_reduced_amount(p, y, 0.03 * (agi - applicable));
}

@source(IRC_S68_A, quote = "80 percent of the amount of the itemized deductions otherwise allowable for such taxable year")
rule OverallLimitationReduction80PercentPrevails(p: Individual, y: TaxableYear, agi: Money, applicable: Money, itemized: Money) strict {
    label en official "the 80-percent-of-itemized-deductions prong governs when it is the lesser of the two";
    effective (-infinity, @2018-01-01);
    when not_known(is_estate_or_trust(p));
    when adjusted_gross_income(p, y, agi);
    when applicable_amount_68(p, y, applicable);
    when agi > applicable;
    when itemized_deductions_total(p, y, itemized);
    when (0.80 * (itemized - (sum all amount: Money for k: Section68ExceptedDeductionKind where section_68_excepted_deduction_amount(p, y, k, amount)))) < (0.03 * (agi - applicable));
    then itemized_deductions_reduced_amount(p, y, 0.80 * (itemized - (sum all amount: Money for k: Section68ExceptedDeductionKind where section_68_excepted_deduction_amount(p, y, k, amount))));
}

relation is_estate_or_trust(p: Person) kind institutional {
    label en official "an estate or trust (section 68(e) exception subject) — dependency contract on core's type distinction, asserted for a Person known to be an Estate/Trust instance";
}

// --- §68(f)/suspension 2018-2025 -----------------------------------------------

@source(IRC_S68_F, quote = "This section shall not apply to any taxable year beginning after December 31, 2017, and before January 1, 2026")
rule OverallLimitationSuspended2018To2025(p: Individual, y: TaxableYear, itemized: Money) strict {
    label en official "section 68 does not apply for a taxable year beginning after December 31, 2017 and before January 1, 2026: no reduction";
    effective [@2018-01-01, @2026-01-01);
    when itemized_deductions_total(p, y, itemized);
    then itemized_deductions_reduced_amount(p, y, 0.00 USD);
}

// --- §68(e): exception for estates and trusts -----------------------------------

@source(IRC_S68_E, quote = "This section shall not apply to any estate or trust")
rule OverallLimitationNotApplicableToEstateOrTrust(p: Individual, y: TaxableYear, itemized: Money) strict {
    // TYPE NOTE: `itemized_deductions_total`/`itemized_deductions_reduced_amount`
    // are `Individual`-typed in this package (matching section 63(d)'s AGI-chain
    // usage); a genuine `us.irc.core::Estate`/`Trust` instance cannot be passed
    // here without widening those relations' domain, which this stage does not
    // do. Recorded as INTERPRETATION: this rule is exercised only by a
    // scenario asserting `is_estate_or_trust` of an `Individual`-typed
    // placeholder, not a real Estate/Trust entity — a real fix widens the two
    // relations above to `Person`, deferred to whichever package (this one or
    // `trusts-estates`) next touches section 68 for an actual estate/trust case.
    label en official "section 68 does not apply to any estate or trust";
    when is_estate_or_trust(p);
    when itemized_deductions_total(p, y, itemized);
    then itemized_deductions_reduced_amount(p, y, 0.00 USD);
}

// --- §68(d): coordination with other limitations (non-normative ordering) -----
//
// "This section shall be applied after the application of any other
// limitation on the allowance of any itemized deduction." A pure sequencing
// rule, same NON_NORMATIVE classification as §67(f); this package's own
// `OverallLimitationReduction` rules already read `itemized_deductions_total`
// (the post-other-limitations figure) as their input, which is the ordering
// (d) requires, so no separate executable content is added by (d) itself.

// --- Post-2025 replacement (Pub. L. 119-21 §70111) — SOURCE_GAP ---------------
//
// The new formula's threshold amount (paragraph (2) of the replacement text)
// is not pinned by this task (XML extraction available to this agent breaks
// mid-sentence at the "139 STAT. 165" page boundary). No rule is written for
// taxable years beginning after December 31, 2025 under the NEW section 68;
// `applicable_amount_68`/`itemized_deductions_reduced_amount` are simply
// UNDETERMINED for such years under this package until the missing text is
// pinned and a rule added. SOURCE_GAP row recorded in the coverage file.
