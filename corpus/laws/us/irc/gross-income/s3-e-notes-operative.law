// Stage 3 (TECH_GAP reduction): statutory notes (uncodified provisions of earlier Acts) under
// sections 72, 79, 112 and 118 whose special rule still has an application: a grandfathered plan
// loan (Pub. L. 97-248 section 236(c), note under section 72), grandfathered group-term life
// insurance for retirees (Pub. L. 98-369 section 223, note under section 79), the hazardous duty
// areas treated as combat zones (Pub. L. 104-117 section 1, note under section 112) and
// contributions designated under the 1986 transitional rule (Pub. L. 99-514 section 824(b)... note
// under section 118).
// STATUS: implemented_unverified (static check only; scenarios in tests/s3-e-notes-operative.lawtest
// are NOT executed).
//
// WHY THESE NOTES ARE OPERATIVE. A grandfather rule that protects an instrument (a loan made on or
// before August 13, 1982; coverage of a person aged 55 on January 1, 1984) keeps operating for as
// long as the instrument or the person exists; a rule that fixes a period of a designated amount
// keeps operating for amounts received later. Notes that only date a repealed or amended provision,
// or whose window closed (a claim period ending one year after enactment), are NON_NORMATIVE in the
// coverage with the date cited.
//
// JUDGMENT CALLS. §72 note: the date `on` of `plan_loan_made` is the date the loan is made or, for
// a loan renegotiated, extended, renewed or revised after August 13, 1982, the date of that
// change (the note treats it as a new loan on that date). §79 note: the employment during 1983
// and the age of 55 on January 1, 1984 are case facts. §112 note: the special pay entitlement of 37
// U.S.C. 310 is a case fact with its period.

// =====================================================================
// §72 note (Pub. L. 97-248 §236(c)): loans made on or before August 13, 1982
// =====================================================================

use self::{
    IRC_S112_NOTE_6,
    IRC_S118_NOTE_4,
    IRC_S72_NOTE_6,
    IRC_S79_NOTE_4,
    Individual,
    Person,
    RetirementArrangement,
    TaxableYear,
    contribution_to_capital_excluded_118a,
    group_term_cost_excepted_79b,
    group_term_life_cost,
    indirect_plan_loan_treated_as_loan_72p,
    month_qualifies_for_112_exclusion,
    plan_loan_deemed_distribution,
    plan_loan_made,
};

@source(IRC_S72_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(1) In general.—The amendments made by this section [amending this section] shall apply to loans, assignments, and pledges made after August 13, 1982.")
rule PlanLoanMadeBefore1982Grandfathered(p: Individual, plan: RetirementArrangement, on: Date, amount: Money) strict {
    label en official "Pub. L. 97-248 section 236(c)(1): a loan made on or before August 13, 1982 is outside section 72(p): no part is a deemed distribution (explicit zero); a loan renegotiated, extended, renewed or revised after that date is a new loan on the date of the change";
    when plan_loan_made(p, plan, on, amount);
    when on <= @1982-08-13;
    then plan_loan_deemed_distribution(p, plan, on, 0.00 USD);
}
@source(IRC_S72_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(1) In general.—The amendments made by this section [amending this section] shall apply to loans, assignments, and pledges made after August 13, 1982.")
rule IndirectLoanMadeBefore1982Grandfathered(p: Individual, plan: RetirementArrangement, on: Date, amount: Money) strict {
    label en official "Pub. L. 97-248 section 236(c)(1): an assignment, pledge or contract loan made on or before August 13, 1982 is outside section 72(p)";
    when indirect_plan_loan_treated_as_loan_72p(p, plan, on, amount);
    when on <= @1982-08-13;
    then plan_loan_deemed_distribution(p, plan, on, 0.00 USD);
}

// =====================================================================
// §79 note (Pub. L. 98-369 §223(c)): group-term life insurance for retired employees
// =====================================================================

relation group_term_plan_facts_79note(p: Individual, y: TaxableYear, plan_existed_on_1984_01_01: Boolean, comparable_successor_plan: Boolean, benefits_of_the_individual_increase_under_successor: Boolean) kind empirical {
    label en official "the employer's group-term life insurance plan covering the individual existed on January 1, 1984, or is a successor to such a plan, and whether the individual's benefits increase under the successor plan";
}
relation group_term_individual_facts_79note(p: Individual, y: TaxableYear, attained_age_55_by_1984_01_01: Boolean, employed_by_employer_in_1983: Boolean, retired_by_1984_01_01_and_covered_when_retired: Boolean) kind empirical {
    label en official "the individual attained age 55 on or before January 1, 1984 and was employed by the employer (or a predecessor) at any time during 1983, or retired from employment on or before January 1, 1984 and when he retired was covered by the plan";
}
relation discriminatory_plan_and_retirement_after_1986_79note(p: Individual, y: TaxableYear) kind empirical {
    label en official "the plan is, after December 31, 1986, a discriminatory group-term life insurance plan (section 79(d)) and the individual retires under it after December 31, 1986";
}
pub relation group_term_plan_within_grandfather_79note(p: Individual, y: TaxableYear) kind institutional {
    label en official "the plan is a plan in existence on January 1, 1984 or a comparable successor to it (a plan is not a successor that fails to be comparable for an employee whose benefits do not increase)";
}
@source(IRC_S79_NOTE_4, relation = formalizes, coverage = exact, quote = "\"(i) to any group-term life insurance plan of the employer in existence on January 1, 1984, or")
rule GroupTermPlanExisted1984(p: Individual, y: TaxableYear, comparable: Boolean, increase: Boolean) strict {
    label en official "Pub. L. 98-369 section 223(c)(2)(A)(i)";
    when group_term_plan_facts_79note(p, y, true, comparable, increase);
    then group_term_plan_within_grandfather_79note(p, y);
}
@source(IRC_S79_NOTE_4, relation = formalizes, coverage = exact, quote = "(D) Comparable successor plans.—For purposes of subparagraph (A), a plan shall not fail to be treated as a comparable successor to a plan described in subparagraph (A)(i) with respect to any employee whose benefits do not increase under the successor plan.")
rule GroupTermPlanComparableSuccessor(p: Individual, y: TaxableYear, existed: Boolean) strict {
    label en official "Pub. L. 98-369 section 223(c)(2)(A)(ii) and (D): a successor plan is comparable for an employee whose benefits do not increase";
    when group_term_plan_facts_79note(p, y, existed, true, false);
    then group_term_plan_within_grandfather_79note(p, y);
}
pub relation group_term_grandfathered_former_employee_79note(p: Individual, y: TaxableYear) kind institutional {
    label en official "the amendments of section 223(a) do not apply to the individual: the plan is within the grandfather and the individual attained age 55 by January 1, 1984 and worked for the employer in 1983, or retired by that date while covered";
}
@source(IRC_S79_NOTE_4, relation = formalizes, coverage = exact, quote = "but only with respect to an individual who attained age 55 on or before January 1, 1984, and was employed by such employer (or a predecessor employer) at any time during 1983.")
rule GroupTermGrandfatheredByAge(p: Individual, y: TaxableYear) strict {
    label en official "Pub. L. 98-369 section 223(c)(2)(A), age limb; not for a discriminatory plan and a retirement after December 31, 1986 ((B))";
    when group_term_plan_within_grandfather_79note(p, y);
    when group_term_individual_facts_79note(p, y, true, true, false);
    when not_known(discriminatory_plan_and_retirement_after_1986_79note(p, y));
    then group_term_grandfathered_former_employee_79note(p, y);
}
@source(IRC_S79_NOTE_4, relation = formalizes, coverage = exact, quote = "Such amendments also shall not apply to any employee who retired from employment on or before January 1, 1984, and who, when he retired, was covered by the plan (or a predecessor plan).")
rule GroupTermGrandfatheredByRetirement(p: Individual, y: TaxableYear) strict {
    label en official "Pub. L. 98-369 section 223(c)(2)(A), retirement limb; not for a discriminatory plan and a retirement after December 31, 1986 ((B))";
    when group_term_plan_within_grandfather_79note(p, y);
    when group_term_individual_facts_79note(p, y, false, false, true);
    when not_known(discriminatory_plan_and_retirement_after_1986_79note(p, y));
    then group_term_grandfathered_former_employee_79note(p, y);
}
@source(IRC_S79_NOTE_4, relation = formalizes, coverage = exact, quote = "\"(B) Special rule in the case of discriminatory group-term life insurance plan.—In the case of any plan which, after December 31, 1986, is a discriminatory group-term life insurance plan")
rule GroupTermGrandfatheredByAgeAndRetirement(p: Individual, y: TaxableYear) strict {
    label en official "Pub. L. 98-369 section 223(c)(2)(A): an individual who meets both limbs";
    when group_term_plan_within_grandfather_79note(p, y);
    when group_term_individual_facts_79note(p, y, true, true, true);
    when not_known(discriminatory_plan_and_retirement_after_1986_79note(p, y));
    then group_term_grandfathered_former_employee_79note(p, y);
}
@source(IRC_S79_NOTE_4, relation = formalizes, coverage = exact, quote = "\"(2) Inclusion of former employees in the case of existing group-term insurance plans.—")
rule GroupTermCostExceptedForGrandfatheredFormerEmployee(p: Individual, y: TaxableYear, cost: Money) strict {
    label en official "Pub. L. 98-369 section 223(c)(2): the cost of the retiree's group-term life insurance is outside section 79(a), as under section 79(b) before the amendment";
    when group_term_grandfathered_former_employee_79note(p, y);
    when group_term_life_cost(p, y, cost);
    then group_term_cost_excepted_79b(p, y, cost);
}
relation employer_elects_to_disregard_retirees_79note(p: Individual, y: TaxableYear, retired_on_or_before_1986_12_31: Boolean) kind empirical {
    label en official "the employer elects to disregard coverage of employees who retired on or before December 31, 1986, and the individual retired on or before that date";
}
pub relation retiree_coverage_disregarded_for_discrimination_test_79note(p: Individual, y: TaxableYear) kind institutional {
    label en official "coverage of the individual, who retired on or before December 31, 1986, is disregarded (at the employer's election) in determining whether the plan meets section 79(d) for former employees";
}
@source(IRC_S79_NOTE_4, relation = formalizes, coverage = exact, quote = "\"(C) Benefits to certain retired individuals not taken into account for purposes of determining whether plan is discriminatory.")
rule RetireeCoverageDisregardedForDiscriminationTest(p: Individual, y: TaxableYear) strict {
    label en official "Pub. L. 98-369 section 223(c)(2)(C)";
    when employer_elects_to_disregard_retirees_79note(p, y, true);
    then retiree_coverage_disregarded_for_discrimination_test_79note(p, y);
}

// =====================================================================
// §112 note (Pub. L. 104-117 §1): qualified hazardous duty areas treated as combat zones
// =====================================================================

pub enum HazardousDutyCountry112 { BosniaAndHerzegovina; Croatia; Macedonia }
relation special_pay_entitlement_at_enactment_112note(country: HazardousDutyCountry112) kind empirical {
    label en official "as of March 20, 1996 a member of the Armed Forces of the United States is entitled to special pay under section 310 of title 37 for services performed in the country";
}
relation special_pay_entitlement_period_112note(country: HazardousDutyCountry112, from: Date, to: Date) kind empirical {
    label en official "the period during which the entitlement to special pay under section 310 of title 37 for services in the country is in effect";
}
pub relation qualified_hazardous_duty_area_period_112note(country: HazardousDutyCountry112, from: Date, to: Date) kind institutional {
    label en official "the country is a qualified hazardous duty area during the period: an entitlement to special pay existed at enactment (March 20, 1996) and is in effect during the period, which ends on or after November 21, 1995 (the effective date)";
}
@source(IRC_S112_NOTE_6, relation = formalizes, coverage = partial, quote = "\"(b) Qualified Hazardous Duty Area.—For purposes of this section, the term 'qualified hazardous duty area' means Bosnia and Herzegovina, Croatia, or Macedonia")
rule QualifiedHazardousDutyAreaDefined(country: HazardousDutyCountry112, from: Date, to: Date) strict {
    label en official "Pub. L. 104-117 section 1(b) with (e)(1): only during the period the entitlement is in effect, from November 21, 1995";
    when special_pay_entitlement_at_enactment_112note(country);
    when special_pay_entitlement_period_112note(country, from, to);
    when to >= @1995-11-21;
    then qualified_hazardous_duty_area_period_112note(country, from, to);
}
pub relation hazardous_duty_area_treated_as_combat_zone_112note(country: HazardousDutyCountry112, from: Date, to: Date) kind institutional {
    label en official "the qualified hazardous duty area is treated as a combat zone during the period for sections 2(a)(3), 112, 692, 2201, 3401(a)(1), 4253(d), 6013(f)(1) and 7508 (the sections other than 112 read this relation in their own packages)";
}
@source(IRC_S112_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(a) General Rule.—For purposes of the following provisions of the Internal Revenue Code of 1986, a qualified hazardous duty area shall be treated in the same manner as if it were a combat zone")
rule HazardousDutyAreaTreatedAsCombatZone(country: HazardousDutyCountry112, from: Date, to: Date) strict {
    label en official "Pub. L. 104-117 section 1(a)";
    when qualified_hazardous_duty_area_period_112note(country, from, to);
    then hazardous_duty_area_treated_as_combat_zone_112note(country, from, to);
}
relation served_in_hazardous_duty_country_on_112note(p: Individual, month_start: Date, country: HazardousDutyCountry112, day: Date) kind empirical {
    label en official "the member served in the country on the day, during the month beginning on month_start";
}
@source(IRC_S112_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(2) Section 112 (relating to the exclusion of certain combat pay of members of the Armed Forces).")
rule MonthQualifiesByServiceInHazardousDutyArea(p: Individual, month_start: Date, country: HazardousDutyCountry112, day: Date, from: Date, to: Date) strict {
    label en official "Pub. L. 104-117 section 1(a)(2): service in a qualified hazardous duty area is service in a combat zone for section 112";
    when served_in_hazardous_duty_country_on_112note(p, month_start, country, day);
    when hazardous_duty_area_treated_as_combat_zone_112note(country, from, to);
    when day >= from;
    when day <= to;
    when day >= @1995-11-21;
    then month_qualifies_for_112_exclusion(p, month_start);
}
relation operation_joint_endeavor_service_112note(p: Individual, day: Date, outside_united_states: Boolean, deployed_away_from_permanent_duty_station: Boolean) kind empirical {
    label en official "the individual performs services as part of Operation Joint Endeavor on the day, outside the United States while deployed away from the permanent duty station";
}
pub relation area_of_joint_endeavor_service_is_hazardous_duty_area_for_7508_112note(p: Individual, day: Date) kind institutional {
    label en official "solely for section 7508 the area in which the services of Operation Joint Endeavor are performed is a qualified hazardous duty area during the period the entitlement is in effect";
}
@source(IRC_S112_NOTE_6, relation = formalizes, coverage = exact, quote = "Solely for purposes of applying section 7508 of the Internal Revenue Code of 1986, in the case of an individual who is performing services as part of Operation Joint Endeavor outside the United States")
rule JointEndeavorAreaIsHazardousDutyAreaFor7508(p: Individual, day: Date, country: HazardousDutyCountry112, from: Date, to: Date) strict {
    label en official "Pub. L. 104-117 section 1(b), last sentence";
    when operation_joint_endeavor_service_112note(p, day, true, true);
    when qualified_hazardous_duty_area_period_112note(country, from, to);
    when day >= from;
    when day <= to;
    then area_of_joint_endeavor_service_is_hazardous_duty_area_for_7508_112note(p, day);
}

// =====================================================================
// §118 note (Pub. L. 99-514 §824(b)): contributions designated under the 1986 transitional rule
// =====================================================================

relation designated_contribution_118note(corp: Person, y: TaxableYear, contribution: us.irc.core::Transaction, paragraph: Integer, amount: Money, aggregate_designated: Money, description_met: Boolean) kind empirical {
    label en official "a contribution in aid of construction received after December 31, 1986 that the paying entity designated under the transitional rule: paragraph 2 (New Jersey Department of Environmental Protection, alternative water supply projects in zones of drinking water contamination), paragraph 3 (a qualified transportation authority, contributions clearly identified in a master plan in existence on September 13, 1984); the amount, the aggregate designated so far, and whether the description is met";
}
@source(IRC_S118_NOTE_4, relation = formalizes, coverage = exact, quote = "\"(2) Treatment of certain water supply projects.—The amendments made by this section shall not apply to amounts which are paid by the New Jersey Department of Environmental Protection")
rule ContributionExcludedByNewJerseyDesignation(corp: Person, y: TaxableYear, contribution: us.irc.core::Transaction, amount: Money, aggregate: Money) strict {
    label en official "Pub. L. 99-514 transitional rule (2): designated amounts, at most $4,631,000 in all, stay excluded as before the 1986 amendments";
    when designated_contribution_118note(corp, y, contribution, 2, amount, aggregate, true);
    when aggregate <= 4631000.00 USD;
    then contribution_to_capital_excluded_118a(corp, y, contribution, amount);
}
@source(IRC_S118_NOTE_4, relation = formalizes, coverage = exact, quote = "\"(3) Treatment of certain contributions by transportation authority.—The amendments made by this section shall not apply to contributions in aid of construction by a qualified transportation authority")
rule ContributionExcludedByTransportationAuthorityDesignation(corp: Person, y: TaxableYear, contribution: us.irc.core::Transaction, amount: Money, aggregate: Money) strict {
    label en official "Pub. L. 99-514 transitional rule (3): designated contributions, at most $68,000,000 in all, stay excluded as before the 1986 amendments";
    when designated_contribution_118note(corp, y, contribution, 3, amount, aggregate, true);
    when aggregate <= 68000000.00 USD;
    then contribution_to_capital_excluded_118a(corp, y, contribution, amount);
}
