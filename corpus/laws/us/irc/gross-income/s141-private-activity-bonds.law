// Section 141 — Private activity bond; qualified bond. Stage 2c (IRC-06).
// Scope: (a) the classification test itself, (b)(1)-(2) the private
// business use / private security-or-payment tests (10% threshold), (c) the
// private loan financing test (the lesser of 5%/$5,000,000). NOT reached
// this pass: (b)(3)-(9) (the 5%-disproportionate-use refinement, the
// output-facility $15,000,000 rule, the volume-cap escape valve, the
// definitions of "private business use"/"government use"/"nonqualified
// amount" beyond the bare threshold comparison, and the qualified
// 501(c)(3)-bond carve-out), (d) (exception for existing facilities before
// the enactment of restrictive amendments — a historical transition rule),
// (e) (defined terms cross-referencing (b)/(c)), and all of §§142-150
// (exempt facility categories, mortgage revenue bonds, small-issue bonds,
// 501(c)(3) bonds, volume cap, other requirements, arbitrage, registration,
// and definitions) — a deliberate scope trade-off: §141(a)-(c)'s bare
// classification test was the priority named by the task instruction
// (`pub private_activity_bond`); the remaining ~2,400 rows of the bonds
// group (141(b)(3)-(9),(d)-(e), 142-150) were judged out of reach this pass
// and are NOT given executable rules (classified honestly in the coverage
// rows as TECH_GAP/NON_NORMATIVE/EXTERNAL_DEPENDENCY per provision, not
// silently skipped).
//
// JUDGMENT CALL: "proceeds of the issue" is taken as a case-asserted Money
// amount per issue (this package does not model bond-issue proceeds
// accounting, arbitrage yield, or the (b)(6)/(7)/(8) private-business-use/
// government-use/nonqualified-amount computations that would normally
// derive it) — the percentage tests below compare case-asserted "proceeds
// used for X" amounts directly against case-asserted total proceeds.

use self::{
    IRC_S141_A,
    IRC_S141_B,
    IRC_S141_C,
    has_141b9_election_141b9,
    loans_itemized_141c,
};

type Organ = us.irc.core::Organ;

// WIRE-8: the entity is declared once, by the lower package `income_individual` (`pub entity BondIssue`, section 57(a)(5)); this package
// reads the same type through an alias, so its section 141/145 relations and the lower package's contracts share one bond-issue identity.
type BondIssue = us.irc.income_individual::BondIssue;

pub relation issuer_of(issue: BondIssue, issuer: Organ) kind empirical {
    label en official "the governmental unit that is the issuer of the bond issue";
}
pub relation issue_total_proceeds(issue: BondIssue, amount: Money) kind empirical {
    label en official "the total proceeds of the issue (section 141(b)(1))";
}
pub relation proceeds_for_private_business_use(issue: BondIssue, amount: Money) kind empirical {
    label en official "the proceeds of the issue to be used (directly or indirectly) in a trade or business carried on by any person other than a governmental unit (section 141(b)(1),(6)(A))";
}
pub relation proceeds_secured_by_or_derived_from_private_business_use(issue: BondIssue, amount: Money) kind empirical {
    label en official "the proceeds of the issue whose principal or interest payment is, under its terms, secured by an interest in property used for a private business use (or payments in respect of it), or derived from payments in respect of property or borrowed money used for a private business use (section 141(b)(2))";
}
pub relation loan_proceeds_to_non_governmental_persons(issue: BondIssue, amount: Money) kind empirical {
    label en official "the proceeds of the issue used (directly or indirectly) to make or finance loans, other than the (c)(2) excepted loans, to persons other than governmental units (section 141(c)(1))";
}

pub relation private_business_use_test_met_141b1(issue: BondIssue) kind institutional {
    label en official "the private business use test of section 141(b)(1): more than 10 percent of the proceeds of the issue are to be used for a private business use";
}
@source(IRC_S141_B, quote = "an issue meets the test of this paragraph if more than 10 percent of the proceeds of the issue are to be used for any private business use")
rule PrivateBusinessUseTestMet(issue: BondIssue, private_use: Money, total: Money) strict {
    label en official "section 141(b)(1): more than 10% of proceeds for private business use";
    when proceeds_for_private_business_use(issue, private_use);
    when issue_total_proceeds(issue, total);
    when total > 0.00 USD;
    when not_known(has_141b9_election_141b9(issue));
    when private_use / total > 0.10;
    then private_business_use_test_met_141b1(issue);
}

pub relation private_security_or_payment_test_met_141b2(issue: BondIssue) kind institutional {
    label en official "the private security or payment test of section 141(b)(2): more than 10 percent of the proceeds of the issue is, by its terms, secured by or derived from private business use property or payments";
}
@source(IRC_S141_B, quote = "an issue meets the test of this paragraph if the payment of the principal of, or the interest on, more than 10 percent of the proceeds of such issue is (under the terms of such issue or any underlying arrangement) directly or indirectly")
rule PrivateSecurityOrPaymentTestMet(issue: BondIssue, secured: Money, total: Money) strict {
    label en official "section 141(b)(2): more than 10% of proceeds secured by or derived from private business use";
    when proceeds_secured_by_or_derived_from_private_business_use(issue, secured);
    when issue_total_proceeds(issue, total);
    when total > 0.00 USD;
    when not_known(has_141b9_election_141b9(issue));
    when secured / total > 0.10;
    then private_security_or_payment_test_met_141b2(issue);
}

pub relation private_loan_financing_test_met_141c(issue: BondIssue) kind institutional {
    label en official "the private loan financing test of section 141(c)(1): loan proceeds to non-governmental persons exceed the lesser of 5 percent of proceeds or $5,000,000";
}
@source(IRC_S141_C, quote = "An issue meets the test of this subsection if the amount of the proceeds of the issue which are to be used (directly or indirectly) to make or finance loans (other than loans described in paragraph (2)) to persons other than governmental units exceeds the lesser of—\n(A) 5 percent of such proceeds, or\n(B) $5,000,000.")
rule PrivateLoanFinancingTestMet(issue: BondIssue, loans: Money, total: Money) strict {
    label en official "section 141(c)(1): loan proceeds exceed the lesser of 5% of proceeds or $5,000,000";
    when loan_proceeds_to_non_governmental_persons(issue, loans);
    when issue_total_proceeds(issue, total);
    when not_known(has_141b9_election_141b9(issue));
    when not_known(loans_itemized_141c(issue));
    when loans > min(round(total * 0.05, 2, "HALF_UP"), 5000000.00 USD);
    then private_loan_financing_test_met_141c(issue);
}

pub relation private_activity_bond(issue: BondIssue) kind institutional {
    label en official "the issue is one of private activity bonds within the meaning of section 141(a): it meets both the private business use test (b)(1) and the private security-or-payment test (b)(2), or it meets the private loan financing test (c)";
}
@source(IRC_S141_A, quote = "which meets—\n(A) the private business use test of paragraph (1) of subsection (b), and\n(B) the private security or payment test of paragraph (2) of subsection (b), or")
rule PrivateActivityBondByBusinessUseAndSecurity(issue: BondIssue) strict {
    label en official "section 141(a)(1): the two-prong (b) test";
    when private_business_use_test_met_141b1(issue);
    when private_security_or_payment_test_met_141b2(issue);
    then private_activity_bond(issue);
}
@source(IRC_S141_A, quote = "which meets the private loan financing test of subsection (c)")
rule PrivateActivityBondByLoanFinancing(issue: BondIssue) strict {
    label en official "section 141(a)(2): the (c) private loan financing test, an independent alternative branch";
    when private_loan_financing_test_met_141c(issue);
    then private_activity_bond(issue);
}
