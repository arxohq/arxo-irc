// Stage G3 (IRC-G steps 4-5, 2026-09-27): effective-date and applicability bridges for the
// pre-1986 bond transitional exceptions quoted in the statutory note under section 103
// (fragment IRC_S103_NOTE_4): Pub. L. 98-369 (DEFRA, act 98369) sections 624, 626, 631 and
// Pub. L. 97-248 (TEFRA, act 97248) sections 215, 221. Each rule is a bridge of the form
// "PL section + case fact of the applied date -> statutory consequent". Parallel to the
// existing stage-3 modules (s3-b/s3-c/s3-d): no existing rule is touched, no existing head
// is re-derived. STATUS: implemented_unverified (static check only; scenarios in
// tests/97-g3-bond-transition-1982-1984.lawtest are NOT executed).
//
// SHAPE. Named facilities, issuers and programs are matched by the external judgment
// `pre1986_facility_match` (DECISION-0194, same shape as `named_exception_matches_1986`):
// applying a dated description (authorizations, approvals, agreements, amounts, places)
// is a determination left to the administrator and the courts. Dates, amounts and shares
// are case facts compared against the fragment's own literals. The consequent is either
// `pre1986_amendments_inapplicable` (the PL section's amendments do not reach the bond)
// or `pre1986_amendment_applies` (the effective-date side states that they do).
// Section 0 stands for "this subtitle" (sections 621-632 of Pub. L. 98-369).
//
// JUDGMENT CALLS (recorded, see the G3 journal): "before X" is `< @X`, "after X" is
// `> @X`, "does not exceed" is `<=`; exact calendar days ("on June 10, 1982") are
// day-windows. Enactment dates come from the pinned note headers (DEFRA July 18, 1984).
// Row 77 follows the pinned note ("1986"); the PL section text says "1954" (systematic
// OLRC remarking, see the wire-g3 journal). The 16-row table of 626(b)(2)(A) travels as
// case facts (program identity by judgment, allowable amount cased; scenario pairs use
// the Colorado $60,000,000 row) on the G1 table-path pattern. "The lesser of" (631(e))
// is two sufficient rules; the unquoted 1984-1987 window of the convention-center
// closing sentence and the (c)(1) date of TEFRA 215 enter combiners as fragment
// literals (noted per rule). The Dade County / Alabama sentences of 631(c)(4) have no
// bound row and are not modeled.

use self::{
    BondIssue,
    IRC_S103_NOTE_4,
    bond_issue_date_1986_transition,
};

external judgment relation pre1986_facility_match(issue: BondIssue, act: Integer, section: Integer, paragraph: Integer, subparagraph: Integer) {
    authority Secretary;
    label en official "the bond, facility, issuer or program is the one that the named transitional exception of the section of Pub. L. 98-369 (act 98369) or Pub. L. 97-248 (act 97248) describes (dates of authorizations, approvals and agreements, amounts and places; applying the description to the actual facts is a determination left to the administrator and the courts); (A) is 1, (B) is 2, 0 stands for a paragraph without subparagraphs";
}
pub relation pre1986_amendments_inapplicable(issue: BondIssue, act: Integer, section: Integer) kind institutional {
    label en official "the amendments made by the section of the Act do not apply to the bond (act 98369 is Pub. L. 98-369, act 97248 is Pub. L. 97-248; section 0 stands for the whole subtitle)";
}
pub relation pre1986_amendment_applies(issue: BondIssue, act: Integer, section: Integer) kind institutional {
    label en official "the amendment made by the section of the Act applies to the bond by its effective date (act 98369 is Pub. L. 98-369; section 0 stands for the whole subtitle)";
}

// =====================================================================
// §624(c)(2): the Essex County exception (row 26/103/note/4/13)
// =====================================================================

relation essex_exception_amount_624(issue: BondIssue, total: Money) kind empirical {
    label en unofficial "section 624(c)(2): the aggregate face amount of the bonds issued for the Essex County project (case fact)";
}
@source(IRC_S103_NOTE_4, quote = "\"(2) Exception.—The amendments made by this section shall not apply to obligations issued for the Essex County New Jersey Resource Recovery Project authorized by the Port Authority of New York and New Jersey on November 10, 1983, as part of an agreement approved by Essex County, New Jersey, on July 7, 1981, and approved by the State of New Jersey on December 31, 1981. The aggregate face amount of bonds to which this paragraph applies shall not exceed $350,000,000.\"")
rule EssexCountyException624(issue: BondIssue, total: Money) strict {
    label en official "section 624(c)(2) of Pub. L. 98-369: the amendments do not apply to the Essex County obligations within $350,000,000";
    when pre1986_facility_match(issue, 98369, 624, 2, 0);
    when essex_exception_amount_624(issue, total);
    when total <= 350000000.00 USD;
    then pre1986_amendments_inapplicable(issue, 98369, 624);
}

// =====================================================================
// §626(b)(2)(A): the student-loan program table (row 26/103/note/4/17)
// =====================================================================

relation student_loan_table_amounts_626(issue: BondIssue, total: Money, allowable: Money) kind empirical {
    label en unofficial "section 626(b)(2)(A): the aggregate face amount of the program's obligations and the allowable amount of the program's table row (case facts; the pinned table pairs program and allowable amount)";
}
relation pheaa_issuer_626(issue: BondIssue) kind empirical {
    label en unofficial "section 626(b)(2)(B): the issuer is the Pennsylvania Higher Education Assistance Agency (its obligations take only the subparagraph (B) path)";
}
@source(IRC_S103_NOTE_4, quote = "\"(A) In general.—The amendments made by this section [amending this section] shall not apply to obligations issued by a program described in the following table to the extent the aggregate face amount of such obligations does not exceed the amount of allowable obligations specified in the following table with respect to such program:")
rule StudentLoanTableException626(issue: BondIssue, total: Money, allowable: Money) defeasible {
    label en official "section 626(b)(2)(A) of Pub. L. 98-369: the amendments do not apply within the program's allowable amount (other than the Pennsylvania agency, which takes only subparagraph (B))";
    when pre1986_facility_match(issue, 98369, 626, 2, 1);
    when student_loan_table_amounts_626(issue, total, allowable);
    when total <= allowable;
    unless pheaa_issuer_626(issue);
    then pre1986_amendments_inapplicable(issue, 98369, 626);
}

// =====================================================================
// §626(b)(2)(B): Pennsylvania agency refundings only (row 26/103/note/4/18)
// =====================================================================

relation pheaa_refunding_facts_626(issue: BondIssue, solely_to_refund: Boolean, refunded_outstanding_on_1984_03_15: Boolean) kind empirical {
    label en unofficial "section 626(b)(2)(B): the obligations are issued solely to refund student loan bonds, and those bonds were outstanding on March 15, 1984";
}
@source(IRC_S103_NOTE_4, quote = "\"(B) Pennsylvania higher education assistance agency.—Subparagraph (A) shall apply to obligations issued by the Pennsylvania Higher Education Assistance Agency only if such obligations are issued solely for the purpose of refunding student loan bonds outstanding on March 15, 1984.")
rule PheaaRefundingOnly626(issue: BondIssue) strict {
    label en official "section 626(b)(2)(B) of Pub. L. 98-369: subparagraph (A) reaches Pennsylvania agency obligations only as refundings of student loan bonds outstanding on March 15, 1984";
    when pre1986_facility_match(issue, 98369, 626, 2, 2);
    when pheaa_issuer_626(issue);
    when pheaa_refunding_facts_626(issue, true, true);
    then pre1986_amendments_inapplicable(issue, 98369, 626);
}

// =====================================================================
// §626(b)(3): mortgage subsidy bonds are not consumer loan bonds (row 19)
// =====================================================================

relation mortgage_subsidy_msbta_facts_626(issue: BondIssue, mortgage_subsidy_bond_103Ab: Boolean, section_1102_amendments_inapplicable: Boolean) kind empirical {
    label en unofficial "section 626(b)(3): the obligation is a mortgage subsidy bond of section 103A(b), and the amendments of section 1102 of the Mortgage Subsidy Bond Tax Act of 1980 do not apply to it";
}
pub relation consumer_loan_bond_excluded_103o_626(issue: BondIssue) kind institutional {
    label en official "section 626(b)(3) of Pub. L. 98-369: the mortgage subsidy bond is not a consumer loan bond for section 103(o)";
}
@source(IRC_S103_NOTE_4, quote = "\"(3) Certain tax-exempt mortgage subsidy bonds.—For purposes of applying section 103(o) of the Internal Revenue Code of 1986 [formerly I.R.C. 1954], the term 'consumer loan bond' shall not include any mortgage subsidy bond (within the meaning of section 103A(b) of such Code) to which the amendments made by section 1102 of the Mortgage Subsidy Bond Tax Act of 1980 [enacting section 103A of this title] do not apply.")
rule MortgageSubsidyNotConsumerLoan626(issue: BondIssue) strict {
    label en official "section 626(b)(3) of Pub. L. 98-369";
    when mortgage_subsidy_msbta_facts_626(issue, true, true);
    then consumer_loan_bond_excluded_103o_626(issue);
}

// =====================================================================
// §626(b)(4): the refunding exception (rows 26/103/note/4/20-22)
// =====================================================================

relation refund_1984_facts_626(issue: BondIssue, refunded: BondIssue, exclusively_to_refund: Boolean) kind empirical {
    label en unofficial "section 626(b)(4): the proceeds are used exclusively to refund the earlier obligation";
}
relation refunded_issued_date_626(refunded: BondIssue, issued: Date) kind empirical {
    label en unofficial "section 626(b)(4): the date the refunded obligation was issued";
}
pub relation refunding_base_626(issue: BondIssue) kind institutional {
    label en official "section 626(b)(4) of Pub. L. 98-369: an exclusive refunding of obligations issued before March 15, 1984";
}
@source(IRC_S103_NOTE_4, quote = "\"(4) Refunding exception.—The amendments made by this section [amending this section] shall not apply to any obligation or series of obligations the proceeds of which are used exclusively to refund obligations issued before March 15, 1984, except that—")
rule RefundingBase626(issue: BondIssue, refunded: BondIssue, issued: Date) strict {
    label en official "section 626(b)(4) of Pub. L. 98-369, opening clause";
    when refund_1984_facts_626(issue, refunded, true);
    when refunded_issued_date_626(refunded, issued);
    when issued < @1984-03-15;
    then refunding_base_626(issue);
}
relation refunding_amounts_626(issue: BondIssue, refunding: Money, refunded_face: Money) kind empirical {
    label en unofficial "section 626(b)(4)(A): the amount of the refunding obligations and the aggregate face amount of the refunded obligations";
}
pub relation refunding_amount_ok_626(issue: BondIssue) kind institutional {
    label en official "section 626(b)(4)(A) of Pub. L. 98-369: the refunding amount is within 101 percent of the refunded face amount";
}
@source(IRC_S103_NOTE_4, quote = "\"(A) the amount of the refunding obligations may not exceed 101 percent of the aggregate face amount of the refunded obligations, and")
rule RefundingAmountCap626(issue: BondIssue, refunding: Money, face: Money) strict {
    label en official "section 626(b)(4)(A) of Pub. L. 98-369";
    when refunding_amounts_626(issue, refunding, face);
    when refunding * 100 <= face * 101;
    then refunding_amount_ok_626(issue);
}
relation refunding_maturity_626(issue: BondIssue, matures: Date, refunded_issued: Date) kind empirical {
    label en unofficial "section 626(b)(4)(B): the maturity date of the refunding obligation and the date the refunded (or original) obligation was issued";
}
pub relation refunding_maturity_ok_626(issue: BondIssue) kind institutional {
    label en official "section 626(b)(4)(B) of Pub. L. 98-369: the refunding maturity is within 17 years of the refunded (or original) issue date";
}
@source(IRC_S103_NOTE_4, quote = "\"(B) the maturity date of any refunding obligation may not be later than the date which is 17 years after the date on which the refunded obligation was issued (or, in the case of a series of refundings, the date on which the original obligation was issued).")
rule RefundingMaturityLimit626(issue: BondIssue, matures: Date, issued: Date) strict {
    label en official "section 626(b)(4)(B) of Pub. L. 98-369";
    when refunding_maturity_626(issue, matures, issued);
    when matures <= add_calendar_period(issued, 17 calendar_year);
    then refunding_maturity_ok_626(issue);
}
rule RefundingException626(issue: BondIssue) strict {
    label en official "section 626(b)(4) of Pub. L. 98-369: the exclusive pre-March-15-1984 refunding within the amount and maturity limits";
    when refunding_base_626(issue);
    when refunding_amount_ok_626(issue);
    when refunding_maturity_ok_626(issue);
    then pre1986_amendments_inapplicable(issue, 98369, 626);
}

// =====================================================================
// §626(b)(5): established programs (rows 26/103/note/4/23-27)
// =====================================================================

relation established_program_base_facts_626(issue: BondIssue, substantially_all_proceeds: Boolean, program_30yr_same_form: Boolean) kind empirical {
    label en unofficial "section 626(b)(5): substantially all proceeds carry out the program, and the State-law program has been in effect in substantially the same form during the 30-year period ending on enactment (July 18, 1984)";
}
pub relation established_program_base_626(issue: BondIssue) kind institutional {
    label en official "section 626(b)(5) of Pub. L. 98-369: a qualifying established program carried out by the issue";
}
@source(IRC_S103_NOTE_4, quote = "\"(5) Exception for certain established programs.—The amendments made by this section [amending this section] shall not apply to any obligation substantially all of the proceeds of which are used to carry out a program established under State law which has been in effect in substantially the same form during the 30-year period ending on the date of enactment of this Act [July 18, 1984], but only if such proceeds are used to make loans or to fund similar obligations—")
rule EstablishedProgramBase626(issue: BondIssue) strict {
    label en official "section 626(b)(5) of Pub. L. 98-369, opening clause";
    when established_program_base_facts_626(issue, true, true);
    then established_program_base_626(issue);
}
relation established_program_loan_terms_626(issue: BondIssue, same_manner: Boolean, same_or_lesser_amount: Boolean, same_purposes: Boolean) kind empirical {
    label en unofficial "section 626(b)(5)(A)-(C): the proceeds make loans (or fund similar obligations) in the same manner, in the same (or lesser) amount per participant, and for the same purposes as the program operated on March 15, 1984";
}
pub relation established_program_same_manner_626(issue: BondIssue) kind institutional {
    label en official "section 626(b)(5)(A) of Pub. L. 98-369: the same manner";
}
@source(IRC_S103_NOTE_4, quote = "\"(A) in the same manner in which,")
rule EstablishedProgramManner626(issue: BondIssue) strict {
    label en official "section 626(b)(5)(A) of Pub. L. 98-369";
    when established_program_loan_terms_626(issue, true, _, _);
    then established_program_same_manner_626(issue);
}
pub relation established_program_same_amount_626(issue: BondIssue) kind institutional {
    label en official "section 626(b)(5)(B) of Pub. L. 98-369: the same (or lesser) amount per participant";
}
@source(IRC_S103_NOTE_4, quote = "\"(B) in the same (or lesser) amount per participant, and")
rule EstablishedProgramAmount626(issue: BondIssue) strict {
    label en official "section 626(b)(5)(B) of Pub. L. 98-369";
    when established_program_loan_terms_626(issue, _, true, _);
    then established_program_same_amount_626(issue);
}
pub relation established_program_same_purposes_626(issue: BondIssue) kind institutional {
    label en official "section 626(b)(5)(C) of Pub. L. 98-369: the same purposes";
}
@source(IRC_S103_NOTE_4, quote = "\"(C) for the same purposes for which,")
rule EstablishedProgramPurposes626(issue: BondIssue) strict {
    label en official "section 626(b)(5)(C) of Pub. L. 98-369";
    when established_program_loan_terms_626(issue, _, _, true);
    then established_program_same_purposes_626(issue);
}
relation established_program_operated_626(issue: BondIssue, operated_on_1984_03_15: Boolean) kind empirical {
    label en unofficial "section 626(b)(5), closing sentence: the program was so operated on March 15, 1984";
}
pub relation established_program_window_626(issue: BondIssue) kind institutional {
    label en official "section 626(b)(5) of Pub. L. 98-369, closing sentence: operated on March 15, 1984 and issued before March 15, 1987 (the paragraph does not apply to later obligations; adopted reading: the sunset governs the whole paragraph)";
}
@source(IRC_S103_NOTE_4, quote = "such program was operated on March 15, 1984. This subparagraph shall not apply to obligations issued on or after March 15, 1987.")
rule EstablishedProgramWindow626(issue: BondIssue, issued: Date) strict {
    label en official "section 626(b)(5) of Pub. L. 98-369, closing sentence";
    when established_program_operated_626(issue, true);
    when bond_issue_date_1986_transition(issue, issued);
    when issued < @1987-03-15;
    then established_program_window_626(issue);
}
rule EstablishedProgramException626(issue: BondIssue) strict {
    label en official "section 626(b)(5) of Pub. L. 98-369: the established program operated as required within the window";
    when established_program_base_626(issue);
    when established_program_same_manner_626(issue);
    when established_program_same_amount_626(issue);
    when established_program_same_purposes_626(issue);
    when established_program_window_626(issue);
    then pre1986_amendments_inapplicable(issue, 98369, 626);
}

// =====================================================================
// §626(b)(6): renewable energy property bonds (row 26/103/note/4/28)
// =====================================================================

relation renewable_energy_obligation_626(issue: BondIssue, described_in_cowpta_243: Boolean) kind empirical {
    label en unofficial "section 626(b)(6): the obligation is described in section 243 of the Crude Oil Windfall Profit Tax Act of 1980";
}
@source(IRC_S103_NOTE_4, quote = "\"(6) Certain bonds for renewable energy property.—The amendments made by this section [amending this section] shall not apply to any obligations described in section 243 of the Crude Oil Windfall Profit Tax Act of 1980 [Pub. L. 96–223, set out as a note below].")
rule RenewableEnergyBonds626(issue: BondIssue) strict {
    label en official "section 626(b)(6) of Pub. L. 98-369";
    when renewable_energy_obligation_626(issue, true);
    then pre1986_amendments_inapplicable(issue, 98369, 626);
}

// =====================================================================
// §631(a)(2): inducement resolution before June 19, 1984 (rows 37-39)
// The shielded amendment is the one made by section 621.
// =====================================================================

relation inducement_resolution_date_631(issue: BondIssue, adopted: Date) kind empirical {
    label en unofficial "sections 631(a)(2)(A), (a)(3)(A) and (f)(1): the date the inducement resolution (or other comparable preliminary approval) for the issue or project was adopted";
}
pub relation inducement_before_1984_06_19_631(issue: BondIssue) kind institutional {
    label en official "section 631(a)(2)(A) of Pub. L. 98-369: an inducement resolution (or comparable approval) before June 19, 1984";
}
@source(IRC_S103_NOTE_4, quote = "\"(A) there was an inducement resolution (or other comparable preliminary approval) for the issue before June 19, 1984, and")
rule InducementBeforeJune1984_631a2(issue: BondIssue, adopted: Date) strict {
    label en official "section 631(a)(2)(A) of Pub. L. 98-369";
    when inducement_resolution_date_631(issue, adopted);
    when adopted < @1984-06-19;
    then inducement_before_1984_06_19_631(issue);
}
pub relation issued_before_1985_631a2(issue: BondIssue) kind institutional {
    label en official "section 631(a)(2)(B) of Pub. L. 98-369: the issue is issued before January 1, 1985";
}
@source(IRC_S103_NOTE_4, quote = "\"(B) the issue is issued before January 1, 1985.")
rule IssuedBefore1985_631a2(issue: BondIssue, issued: Date) strict {
    label en official "section 631(a)(2)(B) of Pub. L. 98-369";
    when bond_issue_date_1986_transition(issue, issued);
    when issued < @1985-01-01;
    then issued_before_1985_631a2(issue);
}
@source(IRC_S103_NOTE_4, quote = "\"(2) Inducement resolution before june 19, 1984.—The amendment made by section 621 shall not apply to any issue of obligations if—")
rule Section621InapplicableInducement631a2(issue: BondIssue) strict {
    label en official "section 631(a)(2) of Pub. L. 98-369: the section 621 amendment does not apply to the timely induced, timely issued obligations";
    when inducement_before_1984_06_19_631(issue);
    when issued_before_1985_631a2(issue);
    then pre1986_amendments_inapplicable(issue, 98369, 621);
}

// =====================================================================
// §631(a)(3), first: projects preliminarily approved before
// October 19, 1983 (rows 26/103/note/4/40-44)
// =====================================================================

pub relation preliminary_approval_before_1983_10_19_631a3(issue: BondIssue) kind institutional {
    label en official "section 631(a)(3)(A) of Pub. L. 98-369: an inducement resolution (or comparable approval) for the project before October 19, 1983";
}
@source(IRC_S103_NOTE_4, quote = "\"(A) there was an inducement resolution (or other comparable preliminary approval) for a project before October 19, 1983, by any issuing authority,")
rule PreliminaryApprovalBeforeOct1983_631a3(issue: BondIssue, adopted: Date) strict {
    label en official "section 631(a)(3)(A) of Pub. L. 98-369";
    when inducement_resolution_date_631(issue, adopted);
    when adopted < @1983-10-19;
    then preliminary_approval_before_1983_10_19_631a3(issue);
}
relation substantial_user_notice_631a3(issue: BondIssue, notified: Date) kind empirical {
    label en unofficial "section 631(a)(3)(B): the date a substantial user of the project notified the issuing authority that it claims its rights under the paragraph";
}
pub relation substantial_user_notice_timely_631a3(issue: BondIssue) kind institutional {
    label en official "section 631(a)(3)(B) of Pub. L. 98-369: notice within 30 days after enactment (on or before August 17, 1984; the enactment date July 18, 1984 is the pinned note header)";
}
@source(IRC_S103_NOTE_4, quote = "\"(B) a substantial user of such project notifies the issuing authority within 30 days after the date of the enactment of this Act [July 18, 1984] that it intends to claim its rights under this paragraph, and")
rule SubstantialUserNoticeTimely_631a3(issue: BondIssue, notified: Date) strict {
    label en official "section 631(a)(3)(B) of Pub. L. 98-369";
    when substantial_user_notice_631a3(issue, notified);
    when notified <= add_calendar_period(@1984-07-18, 30 calendar_day);
    then substantial_user_notice_timely_631a3(issue);
}
relation construction_or_contract_631a3(issue: BondIssue, construction_began: Date, binding_contract_on_1983_10_19: Boolean) kind empirical {
    label en unofficial "section 631(a)(3)(C): the date construction of the project began, and whether the substantial user was under a binding contract on October 19, 1983 to incur significant expenditures";
}
pub relation project_started_631a3(issue: BondIssue) kind institutional {
    label en official "section 631(a)(3)(C) of Pub. L. 98-369: construction began before October 19, 1983, or a binding contract to incur significant expenditures was in place on that date";
}
@source(IRC_S103_NOTE_4, quote = "\"(C) construction of such project began before October 19, 1983, or the substantial user was under a binding contract on such date to incur significant expenditures with respect to such project,")
rule ConstructionBeganBeforeOct1983_631a3(issue: BondIssue, began: Date) strict {
    label en official "section 631(a)(3)(C) of Pub. L. 98-369, first branch";
    when construction_or_contract_631a3(issue, began, _);
    when began < @1983-10-19;
    then project_started_631a3(issue);
}
rule BindingContractSignificantExpenditures_631a3(issue: BondIssue) strict {
    label en official "section 631(a)(3)(C) of Pub. L. 98-369, second branch";
    when construction_or_contract_631a3(issue, _, true);
    then project_started_631a3(issue);
}
pub relation limitation_allocated_first_to_project_631a3(issue: BondIssue) kind institutional {
    label en official "section 631(a)(3) of Pub. L. 98-369, closing sentence: the issuing authority allocates its section 103(n) share for the year first to the project (the priority and failure sentences are not quoted by any bound row and are not modeled)";
}
@source(IRC_S103_NOTE_4, quote = "\"(3) Certain projects preliminarily approved before october 19, 1983, given approval.—If—")
rule LimitationAllocatedFirst_631a3(issue: BondIssue) strict {
    label en official "section 631(a)(3) of Pub. L. 98-369: approval, notice and start conditions allocate the limitation first to the project";
    when preliminary_approval_before_1983_10_19_631a3(issue);
    when substantial_user_notice_timely_631a3(issue);
    when project_started_631a3(issue);
    then limitation_allocated_first_to_project_631a3(issue);
}

// =====================================================================
// §631(a)(3), second [(4)]: convention center and resource recovery
// project (rows 26/103/note/4/45-47). The 1984-1987 issue window and the
// substantially-all-proceeds condition come from the closing sentence of
// the same paragraph (fragment literal; no bound row quotes it).
// =====================================================================

relation convention_study_authorized_631(issue: BondIssue, authorized: Date) kind empirical {
    label en unofficial "section 631(a)(3)[(4)](A): the date the city council authorized the convention-center feasibility study";
}
pub relation convention_study_condition_631(issue: BondIssue) kind institutional {
    label en official "section 631(a)(3)[(4)](A) of Pub. L. 98-369: the study was authorized on June 10, 1982";
}
@source(IRC_S103_NOTE_4, quote = "\"(A) the city council of such city authorized a feasibility study for a convention center on June 10, 1982, and")
rule ConventionStudy1982_631(issue: BondIssue, authorized: Date) strict {
    label en official "section 631(a)(3)[(4)](A) of Pub. L. 98-369";
    when convention_study_authorized_631(issue, authorized);
    when authorized >= @1982-06-10;
    when authorized <= @1982-06-10;
    then convention_study_condition_631(issue);
}
relation resource_proposal_accepted_631(issue: BondIssue, accepted: Date) kind empirical {
    label en unofficial "section 631(a)(3)[(4)](B): the date a municipal authority acting for the city accepted the resource-recovery proposal";
}
pub relation resource_proposal_condition_631(issue: BondIssue) kind institutional {
    label en official "section 631(a)(3)[(4)](B) of Pub. L. 98-369: the proposal was accepted on November 4, 1983";
}
@source(IRC_S103_NOTE_4, quote = "\"(B) on November 4, 1983, a municipal authority acting for such city accepted a proposal for the construction of a facility that is capable of generating steam and electricity through the combustion of municipal waste,")
rule ResourceProposal1983_631(issue: BondIssue, accepted: Date) strict {
    label en official "section 631(a)(3)[(4)](B) of Pub. L. 98-369";
    when resource_proposal_accepted_631(issue, accepted);
    when accepted >= @1983-11-04;
    when accepted <= @1983-11-04;
    then resource_proposal_condition_631(issue);
}
relation convention_proceeds_use_631(issue: BondIssue, for_convention_center: Boolean, for_resource_recovery: Boolean) kind empirical {
    label en unofficial "section 631(a)(3)[(4)], closing sentence: substantially all proceeds finance the convention center (with access ramps and parking) or the resource recovery facility";
}
@source(IRC_S103_NOTE_4, quote = "\"(3) [(4)] Exception for certain bonds for a convention center and resource recovery project.—In the case of any city, if—")
rule ConventionCenterException631(issue: BondIssue, issued: Date) strict {
    label en official "section 631(a)(3)[(4)] of Pub. L. 98-369: the section 621 amendment does not apply to the 1984-1987 convention-center issue";
    when convention_study_condition_631(issue);
    when resource_proposal_condition_631(issue);
    when bond_issue_date_1986_transition(issue, issued);
    when issued >= @1984-01-01;
    when issued <= @1987-12-31;
    when convention_proceeds_use_631(issue, true, _);
    then pre1986_amendments_inapplicable(issue, 98369, 621);
}
rule ResourceRecoveryException631(issue: BondIssue, issued: Date) strict {
    label en official "section 631(a)(3)[(4)] of Pub. L. 98-369: the section 621 amendment does not apply to the 1984-1987 resource-recovery issue";
    when convention_study_condition_631(issue);
    when resource_proposal_condition_631(issue);
    when bond_issue_date_1986_transition(issue, issued);
    when issued >= @1984-01-01;
    when issued <= @1987-12-31;
    when convention_proceeds_use_631(issue, _, true);
    then pre1986_amendments_inapplicable(issue, 98369, 621);
}

// =====================================================================
// §631(c)(2): federally insured deposits (row 26/103/note/4/61)
// =====================================================================

pub relation federally_insured_clause_applies_631c2(issue: BondIssue) kind institutional {
    label en official "section 631(c)(2) of Pub. L. 98-369: clause (ii) of section 103(h)(2)(B) applies to the obligation";
}
@source(IRC_S103_NOTE_4, quote = "\"(2) Obligations invested in federally insured deposits.—Notwithstanding any other provision of this section, clause (ii) of section 103(h)(2)(B) of the Internal Revenue Code of 1986 [formerly I.R.C. 1954] (as amended by this subtitle) shall apply to obligations issued after April 14, 1983; except that such clause shall not apply to any obligation issued pursuant to a binding contract in effect on March 4, 1983.")
rule InsuredDepositClauseApplies631c2(issue: BondIssue, issued: Date) strict {
    label en official "section 631(c)(2) of Pub. L. 98-369, main clause: after April 14, 1983";
    when bond_issue_date_1986_transition(issue, issued);
    when issued > @1983-04-14;
    then federally_insured_clause_applies_631c2(issue);
}
relation insured_deposit_binding_contract_631c2(issue: BondIssue, in_effect_on_1983_03_04: Boolean) kind empirical {
    label en unofficial "section 631(c)(2), except clause: the obligation was issued pursuant to a binding contract in effect on March 4, 1983";
}
rule InsuredDepositBindingContract631c2(issue: BondIssue) strict {
    label en official "section 631(c)(2) of Pub. L. 98-369, except clause: the subtitle amendments (section 0) do not reach the binding-contract obligation";
    when insured_deposit_binding_contract_631c2(issue, true);
    then pre1986_amendments_inapplicable(issue, 98369, 0);
}

// =====================================================================
// §631(c)(4): repeal of advance refunding of qualified public
// facilities (row 26/103/note/4/69; the quoted sentences only — the
// Dade County / Alabama sentences have no bound row and are not modeled)
// =====================================================================

relation advance_refunding_631c4(issue: BondIssue, is_refunding_obligation: Boolean) kind empirical {
    label en unofficial "section 631(c)(4): the obligation is a refunding obligation";
}
pub relation advance_refunding_repeal_applies_631c4(issue: BondIssue) kind institutional {
    label en official "section 631(c)(4) of Pub. L. 98-369: the amendment of section 628(g) applies to the refunding obligation";
}
@source(IRC_S103_NOTE_4, quote = "\"(4) Repeal of advance refunding of qualified public facilities.—The amendment made by section 628(g) [amending this section] shall apply to refunding obligations issued after the date of the enactment of this Act [July 18, 1984]; except that if substantially all the proceeds of the refunded issue were used to provide airports or docks, such amendment shall only apply to refunding obligations issued after December 31, 1984.")
rule AdvanceRefundingRepealApplies631c4(issue: BondIssue, issued: Date) strict {
    label en official "section 631(c)(4) of Pub. L. 98-369, first sentence: refunding obligations issued after July 18, 1984";
    when advance_refunding_631c4(issue, true);
    when bond_issue_date_1986_transition(issue, issued);
    when issued > @1984-07-18;
    then advance_refunding_repeal_applies_631c4(issue);
}
relation refunded_airports_docks_631c4(issue: BondIssue, substantially_all_for_airports_or_docks: Boolean) kind empirical {
    label en unofficial "section 631(c)(4), except clause: substantially all proceeds of the refunded issue were used to provide airports or docks";
}
rule AdvanceRefundingAirportsDocks631c4(issue: BondIssue, issued: Date) strict {
    label en official "section 631(c)(4) of Pub. L. 98-369, except clause: airports/docks refundings only after December 31, 1984";
    when advance_refunding_631c4(issue, true);
    when refunded_airports_docks_631c4(issue, true);
    when bond_issue_date_1986_transition(issue, issued);
    when issued > @1984-12-31;
    then advance_refunding_repeal_applies_631c4(issue);
}

// =====================================================================
// §631(d), opening: subtitle inapplicable to described property
// (row 26/103/note/4/73)
// =====================================================================

relation property_described_631d(issue: BondIssue, paragraph: Integer) kind empirical {
    label en unofficial "section 631(d): the paragraph (1-5) whose description the property (or the obligation financing it) meets (case-applied)";
}
pub relation subtitle_inapplicable_631d(issue: BondIssue) kind institutional {
    label en official "section 631(d) of Pub. L. 98-369: the amendments made by subtitle D (sections 621-632) do not apply to the property or to obligations financing it";
}
@source(IRC_S103_NOTE_4, quote = "\"(d) Provisions of This Subtitle Not To Apply to Certain Property.—The amendments made by this subtitle [sections 621–632 of Pub. L. 98–369, amending this section and sections 103A and 168 of this title and enacting provisions set out as notes under this section] shall not apply to any property (and shall not apply to obligations issued to finance such property) if such property is described in any of the following paragraphs:")
rule SubtitleInapplicableDescribedProperty631d(issue: BondIssue, paragraph: Integer) strict {
    label en official "section 631(d) of Pub. L. 98-369";
    when property_described_631d(issue, paragraph);
    when paragraph >= 1;
    when paragraph <= 5;
    then subtitle_inapplicable_631d(issue);
}

// =====================================================================
// §631(d)(4): solid waste disposal facility (rows 26/103/note/4/77-80;
// row 77 follows the pinned note, "1986"; the PL section text says
// "1954" — systematic OLRC remarking, see the wire-g3 journal)
// =====================================================================

relation solid_waste_facility_631d4(issue: BondIssue, described_in_103b4E: Boolean) kind empirical {
    label en unofficial "section 631(d)(4): the property is a solid waste disposal facility described in section 103(b)(4)(E)";
}
pub relation solid_waste_base_631d4(issue: BondIssue) kind institutional {
    label en official "section 631(d)(4) of Pub. L. 98-369: a described solid waste disposal facility";
}
@source(IRC_S103_NOTE_4, quote = "\"(4) Any solid waste disposal facility described in section 103(b)(4)(E) of the Internal Revenue Code of 1986 if—")
rule SolidWasteFacility631d4(issue: BondIssue) strict {
    label en official "section 631(d)(4) of Pub. L. 98-369, opening clause";
    when solid_waste_facility_631d4(issue, true);
    then solid_waste_base_631d4(issue);
}
relation authority_legislation_631d4(issue: BondIssue, legislation_effective: Date) kind empirical {
    label en unofficial "section 631(d)(4)(A): the date the State legislation creating the public authority took effect";
}
relation authority_formal_action_631d4(issue: BondIssue, acted: Date) kind empirical {
    label en unofficial "section 631(d)(4)(A): the date the authority took formal action to commit development funds for the facility";
}
pub relation authority_condition_631d4(issue: BondIssue) kind institutional {
    label en official "section 631(d)(4)(A) of Pub. L. 98-369: legislation effective June 18, 1973 and formal action before October 19, 1983";
}
@source(IRC_S103_NOTE_4, quote = "\"(A) a State public authority created pursuant to State legislation which took effect on June 18, 1973, took formal action before October 19, 1983, to commit development funds for such facility.")
rule AuthorityActionBeforeOct1983_631d4(issue: BondIssue, law_on: Date, acted: Date) strict {
    label en official "section 631(d)(4)(A) of Pub. L. 98-369";
    when authority_legislation_631d4(issue, law_on);
    when law_on >= @1973-06-18;
    when law_on <= @1973-06-18;
    when authority_formal_action_631d4(issue, acted);
    when acted < @1983-10-19;
    then authority_condition_631d4(issue);
}
pub relation authority_issues_condition_631d4(issue: BondIssue) kind institutional {
    label en official "section 631(d)(4)(B) of Pub. L. 98-369: the authority issues obligations for the facility before January 1, 1987";
}
@source(IRC_S103_NOTE_4, quote = "\"(B) such authority issues obligations for any such facility before January 1, 1987, and")
rule AuthorityIssuesBefore1987_631d4(issue: BondIssue, issued: Date) strict {
    label en official "section 631(d)(4)(B) of Pub. L. 98-369";
    when bond_issue_date_1986_transition(issue, issued);
    when issued < @1987-01-01;
    then authority_issues_condition_631d4(issue);
}
relation development_expenditures_631d4(issue: BondIssue, made: Date) kind empirical {
    label en unofficial "section 631(d)(4)(C): the date expenditures for the development of the facility were made";
}
pub relation expenditures_condition_631d4(issue: BondIssue) kind institutional {
    label en official "section 631(d)(4)(C) of Pub. L. 98-369: development expenditures before October 19, 1983";
}
@source(IRC_S103_NOTE_4, quote = "\"(C) expenditures have been made for the development of any such facility before October 19, 1983.")
rule DevelopmentExpendituresBeforeOct1983_631d4(issue: BondIssue, made: Date) strict {
    label en official "section 631(d)(4)(C) of Pub. L. 98-369";
    when development_expenditures_631d4(issue, made);
    when made < @1983-10-19;
    then expenditures_condition_631d4(issue);
}
rule SolidWasteException631d4(issue: BondIssue) strict {
    label en official "section 631(d)(4) of Pub. L. 98-369: the described facility with timely authority action, issuance and expenditures leaves the subtitle amendments inapplicable";
    when solid_waste_base_631d4(issue);
    when authority_condition_631d4(issue);
    when authority_issues_condition_631d4(issue);
    when expenditures_condition_631d4(issue);
    then subtitle_inapplicable_631d(issue);
}

// =====================================================================
// §631(e): significant expenditures (rows 26/103/note/4/86-89).
// "The lesser of" is two sufficient rules: reaching either prong
// reaches the lesser.
// =====================================================================

relation expenditure_amounts_631e(issue: BondIssue, spent: Money, estimated_cost: Money) kind empirical {
    label en unofficial "section 631(e)(1): the expenditures incurred and the estimated cost of the facilities";
}
pub relation significant_expenditures_631e(issue: BondIssue) kind institutional {
    label en official "section 631(e)(1) of Pub. L. 98-369: significant expenditures (at least the lesser of $15,000,000 and 20 percent of estimated cost)";
}
@source(IRC_S103_NOTE_4, quote = "\"(1) In general.—For purposes of this section, the term 'significant expenditures' means expenditures which equal or exceed the lesser of—")
rule SignificantExpendituresByAmount631e(issue: BondIssue, spent: Money, cost: Money) strict {
    label en official "section 631(e)(1)(A) of Pub. L. 98-369: $15,000,000 or more reaches the lesser";
    when expenditure_amounts_631e(issue, spent, cost);
    when spent >= 15000000.00 USD;
    then significant_expenditures_631e(issue);
}
@source(IRC_S103_NOTE_4, quote = "\"(B) 20 percent of the estimated cost of the facilities.")
rule SignificantExpendituresByShare631e(issue: BondIssue, spent: Money, cost: Money) strict {
    label en official "section 631(e)(1)(B) of Pub. L. 98-369: 20 percent or more of estimated cost reaches the lesser (exact cross multiplication)";
    when expenditure_amounts_631e(issue, spent, cost);
    when cost > 0.00 USD;
    when spent * 5 >= cost;
    then significant_expenditures_631e(issue);
}
relation udag_grant_approved_631e2(issue: BondIssue, amount: Money, approved: Date) kind empirical {
    label en unofficial "section 631(e)(2): the amount of a UDAG grant for the facility and the date it was preliminarily approved";
}
pub relation udag_grant_counts_as_expenditure_631e2(issue: BondIssue, amount: Money) kind institutional {
    label en official "section 631(e)(2) of Pub. L. 98-369: the UDAG grant amount counts as an expenditure (aggregation with other expenditures is case-side)";
}
@source(IRC_S103_NOTE_4, quote = "\"(2) Certain grants treated as expenditures.—For purposes of paragraph (1), the amount of any UDAG grant preliminarily approved on May 5, 1981, or April 4, 1983, shall be treated as an expenditure with respect to the facility for which such grant was so approved.")
rule UdagGrantCountsAsExpenditure1981_631e2(issue: BondIssue, amount: Money, approved: Date) strict {
    label en official "section 631(e)(2) of Pub. L. 98-369: approved May 5, 1981";
    when udag_grant_approved_631e2(issue, amount, approved);
    when approved >= @1981-05-05;
    when approved <= @1981-05-05;
    then udag_grant_counts_as_expenditure_631e2(issue, amount);
}
rule UdagGrantCountsAsExpenditure1983_631e2(issue: BondIssue, amount: Money, approved: Date) strict {
    label en official "section 631(e)(2) of Pub. L. 98-369: approved April 4, 1983";
    when udag_grant_approved_631e2(issue, amount, approved);
    when approved >= @1983-04-04;
    when approved <= @1983-04-04;
    then udag_grant_counts_as_expenditure_631e2(issue, amount);
}

// =====================================================================
// §631(f): exceptions for certain other amendments (rows 26/103/note/4/90-96)
// =====================================================================

pub relation other_amendments_inducement_631f(issue: BondIssue) kind institutional {
    label en official "section 631(f)(1) of Pub. L. 98-369: an inducement resolution (or comparable approval) for the issue before June 19, 1984";
}
@source(IRC_S103_NOTE_4, quote = "\"(1) there was an inducement resolution (or other comparable preliminary approval) for an issue before June 19, 1984, by any issuing authority, and")
rule OtherAmendmentsInducement631f(issue: BondIssue, adopted: Date) strict {
    label en official "section 631(f)(1) of Pub. L. 98-369";
    when inducement_resolution_date_631(issue, adopted);
    when adopted < @1984-06-19;
    then other_amendments_inducement_631f(issue);
}
pub relation other_amendments_issued_631f(issue: BondIssue) kind institutional {
    label en official "section 631(f)(2) of Pub. L. 98-369: the issue is issued before January 1, 1985";
}
@source(IRC_S103_NOTE_4, quote = "\"(2) such issue is issued before January 1, 1985, the following amendments shall not apply:")
rule OtherAmendmentsIssued631f(issue: BondIssue, issued: Date) strict {
    label en official "section 631(f)(2) of Pub. L. 98-369, opening clause";
    when bond_issue_date_1986_transition(issue, issued);
    when issued < @1985-01-01;
    then other_amendments_issued_631f(issue);
}
pub relation other_amendments_shield_631f(issue: BondIssue) kind institutional {
    label en official "section 631(f) of Pub. L. 98-369: the timely induced, timely issued bond carries the shield of the paragraph";
}
@source(IRC_S103_NOTE_4, quote = "\"(f) Exceptions for Certain Other Amendments.—If—")
rule OtherAmendmentsShield631f(issue: BondIssue) strict {
    label en official "section 631(f) of Pub. L. 98-369";
    when other_amendments_inducement_631f(issue);
    when other_amendments_issued_631f(issue);
    then other_amendments_shield_631f(issue);
}
@source(IRC_S103_NOTE_4, quote = "\"(A) the amendments made by section 623 [amending this section],")
rule Amendments623Inapplicable631f(issue: BondIssue) strict {
    label en official "section 631(f)(2)(A) of Pub. L. 98-369: the section 623 amendments do not apply";
    when other_amendments_shield_631f(issue);
    then pre1986_amendments_inapplicable(issue, 98369, 623);
}
relation farm_land_related_631f(issue: BondIssue, relates_to_farm_land: Boolean) kind empirical {
    label en unofficial "section 631(f)(2)(B), parenthetical: the extent to which the section 627(a)-(b) amendments relate to farm land (that extent keeps the amendments applicable)";
}
@source(IRC_S103_NOTE_4, quote = "\"(B) the amendments made by subsections (a) and (b) of section 627 [amending this section] (except to the extent such amendments relate to farm land),")
rule Amendments627abInapplicable631f(issue: BondIssue) strict {
    label en official "section 631(f)(2)(B) of Pub. L. 98-369: the section 627(a)-(b) amendments do not apply where they do not relate to farm land (fail-closed: the case states non-relation)";
    when other_amendments_shield_631f(issue);
    when farm_land_related_631f(issue, false);
    then pre1986_amendments_inapplicable(issue, 98369, 627);
}
relation race_track_631f(issue: BondIssue, is_race_track: Boolean) kind empirical {
    label en unofficial "section 631(f)(2)(C): the facility is a race track";
}
@source(IRC_S103_NOTE_4, quote = "\"(C) in the case of a race track, the amendment made by section 627(c) [amending this section], and")
rule Amendments627cRaceTrack631f(issue: BondIssue) strict {
    label en official "section 631(f)(2)(C) of Pub. L. 98-369: the section 627(c) amendment does not apply to the race track";
    when other_amendments_shield_631f(issue);
    when race_track_631f(issue, true);
    then pre1986_amendments_inapplicable(issue, 98369, 627);
}
@source(IRC_S103_NOTE_4, quote = "\"(D) the amendments made by section 628(c) [amending this section].\"")
rule Amendments628cInapplicable631f(issue: BondIssue) strict {
    label en official "section 631(f)(2)(D) of Pub. L. 98-369: the section 628(c) amendments do not apply";
    when other_amendments_shield_631f(issue);
    then pre1986_amendments_inapplicable(issue, 98369, 628);
}

// =====================================================================
// TEFRA §215(c)(1): public-approval refunding (rows 26/103/note/4/108-109).
// The "issued after December 31, 1982" condition comes from the closing
// fragment sentence of (c)(1) (no bound row quotes it).
// =====================================================================

relation tefra215_refund_facts(issue: BondIssue, refunded: BondIssue, solely_to_refund: Boolean) kind empirical {
    label en unofficial "section 215(c)(1) of Pub. L. 97-248: the obligation is issued solely to refund the earlier obligation";
}
relation refunded_issue_date_215(refunded: BondIssue, issued: Date) kind empirical {
    label en unofficial "section 215(c)(1)(A): the date the refunded obligation was issued";
}
pub relation refunded_issued_before_1982_07_01_215(refunded: BondIssue) kind institutional {
    label en official "section 215(c)(1)(A) of Pub. L. 97-248: the refunded obligation was issued before July 1, 1982";
}
@source(IRC_S103_NOTE_4, quote = "\"(A) was issued before July 1, 1982, and")
rule RefundedIssuedBefore1982_215(refunded: BondIssue, issued: Date) strict {
    label en official "section 215(c)(1)(A) of Pub. L. 97-248";
    when refunded_issue_date_215(refunded, issued);
    when issued < @1982-07-01;
    then refunded_issued_before_1982_07_01_215(refunded);
}
relation refunded_term_215(refunded: BondIssue, years: Decimal) kind empirical {
    label en unofficial "section 215(c)(1)(B): the maturity of the refunded obligation in years";
}
pub relation refunded_maturity_within_3_years_215(refunded: BondIssue) kind institutional {
    label en official "section 215(c)(1)(B) of Pub. L. 97-248: the refunded maturity does not exceed 3 years";
}
@source(IRC_S103_NOTE_4, quote = "\"(B) has a maturity which does not exceed 3 years.")
rule RefundedMaturityWithin3Years215(refunded: BondIssue, years: Decimal) strict {
    label en official "section 215(c)(1)(B) of Pub. L. 97-248";
    when refunded_term_215(refunded, years);
    when years <= 3.0;
    then refunded_maturity_within_3_years_215(refunded);
}
rule PublicApprovalInapplicableRefund215(issue: BondIssue, refunded: BondIssue, issued: Date) strict {
    label en official "section 215(c)(1) of Pub. L. 97-248: the public-approval amendment does not reach the post-1982 refunding of a short pre-July-1982 obligation";
    when tefra215_refund_facts(issue, refunded, true);
    when bond_issue_date_1986_transition(issue, issued);
    when issued > @1982-12-31;
    when refunded_issued_before_1982_07_01_215(refunded);
    when refunded_maturity_within_3_years_215(refunded);
    then pre1986_amendments_inapplicable(issue, 97248, 215);
}

// =====================================================================
// TEFRA §221(d)(2): mortgage subsidy bond exception (row 26/103/note/4/115)
// =====================================================================

relation msbta_1103_1104_facts_221(issue: BondIssue, section_1103_inapplicable_by_1104: Boolean) kind empirical {
    label en unofficial "section 221(d)(2): the amendments of section 1103 of the Mortgage Subsidy Bond Tax Act of 1980 do not apply to the obligation by reason of section 1104 of that Act";
}
@source(IRC_S103_NOTE_4, quote = "\"(2) Exception.—The amendments made by this section shall not apply with respect to any obligation to which the amendments made by section 1103 of the Mortgage Subsidy Bond Tax Act of 1980 [section 1103 of Pub. L. 96–499, amending this section] do not apply by reason of section 1104 of such Act [section 1104 of Pub. L. 96–499, formerly set out as a note under section 103A of this title].")
rule Tefra221MsbtaException221(issue: BondIssue) strict {
    label en official "section 221(d)(2) of Pub. L. 97-248";
    when msbta_1103_1104_facts_221(issue, true);
    then pre1986_amendments_inapplicable(issue, 97248, 221);
}
