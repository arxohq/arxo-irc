// Stage 2f (TECH_GAP reduction) — residual sub-provisions of small sections of
// Parts II-V of Subchapter B: §79(d)(3)(B) and (d)(5), §86(e), §111(c)-(d),
// §112(d)(3), §130(c) last sentence, §132(k)-(n) and (f)(8), (g)(2),
// §137(e)-(f), §139(e),(h), §139B(c), §139C(c)-(d), §139D(b)-(d),
// §139E(b)-(c), §139F(b)-(c), §139G(c)-(d), §104(a)(6) tail, §125(e),(g),(h),
// §151(c),(d)(3).
// STATUS: implemented_unverified (static check only; scenarios are written in
// tests/s2f-a-small-residuals.lawtest and are NOT executed).
//
// CONVENTIONS: the guards below compare the exact statutory numbers; facts the
// package cannot derive (a status of another section, a finding by the
// Secretary) are empirical relations asserted by the case, each labelled with
// the subsection that names it. Aggregates read empirical relations only
// (DECISION-0111 subset limit).

// =====================================================================
// §79(d)(3)(B): employees excluded from the 70 percent test; (d)(5)
// =====================================================================

use self::{
    GroupTermLifePlan,
    IRC_S111_C,
    IRC_S111_D,
    IRC_S112_D,
    IRC_S79_D,
    IRC_S86_E,
    Individual,
    Person,
    TaxableYear,
    plan_benefit_amount_uniform_relation_to_compensation,
    plan_benefits_available_to_all_participants,
    plan_benefits_nondiscriminatory_79d,
    plan_eligibility_nondiscriminatory_79d,
};

relation gt_employee_counts_before_exclusions_79d3(plan: GroupTermLifePlan, all: Integer, benefited: Integer) kind empirical {
    label en official "the number of all employees of the employer and the number benefited by the plan BEFORE the section 79(d)(3)(B) exclusions are applied";
}
relation gt_excluded_short_part_time_nra_79d3B(plan: GroupTermLifePlan, all: Integer, benefited: Integer) kind empirical {
    label en official "the number of employees (all / benefited by the plan) who have not completed 3 years of service, are part-time or seasonal, or are nonresident aliens with no US-source earned income from the employer (section 79(d)(3)(B)(i), (ii), (iv))";
}
relation gt_excluded_collective_bargaining_79d3Biii(plan: GroupTermLifePlan, all: Integer, benefited: Integer) kind empirical {
    label en official "the number of employees (all / benefited) not included in the plan who are in a unit covered by a collective bargaining agreement (section 79(d)(3)(B)(iii))";
}
relation gt_benefits_were_good_faith_bargained_79d3Biii(plan: GroupTermLifePlan) kind empirical {
    label en official "the benefits provided under the plan were the subject of good faith bargaining between the employee representatives and the employer or employers (section 79(d)(3)(B)(iii))";
}
pub relation gt_employees_counted_79d3(plan: GroupTermLifePlan, all: Integer, benefited: Integer) kind institutional {
    label en official "the numbers of employees (all / benefited) taken into account by section 79(d)(3)(A)(i) after the section 79(d)(3)(B) exclusions";
}
@source(IRC_S79_D, relation = formalizes, coverage = partial, quote = "employees who have not completed 3 years of service;")
rule EmployeesCountedWithoutBargainingExclusion(plan: GroupTermLifePlan, all: Integer, benefited: Integer, x_all: Integer, x_ben: Integer) strict {
    label en official "section 79(d)(3)(B)(i), (ii), (iv): the excluded employees are removed from both the total and the benefited counts; the collective-bargaining exclusion (iii) does not apply without good faith bargaining";
    when gt_employee_counts_before_exclusions_79d3(plan, all, benefited);
    when gt_excluded_short_part_time_nra_79d3B(plan, x_all, x_ben);
    when not_known(gt_benefits_were_good_faith_bargained_79d3Biii(plan));
    then gt_employees_counted_79d3(plan, all - x_all, benefited - x_ben);
}
@source(IRC_S79_D, relation = formalizes, coverage = partial, quote = "if the benefits provided under the plan were the subject of good faith bargaining between such employee representatives and such employer or employers;")
rule EmployeesCountedWithBargainingExclusion(plan: GroupTermLifePlan, all: Integer, benefited: Integer, x_all: Integer, x_ben: Integer, c_all: Integer, c_ben: Integer) strict {
    label en official "section 79(d)(3)(B)(iii): collective-bargaining employees are also excluded when the benefits were the subject of good faith bargaining";
    when gt_employee_counts_before_exclusions_79d3(plan, all, benefited);
    when gt_excluded_short_part_time_nra_79d3B(plan, x_all, x_ben);
    when gt_excluded_collective_bargaining_79d3Biii(plan, c_all, c_ben);
    when gt_benefits_were_good_faith_bargained_79d3Biii(plan);
    then gt_employees_counted_79d3(plan, all - x_all - c_all, benefited - x_ben - c_ben);
}
@source(IRC_S79_D, relation = formalizes, coverage = partial, quote = "(i) such plan benefits 70 percent or more of all employees of the employer,")
rule EligibilityNondiscriminatory70PercentAfterExclusions(plan: GroupTermLifePlan, all: Integer, benefited: Integer) strict {
    label en official "section 79(d)(3)(A)(i) applied to the counts left after the (d)(3)(B) exclusions: benefited x 100 >= 70 x all";
    when gt_employees_counted_79d3(plan, all, benefited);
    when all > 0;
    when benefited * 100 >= all * 70;
    then plan_eligibility_nondiscriminatory_79d(plan);
}
@source(IRC_S79_D, relation = formalizes, coverage = exact, quote = "A plan shall not fail to meet the requirements of paragraph (2)(B) merely because the amount of life insurance on behalf of the employees under the plan bears a uniform relationship to the total compensation or the basic or regular rate of compensation of such employees.")
rule BenefitsNondiscriminatoryDespiteUniformRelationship(plan: GroupTermLifePlan) strict {
    label en official "section 79(d)(5): a uniform relationship of the insurance amount to compensation does not by itself defeat the (d)(2)(B) requirement, when the benefits are available to all participants";
    when plan_benefit_amount_uniform_relation_to_compensation(plan);
    when plan_benefits_available_to_all_participants(plan);
    then plan_benefits_nondiscriminatory_79d(plan);
}

// =====================================================================
// §86(e): lump-sum election
// =====================================================================

relation lump_sum_prior_year_portion_received_86e1A(p: Individual, y: TaxableYear) kind empirical {
    label en official "a portion of a lump-sum payment of social security benefits received during the year is attributable to prior taxable years (section 86(e)(1)(A))";
}
relation elects_lump_sum_limitation_86e(p: Individual, y: TaxableYear) kind empirical {
    label en official "the taxpayer makes the election under section 86(e) for the taxable year, at the time and in the manner the Secretary prescribes (section 86(e)(1)(B), (2)(B))";
}
relation lump_sum_limitation_election_in_effect_86e(p: Individual, y: TaxableYear) kind institutional {
    label en official "the section 86(e) election is in effect for the taxable year";
}
@source(IRC_S86_E, relation = formalizes, coverage = partial, quote = "the taxpayer makes an election under this subsection for the taxable year")
rule Section86eElectionRule defeasible {
    for p: Individual;
    for y: TaxableYear;
    when lump_sum_prior_year_portion_received_86e1A(p, y);
    then power Section86eLumpSumElection {
        holder p;
        over y;
        exercise elects_lump_sum_limitation_86e(p, y);
        valid_when lump_sum_prior_year_portion_received_86e1A(p, y);
        effect create(lump_sum_limitation_election_in_effect_86e(p, y));
        window [-infinity, infinity];
    };
}
relation included_by_reason_of_lump_sum_portion_86e(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount included in gross income under section 86 for the year by reason of the receipt of the prior-year portion of the lump sum (the increase in the year's inclusion caused by that portion)";
}
relation prior_year_increase_from_lump_sum_portion_86e(p: Individual, y: TaxableYear, prior_year: TaxableYear, amount: Money) kind empirical {
    label en official "the increase in gross income under this chapter for a prior taxable year that would result solely from taking the portion into account in the taxable year to which it is attributable (each such increase is computed outside this package: it re-runs section 86 for that year, TECH-GAPS G1562 class)";
}
relation lump_sum_portion_prior_years_index_86e(p: Individual, y: TaxableYear, prior_year: TaxableYear) kind empirical {
    label en official "the prior taxable year is one to which a portion of the lump sum is attributable (section 86(e)(2)(A): the generally applicable payment date of the benefit fell in that year)";
}
pub relation lump_sum_inclusion_limited_86e(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount included in gross income for the year by reason of the lump-sum portion after the section 86(e)(1) cap: not more than the sum of the increases for prior taxable years";
}
@source(IRC_S86_E, relation = formalizes, coverage = partial, quote = "shall not exceed the sum of the increases in gross income under this chapter for prior taxable years")
rule LumpSumInclusionLimited(p: Individual, y: TaxableYear, incl: Money) strict {
    label en official "section 86(e)(1): with the election in effect, the inclusion by reason of the prior-year portion is the lesser of that inclusion and the sum of the prior-year increases";
    when lump_sum_limitation_election_in_effect_86e(p, y);
    when included_by_reason_of_lump_sum_portion_86e(p, y, incl);
    then lump_sum_inclusion_limited_86e(p, y, min(incl, sum(collect all a: Money, py: TaxableYear where prior_year_increase_from_lump_sum_portion_86e(p, y, py, a) and lump_sum_portion_prior_years_index_86e(p, y, py), empty: 0.00 USD)));
}
pub relation benefit_attributable_to_taxable_year_86e2A(p: Individual, y: TaxableYear, payment_date: Date) kind institutional {
    label en official "a social security benefit whose generally applicable payment date is the given date is attributable to the taxable year that contains that date (section 86(e)(2)(A))";
}
relation benefit_generally_applicable_payment_date_86e2A(p: Individual, y: TaxableYear, payment_date: Date) kind empirical {
    label en official "the generally applicable payment date of a benefit (asserted against the taxable year of the question)";
}
@source(IRC_S86_E, relation = formalizes, coverage = exact, quote = "a social security benefit is attributable to a taxable year if the generally applicable payment date for such benefit occurred during such taxable year.")
rule BenefitAttributableToTaxableYear(p: Individual, y: TaxableYear, d: Date, b: Date, e: Date) strict {
    label en official "section 86(e)(2)(A): the payment date lies within the taxable year (inclusive of its first and last day)";
    when benefit_generally_applicable_payment_date_86e2A(p, y, d);
    when us.irc.core::begins(y, b);
    when us.irc.core::ends(y, e);
    when d >= b;
    when d <= e;
    then benefit_attributable_to_taxable_year_86e2A(p, y, d);
}
relation consent_of_secretary_to_revoke_86e(p: Individual, y: TaxableYear) kind empirical {
    label en official "the Secretary consents to the revocation of the section 86(e) election";
}
relation revokes_lump_sum_election_86e2B(p: Individual, y: TaxableYear) kind empirical {
    label en official "the taxpayer revokes the section 86(e) election";
}
relation lump_sum_election_revoked_86e2B(p: Individual, y: TaxableYear) kind institutional {
    label en official "the election is revoked (only with the consent of the Secretary)";
}
@source(IRC_S86_E, relation = formalizes, coverage = exact, quote = "Such election, once made, may be revoked only with the consent of the Secretary.")
rule Section86eRevocationRule defeasible {
    for p: Individual;
    for y: TaxableYear;
    when lump_sum_limitation_election_in_effect_86e(p, y);
    then power Section86eRevocation {
        holder p;
        over y;
        exercise revokes_lump_sum_election_86e2B(p, y);
        valid_when consent_of_secretary_to_revoke_86e(p, y);
        effect create(lump_sum_election_revoked_86e2B(p, y));
        window [-infinity, infinity];
    };
}

// =====================================================================
// §111(c): increase of an unexpired carryover counts as a reduction of tax
// =====================================================================

pub entity CarryoverIncrease111 {
    label en unofficial "an increase, caused by a prior-year deduction, of a tax carryover (case-asserted)";
}
relation carryover_increase_from_recovered_deduction_111c(p: Individual, y: TaxableYear, item: CarryoverIncrease111, amount: Money, expires_on: Date, year_begins_on: Date) kind empirical {
    label en official "an increase in a carryover caused by the prior-year deduction now recovered, its amount, the date on which the carryover expires and the first day of the taxable year in which the recovery takes place (section 111(c))";
}
pub relation carryover_increase_counted_as_tax_reduction_111c(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the total of the increases in carryovers that had not expired before the beginning of the recovery year, which are treated as reducing the tax imposed by this chapter";
}
@source(IRC_S111_C, relation = formalizes, coverage = exact, quote = "an increase in a carryover which has not expired before the beginning of the taxable year in which the recovery or adjustment takes place shall be treated as reducing tax imposed by this chapter.")
rule CarryoverIncreaseCountedAsTaxReduction(p: Individual, y: TaxableYear, item: CarryoverIncrease111) strict {
    label en official "section 111(c): the sum of the increases whose expiry date is not before the beginning of the recovery year";
    when carryover_increase_from_recovered_deduction_111c(p, y, item, _, _, _);
    then carryover_increase_counted_as_tax_reduction_111c(p, y, sum(collect all a: Money, i: CarryoverIncrease111, e: Date, b: Date where carryover_increase_from_recovered_deduction_111c(p, y, i, a, e, b) and e >= b, empty: 0.00 USD));
}

// =====================================================================
// §111(d): accumulated earnings tax and personal holding company tax
// =====================================================================

relation recovery_excludable_for_other_purposes_111d1(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "an excluded amount under section 111(a) allowed for the purposes of the subtitle other than sections 531 or 541 (section 111(d)(1))";
}
relation recovered_amount_not_allowable_other_subtitle_but_allowable_531_541(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the excluded amount was not allowable as a deduction for the prior year for the subtitle other than sections 531 or 541 but was allowable for the same year under section 531 or 541 (section 111(d)(2))";
}
relation recovery_reduced_531_541_tax_111d2(p: Person, y: TaxableYear) kind empirical {
    label en official "the amount resulted in a reduction of the tax under section 531 or section 541";
}
pub relation excluded_amount_for_531_541_111d(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount excluded under section 111(a) when the accumulated earnings tax (section 531) or the personal holding company tax (section 541) is determined";
}
@source(IRC_S111_D, relation = formalizes, coverage = exact, quote = "any excluded amount under subsection (a) allowed for the purposes of this subtitle (other than section 531 or section 541) shall be allowed whether or not such amount resulted in a reduction of the tax under section 531 or the tax under section 541 for the prior taxable year")
rule ExcludedAmountAllowedFor531And541WhetherOrNotReduced(p: Person, y: TaxableYear, amount: Money) strict {
    label en official "section 111(d)(1)";
    when recovery_excludable_for_other_purposes_111d1(p, y, amount);
    then excluded_amount_for_531_541_111d(p, y, amount);
}
@source(IRC_S111_D, relation = formalizes, coverage = exact, quote = "then such excluded amount shall be allowable if it did not result in a reduction of the tax under section 531 or the tax under section 541.")
rule ExcludedAmountAllowableUnder531Or541Only(p: Person, y: TaxableYear, amount: Money) strict {
    label en official "section 111(d)(2): allowable under section 531 or 541 when it did not reduce the tax under those sections";
    when recovered_amount_not_allowable_other_subtitle_but_allowable_531_541(p, y, amount);
    when not_known(recovery_reduced_531_541_tax_111d2(p, y));
    then excluded_amount_for_531_541_111d(p, y, amount);
}

// =====================================================================
// §112(d)(3): the Vietnam conflict; missing status
// =====================================================================

relation vietnam_conflict_termination_designated_112d3(terminated_on: Date) kind empirical {
    label en official "the date designated by the President by Executive order as the date of the termination of combatant activities in Vietnam (section 112(d)(3))";
}
relation vietnam_conflict_not_yet_terminated_on_112d3(d: Date) kind empirical {
    label en official "no termination date has been designated as of the date (section 112(d)(3), the conflict still continues)";
}
pub relation date_within_vietnam_conflict_112d3(d: Date) kind institutional {
    label en official "the date lies within the Vietnam conflict: it began February 28, 1961 and ends on the date designated by Executive order";
}
@source(IRC_S112_D, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, the Vietnam conflict began February 28, 1961")
rule DateWithinVietnamConflictAfterTermination(d: Date, t: Date) strict {
    label en official "section 112(d)(3): the conflict began on 1961-02-28 and ends on the designated date";
    when vietnam_conflict_termination_designated_112d3(t);
    when vietnam_date_query_112d3(d);
    when d >= @1961-02-28;
    when d <= t;
    then date_within_vietnam_conflict_112d3(d);
}
relation vietnam_date_query_112d3(d: Date) kind empirical {
    label en official "a date asked about (a month start, a status start)";
}
@source(IRC_S112_D, relation = formalizes, coverage = exact, quote = "the Vietnam conflict began February 28, 1961, and ends on the date designated by the President by Executive order as the date of the termination of combatant activities in Vietnam.")
rule DateWithinVietnamConflictOngoing(d: Date) strict {
    label en official "section 112(d)(3): before any termination date is designated the conflict continues";
    when vietnam_conflict_not_yet_terminated_on_112d3(d);
    when d >= @1961-02-28;
    then date_within_vietnam_conflict_112d3(d);
}
relation service_in_vietnam_or_southeast_asia_direct_support_before_status(p: Individual, status_start: Date) kind empirical {
    label en official "immediately before the status began the individual was performing service in Vietnam or in Southeast Asia in direct support of military operations in Vietnam (section 112(d)(3))";
}
pub relation missing_status_as_result_of_vietnam_conflict_112d3(p: Individual, status_start: Date) kind institutional {
    label en official "the individual is in a missing status as a result of the Vietnam conflict";
}
@source(IRC_S112_D, relation = formalizes, coverage = exact, quote = "an individual is in a missing status as a result of the Vietnam conflict if immediately before such status began he was performing service in Vietnam or was performing service in Southeast Asia in direct support of military operations in Vietnam.")
rule MissingStatusAsResultOfVietnamConflict(p: Individual, status_start: Date) strict {
    label en official "section 112(d)(3), second sentence";
    when service_in_vietnam_or_southeast_asia_direct_support_before_status(p, status_start);
    when date_within_vietnam_conflict_112d3(status_start);
    then missing_status_as_result_of_vietnam_conflict_112d3(p, status_start);
}
