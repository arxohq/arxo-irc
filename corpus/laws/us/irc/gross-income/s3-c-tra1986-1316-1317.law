rule NamedEffect1317P21B(issue: BondIssue) strict {
    label en official "section 1317(21)(B): section 148(c)(2) and (f) do not apply to the bonds";
    when named_exception_applies_1986(issue, 1317, 21, 2);
    then named_exception_effect_1986(issue, Section148c2AndFInapplicable);
