// Stage 3 (TECH_GAP reduction): Pub. L. 99-514 (Tax Reform Act of 1986) section 1315(d)(3)-(6),
// section 1316 (established State programs, bonds under the Tax Reform Act of 1984) and the
// paragraphs of section 1317 that are conditions rather than lists of named facilities, quoted in
// the statutory note under section 141 (fragment IRC_S141_NOTE_6). The list-style paragraphs of
// section 1317 (a facility "described in this subparagraph if ...") are GENERATED into
// s3-d-tra1986-named-lists.law from the same note.
// STATUS: implemented_unverified (static check only; scenarios in tests/s3-c-tra1986-1316-1317.lawtest
// are NOT executed).
//
// SHAPE. Every named exception is a case of `named_exception_matches_1986(issue, section,
// paragraph, subparagraph)`, an EXTERNAL JUDGMENT (DECISION-0194): the text describes a facility,
// an issuer or a program by dates of resolutions, ordinances, agreements, amounts and places, and
// applying such a description to the actual facts is a determination the text leaves to the
// administrator and the courts. The description is not encoded as separate atoms; each row of the
// description is classified EVALUATIVE in the coverage and points at the rule that reads the
// judgment. What IS computed: the aggregate face amount limit (a case fact, the sum over all
// bonds ever issued under the exception is not derivable), the net proceeds share (95 percent, or
// 90 percent where the subparagraph says so), the issue date limits (1317(52): December 31, 1990;
// subparagraph-specific extensions), and the effect of the exception.
//
// EFFECTS. `named_exception_effect_1986(issue, effect)` states what the exception does. Two
// effects reach the rest of the package: TreatedAsExemptFacilityBond concludes
// `exempt_facility_bond_142a` (the bond is a qualified bond category of section 141(e)(1)(A) in the
// 1986 Code); AmendmentsInapplicable concludes `transition_basis_1986` (the 1954 Code regime
// governs). Other effects are stated for the caller and are not wired into a consumer rule.

use self::{
    BondIssue,
    IRC_S141_NOTE_5,
    IRC_S141_NOTE_6,
    TransitionBasis1986,
    TransitionRequirement1986,
    bond_facility_or_purpose_described_1315d,
    bond_issue_date_1986_transition,
    exempt_facility_bond_142a,
    facility_location_and_use_shares_146k,
    outside_facility_exception_146k,
    refunding_not_counted_against_transition_limit_1318c,
    transition_basis_1986,
    transition_requirement_applies_1986,
};

pub enum NamedTransitionEffect1986 { TreatedAsExemptFacilityBond; TreatedAsQualifiedRedevelopmentBond; TreatedAsQualifiedMortgageBond; TreatedAsQualified501c3Bond; AmendmentsInapplicable; NotPrivateActivityBond; Section148d3AndFInapplicable; Section148c2AndFInapplicable; Section148fInapplicable; Section148d2Inapplicable; Section144a12Inapplicable; Section145bLimitInapplicable; Section147bInapplicable; Section147bTreatedAsSatisfied; VolumeCapNotTakenIntoAccount; AnnuityNotInvestmentProperty; Section149d3Inapplicable; AdvanceRefundingRuleRelaxed; PrincipalUserRuleRelaxed; NonqualifiedAmountNotCounted; PrivateLoansNotCounted; GovernmentalUnitTreatment; TreatedAsQualifiedBond; CarryforwardPeriodExtended; Section141bSubstituted25Percent; HousingBondRefundingRelief; PoolBondExemption; OwnershipAndUseNotAdverse; TreatedAsSection141d1WithCarryforwardPurpose; Section147a2dInapplicable; Section149bInapplicable; AmendmentsInapplicableByProgram1316; RefundingExempted; Section147dInapplicable; PrincipalUserExcluded; Section141b3AndC1BInapplicable; Section141a2B4B5Inapplicable; DesignatedAreaCounted; LaterIssueCounted; RefundingTreatedAsPre1986NonAdvance; Section146AppliesToPrivateActivityBond }

external judgment relation named_exception_matches_1986(issue: BondIssue, section: Integer, paragraph: Integer, subparagraph: Integer) {
    authority Secretary;
    label en official "the bond, the facility, the issuer or the program is the one that the named exception of section 1315(d), 1316 or 1317 of Pub. L. 99-514 describes (the description gives dates of resolutions, ordinances and agreements, amounts and places; applying it to the actual facts is a determination left to the administrator and the courts); the paragraph and subparagraph are numbered as in the note, (A) is 1, (B) is 2, and 0 stands for a paragraph without subparagraphs";
}
relation named_exception_aggregate_face_1986(section: Integer, paragraph: Integer, subparagraph: Integer, total: Money) kind empirical {
    label en official "the aggregate face amount of the bonds to which the named exception applies (the sum over all bonds issued under it, asserted by the case)";
}
relation named_exception_net_proceeds_share_1986(issue: BondIssue, share: Decimal) kind empirical {
    label en official "the share of the net proceeds of the issue used to provide the facility or purpose of the named exception (95 percent or more is required unless the subparagraph says 90 percent)";
}
pub relation named_exception_applies_1986(issue: BondIssue, section: Integer, paragraph: Integer, subparagraph: Integer) kind institutional {
    label en official "the named exception applies to the bond: the description is matched, the aggregate limit and the net proceeds share are met and the bond is issued within the period of the exception";
}
pub relation named_exception_effect_1986(issue: BondIssue, effect: NamedTransitionEffect1986) kind institutional {
    label en official "the effect the named exception has on the bond";
}
pub relation issue_within_1317_termination(issue: BondIssue) kind institutional {
    label en official "the bond is not issued after December 31, 1990 (section 1317(52), subject to the subparagraphs that name a later date)";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(52) Termination.—Except as otherwise provided in this section, this section shall not apply to any bond issued after December 31, 1990.")
rule IssueWithinTermination1317(issue: BondIssue, issued: Date) strict {
    label en official "section 1317(52)";
    when bond_issue_date_1986_transition(issue, issued);
    when issued <= @1990-12-31;
    then issue_within_1317_termination(issue);
}
rule NamedExceptionExemptFacilityBond(issue: BondIssue) strict {
    label en official "sections 1316 and 1317: the bond is treated as an exempt facility bond of section 142(a)";
    when named_exception_effect_1986(issue, TreatedAsExemptFacilityBond);
    then exempt_facility_bond_142a(issue);
}
rule NamedExceptionAmendmentsInapplicableBasis(issue: BondIssue) strict {
    label en official "sections 1316 and 1317: the amendments made by section 1301 do not apply to the bond";
    when named_exception_effect_1986(issue, AmendmentsInapplicable);
    then transition_basis_1986(issue, NamedException1317);
}
rule NamedExceptionEstablishedProgramBasis(issue: BondIssue) strict {
    label en official "section 1316(g): the amendments made by section 1301 do not apply to the bond";
    when named_exception_effect_1986(issue, AmendmentsInapplicableByProgram1316);
    then transition_basis_1986(issue, EstablishedProgram1316);
}

// =====================================================================
// §1315(d)(3)-(6): facilities whose bonds are outside the volume cap
// =====================================================================

@source(IRC_S141_NOTE_6, relation = formalizes, coverage = partial, quote = "\"(3) A facility is described in this paragraph if the facility—")
rule Named1315d3(issue: BondIssue, total: Money) strict {
    label en official "section 1315(d)(3): a facility serving Los Osos, California, that would be a solid waste disposal facility described in paragraph (1); aggregate face amount within $35,000,000";
    when named_exception_matches_1986(issue, 1315, 3, 0);
    when named_exception_aggregate_face_1986(1315, 3, 0, total);
    when total <= 35000000.00 USD;
    then named_exception_applies_1986(issue, 1315, 3, 0);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = partial, quote = "\"(4) A facility is described in this paragraph if it is a sewage disposal facility with respect to which—")
rule Named1315d4(issue: BondIssue, total: Money) strict {
    label en official "section 1315(d)(4): the East Baton Rouge sewage disposal facility; aggregate face amount within $98,500,000";
    when named_exception_matches_1986(issue, 1315, 4, 0);
    when named_exception_aggregate_face_1986(1315, 4, 0, total);
    when total <= 98500000.00 USD;
    then named_exception_applies_1986(issue, 1315, 4, 0);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = partial, quote = "\"(5) A facility is described in this paragraph if—")
rule Named1315d5(issue: BondIssue, total: Money, share: Decimal) strict {
    label en official "section 1315(d)(5): the Charleston, South Carolina solid waste disposal facility; aggregate face amount within $75,000,000; 90 percent replaces 95 percent in section 142(a) for the exempt facility bond test";
    when named_exception_matches_1986(issue, 1315, 5, 0);
    when named_exception_aggregate_face_1986(1315, 5, 0, total);
    when total <= 75000000.00 USD;
    when named_exception_net_proceeds_share_1986(issue, share);
    when share >= 0.90;
    then named_exception_applies_1986(issue, 1315, 5, 0);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = partial, quote = "\"(6) A facility is described in this paragraph if—")
rule Named1315d6(issue: BondIssue, total: Money) strict {
    label en official "section 1315(d)(6): the parish wastewater treatment facility; aggregate face amount within $120,000,000";
    when named_exception_matches_1986(issue, 1315, 6, 0);
    when named_exception_aggregate_face_1986(1315, 6, 0, total);
    when total <= 120000000.00 USD;
    then named_exception_applies_1986(issue, 1315, 6, 0);
}
rule Named1315dFacilityDescribed(issue: BondIssue, paragraph: Integer) strict {
    label en official "section 1315(d)(3)-(6) feed the description of section 1315(c)";
    when named_exception_applies_1986(issue, 1315, paragraph, 0);
    then bond_facility_or_purpose_described_1315d(issue);
}
rule Named1315dBasis(issue: BondIssue, paragraph: Integer) strict {
    label en official "section 1315: the bond is outside the volume cap of section 146 (a basis of the transitional exceptions)";
    when named_exception_applies_1986(issue, 1315, paragraph, 0);
    then transition_basis_1986(issue, NamedException1315);
}

// =====================================================================
// §1316: established State programs and bonds under the Tax Reform Act of 1984
// =====================================================================

relation established_program_bond_facts_1316(issue: BondIssue, program_kind: Integer, private_activity_bond_solely_by_141c: Boolean, net_proceeds_share: Decimal) kind empirical {
    label en official "a bond of an established State program: the kind (1 veterans land loans (a), 2 renewable energy property (b), 3 Iowa program (c), 5 hydroelectric generating property (f)), whether the bond is a private activity bond solely by reason of section 141(c) (only (a) needs it), and the share of the net proceeds used for the program";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(1) In general.—A bond described in paragraph (2) shall be treated as described in section 141(d)(1) of the 1986 Code and as having a carryforward purpose described in section 146(f)(5) of such Code, but subsections (a), (b), (c), and (d) of section 147 of such Code shall not apply to such bond.")
rule Named1316aVeteransLandLoans(issue: BondIssue, share: Decimal) strict {
    label en official "section 1316(a)(1)-(2): a bond that is a private activity bond solely by reason of section 141(c) and is issued for a State program of loans to veterans for the purchase of land in effect in the same form during the 30 years ending on July 18, 1984, used as on March 15, 1984";
    when named_exception_matches_1986(issue, 1316, 1, 0);
    when established_program_bond_facts_1316(issue, 1, true, share);
    when share >= 0.95;
    then named_exception_applies_1986(issue, 1316, 1, 0);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(1) In general.—A bond described in paragraph (2) shall be treated as described in section 141(d)(1) of the 1986 Code and as having a carryforward purpose described in section 146(f)(5) of such Code.")
rule Named1316bRenewableEnergy(issue: BondIssue, kind_number: Integer) strict {
    label en official "section 1316(b)(1)-(2): a bond that section 103(b)(1) of the 1954 Code would not have reached by reason of section 243 of the Crude Oil Windfall Profit Tax Act of 1980, with 95 percent of the net proceeds and section 149(b) substituted";
    when named_exception_matches_1986(issue, 1316, 2, 0);
    when established_program_bond_facts_1316(issue, 2, false, 0.95);
    then named_exception_applies_1986(issue, 1316, 2, 0);
}
relation iowa_program_aggregate_outstanding_1316c3(total: Money) kind empirical {
    label en official "the aggregate face amount of outstanding bonds to which section 1316(c) applies";
}
relation iowa_program_average_maturity_1316c4(issue: BondIssue, average_maturity_years: Decimal, is_refunding_bond: Boolean) kind empirical {
    label en official "the average maturity (section 147(b)(2)(A)) of the issue of which the bond is a part, and whether the bond refunds a bond described in section 1316(c)";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(2) Bond described.—A bond is described in this paragraph if such bond is issued as part of an issue 95 percent or more of the net proceeds of which are to be used to carry out a program established under sections 280A, 280B, and 280C of the Iowa Code")
rule Named1316cIowaProgram(issue: BondIssue, share: Decimal, total: Money) strict {
    label en official "section 1316(c)(1)-(3): the Iowa program in effect since July 1, 1983 for the purposes of July 1, 1986; outstanding aggregate face amount within $100,000,000";
    when named_exception_matches_1986(issue, 1316, 3, 0);
    when established_program_bond_facts_1316(issue, 3, false, share);
    when share >= 0.95;
    when iowa_program_aggregate_outstanding_1316c3(total);
    when total <= 100000000.00 USD;
    then named_exception_applies_1986(issue, 1316, 3, 0);
}
pub relation section_147b_treated_as_met_1316c4(issue: BondIssue) kind institutional {
    label en official "the bond is treated as meeting section 147(b): the average maturity of its issue does not exceed 20 years (a refunding bond of such a bond likewise)";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(4) Application of section 147(b).—A bond to which this subsection applies (other than a refunding bond) shall be treated as meeting the requirements of section 147(b) of the 1986 Code if the average maturity")
rule Section147bTreatedAsMetForIowaBonds(issue: BondIssue, maturity: Decimal, refunding: Boolean) strict {
    label en official "section 1316(c)(4): not more than 20 years";
    when named_exception_applies_1986(issue, 1316, 3, 0);
    when iowa_program_average_maturity_1316c4(issue, maturity, refunding);
    when maturity <= 20.0;
    then section_147b_treated_as_met_1316c4(issue);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(2) Description.—A bond is described in this paragraph if such bond is issued as part of an issue 95 percent or more of the net proceeds of which are to be used to provide a facility described in section 103(b)(4)(H) of the 1954 Code determined—")
rule Named1316fHydroelectric(issue: BondIssue, share: Decimal) strict {
    label en official "section 1316(f)(1)-(2): a hydroelectric generating facility of section 103(b)(4)(H) read with 'an application for a license' and section 142(b)(2)";
    when named_exception_matches_1986(issue, 1316, 6, 0);
    when established_program_bond_facts_1316(issue, 5, false, share);
    when share >= 0.95;
    then named_exception_applies_1986(issue, 1316, 6, 0);
}
rule NamedEffect1316Programs(issue: BondIssue, paragraph: Integer) strict {
    label en official "section 1316(a)(1), (b)(1), (c)(1), (f)(1): treated as described in section 141(d)(1) with a carryforward purpose under section 146(f)(5)";
    when named_exception_applies_1986(issue, 1316, paragraph, 0);
    when paragraph != 7;
    when paragraph != 8;
    then named_exception_effect_1986(issue, TreatedAsSection141d1WithCarryforwardPurpose);
}
rule NamedEffect1316aNo147ad(issue: BondIssue) strict {
    label en official "section 1316(a)(1): subsections (a)-(d) of section 147 do not apply to the veterans land loan bond";
    when named_exception_applies_1986(issue, 1316, 1, 0);
    then named_exception_effect_1986(issue, Section147a2dInapplicable);
}
relation federal_instrumentality_program_facts_1316d(issue: BondIssue, approved_by_congress_on: Date, part_financed_by_bonds_issued_before_1972_08_03_with_ruling: Boolean, construction_of_a_facility_commenced_on: Date) kind empirical {
    label en official "the program of a United States instrumentality was approved by Congress on the date, a portion of it has been financed by bonds issued before August 3, 1972 to which section 103(a) of the 1954 Code applied under an IRS ruling, and construction of a facility of it commenced on the date";
}
pub relation instrumentality_use_treated_as_governmental_1316d(issue: BondIssue) kind institutional {
    label en official "use by an instrumentality of the United States is treated as use by a State or local governmental unit for sections 103 and 141-150";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(d) Use by Certain Federal Instrumentalities Treated as Use by Governmental Units.—Use by an instrumentality of the United States shall be treated as use by a State or local governmental unit")
rule InstrumentalityUseTreatedAsGovernmental(issue: BondIssue, approved: Date, commenced: Date) strict {
    label en official "section 1316(d)(1)-(2): approval before August 3, 1972, an earlier ruling-based financing, construction commenced before that date";
    when federal_instrumentality_program_facts_1316d(issue, approved, true, commenced);
    when approved < @1972-08-03;
    when commenced < @1972-08-03;
    then instrumentality_use_treated_as_governmental_1316d(issue);
}
relation insured_deposit_refunding_facts_1316e(issue: BondIssue, refunded_would_have_been_federally_guaranteed_by_103h2Bii: Boolean, refunded_issued_on: Date, except_clause_of_631c2_applied: Boolean) kind empirical {
    label en official "the refunded bond would have been treated as federally guaranteed under section 103(h)(2)(B)(ii) of the 1954 Code had it applied, when it was issued, and it was issued on the date or was excepted by the except clause of section 631(c)(2) of the Tax Reform Act of 1984";
}
relation insured_deposit_refunding_terms_1316e2(issue: BondIssue, refunding_matures_on: Date, refunded_matures_on: Date, refunding_amount: Money, refunded_outstanding_amount: Money, refunding_weighted_rate: Decimal, refunded_weighted_rate: Decimal, redeemed_within_90_days: Boolean) kind empirical {
    label en official "the maturity dates, the amounts, the weighted average interest rates of the refunding and refunded bonds, and whether the net proceeds redeem the refunded bond within 90 days";
}
pub relation section_149b2Bii_not_applicable_to_refunding_1316e(issue: BondIssue) kind institutional {
    label en official "section 149(b)(2)(B)(ii) of the 1986 Code (and section 103(h)(2)(B)(ii) of the 1954 Code) does not apply to the refunding bond";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(1) In general.—Section 149(b)(2)(B)(ii) of the 1986 Code (and section 103(h)(2)(B)(ii) of the 1954 Code) shall not apply to any bond issued to refund a bond—")
rule Section149b2BiiNotApplicableByDate(issue: BondIssue, issued: Date, matures: Date, refunded_matures: Date, amount: Money, outstanding: Money, rate: Decimal, refunded_rate: Decimal) strict {
    label en official "section 1316(e)(1)(A), (B)(i) and (2)(A)-(D): the refunded bond issued before April 15, 1983";
    when insured_deposit_refunding_facts_1316e(issue, true, issued, false);
    when issued < @1983-04-15;
    when insured_deposit_refunding_terms_1316e2(issue, matures, refunded_matures, amount, outstanding, rate, refunded_rate, true);
    when matures <= refunded_matures;
    when amount <= outstanding;
    when rate < refunded_rate;
    then section_149b2Bii_not_applicable_to_refunding_1316e(issue);
}
rule Section149b2BiiNotApplicableByExceptClause(issue: BondIssue, issued: Date, matures: Date, refunded_matures: Date, amount: Money, outstanding: Money, rate: Decimal, refunded_rate: Decimal) strict {
    label en official "section 1316(e)(1)(A), (B)(ii) and (2)(A)-(D): the except clause of section 631(c)(2) of the Tax Reform Act of 1984 applied";
    when insured_deposit_refunding_facts_1316e(issue, true, issued, true);
    when insured_deposit_refunding_terms_1316e2(issue, matures, refunded_matures, amount, outstanding, rate, refunded_rate, true);
    when matures <= refunded_matures;
    when amount <= outstanding;
    when rate < refunded_rate;
    then section_149b2Bii_not_applicable_to_refunding_1316e(issue);
}
rule NamedEffect1316eNo149b(issue: BondIssue) strict {
    label en official "section 1316(e)(1)";
    when section_149b2Bii_not_applicable_to_refunding_1316e(issue);
    then named_exception_effect_1986(issue, Section149bInapplicable);
}
relation tra1984_bond_class_1316g(issue: BondIssue, class_number: Integer) kind empirical {
    label en official "the class of bond under a transitional rule of the Tax Reform Act of 1984 that section 1316(g) names: 1 a bond of section 624(c)(2), 2 a bond for the convention center or the resource recovery project of section 631(a)(3) (B convention center, C resource recovery under 3 and 4), 5 property of section 631(d)(4), 6 property of section 631(d)(5), 7 a bond of section 632(a)(2)-(7), 8 a bond of section 632(b), 9 a bond to which section 632(g)(2) applies, 10 property of section 216(b)(3) of TEFRA, 11 a bond of section 632(d), 12 a bond to which section 629(a)(1) applies";
}
relation issue_date_1316g(issue: BondIssue, issued: Date) kind empirical {
    label en official "the date the bond is issued";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(1) Subsections (d)(3) and (f) of section 148 of the 1986 Code shall not apply to any bond described in section 624(c)(2) of the Tax Reform Act of 1984")
rule Named1316g1(issue: BondIssue, issued: Date) strict {
    label en official "section 1316(g)(1) with (g)(5): not for a bond issued after December 31, 1988";
    when named_exception_matches_1986(issue, 1316, 7, 1);
    when tra1984_bond_class_1316g(issue, 1);
    when issue_date_1316g(issue, issued);
    when issued <= @1988-12-31;
    then named_exception_applies_1986(issue, 1316, 7, 1);
}
rule NamedEffect1316g1(issue: BondIssue) strict {
    label en official "section 1316(g)(1)";
    when named_exception_applies_1986(issue, 1316, 7, 1);
    then named_exception_effect_1986(issue, Section148d3AndFInapplicable);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(2)(A) There shall not be taken into account under section 146 of the 1986 Code any bond issued to provide a facility described in paragraph (3) of section 631(a)")
rule Named1316g2A(issue: BondIssue, issued: Date) strict {
    label en official "section 1316(g)(2)(A) with (g)(5)";
    when named_exception_matches_1986(issue, 1316, 7, 2);
    when tra1984_bond_class_1316g(issue, 2);
    when issue_date_1316g(issue, issued);
    when issued <= @1988-12-31;
    then named_exception_applies_1986(issue, 1316, 7, 2);
}
rule NamedEffect1316g2A(issue: BondIssue) strict {
    label en official "section 1316(g)(2)(A)";
    when named_exception_applies_1986(issue, 1316, 7, 2);
    then named_exception_effect_1986(issue, VolumeCapNotTakenIntoAccount);
}
relation bond_part_of_issue_for_convention_center_or_resource_recovery_1316g2(issue: BondIssue, substantially_all_proceeds_for_convention_center: Boolean, substantially_all_proceeds_for_resource_recovery: Boolean) kind empirical {
    label en official "substantially all of the proceeds of the issue are used to provide the convention center (B) or the resource recovery project (C) to which section 631(a)(3) of the Tax Reform Act of 1984 applies";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(B) If a bond issued as part of an issue substantially all of the proceeds of which are used to provide the convention center to which such paragraph (3) applies, such bond shall be treated as an exempt facility bond")
rule NamedEffect1316g2BConventionCenter(issue: BondIssue) strict {
    label en official "section 1316(g)(2)(B)";
    when named_exception_applies_1986(issue, 1316, 7, 2);
    when bond_part_of_issue_for_convention_center_or_resource_recovery_1316g2(issue, true, false);
    then named_exception_effect_1986(issue, TreatedAsExemptFacilityBond);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(C) If a bond which is issued as part of an issue substantially all of the proceeds of which are used to provide the resource recovery project to which such paragraph (3) applies")
rule NamedEffect1316g2CResourceRecovery(issue: BondIssue) strict {
    label en official "section 1316(g)(2)(C): an exempt facility bond, and section 149(b) does not apply";
    when named_exception_applies_1986(issue, 1316, 7, 2);
    when bond_part_of_issue_for_convention_center_or_resource_recovery_1316g2(issue, false, true);
    then named_exception_effect_1986(issue, TreatedAsExemptFacilityBond);
}
rule NamedEffect1316g2CNo149b(issue: BondIssue) strict {
    label en official "section 1316(g)(2)(C): section 149(b) does not apply";
    when named_exception_applies_1986(issue, 1316, 7, 2);
    when bond_part_of_issue_for_convention_center_or_resource_recovery_1316g2(issue, false, true);
    then named_exception_effect_1986(issue, Section149bInapplicable);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(3) The amendments made by section 1301 [for classification see section 1311(a) of this note] shall not apply to bonds issued to finance any property described in section 631(d)(4)")
rule Named1316g3(issue: BondIssue, issued: Date) strict {
    label en official "section 1316(g)(3) with (g)(5): property of section 631(d)(4) of the Tax Reform Act of 1984";
    when named_exception_matches_1986(issue, 1316, 7, 3);
    when tra1984_bond_class_1316g(issue, 5);
    when issue_date_1316g(issue, issued);
    when issued <= @1988-12-31;
    then named_exception_applies_1986(issue, 1316, 7, 3);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(4) The amendments made by section 1301 [for classification see section 1311(a) of this note] shall not apply to—")
rule Named1316g4(issue: BondIssue, class_number: Integer, issued: Date) strict {
    label en official "section 1316(g)(4)(A)-(C) with (g)(5): property of 631(d)(5), a bond of 632(a)(2)-(7) or 632(b), a bond to which 632(g)(2) applies";
    when named_exception_matches_1986(issue, 1316, 7, 4);
    when tra1984_bond_class_1316g(issue, class_number);
    when class_number >= 6;
    when class_number <= 9;
    when issue_date_1316g(issue, issued);
    when issued <= @1988-12-31;
    then named_exception_applies_1986(issue, 1316, 7, 4);
}
rule NamedEffect1316g3g4Amendments(issue: BondIssue, subparagraph: Integer) strict {
    label en official "section 1316(g)(3), (4): the amendments of section 1301 do not apply";
    when named_exception_applies_1986(issue, 1316, 7, subparagraph);
    when subparagraph >= 3;
    when subparagraph <= 4;
    then named_exception_effect_1986(issue, AmendmentsInapplicableByProgram1316);
}
rule NamedEffect1316g4Sections148And149d(issue: BondIssue) strict {
    label en official "section 1316(g)(4) closing sentence: the requirements of sections 148 and 149(d) are treated as included in section 103 of the 1954 Code";
    when named_exception_applies_1986(issue, 1316, 7, 4);
    then transition_requirement_applies_1986(issue, Section148Arbitrage);
}
rule NamedEffect1316g4Section149d(issue: BondIssue) strict {
    label en official "section 1316(g)(4) closing sentence, section 149(d)";
    when named_exception_applies_1986(issue, 1316, 7, 4);
    then transition_requirement_applies_1986(issue, Section149d3And4AdvanceRefunding);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(6) The amendments made by section 1301 [for classification see section 1311(a) of this note] (and the provisions of section 1314) shall not apply to any bond issued to finance property described in section 216(b)(3)")
rule Named1316g6(issue: BondIssue, issued: Date) strict {
    label en official "section 1316(g)(6) with (g)(5): property of section 216(b)(3) of the Tax Equity and Fiscal Responsibility Act of 1982";
    when named_exception_matches_1986(issue, 1316, 7, 6);
    when tra1984_bond_class_1316g(issue, 10);
    when issue_date_1316g(issue, issued);
    when issued <= @1988-12-31;
    then named_exception_applies_1986(issue, 1316, 7, 6);
}
rule NamedEffect1316g6(issue: BondIssue) strict {
    label en official "section 1316(g)(6): the amendments of section 1301 and section 1314 do not apply";
    when named_exception_applies_1986(issue, 1316, 7, 6);
    then named_exception_effect_1986(issue, AmendmentsInapplicableByProgram1316);
}
relation section_632d_bond_facts_1316g7(issue: BondIssue, business_use_share: Decimal, security_share: Decimal) kind empirical {
    label en official "the business use share and the security share of the issue for the tests of section 141(b)(1) and (2), for a bond described in section 632(d) of the Tax Reform Act of 1984";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(7) In the case of a bond described in section 632(d) of the Tax Reform Act of 1984")
rule Named1316g7(issue: BondIssue, issued: Date) strict {
    label en official "section 1316(g)(7): a bond of section 632(d) of the Tax Reform Act of 1984, not issued after December 31, 1990";
    when named_exception_matches_1986(issue, 1316, 7, 7);
    when tra1984_bond_class_1316g(issue, 11);
    when issue_date_1316g(issue, issued);
    when issued <= @1990-12-31;
    then named_exception_applies_1986(issue, 1316, 7, 7);
}
pub relation private_business_tests_met_under_1316g7(issue: BondIssue) kind institutional {
    label en official "section 141(b)(1) or (2) is met for the section 632(d) bond: 25 percent replaces 10 percent";
}
rule PrivateBusinessTestsMetUnder1316g7ByUse(issue: BondIssue, use_share: Decimal, security: Decimal) strict {
    label en official "section 1316(g)(7)(B): the business use share exceeds 25 percent";
    when named_exception_applies_1986(issue, 1316, 7, 7);
    when section_632d_bond_facts_1316g7(issue, use_share, security);
    when use_share > 0.25;
    then private_business_tests_met_under_1316g7(issue);
}
rule PrivateBusinessTestsMetUnder1316g7BySecurity(issue: BondIssue, use_share: Decimal, security: Decimal) strict {
    label en official "section 1316(g)(7)(B): the security share exceeds 25 percent";
    when named_exception_applies_1986(issue, 1316, 7, 7);
    when section_632d_bond_facts_1316g7(issue, use_share, security);
    when security > 0.25;
    then private_business_tests_met_under_1316g7(issue);
}
rule NamedEffect1316g7(issue: BondIssue) strict {
    label en official "section 1316(g)(7)(A), (C): section 141 applies without (a)(2), (b)(4), (b)(5), and section 149(b) does not apply";
    when named_exception_applies_1986(issue, 1316, 7, 7);
    then named_exception_effect_1986(issue, Section149bInapplicable);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(8)(A) The amendments made by section 1301 [for classification see section 1311(a) of this note] shall not apply to any bond to which section 629(a)(1)")
rule Named1316g8A(issue: BondIssue, issued: Date) strict {
    label en official "section 1316(g)(8)(A) with (g)(5): a bond to which section 629(a)(1) of the Tax Reform Act of 1984 applies";
    when named_exception_matches_1986(issue, 1316, 7, 8);
    when tra1984_bond_class_1316g(issue, 12);
    when issue_date_1316g(issue, issued);
    when issued <= @1988-12-31;
    then named_exception_applies_1986(issue, 1316, 7, 8);
}
rule NamedEffect1316g8AAmendments(issue: BondIssue) strict {
    label en official "section 1316(g)(8)(A): the amendments of section 1301 do not apply";
    when named_exception_applies_1986(issue, 1316, 7, 8);
    then named_exception_effect_1986(issue, AmendmentsInapplicableByProgram1316);
}
rule NamedEffect1316g8ACarryforward(issue: BondIssue) strict {
    label en official "section 1316(g)(8)(A): treated as a private activity bond for section 146 with a carryforward purpose";
    when named_exception_applies_1986(issue, 1316, 7, 8);
    then named_exception_effect_1986(issue, TreatedAsSection141d1WithCarryforwardPurpose);
}
relation pollution_bond_facts_1316h(issue: BondIssue, treated_as_103b4F_by_section_13209_of_cobra_1985: Boolean) kind empirical {
    label en official "the bond is treated as described in section 103(b)(4)(F) of the 1954 Code by reason of section 13209 of the Consolidated Omnibus Budget Reconciliation Act of 1985";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(h) Certain Pollution Bonds.—Any bond which is treated as described in section 103(b)(4)(F) of the 1954 Code by reason of section 13209")
rule Named1316h(issue: BondIssue) strict {
    label en official "section 1316(h)";
    when named_exception_matches_1986(issue, 1316, 8, 0);
    when pollution_bond_facts_1316h(issue, true);
    then named_exception_applies_1986(issue, 1316, 8, 0);
}
rule NamedEffect1316hExemptFacility(issue: BondIssue) strict {
    label en official "section 1316(h): an exempt facility bond of part IV of subchapter B";
    when named_exception_applies_1986(issue, 1316, 8, 0);
    then named_exception_effect_1986(issue, TreatedAsExemptFacilityBond);
}
rule NamedEffect1316hNo147d(issue: BondIssue) strict {
    label en official "section 1316(h): section 147(d) does not apply";
    when named_exception_applies_1986(issue, 1316, 8, 0);
    then named_exception_effect_1986(issue, Section147dInapplicable);
}
relation tax_increment_bond_1316i(issue: BondIssue, described_in_1869c3: Boolean, issued_on: Date) kind empirical {
    label en official "the bond is a tax increment bond described in section 1869(c)(3) of the Act issued on the date";
}
pub relation tax_increment_bond_not_counted_1316i(issue: BondIssue) kind institutional {
    label en official "the tax increment bond issued before August 16, 1986 is not taken into account under section 144(a)(10)(B)(ii) for the aggregate limit per taxpayer";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(i) Transition Rule for Aggregate Limit per Taxpayer.—For purposes of section 144(a)(10) of the 1986 Code, tax increment bonds described in section 1869(c)(3)")
rule TaxIncrementBondNotCounted(issue: BondIssue, issued: Date) strict {
    label en official "section 1316(i)";
    when tax_increment_bond_1316i(issue, true, issued);
    when issued < @1986-08-16;
    then tax_increment_bond_not_counted_1316i(issue);
}
rule NamedEffect1316iPrivateLoans(issue: BondIssue) strict {
    label en official "section 1316(i): the bond is not counted";
    when tax_increment_bond_not_counted_1316i(issue);
    then named_exception_effect_1986(issue, NonqualifiedAmountNotCounted);
}

// =====================================================================
// §1317 paragraphs that are conditions rather than lists
// =====================================================================

relation named_refunding_facts_1317(issue: BondIssue, paragraph: Integer, refunding_amount: Money, refunded_amount: Money, refunding_matures_on: Date, refunded_matures_on: Date, refunded_original_issued_on: Date) kind empirical {
    label en official "the amounts of the refunding and refunded bonds, the maturity dates and the date the refunded (or the original) bond was issued, for the refunding paragraph of section 1317 with the given number";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(A) [Former] Section 149(d)(3) of the 1986 Code shall not apply to a bond issued by a State admitted to the Union on November 16, 1907")
rule Named1317P10A(issue: BondIssue, total: Money) strict {
    label en official "section 1317(10)(A): a State turnpike advance refunding by the State admitted on November 16, 1907; not more than $186,000,000";
    when named_exception_matches_1986(issue, 1317, 10, 1);
    when named_exception_aggregate_face_1986(1317, 10, 1, total);
    when total <= 186000000.00 USD;
    when issue_within_1317_termination(issue);
    then named_exception_applies_1986(issue, 1317, 10, 1);
}
relation refunding_redemption_dates_1317_10B(issue: BondIssue, issued_on: Date, refunded_redeemed_on: Date) kind empirical {
    label en official "the date the refunding bond of the Charleston, West Virginia Town Center Garage Bonds is issued and the date the refunded bond is redeemed";
}
pub relation refunding_not_advance_refunding_1317_10B(issue: BondIssue) kind institutional {
    label en official "the refunding is not an advance refunding: it would not be one if 100 days were substituted for 90 days in the definition";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(B) A refunding of the Charleston, West Virginia Town Center Garage Bonds shall not be treated for purposes of part IV of subchapter A of chapter 1 of the 1986 Code as an advance refunding")
rule Named1317P10B(issue: BondIssue, issued: Date, redeemed: Date) strict {
    label en official "section 1317(10)(B): not more than 100 days before the redemption";
    when named_exception_matches_1986(issue, 1317, 10, 2);
    when refunding_redemption_dates_1317_10B(issue, issued, redeemed);
    when add_calendar_period(issued, 100 calendar_day) >= redeemed;
    when issue_within_1317_termination(issue);
    then refunding_not_advance_refunding_1317_10B(issue);
}
rule Named1317P10BApplies(issue: BondIssue) strict {
    label en official "section 1317(10)(B)";
    when refunding_not_advance_refunding_1317_10B(issue);
    then named_exception_applies_1986(issue, 1317, 10, 2);
}
rule NamedEffect1317P10(issue: BondIssue, subparagraph: Integer) strict {
    label en official "section 1317(10): former section 149(d)(3) does not apply (A); the refunding is not an advance refunding (B)";
    when named_exception_applies_1986(issue, 1317, 10, subparagraph);
    when subparagraph == 1;
    then named_exception_effect_1986(issue, Section149d3Inapplicable);
}
rule NamedEffect1317P10B(issue: BondIssue) strict {
    label en official "section 1317(10)(B)";
    when named_exception_applies_1986(issue, 1317, 10, 2);
    then named_exception_effect_1986(issue, AdvanceRefundingRuleRelaxed);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(B) A facility is described in this subparagraph if—")
rule Named1317P11B(issue: BondIssue, total: Money, share: Decimal) strict {
    label en official "section 1317(11)(B): the waste-to-energy project; aggregate face amount within $29,100,000; 90 percent replaces 95 percent";
    when named_exception_matches_1986(issue, 1317, 11, 2);
    when named_exception_aggregate_face_1986(1317, 11, 2, total);
    when total <= 29100000.00 USD;
    when named_exception_net_proceeds_share_1986(issue, share);
    when share >= 0.90;
    when issue_within_1317_termination(issue);
    then named_exception_applies_1986(issue, 1317, 11, 2);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(C) A facility is described in this subparagraph if it is described in section 1865(c)(2)(C) of this Act")
rule Named1317P11C(issue: BondIssue, share: Decimal) strict {
    label en official "section 1317(11)(C): a facility described in section 1865(c)(2)(C) of the Act; 90 percent replaces 95 percent";
    when named_exception_matches_1986(issue, 1317, 11, 3);
    when named_exception_net_proceeds_share_1986(issue, share);
    when share >= 0.90;
    when issue_within_1317_termination(issue);
    then named_exception_applies_1986(issue, 1317, 11, 3);
}
rule NamedEffect1317P11(issue: BondIssue, subparagraph: Integer) strict {
    label en official "section 1317(11)(A): the exempt facility bond determination of section 142(a) uses 90 percent";
    when named_exception_applies_1986(issue, 1317, 11, subparagraph);
    then named_exception_effect_1986(issue, PrincipalUserRuleRelaxed);
}
relation scholarship_refunding_facts_1317_12(issue: BondIssue, refunding_amount: Money, refunded_face_amount: Money, refunding_matures_on: Date, refunded_matures_on: Date, refunded_original_issued_on: Date, refunded_issued_before_1986: Boolean) kind empirical {
    label en official "a refunding of qualified scholarship funding bonds issued before January 1, 1986: the amount and the maturity date of the refunding bond, the face amount and the maturity of the refunded bond, and the date the refunded (or original) bond was issued";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(12) Qualified scholarship funding bonds.—Subsections (d)(3) and (f) of section 148 of the 1986 Code shall not apply to any bond or series of bonds")
rule Named1317P12(issue: BondIssue, amount: Money, refunded: Money, matures: Date, refunded_matures: Date, original: Date) strict {
    label en official "section 1317(12)(A)-(D): the amount within the refunded face amount and $175,000,000, the maturity not later than the later of the refunded maturity and 15 years after the original issue, and the issuer is the California Student Loan Finance Corporation";
    when named_exception_matches_1986(issue, 1317, 12, 3);
    when scholarship_refunding_facts_1317_12(issue, amount, refunded, matures, refunded_matures, original, true);
    when amount <= refunded;
    when amount <= 175000000.00 USD;
    when matures <= refunded_matures;
    when issue_within_1317_termination(issue);
    then named_exception_applies_1986(issue, 1317, 12, 3);
}
rule Named1317P12ByFifteenYears(issue: BondIssue, amount: Money, refunded: Money, matures: Date, refunded_matures: Date, original: Date) strict {
    label en official "section 1317(12)(B)(ii): 15 years after the date the refunded (or original) bond was issued";
    when named_exception_matches_1986(issue, 1317, 12, 3);
    when scholarship_refunding_facts_1317_12(issue, amount, refunded, matures, refunded_matures, original, true);
    when amount <= refunded;
    when amount <= 175000000.00 USD;
    when matures <= add_calendar_period(original, 15 calendar_year);
    when issue_within_1317_termination(issue);
    then named_exception_applies_1986(issue, 1317, 12, 3);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = partial, quote = "\"(14) Qualified student loans.—The amendments made by section 1301 [for classification see section 1311(a) of this note] shall not apply to any qualified student loan bonds")
rule Named1317P14(issue: BondIssue, total: Money) strict {
    label en official "section 1317(14): qualified student loan bonds of the Volunteer State Student Assistance Corporation; aggregate face amount within $130,000,000";
    when named_exception_matches_1986(issue, 1317, 14, 0);
    when named_exception_aggregate_face_1986(1317, 14, 0, total);
    when total <= 130000000.00 USD;
    when issue_within_1317_termination(issue);
    then named_exception_applies_1986(issue, 1317, 14, 0);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(16) Solid waste disposal facility.—The amendments made by section 1301 [for classification see section 1311(a) of this note] shall not apply to any solid waste disposal facility if—")
rule Named1317P16(issue: BondIssue, total: Money) strict {
    label en official "section 1317(16)(A)-(C): the facility approved by State law I.C. 36-9-31 with the inducement resolution of November 19, 1984 and the carryforward election of February 25, 1985; aggregate face amount within $120,000,000";
    when named_exception_matches_1986(issue, 1317, 16, 3);
    when named_exception_aggregate_face_1986(1317, 16, 3, total);
    when total <= 120000000.00 USD;
    when issue_within_1317_termination(issue);
    then named_exception_applies_1986(issue, 1317, 16, 3);
}
relation bond_anticipation_note_refunding_1317_17(issue: BondIssue, issued_on: Date, refunded_notes_issued_in_december_1984: Boolean, refunded_notes_mature_in_december_1986: Boolean, days_before_redemption: Integer, refunding_face_amount: Money) kind empirical {
    label en official "the refunding of bond anticipation notes issued in December 1984 by the Rhode Island Housing and Mortgage Finance Corporation that mature in December 1986: the number of days by which the refunding bonds precede the redemption, and the face amount of the refunding bonds";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(17) Refunding of bond anticipation notes.—There shall not be taken into account under section 146 of the 1986 Code any refunding of bond anticipation notes—")
rule Named1317P17(issue: BondIssue, issued: Date, days: Integer, face: Money) strict {
    label en official "section 1317(17)(A)-(D): notes issued in December 1984 by the Rhode Island Housing and Mortgage Finance Corporation maturing in December 1986; not an advance refunding with 180 days for 90 days; refunding face amount within $25,500,000";
    when named_exception_matches_1986(issue, 1317, 17, 1);
    when bond_anticipation_note_refunding_1317_17(issue, issued, true, true, days, face);
    when days <= 180;
    when face <= 25500000.00 USD;
    when issue_within_1317_termination(issue);
    then named_exception_applies_1986(issue, 1317, 17, 1);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(21) Pooled financing programs.—")
rule Named1317P21A(issue: BondIssue, total: Money) strict {
    label en official "section 1317(21)(A): a hospital pooled financing program presented to a city hospital facilities authority on January 14, 1986; aggregate face amount within $95,000,000";
    when named_exception_matches_1986(issue, 1317, 21, 1);
    when named_exception_aggregate_face_1986(1317, 21, 1, total);
    when total <= 95000000.00 USD;
    when issue_within_1317_termination(issue);
    then named_exception_applies_1986(issue, 1317, 21, 1);
}
relation closing_date_1317_21B(issue: BondIssue, closed_on: Date) kind empirical {
    label en official "the date the bonds closed";
}
rule Named1317P21B(issue: BondIssue, total: Money, closed: Date) strict {
    label en official "section 1317(21)(B): bonds that closed on July 16, 1986, administered by a State municipal league; aggregate face amount within $585,000,000";
    when named_exception_matches_1986(issue, 1317, 21, 2);
    when closing_date_1317_21B(issue, closed);
    when closed == @1986-07-16;
    when named_exception_aggregate_face_1986(1317, 21, 2, total);
    when total <= 585000000.00 USD;
    when issue_within_1317_termination(issue);
    then named_exception_applies_1986(issue, 1317, 21, 2);
}
relation section_1317_25_cap_facts(issue: BondIssue, aggregate_face_amount: Money, issued_before_1992_amount: Money, net_proceeds_share_for_listed_purposes: Decimal, is_private_activity_bond_without_25A: Boolean) kind empirical {
    label en official "the aggregate face amount of the bonds to which section 1317(25)(A) applies, the part issued before January 1, 1992, the net proceeds share used for the purposes listed in (B)(iii), and whether the bond would be a private activity bond without (A)";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(A) In general.—Except as provided in subparagraph (B), a bond shall be treated as a qualified bond for purposes of section 103 of the 1986 Code")
rule Named1317P25(issue: BondIssue, total: Money, early: Money, share: Decimal, pab: Boolean, issued_after: Date) strict {
    label en official "section 1317(25)(A)-(B): a public utility facility at a described dam owned and operated by a governmental unit with public recreational access; aggregate face amount within $750,000,000 of which not more than $350,000,000 before January 1, 1992; 95 percent of the net proceeds for the listed purposes";
    when named_exception_matches_1986(issue, 1317, 25, 1);
    when section_1317_25_cap_facts(issue, total, early, share, pab);
    when total <= 750000000.00 USD;
    when early <= 350000000.00 USD;
    when share >= 0.95;
    when bond_issue_date_1986_transition(issue, issued_after);
    when issued_after > @1986-10-22;
    then named_exception_applies_1986(issue, 1317, 25, 1);
}
// G6400 wiring, Pub. L. 99-514 §1317(25)(B)(i): section 146 applies to a bond of (A) that (without regard to (A)) is a
// private activity bond (recorded as the named effect `Section146AppliesToPrivateActivityBond`), and for section
// 146(k) the public utility facility is treated as described in (k)(2) and (k)(2) is applied without the
// requirement that the issuer establish the State's shares: the exception of (k)(2) is met when the State's share
// of the use of the facility is not less than its share of the bonds, whether or not the issuer establishes it.
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "Section 146 of the 1986 Code shall apply to any bond described in subparagraph (A) which (without regard to subparagraph (A)) is a private activity bond.")
rule NamedEffect1317P25Section146Applies(issue: BondIssue, total: Money, early: Money, share: Decimal) strict {
    label en official "section 1317(25)(B)(i), first sentence: section 146 applies to the bond if it is a private activity bond without (A)";
    when named_exception_applies_1986(issue, 1317, 25, 1);
    when section_1317_25_cap_facts(issue, total, early, share, true);
    then named_exception_effect_1986(issue, Section146AppliesToPrivateActivityBond);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "the public utility facility described in subparagraph (A) shall be treated as described in paragraph (2) of such section")
rule OutsideFacilityExceptionPublicUtilityDam1317P25(issue: BondIssue, use_share: Decimal, bond_share: Decimal, kind: Boolean, alloc: Boolean, est: Boolean) strict {
    label en official "section 1317(25)(B)(i), second sentence: section 146(k)(2) for the dam facility without the requirement that the issuer establish the shares";
    when named_exception_applies_1986(issue, 1317, 25, 1);
    when facility_location_and_use_shares_146k(issue, true, use_share, bond_share, kind, alloc, est);
    when use_share >= bond_share;
    then outside_facility_exception_146k(issue);
}
rule NamedEffect1317P25(issue: BondIssue) strict {
    label en official "section 1317(25)(A): treated as a qualified bond for section 103; section 146 still applies to a private activity bond (B)(i)";
    when named_exception_applies_1986(issue, 1317, 25, 1);
    then named_exception_effect_1986(issue, TreatedAsQualifiedBond);
}
relation private_loan_amount_1317_28(issue: BondIssue, loans_in_furtherance_of_city_plan: Money) kind empirical {
    label en official "the amount of loans provided from the proceeds of one or more issues in furtherance of the city Emergency Conservation Plan of February 17, 1983 or the resolution of March 10, 1983";
}
pub relation private_loans_not_taken_into_account_1317_28(issue: BondIssue, amount: Money) kind institutional {
    label en official "for the private activity bond determination, loans up to $75,000,000 in furtherance of the plan are not taken into account";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(28) Certain private loans not taken into account.—For purposes of determining whether any bond is a private activity bond, an amount of loans (but not in excess of $75,000,000)")
rule PrivateLoansNotTakenIntoAccount(issue: BondIssue, loans: Money) strict {
    label en official "section 1317(28): the lesser of the loans and $75,000,000";
    when named_exception_matches_1986(issue, 1317, 28, 0);
    when private_loan_amount_1317_28(issue, loans);
    when issue_within_1317_termination(issue);
    then private_loans_not_taken_into_account_1317_28(issue, min(loans, 75000000.00 USD));
}
relation connecticut_nonqualified_amount_1317_29(issue: BondIssue, nonqualified_amount: Money, issued_on: Date, resolution_adopted_on: Date) kind empirical {
    label en official "the nonqualified amount of the proceeds (section 141(b)(8) plus loans to persons other than governmental units, except section 141(c)(2) loans), the issue date, and the date of the State Bond Commission resolution";
}
pub relation nonqualified_amount_not_taken_into_account_1317_29(issue: BondIssue, amount: Money) kind institutional {
    label en official "the nonqualified amount of the proceeds, up to $150,000,000, is not taken into account under section 141(b)(5) or for the private activity bond determination";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(29) Certain private business use not taken into account.—")
rule NonqualifiedAmountNotTakenIntoAccount(issue: BondIssue, amount: Money, issued: Date, resolution: Date) strict {
    label en official "section 1317(29)(A)-(D): issued before January 1, 1993 by the State of Connecticut under a resolution of the State Bond Commission adopted before September 26, 1985; up to $150,000,000";
    when named_exception_matches_1986(issue, 1317, 29, 2);
    when connecticut_nonqualified_amount_1317_29(issue, amount, issued, resolution);
    when issued < @1993-01-01;
    when resolution < @1985-09-26;
    then nonqualified_amount_not_taken_into_account_1317_29(issue, min(amount, 150000000.00 USD));
}
rule Named1317P29Applies(issue: BondIssue, amount: Money) strict {
    label en official "section 1317(29)";
    when nonqualified_amount_not_taken_into_account_1317_29(issue, amount);
    then named_exception_applies_1986(issue, 1317, 29, 2);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(30) Volume cap not to apply to certain facilities.—For purposes of section 146 of the 1986 Code, any exempt facility bond for the following facility shall not be taken into account")
rule Named1317P30(issue: BondIssue, total: Money) strict {
    label en official "section 1317(30)(A)-(B): the water facility authorized under Public Law 90-537 begun on May 6, 1973 with forward funding of April 15, 1986; aggregate face amount within $391,000,000";
    when named_exception_matches_1986(issue, 1317, 30, 2);
    when named_exception_aggregate_face_1986(1317, 30, 2, total);
    when total <= 391000000.00 USD;
    when issue_within_1317_termination(issue);
    then named_exception_applies_1986(issue, 1317, 30, 2);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(31) Certain hydroelectric generating property.—A bond shall be treated as described in paragraph (2) of section 1316(f) of this Act if—")
rule Named1317P31(issue: BondIssue, total: Money) strict {
    label en official "section 1317(31)(A)-(C): the project with preliminary permit docket no. 6986; aggregate face amount within $12,000,000";
    when named_exception_matches_1986(issue, 1317, 31, 3);
    when named_exception_aggregate_face_1986(1317, 31, 3, total);
    when total <= 12000000.00 USD;
    when issue_within_1317_termination(issue);
    then named_exception_applies_1986(issue, 1317, 31, 3);
}
rule NamedEffect1317P31(issue: BondIssue) strict {
    label en official "section 1317(31): treated as described in section 1316(f)(2)";
    when named_exception_applies_1986(issue, 1317, 31, 3);
    then named_exception_effect_1986(issue, TreatedAsSection141d1WithCarryforwardPurpose);
}
relation state_ratified_constitution_on_1317_32(state: us.irc.core::Organ, ratified_on: Date) kind empirical {
    label en official "the State ratified the United States Constitution on the date";
}
relation state_ceiling_for_year_1317_32(state: us.irc.core::Organ, calendar_year: Integer, ceiling_otherwise_applicable: Money) kind empirical {
    label en official "the State ceiling otherwise applicable under section 146 for the calendar year";
}
pub relation state_ceiling_1987_1317_32(state: us.irc.core::Organ, ceiling: Money) kind institutional {
    label en official "the State ceiling under section 146 for calendar year 1987 for the State that ratified the Constitution on May 29, 1790 is $150,000,000 higher than otherwise";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(32) Volume cap.—The State ceiling applicable under section 146 of the 1986 Code for calendar year 1987 for the State which ratified the United States Constitution on May 29, 1790, shall be $150,000,000 higher than the State ceiling otherwise applicable under such section for such year.")
rule StateCeiling1987Increased(state: us.irc.core::Organ, otherwise: Money) strict {
    label en official "section 1317(32)";
    when state_ratified_constitution_on_1317_32(state, @1790-05-29);
    when state_ceiling_for_year_1317_32(state, 1987, otherwise);
    then state_ceiling_1987_1317_32(state, otherwise + 150000000.00 USD);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(34) Arbitrage rebate.—Section 148(f) of the 1986 Code shall not apply to any period before October 1, 1990")
rule Named1317P34(issue: BondIssue, total: Money) strict {
    label en official "section 1317(34): the Ohio high-speed rail system; aggregate face amount within $2,000,000,000";
    when named_exception_matches_1986(issue, 1317, 34, 0);
    when named_exception_aggregate_face_1986(1317, 34, 0, total);
    when total <= 2000000000.00 USD;
    when issue_within_1317_termination(issue);
    then named_exception_applies_1986(issue, 1317, 34, 0);
}
pub relation rebate_exemption_period_ends_1317_34(issue: BondIssue, ends_on: Date) kind institutional {
    label en official "section 148(f) does not apply to any period before October 1, 1990 for the bond";
}
rule RebateExemptionPeriodEnds(issue: BondIssue) strict {
    label en official "section 1317(34)";
    when named_exception_applies_1986(issue, 1317, 34, 0);
    then rebate_exemption_period_ends_1317_34(issue, @1990-10-01);
}
relation carryforward_facts_1317_35(issue: BondIssue, carryforward_amount: Money, calendar_year_of_limit: Integer, construction_commenced_within_3_years_after_year: Boolean) kind empirical {
    label en official "the carryforward under section 103(n)(10) of the 1954 Code, its amount, the calendar year of the bond limit, and whether construction of the facility commenced within the 3-year period following the calendar year in which the carryforward arose";
}
pub relation carryforward_period_years_1317_35(issue: BondIssue, years: Integer) kind institutional {
    label en official "clause (i) of section 103(n)(10)(C) of the 1954 Code applies with 6 calendar years instead of 3, and any authority designated by the State may use the carryforward";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(A) In the case of a carryforward under section 103(n)(10) of the 1954 Code of $170,000,000 of bond limit for calendar year 1984")
rule CarryforwardPeriodExtended(issue: BondIssue, amount: Money) strict {
    label en official "section 1317(35)(A)-(B): $170,000,000 for calendar year 1984, a local furnishing of electricity facility of section 645 of the Tax Reform Act of 1984";
    when named_exception_matches_1986(issue, 1317, 35, 2);
    when carryforward_facts_1317_35(issue, amount, 1984, true);
    when amount == 170000000.00 USD;
    then carryforward_period_years_1317_35(issue, 6);
}
rule Named1317P35Applies(issue: BondIssue, years: Integer) strict {
    label en official "section 1317(35)";
    when carryforward_period_years_1317_35(issue, years);
    then named_exception_applies_1986(issue, 1317, 35, 2);
}
relation power_purchase_bond_facts_1317_36(issue: BondIssue, business_use_share: Decimal, security_share: Decimal) kind empirical {
    label en official "the business use share and the security share of the issue, read with section 141(b)(1) and (2) and 25 percent replacing 10 percent, and without section 141(b)(3), (4), (5)";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = partial, quote = "\"(36) Power purchase bonds.—A bond issued to finance purchase of power from a power facility at a dam being renovated pursuant to P.L. 98–381")
rule Named1317P36(issue: BondIssue, use_share: Decimal, security: Decimal, total: Money) strict {
    label en official "section 1317(36): the bond finances the purchase of power from the dam renovated under P.L. 98-381, neither share exceeds 25 percent, aggregate face amount within $400,000,000";
    when named_exception_matches_1986(issue, 1317, 36, 0);
    when named_exception_aggregate_face_1986(1317, 36, 0, total);
    when total <= 400000000.00 USD;
    when power_purchase_bond_facts_1317_36(issue, use_share, security);
    when use_share <= 0.25;
    when security <= 0.25;
    when issue_within_1317_termination(issue);
    then named_exception_applies_1986(issue, 1317, 36, 0);
}
relation mortgage_bond_facts_1317_37(issue: BondIssue, issued_on: Date, satisfies_103A_of_1954_code: Boolean, issuer_is_one_of_two_most_populous_cities: Boolean) kind empirical {
    label en official "the bond is issued as part of one of two issues by the two most populous cities in the Tar Heel State on the date, and satisfies section 103A of the 1954 Code";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(37) Qualified mortgage bonds.—A bond issued as part of either of 2 issues no later than September 8, 1986")
rule Named1317P37(issue: BondIssue, issued: Date, total: Money) strict {
    label en official "section 1317(37): issued no later than September 8, 1986 and satisfying section 103A; aggregate face amount within $4,000,000";
    when named_exception_matches_1986(issue, 1317, 37, 0);
    when mortgage_bond_facts_1317_37(issue, issued, true, true);
    when issued <= @1986-09-08;
    when named_exception_aggregate_face_1986(1317, 37, 0, total);
    when total <= 4000000.00 USD;
    then named_exception_applies_1986(issue, 1317, 37, 0);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(38) Exempt facility bonds.—A bond shall be treated as an exempt facility bond within the meaning of section 142(a) of the 1986 Code if it is issued to fund residential, office, retail, light industrial, recreational and parking development known as Tobacco Row.")
rule Named1317P38(issue: BondIssue, total: Money) strict {
    label en official "section 1317(38): the Tobacco Row development; aggregate face amount within $100,000,000; subject to section 146";
    when named_exception_matches_1986(issue, 1317, 38, 0);
    when named_exception_aggregate_face_1986(1317, 38, 0, total);
    when total <= 100000000.00 USD;
    when issue_within_1317_termination(issue);
    then named_exception_applies_1986(issue, 1317, 38, 0);
}
relation qualified_501c3_facts_1317_39(issue: BondIssue, would_not_be_idb_if_issued_1986_08_15: Boolean, approved_by_city_voters_on: Date) kind empirical {
    label en official "the bond would not be an industrial development bond if issued on August 15, 1986, and the issue was approved by city voters on the date for construction or renovation of facilities for the cultural and performing arts";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(39) Certain bonds treated as qualified 501(c)(3) bonds.—A bond issued as part of an issue shall be treated")
rule Named1317P39(issue: BondIssue, total: Money, approved: Date) strict {
    label en official "section 1317(39)(A)-(B): approved by city voters on January 19, 1985; aggregate face amount within $5,000,000";
    when named_exception_matches_1986(issue, 1317, 39, 2);
    when qualified_501c3_facts_1317_39(issue, true, approved);
    when approved == @1985-01-19;
    when named_exception_aggregate_face_1986(1317, 39, 2, total);
    when total <= 5000000.00 USD;
    when issue_within_1317_termination(issue);
    then named_exception_applies_1986(issue, 1317, 39, 2);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(40) Certain library bonds.—In the case of a bond issued before January 1, 1986, by the City of Los Angeles Community Redevelopment Agency")
rule Named1317P40(issue: BondIssue, issued: Date) strict {
    label en official "section 1317(40): the Central Library Project bond issued before January 1, 1986";
    when named_exception_matches_1986(issue, 1317, 40, 0);
    when bond_issue_date_1986_transition(issue, issued);
    when issued < @1986-01-01;
    then named_exception_applies_1986(issue, 1317, 40, 0);
}
relation nuclear_refunding_facts_1317_41(issue: BondIssue, issued_on: Date, refunding_matures_on: Date, refunded_matures_on: Date, facilities_placed_in_service: Boolean) kind empirical {
    label en official "a refunding bond for the two net billed nuclear power facilities in Washington, its issue date and maturity, the refunded maturity, and whether the facilities were placed in service on the date of issuance";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(41) Certain refunding obligations for certain power facilities.—With respect to 2 net billed nuclear power facilities located in the State of Washington")
rule Named1317P41(issue: BondIssue, issued: Date, matures: Date, refunded: Date, total: Money) strict {
    label en official "section 1317(41)(A)-(B): refunding bonds issued before 1992, maturing no later than the refunded bonds, facilities not placed in service; aggregate face amount within $2,000,000,000";
    when named_exception_matches_1986(issue, 1317, 41, 0);
    when nuclear_refunding_facts_1317_41(issue, issued, matures, refunded, false);
    when issued < @1992-01-01;
    when matures <= refunded;
    when named_exception_aggregate_face_1986(1317, 41, 0, total);
    when total <= 2000000000.00 USD;
    then named_exception_applies_1986(issue, 1317, 41, 0);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(42) Residential rental property.—A bond issued to finance a residential rental project within the meaning of 103(b)(4) of the 1954 Code shall be treated as an exempt facility bond")
rule Named1317P42(issue: BondIssue, total: Money) strict {
    label en official "section 1317(42): the Polk County, Florida project with the inducement resolution of May 8, 1985; aggregate face amount within $4,100,000";
    when named_exception_matches_1986(issue, 1317, 42, 0);
    when named_exception_aggregate_face_1986(1317, 42, 0, total);
    when total <= 4100000.00 USD;
    when issue_within_1317_termination(issue);
    then named_exception_applies_1986(issue, 1317, 42, 0);
}
relation pool_bond_exemption_1317_44(issue: BondIssue) kind empirical {
    label en official "the pool bonds are of an amount listed in section 1317(44) (the amounts are in a table that the pinned fragment does not carry)";
}
relation hydro_or_cogeneration_facts_1317_46_47(issue: BondIssue, paragraph: Integer, amount: Money, issued_on: Date, is_refunding: Boolean, power_sold_to_nongovernmental_person_under_long_term_agreement: Boolean) kind empirical {
    label en official "obligations for the Cache Creek hydroelectric facility (46) or the San Jose steam and electric cogeneration facility (47): the amount, the issue date, whether a refunding, and whether substantially all power is sold to a nongovernmental person under a long-term power sales agreement";
}
pub relation nongovernmental_purchaser_not_principal_user_1317_46_47(issue: BondIssue) kind institutional {
    label en official "the purchaser of the power is not treated as a principal user of the facility by reason of the sales for section 103(b)(6)(D) and (E) of the 1954 Code";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(C) the initially issued obligations are issued on or before December 31, 1986, and any of such refunding obligations are issued on or before December 31, 1996,")
rule PurchaserNotPrincipalUserCache(issue: BondIssue, amount: Money, issued: Date) strict {
    label en official "section 1317(46)(A)-(C): not more than $5,000,000; initial obligations on or before December 31, 1986, refunding obligations on or before December 31, 1996";
    when named_exception_matches_1986(issue, 1317, 46, 0);
    when hydro_or_cogeneration_facts_1317_46_47(issue, 46, amount, issued, false, true);
    when amount <= 5000000.00 USD;
    when issued <= @1986-12-31;
    then nongovernmental_purchaser_not_principal_user_1317_46_47(issue);
}
rule PurchaserNotPrincipalUserCacheRefunding(issue: BondIssue, amount: Money, issued: Date) strict {
    label en official "section 1317(46)(A)-(C): refunding obligations on or before December 31, 1996";
    when named_exception_matches_1986(issue, 1317, 46, 0);
    when hydro_or_cogeneration_facts_1317_46_47(issue, 46, amount, issued, true, true);
    when issued <= @1996-12-31;
    then nongovernmental_purchaser_not_principal_user_1317_46_47(issue);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(47) Treatment of certain obligations to finance steam and electric cogeneration facility.—If—")
rule PurchaserNotPrincipalUserSanJose(issue: BondIssue, amount: Money, issued: Date) strict {
    label en official "section 1317(47)(A)-(C): not more than $4,400,000; obligations on or before December 31, 1986, refunding obligations on or before December 31, 1996";
    when named_exception_matches_1986(issue, 1317, 47, 0);
    when hydro_or_cogeneration_facts_1317_46_47(issue, 47, amount, issued, false, true);
    when amount <= 4400000.00 USD;
    when issued <= @1986-12-31;
    then nongovernmental_purchaser_not_principal_user_1317_46_47(issue);
}
rule PurchaserNotPrincipalUserSanJoseRefunding(issue: BondIssue, amount: Money, issued: Date) strict {
    label en official "section 1317(47)(A)-(C): refunding obligations on or before December 31, 1996";
    when named_exception_matches_1986(issue, 1317, 47, 0);
    when hydro_or_cogeneration_facts_1317_46_47(issue, 47, amount, issued, true, true);
    when issued <= @1996-12-31;
    then nongovernmental_purchaser_not_principal_user_1317_46_47(issue);
}
relation housing_refunding_facts_1317_49(issue: BondIssue, original_term_years: Integer, refunding_matures_on: Date, refunded_matures_on: Date, refunding_amount: Money, refunded_outstanding_amount: Money, refunding_rate: Decimal, refunded_rate: Decimal, refunded_required_to_be_redeemed_at_earliest_par_date: Boolean, refunded_issued_before_1983_12_31: Boolean) kind empirical {
    label en official "a refunding of a bond issued under section 11(b) of the United States Housing Act of 1937 before December 31, 1983: the original term, the maturities, the amounts, the interest rates, and the requirement to redeem at the earliest date at par";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(49) Transition rule for refunding certain housing bonds.—Sections 146 and [former] 149(d)(2) of the 1986 Code shall not apply to the refunding of any bond")
rule Named1317P49(issue: BondIssue, term: Integer, matures: Date, refunded_matures: Date, amount: Money, outstanding: Money, rate: Decimal, refunded_rate: Decimal) strict {
    label en official "section 1317(49)(A)-(E): an original term of at least 40 years, a maturity not later than the refunded bond, an amount within the outstanding amount, a lower interest rate, redemption at the earliest par date";
    when named_exception_matches_1986(issue, 1317, 49, 0);
    when housing_refunding_facts_1317_49(issue, term, matures, refunded_matures, amount, outstanding, rate, refunded_rate, true, true);
    when term >= 40;
    when matures <= refunded_matures;
    when amount <= outstanding;
    when rate < refunded_rate;
    when issue_within_1317_termination(issue);
    then named_exception_applies_1986(issue, 1317, 49, 0);
}
pub relation transitioned_bond_subject_to_147g_148_149d_1317_50(issue: BondIssue) kind institutional {
    label en official "for a bond to which a provision of section 1317 applies, sections 103 and 103A of the 1954 Code are applied as if the requirements of sections 147(g), 148 and 149(d) of the 1986 Code were included, except as otherwise expressly provided";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(50) Transitioned bonds subject to certain rules.—In the case of any bond to which any provision of this section applies")
rule TransitionedBondSubjectTo147g148149d(issue: BondIssue, paragraph: Integer, subparagraph: Integer) strict {
    label en official "section 1317(50)";
    when named_exception_applies_1986(issue, 1317, paragraph, subparagraph);
    when paragraph != 41;
    then transitioned_bond_subject_to_147g_148_149d_1317_50(issue);
}
rule TransitionedBondRequires147g(issue: BondIssue) strict {
    label en official "section 1317(50): section 147(g)";
    when transitioned_bond_subject_to_147g_148_149d_1317_50(issue);
    then transition_requirement_applies_1986(issue, Section147gIssuanceCosts);
}
rule TransitionedBondRequires148(issue: BondIssue) strict {
    label en official "section 1317(50): section 148";
    when transitioned_bond_subject_to_147g_148_149d_1317_50(issue);
    then transition_requirement_applies_1986(issue, Section148Arbitrage);
}
rule TransitionedBondRequires149d(issue: BondIssue) strict {
    label en official "section 1317(50): section 149(d)";
    when transitioned_bond_subject_to_147g_148_149d_1317_50(issue);
    then transition_requirement_applies_1986(issue, Section149d3And4AdvanceRefunding);
}
relation educational_organization_facts_1317_24(issue: BondIssue, trade_or_business_is_unrelated: Boolean) kind empirical {
    label en official "the trade or business carried on by the qualified educational organization is an unrelated trade or business (section 513(a))";
}
pub relation educational_organization_treated_as_governmental_unit_1317_24(issue: BondIssue) kind institutional {
    label en official "a qualified educational organization is treated as a governmental unit for section 103 and part IV, but only for a trade or business that is not an unrelated trade or business";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(A) In general.—For purposes of section 103 and part IV of subchapter B of chapter 1 of the 1986 Code, a qualified educational organization shall be treated as a governmental unit")
rule EducationalOrganizationTreatedAsGovernmentalUnit(issue: BondIssue) strict {
    label en official "section 1317(24)(A)-(B): the organization is a qualified educational organization (judgment) and the trade or business is not unrelated";
    when named_exception_matches_1986(issue, 1317, 24, 2);
    when educational_organization_facts_1317_24(issue, false);
    then educational_organization_treated_as_governmental_unit_1317_24(issue);
}
rule Named1317P24Applies(issue: BondIssue) strict {
    label en official "section 1317(24)";
    when educational_organization_treated_as_governmental_unit_1317_24(issue);
    then named_exception_applies_1986(issue, 1317, 24, 2);
}

rule NamedEffect1317P14(issue: BondIssue) strict {
    label en official "section 1317(14): the amendments made by section 1301 do not apply to the bonds";
    when named_exception_applies_1986(issue, 1317, 14, 0);
    then named_exception_effect_1986(issue, AmendmentsInapplicable);
}
rule NamedEffect1317P16(issue: BondIssue) strict {
    label en official "section 1317(16): the amendments made by section 1301 do not apply to the facility";
    when named_exception_applies_1986(issue, 1317, 16, 3);
    then named_exception_effect_1986(issue, AmendmentsInapplicable);
}
rule NamedEffect1317P12(issue: BondIssue) strict {
    label en official "section 1317(12): section 148(d)(3) and (f) do not apply to the refunding bond";
    when named_exception_applies_1986(issue, 1317, 12, 3);
    then named_exception_effect_1986(issue, Section148d3AndFInapplicable);
}
rule NamedEffect1317P17(issue: BondIssue) strict {
    label en official "section 1317(17): the refunding is not taken into account under section 146";
    when named_exception_applies_1986(issue, 1317, 17, 1);
    then named_exception_effect_1986(issue, VolumeCapNotTakenIntoAccount);
}
rule NamedEffect1317P21A(issue: BondIssue) strict {
    label en official "section 1317(21)(A): section 147(b) does not apply to the hospital pooled financing program";
    when named_exception_applies_1986(issue, 1317, 21, 1);
    then named_exception_effect_1986(issue, Section147bInapplicable);
