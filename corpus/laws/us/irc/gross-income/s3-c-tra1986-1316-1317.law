rule NamedEffect1317P30(issue: BondIssue) strict {
    label en official "section 1317(30): the exempt facility bond is not taken into account under section 146";
    when named_exception_applies_1986(issue, 1317, 30, 2);
    then named_exception_effect_1986(issue, VolumeCapNotTakenIntoAccount);
}
rule NamedEffect1317P34(issue: BondIssue) strict {
    label en official "section 1317(34): section 148(f) does not apply to any period before October 1, 1990";
    when named_exception_applies_1986(issue, 1317, 34, 0);
    then named_exception_effect_1986(issue, Section148fInapplicable);
}
rule NamedEffect1317P36(issue: BondIssue) strict {
    label en official "section 1317(36): the bond is not treated as a private activity bond";
    when named_exception_applies_1986(issue, 1317, 36, 0);
    then named_exception_effect_1986(issue, NotPrivateActivityBond);
}
rule NamedEffect1317P37(issue: BondIssue) strict {
    label en official "section 1317(37): the bond is treated as a qualified mortgage bond of section 141(d)(1)(B)";
    when named_exception_applies_1986(issue, 1317, 37, 0);
    then named_exception_effect_1986(issue, TreatedAsQualifiedMortgageBond);
}
rule NamedEffect1317P38(issue: BondIssue) strict {
    label en official "section 1317(38): the bond is treated as an exempt facility bond of section 142(a), subject to section 146";
    when named_exception_applies_1986(issue, 1317, 38, 0);
    then named_exception_effect_1986(issue, TreatedAsExemptFacilityBond);
}
rule NamedEffect1317P39(issue: BondIssue) strict {
    label en official "section 1317(39): the bond is treated as a qualified 501(c)(3) bond";
    when named_exception_applies_1986(issue, 1317, 39, 2);
    then named_exception_effect_1986(issue, TreatedAsQualified501c3Bond);
}
rule NamedEffect1317P40(issue: BondIssue) strict {
    label en official "section 1317(40): ownership and use by persons that are not governmental units does not adversely affect the exclusion";
    when named_exception_applies_1986(issue, 1317, 40, 0);
    then named_exception_effect_1986(issue, OwnershipAndUseNotAdverse);
}
rule NamedEffect1317P41(issue: BondIssue) strict {
    label en official "section 1317(41): the requirements of section 147(b) are treated as satisfied";
    when named_exception_applies_1986(issue, 1317, 41, 0);
    then named_exception_effect_1986(issue, Section147bTreatedAsSatisfied);
}
rule NamedEffect1317P42(issue: BondIssue) strict {
    label en official "section 1317(42): the bond is treated as an exempt facility bond of section 142(a)(7)";
    when named_exception_applies_1986(issue, 1317, 42, 0);
    then named_exception_effect_1986(issue, TreatedAsExemptFacilityBond);
}
rule NamedEffect1317P49(issue: BondIssue) strict {
    label en official "section 1317(49): sections 146 and former 149(d)(2) do not apply to the refunding";
    when named_exception_applies_1986(issue, 1317, 49, 0);
    then named_exception_effect_1986(issue, HousingBondRefundingRelief);
}
rule NamedEffect1317P24(issue: BondIssue) strict {
    label en official "section 1317(24)(A): the qualified educational organization is treated as a governmental unit";
    when named_exception_applies_1986(issue, 1317, 24, 2);
    then named_exception_effect_1986(issue, GovernmentalUnitTreatment);
}
rule NamedEffect1317P28(issue: BondIssue) strict {
    label en official "section 1317(28): loans up to $75,000,000 are not counted";
    when private_loans_not_taken_into_account_1317_28(issue, _);
    then named_exception_effect_1986(issue, PrivateLoansNotCounted);
}
rule NamedEffect1317P29(issue: BondIssue) strict {
    label en official "section 1317(29): the nonqualified amount is not taken into account";
    when nonqualified_amount_not_taken_into_account_1317_29(issue, _);
    then named_exception_effect_1986(issue, NonqualifiedAmountNotCounted);
}
rule NamedEffect1317P35(issue: BondIssue) strict {
    label en official "section 1317(35): the carryforward period is extended";
    when carryforward_period_years_1317_35(issue, _);
    then named_exception_effect_1986(issue, CarryforwardPeriodExtended);
}
rule NamedEffect1317P46P47(issue: BondIssue) strict {
    label en official "section 1317(46), (47): the purchaser is not a principal user";
    when nongovernmental_purchaser_not_principal_user_1317_46_47(issue);
    then named_exception_effect_1986(issue, PrincipalUserExcluded);
}
relation carryforward_use_1317_45(issue: BondIssue, paragraph: Integer, amount: Money, year_of_use: Integer) kind empirical {
    label en official "a carryforward of unused State bond authority used in the year: for the metropolitan service district (A) up to $100,000,000 of unused 1985 authority, for the waste water treatment revenue bonds (B) the carryforward election of the governor's executive order";
}
pub relation carryforward_election_valid_1317_45(issue: BondIssue, until_year: Integer) kind institutional {
    label en official "the carryforward election is valid for the year: (A) any year until 1989, (B) any year through 1988";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(A) In the case of a metropolitan service district created pursuant to State revised statutes, chapter 268, up to $100,000,000 unused 1985 bond authority may be carried forward to any year until 1989")
rule CarryforwardElectionValid1317P45A(issue: BondIssue, amount: Money, year: Integer) strict {
    label en official "section 1317(45)(A): up to $100,000,000 carried forward to any year until 1989";
    when named_exception_matches_1986(issue, 1317, 45, 1);
    when carryforward_use_1317_45(issue, 1, amount, year);
    when amount <= 100000000.00 USD;
    when year < 1989;
    then carryforward_election_valid_1317_45(issue, 1988);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "such carryforward election shall be valid for any year through 1988. The aggregate face amount of obligations to which this subparagraph applies shall not exceed $98,500,000.")
rule CarryforwardElectionValid1317P45B(issue: BondIssue, amount: Money, year: Integer, total: Money) strict {
    label en official "section 1317(45)(B): valid for any year through 1988; aggregate face amount within $98,500,000";
    when named_exception_matches_1986(issue, 1317, 45, 2);
    when carryforward_use_1317_45(issue, 2, amount, year);
    when named_exception_aggregate_face_1986(1317, 45, 2, total);
    when total <= 98500000.00 USD;
    when year <= 1988;
    then carryforward_election_valid_1317_45(issue, 1988);
}
rule NamedEffect1317P45(issue: BondIssue, until: Integer) strict {
    label en official "section 1317(45)";
    when carryforward_election_valid_1317_45(issue, until);
    then named_exception_effect_1986(issue, CarryforwardPeriodExtended);
}

rule NamedEffect1317P41VolumeCap(issue: BondIssue) strict {
    label en official "section 1317(41): section 146 does not apply to the refunding bonds";
    when named_exception_applies_1986(issue, 1317, 41, 0);
    then named_exception_effect_1986(issue, VolumeCapNotTakenIntoAccount);
}
rule NamedEffect1316g7Section141(issue: BondIssue) strict {
    label en official "section 1316(g)(7)(A): section 141 is applied without regard to subsection (a)(2) and paragraphs (4) and (5) of subsection (b)";
    when named_exception_applies_1986(issue, 1316, 7, 7);
    then named_exception_effect_1986(issue, Section141a2B4B5Inapplicable);
}
rule NamedEffect1317P27Post(issue: BondIssue) strict {
    label en official "section 1317(27)(I): section 149(b) does not apply solely because a United States Post Office occupies part of the Andover Town Hall";
    when named_exception_applies_1986(issue, 1317, 27, 9);
    then named_exception_effect_1986(issue, Section149bInapplicable);
}
rule NamedEffect1317P51Section141b(issue: BondIssue, subparagraph: Integer) strict {
    label en official "section 1317(51): sections 141(b)(3) and 141(c)(1)(B) do not apply";
    when named_exception_applies_1986(issue, 1317, 51, subparagraph);
    then named_exception_effect_1986(issue, Section141b3AndC1BInapplicable);
}
relation bond_would_be_exempt_if_issued_1986_08_15_1317_6Y(issue: BondIssue) kind empirical {
    label en official "interest on the bond would have been exempt from tax were the bond issued on August 15, 1986";
}
pub relation redevelopment_exemption_denied_after_1987_06_10_1317_6Y(issue: BondIssue) kind institutional {
    label en official "nothing in section 1317(6) exempts interest on a bond issued after June 10, 1987 if the interest would not have been exempt were the bond issued on August 15, 1986";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(Y) Nothing in this paragraph shall be construed as having the effect of exempting from tax interest on any bond issued after June 10, 1987")
rule RedevelopmentExemptionDeniedAfterJune1987(issue: BondIssue, issued: Date, sub: Integer) strict {
    label en official "section 1317(6)(Y)";
    when named_exception_applies_1986(issue, 1317, 6, sub);
    when bond_issue_date_1986_transition(issue, issued);
    when issued > @1987-06-10;
    when not_known(bond_would_be_exempt_if_issued_1986_08_15_1317_6Y(issue));
    then redevelopment_exemption_denied_after_1987_06_10_1317_6Y(issue);
}
pub relation designated_area_taken_into_account_1317_6Z(issue: BondIssue) kind institutional {
    label en official "the designated area of a project described in a subparagraph of section 1317(6) is taken into account in applying section 144(c)(4)(C) when deciding whether other areas may be designated";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(Z) Any designated area with respect to which a project is described in any subparagraph of this paragraph shall be taken into account in applying section 144(c)(4)(C)")
rule DesignatedAreaTakenIntoAccount(issue: BondIssue, sub: Integer) strict {
    label en official "section 1317(6)(Z)";
    when named_exception_applies_1986(issue, 1317, 6, sub);
    then designated_area_taken_into_account_1317_6Z(issue);
}
pub relation bond_counts_for_later_145b_1317_33N(issue: BondIssue) kind institutional {
    label en official "a bond to which section 145(b) does not apply by reason of section 1317(33) (other than subparagraph (A)) is taken into account in determining whether section 145(b) applies to any later issue";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "\"(N) Any bond to which section 145(b) of the 1986 Code does not apply by reason of this paragraph (other than subparagraph (A) thereof) shall be taken into account")
rule BondCountsForLaterIssues145b1317(issue: BondIssue, sub: Integer) strict {
    label en official "section 1317(33)(N)";
    when named_exception_applies_1986(issue, 1317, 33, sub);
    when sub > 1;
    then bond_counts_for_later_145b_1317_33N(issue);
}
relation refunding_bond_facts_1317_33O(issue: BondIssue, last_sentence_of_1313c2_applies: Boolean, issuer_elects_the_opposite_result: Boolean) kind empirical {
    label en official "the refunding bond is one to which a subparagraph of section 1317(33) applies and to which the last sentence of section 1313(c)(2) applies, and whether the issuer elects the opposite result";
}
pub relation refunding_treated_as_pre_1986_and_not_advance_1317_33O(issue: BondIssue) kind institutional {
    label en official "the refunding bond is treated as issued before January 1, 1986 and as not being an advance refunding, and the subparagraph applies to it";
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "such bond shall be treated as having such subparagraph apply (and the refunding bond shall be treated for purposes of such section as issued before January 1, 1986")
rule RefundingTreatedAsPre1986AndNotAdvance(issue: BondIssue, sub: Integer) strict {
    label en official "section 1317(33)(O)";
    when named_exception_matches_1986(issue, 1317, 33, sub);
    when refunding_bond_facts_1317_33O(issue, true, false);
    when issue_within_1317_termination(issue);
    then refunding_treated_as_pre_1986_and_not_advance_1317_33O(issue);
}
rule NamedEffect1317P33Refunding(issue: BondIssue) strict {
    label en official "section 1317(33)(O)";
    when refunding_treated_as_pre_1986_and_not_advance_1317_33O(issue);
    then named_exception_effect_1986(issue, RefundingTreatedAsPre1986NonAdvance);
}
rule Named1315dByParagraph1317(issue: BondIssue, paragraph: Integer, subparagraph: Integer) strict {
    label en official "section 1315(d)(2): a facility or purpose described in a paragraph of section 1317";
    when named_exception_applies_1986(issue, 1317, paragraph, subparagraph);
    then bond_facility_or_purpose_described_1315d(issue);
}
// section 10631 of Pub. L. 100-203 (Omnibus Budget Reconciliation Act of 1987), quoted in the note
// under section 141 (fragment IRC_S141_NOTE_5)
relation bond_facts_10631(issue: BondIssue, issued_on: Date, refunds_bond_issued_on_or_before_1987_10_13: Boolean) kind empirical {
    label en official "the date the bond is issued, and whether it is issued to refund a bond issued on or before October 13, 1987";
}
pub relation amendments_of_1987_apply_10631(issue: BondIssue) kind institutional {
    label en official "the amendments of section 10631 of Pub. L. 100-203 (sections 141, 142 and 146) apply to the bond: it is issued after October 13, 1987 and does not refund a bond issued on or before that date, subject to the exceptions of paragraphs (2) and (3)";
}
relation binding_contract_facts_10631(issue: BondIssue, facility_acquired_on: Date, binding_contract_entered_on: Date, is_advance_refunding_bond: Boolean) kind empirical {
    label en official "the facility is acquired on the date pursuant to a binding contract entered into on the date, and whether the bond is an advance refunding bond";
}
pub relation bond_excepted_from_1987_amendments_10631(issue: BondIssue) kind institutional {
    label en official "the amendments of section 10631 do not apply to the bond: a facility acquired after October 13, 1987 under a binding contract entered into on or before that date (not an advance refunding bond), or a bond of the authority named in paragraph (3)";
}
@source(IRC_S141_NOTE_5, relation = formalizes, coverage = exact, quote = "\"(2) Binding agreements.—The amendments made by this section shall not apply to bonds (other than advance refunding bonds) with respect to a facility acquired after October 13, 1987")
rule Exception10631ByBindingContract(issue: BondIssue, acquired: Date, contract: Date) strict {
    label en official "section 10631(c)(2)";
    when binding_contract_facts_10631(issue, acquired, contract, false);
    when acquired > @1987-10-13;
    when contract <= @1987-10-13;
    then bond_excepted_from_1987_amendments_10631(issue);
}
@source(IRC_S141_NOTE_5, relation = formalizes, coverage = exact, quote = "\"(3) Transitional rule.—The amendments made by this section shall not apply to bonds issued—")
rule Exception10631ByNamedAuthority(issue: BondIssue, issued: Date) strict {
    label en official "section 10631(c)(3)(A)-(B): bonds issued after October 13, 1987 by the authority created by the statute approved by the State Governor on July 24, 1986 (sections 1 through 10 effective on January 15, 1987), to provide facilities serving the area of the statute";
    when named_exception_matches_1986(issue, 10631, 3, 0);
    when bond_facts_10631(issue, issued, false);
    when issued > @1987-10-13;
    then bond_excepted_from_1987_amendments_10631(issue);
}
@source(IRC_S141_NOTE_5, relation = formalizes, coverage = exact, quote = "\"(1) In general.—Except as otherwise provided in this subsection, the amendments made by this section [amending this section and sections 142 and 146 of this title] shall apply to bonds issued after October 13, 1987")
rule AmendmentsOf1987Apply(issue: BondIssue, issued: Date) strict {
    label en official "section 10631(c)(1)";
    when bond_facts_10631(issue, issued, false);
    when issued > @1987-10-13;
    when not_known(bond_excepted_from_1987_amendments_10631(issue));
    then amendments_of_1987_apply_10631(issue);
}

// =====================================================================
// G6401 wiring: Pub. L. 99-514 §1318(c), closing sentence
// =====================================================================
// "No limitation in section 1316(g) or 1317 on the period during which bonds may be issued under such section shall
// apply to any refunding bond which meets the requirements of this subsection." The refunding bond that meets
// (c) (`refunding_not_counted_against_transition_limit_1318c`) therefore needs no issue-date test: each rule of a
// named exception that tests the issue date has a sibling below that reads the (c) conclusion in its place, and
// the termination of section 1317(52) is lifted the same way. The class numbers and the named-exception match are
// those of the rule they mirror.
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "No limitation in section 1316(g) or 1317 on the period during which bonds may be issued under such section shall apply to any refunding bond which meets the requirements of this subsection.")
rule IssueWithinTermination1317RefundingMeeting1318c(issue: BondIssue) strict {
    label en official "section 1318(c), closing sentence: the section 1317(52) termination does not apply to a refunding bond that meets (c)";
    when refunding_not_counted_against_transition_limit_1318c(issue);
    then issue_within_1317_termination(issue);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "No limitation in section 1316(g) or 1317 on the period during which bonds may be issued under such section shall apply to any refunding bond which meets the requirements of this subsection.")
rule Named1316g1RefundingMeeting1318c(issue: BondIssue) strict {
    label en official "section 1318(c), closing sentence, with section 1316(g)(1): no issue-period limit for a refunding bond that meets (c)";
    when named_exception_matches_1986(issue, 1316, 7, 1);
    when tra1984_bond_class_1316g(issue, 1);
    when refunding_not_counted_against_transition_limit_1318c(issue);
    then named_exception_applies_1986(issue, 1316, 7, 1);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "No limitation in section 1316(g) or 1317 on the period during which bonds may be issued under such section shall apply to any refunding bond which meets the requirements of this subsection.")
rule Named1316g2ARefundingMeeting1318c(issue: BondIssue) strict {
    label en official "section 1318(c), closing sentence, with section 1316(g)(2): no issue-period limit for a refunding bond that meets (c)";
    when named_exception_matches_1986(issue, 1316, 7, 2);
    when tra1984_bond_class_1316g(issue, 2);
    when refunding_not_counted_against_transition_limit_1318c(issue);
    then named_exception_applies_1986(issue, 1316, 7, 2);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "No limitation in section 1316(g) or 1317 on the period during which bonds may be issued under such section shall apply to any refunding bond which meets the requirements of this subsection.")
rule Named1316g3RefundingMeeting1318c(issue: BondIssue) strict {
    label en official "section 1318(c), closing sentence, with section 1316(g)(3): no issue-period limit for a refunding bond that meets (c)";
    when named_exception_matches_1986(issue, 1316, 7, 3);
    when tra1984_bond_class_1316g(issue, 5);
    when refunding_not_counted_against_transition_limit_1318c(issue);
    then named_exception_applies_1986(issue, 1316, 7, 3);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "No limitation in section 1316(g) or 1317 on the period during which bonds may be issued under such section shall apply to any refunding bond which meets the requirements of this subsection.")
rule Named1316g6RefundingMeeting1318c(issue: BondIssue) strict {
    label en official "section 1318(c), closing sentence, with section 1316(g)(6): no issue-period limit for a refunding bond that meets (c)";
    when named_exception_matches_1986(issue, 1316, 7, 6);
    when tra1984_bond_class_1316g(issue, 10);
    when refunding_not_counted_against_transition_limit_1318c(issue);
    then named_exception_applies_1986(issue, 1316, 7, 6);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "No limitation in section 1316(g) or 1317 on the period during which bonds may be issued under such section shall apply to any refunding bond which meets the requirements of this subsection.")
rule Named1316g7RefundingMeeting1318c(issue: BondIssue) strict {
    label en official "section 1318(c), closing sentence, with section 1316(g)(7): no issue-period limit for a refunding bond that meets (c)";
    when named_exception_matches_1986(issue, 1316, 7, 7);
    when tra1984_bond_class_1316g(issue, 11);
    when refunding_not_counted_against_transition_limit_1318c(issue);
    then named_exception_applies_1986(issue, 1316, 7, 7);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "No limitation in section 1316(g) or 1317 on the period during which bonds may be issued under such section shall apply to any refunding bond which meets the requirements of this subsection.")
rule Named1316g8ARefundingMeeting1318c(issue: BondIssue) strict {
    label en official "section 1318(c), closing sentence, with section 1316(g)(8): no issue-period limit for a refunding bond that meets (c)";
    when named_exception_matches_1986(issue, 1316, 7, 8);
    when tra1984_bond_class_1316g(issue, 12);
    when refunding_not_counted_against_transition_limit_1318c(issue);
    then named_exception_applies_1986(issue, 1316, 7, 8);
}
@source(IRC_S141_NOTE_6, relation = formalizes, coverage = exact, quote = "No limitation in section 1316(g) or 1317 on the period during which bonds may be issued under such section shall apply to any refunding bond which meets the requirements of this subsection.")
rule Named1316g4RefundingMeeting1318c(issue: BondIssue, class_number: Integer) strict {
    label en official "section 1318(c), closing sentence, with section 1316(g)(4): no issue-period limit for a refunding bond that meets (c)";
    when named_exception_matches_1986(issue, 1316, 7, 4);
    when tra1984_bond_class_1316g(issue, class_number);
    when class_number >= 6;
    when class_number <= 9;
    when refunding_not_counted_against_transition_limit_1318c(issue);
    then named_exception_applies_1986(issue, 1316, 7, 4);
}
