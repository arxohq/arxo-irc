// Section 62 — Adjusted gross income defined. Stage 1 (IRC-06).
//
// §62(a): AGI = gross income minus the (a)(1)-(a)(21) "above the line"
// deductions. Every paragraph names a DEDUCTION ALLOWED ELSEWHERE (chapter 1
// parts VI/VII, §§162/165/167/194/211-224/etc.) and merely reclassifies it
// as taken "above the line". The `deductions` owner package is pending
// (task instruction): each paragraph's deduction AMOUNT is a typed
// institutional dependency contract this package declares and
// `deductions` (or, for a few paragraphs, `credits`/`property-transactions`)
// will produce. This package owns the AGI ARITHMETIC and the two
// paragraphs whose ELIGIBILITY TEST is itself textually complete in §62
// ((b) qualified performing artist, (d) eligible educator, (e) unlawful
// discrimination) — the deduction AMOUNTS for those two remain a
// `deductions`-owned dependency (§162/§165 producers), only the ELIGIBILITY
// classification is this package's to formalize.

// `Person`/`Individual`/`TaxableYear` aliases are declared once for the
// package in `s61-gross-income.law` (LDC-E1201: one alias per package).

// --- §62(a): the twenty-one above-the-line paragraphs -------------------------

use self::{
    IRC_S62_A,
    IRC_S62_B,
    IRC_S62_C,
    IRC_S62_D,
    Individual,
    Person,
    TaxableYear,
    gross_income,
};

pub enum AboveLineDeductionKind {
    TradeOrBusinessDeductions;              // (a)(1)
    ReimbursedEmployeeExpenses;             // (a)(2)(A)
    PerformingArtistExpenses;               // (a)(2)(B)
    OfficialsFeeBasisExpenses;              // (a)(2)(C)
    EducatorExpenses;                       // (a)(2)(D)
    ReserveComponentTravelExpenses;         // (a)(2)(E)
    LossesFromSaleOrExchangeOfProperty;     // (a)(3)
    RentsAndRoyaltiesDeductions;            // (a)(4)
    LifeTenantIncomeBeneficiaryDeductions;  // (a)(5)
    SelfEmployedRetirementPlanDeduction;    // (a)(6)
    RetirementSavingsDeduction;             // (a)(7) — section 219
    PrematureWithdrawalPenaltyDeduction;    // (a)(9)
    ReforestationExpenses;                  // (a)(11)
    SupplementalUnemploymentRepayment;      // (a)(12)
    JuryDutyPayRemittedToEmployer;          // (a)(13)
    MovingExpenses;                         // (a)(15) — section 217 (armed forces only, per current text)
    ArcherMsaDeduction;                     // (a)(16)
    EducationLoanInterestDeduction;         // (a)(17)
    HealthSavingsAccountDeduction;          // (a)(19)
    DiscriminationSuitCosts;                // (a)(20)
    WhistleblowerAttorneysFees;             // (a)(21)
}

// §62(a)(8), (10), (14), (18): repealed paragraphs. No `AboveLineDeductionKind`
// value is declared for them; classification = REPEALED_OR_RESERVED, coverage
// rows record the repeal citation from the pinned text.

// Case fact / dependency-contract amount per paragraph. Producer: `deductions`
// (pending) for the general run of paragraphs; `credits`/`property-
// transactions` are NOT producers here (§62 pulls only from deductions
// already allowed by chapter 1, never a credit).
pub relation above_the_line_deduction_amount(p: Individual, y: TaxableYear, kind: AboveLineDeductionKind, amount: Money) kind institutional {
    label en official "an amount allowed as a deduction described in one of the paragraphs of section 62(a)";
}

pub relation adjusted_gross_income(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "adjusted gross income (section 62)";
}

@source(IRC_S62_A, quote = "the term \"adjusted gross income\" means, in the case of an individual, gross income minus the following deductions")
rule AdjustedGrossIncomeGeneralRule(p: Individual, y: TaxableYear, gross: Money) strict {
    label en official "adjusted gross income is gross income minus the above-the-line deductions of section 62(a)";
    when gross_income(p, y, gross);
    then adjusted_gross_income(p, y,
        gross
        - sum(collect all amount: Money, kind: AboveLineDeductionKind where above_the_line_deduction_amount(p, y, kind, amount) and kind != PerformingArtistExpenses and kind != EducatorExpenses and kind != ReimbursedEmployeeExpenses, empty: 0.00 USD)
        - sum(collect all a1: Money where performing_artist_deduction_allowed_62(p, y, a1), empty: 0.00 USD)
        - sum(collect all a2: Money where educator_deduction_allowed_62(p, y, a2), empty: 0.00 USD)
        - sum(collect all a3: Money where reimbursed_deduction_allowed_62(p, y, a3), empty: 0.00 USD));
}
// G6404 wiring: three above-the-line kinds are allowed only where the §62 definition of the deduction is met, so
// the aggregate reads them through the derived `*_allowed_62` relations and the plain kinds directly.
// (a)(2)(B): only a qualified performing artist (`qualified_performing_artist`, §62(b));
// (a)(2)(D): only an eligible educator (`eligible_educator`, §62(d)(1));
// (a)(2)(A): only expenses under a reimbursement arrangement (`not_a_reimbursement_arrangement`, §62(c), bars it).
relation performing_artist_deduction_allowed_62(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 62(a)(2)(B) deduction of a qualified performing artist";
}
@source(IRC_S62_A, quote = "the term \"adjusted gross income\" means, in the case of an individual, gross income minus the following deductions")
rule PerformingArtistDeductionAllowed(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 62(a)(2)(B) with (b): the performing-artist expenses are deducted only for a qualified performing artist";
    when above_the_line_deduction_amount(p, y, PerformingArtistExpenses, amount);
    when qualified_performing_artist(p, y);
    then performing_artist_deduction_allowed_62(p, y, amount);
}
relation educator_deduction_allowed_62(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 62(a)(2)(D) deduction of an eligible educator";
}
@source(IRC_S62_A, quote = "the term \"adjusted gross income\" means, in the case of an individual, gross income minus the following deductions")
rule EducatorDeductionAllowed(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 62(a)(2)(D) with (d)(1): the educator expenses are deducted only for an eligible educator";
    when above_the_line_deduction_amount(p, y, EducatorExpenses, amount);
    when eligible_educator(p, y);
    then educator_deduction_allowed_62(p, y, amount);
}
relation employee_expenses_under_arrangement_62c(p: Individual, y: TaxableYear, arr: Person) kind empirical {
    label en official "the employee's expenses of the year are paid under this arrangement (section 62(a)(2)(A), (c))";
}
relation reimbursed_deduction_barred_62c(p: Individual, y: TaxableYear) kind institutional {
    label en official "the arrangement under which the expenses are paid is not a reimbursement arrangement (section 62(c)), so the (a)(2)(A) deduction is not allowed";
}
rule ReimbursedDeductionBarred(p: Individual, y: TaxableYear, arr: Person) strict {
    label en official "section 62(c): the arrangement fails the substantiation or retention test";
    when employee_expenses_under_arrangement_62c(p, y, arr);
    when not_a_reimbursement_arrangement(arr);
    then reimbursed_deduction_barred_62c(p, y);
}
relation reimbursed_deduction_allowed_62(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 62(a)(2)(A) deduction of reimbursed employee expenses";
}
@source(IRC_S62_A, quote = "the term \"adjusted gross income\" means, in the case of an individual, gross income minus the following deductions")
rule ReimbursedDeductionAllowed(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 62(a)(2)(A): the reimbursed-expense deduction unless the arrangement is barred by (c)";
    when above_the_line_deduction_amount(p, y, ReimbursedEmployeeExpenses, amount);
    when not_known(reimbursed_deduction_barred_62c(p, y));
    then reimbursed_deduction_allowed_62(p, y, amount);
}

// --- §62(b): qualified performing artist ---------------------------------------

relation performed_services_in_performing_arts_for_employers(p: Individual, y: TaxableYear, employer_count: Integer) kind empirical {
    label en official "performed services in the performing arts as an employee during the taxable year for at least 2 employers (section 62(b)(1)(A))";
}
relation performing_arts_section_162_deductions(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the aggregate amount allowable as a deduction under section 162 in connection with the performance of such services (section 62(b)(1)(B)) — dependency contract, producer: deductions";
}
relation performing_arts_attributable_gross_income(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "gross income attributable to the performance of such services (section 62(b)(1)(B))";
}
relation agi_without_regard_to_performing_artist_deduction(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "adjusted gross income determined without regard to subsection (a)(2)(B) (section 62(b)(1)(C))";
}

pub relation qualified_performing_artist(p: Individual, y: TaxableYear) kind institutional {
    label en official "qualified performing artist (section 62(b))";
}

@source(IRC_S62_B, quote = "such individual performed services in the performing arts as an employee during the taxable year for at least 2 employers")
rule QualifiedPerformingArtistTest(p: Individual, y: TaxableYear, employers: Integer, ded: Money, gross: Money, agi: Money) strict {
    label en official "an individual who performed for at least 2 employers, whose section 162 performing-arts deductions exceed 10 percent of the attributable gross income, and whose AGI (without regard to the deduction) does not exceed $16,000, is a qualified performing artist";
    when performed_services_in_performing_arts_for_employers(p, y, employers);
    when employers >= 2;
    when performing_arts_section_162_deductions(p, y, ded);
    when performing_arts_attributable_gross_income(p, y, gross);
    when ded > 0.10 * gross;
    when agi_without_regard_to_performing_artist_deduction(p, y, agi);
    when agi <= 16000.00 USD;
    then qualified_performing_artist(p, y);
}
// §62(b)(2) (nominal-employer $200 floor), (b)(3) (married-couple special
// rules keyed to §7703(a) marital status and joint-return status) are
// further conditions this stage records as INTERPRETATION rows rather than
// folding into one combinatorial rule: they narrow an already-modelled test
// rather than add a new disposition kind.

// --- §62(d): eligible educator --------------------------------------------------

relation is_k12_educator_for_hours(p: Individual, y: TaxableYear, hours: Integer) kind empirical {
    label en official "a kindergarten through grade 12 teacher, instructor, counselor, principal, or aide in a school for at least 900 hours during a school year (section 62(d)(1)(A))";
}

pub relation eligible_educator(p: Individual, y: TaxableYear) kind institutional {
    label en official "eligible educator (section 62(d)(1))";
}

@source(IRC_S62_D, quote = "an individual who is a kindergarten through grade 12 teacher, instructor, counselor, principal, or aide in a school for at least 900 hours during a school year")
rule EligibleEducatorTest(p: Individual, y: TaxableYear, hours: Integer) strict {
    label en official "a K-12 teacher, instructor, counselor, principal, or aide who serves at least 900 hours during the school year is an eligible educator";
    when is_k12_educator_for_hours(p, y, hours);
    when hours >= 900;
    then eligible_educator(p, y);
}
// §62(d)(2) (coordination with §135/§529(c)(1)/§530(d)(2) exclusions) and
// §62(d)(3) (annual $250 inflation adjustment, tied to section 1(f)(3) COLA)
// are TECH_GAP/SOURCE_GAP: the $250 base is pinned (IRC_S62_A quote inside
// paragraph (2)(D)), but no Rev. Proc. published amount for any year is
// pinned here — never invented, per AGENT-BRIEF.

// --- §62(e): unlawful discrimination (definitional cross-reference list) ------
//
// §62(e) defines "unlawful discrimination" for (a)(20) by an eighteen-item
// disjunctive list of EXTERNAL statutes (Title VII, ADEA, ADA, FLSA, etc.).
// classification = NON_NORMATIVE: the paragraph enacts no test this package
// can compute from Title 26 text alone (whether a given claim arises "under"
// one of the eighteen named external statutes is a question of THOSE
// statutes, out of this corpus). A case package asserts the classification
// directly as a fact feeding (a)(20)'s dependency contract
// (`DiscriminationSuitCosts` kind), citing which paragraph of (e) applies.

// --- §62(c): reimbursement-arrangement anti-abuse rule -------------------------

relation reimbursement_arrangement_requires_substantiation(arr: Person) kind empirical {
    label en official "an arrangement requires the employee to substantiate expenses to the person providing the reimbursement (section 62(c)(1), negated)";
}
relation reimbursement_arrangement_allows_retention_of_excess(arr: Person) kind empirical {
    label en official "an arrangement provides the employee the right to retain any amount in excess of the substantiated expenses (section 62(c)(2))";
}
pub relation not_a_reimbursement_arrangement(arr: Person) kind institutional {
    label en official "an arrangement is, in no event, treated as a reimbursement or other expense allowance arrangement (section 62(c))";
}

relation reimbursement_arrangement_candidate(arr: Person) kind empirical {
    label en official "an arrangement under examination for section 62(c) classification (domain-binding fact for the two disqualification rules below)";
}

@source(IRC_S62_C, quote = "such arrangement does not require the employee to substantiate the expenses covered by the arrangement")
rule NoSubstantiationRequirementDisqualifies(arr: Person) strict {
    label en official "an arrangement that does not require substantiation is never a reimbursement arrangement";
    when reimbursement_arrangement_candidate(arr);
    when not_known(reimbursement_arrangement_requires_substantiation(arr));
    then not_a_reimbursement_arrangement(arr);
}

@source(IRC_S62_C, quote = "such arrangement provides the employee the right to retain any amount in excess of the substantiated expenses covered under the arrangement")
rule RetentionRightDisqualifies(arr: Person) strict {
    label en official "an arrangement letting the employee retain excess amounts is never a reimbursement arrangement";
    when reimbursement_arrangement_allows_retention_of_excess(arr);
    then not_a_reimbursement_arrangement(arr);
}
// The §274(d) substantiation-exception carve-out (last sentence of (c)) is a
// narrowing condition on `reimbursement_arrangement_requires_substantiation`
// itself, owned by whichever package formalizes §274 (stage 2 elsewhere);
// recorded as an EXTERNAL_DEPENDENCY note, not folded in here.
