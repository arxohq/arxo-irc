// Gross income -- WIRE-8 (26.09.2026, DECISION-0379 Д-22 item (б), implemented_unverified).
//
// The lower package `income_individual` (sections 55-59 alternative minimum tax) declares local contracts for amounts this package
// owns (sections 63, 67, 68, 87, 151) and cannot import this package (this package imports `income_individual`; a direct import back
// would be an import cycle). The owner DERIVES the lower package's `pub` relations from its own relations with qualified rule heads
// (same technique as `deductions/pub-interface-wiring.law`, Д-13 item 5). The case-fact channel stays valid: scenarios of
// `income_individual` never load this package. Nothing is recomputed here; each rule only names the owner's amount under the
// lower package's name for it.

language "law.core" version "0.2";
package us.irc.gross_income version "0.1.1";
namespace "urn:us:irc:gross_income:clir";

use self::{
    BondIssue,
    Individual,
    Person,
    TaxableYear,
    alcohol_fuel_credit_40a,
    biodiesel_fuels_credit_40Aa,
    elects_to_itemize_on_return,
    fuel_credit_includible_87,
    itemized_deductions_reduced_amount,
    miscellaneous_itemized_deductions_allowed,
    personal_exemption_deduction_151,
    private_activity_bond,
    qualified_501c3_bond_145a,
    qualified_mortgage_bond_143,
    qualified_veterans_mortgage_issue_143b,
    standard_deduction,
    sustainable_aviation_fuel_credit_40Ba,
    taxable_income,
    taxable_income_non_itemizer_formula_applies,
};

rule W8TaxableIncomeForAmt(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 55(b)(1)(D): taxable income as defined in section 63 is this package's section 63 taxable income";
    when us.irc.gross_income::taxable_income(p, y, amount);
    then us.irc.income_individual::taxable_income(p, y, amount);
}

rule W8StandardDeductionClaimedByNonItemizer(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 56(b)(1)(D): an individual who does not elect to itemize claims the section 63(c) standard deduction for the regular tax";
    when taxable_income_non_itemizer_formula_applies(p, y);
    when standard_deduction(p, y, amount);
    then us.irc.income_individual::standard_deduction_claimed(p, y, amount);
}
rule W8StandardDeductionNotClaimedByItemizer(p: Individual, y: TaxableYear) strict {
    label en official "section 56(b)(1)(D): an individual who elects to itemize claims no standard deduction for the regular tax (zero, as the alternative minimum tax rule expects)";
    when elects_to_itemize_on_return(p, y);
    then us.irc.income_individual::standard_deduction_claimed(p, y, 0.00 USD);
}

rule W8PersonalExemptionClaimed(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 56(b)(1)(D): the section 151 deduction for personal exemptions claimed for the regular tax is this package's section 151 amount";
    when personal_exemption_deduction_151(p, y, amount);
    then us.irc.income_individual::personal_exemption_deduction_claimed(p, y, amount);
}

rule W8MiscItemizedDeductionsClaimed(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 56(b)(1)(A)(i): the miscellaneous itemized deductions claimed for the regular tax are those allowed under section 67 (after the floor or the suspension)";
    when miscellaneous_itemized_deductions_allowed(p, y, amount);
    then us.irc.income_individual::misc_itemized_deductions_claimed(p, y, amount);
}

rule W8Section68ReductionApplied(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 56(b)(1)(E): the reduction of itemized deductions applied under section 68 for the regular tax is this package's section 68 reduction";
    when itemized_deductions_reduced_amount(p, y, amount);
    then us.irc.income_individual::section_68_reduction_of_itemized_deductions(p, y, amount);
}

// JUDGMENT CALL: section 56(a)(7) says "section 87 shall not apply", so the amount added back is the whole section 87 inclusion (alcohol,
// biodiesel and sustainable aviation fuel credits), although the consumer's label names only the alcohol fuel credit. The three
// credits are summed from their own relations (not from the derived `fuel_credit_includible_87` atoms, where equal amounts of two
// credits would collapse into one atom).
rule W8Section87InclusionForAmt(p: Person, y: TaxableYear, any_credit: Money) strict {
    label en official "section 56(a)(7): the amount included in gross income under section 87 for the regular tax is the sum of the section 40(a), 40A(a) and 40B(a) credits";
    when fuel_credit_includible_87(p, y, any_credit);
    then us.irc.income_individual::section_87_alcohol_fuel_credit_included(p, y,
        sum(collect all a1: Money where alcohol_fuel_credit_40a(p, y, a1), empty: 0.00 USD)
        + sum(collect all a2: Money where biodiesel_fuels_credit_40Aa(p, y, a2), empty: 0.00 USD)
        + sum(collect all a3: Money where sustainable_aviation_fuel_credit_40Ba(p, y, a3), empty: 0.00 USD));
}

// --- section 57(a)(5)(C): bond classifications read by the alternative minimum tax preference ---------------------------------------
// One bond-issue entity (`us.irc.income_individual::BondIssue`, aliased in `s141-private-activity-bonds.law`) makes these derivations
// possible; each rule names this package's section 141/143/145 classification under the lower package's name for it.

rule W8PrivateActivityBondForAmt(b: BondIssue) strict {
    label en official "section 57(a)(5)(C)(i): a private activity bond as defined in section 141 is this package's section 141(a) private activity bond";
    when private_activity_bond(b);
    then us.irc.income_individual::is_private_activity_bond(b);
}
rule W8Qualified501c3BondForAmt(b: BondIssue) strict {
    label en official "section 57(a)(5)(C)(ii): a qualified 501(c)(3) bond as defined in section 145 is this package's section 145(a) qualified 501(c)(3) bond";
    when qualified_501c3_bond_145a(b);
    then us.irc.income_individual::is_qualified_501c3_bond(b);
}
// JUDGMENT CALL: clause (iii) lists three limbs (exempt facility bonds for qualified residential rental projects, qualified mortgage
// bonds, qualified veterans' mortgage bonds). Only the two mortgage-bond limbs have an issue-level classification here; the
// residential-rental limb (section 142(a)(7), 95 percent of net proceeds) has no issue-level relation and stays a case fact.
rule W8CertainHousingBondQualifiedMortgage(b: BondIssue) strict {
    label en official "section 57(a)(5)(C)(iii): an issue of qualified mortgage bonds (section 143(a)) is a certain housing bond";
    when qualified_mortgage_bond_143(b);
    then us.irc.income_individual::is_certain_housing_bond(b);
}
rule W8CertainHousingBondQualifiedVeterans(b: BondIssue) strict {
    label en official "section 57(a)(5)(C)(iii): a qualified veterans' mortgage bond issue (section 143(b)) is a certain housing bond";
    when qualified_veterans_mortgage_issue_143b(b);
    then us.irc.income_individual::is_certain_housing_bond(b);
}
