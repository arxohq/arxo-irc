// Section 86 — Social security and tier 1 railroad retirement benefits.
// Stage 2b (IRC-06).
//
// JUDGMENT CALL: the base/adjusted-base amounts ($25,000/$32,000/$34,000/
// $44,000) are TRUE fixed statutory dollar figures with no inflation
// adjustment and no amendment history in `SOURCE-MANIFEST.json`'s
// `amendments` list (unlike this package's stage-1 TCJA-affected figures);
// they are written as inline literals rather than `.lawparam.json`
// sidecars, since there is no time-window or edition to encode.
// JUDGMENT CALL: "modified adjusted gross income" (b)(2)'s "without regard
// to this section and sections 85(c), 135, 137, 221, 911, 931, and 933" is
// approximated as this package's own `adjusted_gross_income` plus
// tax-exempt interest received — the listed exclusions are provisions this
// package does not itself subtract out of AGI to begin with (recorded as
// TECH_GAP/INTERPRETATION: if a future pass wires any of sections 85(c)/
// 135/137/221/911/931/933 into `adjusted_gross_income`, this module's MAGI
// computation would need its own explicit add-back rule).

use self::{
    IRC_S86_A,
    IRC_S86_B,
    IRC_S86_C,
    Individual,
    TaxableYear,
    adjusted_gross_income,
};

pub relation social_security_benefits_received(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "a social security benefit (title II monthly benefit or tier 1 railroad retirement benefit) received during the taxable year, net of same-year repayments (section 86(d))";
}
relation tax_exempt_interest_received(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "interest received or accrued during the taxable year which is exempt from tax (section 86(b)(2)(B))";
}
pub relation modified_agi_86(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "modified adjusted gross income for section 86 purposes (section 86(b)(2))";
}
@source(IRC_S86_B, quote = "the term \"modified adjusted gross income\" means adjusted gross income")
rule ModifiedAgiComputation(p: Individual, y: TaxableYear, agi: Money, interest: Money) strict {
    label en official "MAGI is AGI increased by tax-exempt interest received";
    when adjusted_gross_income(p, y, agi);
    when tax_exempt_interest_received(p, y, interest);
    then modified_agi_86(p, y, round(agi + interest, 2, "HALF_UP"));
}
// A taxpayer with no tax-exempt interest for the year is represented by
// asserting `tax_exempt_interest_received(p, y, 0.00 USD)` directly (this
// package's general convention for "none" as an explicit zero-valued fact,
// rather than relying on absence-of-record over an amount argument, which
// `not_known` cannot safely test without a bound value per §190) — no
// separate rule is needed beyond `ModifiedAgiComputation` above.

// --- §86(c): base amount / adjusted base amount -------------------------------

relation lives_apart_from_spouse_all_year_86c1c(p: Individual, y: TaxableYear) kind empirical {
    label en official "does not live apart from his spouse at all times during the taxable year is FALSE for this fact — i.e., asserted when the taxpayer DOES live apart from the spouse for the entire year (section 86(c)(1)(C)(ii), negated form used directly, consistent with this package's negated-condition convention elsewhere)";
}

pub relation base_amount_86(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the base amount (section 86(c)(1))";
}
@source(IRC_S86_C, quote = "$32,000 in the case of a joint return, and")
rule BaseAmountJoint(p: Individual, y: TaxableYear) strict {
    label en official "the base amount for a joint return is $32,000";
    when us.irc.income_individual::filing_status(p, y, us.irc.income_individual::Joint);
    then base_amount_86(p, y, 32000.00 USD);
}
@source(IRC_S86_C, quote = "zero in the case of a taxpayer who—")
rule BaseAmountMarriedSeparateNotLivingApart(p: Individual, y: TaxableYear) strict {
    label en official "the base amount is zero for a married-filing-separate taxpayer who does not live apart from the spouse all year";
    when us.irc.income_individual::filing_status(p, y, us.irc.income_individual::MarriedSeparate);
    when us.irc.definitions::married_as_of_close_of_taxable_year(p, y);
    when not_known(lives_apart_from_spouse_all_year_86c1c(p, y));
    then base_amount_86(p, y, 0.00 USD);
}
@source(IRC_S86_C, quote = "except as otherwise provided in this paragraph, $25,000,")
rule BaseAmountUnmarried(p: Individual, y: TaxableYear) strict {
    label en official "the base amount for an unmarried taxpayer is $25,000";
    when us.irc.income_individual::filing_status(p, y, us.irc.income_individual::Unmarried);
    then base_amount_86(p, y, 25000.00 USD);
}
@source(IRC_S86_C, quote = "except as otherwise provided in this paragraph, $25,000,")
rule BaseAmountHeadOfHousehold(p: Individual, y: TaxableYear) strict {
    label en official "the base amount for a head-of-household taxpayer is $25,000";
    when us.irc.income_individual::filing_status(p, y, us.irc.income_individual::HeadOfHousehold);
    then base_amount_86(p, y, 25000.00 USD);
}
@source(IRC_S86_C, quote = "except as otherwise provided in this paragraph, $25,000,")
rule BaseAmountMarriedSeparateLivingApart(p: Individual, y: TaxableYear) strict {
    label en official "the base amount for a married-filing-separate taxpayer who lives apart from the spouse all year is $25,000 (falls out of the (1)(C) zero rule)";
    when us.irc.income_individual::filing_status(p, y, us.irc.income_individual::MarriedSeparate);
    when lives_apart_from_spouse_all_year_86c1c(p, y);
    then base_amount_86(p, y, 25000.00 USD);
}

pub relation adjusted_base_amount_86(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the adjusted base amount (section 86(c)(2))";
}
@source(IRC_S86_C, quote = "$44,000 in the case of a joint return, and")
rule AdjustedBaseAmountJoint(p: Individual, y: TaxableYear) strict {
    label en official "the adjusted base amount for a joint return is $44,000";
    when us.irc.income_individual::filing_status(p, y, us.irc.income_individual::Joint);
    then adjusted_base_amount_86(p, y, 44000.00 USD);
}
@source(IRC_S86_C, quote = "zero in the case of a taxpayer described in paragraph (1)(C)")
rule AdjustedBaseAmountMarriedSeparateNotLivingApart(p: Individual, y: TaxableYear) strict {
    label en official "the adjusted base amount is zero for the same (1)(C) married-filing-separate-not-living-apart taxpayer";
    when us.irc.income_individual::filing_status(p, y, us.irc.income_individual::MarriedSeparate);
    when us.irc.definitions::married_as_of_close_of_taxable_year(p, y);
    when not_known(lives_apart_from_spouse_all_year_86c1c(p, y));
    then adjusted_base_amount_86(p, y, 0.00 USD);
}
@source(IRC_S86_C, quote = "except as otherwise provided in this paragraph, $34,000,")
rule AdjustedBaseAmountUnmarried(p: Individual, y: TaxableYear) strict {
    label en official "the adjusted base amount for an unmarried taxpayer is $34,000";
    when us.irc.income_individual::filing_status(p, y, us.irc.income_individual::Unmarried);
    then adjusted_base_amount_86(p, y, 34000.00 USD);
}
@source(IRC_S86_C, quote = "except as otherwise provided in this paragraph, $34,000,")
rule AdjustedBaseAmountHeadOfHousehold(p: Individual, y: TaxableYear) strict {
    label en official "the adjusted base amount for a head-of-household taxpayer is $34,000";
    when us.irc.income_individual::filing_status(p, y, us.irc.income_individual::HeadOfHousehold);
    then adjusted_base_amount_86(p, y, 34000.00 USD);
}
@source(IRC_S86_C, quote = "except as otherwise provided in this paragraph, $34,000,")
rule AdjustedBaseAmountMarriedSeparateLivingApart(p: Individual, y: TaxableYear) strict {
    label en official "the adjusted base amount for a married-filing-separate taxpayer who lives apart from the spouse all year is $34,000";
    when us.irc.income_individual::filing_status(p, y, us.irc.income_individual::MarriedSeparate);
    when lives_apart_from_spouse_all_year_86c1c(p, y);
    then adjusted_base_amount_86(p, y, 34000.00 USD);
}

// --- §86(b)(1): taxpayers to whom (a) applies ---------------------------------

pub relation combined_income_86b1a(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "modified AGI plus one-half of social security benefits received (section 86(b)(1)(A))";
}
@source(IRC_S86_B, quote = "the modified adjusted gross income of the taxpayer for the taxable year, plus")
rule CombinedIncomeComputation(p: Individual, y: TaxableYear, magi: Money, benefits: Money) strict {
    label en official "combined income = MAGI + one-half of social security benefits received";
    when modified_agi_86(p, y, magi);
    when social_security_benefits_received(p, y, benefits);
    then combined_income_86b1a(p, y, round(magi + 0.5 * benefits, 2, "HALF_UP"));
}

pub relation taxpayer_within_section_86b(p: Individual, y: TaxableYear) kind institutional {
    label en official "the taxpayer is described in section 86(b): combined income exceeds the base amount";
}
@source(IRC_S86_B, quote = "exceeds")
rule TaxpayerWithinSection86b(p: Individual, y: TaxableYear, combined: Money, base: Money) strict {
    label en official "combined income exceeding the base amount brings the taxpayer within section 86(b)";
    when combined_income_86b1a(p, y, combined);
    when base_amount_86(p, y, base);
    when combined > base;
    then taxpayer_within_section_86b(p, y);
}

// --- §86(a): amount included in gross income ----------------------------------

pub relation social_security_benefits_included_in_gross_income(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "social security benefits included in gross income (section 86(a))";
}

@source(IRC_S86_A, quote = "the amount included in gross income under this section shall be equal to the lesser of—")
rule SocialSecurityBenefitsIncluded50PercentTier(p: Individual, y: TaxableYear, benefits: Money, combined: Money, base: Money, adjusted_base: Money) strict {
    label en official "section 86(a)(1): where combined income does not exceed the adjusted base amount, the included amount is the lesser of one-half of benefits or one-half of the excess of combined income over the base amount";
    when taxpayer_within_section_86b(p, y);
    when social_security_benefits_received(p, y, benefits);
    when combined_income_86b1a(p, y, combined);
    when base_amount_86(p, y, base);
    when adjusted_base_amount_86(p, y, adjusted_base);
    when combined <= adjusted_base;
    then social_security_benefits_included_in_gross_income(p, y, min(0.5 * benefits, round(0.5 * (combined - base), 2, "HALF_UP")));
}

@source(IRC_S86_A, quote = "In the case of a taxpayer with respect to whom the amount determined under subsection (b)(1)(A) exceeds the adjusted base amount, the amount included in gross income under this section shall be equal to the lesser of—")
rule SocialSecurityBenefitsIncluded85PercentTier(p: Individual, y: TaxableYear, benefits: Money, combined: Money, base: Money, adjusted_base: Money) strict {
    label en official "section 86(a)(2): where combined income exceeds the adjusted base amount, the included amount is the lesser of [85% of the excess over the adjusted base amount, plus the lesser of the (a)(1) tier-1 amount or half the base/adjusted-base gap] or 85% of benefits received";
    when taxpayer_within_section_86b(p, y);
    when social_security_benefits_received(p, y, benefits);
    when combined_income_86b1a(p, y, combined);
    when base_amount_86(p, y, base);
    when adjusted_base_amount_86(p, y, adjusted_base);
    when combined > adjusted_base;
    then social_security_benefits_included_in_gross_income(p, y,
        min(
            round(0.85 * (combined - adjusted_base), 2, "HALF_UP")
                + min(min(0.5 * benefits, round(0.5 * (combined - base), 2, "HALF_UP")), round(0.5 * (adjusted_base - base), 2, "HALF_UP")),
            round(0.85 * benefits, 2, "HALF_UP")
        ));
}

// --- §86(d): social security benefit — definitions and adjustments -----------
//
// (d)(1) title II/tier 1 railroad retirement benefit definition, (d)(2)
// same-year-repayment netting (folded into `social_security_benefits_
// received`'s own scope: the case asserts the NET, already-repayment-
// reduced figure, per this package's glossary/fact-folding convention),
// (d)(3) workmen's-compensation substitution, and (d)(4) tier-1
// railroad-retirement-benefit sub-definition are each NON_NORMATIVE/
// EXECUTABLE-via-folded-fact; no separate rule head. (d)(2)(B)'s denial-of-
// double-deduction rule is a section 165 deduction-computation cross
// reference this package does not own — EXTERNAL_DEPENDENCY.
// (d)(5) early-delivery-of-benefit-checks timing rule — EXECUTABLE in
// principle (deems the succeeding calendar month) but not modelled this
// pass: TECH_GAP, a narrow administrative-timing rule affecting which
// `TaxableYear` a case should assert `social_security_benefits_received`
// against, not the inclusion computation itself.

// --- §86(e): lump-sum election ------------------------------------------------
//
// The (e)(1) limitation-on-lump-sum-inclusion election is a genuine `power`
// (holder: the taxpayer; exercise: the election; effect: recomputing prior
// years' hypothetical inclusion increases) whose EFFECT requires re-running
// this section's OWN formula against past taxable years' MAGI/benefits —
// a multi-year recomputation this package does not attempt this pass.
// TECH_GAP: recorded, not modelled (same class as a running/periodic
// ledger construct, though not identically LDC-E4102-shaped since no
// self-recursive SINGLE relation is involved — the difficulty is re-scoping
// this section's computation across arbitrary prior `TaxableYear`s from a
// single rule).

// --- §86(f): treatment as pension or annuity for certain purposes -----------
// A scope-limiting cross-reference into sections 22(c)(3)(A)/32(c)(2)/
// 219(f)(1)/911(b)(1), none of which this package owns — NON_NORMATIVE
// pointer, no independent content this package's own rules add.
