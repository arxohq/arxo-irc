// Stage 2f (TECH_GAP reduction) — private activity bonds, first part:
// §141(b)(3)-(9), (c)(2), (d)(2)-(7); §142(b)-(d) (ownership, offices, storage and
// training facilities, disallowed property, qualified residential rental projects).
// STATUS: implemented_unverified (static check only; scenarios in
// tests/bonds-a-141-142.lawtest are NOT executed).
//
// TECHNIQUE: percentages of proceeds compare exactly against case-asserted
// proceeds (this package does not do bond-proceeds accounting, see the header of
// s141-private-activity-bonds.law). Where an earlier rule reads a case fact that a
// subsection here decomposes, the earlier rule is guarded with a not_known on the
// decomposed status (§141(b)(9), (c)(1)-(2), (d)(1)) or extended with the
// per-facility condition (§142(a)); no `pub` interface changes.

// =====================================================================
// §141(b)(3): the related-use 5 percent rule
// =====================================================================

use self::{
    BondIssue,
    ExemptFacilityUseKind,
    IRC_S141_B,
    IRC_S141_C,
    IRC_S141_D,
    IRC_S142_B,
    IRC_S142_C,
    issue_total_proceeds,
    loan_proceeds_to_non_governmental_persons,
    nongovernmental_output_property_test_met_141d1,
    private_activity_bond,
    private_business_use_test_met_141b1,
    private_loan_financing_test_met_141c,
    private_security_or_payment_test_met_141b2,
    proceeds_for_private_business_use,
    proceeds_secured_by_or_derived_from_private_business_use,
};

pub entity ProceedsUse141 {
    label en unofficial "one use of the proceeds of a bond issue (a private business use or the government use to which it relates), case-asserted";
}
relation unrelated_private_business_use_proceeds_141b3Aii(issue: BondIssue, amount: Money) kind empirical {
    label en official "the proceeds of the issue to be used for any private business use which is not related to any government use of the proceeds (section 141(b)(3)(A)(ii)(I))";
}
relation related_private_use_item_141b3B(issue: BondIssue, item: ProceedsUse141, private_use: Money, government_use: Money) kind empirical {
    label en official "a private business use of proceeds related to a government use, with the proceeds for the private use and the proceeds for the government use to which it relates (section 141(b)(3)(B)(i)-(ii))";
}
pub relation related_use_excess_141b3B(issue: BondIssue, item: ProceedsUse141, excess: Money) kind institutional {
    label en official "the excess of the proceeds for a private business use over the proceeds for the government use to which it relates";
}
@source(IRC_S141_B, relation = formalizes, coverage = exact, quote = "For purposes of subparagraph (A), the disproportionate related business use proceeds of an issue is an amount equal to the aggregate of the excesses (determined under")
rule RelatedUseExcess(issue: BondIssue, item: ProceedsUse141, priv: Money, gov: Money) strict {
    label en official "section 141(b)(3)(B): the excess for one related use, when the private use is larger; the aggregate of the excesses over all related uses is the case fact below (a total over a derived relation is not supported: TECH-GAPS G4501)";
    when related_private_use_item_141b3B(issue, item, priv, gov);
    when priv > gov;
    then related_use_excess_141b3B(issue, item, round(priv - gov, 2, "HALF_UP"));
}
relation disproportionate_related_business_use_proceeds_total_141b3B(issue: BondIssue, amount: Money) kind empirical {
    label en official "the disproportionate related business use proceeds of the issue: the aggregate of the excesses of related_use_excess_141b3B over all related private business uses (asserted by the case as the sum of the per-item excesses)";
}
relation payments_for_unrelated_or_disproportionate_uses_141b3Aiii(issue: BondIssue, amount: Money) kind empirical {
    label en official "the proceeds whose payments, property and borrowed money are described in paragraph (2) with respect to a use of proceeds described in subclause (I) or (II) (section 141(b)(3)(A)(ii)(III))";
}
pub relation related_use_business_use_test_met_141b3(issue: BondIssue) kind institutional {
    label en official "the private business use test of (b)(1) is met when applied with 5 percent for 10 percent and taking into account only the unrelated private use proceeds and the disproportionate related business use proceeds";
}
@source(IRC_S141_B, relation = formalizes, coverage = exact, quote = "(i) by substituting \"5 percent\" for \"10 percent\" each place it appears, and")
rule RelatedUseBusinessUseTestMet(issue: BondIssue, unrelated: Money, disproportionate: Money, total: Money) strict {
    label en official "section 141(b)(3)(A)(i), (ii)(I)-(II): (unrelated + disproportionate) / total > 5 percent";
    when unrelated_private_business_use_proceeds_141b3Aii(issue, unrelated);
    when disproportionate_related_business_use_proceeds_total_141b3B(issue, disproportionate);
    when issue_total_proceeds(issue, total);
    when total > 0.00 USD;
    when unrelated + disproportionate > round(total * 0.05, 2, "HALF_UP");
    then related_use_business_use_test_met_141b3(issue);
}
pub relation related_use_security_test_met_141b3(issue: BondIssue) kind institutional {
    label en official "the private security or payment test of (b)(2) is met when applied with 5 percent for 10 percent and taking into account only the payments, property and borrowed money with respect to the (I) and (II) uses";
}
@source(IRC_S141_B, relation = formalizes, coverage = exact, quote = "(III) payments, property, and borrowed money with respect to any use of proceeds described in subclause (I) or (II).")
rule RelatedUseSecurityTestMet(issue: BondIssue, payments: Money, total: Money) strict {
    label en official "section 141(b)(3)(A)(i), (ii)(III)";
    when payments_for_unrelated_or_disproportionate_uses_141b3Aiii(issue, payments);
    when issue_total_proceeds(issue, total);
    when total > 0.00 USD;
    when payments > round(total * 0.05, 2, "HALF_UP");
    then related_use_security_test_met_141b3(issue);
}
@source(IRC_S141_B, relation = formalizes, coverage = exact, quote = "An issue shall be treated as meeting the tests of paragraphs (1) and (2) if such tests would be met if such paragraphs were applied—")
rule BusinessUseTestMetByRelatedUseRule(issue: BondIssue) strict {
    label en official "section 141(b)(3)(A): the issue is treated as meeting the test of paragraph (1)";
    when related_use_business_use_test_met_141b3(issue);
    then private_business_use_test_met_141b1(issue);
}
@source(IRC_S141_B, relation = formalizes, coverage = exact, quote = "An issue shall be treated as meeting the tests of paragraphs (1) and (2) if such tests would be met if such paragraphs were applied—")
rule SecurityTestMetByRelatedUseRule(issue: BondIssue) strict {
    label en official "section 141(b)(3)(A): the issue is treated as meeting the test of paragraph (2)";
    when related_use_security_test_met_141b3(issue);
    then private_security_or_payment_test_met_141b2(issue);
}

// =====================================================================
// §141(b)(4)-(5): output facilities, the $15,000,000 rule
// =====================================================================

relation output_facility_proceeds_141b4(issue: BondIssue, amount: Money) kind empirical {
    label en official "the proceeds of the issue to be used with respect to any output facility (other than a facility for the furnishing of water)";
}
relation nonqualified_amount_prior_issue_141b4B(issue: BondIssue, prior: BondIssue, amount: Money, outstanding_at_later_issue: Boolean, redeemed_from_later_proceeds_other_than_advance: Boolean) kind empirical {
    label en official "the nonqualified amount of a prior tax-exempt issue 5 percent or more of the proceeds of which are or will be used with respect to the same facility (or any facility of the same project), with whether its bond is outstanding at the time of the later issue and whether it is to be redeemed (other than in an advance refunding) from the net proceeds of the later issue";
}
pub relation nonqualified_amount_141b8(issue: BondIssue, amount: Money) kind institutional {
    label en official "the nonqualified amount: the lesser of the proceeds for any private business use and the proceeds with respect to which there are payments (or property or borrowed money) described in paragraph (2)";
}
@source(IRC_S141_B, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, the term \"nonqualified amount\" means, with respect to an issue, the lesser of—")
rule NonqualifiedAmountDefined(issue: BondIssue, private_use: Money, secured: Money) strict {
    label en official "section 141(b)(8)(A)-(B)";
    when proceeds_for_private_business_use(issue, private_use);
    when proceeds_secured_by_or_derived_from_private_business_use(issue, secured);
    then nonqualified_amount_141b8(issue, min(private_use, secured));
}
pub relation output_facility_15m_test_met_141b4(issue: BondIssue) kind institutional {
    label en official "an issue 5 percent or more of the proceeds of which are to be used with respect to an output facility is treated as meeting the tests of (1) and (2) if the nonqualified amount exceeds the excess of $15,000,000 over the nonqualified amounts of the prior issues that count";
}
@source(IRC_S141_B, relation = formalizes, coverage = exact, quote = "An issue 5 percent or more of the proceeds of which are to be used with respect to any output facility (other than a facility for the furnishing of water) shall be")
rule OutputFacility15mTestMet(issue: BondIssue, output: Money, total: Money, nonqualified: Money, prior0: BondIssue, a0: Money, o0: Boolean, r0: Boolean) strict {
    label en official "section 141(b)(4): output share >= 5 percent; nonqualified amount > max(0, $15,000,000 - prior nonqualified amounts); a prior bond not outstanding, or to be redeemed other than in an advance refunding from the later issue's net proceeds, is not counted (last sentence)";
    when output_facility_proceeds_141b4(issue, output);
    when issue_total_proceeds(issue, total);
    when total > 0.00 USD;
    when output >= round(total * 0.05, 2, "HALF_UP");
    when nonqualified_amount_141b8(issue, nonqualified);
    when nonqualified_amount_prior_issue_141b4B(issue, prior0, a0, o0, r0);
    when nonqualified > max(0.00 USD, round(15000000.00 USD - sum(collect all a: Money, pi: BondIssue, o: Boolean, r: Boolean where nonqualified_amount_prior_issue_141b4B(issue, pi, a, o, r) and o == true and r == false, empty: 0.00 USD), 2, "HALF_UP"));
    then output_facility_15m_test_met_141b4(issue);
}
@source(IRC_S141_B, relation = formalizes, coverage = exact, quote = "An issue 5 percent or more of the proceeds of which are to be used with respect to any output facility (other than a facility for the furnishing of water) shall be")
rule OutputFacility15mTestMetNoPriorIssues(issue: BondIssue, output: Money, total: Money, nonqualified: Money) strict {
    label en official "section 141(b)(4) when no earlier issue exists for the facility: the nonqualified amount exceeds $15,000,000";
    when output_facility_proceeds_141b4(issue, output);
    when issue_total_proceeds(issue, total);
    when total > 0.00 USD;
    when output >= round(total * 0.05, 2, "HALF_UP");
    when nonqualified_amount_141b8(issue, nonqualified);
    when not_known(has_prior_issue_for_facility_141b4(issue));
    when nonqualified > 15000000.00 USD;
    then output_facility_15m_test_met_141b4(issue);
}
relation has_prior_issue_for_facility_141b4(issue: BondIssue) kind institutional {
    label en official "helper: some earlier tax-exempt issue is recorded for the facility";
}
rule HasPriorIssueForFacility(issue: BondIssue, prior: BondIssue, a: Money, o: Boolean, r: Boolean) strict {
    label en official "helper for the not_known test";
    when nonqualified_amount_prior_issue_141b4B(issue, prior, a, o, r);
    then has_prior_issue_for_facility_141b4(issue);
}
@source(IRC_S141_B, relation = formalizes, coverage = exact, quote = "An issue 5 percent or more of the proceeds of which are to be used with respect to any output facility (other than a facility for the furnishing of water) shall be")
rule BusinessUseTestMetByOutputRule(issue: BondIssue) strict {
    label en official "section 141(b)(4): treated as meeting the test of paragraph (1)";
    when output_facility_15m_test_met_141b4(issue);
    then private_business_use_test_met_141b1(issue);
}
@source(IRC_S141_B, relation = formalizes, coverage = exact, quote = "An issue 5 percent or more of the proceeds of which are to be used with respect to any output facility (other than a facility for the furnishing of water) shall be")
rule SecurityTestMetByOutputRule(issue: BondIssue) strict {
    label en official "section 141(b)(4): treated as meeting the test of paragraph (2)";
    when output_facility_15m_test_met_141b4(issue);
    then private_security_or_payment_test_met_141b2(issue);
}
relation nonqualified_amount_threshold_for_private_activity_141b5B(issue: BondIssue, threshold: Money) kind empirical {
    label en official "the nonqualified amount which would cause a bond of the issue to be treated as a private activity bond without regard to paragraph (5)";
}
relation volume_cap_allocated_to_issue_141b5(issue: BondIssue, amount: Money) kind empirical {
    label en official "the amount of the issuer's volume cap under section 146 allocated to the issue";
}
pub relation output_issue_private_activity_bond_without_cap_allocation_141b5(issue: BondIssue) kind institutional {
    label en official "the nonqualified amount exceeds $15,000,000 but not the amount that would cause private activity bond treatment; the bond is nonetheless a private activity bond unless the issuer allocates volume cap equal to the excess over $15,000,000";
}
@source(IRC_S141_B, relation = formalizes, coverage = exact, quote = "such bond shall nonetheless be treated as a private activity bond unless the issuer allocates a portion of its volume cap under section 146 to such issue in an amount")
rule OutputIssueCapNotAllocated(issue: BondIssue, nonqualified: Money, threshold: Money, allocated: Money) strict {
    label en official "section 141(b)(5)(A)-(B): the allocation is less than the excess over $15,000,000";
    when nonqualified_amount_141b8(issue, nonqualified);
    when nonqualified_amount_threshold_for_private_activity_141b5B(issue, threshold);
    when volume_cap_allocated_to_issue_141b5(issue, allocated);
    when nonqualified > 15000000.00 USD;
    when nonqualified <= threshold;
    when allocated < round(nonqualified - 15000000.00 USD, 2, "HALF_UP");
    then output_issue_private_activity_bond_without_cap_allocation_141b5(issue);
}
@source(IRC_S141_B, relation = formalizes, coverage = exact, quote = "such bond shall nonetheless be treated as a private activity bond unless the issuer allocates a portion of its volume cap under section 146 to such issue in an amount")
rule OutputIssueNoAllocationAtAll(issue: BondIssue, nonqualified: Money, threshold: Money) strict {
    label en official "section 141(b)(5): no volume cap is allocated at all";
    when nonqualified_amount_141b8(issue, nonqualified);
    when nonqualified_amount_threshold_for_private_activity_141b5B(issue, threshold);
    when nonqualified > 15000000.00 USD;
    when nonqualified <= threshold;
    when not_known(has_volume_cap_allocation_141b5(issue));
    then output_issue_private_activity_bond_without_cap_allocation_141b5(issue);
}
relation has_volume_cap_allocation_141b5(issue: BondIssue) kind institutional {
    label en official "helper: a volume cap allocation is recorded for the issue";
}
rule HasVolumeCapAllocation(issue: BondIssue, amount: Money) strict {
    label en official "helper for the not_known test";
    when volume_cap_allocated_to_issue_141b5(issue, amount);
    then has_volume_cap_allocation_141b5(issue);
}
@source(IRC_S141_B, relation = formalizes, coverage = exact, quote = "such bond shall nonetheless be treated as a private activity bond unless the issuer allocates a portion of its volume cap under section 146 to such issue in an amount")
rule PrivateActivityBondByOutputIssueWithoutCap(issue: BondIssue) strict {
    label en official "section 141(b)(5): the bond is treated as a private activity bond";
    when output_issue_private_activity_bond_without_cap_allocation_141b5(issue);
    then private_activity_bond(issue);
}

// =====================================================================
// §141(b)(6)-(7): private business use and government use
// =====================================================================

relation proceeds_use_by_user_141b6(use: ProceedsUse141, issue: BondIssue, amount: Money) kind empirical {
    label en official "a use of the proceeds of the issue, directly or indirectly, with its amount";
}
relation user_is_governmental_unit_141b6(use: ProceedsUse141) kind empirical {
    label en official "the use is in a trade or business carried on by a governmental unit";
}
relation use_as_member_of_general_public_141b6(use: ProceedsUse141) kind empirical {
    label en official "the use is as a member of the general public";
}
relation user_is_natural_person_141b6B(use: ProceedsUse141) kind empirical {
    label en official "the user is a natural person";
}
relation activity_is_trade_or_business_141b6(use: ProceedsUse141) kind empirical {
    label en official "the activity is a trade or business";
}
relation use_is_sale_of_co2_from_governmental_capture_facility_141b6C(use: ProceedsUse141) kind empirical {
    label en official "the use is the sale of carbon dioxide produced by a qualified carbon dioxide capture facility (section 142(o)) owned by a governmental unit";
}
pub relation private_business_use_141b6(use: ProceedsUse141) kind institutional {
    label en official "a private business use: use, directly or indirectly, in a trade or business carried on by any person other than a governmental unit; use as a member of the general public is not taken into account; any activity of a person other than a natural person is a trade or business; sale of governmental capture-facility carbon dioxide is not private business use";
}
@source(IRC_S141_B, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, the term \"private business use\" means use (directly or indirectly) in a trade or business carried on by any person other than a")
rule PrivateBusinessUseByTradeOrBusiness(use: ProceedsUse141, issue: BondIssue, amount: Money) strict {
    label en official "section 141(b)(6)(A): a trade or business carried on by a person other than a governmental unit";
    when proceeds_use_by_user_141b6(use, issue, amount);
    when activity_is_trade_or_business_141b6(use);
    when not_known(user_is_governmental_unit_141b6(use));
    when not_known(use_as_member_of_general_public_141b6(use));
    when not_known(use_is_sale_of_co2_from_governmental_capture_facility_141b6C(use));
    then private_business_use_141b6(use);
}
@source(IRC_S141_B, relation = formalizes, coverage = exact, quote = "For purposes of the 1st sentence of subparagraph (A), any activity carried on by a person other than a natural person shall be treated as a trade or business.")
rule PrivateBusinessUseByNonNaturalPerson(use: ProceedsUse141, issue: BondIssue, amount: Money) strict {
    label en official "section 141(b)(6)(B): any activity carried on by a person other than a natural person is a trade or business";
    when proceeds_use_by_user_141b6(use, issue, amount);
    when not_known(user_is_natural_person_141b6B(use));
    when not_known(user_is_governmental_unit_141b6(use));
    when not_known(use_as_member_of_general_public_141b6(use));
    when not_known(use_is_sale_of_co2_from_governmental_capture_facility_141b6C(use));
    then private_business_use_141b6(use);
}
pub relation government_use_141b7(use: ProceedsUse141) kind institutional {
    label en official "a government use: any use other than a private business use";
}
@source(IRC_S141_B, relation = formalizes, coverage = exact, quote = "The term \"government use\" means any use other than a private business use.")
rule GovernmentUseDefined(use: ProceedsUse141, issue: BondIssue, amount: Money) strict {
    label en official "section 141(b)(7)";
    when proceeds_use_by_user_141b6(use, issue, amount);
    when not_known(private_business_use_141b6(use));
    then government_use_141b7(use);
}

// =====================================================================
// §141(b)(9): the elected 501(c)(3) portion
// =====================================================================

relation portion_elected_as_qualified_501c3_bond_141b9(issue: BondIssue, portion_of_proceeds: Money) kind empirical {
    label en official "the portion of the proceeds of the issue which (if issued as a separate issue) would be a qualified 501(c)(3) bond, treated as such by the issuer's election";
}
relation elected_501c3_portion_used_for_private_business_use_141b9(issue: BondIssue, amount: Money) kind empirical {
    label en official "the part of the private business use proceeds that lies inside the elected portion";
}
relation has_141b9_election_141b9(issue: BondIssue) kind institutional {
    label en official "helper: the issuer elected to treat a portion as a qualified 501(c)(3) bond";
}
rule Has141b9Election(issue: BondIssue, p: Money) strict {
    label en official "helper for the not_known guards on the earlier section 141(b) and (c) rules";
    when portion_elected_as_qualified_501c3_bond_141b9(issue, p);
    then has_141b9_election_141b9(issue);
}
@source(IRC_S141_B, relation = formalizes, coverage = exact, quote = "There shall not be taken into account under this subsection or subsection (c) the portion of the proceeds of an issue which (if issued as a separate issue) would be")
rule PrivateBusinessUseTestMetAfter141b9Election(issue: BondIssue, private_use: Money, elected_use: Money, total: Money, portion: Money) strict {
    label en official "section 141(b)(9): the elected portion is not taken into account under (b): its proceeds leave both numerator and denominator";
    when portion_elected_as_qualified_501c3_bond_141b9(issue, portion);
    when elected_501c3_portion_used_for_private_business_use_141b9(issue, elected_use);
    when proceeds_for_private_business_use(issue, private_use);
    when issue_total_proceeds(issue, total);
    when total > portion;
    when (private_use - elected_use) / (total - portion) > 0.10;
    then private_business_use_test_met_141b1(issue);
}

relation elected_501c3_portion_secured_amount_141b9(issue: BondIssue, amount: Money) kind empirical {
    label en official "the part of the secured or derived proceeds that lies inside the elected portion";
}
@source(IRC_S141_B, relation = formalizes, coverage = exact, quote = "There shall not be taken into account under this subsection or subsection (c) the portion of the proceeds of an issue which (if issued as a separate issue) would be")
rule PrivateSecurityTestMetAfter141b9Election(issue: BondIssue, secured: Money, elected_secured: Money, total: Money, portion: Money) strict {
    label en official "section 141(b)(9) applied to the test of (b)(2)";
    when portion_elected_as_qualified_501c3_bond_141b9(issue, portion);
    when elected_501c3_portion_secured_amount_141b9(issue, elected_secured);
    when proceeds_secured_by_or_derived_from_private_business_use(issue, secured);
    when issue_total_proceeds(issue, total);
    when total > portion;
    when (secured - elected_secured) / (total - portion) > 0.10;
    then private_security_or_payment_test_met_141b2(issue);
}
relation elected_501c3_portion_loans_141b9(issue: BondIssue, amount: Money) kind empirical {
    label en official "the loan proceeds that lie inside the elected portion";
}
@source(IRC_S141_B, relation = formalizes, coverage = exact, quote = "There shall not be taken into account under this subsection or subsection (c) the portion of the proceeds of an issue which (if issued as a separate issue) would be")
rule PrivateLoanFinancingTestMetAfter141b9Election(issue: BondIssue, loans: Money, elected_loans: Money, total: Money, portion: Money) strict {
    label en official "section 141(b)(9) applied to subsection (c): the lesser of 5 percent of the remaining proceeds and $5,000,000";
    when portion_elected_as_qualified_501c3_bond_141b9(issue, portion);
    when elected_501c3_portion_loans_141b9(issue, elected_loans);
    when loan_proceeds_to_non_governmental_persons(issue, loans);
    when issue_total_proceeds(issue, total);
    when total > portion;
    when loans - elected_loans > min(round((total - portion) * 0.05, 2, "HALF_UP"), 5000000.00 USD);
    then private_loan_financing_test_met_141c(issue);
}

// =====================================================================
// §141(c)(2): loans not counted for the private loan financing test
// =====================================================================

pub enum LoanKind141c2 { GovernmentalTaxOrAssessmentLoan; NonpurposeInvestmentLoan; QualifiedNaturalGasSupplyContractLoan; OtherLoanToNonGovernmentalPerson; }
relation loan_of_issue_141c(issue: BondIssue, loan: us.irc.core::Asset, amount: Money, kind: LoanKind141c2) kind empirical {
    label en official "a loan made or financed with proceeds of the issue to a person other than a governmental unit, classified as one of the loans described in paragraph (2) or as another loan";
}
relation loans_itemized_141c(issue: BondIssue) kind institutional {
    label en official "helper: the loans of the issue are itemized";
}
rule LoansItemized(issue: BondIssue, loan: us.irc.core::Asset, a: Money, k: LoanKind141c2) strict {
    label en official "helper for the not_known guard on the earlier PrivateLoanFinancingTestMet";
    when loan_of_issue_141c(issue, loan, a, k);
    then loans_itemized_141c(issue);
}
pub relation loan_proceeds_counted_141c(issue: BondIssue, amount: Money) kind institutional {
    label en official "the loan proceeds counted for the private loan financing test: loans other than the paragraph (2) loans (a tax or assessment financing loan, a nonpurpose investment, a qualified natural gas supply contract)";
}
@source(IRC_S141_C, relation = formalizes, coverage = exact, quote = "For purposes of paragraph (1), a loan is described in this paragraph if such loan—")
rule LoanProceedsCounted(issue: BondIssue, loan0: us.irc.core::Asset, a0: Money) strict {
    label en official "section 141(c)(2)(A)-(C): only the other loans are counted";
    when loan_of_issue_141c(issue, loan0, a0, OtherLoanToNonGovernmentalPerson);
    then loan_proceeds_counted_141c(issue, sum(collect all a: Money, l: us.irc.core::Asset where loan_of_issue_141c(issue, l, a, OtherLoanToNonGovernmentalPerson), empty: 0.00 USD));
}
@source(IRC_S141_C, relation = formalizes, coverage = partial, quote = "to make or finance loans (other than loans described in paragraph (2))")
rule PrivateLoanFinancingTestMetOnItemizedLoans(issue: BondIssue, loans: Money, total: Money) strict {
    label en official "section 141(c)(1) over the itemized loans: exceed the lesser of 5 percent of the proceeds and $5,000,000";
    when loan_proceeds_counted_141c(issue, loans);
    when issue_total_proceeds(issue, total);
    when loans > min(round(total * 0.05, 2, "HALF_UP"), 5000000.00 USD);
    then private_loan_financing_test_met_141c(issue);
}

// =====================================================================
// §141(d)(2)-(7): nongovernmental output property
// =====================================================================

pub entity OutputProperty141 {
    label en unofficial "property acquired by a governmental unit in connection with an output facility (case-asserted)";
}
relation property_prior_use_by_nongovernmental_person_141d2(prop: OutputProperty141, last_use_on: Date) kind empirical {
    label en official "before the acquisition the property was used (or held for use) by a person other than a governmental unit in connection with an output facility, with the last date of that use";
}
relation output_facility_is_water_furnishing_141d2(prop: OutputProperty141) kind empirical {
    label en official "the output facility is a facility for the furnishing of water";
}
pub relation prior_nongovernmental_output_use_141d2(prop: OutputProperty141) kind institutional {
    label en official "the property was used (or held for use) by a nongovernmental person with an output facility other than water, on or after October 14, 1987";
}
@source(IRC_S141_D, relation = formalizes, coverage = exact, quote = "Except as otherwise provided in this subsection, for purposes of paragraph (1), the term \"nongovernmental output property\" means any property (or interest therein) which")
rule PriorNongovernmentalOutputUse(prop: OutputProperty141, on: Date) strict {
    label en official "section 141(d)(2): use before October 14, 1987 is not taken into account";
    when property_prior_use_by_nongovernmental_person_141d2(prop, on);
    when on >= @1987-10-14;
    when not_known(output_facility_is_water_furnishing_141d2(prop));
    then prior_nongovernmental_output_use_141d2(prop);
}
relation output_consumed_fraction_in_qualified_area_141d3A(prop: OutputProperty141, fraction: Decimal) kind empirical {
    label en official "the fraction of the output of the facility that will be consumed in a qualified service area of the acquiring unit or a qualified annexed area of it";
}
relation area_served_all_of_ten_years_before_acquisition_141d3Bi(prop: OutputProperty141, years_counted: Integer) kind empirical {
    label en official "the number of years, within the 10-year period ending on the acquisition date (the period before October 14, 1987 not counted), during which the unit provided the same type of output throughout the area";
}
relation annexed_area_contiguous_and_annexed_for_general_purposes_141d3Bii_I(prop: OutputProperty141) kind empirical {
    label en official "the area is contiguous to, and annexed for general governmental purposes into, a qualified service area of the unit";
}
relation output_available_to_general_public_in_annexed_area_141d3Bii_II(prop: OutputProperty141) kind empirical {
    label en official "output from the property is made available to all members of the general public in the annexed area";
}
relation annexed_area_size_fraction_of_service_area_141d3Bii_III(prop: OutputProperty141, fraction: Decimal) kind empirical {
    label en official "the size of the annexed area as a fraction of the qualified service area (sizes determined at the close of the preceding calendar year, section 141(d)(3)(D)(i))";
}
relation output_capacity_fraction_of_annexation_141d3C(prop: OutputProperty141, fraction: Decimal) kind empirical {
    label en official "the output capacity of the property acquired in connection with the annexation, plus that of all other excepted property for the annexed area, as a fraction of the output capacity serving the qualified service area";
}
pub relation qualified_service_area_141d3Bi(prop: OutputProperty141) kind institutional {
    label en official "the area is a qualified service area: the unit provided output of the same type throughout it at all times during the 10-year period ending on the acquisition date";
}
@source(IRC_S141_D, relation = formalizes, coverage = exact, quote = "The term \"qualified service area\" means, with respect to the governmental unit acquiring the property, any area throughout which such unit provided (at all times during")
rule QualifiedServiceAreaDefined(prop: OutputProperty141, years: Integer) strict {
    label en official "section 141(d)(3)(B)(i): all ten years";
    when area_served_all_of_ten_years_before_acquisition_141d3Bi(prop, years);
    when years >= 10;
    then qualified_service_area_141d3Bi(prop);
}
pub relation qualified_annexed_area_141d3Bii(prop: OutputProperty141) kind institutional {
    label en official "the area is a qualified annexed area: contiguous, output available to the general public, and (unless clause (C) applies) not greater than 10 percent of the qualified service area";
}
@source(IRC_S141_D, relation = formalizes, coverage = exact, quote = "The term \"qualified annexed area\" means, with respect to the governmental unit acquiring the property, any area if—")
rule QualifiedAnnexedAreaBySize(prop: OutputProperty141, fraction: Decimal) strict {
    label en official "section 141(d)(3)(B)(ii)(I)-(III): the annexed area is at most 10 percent of the service area";
    when annexed_area_contiguous_and_annexed_for_general_purposes_141d3Bii_I(prop);
    when output_available_to_general_public_in_annexed_area_141d3Bii_II(prop);
    when annexed_area_size_fraction_of_service_area_141d3Bii_III(prop, fraction);
    when fraction <= 0.10;
    when not_known(size_determination_date_mismatch_141d3D(prop)); // G6402 wiring: §141(d)(3)(D)(i)
    then qualified_annexed_area_141d3Bii(prop);
}
@source(IRC_S141_D, relation = formalizes, coverage = exact, quote = "Subclause (III) of subparagraph (B)(ii) shall not apply to an annexation of an area by a governmental unit if the output capacity of the property acquired in connection")
rule QualifiedAnnexedAreaBySmallCapacityIncrease(prop: OutputProperty141, fraction: Decimal) strict {
    label en official "section 141(d)(3)(C): subclause (III) does not apply where the output capacity, with the other excepted property for the area, does not exceed 10 percent of the capacity serving the service area";
    when annexed_area_contiguous_and_annexed_for_general_purposes_141d3Bii_I(prop);
    when output_available_to_general_public_in_annexed_area_141d3Bii_II(prop);
    when output_capacity_fraction_of_annexation_141d3C(prop, fraction);
    when fraction <= 0.10;
    when not_known(size_determination_date_mismatch_141d3D(prop)); // G6402 wiring: §141(d)(3)(D)(i)
    then qualified_annexed_area_141d3Bii(prop);
}
// G6402 wiring, §141(d)(3)(D)(i): the size of the qualified service area and the output capacity are determined at
// the close of the calendar year preceding the calendar year in which the acquisition or annexation occurs. The
// close date is read from the calendar taxable years of `us.irc.core` (`calendar_year_of`, `begins`, `ends`): the
// year containing the acquisition date and the year before it. The case may name the date at which it measured the
// fractions; a different date makes the fractions unusable for (B)(ii)(III) and (C) (a case that names no date is
// not refused). JUDGMENT CALL: the taxable years are the governmental unit's calendar years supplied by the case.
relation acquisition_or_annexation_date_141d3D(prop: OutputProperty141, on: Date) kind empirical {
    label en official "the date on which the governmental unit acquires the property or the annexation occurs (section 141(d)(3)(D)(i))";
}
relation calendar_year_of_acquisition_141d3D(prop: OutputProperty141, year: us.irc.core::TaxableYear) kind empirical {
    label en official "the calendar taxable year of the governmental unit that contains the acquisition or annexation date";
}
relation calendar_year_before_acquisition_141d3D(prop: OutputProperty141, year: us.irc.core::TaxableYear) kind empirical {
    label en official "the calendar taxable year of the governmental unit immediately preceding the year of the acquisition or annexation";
}
relation size_measured_on_141d3D(prop: OutputProperty141, measured_on: Date) kind empirical {
    label en official "the date at which the size of the service area and the output capacity were measured";
}
pub relation size_determination_date_141d3D(prop: OutputProperty141, on: Date) kind institutional {
    label en official "the close of the calendar year preceding the calendar year of the acquisition or annexation (section 141(d)(3)(D)(i))";
}
@source(IRC_S141_D, relation = formalizes, coverage = exact, quote = "(i) The size of any qualified service area and the output capacity of property serving such area shall be determined as the close of the calendar year preceding the calendar year in which the acquisition of nongovernmental output property or the annexation occurs.")
rule SizeDeterminationDate(prop: OutputProperty141, acquired: Date, cy: us.irc.core::TaxableYear, py: us.irc.core::TaxableYear, begin: Date, finish: Date, n: Integer, m: Integer, close: Date) strict {
    label en official "section 141(d)(3)(D)(i): the end of the calendar year before the year that contains the acquisition or annexation date";
    when acquisition_or_annexation_date_141d3D(prop, acquired);
    when calendar_year_of_acquisition_141d3D(prop, cy);
    when calendar_year_before_acquisition_141d3D(prop, py);
    when us.irc.core::calendar_year_of(cy, n);
    when us.irc.core::calendar_year_of(py, m);
    when n == m + 1;
    when us.irc.core::begins(cy, begin);
    when us.irc.core::ends(cy, finish);
    when acquired >= begin;
    when acquired <= finish;
    when us.irc.core::ends(py, close);
    then size_determination_date_141d3D(prop, close);
}
relation size_determination_date_mismatch_141d3D(prop: OutputProperty141) kind institutional {
    label en official "the fractions were measured at a date other than the close of the preceding calendar year";
}
rule SizeDeterminationDateMismatch(prop: OutputProperty141, measured: Date, close: Date) strict {
    label en official "section 141(d)(3)(D)(i): the measurement date differs from the determination date";
    when size_measured_on_141d3D(prop, measured);
    when size_determination_date_141d3D(prop, close);
    when measured != close;
    then size_determination_date_mismatch_141d3D(prop);
}
relation output_is_consumed_in_qualified_service_area_141d3A(prop: OutputProperty141) kind institutional {
    label en official "helper: the 95 percent of the output are consumed in a qualified service area";
}
relation output_is_consumed_in_qualified_annexed_area_141d3A(prop: OutputProperty141) kind institutional {
    label en official "helper: the 95 percent of the output are consumed in a qualified annexed area";
}
relation output_consumed_in_service_or_annexed_flags_141d3A(prop: OutputProperty141, in_service_area: Boolean, in_annexed_area: Boolean) kind empirical {
    label en official "whether the area where the output is consumed is a qualified service area, or a qualified annexed area";
}
pub relation output_property_excepted_by_area_141d3A(prop: OutputProperty141) kind institutional {
    label en official "the property is excepted from nongovernmental output property: 95 percent or more of the output will be consumed in a qualified service area or a qualified annexed area of the acquiring unit";
}
@source(IRC_S141_D, relation = formalizes, coverage = exact, quote = "(i) a qualified service area of the governmental unit acquiring the property, or")
rule OutputPropertyExceptedServiceArea(prop: OutputProperty141, fraction: Decimal) strict {
    label en official "section 141(d)(3)(A)(i)";
    when output_consumed_fraction_in_qualified_area_141d3A(prop, fraction);
    when fraction >= 0.95;
    when qualified_service_area_141d3Bi(prop);
    then output_property_excepted_by_area_141d3A(prop);
}
@source(IRC_S141_D, relation = formalizes, coverage = exact, quote = "(ii) a qualified annexed area of such unit.")
rule OutputPropertyExceptedAnnexedArea(prop: OutputProperty141, fraction: Decimal) strict {
    label en official "section 141(d)(3)(A)(ii)";
    when output_consumed_fraction_in_qualified_area_141d3A(prop, fraction);
    when fraction >= 0.95;
    when qualified_annexed_area_141d3Bii(prop);
    then output_property_excepted_by_area_141d3A(prop);
}
relation later_annexed_area_joins_service_area_141d3Dii(prop: OutputProperty141, earlier_annexed_area: OutputProperty141) kind empirical {
    label en official "a qualified annexed area treated as part of the qualified service area into which it is annexed for testing areas annexed in a later year";
}
pub relation qualified_annexed_area_part_of_service_area_141d3Dii(later_prop: OutputProperty141) kind institutional {
    label en official "for a later annexation the earlier qualified annexed area counts as part of the qualified service area";
}
@source(IRC_S141_D, relation = formalizes, coverage = exact, quote = "(ii) A qualified annexed area shall be treated as part of the qualified service area into which it is annexed for purposes of determining whether any other area annexed")
rule EarlierAnnexedAreaCountsAsServiceArea(later: OutputProperty141, earlier: OutputProperty141) strict {
    label en official "section 141(d)(3)(D)(ii)";
    when later_annexed_area_joins_service_area_141d3Dii(later, earlier);
    when qualified_annexed_area_141d3Bii(earlier);
    then qualified_annexed_area_part_of_service_area_141d3Dii(later);
}
relation property_converted_to_use_not_in_connection_with_output_facility_141d4A(prop: OutputProperty141) kind empirical {
    label en official "the property is to be converted to a use not in connection with an output facility";
}
relation property_is_part_of_output_function_of_nuclear_power_facility_141d4B(prop: OutputProperty141) kind empirical {
    label en official "the property is part of the output function of a nuclear power facility";
}
pub relation output_property_excepted_by_conversion_141d4(prop: OutputProperty141) kind institutional {
    label en official "the property is excepted: it is to be converted to a use not in connection with an output facility, and it is not part of the output function of a nuclear power facility";
}
@source(IRC_S141_D, relation = formalizes, coverage = exact, quote = "The term \"nongovernmental output property\" shall not include any property which is to be converted to a use not in connection with an output facility.")
rule OutputPropertyExceptedByConversion(prop: OutputProperty141) strict {
    label en official "section 141(d)(4)(A), (B)";
    when property_converted_to_use_not_in_connection_with_output_facility_141d4A(prop);
    when not_known(property_is_part_of_output_function_of_nuclear_power_facility_141d4B(prop));
    then output_property_excepted_by_conversion_141d4(prop);
}
relation contract_is_prepayment_of_electricity_or_gas_141d7(prop: OutputProperty141) kind empirical {
    label en official "the property is a contract for the prepayment of electricity or natural gas";
}
relation contract_is_investment_property_148b2_141d7(prop: OutputProperty141) kind empirical {
    label en official "the prepayment contract is investment property under section 148(b)(2)";
}
pub relation output_property_excepted_by_prepayment_contract_141d7(prop: OutputProperty141) kind institutional {
    label en official "a contract for the prepayment of electricity or natural gas which is not investment property under section 148(b)(2) is not nongovernmental output property";
}
@source(IRC_S141_D, relation = formalizes, coverage = exact, quote = "The term \"nongovernmental output property\" shall not include any contract for the prepayment of electricity or natural gas which is not investment property under section")
rule OutputPropertyExceptedByPrepaymentContract(prop: OutputProperty141) strict {
    label en official "section 141(d)(7)";
    when contract_is_prepayment_of_electricity_or_gas_141d7(prop);
    when not_known(contract_is_investment_property_148b2_141d7(prop));
    then output_property_excepted_by_prepayment_contract_141d7(prop);
}
pub relation nongovernmental_output_property_141d2(prop: OutputProperty141) kind institutional {
    label en official "nongovernmental output property: prior nongovernmental use with an output facility other than water, not excepted by (d)(3), (4) or (7)";
}
@source(IRC_S141_D, relation = formalizes, coverage = exact, quote = "Except as otherwise provided in this subsection, for purposes of paragraph (1), the term \"nongovernmental output property\" means any property (or interest therein) which")
rule NongovernmentalOutputPropertyDefined(prop: OutputProperty141) strict {
    label en official "section 141(d)(2) with the exceptions of (3), (4), (7); the joint action agency rule (6) is a member-level application below";
    when prior_nongovernmental_output_use_141d2(prop);
    when not_known(output_property_excepted_by_area_141d3A(prop));
    when not_known(output_property_excepted_by_conversion_141d4(prop));
    when not_known(output_property_excepted_by_prepayment_contract_141d7(prop));
    then nongovernmental_output_property_141d2(prop);
}
relation joint_action_agency_property_member_share_141d6(prop: OutputProperty141, member: us.irc.core::Organ, share: Decimal) kind empirical {
    label en official "property acquired by a joint action agency whose members are governmental units, with each member's proportionate share";
}
pub relation member_treated_as_acquiring_share_141d6(prop: OutputProperty141, member: us.irc.core::Organ, share: Decimal) kind institutional {
    label en official "the subsection is applied at the member level: each member is treated as acquiring its proportionate share of the property";
}
@source(IRC_S141_D, relation = formalizes, coverage = exact, quote = "With respect to nongovernmental output property acquired by a joint action agency the members of which are governmental units, this subsection shall be applied at the")
rule JointActionAgencyMemberLevel(prop: OutputProperty141, member: us.irc.core::Organ, share: Decimal) strict {
    label en official "section 141(d)(6)";
    when joint_action_agency_property_member_share_141d6(prop, member, share);
    then member_treated_as_acquiring_share_141d6(prop, member, share);
}
relation bond_is_pab_solely_by_reason_of_141d_141d5(issue: BondIssue) kind institutional {
    label en official "helper: the bond is a private activity bond solely by reason of subsection (d)";
}
@source(IRC_S141_D, relation = formalizes, coverage = exact, quote = "In the case of a bond which is a private activity bond solely by reason of this subsection—")
rule PabSolelyByReasonOfSubsectionD(issue: BondIssue) strict {
    label en official "section 141(d)(5) lead-in: the issue meets the (d)(1) test and neither the (b) tests nor the (c) test";
    when nongovernmental_output_property_test_met_141d1(issue);
    when not_known(private_business_use_test_met_141b1(issue));
    when not_known(private_loan_financing_test_met_141c(issue));
    then bond_is_pab_solely_by_reason_of_141d_141d5(issue);
}
pub relation section_147cd_disapplied_141d5A(issue: BondIssue) kind institutional {
    label en official "subsections (c) and (d) of section 147 (land and existing property) do not apply to the bond";
}
@source(IRC_S141_D, relation = formalizes, coverage = exact, quote = "(A) subsections (c) and (d) of section 147 (relating to limitations on acquisition of land and existing property) shall not apply, and")
rule Section147cdDisappliedForSubsectionD(issue: BondIssue) strict {
    label en official "section 141(d)(5)(A)";
    when bond_is_pab_solely_by_reason_of_141d_141d5(issue);
    then section_147cd_disapplied_141d5A(issue);
}
pub relation section_142a8_applied_without_local_141d5B(issue: BondIssue) kind institutional {
    label en official "paragraph (8) of section 142(a) is applied as if it did not contain the word local";
}
@source(IRC_S141_D, relation = formalizes, coverage = exact, quote = "(B) paragraph (8) of section 142(a) shall be applied as if it did not contain \"local\".")
rule Section142a8WithoutLocal(issue: BondIssue) strict {
    label en official "section 141(d)(5)(B)";
    when bond_is_pab_solely_by_reason_of_141d_141d5(issue);
    then section_142a8_applied_without_local_141d5B(issue);
}

// =====================================================================
// §142(b)-(c): ownership, offices, storage, disallowed property
// =====================================================================

pub entity Facility142 {
    label en unofficial "a facility or property financed by an exempt facility bond issue (case-asserted)";
}
relation issue_finances_facility_142(issue: BondIssue, facility: Facility142, kind: ExemptFacilityUseKind) kind empirical {
    label en official "the issue finances the facility, which is of the given exempt facility kind";
}
relation all_property_financed_owned_by_governmental_unit_142b1A(issue: BondIssue) kind empirical {
    label en official "all of the property to be financed by the net proceeds of the issue is to be owned by a governmental unit";
}
relation property_held_under_lease_or_management_contract_142b1B(issue: BondIssue) kind empirical {
    label en official "the property is held under a lease, or a management contract or similar operating agreement, from or with a governmental unit";
}
relation lessee_irrevocably_elects_no_depreciation_or_credit_142b1Bi(issue: BondIssue) kind empirical {
    label en official "the lessee makes an irrevocable election (binding on the lessee and all successors) not to claim depreciation or an investment credit with respect to the property";
}
relation lease_term_fraction_of_expected_economic_life_142b1Bii(issue: BondIssue, fraction: Decimal) kind empirical {
    label en official "the lease term (section 168(i)(3)) as a fraction of the reasonably expected economic life of the property (section 147(b))";
}
relation lessee_has_purchase_option_other_than_fair_market_value_142b1Biii(issue: BondIssue) kind empirical {
    label en official "the lessee has an option to purchase the property other than at fair market value as of the time the option is exercised";
}
pub relation lease_or_management_contract_treated_as_governmental_ownership_142b1B(issue: BondIssue) kind institutional {
    label en official "a lease or management contract treated as ownership by a governmental unit: (i) irrevocable election, (ii) lease term not more than 80 percent of the economic life, (iii) no purchase option other than at fair market value";
}
@source(IRC_S142_B, relation = formalizes, coverage = exact, quote = "(i) the lessee makes an irrevocable election (binding on the lessee and all successors in interest under the lease) not to claim depreciation or an investment credit")
rule LeaseTreatedAsGovernmentalOwnership(issue: BondIssue, fraction: Decimal) strict {
    label en official "section 142(b)(1)(B)(i)-(iii), and the closing sentence for management contracts and similar operating agreements";
    when property_held_under_lease_or_management_contract_142b1B(issue);
    when lessee_irrevocably_elects_no_depreciation_or_credit_142b1Bi(issue);
    when lease_term_fraction_of_expected_economic_life_142b1Bii(issue, fraction);
    when fraction <= 0.80;
    when not_known(lessee_has_purchase_option_other_than_fair_market_value_142b1Biii(issue));
    then lease_or_management_contract_treated_as_governmental_ownership_142b1B(issue);
}
relation spaceport_property_on_land_leased_by_governmental_unit_from_united_states_142b1C(issue: BondIssue) kind empirical {
    label en official "spaceport property located on land leased by a governmental unit from the United States, the requirements of this paragraph being met by the lease and any subleases (Pub. L. 119-21 section 70309(b))";
}
pub relation governmental_ownership_requirement_met_142b1(issue: BondIssue) kind institutional {
    label en official "the requirement of section 142(b)(1) is met: all the property is to be owned by a governmental unit, or a lease or management contract is treated as ownership, or it is spaceport property on land leased from the United States";
}
@source(IRC_S142_B, relation = formalizes, coverage = exact, quote = "A facility shall be treated as described in paragraph (1), (2), (3), or (12) of subsection (a) only if all of the property to be financed by the net proceeds of the")
rule OwnershipRequirementMetByOwnership(issue: BondIssue) strict {
    label en official "section 142(b)(1)(A)";
    when all_property_financed_owned_by_governmental_unit_142b1A(issue);
    then governmental_ownership_requirement_met_142b1(issue);
}
@source(IRC_S142_B, relation = formalizes, coverage = exact, quote = "(i) the lessee makes an irrevocable election (binding on the lessee and all successors in interest under the lease) not to claim depreciation or an investment credit")
rule OwnershipRequirementMetByLease(issue: BondIssue) strict {
    label en official "section 142(b)(1)(B)";
    when lease_or_management_contract_treated_as_governmental_ownership_142b1B(issue);
    then governmental_ownership_requirement_met_142b1(issue);
}
@source(us.irc.temporal::PL119_21_S70309, relation = formalizes, coverage = exact, quote = "(b) Treatment of Ground Leases.—Section 142(b)(1) is amended by adding at the end the following new subparagraph:")
rule OwnershipRequirementMetBySpaceportGroundLease(issue: BondIssue) strict {
    label en official "Pub. L. 119-21 section 70309(b), new section 142(b)(1)(C), for obligations issued after July 4, 2025 (the date is checked by the caller through the issue date fact of section 142(p) below)";
    when spaceport_property_on_land_leased_by_governmental_unit_from_united_states_142b1C(issue);
    when lease_or_management_contract_treated_as_governmental_ownership_142b1B(issue);
    then governmental_ownership_requirement_met_142b1(issue);
}
relation office_located_on_premises_of_facility_142b2A(office: Facility142) kind empirical {
    label en official "the office is located on the premises of a facility described in the paragraph of subsection (a)";
}
relation office_functions_not_directly_related_to_day_to_day_operations_de_minimis_142b2B(office: Facility142) kind empirical {
    label en official "not more than a de minimis amount of the functions performed at the office is not directly related to the day-to-day operations at the facility";
}
pub relation office_treated_as_part_of_exempt_facility_142b2(office: Facility142) kind institutional {
    label en official "an office is treated as described in a paragraph of subsection (a) only if both conditions are met";
}
@source(IRC_S142_B, relation = formalizes, coverage = exact, quote = "An office shall not be treated as described in a paragraph of subsection (a) unless—")
rule OfficeTreatedAsPartOfFacility(office: Facility142) strict {
    label en official "section 142(b)(2)(A)-(B)";
    when office_located_on_premises_of_facility_142b2A(office);
    when office_functions_not_directly_related_to_day_to_day_operations_de_minimis_142b2B(office);
    then office_treated_as_part_of_exempt_facility_142b2(office);
}
relation storage_or_training_facility_directly_related_to_facility_142c1(storage: Facility142, main_facility: Facility142) kind empirical {
    label en official "the storage or training facility is directly related to the main facility";
}
relation facility_kind_142(facility: Facility142, kind: ExemptFacilityUseKind) kind empirical {
    label en official "the exempt facility kind of the facility";
}
pub relation storage_or_training_treated_as_same_kind_142c1(storage: Facility142, kind: ExemptFacilityUseKind) kind institutional {
    label en official "storage or training facilities directly related to a facility described in paragraph (1), (2), (3) or (11) of subsection (a) are treated as described in the paragraph in which that facility is described";
}
@source(IRC_S142_C, relation = formalizes, coverage = exact, quote = "Storage or training facilities directly related to a facility described in paragraph (1), (2), (3) or (11) of subsection (a) shall be treated as described in the")
rule StorageOrTrainingTreatedAsSameKindAirports(storage: Facility142, main: Facility142) strict {
    label en official "section 142(c)(1): airports, paragraph (1)";
    when storage_or_training_facility_directly_related_to_facility_142c1(storage, main);
    when facility_kind_142(main, Airports);
    then storage_or_training_treated_as_same_kind_142c1(storage, Airports);
}
rule StorageOrTrainingTreatedAsSameKindDocks(storage: Facility142, main: Facility142) strict {
    label en official "section 142(c)(1): docks and wharves, paragraph (2)";
    when storage_or_training_facility_directly_related_to_facility_142c1(storage, main);
    when facility_kind_142(main, DocksAndWharves);
    then storage_or_training_treated_as_same_kind_142c1(storage, DocksAndWharves);
}
rule StorageOrTrainingTreatedAsSameKindMassCommuting(storage: Facility142, main: Facility142) strict {
    label en official "section 142(c)(1): mass commuting facilities, paragraph (3)";
    when storage_or_training_facility_directly_related_to_facility_142c1(storage, main);
    when facility_kind_142(main, MassCommutingFacilities);
    then storage_or_training_treated_as_same_kind_142c1(storage, MassCommutingFacilities);
}
rule StorageOrTrainingTreatedAsSameKindHighSpeedRail(storage: Facility142, main: Facility142) strict {
    label en official "section 142(c)(1): high-speed intercity rail facilities, paragraph (11)";
    when storage_or_training_facility_directly_related_to_facility_142c1(storage, main);
    when facility_kind_142(main, HighSpeedIntercityRail);
    then storage_or_training_treated_as_same_kind_142c1(storage, HighSpeedIntercityRail);
}
pub enum DisallowedProperty142c2 { LodgingFacility; OversizedRetailFacility; RetailFacilityOutsideTerminal; OfficeBuildingForNonGovernmentalEmployees; IndustrialParkOrManufacturingFacility; OrdinaryProperty; }
relation facility_property_class_142c2(facility: Facility142, class: DisallowedProperty142c2) kind empirical {
    label en official "the class of the property under section 142(c)(2)(A)-(E)";
}
relation facility_to_be_used_for_private_business_use_142c2(facility: Facility142) kind empirical {
    label en official "the property is to be used for any private business use (section 141(b)(6))";
}
relation spaceport_manufacturing_property_142p4(facility: Facility142) kind empirical {
    label en official "the property is spaceport property described in section 142(p)(1)(A) (manufacturing, assembling or repairing spacecraft, space cargo or a component)";
}
pub relation facility_not_treated_as_described_142c2(facility: Facility142) kind institutional {
    label en official "property of an airport, dock, mass commuting or high-speed rail facility is not treated as described in the paragraph if it is lodging, oversized retail, retail outside the terminal, an office building for non-employees, or an industrial park or manufacturing facility, and is to be used for a private business use (spaceport manufacturing property is not caught by the industrial park limb)";
}
@source(IRC_S142_C, relation = formalizes, coverage = exact, quote = "(A) Any lodging facility.")
rule DisallowedPropertyLodging(facility: Facility142) strict {
    label en official "section 142(c)(2)(A)";
    when facility_property_class_142c2(facility, LodgingFacility);
    when facility_to_be_used_for_private_business_use_142c2(facility);
    then facility_not_treated_as_described_142c2(facility);
}
@source(IRC_S142_C, relation = formalizes, coverage = exact, quote = "(B) Any retail facility (including food and beverage facilities) in excess of a size necessary to serve passengers and employees at the exempt facility.")
rule DisallowedPropertyOversizedRetail(facility: Facility142) strict {
    label en official "section 142(c)(2)(B)";
    when facility_property_class_142c2(facility, OversizedRetailFacility);
    when facility_to_be_used_for_private_business_use_142c2(facility);
    then facility_not_treated_as_described_142c2(facility);
}
@source(IRC_S142_C, relation = formalizes, coverage = exact, quote = "(C) Any retail facility (other than parking) for passengers or the general public located outside the exempt facility terminal.")
rule DisallowedPropertyRetailOutsideTerminal(facility: Facility142) strict {
    label en official "section 142(c)(2)(C)";
    when facility_property_class_142c2(facility, RetailFacilityOutsideTerminal);
    when facility_to_be_used_for_private_business_use_142c2(facility);
    then facility_not_treated_as_described_142c2(facility);
}
@source(IRC_S142_C, relation = formalizes, coverage = exact, quote = "(D) Any office building for individuals who are not employees of a governmental unit or of the operating authority for the exempt facility.")
rule DisallowedPropertyOfficeBuilding(facility: Facility142) strict {
    label en official "section 142(c)(2)(D)";
    when facility_property_class_142c2(facility, OfficeBuildingForNonGovernmentalEmployees);
    when facility_to_be_used_for_private_business_use_142c2(facility);
    then facility_not_treated_as_described_142c2(facility);
}
@source(IRC_S142_C, relation = formalizes, coverage = exact, quote = "(E) Any industrial park or manufacturing facility.")
rule DisallowedPropertyIndustrialPark(facility: Facility142) strict {
    label en official "section 142(c)(2)(E), with the spaceport exception of section 142(p)(4)";
    when facility_property_class_142c2(facility, IndustrialParkOrManufacturingFacility);
    when facility_to_be_used_for_private_business_use_142c2(facility);
    when not_known(spaceport_manufacturing_property_142p4(facility));
    then facility_not_treated_as_described_142c2(facility);
}
@source(IRC_S142_C, relation = formalizes, coverage = exact, quote = "Property shall not be treated as described in paragraph (1), (2), (3) or (11) of subsection (a) if such property is described in any of the following subparagraphs and")
rule DisallowedPropertyLeadIn(facility: Facility142, kind: ExemptFacilityUseKind) strict {
    label en official "section 142(c)(2) lead-in: the disallowance applies to the paragraph (1), (2), (3) and (11) facilities";
    when facility_kind_142(facility, kind);
    when facility_not_treated_as_described_142c2(facility);
    then facility_fails_142c2_of_kind(facility, kind);
}
pub relation facility_fails_142c2_of_kind(facility: Facility142, kind: ExemptFacilityUseKind) kind institutional {
    label en official "the facility fails the section 142(c)(2) test for its kind";
}
