// Section 102 — Gifts and inheritances. Stage 2b (IRC-06).

use self::{
    IRC_S102_A,
    IRC_S102_B,
    IRC_S102_C,
    Individual,
    TaxableYear,
};

pub relation acquired_by_gift_bequest_devise_or_inheritance(p: Individual, asset: us.irc.core::Asset, y: TaxableYear) kind empirical {
    label en official "the value of the asset acquired by gift, bequest, devise, or inheritance (section 102(a))";
}
pub relation gift_property_value_excluded_102a(p: Individual, asset: us.irc.core::Asset, y: TaxableYear) kind institutional {
    label en official "the value of the asset is excluded from gross income (section 102(a))";
}

@source(IRC_S102_A, quote = "Gross income does not include the value of property acquired by gift, bequest, devise, or inheritance.")
rule GiftPropertyValueExcluded(p: Individual, asset: us.irc.core::Asset, y: TaxableYear) strict {
    label en official "the value of the asset received by gift/bequest/devise/inheritance is excluded from gross income";
    when acquired_by_gift_bequest_devise_or_inheritance(p, asset, y);
    then gift_property_value_excluded_102a(p, asset, y);
}

// --- §102(b): income from the gift asset is NOT excluded ------------------

pub relation income_from_gift_property(p: Individual, asset: us.irc.core::Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "income from the asset referred to in subsection (a) — or, where the gift/bequest/devise/inheritance is itself of income from an asset, the amount of such income, including amounts paid/credited/distributed at intervals out of such income (section 102(b)(1)-(2), second sentence)";
}
pub relation income_from_gift_property_not_excluded_102b(p: Individual, asset: us.irc.core::Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the (b)(1)/(b)(2) income is NOT excluded by subsection (a) — i.e. it is an item of gross income";
}

@source(IRC_S102_B, quote = "Subsection (a) shall not exclude from gross income—")
rule IncomeFromGiftPropertyNotExcluded(p: Individual, asset: us.irc.core::Asset, y: TaxableYear, amount: Money) strict {
    label en official "income from a gift asset, or income-interest gifts themselves, are not excluded by (a)";
    when income_from_gift_property(p, asset, y, amount);
    then income_from_gift_property_not_excluded_102b(p, asset, y, amount);
}

// Third sentence: amounts under a subchapter J beneficiary inclusion are
// likewise treated as (b)(2) income-from-asset, not a fresh classification
// — folded into the `income_from_gift_property` case fact's own scope
// (NON_NORMATIVE for the sentence itself, consistent with the §66(d)(2)-(3)
// glossary-folding precedent), since `trusts-estates` (subchapter J) owns the
// actual beneficiary-inclusion computation and would assert this package's
// `income_from_gift_property` fact directly once wired (EXTERNAL_DEPENDENCY,
// owner `trusts-estates`, unconfirmed pending contract).

// --- §102(c): employee gifts ---------------------------------------------------

pub relation employer_transfer_to_employee(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "an amount transferred by or for an employer to, or for the benefit of, an employee (section 102(c)(1))";
}
pub relation employer_transfer_not_excluded_102c(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "subsection (a) does not exclude this employer-to-employee transfer from the employee's gross income (section 102(c)(1))";
}

@source(IRC_S102_C, quote = "Subsection (a) shall not exclude from gross income any amount transferred by or for an employer to, or for the benefit of, an employee.")
rule EmployeeGiftNotExcluded(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, amount: Money) strict {
    label en official "an employer-to-employee transfer is not excluded from the employee's gross income under section 102(a)";
    when employer_transfer_to_employee(employer, employee, y, amount);
    then employer_transfer_not_excluded_102c(employer, employee, y, amount);
}

// §102(c)(2): cross references to section 74(c) (employee achievement
// awards) and section 132(e) (de minimis fringes) — NON_NORMATIVE pointers;
// no independent normative content (both are formalized elsewhere in this
// same package: §74(c) not yet reached this stage, §132(e) reached below in
// this stage 2b pass).
