// Section 117 — Qualified scholarships. Stage 2d (IRC-06). Scope: (a)
// general exclusion, (b) definitions (qualified scholarship, qualified
// tuition and related expenses), (c) services exception with its (c)(2)
// carve-outs, (d) qualified tuition reduction incl. (d)(3) HCE
// nondiscrimination and (d)(5) graduate-teaching-assistant extension.
// NOT reached: (d)(4) (repealed, non_normative), the notes.

// =====================================================================
// §117(a)/(b): the general exclusion and its definitions
// =====================================================================

use self::{
    IRC_S117_A,
    IRC_S117_B,
    IRC_S117_C,
    IRC_S117_D,
    Individual,
    TaxableYear,
};

pub relation candidate_for_degree_170b1Aii(p: Individual, org: us.irc.core::Organ) kind empirical {
    label en official "the individual is a candidate for a degree at an educational organization described in section 170(b)(1)(A)(ii) (section 117(a))";
}
pub relation qualified_tuition_and_related_expenses_117b2(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "tuition and fees required for enrollment or attendance, plus fees/books/supplies/equipment required for courses of instruction, at a section 170(b)(1)(A)(ii) organization (section 117(b)(2)(A)-(B))";
}
pub relation amount_received_as_scholarship_or_fellowship(p: Individual, org: us.irc.core::Organ, y: TaxableYear, amount: Money) kind empirical {
    label en official "an amount received by the individual as a scholarship or fellowship grant (section 117(b)(1))";
}
pub relation qualified_scholarship_117b1(p: Individual, org: us.irc.core::Organ, y: TaxableYear, amount: Money) kind institutional {
    label en official "the portion of a scholarship or fellowship grant the individual establishes was used for qualified tuition and related expenses (section 117(b)(1)) — capped at the amount received";
}
@source(IRC_S117_B, quote = "The term \"qualified scholarship\" means any amount received by an individual as a scholarship or fellowship grant to the extent the individual establishes that, in accordance with the conditions of the grant, such amount was used for qualified tuition and related expenses")
rule QualifiedScholarshipComputed(p: Individual, org: us.irc.core::Organ, y: TaxableYear, received: Money, expenses: Money) strict {
    label en official "section 117(b)(1): the qualified-scholarship portion is capped at the lesser of the amount received or the qualified tuition and related expenses";
    when amount_received_as_scholarship_or_fellowship(p, org, y, received);
    when qualified_tuition_and_related_expenses_117b2(p, y, expenses);
    then qualified_scholarship_117b1(p, org, y, min(received, expenses));
}

relation section_117_services_portion(p: Individual, org: us.irc.core::Organ, y: TaxableYear, amount: Money) kind institutional {
    label en official "helper: the portion of a scholarship classified as (c) services compensation, excluded from the (a)/(d) exclusion (see the (c) block below)";
}
relation has_services_portion_117c(p: Individual, org: us.irc.core::Organ, y: TaxableYear) kind institutional {
    label en official "helper binding the otherwise-open amount for the not_known test below (this package's settled idiom)";
}
rule HasServicesPortion(p: Individual, org: us.irc.core::Organ, y: TaxableYear, amount: Money) strict {
    label en official "helper for QualifiedScholarshipExcluded's not_known test";
    when section_117_services_portion(p, org, y, amount);
    then has_services_portion_117c(p, org, y);
}

pub relation qualified_scholarship_excluded_117a(p: Individual, org: us.irc.core::Organ, y: TaxableYear, amount: Money) kind institutional {
    label en official "gross income does not include this qualified scholarship amount (section 117(a)), for a candidate for a degree, net of any (c) services portion";
}
@source(IRC_S117_A, quote = "Gross income does not include any amount received as a qualified scholarship by an individual who is a candidate for a degree at an educational organization described in section 170(b)(1)(A)(ii).")
rule QualifiedScholarshipExcludedNoServices(p: Individual, org: us.irc.core::Organ, y: TaxableYear, amount: Money) strict {
    label en official "section 117(a): full exclusion, no (c) services portion to net out";
    when candidate_for_degree_170b1Aii(p, org);
    when qualified_scholarship_117b1(p, org, y, amount);
    when not_known(has_services_portion_117c(p, org, y));
    then qualified_scholarship_excluded_117a(p, org, y, amount);
}
@source(IRC_S117_A, quote = "Gross income does not include any amount received as a qualified scholarship by an individual who is a candidate for a degree at an educational organization described in section 170(b)(1)(A)(ii).")
rule QualifiedScholarshipExcludedNetOfServices(p: Individual, org: us.irc.core::Organ, y: TaxableYear, amount: Money, services: Money) strict {
    label en official "section 117(a)/(c): the exclusion is net of the services-compensation portion";
    when candidate_for_degree_170b1Aii(p, org);
    when qualified_scholarship_117b1(p, org, y, amount);
    when section_117_services_portion(p, org, y, services);
    when amount > services;
    then qualified_scholarship_excluded_117a(p, org, y, round(amount - services, 2, "HALF_UP"));
}

// =====================================================================
// §117(c): services exception
// =====================================================================

relation amount_represents_payment_for_services(p: Individual, org: us.irc.core::Organ, y: TaxableYear, amount: Money) kind empirical {
    label en official "the portion of a scholarship/tuition-reduction amount which represents payment for teaching, research, or other services by the student required as a condition of receiving the amount (section 117(c)(1))";
}
relation services_exception_carveout_117c2(p: Individual, org: us.irc.core::Organ, y: TaxableYear) kind empirical {
    label en official "the amount is received under one of the (c)(2) programs (National Health Service Corps Scholarship Program, Armed Forces Health Professions Scholarship, or a comprehensive student work-learning-service program) which restores the (a)/(d) exclusion despite (c)(1) (section 117(c)(2))";
}
@source(IRC_S117_C, quote = "Except as provided in paragraph (2), subsections (a) and (d) shall not apply to that portion of any amount received which represents payment for teaching, research, or other services by the student required as a condition for receiving the qualified scholarship or qualified tuition reduction.")
rule ServicesPortionExcludedFromExclusion(p: Individual, org: us.irc.core::Organ, y: TaxableYear, amount: Money) strict {
    label en official "section 117(c)(1): the services-compensation portion is taxable, absent a (c)(2) program carve-out";
    when amount_represents_payment_for_services(p, org, y, amount);
    when not_known(services_exception_carveout_117c2(p, org, y));
    then section_117_services_portion(p, org, y, amount);
}
// When a (c)(2) program applies, no services-portion helper fact is
// concluded at all (the amount simply stays inside the ordinary (a)/(d)
// exclusion computed above) — no separate rule is needed beyond omitting
// `section_117_services_portion` for that case, matching this package's
// "absence is the exception's effect" convention used elsewhere (e.g.
// s108's precedence rules).

// =====================================================================
// §117(d): qualified tuition reduction
// =====================================================================

pub relation employer_of_educational_organization(p: Individual, org: us.irc.core::Organ) kind empirical {
    label en official "the individual is an employee of an organization described in section 170(b)(1)(A)(ii), or is treated as such an employee (or whose use is treated as such) under section 132(h) (section 117(d)(2)(A)-(B))";
}
pub relation tuition_reduction_amount_117d(p: Individual, org: us.irc.core::Organ, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of a reduction in tuition provided to the individual for education below the graduate level at the organization (or another organization pursuant to a reciprocal agreement) (section 117(d)(2))";
}
pub relation highly_compensated_employee_117d(p: Individual, org: us.irc.core::Organ, y: TaxableYear) kind empirical {
    label en official "the employee is a highly compensated employee of the organization for the taxable year (section 117(d)(3))";
}
relation tuition_reduction_available_nondiscriminatorily_117d3(p: Individual, org: us.irc.core::Organ, y: TaxableYear) kind empirical {
    label en official "the tuition reduction is available on substantially the same terms to each member of a group of employees defined under a reasonable classification set up by the organization which does not discriminate in favor of highly compensated employees (section 117(d)(3))";
}

pub relation qualified_tuition_reduction_117d(p: Individual, org: us.irc.core::Organ, y: TaxableYear, amount: Money) kind institutional {
    label en official "the qualified tuition reduction excluded from gross income under section 117(d)(1)";
}
@source(IRC_S117_D, quote = "Gross income shall not include any qualified tuition reduction.")
rule QualifiedTuitionReductionNonHce(p: Individual, org: us.irc.core::Organ, y: TaxableYear, amount: Money) strict {
    label en official "section 117(d)(1): a non-HCE employee's tuition reduction is fully excluded, subject only to the (c) services carve-out applied above";
    when employer_of_educational_organization(p, org);
    when tuition_reduction_amount_117d(p, org, y, amount);
    when not_known(highly_compensated_employee_117d(p, org, y));
    then qualified_tuition_reduction_117d(p, org, y, amount);
}
@source(IRC_S117_D, quote = "Paragraph (1) shall apply with respect to any qualified tuition reduction provided with respect to any highly compensated employee only if such reduction is available on substantially the same terms to each member of a group of employees which is defined under a reasonable classification set up by the employer which does not discriminate in favor of highly compensated employees (within the meaning of section 414(q)).")
rule QualifiedTuitionReductionHceNondiscriminatory(p: Individual, org: us.irc.core::Organ, y: TaxableYear, amount: Money) strict {
    label en official "section 117(d)(3): an HCE's tuition reduction is excluded only when the plan is nondiscriminatory";
    when employer_of_educational_organization(p, org);
    when tuition_reduction_amount_117d(p, org, y, amount);
    when highly_compensated_employee_117d(p, org, y);
    when tuition_reduction_available_nondiscriminatorily_117d3(p, org, y);
    then qualified_tuition_reduction_117d(p, org, y, amount);
}

// (d)(5): graduate teaching/research assistants — education below the
// graduate level treated as satisfied for a graduate student engaged in
// teaching or research activities, so (d)(1)'s exclusion reaches graduate
// tuition reductions too for that population.
// G6404 wiring, §117(d)(5): the graduate-level tuition reduction of a teaching or research assistant is a qualified
// tuition reduction; `tuition_reduction_amount_117d` is the below-graduate-level amount of (d)(2), so the
// graduate-level amount is its own fact. JUDGMENT CALL: the assistant is read as covered by the same
// `employer_of_educational_organization` link that the (d)(2) rules use.
relation graduate_tuition_reduction_amount_117d5(p: Individual, org: us.irc.core::Organ, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of a reduction in tuition provided to the graduate student for graduate-level education at the organization (section 117(d)(5))";
}
@source(IRC_S117_D, quote = "paragraph (2) shall be applied as if it did not contain the phrase \"(below the graduate level)\"")
rule QualifiedTuitionReductionGraduateAssistantNonHce(p: Individual, org: us.irc.core::Organ, y: TaxableYear, amount: Money) strict {
    label en official "section 117(d)(5) with (d)(1): the graduate-level reduction of an assistant is a qualified tuition reduction";
    when employer_of_educational_organization(p, org);
    when graduate_education_treated_as_below_graduate_level_117d5(p, org, y);
    when graduate_tuition_reduction_amount_117d5(p, org, y, amount);
    when not_known(highly_compensated_employee_117d(p, org, y));
    then qualified_tuition_reduction_117d(p, org, y, amount);
}
@source(IRC_S117_D, quote = "paragraph (2) shall be applied as if it did not contain the phrase \"(below the graduate level)\"")
rule QualifiedTuitionReductionGraduateAssistantHce(p: Individual, org: us.irc.core::Organ, y: TaxableYear, amount: Money) strict {
    label en official "section 117(d)(5) with (d)(3): a highly compensated assistant needs the nondiscriminatory availability";
    when employer_of_educational_organization(p, org);
    when graduate_education_treated_as_below_graduate_level_117d5(p, org, y);
    when graduate_tuition_reduction_amount_117d5(p, org, y, amount);
    when highly_compensated_employee_117d(p, org, y);
    when tuition_reduction_available_nondiscriminatorily_117d3(p, org, y);
    then qualified_tuition_reduction_117d(p, org, y, amount);
}
relation graduate_student_teaching_or_research_117d5(p: Individual, org: us.irc.core::Organ, y: TaxableYear) kind empirical {
    label en official "the individual is a graduate student at a section 170(b)(1)(A)(ii) organization engaged in teaching or research activities for the organization (section 117(d)(5))";
}
pub relation graduate_education_treated_as_below_graduate_level_117d5(p: Individual, org: us.irc.core::Organ, y: TaxableYear) kind institutional {
    label en official "section 117(d)(5): for a graduate teaching/research assistant, the (d)(2) 'education below the graduate level' condition is treated as met";
}
@source(IRC_S117_D, quote = "paragraph (2) shall be applied as if it did not contain the phrase \"(below the graduate level)\"")
rule GraduateTeachingAssistantExtension(p: Individual, org: us.irc.core::Organ, y: TaxableYear) strict {
    label en official "section 117(d)(5)";
    when graduate_student_teaching_or_research_117d5(p, org, y);
    then graduate_education_treated_as_below_graduate_level_117d5(p, org, y);
}
