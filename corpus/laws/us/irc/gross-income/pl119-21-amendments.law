// Amendments of the 119th Congress (Pub. L. 119-21) to sections owned by this
// package, carried where the enacted text is pinned in `us.irc.temporal`.
// Stage 2e (IRC-06), DECISION-0379. STATUS: implemented_unverified (static
// check only; scenarios in tests/pl119-21-amendments.lawtest are NOT executed).
//
// TECHNIQUE (a judgment call, repeated in the coverage notes): the grammar has
// `revision_decl` (§32), but a `revision` replaces a whole fragment of the base
// edition and the amended base provisions here (§108(f)(5), §127(c)(1)(B),
// §129(a)(2)(A)) are entangled with rules that read their numbers; this module
// therefore uses APPLICABILITY TESTS on the taxable-year start (`us.irc.core::
// begins`) and on payment/discharge dates, with the 2024-edition figures kept in
// the original modules under the complementary condition. The enactment date
// (2025-07-04) is not itself modelled as an `effective` boundary because every
// amendment below carries its own "taxable years beginning after / payments
// after / discharges after December 31, 2025" applicability rule, which the
// tests encode. New sections 128 and 139J are added here (they have no base
// text in the 2024 edition).
//
// NOT carried (SOURCE_GAP rows in the coverage file): §127(d) inflation
// adjustment (needs the section 1(f)(3) factor for 2025 base), §128(b)(2)
// inflation adjustment after 2027, and the amendments of §63 (tips, overtime,
// car-loan interest deductions), §132, §144, §142/§149, §78, §151, §152, §62,
// §67/§68 whose owned modules already carry their 2025/2026 windows or whose
// substituted text is not modelled.

// =====================================================================
// §129(a)(2)(A): $7,500 / $3,750 for taxable years beginning after 2025
// =====================================================================

use self::{
    EducationalAssistanceKind,
    Individual,
    Person,
    TaxableYear,
    adjusted_gross_income,
    base_exemption_amount_151,
    dependent_care_assistance_furnished,
    dependent_care_dollar_limit_129a2A,
    educational_assistance_furnished,
    itemized_deductions_reduced_amount,
    itemized_deductions_total,
    married_filing_separately_129,
    month_qualifies_for_112_exclusion,
    qualified_education_loan_payment_valid_127c1B,
    student_loan_discharge_excluded_108f,
};

@source(us.irc.temporal::PL119_21_S70404, relation = formalizes, coverage = exact, quote = "Section 129(a)(2)(A) is amended by striking “$5,000 ($2,500” and inserting “$7,500 ($3,750”.")
rule DependentCareDollarLimitMFSFrom2026(p: Individual, y: TaxableYear, b_start: Date) strict {
    label en official "section 129(a)(2)(A) as amended: $3,750 in the case of a separate return by a married individual, taxable years beginning after December 31, 2025";
    when married_filing_separately_129(p, y);
    when us.irc.core::begins(y, b_start);
    when b_start >= @2026-01-01;
    then dependent_care_dollar_limit_129a2A(p, y, 3750.00 USD);
}
@source(us.irc.temporal::PL119_21_S70404, relation = formalizes, coverage = exact, quote = "Section 129(a)(2)(A) is amended by striking “$5,000 ($2,500” and inserting “$7,500 ($3,750”.")
rule DependentCareDollarLimitGeneralFrom2026(p: Individual, y: TaxableYear, b_start: Date) strict {
    label en official "section 129(a)(2)(A) as amended: $7,500, taxable years beginning after December 31, 2025";
    when not_known(married_filing_separately_129(p, y));
    when dependent_care_assistance_furnished(p, _, y, _);
    when us.irc.core::begins(y, b_start);
    when b_start >= @2026-01-01;
    then dependent_care_dollar_limit_129a2A(p, y, 7500.00 USD);
}

// =====================================================================
// §127(c)(1)(B): student-loan payments no longer limited to before 2026
// =====================================================================

@source(us.irc.temporal::PL119_21_S70412, relation = formalizes, coverage = exact, quote = "Section 127(c)(1)(B) is amended by striking “in the case of payments made before January 1, 2026,”")
rule QualifiedEducationLoanPaymentValidFrom2026(p: Individual, employer: Person, y: TaxableYear, amount: Money, paid_on: Date) strict {
    label en official "section 127(c)(1)(B) as amended: the sunset words are struck, payments made after December 31, 2025 qualify without the date limit";
    when educational_assistance_furnished(p, employer, y, StudentLoanPayment, amount, paid_on);
    when paid_on >= @2026-01-01;
    then qualified_education_loan_payment_valid_127c1B(p, employer, y, amount, paid_on);
}

// =====================================================================
// §108(f)(5): discharges on account of death or disability (after 2025)
// =====================================================================

relation loan_is_student_loan_or_private_education_loan(loan: us.irc.core::Asset) kind empirical {
    label en official "the loan is a student loan (section 108(f)(2)) or a private education loan (section 140(a) of the Consumer Credit Protection Act) (section 108(f)(5)(B))";
}
relation loan_discharged_on_death_or_permanent_disability(p: Individual, loan: us.irc.core::Asset, discharged_on: Date, amount: Money) kind empirical {
    label en official "the loan was discharged, in whole or in part, pursuant to section 437(a) or (d) of the Higher Education Act of 1965 or the parallel part D benefit, or section 464(c)(1)(F), or otherwise on account of the death or total and permanent disability of the student (section 108(f)(5)(A)), on the given date";
}
relation taxpayer_includes_ssn_on_return(p: Individual, y: TaxableYear) kind empirical {
    label en official "the taxpayer includes the taxpayer's social security number (section 24(h)(7)) on the return for the year (section 108(f)(5)(C))";
}
@source(us.irc.temporal::PL119_21_S70119, relation = formalizes, coverage = exact, quote = "Section 108(f)(5) is amended to read as follows:")
@source(us.irc.temporal::PL119_21_S70119, relation = formalizes, coverage = exact, quote = "(iii) otherwise discharged on account of death or total and permanent disability of the student.")
@source(us.irc.temporal::PL119_21_S70119, relation = formalizes, coverage = exact, quote = "Subparagraph (A) shall not apply with respect to any discharge during any taxable year unless the taxpayer includes the taxpayer’s social security number on the return of tax for such taxable year.")
rule StudentLoanDeathOrDisabilityDischargeExcludedFrom2026(p: Individual, loan: us.irc.core::Asset, y: TaxableYear, amount: Money, discharged_on: Date) strict {
    label en official "section 108(f)(5) as amended, discharges after December 31, 2025: excluded if the loan is a student or private education loan and the taxpayer includes the social security number on the return";
    when loan_discharged_on_death_or_permanent_disability(p, loan, discharged_on, amount);
    when loan_is_student_loan_or_private_education_loan(loan);
    when taxpayer_includes_ssn_on_return(p, y);
    when discharged_on >= @2026-01-01;
    then student_loan_discharge_excluded_108f(p, y, amount);
}

// =====================================================================
// §112 note (Pub. L. 115-97 §11026 as amended): qualified hazardous duty areas
// =====================================================================

pub enum HazardousDutyArea {
    SinaiPeninsulaOfEgypt;
    Kenya;
    Mali;
    BurkinaFaso;
    Chad;
}
relation services_in_hazardous_duty_area_during_month(p: Individual, month_start: Date, area: HazardousDutyArea) kind empirical {
    label en official "the member performed services in the location during part of the month";
}
relation entitled_to_special_pay_37usc310_for_area(p: Individual, month_start: Date, area: HazardousDutyArea) kind empirical {
    label en official "a member of the Armed Forces is entitled to special pay under section 310 of title 37 (hostile fire or imminent danger) for services performed in the location, in the period of the month; the area is a qualified hazardous duty area only during such a period";
}
@source(us.irc.temporal::PL119_21_S70118, relation = formalizes, coverage = partial, quote = "the term ‘qualified hazardous duty area’ means each of the following locations, but only during the period for which any member of the Armed Forces of the United States is entitled to")
rule MonthQualifiesByQualifiedHazardousDutyArea(p: Individual, month_start: Date, area: HazardousDutyArea) strict {
    label en official "Pub. L. 115-97 §11026(a)-(b) as amended by Pub. L. 119-21 §70118, effective January 1, 2026: a qualified hazardous duty area (Sinai Peninsula of Egypt, Kenya, Mali, Burkina Faso, Chad) is treated as a combat zone for section 112, so the month qualifies for the combat-zone pay exclusion";
    when services_in_hazardous_duty_area_during_month(p, month_start, area);
    when entitled_to_special_pay_37usc310_for_area(p, month_start, area);
    when month_start >= @2026-01-01;
    then month_qualifies_for_112_exclusion(p, month_start);
}

// =====================================================================
// §128: employer contributions to Trump accounts (new section)
// =====================================================================

pub entity TrumpAccountContributionProgram {
    label en unofficial "a separate written plan of an employer for the exclusive benefit of its employees to provide contributions to the Trump accounts of employees or their dependents (section 128(c)); case-asserted";
}
relation employer_trump_account_contribution(employee: Individual, y: TaxableYear, program: TrumpAccountContributionProgram, amount: Money) kind empirical {
    label en official "an amount paid by the employer as a contribution to the Trump account of the employee or of a dependent of the employee, pursuant to the program (section 128(a))";
}
relation program_meets_129d_similar_requirements(program: TrumpAccountContributionProgram) kind empirical {
    label en official "the program meets requirements similar to the requirements of paragraphs (2), (3), (6), (7), and (8) of section 129(d) (section 128(c)); this package's section 129(d) tests are per program and year for dependent care, so the outcome is a case fact";
}
pub relation trump_account_contribution_excluded_128(employee: Individual, y: TaxableYear, program: TrumpAccountContributionProgram, amount: Money) kind institutional {
    label en official "the employer contribution excluded from the employee's gross income, limited to $2,500 (unindexed figure, taxable years beginning after December 31, 2025 and before January 1, 2028)";
}
@source(us.irc.temporal::PL119_21_S70204, relation = formalizes, coverage = exact, quote = "Gross income of an employee does not include amounts paid by the employer as a contribution to the Trump account of such employee or of any dependent of such employee if the amounts are paid or incurred pursuant to a program which is described in subsection (c).")
@source(us.irc.temporal::PL119_21_S70204, relation = formalizes, coverage = exact, quote = "The amount which may be excluded under subsection (a) with respect to any employee shall not exceed $2,500.")
rule TrumpAccountEmployerContributionExcluded(employee: Individual, y: TaxableYear, program: TrumpAccountContributionProgram, amount: Money, b_start: Date) strict {
    label en official "section 128(a)-(c): exclusion up to $2,500 per employee; the (b)(2) indexation applies to taxable years beginning after 2027, whose adjusted figure is a SOURCE_GAP, so this rule stops at the last unindexed year";
    when employer_trump_account_contribution(employee, y, program, amount);
    when program_meets_129d_similar_requirements(program);
    when us.irc.core::begins(y, b_start);
    when b_start >= @2026-01-01;
    when b_start < @2028-01-01;
    then trump_account_contribution_excluded_128(employee, y, program, min(amount, 2500.00 USD));
}

// =====================================================================
// §139J: certain contributions to Trump accounts (new section)
// =====================================================================

relation qualified_general_contribution_to_trump_account(beneficiary: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "a qualified general contribution (a term of section 530A, EXTERNAL_DEPENDENCY: section 530A is owned by another package) to a Trump account of the account beneficiary";
}
pub relation trump_account_general_contribution_excluded_139J(beneficiary: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the qualified general contribution excluded from the account beneficiary's gross income";
}
@source(us.irc.temporal::PL119_21_S70204, relation = formalizes, coverage = exact, quote = "Gross income of an account beneficiary shall not include any qualified general contribution to a Trump account of the account beneficiary.")
rule TrumpAccountGeneralContributionExcluded(beneficiary: Individual, y: TaxableYear, amount: Money, b_start: Date) strict {
    label en official "section 139J(a), taxable years beginning after December 31, 2025";
    when qualified_general_contribution_to_trump_account(beneficiary, y, amount);
    when us.irc.core::begins(y, b_start);
    when b_start >= @2026-01-01;
    then trump_account_general_contribution_excluded_139J(beneficiary, y, amount);
}

// =====================================================================
// §68 as replaced by Pub. L. 119-21 §70111 (taxable years beginning after 2025)
// =====================================================================
//
// The pinned enacted text is now in `us.irc.temporal` (PL119_21_S70111), so the
// stage-1 SOURCE_GAP on the replacement formula is closed for the formula
// itself. The dollar amount at which the 37 percent bracket begins is a
// Rev. Proc. figure of section 1(j); it enters as a case fact (no value is
// invented here).

relation taxable_income_before_68(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "taxable income of the taxpayer for the year determined without regard to section 68 (section 68(a)(2))";
}
relation bracket_37_percent_begins_at(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the dollar amount at which the 37 percent rate bracket under section 1 begins with respect to the taxpayer (section 68(a)(2)); an indexed figure — a case fact until the section 1(j) datasets of income-individual expose it";
}
@source(us.irc.temporal::PL119_21_S70111, relation = formalizes, coverage = exact, quote = "the amount of the itemized deductions otherwise allowable for the taxable year (determined without regard to this section) shall be reduced by 2⁄37 of the lesser of—")
@source(us.irc.temporal::PL119_21_S70111, relation = formalizes, coverage = exact, quote = "This section shall be applied after the application of any other limitation on the allowance of any itemized deduction.")
rule OverallLimitationReductionFrom2026(p: Individual, y: TaxableYear, itemized: Money, ti: Money, threshold: Money) strict {
    label en official "section 68(a) as amended: reduce itemized deductions (after every other limitation) by 2/37 of the lesser of (1) the itemized deductions or (2) so much of taxable income (without regard to section 68, increased by the itemized deductions) as exceeds the 37 percent bracket threshold";
    effective [@2026-01-01, infinity);
    when itemized_deductions_total(p, y, itemized);
    when taxable_income_before_68(p, y, ti);
    when bracket_37_percent_begins_at(p, y, threshold);
    then itemized_deductions_reduced_amount(p, y, round((2 / 37) * min(itemized, max(0.00 USD, (ti + itemized) - threshold)), 2, "HALF_UP"));
}

// =====================================================================
// §151(d)(5) as amended by Pub. L. 119-21 §70103
// =====================================================================

@source(us.irc.temporal::PL119_21_S70103, relation = formalizes, coverage = exact, quote = "by striking “, and before January 1, 2026”")
rule BaseExemptionAmountZeroFrom2026(y: TaxableYear, ind: Individual, s: us.irc.income_individual::FilingStatus) strict {
    label en official "section 151(d)(5) as amended: the sunset words are struck, so the exemption amount stays zero for taxable years beginning after December 31, 2025";
    effective [@2026-01-01, infinity);
    when us.irc.income_individual::filing_status(ind, y, s);
    then base_exemption_amount_151(y, 0.00 USD);
}
relation taxpayer_attained_age_65_by_close(p: Individual, y: TaxableYear) kind empirical {
    label en official "the taxpayer has attained age 65 before the close of the taxable year (section 151(d)(5)(C)(ii)(I))";
}
relation joint_return_spouse_attained_age_65_by_close(p: Individual, y: TaxableYear) kind empirical {
    label en official "in the case of a joint return, the taxpayer's spouse has attained age 65 before the close of the taxable year (section 151(d)(5)(C)(ii)(II))";
}
relation income_excluded_under_911_931_933(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "amounts excluded from gross income under section 911, 931, or 933 (section 151(d)(5)(C)(iii)(II))";
}
relation senior_ssn_included_on_return(p: Individual, y: TaxableYear) kind empirical {
    label en official "the taxpayer includes each qualified individual's social security number (section 24(h)(7)) on the return (section 151(d)(5)(C)(iv))";
}
relation senior_deduction_per_individual_151d5C(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the $6,000 amount reduced (not below zero) by 6 percent of the excess of modified adjusted gross income over $75,000 ($150,000 on a joint return)";
}
@source(us.irc.temporal::PL119_21_S70103, relation = formalizes, coverage = exact, quote = "the $6,000 amount in clause (i) shall be reduced (but not below zero) by 6 percent of so much of the taxpayer’s modified adjusted gross income as exceeds $75,000 ($150,000 in the case of a joint return).")
rule SeniorDeductionPerIndividualJoint(p: Individual, y: TaxableYear, agi: Money, excluded: Money, b_start: Date) strict {
    label en official "section 151(d)(5)(C)(iii): joint return, threshold $150,000; taxable years beginning after December 31, 2024 and before January 1, 2029";
    when adjusted_gross_income(p, y, agi);
    when income_excluded_under_911_931_933(p, y, excluded);
    when us.irc.income_individual::filing_status(p, y, us.irc.income_individual::Joint);
    when us.irc.core::begins(y, b_start);
    when b_start >= @2025-01-01;
    when b_start < @2029-01-01;
    then senior_deduction_per_individual_151d5C(p, y, max(0.00 USD, round(6000.00 USD - 0.06 * max(0.00 USD, (agi + excluded) - 150000.00 USD), 2, "HALF_UP")));
}
@source(us.irc.temporal::PL119_21_S70103, relation = formalizes, coverage = exact, quote = "the $6,000 amount in clause (i) shall be reduced (but not below zero) by 6 percent of so much of the taxpayer’s modified adjusted gross income as exceeds $75,000 ($150,000 in the case of a joint return).")
rule SeniorDeductionPerIndividualOther(p: Individual, y: TaxableYear, agi: Money, excluded: Money, b_start: Date, s: us.irc.income_individual::FilingStatus) strict {
    label en official "section 151(d)(5)(C)(iii): other than a joint return, threshold $75,000 (a married individual filing separately is excluded by (v) and gets no deduction)";
    when adjusted_gross_income(p, y, agi);
    when income_excluded_under_911_931_933(p, y, excluded);
    when us.irc.income_individual::filing_status(p, y, s);
    when s != us.irc.income_individual::Joint;
    when s != us.irc.income_individual::MarriedSeparate;
    when us.irc.core::begins(y, b_start);
    when b_start >= @2025-01-01;
    when b_start < @2029-01-01;
    then senior_deduction_per_individual_151d5C(p, y, max(0.00 USD, round(6000.00 USD - 0.06 * max(0.00 USD, (agi + excluded) - 75000.00 USD), 2, "HALF_UP")));
}
pub relation senior_deduction_151d5C(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the deduction for seniors: the per-individual amount for each qualified individual (taxpayer aged 65 and, on a joint return, the spouse aged 65), social security numbers included";
}
@source(us.irc.temporal::PL119_21_S70103, relation = formalizes, coverage = exact, quote = "there shall be allowed a deduction in an amount equal to $6,000 for each qualified individual with respect to the taxpayer.")
rule SeniorDeductionOneQualifiedIndividual(p: Individual, y: TaxableYear, per_individual: Money) strict {
    label en official "section 151(d)(5)(C)(i)-(ii), exactly one qualified individual";
    when senior_deduction_per_individual_151d5C(p, y, per_individual);
    when senior_ssn_included_on_return(p, y);
    when taxpayer_attained_age_65_by_close(p, y);
    when not_known(joint_return_spouse_attained_age_65_by_close(p, y));
    then senior_deduction_151d5C(p, y, per_individual);
}
rule SeniorDeductionSpouseOnlyQualifiedIndividual(p: Individual, y: TaxableYear, per_individual: Money) strict {
    label en official "section 151(d)(5)(C)(ii)(II): only the spouse (joint return) has attained 65";
    when senior_deduction_per_individual_151d5C(p, y, per_individual);
    when senior_ssn_included_on_return(p, y);
    when joint_return_spouse_attained_age_65_by_close(p, y);
    when not_known(taxpayer_attained_age_65_by_close(p, y));
    then senior_deduction_151d5C(p, y, per_individual);
}
rule SeniorDeductionTwoQualifiedIndividuals(p: Individual, y: TaxableYear, per_individual: Money) strict {
    label en official "section 151(d)(5)(C)(ii)(I)-(II): both spouses have attained 65 on a joint return";
    when senior_deduction_per_individual_151d5C(p, y, per_individual);
    when senior_ssn_included_on_return(p, y);
    when taxpayer_attained_age_65_by_close(p, y);
    when joint_return_spouse_attained_age_65_by_close(p, y);
    then senior_deduction_151d5C(p, y, round(2 * per_individual, 2, "HALF_UP"));
}
