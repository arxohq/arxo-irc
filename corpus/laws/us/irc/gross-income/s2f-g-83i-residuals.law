// Stage 2f (TECH_GAP reduction) — §83(i): qualified equity grants, definitions, deferral end,
// restrictions on the election, notice and reporting duties, restricted stock units.
// STATUS: implemented_unverified (static check only; scenarios in tests/s2f-g-83i-residuals.lawtest
// are NOT executed).
//
// Judgment calls recorded in the coverage rows: the employee's taxable year is found through a
// case fact naming the year that contains the deferral end date (there is no year extraction
// from a date in the language); the 80 percent test of (i)(2)(C) is fed the share already
// computed without the employees of (C)(iii); the dollar amount of deferral stock purchased is
// fed already net of purchases excluded by (C)(ii).

use self::{
    IRC_S83_I,
    Person,
    Secretary,
    TaxableYear,
};

// (i)(3)(B): excluded employees
relation excluded_employee_facts_83i3B(p: Person, corporation: Person, one_percent_owner_this_year_or_prior_10: Boolean, ceo_or_cfo_at_any_time: Boolean, related_under_318a1_to_ceo_or_cfo: Boolean, top_4_compensated_this_year_or_prior_10: Boolean) kind empirical {
    label en official "the individual is a 1-percent owner (section 416(i)(1)(B)(ii)) at any time in the calendar year or the 10 preceding calendar years, is or has been the chief executive officer or chief financial officer (or acting as such), bears a relationship described in section 318(a)(1) to such an officer, or is (or was in any of the 10 preceding taxable years) one of the 4 highest compensated officers on the basis of the shareholder disclosure rules";
}
pub relation excluded_employee_83i3B(p: Person, corporation: Person) kind institutional {
    label en official "an excluded employee of the corporation";
}
@source(IRC_S83_I, relation = formalizes, coverage = exact, quote = "(i) who is a 1-percent owner (within the meaning of section 416(i)(1)(B)(ii)) at any time during the calendar year or who was such a 1 percent owner at any time during")
rule ExcludedEmployeeOnePercentOwner(p: Person, corp: Person, b: Boolean, c: Boolean, d: Boolean) strict {
    label en official "section 83(i)(3)(B)(i)";
    when excluded_employee_facts_83i3B(p, corp, true, b, c, d);
    then excluded_employee_83i3B(p, corp);
}
@source(IRC_S83_I, relation = formalizes, coverage = exact, quote = "(ii) who is or has been at any prior time—")
rule ExcludedEmployeeChiefOfficer(p: Person, corp: Person, a: Boolean, c: Boolean, d: Boolean) strict {
    label en official "section 83(i)(3)(B)(ii)(I)-(II)";
    when excluded_employee_facts_83i3B(p, corp, a, true, c, d);
    then excluded_employee_83i3B(p, corp);
}
@source(IRC_S83_I, relation = formalizes, coverage = exact, quote = "(iii) who bears a relationship described in section 318(a)(1) to any individual described in subclause (I) or (II) of clause (ii), or")
rule ExcludedEmployeeRelatedToChiefOfficer(p: Person, corp: Person, a: Boolean, b: Boolean, d: Boolean) strict {
    label en official "section 83(i)(3)(B)(iii)";
    when excluded_employee_facts_83i3B(p, corp, a, b, true, d);
    then excluded_employee_83i3B(p, corp);
}
@source(IRC_S83_I, relation = formalizes, coverage = exact, quote = "(iv) who is one of the 4 highest compensated officers of such corporation for the taxable year, or was one of the 4 highest compensated officers of such corporation for")
rule ExcludedEmployeeTopFourCompensated(p: Person, corp: Person, a: Boolean, b: Boolean, c: Boolean) strict {
    label en official "section 83(i)(3)(B)(iv)";
    when excluded_employee_facts_83i3B(p, corp, a, b, c, true);
    then excluded_employee_83i3B(p, corp);
}
relation employee_election_undertaking_83i3A(p: Person, corporation: Person, agrees_to_meet_withholding_requirements_set_by_secretary: Boolean) kind empirical {
    label en official "the individual agrees in the election to meet the requirements the Secretary determines necessary to ensure the corporation's chapter 24 withholding on the qualified stock is met";
}
pub relation qualified_employee_83i3A(p: Person, corporation: Person) kind institutional {
    label en official "a qualified employee: not an excluded employee, and agrees in the election to the withholding requirements";
}
@source(IRC_S83_I, relation = formalizes, coverage = exact, quote = "The term \"qualified employee\" means any individual who—")
rule QualifiedEmployeeDefined(p: Person, corp: Person) strict {
    label en official "section 83(i)(3)(A)(i)-(ii)";
    when employee_election_undertaking_83i3A(p, corp, true);
    when not_known(excluded_employee_83i3B(p, corp));
    then qualified_employee_83i3A(p, corp);
}

// (i)(2)(C): eligible corporation
relation eligible_corporation_facts_83i2C(corporation: Person, calendar_year: Integer, stock_readily_tradable_in_a_preceding_year: Boolean, written_plan_exists: Boolean, share_of_us_employees_granted: Decimal, same_rights_and_privileges: Boolean) kind empirical {
    label en official "no stock of the corporation (or a predecessor) was readily tradable on an established securities market in a preceding calendar year, the corporation has a written plan under which in the calendar year at least 80 percent of all employees providing services in the United States (or a possession), other than the employees of (C)(iii), are granted options or RSUs with the same rights and privileges (the rights of an option and an RSU are not the same, (C)(ii)(III); unequal share numbers above de minimis do not matter, (C)(ii)(II)), and the share of employees granted";
}
pub relation eligible_corporation_83i2C(corporation: Person, calendar_year: Integer) kind institutional {
    label en official "an eligible corporation for the calendar year";
}
@source(IRC_S83_I, relation = formalizes, coverage = exact, quote = "The term \"eligible corporation\" means, with respect to any calendar year, any corporation if—")
rule EligibleCorporationFrom2018(corp: Person, year: Integer, share: Decimal) strict {
    label en official "section 83(i)(2)(C)(i)(I)-(II) with (ii): same rights required";
    when eligible_corporation_facts_83i2C(corp, year, false, true, share, true);
    when share >= 0.80;
    then eligible_corporation_83i2C(corp, year);
}
@source(IRC_S83_I, relation = formalizes, coverage = exact, quote = "In the case of any calendar year beginning before January 1, 2018, clause (i)(II) shall be applied without regard to whether the rights and privileges with respect to")
rule EligibleCorporationBefore2018(corp: Person, year: Integer, share: Decimal, same: Boolean) strict {
    label en official "section 83(i)(2)(C)(iv): before 2018 clause (i)(II) is applied without regard to sameness of rights";
    when eligible_corporation_facts_83i2C(corp, year, false, true, share, same);
    when year < 2018;
    when share >= 0.80;
    then eligible_corporation_83i2C(corp, year);
}

// (i)(2): qualified stock
relation qualified_stock_facts_83i2(stock: us.irc.core::Asset, employee: Person, corporation: Person, received_on_option_exercise: Boolean, received_on_rsu_settlement: Boolean, grant_in_connection_with_services_as_employee: Boolean, grant_calendar_year: Integer, employee_may_sell_or_take_cash_in_lieu_at_first_transferability: Boolean) kind empirical {
    label en official "the stock of the employer corporation, how it was received (option exercise or RSU settlement), that the option or RSU was granted in connection with services as an employee, the calendar year of grant, and whether the employee may sell the stock to the corporation or receive cash in lieu when the rights first become transferable or not subject to a substantial risk of forfeiture";
}
pub relation qualified_stock_83i2(stock: us.irc.core::Asset, employee: Person) kind institutional {
    label en official "qualified stock of a qualified employee";
}
@source(IRC_S83_I, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, the term \"qualified stock\" means, with respect to any qualified employee, any stock in a corporation which is the employer of such")
rule QualifiedStockByOption(stock: us.irc.core::Asset, employee: Person, corp: Person, rsu: Boolean, services: Boolean, gy: Integer) strict {
    label en official "section 83(i)(2)(A)(i)(I), (ii), and (B)";
    when qualified_stock_facts_83i2(stock, employee, corp, true, rsu, true, gy, false);
    when qualified_employee_83i3A(employee, corp);
    when eligible_corporation_83i2C(corp, gy);
    then qualified_stock_83i2(stock, employee);
}
@source(IRC_S83_I, relation = formalizes, coverage = exact, quote = "(II) in settlement of a restricted stock unit, and")
rule QualifiedStockByRsuSettlement(stock: us.irc.core::Asset, employee: Person, corp: Person, opt: Boolean, services: Boolean, gy: Integer) strict {
    label en official "section 83(i)(2)(A)(i)(II), (ii), and (B)";
    when qualified_stock_facts_83i2(stock, employee, corp, opt, true, true, gy, false);
    when qualified_employee_83i3A(employee, corp);
    when eligible_corporation_83i2C(corp, gy);
    then qualified_stock_83i2(stock, employee);
}

// (i)(1)(B): the taxable year of inclusion
relation deferral_dates_83i1B(p: Person, stock: us.irc.core::Asset, first_transferable: Date, first_not_subject_to_forfeiture_risk: Date, became_excluded_employee: Date, first_readily_tradable: Date, revoked_election: Date) kind empirical {
    label en official "the dates of the five limbs: the first date the stock becomes transferable, the first date the rights are not subject to a substantial risk of forfeiture, the date the employee first becomes an excluded employee, the first date any stock of the issuing corporation becomes readily tradable on an established securities market, and the date the election is revoked (the far-future date 9999-12-31 for a limb that does not occur)";
}
pub relation deferral_end_candidate_83i1B(p: Person, stock: us.irc.core::Asset, on: Date) kind institutional {
    label en official "a date of clauses (i)-(v) of section 83(i)(1)(B)";
}
@source(IRC_S83_I, relation = formalizes, coverage = exact, quote = "(i) the first date such qualified stock becomes transferable (including, solely for purposes of this clause, becoming transferable to the employer),")
rule DeferralEndCandidateTransferable(p: Person, stock: us.irc.core::Asset, t: Date, f: Date, e: Date, m: Date, r: Date) strict {
    label en official "section 83(i)(1)(B)(i)";
    when deferral_dates_83i1B(p, stock, t, f, e, m, r);
    then deferral_end_candidate_83i1B(p, stock, t);
}
@source(IRC_S83_I, relation = formalizes, coverage = exact, quote = "(ii) the date the employee first becomes an excluded employee,")
rule DeferralEndCandidateExcludedEmployee(p: Person, stock: us.irc.core::Asset, t: Date, f: Date, e: Date, m: Date, r: Date) strict {
    label en official "section 83(i)(1)(B)(ii)";
    when deferral_dates_83i1B(p, stock, t, f, e, m, r);
    then deferral_end_candidate_83i1B(p, stock, e);
}
@source(IRC_S83_I, relation = formalizes, coverage = exact, quote = "(iii) the first date on which any stock of the corporation which issued the qualified stock becomes readily tradable on an established securities market (as determined")
rule DeferralEndCandidateReadilyTradable(p: Person, stock: us.irc.core::Asset, t: Date, f: Date, e: Date, m: Date, r: Date) strict {
    label en official "section 83(i)(1)(B)(iii)";
    when deferral_dates_83i1B(p, stock, t, f, e, m, r);
    then deferral_end_candidate_83i1B(p, stock, m);
}
@source(IRC_S83_I, relation = formalizes, coverage = exact, quote = "(iv) the date that is 5 years after the first date the rights of the employee in such stock are transferable or are not subject to a substantial risk of forfeiture,")
rule DeferralEndCandidateFiveYears(p: Person, stock: us.irc.core::Asset, t: Date, f: Date, e: Date, m: Date, r: Date) strict {
    label en official "section 83(i)(1)(B)(iv): 5 years after the earlier of the first transferability and the first date not subject to a substantial risk of forfeiture";
    when deferral_dates_83i1B(p, stock, t, f, e, m, r);
    then deferral_end_candidate_83i1B(p, stock, add_calendar_period(min(t, f), 5 calendar_year));
}
@source(IRC_S83_I, relation = formalizes, coverage = exact, quote = "(v) the date on which the employee revokes (at such time and in such manner as the Secretary provides) the election under this subsection with respect to such stock.")
rule DeferralEndCandidateRevocation(p: Person, stock: us.irc.core::Asset, t: Date, f: Date, e: Date, m: Date, r: Date) strict {
    label en official "section 83(i)(1)(B)(v)";
    when deferral_dates_83i1B(p, stock, t, f, e, m, r);
    then deferral_end_candidate_83i1B(p, stock, r);
}
pub relation deferral_end_date_83i1B(p: Person, stock: us.irc.core::Asset, on: Date) kind institutional {
    label en official "the earliest of the dates: the taxable year that includes it is the year of inclusion";
}
@source(IRC_S83_I, relation = formalizes, coverage = exact, quote = "The taxable year determined under this subparagraph is the taxable year of the employee which includes the earliest of—")
rule DeferralEndDateIsTheEarliest(p: Person, stock: us.irc.core::Asset, d: Date) strict {
    label en official "section 83(i)(1)(B): the earliest candidate";
    when deferral_end_candidate_83i1B(p, stock, d);
    when not_known(earlier_deferral_end_candidate_83i1B(p, stock, d));
    then deferral_end_date_83i1B(p, stock, d);
}
pub relation earlier_deferral_end_candidate_83i1B(p: Person, stock: us.irc.core::Asset, than: Date) kind institutional {
    label en official "helper: a candidate strictly earlier than the date exists";
}
rule EarlierDeferralEndCandidate(p: Person, stock: us.irc.core::Asset, d: Date, e: Date) strict {
    label en official "helper for section 83(i)(1)(B)";
    when deferral_end_candidate_83i1B(p, stock, d);
    when deferral_end_candidate_83i1B(p, stock, e);
    when e < d;
    then earlier_deferral_end_candidate_83i1B(p, stock, d);
}
relation taxable_year_contains_date_83i(p: Person, y: TaxableYear, d: Date) kind empirical {
    label en official "the employee's taxable year contains the date (a case fact: the language has no year extraction from a date)";
}
pub relation deferred_income_taxable_year_83i1B(p: Person, stock: us.irc.core::Asset, y: TaxableYear) kind institutional {
    label en official "the taxable year in which the deferred income is includible";
}
@source(IRC_S83_I, relation = formalizes, coverage = exact, quote = "The taxable year determined under this subparagraph is the taxable year of the employee which includes the earliest of—")
rule DeferredIncomeTaxableYear(p: Person, stock: us.irc.core::Asset, d: Date, y: TaxableYear) strict {
    label en official "section 83(i)(1)(B)";
    when deferral_end_date_83i1B(p, stock, d);
    when taxable_year_contains_date_83i(p, y, d);
    then deferred_income_taxable_year_83i1B(p, stock, y);
}

// (i)(4)(B), (C): no election
relation election_bar_facts_83i4B(p: Person, stock: us.irc.core::Asset, made_section_83b_election: Boolean, stock_readily_tradable_before_election: Boolean, corporation_purchased_its_stock_in_preceding_year: Boolean, deferral_stock_share_of_purchases: Decimal, deferral_stock_purchase_on_reasonable_basis: Boolean, purchases_include_all_outstanding_deferral_stock: Boolean) kind empirical {
    label en official "whether the employee made a section 83(b) election for the stock, whether any stock of the issuer was readily tradable before the election, whether the corporation purchased its outstanding stock in the calendar year before the one with the first date the rights are transferable or not subject to a substantial risk of forfeiture, the share of the dollar amount purchased that is deferral stock, whether the individuals sold from were chosen on a reasonable basis, and whether the purchases include all outstanding deferral stock";
}
pub relation election_barred_83i4B(p: Person, stock: us.irc.core::Asset) kind institutional {
    label en official "no election may be made under subsection (i) for the stock";
}
@source(IRC_S83_I, relation = formalizes, coverage = exact, quote = "(i) the qualified employee has made an election under subsection (b) with respect to such qualified stock,")
rule ElectionBarredBy83bElection(p: Person, stock: us.irc.core::Asset, t: Boolean, buy: Boolean, share: Decimal, rb: Boolean, all: Boolean) strict {
    label en official "section 83(i)(4)(B)(i)";
    when election_bar_facts_83i4B(p, stock, true, t, buy, share, rb, all);
    then election_barred_83i4B(p, stock);
}
@source(IRC_S83_I, relation = formalizes, coverage = exact, quote = "(ii) any stock of the corporation which issued the qualified stock is readily tradable on an established securities market (as determined under paragraph (1)(B)(iii)) at")
rule ElectionBarredByTradability(p: Person, stock: us.irc.core::Asset, b: Boolean, buy: Boolean, share: Decimal, rb: Boolean, all: Boolean) strict {
    label en official "section 83(i)(4)(B)(ii)";
    when election_bar_facts_83i4B(p, stock, b, true, buy, share, rb, all);
    then election_barred_83i4B(p, stock);
}
@source(IRC_S83_I, relation = formalizes, coverage = exact, quote = "(iii) such corporation purchased any of its outstanding stock in the calendar year preceding the calendar year which includes the first date the rights of the employee")
rule ElectionBarredByRepurchaseWithoutDeferralStock(p: Person, stock: us.irc.core::Asset, b: Boolean, t: Boolean, share: Decimal, rb: Boolean, all: Boolean) strict {
    label en official "section 83(i)(4)(B)(iii): the purchase is not saved by (I)-(II) or by (C)(iii)";
    when election_bar_facts_83i4B(p, stock, b, t, true, share, rb, all);
    when not_known(repurchase_exception_met_83i4B(p, stock));
    then election_barred_83i4B(p, stock);
}
pub relation repurchase_exception_met_83i4B(p: Person, stock: us.irc.core::Asset) kind institutional {
    label en official "at least 25 percent of the dollar amount purchased is deferral stock and the individuals were chosen on a reasonable basis, or the purchase includes all outstanding deferral stock";
}
@source(IRC_S83_I, relation = formalizes, coverage = exact, quote = "(I) not less than 25 percent of the total dollar amount of the stock so purchased is deferral stock, and")
rule RepurchaseExceptionMetByShare(p: Person, stock: us.irc.core::Asset, b: Boolean, t: Boolean, buy: Boolean, share: Decimal, all: Boolean) strict {
    label en official "section 83(i)(4)(B)(iii)(I)-(II)";
    when election_bar_facts_83i4B(p, stock, b, t, buy, share, true, all);
    when share >= 0.25;
    then repurchase_exception_met_83i4B(p, stock);
}
@source(IRC_S83_I, relation = formalizes, coverage = exact, quote = "The requirements of subclauses (I) and (II) of subparagraph (B)(iii) shall be treated as met if the stock so purchased includes all of the corporation's outstanding")
rule RepurchaseExceptionMetByAllDeferralStock(p: Person, stock: us.irc.core::Asset, b: Boolean, t: Boolean, buy: Boolean, share: Decimal, rb: Boolean) strict {
    label en official "section 83(i)(4)(C)(iii)";
    when election_bar_facts_83i4B(p, stock, b, t, buy, share, rb, true);
    then repurchase_exception_met_83i4B(p, stock);
}
relation election_in_effect_for_stock_83i4Ci(stock: us.irc.core::Asset) kind empirical {
    label en official "an election under subsection (i) is in effect for the stock";
}
pub relation deferral_stock_83i4Ci(stock: us.irc.core::Asset) kind institutional {
    label en official "deferral stock: stock with respect to which an election is in effect under subsection (i)";
}
@source(IRC_S83_I, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the term \"deferral stock\" means stock with respect to which an election is in effect under this subsection.")
rule DeferralStockDefined(stock: us.irc.core::Asset) strict {
    label en official "section 83(i)(4)(C)(i)";
    when election_in_effect_for_stock_83i4Ci(stock);
    then deferral_stock_83i4Ci(stock);
}
relation buyback_reporting_facts_83i4Civ(corporation: Person, calendar_year: Integer, has_outstanding_deferral_stock_at_start: Boolean, purchased_outstanding_stock_during_year: Boolean, year_start: Date, return_due_date: Date) kind empirical {
    label en official "the corporation had outstanding deferral stock at the beginning of the calendar year and purchased outstanding stock during it, the beginning of the year, and the due date of its return for the taxable year in which the calendar year ends";
}
relation buyback_amount_reported_83i4Civ(corporation: Person, calendar_year: Integer) kind empirical {
    label en official "the corporation included on its return the total dollar amount of the outstanding stock so purchased and the information the Secretary requires";
}
@source(IRC_S83_I, relation = formalizes, coverage = exact, quote = "Any corporation which has outstanding deferral stock as of the beginning of any calendar year and which purchases any of its outstanding stock during such calendar year")
rule Section83i4CivReportingDutyRule strict {
    for corp: Person;
    for year: Integer;
    for start: Date;
    for due: Date;
    when buyback_reporting_facts_83i4Civ(corp, year, true, true, start, due);
    then duty Section83i4CivReportingDuty {
        bearer corp;
        beneficiary Secretary;
        goal achievement {
            condition buyback_amount_reported_83i4Civ(corp, year);
            window [start, due];
        }
    };
}

// (i)(5), (6), (7)
relation controlled_group_member_83i5(corporation: Person, group_treated_as_one: Person, section_414b_single_employer: Boolean) kind empirical {
    label en official "the corporation is treated as a single employer with the others under section 414(b)";
}
pub relation treated_as_one_corporation_83i5(corporation: Person, group: Person) kind institutional {
    label en official "all persons treated as a single employer under section 414(b) are treated as 1 corporation for subsection (i)";
}
@source(IRC_S83_I, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, all persons treated as a single employer under section 414(b) shall be treated as 1 corporation.")
rule ControlledGroupTreatedAsOneCorporation(corp: Person, group: Person) strict {
    label en official "section 83(i)(5)";
    when controlled_group_member_83i5(corp, group, true);
    then treated_as_one_corporation_83i5(corp, group);
}
relation qualified_stock_transfer_83i6(corporation: Person, employee: Person, stock: us.irc.core::Asset, first_includible_date: Date, window_start: Date) kind empirical {
    label en official "the corporation transfers qualified stock to a qualified employee; the date an amount attributable to the stock would (but for the subsection) first be includible in the employee's gross income, and the earliest a reasonable period before it";
}
relation certification_and_notice_given_83i6(corporation: Person, employee: Person, stock: us.irc.core::Asset) kind empirical {
    label en official "the corporation certified to the employee that the stock is qualified stock and notified the employee of (B)(i), (ii)(I)-(III)";
}
@source(IRC_S83_I, relation = formalizes, coverage = exact, quote = "Any corporation which transfers qualified stock to a qualified employee shall, at the time that (or a reasonable period before) an amount attributable to such stock")
rule Section83i6CertificationDutyRule strict {
    for corp: Person;
    for employee: Person;
    for stock: us.irc.core::Asset;
    for first: Date;
    for start: Date;
    when qualified_stock_transfer_83i6(corp, employee, stock, first, start);
    then duty Section83i6CertificationAndNoticeDuty {
        bearer corp;
        beneficiary employee;
        goal achievement {
            condition certification_and_notice_given_83i6(corp, employee, stock);
            window [start, first];
        }
    };
}
relation is_restricted_stock_unit_83i7(asset: us.irc.core::Asset) kind empirical {
    label en official "the property is a restricted stock unit";
}
pub relation section_83_not_applicable_to_rsu_83i7(asset: us.irc.core::Asset) kind institutional {
    label en official "section 83 (other than subsection (i)), including any election under subsection (b), does not apply to restricted stock units";
}
@source(IRC_S83_I, relation = formalizes, coverage = exact, quote = "This section (other than this subsection), including any election under subsection (b), shall not apply to restricted stock units.")
rule Section83NotApplicableToRestrictedStockUnits(asset: us.irc.core::Asset) strict {
    label en official "section 83(i)(7)";
    when is_restricted_stock_unit_83i7(asset);
    then section_83_not_applicable_to_rsu_83i7(asset);
}
