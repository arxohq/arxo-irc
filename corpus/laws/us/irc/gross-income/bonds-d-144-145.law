// Stage 2f (TECH_GAP reduction) — private activity bonds, fourth part: section 144(a)(2)-(12)
// (the conditions and bars of a qualified small issue bond), (b) qualified student loan
// bonds, (c) qualified redevelopment bonds, and section 145(b), (d), (e) (qualified
// 501(c)(3) bonds). STATUS: implemented_unverified (static check only; scenarios in
// tests/bonds-d-144-145.lawtest are NOT executed).
//
// The earlier rule `QualifiedSmallIssueBondClassified` reads the aggregate face amount
// derived here, the limit ($1,000,000 or $10,000,000 on election) and the absence of the
// bars of (a)(5), (7), (8), (10), (11) and the termination rule of (a)(12); the earlier
// scenarios S144-01 and S144-02 were extended with the issue date and the manufacturing
// facility facts accordingly.

// =====================================================================
// §144(a)(3): related persons
// =====================================================================

use self::{
    BondIssue,
    IRC_S144_A,
    IRC_S144_B,
    IRC_S144_C,
    IRC_S145_B,
    IRC_S145_D,
    IRC_S145_E,
    Person,
    ResidentialRentalProject142,
    issue_authorized_face_amount,
    project_of_issue_142d,
    qualified_bond_category_141e1,
    qualified_residential_rental_project_142d1,
};

relation relationship_disallows_losses_267_707b_144a3A(a: Person, b: Person) kind empirical {
    label en official "the relationship between the persons would result in a disallowance of losses under section 267 or 707(b)";
}
relation members_of_controlled_group_over_50_percent_144a3B(a: Person, b: Person) kind empirical {
    label en official "the persons are members of the same controlled group of corporations (section 1563(a), with more than 50 percent in place of at least 80 percent)";
}
relation related_persons_base_144a3(a: Person, b: Person) kind institutional {
    label en official "helper: the pair is related in the asserted direction";
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "(A) the relationship between such persons would result in a disallowance of losses under section 267 or 707(b), or")
rule RelatedPersonsBaseByLossDisallowance(a: Person, b: Person) strict {
    label en official "section 144(a)(3)(A)";
    when relationship_disallows_losses_267_707b_144a3A(a, b);
    then related_persons_base_144a3(a, b);
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "(B) such persons are members of the same controlled group of corporations (as defined in section 1563(a), except that \"more than 50 percent\" shall be substituted for \"at")
rule RelatedPersonsBaseByControlledGroup(a: Person, b: Person) strict {
    label en official "section 144(a)(3)(B)";
    when members_of_controlled_group_over_50_percent_144a3B(a, b);
    then related_persons_base_144a3(a, b);
}
pub relation related_persons_144a3(a: Person, b: Person) kind institutional {
    label en official "the persons are related persons within section 144(a)(3), in either order";
}
rule RelatedPersonsForward(a: Person, b: Person) strict {
    label en official "section 144(a)(3), asserted order";
    when related_persons_base_144a3(a, b);
    then related_persons_144a3(a, b);
}
rule RelatedPersonsBackward(a: Person, b: Person) strict {
    label en official "section 144(a)(3): the relationship is symmetric";
    when related_persons_base_144a3(a, b);
    then related_persons_144a3(b, a);
}

// =====================================================================
// §144(a)(2), (4): prior issues and capital expenditures
// =====================================================================

relation small_issue_prior_issue_144a2(issue: BondIssue, prior: BondIssue, face_of_tax_exempt_bonds: Money, outstanding_at_later_issue: Boolean, redeemed_from_later_proceeds_other_than_advance: Boolean, same_municipality_or_county: Boolean, same_or_related_principal_user: Boolean, would_be_144a1_issue: Boolean) kind empirical {
    label en official "a prior issue with the aggregate face amount of its tax-exempt bonds, whether it is outstanding at the time of the later issue, whether its bond is to be redeemed (other than in an advance refunding) from the later issue's net proceeds, whether its proceeds are used primarily for facilities in the same incorporated municipality (or same county outside any), whether the principal user is the same person or related persons, and whether paragraph (1) would apply to it";
}
relation has_prior_small_issue_144a2(issue: BondIssue) kind institutional {
    label en official "helper: a prior issue is recorded";
}
rule HasPriorSmallIssue(issue: BondIssue, prior: BondIssue, f: Money, o: Boolean, r: Boolean, s: Boolean, u: Boolean, w: Boolean) strict {
    label en official "helper for the not_known test";
    when small_issue_prior_issue_144a2(issue, prior, f, o, r, s, u, w);
    then has_prior_small_issue_144a2(issue);
}
pub relation prior_issues_face_taken_into_account_144a2(issue: BondIssue, amount: Money) kind institutional {
    label en official "the aggregate face amount of tax-exempt bonds under all prior such issues that are outstanding at the time of the later issue (a bond to be redeemed other than in an advance refunding from the later issue's net proceeds is not outstanding)";
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "then, for purposes of paragraph (1), in determining the aggregate face amount of any later issue there shall be taken into account the aggregate face amount of")
rule PriorIssuesFaceTakenIntoAccount(issue: BondIssue, p0: BondIssue, f0: Money, o0: Boolean, r0: Boolean, s0: Boolean, u0: Boolean, w0: Boolean) strict {
    label en official "section 144(a)(2)(A)-(C): only prior issues in the same place, with the same or related principal user, to which paragraph (1) would apply";
    when small_issue_prior_issue_144a2(issue, p0, f0, o0, r0, s0, u0, w0);
    then prior_issues_face_taken_into_account_144a2(issue, sum(collect all f: Money, p: BondIssue, o: Boolean, r: Boolean, s: Boolean, u: Boolean, w: Boolean where small_issue_prior_issue_144a2(issue, p, f, o, r, s, u, w) and o == true and r == false and s == true and u == true and w == true, empty: 0.00 USD));
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "then, for purposes of paragraph (1), in determining the aggregate face amount of any later issue there shall be taken into account the aggregate face amount of")
rule PriorIssuesFaceZeroWhenNone(issue: BondIssue, face: Money) strict {
    label en official "section 144(a)(2): nothing to take into account when no prior issue is recorded";
    when issue_authorized_face_amount(issue, face);
    when not_known(has_prior_small_issue_144a2(issue));
    then prior_issues_face_taken_into_account_144a2(issue, 0.00 USD);
}
relation issuer_elects_10_million_limit_144a4A(issue: BondIssue) kind empirical {
    label en official "the issuer elects, with respect to the issue, to apply the subsection with $10,000,000 in place of $1,000,000";
}
pub enum ExpenditureKind144a4C { CasualtyReplacement; LawChangeRequired; UnforeseeableOrMistake; Section174ResearchExpenditure; OrdinaryCapitalExpenditure; }
relation small_issue_capital_expenditure_144a4(issue: BondIssue, item: us.irc.core::Transaction, amount: Money, paid_on: Date, issue_date: Date, in_same_place_same_user_facilities: Boolean, financed_from_outstanding_tax_exempt_proceeds: Boolean, kind: ExpenditureKind144a4C, excluded_portion: Money) kind empirical {
    label en official "a capital expenditure with respect to facilities described in (B) (the same incorporated municipality or county and the same or related principal user, determined as of the date of issue), its amount, the date paid or incurred, the date of the issue in question, whether it was financed out of outstanding tax-exempt issue proceeds, its kind under (C) and the part of it excluded by the kind (the casualty expenditure: up to the fair market value of the property replaced; the law-change and section 174 kinds: all of it; the unforeseeable kind: up to the cap below)";
}
pub relation capital_expenditures_counted_before_g_144a4A(issue: BondIssue, amount: Money) kind institutional {
    label en official "the aggregate amount of the capital expenditures paid or incurred in the 6-year period beginning 3 years before the date of the issue and ending 3 years after it, for the (B) facilities and not financed out of outstanding tax-exempt proceeds, less the excluded parts of (C) (the unforeseeable kind capped at $1,000,000 in the aggregate)";
}
pub relation capex_amount_sum_144a4(issue: BondIssue, amount: Money) kind institutional {
    label en official "helper: the sum of the amounts of the capital expenditures paid or incurred in the 6-year window for the (B) facilities and not financed from outstanding tax-exempt proceeds";
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "(ii) in determining the aggregate face amount of such issue, by taking into account not only the amount described in paragraph (2), but also the aggregate amount of")
rule CapexAmountSum(issue: BondIssue, i0: us.irc.core::Transaction, a0: Money, p0: Date, d0: Date, s0: Boolean, f0: Boolean, k0: ExpenditureKind144a4C, x0: Money, calendar_before_1: Date) strict {
    label en official "section 144(a)(4)(A)(ii), (B): the window runs from 3 years before to 3 years after the date of issue";
    when small_issue_capital_expenditure_144a4(issue, i0, a0, p0, d0, s0, f0, k0, x0)
        and us.irc.core::civil_calendar_boundary_before(d0, 3, us.irc.core::CalendarYear, calendar_before_1);
    then capex_amount_sum_144a4(issue, sum(collect all a: Money, i: us.irc.core::Transaction, p: Date, d: Date, s: Boolean, f: Boolean, k: ExpenditureKind144a4C, x: Money where small_issue_capital_expenditure_144a4(issue, i, a, p, d, s, f, k, x) and s == true and f == false and us.irc.core::civil_calendar_boundary_before(d, 3, us.irc.core::CalendarYear, calendar_before_1) and p >= calendar_before_1 and p <= add_calendar_period(d, 3 calendar_year), empty: 0.00 USD));
}
pub relation capex_excluded_other_sum_144a4(issue: BondIssue, amount: Money) kind institutional {
    label en official "helper: the excluded parts of the expenditures of kinds (i), (ii) and (iv) of subparagraph (C)";
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "(i) to replace property destroyed or damaged by fire, storm, or other casualty, to the extent of the fair market value of the property replaced,")
rule CapexExcludedOtherSum(issue: BondIssue, i0: us.irc.core::Transaction, a0: Money, p0: Date, d0: Date, s0: Boolean, f0: Boolean, k0: ExpenditureKind144a4C, x0: Money, calendar_before_1: Date) strict {
    label en official "section 144(a)(4)(C)(i), (ii), (iv)";
    when small_issue_capital_expenditure_144a4(issue, i0, a0, p0, d0, s0, f0, k0, x0)
        and us.irc.core::civil_calendar_boundary_before(d0, 3, us.irc.core::CalendarYear, calendar_before_1);
    then capex_excluded_other_sum_144a4(issue, sum(collect all x: Money, i: us.irc.core::Transaction, a: Money, p: Date, d: Date, s: Boolean, f: Boolean, k: ExpenditureKind144a4C where small_issue_capital_expenditure_144a4(issue, i, a, p, d, s, f, k, x) and s == true and f == false and us.irc.core::civil_calendar_boundary_before(d, 3, us.irc.core::CalendarYear, calendar_before_1) and p >= calendar_before_1 and p <= add_calendar_period(d, 3 calendar_year) and k != UnforeseeableOrMistake, empty: 0.00 USD));
}
pub relation capex_excluded_unforeseeable_sum_144a4(issue: BondIssue, amount: Money) kind institutional {
    label en official "helper: the excluded parts of the unforeseeable-circumstances expenditures of clause (iii), before the $1,000,000 cap";
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "(iii) required by circumstances which could not be reasonably foreseen on such date of issue or arising out of a mistake of law or fact (but the aggregate amount of")
rule CapexExcludedUnforeseeableSum(issue: BondIssue, i0: us.irc.core::Transaction, a0: Money, p0: Date, d0: Date, s0: Boolean, f0: Boolean, k0: ExpenditureKind144a4C, x0: Money, calendar_before_1: Date) strict {
    label en official "section 144(a)(4)(C)(iii)";
    when small_issue_capital_expenditure_144a4(issue, i0, a0, p0, d0, s0, f0, k0, x0)
        and us.irc.core::civil_calendar_boundary_before(d0, 3, us.irc.core::CalendarYear, calendar_before_1);
    then capex_excluded_unforeseeable_sum_144a4(issue, sum(collect all x: Money, i: us.irc.core::Transaction, a: Money, p: Date, d: Date, s: Boolean, f: Boolean where small_issue_capital_expenditure_144a4(issue, i, a, p, d, s, f, UnforeseeableOrMistake, x) and s == true and f == false and us.irc.core::civil_calendar_boundary_before(d, 3, us.irc.core::CalendarYear, calendar_before_1) and p >= calendar_before_1 and p <= add_calendar_period(d, 3 calendar_year), empty: 0.00 USD));
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "shall not be taken into account.")
rule CapitalExpendituresCounted(issue: BondIssue, gross: Money, other: Money, unforeseeable: Money) strict {
    label en official "section 144(a)(4)(A)(ii) with (C): gross less the excluded parts, the clause (iii) part capped at $1,000,000 in the aggregate";
    when capex_amount_sum_144a4(issue, gross);
    when capex_excluded_other_sum_144a4(issue, other);
    when capex_excluded_unforeseeable_sum_144a4(issue, unforeseeable);
    then capital_expenditures_counted_before_g_144a4A(issue, max(0.00 USD, round(gross - other - min(1000000.00 USD, unforeseeable), 2, "HALF_UP")));
}
relation udag_facilities_144a4F(issue: BondIssue) kind empirical {
    label en official "95 percent or more of the net proceeds are to be used to provide facilities with respect to which an urban development action grant has been made under section 119 of the Housing and Community Development Act of 1974";
}
relation small_issue_date_144a4G(issue: BondIssue, issued_on: Date) kind empirical {
    label en official "the date the bonds of the issue are issued";
}
pub relation capital_expenditures_taken_into_account_144a4(issue: BondIssue, amount: Money) kind institutional {
    label en official "the capital expenditures taken into account after the UDAG rule of (F) (bonds before 2007: up to $10,000,000 not taken into account) and the additional $10,000,000 of (G) (bonds after 2006)";
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "With respect to bonds issued after December 31, 2006, in addition to any capital expenditure described in subparagraph (C), capital expenditures of not to exceed")
rule CapitalExpendituresAfter2006Minus10Million(issue: BondIssue, counted: Money, issued: Date) strict {
    label en official "section 144(a)(4)(G): for bonds issued after December 31, 2006 up to $10,000,000 of further expenditures is not taken into account";
    when capital_expenditures_counted_before_g_144a4A(issue, counted);
    when small_issue_date_144a4G(issue, issued);
    when issued > @2006-12-31;
    then capital_expenditures_taken_into_account_144a4(issue, max(0.00 USD, round(counted - 10000000.00 USD, 2, "HALF_UP")));
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "In the case of any issue 95 percent or more of the net proceeds of which are to be used to provide facilities with respect to which an urban development action grant has")
rule CapitalExpendituresUdagMinus10Million(issue: BondIssue, counted: Money, issued: Date) strict {
    label en official "section 144(a)(4)(F): for a UDAG issue not after 2006 expenditures of up to $10,000,000 are not taken into account (the subparagraph does not apply to bonds issued after December 31, 2006)";
    when capital_expenditures_counted_before_g_144a4A(issue, counted);
    when udag_facilities_144a4F(issue);
    when small_issue_date_144a4G(issue, issued);
    when issued <= @2006-12-31;
    then capital_expenditures_taken_into_account_144a4(issue, max(0.00 USD, round(counted - 10000000.00 USD, 2, "HALF_UP")));
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "With respect to bonds issued after December 31, 2006, in addition to any capital expenditure described in subparagraph (C), capital expenditures of not to exceed")
rule CapitalExpendituresBefore2007WithoutUdag(issue: BondIssue, counted: Money, issued: Date) strict {
    label en official "section 144(a)(4): before 2007 with no UDAG grant nothing further is excluded";
    when capital_expenditures_counted_before_g_144a4A(issue, counted);
    when small_issue_date_144a4G(issue, issued);
    when issued <= @2006-12-31;
    when not_known(udag_facilities_144a4F(issue));
    then capital_expenditures_taken_into_account_144a4(issue, counted);
}
pub relation small_issue_aggregate_face_amount_144a(issue: BondIssue, amount: Money) kind institutional {
    label en official "the aggregate face amount of the issue for paragraph (1): the authorized face amount plus the prior issues taken into account (paragraph (2)) plus, on the (4) election, the capital expenditures taken into account";
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "then, for purposes of paragraph (1), in determining the aggregate face amount of any later issue there shall be taken into account the aggregate face amount of")
rule SmallIssueAggregateFaceWithoutElection(issue: BondIssue, face: Money, prior: Money) strict {
    label en official "section 144(a)(1)-(2) without the $10,000,000 election";
    when issue_authorized_face_amount(issue, face);
    when prior_issues_face_taken_into_account_144a2(issue, prior);
    when not_known(issuer_elects_10_million_limit_144a4A(issue));
    then small_issue_aggregate_face_amount_144a(issue, round(face + prior, 2, "HALF_UP"));
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "(ii) in determining the aggregate face amount of such issue, by taking into account not only the amount described in paragraph (2), but also the aggregate amount of")
rule SmallIssueAggregateFaceWithElection(issue: BondIssue, face: Money, prior: Money, capex: Money) strict {
    label en official "section 144(a)(4)(A)(ii): the capital expenditures are taken into account as if they were the face of a prior outstanding issue";
    when issue_authorized_face_amount(issue, face);
    when prior_issues_face_taken_into_account_144a2(issue, prior);
    when issuer_elects_10_million_limit_144a4A(issue);
    when capital_expenditures_taken_into_account_144a4(issue, capex);
    then small_issue_aggregate_face_amount_144a(issue, round(face + prior + capex, 2, "HALF_UP"));
}
pub relation small_issue_face_limit_144a(issue: BondIssue, limit: Money) kind institutional {
    label en official "the face limit of paragraph (1): $1,000,000, or $10,000,000 on the issuer's election";
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "(i) by substituting \"$10,000,000\" for \"$1,000,000\" in paragraph (1), and")
rule SmallIssueLimitTenMillion(issue: BondIssue) strict {
    label en official "section 144(a)(4)(A)(i)";
    when issuer_elects_10_million_limit_144a4A(issue);
    then small_issue_face_limit_144a(issue, 10000000.00 USD);
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "For purposes of this part, the term \"qualified small issue bond\" means any bond issued as part of an issue the aggregate authorized face amount of which is $1,000,000 or")
rule SmallIssueLimitOneMillion(issue: BondIssue) strict {
    label en official "section 144(a)(1)";
    when issue_authorized_face_amount(issue, _);
    when not_known(issuer_elects_10_million_limit_144a4A(issue));
    then small_issue_face_limit_144a(issue, 1000000.00 USD);
}
relation election_all_redeemed_issues_were_144a1_issues_144a4E(issue: BondIssue, is_refinancing_issue: Boolean, all_prior_redeemed_issues_were_144a1: Boolean) kind empirical {
    label en official "the issue is described in paragraph (1)(B) (a refinancing issue) and all the prior issues being redeemed were issues to which paragraph (1) applied";
}
pub relation election_permitted_for_refinancing_issue_144a4E(issue: BondIssue) kind institutional {
    label en official "for a refinancing issue the $10,000,000 election may be made only if all the prior issues being redeemed were paragraph (1) issues";
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "In the case of any issue described in paragraph (1)(B), an election may be made under subparagraph (A) of this paragraph only if all of the prior issues being redeemed")
rule ElectionPermittedForRefinancingIssue(issue: BondIssue) strict {
    label en official "section 144(a)(4)(E)";
    when election_all_redeemed_issues_were_144a1_issues_144a4E(issue, true, true);
    when issuer_elects_10_million_limit_144a4A(issue);
    then election_permitted_for_refinancing_issue_144a4E(issue);
}
pub relation bond_keeps_status_until_expenditure_paid_144a4D(issue: BondIssue, item: us.irc.core::Transaction, paid_on: Date) kind institutional {
    label en official "no bond of the issue ceases to be a qualified small issue bond by reason of an expenditure for any period before the date the expenditure is paid or incurred";
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "In applying subparagraph (A)(ii) with respect to capital expenditures made after the date of any issue, no bond issued as a part of such issue shall cease to be treated")
rule BondKeepsStatusUntilExpenditurePaid(issue: BondIssue, item: us.irc.core::Transaction, a: Money, p: Date, d: Date, s: Boolean, f: Boolean, k: ExpenditureKind144a4C, x: Money) strict {
    label en official "section 144(a)(4)(D): an expenditure after the date of the issue counts only from its payment date";
    when small_issue_capital_expenditure_144a4(issue, item, a, p, d, s, f, k, x);
    when p > d;
    then bond_keeps_status_until_expenditure_paid_144a4D(issue, item, p);
}

// =====================================================================
// §144(a)(5)-(9): bars and separate issues
// =====================================================================

relation net_proceeds_for_residential_real_property_for_family_units_144a5(issue: BondIssue, amount: Money, net_proceeds: Money) kind empirical {
    label en official "the net proceeds to be used directly or indirectly to provide residential real property for family units, and the net proceeds of the issue";
}
pub relation small_issue_barred_residential_144a5(issue: BondIssue) kind institutional {
    label en official "the subsection does not apply to a bond of an issue 5 percent or more of the net proceeds of which provide residential real property for family units";
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "This subsection shall not apply to any bond issued as part of an issue 5 percent or more of the net proceeds of which are to be used directly or indirectly to provide")
rule SmallIssueBarredResidential(issue: BondIssue, residential: Money, net: Money) strict {
    label en official "section 144(a)(5): 5 percent or more, exact";
    when net_proceeds_for_residential_real_property_for_family_units_144a5(issue, residential, net);
    when net > 0.00 USD;
    when residential * 20 >= net;
    then small_issue_barred_residential_144a5(issue);
}
relation other_bond_of_issue_excluded_under_other_provision_144a7(issue: BondIssue) kind empirical {
    label en official "the interest on another bond which is part of the issue is excluded from gross income under a provision of law other than section 144(a)";
}
pub relation small_issue_barred_other_exempt_bonds_144a7(issue: BondIssue) kind institutional {
    label en official "the subsection does not apply to a bond of an issue (other than an issue to which paragraph (4) applies) if another bond of the issue is tax-exempt under another provision";
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "This subsection shall not apply to any bond issued as part of an issue (other than an issue to which paragraph (4) applies) if the interest on any other bond which is")
rule SmallIssueBarredOtherExemptBonds(issue: BondIssue) strict {
    label en official "section 144(a)(7)";
    when other_bond_of_issue_excluded_under_other_provision_144a7(issue);
    when not_known(issuer_elects_10_million_limit_144a4A(issue));
    then small_issue_barred_other_exempt_bonds_144a7(issue);
}
relation net_proceeds_for_retail_food_auto_or_recreation_144a8A(issue: BondIssue, amount: Money, net_proceeds: Money) kind empirical {
    label en official "the net proceeds to be used to provide a facility the primary purpose of which is retail food and beverage services, automobile sales or service, or the provision of recreation or entertainment, and the net proceeds";
}
relation proceeds_for_private_recreation_facility_144a8B(issue: BondIssue) kind empirical {
    label en official "any portion of the proceeds is to be used to provide a private or commercial golf course, country club, massage parlor, tennis club, skating facility, racquet sports facility, hot tub facility, suntan facility or racetrack";
}
pub relation small_issue_barred_restricted_facilities_144a8(issue: BondIssue) kind institutional {
    label en official "the subsection does not apply to an issue if more than 25 percent of the net proceeds provide retail food and beverage, automobile or recreation facilities, or any portion provides a golf course, club or similar facility";
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "(A) more than 25 percent of the net proceeds of the issue are to be used to provide a facility the primary purpose of which is one of the following: retail food and")
rule SmallIssueBarredRetailOverQuarter(issue: BondIssue, amount: Money, net: Money) strict {
    label en official "section 144(a)(8)(A): more than 25 percent, exact";
    when net_proceeds_for_retail_food_auto_or_recreation_144a8A(issue, amount, net);
    when net > 0.00 USD;
    when amount * 4 > net;
    then small_issue_barred_restricted_facilities_144a8(issue);
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "(B) any portion of the proceeds of the issue is to be used to provide the following: any private or commercial golf course, country club, massage parlor, tennis club,")
rule SmallIssueBarredPrivateRecreation(issue: BondIssue) strict {
    label en official "section 144(a)(8)(B)";
    when proceeds_for_private_recreation_facility_144a8B(issue);
    then small_issue_barred_restricted_facilities_144a8(issue);
}
relation lots_would_be_one_issue_144a6(lot_a: BondIssue, lot_b: BondIssue) kind empirical {
    label en official "the separate lots of bonds would, but for subparagraph (A), be treated as part of the same issue";
}
relation lots_used_with_facilities_in_more_than_one_state_144a6Ai(lot_a: BondIssue, lot_b: BondIssue) kind empirical {
    label en official "the proceeds of the lots are used with 2 or more facilities located in more than 1 State";
}
relation lots_used_with_same_principal_user_144a6Aii(lot_a: BondIssue, lot_b: BondIssue) kind empirical {
    label en official "the facilities have, or will have, as the same principal user the same person or related persons";
}
pub relation lots_treated_as_separate_issues_144a6A(lot_a: BondIssue, lot_b: BondIssue) kind institutional {
    label en official "separate lots that would be one issue are treated as separate issues unless the facilities are in more than 1 State or have the same principal user";
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, separate lots of bonds which (but for this subparagraph) would be treated as part of the same issue shall be treated as separate issues")
rule LotsTreatedAsSeparateIssues(lot_a: BondIssue, lot_b: BondIssue) strict {
    label en official "section 144(a)(6)(A)";
    when lots_would_be_one_issue_144a6(lot_a, lot_b);
    when not_known(lots_used_with_facilities_in_more_than_one_state_144a6Ai(lot_a, lot_b));
    when not_known(lots_used_with_same_principal_user_144a6Aii(lot_a, lot_b));
    then lots_treated_as_separate_issues_144a6A(lot_a, lot_b);
}
relation person_guarantees_arranges_or_pays_cost_of_issuance_144a6Bi(person: Person, facility: us.irc.core::Asset) kind empirical {
    label en official "the person (or a group of related persons which includes it) guarantees, arranges, participates in, or assists with the issuance (or pays any portion of the cost of issuance) of a bond financing the facility";
}
relation person_provides_property_or_franchise_144a6Bii(person: Person, facility: us.irc.core::Asset) kind empirical {
    label en official "the person provides property, or a franchise, trademark or trade name (section 1253), to be used in connection with the facility";
}
relation person_is_governmental_unit_144a6B(person: Person) kind empirical {
    label en official "the person is a governmental unit";
}
pub relation principal_user_by_franchise_144a6B(person: Person, facility: us.irc.core::Asset) kind institutional {
    label en official "a person other than a governmental unit is considered a principal user of the facility when it assists with the issuance and provides the property or franchise";
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "(i) guarantees, arranges, participates in, or assists with the issuance (or pays any portion of the cost of issuance) of any bond the proceeds of which are to be used to")
rule PrincipalUserByFranchise(person: Person, facility: us.irc.core::Asset) strict {
    label en official "section 144(a)(6)(B)(i)-(ii)";
    when person_guarantees_arranges_or_pays_cost_of_issuance_144a6Bi(person, facility);
    when person_provides_property_or_franchise_144a6Bii(person, facility);
    when not_known(person_is_governmental_unit_144a6B(person));
    then principal_user_by_franchise_144a6B(person, facility);
}
relation issue_used_with_single_project_144a9(issue: BondIssue, project: us.irc.core::Asset) kind empirical {
    label en official "part or all of the net proceeds of the issue are to be used with respect to a single building, an enclosed shopping mall, or a strip of offices, stores or warehouses using substantial common facilities";
}
pub relation issues_treated_as_one_issue_144a9(issue_a: BondIssue, issue_b: BondIssue) kind institutional {
    label en official "two or more issues used with respect to a single project are treated as 1 issue";
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, 2 or more issues part or all of the net proceeds of which are to be used with respect to a single building, an enclosed shopping mall,")
rule IssuesForSingleProjectTreatedAsOne(a: BondIssue, b: BondIssue, project: us.irc.core::Asset) strict {
    label en official "section 144(a)(9)";
    when issue_used_with_single_project_144a9(a, project);
    when issue_used_with_single_project_144a9(b, project);
    when a != b;
    then issues_treated_as_one_issue_144a9(a, b);
}

// =====================================================================
// §144(a)(10): aggregate limit per test-period beneficiary
// =====================================================================

relation facility_use_share_144a10C(issue: BondIssue, beneficiary: Person, share_of_facility_used_or_owned: Decimal, is_owner: Boolean, face_amount_of_issue: Money) kind empirical {
    label en official "the portion of the facility used (or owned, for an owner) by the beneficiary, whether the beneficiary is an owner, and the entire face amount of the issue";
}
pub relation face_amount_allocated_to_beneficiary_144a10C(issue: BondIssue, beneficiary: Person, amount: Money) kind institutional {
    label en official "the portion of the face amount allocated to the beneficiary: the face times the share of the facility used (a principal user) or owned (an owner)";
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "Except as otherwise provided in regulations, the portion of the face amount of an issue allocated to any test-period beneficiary of a facility financed by the proceeds")
rule FaceAllocatedToPrincipalUser(issue: BondIssue, beneficiary: Person, share: Decimal, face: Money) strict {
    label en official "section 144(a)(10)(C)(i), one rounding to cents HALF_UP over the exact product";
    when facility_use_share_144a10C(issue, beneficiary, share, false, face);
    then face_amount_allocated_to_beneficiary_144a10C(issue, beneficiary, round(face * share, 2, "HALF_UP"));
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "Except as otherwise provided in regulations, the portion of the face amount of an issue allocated to any test-period beneficiary who is an owner of a facility financed")
rule FaceAllocatedToOwner(issue: BondIssue, beneficiary: Person, share: Decimal, face: Money) strict {
    label en official "section 144(a)(10)(C)(ii)";
    when facility_use_share_144a10C(issue, beneficiary, share, true, face);
    then face_amount_allocated_to_beneficiary_144a10C(issue, beneficiary, round(face * share, 2, "HALF_UP"));
}
relation later_of_placed_in_service_and_issue_144a10D(issue: BondIssue, placed_in_service_on: Date, issued_on: Date) kind empirical {
    label en official "the date the facilities were placed in service and the date of issue";
}
relation person_owner_or_principal_user_on_144a10D(issue: BondIssue, person: Person, on: Date) kind empirical {
    label en official "the person is an owner or a principal user of the facilities being financed on the date";
}
pub relation test_period_beneficiary_144a10D(issue: BondIssue, person: Person) kind institutional {
    label en official "a test-period beneficiary: an owner or principal user of the facilities at any time during the 3-year period beginning on the later of the placed-in-service date and the date of issue";
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, except as provided in regulations, the term \"test-period beneficiary\" means any person who is an owner or a principal user of facilities")
rule TestPeriodBeneficiaryDefined(issue: BondIssue, person: Person, pis: Date, iss: Date, on: Date) strict {
    label en official "section 144(a)(10)(D)(i)-(ii)";
    when later_of_placed_in_service_and_issue_144a10D(issue, pis, iss);
    when person_owner_or_principal_user_on_144a10D(issue, person, on);
    when on >= pis;
    when on >= iss;
    when on < add_calendar_period(pis, 3 calendar_year);
    when on < add_calendar_period(iss, 3 calendar_year);
    then test_period_beneficiary_144a10D(issue, person);
}
relation outstanding_facility_related_bond_144a10B(issue: BondIssue, beneficiary: Person, bond: us.irc.core::Asset, amount: Money, allocated_to_beneficiary: Boolean, outstanding_at_later_issue: Boolean, redeemed_from_later_proceeds_other_than_advance: Boolean, of_kind_144a10Bii: Boolean) kind empirical {
    label en official "a tax-exempt exempt facility bond, qualified small issue bond, qualified redevelopment bond or pre-1986 industrial development bond to which section 141(a) does not apply, allocated to the beneficiary, with whether it is outstanding at the time of the later issue and whether it is to be redeemed (other than in an advance refunding) from the later issue's net proceeds";
}
pub relation outstanding_facility_related_bonds_144a10B(issue: BondIssue, beneficiary: Person, amount: Money) kind institutional {
    label en official "the aggregate amount of the tax-exempt bonds of clause (ii) allocated to the beneficiary and outstanding at the time of the later issue";
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "(II) which are outstanding at the time of such later issue (not including as outstanding any bond which is to be redeemed (other than in an advance refunding) from the")
rule OutstandingFacilityRelatedBonds(issue: BondIssue, beneficiary: Person, b0: us.irc.core::Asset, a0: Money, al0: Boolean, o0: Boolean, r0: Boolean, k0: Boolean) strict {
    label en official "section 144(a)(10)(B)(i)(I)-(II), (ii)(I)-(II)";
    when outstanding_facility_related_bond_144a10B(issue, beneficiary, b0, a0, al0, o0, r0, k0);
    then outstanding_facility_related_bonds_144a10B(issue, beneficiary, sum(collect all a: Money, b: us.irc.core::Asset, al: Boolean, o: Boolean, r: Boolean, k: Boolean where outstanding_facility_related_bond_144a10B(issue, beneficiary, b, a, al, o, r, k) and al == true and o == true and r == false and k == true, empty: 0.00 USD));
}
pub relation small_issue_barred_beneficiary_limit_144a10(issue: BondIssue, beneficiary: Person) kind institutional {
    label en official "the subsection does not apply to an issue if the face amount allocated to a test-period beneficiary, increased by that beneficiary's outstanding tax-exempt facility-related bonds, exceeds $40,000,000";
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "This subsection shall not apply to any issue if the aggregate authorized face amount of such issue allocated to any test-period beneficiary (when increased by the")
rule SmallIssueBarredBeneficiaryLimit(issue: BondIssue, beneficiary: Person, allocated: Money, outstanding: Money) strict {
    label en official "section 144(a)(10)(A)";
    when test_period_beneficiary_144a10D(issue, beneficiary);
    when face_amount_allocated_to_beneficiary_144a10C(issue, beneficiary, allocated);
    when outstanding_facility_related_bonds_144a10B(issue, beneficiary, outstanding);
    when allocated + outstanding > 40000000.00 USD;
    then small_issue_barred_beneficiary_limit_144a10(issue, beneficiary);
}
relation person_treated_as_one_person_144a10E(person: Person, group: Person) kind empirical {
    label en official "all persons related to each other (within paragraph (3)) are treated as 1 person: the person and the representative of its group";
}
pub relation related_persons_group_144a10E(person: Person, group: Person) kind institutional {
    label en official "the beneficiary's group for the aggregate limit";
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, all persons who are related (within the meaning of paragraph (3)) to each other shall be treated as 1 person.")
rule RelatedPersonsTreatedAsOnePerson(person: Person, group: Person, other: Person) strict {
    label en official "section 144(a)(10)(E)";
    when person_treated_as_one_person_144a10E(person, group);
    when related_persons_144a3(person, other);
    then related_persons_group_144a10E(person, group);
}

// =====================================================================
// §144(a)(11): depreciable farm property; (a)(12): termination
// =====================================================================

relation small_issue_barred_by_a_beneficiary_144a10(issue: BondIssue) kind institutional {
    label en official "helper: some test-period beneficiary is above the $40,000,000 limit";
}
rule SmallIssueBarredByABeneficiary(issue: BondIssue, beneficiary: Person) strict {
    label en official "helper for the not_known test of the earlier classification rule";
    when small_issue_barred_beneficiary_limit_144a10(issue, beneficiary);
    then small_issue_barred_by_a_beneficiary_144a10(issue);
}
relation depreciable_farm_property_proceeds_144a11(issue: BondIssue, amount: Money) kind empirical {
    label en official "the net proceeds to be used to provide depreciable farm property (property subject to depreciation to be used in a trade or business of farming) with respect to which the principal user is the same person or related persons";
}
relation prior_issue_farm_proceeds_144a11C(issue: BondIssue, prior: BondIssue, amount: Money) kind empirical {
    label en official "the amount of a prior paragraph (1) issue that was or will be used for such property";
}
pub relation small_issue_barred_farm_property_144a11(issue: BondIssue) kind institutional {
    label en official "the subsection does not apply to an issue if more than $250,000 of its net proceeds (with the prior issues taken into account) provide depreciable farm property";
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "This subsection shall not apply to any issue if more than $250,000 of the net proceeds of such issue are to be used to provide depreciable farm property with respect to")
rule SmallIssueBarredFarmPropertyWithPrior(issue: BondIssue, own: Money, p0: BondIssue, a0: Money) strict {
    label en official "section 144(a)(11)(A), (C): more than $250,000 in the aggregate";
    when depreciable_farm_property_proceeds_144a11(issue, own);
    when prior_issue_farm_proceeds_144a11C(issue, p0, a0);
    when own + sum(collect all a: Money, p: BondIssue where prior_issue_farm_proceeds_144a11C(issue, p, a), empty: 0.00 USD) > 250000.00 USD;
    then small_issue_barred_farm_property_144a11(issue);
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "This subsection shall not apply to any issue if more than $250,000 of the net proceeds of such issue are to be used to provide depreciable farm property with respect to")
rule SmallIssueBarredFarmPropertyAlone(issue: BondIssue, own: Money) strict {
    label en official "section 144(a)(11)(A) with no prior issue recorded";
    when depreciable_farm_property_proceeds_144a11(issue, own);
    when not_known(has_prior_farm_issue_144a11C(issue));
    when own > 250000.00 USD;
    then small_issue_barred_farm_property_144a11(issue);
}
relation has_prior_farm_issue_144a11C(issue: BondIssue) kind institutional {
    label en official "helper: a prior farm issue is recorded";
}
rule HasPriorFarmIssue(issue: BondIssue, p: BondIssue, a: Money) strict {
    label en official "helper for the not_known test";
    when prior_issue_farm_proceeds_144a11C(issue, p, a);
    then has_prior_farm_issue_144a11C(issue);
}
relation small_issue_issue_date_144a12(issue: BondIssue, issued_on: Date) kind empirical {
    label en official "the date the bond is issued";
}
relation refunding_of_pre_1987_bond_144a12Aii(issue: BondIssue, refunded_issued_on_or_before_19861231: Boolean, avg_maturity_not_later_147b2A: Boolean, amount_not_above_outstanding: Boolean, redeemed_within_90_days: Boolean) kind empirical {
    label en official "the bond refunds a bond issued on or before December 31, 1986, with the three conditions of subclauses (I)-(III)";
}
relation net_proceeds_for_manufacturing_facility_144a12B(issue: BondIssue, amount: Money, net_proceeds: Money) kind empirical {
    label en official "the net proceeds to be used to provide any manufacturing facility, and the net proceeds";
}
relation net_proceeds_for_land_or_property_147c2_144a12B(issue: BondIssue, amount: Money, net_proceeds: Money) kind empirical {
    label en official "the net proceeds to be used to provide land or property in accordance with section 147(c)(2)";
}
pub relation small_issue_termination_ok_144a12(issue: BondIssue) kind institutional {
    label en official "the subsection has not terminated for the bond: it is issued on or before December 31, 1986, or it refunds an earlier bond under the three conditions, or 95 percent or more of the net proceeds provide a manufacturing facility or land or property under section 147(c)(2)";
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "(i) any bond (other than a bond described in clause (ii)) issued after December 31, 1986, or")
rule SmallIssueTerminationOkIssuedBefore1987(issue: BondIssue, on: Date) strict {
    label en official "section 144(a)(12)(A)(i)";
    when small_issue_issue_date_144a12(issue, on);
    when on <= @1986-12-31;
    then small_issue_termination_ok_144a12(issue);
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "(ii) any bond (or series of bonds) issued to refund a bond issued on or before such date unless—")
rule SmallIssueTerminationOkRefunding(issue: BondIssue) strict {
    label en official "section 144(a)(12)(A)(ii)(I)-(III)";
    when refunding_of_pre_1987_bond_144a12Aii(issue, true, true, true, true);
    then small_issue_termination_ok_144a12(issue);
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "(i) any manufacturing facility, or")
rule SmallIssueTerminationOkManufacturing(issue: BondIssue, amount: Money, net: Money) strict {
    label en official "section 144(a)(12)(B)(i): 95 percent or more for a manufacturing facility";
    when net_proceeds_for_manufacturing_facility_144a12B(issue, amount, net);
    when net > 0.00 USD;
    when amount * 100 >= net * 95;
    then small_issue_termination_ok_144a12(issue);
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "(ii) any land or property in accordance with section 147(c)(2).")
rule SmallIssueTerminationOkFarmLand(issue: BondIssue, amount: Money, net: Money) strict {
    label en official "section 144(a)(12)(B)(ii)";
    when net_proceeds_for_land_or_property_147c2_144a12B(issue, amount, net);
    when net > 0.00 USD;
    when amount * 100 >= net * 95;
    then small_issue_termination_ok_144a12(issue);
}
relation facility_manufacturing_or_production_of_tangible_personal_property_144a12Ci(facility: us.irc.core::Asset) kind empirical {
    label en official "the facility is used in the manufacturing or production of tangible personal property (including the processing resulting in a change in the condition of the property); a rule similar to section 142(b)(2) applies";
}
relation ancillary_facility_same_site_144a12Cii(facility: us.irc.core::Asset, main: us.irc.core::Asset, share_of_net_proceeds_for_ancillary: Decimal) kind empirical {
    label en official "a facility directly related and ancillary to a manufacturing facility, on the same site, with the share of the net proceeds used to provide such facilities";
}
relation issue_in_2009_2010_144a12Ciii(issue: BondIssue, issued_on: Date) kind empirical {
    label en official "an issue made after the date of enactment of clause (iii) and before January 1, 2011";
}
relation facility_for_intangible_property_197d1Ciii_or_related_144a12Ciii(facility: us.irc.core::Asset, main: us.irc.core::Asset, same_site: Boolean, produces_197_intangible: Boolean) kind empirical {
    label en official "a facility used in the creation or production of intangible property described in section 197(d)(1)(C)(iii), or functionally related and subordinate to a manufacturing facility on the same site";
}
pub relation manufacturing_facility_144a12C(facility: us.irc.core::Asset) kind institutional {
    label en official "a manufacturing facility";
}
relation manufacturing_facility_base_144a12Ci(facility: us.irc.core::Asset) kind institutional {
    label en official "helper: a facility used in the manufacturing or production of tangible personal property";
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "The term \"manufacturing facility\" means any facility which is used in the manufacturing or production of tangible personal property (including the processing resulting")
rule ManufacturingFacilityDefined(facility: us.irc.core::Asset) strict {
    label en official "section 144(a)(12)(C)(i)";
    when facility_manufacturing_or_production_of_tangible_personal_property_144a12Ci(facility);
    then manufacturing_facility_base_144a12Ci(facility);
}
rule ManufacturingFacilityFromBase(facility: us.irc.core::Asset) strict {
    label en official "section 144(a)(12)(C)(i)";
    when manufacturing_facility_base_144a12Ci(facility);
    then manufacturing_facility_144a12C(facility);
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "Such term includes facilities which are directly related and ancillary to a manufacturing facility (determined without regard to this clause) if—")
rule AncillaryFacilityIsManufacturingFacility(facility: us.irc.core::Asset, main: us.irc.core::Asset, share: Decimal) strict {
    label en official "section 144(a)(12)(C)(ii)(I)-(II): on the same site, not more than 25 percent of the net proceeds";
    when ancillary_facility_same_site_144a12Cii(facility, main, share);
    when manufacturing_facility_base_144a12Ci(main);
    when share <= 0.25;
    then manufacturing_facility_144a12C(facility);
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "In the case of any issue made after the date of enactment of this clause and before January 1, 2011, clause (ii) shall not apply and the net proceeds from a bond shall")
rule IntangibleFacilityIsManufacturingFacility2009To2010(facility: us.irc.core::Asset, main: us.irc.core::Asset, issue: BondIssue, issued: Date) strict {
    label en official "section 144(a)(12)(C)(iii)(I)-(II): for issues made in 2009 and 2010 a facility producing section 197(d)(1)(C)(iii) intangibles, or a functionally related and subordinate facility on the same site, counts";
    when issue_in_2009_2010_144a12Ciii(issue, issued);
    when facility_for_intangible_property_197d1Ciii_or_related_144a12Ciii(facility, main, true, true);
    when issued > @2009-02-16;
    when issued < @2011-01-01;
    then manufacturing_facility_144a12C(facility);
}
@source(IRC_S144_A, relation = formalizes, coverage = exact, quote = "(II) a facility which is functionally related and subordinate to a manufacturing facility (determined without regard to this subclause) if such facility is located on")
rule FunctionallyRelatedFacilityIsManufacturingFacility2009To2010(facility: us.irc.core::Asset, main: us.irc.core::Asset, issue: BondIssue, issued: Date) strict {
    label en official "section 144(a)(12)(C)(iii)(II): functionally related and subordinate to a manufacturing facility on the same site";
    when issue_in_2009_2010_144a12Ciii(issue, issued);
    when facility_for_intangible_property_197d1Ciii_or_related_144a12Ciii(facility, main, true, false);
    when manufacturing_facility_base_144a12Ci(main);
    when issued > @2009-02-16;
    when issued < @2011-01-01;
    then manufacturing_facility_144a12C(facility);
}

// the earlier classification rule reads the derived statuses: see s142-150-bonds.law

// =====================================================================
// §144(b): qualified student loan bonds
// =====================================================================

pub enum StudentLoanProgram144b1 { HigherEducationActProgram; StateApprovedProgram; OtherStudentLoanProgram; }
relation student_loan_program_of_issue_144b1(issue: BondIssue, program: StudentLoanProgram144b1, share_of_net_proceeds: Decimal) kind empirical {
    label en official "the program under which the student loans of the issue are made or financed and the share of the net proceeds used directly or indirectly to make or finance student loans under it";
}
relation program_limits_loan_amount_and_interest_144b1Ai(issue: BondIssue) kind empirical {
    label en official "limitations are imposed under the program on the maximum amount of loans outstanding to any student and on the maximum rate of interest payable on any loan";
}
relation loans_guaranteed_by_federal_government_144b1Aii(issue: BondIssue) kind empirical {
    label en official "the loans are directly or indirectly guaranteed by the Federal Government";
}
relation financing_not_limited_to_tax_exempt_bond_proceeds_144b1Aiii(issue: BondIssue) kind empirical {
    label en official "the financing of loans under the program is not limited by Federal law to the proceeds of tax-exempt bonds";
}
relation special_allowance_payments_144b1Aiv(issue: BondIssue, authorized_or_would_be_authorized: Boolean) kind empirical {
    label en official "special allowance payments under section 438 of the Higher Education Act of 1965 are authorized with respect to the loans, or would be if they were not financed with tax-exempt bonds";
}
relation program_discriminates_by_school_location_144b4(issue: BondIssue) kind empirical {
    label en official "the program discriminates on the basis of the location (in the United States) of the educational institution in which the student is enrolled";
}
relation state_program_loan_within_cost_of_attendance_144b1B(issue: BondIssue) kind empirical {
    label en official "no loan under the State-approved program exceeds the difference between the total cost of attendance and other forms of student assistance (not counting parent loans under section 428B(a)(1) or subpart I of part C of title VII of the Public Health Service Act)";
}
relation student_borrowers_resident_or_enrolled_in_state_144b3(issue: BondIssue) kind empirical {
    label en official "each student is a resident of the State from which the volume cap under section 146 for the loan was derived, or is enrolled at an educational institution located in that State";
}
relation issue_meets_private_business_tests_with_501c3_as_governmental_144b1(issue: BondIssue) kind empirical {
    label en official "the issue meets the private business tests of paragraphs (1) and (2) of section 141(b), determined by treating 501(c)(3) organizations as governmental units for their activities which are not unrelated trades or businesses (section 513(a))";
}
pub relation qualified_student_loan_bond_144b_derived(issue: BondIssue) kind institutional {
    label en official "a qualified student loan bond: the applicable percentage (90 percent for the Higher Education Act program, 95 percent for the State-approved program) or more of the net proceeds finance student loans under a qualifying program, the loans go to residents or enrolled students, and the issue does not meet the private business tests";
}
@source(IRC_S144_B, relation = formalizes, coverage = exact, quote = "The term \"qualified student loan bond\" means any bond issued as part of an issue the applicable percentage or more of the net proceeds of which are to be used directly")
rule QualifiedStudentLoanBondHigherEducationProgram(issue: BondIssue, share: Decimal) strict {
    label en official "section 144(b)(1)(A), (2)(A), (3), (4)";
    when student_loan_program_of_issue_144b1(issue, HigherEducationActProgram, share);
    when share >= 0.90;
    when program_limits_loan_amount_and_interest_144b1Ai(issue);
    when loans_guaranteed_by_federal_government_144b1Aii(issue);
    when financing_not_limited_to_tax_exempt_bond_proceeds_144b1Aiii(issue);
    when special_allowance_payments_144b1Aiv(issue, true);
    when not_known(program_discriminates_by_school_location_144b4(issue));
    when student_borrowers_resident_or_enrolled_in_state_144b3(issue);
    when not_known(issue_meets_private_business_tests_with_501c3_as_governmental_144b1(issue));
    then qualified_student_loan_bond_144b_derived(issue);
}
@source(IRC_S144_B, relation = formalizes, coverage = exact, quote = "(B) 95 percent in the case of the program described in paragraph (1)(B).")
rule QualifiedStudentLoanBondStateProgram(issue: BondIssue, share: Decimal) strict {
    label en official "section 144(b)(1)(B), (2)(B), (3): 95 percent; a program described in (A) is not a (B) program (the two program kinds are exclusive by the enum)";
    when student_loan_program_of_issue_144b1(issue, StateApprovedProgram, share);
    when share >= 0.95;
    when state_program_loan_within_cost_of_attendance_144b1B(issue);
    when student_borrowers_resident_or_enrolled_in_state_144b3(issue);
    when not_known(issue_meets_private_business_tests_with_501c3_as_governmental_144b1(issue));
    then qualified_student_loan_bond_144b_derived(issue);
}
@source(IRC_S144_B, relation = formalizes, coverage = exact, quote = "A program shall not be treated as described in paragraph (1)(A) if such program discriminates on the basis of the location (in the United States) of the educational")
rule QualifiedStudentLoanBondCategoryDerived(issue: BondIssue) strict {
    label en official "section 141(e)(1)(E) read with the derived section 144(b) status";
    when qualified_student_loan_bond_144b_derived(issue);
    then qualified_bond_category_141e1(issue);
}

// =====================================================================
// §144(c): qualified redevelopment bonds
// =====================================================================

pub enum RedevelopmentPurpose144c3 { AcquisitionByEminentDomainUnit; ClearingAndPreparationOfAcquiredLand; RehabilitationOfAcquiredProperty; RelocationOfOccupants; ConstructionOrEnlargement; OtherPurpose; }
relation proceeds_for_purpose_144c3(issue: BondIssue, purpose: RedevelopmentPurpose144c3, share_of_net_proceeds: Decimal) kind empirical {
    label en official "the share of the net proceeds of the issue to be used for the redevelopment purpose in a designated blighted area";
}
pub relation redevelopment_purposes_share_144c3(issue: BondIssue, share: Decimal) kind institutional {
    label en official "the share of the net proceeds used for redevelopment purposes: acquisition by a unit with eminent domain power, clearing and preparation of acquired land, rehabilitation of acquired property, and relocation of occupants, excluding construction (other than rehabilitation) and enlargement of an existing building";
}
@source(IRC_S144_C, relation = formalizes, coverage = exact, quote = "(i) the acquisition (by a governmental unit having the power to exercise eminent domain) of real property located in such area,")
rule RedevelopmentPurposesShare(issue: BondIssue, s0: Decimal) strict {
    label en official "section 144(c)(3)(A)(i)-(iv) and (B): the sum of the four purposes' shares";
    when proceeds_for_purpose_144c3(issue, AcquisitionByEminentDomainUnit, s0);
    then redevelopment_purposes_share_144c3(issue, sum(collect all s: Decimal, p: RedevelopmentPurpose144c3 where proceeds_for_purpose_144c3(issue, p, s) and p != ConstructionOrEnlargement and p != OtherPurpose, empty: 0.0));
}
relation blighted_area_designated_by_local_governing_body_144c4A(issue: BondIssue) kind empirical {
    label en official "the area is designated by the governing body of a local general purpose governmental unit in the jurisdiction of which it is located";
}
relation governing_body_determined_blight_on_factors_144c4B(issue: BondIssue) kind empirical {
    label en official "the governing body determined the area to be blighted on the basis of factors such as excessive vacant land on which structures were previously located, abandoned or vacant buildings, substandard structures, vacancies and delinquencies in payment of real property taxes (an evaluative determination of the governing body, case-asserted)";
}
relation designation_percentage_with_others_144c4C(issue: BondIssue, sum_of_designation_percentages_within_jurisdiction: Decimal) kind empirical {
    label en official "the designation percentage of the area added to the designation percentages of all other designated blighted areas within the jurisdiction (a previously designated area with no outstanding qualified redevelopment bond or similar bond is not counted, clause (iii))";
}
relation area_size_acres_144c4D(issue: BondIssue, acres: Integer, contiguous_and_compact: Boolean, share_of_financed_area_provided_to_one_person: Decimal) kind empirical {
    label en official "the area's size in acres, whether it is contiguous and compact, and the share of the financed area to be provided (pursuant to the issue and all other such issues) to 1 person (related persons are 1 person; an area provided to a developer on a short-term interim basis is not counted)";
}
pub relation designated_blighted_area_144c4(issue: BondIssue) kind institutional {
    label en official "a designated blighted area: designated, determined blighted, within the 20 percent designation cap, contiguous and compact and of at least 100 acres (10 acres if not more than 25 percent of the financed area is provided to 1 person)";
}
@source(IRC_S144_C, relation = formalizes, coverage = exact, quote = "Except as provided in clause (ii), an area shall not be treated as a designated blighted area for purposes of this subsection unless such area is contiguous and compact")
rule DesignatedBlightedAreaHundredAcres(issue: BondIssue, pct: Decimal, acres: Integer, share: Decimal) strict {
    label en official "section 144(c)(4)(A)-(D)(i): at least 100 acres";
    when blighted_area_designated_by_local_governing_body_144c4A(issue);
    when governing_body_determined_blight_on_factors_144c4B(issue);
    when designation_percentage_with_others_144c4C(issue, pct);
    when pct <= 0.20;
    when area_size_acres_144c4D(issue, acres, true, share);
    when acres >= 100;
    then designated_blighted_area_144c4(issue);
}
@source(IRC_S144_C, relation = formalizes, coverage = exact, quote = "Clause (i) shall be applied by substituting \"10 acres\" for \"100 acres\" if not more than 25 percent of the financed area is to be provided (pursuant to the issue and all")
rule DesignatedBlightedAreaTenAcres(issue: BondIssue, pct: Decimal, acres: Integer, share: Decimal) strict {
    label en official "section 144(c)(4)(D)(ii): 10 acres in place of 100 if not more than 25 percent of the financed area is provided to 1 person";
    when blighted_area_designated_by_local_governing_body_144c4A(issue);
    when governing_body_determined_blight_on_factors_144c4B(issue);
    when designation_percentage_with_others_144c4C(issue, pct);
    when pct <= 0.20;
    when area_size_acres_144c4D(issue, acres, true, share);
    when acres >= 10;
    when share <= 0.25;
    then designated_blighted_area_144c4(issue);
}
relation issue_pursuant_to_state_law_and_prior_plan_144c2A(issue: BondIssue, state_law_authorizes: Boolean, plan_adopted_before_issuance_by_governing_body: Boolean) kind empirical {
    label en official "the issue is issued pursuant to a State law authorizing such bonds for redevelopment in blighted areas and a redevelopment plan adopted before issuance by the governing body of the designated blighted area";
}
relation payment_secured_by_general_taxes_144c2Bi(issue: BondIssue) kind empirical {
    label en official "payment of principal and interest is primarily secured by taxes of general applicability imposed by a general purpose governmental unit";
}
relation tax_increment_reserved_for_debt_service_144c2Bii(issue: BondIssue) kind empirical {
    label en official "any increase in real property tax revenues attributable to increases in assessed value by reason of carrying out the purposes in the area is reserved exclusively for debt service on the issue (and similar issues) to the extent it does not exceed that debt service";
}
relation real_property_transferred_for_fair_market_value_144c2C(issue: BondIssue) kind empirical {
    label en official "each interest in real property in the area acquired by a governmental unit with the proceeds and transferred to a person other than a governmental unit is transferred for fair market value";
}
relation no_additional_charge_or_tax_difference_144c5(issue: BondIssue, no_extra_charge_or_fee_on_owners_or_users_in_area: Boolean, same_property_tax_assessment_and_rate_as_comparable_outside: Boolean) kind empirical {
    label en official "while any bond of the issue is outstanding, no owner or user of property in the financed area is subject to a charge or fee that similarly situated owners or users of comparable property outside are not subject to, and the assessment method or rate of real property taxes does not differ from that for comparable property outside";
}
relation proceeds_for_144a8_or_147e_facilities_share_144c6A(issue: BondIssue, share: Decimal) kind empirical {
    label en official "the share of the net proceeds to be used to provide (including the land for) facilities described in section 144(a)(8) or 147(e)";
}
relation proceeds_for_golf_club_or_similar_facility_144c6B(issue: BondIssue) kind empirical {
    label en official "any portion of the proceeds is to be used to provide (including the land for) a private or commercial golf course, country club, massage parlor, hot tub facility, suntan facility, racetrack or other gambling facility, or a store the principal business of which is the sale of alcoholic beverages for consumption off premises";
}
pub relation qualified_redevelopment_bond_144c_derived(issue: BondIssue) kind institutional {
    label en official "a qualified redevelopment bond: 95 percent or more of the net proceeds for redevelopment purposes in a designated blighted area, with the requirements of paragraph (2)";
}
@source(IRC_S144_C, relation = formalizes, coverage = exact, quote = "The term \"qualified redevelopment bond\" means any bond issued as part of an issue 95 percent or more of the net proceeds of which are to be used for 1 or more")
rule QualifiedRedevelopmentBondByTaxSecurity(issue: BondIssue, share: Decimal, plan: Boolean, extra: Boolean, same: Boolean, share_a8: Decimal) strict {
    label en official "section 144(c)(1), (2)(A)-(E) with the tax security of (B)(i)";
    when redevelopment_purposes_share_144c3(issue, share);
    when share >= 0.95;
    when designated_blighted_area_144c4(issue);
    when issue_pursuant_to_state_law_and_prior_plan_144c2A(issue, true, true);
    when payment_secured_by_general_taxes_144c2Bi(issue);
    when real_property_transferred_for_fair_market_value_144c2C(issue);
    when no_additional_charge_or_tax_difference_144c5(issue, true, true);
    when proceeds_for_144a8_or_147e_facilities_share_144c6A(issue, share_a8);
    when share_a8 <= 0.25;
    when not_known(proceeds_for_golf_club_or_similar_facility_144c6B(issue));
    then qualified_redevelopment_bond_144c_derived(issue);
}
@source(IRC_S144_C, relation = formalizes, coverage = exact, quote = "(ii) any increase in real property tax revenues (attributable to increases in assessed value) by reason of the carrying out of such purposes in such area is reserved")
rule QualifiedRedevelopmentBondByTaxIncrement(issue: BondIssue, share: Decimal, share_a8: Decimal) strict {
    label en official "section 144(c)(1), (2)(A)-(E) with the tax increment reservation of (B)(ii)";
    when redevelopment_purposes_share_144c3(issue, share);
    when share >= 0.95;
    when designated_blighted_area_144c4(issue);
    when issue_pursuant_to_state_law_and_prior_plan_144c2A(issue, true, true);
    when tax_increment_reserved_for_debt_service_144c2Bii(issue);
    when real_property_transferred_for_fair_market_value_144c2C(issue);
    when no_additional_charge_or_tax_difference_144c5(issue, true, true);
    when proceeds_for_144a8_or_147e_facilities_share_144c6A(issue, share_a8);
    when share_a8 <= 0.25;
    when not_known(proceeds_for_golf_club_or_similar_facility_144c6B(issue));
    then qualified_redevelopment_bond_144c_derived(issue);
}
@source(IRC_S144_C, relation = formalizes, coverage = exact, quote = "Section 147(c) (other than paragraphs (1)(B) and (2) thereof) shall not apply to any qualified redevelopment bond.")
rule QualifiedRedevelopmentBondCategoryDerived(issue: BondIssue) strict {
    label en official "section 141(e)(1)(F) read with the derived section 144(c) status";
    when qualified_redevelopment_bond_144c_derived(issue);
    then qualified_bond_category_141e1(issue);
}
pub relation section_147c_limited_for_redevelopment_144c8(issue: BondIssue) kind institutional {
    label en official "section 147(c) (other than paragraphs (1)(B) and (2)) does not apply to a qualified redevelopment bond";
}
rule Section147cLimitedForRedevelopment(issue: BondIssue) strict {
    label en official "section 144(c)(8)";
    when qualified_redevelopment_bond_144c_derived(issue);
    then section_147c_limited_for_redevelopment_144c8(issue);
}

// =====================================================================
// §145: qualified 501(c)(3) bonds
// =====================================================================

relation hospital_bond_145b1(issue: BondIssue, share_of_net_proceeds_for_hospital: Decimal) kind empirical {
    label en official "the share of the net proceeds of the issue used with respect to a hospital";
}
pub relation qualified_hospital_bond_145b(issue: BondIssue) kind institutional {
    label en official "a qualified hospital bond: 90 percent or more of the net proceeds are used with respect to a hospital";
}
@source(IRC_S145_B, relation = formalizes, coverage = exact, quote = "If 90 percent or more of the net proceeds of an issue are used with respect to a hospital, no bond which is part of such issue shall be taken into account under")
rule QualifiedHospitalBondByNinetyPercent(issue: BondIssue, share: Decimal) strict {
    label en official "section 145(b)(2)(C)(ii): 90 percent or more";
    when hospital_bond_145b1(issue, share);
    when share >= 0.90;
    then qualified_hospital_bond_145b(issue);
}
relation allocated_face_to_501c3_beneficiary_145b1(issue: BondIssue, organization: Person, allocated_face: Money) kind empirical {
    label en official "the aggregate authorized face amount of the issue allocated to the section 501(c)(3) organization that is a test-period beneficiary";
}
relation outstanding_tax_exempt_nonhospital_bond_145b2(issue: BondIssue, organization: Person, bond: us.irc.core::Asset, amount: Money, allocated_to_organization: Boolean, outstanding_at_later_issue: Boolean, redeemed_from_later_proceeds_other_than_advance: Boolean, qualified_501c3_other_than_hospital_or_old_idb: Boolean, share_not_used_for_hospital: Decimal) kind empirical {
    label en official "a tax-exempt nonhospital bond (a qualified 501(c)(3) bond other than a qualified hospital bond, or a pre-1986 industrial development bond to which section 141(a) does not apply that section 103(b)(4), (5) or (6) did not describe), allocated to the organization, its amount, whether it is outstanding at the time of the later issue or to be redeemed (other than in an advance refunding) from its net proceeds, and the share of the proceeds of its issue not used with respect to a hospital (a bond counts only to the extent of that share; none counts if 90 percent or more of its issue's proceeds were used for a hospital)";
}
pub relation outstanding_nonhospital_bonds_of_organization_145b2(issue: BondIssue, organization: Person, amount: Money) kind institutional {
    label en official "the aggregate amount of the organization's outstanding tax-exempt nonhospital bonds at the time of the later issue, each counted only to the extent its proceeds were not used with respect to a hospital";
}
@source(IRC_S145_B, relation = formalizes, coverage = exact, quote = "(i) which are allocated to such organization, and")
rule OutstandingNonhospitalBondsOfOrganization(issue: BondIssue, org: Person, b0: us.irc.core::Asset, a0: Money, al0: Boolean, o0: Boolean, r0: Boolean, q0: Boolean, s0: Decimal) strict {
    label en official "section 145(b)(2)(A)-(C): allocated, outstanding, not redeemed from the later issue's proceeds, of the named kinds, counted to the non-hospital share; (C)(ii) drops a bond whose issue was 90 percent hospital";
    when outstanding_tax_exempt_nonhospital_bond_145b2(issue, org, b0, a0, al0, o0, r0, q0, s0);
    then outstanding_nonhospital_bonds_of_organization_145b2(issue, org, round(sum(collect all a: Money, b: us.irc.core::Asset, al: Boolean, o: Boolean, r: Boolean, q: Boolean, s: Decimal where outstanding_tax_exempt_nonhospital_bond_145b2(issue, org, b, a, al, o, r, q, s) and al == true and o == true and r == false and q == true and s > 0.10, empty: 0.00 USD) , 2, "HALF_UP"));
}
pub relation qualified_501c3_bond_barred_by_150_million_limit_145b1(issue: BondIssue, organization: Person) kind institutional {
    label en official "a bond (other than a qualified hospital bond) is not a qualified 501(c)(3) bond if the face amount of the issue allocated to a test-period beneficiary 501(c)(3) organization, increased by its outstanding tax-exempt nonhospital bonds, exceeds $150,000,000";
}
@source(IRC_S145_B, relation = formalizes, coverage = exact, quote = "A bond (other than a qualified hospital bond) shall not be treated as a qualified 501(c)(3) bond if the aggregate authorized face amount of the issue (of which such bond")
rule Qualified501c3BarredBy150MillionLimit(issue: BondIssue, org: Person, allocated: Money, outstanding: Money) strict {
    label en official "section 145(b)(1)";
    when allocated_face_to_501c3_beneficiary_145b1(issue, org, allocated);
    when outstanding_nonhospital_bonds_of_organization_145b2(issue, org, outstanding);
    when not_known(qualified_hospital_bond_145b(issue));
    when allocated + outstanding > 150000000.00 USD;
    then qualified_501c3_bond_barred_by_150_million_limit_145b1(issue, org);
}
relation bond_issued_after_145b5_enactment_with_capital_expenditures_145b5(issue: BondIssue, issued_after_enactment_date: Boolean, share_for_capital_expenditures_incurred_after: Decimal) kind empirical {
    label en official "the bond is issued after the date of enactment of paragraph (5) (August 5, 1997) as part of an issue 95 percent or more of the net proceeds of which finance capital expenditures incurred after that date";
}
pub relation section_145b_limit_does_not_apply_145b5(issue: BondIssue) kind institutional {
    label en official "subsection (b) does not apply to such bonds";
}
@source(IRC_S145_B, relation = formalizes, coverage = exact, quote = "This subsection shall not apply with respect to bonds issued after the date of the enactment of this paragraph as part of an issue 95 percent or more of the net proceeds")
rule Section145bLimitDoesNotApply(issue: BondIssue, share: Decimal) strict {
    label en official "section 145(b)(5)";
    when bond_issued_after_145b5_enactment_with_capital_expenditures_145b5(issue, true, share);
    when share >= 0.95;
    then section_145b_limit_does_not_apply_145b5(issue);
}
pub relation section_144a10CDE_rules_similar_for_145b_145b4(issue: BondIssue) kind institutional {
    label en official "rules similar to those of section 144(a)(10)(C), (D) and (E) apply: allocation of the face amount by share of use or ownership, the 3-year test period, and related persons as one person (the derived relations of section 144(a)(10) are read by the 145(b) tests)";
}
@source(IRC_S145_B, relation = formalizes, coverage = exact, quote = "Rules similar to the rules of subparagraphs (C), (D), and (E) of section 144(a)(10) shall apply for purposes of this subsection.")
rule Section144a10CDERulesSimilarFor145b(issue: BondIssue, org: Person, allocated: Money) strict {
    label en official "section 145(b)(4): the allocation used by (b)(1) is the section 144(a)(10)(C) allocation";
    when allocated_face_to_501c3_beneficiary_145b1(issue, org, allocated);
    when test_period_beneficiary_144a10D(issue, org);
    then section_144a10CDE_rules_similar_for_145b_145b4(issue);
}
relation net_proceeds_for_residential_rental_property_for_family_units_145d1(issue: BondIssue, amount: Money) kind empirical {
    label en official "a portion of the net proceeds is to be used directly or indirectly to provide residential rental property for family units";
}
relation first_use_pursuant_to_this_issue_145d2A(issue: BondIssue) kind empirical {
    label en official "the first use of the residential rental property is pursuant to this issue";
}
relation first_use_by_taxable_financing_replaced_by_tax_exempt_145d3A(issue: BondIssue, first_use_pursuant_to_taxable_financing: Boolean, reasonably_expected_replacement: Boolean, replaced_within_reasonable_period: Boolean) kind empirical {
    label en official "the first use is pursuant to taxable financing, there was a reasonable expectation at that time that it would be replaced by tax-exempt financing, and it is in fact so replaced within a reasonable period";
}
relation no_operating_tax_exempt_program_at_first_use_145d3B(issue: BondIssue) kind empirical {
    label en official "at the time of the first use there was no operating State or local program for tax-exempt financing of the property";
}
relation first_tax_exempt_financing_is_this_issue_145d3B(issue: BondIssue) kind empirical {
    label en official "the issue is the first tax-exempt financing of the property";
}
pub relation first_use_treated_as_pursuant_to_tax_exempt_financing_145d3(issue: BondIssue) kind institutional {
    label en official "for the first-use test of (d)(2)(A): a first use pursuant to taxable financing that is replaced by tax-exempt financing, or a first use with no operating program where the issue is the first tax-exempt financing, is treated as pursuant to the tax-exempt financing";
}
@source(IRC_S145_D, relation = formalizes, coverage = exact, quote = "If—")
rule FirstUseTreatedAsTaxExemptByReplacement(issue: BondIssue) strict {
    label en official "section 145(d)(3)(A)(i)-(iii)";
    when first_use_by_taxable_financing_replaced_by_tax_exempt_145d3A(issue, true, true, true);
    then first_use_treated_as_pursuant_to_tax_exempt_financing_145d3(issue);
}
@source(IRC_S145_D, relation = formalizes, coverage = exact, quote = "If, at the time of the 1st use of property, there was no operating State or local program for tax-exempt financing of the property, the 1st use of the property shall be")
rule FirstUseTreatedAsTaxExemptWithoutProgram(issue: BondIssue) strict {
    label en official "section 145(d)(3)(B)";
    when no_operating_tax_exempt_program_at_first_use_145d3B(issue);
    when first_tax_exempt_financing_is_this_issue_145d3B(issue);
    then first_use_treated_as_pursuant_to_tax_exempt_financing_145d3(issue);
}
relation property_substantially_rehabilitated_within_window_145d2C(issue: BondIssue, rehabilitation_begins_within_2_years_ending_1_year_after_acquisition: Boolean, substantially_rehabilitated_47c1B: Boolean) kind empirical {
    label en official "the property is to be substantially rehabilitated (rules similar to section 47(c)(1)(B)) in a rehabilitation beginning within the 2-year period ending 1 year after the date of acquisition";
}
pub relation residential_rental_exception_145d2_met(issue: BondIssue) kind institutional {
    label en official "the residential rental property is within an exception of (d)(2): first use pursuant to the issue, a qualified residential rental project, or substantially rehabilitated";
}
@source(IRC_S145_D, relation = formalizes, coverage = exact, quote = "(A) a residential rental property for family units if the first use of such property is pursuant to such issue,")
rule ResidentialRentalExceptionFirstUse(issue: BondIssue) strict {
    label en official "section 145(d)(2)(A), with the (d)(3) first-use rules";
    when first_use_pursuant_to_this_issue_145d2A(issue);
    then residential_rental_exception_145d2_met(issue);
}
@source(IRC_S145_D, relation = formalizes, coverage = exact, quote = "(A) a residential rental property for family units if the first use of such property is pursuant to such issue,")
rule ResidentialRentalExceptionFirstUseByRule(issue: BondIssue) strict {
    label en official "section 145(d)(2)(A), (d)(3)";
    when first_use_treated_as_pursuant_to_tax_exempt_financing_145d3(issue);
    then residential_rental_exception_145d2_met(issue);
}
@source(IRC_S145_D, relation = formalizes, coverage = exact, quote = "(B) qualified residential rental projects (as defined in section 142(d)), or")
rule ResidentialRentalExceptionQualifiedProject(issue: BondIssue, project: ResidentialRentalProject142) strict {
    label en official "section 145(d)(2)(B): a qualified residential rental project";
    when project_of_issue_142d(issue, project);
    when qualified_residential_rental_project_142d1(project);
    then residential_rental_exception_145d2_met(issue);
}
@source(IRC_S145_D, relation = formalizes, coverage = exact, quote = "(C) property which is to be substantially rehabilitated in a rehabilitation beginning within the 2-year period ending 1 year after the date of the acquisition of such")
rule ResidentialRentalExceptionRehabilitation(issue: BondIssue) strict {
    label en official "section 145(d)(2)(C), (d)(4)";
    when property_substantially_rehabilitated_within_window_145d2C(issue, true, true);
    then residential_rental_exception_145d2_met(issue);
}
pub relation qualified_501c3_bond_barred_residential_rental_145d1(issue: BondIssue) kind institutional {
    label en official "a bond is not a qualified 501(c)(3) bond if any portion of the net proceeds is to be used directly or indirectly to provide residential rental property for family units, unless an exception of (d)(2) applies";
}
@source(IRC_S145_D, relation = formalizes, coverage = exact, quote = "Except as otherwise provided in this subsection, a bond which is part of an issue shall not be a qualified 501(c)(3) bond if any portion of the net proceeds of the issue")
rule Qualified501c3BarredResidentialRental(issue: BondIssue, amount: Money) strict {
    label en official "section 145(d)(1)-(2)";
    when net_proceeds_for_residential_rental_property_for_family_units_145d1(issue, amount);
    when amount > 0.00 USD;
    when not_known(residential_rental_exception_145d2_met(issue));
    then qualified_501c3_bond_barred_residential_rental_145d1(issue);
}
relation issuer_elects_out_of_145_145e1(issue: BondIssue) kind empirical {
    label en official "the issuer elects not to have section 145 apply to the issue";
}
relation issue_is_exempt_facility_or_redevelopment_bond_subject_to_146_145e2(issue: BondIssue) kind empirical {
    label en official "the issue is an issue of exempt facility bonds, or qualified redevelopment bonds, to which section 146 applies";
}
pub relation section_145_not_applicable_145e(issue: BondIssue) kind institutional {
    label en official "section 145 does not apply to the issue: the issuer elects out and the issue is an exempt facility or qualified redevelopment issue subject to the volume cap";
}
@source(IRC_S145_E, relation = formalizes, coverage = exact, quote = "This section shall not apply to an issue if—")
rule Section145NotApplicableByElection(issue: BondIssue) strict {
    label en official "section 145(e)(1)-(2)";
    when issuer_elects_out_of_145_145e1(issue);
    when issue_is_exempt_facility_or_redevelopment_bond_subject_to_146_145e2(issue);
    then section_145_not_applicable_145e(issue);
}
