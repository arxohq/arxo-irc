// Sections 73-91 (other than 83 and 86, formalized in earlier stages) — items
// specifically included in gross income. Stage 2e (IRC-06), DECISION-0379.
// STATUS: implemented_unverified (static check only; scenarios in
// tests/s73-91-other-inclusions.lawtest are NOT executed).
//
//   §73   services of a child
//   §74   prizes and awards ((a) general, (b) charity transfer, (c) employee
//         achievement awards, (d) Olympic and Paralympic medals)
//   §75   municipal-bond dealers ((b) definitions; (a) needs section 171 /
//         1016(a)(5) amortizable-premium amounts: EXTERNAL_DEPENDENCY)
//   §77   Commodity Credit Corporation loans (election power + adherence duty)
//   §78   foreign tax credit gross-up dividend
//   §79   group-term life insurance
//   §80   restoration of foreign expropriation losses
//   §82   moving expense reimbursements
//   §84   transfers of appreciated property to political organizations
//   §85   unemployment compensation (incl. the 2020 exclusion)
//   §87   alcohol, biodiesel and sustainable aviation fuel credits
//   §88   nuclear decommissioning costs
//   §90   illegal Federal irrigation subsidies
//   §91   foreign branch loss recapture
//
// Where a section says "gross income includes X", the rule concludes a
// section-specific includible-amount relation; a case package feeds it to
// `gross_income_item(p, y, <kind>, amount)` as in s61-gross-income.law (the
// s61 aggregation is deliberately over case-asserted items).

// =====================================================================
// §73: services of a child
// =====================================================================

use self::{
    IRC_S73_A,
    IRC_S73_B,
    IRC_S73_C,
    IRC_S74_A,
    IRC_S74_B,
    IRC_S74_C,
    IRC_S74_D,
    IRC_S75_B,
    IRC_S77_A,
    IRC_S77_B,
    IRC_S78,
    IRC_S79_A,
    IRC_S79_B,
    IRC_S79_D,
    IRC_S80_A,
    IRC_S80_C,
    IRC_S82,
    IRC_S84_A,
    IRC_S84_B,
    IRC_S85_A,
    IRC_S85_C,
    IRC_S87,
    IRC_S88,
    IRC_S90_A,
    IRC_S90_B,
    IRC_S90_C,
    IRC_S91_B,
    IRC_S91_C,
    IRC_S91_D,
    Individual,
    Person,
    Secretary,
    TaxableYear,
    adjusted_gross_income,
    disabled_72m7,
    section_78_amended_inputs_present_78,
};

pub relation amount_received_in_respect_of_services_of_child(parent: Individual, child: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "an amount received in respect of the services of a child, whether or not received by the child (section 73(a)); `parent` is the person who received it";
}
relation entitled_to_services_by_parental_rights(person: Individual, child: Individual) kind empirical {
    label en official "the individual is entitled to the services of the child by reason of having parental rights and duties in respect of the child (section 73(c))";
}
relation legal_parent_of(person: Individual, child: Individual) kind empirical {
    label en official "the individual is a parent of the child";
}
pub relation parent_for_section_73(person: Individual, child: Individual) kind institutional {
    label en official "parent, for purposes of section 73: includes an individual entitled to the services of the child by reason of parental rights and duties";
}
@source(IRC_S73_C, relation = formalizes, coverage = exact, quote = "the term \"parent\" includes an individual who is entitled to the services of a child by reason of having parental rights and duties in respect of the child.")
rule ParentIncludesPersonWithParentalRights(person: Individual, child: Individual) strict {
    label en official "section 73(c)";
    when entitled_to_services_by_parental_rights(person, child);
    then parent_for_section_73(person, child);
}
@source(IRC_S73_C, relation = formalizes, coverage = partial, quote = "the term \"parent\" includes")
rule ParentIncludesLegalParent(person: Individual, child: Individual) strict {
    label en official "a parent in the ordinary sense is a parent (\"includes\" is not exhaustive)";
    when legal_parent_of(person, child);
    then parent_for_section_73(person, child);
}
pub relation child_services_amount_includible_by_child_73a(child: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount received in respect of the child's services is included in the child's gross income";
}
@source(IRC_S73_A, relation = formalizes, coverage = exact, quote = "Amounts received in respect of the services of a child shall be included in his gross income")
rule ChildServicesIncludedInChildIncome(parent: Individual, child: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 73(a), first clause";
    when amount_received_in_respect_of_services_of_child(parent, child, y, amount);
    when parent_for_section_73(parent, child);
    then child_services_amount_includible_by_child_73a(child, y, amount);
}
pub relation child_services_amount_not_includible_by_parent_73a(parent: Individual, child: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount is not included in the parent's gross income, even though not received by the child (section 73(a), second clause)";
}
@source(IRC_S73_A, relation = formalizes, coverage = exact, quote = "and not in the gross income of the parent, even though such amounts are not received by the child.")
rule ChildServicesNotIncludedInParentIncome(parent: Individual, child: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 73(a), second clause";
    when amount_received_in_respect_of_services_of_child(parent, child, y, amount);
    when parent_for_section_73(parent, child);
    then child_services_amount_not_includible_by_parent_73a(parent, child, y, amount);
}
relation expenditure_attributable_to_child_services_income(payer: Individual, child: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "an expenditure by the parent or the child attributable to amounts includible in the child's gross income solely by reason of section 73(a) (section 73(b))";
}
pub relation expenditure_treated_as_paid_by_child_73b(child: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the expenditure is treated as paid or incurred by the child";
}
@source(IRC_S73_B, relation = formalizes, coverage = exact, quote = "shall be treated as paid or incurred by the child.")
rule ExpenditureTreatedAsPaidByChild(payer: Individual, child: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 73(b)";
    when expenditure_attributable_to_child_services_income(payer, child, y, amount);
    then expenditure_treated_as_paid_by_child_73b(child, y, amount);
}

// =====================================================================
// §74: prizes and awards
// =====================================================================

pub entity PrizeOrAward {
    label en unofficial "a prize or award received by an individual (section 74); case-asserted, one entity per award";
}
pub relation prize_or_award_received(p: Individual, y: TaxableYear, award: PrizeOrAward, amount: Money) kind empirical {
    label en official "amounts received as prizes and awards (section 74(a)); the amount is the value received";
}
relation prize_in_recognition_of_achievement(award: PrizeOrAward) kind empirical {
    label en official "the prize or award is made primarily in recognition of religious, charitable, scientific, educational, artistic, literary, or civic achievement (section 74(b))";
}
relation recipient_selected_without_action_to_enter(award: PrizeOrAward) kind empirical {
    label en official "the recipient was selected without any action on the recipient's part to enter the contest or proceeding (section 74(b)(1))";
}
relation no_substantial_future_services_required(award: PrizeOrAward) kind empirical {
    label en official "the recipient is not required to render substantial future services as a condition to receiving the prize or award (section 74(b)(2))";
}
relation prize_transferred_to_charity_by_designation(award: PrizeOrAward) kind empirical {
    label en official "the prize or award is transferred by the payor to a governmental unit or organization described in paragraph (1) or (2) of section 170(c) pursuant to a designation made by the recipient (section 74(b)(3))";
}
pub relation prize_excluded_74b(award: PrizeOrAward) kind institutional {
    label en official "the prize or award is excluded from gross income under section 74(b)";
}
@source(IRC_S74_B, relation = formalizes, coverage = exact, quote = "Gross income does not include amounts received as prizes and awards made primarily in recognition of religious, charitable, scientific, educational, artistic, literary, or civic achievement, but only if—")
rule PrizeExcludedWhenTransferredToCharity(award: PrizeOrAward) strict {
    label en official "section 74(b)(1)-(3), all three conditions plus the achievement purpose";
    when prize_in_recognition_of_achievement(award);
    when recipient_selected_without_action_to_enter(award);
    when no_substantial_future_services_required(award);
    when prize_transferred_to_charity_by_designation(award);
    then prize_excluded_74b(award);
}

// (c) employee achievement awards
relation employee_achievement_award_274j(award: PrizeOrAward) kind empirical {
    label en official "the prize is an employee achievement award as defined in section 274(j) (EXTERNAL_DEPENDENCY: the section 274(j) definition is not carried here)";
}
relation award_cost_to_employer(award: PrizeOrAward, cost: Money) kind empirical {
    label en official "the cost to the employer of the employee achievement award";
}
relation award_deduction_allowable_to_employer(award: PrizeOrAward, amount: Money) kind empirical {
    label en official "the amount allowable as a deduction to the employer for the cost of the award (section 74(c)(1))";
}
relation award_employer_exempt_from_tax(award: PrizeOrAward) kind empirical {
    label en official "the employer is exempt from taxation under this subtitle (section 74(c)(3))";
}
relation award_hypothetical_deduction_if_employer_taxable(award: PrizeOrAward, amount: Money) kind empirical {
    label en official "the amount that would be allowable as a deduction to the employer if the employer were not exempt from taxation (section 74(c)(3))";
}
relation award_deduction_amount_for_74c(award: PrizeOrAward, amount: Money) kind institutional {
    label en official "the amount treated as allowable as a deduction to the employer for section 74(c): the actual amount, or for a tax-exempt employer the hypothetical amount (section 74(c)(3))";
}
@source(IRC_S74_C, relation = formalizes, coverage = exact, quote = "any reference in this subsection to the amount allowable as a deduction to the employer shall be treated as a reference to the amount which would be allowable as a deduction to the employer if the employer were not exempt from taxation under this subtitle.")
rule AwardDeductionAmountTaxExemptEmployer(award: PrizeOrAward, hypothetical: Money) strict {
    label en official "section 74(c)(3)";
    when award_employer_exempt_from_tax(award);
    when award_hypothetical_deduction_if_employer_taxable(award, hypothetical);
    then award_deduction_amount_for_74c(award, hypothetical);
}
@source(IRC_S74_C, relation = formalizes, coverage = partial, quote = "if the cost to the employer of the employee achievement award does not exceed the amount allowable as a deduction to the employer for the cost of the employee achievement award.")
rule AwardDeductionAmountTaxableEmployer(award: PrizeOrAward, allowable: Money) strict {
    label en official "section 74(c)(1): an employer that is not exempt uses the amount actually allowable";
    when award_deduction_allowable_to_employer(award, allowable);
    when not_known(award_employer_exempt_from_tax(award));
    then award_deduction_amount_for_74c(award, allowable);
}
pub relation employee_achievement_award_includible_74c(p: Individual, y: TaxableYear, award: PrizeOrAward, amount: Money) kind institutional {
    label en official "the part of the value of an employee achievement award includible in the recipient's gross income: zero where cost does not exceed the allowable deduction; otherwise the greater of (A) the non-deductible part of cost (not more than the value) or (B) value minus the deductible amount";
}
@source(IRC_S74_C, relation = formalizes, coverage = exact, quote = "Gross income shall not include the value of an employee achievement award (as defined in section 274(j)) received by the taxpayer if the cost to the employer of the employee achievement award does not exceed the amount allowable as a deduction to the employer for the cost of the employee achievement award.")
rule AchievementAwardExcludedWhenCostWithinDeduction(p: Individual, y: TaxableYear, award: PrizeOrAward, value: Money, cost: Money, deductible: Money) strict {
    label en official "section 74(c)(1)";
    when prize_or_award_received(p, y, award, value);
    when employee_achievement_award_274j(award);
    when award_cost_to_employer(award, cost);
    when award_deduction_amount_for_74c(award, deductible);
    when cost <= deductible;
    then employee_achievement_award_includible_74c(p, y, award, 0.00 USD);
}
@source(IRC_S74_C, relation = formalizes, coverage = exact, quote = "then gross income includes the greater of—")
rule AchievementAwardExcessDeductionInclusion(p: Individual, y: TaxableYear, award: PrizeOrAward, value: Money, cost: Money, deductible: Money) strict {
    label en official "section 74(c)(2)(A)-(B): the remaining portion of the value is not included";
    when prize_or_award_received(p, y, award, value);
    when employee_achievement_award_274j(award);
    when award_cost_to_employer(award, cost);
    when award_deduction_amount_for_74c(award, deductible);
    when cost > deductible;
    then employee_achievement_award_includible_74c(p, y, award,
        max(min(round(cost - deductible, 2, "HALF_UP"), value), max(0.00 USD, round(value - deductible, 2, "HALF_UP"))));
}

// (d) Olympic and Paralympic medals and prizes
pub relation olympic_medal_or_uscp_prize_received(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the value of a medal awarded in, or prize money received from the United States Olympic Committee on account of, competition in the Olympic Games or Paralympic Games (section 74(d)(1))";
}
relation agi_without_regard_to_74d(p: Individual, y: TaxableYear, agi: Money) kind empirical {
    label en official "the adjusted gross income of the taxpayer for the year determined without regard to section 74(d) (section 74(d)(2)(A)); reading it as the ordinary section 62 result would be circular";
}
pub relation olympic_award_exclusion_74d(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount excluded from gross income under section 74(d)(1)";
}
@source(IRC_S74_D, relation = formalizes, coverage = exact, quote = "Gross income shall not include the value of any medal awarded in, or any prize money received from the United States Olympic Committee on account of, competition in the Olympic Games or Paralympic Games.")
rule OlympicAwardExcludedUnderLimit(p: Individual, y: TaxableYear, amount: Money, agi: Money, s: us.irc.income_individual::FilingStatus) strict {
    label en official "section 74(d)(1) with the (d)(2)(A) limitation: not applicable if AGI exceeds $1,000,000 ($500,000 for a married individual filing a separate return) — AGI equal to the limit is still within";
    when olympic_medal_or_uscp_prize_received(p, y, amount);
    when agi_without_regard_to_74d(p, y, agi);
    when us.irc.income_individual::filing_status(p, y, s);
    when s != us.irc.income_individual::MarriedSeparate;
    when agi <= 1000000.00 USD;
    when not_known(has_computed_agi_for_ordering_74d_85c(p, y)); // G4501 wiring: the computed AGI variant below
    then olympic_award_exclusion_74d(p, y, amount);
}
@source(IRC_S74_D, relation = formalizes, coverage = exact, quote = "(half of such amount in the case of a married individual filing a separate return)")
rule OlympicAwardExcludedUnderLimitMarriedSeparate(p: Individual, y: TaxableYear, amount: Money, agi: Money) strict {
    label en official "section 74(d)(2)(A), married individual filing separately: half of $1,000,000";
    when olympic_medal_or_uscp_prize_received(p, y, amount);
    when agi_without_regard_to_74d(p, y, agi);
    when us.irc.income_individual::filing_status(p, y, us.irc.income_individual::MarriedSeparate);
    when agi <= 500000.00 USD;
    when not_known(has_computed_agi_for_ordering_74d_85c(p, y)); // G4501 wiring: the computed AGI variant below
    then olympic_award_exclusion_74d(p, y, amount);
}
// =====================================================================
// G4501 wiring: the ordering of adjusted gross income in §74(d)(2)(B) and §85(c)(2)
// =====================================================================
// §74(d)(2)(B): "adjusted gross income shall be determined after the application of paragraph (1) and before the
// application of subparagraph (A)"; §85(c)(2): the adjusted gross income of the taxpayer is determined "(A) after
// application of sections 86, 135, 137, 219, 221, 222, and 469, and (B) without regard to this section". Each
// section reads an AGI that the others also read, so the statute names an ORDER, not a fixpoint. No fixpoint
// construct is needed: the `adjusted_gross_income` of `s62-agi` is computed from the items the case asserts, and
// neither exclusion (§74(d), §85(c)) is subtracted from those items (an exclusion here is an OUTPUT relation, not a
// change of the asserted items). Reading that computed AGI therefore is the AGI "before" §74(d)(2)(A) / "without
// regard to" §85(c). JUDGMENT CALL: the asserted items must already carry the effects of sections 86, 135, 137
// (as inclusions or exclusions) and the above-the-line deductions of sections 219, 221, 222 (as
// `above_the_line_deduction_amount`), and the §469 limit as the case applies it; this package does not compute
// those sections' amounts into `gross_income_item`. The asserted `agi_without_regard_to_74d` / `agi_for_85c`
// stay usable when no computed AGI exists.
relation has_computed_agi_for_ordering_74d_85c(p: Individual, y: TaxableYear) kind institutional {
    label en official "the adjusted gross income of the year is computed by section 62 from the asserted items (the ordering of section 74(d)(2)(B) and section 85(c)(2))";
}
rule HasComputedAgiForOrdering74d85c(p: Individual, y: TaxableYear, agi: Money) strict {
    when adjusted_gross_income(p, y, agi);
    then has_computed_agi_for_ordering_74d_85c(p, y);
}
@source(IRC_S74_D, relation = formalizes, coverage = exact, quote = "For purposes of sections 85(c), 86, 135, 137, 219, 221, and 469, adjusted gross income shall be determined after the application of paragraph (1) and before the application of subparagraph (A).")
rule OlympicAwardExcludedUnderLimitComputedAgi(p: Individual, y: TaxableYear, amount: Money, agi: Money, s: us.irc.income_individual::FilingStatus) strict {
    label en official "section 74(d)(1) with (d)(2)(B): the exclusion under the AGI limit read from the computed adjusted gross income";
    when olympic_medal_or_uscp_prize_received(p, y, amount);
    when adjusted_gross_income(p, y, agi);
    when us.irc.income_individual::filing_status(p, y, s);
    when s != us.irc.income_individual::MarriedSeparate;
    when agi <= 1000000.00 USD;
    then olympic_award_exclusion_74d(p, y, amount);
}
@source(IRC_S74_D, relation = formalizes, coverage = exact, quote = "(half of such amount in the case of a married individual filing a separate return)")
rule OlympicAwardExcludedUnderLimitMarriedSeparateComputedAgi(p: Individual, y: TaxableYear, amount: Money, agi: Money) strict {
    label en official "section 74(d)(1) with (d)(2)(B): the married-filing-separately limit read from the computed adjusted gross income";
    when olympic_medal_or_uscp_prize_received(p, y, amount);
    when adjusted_gross_income(p, y, agi);
    when us.irc.income_individual::filing_status(p, y, us.irc.income_individual::MarriedSeparate);
    when agi <= 500000.00 USD;
    then olympic_award_exclusion_74d(p, y, amount);
}

// (a) general inclusion
relation prize_qualified_scholarship_117(award: PrizeOrAward) kind empirical {
    label en official "the amount is a qualified scholarship excluded under section 117 (section 74(a), \"or in section 117\"); this package's section 117 module derives that status, the case links the award";
}
relation prize_excepted_from_74a(award: PrizeOrAward) kind institutional {
    label en official "helper: the prize or award is within an exception of section 74(b), (c)(1), (d) or section 117";
}
rule PrizeExceptedBy74b(award: PrizeOrAward) strict {
    label en official "section 74(b)";
    when prize_excluded_74b(award);
    then prize_excepted_from_74a(award);
}
rule PrizeExceptedBySection117(award: PrizeOrAward) strict {
    label en official "section 117 exception named in section 74(a)";
    when prize_qualified_scholarship_117(award);
    then prize_excepted_from_74a(award);
}
pub relation prize_or_award_includible_74a(p: Individual, y: TaxableYear, award: PrizeOrAward, amount: Money) kind institutional {
    label en official "the amount of a prize or award included in gross income under section 74(a)";
}
@source(IRC_S74_A, relation = formalizes, coverage = exact, quote = "gross income includes amounts received as prizes and awards.")
rule PrizeIncludedGeneralRule(p: Individual, y: TaxableYear, award: PrizeOrAward, amount: Money) strict {
    label en official "section 74(a): general inclusion unless excepted by (b), by (c) (which has its own includible amount), (d) or section 117";
    when prize_or_award_received(p, y, award, amount);
    when not_known(prize_excepted_from_74a(award));
    when not_known(employee_achievement_award_274j(award));
    when not_known(olympic_award_exclusion_74d(p, y, amount));
    then prize_or_award_includible_74a(p, y, award, amount);
}

// =====================================================================
// §75: dealers in tax-exempt bonds — definitions
// =====================================================================

pub relation obligation_of_government_with_excludable_interest(bond: us.irc.core::Asset) kind empirical {
    label en official "an obligation issued by a government or political subdivision thereof if the interest on it is excludable from gross income (section 75(b)(1), lead-in)";
}
relation bond_disposed_within_30_days_of_acquisition(bond: us.irc.core::Asset) kind empirical {
    label en official "the obligation is sold or otherwise disposed of by the taxpayer within 30 days after acquisition (section 75(b)(1)(A)(i))";
}
relation bond_earliest_maturity_or_call_more_than_5_years(bond: us.irc.core::Asset) kind empirical {
    label en official "the obligation's earliest maturity or call date is more than 5 years from the date it was acquired (section 75(b)(1)(A)(ii))";
}
relation bond_disposition_value_exceeds_adjusted_basis(bond: us.irc.core::Asset) kind empirical {
    label en official "when disposed of, the amount realized (sale) or fair market value (other disposition), exclusive of interest, is higher than the adjusted basis computed without regard to section 75 and section 1016(a)(6) (section 75(b)(1)(B))";
}
relation bond_removed_from_75_definition(bond: us.irc.core::Asset) kind institutional {
    label en official "helper: the obligation is carved out of the municipal-bond definition by (b)(1)(A) and (B) together";
}
rule MunicipalBondCarveOutShortHold(bond: us.irc.core::Asset) strict {
    label en official "section 75(b)(1): (A)(i) and (B)";
    when bond_disposed_within_30_days_of_acquisition(bond);
    when bond_disposition_value_exceeds_adjusted_basis(bond);
    then bond_removed_from_75_definition(bond);
}
rule MunicipalBondCarveOutLongMaturity(bond: us.irc.core::Asset) strict {
    label en official "section 75(b)(1): (A)(ii) and (B)";
    when bond_earliest_maturity_or_call_more_than_5_years(bond);
    when bond_disposition_value_exceeds_adjusted_basis(bond);
    then bond_removed_from_75_definition(bond);
}
pub relation municipal_bond_75b1(bond: us.irc.core::Asset) kind institutional {
    label en official "a municipal bond within the meaning of section 75(b)(1)";
}
@source(IRC_S75_B, relation = formalizes, coverage = exact, quote = "The term \"municipal bond\" means any obligation issued by a government or political subdivision thereof if the interest on such obligation is excludable from gross income; but such term does not include such an obligation if—")
rule MunicipalBondDefined(bond: us.irc.core::Asset) strict {
    label en official "section 75(b)(1)";
    when obligation_of_government_with_excludable_interest(bond);
    when not_known(bond_removed_from_75_definition(bond));
    then municipal_bond_75b1(bond);
}
relation opening_inventory_value(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the inventory value of the opening inventory for the year (section 75(b)(2)(A))";
}
relation securities_purchased_includible_in_inventory(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the cost of securities and other property purchased during the year that would properly be included in inventory if on hand at year end (section 75(b)(2)(B))";
}
relation closing_inventory_value(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the inventory value of the closing inventory of the year";
}
pub relation cost_of_securities_sold_75b2(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the cost of securities sold: opening inventory plus purchases minus closing inventory";
}
@source(IRC_S75_B, relation = formalizes, coverage = exact, quote = "The term \"cost of securities sold\" means the amount ascertained by subtracting the inventory value of the closing inventory of a taxable year from the sum of—")
rule CostOfSecuritiesSoldComputed(p: Individual, y: TaxableYear, opening: Money, purchases: Money, closing: Money) strict {
    label en official "section 75(b)(2)";
    when opening_inventory_value(p, y, opening);
    when securities_purchased_includible_in_inventory(p, y, purchases);
    when closing_inventory_value(p, y, closing);
    then cost_of_securities_sold_75b2(p, y, round((opening + purchases) - closing, 2, "HALF_UP"));
}

// =====================================================================
// §77: Commodity Credit Corporation loans (power) and adherence (duty)
// =====================================================================

pub relation ccc_loan_received(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "amounts received as loans from the Commodity Credit Corporation in the taxable year (section 77(a))";
}
relation ccc_loan_recipient_in_year(p: Individual, y: TaxableYear) kind institutional {
    label en official "helper for valid_when: the taxpayer received a CCC loan in the year";
}
rule CccLoanRecipientHelper(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "helper";
    when ccc_loan_received(p, y, amount);
    then ccc_loan_recipient_in_year(p, y);
}
pub relation elects_to_treat_ccc_loans_as_income(p: Individual, y: TaxableYear) kind empirical {
    label en official "the taxpayer elects to have CCC loans considered as income and included in gross income for the year received (section 77(a))";
}
pub relation ccc_loans_treated_as_income_77a(p: Individual, y: TaxableYear) kind institutional {
    label en official "the section 77(a) election is in effect for the year: CCC loans received are income in the year received";
}
@source(IRC_S77_A, relation = formalizes, coverage = exact, quote = "shall, at the election of the taxpayer, be considered as income and shall be included in gross income for the taxable year in which received.")
rule Section77ElectionPowerRule(p: Individual, y: TaxableYear) strict {
    label en official "section 77(a): the taxpayer's election is a power; valid only for a year in which a CCC loan was received; an invalid exercise has no effect (E-0239)";
    when us.irc.core::year_of(p, y);
    then power Section77AElection {
        holder p;
        over y;
        exercise elects_to_treat_ccc_loans_as_income(p, y);
        valid_when ccc_loan_recipient_in_year(p, y);
        effect create(ccc_loans_treated_as_income_77a(p, y));
        window [-infinity, infinity];
    };
}
pub relation ccc_loan_amount_includible_77a(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the CCC loan amount included in gross income for the year received under the section 77(a) election";
}
rule CccLoanAmountIncluded(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 77(a), consequence of a valid election";
    when ccc_loans_treated_as_income_77a(p, y);
    when ccc_loan_received(p, y, amount);
    then ccc_loan_amount_includible_77a(p, y, amount);
}
relation ccc_election_made_in_earlier_year(p: Individual, y: TaxableYear) kind empirical {
    label en official "the taxpayer exercised the section 77(a) election for an earlier taxable year (section 77(b))";
}
relation secretary_authorizes_change_of_method(p: Individual, y: TaxableYear) kind empirical {
    label en official "the Secretary approves a change to a different method of computing income for the year (section 77(b))";
}
pub relation uses_ccc_loan_income_method(p: Individual, y: TaxableYear) kind empirical {
    label en official "the taxpayer computes income for the year by treating CCC loans as income, the method adopted by the election";
}
@source(IRC_S77_B, relation = formalizes, coverage = exact, quote = "then the method of computing income so adopted shall be adhered to with respect to all subsequent taxable years unless with the approval of the Secretary a change to a different method is authorized.")
rule Section77BAdherenceDutyRule defeasible {
    for p: Individual;
    for y: TaxableYear;
    when ccc_election_made_in_earlier_year(p, y);
    then duty Section77BAdherenceDuty {
        bearer p;
        beneficiary Secretary;
        goal maintenance {
            condition uses_ccc_loan_income_method(p, y);
            window [-infinity, infinity];
        }
    };
    unless secretary_authorizes_change_of_method(p, y) and ccc_election_made_in_earlier_year(p, y);
}

// =====================================================================
// §78: foreign tax credit gross-up
// =====================================================================

pub relation domestic_corporation_chooses_foreign_tax_credit(corp: Person, y: TaxableYear) kind empirical {
    label en official "a domestic corporation chooses to have the benefits of subpart A of part III of subchapter N (foreign tax credit) for the taxable year (section 78)";
}
pub relation deemed_paid_taxes_960_for_78(corp: Person, y: TaxableYear, foreign_corp: Person, amount: Money) kind empirical {
    label en official "the taxes deemed to be paid by the corporation under section 960(a), (b) and (d), determined without regard to the phrase \"80 percent of\" in section 960(d)(1) (EXTERNAL_DEPENDENCY: section 960 belongs to the international package; the amount is a case fact)";
}
pub relation section_78_gross_up_dividend(corp: Person, y: TaxableYear, foreign_corp: Person, amount: Money) kind institutional {
    label en official "an amount treated for purposes of the title (other than sections 245 and 245A) as a dividend received by the domestic corporation from the foreign corporation";
}
@source(IRC_S78, relation = formalizes, coverage = exact, quote = "shall be treated for purposes of this title (other than sections 245 and 245A) as a dividend received by such domestic corporation from the foreign corporation.")
rule Section78GrossUpDividend(corp: Person, y: TaxableYear, foreign_corp: Person, amount: Money) strict {
    label en official "section 78";
    when domestic_corporation_chooses_foreign_tax_credit(corp, y);
    when deemed_paid_taxes_960_for_78(corp, y, foreign_corp, amount);
    when not_known(section_78_amended_inputs_present_78(corp, y, foreign_corp));
    then section_78_gross_up_dividend(corp, y, foreign_corp, amount);
}

// =====================================================================
// §79: group-term life insurance
// =====================================================================

pub entity GroupTermLifePlan {
    label en unofficial "an employer plan for providing group-term life insurance (section 79(d)(2)); case-asserted";
}
pub relation group_term_life_cost(p: Individual, y: TaxableYear, cost: Money) kind empirical {
    label en official "the cost of group-term life insurance on the employee's life provided for part or all of the year under a policy carried directly or indirectly by the employer, determined under section 79(c) uniform premiums (the regulations' table is an EXTERNAL_DEPENDENCY; the resulting cost is a case fact) (section 79(a), (c))";
}
relation cost_of_50000_of_group_term_insurance(p: Individual, y: TaxableYear, cost: Money) kind empirical {
    label en official "the cost of $50,000 of such insurance for the year, on the same section 79(c) basis (section 79(a)(1))";
}
relation employee_paid_toward_group_term_insurance(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount paid by the employee toward the purchase of such insurance (section 79(a)(2))";
}
relation group_term_cost_excepted_79b(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the portion of the group-term insurance cost to which subsection (a) does not apply by reason of (b)(1), (b)(2) or (b)(3)";
}
relation group_term_has_79b_exception(p: Individual, y: TaxableYear) kind institutional {
    label en official "helper: some portion of the year's group-term insurance cost is excepted by section 79(b)";
}
rule GroupTermHas79bException(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "helper for the not_known tests of the section 79(a) general rules";
    when group_term_cost_excepted_79b(p, y, amount);
    then group_term_has_79b_exception(p, y);
}
relation post_employment_disabled_coverage_cost(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "cost of insurance provided under a policy carried by the employer after the individual terminated employment and became disabled (section 72(m)(7)) (section 79(b)(1))";
}
rule GroupTermExceptionDisabledFormerEmployee(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 79(b)(1)";
    when post_employment_disabled_coverage_cost(p, y, amount);
    when disabled_72m7(p);
    then group_term_cost_excepted_79b(p, y, amount);
}
relation employer_or_charity_sole_beneficiary_cost(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "cost of any portion of insurance under which the employer is directly or indirectly the beneficiary, or a section 170(c) person is the sole beneficiary, for the entire period during the year the employee receives the insurance (section 79(b)(2))";
}
rule GroupTermExceptionEmployerOrCharityBeneficiary(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 79(b)(2)";
    when employer_or_charity_sole_beneficiary_cost(p, y, amount);
    then group_term_cost_excepted_79b(p, y, amount);
}
relation cost_under_contract_to_which_72m3_applies(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "cost of group-term insurance provided under a contract to which section 72(m)(3) applies (section 79(b)(3))";
}
relation cost_paid_with_applicable_life_insurance_account_assets(p: Individual, y: TaxableYear) kind empirical {
    label en official "the cost is paid (directly or indirectly) with assets held in an applicable life insurance account (section 420(e)(4)) under a defined benefit plan (section 79(f))";
}
rule GroupTermExceptionSection72m3Contract(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 79(b)(3), which section 79(f) disapplies for cost paid with applicable life insurance account assets";
    when cost_under_contract_to_which_72m3_applies(p, y, amount);
    when not_known(cost_paid_with_applicable_life_insurance_account_assets(p, y));
    then group_term_cost_excepted_79b(p, y, amount);
}

// (d): nondiscrimination
relation plan_of_employer(p: Individual, plan: GroupTermLifePlan) kind empirical {
    label en official "the employee is covered by the plan";
}
relation employer_employee_count(plan: GroupTermLifePlan, all: Integer, benefited: Integer) kind empirical {
    label en official "the number of all employees of the employer (after the (d)(3)(B) exclusions) and the number benefited by the plan (section 79(d)(3)(A)(i))";
}
relation participants_count(plan: GroupTermLifePlan, all_participants: Integer, key_participants: Integer) kind empirical {
    label en official "the number of employees who are participants and the number of them who are key employees (section 79(d)(3)(A)(ii))";
}
relation plan_classification_found_nondiscriminatory(plan: GroupTermLifePlan) kind empirical {
    label en official "the plan benefits such employees as qualify under a classification set up by the employer and found by the Secretary not to be discriminatory in favor of key employees (section 79(d)(3)(A)(iii)); the finding is an act of the Secretary (EXTERNAL_DEPENDENCY)";
}
relation plan_part_of_cafeteria_plan_meeting_125(plan: GroupTermLifePlan) kind empirical {
    label en official "the plan is part of a cafeteria plan and the requirements of section 125 are met (section 79(d)(3)(A)(iv))";
}
relation plan_benefits_available_to_all_participants(plan: GroupTermLifePlan) kind empirical {
    label en official "all benefits available to participants who are key employees are available to all other participants (section 79(d)(4))";
}
relation plan_benefit_amount_uniform_relation_to_compensation(plan: GroupTermLifePlan) kind empirical {
    label en official "the amount of life insurance under the plan bears a uniform relationship to total compensation or basic or regular rate of compensation (section 79(d)(5)), which is not by itself discriminatory";
}
relation plan_eligibility_nondiscriminatory_79d(plan: GroupTermLifePlan) kind institutional {
    label en official "the plan does not discriminate in favor of key employees as to eligibility to participate (section 79(d)(2)(A), (3))";
}
@source(IRC_S79_D, relation = formalizes, coverage = partial, quote = "(i) such plan benefits 70 percent or more of all employees of the employer,")
rule EligibilityNondiscriminatory70Percent(plan: GroupTermLifePlan, all: Integer, benefited: Integer) strict {
    label en official "section 79(d)(3)(A)(i): benefited x 100 >= 70 x all";
    when employer_employee_count(plan, all, benefited);
    when benefited * 100 >= all * 70;
    then plan_eligibility_nondiscriminatory_79d(plan);
}
@source(IRC_S79_D, relation = formalizes, coverage = partial, quote = "(ii) at least 85 percent of all employees who are participants under the plan are not key employees,")
rule EligibilityNondiscriminatory85PercentNonKey(plan: GroupTermLifePlan, participants: Integer, key: Integer) strict {
    label en official "section 79(d)(3)(A)(ii): (participants - key) x 100 >= 85 x participants";
    when participants_count(plan, participants, key);
    when (participants - key) * 100 >= participants * 85;
    then plan_eligibility_nondiscriminatory_79d(plan);
}
@source(IRC_S79_D, relation = formalizes, coverage = partial, quote = "(iii) such plan benefits such employees as qualify under a classification set up by the employer and found by the Secretary not to be discriminatory in favor of key employees, or")
rule EligibilityNondiscriminatoryClassification(plan: GroupTermLifePlan) strict {
    label en official "section 79(d)(3)(A)(iii)";
    when plan_classification_found_nondiscriminatory(plan);
    then plan_eligibility_nondiscriminatory_79d(plan);
}
@source(IRC_S79_D, relation = formalizes, coverage = partial, quote = "(iv) in the case of a plan which is part of a cafeteria plan, the requirements of section 125 are met.")
rule EligibilityNondiscriminatoryCafeteria(plan: GroupTermLifePlan) strict {
    label en official "section 79(d)(3)(A)(iv)";
    when plan_part_of_cafeteria_plan_meeting_125(plan);
    then plan_eligibility_nondiscriminatory_79d(plan);
}
relation plan_benefits_nondiscriminatory_79d(plan: GroupTermLifePlan) kind institutional {
    label en official "the type and amount of benefits available under the plan do not discriminate in favor of participants who are key employees (section 79(d)(2)(B), (4), (5))";
}
@source(IRC_S79_D, relation = formalizes, coverage = partial, quote = "A plan does not meet the requirements of paragraph (2)(B) unless all benefits available to participants who are key employees are available to all other participants.")
rule BenefitsNondiscriminatory(plan: GroupTermLifePlan) strict {
    label en official "section 79(d)(4), with (d)(5): a uniform relationship to compensation is not itself discrimination";
    when plan_benefits_available_to_all_participants(plan);
    then plan_benefits_nondiscriminatory_79d(plan);
}
relation church_plan_for_church_employees(plan: GroupTermLifePlan) kind empirical {
    label en official "the plan is a church plan maintained for church employees (section 79(d)(7), with the section 414(e) definitions as modified)";
}
pub relation discriminatory_group_term_life_plan_79d2(plan: GroupTermLifePlan) kind institutional {
    label en official "a discriminatory group-term life insurance plan: any plan unless both the eligibility and the benefits requirements are met (church plans are outside subsection (d))";
}
@source(IRC_S79_D, relation = formalizes, coverage = exact, quote = "the term \"discriminatory group-term life insurance plan\" means any plan of an employer for providing group-term life insurance unless—")
rule PlanDiscriminatoryUnlessBothRequirementsMet(plan: GroupTermLifePlan, p: Individual) strict {
    label en official "section 79(d)(2); (d)(7)(A): (d) does not apply to a church plan";
    when plan_of_employer(p, plan);
    when not_known(plan_eligibility_nondiscriminatory_79d(plan));
    when not_known(church_plan_for_church_employees(plan));
    then discriminatory_group_term_life_plan_79d2(plan);
}
@source(IRC_S79_D, relation = formalizes, coverage = exact, quote = "the type and amount of benefits available under the plan do not discriminate in favor of participants who are key employees.")
rule PlanDiscriminatoryOnBenefits(plan: GroupTermLifePlan, p: Individual) strict {
    label en official "section 79(d)(2)(B); (d)(7)(A): (d) does not apply to a church plan";
    when plan_of_employer(p, plan);
    when not_known(plan_benefits_nondiscriminatory_79d(plan));
    when not_known(church_plan_for_church_employees(plan));
    then discriminatory_group_term_life_plan_79d2(plan);
}
relation key_employee_79d6(p: Individual) kind empirical {
    label en official "a key employee within the meaning of section 416(i)(1), including a former employee who was a key employee when he retired or separated from service (section 79(d)(6); EXTERNAL_DEPENDENCY on section 416)";
}
relation cost_without_regard_to_79c(p: Individual, y: TaxableYear, cost: Money) kind empirical {
    label en official "the cost of the insurance on the key employee's life determined without regard to the section 79(c) uniform-premium table (section 79(d)(1)(B)(i))";
}
pub relation group_term_life_inclusion_79a(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount included in the employee's (or former employee's, section 79(e)) gross income under section 79(a)";
}
@source(IRC_S79_A, relation = formalizes, coverage = partial, quote = "but only to the extent that such cost exceeds the sum of—")
rule GroupTermInclusionGeneral(p: Individual, y: TaxableYear, cost: Money, base: Money, paid: Money, plan: GroupTermLifePlan) strict {
    label en official "section 79(a): cost (net of section 79(b) exceptions, when none is asserted) minus the cost of $50,000 of insurance minus the employee's payments, not below zero; a key employee in a discriminatory plan is handled by the next rule";
    when group_term_life_cost(p, y, cost);
    when cost_of_50000_of_group_term_insurance(p, y, base);
    when employee_paid_toward_group_term_insurance(p, y, paid);
    when plan_of_employer(p, plan);
    when not_known(group_term_has_79b_exception(p, y));
    when not_known(key_employee_79d6(p));
    then group_term_life_inclusion_79a(p, y, max(0.00 USD, round(cost - (base + paid), 2, "HALF_UP")));
}
rule GroupTermInclusionKeyEmployeeInNondiscriminatoryPlan(p: Individual, y: TaxableYear, cost: Money, base: Money, paid: Money, plan: GroupTermLifePlan) strict {
    label en official "section 79(a) for a key employee in a plan that is NOT discriminatory: the general rule applies (the key-employee rules apply only to a discriminatory plan)";
    when group_term_life_cost(p, y, cost);
    when cost_of_50000_of_group_term_insurance(p, y, base);
    when employee_paid_toward_group_term_insurance(p, y, paid);
    when plan_of_employer(p, plan);
    when key_employee_79d6(p);
    when not_known(discriminatory_group_term_life_plan_79d2(plan));
    when not_known(group_term_has_79b_exception(p, y));
    then group_term_life_inclusion_79a(p, y, max(0.00 USD, round(cost - (base + paid), 2, "HALF_UP")));
}
@source(IRC_S79_D, relation = formalizes, coverage = exact, quote = "(A) subsection (a)(1) shall not apply with respect to any key employee, and")
rule GroupTermInclusionKeyEmployeeDiscriminatoryPlan(p: Individual, y: TaxableYear, cost: Money, alt_cost: Money, paid: Money, plan: GroupTermLifePlan) strict {
    label en official "section 79(d)(1): no $50,000 subtraction; the cost is the greater of the cost without regard to (c) and with regard to (c)";
    when group_term_life_cost(p, y, cost);
    when cost_without_regard_to_79c(p, y, alt_cost);
    when employee_paid_toward_group_term_insurance(p, y, paid);
    when plan_of_employer(p, plan);
    when key_employee_79d6(p);
    when discriminatory_group_term_life_plan_79d2(plan);
    when not_known(group_term_has_79b_exception(p, y));
    then group_term_life_inclusion_79a(p, y, max(0.00 USD, round(max(cost, alt_cost) - paid, 2, "HALF_UP")));
}
@source(IRC_S79_B, relation = formalizes, coverage = partial, quote = "Subsection (a) shall not apply to—")
rule GroupTermInclusionWithException(p: Individual, y: TaxableYear, cost: Money, excepted: Money, base: Money, paid: Money) strict {
    label en official "section 79(a) applied to the cost remaining after the (b) exception (one exception portion per year is the supported case; several at once is the §111 aggregate limitation: TECH_GAP)";
    when group_term_life_cost(p, y, cost);
    when group_term_cost_excepted_79b(p, y, excepted);
    when cost_of_50000_of_group_term_insurance(p, y, base);
    when employee_paid_toward_group_term_insurance(p, y, paid);
    then group_term_life_inclusion_79a(p, y, max(0.00 USD, round((cost - excepted) - (base + paid), 2, "HALF_UP")));
}

// =====================================================================
// §80: restoration of foreign expropriation losses
// =====================================================================

pub relation domestic_corporation_subject_to_tax_11_or_801(corp: Person) kind empirical {
    label en official "the domestic corporation is subject to the tax imposed by section 11 or 801 (section 80(a))";
}
relation expropriation_loss_amount(corp: Person, security: us.irc.core::Asset, amount: Money) kind empirical {
    label en official "the amount of the loss on a security that became worthless by reason of expropriation, intervention, seizure or similar taking by a foreign government (section 80(a)(1)) and was taken into account as a capital loss or allowed as a deduction under section 165 (section 80(a)(2))";
}
relation value_restored_in_year(corp: Person, security: us.irc.core::Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "the value of the security restored in whole or in part during the year by any recovery of money or other property in respect of the related property (section 80(a))";
}
relation value_restored_in_prior_years(corp: Person, security: us.irc.core::Asset, y: TaxableYear, amount: Money) kind empirical {
    label en official "value restored during prior taxable years";
}
relation loss_without_tax_benefit(corp: Person, security: us.irc.core::Asset, amount: Money) kind empirical {
    label en official "the part of the loss that did not result in a reduction of the taxpayer's tax under this subtitle for any taxable year, determined under regulations (section 80(b)); the regulations' determination is an EXTERNAL_DEPENDENCY";
}
relation recovery_subject_to_section_1351(corp: Person, security: us.irc.core::Asset, y: TaxableYear) kind empirical {
    label en official "the recovery is of a foreign expropriation loss to which section 1351 applies (section 80(d))";
}
relation loss_taken_as_capital_loss(corp: Person, security: us.irc.core::Asset) kind empirical {
    label en official "the loss was taken into account as a loss from the sale or exchange of a capital asset (section 80(c)(2))";
}
pub relation expropriation_recovery_includible_80a(corp: Person, security: us.irc.core::Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the value restored, to the extent (with prior restorations) not above the loss, reduced under (b) by the part of the loss that gave no tax benefit, included in gross income for the year of restoration";
}
@source(IRC_S80_A, relation = formalizes, coverage = partial, quote = "the value so restored (to the extent that, when added to the value so restored during prior taxable years, it does not exceed the amount of the loss described in paragraph (2)) shall, except as provided in subsection (b), be included in gross income for the taxable year in which such restoration occurs.")
rule ExpropriationRecoveryIncluded(corp: Person, security: us.irc.core::Asset, y: TaxableYear, loss: Money, restored: Money, prior: Money, no_benefit: Money) strict {
    label en official "section 80(a)-(b): min(restored, loss - prior restorations), minus the (b) no-benefit portion, not below zero; (d): not applicable where section 1351 applies";
    when domestic_corporation_subject_to_tax_11_or_801(corp);
    when expropriation_loss_amount(corp, security, loss);
    when value_restored_in_year(corp, security, y, restored);
    when value_restored_in_prior_years(corp, security, y, prior);
    when loss_without_tax_benefit(corp, security, no_benefit);
    when not_known(recovery_subject_to_section_1351(corp, security, y));
    then expropriation_recovery_includible_80a(corp, security, y,
        max(0.00 USD, round(min(restored, max(0.00 USD, round(loss - prior, 2, "HALF_UP"))) - no_benefit, 2, "HALF_UP")));
}
pub relation expropriation_recovery_is_long_term_capital_gain_80c2(corp: Person, security: us.irc.core::Asset, y: TaxableYear) kind institutional {
    label en official "the amount included under section 80 is treated as long-term capital gain (the loss having been a capital loss)";
}
@source(IRC_S80_C, relation = formalizes, coverage = exact, quote = "the amount included in gross income under this section shall be treated as long-term capital gain.")
rule ExpropriationRecoveryCharacterCapital(corp: Person, security: us.irc.core::Asset, y: TaxableYear, amount: Money) strict {
    label en official "section 80(c)(2)";
    when expropriation_recovery_includible_80a(corp, security, y, amount);
    when loss_taken_as_capital_loss(corp, security);
    then expropriation_recovery_is_long_term_capital_gain_80c2(corp, security, y);
}
pub relation expropriation_recovery_is_ordinary_income_80c1(corp: Person, security: us.irc.core::Asset, y: TaxableYear) kind institutional {
    label en official "the amount included under section 80 is ordinary income unless (c)(2) applies";
}
@source(IRC_S80_C, relation = formalizes, coverage = exact, quote = "Except as provided in paragraph (2), the amount included in gross income under this section shall be treated as ordinary income.")
rule ExpropriationRecoveryCharacterOrdinary(corp: Person, security: us.irc.core::Asset, y: TaxableYear, amount: Money) strict {
    label en official "section 80(c)(1)";
    when expropriation_recovery_includible_80a(corp, security, y, amount);
    when not_known(loss_taken_as_capital_loss(corp, security));
    then expropriation_recovery_is_ordinary_income_80c1(corp, security, y);
}

// =====================================================================
// §82: moving expense reimbursements
// =====================================================================

pub relation moving_expense_payment_or_reimbursement(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "an amount received or accrued, directly or indirectly, by an individual as a payment for or reimbursement of expenses of moving from one residence to another residence attributable to employment or self-employment (section 82)";
}
relation qualified_moving_expense_reimbursement_132a6(p: Individual, y: TaxableYear) kind empirical {
    label en official "the reimbursement is a qualified moving expense reimbursement excluded by section 132(a)(6) (armed forces members) — the section 132 package derives that status; the case links it";
}
pub relation moving_expense_reimbursement_includible_82(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the moving-expense payment or reimbursement included in gross income as compensation for services";
}
@source(IRC_S82, relation = formalizes, coverage = exact, quote = "there shall be included in gross income (as compensation for services) any amount received or accrued, directly or indirectly, by an individual as a payment for or reimbursement of expenses of moving from one residence to another residence which is attributable to employment or self-employment.")
rule MovingExpenseReimbursementIncluded(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 82, except as provided in section 132(a)(6)";
    when moving_expense_payment_or_reimbursement(p, y, amount);
    when not_known(qualified_moving_expense_reimbursement_132a6(p, y));
    then moving_expense_reimbursement_includible_82(p, y, amount);
}

// =====================================================================
// §84: transfers of appreciated property to political organizations
// =====================================================================

pub relation property_transfer_to_political_organization(transferor: Person, prop: us.irc.core::Asset, on: Date, fair_market_value: Money, adjusted_basis: Money) kind empirical {
    label en official "a person transfers property to a political organization on the date; its fair market value and adjusted basis (section 84(a))";
}
relation recipient_is_political_organization_527e1(prop: us.irc.core::Asset) kind empirical {
    label en official "the transferee is a political organization as defined in section 527(e)(1) (EXTERNAL_DEPENDENCY: section 527(e)(1) is not carried here)";
}
pub relation transferor_treated_as_selling_84a(transferor: Person, prop: us.irc.core::Asset, on: Date, amount_realized: Money) kind institutional {
    label en official "the transferor is treated as having sold the property to the political organization on the date of transfer and as having realized an amount equal to its fair market value";
}
@source(IRC_S84_A, relation = formalizes, coverage = exact, quote = "then for purposes of this chapter the transferor shall be treated as having sold such property to the political organization on the date of the transfer, and the transferor shall be treated as having realized an amount equal to the fair market value of such property on such date.")
rule TransferToPoliticalOrganizationDeemedSale(transferor: Person, prop: us.irc.core::Asset, on: Date, fmv: Money, basis: Money) strict {
    label en official "section 84(a): applies only where fair market value exceeds adjusted basis";
    when property_transfer_to_political_organization(transferor, prop, on, fmv, basis);
    when recipient_is_political_organization_527e1(prop);
    when fmv > basis;
    then transferor_treated_as_selling_84a(transferor, prop, on, fmv);
}
pub relation political_organization_basis_84b(transferor: Person, prop: us.irc.core::Asset, on: Date, basis: Money) kind institutional {
    label en official "the basis of the property in the hands of the political organization: the transferor's basis increased by the gain recognized to the transferor";
}
@source(IRC_S84_B, relation = formalizes, coverage = exact, quote = "the basis of such property in the hands of the political organization shall be the same as it would be in the hands of the transferor, increased by the amount of gain recognized to the transferor by reason of such transfer.")
rule PoliticalOrganizationBasisComputed(transferor: Person, prop: us.irc.core::Asset, on: Date, fmv: Money, basis: Money) strict {
    label en official "section 84(b): transferor's basis plus recognized gain (= fair market value minus basis) = fair market value";
    when transferor_treated_as_selling_84a(transferor, prop, on, fmv);
    when property_transfer_to_political_organization(transferor, prop, on, fmv, basis);
    then political_organization_basis_84b(transferor, prop, on, round(basis + (fmv - basis), 2, "HALF_UP"));
}

// =====================================================================
// §85: unemployment compensation
// =====================================================================

pub relation amount_received_under_law_of_us_or_state(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "an amount received under a law of the United States or of a State that is in the nature of unemployment compensation (section 85(b))";
}
pub relation unemployment_compensation_includible_85a(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "unemployment compensation included in the individual's gross income before any section 85(c) exclusion";
}
@source(IRC_S85_A, relation = formalizes, coverage = exact, quote = "In the case of an individual, gross income includes unemployment compensation.")
rule UnemploymentCompensationIncluded(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 85(a), (b)";
    when amount_received_under_law_of_us_or_state(p, y, amount);
    then unemployment_compensation_includible_85a(p, y, amount);
}
relation agi_for_85c(p: Individual, y: TaxableYear, agi: Money) kind empirical {
    label en official "the adjusted gross income of the taxpayer determined after application of sections 86, 135, 137, 219, 221, 222 and 469 and without regard to section 85 (section 85(c)(2)); for a joint return, the joint adjusted gross income";
}
pub relation unemployment_compensation_excluded_2020_85c(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the unemployment compensation excluded for a taxable year beginning in 2020: up to $10,200 received by the taxpayer (each spouse on a joint return) where adjusted gross income is less than $150,000";
}
@source(IRC_S85_C, relation = formalizes, coverage = exact, quote = "if the adjusted gross income of the taxpayer for such taxable year is less than $150,000, the gross income of such taxpayer shall not include so much of the unemployment compensation received by such taxpayer (or, in the case of a joint return, received by each spouse) as does not exceed $10,200.")
rule UnemploymentCompensationExcluded2020(p: Individual, y: TaxableYear, amount: Money, agi: Money) strict {
    label en official "section 85(c)(1): a taxable year beginning in 2020; AGI strictly below $150,000 (equal to it does not qualify); per-individual $10,200 ceiling (each spouse separately on a joint return)";
    when unemployment_compensation_includible_85a(p, y, amount);
    when agi_for_85c(p, y, agi);
    when us.irc.core::begins(y, _);
    when us.irc.core::calendar_year_of(y, 2020);
    when agi < 150000.00 USD;
    when not_known(has_computed_agi_for_ordering_74d_85c(p, y)); // G4501 wiring: the computed AGI variant below
    then unemployment_compensation_excluded_2020_85c(p, y, min(amount, 10200.00 USD));
}
@source(IRC_S85_C, relation = formalizes, coverage = exact, quote = "(B) without regard to this section.")
rule UnemploymentCompensationExcluded2020ComputedAgi(p: Individual, y: TaxableYear, amount: Money, agi: Money) strict {
    label en official "section 85(c)(1) with (c)(2): the exclusion under the AGI limit read from the computed adjusted gross income (the ordering is explained at the block of section 74(d))";
    when unemployment_compensation_includible_85a(p, y, amount);
    when adjusted_gross_income(p, y, agi);
    when us.irc.core::begins(y, _);
    when us.irc.core::calendar_year_of(y, 2020);
    when agi < 150000.00 USD;
    then unemployment_compensation_excluded_2020_85c(p, y, min(amount, 10200.00 USD));
}

// =====================================================================
// §87: alcohol, biodiesel and sustainable aviation fuel credits
// =====================================================================

pub relation alcohol_fuel_credit_40a(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the alcohol fuel credit determined with respect to the taxpayer for the year under section 40(a) (section 87(1)); the credits package derives it, the case links it";
}
pub relation biodiesel_fuels_credit_40Aa(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the biodiesel fuels credit determined for the year under section 40A(a) (section 87(2))";
}
pub relation sustainable_aviation_fuel_credit_40Ba(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the sustainable aviation fuel credit determined for the year under section 40B(a) (section 87(3))";
}
pub relation fuel_credit_includible_87(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount of a section 40(a), 40A(a) or 40B(a) credit included in gross income";
}
@source(IRC_S87, relation = formalizes, coverage = partial, quote = "the amount of the alcohol fuel credit determined with respect to the taxpayer for the taxable year under section 40(a),")
rule AlcoholFuelCreditIncluded(p: Person, y: TaxableYear, amount: Money) strict {
    label en official "section 87(1)";
    when alcohol_fuel_credit_40a(p, y, amount);
    then fuel_credit_includible_87(p, y, amount);
}
@source(IRC_S87, relation = formalizes, coverage = partial, quote = "the biodiesel fuels credit determined with respect to the taxpayer for the taxable year under section 40A(a), and")
rule BiodieselFuelsCreditIncluded(p: Person, y: TaxableYear, amount: Money) strict {
    label en official "section 87(2)";
    when biodiesel_fuels_credit_40Aa(p, y, amount);
    then fuel_credit_includible_87(p, y, amount);
}
@source(IRC_S87, relation = formalizes, coverage = partial, quote = "the sustainable aviation fuel credit determined with respect to the taxpayer for the taxable year under section 40B(a).")
rule SustainableAviationFuelCreditIncluded(p: Person, y: TaxableYear, amount: Money) strict {
    label en official "section 87(3)";
    when sustainable_aviation_fuel_credit_40Ba(p, y, amount);
    then fuel_credit_includible_87(p, y, amount);
}

// =====================================================================
// §88: nuclear decommissioning costs
// =====================================================================

pub relation nuclear_decommissioning_cost_in_ratemaking_cost_of_service(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of nuclear decommissioning costs the taxpayer is required to include in its cost of service for ratemaking purposes for the year (section 88)";
}
pub relation nuclear_decommissioning_cost_includible_88(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount so included in cost of service is includible in the taxpayer's gross income";
}
@source(IRC_S88, relation = formalizes, coverage = exact, quote = "there shall be includible in the gross income of such taxpayer the amount so included for any taxable year.")
rule NuclearDecommissioningCostIncluded(p: Person, y: TaxableYear, amount: Money) strict {
    label en official "section 88";
    when nuclear_decommissioning_cost_in_ratemaking_cost_of_service(p, y, amount);
    then nuclear_decommissioning_cost_includible_88(p, y, amount);
}

// =====================================================================
// §90: illegal Federal irrigation subsidies
// =====================================================================

pub relation federal_irrigation_water_amount_required_to_be_paid(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount required to be paid for Federal irrigation water (water for agricultural purposes from a reclamation or irrigation project referred to in section 202(8) of the Reclamation Reform Act of 1982) delivered to the taxpayer during the taxable year (section 90(b)(1)(A))";
}
pub relation federal_irrigation_water_amount_paid(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount paid for such water (section 90(b)(1)(B))";
}
pub relation illegal_federal_irrigation_subsidy_90b1(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the excess (if any) of the amount required to be paid over the amount paid";
}
@source(IRC_S90_B, relation = formalizes, coverage = exact, quote = "The term \"illegal Federal irrigation subsidy\" means the excess (if any) of—")
rule IllegalIrrigationSubsidyComputed(p: Person, y: TaxableYear, required: Money, paid: Money) strict {
    label en official "section 90(b)(1); only a positive excess is a subsidy";
    when federal_irrigation_water_amount_required_to_be_paid(p, y, required);
    when federal_irrigation_water_amount_paid(p, y, paid);
    when required > paid;
    then illegal_federal_irrigation_subsidy_90b1(p, y, round(required - paid, 2, "HALF_UP"));
}
pub relation illegal_irrigation_subsidy_includible_90a(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the illegal Federal irrigation subsidy included in gross income for the year";
}
@source(IRC_S90_A, relation = formalizes, coverage = exact, quote = "Gross income shall include an amount equal to any illegal Federal irrigation subsidy received by the taxpayer during the taxable year.")
rule IllegalIrrigationSubsidyIncluded(p: Person, y: TaxableYear, amount: Money) strict {
    label en official "section 90(a)";
    when illegal_federal_irrigation_subsidy_90b1(p, y, amount);
    then illegal_irrigation_subsidy_includible_90a(p, y, amount);
}
pub relation deduction_denied_by_reason_of_90_inclusion(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "no deduction is allowed under this subtitle by reason of the inclusion in gross income; the amount is the included subsidy (section 90(c))";
}
@source(IRC_S90_C, relation = formalizes, coverage = exact, quote = "No deduction shall be allowed under this subtitle by reason of any inclusion in gross income under subsection (a).")
rule DeductionDeniedForSection90Inclusion(p: Person, y: TaxableYear, amount: Money) strict {
    label en official "section 90(c)";
    when illegal_irrigation_subsidy_includible_90a(p, y, amount);
    then deduction_denied_by_reason_of_90_inclusion(p, y, amount);
}

// =====================================================================
// §91: foreign branch loss recapture
// =====================================================================

pub relation branch_assets_transfer_to_specified_10_percent_owned_foreign_corporation(corp: Person, on: Date, y: TaxableYear) kind empirical {
    label en official "a domestic corporation transfers substantially all of the assets of a foreign branch (section 367(a)(3)(C) as in effect before the Tax Cuts and Jobs Act) to a specified 10-percent owned foreign corporation (section 245A) of which it is a United States shareholder after the transfer, in the taxable year (section 91(a))";
}
relation branch_losses_after_2017_with_deduction(corp: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the sum of losses incurred by the branch after December 31, 2017, and before the transfer, with respect to which a deduction was allowed (section 91(b)(1))";
}
relation branch_taxable_income_through_transfer(corp: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "any taxable income of the branch for a taxable year after the year in which the loss was incurred and through the close of the taxable year of transfer (section 91(b)(2)(A))";
}
relation branch_amount_recognized_under_904f3(corp: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "any amount recognized under section 904(f)(3) on account of the transfer (section 91(b)(2)(B))";
}
relation gain_recognized_on_branch_transfer(corp: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the gain recognized on account of the transfer, other than amounts taken into account under (b)(2)(B) (section 91(c))";
}
pub relation transferred_loss_amount_91b(corp: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the transferred loss amount: the excess (if any) of the post-2017 deducted branch losses over branch income and section 904(f)(3) recognition";
}
@source(IRC_S91_B, relation = formalizes, coverage = exact, quote = "the term \"transferred loss amount\" means, with respect to any transfer of substantially all of the assets of a foreign branch, the excess (if any) of—")
rule TransferredLossAmountComputed(corp: Person, y: TaxableYear, on: Date, losses: Money, income: Money, recog: Money) strict {
    label en official "section 91(b), never below zero";
    when branch_assets_transfer_to_specified_10_percent_owned_foreign_corporation(corp, on, y);
    when branch_losses_after_2017_with_deduction(corp, y, losses);
    when branch_taxable_income_through_transfer(corp, y, income);
    when branch_amount_recognized_under_904f3(corp, y, recog);
    then transferred_loss_amount_91b(corp, y, max(0.00 USD, round(losses - (income + recog), 2, "HALF_UP")));
}
pub relation branch_loss_recapture_includible_91a(corp: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the transferred loss amount, reduced (not below zero) by the gain recognized on account of the transfer, included in gross income for the year of transfer";
}
@source(IRC_S91_C, relation = formalizes, coverage = exact, quote = "The transferred loss amount shall be reduced (but not below zero) by the amount of gain recognized by the taxpayer on account of the transfer")
rule BranchLossRecaptureIncluded(corp: Person, y: TaxableYear, loss_amount: Money, gain: Money) strict {
    label en official "section 91(a), (c)";
    when transferred_loss_amount_91b(corp, y, loss_amount);
    when gain_recognized_on_branch_transfer(corp, y, gain);
    then branch_loss_recapture_includible_91a(corp, y, max(0.00 USD, round(loss_amount - gain, 2, "HALF_UP")));
}
pub relation branch_loss_recapture_us_source_91d(corp: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "amounts included in gross income under section 91 are treated as derived from sources within the United States";
}
@source(IRC_S91_D, relation = formalizes, coverage = exact, quote = "Amounts included in gross income under this section shall be treated as derived from sources within the United States.")
rule BranchLossRecaptureIsUsSource(corp: Person, y: TaxableYear, amount: Money) strict {
    label en official "section 91(d)";
    when branch_loss_recapture_includible_91a(corp, y, amount);
    then branch_loss_recapture_us_source_91d(corp, y, amount);
}
