// Gross income -- WIRE-10 group D (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// Section 112(c)(2)-(3): the combat zone is an area the President designates by Executive Order; service is performed in it only on or after
// the designated commencing date and on or before the designated termination date. Section 6013(f)(1) of `us.irc.returns` reads the zone and
// its termination date ("the date designated under section 112 as the date of termination of combatant activities in such zone"), and
// the Vietnam-zone sentence of section 6013(f)(1). The designation itself is an external act (TECH-GAPS G1563) and stays a case fact; what is
// stated here is the reading of the designation: which day of service lies in the zone.

language "law.core" version "0.2";
package us.irc.gross_income version "0.1.1";
namespace "urn:us:irc:gross_income:clir";

use self::{
    IRC_S112_C,
};

pub entity CombatZone112 {
    label en official "an area which the President of the United States by Executive Order designates, for purposes of section 112, as an area in which Armed Forces of the United States are or have engaged in combat";
}
pub relation combat_zone_combatant_activities_commenced_112c3(z: CombatZone112, d: Date) kind empirical {
    label en official "the date designated by the President by Executive Order as the date of the commencing of combatant activities in the zone";
}
pub relation combat_zone_combatant_activities_terminated_112c3(z: CombatZone112, d: Date) kind empirical {
    label en official "the date designated by the President by Executive Order as the date of the termination of combatant activities in the zone";
}
pub relation combat_zone_termination_not_designated_112c3(z: CombatZone112) kind empirical {
    label en unofficial "no termination date has been designated for the zone (combatant activities continue)";
}
pub relation combat_zone_designated_for_vietnam_conflict_112(z: CombatZone112) kind empirical {
    label en official "the combat zone designated for purposes of the Vietnam conflict";
}
pub relation present_in_combat_zone_area_on_112c3(p: us.irc.core::Individual, z: CombatZone112, day: Date) kind empirical {
    label en unofficial "the individual performed service in the area of the zone on the day";
}
pub relation service_performed_in_combat_zone_on_112c3(p: us.irc.core::Individual, z: CombatZone112, day: Date) kind institutional {
    label en official "service is performed in a combat zone only if performed on or after the date designated as the date of the commencing of combatant activities in such zone, and on or before the date designated as the date of the termination of combatant activities in such zone";
}

@source(IRC_S112_C, relation = formalizes, coverage = exact, quote = "Service is performed in a combat zone only if performed on or after the date designated by the President by Executive Order as the date of the commencing of combatant activities in such zone, and on or before the date designated by the President by Executive Order as the date of the termination of combatant activities in such zone.")
rule W10DServiceInCombatZoneBetweenDesignatedDates(p: us.irc.core::Individual, z: CombatZone112, day: Date, commenced: Date, terminated: Date) strict {
    label en official "section 112(c)(3): service on or after the commencing date and on or before the termination date is service in the zone";
    when present_in_combat_zone_area_on_112c3(p, z, day);
    when combat_zone_combatant_activities_commenced_112c3(z, commenced);
    when combat_zone_combatant_activities_terminated_112c3(z, terminated);
    when day >= commenced;
    when day <= terminated;
    then service_performed_in_combat_zone_on_112c3(p, z, day);
}
@source(IRC_S112_C, relation = formalizes, coverage = exact, quote = "Service is performed in a combat zone only if performed on or after the date designated by the President by Executive Order as the date of the commencing of combatant activities in such zone, and on or before the date designated by the President by Executive Order as the date of the termination of combatant activities in such zone.")
rule W10DServiceInCombatZoneBeforeAnyTermination(p: us.irc.core::Individual, z: CombatZone112, day: Date, commenced: Date) strict {
    label en official "section 112(c)(3): while no termination date is designated, service on or after the commencing date is service in the zone";
    when present_in_combat_zone_area_on_112c3(p, z, day);
    when combat_zone_combatant_activities_commenced_112c3(z, commenced);
    when combat_zone_termination_not_designated_112c3(z);
    when day >= commenced;
    then service_performed_in_combat_zone_on_112c3(p, z, day);
}
