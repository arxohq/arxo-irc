// Section 127 — Educational assistance programs. Stage 2d (IRC-06). Scope:
// (a) the $5,250 annual exclusion cap, (b)(1)-(6) the program-qualification
// conditions (nondiscriminatory classification, 5% shareholder/owner cap,
// no cash-or-other-remuneration choice, unfunded permitted, notice), (c)(1)
// the educational-assistance definition incl. the (c)(1)(B) student-loan-
// payment item with its pre-2026-edition sunset window, (c)(2)-(3)
// "employee" extensions for self-employed individuals and sole
// proprietors/partners. NOT reached: (c)(4) (constructive-ownership rules
// via section 1563(d)/(e)), (c)(5)-(7) (safe harbors and the double-benefit
// bar), (d) (reporting cross-reference, non_normative).
//
// SOURCE_GAP (Pub. L. 119-21 §70412, "Exclusion for Employer Payments of
// Student Loans", approved 2025-07-04): `AMENDMENTS.json` confirms this
// public law amends section 127(c)(1)(B) to apply to "payments made after
// December 31, 2025" (i.e., makes the student-loan-payment item permanent,
// removing the "before January 1, 2026" sunset the base 2024-edition text
// below still carries) — but only a HEURISTIC effective-date sentence is
// pinned, not the amendment's actual substituted statutory text, so there
// is nothing to anchor a `@source` quote to for a post-2025 revision. The
// rule below therefore still carries the pre-amendment 2024-edition sunset
// window; a case for a payment after 2025-12-31 gets an (incorrect, per the
// real 2025 law) NEITHER/excluded-only-through-2025 result until the
// amendment text itself is pinned. This is the SAME situation flagged
// elsewhere in this corpus as "14/104 PL 119-21 sections not carried".

// =====================================================================
// §127(c): "educational assistance" defined
// =====================================================================

use self::{
    IRC_S127_A,
    IRC_S127_B,
    IRC_S127_C,
    Individual,
    Person,
    TaxableYear,
};

pub enum EducationalAssistanceKind {
    EducationExpenses;      // (c)(1)(A)
    StudentLoanPayment;     // (c)(1)(B), pre-2026 edition
    CoursesOfInstruction;   // (c)(1)(C)
}
pub relation educational_assistance_furnished(p: Individual, employer: Person, y: TaxableYear, kind: EducationalAssistanceKind, amount: Money, paid_on: Date) kind empirical {
    label en official "an amount of educational assistance furnished by the employer to the employee (section 127(c)(1))";
}
relation tools_or_retained_supplies_or_meals_lodging_transportation(p: Individual, employer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount is for tools/supplies retained by the employee after the course, or for meals, lodging, or transportation — excluded from the (c)(1) definition (section 127(c)(1), closing sentence)";
}
pub relation qualified_education_loan_payment_valid_127c1B(p: Individual, employer: Person, y: TaxableYear, amount: Money, paid_on: Date) kind institutional {
    label en official "the student-loan-payment item of educational assistance, valid only for payments made before January 1, 2026 (2024-edition sunset — see the module header's SOURCE_GAP note on Pub. L. 119-21 §70412's permanence amendment, not carried here)";
}
@source(IRC_S127_C, quote = "in the case of payments made before January 1, 2026, the payment by an employer, whether paid to the employee or to a lender, of principal or interest on any qualified education loan (as defined in section 221(d)(1))")
rule QualifiedEducationLoanPaymentValid(p: Individual, employer: Person, y: TaxableYear, amount: Money, paid_on: Date) strict {
    label en official "section 127(c)(1)(B), 2024-edition sunset window";
    when educational_assistance_furnished(p, employer, y, StudentLoanPayment, amount, paid_on);
    when paid_on < @2026-01-01;
    then qualified_education_loan_payment_valid_127c1B(p, employer, y, amount, paid_on);
}

// =====================================================================
// §127(b): educational assistance program qualification
// =====================================================================

pub relation educational_assistance_program_written_127b1(program: us.irc.core::Organ, employer: Person) kind empirical {
    label en official "a separate written plan of the employer for the exclusive benefit of employees, to provide educational assistance (section 127(b)(1))";
}
relation program_classification_found_nondiscriminatory_127b2(program: us.irc.core::Organ, y: TaxableYear) kind empirical {
    label en official "the program benefits employees under a classification found by the Secretary not to discriminate in favor of highly compensated employees (section 127(b)(2))";
}
relation shareholder_owner_class_share_of_assistance_127b3(program: us.irc.core::Organ, y: TaxableYear, fraction: Decimal) kind empirical {
    label en official "the fraction of amounts paid or incurred for educational assistance during the year provided to the class of 5%-or-more shareholders/owners (or their spouses/dependents) (section 127(b)(3))";
}
relation program_offers_cash_or_other_remuneration_choice_127b4(program: us.irc.core::Organ) kind empirical {
    label en official "the program provides eligible employees with a choice between educational assistance and other remuneration includible in gross income (section 127(b)(4))";
}
pub relation educational_assistance_program_qualified_127b(program: us.irc.core::Organ, employer: Person, y: TaxableYear) kind institutional {
    label en official "the program is an educational assistance program within the meaning of section 127(b)";
}
@source(IRC_S127_B, quote = "Not more than 5 percent of the amounts paid or incurred by the employer for educational assistance during the year may be provided for the class of individuals who are shareholders or owners (or their spouses or dependents), each of whom (on any day of the year) owns more than 5 percent")
rule EducationalAssistanceProgramQualified(program: us.irc.core::Organ, employer: Person, y: TaxableYear, fraction: Decimal) strict {
    label en official "section 127(b)(1)-(4): the written-plan, nondiscriminatory-classification, 5%-owner-cap, and no-cash-choice conditions";
    when educational_assistance_program_written_127b1(program, employer);
    when program_classification_found_nondiscriminatory_127b2(program, y);
    when shareholder_owner_class_share_of_assistance_127b3(program, y, fraction);
    when fraction <= 0.05;
    when not_known(program_offers_cash_or_other_remuneration_choice_127b4(program));
    then educational_assistance_program_qualified_127b(program, employer, y);
}

// =====================================================================
// §127(a): the exclusion and its $5,250 cap
// =====================================================================

pub relation educational_assistance_excluded_127a(p: Individual, employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "gross income of the employee does not include this amount of employer-furnished educational assistance, capped at $5,250 for the calendar year (section 127(a))";
}
relation total_educational_assistance_furnished_calendar_year(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the total educational assistance furnished to the individual during the calendar year, before the (a)(2) $5,250 cap is applied (aggregated across employers where applicable) — a case-asserted total, not derived by this package from individual item facts, to avoid double-application of the cap when multiple employers/programs are involved";
}
@source(IRC_S127_A, quote = "If, but for this paragraph, this section would exclude from gross income more than $5,250 of educational assistance furnished to an individual during a calendar year, this section shall apply only to the first $5,250 of such assistance so furnished.")
rule EducationalAssistanceExcludedCapped(p: Individual, employer: Person, program: us.irc.core::Organ, y: TaxableYear, total: Money) strict {
    label en official "section 127(a)(1)-(2): capped at $5,250 per calendar year";
    when educational_assistance_program_qualified_127b(program, employer, y);
    when total_educational_assistance_furnished_calendar_year(p, y, total);
    then educational_assistance_excluded_127a(p, employer, y, min(total, 5250.00 USD));
}

// =====================================================================
// §127(c)(2)-(3): "employee" extensions
// =====================================================================

pub relation self_employed_treated_as_employee_127c2(p: Individual) kind institutional {
    label en official "an individual who is an employee within the meaning of section 401(c)(1) (a self-employed individual) is an employee for section 127 purposes (section 127(c)(2))";
}
relation self_employed_401c1(p: Individual) kind empirical {
    label en official "the individual is an employee within the meaning of section 401(c)(1) (section 127(c)(2))";
}
@source(IRC_S127_C, quote = "The term \"employee\" includes, for any year, an individual who is an employee within the meaning of section 401(c)(1) (relating to self-employed individuals).")
rule SelfEmployedTreatedAsEmployee(p: Individual) strict {
    label en official "section 127(c)(2)";
    when self_employed_401c1(p);
    then self_employed_treated_as_employee_127c2(p);
}

pub relation sole_proprietor_treated_as_own_employer_127c3(p: Individual) kind institutional {
    label en official "an individual who owns the entire interest in an unincorporated trade or business is treated as the individual's own employer (section 127(c)(3))";
}
relation owns_entire_interest_unincorporated_business(p: Individual) kind empirical {
    label en official "the individual owns the entire interest in an unincorporated trade or business (section 127(c)(3))";
}
@source(IRC_S127_C, quote = "An individual who owns the entire interest in an unincorporated trade or business shall be treated as his own employer.")
rule SoleProprietorOwnEmployer(p: Individual) strict {
    label en official "section 127(c)(3), first sentence";
    when owns_entire_interest_unincorporated_business(p);
    then sole_proprietor_treated_as_own_employer_127c3(p);
}
