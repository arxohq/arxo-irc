// Section 63 — Taxable income defined. Stage 1 (IRC-06).
//
// JUDGMENT CALL on §63(c)(7)/Pub. L. 119-21 §70102: the grammar has a
// `revision_decl` (spec/grammar.ebnf `revision_decl`), but every corpus
// example of it (`corpus/laws/us/constitution/revisions.law`) links two
// EDITIONS of a pinned source (`previous`/`next` editions of a `source_work`)
// — this package's `sources.law` is generated from a single 2024-Edition
// snapshot (DECISION-0379 D-01/D-03) with no separate post-amendment
// edition materialized, so there is no second edition to name as `next`.
// `us.irc.income_individual/rates.law` faced the identical situation for
// §1(j) and chose ordinary `effective`-windowed rule pairs over inventing an
// edition; this module follows the same choice for §63(c)(7), §67(g)/(h)
// and §68 for the same reason.

use self::{
    IRC_S63_A,
    IRC_S63_B,
    IRC_S63_C,
    IRC_S63_E,
    IRC_S63_F,
    IRC_S63_G,
    Individual,
    Person,
    TaxableYear,
    adjusted_gross_income,
    gross_income,
    new_63b_deductions_asserted,
};

pub relation itemizes(p: Individual, y: TaxableYear) kind institutional {
    label en official "elects to itemize deductions for the taxable year (section 63(e))";
}

pub relation taxable_income(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "taxable income (section 63)";
}

// --- §63(a): general rule (itemizers) -------------------------------------------

pub relation deductions_other_than_standard_deduction(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the deductions allowed by chapter 1 other than the standard deduction — dependency contract, producer: deductions";
}

@source(IRC_S63_A, quote = "the term \"taxable income\" means gross income minus the deductions allowed by this chapter (other than the standard deduction)")
rule TaxableIncomeGeneralRule(p: Individual, y: TaxableYear, gross: Money, ded: Money) strict {
    label en official "taxable income is gross income minus the deductions allowed by chapter 1 other than the standard deduction, for a taxpayer within subsection (a) (i.e. not within subsection (b))";
    when gross_income(p, y, gross);
    when deductions_other_than_standard_deduction(p, y, ded);
    when not_known(elects_to_itemize_on_return(p, y));
    then taxable_income(p, y, gross - ded);
}

// --- §63(b): individuals who do not itemize --------------------------------------

relation taxable_income_non_itemizer_formula_applies(p: Individual, y: TaxableYear) kind institutional {
    label en official "an individual who does not elect to itemize deductions for the taxable year (section 63(b))";
}

@source(IRC_S63_B, quote = "In the case of an individual who does not elect to itemize his deductions for the taxable year")
rule NonItemizerFormulaApplies(p: Individual, y: TaxableYear, fs: us.irc.income_individual::FilingStatus) strict {
    label en official "the section 63(b) formula applies to an individual who does not elect to itemize; read directly off the section 63(e) election fact (not the power's `itemizes` effect) to avoid a late-status dependency on the power's effect (LDC-E4103)";
    when us.irc.income_individual::filing_status(p, y, fs);
    when not_known(elects_to_itemize_on_return(p, y));
    then taxable_income_non_itemizer_formula_applies(p, y);
}

pub relation standard_deduction(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the standard deduction (section 63(c))";
}

// §63(b)(2)/(3)/(4): personal exemptions (section 151), the section 199A
// deduction, and the section 170(p) deduction. §151 is out of THIS stage's
// scope (task assignment names only §§61-68; §151 is recorded as "stage 2"
// per AGENT-BRIEF even though AMENDMENTS.json's heuristic owner mapping puts
// section 151 in this package). §199A is owned by `deductions`. §170(p) is
// a not-yet-anchored provision (no fragment for it appears in this
// package's pinned §61-68 text; likely `deductions`, unconfirmed —
// EXTERNAL_DEPENDENCY, owner unresolved).
pub relation personal_exemption_deduction_151(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the deduction for personal exemptions provided in section 151 — dependency contract, producer: unresolved (section 151 is stage 2 of this package)";
}
pub relation section_199a_deduction(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "any deduction provided in section 199A — dependency contract, producer: deductions";
}
pub relation section_170p_deduction(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the deduction provided in section 170(p) — dependency contract, producer: unresolved";
}

@source(IRC_S63_B, quote = "the term \"taxable income\" means adjusted gross income, minus")
rule TaxableIncomeNonItemizerFormula(p: Individual, y: TaxableYear, agi: Money, std: Money, exempt: Money, s199a: Money, s170p: Money) strict {
    label en official "for a non-itemizer, taxable income is AGI minus the standard deduction, personal exemptions, the section 199A deduction, and the section 170(p) deduction";
    when taxable_income_non_itemizer_formula_applies(p, y);
    when not_known(new_63b_deductions_asserted(p, y));
    when adjusted_gross_income(p, y, agi);
    when standard_deduction(p, y, std);
    when personal_exemption_deduction_151(p, y, exempt);
    when section_199a_deduction(p, y, s199a);
    when section_170p_deduction(p, y, s170p);
    then taxable_income(p, y, agi - std - exempt - s199a - s170p);
}

// --- §63(c): standard deduction ---------------------------------------------------

pub relation basic_standard_deduction(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the basic standard deduction (section 63(c)(2)), after the section 63(c)(5) dependent limitation";
}
relation basic_standard_deduction_before_dependent_cap(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the basic standard deduction by filing status (section 63(c)(2)), before the section 63(c)(5) dependent limitation";
}
pub relation additional_standard_deduction(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the additional standard deduction for the aged and blind (section 63(c)(3))";
}

@source(IRC_S63_C, quote = "the term \"standard deduction\" means the sum of")
rule StandardDeductionSum(p: Individual, y: TaxableYear, basic: Money, additional: Money) strict {
    label en official "the standard deduction is the sum of the basic standard deduction and the additional standard deduction";
    when not_known(standard_deduction_zero(p, y));
    when basic_standard_deduction(p, y, basic);
    when additional_standard_deduction(p, y, additional);
    then standard_deduction(p, y, basic + additional);
}

// §63(c)(2): basic amounts by filing status. Basic amounts for "any other
// case" (single/MFS) and "head of household" are A3 parameters
// (`.lawparam.json` sidecars); the joint/surviving-spouse amount is,
// PER THE STATUTE ITSELF, 200% of the "other" amount, not a separately
// pinned dollar figure — modelled as a rule, not a third parameter file.

@source(IRC_S63_C, quote = "$4,400 in the case of a head of household")
rule BasicStandardDeductionHeadOfHousehold(p: Individual, y: TaxableYear) strict {
    label en official "the basic standard deduction for a head of household";
    when us.irc.income_individual::filing_status(p, y, us.irc.income_individual::HeadOfHousehold);
    then basic_standard_deduction_before_dependent_cap(p, y, round(BasicStandardDeductionHeadOfHouseholdAmount, 2, "HALF_UP"));
}

@source(IRC_S63_C, quote = "$3,000 in any other case")
rule BasicStandardDeductionOther(p: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus) strict {
    label en official "the basic standard deduction in any other case (unmarried, married filing separately)";
    when us.irc.income_individual::filing_status(p, y, s);
    when s == us.irc.income_individual::Unmarried or s == us.irc.income_individual::MarriedSeparate;
    then basic_standard_deduction_before_dependent_cap(p, y, round(BasicStandardDeductionOtherAmount, 2, "HALF_UP"));
}

@source(IRC_S63_C, quote = "200 percent of the dollar amount in effect under subparagraph (C) for the taxable year in the case of")
rule BasicStandardDeductionJoint(p: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus) strict {
    label en official "the basic standard deduction for a joint return or surviving spouse is 200 percent of the 'any other case' amount";
    when us.irc.income_individual::filing_status(p, y, s);
    when s == us.irc.income_individual::Joint;
    then basic_standard_deduction_before_dependent_cap(p, y, 2.00 * round(BasicStandardDeductionOtherAmount, 2, "HALF_UP"));
}

// §63(c)(6): certain individuals not eligible — standard deduction is zero.
pub relation standard_deduction_zero(p: Individual, y: TaxableYear) kind institutional {
    label en official "the standard deduction is zero (section 63(c)(6))";
}
relation married_filing_separately_spouse_itemizes(p: Individual, y: TaxableYear) kind empirical {
    label en official "a married individual filing a separate return where either spouse itemizes deductions (section 63(c)(6)(A))";
}
relation short_period_return_443a1(p: Individual, y: TaxableYear) kind empirical {
    label en official "an individual making a return under section 443(a)(1) for a period of less than 12 months on account of a change in annual accounting period (section 63(c)(6)(C))";
}

@source(IRC_S63_C, quote = "a married individual filing a separate return where either spouse itemizes deductions")
rule StandardDeductionZeroMfsSpouseItemizes(p: Individual, y: TaxableYear) strict {
    label en official "no standard deduction for a married individual filing separately whose spouse itemizes";
    when married_filing_separately_spouse_itemizes(p, y);
    then standard_deduction_zero(p, y);
}

@source(IRC_S63_C, quote = "a nonresident alien individual")
rule StandardDeductionZeroNonresidentAlien(p: Individual, y: TaxableYear) strict {
    label en official "no standard deduction for a nonresident alien individual";
    when us.irc.income_individual::nonresident_alien(p, y);
    then standard_deduction_zero(p, y);
}

@source(IRC_S63_C, quote = "an individual making a return under section 443(a)(1) for a period of less than 12 months on account of a change in his annual accounting period")
rule StandardDeductionZeroShortPeriod(p: Individual, y: TaxableYear) strict {
    label en official "no standard deduction for a short-period return on a change of accounting period";
    when short_period_return_443a1(p, y);
    then standard_deduction_zero(p, y);
}
// §63(c)(6)(D) (estate, trust, common trust fund, partnership) is out of
// scope for `Individual`-typed `p` here by construction of this relation's
// signature; recorded as a coverage note (non-individual filers are core's
// `Estate`/`Trust`/`Partnership` types, not this relation's domain — a
// distinct disposition for those entity types, INTERPRETATION: no fact
// pattern in an `Individual`-typed scenario can exercise it).

// §63(c)(5): limitation for certain dependents.
relation claimed_as_dependent_151(p: Individual, y: TaxableYear) kind institutional {
    label en official "a deduction under section 151 is allowable to another taxpayer with respect to this individual for a taxable year beginning in the calendar year the individual's taxable year begins (section 63(c)(5)) — dependency contract, producer: unresolved (section 151, stage 2)";
}
relation earned_income_of(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "earned income of the individual for the taxable year — dependency contract, producer: unresolved";
}

@source(IRC_S63_C, quote = "the basic standard deduction applicable to such individual for such individual's taxable year shall not exceed the greater of")
rule DependentBasicStandardDeductionLimitationCapped(p: Individual, y: TaxableYear, uncapped: Money, earned: Money) strict {
    label en official "a dependent's basic standard deduction is capped at the greater of $500 or $250 plus earned income, when the uncapped amount exceeds that cap";
    when claimed_as_dependent_151(p, y);
    when earned_income_of(p, y, earned);
    when basic_standard_deduction_before_dependent_cap(p, y, uncapped);
    when uncapped > (if round(DependentStandardDeductionFloorAmount, 2, "HALF_UP") > round(DependentStandardDeductionEarnedIncomeAddonAmount, 2, "HALF_UP") + earned then round(DependentStandardDeductionFloorAmount, 2, "HALF_UP") else round(DependentStandardDeductionEarnedIncomeAddonAmount, 2, "HALF_UP") + earned);
    then basic_standard_deduction(p, y,
        if round(DependentStandardDeductionFloorAmount, 2, "HALF_UP") > round(DependentStandardDeductionEarnedIncomeAddonAmount, 2, "HALF_UP") + earned
        then round(DependentStandardDeductionFloorAmount, 2, "HALF_UP")
        else round(DependentStandardDeductionEarnedIncomeAddonAmount, 2, "HALF_UP") + earned);
}

@source(IRC_S63_C, quote = "the basic standard deduction applicable to such individual for such individual's taxable year shall not exceed the greater of")
rule DependentBasicStandardDeductionLimitationNotBinding(p: Individual, y: TaxableYear, uncapped: Money, earned: Money) strict {
    label en official "a dependent's basic standard deduction is left unchanged when the uncapped amount does not exceed the section 63(c)(5) cap";
    when claimed_as_dependent_151(p, y);
    when earned_income_of(p, y, earned);
    when basic_standard_deduction_before_dependent_cap(p, y, uncapped);
    when uncapped <= (if round(DependentStandardDeductionFloorAmount, 2, "HALF_UP") > round(DependentStandardDeductionEarnedIncomeAddonAmount, 2, "HALF_UP") + earned then round(DependentStandardDeductionFloorAmount, 2, "HALF_UP") else round(DependentStandardDeductionEarnedIncomeAddonAmount, 2, "HALF_UP") + earned);
    then basic_standard_deduction(p, y, uncapped);
}

@source(IRC_S63_C)
rule BasicStandardDeductionNonDependentPassthrough(p: Individual, y: TaxableYear, uncapped: Money) strict {
    label en official "an individual not claimed as a dependent under section 151 takes the basic standard deduction by filing status unchanged (section 63(c)(5) does not apply)";
    when basic_standard_deduction_before_dependent_cap(p, y, uncapped);
    when not_known(claimed_as_dependent_151(p, y));
    then basic_standard_deduction(p, y, uncapped);
}
// TECH_GAP: this rule and `BasicStandardDeductionHeadOfHousehold`/`...Other`/
// `...Joint` both conclude `basic_standard_deduction` for the same (p, y);
// whether the engine's conflict/priority handling picks "the more specific
// (capped) amount wins" without an explicit `priority`/`unless` link is
// UNVERIFIED (no heavy check run). Flagged for the coordinator: a
// `priority` clause between this rule and the three filing-status rules, or
// rewriting this rule to `unless` those three, may be needed before this
// disposition is more than `implemented_unverified`.

// §63(c)(3)/(f): additional standard deduction for aged and blind.
relation aged_65_self(p: Individual, y: TaxableYear) kind empirical { label en official "has attained age 65 before the close of the taxable year (section 63(f)(1)(A))"; }
relation blind_self(p: Individual, y: TaxableYear) kind empirical { label en official "is blind at the close of the taxable year (section 63(f)(2)(A))"; }
relation aged_65_spouse(p: Individual, y: TaxableYear) kind empirical { label en official "spouse has attained age 65 before the close of the taxable year, with an additional exemption allowable under section 151(b) (section 63(f)(1)(B))"; }
relation blind_spouse(p: Individual, y: TaxableYear) kind empirical { label en official "spouse is blind as of the close of the taxable year, with an additional exemption allowable under section 151(b) (section 63(f)(2)(B))"; }
relation unmarried_not_surviving_spouse(p: Individual, y: TaxableYear) kind institutional { label en official "not married and not a surviving spouse (section 63(f)(3))"; }

@source(IRC_S63_G, quote = "marital status shall be determined under section 7703")
rule UnmarriedNotSurvivingSpouseTest(p: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus) strict {
    label en official "not married and not a surviving spouse, for purposes of section 63(f)(3)";
    when us.irc.income_individual::filing_status(p, y, s);
    when s == us.irc.income_individual::Unmarried or s == us.irc.income_individual::MarriedSeparate;
    when not us.irc.income_individual::surviving_spouse(p, y);
    then unmarried_not_surviving_spouse(p, y);
}

@source(IRC_S63_F, quote = "The taxpayer shall be entitled to an additional amount of $600")
rule AgedBlindAdditionalAmountMarried(p: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus) strict {
    label en official "the aged/blind additional amount(s), $600 each, for a taxpayer who is married or a surviving spouse";
    when us.irc.income_individual::filing_status(p, y, s);
    when not_known(unmarried_not_surviving_spouse(p, y));
    then additional_standard_deduction(p, y,
        (if established(aged_65_self(p, y)) then round(AgedOrBlindAdditionalAmountMarried, 2, "HALF_UP") else 0.00 USD)
        + (if established(blind_self(p, y)) then round(AgedOrBlindAdditionalAmountMarried, 2, "HALF_UP") else 0.00 USD)
        + (if established(aged_65_spouse(p, y)) then round(AgedOrBlindAdditionalAmountMarried, 2, "HALF_UP") else 0.00 USD)
        + (if established(blind_spouse(p, y)) then round(AgedOrBlindAdditionalAmountMarried, 2, "HALF_UP") else 0.00 USD));
}

@source(IRC_S63_F, quote = "paragraphs (1) and (2) shall be applied by substituting \"$750\" for \"$600\"")
rule AgedBlindAdditionalAmountUnmarried(p: Individual, y: TaxableYear) strict {
    label en official "the aged/blind additional amount(s), $750 each, for an individual who is not married and not a surviving spouse";
    when unmarried_not_surviving_spouse(p, y);
    then additional_standard_deduction(p, y,
        (if established(aged_65_self(p, y)) then round(AgedOrBlindAdditionalAmountUnmarried, 2, "HALF_UP") else 0.00 USD)
        + (if established(blind_self(p, y)) then round(AgedOrBlindAdditionalAmountUnmarried, 2, "HALF_UP") else 0.00 USD));
}
// No additional-amount rule concludes when neither condition holds and the
// taxpayer is not aged/blind at all: a case package that asserts no
// aged/blind fact and needs `additional_standard_deduction(p, y, 0.00 USD)`
// asserts it directly, per the same open-world reasoning noted for
// `gross_income` in `s61-gross-income.law`.

// --- §63(d): itemized deductions defined ------------------------------------------
//
// "the deductions allowable under this chapter other than (1) the
// deductions allowable in arriving at adjusted gross income, and (2) any
// deduction referred to in any paragraph of subsection (b)." This is a
// DEFINITION over the full universe of chapter-1 deductions, which
// `deductions` (pending) owns; this package cannot itself enumerate "every
// deduction allowable under this chapter". `itemized_deductions_total` is
// therefore declared here as the PUB INTERFACE SYMBOL (matching the
// AGENT-BRIEF's expected pub list) and as a typed institutional dependency
// contract: `deductions` produces a value here that must, by construction,
// exclude the above-the-line paragraphs and the four (b) items — that
// constraint is documented, not machine-checked by this package.
pub relation itemized_deductions_total(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "itemized deductions (section 63(d)) — dependency contract, producer: deductions";
}

// --- §63(e): election to itemize --------------------------------------------------

relation elects_to_itemize_on_return(p: Individual, y: TaxableYear) kind empirical {
    label en official "signifies an election to itemize deductions on the return, in the manner the Secretary prescribes (section 63(e)(2))";
}

@source(IRC_S63_E, quote = "Any election under this subsection shall be made on the taxpayer's return, and the Secretary shall prescribe the manner of signifying such election on the return")
rule ElectionToItemizePowerRule(p: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus) strict {
    label en official "a taxpayer has the power to elect to itemize deductions by signifying the election on the return";
    when us.irc.income_individual::filing_status(p, y, s);
    then power ElectionToItemizePower {
        holder p;
        over y;
        exercise elects_to_itemize_on_return(p, y);
        valid_when elects_to_itemize_on_return(p, y);
        effect create(itemizes(p, y));
        window [@1986-01-01, infinity);
    };
}

relation change_of_election_regulations_satisfied(p: Individual, y: TaxableYear) kind empirical {
    label en official "a change of election with respect to itemized deductions is made under regulations prescribed by the Secretary, including any spouse-consistency and consent-to-assessment conditions of section 63(e)(3)(A)-(B) (section 63(e)(3))";
}

@source(IRC_S63_E, quote = "a change of election with respect to itemized deductions for any taxable year may be made after the filing of the return for such year")
rule ChangeOfElectionPowerRule(p: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus) strict {
    label en official "a taxpayer has the power to change a prior election with respect to itemized deductions after filing the return, under Treasury regulations";
    when us.irc.income_individual::filing_status(p, y, s);
    then power ChangeOfItemizationElectionPower {
        holder p;
        over y;
        exercise change_of_election_regulations_satisfied(p, y);
        valid_when change_of_election_regulations_satisfied(p, y);
        effect create(itemizes(p, y));
        window [@1986-01-01, infinity);
    };
}
// §63(e)(3) last sentence (spouse's liability compromised under section 7122
// bars the change) is a `unless`-style limitation on
// `change_of_election_regulations_satisfied` itself — modelled as a
// precondition of the case-asserted fact rather than a second power, since
// the statute frames it as "this paragraph shall not apply if...", i.e. a
// gate on validity, not a separate legal position.
