// Sections 64-65 — Ordinary income/loss defined. Stage 1 (IRC-06).
//
// Both sections are pure DEFINITIONS reclassifying certain gains/losses as
// "ordinary" for whatever other provision of the subtitle uses that term
// (e.g. the recapture rules); the underlying capital-asset/section-1231(b)
// classification test is `property-transactions`' own norm (pending).

use self::{
    IRC_S64,
    IRC_S65,
    Person,
    TaxableYear,
};

relation property_disposed(p: Person, asset: us.irc.core::Asset) kind empirical {
    label en official "the asset whose disposition produced the gain or loss asserted for this person and year — domain-binding fact for the section 64/65 capital-asset/1231(b) tests";
}
relation gain_from_sale_or_exchange_of_property(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "gain from the sale or exchange of property — dependency contract, producer: property-transactions";
}
relation loss_from_sale_or_exchange_of_property(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "loss from the sale or exchange of property — dependency contract, producer: property-transactions";
}
relation is_capital_asset(p: Person, asset: us.irc.core::Asset) kind institutional {
    label en official "a capital asset — dependency contract, producer: property-transactions (section 1221)";
}
relation is_section_1231b_property(p: Person, asset: us.irc.core::Asset) kind institutional {
    label en official "property described in section 1231(b) — dependency contract, producer: property-transactions";
}
relation treated_as_ordinary_income_elsewhere(p: Person, y: TaxableYear, asset: us.irc.core::Asset) kind institutional {
    label en official "gain treated or considered, under other provisions of this subtitle, as ordinary income — dependency contract, producer: unresolved (varies by recapture provision)";
}
relation treated_as_ordinary_loss_elsewhere(p: Person, y: TaxableYear, asset: us.irc.core::Asset) kind institutional {
    label en official "loss treated or considered, under other provisions of this subtitle, as ordinary loss — dependency contract, producer: unresolved";
}

pub relation ordinary_income(p: Person, y: TaxableYear, asset: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "ordinary income (section 64)";
}
pub relation ordinary_loss(p: Person, y: TaxableYear, asset: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "ordinary loss (section 65)";
}

@source(IRC_S64, quote = "the term \"ordinary income\" includes any gain from the sale or exchange of property which is neither a capital asset nor property described in section 1231(b)")
rule OrdinaryIncomeNeitherCapitalNor1231b(p: Person, y: TaxableYear, asset: us.irc.core::Asset, amount: Money) defeasible {
    label en official "gain from the sale or exchange of property that is neither a capital asset nor section 1231(b) property is ordinary income";
    when gain_from_sale_or_exchange_of_property(p, y, amount);
    when property_disposed(p, asset);
    when not_known(is_capital_asset(p, asset));
    when not_known(is_section_1231b_property(p, asset));
    then ordinary_income(p, y, asset, amount);
}

@source(IRC_S64, quote = "Any gain from the sale or exchange of property which is treated or considered, under other provisions of this subtitle, as \"ordinary income\" shall be treated as gain from the sale or exchange of property which is neither a capital asset nor property described in section 1231(b)")
rule OrdinaryIncomeElsewhereTreatedAsSuch(p: Person, y: TaxableYear, asset: us.irc.core::Asset, amount: Money) strict {
    label en official "gain treated as ordinary income under another provision is treated as gain from property that is neither a capital asset nor section 1231(b) property";
    when gain_from_sale_or_exchange_of_property(p, y, amount);
    when treated_as_ordinary_income_elsewhere(p, y, asset);
    then ordinary_income(p, y, asset, amount);
}

@source(IRC_S65, quote = "the term \"ordinary loss\" includes any loss from the sale or exchange of property which is not a capital asset")
rule OrdinaryLossNotCapitalAsset(p: Person, y: TaxableYear, asset: us.irc.core::Asset, amount: Money) defeasible {
    label en official "loss from the sale or exchange of property that is not a capital asset is ordinary loss";
    when loss_from_sale_or_exchange_of_property(p, y, amount);
    when property_disposed(p, asset);
    when not_known(is_capital_asset(p, asset));
    then ordinary_loss(p, y, asset, amount);
}

@source(IRC_S65, quote = "Any loss from the sale or exchange of property which is treated or considered, under other provisions of this subtitle, as \"ordinary loss\" shall be treated as loss from the sale or exchange of property which is not a capital asset")
rule OrdinaryLossElsewhereTreatedAsSuch(p: Person, y: TaxableYear, asset: us.irc.core::Asset, amount: Money) strict {
    label en official "loss treated as ordinary loss under another provision is treated as loss from property that is not a capital asset";
    when loss_from_sale_or_exchange_of_property(p, y, amount);
    when treated_as_ordinary_loss_elsewhere(p, y, asset);
    then ordinary_loss(p, y, asset, amount);
}
