// Section 67 — 2-percent floor on miscellaneous itemized deductions.
// Stage 1 (IRC-06).
//
// §67(g) is amended by Pub. L. 119-21 §70110: the pinned 2024-Edition text
// suspends miscellaneous itemized deductions "for any taxable year
// beginning after December 31, 2017, and before January 1, 2026"; §70110(a)
// strikes the sunset (permanent suspension) and (b) redesignates (g) as (h)
// while inserting a NEW (g) excepting educator expenses from the definition
// of "miscellaneous itemized deductions" (via new §67(b)(13)), effective
// for taxable years beginning after December 31, 2025. Modelled as
// `effective`-windowed rule pairs, same judgment call as `s63-taxable-
// income.law` (no second edition to name in a `revision_decl`).

use self::{
    IRC_S67_A,
    IRC_S67_B,
    IRC_S67_D,
    IRC_S67_G,
    Individual,
    TaxableYear,
    adjusted_gross_income,
};

pub enum MiscellaneousExclusionKind {
    InterestDeduction163;              // (b)(1)
    TaxesDeduction164;                 // (b)(2)
    CasualtyTheftLossDeduction165;     // (b)(3)
    CharitableDeductions170And642c;    // (b)(4)
    MedicalDeduction213;               // (b)(5)
    ImpairmentRelatedWorkExpenses;     // (b)(6)
    EstateTaxIrdDeduction691c;         // (b)(7)
    ShortSalePersonalPropertyDeduction;// (b)(8)
    ClaimOfRightDeduction1341;         // (b)(9)
    AnnuityInvestmentRecoveryDeduction72b3; // (b)(10)
    AmortizableBondPremiumDeduction171;// (b)(11)
    CooperativeHousingDeduction216;    // (b)(12)
    EducatorExpensesDeduction;         // (b)(13), added by Pub. L. 119-21 §70110(b)
}

// Case-asserted classification of a specific itemized deduction item into
// one of the excluded categories, OR the residual "miscellaneous" bucket.
// Producer of the underlying deduction line item and its amount: `deductions`
// (pending).
relation itemized_deduction_item(p: Individual, y: TaxableYear, excluded_kind: MiscellaneousExclusionKind, amount: Money) kind institutional {
    label en official "an itemized deduction item within one of the section 67(b) excluded categories — dependency contract, producer: deductions";
}
pub relation miscellaneous_itemized_deduction_item(p: Individual, y: TaxableYear, item_id: Integer, amount: Money) kind institutional {
    label en official "an itemized deduction item that is a miscellaneous itemized deduction (section 67(b), residual, i.e. not within any excluded category), identified by an item sequence number so several items can be aggregated — dependency contract, producer: deductions";
}

pub relation miscellaneous_itemized_deductions_allowed(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "miscellaneous itemized deductions allowed after the 2-percent floor (section 67(a))";
}

// --- §67(a)/(g) pre-2018 and post-2025 general rule (2% floor, not suspended) --

@source(IRC_S67_A, quote = "the miscellaneous itemized deductions for any taxable year shall be allowed only to the extent that the aggregate of such deductions exceeds 2 percent of adjusted gross income")
rule MiscellaneousFloorAppliesPre2018(p: Individual, y: TaxableYear, agi: Money) strict {
    label en official "before 2018: miscellaneous itemized deductions are allowed only above the 2-percent-of-AGI floor";
    effective (-infinity, @2018-01-01);
    when adjusted_gross_income(p, y, agi);
    when (sum all amount: Money for item_id: Integer where miscellaneous_itemized_deduction_item(p, y, item_id, amount)) > 0.02 * agi;
    then miscellaneous_itemized_deductions_allowed(p, y, (sum all amount: Money for item_id: Integer where miscellaneous_itemized_deduction_item(p, y, item_id, amount)) - 0.02 * agi);
}

@source(IRC_S67_A, quote = "the miscellaneous itemized deductions for any taxable year shall be allowed only to the extent that the aggregate of such deductions exceeds 2 percent of adjusted gross income")
rule MiscellaneousFloorAppliesFrom2026(p: Individual, y: TaxableYear, agi: Money) strict {
    label en official "for taxable years beginning after December 31, 2025: the 2-percent floor applies again (subject to the (g) educator-expense exception carved out of the definition, not this arithmetic)";
    effective [@2026-01-01, infinity);
    when adjusted_gross_income(p, y, agi);
    when (sum all amount: Money for item_id: Integer where miscellaneous_itemized_deduction_item(p, y, item_id, amount)) > 0.02 * agi;
    then miscellaneous_itemized_deductions_allowed(p, y, (sum all amount: Money for item_id: Integer where miscellaneous_itemized_deduction_item(p, y, item_id, amount)) - 0.02 * agi);
}

// --- §67(g) [pinned text] / suspension 2018-2025 (pre-amendment window) -------

@source(IRC_S67_G, quote = "no miscellaneous itemized deduction shall be allowed for any taxable year beginning after December 31, 2017, and before January 1, 2026")
rule MiscellaneousSuspended2018To2025(p: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus) strict {
    label en official "no miscellaneous itemized deduction is allowed for a taxable year beginning after December 31, 2017 and before January 1, 2026";
    effective [@2018-01-01, @2026-01-01);
    when us.irc.income_individual::filing_status(p, y, s);
    then miscellaneous_itemized_deductions_allowed(p, y, 0.00 USD);
}

// --- §67(h) as redesignated / suspension permanent from 2026 -------------------

// G6404 wiring, §67(b)(6): impairment-related work expenses (§67(d)) are the excluded kind of the list of (b), so the
// derived amount enters the excluded-kind items that `itemized_deduction_item` carries for the other kinds.
@source(IRC_S67_B, quote = "(6) any deduction allowable for impairment-related work expenses,")
rule ImpairmentRelatedWorkExpenseIsExcludedItem(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 67(b)(6): impairment-related work expenses are not miscellaneous itemized deductions";
    when impairment_related_work_expense(p, y, amount);
    then itemized_deduction_item(p, y, ImpairmentRelatedWorkExpenses, amount);
}
relation has_educator_expense_item(p: Individual, y: TaxableYear) kind institutional {
    label en official "the taxpayer has an itemized educator-expense item for the year (helper for the section 67(h) blanket-suspension carve-out)";
}
rule HasEducatorExpenseItem(p: Individual, y: TaxableYear, edu_amt: Money) strict {
    label en official "helper: derives has_educator_expense_item from an asserted educator-expense itemized deduction item";
    when itemized_deduction_item(p, y, EducatorExpensesDeduction, edu_amt);
    then has_educator_expense_item(p, y);
}

rule MiscellaneousSuspendedPermanentFrom2026(p: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus) strict {
    label en official "Pub. L. 119-21 section 70110(a): no miscellaneous itemized deduction is allowed for any taxable year beginning after December 31, 2017, with no further sunset (redesignated subsection (h) by section 70110(b)(2)), for scenarios beginning after December 31, 2025 not otherwise carved out by the educator-expense exception";
    effective [@2026-01-01, infinity);
    when us.irc.income_individual::filing_status(p, y, s);
    when not_known(has_educator_expense_item(p, y));
    then miscellaneous_itemized_deductions_allowed(p, y, 0.00 USD);
}
// NOTE: `MiscellaneousFloorAppliesFrom2026` and
// `MiscellaneousSuspendedPermanentFrom2026` both conclude
// `miscellaneous_itemized_deductions_allowed` for the same window — TECH_GAP,
// same conflict-priority caveat as `s63-taxable-income.law`'s
// `DependentBasicStandardDeductionLimitation`: which of the two applies to a
// scenario with NO miscellaneous items at all versus one with only
// educator-expense items is UNVERIFIED without running the engine's own
// conflict resolution (no heavy check performed). The intended reading is
// that (h)'s blanket suspension governs UNLESS the only miscellaneous item is
// educator expenses (which (g) as inserted removes from "miscellaneous" by
// definition entirely, so it should never reach (h) at all) — recorded as an
// INTERPRETATION pending a `priority`/`unless` wire-up.

// --- §67(c): anti-abuse regulatory delegation (non-normative) -----------------
//
// "The Secretary shall prescribe regulations which prohibit the indirect
// deduction through pass-thru entities..." — a delegation of rulemaking
// authority with no self-executing rule in the text itself (the actual
// prohibition exists only once such regulations are prescribed).
// classification = NON_NORMATIVE, reason: "directs the Secretary to
// prescribe regulations; the statute's own text sets no rule to apply
// without them." (c)(2)-(3) (publicly offered RIC exception, cooperative/
// REIT/estate-trust exception) are conditions ON that delegated rule, hence
// share the same classification.

// --- §67(d): impairment-related work expenses ----------------------------------

relation handicapped_individual_190b3(p: Individual) kind institutional {
    label en official "a handicapped individual (as defined in section 190(b)(3)) — dependency contract, producer: unresolved";
}
relation attendant_care_expense_at_workplace(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "expense for attendant care services at the individual's place of employment, or another expense necessary to be able to work (section 67(d)(1))";
}
relation section_162_deduction_allowable_without_regard_to_67(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "a deduction allowable under section 162, determined without regard to section 67 (section 67(d)(2)) — dependency contract, producer: deductions";
}
pub relation impairment_related_work_expense(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "impairment-related work expenses (section 67(d))";
}

@source(IRC_S67_D, quote = "of a handicapped individual (as defined in section 190(b)(3)) for attendant care services at the individual's place of employment and other expenses in connection with such place of employment which are necessary for such individual to be able to work")
rule ImpairmentRelatedWorkExpenseTest(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "attendant-care and workplace-necessity expenses of a handicapped individual, otherwise deductible under section 162, are impairment-related work expenses";
    when handicapped_individual_190b3(p);
    when attendant_care_expense_at_workplace(p, y, amount);
    when section_162_deduction_allowable_without_regard_to_67(p, y, amount);
    then impairment_related_work_expense(p, y, amount);
}

// --- §67(e): AGI of estates and trusts ------------------------------------------
//
// Estates/trusts are not `Individual`-typed under this package's aliases;
// `Person`-typed relations elsewhere in this package do not restrict to
// `Individual`, so a scenario with `p: us.irc.core::Trust`/`Estate` can
// assert `adjusted_gross_income`-shaped facts directly per (e)'s special AGI
// computation. Not separately re-derived here: classification =
// INTERPRETATION (this package models the individual case fully; the
// estate/trust variant of (e)(1)-(2) is a narrower restatement the
// `trusts-estates` owner package is better positioned to formalize against
// its own subchapter J relations, per the task's producer list).

// --- §67(f): coordination with section 162(a) dollar limitation ---------------
//
// A pure sequencing/priority rule between two limitations, neither of which
// this package computes to completion (the section 162(a) second-sentence
// dollar limitation is `deductions`' provision). classification =
// NON_NORMATIVE: it fixes an ORDER of application between two other
// sections' limitations, asserting no independent legal consequence.
