// Stage 2f (TECH_GAP reduction) — §108(c), (e)(2),(3),(6),(7),(8),(10), (g), (i).
// STATUS: implemented_unverified (static check only; scenarios in tests/s2f-e-108-residuals.lawtest
// are NOT executed).
//
// Judgment calls recorded in the coverage rows: (e)(3) premium/discount adjustment is read as
// carrying value (face + unamortized premium - unamortized discount); the section 1273/1274
// issue price of (e)(10) is a case fact; the (i) schedule rounds the yearly amount to cents
// HALF_UP and puts the remainder in the last year.

use self::{
    IRC_S108_C,
    IRC_S108_E,
    IRC_S108_G,
    IRC_S108_I,
    TaxableYear,
    discharge_of_indebtedness_excluded_108a,
    indebtedness_is_qualified_farm_indebtedness,
};

// (g)(1): qualified person
relation discharging_person_facts_108g1(creditor: us.irc.core::Person, taxpayer: us.irc.core::Person, regularly_engaged_in_lending: Boolean, related_to_taxpayer: Boolean, seller_of_the_property_or_related_to_seller: Boolean, government_or_instrumentality: Boolean) kind empirical {
    label en official "the discharging person: regularly engaged in the trade or business of lending money (section 49(a)(1)(D)(iv), external), related to the taxpayer, the seller of the financed property (or related to the seller), or a Federal, State or local government or agency or instrumentality";
}
pub relation qualified_person_108g1B(creditor: us.irc.core::Person, taxpayer: us.irc.core::Person) kind institutional {
    label en official "a qualified person: regularly engaged in lending and neither related to the taxpayer nor the seller (or related to the seller), or a government or its agency or instrumentality";
}
@source(IRC_S108_G, relation = formalizes, coverage = exact, quote = "For purposes of subparagraph (A), the term \"qualified person\" has the meaning given to such term by section 49(a)(1)(D)(iv); except that such term shall include any")
rule QualifiedPersonLender(creditor: us.irc.core::Person, taxpayer: us.irc.core::Person, seller: Boolean, gov: Boolean) strict {
    label en official "section 108(g)(1)(B), first limb: section 49(a)(1)(D)(iv) as read from its own text";
    when discharging_person_facts_108g1(creditor, taxpayer, true, false, false, gov);
    then qualified_person_108g1B(creditor, taxpayer);
}
@source(IRC_S108_G, relation = formalizes, coverage = exact, quote = "For purposes of subparagraph (A), the term \"qualified person\" has the meaning given to such term by section 49(a)(1)(D)(iv); except that such term shall include any")
rule QualifiedPersonGovernment(creditor: us.irc.core::Person, taxpayer: us.irc.core::Person, lender: Boolean, related: Boolean, seller: Boolean) strict {
    label en official "section 108(g)(1)(B): the term includes any Federal, State, or local government or agency or instrumentality";
    when discharging_person_facts_108g1(creditor, taxpayer, lender, related, seller, true);
    then qualified_person_108g1B(creditor, taxpayer);
}
relation discharge_creditor_108g1(p: us.irc.core::Person, y: TaxableYear, creditor: us.irc.core::Person) kind empirical {
    label en official "the person who discharged the taxpayer's indebtedness in the year";
}
pub relation discharge_by_person_not_qualified_108g1A(p: us.irc.core::Person, y: TaxableYear) kind institutional {
    label en official "the discharge was by a person who is not a qualified person, so subparagraph (C) of subsection (a)(1) does not apply";
}
@source(IRC_S108_G, relation = formalizes, coverage = exact, quote = "Subparagraph (C) of subsection (a)(1) shall apply only if the discharge is by a qualified person.")
rule DischargeByPersonNotQualified(p: us.irc.core::Person, y: TaxableYear, creditor: us.irc.core::Person) strict {
    label en official "section 108(g)(1)(A)";
    when discharge_creditor_108g1(p, y, creditor);
    when not_known(qualified_person_108g1B(creditor, p));
    then discharge_by_person_not_qualified_108g1A(p, y);
}

// (g)(2): qualified farm indebtedness
relation farm_debt_facts_108g2(debt: us.irc.core::Asset, incurred_directly_in_connection_with_farming: Boolean, farming_receipts: Money, total_receipts_3_preceding_years: Money) kind empirical {
    label en official "the debt was incurred directly in connection with the taxpayer's trade or business of farming, and the gross receipts of the 3 taxable years preceding the discharge year attributable to farming and in total";
}
pub relation qualified_farm_indebtedness_108g2(debt: us.irc.core::Asset) kind institutional {
    label en official "qualified farm indebtedness: incurred directly in connection with the farming business, and 50 percent or more of the aggregate gross receipts of the 3 preceding taxable years is attributable to farming";
}
@source(IRC_S108_G, relation = formalizes, coverage = exact, quote = "For purposes of this section, indebtedness of a taxpayer shall be treated as qualified farm indebtedness if—")
rule QualifiedFarmIndebtednessDefined(debt: us.irc.core::Asset, farm: Money, total: Money) strict {
    label en official "section 108(g)(2)(A)-(B): exact cross multiplication";
    when farm_debt_facts_108g2(debt, true, farm, total);
    when total > 0.00 USD;
    when farm * 2 >= total;
    then qualified_farm_indebtedness_108g2(debt);
}
relation tax_attributes_108g3(p: us.irc.core::Person, y: TaxableYear, net_operating_loss: Money, general_business_credit: Money, minimum_tax_credit: Money, capital_loss_carryover: Money, passive_activity_loss_carryover: Money, passive_activity_credit_carryover: Money, foreign_tax_credit_carryover: Money) kind empirical {
    label en official "the tax attributes of section 108(b)(2)(A), (B), (C), (D), (F), (G) determined after any reduction under subsection (b) by reason of amounts excluded under subsection (a)(1)(B) (section 108(g)(3)(D))";
}
pub relation adjusted_tax_attributes_108g3B(p: us.irc.core::Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the adjusted tax attributes: NOL, capital loss and passive activity loss carryovers at $1, and the general business credit, minimum tax credit, foreign tax credit and passive activity credit carryovers at $3 for each $1";
}
@source(IRC_S108_G, relation = formalizes, coverage = exact, quote = "For purposes of subparagraph (A), the term \"adjusted tax attributes\" means the sum of the tax attributes described in subparagraphs (A), (B), (C), (D), (F), and (G) of")
rule AdjustedTaxAttributes(p: us.irc.core::Person, y: TaxableYear, nol: Money, gbc: Money, mtc: Money, cl: Money, pal: Money, pac: Money, ftc: Money) strict {
    label en official "section 108(g)(3)(B)";
    when tax_attributes_108g3(p, y, nol, gbc, mtc, cl, pal, pac, ftc);
    then adjusted_tax_attributes_108g3B(p, y, nol + cl + pal + (gbc + mtc + pac + ftc) * 3);
}
relation qualified_property_basis_108g3C(p: us.irc.core::Person, y: TaxableYear, aggregate_adjusted_basis: Money) kind empirical {
    label en official "the aggregate adjusted bases of qualified property (used or held for use in a trade or business or for the production of income) held as of the beginning of the taxable year following the discharge year, after any reduction under subsection (b) by reason of (a)(1)(B) amounts";
}
pub relation farm_exclusion_cap_108g3A(p: us.irc.core::Person, y: TaxableYear, cap: Money) kind institutional {
    label en official "the amount excluded under (a)(1)(C) shall not exceed the sum of the adjusted tax attributes and the aggregate adjusted bases of qualified property";
}
@source(IRC_S108_G, relation = formalizes, coverage = exact, quote = "The amount excluded under subparagraph (C) of subsection (a)(1) shall not exceed the sum of—")
rule FarmExclusionCap(p: us.irc.core::Person, y: TaxableYear, attributes: Money, basis: Money) strict {
    label en official "section 108(g)(3)(A)(i)-(ii)";
    when adjusted_tax_attributes_108g3B(p, y, attributes);
    when qualified_property_basis_108g3C(p, y, basis);
    then farm_exclusion_cap_108g3A(p, y, attributes + basis);
}
pub relation farm_discharge_excluded_amount_108g3(p: us.irc.core::Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the qualified farm indebtedness discharge excluded, not above the cap; the rest is included";
}
@source(IRC_S108_G, relation = formalizes, coverage = exact, quote = "The amount excluded under subparagraph (C) of subsection (a)(1) shall not exceed the sum of—")
rule FarmDischargeExcludedAmount(p: us.irc.core::Person, y: TaxableYear, discharge: Money, cap: Money) strict {
    label en official "section 108(g)(3)(A) applied to the discharge of a qualified farm indebtedness";
    when discharge_of_indebtedness_excluded_108a(p, y, discharge);
    when indebtedness_is_qualified_farm_indebtedness(p, y, discharge);
    when farm_exclusion_cap_108g3A(p, y, cap);
    then farm_discharge_excluded_amount_108g3(p, y, min(discharge, cap));
}

// (c): qualified real property business indebtedness
relation qrpbi_facts_108c3(debt: us.irc.core::Asset, incurred_or_assumed_in_connection_with_real_property_used_in_business_and_secured: Boolean, incurred_before_1993: Boolean, is_qualified_acquisition_indebtedness_108c4: Boolean, election_made: Boolean, is_qualified_farm_indebtedness: Boolean) kind empirical {
    label en official "the facts of section 108(c)(3)(A)-(C) and the last sentence: incurred or assumed in connection with business real property and secured by it, incurred before 1993 or qualified acquisition indebtedness, the taxpayer's election, and whether it is qualified farm indebtedness";
}
pub relation qualified_real_property_business_indebtedness_108c3(debt: us.irc.core::Asset) kind institutional {
    label en official "qualified real property business indebtedness";
}
@source(IRC_S108_C, relation = formalizes, coverage = exact, quote = "The term \"qualified real property business indebtedness\" means indebtedness which—")
rule QrpbiPre1993(debt: us.irc.core::Asset, qai: Boolean) strict {
    label en official "section 108(c)(3)(A), (B) first limb, (C); not qualified farm indebtedness";
    when qrpbi_facts_108c3(debt, true, true, qai, true, false);
    then qualified_real_property_business_indebtedness_108c3(debt);
}
@source(IRC_S108_C, relation = formalizes, coverage = exact, quote = "(B) was incurred or assumed before January 1, 1993, or if incurred or assumed on or after such date, is qualified acquisition indebtedness, and")
rule QrpbiQualifiedAcquisition(debt: us.irc.core::Asset, pre: Boolean) strict {
    label en official "section 108(c)(3)(A), (B) second limb, (C); not qualified farm indebtedness";
    when qrpbi_facts_108c3(debt, true, pre, true, true, false);
    then qualified_real_property_business_indebtedness_108c3(debt);
}
relation acquisition_purpose_108c4(debt: us.irc.core::Asset, incurred_or_assumed_to_acquire_construct_reconstruct_or_substantially_improve_the_property: Boolean) kind empirical {
    label en official "the debt was incurred or assumed to acquire, construct, reconstruct, or substantially improve the real property";
}
pub relation qualified_acquisition_indebtedness_108c4(debt: us.irc.core::Asset) kind institutional {
    label en official "qualified acquisition indebtedness";
}
@source(IRC_S108_C, relation = formalizes, coverage = exact, quote = "For purposes of paragraph (3)(B), the term \"qualified acquisition indebtedness\" means, with respect to any real property described in paragraph (3)(A), indebtedness")
rule QualifiedAcquisitionIndebtednessDefined(debt: us.irc.core::Asset) strict {
    label en official "section 108(c)(4)";
    when acquisition_purpose_108c4(debt, true);
    then qualified_acquisition_indebtedness_108c4(debt);
}
relation refinancing_108c3(debt: us.irc.core::Asset, refinanced_amount: Money, new_amount: Money) kind empirical {
    label en official "indebtedness refinancing indebtedness of subparagraph (B): the amount of the indebtedness refinanced and the new amount";
}
pub relation refinanced_qrpbi_portion_108c3(debt: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the refinancing indebtedness qualifies only to the extent it does not exceed the amount refinanced";
}
@source(IRC_S108_C, relation = formalizes, coverage = exact, quote = "Such term shall not include qualified farm indebtedness. Indebtedness under subparagraph (B) shall include indebtedness resulting from the refinancing of indebtedness")
rule RefinancedQrpbiPortion(debt: us.irc.core::Asset, old: Money, new: Money) strict {
    label en official "section 108(c)(3), last sentence";
    when refinancing_108c3(debt, old, new);
    then refinanced_qrpbi_portion_108c3(debt, min(old, new));
}
relation qrpbi_cap_facts_108c2(p: us.irc.core::Person, y: TaxableYear, outstanding_principal_before_discharge: Money, fair_market_value_of_the_real_property: Money, other_qrpbi_secured_by_the_property: Money, aggregate_adjusted_bases_of_depreciable_real_property: Money) kind empirical {
    label en official "the outstanding principal of the indebtedness before the discharge, the fair market value of the securing property, the principal of other qualified real property business indebtedness secured by it, and the aggregate adjusted bases of depreciable real property held immediately before the discharge (after reductions under (b) and (g), other than property acquired in contemplation of the discharge)";
}
pub relation qrpbi_exclusion_cap_108c2(p: us.irc.core::Person, y: TaxableYear, cap: Money) kind institutional {
    label en official "the amount excluded under (a)(1)(D) shall not exceed the lesser of the excess of the outstanding principal over the net value of the property and the aggregate adjusted bases of depreciable real property";
}
@source(IRC_S108_C, relation = formalizes, coverage = exact, quote = "The amount excluded under subparagraph (D) of subsection (a)(1) with respect to any qualified real property business indebtedness shall not exceed the excess (if any) of—")
rule QrpbiExclusionCap(p: us.irc.core::Person, y: TaxableYear, principal: Money, fmv: Money, other: Money, bases: Money) strict {
    label en official "section 108(c)(2)(A)(i)-(ii) and (B)";
    when qrpbi_cap_facts_108c2(p, y, principal, fmv, other, bases);
    then qrpbi_exclusion_cap_108c2(p, y, min(max(0.00 USD, principal - (fmv - other)), bases));
}
relation qrpbi_discharge_108a1D(p: us.irc.core::Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the discharged amount of qualified real property business indebtedness";
}
pub relation qrpbi_excluded_amount_108c(p: us.irc.core::Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the excluded amount of the qualified real property business indebtedness discharge, within the cap";
}
@source(IRC_S108_C, relation = formalizes, coverage = exact, quote = "The amount excluded under subparagraph (D) of subsection (a)(1) with respect to any qualified real property business indebtedness shall not exceed the excess (if any) of—")
rule QrpbiExcludedAmount(p: us.irc.core::Person, y: TaxableYear, discharge: Money, cap: Money) strict {
    label en official "section 108(c)(2)";
    when qrpbi_discharge_108a1D(p, y, discharge);
    when qrpbi_exclusion_cap_108c2(p, y, cap);
    then qrpbi_excluded_amount_108c(p, y, min(discharge, cap));
}
pub relation depreciable_real_property_basis_reduction_108c1A(p: us.irc.core::Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount excluded under (a)(1)(D) reduces the basis of the depreciable real property of the taxpayer (the mechanics are in section 1017)";
}
@source(IRC_S108_C, relation = formalizes, coverage = exact, quote = "The amount excluded from gross income under subparagraph (D) of subsection (a)(1) shall be applied to reduce the basis of the depreciable real property of the taxpayer.")
rule QrpbiExcludedReducesBasis(p: us.irc.core::Person, y: TaxableYear, amount: Money) strict {
    label en official "section 108(c)(1)(A)";
    when qrpbi_excluded_amount_108c(p, y, amount);
    then depreciable_real_property_basis_reduction_108c1A(p, y, amount);
}

// (e)(2), (3): deduction rule and premium/discount
relation discharge_and_deductible_portion_108e2(p: us.irc.core::Person, y: TaxableYear, discharged_amount: Money, portion_payment_of_which_would_have_been_deductible: Money) kind empirical {
    label en official "the discharged amount and the portion of it the payment of which would have given rise to a deduction";
}
pub relation discharge_income_after_108e2(p: us.irc.core::Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "income from the discharge after taking out the portion that payment would have made deductible";
}
@source(IRC_S108_E, relation = formalizes, coverage = exact, quote = "No income shall be realized from the discharge of indebtedness to the extent that payment of the liability would have given rise to a deduction.")
rule DischargeIncomeAfterDeductibleRule(p: us.irc.core::Person, y: TaxableYear, amount: Money, ded: Money) strict {
    label en official "section 108(e)(2)";
    when discharge_and_deductible_portion_108e2(p, y, amount, ded);
    then discharge_income_after_108e2(p, y, max(0.00 USD, amount - ded));
}
relation discharge_premium_discount_108e3(p: us.irc.core::Person, y: TaxableYear, face_amount_discharged: Money, unamortized_premium: Money, unamortized_discount: Money) kind empirical {
    label en official "the face amount discharged and the unamortized premium and unamortized discount of the indebtedness";
}
pub relation discharge_amount_adjusted_108e3(p: us.irc.core::Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount taken into account: face amount plus unamortized premium less unamortized discount";
}
@source(IRC_S108_E, relation = formalizes, coverage = exact, quote = "The amount taken into account with respect to any discharge shall be properly adjusted for unamortized premium and unamortized discount with respect to the indebtedness")
rule DischargeAmountAdjustedForPremiumAndDiscount(p: us.irc.core::Person, y: TaxableYear, face: Money, prem: Money, disc: Money) strict {
    label en official "section 108(e)(3)";
    when discharge_premium_discount_108e3(p, y, face, prem, disc);
    then discharge_amount_adjusted_108e3(p, y, max(0.00 USD, face + prem - disc));
}

// (e)(6), (8), (10): deemed satisfaction amounts
relation shareholder_contribution_of_debt_108e6(debtor: us.irc.core::Person, y: TaxableYear, principal: Money, shareholder_adjusted_basis_in_the_debt: Money) kind empirical {
    label en official "a debtor corporation acquires its indebtedness from a shareholder as a contribution to capital, the principal of the debt and the shareholder's adjusted basis in it";
}
pub relation contribution_debt_satisfaction_amount_108e6(debtor: us.irc.core::Person, y: TaxableYear, satisfied_with: Money) kind institutional {
    label en official "the corporation is treated as having satisfied the indebtedness with money equal to the shareholder's adjusted basis in the debt (section 118 does not apply)";
}
@source(IRC_S108_E, relation = formalizes, coverage = exact, quote = "(B) such corporation shall be treated as having satisfied the indebtedness with an amount of money equal to the shareholder's adjusted basis in the indebtedness.")
rule ContributionDebtSatisfactionAmount(debtor: us.irc.core::Person, y: TaxableYear, principal: Money, basis: Money) strict {
    label en official "section 108(e)(6)(A)-(B)";
    when shareholder_contribution_of_debt_108e6(debtor, y, principal, basis);
    then contribution_debt_satisfaction_amount_108e6(debtor, y, basis);
}
pub relation contribution_discharge_income_108e6(debtor: us.irc.core::Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the discharge income: the principal over the shareholder's adjusted basis, not below zero";
}
@source(IRC_S108_E, relation = formalizes, coverage = exact, quote = "Except as provided in regulations, for purposes of determining income of the debtor from discharge of indebtedness, if a debtor corporation acquires its indebtedness")
rule ContributionDischargeIncome(debtor: us.irc.core::Person, y: TaxableYear, principal: Money, basis: Money) strict {
    label en official "section 108(e)(6)";
    when shareholder_contribution_of_debt_108e6(debtor, y, principal, basis);
    then contribution_discharge_income_108e6(debtor, y, max(0.00 USD, principal - basis));
}
relation equity_transfer_for_debt_108e8(debtor: us.irc.core::Person, y: TaxableYear, debt_principal: Money, fair_market_value_of_stock_or_interest: Money) kind empirical {
    label en official "a debtor corporation transfers stock, or a debtor partnership transfers a capital or profits interest, to a creditor in satisfaction of its recourse or nonrecourse indebtedness";
}
pub relation equity_transfer_satisfaction_amount_108e8(debtor: us.irc.core::Person, y: TaxableYear, satisfied_with: Money) kind institutional {
    label en official "the debtor is treated as having satisfied the indebtedness with money equal to the fair market value of the stock or interest";
}
@source(IRC_S108_E, relation = formalizes, coverage = exact, quote = "For purposes of determining income of a debtor from discharge of indebtedness, if—")
rule EquityTransferSatisfactionAmount(debtor: us.irc.core::Person, y: TaxableYear, principal: Money, fmv: Money) strict {
    label en official "section 108(e)(8)(A)-(B)";
    when equity_transfer_for_debt_108e8(debtor, y, principal, fmv);
    then equity_transfer_satisfaction_amount_108e8(debtor, y, fmv);
}
pub relation equity_transfer_discharge_income_108e8(debtor: us.irc.core::Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the discharge income: the debt over the fair market value of the equity, not below zero";
}
@source(IRC_S108_E, relation = formalizes, coverage = exact, quote = "For purposes of determining income of a debtor from discharge of indebtedness, if—")
rule EquityTransferDischargeIncome(debtor: us.irc.core::Person, y: TaxableYear, principal: Money, fmv: Money) strict {
    label en official "section 108(e)(8)";
    when equity_transfer_for_debt_108e8(debtor, y, principal, fmv);
    then equity_transfer_discharge_income_108e8(debtor, y, max(0.00 USD, principal - fmv));
}
relation debt_instrument_for_debt_108e10(debtor: us.irc.core::Person, y: TaxableYear, principal: Money, issue_price_of_new_instrument: Money) kind empirical {
    label en official "a debtor issues a debt instrument in satisfaction of indebtedness; the issue price of the instrument (determined under sections 1273 and 1274, taken as input, and with section 1273(b)(4) applied by reducing the stated redemption price by the portion attributable to interest deferred under (b)(10))";
}
pub relation new_instrument_satisfaction_amount_108e10(debtor: us.irc.core::Person, y: TaxableYear, satisfied_with: Money) kind institutional {
    label en official "the debtor is treated as having satisfied the indebtedness with money equal to the issue price of the debt instrument";
}
@source(IRC_S108_E, relation = formalizes, coverage = exact, quote = "For purposes of determining income of a debtor from discharge of indebtedness, if a debtor issues a debt instrument in satisfaction of indebtedness, such debtor shall be")
rule NewInstrumentSatisfactionAmount(debtor: us.irc.core::Person, y: TaxableYear, principal: Money, price: Money) strict {
    label en official "section 108(e)(10)(A)";
    when debt_instrument_for_debt_108e10(debtor, y, principal, price);
    then new_instrument_satisfaction_amount_108e10(debtor, y, price);
}
pub relation new_instrument_discharge_income_108e10(debtor: us.irc.core::Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the discharge income: the indebtedness over the issue price, not below zero";
}
@source(IRC_S108_E, relation = formalizes, coverage = exact, quote = "For purposes of determining income of a debtor from discharge of indebtedness, if a debtor issues a debt instrument in satisfaction of indebtedness, such debtor shall be")
rule NewInstrumentDischargeIncome(debtor: us.irc.core::Person, y: TaxableYear, principal: Money, price: Money) strict {
    label en official "section 108(e)(10)(A)";
    when debt_instrument_for_debt_108e10(debtor, y, principal, price);
    then new_instrument_discharge_income_108e10(debtor, y, max(0.00 USD, principal - price));
}

// (e)(7): creditor's section 1245 recapture on stock received for debt
relation creditor_stock_for_debt_108e7(creditor: us.irc.core::Person, stock: us.irc.core::Asset, deductions_under_166: Money, ordinary_loss_on_exchange: Money, amount_included_in_gross_income_on_exchange: Money, cash_method_adjustment: Money) kind empirical {
    label en official "a creditor acquires stock of a debtor corporation in satisfaction of its indebtedness: the deductions under section 166(a) or (b), the ordinary loss on the exchange, the amount included in the creditor's gross income on the exchange, and the cash-method adjustment of subparagraph (B)";
}
pub relation stock_is_section_1245_property_108e7Ai(stock: us.irc.core::Asset) kind institutional {
    label en official "the stock (and property with basis determined by reference to it) is treated as section 1245 property";
}
@source(IRC_S108_E, relation = formalizes, coverage = exact, quote = "(i) such stock (and any other property the basis of which is determined in whole or in part by reference to the adjusted basis of such stock) shall be treated as section")
rule StockTreatedAsSection1245Property(creditor: us.irc.core::Person, stock: us.irc.core::Asset, a: Money, b: Money, c: Money, d: Money) strict {
    label en official "section 108(e)(7)(A)(i)";
    when creditor_stock_for_debt_108e7(creditor, stock, a, b, c, d);
    then stock_is_section_1245_property_108e7Ai(stock);
}
pub relation deemed_depreciation_amount_108e7A(creditor: us.irc.core::Person, stock: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the aggregate deductions and ordinary loss treated as depreciation allowed, reduced by the amount included in gross income on the exchange, and by the cash-method adjustment";
}
@source(IRC_S108_E, relation = formalizes, coverage = exact, quote = "(ii) the aggregate amount allowed to the creditor—")
rule DeemedDepreciationAmount(creditor: us.irc.core::Person, stock: us.irc.core::Asset, ded: Money, loss: Money, inc: Money, adj: Money) strict {
    label en official "section 108(e)(7)(A)(ii), the closing sentence of (A), and (B)";
    when creditor_stock_for_debt_108e7(creditor, stock, ded, loss, inc, adj);
    then deemed_depreciation_amount_108e7A(creditor, stock, max(0.00 USD, ded + loss - inc - adj));
}
relation control_and_successor_facts_108e7(corporation: us.irc.core::Person, debtor: us.irc.core::Person, controls_debtor_under_368c: Boolean, successor_of_debtor: Boolean) kind empirical {
    label en official "the corporation is in control (section 368(c)) of the debtor corporation, or is its successor";
}
pub relation treated_as_debtor_corporation_108e7(corporation: us.irc.core::Person, debtor: us.irc.core::Person) kind institutional {
    label en official "stock of a corporation in control of the debtor corporation is treated as stock of the debtor corporation; the debtor corporation includes a successor";
}
@source(IRC_S108_E, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, stock of a corporation in control (within the meaning of section 368(c)) of the debtor corporation shall be treated as stock of the")
rule ControllingCorporationTreatedAsDebtor(corporation: us.irc.core::Person, debtor: us.irc.core::Person, s: Boolean) strict {
    label en official "section 108(e)(7)(C)";
    when control_and_successor_facts_108e7(corporation, debtor, true, s);
    then treated_as_debtor_corporation_108e7(corporation, debtor);
}
@source(IRC_S108_E, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the term \"debtor corporation\" includes a successor corporation.")
rule SuccessorTreatedAsDebtor(corporation: us.irc.core::Person, debtor: us.irc.core::Person, c: Boolean) strict {
    label en official "section 108(e)(7)(D)";
    when control_and_successor_facts_108e7(corporation, debtor, c, true);
    then treated_as_debtor_corporation_108e7(corporation, debtor);
}

// (i): deferral for reacquisitions in 2009 and 2010
relation reacquisition_facts_108i(instrument: us.irc.core::Asset, issuer: us.irc.core::Person, issued_by_c_corporation: Boolean, issued_in_connection_with_business: Boolean, reacquisition_year: Integer, reacquired_by_debtor: Boolean, reacquired_by_related_person: Boolean) kind empirical {
    label en official "the debt instrument, its issuer, whether it was issued by a C corporation or in connection with a trade or business, the year of the acquisition, and whether the acquirer is the debtor or a related person (determined as under subsection (e)(4))";
}
pub relation applicable_debt_instrument_108i3A(instrument: us.irc.core::Asset) kind institutional {
    label en official "an applicable debt instrument: issued by a C corporation, or by any other person in connection with the conduct of a trade or business";
}
@source(IRC_S108_I, relation = formalizes, coverage = exact, quote = "(i) a C corporation, or")
rule ApplicableDebtInstrumentCCorporation(instrument: us.irc.core::Asset, issuer: us.irc.core::Person, b: Boolean, y: Integer, d: Boolean, r: Boolean) strict {
    label en official "section 108(i)(3)(A)(i)";
    when reacquisition_facts_108i(instrument, issuer, true, b, y, d, r);
    then applicable_debt_instrument_108i3A(instrument);
}
@source(IRC_S108_I, relation = formalizes, coverage = exact, quote = "(ii) any other person in connection with the conduct of a trade or business by such person.")
rule ApplicableDebtInstrumentBusiness(instrument: us.irc.core::Asset, issuer: us.irc.core::Person, c: Boolean, y: Integer, d: Boolean, r: Boolean) strict {
    label en official "section 108(i)(3)(A)(ii)";
    when reacquisition_facts_108i(instrument, issuer, c, true, y, d, r);
    then applicable_debt_instrument_108i3A(instrument);
}
pub relation reacquisition_of_applicable_instrument_108i4(instrument: us.irc.core::Asset, year: Integer) kind institutional {
    label en official "a reacquisition after December 31, 2008 and before January 1, 2011 of an applicable debt instrument by the debtor or a related person";
}
@source(IRC_S108_I, relation = formalizes, coverage = exact, quote = "The term \"reacquisition\" means, with respect to any applicable debt instrument, any acquisition of the debt instrument by—")
rule ReacquisitionByDebtor(instrument: us.irc.core::Asset, issuer: us.irc.core::Person, c: Boolean, b: Boolean, year: Integer, r: Boolean) strict {
    label en official "section 108(i)(4)(A)(i) with (1)";
    when reacquisition_facts_108i(instrument, issuer, c, b, year, true, r);
    when applicable_debt_instrument_108i3A(instrument);
    when year >= 2009;
    when year <= 2010;
    then reacquisition_of_applicable_instrument_108i4(instrument, year);
}
@source(IRC_S108_I, relation = formalizes, coverage = exact, quote = "(ii) a related person to such debtor.")
rule ReacquisitionByRelatedPerson(instrument: us.irc.core::Asset, issuer: us.irc.core::Person, c: Boolean, b: Boolean, year: Integer, d: Boolean) strict {
    label en official "section 108(i)(4)(A)(ii) with (1)";
    when reacquisition_facts_108i(instrument, issuer, c, b, year, d, true);
    when applicable_debt_instrument_108i3A(instrument);
    when year >= 2009;
    when year <= 2010;
    then reacquisition_of_applicable_instrument_108i4(instrument, year);
}
relation deferral_election_facts_108i5B(instrument: us.irc.core::Asset, identifies_instrument: Boolean, states_amount_of_income: Boolean, filed_with_return_for_reacquisition_year: Boolean, entity_is_pass_thru: Boolean, made_by_the_pass_thru_entity: Boolean) kind empirical {
    label en official "the election statement: it identifies the instrument, includes the amount of income to which paragraph (1) applies, is included with the return for the reacquisition year; for a partnership, S corporation or other pass-thru entity, it is made by the entity";
}
pub relation deferral_election_valid_108i5B(instrument: us.irc.core::Asset) kind institutional {
    label en official "a valid election under subsection (i)";
}
@source(IRC_S108_I, relation = formalizes, coverage = exact, quote = "An election under this subsection with respect to any applicable debt instrument shall be made by including with the return of tax imposed by chapter 1 for the taxable")
rule DeferralElectionValid(instrument: us.irc.core::Asset) strict {
    label en official "section 108(i)(5)(B)(i)-(iii): an entity's election is made by the entity";
    when deferral_election_facts_108i5B(instrument, true, true, true, false, false);
    then deferral_election_valid_108i5B(instrument);
}
@source(IRC_S108_I, relation = formalizes, coverage = exact, quote = "In the case of a partnership, S corporation, or other pass-thru entity, the election under this subsection shall be made by the partnership, the S corporation, or other")
rule DeferralElectionValidPassThrough(instrument: us.irc.core::Asset) strict {
    label en official "section 108(i)(5)(B)(iii)";
    when deferral_election_facts_108i5B(instrument, true, true, true, true, true);
    then deferral_election_valid_108i5B(instrument);
}
relation deferral_amount_facts_108i1(instrument: us.irc.core::Asset, taxpayer: us.irc.core::Person, reacquisition_year: Integer, discharge_income: Money) kind empirical {
    label en official "the reacquisition year and the income from the discharge of indebtedness in connection with the reacquisition";
}
pub relation deferral_start_year_108i1(instrument: us.irc.core::Asset, year: Integer) kind institutional {
    label en official "the 5-year period begins with the fifth taxable year after the reacquisition year for a 2009 reacquisition, the fourth for a 2010 reacquisition";
}
@source(IRC_S108_I, relation = formalizes, coverage = exact, quote = "(A) in the case of a reacquisition occurring in 2009, the fifth taxable year following the taxable year in which the reacquisition occurs, and")
rule DeferralStartYear2009(instrument: us.irc.core::Asset, taxpayer: us.irc.core::Person, income: Money) strict {
    label en official "section 108(i)(1)(A)";
    when deferral_election_valid_108i5B(instrument);
    when reacquisition_of_applicable_instrument_108i4(instrument, 2009);
    when deferral_amount_facts_108i1(instrument, taxpayer, 2009, income);
    then deferral_start_year_108i1(instrument, 2014);
}
@source(IRC_S108_I, relation = formalizes, coverage = exact, quote = "(B) in the case of a reacquisition occurring in 2010, the fourth taxable year following the taxable year in which the reacquisition occurs.")
rule DeferralStartYear2010(instrument: us.irc.core::Asset, taxpayer: us.irc.core::Person, income: Money) strict {
    label en official "section 108(i)(1)(B)";
    when deferral_election_valid_108i5B(instrument);
    when reacquisition_of_applicable_instrument_108i4(instrument, 2010);
    when deferral_amount_facts_108i1(instrument, taxpayer, 2010, income);
    then deferral_start_year_108i1(instrument, 2014);
}
pub relation deferred_income_inclusion_108i1(instrument: us.irc.core::Asset, year: Integer, amount: Money) kind institutional {
    label en official "the income includible in the taxable year: one fifth of the discharge income in each of the 5 years (each of the first four years rounded to cents HALF_UP, the last year carrying the remainder)";
}
@source(IRC_S108_I, relation = formalizes, coverage = exact, quote = "At the election of the taxpayer, income from the discharge of indebtedness in connection with the reacquisition after December 31, 2008, and before January 1, 2011, of")
rule DeferredInclusionFirstFourYears(instrument: us.irc.core::Asset, taxpayer: us.irc.core::Person, ry: Integer, income: Money, start: Integer, year: Integer) strict {
    label en official "section 108(i)(1): ratably over 5 taxable years, years 1-4";
    when deferral_start_year_108i1(instrument, start);
    when deferral_amount_facts_108i1(instrument, taxpayer, ry, income);
    when year_in_deferral_window_108i1(instrument, year);
    when year >= start;
    when year < start + 4;
    then deferred_income_inclusion_108i1(instrument, year, div_round(income, 5.0, 2, "HALF_UP"));
}
@source(IRC_S108_I, relation = formalizes, coverage = exact, quote = "At the election of the taxpayer, income from the discharge of indebtedness in connection with the reacquisition after December 31, 2008, and before January 1, 2011, of")
rule DeferredInclusionLastYear(instrument: us.irc.core::Asset, taxpayer: us.irc.core::Person, ry: Integer, income: Money, start: Integer) strict {
    label en official "section 108(i)(1): year 5 takes the remainder";
    when deferral_start_year_108i1(instrument, start);
    when deferral_amount_facts_108i1(instrument, taxpayer, ry, income);
    when year_in_deferral_window_108i1(instrument, start + 4);
    then deferred_income_inclusion_108i1(instrument, start + 4, income - div_round(income, 5.0, 2, "HALF_UP") * 4);
}
relation year_in_deferral_window_108i1(instrument: us.irc.core::Asset, year: Integer) kind empirical {
    label en official "a taxable year for which the inclusion is asked (the case names the year)";
}
pub relation section_108a1_exclusions_disapplied_108i5C(instrument: us.irc.core::Asset, taxpayer: us.irc.core::Person) kind institutional {
    label en official "if the taxpayer elects, subparagraphs (A)-(D) of subsection (a)(1) do not apply to the income from the discharge of that indebtedness for the year of the election or any later year";
}
@source(IRC_S108_I, relation = formalizes, coverage = exact, quote = "If a taxpayer elects to have this subsection apply to an applicable debt instrument, subparagraphs (A), (B), (C), and (D) of subsection (a)(1) shall not apply to the")
rule Section108a1ExclusionsDisapplied(instrument: us.irc.core::Asset, taxpayer: us.irc.core::Person, ry: Integer, income: Money) strict {
    label en official "section 108(i)(5)(C)";
    when deferral_election_valid_108i5B(instrument);
    when deferral_amount_facts_108i1(instrument, taxpayer, ry, income);
    then section_108a1_exclusions_disapplied_108i5C(instrument, taxpayer);
}
relation acceleration_event_108i5D(instrument: us.irc.core::Asset, year_of_event: Integer, event_is_death_liquidation_sale_of_substantially_all_assets_cessation_or_similar: Boolean, remaining_deferred_income: Money) kind empirical {
    label en official "the year of the death of the taxpayer, the liquidation or sale of substantially all the assets (including in a title 11 or similar case), the cessation of business, or a similar circumstance (or the sale, exchange or redemption of an interest in a pass-thru entity), and the remaining deferred income";
}
pub relation accelerated_inclusion_108i5D(instrument: us.irc.core::Asset, year: Integer, amount: Money) kind institutional {
    label en official "the deferred income is taken into account in the taxable year of the event (in the last return, in the case of death) and no longer deferred";
}
@source(IRC_S108_I, relation = formalizes, coverage = exact, quote = "In the case of the death of the taxpayer, the liquidation or sale of substantially all the assets of the taxpayer (including in a title 11 or similar case), the")
rule AcceleratedInclusionOnEvent(instrument: us.irc.core::Asset, year: Integer, amount: Money) strict {
    label en official "section 108(i)(5)(D)(i)-(ii)";
    when acceleration_event_108i5D(instrument, year, true, amount);
    when deferral_election_valid_108i5B(instrument);
    then accelerated_inclusion_108i5D(instrument, year, amount);
}
relation oid_deferral_facts_108i2(issuer: us.irc.core::Person, instrument: us.irc.core::Asset, oid_accrued_before_first_inclusion_year: Money, discharge_income: Money) kind empirical {
    label en official "the original issue discount accruing before the first taxable year of the 5-year inclusion period on the debt instrument issued for the reacquired instrument (or treated as issued for it under (2)(B)), and the discharge income on the reacquired instrument";
}
pub relation oid_deduction_disallowed_108i2(issuer: us.irc.core::Person, instrument: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the disallowed deduction: OID accruing before the first inclusion year up to the discharge income";
}
@source(IRC_S108_I, relation = formalizes, coverage = exact, quote = "(i) except as provided in clause (ii), no deduction otherwise allowable under this chapter shall be allowed to the issuer of such debt instrument with respect to the")
rule OidDeductionDisallowed(issuer: us.irc.core::Person, instrument: us.irc.core::Asset, oid: Money, income: Money) strict {
    label en official "section 108(i)(2)(A)(i)(I)-(II)";
    when oid_deferral_facts_108i2(issuer, instrument, oid, income);
    then oid_deduction_disallowed_108i2(issuer, instrument, min(oid, income));
}
pub relation oid_deduction_allowed_yearly_108i2(issuer: us.irc.core::Person, instrument: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the disallowed deductions are allowed ratably over the 5-taxable-year period (one fifth each, rounded to cents HALF_UP)";
}
@source(IRC_S108_I, relation = formalizes, coverage = exact, quote = "(ii) the aggregate amount of deductions disallowed under clause (i) shall be allowed as a deduction ratably over the 5-taxable-year period described in clause (i)(I).")
rule OidDeductionAllowedRatably(issuer: us.irc.core::Person, instrument: us.irc.core::Asset, amount: Money) strict {
    label en official "section 108(i)(2)(A)(ii)";
    when oid_deduction_disallowed_108i2(issuer, instrument, amount);
    then oid_deduction_allowed_yearly_108i2(issuer, instrument, div_round(amount, 5.0, 2, "HALF_UP"));
}
relation partnership_deferral_partner_share_108i6(partnership: us.irc.core::Person, partner: us.irc.core::Person, deferred_income: Money, distributive_share_immediately_before_discharge: Decimal) kind empirical {
    label en official "the deferred income of a partnership and a partner's distributive share under section 704 immediately before the discharge, as if the income were recognized at that time";
}
pub relation deferred_income_allocated_to_partner_108i6(partnership: us.irc.core::Person, partner: us.irc.core::Person, amount: Money) kind institutional {
    label en official "the deferred income allocated to a partner";
}
@source(IRC_S108_I, relation = formalizes, coverage = exact, quote = "In the case of a partnership, any income deferred under this subsection shall be allocated to the partners in the partnership immediately before the discharge in the")
rule DeferredIncomeAllocatedToPartner(partnership: us.irc.core::Person, partner: us.irc.core::Person, income: Money, share: Decimal) strict {
    label en official "section 108(i)(6)";
    when partnership_deferral_partner_share_108i6(partnership, partner, income, share);
    then deferred_income_allocated_to_partner_108i6(partnership, partner, round(income * share, 2, "HALF_UP"));
}
