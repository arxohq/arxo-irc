    when named_exception_matches_1986(issue, 1317, 33, 7);
    when named_exception_aggregate_face_1986(1317, 33, 7, total);
    when total <= 80000000.00 USD;
    when named_exception_net_proceeds_share_1986(issue, share);
    when share >= 0.95;
    when issue_within_1317_termination(issue);
    then named_exception_applies_1986(issue, 1317, 33, 7);
}

