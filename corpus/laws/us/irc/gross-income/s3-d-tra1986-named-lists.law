// Stage 3 (TECH_GAP reduction): the list-style paragraphs of section 1317 of Pub. L. 99-514
// (Tax Reform Act of 1986), quoted in the statutory note under section 141 (fragment
// IRC_S141_NOTE_6): a facility "described in this subparagraph if ..." followed by dates of
// resolutions, ordinances and agreements and an aggregate face amount limit.
// GENERATED by a script from the pinned note text (one rule per subparagraph, one effect rule per
// paragraph); the shared relations, the effect enum and the hand-written paragraphs are in
// s3-c-tra1986-1316-1317.law. Do not edit by hand: change the generator and rerun it.
// STATUS: implemented_unverified (static check only; scenarios in tests/s3-d-tra1986-named-lists.lawtest
// are NOT executed).
//
// Each rule reads the external judgment `named_exception_matches_1986` (the description is applied
// to the facts by the administrator or a court), the aggregate face amount limit stated in the
// text (a case fact), the net proceeds share the paragraph requires (95 percent; 90 percent where
// the subparagraph says so) and the issue date limit (section 1317(52), or the later date the
// subparagraph names).

use self::{
    BondIssue,
    IRC_S141_NOTE_6,
    NamedTransitionEffect1986,
    bond_issue_date_1986_transition,
    issue_within_1317_termination,
    named_exception_aggregate_face_1986,
    named_exception_applies_1986,
    named_exception_effect_1986,
    named_exception_matches_1986,
    named_exception_net_proceeds_share_1986,
};

@source(IRC_S141_NOTE_6, relation = formalizes, coverage = partial, quote = "\"(A) A dock or wharf is described in this subparagraph if—")
rule Named1317P1S1(issue: BondIssue, total: Money, share: Decimal) strict {
    label en official "section 1317(1)(A): named facility; aggregate face amount within $2,500,000; 95 percent of the net proceeds; issued by December 31, 1990";
    when named_exception_matches_1986(issue, 1317, 1, 1);
    when named_exception_aggregate_face_1986(1317, 1, 1, total);
    when total <= 2500000.00 USD;
    when named_exception_net_proceeds_share_1986(issue, share);
    when share >= 0.95;
    when issue_within_1317_termination(issue);
    then named_exception_applies_1986(issue, 1317, 1, 1);
}

