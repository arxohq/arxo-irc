    label en official "section 1317(13)(AA): named facility; aggregate face amount within $10,000,000; 95 percent of the net proceeds; issued by December 31, 1990";
    when named_exception_matches_1986(issue, 1317, 13, 27);
    when named_exception_aggregate_face_1986(1317, 13, 27, total);
    when total <= 10000000.00 USD;
    when named_exception_net_proceeds_share_1986(issue, share);
    when share >= 0.95;
    when issue_within_1317_termination(issue);
    then named_exception_applies_1986(issue, 1317, 13, 27);
}

