// Stage 2f (TECH_GAP reduction) — residual sub-provisions of §104(a)(6),
// §125(e),(g),(h), §130(c), §132(f)(8),(g),(k)-(n), §137(f), §139(e),(h),
// §139B(c), §139C(c)-(d), §139D(b)-(d), §139E(b)-(c), §139F(b)-(c),
// §139G(c)-(d), §151(c),(d)(3).
// STATUS: implemented_unverified (static check only; scenarios in
// tests/s2f-b-fringe-and-relief-residuals.lawtest are NOT executed).
//
// TECHNIQUE: where an earlier module takes a definition as one case fact
// (`qualified_volunteer_emergency_responder_139b`, ...), the definition is
// decomposed here into its statutory conditions and a PARALLEL exclusion rule
// reads the derived status; the earlier fact-based rule stays (same head, same
// amount), so no `pub` interface changes.

// =====================================================================
// §104(a)(6): public safety officer survivor compensation
// =====================================================================

use self::{
    FringeBenefitKind,
    IRC_S104_A,
    IRC_S125_B,
    IRC_S125_E,
    IRC_S125_G,
    IRC_S125_H,
    IRC_S130_C,
    IRC_S132_F,
    IRC_S132_G,
    IRC_S132_K,
    IRC_S132_L,
    IRC_S132_M,
    IRC_S132_N,
    IRC_S137_B,
    IRC_S137_F,
    IRC_S139B_A,
    IRC_S139B_C,
    IRC_S139C_C,
    IRC_S139C_D,
    IRC_S139_E,
    IRC_S139_H,
    Individual,
    LiabilityAssignment,
    Person,
    QualifiedTransportationFringeKind,
    TaxableYear,
    cafeteria_plan_discriminates_against_hce_125b1,
    fringe_benefit_provided,
    fringe_benefit_qualifies,
    highly_compensated_individual_132,
    plan_discriminates_in_favor_of_hce_eligibility_or_benefits,
    qualified_assignment_130c,
    qualified_payment_139b_capped,
    transportation_fringe_item,
};

pub enum PublicSafetyOfficerProgram104a6 { Section1201OmnibusCrimeControl; StateSurvivorProgram; }
relation public_safety_survivor_payment_104a6(p: Individual, y: TaxableYear, program: PublicSafetyOfficerProgram104a6, amount: Money) kind empirical {
    label en official "an amount received by the individual (a surviving dependent) pursuant to section 1201 of the Omnibus Crime Control and Safe Streets Act of 1968 or pursuant to a State program of monetary compensation for surviving dependents of a public safety officer (section 104(a)(6)(A)-(B))";
}
relation officer_died_as_direct_and_proximate_result_of_line_of_duty_injury_104a6(p: Individual, y: TaxableYear) kind empirical {
    label en official "the public safety officer died as the direct and proximate result of a personal injury sustained in the line of duty (section 104(a)(6)(B))";
}
relation state_program_amount_payable_had_death_not_been_line_of_duty_104a6(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the part of the State-program payment that would have been payable if the officer's death had occurred other than as the direct and proximate result of a line-of-duty injury (the counterfactual amount is read from the program's terms and asserted by the case, section 104(a)(6) last clause)";
}
pub relation public_safety_survivor_payment_excluded_104a6(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the part of the public safety officer survivor payment excluded from gross income under section 104(a)(6)";
}
@source(IRC_S104_A, relation = formalizes, coverage = partial, quote = "(A) section 1201 of the Omnibus Crime Control and Safe Streets Act of 1968 (42 U.S.C. 3796); [1] or")
rule PublicSafetySurvivorPaymentSection1201Excluded(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 104(a)(6)(A): amounts received pursuant to section 1201 of the Omnibus Crime Control and Safe Streets Act are excluded";
    when public_safety_survivor_payment_104a6(p, y, Section1201OmnibusCrimeControl, amount);
    then public_safety_survivor_payment_excluded_104a6(p, y, amount);
}
@source(IRC_S104_A, relation = formalizes, coverage = partial, quote = "(B) a program established under the laws of any State which provides monetary compensation for surviving dependents of a public safety officer who has died as the direct and proximate result of a personal injury sustained in the line of duty,")
rule PublicSafetySurvivorPaymentStateProgramExcluded(p: Individual, y: TaxableYear, amount: Money, non_duty: Money) strict {
    label en official "section 104(a)(6)(B) and its closing exception: the excluded part is the payment less the amount payable had death been non-line-of-duty (not below zero)";
    when public_safety_survivor_payment_104a6(p, y, StateSurvivorProgram, amount);
    when officer_died_as_direct_and_proximate_result_of_line_of_duty_injury_104a6(p, y);
    when state_program_amount_payable_had_death_not_been_line_of_duty_104a6(p, y, non_duty);
    then public_safety_survivor_payment_excluded_104a6(p, y, max(0.00 USD, round(amount - non_duty, 2, "HALF_UP")));
}

// =====================================================================
// §125(e), (g), (h)
// =====================================================================

relation participant_is_officer_125e1A(p: Individual, plan: us.irc.core::Organ, y: TaxableYear) kind empirical {
    label en official "the participant is an officer (section 125(e)(1)(A))";
}
relation participant_percent_of_voting_power_or_value_125e1B(p: Individual, plan: us.irc.core::Organ, y: TaxableYear, percent: Decimal) kind empirical {
    label en official "the share (percent) of the voting power or value of all classes of stock of the employer owned by the participant (section 125(e)(1)(B))";
}
relation participant_is_highly_compensated_125e1C(p: Individual, plan: us.irc.core::Organ, y: TaxableYear) kind empirical {
    label en official "the participant is highly compensated (section 125(e)(1)(C)); the test is the employer's own compensation ranking and stays a case fact";
}
relation spouse_or_dependent_of_hce_125e1D(p: Individual, plan: us.irc.core::Organ, y: TaxableYear, of: Individual) kind empirical {
    label en official "the participant is a spouse or dependent (within section 152 determined without regard to (b)(1), (b)(2) and (d)(1)(B)) of the individual described in (A), (B) or (C) (section 125(e)(1)(D))";
}
relation highly_compensated_limb_ABC_125e1(p: Individual, plan: us.irc.core::Organ, y: TaxableYear) kind institutional {
    label en official "the participant is described in limb (A), (B) or (C) of section 125(e)(1)";
}
pub relation highly_compensated_participant_derived_125e1(p: Individual, plan: us.irc.core::Organ, y: TaxableYear) kind institutional {
    label en official "the participant is a highly compensated participant derived from the four limbs of section 125(e)(1), and thereby a highly compensated individual (section 125(e)(2))";
}
@source(IRC_S125_E, relation = formalizes, coverage = exact, quote = "(A) an officer,")
rule HighlyCompensatedParticipantOfficer(p: Individual, plan: us.irc.core::Organ, y: TaxableYear) strict {
    label en official "section 125(e)(1)(A)";
    when participant_is_officer_125e1A(p, plan, y);
    then highly_compensated_limb_ABC_125e1(p, plan, y);
}
@source(IRC_S125_E, relation = formalizes, coverage = exact, quote = "(B) a shareholder owning more than 5 percent of the voting power or value of all classes of stock of the employer,")
rule HighlyCompensatedParticipantFivePercentShareholder(p: Individual, plan: us.irc.core::Organ, y: TaxableYear, pct: Decimal) strict {
    label en official "section 125(e)(1)(B): strictly more than 5 percent";
    when participant_percent_of_voting_power_or_value_125e1B(p, plan, y, pct);
    when pct > 0.05;
    then highly_compensated_limb_ABC_125e1(p, plan, y);
}
@source(IRC_S125_E, relation = formalizes, coverage = exact, quote = "(C) highly compensated, or")
rule HighlyCompensatedParticipantHighlyCompensated(p: Individual, plan: us.irc.core::Organ, y: TaxableYear) strict {
    label en official "section 125(e)(1)(C)";
    when participant_is_highly_compensated_125e1C(p, plan, y);
    then highly_compensated_limb_ABC_125e1(p, plan, y);
}
rule HighlyCompensatedParticipantFromLimbs(p: Individual, plan: us.irc.core::Organ, y: TaxableYear) strict {
    label en official "section 125(e)(1), (2): limbs (A)-(C) make a highly compensated participant and individual";
    when highly_compensated_limb_ABC_125e1(p, plan, y);
    then highly_compensated_participant_derived_125e1(p, plan, y);
}
@source(IRC_S125_E, relation = formalizes, coverage = exact, quote = "(D) a spouse or dependent (within the meaning of section 152, determined without regard to subsections (b)(1), (b)(2), and (d)(1)(B) thereof) of an individual described in subparagraph (A), (B), or (C).")
rule HighlyCompensatedParticipantFamilyMember(p: Individual, plan: us.irc.core::Organ, y: TaxableYear, of: Individual) strict {
    label en official "section 125(e)(1)(D): a spouse or dependent of a limb (A)-(C) individual";
    when spouse_or_dependent_of_hce_125e1D(p, plan, y, of);
    when highly_compensated_limb_ABC_125e1(of, plan, y);
    then highly_compensated_participant_derived_125e1(p, plan, y);
}
@source(IRC_S125_B, relation = formalizes, coverage = partial, quote = "In the case of a highly compensated participant, subsection (a) shall not apply to any benefit attributable to a plan year for which the plan discriminates in favor of—")
rule CafeteriaPlanDiscriminatesAgainstDerivedHce(p: Individual, plan: us.irc.core::Organ, y: TaxableYear) strict {
    label en official "section 125(b)(1) read with the derived (e)(1) status";
    when highly_compensated_participant_derived_125e1(p, plan, y);
    when plan_discriminates_in_favor_of_hce_eligibility_or_benefits(plan, y);
    then cafeteria_plan_discriminates_against_hce_125b1(p, plan, y);
}

// (g)(2): contributions for participants in a cafeteria plan providing health benefits
relation plan_health_cost_of_majority_hce_similarly_situated_125g2(plan: us.irc.core::Organ, y: TaxableYear, cost: Money) kind empirical {
    label en official "the cost of the health benefit coverage under the plan of the majority of the highly compensated participants similarly situated (section 125(g)(2)(A)(i))";
}
relation plan_highest_health_cost_similarly_situated_125g2(plan: us.irc.core::Organ, y: TaxableYear, cost: Money) kind empirical {
    label en official "the cost of the health benefit coverage of the participant (similarly situated) having the highest cost health benefit coverage under the plan (section 125(g)(2)(A)(ii))";
}
relation plan_contribution_on_behalf_of_each_participant_125g2A(plan: us.irc.core::Organ, y: TaxableYear, contribution: Money) kind empirical {
    label en official "the amount which the contributions under the plan include on behalf of each participant (section 125(g)(2)(A))";
}
relation plan_excess_contributions_uniform_relationship_to_compensation_125g2B(plan: us.irc.core::Organ, y: TaxableYear) kind empirical {
    label en official "contributions or benefits in excess of those described in (A) bear a uniform relationship to compensation (section 125(g)(2)(B))";
}
pub relation health_benefit_contribution_test_met_125g2(plan: us.irc.core::Organ, y: TaxableYear) kind institutional {
    label en official "the contribution requirement of section 125(g)(2): (A) 100 percent of the cost of the majority HCE coverage or at least 75 percent of the highest cost coverage, and (B) uniform relationship of the excess";
}
@source(IRC_S125_G, relation = formalizes, coverage = partial, quote = "(i) equals 100 percent of the cost of the health benefit coverage under the plan of the majority of the highly compensated participants similarly situated, or")
rule HealthContributionTestByMajorityHceCost(plan: us.irc.core::Organ, y: TaxableYear, c: Money, majority_cost: Money) strict {
    label en official "section 125(g)(2)(A)(i) and (B)";
    when plan_contribution_on_behalf_of_each_participant_125g2A(plan, y, c);
    when plan_health_cost_of_majority_hce_similarly_situated_125g2(plan, y, majority_cost);
    when c >= majority_cost;
    when plan_excess_contributions_uniform_relationship_to_compensation_125g2B(plan, y);
    then health_benefit_contribution_test_met_125g2(plan, y);
}
@source(IRC_S125_G, relation = formalizes, coverage = partial, quote = "(ii) equals or exceeds 75 percent of the cost of the health benefit coverage of the participant (similarly situated) having the highest cost health benefit coverage under the plan, and")
rule HealthContributionTestBySeventyFivePercentOfHighestCost(plan: us.irc.core::Organ, y: TaxableYear, c: Money, highest: Money) strict {
    label en official "section 125(g)(2)(A)(ii): contribution x 100 >= 75 x highest cost, exact";
    when plan_contribution_on_behalf_of_each_participant_125g2A(plan, y, c);
    when plan_highest_health_cost_similarly_situated_125g2(plan, y, highest);
    when c * 4 >= highest * 3;
    when plan_excess_contributions_uniform_relationship_to_compensation_125g2B(plan, y);
    then health_benefit_contribution_test_met_125g2(plan, y);
}
// (g)(3): eligibility test for health benefits
relation plan_benefits_group_described_in_410b2Ai_125g3A(plan: us.irc.core::Organ, y: TaxableYear) kind empirical {
    label en official "the plan benefits a group of employees described in section 410(b)(2)(A)(i) (section 125(g)(3)(A))";
}
relation plan_max_service_requirement_years_125g3Bi(plan: us.irc.core::Organ, y: TaxableYear, years: Integer) kind empirical {
    label en official "the employment requirement, in years, an employee must complete as a condition of participation (section 125(g)(3)(B)(i))";
}
relation plan_employment_requirement_same_for_each_employee_125g3Bi(plan: us.irc.core::Organ, y: TaxableYear) kind empirical {
    label en official "the employment requirement for each employee is the same (section 125(g)(3)(B)(i))";
}
relation plan_participation_starts_by_first_day_of_next_plan_year_125g3Bii(plan: us.irc.core::Organ, y: TaxableYear) kind empirical {
    label en official "every employee who has satisfied the employment requirement and is otherwise entitled to participate commences participation no later than the first day of the first plan year beginning after the requirement was satisfied, unless separated from service before that day (section 125(g)(3)(B)(ii))";
}
pub relation health_benefit_eligibility_test_met_125g3(plan: us.irc.core::Organ, y: TaxableYear) kind institutional {
    label en official "the eligibility requirement of section 125(g)(3): a 410(b)(2)(A)(i) group, a uniform employment requirement of at most 3 years, and timely commencement of participation";
}
@source(IRC_S125_G, relation = formalizes, coverage = partial, quote = "(i) No employee is required to complete more than 3 years of employment with the employer or employers maintaining the plan as a condition of participation in the plan, and the employment requirement for each employee is the same.")
rule HealthBenefitEligibilityTestMet(plan: us.irc.core::Organ, y: TaxableYear, years: Integer) strict {
    label en official "section 125(g)(3)(A)-(B)(i)-(ii)";
    when plan_benefits_group_described_in_410b2Ai_125g3A(plan, y);
    when plan_max_service_requirement_years_125g3Bi(plan, y, years);
    when years <= 3;
    when plan_employment_requirement_same_for_each_employee_125g3Bi(plan, y);
    when plan_participation_starts_by_first_day_of_next_plan_year_125g3Bii(plan, y);
    then health_benefit_eligibility_test_met_125g3(plan, y);
}
// (g)(4): single employer
relation person_treated_as_single_employer_414bcm_125g4(a: Person, b: Person) kind empirical {
    label en official "the two persons are treated as employed by a single employer under section 414(b), (c) or (m) (section 125(g)(4))";
}
pub relation employees_of_single_employer_125g4(a: Person, b: Person) kind institutional {
    label en official "all employees of the two persons are treated as employed by a single employer for purposes of section 125";
}
@source(IRC_S125_G, relation = formalizes, coverage = exact, quote = "All employees who are treated as employed by a single employer under subsection (b), (c), or (m) of section 414 shall be treated as employed by a single employer for purposes of this section.")
rule EmployeesOfSingleEmployer(a: Person, b: Person) strict {
    label en official "section 125(g)(4)";
    when person_treated_as_single_employer_414bcm_125g4(a, b);
    then employees_of_single_employer_125g4(a, b);
}
// (h)(2): qualified reservist distribution from a health flexible spending arrangement
relation reservist_ordered_to_active_duty_over_179_days_125h2A(p: Individual, order_date: Date) kind empirical {
    label en official "the individual was, as a member of a reserve component, ordered or called to active duty for a period in excess of 179 days or for an indefinite period (section 125(h)(2)(A))";
}
relation fsa_distribution_made_on_125h2B(p: Individual, d: Date) kind empirical {
    label en official "the date on which the reservist distribution from the health flexible spending arrangement is made";
}
relation last_date_reimbursements_could_be_made_for_plan_year_125h2B(p: Individual, d: Date) kind empirical {
    label en official "the last date on which reimbursements could otherwise be made under the arrangement for the plan year that includes the date of the order or call";
}
pub relation qualified_reservist_distribution_125h2(p: Individual, d: Date) kind institutional {
    label en official "a qualified reservist distribution from a health flexible spending arrangement: made on or after the order or call and no later than the last reimbursement date of that plan year";
}
@source(IRC_S125_H, relation = formalizes, coverage = partial, quote = "such distribution is made during the period beginning on the date of such order or call and ending on the last date that reimbursements could otherwise be made under such arrangement for the plan year which includes the date of such order or call.")
rule QualifiedReservistDistributionFsa(p: Individual, d: Date, order_date: Date, last_date: Date) strict {
    label en official "section 125(h)(2)(A)-(B): distribution date between the order date and the last reimbursement date, inclusive";
    when reservist_ordered_to_active_duty_over_179_days_125h2A(p, order_date);
    when fsa_distribution_made_on_125h2B(p, d);
    when last_date_reimbursements_could_be_made_for_plan_year_125h2B(p, last_date);
    when d >= order_date;
    when d <= last_date;
    then qualified_reservist_distribution_125h2(p, d);
}

// =====================================================================
// §130(c), last sentence: receipt determined as a general creditor
// =====================================================================

relation recipient_creditor_rights_greater_than_general_creditor_130c(assignment: LiabilityAssignment) kind empirical {
    label en official "the assignment grants the recipient rights as a creditor greater than those of a general creditor (section 130(c), last sentence)";
}
relation assigned_payment_actually_made_on_130c(assignment: LiabilityAssignment, d: Date) kind empirical {
    label en official "the date on which a periodic payment under the assignment is actually made to the recipient";
}
pub relation recipient_treated_as_receiving_assigned_payment_on_130c(assignment: LiabilityAssignment, d: Date) kind institutional {
    label en official "the date on which the recipient is treated as having received a payment under a qualified assignment, determined without regard to any provision granting the recipient rights greater than those of a general creditor";
}
@source(IRC_S130_C, relation = formalizes, coverage = exact, quote = "The determination for purposes of this chapter of when the recipient is treated as having received any payment with respect to which there has been a qualified assignment shall be made without regard to any provision of such assignment which grants the recipient rights as a creditor greater than those of a general creditor.")
rule RecipientTreatedAsReceivingAssignedPayment(assignment: LiabilityAssignment, d: Date) strict {
    label en official "section 130(c), last sentence: the enlarged creditor rights are disregarded, so the receipt date is the date of actual payment (the greater-rights fact is intentionally not read)";
    when qualified_assignment_130c(assignment);
    when assigned_payment_actually_made_on_130c(assignment, d);
    then recipient_treated_as_receiving_assigned_payment_on_130c(assignment, d);
}

// =====================================================================
// §132: qualified moving expense reimbursement (a)(6), retirement planning
// services (a)(7), military base realignment and closure fringe (a)(8),
// (f)(8) bicycle suspension, (k) customers, (l) coordination
// =====================================================================

relation moving_expense_would_be_deductible_under_217_132g1(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "an amount received (directly or indirectly) from an employer as a payment for or reimbursement of expenses which would be deductible as moving expenses under section 217 if directly paid or incurred (section 132(g)(1))";
}
relation moving_expense_deducted_in_prior_year_132g1(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the expense reimbursed was actually deducted by the individual in a prior taxable year (section 132(g)(1), last sentence)";
}
relation armed_forces_member_moving_under_military_order_pcs_132g2(employee: Individual, y: TaxableYear) kind empirical {
    label en official "a member of the Armed Forces of the United States on active duty who moves pursuant to a military order and incident to a permanent change of station (section 132(g)(2))";
}
pub relation qualified_moving_expense_reimbursement_132g1(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "a qualified moving expense reimbursement within the meaning of section 132(g)(1)";
}
@source(IRC_S132_G, relation = formalizes, coverage = exact, quote = "The term \"qualified moving expense reimbursement\" means any amount received (directly or indirectly) by an individual from an employer as a payment for (or a reimbursement of) expenses which would be deductible as moving expenses under section 217 if directly paid or incurred by the individual.")
rule QualifiedMovingExpenseReimbursementDefined(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 132(g)(1): not an expense actually deducted in a prior year";
    when moving_expense_would_be_deductible_under_217_132g1(employer, employee, y, amount);
    when not_known(moving_expense_deducted_in_prior_year_132g1(employer, employee, y, amount));
    then qualified_moving_expense_reimbursement_132g1(employer, employee, y, amount);
}
pub relation moving_reimbursement_exclusion_suspended_132g2(employee: Individual, y: TaxableYear) kind institutional {
    label en official "subsection (a)(6) does not apply for the taxable year: it begins after December 31, 2017 and before January 1, 2026, and the employee is not a member of the Armed Forces moving under a military order (section 132(g)(2))";
}
@source(IRC_S132_G, relation = formalizes, coverage = exact, quote = "Except in the case of a member of the Armed Forces of the United States on active duty who moves pursuant to a military order and incident to a permanent change of station, subsection (a)(6) shall not apply to any taxable year beginning after December 31, 2017, and before January 1, 2026.")
rule MovingReimbursementExclusionSuspended(employee: Individual, y: TaxableYear, b: Date) strict {
    label en official "section 132(g)(2), text of the 2024 edition; from 2026 Pub. L. 119-21 §70113(c) strikes the end date (see pl119-21-carry-2f.law)";
    when moving_expense_would_be_deductible_under_217_132g1(_, employee, y, _);
    when us.irc.core::begins(y, b);
    when b > @2017-12-31;
    when b < @2026-01-01;
    when not_known(armed_forces_member_moving_under_military_order_pcs_132g2(employee, y));
    then moving_reimbursement_exclusion_suspended_132g2(employee, y);
}
@source(IRC_S132_G, relation = formalizes, coverage = partial, quote = "The term \"qualified moving expense reimbursement\" means any amount received (directly or indirectly) by an individual from an employer as a payment for (or a reimbursement of) expenses which would be deductible as moving expenses under section 217 if directly paid or incurred by the individual.")
rule QualifiedMovingExpenseFringeQualifies(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 132(a)(6) with (g): a qualified moving expense reimbursement is a fringe benefit that qualifies unless the (g)(2) suspension applies";
    when fringe_benefit_provided(employer, employee, y, QualifiedMovingExpenseReimbursement, amount);
    when qualified_moving_expense_reimbursement_132g1(employer, employee, y, amount);
    when not_known(moving_reimbursement_exclusion_suspended_132g2(employee, y));
    then fringe_benefit_qualifies(employer, employee, y, QualifiedMovingExpenseReimbursement, amount);
}

relation retirement_planning_advice_by_employer_maintaining_plan_132m1(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "retirement planning advice or information provided to an employee and his spouse by an employer maintaining a qualified employer plan (section 132(m)(1))";
}
relation employer_maintains_plan_described_in_219g5_132m3(employer: us.irc.core::Person) kind empirical {
    label en official "the employer maintains a plan, contract, pension or account described in section 219(g)(5) (section 132(m)(3))";
}
relation service_available_on_substantially_same_terms_to_education_group_132m2(employer: us.irc.core::Person, employee: Individual, y: TaxableYear) kind empirical {
    label en official "the services are available on substantially the same terms to each member of the group of employees normally provided education and information regarding the employer's qualified employer plan (section 132(m)(2))";
}
pub relation qualified_retirement_planning_services_132m1(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "qualified retirement planning services within the meaning of section 132(m)(1); for a highly compensated employee only if the (m)(2) availability condition is met";
}
@source(IRC_S132_M, relation = formalizes, coverage = exact, quote = "For purposes of this section, the term \"qualified retirement planning services\" means any retirement planning advice or information provided to an employee and his spouse by an employer maintaining a qualified employer plan.")
rule QualifiedRetirementPlanningServicesForOrdinaryEmployee(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 132(m)(1), (3) for an employee who is not highly compensated";
    when retirement_planning_advice_by_employer_maintaining_plan_132m1(employer, employee, y, amount);
    when employer_maintains_plan_described_in_219g5_132m3(employer);
    when not_known(highly_compensated_individual_132(employee, y));
    then qualified_retirement_planning_services_132m1(employer, employee, y, amount);
}
@source(IRC_S132_M, relation = formalizes, coverage = exact, quote = "Subsection (a)(7) shall apply in the case of highly compensated employees only if such services are available on substantially the same terms to each member of the group of employees normally provided education and information regarding the employer's qualified employer plan.")
rule QualifiedRetirementPlanningServicesForHighlyCompensatedEmployee(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 132(m)(2)";
    when retirement_planning_advice_by_employer_maintaining_plan_132m1(employer, employee, y, amount);
    when employer_maintains_plan_described_in_219g5_132m3(employer);
    when highly_compensated_individual_132(employee, y);
    when service_available_on_substantially_same_terms_to_education_group_132m2(employer, employee, y);
    then qualified_retirement_planning_services_132m1(employer, employee, y, amount);
}
@source(IRC_S132_M, relation = formalizes, coverage = partial, quote = "For purposes of this section, the term \"qualified retirement planning services\" means any retirement planning advice or information provided to an employee and his spouse by an employer maintaining a qualified employer plan.")
rule RetirementPlanningFringeQualifies(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 132(a)(7)";
    when fringe_benefit_provided(employer, employee, y, QualifiedRetirementPlanningServices, amount);
    when qualified_retirement_planning_services_132m1(employer, employee, y, amount);
    then fringe_benefit_qualifies(employer, employee, y, QualifiedRetirementPlanningServices, amount);
}

relation brac_payment_under_section_1013_demonstration_cities_132n1(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, prop: us.irc.core::Asset, amount: Money) kind empirical {
    label en official "a payment under the authority of section 1013 of the Demonstration Cities and Metropolitan Development Act of 1966 (as in effect on the date of enactment of the American Recovery and Reinvestment Tax Act of 2009) related to the property (section 132(n)(1))";
}
relation brac_maximum_amount_for_property_132n2(prop: us.irc.core::Asset, maximum: Money) kind empirical {
    label en official "the maximum amount described in subsection (c) of section 1013 of the 1966 Act (as in effect on that date) for the property (section 132(n)(2))";
}
relation brac_payments_total_for_property_132n2(prop: us.irc.core::Asset, total: Money) kind empirical {
    label en official "the sum of all payments referred to in paragraph (1) related to the property";
}
pub relation qualified_brac_fringe_amount_132n(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, prop: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the part of a base realignment and closure payment that is a qualified military base realignment and closure fringe: the payment, not counting what exceeds the maximum in the aggregate for the property";
}
@source(IRC_S132_N, relation = formalizes, coverage = exact, quote = "With respect to any property, such term shall not include any payment referred to in paragraph (1) to the extent that the sum of all of such payments related to such property exceeds the maximum amount described in subsection (c) of such section (as in effect on such date).")
rule QualifiedBracFringeWithinMaximum(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, prop: us.irc.core::Asset, amount: Money, total: Money, maximum: Money) strict {
    label en official "section 132(n)(1)-(2): all payments for the property together do not exceed the maximum, so the whole payment qualifies";
    when brac_payment_under_section_1013_demonstration_cities_132n1(employer, employee, y, prop, amount);
    when brac_payments_total_for_property_132n2(prop, total);
    when brac_maximum_amount_for_property_132n2(prop, maximum);
    when total <= maximum;
    then qualified_brac_fringe_amount_132n(employer, employee, y, prop, amount);
}
rule QualifiedBracFringeAboveMaximum(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, prop: us.irc.core::Asset, amount: Money, total: Money, maximum: Money) strict {
    label en official "section 132(n)(2): the payment qualifies only to the extent it is not part of the excess of the sum of all payments over the maximum; nothing qualifies when the payment is not larger than that excess";
    when brac_payment_under_section_1013_demonstration_cities_132n1(employer, employee, y, prop, amount);
    when brac_payments_total_for_property_132n2(prop, total);
    when brac_maximum_amount_for_property_132n2(prop, maximum);
    when total > maximum;
    when amount > total - maximum;
    then qualified_brac_fringe_amount_132n(employer, employee, y, prop, round(amount - (total - maximum), 2, "HALF_UP"));
}
@source(IRC_S132_N, relation = formalizes, coverage = partial, quote = "The term \"qualified military base realignment and closure fringe\" means 1 or more payments under the authority of section 1013 of the Demonstration Cities and Metropolitan Development Act of 1966")
rule BracFringeQualifies(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, prop: us.irc.core::Asset, amount: Money) strict {
    label en official "section 132(a)(8): a fringe benefit whose amount equals the qualifying part of a BRAC payment qualifies";
    when fringe_benefit_provided(employer, employee, y, QualifiedMilitaryBaseRealignmentAndClosureFringe, amount);
    when qualified_brac_fringe_amount_132n(employer, employee, y, prop, amount);
    then fringe_benefit_qualifies(employer, employee, y, QualifiedMilitaryBaseRealignmentAndClosureFringe, amount);
}

// (f)(8): bicycle commuting reimbursement suspended 2018 through 2025
pub relation bicycle_reimbursement_suspended_132f8(y: TaxableYear) kind institutional {
    label en official "paragraph (1)(D) (qualified bicycle commuting reimbursement) does not apply to the taxable year: it begins after December 31, 2017 and before January 1, 2026 (section 132(f)(8))";
}
@source(IRC_S132_F, relation = formalizes, coverage = exact, quote = "Paragraph (1)(D) shall not apply to any taxable year beginning after December 31, 2017, and before January 1, 2026.")
rule BicycleReimbursementSuspended(y: TaxableYear, b: Date) strict {
    label en official "section 132(f)(8)";
    when us.irc.core::begins(y, b);
    when b > @2017-12-31;
    when b < @2026-01-01;
    then bicycle_reimbursement_suspended_132f8(y);
}
pub relation bicycle_reimbursement_struck_from_2026_70112(y: TaxableYear) kind institutional {
    label en official "Pub. L. 119-21 section 70112(a)(1)-(2): subparagraph (D) of section 132(f)(1) is struck, for taxable years beginning after December 31, 2025";
}
@source(us.irc.temporal::PL119_21_S70112, relation = formalizes, coverage = exact, quote = "(a) In General.—Section 132(f) is amended—(1) by striking subparagraph (D) of paragraph (1),")
rule BicycleReimbursementStruckFrom2026(y: TaxableYear, b: Date) strict {
    label en official "Pub. L. 119-21 section 70112(a), (d): applies to taxable years beginning after December 31, 2025";
    when us.irc.core::begins(y, b);
    when b > @2025-12-31;
    then bicycle_reimbursement_struck_from_2026_70112(y);
}
relation qualified_bicycle_commuting_months_132f2C(employee: Individual, y: TaxableYear, months: Integer) kind empirical {
    label en official "the number of calendar months during the year in which the employee regularly used a bicycle for a substantial portion of the travel between residence and place of employment (section 132(f)(5)(F))";
}
@source(IRC_S132_F, relation = formalizes, coverage = partial, quote = "The amount of the fringe benefits which are provided by an employer to any employee and which may be excluded from gross income under subsection (a)(5) shall not exceed—")
rule BicycleCommutingReimbursementQualifiesWhenNotSuspended(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, amount: Money, months: Integer) strict {
    label en official "section 132(f)(1)(D), (2)(C): a bicycle commuting reimbursement within $20 per qualified month qualifies in a year the (f)(8) suspension does not reach (the amount $20 is the statutory figure of subparagraph (C); inflation adjustment under (f)(6) is not pinned)";
    when fringe_benefit_provided(employer, employee, y, QualifiedTransportationFringe, amount);
    when transportation_fringe_item(employer, employee, y, QualifiedBicycleCommutingReimbursement, amount);
    when qualified_bicycle_commuting_months_132f2C(employee, y, months);
    when amount <= round(20.00 USD * months, 2, "HALF_UP");
    when not_known(bicycle_reimbursement_suspended_132f8(y));
    when not_known(bicycle_reimbursement_struck_from_2026_70112(y));
    then fringe_benefit_qualifies(employer, employee, y, QualifiedTransportationFringe, amount);
}

// (k): customers are not employees
relation person_is_customer_of_employer_132k(employer: us.irc.core::Person, person: Person) kind empirical {
    label en official "the person is a customer of the employer";
}
relation person_is_employee_of_employer_132k(employer: us.irc.core::Person, person: Person) kind empirical {
    label en official "the person is an employee of the employer";
}
pub relation customer_for_purposes_of_132_132k(employer: us.irc.core::Person, person: Person) kind institutional {
    label en official "for purposes of section 132 (other than subsection (c)(2)) the term customers includes only customers who are not employees";
}
@source(IRC_S132_K, relation = formalizes, coverage = exact, quote = "the term \"customers\" shall only include customers who are not employees.")
rule CustomerExcludesEmployees(employer: us.irc.core::Person, person: Person) strict {
    label en official "section 132(k)";
    when person_is_customer_of_employer_132k(employer, person);
    when not_known(person_is_employee_of_employer_132k(employer, person));
    then customer_for_purposes_of_132_132k(employer, person);
}
// (l): fringe benefits taxed under another section
relation fringe_benefit_type_expressly_treated_by_other_section_132l(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, kind: FringeBenefitKind) kind empirical {
    label en official "the tax treatment of this type of fringe benefit is expressly provided for in another section of this chapter (section 132(l))";
}
pub relation section_132_inapplicable_to_fringe_132l(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, kind: FringeBenefitKind) kind institutional {
    label en official "section 132 (other than subsections (e) and (g)) does not apply to this fringe benefit";
}
@source(IRC_S132_L, relation = formalizes, coverage = exact, quote = "This section (other than subsections (e) and (g)) shall not apply to any fringe benefits of a type the tax treatment of which is expressly provided for in any other section of this chapter.")
rule Section132InapplicableToFringeOfOtherSection(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, kind: FringeBenefitKind) strict {
    label en official "section 132(l): the exceptions of (e) (de minimis) and (g) (moving) are handled by their own kinds — a de minimis or moving item is never marked by the case here";
    when fringe_benefit_type_expressly_treated_by_other_section_132l(employer, employee, y, kind);
    then section_132_inapplicable_to_fringe_132l(employer, employee, y, kind);
}

// =====================================================================
// §137(f): cost-of-living adjustment
// =====================================================================

relation cost_of_living_factor_137f(y: TaxableYear, factor: Decimal) kind empirical {
    label en official "the section 1(f)(3) cost-of-living adjustment for the calendar year in which the taxable year begins, determined by substituting calendar year 2001 for calendar year 2016 in subparagraph (A)(ii) (the factor is published by the Secretary and not pinned in this corpus, so it is an input and never invented)";
}
pub enum AdoptionDollarAmount137 { AmountA2; CapB1; PhaseoutThresholdB2A; }
relation adoption_statutory_base_amount_137(kind: AdoptionDollarAmount137, amount: Money) kind institutional {
    label en official "the statutory dollar amounts of section 137 before adjustment: the (a)(2) amount, the (b)(1) cap and the (b)(2)(A) phase-out threshold";
}
@source(IRC_S137_B, relation = formalizes, coverage = partial, quote = "The aggregate of the amounts paid or expenses incurred which may be taken into account under subsection (a) for all taxable years with respect to the adoption of a child by the taxpayer shall not exceed $10,000.")
rule AdoptionBaseCap() strict {
    label en official "section 137(b)(1): $10,000";
    then adoption_statutory_base_amount_137(CapB1, 10000.00 USD);
}
@source(IRC_S137_B, relation = formalizes, coverage = partial, quote = "The amount excludable from gross income under subsection (a) for any taxable year shall be reduced (but not below zero) by an amount which bears the same ratio to the amount so excludable")
rule AdoptionBasePhaseoutThreshold() strict {
    label en official "section 137(b)(2)(A)(i): $150,000 (2002 statutory base)";
    then adoption_statutory_base_amount_137(PhaseoutThresholdB2A, 150000.00 USD);
}
pub relation adoption_dollar_amount_indexed_137f(y: TaxableYear, kind: AdoptionDollarAmount137, amount: Money) kind institutional {
    label en official "the section 137 dollar amount for a taxable year beginning after December 31, 2002: the base amount increased by base x cost-of-living adjustment, rounded to the nearest multiple of $10 (halves rounded up: a judgment call, the text names no tie-break)";
}
@source(IRC_S137_F, relation = formalizes, coverage = exact, quote = "In the case of a taxable year beginning after December 31, 2002, each of the dollar amounts in subsection (a)(2) and paragraphs (1) and (2)(A) of subsection (b) shall be increased by an amount equal to—")
rule AdoptionDollarAmountIndexed(y: TaxableYear, kind: AdoptionDollarAmount137, base: Money, factor: Decimal, b: Date) strict {
    label en official "section 137(f): base + base x factor, to the nearest multiple of $10";
    when us.irc.core::begins(y, b);
    when b > @2002-12-31;
    when adoption_statutory_base_amount_137(kind, base);
    when cost_of_living_factor_137f(y, factor);
    then adoption_dollar_amount_indexed_137f(y, kind, round((base + base * factor) / 10.00 USD, 0, "HALF_UP") * 10.00 USD);
}

// =====================================================================
// §139(e), (h)
// =====================================================================

relation individual_identified_by_attorney_general_as_terroristic_participant_139e(p: Individual) kind empirical {
    label en official "the individual is identified by the Attorney General as a participant or conspirator in a terroristic action, or is a representative of such an individual (section 139(e))";
}
pub relation section_139_exclusion_denied_139e(p: Individual) kind institutional {
    label en official "subsections (a), (f) and (g) of section 139 do not apply with respect to the individual";
}
@source(IRC_S139_E, relation = formalizes, coverage = exact, quote = "Subsections (a), (f), and (g) shall not apply with respect to any individual identified by the Attorney General to have been a participant or conspirator in a terroristic action (as so defined), or a representative of such individual.")
rule Section139ExclusionDeniedToTerroristParticipant(p: Individual) strict {
    label en official "section 139(e)";
    when individual_identified_by_attorney_general_as_terroristic_participant_139e(p);
    then section_139_exclusion_denied_139e(p);
}
relation expenditure_amount_excluded_under_139_139h(p: Person, y: TaxableYear, expenditure: us.irc.core::Transaction, excluded: Money, total: Money) kind empirical {
    label en official "an expenditure for which a qualified disaster relief payment or qualified disaster mitigation payment was made, with the amount excluded under section 139 and the total amount of the expenditure";
}
pub relation deduction_or_credit_disallowed_139h(p: Person, y: TaxableYear, expenditure: us.irc.core::Transaction, disallowed: Money) kind institutional {
    label en official "no deduction or credit is allowed for or by reason of the expenditure to the extent of the amount excluded under section 139";
}
@source(IRC_S139_H, relation = formalizes, coverage = exact, quote = "no deduction or credit shall be allowed (to the person for whose benefit a qualified disaster relief payment or qualified disaster mitigation payment is made) for, or by reason of, any expenditure to the extent of the amount excluded under this section with respect to such expenditure.")
rule DeductionOrCreditDisallowedToExtentExcluded(p: Person, y: TaxableYear, e: us.irc.core::Transaction, excluded: Money, total: Money) strict {
    label en official "section 139(h): the disallowed part is the excluded amount, not more than the expenditure";
    when expenditure_amount_excluded_under_139_139h(p, y, e, excluded, total);
    then deduction_or_credit_disallowed_139h(p, y, e, min(excluded, total));
}

// =====================================================================
// §139B(c): volunteer emergency responders — definitions
// =====================================================================

pub entity VolunteerOrganization139B {
    label en unofficial "a volunteer organization providing firefighting or emergency medical services (case-asserted)";
}
relation volunteer_org_organized_to_provide_firefighting_or_ems_139bc3A(org: VolunteerOrganization139B, jurisdiction: us.irc.core::Organ) kind empirical {
    label en official "the volunteer organization is organized and operated to provide firefighting or emergency medical services for persons in the State or political subdivision (section 139B(c)(3)(A))";
}
relation volunteer_org_required_by_written_agreement_139bc3B(org: VolunteerOrganization139B, jurisdiction: us.irc.core::Organ) kind empirical {
    label en official "the organization is required by written agreement with the State or political subdivision to furnish firefighting or emergency medical services there (section 139B(c)(3)(B))";
}
relation member_of_volunteer_org_139b(p: Individual, org: VolunteerOrganization139B) kind empirical {
    label en official "the individual is a member of the volunteer organization";
}
pub relation qualified_volunteer_emergency_response_organization_139bc3(org: VolunteerOrganization139B, jurisdiction: us.irc.core::Organ) kind institutional {
    label en official "a qualified volunteer emergency response organization";
}
@source(IRC_S139B_C, relation = formalizes, coverage = exact, quote = "The term \"qualified volunteer emergency response organization\" means any volunteer organization—")
rule QualifiedVolunteerEmergencyResponseOrganization(org: VolunteerOrganization139B, j: us.irc.core::Organ) strict {
    label en official "section 139B(c)(3)(A)-(B)";
    when volunteer_org_organized_to_provide_firefighting_or_ems_139bc3A(org, j);
    when volunteer_org_required_by_written_agreement_139bc3B(org, j);
    then qualified_volunteer_emergency_response_organization_139bc3(org, j);
}
pub relation volunteer_emergency_responder_derived_139b(p: Individual) kind institutional {
    label en official "the individual is a member of a qualified volunteer emergency response organization (derived from section 139B(c)(3))";
}
@source(IRC_S139B_A, relation = formalizes, coverage = partial, quote = "In the case of any member of a qualified volunteer emergency response organization, gross income shall not include—")
rule VolunteerEmergencyResponderDerived(p: Individual, org: VolunteerOrganization139B, j: us.irc.core::Organ) strict {
    label en official "section 139B(a) lead-in with (c)(3)";
    when member_of_volunteer_org_139b(p, org);
    when qualified_volunteer_emergency_response_organization_139bc3(org, j);
    then volunteer_emergency_responder_derived_139b(p);
}
pub enum Section164aTaxKind139B { RealPropertyTax; PersonalPropertyTax; IncomeOrProfitsTax; OtherTax; }
relation tax_reduction_on_account_of_volunteer_services_139bc1(p: Individual, y: TaxableYear, kind: Section164aTaxKind139B, amount: Money) kind empirical {
    label en official "a reduction or rebate of a tax provided by a State or political subdivision on account of services performed as a member of a qualified volunteer emergency response organization";
}
pub relation qualified_state_local_tax_benefit_derived_139bc1(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "a qualified State and local tax benefit: the reduction or rebate is of a tax described in section 164(a)(1), (2) or (3)";
}
@source(IRC_S139B_C, relation = formalizes, coverage = exact, quote = "The term \"qualified state and local tax benefit\" means any reduction or rebate of a tax described in paragraph (1), (2), or (3) of section 164(a) provided by a State or political division thereof on account of services performed as a member of a qualified volunteer emergency response organization.")
rule QualifiedStateLocalTaxBenefitReal(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 139B(c)(1): real property tax, section 164(a)(1)";
    when tax_reduction_on_account_of_volunteer_services_139bc1(p, y, RealPropertyTax, amount);
    then qualified_state_local_tax_benefit_derived_139bc1(p, y, amount);
}
rule QualifiedStateLocalTaxBenefitPersonal(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 139B(c)(1): personal property tax, section 164(a)(2)";
    when tax_reduction_on_account_of_volunteer_services_139bc1(p, y, PersonalPropertyTax, amount);
    then qualified_state_local_tax_benefit_derived_139bc1(p, y, amount);
}
rule QualifiedStateLocalTaxBenefitIncome(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 139B(c)(1): income, war profits and excess profits tax, section 164(a)(3)";
    when tax_reduction_on_account_of_volunteer_services_139bc1(p, y, IncomeOrProfitsTax, amount);
    then qualified_state_local_tax_benefit_derived_139bc1(p, y, amount);
}
pub relation volunteer_emergency_responder_excluded_derived_139b(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 139B(a) exclusion computed from the derived member status, the derived tax benefit and the capped payment";
}
@source(IRC_S139B_A, relation = formalizes, coverage = exact, quote = "(1) any qualified State and local tax benefit, and")
rule VolunteerEmergencyResponderExcludedDerived(p: Individual, y: TaxableYear, tax_benefit: Money, payment: Money) strict {
    label en official "section 139B(a)(1)-(2) with (c)";
    when volunteer_emergency_responder_derived_139b(p);
    when qualified_state_local_tax_benefit_derived_139bc1(p, y, tax_benefit);
    when qualified_payment_139b_capped(p, y, _, payment);
    then volunteer_emergency_responder_excluded_derived_139b(p, y, round(tax_benefit + payment, 2, "HALF_UP"));
}

// =====================================================================
// §139C(c), (d): first responder retirement payments — definitions
// =====================================================================

relation disability_payment_excluded_104a1_first_responder_139c2(p: Individual, payment_id: Integer, amount: Money) kind empirical {
    label en official "a periodic payment received by the individual which is not includible in gross income under section 104(a)(1) (section 139C(c)(2)(A))";
}
relation disability_payment_terminates_at_retirement_age_139c2C(p: Individual, payment_id: Integer) kind empirical {
    label en official "the payment terminates when the individual attains retirement age (section 139C(c)(2)(C))";
}
relation disability_payment_received_in_connection_with_first_responder_service_139c2B(p: Individual, payment_id: Integer) kind empirical {
    label en official "the payment is received in connection with the individual's qualified first responder service (section 139C(c)(2)(B))";
}
relation disability_payment_attributable_to_12_months_before_retirement_age_139c1(p: Individual, payment_id: Integer) kind empirical {
    label en official "the payment is properly attributable to the 12-month period immediately preceding the date on which the individual attains retirement age (section 139C(c)(1))";
}
relation days_of_period_to_which_disability_amounts_attributable_139c3(p: Individual, days: Integer) kind empirical {
    label en official "the number of days in the 12-month period to which the individual's service-connected excludable disability amounts were properly attributable, for an individual who only receives such amounts for a portion of the period (section 139C(c)(3))";
}
pub relation annualized_excludable_disability_amount_derived_139c1(p: Individual, amount: Money) kind institutional {
    label en official "the annualized excludable disability amount: the service-connected excludable disability amounts attributable to the 12 months before retirement age, scaled by 365 over the days of the portion when the individual received them for a portion only (section 139C(c)(1), (3))";
}
@source(IRC_S139C_C, relation = formalizes, coverage = exact, quote = "The term \"service-connected excludable disability amount\" means periodic payments received by an individual which—")
rule AnnualizedExcludableDisabilityAmountFullPeriod(p: Individual, pid: Integer) strict {
    label en official "section 139C(c)(1)-(2): the sum of the qualifying payments of the 12-month period; no portion proration applies";
    when disability_payment_excluded_104a1_first_responder_139c2(p, pid, _);
    when not_known(has_disability_portion_proration_139c3(p));
    then annualized_excludable_disability_amount_derived_139c1(p, sum(collect all a: Money, q: Integer where disability_payment_excluded_104a1_first_responder_139c2(p, q, a) and disability_payment_received_in_connection_with_first_responder_service_139c2B(p, q) and disability_payment_terminates_at_retirement_age_139c2C(p, q) and disability_payment_attributable_to_12_months_before_retirement_age_139c1(p, q), empty: 0.00 USD));
}
relation has_disability_portion_proration_139c3(p: Individual) kind institutional {
    label en official "helper: the individual received the amounts for a portion of the 12-month period only";
}
rule HasDisabilityPortionProration(p: Individual, days: Integer) strict {
    label en official "helper for the not_known test of the full-period rule";
    when days_of_period_to_which_disability_amounts_attributable_139c3(p, days);
    then has_disability_portion_proration_139c3(p);
}
@source(IRC_S139C_C, relation = formalizes, coverage = exact, quote = "In the case of an individual who only receives service-connected excludable disability amounts properly attributable to a portion of the 12-month period described in paragraph (1), such paragraph shall be applied by multiplying such amounts by the ratio of 365 to the number of days in such period to which such amounts were properly attributable.")
rule AnnualizedExcludableDisabilityAmountPortionOfPeriod(p: Individual, days: Integer) strict {
    label en official "section 139C(c)(3): the sum times 365 over the number of days, one rounding of the exact quotient (HALF_UP, a judgment call: the text names no rounding)";
    when days_of_period_to_which_disability_amounts_attributable_139c3(p, days);
    when days > 0;
    then annualized_excludable_disability_amount_derived_139c1(p, div_round(sum(collect all a: Money, q: Integer where disability_payment_excluded_104a1_first_responder_139c2(p, q, a) and disability_payment_received_in_connection_with_first_responder_service_139c2B(p, q) and disability_payment_terminates_at_retirement_age_139c2C(p, q) and disability_payment_attributable_to_12_months_before_retirement_age_139c1(p, q), empty: 0.00 USD) * 365, days * 1.00, 2, "HALF_UP"));
}
relation first_responder_service_kind_139cd(p: Individual, service: FirstResponderService139C) kind empirical {
    label en official "the individual served as a law enforcement officer, firefighter, paramedic or emergency medical technician (section 139C(d))";
}
pub enum FirstResponderService139C { LawEnforcementOfficer; Firefighter; Paramedic; EmergencyMedicalTechnician; OtherService; }
pub relation qualified_first_responder_service_139cd(p: Individual) kind institutional {
    label en official "qualified first responder service (section 139C(d))";
}
@source(IRC_S139C_D, relation = formalizes, coverage = exact, quote = "the term \"qualified first responder service\" means service as a law enforcement officer, firefighter, paramedic, or emergency medical technician.")
rule QualifiedFirstResponderServiceLaw(p: Individual) strict {
    label en official "section 139C(d): law enforcement officer";
    when first_responder_service_kind_139cd(p, LawEnforcementOfficer);
    then qualified_first_responder_service_139cd(p);
}
rule QualifiedFirstResponderServiceFire(p: Individual) strict {
    label en official "section 139C(d): firefighter";
    when first_responder_service_kind_139cd(p, Firefighter);
    then qualified_first_responder_service_139cd(p);
}
rule QualifiedFirstResponderServiceParamedic(p: Individual) strict {
    label en official "section 139C(d): paramedic";
    when first_responder_service_kind_139cd(p, Paramedic);
    then qualified_first_responder_service_139cd(p);
}
rule QualifiedFirstResponderServiceEmt(p: Individual) strict {
    label en official "section 139C(d): emergency medical technician";
    when first_responder_service_kind_139cd(p, EmergencyMedicalTechnician);
    then qualified_first_responder_service_139cd(p);
}
