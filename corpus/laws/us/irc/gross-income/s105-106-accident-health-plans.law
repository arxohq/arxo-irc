// Sections 105-106 — Amounts received under accident and health plans;
// contributions by employer to accident and health plans. Stage 2b (IRC-06).

// ============================================================================
// Section 105
// ============================================================================

// --- §105(a): general inclusion rule -----------------------------------------

use self::{
    IRC_S105_A,
    IRC_S105_B,
    IRC_S105_C,
    IRC_S105_E,
    IRC_S105_G,
    IRC_S105_H,
    IRC_S105_I,
    IRC_S106_A,
    IRC_S106_B,
    IRC_S106_D,
    Individual,
    TaxableYear,
};

pub relation received_through_accident_or_health_insurance(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "amounts received by an employee through accident or health insurance for personal injuries or sickness (section 105(a))";
}
relation attributable_to_employer_contributions_not_included(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount is attributable to employer contributions which were not includible in the employee's gross income (section 105(a)(1))";
}
relation paid_by_employer(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount is paid by the employer (section 105(a)(2))";
}
pub relation section_105a_amount_included_in_gross_income(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "amounts received through accident or health insurance are included in gross income to the extent attributable to un-included employer contributions or paid by the employer, except as otherwise excluded by this section (section 105(a))";
}

@source(IRC_S105_A, quote = "amounts received by an employee through accident or health insurance for personal injuries or sickness shall be included in gross income to the extent such amounts (1) are attributable to contributions by the employer which were not includible in the gross income of the employee, or (2) are paid by the employer")
rule Section105aInclusionViaContribution(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "amount attributable to non-includible employer contributions is included";
    when received_through_accident_or_health_insurance(p, y, amount);
    when attributable_to_employer_contributions_not_included(p, y, amount);
    when not_known(not_an_employee_for_section_105(p)); // G6404 wiring: §105(g) — a §401(c)(1) self-employed individual is not an "employee" of §105(a)
    when not_known(reimbursement_excluded_105b(p, y, amount));
    when not_known(payment_excluded_105c(p, y, amount));
    then section_105a_amount_included_in_gross_income(p, y, amount);
}
@source(IRC_S105_A, quote = "are paid by the employer")
rule Section105aInclusionViaEmployerPayment(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "amount paid directly by the employer is included";
    when received_through_accident_or_health_insurance(p, y, amount);
    when paid_by_employer(p, y, amount);
    when not_known(not_an_employee_for_section_105(p)); // G6404 wiring: §105(g)
    when not_known(reimbursement_excluded_105b(p, y, amount));
    when not_known(payment_excluded_105c(p, y, amount));
    then section_105a_amount_included_in_gross_income(p, y, amount);
}

// --- §105(b): amounts expended for medical care ------------------------------

relation reimbursement_for_medical_care_of_taxpayer_spouse_or_dependent(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "amounts paid, directly or indirectly, to the taxpayer to reimburse the taxpayer for expenses incurred for the medical care (section 213(d)) of the taxpayer, spouse, a dependent (section 152, determined without regard to (b)(1),(b)(2),(d)(1)(B)), or a child under 27 (section 152(f)(1)) (section 105(b))";
}
relation attributable_to_prior_year_213_deduction(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount is attributable to (and not in excess of) a section 213 deduction allowed for a prior taxable year — excluded from the (b) exclusion (section 105(b), opening exception)";
}
pub relation reimbursement_excluded_105b(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "gross income does not include this medical-care reimbursement (section 105(b))";
}

@source(IRC_S105_B, quote = "gross income does not include amounts referred to in subsection (a) if such amounts are paid, directly or indirectly, to the taxpayer to reimburse the taxpayer for expenses incurred by him for the medical care")
rule MedicalReimbursementExcluded(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "medical-care reimbursement of the taxpayer, spouse, dependents, or an under-27 child is excluded, unless it is attributable to a prior-year section 213 deduction or the section 105(h) discriminatory-plan limitation strips the exclusion";
    when reimbursement_for_medical_care_of_taxpayer_spouse_or_dependent(p, y, amount);
    when not attributable_to_prior_year_213_deduction(p, y, amount);
    when not_known(excess_reimbursement_of_hce_105h(p, y, amount));
    then reimbursement_excluded_105b(p, y, amount);
}
// Second sentence: "Any child to whom section 152(e) applies shall be
// treated as a dependent of both parents for purposes of this subsection" —
// folded into `reimbursement_for_medical_care_of_taxpayer_spouse_or_
// dependent`'s own scope (a case asserting reimbursement for such a child
// with respect to EITHER parent is within the fact's label), consistent
// with this package's glossary-folding convention; no separate rule head.

// --- §105(c): payments unrelated to absence from work ------------------------

relation payment_for_permanent_loss_or_disfigurement(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "payment for the permanent loss or loss of use of a member or function of the body, or permanent disfigurement, of the taxpayer, spouse, or dependent (section 105(c)(1))";
}
relation computed_without_regard_to_absence_period(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the payment is computed with reference to the nature of the injury without regard to the period of absence from work (section 105(c)(2))";
}
pub relation payment_excluded_105c(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "gross income does not include this payment for permanent loss/disfigurement (section 105(c))";
}

@source(IRC_S105_C, quote = "Gross income does not include amounts referred to in subsection (a) to the extent such amounts—")
rule PermanentLossPaymentExcluded(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "a payment for permanent loss/disfigurement computed without regard to absence period is excluded";
    when payment_for_permanent_loss_or_disfigurement(p, y, amount);
    when computed_without_regard_to_absence_period(p, y, amount);
    then payment_excluded_105c(p, y, amount);
}

// --- §105(d): repealed ---------------------------------------------------------
// Pub. L. 98-21, title I, section 122(b), Apr. 20, 1983 — repealed_or_reserved,
// the pinned text itself states the repeal.

// --- §105(e): treated as accident/health insurance ---------------------------

relation received_under_employee_accident_or_health_plan(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "amounts received under an accident or health plan for employees (section 105(e)(1))";
}
relation received_from_state_sickness_disability_fund(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "amounts received from a State or D.C. sickness and disability fund for employees (section 105(e)(2))";
}
@source(IRC_S105_E, quote = "amounts received under an accident or health plan for employees")
rule Section105ePlanAmountsTreatedAsInsurance(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "employee accident/health plan amounts are treated as received through accident or health insurance for purposes of sections 104-105";
    when received_under_employee_accident_or_health_plan(p, y, amount);
    then received_through_accident_or_health_insurance(p, y, amount);
}
@source(IRC_S105_E, quote = "amounts received from a sickness and disability fund for employees maintained under the law of a State or the District of Columbia")
rule Section105eFundAmountsTreatedAsInsurance(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "State/D.C. sickness-and-disability-fund amounts are treated as received through accident or health insurance for purposes of sections 104-105";
    when received_from_state_sickness_disability_fund(p, y, amount);
    then received_through_accident_or_health_insurance(p, y, amount);
}

// --- §105(f): coordination with section 213 ------------------------------------
// "amounts excluded from gross income under subsection (c) shall not be
// considered as compensation ... for expenses paid for medical care" — a
// pure ordering/coordination rule for a DIFFERENT section's (213) own
// computation, which this package does not implement; NON_NORMATIVE here
// (no independent content this package's own rules add or need).

// --- §105(g): self-employed individual excluded from "employee" --------------

relation self_employed_within_401c1(p: Individual) kind empirical {
    label en official "an employee within the meaning of section 401(c)(1) (relating to self-employed individuals) (section 105(g))";
}
pub relation not_an_employee_for_section_105(p: Individual) kind institutional {
    label en official "not treated as an 'employee' for purposes of section 105 (section 105(g))";
}
@source(IRC_S105_G, quote = "the term \"employee\" does not include an individual who is an employee within the meaning of section 401(c)(1)")
rule SelfEmployedExcludedFromSection105Employee(p: Individual) strict {
    label en official "a self-employed individual (section 401(c)(1)) is not an 'employee' for section 105 purposes";
    when self_employed_within_401c1(p);
    then not_an_employee_for_section_105(p);
}

// --- §105(h): discriminatory self-insured medical reimbursement plan ---------

relation self_insured_medical_reimbursement_plan(plan: us.irc.core::Organ, y: TaxableYear) kind empirical {
    label en official "a plan of an employer to reimburse employees for section 105(b) expenses, not provided under a policy of accident and health insurance (section 105(h)(6))";
}
relation highly_compensated_individual(p: Individual, y: TaxableYear) kind empirical {
    label en official "one of the 5 highest paid officers, a >10%-value shareholder (section 318 attribution), or among the highest-paid 25 percent of all employees (section 105(h)(5)) — EXTERNAL_DEPENDENCY: the section 318 attribution and payroll-ranking computation are asserted directly as a case fact, not derived from `us.irc.corporations::constructive_ownership` or a payroll census this package does not model";
}
relation plan_discriminates_in_eligibility(plan: us.irc.core::Organ, y: TaxableYear) kind empirical {
    label en official "the plan fails the section 105(h)(3) nondiscriminatory-eligibility-classification test (70%/80% or nondiscriminatory-classification safe harbor, after the (h)(3)(B) permitted exclusions) (section 105(h)(2)(A))";
}
relation plan_discriminates_in_benefits(plan: us.irc.core::Organ, y: TaxableYear) kind empirical {
    label en official "the benefits provided under the plan discriminate in favor of highly compensated participants (not all benefits for HCE participants are also provided for all other participants) (section 105(h)(2)(B), (h)(4))";
}
pub relation self_insured_plan_satisfies_nondiscrimination_105h(plan: us.irc.core::Organ, y: TaxableYear) kind institutional {
    label en official "the self-insured medical reimbursement plan satisfies section 105(h)(2)'s nondiscrimination requirement for the plan year";
}
@source(IRC_S105_H, quote = "the plan does not discriminate in favor of highly compensated individuals as to eligibility to participate; and")
rule PlanSatisfiesNondiscrimination(plan: us.irc.core::Organ, y: TaxableYear) strict {
    label en official "a plan that discriminates in neither eligibility nor benefits satisfies (h)(2)";
    when self_insured_medical_reimbursement_plan(plan, y);
    when not_known(plan_discriminates_in_eligibility(plan, y));
    when not_known(plan_discriminates_in_benefits(plan, y));
    then self_insured_plan_satisfies_nondiscrimination_105h(plan, y);
}

// (h)(7): excess reimbursement of a highly compensated individual.
relation benefit_available_to_hce_not_all_participants(plan: us.irc.core::Organ, p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "a benefit available to highly compensated individuals but not to all other participants (or otherwise failing the (2)(B) benefits test); `amount` is the amount reimbursed to this employee for that benefit (section 105(h)(7)(A))";
}
pub relation excess_reimbursement_of_hce_105h(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the excess reimbursement of a highly compensated individual attributable to a discriminatory self-insured medical reimbursement plan (section 105(h)(7)) — section 105(b) does not apply to this amount";
}
@source(IRC_S105_H, quote = "in the case of a benefit available to highly compensated individuals but not to all other participants (or which otherwise fails to satisfy the requirements of paragraph (2)(B)), the amount reimbursed under the plan to the employee with respect to such benefit")
rule ExcessReimbursementViaUnavailableBenefit(plan: us.irc.core::Organ, p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "the (7)(A) excess-reimbursement branch: the whole reimbursed amount for a benefit not available to all participants";
    when self_insured_medical_reimbursement_plan(plan, y);
    when highly_compensated_individual(p, y);
    when not_known(self_insured_plan_satisfies_nondiscrimination_105h(plan, y));
    when benefit_available_to_hce_not_all_participants(plan, p, y, amount);
    then excess_reimbursement_of_hce_105h(p, y, amount);
}

relation total_reimbursed_to_hce_for_plan_year(plan: us.irc.core::Organ, p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the total amount reimbursed to this highly compensated individual for the plan year, other than (7)(A)-type benefits (section 105(h)(7)(B))";
}
relation total_reimbursed_to_all_hce_for_plan_year(plan: us.irc.core::Organ, y: TaxableYear, amount: Money) kind empirical {
    label en official "the total amount reimbursed to all participants who are highly compensated individuals under the plan for the plan year, other than (7)(A)-type benefits (section 105(h)(7)(B)(i))";
}
relation total_reimbursed_to_all_employees_for_plan_year(plan: us.irc.core::Organ, y: TaxableYear, amount: Money) kind empirical {
    label en official "the total amount reimbursed to all employees under the plan for the plan year, other than (7)(A)-type benefits (section 105(h)(7)(B)(ii))";
}
@source(IRC_S105_H, quote = "the total amount reimbursed to the highly compensated individual for the plan year multiplied by a fraction")
rule ExcessReimbursementViaDiscriminatoryFraction(plan: us.irc.core::Organ, p: Individual, y: TaxableYear, total_hce: Money, total_all_hce: Money, total_all_employees: Money) strict {
    label en official "the (7)(B) excess-reimbursement fraction: total reimbursed to this HCE times (total reimbursed to all HCEs / total reimbursed to all employees), for benefits other than the (7)(A) unavailable-benefit kind";
    when self_insured_medical_reimbursement_plan(plan, y);
    when highly_compensated_individual(p, y);
    when not_known(self_insured_plan_satisfies_nondiscrimination_105h(plan, y));
    when total_reimbursed_to_hce_for_plan_year(plan, p, y, total_hce);
    when total_reimbursed_to_all_hce_for_plan_year(plan, y, total_all_hce);
    when total_reimbursed_to_all_employees_for_plan_year(plan, y, total_all_employees);
    then excess_reimbursement_of_hce_105h(p, y, total_hce * (total_all_hce / total_all_employees));
}

// (h)(1): "subsection (b) shall not apply to such amounts to the extent
// they constitute an excess reimbursement" — implemented above as
// `MedicalReimbursementExcluded`'s `not_known(excess_reimbursement_of_hce_
// 105h(...))` guard, rather than a second rule on the same
// `reimbursement_excluded_105b` head (same-predicate-cycle avoidance
// convention used throughout this package).
// (h)(3)-(6),(8)-(10): the detailed nondiscrimination sub-tests
// (percentage/classification safe harbors, permitted exclusions, "highly
// compensated individual" ranking, controlled-group aggregation, timing) are
// each folded into the empirical facts `plan_discriminates_in_eligibility`/
// `highly_compensated_individual` a case asserts directly — TECH_GAP: the
// (3)(A)(i)-(ii)/(3)(B) percentage/classification computation itself
// (needs a payroll census and percentage arithmetic this package does not
// model, same class as the section 401(k) ADP/ACP tests in
// `deferred-compensation` per that package's own TECH-GAPS row) is not
// derived from a census, only asserted as a conclusion.

// --- §105(i): railroad sick pay ------------------------------------------------

relation railroad_unemployment_insurance_sickness_benefit(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "a benefit paid under section 2(a) of the Railroad Unemployment Insurance Act for days of sickness (section 105(i))";
}
relation sickness_result_of_on_the_job_injury(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the sickness (as determined under Railroad Retirement Board standards) is the result of on-the-job injury — excepted from (i)'s inclusion (section 105(i), exception clause)";
}
pub relation railroad_sick_pay_included_105i(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "gross income includes this Railroad Unemployment Insurance Act sickness benefit, unless it results from on-the-job injury (section 105(i))";
}
@source(IRC_S105_I, quote = "gross income includes benefits paid under section 2(a) of the Railroad Unemployment Insurance Act for days of sickness")
rule RailroadSickPayIncluded(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "Railroad Unemployment Insurance Act sickness benefits are included in gross income, except for on-the-job-injury sickness";
    when railroad_unemployment_insurance_sickness_benefit(p, y, amount);
    when not sickness_result_of_on_the_job_injury(p, y, amount);
    then railroad_sick_pay_included_105i(p, y, amount);
}

// --- §105(j): special rule for certain governmental plans --------------------
//
// A narrow, now-largely-historical (pre-2008) safe harbor preserving the
// (b) exclusion for specific governmental medical trusts reimbursing a
// deceased employee's beneficiary. Reading this provision as a further
// EXCEPTION to (h)'s discriminatory-plan test rather than an independent
// inclusion/exclusion rule of its own, and given the narrow, date-limited,
// EXTERNAL_DEPENDENCY-heavy fact pattern (favorable-ruling status under
// section 115/501(c)(9), which this package does not model), this row is
// classified INTERPRETATION/TECH_GAP rather than given its own rule this
// pass — folding it into `MedicalReimbursementExcluded` would require a
// third `not_known` guard keyed to a fact pattern this package cannot yet
// assert with any executable content beyond the case fact itself.

// ============================================================================
// Section 106 — Contributions by employer to accident and health plans
// ============================================================================

// --- §106(a): general rule -----------------------------------------------------

pub relation employer_contribution_to_accident_or_health_plan(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "employer-provided coverage under an accident or health plan for compensation (through insurance or otherwise) to the employee for personal injuries or sickness (section 106(a))";
}
pub relation employer_contribution_excluded_106a(employee: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "gross income does not include employer-provided accident or health plan coverage (section 106(a))";
}
@source(IRC_S106_A, quote = "Except as otherwise provided in this section, gross income of an employee does not include employer-provided coverage under an accident or health plan.")
rule EmployerHealthContributionExcluded(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, amount: Money) strict {
    label en official "employer-provided accident/health plan coverage is excluded from the employee's gross income";
    when employer_contribution_to_accident_or_health_plan(employer, employee, y, amount);
    then employer_contribution_excluded_106a(employee, y, amount);
}

// --- §106(b): contributions to Archer MSAs -------------------------------------

relation eligible_individual_for_archer_msa(employee: Individual, y: TaxableYear) kind empirical {
    label en official "an eligible individual for an Archer MSA within the meaning of section 220 (section 106(b)(1))";
}
relation employer_contribution_to_archer_msa(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "an amount contributed by the employer to the employee's Archer MSA (section 106(b)(1))";
}
relation archer_msa_contribution_limit_220b1(employee: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the limitation under section 220(b)(1), determined without regard to section 106(b), applicable to the employee for the taxable year — dependency contract, producer: unresolved (section 220, likely `deferred-compensation` or `deductions`)";
}
@source(IRC_S106_B, quote = "amounts contributed by such employee's employer to any Archer MSA of such employee shall be treated as employer-provided coverage for medical expenses under an accident or health plan to the extent such amounts do not exceed the limitation under section 220(b)(1)")
rule ArcherMsaContributionTreatedAsCoverage(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, amount: Money, limit: Money) strict {
    label en official "an Archer MSA contribution to an eligible individual, up to the section 220(b)(1) limit, is treated as employer-provided coverage under (a) and so excluded";
    when eligible_individual_for_archer_msa(employee, y);
    when employer_contribution_to_archer_msa(employer, employee, y, amount);
    when archer_msa_contribution_limit_220b1(employee, y, limit);
    when amount <= limit;
    then employer_contribution_excluded_106a(employee, y, amount);
}
// The portion (if any) exceeding the section 220(b)(1) limit is simply NOT
// given (b)(1)'s special "treated as coverage" status by the text; whether
// it is included by falling back to ordinary (a) treatment, or by some
// other provision, is not stated here — TECH_GAP/INTERPRETATION, not
// resolved this pass (the pinned text is silent on the excess's fate,
// unlike section 106(d) which cross-references (b)'s other paragraphs but
// not this silence).
// (b)(2) "no constructive receipt", (b)(3) deduction timing, (b)(4) return
// disclosure, (b)(5) COBRA carve-out, (b)(6) definitions, (b)(7) cross
// reference — each is its own narrow procedural rule keyed to a provision
// this package does not implement (sections 220, 4980B, 4980E, 6012);
// classified EXTERNAL_DEPENDENCY/NON_NORMATIVE per-row in the coverage file
// rather than given executable rules this pass.

// --- §106(c): long-term care benefits ------------------------------------------
// Coordination with section 7702B (qualified long-term care insurance
// contracts/services), a provision this package does not own —
// EXTERNAL_DEPENDENCY, owner unresolved (candidate: deferred-compensation or
// a dedicated long-term-care package, unconfirmed).

// --- §106(d): contributions to Health Savings Accounts ------------------------

relation eligible_individual_for_hsa_223c1(employee: Individual, y: TaxableYear) kind empirical {
    label en official "an eligible individual as defined in section 223(c)(1) (section 106(d)(1))";
}
relation employer_contribution_to_hsa(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "an employer contribution (including an employee's salary reduction contribution through a cafeteria plan) to an employee's Health Savings Account (section 223(d)) (section 106(d)(1))";
}
relation hsa_contribution_limit_223b(employee: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the limitation under section 223(b), determined without regard to section 106(d), applicable to the employee for the taxable year — dependency contract, producer: unresolved (section 223, likely `deferred-compensation` or `deductions`)";
}
pub relation hsa_contribution_excluded_106d(employee: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "gross income does not include employer contributions to an employee's HSA, up to the section 223(b) limit (section 106(d))";
}
@source(IRC_S106_D, quote = "amounts contributed by such employee's employer to any health savings account (as defined in section 223(d)) of such employee shall be treated as employer-provided coverage for medical expenses under an accident or health plan to the extent such amounts do not exceed the limitation under section 223(b)")
rule HsaContributionExcluded(employer: us.irc.core::Person, employee: Individual, y: TaxableYear, amount: Money, limit: Money) strict {
    label en official "an HSA contribution to an eligible individual, up to the section 223(b) limit, is treated as employer-provided coverage under (a) and so excluded";
    when eligible_individual_for_hsa_223c1(employee, y);
    when employer_contribution_to_hsa(employer, employee, y, amount);
    when hsa_contribution_limit_223b(employee, y, limit);
    when amount <= limit;
    then hsa_contribution_excluded_106d(employee, y, amount);
}
// As with (b), the fate of any excess over the section 223(b) limit is not
// stated by this subsection's text — TECH_GAP/INTERPRETATION, not resolved.
// (d)(2)'s cross-reference to (b)(2)-(5)'s "similar rules" (constructive
// receipt, deduction timing, return disclosure, COBRA carve-out) and the
// (d)(3) cross-reference to section 4980G — NON_NORMATIVE pointers, no
// independent content this package's own rules add.

// --- §106(e)-(g) -----------------------------------------------------------
// (e): qualified HSA distribution from an IRA/health FSA/HRA — a one-time
// rollover transaction rule keyed to sections 223/408, EXTERNAL_DEPENDENCY
// (owner: deferred-compensation for the IRA half, unconfirmed for the rest).
// (f): denial of the (a)/(d) exclusion for a specified-service-provider
// long-term-care-insurance salary-reduction arrangement under a cafeteria
// plan or FSA — EXTERNAL_DEPENDENCY on section 125/7702B, not modelled.
// (g): qualified small employer HRA coordination with section 9831(d) —
// EXTERNAL_DEPENDENCY, owner unresolved.
