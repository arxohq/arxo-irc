// Sections 142-150 — exempt facility bonds, qualified mortgage/small-issue/
// 501(c)(3) bonds, volume cap, other requirements, arbitrage, registration,
// and definitions. Stage 2d (IRC-06). CORE TESTS ONLY, given the scale of
// this group (~1,500 remaining rows even after this pass): §142(a) the 95%
// exempt-facility-use test; §143(c)(1) the single-family/within-jurisdiction
// residence test, (d)(1) the 95% no-prior-ownership-interest test, (f)(1)
// the 115%-of-median-income limit; §144(a)(1) the $1,000,000 small-issue
// face-amount/95%-use test (the (a)(4) $10,000,000 capital-expenditure
// alternative and its 6-year lookback are TECH_GAP, not reached); §145(a)
// the 5%-substituted private-activity test for qualified 501(c)(3) bonds;
// §146(a) volume cap — SOURCE_GAP, no rule (the per-capita dollar amount is
// not pinned anywhere in this corpus, per the coordinator's own framing);
// §147(c)(1) the 25%-land test and (d)(1)-(2) the existing-building
// rehabilitation-expenditure tests, (f)(1) the public-approval requirement
// (existence only); §148(a) the arbitrage-bond classification as an
// EVALUATIVE "reasonably expected" channel (DECISION-0194) plus (f)(1) the
// rebate requirement and (f)(4)(B)/(C) the 6-month/18-month/2-year spending
// exceptions as exact date tests; §149(a) the registration requirement,
// (b) the federal-guarantee prohibition, (d) the 90-day advance-refunding
// test; §150(a)(1) "bond" includes any obligation.
//
// NOT reached (recorded, not silently dropped): all remaining paragraphs of
// each subsection above; §142(b)-(o) (the per-category definitions of each
// of the 17 exempt-facility uses); §143(a)-(b),(e),(g)-(m) (the qualified-
// mortgage-issue/veteran's-mortgage-bond structural tests beyond the three
// named above, the targeted-area 110% rule, arbitrage/reporting/recapture);
// §144(a)(2)-(12),(b)-(d) (first-use, control, expansion, testing, and
// qualified-redevelopment-bond rules); §145(b)-(d) (the (a) test's own
// remaining special rules); §146(b)-(j) (the volume-cap allocation and
// carryforward machinery); §147(a),(b) (the 30-year-average-maturity 120%
// test — see the header's own listed priority §147(b)-(f), of which (b)
// itself, the 120% test, is NOT reached this pass, a genuine gap in
// covering the coordinator's exact list — TECH_GAP, see TECH-GAPS),
// (e),(g)-(h) (prohibited-facility bar, pooled-financing/discriminatory-loan
// term rules, the (h) exception cross-references); §148(b)-(e),(f)(2)-(3),
// (f)(4)(A),(D)-(H),(g)-(k) (the "higher yielding investments" yield
// computation itself, the rebate AMOUNT computation, the remaining spending
// exceptions and safe harbors, and the anti-abuse/definitions); §149(c),
// (e)-(i) (the S corporation passive-income coordination, pooled-financing
// issuer disclosure, hedge-bond and other remaining special rules); §150(b)-
// (e) (the remaining definitions and cross-references).

// =====================================================================
// §142(a): exempt facility bond, 95% test
// =====================================================================

use self::{
    BondIssue,
    IRC_S142_A,
    IRC_S143_C,
    IRC_S143_D,
    IRC_S143_F,
    IRC_S144_A,
    IRC_S145_A,
    IRC_S147_C,
    IRC_S147_D,
    IRC_S147_F,
    IRC_S148_A,
    IRC_S148_F,
    IRC_S149_A,
    IRC_S149_B,
    IRC_S149_D,
    IRC_S150_A,
    Individual,
    TaxableYear,
    bond_not_federally_guaranteed_for_spaceport_payments_149b3F,
    facility_conditions_met_142,
    issue_total_proceeds,
    proceeds_for_private_business_use,
    small_issue_aggregate_face_amount_144a,
    small_issue_barred_by_a_beneficiary_144a10,
    small_issue_barred_farm_property_144a11,
    small_issue_barred_other_exempt_bonds_144a7,
    small_issue_barred_residential_144a5,
    small_issue_barred_restricted_facilities_144a8,
    small_issue_face_limit_144a,
    small_issue_termination_ok_144a12,
};

pub enum ExemptFacilityUseKind {
    Airports; DocksAndWharves; MassCommutingFacilities; WaterFurnishing;
    SewageFacilities; SolidWasteDisposal; QualifiedResidentialRentalProject;
    LocalElectricOrGasFurnishing; DistrictHeatingOrCooling;
    QualifiedHazardousWaste; HighSpeedIntercityRail;
    HydroelectricEnvironmentalEnhancement; QualifiedPublicEducational;
    QualifiedGreenBuilding; QualifiedHighwayOrSurfaceFreightTransfer;
    QualifiedBroadband; QualifiedCarbonDioxideCapture;
}
pub relation issue_net_proceeds_for_exempt_facility_use(issue: BondIssue, kind: ExemptFacilityUseKind, amount: Money) kind empirical {
    label en official "the net proceeds of the issue to be used to provide one of the seventeen section 142(a)(1)-(17) exempt facility uses";
}
pub relation exempt_facility_bond_142a(issue: BondIssue) kind institutional {
    label en official "the issue is an exempt facility bond within the meaning of section 142(a): 95% or more of net proceeds for a listed use";
}
@source(IRC_S142_A, quote = "the term \"exempt facility bond\" means any bond issued as part of an issue 95 percent or more of the net proceeds of which are to be used to provide")
rule ExemptFacilityBondClassified(issue: BondIssue, kind: ExemptFacilityUseKind, used: Money, total: Money) strict {
    label en official "section 142(a): the 95% threshold together with the conditions section 142(b)-(o) attaches to the kind (stage 2f: facility_conditions_met_142)";
    when issue_net_proceeds_for_exempt_facility_use(issue, kind, used);
    when issue_total_proceeds(issue, total);
    when total > 0.00 USD;
    when used / total >= 0.95;
    when facility_conditions_met_142(issue, kind);
    then exempt_facility_bond_142a(issue);
}

// =====================================================================
// §143: qualified mortgage bonds (three named core tests)
// =====================================================================

pub relation single_family_residence_within_jurisdiction_143c1(residence: us.irc.core::Asset, issuer: us.irc.core::Organ) kind empirical {
    label en official "the residence is a single-family residence reasonably expected to become the mortgagor's principal residence within a reasonable time, located within the issuing authority's jurisdiction (section 143(c)(1)(A)-(B))";
}
pub relation residence_meets_143c(residence: us.irc.core::Asset, issuer: us.irc.core::Organ) kind institutional {
    label en official "the residence meets the requirements of section 143(c)";
}
@source(IRC_S143_C, quote = "it is a single-family residence which can reasonably be expected to become the principal residence of the mortgagor within a reasonable time after the financing is provided, and")
rule ResidenceMeets143c(residence: us.irc.core::Asset, issuer: us.irc.core::Organ) strict {
    label en official "section 143(c)(1)(A)-(B)";
    when single_family_residence_within_jurisdiction_143c1(residence, issuer);
    then residence_meets_143c(residence, issuer);
}

pub relation mortgagor_prior_ownership_interest_proceeds_143d(issue: BondIssue, amount: Money) kind empirical {
    label en official "the portion of net proceeds used to finance residences of mortgagors who HAD a present ownership interest in a principal residence during the 3-year period before the mortgage is executed (section 143(d)(1))";
}
pub relation issue_meets_143d_first_time_homebuyer_test(issue: BondIssue) kind institutional {
    label en official "section 143(d)(1): 95% or more of net proceeds finance residences of mortgagors with NO present ownership interest in a principal residence during the preceding 3-year period (the first-time-homebuyer rule)";
}
@source(IRC_S143_D, quote = "An issue meets the requirements of this subsection only if 95 percent or more of the net proceeds of such issue are used to finance the residences of mortgagors who had no present ownership interest in their principal residences")
rule IssueMeets143dFirstTimeHomebuyerTest(issue: BondIssue, prior_ownership: Money, total: Money) strict {
    label en official "section 143(d)(1): the 3-year first-time-homebuyer rule, exact 95% boundary";
    when mortgagor_prior_ownership_interest_proceeds_143d(issue, prior_ownership);
    when issue_total_proceeds(issue, total);
    when total > 0.00 USD;
    when (total - prior_ownership) / total >= 0.95;
    then issue_meets_143d_first_time_homebuyer_test(issue);
}

pub relation mortgagor_family_income(mortgagor: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the family income of the mortgagor for section 143(f) purposes";
}
pub relation applicable_median_family_income_143f(area: us.irc.core::Organ, y: TaxableYear, amount: Money) kind empirical {
    label en official "the applicable median family income for the area (section 143(f)(1), (4))";
}
pub relation mortgagor_income_within_143f_limit(mortgagor: Individual, area: us.irc.core::Organ, y: TaxableYear) kind institutional {
    label en official "the mortgagor's family income is 115 percent or less of the applicable median family income (section 143(f)(1))";
}
@source(IRC_S143_F, quote = "An issue meets the requirements of this subsection only if all owner-financing provided under the issue is provided for mortgagors whose family income is 115 percent or less of the applicable median family income")
rule MortgagorIncomeWithin143fLimit(mortgagor: Individual, area: us.irc.core::Organ, y: TaxableYear, income: Money, median: Money) strict {
    label en official "section 143(f)(1): the 115% income limit (the (5) high-housing-cost-area up-to-140% adjustment and the (3)(B) 140% partial-satisfaction rule are TECH_GAP, not modelled)";
    when mortgagor_family_income(mortgagor, y, income);
    when applicable_median_family_income_143f(area, y, median);
    when median > 0.00 USD;
    when income <= round(median * 1.15, 2, "HALF_UP");
    then mortgagor_income_within_143f_limit(mortgagor, area, y);
}

// =====================================================================
// §144(a)(1): qualified small issue bond
// =====================================================================

pub relation issue_authorized_face_amount(issue: BondIssue, amount: Money) kind empirical {
    label en official "the aggregate authorized face amount of the issue (section 144(a)(1))";
}
pub relation issue_proceeds_for_depreciable_property_or_redemption(issue: BondIssue, amount: Money) kind empirical {
    label en official "the proceeds used for acquisition/construction/reconstruction/improvement of depreciable property, or to redeem a prior issue for such purposes (section 144(a)(1)(A)-(B))";
}
pub relation qualified_small_issue_bond_144a1(issue: BondIssue) kind institutional {
    label en official "the issue is a qualified small issue bond within the meaning of section 144(a)(1): face amount at or below $1,000,000 and 95% or more of proceeds for the (A)-(B) purposes (the (a)(4) $10,000,000-with-6-year-capital-expenditure-lookback alternative test is TECH_GAP, not modelled)";
}
@source(IRC_S144_A, quote = "the term \"qualified small issue bond\" means any bond issued as part of an issue the aggregate authorized face amount of which is $1,000,000 or less and 95 percent or more of")
rule QualifiedSmallIssueBondClassified(issue: BondIssue, aggregate: Money, limit: Money, qualifying: Money, total: Money) strict {
    label en official "section 144(a)(1) with (2), (4) (aggregate face amount and limit), (5), (7), (8), (10), (11) (bars) and (12) (termination); stage 2f";
    when small_issue_aggregate_face_amount_144a(issue, aggregate);
    when small_issue_face_limit_144a(issue, limit);
    when aggregate <= limit;
    when issue_proceeds_for_depreciable_property_or_redemption(issue, qualifying);
    when issue_total_proceeds(issue, total);
    when total > 0.00 USD;
    when qualifying / total >= 0.95;
    when small_issue_termination_ok_144a12(issue);
    when not_known(small_issue_barred_residential_144a5(issue));
    when not_known(small_issue_barred_other_exempt_bonds_144a7(issue));
    when not_known(small_issue_barred_restricted_facilities_144a8(issue));
    when not_known(small_issue_barred_by_a_beneficiary_144a10(issue));
    when not_known(small_issue_barred_farm_property_144a11(issue));
    then qualified_small_issue_bond_144a1(issue);
}

// =====================================================================
// §145(a): qualified 501(c)(3) bond, 5%-substituted private-activity test
// =====================================================================

pub relation issue_property_owned_by_501c3_or_governmental_unit(issue: BondIssue) kind empirical {
    label en official "all property provided by net proceeds of the issue is to be owned by a section 501(c)(3) organization or a governmental unit (section 145(a)(1))";
}
pub relation private_business_use_test_met_145a2_5pct(issue: BondIssue) kind institutional {
    label en official "the (a)(2) test: the bond would still be a private activity bond even treating 501(c)(3) organizations as governmental units and substituting 5% for 10% in section 141(b)(1)-(2) — reusing this package's own section 141 module with a 5% threshold instead of 10%";
}
@source(IRC_S145_A, quote = "paragraphs (1) and (2) of section 141(b) were applied by substituting \"5 percent\" for \"10 percent\" each place it appears")
rule PrivateBusinessUseTestMet145a2_5pctBusinessUse(issue: BondIssue, private_use: Money, total: Money) strict {
    label en official "section 145(a)(2)(B): the 5%-substituted private business use branch";
    when proceeds_for_private_business_use(issue, private_use);
    when issue_total_proceeds(issue, total);
    when total > 0.00 USD;
    when private_use / total > 0.05;
    then private_business_use_test_met_145a2_5pct(issue);
}
pub relation qualified_501c3_bond_145a(issue: BondIssue) kind institutional {
    label en official "the private activity bond is a qualified 501(c)(3) bond within the meaning of section 145(a): (1) ownership by a 501(c)(3)/governmental unit AND (2) it would NOT be a private activity bond under the 5%-substituted test";
}
@source(IRC_S145_A, quote = "all property which is to be provided by the net proceeds of the issue is to be owned by a 501(c)(3) organization or a governmental unit")
rule Qualified501c3BondClassified(issue: BondIssue) strict {
    label en official "section 145(a)(1)-(2)";
    when issue_property_owned_by_501c3_or_governmental_unit(issue);
    when not_known(private_business_use_test_met_145a2_5pct(issue));
    then qualified_501c3_bond_145a(issue);
}

// =====================================================================
// §146(a): volume cap — SOURCE_GAP, no computable rule
// =====================================================================
//
// The per-capita/flat-dollar state ceiling amount under section 146(d) is
// not pinned anywhere in this corpus's `us.irc.inflation_adjustments`
// package (confirmed by inspection, same finding as sections 125(i)/127/
// 129/135/137 above); no rule is written for section 146(a)'s "aggregate
// face amount ... does not exceed the [volume cap]" test — a case cannot
// currently supply a defensible ceiling figure either, since the statute's
// own $75-per-capita/$249,999,999-floor figures are themselves indexed.
// Recorded as SOURCE_GAP in the coverage row, not silently omitted.

// =====================================================================
// §147(c)(1): land acquisition; (d)(1)-(2): existing buildings; (f)(1):
// public approval
// =====================================================================

pub relation issue_net_proceeds_for_land_acquisition(issue: BondIssue, amount: Money) kind empirical {
    label en official "the net proceeds of the issue to be used (directly or indirectly) for the acquisition of land or an interest therein (section 147(c)(1)(A))";
}
pub relation issue_fails_land_acquisition_test_147c1(issue: BondIssue) kind institutional {
    label en official "section 147(c)(1)(A): 25% or more of net proceeds for land acquisition disqualifies the bond from being a qualified bond (subject to the (h) exception, not modelled)";
}
@source(IRC_S147_C, quote = "it is issued as part of an issue and 25 percent or more of the net proceeds of such issue are to be used (directly or indirectly) for the acquisition of land (or an interest therein)")
rule IssueFailsLandAcquisitionTest(issue: BondIssue, land: Money, total: Money) strict {
    label en official "section 147(c)(1)(A): 25% threshold";
    when issue_net_proceeds_for_land_acquisition(issue, land);
    when issue_total_proceeds(issue, total);
    when total > 0.00 USD;
    when land / total >= 0.25;
    then issue_fails_land_acquisition_test_147c1(issue);
}

pub relation rehabilitation_expenditures_existing_building(building: us.irc.core::Asset, amount: Money) kind empirical {
    label en official "rehabilitation expenditures with respect to an existing building financed by the issue (section 147(d)(2)(A))";
}
pub relation building_acquisition_cost_financed(building: us.irc.core::Asset, amount: Money) kind empirical {
    label en official "the portion of the cost of acquiring the building (and equipment) financed with net proceeds of the issue (section 147(d)(2)(B))";
}
pub relation existing_building_rehabilitation_test_met_147d2(building: us.irc.core::Asset) kind institutional {
    label en official "section 147(d)(2): the existing-building acquisition prohibition of (d)(1) does not apply because rehabilitation expenditures equal or exceed 15% of the financed acquisition cost";
}
@source(IRC_S147_D, quote = "the rehabilitation expenditures with respect to such building, equal or exceed")
rule ExistingBuildingRehabilitationTestMet(building: us.irc.core::Asset, rehab: Money, acquisition_cost: Money) strict {
    label en official "section 147(d)(2)(A)-(B): 15% rehabilitation-to-acquisition-cost ratio for a building";
    when rehabilitation_expenditures_existing_building(building, rehab);
    when building_acquisition_cost_financed(building, acquisition_cost);
    when acquisition_cost > 0.00 USD;
    when rehab / acquisition_cost >= 0.15;
    then existing_building_rehabilitation_test_met_147d2(building);
}

pub relation public_approval_obtained_147f(issue: BondIssue) kind empirical {
    label en official "the issue satisfies the section 147(f)(2) public approval requirement (public hearing and approval by the applicable elected representative/governmental unit) (section 147(f)(1)-(2))";
}
pub relation public_approval_requirement_satisfied_147f(issue: BondIssue) kind institutional {
    label en official "section 147(f)(1): the private activity bond is a qualified bond only if the public approval requirement is met";
}
@source(IRC_S147_F, quote = "A private activity bond shall not be a qualified bond unless such bond satisfies the requirements of paragraph (2).")
rule PublicApprovalRequirementSatisfied(issue: BondIssue) strict {
    label en official "section 147(f)(1) (the (2) public-hearing/approval PROCEDURE itself is not decomposed — case-asserted as a compound fact)";
    when public_approval_obtained_147f(issue);
    then public_approval_requirement_satisfied_147f(issue);
}

// =====================================================================
// §148(a): arbitrage bond (EVALUATIVE); (f)(1): rebate requirement;
// (f)(4)(B)-(C): spending exceptions with exact date tests
// =====================================================================

external judgment relation proceeds_reasonably_expected_for_higher_yielding_investments_148a(issue: BondIssue) {
    authority Secretary;
    label en official "any portion of the proceeds of the issue is reasonably expected (at issuance) to be used, or intentionally used, to acquire higher-yielding investments or to replace funds so used (section 148(a)(1)-(2)) — an evaluative, forward-looking-expectation test, DECISION-0194 channel";
}
pub relation arbitrage_bond_148a(issue: BondIssue) kind institutional {
    label en official "the bond is an arbitrage bond within the meaning of section 148(a)";
}
@source(IRC_S148_A, quote = "the term \"arbitrage bond\" means any bond issued as part of an issue any portion of the proceeds of which are reasonably expected (at the time of issuance of the bond) to be used")
rule ArbitrageBondClassified(issue: BondIssue) strict {
    label en official "section 148(a): the evaluative reasonable-expectation test";
    when proceeds_reasonably_expected_for_higher_yielding_investments_148a(issue);
    then arbitrage_bond_148a(issue);
}

pub relation rebate_requirement_met_148f2(issue: BondIssue) kind empirical {
    label en official "the section 148(f)(2) rebate-to-the-United-States requirement is met with respect to the issue (case-asserted; the rebate AMOUNT computation itself is not derived this pass — TECH_GAP)";
}
pub relation issue_treated_as_arbitrage_bond_148f1(issue: BondIssue) kind institutional {
    label en official "section 148(f)(1): a bond is treated as an arbitrage bond if the (f)(2)-(3) rebate/timely-payment requirements are not met, unless a (f)(4) spending exception applies";
}
@source(IRC_S148_F, quote = "A bond which is part of an issue shall be treated as an arbitrage bond if the requirements of paragraphs (2) and (3) are not met with respect to such issue.")
rule IssueTreatedAsArbitrageBondForRebateFailure(issue: BondIssue) strict {
    label en official "section 148(f)(1), absent a (f)(4) spending exception";
    when issue_total_proceeds(issue, _);
    when not_known(rebate_requirement_met_148f2(issue));
    when not_known(construction_issue_spending_exception_met_148f4C(issue));
    then issue_treated_as_arbitrage_bond_148f1(issue);
}

pub relation construction_issue_spending_6month_10pct(issue: BondIssue, spent_within_6mo_fraction: Decimal) kind empirical {
    label en official "the fraction of available construction proceeds spent for governmental purposes within the 6-month period beginning on the issue date (section 148(f)(4)(C)(ii)(I))";
}
pub relation construction_issue_spending_1yr_45pct(issue: BondIssue, spent_within_1yr_fraction: Decimal) kind empirical {
    label en official "the fraction spent within the 1-year period (section 148(f)(4)(C)(ii)(II))";
}
pub relation construction_issue_spending_18mo_75pct(issue: BondIssue, spent_within_18mo_fraction: Decimal) kind empirical {
    label en official "the fraction spent within the 18-month period (section 148(f)(4)(C)(ii)(III))";
}
pub relation construction_issue_spending_2yr_100pct(issue: BondIssue, spent_within_2yr_fraction: Decimal) kind empirical {
    label en official "the fraction spent within the 2-year period (section 148(f)(4)(C)(ii)(IV))";
}
pub relation construction_issue_spending_exception_met_148f4C(issue: BondIssue) kind institutional {
    label en official "section 148(f)(4)(C): the construction-issue spending exception — 10%/45%/75%/100% spent within 6 months/1 year/18 months/2 years respectively";
}
@source(IRC_S148_F, quote = "10 percent of the available construction proceeds of the construction issue are spent for the governmental purposes of the issue within the 6-month period beginning on the date the bonds are issued")
rule ConstructionIssueSpendingExceptionMet(issue: BondIssue, f6: Decimal, f1y: Decimal, f18: Decimal, f2y: Decimal) strict {
    label en official "section 148(f)(4)(C)(ii)(I)-(IV), all four milestones at once (each an exact percentage boundary, \"at least\")";
    when construction_issue_spending_6month_10pct(issue, f6);
    when construction_issue_spending_1yr_45pct(issue, f1y);
    when construction_issue_spending_18mo_75pct(issue, f18);
    when construction_issue_spending_2yr_100pct(issue, f2y);
    when f6 >= 0.10;
    when f1y >= 0.45;
    when f18 >= 0.75;
    when f2y >= 1.00;
    then construction_issue_spending_exception_met_148f4C(issue);
}

relation small_issuer_gross_proceeds_spent_by(issue: BondIssue, issued_on: Date, spent_by: Date) kind empirical {
    label en official "the date by which gross proceeds of a small issue ($5,000,000-or-less governmental unit, section 148(f)(4)(D)) are expended for the governmental purposes for which the issue was issued (section 148(f)(4)(B)(i)(I), 6 months, or (B)(ii), 1 year for the small-issuer substitution)";
}
pub relation small_issuer_6month_spending_exception_met_148f4B(issue: BondIssue) kind institutional {
    label en official "section 148(f)(4)(B)(i): gross proceeds spent within 6 months of the issue date";
}
@source(IRC_S148_F, quote = "the gross proceeds of such issue are expended for the governmental purposes for which the issue was issued no later than the day which is 6 months after the date of issuance of the issue")
rule SmallIssuer6MonthSpendingExceptionMet(issue: BondIssue, issued_on: Date, spent_by: Date) strict {
    label en official "section 148(f)(4)(B)(i)(I), exact date boundary";
    when small_issuer_gross_proceeds_spent_by(issue, issued_on, spent_by);
    when spent_by <= add_calendar_period(issued_on, 6 calendar_month);
    then small_issuer_6month_spending_exception_met_148f4B(issue);
}
relation small_governmental_unit_5000000_or_less_148f4D(issue: us.irc.core::Organ) kind empirical {
    label en official "the issuer reasonably expects, at the time of issuance, that the amount of construction/other bonds to be issued by it during the calendar year will not exceed $5,000,000 (section 148(f)(4)(D)(i)(III) and the general small-issuer substitution)";
}

// =====================================================================
// §149(a)/(b)/(d): registration, federal guarantee, advance refunding
// =====================================================================

pub relation bond_in_registered_form_149a(bond: us.irc.core::Asset) kind empirical {
    label en official "the bond is issued in registered form (or, for a book-entry bond, transferable only through a book-entry system) (section 149(a)(1),(3)(A))";
}
relation registration_required_bond_149a2(bond: us.irc.core::Asset) kind empirical {
    label en official "the bond is a registration-required bond: not of a type offered to the public, and not having a maturity at issue of 1 year or less, are the only exceptions (section 149(a)(2)(A)-(B)) — case-asserted as the bond IS registration-required";
}
pub relation registration_requirement_satisfied_149a(bond: us.irc.core::Asset) kind institutional {
    label en official "section 149(a)(1): a registration-required bond's interest is tax-exempt only if the bond is in registered form";
}
@source(IRC_S149_A, quote = "unless such bond is in registered form")
rule RegistrationRequirementSatisfied(bond: us.irc.core::Asset) strict {
    label en official "section 149(a)(1)";
    when registration_required_bond_149a2(bond);
    when bond_in_registered_form_149a(bond);
    then registration_requirement_satisfied_149a(bond);
}

pub relation bond_federally_guaranteed_149b(bond: us.irc.core::Asset) kind empirical {
    label en official "payment of principal or interest on the bond is guaranteed in whole or part by the United States or an agency/instrumentality, or 5% or more of proceeds are used in guaranteed loans or invested in federally insured deposits (section 149(b)(2)(A)-(B))";
}
pub relation bond_tax_exemption_denied_federal_guarantee_149b(bond: us.irc.core::Asset) kind institutional {
    label en official "section 149(b)(1): section 103(a) does not apply to a federally guaranteed State or local bond";
}
@source(IRC_S149_B, quote = "Section 103(a) shall not apply to any State or local bond if such bond is federally guaranteed.")
rule BondTaxExemptionDeniedFederalGuarantee(bond: us.irc.core::Asset) strict {
    label en official "section 149(b)(1)";
    when bond_federally_guaranteed_149b(bond);
    when not_known(bond_not_federally_guaranteed_for_spaceport_payments_149b3F(bond));
    then bond_tax_exemption_denied_federal_guarantee_149b(bond);
}

pub relation bond_issued_to_advance_refund(new_bond: us.irc.core::Asset, refunded_bond: us.irc.core::Asset, issued_on: Date, redemption_on: Date) kind empirical {
    label en official "a bond issued to refund another bond, with the issuance and redemption dates (section 149(d)(2))";
}
pub relation bond_treated_as_advance_refunding_149d2(new_bond: us.irc.core::Asset, refunded_bond: us.irc.core::Asset) kind institutional {
    label en official "section 149(d)(2): a bond is treated as issued to advance refund another bond if issued more than 90 days before the refunded bond's redemption";
}
@source(IRC_S149_D, quote = "a bond shall be treated as issued to advance refund another bond if it is issued more than 90 days before the redemption of the refunded bond")
rule BondTreatedAsAdvanceRefunding(new_bond: us.irc.core::Asset, refunded_bond: us.irc.core::Asset, issued_on: Date, redemption_on: Date, calendar_before_1: Date) strict {
    label en official "section 149(d)(2), exact 90-day boundary";
    when bond_issued_to_advance_refund(new_bond, refunded_bond, issued_on, redemption_on);
    when issued_on < calendar_before_1
        and us.irc.core::civil_calendar_boundary_before(redemption_on, 90, us.irc.core::CalendarDay, calendar_before_1);
    then bond_treated_as_advance_refunding_149d2(new_bond, refunded_bond);
}
pub relation advance_refunding_tax_exemption_denied_149d1(new_bond: us.irc.core::Asset) kind institutional {
    label en official "section 149(d)(1): no tax exemption for interest on a bond issued to advance refund another bond";
}
@source(IRC_S149_D, quote = "Nothing in section 103(a) or in any other provision of law shall be construed to provide an exemption from Federal income tax for interest on any bond issued to advance refund another bond.")
rule AdvanceRefundingTaxExemptionDenied(new_bond: us.irc.core::Asset, refunded_bond: us.irc.core::Asset) strict {
    label en official "section 149(d)(1)";
    when bond_treated_as_advance_refunding_149d2(new_bond, refunded_bond);
    then advance_refunding_tax_exemption_denied_149d1(new_bond);
}

// =====================================================================
// §150(a)(1): "bond" includes any obligation
// =====================================================================

pub relation obligation_treated_as_bond_150a1(obligation: us.irc.core::Asset) kind institutional {
    label en official "section 150(a)(1): the term \"bond\" includes any obligation";
}
relation is_an_obligation(obligation: us.irc.core::Asset) kind empirical {
    label en official "the asset is an obligation (case-asserted; this package does not itself define \"obligation\")";
}
@source(IRC_S150_A, quote = "The term \"bond\" includes any obligation.")
rule ObligationTreatedAsBond(obligation: us.irc.core::Asset) strict {
    label en official "section 150(a)(1)";
    when is_an_obligation(obligation);
    then obligation_treated_as_bond_150a1(obligation);
}
