// STAGE 2 — §6014 (income tax return—tax not computed by taxpayer) and
// §6015 (relief from joint and several liability on joint returns).
//
// JUDGMENT CALLS AND GAPS (see report / coverage/returns.json for detail):
//  - §6014(a) is a `power`: the taxpayer's election changes who computes the
//    tax and triggers the Secretary's own duty to compute and mail notice.
//    The five eligibility facts are bundled into one derived relation
//    (`s6014_eligible`) because `valid_when` takes exactly one atom.
//  - §6014(b) is NON_NORMATIVE: pure delegation to regulations extending the
//    section's own scope (four enumerated classes the Secretary MAY cover,
//    plus a husband-and-wife joint-and-several-liability delegation); none
//    of it is self-executing text absent the regulations themselves.
//  - §6015(a)'s "without regard to community property laws" instruction is
//    modeled as a classification fact read by the (b)/(c)/(f) computations,
//    not as its own position.
//  - §6015(b)(1)(C)/(D) ("did not know, and had no reason to know" /
//    "inequitable") are DECISION-0194 evaluative elements — `external
//    judgment relation` with `authority Secretary` (reviewable de novo by
//    the Tax Court under (e)(7), which this package also states as the
//    Court's own judgment channel on the same predicate name, since the
//    statute assigns ONE question to two successive deciders rather than
//    two different questions).
//  - §6015(b)(2) apportionment: the "extent" of what the electing spouse did
//    not know is itself an adjudicated quantity, not a formula this
//    package computes — modeled as an institutional `Money` fact read by
//    the apportioned-relief rule (TECH_GAP: no self-executing formula in
//    the statute's own text for translating "extent of knowledge" into a
//    dollar figure; the decider supplies it).
//  - §6015(c) is modeled as a `power` (election to limit liability under the
//    (d) allocation) with (3)(A)(ii) (fraudulent-transfer scheme) as an
//    invalidity condition producing `POWER_INVALID_EXERCISE` per E-0239,
//    and (3)(C) (actual-knowledge carve-out, with the (3)(C) duress
//    exception) as a narrowing `unless` on the ALLOCATED-amount rule, not
//    on the election's own validity — the statute keeps the election valid
//    but denies it as to the known item.
//  - §6015(d)'s ratio formula ((1)) is exact Decimal arithmetic
//    (`div_round`/`round`, `us.irc.core::Money`); (2)-(3) reallocate which
//    items enter the ratio's numerator/denominator; (4)/(5) are further
//    narrowing/disregard rules layered on the same allocation relation.
//    The individual, separate-item allocation of every possible deficiency
//    item is a case-by-case computation this package does not attempt for
//    every conceivable item — TECH_GAP for the general "as if separate
//    returns had been filed" hypothetical recomputation, flagged G441.
//  - §6015(e) states the Tax Court's jurisdiction as a `power` to petition
//    (holder the electing/requesting individual) with the 90-day/6-month
//    timing in `valid_when`, an `immunity` protecting against levy/court
//    proceedings during the statutory window ((e)(1)(B)), and an
//    institutional fact suspending the §6502 collection period ((e)(2)) —
//    consumed, not computed, by `assessment`/`payment-refunds-interest`
//    (EXTERNAL_DEPENDENCY at the consuming end). (e)(3)'s refund-suit
//    jurisdiction transfer and (e)(4)'s notice-to-other-spouse procedural
//    rule and (e)(6)'s bankruptcy-stay suspension are modeled as narrower
//    institutional-effect rules on the same petition/suspension relations.
//  - §6015(f) equitable relief is a `power` held by the Secretary (the
//    statute says "the Secretary may relieve"), `valid_when` an `external
//    judgment relation` (facts-and-circumstances inequity, authority
//    Secretary) conjoined with unavailability under (b)/(c); (2)'s two
//    limitation windows are alternative validity branches on the same
//    power, not `and`/`not` inside one `valid_when` (bundled into one
//    derived relation for the same reason as §6014).
//  - §6015(g) credit/refund allowance is a `classification` rule with (2)'s
//    res judicata carve-out reading a prior-court-decision fact
//    (EXTERNAL_DEPENDENCY on `judicial-proceedings`/`assessment`, which
//    this package does not own) and (3)'s flat bar on (c) elections as an
//    `unless` defeater.
//  - §6015(h) is NON_NORMATIVE (regulations delegation, no self-executing
//    text beyond what (b)-(f) already state).

language "law.core" version "0.2";
package us.irc.returns version "0.1.1";
namespace "urn:us:irc:returns:clir";

use self::{
    IRC_S6014_A,
    IRC_S6015_A,
    IRC_S6015_B,
    IRC_S6015_C,
    IRC_S6015_D,
    IRC_S6015_E,
    IRC_S6015_F,
    IRC_S6015_G,
    Individual,
    Person,
    Secretary,
    TaxableYear,
    gross_income_amount,
    joint_return_in_effect,
};

// ============================================================================
// §6014 — Income tax return—tax not computed by taxpayer
// ============================================================================

relation itemizes_deductions(p: Individual, y: TaxableYear) kind empirical;
relation described_in_6012_a_1_c_i(p: Individual, y: TaxableYear) kind institutional {
    label en unofficial "the individual is described in §6012(a)(1)(C)(i) (pending cross-reference to module 02, low-income filing exception)";
}
relation gross_income_only_wages_dividends_interest(p: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the individual's gross income includes no item other than remuneration for services as an employee, dividends, or interest";
}
relation nonwage_gross_income_amount(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the individual's gross income other than wages as defined in §3401(a) for the taxable year";
}
relation s6014_eligible(p: Individual, y: TaxableYear) kind institutional {
    label en unofficial "the individual is eligible to elect §6014 (bundles the five statutory conditions into one atom for valid_when)";
}
@source(IRC_S6014_A, relation = formalizes, coverage = partial, quote = "An individual who does not itemize his deductions and who is not described in section 6012(a)(1)(C)(i), whose gross income is less than $10,000 and includes no income other than remuneration for services performed by him as an employee, dividends or interest, and whose gross income other than wages, as defined in section 3401(a), does not exceed $100, shall at his election not be required to show on the return the tax imposed by section 1.")
rule S6014Eligible strict {
    for p: Individual;
    for y: TaxableYear;
    for gi: Money;
    for nw: Money;
    when not_known(itemizes_deductions(p, y))
        and not_known(described_in_6012_a_1_c_i(p, y))
        and gross_income_amount(p, y, gi) and gi < 10000.00 USD
        and gross_income_only_wages_dividends_interest(p, y)
        and nonwage_gross_income_amount(p, y, nw) and nw <= 100.00 USD;
    then s6014_eligible(p, y);
}

relation elects_6014(p: Individual, y: TaxableYear) kind empirical;
relation tax_not_shown_election_in_effect(p: Individual, y: TaxableYear) kind institutional {
    label en unofficial "the §6014 election is in effect: the individual is not required to show the §1 tax on the return";
}
@source(IRC_S6014_A, relation = formalizes, coverage = exact, quote = "shall at his election not be required to show on the return the tax imposed by section 1. Such election shall be made by using the form prescribed for purposes of this section.")
rule S6014ElectionPower strict {
    for p: Individual;
    for y: TaxableYear;
    when elects_6014(p, y);
    then power S6014TaxNotComputedByTaxpayerElection {
        holder p;
        over Secretary;
        exercise elects_6014(p, y);
        valid_when s6014_eligible(p, y);
        effect create(tax_not_shown_election_in_effect(p, y));
    };
}

relation secretary_computes_and_mails_notice(p: Individual, y: TaxableYear) kind empirical;
@source(IRC_S6014_A, relation = formalizes, coverage = exact, quote = "In such case the tax shall be computed by the Secretary who shall mail to the taxpayer a notice stating the amount determined as payable.")
rule S6014SecretaryComputesTaxDuty strict {
    for p: Individual;
    for y: TaxableYear;
    when tax_not_shown_election_in_effect(p, y);
    then duty ComputeAndMailTaxNotice {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition secretary_computes_and_mails_notice(p, y);
            window [-infinity, infinity];
        }
    };
}

// §6014(b) regulations: pure delegation extending the section's own scope to
// four enumerated classes of case plus husband-and-wife treatment — no
// self-executing text of its own. NON_NORMATIVE.
relation s6014_b_regulations_delegation(unused: Boolean) kind institutional {
    label en unofficial "§6014(b) delegates to regulations the extension of this section's scope; no self-executing rule (NON_NORMATIVE)";
}

// ============================================================================
// §6015 — Relief from joint and several liability on joint return
// ============================================================================

// --- (a) In general ---------------------------------------------------------

relation eligible_to_elect_6015c(p: Individual, s: Individual, y: TaxableYear) kind institutional;
relation elects_6015b(p: Individual, s: Individual, y: TaxableYear) kind empirical;
relation elects_6015b_on(p: Individual, s: Individual, y: TaxableYear, filed: Date) kind empirical {
    label en unofficial "the date the §6015(b) election was filed";
}
relation elects_6015c(p: Individual, s: Individual, y: TaxableYear) kind empirical;
relation elects_6015c_on(p: Individual, s: Individual, y: TaxableYear, filed: Date) kind empirical {
    label en unofficial "the date the §6015(c) election was filed";
}
relation disregard_community_property_for_6015(p: Individual, s: Individual, y: TaxableYear) kind institutional {
    label en unofficial "any determination under §6015 is made without regard to community property laws";
}
@source(IRC_S6015_A, relation = formalizes, coverage = exact, quote = "Any determination under this section shall be made without regard to community property laws.")
rule S6015DisregardCommunityProperty strict {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    when joint_return_in_effect(p, s, y);
    then disregard_community_property_for_6015(p, s, y);
}

// --- (b) Procedures for relief from liability applicable to all joint filers

relation understatement_of_tax(p: Individual, s: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "an understatement of tax within the meaning of §6662(d)(2)(A) attributable to erroneous items of the other individual (pending: penalties owns §6662(d)(2)(A))";
}
relation attributable_to_other_individual(p: Individual, s: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the understatement on the joint return is attributable to erroneous items of the individual OTHER than p (i.e. of s)";
}
external judgment relation did_not_know_and_no_reason_to_know_understatement(p: Individual, s: Individual, y: TaxableYear) {
    authority Secretary;
    label en official "in signing the return the individual did not know, and had no reason to know, that there was such understatement";
}
external judgment relation inequitable_to_hold_liable_6015b(p: Individual, s: Individual, y: TaxableYear) {
    authority Secretary;
    label en official "taking into account all the facts and circumstances, it is inequitable to hold the individual liable for the deficiency attributable to the understatement";
}
relation collection_activities_commenced(p: Individual, y: TaxableYear, d: Date) kind empirical {
    label en unofficial "the date the Secretary has begun collection activities with respect to the individual making the election";
}
relation s6015b_election_timely(p: Individual, s: Individual, y: TaxableYear) kind institutional;
@source(IRC_S6015_B, relation = formalizes, coverage = partial, quote = "not later than the date which is 2 years after the date the Secretary has begun collection activities with respect to the individual making the election")
rule S6015bElectionTimely strict {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    for d: Date;
    for filed: Date;
    when elects_6015b_on(p, s, y, filed)
        and collection_activities_commenced(p, y, d)
        and filed <= add_calendar_period(d, 24 calendar_month);
    then s6015b_election_timely(p, s, y);
}
relation s6015b_relief_conditions(p: Individual, s: Individual, y: TaxableYear) kind institutional {
    label en unofficial "bundles §6015(b)(1)(A)-(E) into one atom for valid_when";
}
@source(IRC_S6015_B, relation = formalizes, coverage = exact, quote = "a joint return has been made for a taxable year")
rule S6015bReliefConditions strict {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    when joint_return_in_effect(p, s, y)
        and attributable_to_other_individual(p, s, y)
        and did_not_know_and_no_reason_to_know_understatement(p, s, y)
        and inequitable_to_hold_liable_6015b(p, s, y)
        and s6015b_election_timely(p, s, y);
    then s6015b_relief_conditions(p, s, y);
}
relation innocent_spouse_relief_6015b_full(p: Individual, s: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "p is fully relieved of liability (tax, interest, penalties, other amounts) attributable to the understatement";
}
@source(IRC_S6015_B, relation = formalizes, coverage = exact, quote = "then the other individual shall be relieved of liability for tax (including interest, penalties, and other amounts) for such taxable year to the extent such liability is attributable to such understatement.")
rule S6015bFullReliefImmunity strict {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    for amt: Money;
    when s6015b_relief_conditions(p, s, y) and understatement_of_tax(p, s, y, amt);
    then immunity S6015bFullRelief {
        holder p;
        protected_effect liable_for_understatement_deficiency(p, s, y, amt);
        window [-infinity, infinity];
    };
    then innocent_spouse_relief_6015b_full(p, s, y, amt);
}

relation known_extent_of_understatement(p: Individual, s: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the portion of the understatement the electing individual DID know or had reason to know (adjudicated quantity — TECH_GAP G447: no statutory formula translates \"extent of knowledge\" into a dollar figure)";
}
relation innocent_spouse_relief_6015b_apportioned(p: Individual, s: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "p is relieved of liability to the extent of the portion of the understatement p did not know and had no reason to know (§6015(b)(2))";
}
@source(IRC_S6015_B, relation = formalizes, coverage = exact, quote = "If an individual who, but for paragraph (1)(C), would be relieved of liability under paragraph (1), establishes that in signing the return such individual did not know, and had no reason to know, the extent of such understatement")
rule S6015bApportionedRelief defeasible {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    for total: Money;
    for known: Money;
    when joint_return_in_effect(p, s, y)
        and attributable_to_other_individual(p, s, y)
        and inequitable_to_hold_liable_6015b(p, s, y)
        and s6015b_election_timely(p, s, y)
        and understatement_of_tax(p, s, y, total)
        and known_extent_of_understatement(p, s, y, known);
    then innocent_spouse_relief_6015b_apportioned(p, s, y, round(total - known, 2, "HALF_UP"));
    unless did_not_know_and_no_reason_to_know_understatement(p, s, y) and understatement_of_tax(p, s, y, total) and known_extent_of_understatement(p, s, y, known);
}

pub relation innocent_spouse_relief(p: Individual, s: Individual, y: TaxableYear) kind institutional {
    label en unofficial "some form of §6015(b) innocent-spouse relief (full or apportioned) is in effect for p with respect to s's joint return for the year";
}
@source(IRC_S6015_B, relation = formalizes, coverage = partial, quote = "then the other individual shall be relieved of liability for tax")
rule S6015InnocentSpouseReliefUmbrellaFull strict {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    for amt: Money;
    when innocent_spouse_relief_6015b_full(p, s, y, amt);
    then innocent_spouse_relief(p, s, y);
}
@source(IRC_S6015_B, relation = formalizes, coverage = partial, quote = "such individual shall be relieved of liability for tax (including interest, penalties, and other amounts) for such taxable year to the extent that such liability is attributable to the portion of such understatement of which such individual did not know and had no reason to know.")
rule S6015InnocentSpouseReliefUmbrellaApportioned defeasible {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    for amt: Money;
    when innocent_spouse_relief_6015b_apportioned(p, s, y, amt);
    then innocent_spouse_relief(p, s, y);
}

// --- (c) Procedures to limit liability (separation of liability election) --

relation no_longer_married_or_legally_separated(p: Individual, s: Individual, y: TaxableYear) kind empirical;
relation not_same_household_twelve_months(p: Individual, s: Individual, y: TaxableYear) kind empirical;
relation s6015c_eligible_to_elect(p: Individual, s: Individual, y: TaxableYear) kind institutional {
    label en unofficial "bundles §6015(c)(3)(A)(i)(I)-(II) into one atom for valid_when";
}
@source(IRC_S6015_C, relation = formalizes, coverage = partial, quote = "at the time such election is filed, such individual is no longer married to, or is legally separated from, the individual with whom such individual filed the joint return to which the election relates")
rule S6015cEligibleToElect defeasible {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    when joint_return_in_effect(p, s, y)
        and (no_longer_married_or_legally_separated(p, s, y) or not_same_household_twelve_months(p, s, y));
    then s6015c_eligible_to_elect(p, s, y);
}
rule S6015cEligibleFlag defeasible {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    when s6015c_eligible_to_elect(p, s, y);
    then eligible_to_elect_6015c(p, s, y);
}

relation fraudulent_transfer_scheme_between_spouses(p: Individual, s: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the Secretary demonstrates assets were transferred between the individuals as part of a fraudulent scheme (§6015(c)(3)(A)(ii))";
}
relation deficiency_asserted(p: Individual, s: Individual, y: TaxableYear) kind empirical;
relation s6015c_election_timely(p: Individual, s: Individual, y: TaxableYear) kind institutional;
@source(IRC_S6015_C, relation = formalizes, coverage = exact, quote = "An election under this subsection for any taxable year may be made at any time after a deficiency for such year is asserted but not later than 2 years after the date on which the Secretary has begun collection activities with respect to the individual making the election.")
rule S6015cElectionTimely strict {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    for d: Date;
    for filed: Date;
    when deficiency_asserted(p, s, y)
        and collection_activities_commenced(p, y, d)
        and elects_6015c_on(p, s, y, filed)
        and filed <= add_calendar_period(d, 24 calendar_month);
    then s6015c_election_timely(p, s, y);
}
relation s6015c_election_valid(p: Individual, s: Individual, y: TaxableYear) kind institutional {
    label en unofficial "bundles the §6015(c) validity conditions (eligibility + timing) into one atom for valid_when; the (3)(A)(ii) fraud bar is a separate `unless`-style invalidity condition on the power itself";
}
rule S6015cElectionValid defeasible {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    when eligible_to_elect_6015c(p, s, y) and s6015c_election_timely(p, s, y);
    then s6015c_election_valid(p, s, y);
}
relation allocated_deficiency_amount(p: Individual, s: Individual, y: TaxableYear, amount: Money) kind institutional;
relation separation_of_liability_in_effect(p: Individual, s: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "p's liability for the joint-return deficiency is limited to the §6015(d) allocated amount";
}
@source(IRC_S6015_C, relation = formalizes, coverage = exact, quote = "if an individual who has made a joint return for any taxable year elects the application of this subsection, the individual's liability for any deficiency which is assessed with respect to the return shall not exceed the portion of such deficiency properly allocable to the individual under subsection (d).")
rule S6015cSeparationOfLiabilityPower defeasible {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    for alloc: Money;
    when elects_6015c(p, s, y) and allocated_deficiency_amount(p, s, y, alloc);
    then power S6015SeparationOfLiabilityElection {
        holder p;
        over Secretary;
        exercise elects_6015c(p, s, y);
        valid_when s6015c_election_valid(p, s, y);
        effect create(separation_of_liability_in_effect(p, s, y, alloc));
    };
    unless fraudulent_transfer_scheme_between_spouses(p, s, y) and allocated_deficiency_amount(p, s, y, alloc);
}
pub relation separation_of_liability_election(p: Individual, s: Individual, y: TaxableYear) kind institutional {
    label en unofficial "a valid §6015(c) separation-of-liability election is in effect for p with respect to s's joint return for the year";
}
rule S6015SeparationOfLiabilityElectionFlag strict {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    for alloc: Money;
    when separation_of_liability_in_effect(p, s, y, alloc);
    then separation_of_liability_election(p, s, y);
}

relation actual_knowledge_of_item_giving_rise_to_deficiency(p: Individual, s: Individual, y: TaxableYear, item_amount: Money) kind empirical {
    label en unofficial "the Secretary demonstrates p had actual knowledge, at the time of signing, of the item giving rise to the (portion of the) deficiency not otherwise allocable to p (§6015(c)(3)(C))";
}
relation signed_under_duress(p: Individual, s: Individual, y: TaxableYear) kind empirical;
relation item_excluded_from_6015c_election_by_actual_knowledge(p: Individual, s: Individual, y: TaxableYear, item_amount: Money) kind institutional;
@source(IRC_S6015_C, relation = formalizes, coverage = exact, quote = "an individual making an election under this subsection had actual knowledge, at the time such individual signed the return, of any item giving rise to a deficiency")
rule S6015cActualKnowledgeCarveOut defeasible {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    for amt: Money;
    when actual_knowledge_of_item_giving_rise_to_deficiency(p, s, y, amt);
    then item_excluded_from_6015c_election_by_actual_knowledge(p, s, y, amt);
    unless signed_under_duress(p, s, y) and actual_knowledge_of_item_giving_rise_to_deficiency(p, s, y, amt);
}

// --- (c)(4) liability increased by transfers to avoid tax -------------------

relation disqualified_asset_transferred(p: Individual, s: Individual, y: TaxableYear, value: Money) kind empirical {
    label en unofficial "property or a right to property transferred to p by s with the principal purpose of avoiding tax or its payment (§6015(c)(4)(B))";
}
relation transfer_within_presumption_window(p: Individual, s: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the transfer was made after the date 1 year before the date of the first proposed-deficiency letter allowing IRS Independent Office of Appeals review (§6015(c)(4)(B)(ii)(I) presumption trigger)";
}
relation transfer_pursuant_to_divorce_decree(p: Individual, s: Individual, y: TaxableYear) kind empirical;
relation transfer_established_not_principally_tax_avoidance(p: Individual, s: Individual, y: TaxableYear) kind empirical;
relation transfer_presumed_tax_avoidance(p: Individual, s: Individual, y: TaxableYear) kind institutional;
@source(IRC_S6015_C, relation = formalizes, coverage = exact, quote = "shall be presumed to have as its principal purpose the avoidance of tax or payment of tax.")
rule S6015TransferPresumedTaxAvoidance defeasible {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    when transfer_within_presumption_window(p, s, y);
    then transfer_presumed_tax_avoidance(p, s, y);
    unless (transfer_pursuant_to_divorce_decree(p, s, y) or transfer_established_not_principally_tax_avoidance(p, s, y)) and transfer_within_presumption_window(p, s, y);
}
relation allocated_deficiency_increased_by_disqualified_asset(p: Individual, s: Individual, y: TaxableYear, base: Money, increased: Money) kind institutional;
@source(IRC_S6015_C, relation = formalizes, coverage = exact, quote = "the portion of the deficiency for which the individual electing the application of this subsection is liable (without regard to this paragraph) shall be increased by the value of any disqualified asset transferred to the individual.")
rule S6015cDisqualifiedAssetIncrease strict {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    for base: Money;
    for value: Money;
    when allocated_deficiency_amount(p, s, y, base) and disqualified_asset_transferred(p, s, y, value);
    then allocated_deficiency_increased_by_disqualified_asset(p, s, y, base, round(base + value, 2, "HALF_UP"));
}

// --- (d) Allocation of deficiency --------------------------------------------

relation net_items_allocable_to_individual(p: Individual, s: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the net amount of items taken into account in computing the deficiency and allocable to p under §6015(d)(3) (as if p had filed a separate return)";
}
relation net_items_total(p: Individual, s: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the net amount of ALL items taken into account in computing the deficiency";
}
relation deficiency_amount(p: Individual, s: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the assessed deficiency on the joint return (pending: assessment owns §6211 deficiency computation)";
}
@source(IRC_S6015_D, relation = formalizes, coverage = exact, quote = "The portion of any deficiency on a joint return allocated to an individual shall be the amount which bears the same ratio to such deficiency as the net amount of items taken into account in computing the deficiency and allocable to the individual under paragraph (3) bears to the net amount of all items taken into account in computing the deficiency.")
rule S6015dAllocationRatio strict {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    for own: Money;
    for total_items: Money;
    for deficiency: Money;
    when net_items_allocable_to_individual(p, s, y, own)
        and net_items_total(p, s, y, total_items)
        and deficiency_amount(p, s, y, deficiency);
    // One proportion, one rounding (TECH-GAPS G499, 26.09.2026).
    then allocated_deficiency_amount(p, s, y, div_round(deficiency * (own / 1.00 USD), total_items / 1.00 USD, 2, "HALF_UP"));
}

relation deficiency_from_disallowed_credit(p: Individual, s: Individual, y: TaxableYear, amount: Money) kind institutional;
relation deficiency_from_other_included_tax(p: Individual, s: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "a tax (other than §1 or §55 tax) required to be included with the joint return (§6015(d)(2)(B))";
}
relation deficiency_item_allocated_outside_ratio(p: Individual, s: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "a §6015(d)(2) item allocated directly to p and excluded from the ratio of (d)(1)";
}
@source(IRC_S6015_D, relation = formalizes, coverage = exact, quote = "such deficiency (or portion) shall be allocated to such individual. Any such item shall not be taken into account under paragraph (1).")
rule S6015dSeparateTreatmentCredit strict {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    for amt: Money;
    when deficiency_from_disallowed_credit(p, s, y, amt);
    then deficiency_item_allocated_outside_ratio(p, s, y, amt);
}
@source(IRC_S6015_D, relation = formalizes, coverage = partial, quote = "any tax (other than tax imposed by section 1 or 55) required to be included with the joint return")
rule S6015dSeparateTreatmentOtherTax strict {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    for amt: Money;
    when deficiency_from_other_included_tax(p, s, y, amt);
    then deficiency_item_allocated_outside_ratio(p, s, y, amt);
}

relation item_allocated_as_if_separate_returns(p: Individual, s: Individual, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en unofficial "§6015(d)(3)(A) baseline allocation — TECH_GAP G441: the general \"as if separate returns had been filed\" recomputation for an arbitrary item is not modeled item-by-item, only stated as the baseline rule";
}
relation item_gave_other_spouse_tax_benefit(p: Individual, s: Individual, y: TaxableYear, item: Integer) kind empirical;
relation item_allocated_to_other_spouse_by_benefit(p: Individual, s: Individual, y: TaxableYear, item: Integer) kind institutional;
@source(IRC_S6015_D, relation = formalizes, coverage = exact, quote = "an item otherwise allocable to an individual under subparagraph (A) shall be allocated to the other individual filing the joint return to the extent the item gave rise to a tax benefit on the joint return to the other individual.")
rule S6015dExceptionOtherSpouseBenefit defeasible {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    for item: Integer;
    when item_gave_other_spouse_tax_benefit(p, s, y, item);
    then item_allocated_to_other_spouse_by_benefit(p, s, y, item);
}
relation fraud_reallocation_established(p: Individual, s: Individual, y: TaxableYear, item: Integer) kind empirical {
    label en unofficial "the Secretary establishes that reallocating this item is appropriate due to fraud of one or both individuals (§6015(d)(3)(C))";
}
relation item_reallocated_for_fraud(p: Individual, s: Individual, y: TaxableYear, item: Integer) kind institutional;
rule S6015dExceptionFraud strict {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    for item: Integer;
    when fraud_reallocation_established(p, s, y, item);
    then item_reallocated_for_fraud(p, s, y, item);
}

relation deduction_disallowed_solely_for_separate_return(p: Individual, s: Individual, y: TaxableYear, item: Integer) kind empirical;
relation limitation_disregarded_for_allocation(p: Individual, s: Individual, y: TaxableYear, item: Integer) kind institutional {
    label en unofficial "the item is computed as if a joint return had been filed and then allocated appropriately (§6015(d)(4), and by (d)(4)'s last sentence, likewise for §86)";
}
@source(IRC_S6015_D, relation = formalizes, coverage = exact, quote = "If an item of deduction or credit is disallowed in its entirety solely because a separate return is filed, such disallowance shall be disregarded and the item shall be computed as if a joint return had been filed and then allocated between the spouses appropriately. A similar rule shall apply for purposes of section 86.")
rule S6015dLimitationsDisregarded strict {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    for item: Integer;
    when deduction_disallowed_solely_for_separate_return(p, s, y, item);
    then limitation_disregarded_for_allocation(p, s, y, item);
}

relation childs_liability_included_on_joint_return(p: Individual, s: Individual, y: TaxableYear, amount: Money) kind empirical;
relation childs_liability_allocated_appropriately(p: Individual, s: Individual, y: TaxableYear, amount: Money) kind institutional;
@source(IRC_S6015_D, relation = formalizes, coverage = exact, quote = "If the liability of a child of a taxpayer is included on a joint return, such liability shall be disregarded in computing the separate liability of either spouse and such liability shall be allocated appropriately between the spouses.")
rule S6015dChildsLiability strict {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    for amt: Money;
    when childs_liability_included_on_joint_return(p, s, y, amt);
    then childs_liability_allocated_appropriately(p, s, y, amt);
}

// --- (e) Petition for review by Tax Court -----------------------------------
//
// Judgment call: the statute's "after the earlier of (I)/(II), not later
// than 90 days after (I)" window is split into two alternative POWER
// conclusions (by-final-determination / by-six-months) with their own
// `window`, rather than one bundled institutional flag compared against an
// unbound "today" — the same technique stage 1 used for TCJA-vs-general
// alternative branches (see package.law). Absent a final determination the
// by-six-months branch is left open-ended, since the statute gives it no
// independent closing date of its own.

relation deficiency_asserted_against(p: Individual) kind empirical;
relation requests_equitable_relief_6015f(p: Individual, s: Individual, y: TaxableYear) kind empirical;
relation secretary_final_determination_mailed(p: Individual, s: Individual, y: TaxableYear, d: Date) kind empirical {
    label en unofficial "the date the Secretary mails, by certified or registered mail to the taxpayer's last known address, notice of the Secretary's final determination of relief (§6015(e)(1)(A)(i)(I))";
}
relation election_or_request_filed(p: Individual, s: Individual, y: TaxableYear, d: Date) kind empirical;
relation petition_filed(p: Individual, s: Individual, y: TaxableYear) kind empirical;
relation tax_court_jurisdiction_over_6015_relief(p: Individual, s: Individual, y: TaxableYear) kind institutional {
    label en unofficial "the Tax Court has jurisdiction to determine the appropriate §6015 relief available to p";
}
@source(IRC_S6015_E, relation = formalizes, coverage = partial, quote = "the date the Secretary mails, by certified or registered mail to the taxpayer's last known address, notice of the Secretary's final determination of relief available to the individual")
rule S6015ePetitionByFinalDetermination strict {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    for d: Date;
    when (elects_6015b(p, s, y) or elects_6015c(p, s, y) or requests_equitable_relief_6015f(p, s, y))
        and deficiency_asserted_against(p)
        and secretary_final_determination_mailed(p, s, y, d)
        and petition_filed(p, s, y);
    then power S6015PetitionTaxCourtByDetermination {
        holder p;
        over Secretary;
        exercise petition_filed(p, s, y);
        valid_when deficiency_asserted_against(p);
        effect create(tax_court_jurisdiction_over_6015_relief(p, s, y));
        window [d, add_calendar_period(d, 90 calendar_day)];
    };
}
@source(IRC_S6015_E, relation = formalizes, coverage = partial, quote = "the date which is 6 months after the date such election is filed or request is made with the Secretary")
rule S6015ePetitionBySixMonths strict {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    for filed: Date;
    when (elects_6015b(p, s, y) or elects_6015c(p, s, y) or requests_equitable_relief_6015f(p, s, y))
        and deficiency_asserted_against(p)
        and election_or_request_filed(p, s, y, filed)
        and petition_filed(p, s, y);
    then power S6015PetitionTaxCourtBySixMonths {
        holder p;
        over Secretary;
        exercise petition_filed(p, s, y);
        valid_when deficiency_asserted_against(p);
        effect create(tax_court_jurisdiction_over_6015_relief(p, s, y));
        window [add_calendar_period(filed, 6 calendar_month), infinity];
    };
}

relation levy_or_court_proceeding(p: Individual) kind institutional;
relation tax_court_decision_final(p: Individual, s: Individual, y: TaxableYear) kind empirical;

// WIRE-5 (DECISION Д-19): the two readable exports of the §6015 request/grant pair. `innocent_spouse_relief`
// (above) is the GRANT (§6015(b) relief in effect); the REQUEST — an election under (b) or (c), or a request
// for equitable relief under (f) — is a different fact that other owners read (§7345(b)(2)(B)(ii), §7421(a)
// through §6015(e)(1)(B)). Neither is derived from the other.
pub relation relief_requested_6015(p: Individual, s: Individual, y: TaxableYear) kind institutional {
    label en unofficial "p has made an election under §6015(b) or (c), or has requested equitable relief under §6015(f), with respect to s's joint return for the year";
}
@source(IRC_S6015_E, relation = formalizes, coverage = partial, quote = "An individual who elects the application of subsection (b) or (c) or who requests equitable relief under subsection (f)")
rule S6015ReliefRequestedFlag defeasible {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    when elects_6015b(p, s, y) or elects_6015c(p, s, y) or requests_equitable_relief_6015f(p, s, y);
    then relief_requested_6015(p, s, y);
}
pub relation collection_bar_6015e_in_force(p: Individual, s: Individual, y: TaxableYear) kind institutional {
    label en unofficial "the §6015(e)(1)(B) prohibition on levy or court proceeding for the assessment to which the request relates is in force (the request is made and the Tax Court decision is not yet final)";
}
@source(IRC_S6015_E, relation = formalizes, coverage = exact, quote = "no levy or proceeding in court shall be made, begun, or prosecuted against the individual making an election under subsection (b) or (c) or requesting equitable relief under subsection (f) for collection of any assessment to which such election or request relates until the close of the 90th day referred to in subparagraph (A)(ii)")
rule S6015eCollectionBarInForceFlag defeasible {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    when relief_requested_6015(p, s, y);
    then collection_bar_6015e_in_force(p, s, y);
    unless tax_court_decision_final(p, s, y) and relief_requested_6015(p, s, y);
}
@source(IRC_S6015_E, relation = formalizes, coverage = exact, quote = "no levy or proceeding in court shall be made, begun, or prosecuted against the individual making an election under subsection (b) or (c) or requesting equitable relief under subsection (f) for collection of any assessment to which such election or request relates until the close of the 90th day referred to in subparagraph (A)(ii)")
rule S6015eCollectionRestrictionImmunity defeasible {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    when (elects_6015b(p, s, y) or elects_6015c(p, s, y) or requests_equitable_relief_6015f(p, s, y));
    then immunity S6015eCollectionRestriction {
        holder p;
        protected_effect levy_or_court_proceeding(p);
        window [-infinity, infinity];
    };
    unless tax_court_decision_final(p, s, y) and (elects_6015b(p, s, y) or elects_6015c(p, s, y) or requests_equitable_relief_6015f(p, s, y));
}

relation limitations_period_suspended_6502(p: Individual, s: Individual, y: TaxableYear) kind institutional {
    label en unofficial "the §6502 collection limitations period is suspended for the §6015(e)(2) period (pending: assessment/payment-refunds-interest owns §6502 itself)";
}
@source(IRC_S6015_E, relation = formalizes, coverage = exact, quote = "The running of the period of limitations in section 6502 on the collection of the assessment to which the petition under paragraph (1)(A) relates shall be suspended")
rule S6015eLimitationsSuspended strict {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    when tax_court_jurisdiction_over_6015_relief(p, s, y);
    then limitations_period_suspended_6502(p, s, y);
}

relation refund_suit_begun_by_either_spouse(p: Individual, s: Individual, y: TaxableYear) kind empirical;
relation tax_court_loses_jurisdiction_to_refund_court(p: Individual, s: Individual, y: TaxableYear) kind institutional;
@source(IRC_S6015_E, relation = formalizes, coverage = exact, quote = "the Tax Court shall lose jurisdiction of the individual's action under this section to whatever extent jurisdiction is acquired by the district court or the United States Court of Federal Claims over the taxable years that are the subject of the suit for refund")
rule S6015eRefundSuitJurisdictionTransfer strict {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    when refund_suit_begun_by_either_spouse(p, s, y) and tax_court_jurisdiction_over_6015_relief(p, s, y);
    then tax_court_loses_jurisdiction_to_refund_court(p, s, y);
}

relation waives_collection_restriction_6015e(p: Individual, s: Individual, y: TaxableYear) kind empirical;
relation collection_restriction_waived(p: Individual, s: Individual, y: TaxableYear) kind institutional;
@source(IRC_S6015_E, relation = formalizes, coverage = exact, quote = "An individual who elects the application of subsection (b) or (c) or who requests equitable relief under subsection (f) (and who agrees with the Secretary's determination of relief) may waive in writing at any time the restrictions in paragraph (1)(B) with respect to collection of the outstanding assessment")
rule S6015eWaiverPower strict {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    when waives_collection_restriction_6015e(p, s, y);
    then power S6015eWaiveCollectionRestriction {
        holder p;
        over Secretary;
        exercise waives_collection_restriction_6015e(p, s, y);
        valid_when tax_court_jurisdiction_over_6015_relief(p, s, y);
        effect create(collection_restriction_waived(p, s, y));
    };
}

// --- (f) Equitable relief ----------------------------------------------------

external judgment relation inequitable_to_hold_liable_6015f(p: Individual, y: TaxableYear) {
    authority Secretary;
    label en official "taking into account all the facts and circumstances, it is inequitable to hold the individual liable for any unpaid tax or any deficiency (or any portion of either)";
}
relation unpaid_tax_or_deficiency_amount(p: Individual, y: TaxableYear, amount: Money) kind institutional;
relation relief_unavailable_under_b_or_c(p: Individual, y: TaxableYear) kind institutional {
    label en unofficial "relief is not available to the individual under §6015(b) or (c) for this liability";
}
relation within_limitations_period_6502(p: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the unpaid portion: request is made before expiration of the §6502 limitations period (§6015(f)(2)(A))";
}
relation within_refund_claim_period(p: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the paid portion: request is made during the period a timely refund/credit claim could be submitted (§6015(f)(2)(B))";
}
relation s6015f_request_timely(p: Individual, y: TaxableYear) kind institutional {
    label en unofficial "bundles §6015(f)(2)(A)/(B) alternative timing branches into one atom for valid_when";
}
@source(IRC_S6015_F, relation = formalizes, coverage = exact, quote = "A request for equitable relief under this subsection may be made with respect to any portion of any liability that")
rule S6015fRequestTimely defeasible {
    for p: Individual;
    for y: TaxableYear;
    when within_limitations_period_6502(p, y) or within_refund_claim_period(p, y);
    then s6015f_request_timely(p, y);
}
relation s6015f_valid_conditions(p: Individual, y: TaxableYear) kind institutional {
    label en unofficial "bundles §6015(f)(1)(A)-(B) plus the (2) timing branch into one atom for valid_when";
}
rule S6015fValidConditions defeasible {
    for p: Individual;
    for y: TaxableYear;
    when inequitable_to_hold_liable_6015f(p, y)
        and relief_unavailable_under_b_or_c(p, y)
        and s6015f_request_timely(p, y);
    then s6015f_valid_conditions(p, y);
}
relation equitable_relief_6015f_in_effect(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "p is relieved of the unpaid tax or deficiency (or portion) under §6015(f)";
}
@source(IRC_S6015_F, relation = formalizes, coverage = exact, quote = "the Secretary may relieve such individual of such liability.")
rule S6015fEquitableReliefPower strict {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    for amt: Money;
    when requests_equitable_relief_6015f(p, s, y) and unpaid_tax_or_deficiency_amount(p, y, amt);
    then power S6015fEquitableRelief {
        holder Secretary;
        over p;
        exercise requests_equitable_relief_6015f(p, s, y);
        valid_when s6015f_valid_conditions(p, y);
        effect create(equitable_relief_6015f_in_effect(p, y, amt));
    };
}

// --- (g) Credits and refunds --------------------------------------------------
//
// Judgment call: (g)(1)'s general allowance is stated as three alternative
// rules (one per relief channel) rather than one rule OR-ing predicates of
// different arity, following the same alternative-branch technique used in
// (e) above.

relation credit_or_refund_allowed_6015(p: Individual, s: Individual, y: TaxableYear) kind institutional {
    label en unofficial "credit or refund is allowed to the extent attributable to the application of §6015";
}
relation prior_court_decision_final_same_year(p: Individual, s: Individual, y: TaxableYear) kind empirical {
    label en unofficial "a decision of a court in a prior proceeding for the same taxable year has become final (res judicata, §6015(g)(2)) — pending: judicial-proceedings/assessment owns the prior-decision fact";
}
relation participated_meaningfully_in_prior_proceeding(p: Individual, s: Individual, y: TaxableYear) kind empirical;
@source(IRC_S6015_G, relation = formalizes, coverage = partial, quote = "notwithstanding any other law or rule of law (other than section 6511, 6512(b), 7121, or 7122), credit or refund shall be allowed or made to the extent attributable to the application of this section.")
rule S6015gCreditForInnocentSpouseRelief defeasible {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    when innocent_spouse_relief(p, s, y);
    then credit_or_refund_allowed_6015(p, s, y);
    unless prior_court_decision_final_same_year(p, s, y) and not_known(participated_meaningfully_in_prior_proceeding(p, s, y)) and innocent_spouse_relief(p, s, y);
}
rule S6015gCreditForEquitableRelief defeasible {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    for amt: Money;
    when equitable_relief_6015f_in_effect(p, y, amt) and joint_return_in_effect(p, s, y);
    then credit_or_refund_allowed_6015(p, s, y);
    unless prior_court_decision_final_same_year(p, s, y) and not_known(participated_meaningfully_in_prior_proceeding(p, s, y)) and joint_return_in_effect(p, s, y);
}
@source(IRC_S6015_G, relation = formalizes, coverage = exact, quote = "No credit or refund shall be allowed as a result of an election under subsection (c).")
rule S6015gNoCreditForSeparationOfLiability strict {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    for alloc: Money;
    when separation_of_liability_in_effect(p, s, y, alloc);
    then credit_or_refund_barred_6015c(p, s, y);
}
relation credit_or_refund_barred_6015c(p: Individual, s: Individual, y: TaxableYear) kind institutional;

// --- (h) Regulations — pure delegation, no self-executing text beyond
// (b)-(g) above. NON_NORMATIVE.
relation s6015_h_regulations_delegation(unused: Boolean) kind institutional {
    label en unofficial "§6015(h) delegates further allocation-method and notice-and-participation regulations to the Secretary; no self-executing rule beyond (d)(3)/(e)(4) already modeled (NON_NORMATIVE)";
}
