// §6001 (records) and §6011 (general requirement of return, statement, or
// list). See package.law for the module map and the pending institutional
// dependency contracts this file's rules read.
//
// JUDGMENT CALLS AND GAPS (see report):
//  - §6001's "in the judgment of the Secretary it is necessary" is a
//    DECISION-0194 evaluative element: channeled through an
//    `external judgment relation` with authority Secretary, not a flat
//    case fact.
//  - §6001's third sentence (charged-tip recordkeeping limited to three
//    named items, §6053(a)/(c)) states no independent duty of its own; it
//    narrows an employer's §6001 recordkeeping duty by reference to
//    §6053 (owned by `information-reporting`, an existing pending
//    cross-reference) — NON_NORMATIVE here, no separate rule.
//  - §6011(c) (DISC/former-DISC/former-FSC returns) reaches an entity
//    classification (`is_disc`) this package does not own and stage 1 does
//    not need beyond §6072(b)'s cross-reference to §6011(c)(2)'s due date;
//    `is_disc`/`is_disc_return` are declared as pending institutional facts
//    only so `05-timing-and-place.law` has something to condition on.
//  - §6011(e)(2)(B) ("take into account... the ability of the taxpayer to
//    comply at reasonable cost") is an evaluative "reasonable cost"
//    standard directed at the Secretary's OWN rulemaking, not at a
//    litigable fact about a specific return — modeled as a duty on the
//    Secretary's rulemaking process (`maintenance`), not as a per-taxpayer
//    condition, because the statute does not give a per-return test.
//  - §6011(e)(6) (duplicate paragraph numbering in the pinned text, both
//    labeled "(6)"): the partnership->100-partners e-filing mandate is
//    modeled below; the deferred-compensation per-plan counting rule
//    (crediting each plan reported on a §6058 return as a separate return)
//    is `information-reporting`/`deferred-compensation`'s own counting
//    mechanism over a return this package does not own —
//    EXTERNAL_DEPENDENCY, no rule stated here.
//  - §6011(f) (promoting e-filing, paying incentives) grants the Secretary
//    administrative discretion with no legal effect on any party's
//    position — NON_NORMATIVE, not a power (nothing is created, changed,
//    or extinguished by exercising it).
//  - §6011(i) is a pure cross-reference to subparts B and C (§§6012 et
//    seq., estate/gift return sections) — NON_NORMATIVE.

language "law.core" version "0.2";
package us.irc.returns version "0.1.1";
namespace "urn:us:irc:returns:clir";

use self::{
    IRC_S6001,
    IRC_S6011_A,
    IRC_S6011_B,
    IRC_S6011_C,
    IRC_S6011_D,
    IRC_S6011_E,
    IRC_S6011_G,
    IRC_S6011_H,
    Individual,
    Organ,
    Partnership,
    Person,
    Return,
    Secretary,
    TaxableYear,
};

// ============================================================================
// §6001 — Notice or regulations requiring records, statements, special returns
// ============================================================================

relation liable_for_any_tax_or_collection(p: Person) kind institutional {
    label en unofficial "the person is liable for a tax imposed by Title 26, or with respect to the collection of such a tax";
}
@source(IRC_S6001, relation = formalizes, coverage = partial, quote = "Every person liable for any tax imposed by this title, or for the collection thereof")
rule S6001LiableFromCoreLiability strict {
    for p: Person;
    for y: TaxableYear;
    for k: us.irc.core::TaxKind;
    for amt: Money;
    when us.irc.core::liability(p, y, k, amt);
    then liable_for_any_tax_or_collection(p);
}

relation keeps_records_statements_and_returns_as_prescribed(p: Person) kind empirical {
    label en unofficial "the person keeps such records, renders such statements, makes such returns, and complies with such rules and regulations as the Secretary has prescribed";
}
@source(IRC_S6001, relation = formalizes, coverage = exact, quote = "Every person liable for any tax imposed by this title, or for the collection thereof, shall keep such records, render such statements, make such returns, and comply with such rules and regulations as the Secretary may from time to time prescribe.")
rule S6001KeepRecords defeasible {
    for p: Person;
    when liable_for_any_tax_or_collection(p);
    then duty KeepRecordsStatementsAndReturns {
        bearer p;
        beneficiary Secretary;
        goal maintenance {
            condition keeps_records_statements_and_returns_as_prescribed(p);
            window [-infinity, infinity];
        }
    };
}

// §6001's second sentence: the Secretary's own power to demand records from
// a SPECIFIC person by notice or regulation, conditioned on the Secretary's
// judgment that it is necessary (DECISION-0194 evaluative channel).
external judgment relation records_notice_necessary(p: Person) {
    authority Secretary;
    label en official "it is necessary, in the judgment of the Secretary, to require the person to make such returns, render such statements, or keep such records";
}
relation secretary_serves_records_notice(p: Person) kind empirical {
    label en unofficial "the Secretary serves notice upon the person (or issues regulations) requiring returns, statements, or records to show whether the person is liable for tax";
}
relation required_by_secretary_notice(p: Person) kind institutional {
    label en unofficial "the person is required, by the Secretary's notice or regulation, to make returns, render statements, or keep records under §6001";
}
@source(IRC_S6001, relation = formalizes, coverage = exact, quote = "Whenever in the judgment of the Secretary it is necessary, he may require any person, by notice served upon such person or by regulations, to make such returns, render such statements, or keep such records, as the Secretary deems sufficient to show whether or not such person is liable for tax under this title.")
rule S6001SecretaryMayRequireByNotice strict {
    for p: Person;
    when secretary_serves_records_notice(p);
    then power S6001RequireByNoticePower {
        holder Secretary;
        over p;
        exercise secretary_serves_records_notice(p);
        valid_when records_notice_necessary(p);
        effect create(required_by_secretary_notice(p));
    };
}

// ============================================================================
// §6011 — General requirement of return, statement, or list
// ============================================================================

// --- (a) General rule --------------------------------------------------------

relation return_required_by_regulation(k: us.irc.core::TaxKind) kind institutional {
    label en unofficial "the Secretary's regulations require a return or statement with respect to this tax kind under §6011(a) (the regulation itself is outside Title 26's text and this package's scope)";
}
relation makes_return_or_statement(p: Person, k: us.irc.core::TaxKind) kind empirical {
    label en unofficial "the person makes a return or statement according to the forms and regulations prescribed by the Secretary";
}
@source(IRC_S6011_A, relation = formalizes, coverage = exact, quote = "When required by regulations prescribed by the Secretary any person made liable for any tax imposed by this title, or with respect to the collection thereof, shall make a return or statement according to the forms and regulations prescribed by the Secretary.")
rule S6011MakeReturnOrStatement defeasible {
    for p: Person;
    for y: TaxableYear;
    for k: us.irc.core::TaxKind;
    for amt: Money;
    when us.irc.core::liability(p, y, k, amt) and return_required_by_regulation(k);
    then duty MakeReturnOrStatement {
        bearer p;
        beneficiary Secretary;
        goal achievement {
            condition makes_return_or_statement(p, k);
            window [-infinity, infinity];
        }
    };
}

relation includes_required_information(p: Person, k: us.irc.core::TaxKind) kind empirical {
    label en unofficial "the return or statement includes the information required by the applicable forms or regulations";
}
@source(IRC_S6011_A, relation = formalizes, coverage = exact, quote = "Every person required to make a return or statement shall include therein the information required by such forms or regulations.")
rule S6011IncludeRequiredInformation defeasible {
    for p: Person;
    for k: us.irc.core::TaxKind;
    when makes_return_or_statement(p, k);
    then duty IncludeRequiredInformationOnReturn {
        bearer p;
        beneficiary Secretary;
        goal achievement {
            condition includes_required_information(p, k);
            window [-infinity, infinity];
        }
    };
}

// --- (b) Identification of taxpayer ------------------------------------------

relation subject_to_chapter21_or_24_tax(p: Person) kind institutional {
    label en unofficial "the person is subject to the taxes imposed by chapter 21 (FICA) or chapter 24 (wage withholding)";
}
@source(IRC_S6011_B, relation = formalizes, coverage = partial, quote = "persons subject to the taxes imposed by chapter 21 or chapter 24")
rule S6011SubjectToChapter21Or24 strict {
    for p: Person;
    for y: TaxableYear;
    for amt: Money;
    when us.irc.core::liability(p, y, us.irc.core::FicaCh21, amt);
    then subject_to_chapter21_or_24_tax(p);
}
@source(IRC_S6011_B, relation = formalizes, coverage = partial, quote = "persons subject to the taxes imposed by chapter 21 or chapter 24")
rule S6011SubjectToChapter24 strict {
    for p: Person;
    for y: TaxableYear;
    for amt: Money;
    when us.irc.core::liability(p, y, us.irc.core::WithholdingWagesCh24, amt);
    then subject_to_chapter21_or_24_tax(p);
}

external judgment relation identification_info_necessary_or_helpful(p: Person) {
    authority Secretary;
    label en official "the identification information is necessary or helpful in securing proper identification of the person";
}
relation secretary_requires_identification_info(p: Person) kind empirical;
relation identification_info_required(p: Person) kind institutional;
@source(IRC_S6011_B, relation = formalizes, coverage = exact, quote = "The Secretary is authorized to require such information with respect to persons subject to the taxes imposed by chapter 21 or chapter 24 as is necessary or helpful in securing proper identification of such persons.")
rule S6011RequireIdentificationInfo strict {
    for p: Person;
    when secretary_requires_identification_info(p) and subject_to_chapter21_or_24_tax(p);
    then power S6011RequireIdentificationInfoPower {
        holder Secretary;
        over p;
        exercise secretary_requires_identification_info(p);
        valid_when identification_info_necessary_or_helpful(p);
        effect create(identification_info_required(p));
    };
}

// --- (c) Returns of DISCs and former DISCs and former FSC's -----------------
// Entity classification outside stage-1 scope; declared only so §6072(b)'s
// due-date rule for DISC returns (in 05-timing-and-place.law) has a fact to
// condition on. `is_disc` is pending — owner not yet assigned among
// `special-entities`/`international` (subchapter T is not in this
// package's OWNERSHIP-RULES.json entry); DEPENDENCIES.json already carries
// the general §6011(c) heuristic cross-references. (c)(1) (records/
// information to shareholders and the Secretary) is EXTERNAL_DEPENDENCY on
// that same classification and on §922's pre-repeal definitions.

relation is_disc(p: Person) kind institutional {
    label en unofficial "the person is a DISC (or former DISC / former FSC as defined in former §922) for §6011(c) purposes — classification test outside this package's scope";
}
relation disc_files_return(p: Person, y: TaxableYear) kind empirical;
relation disc_return_required(p: Person, y: TaxableYear) kind institutional {
    label en unofficial "the person, being a DISC, is required to file a §6011(c)(2) return for the taxable year";
}
@source(IRC_S6011_C, relation = formalizes, coverage = exact, quote = "A DISC shall file for the taxable year such returns as may be prescribed by the Secretary by forms or regulations.")
rule S6011DiscReturnRequired strict {
    for p: Person;
    for y: TaxableYear;
    when is_disc(p) and disc_files_return(p, y);
    then disc_return_required(p, y);
}

// --- (d) Authority to require information concerning §912 allowances -------

relation receives_section_912_allowances(p: Individual, y: TaxableYear) kind institutional {
    label en unofficial "the individual receives allowances excluded from gross income under §912 for the taxable year (pending: income_individual/definitions — §912 is not this package's norm)";
}
relation secretary_requires_912_allowance_info(p: Individual, y: TaxableYear) kind empirical;
relation section_912_allowance_info_required(p: Individual, y: TaxableYear) kind institutional;
@source(IRC_S6011_D, relation = formalizes, coverage = exact, quote = "The Secretary may by regulations require any individual who receives allowances which are excluded from gross income under section 912 for any taxable year to include on his return of the taxes imposed by subtitle A for such taxable year such information with respect to the amount and type of such allowances as the Secretary determines to be appropriate.")
rule S6011RequireSection912AllowanceInfo strict {
    for p: Individual;
    for y: TaxableYear;
    when secretary_requires_912_allowance_info(p, y);
    then power S6011RequireSection912AllowanceInfoPower {
        holder Secretary;
        over p;
        exercise secretary_requires_912_allowance_info(p, y);
        valid_when receives_section_912_allowances(p, y);
        effect create(section_912_allowance_info_required(p, y));
    };
}

// --- (e) Regulations requiring returns on magnetic media / e-filing --------

relation prescribes_magnetic_media_standards(committee: Organ) kind empirical;
@source(IRC_S6011_E, relation = formalizes, coverage = partial, quote = "The Secretary shall prescribe regulations providing standards for determining which returns must be filed on magnetic media or in other machine-readable form.")
rule S6011PrescribeMagneticMediaStandards strict {
    when true;
    then duty PrescribeMagneticMediaStandards {
        bearer Secretary;
        goal maintenance {
            condition prescribes_magnetic_media_standards(Secretary);
            window [-infinity, infinity];
        }
    };
}

relation is_specified_tax_return_preparer(prep: Person, cy: Integer) kind institutional {
    label en unofficial "the tax return preparer is a \"specified tax return preparer\" for the calendar year (§6011(e)(3)(B)): does not reasonably expect to file 10 or fewer individual income tax returns during the year";
}
relation reasonably_expects_ten_or_fewer_returns(prep: Person, cy: Integer) kind empirical {
    label en unofficial "the tax return preparer reasonably expects to file 10 or fewer individual income tax returns during the calendar year";
}
relation is_tax_return_preparer(prep: Person, cy: Integer) kind empirical {
    label en unofficial "the person is a tax return preparer active in the calendar year (positive anchor for the §6011(e)(3)(B) classification)";
}
@source(IRC_S6011_E, relation = formalizes, coverage = exact, quote = "the term \"specified tax return preparer\" means, with respect to any calendar year, any tax return preparer unless such preparer reasonably expects to file 10 or fewer individual income tax returns during such calendar year")
rule S6011SpecifiedTaxReturnPreparer strict {
    for prep: Person;
    for cy: Integer;
    when is_tax_return_preparer(prep, cy) and not_known(reasonably_expects_ten_or_fewer_returns(prep, cy));
    then is_specified_tax_return_preparer(prep, cy);
}

relation individual_income_tax_return(r: Return) kind institutional {
    label en unofficial "the return is a return of subtitle A tax on individuals, estates, or trusts (§6011(e)(3)(C))";
}
relation prepared_by(r: Return, prep: Person) kind empirical;
relation filed_electronically(r: Return) kind empirical;
relation cannot_meet_efiling_no_internet_access(prep: Person) kind empirical {
    label en unofficial "the preparer cannot meet the e-filing requirement because the preparer is located in a geographic area without internet service other than dial-up or satellite (§6011(e)(3)(D))";
}
relation preparer_efiling_mandate_applies(prep: Person, cy: Integer) kind institutional {
    label en unofficial "the specified-preparer e-filing mandate of §6011(e)(3)(A) applies to the preparer for the calendar year, net of the (D) no-internet-access waiver";
}
@source(IRC_S6011_E, relation = formalizes, coverage = partial, quote = "such tax return preparer is a specified tax return preparer for the calendar year during which such return is filed")
rule S6011PreparerEfilingMandateApplies defeasible {
    for prep: Person;
    for cy: Integer;
    when is_specified_tax_return_preparer(prep, cy);
    then preparer_efiling_mandate_applies(prep, cy);
    unless cannot_meet_efiling_no_internet_access(prep) and is_tax_return_preparer(prep, cy);
}
@source(IRC_S6011_E, relation = formalizes, coverage = partial, quote = "The Secretary shall require that any individual income tax return prepared by a tax return preparer be filed on magnetic media if—")
rule S6011MandatoryEfilingBySpecifiedPreparer strict {
    for r: Return;
    for prep: Person;
    for cy: Integer;
    when individual_income_tax_return(r) and prepared_by(r, prep) and preparer_efiling_mandate_applies(prep, cy);
    then duty FileIndividualReturnElectronically {
        bearer prep;
        beneficiary Secretary;
        goal achievement {
            condition filed_electronically(r);
            window [-infinity, infinity];
        }
    };
}

pub relation electronic_filing_required(r: Return, prep: Person) kind institutional {
    label en unofficial "the §6011(e)(3) specified-preparer electronic (magnetic media) filing mandate applies to this return (umbrella flag over the individual-income-tax-return branch of §6011(e))";
}
@source(IRC_S6011_E, relation = formalizes, coverage = partial, quote = "The Secretary shall require that any individual income tax return prepared by a tax return preparer be filed on magnetic media if—")
rule S6011ElectronicFilingRequiredFlag defeasible {
    for r: Return;
    for prep: Person;
    for cy: Integer;
    when individual_income_tax_return(r) and prepared_by(r, prep) and preparer_efiling_mandate_applies(prep, cy);
    then electronic_filing_required(r, prep);
}

relation applicable_number_of_returns(cy: Integer, n: Integer) kind institutional {
    label en unofficial "the §6011(e)(2)(A)/(5) \"applicable number\" of returns for the calendar year, below which a NON-PARTNERSHIP person is not required to file on magnetic media";
}
relation calendar_year_in_question(cy: Integer) kind empirical {
    label en unofficial "the calendar year whose §6011(e)(5) applicable number is at issue in the case (positive anchor; §190 range restriction)";
}
@source(IRC_S6011_E, relation = formalizes, coverage = exact, quote = "except as provided in subparagraph (B), in the case of calendar years before 2021, 250,")
rule S6011ApplicableNumberBefore2021 defeasible {
    for cy: Integer;
    when calendar_year_in_question(cy) and cy < 2021;
    then applicable_number_of_returns(cy, 250);
}
@source(IRC_S6011_E, relation = formalizes, coverage = exact, quote = "in the case of calendar year 2021, 100, and")
rule S6011ApplicableNumber2021 defeasible {
    when true;
    then applicable_number_of_returns(2021, 100);
}
@source(IRC_S6011_E, relation = formalizes, coverage = exact, quote = "in the case of calendar years after 2021, 10.")
rule S6011ApplicableNumberAfter2021 defeasible {
    for cy: Integer;
    when calendar_year_in_question(cy) and cy > 2021;
    then applicable_number_of_returns(cy, 10);
}

// The partnership-specific figures for 2018-2021 (§6011(e)(5)(B)) live in
// their OWN relation, keyed the same way, rather than overriding
// `applicable_number_of_returns` by priority: both relations are heads of
// the SAME predicate/polarity for the general and partnership cases, and
// §107/§116 priority cannot arbitrate between two co-holding positive
// conclusions of one predicate (LDC-E2142) — only a guard or a distinct
// head resolves it, and a distinct head also matches the text's own
// structure (a special sub-schedule for partnerships, not an amendment to
// the general one).
relation applicable_number_of_returns_partnership(cy: Integer, n: Integer) kind institutional {
    label en unofficial "the §6011(e)(5)(B) special \"applicable number\" for a PARTNERSHIP, for calendar years 2018-2021";
}
relation files_returns_as_partnership(p: Partnership) kind institutional;
@source(IRC_S6011_E, relation = formalizes, coverage = partial, quote = "In the case of a partnership, for any calendar year before 2022, the applicable number shall be—")
rule S6011ApplicableNumberPartnership2018 strict {
    when true;
    then applicable_number_of_returns_partnership(2018, 200);
}
@source(IRC_S6011_E, relation = formalizes, coverage = exact, quote = "(ii) in the case of calendar year 2019, 150,")
rule S6011ApplicableNumberPartnership2019 strict {
    when true;
    then applicable_number_of_returns_partnership(2019, 150);
}
@source(IRC_S6011_E, relation = formalizes, coverage = exact, quote = "(iii) in the case of calendar year 2020, 100, and")
rule S6011ApplicableNumberPartnership2020 strict {
    when true;
    then applicable_number_of_returns_partnership(2020, 100);
}
@source(IRC_S6011_E, relation = formalizes, coverage = exact, quote = "(iv) in the case of calendar year 2021, 50.")
rule S6011ApplicableNumberPartnership2021 strict {
    when true;
    then applicable_number_of_returns_partnership(2021, 50);
}

relation has_more_than_100_partners(p: Partnership) kind empirical;
relation partnership_return_filed_electronically(p: Partnership) kind empirical;
@source(IRC_S6011_E, relation = formalizes, coverage = exact, quote = "Notwithstanding paragraph (2)(A), the Secretary shall require partnerships having more than 100 partners to file returns on magnetic media.")
rule S6011PartnershipOver100PartnersMustEfile defeasible {
    for p: Partnership;
    when has_more_than_100_partners(p);
    then duty PartnershipOver100PartnersFileElectronically {
        bearer p;
        beneficiary Secretary;
        goal achievement {
            condition partnership_return_filed_electronically(p);
            window [-infinity, infinity];
        }
    };
}

// --- (g) Disclosure of reportable transaction to tax-exempt entity ---------
// Pending: `prohibited_tax_shelter_transaction`/`tax_exempt_entity` are
// §4965's own classification tests (owner package not confirmed among
// `excise-entities`/`exempt-organizations`); declared here as typed
// institutional dependency contracts.

entity ReportableTransaction { label en unofficial "a transaction that may be a prohibited tax shelter transaction under §4965(e)(1)"; }
relation prohibited_tax_shelter_transaction(t: ReportableTransaction) kind institutional {
    label en unofficial "the transaction is a prohibited tax shelter transaction as defined in §4965(e)(1) (not this package's norm)";
}
relation tax_exempt_entity(o: Organ) kind institutional {
    label en unofficial "the organ is a tax-exempt entity as defined in §4965(c) (not this package's norm)";
}
relation taxable_party_to(p: Person, t: ReportableTransaction) kind empirical;
relation tax_exempt_party_to(o: Organ, t: ReportableTransaction) kind empirical;
relation discloses_prohibited_shelter_status(p: Person, o: Organ, t: ReportableTransaction) kind empirical;
@source(IRC_S6011_G, relation = formalizes, coverage = exact, quote = "Any taxable party to a prohibited tax shelter transaction (as defined in section 4965(e)(1)) shall by statement disclose to any tax-exempt entity (as defined in section 4965(c)) which is a party to such transaction that such transaction is such a prohibited tax shelter transaction.")
rule S6011DiscloseShelterStatusToTaxExemptEntity defeasible {
    for p: Person;
    for o: Organ;
    for t: ReportableTransaction;
    when taxable_party_to(p, t) and tax_exempt_party_to(o, t) and prohibited_tax_shelter_transaction(t) and tax_exempt_entity(o);
    then duty DiscloseShelterStatusToTaxExemptEntity {
        bearer p;
        beneficiary o;
        goal achievement {
            condition discloses_prohibited_shelter_status(p, o, t);
            window [-infinity, infinity];
        }
    };
}

// --- (h) Mandatory e-filing of unrelated business income tax return --------
// Pending: `subject_to_section_511_tax` is `exempt-organizations`' own
// classification test.

relation subject_to_section_511_tax(o: Organ, y: TaxableYear) kind institutional {
    label en unofficial "the organization is subject to the tax imposed by §511 (unrelated business income tax) for the taxable year (not this package's norm)";
}
relation ubit_return_filed_electronically(o: Organ, y: TaxableYear) kind empirical;
@source(IRC_S6011_H, relation = formalizes, coverage = exact, quote = "Any organization required to file an annual return under this section which relates to any tax imposed by section 511 shall file such return in electronic form.")
rule S6011MandatoryEfilingOfUbitReturn defeasible {
    for o: Organ;
    for y: TaxableYear;
    when subject_to_section_511_tax(o, y);
    then duty FileUbitReturnElectronically {
        bearer o;
        beneficiary Secretary;
        goal achievement {
            condition ubit_return_filed_electronically(o, y);
            window [-infinity, infinity];
        }
    };
}
