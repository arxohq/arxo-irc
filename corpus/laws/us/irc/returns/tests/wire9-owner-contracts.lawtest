            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.core::begins(entity_ref("urn:test:w9ret:s2#y"), @2024-01-01) { origin case_input; }
    }
    evaluate truth(standard_deduction_is_zero(entity_ref("urn:test:w9ret:s2#p"), entity_ref("urn:test:w9ret:s2#y")));
    expect truth_status == FALSE_ONLY;
}

test "W9-RET-06-FOREIGN-CORPORATION-TAXED-UNDER-881-ON-A-DAY-OF-THE-YEAR" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.corporations::foreign_corporation_taxed_under_881_1563b2c(entity_ref("urn:test:w9ret:f1#c"), @2024-06-30) { origin case_input; }
        assert "f1": us.irc.core::begins(entity_ref("urn:test:w9ret:f1#y"), @2024-01-01) { origin case_input; }
        assert "f2": us.irc.core::ends(entity_ref("urn:test:w9ret:f1#y"), @2024-12-31) { origin case_input; }
    }
    evaluate truth(foreign_corporation_subject_to_881(entity_ref("urn:test:w9ret:f1#c"), entity_ref("urn:test:w9ret:f1#y")));
    expect truth_status == TRUE_ONLY;
}

test "W9-RET-07-FOREIGN-CORPORATION-DAY-OUTSIDE-THE-YEAR-DOES-NOT-COUNT" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.corporations::foreign_corporation_taxed_under_881_1563b2c(entity_ref("urn:test:w9ret:f2#c"), @2023-06-30) { origin case_input; }
        assert "f1": us.irc.core::begins(entity_ref("urn:test:w9ret:f2#y"), @2024-01-01) { origin case_input; }
        assert "f2": us.irc.core::ends(entity_ref("urn:test:w9ret:f2#y"), @2024-12-31) { origin case_input; }
    }
    evaluate truth(foreign_corporation_subject_to_881(entity_ref("urn:test:w9ret:f2#c"), entity_ref("urn:test:w9ret:f2#y")));
    expect truth_status == FALSE_ONLY;
}
