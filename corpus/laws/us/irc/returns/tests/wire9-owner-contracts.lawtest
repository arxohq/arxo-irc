test "W9-RET-04-ZERO-STANDARD-DEDUCTION-FROM-GROSS-INCOME-OWNER" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.gross_income::standard_deduction_zero(entity_ref("urn:test:w9ret:s1#p"), entity_ref("urn:test:w9ret:s1#y")) { origin case_input; }
    }
    evaluate truth(standard_deduction_is_zero(entity_ref("urn:test:w9ret:s1#p"), entity_ref("urn:test:w9ret:s1#y")));
    expect truth_status == TRUE_ONLY;
