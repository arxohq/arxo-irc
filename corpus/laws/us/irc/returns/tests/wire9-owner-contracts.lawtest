// Returns WIRE-9 owner-contract scenarios. NOT EXECUTED (implemented_unverified); no legal review.

language "law.core" version "0.2";
package us.irc.returns version "0.1.1";
namespace "urn:us:irc:returns:clir";

test "W9-RET-01-POLITICAL-ORGANIZATION-INCOME-FROM-OWNER-REQUIRES-A-RETURN" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.exempt_organizations::political_organization_taxable_income(entity_ref("urn:test:w9ret:p1#o"), entity_ref("urn:test:w9ret:p1#y"), 500.00 USD) { origin case_input; }
    }
    evaluate truth(required_to_file_income_tax_return(entity_ref("urn:test:w9ret:p1#o"), entity_ref("urn:test:w9ret:p1#y")));
    expect truth_status == TRUE_ONLY;
}

test "W9-RET-02-ZERO-POLITICAL-ORGANIZATION-INCOME-FROM-OWNER-DOES-NOT-REQUIRE-A-RETURN" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.exempt_organizations::political_organization_taxable_income(entity_ref("urn:test:w9ret:p2#o"), entity_ref("urn:test:w9ret:p2#y"), 0.00 USD) { origin case_input; }
    }
    evaluate truth(required_to_file_income_tax_return(entity_ref("urn:test:w9ret:p2#o"), entity_ref("urn:test:w9ret:p2#y")));
    expect truth_status == FALSE_ONLY;
}

