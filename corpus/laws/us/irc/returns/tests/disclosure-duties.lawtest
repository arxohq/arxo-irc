language "law.core" version "0.2";
package us.irc.returns version "0.1.1";
namespace "urn:us:irc:returns:clir";

test "S6111-01-MATERIAL-ADVISOR-MUST-DISCLOSE-REPORTABLE-TRANSACTION" {
    given {
        context { decision_time @2026-04-01T09:00:00-05:00; knowledge_time @2026-04-01T09:00:00-05:00; legal_time @2026-04-01; timezone "America/New_York"; }
        assert reportable_transaction(1) { id "f0"; origin case_input; }
        assert provides_material_aid_re_transaction(entity_ref("urn:us:irc:returns:clir#ADV1"), 1) { id "f1"; origin case_input; }
        assert substantially_all_benefits_to_natural_persons(1) { id "f2"; origin case_input; }
        assert gross_income_derived_from_advice(entity_ref("urn:us:irc:returns:clir#ADV1"), 1, 60000.00 USD) { id "f3"; origin case_input; }
    }
    evaluate positions();
    expect position(DiscloseReportableTransaction, ACTIVE);
}

test "S6111-02-BELOW-THRESHOLD-NOT-A-MATERIAL-ADVISOR" {
    given {
        context { decision_time @2026-04-01T09:00:00-05:00; knowledge_time @2026-04-01T09:00:00-05:00; legal_time @2026-04-01; timezone "America/New_York"; }
        assert reportable_transaction(2) { id "f0"; origin case_input; }
        assert provides_material_aid_re_transaction(entity_ref("urn:us:irc:returns:clir#ADV2"), 2) { id "f1"; origin case_input; }
        assert substantially_all_benefits_to_natural_persons(2) { id "f2"; origin case_input; }
        assert gross_income_derived_from_advice(entity_ref("urn:us:irc:returns:clir#ADV2"), 2, 20000.00 USD) { id "f3"; origin case_input; }
    }
    evaluate truth(is_material_advisor(entity_ref("urn:us:irc:returns:clir#ADV2"), 2));
    expect truth_status == NEITHER;
}

