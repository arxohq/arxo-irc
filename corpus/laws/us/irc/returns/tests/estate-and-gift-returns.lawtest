}

test "S6075-02-GIFT-RETURN-DUE-APRIL-15-FOLLOWING-CALENDAR-YEAR" {
    given {
        context { decision_time @2026-04-01T09:00:00-05:00; knowledge_time @2026-04-01T09:00:00-05:00; legal_time @2026-04-01; timezone "America/New_York"; }
        assert gift_tax_return_required(entity_ref("urn:us:irc:returns:clir#DN3"), entity_ref("urn:us:irc:returns:clir#Y2025")) { id "f0"; origin case_input; }
        assert us.irc.core::ends(entity_ref("urn:us:irc:returns:clir#Y2025"), @2025-12-31) { id "f1"; origin case_input; }
    }
    evaluate truth(gift_tax_return_due_date(entity_ref("urn:us:irc:returns:clir#DN3"), entity_ref("urn:us:irc:returns:clir#Y2025"), @2026-04-15));
    expect truth_status == TRUE_ONLY;
