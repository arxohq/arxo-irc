        context { decision_time @2026-04-01T09:00:00-05:00; knowledge_time @2026-04-01T09:00:00-05:00; legal_time @2026-04-01; timezone "America/New_York"; }
        assert makes_gift_transfer(entity_ref("urn:us:irc:returns:clir#DN2"), entity_ref("urn:us:irc:returns:clir#Y2025"), 2) { id "f0"; origin case_input; }
        assert transfer_excluded_2503(entity_ref("urn:us:irc:returns:clir#DN2"), 2) { id "f1"; origin case_input; }
    }
    evaluate truth(gift_tax_return_required_for_transfer(entity_ref("urn:us:irc:returns:clir#DN2"), entity_ref("urn:us:irc:returns:clir#Y2025"), 2));
    expect truth_status == NEITHER;
}

