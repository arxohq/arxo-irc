// Scenarios for §6018, §6019, §6075, module 07-estate-and-gift-returns.law.
// implemented_unverified (NOT executed in this stage per NO-HEAVY-CHECKS).

language "law.core" version "0.2";
package us.irc.returns version "0.1.1";
namespace "urn:us:irc:returns:clir";

test "S6018-01-CITIZEN-ESTATE-ABOVE-EXCLUSION-RETURN-REQUIRED" {
    given {
        context { decision_time @2026-04-01T09:00:00-05:00; knowledge_time @2026-04-01T09:00:00-05:00; legal_time @2026-04-01; timezone "America/New_York"; }
        assert is_citizen_or_resident_decedent(entity_ref("urn:us:irc:returns:clir#D1")) { id "f0"; origin case_input; }
        assert gross_estate_amount(entity_ref("urn:us:irc:returns:clir#D1"), 15000000.00 USD) { id "f1"; origin case_input; }
        assert basic_exclusion_amount_for_year(entity_ref("urn:us:irc:returns:clir#Y2025"), 13990000.00 USD) { id "f2"; origin case_input; }
        assert adjusted_taxable_gifts_after_1976(entity_ref("urn:us:irc:returns:clir#D1"), 0.00 USD) { id "f3"; origin case_input; }
        assert section_2521_specific_exemption_after_1976_09_08(entity_ref("urn:us:irc:returns:clir#D1"), 0.00 USD) { id "f4"; origin case_input; }
    }
    evaluate truth(estate_tax_return_required(entity_ref("urn:us:irc:returns:clir#D1"), entity_ref("urn:us:irc:returns:clir#Y2025")));
    expect truth_status == TRUE_ONLY;
}

