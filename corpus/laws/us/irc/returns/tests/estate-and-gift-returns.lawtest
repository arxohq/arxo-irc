test "S6018-03-NONRESIDENT-US-SITUATED-ESTATE-ABOVE-60000-RETURN-REQUIRED" {
    given {
        context { decision_time @2026-04-01T09:00:00-05:00; knowledge_time @2026-04-01T09:00:00-05:00; legal_time @2026-04-01; timezone "America/New_York"; }
        assert is_nonresident_not_citizen_decedent(entity_ref("urn:us:irc:returns:clir#D3")) { id "f0"; origin case_input; }
        assert gross_estate_situated_in_us(entity_ref("urn:us:irc:returns:clir#D3"), 100000.00 USD) { id "f1"; origin case_input; }
        assert adjusted_taxable_gifts_after_1976(entity_ref("urn:us:irc:returns:clir#D3"), 0.00 USD) { id "f2"; origin case_input; }
        assert section_2521_specific_exemption_after_1976_09_08(entity_ref("urn:us:irc:returns:clir#D3"), 0.00 USD) { id "f3"; origin case_input; }
        assert us.irc.core::year_of(entity_ref("urn:us:irc:returns:clir#D3"), entity_ref("urn:us:irc:returns:clir#Y2025")) { id "f4"; origin case_input; }
    }
    evaluate truth(estate_tax_return_required(entity_ref("urn:us:irc:returns:clir#D3"), entity_ref("urn:us:irc:returns:clir#Y2025")));
    expect truth_status == TRUE_ONLY;
}

