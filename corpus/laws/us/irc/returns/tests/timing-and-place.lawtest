// --- §6081(a): general discretionary extension, capped at 6 months ---------

test "S6081-01-EXTENSION-WITHIN-SIX-MONTHS-VALID" {
    given {
        context { decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; legal_time @2026-01-15; timezone "America/New_York"; }
        assert us.irc.core::return_of(entity_ref("urn:us:irc:returns:clir#R1"), entity_ref("urn:us:irc:returns:clir#IND1"), entity_ref("urn:us:irc:returns:clir#Y2025"), us.irc.core::IncomeCh1) { id "f0"; origin case_input; }
        assert statutory_due_date(entity_ref("urn:us:irc:returns:clir#IND1"), entity_ref("urn:us:irc:returns:clir#Y2025"), us.irc.core::IncomeCh1, @2026-04-15) { id "f1"; origin case_input; }
        assert requests_extension(entity_ref("urn:us:irc:returns:clir#IND1"), entity_ref("urn:us:irc:returns:clir#R1"), @2026-10-15) { id "f2"; origin case_input; }
    }
    evaluate truth(us.irc.core::extension_granted(entity_ref("urn:us:irc:returns:clir#R1"), @2026-10-15));
    expect truth_status == TRUE_ONLY;
    expect not issue(POWER_INVALID_EXERCISE);
}

test "S6081-02-EXTENSION-PAST-SIX-MONTHS-INVALID-FOR-DOMESTIC-TAXPAYER" {
    given {
        context { decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; legal_time @2026-01-15; timezone "America/New_York"; }
        assert us.irc.core::return_of(entity_ref("urn:us:irc:returns:clir#R2"), entity_ref("urn:us:irc:returns:clir#IND2"), entity_ref("urn:us:irc:returns:clir#Y2025"), us.irc.core::IncomeCh1) { id "f0"; origin case_input; }
        assert statutory_due_date(entity_ref("urn:us:irc:returns:clir#IND2"), entity_ref("urn:us:irc:returns:clir#Y2025"), us.irc.core::IncomeCh1, @2026-04-15) { id "f1"; origin case_input; }
        assert requests_extension(entity_ref("urn:us:irc:returns:clir#IND2"), entity_ref("urn:us:irc:returns:clir#R2"), @2026-12-01) { id "f2"; origin case_input; }
    }
    evaluate truth(us.irc.core::extension_granted(entity_ref("urn:us:irc:returns:clir#R2"), @2026-12-01));
    expect truth_status == NEITHER;
    expect issue(POWER_INVALID_EXERCISE);
}

test "S6081-03-TAXPAYER-ABROAD-NOT-CAPPED-AT-SIX-MONTHS" {
    given {
        context { decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; legal_time @2026-01-15; timezone "America/New_York"; }
