        assert income_tax_filer_of_record(entity_ref("urn:us:irc:returns:clir#IND1"), entity_ref("urn:us:irc:returns:clir#Y2025")) { id "f0"; origin case_input; }
        assert us.irc.core::ends(entity_ref("urn:us:irc:returns:clir#Y2025"), @2025-12-31) { id "f1"; origin case_input; }
