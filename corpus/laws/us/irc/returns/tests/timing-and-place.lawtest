// Scenarios for §6071 (time, general), §6072 (time for income tax returns),
// §6081 (extension), §6091 (place for filing), package us.irc.returns,
// module 05-timing-and-place.law. Written from the text; NOT executed in
// this stage (owner's NO-HEAVY-CHECKS restriction) — `implemented_unverified`
// per docs/foundations/us-irc/AGENT-BRIEF.md.

language "law.core" version "0.2";
package us.irc.returns version "0.1.1";
namespace "urn:us:irc:returns:clir";

// --- §6071 -------------------------------------------------------------------

test "S6071-01-FORM-W2-DUE-JANUARY-31" {
    given {
        context { decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; legal_time @2026-01-15; timezone "America/New_York"; }
        assert is_form_w2_or_w3(entity_ref("urn:us:irc:returns:clir#W2FORM1")) { id "f0"; origin case_input; }
    }
    evaluate truth(due_date_of_document(entity_ref("urn:us:irc:returns:clir#W2FORM1"), @2026-01-31));
    expect truth_status == TRUE_ONLY;
}

test "S6071-02-ELECTRONIC-INFORMATION-RETURN-DUE-MARCH-31-UNLESS-W2" {
    given {
        context { decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; legal_time @2026-01-15; timezone "America/New_York"; }
