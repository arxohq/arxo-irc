    evaluate truth(statutory_due_date(entity_ref("urn:us:irc:returns:clir#IND1"), entity_ref("urn:us:irc:returns:clir#Y2025"), us.irc.core::IncomeCh1, @2026-04-15));
    expect truth_status == TRUE_ONLY;
}

