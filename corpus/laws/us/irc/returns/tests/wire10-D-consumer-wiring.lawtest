test "W10-D-RET-10-VIETNAM-ZONE-ANY-YEAR-WHILE-IN-MISSING-STATUS" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.gross_income::combat_zone_combatant_activities_commenced_112c3(entity_ref("urn:test:w10dret2:b3#z"), @1990-08-02) { origin case_input; }
        assert "f1": us.irc.gross_income::combat_zone_designated_for_vietnam_conflict_112(entity_ref("urn:test:w10dret2:b3#z")) { origin case_input; }
        assert "f2": missing_status_service_in_zone(entity_ref("urn:test:w10dret2:b3#p"), entity_ref("urn:test:w10dret2:b3#z")) { origin case_input; }
        assert "f3": entitled_to_pay_and_allowances_37_usc_552(entity_ref("urn:test:w10dret2:b3#p"), @1970-01-01, @1980-01-01) { origin case_input; }
        assert "f4": us.irc.core::begins(entity_ref("urn:test:w10dret2:b3#y"), @1972-01-01) { origin case_input; }
        assert "f5": us.irc.core::ends(entity_ref("urn:test:w10dret2:b3#y"), @1972-12-31) { origin case_input; }
    }
    evaluate truth(missing_status_joint_return_window_open(entity_ref("urn:test:w10dret2:b3#p"), entity_ref("urn:test:w10dret2:b3#y")));
    expect truth_status == TRUE_ONLY;
}

