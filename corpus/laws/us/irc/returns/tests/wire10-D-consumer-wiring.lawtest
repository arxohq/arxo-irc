test "W10-D-RET-08-YEAR-BEGINNING-WITHIN-2-YEARS-OF-THE-ZONE-TERMINATION-OPENS-THE-WINDOW" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.gross_income::combat_zone_combatant_activities_commenced_112c3(entity_ref("urn:test:w10dret2:b1#z"), @1990-08-02) { origin case_input; }
        assert "f1": us.irc.gross_income::combat_zone_combatant_activities_terminated_112c3(entity_ref("urn:test:w10dret2:b1#z"), @1991-02-28) { origin case_input; }
        assert "f2": missing_status_service_in_zone(entity_ref("urn:test:w10dret2:b1#p"), entity_ref("urn:test:w10dret2:b1#z")) { origin case_input; }
        assert "f3": us.irc.core::begins(entity_ref("urn:test:w10dret2:b1#y"), @1993-01-01) { origin case_input; }
    }
    evaluate truth(missing_status_joint_return_window_open(entity_ref("urn:test:w10dret2:b1#p"), entity_ref("urn:test:w10dret2:b1#y")));
    expect truth_status == TRUE_ONLY;
}

