// Returns WIRE-10 group D consumer-wiring scenarios. NOT EXECUTED (implemented_unverified); no legal review.

language "law.core" version "0.2";
package us.irc.returns version "0.1.1";
namespace "urn:us:irc:returns:clir";

test "W10-D-RET-01-NONRESIDENT-ALIEN-IN-TAXABLE-YEAR-FROM-DEFINITIONS" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.core::calendar_year_of(entity_ref("urn:test:w10dret:a1#y"), 2024) { origin case_input; }
        assert "f1": us.irc.definitions::nonresident_alien_for_year(entity_ref("urn:test:w10dret:a1#p"), 2024) { origin case_input; }
    }
    evaluate truth(nonresident_alien_in_taxable_year(entity_ref("urn:test:w10dret:a1#p"), entity_ref("urn:test:w10dret:a1#y")));
    expect truth_status == TRUE_ONLY;
}

