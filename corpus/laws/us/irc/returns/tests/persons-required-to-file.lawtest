// --- (b)(1) decedent return by executor -------------------------------------

test "S6012-11-EXECUTOR-MUST-FILE-DECEDENTS-RETURN" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert is_deceased(entity_ref("urn:us:irc:returns:clir#DEC1")) { id "f0"; origin case_input; }
        assert executor_or_administrator_of(entity_ref("urn:us:irc:returns:clir#EXEC1"), entity_ref("urn:us:irc:returns:clir#DEC1")) { id "f1"; origin case_input; }
        assert us.irc.core::liability(entity_ref("urn:us:irc:returns:clir#DEC1"), entity_ref("urn:us:irc:returns:clir#Y2025"), us.irc.core::IncomeCh1, 5000.00 USD) { id "f2"; origin case_input; }
        assert gross_income_amount(entity_ref("urn:us:irc:returns:clir#DEC1"), entity_ref("urn:us:irc:returns:clir#Y2025"), 20000.00 USD) { id "f3"; origin case_input; }
        assert filing_status(entity_ref("urn:us:irc:returns:clir#DEC1"), entity_ref("urn:us:irc:returns:clir#Y2025"), Single) { id "f4"; origin case_input; }
        assert exemption_amount_for_year(entity_ref("urn:us:irc:returns:clir#Y2025"), 0.00 USD) { id "f5"; origin case_input; }
        assert basic_standard_deduction_amount(entity_ref("urn:us:irc:returns:clir#Y2025"), Single, 15000.00 USD) { id "f6"; origin case_input; }
    }
    evaluate positions();
    expect position(MakeDecedentReturn, ACTIVE);
}

