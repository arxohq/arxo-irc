// Scenarios for §6012 (persons required to make returns of income), package
// us.irc.returns, module 02-persons-required-to-file.law. Written from the
// text; NOT executed in this stage (owner's NO-HEAVY-CHECKS restriction) —
// `implemented_unverified` per docs/foundations/us-irc/AGENT-BRIEF.md.

language "law.core" version "0.2";
package us.irc.returns version "0.1.1";
namespace "urn:us:irc:returns:clir";

// --- (a)(1) individual threshold ---------------------------------------------

test "S6012-01-SINGLE-ABOVE-THRESHOLD-MUST-FILE" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert filing_status(entity_ref("urn:us:irc:returns:clir#IND1"), entity_ref("urn:us:irc:returns:clir#Y2025"), Single) { id "f0"; origin case_input; }
        assert gross_income_amount(entity_ref("urn:us:irc:returns:clir#IND1"), entity_ref("urn:us:irc:returns:clir#Y2025"), 20000.00 USD) { id "f1"; origin case_input; }
        assert exemption_amount_for_year(entity_ref("urn:us:irc:returns:clir#Y2025"), 0.00 USD) { id "f2"; origin case_input; }
        assert basic_standard_deduction_amount(entity_ref("urn:us:irc:returns:clir#Y2025"), Single, 15000.00 USD) { id "f3"; origin case_input; }
        assert additional_standard_deduction_total(entity_ref("urn:us:irc:returns:clir#IND1"), entity_ref("urn:us:irc:returns:clir#Y2025"), 0.00 USD) { id "f4"; origin case_input; }
        assert taxable_year_begins_in_tcja_window(entity_ref("urn:us:irc:returns:clir#Y2025")) { id "f5"; origin adjudicated; }
        assert gross_income_amount(entity_ref("urn:us:irc:returns:clir#IND1"), entity_ref("urn:us:irc:returns:clir#Y2025"), 20000.00 USD) { id "f6"; origin case_input; }
    }
    evaluate truth(required_to_file_income_tax_return(entity_ref("urn:us:irc:returns:clir#IND1"), entity_ref("urn:us:irc:returns:clir#Y2025")));
    expect truth_status == TRUE_ONLY;
}

test "S6012-02-SINGLE-BELOW-STANDARD-DEDUCTION-NOT-REQUIRED-DURING-TCJA-WINDOW" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert filing_status(entity_ref("urn:us:irc:returns:clir#IND2"), entity_ref("urn:us:irc:returns:clir#Y2025"), Single) { id "f0"; origin case_input; }
        assert gross_income_amount(entity_ref("urn:us:irc:returns:clir#IND2"), entity_ref("urn:us:irc:returns:clir#Y2025"), 10000.00 USD) { id "f1"; origin case_input; }
        assert basic_standard_deduction_amount(entity_ref("urn:us:irc:returns:clir#Y2025"), Single, 15000.00 USD) { id "f2"; origin case_input; }
        assert taxable_year_begins_in_tcja_window(entity_ref("urn:us:irc:returns:clir#Y2025")) { id "f3"; origin adjudicated; }
    }
    evaluate truth(required_to_file_income_tax_return(entity_ref("urn:us:irc:returns:clir#IND2"), entity_ref("urn:us:irc:returns:clir#Y2025")));
    expect truth_status == NEITHER;
}

test "S6012-03-UNKNOWN-GROSS-INCOME-IS-UNDETERMINED" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert filing_status(entity_ref("urn:us:irc:returns:clir#IND3"), entity_ref("urn:us:irc:returns:clir#Y2025"), Single) { id "f0"; origin case_input; }
    }
    evaluate truth(required_to_file_income_tax_return(entity_ref("urn:us:irc:returns:clir#IND3"), entity_ref("urn:us:irc:returns:clir#Y2025")));
    expect truth_status == NEITHER;
    expect blocked_by(S6012IndividualRequiredToFile);
}

