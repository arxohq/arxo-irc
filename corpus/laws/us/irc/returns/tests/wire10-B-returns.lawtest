// Returns WIRE-10 group B scenarios. NOT EXECUTED (implemented_unverified); no legal review.

language "law.core" version "0.2";
package us.irc.returns version "0.1.1";
namespace "urn:us:irc:returns:clir";

test "W10B-RET-01-JOINT-RETURN-IN-EFFECT-DERIVES-THE-SECTION-1244-STUB" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": joint_return_in_effect(entity_ref("urn:test:w10b:r1#p"), entity_ref("urn:test:w10b:r1#s"), entity_ref("urn:test:w10b:r1#y")) { origin case_input; }
    }
    evaluate truth(us.irc.property_transactions::joint_return_filed_1244(entity_ref("urn:test:w10b:r1#p"), entity_ref("urn:test:w10b:r1#y")));
    expect truth_status == TRUE_ONLY;
}

test "W10B-RET-02-SECTION-6014-ELECTION-IN-EFFECT-IS-PUBLISHED" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": tax_not_shown_election_in_effect(entity_ref("urn:test:w10b:q1#p"), entity_ref("urn:test:w10b:q1#y")) { origin case_input; }
    }
    evaluate truth(elects_tax_not_shown_6014(entity_ref("urn:test:w10b:q1#p"), entity_ref("urn:test:w10b:q1#y")));
    expect truth_status == TRUE_ONLY;
}
