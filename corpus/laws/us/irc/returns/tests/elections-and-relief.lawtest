test "S6014-01-ELIGIBLE-TAXPAYER-MAY-ELECT" {
    given {
        context { decision_time @2026-04-01T09:00:00-05:00; knowledge_time @2026-04-01T09:00:00-05:00; legal_time @2026-04-01; timezone "America/New_York"; }
        assert gross_income_amount(entity_ref("urn:us:irc:returns:clir#T1"), entity_ref("urn:us:irc:returns:clir#Y2025"), 9000.00 USD) { id "f0"; origin case_input; }
        assert gross_income_only_wages_dividends_interest(entity_ref("urn:us:irc:returns:clir#T1"), entity_ref("urn:us:irc:returns:clir#Y2025")) { id "f1"; origin case_input; }
        assert nonwage_gross_income_amount(entity_ref("urn:us:irc:returns:clir#T1"), entity_ref("urn:us:irc:returns:clir#Y2025"), 50.00 USD) { id "f2"; origin case_input; }
        assert elects_6014(entity_ref("urn:us:irc:returns:clir#T1"), entity_ref("urn:us:irc:returns:clir#Y2025")) { id "f3"; origin case_input; }
    }
    evaluate truth(tax_not_shown_election_in_effect(entity_ref("urn:us:irc:returns:clir#T1"), entity_ref("urn:us:irc:returns:clir#Y2025")));
    expect truth_status == TRUE_ONLY;
    expect not issue(POWER_INVALID_EXERCISE);
}

