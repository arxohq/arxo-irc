        assert keeps_records_statements_and_returns_as_prescribed(entity_ref("urn:us:irc:returns:clir#P1")) { id "f1"; origin case_input; }
    }
    evaluate positions();
    expect position(KeepRecordsStatementsAndReturns, SATISFIED);
}

test "S6001-03-SECRETARY-NOTICE-VALID-WHEN-NECESSARY" {
    given {
        context { decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; legal_time @2026-01-15; timezone "America/New_York"; }
        assert secretary_serves_records_notice(entity_ref("urn:us:irc:returns:clir#P1")) { id "f0"; origin case_input; }
        assert records_notice_necessary(entity_ref("urn:us:irc:returns:clir#P1")) { id "f1"; origin adjudicated; }
    }
    evaluate truth(required_by_secretary_notice(entity_ref("urn:us:irc:returns:clir#P1")));
    expect truth_status == TRUE_ONLY;
    expect not issue(POWER_INVALID_EXERCISE);
}

test "S6001-04-SECRETARY-NOTICE-WITHOUT-JUDGMENT-IS-UNDETERMINED" {
    given {
        context { decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; legal_time @2026-01-15; timezone "America/New_York"; }
        assert secretary_serves_records_notice(entity_ref("urn:us:irc:returns:clir#P2")) { id "f0"; origin case_input; }
    }
    evaluate truth(required_by_secretary_notice(entity_ref("urn:us:irc:returns:clir#P2")));
    expect truth_status == NEITHER;
    expect judgment_request(records_notice_necessary, Secretary);
}

