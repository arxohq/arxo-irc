// Scenarios for §6001 (records) and §6011 (general requirement of return),
// package us.irc.returns, module 01-records-and-general.law. Written from
// the text; NOT executed in this stage (owner's NO-HEAVY-CHECKS restriction)
// — `implemented_unverified` per docs/foundations/us-irc/AGENT-BRIEF.md.

language "law.core" version "0.2";
package us.irc.returns version "0.1.1";
namespace "urn:us:irc:returns:clir";

// --- §6001 -------------------------------------------------------------------

test "S6001-01-LIABLE-PERSON-MUST-KEEP-RECORDS" {
    given {
        context { decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; legal_time @2026-01-15; timezone "America/New_York"; }
        assert us.irc.core::liability(entity_ref("urn:us:irc:returns:clir#P1"), entity_ref("urn:us:irc:returns:clir#Y2025"), us.irc.core::IncomeCh1, 5000.00 USD) { id "f0"; origin case_input; }
    }
    evaluate positions();
    expect position(KeepRecordsStatementsAndReturns, ACTIVE);
}

test "S6001-02-RECORDS-KEPT-SATISFIES-DUTY" {
    given {
        context { decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; legal_time @2026-01-15; timezone "America/New_York"; }
