// --- §6011(g): disclosure of reportable transaction ------------------------

test "S6011-12-TAXABLE-PARTY-MUST-DISCLOSE-SHELTER-STATUS" {
    given {
        context { decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; legal_time @2026-01-15; timezone "America/New_York"; }
        assert taxable_party_to(entity_ref("urn:us:irc:returns:clir#P1"), entity_ref("urn:us:irc:returns:clir#T1")) { id "f0"; origin case_input; }
        assert tax_exempt_party_to(entity_ref("urn:us:irc:returns:clir#ORG1"), entity_ref("urn:us:irc:returns:clir#T1")) { id "f1"; origin case_input; }
        assert prohibited_tax_shelter_transaction(entity_ref("urn:us:irc:returns:clir#T1")) { id "f2"; origin case_input; }
        assert tax_exempt_entity(entity_ref("urn:us:irc:returns:clir#ORG1")) { id "f3"; origin case_input; }
    }
    evaluate positions();
    expect position(DiscloseShelterStatusToTaxExemptEntity, ACTIVE);
}

