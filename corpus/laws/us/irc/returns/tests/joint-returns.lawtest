        assert time_for_filing_expired(entity_ref("urn:us:irc:returns:clir#Y2020")) { id "f2"; origin case_input; }
        assert makes_joint_return_after_separate(entity_ref("urn:us:irc:returns:clir#H6"), entity_ref("urn:us:irc:returns:clir#W6"), entity_ref("urn:us:irc:returns:clir#Y2020")) { id "f3"; origin case_input; }
        assert three_years_from_last_filing_date_expired(entity_ref("urn:us:irc:returns:clir#Y2020")) { id "f4"; origin case_input; }
    }
    evaluate truth(joint_return_after_separate_in_effect(entity_ref("urn:us:irc:returns:clir#H6"), entity_ref("urn:us:irc:returns:clir#W6"), entity_ref("urn:us:irc:returns:clir#Y2020")));
    expect truth_status == NEITHER;
