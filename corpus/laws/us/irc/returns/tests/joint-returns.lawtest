// --- (b) joint return after separate return, and its limitations -----------

test "S6013-05-JOINT-RETURN-AFTER-SEPARATE-WITHIN-THREE-YEARS-VALID" {
    given {
        context { decision_time @2026-04-01T09:00:00-05:00; knowledge_time @2026-04-01T09:00:00-05:00; legal_time @2026-04-01; timezone "America/New_York"; }
        assert spouse_of(entity_ref("urn:us:irc:returns:clir#H5"), entity_ref("urn:us:irc:returns:clir#W5")) { id "f0"; origin case_input; }
        assert filed_separate_return(entity_ref("urn:us:irc:returns:clir#H5"), entity_ref("urn:us:irc:returns:clir#Y2025")) { id "f1"; origin case_input; }
        assert time_for_filing_expired(entity_ref("urn:us:irc:returns:clir#Y2025")) { id "f2"; origin case_input; }
        assert makes_joint_return_after_separate(entity_ref("urn:us:irc:returns:clir#H5"), entity_ref("urn:us:irc:returns:clir#W5"), entity_ref("urn:us:irc:returns:clir#Y2025")) { id "f3"; origin case_input; }
    }
    evaluate truth(joint_return_after_separate_in_effect(entity_ref("urn:us:irc:returns:clir#H5"), entity_ref("urn:us:irc:returns:clir#W5"), entity_ref("urn:us:irc:returns:clir#Y2025")));
    expect truth_status == TRUE_ONLY;
    expect not issue(POWER_INVALID_EXERCISE);
}

test "S6013-06-JOINT-RETURN-AFTER-THREE-YEARS-INVALID" {
    given {
        context { decision_time @2026-04-01T09:00:00-05:00; knowledge_time @2026-04-01T09:00:00-05:00; legal_time @2026-04-01; timezone "America/New_York"; }
