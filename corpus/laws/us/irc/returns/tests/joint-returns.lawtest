// Scenarios for §6013 (joint returns), package us.irc.returns, module
// 03-joint-returns.law. Written from the text; NOT executed in this stage
// (owner's NO-HEAVY-CHECKS restriction) — `implemented_unverified` per
// docs/foundations/us-irc/AGENT-BRIEF.md.

language "law.core" version "0.2";
package us.irc.returns version "0.1.1";
namespace "urn:us:irc:returns:clir";

test "S6013-01-SPOUSES-MAY-MAKE-JOINT-RETURN" {
    given {
        context { decision_time @2026-04-01T09:00:00-05:00; knowledge_time @2026-04-01T09:00:00-05:00; legal_time @2026-04-01; timezone "America/New_York"; }
        assert spouse_of(entity_ref("urn:us:irc:returns:clir#H1"), entity_ref("urn:us:irc:returns:clir#W1")) { id "f0"; origin case_input; }
        assert makes_joint_return(entity_ref("urn:us:irc:returns:clir#H1"), entity_ref("urn:us:irc:returns:clir#W1"), entity_ref("urn:us:irc:returns:clir#Y2025")) { id "f1"; origin case_input; }
    }
    evaluate truth(joint_return_in_effect(entity_ref("urn:us:irc:returns:clir#H1"), entity_ref("urn:us:irc:returns:clir#W1"), entity_ref("urn:us:irc:returns:clir#Y2025")));
    expect truth_status == TRUE_ONLY;
    expect not issue(POWER_INVALID_EXERCISE);
}

