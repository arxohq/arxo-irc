// Scenarios for §6107, §6108, §6109, module 10-preparer-duties-and-tin.law.
// implemented_unverified (NOT executed in this stage per NO-HEAVY-CHECKS).

language "law.core" version "0.2";
package us.irc.returns version "0.1.1";
namespace "urn:us:irc:returns:clir";

test "S6107-01-PREPARER-MUST-FURNISH-COPY-BY-SIGNATURE-TIME" {
    given {
        context { decision_time @2026-04-01T09:00:00-05:00; knowledge_time @2026-04-01T09:00:00-05:00; legal_time @2026-04-01; timezone "America/New_York"; }
        assert is_tax_return_preparer_of(entity_ref("urn:us:irc:returns:clir#PREP1"), entity_ref("urn:us:irc:returns:clir#R1")) { id "f0"; origin case_input; }
        assert return_presented_for_signature(entity_ref("urn:us:irc:returns:clir#R1"), @2026-03-15) { id "f1"; origin case_input; }
    }
    evaluate positions();
    expect position(FurnishCopyToTaxpayer, ACTIVE);
}

test "S6107-02-RETENTION-DUTY-DISCHARGED-WHEN-ANOTHER-PREPARER-COMPLIED" {
    given {
        context { decision_time @2026-04-01T09:00:00-05:00; knowledge_time @2026-04-01T09:00:00-05:00; legal_time @2026-04-01; timezone "America/New_York"; }
        assert is_tax_return_preparer_of(entity_ref("urn:us:irc:returns:clir#PREP2"), entity_ref("urn:us:irc:returns:clir#R2")) { id "f0"; origin case_input; }
        assert return_period_ends(entity_ref("urn:us:irc:returns:clir#R2"), @2026-04-15) { id "f1"; origin case_input; }
        assert another_preparer_complied(entity_ref("urn:us:irc:returns:clir#PREP2"), entity_ref("urn:us:irc:returns:clir#R2")) { id "f2"; origin case_input; }
    }
    evaluate positions();
    expect not position(RetainCopyOrList, ACTIVE);
}

test "S6108-01-ANONYMOUS-FORM-PROHIBITION-VIOLATED-ON-IDENTIFICATION" {
    given {
        context { decision_time @2026-04-01T09:00:00-05:00; knowledge_time @2026-04-01T09:00:00-05:00; legal_time @2026-04-01; timezone "America/New_York"; }
        assert statistics_of_income_published(2025) { id "f0"; origin case_input; }
        assert published_statistics_identify_taxpayer(2025, entity_ref("urn:us:irc:returns:clir#TP1")) { id "f1"; origin case_input; }
    }
    evaluate positions();
    expect position(PublishIdentifyingStatistics, VIOLATED);
}

test "S6109-01-INDIVIDUAL-MUST-INCLUDE-IDENTIFYING-NUMBER" {
    given {
        context { decision_time @2026-04-01T09:00:00-05:00; knowledge_time @2026-04-01T09:00:00-05:00; legal_time @2026-04-01; timezone "America/New_York"; }
        assert identifying_number_required_by_regulation(entity_ref("urn:us:irc:returns:clir#TP2"), 1) { id "f0"; origin case_input; }
    }
    evaluate truth(tin_required(entity_ref("urn:us:irc:returns:clir#TP2"), 1));
    expect truth_status == TRUE_ONLY;
}

test "S6109-02-SSN-USED-AS-IDENTIFYING-NUMBER" {
    given {
        context { decision_time @2026-04-01T09:00:00-05:00; knowledge_time @2026-04-01T09:00:00-05:00; legal_time @2026-04-01; timezone "America/New_York"; }
        assert has_social_security_account_number(entity_ref("urn:us:irc:returns:clir#TP3"), 123456789) { id "f0"; origin case_input; }
    }
    evaluate truth(individuals_identifying_number_is_ssn(entity_ref("urn:us:irc:returns:clir#TP3"), 123456789));
    expect truth_status == TRUE_ONLY;
}
