// Scenarios for §6096, §6102, module 09-campaign-fund-period-rounding.law.
// implemented_unverified (NOT executed in this stage per NO-HEAVY-CHECKS).

language "law.core" version "0.2";
package us.irc.returns version "0.1.1";
namespace "urn:us:irc:returns:clir";

test "S6096-01-INDIVIDUAL-DESIGNATES-THREE-DOLLARS" {
    given {
        context { decision_time @2026-04-01T09:00:00-05:00; knowledge_time @2026-04-01T09:00:00-05:00; legal_time @2026-04-01; timezone "America/New_York"; }
        assert income_tax_liability_amount(entity_ref("urn:us:irc:returns:clir#TX1"), entity_ref("urn:us:irc:returns:clir#Y2025"), 500.00 USD) { id "f0"; origin case_input; }
        assert designates_three_dollars_to_fund(entity_ref("urn:us:irc:returns:clir#TX1"), entity_ref("urn:us:irc:returns:clir#Y2025")) { id "f1"; origin case_input; }
    }
    evaluate truth(three_dollars_designated_to_fund(entity_ref("urn:us:irc:returns:clir#TX1"), entity_ref("urn:us:irc:returns:clir#Y2025")));
    expect truth_status == TRUE_ONLY;
}

test "S6096-02-NONRESIDENT-ALIEN-CANNOT-DESIGNATE" {
    given {
        context { decision_time @2026-04-01T09:00:00-05:00; knowledge_time @2026-04-01T09:00:00-05:00; legal_time @2026-04-01; timezone "America/New_York"; }
        assert income_tax_liability_amount(entity_ref("urn:us:irc:returns:clir#TX2"), entity_ref("urn:us:irc:returns:clir#Y2025"), 500.00 USD) { id "f0"; origin case_input; }
        assert designates_three_dollars_to_fund(entity_ref("urn:us:irc:returns:clir#TX2"), entity_ref("urn:us:irc:returns:clir#Y2025")) { id "f1"; origin case_input; }
        assert is_nonresident_alien_individual(entity_ref("urn:us:irc:returns:clir#TX2")) { id "f2"; origin case_input; }
    }
    evaluate truth(three_dollars_designated_to_fund(entity_ref("urn:us:irc:returns:clir#TX2"), entity_ref("urn:us:irc:returns:clir#Y2025")));
    expect truth_status == NEITHER;
}

test "S6102-01-DISREGARD-FRACTION-ROUNDS-DOWN" {
    given {
        context { decision_time @2026-04-01T09:00:00-05:00; knowledge_time @2026-04-01T09:00:00-05:00; legal_time @2026-04-01; timezone "America/New_York"; }
        assert whole_dollar_regime_authorized(1, DisregardFraction) { id "f0"; origin case_input; }
        assert raw_final_amount_on_form(1, 42.67 USD) { id "f1"; origin case_input; }
    }
    evaluate truth(rounded_to_whole_dollars(1, 42.67 USD, 42.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S6102-02-HALF-UP-ROUNDS-TO-NEAREST-DOLLAR" {
    given {
        context { decision_time @2026-04-01T09:00:00-05:00; knowledge_time @2026-04-01T09:00:00-05:00; legal_time @2026-04-01; timezone "America/New_York"; }
        assert whole_dollar_regime_authorized(2, RoundHalfUp) { id "f0"; origin case_input; }
        assert raw_final_amount_on_form(2, 42.50 USD) { id "f1"; origin case_input; }
    }
    evaluate truth(rounded_to_whole_dollars(2, 42.50 USD, 43.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S6102-03-PERSON-MAY-ELECT-OUT-OF-WHOLE-DOLLAR-ROUNDING" {
    given {
        context { decision_time @2026-04-01T09:00:00-05:00; knowledge_time @2026-04-01T09:00:00-05:00; legal_time @2026-04-01; timezone "America/New_York"; }
        assert whole_dollar_regime_authorized(3, RoundHalfUp) { id "f0"; origin case_input; }
        assert elects_not_to_use_whole_dollar_amounts(entity_ref("urn:us:irc:returns:clir#TX3"), 3) { id "f1"; origin case_input; }
    }
    evaluate positions();
    expect position(S6102bOptOutOfRounding, ACTIVE);
}
