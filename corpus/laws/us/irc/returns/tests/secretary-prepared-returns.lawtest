// Scenarios for §6020, §6021, module 08-secretary-prepared-returns.law.
// implemented_unverified (NOT executed in this stage per NO-HEAVY-CHECKS).

language "law.core" version "0.2";
package us.irc.returns version "0.1.1";
namespace "urn:us:irc:returns:clir";

test "S6020-01-CONSENT-RETURN-RECEIVED-AS-TAXPAYERS-OWN" {
    given {
        context { decision_time @2026-04-01T09:00:00-05:00; knowledge_time @2026-04-01T09:00:00-05:00; legal_time @2026-04-01; timezone "America/New_York"; }
        assert person_fails_to_make_required_return(entity_ref("urn:us:irc:returns:clir#P1"), 1) { id "f0"; origin case_input; }
        assert person_consents_to_disclose_information(entity_ref("urn:us:irc:returns:clir#P1"), 1) { id "f1"; origin case_input; }
        assert secretary_prepares_return(entity_ref("urn:us:irc:returns:clir#P1"), 1) { id "f2"; origin case_input; }
        assert return_signed_by_person(entity_ref("urn:us:irc:returns:clir#P1"), 1) { id "f3"; origin case_input; }
    }
    evaluate truth(secretary_prepared_return_received_as_taxpayers_own(entity_ref("urn:us:irc:returns:clir#P1"), 1));
    expect truth_status == TRUE_ONLY;
    expect not issue(POWER_INVALID_EXERCISE);
}

test "S6020-02-NO-CONSENT-PREPARATION-INVALID" {
    given {
        context { decision_time @2026-04-01T09:00:00-05:00; knowledge_time @2026-04-01T09:00:00-05:00; legal_time @2026-04-01; timezone "America/New_York"; }
        assert person_fails_to_make_required_return(entity_ref("urn:us:irc:returns:clir#P2"), 2) { id "f0"; origin case_input; }
        assert secretary_prepares_return(entity_ref("urn:us:irc:returns:clir#P2"), 2) { id "f1"; origin case_input; }
        assert return_signed_by_person(entity_ref("urn:us:irc:returns:clir#P2"), 2) { id "f2"; origin case_input; }
    }
    evaluate truth(secretary_prepared_return_received_as_taxpayers_own(entity_ref("urn:us:irc:returns:clir#P2"), 2));
    expect truth_status == NEITHER;
    expect issue(POWER_INVALID_EXERCISE);
}

test "S6020-03-SUBSTITUTE-RETURN-EXECUTED-ON-FAILURE-TO-FILE" {
    given {
        context { decision_time @2026-04-01T09:00:00-05:00; knowledge_time @2026-04-01T09:00:00-05:00; legal_time @2026-04-01; timezone "America/New_York"; }
        assert fails_to_make_return_at_prescribed_time(entity_ref("urn:us:irc:returns:clir#P3"), 3) { id "f0"; origin case_input; }
        assert secretary_executes_return(entity_ref("urn:us:irc:returns:clir#P3"), 3) { id "f1"; origin case_input; }
    }
    evaluate truth(substitute_return_executed(entity_ref("urn:us:irc:returns:clir#P3"), 3));
    expect truth_status == TRUE_ONLY;
    evaluate truth(substitute_return_prima_facie_sufficient(entity_ref("urn:us:irc:returns:clir#P3"), 3));
    expect truth_status == TRUE_ONLY;
}

test "S6021-01-SECRETARY-LISTS-UNCLAIMED-TAXABLE-ARTICLES" {
    given {
        context { decision_time @2026-04-01T09:00:00-05:00; knowledge_time @2026-04-01T09:00:00-05:00; legal_time @2026-04-01; timezone "America/New_York"; }
        assert taxable_articles_in_district(1, 100) { id "f0"; origin case_input; }
        assert no_list_transmitted(1, 100) { id "f1"; origin case_input; }
        assert secretary_inspects_and_lists(1, 100) { id "f2"; origin case_input; }
    }
    evaluate truth(s6021_list_sufficient(1, 100));
    expect truth_status == TRUE_ONLY;
}
