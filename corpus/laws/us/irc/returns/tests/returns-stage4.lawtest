test "S6113B2B-41-WITHOUT-THE-SECRETARYS-DETERMINATION-THE-GROUP-IS-NOT-AGGREGATED" {
    given {
        context { decision_time @2026-09-26T09:00:00-05:00; knowledge_time @2026-09-26T09:00:00-05:00; legal_time @2026-09-26; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert organization_group_member(entity_ref("urn:us:irc:returns:clir#GR2"), entity_ref("urn:us:irc:returns:clir#OR3")) { id "f0"; origin case_input; }
        assert organization_group_member(entity_ref("urn:us:irc:returns:clir#GR2"), entity_ref("urn:us:irc:returns:clir#OR4")) { id "f1"; origin case_input; }
        assert secretary_treats_group_as_one_organization(entity_ref("urn:us:irc:returns:clir#GR2")) { id "f2"; origin case_input; }
    }
    evaluate truth(group_treated_as_one_organization_for_6113(entity_ref("urn:us:irc:returns:clir#GR2")));
    expect truth_status == NEITHER;
}
