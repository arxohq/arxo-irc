// --- §6017 -------------------------------------------------------------------

test "S6017-01-AT-400-NET-EARNINGS-MUST-FILE" {
    given {
        context { decision_time @2026-04-01T09:00:00-05:00; knowledge_time @2026-04-01T09:00:00-05:00; legal_time @2026-04-01; timezone "America/New_York"; }
        assert net_earnings_from_self_employment(entity_ref("urn:us:irc:returns:clir#SE1"), entity_ref("urn:us:irc:returns:clir#Y2025"), 400.00 USD) { id "f0"; origin case_input; }
    }
    evaluate truth(self_employment_filing_required(entity_ref("urn:us:irc:returns:clir#SE1"), entity_ref("urn:us:irc:returns:clir#Y2025")));
    expect truth_status == TRUE_ONLY;
}

test "S6017-02-JUST-BELOW-400-NOT-REQUIRED" {
    given {
        context { decision_time @2026-04-01T09:00:00-05:00; knowledge_time @2026-04-01T09:00:00-05:00; legal_time @2026-04-01; timezone "America/New_York"; }
