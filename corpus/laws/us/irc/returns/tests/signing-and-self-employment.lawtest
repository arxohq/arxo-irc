    }
    evaluate truth(self_employment_filing_required(entity_ref("urn:us:irc:returns:clir#SE2"), entity_ref("urn:us:irc:returns:clir#Y2025")));
    expect truth_status == NEITHER;
}

test "S6017-03-NONRESIDENT-ALIEN-EXCLUDED-EVEN-ABOVE-400" {
    given {
        context { decision_time @2026-04-01T09:00:00-05:00; knowledge_time @2026-04-01T09:00:00-05:00; legal_time @2026-04-01; timezone "America/New_York"; }
