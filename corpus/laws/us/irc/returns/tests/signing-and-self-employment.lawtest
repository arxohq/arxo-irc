}

test "S6061-02-CORPORATION-RETURN-EXCLUDED-FROM-6061A" {
    given {
        context { decision_time @2026-04-01T09:00:00-05:00; knowledge_time @2026-04-01T09:00:00-05:00; legal_time @2026-04-01; timezone "America/New_York"; }
        assert document_of(entity_ref("urn:us:irc:returns:clir#DOC2"), entity_ref("urn:us:irc:returns:clir#CORP1")) { id "f0"; origin case_input; }
        assert document_requires_signature(entity_ref("urn:us:irc:returns:clir#DOC2")) { id "f1"; origin case_input; }
        assert document_governed_by_6062_or_6063(entity_ref("urn:us:irc:returns:clir#DOC2")) { id "f2"; origin case_input; }
    }
    evaluate positions();
    expect not position(SignDocumentAsPrescribed, ACTIVE);
}

test "S6061-03-ALTERNATIVE-METHOD-TREATED-AS-SIGNED" {
    given {
        context { decision_time @2026-04-01T09:00:00-05:00; knowledge_time @2026-04-01T09:00:00-05:00; legal_time @2026-04-01; timezone "America/New_York"; }
        assert document_requires_signature(entity_ref("urn:us:irc:returns:clir#DOC3")) { id "f0"; origin case_input; }
        assert secretary_provides_alternative_signing_method(entity_ref("urn:us:irc:returns:clir#DOC3")) { id "f1"; origin case_input; }
        assert filed_verified_signed_or_subscribed_under_alternative_method(entity_ref("urn:us:irc:returns:clir#DOC3")) { id "f2"; origin case_input; }
    }
    evaluate truth(treated_as_signed_or_subscribed(entity_ref("urn:us:irc:returns:clir#DOC3")));
    expect truth_status == TRUE_ONLY;
}

