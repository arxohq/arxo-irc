// STAGE 2 — §6096 (Presidential Election Campaign Fund designation), §6101
// (period covered by returns), §6102 (computation on the basis of whole-
// dollar amounts).
//
// JUDGMENT CALLS:
//  - §6096(a) is a `liberty` (the taxpayer's own conduct, changing no legal
//    relation with anyone else — a pure book-entry designation) rather than
//    a `power`, matching the rights-positions.md guidance that a liberty
//    fits an election of the holder's own conduct that changes no legal
//    relation. Its dollar-for-dollar joint-return doubling in the second
//    sentence is a separate liberty per spouse.
//  - §6096(b) (income tax liability definition) is a `classification`
//    reading the chapter-1 tax and part-IV-subchapter-A credits (both
//    pending contracts to income-individual/gross-income).
//  - §6096(c) (manner and time) is `non_normative` as to the general
//    regulatory-manner delegation, EXECUTABLE as to the one concrete rule
//    the statute itself states: designation at return-filing time must be
//    on the first page or the signature page.
//  - §6101 is NON_NORMATIVE: pure delegation to regulations with no
//    self-executing text of its own ("when not otherwise provided for...
//    the Secretary MAY by regulations prescribe").
//  - §6102(a)(1)/(2) are the two ALTERNATIVE whole-dollar rounding regimes
//    the Secretary may authorize; both are modeled as `pub` computations
//    keyed to which regime is in effect (a per-form Secretary choice, not
//    a taxpayer one) — DOWN-rounding for (1), HALF_UP for (2). §6102(b) is
//    a `liberty` of the person making the return to opt out of whichever
//    regime applies. §6102(c) is a `classification` restricting (a)/(b) to
//    the FINAL amount only, not computation intermediates — modeled as a
//    guard on where `rounded_to_whole_dollars` may be invoked (comment
//    only; this package does not itself perform the chained downstream
//    computations that would need the guard).

language "law.core" version "0.2";
package us.irc.returns version "0.1.1";
namespace "urn:us:irc:returns:clir";

use self::{
    IRC_S6096_A,
    IRC_S6096_C,
    IRC_S6102_A,
    IRC_S6102_B,
    Individual,
    Person,
    Secretary,
    TaxableYear,
    joint_return_in_effect,
};

// ============================================================================
// §6096 — Designation to Presidential Election Campaign Fund
// ============================================================================

relation income_tax_liability_amount(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the §6096(b) income tax liability: chapter 1 tax as shown on the return, reduced by part-IV-subchapter-A credits shown on the return (other than subpart C, the earned income credit) (pending: income_individual/gross_income own chapter 1 tax and the credit schedule)";
}
relation is_nonresident_alien_individual(p: Individual) kind empirical;
relation designates_three_dollars_to_fund(p: Individual, y: TaxableYear) kind empirical;
relation three_dollars_designated_to_fund(p: Individual, y: TaxableYear) kind institutional {
    label en unofficial "the individual's $3 designation to the Presidential Election Campaign Fund is effective (§6096(a))";
}
@source(IRC_S6096_A, relation = formalizes, coverage = exact, quote = "Every individual (other than a nonresident alien) whose income tax liability for the taxable year is $3 or more may designate that $3 shall be paid over to the Presidential Election Campaign Fund in accordance with the provisions of section 9006(a).")
rule S6096DesignateThreeDollarsLiberty defeasible {
    for p: Individual;
    for y: TaxableYear;
    for liab: Money;
    when income_tax_liability_amount(p, y, liab) and liab >= 3.00 USD and designates_three_dollars_to_fund(p, y);
    then liberty S6096Designate {
        holder p;
        against Secretary;
        action designates_three_dollars_to_fund(p, y);
        window [-infinity, infinity];
    };
    unless is_nonresident_alien_individual(p) and designates_three_dollars_to_fund(p, y);
}
@source(IRC_S6096_A, relation = formalizes, coverage = exact, quote = "Every individual (other than a nonresident alien) whose income tax liability for the taxable year is $3 or more may designate that $3 shall be paid over to the Presidential Election Campaign Fund in accordance with the provisions of section 9006(a).")
rule S6096DesignateThreeDollarsEffect defeasible {
    for p: Individual;
    for y: TaxableYear;
    for liab: Money;
    when income_tax_liability_amount(p, y, liab) and liab >= 3.00 USD and designates_three_dollars_to_fund(p, y);
    then three_dollars_designated_to_fund(p, y);
    unless is_nonresident_alien_individual(p) and designates_three_dollars_to_fund(p, y);
}

relation designates_three_dollars_joint(spouse: Individual, other: Individual, y: TaxableYear) kind empirical;
relation joint_income_tax_liability_amount(p: Individual, s: Individual, y: TaxableYear, amount: Money) kind institutional;
relation three_dollars_designated_to_fund_by_spouse(spouse: Individual, other: Individual, y: TaxableYear) kind institutional {
    label en unofficial "on a joint return with $6+ liability, each spouse may separately designate $3 (§6096(a) second sentence)";
}
@source(IRC_S6096_A, relation = formalizes, coverage = exact, quote = "In the case of a joint return of husband and wife having an income tax liability of $6 or more, each spouse may designate that $3 shall be paid to the fund.")
rule S6096DesignateThreeDollarsJointLiberty defeasible {
    for spouse: Individual;
    for other: Individual;
    for y: TaxableYear;
    for liab: Money;
    when joint_return_in_effect(spouse, other, y)
        and joint_income_tax_liability_amount(spouse, other, y, liab)
        and liab >= 6.00 USD
        and designates_three_dollars_joint(spouse, other, y);
    then liberty S6096DesignateJoint {
        holder spouse;
        against Secretary;
        action designates_three_dollars_joint(spouse, other, y);
        window [-infinity, infinity];
    };
    unless is_nonresident_alien_individual(spouse) and designates_three_dollars_joint(spouse, other, y);
}
@source(IRC_S6096_A, relation = formalizes, coverage = exact, quote = "In the case of a joint return of husband and wife having an income tax liability of $6 or more, each spouse may designate that $3 shall be paid to the fund.")
rule S6096DesignateThreeDollarsJointEffect defeasible {
    for spouse: Individual;
    for other: Individual;
    for y: TaxableYear;
    for liab: Money;
    when joint_return_in_effect(spouse, other, y)
        and joint_income_tax_liability_amount(spouse, other, y, liab)
        and liab >= 6.00 USD
        and designates_three_dollars_joint(spouse, other, y);
    then three_dollars_designated_to_fund_by_spouse(spouse, other, y);
    unless is_nonresident_alien_individual(spouse) and designates_three_dollars_joint(spouse, other, y);
}

relation designation_made_at_filing(p: Individual, y: TaxableYear) kind empirical;
relation designation_on_first_page_or_signature_page(p: Individual, y: TaxableYear) kind empirical;
relation designation_manner_satisfied(p: Individual, y: TaxableYear) kind institutional {
    label en unofficial "a §6096(a) designation made at the time of filing satisfies §6096(c)'s manner requirement only if made on the first page or the signature page of the return";
}
@source(IRC_S6096_C, relation = formalizes, coverage = exact, quote = "if such designation is made at the time of filing the return of the tax imposed by chapter 1 for such taxable year, such designation shall be made either on the first page of the return or on the page bearing the taxpayer's signature.")
rule S6096DesignationManner strict {
    for p: Individual;
    for y: TaxableYear;
    when designation_made_at_filing(p, y) and designation_on_first_page_or_signature_page(p, y);
    then designation_manner_satisfied(p, y);
}

// §6101 — pure delegation to regulations; no self-executing text.
relation s6101_regulations_delegation(unused: Boolean) kind institutional {
    label en unofficial "§6101 delegates to regulations the period/date for a return, statement or document not otherwise provided for — NON_NORMATIVE, no self-executing rule";
}

// ============================================================================
// §6102 — Computation on basis of whole-dollar amounts
// ============================================================================

enum WholeDollarRoundingRegime { DisregardFraction; RoundHalfUp; }
relation whole_dollar_regime_authorized(form: Integer, mode: WholeDollarRoundingRegime) kind institutional {
    label en unofficial "the Secretary has authorized whole-dollar rounding for the form, under the disregard-fraction regime (§6102(a)(1)) or the round-half-up regime (§6102(a)(2))";
}
relation raw_final_amount_on_form(form: Integer, raw: Money) kind institutional {
    label en unofficial "the final amount required to be shown on the form, before §6102 whole-dollar rounding";
}
pub relation rounded_to_whole_dollars(form: Integer, raw: Money, rounded: Money) kind institutional {
    label en unofficial "the §6102(a) whole-dollar rounding of a final return/statement/document amount, under whichever regime the Secretary authorized for the form";
}
@source(IRC_S6102_A, relation = formalizes, coverage = exact, quote = "the fractional part of a dollar shall be disregarded")
rule S6102aDisregardFractionalPart strict {
    for form: Integer;
    for raw: Money;
    when whole_dollar_regime_authorized(form, DisregardFraction) and raw_final_amount_on_form(form, raw);
    then rounded_to_whole_dollars(form, raw, round(raw, 0, "DOWN"));
}
@source(IRC_S6102_A, relation = formalizes, coverage = exact, quote = "the fractional part of a dollar shall be disregarded unless it amounts to one-half dollar or more, in which case the amount (determined without regard to the fractional part of a dollar) shall be increased by $1.")
rule S6102aRoundHalfUp strict {
    for form: Integer;
    for raw: Money;
    when whole_dollar_regime_authorized(form, RoundHalfUp) and raw_final_amount_on_form(form, raw);
    then rounded_to_whole_dollars(form, raw, round(raw, 0, "HALF_UP"));
}

relation elects_not_to_use_whole_dollar_amounts(p: Person, form: Integer) kind empirical;
@source(IRC_S6102_B, relation = formalizes, coverage = exact, quote = "Any person making a return, statement, or other document shall be allowed, under regulations prescribed by the Secretary, to make such return, statement, or other document without regard to subsection (a).")
rule S6102bElectOutOfWholeDollarRounding strict {
    for p: Person;
    for form: Integer;
    when elects_not_to_use_whole_dollar_amounts(p, form)
        and (whole_dollar_regime_authorized(form, DisregardFraction) or whole_dollar_regime_authorized(form, RoundHalfUp));
    then liberty S6102bOptOutOfRounding {
        holder p;
        against Secretary;
        action elects_not_to_use_whole_dollar_amounts(p, form);
        window [-infinity, infinity];
    };
}

// §6102(c): (a)/(b) apply only to the FINAL amount shown on the form, never
// to intermediate computation items — a scope restriction on where
// `rounded_to_whole_dollars` may be invoked. This package does not itself
// chain further downstream computations that would need the guard enforced
// in code; recorded here as a classification note (NON_NORMATIVE as an
// independent rule, EXECUTABLE as the scope clause of (a)/(b) above).
relation s6102c_final_amount_only(unused: Boolean) kind institutional {
    label en unofficial "§6102(c): whole-dollar rounding applies only to the final amount required to be shown on a form, not to computation intermediates";
}
