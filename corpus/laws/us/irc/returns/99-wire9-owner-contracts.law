// Returns -- WIRE-9 (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// Local placeholder relations of this package that name a norm owned by a lower package are derived from the owner's `pub`
// relation. The case-fact channel stays valid: a case may still assert the placeholder directly (the WIRE-7/8 technique).

language "law.core" version "0.2";
package us.irc.returns version "0.1.1";
namespace "urn:us:irc:returns:clir";

use self::{
    Corporation,
    Individual,
    Person,
    TaxableYear,
    foreign_corporation_subject_to_881,
    political_organization_taxable_income,
    standard_deduction_is_zero,
};

// --- section 527(c)(1): political organization taxable income (owner: exempt_organizations) -----------------------------------

rule W9PoliticalOrganizationTaxableIncomeFromOwner(o: Person, y: TaxableYear, amt: Money) strict {
    label en official "the political organization taxable income of section 527(c)(1) is the amount the exempt-organizations package computes";
    when us.irc.exempt_organizations::political_organization_taxable_income(o, y, amt);
    then political_organization_taxable_income(o, y, amt);
}

// --- section 63(c)(6): the standard deduction is zero (owner: gross_income) ---------------------------------------------------

rule W9StandardDeductionIsZeroFromOwner(p: Individual, y: TaxableYear) strict {
    label en official "the section 63(c)(6) zero standard deduction is the conclusion the gross-income package draws";
    when us.irc.gross_income::standard_deduction_zero(p, y);
    then standard_deduction_is_zero(p, y);
}

// --- section 881: a foreign corporation subject to the tax for the year (owner: corporations) ----------------------------------

rule W9ForeignCorporationSubjectToSection881FromOwner(c: Corporation, y: TaxableYear, d: Date, b: Date, e: Date) strict {
    label en official "a corporation that the corporations package records as a foreign corporation subject to tax under section 881 on a day of the taxable year is such a corporation for that year";
    when us.irc.corporations::foreign_corporation_taxed_under_881_1563b2c(c, d);
    when us.irc.core::begins(y, b);
    when us.irc.core::ends(y, e);
    when d >= b;
    when d <= e;
    then foreign_corporation_subject_to_881(c, y);
}
