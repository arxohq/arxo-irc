// STAGE 2 — §6107 (preparer copy/retention duties), §6108 (statistics of
// income), §6109 (identifying numbers).
//
// JUDGMENT CALLS:
//  - §6107(a)/(b) are `duty` positions of the tax return preparer, with
//    (b)'s window a `maintenance` goal over the 3-year retention period
//    (an achievement duty to retain does not fit; the obligation is to
//    KEEP the copy/list in existence, not to perform a one-time act).
//  - §6107(c) (multiple-preparer compliance-sharing) is a `classification`
//    discharging the OTHER preparers' duty when one complies.
//  - §6107(d) cross-references (§6696(e), §6060(c)) are typed institutional
//    dependency contracts — `information-reporting`/`penalties` own those
//    definitions; this package states the borrowed terms locally.
//  - §6108(a) is a `duty` (maintenance, at least annual) of the Secretary;
//    (b) is a `power` of any requesting party conditioned on a fee; (c) is
//    an `immunity`-shaped restriction (protected_effect: taxpayer
//    identification via published statistics) modeled as a `prohibition`
//    on the Secretary's own disclosure since the restriction runs against
//    the Secretary's conduct, not a private party's; (d) is a narrower
//    `duty` triggered by NTA request.
//  - §6109(a)(1)-(4) are `duty` positions (inclusion/furnishing of
//    identifying numbers), each keyed by regulation (the "when required by
//    regulations" clause is a validity precondition, not a separate
//    position). (b) is a `classification` narrowing what counts as a
//    "return...with respect to another person" for (a)(2)/(3) purposes.
//    (c) is a `power` of the Secretary to require identifying information.
//    (d) is a `classification` (SSN as the individual's identifying
//    number). (e) repealed. (f)/(g) (USDA/FCIC access to EINs) are treated
//    as EXTERNAL_DEPENDENCY/NON_NORMATIVE: they regulate a DIFFERENT
//    agency's access to numbers this package's own duties produce, not a
//    taxpayer-facing filing duty of this package's subject matter — no
//    rule (flagged, not silently dropped). (h) is a `duty` (payor/
//    recipient/furnishing triangle for seller-provided financing). (i) is
//    modeled as a `power` of the Secretary to issue ITINs with (3)'s
//    expiration a `classification` computing the ITIN's own validity
//    window.

language "law.core" version "0.2";
package us.irc.returns version "0.1.1";
namespace "urn:us:irc:returns:clir";

use self::{
    IRC_S6107_A,
    IRC_S6107_B,
    IRC_S6108_A,
    IRC_S6108_B,
    IRC_S6108_C,
    IRC_S6108_D,
    IRC_S6109_A,
    IRC_S6109_B,
    IRC_S6109_C,
    IRC_S6109_D,
    IRC_S6109_H,
    IRC_S6109_I,
    Individual,
    Person,
    Return,
    Secretary,
    TaxableYear,
};

// ============================================================================
// §6107 — Preparer must furnish copy; must retain copy or list
// ============================================================================

relation is_tax_return_preparer_of(prep: Person, r: Return) kind empirical;
relation copy_furnished_to_taxpayer(prep: Person, r: Return) kind empirical;
relation return_presented_for_signature(r: Return, d: Date) kind empirical;
@source(IRC_S6107_A, relation = formalizes, coverage = exact, quote = "Any person who is a tax return preparer with respect to any return or claim for refund shall furnish a completed copy of such return or claim to the taxpayer not later than the time such return or claim is presented for such taxpayer's signature.")
rule S6107FurnishCopyDuty strict {
    for prep: Person;
    for r: Return;
    for d: Date;
    when is_tax_return_preparer_of(prep, r) and return_presented_for_signature(r, d);
    then duty FurnishCopyToTaxpayer {
        bearer prep;
        beneficiary Secretary;
        goal achievement {
            condition copy_furnished_to_taxpayer(prep, r);
            window [-infinity, d];
        }
    };
}

relation return_period_ends(r: Return, d: Date) kind institutional {
    label en unofficial "the §6060(c) return period end date for the return (pending: information-reporting owns §6060(c))";
}
relation copy_or_list_retained(prep: Person, r: Return) kind empirical;
relation another_preparer_complied(prep: Person, r: Return) kind empirical {
    label en unofficial "another tax return preparer with respect to the same return has complied with §6107(a)/(b), discharging this preparer's own duty under §6107(c)";
}
@source(IRC_S6107_B, relation = formalizes, coverage = exact, quote = "retain a completed copy of such return or claim, or retain, on a list, the name and taxpayer identification number of the taxpayer for whom such return or claim was prepared")
rule S6107RetainCopyOrListDuty defeasible {
    for prep: Person;
    for r: Return;
    for end: Date;
    when is_tax_return_preparer_of(prep, r) and return_period_ends(r, end);
    then duty RetainCopyOrList {
        bearer prep;
        beneficiary Secretary;
        goal maintenance {
            condition copy_or_list_retained(prep, r);
            window [end, add_calendar_period(end, 36 calendar_month)];
        }
    };
    unless another_preparer_complied(prep, r) and is_tax_return_preparer_of(prep, r) and return_period_ends(r, end);
}

// ============================================================================
// §6108 — Publication of statistics of income
// ============================================================================

relation statistics_of_income_published(y: Integer) kind empirical;
@source(IRC_S6108_A, relation = formalizes, coverage = exact, quote = "The Secretary shall prepare and publish not less than annually statistics reasonably available with respect to the operations of the internal revenue laws")
rule S6108PublishStatisticsDuty strict {
    when true;
    then duty PublishStatisticsOfIncome {
        bearer Secretary;
        goal maintenance {
            condition statistics_of_income_published(0);
            window [-infinity, infinity];
        }
    };
}

relation requests_special_statistical_study(requester: Person, study: Integer) kind empirical;
relation fee_prescribed_for_study(study: Integer, amount: Money) kind institutional;
relation special_study_furnished(requester: Person, study: Integer) kind institutional;
@source(IRC_S6108_B, relation = formalizes, coverage = exact, quote = "The Secretary may, upon written request by any party or parties, make special statistical studies and compilations involving return information (as defined in section 6103(b)(2)) and furnish to such party or parties transcripts of any such special statistical study or compilation.")
rule S6108SpecialStudyPower strict {
    for requester: Person;
    for study: Integer;
    when requests_special_statistical_study(requester, study);
    then power S6108FurnishSpecialStudy {
        holder Secretary;
        over requester;
        exercise requests_special_statistical_study(requester, study);
        valid_when requests_special_statistical_study(requester, study);
        effect create(special_study_furnished(requester, study));
    };
}

relation published_statistics_identify_taxpayer(y: Integer, taxpayer: Person) kind institutional;
@source(IRC_S6108_C, relation = formalizes, coverage = exact, quote = "No publication or other disclosure of statistics or other information required or authorized by subsection (a) or special statistical study authorized by subsection (b) shall in any manner permit the statistics, study, or any information so published, furnished, or otherwise disclosed to be associated with, or otherwise identify, directly or indirectly, a particular taxpayer.")
rule S6108AnonymousFormProhibition strict {
    for y: Integer;
    for taxpayer: Person;
    when statistics_of_income_published(y) and published_statistics_identify_taxpayer(y, taxpayer);
    then prohibition PublishIdentifyingStatistics {
        bearer Secretary;
        action published_statistics_identify_taxpayer(y, taxpayer);
        window [-infinity, infinity];
    };
}

relation nta_requests_statistical_support(request: Integer) kind empirical;
relation nta_statistical_support_provided(request: Integer) kind empirical;
@source(IRC_S6108_D, relation = formalizes, coverage = exact, quote = "Upon request of the National Taxpayer Advocate, the Secretary shall, to the extent practicable, provide the National Taxpayer Advocate with statistical support in connection with the preparation by the National Taxpayer Advocate of the annual report described in section 7803(c)(2)(B)(ii).")
rule S6108NtaStatisticalSupportDuty strict {
    for request: Integer;
    when nta_requests_statistical_support(request);
    then duty ProvideNtaStatisticalSupport {
        bearer Secretary;
        goal achievement {
            condition nta_statistical_support_provided(request);
            window [-infinity, infinity];
        }
    };
}

// ============================================================================
// §6109 — Identifying numbers
// ============================================================================

relation identifying_number_required_by_regulation(p: Person, doc: Integer) kind empirical {
    label en unofficial "the Secretary's regulations require an identifying number for this document (§6109(a) chapeau: \"when required by regulations\")";
}
relation identifying_number_included(p: Person, doc: Integer) kind empirical;
@source(IRC_S6109_A, relation = formalizes, coverage = exact, quote = "Any person required under the authority of this title to make a return, statement, or other document shall include in such return, statement, or other document such identifying number as may be prescribed for securing proper identification of such person.")
rule S6109aInclusionDuty strict {
    for p: Person;
    for doc: Integer;
    when identifying_number_required_by_regulation(p, doc);
    then duty IncludeOwnIdentifyingNumber {
        bearer p;
        beneficiary Secretary;
        goal achievement {
            condition identifying_number_included(p, doc);
            window [-infinity, infinity];
        }
    };
}

relation another_persons_return_requires_this_number(p: Person, other: Person, doc: Integer) kind institutional {
    label en unofficial "another person's return, statement or document is required to show p's identifying number, or a return by another person about p is required (§6109(a)(2))";
}
relation furnishes_number_to_other_person(p: Person, other: Person, doc: Integer) kind empirical;
@source(IRC_S6109_A, relation = formalizes, coverage = exact, quote = "Any person with respect to whom a return, statement, or other document is required under the authority of this title to be made by another person or whose identifying number is required to be shown on a return of another person shall furnish to such other person such identifying number as may be prescribed for securing his proper identification.")
rule S6109aFurnishNumberToOtherPersonDuty strict {
    for p: Person;
    for other: Person;
    for doc: Integer;
    when another_persons_return_requires_this_number(p, other, doc);
    then duty FurnishOwnIdentifyingNumberToOtherPerson {
        bearer p;
        beneficiary other;
        goal achievement {
            condition furnishes_number_to_other_person(p, other, doc);
            window [-infinity, infinity];
        }
    };
}

relation makes_return_with_respect_to_other_person(p: Person, other: Person, doc: Integer) kind empirical;
relation requests_number_from_other_person(p: Person, other: Person, doc: Integer) kind empirical;
relation includes_other_persons_number(p: Person, other: Person, doc: Integer) kind empirical;
@source(IRC_S6109_A, relation = formalizes, coverage = exact, quote = "Any person required under the authority of this title to make a return, statement, or other document with respect to another person shall request from such other person, and shall include in any such return, statement, or other document, such identifying number as may be prescribed for securing proper identification of such other person.")
rule S6109aRequestAndIncludeOtherPersonsNumberDuty strict {
    for p: Person;
    for other: Person;
    for doc: Integer;
    when makes_return_with_respect_to_other_person(p, other, doc);
    then duty RequestAndIncludeOtherPersonsIdentifyingNumber {
        bearer p;
        beneficiary Secretary;
        goal achievement {
            condition requests_number_from_other_person(p, other, doc) and includes_other_persons_number(p, other, doc);
            window [-infinity, infinity];
        }
    };
}

relation return_or_claim_prepared_by_preparer(prep: Person, r: Return) kind empirical;
relation return_bears_preparer_identifying_number(prep: Person, r: Return) kind empirical;
@source(IRC_S6109_A, relation = formalizes, coverage = exact, quote = "Any return or claim for refund prepared by a tax return preparer shall bear such identifying number for securing proper identification of such preparer, his employer, or both, as may be prescribed.")
rule S6109aPreparerIdentifyingNumberDuty strict {
    for prep: Person;
    for r: Return;
    when return_or_claim_prepared_by_preparer(prep, r);
    then duty BearPreparerIdentifyingNumber {
        bearer prep;
        beneficiary Secretary;
        goal achievement {
            condition return_bears_preparer_identifying_number(prep, r);
            window [-infinity, infinity];
        }
    };
}

relation own_liability_return(p: Person, doc: Integer) kind empirical {
    label en unofficial "the return/statement/document is p's OWN return with respect to p's own tax liability (§6109(b)(1) exclusion from being \"with respect to another person\")";
}
relation own_liability_return_excluded_from_other_person_treatment(p: Person, doc: Integer) kind institutional;
@source(IRC_S6109_B, relation = formalizes, coverage = exact, quote = "a return of any person with respect to his liability for tax, or any statement or other document in support thereof, shall not be considered for purposes of paragraphs (2) and (3) of subsection (a) as a return, statement, or other document with respect to another person.")
rule S6109bOwnLiabilityExclusion strict {
    for p: Person;
    for doc: Integer;
    when own_liability_return(p, doc);
    then own_liability_return_excluded_from_other_person_treatment(p, doc);
}
relation estate_or_trust_return(fiduciary: Person, doc: Integer) kind empirical;
relation beneficiary_of_estate_or_trust(fiduciary: Person, beneficiary: Person) kind empirical;
relation estate_or_trust_return_treated_as_re_beneficiary(fiduciary: Person, beneficiary: Person, doc: Integer) kind institutional;
@source(IRC_S6109_B, relation = formalizes, coverage = exact, quote = "a return of an estate or trust with respect to its liability for tax, and any statement or other document in support thereof, shall be considered as a return, statement, or other document with respect to each beneficiary of such estate or trust.")
rule S6109bEstateTrustReturnPerBeneficiary strict {
    for fiduciary: Person;
    for beneficiary: Person;
    for doc: Integer;
    when estate_or_trust_return(fiduciary, doc) and beneficiary_of_estate_or_trust(fiduciary, beneficiary);
    then estate_or_trust_return_treated_as_re_beneficiary(fiduciary, beneficiary, doc);
}

relation secretary_requires_assignment_information(p: Person) kind empirical;
relation assignment_information_required(p: Person) kind institutional;
@source(IRC_S6109_C, relation = formalizes, coverage = exact, quote = "the Secretary is authorized to require such information as may be necessary to assign an identifying number to any person.")
rule S6109cRequireAssignmentInfoPower strict {
    for p: Person;
    when secretary_requires_assignment_information(p);
    then power S6109cRequireAssignmentInformation {
        holder Secretary;
        over p;
        exercise secretary_requires_assignment_information(p);
        valid_when secretary_requires_assignment_information(p);
        effect create(assignment_information_required(p));
    };
}

relation has_social_security_account_number(individual: Individual, ssn: Integer) kind empirical;
pub relation tin_required(p: Person, doc: Integer) kind institutional {
    label en unofficial "the person is required to supply/furnish/include an identifying number for the document (umbrella over §6109(a)(1)-(4))";
}
rule S6109TinRequiredFromInclusion strict {
    for p: Person;
    for doc: Integer;
    when identifying_number_required_by_regulation(p, doc);
    then tin_required(p, doc);
}
rule S6109TinRequiredFromFurnishing strict {
    for p: Person;
    for other: Person;
    for doc: Integer;
    when another_persons_return_requires_this_number(p, other, doc);
    then tin_required(p, doc);
}
rule S6109TinRequiredFromRequestAndInclude strict {
    for p: Person;
    for other: Person;
    for doc: Integer;
    when makes_return_with_respect_to_other_person(p, other, doc);
    then tin_required(p, doc);
}
relation individuals_identifying_number_is_ssn(individual: Individual, ssn: Integer) kind institutional {
    label en unofficial "for purposes of §6109(a)(1)-(3), the individual's identifying number is the individual's social security account number (§6109(a) last sentence, reinforced by (d))";
}
@source(IRC_S6109_A, relation = formalizes, coverage = exact, quote = "For purposes of paragraphs (1), (2), and (3), the identifying number of an individual (or his estate) shall be such individual's social security account number.")
rule S6109IndividualsIdentifyingNumberIsSsn strict {
    for individual: Individual;
    for ssn: Integer;
    when has_social_security_account_number(individual, ssn);
    then individuals_identifying_number_is_ssn(individual, ssn);
}
@source(IRC_S6109_D, relation = formalizes, coverage = exact, quote = "The social security account number issued to an individual for purposes of section 205(c)(2)(A) of the Social Security Act shall, except as shall otherwise be specified under regulations of the Secretary, be used as the identifying number for such individual for purposes of this title.")
rule S6109dSsnUsedAsIdentifyingNumber defeasible {
    for individual: Individual;
    for ssn: Integer;
    when has_social_security_account_number(individual, ssn);
    then individuals_identifying_number_is_ssn(individual, ssn);
    unless regulation_specifies_different_number(individual) and has_social_security_account_number(individual, ssn);
}
relation regulation_specifies_different_number(individual: Individual) kind empirical;

// §6109(e) repealed (Pub. L. 104-188, 1996) — NON_NORMATIVE.
relation s6109_e_repealed(unused: Boolean) kind institutional {
    label en unofficial "§6109(e) repealed by Pub. L. 104-188 (1996) — NON_NORMATIVE, no surviving text";
}
// §6109(f)/(g): USDA/Federal Crop Insurance Corporation access to employer
// identification numbers this package's own duties produce — regulates a
// DIFFERENT agency's downstream access and confidentiality, not a filing
// duty of this package's own subject matter. EXTERNAL_DEPENDENCY, no rule
// (flagged, not silently dropped; see coverage notes and TECH-GAPS).
relation s6109_f_g_external_agency_access(unused: Boolean) kind institutional {
    label en unofficial "§6109(f)/(g): USDA/FCIC access to EINs is a downstream-agency access regime, not this package's own filing duty — EXTERNAL_DEPENDENCY";
}

relation seller_provided_financing(payor: Person, recipient: Person, residence: Integer) kind empirical {
    label en unofficial "indebtedness incurred in acquiring a residence, owed to the person from whom the residence was acquired (§6109(h)(4))";
}
relation claims_qualified_residence_interest_deduction(payor: Person, residence: Integer, y: TaxableYear) kind empirical;
relation payor_includes_recipient_identifying_info(payor: Person, residence: Integer, y: TaxableYear) kind empirical;
@source(IRC_S6109_H, relation = formalizes, coverage = exact, quote = "If any taxpayer claims a deduction under section 163 for qualified residence interest on any seller-provided financing, such taxpayer shall include on the return claiming such deduction the name, address, and TIN of the person to whom such interest is paid or accrued.")
rule S6109hPayorDuty strict {
    for payor: Person;
    for recipient: Person;
    for residence: Integer;
    for y: TaxableYear;
    when seller_provided_financing(payor, recipient, residence) and claims_qualified_residence_interest_deduction(payor, residence, y);
    then duty IncludePayeeIdentifyingInfoForSellerFinancing {
        bearer payor;
        beneficiary Secretary;
        goal achievement {
            condition payor_includes_recipient_identifying_info(payor, residence, y);
            window [-infinity, infinity];
        }
    };
}
relation receives_or_accrues_seller_financing_interest(recipient: Person, payor: Person, residence: Integer, y: TaxableYear) kind empirical;
relation recipient_includes_payor_identifying_info(recipient: Person, residence: Integer, y: TaxableYear) kind empirical;
@source(IRC_S6109_H, relation = formalizes, coverage = exact, quote = "If any person receives or accrues interest referred to in paragraph (1), such person shall include on the return for the taxable year in which such interest is so received or accrued the name, address, and TIN of the person liable for such interest.")
rule S6109hRecipientDuty strict {
    for recipient: Person;
    for payor: Person;
    for residence: Integer;
    for y: TaxableYear;
    when receives_or_accrues_seller_financing_interest(recipient, payor, residence, y);
    then duty IncludePayorIdentifyingInfoForSellerFinancing {
        bearer recipient;
        beneficiary Secretary;
        goal achievement {
            condition recipient_includes_payor_identifying_info(recipient, residence, y);
            window [-infinity, infinity];
        }
    };
}
relation requests_tin_for_seller_financing(requester: Person, other: Person, residence: Integer) kind empirical;
relation furnishes_tin_for_seller_financing(other: Person, requester: Person, residence: Integer) kind empirical;
@source(IRC_S6109_H, relation = formalizes, coverage = exact, quote = "If any person is required to include the TIN of another person on a return under paragraph (1) or (2), such other person shall furnish his TIN to such person.")
rule S6109hFurnishTinDuty strict {
    for requester: Person;
    for other: Person;
    for residence: Integer;
    when requests_tin_for_seller_financing(requester, other, residence);
    then duty FurnishTinForSellerFinancing {
        bearer other;
        beneficiary requester;
        goal achievement {
            condition furnishes_tin_for_seller_financing(other, requester, residence);
            window [-infinity, infinity];
        }
    };
}

relation applies_for_itin_with_documentation(applicant: Individual, application: Integer) kind empirical;
relation applicant_resides_outside_us(applicant: Individual) kind empirical;
relation application_submitted_in_person_or_by_mail_domestic(application: Integer) kind empirical;
relation application_submitted_via_consular_or_mail_or_person_abroad(application: Integer) kind empirical;
relation itin_issued(applicant: Individual, application: Integer) kind institutional;
@source(IRC_S6109_I, relation = formalizes, coverage = partial, quote = "The Secretary is authorized to issue an individual taxpayer identification number to an individual only if the applicant submits an application, using such form as the Secretary may require and including the required documentation")
rule S6109iIssueItinDomesticPower strict {
    for applicant: Individual;
    for application: Integer;
    when applies_for_itin_with_documentation(applicant, application)
        and not_known(applicant_resides_outside_us(applicant));
    then power S6109iIssueItin {
        holder Secretary;
        over applicant;
        exercise applies_for_itin_with_documentation(applicant, application);
        valid_when application_submitted_in_person_or_by_mail_domestic(application);
        effect create(itin_issued(applicant, application));
    };
}
@source(IRC_S6109_I, relation = formalizes, coverage = partial, quote = "in the case of an applicant who resides outside of the United States, by mail or in person to an employee of the Internal Revenue Service, a community-based certifying acceptance agent approved by the Secretary, or a designee of the Secretary at a United States diplomatic mission or consular post.")
rule S6109iIssueItinAbroadPower strict {
    for applicant: Individual;
    for application: Integer;
    when applies_for_itin_with_documentation(applicant, application)
        and applicant_resides_outside_us(applicant);
    then power S6109iIssueItinAbroad {
        holder Secretary;
        over applicant;
        exercise applies_for_itin_with_documentation(applicant, application);
        valid_when application_submitted_via_consular_or_mail_or_person_abroad(application);
        effect create(itin_issued(applicant, application));
    };
}

relation itin_issued_after_2012(applicant: Individual, application: Integer, issue_date: Date) kind empirical;
relation files_return_or_claimed_as_dependent(applicant: Individual, y: TaxableYear) kind empirical;
relation itin_third_consecutive_nonfiling_year_due_date(applicant: Individual, d: Date) kind institutional {
    label en unofficial "the due date of the return of tax for the third consecutive taxable year of nonuse, ending the ITIN's effectiveness (pending: a three-consecutive-year nonuse ledger this package does not maintain — TECH_GAP)";
}
@source(IRC_S6109_I, relation = formalizes, coverage = partial, quote = "such number shall expire on the day after the due date for the return of tax for such third consecutive taxable year.")
rule S6109iItinExpiresAfterThreeYearsNonuse defeasible {
    for applicant: Individual;
    for application: Integer;
    for due: Date;
    when itin_issued(applicant, application) and itin_third_consecutive_nonfiling_year_due_date(applicant, due);
    then itin_effective_window_ends(applicant, application, add_calendar_period(due, 1 calendar_day));
}
relation itin_effective_window_ends(applicant: Individual, application: Integer, d: Date) kind institutional;

relation distinguishes_treaty_only_itins(unused: Boolean) kind institutional {
    label en unofficial "§6109(i)(4): the Secretary implements a system distinguishing ITINs issued solely for treaty-benefit purposes — a Secretary system-design duty with no independently testable taxpayer-facing effect this package can state beyond the duty itself";
}
@source(IRC_S6109_I, relation = formalizes, coverage = exact, quote = "The Secretary shall implement a system that ensures that individual taxpayer identification numbers issued solely for purposes of claiming tax treaty benefits are used only for such purposes, by distinguishing such numbers from other individual taxpayer identification numbers issued.")
rule S6109iDistinguishTreatyItinsDuty strict {
    when true;
    then duty DistinguishTreatyOnlyItins {
        bearer Secretary;
        goal maintenance {
            condition distinguishes_treaty_only_itins(true);
            window [-infinity, infinity];
        }
    };
}
