// 26 U.S.C. Chapter 61 (except Part III) — Information and Returns: the
// filing core of the pilot (DECISION-0379, stage IRC-15 stage 1). The text is
// pinned whole (`sources.law`, generated by
// `corpus/tools/sources/sync/sync_us_irc_fragments.py --package returns` from
// the shared Title 26 snapshot, docs/foundations/us-irc/SOURCE-MANIFEST.json).
//
// STAGE 1 SCOPE (this change): §6001 (records), §6011 (general requirement,
// (a)-(c) and (e) electronic filing thresholds; (d),(f)-(i) lighter
// treatment), §6012 (persons required to make returns of income, (a)(1)-(9),
// (b)-(f)), §6013 (joint returns, (a)-(g)), §6017 (self-employment tax
// returns), §6061-§6065 (signing, verification), §6071 (time for filing,
// general rule and the January 31 rule of (c)), §6072 (time for filing income
// tax returns), §6081 (extension of time, (a)-(b)), §6091 (place for filing).
// STAGE 2 SCOPE (this change, IRC-15 stage 2): §6014 (tax not computed by
// taxpayer), §6015 (relief from joint and several liability, (a)-(h)), §6018
// (estate tax returns), §6019 (gift tax returns), §6020 (returns
// prepared/executed by Secretary), §6021 (listing of taxable objects),
// §6075 (time for filing estate/gift returns), §6096 (Presidential Election
// Campaign Fund designation), §6101 (period covered — non_normative), §6102
// (whole-dollar computation), §6107 (preparer copy/retention duties), §6108
// (statistics of income), §6109 (identifying numbers, (a)-(d),(h)-(i);
// (e) repealed, (f)-(g) flagged external-agency), §6111-§6112 (reportable
// transaction disclosure and material advisor lists), §6113 (nondeductibility
// disclosure), §6114 (treaty-based positions), §6115 (quid pro quo
// disclosure), §6116 (prison inmate data), §6117 (cross-reference); §6016,
// §6017A, §6073, §6074, §6076 are repealed sections (non_normative). See
// docs/foundations/us-irc/coverage/returns.json for the row-by-row
// classification of both stages.
//
// MODULE MAP
//   package.law                      — shared ontology, imports, type
//                                       aliases, and the typed institutional
//                                       dependency contracts this package
//                                       needs from `us.irc.definitions` and
//                                       `us.irc.income_individual` (both
//                                       under concurrent construction — NOT
//                                       imported; declared here so `check`
//                                       is self-contained until the
//                                       coordinator wires the real `pub`)
//   01-records-and-general.law       — §6001 (records), §6011 (general
//                                       requirement of return/statement)
//   02-persons-required-to-file.law  — §6012 (persons required to make
//                                       returns of income)
//   03-joint-returns.law             — §6013 (joint returns)
//   04-signing-and-self-employment.law — §6017 (self-employment tax
//                                       returns), §6061-§6065 (signing and
//                                       verifying returns and other
//                                       documents)
//   05-timing-and-place.law          — §6071 (time for filing, general),
//                                       §6072 (time for filing income tax
//                                       returns), §6081 (extension of time),
//                                       §6091 (place for filing)
//   06-elections-and-relief.law      — §6014 (tax not computed by
//                                       taxpayer), §6015 (relief from joint
//                                       and several liability)
//   07-estate-and-gift-returns.law   — §6018 (estate tax returns), §6019
//                                       (gift tax returns), §6075 (time for
//                                       filing estate/gift returns)
//   08-secretary-prepared-returns.law — §6016/§6017A/§6073/§6074/§6076
//                                       (repealed), §6020 (returns
//                                       prepared/executed by Secretary),
//                                       §6021 (listing of taxable objects)
//   09-campaign-fund-period-rounding.law — §6096 (campaign fund
//                                       designation), §6101 (period
//                                       covered), §6102 (whole-dollar
//                                       computation)
//   10-preparer-duties-and-tin.law   — §6107 (preparer copy/retention),
//                                       §6108 (statistics of income), §6109
//                                       (identifying numbers)
//   11-disclosure-duties.law         — §6111-§6112 (reportable transaction
//                                       disclosure/lists), §6113
//                                       (nondeductibility disclosure), §6114
//                                       (treaty positions), §6115 (quid pro
//                                       quo disclosure), §6116 (prison
//                                       inmate data), §6117 (cross-reference)
//
// JUDGMENT CALLS AND EXTERNAL DEPENDENCIES (see report; also flagged inline
// at each use site):
//  - `filing_status`, `gross_income_amount`, `exemption_amount_for_year`,
//    `basic_standard_deduction_amount`, `additional_standard_deduction_total`,
//    `dependent_unearned_income_excess`, `standard_deduction_is_zero`,
//    `spouse_of`, `resident_alien`/`nonresident_alien` are typed
//    institutional dependency contracts this package needs from
//    `us.irc.income_individual` (§§1-2, 63, 151) and `us.irc.definitions`
//    (§§7701(b), 7703) — both packages are being written concurrently and
//    are NOT imported (per task instruction). Each relation below names its
//    producer section in a comment; the coordinator wires the real `pub`
//    when both packages exist. Cross-references to §§63, 151, 1, 2, 7703,
//    527, 528, 921/922 already have auto-extracted edges in
//    DEPENDENCIES.json (owner columns `income-individual`/`definitions`/
//    `exempt-organizations`); this package adds no hand edge, consistent
//    with how the joint-committee pilot treated its own pending
//    cross-references.
//  - The federal business-day/holiday rollover of due dates (§7503) is
//    `administration`'s norm (already pending in DEPENDENCIES.json); this
//    package's `due_date`/`return_due_date` relations compute the STATUTORY
//    calendar date only, never the rolled-forward date.

language "law.core" version "0.2";
package us.irc.returns version "0.1.1";
namespace "urn:us:irc:returns:clir";

import us.irc.core version "0.1.1";
import us.irc.exempt_organizations version "0.1.1";
import us.irc.gross_income version "0.1.1";
import us.irc.corporations version "0.1.1";
import us.irc.property_transactions version "0.1.1";

type Person = us.irc.core::Person;
type Individual = us.irc.core::Individual;
type Corporation = us.irc.core::Corporation;
type Partnership = us.irc.core::Partnership;
type Trust = us.irc.core::Trust;
type Estate = us.irc.core::Estate;
type Organ = us.irc.core::Organ;
type TaxableYear = us.irc.core::TaxableYear;
type Return = us.irc.core::Return;

const Secretary: Organ = us.irc.core::Secretary;

// --- Typed institutional dependency contracts (pending, see header) --------

enum FilingStatusKind {
    Single;
    HeadOfHousehold;
    SurvivingSpouse;
    MarriedFilingJointly;
    MarriedFilingSeparately;
}

// Pending: us.irc.income_individual (§§1-2) / us.irc.definitions (§7703) —
// the actual filing-status classification test.
relation filing_status(p: Individual, y: TaxableYear, status: FilingStatusKind) kind institutional {
    label en unofficial "the individual's filing status for the taxable year (§§1-2, 7703 — not this package's norm)";
}
// Pending: us.irc.definitions (§7703) — marital status / spouse identity.
relation spouse_of(p: Individual, s: Individual) kind institutional {
    label en unofficial "the individual named as spouse under §7703's marital-status test (not this package's norm)";
}
// Pending: us.irc.definitions (§7701(b)) — resident/nonresident alien test.
relation nonresident_alien(p: Individual) kind institutional {
    label en unofficial "the individual is a nonresident alien under §7701(b) (not this package's norm)";
}
// Pending: us.irc.income_individual / us.irc.gross_income — the computed
// gross income amount of the person for the year.
relation gross_income_amount(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the person's gross income for the taxable year (not this package's norm)";
}
// Pending: us.irc.income_individual (§151(d)) — the exemption amount is $0
// for taxable years 2018-2025 per §151(d)(5), but this package does not
// invent that value; it reads it as a fact from the producer.
relation exemption_amount_for_year(y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the §151(d) exemption amount in effect for the taxable year (not this package's norm)";
}
// Pending: us.irc.income_individual (§63(c)) — basic standard deduction by
// filing status.
relation basic_standard_deduction_amount(y: TaxableYear, status: FilingStatusKind, amount: Money) kind institutional {
    label en unofficial "the §63(c) basic standard deduction applicable to the filing status for the taxable year (not this package's norm)";
}
// Pending: us.irc.income_individual (§63(f)) — additional standard
// deduction(s) for age/blindness, already summed for the person and year.
relation additional_standard_deduction_total(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the sum of the individual's §63(f) additional standard deduction(s) for the taxable year (not this package's norm)";
}
// Pending: us.irc.income_individual (§63(c)(5)) — the dependent
// unearned-income-excess test of §6012(a)(1)(C)(i).
relation dependent_unearned_income_excess(p: Individual, y: TaxableYear) kind institutional {
    label en unofficial "the individual is described in §63(c)(5) and has unearned/total income in excess of the amount that section fixes (not this package's norm)";
}
// Pending: us.irc.income_individual (§63(c)(6)) — the zero-standard-deduction
// test of §6012(a)(1)(C)(ii).
relation standard_deduction_is_zero(p: Individual, y: TaxableYear) kind institutional {
    label en unofficial "the individual's standard deduction is zero under §63(c)(6) (not this package's norm)";
}
// Pending: us.irc.definitions (§151(c)) — another taxpayer's dependency
// exemption for the spouse, used by §6012(a)(1)(A)(iv)'s own exception.
relation other_taxpayer_claims_spouse_exemption(p: Individual, y: TaxableYear) kind institutional {
    label en unofficial "some other taxpayer is entitled to an exemption for the individual's spouse under §151(c) (not this package's norm)";
}
