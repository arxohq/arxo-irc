// §6013 — Joint returns of income tax by husband and wife.
//
// JUDGMENT CALLS AND GAPS (see report):
//  - §6013(a) is modeled as a `power`: the couple's joint election changes
//    their legal position (joint and several liability under (d)(3)), so it
//    fits `power` better than `liberty` even though the text uses "may".
//  - §6013(b) is modeled as a `power` held jointly (both spouses as one
//    `holder` slot is not expressible; modeled with `holder` the individual
//    who filed separately and `over` the spouse, since (b)(1)'s last
//    sentence lets the surviving spouse's executor disaffirm — the
//    asymmetry is real, not an approximation).
//  - §6013(b)(2)'s four time limits are `valid_when` conditions on the
//    SAME power, combined with `and`/`not` inside `unless`-style negation
//    predicates rather than in `valid_when` itself (a `valid_when` slot
//    takes one atom per DECISION-0194/lessons-from-pilot); a single derived
//    relation `election_after_separate_return_timely` bundles the four
//    conjuncts.
//  - §6013(b)(3)-(5) (deemed-filed date for limitations purposes, the
//    additional assessment year, and the penalty-coordination rules) read
//    §§6501, 6502, 6511, and part II of subchapter A of chapter 68 — all
//    owned by `assessment`/`payment-refunds-interest`/`penalties`. This
//    package states the deeming rule itself (its own text) but not those
//    owners' consuming computations — EXTERNAL_DEPENDENCY at the consuming
//    end, EXECUTABLE at the deeming relation itself.
//  - §6013(e) was repealed by Pub. L. 105-206 (1998) — NON_NORMATIVE,
//    superseded text, no rule.
//  - §6013(f) (missing status) is a narrow, largely obsolete wartime
//    election (Vietnam-era combat zones); modeled lightly as a `power` with
//    its own `valid_when`, without separately modeling the uniformed-
//    services/civilian-employee "missing status" tests of (f)(3), which are
//    pending institutional facts from `administration`/`definitions`.
//  - §6013(g) is modeled as a `power` (the election changes tax treatment
//    for both chapter 1 and chapter 24 purposes) with `valid_when` the
//    (g)(2) eligibility test; (g)(4)/(5) (termination events, including the
//    Secretary's own termination power) are modeled as separate powers
//    changing the SAME election-in-effect relation.

language "law.core" version "0.2";
package us.irc.returns version "0.1.1";
namespace "urn:us:irc:returns:clir";

use self::{
    IRC_S6013_A,
    IRC_S6013_B,
    IRC_S6013_C,
    IRC_S6013_D,
    IRC_S6013_F,
    IRC_S6013_G,
    Individual,
    Person,
    Secretary,
    TaxableYear,
    executor_or_administrator_of,
    missing_status_joint_return_window_open,
    nonresident_alien,
    nonresident_alien_in_taxable_year,
    spouse_of,
    statutory_due_date,
};

// ============================================================================
// (a) Joint returns
// ============================================================================

relation makes_joint_return(p: Individual, s: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the individual and spouse make a single joint return of income taxes under subtitle A";
}
relation joint_return_in_effect(p: Individual, s: Individual, y: TaxableYear) kind institutional {
    label en unofficial "a joint return of the couple is in effect for the taxable year under §6013(a)";
}
relation either_spouse_nonresident_alien_during_year(p: Individual, s: Individual, y: TaxableYear) kind empirical;
relation spouses_have_different_taxable_years(p: Individual, s: Individual, y: TaxableYear) kind empirical;
relation joint_return_death_exception_applies(p: Individual, s: Individual, y: TaxableYear) kind institutional {
    label en unofficial "the spouses' taxable years began the same day and ended on different days solely because of the death of either or both (§6013(a)(2)'s own exception), and the survivor did not remarry before the close of the taxable year, and neither taxable year is a short §443(a)(1) year";
}
@source(IRC_S6013_A, relation = formalizes, coverage = partial, quote = "A husband and wife may make a single return jointly of income taxes under subtitle A, even though one of the spouses has neither gross income nor deductions, except as provided below:")
rule S6013MakeJointReturn strict {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    when makes_joint_return(p, s, y);
    then power S6013MakeJointReturnPower {
        holder p;
        over s;
        exercise makes_joint_return(p, s, y);
        valid_when spouse_of(s, p);
        effect create(joint_return_in_effect(p, s, y));
    };
}
@source(IRC_S6013_A, relation = formalizes, coverage = exact, quote = "no joint return shall be made if either the husband or wife at any time during the taxable year is a nonresident alien;")
rule S6013NoJointReturnNonresidentAlien strict {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    when either_spouse_nonresident_alien_during_year(p, s, y);
    then joint_return_barred(p, s, y);
}
relation joint_return_barred(p: Individual, s: Individual, y: TaxableYear) kind institutional;
@source(IRC_S6013_A, relation = formalizes, coverage = partial, quote = "no joint return shall be made if the husband and wife have different taxable years; except that if such taxable years begin on the same day and end on different days because of the death of either or both, then the joint return may be made with respect to the taxable year of each.")
rule S6013NoJointReturnDifferentTaxableYears defeasible {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    when spouses_have_different_taxable_years(p, s, y);
    then joint_return_barred(p, s, y);
    unless joint_return_death_exception_applies(p, s, y);
}

relation decedent_return_no_executor_appointed(p: Individual, y: TaxableYear) kind empirical {
    label en unofficial "no return for the taxable year has been made by the decedent, no executor or administrator has been appointed, and none is appointed before the last day prescribed by law for filing the surviving spouse's return";
}
@source(IRC_S6013_A, relation = formalizes, coverage = partial, quote = "in the case of the death of one spouse the joint return may be made by the surviving spouse with respect to both himself and the decedent if no return for the taxable year has been made by the decedent, no executor or administrator has been appointed, and no executor or administrator is appointed before the last day prescribed by law for filing the return of the surviving spouse.")
rule S6013SurvivorMakesJointReturnForDecedent strict {
    for survivor: Individual;
    for decedent: Individual;
    for y: TaxableYear;
    when spouse_of(decedent, survivor) and decedent_return_no_executor_appointed(decedent, y) and makes_joint_return(survivor, decedent, y);
    then power S6013SurvivorMakesJointReturnPower {
        holder survivor;
        over decedent;
        exercise makes_joint_return(survivor, decedent, y);
        valid_when decedent_return_no_executor_appointed(decedent, y);
        effect create(joint_return_in_effect(survivor, decedent, y));
    };
}
relation executor_disaffirms_joint_return(executor: Person, decedent: Individual, y: TaxableYear) kind empirical;
relation decedent_separate_return_after_disaffirmance(decedent: Individual, y: TaxableYear) kind institutional;
@source(IRC_S6013_A, relation = formalizes, coverage = partial, quote = "If an executor or administrator of the decedent is appointed after the making of the joint return by the surviving spouse, the executor or administrator may disaffirm such joint return by making, within 1 year after the last day prescribed by law for filing the return of the surviving spouse, a separate return for the taxable year of the decedent with respect to which the joint return was made, in which case the return made by the survivor shall constitute his separate return.")
rule S6013ExecutorDisaffirmsJointReturn strict {
    for executor: Person;
    for decedent: Individual;
    for survivor: Individual;
    for y: TaxableYear;
    when executor_or_administrator_of(executor, decedent)
        and joint_return_in_effect(survivor, decedent, y)
        and executor_disaffirms_joint_return(executor, decedent, y);
    then power S6013ExecutorDisaffirmsJointReturnPower {
        holder executor;
        over decedent;
        exercise executor_disaffirms_joint_return(executor, decedent, y);
        valid_when joint_return_in_effect(survivor, decedent, y);
        effect create(decedent_separate_return_after_disaffirmance(decedent, y));
    };
}

// ============================================================================
// (b) Joint return after filing separate return
// ============================================================================

relation filed_separate_return(p: Individual, y: TaxableYear) kind empirical;
relation time_for_filing_expired(y: TaxableYear) kind institutional {
    label en unofficial "the time prescribed by law for filing the return for the taxable year has expired";
}
relation makes_joint_return_after_separate(p: Individual, s: Individual, y: TaxableYear) kind empirical;
relation joint_return_after_separate_in_effect(p: Individual, s: Individual, y: TaxableYear) kind institutional {
    label en unofficial "a §6013(b) joint return, made after a separate return, constitutes the couple's return for the taxable year";
}

relation notice_of_deficiency_and_petition_filed(p: Individual, s: Individual, y: TaxableYear) kind empirical {
    label en unofficial "a notice of deficiency under §6212 has been mailed to either spouse with respect to the taxable year, and the spouse has filed a Tax Court petition within the §6213 time (§6013(b)(2)(B))";
}
relation suit_commenced_for_recovery(p: Individual, s: Individual, y: TaxableYear) kind empirical {
    label en unofficial "either spouse has commenced a suit in any court for the recovery of any part of the tax for the taxable year (§6013(b)(2)(C))";
}
relation closing_agreement_or_compromise(p: Individual, s: Individual, y: TaxableYear) kind empirical {
    label en unofficial "either spouse has entered into a §7121 closing agreement, or a civil or criminal case has been compromised under §7122, with respect to the taxable year (§6013(b)(2)(D))";
}
relation three_years_from_last_filing_date_expired(y: TaxableYear) kind institutional {
    label en unofficial "more than 3 years have elapsed from the last date prescribed by law for filing the return for the taxable year, determined without regard to any extension granted to either spouse (§6013(b)(2)(A))";
}
relation election_after_separate_return_timely(p: Individual, s: Individual, y: TaxableYear) kind institutional {
    label en unofficial "none of §6013(b)(2)'s four bars to the joint-return election applies";
}
@source(IRC_S6013_B, relation = formalizes, coverage = partial, quote = "The election provided for in paragraph (1) may not be made—")
rule S6013ElectionAfterSeparateReturnTimely strict {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    when filed_separate_return(p, y)
        and spouse_of(p, s)
        and not_known(three_years_from_last_filing_date_expired(y))
        and not_known(notice_of_deficiency_and_petition_filed(p, s, y))
        and not_known(suit_commenced_for_recovery(p, s, y))
        and not_known(closing_agreement_or_compromise(p, s, y));
    then election_after_separate_return_timely(p, s, y);
}

@source(IRC_S6013_B, relation = formalizes, coverage = partial, quote = "if an individual has filed a separate return for a taxable year for which a joint return could have been made by him and his spouse under subsection (a) and the time prescribed by law for filing the return for such taxable year has expired, such individual and his spouse may nevertheless make a joint return for such taxable year.")
rule S6013JointReturnAfterSeparateReturn strict {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    when filed_separate_return(p, y)
        and time_for_filing_expired(y)
        and spouse_of(p, s)
        and not_known(joint_return_barred(p, s, y))
        and makes_joint_return_after_separate(p, s, y);
    then power S6013JointReturnAfterSeparatePower {
        holder p;
        over s;
        exercise makes_joint_return_after_separate(p, s, y);
        valid_when election_after_separate_return_timely(p, s, y);
        effect create(joint_return_after_separate_in_effect(p, s, y));
    };
}

relation deemed_filed_on(p: Individual, s: Individual, y: TaxableYear, d: Date) kind institutional {
    label en unofficial "the date on which the §6013(b) joint return is deemed filed, for purposes of §§6501 (assessment/collection limitations) and 6651 (delinquency)";
}
relation both_spouses_filed_separate_first(p: Individual, s: Individual, y: TaxableYear) kind empirical;
relation last_separate_return_filed_on(p: Individual, s: Individual, y: TaxableYear, d: Date) kind empirical;
@source(IRC_S6013_B, relation = formalizes, coverage = partial, quote = "Where both spouses filed separate returns prior to making the joint return—on the date the last separate return was filed (but not earlier than the last date prescribed by law for filing the return of either spouse);")
rule S6013DeemedFiledBothSeparate strict {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    for d: Date;
    when both_spouses_filed_separate_first(p, s, y) and last_separate_return_filed_on(p, s, y, d) and joint_return_after_separate_in_effect(p, s, y);
    then deemed_filed_on(p, s, y, d);
}

@source(IRC_S6013_B, relation = formalizes, coverage = exact, quote = "For purposes of section 6511, a joint return made under this subsection shall be deemed to have been filed on the last date prescribed by law for filing the return for such taxable year (determined without regard to any extension of time granted to either spouse).")
rule S6013DeemedFiledForRefundPurposes defeasible {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    for d: Date;
    when joint_return_after_separate_in_effect(p, s, y) and statutory_due_date(p, y, us.irc.core::IncomeCh1, d);
    then deemed_filed_for_refund_purposes(p, s, y, d);
}
relation deemed_filed_for_refund_purposes(p: Individual, s: Individual, y: TaxableYear, d: Date) kind institutional {
    label en unofficial "for §6511 (credit or refund) purposes, the §6013(b) joint return is deemed filed on the taxable year's last prescribed filing date, without regard to extensions";
}

relation additional_assessment_year_after_joint_return(p: Individual, s: Individual, y: TaxableYear) kind institutional {
    label en unofficial "the §§6501/6502 limitations periods include one year immediately after the joint return's actual filing date (§6013(b)(4)), computed without regard to the (b)(3) deeming rule";
}
@source(IRC_S6013_B, relation = formalizes, coverage = exact, quote = "If a joint return is made under this subsection, the periods of limitations provided in sections 6501 and 6502 on the making of assessments and the beginning of levy or a proceeding in court for collection shall with respect to such return include one year immediately after the date of the filing of such joint return (computed without regard to the provisions of paragraph (3)).")
rule S6013AdditionalAssessmentYear strict {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    when joint_return_after_separate_in_effect(p, s, y);
    then additional_assessment_year_after_joint_return(p, s, y);
}

// (b)(5) additions to tax / criminal-penalty coordination: consuming
// computations owned by `assessment`/`penalties`/`crimes` —
// EXTERNAL_DEPENDENCY; the deeming facts above are this package's own norm.

// ============================================================================
// (c) Treatment of joint return after death of either spouse
// ============================================================================

relation joint_return_treated_as_ending_with_survivor(p: Individual, s: Individual, y: TaxableYear) kind institutional {
    label en unofficial "for §§15, 443, and 7851(a)(1)(A) purposes, the joint return is treated as if both spouses' taxable years ended on the date the surviving spouse's taxable year closed";
}
@source(IRC_S6013_C, relation = formalizes, coverage = exact, quote = "For purposes of sections 15, 443, and 7851(a)(1)(A), where the husband and wife have different taxable years because of the death of either spouse, the joint return shall be treated as if the taxable years of both spouses ended on the date of the closing of the surviving spouse's taxable year.")
rule S6013JointReturnTreatedAsEndingWithSurvivor strict {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    when joint_return_death_exception_applies(p, s, y) and joint_return_in_effect(p, s, y);
    then joint_return_treated_as_ending_with_survivor(p, s, y);
}

// ============================================================================
// (d) Special rules
// ============================================================================

relation legally_separated_under_decree(p: Individual) kind empirical {
    label en unofficial "the individual is legally separated from the spouse under a decree of divorce or of separate maintenance";
}
relation considered_married_for_section_6013(p: Individual) kind institutional;
@source(IRC_S6013_D, relation = formalizes, coverage = exact, quote = "an individual who is legally separated from his spouse under a decree of divorce or of separate maintenance shall not be considered as married; and")
rule S6013LegallySeparatedNotConsideredMarried strict {
    for p: Individual;
    for s: Individual;
    when spouse_of(p, s) and not_known(legally_separated_under_decree(p));
    then considered_married_for_section_6013(p);
}

relation joint_and_several_liability(p: Individual, s: Individual, y: TaxableYear) kind institutional {
    label en unofficial "the tax on the couple's joint return is computed on the aggregate income, and liability with respect to it is joint and several";
}
@source(IRC_S6013_D, relation = formalizes, coverage = exact, quote = "if a joint return is made, the tax shall be computed on the aggregate income and the liability with respect to the tax shall be joint and several.")
rule S6013JointAndSeveralLiability strict {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    when joint_return_in_effect(p, s, y) or joint_return_after_separate_in_effect(p, s, y);
    then joint_and_several_liability(p, s, y);
}

// §6013(e) was repealed by Pub. L. 105-206, title III, §3201(e)(1) (1998) —
// NON_NORMATIVE, superseded text; no rule stated here.

// ============================================================================
// (f) Joint return where individual is in missing status
// ============================================================================
// Narrow, largely obsolete combat-zone election; modeled lightly. The
// uniformed-services/civilian-employee "missing status" tests of (f)(3) are
// pending institutional facts (owner: `administration`/`definitions`, not
// yet assigned).

relation in_missing_status(p: Individual) kind institutional {
    label en unofficial "the individual is in a missing status as a result of service in a combat zone, within the meaning of §112 (§6013(f)(3)) — pending, not this package's norm";
}
relation elects_joint_return_for_missing_individual(spouse: Individual, missing: Individual, y: TaxableYear) kind empirical;
relation missing_status_joint_election_in_effect(spouse: Individual, missing: Individual, y: TaxableYear) kind institutional;
relation combat_zone_termination_window_open(y: TaxableYear) kind institutional {
    label en unofficial "the taxable year begins on or before the day 2 years after the §112 combat-zone termination date (or, for the Vietnam-conflict zone, at any time while the individual is in missing status) (§6013(f)(1)(B)) — pending, not this package's norm";
}
@source(IRC_S6013_F, relation = formalizes, coverage = partial, quote = "then such spouse may elect under subsection (a) to file a joint return for such taxable year.")
rule S6013MissingStatusJointElection strict {
    for spouse: Individual;
    for missing: Individual;
    for y: TaxableYear;
    when in_missing_status(missing)
        and spouse_of(missing, spouse)
        and elects_joint_return_for_missing_individual(spouse, missing, y);
    then power S6013MissingStatusJointElectionPower {
        holder spouse;
        over missing;
        exercise elects_joint_return_for_missing_individual(spouse, missing, y);
        valid_when missing_status_joint_return_window_open(missing, y);
        effect create(missing_status_joint_election_in_effect(spouse, missing, y));
    };
}

// ============================================================================
// (g) Election to treat nonresident alien individual as resident
// ============================================================================

relation elects_resident_treatment(p: Individual, s: Individual, y: TaxableYear) kind empirical {
    label en unofficial "both the nonresident alien individual and the citizen-or-resident spouse elect to have §6013(g) apply for the taxable year";
}
relation section_6013g_in_effect(p: Individual, y: TaxableYear) kind institutional {
    label en unofficial "the §6013(g) election is in effect for the individual for the taxable year";
}
relation married_to_citizen_or_resident_at_close_of_year(p: Individual, s: Individual, y: TaxableYear) kind empirical;
@source(IRC_S6013_G, relation = formalizes, coverage = exact, quote = "This subsection shall be in effect with respect to any individual who, at the close of the taxable year for which an election under this subsection was made, was a nonresident alien individual married to a citizen or resident of the United States, if both of them made such election to have the benefits of this subsection apply to them.")
rule S6013ElectResidentTreatment strict {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    when (nonresident_alien(p) or nonresident_alien_in_taxable_year(p, y))
        and married_to_citizen_or_resident_at_close_of_year(p, s, y)
        and elects_resident_treatment(p, s, y);
    then power S6013ElectResidentTreatmentPower {
        holder p;
        over s;
        exercise elects_resident_treatment(p, s, y);
        valid_when married_to_citizen_or_resident_at_close_of_year(p, s, y);
        effect create(section_6013g_in_effect(p, y));
    };
}

relation treated_as_resident_for_chapter1(p: Individual, y: TaxableYear) kind institutional;
@source(IRC_S6013_G, relation = formalizes, coverage = partial, quote = "A nonresident alien individual with respect to whom this subsection is in effect for the taxable year shall be treated as a resident of the United States—")
rule S6013TreatedAsResidentChapter1 strict {
    for p: Individual;
    for y: TaxableYear;
    when section_6013g_in_effect(p, y);
    then treated_as_resident_for_chapter1(p, y);
}

relation revokes_section_6013g_election(p: Individual, y: TaxableYear) kind empirical;
@source(IRC_S6013_G, relation = formalizes, coverage = exact, quote = "If either taxpayer revokes the election, as of the first taxable year for which the last day prescribed by law for filing the return of tax under chapter 1 has not yet occurred.")
rule S6013RevokeSection6013gElection strict {
    for p: Individual;
    for y: TaxableYear;
    when section_6013g_in_effect(p, y) and revokes_section_6013g_election(p, y);
    then power S6013RevokeSection6013gElectionPower {
        holder p;
        exercise revokes_section_6013g_election(p, y);
        valid_when section_6013g_in_effect(p, y);
        effect destroy(section_6013g_in_effect(p, y));
    };
}

relation secretary_terminates_section_6013g_election(p: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the Secretary terminates the §6013(g) election because either spouse failed to keep or grant access to books and records, or supply other information reasonably necessary to ascertain chapter 1 tax liability";
}
external judgment relation section_6013g_records_failure(p: Individual, y: TaxableYear) {
    authority Secretary;
    label en official "either spouse has failed to keep such books and records, grant such access, or supply such other information as may be reasonably necessary to ascertain the amount of liability for taxes under chapter 1";
}
@source(IRC_S6013_G, relation = formalizes, coverage = partial, quote = "The Secretary may terminate any election under this subsection for any taxable year if he determines that either spouse has failed—")
rule S6013SecretaryTerminatesElection strict {
    for p: Individual;
    for y: TaxableYear;
    when section_6013g_in_effect(p, y) and secretary_terminates_section_6013g_election(p, y);
    then power S6013SecretaryTerminatesElectionPower {
        holder Secretary;
        over p;
        exercise secretary_terminates_section_6013g_election(p, y);
        valid_when section_6013g_records_failure(p, y);
        effect destroy(section_6013g_in_effect(p, y));
    };
}
