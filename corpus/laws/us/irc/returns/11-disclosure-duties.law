// STAGE 2 — §6111 (material advisor disclosure of reportable transactions),
// §6112 (material advisor lists), §6113 (nondeductibility-of-contributions
// disclosure), §6114 (treaty-based return positions), §6115 (quid pro quo
// contribution disclosure), §6116 (prisoner information for the IRS), §6117
// (cross-reference).
//
// JUDGMENT CALLS:
//  - §6111(a) is a `duty` of the material advisor; the "reportable
//    transaction" and threshold-based "material advisor" definitions are
//    local classifications reading §6707A(c) as a typed dependency
//    contract (owned by `penalties`, not imported).
//  - §6112(a) is a `duty` (maintenance — a list kept current, not a one-time
//    filing); (b)(1) is a further maintenance duty (7-year retention) plus
//    a `duty` to make the list available on written request.
//  - §6113(a) is a `duty` of the SOLICITING ORGANIZATION (not a
//    prohibition — the statute requires an affirmative disclosure
//    statement, it does not forbid solicitation); (b)'s scope and
//    small-organization/fraternal exceptions are `unless` defeaters;
//    (b)(2)(B) (multiple-organization anti-avoidance aggregation) is
//    EXTERNAL_DEPENDENCY/EVALUATIVE (Secretary discretion, no self-
//    executing aggregation formula) — flagged.
//  - §6114(a) is a `duty` of the taxpayer; (b) (Secretary waiver) is a
//    `power` producing an exception fact consumed by (a)'s `unless`.
//  - §6115(a) is a `duty` of the donee organization triggered by receipt of
//    a quid pro quo contribution over $75; (b) is the definitional
//    classification, including the intangible-religious-benefit carve-out
//    as an `unless` on the classification itself (not on the duty).
//  - §6116 is modeled as `institutional_effect`/`duty` positions of the
//    Bureau of Prisons / state prison agencies (NOT this package's own
//    taxpayer-facing filing duties, but a duty the statute itself places on
//    non-IRS government actors feeding this package's TIN-verification
//    ecosystem) — EXECUTABLE, since the text is fully self-executing
//    (deadline, content list, format-setting power).
//  - §6117 is a pure cross-reference to §4102 (excise fuel records) —
//    NON_NORMATIVE.

language "law.core" version "0.2";
package us.irc.returns version "0.1.1";
namespace "urn:us:irc:returns:clir";

use self::{
    IRC_S6111_A,
    IRC_S6111_B,
    IRC_S6112_A,
    IRC_S6112_B,
    IRC_S6113_A,
    IRC_S6113_B,
    IRC_S6113_C,
    IRC_S6114_A,
    IRC_S6114_B,
    IRC_S6115_A,
    IRC_S6115_B,
    IRC_S6116_A,
    IRC_S6116_C,
    Organ,
    Person,
    Secretary,
};

// ============================================================================
// §6111 — Disclosure of reportable transactions
// ============================================================================

relation reportable_transaction(transaction: Integer) kind institutional {
    label en unofficial "the transaction is a reportable transaction within the meaning of §6707A(c) (pending: penalties owns §6707A(c))";
}
relation provides_material_aid_re_transaction(advisor: Person, transaction: Integer) kind empirical {
    label en unofficial "the person provides material aid, assistance, or advice with respect to organizing, managing, promoting, selling, implementing, insuring, or carrying out the transaction (§6111(b)(1)(A)(i))";
}
relation gross_income_derived_from_advice(advisor: Person, transaction: Integer, amount: Money) kind institutional;
relation substantially_all_benefits_to_natural_persons(transaction: Integer) kind empirical;
relation material_advisor_threshold_amount(transaction: Integer, threshold: Money) kind institutional {
    label en unofficial "the §6111(b)(1)(B) threshold: $50,000 if substantially all tax benefits go to natural persons, else $250,000";
}
@source(IRC_S6111_B, relation = formalizes, coverage = exact, quote = "$50,000 in the case of a reportable transaction substantially all of the tax benefits from which are provided to natural persons, and")
rule S6111ThresholdNaturalPersons strict {
    for transaction: Integer;
    when substantially_all_benefits_to_natural_persons(transaction);
    then material_advisor_threshold_amount(transaction, 50000.00 USD);
}
@source(IRC_S6111_B, relation = formalizes, coverage = exact, quote = "$250,000 in any other case.")
rule S6111ThresholdOtherCases strict {
    for transaction: Integer;
    when reportable_transaction(transaction) and not_known(substantially_all_benefits_to_natural_persons(transaction));
    then material_advisor_threshold_amount(transaction, 250000.00 USD);
}
relation is_material_advisor(advisor: Person, transaction: Integer) kind institutional {
    label en unofficial "the person is a material advisor with respect to the reportable transaction (§6111(b)(1))";
}
@source(IRC_S6111_B, relation = formalizes, coverage = exact, quote = "who directly or indirectly derives gross income in excess of the threshold amount (or such other amount as may be prescribed by the Secretary) for such aid, assistance, or advice.")
rule S6111IsMaterialAdvisor strict {
    for advisor: Person;
    for transaction: Integer;
    for income: Money;
    for threshold: Money;
    when provides_material_aid_re_transaction(advisor, transaction)
        and gross_income_derived_from_advice(advisor, transaction, income)
        and material_advisor_threshold_amount(transaction, threshold)
        and income > threshold;
    then is_material_advisor(advisor, transaction);
}
relation one_advisor_designated_for_multiple(advisor: Person, transaction: Integer, others: Integer) kind empirical {
    label en unofficial "under §6111(c)(1) regulations, only this advisor is required to meet §6111(a) for the transaction, discharging the others";
}
relation reportable_transaction_disclosure_filed(advisor: Person, transaction: Integer) kind empirical;
@source(IRC_S6111_A, relation = formalizes, coverage = exact, quote = "Each material advisor with respect to any reportable transaction shall make a return (in such form as the Secretary may prescribe) setting forth")
rule S6111DisclosureDuty defeasible {
    for advisor: Person;
    for transaction: Integer;
    when is_material_advisor(advisor, transaction) and reportable_transaction(transaction);
    then duty DiscloseReportableTransaction {
        bearer advisor;
        beneficiary Secretary;
        goal achievement {
            condition reportable_transaction_disclosure_filed(advisor, transaction);
            window [-infinity, infinity];
        }
    };
    unless one_advisor_designated_for_multiple(advisor, transaction, advisor) and is_material_advisor(advisor, transaction);
}
pub relation reportable_transaction_disclosure_required(advisor: Person, transaction: Integer) kind institutional {
    label en unofficial "the material advisor must disclose the reportable transaction under §6111(a) (umbrella flag, net of the §6111(c)(1) multiple-advisor discharge)";
}
rule S6111DisclosureRequiredFlag defeasible {
    for advisor: Person;
    for transaction: Integer;
    when is_material_advisor(advisor, transaction) and reportable_transaction(transaction);
    then reportable_transaction_disclosure_required(advisor, transaction);
    unless one_advisor_designated_for_multiple(advisor, transaction, advisor) and is_material_advisor(advisor, transaction);
}

// ============================================================================
// §6112 — Material advisor lists
// ============================================================================

relation maintains_advisee_list(advisor: Person, transaction: Integer) kind empirical;
@source(IRC_S6112_A, relation = formalizes, coverage = exact, quote = "shall (whether or not required to file a return under section 6111 with respect to such transaction) maintain (in such manner as the Secretary may by regulations prescribe) a list")
rule S6112MaintainListDuty strict {
    for advisor: Person;
    for transaction: Integer;
    when is_material_advisor(advisor, transaction);
    then duty MaintainAdviseeList {
        bearer advisor;
        beneficiary Secretary;
        goal maintenance {
            condition maintains_advisee_list(advisor, transaction);
            window [-infinity, infinity];
        }
    };
}
relation list_creation_date(advisor: Person, transaction: Integer, d: Date) kind empirical;
relation retains_list_information(advisor: Person, transaction: Integer) kind empirical;
@source(IRC_S6112_B, relation = formalizes, coverage = exact, quote = "shall retain any information which is required to be included on such list for 7 years.")
rule S6112RetainListDuty strict {
    for advisor: Person;
    for transaction: Integer;
    for d: Date;
    when maintains_advisee_list(advisor, transaction) and list_creation_date(advisor, transaction, d);
    then duty RetainAdviseeListInformation {
        bearer advisor;
        beneficiary Secretary;
        goal maintenance {
            condition retains_list_information(advisor, transaction);
            window [d, add_calendar_period(d, 84 calendar_month)];
        }
    };
}
relation secretary_requests_list_inspection(advisor: Person, transaction: Integer) kind empirical;
relation list_made_available(advisor: Person, transaction: Integer) kind empirical;
@source(IRC_S6112_B, relation = formalizes, coverage = exact, quote = "shall make such list available to the Secretary for inspection upon written request by the Secretary")
rule S6112MakeAvailableDuty strict {
    for advisor: Person;
    for transaction: Integer;
    when maintains_advisee_list(advisor, transaction) and secretary_requests_list_inspection(advisor, transaction);
    then duty MakeAdviseeListAvailable {
        bearer advisor;
        beneficiary Secretary;
        goal achievement {
            condition list_made_available(advisor, transaction);
            window [-infinity, infinity];
        }
    };
}

// ============================================================================
// §6113 — Disclosure of nondeductibility of contributions
// ============================================================================

relation is_501_c_or_d_organization(org: Organ, other_than_c1: Boolean) kind empirical {
    label en unofficial "the organization is described in §501(c) (other than (c)(1)) or (d) and exempt under §501(a) (§6113(b)(1)(A))";
}
relation is_political_organization_527e(org: Organ) kind empirical;
relation was_covered_organization_within_5_years(org: Organ) kind empirical {
    label en unofficial "the organization was a §6113(b)(1)(A)/(B) organization (or successor) at any time in the 5-year period ending on the solicitation date (§6113(b)(1)(C))";
}
relation described_in_170_c(org: Organ) kind empirical {
    label en unofficial "the organization is described in §170(c) (contributions to it are already deductible) — excludes it from §6113 entirely";
}
relation annual_gross_receipts(org: Organ, amount: Money) kind institutional;
relation is_170_c_4_fraternal_organization(org: Organ) kind empirical;
relation solicitation_for_170_c_4_exclusive_purposes(org: Organ, solicitation: Integer) kind empirical;
relation s6113_applies_to_organization(org: Organ) kind institutional {
    label en unofficial "§6113 applies to the organization (bundles (b)(1)(A)-(C) into one atom, net of the §170(c) exclusion and the small-organization exception)";
}
@source(IRC_S6113_B, relation = formalizes, coverage = partial, quote = "this section shall apply to any organization which is not described in section 170(c) and which")
rule S6113AppliesToOrganization defeasible {
    for org: Organ;
    when (is_501_c_or_d_organization(org, true) or is_political_organization_527e(org) or was_covered_organization_within_5_years(org))
        and not_known(described_in_170_c(org));
    then s6113_applies_to_organization(org);
    unless annual_gross_receipts(org, 0.00 USD) and is_501_c_or_d_organization(org, true);
}
relation s6113_solicitation_excluded_by_fraternal_170c4(org: Organ, solicitation: Integer) kind institutional {
    label en unofficial "a §170(c)(4) fraternal organization's solicitation is treated as described in §170(c) (hence outside §6113) only when the solicitation is for exclusively §170(c)(4) purposes";
}
@source(IRC_S6113_B, relation = formalizes, coverage = exact, quote = "an organization described in section 170(c)(4) shall be treated as described in section 170(c) only with respect to solicitations for contributions or gifts which are to be used exclusively for purposes referred to in section 170(c)(4).")
rule S6113FraternalOrganizationExclusivePurposeException strict {
    for org: Organ;
    for solicitation: Integer;
    when is_170_c_4_fraternal_organization(org) and solicitation_for_170_c_4_exclusive_purposes(org, solicitation);
    then s6113_solicitation_excluded_by_fraternal_170c4(org, solicitation);
}
relation small_organization_exception(org: Organ) kind institutional;
@source(IRC_S6113_B, relation = formalizes, coverage = exact, quote = "This section shall not apply to any organization the gross receipts of which in each taxable year are normally not more than $100,000.")
rule S6113SmallOrganizationException defeasible {
    for org: Organ;
    for receipts: Money;
    when annual_gross_receipts(org, receipts) and receipts <= 100000.00 USD;
    then small_organization_exception(org);
}
relation fundraising_solicitation_written(org: Organ, solicitation: Integer) kind empirical;
relation fundraising_solicitation_broadcast(org: Organ, solicitation: Integer) kind empirical;
relation fundraising_solicitation_telephone(org: Organ, solicitation: Integer) kind empirical;
relation coordinated_campaign_more_than_ten_persons(org: Organ, solicitation: Integer) kind empirical {
    label en unofficial "the letter/call is part of a coordinated fundraising campaign soliciting more than 10 persons in the calendar year (§6113(c)(2) — negates the letter/call exception)";
}
relation is_fundraising_solicitation(org: Organ, solicitation: Integer) kind institutional;
@source(IRC_S6113_C, relation = formalizes, coverage = partial, quote = "the term \"fundraising solicitation\" means any solicitation of contributions or gifts which is made")
rule S6113IsFundraisingSolicitationWritten strict {
    for org: Organ;
    for solicitation: Integer;
    when fundraising_solicitation_written(org, solicitation);
    then is_fundraising_solicitation(org, solicitation);
}
rule S6113IsFundraisingSolicitationBroadcast strict {
    for org: Organ;
    for solicitation: Integer;
    when fundraising_solicitation_broadcast(org, solicitation);
    then is_fundraising_solicitation(org, solicitation);
}
@source(IRC_S6113_C, relation = formalizes, coverage = exact, quote = "The term \"fundraising solicitation\" shall not include any letter or telephone call if such letter or call is not part of a coordinated fundraising campaign soliciting more than 10 persons during the calendar year.")
rule S6113IsFundraisingSolicitationTelephone defeasible {
    for org: Organ;
    for solicitation: Integer;
    when fundraising_solicitation_telephone(org, solicitation);
    then is_fundraising_solicitation(org, solicitation);
    unless not_known(coordinated_campaign_more_than_ten_persons(org, solicitation)) and fundraising_solicitation_telephone(org, solicitation);
}
relation nondeductibility_statement_included(org: Organ, solicitation: Integer) kind empirical;
@source(IRC_S6113_A, relation = formalizes, coverage = exact, quote = "Each fundraising solicitation by (or on behalf of) an organization to which this section applies shall contain an express statement (in a conspicuous and easily recognizable format) that contributions or gifts to such organization are not deductible as charitable contributions for Federal income tax purposes.")
rule S6113DiscloseNondeductibilityDuty defeasible {
    for org: Organ;
    for solicitation: Integer;
    when s6113_applies_to_organization(org) and is_fundraising_solicitation(org, solicitation);
    then duty DiscloseNondeductibilityOfContributions {
        bearer org;
        goal achievement {
            condition nondeductibility_statement_included(org, solicitation);
            window [-infinity, infinity];
        }
    };
    unless (small_organization_exception(org) or s6113_solicitation_excluded_by_fraternal_170c4(org, solicitation)) and s6113_applies_to_organization(org) and is_fundraising_solicitation(org, solicitation);
}

// ============================================================================
// §6114 — Treaty-based return positions
// ============================================================================

relation takes_treaty_overrides_position(taxpayer: Person, tax: Integer) kind empirical;
relation return_of_tax_required_for(taxpayer: Person, tax: Integer) kind empirical;
relation treaty_position_disclosed(taxpayer: Person, tax: Integer) kind empirical;
relation secretary_waives_treaty_disclosure(taxpayer: Person, tax: Integer) kind empirical;
relation treaty_disclosure_waived(taxpayer: Person, tax: Integer) kind institutional;
@source(IRC_S6114_B, relation = formalizes, coverage = exact, quote = "The Secretary may waive the requirements of subsection (a) with respect to classes of cases for which the Secretary determines that the waiver will not impede the assessment and collection of tax.")
rule S6114WaiverPower strict {
    for taxpayer: Person;
    for tax: Integer;
    when secretary_waives_treaty_disclosure(taxpayer, tax);
    then power S6114WaiveTreatyDisclosure {
        holder Secretary;
        over taxpayer;
        exercise secretary_waives_treaty_disclosure(taxpayer, tax);
        valid_when secretary_waives_treaty_disclosure(taxpayer, tax);
        effect create(treaty_disclosure_waived(taxpayer, tax));
    };
}
@source(IRC_S6114_A, relation = formalizes, coverage = exact, quote = "Each taxpayer who, with respect to any tax imposed by this title, takes the position that a treaty of the United States overrules (or otherwise modifies) an internal revenue law of the United States shall disclose (in such manner as the Secretary may prescribe) such position")
rule S6114DisclosureDuty defeasible {
    for taxpayer: Person;
    for tax: Integer;
    when takes_treaty_overrides_position(taxpayer, tax);
    then duty DiscloseTreatyBasedPosition {
        bearer taxpayer;
        beneficiary Secretary;
        goal achievement {
            condition treaty_position_disclosed(taxpayer, tax);
            window [-infinity, infinity];
        }
    };
    unless treaty_disclosure_waived(taxpayer, tax) and takes_treaty_overrides_position(taxpayer, tax);
}

// ============================================================================
// §6115 — Disclosure related to quid pro quo contributions
// ============================================================================

relation receives_quid_pro_quo_contribution(org: Organ, contribution: Integer, amount: Money) kind empirical;
relation is_170_c_organization_other_than_1(org: Organ) kind empirical;
relation payment_partly_contribution_partly_consideration(org: Organ, contribution: Integer) kind empirical;
relation solely_intangible_religious_benefit(org: Organ, contribution: Integer) kind empirical {
    label en unofficial "the taxpayer receives solely an intangible religious benefit not generally sold commercially outside the donative context, from an organization organized exclusively for religious purposes (§6115(b) carve-out)";
}
relation is_quid_pro_quo_contribution(org: Organ, contribution: Integer) kind institutional;
@source(IRC_S6115_B, relation = formalizes, coverage = exact, quote = "the term \"quid pro quo contribution\" means a payment made partly as a contribution and partly in consideration for goods or services provided to the payor by the donee organization.")
rule S6115IsQuidProQuoContribution defeasible {
    for org: Organ;
    for contribution: Integer;
    when payment_partly_contribution_partly_consideration(org, contribution);
    then is_quid_pro_quo_contribution(org, contribution);
    unless solely_intangible_religious_benefit(org, contribution) and payment_partly_contribution_partly_consideration(org, contribution);
}
relation quid_pro_quo_disclosure_statement_provided(org: Organ, contribution: Integer) kind empirical;
@source(IRC_S6115_A, relation = formalizes, coverage = exact, quote = "the organization shall, in connection with the solicitation or receipt of the contribution, provide a written statement")
rule S6115DisclosureDuty strict {
    for org: Organ;
    for contribution: Integer;
    for amount: Money;
    when is_170_c_organization_other_than_1(org)
        and receives_quid_pro_quo_contribution(org, contribution, amount)
        and amount > 75.00 USD
        and is_quid_pro_quo_contribution(org, contribution);
    then duty DiscloseQuidProQuoContribution {
        bearer org;
        goal achievement {
            condition quid_pro_quo_disclosure_statement_provided(org, contribution);
            window [-infinity, infinity];
        }
    };
}

// ============================================================================
// §6116 — Data relating to Federal prisons and State prisons
// ============================================================================

relation prison_inmate_list_transmitted(agency: Organ, y: Integer) kind empirical;
relation is_federal_or_state_prison_agency(agency: Organ, y: Integer) kind empirical {
    label en unofficial "the agency is the Federal Bureau of Prisons or a State agency charged with administration of prisons, for the reporting year (§6116(a))";
}
@source(IRC_S6116_A, relation = formalizes, coverage = exact, quote = "Not later than September 15, 2012, and annually thereafter, the head of the Federal Bureau of Prisons and the head of any State agency charged with the responsibility for administration of prisons shall provide to the Secretary in electronic format a list with the information described in subsection (b) of all the inmates incarcerated within the prison system for any part of the prior 2 calendar years or the current calendar year through August 31.")
rule S6116PrisonAgencyListDuty strict {
    for agency: Organ;
    for y: Integer;
    when is_federal_or_state_prison_agency(agency, y) and y >= 2012;
    then duty TransmitInmateList {
        bearer agency;
        beneficiary Secretary;
        goal achievement {
            condition prison_inmate_list_transmitted(agency, y);
            window [-infinity, infinity];
        }
    };
}
relation secretary_determines_electronic_format(y: Integer) kind empirical;
@source(IRC_S6116_C, relation = formalizes, coverage = exact, quote = "The Secretary shall determine the electronic format of the information described in subsection (b).")
rule S6116FormatDuty strict {
    when true;
    then duty DetermineInmateListFormat {
        bearer Secretary;
        goal maintenance {
            condition secretary_determines_electronic_format(0);
            window [-infinity, infinity];
        }
    };
}

// §6117 — pure cross-reference to §4102 (gasoline/lubricating oil inspection
// of records). NON_NORMATIVE.
relation s6117_cross_reference(unused: Boolean) kind institutional {
    label en unofficial "§6117 is a pure cross-reference to §4102 — NON_NORMATIVE, no self-executing text";
}
