// 26 U.S.C. 6020(a) — Returns prepared for or executed by Secretary
fragment IRC_S6020_A in IRC_2024_EDITION {
    kind subsection;
    locator "section/6020/a";
    text en official """(a) Preparation of return by Secretary
If any person shall fail to make a return required by this title or by regulations prescribed thereunder, but shall consent to disclose all information necessary for the preparation thereof, then, and in that case, the Secretary may prepare such return, which, being signed by such person, may be received by the Secretary as the return of such person.""";
    content_hash "sha256:ece0f725097739e3c86a60e9284dbf7e0b62ef45a08b10c0f68861297f3a5c7d";
}

// 26 U.S.C. 6020(b) — Returns prepared for or executed by Secretary
fragment IRC_S6020_B in IRC_2024_EDITION {
    kind subsection;
    locator "section/6020/b";
    text en official """(b) Execution of return by Secretary
(1) Authority of Secretary to execute return
If any person fails to make any return required by any internal revenue law or regulation made thereunder at the time prescribed therefor, or makes, willfully or otherwise, a false or fraudulent return, the Secretary shall make such return from his own knowledge and from such information as he can obtain through testimony or otherwise.
(2) Status of returns
Any return so made and subscribed by the Secretary shall be prima facie good and sufficient for all legal purposes.""";
    content_hash "sha256:6238cd4c0dddaa811d660c25b902968a8c6240ab781dc9f8fa4ae7837d40ec98";
}

// 26 U.S.C. §6020 — statutory note 4 (effectivedate-amendment-note)
fragment IRC_S6020_NOTE_4 in IRC_2024_EDITION {
    kind note;
    locator "section/6020/note/4";
    text en official """Effective Date of 1984 Amendment
Amendment by Pub. L. 98–369 applicable with respect to taxable years beginning after Dec. 31, 1984, see section 414(a)(1) of Pub. L. 98–369, set out as a note under section 6654 of this title.
Effective Date of 1968 Amendment
Amendment by Pub. L. 90–364 applicable with respect to taxable years beginning after Dec. 31, 1967, except as provided by section 104 of Pub. L. 90–364, see section 103(f) of Pub. L. 90–364, set out as a note under section 243 of this title.""";
    content_hash "sha256:a02073d32568dd39ad7e393e790ef340c80611548c39faadb4b6e6b878716fa5";
}

// 26 U.S.C. §6021 — Listing by Secretary of taxable objects owned by nonresidents of internal revenue districts
fragment IRC_S6021 in IRC_2024_EDITION {
    kind section;
    locator "section/6021";
    text en official """Listing by Secretary of taxable objects owned by nonresidents of internal revenue districts
Whenever there are in any internal revenue district any articles subject to tax, which are not owned or possessed by or under the care or control of any person within such district, and of which no list has been transmitted to the Secretary, as required by law or by regulations prescribed pursuant to law, the Secretary shall enter the premises where such articles are situated, shall make such inspection of the articles as may be necessary and make lists of the same, according to the forms prescribed. Such lists, being subscribed by the Secretary, shall be sufficient lists of such articles for all purposes.""";
    content_hash "sha256:da80c79120b1b4866c58547de366d1c877c5b203c1410274cc74421446b885a9";
}

