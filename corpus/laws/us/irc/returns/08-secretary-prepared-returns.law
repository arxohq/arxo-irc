// STAGE 2 — §6016, §6017A (repealed), §6020 (returns prepared/executed by
// the Secretary), §6021 (listing of taxable objects — archaic excise-era
// power), §6073, §6074, §6076 (repealed).
//
// JUDGMENT CALLS:
//  - §6016, §6017A, §6073, §6074, §6076 are all wholly repealed sections
//    with no surviving operative text — NON_NORMATIVE, no rule.
//  - §6020(a) is a `power` of the Secretary conditioned on the taxpayer's
//    consent (the resulting return is deemed the TAXPAYER's own upon
//    signature) — modeled distinctly from (b), which is the Secretary's
//    OWN return on failure/fraud, carrying the "prima facie good and
//    sufficient" institutional effect (same pattern as stage 1's §6062-6064
//    presumption rules).
//  - §6021 is modeled the same way as §6020(b): a `power` plus an
//    institutional "sufficient for all purposes" classification effect,
//    despite its narrow/archaic subject matter (untaxed excise articles
//    outside any district) — the text itself states a self-executing power
//    and effect, so it is EXECUTABLE, not NON_NORMATIVE, even though it is
//    rarely if ever invoked today.

language "law.core" version "0.2";
package us.irc.returns version "0.1.1";
namespace "urn:us:irc:returns:clir";

use self::{
    IRC_S6020_A,
    IRC_S6020_B,
    IRC_S6021,
    Person,
    Secretary,
};

// §6016, §6017A, §6073, §6074, §6076 — repealed, no surviving text.
relation s6016_repealed(unused: Boolean) kind institutional {
    label en unofficial "§6016 repealed by Pub. L. 90-364 (1968) — NON_NORMATIVE, no surviving text";
}
relation s6017a_repealed(unused: Boolean) kind institutional {
    label en unofficial "§6017A repealed by Pub. L. 101-239 (1989) — NON_NORMATIVE, no surviving text";
}
relation s6073_repealed(unused: Boolean) kind institutional {
    label en unofficial "§6073 repealed by Pub. L. 98-369 (1984) — NON_NORMATIVE, no surviving text";
}
relation s6074_repealed(unused: Boolean) kind institutional {
    label en unofficial "§6074 repealed by Pub. L. 90-364 (1968) — NON_NORMATIVE, no surviving text";
}
relation s6076_repealed(unused: Boolean) kind institutional {
    label en unofficial "§6076 repealed by Pub. L. 100-418 (1988) — NON_NORMATIVE, no surviving text";
}

// ============================================================================
// §6020 — Returns prepared for or executed by Secretary
// ============================================================================

relation person_fails_to_make_required_return(p: Person, required_return: Integer) kind empirical;
relation person_consents_to_disclose_information(p: Person, required_return: Integer) kind empirical {
    label en unofficial "the person consents to disclose all information necessary for the Secretary to prepare the return (§6020(a))";
}
relation secretary_prepares_return(p: Person, required_return: Integer) kind empirical;
relation return_signed_by_person(p: Person, required_return: Integer) kind empirical;
relation secretary_prepared_return_received_as_taxpayers_own(p: Person, required_return: Integer) kind institutional {
    label en unofficial "the Secretary-prepared return, signed by the person, may be received by the Secretary as the person's own return (§6020(a))";
}
@source(IRC_S6020_A, relation = formalizes, coverage = exact, quote = "then, and in that case, the Secretary may prepare such return, which, being signed by such person, may be received by the Secretary as the return of such person.")
rule S6020aPrepareReturnPower strict {
    for p: Person;
    for required_return: Integer;
    when person_fails_to_make_required_return(p, required_return)
        and secretary_prepares_return(p, required_return)
        and return_signed_by_person(p, required_return);
    then power S6020aPrepareReturnByConsent {
        holder Secretary;
        over p;
        exercise secretary_prepares_return(p, required_return);
        valid_when person_consents_to_disclose_information(p, required_return);
        effect create(secretary_prepared_return_received_as_taxpayers_own(p, required_return));
    };
}

relation fails_to_make_return_at_prescribed_time(p: Person, required_return: Integer) kind empirical;
relation makes_false_or_fraudulent_return(p: Person, required_return: Integer) kind empirical;
relation secretary_executes_return(p: Person, required_return: Integer) kind empirical;
relation secretary_executed_return_subscribed(p: Person, required_return: Integer) kind institutional {
    label en unofficial "the Secretary executes and subscribes the return under §6020(b)(1), from the Secretary's own knowledge and available testimony/information";
}
@source(IRC_S6020_B, relation = formalizes, coverage = exact, quote = "the Secretary shall make such return from his own knowledge and from such information as he can obtain through testimony or otherwise.")
rule S6020bExecuteReturnPower defeasible {
    for p: Person;
    for required_return: Integer;
    when (fails_to_make_return_at_prescribed_time(p, required_return) or makes_false_or_fraudulent_return(p, required_return))
        and secretary_executes_return(p, required_return);
    then power S6020bExecuteReturn {
        holder Secretary;
        over p;
        exercise secretary_executes_return(p, required_return);
        valid_when fails_to_make_return_at_prescribed_time(p, required_return);
        effect create(secretary_executed_return_subscribed(p, required_return));
    };
    unless secretary_executes_return(p, required_return) and not_known(fails_to_make_return_at_prescribed_time(p, required_return)) and not_known(makes_false_or_fraudulent_return(p, required_return));
}
pub relation substitute_return_executed(p: Person, required_return: Integer) kind institutional {
    label en unofficial "a §6020(b) substitute return has been executed and subscribed by the Secretary for the person";
}
rule S6020bSubstituteReturnExecutedFlag strict {
    for p: Person;
    for required_return: Integer;
    when secretary_executed_return_subscribed(p, required_return);
    then substitute_return_executed(p, required_return);
}
relation substitute_return_prima_facie_sufficient(p: Person, required_return: Integer) kind institutional {
    label en unofficial "the §6020(b) substitute return is prima facie good and sufficient for all legal purposes (§6020(b)(2))";
}
@source(IRC_S6020_B, relation = formalizes, coverage = exact, quote = "Any return so made and subscribed by the Secretary shall be prima facie good and sufficient for all legal purposes.")
rule S6020bPrimaFacieSufficient strict {
    for p: Person;
    for required_return: Integer;
    when secretary_executed_return_subscribed(p, required_return);
    then substitute_return_prima_facie_sufficient(p, required_return);
}

// ============================================================================
// §6021 — Listing by Secretary of taxable objects owned by nonresidents of
// internal revenue districts
// ============================================================================

relation taxable_articles_in_district(district: Integer, articles: Integer) kind empirical {
    label en unofficial "articles subject to tax situated in the internal revenue district, not owned/possessed by or under the care of any person within the district (§6021)";
}
relation no_list_transmitted(district: Integer, articles: Integer) kind empirical;
relation secretary_inspects_and_lists(district: Integer, articles: Integer) kind empirical;
relation articles_listed_by_secretary(district: Integer, articles: Integer) kind institutional {
    label en unofficial "the Secretary's subscribed list of the articles, sufficient for all purposes (§6021)";
}
@source(IRC_S6021, relation = formalizes, coverage = exact, quote = "the Secretary shall enter the premises where such articles are situated, shall make such inspection of the articles as may be necessary and make lists of the same, according to the forms prescribed.")
rule S6021ListTaxableObjectsPower strict {
    for district: Integer;
    for articles: Integer;
    when taxable_articles_in_district(district, articles)
        and secretary_inspects_and_lists(district, articles);
    then power S6021ListTaxableObjects {
        holder Secretary;
        exercise secretary_inspects_and_lists(district, articles);
        valid_when no_list_transmitted(district, articles);
        effect create(articles_listed_by_secretary(district, articles));
    };
}
relation s6021_list_sufficient(district: Integer, articles: Integer) kind institutional {
    label en unofficial "such lists, subscribed by the Secretary, are sufficient lists of the articles for all purposes (§6021)";
}
@source(IRC_S6021, relation = formalizes, coverage = exact, quote = "Such lists, being subscribed by the Secretary, shall be sufficient lists of such articles for all purposes.")
rule S6021ListSufficientForAllPurposes strict {
    for district: Integer;
    for articles: Integer;
    when articles_listed_by_secretary(district, articles);
    then s6021_list_sufficient(district, articles);
}
