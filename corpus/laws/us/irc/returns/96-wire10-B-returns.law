// Returns -- WIRE-10 group B (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// The owner of section 6013 derives the `pub` stub of a lower consumer (owner-derives-consumer technique of WIRE-8): the consumer
// `property_transactions` cannot import `returns` (returns reaches property_transactions through gross_income), so this package
// writes the consumer's stub. The case-fact channel of the stub stays valid.

language "law.core" version "0.2";
package us.irc.returns version "0.1.1";
namespace "urn:us:irc:returns:clir";

use self::{
    IRC_S6013_A,
    IRC_S6014_A,
    Individual,
    TaxableYear,
    joint_return_in_effect,
    tax_not_shown_election_in_effect,
};

@source(IRC_S6013_A, relation = formalizes, coverage = partial, quote = "A husband and wife may make a single return jointly of income taxes under subtitle A")
rule W10JointReturnFiledForSection1244(p: us.irc.core::Individual, s: us.irc.core::Individual, y: TaxableYear) strict {
    label en official "a husband and wife whose joint return is in effect under section 6013(a) file a joint return for the year (read by section 1244(b)(2))";
    when joint_return_in_effect(p, s, y);
    then us.irc.property_transactions::joint_return_filed_1244(p, y);
}

// --- section 6014: the election in effect, published for section 6151(b)(1) (read by payment_refunds_interest) --------------------

pub relation elects_tax_not_shown_6014(p: us.irc.core::Individual, y: TaxableYear) kind institutional {
    label en official "the individual's election under section 6014 not to show the tax on the return is in effect for the taxable year";
}
@source(IRC_S6014_A, relation = formalizes, coverage = partial, quote = "shall at his election not be required to show on the return the tax imposed by section 1")
rule W10ElectionNotToShowTaxPublished(p: us.irc.core::Individual, y: TaxableYear) strict {
    label en official "an election under section 6014 that is in effect is published for the payment package";
    when tax_not_shown_election_in_effect(p, y);
    then elects_tax_not_shown_6014(p, y);
}
