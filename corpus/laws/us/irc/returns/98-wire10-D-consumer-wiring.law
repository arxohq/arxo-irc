// Returns -- WIRE-10 group D (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// Placeholders of this package that name a norm owned by a package this package can import are derived from the owner's `pub`
// relation. The consumer's placeholders are keyed by the individual only, while the owner's norms are keyed by a calendar year or by
// a wage payment; the year-keyed twin below carries the owner's conclusion, the consumer's rules read `placeholder or twin`, and
// the case-fact channel (asserting the year-less placeholder) stays valid.

language "law.core" version "0.2";
package us.irc.returns version "0.1.1";
namespace "urn:us:irc:returns:clir";

import us.irc.definitions version "0.1.1";
import us.irc.employment version "0.1.1";

use self::{
    IRC_S6013_F,
    Individual,
    TaxableYear,
    combat_zone_termination_window_open,
    in_missing_status,
};

// --- section 7701(b): nonresident alien (owner: definitions) ---------------------------------------------------------------

relation nonresident_alien_in_taxable_year(p: Individual, y: TaxableYear) kind institutional {
    label en unofficial "the individual is a nonresident alien under section 7701(b) for the calendar-year taxable year, as the definitions package concludes (WIRE-10; fiscal years keep the case-fact channel `nonresident_alien`)";
}

rule W10NonresidentAlienInTaxableYearFromDefinitions strict {
    label en official "an individual that the definitions package finds to be a nonresident alien for a calendar year is a nonresident alien for the taxable year that is that calendar year";
    for p: Individual;
    for y: TaxableYear;
    for n: Integer;
    when us.irc.core::calendar_year_of(y, n);
    when us.irc.definitions::nonresident_alien_for_year(p, n);
    then nonresident_alien_in_taxable_year(p, y);
}

// --- chapter 24: wages subject to withholding (owner: employment) ----------------------------------------------------------

relation subject_to_chapter24_wage_withholding_in_taxable_year(p: Individual, y: TaxableYear) kind institutional {
    label en unofficial "the individual was paid wages within section 3401(a) in the taxable year, as the employment package concludes (WIRE-10; the case-fact channel `subject_to_chapter24_wage_withholding` stays valid)";
}

rule W10WagesSubjectToChapter24WithholdingFromEmployment strict {
    label en official "an individual paid a positive amount of wages within section 3401(a) in the taxable year is one whose wages are subject to withholding under chapter 24";
    for p: Individual;
    for y: TaxableYear;
    for pay: us.irc.employment::WagePayment;
    for amt: Money;
    when us.irc.employment::wage_payment(pay, _, p, y, _, _);
    when us.irc.employment::wages_3401(pay, amt);
    when amt > 0.00 USD;
    then subject_to_chapter24_wage_withholding_in_taxable_year(p, y);
}

// --- section 6013(f): missing status and the combat-zone window (owner of the zone: gross_income, section 112) ------------------
//
// (f)(3): a member of a uniformed service is in a missing status for any period for which he is entitled to pay and allowances under 37 U.S.C. 552,
// an employee for any period for which he is entitled to pay and allowances under 5 U.S.C. 5562 (the entitlements are facts of those Titles).
// (f)(1)(A)-(B): the election is open for a taxable year that begins on or before the day 2 years after the date designated under section 112 as the
// date of termination of combatant activities in the zone; for the Vietnam zone for any taxable year while the individual is in missing status.
// A qualified hazardous duty area is treated as a combat zone (Pub. L. 104-117 section 1(a)(7)); its period end stands for the termination date
// (JUDGMENT CALL: the note designates no termination date). The consumer's valid_when reads the person-keyed window below; the year-only
// case fact `combat_zone_termination_window_open` together with `in_missing_status` still opens it.

relation entitled_to_pay_and_allowances_37_usc_552(p: Individual, from: Date, to: Date) kind empirical {
    label en official "the member of a uniformed service (37 U.S.C. 101(3)) is entitled to pay and allowances under section 552 of title 37 for the period";
}
relation entitled_to_pay_and_allowances_5_usc_5562(p: Individual, from: Date, to: Date) kind empirical {
    label en official "the employee (5 U.S.C. 5561(2)) is entitled to pay and allowances under section 5562 of title 5 for the period";
}
relation missing_status_period(p: Individual, from: Date, to: Date) kind institutional {
    label en official "the individual is in a missing status for the period (section 6013(f)(3))";
}
@source(IRC_S6013_F, relation = formalizes, coverage = exact, quote = "A member of a uniformed service (within the meaning of section 101(3) of title 37 of the United States Code) is in a missing status for any period for which he is entitled to pay and allowances under section 552 of such title 37.")
rule W10D6013f3AUniformedServiceMissingStatus strict {
    label en official "section 6013(f)(3)(A)";
    for p: Individual; for from: Date; for to: Date;
    when entitled_to_pay_and_allowances_37_usc_552(p, from, to);
    then missing_status_period(p, from, to);
}
@source(IRC_S6013_F, relation = formalizes, coverage = exact, quote = "An employee (within the meaning of section 5561(2) of title 5 of the United States Code) is in a missing status for any period for which he is entitled to pay and allowances under section 5562 of such title 5.")
rule W10D6013f3BCivilianMissingStatus strict {
    label en official "section 6013(f)(3)(B)";
    for p: Individual; for from: Date; for to: Date;
    when entitled_to_pay_and_allowances_5_usc_5562(p, from, to);
    then missing_status_period(p, from, to);
}
rule W10DInMissingStatusFromPeriod strict {
    label en official "an individual with a missing-status period is in a missing status";
    for p: Individual; for from: Date; for to: Date;
    when missing_status_period(p, from, to);
    then in_missing_status(p);
}

relation missing_status_service_in_zone(p: Individual, z: us.irc.gross_income::CombatZone112) kind empirical {
    label en official "the individual is in a missing status as a result of service in this combat zone (as determined for purposes of section 112)";
}
relation missing_status_service_in_hazardous_duty_area(p: Individual, country: us.irc.gross_income::HazardousDutyCountry112) kind empirical {
    label en official "the individual is in a missing status as a result of service in this qualified hazardous duty area";
}
relation missing_status_joint_return_window_open(missing: Individual, y: TaxableYear) kind institutional {
    label en official "the taxable year begins on or before the day 2 years after the section 112 termination date of the individual's combat zone, or (Vietnam zone) falls while the individual is in missing status";
}
@source(IRC_S6013_F, relation = formalizes, coverage = partial, quote = "the spouse of such individual is otherwise entitled to file a joint return for any taxable year which begins on or before the day which is 2 years after the date designated under section 112 as the date of termination of combatant activities in such zone")
rule W10D6013f1BWindowFromCaseFact strict {
    label en official "case-fact channel: the year-only window fact and a missing status open the window";
    for missing: Individual; for y: TaxableYear;
    when in_missing_status(missing);
    when combat_zone_termination_window_open(y);
    then missing_status_joint_return_window_open(missing, y);
}
@source(IRC_S6013_F, relation = formalizes, coverage = partial, quote = "the spouse of such individual is otherwise entitled to file a joint return for any taxable year which begins on or before the day which is 2 years after the date designated under section 112 as the date of termination of combatant activities in such zone")
rule W10D6013f1BWindowFromDesignatedZone strict {
    label en official "the year begins on or before 2 years after the termination date designated for the zone of the missing individual";
    for missing: Individual; for y: TaxableYear; for z: us.irc.gross_income::CombatZone112; for t: Date; for b: Date;
    when missing_status_service_in_zone(missing, z);
    when us.irc.gross_income::combat_zone_combatant_activities_terminated_112c3(z, t);
    when us.irc.core::begins(y, b);
    when b <= add_calendar_period(t, 2 calendar_year);
    then missing_status_joint_return_window_open(missing, y);
}
@source(IRC_S6013_F, relation = formalizes, coverage = partial, quote = "With respect to service in the combat zone designated for purposes of the Vietnam conflict, such election may be made for any taxable year while an individual is in missing status.")
rule W10D6013f1BWindowVietnamWhileMissing strict {
    label en official "Vietnam zone: any taxable year while the individual is in missing status";
    for missing: Individual; for y: TaxableYear; for z: us.irc.gross_income::CombatZone112; for from: Date; for to: Date; for b: Date; for e: Date;
    when missing_status_service_in_zone(missing, z);
    when us.irc.gross_income::combat_zone_designated_for_vietnam_conflict_112(z);
    when missing_status_period(missing, from, to);
    when us.irc.core::begins(y, b);
    when us.irc.core::ends(y, e);
    when from <= e;
    when to >= b;
    then missing_status_joint_return_window_open(missing, y);
}
@source(IRC_S6013_F, relation = formalizes, coverage = partial, quote = "the spouse of such individual is otherwise entitled to file a joint return for any taxable year which begins on or before the day which is 2 years after the date designated under section 112 as the date of termination of combatant activities in such zone")
rule W10D6013f1BWindowFromHazardousDutyArea strict {
    label en official "a qualified hazardous duty area is treated as a combat zone (Pub. L. 104-117 section 1(a)(7)); the year begins on or before 2 years after the end of the period";
    for missing: Individual; for y: TaxableYear; for c: us.irc.gross_income::HazardousDutyCountry112; for from: Date; for to: Date; for b: Date;
    when missing_status_service_in_hazardous_duty_area(missing, c);
    when us.irc.gross_income::hazardous_duty_area_treated_as_combat_zone_112note(c, from, to);
    when us.irc.core::begins(y, b);
    when b <= add_calendar_period(to, 2 calendar_year);
    then missing_status_joint_return_window_open(missing, y);
}
