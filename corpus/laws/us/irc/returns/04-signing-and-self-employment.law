// §6017 (self-employment tax returns) and §§6061-6065 (signing and
// verifying returns and other documents).
//
// JUDGMENT CALLS AND GAPS (see report):
//  - §6017's $400 net-earnings-from-self-employment threshold is a literal
//    statutory dollar figure (not an indexed rate), embedded directly, like
//    §6012(a)(3)/(4)'s $600 figures.
//  - §6061(b) (electronic signatures) largely restates administrative
//    procedure the Secretary must develop; (b)(1)'s waiver/alternative-
//    method choice and (b)(3)(A)/(B) publication duties are modeled as
//    duties on the Secretary; (b)(2) (treatment of alternative methods as
//    equivalent to a signature) is modeled as a classification rule.
//  - §6062's and §6063's "prima facie evidence" sentences, and all of
//    §6064, state EVIDENTIARY presumptions (who bears the burden of
//    rebutting a signature's authority/authenticity), not a duty, power, or
//    prohibition — modeled as `classification` rules producing a
//    `presumed_authorized_signer`/`presumed_authentic_signature` fact, the
//    rebuttal itself being a fact-finding channel this package does not
//    own (adjudicated origin, `judicial-proceedings`).
//  - §6065's "[e]xcept as otherwise provided by the Secretary" is a
//    defeater on the perjury-declaration duty, keyed to a Secretary waiver
//    fact rather than modeled as an evaluative judgment (the exception is a
//    binary regulatory carve-out, not a case-by-case standard).

language "law.core" version "0.2";
package us.irc.returns version "0.1.1";
namespace "urn:us:irc:returns:clir";

use self::{
    Corporation,
    IRC_S6017,
    IRC_S6061_A,
    IRC_S6061_B,
    IRC_S6062,
    IRC_S6063,
    IRC_S6064,
    IRC_S6065,
    Individual,
    Organ,
    Partnership,
    Person,
    Secretary,
    TaxableYear,
    has_possession_or_title_to_corporation_property,
    joint_return_after_separate_in_effect,
    joint_return_in_effect,
    nonresident_alien,
    nonresident_alien_in_taxable_year,
    statutory_due_date,
};

// ============================================================================
// §6017 — Self-employment tax returns
// ============================================================================

relation net_earnings_from_self_employment(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the individual's net earnings from self-employment for the taxable year (pending: not this package's norm — chapter 2 self-employment tax computation)";
}
relation self_employment_return_filed(p: Individual, y: TaxableYear) kind empirical;
relation self_employment_filing_required(p: Individual, y: TaxableYear) kind institutional {
    label en unofficial "the individual's net earnings from self-employment meet the §6017 $400 threshold and the individual is not a nonresident alien";
}
@source(IRC_S6017, relation = formalizes, coverage = partial, quote = "Every individual (other than a nonresident alien individual) having net earnings from self-employment of $400 or more for the taxable year shall make a return with respect to the self-employment tax imposed by chapter 2.")
rule S6017SelfEmploymentFilingRequired defeasible {
    for p: Individual;
    for y: TaxableYear;
    for amt: Money;
    when net_earnings_from_self_employment(p, y, amt) and amt >= 400.00 USD;
    then self_employment_filing_required(p, y);
    unless (nonresident_alien(p) or nonresident_alien_in_taxable_year(p, y)) and net_earnings_from_self_employment(p, y, amt);
}
@source(IRC_S6017, relation = formalizes, coverage = exact, quote = "Every individual (other than a nonresident alien individual) having net earnings from self-employment of $400 or more for the taxable year shall make a return with respect to the self-employment tax imposed by chapter 2.")
rule S6017SelfEmploymentReturnRequired strict {
    for p: Individual;
    for y: TaxableYear;
    for d1: Date;
    for d2: Date;
    when self_employment_filing_required(p, y)
        and us.irc.core::ends(y, d1)
        and statutory_due_date(p, y, us.irc.core::SelfEmploymentCh2, d2);
    then duty FileSelfEmploymentTaxReturn {
        bearer p;
        beneficiary Secretary;
        goal achievement {
            condition self_employment_return_filed(p, y);
            window [d1, d2];
        }
    };
}

relation self_employment_tax_computed_separately(p: Individual, s: Individual, y: TaxableYear) kind institutional {
    label en unofficial "on a §6013 joint return, chapter 2 tax is the sum of each spouse's separately-computed self-employment tax, not a tax on aggregate self-employment income";
}
@source(IRC_S6017, relation = formalizes, coverage = exact, quote = "In the case of a husband and wife filing a joint return under section 6013, the tax imposed by chapter 2 shall not be computed on the aggregate income but shall be the sum of the taxes computed under such chapter on the separate self-employment income of each spouse.")
rule S6017SelfEmploymentTaxSeparateComputation strict {
    for p: Individual;
    for s: Individual;
    for y: TaxableYear;
    when joint_return_in_effect(p, s, y) or joint_return_after_separate_in_effect(p, s, y);
    then self_employment_tax_computed_separately(p, s, y);
}

// ============================================================================
// §6061 — Signing of returns and other documents
// ============================================================================

entity FiledDocument { label en unofficial "a return, statement, or other document required to be made under the internal revenue laws or regulations"; }
relation document_of(doc: FiledDocument, p: Person) kind empirical;
relation signed_in_accordance_with_prescribed_form(doc: FiledDocument) kind empirical;
relation document_governed_by_6062_or_6063(doc: FiledDocument) kind institutional {
    label en unofficial "the document is a corporation return under §6062 or a partnership return under §6063, so §6061(a)'s general signing rule does not apply to it";
}
relation document_governed_by_electronic_signature_procedures(doc: FiledDocument) kind institutional {
    label en unofficial "the document falls within §6061(b)'s electronic-signature procedures, so §6061(a)'s general rule does not apply to it";
}
relation section_6061a_governs_document(doc: FiledDocument) kind institutional {
    label en unofficial "§6061(a)'s general signing rule governs the document (i.e. neither §6062/§6063 nor §6061(b)'s electronic-signature procedures displace it)";
}
@source(IRC_S6061_A, relation = formalizes, coverage = partial, quote = "Except as otherwise provided by subsection (b) and sections 6062 and 6063")
rule S6061Section6061aGoverns defeasible {
    for doc: FiledDocument;
    when document_requires_signature(doc);
    then section_6061a_governs_document(doc);
    unless document_governed_by_6062_or_6063(doc) or document_governed_by_electronic_signature_procedures(doc);
}
relation document_requires_signature(doc: FiledDocument) kind empirical {
    label en unofficial "the document is required to be made under a provision of the internal revenue laws or regulations (§6061(a) gate)";
}
@source(IRC_S6061_A, relation = formalizes, coverage = exact, quote = "Except as otherwise provided by subsection (b) and sections 6062 and 6063, any return, statement, or other document required to be made under any provision of the internal revenue laws or regulations shall be signed in accordance with forms or regulations prescribed by the Secretary.")
rule S6061SignInAccordanceWithForms strict {
    for doc: FiledDocument;
    for p: Person;
    when document_of(doc, p) and section_6061a_governs_document(doc);
    then duty SignDocumentAsPrescribed {
        bearer p;
        beneficiary Secretary;
        goal achievement {
            condition signed_in_accordance_with_prescribed_form(doc);
            window [-infinity, infinity];
        }
    };
}

relation develops_electronic_signature_procedures(committee: Organ) kind empirical;
@source(IRC_S6061_B, relation = formalizes, coverage = exact, quote = "The Secretary shall develop procedures for the acceptance of signatures in digital or other electronic form.")
rule S6061DevelopElectronicSignatureProcedures strict {
    when true;
    then duty DevelopElectronicSignatureProcedures {
        bearer Secretary;
        goal maintenance {
            condition develops_electronic_signature_procedures(Secretary);
            window [-infinity, infinity];
        }
    };
}

relation electronic_signature_procedures_in_place(doc_class: FiledDocument) kind institutional {
    label en unofficial "the Secretary's §6061(b)(1) electronic-signature acceptance procedures are in place for this type or class of document";
}
relation electronic_signature_procedures_not_yet_in_place(doc: FiledDocument) kind institutional {
    label en unofficial "single-atom helper for `valid_when` (§201/lessons from pilot): the §6061(b)(1) procedures are not (yet, or not known to be) in place for the document";
}
@source(IRC_S6061_B, relation = formalizes, coverage = partial, quote = "Until such time as such procedures are in place")
rule S6061ProceduresNotYetInPlace defeasible {
    for doc: FiledDocument;
    when document_requires_signature(doc);
    then electronic_signature_procedures_not_yet_in_place(doc);
    unless electronic_signature_procedures_in_place(doc);
}
relation secretary_waives_signature_requirement(doc: FiledDocument) kind empirical;
relation secretary_provides_alternative_signing_method(doc: FiledDocument) kind empirical;
relation signature_requirement_waived(doc: FiledDocument) kind institutional;
relation alternative_signing_method_available(doc: FiledDocument) kind institutional;
@source(IRC_S6061_B, relation = formalizes, coverage = partial, quote = "Until such time as such procedures are in place, the Secretary may—")
rule S6061WaiveSignatureRequirement strict {
    for doc: FiledDocument;
    when electronic_signature_procedures_not_yet_in_place(doc) and secretary_waives_signature_requirement(doc);
    then power S6061WaiveSignatureRequirementPower {
        holder Secretary;
        exercise secretary_waives_signature_requirement(doc);
        valid_when electronic_signature_procedures_not_yet_in_place(doc);
        effect create(signature_requirement_waived(doc));
    };
}
@source(IRC_S6061_B, relation = formalizes, coverage = partial, quote = "Until such time as such procedures are in place, the Secretary may—")
rule S6061ProvideAlternativeSigningMethod strict {
    for doc: FiledDocument;
    when electronic_signature_procedures_not_yet_in_place(doc) and secretary_provides_alternative_signing_method(doc);
    then power S6061ProvideAlternativeSigningMethodPower {
        holder Secretary;
        exercise secretary_provides_alternative_signing_method(doc);
        valid_when electronic_signature_procedures_not_yet_in_place(doc);
        effect create(alternative_signing_method_available(doc));
    };
}

relation filed_verified_signed_or_subscribed_under_alternative_method(doc: FiledDocument) kind empirical;
relation treated_as_signed_or_subscribed(doc: FiledDocument) kind institutional {
    label en unofficial "the document is treated for all purposes (civil and criminal, including perjury) as though signed or subscribed";
}
@source(IRC_S6061_B, relation = formalizes, coverage = exact, quote = "Notwithstanding any other provision of law, any return, declaration, statement, or other document filed and verified, signed, or subscribed under any method adopted under paragraph (1)(B) shall be treated for all purposes (both civil and criminal, including penalties for perjury) in the same manner as though signed or subscribed.")
rule S6061AlternativeMethodTreatedAsSigned strict {
    for doc: FiledDocument;
    when alternative_signing_method_available(doc) and filed_verified_signed_or_subscribed_under_alternative_method(doc);
    then treated_as_signed_or_subscribed(doc);
}

relation publishes_signature_waiver_guidance(committee: Organ) kind empirical;
@source(IRC_S6061_B, relation = formalizes, coverage = exact, quote = "The Secretary shall publish guidance as appropriate to define and implement any waiver of the signature requirements or any method adopted under paragraph (1).")
rule S6061PublishSignatureWaiverGuidance strict {
    when true;
    then duty PublishSignatureWaiverGuidance {
        bearer Secretary;
        goal maintenance {
            condition publishes_signature_waiver_guidance(Secretary);
            window [-infinity, infinity];
        }
    };
}

relation is_practitioner(p: Person) kind institutional {
    label en unofficial "the individual is in good standing and regulated under 31 U.S.C. §330 (§6061(b)(3)(C))";
}
relation publishes_practitioner_esignature_standards(committee: Organ) kind empirical;
@source(IRC_S6061_B, relation = formalizes, coverage = exact, quote = "Not later than 6 months after the date of the enactment of this subparagraph, the Secretary shall publish guidance to establish uniform standards and procedures for the acceptance of taxpayers' signatures appearing in electronic form with respect to any request for disclosure of a taxpayer's return or return information under section 6103(c) to a practitioner or any power of attorney granted by a taxpayer to a practitioner.")
rule S6061PublishPractitionerEsignatureStandards strict {
    when true;
    then duty PublishPractitionerElectronicSignatureStandards {
        bearer Secretary;
        goal achievement {
            condition publishes_practitioner_esignature_standards(Secretary);
            window [@2019-07-01, @2020-01-01];
        }
    };
}

// ============================================================================
// §6062 — Signing of corporation returns
// ============================================================================

enum CorporateOfficerRole { President; VicePresident; Treasurer; AssistantTreasurer; ChiefAccountingOfficer; OtherDulyAuthorizedOfficer; }
relation holds_corporate_officer_role(p: Person, c: Corporation, officerRole: CorporateOfficerRole) kind institutional;
relation signs_corporation_return(p: Person, c: Corporation, y: TaxableYear) kind empirical;
relation corporation_return_signed_by(p: Person, c: Corporation, y: TaxableYear) kind institutional;
@source(IRC_S6062, relation = formalizes, coverage = exact, quote = "The return of a corporation with respect to income shall be signed by the president, vice-president, treasurer, assistant treasurer, chief accounting officer or any other officer duly authorized so to act.")
rule S6062CorporateOfficerSignsReturn strict {
    for p: Person;
    for c: Corporation;
    for y: TaxableYear;
    for officerRole: CorporateOfficerRole;
    when holds_corporate_officer_role(p, c, officerRole) and signs_corporation_return(p, c, y);
    then corporation_return_signed_by(p, c, y);
}
@source(IRC_S6062, relation = formalizes, coverage = exact, quote = "In the case of a return made for a corporation by a fiduciary pursuant to the provisions of section 6012(b)(3), such fiduciary shall sign the return.")
rule S6062FiduciarySignsReceivershipReturn strict {
    for f: Person;
    for c: Corporation;
    for y: TaxableYear;
    when has_possession_or_title_to_corporation_property(f, c) and signs_corporation_return(f, c, y);
    then corporation_return_signed_by(f, c, y);
}

relation presumed_authorized_corporate_signer(p: Person, c: Corporation, y: TaxableYear) kind institutional {
    label en unofficial "prima facie evidence that the named individual is authorized to sign the corporation's return; the presumption is rebuttable and rebuttal is a fact-finding this package does not own";
}
@source(IRC_S6062, relation = formalizes, coverage = exact, quote = "The fact that an individual's name is signed on the return shall be prima facie evidence that such individual is authorized to sign the return on behalf of the corporation.")
rule S6062PresumedAuthorizedSigner strict {
    for p: Person;
    for c: Corporation;
    for y: TaxableYear;
    when signs_corporation_return(p, c, y);
    then presumed_authorized_corporate_signer(p, c, y);
}

// ============================================================================
// §6063 — Signing of partnership returns
// ============================================================================

relation is_partner_of(p: Person, partnership: Partnership) kind institutional;
relation signs_partnership_return(p: Person, partnership: Partnership, y: TaxableYear) kind empirical;
relation partnership_return_signed_by(p: Person, partnership: Partnership, y: TaxableYear) kind institutional;
@source(IRC_S6063, relation = formalizes, coverage = exact, quote = "The return of a partnership made under section 6031 shall be signed by any one of the partners.")
rule S6063PartnerSignsReturn strict {
    for p: Person;
    for partnership: Partnership;
    for y: TaxableYear;
    when is_partner_of(p, partnership) and signs_partnership_return(p, partnership, y);
    then partnership_return_signed_by(p, partnership, y);
}

relation presumed_authorized_partner_signer(p: Person, partnership: Partnership, y: TaxableYear) kind institutional {
    label en unofficial "prima facie evidence that the named partner is authorized to sign the partnership's return; rebuttable, rebuttal not this package's norm";
}
@source(IRC_S6063, relation = formalizes, coverage = exact, quote = "The fact that a partner's name is signed on the return shall be prima facie evidence that such partner is authorized to sign the return on behalf of the partnership.")
rule S6063PresumedAuthorizedSigner strict {
    for p: Person;
    for partnership: Partnership;
    for y: TaxableYear;
    when signs_partnership_return(p, partnership, y);
    then presumed_authorized_partner_signer(p, partnership, y);
}

// ============================================================================
// §6064 — Signature presumed authentic
// ============================================================================

relation individuals_name_signed_to(p: Individual, doc: FiledDocument) kind empirical;
relation presumed_authentic_signature(p: Individual, doc: FiledDocument) kind institutional {
    label en unofficial "prima facie evidence for all purposes that the document was actually signed by the named individual; rebuttable, rebuttal not this package's norm";
}
@source(IRC_S6064, relation = formalizes, coverage = exact, quote = "The fact that an individual's name is signed to a return, statement, or other document shall be prima facie evidence for all purposes that the return, statement, or other document was actually signed by him.")
rule S6064PresumedAuthenticSignature strict {
    for p: Individual;
    for doc: FiledDocument;
    when individuals_name_signed_to(p, doc);
    then presumed_authentic_signature(p, doc);
}

// ============================================================================
// §6065 — Verification of returns
// ============================================================================

relation contains_perjury_declaration(doc: FiledDocument) kind empirical {
    label en unofficial "the document contains or is verified by a written declaration that it is made under the penalties of perjury";
}
relation secretary_waives_perjury_declaration(doc: FiledDocument) kind empirical {
    label en unofficial "the Secretary otherwise provides (waives the perjury-declaration requirement) for this document";
}
relation section_6065_governs_document(doc: FiledDocument) kind institutional {
    label en unofficial "§6065's perjury-declaration requirement applies to the document (the Secretary has not otherwise provided for it)";
}
@source(IRC_S6065, relation = formalizes, coverage = partial, quote = "Except as otherwise provided by the Secretary")
rule S6065Section6065Governs defeasible {
    for doc: FiledDocument;
    when document_requires_signature(doc);
    then section_6065_governs_document(doc);
    unless secretary_waives_perjury_declaration(doc);
}
@source(IRC_S6065, relation = formalizes, coverage = exact, quote = "Except as otherwise provided by the Secretary, any return, declaration, statement, or other document required to be made under any provision of the internal revenue laws or regulations shall contain or be verified by a written declaration that it is made under the penalties of perjury.")
rule S6065VerifyUnderPenaltiesOfPerjury strict {
    for doc: FiledDocument;
    for p: Person;
    when document_of(doc, p) and section_6065_governs_document(doc);
    then duty VerifyUnderPenaltiesOfPerjury {
        bearer p;
        beneficiary Secretary;
        goal achievement {
            condition contains_perjury_declaration(doc);
            window [-infinity, infinity];
        }
    };
}
