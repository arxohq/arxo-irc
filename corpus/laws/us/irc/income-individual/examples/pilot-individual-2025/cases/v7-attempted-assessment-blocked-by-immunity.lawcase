language "law.core" version "0.2";
package us.irc.examples.pilot_individual_2025 version "0.1.1";
namespace "urn:us:irc:examples:pilot-individual-2025";

// PLAN.ru.md §9, variant 7: an attempted action of the Secretary before the
// section 6213(a) conditions are met produces NO legal effect. A notice of
// deficiency is validly mailed May 1, 2026; the 90-day petition window (not
// counting weekends/DC holidays) runs to roughly July 30, 2026 -- asserted
// directly here as a case fact rather than derived through the section
// 7503/administration rollover chain (a documented simplification: see
// PILOT.md). Within that window, the Secretary attempts to make an
// assessment. `us.irc.assessment::S6213RestrictedDuringPetitionWindow`
// (strict) concludes an `immunity S6213PetitionWindowImmunity` whose
// `protected_effect` is `us.irc.core::assessment_of(a, p, y, k, amount)` --
// i.e. the attempted assessment does not take legal effect while the
// immunity holds, notwithstanding `secretary_makes_assessment` being an
// asserted (attempted) fact.

case V7AttemptedAssessmentBlockedByImmunity {
    context {
        legal_time @2026-06-01;
        knowledge_time @2026-06-01T09:00:00-04:00;
        decision_time @2026-06-01T09:00:00-04:00;
        timezone "America/New_York";
        deadline_policy us.irc.core::IRC_CALENDAR_STEP;
    }

    const dana: us.irc.core::Individual = entity_ref("urn:us:irc:case:pilot-individual-2025:dana");
    const ty2025: us.irc.core::TaxableYear = entity_ref("urn:us:irc:case:pilot-individual-2025:ty2025");
    const n: us.irc.core::Notice = entity_ref("urn:us:irc:case:pilot-individual-2025:v7-notice");
    const a: us.irc.core::Assessment = entity_ref("urn:us:irc:case:pilot-individual-2025:v7-attempted-assessment");

    assert "ty2025-ends": us.irc.core::ends(ty2025, @2025-12-31) { origin case_input; }

    assert "deficiency-notice-for": us.irc.assessment::deficiency_notice_for(n, dana, ty2025, us.irc.core::IncomeCh1) { origin case_input; }
    assert "notice-valid": us.irc.assessment::notice_of_deficiency_valid(n, dana) { origin case_input; }
    assert "mailed-on": us.irc.core::mailed_on(n, @2026-05-01) { origin case_input; }
    // Simplification: the post-section-7503-rollover deadline is asserted
    // directly rather than derived (see header note and PILOT.md).
    assert "petition-window-deadline": us.irc.assessment::petition_window_deadline(n, dana, @2026-07-30) { origin case_input; }

    // The Secretary attempts an assessment of a $1,000.00 deficiency WHILE
    // the petition window is open.
    assert "secretary-attempts-assessment": us.irc.assessment::secretary_makes_assessment(a, dana, ty2025, us.irc.core::IncomeCh1, 1000.00 USD) { origin case_input; }

    // Deliberately absent: `assessed_under_restitution_power(a)` (the
    // section 6213(b)(5) carve-out does not apply here).
}
