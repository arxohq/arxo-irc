language "law.core" version "0.2";
package us.irc.examples.pilot_individual_2025 version "0.1.1";
namespace "urn:us:irc:examples:pilot-individual-2025";

// PLAN.ru.md §9, variant 8: a proper challenge/suspension changes only the
// PRESCRIBED CONSEQUENCES, not the underlying facts or prior decisions.
// The same notice as V7 (mailed May 1, 2026) triggers, under section
// 6503(a)(1), a suspension of the section 6501 assessment-period clock for
// the period the Secretary is prohibited from assessing, plus 60 days:
// `us.irc.assessment::S6503SuspendedDuringPetitionWindowPlusSixtyDays`
// (defeasible) needs only `deficiency_notice_for`, `mailed_on` and
// `petition_window_deadline` -- it does not require a petition to actually
// be filed (the (a)(1) suspension runs from the mailing itself); this
// pilot therefore demonstrates the (a)(1) suspension rather than the
// (a)(1)-through-finality variant (`S6503SuspendedThroughFinalityPlusSixtyDays`,
// which additionally needs `petition_filed_timely` and `decision_final_on`
// -- a natural extension left to a future pass, noted in PILOT.md).
//
// suspension_period(dana, ty2025, IncomeCh1, PetitionWindow, 2026-05-01,
//   2026-07-30 + 60 days = 2026-09-28) is the PRESCRIBED CONSEQUENCE this
// variant exercises. It does NOT retroactively change `deemed_filed_date`
// or any other historical fact; `assessment_period_suspended_days` is a
// SEPARATE derived day-count that (per PILOT.md's gap note, a corpus-level
// finding, not something this pilot fixes) is not yet wired back into
// `assessment_period_ends` -- a genuine architecture gap this variant makes
// visible rather than papers over.

case V8TimelyPetitionSuspendsPeriods {
    context {
        legal_time @2026-06-01;
        knowledge_time @2026-06-01T09:00:00-04:00;
        decision_time @2026-06-01T09:00:00-04:00;
        timezone "America/New_York";
        deadline_policy us.irc.core::IRC_CALENDAR_STEP;
    }

    const dana: us.irc.core::Individual = entity_ref("urn:us:irc:case:pilot-individual-2025:dana");
    const ty2025: us.irc.core::TaxableYear = entity_ref("urn:us:irc:case:pilot-individual-2025:ty2025");
    const n: us.irc.core::Notice = entity_ref("urn:us:irc:case:pilot-individual-2025:v8-notice");
    const r: us.irc.core::Return = entity_ref("urn:us:irc:case:pilot-individual-2025:v8-return");

    assert "ty2025-ends": us.irc.core::ends(ty2025, @2025-12-31) { origin case_input; }

    // Background facts identical to V1's timely-filed return, so that the
    // section 6501 assessment period this variant's suspension acts upon
    // is itself established (deemed_filed_date -> assessment_period_ends).
    assert "return-of": us.irc.core::return_of(r, dana, ty2025, us.irc.core::IncomeCh1) { origin case_input; }
    assert "filed-on": us.irc.core::filed_on(r, @2026-04-10) { origin case_input; }
    assert "filer-of-record": us.irc.returns::income_tax_filer_of_record(dana, ty2025) { origin case_input; }

    assert "deficiency-notice-for": us.irc.assessment::deficiency_notice_for(n, dana, ty2025, us.irc.core::IncomeCh1) { origin case_input; }
    assert "notice-valid": us.irc.assessment::notice_of_deficiency_valid(n, dana) { origin case_input; }
    assert "mailed-on": us.irc.core::mailed_on(n, @2026-05-01) { origin case_input; }
    assert "petition-window-deadline": us.irc.assessment::petition_window_deadline(n, dana, @2026-07-30) { origin case_input; }
}
