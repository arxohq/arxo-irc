language "law.core" version "0.2";
package us.irc.examples.pilot_individual_2025 version "0.1.1";
namespace "urn:us:irc:examples:pilot-individual-2025";

// PLAN.ru.md §9, variant 3: a lawful extension of ONE deadline (the filing
// deadline, section 6081) changes only that deadline; the PAYMENT deadline
// (section 6151(a)) is unaffected, because `us.irc.payment_refunds_interest`
// reads `us.irc.core::due_date`, which the `assessment` package bridges from
// `us.irc.returns::statutory_due_date` (the UNEXTENDED date) rather than
// from `us.irc.core::extension_granted` (see `assessment/04-limitations.law`
// header note and `returns/05-timing-and-place.law`'s own comment on
// section 6151(a)'s "without regard to any extension").
//
// Dana requests, and is validly granted, a six-month extension of the
// filing deadline (April 15, 2026 -> October 15, 2026, exactly the section
// 6081(a) statutory cap). The `power S6081GrantExtensionPower` exercise
// itself is a case fact this pilot asserts (`requests_extension`); its
// grant is an EFFECT the engine would compute by evaluating the power, not
// something this case asserts as a fact (that would be circular). This
// pilot does not execute `ask`, so the grant's `positions()` outcome is a
// deferred check (see PILOT.md).

case V3ExtensionChangesFilingWindowOnly {
    context {
        legal_time @2026-04-15;
        knowledge_time @2026-04-15T09:00:00-04:00;
        decision_time @2026-04-15T09:00:00-04:00;
        timezone "America/New_York";
        deadline_policy us.irc.core::IRC_CALENDAR_STEP;
    }

    const dana: us.irc.core::Individual = entity_ref("urn:us:irc:case:pilot-individual-2025:dana");
    const ty2025: us.irc.core::TaxableYear = entity_ref("urn:us:irc:case:pilot-individual-2025:ty2025");
    const r: us.irc.core::Return = entity_ref("urn:us:irc:case:pilot-individual-2025:return-2025");

    assert "ty2025-ends": us.irc.core::ends(ty2025, @2025-12-31) { origin case_input; }
    assert "return-of": us.irc.core::return_of(r, dana, ty2025, us.irc.core::IncomeCh1) { origin case_input; }
    assert "filer-of-record": us.irc.returns::income_tax_filer_of_record(dana, ty2025) { origin case_input; }

    // Statutory due date derives to 2026-04-15 (see returns/05-timing-and-
    // place.law::S6072GeneralIncomeDueDate) from the two facts above.

    // --- Section 6081(a): request a 6-month extension of the FILING window -
    assert "requests-extension": us.irc.returns::requests_extension(dana, r, @2026-10-15) { origin case_input; }

    // --- Section 6151(a): the payment duty is keyed to `core::due_date`,
    // bridged (by `assessment`) from the UNEXTENDED `statutory_due_date`
    // above, not from `extension_granted`. Liability and full, on-time
    // payment facts are the same as V1's, to show the payment side is
    // unaffected by the filing extension. -----------------------------------
    assert "liability": us.irc.core::liability(dana, ty2025, us.irc.core::IncomeCh1, 773.00 USD) { origin case_input; }
    const payBalance: us.irc.core::Payment = entity_ref("urn:us:irc:case:pilot-individual-2025:v3-payment-balance");
    assert "pay-balance": us.irc.core::payment(payBalance, dana, 773.00 USD, @2026-04-15) { origin case_input; }
    assert "pay-balance-applied": us.irc.core::payment_applied(payBalance, dana, ty2025, us.irc.core::IncomeCh1) { origin case_input; }
}
