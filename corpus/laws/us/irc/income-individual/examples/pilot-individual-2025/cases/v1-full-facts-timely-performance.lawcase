language "law.core" version "0.2";
package us.irc.examples.pilot_individual_2025 version "0.1.1";
namespace "urn:us:irc:examples:pilot-individual-2025";

// PLAN.ru.md §9, variant 1: full facts -> amount -> positions -> timely
// performance. Dana Whitfield, head of household, one qualifying child
// (Sam), taxable year 2025 (calendar year). Wages, interest and one
// long-term capital gain from a stock sale; an above-the-line IRA
// deduction; the standard deduction; the child tax credit; the section 31
// withholding credit; return filed and tax paid in full by April 15, 2026.
//
// SIMPLIFICATIONS carried by every variant in this package (see PILOT.md
// for the full list with citations):
//  - The capital gain is asserted as an ordinary section 61(a)(3) gross
//    income item and taxed at ordinary section 1 rates. The section 1(h)
//    preferential capital-gains rate chain (`income-individual/capital-
//    gains.law`) is NOT exercised: its breakpoints were not hand-verified
//    against a pinned 2025 dataset within this pilot's time budget.
//  - `us.irc.income_individual::taxable_income` and
//    `us.irc.gross_income::taxable_income` are two DIFFERENT relations of
//    the same name in different packages with no automatic bridge
//    (confirmed by the WIRE-1/WIRE-2 survey); this case asserts the
//    `income_individual` one directly with the number `gross_income`'s own
//    rules would derive from the facts below (documented, not invented —
//    see the arithmetic in PILOT.md).
//  - The taxpayer's status as head of household (§2(b)) and the child's
//    status as a qualifying child (§24(c)) are asserted directly rather
//    than derived through `maintains_household_for`/`qualifying_child_of`,
//    which are declared but not `pub` in `income_individual` — a
//    cross-package surface gap recorded in PILOT.md, not fixed here (fixing
//    it is a modelling change to another package's private-relation
//    surface, out of this pilot's additive-`pub`-only budget).
//  - Section 219 IRA limit ($5,000) and the standard deduction/CTC amounts
//    below are the CORPUS'S OWN pinned or unadjusted-statutory-base
//    figures, not necessarily the true IRS-published 2025 numbers where the
//    corpus itself records a SOURCE_GAP (see PILOT.md's gap table).

case V1FullFactsTimelyPerformance {
    context {
        legal_time @2026-04-15;
        knowledge_time @2026-04-15T09:00:00-04:00;
        decision_time @2026-04-15T09:00:00-04:00;
        timezone "America/New_York";
        deadline_policy us.irc.core::IRC_CALENDAR_STEP;
    }

    const dana: us.irc.core::Individual = entity_ref("urn:us:irc:case:pilot-individual-2025:dana");
    const sam: us.irc.core::Person = entity_ref("urn:us:irc:case:pilot-individual-2025:sam");
    const ty2025: us.irc.core::TaxableYear = entity_ref("urn:us:irc:case:pilot-individual-2025:ty2025");
    const r: us.irc.core::Return = entity_ref("urn:us:irc:case:pilot-individual-2025:return-2025");
    const payWithholding: us.irc.core::Payment = entity_ref("urn:us:irc:case:pilot-individual-2025:payment-withholding-2025");
    const payBalance: us.irc.core::Payment = entity_ref("urn:us:irc:case:pilot-individual-2025:payment-balance-2025");

    // --- Taxable year and return identity ---------------------------------
    assert "ty2025-ends": us.irc.core::ends(ty2025, @2025-12-31) { origin case_input; }
    assert "return-of": us.irc.core::return_of(r, dana, ty2025, us.irc.core::IncomeCh1) { origin case_input; }
    assert "filed-by": us.irc.core::filed_by(r, dana) { origin case_input; }
    assert "filed-on": us.irc.core::filed_on(r, @2026-04-10) { origin case_input; }

    // --- Section 6072(a)/6081 due-date chain (returns) ---------------------
    assert "filer-of-record": us.irc.returns::income_tax_filer_of_record(dana, ty2025) { origin case_input; }

    // --- Section 61 gross income items -------------------------------------
    assert "wages": us.irc.gross_income::gross_income_item(dana, ty2025, us.irc.gross_income::CompensationForServices, 52000.00 USD) { origin case_input; }
    assert "interest": us.irc.gross_income::gross_income_item(dana, ty2025, us.irc.gross_income::Interest, 500.00 USD) { origin case_input; }
    assert "stock-gain": us.irc.gross_income::gross_income_item(dana, ty2025, us.irc.gross_income::GainsFromDealingsInProperty, 1500.00 USD) { origin case_input; }

    // --- Section 62 above-the-line IRA deduction (section 219) -------------
    // SOURCE_GAP: $5,000 is section 219(b)(1)(A)'s 2001 unadjusted statutory
    // base as read by `us.irc.deductions::219-ira.law`; the true 2025
    // published limit (~$7,000) is not pinned anywhere in this corpus.
    assert "ira-deduction": us.irc.gross_income::above_the_line_deduction_amount(dana, ty2025, us.irc.gross_income::RetirementSavingsDeduction, 5000.00 USD) { origin case_input; }

    // --- Section 63 non-itemizer arithmetic: zero the unresolved slots -----
    assert "no-151": us.irc.gross_income::personal_exemption_deduction_151(dana, ty2025, 0.00 USD) { origin case_input; }
    assert "no-199a": us.irc.gross_income::section_199a_deduction(dana, ty2025, 0.00 USD) { origin case_input; }
    assert "no-170p": us.irc.gross_income::section_170p_deduction(dana, ty2025, 0.00 USD) { origin case_input; }

    // --- Section 2(b) head of household (asserted directly; see header) ---
    assert "hoh": us.irc.income_individual::head_of_household(dana, ty2025) { origin case_input; }

    // --- Bridge into income_individual's own taxable_income/tax_under_section_1
    // chain (see header simplification note). 49,000.00 (AGI: 54,000 gross
    // minus 5,000 IRA) minus 23,625.00 (2025 HoH standard deduction, Pub. L.
    // 119-21 section 70102(b)) = 25,375.00.
    assert "taxable-income-bridge": us.irc.income_individual::taxable_income(dana, ty2025, 25375.00 USD) { origin case_input; }

    // --- Section 24 child tax credit ---------------------------------------
    assert "qualifying-child": us.irc.credits::child_tax_credit_qualifying_child(sam, dana, ty2025) { origin case_input; }
    assert "ssn-included": us.irc.credits::ssn_included_24h7(dana, sam, ty2025) { origin case_input; }

    // --- Section 31 withholding credit -------------------------------------
    assert "withheld-wages": us.irc.credits::amount_withheld_wages(dana, 2025, 300.00 USD) { origin case_input; }
    assert "last-year-in-2025": us.irc.credits::last_taxable_year_beginning_in(dana, 2025, ty2025) { origin case_input; }

    // --- Section 6151 payment duty: liability net of the child tax credit,
    // withholding and the year-end balance paid on the due date ------------
    assert "liability": us.irc.core::liability(dana, ty2025, us.irc.core::IncomeCh1, 773.00 USD) { origin case_input; }
    assert "pay-withholding": us.irc.core::payment(payWithholding, dana, 300.00 USD, @2025-12-31) { origin case_input; }
    assert "pay-withholding-applied": us.irc.core::payment_applied(payWithholding, dana, ty2025, us.irc.core::IncomeCh1) { origin case_input; }
    assert "pay-balance": us.irc.core::payment(payBalance, dana, 473.00 USD, @2026-04-15) { origin case_input; }
    assert "pay-balance-applied": us.irc.core::payment_applied(payBalance, dana, ty2025, us.irc.core::IncomeCh1) { origin case_input; }

    // --- Section 6651(a)(2) base facts: paid in full on or before the due
    // date, so no failure-to-pay addition arises -----------------------------
    assert "tax-shown": us.irc.penalties::tax_shown_on_return(r, 773.00 USD) { origin case_input; }
    assert "paid-on-or-before-due": us.irc.penalties::amount_paid_on_or_before(r, @2026-04-15, 773.00 USD) { origin case_input; }

    // --- Section 6501 limitations period (background; no defeater facts) --
}
