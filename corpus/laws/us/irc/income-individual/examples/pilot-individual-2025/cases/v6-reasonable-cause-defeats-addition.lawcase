language "law.core" version "0.2";
package us.irc.examples.pilot_individual_2025 version "0.1.1";
namespace "urn:us:irc:examples:pilot-individual-2025";

// PLAN.ru.md §9, variant 6: an addition with established conditions (see
// V4 -- same base facts, no exception, addition computed to 9.46) AND a
// case with an applicable exception. This case is the exception half: the
// section 6651(a) reasonable-cause-and-no-willful-neglect showing is a
// DECISION-0194 "external judgment relation" (channel: Secretary,
// `us.irc.penalties::reasonable_cause_and_no_willful_neglect`), asserted
// here as an adjudicated fact rather than derived -- consistent with the
// package's own note that a taxpayer disputing an adverse ADMINISTRATIVE
// finding proceeds to Tax Court, outside this package's own scope. With the
// showing made, the `unless` clause of `FailureToPayAddition` (defeasible)
// is satisfied and no section 6651(a)(2) addition should arise for this
// return, even though the SAME base/measurement facts as V4 are present.
//
// The `FailureContext` entity is reified because the same person can have
// several concurrent failures under different additions in the same
// taxable year (`penalties/01-shared.law` comment); one instance suffices
// here, for the single failure-to-pay context at issue.

case V6ReasonableCauseDefeatsAddition {
    context {
        legal_time @2026-07-20;
        knowledge_time @2026-07-20T09:00:00-04:00;
        decision_time @2026-07-20T09:00:00-04:00;
        timezone "America/New_York";
        deadline_policy us.irc.core::IRC_CALENDAR_STEP;
    }

    const dana: us.irc.core::Individual = entity_ref("urn:us:irc:case:pilot-individual-2025:dana");
    const ty2025: us.irc.core::TaxableYear = entity_ref("urn:us:irc:case:pilot-individual-2025:ty2025");
    const r: us.irc.core::Return = entity_ref("urn:us:irc:case:pilot-individual-2025:v6-return");
    const payWithholding: us.irc.core::Payment = entity_ref("urn:us:irc:case:pilot-individual-2025:v6-payment-withholding");
    const fc: us.irc.penalties::FailureContext = entity_ref("urn:us:irc:case:pilot-individual-2025:v6-failure-to-pay-context");

    assert "ty2025-ends": us.irc.core::ends(ty2025, @2025-12-31) { origin case_input; }
    assert "return-of": us.irc.core::return_of(r, dana, ty2025, us.irc.core::IncomeCh1) { origin case_input; }
    assert "filed-by": us.irc.core::filed_by(r, dana) { origin case_input; }
    assert "filed-on": us.irc.core::filed_on(r, @2026-04-10) { origin case_input; }
    assert "filer-of-record": us.irc.returns::income_tax_filer_of_record(dana, ty2025) { origin case_input; }

    assert "liability": us.irc.core::liability(dana, ty2025, us.irc.core::IncomeCh1, 773.00 USD) { origin case_input; }
    assert "pay-withholding": us.irc.core::payment(payWithholding, dana, 300.00 USD, @2025-12-31) { origin case_input; }
    assert "pay-withholding-applied": us.irc.core::payment_applied(payWithholding, dana, ty2025, us.irc.core::IncomeCh1) { origin case_input; }

    assert "tax-shown": us.irc.penalties::tax_shown_on_return(r, 773.00 USD) { origin case_input; }
    assert "paid-on-or-before-due": us.irc.penalties::amount_paid_on_or_before(r, @2026-04-15, 300.00 USD) { origin case_input; }
    assert "measurement-date": us.irc.penalties::failure_to_pay_measurement_date(r, @2026-07-20) { origin case_input; }

    // The exception: reasonable cause and no willful neglect, shown to the
    // Secretary's satisfaction (adjudicated fact, not case-side argument).
    assert "reasonable-cause": us.irc.penalties::reasonable_cause_and_no_willful_neglect(dana, fc) {
        origin adjudicated;
    }
}
