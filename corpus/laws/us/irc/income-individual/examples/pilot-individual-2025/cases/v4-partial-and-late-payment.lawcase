language "law.core" version "0.2";
package us.irc.examples.pilot_individual_2025 version "0.1.1";
namespace "urn:us:irc:examples:pilot-individual-2025";

// PLAN.ru.md §9, variant 4: a partial payment produces the correct
// remaining balance; a LATE payment preserves the violation history.
//
// Only $300.00 (withholding, deemed paid by the due date) is paid on or
// before April 15, 2026. A further $200.00 arrives May 20, 2026 -- after
// the due date. `us.irc.payment_refunds_interest::remaining_balance` nets
// ALL asserted payments regardless of date (its own header comment: "NO
// DATE PARAMETER ... the relation itself answers 'balance given everything
// currently on record'"), so the CURRENT remaining balance after the May
// payment is correctly 773.00 - 300.00 - 200.00 = 273.00.
//
// `us.irc.penalties::failure_to_pay_penalty_base`, however, nets only
// payments "on or before" the due date (the package's own documented
// simplification of section 6651(b)'s month-by-month netting -- see
// `penalties/04-failure-to-file-and-pay-6651.law` header): the May payment
// does NOT reduce that base, so the section 6651(a)(2) addition is computed
// on the full 473.00 unpaid-as-of-due-date amount, not the 273.00
// currently outstanding. This is the "late payment keeps the VIOLATED
// history" half of the variant: whether `positions()` for
// `S6151PayTaxShownOnReturn`'s achievement duty reports VIOLATED for the
// [-infinity, 2026-04-15] window even though more was paid afterward is a
// DEFERRED check (this pilot does not execute `ask`) -- see PILOT.md.
//
// Failure-to-pay addition (measured July 20, 2026, 4 months or a fraction
// of a month late): min(round(473.00 * 0.005 * 4, 2), round(473.00 * 0.25, 2))
// = min(9.46, 118.25) = 9.46.

case V4PartialAndLatePayment {
    context {
        legal_time @2026-07-20;
        knowledge_time @2026-07-20T09:00:00-04:00;
        decision_time @2026-07-20T09:00:00-04:00;
        timezone "America/New_York";
        deadline_policy us.irc.core::IRC_CALENDAR_STEP;
    }

    const dana: us.irc.core::Individual = entity_ref("urn:us:irc:case:pilot-individual-2025:dana");
    const ty2025: us.irc.core::TaxableYear = entity_ref("urn:us:irc:case:pilot-individual-2025:ty2025");
    const r: us.irc.core::Return = entity_ref("urn:us:irc:case:pilot-individual-2025:return-2025");
    const payWithholding: us.irc.core::Payment = entity_ref("urn:us:irc:case:pilot-individual-2025:v4-payment-withholding");
    const payPartial: us.irc.core::Payment = entity_ref("urn:us:irc:case:pilot-individual-2025:v4-payment-partial");

    assert "ty2025-ends": us.irc.core::ends(ty2025, @2025-12-31) { origin case_input; }
    assert "return-of": us.irc.core::return_of(r, dana, ty2025, us.irc.core::IncomeCh1) { origin case_input; }
    assert "filed-by": us.irc.core::filed_by(r, dana) { origin case_input; }
    assert "filed-on": us.irc.core::filed_on(r, @2026-04-10) { origin case_input; }
    assert "filer-of-record": us.irc.returns::income_tax_filer_of_record(dana, ty2025) { origin case_input; }

    assert "liability": us.irc.core::liability(dana, ty2025, us.irc.core::IncomeCh1, 773.00 USD) { origin case_input; }
    assert "pay-withholding": us.irc.core::payment(payWithholding, dana, 300.00 USD, @2025-12-31) { origin case_input; }
    assert "pay-withholding-applied": us.irc.core::payment_applied(payWithholding, dana, ty2025, us.irc.core::IncomeCh1) { origin case_input; }
    // Partial payment, AFTER the due date.
    assert "pay-partial": us.irc.core::payment(payPartial, dana, 200.00 USD, @2026-05-20) { origin case_input; }
    assert "pay-partial-applied": us.irc.core::payment_applied(payPartial, dana, ty2025, us.irc.core::IncomeCh1) { origin case_input; }

    // Section 6651(a)(2) facts: only the withholding counts as paid "on or
    // before" the due date; the base is therefore 773.00 - 300.00 = 473.00.
    assert "tax-shown": us.irc.penalties::tax_shown_on_return(r, 773.00 USD) { origin case_input; }
    assert "paid-on-or-before-due": us.irc.penalties::amount_paid_on_or_before(r, @2026-04-15, 300.00 USD) { origin case_input; }
    assert "measurement-date": us.irc.penalties::failure_to_pay_measurement_date(r, @2026-07-20) { origin case_input; }
}
