language "law.core" version "0.2";
package us.irc.examples.pilot_individual_2025 version "0.1.1";
namespace "urn:us:irc:examples:pilot-individual-2025";

// PLAN.ru.md §9, variant 5: an unknown mailing date leaves the section
// 6213(a) petition window NOT ESTABLISHED (NEITHER on
// `petition_window_deadline`), not VIOLATED and not a fixed date the case
// can hand-compute. `us.irc.assessment::S6213PetitionWindowDeadlineDomestic`
// requires `us.irc.core::mailed_on(n, mailedOn)` as a positive premise; this
// case deliberately asserts a notice of deficiency WITHOUT a mailing date,
// so the rule's antecedent is missing and `petition_window_deadline` stays
// undetermined -- distinguishable in `why_not` from a case that has a
// mailing date but no valid rule application.

case V5UnknownNoticeMailingDate {
    context {
        legal_time @2026-08-01;
        knowledge_time @2026-08-01T09:00:00-04:00;
        decision_time @2026-08-01T09:00:00-04:00;
        timezone "America/New_York";
        deadline_policy us.irc.core::IRC_CALENDAR_STEP;
    }

    const dana: us.irc.core::Individual = entity_ref("urn:us:irc:case:pilot-individual-2025:dana");
    const ty2025: us.irc.core::TaxableYear = entity_ref("urn:us:irc:case:pilot-individual-2025:ty2025");
    const n: us.irc.core::Notice = entity_ref("urn:us:irc:case:pilot-individual-2025:v5-notice");

    assert "ty2025-ends": us.irc.core::ends(ty2025, @2025-12-31) { origin case_input; }

    // A valid notice of deficiency exists for this year/kind, but its
    // mailing date is deliberately NOT asserted.
    assert "deficiency-notice-for": us.irc.assessment::deficiency_notice_for(n, dana, ty2025, us.irc.core::IncomeCh1) { origin case_input; }
    assert "notice-valid": us.irc.assessment::notice_of_deficiency_valid(n, dana) { origin case_input; }

    // Deliberately absent: `us.irc.core::mailed_on(n, ...)`. Without it,
    // neither `S6213PetitionWindowDeadlineDomestic` nor
    // `S6213PetitionWindowDeadlineAbroad` can fire, so
    // `petition_window_deadline(n, dana, _)` is NEITHER, not a computed
    // date and not VIOLATED.
}
