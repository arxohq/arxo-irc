language "law.core" version "0.2";
package us.irc.examples.pilot_individual_2025 version "0.1.1";
namespace "urn:us:irc:examples:pilot-individual-2025";

// PLAN.ru.md §9, variant 2: same facts, a different taxable year (2024
// instead of 2025) -> an EXPLAINABLE difference in the computed amount.
//
// The difference demonstrated here is real and pinned, not invented: the
// section 1(j)(2)(B) TCJA head-of-household bracket table is identical for
// 2024 and 2025 (same "2018 unadjusted" table, effective window
// [2018-01-01, 2026-01-01)), but the HEAD-OF-HOUSEHOLD STANDARD DEDUCTION is
// NOT: `gross-income/basic-standard-deduction-head-of-household.lawparam.json`
// pins $18,000 for 2018-2024 (the 2018 unadjusted TCJA base, itself a
// SOURCE_GAP against the true ~$21,900 2024 published figure) and $23,625
// for 2025 forward (Pub. L. 119-21 section 70102(b), OBBBA, 4 July 2025 —
// no further COLA needed, Congress set a flat new figure). Holding every
// other fact constant, this raises 2024's taxable income (and hence its
// section 1 tax) relative to 2025's by exactly the $5,625 standard-deduction
// difference:
//   TY2025: AGI 49,000.00 - std.ded. 23,625.00 = taxable income 25,375.00
//           -> tax_under_section_1 = 1,360.00 + 0.12*(25,375-13,600) = 2,773.00
//   TY2024: AGI 49,000.00 - std.ded. 18,000.00 = taxable income 31,000.00
//           -> tax_under_section_1 = 1,360.00 + 0.12*(31,000-13,600) = 3,448.00
//   Difference: 3,448.00 - 2,773.00 = 675.00, entirely attributable to
//   section 70102(b) and traceable to the two `.lawparam.json` value rows.
//
// The child tax credit is unaffected (both years fall inside the same
// [2018-01-01, 2026-01-01) $2,000-per-child window), so this variant does
// NOT also exercise the credit chain — see V1 for that. This case asserts
// BOTH years' `income_individual::taxable_income` bridge values directly
// (see V1's header note on the cross-package taxable_income collision).

case V2AlternateEditionDifference {
    context {
        legal_time @2026-04-15;
        knowledge_time @2026-04-15T09:00:00-04:00;
        decision_time @2026-04-15T09:00:00-04:00;
        timezone "America/New_York";
        deadline_policy us.irc.core::IRC_CALENDAR_STEP;
    }

    const dana: us.irc.core::Individual = entity_ref("urn:us:irc:case:pilot-individual-2025:dana");
    const ty2025: us.irc.core::TaxableYear = entity_ref("urn:us:irc:case:pilot-individual-2025:ty2025");
    const ty2024: us.irc.core::TaxableYear = entity_ref("urn:us:irc:case:pilot-individual-2025:ty2024");

    assert "ty2025-ends": us.irc.core::ends(ty2025, @2025-12-31) { origin case_input; }
    assert "ty2024-ends": us.irc.core::ends(ty2024, @2024-12-31) { origin case_input; }

    assert "hoh-2025": us.irc.income_individual::head_of_household(dana, ty2025) { origin case_input; }
    assert "hoh-2024": us.irc.income_individual::head_of_household(dana, ty2024) { origin case_input; }

    // Identical income/deduction facts in both years (the point of this
    // variant is the EDITION difference, not an income difference).
    assert "wages-2025": us.irc.gross_income::gross_income_item(dana, ty2025, us.irc.gross_income::CompensationForServices, 52000.00 USD) { origin case_input; }
    assert "interest-2025": us.irc.gross_income::gross_income_item(dana, ty2025, us.irc.gross_income::Interest, 500.00 USD) { origin case_input; }
    assert "stock-gain-2025": us.irc.gross_income::gross_income_item(dana, ty2025, us.irc.gross_income::GainsFromDealingsInProperty, 1500.00 USD) { origin case_input; }
    assert "ira-2025": us.irc.gross_income::above_the_line_deduction_amount(dana, ty2025, us.irc.gross_income::RetirementSavingsDeduction, 5000.00 USD) { origin case_input; }
    assert "no-151-2025": us.irc.gross_income::personal_exemption_deduction_151(dana, ty2025, 0.00 USD) { origin case_input; }
    assert "no-199a-2025": us.irc.gross_income::section_199a_deduction(dana, ty2025, 0.00 USD) { origin case_input; }
    assert "no-170p-2025": us.irc.gross_income::section_170p_deduction(dana, ty2025, 0.00 USD) { origin case_input; }

    assert "wages-2024": us.irc.gross_income::gross_income_item(dana, ty2024, us.irc.gross_income::CompensationForServices, 52000.00 USD) { origin case_input; }
    assert "interest-2024": us.irc.gross_income::gross_income_item(dana, ty2024, us.irc.gross_income::Interest, 500.00 USD) { origin case_input; }
    assert "stock-gain-2024": us.irc.gross_income::gross_income_item(dana, ty2024, us.irc.gross_income::GainsFromDealingsInProperty, 1500.00 USD) { origin case_input; }
    assert "ira-2024": us.irc.gross_income::above_the_line_deduction_amount(dana, ty2024, us.irc.gross_income::RetirementSavingsDeduction, 5000.00 USD) { origin case_input; }
    assert "no-151-2024": us.irc.gross_income::personal_exemption_deduction_151(dana, ty2024, 0.00 USD) { origin case_input; }
    assert "no-199a-2024": us.irc.gross_income::section_199a_deduction(dana, ty2024, 0.00 USD) { origin case_input; }
    assert "no-170p-2024": us.irc.gross_income::section_170p_deduction(dana, ty2024, 0.00 USD) { origin case_input; }

    // Bridge amounts (see header arithmetic).
    assert "taxable-income-2025": us.irc.income_individual::taxable_income(dana, ty2025, 25375.00 USD) { origin case_input; }
    assert "taxable-income-2024": us.irc.income_individual::taxable_income(dana, ty2024, 31000.00 USD) { origin case_input; }
}
