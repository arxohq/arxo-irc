// Section 55(b)(3): maximum rate of tax on net capital gain of noncorporate
// taxpayers under the alternative minimum tax (stage 2).
//
// The first-sentence amount of section 55(b)(1)(A) (the two-rate amount on the
// taxable excess) may not exceed the sum of five layers:
//   (A) the two-rate amount on the taxable excess reduced by the lesser of
//       the net capital gain, or the adjusted net capital gain plus the
//       unrecaptured section 1250 gain;
//   (B) 0 percent of the adjusted net capital gain (or, if less, the taxable
//       excess) up to the section 1(h)(1)(B) excess;
//   (C) 15 percent of the lesser of what remains of that gain above (B), or
//       the section 1(h)(1)(C)(ii) excess;
//   (D) 20 percent of the rest of that gain;
//   (E) 25 percent of the taxable excess above everything the earlier layers
//       taxed.
//
// "Terms used in this paragraph which are also used in section 1(h) shall
// have the respective meanings given such terms by section 1(h) but computed
// with the adjustments under this part": the five capital-gain aggregates
// below are therefore DIFFERENT values from the ones `capital-gains.law`
// declares for section 1(h) itself; they are typed dependency contracts (the
// producers are `us.irc.property_transactions` for the gain aggregates and the
// section 1(h)(1)(B)/(C) rate-bracket amounts of `capital-gains.law`, whose
// executable form is a stage-1 technical gap). The layer arithmetic below is
// exact and uses `min`/`max`; it does not need the ordered-accumulation
// construct stage 1 could not verify.

use self::{
    IRC_S55_B,
    Person,
    TaxableYear,
    amt_rate_breakpoint,
    amt_taxable_excess,
};

pub relation amt_net_capital_gain(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "net capital gain, with the adjustments of part VI of subchapter A of chapter 1";
}
pub relation amt_adjusted_net_capital_gain(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "adjusted net capital gain, with the adjustments of part VI of subchapter A of chapter 1";
}
pub relation amt_unrecaptured_section_1250_gain(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "unrecaptured section 1250 gain, with the adjustments of part VI of subchapter A of chapter 1";
}
pub relation section_1h_1_b_excess(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the excess described in section 1(h)(1)(B) (the amount taxed at the zero rate)";
}
pub relation section_1h_1_c_ii_excess(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the excess described in section 1(h)(1)(C)(ii) (the top of the 15 percent bracket)";
}

pub relation amt_capital_gain_limit(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the sum of the section 55(b)(3)(A)-(E) amounts: the ceiling on the first-sentence amount of section 55(b)(1)(A)";
}

relation amt_cg_ordinary_base(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the taxable excess reduced by the lesser of the net capital gain, or the adjusted net capital gain plus the unrecaptured section 1250 gain (never below zero)";
}
relation amt_cg_gain_base(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the adjusted net capital gain (or, if less, the taxable excess)";
}
relation amt_cg_zero_layer(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount on which tax is determined under subparagraph (B) (at 0 percent)";
}
relation amt_cg_fifteen_layer(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount on which tax is determined under subparagraph (C) (at 15 percent)";
}
relation amt_cg_twenty_layer(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount on which tax is determined under subparagraph (D) (at 20 percent)";
}
relation amt_cg_twentyfive_layer(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount on which tax is determined under subparagraph (E) (at 25 percent)";
}

@source(IRC_S55_B, relation = formalizes, coverage = exact, quote = "(A) the amount determined under such first sentence computed at the rates and in the same manner as if this paragraph had not been enacted on the taxable excess reduced by the lesser of—")
rule AmtCgOrdinaryBase(p: Person, y: TaxableYear, te: Money, ncg: Money, ancg: Money, u1250: Money) strict {
    label en official "subparagraph (A): the taxable excess reduced by min(net capital gain, adjusted net capital gain + unrecaptured section 1250 gain)";
    when amt_taxable_excess(p, y, te);
    when amt_net_capital_gain(p, y, ncg);
    when amt_adjusted_net_capital_gain(p, y, ancg);
    when amt_unrecaptured_section_1250_gain(p, y, u1250);
    then amt_cg_ordinary_base(p, y, max(0.00 USD, te - min(ncg, ancg + u1250)));
}

@source(IRC_S55_B, relation = formalizes, coverage = partial, quote = "(B) 0 percent of so much of the adjusted net capital gain (or, if less, taxable excess) as does not exceed an amount equal to the excess described in section 1(h)(1)(B), plus")
rule AmtCgGainBase(p: Person, y: TaxableYear, te: Money, ancg: Money) strict {
    label en official "the adjusted net capital gain (or, if less, taxable excess) that layers (B), (C) and (D) divide";
    when amt_taxable_excess(p, y, te);
    when amt_adjusted_net_capital_gain(p, y, ancg);
    then amt_cg_gain_base(p, y, min(ancg, te));
}

@source(IRC_S55_B, relation = formalizes, coverage = exact, quote = "(B) 0 percent of so much of the adjusted net capital gain (or, if less, taxable excess) as does not exceed an amount equal to the excess described in section 1(h)(1)(B), plus")
rule AmtCgZeroLayer(p: Person, y: TaxableYear, gain: Money, zero_excess: Money) strict {
    label en official "subparagraph (B): the gain up to the section 1(h)(1)(B) excess is taxed at 0 percent";
    when amt_cg_gain_base(p, y, gain);
    when section_1h_1_b_excess(p, y, zero_excess);
    then amt_cg_zero_layer(p, y, min(gain, zero_excess));
}

@source(IRC_S55_B, relation = formalizes, coverage = exact, quote = "(C) 15 percent of the lesser of—")
rule AmtCgFifteenLayer(p: Person, y: TaxableYear, gain: Money, zero_layer: Money, fifteen_excess: Money) strict {
    label en official "subparagraph (C): the lesser of the gain above the (B) amount, or the section 1(h)(1)(C)(ii) excess, is taxed at 15 percent";
    when amt_cg_gain_base(p, y, gain);
    when amt_cg_zero_layer(p, y, zero_layer);
    when section_1h_1_c_ii_excess(p, y, fifteen_excess);
    then amt_cg_fifteen_layer(p, y, min(max(0.00 USD, gain - zero_layer), fifteen_excess));
}

@source(IRC_S55_B, relation = formalizes, coverage = exact, quote = "(D) 20 percent of the adjusted net capital gain (or, if less, taxable excess) in excess of the sum of the amounts on which tax is determined under subparagraphs (B) and (C), plus")
rule AmtCgTwentyLayer(p: Person, y: TaxableYear, gain: Money, zero_layer: Money, fifteen_layer: Money) strict {
    label en official "subparagraph (D): the gain above the (B) and (C) amounts is taxed at 20 percent";
    when amt_cg_gain_base(p, y, gain);
    when amt_cg_zero_layer(p, y, zero_layer);
    when amt_cg_fifteen_layer(p, y, fifteen_layer);
    then amt_cg_twenty_layer(p, y, max(0.00 USD, gain - (zero_layer + fifteen_layer)));
}

@source(IRC_S55_B, relation = formalizes, coverage = exact, quote = "(E) 25 percent of the amount of taxable excess in excess of the sum of the amounts on which tax is determined under the preceding subparagraphs of this paragraph.")
rule AmtCgTwentyFiveLayer(p: Person, y: TaxableYear, te: Money, ordinary_base: Money, zero_layer: Money, fifteen_layer: Money, twenty_layer: Money) strict {
    label en official "subparagraph (E): the taxable excess above the amounts taxed under (A)-(D) is taxed at 25 percent";
    when amt_taxable_excess(p, y, te);
    when amt_cg_ordinary_base(p, y, ordinary_base);
    when amt_cg_zero_layer(p, y, zero_layer);
    when amt_cg_fifteen_layer(p, y, fifteen_layer);
    when amt_cg_twenty_layer(p, y, twenty_layer);
    then amt_cg_twentyfive_layer(p, y, max(0.00 USD, te - (ordinary_base + (zero_layer + (fifteen_layer + twenty_layer)))));
}

@source(IRC_S55_B, relation = formalizes, coverage = exact, quote = "The amount determined under the first sentence of paragraph (1)(A) shall not exceed the sum of—")
rule AmtCapitalGainLimitRule(p: Person, y: TaxableYear, ordinary_base: Money, breakpoint: Money, fifteen_layer: Money, twenty_layer: Money, twentyfive_layer: Money) strict {
    label en official "the ceiling: the two-rate amount on the (A) base plus 15 percent of the (C) layer, 20 percent of the (D) layer and 25 percent of the (E) layer (the (B) layer is at 0 percent)";
    when amt_cg_ordinary_base(p, y, ordinary_base);
    when amt_rate_breakpoint(p, y, breakpoint);
    when amt_cg_fifteen_layer(p, y, fifteen_layer);
    when amt_cg_twenty_layer(p, y, twenty_layer);
    when amt_cg_twentyfive_layer(p, y, twentyfive_layer);
    then amt_capital_gain_limit(p, y, (((min(ordinary_base, breakpoint) * 0.26) + (max(0.00 USD, ordinary_base - breakpoint) * 0.28)) + (fifteen_layer * 0.15)) + ((twenty_layer * 0.20) + (twentyfive_layer * 0.25)));
}
