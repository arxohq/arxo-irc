// Section 1(i): the rate reductions after 2000 (stage 3, TECH_GAP reduction,
// 26.09.2026). Operative for taxable years beginning after December 31, 2000
// and, by section 1(j)(1)(A), NOT for taxable years beginning after December
// 31, 2017: every rule is bounded `effective [2001-01-01, 2018-01-01)`.
//
// MODELLED: the amounts and the slices of taxable income the paragraphs
// name: (1) the 10-percent bracket (initial bracket amount, its 2002-based
// adjustment and the rounding of the amount after adjustment), the 15-percent
// slice that now starts at the initial bracket amount; (2) the rate
// substitutions 28->25, 31->28, 36->33; (3) the 35-percent bracket, the
// applicable thresholds and the 39.6-percent slice; (4) the Secretary's duty
// to adjust the tables. Slices are expressed as functions of taxable income
// and of the facts that come from the tables of subsection (f) in force for
// the year (the maximum of the 15-percent bracket, the dollar amount at which
// the highest bracket begins): those are inputs, since the year's indexed
// tables are not pinned.
//
// NOT DERIVED (coverage rows, TECH_GAP): the full tax under the modified
// tables above the 15-percent slice (the base-tax column of every bracket
// changes when the initial bracket and the rates change; that is the
// accumulation that section 1(f)(2)(C) requires and that needs ordered
// accumulation over brackets).
//
// FILING-STATUS MAPPING. Subsection (a) is the joint table, (b) head of
// household, (c) unmarried, (d) married filing separately, (e) estates and
// trusts.

use self::{
    FilingStatus,
    IRC_S1_I,
    Person,
    RegulatoryMandate,
    TaxableYear,
    amount_to_index,
    amount_to_index_floor,
    cola_adjusted_amount,
    cola_adjusted_amount_floor,
    filing_status,
    provision_mandates_secretary_rules,
    secretary_has_prescribed_rules,
    taxable_income,
};

pub relation initial_bracket_amount_base(t: FilingStatus, amount: Money) kind institutional {
    label en official "the initial bracket amount of section 1(i)(1)(B) before adjustment: $14,000 for subsection (a), $10,000 for subsection (b)";
}
relation initial_bracket_amount_of_joint_or_hoh(t: FilingStatus, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the subsection (a) or (b) initial bracket amount after the (C) adjustment (the basis of the one-half amounts of (c) and (d))";
}
pub relation initial_bracket_amount(t: FilingStatus, y: TaxableYear, amount: Money) kind institutional {
    label en official "the initial bracket amount for the table and the taxable year, after the section 1(i)(1)(C) adjustment for years after 2003";
}

@source(IRC_S1_I, relation = formalizes, coverage = exact, quote = "(i) $14,000 in the case of subsection (a),")
rule InitialBracketAmountBaseJoint() strict {
    label en official "section 1(i)(1)(B)(i)";
    then initial_bracket_amount_base(Joint, 14000 USD);
}
@source(IRC_S1_I, relation = formalizes, coverage = exact, quote = "(ii) $10,000 in the case of subsection (b), and")
rule InitialBracketAmountBaseHeadOfHousehold() strict {
    label en official "section 1(i)(1)(B)(ii)";
    then initial_bracket_amount_base(HeadOfHousehold, 10000 USD);
}

@source(IRC_S1_I, relation = formalizes, coverage = exact, quote = "In prescribing the tables under subsection (f) which apply with respect to taxable years beginning in calendar years after 2003—")
rule RequestInitialBracketAdjustment(t: FilingStatus, base: Money, y: TaxableYear, cy: Integer) strict {
    label en official "section 1(i)(1)(C): the joint and head-of-household initial bracket amounts are adjusted for taxable years beginning after 2003, 2002 substituted for 2016";
    effective [@2001-01-01, @2018-01-01);
    when initial_bracket_amount_base(t, base);
    when us.irc.core::calendar_year_of(y, cy);
    when cy > 2003;
    then amount_to_index_floor(base, 2002, y, 50);
}
@source(IRC_S1_I, relation = formalizes, coverage = exact, quote = "(i) the cost-of-living adjustment shall be determined under subsection (f)(3) by substituting \"2002\" for \"2016\" in subparagraph (A)(ii) thereof, and")
rule InitialBracketAmountAdjusted(t: FilingStatus, base: Money, y: TaxableYear, adjusted: Money) strict {
    label en official "section 1(i)(1)(C)(i): the adjusted amount, rounded down to a multiple of $50";
    effective [@2001-01-01, @2018-01-01);
    when initial_bracket_amount_base(t, base);
    when cola_adjusted_amount_floor(base, 2002, y, 50, adjusted);
    then initial_bracket_amount_of_joint_or_hoh(t, y, adjusted);
}
rule InitialBracketAmountAdjustedFinal(t: FilingStatus, y: TaxableYear, adjusted: Money) strict {
    label en official "section 1(i)(1)(C)(i): the adjusted amount, rounded down to a multiple of $50";
    effective [@2001-01-01, @2018-01-01);
    when initial_bracket_amount_of_joint_or_hoh(t, y, adjusted);
    then initial_bracket_amount(t, y, adjusted);
}
@source(IRC_S1_I, relation = formalizes, coverage = exact, quote = "(iii) ½ the amount applicable under clause (i) (after adjustment, if any, under subparagraph (C)) in the case of subsections (c) and (d).")
rule InitialBracketAmountUnadjustedYears(t: FilingStatus, base: Money, y: TaxableYear, cy: Integer) strict {
    label en official "section 1(i)(1)(B): for taxable years beginning before 2004 the amounts are as enacted";
    effective [@2001-01-01, @2004-01-01);
    when initial_bracket_amount_base(t, base);
    when us.irc.core::calendar_year_of(y, cy);
    when cy < 2004;
    then initial_bracket_amount_of_joint_or_hoh(t, y, base);
}
@source(IRC_S1_I, relation = formalizes, coverage = exact, quote = "(iii) ½ the amount applicable under clause (i) (after adjustment, if any, under subparagraph (C)) in the case of subsections (c) and (d).")
rule InitialBracketAmountUnmarriedHalf(y: TaxableYear, joint: Money) strict {
    label en official "section 1(i)(1)(B)(iii): one half of the subsection (a) amount for subsection (c); the (C)(ii) adjustment does not apply to it separately";
    effective [@2001-01-01, @2018-01-01);
    when initial_bracket_amount_of_joint_or_hoh(Joint, y, joint);
    then initial_bracket_amount(Unmarried, y, joint * 0.5);
}
@source(IRC_S1_I, relation = formalizes, coverage = exact, quote = "(iii) ½ the amount applicable under clause (i) (after adjustment, if any, under subparagraph (C)) in the case of subsections (c) and (d).")
rule InitialBracketAmountSeparateHalf(y: TaxableYear, joint: Money) strict {
    label en official "section 1(i)(1)(B)(iii): one half of the subsection (a) amount for subsection (d)";
    effective [@2001-01-01, @2018-01-01);
    when initial_bracket_amount_of_joint_or_hoh(Joint, y, joint);
    then initial_bracket_amount(MarriedSeparate, y, joint * 0.5);
}

// --- Section 1(i)(1)(A): the slices ------------------------------------------------

pub relation max_dollar_amount_15_percent_bracket(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the maximum dollar amount for the 15-percent rate bracket in the table of subsection (f) in force for the year";
}
pub relation ten_percent_bracket_income(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the taxable income not over the initial bracket amount, taxed at 10 percent";
}
pub relation fifteen_percent_bracket_income(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the taxable income over the initial bracket amount but not over the maximum dollar amount for the 15-percent bracket, taxed at 15 percent";
}
pub relation ten_percent_bracket_tax(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "10 percent of the taxable income not over the initial bracket amount";
}
pub relation fifteen_percent_bracket_tax(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "15 percent of the taxable income over the initial bracket amount but not over the maximum for the 15-percent bracket";
}

@source(IRC_S1_I, relation = formalizes, coverage = exact, quote = "the rate of tax under subsections (a), (b), (c), and (d) on taxable income not over the initial bracket amount shall be 10 percent, and")
rule TenPercentBracketIncome(p: Person, y: TaxableYear, ti: Money, initial: Money, s: FilingStatus) strict {
    label en official "section 1(i)(1)(A)(i): taxable income not over the initial bracket amount";
    effective [@2001-01-01, @2018-01-01);
    when filing_status(p, y, s);
    when s != EstateOrTrust;
    when taxable_income(p, y, ti);
    when initial_bracket_amount(s, y, initial);
    then ten_percent_bracket_income(p, y, min(ti, initial));
}
@source(IRC_S1_I, relation = formalizes, coverage = exact, quote = "the rate of tax under subsections (a), (b), (c), and (d) on taxable income not over the initial bracket amount shall be 10 percent, and")
rule TenPercentBracketTax(p: Person, y: TaxableYear, slice: Money) strict {
    label en official "section 1(i)(1)(A)(i): 10 percent";
    effective [@2001-01-01, @2018-01-01);
    when ten_percent_bracket_income(p, y, slice);
    then ten_percent_bracket_tax(p, y, slice * 0.10);
}
@source(IRC_S1_I, relation = formalizes, coverage = exact, quote = "the 15 percent rate of tax shall apply only to taxable income over the initial bracket amount but not over the maximum dollar amount for the 15-percent rate bracket.")
rule FifteenPercentBracketIncome(p: Person, y: TaxableYear, ti: Money, initial: Money, top: Money, s: FilingStatus) strict {
    label en official "section 1(i)(1)(A)(ii): the 15 percent rate applies only above the initial bracket amount, up to the maximum of the 15-percent bracket";
    effective [@2001-01-01, @2018-01-01);
    when filing_status(p, y, s);
    when s != EstateOrTrust;
    when taxable_income(p, y, ti);
    when initial_bracket_amount(s, y, initial);
    when max_dollar_amount_15_percent_bracket(p, y, top);
    when ti > initial;
    then fifteen_percent_bracket_income(p, y, min(ti, top) - initial);
}
@source(IRC_S1_I, relation = formalizes, coverage = exact, quote = "the 15 percent rate of tax shall apply only to taxable income over the initial bracket amount but not over the maximum dollar amount for the 15-percent rate bracket.")
rule FifteenPercentBracketTax(p: Person, y: TaxableYear, slice: Money) strict {
    label en official "section 1(i)(1)(A)(ii): 15 percent";
    effective [@2001-01-01, @2018-01-01);
    when fifteen_percent_bracket_income(p, y, slice);
    then fifteen_percent_bracket_tax(p, y, slice * 0.15);
}

// --- Section 1(i)(2): substitution of rates -------------------------------------

pub relation section_1i2_substituted_rate(rate: Decimal, substituted: Decimal) kind institutional {
    label en official "the rate that section 1(i)(2) substitutes in the tables of subsections (a)-(e) for the rate";
}
@source(IRC_S1_I, relation = formalizes, coverage = exact, quote = "(A) by substituting \"25%\" for \"28%\" each place it appears (before the application of subparagraph (B)),")
rule Substitute25For28() strict {
    label en official "section 1(i)(2)(A): 25 percent for 28 percent";
    effective [@2001-01-01, @2018-01-01);
    then section_1i2_substituted_rate(0.28, 0.25);
}
@source(IRC_S1_I, relation = formalizes, coverage = exact, quote = "(B) by substituting \"28%\" for \"31%\" each place it appears, and")
rule Substitute28For31() strict {
    label en official "section 1(i)(2)(B): 28 percent for 31 percent (applied after (A), so no 28 percent rate is substituted twice)";
    effective [@2001-01-01, @2018-01-01);
    then section_1i2_substituted_rate(0.31, 0.28);
}
@source(IRC_S1_I, relation = formalizes, coverage = exact, quote = "(C) by substituting \"33%\" for \"36%\" each place it appears.")
rule Substitute33For36() strict {
    label en official "section 1(i)(2)(C): 33 percent for 36 percent";
    effective [@2001-01-01, @2018-01-01);
    then section_1i2_substituted_rate(0.36, 0.33);
}

// --- Section 1(i)(3): the 35-percent bracket --------------------------------------

pub relation applicable_threshold_base(t: FilingStatus, amount: Money) kind institutional {
    label en official "the applicable threshold of section 1(i)(3)(B) before adjustment: $450,000 (a), $425,000 (b), $400,000 (c)";
}
relation applicable_threshold_adjusted(t: FilingStatus, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the subsection (a), (b) or (c) applicable threshold after the (C) adjustment (the basis of the one-half amount of (d))";
}
pub relation applicable_threshold(t: FilingStatus, y: TaxableYear, amount: Money) kind institutional {
    label en official "the applicable threshold for the table and the taxable year, after the section 1(i)(3)(C) adjustment for years after 2013 (2012 substituted for 2016); one half of the subsection (a) amount for subsection (d)";
}
@source(IRC_S1_I, relation = formalizes, coverage = exact, quote = "(i) $450,000 in the case of subsection (a),")
rule ApplicableThresholdBaseJoint() strict {
    label en official "section 1(i)(3)(B)(i)";
    effective [@2013-01-01, @2018-01-01);
    then applicable_threshold_base(Joint, 450000 USD);
}
@source(IRC_S1_I, relation = formalizes, coverage = exact, quote = "(ii) $425,000 in the case of subsection (b),")
rule ApplicableThresholdBaseHeadOfHousehold() strict {
    label en official "section 1(i)(3)(B)(ii)";
    effective [@2013-01-01, @2018-01-01);
    then applicable_threshold_base(HeadOfHousehold, 425000 USD);
}
@source(IRC_S1_I, relation = formalizes, coverage = exact, quote = "(iii) $400,000 in the case of subsection (c), and")
rule ApplicableThresholdBaseUnmarried() strict {
    label en official "section 1(i)(3)(B)(iii)";
    effective [@2013-01-01, @2018-01-01);
    then applicable_threshold_base(Unmarried, 400000 USD);
}
@source(IRC_S1_I, relation = formalizes, coverage = exact, quote = "each of the dollar amounts under clauses (i), (ii), and (iii) of subparagraph (B) shall be adjusted in the same manner as under paragraph (1)(C)(i), except that subsection (f)(3)(A)(ii) shall be applied by substituting \"2012\" for \"2016\".")
rule RequestApplicableThresholdAdjustment(t: FilingStatus, base: Money, y: TaxableYear, cy: Integer) strict {
    label en official "section 1(i)(3)(C): the thresholds are adjusted for taxable years beginning after 2013, 2012 substituted for 2016 (JUDGMENT CALL: the increase is rounded down to $50 as section 1(f)(7)(A) provides; the paragraph refers only to the determination of the adjustment in (1)(C)(i))";
    effective [@2013-01-01, @2018-01-01);
    when applicable_threshold_base(t, base);
    when us.irc.core::calendar_year_of(y, cy);
    when cy > 2013;
    then amount_to_index(base, 2012, y, 50);
}
@source(IRC_S1_I, relation = formalizes, coverage = exact, quote = "each of the dollar amounts under clauses (i), (ii), and (iii) of subparagraph (B) shall be adjusted in the same manner as under paragraph (1)(C)(i), except that subsection (f)(3)(A)(ii) shall be applied by substituting \"2012\" for \"2016\".")
rule ApplicableThresholdAdjusted(t: FilingStatus, base: Money, y: TaxableYear, adjusted: Money) strict {
    label en official "section 1(i)(3)(C): the adjusted threshold";
    effective [@2013-01-01, @2018-01-01);
    when applicable_threshold_base(t, base);
    when cola_adjusted_amount(base, 2012, y, 50, adjusted);
    then applicable_threshold_adjusted(t, y, adjusted);
}
rule ApplicableThresholdAdjustedFinal(t: FilingStatus, y: TaxableYear, adjusted: Money) strict {
    label en official "section 1(i)(3)(B)-(C): the applicable threshold of the tables (a), (b), (c)";
    effective [@2013-01-01, @2018-01-01);
    when applicable_threshold_adjusted(t, y, adjusted);
    then applicable_threshold(t, y, adjusted);
}
@source(IRC_S1_I, relation = formalizes, coverage = exact, quote = "In the case of taxable years beginning after December 31, 2012—")
rule ApplicableThresholdUnadjustedIn2013(t: FilingStatus, base: Money, y: TaxableYear, cy: Integer) strict {
    label en official "section 1(i)(3)(A)-(C): for a taxable year beginning in 2013 the thresholds are as enacted (the adjustment starts after 2013)";
    effective [@2013-01-01, @2018-01-01);
    when applicable_threshold_base(t, base);
    when us.irc.core::calendar_year_of(y, cy);
    when cy == 2013;
    then applicable_threshold_adjusted(t, y, base);
}
@source(IRC_S1_I, relation = formalizes, coverage = exact, quote = "(iv) ½ the amount applicable under clause (i) (after adjustment, if any, under subparagraph (C)) in the case of subsection (d).")
rule ApplicableThresholdSeparateHalf(y: TaxableYear, joint: Money) strict {
    label en official "section 1(i)(3)(B)(iv): one half of the subsection (a) amount for subsection (d)";
    effective [@2013-01-01, @2018-01-01);
    when applicable_threshold_adjusted(Joint, y, joint);
    then applicable_threshold(MarriedSeparate, y, joint * 0.5);
}

pub relation highest_bracket_begins_at(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the dollar amount at which the highest rate bracket of the table in force for the year begins";
}
pub relation income_in_35_percent_bracket(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the taxable income in the highest rate bracket taxed at 35 percent: not more than the applicable threshold less the dollar amount at which the bracket begins";
}
pub relation income_in_39_6_percent_bracket(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the taxable income in the highest rate bracket in excess of the amount to which the 35 percent rate applies";
}
@source(IRC_S1_I, relation = formalizes, coverage = exact, quote = "the rate of tax under subsections (a), (b), (c), and (d) on a taxpayer's taxable income in the highest rate bracket shall be 35 percent to the extent such income does not exceed an amount equal to the excess of—")
rule IncomeIn35PercentBracket(p: Person, y: TaxableYear, ti: Money, begins: Money, threshold: Money, s: FilingStatus) strict {
    label en official "section 1(i)(3)(A)(i): the income in the highest bracket, up to the applicable threshold minus the bracket's beginning, is taxed at 35 percent";
    effective [@2013-01-01, @2018-01-01);
    when filing_status(p, y, s);
    when s != EstateOrTrust;
    when taxable_income(p, y, ti);
    when highest_bracket_begins_at(p, y, begins);
    when applicable_threshold(s, y, threshold);
    when ti > begins;
    then income_in_35_percent_bracket(p, y, min(ti - begins, threshold - begins));
}
@source(IRC_S1_I, relation = formalizes, coverage = exact, quote = "the 39.6 percent rate of tax under such subsections shall apply only to the taxpayer's taxable income in such bracket in excess of the amount to which clause (i) applies.")
rule IncomeIn396PercentBracket(p: Person, y: TaxableYear, ti: Money, begins: Money, threshold: Money, s: FilingStatus) strict {
    label en official "section 1(i)(3)(A)(ii): the 39.6 percent rate applies only to the income above the amount taxed at 35 percent";
    effective [@2013-01-01, @2018-01-01);
    when filing_status(p, y, s);
    when s != EstateOrTrust;
    when taxable_income(p, y, ti);
    when highest_bracket_begins_at(p, y, begins);
    when applicable_threshold(s, y, threshold);
    when ti > threshold;
    then income_in_39_6_percent_bracket(p, y, ti - threshold);
}

// --- Section 1(i)(4): the Secretary adjusts the tables ---------------------------

const Section1iTablesMandate: RegulatoryMandate = entity_ref("urn:us:irc:income_individual:clir#Mandate1i4") {
    label en official "adjustment of the tables prescribed under subsection (f) to carry out section 1(i)";
}
assert provision_mandates_secretary_rules(Section1iTablesMandate);

@source(IRC_S1_I, relation = formalizes, coverage = exact, quote = "The Secretary shall adjust the tables prescribed under subsection (f) to carry out this subsection.")
rule SecretaryAdjustsTablesForSection1i defeasible {
    label en official "section 1(i)(4): the Secretary shall adjust the section 1(f) tables to carry out subsection (i) (open window)";
    for m: RegulatoryMandate;
    when provision_mandates_secretary_rules(m);
    when m == Section1iTablesMandate;
    then duty Section1iTablesDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition secretary_has_prescribed_rules(m);
            window [-infinity, infinity];
        }
    };
}
