// Section 56(b)(1)(B)(i)-(iii) (the classification of interest for the
// alternative minimum tax) and section 56(d)(1)(B)(i), (2) (the alternative
// tax net operating loss of a loss year) (stage 3, TECH_GAP reduction,
// 26.09.2026).
//
// INTEREST. Subsections (d) and (h) of section 163 apply, with three changes:
// qualified housing interest (section 56(e), `56-adjustments.law`) is not
// "personal interest" and not "investment interest", and interest on
// specified private activity bonds (and the deduction section 57(a)(5)(A)
// refers to) is treated as includible (deductible) for section 163(d). The
// classification of an item as personal or investment interest under section
// 163 is another owner's (`us.irc.deductions`) and enters as a fact; this module
// states what the AMT changes about it. The RECOMPUTATION of the section 163(d)
// limit on the adjusted net investment income (clause (iv)) is the gap G5503.
//
// LOSS YEAR. The alternative tax net operating loss of a loss year is the
// section 172(c) loss with the section 56 and 58 adjustments of that year, reduced
// by the section 57 preferences of that year, to the extent the preferences
// increased the loss. Each loss year is its own tuple (no recursion): the
// carryover ledger across years (absorption, section 172(b)(2)) is not derived
// (G5504); `atnol_attributable_to_ordinary_losses` of `56-adjustments.law`
// stays the typed input for the year of the deduction.

use self::{
    IRC_S56_B,
    IRC_S56_D,
    Indebtedness,
    Person,
    TaxableYear,
    amt_adjustments_total,
    amt_preferences_total,
    deduction_allowable_if_interest_includible,
    noncorporate_taxpayer_for_year,
    qualified_housing_interest_on,
    specified_pab_interest_total,
};

pub relation debt_interest_is_personal_interest_163h(d: Indebtedness, taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "the interest on the indebtedness is personal interest within section 163(h)(2) (before the section 163(h)(2)(D) exception for qualified residence interest)";
}
pub relation debt_interest_is_investment_interest_163d(d: Indebtedness, taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "the interest on the indebtedness is investment interest within section 163(d)(3)(A) (before the section 163(d)(3)(B)(i) exception)";
}
pub relation personal_interest_for_amt(d: Indebtedness, taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "the interest is personal interest for section 163(h) applied for the alternative minimum tax: qualified housing interest is not personal interest";
}
pub relation investment_interest_for_amt(d: Indebtedness, taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "the interest is investment interest for section 163(d) applied for the alternative minimum tax: qualified housing interest is not investment interest";
}

@source(IRC_S56_B, relation = formalizes, coverage = exact, quote = "in lieu of the exception under section 163(h)(2)(D), the term \"personal interest\" shall not include any qualified housing interest (as defined in subsection (e)),")
rule PersonalInterestForAmt(d: Indebtedness, taxpayer: Person, y: TaxableYear) strict {
    label en official "section 56(b)(1)(B)(i): personal interest excludes qualified housing interest (in lieu of the exception for qualified residence interest)";
    when noncorporate_taxpayer_for_year(taxpayer, y);
    when debt_interest_is_personal_interest_163h(d, taxpayer, y);
    when not_known(qualified_housing_interest_on(d, taxpayer, y));
    then personal_interest_for_amt(d, taxpayer, y);
}
@source(IRC_S56_B, relation = formalizes, coverage = exact, quote = "in lieu of the exception under section 163(d)(3)(B)(i), the term \"investment interest\" shall not include any qualified housing interest (as defined in subsection (e)), and")
rule InvestmentInterestForAmt(d: Indebtedness, taxpayer: Person, y: TaxableYear) strict {
    label en official "section 56(b)(1)(B)(iii): investment interest excludes qualified housing interest";
    when noncorporate_taxpayer_for_year(taxpayer, y);
    when debt_interest_is_investment_interest_163d(d, taxpayer, y);
    when not_known(qualified_housing_interest_on(d, taxpayer, y));
    then investment_interest_for_amt(d, taxpayer, y);
}

pub relation pab_interest_includible_for_163d(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "interest on specified private activity bonds, treated as includible in gross income for purposes of section 163(d)";
}
pub relation pab_related_deduction_for_163d(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the deduction referred to in section 57(a)(5)(A), treated as deductible for purposes of section 163(d)";
}
@source(IRC_S56_B, relation = formalizes, coverage = partial, quote = "interest on any specified private activity bond (and any amount treated as interest on a specified private activity bond under section 57(a)(5)(B)), and any deduction referred to in section 57(a)(5)(A), shall be treated as includible in gross income (or as deductible) for purposes of applying section 163(d),")
rule PabInterestIncludibleFor163d(p: Person, y: TaxableYear, interest: Money) strict {
    label en official "section 56(b)(1)(B)(ii): the specified private activity bond interest is includible for section 163(d) (the section 57(a)(5)(B) amounts treated as interest are not modelled)";
    when noncorporate_taxpayer_for_year(p, y);
    when specified_pab_interest_total(p, y, interest);
    then pab_interest_includible_for_163d(p, y, interest);
}
@source(IRC_S56_B, relation = formalizes, coverage = partial, quote = "interest on any specified private activity bond (and any amount treated as interest on a specified private activity bond under section 57(a)(5)(B)), and any deduction referred to in section 57(a)(5)(A), shall be treated as includible in gross income (or as deductible) for purposes of applying section 163(d),")
rule PabRelatedDeductionFor163d(p: Person, y: TaxableYear, deduction: Money) strict {
    label en official "section 56(b)(1)(B)(ii): the section 57(a)(5)(A) deduction is deductible for section 163(d)";
    when noncorporate_taxpayer_for_year(p, y);
    when deduction_allowable_if_interest_includible(p, y, deduction);
    then pab_related_deduction_for_163d(p, y, deduction);
}

// --- Section 56(d)(2): the loss year ------------------------------------------------

pub relation regular_net_operating_loss_of_loss_year(p: Person, ly: TaxableYear, amount: Money) kind empirical {
    label en official "the net operating loss of the loss year under section 172(c)";
}
pub relation loss_year_begins_on(ly: TaxableYear, d: Date) kind empirical {
    label en unofficial "the first day of the loss year (the same fact as `us.irc.core::begins`; kept apart so the loss-year rules need no calendar-year fact)";
}
pub relation atnol_carryable_to_first_post_1986_year(p: Person, ly: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of the net operating loss of a loss year beginning before January 1, 1987 which may be carried from the loss year to the first taxable year beginning after December 31, 1986";
}
pub relation atnol_of_loss_year(p: Person, ly: TaxableYear, amount: Money) kind institutional {
    label en official "the net operating loss of the loss year as adjusted for the alternative tax net operating loss deduction";
}

@source(IRC_S56_D, relation = formalizes, coverage = exact, quote = "In the case of a loss year beginning after December 31, 1986, the net operating loss for such year under section 172(c) shall—")
rule AtnolOfPost1986LossYear(p: Person, ly: TaxableYear, nol: Money, adjustments: Money, preferences: Money, start: Date) strict {
    label en official "section 56(d)(2)(A): the section 172(c) loss with the section 56 and 58 adjustments of the loss year, reduced by the section 57 preferences of that year, never below zero (JUDGMENT CALL: the preferences reduce the loss only to the extent of the loss, since an item cannot have increased the loss by more than the loss)";
    when regular_net_operating_loss_of_loss_year(p, ly, nol);
    when loss_year_begins_on(ly, start);
    when start > @1986-12-31;
    when amt_adjustments_total(p, ly, adjustments);
    when amt_preferences_total(p, ly, preferences);
    then atnol_of_loss_year(p, ly, max(0.00 USD, nol - adjustments - preferences));
}
@source(IRC_S56_D, relation = formalizes, coverage = exact, quote = "In the case of loss years beginning before January 1, 1987, the amount of the net operating loss which may be carried over to taxable years beginning after December 31, 1986, for purposes of paragraph (2), shall be equal to the amount which may be carried from the loss year to the first taxable year of the taxpayer beginning after December 31, 1986.")
rule AtnolOfPre1987LossYear(p: Person, ly: TaxableYear, start: Date, carry: Money) strict {
    label en official "section 56(d)(2)(B): a loss year beginning before 1987 contributes the amount carryable to the first taxable year beginning after 1986";
    when loss_year_begins_on(ly, start);
    when start < @1987-01-01;
    when atnol_carryable_to_first_post_1986_year(p, ly, carry);
    then atnol_of_loss_year(p, ly, carry);
}
