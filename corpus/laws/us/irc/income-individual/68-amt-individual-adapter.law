// The `Individual` view of the alternative minimum tax relations (stage 3,
// 26.09.2026): the bridge to `us.irc.credits`.
//
// PROBLEM. `us.irc.credits` (`26-limitation-on-credits.law`) declares its own
// `pub relation tentative_minimum_tax(taxpayer: Individual, y, amount)` and
// `section_55a_tax(taxpayer: Individual, ...)` as dependency contracts, while
// this package's producers are typed over `Person` (a taxpayer other than a
// corporation may be an estate or a trust as well as an individual). A package
// that imports both sees two relations of one name and one meaning with
// different argument types: LDC-W2101 "local semantics preserved", and
// neither side reads the other.
//
// SOLUTION FROM THIS SIDE (no file of `credits` is touched): the same amounts
// under DISTINCT names whose first argument is `Individual`. Each rule only
// narrows the argument type: `Individual` is a subtype of `Person`
// (`us.irc.core::persons.law`), so an individual's tentative minimum tax and
// tax of section 55(a) are exactly the `Person` figures of this package,
// nothing is recomputed. What `credits` has to change is recorded in
// docs/foundations/us-irc/DECISIONS.md (Д-13).

use self::{
    IRC_S55_A,
    IRC_S55_B,
    IRC_S55_C,
    IRC_S59_A,
    Individual,
    Person,
    TaxableYear,
    alternative_minimum_tax,
    pre_credit_tentative_minimum_tax,
    regular_tax_for_amt,
    tentative_minimum_tax,
};

pub relation tentative_minimum_tax_of_individual(i: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the tentative minimum tax (section 55(b)(1)) of an individual for the taxable year";
}
pub relation section_55a_tax_of_individual(i: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the tax imposed by section 55(a) (the excess of the tentative minimum tax over the regular tax) on an individual for the taxable year";
}
pub relation regular_tax_for_amt_of_individual(i: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the regular tax of an individual for the taxable year as section 55(c) defines it for the alternative minimum tax";
}
pub relation pre_credit_tentative_minimum_tax_of_individual(i: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the pre-credit tentative minimum tax (section 59(a)(2)) of an individual for the taxable year";
}

@source(IRC_S55_B, relation = formalizes, coverage = partial, quote = "The term \"alternative minimum taxable income\" means the taxable income of the taxpayer for the taxable year")
rule TentativeMinimumTaxOfIndividualRule(i: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 55(b)(1): the Person tentative minimum tax, read for an individual";
    when tentative_minimum_tax(i, y, amount);
    then tentative_minimum_tax_of_individual(i, y, amount);
}
@source(IRC_S55_A, relation = formalizes, coverage = partial, quote = "There is hereby imposed (in addition to any other tax imposed by this subtitle) a tax equal to the excess (if any) of—")
rule Section55aTaxOfIndividualRule(i: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 55(a): the Person alternative minimum tax, read for an individual";
    when alternative_minimum_tax(i, y, amount);
    then section_55a_tax_of_individual(i, y, amount);
}
@source(IRC_S55_C, relation = formalizes, coverage = partial, quote = "For purposes of this section, the term \"regular tax\" means the regular tax liability for the taxable year (as defined in section 26(b))")
rule RegularTaxForAmtOfIndividualRule(i: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 55(c): the Person regular tax, read for an individual";
    when regular_tax_for_amt(i, y, amount);
    then regular_tax_for_amt_of_individual(i, y, amount);
}
@source(IRC_S59_A, relation = formalizes, coverage = partial, quote = "the term \"pre-credit tentative minimum tax\" means the amount determined under the first sentence of section 55(b)(1)(A).")
rule PreCreditTentativeMinimumTaxOfIndividualRule(i: Individual, y: TaxableYear, amount: Money) strict {
    label en official "section 59(a)(2): the Person pre-credit tentative minimum tax, read for an individual";
    when pre_credit_tentative_minimum_tax(i, y, amount);
    then pre_credit_tentative_minimum_tax_of_individual(i, y, amount);
}
