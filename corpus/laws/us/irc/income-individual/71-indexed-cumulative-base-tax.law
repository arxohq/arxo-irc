rule TcjaBracketMarriedSeparate6() strict { then tcja_bracket_statutory(MarriedSeparate, 6, 200000 USD, 0.35); }

@source(IRC_S1_J)
rule TcjaBracketMarriedSeparate7() strict { then tcja_bracket_statutory(MarriedSeparate, 7, 300000 USD, 0.37); }

@source(IRC_S1_J, quote = "subsection (f)(7)(B) shall apply to any unmarried individual other than a surviving spouse or head of household")
rule TcjaRoundingStepMarriedSeparate() strict { then tcja_rounding_step(MarriedSeparate, 25); }

