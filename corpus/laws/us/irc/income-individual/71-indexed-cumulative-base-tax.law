// --- the request and the adjusted lower bounds (section 1(f)(2)(A), (3), (7); section 1(j)(3)(B)) ---

@source(IRC_S1_J, relation = formalizes, coverage = partial, quote = "For taxable years beginning after December 31, 2018, the Secretary shall prescribe tables which shall apply in lieu of the tables contained in paragraph (2)")
rule RequestIndexingOfTcjaBracketBound(s: FilingStatus, k: Integer, base: Money, r: Decimal, step: Integer, y: TaxableYear, cy: Integer) strict {
    label en official "each lower bound of bracket 2 and above is increased by the cost-of-living adjustment with 2017 substituted (section 1(j)(3)(B)(i))";
    when tcja_bracket_statutory(s, k, base, r);
    when k >= 2;
    when tcja_rounding_step(s, step);
    when us.irc.core::calendar_year_of(y, cy);
    when cy > 2018;
    when cy < 2026;
    then amount_to_index(base, 2017, y, step);
}
pub relation tcja_bracket_lower_indexed(s: FilingStatus, y: TaxableYear, k: Integer, lower: Money) kind institutional {
    label en official "the lower bound of bracket k of the table of section 1(j)(2) adjusted for the taxable year (section 1(j)(3)(B), (f)(2)(A)); bracket 1 begins at zero";
}
@source(IRC_S1_J, relation = formalizes, coverage = partial, quote = "For taxable years beginning after December 31, 2018, the Secretary shall prescribe tables which shall apply in lieu of the tables contained in paragraph (2)")
rule TcjaBracketLowerIndexed(s: FilingStatus, y: TaxableYear, k: Integer, base: Money, r: Decimal, step: Integer, adjusted: Money) strict {
    label en official "the adjusted lower bound by the code's own indexing mechanism";
    when tcja_bracket_statutory(s, k, base, r);
    when k >= 2;
    when tcja_rounding_step(s, step);
    when cola_adjusted_amount(base, 2017, y, step, adjusted);
    then tcja_bracket_lower_indexed(s, y, k, adjusted);
}
@source(IRC_S1_J, relation = formalizes, coverage = partial, quote = "For taxable years beginning after December 31, 2018, the Secretary shall prescribe tables which shall apply in lieu of the tables contained in paragraph (2)")
rule TcjaBracketOneLowerIndexed(s: FilingStatus, y: TaxableYear, r: Decimal, cy: Integer) strict {
    label en official "bracket 1 begins at zero";
    when tcja_bracket_statutory(s, 1, 0 USD, r);
    when us.irc.core::calendar_year_of(y, cy);
    when cy > 2018;
    when cy < 2026;
    then tcja_bracket_lower_indexed(s, y, 1, 0 USD);
}

// --- the cumulative tax at the adjusted lower bounds: an unrolled chain (section 1(f)(2)(B), (C)) ---

pub relation tcja_indexed_base_tax(s: FilingStatus, y: TaxableYear, k: Integer, tax: Money) kind institutional {
    label en official "the tax at the adjusted lower bound of bracket k: the sum over the brackets below of the rate times the width of the adjusted bracket (section 1(f)(2)(B), (C))";
}
relation indexed_base_tax_step_1(s: FilingStatus, y: TaxableYear) kind institutional;
@source(IRC_S1_F, relation = formalizes, coverage = partial, quote = "by adjusting the amounts setting forth the tax to the extent necessary to reflect the adjustments in the rate brackets.")
rule IndexedBaseTaxBracketOne(s: FilingStatus, y: TaxableYear, lower: Money) strict {
    label en official "the tax at the lower bound of bracket 1 is zero";
    when tcja_bracket_lower_indexed(s, y, 1, lower);
    then tcja_indexed_base_tax(s, y, 1, 0 USD);
}
relation indexed_base_tax_chain_2(s: FilingStatus, y: TaxableYear, tax: Money) kind institutional;
@source(IRC_S1_F, relation = formalizes, coverage = partial, quote = "by adjusting the amounts setting forth the tax to the extent necessary to reflect the adjustments in the rate brackets.")
rule IndexedBaseTaxChain2(s: FilingStatus, y: TaxableYear, l0: Money, l1: Money, b0: Money, r0: Decimal) strict {
    label en official "the cumulative tax at the adjusted lower bound of bracket 2: the tax at bracket 1 plus its rate times the width of the adjusted bracket 1";
    
    when tcja_bracket_lower_indexed(s, y, 1, l0);
    when tcja_bracket_lower_indexed(s, y, 2, l1);
    when tcja_bracket_statutory(s, 1, b0, r0);
    then indexed_base_tax_chain_2(s, y, round(r0 * (l1 - l0), 2, "HALF_UP"));
}
rule IndexedBaseTaxPublish2(s: FilingStatus, y: TaxableYear, tax: Money) strict {
    label en official "the cumulative tax at bracket 2, published";
    when indexed_base_tax_chain_2(s, y, tax);
    then tcja_indexed_base_tax(s, y, 2, tax);
}
relation indexed_base_tax_chain_3(s: FilingStatus, y: TaxableYear, tax: Money) kind institutional;
@source(IRC_S1_F, relation = formalizes, coverage = partial, quote = "by adjusting the amounts setting forth the tax to the extent necessary to reflect the adjustments in the rate brackets.")
rule IndexedBaseTaxChain3(s: FilingStatus, y: TaxableYear, prev: Money, l0: Money, l1: Money, b0: Money, r0: Decimal) strict {
    label en official "the cumulative tax at the adjusted lower bound of bracket 3: the tax at bracket 2 plus its rate times the width of the adjusted bracket 2";
    when indexed_base_tax_chain_2(s, y, prev);
    when tcja_bracket_lower_indexed(s, y, 2, l0);
    when tcja_bracket_lower_indexed(s, y, 3, l1);
    when tcja_bracket_statutory(s, 2, b0, r0);
    then indexed_base_tax_chain_3(s, y, prev + round(r0 * (l1 - l0), 2, "HALF_UP"));
}
rule IndexedBaseTaxPublish3(s: FilingStatus, y: TaxableYear, tax: Money) strict {
    label en official "the cumulative tax at bracket 3, published";
    when indexed_base_tax_chain_3(s, y, tax);
    then tcja_indexed_base_tax(s, y, 3, tax);
}
relation indexed_base_tax_chain_4(s: FilingStatus, y: TaxableYear, tax: Money) kind institutional;
@source(IRC_S1_F, relation = formalizes, coverage = partial, quote = "by adjusting the amounts setting forth the tax to the extent necessary to reflect the adjustments in the rate brackets.")
rule IndexedBaseTaxChain4(s: FilingStatus, y: TaxableYear, prev: Money, l0: Money, l1: Money, b0: Money, r0: Decimal) strict {
    label en official "the cumulative tax at the adjusted lower bound of bracket 4: the tax at bracket 3 plus its rate times the width of the adjusted bracket 3";
    when indexed_base_tax_chain_3(s, y, prev);
    when tcja_bracket_lower_indexed(s, y, 3, l0);
    when tcja_bracket_lower_indexed(s, y, 4, l1);
    when tcja_bracket_statutory(s, 3, b0, r0);
    then indexed_base_tax_chain_4(s, y, prev + round(r0 * (l1 - l0), 2, "HALF_UP"));
}
rule IndexedBaseTaxPublish4(s: FilingStatus, y: TaxableYear, tax: Money) strict {
    label en official "the cumulative tax at bracket 4, published";
    when indexed_base_tax_chain_4(s, y, tax);
    then tcja_indexed_base_tax(s, y, 4, tax);
}
relation indexed_base_tax_chain_5(s: FilingStatus, y: TaxableYear, tax: Money) kind institutional;
@source(IRC_S1_F, relation = formalizes, coverage = partial, quote = "by adjusting the amounts setting forth the tax to the extent necessary to reflect the adjustments in the rate brackets.")
rule IndexedBaseTaxChain5(s: FilingStatus, y: TaxableYear, prev: Money, l0: Money, l1: Money, b0: Money, r0: Decimal) strict {
    label en official "the cumulative tax at the adjusted lower bound of bracket 5: the tax at bracket 4 plus its rate times the width of the adjusted bracket 4";
    when indexed_base_tax_chain_4(s, y, prev);
    when tcja_bracket_lower_indexed(s, y, 4, l0);
    when tcja_bracket_lower_indexed(s, y, 5, l1);
    when tcja_bracket_statutory(s, 4, b0, r0);
    then indexed_base_tax_chain_5(s, y, prev + round(r0 * (l1 - l0), 2, "HALF_UP"));
}
rule IndexedBaseTaxPublish5(s: FilingStatus, y: TaxableYear, tax: Money) strict {
    label en official "the cumulative tax at bracket 5, published";
    when indexed_base_tax_chain_5(s, y, tax);
    then tcja_indexed_base_tax(s, y, 5, tax);
}
relation indexed_base_tax_chain_6(s: FilingStatus, y: TaxableYear, tax: Money) kind institutional;
@source(IRC_S1_F, relation = formalizes, coverage = partial, quote = "by adjusting the amounts setting forth the tax to the extent necessary to reflect the adjustments in the rate brackets.")
rule IndexedBaseTaxChain6(s: FilingStatus, y: TaxableYear, prev: Money, l0: Money, l1: Money, b0: Money, r0: Decimal) strict {
    label en official "the cumulative tax at the adjusted lower bound of bracket 6: the tax at bracket 5 plus its rate times the width of the adjusted bracket 5";
    when indexed_base_tax_chain_5(s, y, prev);
    when tcja_bracket_lower_indexed(s, y, 5, l0);
    when tcja_bracket_lower_indexed(s, y, 6, l1);
    when tcja_bracket_statutory(s, 5, b0, r0);
    then indexed_base_tax_chain_6(s, y, prev + round(r0 * (l1 - l0), 2, "HALF_UP"));
}
rule IndexedBaseTaxPublish6(s: FilingStatus, y: TaxableYear, tax: Money) strict {
    label en official "the cumulative tax at bracket 6, published";
    when indexed_base_tax_chain_6(s, y, tax);
    then tcja_indexed_base_tax(s, y, 6, tax);
}
relation indexed_base_tax_chain_7(s: FilingStatus, y: TaxableYear, tax: Money) kind institutional;
@source(IRC_S1_F, relation = formalizes, coverage = partial, quote = "by adjusting the amounts setting forth the tax to the extent necessary to reflect the adjustments in the rate brackets.")
rule IndexedBaseTaxChain7(s: FilingStatus, y: TaxableYear, prev: Money, l0: Money, l1: Money, b0: Money, r0: Decimal) strict {
    label en official "the cumulative tax at the adjusted lower bound of bracket 7: the tax at bracket 6 plus its rate times the width of the adjusted bracket 6";
    when indexed_base_tax_chain_6(s, y, prev);
    when tcja_bracket_lower_indexed(s, y, 6, l0);
    when tcja_bracket_lower_indexed(s, y, 7, l1);
    when tcja_bracket_statutory(s, 6, b0, r0);
    then indexed_base_tax_chain_7(s, y, prev + round(r0 * (l1 - l0), 2, "HALF_UP"));
}
rule IndexedBaseTaxPublish7(s: FilingStatus, y: TaxableYear, tax: Money) strict {
    label en official "the cumulative tax at bracket 7, published";
    when indexed_base_tax_chain_7(s, y, tax);
    then tcja_indexed_base_tax(s, y, 7, tax);
}

// --- the tax at an income under the adjusted table ---

pub relation tax_under_section_1_indexed_tcja(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the tax of section 1(j)(2) at the taxable income of the person under the table adjusted by section 1(j)(3)(B) (taxable years beginning after 2018 and before 2026); an OUTPUT, not read by tax_under_section_1";
}
@source(IRC_S1_J, relation = formalizes, coverage = partial, quote = "For taxable years beginning after December 31, 2018, the Secretary shall prescribe tables which shall apply in lieu of the tables contained in paragraph (2)")
rule TaxUnderSection1IndexedTcja(p: Person, y: TaxableYear, s: FilingStatus, income: Money, cy: Integer, kk: Integer, lower: Money, base_tax: Money, rate: Decimal, b0: Money) strict {
    label en official "the cumulative tax of the bracket of the income plus the rate of the bracket times the excess over its adjusted lower bound";
    when filing_status(p, y, s);
    when taxable_income(p, y, income);
    when us.irc.core::calendar_year_of(y, cy);
    when cy > 2018;
    when cy < 2026;
    when kk == 1 + count(collect k2: Integer, l2: Money where tcja_bracket_lower_indexed(s, y, k2, l2) and k2 >= 2 and l2 < income);
    when tcja_bracket_lower_indexed(s, y, kk, lower);
    when tcja_indexed_base_tax(s, y, kk, base_tax);
    when tcja_bracket_statutory(s, kk, b0, rate);
    then tax_under_section_1_indexed_tcja(p, y, base_tax + round(rate * (income - lower), 2, "HALF_UP"));
}
