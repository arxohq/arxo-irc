@source(IRC_S1_J, quote = "subsection (f)(7)(B) shall apply to any unmarried individual other than a surviving spouse or head of household")
rule TcjaRoundingStepUnmarried() strict { then tcja_rounding_step(Unmarried, 25); }

@source(IRC_S1_J)
rule TcjaBracketMarriedSeparate1() strict { then tcja_bracket_statutory(MarriedSeparate, 1, 0 USD, 0.10); }

@source(IRC_S1_J)
rule TcjaBracketMarriedSeparate2() strict { then tcja_bracket_statutory(MarriedSeparate, 2, 9525 USD, 0.12); }

