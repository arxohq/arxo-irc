// Final TECH_GAP pass (26.09.2026, DECISION-0379): section 1(f)(2)(C), G6707 — the amounts setting forth the tax, adjusted
// to reflect the adjustment of the rate brackets, for the TCJA tables of section 1(j)(2) in the years the pinned text
// of section 1(j)(3)(B) governs (taxable years beginning after 2018 and before 2026).
//
// TECHNIQUE. The tables of `rates.law` answer only for an income (`bracket_tcja_*`), so the boundaries cannot be read from
// them by enumeration. The lower bounds and rates of the brackets of the five tables are therefore restated here as
// ordinal facts (`tcja_bracket_statutory`, from the pinned tables T6-T10 of section 1(j)(2); the scenarios check the
// restatement against the tables). Each lower bound of bracket 2..n is requested for indexing by the code's own mechanism
// (`amount_to_index`, base year 2017 by section 1(j)(3)(B)(i), the step of $50 or, for an unmarried individual and a
// married individual filing a separate return, $25 by section 1(j)(3)(B)(ii)); the cumulative tax at the adjusted lower
// bound of bracket k is the sum over the brackets below of the rate times the width of the adjusted bracket
// (section 1(f)(2)(B): the rates do not change; (C): the tax amounts follow the brackets), as an unrolled chain
// of predicates (bracket 2..7; a predicate cannot feed itself across steps, LDC-E4102). The tax at an income is the
// cumulative tax of its bracket plus the rate of the bracket times the excess over the adjusted lower bound; the bracket
// number is 1 plus the number of adjusted lower bounds (of brackets 2..n) strictly below the income (an income equal
// to a bound belongs to the lower bracket, as in the tables, the tax being the same).
//
// BOUNDS (stated in the coverage row). (1) Taxable years beginning after 2018 and before 2026 only: from 2026 the
// text of section 1(j)(3)(B)(i) as amended by Pub. L. 119-21 section 70101(b) substitutes different base years for
// different brackets, and the pre-2018 tables of (a)-(e) are altered by the rate changes of 2001-2017 (modules 15, 64)
// and would need the tables of those years. (2) The result is an OUTPUT relation `tax_under_section_1_indexed_tcja`; it
// is NOT wired into `tax_under_section_1`, which keeps reading the unindexed 2018 table when the index inputs (the
// C-CPI-U and CPI monthly values of module 60) are not supplied (JUDGMENT CALL: the strict rules `TaxUnderTable*` are
// not overridden). (3) The index values are case facts (module 60): none is pinned.

language "law.core" version "0.2";
package us.irc.income_individual version "0.1.1";
namespace "urn:us:irc:income_individual:clir";

use self::{
    FilingStatus,
    IRC_S1_F,
    IRC_S1_J,
    Person,
    TaxableYear,
    amount_to_index,
    cola_adjusted_amount,
    filing_status,
    taxable_income,
};

pub relation tcja_bracket_statutory(s: FilingStatus, k: Integer, lower: Money, rate: Decimal) kind institutional {
    label en official "the lower bound and the rate of bracket k of the table of section 1(j)(2) for the status, unadjusted (2018); restated from the tables";
}
pub relation tcja_rounding_step(s: FilingStatus, step: Integer) kind institutional {
    label en official "the multiple to which the increase is rounded down: $25 for an unmarried individual and a married individual filing a separate return (section 1(j)(3)(B)(ii), (f)(7)(B)), else $50 (section 1(f)(7)(A))";
}

@source(IRC_S1_J)
rule TcjaBracketJoint1() strict { then tcja_bracket_statutory(Joint, 1, 0 USD, 0.10); }

@source(IRC_S1_J)
rule TcjaBracketJoint2() strict { then tcja_bracket_statutory(Joint, 2, 19050 USD, 0.12); }

@source(IRC_S1_J)
rule TcjaBracketJoint3() strict { then tcja_bracket_statutory(Joint, 3, 77400 USD, 0.22); }

@source(IRC_S1_J)
rule TcjaBracketJoint4() strict { then tcja_bracket_statutory(Joint, 4, 165000 USD, 0.24); }

@source(IRC_S1_J)
rule TcjaBracketJoint5() strict { then tcja_bracket_statutory(Joint, 5, 315000 USD, 0.32); }

@source(IRC_S1_J)
rule TcjaBracketJoint6() strict { then tcja_bracket_statutory(Joint, 6, 400000 USD, 0.35); }

@source(IRC_S1_J)
rule TcjaBracketJoint7() strict { then tcja_bracket_statutory(Joint, 7, 600000 USD, 0.37); }

@source(IRC_S1_J, quote = "subsection (f)(7)(B) shall apply to any unmarried individual other than a surviving spouse or head of household")
rule TcjaRoundingStepJoint() strict { then tcja_rounding_step(Joint, 50); }

