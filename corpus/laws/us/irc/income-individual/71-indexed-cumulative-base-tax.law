@source(IRC_S1_J)
rule TcjaBracketUnmarried1() strict { then tcja_bracket_statutory(Unmarried, 1, 0 USD, 0.10); }

@source(IRC_S1_J)
rule TcjaBracketUnmarried2() strict { then tcja_bracket_statutory(Unmarried, 2, 9525 USD, 0.12); }

@source(IRC_S1_J)
rule TcjaBracketUnmarried3() strict { then tcja_bracket_statutory(Unmarried, 3, 38700 USD, 0.22); }

@source(IRC_S1_J)
rule TcjaBracketUnmarried4() strict { then tcja_bracket_statutory(Unmarried, 4, 82500 USD, 0.24); }

@source(IRC_S1_J)
rule TcjaBracketUnmarried5() strict { then tcja_bracket_statutory(Unmarried, 5, 157500 USD, 0.32); }

@source(IRC_S1_J)
rule TcjaBracketUnmarried6() strict { then tcja_bracket_statutory(Unmarried, 6, 200000 USD, 0.35); }

@source(IRC_S1_J)
