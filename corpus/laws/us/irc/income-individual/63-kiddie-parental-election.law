// Section 1(g)(6)-(7): the parent's TIN duties and the election to claim a
// child's interest and dividends on the parent's return, and section 3(a)(3):
// the Secretary's power to extend the tax tables to itemizers (stage 3,
// TECH_GAP reduction, 26.09.2026).
//
// THE ELECTION (g)(7) is a `power` of the parent identified by (g)(5)
// (`kiddie_tax_parent`). `valid_when` is one atom, the derived helper
// `g7_election_conditions_met` (clauses (A)(i)-(iii)); the valid exercise is
// also materialized as the computational twin `g7_election_made` (E-0134: the
// effect of a power is invisible to `not_known` readers and defeasible
// rules, so later computations read the twin).
//
// NOT DERIVED HERE (kept as a typed contract, coverage row TECH_GAP): clause
// (B)(ii)(I), "the amount determined under this section after the
// application of clause (i)", is the tax on the parent's taxable income
// increased by the child's included income, a second evaluation of the rate
// schedule on a hypothetical base (same class as TECH-GAPS G1501); it enters
// as `parent_tax_after_child_income_inclusion`.

use self::{
    AmtPreferenceKind,
    IRC_S1_G,
    IRC_S3_A,
    Individual,
    Person,
    RegulatoryMandate,
    TaxableYear,
    amt_preference,
    ceiling_amount,
    kiddie_tax_applies,
    kiddie_tax_parent,
    pab_preference_before_reassignment,
    provision_mandates_secretary_rules,
    secretary_has_prescribed_rules,
    section_63c5a_amount,
    table_tax_amount,
    tax_under_section_1_via_table,
    taxable_at_most,
    taxable_income,
};

pub relation child_gross_income(child: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the gross income of the child for the taxable year";
}
pub relation child_gross_income_only_interest_and_dividends(child: Person, y: TaxableYear) kind empirical {
    label en official "the child has gross income for the taxable year only from interest and dividends (including Alaska Permanent Fund dividends)";
}
pub relation estimated_tax_paid_in_childs_name(child: Person, y: TaxableYear) kind empirical {
    label en official "estimated tax payments for the year are made in the name and TIN of the child";
}
pub relation section_3406_withholding_on_child(child: Person, y: TaxableYear) kind empirical {
    label en official "an amount has been deducted and withheld under section 3406 with respect to the child for the year";
}
pub relation parent_elects_g7(parent: Individual, child: Person, y: TaxableYear) kind empirical {
    label en official "the parent of the child elects the application of subparagraph (B) (the exercise)";
}
pub relation g7_election_conditions_met(parent: Individual, child: Person, y: TaxableYear) kind institutional {
    label en official "the conditions of section 1(g)(7)(A)(i)-(iii) hold for the child and the parent is the parent determined under paragraph (5)";
}
pub relation g7_election_in_effect(parent: Individual, child: Person, y: TaxableYear) kind institutional {
    label en official "the election under section 1(g)(7) applies to the child for the taxable year (the effect of the power)";
}
pub relation g7_election_made(parent: Individual, child: Person, y: TaxableYear) kind institutional {
    label en official "a valid election under section 1(g)(7) was made for the child and year (computational twin of the power's effect)";
}
pub relation g7_election_covers_child(child: Person, y: TaxableYear) kind institutional {
    label en unofficial "some parent has validly elected under section 1(g)(7) for this child and year";
}

@source(IRC_S1_G, relation = formalizes, coverage = exact, quote = "such gross income is more than the amount described in paragraph (4)(A)(ii)(I) and less than 10 times the amount so described,")
rule G7ConditionsMet(parent: Individual, child: Person, y: TaxableYear, gross: Money, floor: Money) strict {
    label en official "section 1(g)(7)(A)(i)-(iii): the child to whom (g) applies has gross income only from interest and dividends, more than the section 63(c)(5)(A) amount and less than 10 times it, and no estimated tax is paid in the child's name and no section 3406 amount is withheld";
    when kiddie_tax_applies(child, y);
    when kiddie_tax_parent(child, y, parent);
    when child_gross_income_only_interest_and_dividends(child, y);
    when child_gross_income(child, y, gross);
    when section_63c5a_amount(y, floor);
    when gross > floor;
    when gross < floor * 10;
    when not_known(estimated_tax_paid_in_childs_name(child, y));
    when not_known(section_3406_withholding_on_child(child, y));
    then g7_election_conditions_met(parent, child, y);
}

@source(IRC_S1_G, relation = formalizes, coverage = exact, quote = "the parent of such child (as determined under paragraph (5)) elects the application of subparagraph (B),")
rule ParentMayElectToClaimChildIncome defeasible {
    label en official "section 1(g)(7)(A): the parent determined under paragraph (5) may elect to claim the child's interest and dividends on the parent's return";
    for parent: Individual;
    for child: Person;
    for y: TaxableYear;
    when kiddie_tax_parent(child, y, parent);
    then power ElectToClaimChildIncomeOnParentReturn {
        holder parent; over child;
        exercise parent_elects_g7(parent, child, y);
        valid_when g7_election_conditions_met(parent, child, y);
        effect create(g7_election_in_effect(parent, child, y));
        window [-infinity, infinity];
    };
}

@source(IRC_S1_G, relation = formalizes, coverage = exact, quote = "the parent of such child (as determined under paragraph (5)) elects the application of subparagraph (B),")
rule G7ElectionMade(parent: Individual, child: Person, y: TaxableYear) strict {
    label en official "section 1(g)(7)(A): an election made when the conditions hold is a valid election (computational twin of the power's effect)";
    when parent_elects_g7(parent, child, y);
    when g7_election_conditions_met(parent, child, y);
    then g7_election_made(parent, child, y);
}
rule G7ElectionCoversChild(parent: Individual, child: Person, y: TaxableYear) strict {
    label en unofficial "a valid election for the child, whichever parent made it";
    when g7_election_made(parent, child, y);
    then g7_election_covers_child(child, y);
}

// The effect on the child: no gross income (other than for this paragraph)
// and no return required under section 6012.
pub relation child_treated_as_having_no_gross_income(child: Person, y: TaxableYear) kind institutional {
    label en official "the child is treated (other than for purposes of paragraph (7)) as having no gross income for the year";
}
pub relation child_not_required_to_file_return_6012(child: Person, y: TaxableYear) kind institutional {
    label en official "the child is not required to file a return under section 6012 for the year";
}
@source(IRC_S1_G, relation = formalizes, coverage = exact, quote = "such child shall be treated (other than for purposes of this paragraph) as having no gross income for such year and shall not be required to file a return under section 6012.")
rule ElectionChildHasNoGrossIncome(parent: Individual, child: Person, y: TaxableYear) strict {
    label en official "section 1(g)(7)(A): the child is treated as having no gross income";
    when g7_election_made(parent, child, y);
    then child_treated_as_having_no_gross_income(child, y);
}
@source(IRC_S1_G, relation = formalizes, coverage = exact, quote = "such child shall be treated (other than for purposes of this paragraph) as having no gross income for such year and shall not be required to file a return under section 6012.")
rule ElectionChildNeedNotFile(parent: Individual, child: Person, y: TaxableYear) strict {
    label en official "section 1(g)(7)(A): the child is not required to file a return under section 6012";
    when g7_election_made(parent, child, y);
    then child_not_required_to_file_return_6012(child, y);
}

// --- Section 1(g)(7)(B): income included on the parent's return -------------------

pub relation parent_gross_income_inclusion_from_child(parent: Individual, child: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the gross income of the child that is included in the parent's gross income (the excess over twice the section 63(c)(5)(A) amount)";
}
pub relation election_addition_to_parent_tax(parent: Individual, child: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "10 percent of the lesser of the section 63(c)(5)(A) amount or the excess of the child's gross income over it (section 1(g)(7)(B)(ii)(II))";
}
pub relation parent_tax_after_child_income_inclusion(parent: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount determined under this section after the application of clause (i), i.e. the tax on the parent's taxable income increased by the child income included (a hypothetical re-evaluation of the rate schedule, supplied by the case)";
}
pub relation parent_tax_under_g7_election(parent: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the tax imposed by this section on the parent for a year in which the parent makes the election: the tax after the inclusion plus 10 percent additions of each electing child";
}

@source(IRC_S1_G, relation = formalizes, coverage = exact, quote = "(to the extent the gross income of such child exceeds twice the amount described in paragraph (4)(A)(ii)(I)) shall be included in such parent's gross income for the taxable year")
rule ParentIncludesChildGrossIncomeExcess(parent: Individual, child: Person, y: TaxableYear, gross: Money, floor: Money) strict {
    label en official "section 1(g)(7)(B)(i): the gross income of the child above twice the section 63(c)(5)(A) amount is included in the parent's gross income";
    when g7_election_made(parent, child, y);
    when child_gross_income(child, y, gross);
    when section_63c5a_amount(y, floor);
    when gross > floor * 2;
    then parent_gross_income_inclusion_from_child(parent, child, y, gross - floor * 2);
}
@source(IRC_S1_G, relation = formalizes, coverage = exact, quote = "(to the extent the gross income of such child exceeds twice the amount described in paragraph (4)(A)(ii)(I)) shall be included in such parent's gross income for the taxable year")
rule ParentIncludesNothingWhenNoExcess(parent: Individual, child: Person, y: TaxableYear, gross: Money, floor: Money) strict {
    label en official "section 1(g)(7)(B)(i): a child whose gross income does not exceed twice the amount adds nothing to the parent's gross income";
    when g7_election_made(parent, child, y);
    when child_gross_income(child, y, gross);
    when section_63c5a_amount(y, floor);
    when gross <= floor * 2;
    then parent_gross_income_inclusion_from_child(parent, child, y, 0 USD);
}

@source(IRC_S1_G, relation = formalizes, coverage = exact, quote = "for each such child, 10 percent of the lesser of the amount described in paragraph (4)(A)(ii)(I) or the excess of the gross income of such child over the amount so described, and")
rule ElectionAdditionPerChild(parent: Individual, child: Person, y: TaxableYear, gross: Money, floor: Money) strict {
    label en official "section 1(g)(7)(B)(ii)(II): 10 percent of the lesser of the amount or the excess of the child's gross income over it";
    when g7_election_made(parent, child, y);
    when child_gross_income(child, y, gross);
    when section_63c5a_amount(y, floor);
    when gross > floor;
    then election_addition_to_parent_tax(parent, child, y, min(floor, gross - floor) * 0.10);
}

relation has_electing_child(parent: Individual, y: TaxableYear) kind institutional {
    label en unofficial "the parent has at least one child for whom a valid election is made for the year";
}
rule HasElectingChild(parent: Individual, child: Person, y: TaxableYear) strict {
    when g7_election_made(parent, child, y);
    then has_electing_child(parent, y);
}
@source(IRC_S1_G, relation = formalizes, coverage = exact, quote = "the tax imposed by this section for such year with respect to such parent shall be the amount equal to the sum of—")
rule ParentTaxUnderElection(parent: Individual, y: TaxableYear, base: Money) strict {
    label en official "section 1(g)(7)(B)(ii): the parent's tax is the tax after the inclusion (I) plus the addition of each electing child (II)";
    when has_electing_child(parent, y);
    when parent_tax_after_child_income_inclusion(parent, y, base);
    then parent_tax_under_g7_election(parent, y, base + sum all amount: Money for child: Person where election_addition_to_parent_tax(parent, child, y, amount));
}

// (B)(iii): the interest that is a section 57(a)(5) preference of the child is a
// preference of the parent, and not of the child. The child's own preference
// (57-preferences.law, gated by `g7_election_covers_child`) is replaced by the
// kind below on the parent.
@source(IRC_S1_G, relation = formalizes, coverage = exact, quote = "any interest which is an item of tax preference under section 57(a)(5) of the child shall be treated as an item of tax preference of such parent (and not of such child).")
rule PabInterestOfChildIsPreferenceOfParent(parent: Individual, y: TaxableYear) strict {
    label en official "section 1(g)(7)(B)(iii): the parent has the child's section 57(a)(5) preference (summed over the children whose election is made)";
    when has_electing_child(parent, y);
    then amt_preference(parent, y, ChildInterestUnderElection57a5, sum all amount: Money for child: Person where g7_election_made(parent, child, y) and pab_preference_before_reassignment(child, y, amount));
}

// --- Section 1(g)(6): the parent's TIN ------------------------------------------

pub relation parent_provides_tin_to_child(parent: Individual, child: Person, y: TaxableYear) kind empirical {
    label en official "the parent has provided the parent's TIN to the child";
}
pub relation child_return_includes_parents_tin(child: Person, y: TaxableYear) kind empirical {
    label en official "the child has included the parent's TIN on the child's return of tax imposed by this section";
}

@source(IRC_S1_G, relation = formalizes, coverage = exact, quote = "The parent of any child to whom this subsection applies for any taxable year shall provide the TIN of such parent to such child")
rule ParentMustProvideTinToChild defeasible {
    label en official "section 1(g)(6): the parent shall provide the parent's TIN to the child (no time is stated: an achievement goal over an open window)";
    for parent: Individual;
    for child: Person;
    for y: TaxableYear;
    when kiddie_tax_applies(child, y);
    when kiddie_tax_parent(child, y, parent);
    then duty ProvideTinToChildDuty {
        bearer parent;
        beneficiary child;
        goal achievement {
            condition parent_provides_tin_to_child(parent, child, y);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S1_G, relation = formalizes, coverage = exact, quote = "and such child shall include such TIN on the child's return of tax imposed by this section for such taxable year.")
rule ChildMustIncludeParentTin defeasible {
    label en official "section 1(g)(6): the child shall include the parent's TIN on the child's return (open window: the text names the return of the year)";
    for child: Person;
    for y: TaxableYear;
    when kiddie_tax_applies(child, y);
    then duty IncludeParentTinOnReturnDuty {
        bearer child;
        goal achievement {
            condition child_return_includes_parents_tin(child, y);
            window [-infinity, infinity];
        }
    };
}

const G7RegulationsMandate: RegulatoryMandate = entity_ref("urn:us:irc:income_individual:clir#Mandate1g7C") {
    label en official "such regulations as may be necessary or appropriate to carry out the purposes of the section 1(g)(7) election";
}
assert provision_mandates_secretary_rules(G7RegulationsMandate);

@source(IRC_S1_G, relation = formalizes, coverage = exact, quote = "The Secretary shall prescribe such regulations as may be necessary or appropriate to carry out the purposes of this paragraph.")
rule SecretaryPrescribesG7Regulations defeasible {
    label en official "section 1(g)(7)(C): the Secretary shall prescribe regulations to carry out the election paragraph (open window)";
    for m: RegulatoryMandate;
    when provision_mandates_secretary_rules(m);
    when m == G7RegulationsMandate;
    then duty G7RegulationsDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition secretary_has_prescribed_rules(m);
            window [-infinity, infinity];
        }
    };
}

// --- Section 3(a)(3): tables for taxpayers who itemize -------------------------

pub relation tables_for_itemizers_on_taxable_income_basis(y: TaxableYear) kind empirical {
    label en official "the tables prescribed for individuals who itemize their deductions are on the basis of taxable income";
}
pub relation secretary_extends_tables_to_itemizers(y: TaxableYear) kind empirical {
    label en official "the Secretary provides that section 3 applies also for the taxable year to individuals who itemize their deductions (the exercise)";
}
pub relation tables_extended_to_itemizers_in_effect(y: TaxableYear) kind institutional {
    label en official "section 3 applies for the taxable year also to individuals who itemize (the effect of the power)";
}
pub relation tables_extended_to_itemizers_for_year(y: TaxableYear) kind institutional {
    label en official "a valid extension of section 3 to itemizers for the taxable year (computational twin of the power's effect)";
}

@source(IRC_S3_A, relation = formalizes, coverage = exact, quote = "The Secretary may provide that this section shall apply also for any taxable year to individuals who itemize their deductions.")
rule SecretaryMayExtendTablesToItemizers defeasible {
    label en official "section 3(a)(3): the Secretary may provide that the tables apply also to individuals who itemize; the tables shall be on the basis of taxable income";
    for y: TaxableYear;
    when us.irc.core::calendar_year_of(y, _);
    then power ExtendTaxTablesToItemizers {
        holder us.irc.core::Secretary; over y;
        exercise secretary_extends_tables_to_itemizers(y);
        valid_when tables_for_itemizers_on_taxable_income_basis(y);
        effect create(tables_extended_to_itemizers_in_effect(y));
        window [-infinity, infinity];
    };
}
@source(IRC_S3_A, relation = formalizes, coverage = exact, quote = "Any tables prescribed under the preceding sentence shall be on the basis of taxable income.")
rule TablesExtendedToItemizersForYear(y: TaxableYear) strict {
    label en official "section 3(a)(3): an extension whose tables are on the basis of taxable income is valid";
    when secretary_extends_tables_to_itemizers(y);
    when tables_for_itemizers_on_taxable_income_basis(y);
    then tables_extended_to_itemizers_for_year(y);
}
@source(IRC_S3_A, relation = formalizes, coverage = exact, quote = "The Secretary may provide that this section shall apply also for any taxable year to individuals who itemize their deductions.")
rule TableTaxAppliesToItemizersUnderExtension(p: Person, y: TaxableYear, taxable: Money, ceiling: Money) strict {
    label en official "section 3(a)(3) with (a)(1)(B): where the Secretary has extended the tables, an itemizer whose taxable income does not exceed the ceiling amount has the table tax";
    when tables_extended_to_itemizers_for_year(y);
    when taxable_income(p, y, taxable);
    when ceiling_amount(y, ceiling);
    when taxable_at_most(taxable, ceiling);
    when table_tax_amount(p, y, taxable);
    then tax_under_section_1_via_table(p, y, taxable);
}
