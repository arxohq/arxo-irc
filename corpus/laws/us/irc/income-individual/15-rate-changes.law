// Section 15: effect of changes in the rates of tax imposed by chapter 1
// (stage 2). The mechanism is a day-weighted proration: when a rate changes
// inside a taxable year, two "tentative taxes" are computed on the WHOLE
// year's taxable income (one at the pre-change rate, one at the post-change
// rate) and the tax is the sum of each tentative tax times the share of the
// year's days its period covers.
//
// SCOPE. Modelled: (a) the proration itself, (b) repeal as a change to a zero
// rate, (c) the effective-date reading of "beginning after"/"ending after"/
// "beginning on or after", (d) and (f) the two exclusions (rate changes made
// by section 1(f) inflation adjustments and by section 1(i) rate reductions
// after 2000), (e) the weighted-average highest rate.
//
// The two tentative taxes themselves are DEPENDENCY CONTRACTS
// (`tentative_tax_before_change` / `tentative_tax_after_change`): the rate
// tables of sections 1 and 11 are owned by `rates.law` here (section 1) and by
// `us.irc.corporations` (section 11); which enacted change is a "change of
// rate" is a fact about the enacting Public Law the case supplies. Nothing in
// this module invents a rate or a date.
//
// ROUNDING. Section 15 prescribes no rounding; the day-weighted sum is one
// division carried to 10 decimal places (`div_round`), so the result is exact
// to that precision and no cents-rounding is applied here (whole-dollar
// rounding on the return is the norm of section 6102, owned elsewhere).
//
// TIME. "The number of days in the entire taxable year" is counted as
// `days_between(first day, last day) + 1` (both end dates belong to the
// year); the pre-change period is `days_between(first day, effective date)`
// (the effective date itself belongs to the later period, "on and after such
// date").

// --- The change and how the enacting text dates it ----------------------------

use self::{
    IRC_S15_A,
    IRC_S15_B,
    IRC_S15_C,
    IRC_S15_E,
    Person,
    TaxableYear,
};

pub entity RateChange {
    label en unofficial "an enacted change (or repeal) of a rate of tax imposed by chapter 1";
}

pub enum RateChangeSource {
    Ordinary;
    InflationAdjustmentSection1f;
    RateReductionSection1i;
    label en unofficial "which provision made the change of rate: an ordinary enactment, a section 1(f) inflation adjustment (section 15(d)) or a section 1(i) rate reduction after 2000 (section 15(f))";
}

pub relation rate_change_source(chg: RateChange, s: RateChangeSource) kind empirical {
    label en unofficial "the provision that made this change of rate";
}
pub relation tax_repealed_by_change(chg: RateChange) kind empirical {
    label en unofficial "the change is the repeal of a tax";
}
pub relation rate_change_stated_beginning_after(chg: RateChange, d: Date) kind empirical {
    label en official "the rate changes for taxable years \"beginning after\" a certain date";
}
pub relation rate_change_stated_ending_after(chg: RateChange, d: Date) kind empirical {
    label en official "the rate changes for taxable years \"ending after\" a certain date";
}
pub relation rate_change_stated_beginning_on_or_after(chg: RateChange, d: Date) kind empirical {
    label en official "a rate changes for taxable years \"beginning on or after\" a certain date";
}

pub relation rate_change_effective_date(chg: RateChange, d: Date) kind institutional {
    label en official "the effective date of the change";
}

@source(IRC_S15_C, relation = formalizes, coverage = exact, quote = "if the rate changes for taxable years \"beginning after\" or \"ending after\" a certain date, the following day shall be considered the effective date of the change")
rule RateChangeBeginningAfterEffectiveNextDay(chg: RateChange, stated: Date) strict {
    label en official "section 15(c)(1): a change for taxable years \"beginning after\" a date takes effect on the following day";
    when rate_change_stated_beginning_after(chg, stated);
    then rate_change_effective_date(chg, add_calendar_period(stated, 1 calendar_day));
}

@source(IRC_S15_C, relation = formalizes, coverage = exact, quote = "if the rate changes for taxable years \"beginning after\" or \"ending after\" a certain date, the following day shall be considered the effective date of the change")
rule RateChangeEndingAfterEffectiveNextDay(chg: RateChange, stated: Date) strict {
    label en official "section 15(c)(1): a change for taxable years \"ending after\" a date takes effect on the following day";
    when rate_change_stated_ending_after(chg, stated);
    then rate_change_effective_date(chg, add_calendar_period(stated, 1 calendar_day));
}

@source(IRC_S15_C, relation = formalizes, coverage = exact, quote = "if a rate changes for taxable years \"beginning on or after\" a certain date, that date shall be considered the effective date of the change")
rule RateChangeBeginningOnOrAfterEffectiveThatDate(chg: RateChange, stated: Date) strict {
    label en official "section 15(c)(2): a change for taxable years \"beginning on or after\" a date takes effect on that date";
    when rate_change_stated_beginning_on_or_after(chg, stated);
    then rate_change_effective_date(chg, stated);
}

// --- Section 15(b): repeal is a change of rate, to zero -----------------------

pub relation rate_change_after_rate(chg: RateChange, rate: Decimal) kind institutional {
    label en official "the rate for the period after the change";
}
pub relation rate_applies_after_change(chg: RateChange, rate: Decimal) kind empirical {
    label en unofficial "the rate the enacting text sets for the period on and after the effective date (a fact of the enactment)";
}

@source(IRC_S15_B, relation = formalizes, coverage = exact, quote = "the rate for the period after the repeal shall be zero")
rule RepealRateAfterIsZero(chg: RateChange) strict {
    label en official "section 15(b): if a tax is repealed, the repeal is a change of rate and the rate for the period after the repeal is zero";
    when tax_repealed_by_change(chg);
    then rate_change_after_rate(chg, 0.0);
}

@source(IRC_S15_A, relation = formalizes, coverage = partial, quote = "If any rate of tax imposed by this chapter changes")
rule EnactedRateIsRateAfterChange(chg: RateChange, r: Decimal) strict {
    label en official "section 15(a): the rate for the period on and after the effective date is the rate the enactment sets";
    when rate_applies_after_change(chg, r);
    then rate_change_after_rate(chg, r);
}

// --- Section 15(a): the two tentative taxes and the day-weighted sum ---------

pub relation tentative_tax_before_change(p: Person, y: TaxableYear, chg: RateChange, amount: Money) kind institutional {
    label en official "the tentative tax computed by applying the rate for the period before the effective date of the change to the taxable income for the entire taxable year";
}
pub relation tentative_tax_after_change(p: Person, y: TaxableYear, chg: RateChange, amount: Money) kind institutional {
    label en official "the tentative tax computed by applying the rate for the period on and after the effective date of the change to the taxable income for the entire taxable year";
}

pub relation rate_change_prorates_year(y: TaxableYear, chg: RateChange) kind institutional {
    label en official "the taxable year includes the effective date of the change (unless that date is the first day of the taxable year), and the change is one to which section 15 applies";
}

@source(IRC_S15_A, relation = formalizes, coverage = exact, quote = "if the taxable year includes the effective date of the change (unless that date is the first day of the taxable year)")
rule RateChangeInsideYearProrates(y: TaxableYear, chg: RateChange, start: Date, last: Date, eff: Date) strict {
    label en official "section 15(a): a rate change whose effective date falls inside the taxable year, after its first day, is prorated; sections 15(d) and 15(f) exclude section 1(f) inflation adjustments and section 1(i) rate reductions";
    when rate_change_source(chg, Ordinary);
    when rate_change_effective_date(chg, eff);
    when us.irc.core::begins(y, start);
    when us.irc.core::ends(y, last);
    when eff > start;
    when eff <= last;
    then rate_change_prorates_year(y, chg);
}

pub relation tax_for_rate_change_year(p: Person, y: TaxableYear, chg: RateChange, amount: Money) kind institutional {
    label en official "the tax for such taxable year: the sum of that proportion of each tentative tax which the number of days in each period bears to the number of days in the entire taxable year";
}

@source(IRC_S15_A, relation = formalizes, coverage = exact, quote = "the tax for such taxable year shall be the sum of that proportion of each tentative tax which the number of days in each period bears to the number of days in the entire taxable year")
rule TaxForRateChangeYearIsDayWeightedSum(p: Person, y: TaxableYear, chg: RateChange, start: Date, last: Date, eff: Date, before: Money, after: Money) strict {
    label en official "section 15(a)(2): tax = tentative tax before x (days before / days in year) + tentative tax after x (days on and after / days in year)";
    when rate_change_prorates_year(y, chg);
    when rate_change_effective_date(chg, eff);
    when us.irc.core::begins(y, start);
    when us.irc.core::ends(y, last);
    when tentative_tax_before_change(p, y, chg, before);
    when tentative_tax_after_change(p, y, chg, after);
    then tax_for_rate_change_year(p, y, chg, div_round(before * days_between(start, eff) + after * (days_between(eff, last) + 1), 1.0 * (days_between(start, last) + 1), 10, "HALF_UP"));
}

// --- Section 15(e): reference to the highest rate ----------------------------

pub relation highest_rate_before_change(chg: RateChange, rate: Decimal) kind empirical {
    label en unofficial "the highest rate of tax imposed by section 1 or 11(b) before the change";
}
pub relation highest_rate_after_change(chg: RateChange, rate: Decimal) kind empirical {
    label en unofficial "the highest rate of tax imposed by section 1 or 11(b) on and after the change";
}
pub relation highest_rate_reference_for_year(y: TaxableYear, chg: RateChange, rate: Decimal) kind institutional {
    label en official "a reference in chapter 1 to the highest rate, treated as the weighted average of the highest rates before and after the change";
}

@source(IRC_S15_E, relation = formalizes, coverage = exact, quote = "shall be treated as a reference to the weighted average of the highest rates before and after the change determined on the basis of the respective portions of the taxable year before the date of the change and on or after the date of the change")
rule HighestRateReferenceIsWeightedAverage(y: TaxableYear, chg: RateChange, start: Date, last: Date, eff: Date, hb: Decimal, ha: Decimal) strict {
    label en official "section 15(e): the highest-rate reference in a year of change is the day-weighted average of the highest rates before and after the change";
    when rate_change_prorates_year(y, chg);
    when rate_change_effective_date(chg, eff);
    when us.irc.core::begins(y, start);
    when us.irc.core::ends(y, last);
    when highest_rate_before_change(chg, hb);
    when highest_rate_after_change(chg, ha);
    then highest_rate_reference_for_year(y, chg, div_round(hb * days_between(start, eff) + ha * (days_between(eff, last) + 1), 1.0 * (days_between(start, last) + 1), 10, "HALF_UP"));
}
