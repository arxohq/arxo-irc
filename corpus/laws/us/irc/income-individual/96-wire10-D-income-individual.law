// Income individual -- WIRE-10 group D (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// Two norms the consumers of this package need and this package did not state:
//
//  (1) The highest rate of tax that section 1 imposes for a taxable year (sections 1(j)(2)(A)-(E)), read by the partnership-audit
//      imputed underpayment (section 6225(b)(1)(B)), by the foreign-partner withholding rate of section 1446(b)(2)(A) and by the
//      individual rate applied to effectively connected income (section 871(b)(1)). It is stated for the taxable years the TCJA
//      tables govern (beginning after 2017). Taxable years before 2018 keep the case-fact channel of the consumers: the rate
//      reductions of sections 1(i) and 1(a)-(e) for 2001-2017 need tables this package does not restate (JUDGMENT CALL, stated once).
//
//  (2) The indexing of the section 1(j)(2) bracket bounds for taxable years beginning after 2025. Section 1(j)(3)(B)(i), as amended by
//      Pub. L. 119-21 section 70101(b), substitutes calendar year 2017 (for 2016) "solely for purposes of determining the dollar
//      amounts at which any rate bracket higher than 12 percent ends and at which any rate bracket higher than 22 percent begins";
//      the modules 60 and 71 request that indexing only for 2019-2025. Here the request is raised for the years after 2025 for
//      the beginning of bracket 4 (24 percent) and above, the bounds the amended text still indexes from 2017; the beginnings of
//      the 12 and 22 percent brackets keep the unamended base year 2016 and are NOT requested here (they are not needed by a consumer).

language "law.core" version "0.2";
package us.irc.income_individual version "0.1.1";
namespace "urn:us:irc:income_individual:clir";

use self::{
    FilingStatus,
    IRC_S1_J,
    TaxableYear,
    amount_to_index,
    tcja_bracket_statutory,
    tcja_rounding_step,
};

// --- (1) the highest rate of section 1 ------------------------------------------------------------------------------------------

pub relation highest_rate_under_section_1(y: TaxableYear, rate: Decimal) kind institutional {
    label en official "the highest rate of tax imposed by section 1 for the taxable year: the rate of the last bracket of the tables of section 1(j)(2)(A)-(E), the highest of the five";
}

@source(IRC_S1_J, relation = formalizes, coverage = partial, quote = "For taxable years beginning after December 31, 2018, the Secretary shall prescribe tables which shall apply in lieu of the tables contained in paragraph (2)")
rule W10DHighestRateUnderSection1TcjaYears(y: TaxableYear, d: Date, rj: Decimal, rh: Decimal, ru: Decimal, rm: Decimal, re: Decimal) strict {
    label en official "section 1(j)(2): in a taxable year beginning after 2017 the highest rate of section 1 is the highest last-bracket rate of the five tables";
    when us.irc.core::begins(y, d);
    when d >= @2018-01-01;
    when tcja_bracket_statutory(Joint, 7, _, rj);
    when tcja_bracket_statutory(HeadOfHousehold, 7, _, rh);
    when tcja_bracket_statutory(Unmarried, 7, _, ru);
    when tcja_bracket_statutory(MarriedSeparate, 7, _, rm);
    when tcja_bracket_statutory(EstateOrTrust, 4, _, re);
    then highest_rate_under_section_1(y, max(max(max(rj, rh), max(ru, rm)), re));
}

// --- (2) bracket bounds after 2025 ------------------------------------------------------------------------------------------------

@source(IRC_S1_J, relation = formalizes, coverage = partial, quote = "For taxable years beginning after December 31, 2018, the Secretary shall prescribe tables which shall apply in lieu of the tables contained in paragraph (2)")
rule W10DRequestIndexingOfTcjaBracketBoundAfter2025(s: FilingStatus, k: Integer, base: Money, r: Decimal, step: Integer, y: TaxableYear, cy: Integer) strict {
    label en official "section 1(j)(3)(B)(i) as amended by Pub. L. 119-21 section 70101(b): the beginning of any bracket higher than 22 percent (bracket 4 and above) is increased by the cost-of-living adjustment with 2017 substituted for 2016, for taxable years beginning after 2025";
    when tcja_bracket_statutory(s, k, base, r);
    when k >= 4;
    when tcja_rounding_step(s, step);
    when us.irc.core::calendar_year_of(y, cy);
    when cy >= 2026;
    then amount_to_index(base, 2017, y, step);
}
