// Section 1(a)-(e): the five rate tables (1986/1993-Act base amounts, the
// pinned statutory text) and section 1(j): the TCJA-modified tables that
// apply "in lieu of" (a)-(e) for taxable years beginning after December 31,
// 2017. Bracket data lives in the ten `.lawtable.json` sidecars beside this
// file (AGENT-BRIEF: "a decision table per filing status"); this module only
// reads their emitted predicates and does the "base tax + rate * excess"
// arithmetic the statute's own table wording describes ("$X, plus Y% of the
// excess over $Z").
//
// TEMPORAL STRUCTURE (§1(j)(1), amended by Pub. L. 119-21 §70101(a),
// 139 Stat. 158, 4 July 2025). The pinned 2024-Edition text of §1(j)(1)
// reads "In the case of a taxable year beginning after December 31, 2017,
// and before January 1, 2026— (A) subsection (i) shall not apply, and (B)
// this section (other than subsection (i)) shall be applied as provided in
// paragraphs (2) through (6)." Section 70101(a)(1) of Pub. L. 119-21 strikes
// ", and before January 1, 2026" from paragraph (1), making the TCJA
// modification permanent; the amendment "shall apply to taxable years
// beginning after December 31, 2025" (§70101(c)). The two rules below model
// this as an unamended-edition rule bounded [2018-01-01, 2026-01-01) and a
// post-amendment rule effective [2026-01-01, infinity) — together they
// reproduce exactly the CURRENT law (permanent TCJA brackets from 2018
// onward) without silently rewriting the base 2024 text. There is no
// first-class `revision` construct in this grammar (checked: `docs/
// constructs/` has no dedicated file); this is the closest honest
// approximation with ordinary `effective` windows, noted as a judgment call.
//
// §1(j)(3)(B)(i), as inserted by Pub. L. 119-21 §70101(b), narrows which
// bracket boundaries get the chained-CPI-based inflation adjustment
// ("solely for purposes of determining the dollar amounts at which any rate
// bracket higher than 12 percent ends and at which any rate bracket higher
// than 22 percent begins") — this is part of the §1(f)/(j)(3) COLA
// MECHANISM, which is not executable in this stage (see the note in
// `inflation-and-rate-reductions.law`): no Rev. Proc. dataset is pinned, so
// no scenario in this package can exercise the distinction it draws. Flagged
// as TECH_GAP, not silently dropped.
//
// §1(a)-(e) ITSELF is not repealed by §1(j): it remains the operative
// schedule for taxable years beginning before 2018, which is outside this
// package's assigned scenario years (2024/2025/2026). It is still modelled
// below (full stage-1 scope), gated by its own `effective` window.

// `Person`/`TaxableYear` aliases live in `filing-status.law` (one alias per
// package, per LDC-E1201).

use self::{
    FilingStatus,
    IRC_S1_A,
    IRC_S1_B,
    IRC_S1_C,
    IRC_S1_D,
    IRC_S1_E,
    IRC_S1_J,
    Person,
    TaxableYear,
    filing_status,
};

// Emitted predicates of the ten `.lawtable.json` sidecars beside this file
// (`mode: rules`, `emit.predicate`) — declared here so this file's rules can
// read them (each `relation` below matches one sidecar's `emit` block
// exactly; the sidecar's rows are its `@source` anchors, not this line's).
pub relation bracket_1986_joint(taxable_income: Money, lower_bound: Money, base_tax: Money, rate: Decimal) kind institutional;
pub relation bracket_1986_hoh(taxable_income: Money, lower_bound: Money, base_tax: Money, rate: Decimal) kind institutional;
pub relation bracket_1986_unmarried(taxable_income: Money, lower_bound: Money, base_tax: Money, rate: Decimal) kind institutional;
pub relation bracket_1986_married_separate(taxable_income: Money, lower_bound: Money, base_tax: Money, rate: Decimal) kind institutional;
pub relation bracket_1986_estate_trust(taxable_income: Money, lower_bound: Money, base_tax: Money, rate: Decimal) kind institutional;
pub relation bracket_tcja_joint(taxable_income: Money, lower_bound: Money, base_tax: Money, rate: Decimal) kind institutional;
pub relation bracket_tcja_hoh(taxable_income: Money, lower_bound: Money, base_tax: Money, rate: Decimal) kind institutional;
pub relation bracket_tcja_unmarried(taxable_income: Money, lower_bound: Money, base_tax: Money, rate: Decimal) kind institutional;
pub relation bracket_tcja_married_separate(taxable_income: Money, lower_bound: Money, base_tax: Money, rate: Decimal) kind institutional;
pub relation bracket_tcja_estate_trust(taxable_income: Money, lower_bound: Money, base_tax: Money, rate: Decimal) kind institutional;

// --- External dependency: taxable income (section 63, owned elsewhere) ------

pub relation taxable_income(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "taxable income (as defined in section 63)";
}

// --- Interface: the tax imposed by section 1 ---------------------------------

pub relation tax_under_section_1(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the tax section 1 imposes on this person for this taxable year, before subsections (g)/(h) and before credits";
}

// --- Section 1(a)-(e): the base 1986/1993-Act schedule (pre-2018) -----------

@source(IRC_S1_A, relation = formalizes, coverage = partial, quote = "a tax determined in accordance with the following table:")
rule TaxUnderTableA(p: Person, y: TaxableYear, income: Money, lower: Money, base: Money, rate: Decimal) strict {
    label en official "a tax determined in accordance with the following table [T1]";
    effective [@1993-01-01, @2018-01-01);
    when filing_status(p, y, Joint);
    when taxable_income(p, y, income);
    when bracket_1986_joint(income, lower, base, rate);
    then tax_under_section_1(p, y, base + rate * (income - lower));
}

@source(IRC_S1_B, relation = formalizes, coverage = partial, quote = "There is hereby imposed on the taxable income of every head of a household (as defined in section 2(b)) a tax determined in accordance with the following table:")
rule TaxUnderTableB(p: Person, y: TaxableYear, income: Money, lower: Money, base: Money, rate: Decimal) strict {
    label en official "a tax determined in accordance with the following table [T2]";
    effective [@1993-01-01, @2018-01-01);
    when filing_status(p, y, HeadOfHousehold);
    when taxable_income(p, y, income);
    when bracket_1986_hoh(income, lower, base, rate);
    then tax_under_section_1(p, y, base + rate * (income - lower));
}

@source(IRC_S1_C, relation = formalizes, coverage = partial, quote = "There is hereby imposed on the taxable income of every individual (other than a surviving spouse as defined in section 2(a) or the head of a household as defined in section 2(b)) who is not a married individual (as defined in section 7703) a tax determined in accordance with the following table:")
rule TaxUnderTableC(p: Person, y: TaxableYear, income: Money, lower: Money, base: Money, rate: Decimal) strict {
    label en official "a tax determined in accordance with the following table [T3]";
    effective [@1993-01-01, @2018-01-01);
    when filing_status(p, y, Unmarried);
    when taxable_income(p, y, income);
    when bracket_1986_unmarried(income, lower, base, rate);
    then tax_under_section_1(p, y, base + rate * (income - lower));
}

@source(IRC_S1_D, relation = formalizes, coverage = partial, quote = "There is hereby imposed on the taxable income of every married individual (as defined in section 7703) who does not make a single return jointly with his spouse under section 6013, a tax determined in accordance with the following table:")
rule TaxUnderTableD(p: Person, y: TaxableYear, income: Money, lower: Money, base: Money, rate: Decimal) strict {
    label en official "a tax determined in accordance with the following table [T4]";
    effective [@1993-01-01, @2018-01-01);
    when filing_status(p, y, MarriedSeparate);
    when taxable_income(p, y, income);
    when bracket_1986_married_separate(income, lower, base, rate);
    then tax_under_section_1(p, y, base + rate * (income - lower));
}

@source(IRC_S1_E, relation = formalizes, coverage = partial, quote = "taxable under this subsection a tax determined in accordance with the following table:")
rule TaxUnderTableE(p: Person, y: TaxableYear, income: Money, lower: Money, base: Money, rate: Decimal) strict {
    label en official "a tax determined in accordance with the following table [T5]";
    effective [@1993-01-01, @2018-01-01);
    when filing_status(p, y, EstateOrTrust);
    when taxable_income(p, y, income);
    when bracket_1986_estate_trust(income, lower, base, rate);
    then tax_under_section_1(p, y, base + rate * (income - lower));
}

// --- Section 1(j)(2): TCJA tables, base 2024-Edition window (2018-2025) -----

@source(IRC_S1_J, quote = "The following table shall be applied in lieu of the table contained in subsection (a)")
rule TaxUnderTcjaTableA2018to2025(p: Person, y: TaxableYear, income: Money, lower: Money, base: Money, rate: Decimal) strict {
    label en official "section 1(j)(2)(A): the following table shall be applied in lieu of the table contained in subsection (a)";
    effective [@2018-01-01, @2026-01-01);
    when filing_status(p, y, Joint);
    when taxable_income(p, y, income);
    when bracket_tcja_joint(income, lower, base, rate);
    then tax_under_section_1(p, y, base + rate * (income - lower));
}

@source(IRC_S1_J, quote = "The following table shall be applied in lieu of the table contained in subsection (b)")
rule TaxUnderTcjaTableB2018to2025(p: Person, y: TaxableYear, income: Money, lower: Money, base: Money, rate: Decimal) strict {
    label en official "section 1(j)(2)(B): the following table shall be applied in lieu of the table contained in subsection (b)";
    effective [@2018-01-01, @2026-01-01);
    when filing_status(p, y, HeadOfHousehold);
    when taxable_income(p, y, income);
    when bracket_tcja_hoh(income, lower, base, rate);
    then tax_under_section_1(p, y, base + rate * (income - lower));
}

@source(IRC_S1_J, quote = "The following table shall be applied in lieu of the table contained in subsection (c)")
rule TaxUnderTcjaTableC2018to2025(p: Person, y: TaxableYear, income: Money, lower: Money, base: Money, rate: Decimal) strict {
    label en official "section 1(j)(2)(C): the following table shall be applied in lieu of the table contained in subsection (c)";
    effective [@2018-01-01, @2026-01-01);
    when filing_status(p, y, Unmarried);
    when taxable_income(p, y, income);
    when bracket_tcja_unmarried(income, lower, base, rate);
    then tax_under_section_1(p, y, base + rate * (income - lower));
}

@source(IRC_S1_J, quote = "The following table shall be applied in lieu of the table contained in subsection (d)")
rule TaxUnderTcjaTableD2018to2025(p: Person, y: TaxableYear, income: Money, lower: Money, base: Money, rate: Decimal) strict {
    label en official "section 1(j)(2)(D): the following table shall be applied in lieu of the table contained in subsection (d)";
    effective [@2018-01-01, @2026-01-01);
    when filing_status(p, y, MarriedSeparate);
    when taxable_income(p, y, income);
    when bracket_tcja_married_separate(income, lower, base, rate);
    then tax_under_section_1(p, y, base + rate * (income - lower));
}

@source(IRC_S1_J, quote = "The following table shall be applied in lieu of the table contained in subsection (e)")
rule TaxUnderTcjaTableE2018to2025(p: Person, y: TaxableYear, income: Money, lower: Money, base: Money, rate: Decimal) strict {
    label en official "section 1(j)(2)(E): the following table shall be applied in lieu of the table contained in subsection (e)";
    effective [@2018-01-01, @2026-01-01);
    when filing_status(p, y, EstateOrTrust);
    when taxable_income(p, y, income);
    when bracket_tcja_estate_trust(income, lower, base, rate);
    then tax_under_section_1(p, y, base + rate * (income - lower));
}

// --- Section 1(j)(2) TCJA tables, permanent per Pub. L. 119-21 (2026+) ------
//
// Same tables, same bracket amounts (§1(j)(2) itself was not amended — only
// §1(j)(1)'s sunset and §1(j)(3)(B)(i)'s inflation-adjustment method were).
// The rules below are the SAME norm read under the amended text; duplicated
// (rather than widening the window above to `infinity`) so the base-edition
// rule stays a faithful transcription of the PINNED 2024 text and the
// amendment is visible as its own rule with its own provenance comment.

@source(IRC_S1_J, quote = "The following table shall be applied in lieu of the table contained in subsection (a)")
rule TaxUnderTcjaTableAPermanent(p: Person, y: TaxableYear, income: Money, lower: Money, base: Money, rate: Decimal) strict {
    label en official "section 1(j)(2)(A), permanent per Pub. L. 119-21 section 70101(a) (striking the 2026 sunset in paragraph (1))";
    effective [@2026-01-01, infinity);
    when filing_status(p, y, Joint);
    when taxable_income(p, y, income);
    when bracket_tcja_joint(income, lower, base, rate);
    then tax_under_section_1(p, y, base + rate * (income - lower));
}

@source(IRC_S1_J, quote = "The following table shall be applied in lieu of the table contained in subsection (b)")
rule TaxUnderTcjaTableBPermanent(p: Person, y: TaxableYear, income: Money, lower: Money, base: Money, rate: Decimal) strict {
    label en official "section 1(j)(2)(B), permanent per Pub. L. 119-21 section 70101(a)";
    effective [@2026-01-01, infinity);
    when filing_status(p, y, HeadOfHousehold);
    when taxable_income(p, y, income);
    when bracket_tcja_hoh(income, lower, base, rate);
    then tax_under_section_1(p, y, base + rate * (income - lower));
}

@source(IRC_S1_J, quote = "The following table shall be applied in lieu of the table contained in subsection (c)")
rule TaxUnderTcjaTableCPermanent(p: Person, y: TaxableYear, income: Money, lower: Money, base: Money, rate: Decimal) strict {
    label en official "section 1(j)(2)(C), permanent per Pub. L. 119-21 section 70101(a)";
    effective [@2026-01-01, infinity);
    when filing_status(p, y, Unmarried);
    when taxable_income(p, y, income);
    when bracket_tcja_unmarried(income, lower, base, rate);
    then tax_under_section_1(p, y, base + rate * (income - lower));
}

@source(IRC_S1_J, quote = "The following table shall be applied in lieu of the table contained in subsection (d)")
rule TaxUnderTcjaTableDPermanent(p: Person, y: TaxableYear, income: Money, lower: Money, base: Money, rate: Decimal) strict {
    label en official "section 1(j)(2)(D), permanent per Pub. L. 119-21 section 70101(a)";
    effective [@2026-01-01, infinity);
    when filing_status(p, y, MarriedSeparate);
    when taxable_income(p, y, income);
    when bracket_tcja_married_separate(income, lower, base, rate);
    then tax_under_section_1(p, y, base + rate * (income - lower));
}

@source(IRC_S1_J, quote = "The following table shall be applied in lieu of the table contained in subsection (e)")
rule TaxUnderTcjaTableEPermanent(p: Person, y: TaxableYear, income: Money, lower: Money, base: Money, rate: Decimal) strict {
    label en official "section 1(j)(2)(E), permanent per Pub. L. 119-21 section 70101(a)";
    effective [@2026-01-01, infinity);
    when filing_status(p, y, EstateOrTrust);
    when taxable_income(p, y, income);
    when bracket_tcja_estate_trust(income, lower, base, rate);
    then tax_under_section_1(p, y, base + rate * (income - lower));
}

// §1(j)(2)(F) (references to rate tables under subsection (c) treated as
// references to the corresponding TCJA bracket, with a carve-out for
// §3402(q)(1)) is a cross-reference rule for OTHER packages' rate lookups
// (withholding, backup withholding); classified NON_NORMATIVE for this
// package (it creates no obligation of its own) and left to the consuming
// package (`employment`) to apply when it reads `tax_under_section_1`.
//
// §1(j)(3)(A) ("no adjustment in 2018") and §1(j)(3)(B) ("subsequent years")
// are exactly the §1(f) COLA mechanism applied to the TCJA tables; see
// `inflation-and-rate-reductions.law` — no Rev. Proc. dataset is pinned, so
// the TABLES ABOVE ARE THE UNADJUSTED 2018 AMOUNTS for every scenario year
// (2024/2025/2026), which is a real limitation the report calls out
// explicitly: this package cannot currently reproduce the actual dollar
// brackets the IRS published for those years, only the statutory base.
//
// §1(j)(4) is repealed (Pub. L. 116-94, div. O, title V, §501(a)); recorded
// NON_NORMATIVE.
//
// §1(j)(5) (capital-gains breakpoint amounts) is modelled in
// `capital-gains.law`. §1(j)(6) ("section 15 shall not apply") is a
// coordination rule with §15, which is this package's own STAGE 2 scope
// (per the task's note) — left unreviewed here with note "stage 2".
