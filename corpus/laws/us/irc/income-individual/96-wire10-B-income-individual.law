// Income-individual -- WIRE-10, group B (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// Norms the package lacked and that consumer packages of group B need as `pub` relations. Case facts stay a valid channel for every
// consumer (WIRE-7/8/9 technique).

language "law.core" version "0.2";
package us.irc.income_individual version "0.1.1";
namespace "urn:us:irc:income_individual:clir";

use self::{
    IRC_S1_C,
    TaxableYear,
};

// --- section 1(c): the third and the fourth lowest rate (read by employment: sections 3402(q), 3402(r), 3406(a)) ------------------

pub relation section_1c_third_lowest_rate(y: TaxableYear, rate: Decimal) kind institutional {
    label en official "the third lowest rate of tax applicable under section 1(c) for the taxable year (31 percent of the section 1(c) table; 22 percent of the section 1(j)(2)(C) table for taxable years beginning after 2017)";
}
pub relation section_1c_fourth_lowest_rate(y: TaxableYear, rate: Decimal) kind institutional {
    label en official "the fourth lowest rate of tax applicable under section 1(c) for the taxable year (36 percent of the section 1(c) table; 24 percent of the section 1(j)(2)(C) table for taxable years beginning after 2017)";
}

@source(IRC_S1_C, relation = formalizes, coverage = partial, quote = "There is hereby imposed on the taxable income of every individual")
rule W10Section1cThirdLowestRate(y: TaxableYear, b: Date) strict {
    label en official "the third lowest rate applicable under section 1(c) is the third rate of the table for unmarried individuals (A3 parameter Section1cThirdLowestRate)";
    when us.irc.core::begins(y, b);
    then section_1c_third_lowest_rate(y, Section1cThirdLowestRate);
}
@source(IRC_S1_C, relation = formalizes, coverage = partial, quote = "There is hereby imposed on the taxable income of every individual")
rule W10Section1cFourthLowestRate(y: TaxableYear, b: Date) strict {
    label en official "the fourth lowest rate applicable under section 1(c) is the fourth rate of the table for unmarried individuals (A3 parameter Section1cFourthLowestRate)";
    when us.irc.core::begins(y, b);
    then section_1c_fourth_lowest_rate(y, Section1cFourthLowestRate);
}
