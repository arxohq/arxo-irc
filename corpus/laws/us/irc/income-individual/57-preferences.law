// Section 57: items of tax preference (stage 2). Each item is an amount ADDED
// to alternative minimum taxable income (`amt_preference`, summed in
// `55-amt.law`). Modelled with exact arithmetic over facts of the case:
// (a)(1) depletion in excess of adjusted basis, (a)(2) excess intangible
// drilling costs over 65 percent of net oil, gas and geothermal income
// (separately for oil and gas, and for geothermal deposits; the independent
// producer exception of (E)), (a)(5) interest on specified private activity
// bonds (the (C) definition with its five exceptions, dated), (a)(7) the 7
// percent small-business-stock exclusion preference, (b) straight line
// recovery of intangibles. Repealed paragraphs (a)(3) and (a)(4) are
// classified, not modelled. Paragraph (a)(6) (amounts under paragraphs (2),
// (3), (4) and (12) of the pre-1987 text) is a case-supplied preference, see
// `amt_preference_supplied`.
//
// Circularity note (why some amounts are inputs): (a)(2)(E)(ii) caps the
// independent producer's relief at 40 percent of alternative minimum taxable
// income determined without regard to that very relief; computing that figure
// inside the package would define alternative minimum taxable income in terms
// of itself, so it is a case-supplied figure (TECH-GAPS, stage 2 AMT).

// --- Section 57(a)(1): depletion ----------------------------------------------

use self::{
    AmtPreferenceKind,
    IRC_S57_A,
    Person,
    TaxableYear,
    amt_preference,
    g7_election_covers_child,
    noncorporate_taxpayer_for_year,
};

// WIRE-8: a depletable property is a role over the shared `Asset` (subtype, PACKAGE-LAYOUT), so owners that key section 611-613 relations by
// `Asset` (`accounting`, which imports this package) derive the local contracts below without an identity bridge (Д-22 item (а)).
type Asset = us.irc.core::Asset;
pub entity DepletableProperty : Asset {
    label en unofficial "a property (as defined in section 614) for which a depletion deduction is allowed";
}

pub relation depletion_deduction_allowed(p: Person, y: TaxableYear, prop: DepletableProperty, amount: Money) kind empirical {
    label en official "the deduction for depletion allowable under section 611 for the taxable year";
}
pub relation adjusted_basis_at_year_end_before_depletion(p: Person, y: TaxableYear, prop: DepletableProperty, amount: Money) kind empirical {
    label en official "the adjusted basis of the property at the end of the taxable year (determined without regard to the depletion deduction for the taxable year)";
}
pub relation depletion_computed_under_613a_c(p: Person, y: TaxableYear, prop: DepletableProperty) kind empirical {
    label en official "the depletion deduction is computed in accordance with section 613A(c)";
}
pub relation depletion_preference_of_property(p: Person, y: TaxableYear, prop: DepletableProperty, amount: Money) kind institutional {
    label en official "the excess of the deduction for depletion over the adjusted basis of the property at the end of the taxable year, for one property";
}

@source(IRC_S57_A, relation = formalizes, coverage = exact, quote = "the excess of the deduction for depletion allowable under section 611 for the taxable year over the adjusted basis of the property at the end of the taxable year (determined without regard to the depletion deduction for the taxable year).")
rule DepletionPreferenceOfProperty(p: Person, y: TaxableYear, prop: DepletableProperty, depletion: Money, basis: Money) strict {
    label en official "section 57(a)(1): per property, max(0, depletion deduction - adjusted basis at year end before depletion); not for depletion computed under section 613A(c)";
    when depletion_deduction_allowed(p, y, prop, depletion);
    when adjusted_basis_at_year_end_before_depletion(p, y, prop, basis);
    when depletion > basis;
    when not_known(depletion_computed_under_613a_c(p, y, prop));
    then depletion_preference_of_property(p, y, prop, depletion - basis);
}

relation has_depletion_preference(p: Person, y: TaxableYear) kind institutional {
    label en unofficial "at least one property has a depletion preference for the year";
}
rule HasDepletionPreference(p: Person, y: TaxableYear) strict {
    when depletion_preference_of_property(p, y, _, _);
    then has_depletion_preference(p, y);
}

@source(IRC_S57_A, relation = formalizes, coverage = exact, quote = "With respect to each property (as defined in section 614), the excess of the deduction for depletion allowable under section 611")
rule AmtPreferenceDepletion(p: Person, y: TaxableYear) strict {
    label en official "section 57(a)(1): the depletion preference is the sum over the taxpayer's properties";
    when noncorporate_taxpayer_for_year(p, y);
    when has_depletion_preference(p, y);
    then amt_preference(p, y, Depletion57a1, sum all amount: Money for prop: DepletableProperty where depletion_preference_of_property(p, y, prop, amount));
}

// --- Section 57(a)(2): intangible drilling costs -------------------------------

pub enum DrillingCategory {
    OilAndGas;
    Geothermal;
    label en official "paragraph (2) is applied separately with respect to all oil and gas properties and all properties which are geothermal deposits";
}

pub relation idc_allowed_regular_tax(p: Person, y: TaxableYear, cat: DrillingCategory, amount: Money) kind empirical {
    label en official "the intangible drilling and development costs (other than costs of a nonproductive well) allowable under section 263(c) or 291(b) for the taxable year";
}
pub relation idc_if_capitalized_straight_line(p: Person, y: TaxableYear, cat: DrillingCategory, amount: Money) kind empirical {
    label en official "the amount which would have been allowable for the taxable year if such costs had been capitalized and straight line recovery of intangibles had been used";
}
pub relation gross_income_from_properties(p: Person, y: TaxableYear, cat: DrillingCategory, amount: Money) kind empirical {
    label en official "the aggregate amount of gross income (within the meaning of section 613(a)) from all such properties received or accrued during the taxable year";
}
pub relation deductions_allocable_to_properties(p: Person, y: TaxableYear, cat: DrillingCategory, amount: Money) kind empirical {
    label en official "the amount of any deductions allocable to such properties (before the reduction by the excess intangible drilling costs)";
}

pub relation excess_intangible_drilling_costs(p: Person, y: TaxableYear, cat: DrillingCategory, amount: Money) kind institutional {
    label en official "the amount of the excess intangible drilling costs arising in the taxable year";
}

@source(IRC_S57_A, relation = formalizes, coverage = exact, quote = "For purposes of subparagraph (A), the amount of the excess intangible drilling costs arising in the taxable year is the excess of—")
rule ExcessIntangibleDrillingCosts(p: Person, y: TaxableYear, cat: DrillingCategory, allowed: Money, slr: Money) strict {
    label en official "section 57(a)(2)(B): excess IDC = IDC allowable for the year over the amount allowable if capitalized with straight line recovery (never below zero)";
    when idc_allowed_regular_tax(p, y, cat, allowed);
    when idc_if_capitalized_straight_line(p, y, cat, slr);
    then excess_intangible_drilling_costs(p, y, cat, max(0.00 USD, allowed - slr));
}

pub relation net_income_from_oil_gas_geothermal(p: Person, y: TaxableYear, cat: DrillingCategory, amount: Money) kind institutional {
    label en official "the net income of the taxpayer from oil, gas, and geothermal properties for the taxable year";
}

@source(IRC_S57_A, relation = formalizes, coverage = exact, quote = "For purposes of subparagraph (A), the amount of the net income of the taxpayer from oil, gas, and geothermal properties for the taxable year is the excess of—")
rule NetIncomeFromOilGasGeothermal(p: Person, y: TaxableYear, cat: DrillingCategory, gross: Money, deductions: Money, excess_idc: Money) strict {
    label en official "section 57(a)(2)(C): net income = gross income from the properties over the allocable deductions reduced by the excess intangible drilling costs";
    when gross_income_from_properties(p, y, cat, gross);
    when deductions_allocable_to_properties(p, y, cat, deductions);
    when excess_intangible_drilling_costs(p, y, cat, excess_idc);
    then net_income_from_oil_gas_geothermal(p, y, cat, gross - (deductions - excess_idc));
}

pub relation idc_preference_before_independent_producer_relief(p: Person, y: TaxableYear, cat: DrillingCategory, amount: Money) kind institutional {
    label en official "the amount (if any) by which the excess intangible drilling costs are greater than 65 percent of the net income from the properties";
}

@source(IRC_S57_A, relation = formalizes, coverage = exact, quote = "the amount (if any) by which the amount of the excess intangible drilling costs arising in the taxable year is greater than 65 percent of the net income of the taxpayer from oil, gas, and geothermal properties for the taxable year.")
rule IdcPreferenceBeforeRelief(p: Person, y: TaxableYear, cat: DrillingCategory, excess_idc: Money, net_income: Money) strict {
    label en official "section 57(a)(2)(A): max(0, excess IDC - 65 percent of net income), applied separately per category ((D))";
    when excess_intangible_drilling_costs(p, y, cat, excess_idc);
    when net_income_from_oil_gas_geothermal(p, y, cat, net_income);
    then idc_preference_before_independent_producer_relief(p, y, cat, max(0.00 USD, excess_idc - (net_income * 0.65)));
}

pub relation integrated_oil_company(p: Person, y: TaxableYear) kind empirical {
    label en official "an integrated oil company (as defined in section 291(b)(4))";
}
pub relation amti_before_idc_relief_and_atnol(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "alternative minimum taxable income determined without regard to the independent producer exception and the alternative tax net operating loss deduction (case-supplied: computing it in the package would make alternative minimum taxable income depend on itself)";
}
pub relation idc_preference(p: Person, y: TaxableYear, cat: DrillingCategory, amount: Money) kind institutional {
    label en official "the intangible drilling cost item of tax preference for the category after the paragraph (2)(E) exception";
}

@source(IRC_S57_A, relation = formalizes, coverage = exact, quote = "This paragraph shall not apply to any taxpayer which is not an integrated oil company (as defined in section 291(b)(4)).")
rule IdcPreferenceIntegratedOilCompany(p: Person, y: TaxableYear, cat: DrillingCategory, pref: Money) strict {
    label en official "section 57(a)(2): the preference applies in full to an integrated oil company (and to geothermal properties, which the (E) exception does not name)";
    when idc_preference_before_independent_producer_relief(p, y, cat, pref);
    when integrated_oil_company(p, y);
    then idc_preference(p, y, cat, pref);
}

@source(IRC_S57_A, relation = formalizes, coverage = exact, quote = "This paragraph shall not apply to any taxpayer which is not an integrated oil company (as defined in section 291(b)(4)).")
rule IdcPreferenceGeothermalNotRelieved(p: Person, y: TaxableYear, pref: Money) strict {
    label en official "section 57(a)(2)(E) applies only to an oil or gas well: a geothermal preference is not relieved for an independent producer";
    when idc_preference_before_independent_producer_relief(p, y, Geothermal, pref);
    then idc_preference(p, y, Geothermal, pref);
}

@source(IRC_S57_A, relation = formalizes, coverage = exact, quote = "The reduction in alternative minimum taxable income by reason of clause (i) for any taxable year shall not exceed 40 percent of the alternative minimum taxable income for such year determined without regard to clause (i) and the alternative tax net operating loss deduction under section 56(a)(4).")
rule IdcPreferenceIndependentProducerCapped(p: Person, y: TaxableYear, pref: Money, amti: Money) strict {
    label en official "section 57(a)(2)(E): an independent producer's oil and gas preference is relieved, but the relief may not exceed 40 percent of alternative minimum taxable income without the relief and the alternative tax net operating loss deduction";
    when idc_preference_before_independent_producer_relief(p, y, OilAndGas, pref);
    when not_known(integrated_oil_company(p, y));
    when amti_before_idc_relief_and_atnol(p, y, amti);
    then idc_preference(p, y, OilAndGas, pref - min(pref, max(0.00 USD, amti * 0.4)));
}

relation has_idc_preference(p: Person, y: TaxableYear) kind institutional {
    label en unofficial "an intangible drilling cost preference is derived for the year";
}
rule HasIdcPreference(p: Person, y: TaxableYear) strict {
    when idc_preference(p, y, _, _);
    then has_idc_preference(p, y);
}

@source(IRC_S57_A, relation = formalizes, coverage = exact, quote = "With respect to all oil, gas, and geothermal properties of the taxpayer, the amount (if any) by which the amount of the excess intangible drilling costs arising in the taxable year is greater than 65 percent")
rule AmtPreferenceIntangibleDrillingCosts(p: Person, y: TaxableYear) strict {
    label en official "section 57(a)(2): the intangible drilling cost preference is the sum of the two separately computed categories";
    when noncorporate_taxpayer_for_year(p, y);
    when has_idc_preference(p, y);
    then amt_preference(p, y, IntangibleDrillingCosts57a2, sum all amount: Money for cat: DrillingCategory where idc_preference(p, y, cat, amount));
}

// --- Section 57(a)(5): interest on specified private activity bonds -----------

// WIRE-8: `pub` so that `gross_income` (section 141 bonds, which imports this package) reads the same entity instead of declaring a twin;
// one entity type lets the owner derive the local contracts below from its own section 141/145 relations (Д-22 item (а)).
pub entity BondIssue {
    label en unofficial "an issue of bonds within the meaning of section 141, or a bond of such an issue, whose interest may be an item of tax preference under section 57(a)(5) (case-asserted)";
}

pub relation is_private_activity_bond(b: BondIssue) kind empirical {
    label en official "a private activity bond (as defined in section 141) (dependency contract: the section 141 owner)";
}
pub relation bond_issue_date(b: BondIssue, on: Date) kind empirical {
    label en official "the date the bond was issued";
}
pub relation bond_interest_excluded_under_103(b: BondIssue) kind empirical {
    label en official "the interest on the bond is not includible in gross income under section 103";
}
pub relation is_qualified_501c3_bond(b: BondIssue) kind empirical {
    label en official "a qualified 501(c)(3) bond (as defined in section 145)";
}
pub relation is_certain_housing_bond(b: BondIssue) kind empirical {
    label en official "an exempt facility bond issued as part of an issue 95 percent or more of the net proceeds of which are to be used to provide qualified residential rental projects, a qualified mortgage bond, or a qualified veterans' mortgage bond";
}
pub relation is_refunding_bond(b: BondIssue) kind empirical {
    label en official "the bond is a refunding bond (current or advance)";
}
pub relation original_bond_issue_date(b: BondIssue, on: Date) kind empirical {
    label en official "the issue date of the refunded bond (or, in a series of refundings, the original bond)";
}
pub relation issued_before_sept_1_1986_and_would_be_pab_at_25_percent(b: BondIssue) kind empirical {
    label en official "a bond issued before September 1, 1986 that would be a private activity bond if section 141(b)(1) and (2) applied with 25 percent for 10 percent, section 141(b)(3)-(5) did not apply and section 141(c)(1)(B) did not apply";
}
pub relation refunded_bond_issued_after_2003_before_2009(b: BondIssue) kind empirical {
    label en official "the refunding bond refunds a bond issued after December 31, 2003, and before January 1, 2009";
}
pub relation refunding_bond_excluded_under_iii_needs_refunded_bond_excluded(b: BondIssue) kind empirical {
    label en official "the clause (iii) exception applied to the refunded bond (or, in a series of refundings, the original bond)";
}

pub relation treated_as_issued_before_aug_8_1986(b: BondIssue) kind institutional {
    label en official "the bond is treated as issued before August 8, 1986";
}

@source(IRC_S57_A, relation = formalizes, coverage = exact, quote = "if the refunded bond (or in the case of a series of refundings, the original bond) was issued before August 8, 1986.")
rule BondIssuedBeforeAugust8Directly(b: BondIssue, issued: Date) strict {
    label en official "a bond issued before August 8, 1986 is (trivially) issued before August 8, 1986";
    when bond_issue_date(b, issued);
    when issued < @1986-08-08;
    then treated_as_issued_before_aug_8_1986(b);
}

@source(IRC_S57_A, relation = formalizes, coverage = exact, quote = "For purposes of this subparagraph, a bond issued before September 1, 1986, shall be treated as issued before August 8, 1986, unless such bond would be a private activity bond if—")
rule BondIssuedBeforeSept1Treated(b: BondIssue, issued: Date) strict {
    label en official "section 57(a)(5)(C)(v): a bond issued before September 1, 1986 is treated as issued before August 8, 1986 unless it would be a private activity bond under the 25 percent test";
    when bond_issue_date(b, issued);
    when issued < @1986-09-01;
    when not_known(issued_before_sept_1_1986_and_would_be_pab_at_25_percent(b));
    then treated_as_issued_before_aug_8_1986(b);
}

pub relation bond_effective_issue_date_for_2009_2010_exception(b: BondIssue, on: Date) kind institutional {
    label en official "the date a bond is treated as issued for the 2009-2010 exception (a refunding bond takes the date of the refunded or original bond, except when it refunds a bond issued after 2003 and before 2009)";
}

@source(IRC_S57_A, relation = formalizes, coverage = exact, quote = "For purposes of subclause (I), a refunding bond (whether a current or advance refunding) shall be treated as issued on the date of the issuance of the refunded bond (or in the case of a series of refundings, the original bond).")
rule BondEffectiveIssueDateOwn(b: BondIssue, issued: Date) strict {
    label en official "a bond that is not a refunding bond is treated as issued on its own date";
    when bond_issue_date(b, issued);
    when not_known(is_refunding_bond(b));
    then bond_effective_issue_date_for_2009_2010_exception(b, issued);
}

@source(IRC_S57_A, relation = formalizes, coverage = exact, quote = "For purposes of subclause (I), a refunding bond (whether a current or advance refunding) shall be treated as issued on the date of the issuance of the refunded bond (or in the case of a series of refundings, the original bond).")
rule BondEffectiveIssueDateRefunding(b: BondIssue, original: Date) strict {
    label en official "section 57(a)(5)(C)(vi)(II): a refunding bond is treated as issued on the date of the refunded (or original) bond";
    when is_refunding_bond(b);
    when original_bond_issue_date(b, original);
    when not_known(refunded_bond_issued_after_2003_before_2009(b));
    then bond_effective_issue_date_for_2009_2010_exception(b, original);
}

@source(IRC_S57_A, relation = formalizes, coverage = exact, quote = "Subclause (II) shall not apply to any refunding bond which is issued to refund any bond which was issued after December 31, 2003, and before January 1, 2009.")
rule BondEffectiveIssueDateRefundingOfRecentBond(b: BondIssue, issued: Date) strict {
    label en official "section 57(a)(5)(C)(vi)(III): the refunding bond of a bond issued 2004-2008 keeps its own issue date";
    when is_refunding_bond(b);
    when refunded_bond_issued_after_2003_before_2009(b);
    when bond_issue_date(b, issued);
    then bond_effective_issue_date_for_2009_2010_exception(b, issued);
}

pub relation excluded_from_private_activity_bond_for_57(b: BondIssue) kind institutional {
    label en official "the bond is not a private activity bond for purposes of the definition of specified private activity bond, by one of the five exceptions of clauses (ii)-(vi)";
}

@source(IRC_S57_A, relation = formalizes, coverage = exact, quote = "For purposes of clause (i), the term \"private activity bond\" shall not include any qualified 501(c)(3) bond (as defined in section 145).")
rule PabExceptionQualified501c3(b: BondIssue) strict {
    when is_qualified_501c3_bond(b);
    then excluded_from_private_activity_bond_for_57(b);
}

// "The date of the enactment of this clause" is not in the text of section 57;
// it is pinned in the statutory note of section 56 (IRC_S56_NOTE_6, projected into
// this package's sources): Pub. L. 110-289 (Housing and Economic Recovery Act of
// 2008), section 3022(d)(1), "applicable to bonds issued after July 30, 2008".
@source(IRC_S57_A, relation = formalizes, coverage = exact, quote = "For purposes of clause (i), the term \"private activity bond\" shall not include any bond issued after the date of the enactment of this clause if such bond is—")
rule PabExceptionCertainHousingBond(b: BondIssue, issued: Date) strict {
    label en official "section 57(a)(5)(C)(iii): certain housing bonds issued after the enactment date of the clause (July 30, 2008, from the statutory note of Pub. L. 110-289 section 3022(d)(1))";
    when is_certain_housing_bond(b);
    when bond_issue_date(b, issued);
    when issued > @2008-07-30;
    when not_known(is_refunding_bond(b));
    then excluded_from_private_activity_bond_for_57(b);
}

@source(IRC_S57_A, relation = formalizes, coverage = exact, quote = "The preceding sentence shall not apply to any refunding bond unless such preceding sentence applied to the refunded bond (or in the case of a series of refundings, the original bond).")
rule PabExceptionCertainHousingRefundingBond(b: BondIssue, issued: Date) strict {
    label en official "clause (iii), last sentence: a refunding housing bond is excepted only if the exception applied to the refunded (or original) bond";
    when is_certain_housing_bond(b);
    when bond_issue_date(b, issued);
    when issued > @2008-07-30;
    when is_refunding_bond(b);
    when refunding_bond_excluded_under_iii_needs_refunded_bond_excluded(b);
    then excluded_from_private_activity_bond_for_57(b);
}

@source(IRC_S57_A, relation = formalizes, coverage = exact, quote = "For purposes of clause (i), the term \"private activity bond\" shall not include any refunding bond (whether a current or advance refunding) if the refunded bond (or in the case of a series of refundings, the original bond) was issued before August 8, 1986.")
rule PabExceptionRefundingOfPre1986Bond(b: BondIssue, original: Date) strict {
    label en official "section 57(a)(5)(C)(iv): a refunding bond whose refunded (or original) bond was issued before August 8, 1986";
    when is_refunding_bond(b);
    when original_bond_issue_date(b, original);
    when original < @1986-08-08;
    then excluded_from_private_activity_bond_for_57(b);
}

@source(IRC_S57_A, relation = formalizes, coverage = exact, quote = "the term \"private activity bond\" shall not include any bond issued after December 31, 2008, and before January 1, 2011.")
rule PabExceptionIssuedIn2009Or2010(b: BondIssue, treated_date: Date) strict {
    label en official "section 57(a)(5)(C)(vi)(I): a bond issued after December 31, 2008 and before January 1, 2011 (a refunding bond by the date rule of (II)/(III))";
    when bond_effective_issue_date_for_2009_2010_exception(b, treated_date);
    when treated_date > @2008-12-31;
    when treated_date < @2011-01-01;
    then excluded_from_private_activity_bond_for_57(b);
}

pub relation specified_private_activity_bond(b: BondIssue) kind institutional {
    label en official "the term \"specified private activity bond\" means any private activity bond issued after August 7, 1986, the interest on which is not includible in gross income under section 103";
}

@source(IRC_S57_A, relation = formalizes, coverage = exact, quote = "the term \"specified private activity bond\" means any private activity bond (as defined in section 141) which is issued after August 7, 1986, and the interest on which is not includible in gross income under section 103.")
rule SpecifiedPrivateActivityBondRule(b: BondIssue, issued: Date) strict {
    label en official "section 57(a)(5)(C)(i): a private activity bond issued after August 7, 1986 whose interest is excluded under section 103, other than a bond within the clause (ii)-(vi) exceptions";
    when is_private_activity_bond(b);
    when bond_issue_date(b, issued);
    when issued > @1986-08-07;
    when bond_interest_excluded_under_103(b);
    when not_known(excluded_from_private_activity_bond_for_57(b));
    when not_known(treated_as_issued_before_aug_8_1986(b));
    then specified_private_activity_bond(b);
}

pub relation bond_interest_received(p: Person, y: TaxableYear, b: BondIssue, amount: Money) kind empirical {
    label en official "the interest on the bond received or accrued by the taxpayer for the year";
}
pub relation deduction_allowable_if_interest_includible(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "any deduction (not allowable in computing the regular tax) which would have been allowable if such interest were includible in gross income";
}
pub relation specified_pab_interest_total(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the interest on all specified private activity bonds of the taxpayer for the year";
}
relation has_specified_pab_interest(p: Person, y: TaxableYear) kind institutional {
    label en unofficial "the taxpayer has interest on at least one specified private activity bond for the year";
}
rule HasSpecifiedPabInterest(p: Person, y: TaxableYear, b: BondIssue) strict {
    when bond_interest_received(p, y, b, _);
    when specified_private_activity_bond(b);
    then has_specified_pab_interest(p, y);
}
rule SpecifiedPabInterestTotalRule(p: Person, y: TaxableYear) strict {
    label en official "the interest is the sum over the specified private activity bonds";
    when has_specified_pab_interest(p, y);
    then specified_pab_interest_total(p, y, sum all amount: Money for b: BondIssue where bond_interest_received(p, y, b, amount) and specified_private_activity_bond(b));
}

@source(IRC_S57_A, relation = formalizes, coverage = exact, quote = "Interest on specified private activity bonds reduced by any deduction (not allowable in computing the regular tax) which would have been allowable if such interest were includible in gross income.")
rule AmtPreferencePrivateActivityBondInterestBeforeReassignment(p: Person, y: TaxableYear, interest: Money, deduction: Money) strict {
    label en official "section 57(a)(5)(A): interest on specified private activity bonds reduced by the deduction that would have been allowable had the interest been included in gross income (before the section 1(g)(7)(B)(iii) reassignment)";
    when noncorporate_taxpayer_for_year(p, y);
    when specified_pab_interest_total(p, y, interest);
    when deduction_allowable_if_interest_includible(p, y, deduction);
    then pab_preference_before_reassignment(p, y, interest - deduction);
}
pub relation pab_preference_before_reassignment(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 57(a)(5) item of tax preference of the taxpayer before section 1(g)(7)(B)(iii) reassigns a child's item to the parent";
}
@source(IRC_S57_A, relation = formalizes, coverage = exact, quote = "Interest on specified private activity bonds reduced by any deduction (not allowable in computing the regular tax) which would have been allowable if such interest were includible in gross income.")
rule AmtPreferencePrivateActivityBondInterest(p: Person, y: TaxableYear, amount: Money) strict {
    label en official "section 57(a)(5)(A): the item of tax preference, unless section 1(g)(7)(B)(iii) treats it as the parent's item";
    when pab_preference_before_reassignment(p, y, amount);
    when not_known(g7_election_covers_child(p, y));
    then amt_preference(p, y, PrivateActivityBondInterest57a5, amount);
}

// --- Section 57(a)(7): exclusion for gains on sale of certain small business stock

entity SmallBusinessStock {
    label en unofficial "stock whose gain the taxpayer excludes under section 1202";
}
pub relation section_1202_excluded_amount(p: Person, y: TaxableYear, s: SmallBusinessStock, amount: Money) kind empirical {
    label en official "the amount excluded from gross income for the taxable year under section 1202 on the stock";
}
pub relation stock_acquisition_date(s: SmallBusinessStock, on: Date) kind empirical {
    label en official "the date the stock was acquired";
}
relation pre_act_stock_exclusion(p: Person, y: TaxableYear, s: SmallBusinessStock, amount: Money) kind institutional {
    label en unofficial "the section 1202 exclusion on stock acquired on or before the enactment date of the Creating Small Business Jobs Act of 2010";
}

// "The date of the enactment of the Creating Small Business Jobs Act of 2010"
// is not in the text of section 57. It is September 27, 2010: pinned in the
// statutory note of section 1202 (Pub. L. 111-240, title II, section 2011(c),
// "[Sept. 27, 2010]"), which lies in the sources of `us.irc.property_transactions`,
// not in this package's own projection (coverage note of 26/57/a/7).
@source(IRC_S57_A, relation = formalizes, coverage = exact, quote = "An amount equal to 7 percent of the amount excluded from gross income for the taxable year under section 1202.")
rule PreActStockExclusionRule(p: Person, y: TaxableYear, s: SmallBusinessStock, amount: Money, acquired: Date) strict {
    label en official "stock acquired on or before September 27, 2010";
    when section_1202_excluded_amount(p, y, s, amount);
    when stock_acquisition_date(s, acquired);
    when acquired <= @2010-09-27;
    then pre_act_stock_exclusion(p, y, s, amount);
}
relation has_pre_2011_stock_exclusion(p: Person, y: TaxableYear) kind institutional {
    label en unofficial "the taxpayer excluded gain under section 1202 on stock acquired on or before September 27, 2010";
}
rule HasPre2011StockExclusion(p: Person, y: TaxableYear) strict {
    when pre_act_stock_exclusion(p, y, _, _);
    then has_pre_2011_stock_exclusion(p, y);
}

@source(IRC_S57_A, relation = formalizes, coverage = exact, quote = "An amount equal to 7 percent of the amount excluded from gross income for the taxable year under section 1202.")
rule AmtPreferenceSmallBusinessStock(p: Person, y: TaxableYear) strict {
    label en official "section 57(a)(7), as amended by Pub. L. 119-21 section 70431(a)(4)(A) (taking effect as if included in section 2011 of the Creating Small Business Jobs Act of 2010): 7 percent of the section 1202 exclusion, only for stock acquired on or before that Act's enactment date";
    when noncorporate_taxpayer_for_year(p, y);
    when has_pre_2011_stock_exclusion(p, y);
    then amt_preference(p, y, SmallBusinessStock57a7, (sum all amount: Money for s: SmallBusinessStock where pre_act_stock_exclusion(p, y, s, amount)) * 0.07);
}
