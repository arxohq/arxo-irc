// Section 1(j)(5): the maximum zero rate amount and the maximum 15-percent
// rate amount that replace the "taxed at a rate below 25 (39.6) percent"
// tests of section 1(h)(1)(B)(i) and (C)(ii)(I) for taxable years beginning
// after 2017 (stage 3, TECH_GAP reduction, 26.09.2026).
//
// AMOUNTS. Nine A3 parameter datasets (`1j5-*.lawparam.json`), one per
// amount and filing status: the statutory figure for 2018 and the published
// figures of Rev. Proc. 2024-40 section 2.03 (2025) and Rev. Proc. 2025-32
// section 4.03 (2026). Other years are MISSING_PARAMETER_VALUE. The
// section 1(j)(5)(C) INDEXING (base year 2017, increase rounded down to a
// multiple of $50) is the mechanism of `60-cost-of-living-adjustment.law`; the
// statutory amounts and the requests for their adjustment are below, and the
// answer `section_1j5_indexed_amount` needs C-CPI-U facts, which are not
// pinned.
//
// TEMPORAL STRUCTURE. The 2024-Edition text of section 1(j)(1) applies to
// taxable years beginning after 2017 and before 2026; Pub. L. 119-21 section
// 70101(a) removes the end date for years beginning after December 31, 2025
// (fragment PL119_21_S70101 of us.irc.temporal). The window of every rule here
// is therefore [2018-01-01, infinity), as in `rates.law` where the same
// amendment is carried as two windows.

use self::{
    FilingStatus,
    IRC_S1_J,
    Person,
    TaxableYear,
    amount_to_index,
    cola_adjusted_amount,
    filing_status,
    taxable_income,
    taxable_income_taxed_below_25_percent,
    taxable_income_taxed_below_39_6_percent,
};

pub relation max_zero_rate_amount(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the maximum zero rate amount (section 1(j)(5)(B)(i)) for the filing status of the taxpayer";
}
pub relation max_15_percent_rate_amount(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the maximum 15-percent rate amount (section 1(j)(5)(B)(ii)) for the filing status of the taxpayer";
}

@source(IRC_S1_J, relation = formalizes, coverage = exact, quote = "(I) in the case of a joint return or surviving spouse, $77,200,")
rule MaxZeroRateAmountJoint(p: Person, y: TaxableYear) strict {
    label en official "section 1(j)(5)(B)(i)(I): joint return or surviving spouse";
    effective [@2018-01-01, infinity);
    when filing_status(p, y, Joint);
    then max_zero_rate_amount(p, y, MaxZeroJoint);
}
@source(IRC_S1_J, relation = formalizes, coverage = exact, quote = "(II) in the case of an individual who is a head of household (as defined in section 2(b)), $51,700,")
rule MaxZeroRateAmountHeadOfHousehold(p: Person, y: TaxableYear) strict {
    label en official "section 1(j)(5)(B)(i)(II): head of household";
    effective [@2018-01-01, infinity);
    when filing_status(p, y, HeadOfHousehold);
    then max_zero_rate_amount(p, y, MaxZeroHoh);
}
@source(IRC_S1_J, relation = formalizes, coverage = exact, quote = "(III) in the case of any other individual (other than an estate or trust), an amount equal to ½ of the amount in effect for the taxable year under subclause (I), and")
rule MaxZeroRateAmountOtherUnmarried(p: Person, y: TaxableYear) strict {
    label en official "section 1(j)(5)(B)(i)(III): any other individual (unmarried)";
    effective [@2018-01-01, infinity);
    when filing_status(p, y, Unmarried);
    then max_zero_rate_amount(p, y, MaxZeroOther);
}
@source(IRC_S1_J, relation = formalizes, coverage = exact, quote = "(III) in the case of any other individual (other than an estate or trust), an amount equal to ½ of the amount in effect for the taxable year under subclause (I), and")
rule MaxZeroRateAmountOtherSeparate(p: Person, y: TaxableYear) strict {
    label en official "section 1(j)(5)(B)(i)(III): a married individual filing separately is any other individual";
    effective [@2018-01-01, infinity);
    when filing_status(p, y, MarriedSeparate);
    then max_zero_rate_amount(p, y, MaxZeroOther);
}
@source(IRC_S1_J, relation = formalizes, coverage = exact, quote = "(IV) in the case of an estate or trust, $2,600.")
rule MaxZeroRateAmountEstateTrust(p: Person, y: TaxableYear) strict {
    label en official "section 1(j)(5)(B)(i)(IV): estate or trust";
    effective [@2018-01-01, infinity);
    when filing_status(p, y, EstateOrTrust);
    then max_zero_rate_amount(p, y, MaxZeroEstateTrust);
}

@source(IRC_S1_J, relation = formalizes, coverage = exact, quote = "(I) in the case of a joint return or surviving spouse, $479,000 (½ such amount in the case of a married individual filing a separate return),")
rule Max15RateAmountJoint(p: Person, y: TaxableYear) strict {
    label en official "section 1(j)(5)(B)(ii)(I): joint return or surviving spouse";
    effective [@2018-01-01, infinity);
    when filing_status(p, y, Joint);
    then max_15_percent_rate_amount(p, y, Max15Joint);
}
@source(IRC_S1_J, relation = formalizes, coverage = exact, quote = "(I) in the case of a joint return or surviving spouse, $479,000 (½ such amount in the case of a married individual filing a separate return),")
rule Max15RateAmountSeparate(p: Person, y: TaxableYear) strict {
    label en official "section 1(j)(5)(B)(ii)(I): one half of the joint amount for a married individual filing a separate return";
    effective [@2018-01-01, infinity);
    when filing_status(p, y, MarriedSeparate);
    then max_15_percent_rate_amount(p, y, Max15Separate);
}
@source(IRC_S1_J, relation = formalizes, coverage = exact, quote = "(II) in the case of an individual who is the head of a household (as defined in section 2(b)), $452,400,")
rule Max15RateAmountHeadOfHousehold(p: Person, y: TaxableYear) strict {
    label en official "section 1(j)(5)(B)(ii)(II): head of household";
    effective [@2018-01-01, infinity);
    when filing_status(p, y, HeadOfHousehold);
    then max_15_percent_rate_amount(p, y, Max15Hoh);
}
@source(IRC_S1_J, relation = formalizes, coverage = exact, quote = "(III) in the case of any other individual (other than an estate or trust), $425,800, and")
rule Max15RateAmountOther(p: Person, y: TaxableYear) strict {
    label en official "section 1(j)(5)(B)(ii)(III): any other individual (unmarried)";
    effective [@2018-01-01, infinity);
    when filing_status(p, y, Unmarried);
    then max_15_percent_rate_amount(p, y, Max15Other);
}
@source(IRC_S1_J, relation = formalizes, coverage = exact, quote = "(IV) in the case of an estate or trust, $12,700.")
rule Max15RateAmountEstateTrust(p: Person, y: TaxableYear) strict {
    label en official "section 1(j)(5)(B)(ii)(IV): estate or trust";
    effective [@2018-01-01, infinity);
    when filing_status(p, y, EstateOrTrust);
    then max_15_percent_rate_amount(p, y, Max15EstateTrust);
}

// --- Section 1(j)(5)(A): the substituted tests of section 1(h)(1) --------------
//
// `capital-gains.law` declares `taxable_income_taxed_below_25_percent` and
// `..._39_6_percent` as dependency contracts read by (h)(1)(B)(i) and
// (C)(ii)(I). For the years to which (j) applies the text of those clauses is
// changed, so the two amounts are the taxable income below the maximum zero
// rate amount and below the maximum 15-percent rate amount.

@source(IRC_S1_J, relation = formalizes, coverage = exact, quote = "(i) by substituting \"below the maximum zero rate amount\" for \"which would (without regard to this paragraph) be taxed at a rate below 25 percent\" in subparagraph (B)(i), and")
rule TaxableIncomeBelowMaximumZeroRateAmount(p: Person, y: TaxableYear, ti: Money, limit: Money) strict {
    label en official "section 1(j)(5)(A)(i): the amount of taxable income below the maximum zero rate amount stands for the amount taxed below 25 percent";
    effective [@2018-01-01, infinity);
    when taxable_income(p, y, ti);
    when max_zero_rate_amount(p, y, limit);
    then taxable_income_taxed_below_25_percent(p, y, min(ti, limit));
}
@source(IRC_S1_J, relation = formalizes, coverage = exact, quote = "(ii) by substituting \"below the maximum 15-percent rate amount\" for \"which would (without regard to this paragraph) be taxed at a rate below 39.6 percent\" in subparagraph (C)(ii)(I).")
rule TaxableIncomeBelowMaximum15PercentRateAmount(p: Person, y: TaxableYear, ti: Money, limit: Money) strict {
    label en official "section 1(j)(5)(A)(ii): the amount of taxable income below the maximum 15-percent rate amount stands for the amount taxed below 39.6 percent";
    effective [@2018-01-01, infinity);
    when taxable_income(p, y, ti);
    when max_15_percent_rate_amount(p, y, limit);
    then taxable_income_taxed_below_39_6_percent(p, y, min(ti, limit));
}

// --- Section 1(j)(5)(C): the inflation adjustment by the Code's own mechanism ---

pub enum Section1j5Amount {
    ZeroRateJoint;
    ZeroRateHeadOfHousehold;
    ZeroRateEstateTrust;
    Rate15Joint;
    Rate15HeadOfHousehold;
    Rate15Other;
    Rate15EstateTrust;
}

pub relation section_1j5_statutory_amount(k: Section1j5Amount, amount: Money) kind institutional {
    label en official "the dollar amount of section 1(j)(5)(B)(i)-(ii) before the inflation adjustment (the amounts in subclauses derived as one half are computed from these)";
}
pub relation section_1j5_indexed_amount(k: Section1j5Amount, y: TaxableYear, amount: Money) kind institutional {
    label en official "the dollar amount of section 1(j)(5)(B) increased for a taxable year beginning after 2018 by the cost-of-living adjustment of section 1(f)(3) with 2017 substituted for 2016, the increase rounded down to a multiple of $50";
}

@source(IRC_S1_J, relation = formalizes, coverage = partial, quote = "(I) in the case of a joint return or surviving spouse, $77,200,")
rule Statutory1j5ZeroRateJoint() strict { then section_1j5_statutory_amount(ZeroRateJoint, 77200 USD); }
@source(IRC_S1_J, relation = formalizes, coverage = partial, quote = "(II) in the case of an individual who is a head of household (as defined in section 2(b)), $51,700,")
rule Statutory1j5ZeroRateHoh() strict { then section_1j5_statutory_amount(ZeroRateHeadOfHousehold, 51700 USD); }
@source(IRC_S1_J, relation = formalizes, coverage = partial, quote = "(IV) in the case of an estate or trust, $2,600.")
rule Statutory1j5ZeroRateEstateTrust() strict { then section_1j5_statutory_amount(ZeroRateEstateTrust, 2600 USD); }
@source(IRC_S1_J, relation = formalizes, coverage = partial, quote = "(I) in the case of a joint return or surviving spouse, $479,000 (½ such amount in the case of a married individual filing a separate return),")
rule Statutory1j5Rate15Joint() strict { then section_1j5_statutory_amount(Rate15Joint, 479000 USD); }
@source(IRC_S1_J, relation = formalizes, coverage = partial, quote = "(II) in the case of an individual who is the head of a household (as defined in section 2(b)), $452,400,")
rule Statutory1j5Rate15Hoh() strict { then section_1j5_statutory_amount(Rate15HeadOfHousehold, 452400 USD); }
@source(IRC_S1_J, relation = formalizes, coverage = partial, quote = "(III) in the case of any other individual (other than an estate or trust), $425,800, and")
rule Statutory1j5Rate15Other() strict { then section_1j5_statutory_amount(Rate15Other, 425800 USD); }
@source(IRC_S1_J, relation = formalizes, coverage = partial, quote = "(IV) in the case of an estate or trust, $12,700.")
rule Statutory1j5Rate15EstateTrust() strict { then section_1j5_statutory_amount(Rate15EstateTrust, 12700 USD); }

@source(IRC_S1_J, relation = formalizes, coverage = exact, quote = "In the case of any taxable year beginning after 2018, each of the dollar amounts in clauses (i) and (ii) of subparagraph (B) shall be increased by an amount equal to—")
rule RequestSection1j5Indexing(k: Section1j5Amount, base: Money, y: TaxableYear, cy: Integer) strict {
    label en official "section 1(j)(5)(C): each statutory amount of (B) is to be increased for a taxable year beginning after 2018";
    when section_1j5_statutory_amount(k, base);
    when us.irc.core::calendar_year_of(y, cy);
    when cy > 2018;
    then amount_to_index(base, 2017, y, 50);
}
@source(IRC_S1_J, relation = formalizes, coverage = exact, quote = "the cost-of-living adjustment determined under subsection (f)(3) for the calendar year in which the taxable year begins, determined by substituting \"calendar year 2017\" for \"calendar year 2016\" in subparagraph (A)(ii) thereof.")
rule Section1j5IndexedAmount(k: Section1j5Amount, base: Money, y: TaxableYear, adjusted: Money) strict {
    label en official "section 1(j)(5)(C): amount + amount x COLA (base year 2017), the increase rounded down to a multiple of $50";
    when section_1j5_statutory_amount(k, base);
    when cola_adjusted_amount(base, 2017, y, 50, adjusted);
    then section_1j5_indexed_amount(k, y, adjusted);
}
