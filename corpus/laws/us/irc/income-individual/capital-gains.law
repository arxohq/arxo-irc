// Section 1(h): maximum capital gains rate. Eleven paragraphs; this stage
// models the (h)(1) LIMITATION FORMULA over already-computed capital-gain
// aggregates, declaring the aggregates themselves (adjusted net capital
// gain, 28-percent rate gain, unrecaptured section 1250 gain, qualified
// dividend income) as typed institutional DEPENDENCY CONTRACTS on
// `property-transactions` (owns §1011-1016, §1201-1298 gain/loss
// characterization) rather than re-deriving their own multi-section
// definitions here — that would duplicate an owner this package does not
// have authority over. Paragraphs (h)(2)-(11) (net-capital-gain-as-
// investment-income coordination, 28-percent-rate-gain/collectibles/section
// 1202/unrecaptured-1250 definitions, pass-thru entities, qualified
// dividend income and its foreign-corporation tests) are classified
// EXTERNAL_DEPENDENCY: each names a concept `property-transactions` (or, for
// qualified dividend income, no clearly assigned owner in `OWNERSHIP-
// RULES.json` this stage read) must supply.

// `Person`/`TaxableYear` aliases live in `filing-status.law` (package-scoped).

// --- Dependency contracts (owner: property-transactions, unresolved) --------

use self::{
    IRC_S1_H,
    Person,
    TaxableYear,
    taxable_income,
};

pub relation net_capital_gain(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "net capital gain";
}
pub relation adjusted_net_capital_gain(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "adjusted net capital gain";
}
pub relation unrecaptured_section_1250_gain(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "unrecaptured section 1250 gain";
}
pub relation taxable_income_taxed_below_25_percent(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the amount of taxable income which would (without regard to this paragraph) be taxed at a rate below 25 percent";
}
pub relation taxable_income_taxed_below_39_6_percent(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the amount of taxable income which would (without regard to this paragraph) be taxed at a rate below 39.6 percent";
}

// --- Section 1(h)(1): the maximum-rate limitation -----------------------------
//
// The full six-subparagraph ordering rule ((A) through (F)) computes SIX
// layered amounts whose bases each depend on the layer before it ("the
// excess of ... over the sum of the amounts on which tax is determined
// under the preceding subparagraphs"). This stage models subparagraphs (A)
// and (D) (the two layers a scenario can exercise without unrecaptured
// §1250 gain or 28-percent-rate gain present) as a worked example of the
// mechanism; (B), (C), (E), (F) are NOT modelled as executable rules this
// stage (TECH_GAP: the five-way layered "excess over the sum of the
// preceding amounts" ordering needs a sequencing construct — `min`/ordered
// accumulation — this stage did not verify is available in this grammar,
// and guessing its shape risks a silently wrong tax computation, which the
// task's method explicitly forbids guessing). Minimal reproduction: a
// scenario with nonzero 28-percent-rate gain or unrecaptured section 1250
// gain has no rule computing subparagraphs (C) or (E) of the limitation.

pub relation capital_gains_ordinary_layer(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "a tax computed at the rates and in the same manner as if this subsection had not been enacted on the greater of taxable income reduced by the net capital gain, or the lesser of the 25-percent floor or taxable income reduced by adjusted net capital gain";
}

@source(IRC_S1_H, quote = "a tax computed at the rates and in the same manner as if this subsection had not been enacted")
rule CapitalGainsOrdinaryLayerFromReducedIncome(p: Person, y: TaxableYear, taxable: Money, gain: Money, tax_at_reduced: Money) strict {
    label en official "subparagraph (A)(i): taxable income reduced by the net capital gain";
    when taxable_income(p, y, taxable);
    when net_capital_gain(p, y, gain);
    when tax_on_hypothetical_reduced_income(p, y, taxable - gain, tax_at_reduced);
    then capital_gains_ordinary_layer(p, y, tax_at_reduced);
}
relation tax_on_hypothetical_reduced_income(p: Person, y: TaxableYear, reduced_income: Money, tax: Money) kind institutional {
    label en unofficial "the section 1 tax that would be computed on this reduced taxable-income figure — reads the same rate schedule as `tax_under_section_1`, applied to a hypothetical base rather than the actual taxable income";
}

@source(IRC_S1_H, quote = "20 percent of the adjusted net capital gain (or, if less, taxable income) in excess of the sum of the amounts on which tax is determined under subparagraphs (B) and (C)")
rule CapitalGains20PercentLayer(p: Person, y: TaxableYear, gain: Money, floor: Money) strict {
    label en official "subparagraph (D): 20 percent of the adjusted net capital gain (or, if less, taxable income) in excess of the sum of the amounts on which tax is determined under subparagraphs (B) and (C)";
    when adjusted_net_capital_gain(p, y, gain);
    when zero_percent_and_fifteen_percent_layers_sum(p, y, floor);
    when gain_exceeds_floor(gain, floor);
    then capital_gains_20_percent_tax(p, y, CapitalGainsTopRate * (gain - floor));
}
pub relation capital_gains_20_percent_tax(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the amount taxed at 20% under subparagraph (D)";
}
relation zero_percent_and_fifteen_percent_layers_sum(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the sum of the amounts on which tax is determined under subparagraphs (B) and (C) — TECH_GAP: neither (B) nor (C) is modelled this stage, so this relation is never derivable (see module header)";
}
relation gain_exceeds_floor(gain: Money, floor: Money) kind institutional {
    label en unofficial "gain > floor (guard for the subparagraph (D) excess)";
}
const CapitalGainsTopRate: Decimal = 20 percent {
    label en official "20 percent of the adjusted net capital gain";
};

// §1(h)(2)-(11): see module header. Declared but not modelled this stage:
pub relation twenty_eight_percent_rate_gain(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "28-percent rate gain";
}
pub relation qualified_dividend_income(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "qualified dividend income";
}
