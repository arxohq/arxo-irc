// Section 56(a)(1)-(3), (5), (6) and (b)(2): the depreciation, amortization,
// long-term contract and adjusted-basis adjustments (stage 3, TECH_GAP
// reduction, 26.09.2026).
//
// WHAT CHANGED FROM STAGE 2. Stage 2 accepted the net of each of these
// adjustments through `amt_adjustment_supplied`. This module states the
// rules the paragraphs contain: which property is subject to which method,
// the ratable amortization periods (3 and 10 years), the loss deduction, the
// long-term contract exception and its Pub. L. 119-21 amendment, the
// adjusted basis on the alternative treatment. The AMOUNTS that another
// owner computes (the deduction under the alternative depreciation system of
// section 168(g), under the 150-percent declining balance method, the
// section 165(a) amount, the percentage-of-completion income of section 460)
// are facts of the case, named in `amt_method_depreciation_deduction` and its
// siblings (EXTERNAL_DEPENDENCY: `us.irc.accounting`, §§167-169, 460).
//
// THE TWO CHANNELS ARE ALTERNATIVES. The new adjustment kinds
// (`DepreciationByProperty56a1`, ...) are DERIVED here from per-property
// facts. A case that already supplies a net figure for the old kind
// (`Depreciation56a1`, `MiningCosts56a2`, `LongTermContracts56a3`,
// `PollutionControl56a5`, `CirculationAndResearch56b2`) must not also supply
// the per-property facts: the two kinds are summed.
//
// SIMPLIFICATIONS (each one recorded in the coverage row): (1) the
// amortization year offset is the difference of calendar-year numbers, so it
// reads only taxable years that are calendar years (`calendar_year_of`);
// (2) "ratably" is the expenditure divided by the number of years, cents
// rounded HALF_UP (JUDGMENT CALL: the statute names no rounding); the
// unamortized balance is computed from the same fraction, not from the
// rounded instalments, so the balance never drifts.

use self::{
    AmtAdjustmentKind,
    IRC_S56_A,
    IRC_S56_B,
    Person,
    TaxableYear,
    amt_adjustment,
    noncorporate_taxpayer_for_year,
};

entity AmtDepreciableProperty {
    label en unofficial "tangible property whose depreciation deduction is determined for the alternative minimum tax under section 56(a)(1), or a certified pollution control facility under section 56(a)(5)";
}
entity AmortizedExpenditure {
    label en unofficial "an expenditure (section 616 or 617 mining cost, section 173 circulation expenditure, section 174 or 174A research or experimental expenditure) that section 56(a)(2) or (b)(2) capitalizes and amortizes";
}
entity LongTermContract {
    label en unofficial "a long-term contract of the taxpayer (section 460(f))";
}

pub enum AmtDepreciationMethod {
    AlternativeDepreciationSystem168g;
    DecliningBalance150SwitchingToStraightLine;
    StraightLineMethod;
}
pub enum AmortizedExpenditureKind {
    MiningExploration;
    Circulation173;
    ResearchExperimental174;
    DomesticResearch174A;
}
pub enum AmortizationProvision {
    Section56a2;
    Section56b2;
}

// --- Section 56(a)(1): the method by property -------------------------------------

pub relation property_placed_in_service_on(prop: AmtDepreciableProperty, d: Date) kind empirical {
    label en official "the date the tangible property was placed in service";
}
pub relation property_of_taxpayer(prop: AmtDepreciableProperty, p: Person) kind empirical {
    label en unofficial "the property belongs to the taxpayer for the alternative minimum tax";
}
pub relation property_is_section_1250_property(prop: AmtDepreciableProperty) kind empirical {
    label en official "section 1250 property (as defined in section 1250(c))";
}
pub relation regular_depreciation_is_straight_line(prop: AmtDepreciableProperty) kind empirical {
    label en official "the depreciation deduction determined under section 168 for purposes of the regular tax is determined by using the straight line method";
}
pub relation property_described_in_168f_1_to_4_or_168e3Civ(prop: AmtDepreciableProperty) kind empirical {
    label en official "property described in paragraph (1), (2), (3), or (4) of section 168(f), or in section 168(e)(3)(C)(iv)";
}
pub relation excluded_by_tra_1986_transition_rules(prop: AmtDepreciableProperty) kind empirical {
    label en official "property placed in service after December 31, 1986, to which the amendments made by section 201 of the Tax Reform Act of 1986 do not apply by reason of section 203, 204, or 251(d) of such Act";
}
pub relation elected_under_tra_203a1B(prop: AmtDepreciableProperty) kind empirical {
    label en official "property placed in service before 1987 to which the amendments made by section 201 of the Tax Reform Act of 1986 apply by reason of an election under section 203(a)(1)(B) of such Act";
}
pub relation certified_pollution_control_facility(prop: AmtDepreciableProperty) kind empirical {
    label en official "a certified pollution control facility (section 169)";
}
pub relation regular_depreciation_deduction(p: Person, y: TaxableYear, prop: AmtDepreciableProperty, amount: Money) kind empirical {
    label en official "the depreciation deduction allowable under section 167 (or section 169 for a pollution control facility) in computing the regular tax";
}
pub relation amt_method_depreciation_deduction(p: Person, y: TaxableYear, prop: AmtDepreciableProperty, amount: Money) kind empirical {
    label en official "the deduction determined under the method section 56(a)(1) or (5) prescribes (EXTERNAL_DEPENDENCY: the schedule of section 168(g) or of the 150-percent declining balance method)";
}

pub relation section_56a1_applies_to_property(prop: AmtDepreciableProperty) kind institutional {
    label en official "paragraph (1) applies to the property: it is not excepted by subparagraph (B) or (C)(i)";
}
pub relation amt_depreciation_method(prop: AmtDepreciableProperty, m: AmtDepreciationMethod) kind institutional {
    label en official "the method by which the depreciation deduction for the alternative minimum tax is determined";
}

@source(IRC_S56_A, relation = formalizes, coverage = exact, quote = "This paragraph shall not apply to property described in paragraph (1), (2), (3), or (4) of section 168(f), or in section 168(e)(3)(C)(iv).")
rule Section56a1AppliesToProperty(prop: AmtDepreciableProperty) strict {
    label en official "section 56(a)(1)(B)-(C): paragraph (1) applies unless the property is excepted by (B) or by the transitional rules of (C)(i)";
    when property_placed_in_service_on(prop, _);
    when not_known(property_described_in_168f_1_to_4_or_168e3Civ(prop));
    when not_known(excluded_by_tra_1986_transition_rules(prop));
    then section_56a1_applies_to_property(prop);
}

@source(IRC_S56_A, relation = formalizes, coverage = exact, quote = "the depreciation deduction allowable under section 167 with respect to any tangible property placed in service after December 31, 1986, shall be determined under the alternative system of section 168(g).")
rule AmtMethodAlternativeSystemFor1987To1998(prop: AmtDepreciableProperty, d: Date) strict {
    label en official "section 56(a)(1)(A)(i): property placed in service after December 31, 1986 and not after December 31, 1998 is depreciated under the alternative system of section 168(g)";
    when section_56a1_applies_to_property(prop);
    when property_placed_in_service_on(prop, d);
    when d > @1986-12-31;
    when d <= @1998-12-31;
    then amt_depreciation_method(prop, AlternativeDepreciationSystem168g);
}
@source(IRC_S56_A, relation = formalizes, coverage = exact, quote = "This paragraph shall apply to any property to which the amendments made by section 201 of the Tax Reform Act of 1986 apply by reason of an election under section 203(a)(1)(B) of such Act without regard to the requirement of subparagraph (A) that the property be placed in service after December 31, 1986.")
rule AmtMethodAlternativeSystemForElectedPre1987(prop: AmtDepreciableProperty, d: Date) strict {
    label en official "section 56(a)(1)(C)(ii): electing pre-1987 property is treated as if placed in service after 1986";
    when section_56a1_applies_to_property(prop);
    when elected_under_tra_203a1B(prop);
    when property_placed_in_service_on(prop, d);
    when d <= @1986-12-31;
    then amt_depreciation_method(prop, AlternativeDepreciationSystem168g);
}
@source(IRC_S56_A, relation = formalizes, coverage = exact, quote = "The method of depreciation used shall be—")
rule AmtMethod150DecliningBalanceAfter1998(prop: AmtDepreciableProperty, d: Date) strict {
    label en official "section 56(a)(1)(A)(ii)(I)-(II): after 1998, the 150 percent declining balance method switching to straight line, except for section 1250 property and property whose regular method is straight line";
    when section_56a1_applies_to_property(prop);
    when property_placed_in_service_on(prop, d);
    when d > @1998-12-31;
    when not_known(property_is_section_1250_property(prop));
    when not_known(regular_depreciation_is_straight_line(prop));
    then amt_depreciation_method(prop, DecliningBalance150SwitchingToStraightLine);
}
@source(IRC_S56_A, relation = formalizes, coverage = exact, quote = "The preceding sentence shall not apply to any section 1250 property (as defined in section 1250(c)) (and the straight line method shall be used for such section 1250 property)")
rule AmtMethodStraightLineFor1250Property(prop: AmtDepreciableProperty, d: Date) strict {
    label en official "section 56(a)(1)(A)(ii): the straight line method is used for section 1250 property";
    when section_56a1_applies_to_property(prop);
    when property_placed_in_service_on(prop, d);
    when d > @1998-12-31;
    when property_is_section_1250_property(prop);
    then amt_depreciation_method(prop, StraightLineMethod);
}
@source(IRC_S56_A, relation = formalizes, coverage = exact, quote = "or to any other property if the depreciation deduction determined under section 168 with respect to such other property for purposes of the regular tax is determined by using the straight line method.")
rule AmtMethodStraightLineWhenRegularIsStraightLine(prop: AmtDepreciableProperty, d: Date) strict {
    label en official "section 56(a)(1)(A)(ii): the declining balance sentence does not apply where the regular deduction is straight line (the method is then the regular one)";
    when section_56a1_applies_to_property(prop);
    when property_placed_in_service_on(prop, d);
    when d > @1998-12-31;
    when regular_depreciation_is_straight_line(prop);
    then amt_depreciation_method(prop, StraightLineMethod);
}

// The difference of the two deductions, per property and in total.

pub relation depreciation_adjustment_of_property(p: Person, y: TaxableYear, prop: AmtDepreciableProperty, amount: Money) kind institutional {
    label en unofficial "the regular depreciation deduction less the deduction under the alternative treatment, for one property and year (positive: income increases)";
}
@source(IRC_S56_A, relation = formalizes, coverage = partial, quote = "In determining the amount of the alternative minimum taxable income for any taxable year the following treatment shall apply (in lieu of the treatment applicable for purposes of computing the regular tax):")
rule DepreciationAdjustmentOfProperty(p: Person, y: TaxableYear, prop: AmtDepreciableProperty, regular: Money, alt: Money, m: AmtDepreciationMethod) strict {
    label en official "section 56(a)(1): the AMT deduction replaces the regular deduction; the adjustment is the regular deduction less the AMT deduction";
    when property_of_taxpayer(prop, p);
    when not_known(certified_pollution_control_facility(prop));
    when amt_depreciation_method(prop, m);
    when regular_depreciation_deduction(p, y, prop, regular);
    when amt_method_depreciation_deduction(p, y, prop, alt);
    then depreciation_adjustment_of_property(p, y, prop, regular - alt);
}
pub relation has_property_depreciation_adjustment(p: Person, y: TaxableYear) kind institutional {
    label en unofficial "the taxpayer has at least one section 56(a)(1) or (5) property adjustment for the year";
}
rule HasPropertyDepreciationAdjustment(p: Person, y: TaxableYear, prop: AmtDepreciableProperty) strict {
    when depreciation_adjustment_of_property(p, y, prop, _);
    then has_property_depreciation_adjustment(p, y);
}
@source(IRC_S56_A, relation = formalizes, coverage = partial, quote = "the depreciation deduction allowable under section 167 with respect to any tangible property placed in service after December 31, 1986, shall be determined under the alternative system of section 168(g).")
rule AmtAdjustmentDepreciationByProperty(p: Person, y: TaxableYear) strict {
    label en official "section 56(a)(1): the sum of the per-property adjustments is the depreciation adjustment of the year";
    when has_property_depreciation_adjustment(p, y);
    then amt_adjustment(p, y, DepreciationByProperty56a1, sum all amount: Money for prop: AmtDepreciableProperty where depreciation_adjustment_of_property(p, y, prop, amount));
}

// --- Section 56(a)(5): certified pollution control facilities ----------------------

@source(IRC_S56_A, relation = formalizes, coverage = exact, quote = "In the case of any certified pollution control facility placed in service after December 31, 1986, the deduction allowable under section 169 (without regard to section 291) shall be determined under the alternative system of section 168(g).")
rule PollutionControlAlternativeSystem(prop: AmtDepreciableProperty, d: Date) strict {
    label en official "section 56(a)(5): a facility placed in service after 1986 and not after 1998 has its section 169 deduction determined under the alternative system of section 168(g)";
    when certified_pollution_control_facility(prop);
    when property_placed_in_service_on(prop, d);
    when d > @1986-12-31;
    when d <= @1998-12-31;
    then pollution_control_method(prop, AlternativeDepreciationSystem168g);
}
@source(IRC_S56_A, relation = formalizes, coverage = exact, quote = "In the case of such a facility placed in service after December 31, 1998, such deduction shall be determined under section 168 using the straight line method.")
rule PollutionControlStraightLineAfter1998(prop: AmtDepreciableProperty, d: Date) strict {
    label en official "section 56(a)(5): a facility placed in service after 1998 has its deduction determined under section 168 using the straight line method";
    when certified_pollution_control_facility(prop);
    when property_placed_in_service_on(prop, d);
    when d > @1998-12-31;
    then pollution_control_method(prop, StraightLineMethod);
}
pub relation pollution_control_method(prop: AmtDepreciableProperty, m: AmtDepreciationMethod) kind institutional {
    label en official "the method by which the section 169 deduction for a certified pollution control facility is determined for the alternative minimum tax";
}
pub relation pollution_control_adjustment_of_facility(p: Person, y: TaxableYear, prop: AmtDepreciableProperty, amount: Money) kind institutional {
    label en unofficial "the regular section 169 deduction less the deduction under paragraph (5), for one facility and year";
}
@source(IRC_S56_A, relation = formalizes, coverage = partial, quote = "In the case of any certified pollution control facility placed in service after December 31, 1986, the deduction allowable under section 169 (without regard to section 291) shall be determined under the alternative system of section 168(g).")
rule PollutionControlAdjustmentOfFacility(p: Person, y: TaxableYear, prop: AmtDepreciableProperty, regular: Money, alt: Money, m: AmtDepreciationMethod) strict {
    label en official "section 56(a)(5): the adjustment is the regular section 169 deduction less the deduction on the alternative treatment";
    when property_of_taxpayer(prop, p);
    when pollution_control_method(prop, m);
    when regular_depreciation_deduction(p, y, prop, regular);
    when amt_method_depreciation_deduction(p, y, prop, alt);
    then pollution_control_adjustment_of_facility(p, y, prop, regular - alt);
}
pub relation has_pollution_control_adjustment(p: Person, y: TaxableYear) kind institutional {
    label en unofficial "the taxpayer has at least one pollution control facility adjustment for the year";
}
rule HasPollutionControlAdjustment(p: Person, y: TaxableYear, prop: AmtDepreciableProperty) strict {
    when pollution_control_adjustment_of_facility(p, y, prop, _);
    then has_pollution_control_adjustment(p, y);
}
@source(IRC_S56_A, relation = formalizes, coverage = partial, quote = "In the case of any certified pollution control facility placed in service after December 31, 1986, the deduction allowable under section 169 (without regard to section 291) shall be determined under the alternative system of section 168(g).")
rule AmtAdjustmentPollutionControlByFacility(p: Person, y: TaxableYear) strict {
    label en official "section 56(a)(5): the sum of the per-facility adjustments";
    when has_pollution_control_adjustment(p, y);
    then amt_adjustment(p, y, PollutionControlByFacility56a5, sum all amount: Money for prop: AmtDepreciableProperty where pollution_control_adjustment_of_facility(p, y, prop, amount));
}

// --- Section 56(a)(6): adjusted basis --------------------------------------------

pub relation basis_before_depreciation(prop: AmtDepreciableProperty, amount: Money) kind empirical {
    label en official "the basis of the property before any depreciation deduction, as the case supplies it (EXTERNAL_DEPENDENCY: sections 1011-1016)";
}
pub relation taxable_year_precedes(earlier: TaxableYear, later: TaxableYear) kind institutional {
    label en unofficial "the earlier taxable year begins before the later one";
}
rule TaxableYearPrecedesRule(earlier: TaxableYear, later: TaxableYear, d1: Date, d2: Date) strict {
    when us.irc.core::begins(earlier, d1);
    when us.irc.core::begins(later, d2);
    when d1 < d2;
    then taxable_year_precedes(earlier, later);
}
pub relation amt_adjusted_basis(p: Person, y: TaxableYear, prop: AmtDepreciableProperty, basis: Money) kind institutional {
    label en official "the adjusted basis at the beginning of the year, determined on the basis of the treatment prescribed in paragraph (1) or (5): the basis before depreciation less the deductions of earlier years under that treatment";
}
@source(IRC_S56_A, relation = formalizes, coverage = partial, quote = "The adjusted basis of any property to which paragraph (1) or (5) applies (or with respect to which there are any expenditures to which paragraph (2) or subsection (b)(2) applies) shall be determined on the basis of the treatment prescribed in paragraph (1), (2), or (5), or subsection (b)(2), whichever applies.")
rule AmtAdjustedBasisOfProperty(p: Person, y: TaxableYear, prop: AmtDepreciableProperty, cost: Money) strict {
    label en official "section 56(a)(6): the basis is reduced by the deductions of the earlier years determined under the alternative treatment (simplification: only depreciation and section 169 deductions reduce it; other basis adjustments belong to sections 1011-1016)";
    when property_of_taxpayer(prop, p);
    when basis_before_depreciation(prop, cost);
    when us.irc.core::begins(y, _);
    then amt_adjusted_basis(p, y, prop, cost - sum(collect all a: Money, y2: TaxableYear where taxable_year_precedes(y2, y) and amt_method_depreciation_deduction(p, y2, prop, a), empty: 0.00 USD));
}

// --- Section 56(a)(2) and (b)(2): ratable amortization ------------------------------

pub relation amortized_expenditure_of(e: AmortizedExpenditure, p: Person) kind empirical {
    label en unofficial "the expenditure is the taxpayer's";
}
pub relation amortized_expenditure_kind(e: AmortizedExpenditure, k: AmortizedExpenditureKind) kind empirical {
    label en official "which provision's expenditure it is: a mining cost of section 616(a) or 617(a), a circulation expenditure of section 173, research or experimental expenditure of section 174(a) or 174A(a)";
}
pub relation amortized_expenditure_amount(e: AmortizedExpenditure, amount: Money) kind empirical {
    label en official "the amount allowable as a deduction in computing the regular tax (for mining costs determined without regard to section 291(b))";
}
pub relation expenditure_made_in_year(e: AmortizedExpenditure, y0: TaxableYear) kind empirical {
    label en official "the taxable year in which the expenditures were made";
}
pub relation expenditure_paid_after_1986(e: AmortizedExpenditure) kind empirical {
    label en official "paid or incurred after December 31, 1986";
}
pub relation expenditure_for_oil_gas_or_geothermal_well(e: AmortizedExpenditure) kind empirical {
    label en official "the expenditure is for an oil, gas, or geothermal well";
}
pub relation taxpayer_materially_participates_in_activity_of(e: AmortizedExpenditure) kind empirical {
    label en official "the taxpayer materially participates (within the meaning of section 469(h)) in the activity in connection with which the expenditure was paid or incurred";
}
pub relation regular_deduction_of_expenditure(p: Person, y: TaxableYear, e: AmortizedExpenditure, amount: Money) kind empirical {
    label en official "the amount of the expenditure deducted in the taxable year in computing the regular tax";
}
pub relation loss_sustained_in_year(e: AmortizedExpenditure, yl: TaxableYear) kind empirical {
    label en official "a loss is sustained with respect to the property in the taxable year";
}
pub relation section_165a_amount_if_capitalized(e: AmortizedExpenditure, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount allowable under section 165(a) for the expenditures if they had remained capitalized";
}

pub relation amortization_provision_of(k: AmortizedExpenditureKind, prov: AmortizationProvision) kind institutional {
    label en unofficial "the paragraph that amortizes expenditures of this kind";
}
pub relation amortization_period_years(k: AmortizedExpenditureKind, years: Integer) kind institutional {
    label en official "the ratable amortization period in years, beginning with the taxable year in which the expenditures were made";
}
@source(IRC_S56_A, relation = formalizes, coverage = exact, quote = "shall be capitalized and amortized ratably over the 10-year period beginning with the taxable year in which the expenditures were made.")
rule MiningPeriodTenYears() strict {
    label en official "section 56(a)(2)(A): 10-year period";
    then amortization_period_years(MiningExploration, 10);
}
@source(IRC_S56_B, relation = formalizes, coverage = exact, quote = "in the case of circulation expenditures described in section 173, shall be amortized ratably over the 3-year period beginning with the taxable year in which the expenditures were made, or")
rule CirculationPeriodThreeYears() strict {
    label en official "section 56(b)(2)(A)(i): 3-year period";
    then amortization_period_years(Circulation173, 3);
}
@source(IRC_S56_B, relation = formalizes, coverage = exact, quote = "in the case of research and experimental expenditures described in section 174(a), shall be amortized ratably over the 10-year period beginning with the taxable year in which the expenditures were made.")
rule ResearchPeriodTenYears() strict {
    label en official "section 56(b)(2)(A)(ii): 10-year period";
    then amortization_period_years(ResearchExperimental174, 10);
}
@source(us.irc.temporal::PL119_21_S70302, relation = formalizes, coverage = exact, quote = "and domestic research or experimental expenditures in section 174A(a)")
rule DomesticResearchPeriodTenYears() strict {
    label en official "Pub. L. 119-21 section 70302(b)(3)(A)(ii): domestic research or experimental expenditures in section 174A(a) are amortized over the same 10-year period (amounts paid or incurred in taxable years beginning after December 31, 2024)";
    effective [@2025-07-04, infinity);
    then amortization_period_years(DomesticResearch174A, 10);
}
rule ProvisionOfMining() strict { then amortization_provision_of(MiningExploration, Section56a2); }
rule ProvisionOfCirculation() strict { then amortization_provision_of(Circulation173, Section56b2); }
rule ProvisionOfResearch() strict { then amortization_provision_of(ResearchExperimental174, Section56b2); }
@source(us.irc.temporal::PL119_21_S70302, relation = formalizes, coverage = exact, quote = "by striking “or 174(a)” in the matter preceding clause (i) and inserting “, 174(a), or 174A(a)”")
rule ProvisionOfDomesticResearch() strict {
    label en official "Pub. L. 119-21 section 70302(b)(3)(A)(i): section 174A(a) is added to the expenditures section 56(b)(2)(A) capitalizes";
    effective [@2025-07-04, infinity);
    then amortization_provision_of(DomesticResearch174A, Section56b2);
}

pub relation amt_amortization_applies_to(e: AmortizedExpenditure) kind institutional {
    label en official "the expenditure is capitalized and amortized for the alternative minimum tax";
}
@source(IRC_S56_A, relation = formalizes, coverage = exact, quote = "(other than an oil, gas, or geothermal well) of the taxpayer, the amount allowable as a deduction under section 616(a) or 617(a) (determined without regard to section 291(b)) in computing the regular tax for costs paid or incurred after December 31, 1986")
rule AmortizationAppliesToMiningCost(e: AmortizedExpenditure) strict {
    label en official "section 56(a)(2)(A): mining exploration and development costs paid or incurred after 1986, other than for an oil, gas or geothermal well";
    when amortized_expenditure_kind(e, MiningExploration);
    when expenditure_paid_after_1986(e);
    when not_known(expenditure_for_oil_gas_or_geothermal_well(e));
    then amt_amortization_applies_to(e);
}
@source(IRC_S56_B, relation = formalizes, coverage = exact, quote = "The amount allowable as a deduction under section 173 or 174(a) in computing the regular tax for amounts paid or incurred after December 31, 1986, shall be capitalized and—")
rule AmortizationAppliesToCirculation(e: AmortizedExpenditure) strict {
    label en official "section 56(b)(2)(A): circulation expenditures paid or incurred after 1986";
    when amortized_expenditure_kind(e, Circulation173);
    when expenditure_paid_after_1986(e);
    then amt_amortization_applies_to(e);
}
@source(IRC_S56_B, relation = formalizes, coverage = exact, quote = "If the taxpayer materially participates (within the meaning of section 469(h)) in an activity, this paragraph shall not apply to any amount allowable as a deduction under section 174(a) for expenditures paid or incurred in connection with such activity.")
rule AmortizationAppliesToResearch(e: AmortizedExpenditure) strict {
    label en official "section 56(b)(2)(A), (C): research and experimental expenditures paid or incurred after 1986, unless the taxpayer materially participates in the activity";
    when amortized_expenditure_kind(e, ResearchExperimental174);
    when expenditure_paid_after_1986(e);
    when not_known(taxpayer_materially_participates_in_activity_of(e));
    then amt_amortization_applies_to(e);
}
@source(us.irc.temporal::PL119_21_S70302, relation = formalizes, coverage = exact, quote = "(B) in subparagraph (C), by inserting “or 174A(a)” after “174(a)”.")
rule AmortizationAppliesToDomesticResearch(e: AmortizedExpenditure) strict {
    label en official "Pub. L. 119-21 section 70302(b)(3)(B): the material participation exception reaches section 174A(a) expenditures too";
    effective [@2025-07-04, infinity);
    when amortized_expenditure_kind(e, DomesticResearch174A);
    when expenditure_paid_after_1986(e);
    when not_known(taxpayer_materially_participates_in_activity_of(e));
    then amt_amortization_applies_to(e);
}

pub relation expenditure_year_offset(e: AmortizedExpenditure, y: TaxableYear, offset: Integer) kind institutional {
    label en unofficial "the number of taxable years (calendar years) from the year of the expenditure to the year (0 in the year the expenditures were made)";
}
rule ExpenditureYearOffsetRule(e: AmortizedExpenditure, y: TaxableYear, y0: TaxableYear, n0: Integer, n: Integer) strict {
    when expenditure_made_in_year(e, y0);
    when us.irc.core::calendar_year_of(y0, n0);
    when us.irc.core::calendar_year_of(y, n);
    then expenditure_year_offset(e, y, n - n0);
}
pub relation year_not_before_loss_year(e: AmortizedExpenditure, y: TaxableYear) kind institutional {
    label en unofficial "a loss has been sustained with respect to the expenditure in the year or an earlier year";
}
rule LossSustainedInOrBefore(e: AmortizedExpenditure, y: TaxableYear) strict {
    when loss_sustained_in_year(e, y);
    then year_not_before_loss_year(e, y);
}
rule LossSustainedEarlier(e: AmortizedExpenditure, y: TaxableYear, yl: TaxableYear) strict {
    when loss_sustained_in_year(e, yl);
    when taxable_year_precedes(yl, y);
    then year_not_before_loss_year(e, y);
}

pub relation amortization_deduction_of_expenditure(p: Person, y: TaxableYear, e: AmortizedExpenditure, amount: Money) kind institutional {
    label en official "the amortization deduction of the year: the expenditure divided ratably over the period, until a loss is sustained";
}
@source(IRC_S56_A, relation = formalizes, coverage = exact, quote = "shall be capitalized and amortized ratably over the 10-year period beginning with the taxable year in which the expenditures were made.")
rule AmortizationDeductionOfExpenditure(p: Person, y: TaxableYear, e: AmortizedExpenditure, k: AmortizedExpenditureKind, total: Money, years: Integer, offset: Integer) strict {
    label en official "sections 56(a)(2)(A), 56(b)(2)(A): the expenditure over the period, one instalment for each year from the year it was made (cents HALF_UP: JUDGMENT CALL)";
    when amt_amortization_applies_to(e);
    when amortized_expenditure_of(e, p);
    when amortized_expenditure_kind(e, k);
    when amortized_expenditure_amount(e, total);
    when amortization_period_years(k, years);
    when expenditure_year_offset(e, y, offset);
    when offset >= 0;
    when offset < years;
    when not_known(year_not_before_loss_year(e, y));
    then amortization_deduction_of_expenditure(p, y, e, div_round(total, years * 1.0, 2, "HALF_UP"));
}

pub relation unamortized_expenditure_before_year(e: AmortizedExpenditure, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount of the expenditures which have not previously been amortized, at the start of the year";
}
rule UnamortizedExpenditureBeforeYear(e: AmortizedExpenditure, y: TaxableYear, k: AmortizedExpenditureKind, total: Money, years: Integer, offset: Integer) strict {
    when amt_amortization_applies_to(e);
    when amortized_expenditure_kind(e, k);
    when amortized_expenditure_amount(e, total);
    when amortization_period_years(k, years);
    when expenditure_year_offset(e, y, offset);
    when offset >= 0;
    when offset <= years;
    then unamortized_expenditure_before_year(e, y, div_round(total * (years - offset), years * 1.0, 2, "HALF_UP"));
}
pub relation amt_loss_deduction_of_expenditure(p: Person, y: TaxableYear, e: AmortizedExpenditure, amount: Money) kind institutional {
    label en official "the deduction allowed in the year in which the loss is sustained: the lesser of the section 165(a) amount if the expenditures had remained capitalized and the amount not previously amortized";
}
@source(IRC_S56_A, relation = formalizes, coverage = exact, quote = "a deduction shall be allowed for the expenditures described in subparagraph (A) for the taxable year in which such loss is sustained in an amount equal to the lesser of—")
rule AmtLossDeductionOfExpenditure(p: Person, y: TaxableYear, e: AmortizedExpenditure, a165: Money, unamortized: Money) strict {
    label en official "sections 56(a)(2)(B), 56(b)(2)(B): loss allowed, the lesser of the section 165(a) amount and the unamortized expenditures";
    when amt_amortization_applies_to(e);
    when amortized_expenditure_of(e, p);
    when loss_sustained_in_year(e, y);
    when section_165a_amount_if_capitalized(e, y, a165);
    when unamortized_expenditure_before_year(e, y, unamortized);
    then amt_loss_deduction_of_expenditure(p, y, e, min(a165, unamortized));
}

pub relation amortization_adjustment(p: Person, y: TaxableYear, prov: AmortizationProvision, amount: Money) kind institutional {
    label en unofficial "the regular deductions of the provision's expenditures less the amortization and loss deductions, for the year (positive: income increases)";
}
rule AmortizationAdjustmentOfProvision(p: Person, y: TaxableYear, prov: AmortizationProvision) strict {
    label en official "sections 56(a)(2), 56(b)(2): the AMT deduction replaces the regular deduction of the expenditures; the adjustment is the difference";
    when noncorporate_taxpayer_for_year(p, y);
    when provision_has_expenditure_of(p, prov);
    then amortization_adjustment(p, y, prov,
        sum(collect all a: Money, e: AmortizedExpenditure, k: AmortizedExpenditureKind where amortized_expenditure_of(e, p) and amt_amortization_applies_to(e) and amortized_expenditure_kind(e, k) and amortization_provision_of(k, prov) and regular_deduction_of_expenditure(p, y, e, a), empty: 0.00 USD)
        - sum(collect all b: Money, e: AmortizedExpenditure where amortization_deduction_of_expenditure(p, y, e, b) and provision_of_expenditure(e, prov), empty: 0.00 USD)
        - sum(collect all c: Money, e: AmortizedExpenditure where amt_loss_deduction_of_expenditure(p, y, e, c) and provision_of_expenditure(e, prov), empty: 0.00 USD));
}
pub relation provision_has_expenditure_of(p: Person, prov: AmortizationProvision) kind institutional {
    label en unofficial "the taxpayer has an expenditure amortized under the provision";
}
rule ProvisionHasExpenditureOf(p: Person, prov: AmortizationProvision, e: AmortizedExpenditure, k: AmortizedExpenditureKind) strict {
    when amortized_expenditure_of(e, p);
    when amortized_expenditure_kind(e, k);
    when amortization_provision_of(k, prov);
    then provision_has_expenditure_of(p, prov);
}
pub relation provision_of_expenditure(e: AmortizedExpenditure, prov: AmortizationProvision) kind institutional {
    label en unofficial "the paragraph that amortizes this expenditure";
}
rule ProvisionOfExpenditure(e: AmortizedExpenditure, k: AmortizedExpenditureKind, prov: AmortizationProvision) strict {
    when amortized_expenditure_kind(e, k);
    when amortization_provision_of(k, prov);
    then provision_of_expenditure(e, prov);
}
@source(IRC_S56_A, relation = formalizes, coverage = partial, quote = "shall be capitalized and amortized ratably over the 10-year period beginning with the taxable year in which the expenditures were made.")
rule AmtAdjustmentMiningByExpenditure(p: Person, y: TaxableYear, amount: Money) strict {
    label en official "section 56(a)(2): the mining cost adjustment of the year";
    when amortization_adjustment(p, y, Section56a2, amount);
    then amt_adjustment(p, y, MiningCostsByExpenditure56a2, amount);
}
@source(IRC_S56_B, relation = formalizes, coverage = partial, quote = "shall be capitalized and—")
rule AmtAdjustmentCirculationResearchByExpenditure(p: Person, y: TaxableYear, amount: Money) strict {
    label en official "section 56(b)(2): the circulation and research adjustment of the year";
    when amortization_adjustment(p, y, Section56b2, amount);
    then amt_adjustment(p, y, CirculationAndResearchByExpenditure56b2, amount);
}

// --- Section 56(a)(3): long-term contracts -------------------------------------------

pub relation long_term_contract_of(c: LongTermContract, p: Person) kind empirical {
    label en unofficial "the contract is the taxpayer's";
}
pub relation contract_entered_into_on(c: LongTermContract, d: Date) kind empirical {
    label en official "the date the long-term contract was entered into";
}
pub relation contract_entered_in_taxable_year_beginning_on(c: LongTermContract, d: Date) kind empirical {
    label en official "the first day of the taxable year in which the contract was entered into";
}
pub relation home_construction_contract(c: LongTermContract) kind empirical {
    label en official "a home construction contract (as defined in section 460(e)(6) before Pub. L. 119-21)";
}
pub relation residential_construction_contract(c: LongTermContract) kind empirical {
    label en official "a residential construction contract (as defined in section 460(e)(4) as amended by Pub. L. 119-21 section 70430)";
}
pub relation contract_described_in_460e1(c: LongTermContract) kind empirical {
    label en official "a contract described in section 460(e)(1)";
}
pub relation percentage_of_completion_income_of_contract(p: Person, y: TaxableYear, c: LongTermContract, amount: Money) kind empirical {
    label en official "the taxable income from the contract for the year under the percentage of completion method (as modified by section 460(b)) (EXTERNAL_DEPENDENCY: section 460)";
}
pub relation regular_income_of_contract(p: Person, y: TaxableYear, c: LongTermContract, amount: Money) kind empirical {
    label en official "the income from the contract for the year in computing the regular tax";
}
pub relation percentage_of_completion_required_for_amt(c: LongTermContract) kind institutional {
    label en official "the taxable income from the contract is determined under the percentage of completion method for the alternative minimum tax";
}
pub relation simplified_cost_allocation_applies(c: LongTermContract) kind institutional {
    label en official "the percentage of the contract completed is determined under section 460(b)(1) using the simplified procedures for allocation of costs prescribed under section 460(b)(3)";
}

@source(IRC_S56_A, relation = formalizes, coverage = partial, quote = "In the case of any long-term contract entered into by the taxpayer on or after March 1, 1986, the taxable income from such contract shall be determined under the percentage of completion method of accounting (as modified by section 460(b)).")
rule PercentageOfCompletionRequiredBeforeAmendment(c: LongTermContract, d: Date, yb: Date) strict {
    label en official "section 56(a)(3), 2024-Edition text: a contract entered into on or after March 1, 1986 (in a taxable year beginning not after the enactment of Pub. L. 119-21) other than a home construction contract";
    when contract_entered_into_on(c, d);
    when d >= @1986-03-01;
    when contract_entered_in_taxable_year_beginning_on(c, yb);
    when yb <= @2025-07-04;
    when not_known(home_construction_contract(c));
    then percentage_of_completion_required_for_amt(c);
}
@source(us.irc.temporal::PL119_21_S70430, relation = formalizes, coverage = exact, quote = "by striking “any home construction contract (as defined in section 460(e)(6))” and inserting")
rule PercentageOfCompletionRequiredAfterAmendment(c: LongTermContract, d: Date, yb: Date) strict {
    label en official "Pub. L. 119-21 section 70430(b): for contracts entered into in taxable years beginning after the date of enactment the exception is for a residential construction contract (as defined in section 460(e)(4))";
    effective [@2025-07-04, infinity);
    when contract_entered_into_on(c, d);
    when d >= @1986-03-01;
    when contract_entered_in_taxable_year_beginning_on(c, yb);
    when yb > @2025-07-04;
    when not_known(residential_construction_contract(c));
    then percentage_of_completion_required_for_amt(c);
}
@source(IRC_S56_A, relation = formalizes, coverage = exact, quote = "For purposes of the preceding sentence, in the case of a contract described in section 460(e)(1), the percentage of the contract completed shall be determined under section 460(b)(1) by using the simplified procedures for allocation of costs prescribed under section 460(b)(3).")
rule SimplifiedCostAllocationForSection460e1Contract(c: LongTermContract) strict {
    label en official "section 56(a)(3), second sentence";
    when percentage_of_completion_required_for_amt(c);
    when contract_described_in_460e1(c);
    then simplified_cost_allocation_applies(c);
}
pub relation contract_adjustment(p: Person, y: TaxableYear, c: LongTermContract, amount: Money) kind institutional {
    label en unofficial "the percentage of completion income less the regular income from the contract for the year";
}
@source(IRC_S56_A, relation = formalizes, coverage = partial, quote = "the taxable income from such contract shall be determined under the percentage of completion method of accounting (as modified by section 460(b)).")
rule ContractAdjustment(p: Person, y: TaxableYear, c: LongTermContract, poc: Money, regular: Money) strict {
    label en official "section 56(a)(3): the AMT income from the contract replaces the regular income; the adjustment is the difference";
    when long_term_contract_of(c, p);
    when percentage_of_completion_required_for_amt(c);
    when percentage_of_completion_income_of_contract(p, y, c, poc);
    when regular_income_of_contract(p, y, c, regular);
    then contract_adjustment(p, y, c, poc - regular);
}
pub relation has_contract_adjustment(p: Person, y: TaxableYear) kind institutional {
    label en unofficial "the taxpayer has at least one section 56(a)(3) contract adjustment for the year";
}
rule HasContractAdjustment(p: Person, y: TaxableYear, c: LongTermContract) strict {
    when contract_adjustment(p, y, c, _);
    then has_contract_adjustment(p, y);
}
rule AmtAdjustmentLongTermContractsByContract(p: Person, y: TaxableYear) strict {
    label en official "section 56(a)(3): the sum of the contract adjustments";
    when has_contract_adjustment(p, y);
    then amt_adjustment(p, y, LongTermContractsByContract56a3, sum all amount: Money for c: LongTermContract where contract_adjustment(p, y, c, amount));
}
