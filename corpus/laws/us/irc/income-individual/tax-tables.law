// Section 3: tax tables for individuals. §3(a)(1)-(3): the Secretary's power
// to prescribe (and elect to extend) tables in lieu of section 1's exact
// computation, for non-itemizers under a ceiling amount; §3(b): who is
// excluded; §3(c)/(d): the table tax is treated as section 1 tax, computed
// on section 63 taxable income; §3(e): cross reference (non-normative).
//
// The Secretary's ACTUAL published tables (Form 1040 instructions) are not
// pinned text of Title 26 and are not modelled — §3 itself does not set
// dollar amounts, only the INSTITUTIONAL POWER to publish a table and the
// $20,000 statutory floor on the ceiling amount.

// `Person`/`TaxableYear` aliases live in `filing-status.law` (package-scoped).

use self::{
    FilingStatus,
    IRC_S3_A,
    IRC_S3_B,
    IRC_S3_C,
    Person,
    TaxableYear,
    filing_status,
    tax_under_section_1,
    taxable_income,
};

pub relation itemizes_deductions_for_year(p: Person, y: TaxableYear) kind empirical {
    label en official "does not itemize his deductions for the taxable year";
}
pub relation ceiling_amount(y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount (not less than $20,000) determined by the Secretary for the tax rate category";
}
pub relation table_tax_amount(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "a tax determined under tables ... prescribed by the Secretary";
}

@source(IRC_S3_A, quote = "In lieu of the tax imposed by section 1, there is hereby imposed for each taxable year on the taxable income of every individual")
rule TableTaxAppliesInLieuOfSection1(p: Person, y: TaxableYear, taxable: Money, ceiling: Money) strict {
    label en official "in lieu of the tax imposed by section 1, a tax determined under tables ... for every individual who does not itemize and whose taxable income does not exceed the ceiling amount";
    when not itemizes_deductions_for_year(p, y);
    when taxable_income(p, y, taxable);
    when ceiling_amount(y, ceiling);
    when taxable_at_most(taxable, ceiling);
    when table_tax_amount(p, y, taxable);
    then tax_under_section_1_via_table(p, y, taxable);
}
relation taxable_at_most(taxable: Money, ceiling: Money) kind institutional {
    label en unofficial "taxable <= ceiling (guard for the section 3(a)(1)(B) condition)";
}
pub relation tax_under_section_1_via_table(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the table tax, which section 3(c) treats as the tax imposed by section 1";
}

// §3(a)(2) ("ceiling amount ... not less than $20,000") is the one concrete
// statutory number in this section — modelled as a floor guard on the
// parameter, not a fixed value (the Secretary determines the actual ceiling
// per rate category; only the $20,000 statutory minimum is pinned text).
relation ceiling_at_least_20000(amount: Money) kind institutional {
    label en unofficial "amount >= $20,000, the section 3(a)(2) statutory floor";
}

@source(IRC_S3_B, quote = "This section shall not apply to—")
rule TableTaxInapplicableToEstateOrTrust(p: Person, y: TaxableYear) strict {
    label en official "this section shall not apply to ... an estate or trust";
    when filing_status(p, y, EstateOrTrust);
    then table_tax_inapplicable(p, y);
}
pub relation table_tax_inapplicable(p: Person, y: TaxableYear) kind institutional {
    label en official "section 3 does not apply to this person for this year";
}

// §3(b)(1) (short-period return under §443(a)(1)) is a dependency on
// `accounting` (owns §441-443) not modelled here — classified
// EXTERNAL_DEPENDENCY.

@source(IRC_S3_C)
rule TableTaxTreatedAsSection1Tax(p: Person, y: TaxableYear, amount: Money) strict {
    label en official "for purposes of this title, the tax imposed by this section shall be treated as tax imposed by section 1";
    when tax_under_section_1_via_table(p, y, amount);
    then tax_under_section_1(p, y, amount);
}

// §3(d) ("taxable income ... determined under section 63") is already read
// through the `taxable_income` dependency contract of `rates.law` — no
// separate rule needed; the cross-reference is satisfied by construction.
// §3(e) ("For computation of tax by Secretary, see section 6014.") is a
// pointer, non-normative — no rule.
