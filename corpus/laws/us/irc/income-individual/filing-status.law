// Sections 1(a)-(d) ("who" clauses) and 2 (definitions and special rules) —
// filing status. `us.irc.definitions` (§7703 marital status, §7701(b)
// resident alien) is being written concurrently and is NOT imported yet
// (task instruction): the predicates it will produce are declared here as
// typed institutional DEPENDENCY CONTRACTS and recorded in DEPENDENCIES.json
// with status "pending", owner "definitions". Likewise `dependent_of`/
// `qualifying_child_of` (§152) and `joint_return_filed` (§6013) are contracts
// on other not-yet-available owners (`credits`/`deductions`/`returns`).
//
// INTERFACE (consumed by `credits`, `deductions`, `gross-income`): the `pub`
// enum `FilingStatus` and the `pub` relation `filing_status(p, y, s)`.

use self::{
    IRC_S1_A,
    IRC_S1_B,
    IRC_S1_C,
    IRC_S1_D,
    IRC_S1_E,
    IRC_S2_A,
    IRC_S2_B,
    IRC_S2_C,
};

type Person = us.irc.core::Person;
type Individual = us.irc.core::Individual;
type Estate = us.irc.core::Estate;
type Trust = us.irc.core::Trust;
type TaxableYear = us.irc.core::TaxableYear;

// --- Interface ---------------------------------------------------------------

pub enum FilingStatus {
    Joint;
    HeadOfHousehold;
    Unmarried;
    MarriedSeparate;
    EstateOrTrust;
}

pub relation filing_status(p: Person, y: TaxableYear, s: FilingStatus) kind institutional {
    label en unofficial "the filing status under which section 1 imposes a tax on this person for this taxable year";
}

// --- Dependency contracts (pending: us.irc.definitions) ----------------------

// §7703(a)/(b): whether an individual is "married" for this title, including
// the constructive-unmarried rule of §7703(b) that feeds §2(c).
pub relation married_at_close_of_year(p: Individual, y: TaxableYear) kind institutional {
    label en official "married (as defined in section 7703)";
}

// §7703(b): certain married individuals living apart are treated as not
// married. Producer: us.irc.definitions (pending).
pub relation treated_as_not_married_7703b(p: Individual, y: TaxableYear) kind institutional {
    label en official "considered as not married (section 7703(b))";
}

// §7701(b): nonresident alien status, read by §2(b)(2)(B)/(3)(A) and §2(d).
pub relation nonresident_alien(p: Individual, y: TaxableYear) kind institutional {
    label en official "nonresident alien individual";
}

// §6013: whether THIS person makes a single return jointly with his spouse
// for the year (asserted per person, not per couple, so that no rule needs
// an existential over the unnamed spouse). Producer: `returns` (owns
// §6011-6013 family); not yet available.
pub relation joint_return_filed(p: Individual, y: TaxableYear) kind empirical {
    label en official "makes a single return jointly with his spouse under section 6013";
}

// §152(c)/(d): dependency and qualifying-child/relative tests read by §2(a)
// and §2(b). Producer: unresolved (candidate owners `credits`/`deductions`);
// recorded in DEPENDENCIES.json.
pub relation dependent_of(dependent: Person, taxpayer: Individual, y: TaxableYear) kind institutional {
    label en official "a dependent (within the meaning of section 152) of the taxpayer";
}
pub relation qualifying_child_of(child: Person, taxpayer: Individual, y: TaxableYear) kind institutional {
    label en official "a qualifying child of the individual (as defined in section 152(c))";
}

// §7703(a) spouse's death and household-maintenance facts — case facts until
// `definitions` supplies a derived test; asserted directly for now.
relation spouse_died_in_year(p: Individual, y: TaxableYear) kind empirical {
    label en official "whose spouse died during either of his two taxable years immediately preceding the taxable year";
}
relation maintains_household_for(p: Individual, beneficiary: Person, y: TaxableYear) kind empirical {
    label en official "maintains as his home a household which constitutes for the taxable year the principal place of abode";
}
relation remarried_before_close_of_year(p: Individual, y: TaxableYear) kind empirical {
    label en official "has remarried at any time before the close of the taxable year";
}

// --- Section 2(a): surviving spouse -------------------------------------------

pub relation surviving_spouse(p: Individual, y: TaxableYear) kind institutional {
    label en official "surviving spouse";
}

@source(IRC_S2_A, quote = "For purposes of section 1, the term \"surviving spouse\" means a taxpayer—")
rule SurvivingSpouseInGeneral(p: Individual, y: TaxableYear, child: Person) strict {
    label en official "a taxpayer whose spouse died during either of his two taxable years immediately preceding the taxable year and who maintains as his home a household which is the principal place of abode of a dependent child";
    when spouse_died_in_year(p, y);
    when dependent_of(child, p, y);
    when maintains_household_for(p, child, y);
    when not remarried_before_close_of_year(p, y);
    then surviving_spouse(p, y);
}

// §2(a)(2)(A): limitation is expressed on the head-clause via `not
// remarried_before_close_of_year` in SurvivingSpouseInGeneral. §2(a)(2)(B) (a
// joint return could have been made for the year the spouse died) and
// §2(a)(3) (missing-status combat-zone special rule) are separate, narrower
// conditions this stage records as INTERPRETATION rows rather than
// executable rules: they turn on §6013(f)(3) and combat-zone facts this
// package does not own.

// --- Section 2(b): head of household ------------------------------------------

pub relation head_of_household(p: Individual, y: TaxableYear) kind institutional {
    label en official "head of a household";
}

relation entitled_to_151_deduction_for(p: Individual, dependent: Person, y: TaxableYear) kind institutional {
    label en official "entitled to a deduction for the taxable year for such person under section 151";
}
relation maintains_household_for_parent(p: Individual, parent: Person, y: TaxableYear) kind empirical {
    label en official "maintains a household which constitutes for such taxable year the principal place of abode of the father or mother of the taxpayer";
}

@source(IRC_S2_B, quote = "an individual shall be considered a head of a household if, and only if, such individual is not married at the close of his taxable year, is not a surviving spouse")
rule HeadOfHouseholdQualifyingChildBranch(p: Individual, y: TaxableYear, child: Person) strict {
    label en official "not married, not a surviving spouse, and maintains as home a household that is the principal place of abode of a qualifying child (or other dependent entitled to a section 151 deduction)";
    when not married_at_close_of_year(p, y);
    when not_known(surviving_spouse(p, y));
    when qualifying_child_of(child, p, y);
    when maintains_household_for(p, child, y);
    when not_known(nonresident_alien(p, y));
    then head_of_household(p, y);
}

@source(IRC_S2_B, quote = "maintains a household which constitutes for such taxable year the principal place of abode of the father or mother of the taxpayer")
rule HeadOfHouseholdParentBranch(p: Individual, y: TaxableYear, parent: Person) strict {
    label en official "maintains a household that is the principal place of abode of a dependent parent entitled to a section 151 deduction";
    when not married_at_close_of_year(p, y);
    when not_known(surviving_spouse(p, y));
    when dependent_of(parent, p, y);
    when entitled_to_151_deduction_for(p, parent, y);
    when maintains_household_for_parent(p, parent, y);
    when not_known(nonresident_alien(p, y));
    then head_of_household(p, y);
}

// §2(b)(2): "not married" determination special rules (legal separation,
// spouse a nonresident alien, spouse died during the year) and §2(b)(3)(B)
// (limitation for a dependent who qualifies only under section
// 152(d)(2)(H) or 152(d)(3)) are dependency contracts on `married_at_close_
// of_year`/`dependent_of` upstream — this package does not re-derive §152's
// own internal tests.

// --- Section 2(c): certain married individuals living apart -------------------

@source(IRC_S2_C)
rule TreatedAsNotMarriedForPartI(p: Individual, y: TaxableYear) strict {
    label en official "an individual shall be treated as not married at the close of the taxable year if such individual is so treated under the provisions of section 7703(b)";
    when treated_as_not_married_7703b(p, y);
    then not married_at_close_of_year(p, y);
}

// --- Section 2(d): nonresident aliens (external dependency) -------------------
//
// "the taxes imposed by sections 1 and 55 shall apply only as provided by
// section 871 or 877" — §871/§877 are owned by `international`; this
// stage does not import `international`'s charging rules, so §2(d) is
// classified EXTERNAL_DEPENDENCY, not modeled as an executable rule here.

// --- Section 2(e): cross reference (non-normative) ----------------------------
// "For definition of taxable income, see section 63." — a pointer, no rule.

// --- Filing status assignment (ties sections 1(a)-(d) headers to section 2) --

@source(IRC_S1_A)
rule FilingStatusJoint(p: Individual, y: TaxableYear) strict {
    label en official "every married individual who makes a single return jointly with his spouse under section 6013, and every surviving spouse";
    when joint_return_filed(p, y);
    then filing_status(p, y, Joint);
}

@source(IRC_S1_A)
rule FilingStatusSurvivingSpouseIsJointTable(p: Individual, y: TaxableYear) strict {
    label en official "every surviving spouse (as defined in section 2(a))";
    when surviving_spouse(p, y);
    then filing_status(p, y, Joint);
}

@source(IRC_S1_B)
rule FilingStatusHeadOfHousehold(p: Individual, y: TaxableYear) strict {
    label en official "every head of a household (as defined in section 2(b))";
    when head_of_household(p, y);
    then filing_status(p, y, HeadOfHousehold);
}

@source(IRC_S1_C)
rule FilingStatusUnmarried(p: Individual, y: TaxableYear) strict {
    label en official "every individual (other than a surviving spouse ... or the head of a household ...) who is not a married individual";
    when us.irc.core::year_of(p, y);
    when not married_at_close_of_year(p, y);
    when not_known(surviving_spouse(p, y));
    when not_known(head_of_household(p, y));
    then filing_status(p, y, Unmarried);
}

@source(IRC_S1_D)
rule FilingStatusMarriedSeparate(p: Individual, y: TaxableYear) strict {
    label en official "every married individual ... who does not make a single return jointly with his spouse under section 6013";
    when married_at_close_of_year(p, y);
    when not joint_return_filed(p, y);
    then filing_status(p, y, MarriedSeparate);
}

@source(IRC_S1_E, quote = "every estate")
rule FilingStatusEstate(p: Estate, y: TaxableYear) strict {
    label en official "every estate ... taxable under this subsection";
    when us.irc.core::year_of(p, y);
    then filing_status(p, y, EstateOrTrust);
}

@source(IRC_S1_E, quote = "every trust")
rule FilingStatusTrust(p: Trust, y: TaxableYear) strict {
    label en official "every trust ... taxable under this subsection";
    when us.irc.core::year_of(p, y);
    then filing_status(p, y, EstateOrTrust);
}
