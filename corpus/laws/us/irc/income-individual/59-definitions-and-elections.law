// Section 59: other definitions and special rules (stage 2). Modelled:
// (a)(2)-(3) the pre-credit tentative minimum tax and the election of the
// simplified section 904 limitation (a `power` of the taxpayer, its
// revocation a power that needs the Secretary's consent, and the limitation
// fraction), (d)(2) differently treated items, (e) the optional 10-year (3-year
// for circulation) writeoff of certain tax preferences (the election as a
// `power`, the ratable deduction, the prohibition of any other deduction for an
// elected expenditure, the partner-level election, revocation only with the
// Secretary's consent), (i) amounts still wholly exempt, (j) the cap on the
// exemption of a child to whom section 1(g) applies, and the Secretary's
// rule-making mandates and powers of parts VI ((g) may, (k)(2)(D), (k)(3) and
// (l)(3) shall) and of section 56A ((c)(10)(B), (c)(15), (e)).
//
// (j) AND THE POST-2017 TEXT. Section 55(d)(4)(A)(iii) says "subsection (j) of
// section 59 shall not apply" for taxable years beginning after December 31,
// 2017 (permanent after Pub. L. 119-21 section 70107(a) strikes the 2026
// sunset). The pinned text is applied literally: the cap rule below is
// bounded to taxable years before 2018. Rev. Proc. 2024-40 section 2.12 and
// Rev. Proc. 2025-32 section 4.11 nevertheless publish a section 59(j) cap for
// 2025 and 2026; that conflict between the statute as pinned and the IRS
// publication is recorded as an INTERPRETATION row (both readings named), not
// resolved by choosing a number.

// --- Section 59(a)(2): pre-credit tentative minimum tax ------------------------

use self::{
    IRC_S55_D,
    IRC_S56A_C,
    IRC_S56A_E,
    IRC_S59_A,
    IRC_S59_D,
    IRC_S59_E,
    IRC_S59_G,
    IRC_S59_I,
    IRC_S59_J,
    IRC_S59_K,
    IRC_S59_L,
    Person,
    RegulatoryMandate,
    TaxableYear,
    alternative_minimum_taxable_income,
    amt_exemption_after_phaseout,
    earned_income,
    kiddie_tax_applies,
    provision_mandates_secretary_rules,
    secretary_has_prescribed_rules,
    tmt_first_sentence_amount,
};

pub relation pre_credit_tentative_minimum_tax(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the term \"pre-credit tentative minimum tax\" means the amount determined under the first sentence of section 55(b)(1)(A)";
}

@source(IRC_S59_A, relation = formalizes, coverage = exact, quote = "the term \"pre-credit tentative minimum tax\" means the amount determined under the first sentence of section 55(b)(1)(A).")
rule PreCreditTentativeMinimumTaxRule(p: Person, y: TaxableYear, first: Money) strict {
    label en official "section 59(a)(2): the first-sentence amount of section 55(b)(1)(A) (after the section 55(b)(3) ceiling, before the foreign tax credit)";
    when tmt_first_sentence_amount(p, y, first);
    then pre_credit_tentative_minimum_tax(p, y, first);
}

// --- Section 59(a)(3): election to use the simplified section 904 limitation ---

pub relation claims_amt_foreign_tax_credit(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer claims an alternative minimum tax foreign tax credit for the taxable year";
}
pub relation no_earlier_year_after_1997_claiming_amt_foreign_tax_credit(p: Person, y: TaxableYear) kind empirical {
    label en official "no earlier taxable year beginning after December 31, 1997 is one for which the taxpayer claims an alternative minimum tax foreign tax credit";
}
pub relation eligible_year_for_simplified_904_election(p: Person, y: TaxableYear) kind institutional {
    label en official "the taxpayer's first taxable year which begins after December 31, 1997, and for which the taxpayer claims an alternative minimum tax foreign tax credit";
}

@source(IRC_S59_A, relation = formalizes, coverage = exact, quote = "An election under this paragraph may be made only for the taxpayer's first taxable year which begins after December 31, 1997, and for which the taxpayer claims an alternative minimum tax foreign tax credit.")
rule EligibleYearForSimplified904Election(p: Person, y: TaxableYear, start: Date) strict {
    label en official "section 59(a)(3)(B)(i): the election may be made only for the first taxable year beginning after 1997 for which an alternative minimum tax foreign tax credit is claimed";
    when claims_amt_foreign_tax_credit(p, y);
    when us.irc.core::begins(y, start);
    when start > @1997-12-31;
    when no_earlier_year_after_1997_claiming_amt_foreign_tax_credit(p, y);
    then eligible_year_for_simplified_904_election(p, y);
}

pub relation taxpayer_elects_simplified_904(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer makes the election to use the simplified section 904 limitation for the taxable year (the exercise)";
}
pub relation simplified_904_election_in_effect(p: Person, y: TaxableYear) kind institutional {
    label en official "an election under section 59(a)(3) applies to the taxable year for which made";
}

@source(IRC_S59_A, relation = formalizes, coverage = exact, quote = "(3) Election to use simplified section 904 limitation")
rule TaxpayerMayElectSimplified904 defeasible {
    label en official "section 59(a)(3): a taxpayer may elect to have the alternative minimum tax foreign tax credit limited by the simplified proportion";
    for p: Person;
    for y: TaxableYear;
    when claims_amt_foreign_tax_credit(p, y);
    then power ElectSimplifiedSection904Limitation {
        holder p; over p;
        exercise taxpayer_elects_simplified_904(p, y);
        valid_when eligible_year_for_simplified_904_election(p, y);
        effect create(simplified_904_election_in_effect(p, y));
        window [@1998-01-01, infinity);
    };
}

pub relation taxpayer_revokes_simplified_904_election(p: Person) kind empirical {
    label en official "the taxpayer revokes the section 59(a)(3) election (the exercise)";
}
pub relation secretary_consents_to_revoke_simplified_904(p: Person) kind empirical {
    label en official "the Secretary consents to the revocation";
}
pub relation simplified_904_election_revoked(p: Person) kind institutional {
    label en official "the section 59(a)(3) election is revoked with the consent of the Secretary";
}

// Computational twins of the two powers' effects (a power's effect
// materializes after every stratum and defeasible or `not_known` readers cannot
// see it, E-0134): the same premises as each `valid_when`, derived directly.
pub relation simplified_904_election_made_for_year(p: Person, y: TaxableYear) kind institutional {
    label en official "a valid election under section 59(a)(3) was made for the taxable year";
}
@source(IRC_S59_A, relation = formalizes, coverage = exact, quote = "An election under this paragraph may be made only for the taxpayer's first taxable year")
rule Simplified904ElectionMadeForYear(p: Person, y: TaxableYear) strict {
    when taxpayer_elects_simplified_904(p, y);
    when eligible_year_for_simplified_904_election(p, y);
    then simplified_904_election_made_for_year(p, y);
}
pub relation simplified_904_revoked_with_consent(p: Person) kind institutional {
    label en official "the taxpayer revoked the election and the Secretary consented";
}
@source(IRC_S59_A, relation = formalizes, coverage = exact, quote = "unless revoked with the consent of the Secretary")
rule Simplified904RevokedWithConsent(p: Person) strict {
    when taxpayer_revokes_simplified_904_election(p);
    when secretary_consents_to_revoke_simplified_904(p);
    then simplified_904_revoked_with_consent(p);
}

@source(IRC_S59_A, relation = formalizes, coverage = exact, quote = "An election under this paragraph, once made, shall apply to the taxable year for which made and all subsequent taxable years unless revoked with the consent of the Secretary.")
rule TaxpayerMayRevokeSimplified904WithConsent defeasible {
    label en official "section 59(a)(3)(B)(ii): the election may be revoked only with the consent of the Secretary";
    for p: Person;
    for y0: TaxableYear;
    when simplified_904_election_made_for_year(p, y0);
    then power RevokeSimplifiedSection904Election {
        holder p; over p;
        exercise taxpayer_revokes_simplified_904_election(p);
        valid_when secretary_consents_to_revoke_simplified_904(p);
        effect create(simplified_904_election_revoked(p));
        window [@1998-01-01, infinity);
    };
}

pub relation simplified_904_applies_to_year(p: Person, y: TaxableYear) kind institutional {
    label en official "the election applies to the taxable year for which made and all subsequent taxable years unless revoked";
}

@source(IRC_S59_A, relation = formalizes, coverage = exact, quote = "shall apply to the taxable year for which made and all subsequent taxable years unless revoked with the consent of the Secretary.")
rule Simplified904AppliesToLaterYears(p: Person, y: TaxableYear, y0: TaxableYear, s0: Date, s: Date) strict {
    label en official "section 59(a)(3)(B)(ii): once made, the election applies from the election year on";
    when simplified_904_election_made_for_year(p, y0);
    when us.irc.core::begins(y0, s0);
    when us.irc.core::begins(y, s);
    when s >= s0;
    when not_known(simplified_904_revoked_with_consent(p));
    then simplified_904_applies_to_year(p, y);
}

pub relation foreign_source_taxable_income_regular_tax(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the taxpayer's taxable income (as determined for purposes of the regular tax) from sources without the United States";
}
pub relation simplified_904_limitation_fraction(p: Person, y: TaxableYear, fraction: Decimal) kind institutional {
    label en official "the proportion of foreign-source taxable income (not in excess of alternative minimum taxable income) to the entire alternative minimum taxable income";
}

@source(IRC_S59_A, relation = formalizes, coverage = exact, quote = "the taxpayer's taxable income (as determined for purposes of the regular tax) from sources without the United States (but not in excess of the taxpayer's entire alternative minimum taxable income), bears to")
rule Simplified904Fraction(p: Person, y: TaxableYear, foreign: Money, amti: Money) strict {
    label en official "section 59(a)(3)(A)(ii): min(foreign-source regular-tax taxable income, alternative minimum taxable income) / alternative minimum taxable income";
    when simplified_904_applies_to_year(p, y);
    when foreign_source_taxable_income_regular_tax(p, y, foreign);
    when alternative_minimum_taxable_income(p, y, amti);
    when amti > 0 USD;
    then simplified_904_limitation_fraction(p, y, div_round(min(foreign, amti), amti, 10, "HALF_UP"));
}

// --- Section 59(d)(2): differently treated items ------------------------------

entity AmtItem {
    label en unofficial "an item of income, deduction, credit or preference that part VI of subchapter A of chapter 1 may treat differently";
}
pub relation is_item_of_tax_preference(i: AmtItem) kind empirical {
    label en official "an item of tax preference";
}
pub relation treated_differently_for_amt(i: AmtItem) kind empirical {
    label en official "an item which is treated differently for purposes of this part than for purposes of computing the regular tax";
}
pub relation differently_treated_item(i: AmtItem) kind institutional {
    label en official "the term \"differently treated item\"";
}

@source(IRC_S59_D, relation = formalizes, coverage = exact, quote = "the term \"differently treated item\" means any item of tax preference or any other item which is treated differently for purposes of this part than for purposes of computing the regular tax.")
rule DifferentlyTreatedItemPreference(i: AmtItem) strict {
    when is_item_of_tax_preference(i);
    then differently_treated_item(i);
}
@source(IRC_S59_D, relation = formalizes, coverage = exact, quote = "the term \"differently treated item\" means any item of tax preference or any other item which is treated differently for purposes of this part than for purposes of computing the regular tax.")
rule DifferentlyTreatedItemOther(i: AmtItem) strict {
    when treated_differently_for_amt(i);
    then differently_treated_item(i);
}

// --- Section 59(e): optional 10-year writeoff of certain tax preferences -------

pub enum QualifiedExpenditureKind {
    CirculationSection173;
    ResearchSection174a;
    DomesticResearchSection174Aa;
    IntangibleDrillingSection263c;
    DevelopmentSection616a;
    MiningExplorationSection617a;
    label en official "the section under which the expenditure would have been allowable as a deduction but for the election";
}

entity QualifiedExpenditure {
    label en unofficial "an amount paid or incurred that may be a qualified expenditure of section 59(e)";
}

pub relation expenditure_kind(e: QualifiedExpenditure, k: QualifiedExpenditureKind) kind empirical {
    label en official "the section under which the amount would have been allowable as a deduction (determined without regard to section 291) for the taxable year in which paid or incurred";
}
pub relation expenditure_paid_by(e: QualifiedExpenditure, p: Person) kind empirical {
    label en unofficial "the person who paid or incurred the expenditure";
}
pub relation expenditure_is_partnership_or_s_corporation_expenditure(e: QualifiedExpenditure) kind empirical {
    label en official "the expenditure is one of a partnership or of an S corporation";
}
pub relation allocable_share_of_expenditure(e: QualifiedExpenditure, owner: Person) kind empirical {
    label en official "the partner's allocable share of a qualified expenditure of the partnership (or the S corporation shareholder's share)";
}
pub relation expenditure_year(e: QualifiedExpenditure, y: TaxableYear) kind empirical {
    label en official "the taxable year in which the expenditure was made";
}
pub relation allowable_deduction_but_for_election(e: QualifiedExpenditure, amount: Money) kind empirical {
    label en official "the amount that would have been allowable as a deduction but for an election under section 59(e)";
}

pub relation qualified_expenditure(e: QualifiedExpenditure) kind institutional {
    label en official "the term \"qualified expenditure\" means any amount which, but for an election under this subsection, would have been allowable as a deduction under section 173, 174(a), 263(c), 616(a) or 617(a)";
}

relation qualified_kind_without_date(k: QualifiedExpenditureKind) kind institutional {
    label en unofficial "a kind of expenditure that qualifies whatever year it was paid (sections 173, 263(c), 616(a), 617(a))";
}
assert qualified_kind_without_date(CirculationSection173);
assert qualified_kind_without_date(IntangibleDrillingSection263c);
assert qualified_kind_without_date(DevelopmentSection616a);
assert qualified_kind_without_date(MiningExplorationSection617a);

@source(IRC_S59_E, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, the term \"qualified expenditure\" means any amount which, but for an election under this subsection, would have been allowable as a deduction (determined without regard to section 291) for the taxable year in which paid or incurred under—")
rule QualifiedExpenditureDatelessKinds(e: QualifiedExpenditure, k: QualifiedExpenditureKind, amount: Money) strict {
    label en official "section 59(e)(2)(A), (C), (D), (E): an amount that would have been allowable under section 173, 263(c), 616(a) or 617(a) but for the election";
    when expenditure_kind(e, k);
    when qualified_kind_without_date(k);
    when allowable_deduction_but_for_election(e, amount);
    then qualified_expenditure(e);
}

// Section 59(e)(2)(B) names section 174(a) in the 2024-Edition text; Pub. L. 119-21
// section 70302(b)(4) strikes "section 174(a) (relating to research and
// experimental expenditures)" and inserts "section 174A(a) (relating to domestic
// research or experimental expenditures)", applicable to amounts paid or incurred
// in taxable years beginning after December 31, 2024 (section 70302(e)(1)).
// Calendar-year taxpayers only: the year is the calendar year of the expenditure's
// taxable year.
@source(IRC_S59_E, relation = formalizes, coverage = exact, quote = "(B) section 174(a) (relating to research and experimental expenditures),")
rule QualifiedExpenditureResearchBefore2025(e: QualifiedExpenditure, amount: Money, made: TaxableYear, n: Integer) strict {
    label en official "section 59(e)(2)(B), 2024-Edition text: research and experimental expenditures under section 174(a), for amounts paid or incurred before the section 174A amendment applies";
    when expenditure_kind(e, ResearchSection174a);
    when allowable_deduction_but_for_election(e, amount);
    when expenditure_year(e, made);
    when us.irc.core::calendar_year_of(made, n);
    when n < 2025;
    then qualified_expenditure(e);
}

@source(IRC_S59_E, relation = formalizes, coverage = exact, quote = "(B) section 174(a) (relating to research and experimental expenditures),")
rule QualifiedExpenditureDomesticResearchFrom2025(e: QualifiedExpenditure, amount: Money, made: TaxableYear, n: Integer) strict {
    label en official "section 59(e)(2)(B) as amended by Pub. L. 119-21 section 70302(b)(4): domestic research or experimental expenditures under section 174A(a), for amounts paid or incurred in taxable years beginning after December 31, 2024";
    when expenditure_kind(e, DomesticResearchSection174Aa);
    when allowable_deduction_but_for_election(e, amount);
    when expenditure_year(e, made);
    when us.irc.core::calendar_year_of(made, n);
    when n >= 2025;
    then qualified_expenditure(e);
}

pub relation expenditure_electable_by(e: QualifiedExpenditure, p: Person) kind institutional {
    label en official "the person who may make the section 59(e) election for the expenditure: the payer, or, for a partnership or S corporation, each partner or shareholder separately for the allocable share";
}

@source(IRC_S59_E, relation = formalizes, coverage = exact, quote = "An election may be made under paragraph (1) with respect to any portion of any qualified expenditure.")
rule ExpenditureElectableByPayer(e: QualifiedExpenditure, p: Person) strict {
    when expenditure_paid_by(e, p);
    when not_known(expenditure_is_partnership_or_s_corporation_expenditure(e));
    then expenditure_electable_by(e, p);
}

@source(IRC_S59_E, relation = formalizes, coverage = exact, quote = "In the case of a partnership, any election under paragraph (1) shall be made separately by each partner with respect to the partner's allocable share of any qualified expenditure. A similar rule shall apply in the case of an S corporation and its shareholders.")
rule ExpenditureElectableByEachPartner(e: QualifiedExpenditure, owner: Person) strict {
    label en official "section 59(e)(4)(C): a partnership's or S corporation's election is made separately by each partner or shareholder for the allocable share";
    when expenditure_is_partnership_or_s_corporation_expenditure(e);
    when allocable_share_of_expenditure(e, owner);
    then expenditure_electable_by(e, owner);
}

pub relation taxpayer_elects_section_59e(p: Person, e: QualifiedExpenditure) kind empirical {
    label en official "the taxpayer elects to have the expenditure allowed as a deduction ratably over the section 59(e)(1) period (the exercise)";
}
pub relation elected_portion_of_expenditure(p: Person, e: QualifiedExpenditure, amount: Money) kind empirical {
    label en official "the portion of the qualified expenditure to which the election applies (an election may be made with respect to any portion)";
}
pub relation section_59e_election_in_effect(p: Person, e: QualifiedExpenditure) kind institutional {
    label en official "an election under section 59(e)(1) applies to the qualified expenditure";
}

@source(IRC_S59_E, relation = formalizes, coverage = exact, quote = "any qualified expenditure to which an election under this paragraph applies shall be allowed as a deduction ratably over the 10-year period")
rule TaxpayerMayElect59eWriteoff defeasible {
    label en official "section 59(e)(1): the election of the ratable writeoff of a qualified expenditure";
    for p: Person;
    for e: QualifiedExpenditure;
    when expenditure_electable_by(e, p);
    then power Elect59eWriteoff {
        holder p; over e;
        exercise taxpayer_elects_section_59e(p, e);
        valid_when qualified_expenditure(e);
        effect create(section_59e_election_in_effect(p, e));
        window [-infinity, infinity];
    };
}

pub relation taxpayer_revokes_section_59e_election(p: Person, e: QualifiedExpenditure) kind empirical {
    label en official "the taxpayer revokes the section 59(e) election for the expenditure (the exercise)";
}
pub relation secretary_consents_to_revoke_59e(p: Person, e: QualifiedExpenditure) kind empirical {
    label en official "the Secretary consents to the revocation of the election";
}
pub relation section_59e_election_revoked(p: Person, e: QualifiedExpenditure) kind institutional {
    label en official "the section 59(e) election is revoked with the consent of the Secretary";
}

// Computational twins of the two powers' effects (E-0134: a power's effect is
// invisible to defeasible and `not_known` readers): the same premises as each
// `valid_when`, derived directly, are what the deduction, the prohibition and
// the preference exclusion below read.
pub relation section_59e_election_made(p: Person, e: QualifiedExpenditure) kind institutional {
    label en official "a valid election under section 59(e)(1) was made for the qualified expenditure";
}
@source(IRC_S59_E, relation = formalizes, coverage = exact, quote = "any qualified expenditure to which an election under this paragraph applies")
rule Section59eElectionMade(p: Person, e: QualifiedExpenditure) strict {
    when expenditure_electable_by(e, p);
    when taxpayer_elects_section_59e(p, e);
    when qualified_expenditure(e);
    then section_59e_election_made(p, e);
}
pub relation section_59e_election_revoked_with_consent(p: Person, e: QualifiedExpenditure) kind institutional {
    label en official "the taxpayer revoked the election and the Secretary consented";
}
@source(IRC_S59_E, relation = formalizes, coverage = exact, quote = "Any election under this subsection may be revoked only with the consent of the Secretary.")
rule Section59eRevokedWithConsent(p: Person, e: QualifiedExpenditure) strict {
    when taxpayer_revokes_section_59e_election(p, e);
    when secretary_consents_to_revoke_59e(p, e);
    then section_59e_election_revoked_with_consent(p, e);
}
pub relation section_59e_election_applies(p: Person, e: QualifiedExpenditure) kind institutional {
    label en official "an election under section 59(e)(1) applies to the qualified expenditure (made, and not revoked with the Secretary's consent)";
}
rule Section59eElectionApplies(p: Person, e: QualifiedExpenditure) strict {
    when section_59e_election_made(p, e);
    when not_known(section_59e_election_revoked_with_consent(p, e));
    then section_59e_election_applies(p, e);
}

@source(IRC_S59_E, relation = formalizes, coverage = exact, quote = "Any election under this subsection may be revoked only with the consent of the Secretary.")
rule TaxpayerMayRevoke59eElectionWithConsent defeasible {
    label en official "section 59(e)(4)(B): the election is revocable only with the consent of the Secretary";
    for p: Person;
    for e: QualifiedExpenditure;
    when section_59e_election_made(p, e);
    then power Revoke59eElection {
        holder p; over e;
        exercise taxpayer_revokes_section_59e_election(p, e);
        valid_when secretary_consents_to_revoke_59e(p, e);
        effect create(section_59e_election_revoked(p, e));
        window [-infinity, infinity];
    };
}

pub relation claims_deduction_under_other_section(p: Person, e: QualifiedExpenditure) kind empirical {
    label en official "the taxpayer claims a deduction for the expenditure under a section other than section 59(e)";
}

@source(IRC_S59_E, relation = formalizes, coverage = exact, quote = "Except as provided in this subsection, no deduction shall be allowed under any other section for any qualified expenditure to which an election under this subsection applies.")
rule S59eNoDeductionUnderOtherSection strict {
    label en official "section 59(e)(3): no deduction is allowed under any other section for an expenditure to which the election applies; a claim of one breaches the prohibition (VIOLATED on the prohibition itself, E-0179)";
    for p: Person;
    for e: QualifiedExpenditure;
    when section_59e_election_applies(p, e);
    then prohibition NoOtherSectionDeductionForElectedExpenditure {
        bearer p;
        action claims_deduction_under_other_section(p, e);
        window [-infinity, infinity];
    };
}

relation ten_year_expenditure(e: QualifiedExpenditure) kind institutional {
    label en unofficial "a qualified expenditure written off over 10 years (research, mining development, mining exploration)";
}
@source(IRC_S59_E, relation = formalizes, coverage = partial, quote = "any qualified expenditure to which an election under this paragraph applies shall be allowed as a deduction ratably over the 10-year period (3-year period in the case of circulation expenditures described in section 173)")
rule TenYearExpenditureResearch(e: QualifiedExpenditure) strict {
    when expenditure_kind(e, ResearchSection174a);
    then ten_year_expenditure(e);
}
@source(IRC_S59_E, relation = formalizes, coverage = partial, quote = "any qualified expenditure to which an election under this paragraph applies shall be allowed as a deduction ratably over the 10-year period (3-year period in the case of circulation expenditures described in section 173)")
rule TenYearExpenditureDomesticResearch(e: QualifiedExpenditure) strict {
    when expenditure_kind(e, DomesticResearchSection174Aa);
    then ten_year_expenditure(e);
}
@source(IRC_S59_E, relation = formalizes, coverage = partial, quote = "any qualified expenditure to which an election under this paragraph applies shall be allowed as a deduction ratably over the 10-year period (3-year period in the case of circulation expenditures described in section 173)")
rule TenYearExpenditureDevelopment(e: QualifiedExpenditure) strict {
    when expenditure_kind(e, DevelopmentSection616a);
    then ten_year_expenditure(e);
}
@source(IRC_S59_E, relation = formalizes, coverage = partial, quote = "any qualified expenditure to which an election under this paragraph applies shall be allowed as a deduction ratably over the 10-year period (3-year period in the case of circulation expenditures described in section 173)")
rule TenYearExpenditureMiningExploration(e: QualifiedExpenditure) strict {
    when expenditure_kind(e, MiningExplorationSection617a);
    then ten_year_expenditure(e);
}

pub relation section_59e_deduction(p: Person, y: TaxableYear, e: QualifiedExpenditure, amount: Money) kind institutional {
    label en official "the deduction allowed for the taxable year for an expenditure to which the section 59(e) election applies";
}

@source(IRC_S59_E, relation = formalizes, coverage = partial, quote = "shall be allowed as a deduction ratably over the 10-year period (3-year period in the case of circulation expenditures described in section 173) beginning with the taxable year in which such expenditure was made")
rule Section59eRatableDeductionTenYears(p: Person, y: TaxableYear, e: QualifiedExpenditure, made: TaxableYear, n0: Integer, n: Integer, elected: Money) strict {
    label en official "section 59(e)(1): one tenth of the elected portion in each of the 10 calendar years beginning with the year the expenditure was made (calendar-year taxpayers)";
    when section_59e_election_applies(p, e);
    when ten_year_expenditure(e);
    when elected_portion_of_expenditure(p, e, elected);
    when expenditure_year(e, made);
    when us.irc.core::calendar_year_of(made, n0);
    when us.irc.core::calendar_year_of(y, n);
    when n >= n0;
    when n < n0 + 10;
    then section_59e_deduction(p, y, e, div_round(elected, 10.0, 10, "HALF_UP"));
}

@source(IRC_S59_E, relation = formalizes, coverage = partial, quote = "(3-year period in the case of circulation expenditures described in section 173)")
rule Section59eRatableDeductionCirculationThreeYears(p: Person, y: TaxableYear, e: QualifiedExpenditure, made: TaxableYear, n0: Integer, n: Integer, elected: Money) strict {
    label en official "section 59(e)(1): one third of the elected circulation expenditure in each of the 3 calendar years beginning with the year it was made (calendar-year taxpayers)";
    when section_59e_election_applies(p, e);
    when expenditure_kind(e, CirculationSection173);
    when elected_portion_of_expenditure(p, e, elected);
    when expenditure_year(e, made);
    when us.irc.core::calendar_year_of(made, n0);
    when us.irc.core::calendar_year_of(y, n);
    when n >= n0;
    when n < n0 + 3;
    then section_59e_deduction(p, y, e, div_round(elected, 3.0, 10, "HALF_UP"));
}

pub relation excluded_from_preference_and_section_56(p: Person, e: QualifiedExpenditure) kind institutional {
    label en official "the elected portion is not an item of tax preference under section 57(a) and section 56 does not apply to it";
}

@source(IRC_S59_E, relation = formalizes, coverage = exact, quote = "Any portion of any qualified expenditure to which an election under paragraph (1) applies shall not be treated as an item of tax preference under section 57(a) and section 56 shall not apply to such expenditure.")
rule ElectedExpenditureNotPreferenceNorAdjustment strict {
    label en official "section 59(e)(6): an elected expenditure is neither a section 57(a) preference nor a section 56 adjustment";
    for p: Person;
    for e: QualifiedExpenditure;
    when section_59e_election_applies(p, e);
    then excluded_from_preference_and_section_56(p, e);
}

// --- Section 59(i): amounts still wholly exempt -------------------------------

pub relation wholly_exempt_apart_from_amt(i: AmtItem) kind empirical {
    label en official "the amount is wholly exempt from the tax imposed by subtitle A apart from its inclusion in alternative minimum taxable income";
}
pub relation treated_as_wholly_exempt_from_tax(i: AmtItem) kind institutional {
    label en official "the amount is treated as wholly exempt from tax imposed by subtitle A (for provisions of the subtitle other than part VI)";
}

@source(IRC_S59_I, relation = formalizes, coverage = exact, quote = "any amount shall not fail to be treated as wholly exempt from tax imposed by this subtitle solely by reason of being included in alternative minimum taxable income.")
rule InclusionInAmtiDoesNotDefeatExemption(i: AmtItem) strict {
    label en official "section 59(i): inclusion in alternative minimum taxable income alone does not make an exempt amount non-exempt for the rest of the subtitle";
    when wholly_exempt_apart_from_amt(i);
    then treated_as_wholly_exempt_from_tax(i);
}

// --- Section 59(j): unearned income of minor children --------------------------

pub relation child_amt_exemption_cap(child: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the most the exemption amount of a child to whom section 1(g) applies may be for purposes of section 55: the child's earned income plus the dollar amount";
}

@source(IRC_S59_J, relation = formalizes, coverage = exact, quote = "In the case of a child to whom section 1(g) applies, the exemption amount for purposes of section 55 shall not exceed the sum of—")
rule ChildAmtExemptionCapRule(child: Person, y: TaxableYear, earned: Money) strict {
    label en official "section 59(j)(1): earned income + $5,000 (as pinned; section 55(d)(4)(A)(iii) turns the subsection off for taxable years beginning after 2017)";
    effective [@1998-01-01, @2018-01-01);
    when kiddie_tax_applies(child, y);
    when earned_income(child, y, earned);
    then child_amt_exemption_cap(child, y, earned + AmtChildExemptionAddend);
}

relation has_child_amt_exemption_cap(p: Person, y: TaxableYear) kind institutional {
    label en unofficial "a section 59(j) cap applies to the taxpayer's exemption for the year";
}
rule HasChildAmtExemptionCap(p: Person, y: TaxableYear) strict {
    when child_amt_exemption_cap(p, y, _);
    then has_child_amt_exemption_cap(p, y);
}

pub relation amt_exemption_final(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the exemption amount for the taxable year after the section 55(d)(2) reduction and any section 59(j) cap";
}

@source(IRC_S59_J, relation = formalizes, coverage = exact, quote = "the exemption amount for purposes of section 55 shall not exceed the sum of—")
rule AmtExemptionFinalWithChildCap(p: Person, y: TaxableYear, after: Money, cap: Money) strict {
    label en official "section 59(j)(1): the exemption is the lesser of the phased-out exemption and the child cap";
    when amt_exemption_after_phaseout(p, y, after);
    when child_amt_exemption_cap(p, y, cap);
    then amt_exemption_final(p, y, min(after, cap));
}

@source(IRC_S55_D, relation = formalizes, coverage = partial, quote = "The exemption amount of any taxpayer shall be reduced (but not below zero) by an amount equal to 25 percent")
rule AmtExemptionFinalWithoutChildCap(p: Person, y: TaxableYear, after: Money) strict {
    label en official "no section 59(j) cap applies: the phased-out exemption stands";
    when amt_exemption_after_phaseout(p, y, after);
    when not_known(has_child_amt_exemption_cap(p, y));
    then amt_exemption_final(p, y, after);
}

// --- Regulatory mandates and powers of the Secretary --------------------------

const AdjustmentsToAfsiMandate: RegulatoryMandate = entity_ref("urn:us:irc:income_individual:clir#Mandate56Ac15") {
    label en official "such adjustments to adjusted financial statement income as the Secretary determines necessary to prevent the omission or duplication of any item and to carry out the principles of the corporate subchapters (section 56A(c)(15))";
}
assert provision_mandates_secretary_rules(AdjustmentsToAfsiMandate);

const AvoidanceRegulationsMandate: RegulatoryMandate = entity_ref("urn:us:irc:income_individual:clir#Mandate56Ac10B") {
    label en official "regulations to prevent the avoidance of taxes with respect to amounts not representing reasonable mortgage servicing income (section 56A(c)(10)(B))";
}
assert provision_mandates_secretary_rules(AvoidanceRegulationsMandate);

const Section56AGeneralMandate: RegulatoryMandate = entity_ref("urn:us:irc:income_individual:clir#Mandate56Ae") {
    label en official "such regulations and other guidance as necessary to carry out the purposes of section 56A (section 56A(e))";
}
assert provision_mandates_secretary_rules(Section56AGeneralMandate);

const ApplicableCorporationGuidanceMandate: RegulatoryMandate = entity_ref("urn:us:irc:income_individual:clir#Mandate59k3") {
    label en official "regulations or other guidance for the purposes of carrying out section 59(k), including a simplified method and rules for a corporation with a change in ownership (section 59(k)(3))";
}
assert provision_mandates_secretary_rules(ApplicableCorporationGuidanceMandate);

const ForeignParentedGroupRulesMandate: RegulatoryMandate = entity_ref("urn:us:irc:income_individual:clir#Mandate59k2D") {
    label en official "rules for the application of the foreign-parented multinational group paragraph (section 59(k)(2)(D))";
}
assert provision_mandates_secretary_rules(ForeignParentedGroupRulesMandate);

const CamtForeignTaxCreditGuidanceMandate: RegulatoryMandate = entity_ref("urn:us:irc:income_individual:clir#Mandate59l3") {
    label en official "regulations or other guidance necessary to carry out the purposes of section 59(l) (section 59(l)(3))";
}
assert provision_mandates_secretary_rules(CamtForeignTaxCreditGuidanceMandate);

@source(IRC_S56A_C, relation = formalizes, coverage = exact, quote = "The Secretary shall issue regulations or other guidance to provide for such adjustments to adjusted financial statement income as the Secretary determines necessary")
rule SecretaryIssuesAfsiAdjustmentGuidance defeasible {
    label en official "section 56A(c)(15): the Secretary shall issue regulations or other guidance for adjustments to adjusted financial statement income (no time fixed: an achievement goal over an open window)";
    for m: RegulatoryMandate;
    when provision_mandates_secretary_rules(m);
    when m == AdjustmentsToAfsiMandate;
    then duty AfsiAdjustmentGuidanceDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition secretary_has_prescribed_rules(m);
            window [-infinity, infinity];
        }
    };
}

@source(IRC_S56A_C, relation = formalizes, coverage = exact, quote = "The Secretary shall provide regulations to prevent the avoidance of taxes imposed by this chapter with respect to amounts not representing reasonable")
rule SecretaryProvidesMortgageServicingAvoidanceRegulations defeasible {
    label en official "section 56A(c)(10)(B): the Secretary shall provide regulations to prevent avoidance (open window)";
    for m: RegulatoryMandate;
    when provision_mandates_secretary_rules(m);
    when m == AvoidanceRegulationsMandate;
    then duty MortgageServicingAvoidanceRegulationsDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition secretary_has_prescribed_rules(m);
            window [-infinity, infinity];
        }
    };
}

@source(IRC_S56A_E, relation = formalizes, coverage = exact, quote = "The Secretary shall provide for such regulations and other guidance as necessary to carry out the purposes of this section")
rule SecretaryProvidesSection56AGuidance defeasible {
    label en official "section 56A(e): the Secretary shall provide regulations and other guidance necessary to carry out section 56A (open window)";
    for m: RegulatoryMandate;
    when provision_mandates_secretary_rules(m);
    when m == Section56AGeneralMandate;
    then duty Section56AGuidanceDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition secretary_has_prescribed_rules(m);
            window [-infinity, infinity];
        }
    };
}

@source(IRC_S59_K, relation = formalizes, coverage = exact, quote = "The Secretary shall provide regulations or other guidance for the purposes of carrying out this subsection")
rule SecretaryProvidesApplicableCorporationGuidance defeasible {
    label en official "section 59(k)(3): the Secretary shall provide regulations or other guidance for carrying out the applicable corporation subsection (open window)";
    for m: RegulatoryMandate;
    when provision_mandates_secretary_rules(m);
    when m == ApplicableCorporationGuidanceMandate;
    then duty ApplicableCorporationGuidanceDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition secretary_has_prescribed_rules(m);
            window [-infinity, infinity];
        }
    };
}

@source(IRC_S59_K, relation = formalizes, coverage = exact, quote = "The Secretary shall, applying the principles of this section, prescribe rules for the application of this paragraph")
rule SecretaryPrescribesForeignParentedGroupRules defeasible {
    label en official "section 59(k)(2)(D): the Secretary shall prescribe rules for the foreign-parented multinational group paragraph (open window)";
    for m: RegulatoryMandate;
    when provision_mandates_secretary_rules(m);
    when m == ForeignParentedGroupRulesMandate;
    then duty ForeignParentedGroupRulesDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition secretary_has_prescribed_rules(m);
            window [-infinity, infinity];
        }
    };
}

@source(IRC_S59_L, relation = formalizes, coverage = exact, quote = "The Secretary shall provide for such regulations or other guidance as is necessary to carry out the purposes of this subsection.")
rule SecretaryProvidesCamtForeignTaxCreditGuidance defeasible {
    label en official "section 59(l)(3): the Secretary shall provide regulations or other guidance necessary to carry out the CAMT foreign tax credit subsection (open window)";
    for m: RegulatoryMandate;
    when provision_mandates_secretary_rules(m);
    when m == CamtForeignTaxCreditGuidanceMandate;
    then duty CamtForeignTaxCreditGuidanceDuty {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition secretary_has_prescribed_rules(m);
            window [-infinity, infinity];
        }
    };
}

// Section 59(g): "The Secretary may prescribe regulations under which
// differently treated items shall be properly adjusted where the tax treatment
// giving rise to such items will not result in the reduction of the taxpayer's
// regular tax ..." — a power, not a duty.
entity TaxBenefitMatter {
    label en unofficial "a class of differently treated items whose tax treatment does not reduce the taxpayer's regular tax";
}
pub relation treatment_does_not_reduce_regular_tax(m: TaxBenefitMatter) kind empirical {
    label en official "the tax treatment giving rise to the differently treated items will not result in the reduction of the taxpayer's regular tax for the taxable year for which the item is taken into account or for any other taxable year";
}
pub relation secretary_prescribes_tax_benefit_regulations(m: TaxBenefitMatter) kind empirical {
    label en unofficial "the Secretary prescribes regulations under which the differently treated items are properly adjusted (the exercise)";
}
pub relation tax_benefit_adjustment_regulation_in_force(m: TaxBenefitMatter) kind institutional {
    label en unofficial "a regulation adjusting the differently treated items of this class is validly in force under section 59(g)";
}

@source(IRC_S59_G, relation = formalizes, coverage = exact, quote = "The Secretary may prescribe regulations under which differently treated items shall be properly adjusted")
rule SecretaryMayPrescribeTaxBenefitRegulations defeasible {
    label en official "section 59(g): the Secretary may prescribe regulations properly adjusting differently treated items where the treatment will not reduce the regular tax";
    for m: TaxBenefitMatter;
    when treatment_does_not_reduce_regular_tax(m);
    then power SecretaryPrescribesTaxBenefitRuleRegulations {
        holder us.irc.core::Secretary; over m;
        exercise secretary_prescribes_tax_benefit_regulations(m);
        valid_when treatment_does_not_reduce_regular_tax(m);
        effect create(tax_benefit_adjustment_regulation_in_force(m));
        window [-infinity, infinity];
    };
}
