use self::{
    IRC_S1_F,
    TaxableYear,
};

// Section 1(f): the annual inflation-adjustment MECHANISM (COLA) and its
// rounding rule; Section 1(i): the post-2000 rate-bracket reductions that
// §1(j)(1)(A) suspends for taxable years this package's scenarios fall in.
//
// TECH_GAP (declared, not hidden): §1(f)(1)-(6) describe a formula computing
// a percentage from C-CPI-U/CPI index VALUES the Bureau of Labor Statistics
// publishes and the Secretary applies through a Revenue Procedure. No such
// dataset is pinned in this task's sources (`SOURCE-MANIFEST.json` pins only
// Title 26 text and one Public Law). An `.lawparam.json` A3 dataset requires
// at least one `values[]` row (`spec/schema/parameter-dataset.schema.json`,
// `minItems: 1`); this package will NOT fabricate a placeholder number to
// satisfy that shape (AGENT-BRIEF: "Never invent a rate, a date or a
// threshold"). Consequence: `cost_of_living_adjustment_amount` below is
// declared but never derivable in this stage, so every scenario that needs
// a POST-2018 inflation-adjusted bracket boundary is UNDETERMINED with
// `why_not` naming this relation — not zero, not the 2018 base amount
// silently reused. The 2018 unadjusted TCJA amounts in `rates.law` are the
// statutory floor `.lawtable.json`s already encode; they are NOT what the
// IRS actually published for 2019-2026 taxable years, and this package does
// not claim otherwise.
pub relation cost_of_living_adjustment_amount(base_amount: Money, y: TaxableYear, adjusted: Money) kind institutional {
    label en official "increasing the minimum and maximum dollar amounts for each bracket ... by the cost-of-living adjustment for such calendar year";
}

// §1(f)(7)(A): the rounding rule IS executable once an (unrounded) increase
// is known — it just never fires in this stage because the increase above
// is never derived. Modelled so the norm exists for the day a COLA dataset
// is pinned.
pub relation rounded_cola_increase(raw_increase: Money, rounded: Money) kind institutional {
    label en official "if any increase ... is not a multiple of $50, such increase shall be rounded to the next lowest multiple of $50";
}

@source(IRC_S1_F, quote = "If any increase determined under paragraph (2)(A), section 63(c)(4), section 68(b)(2) or section 151(d)(4) is not a multiple of $50, such increase shall be rounded to the next lowest multiple of $50.")
rule RoundColaIncreaseToNearestFifty(raw: Money, rounded: Money) strict {
    label en official "such increase shall be rounded to the next lowest multiple of $50";
    when floor_to_multiple(raw, 50, rounded);
    then rounded_cola_increase(raw, rounded);
}

// `floor_to_multiple` is the general "round down to the nearest multiple of
// N" computation the statute's rounding RULE names (bracket/threshold, not
// N itself) — this is exactly the kind of general computational primitive
// DECISION-0123 routes to `packs/primitives/`. No existing primitive of this
// exact shape was found in `docs/catalogs/COMPUTATIONAL-PRIMITIVES-CATALOG.
// ru.md` during this stage's read; declared here as a local institutional
// dependency contract rather than inventing a cross-corpus primitives
// package unilaterally (recorded in DEPENDENCIES.json as `owner: unresolved,
// candidate: packs/primitives`).
relation floor_to_multiple(raw: Money, step: Integer, rounded: Money) kind institutional {
    label en unofficial "rounded down to the nearest multiple of step";
}

// §1(f)(7)(B) (the $25, not $50, rounding unit for married-separate returns)
// is a further condition on the SAME rounding rule; not modelled as its own
// rule in this stage (classified INTERPRETATION: it depends on the same
// undelivered COLA increase as the general rule).

// §1(f)(8) (elimination of the marriage penalty in the 15-percent bracket)
// modifies how the (now largely superseded, pre-2018) §1(a)/(d) tables are
// INDEXED — again downstream of the same missing COLA dataset. TECH_GAP,
// same reproduction as above.

// --- Section 1(i): rate reductions after 2000 --------------------------------
//
// §1(i) is switched OFF for every taxable year this package's scenarios
// cover (2024, 2025, 2026): §1(j)(1)(A) ("subsection (i) shall not apply")
// governs every taxable year beginning after December 31, 2017, and Pub. L.
// 119-21 made that suspension permanent (see `rates.law`). §1(i) therefore
// classifies as: EXECUTABLE text describing a real historical rule (taxable
// years 2001-2017), but NOT MODELLED to an executable rule in this stage —
// implementing it would require a second, parallel bracket-substitution
// table set (10%% initial bracket, 25/28/33%% rate relabeling of the 1986
// table, the 2013 35%% high-income bracket) whose ONLY operative window lies
// entirely outside this package's assigned scenario years. Recorded as
// `TECH_GAP` with the minimal reproduction: "a scenario dated in taxable
// year 2010 (or any year in [2001-01-01, 2018-01-01)) needing the actual
// section 1(i) bracket amounts finds no rule deriving them here." Revisit if
// a future stage extends this package's scenario years to before 2018.
// §1(j)(1)(A) ("subsection (i) shall not apply") is modelled directly in
// `rates.law`: the TCJA table rules there are the operative schedule for
// every taxable year from 2018 onward, so §1(a)-(e) as further modified by
// §1(i) never reaches a scenario in this package's assigned years. A
// separate `rate_reductions_after_2000_suppressed` relation was considered
// and dropped: it would only restate the same temporal fact `rates.law`'s
// `effective` windows already encode, without adding an independently
// checkable consequence.
