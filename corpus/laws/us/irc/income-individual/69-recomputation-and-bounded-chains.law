// Stage 4 (26.09.2026, DECISION-0379 with deontics): the TECH_GAP rows of income-individual G5500-G5508.
//
// TECHNIQUE. Two devices, both bounded and both stated in the coverage rows:
//  (1) A parallel rule set over the rate tables (a RERUN of section 1 at another income). The tax of section 1 is keyed
//      by a (person, year) pair whose taxable income the case asserts (`taxable_income`), so it cannot be asked at
//      another income. The ten rate tables are decision tables that answer for any income; this module repeats only the
//      arithmetic of the table wording ("base tax plus the rate times the excess over the lower bound", rule
//      `TaxUnderTable*` of `rates.law`) over a REQUESTED income (`requested_income_1993` / `requested_income_tcja`,
//      the device of `amount_to_index`: the request tuple binds every head variable). The pinned tables are the 1993
//      base table and the 2018 unindexed TCJA amounts, exactly what `tax_under_section_1` reads.
//  (2) Year-to-year chains as UNROLLED predicates over a chain of years the case orders (`..._chain_year(k, y)`,
//      k = 1 the earliest): a predicate cannot feed itself across years (LDC-E4102), but step k of the chain is its own
//      predicate reading step k-1. The bound is stated at each chain (three years for the CFC adjustment, the financial
//      statement net operating loss and the farm loss; three loss years by four deduction years for the alternative tax
//      net operating loss; six years for the corporate AMT foreign tax credit, which covers the "first 5 succeeding
//      taxable years"). A case whose chain is longer is outside the bound (recorded in TECH-GAPS G6706).
//
// The consumers of the pre-existing rules stay: a year outside a chain keeps the asserted-carryover reading of stage 3.

language "law.core" version "0.2";
package us.irc.income_individual version "0.1.1";
namespace "urn:us:irc:income_individual:clir";

use self::{
    AmtAdjustmentKind,
    Corporation,
    FilingStatus,
    IRC_S15_A,
    IRC_S1_A,
    IRC_S1_G,
    IRC_S56A_C,
    IRC_S56A_D,
    IRC_S56_B,
    IRC_S56_D,
    IRC_S58_A,
    IRC_S59_L,
    Indebtedness,
    Individual,
    Person,
    RateChange,
    TaxableYear,
    adjusted_financial_statement_income,
    afsi_before_nol_deduction,
    amt_adjustment,
    amti_before_atnol_and_section_199,
    applicable_corporation,
    atnol_attributable_to_elected_applicable_loss,
    atnol_deduction,
    bracket_1986_estate_trust,
    bracket_1986_hoh,
    bracket_1986_joint,
    bracket_1986_married_separate,
    bracket_1986_unmarried,
    bracket_tcja_estate_trust,
    bracket_tcja_hoh,
    bracket_tcja_joint,
    bracket_tcja_married_separate,
    bracket_tcja_unmarried,
    cfc_adjustment_determined,
    cfc_foreign_taxes_pro_rata_share,
    cfc_pro_rata_share_of_items,
    corporate_amt_foreign_tax_credit,
    corporation_chooses_foreign_tax_credit_benefits,
    farm_loss_carried_in_total,
    farm_loss_current_total,
    farm_loss_subject_to_denial,
    filing_status,
    financial_statement_nol_carryovers,
    has_cfc_shareholding,
    has_electing_child,
    insolvency_amount,
    investment_interest_for_amt,
    loss_year_begins_on,
    noncorporate_taxpayer_for_year,
    own_foreign_taxes_on_financial_statement,
    pab_interest_includible_for_163d,
    pab_related_deduction_for_163d,
    parent_gross_income_inclusion_from_child,
    parent_tax_after_child_income_inclusion,
    qualified_housing_interest_on,
    rate_change_effective_date,
    rate_change_prorates_year,
    section_56a_c3_adjustment,
    taxable_income,
    tentative_tax_after_change,
    tentative_tax_before_change,
    united_states_shareholder_of_cfc,
};

// ============================================================================
// Section 1 at a requested income (parallel rule set over the rate tables)
// ============================================================================

pub relation requested_income_1993(p: Person, y: TaxableYear, income: Money) kind institutional {
    label en unofficial "the taxable income at which the tax of section 1 is recomputed under the 1993 base table (produced by the recomputation rules of this module)";
}
pub relation requested_income_tcja(p: Person, y: TaxableYear, income: Money) kind institutional {
    label en unofficial "the taxable income at which the tax of section 1 is recomputed under the TCJA table of section 1(j)(2) (produced by the recomputation rules of this module)";
}
pub relation tax_at_income_1993_table(p: Person, y: TaxableYear, income: Money, tax: Money) kind institutional {
    label en unofficial "the tax of section 1(a)-(e) at the requested income under the 1993 base table and the filing status of the person";
}
pub relation tax_at_income_tcja_table(p: Person, y: TaxableYear, income: Money, tax: Money) kind institutional {
    label en unofficial "the tax of section 1(j)(2) at the requested income under the TCJA table and the filing status of the person";
}
pub relation hypothetical_tax_1(p: Person, y: TaxableYear, income: Money, tax: Money) kind institutional {
    label en unofficial "the tax of section 1 at the requested income under the table of the year (the 1993 table for a year that begins before 2018, the TCJA table from 2018)";
}
@source(IRC_S1_A)
rule Tax1993AtJoint(p: Person, y: TaxableYear, income: Money, lower: Money, base: Money, rate: Decimal) strict {
    label en unofficial "1993 table, Joint: base tax plus the rate times the excess over the lower bound at the requested income";
    when requested_income_1993(p, y, income);
    when filing_status(p, y, Joint);
    when bracket_1986_joint(income, lower, base, rate);
    then tax_at_income_1993_table(p, y, income, base + rate * (income - lower));
}
@source(IRC_S1_A)
rule TaxTcjaAtJoint(p: Person, y: TaxableYear, income: Money, lower: Money, base: Money, rate: Decimal) strict {
    label en unofficial "Tcja table, Joint: base tax plus the rate times the excess over the lower bound at the requested income";
    when requested_income_tcja(p, y, income);
    when filing_status(p, y, Joint);
    when bracket_tcja_joint(income, lower, base, rate);
    then tax_at_income_tcja_table(p, y, income, base + rate * (income - lower));
}
@source(IRC_S1_A)
rule Tax1993AtHeadOfHousehold(p: Person, y: TaxableYear, income: Money, lower: Money, base: Money, rate: Decimal) strict {
    label en unofficial "1993 table, HeadOfHousehold: base tax plus the rate times the excess over the lower bound at the requested income";
    when requested_income_1993(p, y, income);
    when filing_status(p, y, HeadOfHousehold);
    when bracket_1986_hoh(income, lower, base, rate);
    then tax_at_income_1993_table(p, y, income, base + rate * (income - lower));
}
@source(IRC_S1_A)
rule TaxTcjaAtHeadOfHousehold(p: Person, y: TaxableYear, income: Money, lower: Money, base: Money, rate: Decimal) strict {
    label en unofficial "Tcja table, HeadOfHousehold: base tax plus the rate times the excess over the lower bound at the requested income";
    when requested_income_tcja(p, y, income);
    when filing_status(p, y, HeadOfHousehold);
    when bracket_tcja_hoh(income, lower, base, rate);
    then tax_at_income_tcja_table(p, y, income, base + rate * (income - lower));
}
@source(IRC_S1_A)
rule Tax1993AtUnmarried(p: Person, y: TaxableYear, income: Money, lower: Money, base: Money, rate: Decimal) strict {
    label en unofficial "1993 table, Unmarried: base tax plus the rate times the excess over the lower bound at the requested income";
    when requested_income_1993(p, y, income);
    when filing_status(p, y, Unmarried);
    when bracket_1986_unmarried(income, lower, base, rate);
    then tax_at_income_1993_table(p, y, income, base + rate * (income - lower));
}
@source(IRC_S1_A)
rule TaxTcjaAtUnmarried(p: Person, y: TaxableYear, income: Money, lower: Money, base: Money, rate: Decimal) strict {
    label en unofficial "Tcja table, Unmarried: base tax plus the rate times the excess over the lower bound at the requested income";
    when requested_income_tcja(p, y, income);
    when filing_status(p, y, Unmarried);
    when bracket_tcja_unmarried(income, lower, base, rate);
    then tax_at_income_tcja_table(p, y, income, base + rate * (income - lower));
}
@source(IRC_S1_A)
rule Tax1993AtMarriedSeparate(p: Person, y: TaxableYear, income: Money, lower: Money, base: Money, rate: Decimal) strict {
    label en unofficial "1993 table, MarriedSeparate: base tax plus the rate times the excess over the lower bound at the requested income";
    when requested_income_1993(p, y, income);
    when filing_status(p, y, MarriedSeparate);
    when bracket_1986_married_separate(income, lower, base, rate);
    then tax_at_income_1993_table(p, y, income, base + rate * (income - lower));
}
@source(IRC_S1_A)
rule TaxTcjaAtMarriedSeparate(p: Person, y: TaxableYear, income: Money, lower: Money, base: Money, rate: Decimal) strict {
    label en unofficial "Tcja table, MarriedSeparate: base tax plus the rate times the excess over the lower bound at the requested income";
    when requested_income_tcja(p, y, income);
    when filing_status(p, y, MarriedSeparate);
    when bracket_tcja_married_separate(income, lower, base, rate);
    then tax_at_income_tcja_table(p, y, income, base + rate * (income - lower));
}
@source(IRC_S1_A)
rule Tax1993AtEstateOrTrust(p: Person, y: TaxableYear, income: Money, lower: Money, base: Money, rate: Decimal) strict {
    label en unofficial "1993 table, EstateOrTrust: base tax plus the rate times the excess over the lower bound at the requested income";
    when requested_income_1993(p, y, income);
    when filing_status(p, y, EstateOrTrust);
    when bracket_1986_estate_trust(income, lower, base, rate);
    then tax_at_income_1993_table(p, y, income, base + rate * (income - lower));
}
@source(IRC_S1_A)
rule TaxTcjaAtEstateOrTrust(p: Person, y: TaxableYear, income: Money, lower: Money, base: Money, rate: Decimal) strict {
    label en unofficial "Tcja table, EstateOrTrust: base tax plus the rate times the excess over the lower bound at the requested income";
    when requested_income_tcja(p, y, income);
    when filing_status(p, y, EstateOrTrust);
    when bracket_tcja_estate_trust(income, lower, base, rate);
    then tax_at_income_tcja_table(p, y, income, base + rate * (income - lower));
}
rule HypotheticalTax1993Year(p: Person, y: TaxableYear, income: Money, tax: Money) strict {
    label en unofficial "the year begins before 2018: the 1993 table answers";
    when tax_at_income_1993_table(p, y, income, tax);
    then hypothetical_tax_1(p, y, income, tax);
}
rule HypotheticalTaxTcjaYear(p: Person, y: TaxableYear, income: Money, tax: Money) strict {
    label en unofficial "the year begins in 2018 or later: the TCJA table answers";
    when tax_at_income_tcja_table(p, y, income, tax);
    then hypothetical_tax_1(p, y, income, tax);
}
pub relation hypothetical_income_request_1(p: Person, y: TaxableYear, income: Money) kind institutional {
    label en unofficial "the taxable income at which the tax of section 1 of the year is recomputed (produced by the recomputation rules of this module; the era of the year decides the table)";
}
rule RequestIncome1993ByYear(p: Person, y: TaxableYear, income: Money, d: Date) strict {
    when hypothetical_income_request_1(p, y, income);
    when us.irc.core::begins(y, d);
    when d < @2018-01-01;
    then requested_income_1993(p, y, income);
}
rule RequestIncomeTcjaByYear(p: Person, y: TaxableYear, income: Money, d: Date) strict {
    when hypothetical_income_request_1(p, y, income);
    when us.irc.core::begins(y, d);
    when d >= @2018-01-01;
    then requested_income_tcja(p, y, income);
}

// ============================================================================
// §1(g)(7)(B)(ii)(I): the tax of the parent on the taxable income increased by the included income of the children
// ============================================================================

pub relation parent_taxable_income_with_child_inclusion(parent: Individual, y: TaxableYear, income: Money) kind institutional {
    label en official "the taxable income of the parent after the gross income of the electing children is included (section 1(g)(7)(B)(i)): the taxable income plus the included amounts (JUDGMENT CALL: the included gross income raises taxable income dollar for dollar)";
}
@source(IRC_S1_G, relation = formalizes, coverage = exact, quote = "(i) the gross income of each child to whom such election applies (to the extent the gross income of such child exceeds twice the amount described in paragraph (4)(A)(ii)(I)) shall be included in such parent's gross income for the taxable year,")
rule ParentTaxableIncomeWithChildInclusion(parent: Individual, y: TaxableYear, ti: Money) strict {
    label en official "section 1(g)(7)(B)(i): taxable income plus the total inclusion";
    when has_electing_child(parent, y);
    when taxable_income(parent, y, ti);
    then parent_taxable_income_with_child_inclusion(parent, y, ti + sum all amount: Money for child: Person where parent_gross_income_inclusion_from_child(parent, child, y, amount));
}
@source(IRC_S1_G, relation = formalizes, coverage = exact, quote = "(I) the amount determined under this section after the application of clause (i), plus")
rule RequestParentIncomeAfterInclusion(parent: Individual, y: TaxableYear, income: Money) strict {
    label en official "the tax at the increased income is requested";
    when parent_taxable_income_with_child_inclusion(parent, y, income);
    then hypothetical_income_request_1(parent, y, income);
}
@source(IRC_S1_G, relation = formalizes, coverage = exact, quote = "(I) the amount determined under this section after the application of clause (i), plus")
rule ParentTaxAfterChildInclusionComputed(parent: Individual, y: TaxableYear, income: Money, tax: Money) strict {
    label en official "section 1(g)(7)(B)(ii)(I): the tax imposed by section 1 on the parent's income after the inclusion (a second evaluation of the table at another income)";
    when parent_taxable_income_with_child_inclusion(parent, y, income);
    when hypothetical_tax_1(parent, y, income, tax);
    then parent_tax_after_child_income_inclusion(parent, y, tax);
}

// ============================================================================
// §15(a)(1)-(2): the two tentative taxes of a rate change, for the change that the pinned tables carry
// ============================================================================
// The only enacted change of the rates of section 1 that the pinned tables carry is the 2018 change (1993 base table to
// the TCJA table): for a change whose effective date is 2018-01-01 the tentative tax before is the 1993 table at the
// taxable income of the whole year and the tentative tax after is the TCJA table at the same income. Any other change
// keeps the typed contracts `tentative_tax_before_change` / `tentative_tax_after_change` (no rate is invented).

@source(IRC_S15_A, relation = formalizes, coverage = exact, quote = "(1) tentative taxes shall be computed by applying the rate for the period before the effective date of the change, and the rate for the period on and after such date, to the taxable income for the entire taxable year; and")
rule RequestTaxableIncomeBeforeTcjaChange(p: Person, y: TaxableYear, chg: RateChange, eff: Date, ti: Money) strict {
    label en official "section 15(a)(1): the whole-year taxable income is run through the rate before the change";
    when rate_change_effective_date(chg, eff);
    when eff == @2018-01-01;
    when rate_change_prorates_year(y, chg);
    when taxable_income(p, y, ti);
    then requested_income_1993(p, y, ti);
}
@source(IRC_S15_A, relation = formalizes, coverage = exact, quote = "(1) tentative taxes shall be computed by applying the rate for the period before the effective date of the change, and the rate for the period on and after such date, to the taxable income for the entire taxable year; and")
rule RequestTaxableIncomeAfterTcjaChange(p: Person, y: TaxableYear, chg: RateChange, eff: Date, ti: Money) strict {
    label en official "section 15(a)(1): the whole-year taxable income is run through the rate after the change";
    when rate_change_effective_date(chg, eff);
    when eff == @2018-01-01;
    when rate_change_prorates_year(y, chg);
    when taxable_income(p, y, ti);
    then requested_income_tcja(p, y, ti);
}
@source(IRC_S15_A, relation = formalizes, coverage = exact, quote = "(1) tentative taxes shall be computed by applying the rate for the period before the effective date of the change, and the rate for the period on and after such date, to the taxable income for the entire taxable year; and")
rule TentativeTaxBeforeTcjaChange(p: Person, y: TaxableYear, chg: RateChange, eff: Date, ti: Money, tax: Money) strict {
    label en official "section 15(a)(1): the tentative tax before the change";
    when rate_change_effective_date(chg, eff);
    when eff == @2018-01-01;
    when rate_change_prorates_year(y, chg);
    when taxable_income(p, y, ti);
    when tax_at_income_1993_table(p, y, ti, tax);
    then tentative_tax_before_change(p, y, chg, tax);
}
@source(IRC_S15_A, relation = formalizes, coverage = exact, quote = "(1) tentative taxes shall be computed by applying the rate for the period before the effective date of the change, and the rate for the period on and after such date, to the taxable income for the entire taxable year; and")
rule TentativeTaxAfterTcjaChange(p: Person, y: TaxableYear, chg: RateChange, eff: Date, ti: Money, tax: Money) strict {
    label en official "section 15(a)(1): the tentative tax after the change";
    when rate_change_effective_date(chg, eff);
    when eff == @2018-01-01;
    when rate_change_prorates_year(y, chg);
    when taxable_income(p, y, ti);
    when tax_at_income_tcja_table(p, y, ti, tax);
    then tentative_tax_after_change(p, y, chg, tax);
}

// ============================================================================
// §56A(c)(3)(B): the negative adjustment carried from year to year (G5502), three chain years
// ============================================================================
// The case orders the years of the chain (`cfc_chain_year_56Ac3(c, k, y)`, k = 1 the earliest, three years). Step k is
// its own predicate (a predicate cannot feed itself across years, LDC-E4102); the adjustment of the year then flows
// into `cfc_adjustment_determined`, so the stage 3 negative-adjustment rules stay the consumers. A year outside the
// chain keeps the asserted carry-in of stage 3. A fourth chain year is outside the bound (TECH-GAPS G6706).

pub relation cfc_chain_year_56Ac3(c: Corporation, k: Integer, y: TaxableYear) kind empirical {
    label en unofficial "the k-th taxable year (k = 1 the earliest, up to 3) of the chain of years in which a negative section 56A(c)(3) adjustment is carried forward";
}
relation has_cfc_chain_year_56Ac3(c: Corporation, y: TaxableYear) kind institutional {
    label en unofficial "the year is a year of the asserted chain";
}
rule HasCfcChainYear56Ac3(c: Corporation, k: Integer, y: TaxableYear) strict {
    when cfc_chain_year_56Ac3(c, k, y);
    then has_cfc_chain_year_56Ac3(c, y);
}
relation cfc_shares_total_56Ac3(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the sum of the pro rata shares of the items of the controlled foreign corporations for the year";
}
rule CfcSharesTotal56Ac3(c: Corporation, y: TaxableYear) strict {
    when has_cfc_shareholding(c, y);
    then cfc_shares_total_56Ac3(c, y, sum(collect all a: Money, cfc: Corporation where united_states_shareholder_of_cfc(c, y, cfc) and cfc_pro_rata_share_of_items(c, y, cfc, a), empty: 0.00 USD));
}
relation cfc_chain_determined_1(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "chain step 1: the adjustment before subparagraph (B)(i)";
}
relation cfc_chain_negative_1(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "chain step 1: the negative adjustment carried to step 2 (zero when the adjustment is not negative)";
}
relation cfc_chain_determined_2(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "chain step 2: the adjustment before subparagraph (B)(i), reduced by the negative adjustment of step 1";
}
relation cfc_chain_negative_2(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "chain step 2: the negative adjustment carried to step 3";
}
relation cfc_chain_determined_3(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "chain step 3: the adjustment before subparagraph (B)(i), reduced by the negative adjustment of step 2";
}
@source(IRC_S56A_C, relation = formalizes, coverage = exact, quote = "the adjusted financial statement income of such taxpayer with respect to such controlled foreign corporation (as determined under paragraph (2)(C)) shall be adjusted to also take into account such taxpayer's pro rata share")
rule CfcChainStep1(c: Corporation, y: TaxableYear, shares: Money) strict {
    label en official "section 56A(c)(3)(A): the first chain year has no carry-in";
    when cfc_chain_year_56Ac3(c, 1, y);
    when cfc_shares_total_56Ac3(c, y, shares);
    then cfc_chain_determined_1(c, y, shares);
}
@source(IRC_S56A_C, relation = formalizes, coverage = exact, quote = "the adjusted financial statement income of such taxpayer with respect to such controlled foreign corporation (as determined under paragraph (2)(C)) shall be adjusted to also take into account such taxpayer's pro rata share")
rule CfcChainNegative1(c: Corporation, y: TaxableYear, d: Money) strict {
    label en official "section 56A(c)(3)(B)(i)-(ii): the negative amount of step 1 is carried to the succeeding year";
    when cfc_chain_determined_1(c, y, d);
    then cfc_chain_negative_1(c, y, max(0.00 USD, 0.00 USD - d));
}
@source(IRC_S56A_C, relation = formalizes, coverage = exact, quote = "the adjusted financial statement income of such taxpayer with respect to such controlled foreign corporation (as determined under paragraph (2)(C)) shall be adjusted to also take into account such taxpayer's pro rata share")
rule CfcChainStep2(c: Corporation, y1: TaxableYear, y2: TaxableYear, shares: Money, neg: Money) strict {
    label en official "section 56A(c)(3)(B)(ii): the second chain year is reduced by the negative adjustment of the first";
    when cfc_chain_year_56Ac3(c, 1, y1);
    when cfc_chain_year_56Ac3(c, 2, y2);
    when cfc_chain_negative_1(c, y1, neg);
    when cfc_shares_total_56Ac3(c, y2, shares);
    then cfc_chain_determined_2(c, y2, shares - neg);
}
@source(IRC_S56A_C, relation = formalizes, coverage = exact, quote = "the adjusted financial statement income of such taxpayer with respect to such controlled foreign corporation (as determined under paragraph (2)(C)) shall be adjusted to also take into account such taxpayer's pro rata share")
rule CfcChainNegative2(c: Corporation, y: TaxableYear, d: Money) strict {
    label en official "section 56A(c)(3)(B)(i)-(ii): the negative amount of step 2 is carried to the succeeding year";
    when cfc_chain_determined_2(c, y, d);
    then cfc_chain_negative_2(c, y, max(0.00 USD, 0.00 USD - d));
}
@source(IRC_S56A_C, relation = formalizes, coverage = exact, quote = "the adjusted financial statement income of such taxpayer with respect to such controlled foreign corporation (as determined under paragraph (2)(C)) shall be adjusted to also take into account such taxpayer's pro rata share")
rule CfcChainStep3(c: Corporation, y2: TaxableYear, y3: TaxableYear, shares: Money, neg: Money) strict {
    label en official "section 56A(c)(3)(B)(ii): the third chain year is reduced by the negative adjustment of the second";
    when cfc_chain_year_56Ac3(c, 2, y2);
    when cfc_chain_year_56Ac3(c, 3, y3);
    when cfc_chain_negative_2(c, y2, neg);
    when cfc_shares_total_56Ac3(c, y3, shares);
    then cfc_chain_determined_3(c, y3, shares - neg);
}
@source(IRC_S56A_C, relation = formalizes, coverage = exact, quote = "the adjusted financial statement income of such taxpayer with respect to such controlled foreign corporation (as determined under paragraph (2)(C)) shall be adjusted to also take into account such taxpayer's pro rata share")
rule CfcChainDeterminedStep1(c: Corporation, y: TaxableYear, d: Money) strict {
    when cfc_chain_determined_1(c, y, d);
    then cfc_adjustment_determined(c, y, d);
}
@source(IRC_S56A_C, relation = formalizes, coverage = exact, quote = "the adjusted financial statement income of such taxpayer with respect to such controlled foreign corporation (as determined under paragraph (2)(C)) shall be adjusted to also take into account such taxpayer's pro rata share")
rule CfcChainDeterminedStep2(c: Corporation, y: TaxableYear, d: Money) strict {
    when cfc_chain_determined_2(c, y, d);
    then cfc_adjustment_determined(c, y, d);
}
@source(IRC_S56A_C, relation = formalizes, coverage = exact, quote = "the adjusted financial statement income of such taxpayer with respect to such controlled foreign corporation (as determined under paragraph (2)(C)) shall be adjusted to also take into account such taxpayer's pro rata share")
rule CfcChainDeterminedStep3(c: Corporation, y: TaxableYear, d: Money) strict {
    when cfc_chain_determined_3(c, y, d);
    then cfc_adjustment_determined(c, y, d);
}

// ============================================================================
// Stage 4b (26.09.2026): year-to-year ledgers, unrolled and bounded (G6709, G6710, G6711) and the interest recomputation (G6708)
// ============================================================================
// A ledger of years cannot be one predicate reading itself (LDC-E4102). Each ledger below is UNROLLED: the case orders the
// years of the chain (`..._chain_year(k, y)`, k = 1 the earliest), step k is its own predicate, and the derived answer
// of the year flows into the pub relation that the stage 3 consumers already read. The stage 3 rules that read an asserted
// carryover are guarded by `not_known(<year is in the chain>)`, so a year outside a chain keeps the stage 3 reading.
// Bounds (each recorded in TECH-GAPS G6713): financial statement NOL 3 chain years, section 59(l)(2) 6 chain years (the
// first 5 succeeding years of an excess of the FIRST chain year are all inside the chain, so no excess expires inside it),
// alternative tax NOL 3 loss years by 4 deduction years, farm loss 3 chain years.

// ---- §56A(d)(2): the financial statement net operating loss carryover (3 chain years) ------------------------

pub relation fsnol_chain_year_56Ad(c: Corporation, k: Integer, y: TaxableYear) kind empirical {
    label en unofficial "the k-th taxable year (k = 1 the earliest, up to 3) of the chain over which the financial statement net operating loss carryover is computed";
}
pub relation fsnol_arising_in_year_56Ad2(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the financial statement net operating loss arising in the taxable year (a positive amount)";
}
relation has_fsnol_chain_year_56Ad(c: Corporation, y: TaxableYear) kind institutional {
    label en unofficial "the year is a year of the financial statement net operating loss chain";
}
rule HasFsnolChainYear56Ad(c: Corporation, k: Integer, y: TaxableYear) strict {
    when fsnol_chain_year_56Ad(c, k, y);
    then has_fsnol_chain_year_56Ad(c, y);
}
relation fsnol_opening_1(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "chain step 1: the financial statement net operating loss carryover to the year, before the deduction";
}
relation fsnol_applied_1(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "chain step 1: the carryover applied in the year (the lesser of the carryover and 80 percent of the adjusted financial statement income before the deduction, never below zero)";
}
@source(IRC_S56A_D, relation = formalizes, coverage = exact, quote = "A financial statement net operating loss for any taxable year shall be a financial statement net operating loss carryover to each taxable year following the taxable year of the loss.")
rule FsnolApplied1(c: Corporation, y: TaxableYear, opening: Money, before: Money) strict {
    label en official "section 56A(d)(1), (2): the carryover applied in chain step 1";
    effective [@2023-01-01, infinity);
    when fsnol_opening_1(c, y, opening);
    when afsi_before_nol_deduction(c, y, before);
    then fsnol_applied_1(c, y, min(opening, max(0.00 USD, before * 0.8)));
}
@source(IRC_S56A_D, relation = formalizes, coverage = exact, quote = "A financial statement net operating loss for any taxable year shall be a financial statement net operating loss carryover to each taxable year following the taxable year of the loss.")
rule FsnolAfsi1(c: Corporation, y: TaxableYear, applied: Money, before: Money) strict {
    label en official "section 56A(d)(1): adjusted financial statement income after the deduction of chain step 1";
    effective [@2023-01-01, infinity);
    when fsnol_applied_1(c, y, applied);
    when afsi_before_nol_deduction(c, y, before);
    then adjusted_financial_statement_income(c, y, before - applied);
}
relation fsnol_opening_2(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "chain step 2: the financial statement net operating loss carryover to the year, before the deduction";
}
relation fsnol_applied_2(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "chain step 2: the carryover applied in the year (the lesser of the carryover and 80 percent of the adjusted financial statement income before the deduction, never below zero)";
}
@source(IRC_S56A_D, relation = formalizes, coverage = exact, quote = "A financial statement net operating loss for any taxable year shall be a financial statement net operating loss carryover to each taxable year following the taxable year of the loss.")
rule FsnolApplied2(c: Corporation, y: TaxableYear, opening: Money, before: Money) strict {
    label en official "section 56A(d)(1), (2): the carryover applied in chain step 2";
    effective [@2023-01-01, infinity);
    when fsnol_opening_2(c, y, opening);
    when afsi_before_nol_deduction(c, y, before);
    then fsnol_applied_2(c, y, min(opening, max(0.00 USD, before * 0.8)));
}
@source(IRC_S56A_D, relation = formalizes, coverage = exact, quote = "A financial statement net operating loss for any taxable year shall be a financial statement net operating loss carryover to each taxable year following the taxable year of the loss.")
rule FsnolAfsi2(c: Corporation, y: TaxableYear, applied: Money, before: Money) strict {
    label en official "section 56A(d)(1): adjusted financial statement income after the deduction of chain step 2";
    effective [@2023-01-01, infinity);
    when fsnol_applied_2(c, y, applied);
    when afsi_before_nol_deduction(c, y, before);
    then adjusted_financial_statement_income(c, y, before - applied);
}
relation fsnol_opening_3(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "chain step 3: the financial statement net operating loss carryover to the year, before the deduction";
}
relation fsnol_applied_3(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "chain step 3: the carryover applied in the year (the lesser of the carryover and 80 percent of the adjusted financial statement income before the deduction, never below zero)";
}
@source(IRC_S56A_D, relation = formalizes, coverage = exact, quote = "A financial statement net operating loss for any taxable year shall be a financial statement net operating loss carryover to each taxable year following the taxable year of the loss.")
rule FsnolApplied3(c: Corporation, y: TaxableYear, opening: Money, before: Money) strict {
    label en official "section 56A(d)(1), (2): the carryover applied in chain step 3";
    effective [@2023-01-01, infinity);
    when fsnol_opening_3(c, y, opening);
    when afsi_before_nol_deduction(c, y, before);
    then fsnol_applied_3(c, y, min(opening, max(0.00 USD, before * 0.8)));
}
@source(IRC_S56A_D, relation = formalizes, coverage = exact, quote = "A financial statement net operating loss for any taxable year shall be a financial statement net operating loss carryover to each taxable year following the taxable year of the loss.")
rule FsnolAfsi3(c: Corporation, y: TaxableYear, applied: Money, before: Money) strict {
    label en official "section 56A(d)(1): adjusted financial statement income after the deduction of chain step 3";
    effective [@2023-01-01, infinity);
    when fsnol_applied_3(c, y, applied);
    when afsi_before_nol_deduction(c, y, before);
    then adjusted_financial_statement_income(c, y, before - applied);
}
@source(IRC_S56A_D, relation = formalizes, coverage = exact, quote = "A financial statement net operating loss for any taxable year shall be a financial statement net operating loss carryover to each taxable year following the taxable year of the loss.")
rule FsnolOpening1(c: Corporation, y: TaxableYear) strict {
    label en official "section 56A(d)(2): the carryover into the first chain year is the asserted carryover (zero when none)";
    effective [@2023-01-01, infinity);
    when fsnol_chain_year_56Ad(c, 1, y);
    then fsnol_opening_1(c, y, sum(collect all a: Money where financial_statement_nol_carryovers(c, y, a), empty: 0.00 USD));
}
@source(IRC_S56A_D, relation = formalizes, coverage = exact, quote = "A financial statement net operating loss for any taxable year shall be a financial statement net operating loss carryover to each taxable year following the taxable year of the loss.")
rule FsnolOpening2(c: Corporation, y1: TaxableYear, y2: TaxableYear, opening: Money, applied: Money) strict {
    label en official "section 56A(d)(2): the portion carried to the succeeding year is the loss remaining after paragraph (1), plus the loss arising in the year";
    effective [@2023-01-01, infinity);
    when fsnol_chain_year_56Ad(c, 1, y1);
    when fsnol_chain_year_56Ad(c, 2, y2);
    when fsnol_opening_1(c, y1, opening);
    when fsnol_applied_1(c, y1, applied);
    then fsnol_opening_2(c, y2, opening - applied + sum(collect all a: Money where fsnol_arising_in_year_56Ad2(c, y1, a), empty: 0.00 USD));
}
@source(IRC_S56A_D, relation = formalizes, coverage = exact, quote = "A financial statement net operating loss for any taxable year shall be a financial statement net operating loss carryover to each taxable year following the taxable year of the loss.")
rule FsnolOpening3(c: Corporation, y1: TaxableYear, y2: TaxableYear, opening: Money, applied: Money) strict {
    label en official "section 56A(d)(2): the portion carried to the succeeding year is the loss remaining after paragraph (1), plus the loss arising in the year";
    effective [@2023-01-01, infinity);
    when fsnol_chain_year_56Ad(c, 2, y1);
    when fsnol_chain_year_56Ad(c, 3, y2);
    when fsnol_opening_2(c, y1, opening);
    when fsnol_applied_2(c, y1, applied);
    then fsnol_opening_3(c, y2, opening - applied + sum(collect all a: Money where fsnol_arising_in_year_56Ad2(c, y1, a), empty: 0.00 USD));
}

// ---- §59(l)(2): the excess of the pro rata foreign taxes carried to the first 5 succeeding years (6 chain years) ----

pub relation camt_ftc_chain_year_59l2(c: Corporation, k: Integer, y: TaxableYear) kind empirical {
    label en unofficial "the k-th taxable year (k = 1 the earliest, up to 6) of the chain over which the section 59(l)(2) excess is carried";
}
pub relation camt_ftc_excess_carried_in_59l2(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the excess of the amount of paragraph (1)(A)(i) over (1)(A)(ii) carried into the first chain year from a year before the chain (zero when none)";
}
relation has_camt_ftc_chain_year_59l2(c: Corporation, y: TaxableYear) kind institutional {
    label en unofficial "the year is a year of the section 59(l)(2) chain";
}
rule HasCamtFtcChainYear59l2(c: Corporation, k: Integer, y: TaxableYear) strict {
    when camt_ftc_chain_year_59l2(c, k, y);
    then has_camt_ftc_chain_year_59l2(c, y);
}
relation camt_ftc_opening_1(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "chain step 1: the excess carried into the year and not taken into account in a prior year";
}
relation camt_ftc_excess_1(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "chain step 1: the excess of the CFC taxes (increased by the carried excess) over 15 percent of the section 56A(c)(3) adjustment, carried to the succeeding year";
}
@source(IRC_S59_L, relation = formalizes, coverage = partial, quote = "For any taxable year for which an applicable corporation chooses to have the benefits of subpart A of part III of subchapter N")
rule CamtFtcChainStep1(c: Corporation, y: TaxableYear, opening: Money, cfc: Money, adjustment: Money, own: Money) strict {
    label en official "section 59(l)(1), (2): the credit of chain step 1: the lesser of the CFC taxes increased by the carried excess or 15 percent of the adjustment, plus the own taxes";
    effective [@2023-01-01, infinity);
    when camt_ftc_opening_1(c, y, opening);
    when corporation_chooses_foreign_tax_credit_benefits(c, y);
    when applicable_corporation(c, y);
    when cfc_foreign_taxes_pro_rata_share(c, y, cfc);
    when section_56a_c3_adjustment(c, y, adjustment);
    when own_foreign_taxes_on_financial_statement(c, y, own);
    then corporate_amt_foreign_tax_credit(c, y, min(cfc + opening, adjustment * 0.15) + own);
}
@source(IRC_S59_L, relation = formalizes, coverage = partial, quote = "For any taxable year for which an applicable corporation chooses to have the benefits of subpart A of part III of subchapter N")
rule CamtFtcExcess1(c: Corporation, y: TaxableYear, opening: Money, cfc: Money, adjustment: Money) strict {
    label en official "section 59(l)(2): the excess of the amount of (1)(A)(i) over the amount of (1)(A)(ii) in chain step 1";
    effective [@2023-01-01, infinity);
    when camt_ftc_opening_1(c, y, opening);
    when corporation_chooses_foreign_tax_credit_benefits(c, y);
    when applicable_corporation(c, y);
    when cfc_foreign_taxes_pro_rata_share(c, y, cfc);
    when section_56a_c3_adjustment(c, y, adjustment);
    then camt_ftc_excess_1(c, y, max(0.00 USD, cfc + opening - adjustment * 0.15));
}
relation camt_ftc_opening_2(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "chain step 2: the excess carried into the year and not taken into account in a prior year";
}
relation camt_ftc_excess_2(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "chain step 2: the excess of the CFC taxes (increased by the carried excess) over 15 percent of the section 56A(c)(3) adjustment, carried to the succeeding year";
}
@source(IRC_S59_L, relation = formalizes, coverage = partial, quote = "For any taxable year for which an applicable corporation chooses to have the benefits of subpart A of part III of subchapter N")
rule CamtFtcChainStep2(c: Corporation, y: TaxableYear, opening: Money, cfc: Money, adjustment: Money, own: Money) strict {
    label en official "section 59(l)(1), (2): the credit of chain step 2: the lesser of the CFC taxes increased by the carried excess or 15 percent of the adjustment, plus the own taxes";
    effective [@2023-01-01, infinity);
    when camt_ftc_opening_2(c, y, opening);
