@source(IRC_S56_D, relation = formalizes, coverage = exact, quote = "(ii) appropriate adjustments in the application of section 172(b)(2) shall be made to take into account the limitation of subparagraph (A).")
rule AtnolRem1_1(p: Person, ly: TaxableYear, amount: Money) strict {
    label en official "section 172(b)(2) as applied by section 56(d)(1)(A)(ii): the carryover of loss year 1 at the start of the first deduction year";
    when atnol_chain_loss_year(p, 1, ly);
    when atnol_carryover_of_loss_year(p, ly, amount);
    then atnol_rem_1_1(p, amount);
}
@source(IRC_S56_D, relation = formalizes, coverage = exact, quote = "(ii) appropriate adjustments in the application of section 172(b)(2) shall be made to take into account the limitation of subparagraph (A).")
rule AtnolRem2_1(p: Person, ly: TaxableYear, amount: Money) strict {
    label en official "section 172(b)(2) as applied by section 56(d)(1)(A)(ii): the carryover of loss year 2 at the start of the first deduction year";
    when atnol_chain_loss_year(p, 2, ly);
    when atnol_carryover_of_loss_year(p, ly, amount);
    then atnol_rem_2_1(p, amount);
}
@source(IRC_S56_D, relation = formalizes, coverage = exact, quote = "(ii) appropriate adjustments in the application of section 172(b)(2) shall be made to take into account the limitation of subparagraph (A).")
rule AtnolRem3_1(p: Person, ly: TaxableYear, amount: Money) strict {
    label en official "section 172(b)(2) as applied by section 56(d)(1)(A)(ii): the carryover of loss year 3 at the start of the first deduction year";
    when atnol_chain_loss_year(p, 3, ly);
    when atnol_carryover_of_loss_year(p, ly, amount);
    then atnol_rem_3_1(p, amount);
}
@source(IRC_S56_D, relation = formalizes, coverage = exact, quote = "(ii) appropriate adjustments in the application of section 172(b)(2) shall be made to take into account the limitation of subparagraph (A).")
rule AtnolPrior1_1(p: Person, cap: Money) strict {
    when atnol_cap_1(p, cap);
    then atnol_prior_1_1(p, 0.00 USD);
}
@source(IRC_S56_D, relation = formalizes, coverage = exact, quote = "(ii) appropriate adjustments in the application of section 172(b)(2) shall be made to take into account the limitation of subparagraph (A).")
rule AtnolPrior2_1(p: Person, a1: Money) strict {
    when atnol_alloc_1_1(p, a1);
    then atnol_prior_2_1(p, a1);
}
@source(IRC_S56_D, relation = formalizes, coverage = exact, quote = "(ii) appropriate adjustments in the application of section 172(b)(2) shall be made to take into account the limitation of subparagraph (A).")
rule AtnolPrior3_1(p: Person, a1: Money, a2: Money) strict {
    when atnol_alloc_1_1(p, a1);
    when atnol_alloc_2_1(p, a2);
    then atnol_prior_3_1(p, a1 + a2);
}
@source(IRC_S56_D, relation = formalizes, coverage = exact, quote = "(ii) appropriate adjustments in the application of section 172(b)(2) shall be made to take into account the limitation of subparagraph (A).")
rule AtnolUsed1(p: Person, a1: Money, a2: Money, a3: Money) strict {
    when atnol_alloc_1_1(p, a1);
    when atnol_alloc_2_1(p, a2);
    when atnol_alloc_3_1(p, a3);
    then atnol_used_1(p, a1 + a2 + a3);
}
@source(IRC_S56_D, relation = formalizes, coverage = exact, quote = "(ii) appropriate adjustments in the application of section 172(b)(2) shall be made to take into account the limitation of subparagraph (A).")
rule AtnolAlloc1_1Eligible(p: Person, ly: TaxableYear, dy: TaxableYear, s: Date, d: Date, rem: Money, cap: Money, prior: Money) strict {
    label en official "section 172(b)(2) as applied by section 56(d)(1)(A)(ii): loss year 1 is absorbed in deduction year 1 up to the income limit left by the older loss years";
    when atnol_chain_loss_year(p, 1, ly);
    when atnol_chain_deduction_year(p, 1, dy);
    when loss_year_begins_on(ly, s);
    when us.irc.core::begins(dy, d);
    when s < d;
    when atnol_rem_1_1(p, rem);
    when atnol_cap_1(p, cap);
    when atnol_prior_1_1(p, prior);
    then atnol_alloc_1_1(p, min(rem, max(0.00 USD, cap - prior)));
}
@source(IRC_S56_D, relation = formalizes, coverage = exact, quote = "(ii) appropriate adjustments in the application of section 172(b)(2) shall be made to take into account the limitation of subparagraph (A).")
rule AtnolAlloc1_1NotYetCarryable(p: Person, ly: TaxableYear, dy: TaxableYear, s: Date, d: Date) strict {
    label en official "a loss year that does not begin before the deduction year contributes nothing to it";
    when atnol_chain_loss_year(p, 1, ly);
    when atnol_chain_deduction_year(p, 1, dy);
    when loss_year_begins_on(ly, s);
    when us.irc.core::begins(dy, d);
    when s >= d;
    then atnol_alloc_1_1(p, 0.00 USD);
}
@source(IRC_S56_D, relation = formalizes, coverage = exact, quote = "(ii) appropriate adjustments in the application of section 172(b)(2) shall be made to take into account the limitation of subparagraph (A).")
rule AtnolRem1_2(p: Person, rem: Money, alloc: Money) strict {
    label en official "section 172(b)(2): the carryover remaining after the absorption of deduction year 1";
    when atnol_rem_1_1(p, rem);
    when atnol_alloc_1_1(p, alloc);
    then atnol_rem_1_2(p, rem - alloc);
}
@source(IRC_S56_D, relation = formalizes, coverage = exact, quote = "(ii) appropriate adjustments in the application of section 172(b)(2) shall be made to take into account the limitation of subparagraph (A).")
rule AtnolAlloc2_1Eligible(p: Person, ly: TaxableYear, dy: TaxableYear, s: Date, d: Date, rem: Money, cap: Money, prior: Money) strict {
    label en official "section 172(b)(2) as applied by section 56(d)(1)(A)(ii): loss year 2 is absorbed in deduction year 1 up to the income limit left by the older loss years";
    when atnol_chain_loss_year(p, 2, ly);
    when atnol_chain_deduction_year(p, 1, dy);
    when loss_year_begins_on(ly, s);
    when us.irc.core::begins(dy, d);
    when s < d;
    when atnol_rem_2_1(p, rem);
    when atnol_cap_1(p, cap);
    when atnol_prior_2_1(p, prior);
    then atnol_alloc_2_1(p, min(rem, max(0.00 USD, cap - prior)));
}
@source(IRC_S56_D, relation = formalizes, coverage = exact, quote = "(ii) appropriate adjustments in the application of section 172(b)(2) shall be made to take into account the limitation of subparagraph (A).")
rule AtnolAlloc2_1NotYetCarryable(p: Person, ly: TaxableYear, dy: TaxableYear, s: Date, d: Date) strict {
    label en official "a loss year that does not begin before the deduction year contributes nothing to it";
    when atnol_chain_loss_year(p, 2, ly);
    when atnol_chain_deduction_year(p, 1, dy);
    when loss_year_begins_on(ly, s);
    when us.irc.core::begins(dy, d);
    when s >= d;
    then atnol_alloc_2_1(p, 0.00 USD);
}
@source(IRC_S56_D, relation = formalizes, coverage = exact, quote = "(ii) appropriate adjustments in the application of section 172(b)(2) shall be made to take into account the limitation of subparagraph (A).")
rule AtnolRem2_2(p: Person, rem: Money, alloc: Money) strict {
    label en official "section 172(b)(2): the carryover remaining after the absorption of deduction year 1";
    when atnol_rem_2_1(p, rem);
    when atnol_alloc_2_1(p, alloc);
    then atnol_rem_2_2(p, rem - alloc);
}
@source(IRC_S56_D, relation = formalizes, coverage = exact, quote = "(ii) appropriate adjustments in the application of section 172(b)(2) shall be made to take into account the limitation of subparagraph (A).")
rule AtnolAlloc3_1Eligible(p: Person, ly: TaxableYear, dy: TaxableYear, s: Date, d: Date, rem: Money, cap: Money, prior: Money) strict {
    label en official "section 172(b)(2) as applied by section 56(d)(1)(A)(ii): loss year 3 is absorbed in deduction year 1 up to the income limit left by the older loss years";
    when atnol_chain_loss_year(p, 3, ly);
    when atnol_chain_deduction_year(p, 1, dy);
    when loss_year_begins_on(ly, s);
    when us.irc.core::begins(dy, d);
    when s < d;
    when atnol_rem_3_1(p, rem);
    when atnol_cap_1(p, cap);
    when atnol_prior_3_1(p, prior);
    then atnol_alloc_3_1(p, min(rem, max(0.00 USD, cap - prior)));
}
@source(IRC_S56_D, relation = formalizes, coverage = exact, quote = "(ii) appropriate adjustments in the application of section 172(b)(2) shall be made to take into account the limitation of subparagraph (A).")
rule AtnolAlloc3_1NotYetCarryable(p: Person, ly: TaxableYear, dy: TaxableYear, s: Date, d: Date) strict {
    label en official "a loss year that does not begin before the deduction year contributes nothing to it";
    when atnol_chain_loss_year(p, 3, ly);
    when atnol_chain_deduction_year(p, 1, dy);
    when loss_year_begins_on(ly, s);
    when us.irc.core::begins(dy, d);
    when s >= d;
    then atnol_alloc_3_1(p, 0.00 USD);
}
@source(IRC_S56_D, relation = formalizes, coverage = exact, quote = "(ii) appropriate adjustments in the application of section 172(b)(2) shall be made to take into account the limitation of subparagraph (A).")
rule AtnolRem3_2(p: Person, rem: Money, alloc: Money) strict {
    label en official "section 172(b)(2): the carryover remaining after the absorption of deduction year 1";
    when atnol_rem_3_1(p, rem);
    when atnol_alloc_3_1(p, alloc);
    then atnol_rem_3_2(p, rem - alloc);
}
@source(IRC_S56_D, relation = formalizes, coverage = exact, quote = "(ii) appropriate adjustments in the application of section 172(b)(2) shall be made to take into account the limitation of subparagraph (A).")
rule AtnolDeductionChain1(p: Person, dy: TaxableYear, used: Money, amti: Money) strict {
    label en official "section 56(d)(1)(A): the deduction of deduction year 1: the ordinary losses absorbed plus the lesser of the elected applicable losses or the remainder of the income";
    when noncorporate_taxpayer_for_year(p, dy);
    when atnol_chain_deduction_year(p, 1, dy);
    when atnol_used_1(p, used);
    when amti_before_atnol_and_section_199(p, dy, amti);
    then atnol_deduction(p, dy, used + min(sum(collect all a: Money where atnol_attributable_to_elected_applicable_loss(p, dy, a), empty: 0.00 USD), max(0.00 USD, amti - used)));
}
@source(IRC_S56_D, relation = formalizes, coverage = exact, quote = "(ii) appropriate adjustments in the application of section 172(b)(2) shall be made to take into account the limitation of subparagraph (A).")
rule AtnolPrior1_2(p: Person, cap: Money) strict {
    when atnol_cap_2(p, cap);
    then atnol_prior_1_2(p, 0.00 USD);
}
@source(IRC_S56_D, relation = formalizes, coverage = exact, quote = "(ii) appropriate adjustments in the application of section 172(b)(2) shall be made to take into account the limitation of subparagraph (A).")
rule AtnolPrior2_2(p: Person, a1: Money) strict {
    when atnol_alloc_1_2(p, a1);
    then atnol_prior_2_2(p, a1);
}
@source(IRC_S56_D, relation = formalizes, coverage = exact, quote = "(ii) appropriate adjustments in the application of section 172(b)(2) shall be made to take into account the limitation of subparagraph (A).")
rule AtnolPrior3_2(p: Person, a1: Money, a2: Money) strict {
    when atnol_alloc_1_2(p, a1);
    when atnol_alloc_2_2(p, a2);
    then atnol_prior_3_2(p, a1 + a2);
}
@source(IRC_S56_D, relation = formalizes, coverage = exact, quote = "(ii) appropriate adjustments in the application of section 172(b)(2) shall be made to take into account the limitation of subparagraph (A).")
rule AtnolUsed2(p: Person, a1: Money, a2: Money, a3: Money) strict {
    when atnol_alloc_1_2(p, a1);
    when atnol_alloc_2_2(p, a2);
    when atnol_alloc_3_2(p, a3);
    then atnol_used_2(p, a1 + a2 + a3);
}
