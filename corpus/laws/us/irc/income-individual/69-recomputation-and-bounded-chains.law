}
relation atnol_rem_3_3(p: Person, amount: Money) kind institutional {
    label en unofficial "loss year 3: the carryover remaining at the start of deduction year 3";
}
relation atnol_alloc_3_3(p: Person, amount: Money) kind institutional {
