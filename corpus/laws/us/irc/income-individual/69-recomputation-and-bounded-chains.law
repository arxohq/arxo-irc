// ---- §58(a)(1)(B): the disallowed farm loss is a deduction of the first succeeding year (3 chain years) -------------

pub relation farm_chain_year_58a1B(p: Person, k: Integer, y: TaxableYear) kind empirical {
    label en unofficial "the k-th taxable year (k = 1 the earliest, up to 3) of the chain over which the disallowed tax shelter farm loss is carried";
}
relation has_farm_chain_carry_year_58a1B(p: Person, y: TaxableYear) kind institutional {
    label en unofficial "the year is the second or third year of the farm loss chain (its carry-in is derived from the chain)";
}
rule HasFarmChainCarryYear2(p: Person, y: TaxableYear) strict {
    when farm_chain_year_58a1B(p, 2, y);
    then has_farm_chain_carry_year_58a1B(p, y);
}
rule HasFarmChainCarryYear3(p: Person, y: TaxableYear) strict {
    when farm_chain_year_58a1B(p, 3, y);
    then has_farm_chain_carry_year_58a1B(p, y);
}
relation farm_chain_disallowed_1(p: Person, amount: Money) kind institutional {
    label en unofficial "chain step 1: the loss disallowed in the first chain year (the loss subject to denial less the insolvency reduction)";
}
relation farm_chain_disallowed_2(p: Person, amount: Money) kind institutional {
    label en unofficial "chain step 2: the loss disallowed in the second chain year, including the deduction carried from the first";
}
@source(IRC_S58_A, relation = formalizes, coverage = exact, quote = "Any loss from a tax shelter farm activity disallowed under subparagraph (A) shall be treated as a deduction allocable to such activity in the 1st succeeding taxable year.")
rule FarmChainDisallowed1(p: Person, y: TaxableYear, cur: Money, car: Money, ins: Money) strict {
    label en official "section 58(a)(1)(A), (c)(1): the loss disallowed in the first chain year";
    when farm_chain_year_58a1B(p, 1, y);
    when farm_loss_current_total(p, y, cur);
    when farm_loss_carried_in_total(p, y, car);
    when insolvency_amount(p, y, ins);
    then farm_chain_disallowed_1(p, (cur + car) - min(cur + car, ins));
}
@source(IRC_S58_A, relation = formalizes, coverage = exact, quote = "Any loss from a tax shelter farm activity disallowed under subparagraph (A) shall be treated as a deduction allocable to such activity in the 1st succeeding taxable year.")
rule FarmChainDisallowed2(p: Person, y1: TaxableYear, y2: TaxableYear, d1: Money, cur: Money, car: Money, ins: Money) strict {
    label en official "section 58(a)(1)(B): the loss disallowed in the first chain year is a deduction of the second, which is itself subject to the denial";
    when farm_chain_year_58a1B(p, 1, y1);
    when farm_chain_year_58a1B(p, 2, y2);
    when farm_chain_disallowed_1(p, d1);
    when farm_loss_current_total(p, y2, cur);
    when farm_loss_carried_in_total(p, y2, car);
    when insolvency_amount(p, y2, ins);
    then farm_chain_disallowed_2(p, (cur + car + d1) - min(cur + car + d1, ins));
}
@source(IRC_S58_A, relation = formalizes, coverage = exact, quote = "Any loss from a tax shelter farm activity disallowed under subparagraph (A) shall be treated as a deduction allocable to such activity in the 1st succeeding taxable year.")
rule FarmLossSubjectToDenialSecondChainYear(p: Person, y1: TaxableYear, y2: TaxableYear, d1: Money, cur: Money, car: Money) strict {
    label en official "section 58(a)(1)(B): the second chain year's losses subject to the denial include the deduction carried from the first";
    when farm_chain_year_58a1B(p, 1, y1);
    when farm_chain_year_58a1B(p, 2, y2);
    when farm_chain_disallowed_1(p, d1);
    when farm_loss_current_total(p, y2, cur);
    when farm_loss_carried_in_total(p, y2, car);
    then farm_loss_subject_to_denial(p, y2, cur + car + d1);
}
@source(IRC_S58_A, relation = formalizes, coverage = exact, quote = "Any loss from a tax shelter farm activity disallowed under subparagraph (A) shall be treated as a deduction allocable to such activity in the 1st succeeding taxable year.")
rule FarmLossSubjectToDenialThirdChainYear(p: Person, y2: TaxableYear, y3: TaxableYear, d2: Money, cur: Money, car: Money) strict {
    label en official "section 58(a)(1)(B): the third chain year's losses subject to the denial include the deduction carried from the second";
    when farm_chain_year_58a1B(p, 2, y2);
    when farm_chain_year_58a1B(p, 3, y3);
    when farm_chain_disallowed_2(p, d2);
    when farm_loss_current_total(p, y3, cur);
    when farm_loss_carried_in_total(p, y3, car);
    then farm_loss_subject_to_denial(p, y3, cur + car + d2);
}

// ---- §56(b)(1)(B): the deduction for interest recomputed under sections 163(d) and 163(h) (G6708) ---------------
// The regular deduction is a case input (`regular_investment_interest_deduction`, `regular_qualified_residence_interest_deduction`);
// the alternative minimum tax deduction is recomputed here on adjusted net investment income and qualified housing interest,
// and the difference enters the sum of adjustments as `Interest56b1B`. JUDGMENT CALL: the adjustments of sections 56, 57 and 58 to
// net investment income are a signed case input (`net_investment_income_amt_adjustments`): computing them from the sum of
// the adjustments would make the interest adjustment depend on itself.

pub relation net_investment_income_regular(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "net investment income for section 163(d) computed for the regular tax";
}
pub relation net_investment_income_amt_adjustments(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the signed net effect of the adjustments of sections 56, 57 and 58 on net investment income (section 56(b)(1)(B)(iv))";
}
pub relation investment_interest_paid_for_amt(d: Indebtedness, taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the interest of the year on an indebtedness (used for the investment interest and the qualified housing interest sums)";
}
pub relation regular_investment_interest_deduction(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the investment interest deduction allowed under section 163(d) for the regular tax";
}
pub relation regular_qualified_residence_interest_deduction(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the qualified residence interest deducted under section 163(h)(2)(D) for the regular tax";
}
pub relation adjusted_net_investment_income_for_amt(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "net investment income for the alternative minimum tax: the regular figure with the adjustments of sections 56, 57 and 58 and the specified private activity bond interest and deduction of section 56(b)(1)(B)(ii)";
}
pub relation investment_interest_allowed_for_amt(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the investment interest allowed for the alternative minimum tax: at most the investment interest (without qualified housing interest) and at most adjusted net investment income";
}
pub relation qualified_housing_interest_allowed_for_amt(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the qualified housing interest allowed for the alternative minimum tax (in lieu of the exception for qualified residence interest)";
}
relation has_amt_interest_recomputation(p: Person, y: TaxableYear) kind institutional {
    label en unofficial "the regular interest deductions are asserted for the year, so the alternative minimum tax deduction for interest is recomputed";
}
rule HasAmtInterestRecomputation(p: Person, y: TaxableYear) strict {
    when regular_investment_interest_deduction(p, y, _);
    then has_amt_interest_recomputation(p, y);
}
@source(IRC_S56_B, relation = formalizes, coverage = exact, quote = "(iv) the adjustments of this section and sections 57 and 58 shall apply in determining net investment income under section 163(d).")
rule AdjustedNetInvestmentIncomeForAmt(p: Person, y: TaxableYear, regular: Money, adj: Money, pab: Money, ded: Money) strict {
    label en official "section 56(b)(1)(B)(ii), (iv): net investment income with the adjustments and the private activity bond interest and deduction";
    when noncorporate_taxpayer_for_year(p, y);
    when net_investment_income_regular(p, y, regular);
    when net_investment_income_amt_adjustments(p, y, adj);
    when pab_interest_includible_for_163d(p, y, pab);
    when pab_related_deduction_for_163d(p, y, ded);
    then adjusted_net_investment_income_for_amt(p, y, regular + adj + pab - ded);
}
@source(IRC_S56_B, relation = formalizes, coverage = exact, quote = "In determining the amount allowable as a deduction for interest, subsections (d) and (h) of section 163 shall apply, except that—")
rule InvestmentInterestAllowedForAmt(p: Person, y: TaxableYear, nii: Money) strict {
    label en official "section 56(b)(1)(B), section 163(d): investment interest is allowed up to adjusted net investment income";
    when adjusted_net_investment_income_for_amt(p, y, nii);
    then investment_interest_allowed_for_amt(p, y, min(sum(collect all a: Money, d: Indebtedness where investment_interest_for_amt(d, p, y) and investment_interest_paid_for_amt(d, p, y, a), empty: 0.00 USD), max(0.00 USD, nii)));
}
@source(IRC_S56_B, relation = formalizes, coverage = exact, quote = "In determining the amount allowable as a deduction for interest, subsections (d) and (h) of section 163 shall apply, except that—")
rule QualifiedHousingInterestAllowedForAmt(p: Person, y: TaxableYear) strict {
    label en official "section 56(b)(1)(B), section 163(h): qualified housing interest is not personal interest";
    when noncorporate_taxpayer_for_year(p, y);
    then qualified_housing_interest_allowed_for_amt(p, y, sum(collect all a: Money, d: Indebtedness where qualified_housing_interest_on(d, p, y) and investment_interest_paid_for_amt(d, p, y, a), empty: 0.00 USD));
}
@source(IRC_S56_B, relation = formalizes, coverage = exact, quote = "In determining the amount allowable as a deduction for interest, subsections (d) and (h) of section 163 shall apply, except that—")
rule InterestAdjustmentRecomputed(p: Person, y: TaxableYear, reg_inv: Money, reg_res: Money, allowed: Money, housing: Money) strict {
    label en official "section 56(b)(1)(B): the adjustment is the regular deductions less the recomputed ones";
    when has_amt_interest_recomputation(p, y);
    when regular_investment_interest_deduction(p, y, reg_inv);
    when regular_qualified_residence_interest_deduction(p, y, reg_res);
    when investment_interest_allowed_for_amt(p, y, allowed);
    when qualified_housing_interest_allowed_for_amt(p, y, housing);
    then amt_adjustment(p, y, Interest56b1B, (reg_inv + reg_res) - (allowed + housing));
}

// A chain with fewer than three loss years: the missing loss years absorb nothing.
relation atnol_chain_loss_present_1(p: Person) kind institutional {
    label en unofficial "the chain names an i-th loss year (i = 1)";
}
rule AtnolChainLossPresent1(p: Person) strict {
    when atnol_chain_loss_year(p, 1, _);
    then atnol_chain_loss_present_1(p);
}
@source(IRC_S56_D, relation = formalizes, coverage = exact, quote = "(ii) appropriate adjustments in the application of section 172(b)(2) shall be made to take into account the limitation of subparagraph (A).")
rule AtnolAlloc1_1NoLossYear(p: Person, dy: TaxableYear) strict {
    label en official "a chain without a loss year 1 absorbs nothing of it in deduction year 1";
    when atnol_chain_deduction_year(p, 1, dy);
    when not_known(atnol_chain_loss_present_1(p));
    then atnol_alloc_1_1(p, 0.00 USD);
}
@source(IRC_S56_D, relation = formalizes, coverage = exact, quote = "(ii) appropriate adjustments in the application of section 172(b)(2) shall be made to take into account the limitation of subparagraph (A).")
rule AtnolAlloc1_2NoLossYear(p: Person, dy: TaxableYear) strict {
    label en official "a chain without a loss year 1 absorbs nothing of it in deduction year 2";
    when atnol_chain_deduction_year(p, 2, dy);
    when not_known(atnol_chain_loss_present_1(p));
    then atnol_alloc_1_2(p, 0.00 USD);
}
