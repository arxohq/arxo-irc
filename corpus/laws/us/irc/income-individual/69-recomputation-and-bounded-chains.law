}
relation atnol_prior_3_2(p: Person, amount: Money) kind institutional {
    label en unofficial "deduction year 2: the amount absorbed by the older loss years before loss year 3";
}
relation atnol_cap_3(p: Person, amount: Money) kind institutional {
    label en unofficial "deduction year 3: 90 percent of the alternative minimum taxable income before the deduction and section 199, never below zero";
}
relation atnol_used_3(p: Person, amount: Money) kind institutional {
