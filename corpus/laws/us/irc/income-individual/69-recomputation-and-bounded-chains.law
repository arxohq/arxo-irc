@source(IRC_S59_L, relation = formalizes, coverage = partial, quote = "For any taxable year for which an applicable corporation chooses to have the benefits of subpart A of part III of subchapter N")
rule CamtFtcOpening1(c: Corporation, y: TaxableYear) strict {
    label en official "section 59(l)(2): the excess carried into the first chain year (zero when none)";
    effective [@2023-01-01, infinity);
    when camt_ftc_chain_year_59l2(c, 1, y);
    then camt_ftc_opening_1(c, y, sum(collect all a: Money where camt_ftc_excess_carried_in_59l2(c, y, a), empty: 0.00 USD));
}
@source(IRC_S59_L, relation = formalizes, coverage = partial, quote = "For any taxable year for which an applicable corporation chooses to have the benefits of subpart A of part III of subchapter N")
rule CamtFtcOpening2(c: Corporation, y1: TaxableYear, y2: TaxableYear, excess: Money) strict {
    label en official "section 59(l)(2): the excess of chain step 1 increases the amount of (1)(A)(i) of the succeeding year";
    effective [@2023-01-01, infinity);
    when camt_ftc_chain_year_59l2(c, 1, y1);
    when camt_ftc_chain_year_59l2(c, 2, y2);
    when camt_ftc_excess_1(c, y1, excess);
    then camt_ftc_opening_2(c, y2, excess);
}
@source(IRC_S59_L, relation = formalizes, coverage = partial, quote = "For any taxable year for which an applicable corporation chooses to have the benefits of subpart A of part III of subchapter N")
rule CamtFtcOpening3(c: Corporation, y1: TaxableYear, y2: TaxableYear, excess: Money) strict {
    label en official "section 59(l)(2): the excess of chain step 2 increases the amount of (1)(A)(i) of the succeeding year";
    effective [@2023-01-01, infinity);
    when camt_ftc_chain_year_59l2(c, 2, y1);
    when camt_ftc_chain_year_59l2(c, 3, y2);
    when camt_ftc_excess_2(c, y1, excess);
    then camt_ftc_opening_3(c, y2, excess);
}
@source(IRC_S59_L, relation = formalizes, coverage = partial, quote = "For any taxable year for which an applicable corporation chooses to have the benefits of subpart A of part III of subchapter N")
rule CamtFtcOpening4(c: Corporation, y1: TaxableYear, y2: TaxableYear, excess: Money) strict {
    label en official "section 59(l)(2): the excess of chain step 3 increases the amount of (1)(A)(i) of the succeeding year";
    effective [@2023-01-01, infinity);
    when camt_ftc_chain_year_59l2(c, 3, y1);
    when camt_ftc_chain_year_59l2(c, 4, y2);
    when camt_ftc_excess_3(c, y1, excess);
    then camt_ftc_opening_4(c, y2, excess);
}
@source(IRC_S59_L, relation = formalizes, coverage = partial, quote = "For any taxable year for which an applicable corporation chooses to have the benefits of subpart A of part III of subchapter N")
rule CamtFtcOpening5(c: Corporation, y1: TaxableYear, y2: TaxableYear, excess: Money) strict {
    label en official "section 59(l)(2): the excess of chain step 4 increases the amount of (1)(A)(i) of the succeeding year";
    effective [@2023-01-01, infinity);
    when camt_ftc_chain_year_59l2(c, 4, y1);
    when camt_ftc_chain_year_59l2(c, 5, y2);
    when camt_ftc_excess_4(c, y1, excess);
    then camt_ftc_opening_5(c, y2, excess);
}
@source(IRC_S59_L, relation = formalizes, coverage = partial, quote = "For any taxable year for which an applicable corporation chooses to have the benefits of subpart A of part III of subchapter N")
rule CamtFtcOpening6(c: Corporation, y1: TaxableYear, y2: TaxableYear, excess: Money) strict {
    label en official "section 59(l)(2): the excess of chain step 5 increases the amount of (1)(A)(i) of the succeeding year";
    effective [@2023-01-01, infinity);
    when camt_ftc_chain_year_59l2(c, 5, y1);
    when camt_ftc_chain_year_59l2(c, 6, y2);
    when camt_ftc_excess_5(c, y1, excess);
    then camt_ftc_opening_6(c, y2, excess);
}

// ---- §56(d)(1)(A)(ii): the alternative tax net operating loss carryovers absorbed year by year (3 loss years x 4 deduction years) ----
// Oldest loss first (section 172(b)(2)): in each deduction year the ordinary-loss deduction is at most 90 percent of the
// alternative minimum taxable income before it (never below zero); the loss years are consumed in the order the case names
// them (k = 1 the oldest). A loss year contributes to a deduction year only if it begins before it. The elected applicable
// losses of section 172(b)(1)(H) keep their asserted amount (the remainder of the income limit is applied to them, as in
// `AtnolDeductionCapped`).

pub relation atnol_chain_loss_year(p: Person, i: Integer, ly: TaxableYear) kind empirical {
    label en unofficial "the i-th loss year (i = 1 the oldest, up to 3) whose alternative tax net operating loss is carried";
}
pub relation atnol_chain_deduction_year(p: Person, j: Integer, dy: TaxableYear) kind empirical {
    label en unofficial "the j-th deduction year (j = 1 the earliest, up to 4) in which carryovers are absorbed";
}
pub relation atnol_carryover_of_loss_year(p: Person, ly: TaxableYear, amount: Money) kind empirical {
    label en official "the alternative tax net operating loss of the loss year available as a carryover (the figure of `atnol_of_loss_year`, supplied because the loss-year adjustments read the same adjustment predicate that the deduction feeds: a cycle at the level of predicates, LDC-E4102, although the years differ)";
}
relation has_atnol_chain_deduction_year(p: Person, y: TaxableYear) kind institutional {
    label en unofficial "the year is a deduction year of the alternative tax net operating loss chain";
}
rule HasAtnolChainDeductionYear(p: Person, j: Integer, y: TaxableYear) strict {
    when atnol_chain_deduction_year(p, j, y);
    then has_atnol_chain_deduction_year(p, y);
}
relation atnol_cap_1(p: Person, amount: Money) kind institutional {
    label en unofficial "deduction year 1: 90 percent of the alternative minimum taxable income before the deduction and section 199, never below zero";
}
relation atnol_used_1(p: Person, amount: Money) kind institutional {
    label en unofficial "deduction year 1: the ordinary alternative tax net operating loss absorbed (oldest loss first)";
}
@source(IRC_S56_D, relation = formalizes, coverage = exact, quote = "(ii) appropriate adjustments in the application of section 172(b)(2) shall be made to take into account the limitation of subparagraph (A).")
rule AtnolCap1(p: Person, dy: TaxableYear, amti: Money) strict {
    label en official "section 56(d)(1)(A)(i): the income limit of deduction year 1";
    when atnol_chain_deduction_year(p, 1, dy);
    when amti_before_atnol_and_section_199(p, dy, amti);
    then atnol_cap_1(p, max(0.00 USD, amti * 0.9));
}
relation atnol_rem_1_1(p: Person, amount: Money) kind institutional {
    label en unofficial "loss year 1: the carryover remaining at the start of deduction year 1";
}
relation atnol_alloc_1_1(p: Person, amount: Money) kind institutional {
    label en unofficial "loss year 1: the part absorbed in deduction year 1";
}
relation atnol_prior_1_1(p: Person, amount: Money) kind institutional {
    label en unofficial "deduction year 1: the amount absorbed by the older loss years before loss year 1";
}
relation atnol_rem_2_1(p: Person, amount: Money) kind institutional {
    label en unofficial "loss year 2: the carryover remaining at the start of deduction year 1";
}
relation atnol_alloc_2_1(p: Person, amount: Money) kind institutional {
    label en unofficial "loss year 2: the part absorbed in deduction year 1";
}
relation atnol_prior_2_1(p: Person, amount: Money) kind institutional {
    label en unofficial "deduction year 1: the amount absorbed by the older loss years before loss year 2";
}
relation atnol_rem_3_1(p: Person, amount: Money) kind institutional {
    label en unofficial "loss year 3: the carryover remaining at the start of deduction year 1";
}
relation atnol_alloc_3_1(p: Person, amount: Money) kind institutional {
    label en unofficial "loss year 3: the part absorbed in deduction year 1";
}
relation atnol_prior_3_1(p: Person, amount: Money) kind institutional {
    label en unofficial "deduction year 1: the amount absorbed by the older loss years before loss year 3";
}
relation atnol_cap_2(p: Person, amount: Money) kind institutional {
    label en unofficial "deduction year 2: 90 percent of the alternative minimum taxable income before the deduction and section 199, never below zero";
}
relation atnol_used_2(p: Person, amount: Money) kind institutional {
    label en unofficial "deduction year 2: the ordinary alternative tax net operating loss absorbed (oldest loss first)";
}
@source(IRC_S56_D, relation = formalizes, coverage = exact, quote = "(ii) appropriate adjustments in the application of section 172(b)(2) shall be made to take into account the limitation of subparagraph (A).")
rule AtnolCap2(p: Person, dy: TaxableYear, amti: Money) strict {
    label en official "section 56(d)(1)(A)(i): the income limit of deduction year 2";
    when atnol_chain_deduction_year(p, 2, dy);
    when amti_before_atnol_and_section_199(p, dy, amti);
