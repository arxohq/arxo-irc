rule AtnolDeductionChain2(p: Person, dy: TaxableYear, used: Money, amti: Money) strict {
    label en official "section 56(d)(1)(A): the deduction of deduction year 2: the ordinary losses absorbed plus the lesser of the elected applicable losses or the remainder of the income";
    when noncorporate_taxpayer_for_year(p, dy);
    when atnol_chain_deduction_year(p, 2, dy);
    when atnol_used_2(p, used);
    when amti_before_atnol_and_section_199(p, dy, amti);
    then atnol_deduction(p, dy, used + min(sum(collect all a: Money where atnol_attributable_to_elected_applicable_loss(p, dy, a), empty: 0.00 USD), max(0.00 USD, amti - used)));
}
