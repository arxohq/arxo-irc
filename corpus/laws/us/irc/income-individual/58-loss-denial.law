// Section 58: denial of certain losses in computing alternative minimum
// taxable income (stage 2), for a taxpayer other than a corporation.
//
// MODELLED: (a) the tax shelter farm activity loss — the classification of
// (a)(2), the disallowance of the year's loss (a)(1)(A), the deduction in the
// first succeeding year of a disallowed loss (a)(1)(B) as a case-supplied
// carry-in (the multi-year chain is not derived: a year's disallowed loss
// feeding the next year's carry-in would make the disallowance depend on
// itself across years, TECH-GAPS), (c)(1) the insolvency reduction and (c)(2)
// the allowance on disposition of the entire interest. Subsection (b) (the
// passive activity loss under section 469 with the section 56 and 57
// adjustments) is EXTERNAL_DEPENDENCY on the section 469 owner
// (`us.irc.accounting`): its result enters as a supplied adjustment
// (`amt_adjustment_supplied` with kind `PassiveActivityLoss58b`).
//
// SIGN CONVENTION. The farm loss is already deducted in taxable income. The
// adjustment of kind `TaxShelterFarmLoss58a` is therefore (loss of the year -
// the amount of the loss the year allows), the allowed part being the
// insolvency reduction; a disposal of the entire interest allows the whole
// loss of the activity (current plus carried-in) and yields the adjustment
// `FarmLossDisposition58c2` = -(carried-in), the carry-in being the only part
// not already deducted.

use self::{
    AmtAdjustmentKind,
    IRC_S58_A,
    IRC_S58_C,
    Person,
    TaxableYear,
    amt_adjustment,
    has_farm_chain_carry_year_58a1B,
    noncorporate_taxpayer_for_year,
};

entity FarmActivity {
    label en unofficial "an activity of the taxpayer that may be a tax shelter farm activity";
}

pub relation is_farming_syndicate_461k(a: FarmActivity) kind empirical {
    label en official "a farming syndicate as defined in section 461(k)";
}
pub relation is_farming_activity(a: FarmActivity) kind empirical {
    label en official "an activity consisting of farming";
}
pub relation is_passive_activity_469c(a: FarmActivity) kind empirical {
    label en official "a passive activity (within the meaning of section 469(c))";
}
pub relation tax_shelter_farm_activity(a: FarmActivity) kind institutional {
    label en official "the term \"tax shelter farm activity\"";
}

@source(IRC_S58_A, relation = formalizes, coverage = exact, quote = "(A) any farming syndicate as defined in section 461(k), and")
rule TaxShelterFarmActivitySyndicate(a: FarmActivity) strict {
    when is_farming_syndicate_461k(a);
    then tax_shelter_farm_activity(a);
}

@source(IRC_S58_A, relation = formalizes, coverage = exact, quote = "(B) any other activity consisting of farming which is a passive activity (within the meaning of section 469(c)).")
rule TaxShelterFarmActivityPassiveFarming(a: FarmActivity) strict {
    when is_farming_activity(a);
    when is_passive_activity_469c(a);
    then tax_shelter_farm_activity(a);
}

pub relation farm_activity_loss(p: Person, y: TaxableYear, a: FarmActivity, amount: Money) kind empirical {
    label en official "the loss of the taxpayer for the taxable year from the activity, determined with the adjustments of sections 56 and 57 (section 58(a)(3))";
}
pub relation farm_loss_carried_in(p: Person, y: TaxableYear, a: FarmActivity, amount: Money) kind empirical {
    label en official "a loss from the activity disallowed under subparagraph (A) for the preceding taxable year, treated as a deduction allocable to the activity in this year (case-supplied: the multi-year chain is not derived)";
}
pub relation disposed_entire_interest_in_activity(p: Person, y: TaxableYear, a: FarmActivity) kind empirical {
    label en official "the taxpayer disposes of his entire interest in the activity during the taxable year";
}

pub relation taxpayer_liabilities(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the taxpayer's liabilities as of the close of the taxable year";
}
pub relation fair_market_value_of_assets(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the fair market value of the taxpayer's assets as of the close of the taxable year (a valuation the case asserts; the text names no valuer)";
}
pub relation insolvency_amount(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount (if any) by which the taxpayer is insolvent as of the close of the taxable year: the excess of liabilities over the fair market value of assets";
}

@source(IRC_S58_C, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the term \"insolvent\" means the excess of liabilities over the fair market value of assets.")
rule InsolvencyAmountRule(p: Person, y: TaxableYear, liabilities: Money, assets: Money) strict {
    label en official "section 58(c)(1)(B): insolvent = the excess of liabilities over the fair market value of assets (never below zero)";
    when taxpayer_liabilities(p, y, liabilities);
    when fair_market_value_of_assets(p, y, assets);
    then insolvency_amount(p, y, max(0.00 USD, liabilities - assets));
}

// Per-activity loss subject to the denial: farm activities the taxpayer has
// not disposed of entirely this year. The two aggregates (current loss, carried-in
// loss) are separate because only the current loss is already in taxable income.
pub relation undisposed_farm_loss_current(p: Person, y: TaxableYear, a: FarmActivity, amount: Money) kind institutional {
    label en unofficial "the current-year loss of a tax shelter farm activity the taxpayer keeps";
}
rule UndisposedFarmLossCurrent(p: Person, y: TaxableYear, a: FarmActivity, loss: Money) strict {
    when noncorporate_taxpayer_for_year(p, y);
    when tax_shelter_farm_activity(a);
    when farm_activity_loss(p, y, a, loss);
    when not_known(disposed_entire_interest_in_activity(p, y, a));
    then undisposed_farm_loss_current(p, y, a, loss);
}
pub relation undisposed_farm_loss_carried_in(p: Person, y: TaxableYear, a: FarmActivity, amount: Money) kind institutional {
    label en unofficial "the carried-in disallowed loss of a tax shelter farm activity the taxpayer keeps";
}
rule UndisposedFarmLossCarriedIn(p: Person, y: TaxableYear, a: FarmActivity, carried: Money) strict {
    when noncorporate_taxpayer_for_year(p, y);
    when tax_shelter_farm_activity(a);
    when farm_loss_carried_in(p, y, a, carried);
    when not_known(disposed_entire_interest_in_activity(p, y, a));
    then undisposed_farm_loss_carried_in(p, y, a, carried);
}
relation has_undisposed_farm_activity(p: Person, y: TaxableYear) kind institutional {
    label en unofficial "the taxpayer has a tax shelter farm activity it did not dispose of entirely this year";
}
rule HasUndisposedFarmActivity(p: Person, y: TaxableYear) strict {
    when undisposed_farm_loss_current(p, y, _, _);
    then has_undisposed_farm_activity(p, y);
}
relation has_undisposed_farm_carry_in(p: Person, y: TaxableYear) kind institutional {
    label en unofficial "the taxpayer has a carried-in disallowed loss from a tax shelter farm activity it keeps";
}
rule HasUndisposedFarmCarryIn(p: Person, y: TaxableYear) strict {
    when undisposed_farm_loss_carried_in(p, y, _, _);
    then has_undisposed_farm_carry_in(p, y);
}

pub relation farm_loss_subject_to_denial(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the total of the year's losses (current and carried-in) to which subsection (a) applies, before the insolvency reduction";
}
relation farm_loss_current_total(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the total current-year loss of the undisposed tax shelter farm activities";
}
rule FarmLossCurrentTotalRule(p: Person, y: TaxableYear) strict {
    when has_undisposed_farm_activity(p, y);
    then farm_loss_current_total(p, y, sum all amount: Money for a: FarmActivity where undisposed_farm_loss_current(p, y, a, amount));
}
rule FarmLossCurrentTotalNone(p: Person, y: TaxableYear) strict {
    when noncorporate_taxpayer_for_year(p, y);
    when not_known(has_undisposed_farm_activity(p, y));
    then farm_loss_current_total(p, y, 0 USD);
}
relation farm_loss_carried_in_total(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the total carried-in disallowed loss of the undisposed tax shelter farm activities";
}
rule FarmLossCarriedInTotalRule(p: Person, y: TaxableYear) strict {
    when has_undisposed_farm_carry_in(p, y);
    then farm_loss_carried_in_total(p, y, sum all amount: Money for a: FarmActivity where undisposed_farm_loss_carried_in(p, y, a, amount));
}
rule FarmLossCarriedInTotalNone(p: Person, y: TaxableYear) strict {
    when noncorporate_taxpayer_for_year(p, y);
    when not_known(has_undisposed_farm_carry_in(p, y));
    then farm_loss_carried_in_total(p, y, 0 USD);
}

@source(IRC_S58_A, relation = formalizes, coverage = exact, quote = "(B) Deduction in succeeding taxable year")
rule FarmLossSubjectToDenialRule(p: Person, y: TaxableYear, current: Money, carried: Money) strict {
    label en official "section 58(a)(1): the losses to which the denial applies are the year's losses plus the deduction the first succeeding year receives for a disallowed loss";
    when farm_loss_current_total(p, y, current);
    when not_known(has_farm_chain_carry_year_58a1B(p, y));
    when farm_loss_carried_in_total(p, y, carried);
    then farm_loss_subject_to_denial(p, y, current + carried);
}

pub relation farm_loss_insolvency_reduction(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount of the losses reduced by the amount by which the taxpayer is insolvent as of the close of the taxable year (the part of the loss the year allows)";
}

@source(IRC_S58_C, relation = formalizes, coverage = exact, quote = "The amount of losses to which subsection (a) or (b) applies shall be reduced by the amount (if any) by which the taxpayer is insolvent as of the close of the taxable year.")
rule FarmLossInsolvencyReductionRule(p: Person, y: TaxableYear, subject: Money, insolvency: Money) strict {
    label en official "section 58(c)(1)(A): the loss subject to denial is reduced by the insolvency amount, so that much of it is allowed (at most the loss itself)";
    when farm_loss_subject_to_denial(p, y, subject);
    when insolvency_amount(p, y, insolvency);
    then farm_loss_insolvency_reduction(p, y, min(subject, insolvency));
}

pub relation disallowed_farm_loss(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the loss from tax shelter farm activities disallowed for the year, which is treated as a deduction allocable to the activity in the first succeeding taxable year";
}

@source(IRC_S58_A, relation = formalizes, coverage = exact, quote = "No loss of the taxpayer for such taxable year from any tax shelter farm activity shall be allowed.")
rule DisallowedFarmLossRule(p: Person, y: TaxableYear, subject: Money, reduction: Money) strict {
    label en official "section 58(a)(1)(A) with (c)(1): the disallowed loss = the loss subject to denial less the insolvency reduction";
    when farm_loss_subject_to_denial(p, y, subject);
    when farm_loss_insolvency_reduction(p, y, reduction);
    then disallowed_farm_loss(p, y, subject - reduction);
}

@source(IRC_S58_A, relation = formalizes, coverage = exact, quote = "No loss of the taxpayer for such taxable year from any tax shelter farm activity shall be allowed.")
rule AdjustmentTaxShelterFarmLoss(p: Person, y: TaxableYear, current: Money, reduction: Money) strict {
    label en official "section 58(a)(1)(A): the year's farm loss is not allowed, except the part the insolvency reduction allows; the adjustment adds back the loss already deducted and subtracts the allowed part";
    when farm_loss_current_total(p, y, current);
    when farm_loss_insolvency_reduction(p, y, reduction);
    then amt_adjustment(p, y, TaxShelterFarmLoss58a, current - reduction);
}

// --- Section 58(c)(2): disposition of the entire interest ---------------------

pub relation disposed_farm_loss_carried_in(p: Person, y: TaxableYear, a: FarmActivity, amount: Money) kind institutional {
    label en unofficial "the carried-in disallowed loss of a tax shelter farm activity the taxpayer disposes of entirely this year";
}
rule DisposedFarmLossCarriedIn(p: Person, y: TaxableYear, a: FarmActivity, carried: Money) strict {
    when noncorporate_taxpayer_for_year(p, y);
    when tax_shelter_farm_activity(a);
    when disposed_entire_interest_in_activity(p, y, a);
    when farm_loss_carried_in(p, y, a, carried);
    then disposed_farm_loss_carried_in(p, y, a, carried);
}
relation has_disposed_farm_carry_in(p: Person, y: TaxableYear) kind institutional {
    label en unofficial "the taxpayer disposes of the entire interest in a tax shelter farm activity that carries a disallowed loss";
}
rule HasDisposedFarmCarryIn(p: Person, y: TaxableYear) strict {
    when disposed_farm_loss_carried_in(p, y, _, _);
    then has_disposed_farm_carry_in(p, y);
}

@source(IRC_S58_C, relation = formalizes, coverage = partial, quote = "the amount of the loss attributable to such activity (determined after carryovers under subsection (a)(1)(B)) shall (to the extent otherwise allowable) be allowed for such taxable year in computing alternative minimum taxable income and not treated as a loss from a tax shelter farm activity.")
rule AdjustmentFarmLossAllowedOnDisposition(p: Person, y: TaxableYear) strict {
    label en official "section 58(c)(2): on disposal of the entire interest the whole loss (current plus carried-in) is allowed; the carried-in part is the only one not already deducted, so it reduces alternative minimum taxable income (the 'to the extent otherwise allowable' limit is not computed: the loss facts are asserted as allowable)";
    when has_disposed_farm_carry_in(p, y);
    then amt_adjustment(p, y, FarmLossDisposition58c2, 0.00 USD - (sum all amount: Money for a: FarmActivity where disposed_farm_loss_carried_in(p, y, a, amount)));
}
