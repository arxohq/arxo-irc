// Section 55(d)(3) and (4)(B) and section 59(j)(2): the inflation adjustment
// of the alternative minimum tax amounts by the cost-of-living adjustment
// mechanism of `60-cost-of-living-adjustment.law` (stage 3, TECH_GAP
// reduction, 26.09.2026).
//
// The A3 datasets `55-*.lawparam.json` keep the figures a Revenue Procedure
// published (2025, 2026) and are what `55-amt.law` reads. This module is the
// STATUTORY INDEXING: for each amount the statutory figure, the year
// substituted for 2016, the years to which the adjustment applies and the
// rounding. `section_55d_indexed_amount` answers only when the C-CPI-U and CPI
// facts of the mechanism are asserted (they are Bureau of Labor Statistics
// data and are not pinned).
//
// SECTION 55(d)(3): base year 2011, taxable years beginning in a calendar
// year after 2012, the increased amount rounded to the nearest $100. It
// reaches the $175,000 of (b)(1)(A), the amounts of (d)(1)(A), (B), (D) and
// of (d)(2)(A), (B). SECTION 55(d)(4)(B): from 2018 the substituted $109,400
// and $70,300 (which replace $78,750 and $50,600) and the $1,000,000
// (which replaces $150,000) are adjusted instead (base 2017, after 2018);
// clause (iv): no (d)(3) adjustment to the numbers substituted. Pub. L.
// 119-21 section 70107(b) (fragment PL119_21_S70107): for taxable years
// beginning after 2025 the $1,000,000 is adjusted only for years after 2026
// and with 2025 for 2016 substituted; the $109,400 and $70,300 keep 2017.
// (The section 55(d)(2)(B) threshold, "50 percent of the dollar amount
// applicable under subparagraph (A)", is derived from the adjusted (A)
// amount, not indexed itself: it is not among the amounts of (3)(B)(iii) once
// substituted.)

use self::{
    IRC_S55_B,
    IRC_S55_D,
    IRC_S59_J,
    TaxableYear,
    amount_to_index_increase_nearest_50,
    amount_to_index_nearest_100,
    cola_adjusted_amount_increase_nearest_50,
    cola_adjusted_amount_nearest_100,
};

pub enum Section55dAmount {
    Breakpoint55b1A;
    Exemption55d1A;
    Exemption55d1B;
    Exemption55d1D;
    Threshold55d2A;
    Threshold55d2B;
    SubstitutedExemptionJoint;
    SubstitutedExemptionUnmarried;
    SubstitutedThreshold;
}

pub relation section_55d_statutory_amount(k: Section55dAmount, amount: Money) kind institutional {
    label en official "the dollar amount of section 55(b)(1)(A), (d)(1), (d)(2) and (d)(4)(A) before the inflation adjustment";
}
pub relation section_55d_indexed_amount(k: Section55dAmount, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount after the section 55(d)(3) or (4)(B) inflation adjustment for the taxable year, rounded to the nearest $100";
}

@source(IRC_S55_B, relation = formalizes, coverage = partial, quote = "$175,000")
rule Statutory55b1A() strict { then section_55d_statutory_amount(Breakpoint55b1A, 175000 USD); }
@source(IRC_S55_D, relation = formalizes, coverage = exact, quote = "(A) $78,750 in the case of—")
rule Statutory55d1A() strict { then section_55d_statutory_amount(Exemption55d1A, 78750 USD); }
@source(IRC_S55_D, relation = formalizes, coverage = exact, quote = "(B) $50,600 in the case of an individual who—")
rule Statutory55d1B() strict { then section_55d_statutory_amount(Exemption55d1B, 50600 USD); }
@source(IRC_S55_D, relation = formalizes, coverage = exact, quote = "(D) $22,500 in the case of an estate or trust.")
rule Statutory55d1D() strict { then section_55d_statutory_amount(Exemption55d1D, 22500 USD); }
@source(IRC_S55_D, relation = formalizes, coverage = exact, quote = "(A) $150,000 in the case of a taxpayer described in paragraph (1)(A),")
rule Statutory55d2A() strict { then section_55d_statutory_amount(Threshold55d2A, 150000 USD); }
@source(IRC_S55_D, relation = formalizes, coverage = exact, quote = "(B) $112,500 in the case of a taxpayer described in paragraph (1)(B), and")
rule Statutory55d2B() strict { then section_55d_statutory_amount(Threshold55d2B, 112500 USD); }
@source(IRC_S55_D, relation = formalizes, coverage = exact, quote = "(I) by substituting \"$109,400\" for \"$78,750\" in subparagraph (A), and")
rule Statutory55d4AiI() strict { then section_55d_statutory_amount(SubstitutedExemptionJoint, 109400 USD); }
@source(IRC_S55_D, relation = formalizes, coverage = exact, quote = "(II) by substituting \"$70,300\" for \"$50,600\" in subparagraph (B)")
rule Statutory55d4AiII() strict { then section_55d_statutory_amount(SubstitutedExemptionUnmarried, 70300 USD); }
@source(IRC_S55_D, relation = formalizes, coverage = exact, quote = "(I) by substituting \"$1,000,000\" for \"$150,000\" in subparagraph (A),")
rule Statutory55d4AiiI() strict { then section_55d_statutory_amount(SubstitutedThreshold, 1000000 USD); }

// --- Section 55(d)(3): base year 2011, years after 2012 ----------------------

@source(IRC_S55_D, relation = formalizes, coverage = exact, quote = "In the case of any taxable year beginning in a calendar year after 2012, the amounts described in subparagraph (B) shall each be increased by an amount equal to—")
rule Request55d3IndexingLasting(k: Section55dAmount, base: Money, y: TaxableYear, cy: Integer) strict {
    label en official "section 55(d)(3)(A): the $175,000 of (b)(1)(A), the estate-or-trust $22,500 and the (d)(2)(B) threshold are adjusted for taxable years beginning after 2012";
    when section_55d_statutory_amount(k, base);
    when us.irc.core::calendar_year_of(y, cy);
    when cy > 2012;
    when is_55d3_amount_all_years(k);
    then amount_to_index_nearest_100(base, 2011, y);
}
@source(IRC_S55_D, relation = formalizes, coverage = exact, quote = "(iv) Coordination with current adjustments")
rule Request55d3IndexingBefore2018(k: Section55dAmount, base: Money, y: TaxableYear, cy: Integer) strict {
    label en official "section 55(d)(3) with (4)(B)(iv): the amounts of (d)(1)(A), (B) and (d)(2)(A) are adjusted by (3) only for the years before the (4)(A) substitutions apply (2013-2017)";
    when section_55d_statutory_amount(k, base);
    when us.irc.core::calendar_year_of(y, cy);
    when cy > 2012;
    when cy < 2018;
    when is_55d3_amount_replaced_from_2018(k);
    then amount_to_index_nearest_100(base, 2011, y);
}
relation is_55d3_amount_all_years(k: Section55dAmount) kind institutional {
    label en unofficial "an amount named in section 55(d)(3)(B) that the (4)(A) substitutions do not replace (so it is adjusted in every year after 2012)";
}
relation is_55d3_amount_replaced_from_2018(k: Section55dAmount) kind institutional {
    label en unofficial "an amount named in section 55(d)(3)(B) that section 55(d)(4)(A) replaces for taxable years beginning after 2017";
}
rule AllYears55b1A() strict { then is_55d3_amount_all_years(Breakpoint55b1A); }
rule AllYears55d1D() strict { then is_55d3_amount_all_years(Exemption55d1D); }
rule AllYears55d2B() strict { then is_55d3_amount_all_years(Threshold55d2B); }
rule Replaced55d1A() strict { then is_55d3_amount_replaced_from_2018(Exemption55d1A); }
rule Replaced55d1B() strict { then is_55d3_amount_replaced_from_2018(Exemption55d1B); }
rule Replaced55d2A() strict { then is_55d3_amount_replaced_from_2018(Threshold55d2A); }

// --- Section 55(d)(4)(B): substituted amounts, base year 2017 ------------------

@source(IRC_S55_D, relation = formalizes, coverage = exact, quote = "In the case of any taxable year beginning in a calendar year after 2018, the amounts described in clause (ii) shall each be increased by an amount equal to—")
rule Request55d4BExemptions(k: Section55dAmount, base: Money, y: TaxableYear, cy: Integer) strict {
    label en official "section 55(d)(4)(B)(i)-(ii): the $109,400 and $70,300 are adjusted for taxable years beginning after 2018, 2017 substituted for 2016";
    when section_55d_statutory_amount(k, base);
    when us.irc.core::calendar_year_of(y, cy);
    when cy > 2018;
    when is_55d4b_exemption_amount(k);
    then amount_to_index_nearest_100(base, 2017, y);
}
relation is_55d4b_exemption_amount(k: Section55dAmount) kind institutional {
    label en unofficial "one of the two substituted exemption amounts adjusted with 2017 as the base year";
}
rule Is55d4BExemptionJoint() strict { then is_55d4b_exemption_amount(SubstitutedExemptionJoint); }
rule Is55d4BExemptionUnmarried() strict { then is_55d4b_exemption_amount(SubstitutedExemptionUnmarried); }

@source(IRC_S55_D, relation = formalizes, coverage = exact, quote = "In the case of any taxable year beginning in a calendar year after 2018, the amounts described in clause (ii) shall each be increased by an amount equal to—")
rule Request55d4BThresholdThrough2025(base: Money, y: TaxableYear, cy: Integer) strict {
    label en official "section 55(d)(4)(B) (2024-Edition text): the $1,000,000 is adjusted for taxable years beginning after 2018 with 2017 substituted; the years 2019-2025";
    when section_55d_statutory_amount(SubstitutedThreshold, base);
    when us.irc.core::calendar_year_of(y, cy);
    when cy > 2018;
    when cy < 2026;
    then amount_to_index_nearest_100(base, 2017, y);
}
@source(us.irc.temporal::PL119_21_S70107, relation = formalizes, coverage = exact, quote = "2018 (2026, in the case of the $1,000,000 amount in subparagraph (A)(ii)(I))")
rule Request55d4BThresholdFrom2027(base: Money, y: TaxableYear, cy: Integer) strict {
    label en official "section 55(d)(4)(B) as amended by Pub. L. 119-21 section 70107(b): the $1,000,000 is adjusted for taxable years beginning after 2026 with calendar year 2025 substituted for 2016";
    effective [@2025-07-04, infinity);
    when section_55d_statutory_amount(SubstitutedThreshold, base);
    when us.irc.core::calendar_year_of(y, cy);
    when cy > 2026;
    then amount_to_index_nearest_100(base, 2025, y);
}

@source(IRC_S55_D, relation = formalizes, coverage = exact, quote = "Any increased amount determined under clause (i) shall be rounded to the nearest multiple of $100.")
rule Section55dIndexedAmount(k: Section55dAmount, base: Money, base_year: Integer, y: TaxableYear, adjusted: Money) strict {
    label en official "section 55(d)(3)(C), (4)(B)(iii): the increased amount is rounded to the nearest multiple of $100";
    when section_55d_statutory_amount(k, base);
    when section_55d_base_year(k, y, base_year);
    when cola_adjusted_amount_nearest_100(base, base_year, y, adjusted);
    then section_55d_indexed_amount(k, y, adjusted);
}
relation section_55d_base_year(k: Section55dAmount, y: TaxableYear, base_year: Integer) kind institutional {
    label en unofficial "the year substituted for 2016 in section 1(f)(3)(A)(ii) for the amount and the taxable year";
}
@source(IRC_S55_D, relation = formalizes, coverage = exact, quote = "determined by substituting \"calendar year 2011\" for \"calendar year 2016\" in subparagraph (A)(ii) thereof.")
rule BaseYear2011For55d3(k: Section55dAmount, y: TaxableYear) strict {
    label en official "section 55(d)(3)(A)(ii): 2011 for 2016";
    when is_55d3_amount_all_years(k);
    when us.irc.core::calendar_year_of(y, _);
    then section_55d_base_year(k, y, 2011);
}
@source(IRC_S55_D, relation = formalizes, coverage = exact, quote = "determined by substituting \"calendar year 2011\" for \"calendar year 2016\" in subparagraph (A)(ii) thereof.")
rule BaseYear2011For55d3Replaced(k: Section55dAmount, y: TaxableYear) strict {
    label en official "section 55(d)(3)(A)(ii): 2011 for 2016 for the amounts later substituted";
    when is_55d3_amount_replaced_from_2018(k);
    when us.irc.core::calendar_year_of(y, _);
    then section_55d_base_year(k, y, 2011);
}
@source(IRC_S55_D, relation = formalizes, coverage = exact, quote = "determined by substituting \"calendar year 2017\" for \"calendar year 2016\" in subparagraph (A)(ii) thereof.")
rule BaseYear2017For55d4B(k: Section55dAmount, y: TaxableYear) strict {
    label en official "section 55(d)(4)(B)(i)(II): 2017 for 2016";
    when is_55d4b_exemption_amount(k);
    when us.irc.core::calendar_year_of(y, _);
    then section_55d_base_year(k, y, 2017);
}
@source(IRC_S55_D, relation = formalizes, coverage = exact, quote = "determined by substituting \"calendar year 2017\" for \"calendar year 2016\" in subparagraph (A)(ii) thereof.")
rule BaseYearThreshold2017(y: TaxableYear, cy: Integer) strict {
    label en official "section 55(d)(4)(B)(i)(II): 2017 for 2016, the $1,000,000 in the years 2019-2025";
    when us.irc.core::calendar_year_of(y, cy);
    when cy < 2026;
    then section_55d_base_year(SubstitutedThreshold, y, 2017);
}
@source(us.irc.temporal::PL119_21_S70107, relation = formalizes, coverage = exact, quote = "‘calendar year 2025’, in the case of the $1,000,000 amount in subparagraph (A)(ii)(I).")
rule BaseYearThreshold2025(y: TaxableYear, cy: Integer) strict {
    label en official "Pub. L. 119-21 section 70107(b)(2): calendar year 2025 for 2016 for the $1,000,000";
    effective [@2025-07-04, infinity);
    when us.irc.core::calendar_year_of(y, cy);
    when cy > 2025;
    then section_55d_base_year(SubstitutedThreshold, y, 2025);
}

// --- Section 59(j)(2): the $5,000 addend of the child's exemption cap ----------

pub relation child_exemption_addend_indexed(y: TaxableYear, amount: Money) kind institutional {
    label en official "the $5,000 of section 59(j)(1)(B) increased for taxable years beginning after 1998 by the cost-of-living adjustment with 1997 substituted for 2016, the increase rounded to the nearest $50";
}
@source(IRC_S59_J, relation = formalizes, coverage = exact, quote = "In the case of any taxable year beginning in a calendar year after 1998, the dollar amount in paragraph (1)(B) shall be increased by an amount equal to the product of—")
rule RequestChildAddendIndexing(y: TaxableYear, cy: Integer) strict {
    label en official "section 59(j)(2): the dollar amount is to be increased for a taxable year beginning after 1998";
    when us.irc.core::calendar_year_of(y, cy);
    when cy > 1998;
    then amount_to_index_increase_nearest_50(5000 USD, 1997, y);
}
@source(IRC_S59_J, relation = formalizes, coverage = exact, quote = "determined by substituting \"1997\" for \"2016\" in subparagraph (A)(ii) thereof.")
rule ChildExemptionAddendIndexed(y: TaxableYear, adjusted: Money) strict {
    label en official "section 59(j)(2): $5,000 + $5,000 x COLA (base year 1997), the increase rounded to the nearest $50";
    when cola_adjusted_amount_increase_nearest_50(5000 USD, 1997, y, adjusted);
    then child_exemption_addend_indexed(y, adjusted);
}

// --- Years without an increase: the statutory figure stands ---------------------

@source(IRC_S55_D, relation = formalizes, coverage = partial, quote = "In the case of any taxable year beginning in a calendar year after 2018, the amounts described in clause (ii) shall each be increased by an amount equal to—")
rule Substituted55dAmountUnadjustedIn2018(k: Section55dAmount, base: Money, y: TaxableYear, cy: Integer) strict {
    label en official "section 55(d)(4)(B): no adjustment for a taxable year beginning in 2018 (the increase starts after 2018), so the substituted figure is the statutory one";
    when section_55d_statutory_amount(k, base);
    when is_55d4b_exemption_amount(k);
    when us.irc.core::calendar_year_of(y, cy);
    when cy == 2018;
    then section_55d_indexed_amount(k, y, base);
}
@source(us.irc.temporal::PL119_21_S70107, relation = formalizes, coverage = exact, quote = "2018 (2026, in the case of the $1,000,000 amount in subparagraph (A)(ii)(I))")
rule Threshold55dUnadjustedIn2026(base: Money, y: TaxableYear, cy: Integer) strict {
    label en official "section 55(d)(4)(B) as amended by Pub. L. 119-21 section 70107(b): the $1,000,000 stands as enacted in 2026, because the adjustment now begins after 2026";
    effective [@2025-07-04, infinity);
    when section_55d_statutory_amount(SubstitutedThreshold, base);
    when us.irc.core::calendar_year_of(y, cy);
    when cy == 2026;
    then section_55d_indexed_amount(SubstitutedThreshold, y, base);
}
