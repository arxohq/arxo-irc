// Section 55 (alternative minimum tax, noncorporate taxpayers) scenarios.
// NOT EXECUTED in this assignment (status implemented_unverified). Expectations are
// computed by hand from the pinned statutory text and Revenue Procedure figures, not
// from any engine output.

language "law.core" version "0.2";
package us.irc.income_individual version "0.1.1";
namespace "urn:us:irc:income_individual:clir";

test "S55-01-UNMARRIED-2025-BELOW-28-PERCENT-BREAKPOINT-EXEMPTION-AFTER-PHASEOUT" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": filing_status(entity_ref("urn:test:s55:s55-01#p"), entity_ref("urn:test:s55:s55-01#y"), Unmarried) { origin case_input; }
        assert "f1": taxable_income(entity_ref("urn:test:s55:s55-01#p"), entity_ref("urn:test:s55:s55-01#y"), 300000 USD) { origin case_input; }
    }
    // exemption before reduction 88100; AMTI 300000
    evaluate truth(amt_exemption_final(entity_ref("urn:test:s55:s55-01#p"), entity_ref("urn:test:s55:s55-01#y"), 88100 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

