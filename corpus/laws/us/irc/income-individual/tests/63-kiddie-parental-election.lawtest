// Section 1(g)(6)-(7) and section 3(a)(3): parental election, TIN duties and the extension of the tax tables to itemizers (stage 3).
// NOT EXECUTED in this assignment (status implemented_unverified). Expectations are
// computed by hand from the pinned statutory text, not from any engine output.
// Index values (C-CPI-U, CPI) in scenarios are SYNTHETIC round numbers chosen for hand
// arithmetic; they are not Bureau of Labor Statistics data.

language "law.core" version "0.2";
package us.irc.income_individual version "0.1.1";
namespace "urn:us:irc:income_individual:clir";

test "S63-01-ELECTION-CONDITIONS-MET-BETWEEN-ONE-AND-TEN-TIMES-THE-AMOUNT" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": kiddie_tax_applies(entity_ref("urn:test:s63#child"), entity_ref("urn:test:s63#y")) { origin case_input; }
        assert "f1": kiddie_tax_parent(entity_ref("urn:test:s63#child"), entity_ref("urn:test:s63#y"), entity_ref("urn:test:s63#parent")) { origin case_input; }
        assert "f2": child_gross_income_only_interest_and_dividends(entity_ref("urn:test:s63#child"), entity_ref("urn:test:s63#y")) { origin case_input; }
        assert "f3": section_63c5a_amount(entity_ref("urn:test:s63#y"), 1300 USD) { origin case_input; }
        assert "f4": child_gross_income(entity_ref("urn:test:s63#child"), entity_ref("urn:test:s63#y"), 3000 USD) { origin case_input; }
    }
    // gross income 3000 is more than 1300 and less than 13000
    evaluate truth(g7_election_conditions_met(entity_ref("urn:test:s63#parent"), entity_ref("urn:test:s63#child"), entity_ref("urn:test:s63#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

