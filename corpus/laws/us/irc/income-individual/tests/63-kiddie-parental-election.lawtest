}

test "S3A3-02-EXTENSION-INVALID-WITHOUT-TAXABLE-INCOME-BASIS" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.core::calendar_year_of(entity_ref("urn:test:s63#y3"), 2025) { origin case_input; }
        assert "f1": secretary_extends_tables_to_itemizers(entity_ref("urn:test:s63#y3")) { origin case_input; }
    }
    // the tables must be on the basis of taxable income
    evaluate truth(tables_extended_to_itemizers_in_effect(entity_ref("urn:test:s63#y3")));
    expect truth_status == NEITHER;
    expect issue(POWER_INVALID_EXERCISE);
}

test "S3A3-03-ITEMIZER-HAS-TABLE-TAX-UNDER-THE-EXTENSION" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.core::calendar_year_of(entity_ref("urn:test:s63#y3"), 2025) { origin case_input; }
        assert "f1": secretary_extends_tables_to_itemizers(entity_ref("urn:test:s63#y3")) { origin case_input; }
        assert "f2": tables_for_itemizers_on_taxable_income_basis(entity_ref("urn:test:s63#y3")) { origin case_input; }
        assert "f3": taxable_income(entity_ref("urn:test:s63#p3"), entity_ref("urn:test:s63#y3"), 15000 USD) { origin case_input; }
        assert "f4": ceiling_amount(entity_ref("urn:test:s63#y3"), 20000 USD) { origin case_input; }
        assert "f5": taxable_at_most(15000 USD, 20000 USD) { origin case_input; }
        assert "f6": table_tax_amount(entity_ref("urn:test:s63#p3"), entity_ref("urn:test:s63#y3"), 15000 USD) { origin case_input; }
    }
    evaluate truth(tax_under_section_1_via_table(entity_ref("urn:test:s63#p3"), entity_ref("urn:test:s63#y3"), 15000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S3A3-04-ITEMIZER-HAS-NO-TABLE-TAX-WITHOUT-THE-EXTENSION" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": itemizes_deductions_for_year(entity_ref("urn:test:s63#p3"), entity_ref("urn:test:s63#y3")) { origin case_input; }
        assert "f1": taxable_income(entity_ref("urn:test:s63#p3"), entity_ref("urn:test:s63#y3"), 15000 USD) { origin case_input; }
        assert "f2": ceiling_amount(entity_ref("urn:test:s63#y3"), 20000 USD) { origin case_input; }
        assert "f3": taxable_at_most(15000 USD, 20000 USD) { origin case_input; }
        assert "f4": table_tax_amount(entity_ref("urn:test:s63#p3"), entity_ref("urn:test:s63#y3"), 15000 USD) { origin case_input; }
    }
    // section 3(a)(1)(A): only individuals who do not itemize
    evaluate truth(tax_under_section_1_via_table(entity_ref("urn:test:s63#p3"), entity_ref("urn:test:s63#y3"), 15000 USD));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

