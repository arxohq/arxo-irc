        assert "f7": bond_interest_received(entity_ref("urn:test:s63#child"), entity_ref("urn:test:s63#y"), entity_ref("urn:test:s63#bond"), 500 USD) { origin case_input; }
        assert "f8": specified_private_activity_bond(entity_ref("urn:test:s63#bond")) { origin case_input; }
        assert "f9": deduction_allowable_if_interest_includible(entity_ref("urn:test:s63#child"), entity_ref("urn:test:s63#y"), 0 USD) { origin case_input; }
