    // 10000 + 130 + 70
    evaluate truth(parent_tax_under_g7_election(entity_ref("urn:test:s63#parent"), entity_ref("urn:test:s63#y"), 10200 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

