// Section 1(g) kiddie-tax scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.income_individual version "0.1.1";
namespace "urn:us:irc:income_individual:clir";

test "S1G-01-CHILD-UNDER-18-KIDDIE-TAX-APPLIES" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": attained_age_18_before_close_of_year(entity_ref("urn:test:s1g:c1#child"), entity_ref("urn:test:s1g:c1#y2024")) { origin case_input; polarity negative; }
        assert "f1": parent_alive_at_close_of_year(entity_ref("urn:test:s1g:c1#child"), entity_ref("urn:test:s1g:c1#y2024")) { origin case_input; }
        assert "f2": child_files_joint_return(entity_ref("urn:test:s1g:c1#child"), entity_ref("urn:test:s1g:c1#y2024")) { origin case_input; polarity negative; }
    }
    evaluate truth(kiddie_tax_applies(entity_ref("urn:test:s1g:c1#child"), entity_ref("urn:test:s1g:c1#y2024")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1G-02-CHILD-FILES-JOINT-RETURN-EXCLUDED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": attained_age_18_before_close_of_year(entity_ref("urn:test:s1g:c2#child"), entity_ref("urn:test:s1g:c2#y2024")) { origin case_input; polarity negative; }
        assert "f1": parent_alive_at_close_of_year(entity_ref("urn:test:s1g:c2#child"), entity_ref("urn:test:s1g:c2#y2024")) { origin case_input; }
        assert "f2": child_files_joint_return(entity_ref("urn:test:s1g:c2#child"), entity_ref("urn:test:s1g:c2#y2024")) { origin case_input; }
    }
    evaluate truth(kiddie_tax_applies(entity_ref("urn:test:s1g:c2#child"), entity_ref("urn:test:s1g:c2#y2024")));
    expect truth_status == FALSE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1G-03-NET-UNEARNED-INCOME-NON-ITEMIZER" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": adjusted_gross_income(entity_ref("urn:test:s1g:nui1#child"), entity_ref("urn:test:s1g:nui1#y2024"), 5000 USD) { origin case_input; }
        assert "f1": earned_income(entity_ref("urn:test:s1g:nui1#child"), entity_ref("urn:test:s1g:nui1#y2024"), 500 USD) { origin case_input; }
        assert "f2": section_63c5a_amount(entity_ref("urn:test:s1g:nui1#y2024"), 1300 USD) { origin case_input; }
        assert "f3": itemizes_deductions(entity_ref("urn:test:s1g:nui1#child"), entity_ref("urn:test:s1g:nui1#y2024")) { origin case_input; polarity negative; }
    }
    // (5000-500) - 2*1300 = 4500 - 2600 = 1900
    evaluate truth(net_unearned_income(entity_ref("urn:test:s1g:nui1#child"), entity_ref("urn:test:s1g:nui1#y2024"), 1900 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1G-04-CUSTODIAL-PARENT-UNMARRIED-SELECTED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": custodial_parent(entity_ref("urn:test:s1g:parent1#child"), entity_ref("urn:test:s1g:parent1#y2024"), entity_ref("urn:test:s1g:parent1#mom")) { origin case_input; }
        assert "f1": married_at_close_of_year(entity_ref("urn:test:s1g:parent1#mom"), entity_ref("urn:test:s1g:parent1#y2024")) { origin case_input; polarity negative; }
    }
    evaluate truth(kiddie_tax_parent(entity_ref("urn:test:s1g:parent1#child"), entity_ref("urn:test:s1g:parent1#y2024"), entity_ref("urn:test:s1g:parent1#mom")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1G-05-UNKNOWN-AGE-IS-UNDETERMINED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": parent_alive_at_close_of_year(entity_ref("urn:test:s1g:unknown#child"), entity_ref("urn:test:s1g:unknown#y2024")) { origin case_input; }
    }
    evaluate truth(kiddie_tax_applies(entity_ref("urn:test:s1g:unknown#child"), entity_ref("urn:test:s1g:unknown#y2024")));
    expect truth_status == NEITHER;
}
