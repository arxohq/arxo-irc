test "S62-10-THRESHOLD-1000000-UNADJUSTED-IN-2026-AFTER-AMENDMENT" {
    given {
        context {
            legal_time @2026-12-31;
            decision_time @2026-12-31T09:00:00-05:00;
            knowledge_time @2026-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.core::calendar_year_of(entity_ref("urn:test:s62#y"), 2026) { origin case_input; }
    }
    // Pub. L. 119-21 section 70107(b): the adjustment begins after 2026
    evaluate truth(section_55d_indexed_amount(SubstitutedThreshold, entity_ref("urn:test:s62#y"), 1000000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

