// Sections 55(d)(3), 55(d)(4)(B) and 59(j)(2): the statutory indexing of the AMT amounts (stage 3).
// NOT EXECUTED in this assignment (status implemented_unverified). Expectations are
// computed by hand from the pinned statutory text, not from any engine output.
// Index values (C-CPI-U, CPI) in scenarios are SYNTHETIC round numbers chosen for hand
// arithmetic; they are not Bureau of Labor Statistics data.

language "law.core" version "0.2";
package us.irc.income_individual version "0.1.1";
namespace "urn:us:irc:income_individual:clir";

test "S62-01-BREAKPOINT-175000-INDEXED-FROM-2011" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": c_cpi_u_window_month(2011, 1, 105.0) { origin case_input; }
        assert "f1": c_cpi_u_window_month(2011, 2, 105.0) { origin case_input; }
        assert "f2": c_cpi_u_window_month(2011, 3, 105.0) { origin case_input; }
        assert "f3": c_cpi_u_window_month(2011, 4, 105.0) { origin case_input; }
        assert "f4": c_cpi_u_window_month(2011, 5, 105.0) { origin case_input; }
        assert "f5": c_cpi_u_window_month(2011, 6, 105.0) { origin case_input; }
        assert "f6": c_cpi_u_window_month(2011, 7, 105.0) { origin case_input; }
        assert "f7": c_cpi_u_window_month(2011, 8, 105.0) { origin case_input; }
        assert "f8": c_cpi_u_window_month(2011, 9, 105.0) { origin case_input; }
        assert "f9": c_cpi_u_window_month(2011, 10, 105.0) { origin case_input; }
        assert "f10": c_cpi_u_window_month(2011, 11, 105.0) { origin case_input; }
        assert "f11": c_cpi_u_window_month(2011, 12, 105.0) { origin case_input; }
        assert "f12": c_cpi_u_window_month(2024, 1, 126.0) { origin case_input; }
        assert "f13": c_cpi_u_window_month(2024, 2, 126.0) { origin case_input; }
        assert "f14": c_cpi_u_window_month(2024, 3, 126.0) { origin case_input; }
        assert "f15": c_cpi_u_window_month(2024, 4, 126.0) { origin case_input; }
        assert "f16": c_cpi_u_window_month(2024, 5, 126.0) { origin case_input; }
        assert "f17": c_cpi_u_window_month(2024, 6, 126.0) { origin case_input; }
        assert "f18": c_cpi_u_window_month(2024, 7, 126.0) { origin case_input; }
        assert "f19": c_cpi_u_window_month(2024, 8, 126.0) { origin case_input; }
        assert "f20": c_cpi_u_window_month(2024, 9, 126.0) { origin case_input; }
        assert "f21": c_cpi_u_window_month(2024, 10, 126.0) { origin case_input; }
        assert "f22": c_cpi_u_window_month(2024, 11, 126.0) { origin case_input; }
        assert "f23": c_cpi_u_window_month(2024, 12, 126.0) { origin case_input; }
        assert "f24": us.irc.core::calendar_year_of(entity_ref("urn:test:s62#y"), 2025) { origin case_input; }
    }
    // 175000 x 1.2 = 210000, a multiple of 100
    evaluate truth(section_55d_indexed_amount(Breakpoint55b1A, entity_ref("urn:test:s62#y"), 210000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

