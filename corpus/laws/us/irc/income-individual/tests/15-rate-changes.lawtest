// Section 15 (effect of changes in rates) scenarios.
// NOT EXECUTED in this assignment (status implemented_unverified). Expectations are
// computed by hand from the pinned statutory text and Revenue Procedure figures, not
// from any engine output.

language "law.core" version "0.2";
package us.irc.income_individual version "0.1.1";
namespace "urn:us:irc:income_individual:clir";

test "S15-01-BEGINNING-AFTER-DEC-31-EFFECTIVE-NEXT-DAY-PRORATED-TAX" {
    given {
        context {
            legal_time @2018-07-15;
            decision_time @2018-07-15T09:00:00-05:00;
            knowledge_time @2018-07-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": rate_change_source(entity_ref("urn:test:s15:t1#chg"), Ordinary) { origin case_input; }
        assert "f1": us.irc.core::begins(entity_ref("urn:test:s15:t1#y"), @2017-07-01) { origin case_input; }
        assert "f2": us.irc.core::ends(entity_ref("urn:test:s15:t1#y"), @2018-06-30) { origin case_input; }
        assert "f3": rate_change_stated_beginning_after(entity_ref("urn:test:s15:t1#chg"), @2017-12-31) { origin case_input; }
        assert "f4": tentative_tax_before_change(entity_ref("urn:test:s15:t1#p"), entity_ref("urn:test:s15:t1#y"), entity_ref("urn:test:s15:t1#chg"), 36500 USD) { origin case_input; }
        assert "f5": tentative_tax_after_change(entity_ref("urn:test:s15:t1#p"), entity_ref("urn:test:s15:t1#y"), entity_ref("urn:test:s15:t1#chg"), 73000 USD) { origin case_input; }
    }
    // fiscal year 2017-07-01..2018-06-30 has 365 days; the change is effective 2018-01-01 ("beginning after" 2017-12-31, section 15(c)(1)); 184 days before, 181 on and after; (36500*184 + 73000*181)/365 = 54600
    evaluate truth(tax_for_rate_change_year(entity_ref("urn:test:s15:t1#p"), entity_ref("urn:test:s15:t1#y"), entity_ref("urn:test:s15:t1#chg"), 54600 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

