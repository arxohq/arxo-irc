test "S15-12-HIGHEST-RATE-REFERENCE-IS-DAY-WEIGHTED-AVERAGE" {
    given {
        context {
            legal_time @2019-12-31;
            decision_time @2019-12-31T09:00:00-05:00;
            knowledge_time @2019-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": rate_change_source(entity_ref("urn:test:s15:t12#chg"), Ordinary) { origin case_input; }
        assert "f1": us.irc.core::begins(entity_ref("urn:test:s15:t12#y"), @2019-01-01) { origin case_input; }
        assert "f2": us.irc.core::ends(entity_ref("urn:test:s15:t12#y"), @2019-12-31) { origin case_input; }
        assert "f3": rate_change_stated_beginning_after(entity_ref("urn:test:s15:t12#chg"), @2019-06-30) { origin case_input; }
        assert "f4": highest_rate_before_change(entity_ref("urn:test:s15:t12#chg"), 0.365) { origin case_input; }
        assert "f5": highest_rate_after_change(entity_ref("urn:test:s15:t12#chg"), 0.73) { origin case_input; }
    }
    // section 15(e): (0.365*181 + 0.73*184)/365 = 0.549
    evaluate truth(highest_rate_reference_for_year(entity_ref("urn:test:s15:t12#y"), entity_ref("urn:test:s15:t12#chg"), 0.549));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S15-13-MISSING-TENTATIVE-TAX-AFTER-NO-RESULT" {
    given {
        context {
            legal_time @2019-12-31;
            decision_time @2019-12-31T09:00:00-05:00;
            knowledge_time @2019-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": rate_change_source(entity_ref("urn:test:s15:t13#chg"), Ordinary) { origin case_input; }
        assert "f1": us.irc.core::begins(entity_ref("urn:test:s15:t13#y"), @2019-01-01) { origin case_input; }
        assert "f2": us.irc.core::ends(entity_ref("urn:test:s15:t13#y"), @2019-12-31) { origin case_input; }
        assert "f3": rate_change_stated_beginning_after(entity_ref("urn:test:s15:t13#chg"), @2019-06-30) { origin case_input; }
        assert "f4": tentative_tax_before_change(entity_ref("urn:test:s15:t13#p"), entity_ref("urn:test:s15:t13#y"), entity_ref("urn:test:s15:t13#chg"), 10000 USD) { origin case_input; }
    }
    // unknown key fact: no tentative tax for the period after the change is asserted, so no proration is derived (NEITHER, not zero)
    evaluate truth(tax_for_rate_change_year(entity_ref("urn:test:s15:t13#p"), entity_ref("urn:test:s15:t13#y"), entity_ref("urn:test:s15:t13#chg"), 10000 USD));
    expect truth_status == NEITHER;
}

