test "S15-05-EFFECTIVE-ON-FIRST-DAY-OF-YEAR-NO-PRORATION" {
    given {
        context {
            legal_time @2018-12-31;
            decision_time @2018-12-31T09:00:00-05:00;
            knowledge_time @2018-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": rate_change_source(entity_ref("urn:test:s15:t5#chg"), Ordinary) { origin case_input; }
        assert "f1": us.irc.core::begins(entity_ref("urn:test:s15:t5#y"), @2018-01-01) { origin case_input; }
        assert "f2": us.irc.core::ends(entity_ref("urn:test:s15:t5#y"), @2018-12-31) { origin case_input; }
        assert "f3": rate_change_stated_beginning_on_or_after(entity_ref("urn:test:s15:t5#chg"), @2018-01-01) { origin case_input; }
    }
    // section 15(a): the year includes the effective date "unless that date is the first day of the taxable year"
    evaluate truth(rate_change_prorates_year(entity_ref("urn:test:s15:t5#y"), entity_ref("urn:test:s15:t5#chg")));
    expect truth_status == NEITHER;
}

