        }
        assert "f0": rate_change_source(entity_ref("urn:test:s15:t9#chg"), Ordinary) { origin case_input; }
        assert "f1": us.irc.core::begins(entity_ref("urn:test:s15:t9#y"), @2017-07-01) { origin case_input; }
        assert "f2": us.irc.core::ends(entity_ref("urn:test:s15:t9#y"), @2018-06-30) { origin case_input; }
        assert "f3": rate_change_stated_beginning_after(entity_ref("urn:test:s15:t9#chg"), @2018-06-30) { origin case_input; }
