// Final TECH_GAP pass (26.09.2026): section 1(f)(2)(C), G6707 — the indexed cumulative base tax of the TCJA tables.
// NOT EXECUTED (implemented_unverified). The index ratio is SYNTHETIC (5 percent), asserted as `cola_terms` (module 60), not BLS data;
// expectations are computed by hand from the pinned text.

language "law.core" version "0.2";
package us.irc.income_individual version "0.1.1";
namespace "urn:us:irc:income_individual:clir";


test "S71-01-JOINT-2020-ADJUSTED-LOWER-BOUND-OF-BRACKET-2" {
    // synthetic 5 percent adjustment: 19050 + floor(952.5/50)*50 = 20000.
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.core::calendar_year_of(entity_ref("urn:test:s71:1#y"), 2020) { origin case_input; }
        assert "f1": cola_terms(2017, 2019, 1050.0, 1000.0) { origin case_input; }
    }
    evaluate truth(tcja_bracket_lower_indexed(Joint, entity_ref("urn:test:s71:1#y"), 2, 20000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S71-02-JOINT-2020-CUMULATIVE-TAX-AT-BRACKET-7" {
    // bounds 20000, 81250, 173250, 330750, 420000, 630000: 2000 + 7350 + 20240 + 37800 + 28560 + 73500 = 169450.
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.core::calendar_year_of(entity_ref("urn:test:s71:2#y"), 2020) { origin case_input; }
        assert "f1": cola_terms(2017, 2019, 1050.0, 1000.0) { origin case_input; }
    }
    evaluate truth(tcja_indexed_base_tax(Joint, entity_ref("urn:test:s71:2#y"), 7, 169450 USD));
    expect truth_status == TRUE_ONLY;
}

test "S71-03-JOINT-2020-CUMULATIVE-TAX-AT-BRACKET-3" {
    // 2000 + 12 percent of (81250 - 20000) = 9350.
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.core::calendar_year_of(entity_ref("urn:test:s71:2b#y"), 2020) { origin case_input; }
        assert "f1": cola_terms(2017, 2019, 1050.0, 1000.0) { origin case_input; }
    }
    evaluate truth(tcja_indexed_base_tax(Joint, entity_ref("urn:test:s71:2b#y"), 3, 9350 USD));
    expect truth_status == TRUE_ONLY;
}

test "S71-04-JOINT-2020-TAX-AT-100000" {
    // bracket 3 (two bounds below 100000): 9350 + 22 percent of (100000 - 81250) = 13475.
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.core::calendar_year_of(entity_ref("urn:test:s71:4#y"), 2020) { origin case_input; }
        assert "f1": cola_terms(2017, 2019, 1050.0, 1000.0) { origin case_input; }
        assert "f2": filing_status(entity_ref("urn:test:s71:4#p"), entity_ref("urn:test:s71:4#y"), Joint) { origin case_input; }
        assert "f3": taxable_income(entity_ref("urn:test:s71:4#p"), entity_ref("urn:test:s71:4#y"), 100000 USD) { origin case_input; }
    }
    evaluate truth(tax_under_section_1_indexed_tcja(entity_ref("urn:test:s71:4#p"), entity_ref("urn:test:s71:4#y"), 13475 USD));
    expect truth_status == TRUE_ONLY;
}

test "S71-05-UNMARRIED-USES-A-25-DOLLAR-STEP" {
    // 9525 + floor(476.25/25)*25 = 10000 (unmarried individual, section 1(j)(3)(B)(ii)).
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.core::calendar_year_of(entity_ref("urn:test:s71:5#y"), 2020) { origin case_input; }
        assert "f1": cola_terms(2017, 2019, 1050.0, 1000.0) { origin case_input; }
    }
    evaluate truth(tcja_bracket_lower_indexed(Unmarried, entity_ref("urn:test:s71:5#y"), 2, 10000 USD));
    expect truth_status == TRUE_ONLY;
}

