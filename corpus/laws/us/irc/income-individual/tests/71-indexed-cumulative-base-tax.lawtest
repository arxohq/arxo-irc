test "S71-07-NO-ADJUSTMENT-OUTSIDE-THE-YEARS-OF-THE-PINNED-TEXT" {
    // 2026 is outside the bound (the text of section 1(j)(3)(B)(i) is amended): no adjusted bound.
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.core::calendar_year_of(entity_ref("urn:test:s71:7#y"), 2026) { origin case_input; }
        assert "f1": cola_terms(2017, 2025, 1050.0, 1000.0) { origin case_input; }
    }
    evaluate truth(tcja_bracket_lower_indexed(Joint, entity_ref("urn:test:s71:7#y"), 2, 20000 USD));
    expect truth_status == NEITHER;
}

test "S71-08-RESTATED-BOUNDS-AGREE-WITH-THE-TABLE-JOINT" {
    // the joint table at 19051: lower bound 19050, rate 12 percent, the restatement has bracket 2 at 19050.
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
    }
    evaluate truth(tcja_bracket_statutory(Joint, 2, 19050 USD, 0.12));
    expect truth_status == TRUE_ONLY;
}

test "S71-09-TABLE-JOINT-BRACKET-2" {
