test "S59-39-SECRETARY-TAX-BENEFIT-REGULATION-VALID-WHERE-TREATMENT-DOES-NOT-REDUCE-REGULAR-TAX" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": treatment_does_not_reduce_regular_tax(entity_ref("urn:test:s59:t39#matter")) { origin case_input; }
        assert "f1": secretary_prescribes_tax_benefit_regulations(entity_ref("urn:test:s59:t39#matter")) { origin case_input; }
    }
    // section 59(g): the Secretary MAY prescribe (a power, not a duty)
    evaluate truth(tax_benefit_adjustment_regulation_in_force(entity_ref("urn:test:s59:t39#matter")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S59-40-NO-TAX-BENEFIT-REGULATION-WITHOUT-THE-CONDITION" {
    given {
        context {
            legal_time @2025-12-31;
