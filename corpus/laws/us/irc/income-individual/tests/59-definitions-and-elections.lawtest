// Section 59 (definitions, elections, mandates) scenarios.
// NOT EXECUTED in this assignment (status implemented_unverified). Expectations are
// computed by hand from the pinned statutory text and Revenue Procedure figures, not
// from any engine output.

language "law.core" version "0.2";
package us.irc.income_individual version "0.1.1";
namespace "urn:us:irc:income_individual:clir";

test "S59-01-PRE-CREDIT-TENTATIVE-MINIMUM-TAX-IS-FIRST-SENTENCE-AMOUNT" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": filing_status(entity_ref("urn:test:s59:t1#p"), entity_ref("urn:test:s59:t1#y"), Unmarried) { origin case_input; }
        assert "f1": taxable_income(entity_ref("urn:test:s59:t1#p"), entity_ref("urn:test:s59:t1#y"), 300000 USD) { origin case_input; }
    }
    // section 59(a)(2)
    evaluate truth(pre_credit_tentative_minimum_tax(entity_ref("urn:test:s59:t1#p"), entity_ref("urn:test:s59:t1#y"), 55094 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S59-02-SIMPLIFIED-904-ELECTION-VALID-IN-FIRST-CLAIMING-YEAR" {
    given {
        context {
            legal_time @1998-12-31;
            decision_time @1998-12-31T09:00:00-05:00;
            knowledge_time @1998-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": claims_amt_foreign_tax_credit(entity_ref("urn:test:s59:t2#p"), entity_ref("urn:test:s59:t2#y")) { origin case_input; }
        assert "f1": us.irc.core::begins(entity_ref("urn:test:s59:t2#y"), @1998-01-01) { origin case_input; }
        assert "f2": no_earlier_year_after_1997_claiming_amt_foreign_tax_credit(entity_ref("urn:test:s59:t2#p"), entity_ref("urn:test:s59:t2#y")) { origin case_input; }
        assert "f3": taxpayer_elects_simplified_904(entity_ref("urn:test:s59:t2#p"), entity_ref("urn:test:s59:t2#y")) { origin case_input; }
    }
    // section 59(a)(3)(B)(i): first taxable year beginning after 1997 with a claimed credit
    evaluate truth(simplified_904_election_in_effect(entity_ref("urn:test:s59:t2#p"), entity_ref("urn:test:s59:t2#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S59-03-SIMPLIFIED-904-ELECTION-INVALID-WHEN-AN-EARLIER-YEAR-CLAIMED" {
    given {
        context {
            legal_time @1998-12-31;
            decision_time @1998-12-31T09:00:00-05:00;
            knowledge_time @1998-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": claims_amt_foreign_tax_credit(entity_ref("urn:test:s59:t3#p"), entity_ref("urn:test:s59:t3#y")) { origin case_input; }
        assert "f1": us.irc.core::begins(entity_ref("urn:test:s59:t3#y"), @1998-01-01) { origin case_input; }
        assert "f2": taxpayer_elects_simplified_904(entity_ref("urn:test:s59:t3#p"), entity_ref("urn:test:s59:t3#y")) { origin case_input; }
    }
    // no assertion that no earlier year claimed the credit: not the first claiming year -> POWER_INVALID_EXERCISE
    evaluate truth(simplified_904_election_in_effect(entity_ref("urn:test:s59:t3#p"), entity_ref("urn:test:s59:t3#y")));
    expect truth_status == NEITHER;
    expect issue(POWER_INVALID_EXERCISE);
}

