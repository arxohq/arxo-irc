// Section 3 tax-table scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.income_individual version "0.1.1";
namespace "urn:us:irc:income_individual:clir";

test "S3-01-NON-ITEMIZER-UNDER-CEILING-USES-TABLE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": itemizes_deductions_for_year(entity_ref("urn:test:s3:t1#p"), entity_ref("urn:test:s3:t1#y2024")) { origin case_input; polarity negative; }
        assert "f1": taxable_income(entity_ref("urn:test:s3:t1#p"), entity_ref("urn:test:s3:t1#y2024"), 15000 USD) { origin case_input; }
        assert "f2": ceiling_amount(entity_ref("urn:test:s3:t1#y2024"), 20000 USD) { origin case_input; }
        assert "f3": taxable_at_most(15000 USD, 20000 USD) { origin case_input; }
        assert "f4": table_tax_amount(entity_ref("urn:test:s3:t1#p"), entity_ref("urn:test:s3:t1#y2024"), 15000 USD) { origin case_input; }
    }
    evaluate truth(tax_under_section_1(entity_ref("urn:test:s3:t1#p"), entity_ref("urn:test:s3:t1#y2024"), 15000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S3-02-ESTATE-EXCLUDED-FROM-SECTION-3" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": filing_status(entity_ref("urn:test:s3:est1#p"), entity_ref("urn:test:s3:est1#y2024"), EstateOrTrust) { origin case_input; }
    }
    evaluate truth(table_tax_inapplicable(entity_ref("urn:test:s3:est1#p"), entity_ref("urn:test:s3:est1#y2024")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S3-03-ITEMIZER-NOT-DIRECTLY-COVERED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": itemizes_deductions_for_year(entity_ref("urn:test:s3:it1#p"), entity_ref("urn:test:s3:it1#y2024")) { origin case_input; }
        assert "f1": taxable_income(entity_ref("urn:test:s3:it1#p"), entity_ref("urn:test:s3:it1#y2024"), 15000 USD) { origin case_input; }
    }
    // §3(a)(1)(A) requires a non-itemizer; §3(a)(3)'s discretionary extension
    // to itemizers is not modelled (Secretary's power, no valid_when facts
    // asserted here), so the table tax is UNDETERMINED, not FALSE.
    evaluate truth(tax_under_section_1_via_table(entity_ref("urn:test:s3:it1#p"), entity_ref("urn:test:s3:it1#y2024"), 15000 USD));
    expect truth_status == NEITHER;
}
