test "S58-04-INSOLVENCY-AMOUNT-IS-EXCESS-OF-LIABILITIES-OVER-FAIR-MARKET-VALUE" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": filing_status(entity_ref("urn:test:s58:t4#p"), entity_ref("urn:test:s58:t4#y"), Unmarried) { origin case_input; }
        assert "f1": is_farming_syndicate_461k(entity_ref("urn:test:s58:t4#farm")) { origin case_input; }
        assert "f2": farm_activity_loss(entity_ref("urn:test:s58:t4#p"), entity_ref("urn:test:s58:t4#y"), entity_ref("urn:test:s58:t4#farm"), 50000 USD) { origin case_input; }
        assert "f3": farm_loss_carried_in(entity_ref("urn:test:s58:t4#p"), entity_ref("urn:test:s58:t4#y"), entity_ref("urn:test:s58:t4#farm"), 0 USD) { origin case_input; }
        assert "f4": taxpayer_liabilities(entity_ref("urn:test:s58:t4#p"), entity_ref("urn:test:s58:t4#y"), 100000 USD) { origin case_input; }
        assert "f5": fair_market_value_of_assets(entity_ref("urn:test:s58:t4#p"), entity_ref("urn:test:s58:t4#y"), 80000 USD) { origin case_input; }
    }
    // section 58(c)(1)(B)
    evaluate truth(insolvency_amount(entity_ref("urn:test:s58:t4#p"), entity_ref("urn:test:s58:t4#y"), 20000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

