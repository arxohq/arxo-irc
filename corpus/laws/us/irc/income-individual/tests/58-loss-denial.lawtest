// Section 58 denial of certain losses scenarios.
// NOT EXECUTED in this assignment (status implemented_unverified). Expectations are
// computed by hand from the pinned statutory text and Revenue Procedure figures, not
// from any engine output.

language "law.core" version "0.2";
package us.irc.income_individual version "0.1.1";
namespace "urn:us:irc:income_individual:clir";

test "S58-01-FARMING-SYNDICATE-IS-TAX-SHELTER-FARM-ACTIVITY" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": is_farming_syndicate_461k(entity_ref("urn:test:s58:t1#farm")) { origin case_input; }
    }
    // section 58(a)(2)(A)
    evaluate truth(tax_shelter_farm_activity(entity_ref("urn:test:s58:t1#farm")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

