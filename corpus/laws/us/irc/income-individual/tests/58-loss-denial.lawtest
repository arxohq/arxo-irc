test "S58-15-UNKNOWN-SOLVENCY-NO-DISALLOWED-AMOUNT" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": filing_status(entity_ref("urn:test:s58:t15#p"), entity_ref("urn:test:s58:t15#y"), Unmarried) { origin case_input; }
        assert "f1": is_farming_syndicate_461k(entity_ref("urn:test:s58:t15#farm")) { origin case_input; }
        assert "f2": farm_activity_loss(entity_ref("urn:test:s58:t15#p"), entity_ref("urn:test:s58:t15#y"), entity_ref("urn:test:s58:t15#farm"), 5000 USD) { origin case_input; }
        assert "f3": farm_loss_carried_in(entity_ref("urn:test:s58:t15#p"), entity_ref("urn:test:s58:t15#y"), entity_ref("urn:test:s58:t15#farm"), 0 USD) { origin case_input; }
    }
    // unknown key fact: liabilities and asset value not asserted -> NEITHER, not zero insolvency
    evaluate truth(disallowed_farm_loss(entity_ref("urn:test:s58:t15#p"), entity_ref("urn:test:s58:t15#y"), 5000 USD));
    expect truth_status == NEITHER;
}

