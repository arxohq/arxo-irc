        assert "f4": deductions_allocable_to_properties(entity_ref("urn:test:s57:t6#p"), entity_ref("urn:test:s57:t6#y"), OilAndGas, 350000 USD) { origin case_input; }
    }
    // section 57(a)(2)(B): 400000 - 100000
    evaluate truth(excess_intangible_drilling_costs(entity_ref("urn:test:s57:t6#p"), entity_ref("urn:test:s57:t6#y"), OilAndGas, 300000 USD));
    expect truth_status == TRUE_ONLY;
