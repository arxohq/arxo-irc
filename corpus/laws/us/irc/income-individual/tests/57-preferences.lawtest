        }
        assert "f0": filing_status(entity_ref("urn:test:s57:t33#p"), entity_ref("urn:test:s57:t33#y"), Unmarried) { origin case_input; }
        assert "f1": section_1202_excluded_amount(entity_ref("urn:test:s57:t33#p"), entity_ref("urn:test:s57:t33#y"), entity_ref("urn:test:s57:t33#stock0"), 200000 USD) { origin case_input; }
        assert "f2": stock_acquisition_date(entity_ref("urn:test:s57:t33#stock0"), @2010-09-27) { origin case_input; }
    }
    // boundary: "on or before"
    evaluate truth(amt_preference(entity_ref("urn:test:s57:t33#p"), entity_ref("urn:test:s57:t33#y"), SmallBusinessStock57a7, 14000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S57-34-ONLY-THE-PRE-ACT-STOCK-EXCLUSION-IS-A-PREFERENCE" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": filing_status(entity_ref("urn:test:s57:t34#p"), entity_ref("urn:test:s57:t34#y"), Unmarried) { origin case_input; }
        assert "f1": section_1202_excluded_amount(entity_ref("urn:test:s57:t34#p"), entity_ref("urn:test:s57:t34#y"), entity_ref("urn:test:s57:t34#stock0"), 200000 USD) { origin case_input; }
        assert "f2": stock_acquisition_date(entity_ref("urn:test:s57:t34#stock0"), @2009-05-01) { origin case_input; }
        assert "f3": section_1202_excluded_amount(entity_ref("urn:test:s57:t34#p"), entity_ref("urn:test:s57:t34#y"), entity_ref("urn:test:s57:t34#stock1"), 100000 USD) { origin case_input; }
        assert "f4": stock_acquisition_date(entity_ref("urn:test:s57:t34#stock1"), @2011-02-01) { origin case_input; }
    }
    // 7% * 200000 only; the 2011 stock adds nothing
    evaluate truth(amt_preference(entity_ref("urn:test:s57:t34#p"), entity_ref("urn:test:s57:t34#y"), SmallBusinessStock57a7, 14000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

