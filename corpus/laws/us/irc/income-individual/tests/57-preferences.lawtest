test "S57-14-CATEGORIES-COMPUTED-SEPARATELY-AND-SUMMED" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": filing_status(entity_ref("urn:test:s57:t14#p"), entity_ref("urn:test:s57:t14#y"), Unmarried) { origin case_input; }
        assert "f1": idc_allowed_regular_tax(entity_ref("urn:test:s57:t14#p"), entity_ref("urn:test:s57:t14#y"), OilAndGas, 400000 USD) { origin case_input; }
        assert "f2": idc_if_capitalized_straight_line(entity_ref("urn:test:s57:t14#p"), entity_ref("urn:test:s57:t14#y"), OilAndGas, 100000 USD) { origin case_input; }
        assert "f3": gross_income_from_properties(entity_ref("urn:test:s57:t14#p"), entity_ref("urn:test:s57:t14#y"), OilAndGas, 500000 USD) { origin case_input; }
        assert "f4": deductions_allocable_to_properties(entity_ref("urn:test:s57:t14#p"), entity_ref("urn:test:s57:t14#y"), OilAndGas, 350000 USD) { origin case_input; }
        assert "f5": integrated_oil_company(entity_ref("urn:test:s57:t14#p"), entity_ref("urn:test:s57:t14#y")) { origin case_input; }
        assert "f6": idc_allowed_regular_tax(entity_ref("urn:test:s57:t14#p"), entity_ref("urn:test:s57:t14#y"), Geothermal, 200000 USD) { origin case_input; }
        assert "f7": idc_if_capitalized_straight_line(entity_ref("urn:test:s57:t14#p"), entity_ref("urn:test:s57:t14#y"), Geothermal, 50000 USD) { origin case_input; }
        assert "f8": gross_income_from_properties(entity_ref("urn:test:s57:t14#p"), entity_ref("urn:test:s57:t14#y"), Geothermal, 300000 USD) { origin case_input; }
