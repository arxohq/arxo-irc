// Section 57 items of tax preference scenarios.
// NOT EXECUTED in this assignment (status implemented_unverified). Expectations are
// computed by hand from the pinned statutory text and Revenue Procedure figures, not
// from any engine output.

language "law.core" version "0.2";
package us.irc.income_individual version "0.1.1";
namespace "urn:us:irc:income_individual:clir";

test "S57-01-DEPLETION-IN-EXCESS-OF-ADJUSTED-BASIS-IS-PREFERENCE" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": filing_status(entity_ref("urn:test:s57:t1#p"), entity_ref("urn:test:s57:t1#y"), Unmarried) { origin case_input; }
        assert "f1": depletion_deduction_allowed(entity_ref("urn:test:s57:t1#p"), entity_ref("urn:test:s57:t1#y"), entity_ref("urn:test:s57:t1#prop"), 50000 USD) { origin case_input; }
        assert "f2": adjusted_basis_at_year_end_before_depletion(entity_ref("urn:test:s57:t1#p"), entity_ref("urn:test:s57:t1#y"), entity_ref("urn:test:s57:t1#prop"), 20000 USD) { origin case_input; }
    }
    // section 57(a)(1)
    evaluate truth(depletion_preference_of_property(entity_ref("urn:test:s57:t1#p"), entity_ref("urn:test:s57:t1#y"), entity_ref("urn:test:s57:t1#prop"), 30000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

