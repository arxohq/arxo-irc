            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
    }
    // section 1(i)(4): no time fixed
    evaluate positions();
    expect position(Section1iTablesDuty, ACTIVE);
}

test "S64-29-SECRETARY-ADJUST-TABLES-DUTY-SATISFIED" {
    given {
        context {
            legal_time @2010-12-31;
            decision_time @2010-12-31T09:00:00-05:00;
            knowledge_time @2010-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": secretary_has_prescribed_rules(entity_ref("urn:us:irc:income_individual:clir#Mandate1i4")) { origin case_input; }
    }
    evaluate positions();
    expect position(Section1iTablesDuty, SATISFIED);
}

