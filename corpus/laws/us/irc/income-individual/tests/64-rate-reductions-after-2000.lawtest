test "S64-03-INITIAL-BRACKET-AMOUNT-AS-ENACTED-IN-2003" {
    given {
        context {
            legal_time @2003-12-31;
            decision_time @2003-12-31T09:00:00-05:00;
            knowledge_time @2003-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.core::calendar_year_of(entity_ref("urn:test:s64#y"), 2003) { origin case_input; }
    }
    // the adjustment applies to taxable years beginning after 2003
    evaluate truth(initial_bracket_amount(Joint, entity_ref("urn:test:s64#y"), 14000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

