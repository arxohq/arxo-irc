        assert "f39": c_cpi_u_window_month(2009, 4, 100.0) { origin case_input; }
        assert "f40": c_cpi_u_window_month(2009, 5, 100.0) { origin case_input; }
        assert "f41": c_cpi_u_window_month(2009, 6, 100.0) { origin case_input; }
        assert "f42": c_cpi_u_window_month(2009, 7, 100.0) { origin case_input; }
