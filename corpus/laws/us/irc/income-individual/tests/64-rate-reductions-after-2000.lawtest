// Section 1(i): rate reductions after 2000 (stage 3).
// NOT EXECUTED in this assignment (status implemented_unverified). Expectations are
// computed by hand from the pinned statutory text, not from any engine output.
// Index values (C-CPI-U, CPI) in scenarios are SYNTHETIC round numbers chosen for hand
// arithmetic; they are not Bureau of Labor Statistics data.

language "law.core" version "0.2";
package us.irc.income_individual version "0.1.1";
namespace "urn:us:irc:income_individual:clir";

test "S64-01-INITIAL-BRACKET-AMOUNT-BASE-JOINT" {
    given {
        context {
            legal_time @2005-12-31;
            decision_time @2005-12-31T09:00:00-05:00;
            knowledge_time @2005-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
    }
    // section 1(i)(1)(B)(i)
    evaluate truth(initial_bracket_amount_base(Joint, 14000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S64-02-INITIAL-BRACKET-AMOUNT-BASE-HEAD-OF-HOUSEHOLD" {
