// Income individual WIRE-10 group D scenarios. NOT EXECUTED (implemented_unverified); no legal review.

language "law.core" version "0.2";
package us.irc.income_individual version "0.1.1";
namespace "urn:us:irc:income_individual:clir";

test "W10-D-II-01-HIGHEST-RATE-OF-SECTION-1-IS-37-PERCENT-FOR-2024" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.core::begins(entity_ref("urn:test:w10dii:h1#y"), @2024-01-01) { origin case_input; }
    }
    evaluate truth(highest_rate_under_section_1(entity_ref("urn:test:w10dii:h1#y"), 0.37));
    expect truth_status == TRUE_ONLY;
}

test "W10-D-II-02-NO-HIGHEST-RATE-IS-STATED-FOR-A-YEAR-BEFORE-2018" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.core::begins(entity_ref("urn:test:w10dii:h2#y"), @2017-01-01) { origin case_input; }
    }
    evaluate truth(highest_rate_under_section_1(entity_ref("urn:test:w10dii:h2#y"), 0.37));
    expect truth_status == FALSE_ONLY;
}

test "W10-D-II-03-JOINT-37-PERCENT-BOUND-INDEXED-FROM-2017-FOR-2026" {
    given {
        context {
            legal_time @2026-12-31;
            decision_time @2026-12-31T09:00:00-05:00;
            knowledge_time @2026-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.core::calendar_year_of(entity_ref("urn:test:w10dii:i1#y"), 2026) { origin case_input; }
        assert "f1": cola_terms(2017, 2025, 1200.0, 1000.0) { origin case_input; }
    }
    evaluate truth(tcja_bracket_lower_indexed(Joint, entity_ref("urn:test:w10dii:i1#y"), 7, 720000 USD));
    expect truth_status == TRUE_ONLY;
}

test "W10-D-II-04-UNMARRIED-37-PERCENT-BOUND-INDEXED-WITH-STEP-25-FOR-2026" {
    given {
        context {
            legal_time @2026-12-31;
            decision_time @2026-12-31T09:00:00-05:00;
            knowledge_time @2026-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.core::calendar_year_of(entity_ref("urn:test:w10dii:i2#y"), 2026) { origin case_input; }
        assert "f1": cola_terms(2017, 2025, 1200.0, 1000.0) { origin case_input; }
    }
    evaluate truth(tcja_bracket_lower_indexed(Unmarried, entity_ref("urn:test:w10dii:i2#y"), 7, 600000 USD));
    expect truth_status == TRUE_ONLY;
}

test "W10-D-II-05-BRACKET-2-BOUND-IS-NOT-REQUESTED-FOR-2026" {
    given {
        context {
            legal_time @2026-12-31;
            decision_time @2026-12-31T09:00:00-05:00;
            knowledge_time @2026-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.core::calendar_year_of(entity_ref("urn:test:w10dii:i3#y"), 2026) { origin case_input; }
        assert "f1": cola_terms(2017, 2025, 1050.0, 1000.0) { origin case_input; }
    }
    evaluate truth(tcja_bracket_lower_indexed(Joint, entity_ref("urn:test:w10dii:i3#y"), 2, 20000 USD));
    expect truth_status == FALSE_ONLY;
}
