            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": foreign_corporation_flag(entity_ref("urn:test:s66#foreign")) { origin case_input; }
        assert "f1": us_trade_or_business_of_foreign_corporation(entity_ref("urn:test:s66#usbranch"), entity_ref("urn:test:s66#foreign")) { origin case_input; }
        assert "f2": foreign_corporation_flag(entity_ref("urn:test:s66#fo2")) { origin case_input; }
        assert "f3": entities_in_same_applicable_financial_statement(entity_ref("urn:test:s66#usbranch"), entity_ref("urn:test:s66#fo2"), entity_ref("urn:test:s66#y")) { origin case_input; }
        assert "f4": treated_as_having_foreign_common_parent(entity_ref("urn:test:s66#usbranch"), entity_ref("urn:test:s66#fo2"), entity_ref("urn:test:s66#y")) { origin case_input; }
    }
    // the branch is domestic by section 59(k)(2)(C)
    evaluate truth(foreign_parented_multinational_member(entity_ref("urn:test:s66#usbranch"), entity_ref("urn:test:s66#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

