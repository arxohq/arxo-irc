test "S57B-08-ELECTION-INVALID-WHEN-METHOD-NOT-PERMITTED-FOR-COST-DEPLETION" {
    given {
        context {
            legal_time @2021-12-31;
            decision_time @2021-12-31T09:00:00-05:00;
            knowledge_time @2021-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": well_of_taxpayer(entity_ref("urn:test:s66#well"), entity_ref("urn:test:s66#corp")) { origin case_input; }
        assert "f1": well_drilling_category(entity_ref("urn:test:s66#well"), OilAndGas) { origin case_input; }
        assert "f2": well_idc_capitalized(entity_ref("urn:test:s66#well"), 1200000 USD) { origin case_input; }
        assert "f3": production_begins_in_month(entity_ref("urn:test:s66#well"), 2020, 7) { origin case_input; }
        assert "f4": taxpayer_elects_57b2(entity_ref("urn:test:s66#well")) { origin case_input; }
    }
    // the selected method is not one permitted for cost depletion: no effect
    evaluate truth(election_57b2_in_effect(entity_ref("urn:test:s66#well")));
    expect truth_status == NEITHER;
    expect issue(POWER_INVALID_EXERCISE);
}

