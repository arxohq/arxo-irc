// Section 1(j)(5): maximum zero rate and 15-percent rate amounts (stage 3).
// NOT EXECUTED in this assignment (status implemented_unverified). Expectations are
// computed by hand from the pinned statutory text, not from any engine output.
// Index values (C-CPI-U, CPI) in scenarios are SYNTHETIC round numbers chosen for hand
// arithmetic; they are not Bureau of Labor Statistics data.

language "law.core" version "0.2";
package us.irc.income_individual version "0.1.1";
namespace "urn:us:irc:income_individual:clir";

test "S61-01-JOINT-2025-MAXIMUM-ZERO-RATE-AMOUNT" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": filing_status(entity_ref("urn:test:s61#p"), entity_ref("urn:test:s61#y"), Joint) { origin case_input; }
    }
    // Rev. Proc. 2024-40 section 2.03
    evaluate truth(max_zero_rate_amount(entity_ref("urn:test:s61#p"), entity_ref("urn:test:s61#y"), 96700 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

