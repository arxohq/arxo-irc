test "S61-10-TAXABLE-INCOME-SUBSTITUTION-NOT-BEFORE-2018" {
    given {
        context {
            legal_time @2017-12-31;
            decision_time @2017-12-31T09:00:00-05:00;
            knowledge_time @2017-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": filing_status(entity_ref("urn:test:s61#p"), entity_ref("urn:test:s61#y"), Unmarried) { origin case_input; }
        assert "f1": taxable_income(entity_ref("urn:test:s61#p"), entity_ref("urn:test:s61#y"), 40000 USD) { origin case_input; }
    }
    // before the taxable years to which section 1(j) applies
    evaluate truth(taxable_income_taxed_below_25_percent(entity_ref("urn:test:s61#p"), entity_ref("urn:test:s61#y"), 40000 USD));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

test "S61-11-STATUTORY-INDEXING-ZERO-RATE-JOINT-2025" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": c_cpi_u_window_month(2017, 1, 105.0) { origin case_input; }
        assert "f1": c_cpi_u_window_month(2017, 2, 105.0) { origin case_input; }
        assert "f2": c_cpi_u_window_month(2017, 3, 105.0) { origin case_input; }
        assert "f3": c_cpi_u_window_month(2017, 4, 105.0) { origin case_input; }
        assert "f4": c_cpi_u_window_month(2017, 5, 105.0) { origin case_input; }
        assert "f5": c_cpi_u_window_month(2017, 6, 105.0) { origin case_input; }
        assert "f6": c_cpi_u_window_month(2017, 7, 105.0) { origin case_input; }
        assert "f7": c_cpi_u_window_month(2017, 8, 105.0) { origin case_input; }
        assert "f8": c_cpi_u_window_month(2017, 9, 105.0) { origin case_input; }
        assert "f9": c_cpi_u_window_month(2017, 10, 105.0) { origin case_input; }
        assert "f10": c_cpi_u_window_month(2017, 11, 105.0) { origin case_input; }
        assert "f11": c_cpi_u_window_month(2017, 12, 105.0) { origin case_input; }
        assert "f12": c_cpi_u_window_month(2024, 1, 126.0) { origin case_input; }
        assert "f13": c_cpi_u_window_month(2024, 2, 126.0) { origin case_input; }
        assert "f14": c_cpi_u_window_month(2024, 3, 126.0) { origin case_input; }
        assert "f15": c_cpi_u_window_month(2024, 4, 126.0) { origin case_input; }
        assert "f16": c_cpi_u_window_month(2024, 5, 126.0) { origin case_input; }
        assert "f17": c_cpi_u_window_month(2024, 6, 126.0) { origin case_input; }
        assert "f18": c_cpi_u_window_month(2024, 7, 126.0) { origin case_input; }
        assert "f19": c_cpi_u_window_month(2024, 8, 126.0) { origin case_input; }
        assert "f20": c_cpi_u_window_month(2024, 9, 126.0) { origin case_input; }
        assert "f21": c_cpi_u_window_month(2024, 10, 126.0) { origin case_input; }
        assert "f22": c_cpi_u_window_month(2024, 11, 126.0) { origin case_input; }
        assert "f23": c_cpi_u_window_month(2024, 12, 126.0) { origin case_input; }
        assert "f24": us.irc.core::calendar_year_of(entity_ref("urn:test:s61#y"), 2025) { origin case_input; }
    }
    // 77200 x 0.2 = 15440 rounded down to 15400: 92600 (synthetic index; the published 96700 is a separate parameter row)
    evaluate truth(section_1j5_indexed_amount(ZeroRateJoint, entity_ref("urn:test:s61#y"), 92600 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S61-12-NO-INDEXING-REQUEST-FOR-2018" {
    given {
        context {
            legal_time @2018-12-31;
            decision_time @2018-12-31T09:00:00-05:00;
            knowledge_time @2018-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": c_cpi_u_window_month(2017, 1, 105.0) { origin case_input; }
        assert "f1": c_cpi_u_window_month(2017, 2, 105.0) { origin case_input; }
        assert "f2": c_cpi_u_window_month(2017, 3, 105.0) { origin case_input; }
        assert "f3": c_cpi_u_window_month(2017, 4, 105.0) { origin case_input; }
        assert "f4": c_cpi_u_window_month(2017, 5, 105.0) { origin case_input; }
        assert "f5": c_cpi_u_window_month(2017, 6, 105.0) { origin case_input; }
        assert "f6": c_cpi_u_window_month(2017, 7, 105.0) { origin case_input; }
        assert "f7": c_cpi_u_window_month(2017, 8, 105.0) { origin case_input; }
        assert "f8": c_cpi_u_window_month(2017, 9, 105.0) { origin case_input; }
        assert "f9": c_cpi_u_window_month(2017, 10, 105.0) { origin case_input; }
        assert "f10": c_cpi_u_window_month(2017, 11, 105.0) { origin case_input; }
        assert "f11": c_cpi_u_window_month(2017, 12, 105.0) { origin case_input; }
        assert "f12": c_cpi_u_window_month(2024, 1, 126.0) { origin case_input; }
        assert "f13": c_cpi_u_window_month(2024, 2, 126.0) { origin case_input; }
        assert "f14": c_cpi_u_window_month(2024, 3, 126.0) { origin case_input; }
        assert "f15": c_cpi_u_window_month(2024, 4, 126.0) { origin case_input; }
        assert "f16": c_cpi_u_window_month(2024, 5, 126.0) { origin case_input; }
        assert "f17": c_cpi_u_window_month(2024, 6, 126.0) { origin case_input; }
        assert "f18": c_cpi_u_window_month(2024, 7, 126.0) { origin case_input; }
        assert "f19": c_cpi_u_window_month(2024, 8, 126.0) { origin case_input; }
        assert "f20": c_cpi_u_window_month(2024, 9, 126.0) { origin case_input; }
        assert "f21": c_cpi_u_window_month(2024, 10, 126.0) { origin case_input; }
        assert "f22": c_cpi_u_window_month(2024, 11, 126.0) { origin case_input; }
        assert "f23": c_cpi_u_window_month(2024, 12, 126.0) { origin case_input; }
        assert "f24": us.irc.core::calendar_year_of(entity_ref("urn:test:s61#y"), 2018) { origin case_input; }
    }
    // the increase applies to taxable years beginning after 2018
    evaluate truth(section_1j5_indexed_amount(ZeroRateJoint, entity_ref("urn:test:s61#y"), 77200 USD));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

