test "S61-06-YEAR-BETWEEN-PINNED-ROWS-IS-MISSING-PARAMETER" {
    given {
        context {
            legal_time @2022-12-31;
            decision_time @2022-12-31T09:00:00-05:00;
            knowledge_time @2022-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": filing_status(entity_ref("urn:test:s61#p"), entity_ref("urn:test:s61#y"), Joint) { origin case_input; }
    }
    // no Revenue Procedure is pinned for 2022: no invented indexed figure
    evaluate truth(max_zero_rate_amount(entity_ref("urn:test:s61#p"), entity_ref("urn:test:s61#y"), 83350 USD));
    expect truth_status == NEITHER;
    expect issue(MISSING_PARAMETER_VALUE);
}

test "S61-07-TAXABLE-INCOME-BELOW-MAXIMUM-ZERO-RATE-AMOUNT-WHEN-INCOME-IS-LOWER" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": filing_status(entity_ref("urn:test:s61#p"), entity_ref("urn:test:s61#y"), Unmarried) { origin case_input; }
        assert "f1": taxable_income(entity_ref("urn:test:s61#p"), entity_ref("urn:test:s61#y"), 40000 USD) { origin case_input; }
    }
    // section 1(j)(5)(A)(i): min(40000, 48350)
    evaluate truth(taxable_income_taxed_below_25_percent(entity_ref("urn:test:s61#p"), entity_ref("urn:test:s61#y"), 40000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

