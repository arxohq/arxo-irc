// Section 56(a)(1)-(3), (5), (6) and (b)(2): depreciation, amortization, long-term contracts, adjusted basis (stage 3).
// NOT EXECUTED in this assignment (status implemented_unverified). Expectations are
// computed by hand from the pinned statutory text, not from any engine output.
// Index values (C-CPI-U, CPI) in scenarios are SYNTHETIC round numbers chosen for hand
// arithmetic; they are not Bureau of Labor Statistics data.

language "law.core" version "0.2";
package us.irc.income_individual version "0.1.1";
namespace "urn:us:irc:income_individual:clir";

test "S65-01-PLACED-IN-1995-ALTERNATIVE-DEPRECIATION-SYSTEM" {
    given {
        context {
            legal_time @2000-12-31;
            decision_time @2000-12-31T09:00:00-05:00;
            knowledge_time @2000-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": property_placed_in_service_on(entity_ref("urn:test:s65#prop"), @1995-06-01) { origin case_input; }
    }
    // section 56(a)(1)(A)(i)
    evaluate truth(amt_depreciation_method(entity_ref("urn:test:s65#prop"), AlternativeDepreciationSystem168g));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

