        assert "f1": contract_entered_in_taxable_year_beginning_on(entity_ref("urn:test:s65#contract"), @1990-01-01) { origin case_input; }
    }
    // section 56(a)(3), before Pub. L. 119-21
    evaluate truth(percentage_of_completion_required_for_amt(entity_ref("urn:test:s65#contract")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

