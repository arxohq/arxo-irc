test "S65-18-ADJUSTED-BASIS-REDUCED-BY-EARLIER-YEARS-ONLY" {
    given {
        context {
            legal_time @2012-12-31;
            decision_time @2012-12-31T09:00:00-05:00;
            knowledge_time @2012-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": property_of_taxpayer(entity_ref("urn:test:s65#prop"), entity_ref("urn:test:s65#p")) { origin case_input; }
        assert "f1": basis_before_depreciation(entity_ref("urn:test:s65#prop"), 100000 USD) { origin case_input; }
        assert "f2": us.irc.core::begins(entity_ref("urn:test:s65#y2010"), @2010-01-01) { origin case_input; }
        assert "f3": us.irc.core::begins(entity_ref("urn:test:s65#y2011"), @2011-01-01) { origin case_input; }
        assert "f4": us.irc.core::begins(entity_ref("urn:test:s65#y2012"), @2012-01-01) { origin case_input; }
        assert "f5": amt_method_depreciation_deduction(entity_ref("urn:test:s65#p"), entity_ref("urn:test:s65#y2010"), entity_ref("urn:test:s65#prop"), 10000 USD) { origin case_input; }
        assert "f6": amt_method_depreciation_deduction(entity_ref("urn:test:s65#p"), entity_ref("urn:test:s65#y2011"), entity_ref("urn:test:s65#prop"), 8000 USD) { origin case_input; }
        assert "f7": amt_method_depreciation_deduction(entity_ref("urn:test:s65#p"), entity_ref("urn:test:s65#y2012"), entity_ref("urn:test:s65#prop"), 6000 USD) { origin case_input; }
    }
    // 100000 - 10000 - 8000; the deduction of the year itself is not yet taken
    evaluate truth(amt_adjusted_basis(entity_ref("urn:test:s65#p"), entity_ref("urn:test:s65#y2012"), entity_ref("urn:test:s65#prop"), 82000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

