test "S65-33-LOSS-DEDUCTION-IS-THE-LESSER-165A-AMOUNT" {
    given {
        context {
            legal_time @2023-12-31;
            decision_time @2023-12-31T09:00:00-05:00;
            knowledge_time @2023-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": amortized_expenditure_of(entity_ref("urn:test:s65#exp"), entity_ref("urn:test:s65#p")) { origin case_input; }
        assert "f1": amortized_expenditure_kind(entity_ref("urn:test:s65#exp"), MiningExploration) { origin case_input; }
        assert "f2": amortized_expenditure_amount(entity_ref("urn:test:s65#exp"), 100000 USD) { origin case_input; }
        assert "f3": expenditure_made_in_year(entity_ref("urn:test:s65#exp"), entity_ref("urn:test:s65#y2020")) { origin case_input; }
        assert "f4": expenditure_paid_after_1986(entity_ref("urn:test:s65#exp")) { origin case_input; }
        assert "f5": us.irc.core::calendar_year_of(entity_ref("urn:test:s65#y2020"), 2020) { origin case_input; }
        assert "f6": us.irc.core::calendar_year_of(entity_ref("urn:test:s65#y2023"), 2023) { origin case_input; }
        assert "f7": us.irc.core::begins(entity_ref("urn:test:s65#y2023"), @2023-01-01) { origin case_input; }
        assert "f8": filing_status(entity_ref("urn:test:s65#p"), entity_ref("urn:test:s65#y2023"), Unmarried) { origin case_input; }
        assert "f9": loss_sustained_in_year(entity_ref("urn:test:s65#exp"), entity_ref("urn:test:s65#y2023")) { origin case_input; }
        assert "f10": section_165a_amount_if_capitalized(entity_ref("urn:test:s65#exp"), entity_ref("urn:test:s65#y2023"), 50000 USD) { origin case_input; }
    }
    // unamortized 100000 x (10 - 3)/10 = 70000; the section 165(a) amount 50000 is the lesser
    evaluate truth(amt_loss_deduction_of_expenditure(entity_ref("urn:test:s65#p"), entity_ref("urn:test:s65#y2023"), entity_ref("urn:test:s65#exp"), 50000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

