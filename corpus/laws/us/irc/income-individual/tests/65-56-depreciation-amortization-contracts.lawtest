test "S65-13-DEPRECIATION-ADJUSTMENT-IS-REGULAR-LESS-ALTERNATIVE" {
    given {
        context {
            legal_time @2000-12-31;
            decision_time @2000-12-31T09:00:00-05:00;
            knowledge_time @2000-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": property_of_taxpayer(entity_ref("urn:test:s65#prop"), entity_ref("urn:test:s65#p")) { origin case_input; }
        assert "f1": property_placed_in_service_on(entity_ref("urn:test:s65#prop"), @1995-06-01) { origin case_input; }
        assert "f2": regular_depreciation_deduction(entity_ref("urn:test:s65#p"), entity_ref("urn:test:s65#y"), entity_ref("urn:test:s65#prop"), 10000 USD) { origin case_input; }
        assert "f3": amt_method_depreciation_deduction(entity_ref("urn:test:s65#p"), entity_ref("urn:test:s65#y"), entity_ref("urn:test:s65#prop"), 7000 USD) { origin case_input; }
    }
    // regular deduction 10000, alternative 7000: income increases by 3000
    evaluate truth(amt_adjustment(entity_ref("urn:test:s65#p"), entity_ref("urn:test:s65#y"), DepreciationByProperty56a1, 3000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

