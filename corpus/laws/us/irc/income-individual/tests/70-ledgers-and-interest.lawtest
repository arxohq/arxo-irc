// Stage 4b (26.09.2026): the unrolled ledgers of module 69 (FSNOL, section 59(l)(2), ATNOL, farm loss) and the interest recomputation. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.income_individual version "0.1.1";
namespace "urn:us:irc:income_individual:clir";

test "S70-FSNOL-01" {
    given {
        context {
            legal_time @2027-12-31;
            decision_time @2027-12-31T09:00:00-05:00;
            knowledge_time @2027-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": fsnol_chain_year_56Ad(entity_ref("urn:test:s70#c01"), 1, entity_ref("urn:test:s70#y011")) { origin case_input; }
        assert "f1": fsnol_chain_year_56Ad(entity_ref("urn:test:s70#c01"), 2, entity_ref("urn:test:s70#y012")) { origin case_input; }
        assert "f2": fsnol_chain_year_56Ad(entity_ref("urn:test:s70#c01"), 3, entity_ref("urn:test:s70#y013")) { origin case_input; }
        assert "f3": financial_statement_nol_carryovers(entity_ref("urn:test:s70#c01"), entity_ref("urn:test:s70#y011"), 100000000 USD) { origin case_input; }
        assert "f4": afsi_before_nol_deduction(entity_ref("urn:test:s70#c01"), entity_ref("urn:test:s70#y011"), 60000000 USD) { origin case_input; }
        assert "f5": afsi_before_nol_deduction(entity_ref("urn:test:s70#c01"), entity_ref("urn:test:s70#y012"), 60000000 USD) { origin case_input; }
        assert "f6": afsi_before_nol_deduction(entity_ref("urn:test:s70#c01"), entity_ref("urn:test:s70#y013"), 200000000 USD) { origin case_input; }
    }
    // carryover 100M; year 1: min(100M, 80% of 60M = 48M) = 48M applied; year 2: opening 52M, applied 48M; AFSI 60M - 48M = 12M
    evaluate truth(adjusted_financial_statement_income(entity_ref("urn:test:s70#c01"), entity_ref("urn:test:s70#y012"), 12000000 USD));
    expect truth_status == TRUE_ONLY;
}

