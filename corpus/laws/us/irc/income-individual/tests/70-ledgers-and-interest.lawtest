test "S70-ATNOL-08" {
    given {
        context {
            legal_time @2027-12-31;
            decision_time @2027-12-31T09:00:00-05:00;
            knowledge_time @2027-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": atnol_chain_loss_year(entity_ref("urn:test:s70#p08"), 1, entity_ref("urn:test:s70#l081")) { origin case_input; }
        assert "f1": atnol_chain_loss_year(entity_ref("urn:test:s70#p08"), 2, entity_ref("urn:test:s70#l082")) { origin case_input; }
        assert "f2": atnol_chain_deduction_year(entity_ref("urn:test:s70#p08"), 1, entity_ref("urn:test:s70#d081")) { origin case_input; }
        assert "f3": atnol_chain_deduction_year(entity_ref("urn:test:s70#p08"), 2, entity_ref("urn:test:s70#d082")) { origin case_input; }
        assert "f4": loss_year_begins_on(entity_ref("urn:test:s70#l081"), @2020-01-01) { origin case_input; }
        assert "f5": loss_year_begins_on(entity_ref("urn:test:s70#l082"), @2021-01-01) { origin case_input; }
        assert "f6": us.irc.core::begins(entity_ref("urn:test:s70#d081"), @2022-01-01) { origin case_input; }
        assert "f7": us.irc.core::begins(entity_ref("urn:test:s70#d082"), @2023-01-01) { origin case_input; }
        assert "f8": atnol_carryover_of_loss_year(entity_ref("urn:test:s70#p08"), entity_ref("urn:test:s70#l081"), 100000 USD) { origin case_input; }
        assert "f9": atnol_carryover_of_loss_year(entity_ref("urn:test:s70#p08"), entity_ref("urn:test:s70#l082"), 50000 USD) { origin case_input; }
        assert "f10": amti_before_atnol_and_section_199(entity_ref("urn:test:s70#p08"), entity_ref("urn:test:s70#d081"), 100000 USD) { origin case_input; }
        assert "f11": amti_before_atnol_and_section_199(entity_ref("urn:test:s70#p08"), entity_ref("urn:test:s70#d082"), 200000 USD) { origin case_input; }
        assert "f12": filing_status(entity_ref("urn:test:s70#p08"), entity_ref("urn:test:s70#d081"), Unmarried) { origin case_input; }
        assert "f13": filing_status(entity_ref("urn:test:s70#p08"), entity_ref("urn:test:s70#d082"), Unmarried) { origin case_input; }
    }
    // deduction year 1: cap 90 percent of 100000 = 90000, absorbed by the oldest loss (100000): 90000
    evaluate truth(atnol_deduction(entity_ref("urn:test:s70#p08"), entity_ref("urn:test:s70#d081"), 90000 USD));
    expect truth_status == TRUE_ONLY;
}

