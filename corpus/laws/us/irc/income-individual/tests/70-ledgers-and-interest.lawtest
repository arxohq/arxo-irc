        assert "f4": cfc_foreign_taxes_pro_rata_share(entity_ref("urn:test:s70#c05"), entity_ref("urn:test:s70#y051"), 100000000 USD) { origin case_input; }
        assert "f5": section_56a_c3_adjustment(entity_ref("urn:test:s70#c05"), entity_ref("urn:test:s70#y051"), 400000000 USD) { origin case_input; }
        assert "f6": own_foreign_taxes_on_financial_statement(entity_ref("urn:test:s70#c05"), entity_ref("urn:test:s70#y051"), 0 USD) { origin case_input; }
        assert "f7": applicable_corporation(entity_ref("urn:test:s70#c05"), entity_ref("urn:test:s70#y052")) { origin case_input; }
        assert "f8": corporation_chooses_foreign_tax_credit_benefits(entity_ref("urn:test:s70#c05"), entity_ref("urn:test:s70#y052")) { origin case_input; }
        assert "f9": cfc_foreign_taxes_pro_rata_share(entity_ref("urn:test:s70#c05"), entity_ref("urn:test:s70#y052"), 10000000 USD) { origin case_input; }
        assert "f10": section_56a_c3_adjustment(entity_ref("urn:test:s70#c05"), entity_ref("urn:test:s70#y052"), 400000000 USD) { origin case_input; }
        assert "f11": own_foreign_taxes_on_financial_statement(entity_ref("urn:test:s70#c05"), entity_ref("urn:test:s70#y052"), 0 USD) { origin case_input; }
    }
    // year 1: min(100M, 15% of 400M = 60M) = 60M; excess 40M
    evaluate truth(corporate_amt_foreign_tax_credit(entity_ref("urn:test:s70#c05"), entity_ref("urn:test:s70#y051"), 60000000 USD));
    expect truth_status == TRUE_ONLY;
}

