    }
    // year 2 does not repeat the year 1 amount
    evaluate truth(atnol_deduction(entity_ref("urn:test:s70#p10"), entity_ref("urn:test:s70#d102"), 90000 USD));
    expect truth_status == FALSE_ONLY;
}

test "S70-FARM-11" {
    given {
        context {
            legal_time @2027-12-31;
            decision_time @2027-12-31T09:00:00-05:00;
            knowledge_time @2027-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": farm_chain_year_58a1B(entity_ref("urn:test:s70#p11"), 1, entity_ref("urn:test:s70#y111")) { origin case_input; }
        assert "f1": farm_chain_year_58a1B(entity_ref("urn:test:s70#p11"), 2, entity_ref("urn:test:s70#y112")) { origin case_input; }
        assert "f2": is_farming_syndicate_461k(entity_ref("urn:test:s70#farm11")) { origin case_input; }
        assert "f3": filing_status(entity_ref("urn:test:s70#p11"), entity_ref("urn:test:s70#y111"), Unmarried) { origin case_input; }
        assert "f4": farm_activity_loss(entity_ref("urn:test:s70#p11"), entity_ref("urn:test:s70#y111"), entity_ref("urn:test:s70#farm11"), 100000 USD) { origin case_input; }
        assert "f5": taxpayer_liabilities(entity_ref("urn:test:s70#p11"), entity_ref("urn:test:s70#y111"), 0 USD) { origin case_input; }
        assert "f6": fair_market_value_of_assets(entity_ref("urn:test:s70#p11"), entity_ref("urn:test:s70#y111"), 500000 USD) { origin case_input; }
        assert "f7": filing_status(entity_ref("urn:test:s70#p11"), entity_ref("urn:test:s70#y112"), Unmarried) { origin case_input; }
        assert "f8": farm_activity_loss(entity_ref("urn:test:s70#p11"), entity_ref("urn:test:s70#y112"), entity_ref("urn:test:s70#farm11"), 30000 USD) { origin case_input; }
        assert "f9": taxpayer_liabilities(entity_ref("urn:test:s70#p11"), entity_ref("urn:test:s70#y112"), 0 USD) { origin case_input; }
        assert "f10": fair_market_value_of_assets(entity_ref("urn:test:s70#p11"), entity_ref("urn:test:s70#y112"), 500000 USD) { origin case_input; }
    }
    // year 1 disallows 100000; it is a deduction of year 2, which adds its own 30000: 130000 subject to the denial, solvent taxpayer
    evaluate truth(disallowed_farm_loss(entity_ref("urn:test:s70#p11"), entity_ref("urn:test:s70#y112"), 130000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S70-FARM-12" {
    given {
        context {
            legal_time @2027-12-31;
            decision_time @2027-12-31T09:00:00-05:00;
            knowledge_time @2027-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": farm_chain_year_58a1B(entity_ref("urn:test:s70#p12"), 1, entity_ref("urn:test:s70#y121")) { origin case_input; }
        assert "f1": farm_chain_year_58a1B(entity_ref("urn:test:s70#p12"), 2, entity_ref("urn:test:s70#y122")) { origin case_input; }
        assert "f2": is_farming_syndicate_461k(entity_ref("urn:test:s70#farm12")) { origin case_input; }
        assert "f3": filing_status(entity_ref("urn:test:s70#p12"), entity_ref("urn:test:s70#y121"), Unmarried) { origin case_input; }
        assert "f4": farm_activity_loss(entity_ref("urn:test:s70#p12"), entity_ref("urn:test:s70#y121"), entity_ref("urn:test:s70#farm12"), 100000 USD) { origin case_input; }
        assert "f5": taxpayer_liabilities(entity_ref("urn:test:s70#p12"), entity_ref("urn:test:s70#y121"), 0 USD) { origin case_input; }
        assert "f6": fair_market_value_of_assets(entity_ref("urn:test:s70#p12"), entity_ref("urn:test:s70#y121"), 500000 USD) { origin case_input; }
        assert "f7": filing_status(entity_ref("urn:test:s70#p12"), entity_ref("urn:test:s70#y122"), Unmarried) { origin case_input; }
        assert "f8": farm_activity_loss(entity_ref("urn:test:s70#p12"), entity_ref("urn:test:s70#y122"), entity_ref("urn:test:s70#farm12"), 30000 USD) { origin case_input; }
        assert "f9": taxpayer_liabilities(entity_ref("urn:test:s70#p12"), entity_ref("urn:test:s70#y122"), 0 USD) { origin case_input; }
        assert "f10": fair_market_value_of_assets(entity_ref("urn:test:s70#p12"), entity_ref("urn:test:s70#y122"), 500000 USD) { origin case_input; }
    }
    // without the carried deduction the second year would disallow 30000; the chain carries 100000
    evaluate truth(disallowed_farm_loss(entity_ref("urn:test:s70#p12"), entity_ref("urn:test:s70#y122"), 30000 USD));
    expect truth_status == FALSE_ONLY;
}

test "S70-INT-13-AMT-INVESTMENT-INTEREST-LIMIT" {
    given {
        context {
            legal_time @2027-12-31;
            decision_time @2027-12-31T09:00:00-05:00;
            knowledge_time @2027-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": filing_status(entity_ref("urn:test:s70#p13"), entity_ref("urn:test:s70#y13"), Unmarried) { origin case_input; }
        assert "f1": regular_investment_interest_deduction(entity_ref("urn:test:s70#p13"), entity_ref("urn:test:s70#y13"), 20000 USD) { origin case_input; }
        assert "f2": regular_qualified_residence_interest_deduction(entity_ref("urn:test:s70#p13"), entity_ref("urn:test:s70#y13"), 0 USD) { origin case_input; }
        assert "f3": net_investment_income_regular(entity_ref("urn:test:s70#p13"), entity_ref("urn:test:s70#y13"), 20000 USD) { origin case_input; }
        assert "f4": net_investment_income_amt_adjustments(entity_ref("urn:test:s70#p13"), entity_ref("urn:test:s70#y13"), 6000 USD) { origin case_input; }
        assert "f5": pab_interest_includible_for_163d(entity_ref("urn:test:s70#p13"), entity_ref("urn:test:s70#y13"), 0 USD) { origin case_input; }
        assert "f6": pab_related_deduction_for_163d(entity_ref("urn:test:s70#p13"), entity_ref("urn:test:s70#y13"), 0 USD) { origin case_input; }
        assert "f7": debt_interest_is_investment_interest_163d(entity_ref("urn:test:s70#debt13"), entity_ref("urn:test:s70#p13"), entity_ref("urn:test:s70#y13")) { origin case_input; }
        assert "f8": investment_interest_paid_for_amt(entity_ref("urn:test:s70#debt13"), entity_ref("urn:test:s70#p13"), entity_ref("urn:test:s70#y13"), 30000 USD) { origin case_input; }
    }
    // investment interest 30000, adjusted net investment income 26000: allowed 26000
    evaluate truth(investment_interest_allowed_for_amt(entity_ref("urn:test:s70#p13"), entity_ref("urn:test:s70#y13"), 26000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S70-INT-14-ADJUSTMENT-IS-REGULAR-LESS-AMT" {
    given {
        context {
            legal_time @2027-12-31;
            decision_time @2027-12-31T09:00:00-05:00;
            knowledge_time @2027-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": filing_status(entity_ref("urn:test:s70#p13"), entity_ref("urn:test:s70#y13"), Unmarried) { origin case_input; }
        assert "f1": regular_investment_interest_deduction(entity_ref("urn:test:s70#p13"), entity_ref("urn:test:s70#y13"), 20000 USD) { origin case_input; }
        assert "f2": regular_qualified_residence_interest_deduction(entity_ref("urn:test:s70#p13"), entity_ref("urn:test:s70#y13"), 0 USD) { origin case_input; }
        assert "f3": net_investment_income_regular(entity_ref("urn:test:s70#p13"), entity_ref("urn:test:s70#y13"), 20000 USD) { origin case_input; }
        assert "f4": net_investment_income_amt_adjustments(entity_ref("urn:test:s70#p13"), entity_ref("urn:test:s70#y13"), 6000 USD) { origin case_input; }
        assert "f5": pab_interest_includible_for_163d(entity_ref("urn:test:s70#p13"), entity_ref("urn:test:s70#y13"), 0 USD) { origin case_input; }
        assert "f6": pab_related_deduction_for_163d(entity_ref("urn:test:s70#p13"), entity_ref("urn:test:s70#y13"), 0 USD) { origin case_input; }
        assert "f7": debt_interest_is_investment_interest_163d(entity_ref("urn:test:s70#debt13"), entity_ref("urn:test:s70#p13"), entity_ref("urn:test:s70#y13")) { origin case_input; }
        assert "f8": investment_interest_paid_for_amt(entity_ref("urn:test:s70#debt13"), entity_ref("urn:test:s70#p13"), entity_ref("urn:test:s70#y13"), 30000 USD) { origin case_input; }
    }
    // regular 20000, amt allowed 26000: the adjustment lowers the amt income by 6000
    evaluate truth(amt_adjustment(entity_ref("urn:test:s70#p13"), entity_ref("urn:test:s70#y13"), Interest56b1B, -6000 USD));
    expect truth_status == TRUE_ONLY;
}

