// Section 1(h) capital-gains scenarios (subparagraphs (A) and (D) only —
// see `capital-gains.law` header for the TECH_GAP on (B)/(C)/(E)/(F)).
// NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.income_individual version "0.1.1";
namespace "urn:us:irc:income_individual:clir";

test "S1H-01-ORDINARY-LAYER-FROM-REDUCED-INCOME" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": taxable_income(entity_ref("urn:test:s1h:c1#p"), entity_ref("urn:test:s1h:c1#y2024"), 100000 USD) { origin case_input; }
        assert "f1": net_capital_gain(entity_ref("urn:test:s1h:c1#p"), entity_ref("urn:test:s1h:c1#y2024"), 20000 USD) { origin case_input; }
        assert "f2": tax_on_hypothetical_reduced_income(entity_ref("urn:test:s1h:c1#p"), entity_ref("urn:test:s1h:c1#y2024"), 80000 USD, 9000 USD) { origin case_input; }
    }
    evaluate truth(capital_gains_ordinary_layer(entity_ref("urn:test:s1h:c1#p"), entity_ref("urn:test:s1h:c1#y2024"), 9000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1H-02-TOP-RATE-LAYER-ABOVE-FLOOR" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": adjusted_net_capital_gain(entity_ref("urn:test:s1h:c2#p"), entity_ref("urn:test:s1h:c2#y2024"), 50000 USD) { origin case_input; }
        assert "f1": zero_percent_and_fifteen_percent_layers_sum(entity_ref("urn:test:s1h:c2#p"), entity_ref("urn:test:s1h:c2#y2024"), 30000 USD) { origin case_input; }
        assert "f2": gain_exceeds_floor(50000 USD, 30000 USD) { origin case_input; }
    }
    // 20% * (50000 - 30000) = 4000
    evaluate truth(capital_gains_20_percent_tax(entity_ref("urn:test:s1h:c2#p"), entity_ref("urn:test:s1h:c2#y2024"), 4000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1H-03-UNKNOWN-NET-CAPITAL-GAIN-UNDETERMINED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": taxable_income(entity_ref("urn:test:s1h:c3#p"), entity_ref("urn:test:s1h:c3#y2024"), 100000 USD) { origin case_input; }
    }
    evaluate truth(capital_gains_ordinary_layer(entity_ref("urn:test:s1h:c3#p"), entity_ref("urn:test:s1h:c3#y2024"), 0 USD));
    expect truth_status == NEITHER;
}
