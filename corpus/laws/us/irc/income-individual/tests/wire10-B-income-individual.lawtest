            knowledge_time @2010-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.core::begins(entity_ref("urn:test:w10b:r2#y"), @2010-01-01) { origin case_input; }
    }
    evaluate truth(section_1c_third_lowest_rate(entity_ref("urn:test:w10b:r2#y"), 0.31));
    expect truth_status == TRUE_ONLY;
}

test "W10B-II-04-FOURTH-LOWEST-1C-RATE-BEFORE-2018" {
    given {
        context {
            legal_time @2010-12-31;
            decision_time @2010-12-31T09:00:00-05:00;
            knowledge_time @2010-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.core::begins(entity_ref("urn:test:w10b:r2#y"), @2010-01-01) { origin case_input; }
    }
    evaluate truth(section_1c_fourth_lowest_rate(entity_ref("urn:test:w10b:r2#y"), 0.36));
    expect truth_status == TRUE_ONLY;
}
