// Income-individual WIRE-10 group B scenarios (section 1(c) third and fourth lowest rates). NOT EXECUTED (implemented_unverified); no legal review.

language "law.core" version "0.2";
package us.irc.income_individual version "0.1.1";
namespace "urn:us:irc:income_individual:clir";

test "W10B-II-01-THIRD-LOWEST-1C-RATE-TCJA-YEAR" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.core::begins(entity_ref("urn:test:w10b:r1#y"), @2024-01-01) { origin case_input; }
    }
    evaluate truth(section_1c_third_lowest_rate(entity_ref("urn:test:w10b:r1#y"), 0.22));
    expect truth_status == TRUE_ONLY;
}

test "W10B-II-02-FOURTH-LOWEST-1C-RATE-TCJA-YEAR" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.core::begins(entity_ref("urn:test:w10b:r1#y"), @2024-01-01) { origin case_input; }
    }
    evaluate truth(section_1c_fourth_lowest_rate(entity_ref("urn:test:w10b:r1#y"), 0.24));
    expect truth_status == TRUE_ONLY;
}

test "W10B-II-03-THIRD-LOWEST-1C-RATE-BEFORE-2018" {
    given {
        context {
            legal_time @2010-12-31;
