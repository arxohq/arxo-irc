// Corporate alternative minimum tax (sections 55(b)(2), 56A(d), 59(k), 59(l)) scenarios.
// NOT EXECUTED in this assignment (status implemented_unverified). Expectations are
// computed by hand from the pinned statutory text and Revenue Procedure figures, not
// from any engine output.

language "law.core" version "0.2";
package us.irc.income_individual version "0.1.1";
namespace "urn:us:irc:income_individual:clir";

test "CAMT-01-THREE-YEAR-AVERAGE-AFSI" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.core::begins(entity_ref("urn:test:camt:t1#y23"), @2023-01-01) { origin case_input; }
        assert "f1": us.irc.core::ends(entity_ref("urn:test:camt:t1#y23"), @2023-12-31) { origin case_input; }
        assert "f2": us.irc.core::begins(entity_ref("urn:test:camt:t1#y24"), @2024-01-01) { origin case_input; }
        assert "f3": us.irc.core::ends(entity_ref("urn:test:camt:t1#y24"), @2024-12-31) { origin case_input; }
        assert "f4": afsi_window_three_years(entity_ref("urn:test:camt:t1#c"), entity_ref("urn:test:camt:t1#y23"), 1500000000 USD, 1200000000 USD, 900000000 USD) { origin case_input; }
    }
    // section 59(k)(1)(B)(i): (1.5B+1.2B+0.9B)/3 = 1.2B
    evaluate truth(average_annual_afsi(entity_ref("urn:test:camt:t1#c"), entity_ref("urn:test:camt:t1#y23"), 1200000000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

