// Section 2 filing-status scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.income_individual version "0.1.1";
namespace "urn:us:irc:income_individual:clir";

test "S2-01-SURVIVING-SPOUSE-QUALIFIES" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": spouse_died_in_year(entity_ref("urn:test:s2:ss1#p"), entity_ref("urn:test:s2:ss1#y2024")) { origin case_input; }
        assert "f1": dependent_of(entity_ref("urn:test:s2:ss1#child"), entity_ref("urn:test:s2:ss1#p"), entity_ref("urn:test:s2:ss1#y2024")) { origin case_input; }
        assert "f2": maintains_household_for(entity_ref("urn:test:s2:ss1#p"), entity_ref("urn:test:s2:ss1#child"), entity_ref("urn:test:s2:ss1#y2024")) { origin case_input; }
    }
    evaluate truth(surviving_spouse(entity_ref("urn:test:s2:ss1#p"), entity_ref("urn:test:s2:ss1#y2024")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S2-02-SURVIVING-SPOUSE-REMARRIED-EXCLUDED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": spouse_died_in_year(entity_ref("urn:test:s2:ss2#p"), entity_ref("urn:test:s2:ss2#y2024")) { origin case_input; }
        assert "f1": dependent_of(entity_ref("urn:test:s2:ss2#child"), entity_ref("urn:test:s2:ss2#p"), entity_ref("urn:test:s2:ss2#y2024")) { origin case_input; }
        assert "f2": maintains_household_for(entity_ref("urn:test:s2:ss2#p"), entity_ref("urn:test:s2:ss2#child"), entity_ref("urn:test:s2:ss2#y2024")) { origin case_input; }
        assert "f3": remarried_before_close_of_year(entity_ref("urn:test:s2:ss2#p"), entity_ref("urn:test:s2:ss2#y2024")) { origin case_input; }
    }
    // §2(a)(2)(A): remarriage before the close of the year bars surviving-spouse status.
    evaluate truth(surviving_spouse(entity_ref("urn:test:s2:ss2#p"), entity_ref("urn:test:s2:ss2#y2024")));
    expect truth_status == FALSE_ONLY;
    expect evaluation_status == COMPUTED;
}

