// The Individual view of the AMT relations (bridge to us.irc.credits) (stage 3).
// NOT EXECUTED in this assignment (status implemented_unverified). Expectations are
// computed by hand from the pinned statutory text, not from any engine output.
// Index values (C-CPI-U, CPI) in scenarios are SYNTHETIC round numbers chosen for hand
// arithmetic; they are not Bureau of Labor Statistics data.

language "law.core" version "0.2";
package us.irc.income_individual version "0.1.1";
namespace "urn:us:irc:income_individual:clir";

test "S68-01-TENTATIVE-MINIMUM-TAX-READ-FOR-AN-INDIVIDUAL" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": filing_status(entity_ref("urn:test:s68#i"), entity_ref("urn:test:s68#y"), Unmarried) { origin case_input; }
        assert "f1": taxable_income(entity_ref("urn:test:s68#i"), entity_ref("urn:test:s68#y"), 300000 USD) { origin case_input; }
    }
    // the same figure as S55-01 (tentative_minimum_tax of the Person)
    evaluate truth(tentative_minimum_tax_of_individual(entity_ref("urn:test:s68#i"), entity_ref("urn:test:s68#y"), 55094 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S68-02-TENTATIVE-MINIMUM-TAX-ADAPTER-FOLLOWS-THE-PERSON-FIGURE" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": tentative_minimum_tax(entity_ref("urn:test:s68#i"), entity_ref("urn:test:s68#y"), 41000 USD) { origin case_input; }
    }
    // the adapter only narrows the type
    evaluate truth(tentative_minimum_tax_of_individual(entity_ref("urn:test:s68#i"), entity_ref("urn:test:s68#y"), 41000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S68-03-ADAPTER-DOES-NOT-INVENT-A-DIFFERENT-AMOUNT" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": tentative_minimum_tax(entity_ref("urn:test:s68#i"), entity_ref("urn:test:s68#y"), 41000 USD) { origin case_input; }
    }
    // a different amount is not established
    evaluate truth(tentative_minimum_tax_of_individual(entity_ref("urn:test:s68#i"), entity_ref("urn:test:s68#y"), 42000 USD));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

