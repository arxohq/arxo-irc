test "S56-19-DEBT-INCURRED-ON-JULY-1-1982-IS-NOT-BEFORE" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": is_qualified_residence_interest(entity_ref("urn:test:s56:t19#debt"), entity_ref("urn:test:s56:t19#y")) { origin case_input; }
        assert "f1": indebtedness_incurred_on(entity_ref("urn:test:s56:t19#debt"), @1982-07-01) { origin case_input; }
        assert "f2": secured_by_principal_residence_or_family_qualified_dwelling(entity_ref("urn:test:s56:t19#debt"), entity_ref("urn:test:s56:t19#p")) { origin case_input; }
    }
    // boundary: "before July 1, 1982" is strict
    evaluate truth(qualified_housing_interest_on(entity_ref("urn:test:s56:t19#debt"), entity_ref("urn:test:s56:t19#p"), entity_ref("urn:test:s56:t19#y")));
    expect truth_status == NEITHER;
}

test "S56-20-REFINANCING-COUNTS-ONLY-UP-TO-REFINANCED-AMOUNT" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": is_qualified_residence_interest(entity_ref("urn:test:s56:t20#old"), entity_ref("urn:test:s56:t20#y")) { origin case_input; }
        assert "f1": indebtedness_incurred_for_property(entity_ref("urn:test:s56:t20#old"), entity_ref("urn:test:s56:t20#home")) { origin case_input; }
        assert "f2": property_is_principal_residence(entity_ref("urn:test:s56:t20#home"), entity_ref("urn:test:s56:t20#p"), entity_ref("urn:test:s56:t20#y")) { origin case_input; }
        assert "f3": refinancing_of(entity_ref("urn:test:s56:t20#new"), entity_ref("urn:test:s56:t20#old")) { origin case_input; }
        assert "f4": indebtedness_amount(entity_ref("urn:test:s56:t20#new"), 300000 USD) { origin case_input; }
        assert "f5": refinanced_indebtedness_amount_immediately_before(entity_ref("urn:test:s56:t20#new"), 250000 USD) { origin case_input; }
    }
    // section 56(e)(1), last sentence
    evaluate truth(refinancing_interest_qualified_amount(entity_ref("urn:test:s56:t20#new"), entity_ref("urn:test:s56:t20#p"), entity_ref("urn:test:s56:t20#y"), 250000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

