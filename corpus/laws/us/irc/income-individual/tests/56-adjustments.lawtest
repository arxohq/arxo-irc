test "S56-22-NORMALIZATION-METHOD-DUTY-ACTIVE-UNTIL-PRESCRIBED" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
    }
    // section 56(a)(1)(D): the Secretary shall prescribe the requirements; no time is fixed, so the duty stands open
    evaluate positions();
    expect position(NormalizationMethodRequirementsDuty, ACTIVE);
}

