        assert "f1": atnol_attributable_to_ordinary_losses(entity_ref("urn:test:s56:t9#p"), entity_ref("urn:test:s56:t9#y"), 200000 USD) { origin case_input; }
        assert "f2": atnol_attributable_to_elected_applicable_loss(entity_ref("urn:test:s56:t9#p"), entity_ref("urn:test:s56:t9#y"), 0 USD) { origin case_input; }
        assert "f3": amti_before_atnol_and_section_199(entity_ref("urn:test:s56:t9#p"), entity_ref("urn:test:s56:t9#y"), 150000 USD) { origin case_input; }
    }
    // section 56(d)(1)(A)(i): min(200000, 90% * 150000)
