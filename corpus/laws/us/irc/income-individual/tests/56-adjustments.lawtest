// Section 56 adjustments (and section 56(e) qualified housing interest) scenarios.
// NOT EXECUTED in this assignment (status implemented_unverified). Expectations are
// computed by hand from the pinned statutory text and Revenue Procedure figures, not
// from any engine output.

language "law.core" version "0.2";
package us.irc.income_individual version "0.1.1";
namespace "urn:us:irc:income_individual:clir";

test "S56-01-MISCELLANEOUS-ITEMIZED-DEDUCTIONS-ADDED-BACK" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": filing_status(entity_ref("urn:test:s56:t1#p"), entity_ref("urn:test:s56:t1#y"), Unmarried) { origin case_input; }
        assert "f1": misc_itemized_deductions_claimed(entity_ref("urn:test:s56:t1#p"), entity_ref("urn:test:s56:t1#y"), 10000 USD) { origin case_input; }
    }
    // section 56(b)(1)(A)(i)
    evaluate truth(amt_adjustment(entity_ref("urn:test:s56:t1#p"), entity_ref("urn:test:s56:t1#y"), MiscItemizedDeductions56b1Ai, 10000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

