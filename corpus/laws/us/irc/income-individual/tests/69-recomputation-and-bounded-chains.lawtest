test "S69-HYP-06-TCJA-YEAR" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": filing_status(entity_ref("urn:test:s69#p06"), entity_ref("urn:test:s69#y06"), Unmarried) { origin case_input; }
        assert "f1": us.irc.core::begins(entity_ref("urn:test:s69#y06"), @2024-01-01) { origin case_input; }
        assert "f2": hypothetical_income_request_1(entity_ref("urn:test:s69#p06"), entity_ref("urn:test:s69#y06"), 50000.00 USD) { origin case_input; }
    }
    // the year begins in 2024: the TCJA table
    evaluate truth(hypothetical_tax_1(entity_ref("urn:test:s69#p06"), entity_ref("urn:test:s69#y06"), 50000.00 USD, 6939.50 USD));
    expect truth_status == TRUE_ONLY;
}

test "S69-HYP-07-1993-YEAR-NOT-TCJA" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": filing_status(entity_ref("urn:test:s69#p07"), entity_ref("urn:test:s69#y07"), Unmarried) { origin case_input; }
        assert "f1": us.irc.core::begins(entity_ref("urn:test:s69#y07"), @2016-01-01) { origin case_input; }
        assert "f2": hypothetical_income_request_1(entity_ref("urn:test:s69#p07"), entity_ref("urn:test:s69#y07"), 50000.00 USD) { origin case_input; }
    }
    // the year begins before 2018: the 1993 table answers, not the TCJA table
    evaluate truth(hypothetical_tax_1(entity_ref("urn:test:s69#p07"), entity_ref("urn:test:s69#y07"), 50000.00 USD, 6939.50 USD));
    expect truth_status == FALSE_ONLY;
}

test "S69-CFC-08" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": cfc_chain_year_56Ac3(entity_ref("urn:test:s69#corp08"), 1, entity_ref("urn:test:s69#y081")) { origin case_input; }
        assert "f1": cfc_chain_year_56Ac3(entity_ref("urn:test:s69#corp08"), 2, entity_ref("urn:test:s69#y082")) { origin case_input; }
        assert "f2": cfc_chain_year_56Ac3(entity_ref("urn:test:s69#corp08"), 3, entity_ref("urn:test:s69#y083")) { origin case_input; }
        assert "f3": united_states_shareholder_of_cfc(entity_ref("urn:test:s69#corp08"), entity_ref("urn:test:s69#y081"), entity_ref("urn:test:s69#cfc08")) { origin case_input; }
        assert "f4": cfc_pro_rata_share_of_items(entity_ref("urn:test:s69#corp08"), entity_ref("urn:test:s69#y081"), entity_ref("urn:test:s69#cfc08"), -1000.00 USD) { origin case_input; }
        assert "f5": united_states_shareholder_of_cfc(entity_ref("urn:test:s69#corp08"), entity_ref("urn:test:s69#y082"), entity_ref("urn:test:s69#cfc08")) { origin case_input; }
        assert "f6": cfc_pro_rata_share_of_items(entity_ref("urn:test:s69#corp08"), entity_ref("urn:test:s69#y082"), entity_ref("urn:test:s69#cfc08"), 400.00 USD) { origin case_input; }
        assert "f7": united_states_shareholder_of_cfc(entity_ref("urn:test:s69#corp08"), entity_ref("urn:test:s69#y083"), entity_ref("urn:test:s69#cfc08")) { origin case_input; }
        assert "f8": cfc_pro_rata_share_of_items(entity_ref("urn:test:s69#corp08"), entity_ref("urn:test:s69#y083"), entity_ref("urn:test:s69#cfc08"), 900.00 USD) { origin case_input; }
    }
    // step 1 is negative 1000; step 2 = 400 - 1000 = -600; step 3 = 900 - 600 = 300
    evaluate truth(cfc_adjustment_determined(entity_ref("urn:test:s69#corp08"), entity_ref("urn:test:s69#y083"), 300.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S69-CFC-09" {
    given {
        context {
            legal_time @2024-12-31;
