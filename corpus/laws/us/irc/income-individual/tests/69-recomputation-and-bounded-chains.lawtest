// Stage 4 (26.09.2026): module 69 (recomputation of section 1 at another income; bounded chains). NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.income_individual version "0.1.1";
namespace "urn:us:irc:income_individual:clir";

test "S69-TAX-01" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": filing_status(entity_ref("urn:test:s69#p01"), entity_ref("urn:test:s69#y01"), Unmarried) { origin case_input; }
        assert "f1": requested_income_tcja(entity_ref("urn:test:s69#p01"), entity_ref("urn:test:s69#y01"), 50000.00 USD) { origin case_input; }
    }
    // TCJA unmarried: 4453.50 + 22 percent of (50000 - 38700)
    evaluate truth(tax_at_income_tcja_table(entity_ref("urn:test:s69#p01"), entity_ref("urn:test:s69#y01"), 50000.00 USD, 6939.50 USD));
    expect truth_status == TRUE_ONLY;
}

test "S69-TAX-03" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": filing_status(entity_ref("urn:test:s69#p03"), entity_ref("urn:test:s69#y03"), Unmarried) { origin case_input; }
        assert "f1": requested_income_tcja(entity_ref("urn:test:s69#p03"), entity_ref("urn:test:s69#y03"), 50000.00 USD) { origin case_input; }
    }
    // a wrong amount is not derived
    evaluate truth(tax_at_income_tcja_table(entity_ref("urn:test:s69#p03"), entity_ref("urn:test:s69#y03"), 50000.00 USD, 1.00 USD));
    expect truth_status == FALSE_ONLY;
}

