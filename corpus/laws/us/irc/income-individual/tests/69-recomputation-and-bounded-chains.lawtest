        }
        assert "f0": cfc_chain_year_56Ac3(entity_ref("urn:test:s69#corp09"), 1, entity_ref("urn:test:s69#y091")) { origin case_input; }
        assert "f1": cfc_chain_year_56Ac3(entity_ref("urn:test:s69#corp09"), 2, entity_ref("urn:test:s69#y092")) { origin case_input; }
        assert "f2": cfc_chain_year_56Ac3(entity_ref("urn:test:s69#corp09"), 3, entity_ref("urn:test:s69#y093")) { origin case_input; }
        assert "f3": united_states_shareholder_of_cfc(entity_ref("urn:test:s69#corp09"), entity_ref("urn:test:s69#y091"), entity_ref("urn:test:s69#cfc09")) { origin case_input; }
        assert "f4": cfc_pro_rata_share_of_items(entity_ref("urn:test:s69#corp09"), entity_ref("urn:test:s69#y091"), entity_ref("urn:test:s69#cfc09"), -1000.00 USD) { origin case_input; }
        assert "f5": united_states_shareholder_of_cfc(entity_ref("urn:test:s69#corp09"), entity_ref("urn:test:s69#y092"), entity_ref("urn:test:s69#cfc09")) { origin case_input; }
        assert "f6": cfc_pro_rata_share_of_items(entity_ref("urn:test:s69#corp09"), entity_ref("urn:test:s69#y092"), entity_ref("urn:test:s69#cfc09"), 400.00 USD) { origin case_input; }
        assert "f7": united_states_shareholder_of_cfc(entity_ref("urn:test:s69#corp09"), entity_ref("urn:test:s69#y093"), entity_ref("urn:test:s69#cfc09")) { origin case_input; }
        assert "f8": cfc_pro_rata_share_of_items(entity_ref("urn:test:s69#corp09"), entity_ref("urn:test:s69#y093"), entity_ref("urn:test:s69#cfc09"), 900.00 USD) { origin case_input; }
    }
    // step 2 = 400 - 1000 = -600
    evaluate truth(cfc_adjustment_determined(entity_ref("urn:test:s69#corp09"), entity_ref("urn:test:s69#y092"), -600.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S69-CFC-10" {
    given {
        context {
            legal_time @2024-12-31;
