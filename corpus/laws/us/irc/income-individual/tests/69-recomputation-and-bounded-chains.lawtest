        }
        assert "f0": cfc_chain_year_56Ac3(entity_ref("urn:test:s69#corp10"), 1, entity_ref("urn:test:s69#y101")) { origin case_input; }
        assert "f1": cfc_chain_year_56Ac3(entity_ref("urn:test:s69#corp10"), 2, entity_ref("urn:test:s69#y102")) { origin case_input; }
        assert "f2": cfc_chain_year_56Ac3(entity_ref("urn:test:s69#corp10"), 3, entity_ref("urn:test:s69#y103")) { origin case_input; }
        assert "f3": united_states_shareholder_of_cfc(entity_ref("urn:test:s69#corp10"), entity_ref("urn:test:s69#y101"), entity_ref("urn:test:s69#cfc10")) { origin case_input; }
        assert "f4": cfc_pro_rata_share_of_items(entity_ref("urn:test:s69#corp10"), entity_ref("urn:test:s69#y101"), entity_ref("urn:test:s69#cfc10"), 500.00 USD) { origin case_input; }
        assert "f5": united_states_shareholder_of_cfc(entity_ref("urn:test:s69#corp10"), entity_ref("urn:test:s69#y102"), entity_ref("urn:test:s69#cfc10")) { origin case_input; }
        assert "f6": cfc_pro_rata_share_of_items(entity_ref("urn:test:s69#corp10"), entity_ref("urn:test:s69#y102"), entity_ref("urn:test:s69#cfc10"), 400.00 USD) { origin case_input; }
