test "S69-PARENT-11-TAX-AFTER-CHILD-INCLUSION" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": taxable_income(entity_ref("urn:test:s69#par"), entity_ref("urn:test:s69#y11"), 40000.00 USD) { origin case_input; }
        assert "f1": filing_status(entity_ref("urn:test:s69#par"), entity_ref("urn:test:s69#y11"), Unmarried) { origin case_input; }
        assert "f2": us.irc.core::begins(entity_ref("urn:test:s69#y11"), @2024-01-01) { origin case_input; }
        assert "f3": has_electing_child(entity_ref("urn:test:s69#par"), entity_ref("urn:test:s69#y11")) { origin case_input; }
        assert "f4": parent_gross_income_inclusion_from_child(entity_ref("urn:test:s69#par"), entity_ref("urn:test:s69#ch11"), entity_ref("urn:test:s69#y11"), 10000.00 USD) { origin case_input; }
    }
    // 40000 + 10000 = 50000 under the TCJA unmarried table
    evaluate truth(parent_tax_after_child_income_inclusion(entity_ref("urn:test:s69#par"), entity_ref("urn:test:s69#y11"), 6939.50 USD));
    expect truth_status == TRUE_ONLY;
}

