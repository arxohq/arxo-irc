    // increase 1928 rounded down to 1925 (section 1(f)(7)(B))
    evaluate truth(cola_adjusted_amount(9640 USD, 2017, entity_ref("urn:test:s60#y1"), 25, 11565 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

