// Section 1(f), 1(j)(3), 1(f)(7), 1(f)(8) and the shared cost-of-living mechanism: scenarios (stage 3).
// NOT EXECUTED in this assignment (status implemented_unverified). Expectations are
// computed by hand from the pinned statutory text, not from any engine output.
// Index values (C-CPI-U, CPI) in scenarios are SYNTHETIC round numbers chosen for hand
// arithmetic; they are not Bureau of Labor Statistics data.

language "law.core" version "0.2";
package us.irc.income_individual version "0.1.1";
namespace "urn:us:irc:income_individual:clir";

test "S60-01-C-CPI-U-TWELVE-MONTH-SUM" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": c_cpi_u_window_month(2024, 1, 126.0) { origin case_input; }
        assert "f1": c_cpi_u_window_month(2024, 2, 126.0) { origin case_input; }
        assert "f2": c_cpi_u_window_month(2024, 3, 126.0) { origin case_input; }
        assert "f3": c_cpi_u_window_month(2024, 4, 126.0) { origin case_input; }
        assert "f4": c_cpi_u_window_month(2024, 5, 126.0) { origin case_input; }
        assert "f5": c_cpi_u_window_month(2024, 6, 126.0) { origin case_input; }
        assert "f6": c_cpi_u_window_month(2024, 7, 126.0) { origin case_input; }
        assert "f7": c_cpi_u_window_month(2024, 8, 126.0) { origin case_input; }
        assert "f8": c_cpi_u_window_month(2024, 9, 126.0) { origin case_input; }
        assert "f9": c_cpi_u_window_month(2024, 10, 126.0) { origin case_input; }
        assert "f10": c_cpi_u_window_month(2024, 11, 126.0) { origin case_input; }
        assert "f11": c_cpi_u_window_month(2024, 12, 126.0) { origin case_input; }
    }
    // 12 monthly values of 126.0 sum to 1512.0 (the average 126.0 is that sum over 12)
    evaluate truth(c_cpi_u_twelve_month_sum(2024, 1512.0));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

