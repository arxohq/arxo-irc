// Section 1(a)-(e)/(j) rate schedule scenarios. NOT EXECUTED per AGENT-BRIEF
// (`implemented_unverified`): expectations are computed by hand from the
// pinned statutory table amounts (`rates.law` module header), not from any
// engine run.

language "law.core" version "0.2";
package us.irc.income_individual version "0.1.1";
namespace "urn:us:irc:income_individual:clir";

// --- TCJA joint table, bracket boundaries (2024, within [2018,2026)) --------

test "S1-01-TCJA-JOINT-AT-FIRST-BRACKET-TOP" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": filing_status(entity_ref("urn:test:s1:joint-1#p"), entity_ref("urn:test:s1:joint-1#y2024"), Joint) { origin case_input; }
        assert "f1": taxable_income(entity_ref("urn:test:s1:joint-1#p"), entity_ref("urn:test:s1:joint-1#y2024"), 19050 USD) { origin case_input; }
    }
    // exactly at the top of the 10% bracket: tax = 10% * 19050 = 1905
    evaluate truth(tax_under_section_1(entity_ref("urn:test:s1:joint-1#p"), entity_ref("urn:test:s1:joint-1#y2024"), 1905 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1-02-TCJA-JOINT-JUST-ABOVE-FIRST-BRACKET" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": filing_status(entity_ref("urn:test:s1:joint-2#p"), entity_ref("urn:test:s1:joint-2#y2024"), Joint) { origin case_input; }
        assert "f1": taxable_income(entity_ref("urn:test:s1:joint-2#p"), entity_ref("urn:test:s1:joint-2#y2024"), 19150 USD) { origin case_input; }
    }
    // one bracket up: base 1905 + 12% * (19150 - 19050) = 1905 + 12 = 1917
    evaluate truth(tax_under_section_1(entity_ref("urn:test:s1:joint-2#p"), entity_ref("urn:test:s1:joint-2#y2024"), 1917 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1-03-TCJA-JOINT-TOP-BRACKET" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": filing_status(entity_ref("urn:test:s1:joint-3#p"), entity_ref("urn:test:s1:joint-3#y2024"), Joint) { origin case_input; }
        assert "f1": taxable_income(entity_ref("urn:test:s1:joint-3#p"), entity_ref("urn:test:s1:joint-3#y2024"), 700000 USD) { origin case_input; }
    }
    // top bracket: 161379 + 37% * (700000 - 600000) = 161379 + 37000 = 198379
    evaluate truth(tax_under_section_1(entity_ref("urn:test:s1:joint-3#p"), entity_ref("urn:test:s1:joint-3#y2024"), 198379 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// --- Filing status branches --------------------------------------------------

test "S1-04-TCJA-SINGLE-FIRST-BRACKET" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": filing_status(entity_ref("urn:test:s1:single-1#p"), entity_ref("urn:test:s1:single-1#y2024"), Unmarried) { origin case_input; }
        assert "f1": taxable_income(entity_ref("urn:test:s1:single-1#p"), entity_ref("urn:test:s1:single-1#y2024"), 5000 USD) { origin case_input; }
    }
    // 10% of 5000 = 500
    evaluate truth(tax_under_section_1(entity_ref("urn:test:s1:single-1#p"), entity_ref("urn:test:s1:single-1#y2024"), 500 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1-05-TCJA-ESTATE-TRUST-COMPRESSED-BRACKETS" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": filing_status(entity_ref("urn:test:s1:estate-1#p"), entity_ref("urn:test:s1:estate-1#y2024"), EstateOrTrust) { origin case_input; }
        assert "f1": taxable_income(entity_ref("urn:test:s1:estate-1#p"), entity_ref("urn:test:s1:estate-1#y2024"), 15000 USD) { origin case_input; }
    }
    // top estate/trust bracket: 3011.50 + 37% * (15000-12500) = 3011.50 + 925 = 3936.50
    evaluate truth(tax_under_section_1(entity_ref("urn:test:s1:estate-1#p"), entity_ref("urn:test:s1:estate-1#y2024"), 3936.50 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// --- Temporal boundary: pre-2018 base schedule vs TCJA -----------------------

test "S1-06-PRE-2018-BASE-SCHEDULE-APPLIES" {
    given {
        context {
            legal_time @2017-04-15;
            decision_time @2017-04-15T09:00:00-05:00;
            knowledge_time @2017-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": filing_status(entity_ref("urn:test:s1:pre2018#p"), entity_ref("urn:test:s1:pre2018#y2017"), Joint) { origin case_input; }
        assert "f1": taxable_income(entity_ref("urn:test:s1:pre2018#p"), entity_ref("urn:test:s1:pre2018#y2017"), 36900 USD) { origin case_input; }
    }
    // exactly at the top of the 15% bracket under section 1(a): 15% * 36900 = 5535
    evaluate truth(tax_under_section_1(entity_ref("urn:test:s1:pre2018#p"), entity_ref("urn:test:s1:pre2018#y2017"), 5535 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1-07-2026-PERMANENT-TCJA-SAME-BRACKETS-AS-2025" {
    given {
        context {
            legal_time @2026-04-15;
            decision_time @2026-04-15T09:00:00-05:00;
            knowledge_time @2026-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": filing_status(entity_ref("urn:test:s1:y2026#p"), entity_ref("urn:test:s1:y2026#y2026"), Joint) { origin case_input; }
        assert "f1": taxable_income(entity_ref("urn:test:s1:y2026#p"), entity_ref("urn:test:s1:y2026#y2026"), 19050 USD) { origin case_input; }
    }
    // Pub. L. 119-21 keeps the section 1(j)(2) TABLE unchanged for 2026; the
    // unadjusted statutory floor still gives 1905 (this package cannot yet
    // apply the actual 2026 COLA-adjusted brackets — see
    // `inflation-and-rate-reductions.law` TECH_GAP).
    evaluate truth(tax_under_section_1(entity_ref("urn:test:s1:y2026#p"), entity_ref("urn:test:s1:y2026#y2026"), 1905 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// --- Unknown fact --------------------------------------------------------

test "S1-08-UNKNOWN-TAXABLE-INCOME-IS-UNDETERMINED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": filing_status(entity_ref("urn:test:s1:unknown#p"), entity_ref("urn:test:s1:unknown#y2024"), Joint) { origin case_input; }
    }
    evaluate truth(tax_under_section_1(entity_ref("urn:test:s1:unknown#p"), entity_ref("urn:test:s1:unknown#y2024"), 0 USD));
    expect truth_status == NEITHER;
}
