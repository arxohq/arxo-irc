test "S56D2-01-POST-1986-LOSS-YEAR-ADJUSTED-AND-REDUCED-BY-PREFERENCES" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": regular_net_operating_loss_of_loss_year(entity_ref("urn:test:s67#p"), entity_ref("urn:test:s67#ly"), 100000 USD) { origin case_input; }
        assert "f1": loss_year_begins_on(entity_ref("urn:test:s67#ly"), @1990-01-01) { origin case_input; }
        assert "f2": amt_adjustments_total(entity_ref("urn:test:s67#p"), entity_ref("urn:test:s67#ly"), 20000 USD) { origin case_input; }
        assert "f3": amt_preferences_total(entity_ref("urn:test:s67#p"), entity_ref("urn:test:s67#ly"), 30000 USD) { origin case_input; }
    }
    // 100000 - 20000 - 30000
    evaluate truth(atnol_of_loss_year(entity_ref("urn:test:s67#p"), entity_ref("urn:test:s67#ly"), 50000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S56D2-02-PREFERENCES-CANNOT-TAKE-THE-LOSS-BELOW-ZERO" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": regular_net_operating_loss_of_loss_year(entity_ref("urn:test:s67#p"), entity_ref("urn:test:s67#ly"), 100000 USD) { origin case_input; }
        assert "f1": loss_year_begins_on(entity_ref("urn:test:s67#ly"), @1990-01-01) { origin case_input; }
        assert "f2": amt_adjustments_total(entity_ref("urn:test:s67#p"), entity_ref("urn:test:s67#ly"), 20000 USD) { origin case_input; }
        assert "f3": amt_preferences_total(entity_ref("urn:test:s67#p"), entity_ref("urn:test:s67#ly"), 90000 USD) { origin case_input; }
    }
    // 100000 - 20000 - 90000 is negative: no loss
    evaluate truth(atnol_of_loss_year(entity_ref("urn:test:s67#p"), entity_ref("urn:test:s67#ly"), 0 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

