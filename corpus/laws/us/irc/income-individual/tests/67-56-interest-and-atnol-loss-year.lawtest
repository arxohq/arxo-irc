// Section 56(b)(1)(B) interest classification and section 56(d)(2) loss years (stage 3).
// NOT EXECUTED in this assignment (status implemented_unverified). Expectations are
// computed by hand from the pinned statutory text, not from any engine output.
// Index values (C-CPI-U, CPI) in scenarios are SYNTHETIC round numbers chosen for hand
// arithmetic; they are not Bureau of Labor Statistics data.

language "law.core" version "0.2";
package us.irc.income_individual version "0.1.1";
namespace "urn:us:irc:income_individual:clir";

test "S56B1B-01-PERSONAL-INTEREST-FOR-AMT" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": filing_status(entity_ref("urn:test:s67#p"), entity_ref("urn:test:s67#y"), Unmarried) { origin case_input; }
        assert "f1": debt_interest_is_personal_interest_163h(entity_ref("urn:test:s67#debt"), entity_ref("urn:test:s67#p"), entity_ref("urn:test:s67#y")) { origin case_input; }
    }
    // section 56(b)(1)(B)(i)
    evaluate truth(personal_interest_for_amt(entity_ref("urn:test:s67#debt"), entity_ref("urn:test:s67#p"), entity_ref("urn:test:s67#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S56B1B-02-QUALIFIED-HOUSING-INTEREST-IS-NOT-PERSONAL-INTEREST" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": filing_status(entity_ref("urn:test:s67#p"), entity_ref("urn:test:s67#y"), Unmarried) { origin case_input; }
        assert "f1": debt_interest_is_personal_interest_163h(entity_ref("urn:test:s67#debt"), entity_ref("urn:test:s67#p"), entity_ref("urn:test:s67#y")) { origin case_input; }
        assert "f2": qualified_housing_interest_on(entity_ref("urn:test:s67#debt"), entity_ref("urn:test:s67#p"), entity_ref("urn:test:s67#y")) { origin case_input; }
    }
    // in lieu of the section 163(h)(2)(D) exception
    evaluate truth(personal_interest_for_amt(entity_ref("urn:test:s67#debt"), entity_ref("urn:test:s67#p"), entity_ref("urn:test:s67#y")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

