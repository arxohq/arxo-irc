test "S56D2-05-PRE-1987-LOSS-YEAR-NOT-COMPUTED-BY-THE-POST-1986-RULE" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": regular_net_operating_loss_of_loss_year(entity_ref("urn:test:s67#p"), entity_ref("urn:test:s67#ly"), 100000 USD) { origin case_input; }
        assert "f1": loss_year_begins_on(entity_ref("urn:test:s67#ly"), @1986-07-01) { origin case_input; }
        assert "f2": amt_adjustments_total(entity_ref("urn:test:s67#p"), entity_ref("urn:test:s67#ly"), 0 USD) { origin case_input; }
        assert "f3": amt_preferences_total(entity_ref("urn:test:s67#p"), entity_ref("urn:test:s67#ly"), 0 USD) { origin case_input; }
    }
    // the loss year began before 1987
