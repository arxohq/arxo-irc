        assert "f1": loss_year_begins_on(entity_ref("urn:test:s67#ly"), @1987-01-01) { origin case_input; }
        assert "f2": amt_adjustments_total(entity_ref("urn:test:s67#p"), entity_ref("urn:test:s67#ly"), 0 USD) { origin case_input; }
        assert "f3": amt_preferences_total(entity_ref("urn:test:s67#p"), entity_ref("urn:test:s67#ly"), 0 USD) { origin case_input; }
    }
    // "beginning after December 31, 1986"
    evaluate truth(atnol_of_loss_year(entity_ref("urn:test:s67#p"), entity_ref("urn:test:s67#ly"), 100000 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

