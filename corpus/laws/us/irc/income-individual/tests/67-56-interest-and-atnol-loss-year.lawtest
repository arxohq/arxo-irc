        assert "f2": specified_private_activity_bond(entity_ref("urn:test:s67#bond")) { origin case_input; }
        assert "f3": deduction_allowable_if_interest_includible(entity_ref("urn:test:s67#p"), entity_ref("urn:test:s67#y"), 120 USD) { origin case_input; }
    }
    // section 56(b)(1)(B)(ii)
