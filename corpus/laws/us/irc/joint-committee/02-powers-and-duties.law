// 26 U.S.C. Chapter 92 (§§8021-8023) — Miscellaneous Provisions: the
// Joint Committee's (and any subcommittee's) hearing/subpoena/oath/testimony
// powers, printing and expenditure powers, the GAO-request review duty
// (§8021), the Committee's investigation/simplification/reporting duties
// (§8022), and the reciprocal data-exchange power/duty with the IRS and
// other executive agencies (§8023).
//
// JUDGMENT CALLS AND GAPS (see report):
//  - §8021(a) is a pure cross-reference to §6103(f) (owned by
//    `confidentiality`, already tracked pending in DEPENDENCIES.json); this
//    package states no independent rule for it — EXTERNAL_DEPENDENCY.
//  - §8021(b)-(d)'s "as it deems advisable" grants are modeled as powers
//    whose only `valid_when` condition is that the actor is the Joint
//    Committee or a subcommittee of it (§8021(b)'s own limitation); the
//    statute imposes no further substantive precondition on exercising them.
//  - §8022(1)(C) ("such other investigations ... as the Joint Committee may
//    deem necessary") is modeled as a LIBERTY, not a duty: its content is
//    entirely the Committee's own discretion, matching the liberty criterion
//    (own conduct, no forced outcome) rather than an obligation with a
//    determinate goal.
//  - §8022(2)(B) ("to publish, from time to time, ... proposed measures")
//    is TECH_GAP-adjacent: the 0.1 grammar reserves `recurring` goals and
//    does not parse them (docs/research/constructs/10-duty/). Modeled as
//    `maintenance`, the closest available primitive, which requires
//    continuous rather than periodic satisfaction — an approximation, not
//    the statute's actual periodicity.
//  - §8022(4) is a pure cross-reference to §6405 (owned by
//    `payment-refunds-interest`, already tracked pending) — EXTERNAL_DEPENDENCY.
//  - §8023(a)/(b) reify neither "the request" nor "the furnished data" as a
//    standalone entity; the exercise/duty relations are keyed by the
//    (requester, source) pair instead, which cannot distinguish two
//    concurrent requests between the same parties for different data. A
//    `DataRequest` entity would remove this limitation; not introduced here
//    to keep the surface no larger than the anchor sections require.

language "law.core" version "0.2";
package us.irc.joint_committee version "0.1.1";
namespace "urn:us:irc:joint_committee:clir";

use self::{
    GovernmentAccountabilityOffice,
    HouseWaysAndMeansCommittee,
    IRC_S8021_B,
    IRC_S8021_C,
    IRC_S8021_D,
    IRC_S8021_E,
    IRC_S8022,
    IRC_S8023_A,
    IRC_S8023_B,
    JointCommittee,
    Organ,
    Person,
    SenateFinanceCommittee,
    is_chief_of_staff,
    signer_is_chair_or_vice_chair,
};

// --- §8021(a): cross-reference to §6103(f) ----------------------------------
// EXTERNAL_DEPENDENCY: the power to obtain and inspect income returns is
// §6103(f)'s own norm (owner `confidentiality`, DEPENDENCIES.json row
// "26/8021/a/u1" -> target_section "6103", status pending). Nothing to state
// here beyond the cross-reference itself; see coverage row 26/8021/a/u1.

// --- §8021(b)-(d): hearing, subpoena, oath, testimony, printing, expenditure ---

relation subcommittee_of(sub: Organ, of: Organ) kind empirical {
    label en unofficial "the organ is a subcommittee of the named committee";
}
relation acting_body(actor: Organ) kind institutional {
    label en unofficial "the organ is the Joint Committee itself or a subcommittee of it, and so may exercise the §8021(b)-(d) powers";
}
@source(IRC_S8021_B, relation = formalizes, coverage = partial, quote = "The Joint Committee, or any subcommittee thereof, is authorized")
assert acting_body(JointCommittee);

@source(IRC_S8021_B, relation = formalizes, coverage = partial, quote = "or any subcommittee thereof")
rule S8021ActingBodySubcommittee strict {
    for sub: Organ;
    when subcommittee_of(sub, JointCommittee);
    then acting_body(sub);
}

relation convenes_hearing(actor: Organ) kind empirical;
relation hearing_held(actor: Organ) kind institutional;
@source(IRC_S8021_B, relation = formalizes, coverage = partial, quote = "To hold hearings and to sit and act at such places and times;")
rule S8021HoldHearingsAndSit strict {
    for actor: Organ;
    when convenes_hearing(actor);
    then power S8021HoldHearingsPower {
        holder actor;
        exercise convenes_hearing(actor);
        valid_when acting_body(actor);
        effect create(hearing_held(actor));
    };
}

relation issues_subpoena(actor: Organ, signer: Person) kind empirical {
    label en unofficial "the actor requires, by subpoena issued under the signature of the chairman or vice chairman, the attendance of a witness or the production of books, papers, or documents";
}
relation compels_attendance_otherwise(actor: Organ) kind empirical {
    label en unofficial "the actor requires attendance or production 'otherwise' than by subpoena (§8021(b)(2))";
}
relation attendance_or_production_required(actor: Organ) kind institutional;

relation subpoena_authority(actor: Organ, signer: Person) kind institutional {
    label en unofficial "the actor is an acting body under §8021(b) and the signer is its chairman or vice chairman, so the signer may issue a subpoena on the actor's behalf";
}
@source(IRC_S8021_B, relation = formalizes, coverage = partial, quote = "to be issued under the signature of the chairman or vice chairman")
rule S8021SubpoenaAuthority strict {
    for actor: Organ;
    for signer: Person;
    when acting_body(actor) and signer_is_chair_or_vice_chair(signer);
    then subpoena_authority(actor, signer);
}

@source(IRC_S8021_B, relation = formalizes, coverage = partial, quote = "To require by subpoena (to be issued under the signature of the chairman or vice chairman) or otherwise the attendance of such witnesses and the production of such books, papers, and documents;")
rule S8021RequireBySubpoena strict {
    for actor: Organ;
    for signer: Person;
    when issues_subpoena(actor, signer);
    then power S8021RequireBySubpoenaPower {
        holder actor;
        exercise issues_subpoena(actor, signer);
        valid_when subpoena_authority(actor, signer);
        effect create(attendance_or_production_required(actor));
    };
}
@source(IRC_S8021_B, relation = formalizes, coverage = partial, quote = "To require by subpoena (to be issued under the signature of the chairman or vice chairman) or otherwise the attendance of such witnesses and the production of such books, papers, and documents;")
rule S8021RequireOtherwise strict {
    for actor: Organ;
    when compels_attendance_otherwise(actor);
    then power S8021RequireOtherwisePower {
        holder actor;
        exercise compels_attendance_otherwise(actor);
        valid_when acting_body(actor);
        effect create(attendance_or_production_required(actor));
    };
}

relation administers_oath(actor: Organ) kind empirical;
relation oath_administered(actor: Organ) kind institutional;
@source(IRC_S8021_B, relation = formalizes, coverage = partial, quote = "To administer such oaths; and")
rule S8021AdministerOaths strict {
    for actor: Organ;
    when administers_oath(actor);
    then power S8021AdministerOathsPower {
        holder actor;
        exercise administers_oath(actor);
        valid_when acting_body(actor);
        effect create(oath_administered(actor));
    };
}

relation takes_testimony(actor: Organ) kind empirical;
relation testimony_taken(actor: Organ) kind institutional;
@source(IRC_S8021_B, relation = formalizes, coverage = partial, quote = "To take such testimony;")
rule S8021TakeTestimony strict {
    for actor: Organ;
    when takes_testimony(actor);
    then power S8021TakeTestimonyPower {
        holder actor;
        exercise takes_testimony(actor);
        valid_when acting_body(actor);
        effect create(testimony_taken(actor));
    };
}

relation orders_printing_and_binding(actor: Organ) kind empirical;
relation printing_and_binding_done(actor: Organ) kind institutional;
@source(IRC_S8021_C, relation = formalizes, coverage = exact, quote = "The Joint Committee, or any subcommittee thereof, is authorized to have such printing and binding done as it deems advisable.")
rule S8021ProcurePrintingAndBinding strict {
    for actor: Organ;
    when orders_printing_and_binding(actor);
    then power S8021PrintingPower {
        holder actor;
        exercise orders_printing_and_binding(actor);
        valid_when acting_body(actor);
        effect create(printing_and_binding_done(actor));
    };
}

relation makes_expenditure(actor: Organ) kind empirical;
relation expenditure_made(actor: Organ) kind institutional;
@source(IRC_S8021_D, relation = formalizes, coverage = exact, quote = "The Joint Committee, or any subcommittee thereof, is authorized to make such expenditures as it deems advisable.")
rule S8021MakeExpenditures strict {
    for actor: Organ;
    when makes_expenditure(actor);
    then power S8021ExpenditurePower {
        holder actor;
        exercise makes_expenditure(actor);
        valid_when acting_body(actor);
        effect create(expenditure_made(actor));
    };
}

// --- §8021(e): review of GAO investigation requests -------------------------

entity GaoInvestigationRequest { label en unofficial "a request for a GAO investigation of the Internal Revenue Service"; }

relation gao_investigation_request(req: GaoInvestigationRequest) kind empirical;
relation requested_by_chair_or_ranking_member(req: GaoInvestigationRequest) kind empirical {
    label en unofficial "the request is made by the chairman or ranking member of a committee or subcommittee — outside §8021(e)'s review requirement";
}
relation reviewed_by_joint_committee(req: GaoInvestigationRequest) kind empirical;
relation joint_committee_approves(req: GaoInvestigationRequest) kind empirical;
relation gao_investigation_approved(req: GaoInvestigationRequest) kind institutional;

@source(IRC_S8021_E, relation = formalizes, coverage = partial, quote = "The Joint Committee shall review all requests (other than requests by the chairman or ranking member of a committee or subcommittee) for investigations of the Internal Revenue Service by the Government Accountability Office")
rule S8021ReviewGaoRequests defeasible {
    for req: GaoInvestigationRequest;
    when gao_investigation_request(req);
    then duty ReviewGaoInvestigationRequest {
        bearer JointCommittee;
        beneficiary GovernmentAccountabilityOffice;
        goal achievement {
            condition reviewed_by_joint_committee(req);
            window [-infinity, infinity];
        }
    };
    unless requested_by_chair_or_ranking_member(req);
}

@source(IRC_S8021_E, relation = formalizes, coverage = partial, quote = "and approve such requests when appropriate")
rule S8021ApproveGaoRequest strict {
    for req: GaoInvestigationRequest;
    when joint_committee_approves(req);
    then power S8021ApproveGaoRequestPower {
        holder JointCommittee;
        over req;
        exercise joint_committee_approves(req);
        valid_when reviewed_by_joint_committee(req);
        effect create(gao_investigation_approved(req));
    };
}

// --- §8022: duties of the Joint Committee -----------------------------------

relation investigates_operation_and_effects(committee: Organ) kind empirical;
@source(IRC_S8022, relation = formalizes, coverage = partial, quote = "To investigate the operation and effects of the Federal system of internal revenue taxes;")
rule S8022InvestigateOperationAndEffects strict {
    when true;
    then duty InvestigateOperationAndEffects {
        bearer JointCommittee;
        beneficiary us.irc.core::Congress;
        goal maintenance {
            condition investigates_operation_and_effects(JointCommittee);
            window [-infinity, infinity];
        }
    };
}

relation investigates_administration(committee: Organ) kind empirical;
@source(IRC_S8022, relation = formalizes, coverage = partial, quote = "To investigate the administration of such taxes by the Internal Revenue Service or any executive department, establishment, or agency charged with their administration; and")
rule S8022InvestigateAdministration strict {
    when true;
    then duty InvestigateAdministration {
        bearer JointCommittee;
        beneficiary us.irc.core::Congress;
        goal maintenance {
            condition investigates_administration(JointCommittee);
            window [-infinity, infinity];
        }
    };
}

relation investigates_other_matters(committee: Organ) kind empirical;
@source(IRC_S8022, relation = formalizes, coverage = exact, quote = "To make such other investigations in respect of such system of taxes as the Joint Committee may deem necessary.")
rule S8022MayInvestigateOtherMatters strict {
    when true;
    then liberty MayInvestigateOtherMatters {
        holder JointCommittee;
        action investigates_other_matters(JointCommittee);
        window [-infinity, infinity];
    };
}

relation investigates_simplification_measures(committee: Organ) kind empirical;
@source(IRC_S8022, relation = formalizes, coverage = partial, quote = "To investigate measures and methods for the simplification of such taxes, particularly the income tax; and")
rule S8022InvestigateSimplification strict {
    when true;
    then duty InvestigateSimplificationMeasures {
        bearer JointCommittee;
        beneficiary us.irc.core::Congress;
        goal maintenance {
            condition investigates_simplification_measures(JointCommittee);
            window [-infinity, infinity];
        }
    };
}

// TECH_GAP-adjacent: `recurring` goals are reserved, not parsed in 0.1
// (docs/research/constructs/10-duty/). "From time to time" is approximated
// as `maintenance`, which is a continuous rather than a periodic condition.
relation publishes_simplification_proposals(committee: Organ) kind empirical;
@source(IRC_S8022, relation = formalizes, coverage = exact, quote = "To publish, from time to time, for public examination and analysis, proposed measures and methods for the simplification of such taxes.")
rule S8022PublishSimplificationProposals strict {
    when true;
    then duty PublishSimplificationProposals {
        bearer JointCommittee;
        goal maintenance {
            condition publishes_simplification_proposals(JointCommittee);
            window [-infinity, infinity];
        }
    };
}

relation reports_investigations_to(committee: Organ, to: Organ) kind empirical;
@source(IRC_S8022, relation = formalizes, coverage = partial, quote = "(A) To report, from time to time, to the Committee on Finance and the Committee on Ways and Means, and, in its discretion, to the Senate or House of Representatives, or both, the results of its investigations, together with such recommendations as it may deem advisable.")
rule S8022ReportInvestigationsToFinanceCommittee strict {
    when true;
    then duty ReportInvestigationResultsToFinanceCommittee {
        bearer JointCommittee;
        beneficiary SenateFinanceCommittee;
        goal maintenance {
            condition reports_investigations_to(JointCommittee, SenateFinanceCommittee);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S8022, relation = formalizes, coverage = partial, quote = "(A) To report, from time to time, to the Committee on Finance and the Committee on Ways and Means, and, in its discretion, to the Senate or House of Representatives, or both, the results of its investigations, together with such recommendations as it may deem advisable.")
rule S8022ReportInvestigationsToWaysAndMeansCommittee strict {
    when true;
    then duty ReportInvestigationResultsToWaysAndMeansCommittee {
        bearer JointCommittee;
        beneficiary HouseWaysAndMeansCommittee;
        goal maintenance {
            condition reports_investigations_to(JointCommittee, HouseWaysAndMeansCommittee);
            window [-infinity, infinity];
        }
    };
}

relation reports_state_of_tax_system_to(committee: Organ, to: Organ) kind empirical;
relation appropriated_for_state_of_tax_system_report(committee: Organ) kind empirical {
    label en unofficial "amounts have been specifically appropriated to carry out §8022(3)(B)";
}
@source(IRC_S8022, relation = formalizes, coverage = partial, quote = "(B) Subject to amounts specifically appropriated to carry out this subparagraph, to report, at least once each Congress, to the Committee on Finance and the Committee on Ways and Means on the overall state of the Federal tax system, together with recommendations with respect to possible simplification proposals and other matters relating to the administration of the Federal tax system as it may deem advisable.")
rule S8022ReportStateOfTaxSystemToFinanceCommittee defeasible {
    when true;
    then duty ReportStateOfTaxSystemToFinanceCommittee {
        bearer JointCommittee;
        beneficiary SenateFinanceCommittee;
        goal achievement {
            condition reports_state_of_tax_system_to(JointCommittee, SenateFinanceCommittee);
            window [-infinity, infinity];
        }
    };
    unless not appropriated_for_state_of_tax_system_report(JointCommittee);
}
@source(IRC_S8022, relation = formalizes, coverage = partial, quote = "(B) Subject to amounts specifically appropriated to carry out this subparagraph, to report, at least once each Congress, to the Committee on Finance and the Committee on Ways and Means on the overall state of the Federal tax system, together with recommendations with respect to possible simplification proposals and other matters relating to the administration of the Federal tax system as it may deem advisable.")
rule S8022ReportStateOfTaxSystemToWaysAndMeansCommittee defeasible {
    when true;
    then duty ReportStateOfTaxSystemToWaysAndMeansCommittee {
        bearer JointCommittee;
        beneficiary HouseWaysAndMeansCommittee;
        goal achievement {
            condition reports_state_of_tax_system_to(JointCommittee, HouseWaysAndMeansCommittee);
            window [-infinity, infinity];
        }
    };
    unless not appropriated_for_state_of_tax_system_report(JointCommittee);
}

// §8022(4) is a pure cross-reference to §6405 (owned by
// `payment-refunds-interest`; DEPENDENCIES.json row "26/8022/4/u1", status
// pending) — EXTERNAL_DEPENDENCY, no rule stated here.

// --- §8023: additional powers and duties to obtain and furnish data --------

relation committee_secures_data(committee: Organ, from: Organ) kind empirical {
    label en unofficial "the Joint Committee secures information, suggestions, rulings, data, estimates, or statistics directly from the named executive agency, for investigations, reports or studies relating to internal revenue taxation";
}
relation committee_secures_data_approved(committee: Organ, from: Organ) kind empirical {
    label en unofficial "the request is approved by the Chairman or Vice Chairman (§8023(a))";
}
relation data_secured_by_committee(committee: Organ, from: Organ) kind institutional;

@source(IRC_S8023_A, relation = formalizes, coverage = partial, quote = "The Joint Committee or the Chief of Staff of the Joint Committee, upon approval of the Chairman or Vice Chairman, is authorized to secure directly from the Internal Revenue Service, or the office of the Chief Counsel for the Internal Revenue Service, or directly from any executive department, board, bureau, agency, independent establishment, or instrumentality of the Government, information, suggestions, rulings, data, estimates, and statistics, for the purpose of making investigations, reports, and studies relating to internal revenue taxation.")
rule S8023SecureDataByCommittee strict {
    for from: Organ;
    when committee_secures_data(JointCommittee, from);
    then power S8023SecureDataByCommitteePower {
        holder JointCommittee;
        over from;
        exercise committee_secures_data(JointCommittee, from);
        valid_when committee_secures_data_approved(JointCommittee, from);
        effect create(data_secured_by_committee(JointCommittee, from));
    };
}

relation chief_of_staff_secures_data(p: Person, from: Organ) kind empirical;
relation chief_of_staff_secures_data_approved(p: Person, from: Organ) kind empirical {
    label en unofficial "the Chief of Staff's request is approved by the Chairman or Vice Chairman (§8023(a))";
}
relation data_secured_by_chief_of_staff(p: Person, from: Organ) kind institutional;

relation chief_of_staff_data_request_valid(p: Person, from: Organ) kind institutional {
    label en unofficial "the person is the Chief of Staff and the Chief of Staff's data request has been approved by the Chairman or Vice Chairman";
}
@source(IRC_S8023_A, relation = formalizes, coverage = partial, quote = "upon approval of the Chairman or Vice Chairman")
rule S8023ChiefOfStaffDataRequestValid strict {
    for p: Person;
    for from: Organ;
    when is_chief_of_staff(p) and chief_of_staff_secures_data_approved(p, from);
    then chief_of_staff_data_request_valid(p, from);
}

@source(IRC_S8023_A, relation = formalizes, coverage = partial, quote = "The Joint Committee or the Chief of Staff of the Joint Committee, upon approval of the Chairman or Vice Chairman, is authorized to secure directly from the Internal Revenue Service, or the office of the Chief Counsel for the Internal Revenue Service, or directly from any executive department, board, bureau, agency, independent establishment, or instrumentality of the Government, information, suggestions, rulings, data, estimates, and statistics, for the purpose of making investigations, reports, and studies relating to internal revenue taxation.")
rule S8023SecureDataByChiefOfStaff strict {
    for p: Person;
    for from: Organ;
    when chief_of_staff_secures_data(p, from);
    then power S8023SecureDataByChiefOfStaffPower {
        holder p;
        over from;
        exercise chief_of_staff_secures_data(p, from);
        valid_when chief_of_staff_data_request_valid(p, from);
        effect create(data_secured_by_chief_of_staff(p, from));
    };
}

relation secures_tax_returns_for_administration_investigation(p: Person) kind empirical {
    label en unofficial "the Chief of Staff, investigating the IRS's administration of internal revenue taxes (§8022(1)(B)), secures tax returns or copies and other relevant information the Chief of Staff deems necessary";
}
relation tax_returns_secured_for_investigation(p: Person) kind institutional;

@source(IRC_S8023_A, relation = formalizes, coverage = partial, quote = "In the investigation by the Joint Committee on Taxation of the administration of the internal revenue taxes by the Internal Revenue Service, the Chief of Staff of the Joint Committee on Taxation is authorized to secure directly from the Internal Revenue Service such tax returns, or copies of tax returns, and other relevant information, as the Chief of Staff deems necessary for such investigation")
rule S8023SecureTaxReturnsForAdministrationInvestigation strict {
    for p: Person;
    when secures_tax_returns_for_administration_investigation(p);
    then power S8023SecureTaxReturnsPower {
        holder p;
        over us.irc.core::IRS;
        exercise secures_tax_returns_for_administration_investigation(p);
        valid_when is_chief_of_staff(p);
        effect create(tax_returns_secured_for_investigation(p));
    };
}

relation tax_returns_and_audit_report_furnished(p: Person) kind empirical;
@source(IRC_S8023_A, relation = formalizes, coverage = partial, quote = "the Internal Revenue Service is authorized and directed to furnish such tax returns and information to the Chief of Staff together with a brief report, with respect to each return, as to any action taken or proposed to be taken by the Service as a result of any audit of the return")
rule S8023FurnishTaxReturnsWithAuditReport strict {
    for p: Person;
    when tax_returns_secured_for_investigation(p);
    then duty FurnishTaxReturnsWithAuditReport {
        bearer us.irc.core::IRS;
        beneficiary p;
        goal achievement {
            condition tax_returns_and_audit_report_furnished(p);
            window [-infinity, infinity];
        }
    };
}

// --- §8023(b): furnishing of data --------------------------------------------

relation furnished_data_to_committee(from: Organ, to: Organ) kind empirical;
@source(IRC_S8023_B, relation = formalizes, coverage = exact, quote = "The Internal Revenue Service, the office of the Chief Counsel for the Internal Revenue Service, executive departments, boards, bureaus, agencies, independent establishments, and instrumentalities are authorized and directed to furnish such information, suggestions, rulings, data, estimates, and statistics directly to the Joint Committee or to the Chief of Staff of the Joint Committee, upon request made pursuant to this section.")
rule S8023FurnishDataToCommittee strict {
    for from: Organ;
    when committee_secures_data(JointCommittee, from);
    then duty FurnishDataToCommittee {
        bearer from;
        beneficiary JointCommittee;
        goal achievement {
            condition furnished_data_to_committee(from, JointCommittee);
            window [-infinity, infinity];
        }
    };
}

relation furnished_data_to_chief_of_staff(from: Organ, to: Person) kind empirical;
@source(IRC_S8023_B, relation = formalizes, coverage = exact, quote = "The Internal Revenue Service, the office of the Chief Counsel for the Internal Revenue Service, executive departments, boards, bureaus, agencies, independent establishments, and instrumentalities are authorized and directed to furnish such information, suggestions, rulings, data, estimates, and statistics directly to the Joint Committee or to the Chief of Staff of the Joint Committee, upon request made pursuant to this section.")
rule S8023FurnishDataToChiefOfStaff strict {
    for p: Person;
    for from: Organ;
    when chief_of_staff_secures_data(p, from);
    then duty FurnishDataToChiefOfStaff {
        bearer from;
        beneficiary p;
        goal achievement {
            condition furnished_data_to_chief_of_staff(from, p);
            window [-infinity, infinity];
        }
    };
}

// §8023(c): NON_NORMATIVE — see coverage row 26/8023/c/u1. It states that
// (a)-(b) remain operative notwithstanding any executive reorganization
// plan; it adds no testable condition beyond the powers/duties already
// modeled above, so no separate rule formalizes it.
