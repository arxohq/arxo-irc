// 26 U.S.C. Subtitle G — The Joint Committee on Taxation (§§8001-8023): the
// organization, membership, staff and functions of the Joint Committee on
// Taxation. The text is pinned whole (`sources.law`, generated from the
// shared Title 26 snapshot, `sync_us_irc_fragments.py --package
// joint-committee`); modules below formalize it.
//
// MODULE MAP
//   package.law                — shared ontology, imports, type aliases (this file)
//   01-organization.law        — chapter 91 (§§8001-8005): the Committee's
//                                 existence, membership, tenure, vacancies,
//                                 chairman/vice chairman, staff, expenses
//   02-powers-and-duties.law   — chapter 92 (§§8021-8023): hearing/subpoena/
//                                 printing/expenditure powers, GAO-request
//                                 review, investigation/report duties, the
//                                 data-exchange powers and duties with the IRS
//
// `us.irc.definitions` is a sibling package under construction; this stage
// does not depend on it — every classification this package needs (who is
// a "Person", what "Secretary" names) comes from `us.irc.core` directly.

language "law.core" version "0.2";
package us.irc.joint_committee version "0.1.1";
namespace "urn:us:irc:joint_committee:clir";

import us.irc.core version "0.1.1";

type Person = us.irc.core::Person;
type Organ = us.irc.core::Organ;
