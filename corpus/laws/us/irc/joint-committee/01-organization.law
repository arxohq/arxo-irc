// 26 U.S.C. Chapter 91 (§§8001-8005) — Organization and Membership of the
// Joint Committee: the Committee's existence, its ten members and their
// tenure, vacancies, the chairman/vice chairman, staff, and expenses.
//
// JUDGMENT CALLS (see report):
//  - §8002(a)'s "10 members ... 5+5, 3 majority/2 minority" is a sizing and
//    party-balance directive addressed to the two chamber committees doing
//    the choosing, not a per-person condition this package can test without
//    a full-roster count aggregate the grammar does not offer over case
//    facts; the two EXECUTABLE membership rules below capture the person-
//    level condition ("chosen by committee X, with standing st"), and the
//    numeric composition is recorded as an interpretive note on the
//    unnumbered lead-in row (26/8002/a/u1).
//  - §8002(b)'s general-limitation/exception pair is folded into the SAME
//    two membership rules as an `unless` defeater, rather than written as a
//    separate termination rule, to avoid two competing derivations of the
//    same `member_of_joint_committee` fact.
//  - §8002(d)'s reimbursement duty has no statutory deadline; its
//    `achievement` goal is left open-ended (`[-infinity, infinity]`), which
//    means it can be SATISFIED but never mechanically VIOLATED by mere
//    silence — consistent with §136 (no adjudication/negative fact, no
//    VIOLATED), but worth flagging: a bounded window is not available from
//    the text itself.

language "law.core" version "0.2";
package us.irc.joint_committee version "0.1.1";
namespace "urn:us:irc:joint_committee:clir";

use self::{
    IRC_S8001,
    IRC_S8002_A,
    IRC_S8002_C,
    IRC_S8002_D,
    IRC_S8003,
    IRC_S8004,
    IRC_S8005,
    Organ,
    Person,
};

// --- §8001: the Committee itself --------------------------------------------

const JointCommittee: Organ = entity_ref("urn:us:irc:joint_committee:clir#JointCommittee") {
    label en official "Joint Committee on Taxation";
}

// The two chamber committees that choose the Joint Committee's members
// (§8002(a)); named here because this package is the only owner that
// addresses them.
const SenateFinanceCommittee: Organ = entity_ref("urn:us:irc:joint_committee:clir#SenateFinanceCommittee") {
    label en official "Committee on Finance of the Senate";
}
const HouseWaysAndMeansCommittee: Organ = entity_ref("urn:us:irc:joint_committee:clir#HouseWaysAndMeansCommittee") {
    label en official "Committee on Ways and Means of the House of Representatives";
}
// §8021(e): the body whose IRS-investigation requests the Joint Committee
// reviews.
const GovernmentAccountabilityOffice: Organ = entity_ref("urn:us:irc:joint_committee:clir#GovernmentAccountabilityOffice") {
    label en official "Government Accountability Office";
}

relation is_joint_committee(o: Organ) kind institutional {
    label en unofficial "the organ is the Joint Committee on Taxation created by §8001";
}
@source(IRC_S8001, relation = formalizes, coverage = exact, quote = "There shall be a joint congressional committee known as the Joint Committee on Taxation")
assert is_joint_committee(JointCommittee);

// --- §8002(a)-(b): membership and tenure ------------------------------------

enum PartyStanding { Majority; Minority; }

relation chosen_member(p: Person, from: Organ, standing: PartyStanding) kind empirical {
    label en unofficial "the person was chosen by the named chamber committee to serve on the Joint Committee, with the given majority/minority standing";
}
relation ceased_committee_membership(p: Person, of: Organ) kind empirical {
    label en unofficial "the person has ceased to be a member of the chamber committee that chose them (§8002(b)(1)), including by the expiration of a Congress";
}
relation reelected_to_house_of_representatives(p: Person) kind empirical {
    label en unofficial "the person, chosen by the Committee on Ways and Means, has been reelected to the House of Representatives (§8002(b)(2) exception)";
}

relation member_of_joint_committee(p: Person) kind institutional {
    label en unofficial "the person is a currently serving member of the Joint Committee on Taxation";
}

// The unnumbered lead-in (26/8002/a/u1, "composed of 10 members as follows")
// and the "in the same manner as the original selection" vacancy-filling
// clause (26/8002/c/2/u1) are both covered by these same two rules: a
// vacancy is filled by a fresh `chosen_member` fact, which re-triggers the
// same membership derivation.
@source(IRC_S8002_A, relation = formalizes, coverage = partial, quote = "Five members who are members of the Committee on Finance of the Senate, three from the majority and two from the minority party, to be chosen by such Committee")
rule S8002FinanceMember defeasible {
    for p: Person;
    for st: PartyStanding;
    when chosen_member(p, SenateFinanceCommittee, st);
    then member_of_joint_committee(p);
    unless ceased_committee_membership(p, SenateFinanceCommittee);
}

@source(IRC_S8002_A, relation = formalizes, coverage = partial, quote = "Five members who are members of the Committee on Ways and Means of the House of Representatives, three from the majority and two from the minority party, to be chosen by such Committee")
rule S8002WaysAndMeansMember defeasible {
    for p: Person;
    for st: PartyStanding;
    when chosen_member(p, HouseWaysAndMeansCommittee, st);
    then member_of_joint_committee(p);
    unless ceased_committee_membership(p, HouseWaysAndMeansCommittee) and not reelected_to_house_of_representatives(p);
}

// --- §8002(c): vacancies -----------------------------------------------------

relation committee_functions_operative(o: Organ) kind institutional {
    label en unofficial "the Joint Committee's remaining members may execute its functions notwithstanding a vacancy";
}
@source(IRC_S8002_C, relation = formalizes, coverage = partial, quote = "Shall not affect the power of the remaining members to execute the functions of the Joint Committee")
rule S8002VacancyDoesNotSuspendFunctions strict {
    when is_joint_committee(JointCommittee);
    then committee_functions_operative(JointCommittee);
}

relation vacancy_during_recess_over_two_weeks(committee: Organ) kind empirical {
    label en unofficial "there is a vacancy the named chamber committee is entitled to fill, arising during an adjournment or recess of Congress for a period of more than 2 weeks";
}
relation interim_designation(committee: Organ, designee: Person) kind empirical {
    label en unofficial "the members of the entitled chamber committee designate the person to serve on the Joint Committee until a successor is chosen";
}
relation designee_is_member_of_committee(designee: Person, committee: Organ) kind empirical {
    label en unofficial "the designee is a member of the chamber committee entitled to fill the vacancy";
}

relation recess_vacancy_designation_valid(committee: Organ, designee: Person) kind institutional {
    label en unofficial "the recess-vacancy designation of the designee by the entitled committee meets §8002(c)(2)(A)'s conditions";
}
@source(IRC_S8002_C, relation = formalizes, coverage = partial, quote = "In case of a vacancy during an adjournment or recess of Congress for a period of more than 2 weeks, the members of the Joint Committee who are members of the Committee entitled to fill such vacancy may designate a member of such Committee to serve until his successor is chosen by such Committee")
rule S8002RecessVacancyDesignationValid strict {
    for committee: Organ;
    for designee: Person;
    when vacancy_during_recess_over_two_weeks(committee)
        and designee_is_member_of_committee(designee, committee);
    then recess_vacancy_designation_valid(committee, designee);
}

@source(IRC_S8002_C, relation = formalizes, coverage = partial, quote = "In case of a vacancy during an adjournment or recess of Congress for a period of more than 2 weeks, the members of the Joint Committee who are members of the Committee entitled to fill such vacancy may designate a member of such Committee to serve until his successor is chosen by such Committee")
rule S8002RecessVacancyDesignation strict {
    for committee: Organ;
    for designee: Person;
    when recess_vacancy_designation_valid(committee, designee);
    then power S8002RecessVacancyDesignationPower {
        holder committee;
        over designee;
        exercise interim_designation(committee, designee);
        valid_when recess_vacancy_designation_valid(committee, designee);
        effect create(member_of_joint_committee(designee));
    };
}

relation vacancy_after_congress_expiration(committee: Organ) kind empirical {
    label en unofficial "there is a vacancy, arising after the expiration of a Congress, that the Committee on Ways and Means would be entitled to fill";
}
relation previously_member_of_committee_and_reelected(designee: Person, committee: Organ) kind empirical {
    label en unofficial "the designee was, immediately prior to the expiration of the Congress, a member of the named chamber committee, and has been reelected to the House of Representatives (§8002(c)(2)(B))";
}

relation post_expiration_designation_valid(designee: Person) kind institutional {
    label en unofficial "the post-Congress-expiration designation of the designee by the continuing Ways and Means members meets §8002(c)(2)(B)'s conditions";
}
@source(IRC_S8002_C, relation = formalizes, coverage = partial, quote = "In the case of a vacancy after the expiration of a Congress which would be filled by the Committee on Ways and Means, the members of such Committee who are continuing to serve as members of the Joint Committee may designate a person who, immediately prior to such expiration, was a member of such Committee and who is re-elected to the House of Representatives, to serve until his successor is chosen by such Committee")
rule S8002PostExpirationDesignationValid strict {
    for designee: Person;
    when vacancy_after_congress_expiration(HouseWaysAndMeansCommittee)
        and previously_member_of_committee_and_reelected(designee, HouseWaysAndMeansCommittee);
    then post_expiration_designation_valid(designee);
}

@source(IRC_S8002_C, relation = formalizes, coverage = partial, quote = "In the case of a vacancy after the expiration of a Congress which would be filled by the Committee on Ways and Means, the members of such Committee who are continuing to serve as members of the Joint Committee may designate a person who, immediately prior to such expiration, was a member of such Committee and who is re-elected to the House of Representatives, to serve until his successor is chosen by such Committee")
rule S8002PostExpirationWaysAndMeansDesignation strict {
    for designee: Person;
    when post_expiration_designation_valid(designee);
    then power S8002PostExpirationWaysAndMeansDesignationPower {
        holder HouseWaysAndMeansCommittee;
        over designee;
        exercise interim_designation(HouseWaysAndMeansCommittee, designee);
        valid_when post_expiration_designation_valid(designee);
        effect create(member_of_joint_committee(designee));
    };
}

// --- §8002(d): allowances -----------------------------------------------------

relation pays_additional_compensation(m: Person) kind empirical {
    label en unofficial "the person is paid compensation, for Joint Committee service, in addition to compensation received as a Member of Congress";
}
@source(IRC_S8002_D, relation = formalizes, coverage = partial, quote = "The members shall serve without compensation in addition to that received for their services as members of Congress")
rule S8002NoAdditionalCompensation strict {
    for m: Person;
    when member_of_joint_committee(m);
    then prohibition NoAdditionalCompensation {
        bearer JointCommittee;
        beneficiary m;
        action pays_additional_compensation(m);
        window [-infinity, infinity];
    };
}

relation member_reimbursed(m: Person) kind empirical {
    label en unofficial "the member has been reimbursed for travel, subsistence, and other necessary expenses incurred performing Joint Committee duties";
}
relation meeting_in_dc_during_session(m: Person) kind empirical {
    label en unofficial "the expense is connected with a Joint Committee meeting held in the District of Columbia while Congress is in session (excluded by §8002(d))";
}
@source(IRC_S8002_D, relation = formalizes, coverage = partial, quote = "they shall be reimbursed for travel, subsistence, and other necessary expenses incurred by them in the performance of the duties vested in the Joint Committee")
rule S8002ReimburseMemberExpenses defeasible {
    for m: Person;
    when member_of_joint_committee(m);
    then duty ReimburseMemberExpenses {
        bearer JointCommittee;
        beneficiary m;
        goal achievement {
            condition member_reimbursed(m);
            window [-infinity, infinity];
        }
    };
    unless meeting_in_dc_during_session(m);
}

// --- §8003: chairman and vice chairman ---------------------------------------

relation is_chairman(committee: Organ, p: Person) kind institutional {
    label en unofficial "the person is the chairman of the Joint Committee";
}
relation is_vice_chairman(committee: Organ, p: Person) kind institutional {
    label en unofficial "the person is the vice chairman of the Joint Committee";
}
relation elects_chairman(committee: Organ, p: Person) kind empirical;
relation elects_vice_chairman(committee: Organ, p: Person) kind empirical;

@source(IRC_S8003, relation = formalizes, coverage = exact, quote = "The Joint Committee shall elect a chairman and vice chairman from among its members.")
rule S8003ElectChairman strict {
    for p: Person;
    when elects_chairman(JointCommittee, p);
    then power S8003ElectChairmanPower {
        holder JointCommittee;
        over p;
        exercise elects_chairman(JointCommittee, p);
        valid_when member_of_joint_committee(p);
        effect create(is_chairman(JointCommittee, p));
    };
}

@source(IRC_S8003, relation = formalizes, coverage = exact, quote = "The Joint Committee shall elect a chairman and vice chairman from among its members.")
rule S8003ElectViceChairman strict {
    for p: Person;
    when elects_vice_chairman(JointCommittee, p);
    then power S8003ElectViceChairmanPower {
        holder JointCommittee;
        over p;
        exercise elects_vice_chairman(JointCommittee, p);
        valid_when member_of_joint_committee(p);
        effect create(is_vice_chairman(JointCommittee, p));
    };
}

// --- §8004: staff --------------------------------------------------------------

enum StaffPositionKind { ChiefOfStaff; Expert; ClericalAssistant; StenographicAssistant; OtherAssistant; }

relation appoints_staff(committee: Organ, kind: StaffPositionKind, p: Person) kind empirical {
    label en unofficial "the Joint Committee appoints the person to the named staff position and fixes their compensation";
}
relation staff_appointment_otherwise_provided_by_law(committee: Organ, kind: StaffPositionKind) kind empirical {
    label en unofficial "another statute otherwise provides for the appointment or compensation of this staff position (§8004's own exception 'Except as otherwise provided by law')";
}
relation appointed(committee: Organ, kind: StaffPositionKind, p: Person) kind institutional {
    label en unofficial "the person has been validly appointed to the named Joint Committee staff position";
}
relation is_chief_of_staff(p: Person) kind institutional {
    label en unofficial "the person currently holds the office of Chief of Staff of the Joint Committee";
}

relation staff_appointment_not_otherwise_provided_by_law(committee: Organ, kind: StaffPositionKind) kind institutional {
    label en unofficial "no other statute provides for the appointment or compensation of this staff position (the negative of §8004's own exception)";
}
@source(IRC_S8004, relation = formalizes, coverage = partial, quote = "Except as otherwise provided by law")
rule S8004StaffAppointmentNotOtherwiseProvided strict {
    for kind: StaffPositionKind;
    for p: Person;
    when appoints_staff(JointCommittee, kind, p) and not staff_appointment_otherwise_provided_by_law(JointCommittee, kind);
    then staff_appointment_not_otherwise_provided_by_law(JointCommittee, kind);
}

@source(IRC_S8004, relation = formalizes, coverage = exact, quote = "Except as otherwise provided by law, the Joint Committee shall have power to appoint and fix the compensation of the Chief of Staff of the Joint Committee and such experts and clerical, stenographic, and other assistants as it deems advisable.")
rule S8004AppointAndFixCompensationOfStaff strict {
    for kind: StaffPositionKind;
    for p: Person;
    when appoints_staff(JointCommittee, kind, p);
    then power S8004AppointStaffPower {
        holder JointCommittee;
        over p;
        exercise appoints_staff(JointCommittee, kind, p);
        valid_when staff_appointment_not_otherwise_provided_by_law(JointCommittee, kind);
        effect create(appointed(JointCommittee, kind, p));
    };
}

@source(IRC_S8004, relation = formalizes, coverage = partial, quote = "the Chief of Staff of the Joint Committee")
rule S8004DerivesChiefOfStaff strict {
    for p: Person;
    when appointed(JointCommittee, ChiefOfStaff, p);
    then is_chief_of_staff(p);
}

// --- §8005: expenses -------------------------------------------------------------

const SenateContingentFund: Organ = entity_ref("urn:us:irc:joint_committee:clir#SenateContingentFund") {
    label en official "the contingent fund of the Senate";
}
const HouseContingentFund: Organ = entity_ref("urn:us:irc:joint_committee:clir#HouseContingentFund") {
    label en official "the contingent fund of the House of Representatives";
}

entity JointCommitteeExpense { label en unofficial "an expense of the Joint Committee to be paid under §8005"; }

relation voucher_signed_by(e: JointCommitteeExpense, signer: Person) kind empirical {
    label en unofficial "the payment voucher for the expense is signed by the person";
}
relation signer_is_chair_or_vice_chair(signer: Person) kind institutional {
    label en unofficial "the signer is the chairman or the vice chairman of the Joint Committee";
}
@source(IRC_S8005, relation = formalizes, coverage = partial, quote = "signed by the chairman or the vice chairman")
rule S8005SignerIsChairOrViceChair strict {
    for signer: Person;
    when is_chairman(JointCommittee, signer);
    then signer_is_chair_or_vice_chair(signer);
}
@source(IRC_S8005, relation = formalizes, coverage = partial, quote = "signed by the chairman or the vice chairman")
rule S8005SignerIsViceChair strict {
    for signer: Person;
    when is_vice_chairman(JointCommittee, signer);
    then signer_is_chair_or_vice_chair(signer);
}

relation expense_authorized(e: JointCommitteeExpense) kind institutional {
    label en unofficial "the expense's payment voucher has been validly signed and the expense may be paid";
}
@source(IRC_S8005, relation = formalizes, coverage = partial, quote = "upon vouchers signed by the chairman or the vice chairman")
rule S8005AuthorizePayment strict {
    for e: JointCommitteeExpense;
    for signer: Person;
    when voucher_signed_by(e, signer);
    then power S8005AuthorizePaymentPower {
        holder signer;
        over e;
        exercise voucher_signed_by(e, signer);
        valid_when signer_is_chair_or_vice_chair(signer);
        effect create(expense_authorized(e));
    };
}

relation paid_from(e: JointCommitteeExpense, fund: Organ, share: Decimal) kind institutional {
    label en unofficial "the fraction of the expense paid from the named fund";
}
@source(IRC_S8005, relation = formalizes, coverage = partial, quote = "The expenses of the Joint Committee shall be paid one-half from the contingent fund of the Senate and one-half from the contingent fund of the House of Representatives")
rule S8005HalfFromSenate strict {
    for e: JointCommitteeExpense;
    when expense_authorized(e);
    then paid_from(e, SenateContingentFund, 0.5);
}
@source(IRC_S8005, relation = formalizes, coverage = partial, quote = "The expenses of the Joint Committee shall be paid one-half from the contingent fund of the Senate and one-half from the contingent fund of the House of Representatives")
rule S8005HalfFromHouse strict {
    for e: JointCommitteeExpense;
    when expense_authorized(e);
    then paid_from(e, HouseContingentFund, 0.5);
}
