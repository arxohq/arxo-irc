// Subchapter C, part I — §7442 (jurisdiction of the Tax Court); §7454(a),(b)
// (burden of proof: fraud, foundation managers). Subchapter G — §7491(a)-(c)
// (burden of proof: credible evidence, statistical reconstruction, penalty
// production burden).
//
// METHOD NOTE (§7442): a broad, self-referential jurisdictional grant
// ("such jurisdiction as is conferred ... by this title ... or by laws
// enacted subsequent to February 26, 1926") with no closed testable
// condition of its own — modeled as a narrow institutional_effect keyed to
// "a proceeding is properly before the Tax Court under some provision of
// this title", which every other module's own petition/proceeding rules
// already establish; §7442 itself supplies no additional fact a case could
// assert beyond that. The historical statute cross-references (1939 Code,
// Revenue Act of 1926) are NON_NORMATIVE (dead cross-references to repealed
// law, not independently testable).
//
// METHOD NOTE (§7454): both (a) and (b) allocate the burden of proof on a
// named issue to the Secretary — modeled as institutional_effect relations
// keyed to the proceeding and the issue, not as a `power` or `immunity`
// (the statute does not grant or protect anything; it allocates who must
// persuade). "Guilty of fraud with intent to evade tax" and "knowingly"
// participated in self-dealing/jeopardizing investments/taxable
// expenditures are the ultimate ADJUDICATED issues the burden allocation is
// ABOUT, not themselves modeled as `external judgment relation`s here
// (that would be circular: the burden rule fires on the proceeding raising
// the issue, not on its outcome).
//
// METHOD NOTE (§7491): (a) is the paradigm DECISION-0194 evaluative
// element — "credible evidence" is channeled as an `external judgment
// relation` with authority the court (the statute's own forum), gated by
// the substantiation/record-keeping/cooperation conditions of (a)(2) and
// the (a)(2)(C) entity-size gate cross-referencing §7430(c)(4)(A)(ii)
// (imported from `04-costs-and-damages.law`'s `net_worth_within_limit`,
// same package). (b) and (c) are flat institutional_effect allocations
// with no evaluative gate.
//
// JUDGMENT CALLS AND GAPS:
//  - §7491(a)(3)'s "coordination" clause (no burden shift where another
//    provision of the title states its own burden of proof) is modeled as
//    an `unless` naming the two burdens this package itself already states
//    (§7454(a)/(b), §7429(g)) as the closed set of "other provision" cases
//    within this package's scope; a title-wide closed list is not
//    achievable without surveying every other owner package, so the
//    `unless` is necessarily partial — flagged INTERPRETATION/scope
//    limitation, not silently treated as complete.
//  - §7491(a)(2)(C)'s qualified-revocable-trust carve-out is modeled as a
//    typed dependency (`us.irc.definitions`'s §645(b) trust classification
//    is not yet exposed) rather than invented.

language "law.core" version "0.2";
package us.irc.judicial_proceedings version "0.1.1";
namespace "urn:us:irc:judicial_proceedings:clir";

use self::{
    IRC_S7442,
    IRC_S7454_A,
    IRC_S7454_B,
    IRC_S7491_A,
    IRC_S7491_B,
    IRC_S7491_C,
    Individual,
    Person,
    Proceeding,
    TaxableYear,
    net_worth_within_limit,
};


// ============================================================================
// §7442 — Jurisdiction
// ============================================================================

pub relation proceeding_within_title_26_jurisdiction(pr: Proceeding) kind empirical {
    label en unofficial "the proceeding is instituted under a jurisdiction-conferring provision of this title (case-input classification; every petition-power rule elsewhere in this package or in us.irc.assessment establishes this for its own proceeding)";
}
pub relation tax_court_has_jurisdiction(pr: Proceeding) kind institutional;
@source(IRC_S7442, relation = formalizes, coverage = exact, quote = "The Tax Court and its divisions shall have such jurisdiction as is conferred on them by this title, by chapters 1, 2, 3, and 4 of the Internal Revenue Code of 1939, by title II and title III of the Revenue Act of 1926 (44 Stat. 10–87), or by laws enacted subsequent to February 26, 1926.")
pub rule S7442TaxCourtJurisdiction strict {
    label en official "The Tax Court and its divisions shall have such jurisdiction as is conferred on them by this title, by chapters 1, 2, 3, and 4 of the Internal Revenue Code of 1939, by title II and title III of the Revenue Act of 1926 (44 Stat. 10–87), or by laws enacted subsequent to February 26, 1926.";
    for pr: Proceeding;
    when proceeding_within_title_26_jurisdiction(pr);
    then tax_court_has_jurisdiction(pr);
}

// ============================================================================
// §7454(a) — Burden of proof: fraud
// ============================================================================

pub relation fraud_issue_raised(pr: Proceeding, p: Person) kind empirical {
    label en official "a proceeding involves the issue whether the petitioner has been guilty of fraud with intent to evade tax";
}
pub relation fraud_burden_on_secretary(pr: Proceeding, p: Person) kind institutional;
@source(IRC_S7454_A, relation = formalizes, coverage = exact, quote = "In any proceeding involving the issue whether the petitioner has been guilty of fraud with intent to evade tax, the burden of proof in respect of such issue shall be upon the Secretary.")
pub rule S7454FraudBurdenOnSecretary strict {
    label en official "In any proceeding involving the issue whether the petitioner has been guilty of fraud with intent to evade tax, the burden of proof in respect of such issue shall be upon the Secretary.";
    for pr: Proceeding;
    for p: Person;
    when fraud_issue_raised(pr, p);
    then fraud_burden_on_secretary(pr, p);
}

// ============================================================================
// §7454(b) — Burden of proof: foundation managers / organization managers
// ============================================================================

pub relation foundation_manager_knowing_participation_issue_raised(pr: Proceeding, manager: Person) kind empirical {
    label en unofficial "a proceeding involves the issue whether a foundation manager (§4946(b)) has 'knowingly' participated in self-dealing (§4941), a jeopardizing investment (§4944), or agreed to a taxable expenditure (§4945); or the parallel §501(c)(21) trustee (§§4951-4952), political-expenditure (§4955), lobbying-expenditure (§4912), or excess-benefit-transaction (§4958) organization-manager issues";
}
pub relation foundation_manager_burden_on_secretary(pr: Proceeding, manager: Person) kind institutional;
@source(IRC_S7454_B, relation = formalizes, coverage = exact, quote = "In any proceeding involving the issue whether a foundation manager (as defined in section 4946(b)) has \"knowingly\" participated in an act of self-dealing (within the meaning of section 4941), participated in an investment which jeopardizes the carrying out of exempt purposes (within the meaning of section 4944), or agreed to the making of a taxable expenditure (within the meaning of section 4945), or whether the trustee of a trust described in section 501(c)(21) has \"knowingly\" participated in an act of self-dealing (within the meaning of section 4951) or agreed to the making of a taxable expenditure (within the meaning of section 4952), or whether an organization manager (as defined in section 4955(f)(2)) has \"knowingly\" agreed to the making of a political expenditure (within the meaning of section 4955), or whether an organization manager (as defined in section 4912(d)(2)) has \"knowingly\" agreed to the making of disqualifying lobbying expenditures within the meaning of section 4912(b), or whether an organization manager (as defined in section 4958(f)(2)) has \"knowingly\" participated in an excess benefit transaction (as defined in section 4958(c)), the burden of proof in respect of such issue shall be upon the Secretary.")
pub rule S7454FoundationManagerBurdenOnSecretary strict {
    label en official "In any proceeding involving the issue whether a foundation manager (as defined in section 4946(b)) has \"knowingly\" participated in an act of self-dealing (within the meaning of section 4941), participated in an investment which jeopardizes the carrying out of exempt purposes (within the meaning of section 4944), or agreed to the making of a taxable expenditure (within the meaning of section 4945), or whether the trustee of a trust described in section 501(c)(21) has \"knowingly\" participated in an act of self-dealing (within the meaning of section 4951) or agreed to the making of a taxable expenditure (within the meaning of section 4952), or whether an organization manager (as defined in section 4955(f)(2)) has \"knowingly\" agreed to the making of a political expenditure (within the meaning of section 4955), or whether an organization manager (as defined in section 4912(d)(2)) has \"knowingly\" agreed to the making of disqualifying lobbying expenditures within the meaning of section 4912(b), or whether an organization manager (as defined in section 4958(f)(2)) has \"knowingly\" participated in an excess benefit transaction (as defined in section 4958(c)), the burden of proof in respect of such issue shall be upon the Secretary.";
    for pr: Proceeding;
    for manager: Person;
    when foundation_manager_knowing_participation_issue_raised(pr, manager);
    then foundation_manager_burden_on_secretary(pr, manager);
}

// ============================================================================
// §7491(a) — Burden shifts where taxpayer produces credible evidence
// ============================================================================

external judgment relation credible_evidence_introduced(pr: Proceeding, p: Person, issue: Person) {
    authority TaxCourt;
    label en official "the taxpayer introduces credible evidence with respect to any factual issue relevant to ascertaining the liability of the taxpayer for any tax imposed by subtitle A or B";
}
pub relation substantiation_requirements_complied(p: Person) kind empirical {
    label en official "the taxpayer has complied with the requirements under this title to substantiate any item";
}
pub relation records_maintained_and_cooperated(p: Person) kind empirical {
    label en official "the taxpayer has maintained all records required under this title and has cooperated with reasonable requests by the Secretary for witnesses, information, documents, meetings, and interviews";
}
pub relation entity_size_gate_met(p: Person) kind institutional {
    label en unofficial "for a partnership, corporation, or trust, the taxpayer is described in §7430(c)(4)(A)(ii) (the net-worth eligibility test) — imported from 04-costs-and-damages.law's net_worth_within_limit, same package";
}
@source(IRC_S7491_A, relation = applies, coverage = contextual, quote = "in the case of a partnership, corporation, or trust, the taxpayer is described in section 7430(c)(4)(A)(ii)")
pub rule S7491EntitySizeGate strict {
    label en official "in the case of a partnership, corporation, or trust, the taxpayer is described in section 7430(c)(4)(A)(ii)";
    for p: Person;
    when net_worth_within_limit(p);
    then entity_size_gate_met(p);
}
pub relation burden_shift_other_provision_applies(pr: Proceeding, p: Person, issue: Person) kind institutional {
    label en unofficial "another provision of this title provides for a specific burden of proof with respect to this issue (§7491(a)(3)) — this package's own closed instances: §7454(a) fraud, §7454(b) foundation-manager knowing participation, §7429(g) jeopardy reasonableness/amount; a title-wide survey of every other owner package's own burden allocations is out of this package's scope (INTERPRETATION/scope limitation)";
}
pub relation general_burden_on_secretary(pr: Proceeding, p: Person, issue: Person) kind institutional;
@source(IRC_S7491_A, relation = formalizes, coverage = exact, quote = "If, in any court proceeding, a taxpayer introduces credible evidence with respect to any factual issue relevant to ascertaining the liability of the taxpayer for any tax imposed by subtitle A or B, the Secretary shall have the burden of proof with respect to such issue.")
pub rule S7491GeneralBurdenShift defeasible {
    label en official "If, in any court proceeding, a taxpayer introduces credible evidence with respect to any factual issue relevant to ascertaining the liability of the taxpayer for any tax imposed by subtitle A or B, the Secretary shall have the burden of proof with respect to such issue.";
    for pr: Proceeding;
    for p: Person;
    for issue: Person;
    when credible_evidence_introduced(pr, p, issue)
        and substantiation_requirements_complied(p)
        and records_maintained_and_cooperated(p);
    then general_burden_on_secretary(pr, p, issue);
    unless burden_shift_other_provision_applies(pr, p, issue) and credible_evidence_introduced(pr, p, issue) and substantiation_requirements_complied(p) and records_maintained_and_cooperated(p);
}
@source(IRC_S7491_A, relation = formalizes, coverage = exact, quote = "in the case of a partnership, corporation, or trust, the taxpayer is described in section 7430(c)(4)(A)(ii)")
pub rule S7491GeneralBurdenShiftEntity defeasible {
    label en official "in the case of a partnership, corporation, or trust, the taxpayer is described in section 7430(c)(4)(A)(ii)";
    for pr: Proceeding;
    for p: Person;
    for issue: Person;
    when credible_evidence_introduced(pr, p, issue)
        and substantiation_requirements_complied(p)
        and records_maintained_and_cooperated(p)
        and entity_size_gate_met(p);
    then general_burden_on_secretary(pr, p, issue);
    unless burden_shift_other_provision_applies(pr, p, issue) and credible_evidence_introduced(pr, p, issue) and substantiation_requirements_complied(p) and records_maintained_and_cooperated(p) and entity_size_gate_met(p);
}

// ============================================================================
// §7491(b) — Use of statistical information on unrelated taxpayers
// ============================================================================

pub relation income_item_reconstructed_by_statistics(p: Person, y: TaxableYear, issue: Person) kind empirical {
    label en official "an item of income which was reconstructed by the Secretary solely through the use of statistical information on unrelated taxpayers";
}
pub relation statistical_reconstruction_burden_on_secretary(p: Person, y: TaxableYear, issue: Person) kind institutional;
@source(IRC_S7491_B, relation = formalizes, coverage = exact, quote = "In the case of an individual taxpayer, the Secretary shall have the burden of proof in any court proceeding with respect to any item of income which was reconstructed by the Secretary solely through the use of statistical information on unrelated taxpayers.")
pub rule S7491StatisticalReconstructionBurden strict {
    label en official "In the case of an individual taxpayer, the Secretary shall have the burden of proof in any court proceeding with respect to any item of income which was reconstructed by the Secretary solely through the use of statistical information on unrelated taxpayers.";
    for p: Individual;
    for y: TaxableYear;
    for issue: Person;
    when income_item_reconstructed_by_statistics(p, y, issue);
    then statistical_reconstruction_burden_on_secretary(p, y, issue);
}

// ============================================================================
// §7491(c) — Penalties: burden of production
// ============================================================================

pub relation penalty_liability_at_issue(p: Individual, penalty: Person) kind empirical {
    label en official "the liability of any individual for any penalty, addition to tax, or additional amount imposed by this title";
}
pub relation penalty_production_burden_on_secretary(p: Individual, penalty: Person) kind institutional;
@source(IRC_S7491_C, relation = formalizes, coverage = exact, quote = "Notwithstanding any other provision of this title, the Secretary shall have the burden of production in any court proceeding with respect to the liability of any individual for any penalty, addition to tax, or additional amount imposed by this title.")
pub rule S7491PenaltyProductionBurden strict {
    label en official "Notwithstanding any other provision of this title, the Secretary shall have the burden of production in any court proceeding with respect to the liability of any individual for any penalty, addition to tax, or additional amount imposed by this title.";
    for p: Individual;
    for penalty: Person;
    when penalty_liability_at_issue(p, penalty);
    then penalty_production_burden_on_secretary(p, penalty);
}
