// Stage 2 — subchapter C, parts II-III (organization): §7441 (status),
// §7443 (judges), §7443A (special trial judges), §7443B (repealed), §7444
// (organization), §7445 (offices), §7446 (sessions), §7447 (judges'
// retirement), §7447A (special trial judges' retirement).
//
// METHOD NOTE. Judges and special trial judges are `Individual`s. The two
// offices share one vocabulary keyed by `JudicialOffice`: the age/service
// table of §7447(b)(2) and §7447A(a)(1) is identical; retired pay differs
// by the divisor (10 for judges, 15 for special trial judges). Powers of
// the President (appointment, removal, disability retirement) are POWERS
// of the `President` organ whose `valid_when` folds the statutory
// conditions; "shall retire" / "shall receive" are DUTIES. The mandatory
// retirement at 70 is a duty with a point window (the day the age is
// attained). "Solely on the grounds of fitness" and the President's
// findings under §7447(h)(2) are DECISION-0194 judgments with the
// appointing / finding authority named.
//
// MONEY. The salary of a Tax Court judge is "the same rate as judges of
// the district courts" (28 U.S.C. 135, outside Title 26): the rate is a
// typed input (`district_judge_salary_rate`). The special trial judge's
// 90 percent is `round(rate * 90 percent, 2, "HALF_UP")` (the statute
// names no rounding; cents HALF_UP is the corpus convention — JUDGMENT
// CALL). A ratio of years to 10 (or 15) is an exact Rational
// (`salary * (n / 10)`), rounded once to cents.
//
// JUDGMENT CALLS AND GAPS. (i) Length of service as the union of periods
// "whether or not consecutive" (§7447(a)(3), §7447A(a)(2)) needs a
// date-difference over a set of periods; the whole-years and fractional
// months are typed inputs (TECH-GAPS G2905). (ii) "The 1st day of the 1st
// month following the month in which the election is made" (§7447(f)(4)(C))
// needs first-of-month arithmetic (G2906). (iii) The counting of members
// for §7443(a) is over the asserted roster `member_of_tax_court`; that
// recalled judges are not counted is a roster property, not a derived
// exclusion (aggregate over a derived relation is a §111 subset limit).
// (iv) Compound interest at 3 percent on December 31 (§7447(i)(3)(B)) is
// recorded at module 14 (G2907).

language "law.core" version "0.2";
package us.irc.judicial_proceedings version "0.1.1";
namespace "urn:us:irc:judicial_proceedings:clir";

use self::{
    DeclaratoryRemedy,
    IRC_S7441,
    IRC_S7443A_A,
    IRC_S7443A_B,
    IRC_S7443A_C,
    IRC_S7443A_D,
    IRC_S7443A_E,
    IRC_S7443_A,
    IRC_S7443_B,
    IRC_S7443_C,
    IRC_S7443_D,
    IRC_S7443_E,
    IRC_S7443_F,
    IRC_S7443_G,
    IRC_S7444_A,
    IRC_S7444_B,
    IRC_S7444_C,
    IRC_S7444_D,
    IRC_S7445,
    IRC_S7446,
    IRC_S7447A_A,
    IRC_S7447A_B,
    IRC_S7447A_C,
    IRC_S7447A_D,
    IRC_S7447A_E,
    IRC_S7447_A,
    IRC_S7447_B,
    IRC_S7447_C,
    IRC_S7447_D,
    IRC_S7447_E,
    IRC_S7447_F,
    IRC_S7447_G,
    IRC_S7447_H,
    IRC_S7447_I,
    IRC_S7447_J,
    IRC_S7447_K,
    IRC_S7447_TABLE_1,
    Individual,
    Organ,
    Person,
    Proceeding,
    TaxableYear,
    declaratory_controversy,
    deficiency_placed_in_dispute,
    employment_status_small_case_procedure_applies,
    overpayment_claimed,
    small_case_procedure_applies,
    years_of_service_for_rules,
};

const President: Organ = entity_ref("urn:us:irc:judicial_proceedings:clir#President") {
    label en unofficial "the President of the United States";
}
const Congress: Organ = us.irc.core::Congress;
const OfficeOfPersonnelManagement: Organ = entity_ref("urn:us:irc:judicial_proceedings:clir#OfficeOfPersonnelManagement") {
    label en official "the Office of Personnel Management";
}

pub enum JudicialOffice {
    TaxCourtJudgeOffice;
    SpecialTrialJudgeOffice;
}

// ============================================================================
// §7441 — Status of the Tax Court
// ============================================================================

pub relation court_established_under_article_I(court: Organ) kind institutional;
pub relation court_of_record(court: Organ) kind institutional;
pub relation court_independent_of_executive_branch(court: Organ) kind institutional;
@source(IRC_S7441, relation = formalizes, coverage = exact, quote = "There is hereby established, under article I of the Constitution of the United States, a court of record to be known as the United States Tax Court.")
rule S7441Established strict {
    label en official "There is hereby established, under article I of the Constitution of the United States, a court of record to be known as the United States Tax Court.";
    then court_established_under_article_I(us.irc.core::TaxCourt);
}
@source(IRC_S7441, relation = formalizes, coverage = exact, quote = "There is hereby established, under article I of the Constitution of the United States, a court of record to be known as the United States Tax Court.")
rule S7441CourtOfRecord strict {
    label en official "There is hereby established, under article I of the Constitution of the United States, a court of record to be known as the United States Tax Court.";
    then court_of_record(us.irc.core::TaxCourt);
}
@source(IRC_S7441, relation = formalizes, coverage = exact, quote = "The Tax Court is not an agency of, and shall be independent of, the executive branch of the Government.")
rule S7441Independent strict {
    label en official "The Tax Court is not an agency of, and shall be independent of, the executive branch of the Government.";
    then court_independent_of_executive_branch(us.irc.core::TaxCourt);
}
pub relation executive_branch_directs_tax_court_decision(pr: Proceeding) kind empirical {
    label en unofficial "an organ of the executive branch directs or controls the Tax Court's decision in the proceeding";
}
@source(IRC_S7441, relation = formalizes, coverage = exact, quote = "The Tax Court is not an agency of, and shall be independent of, the executive branch of the Government.")
pub rule S7441IndependenceImmunityRule strict {
    label en official "The Tax Court is not an agency of, and shall be independent of, the executive branch of the Government.";
    for pr: Proceeding;
    when court_independent_of_executive_branch(us.irc.core::TaxCourt)
        and tax_court_proceeding_pending(pr);
    then immunity S7441IndependenceImmunity {
        holder us.irc.core::TaxCourt;
        protected_effect executive_branch_directs_tax_court_decision(pr);
        window [-infinity, infinity];
    };
}
pub relation tax_court_proceeding_pending(pr: Proceeding) kind empirical;

// ============================================================================
// §7443 — Judges
// ============================================================================

pub relation member_of_tax_court(j: Individual) kind empirical {
    label en official "The members of the Tax Court shall be the chief judge and the judges of the Tax Court";
}
pub relation tax_court_has_statutory_number_of_members(court: Organ) kind institutional;
@source(IRC_S7443_A, relation = formalizes, coverage = exact, quote = "The Tax Court shall be composed of 19 members.")
pub rule S7443aNineteenMembers strict {
    label en official "The Tax Court shall be composed of 19 members.";
    for court: Organ;
    when count(collect j: Individual where member_of_tax_court(j)) == 19;
    then tax_court_has_statutory_number_of_members(us.irc.core::TaxCourt);
}
external judgment relation appointment_solely_on_grounds_of_fitness(j: Individual) {
    authority Congress;
    label en official "solely on the grounds of fitness to perform the duties of the office";
}
pub relation senate_advice_and_consent_given(j: Individual) kind empirical {
    label en official "by and with the advice and consent of the Senate";
}
pub relation appointment_conditions_met(j: Individual) kind institutional;
@source(IRC_S7443_B, relation = formalizes, coverage = exact, quote = "Judges of the Tax Court shall be appointed by the President, by and with the advice and consent of the Senate, solely on the grounds of fitness to perform the duties of the office.")
pub rule S7443bConditions defeasible {
    label en official "Judges of the Tax Court shall be appointed by the President, by and with the advice and consent of the Senate, solely on the grounds of fitness to perform the duties of the office.";
    for j: Individual;
    when senate_advice_and_consent_given(j)
        and appointment_solely_on_grounds_of_fitness(j);
    then appointment_conditions_met(j);
}
pub relation president_appoints_judge_on(j: Individual, on: Date) kind empirical;
pub relation judge_takes_office_on(j: Individual, on: Date) kind empirical;
pub relation judge_appointed(j: Individual, on: Date) kind institutional;
@source(IRC_S7443_B, relation = formalizes, coverage = exact, quote = "Judges of the Tax Court shall be appointed by the President, by and with the advice and consent of the Senate, solely on the grounds of fitness to perform the duties of the office.")
pub rule S7443bAppointmentPowerRule defeasible {
    label en official "Judges of the Tax Court shall be appointed by the President, by and with the advice and consent of the Senate, solely on the grounds of fitness to perform the duties of the office.";
    for j: Individual;
    for on: Date;
    when president_appoints_judge_on(j, on);
    then power S7443bAppointJudge {
        holder President;
        over j;
        exercise president_appoints_judge_on(j, on);
        valid_when appointment_conditions_met(j);
        effect judge_appointed(j, on);
    };
}
pub relation district_judge_salary_rate(amount: Money) kind empirical {
    label en official "the rate of salary of judges of the district courts of the United States (28 U.S.C. 135)";
}
pub relation judicial_salary_rate(office: JudicialOffice, amount: Money) kind institutional {
    label en unofficial "the salary rate of the office: a Tax Court judge as a district judge (§7443(c)(1)); a special trial judge at 90 percent of a judge (§7443A(d)(1))";
}
@source(IRC_S7443_C, relation = formalizes, coverage = exact, quote = "Each judge shall receive salary at the same rate and in the same installments as judges of the district courts of the United States.")
pub rule S7443cJudgeSalaryRate strict {
    label en official "Each judge shall receive salary at the same rate and in the same installments as judges of the district courts of the United States.";
    for amount: Money;
    when district_judge_salary_rate(amount);
    then judicial_salary_rate(TaxCourtJudgeOffice, amount);
}
@source(IRC_S7443A_D, relation = formalizes, coverage = exact, quote = "at a rate equal to 90 percent of the rate for judges of the Tax Court, and")
pub rule S7443AdSpecialTrialJudgeSalaryRate strict {
    label en official "at a rate equal to 90 percent of the rate for judges of the Tax Court, and";
    for amount: Money;
    when district_judge_salary_rate(amount);
    then judicial_salary_rate(SpecialTrialJudgeOffice, round(amount * 90 percent, 2, "HALF_UP"));
}
pub relation judge_salary_installments_same_as_district_judges(office: JudicialOffice) kind institutional;
@source(IRC_S7443_C, relation = formalizes, coverage = exact, quote = "Each judge shall receive salary at the same rate and in the same installments as judges of the district courts of the United States.")
rule S7443cJudgeInstallments strict {
    label en official "Each judge shall receive salary at the same rate and in the same installments as judges of the district courts of the United States.";
    then judge_salary_installments_same_as_district_judges(TaxCourtJudgeOffice);
}
@source(IRC_S7443A_D, relation = formalizes, coverage = exact, quote = "in the same installments as such judges.")
rule S7443AdStjInstallments strict {
    label en official "in the same installments as such judges.";
    then judge_salary_installments_same_as_district_judges(SpecialTrialJudgeOffice);
}
pub relation traveling_expenses_incurred(j: Individual, actual: Money) kind empirical {
    label en official "necessary traveling expenses, and expenses actually incurred for subsistence while traveling on duty and away from their designated stations";
}
pub relation court_of_international_trade_expense_limit(limit: Money) kind empirical {
    label en official "the same limitations in amount as are now or may hereafter be applicable to the United States Court of International Trade";
}
pub relation reimbursable_travel_expenses(j: Individual, amount: Money) kind institutional;
@source(IRC_S7443_D, relation = formalizes, coverage = exact, quote = "Judges of the Tax Court shall receive necessary traveling expenses, and expenses actually incurred for subsistence while traveling on duty and away from their designated stations, subject to the same limitations in amount as are now or may hereafter be applicable to the United States Court of International Trade.")
pub rule S7443dReimbursableWithinLimit strict {
    label en official "Judges of the Tax Court shall receive necessary traveling expenses, and expenses actually incurred for subsistence while traveling on duty and away from their designated stations, subject to the same limitations in amount as are now or may hereafter be applicable to the United States Court of International Trade.";
    for j: Individual;
    for actual: Money;
    for limit: Money;
    when traveling_expenses_incurred(j, actual)
        and court_of_international_trade_expense_limit(limit)
        and actual <= limit;
    then reimbursable_travel_expenses(j, actual);
}
@source(IRC_S7443_D, relation = formalizes, coverage = exact, quote = "Judges of the Tax Court shall receive necessary traveling expenses, and expenses actually incurred for subsistence while traveling on duty and away from their designated stations, subject to the same limitations in amount as are now or may hereafter be applicable to the United States Court of International Trade.")
pub rule S7443dReimbursableCapped strict {
    label en official "Judges of the Tax Court shall receive necessary traveling expenses, and expenses actually incurred for subsistence while traveling on duty and away from their designated stations, subject to the same limitations in amount as are now or may hereafter be applicable to the United States Court of International Trade.";
    for j: Individual;
    for actual: Money;
    for limit: Money;
    when traveling_expenses_incurred(j, actual)
        and court_of_international_trade_expense_limit(limit)
        and actual > limit;
    then reimbursable_travel_expenses(j, limit);
}
pub relation travel_expenses_paid(j: Individual, amount: Money) kind empirical;
@source(IRC_S7443_D, relation = formalizes, coverage = exact, quote = "Judges of the Tax Court shall receive necessary traveling expenses, and expenses actually incurred for subsistence while traveling on duty and away from their designated stations")
pub rule S7443dExpensesDutyRule strict {
    label en official "Judges of the Tax Court shall receive necessary traveling expenses, and expenses actually incurred for subsistence while traveling on duty and away from their designated stations";
    for j: Individual;
    for amount: Money;
    when reimbursable_travel_expenses(j, amount);
    then duty S7443dPayTravelExpenses {
        bearer us.irc.core::TaxCourt;
        beneficiary j;
        goal achievement {
            condition travel_expenses_paid(j, amount);
            window [-infinity, infinity];
        }
    };
}
pub relation judge_term_expires_on(j: Individual, on: Date) kind institutional;
@source(IRC_S7443_E, relation = formalizes, coverage = exact, quote = "The term of office of any judge of the Tax Court shall expire 15 years after he takes office.")
pub rule S7443eTermFifteenYears strict {
    label en official "The term of office of any judge of the Tax Court shall expire 15 years after he takes office.";
    for j: Individual;
    for tookOffice: Date;
    when judge_takes_office_on(j, tookOffice);
    then judge_term_expires_on(j, add_calendar_period(tookOffice, 15 calendar_year));
}
pub relation president_removes_judge_on(j: Individual, on: Date) kind empirical;
pub relation removal_notice_and_public_hearing_given(j: Individual) kind empirical {
    label en official "after notice and opportunity for public hearing";
}
pub relation removal_cause_inefficiency(j: Individual) kind empirical {
    label en official "inefficiency";
}
pub relation removal_cause_neglect_of_duty(j: Individual) kind empirical {
    label en official "neglect of duty";
}
pub relation removal_cause_malfeasance_in_office(j: Individual) kind empirical {
    label en official "malfeasance in office";
}
pub relation removal_cause_permitted(j: Individual) kind institutional;
@source(IRC_S7443_F, relation = formalizes, coverage = exact, quote = "Judges of the Tax Court may be removed by the President, after notice and opportunity for public hearing, for inefficiency, neglect of duty, or malfeasance in office, but for no other cause.")
pub rule S7443fCauseInefficiency strict {
    label en official "Judges of the Tax Court may be removed by the President, after notice and opportunity for public hearing, for inefficiency, neglect of duty, or malfeasance in office, but for no other cause.";
    for j: Individual;
    when removal_cause_inefficiency(j);
    then removal_cause_permitted(j);
}
@source(IRC_S7443_F, relation = formalizes, coverage = exact, quote = "Judges of the Tax Court may be removed by the President, after notice and opportunity for public hearing, for inefficiency, neglect of duty, or malfeasance in office, but for no other cause.")
pub rule S7443fCauseNeglect strict {
    label en official "Judges of the Tax Court may be removed by the President, after notice and opportunity for public hearing, for inefficiency, neglect of duty, or malfeasance in office, but for no other cause.";
    for j: Individual;
    when removal_cause_neglect_of_duty(j);
    then removal_cause_permitted(j);
}
@source(IRC_S7443_F, relation = formalizes, coverage = exact, quote = "Judges of the Tax Court may be removed by the President, after notice and opportunity for public hearing, for inefficiency, neglect of duty, or malfeasance in office, but for no other cause.")
pub rule S7443fCauseMalfeasance strict {
    label en official "Judges of the Tax Court may be removed by the President, after notice and opportunity for public hearing, for inefficiency, neglect of duty, or malfeasance in office, but for no other cause.";
    for j: Individual;
    when removal_cause_malfeasance_in_office(j);
    then removal_cause_permitted(j);
}
pub relation removal_grounds_and_procedure_met(j: Individual) kind institutional;
@source(IRC_S7443_F, relation = formalizes, coverage = exact, quote = "Judges of the Tax Court may be removed by the President, after notice and opportunity for public hearing, for inefficiency, neglect of duty, or malfeasance in office, but for no other cause.")
pub rule S7443fGroundsAndProcedure strict {
    label en official "Judges of the Tax Court may be removed by the President, after notice and opportunity for public hearing, for inefficiency, neglect of duty, or malfeasance in office, but for no other cause.";
    for j: Individual;
    when removal_cause_permitted(j)
        and removal_notice_and_public_hearing_given(j);
    then removal_grounds_and_procedure_met(j);
}
pub relation judge_removed_from_office(j: Individual, on: Date) kind institutional;
@source(IRC_S7443_F, relation = formalizes, coverage = exact, quote = "Judges of the Tax Court may be removed by the President, after notice and opportunity for public hearing, for inefficiency, neglect of duty, or malfeasance in office, but for no other cause.")
pub rule S7443fRemovalPowerRule strict {
    label en official "Judges of the Tax Court may be removed by the President, after notice and opportunity for public hearing, for inefficiency, neglect of duty, or malfeasance in office, but for no other cause.";
    for j: Individual;
    for on: Date;
    when president_removes_judge_on(j, on);
    then power S7443fRemoveJudge {
        holder President;
        over j;
        exercise president_removes_judge_on(j, on);
        valid_when removal_grounds_and_procedure_met(j);
        effect judge_removed_from_office(j, on);
    };
}
pub relation judge_removed_for_other_cause(j: Individual) kind empirical {
    label en official "removal for any cause other than inefficiency, neglect of duty, or malfeasance in office";
}
@source(IRC_S7443_F, relation = formalizes, coverage = exact, quote = "but for no other cause.")
pub rule S7443fNoOtherCauseImmunityRule strict {
    label en official "but for no other cause.";
    for j: Individual;
    when member_of_tax_court(j);
    then immunity S7443fTenureImmunity {
        holder j;
        protected_effect judge_removed_for_other_cause(j);
        window [-infinity, infinity];
    };
}
pub relation removed_judge_practices_before_tax_court(j: Individual) kind empirical;
@source(IRC_S7443_G, relation = formalizes, coverage = exact, quote = "A judge of the Tax Court removed from office in accordance with subsection (f) shall not be permitted at any time to practice before the Tax Court.")
pub rule S7443gRemovedJudgeMayNotPracticeRule strict {
    label en official "A judge of the Tax Court removed from office in accordance with subsection (f) shall not be permitted at any time to practice before the Tax Court.";
    for j: Individual;
    for on: Date;
    when judge_removed_from_office(j, on);
    then prohibition S7443gNoPracticeBeforeTaxCourt {
        bearer j;
        action removed_judge_practices_before_tax_court(j);
        window [-infinity, infinity];
    };
}

// ============================================================================
// §7443A — Special trial judges
// ============================================================================

pub relation chief_judge_appoints_special_trial_judge_on(cj: Individual, stj: Individual, on: Date) kind empirical;
pub relation is_chief_judge(cj: Individual) kind empirical {
    label en official "the chief judge of the Tax Court";
}
pub relation special_trial_judge_appointed(stj: Individual, on: Date) kind institutional;
@source(IRC_S7443A_A, relation = formalizes, coverage = exact, quote = "The chief judge may, from time to time, appoint special trial judges who shall proceed under such rules and regulations as may be promulgated by the Tax Court.")
pub rule S7443AaAppointPowerRule strict {
    label en official "The chief judge may, from time to time, appoint special trial judges who shall proceed under such rules and regulations as may be promulgated by the Tax Court.";
    for cj: Individual;
    for stj: Individual;
    for on: Date;
    when chief_judge_appoints_special_trial_judge_on(cj, stj, on);
    then power S7443AaAppointSpecialTrialJudge {
        holder cj;
        over stj;
        exercise chief_judge_appoints_special_trial_judge_on(cj, stj, on);
        valid_when is_chief_judge(cj);
        effect special_trial_judge_appointed(stj, on);
    };
}
pub relation declaratory_judgment_proceeding(pr: Proceeding) kind institutional;
@source(IRC_S7443A_B, relation = formalizes, coverage = exact, quote = "(1) any declaratory judgment proceeding,")
pub rule S7443AbDeclaratoryProceeding strict {
    label en official "(1) any declaratory judgment proceeding,";
    for pr: Proceeding;
    for p: Person;
    for remedy: DeclaratoryRemedy;
    when declaratory_controversy(pr, p, remedy);
    then declaratory_judgment_proceeding(pr);
}
pub relation proceeding_amount_over_50000(pr: Proceeding) kind institutional;
@source(IRC_S7443A_B, relation = formalizes, coverage = exact, quote = "(3) any proceeding where neither the amount of the deficiency placed in dispute (within the meaning of section 7463) nor the amount of any claimed overpayment exceeds $50,000,")
pub rule S7443AbDeficiencyOver50000 strict {
    label en official "(3) any proceeding where neither the amount of the deficiency placed in dispute (within the meaning of section 7463) nor the amount of any claimed overpayment exceeds $50,000,";
    for pr: Proceeding;
    for y: TaxableYear;
    for amount: Money;
    when deficiency_placed_in_dispute(pr, y, amount)
        and amount > 50000.00 USD;
    then proceeding_amount_over_50000(pr);
}
@source(IRC_S7443A_B, relation = formalizes, coverage = exact, quote = "(3) any proceeding where neither the amount of the deficiency placed in dispute (within the meaning of section 7463) nor the amount of any claimed overpayment exceeds $50,000,")
pub rule S7443AbOverpaymentOver50000 strict {
    label en official "(3) any proceeding where neither the amount of the deficiency placed in dispute (within the meaning of section 7463) nor the amount of any claimed overpayment exceeds $50,000,";
    for pr: Proceeding;
    for y: TaxableYear;
    for amount: Money;
    when overpayment_claimed(pr, y, amount)
        and amount > 50000.00 USD;
    then proceeding_amount_over_50000(pr);
}
pub relation proceeding_amounts_within_50000(pr: Proceeding) kind institutional;
@source(IRC_S7443A_B, relation = formalizes, coverage = exact, quote = "(3) any proceeding where neither the amount of the deficiency placed in dispute (within the meaning of section 7463) nor the amount of any claimed overpayment exceeds $50,000,")
pub rule S7443AbAmountsWithin50000 defeasible {
    label en official "(3) any proceeding where neither the amount of the deficiency placed in dispute (within the meaning of section 7463) nor the amount of any claimed overpayment exceeds $50,000,";
    for pr: Proceeding;
    for y: TaxableYear;
    for amount: Money;
    when deficiency_placed_in_dispute(pr, y, amount)
        and not_known(proceeding_amount_over_50000(pr));
    then proceeding_amounts_within_50000(pr);
}
pub relation collection_due_process_proceeding_6320_6330(pr: Proceeding) kind empirical {
    label en official "any proceeding under section 6320 or 6330";
}
pub relation whistleblower_proceeding_7623b4(pr: Proceeding) kind empirical {
    label en official "any proceeding under section 7623(b)(4)";
}
pub relation chief_judge_designates_proceeding_for_special_trial_judge(pr: Proceeding) kind empirical {
    label en official "any other proceeding which the chief judge may designate";
}
pub relation proceeding_in_special_trial_judge_decision_categories(pr: Proceeding) kind institutional {
    label en unofficial "the proceeding is one described in paragraphs (1) through (6) of §7443A(b), for which the court may authorize a special trial judge to make the decision";
}
@source(IRC_S7443A_C, relation = formalizes, coverage = exact, quote = "The court may authorize a special trial judge to make the decision of the court with respect to any proceeding described in paragraph (1), (2), (3), (4), (5), or (6) of subsection (b)")
pub rule S7443AcCategory1 defeasible {
    label en official "The court may authorize a special trial judge to make the decision of the court with respect to any proceeding described in paragraph (1), (2), (3), (4), (5), or (6) of subsection (b)";
    for pr: Proceeding;
    when declaratory_judgment_proceeding(pr);
    then proceeding_in_special_trial_judge_decision_categories(pr);
}
@source(IRC_S7443A_C, relation = formalizes, coverage = exact, quote = "The court may authorize a special trial judge to make the decision of the court with respect to any proceeding described in paragraph (1), (2), (3), (4), (5), or (6) of subsection (b)")
pub rule S7443AcCategory2 defeasible {
    label en official "The court may authorize a special trial judge to make the decision of the court with respect to any proceeding described in paragraph (1), (2), (3), (4), (5), or (6) of subsection (b)";
    for pr: Proceeding;
    when small_case_procedure_applies(pr);
    then proceeding_in_special_trial_judge_decision_categories(pr);
}
@source(IRC_S7443A_C, relation = formalizes, coverage = exact, quote = "The court may authorize a special trial judge to make the decision of the court with respect to any proceeding described in paragraph (1), (2), (3), (4), (5), or (6) of subsection (b)")
pub rule S7443AcCategory3 defeasible {
    label en official "The court may authorize a special trial judge to make the decision of the court with respect to any proceeding described in paragraph (1), (2), (3), (4), (5), or (6) of subsection (b)";
    for pr: Proceeding;
    when proceeding_amounts_within_50000(pr);
    then proceeding_in_special_trial_judge_decision_categories(pr);
}
@source(IRC_S7443A_C, relation = formalizes, coverage = exact, quote = "The court may authorize a special trial judge to make the decision of the court with respect to any proceeding described in paragraph (1), (2), (3), (4), (5), or (6) of subsection (b)")
pub rule S7443AcCategory4 defeasible {
    label en official "The court may authorize a special trial judge to make the decision of the court with respect to any proceeding described in paragraph (1), (2), (3), (4), (5), or (6) of subsection (b)";
    for pr: Proceeding;
    when collection_due_process_proceeding_6320_6330(pr);
    then proceeding_in_special_trial_judge_decision_categories(pr);
}
@source(IRC_S7443A_C, relation = formalizes, coverage = exact, quote = "The court may authorize a special trial judge to make the decision of the court with respect to any proceeding described in paragraph (1), (2), (3), (4), (5), or (6) of subsection (b)")
pub rule S7443AcCategory5 defeasible {
    label en official "The court may authorize a special trial judge to make the decision of the court with respect to any proceeding described in paragraph (1), (2), (3), (4), (5), or (6) of subsection (b)";
    for pr: Proceeding;
    when employment_status_small_case_procedure_applies(pr);
    then proceeding_in_special_trial_judge_decision_categories(pr);
}
@source(IRC_S7443A_C, relation = formalizes, coverage = exact, quote = "The court may authorize a special trial judge to make the decision of the court with respect to any proceeding described in paragraph (1), (2), (3), (4), (5), or (6) of subsection (b)")
pub rule S7443AcCategory6 defeasible {
    label en official "The court may authorize a special trial judge to make the decision of the court with respect to any proceeding described in paragraph (1), (2), (3), (4), (5), or (6) of subsection (b)";
    for pr: Proceeding;
    when whistleblower_proceeding_7623b4(pr);
    then proceeding_in_special_trial_judge_decision_categories(pr);
}
pub relation proceeding_assignable_to_special_trial_judge(pr: Proceeding) kind institutional;
@source(IRC_S7443A_B, relation = formalizes, coverage = exact, quote = "The chief judge may assign—")
pub rule S7443AbAssignableCategories defeasible {
    label en official "The chief judge may assign—";
    for pr: Proceeding;
    when proceeding_in_special_trial_judge_decision_categories(pr);
    then proceeding_assignable_to_special_trial_judge(pr);
}
@source(IRC_S7443A_B, relation = formalizes, coverage = exact, quote = "(7) any other proceeding which the chief judge may designate,")
pub rule S7443AbAssignableDesignated defeasible {
    label en official "(7) any other proceeding which the chief judge may designate,";
    for pr: Proceeding;
    when chief_judge_designates_proceeding_for_special_trial_judge(pr);
    then proceeding_assignable_to_special_trial_judge(pr);
}
pub relation chief_judge_assigns_proceeding_to_special_trial_judge(cj: Individual, pr: Proceeding) kind empirical;
pub relation proceeding_assigned_to_special_trial_judge(pr: Proceeding) kind institutional;
@source(IRC_S7443A_B, relation = formalizes, coverage = exact, quote = "to be heard by the special trial judges of the court.")
pub rule S7443AbAssignPowerRule defeasible {
    label en official "to be heard by the special trial judges of the court.";
    for cj: Individual;
    for pr: Proceeding;
    when chief_judge_assigns_proceeding_to_special_trial_judge(cj, pr);
    then power S7443AbAssignProceeding {
        holder cj;
        exercise chief_judge_assigns_proceeding_to_special_trial_judge(cj, pr);
        valid_when proceeding_assignable_to_special_trial_judge(pr);
        effect proceeding_assigned_to_special_trial_judge(pr);
    };
}
pub relation court_authorizes_special_trial_judge_decision(pr: Proceeding) kind empirical;
pub relation special_trial_judge_may_make_decision(pr: Proceeding) kind institutional;
@source(IRC_S7443A_C, relation = formalizes, coverage = exact, quote = "The court may authorize a special trial judge to make the decision of the court with respect to any proceeding described in paragraph (1), (2), (3), (4), (5), or (6) of subsection (b), subject to such conditions and review as the court may provide.")
pub rule S7443AcAuthorizePowerRule defeasible {
    label en official "The court may authorize a special trial judge to make the decision of the court with respect to any proceeding described in paragraph (1), (2), (3), (4), (5), or (6) of subsection (b), subject to such conditions and review as the court may provide.";
    for pr: Proceeding;
    when court_authorizes_special_trial_judge_decision(pr);
    then power S7443AcAuthorizeStjDecision {
        holder us.irc.core::TaxCourt;
        exercise court_authorizes_special_trial_judge_decision(pr);
        valid_when proceeding_in_special_trial_judge_decision_categories(pr);
        effect special_trial_judge_may_make_decision(pr);
    };
}
pub relation special_trial_judge_travel_rules_same_as_judges(office: JudicialOffice) kind institutional;
@source(IRC_S7443A_E, relation = formalizes, coverage = exact, quote = "Subsection (d) of section 7443 shall apply to special trial judges subject to such rules and regulations as may be promulgated by the Tax Court.")
rule S7443AeStjTravel strict {
    label en official "Subsection (d) of section 7443 shall apply to special trial judges subject to such rules and regulations as may be promulgated by the Tax Court.";
    then special_trial_judge_travel_rules_same_as_judges(SpecialTrialJudgeOffice);
}

// ============================================================================
// §7444 — Organization of the Tax Court
// ============================================================================

pub relation tax_court_seal_judicially_noticed(court: Organ) kind institutional;
@source(IRC_S7444_A, relation = formalizes, coverage = exact, quote = "The Tax Court shall have a seal which shall be judicially noticed.")
rule S7444aSeal strict {
    label en official "The Tax Court shall have a seal which shall be judicially noticed.";
    then tax_court_seal_judicially_noticed(us.irc.core::TaxCourt);
}
pub relation chief_judge_designated_on(cj: Individual, on: Date) kind empirical;
pub relation chief_judge_redesignation_made(on: Date) kind empirical;
@source(IRC_S7444_B, relation = formalizes, coverage = exact, quote = "The Tax Court shall at least biennially designate a judge to act as chief judge.")
pub rule S7444bBiennialDesignationDutyRule strict {
    label en official "The Tax Court shall at least biennially designate a judge to act as chief judge.";
    for cj: Individual;
    for on: Date;
    when chief_judge_designated_on(cj, on);
    then duty S7444bDesignateChiefJudgeAgain {
        bearer us.irc.core::TaxCourt;
        goal achievement {
            condition chief_judge_redesignation_made(add_calendar_period(on, 2 calendar_year));
            window [on, add_calendar_period(on, 2 calendar_year)];
        }
    };
}
pub relation chief_judge_divides_court_on(cj: Individual, on: Date) kind empirical;
pub relation court_divided_into_divisions(on: Date) kind institutional;
@source(IRC_S7444_C, relation = formalizes, coverage = exact, quote = "The chief judge may from time to time divide the Tax Court into divisions of one or more judges, assign the judges of the Tax Court thereto, and in case of a division of more than one judge, designate the chief thereof.")
pub rule S7444cDividePowerRule strict {
    label en official "The chief judge may from time to time divide the Tax Court into divisions of one or more judges, assign the judges of the Tax Court thereto, and in case of a division of more than one judge, designate the chief thereof.";
    for cj: Individual;
    for on: Date;
    when chief_judge_divides_court_on(cj, on);
    then power S7444cDivideCourt {
        holder cj;
        exercise chief_judge_divides_court_on(cj, on);
        valid_when is_chief_judge(cj);
        effect court_divided_into_divisions(on);
    };
}
pub relation division_below_designated_number(div: Text) kind empirical {
    label en official "a division, as a result of a vacancy or the absence or inability of a judge assigned thereto to serve thereon, is composed of less than the number of judges designated for the division";
}
pub relation chief_judge_fills_or_proceeds_with_division(cj: Individual, div: Text) kind empirical;
pub relation division_completed_or_proceeds_without_replacement(div: Text) kind institutional;
@source(IRC_S7444_C, relation = formalizes, coverage = exact, quote = "the chief judge may assign other judges to the division or direct the division to proceed with the transaction of business without awaiting any additional assignment of judges thereto.")
pub rule S7444cVacancyPowerRule strict {
    label en official "the chief judge may assign other judges to the division or direct the division to proceed with the transaction of business without awaiting any additional assignment of judges thereto.";
    for cj: Individual;
    for div: Text;
    when chief_judge_fills_or_proceeds_with_division(cj, div);
    then power S7444cFillOrProceed {
        holder cj;
        exercise chief_judge_fills_or_proceeds_with_division(cj, div);
        valid_when division_below_designated_number(div);
        effect division_completed_or_proceeds_without_replacement(div);
    };
}
pub relation judges_present(body: Text, present: Integer, total: Integer) kind empirical {
    label en official "the judges of the Tax Court or of any division thereof (judges present and the total number of judges)";
}
pub relation quorum_present(body: Text) kind institutional;
@source(IRC_S7444_D, relation = formalizes, coverage = exact, quote = "A majority of the judges of the Tax Court or of any division thereof shall constitute a quorum for the transaction of the business of the Tax Court or of the division, respectively.")
pub rule S7444dMajorityIsQuorum strict {
    label en official "A majority of the judges of the Tax Court or of any division thereof shall constitute a quorum for the transaction of the business of the Tax Court or of the division, respectively.";
    for body: Text;
    for present: Integer;
    for total: Integer;
    when judges_present(body, present, total)
        and present * 2 > total;
    then quorum_present(body);
}
pub relation vacancy_in_body(body: Text) kind empirical {
    label en official "a vacancy in the Tax Court or in any division thereof";
}
pub relation powers_and_duties_unimpaired_by_vacancy(body: Text) kind institutional;
@source(IRC_S7444_D, relation = formalizes, coverage = exact, quote = "A vacancy in the Tax Court or in any division thereof shall not impair the powers nor affect the duties of the Tax Court or division nor of the remaining judges of the Tax Court or division, respectively.")
pub rule S7444dVacancyDoesNotImpair strict {
    label en official "A vacancy in the Tax Court or in any division thereof shall not impair the powers nor affect the duties of the Tax Court or division nor of the remaining judges of the Tax Court or division, respectively.";
    for body: Text;
    when vacancy_in_body(body);
    then powers_and_duties_unimpaired_by_vacancy(body);
}

// ============================================================================
// §7445, §7446 — Offices; times and places of sessions
// ============================================================================

pub relation principal_office_in_district_of_columbia(court: Organ) kind institutional;
@source(IRC_S7445, relation = formalizes, coverage = exact, quote = "The principal office of the Tax Court shall be in the District of Columbia")
rule S7445PrincipalOffice strict {
    label en official "The principal office of the Tax Court shall be in the District of Columbia";
    then principal_office_in_district_of_columbia(us.irc.core::TaxCourt);
}
pub relation court_may_sit_at_any_place_in_united_states(court: Organ) kind institutional;
@source(IRC_S7445, relation = formalizes, coverage = exact, quote = "but the Tax Court or any of its divisions may sit at any place within the United States.")
rule S7445MaySitAnywhere strict {
    label en official "but the Tax Court or any of its divisions may sit at any place within the United States.";
    then court_may_sit_at_any_place_in_united_states(us.irc.core::TaxCourt);
}
pub relation session_times_and_places_prescribed_by_chief_judge(cj: Individual) kind empirical {
    label en official "The times and places of the sessions of the Tax Court and of its divisions shall be prescribed by the chief judge with a view to securing reasonable opportunity to taxpayers to appear before the Tax Court or any of its divisions, with as little inconvenience and expense to taxpayers as is practicable";
}
@source(IRC_S7446, relation = formalizes, coverage = exact, quote = "The times and places of the sessions of the Tax Court and of its divisions shall be prescribed by the chief judge")
pub rule S7446SessionsDutyRule strict {
    label en official "The times and places of the sessions of the Tax Court and of its divisions shall be prescribed by the chief judge";
    for cj: Individual;
    when is_chief_judge(cj);
    then duty S7446PrescribeSessions {
        bearer cj;
        goal maintenance {
            condition session_times_and_places_prescribed_by_chief_judge(cj);
            window [-infinity, infinity];
        }
    };
}

// ============================================================================
// §7447, §7447A — Retirement of judges and special trial judges
// ============================================================================

pub relation judicial_officer(j: Individual, office: JudicialOffice) kind empirical;
pub relation age_attained(j: Individual, years: Integer) kind empirical;
pub relation years_of_service(j: Individual, office: JudicialOffice, years: Integer) kind empirical {
    label en unofficial "length of service in the office, counting all periods whether or not consecutive (typed input: TECH-GAPS G2905)";
}
pub relation retirement_table_met(j: Individual, office: JudicialOffice) kind institutional {
    label en unofficial "the judicial officer meets the age and service requirements of the table: age 65 and 15 years, 66 and 14, 67 and 13, 68 and 12, 69 and 11, 70 and 10";
}
@source(IRC_S7447A_A, relation = formalizes, coverage = exact, quote = "if the individual meets the age and service requirements set forth in the following table:")
@source(IRC_S7447_TABLE_1, relation = formalizes, coverage = exact, quote = "65 / 15")
pub rule S7447bTableAge65 strict {
    label en official "65 / 15";
    for j: Individual;
    for office: JudicialOffice;
    for age: Integer;
    for years: Integer;
    when judicial_officer(j, office)
        and age_attained(j, age)
        and years_of_service_for_rules(j, office, years)
        and age >= 65
        and years >= 15;
    then retirement_table_met(j, office);
}
@source(IRC_S7447A_A, relation = formalizes, coverage = exact, quote = "if the individual meets the age and service requirements set forth in the following table:")
@source(IRC_S7447_TABLE_1, relation = formalizes, coverage = exact, quote = "66 / 14")
pub rule S7447bTableAge66 strict {
    label en official "66 / 14";
    for j: Individual;
    for office: JudicialOffice;
    for age: Integer;
    for years: Integer;
    when judicial_officer(j, office)
        and age_attained(j, age)
        and years_of_service_for_rules(j, office, years)
        and age >= 66
        and years >= 14;
    then retirement_table_met(j, office);
}
@source(IRC_S7447A_A, relation = formalizes, coverage = exact, quote = "if the individual meets the age and service requirements set forth in the following table:")
@source(IRC_S7447_TABLE_1, relation = formalizes, coverage = exact, quote = "67 / 13")
pub rule S7447bTableAge67 strict {
    label en official "67 / 13";
    for j: Individual;
    for office: JudicialOffice;
    for age: Integer;
    for years: Integer;
    when judicial_officer(j, office)
        and age_attained(j, age)
        and years_of_service_for_rules(j, office, years)
        and age >= 67
        and years >= 13;
    then retirement_table_met(j, office);
}
@source(IRC_S7447A_A, relation = formalizes, coverage = exact, quote = "if the individual meets the age and service requirements set forth in the following table:")
@source(IRC_S7447_TABLE_1, relation = formalizes, coverage = exact, quote = "68 / 12")
pub rule S7447bTableAge68 strict {
    label en official "68 / 12";
    for j: Individual;
    for office: JudicialOffice;
    for age: Integer;
    for years: Integer;
    when judicial_officer(j, office)
        and age_attained(j, age)
        and years_of_service_for_rules(j, office, years)
        and age >= 68
        and years >= 12;
    then retirement_table_met(j, office);
}
@source(IRC_S7447A_A, relation = formalizes, coverage = exact, quote = "if the individual meets the age and service requirements set forth in the following table:")
@source(IRC_S7447_TABLE_1, relation = formalizes, coverage = exact, quote = "69 / 11")
pub rule S7447bTableAge69 strict {
    label en official "69 / 11";
    for j: Individual;
    for office: JudicialOffice;
    for age: Integer;
    for years: Integer;
    when judicial_officer(j, office)
        and age_attained(j, age)
        and years_of_service_for_rules(j, office, years)
        and age >= 69
        and years >= 11;
    then retirement_table_met(j, office);
}
@source(IRC_S7447A_A, relation = formalizes, coverage = exact, quote = "if the individual meets the age and service requirements set forth in the following table:")
@source(IRC_S7447_TABLE_1, relation = formalizes, coverage = exact, quote = "70 / 10")
pub rule S7447bTableAge70 strict {
    label en official "70 / 10";
    for j: Individual;
    for office: JudicialOffice;
    for age: Integer;
    for years: Integer;
    when judicial_officer(j, office)
        and age_attained(j, age)
        and years_of_service_for_rules(j, office, years)
        and age >= 70
        and years >= 10;
    then retirement_table_met(j, office);
}
pub relation judicial_officer_retires_on(j: Individual, office: JudicialOffice, on: Date) kind empirical;
pub relation judicial_officer_retired_under_table(j: Individual, office: JudicialOffice, on: Date) kind institutional;
@source(IRC_S7447A_A, relation = formalizes, coverage = exact, quote = "Any special trial judge appointed pursuant to section 7443A may retire from service as a special trial judge if the individual meets the age and service requirements set forth in the following table:")
@source(IRC_S7447_B, relation = formalizes, coverage = exact, quote = "(2) Any judge who meets the age and service requirements set forth in the following table may retire:")
pub rule S7447b2RetirementPowerRule strict {
    label en official "(2) Any judge who meets the age and service requirements set forth in the following table may retire:";
    for j: Individual;
    for office: JudicialOffice;
    for on: Date;
    when judicial_officer_retires_on(j, office, on);
    then power S7447b2RetireOnTable {
        holder j;
        exercise judicial_officer_retires_on(j, office, on);
        valid_when retirement_table_met(j, office);
        effect judicial_officer_retired_under_table(j, office, on);
    };
}
pub relation judge_attains_age_70_on(j: Individual, on: Date) kind empirical;
pub relation judge_retired(j: Individual) kind empirical;
@source(IRC_S7447_B, relation = formalizes, coverage = exact, quote = "(1) Any judge shall retire upon attaining the age of 70.")
pub rule S7447b1MandatoryRetirementRule strict {
    label en official "(1) Any judge shall retire upon attaining the age of 70.";
    for j: Individual;
    for on: Date;
    when judge_attains_age_70_on(j, on);
    then duty S7447b1RetireAtSeventy {
        bearer j;
        goal achievement {
            condition judge_retired(j);
            window [on, on];
        }
    };
}
pub relation term_expired_without_reappointment_on(j: Individual, on: Date) kind empirical;
pub relation advised_president_willing_to_accept_reappointment_on(j: Individual, on: Date) kind empirical {
    label en official "he advised the President in writing that he was willing to accept reappointment to the Tax Court";
}
pub relation advice_within_reappointment_window(j: Individual) kind institutional {
    label en unofficial "the advice to the President was given not earlier than 9 months and not later than 6 months preceding the date of expiration of the term";
}
@source(IRC_S7447_B, relation = formalizes, coverage = exact, quote = "(B) not earlier than 9 months preceding the date of the expiration of the term of his office and not later than 6 months preceding such date, he advised the President in writing that he was willing to accept reappointment to the Tax Court.")
pub rule S7447b3AdviceWindow strict {
    label en official "(B) not earlier than 9 months preceding the date of the expiration of the term of his office and not later than 6 months preceding such date, he advised the President in writing that he was willing to accept reappointment to the Tax Court.";
    for j: Individual;
    for termEnd: Date;
    for advisedOn: Date;
    when term_expired_without_reappointment_on(j, termEnd)
        and advised_president_willing_to_accept_reappointment_on(j, advisedOn)
        and add_calendar_period(advisedOn, 9 calendar_month) >= termEnd
        and add_calendar_period(advisedOn, 6 calendar_month) <= termEnd;
    then advice_within_reappointment_window(j);
}
pub relation judge_service_fifteen_years_or_more(j: Individual) kind institutional;
@source(IRC_S7447_B, relation = formalizes, coverage = exact, quote = "(A) he has served as a judge of the Tax Court for 15 years or more")
pub rule S7447b3ServiceFifteenYears strict {
    label en official "(A) he has served as a judge of the Tax Court for 15 years or more";
    for j: Individual;
    for years: Integer;
    when years_of_service_for_rules(j, TaxCourtJudgeOffice, years)
        and years >= 15;
    then judge_service_fifteen_years_or_more(j);
}
pub relation judge_retires_on_completion_of_term(j: Individual, on: Date) kind empirical;
pub relation judge_retired_on_term_completion(j: Individual, on: Date) kind institutional;
@source(IRC_S7447_B, relation = formalizes, coverage = exact, quote = "(3) Any judge who is not reappointed following the expiration of the term of his office may retire upon the completion of such term")
pub rule S7447b3RetirementPowerRule strict {
    label en official "(3) Any judge who is not reappointed following the expiration of the term of his office may retire upon the completion of such term";
    for j: Individual;
    for on: Date;
    when judge_retires_on_completion_of_term(j, on);
    then power S7447b3RetireOnTermCompletion {
        holder j;
        exercise judge_retires_on_completion_of_term(j, on);
        valid_when term_completion_retirement_conditions(j);
        effect judge_retired_on_term_completion(j, on);
    };
}
pub relation term_completion_retirement_conditions(j: Individual) kind institutional;
@source(IRC_S7447_B, relation = formalizes, coverage = exact, quote = "(3) Any judge who is not reappointed following the expiration of the term of his office may retire upon the completion of such term")
pub rule S7447b3Conditions strict {
    label en official "(3) Any judge who is not reappointed following the expiration of the term of his office may retire upon the completion of such term";
    for j: Individual;
    when judge_service_fifteen_years_or_more(j)
        and advice_within_reappointment_window(j);
    then term_completion_retirement_conditions(j);
}
pub relation judicial_officer_permanently_disabled(j: Individual, office: JudicialOffice) kind empirical;
pub relation judicial_officer_retired(j: Individual, office: JudicialOffice) kind empirical;
@source(IRC_S7447A_B, relation = formalizes, coverage = exact, quote = "Any special trial judge appointed pursuant to section 7443A who becomes permanently disabled from performing such individual's duties shall retire from service as a special trial judge.")
@source(IRC_S7447_B, relation = formalizes, coverage = exact, quote = "(4) Any judge who becomes permanently disabled from performing his duties shall retire.")
pub rule S7447b4DisabilityRetirementDutyRule strict {
    label en official "(4) Any judge who becomes permanently disabled from performing his duties shall retire.";
    for j: Individual;
    for office: JudicialOffice;
    when judicial_officer_permanently_disabled(j, office);
    then duty S7447b4RetireOnDisability {
        bearer j;
        goal achievement {
            condition judicial_officer_retired(j, office);
            window [-infinity, infinity];
        }
    };
}
pub relation retired_judicial_officer(j: Individual, office: JudicialOffice) kind empirical;
pub relation designated_senior_judge(j: Individual) kind institutional;
@source(IRC_S7447_B, relation = formalizes, coverage = exact, quote = "Any judge who retires shall be designated \"senior judge\".")
pub rule S7447bSeniorJudgeDesignation strict {
    label en official "Any judge who retires shall be designated \"senior judge\".";
    for j: Individual;
    when retired_judicial_officer(j, TaxCourtJudgeOffice);
    then designated_senior_judge(j);
}

// --- (c) Recall of retired judges ------------------------------------------

pub relation elected_retired_pay(j: Individual, office: JudicialOffice) kind institutional;
pub relation recall_days_in_calendar_year(j: Individual, calendarYear: Integer, days: Integer) kind empirical {
    label en official "the aggregate of such periods in any one calendar year (calendar days of recalled duty)";
}
pub relation recalled_individual_consents_to_longer_service(j: Individual) kind empirical {
    label en official "without his consent";
}
pub relation illness_or_disability_precludes_recalled_duty(j: Individual) kind empirical;
pub relation chief_judge_recalls_retired_judge(cj: Individual, j: Individual, office: JudicialOffice, calendarYear: Integer) kind empirical;
pub relation recall_within_limits(j: Individual, calendarYear: Integer) kind institutional {
    label en unofficial "the recall is at most 90 calendar days in the calendar year, or the individual consents, and illness or disability does not preclude the duty";
}
@source(IRC_S7447A_C, relation = formalizes, coverage = exact, quote = "(1) the aggregate of such periods in any 1 calendar year shall not (without the consent of such individual) exceed 90 calendar days, and")
@source(IRC_S7447_C, relation = formalizes, coverage = exact, quote = "(1) the aggregate of such periods in any one calendar year shall not (without his consent) exceed 90 calendar days; and")
pub rule S7447cWithin90Days defeasible {
    label en official "(1) the aggregate of such periods in any one calendar year shall not (without his consent) exceed 90 calendar days; and";
    for j: Individual;
    for calendarYear: Integer;
    for days: Integer;
    when recall_days_in_calendar_year(j, calendarYear, days)
        and days <= 90
        and not_known(illness_or_disability_precludes_recalled_duty(j));
    then recall_within_limits(j, calendarYear);
}
@source(IRC_S7447A_C, relation = formalizes, coverage = exact, quote = "(1) the aggregate of such periods in any 1 calendar year shall not (without the consent of such individual) exceed 90 calendar days, and")
@source(IRC_S7447_C, relation = formalizes, coverage = exact, quote = "(1) the aggregate of such periods in any one calendar year shall not (without his consent) exceed 90 calendar days; and")
pub rule S7447cConsentedLongerRecall defeasible {
    label en official "(1) the aggregate of such periods in any one calendar year shall not (without his consent) exceed 90 calendar days; and";
    for j: Individual;
    for calendarYear: Integer;
    for days: Integer;
    when recall_days_in_calendar_year(j, calendarYear, days)
        and recalled_individual_consents_to_longer_service(j)
        and not_known(illness_or_disability_precludes_recalled_duty(j));
    then recall_within_limits(j, calendarYear);
}
pub relation judge_recalled_to_judicial_duty(j: Individual, calendarYear: Integer) kind institutional;
@source(IRC_S7447A_C, relation = formalizes, coverage = exact, quote = "may be called upon by the chief judge to perform such judicial duties with the Tax Court as may be requested of such individual for a period or periods specified by the chief judge")
@source(IRC_S7447_C, relation = formalizes, coverage = exact, quote = "may be called upon by the chief judge of the Tax Court to perform such judicial duties with the Tax Court as may be requested of him for any period or periods specified by the chief judge")
pub rule S7447cRecallPowerRule defeasible {
    label en official "may be called upon by the chief judge of the Tax Court to perform such judicial duties with the Tax Court as may be requested of him for any period or periods specified by the chief judge";
    for cj: Individual;
    for j: Individual;
    for office: JudicialOffice;
    for calendarYear: Integer;
    when chief_judge_recalls_retired_judge(cj, j, office, calendarYear);
    then power S7447cRecallRetiredJudge {
        holder cj;
        over j;
        exercise chief_judge_recalls_retired_judge(cj, j, office, calendarYear);
        valid_when recall_conditions_met(j, office, calendarYear);
        effect judge_recalled_to_judicial_duty(j, calendarYear);
    };
}
pub relation recall_conditions_met(j: Individual, office: JudicialOffice, calendarYear: Integer) kind institutional;
@source(IRC_S7447A_C, relation = formalizes, coverage = exact, quote = "Any individual who has retired pursuant to subsection (a) may be called upon by the chief judge to perform such judicial duties")
@source(IRC_S7447_C, relation = formalizes, coverage = exact, quote = "At or after his retirement, any individual who has elected to receive retired pay under subsection (d) may be called upon by the chief judge of the Tax Court to perform such judicial duties")
pub rule S7447cRecallConditions defeasible {
    label en official "At or after his retirement, any individual who has elected to receive retired pay under subsection (d) may be called upon by the chief judge of the Tax Court to perform such judicial duties";
    for j: Individual;
    for office: JudicialOffice;
    for calendarYear: Integer;
    when elected_retired_pay(j, office)
        and recall_within_limits(j, calendarYear);
    then recall_conditions_met(j, office, calendarYear);
}
pub relation act_of_recalled_individual(j: Individual, act: Text) kind empirical;
pub relation act_has_force_of_judge_act(j: Individual, act: Text) kind institutional;
@source(IRC_S7447A_C, relation = formalizes, coverage = exact, quote = "Any act, or failure to act, by an individual performing judicial duties pursuant to this subsection shall have the same force and effect as if it were the act (or failure to act) of a special trial judge.")
@source(IRC_S7447_C, relation = formalizes, coverage = exact, quote = "Any act, or failure to act, by an individual performing judicial duties pursuant to this subsection shall have the same force and effect as if it were the act (or failure to act) of a judge of the Tax Court")
pub rule S7447cActsHaveForceOfJudgeActs strict {
    label en official "Any act, or failure to act, by an individual performing judicial duties pursuant to this subsection shall have the same force and effect as if it were the act (or failure to act) of a judge of the Tax Court";
    for j: Individual;
    for act: Text;
    when act_of_recalled_individual(j, act);
    then act_has_force_of_judge_act(j, act);
}
pub relation performing_recalled_duties(j: Individual) kind empirical;
pub relation recalled_individual_paid_as_judge(j: Individual) kind institutional {
    label en unofficial "the recalled individual is paid the same compensation (in lieu of retired pay) and allowances for travel and other expenses as a judge";
}
@source(IRC_S7447A_C, relation = formalizes, coverage = exact, quote = "shall be paid the same compensation (in lieu of retired pay) and allowances for travel and other expenses as a special trial judge.")
@source(IRC_S7447_C, relation = formalizes, coverage = exact, quote = "Any individual who is performing judicial duties pursuant to this subsection shall be paid the same compensation (in lieu of retired pay) and allowances for travel and other expenses as a judge.")
pub rule S7447cRecalledPaidAsJudge strict {
    label en official "Any individual who is performing judicial duties pursuant to this subsection shall be paid the same compensation (in lieu of retired pay) and allowances for travel and other expenses as a judge.";
    for j: Individual;
    when performing_recalled_duties(j);
    then recalled_individual_paid_as_judge(j);
}
pub relation recalled_individual_is_judge_for_7447(j: Individual) kind institutional;
@source(IRC_S7447_A, relation = formalizes, coverage = exact, quote = "(2) The term \"judge\" means the chief judge or a judge of the Tax Court; but such term does not include any individual performing judicial duties pursuant to subsection (c).")
pub rule S7447a2JudgeDefinition defeasible {
    label en official "(2) The term \"judge\" means the chief judge or a judge of the Tax Court; but such term does not include any individual performing judicial duties pursuant to subsection (c).";
    for j: Individual;
    when member_of_tax_court(j);
    then recalled_individual_is_judge_for_7447(j);
    unless performing_recalled_duties(j) and member_of_tax_court(j);
}

// --- (d) Retired pay -----------------------------------------------------------

pub relation salary_for_retired_pay(j: Individual, office: JudicialOffice, salary: Money) kind empirical {
    label en official "the rate of the salary payable to a judge during such period";
}
pub relation service_whole_years(j: Individual, office: JudicialOffice, years: Integer) kind empirical;
pub relation service_fractional_months(j: Individual, office: JudicialOffice, months: Integer) kind empirical;
pub relation recall_substantially_full_time_years(j: Individual, office: JudicialOffice, years: Integer) kind empirical {
    label en official "any period during which such individual performs services under subsection (c) on a substantially full-time basis";
}
pub relation credited_service_years(j: Individual, office: JudicialOffice, years: Integer) kind institutional {
    label en unofficial "years of service for the retired-pay ratio: a fraction of a year under 6 months is eliminated, 6 months or more counts as a full year; full-time recalled service counts as service";
}
@source(IRC_S7447A_D, relation = formalizes, coverage = exact, quote = "any portion of the aggregate number of years such individual has served as a special trial judge which is a fractional part of 1 year shall be eliminated if it is less than 6 months, or shall be counted as a full year if it is 6 months or more.")
@source(IRC_S7447_D, relation = formalizes, coverage = exact, quote = "In computing the rate of the retired pay under paragraph (1) of this subsection for any individual who is entitled thereto, that portion of the aggregate number of years he has served as a judge which is a fractional part of 1 year shall be eliminated if it is less than 6 months")
pub rule S7447dPartialYearEliminated strict {
    label en official "In computing the rate of the retired pay under paragraph (1) of this subsection for any individual who is entitled thereto, that portion of the aggregate number of years he has served as a judge which is a fractional part of 1 year shall be eliminated if it is less than 6 months";
    for j: Individual;
    for office: JudicialOffice;
    for whole: Integer;
    for months: Integer;
    for recalled: Integer;
    when service_whole_years(j, office, whole)
        and service_fractional_months(j, office, months)
        and recall_substantially_full_time_years(j, office, recalled)
        and months < 6;
    then credited_service_years(j, office, whole + recalled);
}
@source(IRC_S7447A_D, relation = formalizes, coverage = exact, quote = "any portion of the aggregate number of years such individual has served as a special trial judge which is a fractional part of 1 year shall be eliminated if it is less than 6 months, or shall be counted as a full year if it is 6 months or more.")
@source(IRC_S7447_D, relation = formalizes, coverage = exact, quote = "or shall be counted as a full year if it is 6 months or more.")
pub rule S7447dPartialYearCounted strict {
    label en official "or shall be counted as a full year if it is 6 months or more.";
    for j: Individual;
    for office: JudicialOffice;
    for whole: Integer;
    for months: Integer;
    for recalled: Integer;
    when service_whole_years(j, office, whole)
        and service_fractional_months(j, office, months)
        and recall_substantially_full_time_years(j, office, recalled)
        and months >= 6;
    then credited_service_years(j, office, (whole + recalled) + 1);
}
pub relation retired_under_age_or_service_provision(j: Individual, office: JudicialOffice) kind institutional {
    label en unofficial "the individual retires under paragraph (1), (2), or (3) of §7447(b) (or under §7447A(a)) and has elected retired pay";
}
@source(IRC_S7447_D, relation = formalizes, coverage = exact, quote = "(1) retires under paragraph (1), (2), or (3) of subsection (b) and elects under subsection (e) to receive retired pay under this subsection")
pub rule S7447dRetiredUnderTable strict {
    label en official "(1) retires under paragraph (1), (2), or (3) of subsection (b) and elects under subsection (e) to receive retired pay under this subsection";
    for j: Individual;
    for office: JudicialOffice;
    for on: Date;
    when judicial_officer_retired_under_table(j, office, on)
        and elected_retired_pay(j, office);
    then retired_under_age_or_service_provision(j, office);
}
@source(IRC_S7447_D, relation = formalizes, coverage = exact, quote = "(1) retires under paragraph (1), (2), or (3) of subsection (b) and elects under subsection (e) to receive retired pay under this subsection")
pub rule S7447dRetiredMandatoryOrTermEnd strict {
    label en official "(1) retires under paragraph (1), (2), or (3) of subsection (b) and elects under subsection (e) to receive retired pay under this subsection";
    for j: Individual;
    when judge_retired(j)
        and elected_retired_pay(j, TaxCourtJudgeOffice);
    then retired_under_age_or_service_provision(j, TaxCourtJudgeOffice);
}
pub relation retired_pay_rate(j: Individual, office: JudicialOffice, rate: Money) kind institutional {
    label en unofficial "the rate of retired pay under §7447(d) / §7447A(d): the ratio of credited years to 10 (judges) or 15 (special trial judges) of the salary, not more than that salary; on disability retirement the salary (10 or more years) or one-half of it";
}
@source(IRC_S7447_D, relation = formalizes, coverage = exact, quote = "shall receive retired pay during any period at a rate which bears the same ratio to the rate of the salary payable to a judge during such period as the number of years he has served as judge bears to 10")
pub rule S7447d1JudgeBelowTenYears strict {
    label en official "shall receive retired pay during any period at a rate which bears the same ratio to the rate of the salary payable to a judge during such period as the number of years he has served as judge bears to 10";
    for j: Individual;
    for salary: Money;
    for years: Integer;
    when retired_under_age_or_service_provision(j, TaxCourtJudgeOffice)
        and salary_for_retired_pay(j, TaxCourtJudgeOffice, salary)
        and credited_service_years(j, TaxCourtJudgeOffice, years)
        and years < 10;
    then retired_pay_rate(j, TaxCourtJudgeOffice, round(salary * (years / 10), 2, "HALF_UP"));
}
@source(IRC_S7447_D, relation = formalizes, coverage = exact, quote = "except that the rate of such retired pay shall not be more than the rate of such salary for such period; or")
pub rule S7447d1JudgeCappedAtSalary strict {
    label en official "except that the rate of such retired pay shall not be more than the rate of such salary for such period; or";
    for j: Individual;
    for salary: Money;
    for years: Integer;
    when retired_under_age_or_service_provision(j, TaxCourtJudgeOffice)
        and salary_for_retired_pay(j, TaxCourtJudgeOffice, salary)
        and credited_service_years(j, TaxCourtJudgeOffice, years)
        and years >= 10;
    then retired_pay_rate(j, TaxCourtJudgeOffice, salary);
}
@source(IRC_S7447A_D, relation = formalizes, coverage = exact, quote = "shall receive retired pay during any period of retirement from service as a special trial judge at a rate which bears the same ratio to the rate of the salary payable to a special trial judge during such period as—")
pub rule S7447Ad1StjBelowFifteenYears strict {
    label en official "shall receive retired pay during any period of retirement from service as a special trial judge at a rate which bears the same ratio to the rate of the salary payable to a special trial judge during such period as—";
    for j: Individual;
    for salary: Money;
    for years: Integer;
    when retired_under_age_or_service_provision(j, SpecialTrialJudgeOffice)
        and salary_for_retired_pay(j, SpecialTrialJudgeOffice, salary)
        and credited_service_years(j, SpecialTrialJudgeOffice, years)
        and years < 15;
    then retired_pay_rate(j, SpecialTrialJudgeOffice, round(salary * (years / 15), 2, "HALF_UP"));
}
@source(IRC_S7447A_D, relation = formalizes, coverage = exact, quote = "except that the rate of such retired pay shall not be more than the rate of such salary for such period.")
pub rule S7447Ad1StjCappedAtSalary strict {
    label en official "except that the rate of such retired pay shall not be more than the rate of such salary for such period.";
    for j: Individual;
    for salary: Money;
    for years: Integer;
    when retired_under_age_or_service_provision(j, SpecialTrialJudgeOffice)
        and salary_for_retired_pay(j, SpecialTrialJudgeOffice, salary)
        and credited_service_years(j, SpecialTrialJudgeOffice, years)
        and years >= 15;
    then retired_pay_rate(j, SpecialTrialJudgeOffice, salary);
}
pub relation retired_for_permanent_disability(j: Individual, office: JudicialOffice) kind institutional;
@source(IRC_S7447_D, relation = formalizes, coverage = exact, quote = "(2) retires under paragraph (4) of subsection (b) and elects under subsection (e) to receive retired pay under this subsection")
pub rule S7447d2Retired strict {
    label en official "(2) retires under paragraph (4) of subsection (b) and elects under subsection (e) to receive retired pay under this subsection";
    for j: Individual;
    for office: JudicialOffice;
    when judicial_officer_permanently_disabled(j, office)
        and judicial_officer_retired(j, office)
        and elected_retired_pay(j, office);
    then retired_for_permanent_disability(j, office);
}
@source(IRC_S7447A_D, relation = formalizes, coverage = exact, quote = "(A) at a rate equal to the rate of the salary payable to a special trial judge during such period, if the individual had at least 10 years of service as a special trial judge before retirement, and")
@source(IRC_S7447_D, relation = formalizes, coverage = exact, quote = "(A) equal to the rate of the salary payable to a judge during such period if before he retired he had served as a judge not less than 10 years; or")
pub rule S7447d2AFullSalary strict {
    label en official "(A) equal to the rate of the salary payable to a judge during such period if before he retired he had served as a judge not less than 10 years; or";
    for j: Individual;
    for office: JudicialOffice;
    for salary: Money;
    for years: Integer;
    when retired_for_permanent_disability(j, office)
        and salary_for_retired_pay(j, office, salary)
        and years_of_service_for_rules(j, office, years)
        and years >= 10;
    then retired_pay_rate(j, office, salary);
}
@source(IRC_S7447A_D, relation = formalizes, coverage = exact, quote = "(B) at a rate equal to ½ the rate described in subparagraph (A), if the individual had fewer than 10 years of service as a special trial judge before retirement.")
@source(IRC_S7447_D, relation = formalizes, coverage = exact, quote = "(B) one-half of the rate of the salary payable to a judge during such period if before he retired he had served as a judge less than 10 years.")
pub rule S7447d2BHalfSalary strict {
    label en official "(B) one-half of the rate of the salary payable to a judge during such period if before he retired he had served as a judge less than 10 years.";
    for j: Individual;
    for office: JudicialOffice;
    for salary: Money;
    for years: Integer;
    when retired_for_permanent_disability(j, office)
        and salary_for_retired_pay(j, office, salary)
        and years_of_service_for_rules(j, office, years)
        and years < 10;
    then retired_pay_rate(j, office, round(salary * (1 / 2), 2, "HALF_UP"));
}
pub relation judicial_salary_ceases_on(j: Individual, office: JudicialOffice, on: Date) kind empirical;
pub relation retired_pay_accrual_begins_on(j: Individual, office: JudicialOffice, on: Date) kind institutional;
@source(IRC_S7447A_D, relation = formalizes, coverage = exact, quote = "Retired pay under this subsection shall begin to accrue on the day following the date on which the individual's salary as a special trial judge ceases to accrue, and shall continue to accrue during the remainder of such individual's life.")
@source(IRC_S7447_D, relation = formalizes, coverage = exact, quote = "Such retired pay shall begin to accrue on the day following the day on which his salary as judge ceases to accrue, and shall continue to accrue during the remainder of his life.")
pub rule S7447dAccrualBegins strict {
    label en official "Such retired pay shall begin to accrue on the day following the day on which his salary as judge ceases to accrue, and shall continue to accrue during the remainder of his life.";
    for j: Individual;
    for office: JudicialOffice;
    for ceasedOn: Date;
    when judicial_salary_ceases_on(j, office, ceasedOn)
        and elected_retired_pay(j, office);
    then retired_pay_accrual_begins_on(j, office, add_calendar_period(ceasedOn, 1 calendar_day));
}

// --- (e) Election to receive retired pay ----------------------------------------------

pub relation judge_elects_retired_pay_on(j: Individual, office: JudicialOffice, on: Date) kind empirical;
pub relation election_made_while_serving(j: Individual, office: JudicialOffice, on: Date) kind empirical {
    label en official "may be made only while an individual is a judge";
}
pub relation successor_takes_office_on(j: Individual, on: Date) kind empirical {
    label en official "the day on which his successor takes office";
}
pub relation election_notice_filed_with(j: Individual, office: JudicialOffice, recipient: Text) kind empirical {
    label en official "by filing notice thereof in writing with the chief judge (or, for the chief judge, with the Office of Personnel Management)";
}
pub relation retired_pay_election_timely(j: Individual, office: JudicialOffice, on: Date) kind institutional;
@source(IRC_S7447_E, relation = formalizes, coverage = exact, quote = "(1) may be made only while an individual is a judge (except that in the case of an individual who fails to be reappointed as judge at the expiration of a term of office, it may be made at any time before the day after the day on which his successor takes office);")
pub rule S7447e1WhileJudge defeasible {
    label en official "(1) may be made only while an individual is a judge (except that in the case of an individual who fails to be reappointed as judge at the expiration of a term of office, it may be made at any time before the day after the day on which his successor takes office);";
    for j: Individual;
    for office: JudicialOffice;
    for on: Date;
    when election_made_while_serving(j, office, on);
    then retired_pay_election_timely(j, office, on);
}
@source(IRC_S7447_E, relation = formalizes, coverage = exact, quote = "(1) may be made only while an individual is a judge (except that in the case of an individual who fails to be reappointed as judge at the expiration of a term of office, it may be made at any time before the day after the day on which his successor takes office);")
pub rule S7447e1NotReappointed defeasible {
    label en official "(1) may be made only while an individual is a judge (except that in the case of an individual who fails to be reappointed as judge at the expiration of a term of office, it may be made at any time before the day after the day on which his successor takes office);";
    for j: Individual;
    for office: JudicialOffice;
    for on: Date;
    for termEnd: Date;
    for successorOn: Date;
    when term_expired_without_reappointment_on(j, termEnd)
        and successor_takes_office_on(j, successorOn)
        and judge_elects_retired_pay_on(j, office, on)
        and on <= successorOn;
    then retired_pay_election_timely(j, office, on);
}
pub relation chief_judge_of(j: Individual) kind empirical;
pub relation election_filed_with_proper_recipient(j: Individual, office: JudicialOffice) kind institutional;
@source(IRC_S7447_E, relation = formalizes, coverage = exact, quote = "(3) in the case of any judge other than the chief judge, shall be made by filing notice thereof in writing with the chief judge; and")
pub rule S7447e3FiledWithChiefJudge defeasible {
    label en official "(3) in the case of any judge other than the chief judge, shall be made by filing notice thereof in writing with the chief judge; and";
    for j: Individual;
    for office: JudicialOffice;
    when election_notice_filed_with(j, office, "chief judge")
        and not_known(chief_judge_of(j));
    then election_filed_with_proper_recipient(j, office);
}
@source(IRC_S7447_E, relation = formalizes, coverage = exact, quote = "(4) in the case of the chief judge, shall be made by filing notice thereof in writing with the Office of Personnel Management.")
pub rule S7447e4ChiefJudgeFilesWithOpm defeasible {
    label en official "(4) in the case of the chief judge, shall be made by filing notice thereof in writing with the Office of Personnel Management.";
    for j: Individual;
    for office: JudicialOffice;
    when election_notice_filed_with(j, office, "Office of Personnel Management")
        and chief_judge_of(j);
    then election_filed_with_proper_recipient(j, office);
}
pub relation retired_pay_election_valid(j: Individual, office: JudicialOffice, on: Date) kind institutional;
@source(IRC_S7447A_E, relation = formalizes, coverage = exact, quote = "Any special trial judge may elect to receive retired pay under subsection (d).")
@source(IRC_S7447_E, relation = formalizes, coverage = exact, quote = "Any judge may elect to receive retired pay under subsection (d).")
pub rule S7447eElectionValid defeasible {
    label en official "Any judge may elect to receive retired pay under subsection (d).";
    for j: Individual;
    for office: JudicialOffice;
    for on: Date;
    when retired_pay_election_timely(j, office, on)
        and election_filed_with_proper_recipient(j, office);
    then retired_pay_election_valid(j, office, on);
}
@source(IRC_S7447A_E, relation = formalizes, coverage = exact, quote = "Any special trial judge may elect to receive retired pay under subsection (d).")
@source(IRC_S7447_E, relation = formalizes, coverage = exact, quote = "Any judge may elect to receive retired pay under subsection (d).")
pub rule S7447eElectionPowerRule defeasible {
    label en official "Any judge may elect to receive retired pay under subsection (d).";
    for j: Individual;
    for office: JudicialOffice;
    for on: Date;
    when judge_elects_retired_pay_on(j, office, on);
    then power S7447eElectRetiredPay {
        holder j;
        exercise judge_elects_retired_pay_on(j, office, on);
        valid_when retired_pay_election_valid(j, office, on);
        effect create(elected_retired_pay(j, office));
    };
}
pub relation copy_of_election_transmitted_to_opm(j: Individual) kind empirical;
@source(IRC_S7447A_E, relation = formalizes, coverage = exact, quote = "The chief judge shall transmit to the Office of Personnel Management a copy of each notice filed with the chief judge under this subsection.")
@source(IRC_S7447_E, relation = formalizes, coverage = exact, quote = "The chief judge shall transmit to the Office of Personnel Management a copy of each notice filed with him under this subsection.")
pub rule S7447eTransmitDutyRule strict {
    label en official "The chief judge shall transmit to the Office of Personnel Management a copy of each notice filed with him under this subsection.";
    for cj: Individual;
    for j: Individual;
    for office: JudicialOffice;
    when is_chief_judge(cj)
        and election_notice_filed_with(j, office, "chief judge");
    then duty S7447eTransmitCopyToOpm {
        bearer cj;
        beneficiary OfficeOfPersonnelManagement;
        goal achievement {
            condition copy_of_election_transmitted_to_opm(j);
            window [-infinity, infinity];
        }
    };
}

// --- (f) Forfeitures ----------------------------------------------------------------

pub relation first_day_failed_recalled_duties_in_year(j: Individual, on: Date) kind empirical {
    label en official "fails to perform judicial duties required of him by subsection (c) during any calendar year (the 1st day on which he so fails)";
}
pub relation retired_pay_forfeited_for_period(j: Individual, fromDate: Date, toDate: Date) kind institutional;
@source(IRC_S7447_F, relation = formalizes, coverage = exact, quote = "such individual shall forfeit all rights to retired pay under subsection (d) for the 1-year period which begins on the 1st day on which he so fails to perform such duties.")
pub rule S7447f1OneYearForfeiture defeasible {
    label en official "such individual shall forfeit all rights to retired pay under subsection (d) for the 1-year period which begins on the 1st day on which he so fails to perform such duties.";
    for j: Individual;
    for failedOn: Date;
    when elected_retired_pay(j, TaxCourtJudgeOffice)
        and first_day_failed_recalled_duties_in_year(j, failedOn)
        and not_known(retired_pay_frozen(j));
    then retired_pay_forfeited_for_period(j, failedOn, add_calendar_period(failedOn, 1 calendar_year));
}
pub relation first_day_federal_tax_services_performed(j: Individual, on: Date) kind empirical {
    label en official "performs (or supervises or directs the performance of) legal or accounting services in the field of Federal taxation for his client, his employer, or any of his employer's clients (the 1st day on which he engages in any such activity)";
}
pub relation retired_pay_permanently_forfeited_from(j: Individual, fromDate: Date) kind institutional;
@source(IRC_S7447_F, relation = formalizes, coverage = exact, quote = "such individual shall forfeit all rights to retired pay under subsection (d) for all periods beginning on or after the 1st day on which he engages in any such activity.")
pub rule S7447f2PermanentForfeiture defeasible {
    label en official "such individual shall forfeit all rights to retired pay under subsection (d) for all periods beginning on or after the 1st day on which he engages in any such activity.";
    for j: Individual;
    for onDate: Date;
    when elected_retired_pay(j, TaxCourtJudgeOffice)
        and first_day_federal_tax_services_performed(j, onDate)
        and not_known(retired_pay_frozen(j));
    then retired_pay_permanently_forfeited_from(j, onDate);
    unless federal_civil_office_or_employment(j) and first_day_federal_tax_services_performed(j, onDate);
}
pub relation federal_civil_office_or_employment(j: Individual) kind empirical {
    label en official "any civil office or employment under the Government of the United States";
}
pub relation compensated_government_service_period(j: Individual, fromDate: Date, toDate: Date) kind empirical {
    label en official "accepts compensation for civil office or employment under the Government of the United States (other than the performance of judicial duties pursuant to subsection (c)) for the period for which such compensation is received";
}
@source(IRC_S7447_F, relation = formalizes, coverage = exact, quote = "such individual shall forfeit all rights to retired pay under subsection (d) for the period for which such compensation is received.")
pub rule S7447f3SuspensionDuringGovernmentPay defeasible {
    label en official "such individual shall forfeit all rights to retired pay under subsection (d) for the period for which such compensation is received.";
    for j: Individual;
    for fromDate: Date;
    for toDate: Date;
    when elected_retired_pay(j, TaxCourtJudgeOffice)
        and compensated_government_service_period(j, fromDate, toDate);
    then retired_pay_forfeited_for_period(j, fromDate, toDate);
}
pub relation freeze_election_made_on(j: Individual, on: Date) kind empirical;
pub relation freeze_election_effective_on(j: Individual, on: Date) kind institutional {
    label en official "the 1st day of the 1st month following the month in which the election is made (typed input: TECH-GAPS G2906)";
}
pub relation retired_pay_at_freeze_election(j: Individual, amount: Money) kind empirical;
pub relation freeze_election_permitted(j: Individual, on: Date) kind institutional;
pub relation currently_receiving_retired_pay(j: Individual) kind empirical {
    label en official "while the individual is receiving retired pay";
}
pub relation freeze_election_timing_ok(j: Individual, on: Date) kind institutional {
    label en unofficial "the freeze election is made during the period during which the individual may make an election to receive retired pay, or while the individual is receiving retired pay";
}
@source(IRC_S7447_F, relation = formalizes, coverage = exact, quote = "(ii) may be made only during the period during which the individual may make an election to receive retired pay or while the individual is receiving retired pay, and")
pub rule S7447f4BiiDuringElectionPeriod defeasible {
    label en official "(ii) may be made only during the period during which the individual may make an election to receive retired pay or while the individual is receiving retired pay, and";
    for j: Individual;
    for on: Date;
    when freeze_election_made_on(j, on)
        and retired_pay_election_timely(j, TaxCourtJudgeOffice, on);
    then freeze_election_timing_ok(j, on);
}
@source(IRC_S7447_F, relation = formalizes, coverage = exact, quote = "(ii) may be made only during the period during which the individual may make an election to receive retired pay or while the individual is receiving retired pay, and")
pub rule S7447f4BiiWhileReceivingPay defeasible {
    label en official "(ii) may be made only during the period during which the individual may make an election to receive retired pay or while the individual is receiving retired pay, and";
    for j: Individual;
    for on: Date;
    when freeze_election_made_on(j, on)
        and currently_receiving_retired_pay(j);
    then freeze_election_timing_ok(j, on);
}
@source(IRC_S7447_F, relation = formalizes, coverage = exact, quote = "(i) may be made by an individual only if such individual meets the age and service requirements for retirement under paragraph (2) of subsection (b),")
pub rule S7447f4BPermitted defeasible {
    label en official "(i) may be made by an individual only if such individual meets the age and service requirements for retirement under paragraph (2) of subsection (b),";
    for j: Individual;
    for on: Date;
    when freeze_election_made_on(j, on)
        and retirement_table_met(j, TaxCourtJudgeOffice)
        and freeze_election_timing_ok(j, on)
        and election_filed_with_proper_recipient(j, TaxCourtJudgeOffice);
    then freeze_election_permitted(j, on);
}
pub relation retired_pay_frozen(j: Individual) kind institutional;
@source(IRC_S7447_F, relation = formalizes, coverage = exact, quote = "If any individual makes an election under this paragraph—")
pub rule S7447f4FreezePowerRule defeasible {
    label en official "If any individual makes an election under this paragraph—";
    for j: Individual;
    for on: Date;
    when freeze_election_made_on(j, on);
    then power S7447f4ElectToFreezeRetiredPay {
        holder j;
        exercise freeze_election_made_on(j, on);
        valid_when freeze_election_permitted(j, on);
        effect retired_pay_frozen(j);
    };
}
pub relation frozen_retired_pay_amount(j: Individual, amount: Money) kind institutional;
@source(IRC_S7447_F, relation = formalizes, coverage = exact, quote = "(ii) the retired pay under subsection (d) payable to such individual for periods beginning on or after the date such election takes effect shall be equal to the retired pay to which such individual would be entitled without regard to this clause at the time of such election.")
pub rule S7447f4AiiFrozenAmount defeasible {
    label en official "(ii) the retired pay under subsection (d) payable to such individual for periods beginning on or after the date such election takes effect shall be equal to the retired pay to which such individual would be entitled without regard to this clause at the time of such election.";
    for j: Individual;
    for amount: Money;
    when retired_pay_frozen(j)
        and retired_pay_at_freeze_election(j, amount);
    then frozen_retired_pay_amount(j, amount);
}

// --- (g), (h), (i), (k) -----------------------------------------------------------------

pub relation csrs_annuity_paid_for_service(j: Individual) kind empirical {
    label en official "annuity or other payment under the civil service retirement laws with respect to any service performed by such individual";
}
@source(IRC_S7447_G, relation = formalizes, coverage = exact, quote = "(A) no annuity or other payment shall be payable to any person under the civil service retirement laws with respect to any service performed by such individual")
pub rule S7447g2ANoCsrsAnnuityRule strict {
    label en official "(A) no annuity or other payment shall be payable to any person under the civil service retirement laws with respect to any service performed by such individual";
    for j: Individual;
    when elected_retired_pay(j, TaxCourtJudgeOffice);
    then prohibition S7447g2ANoCivilServiceAnnuity {
        bearer OfficeOfPersonnelManagement;
        action csrs_annuity_paid_for_service(j);
        window [-infinity, infinity];
    };
}
pub relation csrs_deduction_made_after_election(j: Individual) kind empirical {
    label en official "deduction for purposes of the Civil Service Retirement and Disability Fund from retired pay or from any other salary, pay, or compensation payable to him, for any period beginning after the day on which such election is filed";
}
@source(IRC_S7447_G, relation = formalizes, coverage = exact, quote = "(B) no deduction for purposes of the Civil Service Retirement and Disability Fund shall be made from retired pay payable to him under subsection (d) or from any other salary, pay, or compensation payable to him, for any period beginning after the day on which such election is filed; and")
pub rule S7447g2BNoCsrdfDeductionRule strict {
    label en official "(B) no deduction for purposes of the Civil Service Retirement and Disability Fund shall be made from retired pay payable to him under subsection (d) or from any other salary, pay, or compensation payable to him, for any period beginning after the day on which such election is filed; and";
    for j: Individual;
    when elected_retired_pay(j, TaxCourtJudgeOffice);
    then prohibition S7447g2BNoCsrdfDeduction {
        bearer us.irc.core::TaxCourt;
        action csrs_deduction_made_after_election(j);
        window [-infinity, infinity];
    };
}
pub relation lump_sum_credit_application_made(j: Individual) kind empirical;
pub relation lump_sum_credit_paid(j: Individual) kind empirical {
    label en official "the lump-sum credit computed under sections 8331(8) and 8401(19) of title 5 of the United States Code";
}
@source(IRC_S7447_G, relation = formalizes, coverage = exact, quote = "(C) such individual shall be paid the lump-sum credit computed under sections 8331(8) and 8401(19) of title 5 of the United States Code upon making application therefor with the Office of Personnel Management.")
pub rule S7447g2CLumpSumDutyRule strict {
    label en official "(C) such individual shall be paid the lump-sum credit computed under sections 8331(8) and 8401(19) of title 5 of the United States Code upon making application therefor with the Office of Personnel Management.";
    for j: Individual;
    when elected_retired_pay(j, TaxCourtJudgeOffice)
        and lump_sum_credit_application_made(j);
    then duty S7447g2CPayLumpSumCredit {
        bearer OfficeOfPersonnelManagement;
        beneficiary j;
        goal achievement {
            condition lump_sum_credit_paid(j);
            window [-infinity, infinity];
        }
    };
}
pub relation judge_certified_disability_to_president(j: Individual) kind empirical {
    label en official "shall certify to the President his disability in writing";
}
@source(IRC_S7447_H, relation = formalizes, coverage = exact, quote = "Any judge who becomes permanently disabled from performing his duties shall certify to the President his disability in writing.")
pub rule S7447h1CertifyDutyRule strict {
    label en official "Any judge who becomes permanently disabled from performing his duties shall certify to the President his disability in writing.";
    for j: Individual;
    when judicial_officer_permanently_disabled(j, TaxCourtJudgeOffice);
    then duty S7447h1CertifyDisability {
        bearer j;
        goal achievement {
            condition judge_certified_disability_to_president(j);
            window [-infinity, infinity];
        }
    };
}
pub relation chief_judge_disability_retirement_concurred_by_president(j: Individual) kind empirical {
    label en official "If the chief judge retires for disability, his retirement shall not take effect until concurred in by the President";
}
pub relation disability_retirement_takes_effect(j: Individual) kind institutional;
@source(IRC_S7447_H, relation = formalizes, coverage = exact, quote = "If the chief judge retires for disability, his retirement shall not take effect until concurred in by the President.")
pub rule S7447h1ChiefJudgeNeedsConcurrence defeasible {
    label en official "If the chief judge retires for disability, his retirement shall not take effect until concurred in by the President.";
    for j: Individual;
    when chief_judge_of(j)
        and judicial_officer_permanently_disabled(j, TaxCourtJudgeOffice)
        and chief_judge_disability_retirement_concurred_by_president(j);
    then disability_retirement_takes_effect(j);
}
pub relation certificate_of_disability_signed_by_chief_judge_furnished(j: Individual) kind empirical {
    label en official "he shall furnish to the President a certificate of disability signed by the chief judge";
}
@source(IRC_S7447_H, relation = formalizes, coverage = exact, quote = "If any other judge retires for disability, he shall furnish to the President a certificate of disability signed by the chief judge.")
pub rule S7447h1OtherJudgeCertificateDutyRule strict {
    label en official "If any other judge retires for disability, he shall furnish to the President a certificate of disability signed by the chief judge.";
    for j: Individual;
    when judicial_officer_permanently_disabled(j, TaxCourtJudgeOffice)
        and judicial_officer_retired(j, TaxCourtJudgeOffice)
        and not_known(chief_judge_of(j));
    then duty S7447h1FurnishCertificateOfDisability {
        bearer j;
        goal achievement {
            condition certificate_of_disability_signed_by_chief_judge_furnished(j);
            window [-infinity, infinity];
        }
    };
}
external judgment relation president_finds_judge_unable_to_discharge_duties(j: Individual) {
    authority President;
    label en official "the President finds that such judge is unable to discharge efficiently all the duties of his office by reason of permanent mental or physical disability";
}
external judgment relation president_finds_additional_judge_necessary(j: Individual) {
    authority President;
    label en official "the appointment of an additional judge is necessary for the efficient dispatch of business";
}
pub relation president_declares_disabled_judge_retired(j: Individual) kind empirical;
pub relation judge_did_not_retire_despite_disability(j: Individual) kind empirical {
    label en official "any judge who becomes permanently disabled from performing his duties does not retire";
}
@source(IRC_S7447_H, relation = formalizes, coverage = exact, quote = "the President shall declare such judge to be retired.")
pub rule S7447h2PresidentDeclaresDutyRule defeasible {
    label en official "the President shall declare such judge to be retired.";
    for j: Individual;
    when judge_did_not_retire_despite_disability(j)
        and president_finds_judge_unable_to_discharge_duties(j)
        and president_finds_additional_judge_necessary(j);
    then duty S7447h2DeclareJudgeRetired {
        bearer President;
        goal achievement {
            condition president_declares_disabled_judge_retired(j);
            window [-infinity, infinity];
        }
    };
}
pub relation judge_revokes_retired_pay_election_on(j: Individual, office: JudicialOffice, on: Date) kind empirical;
pub relation first_day_retired_pay_would_accrue(j: Individual, office: JudicialOffice, on: Date) kind empirical;
pub relation revocation_within_time(j: Individual, office: JudicialOffice, on: Date) kind institutional;
pub relation revocation_notice_filed_with_opm(j: Individual, office: JudicialOffice) kind empirical {
    label en official "by filing a notice thereof in writing with the Office of Personnel Management";
}
pub relation revocation_copy_transmitted_to_chief_judge(j: Individual) kind empirical;
@source(IRC_S7447_I, relation = formalizes, coverage = exact, quote = "The Office of Personnel Management shall transmit to the chief judge a copy of each notice filed under this subsection.")
pub rule S7447i2OpmTransmitDutyRule strict {
    label en official "The Office of Personnel Management shall transmit to the chief judge a copy of each notice filed under this subsection.";
    for j: Individual;
    for office: JudicialOffice;
    when revocation_notice_filed_with_opm(j, office);
    then duty S7447i2OpmTransmitsCopyToChiefJudge {
        bearer OfficeOfPersonnelManagement;
        goal achievement {
            condition revocation_copy_transmitted_to_chief_judge(j);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S7447_I, relation = formalizes, coverage = exact, quote = "an individual who has filed an election to receive retired pay under subsection (d) may revoke such election at any time before the first day on which retired pay (or compensation under subsection (c) in lieu of retired pay) would (but for such revocation) begin to accrue with respect to such individual.")
pub rule S7447i1RevocationTime defeasible {
    label en official "an individual who has filed an election to receive retired pay under subsection (d) may revoke such election at any time before the first day on which retired pay (or compensation under subsection (c) in lieu of retired pay) would (but for such revocation) begin to accrue with respect to such individual.";
    for j: Individual;
    for office: JudicialOffice;
    for on: Date;
    for firstDay: Date;
    when elected_retired_pay(j, office)
        and judge_revokes_retired_pay_election_on(j, office, on)
        and revocation_notice_filed_with_opm(j, office)
        and first_day_retired_pay_would_accrue(j, office, firstDay)
        and on < firstDay;
    then revocation_within_time(j, office, on);
}
pub relation retired_pay_election_revoked(j: Individual, office: JudicialOffice) kind institutional;
@source(IRC_S7447_I, relation = formalizes, coverage = exact, quote = "Notwithstanding subsection (e)(2), an individual who has filed an election to receive retired pay under subsection (d) may revoke such election")
pub rule S7447i1RevokePowerRule defeasible {
    label en official "Notwithstanding subsection (e)(2), an individual who has filed an election to receive retired pay under subsection (d) may revoke such election";
    for j: Individual;
    for office: JudicialOffice;
    for on: Date;
    when judge_revokes_retired_pay_election_on(j, office, on);
    then power S7447i1RevokeElection {
        holder j;
        exercise judge_revokes_retired_pay_election_on(j, office, on);
        valid_when revocation_within_time(j, office, on);
        effect retired_pay_election_revoked(j, office);
    };
}
pub relation treated_as_not_having_elected_retired_pay(j: Individual, office: JudicialOffice) kind institutional;
@source(IRC_S7447_I, relation = formalizes, coverage = exact, quote = "(A) for purposes of this section, the individual shall be treated as not having filed an election to receive retired pay under subsection (d),")
pub rule S7447i3ATreatedAsNotElected strict {
    label en official "(A) for purposes of this section, the individual shall be treated as not having filed an election to receive retired pay under subsection (d),";
    for j: Individual;
    for office: JudicialOffice;
    when retired_pay_election_revoked(j, office);
    then treated_as_not_having_elected_retired_pay(j, office);
}
pub relation treated_as_not_having_survivors_election(j: Individual) kind institutional;
@source(IRC_S7447_I, relation = formalizes, coverage = exact, quote = "(i) the individual shall be treated as not having filed an election under section 7448(b), and")
pub rule S7447i3BiTreatedAsNoSurvivorsElection strict {
    label en official "(i) the individual shall be treated as not having filed an election under section 7448(b), and";
    for j: Individual;
    for office: JudicialOffice;
    when retired_pay_election_revoked(j, office);
    then treated_as_not_having_survivors_election(j);
}
pub relation service_deductions_withheld_or_deposited(j: Individual) kind empirical {
    label en official "either there has been deducted and withheld the amount required by the civil service retirement laws or there has been deposited in the Civil Service Retirement and Disability Fund an amount equal to the amount so required, with interest";
}
pub relation service_credit_allowed_after_revocation(j: Individual) kind institutional;
@source(IRC_S7447_I, relation = formalizes, coverage = exact, quote = "(C) no credit shall be allowed for any service as a judge of the Tax Court unless with respect to such service either there has been deducted and withheld the amount required by the civil service retirement laws or there has been deposited in the Civil Service Retirement and Disability Fund an amount equal to the amount so required, with interest,")
pub rule S7447i3CServiceCredit strict {
    label en official "(C) no credit shall be allowed for any service as a judge of the Tax Court unless with respect to such service either there has been deducted and withheld the amount required by the civil service retirement laws or there has been deposited in the Civil Service Retirement and Disability Fund an amount equal to the amount so required, with interest,";
    for j: Individual;
    for office: JudicialOffice;
    when retired_pay_election_revoked(j, office)
        and service_deductions_withheld_or_deposited(j);
    then service_credit_allowed_after_revocation(j);
}
pub relation additional_court_contribution_deposited(j: Individual) kind empirical {
    label en official "the Tax Court shall deposit in the Civil Service Retirement and Disability Fund an amount equal to the additional amount it would have contributed to such Fund but for the election under subsection (e)";
}
@source(IRC_S7447_I, relation = formalizes, coverage = exact, quote = "(D) the Tax Court shall deposit in the Civil Service Retirement and Disability Fund an amount equal to the additional amount it would have contributed to such Fund but for the election under subsection (e), and")
pub rule S7447i3DDepositDutyRule strict {
    label en official "(D) the Tax Court shall deposit in the Civil Service Retirement and Disability Fund an amount equal to the additional amount it would have contributed to such Fund but for the election under subsection (e), and";
    for j: Individual;
    for office: JudicialOffice;
    when retired_pay_election_revoked(j, office);
    then duty S7447i3DDepositAdditionalContribution {
        bearer us.irc.core::TaxCourt;
        goal achievement {
            condition additional_court_contribution_deposited(j);
            window [-infinity, infinity];
        }
    };
}
pub relation service_treated_as_with_deductions_and_contributions(j: Individual) kind institutional;
@source(IRC_S7447_I, relation = formalizes, coverage = exact, quote = "(E) if subparagraph (D) is complied with, service on the Tax Court shall be treated as service with respect to which deductions and contributions had been made during the period of service.")
pub rule S7447i3EServiceTreatedAsContributed strict {
    label en official "(E) if subparagraph (D) is complied with, service on the Tax Court shall be treated as service with respect to which deductions and contributions had been made during the period of service.";
    for j: Individual;
    for office: JudicialOffice;
    when retired_pay_election_revoked(j, office)
        and additional_court_contribution_deposited(j);
    then service_treated_as_with_deductions_and_contributions(j);
}
pub relation retired_teaching_compensation_approved(j: Individual, calendarYear: Integer) kind empirical {
    label en official "compensation for teaching approved under section 502(a)(5) of the Ethics in Government Act of 1978";
}
pub relation retired_judge_met_recall_requirements_or_disability_retired(j: Individual, calendarYear: Integer) kind empirical {
    label en official "for teaching performed during any calendar year for which such a judge has met the requirements of subsection (c), as certified by the chief judge, or has retired under subsection (b)(4)";
}
pub relation teaching_compensation_not_outside_earned_income(j: Individual, calendarYear: Integer) kind institutional;
@source(IRC_S7447_K, relation = formalizes, coverage = exact, quote = "any compensation for teaching approved under section 502(a)(5) of such Act shall not be treated as outside earned income when received by a judge of the United States Tax Court who has retired under subsection (b)")
pub rule S7447kTeachingCompensation strict {
    label en official "any compensation for teaching approved under section 502(a)(5) of such Act shall not be treated as outside earned income when received by a judge of the United States Tax Court who has retired under subsection (b)";
    for j: Individual;
    for calendarYear: Integer;
    when retired_teaching_compensation_approved(j, calendarYear)
        and retired_judge_met_recall_requirements_or_disability_retired(j, calendarYear);
    then teaching_compensation_not_outside_earned_income(j, calendarYear);
}
pub relation judge_elects_to_contribute_to_thrift_savings_fund(j: Individual, on: Date) kind empirical;
pub relation election_period_under_8432b(j: Individual, on: Date) kind empirical {
    label en official "a period provided under section 8432(b) of title 5, United States Code, for individuals subject to chapter 84 of such title";
}
pub relation thrift_savings_election_effective(j: Individual, on: Date) kind institutional;
@source(IRC_S7447_J, relation = formalizes, coverage = exact, quote = "A judge of the Tax Court may elect to contribute to the Thrift Savings Fund established by section 8437 of title 5, United States Code.")
pub rule S7447j1ElectPowerRule strict {
    label en official "A judge of the Tax Court may elect to contribute to the Thrift Savings Fund established by section 8437 of title 5, United States Code.";
    for j: Individual;
    for on: Date;
    when judge_elects_to_contribute_to_thrift_savings_fund(j, on);
    then power S7447j1ElectThriftSavingsContributions {
        holder j;
        exercise judge_elects_to_contribute_to_thrift_savings_fund(j, on);
        valid_when election_period_under_8432b(j, on);
        effect thrift_savings_election_effective(j, on);
    };
}
pub relation government_contribution_8432c_made_for(j: Individual) kind empirical {
    label en official "contributions under section 8432(c) of title 5, United States Code";
}
@source(IRC_S7447_J, relation = formalizes, coverage = exact, quote = "No contributions under section 8432(c) of title 5, United States Code, shall be made for the benefit of a judge who has filed an election to receive retired pay under subsection (e).")
pub rule S7447j3BNoGovernmentContributionRule strict {
    label en official "No contributions under section 8432(c) of title 5, United States Code, shall be made for the benefit of a judge who has filed an election to receive retired pay under subsection (e).";
    for j: Individual;
    when elected_retired_pay(j, TaxCourtJudgeOffice);
    then prohibition S7447j3BNoGovernmentContribution {
        bearer us.irc.core::TaxCourt;
        action government_contribution_8432c_made_for(j);
        window [-infinity, infinity];
    };
}

// --- §7447A specials -----------------------------------------------------------------------

pub relation stj_election_notice_filed_with_chief_judge(j: Individual, on: Date) kind empirical;
pub relation stj_election_made_within_60_days_after_leaving(j: Individual, leftOn: Date, on: Date) kind institutional;
pub relation stj_left_office_on(j: Individual, on: Date) kind empirical;
@source(IRC_S7447A_E, relation = formalizes, coverage = exact, quote = "(1) may be made only while an individual is a special trial judge (except that in the case of an individual who fails to be reappointed as a special trial judge, such election may be made within 60 days after such individual leaves office as a special trial judge),")
pub rule S7447AeWithin60DaysAfterLeaving strict {
    label en official "(1) may be made only while an individual is a special trial judge (except that in the case of an individual who fails to be reappointed as a special trial judge, such election may be made within 60 days after such individual leaves office as a special trial judge),";
    for j: Individual;
    for leftOn: Date;
    for on: Date;
    when stj_left_office_on(j, leftOn)
        and judge_elects_retired_pay_on(j, SpecialTrialJudgeOffice, on)
        and on <= add_calendar_period(leftOn, 60 calendar_day);
    then stj_election_made_within_60_days_after_leaving(j, leftOn, on);
}
@source(IRC_S7447A_E, relation = formalizes, coverage = exact, quote = "(1) may be made only while an individual is a special trial judge (except that in the case of an individual who fails to be reappointed as a special trial judge, such election may be made within 60 days after such individual leaves office as a special trial judge),")
pub rule S7447AeTimelyAfterLeaving defeasible {
    label en official "(1) may be made only while an individual is a special trial judge (except that in the case of an individual who fails to be reappointed as a special trial judge, such election may be made within 60 days after such individual leaves office as a special trial judge),";
    for j: Individual;
    for leftOn: Date;
    for on: Date;
    when stj_election_made_within_60_days_after_leaving(j, leftOn, on);
    then retired_pay_election_timely(j, SpecialTrialJudgeOffice, on);
}
@source(IRC_S7447A_E, relation = formalizes, coverage = exact, quote = "(3) shall be made by filing notice thereof in writing with the chief judge.")
pub rule S7447Ae3FiledWithChiefJudge defeasible {
    label en official "(3) shall be made by filing notice thereof in writing with the chief judge.";
    for j: Individual;
    when election_notice_filed_with(j, SpecialTrialJudgeOffice, "chief judge");
    then election_filed_with_proper_recipient(j, SpecialTrialJudgeOffice);
}
