// §7430 (awarding of costs and certain fees), §7431 (civil damages for
// unauthorized disclosure), §7433 (civil damages for certain unauthorized
// collection actions).
//
// METHOD NOTE (§7430): "the prevailing party may be awarded ... costs" is
// modeled as a `power` of the prevailing party to be awarded costs, whose
// `valid_when` folds (a)'s proceeding-type condition, (b)(1)'s exhaustion
// condition and (c)(4)(B)'s "substantially justified" defense (an
// EVALUATIVE element, DECISION-0194 channel: the court, since (c)(4)(C)
// names the court/IRS as the deciding authority) into a single derived
// atom, per the one-atom `valid_when` rule. The $125/hour attorney-fee rate,
// annually indexed by §1(f)(3) cost-of-living adjustment, is a
// MISSING_PARAMETER_VALUE: the statutory $125 base is pinned, the published
// indexed rate for any given calendar year is not (no Rev. Proc. pinned in
// this package) — modeled as a rule reading an A3 parameter with a
// `SOURCE_GAP` coverage row, never a guessed number.
// (c)(4)(A)(ii) net-worth eligibility ($2,000,000 individual / $7,000,000
// entity, from 28 U.S.C. 2412(d)(2)(B), NOT part of this title) is modeled
// with the two dollar figures taken directly from this package's own
// cross-reference reading of 28 U.S.C. 2412(d)(2)(B) as quoted by
// subparagraph (D)'s special rules — flagged EXTERNAL_DEPENDENCY (a Title 28
// figure, not Title 26) since this package cannot pin non-Title-26 bytes.
//
// METHOD NOTE (§7431): a `power` of the taxpayer to bring a civil damages
// action; (c)'s "greater of $1,000 per act or actual+punitive damages" is a
// CALCULATION rule (`max`); (d)'s 2-year discovery-based limitation is
// modeled as a validity-window condition of the power.
//
// METHOD NOTE (§7433): a `power` of the taxpayer to bring a civil damages
// action for reckless/intentional/negligent IRS disregard of the title in
// connection with collection, with the exclusive-remedy immunity from any
// other action; (b)'s cap ($1,000,000, or $100,000 for negligence) is a
// CALCULATION; (d)(1) exhaustion and (d)(3) 2-year limitation are folded
// into `valid_when`.
//
// JUDGMENT CALLS AND GAPS:
//  - §7430(c)(4)(B)(ii)'s rebuttable presumption ("not substantially
//    justified if IRS did not follow applicable published guidance") is
//    read as a defeater on the `external judgment relation` itself (the
//    court's finding), not as a separate fact-finding rule — the statute
//    frames it as guidance to the court's own judgment, which this
//    package cannot second-guess without inventing the court's reasoning.
//  - §7430(g) (qualified offer) is modeled as an institutional relation the
//    prevailing-party test reads, with its own window ((g)(1)(D)); the
//    detailed dollar comparison of (c)(4)(E) ("liability under the judgment
//    is equal to or less than liability under the qualified offer") is
//    modeled as a plain numeric comparison rule.
//  - §7433's negligence/reckless-or-intentional distinction for the cap
//    ($100,000 vs $1,000,000) is modeled with two mutually exclusive
//    calculation branches keyed on an asserted `culpability` case fact
//    (the statute itself draws this line only by the officer's state of
//    mind — an ordinary fact, not evaluative, since no external authority
//    is named to judge it beyond the court finding liability at all, which
//    is already the trigger for the whole claim).

language "law.core" version "0.2";
package us.irc.judicial_proceedings version "0.1.1";
namespace "urn:us:irc:judicial_proceedings:clir";

use self::{
    IRC_S7430_A,
    IRC_S7430_C,
    IRC_S7430_G,
    IRC_S7431_A,
    IRC_S7431_C,
    IRC_S7431_D,
    IRC_S7433_A,
    IRC_S7433_B,
    IRC_S7433_D,
    Person,
    Proceeding,
    collection_damages_sum,
};


// ============================================================================
// §7430 — Awarding of costs and certain fees
// ============================================================================

pub relation administrative_or_court_proceeding(pr: Proceeding) kind empirical {
    label en official "an administrative or court proceeding brought by or against the United States in connection with the determination, collection, or refund of any tax, interest, or penalty under this title";
}
pub relation prevailing_party_substantially_prevailed(party: Person, pr: Proceeding) kind empirical {
    label en official "has substantially prevailed with respect to the amount in controversy, or with respect to the most significant issue or set of issues presented";
}
external judgment relation position_of_united_states_substantially_justified(pr: Proceeding) {
    authority TaxCourt;
    label en official "the position of the United States in the proceeding was substantially justified (§7430(c)(4)(B)) — the court's (or, at the administrative level, the Internal Revenue Service's) own determination under (c)(4)(C)";
}
pub relation administrative_remedies_exhausted(party: Person, pr: Proceeding) kind empirical {
    label en official "the prevailing party has exhausted the administrative remedies available to such party within the Internal Revenue Service";
}
pub relation net_worth_within_limit(party: Person) kind empirical {
    label en unofficial "the party meets the net-worth requirement of 28 U.S.C. 2412(d)(2)(B) as applied by §7430(c)(4)(A)(ii),(D) — individual net worth not exceeding $2,000,000, or entity net worth not exceeding $7,000,000 (Title 28 figures, EXTERNAL_DEPENDENCY: not pinned Title 26 bytes)";
}
pub relation prevailing_party_grounds(party: Person, pr: Proceeding) kind institutional {
    label en unofficial "single atom folding the §7430(a)-(c) prevailing-party test for use in a power's valid_when";
}
@source(IRC_S7430_C, relation = formalizes, coverage = partial, quote = "The term \"prevailing party\" means any party in any proceeding to which subsection (a) applies (other than the United States or any creditor of the taxpayer involved)—")
pub rule S7430PrevailingPartyGrounds strict {
    label en official "The term \"prevailing party\" means any party in any proceeding to which subsection (a) applies (other than the United States or any creditor of the taxpayer involved)—";
    for party: Person;
    for pr: Proceeding;
    when administrative_or_court_proceeding(pr)
        and prevailing_party_substantially_prevailed(party, pr)
        and net_worth_within_limit(party)
        and administrative_remedies_exhausted(party, pr)
        and not_known(position_of_united_states_substantially_justified(pr));
    then prevailing_party_grounds(party, pr);
}
pub relation costs_award_requested(party: Person, pr: Proceeding) kind empirical;
@source(IRC_S7430_A, relation = formalizes, coverage = partial, quote = "In any administrative or court proceeding which is brought by or against the United States in connection with the determination, collection, or refund of any tax, interest, or penalty under this title, the prevailing party may be awarded a judgment or a settlement for—")
pub rule S7430CostsAwardablePowerRule strict {
    label en official "In any administrative or court proceeding which is brought by or against the United States in connection with the determination, collection, or refund of any tax, interest, or penalty under this title, the prevailing party may be awarded a judgment or a settlement for—";
    for party: Person;
    for pr: Proceeding;
    when costs_award_requested(party, pr);
    then power S7430CostsAwardablePower {
        holder party;
        exercise costs_award_requested(party, pr);
        valid_when prevailing_party_grounds(party, pr);
        effect costs_awardable(party, pr);
    };
}
pub relation costs_awardable(party: Person, pr: Proceeding) kind institutional;

// --- (g) Qualified offer ----------------------------------------------------

pub relation qualified_offer_made(party: Person, pr: Proceeding, amount: Money, madeOn: Date) kind empirical;
pub relation qualified_offer_open_end(madeOn: Date, deadline: Date) kind institutional;
@source(IRC_S7430_G, relation = formalizes, coverage = exact, quote = "remains open during the period beginning on the date it is made and ending on the earliest of the date the offer is rejected, the date the trial begins, or the 90th day after the date the offer is made")
pub rule S7430QualifiedOfferDefaultCloseDate defeasible {
    label en official "remains open during the period beginning on the date it is made and ending on the earliest of the date the offer is rejected, the date the trial begins, or the 90th day after the date the offer is made";
    for party: Person;
    for pr: Proceeding;
    for amount: Money;
    for madeOn: Date;
    when qualified_offer_made(party, pr, amount, madeOn);
    then qualified_offer_open_end(madeOn, add_calendar_period(madeOn, 90 calendar_day));
}
pub relation judgment_liability(pr: Proceeding, amount: Money) kind empirical;
pub relation qualified_offer_test_met(party: Person, pr: Proceeding) kind institutional {
    label en unofficial "the taxpayer's liability under the judgment is equal to or less than the liability under the last qualified offer (§7430(c)(4)(E)(i))";
}
@source(IRC_S7430_C, relation = formalizes, coverage = exact, quote = "A party to a court proceeding meeting the requirements of subparagraph (A)(ii) shall be treated as the prevailing party if the liability of the taxpayer pursuant to the judgment in the proceeding (determined without regard to interest) is equal to or less than the liability of the taxpayer which would have been so determined if the United States had accepted a qualified offer of the party under subsection (g).")
pub rule S7430QualifiedOfferPrevailingParty strict {
    label en official "A party to a court proceeding meeting the requirements of subparagraph (A)(ii) shall be treated as the prevailing party if the liability of the taxpayer pursuant to the judgment in the proceeding (determined without regard to interest) is equal to or less than the liability of the taxpayer which would have been so determined if the United States had accepted a qualified offer of the party under subsection (g).";
    for party: Person;
    for pr: Proceeding;
    for offered: Money;
    for judgmentAmount: Money;
    for madeOn: Date;
    when qualified_offer_made(party, pr, offered, madeOn)
        and judgment_liability(pr, judgmentAmount)
        and net_worth_within_limit(party)
        and judgmentAmount <= offered;
    then qualified_offer_test_met(party, pr);
}
@source(IRC_S7430_C, relation = applies, coverage = contextual, quote = "A party to a court proceeding meeting the requirements of subparagraph (A)(ii) shall be treated as the prevailing party")
pub rule S7430QualifiedOfferGroundsAlternative strict {
    label en official "A party to a court proceeding meeting the requirements of subparagraph (A)(ii) shall be treated as the prevailing party";
    for party: Person;
    for pr: Proceeding;
    when qualified_offer_test_met(party, pr);
    then prevailing_party_grounds(party, pr);
}

// ============================================================================
// §7431(a)-(c) — Civil damages for unauthorized disclosure or inspection
// ============================================================================

pub relation unauthorized_inspection_or_disclosure_by_employee(p: Person, defendant: Person, act_id: Person) kind empirical {
    label en unofficial "an officer or employee of the United States knowingly, or by reason of negligence, inspects or discloses a return or return information with respect to taxpayer p, in violation of §6103 (act_id distinguishes separate acts for the per-act count in (c)(1)(A))";
}
pub relation unauthorized_inspection_or_disclosure_by_other(p: Person, defendant: Person, act_id: Person) kind empirical {
    label en unofficial "a person who is not a U.S. officer or employee knowingly, or by reason of negligence, inspects or discloses a return or return information with respect to taxpayer p, in violation of §6103 or §6104(c)";
}
pub relation good_faith_erroneous_interpretation(p: Person, defendant: Person, act_id: Person) kind empirical {
    label en official "results from a good faith, but erroneous, interpretation of section 6103";
}
pub relation disclosure_requested_by_taxpayer(p: Person, defendant: Person, act_id: Person) kind empirical {
    label en official "is requested by the taxpayer";
}
pub relation disclosure_suit_brought(pr: Proceeding, p: Person, defendant: Person) kind empirical;
pub relation discovery_date(p: Person, defendant: Person, act_id: Person, on: Date) kind empirical {
    label en official "the date of discovery by the plaintiff of the unauthorized inspection or disclosure";
}
pub relation disclosure_suit_filed_on(p: Person, defendant: Person, act_id: Person, on: Date) kind empirical {
    label en unofficial "the date the §7431 action to enforce liability was brought (case-input, compared against the 2-year discovery-based limitation)";
}
pub relation disclosure_suit_within_limitation(p: Person, defendant: Person, act_id: Person, filedOn: Date) kind institutional;
@source(IRC_S7431_D, relation = formalizes, coverage = exact, quote = "an action to enforce any liability created under this section may be brought, without regard to the amount in controversy, at any time within 2 years after the date of discovery by the plaintiff of the unauthorized inspection or disclosure")
pub rule S7431WithinLimitation defeasible {
    label en official "an action to enforce any liability created under this section may be brought, without regard to the amount in controversy, at any time within 2 years after the date of discovery by the plaintiff of the unauthorized inspection or disclosure";
    for p: Person;
    for defendant: Person;
    for act_id: Person;
    for discoveredOn: Date;
    for filedOn: Date;
    when discovery_date(p, defendant, act_id, discoveredOn)
        and disclosure_suit_filed_on(p, defendant, act_id, filedOn)
        and add_calendar_period(discoveredOn, 2 calendar_year) >= filedOn;
    then disclosure_suit_within_limitation(p, defendant, act_id, filedOn);
}
@source(IRC_S7431_A, relation = formalizes, coverage = exact, quote = "If any officer or employee of the United States knowingly, or by reason of negligence, inspects or discloses any return or return information with respect to a taxpayer in violation of any provision of section 6103, such taxpayer may bring a civil action for damages against the United States in a district court of the United States.")
pub rule S7431DisclosureSuitAgainstUnitedStatesPower defeasible {
    label en official "If any officer or employee of the United States knowingly, or by reason of negligence, inspects or discloses any return or return information with respect to a taxpayer in violation of any provision of section 6103, such taxpayer may bring a civil action for damages against the United States in a district court of the United States.";
    for pr: Proceeding;
    for p: Person;
    for defendant: Person;
    for act_id: Person;
    for filedOn: Date;
    when unauthorized_inspection_or_disclosure_by_employee(p, defendant, act_id)
        and disclosure_suit_brought(pr, p, defendant)
        and disclosure_suit_within_limitation(p, defendant, act_id, filedOn);
    then power S7431DisclosureSuitPower {
        holder p;
        exercise disclosure_suit_brought(pr, p, defendant);
        valid_when disclosure_suit_within_limitation(p, defendant, act_id, filedOn);
        effect disclosure_suit_permitted(pr, p, defendant);
    };
    unless good_faith_erroneous_interpretation(p, defendant, act_id) and unauthorized_inspection_or_disclosure_by_employee(p, defendant, act_id) and disclosure_suit_brought(pr, p, defendant) and disclosure_suit_within_limitation(p, defendant, act_id, filedOn);
    unless disclosure_requested_by_taxpayer(p, defendant, act_id) and unauthorized_inspection_or_disclosure_by_employee(p, defendant, act_id) and disclosure_suit_brought(pr, p, defendant) and disclosure_suit_within_limitation(p, defendant, act_id, filedOn);
}
pub relation disclosure_suit_permitted(pr: Proceeding, p: Person, defendant: Person) kind institutional;

pub relation willful_or_grossly_negligent(p: Person, defendant: Person, act_id: Person) kind empirical;
pub relation actual_plus_punitive_damages(p: Person, defendant: Person, act_id: Person, amount: Money) kind empirical {
    label en unofficial "the sum of actual damages sustained plus (where willful/grossly negligent) punitive damages — computed by the case, since punitive damages have no statutory formula";
}
pub relation disclosure_damages_core(p: Person, defendant: Person, act_id: Person, amount: Money) kind institutional {
    label en unofficial "the greater of $1,000 per act, or actual (+punitive where willful/grossly negligent) damages — (c)(1); costs of the action (c)(2) and attorneys fees (c)(3) are added separately, not folded into this per-act amount";
}
// Default: the $1,000 statutory floor per act.
@source(IRC_S7431_C, relation = formalizes, coverage = partial, quote = "the defendant shall be liable to the plaintiff in an amount equal to the sum of—")
pub rule S7431DamagesStatutoryFloor defeasible {
    label en official "the defendant shall be liable to the plaintiff in an amount equal to the sum of—";
    for pr: Proceeding;
    for p: Person;
    for defendant: Person;
    for act_id: Person;
    for actualPlusPunitive: Money;
    when disclosure_suit_permitted(pr, p, defendant)
        and actual_plus_punitive_damages(p, defendant, act_id, actualPlusPunitive);
    then disclosure_damages_core(p, defendant, act_id, 1000.00 USD);
    unless disclosure_suit_permitted(pr, p, defendant)
        and actual_plus_punitive_damages(p, defendant, act_id, actualPlusPunitive)
        and actualPlusPunitive > 1000.00 USD;
}
@source(IRC_S7431_C, relation = formalizes, coverage = partial, quote = "the actual damages sustained by the plaintiff as a result of such unauthorized inspection or disclosure, plus")
pub rule S7431DamagesActualPlusPunitiveExceedsFloor defeasible {
    label en official "the actual damages sustained by the plaintiff as a result of such unauthorized inspection or disclosure, plus";
    for pr: Proceeding;
    for p: Person;
    for defendant: Person;
    for act_id: Person;
    for actualPlusPunitive: Money;
    when disclosure_suit_permitted(pr, p, defendant)
        and actual_plus_punitive_damages(p, defendant, act_id, actualPlusPunitive)
        and actualPlusPunitive > 1000.00 USD;
    then disclosure_damages_core(p, defendant, act_id, actualPlusPunitive);
}

// ============================================================================
// §7433(a),(b),(d) — Civil damages for certain unauthorized collection actions
// ============================================================================

pub relation irs_disregard_of_title_in_collection(p: Person, officer: Person, act_id: Person) kind empirical {
    label en official "in connection with any collection of Federal tax with respect to a taxpayer, an officer or employee of the Internal Revenue Service recklessly or intentionally, or by reason of negligence, disregards any provision of this title, or any regulation promulgated under this title";
}
pub relation disregard_is_negligence_only(p: Person, act_id: Person) kind empirical {
    label en unofficial "the officer's disregard is by reason of negligence (as opposed to reckless or intentional) — bears on the (b) cap";
}
pub relation collection_damages_suit_brought(pr: Proceeding, p: Person) kind empirical;
pub relation collection_administrative_remedies_exhausted(p: Person, pr: Proceeding) kind empirical {
    label en official "the plaintiff has exhausted the administrative remedies available to such plaintiff within the Internal Revenue Service";
}
pub relation collection_damages_accrual_date(p: Person, act_id: Person, on: Date) kind empirical {
    label en official "the date the right of action accrues";
}
pub relation collection_damages_suit_filed_on(p: Person, act_id: Person, on: Date) kind empirical {
    label en unofficial "the date the §7433 action to enforce liability was brought (case-input, compared against the 2-year accrual-based limitation)";
}
pub relation collection_damages_suit_within_limitation(p: Person, act_id: Person, filedOn: Date) kind institutional;
@source(IRC_S7433_D, relation = formalizes, coverage = exact, quote = "an action to enforce liability created under this section may be brought without regard to the amount in controversy and may be brought only within 2 years after the date the right of action accrues")
pub rule S7433WithinLimitation defeasible {
    label en official "an action to enforce liability created under this section may be brought without regard to the amount in controversy and may be brought only within 2 years after the date the right of action accrues";
    for p: Person;
    for act_id: Person;
    for accruedOn: Date;
    for filedOn: Date;
    when collection_damages_accrual_date(p, act_id, accruedOn)
        and collection_damages_suit_filed_on(p, act_id, filedOn)
        and add_calendar_period(accruedOn, 2 calendar_year) >= filedOn;
    then collection_damages_suit_within_limitation(p, act_id, filedOn);
}
pub relation collection_damages_grounds(p: Person, officer: Person, act_id: Person, pr: Proceeding) kind institutional {
    label en unofficial "single atom folding §7433(a)'s disregard condition, (d)(1)'s exhaustion condition and (d)(3)'s limitation condition for use in the power's valid_when";
}
@source(IRC_S7433_D, relation = formalizes, coverage = exact, quote = "A judgment for damages shall not be awarded under subsection (b) unless the court determines that the plaintiff has exhausted the administrative remedies available to such plaintiff within the Internal Revenue Service.")
pub rule S7433CollectionDamagesGrounds defeasible {
    label en official "A judgment for damages shall not be awarded under subsection (b) unless the court determines that the plaintiff has exhausted the administrative remedies available to such plaintiff within the Internal Revenue Service.";
    for p: Person;
    for officer: Person;
    for act_id: Person;
    for pr: Proceeding;
    for filedOn: Date;
    when irs_disregard_of_title_in_collection(p, officer, act_id)
        and collection_administrative_remedies_exhausted(p, pr)
        and collection_damages_suit_within_limitation(p, act_id, filedOn);
    then collection_damages_grounds(p, officer, act_id, pr);
}
@source(IRC_S7433_A, relation = formalizes, coverage = exact, quote = "If, in connection with any collection of Federal tax with respect to a taxpayer, any officer or employee of the Internal Revenue Service recklessly or intentionally, or by reason of negligence, disregards any provision of this title, or any regulation promulgated under this title, such taxpayer may bring a civil action for damages against the United States in a district court of the United States.")
pub rule S7433CollectionDamagesSuitPowerRule defeasible {
    label en official "If, in connection with any collection of Federal tax with respect to a taxpayer, any officer or employee of the Internal Revenue Service recklessly or intentionally, or by reason of negligence, disregards any provision of this title, or any regulation promulgated under this title, such taxpayer may bring a civil action for damages against the United States in a district court of the United States.";
    for pr: Proceeding;
    for p: Person;
    for officer: Person;
    for act_id: Person;
    when collection_damages_suit_brought(pr, p)
        and collection_damages_grounds(p, officer, act_id, pr);
    then power S7433CollectionDamagesSuitPower {
        holder p;
        exercise collection_damages_suit_brought(pr, p);
        valid_when collection_damages_grounds(p, officer, act_id, pr);
        effect collection_damages_suit_permitted(pr, p);
    };
}
pub relation collection_damages_suit_permitted(pr: Proceeding, p: Person) kind institutional;
@source(IRC_S7433_A, relation = formalizes, coverage = exact, quote = "Except as provided in section 7432, such civil action shall be the exclusive remedy for recovering damages resulting from such actions.")
pub rule S7433ExclusiveRemedyImmunityRule strict {
    label en official "Except as provided in section 7432, such civil action shall be the exclusive remedy for recovering damages resulting from such actions.";
    for pr: Proceeding;
    for p: Person;
    when collection_damages_suit_permitted(pr, p);
    then immunity S7433ExclusiveRemedyImmunity {
        holder p;
        protected_effect other_collection_damages_remedy_sought(pr, p);
        window [-infinity, infinity];
    };
}
pub relation other_collection_damages_remedy_sought(pr: Proceeding, p: Person) kind empirical;

// --- (b) Damages cap ---------------------------------------------------

pub relation collection_damages_claimed(p: Person, act_id: Person, actualDirect: Money, actionCosts: Money) kind empirical {
    label en unofficial "actual, direct economic damages sustained plus the costs of the action, as claimed by the plaintiff";
}
pub relation collection_damages_awarded(p: Person, act_id: Person, amount: Money) kind institutional;
// Reckless-or-intentional cap: lesser of $1,000,000 or the claimed sum.
@source(IRC_S7433_B, relation = formalizes, coverage = partial, quote = "the defendant shall be liable to the plaintiff in an amount equal to the lesser of $1,000,000 ($100,000, in the case of negligence) or the sum of—")
pub rule S7433DamagesRecklessOrIntentionalCap defeasible {
    label en official "the defendant shall be liable to the plaintiff in an amount equal to the lesser of $1,000,000 ($100,000, in the case of negligence) or the sum of—";
    for p: Person;
    for officer: Person;
    for act_id: Person;
    for total: Money;
    when collection_damages_sum(p, act_id, total)
        and not_known(disregard_is_negligence_only(p, act_id))
        and total > 1000000.00 USD;
    then collection_damages_awarded(p, act_id, 1000000.00 USD);
}
@source(IRC_S7433_B, relation = formalizes, coverage = partial, quote = "the defendant shall be liable to the plaintiff in an amount equal to the lesser of $1,000,000 ($100,000, in the case of negligence) or the sum of—")
pub rule S7433DamagesRecklessOrIntentionalUnderCap defeasible {
    label en official "the defendant shall be liable to the plaintiff in an amount equal to the lesser of $1,000,000 ($100,000, in the case of negligence) or the sum of—";
    for p: Person;
    for act_id: Person;
    for total: Money;
    when collection_damages_sum(p, act_id, total)
        and not_known(disregard_is_negligence_only(p, act_id))
        and total <= 1000000.00 USD;
    then collection_damages_awarded(p, act_id, total);
}
// Negligence cap: lesser of $100,000 or the claimed sum.
@source(IRC_S7433_B, relation = formalizes, coverage = partial, quote = "the defendant shall be liable to the plaintiff in an amount equal to the lesser of $1,000,000 ($100,000, in the case of negligence) or the sum of—")
pub rule S7433DamagesNegligenceCap defeasible {
    label en official "the defendant shall be liable to the plaintiff in an amount equal to the lesser of $1,000,000 ($100,000, in the case of negligence) or the sum of—";
    for p: Person;
    for officer: Person;
    for act_id: Person;
    for total: Money;
    when disregard_is_negligence_only(p, act_id)
        and collection_damages_sum(p, act_id, total)
        and total > 100000.00 USD;
    then collection_damages_awarded(p, act_id, 100000.00 USD);
}
@source(IRC_S7433_B, relation = formalizes, coverage = partial, quote = "the defendant shall be liable to the plaintiff in an amount equal to the lesser of $1,000,000 ($100,000, in the case of negligence) or the sum of—")
pub rule S7433DamagesNegligenceUnderCap defeasible {
    label en official "the defendant shall be liable to the plaintiff in an amount equal to the lesser of $1,000,000 ($100,000, in the case of negligence) or the sum of—";
    for p: Person;
    for officer: Person;
    for act_id: Person;
    for total: Money;
    when disregard_is_negligence_only(p, act_id)
        and collection_damages_sum(p, act_id, total)
        and total <= 100000.00 USD;
    then collection_damages_awarded(p, act_id, total);
}
