// Judicial proceedings WIRE-10 (group C): section 7459(c) classification derived from the declaratory remedies.
// NOT EXECUTED (implemented_unverified); expectations come from the pinned statutory text; no legal review.

language "law.core" version "0.2";
package us.irc.judicial_proceedings version "0.1.1";
namespace "urn:us:irc:judicial_proceedings:clir";

test "W10C-JUD-01-SECTION-7428-CONTROVERSY-IS-A-DECLARATORY-PROCEEDING-FOR-THE-DECISION-DATE" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": declaratory_controversy(entity_ref("urn:test:w10c:j1#pr"), entity_ref("urn:test:w10c:j1#p"), Sec7428ExemptOrganization) { origin case_input; }
        assert "f1": courts_order_entering_decision(entity_ref("urn:test:w10c:j1#pr"), @2025-05-01) { origin case_input; }
    }
    evaluate truth(decision_date(entity_ref("urn:test:w10c:j1#pr"), @2025-05-01));
    expect truth_status == TRUE_ONLY;
}

test "W10C-JUD-02-PART-IV-SECTION-7476-CONTROVERSY-IS-A-DECLARATORY-PROCEEDING" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": declaratory_controversy(entity_ref("urn:test:w10c:j2#pr"), entity_ref("urn:test:w10c:j2#p"), Sec7476RetirementPlan) { origin case_input; }
    }
    evaluate truth(proceeding_is_part_iv_or_7428_or_6234(entity_ref("urn:test:w10c:j2#pr")));
    expect truth_status == TRUE_ONLY;
}

test "W10C-JUD-03-SECTION-7436-CONTROVERSY-IS-NOT-COVERED-BY-SECTION-7459C" {
    given {
        context {
            legal_time @2025-06-30;
