        assert "f0": declaratory_controversy(entity_ref("urn:test:w10c:j3#pr"), entity_ref("urn:test:w10c:j3#p"), Sec7436EmploymentStatus) { origin case_input; }
    }
    evaluate truth(proceeding_is_part_iv_or_7428_or_6234(entity_ref("urn:test:w10c:j3#pr")));
    expect truth_status == FALSE_ONLY;
}

test "W10C-JUD-04-CLASSIFICATION-STILL-ACCEPTS-THE-CASE-FACT-FOR-A-SECTION-6234-ACTION" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": proceeding_is_part_iv_or_7428_or_6234(entity_ref("urn:test:w10c:j4#pr")) { origin case_input; }
    }
    evaluate truth(proceeding_is_part_iv_or_7428_or_6234(entity_ref("urn:test:w10c:j4#pr")));
    expect truth_status == TRUE_ONLY;
}
