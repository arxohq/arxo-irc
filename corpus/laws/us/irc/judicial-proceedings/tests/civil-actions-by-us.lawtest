// Scenarios for §7401, §7402(a), §7403 (package us.irc.judicial_proceedings,
// module 01-civil-actions-by-us.law). Written from the text; NOT executed in
// this stage (NO-HEAVY-CHECKS) — `implemented_unverified`.

language "law.core" version "0.2";
package us.irc.judicial_proceedings version "0.1.1";
namespace "urn:us:irc:judicial_proceedings:clir";

test "S7401-01-AUTHORIZED-AND-DIRECTED-VALID" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert secretary_authorizes_or_sanctions(entity_ref("urn:us:irc:judicial_proceedings:clir#PR1")) { id "f0"; origin case_input; }
        assert attorney_general_directs_commencement(entity_ref("urn:us:irc:judicial_proceedings:clir#PR1")) { id "f1"; origin case_input; }
    }
    evaluate truth(civil_action_authorized(entity_ref("urn:us:irc:judicial_proceedings:clir#PR1")));
    expect truth_status == TRUE_ONLY;
}

test "S7401-02-SECRETARY-AUTHORIZATION-MISSING-NEITHER" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert attorney_general_directs_commencement(entity_ref("urn:us:irc:judicial_proceedings:clir#PR2")) { id "f0"; origin case_input; }
    }
    evaluate truth(civil_action_authorized(entity_ref("urn:us:irc:judicial_proceedings:clir#PR2")));
    expect truth_status == NEITHER;
}

test "S7403-01-LIEN-ENFORCEMENT-DIRECTED-ON-REFUSAL-TO-PAY" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert refusal_or_neglect_to_pay(entity_ref("urn:us:irc:judicial_proceedings:clir#P1"), entity_ref("urn:us:irc:judicial_proceedings:clir#L1")) { id "f0"; origin case_input; }
        assert secretary_requests_lien_action(entity_ref("urn:us:irc:judicial_proceedings:clir#P1"), entity_ref("urn:us:irc:judicial_proceedings:clir#L1")) { id "f1"; origin case_input; }
        assert lien_action_directed(entity_ref("urn:us:irc:judicial_proceedings:clir#PR3"), entity_ref("urn:us:irc:judicial_proceedings:clir#P1"), entity_ref("urn:us:irc:judicial_proceedings:clir#L1")) { id "f2"; origin case_input; }
    }
    evaluate positions();
    expect position(S7403DirectLienEnforcementActionPower, ACTIVE);
}

test "S7403-02-NO-REFUSAL-NO-ACCELERATION-POWER-INVALID" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert secretary_requests_lien_action(entity_ref("urn:us:irc:judicial_proceedings:clir#P2"), entity_ref("urn:us:irc:judicial_proceedings:clir#L2")) { id "f0"; origin case_input; }
        assert lien_action_directed(entity_ref("urn:us:irc:judicial_proceedings:clir#PR4"), entity_ref("urn:us:irc:judicial_proceedings:clir#P2"), entity_ref("urn:us:irc:judicial_proceedings:clir#L2")) { id "f1"; origin case_input; }
    }
    evaluate truth(lien_enforcement_action_filed(entity_ref("urn:us:irc:judicial_proceedings:clir#PR4"), entity_ref("urn:us:irc:judicial_proceedings:clir#P2"), entity_ref("urn:us:irc:judicial_proceedings:clir#L2")));
    expect truth_status == NEITHER;
}

test "S7403-03-DECREE-SALE-WHEN-US-INTEREST-ESTABLISHED" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert refusal_or_neglect_to_pay(entity_ref("urn:us:irc:judicial_proceedings:clir#P3"), entity_ref("urn:us:irc:judicial_proceedings:clir#L3")) { id "f0"; origin case_input; }
        assert secretary_requests_lien_action(entity_ref("urn:us:irc:judicial_proceedings:clir#P3"), entity_ref("urn:us:irc:judicial_proceedings:clir#L3")) { id "f1"; origin case_input; }
        assert lien_action_directed(entity_ref("urn:us:irc:judicial_proceedings:clir#PR5"), entity_ref("urn:us:irc:judicial_proceedings:clir#P3"), entity_ref("urn:us:irc:judicial_proceedings:clir#L3")) { id "f2"; origin case_input; }
        assert us_claim_or_interest_established(entity_ref("urn:us:irc:judicial_proceedings:clir#PR5"), entity_ref("urn:us:irc:judicial_proceedings:clir#L3")) { id "f3"; origin case_input; }
        assert court_decrees_sale(entity_ref("urn:us:irc:judicial_proceedings:clir#PR5"), entity_ref("urn:us:irc:judicial_proceedings:clir#L3")) { id "f4"; origin case_input; }
    }
    evaluate positions();
    expect position(S7403DecreeSalePower, ACTIVE);
}
