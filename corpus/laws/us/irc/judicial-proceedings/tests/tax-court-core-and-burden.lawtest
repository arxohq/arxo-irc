// Scenarios for §7442, §7454(a),(b), §7491(a)-(c) (module
// 05-tax-court-core-and-burden.law). NOT executed this stage —
// `implemented_unverified`.

language "law.core" version "0.2";
package us.irc.judicial_proceedings version "0.1.1";
namespace "urn:us:irc:judicial_proceedings:clir";

test "S7454A-01-FRAUD-BURDEN-ON-SECRETARY" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert fraud_issue_raised(entity_ref("urn:us:irc:judicial_proceedings:clir#PR1"), entity_ref("urn:us:irc:judicial_proceedings:clir#P1")) { id "f0"; origin case_input; }
    }
    evaluate truth(fraud_burden_on_secretary(entity_ref("urn:us:irc:judicial_proceedings:clir#PR1"), entity_ref("urn:us:irc:judicial_proceedings:clir#P1")));
    expect truth_status == TRUE_ONLY;
}

test "S7454A-02-NO-FRAUD-ISSUE-NEITHER" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
    }
    evaluate truth(fraud_burden_on_secretary(entity_ref("urn:us:irc:judicial_proceedings:clir#PR2"), entity_ref("urn:us:irc:judicial_proceedings:clir#P2")));
    expect truth_status == NEITHER;
}

test "S7491A-01-BURDEN-SHIFT-CREDIBLE-EVIDENCE" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert credible_evidence_introduced(entity_ref("urn:us:irc:judicial_proceedings:clir#PR3"), entity_ref("urn:us:irc:judicial_proceedings:clir#P3"), entity_ref("urn:us:irc:judicial_proceedings:clir#ISSUE3")) { id "f0"; origin adjudicated; }
        assert substantiation_requirements_complied(entity_ref("urn:us:irc:judicial_proceedings:clir#P3")) { id "f1"; origin case_input; }
        assert records_maintained_and_cooperated(entity_ref("urn:us:irc:judicial_proceedings:clir#P3")) { id "f2"; origin case_input; }
    }
    evaluate truth(general_burden_on_secretary(entity_ref("urn:us:irc:judicial_proceedings:clir#PR3"), entity_ref("urn:us:irc:judicial_proceedings:clir#P3"), entity_ref("urn:us:irc:judicial_proceedings:clir#ISSUE3")));
    expect truth_status == TRUE_ONLY;
}

