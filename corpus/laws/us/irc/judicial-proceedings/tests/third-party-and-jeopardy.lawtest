// Scenarios for §7426(a), §7429 (module 03-third-party-and-jeopardy.law).
// NOT executed this stage — `implemented_unverified`.

language "law.core" version "0.2";
package us.irc.judicial_proceedings version "0.1.1";
namespace "urn:us:irc:judicial_proceedings:clir";

test "S7426A-01-WRONGFUL-LEVY-SUIT-PERMITTED" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert levy_made_on_property(entity_ref("urn:us:irc:judicial_proceedings:clir#PR1"), entity_ref("urn:us:irc:judicial_proceedings:clir#LV1")) { id "f0"; origin case_input; }
        assert claimant_not_assessed_taxpayer(entity_ref("urn:us:irc:judicial_proceedings:clir#C1"), entity_ref("urn:us:irc:judicial_proceedings:clir#LV1")) { id "f1"; origin case_input; }
        assert claimant_interest_or_lien(entity_ref("urn:us:irc:judicial_proceedings:clir#C1"), entity_ref("urn:us:irc:judicial_proceedings:clir#LV1")) { id "f2"; origin case_input; }
        assert wrongful_levy_claimed(entity_ref("urn:us:irc:judicial_proceedings:clir#C1"), entity_ref("urn:us:irc:judicial_proceedings:clir#LV1")) { id "f3"; origin case_input; }
        assert wrongful_levy_suit_brought(entity_ref("urn:us:irc:judicial_proceedings:clir#PR1"), entity_ref("urn:us:irc:judicial_proceedings:clir#C1"), entity_ref("urn:us:irc:judicial_proceedings:clir#LV1")) { id "f4"; origin case_input; }
    }
    evaluate positions();
    expect position(S7426WrongfulLevySuitPower, ACTIVE);
}

test "S7426A-02-CLAIMANT-IS-ASSESSED-TAXPAYER-INVALID" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert levy_made_on_property(entity_ref("urn:us:irc:judicial_proceedings:clir#PR2"), entity_ref("urn:us:irc:judicial_proceedings:clir#LV2")) { id "f0"; origin case_input; }
        assert claimant_interest_or_lien(entity_ref("urn:us:irc:judicial_proceedings:clir#C2"), entity_ref("urn:us:irc:judicial_proceedings:clir#LV2")) { id "f1"; origin case_input; }
        assert wrongful_levy_claimed(entity_ref("urn:us:irc:judicial_proceedings:clir#C2"), entity_ref("urn:us:irc:judicial_proceedings:clir#LV2")) { id "f2"; origin case_input; }
        assert wrongful_levy_suit_brought(entity_ref("urn:us:irc:judicial_proceedings:clir#PR2"), entity_ref("urn:us:irc:judicial_proceedings:clir#C2"), entity_ref("urn:us:irc:judicial_proceedings:clir#LV2")) { id "f3"; origin case_input; }
    }
    evaluate truth(wrongful_levy_suit_permitted(entity_ref("urn:us:irc:judicial_proceedings:clir#PR2"), entity_ref("urn:us:irc:judicial_proceedings:clir#C2"), entity_ref("urn:us:irc:judicial_proceedings:clir#LV2")));
    expect truth_status == FALSE_ONLY;
}

test "S7429B-01-JUDICIAL-REVIEW-WINDOW-BY-16TH-DAY" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert taxpayer_requests_review(entity_ref("urn:us:irc:judicial_proceedings:clir#P3"), @2026-01-01) { id "f0"; origin case_input; }
        assert us.irc.administration::last_day_rolled(@2026-04-17, @2026-04-17) { id "f2"; origin case_input; }
        assert jeopardy_review_suit_brought(entity_ref("urn:us:irc:judicial_proceedings:clir#PR3"), entity_ref("urn:us:irc:judicial_proceedings:clir#P3")) { id "f1"; origin case_input; }
    }
    evaluate positions();
    expect position(S7429JudicialReviewPower, ACTIVE);
}

