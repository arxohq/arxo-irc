// Scenarios for §7481(a)(1),(b), §7482(a), §7483, §7485(a) (module
// 07-appeals-and-finality.law). NOT executed this stage —
// `implemented_unverified`.

language "law.core" version "0.2";
package us.irc.judicial_proceedings version "0.1.1";
namespace "urn:us:irc:judicial_proceedings:clir";

test "S7483-01-NOTICE-OF-APPEAL-TIMELY-AT-90-DAYS" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert order_specifying_deficiency_entered(entity_ref("urn:us:irc:judicial_proceedings:clir#PR1"), @2026-01-01) { id "f0"; origin case_input; }
        assert notice_of_appeal_filed(entity_ref("urn:us:irc:judicial_proceedings:clir#PR1"), entity_ref("urn:us:irc:judicial_proceedings:clir#P1"), @2026-04-01) { id "f1"; origin case_input; }
    }
    evaluate truth(notice_of_appeal_timely(entity_ref("urn:us:irc:judicial_proceedings:clir#PR1"), entity_ref("urn:us:irc:judicial_proceedings:clir#P1"), @2026-04-01));
    expect truth_status == TRUE_ONLY;
}

test "S7483-02-NOTICE-OF-APPEAL-AT-91-DAYS-UNTIMELY" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert order_specifying_deficiency_entered(entity_ref("urn:us:irc:judicial_proceedings:clir#PR2"), @2026-01-01) { id "f0"; origin case_input; }
        assert notice_of_appeal_filed(entity_ref("urn:us:irc:judicial_proceedings:clir#PR2"), entity_ref("urn:us:irc:judicial_proceedings:clir#P2"), @2026-04-15) { id "f1"; origin case_input; }
    }
    evaluate truth(notice_of_appeal_timely(entity_ref("urn:us:irc:judicial_proceedings:clir#PR2"), entity_ref("urn:us:irc:judicial_proceedings:clir#P2"), @2026-04-15));
    expect truth_status == NEITHER;
}

test "S7481A1-01-DECISION-FINAL-90-DAYS-NO-APPEAL" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; }
