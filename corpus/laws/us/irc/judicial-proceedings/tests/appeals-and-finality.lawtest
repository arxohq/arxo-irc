test "S7485A-01-STAY-GRANTED-WITH-APPEAL-BOND" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert order_specifying_deficiency_entered(entity_ref("urn:us:irc:judicial_proceedings:clir#PR5"), @2026-01-01) { id "f0"; origin case_input; }
        assert notice_of_appeal_filed(entity_ref("urn:us:irc:judicial_proceedings:clir#PR5"), entity_ref("urn:us:irc:judicial_proceedings:clir#P5"), @2026-03-01) { id "f1"; origin case_input; }
        assert appeal_bond_filed(entity_ref("urn:us:irc:judicial_proceedings:clir#PR5"), entity_ref("urn:us:irc:judicial_proceedings:clir#P5"), 20000.00 USD) { id "f2"; origin case_input; }
        assert appeal_bond_sum_within_double_deficiency(entity_ref("urn:us:irc:judicial_proceedings:clir#PR5"), entity_ref("urn:us:irc:judicial_proceedings:clir#P5"), 20000.00 USD, 10000.00 USD) { id "f3"; origin case_input; }
        assert stay_requested(entity_ref("urn:us:irc:judicial_proceedings:clir#PR5"), entity_ref("urn:us:irc:judicial_proceedings:clir#P5")) { id "f4"; origin case_input; }
    }
    evaluate positions();
    expect position(S7485StayOfAssessmentPower, ACTIVE);
}

test "S7485A-02-STAY-DENIED-NO-BOND" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert order_specifying_deficiency_entered(entity_ref("urn:us:irc:judicial_proceedings:clir#PR6"), @2026-01-01) { id "f0"; origin case_input; }
        assert notice_of_appeal_filed(entity_ref("urn:us:irc:judicial_proceedings:clir#PR6"), entity_ref("urn:us:irc:judicial_proceedings:clir#P6"), @2026-03-01) { id "f1"; origin case_input; }
        assert stay_requested(entity_ref("urn:us:irc:judicial_proceedings:clir#PR6"), entity_ref("urn:us:irc:judicial_proceedings:clir#P6")) { id "f2"; origin case_input; }
    }
    evaluate truth(assessment_and_collection_stayed(entity_ref("urn:us:irc:judicial_proceedings:clir#PR6"), entity_ref("urn:us:irc:judicial_proceedings:clir#P6")));
    expect truth_status == FALSE_ONLY;
}
