test "S7422A-01-REFUND-SUIT-PERMITTED-CLAIM-DULY-FILED" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert refund_suit_brought(entity_ref("urn:us:irc:judicial_proceedings:clir#PR3"), entity_ref("urn:us:irc:judicial_proceedings:clir#P3"), entity_ref("urn:us:irc:judicial_proceedings:clir#C3")) { id "f0"; origin case_input; }
        assert us.irc.core::claim_filed_on(entity_ref("urn:us:irc:judicial_proceedings:clir#C3"), @2026-01-15) { id "f1"; origin case_input; }
        assert us.irc.core::claim_of(entity_ref("urn:us:irc:judicial_proceedings:clir#C3"), entity_ref("urn:us:irc:judicial_proceedings:clir#P3"), entity_ref("urn:us:irc:judicial_proceedings:clir#Y2025"), us.irc.core::IncomeCh1, 400.00 USD) { id "f2"; origin case_input; }
    }
    evaluate positions();
    expect position(S7422BringRefundSuitPower, ACTIVE);
}

test "S7422A-02-REFUND-SUIT-INVALID-NO-CLAIM-FILED" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert refund_suit_brought(entity_ref("urn:us:irc:judicial_proceedings:clir#PR4"), entity_ref("urn:us:irc:judicial_proceedings:clir#P4"), entity_ref("urn:us:irc:judicial_proceedings:clir#C4")) { id "f0"; origin case_input; }
    }
    evaluate truth(refund_suit_permitted(entity_ref("urn:us:irc:judicial_proceedings:clir#PR4"), entity_ref("urn:us:irc:judicial_proceedings:clir#P4"), entity_ref("urn:us:irc:judicial_proceedings:clir#C4")));
    expect truth_status == FALSE_ONLY;
}
