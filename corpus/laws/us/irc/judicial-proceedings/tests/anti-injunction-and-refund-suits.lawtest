// Scenarios for §7421, §7422(a),(f) (module
// 02-anti-injunction-and-refund-suits.law). NOT executed this stage —
// `implemented_unverified`.

language "law.core" version "0.2";
package us.irc.judicial_proceedings version "0.1.1";
namespace "urn:us:irc:judicial_proceedings:clir";

test "S7421-01-INJUNCTION-BARRED-NO-EXCEPTION" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert suit_to_restrain_assessment_or_collection(entity_ref("urn:us:irc:judicial_proceedings:clir#PR1"), entity_ref("urn:us:irc:judicial_proceedings:clir#P1")) { id "f0"; origin case_input; }
    }
    evaluate positions();
    expect position(S7421AntiInjunctionImmunity, ACTIVE);
}

test "S7421-02-INJUNCTION-PERMITTED-6213A-PETITION-TIMELY" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert suit_to_restrain_assessment_or_collection(entity_ref("urn:us:irc:judicial_proceedings:clir#PR2"), entity_ref("urn:us:irc:judicial_proceedings:clir#P2")) { id "f0"; origin case_input; }
        assert us.irc.assessment::petition_filed_timely(entity_ref("urn:us:irc:judicial_proceedings:clir#PR2"), entity_ref("urn:us:irc:judicial_proceedings:clir#N2"), entity_ref("urn:us:irc:judicial_proceedings:clir#P2")) { id "f1"; origin case_input; }
    }
    evaluate positions();
    expect position(S7421AntiInjunctionImmunity, DEFEATED);
}

test "S7421-02A-INJUNCTION-PERMITTED-6015E-COLLECTION-BAR-IN-FORCE" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
