        assert us.irc.returns::collection_bar_6015e_in_force(entity_ref("urn:us:irc:judicial_proceedings:clir#P2A"), entity_ref("urn:us:irc:judicial_proceedings:clir#S2A"), entity_ref("urn:us:irc:judicial_proceedings:clir#Y2A")) { id "f1"; origin case_input; }
