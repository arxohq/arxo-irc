        assert first_day_retired_pay_would_accrue(entity_ref("urn:us:irc:judicial_proceedings:clir#J144"), TaxCourtJudgeOffice, @2026-04-01) { id "f2"; origin case_input; }
        assert judge_revokes_retired_pay_election_on(entity_ref("urn:us:irc:judicial_proceedings:clir#J144"), TaxCourtJudgeOffice, @2026-03-01) { id "f3"; origin case_input; }
        assert additional_court_contribution_deposited(entity_ref("urn:us:irc:judicial_proceedings:clir#J144")) { id "f4"; origin case_input; }
    }
    evaluate positions();
    expect position(S7447i3DDepositAdditionalContribution, SATISFIED);
}

