// Scenarios for §7430(a)-(c),(g), §7431(a)-(d), §7433(a),(b),(d) (module
// 04-costs-and-damages.law). NOT executed this stage — `implemented_unverified`.

language "law.core" version "0.2";
package us.irc.judicial_proceedings version "0.1.1";
namespace "urn:us:irc:judicial_proceedings:clir";

test "S7430-01-COSTS-AWARDABLE-PREVAILING-PARTY" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert administrative_or_court_proceeding(entity_ref("urn:us:irc:judicial_proceedings:clir#PR1")) { id "f0"; origin case_input; }
        assert prevailing_party_substantially_prevailed(entity_ref("urn:us:irc:judicial_proceedings:clir#P1"), entity_ref("urn:us:irc:judicial_proceedings:clir#PR1")) { id "f1"; origin case_input; }
        assert net_worth_within_limit(entity_ref("urn:us:irc:judicial_proceedings:clir#P1")) { id "f2"; origin case_input; }
        assert administrative_remedies_exhausted(entity_ref("urn:us:irc:judicial_proceedings:clir#P1"), entity_ref("urn:us:irc:judicial_proceedings:clir#PR1")) { id "f3"; origin case_input; }
        assert costs_award_requested(entity_ref("urn:us:irc:judicial_proceedings:clir#P1"), entity_ref("urn:us:irc:judicial_proceedings:clir#PR1")) { id "f4"; origin case_input; }
    }
    evaluate positions();
    expect position(S7430CostsAwardablePower, ACTIVE);
}

test "S7430-02-COSTS-DENIED-POSITION-SUBSTANTIALLY-JUSTIFIED" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert administrative_or_court_proceeding(entity_ref("urn:us:irc:judicial_proceedings:clir#PR2")) { id "f0"; origin case_input; }
        assert prevailing_party_substantially_prevailed(entity_ref("urn:us:irc:judicial_proceedings:clir#P2"), entity_ref("urn:us:irc:judicial_proceedings:clir#PR2")) { id "f1"; origin case_input; }
        assert net_worth_within_limit(entity_ref("urn:us:irc:judicial_proceedings:clir#P2")) { id "f2"; origin case_input; }
        assert administrative_remedies_exhausted(entity_ref("urn:us:irc:judicial_proceedings:clir#P2"), entity_ref("urn:us:irc:judicial_proceedings:clir#PR2")) { id "f3"; origin case_input; }
        assert costs_award_requested(entity_ref("urn:us:irc:judicial_proceedings:clir#P2"), entity_ref("urn:us:irc:judicial_proceedings:clir#PR2")) { id "f4"; origin case_input; }
        assert position_of_united_states_substantially_justified(entity_ref("urn:us:irc:judicial_proceedings:clir#PR2")) { id "f5"; origin adjudicated; }
    }
    evaluate truth(costs_awardable(entity_ref("urn:us:irc:judicial_proceedings:clir#P2"), entity_ref("urn:us:irc:judicial_proceedings:clir#PR2")));
    expect truth_status == FALSE_ONLY;
}

test "S7431C-01-DAMAGES-FLOOR-1000-PER-ACT" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert unauthorized_inspection_or_disclosure_by_employee(entity_ref("urn:us:irc:judicial_proceedings:clir#P3"), entity_ref("urn:us:irc:judicial_proceedings:clir#D3"), entity_ref("urn:us:irc:judicial_proceedings:clir#ACT3")) { id "f0"; origin case_input; }
        assert disclosure_suit_brought(entity_ref("urn:us:irc:judicial_proceedings:clir#PR3"), entity_ref("urn:us:irc:judicial_proceedings:clir#P3"), entity_ref("urn:us:irc:judicial_proceedings:clir#D3")) { id "f1"; origin case_input; }
        assert discovery_date(entity_ref("urn:us:irc:judicial_proceedings:clir#P3"), entity_ref("urn:us:irc:judicial_proceedings:clir#D3"), entity_ref("urn:us:irc:judicial_proceedings:clir#ACT3"), @2026-01-01) { id "f2"; origin case_input; }
        assert disclosure_suit_filed_on(entity_ref("urn:us:irc:judicial_proceedings:clir#P3"), entity_ref("urn:us:irc:judicial_proceedings:clir#D3"), entity_ref("urn:us:irc:judicial_proceedings:clir#ACT3"), @2026-06-01) { id "f3"; origin case_input; }
        assert actual_plus_punitive_damages(entity_ref("urn:us:irc:judicial_proceedings:clir#P3"), entity_ref("urn:us:irc:judicial_proceedings:clir#D3"), entity_ref("urn:us:irc:judicial_proceedings:clir#ACT3"), 200.00 USD) { id "f4"; origin case_input; }
    }
    evaluate truth(disclosure_damages_core(entity_ref("urn:us:irc:judicial_proceedings:clir#P3"), entity_ref("urn:us:irc:judicial_proceedings:clir#D3"), entity_ref("urn:us:irc:judicial_proceedings:clir#ACT3"), 1000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S7433B-01-DAMAGES-CAP-1000000-RECKLESS" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert collection_damages_claimed(entity_ref("urn:us:irc:judicial_proceedings:clir#P4"), entity_ref("urn:us:irc:judicial_proceedings:clir#ACT4"), 2000000.00 USD, 0.00 USD) { id "f0"; origin case_input; }
    }
    evaluate truth(collection_damages_awarded(entity_ref("urn:us:irc:judicial_proceedings:clir#P4"), entity_ref("urn:us:irc:judicial_proceedings:clir#ACT4"), 1000000.00 USD));
