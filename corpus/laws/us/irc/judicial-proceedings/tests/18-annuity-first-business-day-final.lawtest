// Final TECH_GAP pass (26.09.2026): section 7448(l) (G5613). NOT EXECUTED (implemented_unverified).
// The test family carries the business-day calendar snapshot derived from 5 U.S.C. 6103 (`us.code.clir.federal_calendar`, 2026).

language "law.core" version "0.2";
package us.irc.judicial_proceedings version "0.1.1";
namespace "urn:us:irc:judicial_proceedings:clir";

test "S7448L-01-FIRST-BUSINESS-DAY-OF-JULY" {
    // annuity for June 2026: the first business day after 2026-06-30 is Wed 2026-07-01.
    given {
        context {
            legal_time @2026-08-01;
            decision_time @2026-08-01T09:00:00-05:00;
            knowledge_time @2026-08-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.judicial_proceedings::IRC_BUSINESS_DAY_COUNT;
        }
        assert "f0": annuity_accrual_month_start_7448l(entity_ref("urn:test:a7448:1#j"), @2026-06-01) { origin case_input; }
    }
    evaluate truth(annuity_due_date_7448l(entity_ref("urn:test:a7448:1#j"), @2026-06-01, @2026-07-01));
    expect truth_status == TRUE_ONLY;
}

test "S7448L-02-FIRST-BUSINESS-DAY-SKIPS-THE-WEEKEND" {
    // annuity for July 2026: 2026-08-01 is a Saturday, the first business day is Mon 2026-08-03.
    given {
        context {
            legal_time @2026-08-01;
            decision_time @2026-08-01T09:00:00-05:00;
            knowledge_time @2026-08-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.judicial_proceedings::IRC_BUSINESS_DAY_COUNT;
        }
        assert "f0": annuity_accrual_month_start_7448l(entity_ref("urn:test:a7448:2#j"), @2026-07-01) { origin case_input; }
    }
    evaluate truth(annuity_due_date_7448l(entity_ref("urn:test:a7448:2#j"), @2026-07-01, @2026-08-03));
    expect truth_status == TRUE_ONLY;
}

test "S7448L-03-FIRST-BUSINESS-DAY-SKIPS-A-HOLIDAY" {
    // annuity for December 2025... (2026-01-01 is a federal holiday): annuity for December 2026 -> 2027 not in the 2026 snapshot; annuity for October 2026: 2026-11-02 (Monday).
    given {
        context {
            legal_time @2026-08-01;
            decision_time @2026-08-01T09:00:00-05:00;
            knowledge_time @2026-08-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.judicial_proceedings::IRC_BUSINESS_DAY_COUNT;
        }
        assert "f0": annuity_accrual_month_start_7448l(entity_ref("urn:test:a7448:3#j"), @2026-10-01) { origin case_input; }
    }
    evaluate truth(annuity_due_date_7448l(entity_ref("urn:test:a7448:3#j"), @2026-10-01, @2026-11-02));
    expect truth_status == TRUE_ONLY;
}
