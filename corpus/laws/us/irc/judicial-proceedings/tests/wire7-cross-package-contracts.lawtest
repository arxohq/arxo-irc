// Scenarios for module 99-wire7-cross-package-contracts.law of package us.irc.judicial_proceedings (WIRE-7): the consumer reads the owner's published contract (asserted as a case input; the owner's own derivation
// is tested in the owner package). Written from the text; NOT executed (NO-HEAVY-CHECKS) -- `implemented_unverified`.

language "law.core" version "0.2";
package us.irc.judicial_proceedings version "0.1.1";
namespace "urn:us:irc:judicial_proceedings:clir";

test "W7JP-01-OWNER-CONTRACT-DERIVES-CONSUMER" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert us.irc.definitions::tax_return_preparer(entity_ref("urn:us:irc:judicial_proceedings:clir#PREP1"), entity_ref("urn:us:irc:judicial_proceedings:clir#RETURN1")) { id "f0"; origin case_input; }
    }
    evaluate truth(is_tax_return_preparer(entity_ref("urn:us:irc:judicial_proceedings:clir#PREP1")));
    expect truth_status == TRUE_ONLY;
}

test "W7JP-01-NO-OWNER-FACT-NOT-DERIVED" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
    }
    evaluate truth(is_tax_return_preparer(entity_ref("urn:us:irc:judicial_proceedings:clir#PREP1")));
    expect truth_status == NEITHER;
}

