// Scenarios for §7459(c)-(e), §7463(a)-(c) (module
// 06-tax-court-decisions-and-small-cases.law). NOT executed this stage —
// `implemented_unverified`.

language "law.core" version "0.2";
package us.irc.judicial_proceedings version "0.1.1";
namespace "urn:us:irc:judicial_proceedings:clir";

test "S7459C-01-DECISION-DATE-ORDER-SPECIFYING-DEFICIENCY" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert order_specifying_deficiency_entered(entity_ref("urn:us:irc:judicial_proceedings:clir#PR1"), @2026-03-01) { id "f0"; origin case_input; }
    }
    evaluate truth(decision_date(entity_ref("urn:us:irc:judicial_proceedings:clir#PR1"), @2026-03-01));
    expect truth_status == TRUE_ONLY;
}

test "S7459C-02-DECISION-DATE-DISMISSAL-FOR-LACK-OF-JURISDICTION" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert dismissal_for_lack_of_jurisdiction(entity_ref("urn:us:irc:judicial_proceedings:clir#PR2")) { id "f0"; origin case_input; }
        assert dismissal_order_entered(entity_ref("urn:us:irc:judicial_proceedings:clir#PR2"), @2026-04-10) { id "f1"; origin case_input; }
    }
    evaluate truth(decision_date(entity_ref("urn:us:irc:judicial_proceedings:clir#PR2"), @2026-04-10));
    expect truth_status == TRUE_ONLY;
}

test "S7463A-01-SMALL-CASE-CEILING-AT-50000-MET" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert deficiency_placed_in_dispute(entity_ref("urn:us:irc:judicial_proceedings:clir#PR3"), entity_ref("urn:us:irc:judicial_proceedings:clir#Y2025"), 50000.00 USD) { id "f0"; origin case_input; }
    }
    evaluate truth(small_case_ceiling_met(entity_ref("urn:us:irc:judicial_proceedings:clir#PR3"), entity_ref("urn:us:irc:judicial_proceedings:clir#Y2025")));
    expect truth_status == TRUE_ONLY;
}

test "S7463A-02-SMALL-CASE-CEILING-AT-50001-NOT-MET" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert deficiency_placed_in_dispute(entity_ref("urn:us:irc:judicial_proceedings:clir#PR4"), entity_ref("urn:us:irc:judicial_proceedings:clir#Y2025b"), 50001.00 USD) { id "f0"; origin case_input; }
    }
    evaluate truth(small_case_ceiling_met(entity_ref("urn:us:irc:judicial_proceedings:clir#PR4"), entity_ref("urn:us:irc:judicial_proceedings:clir#Y2025b")));
    expect truth_status == NEITHER;
}

test "S7463B-01-SMALL-CASE-DECISION-NOT-REVIEWABLE" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert taxpayer_elects_small_case_procedure(entity_ref("urn:us:irc:judicial_proceedings:clir#PR5"), entity_ref("urn:us:irc:judicial_proceedings:clir#P5")) { id "f0"; origin case_input; }
        assert deficiency_placed_in_dispute(entity_ref("urn:us:irc:judicial_proceedings:clir#PR5"), entity_ref("urn:us:irc:judicial_proceedings:clir#Y2025c"), 10000.00 USD) { id "f1"; origin case_input; }
        assert tax_court_concurs_in_election(entity_ref("urn:us:irc:judicial_proceedings:clir#PR5")) { id "f2"; origin case_input; }
    }
    evaluate positions();
    expect position(S7463NoReviewImmunity, ACTIVE);
}
