test "S7436D1-01-DETERMINATION-TREATED-AS-A-NOTICE-OF-DEFICIENCY" {
    // the section 7436(a) determination sent as a notice is a notice of deficiency: the notice sufficient at the last known address is valid.
    given {
        context {
            legal_time @2026-08-01;
            decision_time @2026-08-01T09:00:00-05:00;
            knowledge_time @2026-08-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": secretary_determination_notice_7436a(entity_ref("urn:test:n18:1#n"), entity_ref("urn:test:n18:1#p")) { origin case_input; }
        assert "f1": us.irc.core::address_last_known(entity_ref("urn:test:n18:1#n")) { origin case_input; }
