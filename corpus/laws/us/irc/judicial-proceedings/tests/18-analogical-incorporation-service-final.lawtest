// Final TECH_GAP pass (26.09.2026): G5610-G5612 (sections 7436(c)(3), 7436(d)(1), 7447A(f), 7447(a)(3), 7447A(a)(2), 7447(i)(3)(B)(ii)).
// NOT EXECUTED (implemented_unverified). Expectations computed by hand with the roundings named in module 18.

language "law.core" version "0.2";
package us.irc.judicial_proceedings version "0.1.1";
namespace "urn:us:irc:judicial_proceedings:clir";

test "S7447A3-01-UNION-OF-NON-CONSECUTIVE-PERIODS" {
    // 2000-01-01..2004-12-31 and 2010-01-01..2014-12-31: 3653 days = 10 whole years of 365.25 days (14612 >= 14610).
    given {
        context {
            legal_time @2026-08-01;
            decision_time @2026-08-01T09:00:00-05:00;
            knowledge_time @2026-08-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": service_period_7447(entity_ref("urn:test:j18:1#j"), TaxCourtJudgeOffice, @2000-01-01, @2004-12-31) { origin case_input; }
        assert "f1": service_period_7447(entity_ref("urn:test:j18:1#j"), TaxCourtJudgeOffice, @2010-01-01, @2014-12-31) { origin case_input; }
    }
    evaluate truth(computed_years_of_service_7447(entity_ref("urn:test:j18:1#j"), TaxCourtJudgeOffice, 10));
    expect truth_status == TRUE_ONLY;
}

test "S7447A3-02-OVERLAPPING-PERIODS-GIVE-NO-COMPUTED-LENGTH" {
    // two overlapping periods: the union is not formed, the asserted years are read.
    given {
        context {
            legal_time @2026-08-01;
            decision_time @2026-08-01T09:00:00-05:00;
            knowledge_time @2026-08-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": service_period_7447(entity_ref("urn:test:j18:2#j"), TaxCourtJudgeOffice, @2000-01-01, @2010-12-31) { origin case_input; }
        assert "f1": service_period_7447(entity_ref("urn:test:j18:2#j"), TaxCourtJudgeOffice, @2005-01-01, @2012-12-31) { origin case_input; }
        assert "f2": years_of_service(entity_ref("urn:test:j18:2#j"), TaxCourtJudgeOffice, 15) { origin case_input; }
    }
    evaluate truth(years_of_service_for_rules(entity_ref("urn:test:j18:2#j"), TaxCourtJudgeOffice, 15));
    expect truth_status == TRUE_ONLY;
}

