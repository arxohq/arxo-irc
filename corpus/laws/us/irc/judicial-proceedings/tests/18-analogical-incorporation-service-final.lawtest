}

test "S7436C3A-01-DECISION-WITH-SUMMARY-SATISFIES-7459B-AND-7460" {
    // small case procedure applies; a decision with a brief summary: satisfies 7459(b) and 7460.
    given {
        context {
            legal_time @2026-08-01;
            decision_time @2026-08-01T09:00:00-05:00;
            knowledge_time @2026-08-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": petitioner_elects_small_case_7436(entity_ref("urn:test:pr18:1#pr")) { origin case_input; }
        assert "f1": tax_court_concurs_before_hearing_7436(entity_ref("urn:test:pr18:1#pr")) { origin case_input; }
        assert "f2": employment_taxes_in_dispute_for_quarter(entity_ref("urn:test:pr18:1#pr"), "2024Q1", 40000 USD) { origin case_input; }
        assert "f3": decision_with_brief_summary_7436(entity_ref("urn:test:pr18:1#pr")) { origin case_input; }
    }
    evaluate truth(employment_status_decision_satisfies_7459b_and_7460(entity_ref("urn:test:pr18:1#pr")));
    expect truth_status == TRUE_ONLY;
}

test "S7436C3E-01-AMOUNT-IN-DISPUTE-INCLUDES-ADDITIONS" {
    // tax 40000 + additions 15000 in the quarter = 55000 > 50000: some quarter exceeds the limit.
    given {
        context {
            legal_time @2026-08-01;
            decision_time @2026-08-01T09:00:00-05:00;
            knowledge_time @2026-08-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": employment_taxes_in_dispute_for_quarter(entity_ref("urn:test:pr18:2#pr"), "2024Q1", 40000 USD) { origin case_input; }
        assert "f1": additions_and_penalties_in_dispute_7436(entity_ref("urn:test:pr18:2#pr"), "2024Q1", 15000 USD) { origin case_input; }
    }
    evaluate truth(some_quarter_exceeds_50000(entity_ref("urn:test:pr18:2#pr")));
    expect truth_status == TRUE_ONLY;
}

