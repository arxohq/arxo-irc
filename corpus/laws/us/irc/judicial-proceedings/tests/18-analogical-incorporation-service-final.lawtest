}

test "S7447I3B-01-INTEREST-COMPOUNDED-ON-DECEMBER-31" {
    // 1000 credited on 2020-06-30, revoked 2023-03-31: December 31s of 2020, 2021, 2022: 1000 x (1 + 0.03 x 184/365) x 1.03^2 x (1 + 0.03 x 90/365) (12-place roundings, cents): 1084.91.
    given {
        context {
            legal_time @2026-08-01;
            decision_time @2026-08-01T09:00:00-05:00;
            knowledge_time @2026-08-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": credited_amount_7447i(entity_ref("urn:test:j18:4#j"), 1000 USD) { origin case_input; }
        assert "f1": credited_from_7447i(entity_ref("urn:test:j18:4#j"), @2020-06-30) { origin case_input; }
        assert "f2": revocation_filed_on_7447i(entity_ref("urn:test:j18:4#j"), @2023-03-31) { origin case_input; }
        assert "f3": us.irc.core::calendar_year_of(entity_ref("urn:test:j18:4#y2020"), 2020) { origin case_input; }
        assert "f4": us.irc.core::calendar_year_of(entity_ref("urn:test:j18:4#y2021"), 2021) { origin case_input; }
        assert "f5": us.irc.core::calendar_year_of(entity_ref("urn:test:j18:4#y2022"), 2022) { origin case_input; }
        assert "f6": us.irc.core::calendar_year_of(entity_ref("urn:test:j18:4#y2023"), 2023) { origin case_input; }
        assert "f7": us.irc.core::ends(entity_ref("urn:test:j18:4#y2020"), @2020-12-31) { origin case_input; }
        assert "f8": us.irc.core::ends(entity_ref("urn:test:j18:4#y2021"), @2021-12-31) { origin case_input; }
        assert "f9": us.irc.core::ends(entity_ref("urn:test:j18:4#y2022"), @2022-12-31) { origin case_input; }
        assert "f10": us.irc.core::ends(entity_ref("urn:test:j18:4#y2023"), @2023-12-31) { origin case_input; }
    }
    evaluate truth(amount_returned_with_interest_7447i(entity_ref("urn:test:j18:4#j"), 1084.91 USD));
    expect truth_status == TRUE_ONLY;
}

test "S7447I3B-02-NO-DECEMBER-31-SIMPLE-INTEREST" {
    // 1000 credited 2023-02-01, revoked 2023-03-31, no December 31 between: simple interest for 58 days: 1004.77.
    given {
        context {
            legal_time @2026-08-01;
            decision_time @2026-08-01T09:00:00-05:00;
            knowledge_time @2026-08-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": credited_amount_7447i(entity_ref("urn:test:j18:5#j"), 1000 USD) { origin case_input; }
        assert "f1": credited_from_7447i(entity_ref("urn:test:j18:5#j"), @2023-02-01) { origin case_input; }
        assert "f2": revocation_filed_on_7447i(entity_ref("urn:test:j18:5#j"), @2023-03-31) { origin case_input; }
    }
    evaluate truth(amount_returned_with_interest_7447i(entity_ref("urn:test:j18:5#j"), 1004.77 USD));
    expect truth_status == TRUE_ONLY;
}

