// Judicial proceedings WIRE-10 (group C): section 645(b)(1) qualified revocable trust from trusts_estates.
// NOT EXECUTED (implemented_unverified); expectations come from the pinned statutory text; no legal review.

language "law.core" version "0.2";
package us.irc.judicial_proceedings version "0.1.1";
namespace "urn:us:irc:judicial_proceedings:clir";

test "W10C-JUD-05-TRUST-OF-A-DECEDENT-FROM-TRUSTS-ESTATES-IS-A-QUALIFIED-REVOCABLE-TRUST" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.trusts_estates::qualified_revocable_trust(entity_ref("urn:test:w10c:q1#t"), entity_ref("urn:test:w10c:q1#d")) { origin case_input; }
    }
    evaluate truth(qualified_revocable_trust_645b1(entity_ref("urn:test:w10c:q1#t")));
    expect truth_status == TRUE_ONLY;
}

test "W10C-JUD-06-ANOTHER-TRUST-IS-NOT" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.trusts_estates::qualified_revocable_trust(entity_ref("urn:test:w10c:q2#t1"), entity_ref("urn:test:w10c:q2#d")) { origin case_input; }
    }
    evaluate truth(qualified_revocable_trust_645b1(entity_ref("urn:test:w10c:q2#t2")));
    expect truth_status == FALSE_ONLY;
}

test "W10C-JUD-07-PLACEHOLDER-STILL-ACCEPTS-THE-CASE-FACT" {
    given {
        context {
            legal_time @2025-06-30;
            decision_time @2025-06-30T09:00:00-05:00;
            knowledge_time @2025-06-30T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": qualified_revocable_trust_645b1(entity_ref("urn:test:w10c:q3#t")) { origin case_input; }
    }
    evaluate truth(qualified_revocable_trust_645b1(entity_ref("urn:test:w10c:q3#t")));
    expect truth_status == TRUE_ONLY;
}
