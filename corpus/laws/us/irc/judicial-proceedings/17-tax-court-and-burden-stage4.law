// Judicial proceedings — stage 4 (26.09.2026, DECISION-0379, implemented_unverified): rows that
// stages 2-2b left as TECH_GAP or SOURCE_GAP and could be expressed.
//
// Covered: §7491(a)(2) qualified revocable trusts; §7451(b)(1) tolled deadline (comparison
// form); §7447(f)(4)(C) effective date of the freeze election; §7447(j)(3)(F) Thrift Savings
// Plan offset; §7448(a)(2), (4)-(6) definitions of judge, special trial judge and their
// salaries; §7448(c)(2)(C) unfunded liability; §7448(m)(1)(A) average annual salary.
//
// The relations `judicial_salary_for_survivors_fund`, `unfunded_liability_of_fund`,
// `average_annual_salary_for_annuity` (modules 14) and `freeze_election_effective_on` (module 13)
// were typed inputs; they are now derived by the strict rules below (their kind is `institutional`),
// so a scenario that asserts one of them still works and a scenario that gives the components
// gets the value computed.
//
// JUDGMENT CALLS AND GAPS.
//  - §7451(b)(1): "the number of days within the period of inaccessibility" is the inclusive count
//    of the days of the period (`days_between(start, end) + 1`); the tolled deadline is validated in
//    comparison form (a variable number of days cannot be added to a date).
//  - §7447(f)(4)(C): the calendar month that contains the election date is a `us.irc.core::Period`
//    the case supplies (there is no month/day decomposition of a date, TECH-GAPS G9/G10); the
//    effective date is the day after that month ends.
//  - §7448(m)(1)(A): the three consecutive years are three consecutive calendar-year salaries; the
//    maximum is the G136 pattern (no window with a strictly higher average); years for which an
//    election under §7447(f)(4) is in effect are excluded from every window (last sentence of (m)).
//  - §7448(m)(1)(A)(ii): the average over less than 3 years is the total salary divided by the
//    years of service (a Decimal), one rounding to cents (HALF_UP).
//  - §7447(j)(3)(F): the offset "may be divided equally over the first 2 years" is a liberty of the
//    paying authority (no change of legal relations); each half is rounded to cents, HALF_UP.

language "law.core" version "0.2";
package us.irc.judicial_proceedings version "0.1.1";
namespace "urn:us:irc:judicial_proceedings:clir";

use self::{
    IRC_S7447_F,
    IRC_S7447_J,
    IRC_S7448_A,
    IRC_S7448_C,
    IRC_S7448_M,
    IRC_S7451_B,
    IRC_S7491_A,
    Individual,
    Person,
    Proceeding,
    TaxableYear,
    average_annual_salary_for_annuity,
    burden_shift_other_provision_applies,
    credible_evidence_introduced,
    freeze_election_effective_on,
    freeze_election_made_on,
    general_burden_on_secretary,
    judicial_salary_for_survivors_fund,
    records_maintained_and_cooperated,
    substantiation_requirements_complied,
    unfunded_liability_of_fund,
};

// ============================================================================
// §7491(a)(2) — qualified revocable trusts and the entity gate
// ============================================================================

pub relation qualified_revocable_trust_645b1(t: Person) kind empirical {
    label en official "a qualified revocable trust (as defined in section 645(b)(1)) — typed dependency: `us.irc.definitions` does not expose the section 645(b) classification";
}
pub relation trust_liability_year_between_death_and_applicable_date(t: Person, y: TaxableYear) kind institutional {
    label en official "the taxable year ends after the date of the decedent's death and before the applicable date (as defined in section 645(b)(2))";
}
pub relation decedent_death_date_of_trust(t: Person, died: Date) kind empirical {
    label en official "the date of the decedent's death";
}
pub relation applicable_date_645b2(t: Person, applicableOn: Date) kind empirical {
    label en official "the applicable date as defined in section 645(b)(2)";
}
@source(IRC_S7491_A, relation = formalizes, coverage = exact, quote = "with respect to liability for tax for any taxable year ending after the date of the decedent's death and before the applicable date (as defined in section 645(b)(2)).")
rule S7491a2YearBetweenDeathAndApplicableDate strict {
    label en official "the taxable year ends after the decedent's death and before the applicable date";
    for t: Person;
    for y: TaxableYear;
    for died: Date;
    for applicableOn: Date;
    for endsOn: Date;
    when decedent_death_date_of_trust(t, died)
        and applicable_date_645b2(t, applicableOn)
        and us.irc.core::ends(y, endsOn)
        and endsOn > died
        and endsOn < applicableOn;
    then trust_liability_year_between_death_and_applicable_date(t, y);
}
pub relation burden_issue_year(pr: Proceeding, p: Person, y: TaxableYear) kind empirical {
    label en unofficial "the taxable year of the tax liability to which the issue relates";
}
@source(IRC_S7491_A, relation = formalizes, coverage = exact, quote = "Subparagraph (C) shall not apply to any qualified revocable trust (as defined in section 645(b)(1))")
rule S7491GeneralBurdenShiftQualifiedRevocableTrust defeasible {
    label en official "for a qualified revocable trust and a year between the decedent's death and the applicable date the entity size gate of (a)(2)(C) does not apply";
    for pr: Proceeding;
    for p: Person;
    for issue: Person;
    for y: TaxableYear;
    when credible_evidence_introduced(pr, p, issue)
        and substantiation_requirements_complied(p)
        and records_maintained_and_cooperated(p)
        and qualified_revocable_trust_645b1(p)
        and burden_issue_year(pr, p, y)
        and trust_liability_year_between_death_and_applicable_date(p, y);
    then general_burden_on_secretary(pr, p, issue);
    unless burden_shift_other_provision_applies(pr, p, issue) and credible_evidence_introduced(pr, p, issue) and substantiation_requirements_complied(p) and records_maintained_and_cooperated(p) and qualified_revocable_trust_645b1(p) and burden_issue_year(pr, p, y) and trust_liability_year_between_death_and_applicable_date(p, y);
}

// ============================================================================
// §7451(b)(1) — the tolled petition deadline
// ============================================================================

pub relation petition_original_due_date(pr: Proceeding, due: Date) kind empirical {
    label en official "the date the petition is due";
}
pub relation filing_location_inaccessible_period(pr: Proceeding, start: Date, end: Date) kind empirical {
    label en official "the period during which a filing location (the clerk's office or an on-line portal) is inaccessible or otherwise unavailable to the general public";
}
pub relation inaccessibility_period_covers_due_date(pr: Proceeding) kind institutional {
    label en unofficial "the filing location is inaccessible on the date the petition is due";
}
rule S7451b1CoversDueDate strict {
    for pr: Proceeding;
    for due: Date;
    for start: Date;
    for end: Date;
    when petition_original_due_date(pr, due)
        and filing_location_inaccessible_period(pr, start, end)
        and start <= due
        and due <= end;
    then inaccessibility_period_covers_due_date(pr);
}
pub relation inaccessibility_days_including_bounds(pr: Proceeding, days: Integer) kind institutional {
    label en unofficial "the number of days within the period of inaccessibility, counting both its first and last day";
}
rule S7451b1DaysWithinPeriod strict {
    for pr: Proceeding;
    for start: Date;
    for end: Date;
    when filing_location_inaccessible_period(pr, start, end);
    then inaccessibility_days_including_bounds(pr, days_between(start, end) + 1);
}
pub relation candidate_tolled_petition_deadline(pr: Proceeding, candidate: Date) kind empirical {
    label en unofficial "a candidate for the tolled petition deadline (comparison form: the case proposes, the module validates by exact day arithmetic)";
}
pub relation petition_deadline_after_tolling(pr: Proceeding, deadline: Date) kind institutional {
    label en official "the petition deadline after tolling for the days of inaccessibility plus an additional 14 days";
}
@source(IRC_S7451_B, relation = formalizes, coverage = exact, quote = "the relevant time period for filing such petition shall be tolled for the number of days within the period of inaccessibility plus an additional 14 days.")
rule S7451b1TolledDeadline strict {
    label en official "the petition deadline moves by the days of inaccessibility plus 14 days";
    for pr: Proceeding;
    for due: Date;
    for days: Integer;
    for candidate: Date;
    when inaccessibility_period_covers_due_date(pr)
        and petition_original_due_date(pr, due)
        and inaccessibility_days_including_bounds(pr, days)
        and candidate_tolled_petition_deadline(pr, candidate)
        and days_between(due, candidate) == days + 14;
    then petition_deadline_after_tolling(pr, candidate);
}

// ============================================================================
// §7447(f)(4)(C) — when the freeze election takes effect
// ============================================================================

pub relation calendar_month_of_freeze_election(j: Individual, month: us.irc.core::Period) kind empirical {
    label en unofficial "the calendar month in which the election is made, as a period the case supplies";
}
@source(IRC_S7447_F, relation = formalizes, coverage = exact, quote = "Any election under this paragraph shall take effect on the 1st day of the 1st month following the month in which the election is made.")
rule S7447f4CEffectiveFirstDayOfNextMonth strict {
    label en official "the freeze election takes effect on the first day of the first month after the month of the election";
    for j: Individual;
    for on: Date;
    for month: us.irc.core::Period;
    for startsOn: Date;
    for endsOn: Date;
    when freeze_election_made_on(j, on)
        and calendar_month_of_freeze_election(j, month)
        and us.irc.core::begins(month, startsOn)
        and us.irc.core::ends(month, endsOn)
        and startsOn <= on
        and on <= endsOn;
    then freeze_election_effective_on(j, add_calendar_period(endsOn, 1 calendar_day));
}

// ============================================================================
// §7447(j)(3)(F) — Thrift Savings Plan offset of retired pay
// ============================================================================

pub relation judge_received_tsp_distribution_then_retired_pay(j: Individual) kind empirical {
    label en official "a judge who receives a distribution from the Thrift Savings Plan and who later receives retired pay under subsection (d)";
}
pub relation tsp_government_contribution_in_distribution(j: Individual, amount: Money) kind empirical {
    label en official "the amount of the distribution which represents the Government's contribution to the individual's Thrift Savings Account during years of service as a full-time judicial officer under the Federal Employees Retirement System, without regard to earnings attributable to that amount";
}
pub relation retired_pay_to_be_received_in_first_year(j: Individual, amount: Money) kind empirical {
    label en official "the retired pay to be received in the first year";
}
pub relation retired_pay_offset_amount(j: Individual, offset: Money) kind institutional {
    label en official "the retired pay is offset by the Government contribution that the distribution represents";
}
@source(IRC_S7447_J, relation = formalizes, coverage = exact, quote = "the retired pay shall be offset by an amount equal to the amount of the distribution which represents the Government's contribution to the individual's Thrift Savings Account during years of service as a full-time judicial officer under the Federal Employees Retirement System, without regard to earnings attributable to such amount.")
rule S7447j3FOffsetAmount strict {
    label en official "the retired pay is offset by the Government's contribution represented by the distribution";
    for j: Individual;
    for amount: Money;
    when judge_received_tsp_distribution_then_retired_pay(j) and tsp_government_contribution_in_distribution(j, amount);
    then retired_pay_offset_amount(j, amount);
}
pub relation retired_pay_offset_may_be_split_over_two_years(j: Individual, halfOffset: Money) kind institutional {
    label en official "the offset would exceed 50 percent of the retired pay to be received in the first year, so it may be divided equally over the first 2 years";
}
pub relation offset_split_over_two_years_elected(j: Individual) kind empirical {
    label en official "the offset is divided equally over the first 2 years in which the individual receives the annuity";
}
@source(IRC_S7447_J, relation = formalizes, coverage = exact, quote = "Where such an offset would exceed 50 percent of the retired pay to be received in the first year, the offset may be divided equally over the first 2 years in which the individual receives the annuity.")
rule S7447j3FSplitOverTwoYears strict {
    label en official "an offset above 50 percent of the first-year retired pay may be divided equally over 2 years";
    for j: Individual;
    for offset: Money;
    for pay: Money;
    when retired_pay_offset_amount(j, offset)
        and retired_pay_to_be_received_in_first_year(j, pay)
        and offset > round(pay * 50 percent, 2, "HALF_UP");
    then retired_pay_offset_may_be_split_over_two_years(j, round(offset * 0.5, 2, "HALF_UP"));
}
@source(IRC_S7447_J, relation = formalizes, coverage = exact, quote = "the offset may be divided equally over the first 2 years in which the individual receives the annuity.")
rule S7447j3FSplitLiberty defeasible {
    label en official "the paying authority may divide the offset equally over the first 2 years";
    for j: Individual;
    for half: Money;
    when retired_pay_offset_may_be_split_over_two_years(j, half) and offset_split_over_two_years_elected(j);
    then liberty S7447j3FDivideOffsetLiberty {
        holder us.irc.core::Secretary;
        against j;
        action offset_split_over_two_years_elected(j);
        window [-infinity, infinity];
    };
}

// ============================================================================
// §7448(a)(2), (4), (5), (6) — judge, special trial judge, their salaries
// ============================================================================

pub relation chief_judge_or_judge_of_tax_court(j: Individual) kind empirical {
    label en official "the chief judge or a judge of the Tax Court";
}
pub relation receives_retired_pay_or_compensation_under_7447(j: Individual) kind empirical {
    label en official "an individual receiving retired pay (or compensation in lieu of retired pay) under section 7447, whether or not performing judicial duties pursuant to section 7447(c)";
}
pub relation is_judge_for_7448(j: Individual) kind institutional {
    label en official "a judge for purposes of section 7448";
}
@source(IRC_S7448_A, relation = formalizes, coverage = exact, quote = "The term \"judge\" means the chief judge or a judge of the Tax Court, including any individual receiving retired pay (or compensation in lieu of retired pay) under section 7447 whether or not performing judicial duties pursuant to section 7447(c).")
rule S7448a2JudgeOfTaxCourt strict {
    label en official "the chief judge or a judge of the Tax Court is a judge";
    for j: Individual;
    when chief_judge_or_judge_of_tax_court(j);
    then is_judge_for_7448(j);
}
rule S7448a2JudgeReceivingRetiredPay strict {
    label en official "an individual receiving retired pay or compensation in lieu of it under section 7447 is a judge, performing judicial duties or not";
    for j: Individual;
    when receives_retired_pay_or_compensation_under_7447(j);
    then is_judge_for_7448(j);
}
pub enum JudgeSalarySource {
    SalaryUnder7443c;
    RetiredPayUnder7447d;
    CompensationInLieuUnder7447c;
    label en unofficial "the amounts that make up a judge's salary under section 7448(a)(4)";
}
pub relation judge_salary_component(j: Individual, origin: JudgeSalarySource, amount: Money) kind empirical {
    label en official "an amount received by the judge of the source";
}
pub relation judges_salary(j: Individual, total: Money) kind institutional {
    label en official "the salary of a judge received under section 7443(c), retired pay received under section 7447(d), and compensation (in lieu of retired pay) received under section 7447(c)";
}
@source(IRC_S7448_A, relation = formalizes, coverage = exact, quote = "The term \"judge's salary\" means the salary of a judge received under section 7443(c), retired pay received under section 7447(d), and compensation (in lieu of retired pay) received under section 7447(c).")
rule S7448a4JudgesSalary strict {
    label en official "a judge's salary is the sum of the salary, the retired pay and the compensation in lieu of retired pay";
    for j: Individual;
    when is_judge_for_7448(j);
    then judges_salary(j, sum all amount: Money for origin: JudgeSalarySource where judge_salary_component(j, origin, amount));
}
pub relation appointed_special_trial_judge_7443A(j: Individual) kind empirical {
    label en official "a judicial officer appointed pursuant to section 7443A";
}
pub relation receives_annuity_chapter_83_or_84_title_5(j: Individual) kind empirical {
    label en official "an individual receiving an annuity under chapter 83 or 84 of title 5, United States Code";
}
pub relation is_special_trial_judge_for_7448(j: Individual) kind institutional {
    label en official "a special trial judge for purposes of section 7448";
}
@source(IRC_S7448_A, relation = formalizes, coverage = exact, quote = "The term \"special trial judge\" means a judicial officer appointed pursuant to section 7443A, including any individual receiving an annuity under chapter 83 or 84 of title 5, United States Code.")
rule S7448a5SpecialTrialJudgeAppointed strict {
    label en official "a judicial officer appointed under section 7443A is a special trial judge";
    for j: Individual;
    when appointed_special_trial_judge_7443A(j);
    then is_special_trial_judge_for_7448(j);
}
rule S7448a5SpecialTrialJudgeAnnuitant strict {
    label en official "an individual receiving an annuity under chapter 83 or 84 of title 5 is included";
    for j: Individual;
    when receives_annuity_chapter_83_or_84_title_5(j);
    then is_special_trial_judge_for_7448(j);
}
pub enum SpecialTrialJudgeSalarySource {
    SalaryUnder7443Ad;
    AnnuityChapter83Or84;
    label en unofficial "the amounts that make up a special trial judge's salary under section 7448(a)(6)";
}
pub relation special_trial_judge_salary_component(j: Individual, origin: SpecialTrialJudgeSalarySource, amount: Money) kind empirical {
    label en official "an amount received by the special trial judge of the source";
}
pub relation special_trial_judges_salary(j: Individual, total: Money) kind institutional {
    label en official "the salary of a special trial judge received under section 7443A(d), and any amount received as an annuity under chapter 83 or 84 of title 5";
}
@source(IRC_S7448_A, relation = formalizes, coverage = exact, quote = "The term \"special trial judge's salary\" means the salary of a special trial judge received under section 7443A(d), any amount received as an annuity under chapter 83 or 84 of title 5, United States Code.")
rule S7448a6SpecialTrialJudgesSalary strict {
    label en official "a special trial judge's salary is the sum of the salary and the annuity amounts";
    for j: Individual;
    when is_special_trial_judge_for_7448(j);
    then special_trial_judges_salary(j, sum all amount: Money for origin: SpecialTrialJudgeSalarySource where special_trial_judge_salary_component(j, origin, amount));
}
@source(IRC_S7448_C, relation = formalizes, coverage = exact, quote = "a sum equal to 3.5 percent of such judge's or special trial judge's salary.")
rule S7448c1SalaryBaseFromJudgesSalary strict {
    label en official "the salary base of the 3.5 percent deduction is the judge's salary";
    for j: Individual;
    for total: Money;
    when judges_salary(j, total);
    then judicial_salary_for_survivors_fund(j, total);
}
rule S7448c1SalaryBaseFromSpecialTrialJudgesSalary strict {
    label en official "the salary base of the 3.5 percent deduction is the special trial judge's salary";
    for j: Individual;
    for total: Money;
    when special_trial_judges_salary(j, total);
    then judicial_salary_for_survivors_fund(j, total);
}

// ============================================================================
// §7448(c)(2)(C) — unfunded liability
// ============================================================================

pub relation fund_present_value_of_benefits(fy: Integer, amount: Money) kind empirical {
    label en official "the present value of all benefits payable from the survivors annuity fund (determined on an annual basis in accordance with section 9503 of title 31)";
}
pub relation fund_present_value_of_future_deductions(fy: Integer, amount: Money) kind empirical {
    label en official "the present value of future deductions under subsection (c)";
}
pub relation fund_present_value_of_future_deposits(fy: Integer, amount: Money) kind empirical {
    label en official "the present value of future deposits under subsection (d)";
}
pub relation fund_balance_at_close_of_fiscal_year(fy: Integer, amount: Money) kind empirical {
    label en official "the balance in the fund as of the close of the fiscal year";
}
@source(IRC_S7448_C, relation = formalizes, coverage = exact, quote = "the term \"unfunded liability\" means the amount estimated by the Secretary to be equal to the excess (as of the close of the fiscal year involved) of—")
rule S7448c2CUnfundedLiability strict {
    label en official "the unfunded liability is the excess of the present value of benefits over the present values of future deductions and deposits plus the balance (zero when there is no excess)";
    for fy: Integer;
    for benefits: Money;
    for deductions: Money;
    for deposits: Money;
    for balance: Money;
    when fund_present_value_of_benefits(fy, benefits)
        and fund_present_value_of_future_deductions(fy, deductions)
        and fund_present_value_of_future_deposits(fy, deposits)
        and fund_balance_at_close_of_fiscal_year(fy, balance);
    then unfunded_liability_of_fund(fy, max(benefits - (deductions + deposits + balance), 0.00 USD));
}

// ============================================================================
// §7448(m)(1)(A) — average annual salary of the best 3 consecutive years
// ============================================================================

pub relation annual_salary_for_annuity(j: Individual, year: Integer, amount: Money) kind empirical {
    label en official "the salary (judge's, special trial judge's, or compensation for other allowable service) received in the calendar year";
}
pub relation election_7447f4_in_effect_in_year(j: Individual, year: Integer) kind empirical {
    label en official "an election under section 7447(f)(4) is in effect for the year (the year is not taken into account)";
}
pub relation election_year_in_window(j: Individual, y0: Integer) kind institutional {
    label en unofficial "an election under section 7447(f)(4) is in effect in one of the three years starting at y0";
}
rule S7448mElectionYearInWindow0 strict {
    for j: Individual;
    for y0: Integer;
    when annual_salary_for_annuity(j, y0, _) and election_7447f4_in_effect_in_year(j, y0);
    then election_year_in_window(j, y0);
}
rule S7448mElectionYearInWindow1 strict {
    for j: Individual;
    for y0: Integer;
    for y1: Integer;
    when annual_salary_for_annuity(j, y0, _) and annual_salary_for_annuity(j, y1, _) and y1 == y0 + 1 and election_7447f4_in_effect_in_year(j, y1);
    then election_year_in_window(j, y0);
}
rule S7448mElectionYearInWindow2 strict {
    for j: Individual;
    for y0: Integer;
    for y2: Integer;
    when annual_salary_for_annuity(j, y0, _) and annual_salary_for_annuity(j, y2, _) and y2 == y0 + 2 and election_7447f4_in_effect_in_year(j, y2);
    then election_year_in_window(j, y0);
}
pub relation three_year_average_from(j: Individual, y0: Integer, average: Money) kind institutional {
    label en unofficial "the average annual salary of the three consecutive years starting at y0";
}
rule S7448mThreeYearAverage strict {
    for j: Individual;
    for y0: Integer;
    for y1: Integer;
    for y2: Integer;
    for a0: Money;
    for a1: Money;
    for a2: Money;
    when annual_salary_for_annuity(j, y0, a0)
        and annual_salary_for_annuity(j, y1, a1)
        and annual_salary_for_annuity(j, y2, a2)
        and y1 == y0 + 1
        and y2 == y0 + 2
        and not_known(election_year_in_window(j, y0));
    then three_year_average_from(j, y0, div_round(a0 + a1 + a2, 3.0, 2, "HALF_UP"));
}
pub relation higher_three_year_average_exists(j: Individual, average: Money) kind institutional {
    label en unofficial "G136 pattern: a three-year window with a strictly higher average exists";
}
rule S7448mHigherWindowExists strict {
    for j: Individual;
    for y0: Integer;
    for y1: Integer;
    for lower: Money;
    for higher: Money;
    when three_year_average_from(j, y0, lower) and three_year_average_from(j, y1, higher) and higher > lower;
    then higher_three_year_average_exists(j, lower);
}
pub relation highest_three_year_average(j: Individual, average: Money) kind institutional {
    label en unofficial "the largest average annual salary over any 3 consecutive years";
}
rule S7448mHighestWindow strict {
    for j: Individual;
    for y0: Integer;
    for avg: Money;
    when three_year_average_from(j, y0, avg) and not_known(higher_three_year_average_exists(j, avg));
    then highest_three_year_average(j, avg);
}
pub relation judicial_service_total_years(j: Individual, years: Decimal) kind empirical {
    label en official "the total period of the judge's service prior to death, in years";
}
pub relation total_salary_during_service(j: Individual, total: Money) kind empirical {
    label en official "the salary received during the total period of service prior to death";
}
@source(IRC_S7448_M, relation = formalizes, coverage = exact, quote = "during the period of 3 consecutive years in which such judge or special trial judge received the largest such average annual salary, or")
rule S7448m1AiLargestThreeYearAverage strict {
    label en official "the average annual salary is that of the 3 consecutive years with the largest average when the service is at least 3 years";
    for j: Individual;
    for years: Decimal;
    for avg: Money;
    when judicial_service_total_years(j, years) and years >= 3.0 and highest_three_year_average(j, avg);
    then average_annual_salary_for_annuity(j, avg);
}
@source(IRC_S7448_M, relation = formalizes, coverage = exact, quote = "in the case of a judge or special trial judge who has served less than 3 years, during the total period of such service prior to such judge's or special trial judge's death")
rule S7448m1AiiShortService strict {
    label en official "for less than 3 years of service the average annual salary is the total salary over the total service, per year";
    for j: Individual;
    for years: Decimal;
    for total: Money;
    when judicial_service_total_years(j, years) and years > 0.0 and years < 3.0 and total_salary_during_service(j, total);
    then average_annual_salary_for_annuity(j, div_round(total, years, 2, "HALF_UP"));
}
