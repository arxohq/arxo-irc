    label en official "section 7459(c): a proceeding on a declaratory controversy of the kind Sec7477GiftValue is a declaratory judgment proceeding under part IV of the subchapter or under section 7428";
    for pr: Proceeding;
    for p: Person;
    when declaratory_controversy(pr, p, Sec7477GiftValue);
