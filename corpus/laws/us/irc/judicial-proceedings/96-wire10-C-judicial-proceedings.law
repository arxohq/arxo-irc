// Judicial proceedings -- WIRE-10 group C (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal
// review).
//
// Section 7459(c): the decision date rule for "a declaratory judgment proceeding under part IV of this subchapter or under section 7428
// or ... an action brought under section 6234". `proceeding_is_part_iv_or_7428_or_6234` (module 06) was a case-input classification although
// module 12 of the SAME package models those proceedings (`declaratory_controversy` with a `DeclaratoryRemedy`). Part IV of the subchapter is
// sections 7476-7479; section 7428 is named separately. The classification is derived from the remedy of the controversy.
//
// JUDGMENT CALLS AND GAPS
//  - `Sec7436EmploymentStatus` (section 7436) is NOT in part IV and is not named by section 7459(c): no rule derives the classification
//    from it.
//  - The section 6234 action has no remedy in `DeclaratoryRemedy` (the package does not model it): that limb stays a case fact; the
//    derivation is therefore partial (part IV and section 7428 only).

language "law.core" version "0.2";
package us.irc.judicial_proceedings version "0.1.1";
namespace "urn:us:irc:judicial_proceedings:clir";

use self::{
    DeclaratoryRemedy,
    Person,
    Proceeding,
    declaratory_controversy,
    proceeding_is_part_iv_or_7428_or_6234,
};

rule W10CPartIvOr7428ProceedingSec7428ExemptOrganization strict {
    label en official "section 7459(c): a proceeding on a declaratory controversy of the kind Sec7428ExemptOrganization is a declaratory judgment proceeding under part IV of the subchapter or under section 7428";
    for pr: Proceeding;
    for p: Person;
    when declaratory_controversy(pr, p, Sec7428ExemptOrganization);
    then proceeding_is_part_iv_or_7428_or_6234(pr);
}

rule W10CPartIvOr7428ProceedingSec7476RetirementPlan strict {
    label en official "section 7459(c): a proceeding on a declaratory controversy of the kind Sec7476RetirementPlan is a declaratory judgment proceeding under part IV of the subchapter or under section 7428";
    for pr: Proceeding;
    for p: Person;
    when declaratory_controversy(pr, p, Sec7476RetirementPlan);
    then proceeding_is_part_iv_or_7428_or_6234(pr);
}

