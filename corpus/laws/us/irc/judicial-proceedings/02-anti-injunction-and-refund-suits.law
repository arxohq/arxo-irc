// Subchapter B — Proceedings by Taxpayers and Third Parties.
// §7421 (prohibition of suits to restrain assessment or collection — the
// Anti-Injunction Act), §7422 (civil actions for refund).
//
// METHOD NOTE (§7421(a)): modeled as an `immunity` of the United States
// against a suit to restrain assessment or collection, with one `unless`
// per named statutory exception. Exceptions this package can wire to a REAL
// consumer implementation are imported directly (§6213(a) from
// `us.irc.assessment::petition_filed_timely`; §6330(e)(1) from
// `us.irc.collection`'s CDP hearing-pending fact; §7426(a)/(b)(1) and
// §7429(b) are this package's own later sections, referenced forward).
// Exceptions with no implemented owner yet (§6015(e) innocent-spouse relief
// proceedings pending, §6212(a)/(c) notice-of-deficiency-pending window
// itself — folded into the §6213(a) reference since the Tax Court petition
// window IS the operative bar window, §6232(c) partnership adjustments,
// §6331(i) suits by taxpayers challenging certain levies, §6672(c) trust
// fund recovery penalty pre-payment proceedings, §6694(c) preparer penalty
// pre-payment proceedings, §7436 employment status proceedings) are typed
// dependency contracts: local relations declared `kind institutional`,
// EXTERNAL_DEPENDENCY in the coverage row, never asserted true by this
// package's own rules. A case may assert one of them directly as a fact
// (the case-input escape hatch every `unless` grants) but this package
// derives none of them.
//
// METHOD NOTE (§7422(a)): "No suit ... shall be maintained ... until a
// claim for refund or credit has been duly filed" is the taxpayer's
// VALIDITY CONDITION for a refund suit — modeled as `valid_when` of the
// taxpayer's `power` to bring the suit (E-0239: an invalid exercise issues
// POWER_INVALID_EXERCISE and has no jurisdictional effect, matching
// "no suit ... shall be maintained").
//
// JUDGMENT CALLS AND GAPS (see report):
//  - §7421(b) (transferee/fiduciary liability) is modeled as a second,
//    narrower immunity paralleling (a) rather than folded into it: its
//    protected class (chapter 71 transferee/31 U.S.C. 3713(b) fiduciary
//    liability) is disjoint from "any tax" and carries no exception list.
//  - §7422(b) (protest or duress) is a pure negative-condition disclaimer —
//    modeled as `not_known(...)`-free: it does not add a condition to
//    (a)'s validity condition, it REMOVES a possible one (payment "under
//    protest or duress" is not itself grounds for invalidity). Modeled as
//    a `unless`-defeater that would have blocked filing on some other
//    ground never stated in the pinned text; since the text names no such
//    ground, (b) is NON_NORMATIVE for this package (a standing disclaimer
//    with nothing left to disclaim once (a)'s single condition is modeled
//    correctly).
//  - §7422(c) (suits by shipowners — a narrow historical special rule about
//    tonnage duties) and §7422(e) (stay of Tax Court proceedings pending a
//    refund suit on a related issue), §7422(f) (suit against the United
//    States only; officers/employees not liable), §7422(g)-(k) (further
//    narrow special rules — Puerto Rico/possessions, etc.) stay
//    `unreviewed` this stage per the task's "everything else stays
//    unreviewed" instruction; only (a) is modeled fully as instructed.

language "law.core" version "0.2";
package us.irc.judicial_proceedings version "0.1.1";
namespace "urn:us:irc:judicial_proceedings:clir";

use self::{
    Claim,
    IRC_S7421_A,
    IRC_S7421_B,
    IRC_S7422_A,
    IRC_S7422_F,
    Individual,
    Notice,
    Person,
    Proceeding,
    TaxKind,
    TaxableYear,
};

// ============================================================================
// §7421(a) — Prohibition of suits to restrain assessment or collection of tax
// ============================================================================

pub relation suit_to_restrain_assessment_or_collection(pr: Proceeding, p: Person) kind empirical {
    label en unofficial "a suit for the purpose of restraining the assessment or collection of any tax is maintained by a person (whether or not the person against whom such tax was assessed)";
}

// --- typed dependency contracts for exceptions with no implemented owner ---
pub relation exception_6015e_innocent_spouse_pending(pr: Proceeding, p: Person) kind institutional {
    label en unofficial "§6015(e)(1)(B)(ii): the person has made a §6015 election or request and the §6015(e)(1)(B) prohibition on levy or proceeding is still in force — read from us.irc.returns::collection_bar_6015e_in_force (WIRE-5); a case may still assert it directly";
}
@source(IRC_S7421_A, relation = formalizes, coverage = partial, quote = "Except as provided in sections 6015(e), 6212(a) and (c), 6213(a), 6232(c), 6330(e)(1), 6331(i), 6672(c), 6694(c), 7426(a) and (b)(1), 7429(b), and 7436, no suit for the purpose of restraining the assessment or collection of any tax shall be maintained in any court by any person, whether or not such person is the person against whom such tax was assessed.")
rule S7421A6015eExceptionFromReliefRequest defeasible {
    for pr: Proceeding;
    for pi: Individual;
    for spouse: Individual;
    for y: TaxableYear;
    when suit_to_restrain_assessment_or_collection(pr, pi)
        and us.irc.returns::collection_bar_6015e_in_force(pi, spouse, y);
    then exception_6015e_innocent_spouse_pending(pr, pi);
}
pub relation exception_6232c_partnership_adjustment(pr: Proceeding, p: Person) kind institutional {
    label en unofficial "typed dependency (§6232(c)) — not yet exposed; EXTERNAL_DEPENDENCY";
}
pub relation exception_6331i_levy_challenge(pr: Proceeding, p: Person) kind institutional {
    label en unofficial "typed dependency (§6331(i)) — not yet exposed by us.irc.collection; EXTERNAL_DEPENDENCY";
}
pub relation exception_6672c_trust_fund_penalty_prepayment(pr: Proceeding, p: Person) kind institutional {
    label en unofficial "typed dependency (§6672(c)) — not yet exposed; EXTERNAL_DEPENDENCY";
}
pub relation exception_6694c_preparer_penalty_prepayment(pr: Proceeding, p: Person) kind institutional {
    label en unofficial "typed dependency (§6694(c)) — not yet exposed; EXTERNAL_DEPENDENCY";
}
pub relation exception_7436_employment_status(pr: Proceeding, p: Person) kind institutional {
    label en unofficial "typed dependency (§7436) — out of this stage's prioritized sections; EXTERNAL_DEPENDENCY";
}

@source(IRC_S7421_A, relation = formalizes, coverage = exact, quote = "Except as provided in sections 6015(e), 6212(a) and (c), 6213(a), 6232(c), 6330(e)(1), 6331(i), 6672(c), 6694(c), 7426(a) and (b)(1), 7429(b), and 7436, no suit for the purpose of restraining the assessment or collection of any tax shall be maintained in any court by any person, whether or not such person is the person against whom such tax was assessed.")
pub rule S7421AntiInjunctionImmunityRule defeasible {
    label en official "Except as provided in sections 6015(e), 6212(a) and (c), 6213(a), 6232(c), 6330(e)(1), 6331(i), 6672(c), 6694(c), 7426(a) and (b)(1), 7429(b), and 7436, no suit for the purpose of restraining the assessment or collection of any tax shall be maintained in any court by any person, whether or not such person is the person against whom such tax was assessed.";
    for pr: Proceeding;
    for p: Person;
    for n: Notice;
    when suit_to_restrain_assessment_or_collection(pr, p);
    then immunity S7421AntiInjunctionImmunity {
        holder us.irc.core::Secretary;
        protected_effect suit_to_restrain_assessment_or_collection(pr, p);
        window [-infinity, infinity];
    };
    unless us.irc.assessment::petition_filed_timely(pr, n, p) and suit_to_restrain_assessment_or_collection(pr, p);
    unless collection_due_process_hearing_pending(pr, p) and suit_to_restrain_assessment_or_collection(pr, p);
    unless wrongful_levy_suit_under_7426a(pr, p) and suit_to_restrain_assessment_or_collection(pr, p);
    unless jeopardy_review_suit_under_7429b(pr, p) and suit_to_restrain_assessment_or_collection(pr, p);
    unless exception_6015e_innocent_spouse_pending(pr, p) and suit_to_restrain_assessment_or_collection(pr, p);
    unless exception_6232c_partnership_adjustment(pr, p) and suit_to_restrain_assessment_or_collection(pr, p);
    unless exception_6331i_levy_challenge(pr, p) and suit_to_restrain_assessment_or_collection(pr, p);
    unless exception_6672c_trust_fund_penalty_prepayment(pr, p) and suit_to_restrain_assessment_or_collection(pr, p);
    unless exception_6694c_preparer_penalty_prepayment(pr, p) and suit_to_restrain_assessment_or_collection(pr, p);
    unless exception_7436_employment_status(pr, p) and suit_to_restrain_assessment_or_collection(pr, p);
}
pub relation collection_due_process_hearing_pending(pr: Proceeding, p: Person) kind institutional {
    label en unofficial "bridges §6330(e)(1)'s CDP-hearing-pending exception to a Proceeding; a case asserts this directly pending a real cross-reference into us.irc.collection's CDP module (its predicates key on Assessment, not Proceeding) — EXTERNAL_DEPENDENCY (naming mismatch, not absence)";
}
pub relation wrongful_levy_suit_under_7426a(pr: Proceeding, p: Person) kind institutional {
    label en unofficial "forward reference: the suit IS a §7426(a) wrongful-levy action by a person other than the assessed taxpayer (see 03-third-party-and-jeopardy.law)";
}
pub relation jeopardy_review_suit_under_7429b(pr: Proceeding, p: Person) kind institutional {
    label en unofficial "forward reference: the suit IS a §7429(b) jeopardy-assessment judicial-review action (see 03-third-party-and-jeopardy.law)";
}

// ============================================================================
// §7421(b) — Anti-injunction as to transferee/fiduciary liability
// ============================================================================

pub relation suit_to_restrain_transferee_or_fiduciary_liability(pr: Proceeding, p: Person) kind empirical {
    label en official "a suit to restrain the assessment or collection (pursuant to chapter 71) of the amount of the liability of a transferee of property of a taxpayer, or of a fiduciary under 31 U.S.C. 3713(b)";
}
@source(IRC_S7421_B, relation = formalizes, coverage = partial, quote = "No suit shall be maintained in any court for the purpose of restraining the assessment or collection (pursuant to the provisions of chapter 71) of—")
pub rule S7421TransfereeFiduciaryAntiInjunctionImmunityRule strict {
    label en official "No suit shall be maintained in any court for the purpose of restraining the assessment or collection (pursuant to the provisions of chapter 71) of—";
    for pr: Proceeding;
    for p: Person;
    when suit_to_restrain_transferee_or_fiduciary_liability(pr, p);
    then immunity S7421TransfereeFiduciaryAntiInjunctionImmunity {
        holder us.irc.core::Secretary;
        protected_effect suit_to_restrain_transferee_or_fiduciary_liability(pr, p);
        window [-infinity, infinity];
    };
}

// ============================================================================
// §7422(a) — No suit prior to filing claim for refund
// ============================================================================

pub relation refund_suit_brought(pr: Proceeding, p: Person, c: Claim) kind empirical {
    label en unofficial "a suit or proceeding for the recovery of an internal revenue tax alleged to have been erroneously or illegally assessed or collected, a penalty claimed to have been collected without authority, or a sum alleged to have been excessive or wrongfully collected, is maintained (the taxpayer's exercise of the power to sue for refund)";
}
pub relation refund_claim_duly_filed(p: Person, c: Claim) kind institutional {
    label en unofficial "a claim for refund or credit has been duly filed with the Secretary, according to the provisions of law in that regard and the Secretary's regulations";
}
@source(IRC_S7422_A, relation = formalizes, coverage = contextual, quote = "until a claim for refund or credit has been duly filed with the Secretary, according to the provisions of law in that regard, and the regulations of the Secretary established in pursuance thereof")
pub rule S7422ClaimDulyFiled defeasible {
    label en official "until a claim for refund or credit has been duly filed with the Secretary, according to the provisions of law in that regard, and the regulations of the Secretary established in pursuance thereof";
    for p: Person;
    for c: Claim;
    for y: TaxableYear;
    for k: TaxKind;
    for amt: Money;
    for filedOn: Date;
    when us.irc.core::claim_filed_on(c, filedOn)
        and us.irc.core::claim_of(c, p, y, k, amt);
    then refund_claim_duly_filed(p, c);
}
@source(IRC_S7422_A, relation = formalizes, coverage = exact, quote = "No suit or proceeding shall be maintained in any court for the recovery of any internal revenue tax alleged to have been erroneously or illegally assessed or collected, or of any penalty claimed to have been collected without authority, or of any sum alleged to have been excessive or in any manner wrongfully collected, until a claim for refund or credit has been duly filed with the Secretary, according to the provisions of law in that regard, and the regulations of the Secretary established in pursuance thereof.")
pub rule S7422RefundSuitPower strict {
    label en official "No suit or proceeding shall be maintained in any court for the recovery of any internal revenue tax alleged to have been erroneously or illegally assessed or collected, or of any penalty claimed to have been collected without authority, or of any sum alleged to have been excessive or in any manner wrongfully collected, until a claim for refund or credit has been duly filed with the Secretary, according to the provisions of law in that regard, and the regulations of the Secretary established in pursuance thereof.";
    for pr: Proceeding;
    for p: Person;
    for c: Claim;
    when refund_suit_brought(pr, p, c);
    then power S7422BringRefundSuitPower {
        holder p;
        exercise refund_suit_brought(pr, p, c);
        valid_when refund_claim_duly_filed(p, c);
        effect refund_suit_permitted(pr, p, c);
    };
}
pub relation refund_suit_permitted(pr: Proceeding, p: Person, c: Claim) kind institutional {
    label en unofficial "the §7422(a) validity condition is satisfied: the suit may be maintained";
}

// ============================================================================
// §7422(f) — Suit against the United States only
// ============================================================================

pub relation refund_suit_named_defendant(pr: Proceeding, defendant: Person) kind empirical;
pub relation defendant_is_united_states(defendant: Person) kind empirical {
    label en unofficial "the named defendant is the United States (a case-input classification fact; `us.irc.definitions` does not yet expose a `united_states_entity` test to import — EXTERNAL_DEPENDENCY)";
}
@source(IRC_S7422_F, relation = formalizes, coverage = partial, quote = "A suit or proceeding referred to in subsection (a) may be maintained only against the United States and not against any officer or employee of the United States (or former officer or employee) or his personal representative.")
pub rule S7422SuitAgainstUnitedStatesOnly strict {
    label en official "A suit or proceeding referred to in subsection (a) may be maintained only against the United States and not against any officer or employee of the United States (or former officer or employee) or his personal representative.";
    for pr: Proceeding;
    for p: Person;
    for c: Claim;
    for defendant: Person;
    when refund_suit_permitted(pr, p, c)
        and refund_suit_named_defendant(pr, defendant)
        and defendant_is_united_states(defendant);
    then immunity S7422OfficerNotPersonallyLiableImmunity {
        holder us.irc.core::Secretary;
        protected_effect refund_suit_named_defendant(pr, defendant);
        window [-infinity, infinity];
    };
}
