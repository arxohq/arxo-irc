// Stage 2 — §7425: discharge of liens (judicial proceedings to which the
// United States is not a party, non-judicial sales, notice of sale, consent,
// perishable goods, redemption by the United States).
//
// METHOD NOTE. A sale or judgment is a `Transaction` (core) or a
// `Proceeding`; the lien of the United States is a `Lien`. "Subject to
// and without disturbing the lien" and "the same effect ... as local law
// provides" are the two institutional outcomes of the section; each has
// its own head relation so that the two branches never conflict on one
// head. "More than 30 days before such sale" is a strict comparison with a
// calendar-day offset (`add_calendar_period(filedOn, 30 calendar_day) <
// saleDate`). The redemption period is "the longer of" 120 days and the
// local period, computed with the two-rule pattern of TECH-GAPS G173.
//
// JUDGMENT CALLS AND GAPS. Notice "in accordance with regulations
// prescribed by the Secretary" is taken as a case fact about the notice;
// the amount to be paid on redemption is fixed by 28 U.S.C. 2410(d), which
// is outside Title 26 (EXTERNAL_DEPENDENCY). "Without delay" (§7425(d)(3)(B))
// names no day count: the recording duty has an open window (TECH-GAPS
// G2901).

language "law.core" version "0.2";
package us.irc.judicial_proceedings version "0.1.1";
namespace "urn:us:irc:judicial_proceedings:clir";

use self::{
    IRC_S7425_A,
    IRC_S7425_B,
    IRC_S7425_C,
    IRC_S7425_D,
    Lien,
    Proceeding,
    Transaction,
};

// ============================================================================
// §7425(a) — Judicial proceedings to which the United States is not a party
// ============================================================================

pub relation us_not_joined_in_2410_action(pr: Proceeding, lien: Lien) kind empirical {
    label en official "the United States is not joined as a party in a civil action or suit described in subsection (a) of section 2410 of title 28 of the United States Code, with respect to property on which the United States has or claims a lien under the provisions of this title";
}
pub relation lien_notice_filed_when_action_commenced(pr: Proceeding, lien: Lien) kind empirical {
    label en official "notice of such lien has been filed in the place provided by law for such filing at the time such action or suit is commenced";
}
pub relation law_makes_no_provision_for_lien_notice_filing(lien: Lien) kind empirical {
    label en official "the law makes no provision for such filing";
}
pub relation judgment_or_sale_subject_to_us_lien(pr: Proceeding, lien: Lien) kind institutional {
    label en unofficial "the judgment or judicial sale is made subject to and without disturbing the lien of the United States";
}
@source(IRC_S7425_A, relation = formalizes, coverage = exact, quote = "(1) shall be made subject to and without disturbing the lien of the United States, if notice of such lien has been filed in the place provided by law for such filing at the time such action or suit is commenced, or")
pub rule S7425a1SubjectToLien defeasible {
    label en official "(1) shall be made subject to and without disturbing the lien of the United States, if notice of such lien has been filed in the place provided by law for such filing at the time such action or suit is commenced, or";
    for pr: Proceeding;
    for lien: Lien;
    when us_not_joined_in_2410_action(pr, lien)
        and lien_notice_filed_when_action_commenced(pr, lien);
    then judgment_or_sale_subject_to_us_lien(pr, lien);
}
pub relation local_law_governs_lien_discharge_in_judicial_proceeding(pr: Proceeding, lien: Lien) kind institutional {
    label en unofficial "the judgment or judicial sale has the same effect on discharge or divestment of the lien as the local law of the place where the property is situated provides";
}
@source(IRC_S7425_A, relation = formalizes, coverage = exact, quote = "(2) shall have the same effect with respect to the discharge or divestment of such lien of the United States as may be provided with respect to such matters by the local law of the place where such property is situated, if no notice of such lien has been filed in the place provided by law for such filing at the time such action or suit is commenced or if the law makes no provision for such filing.")
pub rule S7425a2LocalLawNoticeNotFiled defeasible {
    label en official "(2) shall have the same effect with respect to the discharge or divestment of such lien of the United States as may be provided with respect to such matters by the local law of the place where such property is situated, if no notice of such lien has been filed in the place provided by law for such filing at the time such action or suit is commenced or if the law makes no provision for such filing.";
    for pr: Proceeding;
    for lien: Lien;
    when us_not_joined_in_2410_action(pr, lien)
        and not_known(lien_notice_filed_when_action_commenced(pr, lien));
    then local_law_governs_lien_discharge_in_judicial_proceeding(pr, lien);
}
@source(IRC_S7425_A, relation = formalizes, coverage = exact, quote = "(2) shall have the same effect with respect to the discharge or divestment of such lien of the United States as may be provided with respect to such matters by the local law of the place where such property is situated, if no notice of such lien has been filed in the place provided by law for such filing at the time such action or suit is commenced or if the law makes no provision for such filing.")
pub rule S7425a2LocalLawNoProvision defeasible {
    label en official "(2) shall have the same effect with respect to the discharge or divestment of such lien of the United States as may be provided with respect to such matters by the local law of the place where such property is situated, if no notice of such lien has been filed in the place provided by law for such filing at the time such action or suit is commenced or if the law makes no provision for such filing.";
    for pr: Proceeding;
    for lien: Lien;
    when us_not_joined_in_2410_action(pr, lien)
        and law_makes_no_provision_for_lien_notice_filing(lien);
    then local_law_governs_lien_discharge_in_judicial_proceeding(pr, lien);
}
pub relation judicial_sale_discharges_us_lien(pr: Proceeding, lien: Lien) kind empirical {
    label en official "a judicial sale of property pursuant to a judgment in any civil action or suit to which the United States is not a party discharges a lien of the United States arising under the provisions of this title";
}
pub relation sale_proceeds_distribution_ordered_on(pr: Proceeding, on: Date) kind empirical {
    label en official "the distribution of such proceeds is ordered";
}
pub relation us_claims_sale_proceeds_on(pr: Proceeding, lien: Lien, on: Date) kind empirical;
pub relation proceeds_claim_timely(pr: Proceeding, lien: Lien, on: Date) kind institutional {
    label en unofficial "the claim to the proceeds is made before the distribution of such proceeds is ordered";
}
@source(IRC_S7425_A, relation = formalizes, coverage = exact, quote = "the United States may claim, with the same priority as its lien had against the property sold, the proceeds (exclusive of costs) of such sale at any time before the distribution of such proceeds is ordered.")
pub rule S7425aProceedsClaimBeforeDistribution defeasible {
    label en official "the United States may claim, with the same priority as its lien had against the property sold, the proceeds (exclusive of costs) of such sale at any time before the distribution of such proceeds is ordered.";
    for pr: Proceeding;
    for lien: Lien;
    for on: Date;
    for distributionOn: Date;
    when judicial_sale_discharges_us_lien(pr, lien)
        and us_claims_sale_proceeds_on(pr, lien, on)
        and sale_proceeds_distribution_ordered_on(pr, distributionOn)
        and on < distributionOn;
    then proceeds_claim_timely(pr, lien, on);
}
@source(IRC_S7425_A, relation = formalizes, coverage = exact, quote = "the United States may claim, with the same priority as its lien had against the property sold, the proceeds (exclusive of costs) of such sale at any time before the distribution of such proceeds is ordered.")
pub rule S7425aProceedsClaimNoDistributionYet defeasible {
    label en official "the United States may claim, with the same priority as its lien had against the property sold, the proceeds (exclusive of costs) of such sale at any time before the distribution of such proceeds is ordered.";
    for pr: Proceeding;
    for lien: Lien;
    for on: Date;
    when judicial_sale_discharges_us_lien(pr, lien)
        and us_claims_sale_proceeds_on(pr, lien, on)
        and not_known(distribution_ordered_at_all(pr));
    then proceeds_claim_timely(pr, lien, on);
}
pub relation distribution_ordered_at_all(pr: Proceeding) kind institutional {
    label en unofficial "some distribution of the sale proceeds has been ordered (bridges sale_proceeds_distribution_ordered_on to not_known)";
}
rule S7425aDistributionOrderedBridge strict {
    for pr: Proceeding;
    for distributionOn: Date;
    when sale_proceeds_distribution_ordered_on(pr, distributionOn);
    then distribution_ordered_at_all(pr);
}
pub relation us_proceeds_claim_allowed_with_lien_priority(pr: Proceeding, lien: Lien) kind institutional;
@source(IRC_S7425_A, relation = formalizes, coverage = exact, quote = "the United States may claim, with the same priority as its lien had against the property sold, the proceeds (exclusive of costs) of such sale")
pub rule S7425aProceedsClaimPowerRule defeasible {
    label en official "the United States may claim, with the same priority as its lien had against the property sold, the proceeds (exclusive of costs) of such sale";
    for pr: Proceeding;
    for lien: Lien;
    for on: Date;
    when us_claims_sale_proceeds_on(pr, lien, on);
    then power S7425aClaimSaleProceeds {
        holder us.irc.core::Secretary;
        exercise us_claims_sale_proceeds_on(pr, lien, on);
        valid_when proceeds_claim_timely(pr, lien, on);
        effect us_proceeds_claim_allowed_with_lien_priority(pr, lien);
    };
}

// ============================================================================
// §7425(b) — Other sales (contractual, confession of judgment, non-judicial)
// ============================================================================

pub relation non_judicial_sale_of_lien_property(sale: Transaction, lien: Lien) kind empirical {
    label en official "a sale of property on which the United States has or claims a lien, or a title derived from enforcement of a lien, under the provisions of this title, made pursuant to an instrument creating a lien on such property, pursuant to a confession of judgment on the obligation secured by such an instrument, or pursuant to a nonjudicial sale under a statutory lien on such property";
}
pub relation forfeiture_of_land_sales_contract(sale: Transaction) kind empirical {
    label en official "any forfeiture of a land sales contract";
}
pub relation treated_as_sale_for_7425b(sale: Transaction) kind institutional;
@source(IRC_S7425_C, relation = formalizes, coverage = exact, quote = "For purposes of subsection (b), a sale of property includes any forfeiture of a land sales contract.")
pub rule S7425c4LandContractForfeitureIsSale strict {
    label en official "For purposes of subsection (b), a sale of property includes any forfeiture of a land sales contract.";
    for sale: Transaction;
    when forfeiture_of_land_sales_contract(sale);
    then treated_as_sale_for_7425b(sale);
}
pub relation lien_notice_filed_on(lien: Lien, on: Date) kind empirical {
    label en official "notice of such lien was filed or such title recorded in the place provided by law for such filing or recording";
}
pub relation sale_date(sale: Transaction, on: Date) kind empirical;
pub relation lien_notice_filed_over_30_days_before_sale(sale: Transaction, lien: Lien) kind institutional {
    label en unofficial "notice of the lien was filed more than 30 days before the sale";
}
@source(IRC_S7425_B, relation = formalizes, coverage = exact, quote = "if notice of such lien was filed or such title recorded in the place provided by law for such filing or recording more than 30 days before such sale")
pub rule S7425b1NoticeFiledOver30DaysBefore defeasible {
    label en official "if notice of such lien was filed or such title recorded in the place provided by law for such filing or recording more than 30 days before such sale";
    for sale: Transaction;
    for lien: Lien;
    for filedOn: Date;
    for soldOn: Date;
    when lien_notice_filed_on(lien, filedOn)
        and sale_date(sale, soldOn)
        and add_calendar_period(filedOn, 30 calendar_day) < soldOn;
    then lien_notice_filed_over_30_days_before_sale(sale, lien);
}
pub relation notice_of_sale_given_in_writing(sale: Transaction) kind empirical {
    label en official "Notice of a sale to which subsection (b) applies shall be given in writing";
}
pub relation notice_of_sale_by_mail_or_personal_service(sale: Transaction) kind empirical {
    label en official "by registered or certified mail or by personal service";
}
pub relation notice_of_sale_given_to_secretary_on(sale: Transaction, on: Date) kind empirical {
    label en official "to the Secretary";
}
pub relation notice_of_sale_given_25_days_before(sale: Transaction) kind institutional {
    label en unofficial "notice of the sale was given in the manner prescribed in §7425(c)(1): in writing, by registered or certified mail or personal service, not less than 25 days prior to the sale, to the Secretary";
}
@source(IRC_S7425_C, relation = formalizes, coverage = exact, quote = "Notice of a sale to which subsection (b) applies shall be given (in accordance with regulations prescribed by the Secretary) in writing, by registered or certified mail or by personal service, not less than 25 days prior to such sale, to the Secretary.")
pub rule S7425c1NoticeOfSaleManner defeasible {
    label en official "Notice of a sale to which subsection (b) applies shall be given (in accordance with regulations prescribed by the Secretary) in writing, by registered or certified mail or by personal service, not less than 25 days prior to such sale, to the Secretary.";
    for sale: Transaction;
    for givenOn: Date;
    for soldOn: Date;
    when notice_of_sale_given_in_writing(sale)
        and notice_of_sale_by_mail_or_personal_service(sale)
        and notice_of_sale_given_to_secretary_on(sale, givenOn)
        and sale_date(sale, soldOn)
        and add_calendar_period(givenOn, 25 calendar_day) <= soldOn;
    then notice_of_sale_given_25_days_before(sale);
}
pub relation sale_subject_to_us_lien_or_title(sale: Transaction, lien: Lien) kind institutional {
    label en unofficial "the sale is made subject to and without disturbing the lien or title of the United States";
}
@source(IRC_S7425_B, relation = formalizes, coverage = exact, quote = "(1) shall, except as otherwise provided, be made subject to and without disturbing such lien or title, if notice of such lien was filed or such title recorded in the place provided by law for such filing or recording more than 30 days before such sale and the United States is not given notice of such sale in the manner prescribed in subsection (c)(1); or")
pub rule S7425b1SubjectToLien defeasible {
    label en official "(1) shall, except as otherwise provided, be made subject to and without disturbing such lien or title, if notice of such lien was filed or such title recorded in the place provided by law for such filing or recording more than 30 days before such sale and the United States is not given notice of such sale in the manner prescribed in subsection (c)(1); or";
    for sale: Transaction;
    for lien: Lien;
    when non_judicial_sale_of_lien_property(sale, lien)
        and lien_notice_filed_over_30_days_before_sale(sale, lien)
        and not_known(notice_of_sale_given_25_days_before(sale));
    then sale_subject_to_us_lien_or_title(sale, lien);
}
pub relation local_law_governs_discharge_of_us_lien_on_sale(sale: Transaction, lien: Lien) kind institutional {
    label en unofficial "the sale has the same effect on discharge or divestment of the lien or title of the United States as the local law of the place where the property is situated provides";
}
@source(IRC_S7425_B, relation = formalizes, coverage = exact, quote = "(A) notice of such lien or such title was not filed or recorded in the place provided by law for such filing more than 30 days before such sale,")
pub rule S7425b2ANoticeNotFiledInTime defeasible {
    label en official "(A) notice of such lien or such title was not filed or recorded in the place provided by law for such filing more than 30 days before such sale,";
    for sale: Transaction;
    for lien: Lien;
    when non_judicial_sale_of_lien_property(sale, lien)
        and not_known(lien_notice_filed_over_30_days_before_sale(sale, lien));
    then local_law_governs_discharge_of_us_lien_on_sale(sale, lien);
}
@source(IRC_S7425_B, relation = formalizes, coverage = exact, quote = "(B) the law makes no provision for such filing, or")
pub rule S7425b2BNoFilingProvision defeasible {
    label en official "(B) the law makes no provision for such filing, or";
    for sale: Transaction;
    for lien: Lien;
    when non_judicial_sale_of_lien_property(sale, lien)
        and law_makes_no_provision_for_lien_notice_filing(lien);
    then local_law_governs_discharge_of_us_lien_on_sale(sale, lien);
}
@source(IRC_S7425_B, relation = formalizes, coverage = exact, quote = "(C) notice of such sale is given in the manner prescribed in subsection (c)(1).")
pub rule S7425b2CNoticeOfSaleGiven defeasible {
    label en official "(C) notice of such sale is given in the manner prescribed in subsection (c)(1).";
    for sale: Transaction;
    for lien: Lien;
    when non_judicial_sale_of_lien_property(sale, lien)
        and notice_of_sale_given_25_days_before(sale);
    then local_law_governs_discharge_of_us_lien_on_sale(sale, lien);
}

// ============================================================================
// §7425(c)(2)-(3) — Consent to sale; perishable goods
// ============================================================================

pub relation us_consents_to_sale_free_of_lien(sale: Transaction, lien: Lien) kind empirical {
    label en official "the United States consents to the sale of such property free of such lien or title";
}
pub relation property_perishable_or_costly_to_keep(sale: Transaction) kind empirical {
    label en official "property liable to perish or become greatly reduced in price or value by keeping, or which cannot be kept without great expense";
}
pub relation notice_of_perishable_sale_given_before_sale(sale: Transaction) kind empirical {
    label en official "notice of such sale is given in writing, by registered or certified mail or by personal service, to the Secretary before such sale";
}
pub relation sale_discharges_us_lien_or_title(sale: Transaction, lien: Lien) kind institutional {
    label en unofficial "the sale discharges or divests the property of the lien or title of the United States";
}
@source(IRC_S7425_C, relation = formalizes, coverage = exact, quote = "a sale described in subsection (b) of property shall discharge or divest such property of the lien or title of the United States if the United States consents to the sale of such property free of such lien or title.")
pub rule S7425c2ConsentDischarges defeasible {
    label en official "a sale described in subsection (b) of property shall discharge or divest such property of the lien or title of the United States if the United States consents to the sale of such property free of such lien or title.";
    for sale: Transaction;
    for lien: Lien;
    when non_judicial_sale_of_lien_property(sale, lien)
        and us_consents_to_sale_free_of_lien(sale, lien);
    then sale_discharges_us_lien_or_title(sale, lien);
}
@source(IRC_S7425_C, relation = formalizes, coverage = exact, quote = "a sale described in subsection (b) of property liable to perish or become greatly reduced in price or value by keeping, or which cannot be kept without great expense, shall discharge or divest such property of the lien or title of the United States if notice of such sale is given")
pub rule S7425c3PerishableDischarges defeasible {
    label en official "a sale described in subsection (b) of property liable to perish or become greatly reduced in price or value by keeping, or which cannot be kept without great expense, shall discharge or divest such property of the lien or title of the United States if notice of such sale is given";
    for sale: Transaction;
    for lien: Lien;
    when non_judicial_sale_of_lien_property(sale, lien)
        and property_perishable_or_costly_to_keep(sale)
        and notice_of_perishable_sale_given_before_sale(sale);
    then sale_discharges_us_lien_or_title(sale, lien);
}
pub relation perishable_sale_proceeds_fund_holding_end(sale: Transaction, until: Date) kind institutional {
    label en unofficial "the proceeds (exclusive of costs) are held as a fund subject to the liens and claims of the United States, with the same priority, for not less than 30 days after the date of the sale";
}
@source(IRC_S7425_C, relation = formalizes, coverage = exact, quote = "The proceeds (exclusive of costs) of such sale shall be held as a fund subject to the liens and claims of the United States, in the same manner and with the same priority as such liens and claims had with respect to the property sold, for not less than 30 days after the date of such sale.")
pub rule S7425c3ProceedsHeldAsFund defeasible {
    label en official "The proceeds (exclusive of costs) of such sale shall be held as a fund subject to the liens and claims of the United States, in the same manner and with the same priority as such liens and claims had with respect to the property sold, for not less than 30 days after the date of such sale.";
    for sale: Transaction;
    for lien: Lien;
    for soldOn: Date;
    when sale_discharges_us_lien_or_title(sale, lien)
        and property_perishable_or_costly_to_keep(sale)
        and sale_date(sale, soldOn);
    then perishable_sale_proceeds_fund_holding_end(sale, add_calendar_period(soldOn, 30 calendar_day));
}

// ============================================================================
// §7425(d) — Redemption of real property by the United States
// ============================================================================

pub relation real_property_sale_to_satisfy_prior_lien(sale: Transaction, lien: Lien) kind empirical {
    label en official "a sale of real property to which subsection (b) applies to satisfy a lien prior to that of the United States";
}
pub relation local_law_redemption_period_end(sale: Transaction, on: Date) kind empirical {
    label en official "the period allowable for redemption under local law";
}
pub relation local_law_redemption_period_exists(sale: Transaction) kind empirical;
pub relation redemption_period_end(sale: Transaction, lastDay: Date) kind institutional {
    label en unofficial "the last day for redemption by the United States: the longer of 120 days from the sale and the local-law redemption period";
}
@source(IRC_S7425_D, relation = formalizes, coverage = exact, quote = "the Secretary may redeem such property within the period of 120 days from the date of such sale or the period allowable for redemption under local law, whichever is longer.")
pub rule S7425d1PeriodNoLocalLaw defeasible {
    label en official "the Secretary may redeem such property within the period of 120 days from the date of such sale or the period allowable for redemption under local law, whichever is longer.";
    for sale: Transaction;
    for soldOn: Date;
    when sale_date(sale, soldOn)
        and not_known(local_law_redemption_period_exists(sale));
    then redemption_period_end(sale, add_calendar_period(soldOn, 120 calendar_day));
}
@source(IRC_S7425_D, relation = formalizes, coverage = exact, quote = "the Secretary may redeem such property within the period of 120 days from the date of such sale or the period allowable for redemption under local law, whichever is longer.")
pub rule S7425d1Period120DaysLonger defeasible {
    label en official "the Secretary may redeem such property within the period of 120 days from the date of such sale or the period allowable for redemption under local law, whichever is longer.";
    for sale: Transaction;
    for soldOn: Date;
    for localEnd: Date;
    when sale_date(sale, soldOn)
        and local_law_redemption_period_end(sale, localEnd)
        and add_calendar_period(soldOn, 120 calendar_day) >= localEnd;
    then redemption_period_end(sale, add_calendar_period(soldOn, 120 calendar_day));
}
@source(IRC_S7425_D, relation = formalizes, coverage = exact, quote = "the Secretary may redeem such property within the period of 120 days from the date of such sale or the period allowable for redemption under local law, whichever is longer.")
pub rule S7425d1PeriodLocalLawLonger defeasible {
    label en official "the Secretary may redeem such property within the period of 120 days from the date of such sale or the period allowable for redemption under local law, whichever is longer.";
    for sale: Transaction;
    for soldOn: Date;
    for localEnd: Date;
    when sale_date(sale, soldOn)
        and local_law_redemption_period_end(sale, localEnd)
        and add_calendar_period(soldOn, 120 calendar_day) < localEnd;
    then redemption_period_end(sale, localEnd);
}
pub relation secretary_redeems_on(sale: Transaction, on: Date) kind empirical;
pub relation redemption_timely_and_available(sale: Transaction, on: Date) kind institutional;
@source(IRC_S7425_D, relation = formalizes, coverage = exact, quote = "In the case of a sale of real property to which subsection (b) applies to satisfy a lien prior to that of the United States, the Secretary may redeem such property")
pub rule S7425d1RedemptionAvailable defeasible {
    label en official "In the case of a sale of real property to which subsection (b) applies to satisfy a lien prior to that of the United States, the Secretary may redeem such property";
    for sale: Transaction;
    for lien: Lien;
    for on: Date;
    for lastDay: Date;
    when real_property_sale_to_satisfy_prior_lien(sale, lien)
        and non_judicial_sale_of_lien_property(sale, lien)
        and secretary_redeems_on(sale, on)
        and redemption_period_end(sale, lastDay)
        and on <= lastDay;
    then redemption_timely_and_available(sale, on);
}
pub relation real_property_redeemed_by_us(sale: Transaction) kind institutional;
@source(IRC_S7425_D, relation = formalizes, coverage = exact, quote = "the Secretary may redeem such property within the period of 120 days from the date of such sale or the period allowable for redemption under local law, whichever is longer.")
pub rule S7425d1RedeemPowerRule defeasible {
    label en official "the Secretary may redeem such property within the period of 120 days from the date of such sale or the period allowable for redemption under local law, whichever is longer.";
    for sale: Transaction;
    for on: Date;
    when secretary_redeems_on(sale, on);
    then power S7425d1RedeemRealProperty {
        holder us.irc.core::Secretary;
        exercise secretary_redeems_on(sale, on);
        valid_when redemption_timely_and_available(sale, on);
        effect real_property_redeemed_by_us(sale);
    };
}
pub relation redemption_documents_or_certificate_obtained(sale: Transaction) kind empirical {
    label en official "the Secretary shall apply to the officer designated by local law, if any, for the documents necessary to evidence the fact of redemption and to record title to such property in the name of the United States. If no such officer is designated by local law or if such officer fails to issue such documents, the Secretary shall execute a certificate of redemption therefor";
}
@source(IRC_S7425_D, relation = formalizes, coverage = exact, quote = "In any case in which real property is redeemed by the United States pursuant to this subsection, the Secretary shall apply to the officer designated by local law, if any, for the documents necessary to evidence the fact of redemption and to record title to such property in the name of the United States.")
pub rule S7425d3ADocumentsDutyRule strict {
    label en official "In any case in which real property is redeemed by the United States pursuant to this subsection, the Secretary shall apply to the officer designated by local law, if any, for the documents necessary to evidence the fact of redemption and to record title to such property in the name of the United States.";
    for sale: Transaction;
    when real_property_redeemed_by_us(sale);
    then duty S7425d3AObtainRedemptionDocuments {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition redemption_documents_or_certificate_obtained(sale);
            window [-infinity, infinity];
        }
    };
}
pub relation redemption_certificate_or_documents_recorded(sale: Transaction) kind empirical {
    label en official "cause such documents or certificate to be duly recorded in the proper registry of deeds (or filed in the office of the clerk of the United States district court for the judicial district in which such property is situated)";
}
@source(IRC_S7425_D, relation = formalizes, coverage = exact, quote = "The Secretary shall, without delay, cause such documents or certificate to be duly recorded in the proper registry of deeds.")
pub rule S7425d3BRecordingDutyRule strict {
    label en official "The Secretary shall, without delay, cause such documents or certificate to be duly recorded in the proper registry of deeds.";
    for sale: Transaction;
    when real_property_redeemed_by_us(sale);
    then duty S7425d3BRecordRedemptionCertificate {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition redemption_certificate_or_documents_recorded(sale);
            window [-infinity, infinity];
        }
    };
}
pub relation certificate_of_redemption_executed(sale: Transaction) kind empirical;
pub relation certificate_prima_facie_evidence_of_regular_redemption(sale: Transaction) kind institutional;
@source(IRC_S7425_D, relation = formalizes, coverage = exact, quote = "A certificate of redemption executed by the Secretary shall constitute prima facie evidence of the regularity of such redemption")
pub rule S7425d3CPrimaFacieEvidence strict {
    label en official "A certificate of redemption executed by the Secretary shall constitute prima facie evidence of the regularity of such redemption";
    for sale: Transaction;
    when certificate_of_redemption_executed(sale);
    then certificate_prima_facie_evidence_of_regular_redemption(sale);
}
pub relation certificate_recorded_on(sale: Transaction, on: Date) kind empirical;
pub relation redeemed_rights_transferred_to_us(sale: Transaction) kind institutional;
@source(IRC_S7425_D, relation = formalizes, coverage = exact, quote = "shall, when recorded, transfer to the United States all the rights, title, and interest in and to such property acquired by the person from whom the United States redeems such property by virtue of the sale of such property.")
pub rule S7425d3CRightsTransferredOnRecording strict {
    label en official "shall, when recorded, transfer to the United States all the rights, title, and interest in and to such property acquired by the person from whom the United States redeems such property by virtue of the sale of such property.";
    for sale: Transaction;
    for on: Date;
    when certificate_of_redemption_executed(sale)
        and certificate_recorded_on(sale, on);
    then redeemed_rights_transferred_to_us(sale);
}
