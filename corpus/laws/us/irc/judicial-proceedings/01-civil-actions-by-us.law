// Subchapter A — Civil Actions by the United States.
// §7401 (authorization), §7402(a) (general district-court enforcement
// jurisdiction — narrow institutional reference, not this stage's focus),
// §7403 (action to enforce lien or subject property to payment of tax: the
// power to sue, the court's adjudication and power to decree a sale, the
// power to appoint a receiver).
//
// METHOD NOTE (§7401): "unless the Secretary authorizes or sanctions the
// proceedings and the Attorney General or his delegate directs that the
// action be commenced" is a VALIDITY CONDITION of the suit's institutional
// standing, not a power exercised by a named holder against a named `over`
// party (the statute names no `over`; the action is against whichever
// delinquent taxpayer the suit targets, established elsewhere). Modeled as
// an institutional_effect: `civil_action_authorized(pr)` holds only when
// both conditions are asserted; a suit that lacks either is simply never
// `civil_action_authorized` (NEITHER, not a fabricated FALSE), matching
// DECISION-0194's "missing fact gives NEITHER" instruction.
//
// METHOD NOTE (§7403): (a) is modeled as a `power` of the Attorney General
// (over the delinquent) whose `valid_when` is the Secretary's request
// (the refusal-or-neglect-to-pay predicate is folded into the same single
// atom per the §190/LDC-E1305 one-atom rule — see `lien_action_grounds`
// below) and whose effect is the institutional fact that the action is
// properly filed. (c) is modeled as two further powers of the court itself:
// adjudicating the merits/liens (a duty-like institutional act, modeled as
// `power` because it changes the legal relation among lienholders) and
// decreeing a sale once the United States' claim or interest is
// established. (d) similarly, a narrow power to appoint a receiver.
// (b) (joinder of lienholders) is a procedural institutional_effect with no
// separate testable consequence beyond "who must be a party" — modeled as a
// duty-like institutional relation for completeness, not scenario-tested
// beyond the sanity suite (procedural joinder has no legal-relation
// consequence this package can observe from outside the court record).
//
// JUDGMENT CALLS AND GAPS (see report):
//  - §7402(a)'s remedies are described in the abstract ("such other orders
//    and processes ... as may be necessary or appropriate"); there is no
//    closed, testable condition in the text itself. Modeled as a single
//    narrow institutional_effect keyed to the fact that the United States is
//    a party seeking enforcement — anything beyond that (the open-ended
//    "necessary or appropriate" standard) is NON_NORMATIVE / left to the
//    court's own unstructured discretion, not modeled as an evaluative
//    channel (no textual criterion for "necessary or appropriate" to route
//    through a channel).
//  - §7402(b)-(f) (summons enforcement, damages to officers, quiet title,
//    general jurisdiction cross-reference) are NON_NORMATIVE / reference for
//    this stage ("stage 2" per the task's scope note) — not modeled.
//  - §7403(a)'s §6166(g) acceleration clause ("any acceleration of payment
//    under section 6166(g) shall be treated as a neglect to pay tax") is a
//    typed dependency: `us.irc.payment-refunds-interest` does not yet expose
//    a §6166(g) acceleration predicate; modeled as a local placeholder
//    relation `installment_acceleration_under_6166g`, flagged
//    EXTERNAL_DEPENDENCY in the coverage row and `.deps.json`.
//  - §7403(d) (receivership) is modeled narrowly; the "public interest"
//    certification branch is an evaluative element with no named authority
//    other than the Secretary's own certification (a fact, not a judgment
//    call) — kept as an ordinary empirical predicate, not a channel.

language "law.core" version "0.2";
package us.irc.judicial_proceedings version "0.1.1";
namespace "urn:us:irc:judicial_proceedings:clir";

use self::{
    IRC_S7401,
    IRC_S7402_A,
    IRC_S7403_A,
    IRC_S7403_B,
    IRC_S7403_C,
    IRC_S7403_D,
    Lien,
    Person,
    Proceeding,
};


// ============================================================================
// §7401 — Authorization of civil actions for collection or recovery
// ============================================================================

pub relation secretary_authorizes_or_sanctions(pr: Proceeding) kind empirical {
    label en official "the Secretary authorizes or sanctions the proceedings";
}
pub relation attorney_general_directs_commencement(pr: Proceeding) kind empirical {
    label en official "the Attorney General or his delegate directs that the action be commenced";
}
pub relation civil_action_authorized(pr: Proceeding) kind institutional {
    label en unofficial "the §7401 validity condition for commencing a civil action for the collection or recovery of taxes, or of any fine, penalty, or forfeiture, is satisfied";
}
@source(IRC_S7401, relation = formalizes, coverage = exact, quote = "No civil action for the collection or recovery of taxes, or of any fine, penalty, or forfeiture, shall be commenced unless the Secretary authorizes or sanctions the proceedings and the Attorney General or his delegate directs that the action be commenced.")
pub rule S7401CivilActionAuthorizationCondition strict {
    label en official "No civil action for the collection or recovery of taxes, or of any fine, penalty, or forfeiture, shall be commenced unless the Secretary authorizes or sanctions the proceedings and the Attorney General or his delegate directs that the action be commenced.";
    for pr: Proceeding;
    when secretary_authorizes_or_sanctions(pr)
        and attorney_general_directs_commencement(pr);
    then civil_action_authorized(pr);
}

// ============================================================================
// §7402(a) — General jurisdiction of district courts to enforce the internal
// revenue laws (narrow institutional reference; stage-1 scope)
// ============================================================================

pub relation united_states_seeks_enforcement_order(pr: Proceeding) kind empirical {
    label en unofficial "the United States, at whose instance the action is brought, seeks a writ, order of injunction, order of ne exeat republica, receivership order, or other order or judgment necessary or appropriate for the enforcement of the internal revenue laws";
}
pub relation district_court_enforcement_jurisdiction(pr: Proceeding) kind institutional {
    label en unofficial "the district court has jurisdiction, at the instance of the United States, to make and issue the §7402(a) orders and judgments; the remedies are additional to, not exclusive of, other remedies of the United States";
}
@source(IRC_S7402_A, relation = formalizes, coverage = exact, quote = "The district courts of the United States at the instance of the United States shall have such jurisdiction to make and issue in civil actions, writs and orders of injunction, and of ne exeat republica, orders appointing receivers, and such other orders and processes, and to render such judgments and decrees as may be necessary or appropriate for the enforcement of the internal revenue laws.")
pub rule S7402aDistrictCourtEnforcementJurisdiction strict {
    label en official "The district courts of the United States at the instance of the United States shall have such jurisdiction to make and issue in civil actions, writs and orders of injunction, and of ne exeat republica, orders appointing receivers, and such other orders and processes, and to render such judgments and decrees as may be necessary or appropriate for the enforcement of the internal revenue laws.";
    for pr: Proceeding;
    when united_states_seeks_enforcement_order(pr);
    then district_court_enforcement_jurisdiction(pr);
}

// ============================================================================
// §7403 — Action to enforce lien or to subject property to payment of tax
// ============================================================================

// --- (a) Filing --------------------------------------------------------

pub relation refusal_or_neglect_to_pay(p: Person, lien: Lien) kind empirical {
    label en official "there has been a refusal or neglect to pay any tax, or to discharge any liability in respect thereof, whether or not levy has been made";
}
pub relation installment_acceleration_under_6166g(p: Person, lien: Lien) kind institutional {
    label en unofficial "typed dependency: any acceleration of payment under section 6166(g) shall be treated as a neglect to pay tax; us.irc.payment-refunds-interest does not yet expose a §6166(g) acceleration predicate to import (EXTERNAL_DEPENDENCY, see .deps.json)";
}
pub relation lien_action_grounds(p: Person, lien: Lien) kind institutional {
    label en unofficial "either §7403(a)'s refusal-or-neglect ground or its §6166(g)-acceleration ground for directing suit is present — a single atom for use in a power's `valid_when` per the one-atom rule";
}
@source(IRC_S7403_A, relation = formalizes, coverage = exact, quote = "In any case where there has been a refusal or neglect to pay any tax, or to discharge any liability in respect thereof, whether or not levy has been made")
pub rule S7403GroundsRefusalOrNeglect strict {
    label en official "In any case where there has been a refusal or neglect to pay any tax, or to discharge any liability in respect thereof, whether or not levy has been made";
    for p: Person;
    for lien: Lien;
    when refusal_or_neglect_to_pay(p, lien);
    then lien_action_grounds(p, lien);
}
@source(IRC_S7403_A, relation = formalizes, coverage = exact, quote = "For purposes of the preceding sentence, any acceleration of payment under section 6166(g) shall be treated as a neglect to pay tax.")
pub rule S7403GroundsAccelerationUnder6166g strict {
    label en official "For purposes of the preceding sentence, any acceleration of payment under section 6166(g) shall be treated as a neglect to pay tax.";
    for p: Person;
    for lien: Lien;
    when installment_acceleration_under_6166g(p, lien);
    then lien_action_grounds(p, lien);
}
pub relation secretary_requests_lien_action(p: Person, lien: Lien) kind empirical {
    label en official "at the request of the Secretary";
}
pub relation lien_action_directed(pr: Proceeding, p: Person, lien: Lien) kind empirical {
    label en unofficial "the Attorney General or his delegate directs a civil action to be filed to enforce the lien of the United States, or to subject property of the delinquent to the payment of the tax or liability (§7403(a)'s own exercise fact)";
}
@source(IRC_S7403_A, relation = formalizes, coverage = exact, quote = "the Attorney General or his delegate, at the request of the Secretary, may direct a civil action to be filed in a district court of the United States to enforce the lien of the United States under this title with respect to such tax or liability or to subject any property, of whatever nature, of the delinquent, or in which he has any right, title, or interest, to the payment of such tax or liability")
pub rule S7403DirectLienEnforcementAction strict {
    label en official "the Attorney General or his delegate, at the request of the Secretary, may direct a civil action to be filed in a district court of the United States to enforce the lien of the United States under this title with respect to such tax or liability or to subject any property, of whatever nature, of the delinquent, or in which he has any right, title, or interest, to the payment of such tax or liability";
    for pr: Proceeding;
    for p: Person;
    for lien: Lien;
    when lien_action_grounds(p, lien)
        and secretary_requests_lien_action(p, lien)
        and lien_action_directed(pr, p, lien);
    then power S7403DirectLienEnforcementActionPower {
        holder us.irc.core::Secretary;
        over p;
        exercise lien_action_directed(pr, p, lien);
        valid_when lien_action_grounds(p, lien);
        effect lien_enforcement_action_filed(pr, p, lien);
    };
}
pub relation lien_enforcement_action_filed(pr: Proceeding, p: Person, lien: Lien) kind institutional {
    label en unofficial "the §7403(a) civil action has been validly directed and filed";
}

// --- (b) Parties ---------------------------------------------------------

pub relation has_lien_or_claims_interest(other: Person, lien: Lien) kind empirical {
    label en official "persons having liens upon or claiming any interest in the property involved in such action";
}
pub relation joined_as_party(other: Person, pr: Proceeding) kind institutional {
    label en unofficial "the person having a lien upon, or claiming an interest in, the property has been made a party to the §7403 action";
}
@source(IRC_S7403_B, relation = formalizes, coverage = exact, quote = "All persons having liens upon or claiming any interest in the property involved in such action shall be made parties thereto.")
pub rule S7403AllLienholdersMustBeJoined strict {
    label en official "All persons having liens upon or claiming any interest in the property involved in such action shall be made parties thereto.";
    for pr: Proceeding;
    for p: Person;
    for lien: Lien;
    for other: Person;
    when lien_enforcement_action_filed(pr, p, lien)
        and has_lien_or_claims_interest(other, lien);
    then duty S7403JoinAllLienholders {
        bearer us.irc.core::Secretary;
        beneficiary other;
        goal achievement {
            condition joined_as_party(other, pr);
            window [-infinity, infinity];
        }
    };
}

// --- (c) Adjudication and decree -----------------------------------------

pub relation us_claim_or_interest_established(pr: Proceeding, lien: Lien) kind institutional {
    label en unofficial "in all cases where a claim or interest of the United States in the property is established (§7403(c))";
}
pub relation court_decrees_sale(pr: Proceeding, lien: Lien) kind empirical {
    label en unofficial "the court's exercise of its §7403(c) power to decree a sale of the property";
}
@source(IRC_S7403_C, relation = formalizes, coverage = exact, quote = "The court shall, after the parties have been duly notified of the action, proceed to adjudicate all matters involved therein and finally determine the merits of all claims to and liens upon the property, and, in all cases where a claim or interest of the United States therein is established, may decree a sale of such property, by the proper officer of the court, and a distribution of the proceeds of such sale according to the findings of the court in respect to the interests of the parties and of the United States.")
pub rule S7403DecreeSalePowerRule strict {
    label en official "The court shall, after the parties have been duly notified of the action, proceed to adjudicate all matters involved therein and finally determine the merits of all claims to and liens upon the property, and, in all cases where a claim or interest of the United States therein is established, may decree a sale of such property, by the proper officer of the court, and a distribution of the proceeds of such sale according to the findings of the court in respect to the interests of the parties and of the United States.";
    for pr: Proceeding;
    for p: Person;
    for lien: Lien;
    when lien_enforcement_action_filed(pr, p, lien)
        and court_decrees_sale(pr, lien);
    then power S7403DecreeSalePower {
        holder us.irc.core::DistrictCourt;
        exercise court_decrees_sale(pr, lien);
        valid_when us_claim_or_interest_established(pr, lien);
        effect sale_decreed(pr, lien);
    };
}
pub relation sale_decreed(pr: Proceeding, lien: Lien) kind institutional {
    label en unofficial "a sale of the property, by the proper officer of the court, and a distribution of proceeds according to the findings of the court, has been decreed";
}

// --- (d) Receivership ------------------------------------------------------

pub relation receiver_requested_by_us(pr: Proceeding) kind empirical {
    label en official "at the instance of the United States";
}
pub relation secretary_certifies_public_interest_receivership(pr: Proceeding) kind empirical {
    label en official "certification by the Secretary during the pendency of such proceedings that it is in the public interest";
}
pub relation court_appoints_receiver(pr: Proceeding) kind empirical;
pub relation receivership_grounds(pr: Proceeding) kind institutional {
    label en unofficial "either the plain §7403(d) instance-of-the-United-States ground, or the Secretary's public-interest certification ground, for the court's power to appoint a receiver — a single atom per the one-atom rule";
}
@source(IRC_S7403_D, relation = formalizes, coverage = exact, quote = "In any such proceeding, at the instance of the United States, the court may appoint a receiver to enforce the lien")
pub rule S7403ReceivershipGroundsAtInstanceOfUs strict {
    label en official "In any such proceeding, at the instance of the United States, the court may appoint a receiver to enforce the lien";
    for pr: Proceeding;
    when receiver_requested_by_us(pr);
    then receivership_grounds(pr);
}
@source(IRC_S7403_D, relation = formalizes, coverage = exact, quote = "or, upon certification by the Secretary during the pendency of such proceedings that it is in the public interest, may appoint a receiver with all the powers of a receiver in equity")
pub rule S7403ReceivershipGroundsPublicInterest strict {
    label en official "or, upon certification by the Secretary during the pendency of such proceedings that it is in the public interest, may appoint a receiver with all the powers of a receiver in equity";
    for pr: Proceeding;
    when secretary_certifies_public_interest_receivership(pr);
    then receivership_grounds(pr);
}
@source(IRC_S7403_D, relation = formalizes, coverage = contextual, quote = "the court may appoint a receiver to enforce the lien")
pub rule S7403AppointReceiverPowerRule strict {
    label en official "the court may appoint a receiver to enforce the lien";
    for pr: Proceeding;
    when court_appoints_receiver(pr);
    then power S7403AppointReceiverPower {
        holder us.irc.core::DistrictCourt;
        exercise court_appoints_receiver(pr);
        valid_when receivership_grounds(pr);
        effect receiver_appointed(pr);
    };
}
pub relation receiver_appointed(pr: Proceeding) kind institutional;
