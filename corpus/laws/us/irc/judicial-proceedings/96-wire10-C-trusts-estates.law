// Judicial proceedings -- WIRE-10 group C, owner `trusts_estates` (26.09.2026, DECISION-0379, implemented_unverified; scenarios written,
// NOT executed; no legal review).
//
// Section 7491(a)(2)(C)/(D) burden-of-proof limits name "a qualified revocable trust (as defined in section 645(b)(1))". The placeholder
// `qualified_revocable_trust_645b1` (module 17) was case-asserted; the owner `us.irc.trusts_estates` (module 03, section 645) publishes the
// classification (`qualified_revocable_trust(trust, decedent)`: treated under section 676 as owned by the decedent by reason of a power to
// revoke). The definition has no decedent parameter in the consumer, so the placeholder is derived for the trust whatever the decedent is.
// The case-fact channel stays valid.

language "law.core" version "0.2";
package us.irc.judicial_proceedings version "0.1.1";
namespace "urn:us:irc:judicial_proceedings:clir";

import us.irc.trusts_estates version "0.1.1";

use self::{
    Person,
    qualified_revocable_trust_645b1,
};

rule W10CQualifiedRevocableTrustFromTrustsEstates strict {
    label en official "section 645(b)(1): a trust that the trusts-estates package records as treated under section 676 as owned by a decedent by reason of a power to revoke is a qualified revocable trust";
    for t: us.irc.core::Trust;
    for decedent: Person;
    when us.irc.trusts_estates::qualified_revocable_trust(t, decedent);
    then qualified_revocable_trust_645b1(t);
}
