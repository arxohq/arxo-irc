// Stage 2 — declaratory-judgment remedies of subchapter C: §7428
// (exempt-organization status), §7436 (employment status), §7476 (retirement
// plan qualification), §7477 (value of gifts), §7478 (tax-exempt bond
// interest), §7479 (§6166 estate-tax deferral); §7437 is a table of cross
// references.
//
// METHOD NOTE. The six remedies share ONE shape, so the model keeps one
// set of relations keyed by the `DeclaratoryRemedy` enum: an actual
// controversy about a determination (or a failure to determine); an
// eligible petitioner (b)(1); exhaustion of administrative remedies (b)(2)
// — the court's own determination is a DECISION-0194 judgment, and the
// statutory "deemed exhausted after N days" is a date computation; the
// 91st-day bar for a pleading after a certified or registered notice (b)(3);
// remedy-specific extra limits. The Tax Court's declaration is a POWER
// whose `valid_when` is the single atom "declaratory grounds"; the power's
// effect gives the declaration the force of a Tax Court decision. §7428
// alone also names the Court of Federal Claims and the district court for
// the District of Columbia, each its own power.
//
// JUDGMENT CALLS. "At the expiration of N days after the request" is read
// as: the pleading is filed on a date STRICTLY AFTER request + N days (the
// N-th day has then expired). §7476(b)(3)'s "shall not be deemed to have
// exhausted ... before the expiration of 270 days" is read as a defeater
// of exhaustion for a failure-to-determine controversy filed within the
// 270 days (INTERPRETATION: the alternative reading leaves the court's
// exhaustion finding unconstrained). §7476(b)(5) counts "before the
// ninety-first day after the day after such notice is mailed" as
// mailing + 91 days. §7436(c)'s "$50,000 or less for each calendar quarter"
// is an existence test over quarters (no quarter above $50,000).
// Analogical incorporation ("principles of section 6213 shall apply as if")
// of §7436(d)(1) and §7436(c)(3) is TECH-GAPS G2904.

language "law.core" version "0.2";
package us.irc.judicial_proceedings version "0.1.1";
namespace "urn:us:irc:judicial_proceedings:clir";

use self::{
    Asset,
    Claim,
    IRC_S7428_A,
    IRC_S7428_B,
    IRC_S7428_C,
    IRC_S7428_D,
    IRC_S7436_A,
    IRC_S7436_B,
    IRC_S7436_C,
    IRC_S7436_D,
    IRC_S7436_E,
    IRC_S7476_A,
    IRC_S7476_B,
    IRC_S7476_C,
    IRC_S7477_A,
    IRC_S7477_B,
    IRC_S7478_A,
    IRC_S7478_B,
    IRC_S7479_A,
    IRC_S7479_B,
    IRC_S7479_C,
    Person,
    Proceeding,
    TaxKind,
    decision_final_on,
};

pub enum DeclaratoryRemedy {
    Sec7428ExemptOrganization;
    Sec7436EmploymentStatus;
    Sec7476RetirementPlan;
    Sec7477GiftValue;
    Sec7478BondInterest;
    Sec7479EstateDeferral;
}

// ============================================================================
// Shared limitations: controversy, exhaustion, time
// ============================================================================

pub relation declaratory_controversy(pr: Proceeding, p: Person, remedy: DeclaratoryRemedy) kind empirical {
    label en unofficial "a case of actual controversy involving a determination by the Secretary (or a failure by the Secretary to make a determination) of the kind the remedy covers, on which the petitioner has filed an appropriate pleading";
}
pub relation declaratory_request_made_on(pr: Proceeding, p: Person, remedy: DeclaratoryRemedy, on: Date) kind empirical {
    label en unofficial "the date on which the request for the Secretary's determination was made";
}
pub relation declaratory_pleading_filed_on(pr: Proceeding, p: Person, remedy: DeclaratoryRemedy, on: Date) kind empirical;
pub relation declaratory_notice_mailed_on(pr: Proceeding, p: Person, remedy: DeclaratoryRemedy, on: Date) kind empirical {
    label en unofficial "the Secretary sends by certified or registered mail notice of the determination to the petitioner (date of mailing)";
}
external judgment relation declaratory_all_reasonable_steps_taken(pr: Proceeding, p: Person, remedy: DeclaratoryRemedy) {
    authority TaxCourt;
    label en official "the organization or petitioner has taken, in a timely manner, all reasonable steps to secure such determination";
}
external judgment relation declaratory_administrative_remedies_exhausted_found(pr: Proceeding, p: Person, remedy: DeclaratoryRemedy) {
    authority TaxCourt;
    label en official "the court determines that the petitioner has exhausted administrative remedies available to it within the Internal Revenue Service";
}
external judgment relation exhaustion_found_by_court_of_federal_claims_7428(pr: Proceeding, p: Person) {
    authority CourtOfFederalClaims;
    label en official "the Court of Federal Claims determines that the organization involved has exhausted administrative remedies available to it within the Internal Revenue Service";
}
external judgment relation exhaustion_found_by_district_court_dc_7428(pr: Proceeding, p: Person) {
    authority DistrictCourt;
    label en official "the district court of the United States for the District of Columbia determines that the organization involved has exhausted administrative remedies available to it within the Internal Revenue Service";
}
pub relation declaratory_exhaustion_satisfied(pr: Proceeding, p: Person, remedy: DeclaratoryRemedy) kind institutional {
    label en unofficial "administrative remedies are exhausted: by the court's determination or by the deemed-exhaustion rule of the remedy";
}
@source(IRC_S7476_B, relation = formalizes, coverage = exact, quote = "The Tax Court shall not issue a declaratory judgment or decree under this section in any proceeding unless it determines that the petitioner has exhausted administrative remedies available to him within the Internal Revenue Service.")
@source(IRC_S7478_B, relation = formalizes, coverage = exact, quote = "The court shall not issue a declaratory judgment or decree under this section in any proceeding unless it determines that the petitioner has exhausted all available administrative remedies within the Internal Revenue Service.")
@source(IRC_S7479_B, relation = formalizes, coverage = exact, quote = "The court shall not issue a declaratory judgment or decree under this section in any proceeding unless it determines that the petitioner has exhausted all available administrative remedies within the Internal Revenue Service.")
@source(IRC_S7428_B, relation = formalizes, coverage = partial, quote = "A declaratory judgment or decree under this section shall not be issued in any proceeding unless the Tax Court, the Court of Federal Claims, or the district court of the United States for the District of Columbia determines that the organization involved has exhausted administrative remedies available to it within the Internal Revenue Service.")
@source(IRC_S7477_B, relation = formalizes, coverage = partial, quote = "The court shall not issue a declaratory judgment or decree under this section in any proceeding unless it determines that the petitioner has exhausted all available administrative remedies within the Internal Revenue Service.")
pub rule DeclaratoryExhaustionFoundRule defeasible {
    label en official "The court shall not issue a declaratory judgment or decree under this section in any proceeding unless it determines that the petitioner has exhausted all available administrative remedies within the Internal Revenue Service.";
    for pr: Proceeding;
    for p: Person;
    for remedy: DeclaratoryRemedy;
    when declaratory_administrative_remedies_exhausted_found(pr, p, remedy);
    then declaratory_exhaustion_satisfied(pr, p, remedy);
    unless declaratory_failure_filed_within_270_days_7476(pr, p, remedy);
}
pub relation declaratory_failure_filed_within_270_days_7476(pr: Proceeding, p: Person, remedy: DeclaratoryRemedy) kind institutional {
    label en unofficial "a §7476 failure-to-determine controversy whose pleading is filed on or before the 270th day after the request: exhaustion cannot be established before the expiration of 270 days";
}
@source(IRC_S7476_B, relation = formalizes, coverage = partial, quote = "A petitioner shall not be deemed to have exhausted his administrative remedies with respect to a failure by the Secretary to make a determination with respect to initial qualification or continuing qualification of a retirement plan before the expiration of 270 days after the request for such determination was made.")
pub rule S7476b3No270DayEarlyExhaustion defeasible {
    label en official "A petitioner shall not be deemed to have exhausted his administrative remedies with respect to a failure by the Secretary to make a determination with respect to initial qualification or continuing qualification of a retirement plan before the expiration of 270 days after the request for such determination was made.";
    for pr: Proceeding;
    for p: Person;
    for requestedOn: Date;
    for filedOn: Date;
    when declaratory_controversy(pr, p, Sec7476RetirementPlan)
        and declaratory_request_made_on(pr, p, Sec7476RetirementPlan, requestedOn)
        and declaratory_pleading_filed_on(pr, p, Sec7476RetirementPlan, filedOn)
        and secretary_failed_to_determine(pr, p, Sec7476RetirementPlan)
        and filedOn <= add_calendar_period(requestedOn, 270 calendar_day);
    then declaratory_failure_filed_within_270_days_7476(pr, p, Sec7476RetirementPlan);
}
pub relation secretary_failed_to_determine(pr: Proceeding, p: Person, remedy: DeclaratoryRemedy) kind empirical {
    label en unofficial "the controversy is a failure by the Secretary to make a determination (rather than a determination)";
}
@source(IRC_S7428_B, relation = formalizes, coverage = exact, quote = "An organization requesting the determination of an issue referred to in subsection (a)(1) shall be deemed to have exhausted its administrative remedies with respect to a failure by the Secretary to make a determination with respect to such issue at the expiration of 270 days after the date on which the request for such determination was made if the organization has taken, in a timely manner, all reasonable steps to secure such determination.")
pub rule S7428b2Deemed270 defeasible {
    label en official "An organization requesting the determination of an issue referred to in subsection (a)(1) shall be deemed to have exhausted its administrative remedies with respect to a failure by the Secretary to make a determination with respect to such issue at the expiration of 270 days after the date on which the request for such determination was made if the organization has taken, in a timely manner, all reasonable steps to secure such determination.";
    for pr: Proceeding;
    for p: Person;
    for requestedOn: Date;
    for filedOn: Date;
    when secretary_failed_to_determine(pr, p, Sec7428ExemptOrganization)
        and declaratory_request_made_on(pr, p, Sec7428ExemptOrganization, requestedOn)
        and declaratory_pleading_filed_on(pr, p, Sec7428ExemptOrganization, filedOn)
        and declaratory_all_reasonable_steps_taken(pr, p, Sec7428ExemptOrganization)
        and filedOn > add_calendar_period(requestedOn, 270 calendar_day);
    then declaratory_exhaustion_satisfied(pr, p, Sec7428ExemptOrganization);
}
@source(IRC_S7428_B, relation = formalizes, coverage = exact, quote = "A declaratory judgment or decree under this section shall not be issued in any proceeding unless the Tax Court, the Court of Federal Claims, or the district court of the United States for the District of Columbia determines that the organization involved has exhausted administrative remedies available to it within the Internal Revenue Service.")
pub rule S7428b2CourtOfFederalClaimsFound defeasible {
    label en official "A declaratory judgment or decree under this section shall not be issued in any proceeding unless the Tax Court, the Court of Federal Claims, or the district court of the United States for the District of Columbia determines that the organization involved has exhausted administrative remedies available to it within the Internal Revenue Service.";
    for pr: Proceeding;
    for p: Person;
    when exhaustion_found_by_court_of_federal_claims_7428(pr, p);
    then declaratory_exhaustion_satisfied(pr, p, Sec7428ExemptOrganization);
}
@source(IRC_S7428_B, relation = formalizes, coverage = exact, quote = "A declaratory judgment or decree under this section shall not be issued in any proceeding unless the Tax Court, the Court of Federal Claims, or the district court of the United States for the District of Columbia determines that the organization involved has exhausted administrative remedies available to it within the Internal Revenue Service.")
pub rule S7428b2DistrictCourtDcFound defeasible {
    label en official "A declaratory judgment or decree under this section shall not be issued in any proceeding unless the Tax Court, the Court of Federal Claims, or the district court of the United States for the District of Columbia determines that the organization involved has exhausted administrative remedies available to it within the Internal Revenue Service.";
    for pr: Proceeding;
    for p: Person;
    when exhaustion_found_by_district_court_dc_7428(pr, p);
    then declaratory_exhaustion_satisfied(pr, p, Sec7428ExemptOrganization);
}
@source(IRC_S7478_B, relation = formalizes, coverage = exact, quote = "A petitioner shall be deemed to have exhausted its administrative remedies with respect to a failure of the Secretary to make a determination with respect to an issue of obligations at the expiration of 180 days after the date on which the request for such determination was made if the petitioner has taken, in a timely manner, all reasonable steps to secure such determination.")
pub rule S7478b2Deemed180 defeasible {
    label en official "A petitioner shall be deemed to have exhausted its administrative remedies with respect to a failure of the Secretary to make a determination with respect to an issue of obligations at the expiration of 180 days after the date on which the request for such determination was made if the petitioner has taken, in a timely manner, all reasonable steps to secure such determination.";
    for pr: Proceeding;
    for p: Person;
    for requestedOn: Date;
    for filedOn: Date;
    when secretary_failed_to_determine(pr, p, Sec7478BondInterest)
        and declaratory_request_made_on(pr, p, Sec7478BondInterest, requestedOn)
        and declaratory_pleading_filed_on(pr, p, Sec7478BondInterest, filedOn)
        and declaratory_all_reasonable_steps_taken(pr, p, Sec7478BondInterest)
        and filedOn > add_calendar_period(requestedOn, 180 calendar_day);
    then declaratory_exhaustion_satisfied(pr, p, Sec7478BondInterest);
}
@source(IRC_S7479_B, relation = formalizes, coverage = exact, quote = "A petitioner shall be deemed to have exhausted its administrative remedies with respect to a failure of the Secretary to make a determination at the expiration of 180 days after the date on which the request for such determination was made if the petitioner has taken, in a timely manner, all reasonable steps to secure such determination.")
pub rule S7479b2Deemed180 defeasible {
    label en official "A petitioner shall be deemed to have exhausted its administrative remedies with respect to a failure of the Secretary to make a determination at the expiration of 180 days after the date on which the request for such determination was made if the petitioner has taken, in a timely manner, all reasonable steps to secure such determination.";
    for pr: Proceeding;
    for p: Person;
    for requestedOn: Date;
    for filedOn: Date;
    when secretary_failed_to_determine(pr, p, Sec7479EstateDeferral)
        and declaratory_request_made_on(pr, p, Sec7479EstateDeferral, requestedOn)
        and declaratory_pleading_filed_on(pr, p, Sec7479EstateDeferral, filedOn)
        and declaratory_all_reasonable_steps_taken(pr, p, Sec7479EstateDeferral)
        and filedOn > add_calendar_period(requestedOn, 180 calendar_day);
    then declaratory_exhaustion_satisfied(pr, p, Sec7479EstateDeferral);
}
pub relation declaratory_pleading_timely(pr: Proceeding, p: Person, remedy: DeclaratoryRemedy) kind institutional {
    label en unofficial "the pleading is not barred by the 91st-day rule: either no certified or registered notice of determination was mailed, or the pleading is filed before the 91st day after the mailing";
}
@source(IRC_S7428_B, relation = formalizes, coverage = exact, quote = "no proceeding may be initiated under this section by such organization unless the pleading is filed before the 91st day after the date of such mailing.")
@source(IRC_S7478_B, relation = formalizes, coverage = exact, quote = "no proceeding may be initiated under this section unless the pleading is filed before the 91st day after the date of such mailing.")
@source(IRC_S7479_B, relation = formalizes, coverage = exact, quote = "no proceeding may be initiated under this section unless the pleading is filed before the 91st day after the date of such mailing.")
@source(IRC_S7436_B, relation = formalizes, coverage = exact, quote = "no proceeding may be initiated under this section with respect to such determination unless the pleading is filed before the 91st day after the date of such mailing.")
@source(IRC_S7477_B, relation = formalizes, coverage = exact, quote = "If the Secretary sends by certified or registered mail notice of his determination as described in subsection (a) to the petitioner, no proceeding may be initiated under this section unless the pleading is filed before the 91st day after the date of such mailing.")
pub rule S7477b3PleadingWithin90Days defeasible {
    label en official "If the Secretary sends by certified or registered mail notice of his determination as described in subsection (a) to the petitioner, no proceeding may be initiated under this section unless the pleading is filed before the 91st day after the date of such mailing.";
    for pr: Proceeding;
    for p: Person;
    for remedy: DeclaratoryRemedy;
    for mailedOn: Date;
    for filedOn: Date;
    when declaratory_notice_mailed_on(pr, p, remedy, mailedOn)
        and declaratory_pleading_filed_on(pr, p, remedy, filedOn)
        and remedy != Sec7476RetirementPlan
        and filedOn <= add_calendar_period(mailedOn, 90 calendar_day);
    then declaratory_pleading_timely(pr, p, remedy);
}
@source(IRC_S7476_B, relation = formalizes, coverage = exact, quote = "no proceeding may be initiated under this section by any person unless the pleading is filed before the ninety-first day after the day after such notice is mailed to such person (or to his designated representative, in the case of an employee).")
pub rule S7476b5PleadingWithin91DaysAfterNextDay defeasible {
    label en official "no proceeding may be initiated under this section by any person unless the pleading is filed before the ninety-first day after the day after such notice is mailed to such person (or to his designated representative, in the case of an employee).";
    for pr: Proceeding;
    for p: Person;
    for mailedOn: Date;
    for filedOn: Date;
    when declaratory_notice_mailed_on(pr, p, Sec7476RetirementPlan, mailedOn)
        and declaratory_pleading_filed_on(pr, p, Sec7476RetirementPlan, filedOn)
        and filedOn <= add_calendar_period(mailedOn, 91 calendar_day);
    then declaratory_pleading_timely(pr, p, Sec7476RetirementPlan);
}
@source(IRC_S7428_B, relation = formalizes, coverage = partial, quote = "If the Secretary sends by certified or registered mail notice of his determination with respect to an issue referred to in subsection (a)(1) to the organization referred to in paragraph (1)")
@source(IRC_S7478_B, relation = formalizes, coverage = partial, quote = "If the Secretary sends by certified or registered mail notice of his determination as described in subsection (a)(1) to the petitioner")
@source(IRC_S7479_B, relation = formalizes, coverage = partial, quote = "If the Secretary sends by certified or registered mail notice of his determination as described in subsection (a) to the petitioner")
@source(IRC_S7436_B, relation = formalizes, coverage = partial, quote = "If the Secretary sends by certified or registered mail notice to the petitioner of a determination by the Secretary described in subsection (a)")
@source(IRC_S7477_B, relation = formalizes, coverage = exact, quote = "If the Secretary sends by certified or registered mail notice of his determination as described in subsection (a) to the petitioner, no proceeding may be initiated under this section unless the pleading is filed before the 91st day after the date of such mailing.")
pub rule S7477b3NoNoticeNoBar defeasible {
    label en official "If the Secretary sends by certified or registered mail notice of his determination as described in subsection (a) to the petitioner, no proceeding may be initiated under this section unless the pleading is filed before the 91st day after the date of such mailing.";
    for pr: Proceeding;
    for p: Person;
    for remedy: DeclaratoryRemedy;
    when declaratory_controversy(pr, p, remedy)
        and not_known(declaratory_any_notice_mailed(pr, p, remedy));
    then declaratory_pleading_timely(pr, p, remedy);
}
pub relation declaratory_any_notice_mailed(pr: Proceeding, p: Person, remedy: DeclaratoryRemedy) kind institutional;
rule S7477b3NoticeMailedBridge strict {
    for pr: Proceeding;
    for p: Person;
    for remedy: DeclaratoryRemedy;
    for mailedOn: Date;
    when declaratory_notice_mailed_on(pr, p, remedy, mailedOn);
    then declaratory_any_notice_mailed(pr, p, remedy);
}

// ============================================================================
// Petitioner eligibility (b)(1) of each remedy
// ============================================================================

pub relation declaratory_petitioner_eligible(pr: Proceeding, p: Person, remedy: DeclaratoryRemedy) kind institutional;
pub relation petitioner_is_organization_at_issue(pr: Proceeding, p: Person) kind empirical {
    label en official "the organization the qualification or classification of which is at issue";
}
@source(IRC_S7428_B, relation = formalizes, coverage = exact, quote = "A pleading may be filed under this section only by the organization the qualification or classification of which is at issue.")
pub rule S7428b1PetitionerOrganization strict {
    label en official "A pleading may be filed under this section only by the organization the qualification or classification of which is at issue.";
    for pr: Proceeding;
    for p: Person;
    when petitioner_is_organization_at_issue(pr, p);
    then declaratory_petitioner_eligible(pr, p, Sec7428ExemptOrganization);
}
pub relation petitioner_is_person_for_whom_services_performed(pr: Proceeding, p: Person) kind empirical {
    label en official "the person for whom the services are performed";
}
@source(IRC_S7436_B, relation = formalizes, coverage = exact, quote = "A pleading may be filed under this section only by the person for whom the services are performed.")
pub rule S7436b1PetitionerServiceRecipient strict {
    label en official "A pleading may be filed under this section only by the person for whom the services are performed.";
    for pr: Proceeding;
    for p: Person;
    when petitioner_is_person_for_whom_services_performed(pr, p);
    then declaratory_petitioner_eligible(pr, p, Sec7436EmploymentStatus);
}
pub relation petitioner_is_employer_of_plan(pr: Proceeding, p: Person) kind empirical {
    label en official "the employer";
}
pub relation petitioner_is_plan_administrator(pr: Proceeding, p: Person) kind empirical {
    label en official "the plan administrator";
}
pub relation petitioner_is_qualified_interested_employee(pr: Proceeding, p: Person) kind empirical {
    label en official "an employee who has qualified under regulations prescribed by the Secretary as an interested party for purposes of pursuing administrative remedies within the Internal Revenue Service";
}
pub relation petitioner_is_pbgc(pr: Proceeding, p: Person) kind empirical {
    label en official "the Pension Benefit Guaranty Corporation";
}
@source(IRC_S7476_B, relation = formalizes, coverage = exact, quote = "A pleading may be filed under this section only by a petitioner who is the employer, the plan administrator, an employee who has qualified under regulations prescribed by the Secretary as an interested party for purposes of pursuing administrative remedies within the Internal Revenue Service, or the Pension Benefit Guaranty Corporation.")
pub rule S7476b1Employer strict {
    label en official "A pleading may be filed under this section only by a petitioner who is the employer, the plan administrator, an employee who has qualified under regulations prescribed by the Secretary as an interested party for purposes of pursuing administrative remedies within the Internal Revenue Service, or the Pension Benefit Guaranty Corporation.";
    for pr: Proceeding;
    for p: Person;
    when petitioner_is_employer_of_plan(pr, p);
    then declaratory_petitioner_eligible(pr, p, Sec7476RetirementPlan);
}
@source(IRC_S7476_B, relation = formalizes, coverage = exact, quote = "A pleading may be filed under this section only by a petitioner who is the employer, the plan administrator, an employee who has qualified under regulations prescribed by the Secretary as an interested party for purposes of pursuing administrative remedies within the Internal Revenue Service, or the Pension Benefit Guaranty Corporation.")
pub rule S7476b1Administrator strict {
    label en official "A pleading may be filed under this section only by a petitioner who is the employer, the plan administrator, an employee who has qualified under regulations prescribed by the Secretary as an interested party for purposes of pursuing administrative remedies within the Internal Revenue Service, or the Pension Benefit Guaranty Corporation.";
    for pr: Proceeding;
    for p: Person;
    when petitioner_is_plan_administrator(pr, p);
    then declaratory_petitioner_eligible(pr, p, Sec7476RetirementPlan);
}
@source(IRC_S7476_B, relation = formalizes, coverage = exact, quote = "A pleading may be filed under this section only by a petitioner who is the employer, the plan administrator, an employee who has qualified under regulations prescribed by the Secretary as an interested party for purposes of pursuing administrative remedies within the Internal Revenue Service, or the Pension Benefit Guaranty Corporation.")
pub rule S7476b1InterestedEmployee strict {
    label en official "A pleading may be filed under this section only by a petitioner who is the employer, the plan administrator, an employee who has qualified under regulations prescribed by the Secretary as an interested party for purposes of pursuing administrative remedies within the Internal Revenue Service, or the Pension Benefit Guaranty Corporation.";
    for pr: Proceeding;
    for p: Person;
    when petitioner_is_qualified_interested_employee(pr, p);
    then declaratory_petitioner_eligible(pr, p, Sec7476RetirementPlan);
}
@source(IRC_S7476_B, relation = formalizes, coverage = exact, quote = "A pleading may be filed under this section only by a petitioner who is the employer, the plan administrator, an employee who has qualified under regulations prescribed by the Secretary as an interested party for purposes of pursuing administrative remedies within the Internal Revenue Service, or the Pension Benefit Guaranty Corporation.")
pub rule S7476b1Pbgc strict {
    label en official "A pleading may be filed under this section only by a petitioner who is the employer, the plan administrator, an employee who has qualified under regulations prescribed by the Secretary as an interested party for purposes of pursuing administrative remedies within the Internal Revenue Service, or the Pension Benefit Guaranty Corporation.";
    for pr: Proceeding;
    for p: Person;
    when petitioner_is_pbgc(pr, p);
    then declaratory_petitioner_eligible(pr, p, Sec7476RetirementPlan);
}
pub relation petitioner_is_donor(pr: Proceeding, p: Person) kind empirical {
    label en official "the donor";
}
@source(IRC_S7477_B, relation = formalizes, coverage = exact, quote = "A pleading may be filed under this section only by the donor.")
pub rule S7477b1PetitionerDonor strict {
    label en official "A pleading may be filed under this section only by the donor.";
    for pr: Proceeding;
    for p: Person;
    when petitioner_is_donor(pr, p);
    then declaratory_petitioner_eligible(pr, p, Sec7477GiftValue);
}
pub relation petitioner_is_prospective_issuer(pr: Proceeding, p: Person) kind empirical {
    label en official "the prospective issuer";
}
@source(IRC_S7478_B, relation = formalizes, coverage = exact, quote = "A pleading may be filed under this section only by the prospective issuer.")
pub rule S7478b1PetitionerIssuer strict {
    label en official "A pleading may be filed under this section only by the prospective issuer.";
    for pr: Proceeding;
    for p: Person;
    when petitioner_is_prospective_issuer(pr, p);
    then declaratory_petitioner_eligible(pr, p, Sec7478BondInterest);
}
pub relation petitioner_is_executor(pr: Proceeding, p: Person) kind empirical {
    label en official "the executor of such estate";
}
pub relation petitioner_assumed_6166_obligation_and_others_joined(pr: Proceeding, p: Person) kind empirical {
    label en official "any person who has assumed an obligation to make payments under section 6166 with respect to such estate (but only if each other such person is joined as a party)";
}
@source(IRC_S7479_B, relation = formalizes, coverage = exact, quote = "(A) by the executor of such estate, or")
pub rule S7479b1Executor strict {
    label en official "(A) by the executor of such estate, or";
    for pr: Proceeding;
    for p: Person;
    when petitioner_is_executor(pr, p);
    then declaratory_petitioner_eligible(pr, p, Sec7479EstateDeferral);
}
@source(IRC_S7479_B, relation = formalizes, coverage = exact, quote = "(B) by any person who has assumed an obligation to make payments under section 6166 with respect to such estate (but only if each other such person is joined as a party).")
pub rule S7479b1AssumedObligation strict {
    label en official "(B) by any person who has assumed an obligation to make payments under section 6166 with respect to such estate (but only if each other such person is joined as a party).";
    for pr: Proceeding;
    for p: Person;
    when petitioner_assumed_6166_obligation_and_others_joined(pr, p);
    then declaratory_petitioner_eligible(pr, p, Sec7479EstateDeferral);
}

// ============================================================================
// Remedy-specific extra limits
// ============================================================================

pub relation failure_concerns_initial_qualification_7476(pr: Proceeding) kind empirical {
    label en official "a failure by the Secretary to make a determination with respect to such initial qualification";
}
pub relation failure_concerns_continuing_qualification_from_amendment_or_termination_7476(pr: Proceeding) kind empirical {
    label en official "such continuing qualification if the controversy arises from a plan amendment or plan termination";
}
pub relation failure_category_within_7476a2(pr: Proceeding) kind institutional;
@source(IRC_S7476_A, relation = formalizes, coverage = exact, quote = "(A) such initial qualification, or")
pub rule S7476a2AInitialQualification strict {
    label en official "(A) such initial qualification, or";
    for pr: Proceeding;
    when failure_concerns_initial_qualification_7476(pr);
    then failure_category_within_7476a2(pr);
}
@source(IRC_S7476_A, relation = formalizes, coverage = exact, quote = "(B) such continuing qualification if the controversy arises from a plan amendment or plan termination,")
pub rule S7476a2BContinuingFromAmendmentOrTermination strict {
    label en official "(B) such continuing qualification if the controversy arises from a plan amendment or plan termination,";
    for pr: Proceeding;
    when failure_concerns_continuing_qualification_from_amendment_or_termination_7476(pr);
    then failure_category_within_7476a2(pr);
}
pub relation declaratory_extra_limits_met(pr: Proceeding, p: Person, remedy: DeclaratoryRemedy) kind institutional {
    label en unofficial "the limits particular to the remedy are met (§7428(b)(4) revocation bar, §7476(b)(2) and (b)(4), or no particular limit)";
}
pub relation revocation_of_status_described_in_6033j1(pr: Proceeding, p: Person) kind empirical {
    label en official "any revocation of status described in section 6033(j)(1)";
}
@source(IRC_S7428_B, relation = formalizes, coverage = exact, quote = "No action may be brought under this section with respect to any revocation of status described in section 6033(j)(1).")
pub rule S7428b4NoActionForAutomaticRevocation defeasible {
    label en official "No action may be brought under this section with respect to any revocation of status described in section 6033(j)(1).";
    for pr: Proceeding;
    for p: Person;
    when declaratory_controversy(pr, p, Sec7428ExemptOrganization)
        and not_known(revocation_of_status_described_in_6033j1(pr, p));
    then declaratory_extra_limits_met(pr, p, Sec7428ExemptOrganization);
}
external judgment relation petitioner_complied_with_notice_regulations(pr: Proceeding, p: Person) {
    authority TaxCourt;
    label en official "the petitioner establishes to the satisfaction of the court that he has complied with the requirements prescribed by regulations of the Secretary with respect to notice to other interested parties of the filing of the request for a determination";
}
pub relation plan_put_into_effect_before_pleading(pr: Proceeding) kind empirical {
    label en official "the plan (and, in the case of a controversy involving the continuing qualification of the plan because of an amendment to the plan, the amendment) with respect to which a decision of the Tax Court is sought has been put into effect before the filing of the pleading";
}
pub relation plan_in_effect_apart_from_refund_clause(pr: Proceeding) kind empirical {
    label en official "under the plan the funds contributed to the plan may be refunded if the plan (or the plan as so amended) is found to be not qualified";
}
pub relation plan_treated_as_in_effect(pr: Proceeding) kind institutional;
@source(IRC_S7476_B, relation = formalizes, coverage = exact, quote = "No proceeding may be maintained under this section unless the plan (and, in the case of a controversy involving the continuing qualification of the plan because of an amendment to the plan, the amendment) with respect to which a decision of the Tax Court is sought has been put into effect before the filing of the pleading.")
pub rule S7476b4PlanPutIntoEffect strict {
    label en official "No proceeding may be maintained under this section unless the plan (and, in the case of a controversy involving the continuing qualification of the plan because of an amendment to the plan, the amendment) with respect to which a decision of the Tax Court is sought has been put into effect before the filing of the pleading.";
    for pr: Proceeding;
    when plan_put_into_effect_before_pleading(pr);
    then plan_treated_as_in_effect(pr);
}
@source(IRC_S7476_B, relation = formalizes, coverage = exact, quote = "A plan or amendment shall not be treated as not being in effect merely because under the plan the funds contributed to the plan may be refunded if the plan (or the plan as so amended) is found to be not qualified.")
pub rule S7476b4RefundClauseDoesNotDefeat strict {
    label en official "A plan or amendment shall not be treated as not being in effect merely because under the plan the funds contributed to the plan may be refunded if the plan (or the plan as so amended) is found to be not qualified.";
    for pr: Proceeding;
    when plan_in_effect_apart_from_refund_clause(pr);
    then plan_treated_as_in_effect(pr);
}
@source(IRC_S7476_B, relation = formalizes, coverage = exact, quote = "For purposes of this section, the filing of a pleading by any petitioner may be held by the Tax Court to be premature, unless the petitioner establishes to the satisfaction of the court that he has complied with the requirements prescribed by regulations of the Secretary with respect to notice to other interested parties of the filing of the request for a determination referred to in subsection (a).")
pub rule S7476b2NoticeAndPlanInEffect defeasible {
    label en official "For purposes of this section, the filing of a pleading by any petitioner may be held by the Tax Court to be premature, unless the petitioner establishes to the satisfaction of the court that he has complied with the requirements prescribed by regulations of the Secretary with respect to notice to other interested parties of the filing of the request for a determination referred to in subsection (a).";
    for pr: Proceeding;
    for p: Person;
    when declaratory_controversy(pr, p, Sec7476RetirementPlan)
        and petitioner_complied_with_notice_regulations(pr, p)
        and plan_treated_as_in_effect(pr);
    then declaratory_extra_limits_met(pr, p, Sec7476RetirementPlan);
    unless secretary_failed_to_determine(pr, p, Sec7476RetirementPlan)
        and not_known(failure_category_within_7476a2(pr))
        and declaratory_controversy(pr, p, Sec7476RetirementPlan);
}
@source(IRC_S7477_B, relation = formalizes, coverage = partial, quote = "A pleading may be filed under this section only by the donor.")
pub rule S7477NoExtraLimit strict {
    label en official "A pleading may be filed under this section only by the donor.";
    for pr: Proceeding;
    for p: Person;
    when declaratory_controversy(pr, p, Sec7477GiftValue);
    then declaratory_extra_limits_met(pr, p, Sec7477GiftValue);
}
@source(IRC_S7478_B, relation = formalizes, coverage = partial, quote = "A pleading may be filed under this section only by the prospective issuer.")
pub rule S7478NoExtraLimit strict {
    label en official "A pleading may be filed under this section only by the prospective issuer.";
    for pr: Proceeding;
    for p: Person;
    when declaratory_controversy(pr, p, Sec7478BondInterest);
    then declaratory_extra_limits_met(pr, p, Sec7478BondInterest);
}
@source(IRC_S7479_B, relation = formalizes, coverage = partial, quote = "A pleading may be filed under this section, with respect to any estate, only—")
pub rule S7479NoExtraLimit strict {
    label en official "A pleading may be filed under this section, with respect to any estate, only—";
    for pr: Proceeding;
    for p: Person;
    when declaratory_controversy(pr, p, Sec7479EstateDeferral);
    then declaratory_extra_limits_met(pr, p, Sec7479EstateDeferral);
}
@source(IRC_S7436_B, relation = formalizes, coverage = partial, quote = "A pleading may be filed under this section only by the person for whom the services are performed.")
pub rule S7436NoExtraLimit strict {
    label en official "A pleading may be filed under this section only by the person for whom the services are performed.";
    for pr: Proceeding;
    for p: Person;
    when declaratory_controversy(pr, p, Sec7436EmploymentStatus);
    then declaratory_extra_limits_met(pr, p, Sec7436EmploymentStatus);
}

// ============================================================================
// Grounds and the courts' declarations
// ============================================================================

pub relation declaratory_grounds(pr: Proceeding, p: Person, remedy: DeclaratoryRemedy) kind institutional {
    label en unofficial "single atom folding the controversy, the eligible petitioner, exhaustion, the 91st-day bar and the remedy-specific limits for use in the court's power valid_when";
}
@source(IRC_S7476_A, relation = formalizes, coverage = exact, quote = "In a case of actual controversy involving—")
@source(IRC_S7477_A, relation = formalizes, coverage = exact, quote = "In a case of an actual controversy involving a determination by the Secretary of the value of any gift")
@source(IRC_S7478_A, relation = formalizes, coverage = exact, quote = "In a case of actual controversy involving—")
@source(IRC_S7479_A, relation = formalizes, coverage = exact, quote = "In a case of actual controversy involving a determination by the Secretary of (or a failure by the Secretary to make a determination with respect to)—")
@source(IRC_S7436_A, relation = formalizes, coverage = exact, quote = "If, in connection with an audit of any person, there is an actual controversy involving a determination by the Secretary as part of an examination that—")
@source(IRC_S7428_A, relation = formalizes, coverage = exact, quote = "In a case of actual controversy involving—")
pub rule DeclaratoryGroundsRule defeasible {
    label en official "In a case of actual controversy involving—";
    for pr: Proceeding;
    for p: Person;
    for remedy: DeclaratoryRemedy;
    when declaratory_controversy(pr, p, remedy)
        and declaratory_petitioner_eligible(pr, p, remedy)
        and declaratory_exhaustion_satisfied(pr, p, remedy)
        and declaratory_pleading_timely(pr, p, remedy)
        and declaratory_extra_limits_met(pr, p, remedy);
    then declaratory_grounds(pr, p, remedy);
}
pub relation court_makes_declaration(pr: Proceeding, p: Person, remedy: DeclaratoryRemedy) kind empirical;
pub relation declaration_made(pr: Proceeding, p: Person, remedy: DeclaratoryRemedy) kind institutional {
    label en unofficial "the court has made the declaration; it has the force and effect of a decision of the Tax Court (or a final judgment or decree of the district court or the Court of Federal Claims) and is reviewable as such";
}
@source(IRC_S7428_A, relation = formalizes, coverage = exact, quote = "upon the filing of an appropriate pleading, the United States Tax Court, the United States Court of Federal Claims, or the district court of the United States for the District of Columbia may make a declaration with respect to such initial qualification or continuing qualification or with respect to such initial classification or continuing classification.")
pub rule S7428aTaxCourtDeclarationPowerRule defeasible {
    label en official "upon the filing of an appropriate pleading, the United States Tax Court, the United States Court of Federal Claims, or the district court of the United States for the District of Columbia may make a declaration with respect to such initial qualification or continuing qualification or with respect to such initial classification or continuing classification.";
    for pr: Proceeding;
    for p: Person;
    when court_makes_declaration(pr, p, Sec7428ExemptOrganization);
    then power S7428aTaxCourtDeclaration {
        holder us.irc.core::TaxCourt;
        over p;
        exercise court_makes_declaration(pr, p, Sec7428ExemptOrganization);
        valid_when declaratory_grounds(pr, p, Sec7428ExemptOrganization);
        effect declaration_made(pr, p, Sec7428ExemptOrganization);
    };
}
@source(IRC_S7428_A, relation = formalizes, coverage = exact, quote = "upon the filing of an appropriate pleading, the United States Tax Court, the United States Court of Federal Claims, or the district court of the United States for the District of Columbia may make a declaration with respect to such initial qualification or continuing qualification or with respect to such initial classification or continuing classification.")
pub rule S7428aCourtOfFederalClaimsDeclarationPowerRule defeasible {
    label en official "upon the filing of an appropriate pleading, the United States Tax Court, the United States Court of Federal Claims, or the district court of the United States for the District of Columbia may make a declaration with respect to such initial qualification or continuing qualification or with respect to such initial classification or continuing classification.";
    for pr: Proceeding;
    for p: Person;
    when court_makes_declaration(pr, p, Sec7428ExemptOrganization);
    then power S7428aCourtOfFederalClaimsDeclaration {
        holder us.irc.core::CourtOfFederalClaims;
        over p;
        exercise court_makes_declaration(pr, p, Sec7428ExemptOrganization);
        valid_when declaratory_grounds(pr, p, Sec7428ExemptOrganization);
        effect declaration_made(pr, p, Sec7428ExemptOrganization);
    };
}
@source(IRC_S7428_A, relation = formalizes, coverage = exact, quote = "upon the filing of an appropriate pleading, the United States Tax Court, the United States Court of Federal Claims, or the district court of the United States for the District of Columbia may make a declaration with respect to such initial qualification or continuing qualification or with respect to such initial classification or continuing classification.")
pub rule S7428aDistrictCourtDcDeclarationPowerRule defeasible {
    label en official "upon the filing of an appropriate pleading, the United States Tax Court, the United States Court of Federal Claims, or the district court of the United States for the District of Columbia may make a declaration with respect to such initial qualification or continuing qualification or with respect to such initial classification or continuing classification.";
    for pr: Proceeding;
    for p: Person;
    when court_makes_declaration(pr, p, Sec7428ExemptOrganization);
    then power S7428aDistrictCourtDcDeclaration {
        holder us.irc.core::DistrictCourt;
        over p;
        exercise court_makes_declaration(pr, p, Sec7428ExemptOrganization);
        valid_when declaratory_grounds(pr, p, Sec7428ExemptOrganization);
        effect declaration_made(pr, p, Sec7428ExemptOrganization);
    };
}
@source(IRC_S7476_A, relation = formalizes, coverage = exact, quote = "upon the filing of an appropriate pleading, the Tax Court may make a declaration with respect to such initial qualification or continuing qualification.")
pub rule S7476aDeclarationPowerRule defeasible {
    label en official "upon the filing of an appropriate pleading, the Tax Court may make a declaration with respect to such initial qualification or continuing qualification.";
    for pr: Proceeding;
    for p: Person;
    when court_makes_declaration(pr, p, Sec7476RetirementPlan);
    then power S7476aTaxCourtDeclaration {
        holder us.irc.core::TaxCourt;
        over p;
        exercise court_makes_declaration(pr, p, Sec7476RetirementPlan);
        valid_when declaratory_grounds(pr, p, Sec7476RetirementPlan);
        effect declaration_made(pr, p, Sec7476RetirementPlan);
    };
}
@source(IRC_S7477_A, relation = formalizes, coverage = exact, quote = "upon the filing of an appropriate pleading, the Tax Court may make a declaration of the value of such gift.")
pub rule S7477aDeclarationPowerRule defeasible {
    label en official "upon the filing of an appropriate pleading, the Tax Court may make a declaration of the value of such gift.";
    for pr: Proceeding;
    for p: Person;
    when court_makes_declaration(pr, p, Sec7477GiftValue);
    then power S7477aTaxCourtDeclaration {
        holder us.irc.core::TaxCourt;
        over p;
        exercise court_makes_declaration(pr, p, Sec7477GiftValue);
        valid_when declaratory_grounds(pr, p, Sec7477GiftValue);
        effect declaration_made(pr, p, Sec7477GiftValue);
    };
}
@source(IRC_S7478_A, relation = formalizes, coverage = exact, quote = "upon the filing of an appropriate pleading, the Tax Court may make a declaration whether interest on such prospective obligations will be excludable from gross income under section 103(a).")
pub rule S7478aDeclarationPowerRule defeasible {
    label en official "upon the filing of an appropriate pleading, the Tax Court may make a declaration whether interest on such prospective obligations will be excludable from gross income under section 103(a).";
    for pr: Proceeding;
    for p: Person;
    when court_makes_declaration(pr, p, Sec7478BondInterest);
    then power S7478aTaxCourtDeclaration {
        holder us.irc.core::TaxCourt;
        over p;
        exercise court_makes_declaration(pr, p, Sec7478BondInterest);
        valid_when declaratory_grounds(pr, p, Sec7478BondInterest);
        effect declaration_made(pr, p, Sec7478BondInterest);
    };
}
@source(IRC_S7479_A, relation = formalizes, coverage = exact, quote = "upon the filing of an appropriate pleading, the Tax Court may make a declaration with respect to whether such election may be made or whether such extension has ceased to apply.")
pub rule S7479aDeclarationPowerRule defeasible {
    label en official "upon the filing of an appropriate pleading, the Tax Court may make a declaration with respect to whether such election may be made or whether such extension has ceased to apply.";
    for pr: Proceeding;
    for p: Person;
    when court_makes_declaration(pr, p, Sec7479EstateDeferral);
    then power S7479aTaxCourtDeclaration {
        holder us.irc.core::TaxCourt;
        over p;
        exercise court_makes_declaration(pr, p, Sec7479EstateDeferral);
        valid_when declaratory_grounds(pr, p, Sec7479EstateDeferral);
        effect declaration_made(pr, p, Sec7479EstateDeferral);
    };
}
@source(IRC_S7436_A, relation = formalizes, coverage = exact, quote = "upon the filing of an appropriate pleading, the Tax Court may determine whether such a determination by the Secretary is correct and the proper amount of employment tax under such determination.")
pub rule S7436aDeterminationPowerRule defeasible {
    label en official "upon the filing of an appropriate pleading, the Tax Court may determine whether such a determination by the Secretary is correct and the proper amount of employment tax under such determination.";
    for pr: Proceeding;
    for p: Person;
    when court_makes_declaration(pr, p, Sec7436EmploymentStatus);
    then power S7436aTaxCourtDetermination {
        holder us.irc.core::TaxCourt;
        over p;
        exercise court_makes_declaration(pr, p, Sec7436EmploymentStatus);
        valid_when declaratory_grounds(pr, p, Sec7436EmploymentStatus);
        effect declaration_made(pr, p, Sec7436EmploymentStatus);
    };
}
pub relation declaration_reviewable_as_decision(pr: Proceeding, p: Person, remedy: DeclaratoryRemedy) kind institutional;
@source(IRC_S7428_A, relation = formalizes, coverage = exact, quote = "Any such declaration shall have the force and effect of a decision of the Tax Court or a final judgment or decree of the district court or the Court of Federal Claims, as the case may be, and shall be reviewable as such.")
@source(IRC_S7476_A, relation = formalizes, coverage = exact, quote = "Any such declaration shall have the force and effect of a decision of the Tax Court and shall be reviewable as such.")
@source(IRC_S7478_A, relation = formalizes, coverage = exact, quote = "Any such declaration shall have the force and effect of a decision of the Tax Court and shall be reviewable as such.")
@source(IRC_S7479_A, relation = formalizes, coverage = exact, quote = "Any such declaration shall have the force and effect of a decision of the Tax Court and shall be reviewable as such.")
@source(IRC_S7436_A, relation = formalizes, coverage = exact, quote = "Any such redetermination by the Tax Court shall have the force and effect of a decision of the Tax Court and shall be reviewable as such.")
@source(IRC_S7477_A, relation = formalizes, coverage = exact, quote = "Any such declaration shall have the force and effect of a decision of the Tax Court and shall be reviewable as such.")
pub rule DeclarationHasForceOfDecision strict {
    label en official "Any such declaration shall have the force and effect of a decision of the Tax Court and shall be reviewable as such.";
    for pr: Proceeding;
    for p: Person;
    for remedy: DeclaratoryRemedy;
    when declaration_made(pr, p, remedy);
    then declaration_reviewable_as_decision(pr, p, remedy);
}

// ============================================================================
// §7428(c),(d) — Validation of contributions; subpoenas
// ============================================================================

pub relation revocation_of_170c2_determination_at_issue(pr: Proceeding, org: Person) kind empirical {
    label en official "the issue referred to in subsection (a)(1) involves the revocation of a determination that the organization is described in section 170(c)(2)";
}
pub relation proceeding_initiated_within_7428b3_time(pr: Proceeding, org: Person) kind institutional;
@source(IRC_S7428_C, relation = formalizes, coverage = exact, quote = "(B) a proceeding under this section is initiated within the time provided by subsection (b)(3), and")
pub rule S7428c1BInitiatedWithinTime defeasible {
    label en official "(B) a proceeding under this section is initiated within the time provided by subsection (b)(3), and";
    for pr: Proceeding;
    for org: Person;
    when declaratory_pleading_timely(pr, org, Sec7428ExemptOrganization);
    then proceeding_initiated_within_7428b3_time(pr, org);
}
pub relation decision_or_judgment_found_organization_not_170c2(pr: Proceeding, org: Person, decidedOn: Date) kind empirical {
    label en official "a decision of the Tax Court has become final (within the meaning of section 7481), or a judgment of the district court of the United States for the District of Columbia or of the Court of Federal Claims has been entered, and such decision or judgment determines that the organization was not described in section 170(c)(2)";
}
pub relation notice_of_revocation_published_on(org: Person, on: Date) kind empirical;
pub relation organization_treated_as_170c2_described_for_period(org: Person, fromDate: Date, toDate: Date) kind institutional;
@source(IRC_S7428_C, relation = formalizes, coverage = exact, quote = "then, notwithstanding such decision or judgment, such organization shall be treated as having been described in section 170(c)(2) for purposes of section 170 for the period beginning on the date on which the notice of the revocation was published and ending on the date on which the court first determined in such proceeding that the organization was not described in section 170(c)(2).")
pub rule S7428c1TreatedAs170c2Described defeasible {
    label en official "then, notwithstanding such decision or judgment, such organization shall be treated as having been described in section 170(c)(2) for purposes of section 170 for the period beginning on the date on which the notice of the revocation was published and ending on the date on which the court first determined in such proceeding that the organization was not described in section 170(c)(2).";
    for pr: Proceeding;
    for org: Person;
    for publishedOn: Date;
    for decidedOn: Date;
    when revocation_of_170c2_determination_at_issue(pr, org)
        and proceeding_initiated_within_7428b3_time(pr, org)
        and decision_or_judgment_found_organization_not_170c2(pr, org, decidedOn)
        and notice_of_revocation_published_on(org, publishedOn);
    then organization_treated_as_170c2_described_for_period(org, publishedOn, decidedOn);
}
pub relation organization_exempt_under_501a_and_no_pending_revocation(org: Person) kind empirical {
    label en official "organizations described in section 170(c)(2) which are exempt from tax under section 501(a) (for this purpose excluding any such organization with respect to which there is pending a proceeding to revoke the determination under section 170(c)(2))";
}
pub relation contributor_responsible_for_revocation_activities(contributor: Person, org: Person) kind empirical {
    label en official "any individual who was responsible, in whole or in part, for the activities (or failures to act) on the part of the organization which were the basis for the revocation";
}
pub relation aggregate_contributions_in_validation_period(contributor: Person, org: Person, amount: Money) kind empirical {
    label en official "the aggregate of the contributions made by any individual (treating a husband and wife as one contributor) to or for the use of the organization during the period specified in paragraph (1)";
}
pub relation contribution_validated_under_7428c(contributor: Person, org: Person, amount: Money) kind institutional {
    label en unofficial "the individual's contributions in the validation period are treated as made to a section 170(c)(2) organization, to the extent they do not exceed $1,000 in the aggregate";
}
@source(IRC_S7428_C, relation = formalizes, coverage = exact, quote = "(A) with respect to individuals, and only to the extent that the aggregate of the contributions made by any individual to or for the use of the organization during the period specified in paragraph (1) does not exceed $1,000 (for this purpose treating a husband and wife as one contributor), and")
pub rule S7428c2AValidatedUpTo1000 defeasible {
    label en official "(A) with respect to individuals, and only to the extent that the aggregate of the contributions made by any individual to or for the use of the organization during the period specified in paragraph (1) does not exceed $1,000 (for this purpose treating a husband and wife as one contributor), and";
    for contributor: Person;
    for org: Person;
    for total: Money;
    for fromDate: Date;
    for toDate: Date;
    when organization_treated_as_170c2_described_for_period(org, fromDate, toDate)
        and organization_exempt_under_501a_and_no_pending_revocation(org)
        and aggregate_contributions_in_validation_period(contributor, org, total)
        and total <= 1000.00 USD;
    then contribution_validated_under_7428c(contributor, org, total);
    unless contributor_responsible_for_revocation_activities(contributor, org) and aggregate_contributions_in_validation_period(contributor, org, total);
}
@source(IRC_S7428_C, relation = formalizes, coverage = exact, quote = "(A) with respect to individuals, and only to the extent that the aggregate of the contributions made by any individual to or for the use of the organization during the period specified in paragraph (1) does not exceed $1,000 (for this purpose treating a husband and wife as one contributor), and")
pub rule S7428c2AValidatedCapAtThousand defeasible {
    label en official "(A) with respect to individuals, and only to the extent that the aggregate of the contributions made by any individual to or for the use of the organization during the period specified in paragraph (1) does not exceed $1,000 (for this purpose treating a husband and wife as one contributor), and";
    for contributor: Person;
    for org: Person;
    for total: Money;
    for fromDate: Date;
    for toDate: Date;
    when organization_treated_as_170c2_described_for_period(org, fromDate, toDate)
        and organization_exempt_under_501a_and_no_pending_revocation(org)
        and aggregate_contributions_in_validation_period(contributor, org, total)
        and total > 1000.00 USD;
    then contribution_validated_under_7428c(contributor, org, 1000.00 USD);
    unless contributor_responsible_for_revocation_activities(contributor, org) and aggregate_contributions_in_validation_period(contributor, org, total);
}
pub relation action_in_district_court_for_dc_under_7428(pr: Proceeding) kind empirical;
pub relation subpoena_may_be_served_anywhere_in_united_states(pr: Proceeding) kind institutional;
@source(IRC_S7428_D, relation = formalizes, coverage = exact, quote = "a subpoena requiring the attendance of a witness at a trial or hearing may be served at any place in the United States.")
pub rule S7428dNationwideSubpoena strict {
    label en official "a subpoena requiring the attendance of a witness at a trial or hearing may be served at any place in the United States.";
    for pr: Proceeding;
    when action_in_district_court_for_dc_under_7428(pr);
    then subpoena_may_be_served_anywhere_in_united_states(pr);
}

// ============================================================================
// §7476(c) — Retirement plan
// ============================================================================

pub relation plan_described_in_401a_or_trust_of_such_plan(plan: Asset) kind empirical {
    label en official "a pension, profit-sharing, or stock bonus plan described in section 401(a) or a trust which is part of such a plan";
}
pub relation annuity_plan_described_in_403a(plan: Asset) kind empirical {
    label en official "an annuity plan described in section 403(a)";
}
pub relation retirement_plan_for_7476(plan: Asset) kind institutional;
@source(IRC_S7476_C, relation = formalizes, coverage = exact, quote = "(1) a pension, profit-sharing, or stock bonus plan described in section 401(a) or a trust which is part of such a plan, or")
pub rule S7476c1PensionProfitSharingStock strict {
    label en official "(1) a pension, profit-sharing, or stock bonus plan described in section 401(a) or a trust which is part of such a plan, or";
    for plan: Asset;
    when plan_described_in_401a_or_trust_of_such_plan(plan);
    then retirement_plan_for_7476(plan);
}
@source(IRC_S7476_C, relation = formalizes, coverage = exact, quote = "(2) an annuity plan described in section 403(a).")
pub rule S7476c2AnnuityPlan strict {
    label en official "(2) an annuity plan described in section 403(a).";
    for plan: Asset;
    when annuity_plan_described_in_403a(plan);
    then retirement_plan_for_7476(plan);
}

// ============================================================================
// §7479(c) — Suspension of the 2-year refund-suit period
// ============================================================================

pub relation refund_claim_disallowed_for_estate(e: Person, disallowedClaim: Claim) kind empirical;
pub relation section_6166_determination_notice_mailed_on(e: Person, on: Date) kind empirical {
    label en official "the notice referred to in subsection (b)(3)";
}
pub relation declaratory_7479_pleading_filed_with_tax_court(e: Person) kind empirical {
    label en official "a pleading has been filed with the Tax Court under this section";
}
pub relation refund_suit_period_suspended(e: Person, fromDate: Date, toDate: Date) kind institutional {
    label en unofficial "the 2-year period of section 6532(a)(1) is suspended from the mailing of the §7479(b)(3) notice for 90 days and, if a pleading has been filed with the Tax Court, until the decision of the Tax Court has become final";
}
@source(IRC_S7479_C, relation = formalizes, coverage = exact, quote = "The 2-year period in section 6532(a)(1) for filing suit for refund after disallowance of a claim shall be suspended during the 90-day period after the mailing of the notice referred to in subsection (b)(3)")
pub rule S7479cSuspended90Days defeasible {
    label en official "The 2-year period in section 6532(a)(1) for filing suit for refund after disallowance of a claim shall be suspended during the 90-day period after the mailing of the notice referred to in subsection (b)(3)";
    for e: Person;
    for mailedOn: Date;
    when section_6166_determination_notice_mailed_on(e, mailedOn)
        and not_known(declaratory_7479_pleading_filed_with_tax_court(e));
    then refund_suit_period_suspended(e, mailedOn, add_calendar_period(mailedOn, 90 calendar_day));
}
pub relation estate_7479_proceeding(pr: Proceeding, e: Person) kind empirical;
@source(IRC_S7479_C, relation = formalizes, coverage = exact, quote = "if a pleading has been filed with the Tax Court under this section, until the decision of the Tax Court has become final.")
pub rule S7479cSuspendedUntilDecisionFinal defeasible {
    label en official "if a pleading has been filed with the Tax Court under this section, until the decision of the Tax Court has become final.";
    for pr: Proceeding;
    for e: Person;
    for mailedOn: Date;
    for finalOn: Date;
    when section_6166_determination_notice_mailed_on(e, mailedOn)
        and declaratory_7479_pleading_filed_with_tax_court(e)
        and estate_7479_proceeding(pr, e)
        and decision_final_on(pr, finalOn);
    then refund_suit_period_suspended(e, mailedOn, finalOn);
}

// ============================================================================
// §7436(b)(3), (c), (e) — Employment status proceedings
// ============================================================================

pub relation petitioner_changed_treatment_to_employee_during_pendency(pr: Proceeding, p: Person) kind empirical {
    label en official "during the pendency of any proceeding brought under this section, the petitioner changes his treatment for employment tax purposes of any individual whose employment status as an employee is involved in such proceeding (or of any individual holding a substantially similar position) to treatment as an employee";
}
pub relation change_of_treatment_not_taken_into_account(pr: Proceeding, p: Person) kind institutional;
@source(IRC_S7436_B, relation = formalizes, coverage = exact, quote = "such change shall not be taken into account in the Tax Court's determination under this section.")
pub rule S7436b3NoAdverseInference strict {
    label en official "such change shall not be taken into account in the Tax Court's determination under this section.";
    for pr: Proceeding;
    for p: Person;
    when petitioner_changed_treatment_to_employee_during_pendency(pr, p);
    then change_of_treatment_not_taken_into_account(pr, p);
}
pub relation employment_taxes_in_dispute_for_quarter(pr: Proceeding, quarter: Text, amount: Money) kind empirical {
    label en official "the amount of employment taxes placed in dispute for a calendar quarter involved";
}
pub relation some_quarter_exceeds_50000(pr: Proceeding) kind institutional;
rule S7436c1QuarterAboveLimit strict {
    for pr: Proceeding;
    for quarter: Text;
    for amount: Money;
    when employment_taxes_in_dispute_for_quarter(pr, quarter, amount)
        and amount > 50000.00 USD;
    then some_quarter_exceeds_50000(pr);
}
pub relation petitioner_elects_small_case_7436(pr: Proceeding) kind empirical {
    label en official "at the option of the petitioner";
}
pub relation tax_court_concurs_before_hearing_7436(pr: Proceeding) kind empirical {
    label en official "concurred in by the Tax Court or a division thereof before the hearing of the case";
}
pub relation employment_status_small_case_procedure_applies(pr: Proceeding) kind institutional;
@source(IRC_S7436_C, relation = formalizes, coverage = exact, quote = "At the option of the petitioner, concurred in by the Tax Court or a division thereof before the hearing of the case, proceedings under this section may (notwithstanding the provisions of section 7453) be conducted subject to the rules of evidence, practice, and procedure applicable under section 7463 if the amount of employment taxes placed in dispute is $50,000 or less for each calendar quarter involved.")
pub rule S7436c1SmallCaseProcedure defeasible {
    label en official "At the option of the petitioner, concurred in by the Tax Court or a division thereof before the hearing of the case, proceedings under this section may (notwithstanding the provisions of section 7453) be conducted subject to the rules of evidence, practice, and procedure applicable under section 7463 if the amount of employment taxes placed in dispute is $50,000 or less for each calendar quarter involved.";
    for pr: Proceeding;
    for anyQuarter: Text;
    for anyAmount: Money;
    when petitioner_elects_small_case_7436(pr)
        and tax_court_concurs_before_hearing_7436(pr)
        and employment_taxes_in_dispute_for_quarter(pr, anyQuarter, anyAmount)
        and not_known(some_quarter_exceeds_50000(pr));
    then employment_status_small_case_procedure_applies(pr);
}
pub relation employment_status_decision_reviewed_elsewhere_or_precedent(pr: Proceeding) kind empirical {
    label en official "a decision entered in any proceeding conducted under this subsection is reviewed in any other court or treated as a precedent for any other case not involving the same petitioner and the same determinations";
}
@source(IRC_S7436_C, relation = formalizes, coverage = exact, quote = "A decision entered in any proceeding conducted under this subsection shall not be reviewed in any other court and shall not be treated as a precedent for any other case not involving the same petitioner and the same determinations.")
pub rule S7436c2FinalityImmunityRule strict {
    label en official "A decision entered in any proceeding conducted under this subsection shall not be reviewed in any other court and shall not be treated as a precedent for any other case not involving the same petitioner and the same determinations.";
    for pr: Proceeding;
    when employment_status_small_case_procedure_applies(pr);
    then immunity S7436c2NoReviewNoPrecedentImmunity {
        holder us.irc.core::TaxCourt;
        protected_effect employment_status_decision_reviewed_elsewhere_or_precedent(pr);
        window [-infinity, infinity];
    };
}
pub relation employment_tax_kind(k: TaxKind) kind institutional {
    label en unofficial "the tax kind is an employment tax: a tax imposed by subtitle C";
}
@source(IRC_S7436_E, relation = formalizes, coverage = exact, quote = "The term \"employment tax\" means any tax imposed by subtitle C.")
rule S7436eFica strict { then employment_tax_kind(us.irc.core::FicaCh21); }
@source(IRC_S7436_E, relation = formalizes, coverage = exact, quote = "The term \"employment tax\" means any tax imposed by subtitle C.")
rule S7436eRrta strict { then employment_tax_kind(us.irc.core::RrtaCh22); }
@source(IRC_S7436_E, relation = formalizes, coverage = exact, quote = "The term \"employment tax\" means any tax imposed by subtitle C.")
rule S7436eFuta strict { then employment_tax_kind(us.irc.core::FutaCh23); }
@source(IRC_S7436_E, relation = formalizes, coverage = exact, quote = "The term \"employment tax\" means any tax imposed by subtitle C.")
rule S7436eRailroadUnemployment strict { then employment_tax_kind(us.irc.core::RailroadUnemploymentRepaymentCh23A); }
@source(IRC_S7436_E, relation = formalizes, coverage = exact, quote = "The term \"employment tax\" means any tax imposed by subtitle C.")
rule S7436eWithholding strict { then employment_tax_kind(us.irc.core::WithholdingWagesCh24); }
pub relation section_7430_applies_to_employment_status_proceeding(pr: Proceeding) kind institutional;
@source(IRC_S7436_D, relation = formalizes, coverage = exact, quote = "Section 7430 shall apply to proceedings brought under this section.")
pub rule S7436d2Section7430Applies strict {
    label en official "Section 7430 shall apply to proceedings brought under this section.";
    for pr: Proceeding;
    for p: Person;
    when declaratory_controversy(pr, p, Sec7436EmploymentStatus);
    then section_7430_applies_to_employment_status_proceeding(pr);
}
