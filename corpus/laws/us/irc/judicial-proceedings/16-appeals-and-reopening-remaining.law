// Stage 2 — subchapter F remainder: §7481(c),(d) (reopening for interest
// and for estate administration expenses), §7482(b),(c) (venue and powers
// of the courts of appeals), §7484, §7485(b) (partnership bond), §7486
// (refund of disallowed amounts), §7487 (cross references).
//
// METHOD NOTE. Reopening is a POWER of the Tax Court whose `valid_when`
// folds the statutory case description and the one-year motion window;
// the appellate venue table is a set of candidate-circuit rules, one per
// category of petition, with the District of Columbia as the fallback
// only when no category applies (`not_known` of every candidate) and the
// only circuit for a §7478 decision; a stipulated circuit is an
// additional candidate. The courts of appeals' power to modify or reverse
// requires the court's own finding that the decision "is not in accordance
// with law" (a DECISION-0194 judgment with the court of appeals as
// authority; the `CourtOfAppeals` organ is declared below). "May be
// reviewed" is an institutional permission, not a duty.
//
// JUDGMENT CALLS AND GAPS. §7482(c)(4) does not state an amount in the
// pinned text: the penalty power has grounds only. The "aggregate
// liability of the parties" estimate of §7485(b) is a typed input from the
// Tax Court (no arithmetic over parties' liabilities is defined by the
// text). §7486 is the two-branch refund/abatement split: the collected
// part of the disallowed amount is credited or refunded, the uncollected
// remainder is abated.

language "law.core" version "0.2";
package us.irc.judicial_proceedings version "0.1.1";
namespace "urn:us:irc:judicial_proceedings:clir";

use self::{
    IRC_S7481_C,
    IRC_S7481_D,
    IRC_S7482_B,
    IRC_S7482_C,
    IRC_S7484,
    IRC_S7485_B,
    IRC_S7486,
    Organ,
    Person,
    Proceeding,
    decision_final_on,
};

const CourtOfAppeals: Organ = entity_ref("urn:us:irc:judicial_proceedings:clir#CourtOfAppeals") {
    label en unofficial "the United States court of appeals reviewing a decision of the Tax Court";
}

// ============================================================================
// §7481(c) — Jurisdiction over interest determinations
// ============================================================================

pub relation assessment_under_6215_including_interest(pr: Proceeding, p: Person) kind empirical {
    label en official "an assessment has been made by the Secretary under section 6215 which includes interest as imposed by this title";
}
pub relation taxpayer_paid_entire_deficiency_plus_interest(pr: Proceeding, p: Person) kind empirical {
    label en official "the taxpayer has paid the entire amount of the deficiency plus interest claimed by the Secretary";
}
external judgment relation tax_court_finds_overpayment_under_6512b(pr: Proceeding, p: Person) {
    authority TaxCourt;
    label en official "the Tax Court finds under section 6512(b) that the taxpayer has made an overpayment";
}
pub relation interest_redetermination_case(pr: Proceeding, p: Person) kind institutional {
    label en unofficial "the case is one to which §7481(c) applies: (A) assessment under §6215 including interest and full payment, and (B) an overpayment found under §6512(b)";
}
@source(IRC_S7481_C, relation = formalizes, coverage = exact, quote = "This subsection shall apply where—")
pub rule S7481c2CaseDescription defeasible {
    label en official "This subsection shall apply where—";
    for pr: Proceeding;
    for p: Person;
    when assessment_under_6215_including_interest(pr, p)
        and taxpayer_paid_entire_deficiency_plus_interest(pr, p)
        and tax_court_finds_overpayment_under_6512b(pr, p);
    then interest_redetermination_case(pr, p);
}
pub relation interest_redetermination_motion_filed_on(pr: Proceeding, p: Person, on: Date) kind empirical;
pub relation interest_motion_within_one_year(pr: Proceeding, p: Person, on: Date) kind institutional {
    label en unofficial "the motion for redetermination of interest is filed within 1 year after the decision became final";
}
@source(IRC_S7481_C, relation = formalizes, coverage = exact, quote = "Notwithstanding subsection (a), if, within 1 year after the date the decision of the Tax Court becomes final under subsection (a) in a case to which this subsection applies, the taxpayer files a motion in the Tax Court for a redetermination of the amount of interest involved")
pub rule S7481c1MotionWithinOneYear defeasible {
    label en official "Notwithstanding subsection (a), if, within 1 year after the date the decision of the Tax Court becomes final under subsection (a) in a case to which this subsection applies, the taxpayer files a motion in the Tax Court for a redetermination of the amount of interest involved";
    for pr: Proceeding;
    for p: Person;
    for on: Date;
    for finalOn: Date;
    when decision_final_on(pr, finalOn)
        and interest_redetermination_motion_filed_on(pr, p, on)
        and on <= add_calendar_period(finalOn, 1 calendar_year);
    then interest_motion_within_one_year(pr, p, on);
}
pub relation interest_reopening_grounds(pr: Proceeding, p: Person) kind institutional;
@source(IRC_S7481_C, relation = formalizes, coverage = exact, quote = "Notwithstanding subsection (a), if, within 1 year after the date the decision of the Tax Court becomes final under subsection (a) in a case to which this subsection applies, the taxpayer files a motion in the Tax Court for a redetermination of the amount of interest involved")
pub rule S7481c1Grounds defeasible {
    label en official "Notwithstanding subsection (a), if, within 1 year after the date the decision of the Tax Court becomes final under subsection (a) in a case to which this subsection applies, the taxpayer files a motion in the Tax Court for a redetermination of the amount of interest involved";
    for pr: Proceeding;
    for p: Person;
    for on: Date;
    when interest_redetermination_case(pr, p)
        and interest_motion_within_one_year(pr, p, on);
    then interest_reopening_grounds(pr, p);
}
pub relation tax_court_reopens_case_for_interest(pr: Proceeding, p: Person) kind empirical;
pub relation case_reopened_solely_for_interest(pr: Proceeding, p: Person) kind institutional;
@source(IRC_S7481_C, relation = formalizes, coverage = exact, quote = "then the Tax Court may reopen the case solely to determine whether the taxpayer has made an overpayment of such interest or the Secretary has made an underpayment of such interest and the amount thereof.")
pub rule S7481c1ReopenPowerRule defeasible {
    label en official "then the Tax Court may reopen the case solely to determine whether the taxpayer has made an overpayment of such interest or the Secretary has made an underpayment of such interest and the amount thereof.";
    for pr: Proceeding;
    for p: Person;
    when tax_court_reopens_case_for_interest(pr, p);
    then power S7481c1ReopenForInterest {
        holder us.irc.core::TaxCourt;
        over p;
        exercise tax_court_reopens_case_for_interest(pr, p);
        valid_when interest_reopening_grounds(pr, p);
        effect case_reopened_solely_for_interest(pr, p);
    };
}
pub relation tax_court_determines_interest_overpayment_or_underpayment(pr: Proceeding, p: Person) kind empirical {
    label en official "the Tax Court determines under this subsection that the taxpayer has made an overpayment of interest or that the Secretary has made an underpayment of interest";
}
pub relation interest_determination_treated_as_overpayment_of_tax_under_6512b1(pr: Proceeding, p: Person) kind institutional;
@source(IRC_S7481_C, relation = formalizes, coverage = exact, quote = "then that determination shall be treated under section 6512(b)(1) as a determination of an overpayment of tax.")
pub rule S7481c3TreatedAsOverpaymentOfTax strict {
    label en official "then that determination shall be treated under section 6512(b)(1) as a determination of an overpayment of tax.";
    for pr: Proceeding;
    for p: Person;
    when tax_court_determines_interest_overpayment_or_underpayment(pr, p);
    then interest_determination_treated_as_overpayment_of_tax_under_6512b1(pr, p);
}
pub relation interest_order_entered(pr: Proceeding) kind empirical {
    label en official "An order of the Tax Court redetermining interest, when entered upon the records of the court";
}
pub relation interest_order_reviewable_as_decision(pr: Proceeding) kind institutional;
@source(IRC_S7481_C, relation = formalizes, coverage = exact, quote = "An order of the Tax Court redetermining interest, when entered upon the records of the court, shall be reviewable in the same manner as a decision of the Tax Court.")
pub rule S7481c3OrderReviewable strict {
    label en official "An order of the Tax Court redetermining interest, when entered upon the records of the court, shall be reviewable in the same manner as a decision of the Tax Court.";
    for pr: Proceeding;
    when interest_order_entered(pr);
    then interest_order_reviewable_as_decision(pr);
}

// ============================================================================
// §7481(d) — Estate tax extended under §6166: administration expenses
// ============================================================================

pub relation estate_tax_time_extended_under_6166(pr: Proceeding, e: Person) kind empirical {
    label en official "the time for payment of an amount of tax imposed by chapter 11 is extended under section 6166";
}
pub relation interest_treated_as_administration_expense_2053(pr: Proceeding, e: Person) kind empirical {
    label en official "there is treated as an administrative expense under section 2053 either interest on the deferred estate tax or interest on a State death tax during the period of the extension";
}
pub relation estate_motion_to_reopen_for_2053_deduction(pr: Proceeding, e: Person) kind empirical {
    label en official "upon a motion by the petitioner in such case in which such time for payment of tax has been extended under section 6166";
}
pub relation estate_reopening_grounds(pr: Proceeding, e: Person) kind institutional;
@source(IRC_S7481_D, relation = formalizes, coverage = exact, quote = "If with respect to a decedent's estate subject to a decision of the Tax Court—")
pub rule S7481dGrounds defeasible {
    label en official "If with respect to a decedent's estate subject to a decision of the Tax Court—";
    for pr: Proceeding;
    for e: Person;
    when estate_tax_time_extended_under_6166(pr, e)
        and interest_treated_as_administration_expense_2053(pr, e)
        and estate_motion_to_reopen_for_2053_deduction(pr, e);
    then estate_reopening_grounds(pr, e);
}
pub relation tax_court_reopens_estate_case(pr: Proceeding, e: Person) kind empirical;
pub relation estate_case_reopened_solely_for_2053_deduction(pr: Proceeding, e: Person) kind institutional;
@source(IRC_S7481_D, relation = formalizes, coverage = exact, quote = "the Tax Court may reopen the case solely to modify the Court's decision to reflect such estate's entitlement to a deduction for such administration expenses under section 2053")
pub rule S7481dReopenPowerRule defeasible {
    label en official "the Tax Court may reopen the case solely to modify the Court's decision to reflect such estate's entitlement to a deduction for such administration expenses under section 2053";
    for pr: Proceeding;
    for e: Person;
    when tax_court_reopens_estate_case(pr, e);
    then power S7481dReopenEstateCase {
        holder us.irc.core::TaxCourt;
        over e;
        exercise tax_court_reopens_estate_case(pr, e);
        valid_when estate_reopening_grounds(pr, e);
        effect estate_case_reopened_solely_for_2053_deduction(pr, e);
    };
}
pub relation order_disposing_of_2053_motion_entered(pr: Proceeding) kind empirical;
pub relation order_on_2053_motion_reviewable_limited_to_matters_determined(pr: Proceeding) kind institutional;
@source(IRC_S7481_D, relation = formalizes, coverage = exact, quote = "An order of the Tax Court disposing of a motion under this subsection shall be reviewable in the same manner as a decision of the Tax Court, but only with respect to the matters determined in such order.")
pub rule S7481dOrderReviewable strict {
    label en official "An order of the Tax Court disposing of a motion under this subsection shall be reviewable in the same manner as a decision of the Tax Court, but only with respect to the matters determined in such order.";
    for pr: Proceeding;
    when order_disposing_of_2053_motion_entered(pr);
    then order_on_2053_motion_reviewable_limited_to_matters_determined(pr);
}

// ============================================================================
// §7482(b) — Venue of appeals
// ============================================================================

pub relation appeal_of_redetermination_by_noncorporation(pr: Proceeding) kind empirical;
pub relation appeal_of_redetermination_by_corporation(pr: Proceeding) kind empirical;
pub relation appeal_of_7476_declaratory_decision(pr: Proceeding) kind empirical;
pub relation appeal_of_7428_declaratory_decision(pr: Proceeding) kind empirical;
pub relation appeal_of_6234_partnership_petition(pr: Proceeding) kind empirical;
pub relation appeal_of_6015e_petition(pr: Proceeding) kind empirical;
pub relation appeal_of_6320_or_6330_petition_by_individual(pr: Proceeding) kind empirical;
pub relation appeal_of_6320_or_6330_petition_by_entity(pr: Proceeding) kind empirical;
pub relation appeal_of_7478_declaratory_decision(pr: Proceeding) kind empirical {
    label en official "any decision of the Tax Court in a proceeding under section 7478";
}
pub relation petitioner_legal_residence_circuit(pr: Proceeding, circuit: Text) kind empirical {
    label en official "the circuit in which is located the legal residence of the petitioner (determined as of the time the petition was filed)";
}
pub relation corporation_principal_place_circuit(pr: Proceeding, circuit: Text) kind empirical {
    label en official "the circuit in which is located the principal place of business or principal office or agency of the corporation (as of the time the petition was filed)";
}
pub relation corporation_return_office_circuit(pr: Proceeding, circuit: Text) kind empirical {
    label en official "the circuit in which is located the office to which was made the return of the tax in respect of which the liability arises";
}
pub relation corporation_has_principal_place_in_a_circuit(pr: Proceeding) kind institutional;
rule S7482b1BPrincipalPlaceBridge strict {
    for pr: Proceeding;
    for circuit: Text;
    when corporation_principal_place_circuit(pr, circuit);
    then corporation_has_principal_place_in_a_circuit(pr);
}
pub relation employer_principal_place_circuit(pr: Proceeding, circuit: Text) kind empirical;
pub relation organization_principal_office_circuit(pr: Proceeding, circuit: Text) kind empirical;
pub relation partnership_principal_place_circuit(pr: Proceeding, circuit: Text) kind empirical;
pub relation entity_principal_place_circuit(pr: Proceeding, circuit: Text) kind empirical;
pub relation appeal_venue_category_circuit(pr: Proceeding, circuit: Text) kind institutional {
    label en unofficial "the circuit in which a decision may be reviewed under paragraph (1) by the category of the petition";
}
@source(IRC_S7482_B, relation = formalizes, coverage = exact, quote = "(A) in the case of a petitioner seeking redetermination of tax liability other than a corporation, the legal residence of the petitioner,")
pub rule S7482b1ANoncorporation defeasible {
    label en official "(A) in the case of a petitioner seeking redetermination of tax liability other than a corporation, the legal residence of the petitioner,";
    for pr: Proceeding;
    for circuit: Text;
    when appeal_of_redetermination_by_noncorporation(pr)
        and petitioner_legal_residence_circuit(pr, circuit);
    then appeal_venue_category_circuit(pr, circuit);
}
@source(IRC_S7482_B, relation = formalizes, coverage = exact, quote = "(B) in the case of a corporation seeking redetermination of tax liability, the principal place of business or principal office or agency of the corporation, or, if it has no principal place of business or principal office or agency in any judicial circuit, then the office to which was made the return of the tax in respect of which the liability arises,")
pub rule S7482b1BCorporationPrincipalPlace defeasible {
    label en official "(B) in the case of a corporation seeking redetermination of tax liability, the principal place of business or principal office or agency of the corporation, or, if it has no principal place of business or principal office or agency in any judicial circuit, then the office to which was made the return of the tax in respect of which the liability arises,";
    for pr: Proceeding;
    for circuit: Text;
    when appeal_of_redetermination_by_corporation(pr)
        and corporation_principal_place_circuit(pr, circuit);
    then appeal_venue_category_circuit(pr, circuit);
}
@source(IRC_S7482_B, relation = formalizes, coverage = exact, quote = "(B) in the case of a corporation seeking redetermination of tax liability, the principal place of business or principal office or agency of the corporation, or, if it has no principal place of business or principal office or agency in any judicial circuit, then the office to which was made the return of the tax in respect of which the liability arises,")
pub rule S7482b1BCorporationReturnOffice defeasible {
    label en official "(B) in the case of a corporation seeking redetermination of tax liability, the principal place of business or principal office or agency of the corporation, or, if it has no principal place of business or principal office or agency in any judicial circuit, then the office to which was made the return of the tax in respect of which the liability arises,";
    for pr: Proceeding;
    for circuit: Text;
    when appeal_of_redetermination_by_corporation(pr)
        and not_known(corporation_has_principal_place_in_a_circuit(pr))
        and corporation_return_office_circuit(pr, circuit);
    then appeal_venue_category_circuit(pr, circuit);
}
@source(IRC_S7482_B, relation = formalizes, coverage = exact, quote = "(C) in the case of a person seeking a declaratory decision under section 7476, the principal place of business, or principal office or agency of the employer,")
pub rule S7482b1CRetirementPlan defeasible {
    label en official "(C) in the case of a person seeking a declaratory decision under section 7476, the principal place of business, or principal office or agency of the employer,";
    for pr: Proceeding;
    for circuit: Text;
    when appeal_of_7476_declaratory_decision(pr)
        and employer_principal_place_circuit(pr, circuit);
    then appeal_venue_category_circuit(pr, circuit);
}
@source(IRC_S7482_B, relation = formalizes, coverage = exact, quote = "(D) in the case of an organization seeking a declaratory decision under section 7428, the principal office or agency of the organization,")
pub rule S7482b1DExemptOrganization defeasible {
    label en official "(D) in the case of an organization seeking a declaratory decision under section 7428, the principal office or agency of the organization,";
    for pr: Proceeding;
    for circuit: Text;
    when appeal_of_7428_declaratory_decision(pr)
        and organization_principal_office_circuit(pr, circuit);
    then appeal_venue_category_circuit(pr, circuit);
}
@source(IRC_S7482_B, relation = formalizes, coverage = exact, quote = "(E) in the case of a petition under section 6234, the principal place of business of the partnership,")
pub rule S7482b1EPartnership defeasible {
    label en official "(E) in the case of a petition under section 6234, the principal place of business of the partnership,";
    for pr: Proceeding;
    for circuit: Text;
    when appeal_of_6234_partnership_petition(pr)
        and partnership_principal_place_circuit(pr, circuit);
    then appeal_venue_category_circuit(pr, circuit);
}
@source(IRC_S7482_B, relation = formalizes, coverage = exact, quote = "(F) in the case of a petition under section 6015(e), the legal residence of the petitioner, or")
pub rule S7482b1FInnocentSpouse defeasible {
    label en official "(F) in the case of a petition under section 6015(e), the legal residence of the petitioner, or";
    for pr: Proceeding;
    for circuit: Text;
    when appeal_of_6015e_petition(pr)
        and petitioner_legal_residence_circuit(pr, circuit);
    then appeal_venue_category_circuit(pr, circuit);
}
@source(IRC_S7482_B, relation = formalizes, coverage = exact, quote = "(i) the legal residence of the petitioner if the petitioner is an individual, and")
pub rule S7482b1GIndividual defeasible {
    label en official "(i) the legal residence of the petitioner if the petitioner is an individual, and";
    for pr: Proceeding;
    for circuit: Text;
    when appeal_of_6320_or_6330_petition_by_individual(pr)
        and petitioner_legal_residence_circuit(pr, circuit);
    then appeal_venue_category_circuit(pr, circuit);
}
@source(IRC_S7482_B, relation = formalizes, coverage = exact, quote = "(ii) the principal place of business or principal office or agency if the petitioner is an entity other than an individual.")
pub rule S7482b1GEntity defeasible {
    label en official "(ii) the principal place of business or principal office or agency if the petitioner is an entity other than an individual.";
    for pr: Proceeding;
    for circuit: Text;
    when appeal_of_6320_or_6330_petition_by_entity(pr)
        and entity_principal_place_circuit(pr, circuit);
    then appeal_venue_category_circuit(pr, circuit);
}
pub relation any_category_venue_exists(pr: Proceeding) kind institutional;
rule S7482b1AnyCategoryBridge defeasible {
    for pr: Proceeding;
    for circuit: Text;
    when appeal_venue_category_circuit(pr, circuit);
    then any_category_venue_exists(pr);
}
pub relation stipulated_circuit_for_review(pr: Proceeding, circuit: Text) kind empirical {
    label en official "any United States Court of Appeals which may be designated by the Secretary and the taxpayer by stipulation in writing";
}
pub relation appeal_may_be_reviewed_in(pr: Proceeding, circuit: Text) kind institutional {
    label en unofficial "the decision may be reviewed by the court of appeals for the circuit";
}
@source(IRC_S7482_B, relation = formalizes, coverage = exact, quote = "such decisions may be reviewed by the United States court of appeals for the circuit in which is located—")
pub rule S7482b1ReviewInCategoryCircuit defeasible {
    label en official "such decisions may be reviewed by the United States court of appeals for the circuit in which is located—";
    for pr: Proceeding;
    for circuit: Text;
    when appeal_venue_category_circuit(pr, circuit);
    then appeal_may_be_reviewed_in(pr, circuit);
    unless appeal_of_7478_declaratory_decision(pr) and appeal_venue_category_circuit(pr, circuit);
}
@source(IRC_S7482_B, relation = formalizes, coverage = exact, quote = "If for any reason no subparagraph of the preceding sentence applies, then such decisions may be reviewed by the Court of Appeals for the District of Columbia.")
pub rule S7482b1FallbackDistrictOfColumbia defeasible {
    label en official "If for any reason no subparagraph of the preceding sentence applies, then such decisions may be reviewed by the Court of Appeals for the District of Columbia.";
    for pr: Proceeding;
    for kind: Text;
    when appeal_of_decision(pr, kind)
        and not_known(any_category_venue_exists(pr));
    then appeal_may_be_reviewed_in(pr, "D.C.");
}
pub relation appeal_of_decision(pr: Proceeding, kind: Text) kind empirical {
    label en unofficial "the decision of the Tax Court is reviewed on appeal (any category)";
}
@source(IRC_S7482_B, relation = formalizes, coverage = exact, quote = "Notwithstanding the provisions of paragraph (1), such decisions may be reviewed by any United States Court of Appeals which may be designated by the Secretary and the taxpayer by stipulation in writing.")
pub rule S7482b2ByAgreement defeasible {
    label en official "Notwithstanding the provisions of paragraph (1), such decisions may be reviewed by any United States Court of Appeals which may be designated by the Secretary and the taxpayer by stipulation in writing.";
    for pr: Proceeding;
    for circuit: Text;
    when stipulated_circuit_for_review(pr, circuit);
    then appeal_may_be_reviewed_in(pr, circuit);
}
@source(IRC_S7482_B, relation = formalizes, coverage = exact, quote = "In the case of any decision of the Tax Court in a proceeding under section 7478, such decision may only be reviewed by the Court of Appeals for the District of Columbia.")
pub rule S7482b3TaxExemptBondsOnlyDc defeasible {
    label en official "In the case of any decision of the Tax Court in a proceeding under section 7478, such decision may only be reviewed by the Court of Appeals for the District of Columbia.";
    for pr: Proceeding;
    when appeal_of_7478_declaratory_decision(pr);
    then appeal_may_be_reviewed_in(pr, "D.C.");
}

// ============================================================================
// §7482(c) — Powers of the courts of appeals
// ============================================================================

external judgment relation tax_court_decision_not_in_accordance_with_law(pr: Proceeding) {
    authority CourtOfAppeals;
    label en official "the decision of the Tax Court is not in accordance with law";
}
pub relation court_of_appeals_modifies_or_reverses(pr: Proceeding) kind empirical;
pub relation tax_court_decision_modified_or_reversed(pr: Proceeding) kind institutional;
@source(IRC_S7482_C, relation = formalizes, coverage = exact, quote = "Upon such review, such courts shall have power to affirm or, if the decision of the Tax Court is not in accordance with law, to modify or to reverse the decision of the Tax Court, with or without remanding the case for a rehearing, as justice may require.")
pub rule S7482c1ModifyReversePowerRule defeasible {
    label en official "Upon such review, such courts shall have power to affirm or, if the decision of the Tax Court is not in accordance with law, to modify or to reverse the decision of the Tax Court, with or without remanding the case for a rehearing, as justice may require.";
    for pr: Proceeding;
    when court_of_appeals_modifies_or_reverses(pr);
    then power S7482c1ModifyOrReverse {
        holder CourtOfAppeals;
        exercise court_of_appeals_modifies_or_reverses(pr);
        valid_when tax_court_decision_not_in_accordance_with_law(pr);
        effect tax_court_decision_modified_or_reversed(pr);
    };
}
pub relation court_of_appeals_affirms(pr: Proceeding) kind empirical;
pub relation tax_court_decision_affirmed(pr: Proceeding) kind institutional;
@source(IRC_S7482_C, relation = formalizes, coverage = exact, quote = "Upon such review, such courts shall have power to affirm")
pub rule S7482c1AffirmRule strict {
    label en official "Upon such review, such courts shall have power to affirm";
    for pr: Proceeding;
    when court_of_appeals_affirms(pr);
    then tax_court_decision_affirmed(pr);
}
pub relation court_requires_undertaking(pr: Proceeding, p: Person) kind empirical {
    label en official "such undertakings as the court may require as a condition of or in connection with the review";
}
pub relation undertaking_filed(pr: Proceeding, p: Person) kind empirical;
@source(IRC_S7482_C, relation = formalizes, coverage = exact, quote = "Nothing in section 7483 shall be construed as relieving the petitioner from making or filing such undertakings as the court may require as a condition of or in connection with the review.")
pub rule S7482c3UndertakingDutyRule strict {
    label en official "Nothing in section 7483 shall be construed as relieving the petitioner from making or filing such undertakings as the court may require as a condition of or in connection with the review.";
    for pr: Proceeding;
    for p: Person;
    when court_requires_undertaking(pr, p);
    then duty S7482c3FileRequiredUndertaking {
        bearer p;
        goal achievement {
            condition undertaking_filed(pr, p);
            window [-infinity, infinity];
        }
    };
}
external judgment relation appeal_primarily_for_delay_or_frivolous(pr: Proceeding, p: Person) {
    authority CourtOfAppeals;
    label en official "it appears that the appeal was instituted or maintained primarily for delay or that the taxpayer's position in the appeal is frivolous or groundless";
}
pub relation tax_court_decision_affirmed_on_appeal(pr: Proceeding) kind empirical;
pub relation appellate_penalty_grounds(pr: Proceeding, p: Person) kind institutional;
@source(IRC_S7482_C, relation = formalizes, coverage = exact, quote = "The United States Court of Appeals and the Supreme Court shall have the power to require the taxpayer to pay to the United States a penalty in any case where the decision of the Tax Court is affirmed and it appears that the appeal was instituted or maintained primarily for delay or that the taxpayer's position in the appeal is frivolous or groundless.")
pub rule S7482c4Grounds defeasible {
    label en official "The United States Court of Appeals and the Supreme Court shall have the power to require the taxpayer to pay to the United States a penalty in any case where the decision of the Tax Court is affirmed and it appears that the appeal was instituted or maintained primarily for delay or that the taxpayer's position in the appeal is frivolous or groundless.";
    for pr: Proceeding;
    for p: Person;
    when tax_court_decision_affirmed_on_appeal(pr)
        and appeal_primarily_for_delay_or_frivolous(pr, p);
    then appellate_penalty_grounds(pr, p);
}
pub relation appellate_court_requires_penalty(pr: Proceeding, p: Person) kind empirical;
pub relation appellate_penalty_imposed(pr: Proceeding, p: Person) kind institutional;
@source(IRC_S7482_C, relation = formalizes, coverage = exact, quote = "The United States Court of Appeals and the Supreme Court shall have the power to require the taxpayer to pay to the United States a penalty in any case where the decision of the Tax Court is affirmed")
pub rule S7482c4PenaltyPowerRule defeasible {
    label en official "The United States Court of Appeals and the Supreme Court shall have the power to require the taxpayer to pay to the United States a penalty in any case where the decision of the Tax Court is affirmed";
    for pr: Proceeding;
    for p: Person;
    when appellate_court_requires_penalty(pr, p);
    then power S7482c4ImposePenalty {
        holder CourtOfAppeals;
        over p;
        exercise appellate_court_requires_penalty(pr, p);
        valid_when appellate_penalty_grounds(pr, p);
        effect appellate_penalty_imposed(pr, p);
    };
}

// ============================================================================
// §7484, §7485(b), §7486 — Change of Secretary; partnership bond; refund
// ============================================================================

pub relation secretary_office_incumbent_changed_in_appellate_proceeding(pr: Proceeding) kind empirical {
    label en official "the incumbent of the office of Secretary changes (in proceedings pending before any appellate court reviewing the action of the Tax Court)";
}
pub relation substitution_of_successor_required(pr: Proceeding) kind institutional;
@source(IRC_S7484, relation = formalizes, coverage = exact, quote = "When the incumbent of the office of Secretary changes, no substitution of the name of his successor shall be required in proceedings pending before any appellate court reviewing the action of the Tax Court.")
pub rule S7484NoSubstitutionRequiredRule strict {
    label en official "When the incumbent of the office of Secretary changes, no substitution of the name of his successor shall be required in proceedings pending before any appellate court reviewing the action of the Tax Court.";
    for pr: Proceeding;
    when secretary_office_incumbent_changed_in_appellate_proceeding(pr);
    then immunity S7484NoSubstitutionImmunity {
        holder us.irc.core::Secretary;
        protected_effect substitution_of_successor_required(pr);
        window [-infinity, infinity];
    };
}
pub relation partnership_files_notice_of_appeal_from_6234_decision(pr: Proceeding, partnership: Person, on: Date) kind empirical {
    label en official "the partnership duly files notice of appeal from a decision under section 6234";
}
pub relation partnership_bond_filed_on(pr: Proceeding, partnership: Person, on: Date) kind empirical {
    label en official "a bond in an amount fixed by the Tax Court is filed, and with surety approved by the Tax Court, conditioned upon the payment of deficiencies attributable to the partnership-related items";
}
pub relation partnership_bond_condition_met(pr: Proceeding, partnership: Person) kind institutional {
    label en unofficial "the condition of subsection (a) is satisfied for the partnership: notice of appeal from the §6234 decision and a bond filed on or before the time the notice of appeal is filed";
}
@source(IRC_S7485_B, relation = formalizes, coverage = exact, quote = "The condition of subsection (a) shall be satisfied if the partnership duly files notice of appeal from a decision under section 6234 and on or before the time the notice of appeal is filed with the Tax Court, a bond in an amount fixed by the Tax Court is filed, and with surety approved by the Tax Court")
pub rule S7485bBondCondition defeasible {
    label en official "The condition of subsection (a) shall be satisfied if the partnership duly files notice of appeal from a decision under section 6234 and on or before the time the notice of appeal is filed with the Tax Court, a bond in an amount fixed by the Tax Court is filed, and with surety approved by the Tax Court";
    for pr: Proceeding;
    for partnership: Person;
    for noticeOn: Date;
    for bondOn: Date;
    when partnership_files_notice_of_appeal_from_6234_decision(pr, partnership, noticeOn)
        and partnership_bond_filed_on(pr, partnership, bondOn)
        and bondOn <= noticeOn;
    then partnership_bond_condition_met(pr, partnership);
}
pub relation parties_stipulated_bond_amount(pr: Proceeding, amount: Money) kind empirical {
    label en official "unless otherwise stipulated by the parties";
}
pub relation tax_court_estimate_of_aggregate_liability(pr: Proceeding, amount: Money) kind empirical {
    label en official "its estimate of the aggregate liability of the parties to the action";
}
pub relation partnership_bond_amount_fixed(pr: Proceeding, amount: Money) kind institutional;
@source(IRC_S7485_B, relation = formalizes, coverage = exact, quote = "Unless otherwise stipulated by the parties, the amount fixed by the Tax Court shall be based upon its estimate of the aggregate liability of the parties to the action.")
pub rule S7485bAmountFromEstimate defeasible {
    label en official "Unless otherwise stipulated by the parties, the amount fixed by the Tax Court shall be based upon its estimate of the aggregate liability of the parties to the action.";
    for pr: Proceeding;
    for estimate: Money;
    when tax_court_estimate_of_aggregate_liability(pr, estimate)
        and not_known(parties_stipulated_bond_any_amount(pr));
    then partnership_bond_amount_fixed(pr, estimate);
}
pub relation parties_stipulated_bond_any_amount(pr: Proceeding) kind institutional;
rule S7485bStipulationBridge strict {
    for pr: Proceeding;
    for amount: Money;
    when parties_stipulated_bond_amount(pr, amount);
    then parties_stipulated_bond_any_amount(pr);
}
@source(IRC_S7485_B, relation = formalizes, coverage = exact, quote = "Unless otherwise stipulated by the parties, the amount fixed by the Tax Court shall be based upon its estimate of the aggregate liability of the parties to the action.")
pub rule S7485bAmountFromStipulation defeasible {
    label en official "Unless otherwise stipulated by the parties, the amount fixed by the Tax Court shall be based upon its estimate of the aggregate liability of the parties to the action.";
    for pr: Proceeding;
    for amount: Money;
    when parties_stipulated_bond_amount(pr, amount);
    then partnership_bond_amount_fixed(pr, amount);
}
pub relation disallowed_deficiency_by_court_of_review(pr: Proceeding, amount: Money) kind empirical {
    label en official "the amount of the deficiency determined by the Tax Court is disallowed in whole or in part by the court of review";
}
pub relation collection_not_stayed_by_bond(pr: Proceeding) kind empirical {
    label en official "assessment or collection has not been stayed by the filing of a bond";
}
pub relation disallowed_amount_collected(pr: Proceeding, amount: Money) kind empirical;
pub relation amount_to_credit_or_refund(pr: Proceeding, amount: Money) kind institutional;
pub relation amount_to_abate(pr: Proceeding, amount: Money) kind institutional;
@source(IRC_S7486, relation = formalizes, coverage = exact, quote = "the amount so disallowed shall be credited or refunded to the taxpayer, without the making of claim therefor")
pub rule S7486CollectedPartCreditedOrRefunded defeasible {
    label en official "the amount so disallowed shall be credited or refunded to the taxpayer, without the making of claim therefor";
    for pr: Proceeding;
    for disallowed: Money;
    for collected: Money;
    when collection_not_stayed_by_bond(pr)
        and disallowed_deficiency_by_court_of_review(pr, disallowed)
        and disallowed_amount_collected(pr, collected)
        and collected >= disallowed;
    then amount_to_credit_or_refund(pr, disallowed);
}
@source(IRC_S7486, relation = formalizes, coverage = exact, quote = "the amount so disallowed shall be credited or refunded to the taxpayer, without the making of claim therefor")
pub rule S7486PartialCollectionRefunded defeasible {
    label en official "the amount so disallowed shall be credited or refunded to the taxpayer, without the making of claim therefor";
    for pr: Proceeding;
    for disallowed: Money;
    for collected: Money;
    when collection_not_stayed_by_bond(pr)
        and disallowed_deficiency_by_court_of_review(pr, disallowed)
        and disallowed_amount_collected(pr, collected)
        and collected < disallowed;
    then amount_to_credit_or_refund(pr, collected);
}
@source(IRC_S7486, relation = formalizes, coverage = exact, quote = "or, if collection has not been made, shall be abated.")
pub rule S7486UncollectedPartAbated defeasible {
    label en official "or, if collection has not been made, shall be abated.";
    for pr: Proceeding;
    for disallowed: Money;
    for collected: Money;
    when collection_not_stayed_by_bond(pr)
        and disallowed_deficiency_by_court_of_review(pr, disallowed)
        and disallowed_amount_collected(pr, collected)
        and collected < disallowed;
    then amount_to_abate(pr, disallowed - collected);
}
pub relation credit_or_refund_made(pr: Proceeding, amount: Money) kind empirical;
pub relation abatement_made(pr: Proceeding, amount: Money) kind empirical;
@source(IRC_S7486, relation = formalizes, coverage = exact, quote = "the amount so disallowed shall be credited or refunded to the taxpayer, without the making of claim therefor")
pub rule S7486CreditOrRefundDutyRule defeasible {
    label en official "the amount so disallowed shall be credited or refunded to the taxpayer, without the making of claim therefor";
    for pr: Proceeding;
    for amount: Money;
    when amount_to_credit_or_refund(pr, amount)
        and amount > 0.00 USD;
    then duty S7486CreditOrRefundDisallowedAmount {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition credit_or_refund_made(pr, amount);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S7486, relation = formalizes, coverage = exact, quote = "or, if collection has not been made, shall be abated.")
pub rule S7486AbatementDutyRule defeasible {
    label en official "or, if collection has not been made, shall be abated.";
    for pr: Proceeding;
    for amount: Money;
    when amount_to_abate(pr, amount)
        and amount > 0.00 USD;
    then duty S7486AbateUncollectedAmount {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition abatement_made(pr, amount);
            window [-infinity, infinity];
        }
    };
}
