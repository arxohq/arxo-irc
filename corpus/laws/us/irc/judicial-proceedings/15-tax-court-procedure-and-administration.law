// Stage 2 — subchapter C, parts IV-VII and remainder: §7451 (fees,
// tolling), §7452 (representation), §7453 (rules), §7455 (service),
// §7456 (powers), §7457 (witness fees), §7458 (hearings), §7459(a),(b),(f)
// (reports), §7460 (divisions), §7461 (public records), §7462 (publication),
// §7463(d)-(f) (small cases), §7464 (bankruptcy trustee), §7466
// (misconduct complaints), §7470-§7475 (administration, fees, employees).
//
// METHOD NOTE. "The Tax Court is authorized to ..." for an act with no
// stated condition (appoint a clerk, fix pay, procure experts) is an
// INSTITUTIONAL fact of authority — `tax_court_authority(action)` — not a
// power: nothing in the text conditions the exercise or makes an invalid
// exercise void. Where the text bounds the authority by a number ($60
// petition fee, $30 registration fee, the district-court fee for
// transcripts) the bound is a validity condition of a POWER. "Shall"
// duties of the court are DUTIES of the `TaxCourt` organ; the closed list
// of contempts (§7456(c): "and none other") is a PROHIBITION. Provisions
// that only set the procedure of an institution (open hearings,
// stenographic reporting) are duties of the court with an open window.
//
// JUDGMENT CALLS AND GAPS. §7451(b)(1) tolls "for the number of days within
// the period of inaccessibility plus an additional 14 days": the tolled
// day count is computed here (`n + 14`), but adding a variable day count
// to a date is not expressible (`add_calendar_period` needs a literal
// count): TECH-GAPS G2910. "As quickly as practicable" (§7459(a)) and
// "reasonable registration fee" (§7470A(b)) are evaluative and carry no
// numeric criterion (EVALUATIVE). Deadlines of §7460(b) use the literal 30
// days.

language "law.core" version "0.2";
package us.irc.judicial_proceedings version "0.1.1";
namespace "urn:us:irc:judicial_proceedings:clir";

use self::{
    IRC_S7451_A,
    IRC_S7451_B,
    IRC_S7452,
    IRC_S7453,
    IRC_S7455,
    IRC_S7456_A,
    IRC_S7456_B,
    IRC_S7456_C,
    IRC_S7457_A,
    IRC_S7457_B,
    IRC_S7458,
    IRC_S7459_A,
    IRC_S7459_B,
    IRC_S7459_F,
    IRC_S7460_A,
    IRC_S7460_B,
    IRC_S7461_A,
    IRC_S7461_B,
    IRC_S7462,
    IRC_S7463_D,
    IRC_S7463_E,
    IRC_S7463_F,
    IRC_S7464,
    IRC_S7466_A,
    IRC_S7466_B,
    IRC_S7466_C,
    IRC_S7470,
    IRC_S7470A_A,
    IRC_S7470A_B,
    IRC_S7471_A,
    IRC_S7471_B,
    IRC_S7472,
    IRC_S7473,
    IRC_S7474,
    IRC_S7475_A,
    IRC_S7475_B,
    Individual,
    Organ,
    Person,
    President,
    Proceeding,
    TaxableYear,
    decision_final_on,
    employment_status_small_case_procedure_applies,
    is_chief_judge,
    member_of_tax_court,
    small_case_ceiling_met,
    small_case_procedure_applies,
    tax_court_proceeding_pending,
};

const MarshalsService: Organ = entity_ref("urn:us:irc:judicial_proceedings:clir#MarshalsService") {
    label en unofficial "the United States Marshals Service (the United States marshal for the district)";
}
const JudicialConference: Organ = entity_ref("urn:us:irc:judicial_proceedings:clir#JudicialConference") {
    label en unofficial "the Judicial Conference of the United States";
}

pub relation tax_court_authority(authorizedAct: Text) kind institutional {
    label en unofficial "the Tax Court is authorized to perform the action (an unconditioned grant of authority)";
}

// ============================================================================
// §7451 — Fees; tolling when a filing location is unavailable
// ============================================================================

pub relation tax_court_fixes_petition_fee(amount: Money) kind empirical;
pub relation petition_fee_within_statutory_limit(amount: Money) kind institutional;
@source(IRC_S7451_A, relation = formalizes, coverage = exact, quote = "The Tax Court is authorized to impose a fee in an amount not in excess of $60 to be fixed by the Tax Court for the filing of any petition.")
pub rule S7451aFeeLimit strict {
    label en official "The Tax Court is authorized to impose a fee in an amount not in excess of $60 to be fixed by the Tax Court for the filing of any petition.";
    for amount: Money;
    when tax_court_fixes_petition_fee(amount)
        and amount <= 60.00 USD;
    then petition_fee_within_statutory_limit(amount);
}
pub relation petition_fee_imposed(amount: Money) kind institutional;
@source(IRC_S7451_A, relation = formalizes, coverage = exact, quote = "The Tax Court is authorized to impose a fee in an amount not in excess of $60 to be fixed by the Tax Court for the filing of any petition.")
pub rule S7451aFeePowerRule strict {
    label en official "The Tax Court is authorized to impose a fee in an amount not in excess of $60 to be fixed by the Tax Court for the filing of any petition.";
    for amount: Money;
    when tax_court_fixes_petition_fee(amount);
    then power S7451aImposePetitionFee {
        holder us.irc.core::TaxCourt;
        exercise tax_court_fixes_petition_fee(amount);
        valid_when petition_fee_within_statutory_limit(amount);
        effect petition_fee_imposed(amount);
    };
}
pub relation filing_location_unavailable_on_due_date(pr: Proceeding) kind empirical {
    label en official "a filing location is inaccessible or otherwise unavailable to the general public on the date a petition is due (including by reason of a lapse in appropriations)";
}
pub relation days_within_period_of_inaccessibility(pr: Proceeding, days: Integer) kind empirical {
    label en official "the number of days within the period of inaccessibility";
}
pub relation petition_period_tolled_days(pr: Proceeding, tolledDays: Integer) kind institutional {
    label en unofficial "the relevant time period for filing the petition is tolled for the days of inaccessibility plus an additional 14 days (the resulting date is TECH-GAPS G2910)";
}
@source(IRC_S7451_B, relation = formalizes, coverage = exact, quote = "the relevant time period for filing such petition shall be tolled for the number of days within the period of inaccessibility plus an additional 14 days.")
pub rule S7451b1Tolling strict {
    label en official "the relevant time period for filing such petition shall be tolled for the number of days within the period of inaccessibility plus an additional 14 days.";
    for pr: Proceeding;
    for days: Integer;
    when filing_location_unavailable_on_due_date(pr)
        and days_within_period_of_inaccessibility(pr, days);
    then petition_period_tolled_days(pr, days + 14);
}
pub relation clerk_office_or_online_portal(location: Text) kind institutional {
    label en unofficial "a filing location: the office of the clerk of the Tax Court or any on-line portal made available by the Tax Court for electronic filing of petitions";
}
@source(IRC_S7451_B, relation = formalizes, coverage = exact, quote = "(A) the office of the clerk of the Tax Court, or")
rule S7451b2AClerkOffice strict {
    label en official "(A) the office of the clerk of the Tax Court, or";
    then clerk_office_or_online_portal("office of the clerk of the Tax Court");
}
@source(IRC_S7451_B, relation = formalizes, coverage = exact, quote = "(B) any on-line portal made available by the Tax Court for electronic filing of petitions.")
rule S7451b2BOnlinePortal strict {
    label en official "(B) any on-line portal made available by the Tax Court for electronic filing of petitions.";
    then clerk_office_or_online_portal("on-line portal for electronic filing of petitions");
}

// ============================================================================
// §7452, §7453, §7455 — Representation, rules of procedure, service
// ============================================================================

pub relation chief_counsel_represents_secretary_before_tax_court(court: Organ) kind institutional;
@source(IRC_S7452, relation = formalizes, coverage = exact, quote = "The Secretary shall be represented by the Chief Counsel for the Internal Revenue Service or his delegate in the same manner before the Tax Court as he has heretofore been represented in proceedings before such Court.")
rule S7452Representation strict {
    label en official "The Secretary shall be represented by the Chief Counsel for the Internal Revenue Service or his delegate in the same manner before the Tax Court as he has heretofore been represented in proceedings before such Court.";
    then chief_counsel_represents_secretary_before_tax_court(us.irc.core::TaxCourt);
}
pub relation tax_court_denies_admission_for_lack_of_profession(applicant: Person) kind empirical {
    label en official "denial of admission to practice before the Tax Court because of failure to be a member of any profession or calling";
}
pub relation qualified_person_seeks_admission(applicant: Person) kind empirical {
    label en official "a qualified person seeks admission to practice before the Tax Court";
}
@source(IRC_S7452, relation = formalizes, coverage = exact, quote = "No qualified person shall be denied admission to practice before the Tax Court because of his failure to be a member of any profession or calling.")
pub rule S7452NoDenialForProfessionRule strict {
    label en official "No qualified person shall be denied admission to practice before the Tax Court because of his failure to be a member of any profession or calling.";
    for applicant: Person;
    when qualified_person_seeks_admission(applicant);
    then prohibition S7452NoDenialOfAdmissionForNonMembership {
        bearer us.irc.core::TaxCourt;
        action tax_court_denies_admission_for_lack_of_profession(applicant);
        window [-infinity, infinity];
    };
}
pub relation federal_rules_of_evidence_govern(pr: Proceeding) kind institutional {
    label en unofficial "the proceedings are conducted in accordance with the rules of practice and procedure the Tax Court prescribes (other than rules of evidence) and the Federal Rules of Evidence";
}
@source(IRC_S7453, relation = formalizes, coverage = exact, quote = "Except in the case of proceedings conducted under section 7436(c) or 7463, the proceedings of the Tax Court and its divisions shall be conducted in accordance with such rules of practice and procedure (other than rules of evidence) as the Tax Court may prescribe and in accordance with the Federal Rules of Evidence.")
pub rule S7453RulesAndEvidence defeasible {
    label en official "Except in the case of proceedings conducted under section 7436(c) or 7463, the proceedings of the Tax Court and its divisions shall be conducted in accordance with such rules of practice and procedure (other than rules of evidence) as the Tax Court may prescribe and in accordance with the Federal Rules of Evidence.";
    for pr: Proceeding;
    when tax_court_proceeding_pending(pr)
        and not_known(small_case_procedure_applies(pr))
        and not_known(employment_status_small_case_procedure_applies(pr));
    then federal_rules_of_evidence_govern(pr);
}
pub relation pleading_or_process_mailed_certified_or_registered(pr: Proceeding, document: Text) kind empirical {
    label en official "the mailing by certified mail or registered mail of any pleading, decision, order, notice, or process in respect of proceedings before the Tax Court";
}
pub relation service_held_sufficient(pr: Proceeding, document: Text) kind institutional;
@source(IRC_S7455, relation = formalizes, coverage = exact, quote = "The mailing by certified mail or registered mail of any pleading, decision, order, notice, or process in respect of proceedings before the Tax Court shall be held sufficient service of such pleading, decision, order, notice, or process.")
pub rule S7455CertifiedMailSufficient strict {
    label en official "The mailing by certified mail or registered mail of any pleading, decision, order, notice, or process in respect of proceedings before the Tax Court shall be held sufficient service of such pleading, decision, order, notice, or process.";
    for pr: Proceeding;
    for document: Text;
    when pleading_or_process_mailed_certified_or_registered(pr, document);
    then service_held_sufficient(pr, document);
}

// ============================================================================
// §7456 — Powers of the Tax Court
// ============================================================================

pub relation may_administer_oaths(person: Individual) kind institutional {
    label en unofficial "the person may administer oaths under §7456(a): a judge or special trial judge, the clerk or deputies, or an employee designated in writing by the chief judge";
}
pub relation is_special_trial_judge(person: Individual) kind empirical {
    label en official "special trial judge of the Tax Court";
}
pub relation is_tax_court_clerk_or_deputy(person: Individual) kind empirical {
    label en official "the clerk of the court or his deputies, as such";
}
pub relation designated_in_writing_by_chief_judge_for_oaths(person: Individual) kind empirical {
    label en official "any other employee of the Tax Court designated in writing for the purpose by the chief judge";
}
@source(IRC_S7456_A, relation = formalizes, coverage = exact, quote = "any judge or special trial judge of the Tax Court, the clerk of the court or his deputies, as such, or any other employee of the Tax Court designated in writing for the purpose by the chief judge, may administer oaths")
pub rule S7456aOathsJudge strict {
    label en official "any judge or special trial judge of the Tax Court, the clerk of the court or his deputies, as such, or any other employee of the Tax Court designated in writing for the purpose by the chief judge, may administer oaths";
    for person: Individual;
    when member_of_tax_court(person);
    then may_administer_oaths(person);
}
@source(IRC_S7456_A, relation = formalizes, coverage = exact, quote = "any judge or special trial judge of the Tax Court, the clerk of the court or his deputies, as such, or any other employee of the Tax Court designated in writing for the purpose by the chief judge, may administer oaths")
pub rule S7456aOathsSpecialTrialJudge strict {
    label en official "any judge or special trial judge of the Tax Court, the clerk of the court or his deputies, as such, or any other employee of the Tax Court designated in writing for the purpose by the chief judge, may administer oaths";
    for person: Individual;
    when is_special_trial_judge(person);
    then may_administer_oaths(person);
}
@source(IRC_S7456_A, relation = formalizes, coverage = exact, quote = "any judge or special trial judge of the Tax Court, the clerk of the court or his deputies, as such, or any other employee of the Tax Court designated in writing for the purpose by the chief judge, may administer oaths")
pub rule S7456aOathsClerk strict {
    label en official "any judge or special trial judge of the Tax Court, the clerk of the court or his deputies, as such, or any other employee of the Tax Court designated in writing for the purpose by the chief judge, may administer oaths";
    for person: Individual;
    when is_tax_court_clerk_or_deputy(person);
    then may_administer_oaths(person);
}
@source(IRC_S7456_A, relation = formalizes, coverage = exact, quote = "any judge or special trial judge of the Tax Court, the clerk of the court or his deputies, as such, or any other employee of the Tax Court designated in writing for the purpose by the chief judge, may administer oaths")
pub rule S7456aOathsDesignated strict {
    label en official "any judge or special trial judge of the Tax Court, the clerk of the court or his deputies, as such, or any other employee of the Tax Court designated in writing for the purpose by the chief judge, may administer oaths";
    for person: Individual;
    when designated_in_writing_by_chief_judge_for_oaths(person);
    then may_administer_oaths(person);
}
pub relation judge_or_special_trial_judge_issues_subpoena(pr: Proceeding, issuer: Individual, target: Person) kind empirical;
pub relation subpoena_ordered_by_court_and_signed(pr: Proceeding, issuer: Individual) kind empirical {
    label en official "by subpoena ordered by the Tax Court or any division thereof and signed by the judge or special trial judge (or by the clerk of the Tax Court or by any other employee of the Tax Court when acting as deputy clerk)";
}
pub relation subpoena_for_testimony_or_evidence_from_anywhere_in_united_states(pr: Proceeding, target: Person) kind institutional;
@source(IRC_S7456_A, relation = formalizes, coverage = exact, quote = "any judge or special trial judge of the Tax Court may examine witnesses and require, by subpoena ordered by the Tax Court or any division thereof and signed by the judge or special trial judge")
pub rule S7456aSubpoenaPowerRule strict {
    label en official "any judge or special trial judge of the Tax Court may examine witnesses and require, by subpoena ordered by the Tax Court or any division thereof and signed by the judge or special trial judge";
    for pr: Proceeding;
    for issuer: Individual;
    for target: Person;
    when judge_or_special_trial_judge_issues_subpoena(pr, issuer, target);
    then power S7456aIssueSubpoena {
        holder issuer;
        over target;
        exercise judge_or_special_trial_judge_issues_subpoena(pr, issuer, target);
        valid_when subpoena_ordered_by_court_and_signed(pr, issuer);
        effect create(subpoena_for_testimony_or_evidence_from_anywhere_in_united_states(pr, target));
    };
}
pub relation deposition_taken_before_designated_individual(pr: Proceeding, taker: Individual) kind empirical {
    label en official "the taking of a deposition before any designated individual competent to administer oaths under this title";
}
pub relation deposition_testimony_reduced_to_writing_and_subscribed(pr: Proceeding, taker: Individual) kind empirical {
    label en official "the testimony shall be reduced to writing by the individual taking the deposition or under his direction and shall then be subscribed by the deponent";
}
@source(IRC_S7456_A, relation = formalizes, coverage = exact, quote = "In the case of a deposition the testimony shall be reduced to writing by the individual taking the deposition or under his direction and shall then be subscribed by the deponent.")
pub rule S7456a2DepositionWritingDutyRule strict {
    label en official "In the case of a deposition the testimony shall be reduced to writing by the individual taking the deposition or under his direction and shall then be subscribed by the deponent.";
    for pr: Proceeding;
    for taker: Individual;
    when deposition_taken_before_designated_individual(pr, taker);
    then duty S7456a2ReduceDepositionToWriting {
        bearer taker;
        goal achievement {
            condition deposition_testimony_reduced_to_writing_and_subscribed(pr, taker);
            window [-infinity, infinity];
        }
    };
}
pub relation foreign_petitioner_class(pr: Proceeding, petitioner: Person) kind empirical {
    label en official "a foreign corporation, foreign trust or estate, or nonresident alien individual, who has filed a petition with the Tax Court";
}
pub relation secretary_motion_and_notice_for_production(pr: Proceeding) kind empirical {
    label en official "upon motion and notice by the Secretary";
}
external judgment relation good_cause_shown_for_production_order(pr: Proceeding) {
    authority TaxCourt;
    label en official "upon good cause shown therefor";
}
pub relation production_order_entered(pr: Proceeding, petitioner: Person) kind empirical;
@source(IRC_S7456_B, relation = formalizes, coverage = exact, quote = "The Tax Court or any division thereof, upon motion and notice by the Secretary, and upon good cause shown therefor, shall order any foreign corporation, foreign trust or estate, or nonresident alien individual, who has filed a petition with the Tax Court, to produce")
pub rule S7456bProductionOrderDutyRule defeasible {
    label en official "The Tax Court or any division thereof, upon motion and notice by the Secretary, and upon good cause shown therefor, shall order any foreign corporation, foreign trust or estate, or nonresident alien individual, who has filed a petition with the Tax Court, to produce";
    for pr: Proceeding;
    for petitioner: Person;
    when foreign_petitioner_class(pr, petitioner)
        and secretary_motion_and_notice_for_production(pr)
        and good_cause_shown_for_production_order(pr);
    then duty S7456bOrderProduction {
        bearer us.irc.core::TaxCourt;
        beneficiary us.irc.core::Secretary;
        goal achievement {
            condition production_order_entered(pr, petitioner);
            window [-infinity, infinity];
        }
    };
}
pub relation petitioner_fails_to_comply_after_reasonable_time(pr: Proceeding, petitioner: Person) kind empirical {
    label en official "the petitioner fails or refuses to comply with any of the provisions of such order, after reasonable time for compliance has been afforded to him";
}
pub relation sanction_order_entered(pr: Proceeding, petitioner: Person) kind empirical {
    label en official "an order striking out pleadings or parts thereof, or dismissing the proceeding or any part thereof, or rendering a judgment by default against the petitioner";
}
pub relation secretary_moves_for_sanction(pr: Proceeding) kind empirical;
@source(IRC_S7456_B, relation = formalizes, coverage = exact, quote = "the Tax Court or any division thereof, upon motion, shall make an order striking out pleadings or parts thereof, or dismissing the proceeding or any part thereof, or rendering a judgment by default against the petitioner.")
pub rule S7456bSanctionDutyRule strict {
    label en official "the Tax Court or any division thereof, upon motion, shall make an order striking out pleadings or parts thereof, or dismissing the proceeding or any part thereof, or rendering a judgment by default against the petitioner.";
    for pr: Proceeding;
    for petitioner: Person;
    when petitioner_fails_to_comply_after_reasonable_time(pr, petitioner)
        and secretary_moves_for_sanction(pr);
    then duty S7456bOrderSanctionForNoncompliance {
        bearer us.irc.core::TaxCourt;
        beneficiary us.irc.core::Secretary;
        goal achievement {
            condition sanction_order_entered(pr, petitioner);
            window [-infinity, infinity];
        }
    };
}
pub relation fiduciary_of_estate_or_trust_is_foreign(trust: Person) kind empirical {
    label en official "an estate or trust, any fiduciary of which is a foreign corporation or nonresident alien individual";
}
pub relation treated_as_foreign_trust_or_estate_for_7456b(trust: Person) kind institutional;
@source(IRC_S7456_B, relation = formalizes, coverage = exact, quote = "For the purpose of this subsection, the term \"foreign trust or estate\" includes an estate or trust, any fiduciary of which is a foreign corporation or nonresident alien individual")
pub rule S7456bForeignTrustOrEstateDefinition strict {
    label en official "For the purpose of this subsection, the term \"foreign trust or estate\" includes an estate or trust, any fiduciary of which is a foreign corporation or nonresident alien individual";
    for trust: Person;
    when fiduciary_of_estate_or_trust_is_foreign(trust);
    then treated_as_foreign_trust_or_estate_for_7456b(trust);
}
pub relation contempt_misbehavior_in_or_near_presence(person: Person) kind empirical {
    label en official "misbehavior of any person in its presence or so near thereto as to obstruct the administration of justice";
}
pub relation contempt_misbehavior_of_officers(person: Person) kind empirical {
    label en official "misbehavior of any of its officers in their official transactions";
}
pub relation contempt_disobedience_of_process(person: Person) kind empirical {
    label en official "disobedience or resistance to its lawful writ, process, order, rule, decree, or command";
}
pub relation contempt_within_7456c(person: Person) kind institutional;
@source(IRC_S7456_C, relation = formalizes, coverage = exact, quote = "(1) misbehavior of any person in its presence or so near thereto as to obstruct the administration of justice;")
pub rule S7456cContemptPresence strict {
    label en official "(1) misbehavior of any person in its presence or so near thereto as to obstruct the administration of justice;";
    for person: Person;
    when contempt_misbehavior_in_or_near_presence(person);
    then contempt_within_7456c(person);
}
@source(IRC_S7456_C, relation = formalizes, coverage = exact, quote = "(2) misbehavior of any of its officers in their official transactions; or")
pub rule S7456cContemptOfficers strict {
    label en official "(2) misbehavior of any of its officers in their official transactions; or";
    for person: Person;
    when contempt_misbehavior_of_officers(person);
    then contempt_within_7456c(person);
}
@source(IRC_S7456_C, relation = formalizes, coverage = exact, quote = "(3) disobedience or resistance to its lawful writ, process, order, rule, decree, or command.")
pub rule S7456cContemptDisobedience strict {
    label en official "(3) disobedience or resistance to its lawful writ, process, order, rule, decree, or command.";
    for person: Person;
    when contempt_disobedience_of_process(person);
    then contempt_within_7456c(person);
}
pub relation tax_court_punishes_contempt_of(person: Person) kind empirical;
pub relation contempt_punished_by_tax_court(person: Person) kind institutional;
@source(IRC_S7456_C, relation = formalizes, coverage = exact, quote = "The Tax Court and each division thereof shall have power to punish by fine or imprisonment, at its discretion, such contempt of its authority, and none other, as—")
pub rule S7456cContemptPowerRule strict {
    label en official "The Tax Court and each division thereof shall have power to punish by fine or imprisonment, at its discretion, such contempt of its authority, and none other, as—";
    for person: Person;
    when tax_court_punishes_contempt_of(person);
    then power S7456cPunishContempt {
        holder us.irc.core::TaxCourt;
        over person;
        exercise tax_court_punishes_contempt_of(person);
        valid_when contempt_within_7456c(person);
        effect contempt_punished_by_tax_court(person);
    };
}
pub relation tax_court_punishes_other_contempt(person: Person) kind empirical {
    label en official "punishment of contempt of its authority other than that described in paragraphs (1) through (3)";
}
@source(IRC_S7456_C, relation = formalizes, coverage = exact, quote = "The Tax Court and each division thereof shall have power to punish by fine or imprisonment, at its discretion, such contempt of its authority, and none other, as—")
pub rule S7456cNoOtherContemptRule strict {
    label en official "The Tax Court and each division thereof shall have power to punish by fine or imprisonment, at its discretion, such contempt of its authority, and none other, as—";
    for person: Person;
    when tax_court_punishes_other_contempt(person);
    then prohibition S7456cNoOtherContempt {
        bearer us.irc.core::TaxCourt;
        action tax_court_punishes_other_contempt(person);
        window [-infinity, infinity];
    };
}
pub relation chief_judge_requests_marshal_attendance(cj: Individual, session: Text) kind empirical;
pub relation marshal_attended_session(session: Text) kind empirical;
@source(IRC_S7456_C, relation = formalizes, coverage = exact, quote = "The United States marshal for any district in which the Tax Court is sitting shall, when requested by the chief judge of the Tax Court, attend any session of the Tax Court in such district")
pub rule S7456cMarshalDutyRule strict {
    label en official "The United States marshal for any district in which the Tax Court is sitting shall, when requested by the chief judge of the Tax Court, attend any session of the Tax Court in such district";
    for cj: Individual;
    for session: Text;
    when chief_judge_requests_marshal_attendance(cj, session);
    then duty S7456cMarshalAttends {
        bearer MarshalsService;
        beneficiary us.irc.core::TaxCourt;
        goal achievement {
            condition marshal_attended_session(session);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S7456_C, relation = formalizes, coverage = exact, quote = "It shall have such assistance in the carrying out of its lawful writ, process, order, rule, decree, or command as is available to a court of the United States.")
rule S7456cAssistance strict {
    label en official "It shall have such assistance in the carrying out of its lawful writ, process, order, rule, decree, or command as is available to a court of the United States.";
    then tax_court_authority("assistance in carrying out its lawful writ, process, order, rule, decree, or command as is available to a court of the United States");
}

// ============================================================================
// §7457 — Witness fees
// ============================================================================

pub relation witness_summoned_or_deposed_under_7456(witness: Person) kind empirical {
    label en official "any witness summoned or whose deposition is taken under section 7456";
}
pub relation witness_fee_and_mileage_same_as_us_courts(witness: Person) kind institutional;
@source(IRC_S7457_A, relation = formalizes, coverage = exact, quote = "Any witness summoned or whose deposition is taken under section 7456 shall receive the same fees and mileage as witnesses in courts of the United States.")
pub rule S7457aSameFeesAsUnitedStatesCourts strict {
    label en official "Any witness summoned or whose deposition is taken under section 7456 shall receive the same fees and mileage as witnesses in courts of the United States.";
    for witness: Person;
    when witness_summoned_or_deposed_under_7456(witness);
    then witness_fee_and_mileage_same_as_us_courts(witness);
}
pub relation witness_for_secretary(witness: Person) kind empirical {
    label en official "witnesses for the Secretary";
}
pub relation witness_fees_paid(witness: Person) kind empirical;
@source(IRC_S7457_B, relation = formalizes, coverage = exact, quote = "In the case of witnesses for the Secretary, such payments shall be made by the Secretary out of any moneys appropriated for the collection of internal revenue taxes, and may be made in advance.")
pub rule S7457b1SecretaryPaysRule strict {
    label en official "In the case of witnesses for the Secretary, such payments shall be made by the Secretary out of any moneys appropriated for the collection of internal revenue taxes, and may be made in advance.";
    for witness: Person;
    when witness_summoned_or_deposed_under_7456(witness)
        and witness_for_secretary(witness);
    then duty S7457b1SecretaryPaysWitnessFees {
        bearer us.irc.core::Secretary;
        beneficiary witness;
        goal achievement {
            condition witness_fees_paid(witness);
            window [-infinity, infinity];
        }
    };
}
pub relation party_at_whose_instance_witness_appears(witness: Person, party: Person) kind empirical {
    label en official "the party at whose instance the witness appears or the deposition is taken";
}
@source(IRC_S7457_B, relation = formalizes, coverage = exact, quote = "In the case of any other witnesses, such payments shall be made, subject to rules prescribed by the Tax Court, by the party at whose instance the witness appears or the deposition is taken.")
pub rule S7457b2PartyPaysRule defeasible {
    label en official "In the case of any other witnesses, such payments shall be made, subject to rules prescribed by the Tax Court, by the party at whose instance the witness appears or the deposition is taken.";
    for witness: Person;
    for party: Person;
    when witness_summoned_or_deposed_under_7456(witness)
        and party_at_whose_instance_witness_appears(witness, party);
    then duty S7457b2PartyPaysWitnessFees {
        bearer party;
        beneficiary witness;
        goal achievement {
            condition witness_fees_paid(witness);
            window [-infinity, infinity];
        }
    };
    unless witness_for_secretary(witness) and party_at_whose_instance_witness_appears(witness, party);
}

// ============================================================================
// §7458, §7459(a),(b),(f), §7460 — Hearings, reports, divisions
// ============================================================================

pub relation proceeding_instituted_before_tax_court(pr: Proceeding) kind empirical {
    label en official "any proceeding instituted before the Tax Court";
}
pub relation notice_and_opportunity_to_be_heard_given(pr: Proceeding, party: Organ) kind empirical;
@source(IRC_S7458, relation = formalizes, coverage = exact, quote = "Notice and opportunity to be heard upon any proceeding instituted before the Tax Court shall be given to the taxpayer and the Secretary.")
pub rule S7458NoticeDutyRule strict {
    label en official "Notice and opportunity to be heard upon any proceeding instituted before the Tax Court shall be given to the taxpayer and the Secretary.";
    for pr: Proceeding;
    when proceeding_instituted_before_tax_court(pr);
    then duty S7458GiveNoticeAndOpportunityToBeHeard {
        bearer us.irc.core::TaxCourt;
        goal achievement {
            condition notice_and_opportunity_to_be_heard_given(pr, us.irc.core::Secretary);
            window [-infinity, infinity];
        }
    };
}
pub relation heard_before_division(pr: Proceeding) kind empirical {
    label en official "an opportunity to be heard upon the proceeding is given before a division of the Tax Court";
}
pub relation chief_judge_specific_order_for_review_hearing(pr: Proceeding) kind empirical {
    label en official "a specific order of the chief judge";
}
pub relation entitled_to_notice_and_hearing_before_court_on_review(pr: Proceeding) kind institutional;
@source(IRC_S7458, relation = formalizes, coverage = exact, quote = "If an opportunity to be heard upon the proceeding is given before a division of the Tax Court, neither the taxpayer nor the Secretary shall be entitled to notice and opportunity to be heard before the Tax Court upon review, except upon a specific order of the chief judge.")
pub rule S7458ReviewHearingOnlyOnOrder strict {
    label en official "If an opportunity to be heard upon the proceeding is given before a division of the Tax Court, neither the taxpayer nor the Secretary shall be entitled to notice and opportunity to be heard before the Tax Court upon review, except upon a specific order of the chief judge.";
    for pr: Proceeding;
    when heard_before_division(pr)
        and chief_judge_specific_order_for_review_hearing(pr);
    then entitled_to_notice_and_hearing_before_court_on_review(pr);
}
pub relation tax_court_hearing_held(pr: Proceeding) kind empirical;
pub relation hearing_open_to_public(pr: Proceeding) kind empirical {
    label en official "Hearings before the Tax Court and its divisions shall be open to the public";
}
@source(IRC_S7458, relation = formalizes, coverage = exact, quote = "Hearings before the Tax Court and its divisions shall be open to the public, and the testimony, and, if the Tax Court so requires, the argument, shall be stenographically reported.")
pub rule S7458OpenHearingsDutyRule strict {
    label en official "Hearings before the Tax Court and its divisions shall be open to the public, and the testimony, and, if the Tax Court so requires, the argument, shall be stenographically reported.";
    for pr: Proceeding;
    when tax_court_hearing_held(pr);
    then duty S7458HoldHearingOpenToPublic {
        bearer us.irc.core::TaxCourt;
        goal maintenance {
            condition hearing_open_to_public(pr);
            window [-infinity, infinity];
        }
    };
}
pub relation testimony_stenographically_reported(pr: Proceeding) kind empirical;
@source(IRC_S7458, relation = formalizes, coverage = exact, quote = "Hearings before the Tax Court and its divisions shall be open to the public, and the testimony, and, if the Tax Court so requires, the argument, shall be stenographically reported.")
pub rule S7458StenographicReportDutyRule strict {
    label en official "Hearings before the Tax Court and its divisions shall be open to the public, and the testimony, and, if the Tax Court so requires, the argument, shall be stenographically reported.";
    for pr: Proceeding;
    when tax_court_hearing_held(pr);
    then duty S7458ReportTestimonyStenographically {
        bearer us.irc.core::TaxCourt;
        goal maintenance {
            condition testimony_stenographically_reported(pr);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S7458, relation = formalizes, coverage = exact, quote = "The Tax Court is authorized to contract (by renewal of contract or otherwise) for the reporting of such hearings, and in such contract to fix the terms and conditions under which transcripts will be supplied by the contractor to the Tax Court and to other persons and agencies.")
rule S7458ContractForReporting strict {
    label en official "The Tax Court is authorized to contract (by renewal of contract or otherwise) for the reporting of such hearings, and in such contract to fix the terms and conditions under which transcripts will be supplied by the contractor to the Tax Court and to other persons and agencies.";
    then tax_court_authority("contract for the reporting of hearings and fix the terms and conditions of transcripts");
}
pub relation decision_made_by_judge_in_accordance_with_report(pr: Proceeding) kind empirical {
    label en official "The decision shall be made by a judge in accordance with the report of the Tax Court";
}
pub relation decision_entered_on(pr: Proceeding, on: Date) kind empirical;
pub relation decision_of_tax_court(pr: Proceeding) kind institutional;
@source(IRC_S7459_A, relation = formalizes, coverage = exact, quote = "The decision shall be made by a judge in accordance with the report of the Tax Court, and such decision so made shall, when entered, be the decision of the Tax Court.")
pub rule S7459aDecisionWhenEntered strict {
    label en official "The decision shall be made by a judge in accordance with the report of the Tax Court, and such decision so made shall, when entered, be the decision of the Tax Court.";
    for pr: Proceeding;
    for on: Date;
    when decision_made_by_judge_in_accordance_with_report(pr)
        and decision_entered_on(pr, on);
    then decision_of_tax_court(pr);
}
pub relation report_includes_findings_or_opinion(pr: Proceeding) kind empirical {
    label en official "its report upon any proceeding its findings of fact or opinion or memorandum opinion";
}
@source(IRC_S7459_B, relation = formalizes, coverage = exact, quote = "It shall be the duty of the Tax Court and of each division to include in its report upon any proceeding its findings of fact or opinion or memorandum opinion.")
pub rule S7459bFindingsDutyRule strict {
    label en official "It shall be the duty of the Tax Court and of each division to include in its report upon any proceeding its findings of fact or opinion or memorandum opinion.";
    for pr: Proceeding;
    when proceeding_instituted_before_tax_court(pr);
    then duty S7459bIncludeFindingsOrOpinion {
        bearer us.irc.core::TaxCourt;
        goal achievement {
            condition report_includes_findings_or_opinion(pr);
            window [-infinity, infinity];
        }
    };
}
pub relation report_findings_in_writing_or_recorded_oral(pr: Proceeding) kind empirical {
    label en official "the Tax Court shall report in writing all its findings of fact, opinions, and memorandum opinions (or, subject to court rule, findings or opinion stated orally and recorded in the transcript)";
}
@source(IRC_S7459_B, relation = formalizes, coverage = exact, quote = "The Tax Court shall report in writing all its findings of fact, opinions, and memorandum opinions.")
pub rule S7459bWrittenReportDutyRule strict {
    label en official "The Tax Court shall report in writing all its findings of fact, opinions, and memorandum opinions.";
    for pr: Proceeding;
    when proceeding_instituted_before_tax_court(pr);
    then duty S7459bReportInWriting {
        bearer us.irc.core::TaxCourt;
        goal achievement {
            condition report_findings_in_writing_or_recorded_oral(pr);
            window [-infinity, infinity];
        }
    };
}
pub relation board_of_tax_appeals_finding_made_on(finding: Text, on: Date) kind empirical {
    label en official "the findings of the Board of Tax Appeals made in connection with any decision prior to February 26, 1926";
}
pub relation board_finding_prima_facie_evidence(finding: Text) kind institutional;
@source(IRC_S7459_F, relation = formalizes, coverage = exact, quote = "The findings of the Board of Tax Appeals made in connection with any decision prior to February 26, 1926, shall, notwithstanding the enactment of the Revenue Act of 1926 (44 Stat. 9), continue to be prima facie evidence of the facts therein stated.")
pub rule S7459fBoardFindingsPrimaFacie strict {
    label en official "The findings of the Board of Tax Appeals made in connection with any decision prior to February 26, 1926, shall, notwithstanding the enactment of the Revenue Act of 1926 (44 Stat. 9), continue to be prima facie evidence of the facts therein stated.";
    for finding: Text;
    for on: Date;
    when board_of_tax_appeals_finding_made_on(finding, on)
        and on < @1926-02-26;
    then board_finding_prima_facie_evidence(finding);
}
pub relation chief_judge_assigns_proceeding_to_division(pr: Proceeding, division: Text) kind empirical {
    label en official "any proceeding instituted before the Tax Court and any motion in connection therewith, assigned to such division by the chief judge";
}
pub relation division_determination_final_disposition_report_made(pr: Proceeding, division: Text) kind empirical;
@source(IRC_S7460_A, relation = formalizes, coverage = exact, quote = "and shall make a report of any such determination which constitutes its final disposition of the proceeding.")
pub rule S7460aDivisionReportDutyRule strict {
    label en official "and shall make a report of any such determination which constitutes its final disposition of the proceeding.";
    for pr: Proceeding;
    for division: Text;
    when chief_judge_assigns_proceeding_to_division(pr, division);
    then duty S7460aDivisionHearsAndReports {
        bearer us.irc.core::TaxCourt;
        goal achievement {
            condition division_determination_final_disposition_report_made(pr, division);
            window [-infinity, infinity];
        }
    };
}
pub relation division_reports_on(pr: Proceeding, on: Date) kind empirical;
pub relation chief_judge_directs_review_on(pr: Proceeding, on: Date) kind empirical {
    label en official "the chief judge has directed that such report shall be reviewed by the Tax Court";
}
pub relation division_report_becomes_tax_court_report_on(pr: Proceeding, on: Date) kind institutional;
@source(IRC_S7460_B, relation = formalizes, coverage = exact, quote = "The report of the division shall become the report of the Tax Court within 30 days after such report by the division, unless within such period the chief judge has directed that such report shall be reviewed by the Tax Court.")
pub rule S7460bBecomesCourtReport defeasible {
    label en official "The report of the division shall become the report of the Tax Court within 30 days after such report by the division, unless within such period the chief judge has directed that such report shall be reviewed by the Tax Court.";
    for pr: Proceeding;
    for reportedOn: Date;
    for reviewOn: Date;
    when division_reports_on(pr, reportedOn);
    then division_report_becomes_tax_court_report_on(pr, add_calendar_period(reportedOn, 30 calendar_day));
    unless chief_judge_directs_review_on(pr, reviewOn)
        and division_reports_on(pr, reportedOn)
        and reviewOn <= add_calendar_period(reportedOn, 30 calendar_day);
}
pub relation division_report_part_of_record(pr: Proceeding) kind institutional;
pub relation division_report_in_record_when_reviewed(pr: Proceeding) kind empirical;
@source(IRC_S7460_B, relation = formalizes, coverage = exact, quote = "The report of a division shall not be a part of the record in any case in which the chief judge directs that such report shall be reviewed by the Tax Court.")
pub rule S7460bReportNotInRecordWhenReviewed defeasible {
    label en official "The report of a division shall not be a part of the record in any case in which the chief judge directs that such report shall be reviewed by the Tax Court.";
    for pr: Proceeding;
    for reviewOn: Date;
    when division_report_in_record_when_reviewed(pr);
    then division_report_part_of_record(pr);
    unless chief_judge_directs_review_on(pr, reviewOn) and division_report_in_record_when_reviewed(pr);
}

// ============================================================================
// §7461, §7462 — Public records, publication
// ============================================================================

pub relation tax_court_report_or_evidence(item: Text) kind empirical {
    label en official "all reports of the Tax Court and all evidence received by the Tax Court and its divisions, including a transcript of the stenographic report of the hearings";
}
pub relation item_sealed_under_7461b1(item: Text) kind empirical;
pub relation public_record_open_to_inspection(item: Text) kind institutional;
@source(IRC_S7461_A, relation = formalizes, coverage = exact, quote = "all reports of the Tax Court and all evidence received by the Tax Court and its divisions, including a transcript of the stenographic report of the hearings, shall be public records open to the inspection of the public.")
pub rule S7461aPublicRecords defeasible {
    label en official "all reports of the Tax Court and all evidence received by the Tax Court and its divisions, including a transcript of the stenographic report of the hearings, shall be public records open to the inspection of the public.";
    for item: Text;
    when tax_court_report_or_evidence(item);
    then public_record_open_to_inspection(item);
    unless item_sealed_under_7461b1(item) and tax_court_report_or_evidence(item);
}
external judgment relation seal_necessary_to_prevent_disclosure_of_confidential_information(item: Text) {
    authority TaxCourt;
    label en official "any provision which is necessary to prevent the disclosure of trade secrets or other confidential information";
}
pub relation tax_court_places_item_under_seal(item: Text) kind empirical;
pub relation item_placed_under_seal(item: Text) kind institutional;
@source(IRC_S7461_B, relation = formalizes, coverage = exact, quote = "The Tax Court may make any provision which is necessary to prevent the disclosure of trade secrets or other confidential information, including a provision that any document or information be placed under seal to be opened only as directed by the court.")
pub rule S7461b1SealPowerRule defeasible {
    label en official "The Tax Court may make any provision which is necessary to prevent the disclosure of trade secrets or other confidential information, including a provision that any document or information be placed under seal to be opened only as directed by the court.";
    for item: Text;
    when tax_court_places_item_under_seal(item);
    then power S7461b1PlaceUnderSeal {
        holder us.irc.core::TaxCourt;
        exercise tax_court_places_item_under_seal(item);
        valid_when seal_necessary_to_prevent_disclosure_of_confidential_information(item);
        effect item_placed_under_seal(item);
    };
}
pub relation motion_for_withdrawal_of_exhibits(pr: Proceeding, movant: Person) kind empirical;
pub relation tax_court_permits_withdrawal_of_exhibits(pr: Proceeding, movant: Person) kind empirical;
pub relation withdrawal_of_exhibits_permitted(pr: Proceeding, movant: Person) kind institutional;
pub relation exhibits_withdrawal_conditions_met(pr: Proceeding, movant: Person) kind institutional {
    label en unofficial "the decision of the Tax Court has become final and the taxpayer or the Secretary has moved for withdrawal";
}
@source(IRC_S7461_B, relation = formalizes, coverage = exact, quote = "After the decision of the Tax Court in any proceeding has become final, the Tax Court may, upon motion of the taxpayer or the Secretary, permit the withdrawal by the party entitled thereto of originals of books, documents, and records")
pub rule S7461b2Conditions defeasible {
    label en official "After the decision of the Tax Court in any proceeding has become final, the Tax Court may, upon motion of the taxpayer or the Secretary, permit the withdrawal by the party entitled thereto of originals of books, documents, and records";
    for pr: Proceeding;
    for movant: Person;
    for finalOn: Date;
    when decision_final_on(pr, finalOn)
        and motion_for_withdrawal_of_exhibits(pr, movant);
    then exhibits_withdrawal_conditions_met(pr, movant);
}
@source(IRC_S7461_B, relation = formalizes, coverage = exact, quote = "After the decision of the Tax Court in any proceeding has become final, the Tax Court may, upon motion of the taxpayer or the Secretary, permit the withdrawal by the party entitled thereto of originals of books, documents, and records")
pub rule S7461b2PowerRule defeasible {
    label en official "After the decision of the Tax Court in any proceeding has become final, the Tax Court may, upon motion of the taxpayer or the Secretary, permit the withdrawal by the party entitled thereto of originals of books, documents, and records";
    for pr: Proceeding;
    for movant: Person;
    when tax_court_permits_withdrawal_of_exhibits(pr, movant);
    then power S7461b2PermitWithdrawal {
        holder us.irc.core::TaxCourt;
        over movant;
        exercise tax_court_permits_withdrawal_of_exhibits(pr, movant);
        valid_when exhibits_withdrawal_conditions_met(pr, movant);
        effect withdrawal_of_exhibits_permitted(pr, movant);
    };
}
pub relation tax_court_provides_for_publication_of_reports(court: Organ) kind empirical {
    label en official "The Tax Court shall provide for the publication of its reports at the Government Publishing Office in such form and manner as may be best adapted for public information and use";
}
pub relation tax_court_publication_arranged(court: Organ) kind empirical;
@source(IRC_S7462, relation = formalizes, coverage = exact, quote = "The Tax Court shall provide for the publication of its reports at the Government Publishing Office in such form and manner as may be best adapted for public information and use")
pub rule S7462PublicationDutyRule strict {
    label en official "The Tax Court shall provide for the publication of its reports at the Government Publishing Office in such form and manner as may be best adapted for public information and use";
    for court: Organ;
    when tax_court_provides_for_publication_of_reports(court);
    then duty S7462ProvideForPublication {
        bearer us.irc.core::TaxCourt;
        goal achievement {
            condition tax_court_publication_arranged(us.irc.core::TaxCourt);
            window [-infinity, infinity];
        }
    };
}
pub relation authorized_publication_of_report(report: Text) kind empirical;
pub relation publication_competent_evidence_without_proof(report: Text) kind institutional;
@source(IRC_S7462, relation = formalizes, coverage = exact, quote = "and such authorized publication shall be competent evidence of the reports of the Tax Court therein contained in all courts of the United States and of the several States without any further proof or authentication thereof.")
pub rule S7462PublicationIsCompetentEvidence strict {
    label en official "and such authorized publication shall be competent evidence of the reports of the Tax Court therein contained in all courts of the United States and of the several States without any further proof or authentication thereof.";
    for report: Text;
    when authorized_publication_of_report(report);
    then publication_competent_evidence_without_proof(report);
}

// ============================================================================
// §7463(d)-(f) — Small cases: discontinuance, amounts, additional cases
// ============================================================================

pub relation discontinuance_requested(pr: Proceeding, requester: Person) kind empirical {
    label en official "the taxpayer or the Secretary may request that further proceedings under this section in such case be discontinued";
}
external judgment relation reasonable_grounds_amount_exceeds_jurisdictional_amount(pr: Proceeding) {
    authority TaxCourt;
    label en official "there are reasonable grounds for believing that the amount of the deficiency placed in dispute, or the amount of an overpayment, exceeds the applicable jurisdictional amount described in subsection (a)";
}
external judgment relation excess_large_enough_to_justify_discontinuance(pr: Proceeding) {
    authority TaxCourt;
    label en official "the amount of such excess is large enough to justify granting such request";
}
pub relation decision_not_yet_final_on(pr: Proceeding, on: Date) kind empirical;
pub relation discontinuance_grounds(pr: Proceeding) kind institutional;
@source(IRC_S7463_D, relation = formalizes, coverage = exact, quote = "The Tax Court, or the division thereof hearing such case, may, if it finds that (1) there are reasonable grounds for believing that the amount of the deficiency placed in dispute, or the amount of an overpayment, exceeds the applicable jurisdictional amount described in subsection (a), and (2) the amount of such excess is large enough to justify granting such request, discontinue further proceedings in such case under this section.")
pub rule S7463dGrounds defeasible {
    label en official "The Tax Court, or the division thereof hearing such case, may, if it finds that (1) there are reasonable grounds for believing that the amount of the deficiency placed in dispute, or the amount of an overpayment, exceeds the applicable jurisdictional amount described in subsection (a), and (2) the amount of such excess is large enough to justify granting such request, discontinue further proceedings in such case under this section.";
    for pr: Proceeding;
    for requester: Person;
    when small_case_procedure_applies(pr)
        and discontinuance_requested(pr, requester)
        and reasonable_grounds_amount_exceeds_jurisdictional_amount(pr)
        and excess_large_enough_to_justify_discontinuance(pr);
    then discontinuance_grounds(pr);
}
pub relation tax_court_discontinues_small_case_proceedings(pr: Proceeding) kind empirical;
pub relation small_case_proceedings_discontinued(pr: Proceeding) kind institutional;
@source(IRC_S7463_D, relation = formalizes, coverage = exact, quote = "discontinue further proceedings in such case under this section.")
pub rule S7463dDiscontinuancePowerRule defeasible {
    label en official "discontinue further proceedings in such case under this section.";
    for pr: Proceeding;
    when tax_court_discontinues_small_case_proceedings(pr);
    then power S7463dDiscontinue {
        holder us.irc.core::TaxCourt;
        exercise tax_court_discontinues_small_case_proceedings(pr);
        valid_when discontinuance_grounds(pr);
        effect small_case_proceedings_discontinued(pr);
    };
}
pub relation regular_procedure_6214a_6512b_applies(pr: Proceeding) kind institutional;
@source(IRC_S7463_D, relation = formalizes, coverage = exact, quote = "Upon any such discontinuance, proceedings in such case shall be conducted in the same manner as cases to which the provisions of sections 6214(a) and 6512(b) apply.")
pub rule S7463dAfterDiscontinuance defeasible {
    label en official "Upon any such discontinuance, proceedings in such case shall be conducted in the same manner as cases to which the provisions of sections 6214(a) and 6512(b) apply.";
    for pr: Proceeding;
    when small_case_proceedings_discontinued(pr);
    then regular_procedure_6214a_6512b_applies(pr);
}
pub relation deficiency_placed_in_dispute_before_additions(pr: Proceeding, y: TaxableYear, deficiency: Money) kind empirical;
pub relation chapter_68_additions_under_subchapter_B_ch63(pr: Proceeding, y: TaxableYear, additions: Money) kind empirical {
    label en official "additions to the tax, additional amounts, and penalties imposed by chapter 68, to the extent that the procedures described in subchapter B of chapter 63 apply";
}
pub relation deficiency_in_dispute_including_additions(pr: Proceeding, y: TaxableYear, total: Money) kind institutional;
@source(IRC_S7463_E, relation = formalizes, coverage = exact, quote = "For purposes of this section, the amount of any deficiency placed in dispute includes additions to the tax, additional amounts, and penalties imposed by chapter 68, to the extent that the procedures described in subchapter B of chapter 63 apply.")
pub rule S7463eDeficiencyIncludesAdditions strict {
    label en official "For purposes of this section, the amount of any deficiency placed in dispute includes additions to the tax, additional amounts, and penalties imposed by chapter 68, to the extent that the procedures described in subchapter B of chapter 63 apply.";
    for pr: Proceeding;
    for y: TaxableYear;
    for deficiency: Money;
    for additions: Money;
    when deficiency_placed_in_dispute_before_additions(pr, y, deficiency)
        and chapter_68_additions_under_subchapter_B_ch63(pr, y, additions);
    then deficiency_in_dispute_including_additions(pr, y, deficiency + additions);
}
pub relation section_6015e_relief_sought(pr: Proceeding, y: TaxableYear, amount: Money) kind empirical {
    label en official "a petition to the Tax Court under section 6015(e) in which the amount of relief sought does not exceed $50,000";
}
pub relation section_6330d1A_unpaid_tax(pr: Proceeding, y: TaxableYear, amount: Money) kind empirical {
    label en official "an appeal under section 6330(d)(1)(A) to the Tax Court of a determination in which the unpaid tax does not exceed $50,000";
}
pub relation section_6404h_abatement_sought(pr: Proceeding, y: TaxableYear, amount: Money) kind empirical {
    label en official "a petition to the Tax Court under section 6404(h) in which the amount of the abatement sought does not exceed $50,000";
}
@source(IRC_S7463_F, relation = formalizes, coverage = exact, quote = "(1) a petition to the Tax Court under section 6015(e) in which the amount of relief sought does not exceed $50,000,")
pub rule S7463f1InnocentSpouseCeiling defeasible {
    label en official "(1) a petition to the Tax Court under section 6015(e) in which the amount of relief sought does not exceed $50,000,";
    for pr: Proceeding;
    for y: TaxableYear;
    for amount: Money;
    when section_6015e_relief_sought(pr, y, amount)
        and amount <= 50000.00 USD;
    then small_case_ceiling_met(pr, y);
}
@source(IRC_S7463_F, relation = formalizes, coverage = exact, quote = "(2) an appeal under section 6330(d)(1)(A) to the Tax Court of a determination in which the unpaid tax does not exceed $50,000, and")
pub rule S7463f2CollectionDueProcessCeiling defeasible {
    label en official "(2) an appeal under section 6330(d)(1)(A) to the Tax Court of a determination in which the unpaid tax does not exceed $50,000, and";
    for pr: Proceeding;
    for y: TaxableYear;
    for amount: Money;
    when section_6330d1A_unpaid_tax(pr, y, amount)
        and amount <= 50000.00 USD;
    then small_case_ceiling_met(pr, y);
}
@source(IRC_S7463_F, relation = formalizes, coverage = exact, quote = "(3) a petition to the Tax Court under section 6404(h) in which the amount of the abatement sought does not exceed $50,000.")
pub rule S7463f3InterestAbatementCeiling defeasible {
    label en official "(3) a petition to the Tax Court under section 6404(h) in which the amount of the abatement sought does not exceed $50,000.";
    for pr: Proceeding;
    for y: TaxableYear;
    for amount: Money;
    when section_6404h_abatement_sought(pr, y, amount)
        and amount <= 50000.00 USD;
    then small_case_ceiling_met(pr, y);
}

// ============================================================================
// §7464, §7466 — Trustee intervention; misconduct complaints
// ============================================================================

pub relation trustee_in_title_11_case_for_debtor(trustee: Person, debtor: Person) kind empirical {
    label en official "the trustee of the debtor's estate in any case under title 11 of the United States Code";
}
pub relation debtor_is_party_to_tax_court_proceeding(pr: Proceeding, debtor: Person) kind empirical {
    label en official "any proceeding before the Tax Court to which the debtor is a party";
}
pub relation trustee_intervenes_in_tax_court_proceeding(pr: Proceeding, trustee: Person, debtor: Person) kind empirical;
pub relation trustee_intervention_conditions_met(pr: Proceeding, trustee: Person, debtor: Person) kind institutional;
@source(IRC_S7464, relation = formalizes, coverage = exact, quote = "The trustee of the debtor's estate in any case under title 11 of the United States Code may intervene, on behalf of the debtor's estate, in any proceeding before the Tax Court to which the debtor is a party.")
pub rule S7464Conditions strict {
    label en official "The trustee of the debtor's estate in any case under title 11 of the United States Code may intervene, on behalf of the debtor's estate, in any proceeding before the Tax Court to which the debtor is a party.";
    for pr: Proceeding;
    for trustee: Person;
    for debtor: Person;
    when trustee_in_title_11_case_for_debtor(trustee, debtor)
        and debtor_is_party_to_tax_court_proceeding(pr, debtor);
    then trustee_intervention_conditions_met(pr, trustee, debtor);
}
pub relation trustee_intervention_permitted(pr: Proceeding, debtor: Person) kind institutional;
@source(IRC_S7464, relation = formalizes, coverage = exact, quote = "The trustee of the debtor's estate in any case under title 11 of the United States Code may intervene, on behalf of the debtor's estate, in any proceeding before the Tax Court to which the debtor is a party.")
pub rule S7464InterventionPowerRule strict {
    label en official "The trustee of the debtor's estate in any case under title 11 of the United States Code may intervene, on behalf of the debtor's estate, in any proceeding before the Tax Court to which the debtor is a party.";
    for pr: Proceeding;
    for trustee: Person;
    for debtor: Person;
    when trustee_intervenes_in_tax_court_proceeding(pr, trustee, debtor);
    then power S7464TrusteeIntervenes {
        holder trustee;
        exercise trustee_intervenes_in_tax_court_proceeding(pr, trustee, debtor);
        valid_when trustee_intervention_conditions_met(pr, trustee, debtor);
        effect trustee_intervention_permitted(pr, debtor);
    };
}
pub relation complaint_rules_prescribed_by_tax_court(court: Organ) kind empirical {
    label en official "rules, consistent with the provisions of chapter 16 of title 28, United States Code, establishing procedures for the filing of complaints with respect to the conduct of any judge or special trial judge of the Tax Court and for the investigation and resolution of such complaints";
}
@source(IRC_S7466_A, relation = formalizes, coverage = exact, quote = "The Tax Court shall prescribe rules, consistent with the provisions of chapter 16 of title 28, United States Code, establishing procedures for the filing of complaints with respect to the conduct of any judge or special trial judge of the Tax Court and for the investigation and resolution of such complaints.")
pub rule S7466aRulesDutyRule strict {
    label en official "The Tax Court shall prescribe rules, consistent with the provisions of chapter 16 of title 28, United States Code, establishing procedures for the filing of complaints with respect to the conduct of any judge or special trial judge of the Tax Court and for the investigation and resolution of such complaints.";
    then duty S7466aPrescribeComplaintRules {
        bearer us.irc.core::TaxCourt;
        goal maintenance {
            condition complaint_rules_prescribed_by_tax_court(us.irc.core::TaxCourt);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S7466_A, relation = formalizes, coverage = exact, quote = "In investigating and taking action with respect to any such complaint, the Tax Court shall have the powers granted to a judicial council under such chapter.")
rule S7466aJudicialCouncilPowers strict {
    label en official "In investigating and taking action with respect to any such complaint, the Tax Court shall have the powers granted to a judicial council under such chapter.";
    then tax_court_authority("exercise the powers granted to a judicial council under chapter 16 of title 28 in investigating complaints against its judges");
}
pub relation conference_certifies_complaint_to_president(complaint: Text) kind empirical;
pub relation complaint_transmitted_to_president_for_7443f(complaint: Text) kind empirical;
@source(IRC_S7466_B, relation = formalizes, coverage = exact, quote = "and certification and transmittal by the Conference of any complaint shall be made to the President for consideration under section 7443(f).")
pub rule S7466bCertificationDutyRule strict {
    label en official "and certification and transmittal by the Conference of any complaint shall be made to the President for consideration under section 7443(f).";
    for complaint: Text;
    when conference_certifies_complaint_to_president(complaint);
    then duty S7466bTransmitToPresident {
        bearer JudicialConference;
        beneficiary President;
        goal achievement {
            condition complaint_transmitted_to_president_for_7443f(complaint);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S7466_C, relation = formalizes, coverage = exact, quote = "In conducting hearings pursuant to subsection (a), the Tax Court may exercise the authority provided under section 1821 of title 28, United States Code, to pay the fees and allowances described in that section.")
rule S7466c1FeesAndAllowances strict {
    label en official "In conducting hearings pursuant to subsection (a), the Tax Court may exercise the authority provided under section 1821 of title 28, United States Code, to pay the fees and allowances described in that section.";
    then tax_court_authority("pay the fees and allowances described in section 1821 of title 28 in hearings on complaints");
}
@source(IRC_S7466_C, relation = formalizes, coverage = exact, quote = "The Tax Court shall have the power provided under section 361 of such title 28 to award reimbursement for the reasonable expenses described in that section.")
rule S7466c2Reimbursement strict {
    label en official "The Tax Court shall have the power provided under section 361 of such title 28 to award reimbursement for the reasonable expenses described in that section.";
    then tax_court_authority("award reimbursement for the reasonable expenses described in section 361 of title 28");
}

// ============================================================================
// §§7470–7475 — Administration, conferences, personnel, expenditures, fees
// ============================================================================

@source(IRC_S7470, relation = formalizes, coverage = exact, quote = "the Tax Court may exercise, for purposes of management, administration, and expenditure of funds of the Court, the authorities provided for such purposes by any provision of law (including any limitation with respect to such provision of law) applicable to a court of the United States (as that term is defined in section 451 of title 28, United States Code), except to the extent that such provision of law is inconsistent with a provision of this subchapter.")
rule S7470Administration strict {
    label en official "the Tax Court may exercise, for purposes of management, administration, and expenditure of funds of the Court, the authorities provided for such purposes by any provision of law (including any limitation with respect to such provision of law) applicable to a court of the United States (as that term is defined in section 451 of title 28, United States Code), except to the extent that such provision of law is inconsistent with a provision of this subchapter.";
    then tax_court_authority("exercise for management, administration and expenditure of funds the authorities applicable to a court of the United States");
}
pub relation chief_judge_summons_annual_conference(cj: Individual, on: Date) kind empirical;
pub relation annual_judicial_conference_summoned(on: Date) kind institutional;
@source(IRC_S7470A_A, relation = formalizes, coverage = exact, quote = "The chief judge may summon the judges and special trial judges of the Tax Court to an annual judicial conference, at such time and place as the chief judge shall designate")
pub rule S7470AaSummonPowerRule strict {
    label en official "The chief judge may summon the judges and special trial judges of the Tax Court to an annual judicial conference, at such time and place as the chief judge shall designate";
    for cj: Individual;
    for on: Date;
    when chief_judge_summons_annual_conference(cj, on);
    then power S7470AaSummonConference {
        holder cj;
        exercise chief_judge_summons_annual_conference(cj, on);
        valid_when is_chief_judge(cj);
        effect annual_judicial_conference_summoned(on);
    };
}
pub relation conference_participation_rules_provided(court: Organ) kind empirical {
    label en official "The Tax Court shall provide by its rules for representation and active participation at such conferences by persons admitted to practice before the Tax Court and by other persons active in the legal profession";
}
@source(IRC_S7470A_A, relation = formalizes, coverage = exact, quote = "The Tax Court shall provide by its rules for representation and active participation at such conferences by persons admitted to practice before the Tax Court and by other persons active in the legal profession.")
pub rule S7470AaParticipationRulesDutyRule strict {
    label en official "The Tax Court shall provide by its rules for representation and active participation at such conferences by persons admitted to practice before the Tax Court and by other persons active in the legal profession.";
    for cj: Individual;
    for on: Date;
    when annual_judicial_conference_summoned(on)
        and is_chief_judge(cj);
    then duty S7470AaProvideParticipationRules {
        bearer us.irc.core::TaxCourt;
        goal maintenance {
            condition conference_participation_rules_provided(us.irc.core::TaxCourt);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S7470A_B, relation = formalizes, coverage = exact, quote = "The Tax Court may impose a reasonable registration fee on persons (other than judges and special trial judges of the Tax Court) participating at judicial conferences convened pursuant to subsection (a).")
rule S7470AbRegistrationFee strict {
    label en official "The Tax Court may impose a reasonable registration fee on persons (other than judges and special trial judges of the Tax Court) participating at judicial conferences convened pursuant to subsection (a).";
    then tax_court_authority("impose a reasonable registration fee on persons participating at judicial conferences other than its judges and special trial judges");
}
@source(IRC_S7471_A, relation = formalizes, coverage = exact, quote = "The Tax Court may appoint a clerk without regard to the provisions of title 5, United States Code, governing appointments in the competitive service.")
rule S7471a1ClerkAppointment strict {
    label en official "The Tax Court may appoint a clerk without regard to the provisions of title 5, United States Code, governing appointments in the competitive service.";
    then tax_court_authority("appoint a clerk without regard to the competitive service provisions of title 5");
}
@source(IRC_S7471_A, relation = formalizes, coverage = exact, quote = "The judges and special trial judges of the Tax Court may appoint employees, in such numbers as the Tax Court may approve, without regard to the provisions of title 5, United States Code, governing appointments in the competitive service.")
rule S7471a2AJudgeEmployees strict {
    label en official "The judges and special trial judges of the Tax Court may appoint employees, in such numbers as the Tax Court may approve, without regard to the provisions of title 5, United States Code, governing appointments in the competitive service.";
    then tax_court_authority("judges and special trial judges appoint employees in the numbers the Tax Court approves");
}
@source(IRC_S7471_A, relation = formalizes, coverage = exact, quote = "The Tax Court may appoint necessary employees without regard to the provisions of title 5, United States Code, governing appointments in the competitive service.")
rule S7471a3OtherEmployees strict {
    label en official "The Tax Court may appoint necessary employees without regard to the provisions of title 5, United States Code, governing appointments in the competitive service.";
    then tax_court_authority("appoint necessary employees without regard to the competitive service provisions of title 5");
}
@source(IRC_S7471_A, relation = formalizes, coverage = exact, quote = "The Tax Court may fix and adjust the compensation for the clerk and other employees of the Tax Court without regard to the provisions of chapter 51, subchapter III of chapter 53, or section 5373 of title 5, United States Code.")
rule S7471a4Pay strict {
    label en official "The Tax Court may fix and adjust the compensation for the clerk and other employees of the Tax Court without regard to the provisions of chapter 51, subchapter III of chapter 53, or section 5373 of title 5, United States Code.";
    then tax_court_authority("fix and adjust the compensation of the clerk and other employees");
}
@source(IRC_S7471_A, relation = formalizes, coverage = exact, quote = "The Tax Court may establish programs for employee evaluations, incentive awards, flexible work schedules, premium pay, and resolution of employee grievances.")
rule S7471a5Programs strict {
    label en official "The Tax Court may establish programs for employee evaluations, incentive awards, flexible work schedules, premium pay, and resolution of employee grievances.";
    then tax_court_authority("establish programs for employee evaluations, incentive awards, flexible work schedules, premium pay, and resolution of employee grievances");
}
@source(IRC_S7471_A, relation = formalizes, coverage = exact, quote = "The Tax Court may procure the services of experts and consultants under section 3109 of title 5, United States Code.")
rule S7471a7Experts strict {
    label en official "The Tax Court may procure the services of experts and consultants under section 3109 of title 5, United States Code.";
    then tax_court_authority("procure the services of experts and consultants under section 3109 of title 5");
}
pub relation discrimination_prohibited_by_tax_court_rule(court: Organ) kind empirical {
    label en official "prohibit discrimination on the basis of race, color, religion, age, sex, national origin, political affiliation, marital status, or handicapping condition";
}
@source(IRC_S7471_A, relation = formalizes, coverage = exact, quote = "(A) prohibit discrimination on the basis of race, color, religion, age, sex, national origin, political affiliation, marital status, or handicapping condition; and")
pub rule S7471a6ADiscriminationProhibitionDutyRule strict {
    label en official "(A) prohibit discrimination on the basis of race, color, religion, age, sex, national origin, political affiliation, marital status, or handicapping condition; and";
    then duty S7471a6AProhibitDiscrimination {
        bearer us.irc.core::TaxCourt;
        goal maintenance {
            condition discrimination_prohibited_by_tax_court_rule(us.irc.core::TaxCourt);
            window [-infinity, infinity];
        }
    };
}
pub relation discrimination_complaint_procedures_promulgated(court: Organ) kind empirical {
    label en official "promulgate procedures for resolving complaints of discrimination by employees and applicants for employment";
}
@source(IRC_S7471_A, relation = formalizes, coverage = exact, quote = "(B) promulgate procedures for resolving complaints of discrimination by employees and applicants for employment.")
pub rule S7471a6BProceduresDutyRule strict {
    label en official "(B) promulgate procedures for resolving complaints of discrimination by employees and applicants for employment.";
    then duty S7471a6BPromulgateComplaintProcedures {
        bearer us.irc.core::TaxCourt;
        goal maintenance {
            condition discrimination_complaint_procedures_promulgated(us.irc.core::TaxCourt);
            window [-infinity, infinity];
        }
    };
}
pub relation employee_continuous_nontemporary_service_years(employee: Individual, years: Integer) kind empirical {
    label en official "completed at least 1 year of continuous service under a non-temporary appointment with the Tax Court";
}
pub relation employee_has_competitive_status(employee: Individual) kind institutional;
@source(IRC_S7471_A, relation = formalizes, coverage = exact, quote = "any employee of the Tax Court who has completed at least 1 year of continuous service under a non-temporary appointment with the Tax Court acquires a competitive status for appointment to any position in the competitive service for which the employee possesses the required qualifications.")
pub rule S7471a9CompetitiveStatus strict {
    label en official "any employee of the Tax Court who has completed at least 1 year of continuous service under a non-temporary appointment with the Tax Court acquires a competitive status for appointment to any position in the competitive service for which the employee possesses the required qualifications.";
    for employee: Individual;
    for years: Integer;
    when employee_continuous_nontemporary_service_years(employee, years)
        and years >= 1;
    then employee_has_competitive_status(employee);
}
pub relation personnel_system_includes_merit_principles(court: Organ) kind empirical {
    label en official "Any personnel management system of the Tax Court shall include the principles set forth in section 2301(b) of title 5, prohibit personnel practices prohibited under section 2302(b) of title 5, and provide preference for preference eligibles consistent with the executive branch";
}
@source(IRC_S7471_A, relation = formalizes, coverage = exact, quote = "Any personnel management system of the Tax Court shall—")
pub rule S7471a10PersonnelSystemDutyRule strict {
    label en official "Any personnel management system of the Tax Court shall—";
    then duty S7471a10PersonnelSystemMeritPrinciples {
        bearer us.irc.core::TaxCourt;
        goal maintenance {
            condition personnel_system_includes_merit_principles(us.irc.core::TaxCourt);
            window [-infinity, infinity];
        }
    };
}
pub relation employee_travel_expenses_incurred(employee: Individual) kind empirical {
    label en official "necessary traveling expenses, and expenses for subsistence while traveling on duty and away from their designated stations, as provided in chapter 57 of title 5";
}
pub relation employee_travel_expenses_paid(employee: Individual) kind empirical;
@source(IRC_S7471_B, relation = formalizes, coverage = exact, quote = "The employees of the Tax Court shall receive their necessary traveling expenses, and expenses for subsistence while traveling on duty and away from their designated stations, as provided in chapter 57 of title 5, United States Code.")
pub rule S7471bTravelExpensesDutyRule strict {
    label en official "The employees of the Tax Court shall receive their necessary traveling expenses, and expenses for subsistence while traveling on duty and away from their designated stations, as provided in chapter 57 of title 5, United States Code.";
    for employee: Individual;
    when employee_travel_expenses_incurred(employee);
    then duty S7471bPayEmployeeTravelExpenses {
        bearer us.irc.core::TaxCourt;
        beneficiary employee;
        goal achievement {
            condition employee_travel_expenses_paid(employee);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S7472, relation = formalizes, coverage = exact, quote = "The Tax Court is authorized to make such expenditures (including expenditures for personal services and rent at the seat of Government and elsewhere, and for law books, books of reference, and periodicals), as may be necessary efficiently to execute the functions vested in the Tax Court.")
rule S7472Expenditures strict {
    label en official "The Tax Court is authorized to make such expenditures (including expenditures for personal services and rent at the seat of Government and elsewhere, and for law books, books of reference, and periodicals), as may be necessary efficiently to execute the functions vested in the Tax Court.";
    then tax_court_authority("make the expenditures necessary efficiently to execute the functions vested in the Tax Court");
}
@source(IRC_S7472, relation = formalizes, coverage = exact, quote = "Notwithstanding any other provision of law, the Tax Court is authorized to pay on behalf of its judges, age 65 or over, any increase in the cost of Federal Employees' Group Life Insurance imposed after April 24, 1999, that is incurred after the date of the enactment of the Pension Protection Act of 2006, including any expenses generated by such payments, as authorized by the chief judge in a manner consistent with such payments authorized by the Judicial Conference of the United States pursuant to section 604(a)(5) of title 28, United States Code.")
rule S7472FegliIncreasePayments strict {
    label en official "Notwithstanding any other provision of law, the Tax Court is authorized to pay on behalf of its judges, age 65 or over, any increase in the cost of Federal Employees' Group Life Insurance imposed after April 24, 1999, that is incurred after the date of the enactment of the Pension Protection Act of 2006, including any expenses generated by such payments, as authorized by the chief judge in a manner consistent with such payments authorized by the Judicial Conference of the United States pursuant to section 604(a)(5) of title 28, United States Code.";
    then tax_court_authority("pay on behalf of its judges age 65 or over any increase in the cost of Federal Employees' Group Life Insurance imposed after April 24, 1999");
}
pub relation itemized_voucher_signed_by_certifying_officer(voucher: Text) kind empirical {
    label en official "upon presentation of itemized vouchers therefor signed by the certifying officer designated by the chief judge";
}
pub relation expenditure_allowed_and_paid_from_appropriations(voucher: Text) kind institutional;
@source(IRC_S7472, relation = formalizes, coverage = exact, quote = "all expenditures of the Tax Court shall be allowed and paid, out of any moneys appropriated for purposes of the Tax Court, upon presentation of itemized vouchers therefor signed by the certifying officer designated by the chief judge.")
pub rule S7472ExpenditureAllowedOnVoucher strict {
    label en official "all expenditures of the Tax Court shall be allowed and paid, out of any moneys appropriated for purposes of the Tax Court, upon presentation of itemized vouchers therefor signed by the certifying officer designated by the chief judge.";
    for voucher: Text;
    when itemized_voucher_signed_by_certifying_officer(voucher);
    then expenditure_allowed_and_paid_from_appropriations(voucher);
}
pub relation fee_received_by_tax_court(fee: Text, amount: Money) kind empirical {
    label en official "all fees received by the Tax Court pursuant to this title";
}
pub relation fee_is_conference_or_practitioner_registration_fee(fee: Text) kind empirical {
    label en official "fees described in sections 7470A and 7475";
}
pub relation fee_deposited_into_special_treasury_fund(fee: Text) kind empirical;
@source(IRC_S7473, relation = formalizes, coverage = exact, quote = "all fees received by the Tax Court pursuant to this title shall be deposited into a special fund of the Treasury to be available to offset funds appropriated for the operation and maintenance of the Tax Court.")
pub rule S7473DepositDutyRule defeasible {
    label en official "all fees received by the Tax Court pursuant to this title shall be deposited into a special fund of the Treasury to be available to offset funds appropriated for the operation and maintenance of the Tax Court.";
    for fee: Text;
    for amount: Money;
    when fee_received_by_tax_court(fee, amount);
    then duty S7473DepositFeesIntoSpecialFund {
        bearer us.irc.core::TaxCourt;
        goal achievement {
            condition fee_deposited_into_special_treasury_fund(fee);
            window [-infinity, infinity];
        }
    };
    unless fee_is_conference_or_practitioner_registration_fee(fee) and fee_received_by_tax_court(fee, amount);
}
pub relation tax_court_fixes_transcript_fee(fee: Money, districtCourtClerkFee: Money) kind empirical {
    label en official "a fee, not in excess of the fee fixed by law to be charged and collected therefor by the clerks of the district courts, for comparing, or for preparing and comparing, a transcript of the record, or for copying any record, entry, or other paper and the comparison and certification thereof";
}
pub relation transcript_fee_within_district_court_fee(fee: Money) kind institutional;
@source(IRC_S7474, relation = formalizes, coverage = exact, quote = "The Tax Court is authorized to fix a fee, not in excess of the fee fixed by law to be charged and collected therefor by the clerks of the district courts")
pub rule S7474FeeLimit strict {
    label en official "The Tax Court is authorized to fix a fee, not in excess of the fee fixed by law to be charged and collected therefor by the clerks of the district courts";
    for fee: Money;
    for districtFee: Money;
    when tax_court_fixes_transcript_fee(fee, districtFee)
        and fee <= districtFee;
    then transcript_fee_within_district_court_fee(fee);
}
pub relation practitioner_registration_fee_per_year(fee: Money) kind empirical {
    label en official "a periodic registration fee on practitioners admitted to practice before such Court (amount per year)";
}
pub relation registration_fee_within_30_dollars_per_year(fee: Money) kind institutional;
@source(IRC_S7475_A, relation = formalizes, coverage = exact, quote = "The frequency and amount of such fee shall be determined by the Tax Court, except that such amount may not exceed $30 per year.")
pub rule S7475aFeeLimit strict {
    label en official "The frequency and amount of such fee shall be determined by the Tax Court, except that such amount may not exceed $30 per year.";
    for fee: Money;
    when practitioner_registration_fee_per_year(fee)
        and fee <= 30.00 USD;
    then registration_fee_within_30_dollars_per_year(fee);
}
pub relation registration_fee_use_permitted(purpose: Text) kind institutional {
    label en unofficial "the fees are available to the Tax Court to employ independent counsel to pursue disciplinary matters and to provide services to pro se taxpayers";
}
@source(IRC_S7475_B, relation = formalizes, coverage = exact, quote = "The fees described in subsection (a) shall be available to the Tax Court to employ independent counsel to pursue disciplinary matters")
rule S7475bUseDisciplinaryCounsel strict {
    label en official "The fees described in subsection (a) shall be available to the Tax Court to employ independent counsel to pursue disciplinary matters";
    then registration_fee_use_permitted("employ independent counsel to pursue disciplinary matters");
}
@source(IRC_S7475_B, relation = formalizes, coverage = exact, quote = "and to provide services to pro se taxpayers.")
rule S7475bUseProSeServices strict {
    label en official "and to provide services to pro se taxpayers.";
    then registration_fee_use_permitted("provide services to pro se taxpayers");
}
