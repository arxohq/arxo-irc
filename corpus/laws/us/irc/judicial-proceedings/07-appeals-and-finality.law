// §7481(a)(1),(b) (date when a Tax Court decision becomes final); §7482(a)
// (courts of review — jurisdiction); §7483 (notice of appeal, 90/120-day
// windows); §7485(a) (bond to stay assessment and collection).
//
// METHOD NOTE (§7481(a)(1)): "upon the expiration of the time allowed for
// filing a notice of appeal, if no such notice has been duly filed within
// such time" — the §7483 90-day window IS the "time allowed" this clause
// finalizes against; modeled as an institutional_effect keyed to the
// decision date plus 90 days, conditioned on `not_known` of any notice of
// appeal filed within that window. §7481(a)(2)-(4) (finality after
// certiorari is denied/exhausted, or after a Supreme Court/Court of Appeals
// mandate) depend on federal appellate procedure OUTSIDE Title 26 (the
// certiorari period is set by Supreme Court rule, not this title) — this
// package cannot pin those day counts without inventing them, so (a)(2)-(4)
// are EXTERNAL_DEPENDENCY / SOURCE_GAP, not modeled as if complete (only
// (a)(1) and (b) are in this stage's "fully" list; (a)(2)-(4) partially
// classified, not silently skipped).
//
// METHOD NOTE (§7482(a)): a broad jurisdictional grant to the Courts of
// Appeals to review Tax Court decisions "in the same manner ... as
// decisions of the district courts in civil actions tried without a jury".
// Modeled as an institutional_effect keyed to a final-or-appealable Tax
// Court decision plus a timely notice of appeal (imported from this same
// module's §7483 rule below). (a)(2) interlocutory appeals and (a)(3)
// §6213(a)-order appeals are narrower institutional_effect variants.
//
// METHOD NOTE (§7483): the plain textual 90-day notice-of-appeal window,
// with a 120-day cross-appeal window once one party has filed timely.
//
// METHOD NOTE (§7485(a)): the bond as an explicit VALIDITY CONDITION of the
// stay of assessment/collection during appeal — modeled as a `power` of the
// taxpayer (the party who benefits from and controls the stay) whose
// `valid_when` folds the timely-notice-of-appeal condition together with
// either the appeal bond or the jeopardy-bond alternative into one atom.
//
// JUDGMENT CALLS AND GAPS:
//  - §7481(c),(d) (interest-determination reopening, §6166 estate-tax
//    reopening) stay `unreviewed` ("stage 2") — not in this stage's "fully"
//    list.
//  - §7482(b) (venue) and (c) (powers to affirm/modify/reverse, rulemaking,
//    additional security, penalties) stay `unreviewed`; only (a) is
//    modeled fully as instructed.
//  - §7485(b) (partnership-related bond) and (c) (cross references) stay
//    `unreviewed`.

language "law.core" version "0.2";
package us.irc.judicial_proceedings version "0.1.1";
namespace "urn:us:irc:judicial_proceedings:clir";

use self::{
    IRC_S7481_A,
    IRC_S7481_B,
    IRC_S7482_A,
    IRC_S7483,
    IRC_S7485_A,
    Person,
    Proceeding,
    decision_date,
    small_case_procedure_applies,
};


// ============================================================================
// §7483 — Notice of appeal
// ============================================================================

pub relation notice_of_appeal_filed(pr: Proceeding, filer: Person, on: Date) kind empirical;
pub relation first_notice_of_appeal_window_end(pr: Proceeding, decidedOn: Date, deadline: Date) kind institutional;
@source(IRC_S7483, relation = formalizes, coverage = exact, quote = "Review of a decision of the Tax Court shall be obtained by filing a notice of appeal with the clerk of the Tax Court within 90 days after the decision of the Tax Court is entered.")
pub rule S7483FirstAppealWindow defeasible {
    label en official "Review of a decision of the Tax Court shall be obtained by filing a notice of appeal with the clerk of the Tax Court within 90 days after the decision of the Tax Court is entered.";
    for pr: Proceeding;
    for decidedOn: Date;
    when decision_date(pr, decidedOn);
    then first_notice_of_appeal_window_end(pr, decidedOn, add_calendar_period(decidedOn, 90 calendar_day));
}
pub relation cross_appeal_window_end(pr: Proceeding, decidedOn: Date, deadline: Date) kind institutional;
@source(IRC_S7483, relation = formalizes, coverage = exact, quote = "If a timely notice of appeal is filed by one party, any other party may take an appeal by filing a notice of appeal within 120 days after the decision of the Tax Court is entered.")
pub rule S7483CrossAppealWindow defeasible {
    label en official "If a timely notice of appeal is filed by one party, any other party may take an appeal by filing a notice of appeal within 120 days after the decision of the Tax Court is entered.";
    for pr: Proceeding;
    for firstFiler: Person;
    for decidedOn: Date;
    for firstDeadline: Date;
    for filedOn: Date;
    when decision_date(pr, decidedOn)
        and notice_of_appeal_filed(pr, firstFiler, filedOn)
        and first_notice_of_appeal_window_end(pr, decidedOn, firstDeadline)
        and filedOn <= firstDeadline;
    then cross_appeal_window_end(pr, decidedOn, add_calendar_period(decidedOn, 120 calendar_day));
}
pub relation notice_of_appeal_timely(pr: Proceeding, filer: Person, on: Date) kind institutional;
@source(IRC_S7483, relation = formalizes, coverage = exact, quote = "Review of a decision of the Tax Court shall be obtained by filing a notice of appeal with the clerk of the Tax Court within 90 days after the decision of the Tax Court is entered.")
pub rule S7483NoticeOfAppealTimelyAsFirstFiler defeasible {
    label en official "Review of a decision of the Tax Court shall be obtained by filing a notice of appeal with the clerk of the Tax Court within 90 days after the decision of the Tax Court is entered.";
    for pr: Proceeding;
    for filer: Person;
    for decidedOn: Date;
    for deadline: Date;
    for filedOn: Date;
    when decision_date(pr, decidedOn)
        and first_notice_of_appeal_window_end(pr, decidedOn, deadline)
        and notice_of_appeal_filed(pr, filer, filedOn)
        and filedOn <= deadline;
    then notice_of_appeal_timely(pr, filer, filedOn);
}
@source(IRC_S7483, relation = formalizes, coverage = exact, quote = "any other party may take an appeal by filing a notice of appeal within 120 days after the decision of the Tax Court is entered")
pub rule S7483NoticeOfAppealTimelyAsCrossFiler defeasible {
    label en official "any other party may take an appeal by filing a notice of appeal within 120 days after the decision of the Tax Court is entered";
    for pr: Proceeding;
    for filer: Person;
    for decidedOn: Date;
    for deadline: Date;
    for filedOn: Date;
    when cross_appeal_window_end(pr, decidedOn, deadline)
        and notice_of_appeal_filed(pr, filer, filedOn)
        and filedOn <= deadline;
    then notice_of_appeal_timely(pr, filer, filedOn);
}

// ============================================================================
// §7481(a)(1) — Finality: timely notice of appeal not filed
// ============================================================================

pub relation any_notice_of_appeal_filed(pr: Proceeding) kind empirical {
    label en unofficial "bridges to `not_known` — some notice of appeal (by any party) has been filed within the §7483 window; a case asserting `notice_of_appeal_filed(pr, filer, on)` for any filer establishes this";
}
pub relation decision_final_on(pr: Proceeding, on: Date) kind institutional;
@source(IRC_S7481_A, relation = formalizes, coverage = exact, quote = "Upon the expiration of the time allowed for filing a notice of appeal, if no such notice has been duly filed within such time")
pub rule S7481FinalNoAppealFiled defeasible {
    label en official "Upon the expiration of the time allowed for filing a notice of appeal, if no such notice has been duly filed within such time";
    for pr: Proceeding;
    for decidedOn: Date;
    for deadline: Date;
    when decision_date(pr, decidedOn)
        and first_notice_of_appeal_window_end(pr, decidedOn, deadline)
        and not_known(any_notice_of_appeal_filed(pr));
    then decision_final_on(pr, deadline);
}

// ============================================================================
// §7481(b) — Finality: nonreviewable decisions (§7436(c), §7463)
// ============================================================================

pub relation decision_under_7436c_or_7463(pr: Proceeding) kind empirical {
    label en unofficial "the decision is in a proceeding conducted under §7436(c) or §7463 — bridged from small_case_procedure_applies for §7463";
}
@source(IRC_S7481_B, relation = applies, coverage = contextual, quote = "The decision of the Tax Court in a proceeding conducted under section 7436(c) or 7463 shall become final upon the expiration of 90 days after the decision is entered.")
pub rule S7481NonreviewableIsSmallCase strict {
    label en official "The decision of the Tax Court in a proceeding conducted under section 7436(c) or 7463 shall become final upon the expiration of 90 days after the decision is entered.";
    for pr: Proceeding;
    when small_case_procedure_applies(pr);
    then decision_under_7436c_or_7463(pr);
}
@source(IRC_S7481_B, relation = formalizes, coverage = exact, quote = "The decision of the Tax Court in a proceeding conducted under section 7436(c) or 7463 shall become final upon the expiration of 90 days after the decision is entered.")
pub rule S7481FinalNonreviewableDecision defeasible {
    label en official "The decision of the Tax Court in a proceeding conducted under section 7436(c) or 7463 shall become final upon the expiration of 90 days after the decision is entered.";
    for pr: Proceeding;
    for decidedOn: Date;
    when decision_under_7436c_or_7463(pr)
        and decision_date(pr, decidedOn);
    then decision_final_on(pr, add_calendar_period(decidedOn, 90 calendar_day));
}

// ============================================================================
// §7482(a) — Jurisdiction of the courts of appeals
// ============================================================================

pub relation court_of_appeals_review_sought(pr: Proceeding, filer: Person) kind empirical;
pub relation court_of_appeals_jurisdiction(pr: Proceeding) kind institutional;
@source(IRC_S7482_A, relation = formalizes, coverage = exact, quote = "The United States Courts of Appeals (other than the United States Court of Appeals for the Federal Circuit) shall have exclusive jurisdiction to review the decisions of the Tax Court, except as provided in section 1254 of Title 28 of the United States Code, in the same manner and to the same extent as decisions of the district courts in civil actions tried without a jury")
pub rule S7482CourtOfAppealsJurisdiction defeasible {
    label en official "The United States Courts of Appeals (other than the United States Court of Appeals for the Federal Circuit) shall have exclusive jurisdiction to review the decisions of the Tax Court, except as provided in section 1254 of Title 28 of the United States Code, in the same manner and to the same extent as decisions of the district courts in civil actions tried without a jury";
    for pr: Proceeding;
    for filer: Person;
    for on: Date;
    when court_of_appeals_review_sought(pr, filer)
        and notice_of_appeal_timely(pr, filer, on);
    then court_of_appeals_jurisdiction(pr);
}
pub relation tax_court_order_interlocutory_controlling_question(pr: Proceeding) kind empirical {
    label en official "a judge of the Tax Court includes in an interlocutory order a statement that a controlling question of law is involved with respect to which there is a substantial ground for difference of opinion and that an immediate appeal may materially advance the ultimate termination of the litigation";
}
pub relation interlocutory_appeal_application_on(pr: Proceeding, on: Date) kind empirical;
pub relation interlocutory_order_entered_on(pr: Proceeding, on: Date) kind empirical;
pub relation interlocutory_appeal_application_window(pr: Proceeding, enteredOn: Date, deadline: Date) kind institutional;
@source(IRC_S7482_A, relation = formalizes, coverage = exact, quote = "the United States Court of Appeals may, in its discretion, permit an appeal to be taken from such order, if application is made to it within 10 days after the entry of such order")
pub rule S7482InterlocutoryApplicationWindow defeasible {
    label en official "the United States Court of Appeals may, in its discretion, permit an appeal to be taken from such order, if application is made to it within 10 days after the entry of such order";
    for pr: Proceeding;
    for enteredOn: Date;
    when interlocutory_order_entered_on(pr, enteredOn);
    then interlocutory_appeal_application_window(pr, enteredOn, add_calendar_period(enteredOn, 10 calendar_day));
}
pub relation interlocutory_appeal_permitted(pr: Proceeding) kind institutional;
@source(IRC_S7482_A, relation = formalizes, coverage = exact, quote = "When any judge of the Tax Court includes in an interlocutory order a statement that a controlling question of law is involved with respect to which there is a substantial ground for difference of opinion and that an immediate appeal from that order may materially advance the ultimate termination of the litigation, the United States Court of Appeals may, in its discretion, permit an appeal to be taken from such order, if application is made to it within 10 days after the entry of such order.")
pub rule S7482InterlocutoryAppealPermittedPower defeasible {
    label en official "When any judge of the Tax Court includes in an interlocutory order a statement that a controlling question of law is involved with respect to which there is a substantial ground for difference of opinion and that an immediate appeal from that order may materially advance the ultimate termination of the litigation, the United States Court of Appeals may, in its discretion, permit an appeal to be taken from such order, if application is made to it within 10 days after the entry of such order.";
    for pr: Proceeding;
    for enteredOn: Date;
    for deadline: Date;
    for appliedOn: Date;
    when tax_court_order_interlocutory_controlling_question(pr)
        and interlocutory_appeal_application_window(pr, enteredOn, deadline)
        and interlocutory_appeal_application_on(pr, appliedOn)
        and appliedOn <= deadline;
    then power S7482InterlocutoryAppealPower {
        holder us.irc.core::DistrictCourt;
        exercise interlocutory_appeal_application_on(pr, appliedOn);
        valid_when tax_court_order_interlocutory_controlling_question(pr);
        effect interlocutory_appeal_permitted(pr);
    };
}

// ============================================================================
// §7485(a) — Bond to stay assessment and collection upon notice of appeal
// ============================================================================

pub relation appeal_bond_filed(pr: Proceeding, p: Person, amount: Money) kind empirical;
pub relation appeal_bond_sum_within_double_deficiency(pr: Proceeding, p: Person, amount: Money, deficiencyPortion: Money) kind empirical {
    label en unofficial "the bond, in a sum fixed by the Tax Court not exceeding double the amount of the portion of the deficiency in respect of which the notice of appeal is filed, with surety approved by the Tax Court, conditioned upon payment of the deficiency as finally determined";
}
pub relation jeopardy_bond_filed(pr: Proceeding, p: Person) kind empirical {
    label en official "has filed a jeopardy bond under the income or estate tax laws";
}
pub relation stay_bond_condition_met(pr: Proceeding, p: Person) kind institutional {
    label en unofficial "single atom folding the timely-notice-of-appeal condition together with either the appeal bond (§7485(a)(1)) or the jeopardy bond (§7485(a)(2)) alternative, for use in the power's valid_when";
}
@source(IRC_S7485_A, relation = formalizes, coverage = exact, quote = "on or before the time his notice of appeal is filed has filed with the Tax Court a bond in a sum fixed by the Tax Court not exceeding double the amount of the portion of the deficiency in respect of which the notice of appeal is filed, and with surety approved by the Tax Court, conditioned upon the payment of the deficiency as finally determined, together with any interest, additional amounts, or additions to the tax provided for by law")
pub rule S7485StayGroundsAppealBond defeasible {
    label en official "on or before the time his notice of appeal is filed has filed with the Tax Court a bond in a sum fixed by the Tax Court not exceeding double the amount of the portion of the deficiency in respect of which the notice of appeal is filed, and with surety approved by the Tax Court, conditioned upon the payment of the deficiency as finally determined, together with any interest, additional amounts, or additions to the tax provided for by law";
    for pr: Proceeding;
    for p: Person;
    for filedOn: Date;
    for amount: Money;
    for deficiencyPortion: Money;
    when notice_of_appeal_timely(pr, p, filedOn)
        and appeal_bond_filed(pr, p, amount)
        and appeal_bond_sum_within_double_deficiency(pr, p, amount, deficiencyPortion)
        and amount <= (deficiencyPortion + deficiencyPortion);
    then stay_bond_condition_met(pr, p);
}
@source(IRC_S7485_A, relation = formalizes, coverage = exact, quote = "has filed a jeopardy bond under the income or estate tax laws")
pub rule S7485StayGroundsJeopardyBond defeasible {
    label en official "has filed a jeopardy bond under the income or estate tax laws";
    for pr: Proceeding;
    for p: Person;
    for filedOn: Date;
    when notice_of_appeal_timely(pr, p, filedOn)
        and jeopardy_bond_filed(pr, p);
    then stay_bond_condition_met(pr, p);
}
pub relation stay_requested(pr: Proceeding, p: Person) kind empirical;
@source(IRC_S7485_A, relation = formalizes, coverage = partial, quote = "Notwithstanding any provision of law imposing restrictions on the assessment and collection of deficiencies, the review under section 7483 shall not operate as a stay of assessment or collection of any portion of the amount of the deficiency determined by the Tax Court unless a notice of appeal in respect of such portion is duly filed by the taxpayer, and then only if the taxpayer—")
pub rule S7485StayOfAssessmentPowerRule defeasible {
    label en official "Notwithstanding any provision of law imposing restrictions on the assessment and collection of deficiencies, the review under section 7483 shall not operate as a stay of assessment or collection of any portion of the amount of the deficiency determined by the Tax Court unless a notice of appeal in respect of such portion is duly filed by the taxpayer, and then only if the taxpayer—";
    for pr: Proceeding;
    for p: Person;
    when stay_requested(pr, p);
    then power S7485StayOfAssessmentPower {
        holder p;
        exercise stay_requested(pr, p);
        valid_when stay_bond_condition_met(pr, p);
        effect assessment_and_collection_stayed(pr, p);
    };
}
pub relation assessment_and_collection_stayed(pr: Proceeding, p: Person) kind institutional;
