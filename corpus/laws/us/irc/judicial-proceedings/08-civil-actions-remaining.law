// Stage 2 — subchapter A of chapter 76 (§§7402(b),(c),(e), 7404, 7405, 7406,
// 7407, 7408, 7409): summons enforcement, officer damages, quiet title,
// estate-tax proceedings, erroneous-refund recovery, application of
// recoveries, injunctions against return preparers, promoters and
// political expenditures.
//
// METHOD NOTE. A civil action "commenced at the request of the Secretary"
// is modeled as a POWER of the Secretary whose `valid_when` is the
// statutory precondition; a court's authority to enjoin or compel is a
// POWER of the court whose `valid_when` folds the statutory findings.
// "If the court finds ..." with a value-laden finding ("injunctive relief
// is appropriate", "substantially interferes", "flagrantly") is a
// DECISION-0194 `external judgment relation` with the court as authority,
// never a case fact. "Conduct subject to penalty under section 6694" and
// the like are typed dependencies (empirical facts here; owner named in
// coverage/judicial-proceedings.deps.json), not copies.
// Venue is modeled with a district Text key so that "resides / has a
// principal place of business / engaged in the conduct" are checked against
// the district in which the action is brought.
//
// JUDGMENT CALLS. "such other relief as may be appropriate" (§7409(b)) and
// the open-ended "such other orders ... necessary or appropriate" (§7402(a),
// stage 1) have no testable criterion beyond the court's own finding; the
// former is folded into the injunction power's effect only for the
// political-expenditure injunction. The §7404 duty has no statutory time
// limit, so its window is open-ended and it can never be VIOLATED (TECH-GAPS
// G2900 records the missing "reasonable time" reading).

language "law.core" version "0.2";
package us.irc.judicial_proceedings version "0.1.1";
namespace "urn:us:irc:judicial_proceedings:clir";

use self::{
    IRC_S7402_B,
    IRC_S7402_C,
    IRC_S7402_E,
    IRC_S7404,
    IRC_S7405_A,
    IRC_S7405_B,
    IRC_S7406,
    IRC_S7407_A,
    IRC_S7407_B,
    IRC_S7408_A,
    IRC_S7408_B,
    IRC_S7408_C,
    IRC_S7408_D,
    IRC_S7409_A,
    IRC_S7409_B,
    Person,
    Proceeding,
    TaxableYear,
};

// ============================================================================
// §7402(b) — District court jurisdiction to enforce a summons
// ============================================================================

pub relation person_summoned_to_appear_or_produce(pr: Proceeding, p: Person) kind empirical {
    label en official "any person is summoned under the internal revenue laws to appear, to testify, or to produce books, papers, or other data";
}
pub relation summoned_person_district(p: Person, district: Text) kind empirical {
    label en unofficial "the district of the United States in which the summoned person resides or may be found";
}
pub relation summons_action_district(pr: Proceeding, district: Text) kind empirical {
    label en unofficial "the district court of the United States before which the enforcement proceeding is pending sits for this district";
}
pub relation summons_enforcement_jurisdiction(pr: Proceeding, p: Person) kind institutional;
@source(IRC_S7402_B, relation = formalizes, coverage = exact, quote = "the district court of the United States for the district in which such person resides or may be found shall have jurisdiction by appropriate process to compel such attendance, testimony, or production of books, papers, or other data.")
pub rule S7402bSummonsEnforcementJurisdiction strict {
    label en official "the district court of the United States for the district in which such person resides or may be found shall have jurisdiction by appropriate process to compel such attendance, testimony, or production of books, papers, or other data.";
    for pr: Proceeding;
    for p: Person;
    for d: Text;
    when person_summoned_to_appear_or_produce(pr, p)
        and summoned_person_district(p, d)
        and summons_action_district(pr, d);
    then summons_enforcement_jurisdiction(pr, p);
}
pub relation court_orders_compliance_with_summons(pr: Proceeding, p: Person) kind empirical;
pub relation attendance_or_production_compelled(pr: Proceeding, p: Person) kind institutional;
@source(IRC_S7402_B, relation = formalizes, coverage = exact, quote = "shall have jurisdiction by appropriate process to compel such attendance, testimony, or production of books, papers, or other data.")
pub rule S7402bCompelSummonsPowerRule strict {
    label en official "shall have jurisdiction by appropriate process to compel such attendance, testimony, or production of books, papers, or other data.";
    for pr: Proceeding;
    for p: Person;
    when court_orders_compliance_with_summons(pr, p);
    then power S7402bCompelSummonsCompliance {
        holder us.irc.core::DistrictCourt;
        over p;
        exercise court_orders_compliance_with_summons(pr, p);
        valid_when summons_enforcement_jurisdiction(pr, p);
        effect attendance_or_production_compelled(pr, p);
    };
}

// ============================================================================
// §7402(c) — Damages action of United States officers and employees
// ============================================================================

pub relation officer_injured_in_discharge_of_duty(pr: Proceeding, p: Person) kind empirical {
    label en official "any officer or employee of the United States acting under authority of this title, or any person acting under or by authority of any such officer or employee, receiving any injury to his person or property in the discharge of his duty";
}
pub relation officer_files_damages_action(pr: Proceeding, p: Person) kind empirical;
pub relation officer_damages_action_maintained(pr: Proceeding, p: Person) kind institutional;
@source(IRC_S7402_C, relation = formalizes, coverage = exact, quote = "shall be entitled to maintain an action for damages therefor, in the district court of the United States, in the district wherein the party doing the injury may reside or shall be found.")
pub rule S7402cOfficerDamagesActionPowerRule strict {
    label en official "shall be entitled to maintain an action for damages therefor, in the district court of the United States, in the district wherein the party doing the injury may reside or shall be found.";
    for pr: Proceeding;
    for p: Person;
    when officer_files_damages_action(pr, p);
    then power S7402cMaintainDamagesAction {
        holder p;
        exercise officer_files_damages_action(pr, p);
        valid_when officer_injured_in_discharge_of_duty(pr, p);
        effect officer_damages_action_maintained(pr, p);
    };
}

// ============================================================================
// §7402(e) — Quiet title
// ============================================================================

pub relation united_states_quiet_title_action(pr: Proceeding) kind empirical {
    label en official "any action brought by the United States to quiet title to property";
}
pub relation us_title_derived_from_lien_enforcement(pr: Proceeding) kind empirical {
    label en official "the title claimed by the United States to such property was derived from enforcement of a lien under this title";
}
pub relation quiet_title_jurisdiction(pr: Proceeding) kind institutional;
@source(IRC_S7402_E, relation = formalizes, coverage = exact, quote = "The United States district courts shall have jurisdiction of any action brought by the United States to quiet title to property if the title claimed by the United States to such property was derived from enforcement of a lien under this title.")
pub rule S7402eQuietTitleJurisdiction strict {
    label en official "The United States district courts shall have jurisdiction of any action brought by the United States to quiet title to property if the title claimed by the United States to such property was derived from enforcement of a lien under this title.";
    for pr: Proceeding;
    when united_states_quiet_title_action(pr)
        and us_title_derived_from_lien_enforcement(pr);
    then quiet_title_jurisdiction(pr);
}

// ============================================================================
// §7404 — Civil action for unpaid estate tax
// ============================================================================

pub relation estate_tax_unpaid_after_due_date(e: Person, dueOn: Date) kind empirical {
    label en official "the estate tax imposed by chapter 11 is not paid on or before the due date thereof";
}
pub relation estate_tax_collection_proceeding_begun(e: Person) kind empirical {
    label en unofficial "the Secretary has proceeded to collect the estate tax under general law, or proceedings in the name of the United States have been commenced in a court of the United States having jurisdiction to subject the property of the decedent to sale";
}
@source(IRC_S7404, relation = formalizes, coverage = exact, quote = "If the estate tax imposed by chapter 11 is not paid on or before the due date thereof, the Secretary shall proceed to collect the tax under the provisions of general law")
pub rule S7404ProceedToCollectDutyRule strict {
    label en official "If the estate tax imposed by chapter 11 is not paid on or before the due date thereof, the Secretary shall proceed to collect the tax under the provisions of general law";
    for e: Person;
    for dueOn: Date;
    when estate_tax_unpaid_after_due_date(e, dueOn);
    then duty S7404ProceedToCollectEstateTax {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition estate_tax_collection_proceeding_begun(e);
            window [dueOn, infinity];
        }
    };
}
pub relation estate_sale_proceeds(pr: Proceeding, proceeds: Money) kind empirical {
    label en official "the proceeds of such sale";
}
pub relation estate_tax_and_costs_allowed(pr: Proceeding, tax: Money, costs: Money) kind empirical {
    label en official "the amount of the tax, together with the costs and expenses of every description to be allowed by the court";
}
pub relation estate_first_charge_on_proceeds(pr: Proceeding, amount: Money) kind institutional {
    label en unofficial "the amount of the proceeds that is first paid to the tax and allowed costs";
}
pub relation estate_balance_deposited_for_persons_entitled(pr: Proceeding, balance: Money) kind institutional {
    label en unofficial "the balance deposited according to the order of the court, to be paid to the person entitled thereto";
}
@source(IRC_S7404, relation = formalizes, coverage = exact, quote = "From the proceeds of such sale the amount of the tax, together with the costs and expenses of every description to be allowed by the court, shall be first paid")
pub rule S7404TaxAndCostsFirstPaidFull strict {
    label en official "From the proceeds of such sale the amount of the tax, together with the costs and expenses of every description to be allowed by the court, shall be first paid";
    for pr: Proceeding;
    for proceeds: Money;
    for tax: Money;
    for costs: Money;
    when estate_sale_proceeds(pr, proceeds)
        and estate_tax_and_costs_allowed(pr, tax, costs)
        and proceeds >= (tax + costs);
    then estate_first_charge_on_proceeds(pr, tax + costs);
}
@source(IRC_S7404, relation = formalizes, coverage = partial, quote = "From the proceeds of such sale the amount of the tax, together with the costs and expenses of every description to be allowed by the court, shall be first paid")
pub rule S7404TaxAndCostsFirstPaidShort strict {
    label en official "From the proceeds of such sale the amount of the tax, together with the costs and expenses of every description to be allowed by the court, shall be first paid";
    for pr: Proceeding;
    for proceeds: Money;
    for tax: Money;
    for costs: Money;
    when estate_sale_proceeds(pr, proceeds)
        and estate_tax_and_costs_allowed(pr, tax, costs)
        and proceeds < (tax + costs);
    then estate_first_charge_on_proceeds(pr, proceeds);
}
@source(IRC_S7404, relation = formalizes, coverage = exact, quote = "and the balance shall be deposited according to the order of the court, to be paid under its direction to the person entitled thereto.")
pub rule S7404BalanceDeposited strict {
    label en official "and the balance shall be deposited according to the order of the court, to be paid under its direction to the person entitled thereto.";
    for pr: Proceeding;
    for proceeds: Money;
    for tax: Money;
    for costs: Money;
    when estate_sale_proceeds(pr, proceeds)
        and estate_tax_and_costs_allowed(pr, tax, costs)
        and proceeds >= (tax + costs);
    then estate_balance_deposited_for_persons_entitled(pr, proceeds - (tax + costs));
}
pub relation estate_deficiency_collection_action(pr: Proceeding, e: Person, y: TaxableYear) kind empirical {
    label en unofficial "the §7404 proceeding is applied to the collection of a deficiency of the estate tax";
}
pub relation estate_deficiency_action_barred_by_6213(pr: Proceeding, e: Person, y: TaxableYear) kind institutional {
    label en unofficial "insofar as §7404 applies to collection of a deficiency it is subject to §6213: while the assessment of the estate-tax deficiency is restricted by §6213(a) the action is barred (§6601 interest is a separate, pending cross-reference)";
}
@source(IRC_S7404, relation = formalizes, coverage = partial, quote = "This section insofar as it applies to the collection of a deficiency shall be subject to the provisions of sections 6213 and 6601.")
pub rule S7404DeficiencyActionSubjectTo6213 strict {
    label en official "This section insofar as it applies to the collection of a deficiency shall be subject to the provisions of sections 6213 and 6601.";
    for pr: Proceeding;
    for e: Person;
    for y: TaxableYear;
    when estate_deficiency_collection_action(pr, e, y)
        and us.irc.assessment::assessment_restricted(e, y, us.irc.core::EstateCh11);
    then estate_deficiency_action_barred_by_6213(pr, e, y);
}

// ============================================================================
// §7405 — Recovery of erroneous refunds
// ============================================================================

pub relation refund_erroneous_within_6514(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "refund of which is erroneously made, within the meaning of section 6514";
}
pub relation refund_erroneous_not_within_6514(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "which has been erroneously refunded (if such refund would not be considered as erroneous under section 6514)";
}
pub relation erroneous_refund_recoverable(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "a portion of tax refunded erroneously is recoverable by civil action in the name of the United States (either §7405(a) or §7405(b) branch)";
}
@source(IRC_S7405_A, relation = formalizes, coverage = exact, quote = "Any portion of a tax imposed by this title, refund of which is erroneously made, within the meaning of section 6514, may be recovered by civil action brought in the name of the United States.")
pub rule S7405aRefundErroneousWithin6514 strict {
    label en official "Any portion of a tax imposed by this title, refund of which is erroneously made, within the meaning of section 6514, may be recovered by civil action brought in the name of the United States.";
    for p: Person;
    for y: TaxableYear;
    for amount: Money;
    when refund_erroneous_within_6514(p, y, amount);
    then erroneous_refund_recoverable(p, y, amount);
}
@source(IRC_S7405_B, relation = formalizes, coverage = exact, quote = "Any portion of a tax imposed by this title which has been erroneously refunded (if such refund would not be considered as erroneous under section 6514) may be recovered by civil action brought in the name of the United States.")
pub rule S7405bRefundErroneousOtherwise strict {
    label en official "Any portion of a tax imposed by this title which has been erroneously refunded (if such refund would not be considered as erroneous under section 6514) may be recovered by civil action brought in the name of the United States.";
    for p: Person;
    for y: TaxableYear;
    for amount: Money;
    when refund_erroneous_not_within_6514(p, y, amount);
    then erroneous_refund_recoverable(p, y, amount);
}
pub relation us_files_erroneous_refund_action(pr: Proceeding, p: Person, y: TaxableYear, amount: Money) kind empirical;
pub relation erroneous_refund_action_brought(pr: Proceeding, p: Person, y: TaxableYear, amount: Money) kind institutional;
@source(IRC_S7405_A, relation = formalizes, coverage = partial, quote = "may be recovered by civil action brought in the name of the United States.")
pub rule S7405RecoveryActionPowerRule strict {
    label en official "may be recovered by civil action brought in the name of the United States.";
    for pr: Proceeding;
    for p: Person;
    for y: TaxableYear;
    for amount: Money;
    when us_files_erroneous_refund_action(pr, p, y, amount);
    then power S7405BringErroneousRefundAction {
        holder us.irc.core::Secretary;
        over p;
        exercise us_files_erroneous_refund_action(pr, p, y, amount);
        valid_when erroneous_refund_recoverable(p, y, amount);
        effect erroneous_refund_action_brought(pr, p, y, amount);
    };
}

// ============================================================================
// §7406 — Disposition of judgments and moneys recovered
// ============================================================================

pub relation judgment_or_money_recovered(pr: Proceeding, amount: Money) kind empirical {
    label en official "all judgments and moneys recovered or received for taxes, costs, forfeitures, and penalties";
}
pub relation treated_as_collection_of_internal_revenue_taxes(pr: Proceeding, amount: Money) kind institutional {
    label en unofficial "the amount is paid to the Secretary as collections of internal revenue taxes";
}
@source(IRC_S7406, relation = formalizes, coverage = exact, quote = "All judgments and moneys recovered or received for taxes, costs, forfeitures, and penalties shall be paid to the Secretary as collections of internal revenue taxes.")
pub rule S7406RecoveriesArePaidToSecretary strict {
    label en official "All judgments and moneys recovered or received for taxes, costs, forfeitures, and penalties shall be paid to the Secretary as collections of internal revenue taxes.";
    for pr: Proceeding;
    for amount: Money;
    when judgment_or_money_recovered(pr, amount);
    then treated_as_collection_of_internal_revenue_taxes(pr, amount);
}

// ============================================================================
// §7407 — Action to enjoin tax return preparers
// ============================================================================

pub relation is_tax_return_preparer(p: Person) kind institutional {
    label en unofficial "the person is a tax return preparer (§7701(a)(36); read from the owner `us.irc.definitions` (WIRE-7))";
}
pub relation preparer_residence_district(p: Person, district: Text) kind empirical;
pub relation preparer_principal_place_district(p: Person, district: Text) kind empirical;
pub relation return_taxpayer_residence_district(pr: Proceeding, district: Text) kind empirical {
    label en unofficial "the district in which the taxpayer with respect to whose tax return the action is brought resides";
}
pub relation preparer_action_district(pr: Proceeding, district: Text) kind empirical;
pub relation secretary_requests_preparer_injunction(pr: Proceeding, p: Person) kind empirical {
    label en official "may be commenced at the request of the Secretary";
}
pub relation preparer_injunction_venue_proper(pr: Proceeding, p: Person) kind institutional;
@source(IRC_S7407_A, relation = formalizes, coverage = exact, quote = "Any action under this section shall be brought in the District Court of the United States for the district in which the tax return preparer resides or has his principal place of business")
pub rule S7407aVenueResidence strict {
    label en official "Any action under this section shall be brought in the District Court of the United States for the district in which the tax return preparer resides or has his principal place of business";
    for pr: Proceeding;
    for p: Person;
    for d: Text;
    when preparer_residence_district(p, d) and preparer_action_district(pr, d);
    then preparer_injunction_venue_proper(pr, p);
}
@source(IRC_S7407_A, relation = formalizes, coverage = exact, quote = "Any action under this section shall be brought in the District Court of the United States for the district in which the tax return preparer resides or has his principal place of business")
pub rule S7407aVenuePrincipalPlace strict {
    label en official "Any action under this section shall be brought in the District Court of the United States for the district in which the tax return preparer resides or has his principal place of business";
    for pr: Proceeding;
    for p: Person;
    for d: Text;
    when preparer_principal_place_district(p, d) and preparer_action_district(pr, d);
    then preparer_injunction_venue_proper(pr, p);
}
@source(IRC_S7407_A, relation = formalizes, coverage = exact, quote = "or in which the taxpayer with respect to whose tax return the action is brought resides.")
pub rule S7407aVenueTaxpayerResidence strict {
    label en official "or in which the taxpayer with respect to whose tax return the action is brought resides.";
    for pr: Proceeding;
    for p: Person;
    for d: Text;
    when is_tax_return_preparer(p) and return_taxpayer_residence_district(pr, d) and preparer_action_district(pr, d);
    then preparer_injunction_venue_proper(pr, p);
}
pub relation preparer_injunction_action_commenced(pr: Proceeding, p: Person) kind institutional;
@source(IRC_S7407_A, relation = formalizes, coverage = exact, quote = "A civil action in the name of the United States to enjoin any person who is a tax return preparer from further engaging in any conduct described in subsection (b) or from further acting as a tax return preparer may be commenced at the request of the Secretary.")
pub rule S7407aCommenceActionPowerRule strict {
    label en official "A civil action in the name of the United States to enjoin any person who is a tax return preparer from further engaging in any conduct described in subsection (b) or from further acting as a tax return preparer may be commenced at the request of the Secretary.";
    for pr: Proceeding;
    for p: Person;
    when secretary_requests_preparer_injunction(pr, p);
    then power S7407CommencePreparerInjunctionAction {
        holder us.irc.core::Secretary;
        over p;
        exercise secretary_requests_preparer_injunction(pr, p);
        valid_when is_tax_return_preparer(p);
        effect preparer_injunction_action_commenced(pr, p);
    };
}
pub relation preparer_penalty_or_criminal_conduct(pr: Proceeding, p: Person) kind empirical {
    label en official "engaged in any conduct subject to penalty under section 6694 or 6695, or subject to any criminal penalty provided by this title";
}
pub relation preparer_misrepresented_eligibility_or_credentials(pr: Proceeding, p: Person) kind empirical {
    label en official "misrepresented his eligibility to practice before the Internal Revenue Service, or otherwise misrepresented his experience or education as a tax return preparer";
}
pub relation preparer_guaranteed_refund_or_credit(pr: Proceeding, p: Person) kind empirical {
    label en official "guaranteed the payment of any tax refund or the allowance of any tax credit";
}
external judgment relation preparer_fraudulent_or_deceptive_interference(pr: Proceeding, p: Person) {
    authority DistrictCourt;
    label en official "engaged in any other fraudulent or deceptive conduct which substantially interferes with the proper administration of the Internal Revenue laws";
}
external judgment relation preparer_injunctive_relief_appropriate(pr: Proceeding, p: Person) {
    authority DistrictCourt;
    label en official "injunctive relief is appropriate to prevent the recurrence of such conduct";
}
pub relation preparer_enjoinable_conduct_found(pr: Proceeding, p: Person) kind institutional {
    label en unofficial "the court finds that the tax return preparer has engaged in conduct described in §7407(b)(1)(A)-(D)";
}
@source(IRC_S7407_B, relation = formalizes, coverage = exact, quote = "engaged in any conduct subject to penalty under section 6694 or 6695, or subject to any criminal penalty provided by this title,")
pub rule S7407b1AConduct defeasible {
    label en official "engaged in any conduct subject to penalty under section 6694 or 6695, or subject to any criminal penalty provided by this title,";
    for pr: Proceeding;
    for p: Person;
    when preparer_penalty_or_criminal_conduct(pr, p);
    then preparer_enjoinable_conduct_found(pr, p);
}
@source(IRC_S7407_B, relation = formalizes, coverage = exact, quote = "misrepresented his eligibility to practice before the Internal Revenue Service, or otherwise misrepresented his experience or education as a tax return preparer,")
pub rule S7407b1BConduct defeasible {
    label en official "misrepresented his eligibility to practice before the Internal Revenue Service, or otherwise misrepresented his experience or education as a tax return preparer,";
    for pr: Proceeding;
    for p: Person;
    when preparer_misrepresented_eligibility_or_credentials(pr, p);
    then preparer_enjoinable_conduct_found(pr, p);
}
@source(IRC_S7407_B, relation = formalizes, coverage = exact, quote = "guaranteed the payment of any tax refund or the allowance of any tax credit, or")
pub rule S7407b1CConduct defeasible {
    label en official "guaranteed the payment of any tax refund or the allowance of any tax credit, or";
    for pr: Proceeding;
    for p: Person;
    when preparer_guaranteed_refund_or_credit(pr, p);
    then preparer_enjoinable_conduct_found(pr, p);
}
@source(IRC_S7407_B, relation = formalizes, coverage = exact, quote = "engaged in any other fraudulent or deceptive conduct which substantially interferes with the proper administration of the Internal Revenue laws, and")
pub rule S7407b1DConduct defeasible {
    label en official "engaged in any other fraudulent or deceptive conduct which substantially interferes with the proper administration of the Internal Revenue laws, and";
    for pr: Proceeding;
    for p: Person;
    when preparer_fraudulent_or_deceptive_interference(pr, p);
    then preparer_enjoinable_conduct_found(pr, p);
}
pub relation preparer_conduct_injunction_grounds(pr: Proceeding, p: Person) kind institutional;
@source(IRC_S7407_B, relation = formalizes, coverage = exact, quote = "(2) that injunctive relief is appropriate to prevent the recurrence of such conduct,")
pub rule S7407bGroundsConductInjunction defeasible {
    label en official "(2) that injunctive relief is appropriate to prevent the recurrence of such conduct,";
    for pr: Proceeding;
    for p: Person;
    when preparer_enjoinable_conduct_found(pr, p)
        and preparer_injunctive_relief_appropriate(pr, p);
    then preparer_conduct_injunction_grounds(pr, p);
}
pub relation court_enjoins_preparer_conduct(pr: Proceeding, p: Person) kind empirical;
pub relation preparer_enjoined_from_conduct(pr: Proceeding, p: Person) kind institutional;
@source(IRC_S7407_B, relation = formalizes, coverage = exact, quote = "the court may enjoin such person from further engaging in such conduct.")
pub rule S7407bEnjoinConductPowerRule defeasible {
    label en official "the court may enjoin such person from further engaging in such conduct.";
    for pr: Proceeding;
    for p: Person;
    when court_enjoins_preparer_conduct(pr, p);
    then power S7407bEnjoinConduct {
        holder us.irc.core::DistrictCourt;
        over p;
        exercise court_enjoins_preparer_conduct(pr, p);
        valid_when preparer_conduct_injunction_grounds(pr, p);
        effect preparer_enjoined_from_conduct(pr, p);
    };
}
external judgment relation preparer_continually_or_repeatedly_engaged(pr: Proceeding, p: Person) {
    authority DistrictCourt;
    label en official "a tax return preparer has continually or repeatedly engaged in any conduct described in subparagraphs (A) through (D) of this subsection";
}
external judgment relation preparer_conduct_injunction_insufficient(pr: Proceeding, p: Person) {
    authority DistrictCourt;
    label en official "an injunction prohibiting such conduct would not be sufficient to prevent such person's interference with the proper administration of this title";
}
pub relation preparer_practice_injunction_grounds(pr: Proceeding, p: Person) kind institutional;
@source(IRC_S7407_B, relation = formalizes, coverage = exact, quote = "If the court finds that a tax return preparer has continually or repeatedly engaged in any conduct described in subparagraphs (A) through (D) of this subsection and that an injunction prohibiting such conduct would not be sufficient to prevent such person's interference with the proper administration of this title")
pub rule S7407bGroundsPracticeInjunction defeasible {
    label en official "If the court finds that a tax return preparer has continually or repeatedly engaged in any conduct described in subparagraphs (A) through (D) of this subsection and that an injunction prohibiting such conduct would not be sufficient to prevent such person's interference with the proper administration of this title";
    for pr: Proceeding;
    for p: Person;
    when preparer_continually_or_repeatedly_engaged(pr, p)
        and preparer_conduct_injunction_insufficient(pr, p);
    then preparer_practice_injunction_grounds(pr, p);
}
pub relation court_enjoins_acting_as_preparer(pr: Proceeding, p: Person) kind empirical;
pub relation preparer_enjoined_from_acting_as_preparer(pr: Proceeding, p: Person) kind institutional;
@source(IRC_S7407_B, relation = formalizes, coverage = exact, quote = "the court may enjoin such person from acting as a tax return preparer.")
pub rule S7407bEnjoinPracticePowerRule defeasible {
    label en official "the court may enjoin such person from acting as a tax return preparer.";
    for pr: Proceeding;
    for p: Person;
    when court_enjoins_acting_as_preparer(pr, p);
    then power S7407bEnjoinActingAsPreparer {
        holder us.irc.core::DistrictCourt;
        over p;
        exercise court_enjoins_acting_as_preparer(pr, p);
        valid_when preparer_practice_injunction_grounds(pr, p);
        effect preparer_enjoined_from_acting_as_preparer(pr, p);
    };
}

// ============================================================================
// §7408 — Actions to enjoin specified conduct related to tax shelters and
// reportable transactions
// ============================================================================

pub relation conduct_subject_to_penalty_6700_6701_6707_6708(pr: Proceeding, p: Person) kind empirical {
    label en official "subject to penalty under section 6700, 6701, 6707, or 6708";
}
pub relation conduct_violates_31_usc_330_regulations(pr: Proceeding, p: Person) kind empirical {
    label en official "in violation of any requirement under regulations issued under section 330 of title 31, United States Code";
}
pub relation specified_conduct_engaged(pr: Proceeding, p: Person) kind institutional {
    label en unofficial "the person has engaged in specified conduct within §7408(c)";
}
@source(IRC_S7408_C, relation = formalizes, coverage = exact, quote = "subject to penalty under section 6700, 6701, 6707, or 6708, or")
pub rule S7408cSpecifiedConductPenalty strict {
    label en official "subject to penalty under section 6700, 6701, 6707, or 6708, or";
    for pr: Proceeding;
    for p: Person;
    when conduct_subject_to_penalty_6700_6701_6707_6708(pr, p);
    then specified_conduct_engaged(pr, p);
}
@source(IRC_S7408_C, relation = formalizes, coverage = exact, quote = "in violation of any requirement under regulations issued under section 330 of title 31, United States Code.")
pub rule S7408cSpecifiedConductCircular230 strict {
    label en official "in violation of any requirement under regulations issued under section 330 of title 31, United States Code.";
    for pr: Proceeding;
    for p: Person;
    when conduct_violates_31_usc_330_regulations(pr, p);
    then specified_conduct_engaged(pr, p);
}
pub relation person_residence_district(p: Person, district: Text) kind empirical;
pub relation person_principal_place_district(p: Person, district: Text) kind empirical;
pub relation person_conduct_district(pr: Proceeding, p: Person, district: Text) kind empirical {
    label en unofficial "the district in which the person has engaged in specified conduct";
}
pub relation specified_conduct_action_district(pr: Proceeding, district: Text) kind empirical;
pub relation us_citizen_or_resident_outside_all_districts(p: Person) kind empirical {
    label en official "any citizen or resident of the United States does not reside in, and does not have his principal place of business in, any United States judicial district";
}
pub relation treated_as_residing_in_district(p: Person, district: Text) kind institutional;
@source(IRC_S7408_D, relation = formalizes, coverage = exact, quote = "such citizen or resident shall be treated for purposes of this section as residing in the District of Columbia.")
pub rule S7408dTreatedAsResidingInDC strict {
    label en official "such citizen or resident shall be treated for purposes of this section as residing in the District of Columbia.";
    for p: Person;
    when us_citizen_or_resident_outside_all_districts(p);
    then treated_as_residing_in_district(p, "District of Columbia");
}
@source(IRC_S7408_A, relation = formalizes, coverage = partial, quote = "Any action under this section shall be brought in the district court of the United States for the district in which such person resides, has his principal place of business, or has engaged in specified conduct.")
pub rule S7408aResidenceInDistrict strict {
    label en official "Any action under this section shall be brought in the district court of the United States for the district in which such person resides, has his principal place of business, or has engaged in specified conduct.";
    for p: Person;
    for d: Text;
    when person_residence_district(p, d);
    then treated_as_residing_in_district(p, d);
}
pub relation specified_conduct_venue_proper(pr: Proceeding, p: Person) kind institutional;
@source(IRC_S7408_A, relation = formalizes, coverage = exact, quote = "Any action under this section shall be brought in the district court of the United States for the district in which such person resides, has his principal place of business, or has engaged in specified conduct.")
pub rule S7408aVenueResidence strict {
    label en official "Any action under this section shall be brought in the district court of the United States for the district in which such person resides, has his principal place of business, or has engaged in specified conduct.";
    for pr: Proceeding;
    for p: Person;
    for d: Text;
    when treated_as_residing_in_district(p, d) and specified_conduct_action_district(pr, d);
    then specified_conduct_venue_proper(pr, p);
}
@source(IRC_S7408_A, relation = formalizes, coverage = exact, quote = "Any action under this section shall be brought in the district court of the United States for the district in which such person resides, has his principal place of business, or has engaged in specified conduct.")
pub rule S7408aVenuePrincipalPlace strict {
    label en official "Any action under this section shall be brought in the district court of the United States for the district in which such person resides, has his principal place of business, or has engaged in specified conduct.";
    for pr: Proceeding;
    for p: Person;
    for d: Text;
    when person_principal_place_district(p, d) and specified_conduct_action_district(pr, d);
    then specified_conduct_venue_proper(pr, p);
}
@source(IRC_S7408_A, relation = formalizes, coverage = exact, quote = "Any action under this section shall be brought in the district court of the United States for the district in which such person resides, has his principal place of business, or has engaged in specified conduct.")
pub rule S7408aVenueConductDistrict strict {
    label en official "Any action under this section shall be brought in the district court of the United States for the district in which such person resides, has his principal place of business, or has engaged in specified conduct.";
    for pr: Proceeding;
    for p: Person;
    for d: Text;
    when person_conduct_district(pr, p, d) and specified_conduct_action_district(pr, d);
    then specified_conduct_venue_proper(pr, p);
}
pub relation secretary_requests_specified_conduct_injunction(pr: Proceeding, p: Person) kind empirical;
pub relation specified_conduct_injunction_action_commenced(pr: Proceeding, p: Person) kind institutional;
@source(IRC_S7408_A, relation = formalizes, coverage = exact, quote = "A civil action in the name of the United States to enjoin any person from further engaging in specified conduct may be commenced at the request of the Secretary.")
pub rule S7408aCommenceActionPowerRule strict {
    label en official "A civil action in the name of the United States to enjoin any person from further engaging in specified conduct may be commenced at the request of the Secretary.";
    for pr: Proceeding;
    for p: Person;
    when secretary_requests_specified_conduct_injunction(pr, p);
    then power S7408CommenceSpecifiedConductAction {
        holder us.irc.core::Secretary;
        over p;
        exercise secretary_requests_specified_conduct_injunction(pr, p);
        valid_when specified_conduct_engaged(pr, p);
        effect specified_conduct_injunction_action_commenced(pr, p);
    };
}
external judgment relation specified_conduct_injunctive_relief_appropriate(pr: Proceeding, p: Person) {
    authority DistrictCourt;
    label en official "injunctive relief is appropriate to prevent recurrence of such conduct";
}
pub relation specified_conduct_injunction_grounds(pr: Proceeding, p: Person) kind institutional;
@source(IRC_S7408_B, relation = formalizes, coverage = exact, quote = "In any action under subsection (a), if the court finds—")
pub rule S7408bGroundsInjunction defeasible {
    label en official "In any action under subsection (a), if the court finds—";
    for pr: Proceeding;
    for p: Person;
    when specified_conduct_engaged(pr, p)
        and specified_conduct_injunctive_relief_appropriate(pr, p);
    then specified_conduct_injunction_grounds(pr, p);
}
pub relation court_enjoins_specified_conduct(pr: Proceeding, p: Person) kind empirical;
pub relation person_enjoined_from_specified_conduct(pr: Proceeding, p: Person) kind institutional;
@source(IRC_S7408_B, relation = formalizes, coverage = exact, quote = "the court may enjoin such person from engaging in such conduct or in any other activity subject to penalty under this title.")
pub rule S7408bEnjoinPowerRule defeasible {
    label en official "the court may enjoin such person from engaging in such conduct or in any other activity subject to penalty under this title.";
    for pr: Proceeding;
    for p: Person;
    when court_enjoins_specified_conduct(pr, p);
    then power S7408bEnjoinSpecifiedConduct {
        holder us.irc.core::DistrictCourt;
        over p;
        exercise court_enjoins_specified_conduct(pr, p);
        valid_when specified_conduct_injunction_grounds(pr, p);
        effect person_enjoined_from_specified_conduct(pr, p);
    };
}

// ============================================================================
// §7409 — Action to enjoin flagrant political expenditures of section
// 501(c)(3) organizations
// ============================================================================

pub relation irs_notified_intention_to_seek_injunction(org: Person) kind empirical {
    label en official "the Internal Revenue Service has notified the organization of its intention to seek an injunction under this section if the making of political expenditures does not immediately cease";
}
pub relation commissioner_determined_flagrant_political_participation(org: Person) kind empirical {
    label en official "the Commissioner of Internal Revenue has personally determined that such organization has flagrantly participated in, or intervened in (including the publication or distribution of statements), any political campaign on behalf of (or in opposition to) any candidate for public office";
}
pub relation commissioner_determined_injunction_appropriate(org: Person) kind empirical {
    label en official "the Commissioner of Internal Revenue has personally determined that injunctive relief is appropriate to prevent future political expenditures";
}
pub relation political_injunction_action_requirements_met(org: Person) kind institutional {
    label en unofficial "the requirements of §7409(a)(2) are met: notification (A) and the Commissioner's two personal determinations (B)(i)-(ii)";
}
@source(IRC_S7409_A, relation = formalizes, coverage = exact, quote = "An action may be brought under subsection (a) only if—")
pub rule S7409a2RequirementsMet strict {
    label en official "An action may be brought under subsection (a) only if—";
    for org: Person;
    when irs_notified_intention_to_seek_injunction(org)
        and commissioner_determined_flagrant_political_participation(org)
        and commissioner_determined_injunction_appropriate(org);
    then political_injunction_action_requirements_met(org);
}
pub relation secretary_requests_political_injunction(pr: Proceeding, org: Person) kind empirical;
pub relation political_injunction_action_commenced(pr: Proceeding, org: Person) kind institutional;
@source(IRC_S7409_A, relation = formalizes, coverage = exact, quote = "If the requirements of paragraph (2) are met, a civil action in the name of the United States may be commenced at the request of the Secretary to enjoin any section 501(c)(3) organization from further making political expenditures")
pub rule S7409aCommenceActionPowerRule strict {
    label en official "If the requirements of paragraph (2) are met, a civil action in the name of the United States may be commenced at the request of the Secretary to enjoin any section 501(c)(3) organization from further making political expenditures";
    for pr: Proceeding;
    for org: Person;
    when secretary_requests_political_injunction(pr, org);
    then power S7409CommencePoliticalInjunctionAction {
        holder us.irc.core::Secretary;
        over org;
        exercise secretary_requests_political_injunction(pr, org);
        valid_when political_injunction_action_requirements_met(org);
        effect political_injunction_action_commenced(pr, org);
    };
}
external judgment relation flagrant_political_participation_clear_and_convincing(pr: Proceeding, org: Person) {
    authority DistrictCourt;
    label en official "the court finds on the basis of clear and convincing evidence that such organization has flagrantly participated in, or intervened in (including the publication or distribution of statements), any political campaign on behalf of (or in opposition to) any candidate for public office";
}
external judgment relation political_injunction_appropriate_to_prevent_future(pr: Proceeding, org: Person) {
    authority DistrictCourt;
    label en official "injunctive relief is appropriate to prevent future political expenditures";
}
pub relation political_injunction_grounds(pr: Proceeding, org: Person) kind institutional;
@source(IRC_S7409_B, relation = formalizes, coverage = exact, quote = "In any action under subsection (a), if the court finds on the basis of clear and convincing evidence that—")
pub rule S7409bGroundsInjunction defeasible {
    label en official "In any action under subsection (a), if the court finds on the basis of clear and convincing evidence that—";
    for pr: Proceeding;
    for org: Person;
    when flagrant_political_participation_clear_and_convincing(pr, org)
        and political_injunction_appropriate_to_prevent_future(pr, org);
    then political_injunction_grounds(pr, org);
}
pub relation court_enjoins_political_expenditures(pr: Proceeding, org: Person) kind empirical;
pub relation organization_enjoined_from_political_expenditures(pr: Proceeding, org: Person) kind institutional;
@source(IRC_S7409_B, relation = formalizes, coverage = exact, quote = "the court may enjoin such organization from making political expenditures and may grant such other relief as may be appropriate to ensure that the assets of such organization are preserved for charitable or other purposes specified in section 501(c)(3).")
pub rule S7409bEnjoinPowerRule defeasible {
    label en official "the court may enjoin such organization from making political expenditures and may grant such other relief as may be appropriate to ensure that the assets of such organization are preserved for charitable or other purposes specified in section 501(c)(3).";
    for pr: Proceeding;
    for org: Person;
    when court_enjoins_political_expenditures(pr, org);
    then power S7409bEnjoinPoliticalExpenditures {
        holder us.irc.core::DistrictCourt;
        over org;
        exercise court_enjoins_political_expenditures(pr, org);
        valid_when political_injunction_grounds(pr, org);
        effect organization_enjoined_from_political_expenditures(pr, org);
    };
}
