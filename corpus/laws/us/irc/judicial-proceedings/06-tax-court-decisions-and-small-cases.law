// §7459(c)-(e) (date of decision; effect of dismissal; effect of a
// limitations decision); §7463(a)-(c) (small tax case election, finality,
// jurisdictional limitation).
//
// METHOD NOTE (§7459(c)): "date of decision" is a pure institutional_effect
// computing WHICH date a decision is deemed rendered on, branching on
// whether the dismissal is for lack of jurisdiction, for another reason
// with an ascertainable deficiency amount, or is an ordinary order
// specifying the deficiency. Modeled as three mutually exclusive rules on
// the same head (a genuine partition of the text's own branches, not a
// `priority`-arbitrated conflict — each branch's `when` is disjoint from
// the others by the case facts asserted, so no `priority` block is needed;
// see the note on the third branch below).
//
// METHOD NOTE (§7459(d)): a dismissal is DEEMED a decision that the
// deficiency is the Secretary-determined amount — modeled as an
// institutional_effect keyed to the underlying petition/proceeding, wired
// to `us.irc.core::assessment_of` where the Secretary's own determined
// amount is asserted.
//
// METHOD NOTE (§7463(a)): the taxpayer's election into small-tax-case
// procedure, "concurred in by the Tax Court", is a `power` of the taxpayer
// whose `valid_when` folds the four disjoint per-subtitle dollar ceilings
// (each exactly $50,000, per subtitle A/chapter 11/chapter 12/subtitle D)
// into one atom via a helper relation, per the one-atom rule; the Tax
// Court's concurrence is a second, independent condition of the SAME power
// (both must hold — folded into the same helper atom, since `valid_when`
// takes exactly one atom).
//
// JUDGMENT CALLS AND GAPS:
//  - §7459(c)'s "declaratory judgment proceeding under part IV of this
//    subchapter or under section 7428, or ... action brought under section
//    6234" branch (using the court's order-entry date rather than the
//    order-specifying-deficiency date) is modeled as a third rule keyed to
//    a `proceeding_kind` case fact rather than importing §7428's or
//    part IV's own proceeding types (those sections are `unreviewed` this
//    stage) — INTERPRETATION/scope limitation, flagged in the coverage row.
//  - §7463(d) (discontinuance), (e) (amount-in-dispute definition), (f)
//    (extension to §6015(e)/6330(d)(1)(A)/6404(h) petitions) stay
//    `unreviewed` ("stage 2") — only (a)-(c) are in this stage's "fully"
//    list.
//  - §7463(c)'s jurisdictional limitation ("no decision shall be entered
//    ... except with respect to amounts placed in dispute within the
//    limits ... and amounts conceded") is modeled as an immunity of the
//    parties against a decision exceeding the disputed/conceded amounts,
//    protecting the integrity of the small-case ceiling itself.

language "law.core" version "0.2";
package us.irc.judicial_proceedings version "0.1.1";
namespace "urn:us:irc:judicial_proceedings:clir";

use self::{
    IRC_S7459_C,
    IRC_S7459_D,
    IRC_S7459_E,
    IRC_S7463_A,
    IRC_S7463_B,
    IRC_S7463_C,
    Person,
    Proceeding,
    TaxKind,
    TaxableYear,
};


// ============================================================================
// §7459(c) — Date of decision
// ============================================================================

pub relation order_specifying_deficiency_entered(pr: Proceeding, on: Date) kind empirical;
pub relation dismissal_for_lack_of_jurisdiction(pr: Proceeding) kind empirical;
pub relation dismissal_other_reason_amount_undeterminable(pr: Proceeding) kind empirical {
    label en unofficial "the Tax Court dismisses for reasons other than lack of jurisdiction and is unable from the record to determine the amount of the deficiency determined by the Secretary";
}
pub relation dismissal_order_entered(pr: Proceeding, on: Date) kind empirical;
pub relation proceeding_is_part_iv_or_7428_or_6234(pr: Proceeding) kind empirical {
    label en unofficial "the proceeding is a declaratory-judgment proceeding under part IV of this subchapter or §7428, or an action under §6234 (case-input classification; part IV/§7428/§6234 stay unreviewed this stage)";
}
pub relation courts_order_entering_decision(pr: Proceeding, on: Date) kind empirical;
pub relation decision_date(pr: Proceeding, on: Date) kind institutional;

@source(IRC_S7459_C, relation = formalizes, coverage = exact, quote = "A decision of the Tax Court (except a decision dismissing a proceeding for lack of jurisdiction) shall be held to be rendered upon the date that an order specifying the amount of the deficiency is entered in the records of the Tax Court")
pub rule S7459DecisionDateOrdinary strict {
    label en official "A decision of the Tax Court (except a decision dismissing a proceeding for lack of jurisdiction) shall be held to be rendered upon the date that an order specifying the amount of the deficiency is entered in the records of the Tax Court";
    for pr: Proceeding;
    for on: Date;
    when order_specifying_deficiency_entered(pr, on)
        and not_known(dismissal_for_lack_of_jurisdiction(pr));
    then decision_date(pr, on);
}
@source(IRC_S7459_C, relation = formalizes, coverage = exact, quote = "or, in the case of a declaratory judgment proceeding under part IV of this subchapter or under section 7428 or in the case of an action brought under section 6234, the date of the court's order entering the decision")
pub rule S7459DecisionDateDeclaratoryOrPartnership strict {
    label en official "or, in the case of a declaratory judgment proceeding under part IV of this subchapter or under section 7428 or in the case of an action brought under section 6234, the date of the court's order entering the decision";
    for pr: Proceeding;
    for on: Date;
    when proceeding_is_part_iv_or_7428_or_6234(pr)
        and courts_order_entering_decision(pr, on);
    then decision_date(pr, on);
}
@source(IRC_S7459_C, relation = formalizes, coverage = exact, quote = "If the Tax Court dismisses a proceeding for reasons other than lack of jurisdiction and is unable from the record to determine the amount of the deficiency determined by the Secretary, or if the Tax Court dismisses a proceeding for lack of jurisdiction, an order to that effect shall be entered in the records of the Tax Court, and the decision of the Tax Court shall be held to be rendered upon the date of such entry.")
pub rule S7459DecisionDateDismissal strict {
    label en official "If the Tax Court dismisses a proceeding for reasons other than lack of jurisdiction and is unable from the record to determine the amount of the deficiency determined by the Secretary, or if the Tax Court dismisses a proceeding for lack of jurisdiction, an order to that effect shall be entered in the records of the Tax Court, and the decision of the Tax Court shall be held to be rendered upon the date of such entry.";
    for pr: Proceeding;
    for on: Date;
    when dismissal_order_entered(pr, on)
        and dismissal_for_lack_of_jurisdiction(pr);
    then decision_date(pr, on);
}
@source(IRC_S7459_C, relation = formalizes, coverage = exact, quote = "If the Tax Court dismisses a proceeding for reasons other than lack of jurisdiction and is unable from the record to determine the amount of the deficiency determined by the Secretary, or if the Tax Court dismisses a proceeding for lack of jurisdiction, an order to that effect shall be entered in the records of the Tax Court, and the decision of the Tax Court shall be held to be rendered upon the date of such entry.")
pub rule S7459DecisionDateDismissalAmountUndeterminable strict {
    label en official "If the Tax Court dismisses a proceeding for reasons other than lack of jurisdiction and is unable from the record to determine the amount of the deficiency determined by the Secretary, or if the Tax Court dismisses a proceeding for lack of jurisdiction, an order to that effect shall be entered in the records of the Tax Court, and the decision of the Tax Court shall be held to be rendered upon the date of such entry.";
    for pr: Proceeding;
    for on: Date;
    when dismissal_order_entered(pr, on)
        and dismissal_other_reason_amount_undeterminable(pr);
    then decision_date(pr, on);
}

// ============================================================================
// §7459(d) — Effect of decision dismissing petition
// ============================================================================

pub relation petition_for_redetermination_filed(pr: Proceeding, p: Person) kind empirical;
pub relation dismissal_amount_determinable_from_record(pr: Proceeding, p: Person, y: TaxableYear, k: TaxKind, amount: Money) kind empirical {
    label en unofficial "the amount the Secretary determined can be ascertained from the record (so an order specifying that amount can be entered)";
}
pub relation dismissal_deemed_decision_at_secretary_amount(pr: Proceeding, p: Person, y: TaxableYear, k: TaxKind, amount: Money) kind institutional;
@source(IRC_S7459_D, relation = formalizes, coverage = exact, quote = "If a petition for a redetermination of a deficiency has been filed by the taxpayer, a decision of the Tax Court dismissing the proceeding shall be considered as its decision that the deficiency is the amount determined by the Secretary. An order specifying such amount shall be entered in the records of the Tax Court unless the Tax Court cannot determine such amount from the record in the proceeding, or unless the dismissal is for lack of jurisdiction.")
pub rule S7459DismissalDeemedDecisionAtSecretaryAmount strict {
    label en official "If a petition for a redetermination of a deficiency has been filed by the taxpayer, a decision of the Tax Court dismissing the proceeding shall be considered as its decision that the deficiency is the amount determined by the Secretary. An order specifying such amount shall be entered in the records of the Tax Court unless the Tax Court cannot determine such amount from the record in the proceeding, or unless the dismissal is for lack of jurisdiction.";
    for pr: Proceeding;
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for amount: Money;
    when petition_for_redetermination_filed(pr, p)
        and dismissal_amount_determinable_from_record(pr, p, y, k, amount)
        and not_known(dismissal_for_lack_of_jurisdiction(pr));
    then dismissal_deemed_decision_at_secretary_amount(pr, p, y, k, amount);
}

// ============================================================================
// §7459(e) — Effect of decision that tax is barred by limitation
// ============================================================================

pub relation assessment_or_collection_barred_by_limitation(pr: Proceeding, p: Person, y: TaxableYear, k: TaxKind) kind empirical;
pub relation decision_of_no_deficiency(pr: Proceeding, p: Person, y: TaxableYear, k: TaxKind) kind institutional;
@source(IRC_S7459_E, relation = formalizes, coverage = exact, quote = "If the assessment or collection of any tax is barred by any statute of limitations, the decision of the Tax Court to that effect shall be considered as its decision that there is no deficiency in respect of such tax.")
pub rule S7459LimitationDecisionIsNoDeficiency strict {
    label en official "If the assessment or collection of any tax is barred by any statute of limitations, the decision of the Tax Court to that effect shall be considered as its decision that there is no deficiency in respect of such tax.";
    for pr: Proceeding;
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    when assessment_or_collection_barred_by_limitation(pr, p, y, k);
    then decision_of_no_deficiency(pr, p, y, k);
}

// ============================================================================
// §7463(a) — Small tax case election
// ============================================================================

pub relation deficiency_placed_in_dispute(pr: Proceeding, y: TaxableYear, amount: Money) kind empirical;
pub relation overpayment_claimed(pr: Proceeding, y: TaxableYear, amount: Money) kind empirical;
pub relation small_case_ceiling_met(pr: Proceeding, y: TaxableYear) kind institutional {
    label en unofficial "neither the deficiency placed in dispute, nor any claimed overpayment, exceeds $50,000 for the taxable year/period at issue (subtitle A, chapter 11, chapter 12, or the chapter-6212(a) subtitle D case, per (a)(1)-(4)) — the four ceilings are numerically identical ($50,000), so one comparison rule covers all four disjuncts";
}
@source(IRC_S7463_A, relation = formalizes, coverage = partial, quote = "In the case of any petition filed with the Tax Court for a redetermination of a deficiency where neither the amount of the deficiency placed in dispute, nor the amount of any claimed overpayment, exceeds—")
pub rule S7463SmallCaseCeilingDeficiency defeasible {
    label en official "In the case of any petition filed with the Tax Court for a redetermination of a deficiency where neither the amount of the deficiency placed in dispute, nor the amount of any claimed overpayment, exceeds—";
    for pr: Proceeding;
    for y: TaxableYear;
    for amount: Money;
    when deficiency_placed_in_dispute(pr, y, amount)
        and amount <= 50000.00 USD;
    then small_case_ceiling_met(pr, y);
}
@source(IRC_S7463_A, relation = formalizes, coverage = partial, quote = "In the case of any petition filed with the Tax Court for a redetermination of a deficiency where neither the amount of the deficiency placed in dispute, nor the amount of any claimed overpayment, exceeds—")
pub rule S7463SmallCaseCeilingOverpayment defeasible {
    label en official "In the case of any petition filed with the Tax Court for a redetermination of a deficiency where neither the amount of the deficiency placed in dispute, nor the amount of any claimed overpayment, exceeds—";
    for pr: Proceeding;
    for y: TaxableYear;
    for amount: Money;
    when overpayment_claimed(pr, y, amount)
        and amount <= 50000.00 USD;
    then small_case_ceiling_met(pr, y);
}
pub relation taxpayer_elects_small_case_procedure(pr: Proceeding, p: Person) kind empirical;
pub relation tax_court_concurs_in_election(pr: Proceeding) kind empirical {
    label en official "at the option of the taxpayer concurred in by the Tax Court or a division thereof before the hearing of the case";
}
pub relation small_case_election_grounds(pr: Proceeding, y: TaxableYear) kind institutional {
    label en unofficial "single atom folding the §7463(a) dollar ceiling and the Tax Court's concurrence for use in the power's valid_when";
}
@source(IRC_S7463_A, relation = formalizes, coverage = exact, quote = "at the option of the taxpayer concurred in by the Tax Court or a division thereof before the hearing of the case, proceedings in the case shall be conducted under this section")
pub rule S7463SmallCaseElectionGrounds defeasible {
    label en official "at the option of the taxpayer concurred in by the Tax Court or a division thereof before the hearing of the case, proceedings in the case shall be conducted under this section";
    for pr: Proceeding;
    for y: TaxableYear;
    when small_case_ceiling_met(pr, y)
        and tax_court_concurs_in_election(pr);
    then small_case_election_grounds(pr, y);
}
@source(IRC_S7463_A, relation = formalizes, coverage = exact, quote = "at the option of the taxpayer concurred in by the Tax Court or a division thereof before the hearing of the case, proceedings in the case shall be conducted under this section.")
pub rule S7463SmallCaseElectionPowerRule defeasible {
    label en official "at the option of the taxpayer concurred in by the Tax Court or a division thereof before the hearing of the case, proceedings in the case shall be conducted under this section.";
    for pr: Proceeding;
    for p: Person;
    for y: TaxableYear;
    when taxpayer_elects_small_case_procedure(pr, p)
        and small_case_election_grounds(pr, y);
    then power S7463SmallCaseElectionPower {
        holder p;
        exercise taxpayer_elects_small_case_procedure(pr, p);
        valid_when small_case_election_grounds(pr, y);
        effect small_case_procedure_applies(pr);
    };
}
pub relation small_case_procedure_applies(pr: Proceeding) kind institutional;

// ============================================================================
// §7463(b) — Finality of decisions (small cases)
// ============================================================================

@source(IRC_S7463_B, relation = formalizes, coverage = exact, quote = "A decision entered in any case in which the proceedings are conducted under this section shall not be reviewed in any other court and shall not be treated as a precedent for any other case.")
pub rule S7463FinalityImmunity strict {
    label en official "A decision entered in any case in which the proceedings are conducted under this section shall not be reviewed in any other court and shall not be treated as a precedent for any other case.";
    for pr: Proceeding;
    when small_case_procedure_applies(pr);
    then immunity S7463NoReviewImmunity {
        holder us.irc.core::TaxCourt;
        protected_effect small_case_decision_reviewed_elsewhere(pr);
        window [-infinity, infinity];
    };
}
pub relation small_case_decision_reviewed_elsewhere(pr: Proceeding) kind empirical;

// ============================================================================
// §7463(c) — Limitation of jurisdiction
// ============================================================================

pub relation amounts_conceded_by_parties(pr: Proceeding, y: TaxableYear, amount: Money) kind empirical;
pub relation decision_exceeds_small_case_limits(pr: Proceeding, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "a proposed decision would redetermine a deficiency, or determine an overpayment, in an amount exceeding both the §7463(a) disputed limits and any amount conceded by the parties";
}
@source(IRC_S7463_C, relation = formalizes, coverage = exact, quote = "notwithstanding the provisions of sections 6214(a) and 6512(b), no decision shall be entered redetermining the amount of a deficiency, or determining an overpayment, except with respect to amounts placed in dispute within the limits described in subsection (a) and with respect to amounts conceded by the parties")
pub rule S7463JurisdictionalLimitImmunityRule strict {
    label en official "notwithstanding the provisions of sections 6214(a) and 6512(b), no decision shall be entered redetermining the amount of a deficiency, or determining an overpayment, except with respect to amounts placed in dispute within the limits described in subsection (a) and with respect to amounts conceded by the parties";
    for pr: Proceeding;
    for y: TaxableYear;
    for amount: Money;
    when small_case_procedure_applies(pr)
        and decision_exceeds_small_case_limits(pr, y, amount);
    then immunity S7463JurisdictionalLimitImmunity {
        holder us.irc.core::TaxCourt;
        protected_effect decision_exceeds_small_case_limits(pr, y, amount);
        window [-infinity, infinity];
    };
}
