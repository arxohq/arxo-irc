// §7426 (civil actions by persons other than taxpayers) and §7429 (review of
// jeopardy levies and assessments).
//
// METHOD NOTE (§7426(a)(1)): a `power` of the third-party claimant (never
// the assessed taxpayer) to bring a wrongful-levy action; the statute names
// no filing-window condition in (a)(1) itself (the 9-month period is
// §6532(c), a DIFFERENT section this package does not own — modeled as a
// typed dependency `wrongful_levy_suit_timely`, not invented). (a)(2)-(4)
// are modeled as parallel narrower powers of the same shape; (a)(4) alone
// carries an explicit statutory window (120 days from the certificate of
// discharge) which IS modeled exactly.
//
// METHOD NOTE (§7429): (a) is an achievement DUTY of the Secretary (5-day
// window to furnish the written statement) plus a taxpayer POWER (30-day
// window to request review); (b) is the taxpayer's POWER to bring the
// judicial-review action within the exact 90-day window computed from the
// earlier of the two named triggers, plus the court's own 20-day
// determination duty; (g) is an institutional_effect assigning the burden
// of proof (reasonableness → Secretary; amount → taxpayer, itself
// evaluative-adjacent but the statute states it as a flat allocation, not a
// standard requiring judgment — no DECISION-0194 channel needed).
//
// JUDGMENT CALLS AND GAPS:
//  - §7426(a)(1)'s "may bring a civil action ... without regard to whether
//    such property has been surrendered to or sold" is read as a plain
//    grant with no additional validity condition beyond the wrongful-levy
//    claim itself and the (typed, external) §6532(c) timeliness contract.
//  - §7429(a)(2)'s 30-day request-for-review window is modeled as a power
//    of the taxpayer (not a duty) since the statute uses "may request", the
//    correct modality per `rights-positions.md`.
//  - §7429(b)(2) (district court vs. Tax Court jurisdiction split) is
//    modeled only as which court has jurisdiction over the (b) action, not
//    as a further validity condition of the taxpayer's power to sue — a
//    filed-in-the-wrong-court action does not fail the power's
//    `valid_when`, per the text's own §7429(e)(2) transfer-not-dismissal
//    remedy (modeled at (e), out of this stage's "fully" list, left
//    unreviewed).
//  - §7429(c) (extension of the court's 20-day period) is modeled as a
//    narrow power of the court over its own determination duty's window.
//  - §7429(f) (finality, unreviewable) is modeled as an immunity against
//    further review of the §7429(b) determination.

language "law.core" version "0.2";
package us.irc.judicial_proceedings version "0.1.1";
namespace "urn:us:irc:judicial_proceedings:clir";

use self::{
    IRC_S7426_A,
    IRC_S7429_A,
    IRC_S7429_B,
    IRC_S7429_F,
    IRC_S7429_G,
    Levy,
    Person,
    Proceeding,
    jeopardy_determination_deadline_extended,
    jeopardy_review_suit_under_7429b,
};


// ============================================================================
// §7426(a)(1) — Wrongful levy
// ============================================================================

pub relation levy_made_on_property(pr: Proceeding, levy: Levy) kind empirical;
pub relation claimant_interest_or_lien(claimant: Person, levy: Levy) kind empirical {
    label en official "claims an interest in or lien on such property";
}
pub relation claimant_not_assessed_taxpayer(claimant: Person, levy: Levy) kind empirical {
    label en official "other than the person against whom is assessed the tax out of which such levy arose";
}
pub relation wrongful_levy_claimed(claimant: Person, levy: Levy) kind empirical {
    label en official "claims that such property was wrongfully levied upon";
}
pub relation wrongful_levy_suit_timely(pr: Proceeding, claimant: Person, levy: Levy) kind institutional {
    label en unofficial "typed dependency: the §6532(c) 9-month period for a §7426 suit; owned by a section this package does not implement — EXTERNAL_DEPENDENCY";
}
pub relation wrongful_levy_grounds(claimant: Person, levy: Levy) kind institutional {
    label en unofficial "single atom folding (a)(1)'s claimant-standing conditions for use in a power's valid_when";
}
@source(IRC_S7426_A, relation = formalizes, coverage = exact, quote = "any person (other than the person against whom is assessed the tax out of which such levy arose) who claims an interest in or lien on such property and that such property was wrongfully levied upon may bring a civil action against the United States in a district court of the United States")
pub rule S7426WrongfulLevyGrounds strict {
    label en official "any person (other than the person against whom is assessed the tax out of which such levy arose) who claims an interest in or lien on such property and that such property was wrongfully levied upon may bring a civil action against the United States in a district court of the United States";
    for claimant: Person;
    for levy: Levy;
    when claimant_not_assessed_taxpayer(claimant, levy)
        and claimant_interest_or_lien(claimant, levy)
        and wrongful_levy_claimed(claimant, levy);
    then wrongful_levy_grounds(claimant, levy);
}
pub relation wrongful_levy_suit_brought(pr: Proceeding, claimant: Person, levy: Levy) kind empirical;
@source(IRC_S7426_A, relation = formalizes, coverage = exact, quote = "If a levy has been made on property or property has been sold pursuant to a levy, any person (other than the person against whom is assessed the tax out of which such levy arose) who claims an interest in or lien on such property and that such property was wrongfully levied upon may bring a civil action against the United States in a district court of the United States. Such action may be brought without regard to whether such property has been surrendered to or sold by the Secretary.")
pub rule S7426WrongfulLevySuitPowerRule strict {
    label en official "If a levy has been made on property or property has been sold pursuant to a levy, any person (other than the person against whom is assessed the tax out of which such levy arose) who claims an interest in or lien on such property and that such property was wrongfully levied upon may bring a civil action against the United States in a district court of the United States. Such action may be brought without regard to whether such property has been surrendered to or sold by the Secretary.";
    for pr: Proceeding;
    for claimant: Person;
    for levy: Levy;
    when levy_made_on_property(pr, levy)
        and wrongful_levy_suit_brought(pr, claimant, levy);
    then power S7426WrongfulLevySuitPower {
        holder claimant;
        exercise wrongful_levy_suit_brought(pr, claimant, levy);
        valid_when wrongful_levy_grounds(claimant, levy);
        effect wrongful_levy_suit_permitted(pr, claimant, levy);
    };
}
pub relation wrongful_levy_suit_permitted(pr: Proceeding, claimant: Person, levy: Levy) kind institutional;

// ============================================================================
// §7426(a)(4) — Substitution of value (explicit 120-day window)
// ============================================================================

pub relation certificate_of_discharge_issued_under_6325b4(claimant: Person, on: Date) kind empirical;
pub relation substitution_of_value_suit_brought(pr: Proceeding, claimant: Person) kind empirical;
pub relation substitution_of_value_window_end(claimant: Person, issuedOn: Date, deadline: Date) kind institutional;
@source(IRC_S7426_A, relation = formalizes, coverage = exact, quote = "such person may, within 120 days after the day on which such certificate is issued, bring a civil action against the United States in a district court of the United States for a determination of whether the value of the interest of the United States (if any) in such property is less than the value determined by the Secretary")
pub rule S7426SubstitutionOfValueWindow defeasible {
    label en official "such person may, within 120 days after the day on which such certificate is issued, bring a civil action against the United States in a district court of the United States for a determination of whether the value of the interest of the United States (if any) in such property is less than the value determined by the Secretary";
    for claimant: Person;
    for issuedOn: Date;
    when certificate_of_discharge_issued_under_6325b4(claimant, issuedOn);
    then substitution_of_value_window_end(claimant, issuedOn, add_calendar_period(issuedOn, 120 calendar_day));
}
@source(IRC_S7426_A, relation = formalizes, coverage = exact, quote = "If a certificate of discharge is issued to any person under section 6325(b)(4) with respect to any property, such person may, within 120 days after the day on which such certificate is issued, bring a civil action against the United States in a district court of the United States for a determination of whether the value of the interest of the United States (if any) in such property is less than the value determined by the Secretary. No other action may be brought by such person for such a determination.")
pub rule S7426SubstitutionOfValuePowerRule strict {
    label en official "If a certificate of discharge is issued to any person under section 6325(b)(4) with respect to any property, such person may, within 120 days after the day on which such certificate is issued, bring a civil action against the United States in a district court of the United States for a determination of whether the value of the interest of the United States (if any) in such property is less than the value determined by the Secretary. No other action may be brought by such person for such a determination.";
    for pr: Proceeding;
    for claimant: Person;
    for issuedOn: Date;
    for deadline: Date;
    when certificate_of_discharge_issued_under_6325b4(claimant, issuedOn)
        and substitution_of_value_window_end(claimant, issuedOn, deadline)
        and substitution_of_value_suit_brought(pr, claimant);
    then power S7426SubstitutionOfValuePower {
        holder claimant;
        exercise substitution_of_value_suit_brought(pr, claimant);
        valid_when substitution_of_value_window_end(claimant, issuedOn, deadline);
        effect substitution_of_value_suit_permitted(pr, claimant);
    };
}
pub relation substitution_of_value_suit_permitted(pr: Proceeding, claimant: Person) kind institutional;

// ============================================================================
// §7429(a) — Administrative review
// ============================================================================

pub relation jeopardy_assessment_or_levy_made(p: Person, on: Date) kind empirical {
    label en unofficial "an assessment under §6851(a)/6852(a)/6861(a)/6862, or a levy under §6331(a) less than 30 days after notice and demand, is made";
}
pub relation written_statement_furnished(p: Person, on: Date) kind empirical;
@source(IRC_S7429_A, relation = formalizes, coverage = exact, quote = "Within 5 days after the day on which such an assessment or levy is made, the Secretary shall provide the taxpayer with a written statement of the information upon which the Secretary relied in making such assessment or levy.")
pub rule S7429FurnishStatementDuty defeasible {
    label en official "Within 5 days after the day on which such an assessment or levy is made, the Secretary shall provide the taxpayer with a written statement of the information upon which the Secretary relied in making such assessment or levy.";
    for p: Person;
    for madeOn: Date;
    when jeopardy_assessment_or_levy_made(p, madeOn);
    then duty S7429FurnishWrittenStatement {
        bearer us.irc.core::Secretary;
        beneficiary p;
        goal achievement {
            condition written_statement_furnished(p, add_calendar_period(madeOn, 5 calendar_day));
            window [madeOn, add_calendar_period(madeOn, 5 calendar_day)];
        }
    };
}
pub relation taxpayer_requests_review(p: Person, on: Date) kind empirical;
pub relation review_request_window_end(p: Person, furnishedOn: Date, deadline: Date) kind institutional;
@source(IRC_S7429_A, relation = formalizes, coverage = exact, quote = "Within 30 days after the day on which the taxpayer is furnished the written statement described in paragraph (1), or within 30 days after the last day of the period within which such statement is required to be furnished, the taxpayer may request the Secretary to review the action taken.")
pub rule S7429ReviewRequestWindow defeasible {
    label en official "Within 30 days after the day on which the taxpayer is furnished the written statement described in paragraph (1), or within 30 days after the last day of the period within which such statement is required to be furnished, the taxpayer may request the Secretary to review the action taken.";
    for p: Person;
    for furnishedOn: Date;
    for rolled: Date;
    when written_statement_furnished(p, furnishedOn)
        and us.irc.administration::last_day_rolled(add_calendar_period(furnishedOn, 30 calendar_day), rolled);
    then review_request_window_end(p, furnishedOn, rolled);
}
@source(IRC_S7429_A, relation = formalizes, coverage = exact, quote = "Within 30 days after the day on which the taxpayer is furnished the written statement described in paragraph (1), or within 30 days after the last day of the period within which such statement is required to be furnished, the taxpayer may request the Secretary to review the action taken.")
pub rule S7429RequestReviewPowerRule strict {
    label en official "Within 30 days after the day on which the taxpayer is furnished the written statement described in paragraph (1), or within 30 days after the last day of the period within which such statement is required to be furnished, the taxpayer may request the Secretary to review the action taken.";
    for p: Person;
    for furnishedOn: Date;
    for deadline: Date;
    when review_request_window_end(p, furnishedOn, deadline)
        and taxpayer_requests_review(p, furnishedOn);
    then power S7429RequestReviewPower {
        holder p;
        exercise taxpayer_requests_review(p, furnishedOn);
        valid_when review_request_window_end(p, furnishedOn, deadline);
        effect review_requested(p);
    };
}
pub relation review_requested(p: Person) kind institutional;
pub relation secretary_redetermination_made(p: Person, on: Date) kind empirical {
    label en official "the Secretary determines whether the making of the assessment/levy is reasonable and whether the amount is appropriate";
}

// ============================================================================
// §7429(b) — Judicial review
// ============================================================================

pub relation secretary_notifies_determination(p: Person, on: Date) kind empirical;
pub relation judicial_review_window_end(p: Person, start: Date, deadline: Date) kind institutional {
    label en unofficial "the earlier-of trigger (Secretary's notice of determination, or the 16th day after the review request) plus 90 days — modeled as a 16th-day default defeated by an earlier notification (E-0179-style default/defeater pair for an 'earlier of' computation, since the language has no built-in min() over dates)";
}
// Default: the 16th-day-after-request trigger, defeated when notification
// came on or before that day (in which case the notification trigger, being
// earlier or equal, controls per the statute's "earlier of").
@source(IRC_S7429_B, relation = formalizes, coverage = partial, quote = "Within 90 days after the earlier of—")
pub rule S7429JudicialReviewWindowBy16thDay defeasible {
    label en official "Within 90 days after the earlier of—";
    for p: Person;
    for requestedOn: Date;
    for notifiedOn: Date;
    for rolled: Date;
    when taxpayer_requests_review(p, requestedOn)
        and us.irc.administration::last_day_rolled(add_calendar_period(add_calendar_period(requestedOn, 16 calendar_day), 90 calendar_day), rolled);
    then judicial_review_window_end(p, add_calendar_period(requestedOn, 16 calendar_day), rolled);
    unless secretary_notifies_determination(p, notifiedOn)
        and taxpayer_requests_review(p, requestedOn)
        and notifiedOn <= add_calendar_period(requestedOn, 16 calendar_day)
        and us.irc.administration::last_day_rolled(add_calendar_period(add_calendar_period(requestedOn, 16 calendar_day), 90 calendar_day), rolled);
}
@source(IRC_S7429_B, relation = formalizes, coverage = partial, quote = "Within 90 days after the earlier of—")
pub rule S7429JudicialReviewWindowByNotification defeasible {
    label en official "Within 90 days after the earlier of—";
    for p: Person;
    for notifiedOn: Date;
    for requestedOn: Date;
    for rolled: Date;
    when secretary_notifies_determination(p, notifiedOn)
        and taxpayer_requests_review(p, requestedOn)
        and notifiedOn <= add_calendar_period(requestedOn, 16 calendar_day)
        and us.irc.administration::last_day_rolled(add_calendar_period(notifiedOn, 90 calendar_day), rolled);
    then judicial_review_window_end(p, notifiedOn, rolled);
}
pub relation jeopardy_review_suit_brought(pr: Proceeding, p: Person) kind empirical;
@source(IRC_S7429_B, relation = formalizes, coverage = exact, quote = "the taxpayer may bring a civil action against the United States for a determination under this subsection in the court with jurisdiction determined under paragraph (2)")
pub rule S7429JudicialReviewPowerRule strict {
    label en official "the taxpayer may bring a civil action against the United States for a determination under this subsection in the court with jurisdiction determined under paragraph (2)";
    for pr: Proceeding;
    for p: Person;
    for start: Date;
    for deadline: Date;
    when judicial_review_window_end(p, start, deadline)
        and jeopardy_review_suit_brought(pr, p);
    then power S7429JudicialReviewPower {
        holder p;
        exercise jeopardy_review_suit_brought(pr, p);
        valid_when judicial_review_window_end(p, start, deadline);
        effect jeopardy_review_suit_permitted(pr, p);
    };
}
pub relation jeopardy_review_suit_permitted(pr: Proceeding, p: Person) kind institutional;
// bridges 02-anti-injunction-and-refund-suits.law's forward reference:
@source(IRC_S7429_B, relation = applies, coverage = contextual, quote = "the taxpayer may bring a civil action against the United States for a determination under this subsection")
pub rule S7429IsAntiInjunctionException strict {
    label en official "the taxpayer may bring a civil action against the United States for a determination under this subsection";
    for pr: Proceeding;
    for p: Person;
    when jeopardy_review_suit_permitted(pr, p);
    then jeopardy_review_suit_under_7429b(pr, p);
}

pub relation court_commences_proceeding(pr: Proceeding, on: Date) kind empirical;
@source(IRC_S7429_B, relation = formalizes, coverage = partial, quote = "Within 20 days after a proceeding is commenced under paragraph (1), the court shall determine—")
pub rule S7429CourtDeterminationDutyRule defeasible {
    label en official "Within 20 days after a proceeding is commenced under paragraph (1), the court shall determine—";
    for pr: Proceeding;
    for p: Person;
    for commencedOn: Date;
    for extendedTo: Date;
    when jeopardy_review_suit_permitted(pr, p)
        and court_commences_proceeding(pr, commencedOn);
    then duty S7429CourtDeterminationDuty {
        bearer us.irc.core::DistrictCourt;
        beneficiary p;
        goal achievement {
            condition jeopardy_court_determination_made(pr, add_calendar_period(commencedOn, 20 calendar_day));
            window [commencedOn, add_calendar_period(commencedOn, 20 calendar_day)];
        }
    };
    // §7429(c): the 20-day period is replaced by the extended period (module 11).
    unless jeopardy_determination_deadline_extended(pr, p, extendedTo)
        and jeopardy_review_suit_permitted(pr, p)
        and court_commences_proceeding(pr, commencedOn);
}
pub relation jeopardy_court_determination_made(pr: Proceeding, on: Date) kind empirical;

// ============================================================================
// §7429(f) — Finality of determination
// ============================================================================

@source(IRC_S7429_F, relation = formalizes, coverage = exact, quote = "Any determination made by a court under this section shall be final and conclusive and shall not be reviewed by any other court.")
pub rule S7429FinalityImmunityRule strict {
    label en official "Any determination made by a court under this section shall be final and conclusive and shall not be reviewed by any other court.";
    for pr: Proceeding;
    for p: Person;
    for on: Date;
    when jeopardy_court_determination_made(pr, on);
    then immunity S7429FinalityImmunity {
        holder us.irc.core::DistrictCourt;
        protected_effect jeopardy_court_determination_made(pr, on);
        window [-infinity, infinity];
    };
}

// ============================================================================
// §7429(g) — Burden of proof
// ============================================================================

pub relation jeopardy_reasonableness_burden(pr: Proceeding) kind institutional {
    label en unofficial "the burden of proof on whether the levy/assessment is reasonable under the circumstances is on the Secretary";
}
@source(IRC_S7429_G, relation = formalizes, coverage = exact, quote = "In a proceeding under subsection (b) involving the issue of whether the making of a levy described in subsection (a)(1) or the making of an assessment under section 6851, 6852, 6861, or 6862 is reasonable under the circumstances, the burden of proof in respect to such issue shall be upon the Secretary.")
pub rule S7429ReasonablenessBurdenOnSecretary strict {
    label en official "In a proceeding under subsection (b) involving the issue of whether the making of a levy described in subsection (a)(1) or the making of an assessment under section 6851, 6852, 6861, or 6862 is reasonable under the circumstances, the burden of proof in respect to such issue shall be upon the Secretary.";
    for pr: Proceeding;
    for p: Person;
    when jeopardy_review_suit_permitted(pr, p);
    then jeopardy_reasonableness_burden(pr);
}
pub relation jeopardy_amount_burden(pr: Proceeding) kind institutional {
    label en unofficial "the burden of proof on whether the amount assessed or demanded is appropriate under the circumstances is on the taxpayer, once the Secretary has provided the written statement of the basis for the amount";
}
@source(IRC_S7429_G, relation = formalizes, coverage = exact, quote = "In a proceeding under subsection (b) involving the issue of whether an amount assessed or demanded as a result of action taken under section 6851, 6852, 6861, or 6862 is appropriate under the circumstances, the Secretary shall provide a written statement which contains any information with respect to which his determination of the amount assessed was based, but the burden of proof in respect of such issue shall be upon the taxpayer.")
pub rule S7429AmountBurdenOnTaxpayer strict {
    label en official "In a proceeding under subsection (b) involving the issue of whether an amount assessed or demanded as a result of action taken under section 6851, 6852, 6861, or 6862 is appropriate under the circumstances, the Secretary shall provide a written statement which contains any information with respect to which his determination of the amount assessed was based, but the burden of proof in respect of such issue shall be upon the taxpayer.";
    for pr: Proceeding;
    for p: Person;
    for furnishedOn: Date;
    when jeopardy_review_suit_permitted(pr, p)
        and written_statement_furnished(p, furnishedOn);
    then jeopardy_amount_burden(pr);
}
