// Stage 2 — §7448: the Tax Court judicial officers survivors annuity fund.
//
// METHOD NOTE. Judges and special trial judges are `Individual`s (module
// 13). The election of §7448(b) is a POWER of the judicial officer; the
// deductions, deposits and payments are DUTIES of the Treasury or the
// Tax Court. Amounts are exact `Money`: percentages are exact Decimals
// (`3.5 percent`), a ratio is an exact Rational, and each Money result is
// rounded once to cents HALF_UP (the statute names no rounding: JUDGMENT
// CALL, the corpus convention). The recipient order of §7448(j)(1) is a
// cascade of defeasible rules: each lower class is defeated (`unless`)
// when a higher class exists.
//
// JUDGMENT CALLS AND GAPS. (i) "Interest at 3 percent per annum,
// compounded on December 31 of each year" (§7448(d), (g), (j)) is not
// computed: the amount with interest is a typed input (`account_with_interest`)
// because the stub period after the last December 31 is not given
// (TECH-GAPS G2907). (ii) The "average annual salary ... during the period
// of 3 consecutive years in which such judge received the largest" (§7448(m))
// is a maximum over a rolling window and is a typed input (G2908).
// (iii) "The first business day of the month following" (§7448(l)) needs
// the federal business-day calendar of the administration package (G2909).
// (iv) The reduction of the annuity "in accordance with subsection (d)"
// is the 10 percent of the missing deposit; the deposit itself carries the
// interest of item (i). (v) §7448(q) is a historical transition (NON_NORMATIVE).

language "law.core" version "0.2";
package us.irc.judicial_proceedings version "0.1.1";
namespace "urn:us:irc:judicial_proceedings:clir";

use self::{
    IRC_S7448_A,
    IRC_S7448_B,
    IRC_S7448_C,
    IRC_S7448_D,
    IRC_S7448_E,
    IRC_S7448_F,
    IRC_S7448_G,
    IRC_S7448_H,
    IRC_S7448_I,
    IRC_S7448_J,
    IRC_S7448_K,
    IRC_S7448_L,
    IRC_S7448_M,
    IRC_S7448_N,
    IRC_S7448_O,
    IRC_S7448_P,
    IRC_S7448_R,
    IRC_S7448_S,
    IRC_S7448_U,
    Individual,
    JudicialOffice,
    Person,
    President,
    is_chief_judge,
    successor_takes_office_on,
    term_expired_without_reappointment_on,
};

// ============================================================================
// §7448(a) — Definitions
// ============================================================================

pub relation marriage_years_before_death(spouse: Person, j: Individual, years: Integer) kind empirical {
    label en official "shall have been married to such individual for at least 2 years immediately preceding his death";
}
pub relation parent_of_issue_by_marriage(spouse: Person, j: Individual) kind empirical {
    label en official "is a parent of issue by such marriage";
}
pub relation spouse_has_remarried(spouse: Person) kind empirical;
pub relation surviving_spouse_of(spouse: Person, j: Individual) kind institutional;
@source(IRC_S7448_A, relation = formalizes, coverage = exact, quote = "The term \"surviving spouse\" means a surviving spouse of an individual, who either (A) shall have been married to such individual for at least 2 years immediately preceding his death or (B) is a parent of issue by such marriage, and who has not remarried.")
pub rule S7448a8MarriedTwoYears defeasible {
    label en official "The term \"surviving spouse\" means a surviving spouse of an individual, who either (A) shall have been married to such individual for at least 2 years immediately preceding his death or (B) is a parent of issue by such marriage, and who has not remarried.";
    for spouse: Person;
    for j: Individual;
    for years: Integer;
    when marriage_years_before_death(spouse, j, years)
        and years >= 2
        and not_known(spouse_has_remarried(spouse));
    then surviving_spouse_of(spouse, j);
}
@source(IRC_S7448_A, relation = formalizes, coverage = exact, quote = "The term \"surviving spouse\" means a surviving spouse of an individual, who either (A) shall have been married to such individual for at least 2 years immediately preceding his death or (B) is a parent of issue by such marriage, and who has not remarried.")
pub rule S7448a8ParentOfIssue defeasible {
    label en official "The term \"surviving spouse\" means a surviving spouse of an individual, who either (A) shall have been married to such individual for at least 2 years immediately preceding his death or (B) is a parent of issue by such marriage, and who has not remarried.";
    for spouse: Person;
    for j: Individual;
    when parent_of_issue_by_marriage(spouse, j)
        and not_known(spouse_has_remarried(spouse));
    then surviving_spouse_of(spouse, j);
}
pub relation child_of_judicial_officer(child: Person, j: Individual) kind empirical {
    label en official "child, including a dependent stepchild or an adopted child";
}
pub relation child_unmarried(child: Person) kind empirical;
pub relation child_age(child: Person, years: Integer) kind empirical;
pub relation child_incapable_of_self_support_by_disability(child: Person) kind empirical {
    label en official "because of physical or mental disability is incapable of self-support";
}
pub relation dependent_child_of(child: Person, j: Individual) kind institutional;
@source(IRC_S7448_A, relation = formalizes, coverage = exact, quote = "The term \"dependent child\" means an unmarried child, including a dependent stepchild or an adopted child, who is under the age of 18 years or who because of physical or mental disability is incapable of self-support.")
pub rule S7448a9UnderEighteen defeasible {
    label en official "The term \"dependent child\" means an unmarried child, including a dependent stepchild or an adopted child, who is under the age of 18 years or who because of physical or mental disability is incapable of self-support.";
    for child: Person;
    for j: Individual;
    for age: Integer;
    when child_of_judicial_officer(child, j)
        and child_unmarried(child)
        and child_age(child, age)
        and age < 18;
    then dependent_child_of(child, j);
}
@source(IRC_S7448_A, relation = formalizes, coverage = exact, quote = "The term \"dependent child\" means an unmarried child, including a dependent stepchild or an adopted child, who is under the age of 18 years or who because of physical or mental disability is incapable of self-support.")
pub rule S7448a9Disabled defeasible {
    label en official "The term \"dependent child\" means an unmarried child, including a dependent stepchild or an adopted child, who is under the age of 18 years or who because of physical or mental disability is incapable of self-support.";
    for child: Person;
    for j: Individual;
    when child_of_judicial_officer(child, j)
        and child_unmarried(child)
        and child_incapable_of_self_support_by_disability(child);
    then dependent_child_of(child, j);
}
external judgment relation killing_was_assassination(j: Individual) {
    authority TaxCourt;
    label en official "the killing of a judge or special trial judge that is motivated by the performance by the judge or special trial judge of his or her official duties";
}

// ============================================================================
// §7448(b) — Election
// ============================================================================

pub relation survivors_election_made_on(j: Individual, office: JudicialOffice, on: Date) kind empirical;
pub relation survivors_election_while_serving(j: Individual, office: JudicialOffice, on: Date) kind empirical {
    label en official "by written election filed while he is a judge (or, for a special trial judge, filed while such individual is a special trial judge)";
}
pub relation survivors_election_filed_with_chief_judge(j: Individual, office: JudicialOffice) kind empirical {
    label en official "the election shall be filed with the chief judge";
}
pub relation survivors_election_valid(j: Individual, office: JudicialOffice, on: Date) kind institutional;
@source(IRC_S7448_B, relation = formalizes, coverage = exact, quote = "Any judge may by written election filed while he is a judge (except that in the case of an individual who is not reappointed following expiration of his term of office, it may be made at any time before the day after the day on which his successor takes office) bring himself within the purview of this section.")
pub rule S7448b1ElectionWhileJudge defeasible {
    label en official "Any judge may by written election filed while he is a judge (except that in the case of an individual who is not reappointed following expiration of his term of office, it may be made at any time before the day after the day on which his successor takes office) bring himself within the purview of this section.";
    for j: Individual;
    for on: Date;
    when survivors_election_while_serving(j, TaxCourtJudgeOffice, on)
        and survivors_election_filed_with_chief_judge(j, TaxCourtJudgeOffice);
    then survivors_election_valid(j, TaxCourtJudgeOffice, on);
}
@source(IRC_S7448_B, relation = formalizes, coverage = exact, quote = "Any judge may by written election filed while he is a judge (except that in the case of an individual who is not reappointed following expiration of his term of office, it may be made at any time before the day after the day on which his successor takes office) bring himself within the purview of this section.")
pub rule S7448b1ElectionNotReappointed defeasible {
    label en official "Any judge may by written election filed while he is a judge (except that in the case of an individual who is not reappointed following expiration of his term of office, it may be made at any time before the day after the day on which his successor takes office) bring himself within the purview of this section.";
    for j: Individual;
    for on: Date;
    for termEnd: Date;
    for successorOn: Date;
    when term_expired_without_reappointment_on(j, termEnd)
        and successor_takes_office_on(j, successorOn)
        and survivors_election_made_on(j, TaxCourtJudgeOffice, on)
        and survivors_election_filed_with_chief_judge(j, TaxCourtJudgeOffice)
        and on <= successorOn;
    then survivors_election_valid(j, TaxCourtJudgeOffice, on);
}
@source(IRC_S7448_B, relation = formalizes, coverage = exact, quote = "Any special trial judge may by written election filed with the chief judge elect the application of this section.")
pub rule S7448b2SpecialTrialJudgeElection defeasible {
    label en official "Any special trial judge may by written election filed with the chief judge elect the application of this section.";
    for j: Individual;
    for on: Date;
    when survivors_election_while_serving(j, SpecialTrialJudgeOffice, on)
        and survivors_election_filed_with_chief_judge(j, SpecialTrialJudgeOffice);
    then survivors_election_valid(j, SpecialTrialJudgeOffice, on);
}
pub relation survivors_annuity_election_in_effect(j: Individual, office: JudicialOffice) kind institutional;
@source(IRC_S7448_B, relation = formalizes, coverage = exact, quote = "Any judge may by written election filed while he is a judge (except that in the case of an individual who is not reappointed following expiration of his term of office, it may be made at any time before the day after the day on which his successor takes office) bring himself within the purview of this section.")
pub rule S7448bElectionPowerRule defeasible {
    label en official "Any judge may by written election filed while he is a judge (except that in the case of an individual who is not reappointed following expiration of his term of office, it may be made at any time before the day after the day on which his successor takes office) bring himself within the purview of this section.";
    for j: Individual;
    for office: JudicialOffice;
    for on: Date;
    when survivors_election_made_on(j, office, on);
    then power S7448bElectSurvivorsAnnuity {
        holder j;
        exercise survivors_election_made_on(j, office, on);
        valid_when survivors_election_valid(j, office, on);
        effect create(survivors_annuity_election_in_effect(j, office));
    };
}
pub relation civil_service_benefits_waived(j: Individual) kind institutional;
@source(IRC_S7448_R, relation = formalizes, coverage = exact, quote = "Any judge electing under subsection (b) shall, at the time of such election, waive all benefits under the civil service retirement laws.")
pub rule S7448rWaiverAtElection strict {
    label en official "Any judge electing under subsection (b) shall, at the time of such election, waive all benefits under the civil service retirement laws.";
    for j: Individual;
    for office: JudicialOffice;
    when survivors_annuity_election_in_effect(j, office)
        and office == TaxCourtJudgeOffice;
    then civil_service_benefits_waived(j);
}

// ============================================================================
// §7448(c)-(f) — Fund, deductions, deposits, investment, crediting
// ============================================================================

pub relation judicial_salary_for_survivors_fund(j: Individual, salary: Money) kind institutional {
    label en official "such judge's or special trial judge's salary";
}
pub relation survivors_fund_deduction(j: Individual, amount: Money) kind institutional {
    label en unofficial "3.5 percent of the salary of a judge or special trial judge electing under subsection (b), deducted and withheld";
}
@source(IRC_S7448_C, relation = formalizes, coverage = exact, quote = "There shall be deducted and withheld from the salary of each judge or special trial judge electing under subsection (b) a sum equal to 3.5 percent of such judge's or special trial judge's salary.")
pub rule S7448c1Deduction strict {
    label en official "There shall be deducted and withheld from the salary of each judge or special trial judge electing under subsection (b) a sum equal to 3.5 percent of such judge's or special trial judge's salary.";
    for j: Individual;
    for office: JudicialOffice;
    for salary: Money;
    when survivors_annuity_election_in_effect(j, office)
        and judicial_salary_for_survivors_fund(j, salary);
    then survivors_fund_deduction(j, round(salary * 3.5 percent, 2, "HALF_UP"));
}
pub relation survivors_fund_deduction_withheld(j: Individual, amount: Money) kind empirical;
@source(IRC_S7448_C, relation = formalizes, coverage = exact, quote = "There shall be deducted and withheld from the salary of each judge or special trial judge electing under subsection (b) a sum equal to 3.5 percent of such judge's or special trial judge's salary.")
pub rule S7448c1DeductionDutyRule strict {
    label en official "There shall be deducted and withheld from the salary of each judge or special trial judge electing under subsection (b) a sum equal to 3.5 percent of such judge's or special trial judge's salary.";
    for j: Individual;
    for amount: Money;
    when survivors_fund_deduction(j, amount);
    then duty S7448c1WithholdDeduction {
        bearer us.irc.core::TaxCourt;
        beneficiary j;
        goal achievement {
            condition survivors_fund_deduction_withheld(j, amount);
            window [-infinity, infinity];
        }
    };
}
pub relation survivors_fund_fiscal_year(fy: Integer, startsOn: Date, endsOn: Date) kind empirical;
pub relation unfunded_liability_of_fund(fy: Integer, amount: Money) kind institutional {
    label en official "the amount estimated by the Secretary to be equal to the excess (as of the close of the fiscal year involved) of the present value of all benefits payable from the survivors annuity fund over the present values of future deductions and deposits plus the balance in such fund";
}
pub relation salary_and_annuity_amounts_paid_in_fiscal_year(fy: Integer, amount: Money) kind empirical {
    label en official "the aggregate amounts described in subsection (a)(4) and (a)(6) paid during such fiscal year";
}
pub relation required_unfunded_liability_deposit(fy: Integer, amount: Money) kind institutional {
    label en unofficial "the amount required to reduce the unfunded liability to zero, not exceeding 11 percent of the aggregate amounts paid during the fiscal year";
}
@source(IRC_S7448_C, relation = formalizes, coverage = exact, quote = "The amount required by subparagraph (A) to be deposited in any fiscal year shall not exceed an amount equal to 11 percent of the aggregate amounts described in subsection (a)(4) and (a)(6) paid during such fiscal year.")
pub rule S7448c2BDepositCapped strict {
    label en official "The amount required by subparagraph (A) to be deposited in any fiscal year shall not exceed an amount equal to 11 percent of the aggregate amounts described in subsection (a)(4) and (a)(6) paid during such fiscal year.";
    for fy: Integer;
    for unfunded: Money;
    for paid: Money;
    when unfunded_liability_of_fund(fy, unfunded)
        and salary_and_annuity_amounts_paid_in_fiscal_year(fy, paid)
        and unfunded > round(paid * 11 percent, 2, "HALF_UP");
    then required_unfunded_liability_deposit(fy, round(paid * 11 percent, 2, "HALF_UP"));
}
@source(IRC_S7448_C, relation = formalizes, coverage = exact, quote = "amounts required to reduce to zero the unfunded liability (if any) of such fund.")
pub rule S7448c2ADepositReducesToZero strict {
    label en official "amounts required to reduce to zero the unfunded liability (if any) of such fund.";
    for fy: Integer;
    for unfunded: Money;
    for paid: Money;
    when unfunded_liability_of_fund(fy, unfunded)
        and salary_and_annuity_amounts_paid_in_fiscal_year(fy, paid)
        and unfunded <= round(paid * 11 percent, 2, "HALF_UP");
    then required_unfunded_liability_deposit(fy, unfunded);
}
pub relation unfunded_liability_deposit_made(fy: Integer, amount: Money) kind empirical;
@source(IRC_S7448_C, relation = formalizes, coverage = exact, quote = "Not later than the close of each fiscal year, there shall be deposited in the Treasury of the United States to the credit of the survivors annuity fund")
pub rule S7448c2ADepositDutyRule strict {
    label en official "Not later than the close of each fiscal year, there shall be deposited in the Treasury of the United States to the credit of the survivors annuity fund";
    for fy: Integer;
    for startsOn: Date;
    for endsOn: Date;
    for amount: Money;
    when survivors_fund_fiscal_year(fy, startsOn, endsOn)
        and required_unfunded_liability_deposit(fy, amount);
    then duty S7448c2ADepositUnfundedLiability {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition unfunded_liability_deposit_made(fy, amount);
            window [startsOn, endsOn];
        }
    };
}
pub relation appropriated_deposit_credited_to_individual_account(j: Individual) kind empirical {
    label en official "Amounts appropriated pursuant to this paragraph shall not be credited to the account of any individual for purposes of subsection (g)";
}
pub relation appropriated_deposit_not_creditable_to_account(fy: Integer) kind institutional;
@source(IRC_S7448_C, relation = formalizes, coverage = exact, quote = "Amounts appropriated pursuant to this paragraph shall not be credited to the account of any individual for purposes of subsection (g).")
pub rule S7448c2DNotCreditedToAccounts strict {
    label en official "Amounts appropriated pursuant to this paragraph shall not be credited to the account of any individual for purposes of subsection (g).";
    for fy: Integer;
    for amount: Money;
    when unfunded_liability_deposit_made(fy, amount);
    then appropriated_deposit_not_creditable_to_account(fy);
}
pub relation deposit_base_salary_or_pay(j: Individual, base: Money) kind empirical {
    label en official "his judge's or special trial judge's salary and his basic salary, pay, or compensation for service as a Senator, Representative, Delegate, or Resident Commissioner in Congress, and for any other civilian service within the purview of sections 8332 and 8411 of title 5";
}
pub relation required_survivors_fund_deposit(j: Individual, base: Money, amount: Money) kind institutional;
@source(IRC_S7448_D, relation = formalizes, coverage = exact, quote = "a sum equal to 3.5 percent of his judge's or special trial judge's salary and of his basic salary, pay, or compensation for service as a Senator, Representative, Delegate, or Resident Commissioner in Congress, and for any other civilian service within the purview of sections 8332 and 8411 of title 5 of the United States Code.")
pub rule S7448dRequiredDeposit strict {
    label en official "a sum equal to 3.5 percent of his judge's or special trial judge's salary and of his basic salary, pay, or compensation for service as a Senator, Representative, Delegate, or Resident Commissioner in Congress, and for any other civilian service within the purview of sections 8332 and 8411 of title 5 of the United States Code.";
    for j: Individual;
    for office: JudicialOffice;
    for base: Money;
    when survivors_annuity_election_in_effect(j, office)
        and deposit_base_salary_or_pay(j, base);
    then required_survivors_fund_deposit(j, base, round(base * 3.5 percent, 2, "HALF_UP"));
}
pub relation survivors_fund_deposit_made(j: Individual, amount: Money) kind empirical;
@source(IRC_S7448_D, relation = formalizes, coverage = exact, quote = "Each judge or special trial judge electing under subsection (b) shall deposit, with interest at 3 percent per annum, compounded on December 31 of each year, to the credit of the survivors annuity fund")
pub rule S7448dDepositDutyRule strict {
    label en official "Each judge or special trial judge electing under subsection (b) shall deposit, with interest at 3 percent per annum, compounded on December 31 of each year, to the credit of the survivors annuity fund";
    for j: Individual;
    for base: Money;
    for amount: Money;
    when required_survivors_fund_deposit(j, base, amount);
    then duty S7448dMakeDeposit {
        bearer j;
        goal achievement {
            condition survivors_fund_deposit_made(j, amount);
            window [-infinity, infinity];
        }
    };
}
pub relation deposit_amount_not_made(j: Individual, deposit: Money) kind empirical {
    label en official "a judge or special trial judge fails to make such deposit (the amount of the deposit, computed as of the date of death)";
}
pub relation spouse_elects_to_eliminate_service_from_credit(spouse: Person, j: Individual) kind empirical;
pub relation annuity_reduction_for_missing_deposit(j: Individual, spouse: Person, reduction: Money) kind institutional;
@source(IRC_S7448_D, relation = formalizes, coverage = exact, quote = "but the annuity of the surviving spouse of such judge or special trial judge shall be reduced by an amount equal to 10 percent of the amount of such deposit, computed as of the date of the death of such judge or special trial judge, unless such surviving spouse shall elect to eliminate such service entirely from credit under subsection (n)")
pub rule S7448dTenPercentReduction defeasible {
    label en official "but the annuity of the surviving spouse of such judge or special trial judge shall be reduced by an amount equal to 10 percent of the amount of such deposit, computed as of the date of the death of such judge or special trial judge, unless such surviving spouse shall elect to eliminate such service entirely from credit under subsection (n)";
    for j: Individual;
    for spouse: Person;
    for deposit: Money;
    when deposit_amount_not_made(j, deposit)
        and surviving_spouse_of(spouse, j);
    then annuity_reduction_for_missing_deposit(j, spouse, round(deposit * 10 percent, 2, "HALF_UP"));
    unless spouse_elects_to_eliminate_service_from_credit(spouse, j) and deposit_amount_not_made(j, deposit);
}
pub relation surplus_portion_of_fund(amount: Money) kind empirical {
    label en official "such portions of the survivors annuity fund as in his judgment may not be immediately required for the payment of the annuities, refunds, and allowances as provided in this section";
}
pub relation surplus_of_fund_invested(amount: Money) kind empirical;
@source(IRC_S7448_E, relation = formalizes, coverage = exact, quote = "The Secretary of the Treasury shall invest from time to time, in interest-bearing securities of the United States or Federal farm loan bonds, such portions of the survivors annuity fund as in his judgment may not be immediately required")
pub rule S7448eInvestmentDutyRule strict {
    label en official "The Secretary of the Treasury shall invest from time to time, in interest-bearing securities of the United States or Federal farm loan bonds, such portions of the survivors annuity fund as in his judgment may not be immediately required";
    for amount: Money;
    when surplus_portion_of_fund(amount);
    then duty S7448eInvestSurplus {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition surplus_of_fund_invested(amount);
            window [-infinity, infinity];
        }
    };
}
pub relation deposit_or_deduction_made_for(j: Individual, amount: Money) kind empirical;
pub relation credited_to_individual_account(j: Individual, amount: Money) kind institutional;
@source(IRC_S7448_F, relation = formalizes, coverage = exact, quote = "The amount deposited by or deducted and withheld from the salary of each judge or special trial judge electing to bring himself within the purview of this section for credit to the survivors annuity fund shall be credited to an individual account of such judge or special trial judge.")
pub rule S7448fCreditedToIndividualAccount strict {
    label en official "The amount deposited by or deducted and withheld from the salary of each judge or special trial judge electing to bring himself within the purview of this section for credit to the survivors annuity fund shall be credited to an individual account of such judge or special trial judge.";
    for j: Individual;
    for amount: Money;
    when deposit_or_deduction_made_for(j, amount);
    then credited_to_individual_account(j, amount);
}

// ============================================================================
// §7448(g) — Termination: return of the individual account
// ============================================================================

pub relation service_terminated_other_than_under_7447(j: Individual) kind empirical {
    label en official "the service of any judge or special trial judge electing under subsection (b) terminates other than pursuant to the provisions of section 7447";
}
pub relation ceased_to_be_married_and_revoked_election(j: Individual) kind empirical {
    label en official "any judge or special trial judge ceases to be married after making the election under subsection (b) and revokes (in a writing filed as provided in subsection (b)) such election";
}
pub relation account_with_interest(j: Individual, amount: Money) kind empirical {
    label en official "the amount credited to his individual account, together with interest at 3 percent per annum, compounded on December 31 of each year, to the date of his relinquishment of office (typed input: TECH-GAPS G2907)";
}
pub relation account_return_due(j: Individual, amount: Money) kind institutional;
@source(IRC_S7448_G, relation = formalizes, coverage = exact, quote = "If the service of any judge or special trial judge electing under subsection (b) terminates other than pursuant to the provisions of section 7447")
pub rule S7448gReturnOnTermination defeasible {
    label en official "If the service of any judge or special trial judge electing under subsection (b) terminates other than pursuant to the provisions of section 7447";
    for j: Individual;
    for amount: Money;
    when service_terminated_other_than_under_7447(j)
        and account_with_interest(j, amount);
    then account_return_due(j, amount);
}
@source(IRC_S7448_G, relation = formalizes, coverage = exact, quote = "or if any judge or special trial judge ceases to be married after making the election under subsection (b) and revokes (in a writing filed as provided in subsection (b)) such election")
pub rule S7448gReturnOnRevocation defeasible {
    label en official "or if any judge or special trial judge ceases to be married after making the election under subsection (b) and revokes (in a writing filed as provided in subsection (b)) such election";
    for j: Individual;
    for amount: Money;
    when ceased_to_be_married_and_revoked_election(j)
        and account_with_interest(j, amount);
    then account_return_due(j, amount);
}
pub relation term_expired_but_elected_retired_pay(j: Individual) kind empirical {
    label en official "not reappointed following expiration of his term but who, at the time of such expiration, is eligible for and elects to receive retired pay under section 7447";
}
@source(IRC_S7448_G, relation = formalizes, coverage = exact, quote = "For the purpose of this section, the service of any judge or special trial judge electing under subsection (b) who is not reappointed following expiration of his term but who, at the time of such expiration, is eligible for and elects to receive retired pay under section 7447 shall be deemed to have terminated pursuant to said section.")
pub rule S7448gTermEndWithRetiredPayIsUnder7447 strict {
    label en official "For the purpose of this section, the service of any judge or special trial judge electing under subsection (b) who is not reappointed following expiration of his term but who, at the time of such expiration, is eligible for and elects to receive retired pay under section 7447 shall be deemed to have terminated pursuant to said section.";
    for j: Individual;
    when term_expired_but_elected_retired_pay(j);
    then service_terminated_under_7447(j);
}
pub relation service_terminated_under_7447(j: Individual) kind institutional;
pub relation account_returned_to_judicial_officer(j: Individual, amount: Money) kind empirical;
@source(IRC_S7448_G, relation = formalizes, coverage = exact, quote = "the amount credited to his individual account, together with interest at 3 percent per annum, compounded on December 31 of each year, to the date of his relinquishment of office, shall be returned to him.")
pub rule S7448gReturnDutyRule defeasible {
    label en official "the amount credited to his individual account, together with interest at 3 percent per annum, compounded on December 31 of each year, to the date of his relinquishment of office, shall be returned to him.";
    for j: Individual;
    for amount: Money;
    when account_return_due(j, amount);
    then duty S7448gReturnAccount {
        bearer us.irc.core::Secretary;
        beneficiary j;
        goal achievement {
            condition account_returned_to_judicial_officer(j, amount);
            window [-infinity, infinity];
        }
    };
}

// ============================================================================
// §7448(h) — Entitlement to annuity
// ============================================================================

pub relation months_of_civilian_service_with_deductions(j: Individual, months: Integer) kind empirical {
    label en official "at least 18 months of civilian service computed as prescribed in subsection (n), for the last 18 months of which the salary deductions or the deposits required have actually been made";
}
pub relation judicial_officer_died_in_office_on(j: Individual, on: Date) kind empirical {
    label en official "dies while a judge or special trial judge";
}
pub relation judicial_officer_died_by_assassination_on(j: Individual, on: Date) kind empirical;
pub relation deductions_or_deposits_made_for_service_period(j: Individual) kind empirical;
pub relation covered_by_survivors_annuity(j: Individual, diedOn: Date) kind institutional {
    label en unofficial "the judicial officer elected under §7448(b) and died in office after 18 months of civilian service (with deductions or deposits made), or by assassination with less service if the deductions or deposits were made";
}
@source(IRC_S7448_H, relation = formalizes, coverage = exact, quote = "(A) who dies while a judge or special trial judge after having rendered at least 18 months of civilian service computed as prescribed in subsection (n), for the last 18 months of which the salary deductions provided for by subsection (c)(1) or the deposits required by subsection (d) have actually been made or the salary deductions required by the civil service retirement laws have actually been made, or")
pub rule S7448h2ADiedAfter18Months defeasible {
    label en official "(A) who dies while a judge or special trial judge after having rendered at least 18 months of civilian service computed as prescribed in subsection (n), for the last 18 months of which the salary deductions provided for by subsection (c)(1) or the deposits required by subsection (d) have actually been made or the salary deductions required by the civil service retirement laws have actually been made, or";
    for j: Individual;
    for office: JudicialOffice;
    for diedOn: Date;
    for months: Integer;
    when survivors_annuity_election_in_effect(j, office)
        and judicial_officer_died_in_office_on(j, diedOn)
        and months_of_civilian_service_with_deductions(j, months)
        and months >= 18;
    then covered_by_survivors_annuity(j, diedOn);
}
@source(IRC_S7448_H, relation = formalizes, coverage = exact, quote = "(B) who dies by assassination after having rendered less than 18 months of civilian service computed as prescribed in subsection (n) if, for the period of such service, the salary deductions provided for by subsection (c)(1) or the deposits required by subsection (d) have actually been made.")
pub rule S7448h2BAssassinationShortService defeasible {
    label en official "(B) who dies by assassination after having rendered less than 18 months of civilian service computed as prescribed in subsection (n) if, for the period of such service, the salary deductions provided for by subsection (c)(1) or the deposits required by subsection (d) have actually been made.";
    for j: Individual;
    for office: JudicialOffice;
    for diedOn: Date;
    for months: Integer;
    when survivors_annuity_election_in_effect(j, office)
        and judicial_officer_died_by_assassination_on(j, diedOn)
        and killing_was_assassination(j)
        and months_of_civilian_service_with_deductions(j, months)
        and months < 18
        and deductions_or_deposits_made_for_service_period(j);
    then covered_by_survivors_annuity(j, diedOn);
}
pub relation average_annual_salary_for_annuity(j: Individual, amount: Money) kind institutional {
    label en official "the average annual salary received during the period of 3 consecutive years in which such judge or special trial judge received the largest such average annual salary (typed input: TECH-GAPS G2908)";
}
pub relation spouse_attains_age_50_on(spouse: Person, on: Date) kind empirical;
pub relation dependent_child_count(j: Individual, n: Integer) kind empirical;
pub relation surviving_spouse_annuity_start(spouse: Person, j: Individual, on: Date) kind institutional {
    label en unofficial "with no dependent child, the annuity begins on the day of death or on the surviving spouse's attainment of age 50, whichever is the later; with a dependent child, on the day of death";
}
@source(IRC_S7448_H, relation = formalizes, coverage = exact, quote = "If a judge or special trial judge described in paragraph (2) is survived by a surviving spouse but not by a dependent child, there shall be paid to such surviving spouse an annuity beginning with the day of the death of the judge or special trial judge or following the surviving spouse's attainment of age 50, whichever is the later, in an amount computed as provided in subsection (m).")
pub rule S7448h1ASpouseStartAtDeathLater defeasible {
    label en official "If a judge or special trial judge described in paragraph (2) is survived by a surviving spouse but not by a dependent child, there shall be paid to such surviving spouse an annuity beginning with the day of the death of the judge or special trial judge or following the surviving spouse's attainment of age 50, whichever is the later, in an amount computed as provided in subsection (m).";
    for spouse: Person;
    for j: Individual;
    for diedOn: Date;
    for ageDate: Date;
    when covered_by_survivors_annuity(j, diedOn)
        and surviving_spouse_of(spouse, j)
        and dependent_child_count(j, 0)
        and spouse_attains_age_50_on(spouse, ageDate)
        and diedOn >= ageDate;
    then surviving_spouse_annuity_start(spouse, j, diedOn);
}
@source(IRC_S7448_H, relation = formalizes, coverage = exact, quote = "If a judge or special trial judge described in paragraph (2) is survived by a surviving spouse but not by a dependent child, there shall be paid to such surviving spouse an annuity beginning with the day of the death of the judge or special trial judge or following the surviving spouse's attainment of age 50, whichever is the later, in an amount computed as provided in subsection (m).")
pub rule S7448h1ASpouseStartAtAge50Later defeasible {
    label en official "If a judge or special trial judge described in paragraph (2) is survived by a surviving spouse but not by a dependent child, there shall be paid to such surviving spouse an annuity beginning with the day of the death of the judge or special trial judge or following the surviving spouse's attainment of age 50, whichever is the later, in an amount computed as provided in subsection (m).";
    for spouse: Person;
    for j: Individual;
    for diedOn: Date;
    for ageDate: Date;
    when covered_by_survivors_annuity(j, diedOn)
        and surviving_spouse_of(spouse, j)
        and dependent_child_count(j, 0)
        and spouse_attains_age_50_on(spouse, ageDate)
        and diedOn < ageDate;
    then surviving_spouse_annuity_start(spouse, j, ageDate);
}
@source(IRC_S7448_H, relation = formalizes, coverage = exact, quote = "there shall be paid to such surviving spouse an annuity, beginning on the day of the death of the judge or special trial judge, in an amount computed as provided in subsection (m)")
pub rule S7448h1BSpouseStartAtDeathWithChildren defeasible {
    label en official "there shall be paid to such surviving spouse an annuity, beginning on the day of the death of the judge or special trial judge, in an amount computed as provided in subsection (m)";
    for spouse: Person;
    for j: Individual;
    for diedOn: Date;
    for n: Integer;
    when covered_by_survivors_annuity(j, diedOn)
        and surviving_spouse_of(spouse, j)
        and dependent_child_count(j, n)
        and n >= 1;
    then surviving_spouse_annuity_start(spouse, j, diedOn);
}
pub relation child_annuity_amount(child: Person, j: Individual, amount: Money) kind institutional {
    label en unofficial "the annuity of a dependent child: with a surviving spouse the lesser of 10 percent of the average annual salary or 20 percent divided by the number of children; with no surviving spouse the lesser of 20 percent or 40 percent divided by the number of children";
}
pub relation judicial_officer_left_surviving_spouse(j: Individual) kind empirical;
@source(IRC_S7448_H, relation = formalizes, coverage = exact, quote = "(i) 10 percent of the average annual salary of such judge or special trial judge (determined in accordance with subsection (m)), or")
pub rule S7448h1BChildWithSpouseTenPercentLesser defeasible {
    label en official "(i) 10 percent of the average annual salary of such judge or special trial judge (determined in accordance with subsection (m)), or";
    for child: Person;
    for j: Individual;
    for diedOn: Date;
    for avg: Money;
    for n: Integer;
    when covered_by_survivors_annuity(j, diedOn)
        and judicial_officer_left_surviving_spouse(j)
        and dependent_child_of(child, j)
        and average_annual_salary_for_annuity(j, avg)
        and dependent_child_count(j, n)
        and n >= 1
        and round(avg * 10 percent, 2, "HALF_UP") <= round(round(avg * 20 percent, 2, "HALF_UP") * (1 / n), 2, "HALF_UP");
    then child_annuity_amount(child, j, round(avg * 10 percent, 2, "HALF_UP"));
}
@source(IRC_S7448_H, relation = formalizes, coverage = exact, quote = "(ii) 20 percent of such average annual salary, divided by the number of such children.")
pub rule S7448h1BChildWithSpouseSharedTwentyLesser defeasible {
    label en official "(ii) 20 percent of such average annual salary, divided by the number of such children.";
    for child: Person;
    for j: Individual;
    for diedOn: Date;
    for avg: Money;
    for n: Integer;
    when covered_by_survivors_annuity(j, diedOn)
        and judicial_officer_left_surviving_spouse(j)
        and dependent_child_of(child, j)
        and average_annual_salary_for_annuity(j, avg)
        and dependent_child_count(j, n)
        and n >= 1
        and round(avg * 10 percent, 2, "HALF_UP") > round(round(avg * 20 percent, 2, "HALF_UP") * (1 / n), 2, "HALF_UP");
    then child_annuity_amount(child, j, round(round(avg * 20 percent, 2, "HALF_UP") * (1 / n), 2, "HALF_UP"));
}
@source(IRC_S7448_H, relation = formalizes, coverage = exact, quote = "(i) 20 percent of the average annual salary of such judge or special trial judge (determined in accordance with subsection (m)), or")
pub rule S7448h1CChildNoSpouseTwentyLesser defeasible {
    label en official "(i) 20 percent of the average annual salary of such judge or special trial judge (determined in accordance with subsection (m)), or";
    for child: Person;
    for j: Individual;
    for diedOn: Date;
    for avg: Money;
    for n: Integer;
    when covered_by_survivors_annuity(j, diedOn)
        and dependent_child_of(child, j)
        and average_annual_salary_for_annuity(j, avg)
        and dependent_child_count(j, n)
        and n >= 1
        and not_known(judicial_officer_left_surviving_spouse(j))
        and round(avg * 20 percent, 2, "HALF_UP") <= round(round(avg * 40 percent, 2, "HALF_UP") * (1 / n), 2, "HALF_UP");
    then child_annuity_amount(child, j, round(avg * 20 percent, 2, "HALF_UP"));
}
@source(IRC_S7448_H, relation = formalizes, coverage = exact, quote = "(ii) 40 percent of such average annual salary divided by the number of such children.")
pub rule S7448h1CChildNoSpouseSharedFortyLesser defeasible {
    label en official "(ii) 40 percent of such average annual salary divided by the number of such children.";
    for child: Person;
    for j: Individual;
    for diedOn: Date;
    for avg: Money;
    for n: Integer;
    when covered_by_survivors_annuity(j, diedOn)
        and dependent_child_of(child, j)
        and average_annual_salary_for_annuity(j, avg)
        and dependent_child_count(j, n)
        and n >= 1
        and not_known(judicial_officer_left_surviving_spouse(j))
        and round(avg * 20 percent, 2, "HALF_UP") > round(round(avg * 40 percent, 2, "HALF_UP") * (1 / n), 2, "HALF_UP");
    then child_annuity_amount(child, j, round(round(avg * 40 percent, 2, "HALF_UP") * (1 / n), 2, "HALF_UP"));
}
pub relation spouse_remarried_before_55(spouse: Person, on: Date) kind empirical {
    label en official "such surviving spouse's remarriage before attaining age 55";
}
pub relation surviving_spouse_died_on(spouse: Person, on: Date) kind empirical;
pub relation spouse_annuity_terminates_on(spouse: Person, j: Individual, on: Date) kind institutional;
@source(IRC_S7448_H, relation = formalizes, coverage = exact, quote = "The annuity payable to a surviving spouse under this subsection shall be terminable upon such surviving spouse's death or such surviving spouse's remarriage before attaining age 55.")
pub rule S7448h3ATerminatesOnDeath defeasible {
    label en official "The annuity payable to a surviving spouse under this subsection shall be terminable upon such surviving spouse's death or such surviving spouse's remarriage before attaining age 55.";
    for spouse: Person;
    for j: Individual;
    for on: Date;
    when surviving_spouse_of(spouse, j)
        and surviving_spouse_died_on(spouse, on);
    then spouse_annuity_terminates_on(spouse, j, on);
}
@source(IRC_S7448_H, relation = formalizes, coverage = exact, quote = "The annuity payable to a surviving spouse under this subsection shall be terminable upon such surviving spouse's death or such surviving spouse's remarriage before attaining age 55.")
pub rule S7448h3ATerminatesOnRemarriageBefore55 strict {
    label en official "The annuity payable to a surviving spouse under this subsection shall be terminable upon such surviving spouse's death or such surviving spouse's remarriage before attaining age 55.";
    for spouse: Person;
    for j: Individual;
    for on: Date;
    when parent_of_issue_or_married_two_years(spouse, j)
        and spouse_remarried_before_55(spouse, on);
    then spouse_annuity_terminates_on(spouse, j, on);
}
pub relation parent_of_issue_or_married_two_years(spouse: Person, j: Individual) kind institutional {
    label en unofficial "the person was the judicial officer's spouse within §7448(a)(8) before remarriage (bridge that does not depend on the not-remarried condition)";
}
@source(IRC_S7448_A, relation = formalizes, coverage = exact, quote = "The term \"surviving spouse\" means a surviving spouse of an individual, who either (A) shall have been married to such individual for at least 2 years immediately preceding his death or (B) is a parent of issue by such marriage, and who has not remarried.")
pub rule S7448a8BridgeMarried strict {
    label en official "The term \"surviving spouse\" means a surviving spouse of an individual, who either (A) shall have been married to such individual for at least 2 years immediately preceding his death or (B) is a parent of issue by such marriage, and who has not remarried.";
    for spouse: Person;
    for j: Individual;
    for years: Integer;
    when marriage_years_before_death(spouse, j, years)
        and years >= 2;
    then parent_of_issue_or_married_two_years(spouse, j);
}
@source(IRC_S7448_A, relation = formalizes, coverage = exact, quote = "The term \"surviving spouse\" means a surviving spouse of an individual, who either (A) shall have been married to such individual for at least 2 years immediately preceding his death or (B) is a parent of issue by such marriage, and who has not remarried.")
pub rule S7448a8BridgeParent strict {
    label en official "The term \"surviving spouse\" means a surviving spouse of an individual, who either (A) shall have been married to such individual for at least 2 years immediately preceding his death or (B) is a parent of issue by such marriage, and who has not remarried.";
    for spouse: Person;
    for j: Individual;
    when parent_of_issue_by_marriage(spouse, j);
    then parent_of_issue_or_married_two_years(spouse, j);
}
pub relation child_reached_18_on(child: Person, on: Date) kind empirical;
pub relation child_married_on(child: Person, on: Date) kind empirical;
pub relation child_died_on(child: Person, on: Date) kind empirical;
pub relation child_disability_ended_on(child: Person, on: Date) kind empirical {
    label en official "recovery from such disability";
}
pub relation child_annuity_terminates_on(child: Person, j: Individual, on: Date) kind institutional;
@source(IRC_S7448_H, relation = formalizes, coverage = exact, quote = "(i) the child's attainment of age 18,")
pub rule S7448h3BAge18 defeasible {
    label en official "(i) the child's attainment of age 18,";
    for child: Person;
    for j: Individual;
    for on: Date;
    when dependent_child_of(child, j)
        and child_reached_18_on(child, on)
        and not_known(child_incapable_of_self_support_by_disability(child));
    then child_annuity_terminates_on(child, j, on);
}
@source(IRC_S7448_H, relation = formalizes, coverage = exact, quote = "(ii) the child's marriage, or")
pub rule S7448h3BMarriage defeasible {
    label en official "(ii) the child's marriage, or";
    for child: Person;
    for j: Individual;
    for on: Date;
    when dependent_child_of(child, j)
        and child_married_on(child, on);
    then child_annuity_terminates_on(child, j, on);
}
@source(IRC_S7448_H, relation = formalizes, coverage = exact, quote = "(iii) the child's death,")
pub rule S7448h3BDeath defeasible {
    label en official "(iii) the child's death,";
    for child: Person;
    for j: Individual;
    for on: Date;
    when dependent_child_of(child, j)
        and child_died_on(child, on);
    then child_annuity_terminates_on(child, j, on);
}
@source(IRC_S7448_H, relation = formalizes, coverage = exact, quote = "except that if such child is incapable of self-support by reason of mental or physical disability the child's annuity shall be terminable only upon death, marriage, or recovery from such disability.")
pub rule S7448h3BRecoveryFromDisability defeasible {
    label en official "except that if such child is incapable of self-support by reason of mental or physical disability the child's annuity shall be terminable only upon death, marriage, or recovery from such disability.";
    for child: Person;
    for j: Individual;
    for on: Date;
    when dependent_child_of(child, j)
        and child_incapable_of_self_support_by_disability(child)
        and child_disability_ended_on(child, on);
    then child_annuity_terminates_on(child, j, on);
}
pub relation assassinated_survivor_deduction(j: Individual, amount: Money) kind institutional;
pub relation salary_deductions_for_18_months(j: Individual, amount: Money) kind empirical {
    label en official "an amount equal to the amount of salary deductions that would have been made if such deductions had been made for 18 months prior to the death";
}
@source(IRC_S7448_H, relation = formalizes, coverage = exact, quote = "In the case of a survivor of a judge or special trial judge described in paragraph (2)(B), there shall be deducted from the annuities otherwise payable under this section an amount equal to the amount of salary deductions that would have been made if such deductions had been made for 18 months prior to the death of the judge or special trial judge.")
pub rule S7448h3EAssassinatedDeduction defeasible {
    label en official "In the case of a survivor of a judge or special trial judge described in paragraph (2)(B), there shall be deducted from the annuities otherwise payable under this section an amount equal to the amount of salary deductions that would have been made if such deductions had been made for 18 months prior to the death of the judge or special trial judge.";
    for j: Individual;
    for diedOn: Date;
    for amount: Money;
    when covered_by_survivors_annuity(j, diedOn)
        and judicial_officer_died_by_assassination_on(j, diedOn)
        and salary_deductions_for_18_months(j, amount);
    then assassinated_survivor_deduction(j, amount);
}

// ============================================================================
// §7448(i) — Determination by the chief judge
// ============================================================================

external judgment relation dependency_or_disability_question_determined(j: Individual, child: Person) {
    authority TaxCourt;
    label en official "Questions of dependency and disability arising under this section shall be determined by the chief judge subject to review only by the Tax Court, the decision of which shall be final and conclusive";
}
pub relation applicant_child_fails_ordered_examination(child: Person) kind empirical {
    label en official "failure to submit to any examination so ordered or directed";
}
pub relation child_annuity_suspended_or_denied(child: Person) kind institutional;
@source(IRC_S7448_I, relation = formalizes, coverage = exact, quote = "and may suspend or deny any such annuity for failure to submit to any examination so ordered or directed.")
pub rule S7448i1SuspendOrDenyForFailure strict {
    label en official "and may suspend or deny any such annuity for failure to submit to any examination so ordered or directed.";
    for child: Person;
    when applicant_child_fails_ordered_examination(child);
    then child_annuity_suspended_or_denied(child);
}
pub relation federal_agency_investigates_killing(agencyHead: Person, j: Individual) kind empirical;
pub relation information_provided_to_chief_judge(agencyHead: Person, j: Individual) kind empirical;
@source(IRC_S7448_I, relation = formalizes, coverage = exact, quote = "The head of any Federal agency that investigates the killing of a judge or special trial judge shall provide to the chief judge any information that would assist the chief judge in making such a determination.")
pub rule S7448i2AgencyInformationDutyRule strict {
    label en official "The head of any Federal agency that investigates the killing of a judge or special trial judge shall provide to the chief judge any information that would assist the chief judge in making such a determination.";
    for agencyHead: Person;
    for j: Individual;
    when federal_agency_investigates_killing(agencyHead, j);
    then duty S7448i2ProvideInformationToChiefJudge {
        bearer agencyHead;
        goal achievement {
            condition information_provided_to_chief_judge(agencyHead, j);
            window [-infinity, infinity];
        }
    };
}

// ============================================================================
// §7448(j) — Payments in certain cases (lump sum; order of precedence)
// ============================================================================

pub relation civilian_service_years_at_death(j: Individual, years: Integer) kind empirical;
pub relation no_survivor_entitled_to_annuity(j: Individual) kind empirical {
    label en official "without a survivor or survivors entitled to annuity benefits provided by subsection (h)";
}
pub relation all_annuity_rights_terminated_before_valid_claim(j: Individual) kind empirical {
    label en official "the right of all persons entitled to annuity under subsection (h) based on the service of such judge or special trial judge shall terminate before a valid claim therefor shall have been established";
}
pub relation account_with_interest_at_death(j: Individual, amount: Money) kind empirical {
    label en official "the total amount credited to the individual account of such judge or special trial judge, with interest at 3 percent per annum, compounded on December 31 of each year, to the date of the death (typed input: TECH-GAPS G2907)";
}
pub relation lump_sum_payment_due(j: Individual, amount: Money) kind institutional;
@source(IRC_S7448_J, relation = formalizes, coverage = exact, quote = "(A) a judge or special trial judge electing under subsection (b) shall die while in office (whether in regular active service, retired from such service under section 7447, or receiving any annuity under chapter 83 or 84 of title 5, United States Code), before having rendered 5 years of civilian service computed as prescribed in subsection (n)")
pub rule S7448j1AShortService defeasible {
    label en official "(A) a judge or special trial judge electing under subsection (b) shall die while in office (whether in regular active service, retired from such service under section 7447, or receiving any annuity under chapter 83 or 84 of title 5, United States Code), before having rendered 5 years of civilian service computed as prescribed in subsection (n)";
    for j: Individual;
    for office: JudicialOffice;
    for diedOn: Date;
    for years: Integer;
    for amount: Money;
    when survivors_annuity_election_in_effect(j, office)
        and judicial_officer_died_in_office_on(j, diedOn)
        and civilian_service_years_at_death(j, years)
        and years < 5
        and account_with_interest_at_death(j, amount);
    then lump_sum_payment_due(j, amount);
}
@source(IRC_S7448_J, relation = formalizes, coverage = exact, quote = "or after having rendered 5 years of such civilian service but without a survivor or survivors entitled to annuity benefits provided by subsection (h)")
pub rule S7448j1ANoSurvivor defeasible {
    label en official "or after having rendered 5 years of such civilian service but without a survivor or survivors entitled to annuity benefits provided by subsection (h)";
    for j: Individual;
    for office: JudicialOffice;
    for diedOn: Date;
    for years: Integer;
    for amount: Money;
    when survivors_annuity_election_in_effect(j, office)
        and judicial_officer_died_in_office_on(j, diedOn)
        and civilian_service_years_at_death(j, years)
        and years >= 5
        and no_survivor_entitled_to_annuity(j)
        and account_with_interest_at_death(j, amount);
    then lump_sum_payment_due(j, amount);
}
@source(IRC_S7448_J, relation = formalizes, coverage = exact, quote = "(B) the right of all persons entitled to annuity under subsection (h) based on the service of such judge or special trial judge shall terminate before a valid claim therefor shall have been established")
pub rule S7448j1BRightsTerminated defeasible {
    label en official "(B) the right of all persons entitled to annuity under subsection (h) based on the service of such judge or special trial judge shall terminate before a valid claim therefor shall have been established";
    for j: Individual;
    for amount: Money;
    when all_annuity_rights_terminated_before_valid_claim(j)
        and account_with_interest_at_death(j, amount);
    then lump_sum_payment_due(j, amount);
}
pub relation designated_beneficiary_by_writing(j: Individual, p: Person) kind empirical {
    label en official "the beneficiary or beneficiaries whom the judge or special trial judge may have designated by a writing filed prior to his death with the chief judge";
}
pub relation child_or_descendant_of_judicial_officer(j: Individual, p: Person) kind empirical;
pub relation parent_of_judicial_officer(j: Individual, p: Person) kind empirical;
pub relation executor_or_administrator_of_estate(j: Individual, p: Person) kind empirical;
pub relation next_of_kin_determined_by_chief_judge(j: Individual, p: Person) kind empirical;
pub relation designated_beneficiary_exists(j: Individual) kind institutional;
rule S7448j1ExistsDesignated strict {
    for j: Individual;
    for p: Person;
    when designated_beneficiary_by_writing(j, p);
    then designated_beneficiary_exists(j);
}
pub relation surviving_spouse_exists(j: Individual) kind institutional;
rule S7448j1ExistsSpouse defeasible {
    for j: Individual;
    for spouse: Person;
    when surviving_spouse_of(spouse, j);
    then surviving_spouse_exists(j);
}
pub relation child_exists(j: Individual) kind institutional;
rule S7448j1ExistsChild strict {
    for j: Individual;
    for p: Person;
    when child_or_descendant_of_judicial_officer(j, p);
    then child_exists(j);
}
pub relation parent_exists(j: Individual) kind institutional;
rule S7448j1ExistsParent strict {
    for j: Individual;
    for p: Person;
    when parent_of_judicial_officer(j, p);
    then parent_exists(j);
}
pub relation executor_exists(j: Individual) kind institutional;
rule S7448j1ExistsExecutor strict {
    for j: Individual;
    for p: Person;
    when executor_or_administrator_of_estate(j, p);
    then executor_exists(j);
}
pub relation lump_sum_recipient(j: Individual, p: Person) kind institutional {
    label en unofficial "the person entitled to the lump-sum payment under the order of precedence of §7448(j)(1): designated beneficiary, surviving spouse, children and descendants, parents, executor or administrator, other next of kin";
}
@source(IRC_S7448_J, relation = formalizes, coverage = exact, quote = "(i) to the beneficiary or beneficiaries whom the judge or special trial judge may have designated by a writing filed prior to his death with the chief judge")
pub rule S7448j1iDesignated defeasible {
    label en official "(i) to the beneficiary or beneficiaries whom the judge or special trial judge may have designated by a writing filed prior to his death with the chief judge";
    for j: Individual;
    for p: Person;
    when lump_sum_payment_due_exists(j)
        and designated_beneficiary_by_writing(j, p);
    then lump_sum_recipient(j, p);
}
pub relation lump_sum_payment_due_exists(j: Individual) kind institutional;
rule S7448j1DueExists defeasible {
    for j: Individual;
    for amount: Money;
    when lump_sum_payment_due(j, amount);
    then lump_sum_payment_due_exists(j);
}
@source(IRC_S7448_J, relation = formalizes, coverage = exact, quote = "(ii) if there be no such beneficiary, to the surviving spouse of such judge or special trial judge;")
pub rule S7448j1iiSpouse defeasible {
    label en official "(ii) if there be no such beneficiary, to the surviving spouse of such judge or special trial judge;";
    for j: Individual;
    for spouse: Person;
    when lump_sum_payment_due_exists(j)
        and surviving_spouse_of(spouse, j);
    then lump_sum_recipient(j, spouse);
    unless designated_beneficiary_exists(j) and surviving_spouse_of(spouse, j);
}
@source(IRC_S7448_J, relation = formalizes, coverage = exact, quote = "(iii) if none of the above, to the child or children of such judge or special trial judge and the descendants of any deceased children by representation;")
pub rule S7448j1iiiChildren defeasible {
    label en official "(iii) if none of the above, to the child or children of such judge or special trial judge and the descendants of any deceased children by representation;";
    for j: Individual;
    for p: Person;
    when lump_sum_payment_due_exists(j)
        and child_or_descendant_of_judicial_officer(j, p);
    then lump_sum_recipient(j, p);
    unless designated_beneficiary_exists(j) and child_or_descendant_of_judicial_officer(j, p);
    unless surviving_spouse_exists(j) and child_or_descendant_of_judicial_officer(j, p);
}
@source(IRC_S7448_J, relation = formalizes, coverage = exact, quote = "(iv) if none of the above, to the parents of such judge or special trial judge or the survivor of them;")
pub rule S7448j1ivParents defeasible {
    label en official "(iv) if none of the above, to the parents of such judge or special trial judge or the survivor of them;";
    for j: Individual;
    for p: Person;
    when lump_sum_payment_due_exists(j)
        and parent_of_judicial_officer(j, p);
    then lump_sum_recipient(j, p);
    unless designated_beneficiary_exists(j) and parent_of_judicial_officer(j, p);
    unless surviving_spouse_exists(j) and parent_of_judicial_officer(j, p);
    unless child_exists(j) and parent_of_judicial_officer(j, p);
}
@source(IRC_S7448_J, relation = formalizes, coverage = exact, quote = "(v) if none of the above, to the duly appointed executor or administrator of the estate of such judge or special trial judge; and")
pub rule S7448j1vExecutor defeasible {
    label en official "(v) if none of the above, to the duly appointed executor or administrator of the estate of such judge or special trial judge; and";
    for j: Individual;
    for p: Person;
    when lump_sum_payment_due_exists(j)
        and executor_or_administrator_of_estate(j, p);
    then lump_sum_recipient(j, p);
    unless designated_beneficiary_exists(j) and executor_or_administrator_of_estate(j, p);
    unless surviving_spouse_exists(j) and executor_or_administrator_of_estate(j, p);
    unless child_exists(j) and executor_or_administrator_of_estate(j, p);
    unless parent_exists(j) and executor_or_administrator_of_estate(j, p);
}
@source(IRC_S7448_J, relation = formalizes, coverage = exact, quote = "(vi) if none of the above, to such other next of kin of such judge or special trial judge as may be determined by the chief judge to be entitled under the laws of the domicile of such judge or special trial judge at the time of his death.")
pub rule S7448j1viNextOfKin defeasible {
    label en official "(vi) if none of the above, to such other next of kin of such judge or special trial judge as may be determined by the chief judge to be entitled under the laws of the domicile of such judge or special trial judge at the time of his death.";
    for j: Individual;
    for p: Person;
    when lump_sum_payment_due_exists(j)
        and next_of_kin_determined_by_chief_judge(j, p);
    then lump_sum_recipient(j, p);
    unless designated_beneficiary_exists(j) and next_of_kin_determined_by_chief_judge(j, p);
    unless surviving_spouse_exists(j) and next_of_kin_determined_by_chief_judge(j, p);
    unless child_exists(j) and next_of_kin_determined_by_chief_judge(j, p);
    unless parent_exists(j) and next_of_kin_determined_by_chief_judge(j, p);
    unless executor_exists(j) and next_of_kin_determined_by_chief_judge(j, p);
}
pub relation annuities_paid_in_aggregate(j: Individual, amount: Money) kind empirical {
    label en official "the aggregate amount of annuity paid";
}
pub relation annuity_shortfall_payment_due(j: Individual, amount: Money) kind institutional;
@source(IRC_S7448_J, relation = formalizes, coverage = exact, quote = "(2) In any case in which the annuities of all persons entitled to annuity based upon the service of a judge or special trial judge shall terminate before the aggregate amount of annuity paid equals the total amount credited to the individual account of such judge or special trial judge, with interest at 3 percent per annum, compounded on December 31 of each year, to the date of the death of such judge or special trial judge, the difference shall be paid, upon establishment of a valid claim therefor, in the order of precedence prescribed in paragraph (1).")
pub rule S7448j2Difference defeasible {
    label en official "(2) In any case in which the annuities of all persons entitled to annuity based upon the service of a judge or special trial judge shall terminate before the aggregate amount of annuity paid equals the total amount credited to the individual account of such judge or special trial judge, with interest at 3 percent per annum, compounded on December 31 of each year, to the date of the death of such judge or special trial judge, the difference shall be paid, upon establishment of a valid claim therefor, in the order of precedence prescribed in paragraph (1).";
    for j: Individual;
    for accountAmount: Money;
    for paid: Money;
    when all_annuity_rights_terminated_before_valid_claim_or_terminated(j)
        and account_with_interest_at_death(j, accountAmount)
        and annuities_paid_in_aggregate(j, paid)
        and paid < accountAmount;
    then annuity_shortfall_payment_due(j, accountAmount - paid);
}
pub relation all_annuity_rights_terminated_before_valid_claim_or_terminated(j: Individual) kind empirical {
    label en official "the annuities of all persons entitled to annuity based upon the service of the judge or special trial judge shall terminate";
}

// ============================================================================
// §7448(k), (l), (o), (s), (u) — Payees, assignment, coordination, increases
// ============================================================================

pub relation payee_under_legal_disability(claimant: Person) kind empirical {
    label en official "a minor, or a person mentally incompetent or under other legal disability adjudged by a court of competent jurisdiction";
}
pub relation guardian_or_fiduciary_under_state_law(claimant: Person, guardian: Person) kind empirical;
pub relation payment_may_be_made_to(claimant: Person, payee: Person) kind institutional;
@source(IRC_S7448_K, relation = formalizes, coverage = exact, quote = "such payment may be made to the person who is constituted guardian or other fiduciary by the law of the State of residence of such claimant or is otherwise legally vested with the care of the claimant or his estate.")
pub rule S7448kPaymentToGuardian strict {
    label en official "such payment may be made to the person who is constituted guardian or other fiduciary by the law of the State of residence of such claimant or is otherwise legally vested with the care of the claimant or his estate.";
    for claimant: Person;
    for guardian: Person;
    when payee_under_legal_disability(claimant)
        and guardian_or_fiduciary_under_state_law(claimant, guardian);
    then payment_may_be_made_to(claimant, guardian);
}
pub relation chief_judge_determines_person_vested_with_care(claimant: Person, person: Person) kind empirical;
@source(IRC_S7448_K, relation = formalizes, coverage = exact, quote = "Where no guardian or other fiduciary of the person under legal disability has been appointed under the laws of the State of residence of the claimant, the chief judge shall determine the person who is otherwise legally vested with the care of the claimant or his estate.")
pub rule S7448kChiefJudgeDetermines defeasible {
    label en official "Where no guardian or other fiduciary of the person under legal disability has been appointed under the laws of the State of residence of the claimant, the chief judge shall determine the person who is otherwise legally vested with the care of the claimant or his estate.";
    for claimant: Person;
    for person: Person;
    when payee_under_legal_disability(claimant)
        and chief_judge_determines_person_vested_with_care(claimant, person)
        and not_known(has_guardian_appointed(claimant));
    then payment_may_be_made_to(claimant, person);
}
pub relation has_guardian_appointed(claimant: Person) kind institutional;
rule S7448kGuardianExists strict {
    for claimant: Person;
    for guardian: Person;
    when guardian_or_fiduciary_under_state_law(claimant, guardian);
    then has_guardian_appointed(claimant);
}
pub relation execution_or_assignment_against_annuity_moneys(claimant: Person) kind empirical {
    label en official "any assignment, either in law or in equity, or execution, levy, attachment, garnishment, or other legal process against the moneys mentioned in this section";
}
pub relation annuity_payee(claimant: Person) kind empirical;
@source(IRC_S7448_L, relation = formalizes, coverage = exact, quote = "None of the moneys mentioned in this section shall be assignable, either in law or in equity, or subject to execution, levy, attachment, garnishment, or other legal process.")
pub rule S7448lNoAssignmentImmunityRule strict {
    label en official "None of the moneys mentioned in this section shall be assignable, either in law or in equity, or subject to execution, levy, attachment, garnishment, or other legal process.";
    for claimant: Person;
    when annuity_payee(claimant);
    then immunity S7448lAnnuityImmunity {
        holder claimant;
        protected_effect execution_or_assignment_against_annuity_moneys(claimant);
        window [-infinity, infinity];
    };
}
pub relation simultaneous_annuity_permitted(spouse: Person) kind institutional;
pub relation spouse_eligible_for_other_annuity(spouse: Person) kind empirical;
@source(IRC_S7448_O, relation = formalizes, coverage = exact, quote = "Nothing contained in this section shall be construed to prevent a surviving spouse eligible therefor from simultaneously receiving an annuity under this section and any annuity to which such spouse would otherwise be entitled under any other law without regard to this section")
pub rule S7448oSimultaneousEntitlement strict {
    label en official "Nothing contained in this section shall be construed to prevent a surviving spouse eligible therefor from simultaneously receiving an annuity under this section and any annuity to which such spouse would otherwise be entitled under any other law without regard to this section";
    for spouse: Person;
    when spouse_eligible_for_other_annuity(spouse);
    then simultaneous_annuity_permitted(spouse);
}
pub relation annuity_before_increase(annuity: Money) kind empirical;
pub relation civil_service_increase_percent(percent: Decimal) kind empirical {
    label en official "the percentage by which annuities are increased under section 8340(b) of title 5, United States Code";
}
pub relation increased_survivor_annuity(annuity: Money, increased: Money) kind institutional;
@source(IRC_S7448_S, relation = formalizes, coverage = exact, quote = "each annuity payable from the survivors annuity fund under this section shall be increased at the same time by the same percentage by which annuities are increased under such section 8340(b).")
pub rule S7448sIncreasedByCivilServicePercent strict {
    label en official "each annuity payable from the survivors annuity fund under this section shall be increased at the same time by the same percentage by which annuities are increased under such section 8340(b).";
    for annuity: Money;
    for percent: Decimal;
    when annuity_before_increase(annuity)
        and civil_service_increase_percent(percent);
    then increased_survivor_annuity(annuity, annuity + round(annuity * percent, 2, "HALF_UP"));
}
pub relation survivor_annuity_under_7448(annuity: Money) kind empirical;
pub relation chapter_81_benefits_for_year(benefits: Money) kind empirical {
    label en official "benefits under chapter 81 of title 5, United States Code";
}
pub relation current_salary_of_office_for_year(salary: Money) kind empirical {
    label en official "the current salary for that year of the office of the judge or special trial judge";
}
pub relation assassination_annuity_payable(annuity: Money, payable: Money) kind institutional;
@source(IRC_S7448_U, relation = formalizes, coverage = exact, quote = "except that the annuity for which a surviving spouse is eligible under this section shall be reduced to the extent that the total benefits paid under this section and chapter 81 of that title for any year would exceed the current salary for that year of the office of the judge or special trial judge.")
pub rule S7448uWithinSalary strict {
    label en official "except that the annuity for which a surviving spouse is eligible under this section shall be reduced to the extent that the total benefits paid under this section and chapter 81 of that title for any year would exceed the current salary for that year of the office of the judge or special trial judge.";
    for annuity: Money;
    for benefits: Money;
    for salary: Money;
    when survivor_annuity_under_7448(annuity)
        and chapter_81_benefits_for_year(benefits)
        and current_salary_of_office_for_year(salary)
        and annuity + benefits <= salary;
    then assassination_annuity_payable(annuity, annuity);
}
@source(IRC_S7448_U, relation = formalizes, coverage = exact, quote = "except that the annuity for which a surviving spouse is eligible under this section shall be reduced to the extent that the total benefits paid under this section and chapter 81 of that title for any year would exceed the current salary for that year of the office of the judge or special trial judge.")
pub rule S7448uReducedToSalary strict {
    label en official "except that the annuity for which a surviving spouse is eligible under this section shall be reduced to the extent that the total benefits paid under this section and chapter 81 of that title for any year would exceed the current salary for that year of the office of the judge or special trial judge.";
    for annuity: Money;
    for benefits: Money;
    for salary: Money;
    when survivor_annuity_under_7448(annuity)
        and chapter_81_benefits_for_year(benefits)
        and current_salary_of_office_for_year(salary)
        and annuity + benefits > salary
        and benefits <= salary;
    then assassination_annuity_payable(annuity, salary - benefits);
}

// ============================================================================
// §7448(m), (n) — Computation of the surviving spouse's annuity; includible service
// ============================================================================

pub relation years_of_judicial_service(j: Individual, years: Decimal) kind empirical {
    label en official "the judge's or special trial judge's years of such judicial service (including service as a member of the Board of Tax Appeals, judge of the Tax Court of the United States, and special trial judge)";
}
pub relation years_of_prior_congressional_member_service(j: Individual, years: Decimal) kind empirical {
    label en official "years of prior allowable service as a Senator, Representative, Delegate, or Resident Commissioner in Congress";
}
pub relation years_of_active_armed_forces_service(j: Individual, years: Decimal) kind empirical {
    label en official "years of active service as a member of the Armed Forces of the United States, not including any such service for which credit is allowed for the purposes of retirement or retired pay under any other provision of law";
}
pub relation years_of_prior_congressional_employee_service(j: Individual, years: Decimal) kind empirical {
    label en official "years of prior allowable service performed as a congressional employee (as defined in section 2107 of title 5 of the United States Code)";
}
pub relation years_of_other_prior_allowable_service(j: Individual, years: Decimal) kind empirical {
    label en official "the judge's years of any other prior allowable service";
}
pub relation includible_armed_forces_years(j: Individual, years: Decimal) kind institutional;
@source(IRC_S7448_N, relation = formalizes, coverage = exact, quote = "his years of active service as a member of the Armed Forces of the United States not exceeding 5 years in the aggregate")
pub rule S7448nArmedForcesWithinFive strict {
    label en official "his years of active service as a member of the Armed Forces of the United States not exceeding 5 years in the aggregate";
    for j: Individual;
    for years: Decimal;
    when years_of_active_armed_forces_service(j, years)
        and years <= 5.0;
    then includible_armed_forces_years(j, years);
}
@source(IRC_S7448_N, relation = formalizes, coverage = exact, quote = "his years of active service as a member of the Armed Forces of the United States not exceeding 5 years in the aggregate")
pub rule S7448nArmedForcesCappedAtFive strict {
    label en official "his years of active service as a member of the Armed Forces of the United States not exceeding 5 years in the aggregate";
    for j: Individual;
    for years: Decimal;
    when years_of_active_armed_forces_service(j, years)
        and years > 5.0;
    then includible_armed_forces_years(j, 5.0);
}
pub relation includible_congressional_employee_years(j: Individual, years: Decimal) kind institutional;
@source(IRC_S7448_M, relation = formalizes, coverage = exact, quote = "(iv) the judge's or special trial judge's years, not exceeding 15, of prior allowable service performed as a congressional employee (as defined in section 2107 of title 5 of the United States Code), plus")
pub rule S7448mCongressionalEmployeeWithinFifteen strict {
    label en official "(iv) the judge's or special trial judge's years, not exceeding 15, of prior allowable service performed as a congressional employee (as defined in section 2107 of title 5 of the United States Code), plus";
    for j: Individual;
    for years: Decimal;
    when years_of_prior_congressional_employee_service(j, years)
        and years <= 15.0;
    then includible_congressional_employee_years(j, years);
}
@source(IRC_S7448_M, relation = formalizes, coverage = exact, quote = "(iv) the judge's or special trial judge's years, not exceeding 15, of prior allowable service performed as a congressional employee (as defined in section 2107 of title 5 of the United States Code), plus")
pub rule S7448mCongressionalEmployeeCappedAtFifteen strict {
    label en official "(iv) the judge's or special trial judge's years, not exceeding 15, of prior allowable service performed as a congressional employee (as defined in section 2107 of title 5 of the United States Code), plus";
    for j: Individual;
    for years: Decimal;
    when years_of_prior_congressional_employee_service(j, years)
        and years > 15.0;
    then includible_congressional_employee_years(j, 15.0);
}
pub relation annuity_service_years_at_one_and_a_half_percent(j: Individual, years: Decimal) kind institutional;
@source(IRC_S7448_M, relation = formalizes, coverage = exact, quote = "(B) the sum of—")
pub rule S7448m1BSumOfServiceYears strict {
    label en official "(B) the sum of—";
    for j: Individual;
    for judicial: Decimal;
    for congress: Decimal;
    for armed: Decimal;
    for employee: Decimal;
    when years_of_judicial_service(j, judicial)
        and years_of_prior_congressional_member_service(j, congress)
        and includible_armed_forces_years(j, armed)
        and includible_congressional_employee_years(j, employee);
    then annuity_service_years_at_one_and_a_half_percent(j, ((judicial + congress) + armed) + employee);
}
pub relation annuity_before_limits(j: Individual, amount: Money) kind institutional {
    label en unofficial "1.5 percent of the average annual salary times the sum of includible service years, plus three-fourths of 1 percent of that salary times the years of any other prior allowable service";
}
@source(IRC_S7448_M, relation = formalizes, coverage = exact, quote = "(2) three-fourths of 1 percent of such average annual salary multiplied by the judge's years of any other prior allowable service,")
pub rule S7448mFormula strict {
    label en official "(2) three-fourths of 1 percent of such average annual salary multiplied by the judge's years of any other prior allowable service,";
    for j: Individual;
    for avg: Money;
    for yearsMain: Decimal;
    for yearsOther: Decimal;
    when average_annual_salary_for_annuity(j, avg)
        and annuity_service_years_at_one_and_a_half_percent(j, yearsMain)
        and years_of_other_prior_allowable_service(j, yearsOther);
    then annuity_before_limits(j, round((avg * 1.5 percent * yearsMain) + (avg * 0.75 percent * yearsOther), 2, "HALF_UP"));
}
pub relation surviving_spouse_annuity_amount(j: Individual, amount: Money) kind institutional {
    label en unofficial "the annuity of the surviving spouse: the computed amount, not exceeding 50 percent nor less than 25 percent of the average annual salary (before any reduction in accordance with subsection (d))";
}
@source(IRC_S7448_M, relation = formalizes, coverage = exact, quote = "except that such annuity shall not exceed an amount equal to 50 percent of such average annual salary, nor be less than an amount equal to 25 percent of such average annual salary")
pub rule S7448mAboveCap strict {
    label en official "except that such annuity shall not exceed an amount equal to 50 percent of such average annual salary, nor be less than an amount equal to 25 percent of such average annual salary";
    for j: Individual;
    for avg: Money;
    for amount: Money;
    when average_annual_salary_for_annuity(j, avg)
        and annuity_before_limits(j, amount)
        and amount > round(avg * 50 percent, 2, "HALF_UP");
    then surviving_spouse_annuity_amount(j, round(avg * 50 percent, 2, "HALF_UP"));
}
@source(IRC_S7448_M, relation = formalizes, coverage = exact, quote = "except that such annuity shall not exceed an amount equal to 50 percent of such average annual salary, nor be less than an amount equal to 25 percent of such average annual salary")
pub rule S7448mBelowFloor strict {
    label en official "except that such annuity shall not exceed an amount equal to 50 percent of such average annual salary, nor be less than an amount equal to 25 percent of such average annual salary";
    for j: Individual;
    for avg: Money;
    for amount: Money;
    when average_annual_salary_for_annuity(j, avg)
        and annuity_before_limits(j, amount)
        and amount < round(avg * 25 percent, 2, "HALF_UP");
    then surviving_spouse_annuity_amount(j, round(avg * 25 percent, 2, "HALF_UP"));
}
@source(IRC_S7448_M, relation = formalizes, coverage = exact, quote = "except that such annuity shall not exceed an amount equal to 50 percent of such average annual salary, nor be less than an amount equal to 25 percent of such average annual salary")
pub rule S7448mWithinLimits strict {
    label en official "except that such annuity shall not exceed an amount equal to 50 percent of such average annual salary, nor be less than an amount equal to 25 percent of such average annual salary";
    for j: Individual;
    for avg: Money;
    for amount: Money;
    when average_annual_salary_for_annuity(j, avg)
        and annuity_before_limits(j, amount)
        and amount >= round(avg * 25 percent, 2, "HALF_UP")
        and amount <= round(avg * 50 percent, 2, "HALF_UP");
    then surviving_spouse_annuity_amount(j, amount);
}

// ============================================================================
// §7448(p) — Estimates of expenditures
// ============================================================================

pub relation annual_estimates_submitted_to_president(fy: Integer) kind empirical {
    label en official "annual estimates of the expenditures and appropriations necessary for the maintenance and operation of the survivors annuity fund";
}
@source(IRC_S7448_P, relation = formalizes, coverage = exact, quote = "The chief judge shall submit to the President annual estimates of the expenditures and appropriations necessary for the maintenance and operation of the survivors annuity fund")
pub rule S7448pAnnualEstimatesDutyRule strict {
    label en official "The chief judge shall submit to the President annual estimates of the expenditures and appropriations necessary for the maintenance and operation of the survivors annuity fund";
    for cj: Individual;
    for fy: Integer;
    for startsOn: Date;
    for endsOn: Date;
    when is_chief_judge(cj)
        and survivors_fund_fiscal_year(fy, startsOn, endsOn);
    then duty S7448pSubmitAnnualEstimates {
        bearer cj;
        beneficiary President;
        goal achievement {
            condition annual_estimates_submitted_to_president(fy);
            window [startsOn, endsOn];
        }
    };
}

pub relation accrued_annuity_unpaid_on_termination(annuitant: Person, amount: Money) kind empirical {
    label en official "any accrued annuity remaining unpaid upon the termination (other than by death) of the annuity of any person based upon the service of a judge or special trial judge";
}
pub relation accrued_annuity_paid_to_annuitant(annuitant: Person, amount: Money) kind empirical;
@source(IRC_S7448_J, relation = formalizes, coverage = exact, quote = "Any accrued annuity remaining unpaid upon the termination (other than by death) of the annuity of any person based upon the service of a judge or special trial judge shall be paid to such person.")
pub rule S7448j3PayAccruedToAnnuitantRule strict {
    label en official "Any accrued annuity remaining unpaid upon the termination (other than by death) of the annuity of any person based upon the service of a judge or special trial judge shall be paid to such person.";
    for annuitant: Person;
    for amount: Money;
    when accrued_annuity_unpaid_on_termination(annuitant, amount);
    then duty S7448j3PayAccruedAnnuity {
        bearer us.irc.core::Secretary;
        beneficiary annuitant;
        goal achievement {
            condition accrued_annuity_paid_to_annuitant(annuitant, amount);
            window [-infinity, infinity];
        }
    };
}
pub relation accrued_annuity_unpaid_on_death_of_annuitant(annuitant: Person, diedOn: Date, amount: Money) kind empirical {
    label en official "any accrued annuity remaining unpaid upon the death of any person receiving annuity based upon the service of a judge or special trial judge";
}
pub relation appointed_executor_of_annuitant(annuitant: Person, executor: Person) kind empirical {
    label en official "the duly appointed executor or administrator of the estate of such person";
}
pub relation chief_judge_finds_individual_legally_entitled(annuitant: Person, payee: Person) kind empirical {
    label en official "such individual or individuals as may appear in the judgment of the chief judge to be legally entitled thereto";
}
pub relation accrued_annuity_payee_on_death(annuitant: Person, payee: Person) kind institutional;
@source(IRC_S7448_J, relation = formalizes, coverage = exact, quote = "(A) to the duly appointed executor or administrator of the estate of such person;")
pub rule S7448j3AExecutorPayee defeasible {
    label en official "(A) to the duly appointed executor or administrator of the estate of such person;";
    for annuitant: Person;
    for diedOn: Date;
    for amount: Money;
    for executor: Person;
    when accrued_annuity_unpaid_on_death_of_annuitant(annuitant, diedOn, amount)
        and appointed_executor_of_annuitant(annuitant, executor);
    then accrued_annuity_payee_on_death(annuitant, executor);
}
pub relation appointed_executor_exists_for(annuitant: Person) kind institutional;
rule S7448j3ExecutorExistsBridge strict {
    for annuitant: Person;
    for executor: Person;
    when appointed_executor_of_annuitant(annuitant, executor);
    then appointed_executor_exists_for(annuitant);
}
pub relation payment_after_thirty_days_from_death(annuitant: Person, diedOn: Date, on: Date) kind empirical;
@source(IRC_S7448_J, relation = formalizes, coverage = exact, quote = "(B) if there is no such executor or administrator payment may be made, after the expiration of thirty days from the date of the death of such person, to such individual or individuals as may appear in the judgment of the chief judge to be legally entitled thereto, and such payment shall be a bar to recovery by any other individual.")
pub rule S7448j3BChiefJudgePayee defeasible {
    label en official "(B) if there is no such executor or administrator payment may be made, after the expiration of thirty days from the date of the death of such person, to such individual or individuals as may appear in the judgment of the chief judge to be legally entitled thereto, and such payment shall be a bar to recovery by any other individual.";
    for annuitant: Person;
    for diedOn: Date;
    for amount: Money;
    for payee: Person;
    for on: Date;
    when accrued_annuity_unpaid_on_death_of_annuitant(annuitant, diedOn, amount)
        and chief_judge_finds_individual_legally_entitled(annuitant, payee)
        and payment_after_thirty_days_from_death(annuitant, diedOn, on)
        and on > add_calendar_period(diedOn, 30 calendar_day);
    then accrued_annuity_payee_on_death(annuitant, payee);
    unless appointed_executor_exists_for(annuitant) and chief_judge_finds_individual_legally_entitled(annuitant, payee);
}
pub relation surviving_spouse_annuity_after_reduction(j: Individual, spouse: Person, amount: Money) kind institutional {
    label en unofficial "the annuity of the surviving spouse after the further reduction in accordance with subsection (d) (10 percent of the deposit not made)";
}
@source(IRC_S7448_M, relation = formalizes, coverage = exact, quote = "and shall be further reduced in accordance with subsection (d) (if applicable).")
pub rule S7448mReducedByMissingDeposit defeasible {
    label en official "and shall be further reduced in accordance with subsection (d) (if applicable).";
    for j: Individual;
    for spouse: Person;
    for amount: Money;
    for reduction: Money;
    when surviving_spouse_annuity_amount(j, amount)
        and annuity_reduction_for_missing_deposit(j, spouse, reduction)
        and reduction <= amount;
    then surviving_spouse_annuity_after_reduction(j, spouse, amount - reduction);
}
@source(IRC_S7448_M, relation = formalizes, coverage = exact, quote = "and shall be further reduced in accordance with subsection (d) (if applicable).")
pub rule S7448mNoReductionWhenDepositMade defeasible {
    label en official "and shall be further reduced in accordance with subsection (d) (if applicable).";
    for j: Individual;
    for spouse: Person;
    for amount: Money;
    when surviving_spouse_annuity_amount(j, amount)
        and surviving_spouse_of(spouse, j)
        and not_known(deposit_amount_not_made_any(j));
    then surviving_spouse_annuity_after_reduction(j, spouse, amount);
}
pub relation deposit_amount_not_made_any(j: Individual) kind institutional;
rule S7448mDepositMissingBridge strict {
    for j: Individual;
    for deposit: Money;
    when deposit_amount_not_made(j, deposit);
    then deposit_amount_not_made_any(j);
}
