pub relation computed_years_of_service_7447(j: Individual, office: JudicialOffice, years: Integer) kind institutional {
    label en official "the whole years of service computed from the periods";
}
rule ComputedYearsOfService7447(j: Individual, office: JudicialOffice, days: Integer) strict {
    label en official "the number of whole-year thresholds reached (0 when none)";
    when service_days_7447(j, office, days);
    then computed_years_of_service_7447(j, office, count(collect all n: Integer where service_years_reached_7447(j, office, n)));
}
relation has_computed_years_of_service_7447(j: Individual, office: JudicialOffice) kind institutional;
rule HasComputedYearsOfService7447(j: Individual, office: JudicialOffice, y: Integer) strict {
    label en official "bridge for the absence test";
    when computed_years_of_service_7447(j, office, y);
    then has_computed_years_of_service_7447(j, office);
}
pub relation years_of_service_for_rules(j: Individual, office: JudicialOffice, years: Integer) kind institutional {
    label en official "the length of service the retirement rules read: computed from the periods where they are supplied and do not overlap, else asserted";
}
rule YearsOfServiceForRulesComputed(j: Individual, office: JudicialOffice, y: Integer) strict {
    label en official "the computed years";
    when computed_years_of_service_7447(j, office, y);
    then years_of_service_for_rules(j, office, y);
}
rule YearsOfServiceForRulesAsserted(j: Individual, office: JudicialOffice, y: Integer) strict {
    label en official "the asserted years (the earlier channel)";
    when years_of_service(j, office, y);
    when not_known(has_computed_years_of_service_7447(j, office));
    then years_of_service_for_rules(j, office, y);
}

// ===================== G5612: section 7447(i)(3)(B)(ii), 3 percent compounded on December 31 =====================

pub relation credited_amount_7447i(j: Individual, amount: Money) kind empirical {
    label en official "the amount credited to the individual's account (section 7447(i)(3)(B)(ii)) — case fact";
}
pub relation credited_from_7447i(j: Individual, on: Date) kind empirical {
    label en official "the date from which interest runs on the amount credited (the date of the credit) — case fact";
}
pub relation revocation_filed_on_7447i(j: Individual, on: Date) kind empirical {
    label en official "the date on which the revocation is filed — case fact";
}
pub relation three_percent_power_7447i(k: Integer, factor: Decimal) kind institutional {
    label en official "1.03^k for k = 0..40, every product rounded to 12 places HALF_UP (JUDGMENT CALL; a longer period is outside the bound)";
}
rule ThreePercentPower7447iK0() strict { then three_percent_power_7447i(0, 1); }
rule ThreePercentPower7447iK1() strict { then three_percent_power_7447i(1, 1.030000000000); }
rule ThreePercentPower7447iK2() strict { then three_percent_power_7447i(2, 1.060900000000); }
rule ThreePercentPower7447iK3() strict { then three_percent_power_7447i(3, 1.092727000000); }
rule ThreePercentPower7447iK4() strict { then three_percent_power_7447i(4, 1.125508810000); }
rule ThreePercentPower7447iK5() strict { then three_percent_power_7447i(5, 1.159274074300); }
rule ThreePercentPower7447iK6() strict { then three_percent_power_7447i(6, 1.194052296529); }
rule ThreePercentPower7447iK7() strict { then three_percent_power_7447i(7, 1.229873865425); }
rule ThreePercentPower7447iK8() strict { then three_percent_power_7447i(8, 1.266770081388); }
rule ThreePercentPower7447iK9() strict { then three_percent_power_7447i(9, 1.304773183830); }
rule ThreePercentPower7447iK10() strict { then three_percent_power_7447i(10, 1.343916379345); }
rule ThreePercentPower7447iK11() strict { then three_percent_power_7447i(11, 1.384233870725); }
rule ThreePercentPower7447iK12() strict { then three_percent_power_7447i(12, 1.425760886847); }
rule ThreePercentPower7447iK13() strict { then three_percent_power_7447i(13, 1.468533713452); }
rule ThreePercentPower7447iK14() strict { then three_percent_power_7447i(14, 1.512589724856); }
rule ThreePercentPower7447iK15() strict { then three_percent_power_7447i(15, 1.557967416602); }
rule ThreePercentPower7447iK16() strict { then three_percent_power_7447i(16, 1.604706439100); }
rule ThreePercentPower7447iK17() strict { then three_percent_power_7447i(17, 1.652847632273); }
rule ThreePercentPower7447iK18() strict { then three_percent_power_7447i(18, 1.702433061241); }
rule ThreePercentPower7447iK19() strict { then three_percent_power_7447i(19, 1.753506053078); }
rule ThreePercentPower7447iK20() strict { then three_percent_power_7447i(20, 1.806111234670); }
rule ThreePercentPower7447iK21() strict { then three_percent_power_7447i(21, 1.860294571710); }
rule ThreePercentPower7447iK22() strict { then three_percent_power_7447i(22, 1.916103408861); }
rule ThreePercentPower7447iK23() strict { then three_percent_power_7447i(23, 1.973586511127); }
rule ThreePercentPower7447iK24() strict { then three_percent_power_7447i(24, 2.032794106461); }
rule ThreePercentPower7447iK25() strict { then three_percent_power_7447i(25, 2.093777929655); }
rule ThreePercentPower7447iK26() strict { then three_percent_power_7447i(26, 2.156591267545); }
rule ThreePercentPower7447iK27() strict { then three_percent_power_7447i(27, 2.221289005571); }
rule ThreePercentPower7447iK28() strict { then three_percent_power_7447i(28, 2.287927675738); }
rule ThreePercentPower7447iK29() strict { then three_percent_power_7447i(29, 2.356565506010); }
rule ThreePercentPower7447iK30() strict { then three_percent_power_7447i(30, 2.427262471190); }
rule ThreePercentPower7447iK31() strict { then three_percent_power_7447i(31, 2.500080345326); }
rule ThreePercentPower7447iK32() strict { then three_percent_power_7447i(32, 2.575082755686); }
rule ThreePercentPower7447iK33() strict { then three_percent_power_7447i(33, 2.652335238357); }
