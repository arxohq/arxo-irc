pub relation compounding_dates_7447i(j: Individual, n: Integer, first: Date, last: Date) kind institutional {
    label en official "the number of December 31s between the credit and the revocation (the ends of calendar years) and the first and the last of them";
}
@source(IRC_S7447_I, relation = formalizes, coverage = partial, quote = "(together with interest at 3 percent per annum, compounded on December 31 of each year to the date on which the revocation is filed)")
rule CompoundingDates7447i(j: Individual, d0: Date, r: Date) defeasible {
    label en official "the December 31s of the calendar years whose end lies in [credit, revocation]";
    when credited_from_7447i(j, d0);
    when revocation_filed_on_7447i(j, r);
    when count(collect y: TaxableYear, e: Date, m: Integer where us.irc.core::calendar_year_of(y, m) and us.irc.core::ends(y, e) and e >= d0 and e <= r) > 0;
    then compounding_dates_7447i(j,
        count(collect all y2: TaxableYear, e2: Date, m2: Integer where us.irc.core::calendar_year_of(y2, m2) and us.irc.core::ends(y2, e2) and e2 >= d0 and e2 <= r),
        min(collect all e3: Date, y3: TaxableYear, m3: Integer where us.irc.core::calendar_year_of(y3, m3) and us.irc.core::ends(y3, e3) and e3 >= d0 and e3 <= r),
        max(collect all e4: Date, y4: TaxableYear, m4: Integer where us.irc.core::calendar_year_of(y4, m4) and us.irc.core::ends(y4, e4) and e4 >= d0 and e4 <= r));
}
relation has_compounding_date_7447i(j: Individual) kind institutional;
rule HasCompoundingDate7447i(j: Individual, n: Integer, a: Date, b: Date) defeasible {
    label en official "bridge for the absence test";
    when compounding_dates_7447i(j, n, a, b);
    then has_compounding_date_7447i(j);
}
pub relation amount_returned_with_interest_7447i(j: Individual, amount: Money) kind institutional {
    label en official "the amount credited with interest at 3 percent per annum, compounded on December 31 of each year to the revocation date: simple for the part-years, compounded between the December 31s; cents HALF_UP";
}
@source(IRC_S7447_I, relation = formalizes, coverage = partial, quote = "(together with interest at 3 percent per annum, compounded on December 31 of each year to the date on which the revocation is filed)")
rule AmountReturnedWithInterest7447iCompounded(j: Individual, a: Money, d0: Date, r: Date, n: Integer, first: Date, last: Date, p: Decimal) defeasible {
    label en official "amount x (1 + 0.03 d1/365) x 1.03^(n-1) x (1 + 0.03 d2/365)";
    when credited_amount_7447i(j, a);
    when credited_from_7447i(j, d0);
    when revocation_filed_on_7447i(j, r);
    when compounding_dates_7447i(j, n, first, last);
    when three_percent_power_7447i(n - 1, p);
    then amount_returned_with_interest_7447i(j, round(round(round(a * (1.0 + div_round(0.03 * days_between(d0, first), 365.0, 12, "HALF_UP")), 2, "HALF_UP") * p, 2, "HALF_UP") * (1.0 + div_round(0.03 * days_between(last, r), 365.0, 12, "HALF_UP")), 2, "HALF_UP"));
}
@source(IRC_S7447_I, relation = formalizes, coverage = partial, quote = "(together with interest at 3 percent per annum, compounded on December 31 of each year to the date on which the revocation is filed)")
rule AmountReturnedWithInterest7447iSimple(j: Individual, a: Money, d0: Date, r: Date) defeasible {
    label en official "no December 31 in the period: simple interest for the whole period";
    when credited_amount_7447i(j, a);
    when credited_from_7447i(j, d0);
    when revocation_filed_on_7447i(j, r);
    when not_known(has_compounding_date_7447i(j));
    then amount_returned_with_interest_7447i(j, round(a * (1.0 + div_round(0.03 * days_between(d0, r), 365.0, 12, "HALF_UP")), 2, "HALF_UP"));
}

// ===================== G5610 (7436(c)(3)): rules similar to the last sentence of 7463(a) and 7463(c)-(e) =====================

pub relation decision_with_brief_summary_7436(pr: Proceeding) kind empirical {
    label en official "a decision, together with a brief summary of the reasons therefor, is entered in the proceeding";
}
pub relation employment_status_decision_satisfies_7459b_and_7460(pr: Proceeding) kind institutional {
    label en official "the decision with a brief summary satisfies the requirements of sections 7459(b) and 7460 (rule similar to the last sentence of section 7463(a))";
}
@source(IRC_S7436_C, relation = formalizes, coverage = partial, quote = "Rules similar to the rules of the last sentence of subsection (a), and subsections (c), (d), and (e), of section 7463 shall apply to proceedings conducted under this subsection.")
rule S7436c3ADecisionSatisfies7459bAnd7460 defeasible {
    for pr: Proceeding;
    when employment_status_small_case_procedure_applies(pr)
        and decision_with_brief_summary_7436(pr);
    then employment_status_decision_satisfies_7459b_and_7460(pr);
}
pub relation employment_status_rules_prescribed_by_tax_court(pr: Proceeding) kind institutional {
    label en official "notwithstanding section 7453 the proceedings are conducted under the rules of evidence, practice and procedure the Tax Court prescribes (rule similar to the second sentence of section 7463(a), stated in section 7436(c)(1))";
}
@source(IRC_S7436_C, relation = formalizes, coverage = partial, quote = "Rules similar to the rules of the last sentence of subsection (a), and subsections (c), (d), and (e), of section 7463 shall apply to proceedings conducted under this subsection.")
rule S7436c3RulesPrescribedByTaxCourt defeasible {
    for pr: Proceeding;
    when employment_status_small_case_procedure_applies(pr);
    then employment_status_rules_prescribed_by_tax_court(pr);
}
pub relation employment_decision_exceeds_small_case_limits_7436(pr: Proceeding, quarter: Text, amount: Money) kind empirical {
    label en unofficial "a proposed decision would redetermine a deficiency, or determine an overpayment, in an amount exceeding both the amounts placed in dispute within the limits of section 7436(c)(1) and any amount conceded by the parties (rule similar to section 7463(c))";
}
@source(IRC_S7436_C, relation = formalizes, coverage = partial, quote = "Rules similar to the rules of the last sentence of subsection (a), and subsections (c), (d), and (e), of section 7463 shall apply to proceedings conducted under this subsection.")
rule S7436c3CJurisdictionalLimitImmunityRule strict {
    for pr: Proceeding;
    for quarter: Text;
    for amount: Money;
    when employment_status_small_case_procedure_applies(pr)
        and employment_decision_exceeds_small_case_limits_7436(pr, quarter, amount);
    then immunity S7436c3CJurisdictionalLimitImmunity {
        holder us.irc.core::TaxCourt;
        protected_effect employment_decision_exceeds_small_case_limits_7436(pr, quarter, amount);
        window [-infinity, infinity];
    };
}
pub relation discontinuance_requested_7436(pr: Proceeding, p: Person) kind empirical {
    label en official "the petitioner or the Secretary requests, before the decision becomes final, that further proceedings under the small case procedure be discontinued (rule similar to section 7463(d))";
}
external judgment relation reasonable_grounds_amount_exceeds_limit_7436(pr: Proceeding) {
    authority TaxCourt;
    label en official "there are reasonable grounds for believing that the amount of employment taxes placed in dispute exceeds the applicable jurisdictional amount (section 7463(d)(1) by section 7436(c)(3))";
}
external judgment relation excess_large_enough_to_justify_discontinuance_7436(pr: Proceeding) {
    authority TaxCourt;
    label en official "the amount of the excess is large enough to justify granting the request (section 7463(d)(2) by section 7436(c)(3))";
}
pub relation employment_status_small_case_discontinued(pr: Proceeding) kind institutional {
    label en official "the Tax Court discontinues further proceedings under the small case procedure and the proceedings continue under the ordinary rules";
}
@source(IRC_S7436_C, relation = formalizes, coverage = partial, quote = "Rules similar to the rules of the last sentence of subsection (a), and subsections (c), (d), and (e), of section 7463 shall apply to proceedings conducted under this subsection.")
rule S7436c3DDiscontinuance defeasible {
    for pr: Proceeding;
    for p: Person;
    when employment_status_small_case_procedure_applies(pr)
        and discontinuance_requested_7436(pr, p)
        and reasonable_grounds_amount_exceeds_limit_7436(pr)
        and excess_large_enough_to_justify_discontinuance_7436(pr);
    then employment_status_small_case_discontinued(pr);
}
pub relation additions_and_penalties_in_dispute_7436(pr: Proceeding, quarter: Text, amount: Money) kind empirical {
    label en official "additions to the tax, additional amounts and penalties imposed by chapter 68 placed in dispute for the quarter, to the extent the procedures of subchapter B of chapter 63 apply (rule similar to section 7463(e))";
}
pub relation employment_amount_in_dispute_7436(pr: Proceeding, quarter: Text, amount: Money) kind institutional {
    label en official "the amount of the employment taxes placed in dispute for the quarter includes the additions, additional amounts and penalties (rule similar to section 7463(e))";
}
@source(IRC_S7436_C, relation = formalizes, coverage = partial, quote = "Rules similar to the rules of the last sentence of subsection (a), and subsections (c), (d), and (e), of section 7463 shall apply to proceedings conducted under this subsection.")
rule S7436c3EAmountInDisputeIncludesAdditions strict {
    for pr: Proceeding;
    for quarter: Text;
    for tax: Money;
    for extra: Money;
    when employment_taxes_in_dispute_for_quarter(pr, quarter, tax)
        and additions_and_penalties_in_dispute_7436(pr, quarter, extra);
    then employment_amount_in_dispute_7436(pr, quarter, tax + extra);
}
@source(IRC_S7436_C, relation = formalizes, coverage = partial, quote = "Rules similar to the rules of the last sentence of subsection (a), and subsections (c), (d), and (e), of section 7463 shall apply to proceedings conducted under this subsection.")
rule S7436c3EQuarterAboveLimitWithAdditions strict {
    for pr: Proceeding;
    for quarter: Text;
    for total: Money;
    when employment_amount_in_dispute_7436(pr, quarter, total)
        and total > 50000.00 USD;
    then some_quarter_exceeds_50000(pr);
}

// ===================== G5610 (7436(d)(1)): the determination is treated as a notice of deficiency =====================

pub relation secretary_determination_notice_7436a(n: us.irc.core::Notice, p: Person) kind empirical {
    label en official "the Secretary's determination described in section 7436(a) (that the person is an employee or not an independent contractor, or that section 530 relief does not apply), sent to the person as a notice";
}
@source(IRC_S7436_D, relation = formalizes, coverage = partial, quote = "in the same manner as if the Secretary's determination described in subsection (a) were a notice of deficiency.")
rule S7436d1DeterminationTreatedAsNoticeOfDeficiency strict {
    for n: us.irc.core::Notice;
    for p: Person;
    when secretary_determination_notice_7436a(n, p);
    then us.irc.core::notice_of(n, us.irc.core::Deficiency, p);
}
