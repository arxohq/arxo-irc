// Judicial proceedings -- final TECH_GAP pass (26.09.2026, DECISION-0379, implemented_unverified): G5610 (sections 7436(c)(3), 7436(d)(1),
// 7447A(f): analogical incorporation), G5611 (sections 7447(a)(3), 7447A(a)(2): length of service as a union of periods), G5612 (section
// 7447(i)(3)(B)(ii): 3 percent compounded on December 31) and G5613 (section 7448(l): the first business day of the month).
//
// G5610 TECHNIQUE. "Rules similar to" / "the principles of ... as if" are stated as COPIES of the earlier rules over the analogous relation,
// with the analogy named in the @source: (1) 7447A(f): the rules of section 7447(f), (g), (h)(2), (i), (j) that name the Tax Court judge office
// are copied for the special trial judge office (`Stj*` rules), every "President" being the organ `ChiefJudgeOrgan` (the chief judge) and every
// relation naming the President renamed; the first sentence of (h)(1) is the copy of the certification duty; the concurrence rule of (h)(1) for the
// chief judge is NOT copied (a special trial judge is not the chief judge); (2) 7436(c)(3): the last sentence of 7463(a), (c), (d), (e) for the
// employment status small case; (3) 7436(d)(1): the determination of the Secretary is treated as a notice of deficiency (`us.irc.core::notice_of`
// with the kind Deficiency), so every rule of the code that reads a notice of deficiency (6213, 6214, 6215, 6503, 6512, 7481 in the assessment and
// this package) applies to it; JUDGMENT CALL: the incorporation is at the level of the notice, rules keyed to another element of the deficiency
// procedure are not copied.
// G5611 TECHNIQUE. The service periods (from, to) are case facts per office group; the length is the number of days of the periods (a period from
// f to t counts days_between(f, t) + 1 days) and the whole years are the number of thresholds n x 365.25 days reached (an unrolled table 1..60;
// JUDGMENT CALL: a year is 365.25 days, the text names none); a case whose periods OVERLAP gets no computed length (the days would be counted
// twice: the union is not formed) and reads the asserted years. `years_of_service_for_rules` (computed, else asserted) is read by the rules of module 13.
// G5612 TECHNIQUE. The interest is simple for the part-years and compounded at each December 31 (the ends of calendar years asserted as
// TaxableYear facts): amount x (1 + 0.03 d1/365) x 1.03^(n-1) x (1 + 0.03 d2/365), d1 the days from the credit to the first December 31, d2 from the
// last December 31 to the revocation, n the number of December 31s in [credit, revocation]; without a December 31, simple interest for the whole
// period. The powers 1.03^k (k = 0..40, 12 places HALF_UP) are a table; a longer period is outside the bound. JUDGMENT CALLS: the 365-day year and the
// simple interest of the part-years (the text says only "compounded on December 31 of each year").
// G5613 TECHNIQUE. The annuity accrued for a month is due on `add_business_days(month_end_of(first day of the month), 1 business_day)` under the
// package policy `IRC_BUSINESS_DAY_COUNT`; the calendar of section 85 is supplied by the world (`us.code.clir.federal_calendar` in the `concat` of the test
// family), without it the date is not computed.

language "law.core" version "0.2";
package us.irc.judicial_proceedings version "0.1.1";
namespace "urn:us:irc:judicial_proceedings:clir";

use self::{
    IRC_S7436_C,
    IRC_S7436_D,
    IRC_S7447A_F,
    IRC_S7447_A,
    IRC_S7447_I,
    IRC_S7448_L,
    Individual,
    JudicialOffice,
    OfficeOfPersonnelManagement,
    Organ,
    Person,
    Proceeding,
    TaxableYear,
    certificate_of_disability_signed_by_chief_judge_furnished,
    chief_judge_of,
    compensated_government_service_period,
    csrs_annuity_paid_for_service,
    csrs_deduction_made_after_election,
    elected_retired_pay,
    election_filed_with_proper_recipient,
    employment_status_small_case_procedure_applies,
    employment_taxes_in_dispute_for_quarter,
    federal_civil_office_or_employment,
    first_day_failed_recalled_duties_in_year,
    first_day_federal_tax_services_performed,
    freeze_election_made_on,
    freeze_election_permitted,
    freeze_election_timing_ok,
    government_contribution_8432c_made_for,
    judge_did_not_retire_despite_disability,
    judicial_officer_permanently_disabled,
    judicial_officer_retired,
    lump_sum_credit_application_made,
    lump_sum_credit_paid,
    retired_pay_election_timely,
    retired_pay_forfeited_for_period,
    retired_pay_frozen,
    retired_pay_permanently_forfeited_from,
    retirement_table_met,
    some_quarter_exceeds_50000,
    years_of_service,
};

const ChiefJudgeOrgan: Organ = entity_ref("urn:us:irc:judicial_proceedings:clir#ChiefJudgeOrgan") {
    label en unofficial "the chief judge of the Tax Court (the reference to the President of section 7447 as applied to a special trial judge by section 7447A(f))";
}

pub deadline policy IRC_BUSINESS_DAY_COUNT {
    start_count next_day;
    include_end true;
    roll next_working_day;
}

// ===================== G5610 (7447A(f)): the rules of section 7447 for a special trial judge =====================

@source(IRC_S7447A_F, relation = formalizes, coverage = partial, quote = "The rules of subsections (f), (g), (h)(2), (i), and (j), and the first sentence of subsection (h)(1), of section 7447 shall apply to a special trial judge in the same manner as a judge of the Tax Court.")
pub rule StjS7447f1OneYearForfeiture defeasible {
    label en official "such individual shall forfeit all rights to retired pay under subsection (d) for the 1-year period which begins on the 1st day on which he so fails to perform such duties.";
    for j: Individual;
    for failedOn: Date;
    when elected_retired_pay(j, SpecialTrialJudgeOffice)
        and first_day_failed_recalled_duties_in_year(j, failedOn)
        and not_known(retired_pay_frozen(j));
    then retired_pay_forfeited_for_period(j, failedOn, add_calendar_period(failedOn, 1 calendar_year));
}
@source(IRC_S7447A_F, relation = formalizes, coverage = partial, quote = "The rules of subsections (f), (g), (h)(2), (i), and (j), and the first sentence of subsection (h)(1), of section 7447 shall apply to a special trial judge in the same manner as a judge of the Tax Court.")
pub rule StjS7447f2PermanentForfeiture defeasible {
    label en official "such individual shall forfeit all rights to retired pay under subsection (d) for all periods beginning on or after the 1st day on which he engages in any such activity.";
    for j: Individual;
    for onDate: Date;
    when elected_retired_pay(j, SpecialTrialJudgeOffice)
        and first_day_federal_tax_services_performed(j, onDate)
        and not_known(retired_pay_frozen(j));
    then retired_pay_permanently_forfeited_from(j, onDate);
    unless federal_civil_office_or_employment(j) and first_day_federal_tax_services_performed(j, onDate);
}
@source(IRC_S7447A_F, relation = formalizes, coverage = partial, quote = "The rules of subsections (f), (g), (h)(2), (i), and (j), and the first sentence of subsection (h)(1), of section 7447 shall apply to a special trial judge in the same manner as a judge of the Tax Court.")
pub rule StjS7447f3SuspensionDuringGovernmentPay defeasible {
    label en official "such individual shall forfeit all rights to retired pay under subsection (d) for the period for which such compensation is received.";
    for j: Individual;
    for fromDate: Date;
    for toDate: Date;
    when elected_retired_pay(j, SpecialTrialJudgeOffice)
        and compensated_government_service_period(j, fromDate, toDate);
    then retired_pay_forfeited_for_period(j, fromDate, toDate);
}
@source(IRC_S7447A_F, relation = formalizes, coverage = partial, quote = "The rules of subsections (f), (g), (h)(2), (i), and (j), and the first sentence of subsection (h)(1), of section 7447 shall apply to a special trial judge in the same manner as a judge of the Tax Court.")
pub rule StjS7447f4BiiDuringElectionPeriod defeasible {
    label en official "(ii) may be made only during the period during which the individual may make an election to receive retired pay or while the individual is receiving retired pay, and";
    for j: Individual;
    for on: Date;
    when freeze_election_made_on(j, on)
        and retired_pay_election_timely(j, SpecialTrialJudgeOffice, on);
    then freeze_election_timing_ok(j, on);
}
@source(IRC_S7447A_F, relation = formalizes, coverage = partial, quote = "The rules of subsections (f), (g), (h)(2), (i), and (j), and the first sentence of subsection (h)(1), of section 7447 shall apply to a special trial judge in the same manner as a judge of the Tax Court.")
pub rule StjS7447f4BPermitted defeasible {
    label en official "(i) may be made by an individual only if such individual meets the age and service requirements for retirement under paragraph (2) of subsection (b),";
    for j: Individual;
    for on: Date;
    when freeze_election_made_on(j, on)
        and retirement_table_met(j, SpecialTrialJudgeOffice)
        and freeze_election_timing_ok(j, on)
        and election_filed_with_proper_recipient(j, SpecialTrialJudgeOffice);
    then freeze_election_permitted(j, on);
}
@source(IRC_S7447A_F, relation = formalizes, coverage = partial, quote = "The rules of subsections (f), (g), (h)(2), (i), and (j), and the first sentence of subsection (h)(1), of section 7447 shall apply to a special trial judge in the same manner as a judge of the Tax Court.")
pub rule StjS7447g2ANoCsrsAnnuityRule strict {
    label en official "(A) no annuity or other payment shall be payable to any person under the civil service retirement laws with respect to any service performed by such individual";
    for j: Individual;
    when elected_retired_pay(j, SpecialTrialJudgeOffice);
    then prohibition StjS7447g2ANoCivilServiceAnnuity {
        bearer OfficeOfPersonnelManagement;
        action csrs_annuity_paid_for_service(j);
        window [-infinity, infinity];
    };
}
@source(IRC_S7447A_F, relation = formalizes, coverage = partial, quote = "The rules of subsections (f), (g), (h)(2), (i), and (j), and the first sentence of subsection (h)(1), of section 7447 shall apply to a special trial judge in the same manner as a judge of the Tax Court.")
pub rule StjS7447g2BNoCsrdfDeductionRule strict {
    label en official "(B) no deduction for purposes of the Civil Service Retirement and Disability Fund shall be made from retired pay payable to him under subsection (d) or from any other salary, pay, or compensation payable to him, for any period beginning after the day on which such election is filed; and";
    for j: Individual;
    when elected_retired_pay(j, SpecialTrialJudgeOffice);
    then prohibition StjS7447g2BNoCsrdfDeduction {
        bearer us.irc.core::TaxCourt;
        action csrs_deduction_made_after_election(j);
        window [-infinity, infinity];
    };
}
@source(IRC_S7447A_F, relation = formalizes, coverage = partial, quote = "The rules of subsections (f), (g), (h)(2), (i), and (j), and the first sentence of subsection (h)(1), of section 7447 shall apply to a special trial judge in the same manner as a judge of the Tax Court.")
pub rule StjS7447g2CLumpSumDutyRule strict {
    label en official "(C) such individual shall be paid the lump-sum credit computed under sections 8331(8) and 8401(19) of title 5 of the United States Code upon making application therefor with the Office of Personnel Management.";
    for j: Individual;
    when elected_retired_pay(j, SpecialTrialJudgeOffice)
        and lump_sum_credit_application_made(j);
    then duty StjS7447g2CPayLumpSumCredit {
        bearer OfficeOfPersonnelManagement;
        beneficiary j;
        goal achievement {
            condition lump_sum_credit_paid(j);
            window [-infinity, infinity];
        }
    };
}
pub relation judge_certified_disability_to_chief_judge(j: Individual) kind empirical {
    label en official "shall certify to the ChiefJudgeOrgan his disability in writing";
}
@source(IRC_S7447A_F, relation = formalizes, coverage = partial, quote = "The rules of subsections (f), (g), (h)(2), (i), and (j), and the first sentence of subsection (h)(1), of section 7447 shall apply to a special trial judge in the same manner as a judge of the Tax Court.")
pub rule StjS7447h1CertifyDutyRule strict {
    label en official "Any judge who becomes permanently disabled from performing his duties shall certify to the ChiefJudgeOrgan his disability in writing.";
    for j: Individual;
    when judicial_officer_permanently_disabled(j, SpecialTrialJudgeOffice);
    then duty StjS7447h1CertifyDisability {
        bearer j;
        goal achievement {
            condition judge_certified_disability_to_chief_judge(j);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S7447A_F, relation = formalizes, coverage = partial, quote = "The rules of subsections (f), (g), (h)(2), (i), and (j), and the first sentence of subsection (h)(1), of section 7447 shall apply to a special trial judge in the same manner as a judge of the Tax Court.")
pub rule StjS7447h1OtherJudgeCertificateDutyRule strict {
    label en official "If any other judge retires for disability, he shall furnish to the ChiefJudgeOrgan a certificate of disability signed by the chief judge.";
    for j: Individual;
    when judicial_officer_permanently_disabled(j, SpecialTrialJudgeOffice)
        and judicial_officer_retired(j, SpecialTrialJudgeOffice)
        and not_known(chief_judge_of(j));
    then duty StjS7447h1FurnishCertificateOfDisability {
        bearer j;
        goal achievement {
            condition certificate_of_disability_signed_by_chief_judge_furnished(j);
            window [-infinity, infinity];
        }
    };
}
external judgment relation chief_judge_finds_judge_unable_to_discharge_duties(j: Individual) {
    authority ChiefJudgeOrgan;
    label en official "the ChiefJudgeOrgan finds that such judge is unable to discharge efficiently all the duties of his office by reason of permanent mental or physical disability";
}
external judgment relation chief_judge_finds_additional_judge_necessary(j: Individual) {
    authority ChiefJudgeOrgan;
    label en official "the appointment of an additional judge is necessary for the efficient dispatch of business";
}
pub relation chief_judge_declares_disabled_judge_retired(j: Individual) kind empirical;
@source(IRC_S7447A_F, relation = formalizes, coverage = partial, quote = "The rules of subsections (f), (g), (h)(2), (i), and (j), and the first sentence of subsection (h)(1), of section 7447 shall apply to a special trial judge in the same manner as a judge of the Tax Court.")
pub rule StjS7447h2PresidentDeclaresDutyRule defeasible {
    label en official "the ChiefJudgeOrgan shall declare such judge to be retired.";
    for j: Individual;
    when judge_did_not_retire_despite_disability(j)
        and chief_judge_finds_judge_unable_to_discharge_duties(j)
        and chief_judge_finds_additional_judge_necessary(j);
    then duty StjS7447h2DeclareJudgeRetired {
        bearer ChiefJudgeOrgan;
        goal achievement {
            condition chief_judge_declares_disabled_judge_retired(j);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S7447A_F, relation = formalizes, coverage = partial, quote = "The rules of subsections (f), (g), (h)(2), (i), and (j), and the first sentence of subsection (h)(1), of section 7447 shall apply to a special trial judge in the same manner as a judge of the Tax Court.")
pub rule StjS7447j3BNoGovernmentContributionRule strict {
    label en official "No contributions under section 8432(c) of title 5, United States Code, shall be made for the benefit of a judge who has filed an election to receive retired pay under subsection (e).";
    for j: Individual;
    when elected_retired_pay(j, SpecialTrialJudgeOffice);
    then prohibition StjS7447j3BNoGovernmentContribution {
        bearer us.irc.core::TaxCourt;
        action government_contribution_8432c_made_for(j);
        window [-infinity, infinity];
    };
}

// ===================== G5613: section 7448(l), the first business day of the month =====================

pub relation annuity_accrual_month_start_7448l(j: Individual, start: Date) kind empirical {
    label en official "the first day of the month for which the annuity has accrued (section 7448(l)) — case fact";
}
pub relation annuity_due_date_7448l(j: Individual, start: Date, due: Date) kind institutional {
    label en official "the first business day of the month following the month for which the annuity accrued: the first business day after the last day of that month";
}
@source(IRC_S7448_L, relation = formalizes, coverage = exact, quote = "shall be due and payable in monthly installments on the first business day of the month following the month or other period for which the annuity shall have accrued")
rule S7448lAnnuityDueDate defeasible {
    label en official "add_business_days(month_end_of(start), 1 business_day)";
    for j: Individual;
    for start: Date;
    when annuity_accrual_month_start_7448l(j, start);
    then annuity_due_date_7448l(j, start, add_business_days(month_end_of(start), 1 business_day, "23:59:59"));
}

// ===================== G5611: length of service as the union of periods =====================

pub relation service_period_7447(j: Individual, office: JudicialOffice, fromDate: Date, toDate: Date) kind empirical {
    label en official "a period during which the individual served as judge, as judge of the Tax Court, or as a member of the Board of Tax Appeals (office group TaxCourtJudgeOffice), or as a special trial judge (SpecialTrialJudgeOffice), whether or not consecutive (sections 7447(a)(3), 7447A(a)(2)) — case fact";
}
pub relation service_periods_overlap_7447(j: Individual, office: JudicialOffice) kind institutional {
    label en official "two distinct service periods of the individual overlap (the union is not formed by summing the days)";
}
@source(IRC_S7447_A, relation = formalizes, coverage = partial, quote = "there shall be included all periods (whether or not consecutive) during which an individual served as judge")
rule ServicePeriodsOverlap7447(j: Individual, office: JudicialOffice, f1: Date, t1: Date, f2: Date, t2: Date) strict {
    label en official "two periods with f1 <= f2 <= t1 that are not the same period";
    when service_period_7447(j, office, f1, t1);
    when service_period_7447(j, office, f2, t2);
    when f1 <= f2;
    when f2 <= t1;
    when t1 != t2;
    then service_periods_overlap_7447(j, office);
}
rule ServicePeriodsOverlapSameStart7447(j: Individual, office: JudicialOffice, f1: Date, t1: Date, f2: Date, t2: Date) strict {
    label en official "two periods with the same start and different ends";
    when service_period_7447(j, office, f1, t1);
    when service_period_7447(j, office, f2, t2);
    when f1 == f2;
    when t1 != t2;
    then service_periods_overlap_7447(j, office);
}
pub relation service_days_7447(j: Individual, office: JudicialOffice, days: Integer) kind institutional {
    label en official "the days of all the periods of service (from and to included), the periods not overlapping";
}
@source(IRC_S7447_A, relation = formalizes, coverage = partial, quote = "there shall be included all periods (whether or not consecutive) during which an individual served as judge")
rule ServiceDays7447(j: Individual, office: JudicialOffice, f0: Date, t0: Date) strict {
    label en official "sum of days_between(from, to) + 1 over the periods";
    when service_period_7447(j, office, f0, t0);
    when not_known(service_periods_overlap_7447(j, office));
    then service_days_7447(j, office, sum(collect all x: Integer, f: Date, t: Date where service_period_7447(j, office, f, t) and x == days_between(f, t) + 1, empty: 0));
}
pub relation service_years_reached_7447(j: Individual, office: JudicialOffice, n: Integer) kind institutional {
    label en official "the service reaches n whole years of 365.25 days (JUDGMENT CALL)";
}
rule ServiceYearsReached7447Year1(j: Individual, office: JudicialOffice, days: Integer) strict {
    label en official "4 x days >= 1461";
    when service_days_7447(j, office, days);
    when 4 * days >= 1461;
    then service_years_reached_7447(j, office, 1);
}
rule ServiceYearsReached7447Year2(j: Individual, office: JudicialOffice, days: Integer) strict {
    label en official "4 x days >= 2922";
    when service_days_7447(j, office, days);
    when 4 * days >= 2922;
    then service_years_reached_7447(j, office, 2);
}
rule ServiceYearsReached7447Year3(j: Individual, office: JudicialOffice, days: Integer) strict {
    label en official "4 x days >= 4383";
    when service_days_7447(j, office, days);
    when 4 * days >= 4383;
    then service_years_reached_7447(j, office, 3);
}
rule ServiceYearsReached7447Year4(j: Individual, office: JudicialOffice, days: Integer) strict {
    label en official "4 x days >= 5844";
    when service_days_7447(j, office, days);
    when 4 * days >= 5844;
    then service_years_reached_7447(j, office, 4);
}
rule ServiceYearsReached7447Year5(j: Individual, office: JudicialOffice, days: Integer) strict {
    label en official "4 x days >= 7305";
