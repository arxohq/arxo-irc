// 26 U.S.C. §7429 — statutory note 5 (effectivedate-note)
fragment IRC_S7429_NOTE_5 in IRC_2024_EDITION {
    kind note;
    locator "section/7429/note/5";
    text en official """Effective Date
Section applicable with respect to action taken under section 6851, 6861, or 6862 of this title where notice and demand takes place after Feb. 28, 1977, see section 1204(d) of Pub. L. 94–455, as amended, set out as a note under section 6851 of this title.""";
    content_hash "sha256:c36313ea018c668f9aadefc2125e50c39468d69e15a317060e5cb11b7e5b07a5";
