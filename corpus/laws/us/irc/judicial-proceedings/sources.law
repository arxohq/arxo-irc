// 26 U.S.C. §7443B — statutory note 2 (effectivedate-repeal-note)
fragment IRC_S7443B_NOTE_2 in IRC_2024_EDITION {
    kind note;
    locator "section/7443B/note/2";
    text en official """Effective Date of Repeal
Repeal effective as if included in the provisions of Pub. L. 109–280 to which the repeal relates, except as otherwise provided, see section 112 of Pub. L. 110–458, set out as an Effective Date of 2008 Amendment note under section 72 of this title.""";
    content_hash "sha256:8263c0375eaa61261ce64e8ec55a4e5ed4cd26bb554db15e69e5e3af9752e671";
