// Judicial proceedings -- WIRE-7 (26.09.2026, DECISION-0379, implemented_unverified).
//
// Each relation below was a local contract (a fact or an underived institutional placeholder naming its owner). The owner package
// publishes the same concept, so the local relation is now DERIVED from the owner's `pub` relation; the case-fact channel stays valid
// (an institutional relation may still be asserted, DECISIONS Д-15/Д-19), so existing scenarios are unchanged. Nothing is restated.
// JUDGMENT CALL: section 7701(a)(36) defines a tax return preparer per return; section 7407 speaks of the person, so the
// consumer relation is derived when the owner holds the person to be a preparer of ANY return (the return is an existential
// variable). The owner already excludes the section 7701(a)(36)(B) exceptions.

language "law.core" version "0.2";
package us.irc.judicial_proceedings version "0.1.1";
namespace "urn:us:irc:judicial_proceedings:clir";

use self::{
    Person,
    is_tax_return_preparer,
};

rule W7TaxReturnPreparerFromDefinitions strict {
    label en official "section 7407(a): a tax return preparer is a person who is a tax return preparer of some return under section 7701(a)(36) (owner package `definitions`)";
    for p: Person;
    for r: us.irc.core::Return;
    when us.irc.definitions::tax_return_preparer(p, r);
    then is_tax_return_preparer(p);
}

