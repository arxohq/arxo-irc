// Stage 2 — subchapter B of chapter 76, remaining parts of §§7422–7427:
// §7422(b)-(e),(g)-(j) (refund-suit rules), §7423 (repayments to
// officers), §7424 (intervention), §7426(b)-(i) (wrongful levy relief),
// §7427 (burden of proof: return preparers).
//
// METHOD NOTE. Court determinations that the text leaves to the court
// ("wrongfully levied upon", "irreparably injure rights ... superior to
// rights of the United States", a finding of reckless or negligent
// disregard) are DECISION-0194 `external judgment relation`s with the
// district court as authority. Relief the court "may grant" is a POWER of
// the court whose `valid_when` folds the finding; relief the court "shall
// grant" (§7426(b)(5), §7426(e)) is a DUTY of the court. The closed list of
// relief in §7426(b) is a PROHIBITION on the court (a judgment for other
// relief is VIOLATED on the prohibition itself, E-0179). §7422(e) stay:
// the stay period is computed from the §6213 petition window of
// `us.irc.assessment` plus 60 days; the counterclaim window is the stay.
// A conclusive presumption (§7426(c)) is an institutional effect keyed to
// the adjudication.
//
// JUDGMENT CALLS AND GAPS. The overpayment rate of §6621 is not computed
// here (payment-refunds-interest owns it): §7426(g) yields the accrual
// PERIOD only. §7426(h) damages reuse this package's §7433(d) exhaustion
// and 2-year limitation relations (the text says "The rules of section
// 7433(d) shall apply"); the mitigation reduction of §7433(d)(2) is in
// module 11.

language "law.core" version "0.2";
package us.irc.judicial_proceedings version "0.1.1";
namespace "urn:us:irc:judicial_proceedings:clir";

use self::{
    Assessment,
    Claim,
    IRC_S7422_B,
    IRC_S7422_C,
    IRC_S7422_D,
    IRC_S7422_E,
    IRC_S7422_G,
    IRC_S7422_I,
    IRC_S7422_J,
    IRC_S7423,
    IRC_S7424,
    IRC_S7426_B,
    IRC_S7426_C,
    IRC_S7426_D,
    IRC_S7426_E,
    IRC_S7426_F,
    IRC_S7426_G,
    IRC_S7426_H,
    IRC_S7427,
    Levy,
    Lien,
    Notice,
    Person,
    Proceeding,
    TaxKind,
    TaxableYear,
    fraud_issue_raised,
    refund_suit_permitted,
    wrongful_levy_suit_brought,
};

// ============================================================================
// §7422(b) — Protest or duress
// ============================================================================

pub relation refund_tax_paid_under_protest_or_duress(pr: Proceeding, p: Person, c: Claim) kind empirical {
    label en unofficial "the tax, penalty, or sum was paid under protest or duress (irrelevant to maintenance of the suit; recorded so that the rule can be tested both ways)";
}
pub relation refund_suit_maintainable_regardless_of_protest(pr: Proceeding, p: Person, c: Claim) kind institutional;
@source(IRC_S7422_B, relation = formalizes, coverage = exact, quote = "Such suit or proceeding may be maintained whether or not such tax, penalty, or sum has been paid under protest or duress.")
pub rule S7422bProtestIrrelevant strict {
    label en official "Such suit or proceeding may be maintained whether or not such tax, penalty, or sum has been paid under protest or duress.";
    for pr: Proceeding;
    for p: Person;
    for c: Claim;
    when refund_suit_permitted(pr, p, c);
    then refund_suit_maintainable_regardless_of_protest(pr, p, c);
}

// ============================================================================
// §7422(c) — Suits against collection officers: res judicata
// ============================================================================

pub relation suit_against_officer_for_recovery(pr: Proceeding, officer: Person) kind empirical {
    label en official "A suit against any officer or employee of the United States (or former officer or employee) or his personal representative for the recovery of any internal revenue tax alleged to have been erroneously or illegally assessed or collected";
}
pub relation treated_as_suit_with_united_states_party_for_res_judicata(pr: Proceeding, officer: Person) kind institutional;
@source(IRC_S7422_C, relation = formalizes, coverage = exact, quote = "shall be treated as if the United States had been a party to such suit in applying the doctrine of res judicata in all suits in respect of any internal revenue tax, and in all proceedings in the Tax Court and on review of decisions of the Tax Court.")
pub rule S7422cResJudicataTreatment strict {
    label en official "shall be treated as if the United States had been a party to such suit in applying the doctrine of res judicata in all suits in respect of any internal revenue tax, and in all proceedings in the Tax Court and on review of decisions of the Tax Court.";
    for pr: Proceeding;
    for officer: Person;
    when suit_against_officer_for_recovery(pr, officer);
    then treated_as_suit_with_united_states_party_for_res_judicata(pr, officer);
}

// ============================================================================
// §7422(d) — Credit treated as payment
// ============================================================================

pub relation overpayment_credited_in_satisfaction(p: Person, y: TaxableYear, k: TaxKind, amount: Money, allowedOn: Date) kind empirical {
    label en official "The credit of an overpayment of any tax in satisfaction of any tax liability";
}
pub relation credit_deemed_payment_for_refund_suit(p: Person, y: TaxableYear, k: TaxKind, amount: Money, paidOn: Date) kind institutional;
@source(IRC_S7422_D, relation = formalizes, coverage = exact, quote = "be deemed to be a payment in respect of such tax liability at the time such credit is allowed.")
pub rule S7422dCreditDeemedPayment strict {
    label en official "be deemed to be a payment in respect of such tax liability at the time such credit is allowed.";
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for amount: Money;
    for allowedOn: Date;
    when overpayment_credited_in_satisfaction(p, y, k, amount, allowedOn);
    then credit_deemed_payment_for_refund_suit(p, y, k, amount, allowedOn);
}

// ============================================================================
// §7422(e) — Stay of proceedings in a refund suit after a notice of deficiency
// ============================================================================

pub relation deficiency_notice_mailed_pending_refund_suit(pr: Proceeding, n: Notice, p: Person) kind empirical {
    label en official "the Secretary prior to the hearing of a suit brought by a taxpayer in a district court or the United States Court of Federal Claims for the recovery of any income tax, estate tax, gift tax, or tax imposed by chapter 41, 42, 43, or 44 (or any penalty relating to such taxes) mails to the taxpayer a notice that a deficiency has been determined in respect of the tax which is the subject matter of taxpayer's suit";
}
pub relation refund_suit_stay_period(pr: Proceeding, n: Notice, fromDate: Date, toDate: Date) kind institutional {
    label en unofficial "the proceedings in the refund suit are stayed during the period in which the taxpayer may file a Tax Court petition for redetermination of the asserted deficiency, and for 60 days thereafter";
}
@source(IRC_S7422_E, relation = formalizes, coverage = exact, quote = "the proceedings in taxpayer's suit shall be stayed during the period of time in which the taxpayer may file a petition with the Tax Court for a redetermination of the asserted deficiency, and for 60 days thereafter.")
pub rule S7422eStayPeriod defeasible {
    label en official "the proceedings in taxpayer's suit shall be stayed during the period of time in which the taxpayer may file a petition with the Tax Court for a redetermination of the asserted deficiency, and for 60 days thereafter.";
    for pr: Proceeding;
    for n: Notice;
    for p: Person;
    for mailed: Date;
    for deadline: Date;
    when deficiency_notice_mailed_pending_refund_suit(pr, n, p)
        and us.irc.core::mailed_on(n, mailed)
        and us.irc.assessment::petition_window_deadline(n, p, deadline);
    then refund_suit_stay_period(pr, n, mailed, add_calendar_period(deadline, 60 calendar_day));
}
pub relation taxpayer_files_tax_court_petition_on_refund_notice(pr: Proceeding, n: Notice, p: Person) kind empirical;
pub relation refund_court_loses_jurisdiction_to_extent_of_tax_court(pr: Proceeding, n: Notice) kind institutional;
@source(IRC_S7422_E, relation = formalizes, coverage = exact, quote = "If the taxpayer files a petition with the Tax Court, the district court or the United States Court of Federal Claims, as the case may be, shall lose jurisdiction of taxpayer's suit to whatever extent jurisdiction is acquired by the Tax Court of the subject matter of taxpayer's suit for refund.")
pub rule S7422eJurisdictionLostOnPetition strict {
    label en official "If the taxpayer files a petition with the Tax Court, the district court or the United States Court of Federal Claims, as the case may be, shall lose jurisdiction of taxpayer's suit to whatever extent jurisdiction is acquired by the Tax Court of the subject matter of taxpayer's suit for refund.";
    for pr: Proceeding;
    for n: Notice;
    for p: Person;
    when deficiency_notice_mailed_pending_refund_suit(pr, n, p)
        and taxpayer_files_tax_court_petition_on_refund_notice(pr, n, p);
    then refund_court_loses_jurisdiction_to_extent_of_tax_court(pr, n);
}
pub relation us_counterclaim_or_intervention_filed_on(pr: Proceeding, n: Notice, on: Date) kind empirical;
pub relation counterclaim_within_stay_permitted(pr: Proceeding, n: Notice, on: Date) kind institutional {
    label en unofficial "the taxpayer did not file a Tax Court petition and the counterclaim or intervention is made within the period of the stay";
}
@source(IRC_S7422_E, relation = formalizes, coverage = exact, quote = "If the taxpayer does not file a petition with the Tax Court for a redetermination of the asserted deficiency, the United States may counterclaim in the taxpayer's suit, or intervene in the event of a suit as described in subsection (c) (relating to suits against officers or employees of the United States), within the period of the stay of proceedings notwithstanding that the time for such pleading may have otherwise expired.")
pub rule S7422eCounterclaimWithinStay defeasible {
    label en official "If the taxpayer does not file a petition with the Tax Court for a redetermination of the asserted deficiency, the United States may counterclaim in the taxpayer's suit, or intervene in the event of a suit as described in subsection (c) (relating to suits against officers or employees of the United States), within the period of the stay of proceedings notwithstanding that the time for such pleading may have otherwise expired.";
    for pr: Proceeding;
    for n: Notice;
    for p: Person;
    for fromDate: Date;
    for toDate: Date;
    for on: Date;
    when deficiency_notice_mailed_pending_refund_suit(pr, n, p)
        and refund_suit_stay_period(pr, n, fromDate, toDate)
        and us_counterclaim_or_intervention_filed_on(pr, n, on)
        and on >= fromDate
        and on <= toDate
        and not_known(taxpayer_files_tax_court_petition_on_refund_notice(pr, n, p));
    then counterclaim_within_stay_permitted(pr, n, on);
}
pub relation counterclaim_or_intervention_allowed(pr: Proceeding, n: Notice) kind institutional;
@source(IRC_S7422_E, relation = formalizes, coverage = exact, quote = "the United States may counterclaim in the taxpayer's suit, or intervene in the event of a suit as described in subsection (c)")
pub rule S7422eCounterclaimPowerRule defeasible {
    label en official "the United States may counterclaim in the taxpayer's suit, or intervene in the event of a suit as described in subsection (c)";
    for pr: Proceeding;
    for n: Notice;
    for on: Date;
    when us_counterclaim_or_intervention_filed_on(pr, n, on);
    then power S7422eUnitedStatesCounterclaim {
        holder us.irc.core::Secretary;
        exercise us_counterclaim_or_intervention_filed_on(pr, n, on);
        valid_when counterclaim_within_stay_permitted(pr, n, on);
        effect counterclaim_or_intervention_allowed(pr, n);
    };
}
pub relation counterclaim_issue_raised(pr: Proceeding, p: Person) kind empirical {
    label en unofficial "an issue is raised by the counterclaim or intervention of the United States";
}
pub relation taxpayer_burden_on_counterclaim_issue(pr: Proceeding, p: Person) kind institutional;
@source(IRC_S7422_E, relation = formalizes, coverage = exact, quote = "The taxpayer shall have the burden of proof with respect to the issues raised by such counterclaim or intervention of the United States except as to the issue of whether the taxpayer has been guilty of fraud with intent to evade tax.")
pub rule S7422eBurdenOnTaxpayer defeasible {
    label en official "The taxpayer shall have the burden of proof with respect to the issues raised by such counterclaim or intervention of the United States except as to the issue of whether the taxpayer has been guilty of fraud with intent to evade tax.";
    for pr: Proceeding;
    for p: Person;
    when counterclaim_issue_raised(pr, p);
    then taxpayer_burden_on_counterclaim_issue(pr, p);
    unless fraud_issue_raised(pr, p);
}

// ============================================================================
// §7422(g) — Special rules for certain excise taxes of chapters 42 and 43
// ============================================================================

pub relation first_tier_tax_paid_in_full(p: Person, taxableEvent: Text) kind empirical {
    label en official "payment of the full amount of the first tier tax";
}
pub relation second_tier_refund_action_may_be_maintained(p: Person, taxableEvent: Text) kind institutional;
@source(IRC_S7422_G, relation = formalizes, coverage = exact, quote = "With respect to any taxable event, payment of the full amount of the first tier tax shall constitute sufficient payment in order to maintain an action under this section with respect to the second tier tax.")
pub rule S7422g1FirstTierPaymentSuffices strict {
    label en official "With respect to any taxable event, payment of the full amount of the first tier tax shall constitute sufficient payment in order to maintain an action under this section with respect to the second tier tax.";
    for p: Person;
    for taxableEvent: Text;
    when first_tier_tax_paid_in_full(p, taxableEvent);
    then second_tier_refund_action_may_be_maintained(p, taxableEvent);
}
pub relation chapter_42_43_refund_suit(pr: Proceeding, p: Person, act: Text) kind empirical {
    label en official "any suit for the credit or refund of any tax imposed under section 4941, 4942, 4943, 4944, 4945, 4951, 4952, 4955, 4958, 4971, or 4975 with respect to any act (or failure to act) giving rise to liability for tax under such sections";
}
pub relation other_suit_or_tax_court_petition_for_act(act: Text) kind empirical {
    label en official "another suit has been maintained for credit or refund of, or a petition has been filed in the Tax Court with respect to a deficiency in, any other tax imposed by such sections with respect to such act (or failure to act)";
}
pub relation chapter_42_43_refund_suit_maintainable(pr: Proceeding, p: Person, act: Text) kind institutional;
@source(IRC_S7422_G, relation = formalizes, coverage = exact, quote = "No suit may be maintained under this section for the credit or refund of any tax imposed under section 4941, 4942, 4943, 4944, 4945, 4951, 4952, 4955, 4958, 4971, or 4975 with respect to any act (or failure to act) giving rise to liability for tax under such sections, unless no other suit has been maintained for credit or refund of, and no petition has been filed in the Tax Court with respect to a deficiency in, any other tax imposed by such sections with respect to such act (or failure to act).")
pub rule S7422g2OneSuitPerAct defeasible {
    label en official "No suit may be maintained under this section for the credit or refund of any tax imposed under section 4941, 4942, 4943, 4944, 4945, 4951, 4952, 4955, 4958, 4971, or 4975 with respect to any act (or failure to act) giving rise to liability for tax under such sections, unless no other suit has been maintained for credit or refund of, and no petition has been filed in the Tax Court with respect to a deficiency in, any other tax imposed by such sections with respect to such act (or failure to act).";
    for pr: Proceeding;
    for p: Person;
    for act: Text;
    when chapter_42_43_refund_suit(pr, p, act)
        and not_known(other_suit_or_tax_court_petition_for_act(act));
    then chapter_42_43_refund_suit_maintainable(pr, p, act);
}
pub relation suit_determines_all_questions_for_act(pr: Proceeding, act: Text) kind institutional;
@source(IRC_S7422_G, relation = formalizes, coverage = exact, quote = "shall constitute a suit to determine all questions with respect to any other tax imposed with respect to such act (or failure to act) under such sections, and failure by the parties to such suit to bring any such question before the Court shall constitute a bar to such question.")
pub rule S7422g3AllQuestionsDetermined strict {
    label en official "shall constitute a suit to determine all questions with respect to any other tax imposed with respect to such act (or failure to act) under such sections, and failure by the parties to such suit to bring any such question before the Court shall constitute a bar to such question.";
    for pr: Proceeding;
    for p: Person;
    for act: Text;
    when chapter_42_43_refund_suit(pr, p, act);
    then suit_determines_all_questions_for_act(pr, act);
}
pub relation question_omitted_from_chapter_42_43_suit(pr: Proceeding, act: Text) kind institutional;
@source(IRC_S7422_G, relation = formalizes, coverage = exact, quote = "and failure by the parties to such suit to bring any such question before the Court shall constitute a bar to such question.")
pub rule S7422g3QuestionBarred defeasible {
    label en official "and failure by the parties to such suit to bring any such question before the Court shall constitute a bar to such question.";
    for pr: Proceeding;
    for p: Person;
    for act: Text;
    when chapter_42_43_refund_suit(pr, p, act)
        and question_not_brought_before_court(pr, act);
    then question_omitted_from_chapter_42_43_suit(pr, act);
}
pub relation question_not_brought_before_court(pr: Proceeding, act: Text) kind empirical;

// ============================================================================
// §7422(i) — Court of Federal Claims: §6700 and §6701 penalties
// ============================================================================

pub relation cfc_refund_action_for_6700_or_6701_penalty(pr: Proceeding, p: Person) kind empirical {
    label en official "an action or proceeding brought in the United States Court of Federal Claims for any refund or credit of a penalty imposed by section 6700 or section 6701";
}
@source(IRC_S7422_I, relation = formalizes, coverage = exact, quote = "No action or proceeding may be brought in the United States Court of Federal Claims for any refund or credit of a penalty imposed by section 6700")
pub rule S7422iNoCfcRefundActionRule strict {
    label en official "No action or proceeding may be brought in the United States Court of Federal Claims for any refund or credit of a penalty imposed by section 6700";
    for pr: Proceeding;
    for p: Person;
    when cfc_refund_action_for_6700_or_6701_penalty(pr, p);
    then immunity S7422iNoCfcRefundActionImmunity {
        holder us.irc.core::Secretary;
        protected_effect cfc_refund_action_for_6700_or_6701_penalty(pr, p);
        window [-infinity, infinity];
    };
}

// ============================================================================
// §7422(j) — Estates with a §6166 election
// ============================================================================

pub relation estate_representative_action_for_estate_tax_liability(pr: Proceeding, e: Person) kind empirical {
    label en official "an action brought by the representative of an estate to determine the correct amount of the estate tax liability of such estate (or for any refund with respect thereto)";
}
pub relation section_6166_installments_accelerated(e: Person) kind empirical {
    label en official "portion of the installments payable under section 6166 have been accelerated";
}
pub relation section_6166_due_installments_paid_at_filing(e: Person) kind empirical {
    label en official "all such installments the due date for which is on or before the date the action is filed have been paid";
}
pub relation estate_tax_case_pending_in_tax_court(e: Person) kind empirical {
    label en official "there is a case pending in the Tax Court with respect to the tax imposed by section 2001 on the estate";
}
pub relation estate_deficiency_petition_period_open(e: Person) kind empirical {
    label en official "a notice of deficiency under section 6212 with respect to such tax has been issued and the time for filing a petition with the Tax Court with respect to such notice has not expired";
}
pub relation declaratory_judgment_7479_pending(e: Person) kind empirical {
    label en official "a proceeding for declaratory judgment under section 7479 is pending";
}
pub relation estate_6166_subsection_j_applies(e: Person) kind institutional {
    label en unofficial "the estate is one to which §7422(j) applies (conditions (A)-(D) of paragraph (2))";
}
@source(IRC_S7422_J, relation = formalizes, coverage = exact, quote = "This subsection shall apply to any estate if, as of the date the action is filed—")
pub rule S7422j2EstatesToWhichApplies defeasible {
    label en official "This subsection shall apply to any estate if, as of the date the action is filed—";
    for pr: Proceeding;
    for e: Person;
    when estate_representative_action_for_estate_tax_liability(pr, e)
        and section_6166_due_installments_paid_at_filing(e)
        and not_known(section_6166_installments_accelerated(e))
        and not_known(estate_tax_case_pending_in_tax_court(e))
        and not_known(estate_deficiency_petition_period_open(e))
        and not_known(declaratory_judgment_7479_pending(e));
    then estate_6166_subsection_j_applies(e);
}
pub relation full_estate_tax_not_paid_by_reason_of_6166(e: Person) kind empirical {
    label en official "the full amount of such liability has not been paid by reason of an election under section 6166 with respect to such estate";
}
pub relation estate_action_jurisdiction_not_defeated_by_6166(pr: Proceeding, e: Person) kind institutional;
@source(IRC_S7422_J, relation = formalizes, coverage = exact, quote = "The district courts of the United States and the United States Court of Federal Claims shall not fail to have jurisdiction over any action brought by the representative of an estate to which this subsection applies to determine the correct amount of the estate tax liability of such estate (or for any refund with respect thereto) solely because the full amount of such liability has not been paid by reason of an election under section 6166 with respect to such estate.")
pub rule S7422j1JurisdictionDespiteUnpaidLiability defeasible {
    label en official "The district courts of the United States and the United States Court of Federal Claims shall not fail to have jurisdiction over any action brought by the representative of an estate to which this subsection applies to determine the correct amount of the estate tax liability of such estate (or for any refund with respect thereto) solely because the full amount of such liability has not been paid by reason of an election under section 6166 with respect to such estate.";
    for pr: Proceeding;
    for e: Person;
    when estate_representative_action_for_estate_tax_liability(pr, e)
        and estate_6166_subsection_j_applies(e)
        and full_estate_tax_not_paid_by_reason_of_6166(e);
    then estate_action_jurisdiction_not_defeated_by_6166(pr, e);
}
pub relation estate_liability_disallowed_by_final_decision(pr: Proceeding, e: Person) kind empirical {
    label en official "such liability which is disallowed by a decision of such court which has become final";
}
pub relation secretary_collects_disallowed_estate_liability(e: Person) kind empirical;
@source(IRC_S7422_J, relation = formalizes, coverage = exact, quote = "no part of such liability which is disallowed by a decision of such court which has become final may be collected by the Secretary")
pub rule S7422j3NoCollectionOfDisallowedRule strict {
    label en official "no part of such liability which is disallowed by a decision of such court which has become final may be collected by the Secretary";
    for pr: Proceeding;
    for e: Person;
    when estate_liability_disallowed_by_final_decision(pr, e);
    then prohibition S7422j3NoCollectionOfDisallowedEstateLiability {
        bearer us.irc.core::Secretary;
        action secretary_collects_disallowed_estate_liability(e);
        window [-infinity, infinity];
    };
}
pub relation estate_paid_in_excess_of_currently_due(pr: Proceeding, e: Person, excess: Money) kind empirical {
    label en official "amounts paid in excess of the installments determined by the court as currently due and payable";
}
pub relation estate_excess_refunded(e: Person, excess: Money) kind empirical;
@source(IRC_S7422_J, relation = formalizes, coverage = exact, quote = "and amounts paid in excess of the installments determined by the court as currently due and payable shall be refunded.")
pub rule S7422j3ExcessRefundDutyRule strict {
    label en official "and amounts paid in excess of the installments determined by the court as currently due and payable shall be refunded.";
    for pr: Proceeding;
    for e: Person;
    for excess: Money;
    when estate_paid_in_excess_of_currently_due(pr, e, excess);
    then duty S7422j3RefundExcessPaid {
        bearer us.irc.core::Secretary;
        beneficiary e;
        goal achievement {
            condition estate_excess_refunded(e, excess);
            window [-infinity, infinity];
        }
    };
}

// ============================================================================
// §7423 — Repayments to officers or employees
// ============================================================================

pub relation sums_recovered_against_officer_for_taxes_collected(officer: Person, amount: Money) kind empirical {
    label en official "such sums of money as may be recovered against him in any court, for any internal revenue taxes collected by him, with the cost and expense of suit";
}
pub relation damages_and_costs_recovered_against_officer_for_official_duty(officer: Person, amount: Money) kind empirical {
    label en official "All damages and costs recovered against any officer or employee of the United States in any suit brought against him by reason of anything done in the due performance of his official duty under this title";
}
pub relation secretary_repays_officer(officer: Person, amount: Money) kind empirical;
pub relation officer_repayment_authorized(officer: Person, amount: Money) kind institutional {
    label en unofficial "repayment to the officer or employee is within the Secretary's authority under §7423, subject to regulations";
}
@source(IRC_S7423, relation = formalizes, coverage = exact, quote = "To any officer or employee of the United States the full amount of such sums of money as may be recovered against him in any court, for any internal revenue taxes collected by him, with the cost and expense of suit")
pub rule S7423CollectionsRecoveredRepayable strict {
    label en official "To any officer or employee of the United States the full amount of such sums of money as may be recovered against him in any court, for any internal revenue taxes collected by him, with the cost and expense of suit";
    for officer: Person;
    for amount: Money;
    when sums_recovered_against_officer_for_taxes_collected(officer, amount);
    then officer_repayment_authorized(officer, amount);
}
@source(IRC_S7423, relation = formalizes, coverage = exact, quote = "All damages and costs recovered against any officer or employee of the United States in any suit brought against him by reason of anything done in the due performance of his official duty under this title.")
pub rule S7423DamagesRecoveredRepayable strict {
    label en official "All damages and costs recovered against any officer or employee of the United States in any suit brought against him by reason of anything done in the due performance of his official duty under this title.";
    for officer: Person;
    for amount: Money;
    when damages_and_costs_recovered_against_officer_for_official_duty(officer, amount);
    then officer_repayment_authorized(officer, amount);
}
pub relation officer_repaid(officer: Person, amount: Money) kind institutional;
@source(IRC_S7423, relation = formalizes, coverage = partial, quote = "The Secretary, subject to regulations prescribed by the Secretary, is authorized to repay")
pub rule S7423RepayPowerRule strict {
    label en official "The Secretary, subject to regulations prescribed by the Secretary, is authorized to repay";
    for officer: Person;
    for amount: Money;
    when secretary_repays_officer(officer, amount);
    then power S7423RepayOfficer {
        holder us.irc.core::Secretary;
        over officer;
        exercise secretary_repays_officer(officer, amount);
        valid_when officer_repayment_authorized(officer, amount);
        effect officer_repaid(officer, amount);
    };
}

// ============================================================================
// §7424 — Intervention by the United States to assert a lien
// ============================================================================

pub relation us_not_party_to_civil_action(pr: Proceeding) kind empirical {
    label en official "the United States is not a party to a civil action or suit";
}
pub relation civil_action_concerns_property_subject_to_us_lien(pr: Proceeding, lien: Lien) kind empirical {
    label en official "any lien arising under this title on the property which is the subject of such action or suit";
}
pub relation us_applies_to_intervene(pr: Proceeding, lien: Lien) kind empirical;
pub relation us_intervention_to_assert_lien(pr: Proceeding, lien: Lien) kind institutional;
@source(IRC_S7424, relation = formalizes, coverage = exact, quote = "If the United States is not a party to a civil action or suit, the United States may intervene in such action or suit to assert any lien arising under this title on the property which is the subject of such action or suit.")
pub rule S7424InterventionPowerRule strict {
    label en official "If the United States is not a party to a civil action or suit, the United States may intervene in such action or suit to assert any lien arising under this title on the property which is the subject of such action or suit.";
    for pr: Proceeding;
    for lien: Lien;
    when us_applies_to_intervene(pr, lien);
    then power S7424InterveneToAssertLien {
        holder us.irc.core::Secretary;
        exercise us_applies_to_intervene(pr, lien);
        valid_when civil_action_concerns_property_subject_to_us_lien(pr, lien);
        effect us_intervention_to_assert_lien(pr, lien);
    };
}
pub relation us_treated_as_originally_named_defendant(pr: Proceeding, lien: Lien) kind institutional {
    label en unofficial "28 U.S.C. 2410 (except (b)) and 1444 apply as if the United States had originally been named a defendant";
}
@source(IRC_S7424, relation = formalizes, coverage = exact, quote = "shall apply in any case in which the United States intervenes as if the United States had originally been named a defendant in such action or suit.")
pub rule S7424TreatedAsOriginalDefendant strict {
    label en official "shall apply in any case in which the United States intervenes as if the United States had originally been named a defendant in such action or suit.";
    for pr: Proceeding;
    for lien: Lien;
    when us_intervention_to_assert_lien(pr, lien);
    then us_treated_as_originally_named_defendant(pr, lien);
}
pub relation us_application_to_intervene_denied(pr: Proceeding, lien: Lien) kind empirical;
pub relation adjudication_without_effect_on_us_lien(pr: Proceeding, lien: Lien) kind institutional;
@source(IRC_S7424, relation = formalizes, coverage = exact, quote = "In any case in which the application of the United States to intervene is denied, the adjudication in such civil action or suit shall have no effect upon such lien.")
pub rule S7424DenialLeavesLienUnaffected strict {
    label en official "In any case in which the application of the United States to intervene is denied, the adjudication in such civil action or suit shall have no effect upon such lien.";
    for pr: Proceeding;
    for lien: Lien;
    when us_application_to_intervene_denied(pr, lien);
    then adjudication_without_effect_on_us_lien(pr, lien);
}

// ============================================================================
// §7426(b) — Relief in a wrongful-levy action
// ============================================================================

external judgment relation levy_would_irreparably_injure_superior_rights(pr: Proceeding, levy: Levy) {
    authority DistrictCourt;
    label en official "a levy or sale would irreparably injure rights in property which the court determines to be superior to rights of the United States in such property";
}
pub relation court_enjoins_levy_or_sale(pr: Proceeding, levy: Levy) kind empirical;
pub relation levy_or_sale_enjoined(pr: Proceeding, levy: Levy) kind institutional;
@source(IRC_S7426_B, relation = formalizes, coverage = exact, quote = "the court may grant an injunction to prohibit the enforcement of such levy or to prohibit such sale.")
pub rule S7426b1InjunctionPowerRule defeasible {
    label en official "the court may grant an injunction to prohibit the enforcement of such levy or to prohibit such sale.";
    for pr: Proceeding;
    for levy: Levy;
    when court_enjoins_levy_or_sale(pr, levy);
    then power S7426b1EnjoinLevyOrSale {
        holder us.irc.core::DistrictCourt;
        exercise court_enjoins_levy_or_sale(pr, levy);
        valid_when levy_would_irreparably_injure_superior_rights(pr, levy);
        effect levy_or_sale_enjoined(pr, levy);
    };
}
external judgment relation property_wrongfully_levied_upon(pr: Proceeding, levy: Levy) {
    authority DistrictCourt;
    label en official "such property has been wrongfully levied upon";
}
pub relation us_in_possession_of_levied_property(pr: Proceeding, levy: Levy) kind empirical {
    label en official "the United States is in possession of such property";
}
pub relation wrongful_levy_property_return_available(pr: Proceeding, levy: Levy) kind institutional;
@source(IRC_S7426_B, relation = formalizes, coverage = exact, quote = "(A) order the return of specific property if the United States is in possession of such property;")
pub rule S7426b2AReturnGrounds defeasible {
    label en official "(A) order the return of specific property if the United States is in possession of such property;";
    for pr: Proceeding;
    for levy: Levy;
    when property_wrongfully_levied_upon(pr, levy)
        and us_in_possession_of_levied_property(pr, levy);
    then wrongful_levy_property_return_available(pr, levy);
}
pub relation court_orders_return_of_property(pr: Proceeding, levy: Levy) kind empirical;
pub relation levied_property_returned_by_order(pr: Proceeding, levy: Levy) kind institutional;
@source(IRC_S7426_B, relation = formalizes, coverage = exact, quote = "(A) order the return of specific property if the United States is in possession of such property;")
pub rule S7426b2AReturnPowerRule defeasible {
    label en official "(A) order the return of specific property if the United States is in possession of such property;";
    for pr: Proceeding;
    for levy: Levy;
    when court_orders_return_of_property(pr, levy);
    then power S7426b2AOrderReturnOfProperty {
        holder us.irc.core::DistrictCourt;
        exercise court_orders_return_of_property(pr, levy);
        valid_when wrongful_levy_property_return_available(pr, levy);
        effect levied_property_returned_by_order(pr, levy);
    };
}
pub relation money_levied_upon_amount(pr: Proceeding, levy: Levy, amount: Money) kind empirical {
    label en official "the amount of money levied upon";
}
pub relation court_grants_money_levied_judgment(pr: Proceeding, levy: Levy, amount: Money) kind empirical;
pub relation wrongful_levy_money_judgment_amount_permitted(pr: Proceeding, levy: Levy, amount: Money) kind institutional;
@source(IRC_S7426_B, relation = formalizes, coverage = exact, quote = "(B) grant a judgment for the amount of money levied upon; or")
pub rule S7426b2BMoneyJudgmentGrounds defeasible {
    label en official "(B) grant a judgment for the amount of money levied upon; or";
    for pr: Proceeding;
    for levy: Levy;
    for amount: Money;
    when property_wrongfully_levied_upon(pr, levy)
        and money_levied_upon_amount(pr, levy, amount);
    then wrongful_levy_money_judgment_amount_permitted(pr, levy, amount);
}
pub relation money_levied_judgment_granted(pr: Proceeding, levy: Levy, amount: Money) kind institutional;
@source(IRC_S7426_B, relation = formalizes, coverage = exact, quote = "(B) grant a judgment for the amount of money levied upon; or")
pub rule S7426b2BMoneyJudgmentPowerRule defeasible {
    label en official "(B) grant a judgment for the amount of money levied upon; or";
    for pr: Proceeding;
    for levy: Levy;
    for amount: Money;
    when court_grants_money_levied_judgment(pr, levy, amount);
    then power S7426b2BGrantMoneyJudgment {
        holder us.irc.core::DistrictCourt;
        exercise court_grants_money_levied_judgment(pr, levy, amount);
        valid_when wrongful_levy_money_judgment_amount_permitted(pr, levy, amount);
        effect money_levied_judgment_granted(pr, levy, amount);
    };
}
// (C) sale judgment: not exceeding the greater of the amount received and the FMV.
pub relation amount_received_by_us_from_sale(pr: Proceeding, levy: Levy, amount: Money) kind empirical {
    label en official "the amount received by the United States from the sale of such property";
}
pub relation fair_market_value_immediately_before_levy(pr: Proceeding, levy: Levy, amount: Money) kind empirical {
    label en official "the fair market value of such property immediately before the levy";
}
pub relation us_purchased_at_6335e_sale(pr: Proceeding, levy: Levy) kind empirical {
    label en official "the property was declared purchased by the United States at a sale pursuant to section 6335(e)";
}
pub relation minimum_price_or_resale_amount(pr: Proceeding, levy: Levy, minimumPrice: Money, resale: Money) kind empirical;
pub relation us_deemed_received_from_sale(pr: Proceeding, levy: Levy, amount: Money) kind institutional {
    label en unofficial "the amount the United States is treated as having received from the sale for §7426(b)(2)(C): actual receipts, or for a §6335(e) purchase the minimum price or (if larger) the resale amount";
}
@source(IRC_S7426_B, relation = formalizes, coverage = exact, quote = "the amount received by the United States from the sale of such property, or")
pub rule S7426b2CActualReceipts defeasible {
    label en official "the amount received by the United States from the sale of such property, or";
    for pr: Proceeding;
    for levy: Levy;
    for amount: Money;
    when amount_received_by_us_from_sale(pr, levy, amount)
        and not_known(us_purchased_at_6335e_sale(pr, levy));
    then us_deemed_received_from_sale(pr, levy, amount);
}
@source(IRC_S7426_B, relation = formalizes, coverage = exact, quote = "the United States shall be treated as having received an amount equal to the minimum price determined pursuant to such section or (if larger) the amount received by the United States from the resale of such property.")
pub rule S7426b2CDeemedReceiptMinimumLarger defeasible {
    label en official "the United States shall be treated as having received an amount equal to the minimum price determined pursuant to such section or (if larger) the amount received by the United States from the resale of such property.";
    for pr: Proceeding;
    for levy: Levy;
    for minimumPrice: Money;
    for resale: Money;
    when us_purchased_at_6335e_sale(pr, levy)
        and minimum_price_or_resale_amount(pr, levy, minimumPrice, resale)
        and minimumPrice >= resale;
    then us_deemed_received_from_sale(pr, levy, minimumPrice);
}
@source(IRC_S7426_B, relation = formalizes, coverage = exact, quote = "the United States shall be treated as having received an amount equal to the minimum price determined pursuant to such section or (if larger) the amount received by the United States from the resale of such property.")
pub rule S7426b2CDeemedReceiptResaleLarger defeasible {
    label en official "the United States shall be treated as having received an amount equal to the minimum price determined pursuant to such section or (if larger) the amount received by the United States from the resale of such property.";
    for pr: Proceeding;
    for levy: Levy;
    for minimumPrice: Money;
    for resale: Money;
    when us_purchased_at_6335e_sale(pr, levy)
        and minimum_price_or_resale_amount(pr, levy, minimumPrice, resale)
        and resale > minimumPrice;
    then us_deemed_received_from_sale(pr, levy, resale);
}
pub relation wrongful_levy_sale_judgment_cap(pr: Proceeding, levy: Levy, cap: Money) kind institutional;
@source(IRC_S7426_B, relation = formalizes, coverage = exact, quote = "grant a judgment for an amount not exceeding the greater of—")
pub rule S7426b2CCapDeemedReceiptGreater defeasible {
    label en official "grant a judgment for an amount not exceeding the greater of—";
    for pr: Proceeding;
    for levy: Levy;
    for received: Money;
    for fmv: Money;
    when us_deemed_received_from_sale(pr, levy, received)
        and fair_market_value_immediately_before_levy(pr, levy, fmv)
        and received >= fmv;
    then wrongful_levy_sale_judgment_cap(pr, levy, received);
}
@source(IRC_S7426_B, relation = formalizes, coverage = exact, quote = "grant a judgment for an amount not exceeding the greater of—")
pub rule S7426b2CCapFmvGreater defeasible {
    label en official "grant a judgment for an amount not exceeding the greater of—";
    for pr: Proceeding;
    for levy: Levy;
    for received: Money;
    for fmv: Money;
    when us_deemed_received_from_sale(pr, levy, received)
        and fair_market_value_immediately_before_levy(pr, levy, fmv)
        and fmv > received;
    then wrongful_levy_sale_judgment_cap(pr, levy, fmv);
}
pub relation court_grants_sale_judgment(pr: Proceeding, levy: Levy, amount: Money) kind empirical;
pub relation sale_judgment_amount_permitted(pr: Proceeding, levy: Levy, amount: Money) kind institutional;
@source(IRC_S7426_B, relation = formalizes, coverage = exact, quote = "(C) if such property was sold, grant a judgment for an amount not exceeding the greater of—")
pub rule S7426b2CSaleJudgmentWithinCap defeasible {
    label en official "(C) if such property was sold, grant a judgment for an amount not exceeding the greater of—";
    for pr: Proceeding;
    for levy: Levy;
    for amount: Money;
    for cap: Money;
    when property_wrongfully_levied_upon(pr, levy)
        and wrongful_levy_sale_judgment_cap(pr, levy, cap)
        and court_grants_sale_judgment(pr, levy, amount)
        and amount <= cap;
    then sale_judgment_amount_permitted(pr, levy, amount);
}
pub relation sale_judgment_granted(pr: Proceeding, levy: Levy, amount: Money) kind institutional;
@source(IRC_S7426_B, relation = formalizes, coverage = exact, quote = "(C) if such property was sold, grant a judgment for an amount not exceeding the greater of—")
pub rule S7426b2CSaleJudgmentPowerRule defeasible {
    label en official "(C) if such property was sold, grant a judgment for an amount not exceeding the greater of—";
    for pr: Proceeding;
    for levy: Levy;
    for amount: Money;
    when court_grants_sale_judgment(pr, levy, amount);
    then power S7426b2CGrantSaleJudgment {
        holder us.irc.core::DistrictCourt;
        exercise court_grants_sale_judgment(pr, levy, amount);
        valid_when sale_judgment_amount_permitted(pr, levy, amount);
        effect sale_judgment_granted(pr, levy, amount);
    };
}
external judgment relation interest_transferred_to_sale_proceeds(pr: Proceeding, claimant: Person) {
    authority DistrictCourt;
    label en official "the interest or lien of any party to an action under this section was transferred to the proceeds of a sale of such property";
}
pub relation surplus_proceeds_amount(pr: Proceeding, amount: Money) kind empirical;
pub relation court_grants_surplus_proceeds_judgment(pr: Proceeding, claimant: Person, amount: Money) kind empirical;
pub relation surplus_proceeds_judgment_amount_permitted(pr: Proceeding, claimant: Person, amount: Money) kind institutional;
@source(IRC_S7426_B, relation = formalizes, coverage = exact, quote = "the court may grant a judgment in an amount equal to all or any part of the amount of the surplus proceeds of such sale.")
pub rule S7426b3SurplusJudgmentWithinSurplus defeasible {
    label en official "the court may grant a judgment in an amount equal to all or any part of the amount of the surplus proceeds of such sale.";
    for pr: Proceeding;
    for claimant: Person;
    for amount: Money;
    for surplus: Money;
    when interest_transferred_to_sale_proceeds(pr, claimant)
        and surplus_proceeds_amount(pr, surplus)
        and court_grants_surplus_proceeds_judgment(pr, claimant, amount)
        and amount <= surplus;
    then surplus_proceeds_judgment_amount_permitted(pr, claimant, amount);
}
pub relation surplus_proceeds_judgment_granted(pr: Proceeding, claimant: Person, amount: Money) kind institutional;
@source(IRC_S7426_B, relation = formalizes, coverage = exact, quote = "the court may grant a judgment in an amount equal to all or any part of the amount of the surplus proceeds of such sale.")
pub rule S7426b3SurplusPowerRule defeasible {
    label en official "the court may grant a judgment in an amount equal to all or any part of the amount of the surplus proceeds of such sale.";
    for pr: Proceeding;
    for claimant: Person;
    for amount: Money;
    when court_grants_surplus_proceeds_judgment(pr, claimant, amount);
    then power S7426b3GrantSurplusProceedsJudgment {
        holder us.irc.core::DistrictCourt;
        over claimant;
        exercise court_grants_surplus_proceeds_judgment(pr, claimant, amount);
        valid_when surplus_proceeds_judgment_amount_permitted(pr, claimant, amount);
        effect surplus_proceeds_judgment_granted(pr, claimant, amount);
    };
}
external judgment relation interest_in_substituted_sale_fund(pr: Proceeding, claimant: Person) {
    authority DistrictCourt;
    label en official "a party has an interest in or lien on the amount held as a fund pursuant to an agreement described in section 6325(b)(3)";
}
pub relation substituted_fund_amount(pr: Proceeding, amount: Money) kind empirical;
pub relation court_grants_fund_judgment(pr: Proceeding, claimant: Person, amount: Money) kind empirical;
pub relation fund_judgment_amount_permitted(pr: Proceeding, claimant: Person, amount: Money) kind institutional;
@source(IRC_S7426_B, relation = formalizes, coverage = exact, quote = "the court may grant a judgment in an amount equal to all or any part of the amount of such fund.")
pub rule S7426b4FundJudgmentWithinFund defeasible {
    label en official "the court may grant a judgment in an amount equal to all or any part of the amount of such fund.";
    for pr: Proceeding;
    for claimant: Person;
    for amount: Money;
    for fund: Money;
    when interest_in_substituted_sale_fund(pr, claimant)
        and substituted_fund_amount(pr, fund)
        and court_grants_fund_judgment(pr, claimant, amount)
        and amount <= fund;
    then fund_judgment_amount_permitted(pr, claimant, amount);
}
pub relation fund_judgment_granted(pr: Proceeding, claimant: Person, amount: Money) kind institutional;
@source(IRC_S7426_B, relation = formalizes, coverage = exact, quote = "the court may grant a judgment in an amount equal to all or any part of the amount of such fund.")
pub rule S7426b4FundPowerRule defeasible {
    label en official "the court may grant a judgment in an amount equal to all or any part of the amount of such fund.";
    for pr: Proceeding;
    for claimant: Person;
    for amount: Money;
    when court_grants_fund_judgment(pr, claimant, amount);
    then power S7426b4GrantFundJudgment {
        holder us.irc.core::DistrictCourt;
        over claimant;
        exercise court_grants_fund_judgment(pr, claimant, amount);
        valid_when fund_judgment_amount_permitted(pr, claimant, amount);
        effect fund_judgment_granted(pr, claimant, amount);
    };
}
// (b)(5): the court SHALL order a refund of the excess of the deposit over the value it determines.
pub relation secretary_value_of_us_interest_exceeds_actual(pr: Proceeding, claimant: Person, deposit: Money, actualValue: Money) kind empirical {
    label en official "the court determines that the Secretary's determination of the value of the interest of the United States in the property for purposes of section 6325(b)(4) exceeds the actual value of such interest";
}
pub relation refund_and_bond_release_judgment_entered(pr: Proceeding, claimant: Person, excess: Money) kind empirical;
@source(IRC_S7426_B, relation = formalizes, coverage = exact, quote = "the court shall grant a judgment ordering a refund of the amount deposited, and a release of the bond, to the extent that the aggregate of the amounts thereof exceeds such value determined by the court.")
pub rule S7426b5RefundDutyRule strict {
    label en official "the court shall grant a judgment ordering a refund of the amount deposited, and a release of the bond, to the extent that the aggregate of the amounts thereof exceeds such value determined by the court.";
    for pr: Proceeding;
    for claimant: Person;
    for deposit: Money;
    for actualValue: Money;
    when secretary_value_of_us_interest_exceeds_actual(pr, claimant, deposit, actualValue)
        and deposit > actualValue;
    then duty S7426b5OrderRefundOfExcessDeposit {
        bearer us.irc.core::DistrictCourt;
        beneficiary claimant;
        goal achievement {
            condition refund_and_bond_release_judgment_entered(pr, claimant, deposit - actualValue);
            window [-infinity, infinity];
        }
    };
}
// The closed list of forms of relief.
pub relation court_grants_relief_outside_7426b_list(pr: Proceeding) kind empirical {
    label en official "The district court shall have jurisdiction to grant only such of the following forms of relief as may be appropriate in the circumstances";
}
@source(IRC_S7426_B, relation = formalizes, coverage = exact, quote = "The district court shall have jurisdiction to grant only such of the following forms of relief as may be appropriate in the circumstances:")
pub rule S7426bOnlyListedReliefRule strict {
    label en official "The district court shall have jurisdiction to grant only such of the following forms of relief as may be appropriate in the circumstances:";
    for pr: Proceeding;
    for p: Person;
    when wrongful_levy_suit_brought_by(pr, p);
    then prohibition S7426bNoUnlistedRelief {
        bearer us.irc.core::DistrictCourt;
        action court_grants_relief_outside_7426b_list(pr);
        window [-infinity, infinity];
    };
}
pub relation wrongful_levy_suit_brought_by(pr: Proceeding, p: Person) kind empirical {
    label en unofficial "the action is a §7426 action brought by the person";
}

// ============================================================================
// §7426(c)-(f) — Presumption of validity, officer immunity, substitution
// ============================================================================

pub relation assessment_underlying_us_interest_in_adjudication(pr: Proceeding, a: Assessment) kind empirical {
    label en official "the assessment of tax upon which the interest or lien of the United States is based";
}
pub relation assessment_conclusively_presumed_valid(pr: Proceeding, a: Assessment) kind institutional;
@source(IRC_S7426_C, relation = formalizes, coverage = exact, quote = "For purposes of an adjudication under this section, the assessment of tax upon which the interest or lien of the United States is based shall be conclusively presumed to be valid.")
pub rule S7426cConclusivePresumption strict {
    label en official "For purposes of an adjudication under this section, the assessment of tax upon which the interest or lien of the United States is based shall be conclusively presumed to be valid.";
    for pr: Proceeding;
    for a: Assessment;
    when assessment_underlying_us_interest_in_adjudication(pr, a);
    then assessment_conclusively_presumed_valid(pr, a);
}
pub relation action_against_officer_for_act_actionable_under_7426(pr: Proceeding, officer: Person) kind empirical {
    label en official "an action against any officer or employee of the United States (or former officer or employee) or his personal representative with respect to any acts for which an action could be maintained under this section";
}
@source(IRC_S7426_D, relation = formalizes, coverage = exact, quote = "No action may be maintained against any officer or employee of the United States (or former officer or employee) or his personal representative with respect to any acts for which an action could be maintained under this section.")
pub rule S7426dNoActionAgainstOfficerRule strict {
    label en official "No action may be maintained against any officer or employee of the United States (or former officer or employee) or his personal representative with respect to any acts for which an action could be maintained under this section.";
    for pr: Proceeding;
    for officer: Person;
    when action_against_officer_for_act_actionable_under_7426(pr, officer);
    then immunity S7426dOfficerImmunity {
        holder officer;
        protected_effect action_against_officer_for_act_actionable_under_7426(pr, officer);
        window [-infinity, infinity];
    };
}
pub relation action_improperly_brought_against_officer(pr: Proceeding, officer: Person) kind empirical {
    label en official "an action, which could be brought against the United States under this section, is improperly brought against any officer or employee of the United States (or former officer or employee) or his personal representative";
}
pub relation pleadings_amended_to_substitute_us(pr: Proceeding, officer: Person) kind empirical;
@source(IRC_S7426_E, relation = formalizes, coverage = exact, quote = "the court shall order, upon such terms as are just, that the pleadings be amended to substitute the United States as a party for such officer or employee as of the time such action was commenced upon proper service of process on the United States.")
pub rule S7426eSubstitutionDutyRule strict {
    label en official "the court shall order, upon such terms as are just, that the pleadings be amended to substitute the United States as a party for such officer or employee as of the time such action was commenced upon proper service of process on the United States.";
    for pr: Proceeding;
    for officer: Person;
    when action_improperly_brought_against_officer(pr, officer);
    then duty S7426eOrderSubstitutionOfUnitedStates {
        bearer us.irc.core::DistrictCourt;
        goal achievement {
            condition pleadings_amended_to_substitute_us(pr, officer);
            window [-infinity, infinity];
        }
    };
}
pub relation refund_claim_prerequisite_inapplicable(pr: Proceeding, claimant: Person, levy: Levy) kind institutional {
    label en unofficial "§7422(a) (no suit before a refund claim) does not apply to the §7426 action";
}
@source(IRC_S7426_F, relation = formalizes, coverage = exact, quote = "The provisions of section 7422(a) (relating to prohibition of suit prior to filing claim for refund) shall not apply to actions under this section.")
pub rule S7426fNoRefundClaimPrerequisite strict {
    label en official "The provisions of section 7422(a) (relating to prohibition of suit prior to filing claim for refund) shall not apply to actions under this section.";
    for pr: Proceeding;
    for claimant: Person;
    for levy: Levy;
    when wrongful_levy_suit_brought(pr, claimant, levy);
    then refund_claim_prerequisite_inapplicable(pr, claimant, levy);
}

// ============================================================================
// §7426(g) — Interest period on wrongful-levy judgments
// ============================================================================

pub relation date_secretary_received_levied_money(pr: Proceeding, levy: Levy, on: Date) kind empirical;
pub relation date_of_levy_sale(pr: Proceeding, levy: Levy, on: Date) kind empirical;
pub relation date_judgment_paid(pr: Proceeding, levy: Levy, on: Date) kind empirical;
pub relation date_secretary_received_deposit(pr: Proceeding, levy: Levy, on: Date) kind empirical;
pub enum WrongfulLevyJudgmentKind {
    MoneyLevied;
    SaleProceeds;
    DepositRefund;
}
pub relation wrongful_levy_interest_period(pr: Proceeding, levy: Levy, kind: WrongfulLevyJudgmentKind, fromDate: Date, toDate: Date) kind institutional {
    label en unofficial "interest at the §6621 overpayment rate is allowed on the judgment for this period; the rate itself is owned by payment-refunds-interest (EXTERNAL_DEPENDENCY)";
}
@source(IRC_S7426_G, relation = formalizes, coverage = exact, quote = "(1) in the case of a judgment pursuant to subsection (b)(2)(B), from the date the Secretary receives the money wrongfully levied upon to the date of payment of such judgment;")
pub rule S7426g1MoneyJudgmentInterest strict {
    label en official "(1) in the case of a judgment pursuant to subsection (b)(2)(B), from the date the Secretary receives the money wrongfully levied upon to the date of payment of such judgment;";
    for pr: Proceeding;
    for levy: Levy;
    for amount: Money;
    for received: Date;
    for paid: Date;
    when money_levied_judgment_granted(pr, levy, amount)
        and date_secretary_received_levied_money(pr, levy, received)
        and date_judgment_paid(pr, levy, paid);
    then wrongful_levy_interest_period(pr, levy, MoneyLevied, received, paid);
}
@source(IRC_S7426_G, relation = formalizes, coverage = exact, quote = "(2) in the case of a judgment pursuant to subsection (b)(2)(C), from the date of the sale of the property wrongfully levied upon to the date of payment of such judgment; and")
pub rule S7426g2SaleJudgmentInterest strict {
    label en official "(2) in the case of a judgment pursuant to subsection (b)(2)(C), from the date of the sale of the property wrongfully levied upon to the date of payment of such judgment; and";
    for pr: Proceeding;
    for levy: Levy;
    for amount: Money;
    for soldOn: Date;
    for paid: Date;
    when sale_judgment_granted(pr, levy, amount)
        and date_of_levy_sale(pr, levy, soldOn)
        and date_judgment_paid(pr, levy, paid);
    then wrongful_levy_interest_period(pr, levy, SaleProceeds, soldOn, paid);
}
pub relation refund_judgment_under_7426b5_ordered(pr: Proceeding, levy: Levy, excess: Money) kind empirical;
@source(IRC_S7426_G, relation = formalizes, coverage = exact, quote = "(3) in the case of a judgment pursuant to subsection (b)(5) which orders a refund of any amount, from the date the Secretary received such amount to the date of payment of such judgment.")
pub rule S7426g3DepositRefundInterest strict {
    label en official "(3) in the case of a judgment pursuant to subsection (b)(5) which orders a refund of any amount, from the date the Secretary received such amount to the date of payment of such judgment.";
    for pr: Proceeding;
    for levy: Levy;
    for excess: Money;
    for received: Date;
    for paid: Date;
    when refund_judgment_under_7426b5_ordered(pr, levy, excess)
        and date_secretary_received_deposit(pr, levy, received)
        and date_judgment_paid(pr, levy, paid);
    then wrongful_levy_interest_period(pr, levy, DepositRefund, received, paid);
}

// ============================================================================
// §7426(h) — Damages in a §7426 action
// ============================================================================

external judgment relation irs_disregard_found_in_7426_action(pr: Proceeding, officer: Person) {
    authority DistrictCourt;
    label en official "there is a finding that any officer or employee of the Internal Revenue Service recklessly or intentionally, or by reason of negligence, disregarded any provision of this title";
}
external judgment relation irs_disregard_only_negligence_7426(pr: Proceeding, officer: Person) {
    authority DistrictCourt;
    label en official "by reason of negligence";
}
pub relation levy_damages_claimed(pr: Proceeding, plaintiff: Person, actualDirect: Money, actionCosts: Money) kind empirical {
    label en official "actual, direct economic damages sustained by the plaintiff as a proximate result of the reckless or intentional or negligent disregard of any provision of this title by the officer or employee (reduced by any amount of such damages awarded under subsection (b)); and the costs of the action";
}
pub relation levy_damages_awarded(pr: Proceeding, plaintiff: Person, amount: Money) kind institutional;
@source(IRC_S7426_H, relation = formalizes, coverage = partial, quote = "the defendant shall be liable to the plaintiff in an amount equal to the lesser of $1,000,000 ($100,000 in the case of negligence) or the sum of—")
pub rule S7426h1RecklessCap defeasible {
    label en official "the defendant shall be liable to the plaintiff in an amount equal to the lesser of $1,000,000 ($100,000 in the case of negligence) or the sum of—";
    for pr: Proceeding;
    for plaintiff: Person;
    for officer: Person;
    for actualDirect: Money;
    for actionCosts: Money;
    when irs_disregard_found_in_7426_action(pr, officer)
        and levy_damages_claimed(pr, plaintiff, actualDirect, actionCosts)
        and not_known(irs_disregard_only_negligence_7426(pr, officer))
        and (actualDirect + actionCosts) > 1000000.00 USD;
    then levy_damages_awarded(pr, plaintiff, 1000000.00 USD);
}
@source(IRC_S7426_H, relation = formalizes, coverage = partial, quote = "the defendant shall be liable to the plaintiff in an amount equal to the lesser of $1,000,000 ($100,000 in the case of negligence) or the sum of—")
pub rule S7426h1RecklessUnderCap defeasible {
    label en official "the defendant shall be liable to the plaintiff in an amount equal to the lesser of $1,000,000 ($100,000 in the case of negligence) or the sum of—";
    for pr: Proceeding;
    for plaintiff: Person;
    for officer: Person;
    for actualDirect: Money;
    for actionCosts: Money;
    when irs_disregard_found_in_7426_action(pr, officer)
        and levy_damages_claimed(pr, plaintiff, actualDirect, actionCosts)
        and not_known(irs_disregard_only_negligence_7426(pr, officer))
        and (actualDirect + actionCosts) <= 1000000.00 USD;
    then levy_damages_awarded(pr, plaintiff, actualDirect + actionCosts);
}
@source(IRC_S7426_H, relation = formalizes, coverage = partial, quote = "the defendant shall be liable to the plaintiff in an amount equal to the lesser of $1,000,000 ($100,000 in the case of negligence) or the sum of—")
pub rule S7426h1NegligenceCap defeasible {
    label en official "the defendant shall be liable to the plaintiff in an amount equal to the lesser of $1,000,000 ($100,000 in the case of negligence) or the sum of—";
    for pr: Proceeding;
    for plaintiff: Person;
    for officer: Person;
    for actualDirect: Money;
    for actionCosts: Money;
    when irs_disregard_only_negligence_7426(pr, officer)
        and levy_damages_claimed(pr, plaintiff, actualDirect, actionCosts)
        and (actualDirect + actionCosts) > 100000.00 USD;
    then levy_damages_awarded(pr, plaintiff, 100000.00 USD);
}
@source(IRC_S7426_H, relation = formalizes, coverage = partial, quote = "the defendant shall be liable to the plaintiff in an amount equal to the lesser of $1,000,000 ($100,000 in the case of negligence) or the sum of—")
pub rule S7426h1NegligenceUnderCap defeasible {
    label en official "the defendant shall be liable to the plaintiff in an amount equal to the lesser of $1,000,000 ($100,000 in the case of negligence) or the sum of—";
    for pr: Proceeding;
    for plaintiff: Person;
    for officer: Person;
    for actualDirect: Money;
    for actionCosts: Money;
    when irs_disregard_only_negligence_7426(pr, officer)
        and levy_damages_claimed(pr, plaintiff, actualDirect, actionCosts)
        and (actualDirect + actionCosts) <= 100000.00 USD;
    then levy_damages_awarded(pr, plaintiff, actualDirect + actionCosts);
}

// ============================================================================
// §7427 — Burden of proof: willful understatement by a tax return preparer
// ============================================================================

pub relation preparer_willful_understatement_issue_raised(pr: Proceeding, preparer: Person) kind empirical {
    label en official "a proceeding involving the issue of whether or not a tax return preparer has willfully attempted in any manner to understate the liability for tax (within the meaning of section 6694(b))";
}
pub relation preparer_willfulness_burden_on_secretary(pr: Proceeding, preparer: Person) kind institutional;
@source(IRC_S7427, relation = formalizes, coverage = exact, quote = "In any proceeding involving the issue of whether or not a tax return preparer has willfully attempted in any manner to understate the liability for tax (within the meaning of section 6694(b)), the burden of proof in respect to such issue shall be upon the Secretary.")
pub rule S7427BurdenOnSecretary strict {
    label en official "In any proceeding involving the issue of whether or not a tax return preparer has willfully attempted in any manner to understate the liability for tax (within the meaning of section 6694(b)), the burden of proof in respect to such issue shall be upon the Secretary.";
    for pr: Proceeding;
    for preparer: Person;
    when preparer_willful_understatement_issue_raised(pr, preparer);
    then preparer_willfulness_burden_on_secretary(pr, preparer);
}
